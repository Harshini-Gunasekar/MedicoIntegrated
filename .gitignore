## Ignore Visual Studio temporary files, build results, and user-specific files.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/ActiveState ActiveGoDB)
*.userprefs

# Mono auto generated files
*.t1

# Nesting profiles
*.layout.json

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Log]s/
[Ff]g/

# Visual Studio 2015/2017/2019/2022 cache directory
.vs/

# Visual Studio Code properties
.vscode/

# JetBrains Rider metadata
.idea/

# Performance Profiler
*.psess
*.vsp
*.vspx
*.sap

# Diagnostic Report
*.diagsession

# Local History for Visual Studio Source Control
App_Data/jobs/
App_Data/logs/

# Node/Webpack/Packages
node_modules/
.npm/

# Additional user ignores
dist/
bin/
obj/
.env
