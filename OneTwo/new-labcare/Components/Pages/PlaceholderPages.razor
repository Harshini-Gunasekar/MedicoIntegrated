@page "/close-reception"

@page "/pending-results"
@page "/finished-reports"
@page "/scheme-master"
@page "/general-settings"
@page "/email-master"
@page "/collection-master"

<div class="lc-page-wrapper flex-center" style="min-height: 80vh;">
    <div class="lc-card p-48 text-center animate-in shadow-xl" style="max-width: 550px; border-radius: 24px;">
        <div class="w-128 h-128 bg-indigo-50 rounded-full flex-center mx-auto mb-24 border border-indigo-100">
            <span class="material-symbols-outlined font-48 text-indigo-600">auto_fix_high</span>
        </div>
        <h2 class="text-24 font-bold text-slate-800 mb-8">New Module Coming Soon</h2>
        <p class="text-slate-500 mb-32">
            We are working hard to bring the <strong>@(GetPageName())</strong> functionality to LabCare Elite.
        </p>
        <div class="flex-center gap-12">
            <button class="lc-btn lc-btn-outline px-32" @onclick="GoBack">Back to Dashboard</button>
        </div>
    </div>
</div>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    private string GetPageName() {
        var uri = Nav.Uri.Split('/').LastOrDefault()?.Replace("-", " ");
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(uri ?? "Feature");
    }

    private void GoBack() => Nav.NavigateTo("billing");
}
