@page "/sso-login"
@page "/ssologin"
@page "/api/sso-login"
@page "/api/ssologin"
@namespace LabCare.Components.Pages
@using LabCare.Components.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@rendermode @(new InteractiveServerRenderMode(prerender: false))


<div class="sso-landing-container">
    <div class="sso-card">
        <div class="sso-spinner"></div>
        <h3>Secure Login in Progress</h3>
        <p>Synchronizing your session with the Identity Hub...</p>
    </div>
</div>

@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage
@inject LabCare.Services.TenantSessionState TenantState

@code {
    [Parameter, SupplyParameterFromQuery]
    public string? Token { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public string? Details { get; set; }

    protected override async Task OnInitializedAsync()
    {
        /* Console.WriteLine($"SSO Login Attempt. Token received: {(!string.IsNullOrEmpty(Token) ? "YES" : "NO")}") */;
        
        if (string.IsNullOrEmpty(Token))
        {
            /* Console.WriteLine("SSO Login: No token found. Redirecting to login.") */;
            NavManager.NavigateTo("/", forceLoad: true); 
            return;
        }

        try
        {
            var authProvider = (JwtAuthenticationStateProvider)AuthStateProvider;
            
            // 1. Create session from token
            var session = authProvider.CreateSessionFromToken(Token);
            
            // 2. Map to the application's legacy UserDetailsModel for compatibility
            var userDetails = new UserDetailsModel
            {
                UserName = session.UserName ?? "SSO User",
                AuthToken = Token,
                TenantCode = session.TenantID,
                UserCode = int.TryParse(session.UserID, out var uc) ? uc : 0,
                Role = "Administrator" // Default for SSO
            };

            // 3. Set all session keys expected by the application
            await SessionStorage.SetAsync("authToken", Token);
            await SessionStorage.SetAsync("tenant_code", session.TenantID ?? "");
            await SessionStorage.SetAsync("tenant_name", session.TenantName ?? session.UserName ?? "");
            await SessionStorage.SetAsync("UserDetails", userDetails);

            // 4. Update the TenantState service
            TenantState.SetSession(session.TenantID ?? "", Token, session.TenantName ?? session.UserName ?? "", userDetails.UserCode ?? 0, null, null);

            // 5. Update AuthStateProvider
            await authProvider.UpdateAuthenticationState(session);

            // Give the state a moment to propagate
            await Task.Delay(100);

            // 6. Redirect to a valid page (referral is the default dashboard in this app)
            NavManager.NavigateTo("/lc-referral", forceLoad: true);

        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"SSO Login Error: {ex.Message}") */;
            NavManager.NavigateTo("/?error=sso_failed", forceLoad: true);
        }

    }
}

<style>
    .sso-landing-container {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        background: #f8fafc;
        font-family: 'Inter', sans-serif;
    }

    .sso-card {
        text-align: center;
        padding: 40px;
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    }

    .sso-spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #e2e8f0;
        border-top-color: #38bdf8;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .sso-card h3 {
        color: #1e293b;
        margin-bottom: 10px;
    }

    .sso-card p {
        color: #64748b;
        font-size: 0.9rem;
    }
</style>