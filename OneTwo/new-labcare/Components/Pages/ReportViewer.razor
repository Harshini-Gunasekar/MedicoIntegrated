@using LabCare.Models
<div class="report-viewer-placeholder" style="padding: 20px; background: #fff; border: 1px solid #ddd; border-radius: 8px;">
    <h3>Report Viewer Placeholder</h3>
    <p><strong>Report Data:</strong> @Reportstring</p>
    @if (pnr != null)
    {
        <div style="margin-top: 10px; border-top: 1px solid #eee; pt-10;">
            <p><strong>Request GUID:</strong> @pnr.RequestGUID</p>
            <p><strong>Test Name:</strong> @pnr.TestName</p>
        </div>
    }
</div>

@code {
    [Parameter] public string? Reportstring { get; set; }
    [Parameter] public PreNatalRequest? pnr { get; set; }
}
