@page "/qualificationmaster"
@using LabCare.Components.Layout
@using LabCare.Models
@using Newtonsoft.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject LabCare.Services.TenantSessionState TenantState

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">school</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Qualification Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Degree Inventory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search qualifications..." @bind="SearchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewQualification">+ Add New</button>
            </div>
        </div>
    </div>

    

    @* --- FORM SECTION (Inline instead of Modal) --- *@
    @if (showForm)
    {
            <div class="modal-overlay">
                <div class="modal-form-card">
                    <div class="modal-header-bar">
                        <h3>@(isEditMode ? "Edit Qualification" : "New Qualification Entry")</h3>
                        <button type="button" class="modal-close-btn lc-modal-close-btn-effect" @onclick="CloseForm" aria-label="Close">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                            </svg>
                        </button>
                    </div>
                    <div class="modal-body">
                        

                        <div class="mb-0 form-section">
                            <div class="mt-0">
                                <div class="um-grid-row">
                                    <div class="form-group position-relative">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                            <label style="margin-bottom: 0;">Qualification Name</label>
                                            @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                            {
                                                <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                            }
                                        </div>
                                        <input type="text" class="lab-input" @bind="current.name" @bind:event="oninput" placeholder="Qualification Name" @(isSubmitted && string.IsNullOrEmpty(current.name) ? "is-invalid" : "") required />
                                    </div>
                                </div>
                                <div class="um-grid-cols-3">
                                    <div class="form-group">
                                        <label>Order no</label>
                                        <input type="number" class="lab-input" @bind="current.orderno" placeholder="01" />
                                    </div>
                                    <div class="form-group">
                                        <label>Short Name</label>
                                        <input type="text" class="lab-input" @bind="current.shortname" />
                                    </div>
                                    <div class="form-group">
                                        <label>Narration</label>
                                        <input type="text" class="lab-input" @bind="current.description" placeholder="" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="modal-footer-bar">
                        <button type="button"
                                class="btn-delete"
                                @onclick="() => SoftDeleteQualification(current.qcode)"
                                disabled="@(current.qcode == 0 || current.qcode == null)">
                            Delete
                        </button>
                        <button type="button" class="btn-save" @onclick="SaveQualification">
                             <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="lc-mr-8">
                                <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                            </svg>
                            Save Qualification
                        </button>
                    </div>
                </div>
            </div>
    }

    @* --- DIRECTORY LIST --- *@
    <div class="directory-section lc-rounded-t-0 lc-mt-neg-4">

        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th class="lc-width-100">ORDER NO</th>
                        <th class="lc-width-150">SHORT NAME</th>
                        <th>QUALIFICATION NAME</th>
                        <th>NARRATION</th>
                        <th class="lc-width-180">ENTERED DATE</th>
                        <th class="lc-width-180">MODIFIED DATE</th>
                        <th class="text-center lc-width-120">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (qualifications != null && qualifications.Any())
                    {
                        @foreach (var q in FilteredQualificationsBySearch)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"{q.orderno:00}")</span></td>
                                <td class="lc-color-slate-500 lc-font-mono lc-font-700 lc-font-13">@q.shortname</td>
                                <td class="font-bold text-slate-800">@q.name</td>
                                <td class="text-slate-500">@q.description</td>
                                <td class="text-slate-400 font-12">@q.entereddate?.ToString("MM-dd-yyyy hh:mm tt")</td>
                                <td class="text-slate-400 font-12">@q.ibsdate?.ToString("MM-dd-yyyy hh:mm tt")</td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8">
                                        <button type="button" class="lc-btn p-4 lc-circle-btn-32" @onclick="() => EditQualification(q)" title="Edit">
                                            <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                        </button>
                                        <button type="button" class="lc-btn p-4 lc-circle-btn-32" @onclick="() => SoftDeleteQualification(q.qcode)" title="Delete">
                                            <span class="material-symbols-outlined font-18 text-slate-400">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center p-48 text-slate-400 italic">No qualification records discovered.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



@code {
    private List<QualificationModel> qualifications = new();
    private IEnumerable<QualificationModel> FilteredQualifications =>
        displayActiveOnly ? qualifications.Where(q => q.deleted != true) : qualifications;

    private IEnumerable<QualificationModel> FilteredQualificationsBySearch =>
        FilteredQualifications.Where(q => 
            string.IsNullOrWhiteSpace(SearchQuery) || 
            (q.name != null && q.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (q.shortname != null && q.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (q.description != null && q.description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    private QualificationModel current = new();
    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;
    private bool isEditMode = false;
    private bool displayActiveOnly = true;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    TenantState.SetSession(TenantCode, AuthToken, TenantName);
                    await LoadQualifications();
                    StateHasChanged();
                }
                else
                {
                    errorMessage = "Access denied: Missing valid session. Please log in again.";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Session Load Error: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private HttpClient CreateClient() 
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private string? errorMessage;

    private async Task LoadQualifications()
    {
        if (string.IsNullOrEmpty(TenantCode)) 
        {
            errorMessage = "Unauthorized: Missing tenant code.";
            return;
        }
        try
        {
            errorMessage = null;
            using var client = CreateClient();
            var url = $"{BaseUrl}Qualification/get";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                qualifications = await response.Content.ReadFromJsonAsync<List<QualificationModel>>() ?? new List<QualificationModel>();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error loading qualifications ({response.StatusCode}): {errorBody}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading qualifications: {ex.Message}";
        }
    }

    private void NewQualification()
    {
        current = new QualificationModel { 
            deleted = false,
            computercode = 1,
            usercode = 1
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private async Task EditQualification(QualificationModel q)
    {
        if (q == null) return;
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}Qualification/getbyid?qcode={q.qcode}";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                current = await response.Content.ReadFromJsonAsync<QualificationModel>() ?? new QualificationModel();
            }
            else
            {
                current = JsonConvert.DeserializeObject<QualificationModel>(JsonConvert.SerializeObject(q)) ?? new QualificationModel();
            }
        }
        catch (Exception)
        {
            current = JsonConvert.DeserializeObject<QualificationModel>(JsonConvert.SerializeObject(q)) ?? new QualificationModel();
        }
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveQualification()
    {
        isSubmitted = true;
        if (string.IsNullOrEmpty(TenantCode))
        {
            errorMessage = "Error: Tenant code is not loaded.";
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(current.name))
        {
            errorMessage = "Error: Qualification Name is required.";
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(current.shortname))
        {
            errorMessage = "Error: Short Name is required.";
            StateHasChanged();
            return;
        }

        // Duplicate check
        if (qualifications.Any(q => q.name?.Trim().Equals(current.name?.Trim(), StringComparison.OrdinalIgnoreCase) == true && q.qcode != current.qcode))
        {
            errorMessage = $"Error: A qualification with name '{current.name}' already exists.";
            StateHasChanged();
            return;
        }

        try
        {
            errorMessage = null;
            current.tenant_code = TenantCode;
            
            // Fix: Ensure computer and user codes are not null as per DB constraint
            current.computercode ??= 1;
            if (current.usercode == 0) current.usercode = 1;

            using var client = CreateClient();
            HttpResponseMessage response;
            if (isEditMode)
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}Qualification/update", current);
            }
            else
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}Qualification/insert", current);
            }

            if (response.IsSuccessStatusCode)
            {
                await LoadQualifications();
                errorMessage = isEditMode ? "Qualification updated successfully." : "Qualification added successfully.";
                showForm = false;
                StateHasChanged();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"Save failed ({response.StatusCode}): {body}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving qualification: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task SoftDeleteQualification(long? qcode)
    {
        if (qcode == null || qcode == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this qualification?"))
        {
            try
            {
                using var client = CreateClient();
                var url = $"{BaseUrl}Qualification/softdelete?qcode={qcode}";
                var response = await client.GetAsync(url);
                response.EnsureSuccessStatusCode();
                await LoadQualifications();
                
                if (current != null && current.qcode == qcode)
                {
                    showForm = false;
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting: {ex.Message}";
            }
        }
    }

    private void CloseForm()
    {
        current = new QualificationModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }
}