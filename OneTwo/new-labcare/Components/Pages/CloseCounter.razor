@page "/close-counter"

<div class="lc-page-wrapper flex-center" style="min-height: 80vh;">
    <div class="lc-card p-48 text-center animate-in" style="max-width: 500px;">
        <div class="w-128 h-128 bg-amber-50 rounded-full flex-center mx-auto mb-24 border border-amber-100">
            <span class="material-symbols-outlined font-48 text-amber-600">lock_clock</span>
        </div>
        <h2 class="text-24 font-bold text-slate-800 mb-8">Close Counter</h2>
        <p class="text-slate-500 mb-24">
            EndOfDay process to reconcile cash and close the active session. This module is currently being finalized.
        </p>
        <div class="flex-center gap-12">
            <button class="lc-btn lc-btn-outline" onclick="history.back()">Go Back</button>
            <button class="lc-btn lc-btn-primary">Daily Report</button>
        </div>
    </div>
</div>
