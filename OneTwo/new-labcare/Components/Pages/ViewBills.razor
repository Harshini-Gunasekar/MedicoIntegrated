    private async Task PrintBill(Guid? guid)
    {
        if (!guid.HasValue) return;
        try
        {
            printingGuid = guid;
            StateHasChanged();

            var billJson = await BuildBillJson(guid.Value);
            if (billJson == null)
            {
                errorMessage = "Failed to fetch bill data for printing.";
                return;
            }

            await JS.InvokeVoidAsync("generateBillPdf", billJson);
        }
        catch (Exception ex)
        {
            errorMessage = $"Print failed: {ex.Message}";
            /* Console.WriteLine($"PrintBill error: {ex}") */;
        }
        finally
        {
            printingGuid = null;
            StateHasChanged();
        }
    }

