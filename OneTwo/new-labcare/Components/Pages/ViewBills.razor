    /// <summary>
    /// Fetches bill data from billing/bill API, resolves test names, and builds a JSON string
    /// compatible with the bill-print.js buildBillHtml function.
    /// </summary>
    private async Task<string?> BuildBillJson(Guid requestguid)
    {
        var printData = await BillingService.GetBillForPrintAsync(requestguid);
        if (printData?.cus_details == null) return null;

        var master = printData.cus_details;
        var details = printData.custest_details ?? new();

        // Get doctor name from the existing bill list
        var existingBill = allBills.FirstOrDefault(b => b.requestguid == requestguid);
        string doctorName = existingBill?.doctorname ?? "Self";
        string requestNoPrint = !string.IsNullOrEmpty(master.requestsnoprint) ? master.requestsnoprint 
            : (!string.IsNullOrEmpty(existingBill?.requestsnoprint) ? existingBill.requestsnoprint 
            : (master.requestsno.HasValue ? master.requestsno.Value.ToString() : ""));

        // Build test items with resolved names from test_master
        var testItems = new List<object>();
        foreach (var detail in details)
        {
            string testName = "Test";
            if (detail.tcode.HasValue)
            {
                var test = allTests.FirstOrDefault(t => t.tcode == detail.tcode.Value);
                if (test != null) testName = test.name;
            }

            testItems.Add(new
            {
                testname = testName,
                testamount = detail.testamount ?? detail.standardprice ?? detail.testrate ?? 0,
                discount = detail.discount ?? 0,
                collection = detail.collection ?? ((detail.testamount ?? 0) - (detail.discount ?? 0)),
                standardprice = detail.standardprice ?? 0,
                qty = detail.qty ?? 1
            });
        }

        // Build lab info from tenant
        string labName = tenantInfo?.tenant_name ?? tenantInfo?.legal_name ?? "iScan Diagnostics";
        string labAddress = string.Join(", ", new[] { tenantInfo?.address_line1, tenantInfo?.address_line2, tenantInfo?.city, tenantInfo?.pincode }.Where(s => !string.IsNullOrEmpty(s)));
        string labContact = string.Join(" | ", new[] {
            !string.IsNullOrEmpty(tenantInfo?.contact_number) ? "Phone: " + tenantInfo.contact_number : null,
            !string.IsNullOrEmpty(tenantInfo?.contact_email) ? "Email: " + tenantInfo.contact_email : null
        }.Where(s => !string.IsNullOrEmpty(s)));

        var billPayload = new
        {
            labName,
            labAddress,
            labContact,
            requestsnoprint = requestNoPrint,
            requestbarcode = master.requestbarcode,
            requestdatetime = master.requestdatetime?.ToString("o"),
            billtype = master.billtype,
            name = master.name,
            patientname = master.name,
            custid = master.custid,
            gender = master.gender,
            ageyears = master.ageyears,
            agemonths = master.agemonths,
            agedays = master.agedays,
            address = master.address,
            mobileno = master.mobileno,
            doctorname = doctorName,
            requestamount = master.requestamount ?? 0,
            discountamount = master.discountamount ?? 0,
            totalamount = master.totalamount ?? 0,
            paidamount = master.paidamount ?? 0,
            pmc1 = master.pmc1,
            pmc2 = master.pmc2,
            pmc3 = master.pmc3,
            testItems
        };

        return System.Text.Json.JsonSerializer.Serialize(billPayload);
    }

    private bool isPrintingReport = false;

    private async Task PrintSummaryReport(string endpoint)
    {
        string fromStr = filter.fromdate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd");
        string toStr = filter.todate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd");
        string url = $"report/{endpoint}?fromdate={fromStr}&periodtype=date-wise&todate={toStr}";
        await PrintReportBase64(url);
    }

    private async Task PrintStatementReport(string endpoint)
    {
        string fromStr = filter.fromdate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd");
        string toStr = filter.todate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd");
        string url = $"report/{endpoint}?fromdate={fromStr}&todate={toStr}";
        await PrintReportBase64(url);
    }

    private async Task PrintReportBase64(string endpointWithParams)
    {
        try
        {
            isPrintingReport = true;
            StateHasChanged();

            using var client = ClientFactory.CreateClient("LabCareApi");
            if (!string.IsNullOrEmpty(TenantCode)) client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            if (!string.IsNullOrEmpty(AuthToken)) client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);

            var resp = await client.GetAsync($"{BaseUrl}{endpointWithParams}");
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                errorMessage = $"Print failed: {err}";
                return;
            }

            var raw = await resp.Content.ReadAsStringAsync();
            var base64 = raw.Trim().Trim('"');
            await JS.InvokeVoidAsync("openBase64Pdf", base64);
        }
        catch (Exception ex)
        {
            errorMessage = $"Print error: {ex.Message}";
        }
        finally
        {
            isPrintingReport = false;
            StateHasChanged();
        }
    }
