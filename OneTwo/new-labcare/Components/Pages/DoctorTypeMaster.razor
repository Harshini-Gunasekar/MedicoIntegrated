@page "/doctortypemaster"
@using LabCare.Components.Layout
@using LabCare.Models
@using Newtonsoft.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject LabCare.Services.TenantSessionState TenantState

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">list_alt</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Doctor Type Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Classification Inventory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search doctor types..." @bind="SearchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewDoctorType">+ Add New</button>
            </div>
        </div>
    </div>

    @* --- ERROR / SUCCESS MESSAGE --- *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert @(errorMessage.StartsWith("Error") ? "alert-danger" : "alert-success") p-3 mb-3 rounded-lg" style="margin: 0 24px;">
            @errorMessage
        </div>
    }

    @* --- FORM SECTION (Modal) --- *@
    @if (showForm)
    {
        <div class="modal-overlay">
            <div class="modal-form-card">
                <div class="modal-header-bar">
                    <h3>@(isEditMode ? "Edit Doctor Type" : "New Doctor Type Entry")</h3>
                    <button type="button" class="modal-close-btn lc-modal-close-btn-effect" @onclick="CloseForm" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                        </svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-0 form-section">
                        <div class="mt-0">
                            <div class="um-grid-row">
                                <div class="form-group position-relative">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                        <label style="margin-bottom: 0;">Doctor Type Name *</label>
                                        @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                        {
                                            <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                        }
                                    </div>
                                    <input type="text" class="lab-input" @bind="current.name" placeholder="e.g. Mdos, Consultant, Other" required />
                                </div>
                            </div>
                            <div class="um-grid-cols-3">
                                <div class="form-group">
                                    <label>Order No</label>
                                    <input type="number" class="lab-input" @bind="current.orderno" placeholder="e.g. 1" />
                                </div>
                                <div class="form-group">
                                    <label>Short Name</label>
                                    <input type="text" class="lab-input" @bind="current.shortname" placeholder="e.g. MDOS" />
                                </div>
                                <div class="form-group">
                                    <label>Description</label>
                                    <input type="text" class="lab-input" @bind="current.description" placeholder="Narration" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer-bar">
                    <button type="button"
                            class="btn-delete"
                            @onclick="() => DeleteDoctorType(current.tcode)"
                            disabled="@(current.tcode == 0)">
                        Delete
                    </button>
                    <button type="button" class="btn-save" @onclick="SaveDoctorType">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="lc-mr-8" style="margin-right: 8px;">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                        </svg>
                        Save Doctor Type
                    </button>
                </div>
            </div>
        </div>
    }

    @* --- DIRECTORY LIST --- *@
    <div class="directory-section lc-rounded-t-0 lc-mt-neg-4">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th class="lc-width-100">ORDER NO</th>
                        <th class="lc-width-150">SHORT NAME</th>
                        <th>DOCTOR TYPE NAME</th>
                        <th>DESCRIPTION</th>
                        <th class="lc-width-180">ENTERED DATE</th>
                        <th class="lc-width-180">MODIFIED DATE</th>
                        <th class="text-center lc-width-120">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (doctorTypes != null && doctorTypes.Any())
                    {
                        @foreach (var dt in FilteredDoctorTypesBySearch)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"{dt.orderno ?? 0:00}")</span></td>
                                <td class="lc-color-slate-500 lc-font-mono lc-font-700 lc-font-13">@dt.shortname</td>
                                <td class="font-bold text-slate-800">@dt.name</td>
                                <td class="text-slate-500">@dt.description</td>
                                <td class="text-slate-400 font-12">@dt.entereddate.ToString("MM-dd-yyyy hh:mm tt")</td>
                                <td class="text-slate-400 font-12">@dt.ibsdate.ToString("MM-dd-yyyy hh:mm tt")</td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8">
                                        <button type="button" class="lc-btn p-4 lc-circle-btn-32" @onclick="() => EditDoctorType(dt)" title="Edit">
                                            <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                        </button>
                                        <button type="button" class="lc-btn p-4 lc-circle-btn-32" @onclick="() => DeleteDoctorType(dt.tcode)" title="Delete">
                                            <span class="material-symbols-outlined font-18 text-slate-400">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center p-48 text-slate-400 italic">No doctor type records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<DoctorTypeModel> doctorTypes = new();
    private DoctorTypeModel current = new();
    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;
    private bool isEditMode = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";
    private string? errorMessage;

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";

    private IEnumerable<DoctorTypeModel> FilteredDoctorTypes =>
        doctorTypes.Where(d => !d.deleted);

    private IEnumerable<DoctorTypeModel> FilteredDoctorTypesBySearch =>
        FilteredDoctorTypes.Where(d => 
            string.IsNullOrWhiteSpace(SearchQuery) || 
            (d.name != null && d.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (d.shortname != null && d.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (d.description != null && d.description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    TenantState.SetSession(TenantCode, AuthToken, TenantName);
                    await LoadDoctorTypes();
                    StateHasChanged();
                }
                else
                {
                    errorMessage = "Access denied: Missing valid session. Please log in again.";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Session Load Error: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private HttpClient CreateClient() 
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private async Task LoadDoctorTypes()
    {
        if (string.IsNullOrEmpty(TenantCode)) 
        {
            errorMessage = "Unauthorized: Missing tenant code.";
            return;
        }
        try
        {
            errorMessage = null;
            using var client = CreateClient();
            var url = $"{BaseUrl}DoctorType/get";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                doctorTypes = await response.Content.ReadFromJsonAsync<List<DoctorTypeModel>>() ?? new List<DoctorTypeModel>();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error loading doctor types ({response.StatusCode}): {errorBody}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading doctor types: {ex.Message}";
        }
    }

    private void NewDoctorType()
    {
        current = new DoctorTypeModel { 
            deleted = false,
            computercode = 1,
            usercode = 1,
            entereddate = DateTime.Now,
            ibsdate = DateTime.Now
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private void EditDoctorType(DoctorTypeModel dt)
    {
        if (dt == null) return;
        current = JsonConvert.DeserializeObject<DoctorTypeModel>(JsonConvert.SerializeObject(dt)) ?? new DoctorTypeModel();
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveDoctorType()
    {
        isSubmitted = true;
        if (string.IsNullOrEmpty(TenantCode))
        {
            errorMessage = "Error: Tenant code is not loaded.";
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(current.name))
        {
            errorMessage = "Error: Doctor Type Name is required.";
            StateHasChanged();
            return;
        }

        try
        {
            errorMessage = null;
            current.tenant_code = TenantCode;
            current.computercode = 1;
            current.usercode = 1;
            current.entereddate = DateTime.Now;
            current.ibsdate = DateTime.Now;

            using var client = CreateClient();
            HttpResponseMessage response;
            if (isEditMode)
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}DoctorType/update", current);
            }
            else
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}DoctorType/insert", current);
            }

            if (response.IsSuccessStatusCode)
            {
                await LoadDoctorTypes();
                errorMessage = isEditMode ? "Doctor Type updated successfully." : "Doctor Type added successfully.";
                showForm = false;
                StateHasChanged();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"Save failed ({response.StatusCode}): {body}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving doctor type: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task DeleteDoctorType(int tcode)
    {
        if (tcode == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this doctor type?"))
        {
            try
            {
                using var client = CreateClient();
                var url = $"{BaseUrl}DoctorType/delete?tcode={tcode}";
                var response = await client.GetAsync(url);
                if (response.IsSuccessStatusCode)
                {
                    await LoadDoctorTypes();
                    errorMessage = "Doctor Type deleted successfully.";
                    if (current != null && current.tcode == tcode)
                    {
                        showForm = false;
                    }
                    StateHasChanged();
                }
                else
                {
                    var body = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Delete failed ({response.StatusCode}): {body}";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private void CloseForm()
    {
        current = new DoctorTypeModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }
}
