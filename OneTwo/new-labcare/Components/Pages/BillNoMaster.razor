@page "/BillNoConfiguration"
@using LabCare.Components.Layout
@using LabCare.Models
@using LIMS_Backend.Model
@using Newtonsoft.Json
@using System.Text
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject LabCare.Services.TenantSessionState TenantState

<div class="referral-page">
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">receipt_long</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Bill No / Sample Generation</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Master Configuration</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search configuration..." @bind="SearchQuery" @bind:event="oninput" class="search-input-field" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewConfiguration">+ Add New</button>
            </div>
        </div>
    </div>

    

    @if (showForm)
    {
            <div class="modal-overlay">
                <div class="modal-form-card modal-form-max-width">
                    <div class="modal-header-bar">
                        <h3>@(isEditMode ? "Edit Configuration" : "New Configuration Entry")</h3>
                        <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                            </svg>
                        </button>
                    </div>
                <div class="modal-body pb-0">
                    
                    <div class="row">
                        
                        <!-- Left Column: Entry Form -->
                        <div class="form-section mb-0 flex-1 min-w-500 lc-pt-0 lc-shadow-none lc-border-none">
                            <div class="um-grid-row mt-0">
                                <div class="form-group position-relative">
                                    <div class="lc-flex-between-center lc-mb-4">
                                        <label class="lc-mb-0">Configuration Name</label>
                                        @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                        {
                                            <span class="text-danger lc-font-11 lc-font-500">This field is required</span>
                                        }
                                    </div>
                                    <input type="text" class="lab-input" @bind="current.name" placeholder="Configuration Name" @(isSubmitted && string.IsNullOrEmpty(current.name) ? "is-invalid" : "") required />
                                </div>
                            </div>
                            <div class="form-row form-cols-2 mt-3">
                                <div class="form-group">
                                    <label>Order No</label>
                                    <input type="number" class="lab-input" @bind="current.orderno" placeholder="1" />
                                </div>
                                <div class="form-group">
                                    <label>Short Name</label>
                                    <input type="text" class="lab-input" @bind="current.shortname" placeholder="Short Name" />
                                </div>
                            </div>

                            <div class="form-row form-cols-2 mt-4">
                                <div class="form-group">
                                    <label>Restart Sequence On</label>
                                    <div class="display-flex flex-col gap-8 mt-8">
                                        <div class="lc-flex-start lc-gap-16">
                                              <label class="label-checkbox-radio">
                                                <input type="radio" name="retype" checked="@(current.restartfinancialyear == true)" @onchange="@(() => SetRestart("fy"))" /> FY
                                            </label>
                                            <label class="lc-flex-center-inline lc-gap-6 lc-font-13 lc-font-500">
                                                <input type="radio" name="retype" checked="@(current.restartcalendaryear == true)" @onchange="@(() => SetRestart("cy"))" /> CY
                                            </label>
                                             <label class="label-checkbox-radio">
                                                <input type="radio" name="retype" checked="@(current.restartmonthly == true)" @onchange="@(() => SetRestart("mo"))" /> Mo
                                            </label>
                                            <label class="lc-flex-center-inline lc-gap-6 lc-font-13 lc-font-500">
                                                <input type="radio" name="retype" checked="@(current.restartdaily == true)" @onchange="@(() => SetRestart("dy"))" /> Day
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-row mt-3">
                                <div class="form-group flex-1">
                                    <label>Narration</label>
                                    <input type="text" class="lab-input" @bind="current.description" placeholder="Narration" />
                                </div>
                            </div>

                            <!-- Mapping Builder Section -->
                            <div class="mapping-builder-card mt-4 p-3 lc-bg-slate-50 lc-border-slate lc-rounded-8">
                                <h4 class="lc-font-14 lc-font-700 lc-color-slate-800 lc-mb-12 lc-flex-center-inline lc-gap-8">
                                    <span class="material-symbols-outlined lc-marker-icon-purple">account_tree</span>
                                    Assign Branch & Counters
                                </h4>

                                @if (current.allbranch == true)
                                {
                                    <div class="alert py-12 px-16 font-12 d-flex align-items-center gap-12 mb-16 lc-alert-info">
                                        <span class="material-symbols-outlined font-20 lc-text-blue-500">public</span>
                                        <span><b class="lc-color-indigo-900">SHARED BRANCH SERIES:</b> This sequence is synchronized across all <b>Selected Branches</b>.</span>
                                    </div>
                                }
                                else if (current.allcounter == true)
                                {
                                    <div class="alert py-12 px-16 font-12 d-flex align-items-center gap-12 mb-16 lc-alert-warning">
                                        <span class="material-symbols-outlined font-20 lc-text-orange-500">account_tree</span>
                                        <span><b class="lc-color-orange-900">SHARED COUNTER SERIES:</b> All <b>Selected Counters</b> within the assigned branches share this same sequence.</span>
                                    </div>
                                }

                                <div class="row align-items-end gx-2 filter-disabled">
                                    <div class="col-md-5">
                                        <div class="form-group mb-0">
                                            <label class="lc-font-11 lc-text-uppercase lc-color-slate-500">Select Branch @(current.allcounter == true ? "(Branch-Wide)" : "")</label>
                                            <select class="lab-input" @bind="selectedBranchForMapping" @bind:after="OnBranchSelectedForMapping">
                                                <option value="">-- Choose Branch --</option>
                                                @foreach (var br in branches.Where(b => !b.deleted))
                                                {
                                                    <option value="@br.bhcode">@br.name</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        <div class="display-flex align-center gap-12 mb-1">
                                            <label class="lc-font-11 lc-text-uppercase lc-color-slate-500">Select Counters</label>
                                            <label class="lc-font-10 lc-cursor-pointer lc-color-indigo-600 lc-font-600" @onclick="ToggleAllCountersForSelectedBranch">
                                                @(IsAllCountersOfSelectedBranchChecked ? "Unselect All" : "Select All")
                                            </label>
                                        </div>
                                        <div class="checkbox-list lc-checkbox-scroll-container">
                                            @if (selectedBranchForMapping.HasValue)
                                            {
                                                @foreach (var cnt in counters.Where(c => !(c.deleted ?? false) && c.bhcode == selectedBranchForMapping))
                                                {
                                                    <label class="lc-flex-center-inline lc-gap-6 lc-mb-4 lc-font-12 lc-cursor-pointer">
                                                        <input type="checkbox" checked="@selectedCountersForMapping.Contains(cnt.cntcode)" 
                                                               @onchange="(e) => ToggleCounterForMapping(cnt.cntcode, e.Value)" /> @cnt.name
                                                    </label>
                                                }
                                            }
                                            else
                                            {
                                                <div class="lc-font-11 lc-color-slate-400 lc-text-center lc-p-10">Select a branch first</div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-2 text-right">
                                    <button type="button" class="btn-new-entry lc-btn-indigo-sm" 
                                            @onclick="AddMappingsToCurrent" disabled="@(selectedBranchForMapping == null || (!current.allcounter == true && !selectedCountersForMapping.Any()))">
                                        Add to List
                                    </button>
                                </div>

                                <div class="form-group mb-3 px-3 mt-3 border-top pt-3 pb-2 rounded-8 lc-bg-indigo-50 lc-border-indigo-200 lc-mx-neg-5">
                                    <label class="lc-font-10 lc-text-uppercase lc-color-indigo-700 lc-font-800 lc-letter-spacing-05">Global Configuration Override</label>
                                    <div class="display-flex gap-24 mt-4">
                                        @if (branches.Count(b => !b.deleted) > 1)
                                        {
                                            <label class="label-checkbox-radio lc-font-12 lc-font-700 lc-color-indigo-800 lc-mb-0">
                                                <input type="checkbox" checked="@current.allbranch" @onchange="e => OnAllBranchChange((bool)e.Value)" /> Selected Branches Same Sequence
                                            </label>
                                        }
                                        <label class="label-checkbox-radio lc-font-12 lc-font-700 lc-color-indigo-800 lc-mb-0">
                                            <input type="checkbox" @bind="current.allcounter" /> Selected Branch-Counters Same Sequence
                                        </label>
                                    </div>
                                </div>

                                <!-- Current Mappings Preview -->
                                @if (current.mappings != null && current.mappings.Any())
                                {
                                    <div class="mt-3">
                                        <label class="lc-font-11 lc-text-uppercase lc-color-slate-500 lc-mb-4 lc-block">Active Mappings</label>
                                        <div class="mappings-preview-grid lc-grid-auto-fill-180 lc-gap-8 lc-overflow-auto-max-150">
                                            @foreach (var mapping in current.mappings)
                                            {
                                                var branch = branches.FirstOrDefault(b => b.bhcode == mapping.bhcode);
                                                var counter = counters.FirstOrDefault(c => c.cntcode == mapping.cntcode);
                                                <div class="mapping-tag shadow-sm transition-all lc-mapping-tag">
                                                    <div class="lc-font-11 lc-flex-col lc-gap-2">
                                                        <span class="lc-font-800 lc-color-indigo-800 lc-text-uppercase">@branch?.name</span>
                                                        <span class="lc-color-blue-400 lc-font-600">@(mapping.cntcode == null ? "ALL COUNTERS" : counter?.name ?? "Unknown")</span>
                                                    </div>
                                                    <button type="button" @onclick="() => RemoveMapping(mapping)" class="lc-btn-cancel-icon hover-text-rose-600">
                                                        <span class="material-symbols-outlined lc-font-16">cancel</span>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                </div>
                
                <div class="modal-footer-bar mt-4 border-t lc-pt-16">
                    <button type="button" class="btn-delete" @onclick="() => SoftDeleteConfig(current.bncode)" disabled="@(current.bncode == 0)">
                        Delete
                    </button>
                    <button type="button" class="btn-save" @onclick="SaveConfiguration">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="lc-mr-8">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z" />
                        </svg>
                        Save Configuration
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Index Table -->
    <div class="directory-section lc-rounded-t-0 lc-mt-neg-4">

        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th class="lc-width-80">ORDER NO</th>
                        <th>NAME</th>
                        <th>TYPE</th>
                        <th>RESTART ON</th>
                        <th>MAPPED BRANCHES</th>
                        <th>MAPPED COUNTERS</th>
                        <th>DESCRIPTION</th>
                        <th class="text-center lc-width-80">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (configs != null && configs.Any())
                    {
                        @foreach (var co in FilteredConfigsBySearch)
                        {
                            <tr>
                                <td><span class="td-order-no">@co.orderno</span></td>
                                <td><span class="td-name">@co.name</span></td>
                                 <td><span class="lc-font-600 lc-color-slate-600">@(co.issampleno == true ? "Sample ID" : "Default")</span></td>
                                <td><span class="lc-font-500 lc-color-slate-500 lc-font-12">@(co.restartfinancialyear == true ? "FY" : co.restartcalendaryear == true ? "CY" : co.restartdaily == true ? "Daily" : "Monthly")</span></td>
                                <td>
                                    @if (co.allbranch == true)
                                    {
                                        <span class="badge bg-indigo-100 text-indigo-700 px-8 py-2 rounded-4 font-10 font-bold uppercase">SELECTED BRANCHES</span>
                                    }
                                    else if (co.mappings != null && co.mappings.Any(m => m.bhcode.HasValue))
                                    {
                                        <span class="lc-font-500 lc-color-slate-600">
                                            @if (co.mappings.Where(m => m.bhcode.HasValue).Select(m => m.bhcode).Distinct().Count() == 1)
                                            {
                                                @(branches.FirstOrDefault(b => b.bhcode == co.mappings.First(m => m.bhcode.HasValue).bhcode)?.name ?? "Unknown")
                                            }
                                            else
                                            {
                                                @($"{co.mappings.Where(m => m.bhcode.HasValue).Select(m => m.bhcode).Distinct().Count()} Branches")
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="lc-font-500 lc-color-slate-600">-</span>
                                    }
                                </td>
                                <td>
                                    @if (co.allcounter == true)
                                    {
                                        <span class="badge bg-slate-100 text-slate-700 px-8 py-2 rounded-4 font-10 font-bold uppercase">SELECTED COUNTERS</span>
                                    }
                                    else if (co.mappings != null && co.mappings.Any(m => m.cntcode.HasValue))
                                    {
                                        <span class="lc-font-500 lc-color-slate-600">
                                            @if (co.mappings.Where(m => m.cntcode.HasValue).Select(m => m.cntcode).Distinct().Count() == 1)
                                            {
                                                @(counters.FirstOrDefault(c => c.cntcode == co.mappings.First(m => m.cntcode.HasValue).cntcode)?.name ?? "Unknown")
                                            }
                                            else
                                            {
                                                @($"{co.mappings.Where(m => m.cntcode.HasValue).Select(m => m.cntcode).Distinct().Count()} Counters")
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="lc-font-500 lc-color-slate-600">-</span>
                                    }
                                </td>
                                <td><span class="td-narration">@co.description</span></td>
                                <td class="text-center">
                                    <button type="button" class="btn-action btn-edit" @onclick="() => EditConfig(co)" title="Edit">
                                        <span class="material-symbols-outlined lc-font-16">edit</span>
                                    </button>
                                    <button type="button" class="btn-action btn-delete-action" @onclick="() => SoftDeleteConfig(co.bncode)" title="Delete">
                                        <span class="material-symbols-outlined lc-font-16">delete</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="p-8 text-center lc-color-slate-400">No configuration records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<BillNoConfigurationDto> configs = new();
    private IEnumerable<BillNoConfigurationDto> FilteredConfigs =>
        displayActiveOnly ? configs.Where(c => !(c.deleted ?? false)) : configs;

    private IEnumerable<BillNoConfigurationDto> FilteredConfigsBySearch =>
        FilteredConfigs.Where(c =>
            string.IsNullOrWhiteSpace(SearchQuery) ||
            (c.name != null && c.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.shortname != null && c.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    private BillNoConfigurationDto current = new();
    
    private List<BranchModel> branches = new();
    private List<CounterModel> counters = new();


    private List<BillNoDeptRow> deptRows = new();

    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;
    private bool isEditMode = false;
    private bool displayActiveOnly = true;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";

    private string TenantCode = "";
    private string AuthToken = "";
    private string? errorMessage;

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                     // Ensure the global state container is updated so HttpClient headers are injected
                    var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                    TenantState.SetSession(TenantCode, AuthToken, tenantNameResult.Success ? tenantNameResult.Value ?? "" : "");

                    await LoadLookups();
                    await LoadConfigs();
                    StateHasChanged();
                }
                else
                {
                    errorMessage = "Access denied: Please log in again.";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Session error: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private async Task LoadLookups()
    {
        try
        {
            using var client = CreateClient();

            // Use Branch/get (same endpoint as Counter Master)
            var bRes = await client.GetAsync($"{BaseUrl}Branch/get");
            if (bRes.IsSuccessStatusCode)
            {
                branches = await bRes.Content.ReadFromJsonAsync<List<BranchModel>>() ?? new List<BranchModel>();
            }
            else
            {
                // Fallback to getall if /get returns error
                var bRes2 = await client.GetAsync($"{BaseUrl}Branch/getall");
                if (bRes2.IsSuccessStatusCode)
                    branches = await bRes2.Content.ReadFromJsonAsync<List<BranchModel>>() ?? new List<BranchModel>();
            }

            // Use Counter/get (same endpoint as Counter Master)
            var cRes = await client.GetAsync($"{BaseUrl}Counter/get");
            if (cRes.IsSuccessStatusCode)
            {
                counters = await cRes.Content.ReadFromJsonAsync<List<CounterModel>>() ?? new List<CounterModel>();
            }
            else
            {
                var cRes2 = await client.GetAsync($"{BaseUrl}Counter/getall");
                if (cRes2.IsSuccessStatusCode)
                    counters = await cRes2.Content.ReadFromJsonAsync<List<CounterModel>>() ?? new List<CounterModel>();
            }

            // Load departments — fall back to default list if API unavailable
            await LoadDepartments(client);
        }
        catch { }
    }

    private async Task LoadDepartments(HttpClient client)
    {
        try
        {
            var dRes = await client.GetAsync($"{BaseUrl}Department/getall");
            if (dRes.IsSuccessStatusCode)
            {
                var depts = await dRes.Content.ReadFromJsonAsync<List<DepartmentModel>>() ?? new List<DepartmentModel>();
                deptRows = depts
                    .Where(d => !d.deleted)
                    .Select(d => new BillNoDeptRow { deptcode = d.deptcode, name = d.name })
                    .ToList();
                return;
            }
        }
        catch { }

        // Fallback: hardcoded departments matching reference
        deptRows = new List<BillNoDeptRow>
        {
            new() { deptcode = 1, name = "Lab" },
            new() { deptcode = 2, name = "Scan" },
            new() { deptcode = 3, name = "USG" },
            new() { deptcode = 4, name = "ECHO" },
            new() { deptcode = 5, name = "PACKAGE" },
            new() { deptcode = 6, name = "ECG" },
        };
    }

    private async Task LoadConfigs()
    {
        try
        {
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}BillNo/getall");
            if (response.IsSuccessStatusCode)
            {
                configs = await response.Content.ReadFromJsonAsync<List<BillNoConfigurationDto>>() ?? new List<BillNoConfigurationDto>();
            }
            else 
            {
                errorMessage = $"Error loading data: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch(Exception ex)
        {
            errorMessage = $"Error fetching API: {ex.Message}";
        }
    }

    private void SetRestart(string rType)
    {
        current.restartfinancialyear = false;
        current.restartcalendaryear = false;
        current.restartmonthly = false;
        current.restartdaily = false;

        if (rType == "fy") current.restartfinancialyear = true;
        if (rType == "cy") current.restartcalendaryear = true;
        if (rType == "mo") current.restartmonthly = true;
        if (rType == "dy") current.restartdaily = true;
    }

    private void NewConfiguration()
    {
        current = new BillNoConfigurationDto { issampleno = true, restartfinancialyear = true, allbranch = false, allcounter = false };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
        selectedBranchForMapping = null;
        selectedCountersForMapping.Clear();
    }

    private async Task EditConfig(BillNoConfigurationDto co)
    {
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}BillNo/get?bncode={co.bncode}";
            var fetched = await client.GetFromJsonAsync<BillNoConfigurationDto>(url);
            if (fetched != null)
            {
                current = fetched;
                current.bncode = co.bncode; // Preserve ID explicitly
            }
            else
            {
                current = JsonConvert.DeserializeObject<BillNoConfigurationDto>(JsonConvert.SerializeObject(co)) ?? new BillNoConfigurationDto();
            }
        }
        catch (Exception)
        {
            current = JsonConvert.DeserializeObject<BillNoConfigurationDto>(JsonConvert.SerializeObject(co)) ?? new BillNoConfigurationDto();
        }

        selectedBranchForMapping = null;
        selectedCountersForMapping.Clear();

        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveConfiguration()
    {
        isSubmitted = true;
        if (string.IsNullOrEmpty(TenantCode))
        {
            errorMessage = "Error: Tenant code is not loaded.";
            return;
        }

        if (string.IsNullOrWhiteSpace(current.name))
        {
            errorMessage = "Error: Configuration Name is required.";
            return;
        }

        // Validation requirements relaxed as per user request (mappings no longer mandatory for save)
        /*
        if (current.allbranch != true && !current.mappings.Any())
        {
            errorMessage = "Error: At least one Branch + Counter mapping is required.";
            return;
        }
        */

        // --- Conflict Validation Removed ---
        // Relaxed as per user request to allow multiple sequences or global overlaps.
        
        try
        {
            errorMessage = null;
            using var client = CreateClient();

            if (!isEditMode && current.orderno <= 0)
            {
                current.orderno = configs.Any() ? configs.Max(c => c.orderno) + 1 : 1;
            }

            // Flags are now enabled as per user requirement
            // current.allbranch = false; 
            // current.allcounter = false;

            HttpResponseMessage response;
            if (isEditMode)
                response = await client.PostAsJsonAsync($"{BaseUrl}BillNo/update", current);
            else
                response = await client.PostAsJsonAsync($"{BaseUrl}BillNo/insert", current);

            if (response.IsSuccessStatusCode)
            {
                await LoadConfigs();
                errorMessage = isEditMode ? "Configuration updated successfully." : "Configuration added successfully.";
                showForm = false;
                StateHasChanged();
            }
            else
            {
                errorMessage = $"Save failed: {await response.Content.ReadAsStringAsync()}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving: {ex.Message}";
        }
    }

    private async Task SoftDeleteConfig(long? bncode)
    {
        if (bncode == null || bncode == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this configuration?"))
        {
            try
            {
                using var client = CreateClient();
                var response = await client.GetAsync($"{BaseUrl}BillNo/softdelete?bncode={bncode}");
                if(response.IsSuccessStatusCode)
                {
                    await LoadConfigs();
                    errorMessage = "Configuration deleted successfully.";
                    if(current.bncode == bncode) showForm = false;
                }
                else 
                {
                    errorMessage = $"Delete failed: {await response.Content.ReadAsStringAsync()}";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Delete error: {ex.Message}";
            }
        }
    }


    private int? selectedBranchForMapping;
    private List<long?> selectedCountersForMapping = new();

    private void ToggleCounterForMapping(long? cntcode, object val)
    {
        if (val is bool b && b)
        {
            if (!selectedCountersForMapping.Contains(cntcode))
                selectedCountersForMapping.Add(cntcode);
        }
        else
        {
            selectedCountersForMapping.Remove(cntcode);
        }
    }

    private void ToggleAllCountersForSelectedBranch()
    {
        if (!selectedBranchForMapping.HasValue) return;

        var available = counters.Where(c => !(c.deleted ?? false) && c.bhcode == selectedBranchForMapping).Select(c => c.cntcode).ToList();
        
        if (IsAllCountersOfSelectedBranchChecked)
        {
            foreach(var c in available) selectedCountersForMapping.Remove(c);
        }
        else
        {
            foreach(var c in available) 
            {
                if (!selectedCountersForMapping.Contains(c))
                    selectedCountersForMapping.Add(c);
            }
        }
    }

    private bool IsAllCountersOfSelectedBranchChecked => 
        selectedBranchForMapping.HasValue && 
        counters.Any(c => !(c.deleted ?? false) && c.bhcode == selectedBranchForMapping) &&
        counters.Where(c => !(c.deleted ?? false) && c.bhcode == selectedBranchForMapping).All(c => selectedCountersForMapping.Contains(c.cntcode));

    private void AddMappingsToCurrent()
    {
        if (!selectedBranchForMapping.HasValue) return;

        if (current.allcounter == true)
        {
            // Check for duplicates in current list
            if (!current.mappings.Any(m => m.bhcode == selectedBranchForMapping && m.cntcode == null))
            {
                current.mappings.Add(new BillNoMappingItemDto
                {
                    bhcode = selectedBranchForMapping,
                    cntcode = null // Null means all counters for this branch
                });
            }
        }
        else
        {
            if (!selectedCountersForMapping.Any()) return;
            foreach (var cntcode in selectedCountersForMapping)
            {
                if (!current.mappings.Any(m => m.bhcode == selectedBranchForMapping && m.cntcode == cntcode))
                {
                    current.mappings.Add(new BillNoMappingItemDto
                    {
                        bhcode = selectedBranchForMapping,
                        cntcode = cntcode
                    });
                }
            }
        }

        // Reset Mapping UI
        selectedCountersForMapping.Clear();
    }

    private void RemoveMapping(BillNoMappingItemDto mapping)
    {
        current.mappings.Remove(mapping);
    }

    private void CloseForm()
    {
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
        selectedBranchForMapping = null;
        selectedCountersForMapping.Clear();
        current = new();
    }

    private void OnAllBranchChange(bool val)
    {
        current.allbranch = val;
        if (val) current.allcounter = true;
        StateHasChanged();
    }

    private void OnBranchSelectedForMapping()
    {
        selectedCountersForMapping.Clear();
        if (selectedBranchForMapping.HasValue && current.allcounter != true)
        {
            // Auto-select all counters for the chosen branch as per user request
            var available = counters.Where(c => !(c.deleted ?? false) && c.bhcode == selectedBranchForMapping).Select(c => c.cntcode).ToList();
            foreach(var c in available) selectedCountersForMapping.Add(c);
        }
    }
}