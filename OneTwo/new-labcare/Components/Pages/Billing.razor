    private double GetTotalPaid() => Math.Round(paymentSplits.Sum(s => s.Amount), 2);

    private double GetBalanceDue() => Math.Round(Math.Max(0, Model.NetPayable - GetTotalPaid()), 2);

    private void HandlePaymentInput(PaymentSplit currentSplit, ChangeEventArgs e)
    {
        string val = e.Value?.ToString() ?? "0";
        if (double.TryParse(val, out var enteredAmount))
        {
            double others = Math.Round(paymentSplits.Where(s => s != currentSplit).Sum(s => s.Amount), 2);
            double limit  = Math.Round(Model.NetPayable - others, 2);
            currentSplit.Amount = enteredAmount > limit ? limit : Math.Max(0, enteredAmount);
        }
        else
        {
            currentSplit.Amount = 0;
        }
        StateHasChanged();
    }

    private void AutofillCustomer(CustomerModel customer)
    {
        Model.custid       = customer.custid;
        Model.PatientName  = customer.name ?? "";
        Model.SearchMobile = customer.mobile ?? "";
        Model.Prefix       = customer.nametitile ?? "";
        
        var g = customer.gender?.Trim().ToLower() ?? "";
        if (g == "m" || g == "male")
        {
            Model.Gender = "Male";
        }
        else if (g == "f" || g == "female")
        {
            Model.Gender = "Female";
        }
        else if (g == "other" || g == "o")
        {
            Model.Gender = "Other";
        }
        else
        {
            var lowerPrefix = (customer.nametitile ?? "").ToLower().Trim();
            if (lowerPrefix == "mr." || lowerPrefix == "mr" || lowerPrefix == "master" || lowerPrefix == "master." || lowerPrefix == "mast" || lowerPrefix == "mast.")
            {
                Model.Gender = "Male";
            }
            else if (lowerPrefix == "mrs." || lowerPrefix == "mrs" || lowerPrefix == "ms." || lowerPrefix == "ms" || lowerPrefix == "miss" || lowerPrefix == "miss.")
            {
                Model.Gender = "Female";
            }
            else
            {
                Model.Gender = "";
            }
        }

        Model.AgeY         = customer.ageyears;
        Model.AgeM         = customer.agemonths;
        Model.AgeD         = customer.agedays;
        Model.Email        = customer.email ?? "";
        Model.Address      = customer.street ?? "";
        Model.careoftitile = customer.careoftitile ?? "";
        Model.careofinitial = customer.careofinitial ?? "";
        Model.careof       = customer.careof ?? "";
        Model.Occupation   = customer.occupation ?? "";
        Model.IsVIP        = customer.isregular ?? false;

        if (customer.dateofbirth.HasValue)
            Model.Dob = customer.dateofbirth.Value;

        showNameDropdown   = false;
        showMobileDropdown = false;
        customerResults.Clear();
        StateHasChanged();
    }

