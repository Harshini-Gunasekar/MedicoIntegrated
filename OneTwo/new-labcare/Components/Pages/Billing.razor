    // ─────────────────────────────────────────────────────────────────────────
    // Core financial helper
    // ─────────────────────────────────────────────────────────────────────────
    private (double testGross, double totalDiscount, double homeCharge,
             double testNetAfterDiscount, double serverTotalAmount) GetFinancials()
    {
        double testGross            = Math.Round(Model.BillAmount, 2);
        double totalDiscount        = Math.Round(Model.GeneralConcessionValue + Model.ReferralConcessionValue, 2);
        double homeCharge           = Math.Round(Model.HomeCollection ? (Model.homecollectioncharge ?? 0.0) : 0.0, 2);
        double testNetAfterDiscount = Math.Round(Math.Max(0, testGross - totalDiscount), 2);
        double serverTotalAmount    = Math.Round(testNetAfterDiscount + homeCharge, 2);
        return (testGross, totalDiscount, homeCharge, testNetAfterDiscount, serverTotalAmount);
    }

    protected override async Task OnInitializedAsync()
    {
        Model.BillDate      = DateTime.Now;
        Model.CollectedDate = DateTime.Now;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
            await EnsureBillNoSeries(); 
            
            if (!string.IsNullOrEmpty(edit) && Guid.TryParse(edit, out var billGuid))
            {
                await LoadBillForEdit(billGuid);
            }

            StateHasChanged();
        }
    }

    private List<BillNoModel> availableBillSeries = new();

    private string GetBillNoPreview()
    {
        if (Model.bhcode == null || Model.cntcode == null || Model.bhcode == 0 || Model.cntcode == 0) 
            return "SELECT BRANCH & COUNTER";

        var config = availableBillSeries.FirstOrDefault(c => c.deleted != true &&
            (c.allbranch == true || c.bhcode == Model.bhcode) &&
            (c.allcounter == true || c.cntcode == Model.cntcode));

        if (config == null) config = availableBillSeries.FirstOrDefault(c => c.deleted != true);

        int orderNo = config?.orderno ?? 1;
        string fy = $"{DateTime.Now:yy}-{(DateTime.Now.Year + 1) % 100}";
        
        // Format: jhb{bhcode}-{cntcode}/{orderno:D3}/{fy}
        return $"jhb{Model.bhcode}-{Model.cntcode}/{orderNo:D3}/{fy}";
    }

    private async Task LoadData()
    {
        try
        {
            var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
            string tName = "";
            int uCode = 0;

            if (userResult.Success && userResult.Value != null)
            {
                var user = userResult.Value;
                TenantCode = user.TenantCode ?? "";
                AuthToken = user.AuthToken ?? "";
                tName = user.TenantName ?? "";
                uCode = user.UserCode ?? 0;
            }
            else
            {
                var tc = await _sessionStorage.GetAsync<string>("tenant_code");
                var tk = await _sessionStorage.GetAsync<string>("authToken");
                TenantCode = tc.Success ? tc.Value ?? "" : "";
                AuthToken = tk.Success ? tk.Value ?? "" : "";
            }

            // Check for edit price rights — Admin (usercode=1) or Administrator role or Billing ToEdit right
            canEditPrice = false;
            if (uCode == 1 || (userResult.Success && userResult.Value != null && userResult.Value.Role == "Administrator"))
            {
                canEditPrice = true;
            }
            else
            {
                var rightsResult = await _sessionStorage.GetAsync<List<UserFormRightsModel.User_Rights>>("UserRights");
                if (rightsResult.Success && rightsResult.Value != null)
                {
                    var billingRight = rightsResult.Value.FirstOrDefault(r =>
                        string.Equals(r.ModuleName, "Billing", StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(r.Department, "Reception", StringComparison.OrdinalIgnoreCase));
                    if (billingRight != null && billingRight.ToEdit)
                    {
                        canEditPrice = true;
                    }
                }
            }

            // Sync with TenantState first to have authoritative values
            var bhResult = await _sessionStorage.GetAsync<string>("bhcode");
            var cntResult = await _sessionStorage.GetAsync<string>("cntcode");
            
            int? s_bh = (bhResult.Success && int.TryParse(bhResult.Value, out var b)) ? b : null;
            int? s_cnt = (cntResult.Success && int.TryParse(cntResult.Value, out var c)) ? c : null;

            if (uCode > 0)
            {
                try
                {
                    using var client = CreateClient();
                    var userResponse = await client.GetAsync($"{BaseUrl}User/getall");
                    if (userResponse.IsSuccessStatusCode)
                    {
                        var users = await userResponse.Content.ReadFromJsonAsync<List<user_master>>();
                        var currentUser = users?.FirstOrDefault(u => u.user_code == uCode);
                        if (currentUser != null)
                        {
                            if (currentUser.bh_code > 0) s_bh = currentUser.bh_code;
                            if (currentUser.cnt_code > 0) s_cnt = (int?)currentUser.cnt_code;
                        }
                    }
                }
                catch { }
            }
            
            TenantState.SetSession(TenantCode, AuthToken, tName, uCode, s_bh, s_cnt);

            // Set Model properties from TenantState
            if (TenantState.BranchCode > 0) Model.bhcode = TenantState.BranchCode;
            if (TenantState.CounterCode > 0) Model.cntcode = TenantState.CounterCode;

            var tidResult = await _sessionStorage.GetAsync<string>("cnttid");
            if (tidResult.Success && Guid.TryParse(tidResult.Value, out var tid)) activeCnttid = tid;

            var counterResult = await _sessionStorage.GetAsync<string>("counter");
            if (counterResult.Success) Model.Counter = counterResult.Value ?? "N/A";

            var branchResult = await _sessionStorage.GetAsync<string>("branch");
            if (branchResult.Success) Model.Branch = branchResult.Value ?? "N/A";

            var caseNoResult = await _sessionStorage.GetAsync<string>("case_no");
            Model.CaseNo = caseNoResult.Success
                ? caseNoResult.Value ?? ""
                : "";

            await LoadDoctors();
            await LoadTests();
            await LoadPayModes();
            await LoadBranches();
            await LoadCounters();
            await LoadAreas();
            await LoadPrefixes();
            await LoadDocuments();
            await LoadFeeTypes();

            if (Model.bhcode > 0 && Model.cntcode > 0)
            {
                await FetchBillNos();
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"LoadData error: {ex.Message}") */;
        }
    }

    private async Task ScanDocument(string docId)
    {
        // Validation: Ensure necessary details are present before calling the app
        if (string.IsNullOrEmpty(Model.PatientName))
        {
            statusMessage = "⚠ Please enter Patient Name before scanning.";
            isSuccess = false;
            Toast.Warning(statusMessage, "Scan");
            StateHasChanged();
            return;
        }

        var docTypeId = docId == "doc1" ? Model.doc1_dmid : Model.doc2_dmid;
        if (docTypeId == null || docTypeId == 0)
        {
            statusMessage = "⚠ Please select ID Type before scanning.";
            isSuccess = false;
            Toast.Warning(statusMessage, "Scan");
            StateHasChanged();
            return;
        }

        var scanId = Guid.NewGuid().ToString();
        var callbackUrl = $"{NavManager.BaseUri}api/scan/callback/{scanId}";
        
        // Upload endpoint — base URL driven by appsettings.json via BaseUrl
        var api = $"{BaseUrl}Files/upload";
        
        // Path details requested: labcare bucket, labcare folder, select tenant_folder, customers folder, bill_id
        var bucket = "labcare";
        var tenant = string.IsNullOrEmpty(TenantCode) ? "default" : TenantCode;
        var billId = string.IsNullOrEmpty(Model.CaseNo) ? "new_bill" : Model.CaseNo;
        var clientFolder = $"labcare/{tenant}/customers/{billId}";
        
        // Use patient name as filename if available
        var namePart = !string.IsNullOrEmpty(Model.PatientName) ? Model.PatientName.Replace(" ", "_") : docId;
        var fileName = $"{namePart}_{docId}.jpg";

        // Files API requires a numeric entityId. If new, we use 1 as a placeholder (API rejects <= 0)
        string entityIdStr = "1";
        if (Model.custid > 0) 
        {
            entityIdStr = Model.custid.ToString();
        }
        else if (!string.IsNullOrEmpty(Model.PatientId) && long.TryParse(Model.PatientId, out _))
        {
            entityIdStr = Model.PatientId;
        }
        
        var protocolUrl = $"iscan://upload?api={Uri.EscapeDataString(api)}" +
                          $"&bucketname={Uri.EscapeDataString(bucket)}" +
                          $"&clientfolder={Uri.EscapeDataString(clientFolder)}" +
                          $"&filename={Uri.EscapeDataString(fileName)}" +
                          $"&token={Uri.EscapeDataString(AuthToken)}" +
                          $"&tenantcode={Uri.EscapeDataString(TenantCode)}" +
                          $"&entityid={Uri.EscapeDataString(entityIdStr)}" +
                          $"&entitytype=customers" +
                          $"&prefix={docId}" +
                          $"&callback={Uri.EscapeDataString(callbackUrl)}";
        
        await JSRuntime.InvokeVoidAsync("openProtocol", protocolUrl);
        
        // Start polling for the result
        _ = PollForScanResult(scanId, docId);
    }

    private async Task PollForScanResult(string scanId, string docId)
    {
        _pollCts?.Cancel();
        _pollCts = new System.Threading.CancellationTokenSource();
        var token = _pollCts.Token;

        int attempts = 0;
        while (!token.IsCancellationRequested && attempts < 60) // Poll for 2 minutes
        {
            try
            {
                await Task.Delay(2000, token);
                attempts++;

                using var client = ClientFactory.CreateClient();
                var response = await client.GetAsync($"{NavManager.BaseUri}api/scan/status/{scanId}", token);
                
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<ScanStatusResponse>(cancellationToken: token);
                    if (result != null && result.success)
                    {
                        if (docId == "doc1") Model.doc1_path = result.path;
                        else if (docId == "doc2") Model.doc2_path = result.path;
                        
                        await InvokeAsync(StateHasChanged);
                        break;
                    }
                }
            }
            catch (OperationCanceledException) { break; }
            catch (Exception ex) { /* Console.WriteLine($"Polling error: {ex.Message}") */; }
        }
    }

