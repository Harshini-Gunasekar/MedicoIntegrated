            }

            Model.SelectedTests.Add(new BillingTestItem
            {
                SNo         = Model.SelectedTests.Count + 1,
                tcode       = (long)test.tcode,
                TestDetails = test.name,
                BaseAmount  = test.amount,
                CommissionPercent = 0,
                TotalAmount = test.amount
            });
            RecalculateTotals();
        }
        testSearchQuery  = "";
        showTestDropdown = false;
        StateHasChanged();

        await Task.Delay(50);
        try
        {
            await testSearchInput.FocusAsync();
        }
        catch {}
    }

    private async Task OnTestSearchKeyDown(KeyboardEventArgs e)
    {
        if (!showTestDropdown || filteredTestResults == null || !filteredTestResults.Any())
        {
            return;
        }

        if (e.Key == "ArrowDown")
        {
            activeTestIndex++;
            if (activeTestIndex >= filteredTestResults.Count)
            {
                activeTestIndex = 0;
            }
            StateHasChanged();
        }
        else if (e.Key == "ArrowUp")
        {
            activeTestIndex--;
            if (activeTestIndex < 0)
            {
                activeTestIndex = filteredTestResults.Count - 1;
            }
            StateHasChanged();
        }
        else if (e.Key == "Enter")
        {
            if (activeTestIndex >= 0 && activeTestIndex < filteredTestResults.Count)
            {
                var selectedTest = filteredTestResults[activeTestIndex];
                await SelectTest(selectedTest);
            }
        }
    }

    private void OnMobileKeyDown(KeyboardEventArgs e)
    {
        if (!showMobileDropdown || !customerResults.Any()) return;

        if (e.Key == "ArrowDown")
        {
            activeMobileIndex = (activeMobileIndex + 1) % customerResults.Count;
            StateHasChanged();
        }
        else if (e.Key == "ArrowUp")
        {
            activeMobileIndex = (activeMobileIndex - 1 + customerResults.Count) % customerResults.Count;
            StateHasChanged();
        }
        else if (e.Key == "Enter")
        {
            if (activeMobileIndex >= 0 && activeMobileIndex < customerResults.Count)
            {
                AutofillCustomer(customerResults[activeMobileIndex]);
            }
        }
        else if (e.Key == "Escape")
        {
            showMobileDropdown = false;
            StateHasChanged();
        }
    }

    private void OnNameKeyDown(KeyboardEventArgs e)
    {
        if (!showNameDropdown || !customerResults.Any()) return;

        if (e.Key == "ArrowDown")
        {
            activeNameIndex = (activeNameIndex + 1) % customerResults.Count;
