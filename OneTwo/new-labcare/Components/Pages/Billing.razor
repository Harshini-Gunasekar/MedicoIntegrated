    private async Task TriggerServerSearch(string query, bool isNameSearch)
    {
        if (query.Length < 3)
        {
            customerResults.Clear();
            isSearching = false;
            return;
        }

        try
        {
            _searchCts?.Cancel();
            _searchCts = new System.Threading.CancellationTokenSource();
            var token = _searchCts.Token;

            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;

            isSearching = true;
            StateHasChanged();

            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}Customer/search?key={Uri.EscapeDataString(query)}");
            if (token.IsCancellationRequested) return;

            if (response.IsSuccessStatusCode)
            {
                customerResults = await response.Content.ReadFromJsonAsync<List<CustomerModel>>() ?? new();
                activeMobileIndex = 0;
                activeNameIndex = 0;
            }
        }
        catch (TaskCanceledException) { }
        catch (OperationCanceledException) { }
        catch (Exception ex) { /* Console.WriteLine($"Search error: {ex.Message}") */; }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

