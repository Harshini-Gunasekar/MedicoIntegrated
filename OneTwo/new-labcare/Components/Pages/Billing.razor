@page "/billing"
@rendermode InteractiveServer
@using LabCare.Models
@using LIMS_Backend.Model
@using LabCare.Services
@using Newtonsoft.Json
@inject NavigationManager NavManager
@inject BillingService BillingService
@inject IHttpClientFactory ClientFactory
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject LabCare.Services.TenantSessionState TenantState
@inject IJSRuntime JSRuntime
@inject LabCare.Services.NotificationService Toast
@implements IDisposable

<div class="billing-page-wrapper">
    <!-- Top Header Bar -->
    <div class="bl-header-bar">
        <div class="bl-header-item">
            <span class="bl-label">BRANCH</span>
            <div class="bl-select-wrapper header-select">
                <select class="bl-select fw-700 @((Model.bhcode ?? 0) == 0 ? "select-placeholder" : "")" @bind="Model.bhcode" @bind:after="OnBranchSelected" disabled="@(TenantState.BranchCode > 0)">
                    <option value="0">SELECT BRANCH</option>
                    @foreach (var br in branchesList)
                    {
                        <option value="@((long)br.bh_code)">@br.name?.ToUpper()</option>
                    }
                </select>
            </div>
        </div>
        <div class="bl-header-divider"></div>

        <div class="bl-header-item">
            <span class="bl-label">COUNTER</span>
            <div class="bl-select-wrapper header-select">
                <select class="bl-select fw-700 @((Model.cntcode ?? 0) == 0 ? "select-placeholder" : "")" @bind="Model.cntcode" @bind:after="OnCounterSelected" disabled="@(TenantState.CounterCode > 0)">
                    <option value="0">SELECT COUNTER</option>
                    @foreach (var cnt in filteredCounters)
                    {
                        <option value="@cnt.cntcode">@cnt.name?.ToUpper()</option>
                    }
                </select>
            </div>
        </div>

        <div class="bl-header-divider"></div>

        <div class="bl-header-item text-blue">
            <span class="bl-label">BILLING SERIAL NO.</span>
            <div class="bl-value fw-700">@(string.IsNullOrEmpty(Model.CaseNo) ? (string.IsNullOrEmpty(billNosData) ? GetBillNoPreview() : billNosData) : Model.CaseNo)</div>
        </div>
        <div class="bl-header-divider"></div>
        <div class="bl-header-item">
            <span class="bl-label">BILLING TIME</span>
            <div class="bl-value fw-600">
                <input type="datetime-local" class="bl-datetime-inline" @bind="Model.BillDate" />
            </div>
        </div>
        <div class="bl-header-divider"></div>
        <div class="bl-header-item">
            <span class="bl-label">SAMPLE COLLECTION TIME</span>
            <div class="bl-value fw-600">
                <input type="datetime-local" class="bl-datetime-inline" @bind="Model.CollectedDate" />
            </div>
        </div>
        <div class="bl-header-spacer"></div>
    </div>

    <!-- Main Content Layout -->
    <div class="bl-main-grid">
        <!-- LEFT COLUMN: Patient Identification -->
        <div class="bl-col bl-col-left">
            <div class="bl-card patient-card">
                <div class="bl-card-title with-icon">
                    <span class="material-symbols-outlined text-blue">account_circle</span>
                    Patient Identification
                </div>
                <div class="bl-segmented-control">
                    <button type="button" class="bl-segment-btn @(patientType == "Human" ? "active" : "")" @onclick='() => SetPatientType("Human")' title="Set patient type to Human">
                        <span class="material-symbols-outlined">person</span>
                        <span>Human</span>
                    </button>
                    <button type="button" class="bl-segment-btn @(patientType == "Animal" ? "active" : "")" @onclick='() => SetPatientType("Animal")' title="Set patient type to Animal">
                        <span class="material-symbols-outlined">pets</span>
                        <span>Animal</span>
                    </button>
                </div>

                <div class="bl-form-group mt-16 position-relative">
                    <label class="bl-input-label">SEARCH MOBILE / UID</label>
                    <div class="bl-input-with-icon">
                        <span class="material-symbols-outlined search-icon">search</span>
                        <input type="text" class="bl-input" value="@Model.SearchMobile" @oninput="OnMobileInput" @onkeydown="OnMobileKeyDown" placeholder="+91 98765 43210" @onfocus="() => HandleFocus(false)" @onblur="HideMobileDropdown" />
                    </div>

                    @if (isSearching && showMobileDropdown)
                    {
                        <div class="bl-search-dropdown"><div class="p-12 text-center text-sm">Searching...</div></div>
                    }
                    else if (showMobileDropdown && customerResults.Any())
                    {
                        <div class="bl-search-dropdown">
                            @for (int i = 0; i < customerResults.Count; i++)
                            {
                                var customer = customerResults[i];
                                int localIndex = i;
                                <div class="bl-search-item @(localIndex == activeMobileIndex ? "active-item" : "")"
                                     style="background-color: @(localIndex == activeMobileIndex ? "#f1f5f9" : "transparent"); cursor: pointer;"
                                     @onmousedown="() => AutofillCustomer(customer)"
                                     @onmouseover="() => activeMobileIndex = localIndex">
                                    <div class="bl-item-info">
                                        <div class="bl-item-name">@customer.name</div>
                                        <div class="bl-item-meta">@customer.mobile | @customer.custcode</div>
                                    </div>
                                    <div class="bl-item-date">@customer.gender</div>
                                </div>
                            }
                        </div>
                    }
                    else if (showMobileDropdown && !isSearching && !string.IsNullOrEmpty(Model.SearchMobile))
                    {
                        <div class="bl-search-dropdown">
                            <div class="p-12 text-center text-sm text-gray-400">No customers found.</div>
                        </div>
                    }
                </div>

                <div class="bl-form-group mt-16">
                    <label class="bl-input-label">PREFIX</label>
                    <div class="bl-select-wrapper">
                        <select class="bl-select @(string.IsNullOrEmpty(Model.Prefix) ? "select-placeholder" : "")" value="@Model.Prefix" @onchange="OnPrefixChanged">
                            <option value="">Select</option>
                            @foreach (var pref in prefixesList)
                            {
                                <option value="@pref.DisplayName">@pref.DisplayName</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="bl-form-group mt-16 position-relative">
                    <label class="bl-input-label">@(patientType == "Animal" ? "PET NAME" : "PATIENT NAME") <span class="lc-text-red">*</span></label>
                    <input type="text" class="bl-input" value="@Model.PatientName" @oninput="OnNameInput" @onkeydown="OnNameKeyDown" placeholder="Ankit Sharma" @onfocus="() => HandleFocus(true)" @onblur="HideNameDropdown" />
                    @if (isSearching && showNameDropdown)
                    {
                        <div class="bl-search-dropdown"><div class="p-12 text-center text-sm">Searching...</div></div>
                    }
                    else if (showNameDropdown && customerResults.Any())
                    {
                        <div class="bl-search-dropdown">
                            @for (int i = 0; i < customerResults.Count; i++)
                            {
                                var customer = customerResults[i];
                                int localIndex = i;
                                <div class="bl-search-item @(localIndex == activeNameIndex ? "active-item" : "")"
                                     style="background-color: @(localIndex == activeNameIndex ? "#f1f5f9" : "transparent"); cursor: pointer;"
                                     @onmousedown="() => AutofillCustomer(customer)"
                                     @onmouseover="() => activeNameIndex = localIndex">
                                    <div class="bl-item-info">
                                        <div class="bl-item-name">@customer.name</div>
                                        <div class="bl-item-meta">@customer.mobile | @customer.custcode</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (showNameDropdown && !isSearching && !string.IsNullOrEmpty(Model.PatientName))
                    {
                        <div class="bl-search-dropdown">
                            <div class="p-12 text-center text-sm text-gray-400">No customers found.</div>
                        </div>
                    }
                </div>

                <div class="bl-form-group mt-16">
                    <label class="bl-input-label">CARE OF DETAILS (C/O)</label>
                    <div style="display: grid; grid-template-columns: 85px 60px 1fr; gap: 8px;">
                        <div class="bl-select-wrapper">
                            <select class="bl-select @(string.IsNullOrEmpty(Model.careoftitile) ? "select-placeholder" : "")" @bind="Model.careoftitile" style="height: 32px; padding: 4px 24px 4px 8px; font-size: 11px;">
                                <option value="">C/O TYPE</option>
                                <option value="C/O">C/O</option>
                                <option value="S/O">S/O</option>
                                <option value="D/O">D/O</option>
                                <option value="W/O">W/O</option>
                            </select>
                        </div>
                        <input type="text" class="bl-input" @bind="Model.careof" placeholder="CARE OF NAME" style="height: 32px; padding: 4px 8px; font-size: 11px;" />
                    </div>
                </div>

                <div class="bl-form-group mt-16">
                    <label class="bl-input-label">DATE OF BIRTH</label>
                    <input type="date" class="bl-input" value="@Model.Dob?.ToString("yyyy-MM-dd")" @onchange="OnDobChange" />
                </div>

                <div class="bl-form-group mt-16">
                    <label class="bl-input-label">GENDER</label>
                    <div class="bl-select-wrapper">
                        <select class="bl-select @(string.IsNullOrEmpty(Model.Gender) ? "select-placeholder" : "")" @bind="Model.Gender">
                            <option value="">Select</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="bl-form-group mt-16">
                    <label class="bl-input-label">AGE</label>
                    <div class="bl-age-group">
                        <div class="bl-age-box">
                            <input type="text" class="bl-age-input" @bind="Model.AgeY" @bind:after="UpdateDOBFromAge" placeholder="0" />
                            <span class="bl-age-lbl">YY</span>
                        </div>
                        <div class="bl-age-box">
                            <input type="text" class="bl-age-input" @bind="Model.AgeM" @bind:after="UpdateDOBFromAge" placeholder="0" />
                            <span class="bl-age-lbl">MM</span>
                        </div>
                        <div class="bl-age-box">
                            <input type="text" class="bl-age-input" @bind="Model.AgeD" @bind:after="UpdateDOBFromAge" placeholder="0" />
                            <span class="bl-age-lbl">DD</span>
                        </div>
                    </div>
                </div>

                <div class="bl-form-group mt-16">
                    <label class="bl-input-label">EMAIL</label>
                    <input type="email" class="bl-input" @bind="Model.Email" placeholder="patient@example.com" />
                </div>

                <div class="bl-form-group mt-16">
                    <label class="bl-input-label">ADDRESS</label>
                    <input type="text" class="bl-input" @bind="Model.Address" placeholder="17/19, street" />
                </div>

                <div class="bl-form-group mt-16 position-relative">
                    <label class="bl-input-label">AREA</label>
                    <input type="text" class="bl-input"
                           value="@areaSearchQuery"
                           @oninput="OnAreaInput"
                           @onkeydown="OnAreaKeyDown"
                           @onblur="HideAreaDropdown"
                           placeholder="Search area..." />
                    @if (showAreaDropdown)
                    {
                        <div class="bl-search-dropdown lc-top-100 lc-left-0 lc-right-0">
                            @for (int i = 0; i < filteredAreaResults.Count; i++)
                            {
                                var area = filteredAreaResults[i];
                                int localIndex = i;
                                <div class="bl-search-item @(localIndex == activeAreaIndex ? "active-item" : "")"
                                     style="background-color: @(localIndex == activeAreaIndex ? "#f1f5f9" : "transparent"); cursor: pointer;"
                                     @onmousedown="() => SelectArea(area)"
                                     @onmouseover="() => activeAreaIndex = localIndex">
                                    <div class="bl-item-info">
                                        <div class="bl-item-name">@area.areaname</div>
                                        <div class="bl-item-meta">@area.shortname | @area.areacode</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="bl-more-info mt-16 lc-cursor-pointer" @onclick="() => showMoreInfo = !showMoreInfo" style="user-select: none;">
                    More info <span class="material-symbols-outlined">@(showMoreInfo ? "expand_less" : "expand_more")</span>
                </div>

                @if (showMoreInfo)
                {
                    <div class="more-info-panel mt-12 p-12 rounded-8" style="background: #f8fafc; border: 1px dashed #cbd5e1; display: flex; flex-direction: column; gap: 12px;">
                        <!-- ID Type 1 -->
                        <div class="bl-form-group">
                            <div class="flex items-center justify-between mb-2">
                                <div class="bl-id-type-header" style="background: #4f46e5; padding: 4px 8px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; border-radius: 4px; width: 85px; height: 28px; box-sizing: border-box;">
                                    <select class="bl-id-type-select" @bind="Model.doc1_dmid" style="appearance: none; background: transparent; border: none; font-size: 10px; font-weight: 700; color: #ffffff; outline: none; width: 100%; cursor: pointer;">
                                        <option value="" style="color: #000;">ID TYPE 1</option>
                                        @foreach (var doc in documentsList)
                                        {
                                            <option value="@doc.dmid" style="color: #000;">@doc.dmname</option>
                                        }
                                    </select>
                                    <span class="material-symbols-outlined text-white" style="font-size: 14px;">expand_more</span>
                                </div>

                                <div class="bl-scan-status-container" style="background: transparent; border: none; padding: 0;">
                                    @if (!string.IsNullOrEmpty(Model.doc1_path))
                                    {
                                        <span class="material-symbols-outlined bl-scan-tick">check_circle</span>
                                        <span class="material-symbols-outlined bl-scan-cancel" @onclick='() => Model.doc1_path = null' title="Remove Scan">close</span>
                                    }
                                </div>
                            </div>

                            <div class="bl-yt-search-group" style="display: flex !important; align-items: center !important; background: #ffffff !important; border: 1.5px solid #e2e8f0 !important; border-radius: 6px !important; overflow: hidden !important; height: 32px !important; width: 100% !important;">
                                <input type="text" style="flex: 1 !important; border: none !important; background: transparent !important; padding: 0 10px !important; font-size: 11px !important; font-weight: 600 !important; outline: none !important; height: 100% !important; color: #1e293b !important; width: 50% !important;" @bind="Model.doc1_dmvalue" placeholder="ID Number" />
                                @if (string.IsNullOrEmpty(Model.doc1_path))
                                {
                                    <button type="button" style="background: #f1f5f9 !important; border: none !important; border-left: 1.5px solid #e2e8f0 !important; width: 32px !important; height: 100% !important; cursor: pointer !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; padding: 0 !important;" @onclick='() => ScanDocument("doc1")' title="Scan ID Proof">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M7 3H5a2 2 0 0 0-2 2v2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M3 17v2a2 2 0 0 0 2 2h2M7 12h10"/>
                                        </svg>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" style="background: #f1f5f9 !important; border: none !important; border-left: 1.5px solid #e2e8f0 !important; width: 32px !important; height: 100% !important; cursor: pointer !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; padding: 0 !important;" title="ID Scanned">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    </button>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(Model.doc1_path))
                            {
                                <div class="bl-scan-path-badge" title="@Model.doc1_path" style="font-size: 10px; margin-top: 4px;">
                                    <span class="material-symbols-outlined" style="font-size: 12px;">description</span>
                                    <span>@(Model.doc1_path.Length > 20 ? "..." + Model.doc1_path.Substring(Model.doc1_path.Length - 20) : Model.doc1_path)</span>
                                </div>
                            }
                        </div>

                        <!-- ID Type 2 -->
                        <div class="bl-form-group">
                            <div class="flex items-center justify-between mb-2">
                                <div class="bl-id-type-header" style="background: #4f46e5; padding: 4px 8px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; border-radius: 4px; width: 85px; height: 28px; box-sizing: border-box;">
                                    <select class="bl-id-type-select" @bind="Model.doc2_dmid" style="appearance: none; background: transparent; border: none; font-size: 10px; font-weight: 700; color: #ffffff; outline: none; width: 100%; cursor: pointer;">
                                        <option value="" style="color: #000;">ID TYPE 2</option>
                                        @foreach (var doc in documentsList)
                                        {
                                            <option value="@doc.dmid" style="color: #000;">@doc.dmname</option>
                                        }
                                    </select>
                                    <span class="material-symbols-outlined text-white" style="font-size: 14px;">expand_more</span>
                                </div>

                                <div class="bl-scan-status-container" style="background: transparent; border: none; padding: 0;">
                                    @if (!string.IsNullOrEmpty(Model.doc2_path))
                                    {
                                        <span class="material-symbols-outlined bl-scan-tick">check_circle</span>
                                        <span class="material-symbols-outlined bl-scan-cancel" @onclick='() => Model.doc2_path = null' title="Remove Scan">close</span>
                                    }
                                </div>
                            </div>

                            <div class="bl-yt-search-group" style="display: flex !important; align-items: center !important; background: #ffffff !important; border: 1.5px solid #e2e8f0 !important; border-radius: 6px !important; overflow: hidden !important; height: 32px !important; width: 100% !important;">
                                <input type="text" style="flex: 1 !important; border: none !important; background: transparent !important; padding: 0 10px !important; font-size: 11px !important; font-weight: 600 !important; outline: none !important; height: 100% !important; color: #1e293b !important; width: 50% !important;" @bind="Model.doc2_dmvalue" placeholder="ID Number" />
                                @if (string.IsNullOrEmpty(Model.doc2_path))
                                {
                                    <button type="button" style="background: #f1f5f9 !important; border: none !important; border-left: 1.5px solid #e2e8f0 !important; width: 32px !important; height: 100% !important; cursor: pointer !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; padding: 0 !important;" @onclick='() => ScanDocument("doc2")' title="Scan ID Proof">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M7 3H5a2 2 0 0 0-2 2v2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M3 17v2a2 2 0 0 0 2 2h2M7 12h10"/>
                                        </svg>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" style="background: #f1f5f9 !important; border: none !important; border-left: 1.5px solid #e2e8f0 !important; width: 32px !important; height: 100% !important; cursor: pointer !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; padding: 0 !important;" title="ID Scanned">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    </button>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(Model.doc2_path))
                            {
                                <div class="bl-scan-path-badge" title="@Model.doc2_path" style="font-size: 10px; margin-top: 4px;">
                                    <span class="material-symbols-outlined" style="font-size: 12px;">description</span>
                                    <span>@(Model.doc2_path.Length > 20 ? "..." + Model.doc2_path.Substring(Model.doc2_path.Length - 20) : Model.doc2_path)</span>
                                </div>
                            }
                        </div>

                        <!-- Preferred Language, Occupation & VIP Checkbox -->
                        <div class="bl-form-group">
                            <label class="bl-input-label">PREFERRED LANGUAGE</label>
                            <div class="bl-select-wrapper">
                                <select class="bl-select @(string.IsNullOrEmpty(Model.PreferredLanguage) ? "select-placeholder" : "")" @bind="Model.PreferredLanguage" style="height: 32px; padding: 4px 24px 4px 8px; font-size: 11px;">
                                    <option value="">Select Language</option>
                                    <option value="English">English</option>
                                    <option value="Hindi">Hindi</option>
                                    <option value="Tamil">Tamil</option>
                                    <option value="Telugu">Telugu</option>
                                    <option value="Kannada">Kannada</option>
                                    <option value="Malayalam">Malayalam</option>
                                    <option value="Bengali">Bengali</option>
                                    <option value="Gujarati">Gujarati</option>
                                    <option value="Marathi">Marathi</option>
                                    <option value="Punjabi">Punjabi</option>
                                    <option value="Odia">Odia</option>
                                    <option value="Urdu">Urdu</option>
                                    <option value="Assamese">Assamese</option>
                                    <option value="Spanish">Spanish</option>
                                    <option value="French">French</option>
                                    <option value="German">German</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>

                        <div class="bl-form-group">
                            <label class="bl-input-label">OCCUPATION</label>
                            <input type="text" class="bl-input" @bind="Model.Occupation" placeholder="e.g. Engineer, Teacher, Doctor" style="height: 32px; padding: 4px 8px; font-size: 11px;" />
                        </div>

                        <div class="bl-form-group mt-4">
                            <label style="display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; color: #64748b; cursor: pointer; user-select: none;">
                                <input type="checkbox" @bind="Model.IsVIP" style="width: 16px; height: 16px; accent-color: #4f46e5; cursor: pointer; border-radius: 4px;" />
                                VIP PATIENT
                            </label>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- MIDDLE COLUMN: Referral & Tests -->
        <div class="bl-col bl-col-mid">
            <!-- Referral Details -->
            <div class="bl-card referral-card mb-20">
                <div class="bl-card-title with-icon mb-16">
                    <span class="material-symbols-outlined text-blue">group</span>
                    Referral Details
                </div>

                <div class="bl-form-group position-relative">
                    <label class="bl-input-label">PRIMARY REFERRAL (DOCTOR)</label>
                    <input type="text" class="bl-input"
                           value="@primaryDoctorSearchQuery"
                           @oninput="OnPrimaryDoctorInput"
                           @onkeydown="OnPrimaryDoctorKeyDown"
                           @onblur="HidePrimaryDoctorDropdown"
                           placeholder="Enter referral..." />
                    @if (showPrimaryDoctorDropdown)
                    {
                        <div class="bl-search-dropdown lc-dropdown-pos-top-100">
                            @for (int i = 0; i < filteredPrimaryDoctorResults.Count; i++)
                            {
                                var doc = filteredPrimaryDoctorResults[i];
                                int localIndex = i;
                                <div class="bl-search-item @(localIndex == activePrimaryDoctorIndex ? "active-item" : "")"
                                     style="background-color: @(localIndex == activePrimaryDoctorIndex ? "#f1f5f9" : "transparent"); cursor: pointer;"
                                     @onmousedown="() => SelectPrimaryDoctor(doc)"
                                     @onmouseover="() => activePrimaryDoctorIndex = localIndex">
                                    <div class="bl-item-info">
                                        <div class="bl-item-name">@doc.name</div>
                                        <div class="bl-item-meta">@doc.shortname | @doc.dcode</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="bl-form-group position-relative mt-16">
                    <label class="bl-input-label">SECONDARY REFERRAL</label>
                    <input type="text" class="bl-input"
                           value="@secondaryDoctorSearchQuery"
                           @oninput="OnSecondaryDoctorInput"
                           @onkeydown="OnSecondaryDoctorKeyDown"
                           @onblur="HideSecondaryDoctorDropdown"
                           placeholder="Enter secondary referral..." />
