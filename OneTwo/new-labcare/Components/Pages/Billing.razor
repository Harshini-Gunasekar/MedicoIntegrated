    private void OnBaseAmountChanged(ChangeEventArgs e, BillingTestItem test)
    {
        var valStr = e.Value?.ToString();
        if (double.TryParse(valStr, out var newAmount))
        {
            test.BaseAmount = newAmount;
            test.TotalAmount = Math.Round(newAmount - (newAmount * test.CommissionPercent / 100), 2);
            RecalculateTotals();
        }
    }

    private void OnTestDiscountChanged(ChangeEventArgs e, BillingTestItem test)
    {
        var valStr = e.Value?.ToString();
        if (double.TryParse(valStr, out var newDiscountPercent))
        {
            test.CommissionPercent = Math.Clamp(newDiscountPercent, 0, 100);
            test.TotalAmount = Math.Round(test.BaseAmount - (test.BaseAmount * test.CommissionPercent / 100), 2);
            
            // Calculate total discount from all individual test discounts
            double totalDiscount = Model.SelectedTests.Sum(t => Math.Round(t.BaseAmount * t.CommissionPercent / 100, 2));
            
            // Assign this to General Concession and clear Referral Concession
            Model.GeneralConcessionValue = totalDiscount;
            double grossTotal = Model.SelectedTests.Sum(t => t.BaseAmount);
            if (grossTotal > 0)
            {
                Model.GeneralConcessionPercent = Math.Round((totalDiscount / grossTotal) * 100, 2);
            }
            else
            {
                Model.GeneralConcessionPercent = 0;
            }
            Model.ReferralConcessionValue = 0;
            Model.ReferralConcessionPercent = 0;
            
            RecalculateTotalsInternal(distributeGlobalToLocal: false);
        }
    }

    private void RemoveTest(BillingTestItem test)
    {
        Model.SelectedTests.Remove(test);
        for (int i = 0; i < Model.SelectedTests.Count; i++)
            Model.SelectedTests[i].SNo = i + 1;
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {
        RecalculateTotalsInternal(distributeGlobalToLocal: true);
    }

    private void RecalculateTotalsInternal(bool distributeGlobalToLocal)
    {
        statusMessage = "";
        int testCount = Model.SelectedTests.Count;
        double grossTotal = Math.Round(Model.SelectedTests.Sum(t => t.BaseAmount), 2);
        Model.BillAmount = grossTotal;

        if (distributeGlobalToLocal)
        {
            // First, compute concession values based on current input percentages/values
            if (grossTotal > 0)
            {
                if (Model.GeneralConcessionPercent > 0)
                    Model.GeneralConcessionValue = Math.Round(grossTotal * (Model.GeneralConcessionPercent / 100), 2);
                else if (Model.GeneralConcessionValue > 0)
                    Model.GeneralConcessionPercent = Math.Round((Model.GeneralConcessionValue / grossTotal) * 100, 2);

                if (Model.ReferralConcessionPercent > 0)
                    Model.ReferralConcessionValue = Math.Round(grossTotal * (Model.ReferralConcessionPercent / 100), 2);
                else if (Model.ReferralConcessionValue > 0)
                    Model.ReferralConcessionPercent = Math.Round((Model.ReferralConcessionValue / grossTotal) * 100, 2);
            }

            double combinedConcession = Math.Round(Model.GeneralConcessionValue + Model.ReferralConcessionValue, 2);

            // Distribute combinedConcession proportionally by percentage among all selected tests
            if (testCount > 0)
            {
                double combinedConcessionPercent = grossTotal > 0 ? (combinedConcession / grossTotal) * 100 : 0;
                double distributedDiscountSum = 0;

                for (int i = 0; i < testCount; i++)
                {
                    var test = Model.SelectedTests[i];
                    double testDiscountAmount;

                    if (i == testCount - 1)
                    {
                        testDiscountAmount = Math.Round(combinedConcession - distributedDiscountSum, 2);
                    }
                    else
                    {
                        testDiscountAmount = Math.Round(test.BaseAmount * combinedConcessionPercent / 100, 2);
                        distributedDiscountSum += testDiscountAmount;
                    }

                    if (test.BaseAmount > 0)
                    {
                        test.CommissionPercent = Math.Round((testDiscountAmount / test.BaseAmount) * 100, 2);
                    }
                    else
                    {
                        test.CommissionPercent = 0;
                    }

                    test.TotalAmount = Math.Round(Math.Max(0, test.BaseAmount - testDiscountAmount), 2);
                }
            }
        }
        else
        {
            // If we are not distributing global to local, it means local test discounts were edited directly.
            // We just update the TotalAmount for each test based on its CommissionPercent.
            foreach (var test in Model.SelectedTests)
            {
                test.TotalAmount = Math.Round(Math.Max(0, test.BaseAmount - (test.BaseAmount * test.CommissionPercent / 100)), 2);
            }
        }

        double finalCombinedConcession = Math.Round(Model.GeneralConcessionValue + Model.ReferralConcessionValue, 2);

        if (grossTotal > 0 && finalCombinedConcession > grossTotal * 0.5)
        {
            isSuccess     = false;
            statusMessage = "Total concessions exceed 50% limit!";
            Toast.Warning(statusMessage, "Concession");
        }

        double homeCharge = Model.HomeCollection ? Math.Round(Model.homecollectioncharge ?? 0.0, 2) : 0.0;

        double netPayable    = Math.Round(Math.Max(0, (grossTotal - finalCombinedConcession) + homeCharge), 2);
        Model.NetPayable     = netPayable;
        Model.DiscountAmount = finalCombinedConcession;

        double currentTotalPaid = Math.Round(paymentSplits.Sum(s => s.Amount), 2);
        if (currentTotalPaid > Model.NetPayable + 0.001)
        {
            for (int i = paymentSplits.Count - 1; i >= 0; i--)
            {
                double others = Math.Round(paymentSplits.Where((s, idx) => idx != i).Sum(s => s.Amount), 2);
                paymentSplits[i].Amount = Math.Max(0, Math.Round(Model.NetPayable - others, 2));
                if (Math.Round(paymentSplits.Sum(s => s.Amount), 2) <= Model.NetPayable + 0.001) break;
            }
        }

        StateHasChanged();
    }

    private void OnPrefixChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        Model.Prefix = val ?? "";
        if (!string.IsNullOrEmpty(val))
        {
            var lower = val.ToLower().Trim();
            if (lower == "mr." || lower == "mr" || lower == "master" || lower == "master." || lower == "mast" || lower == "mast.")
            {
                Model.Gender = "Male";
            }
            else if (lower == "mrs." || lower == "mrs" || lower == "ms." || lower == "ms" || lower == "miss" || lower == "miss.")
            {
                Model.Gender = "Female";
            }
        }
    }

    private void OnDobChange(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dob))
        {
            Model.Dob = dob;
            CalculateAge(dob);
        }
    }

    private void CalculateAge(DateTime dob)
    {
        DateTime today = DateTime.Now;
        int years  = today.Year  - dob.Year;
        int months = today.Month - dob.Month;
        int days   = today.Day   - dob.Day;

        if (days < 0) { months--; days += DateTime.DaysInMonth(today.Year, today.Month == 1 ? 12 : today.Month - 1); }
        if (months < 0) { years--; months += 12; }

        Model.AgeY = years;
        Model.AgeM = months;
        Model.AgeD = days;
        StateHasChanged();
    }

    private void UpdateDOBFromAge()
    {
        if ((Model.AgeY ?? 0) == 0 && (Model.AgeM ?? 0) == 0 && (Model.AgeD ?? 0) == 0) return;
        try
        {
            var dob = DateTime.Today
                .AddYears(-(Model.AgeY ?? 0))
                .AddMonths(-(Model.AgeM ?? 0))
                .AddDays(-(Model.AgeD ?? 0));
            if (dob <= DateTime.Today && dob > DateTime.MinValue)
                Model.Dob = dob;
        }
        catch { }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode) && !client.DefaultRequestHeaders.Contains("tenant_code"))
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        if (!string.IsNullOrEmpty(AuthToken))
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        return client;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // SaveBilling
    // ─────────────────────────────────────────────────────────────────────────
    private async Task SaveBilling()
    {
        // ...
        RecalculateTotals();

        var (testGross, totalDiscount, homeCharge, testNetAfterDiscount, serverTotalAmount)
            = GetFinancials();

        Model.NetPayable = serverTotalAmount;

        double paidAmount = GetTotalPaid();
        double cashPaid   = Math.Round(paymentSplits.FirstOrDefault(s => s.PaymodeName == PaymentMode.Cash)?.Amount ?? 0, 2);
        double cardPaid   = Math.Round(paymentSplits.FirstOrDefault(s => s.PaymodeName == PaymentMode.Card)?.Amount ?? 0, 2);
        double gPayPaid   = Math.Round(paymentSplits.FirstOrDefault(s => s.PaymodeName == PaymentMode.GPay)?.Amount  ?? 0, 2);

        // ── Validations ────────────────────────────────────────────────────
        // FIX: patient name alone is sufficient (walk-in patients have no custid)
        if (string.IsNullOrWhiteSpace(Model.PatientName))
        {
            isSuccess     = false;
            statusMessage = "Error: Patient Name is required.";
            Toast.Error(statusMessage, "Validation");
            return;
        }
        if ((Model.dcode ?? 0) == 0)
        {
            isSuccess     = false;
            statusMessage = "Error: Select a Primary Referral Doctor.";
            Toast.Error(statusMessage, "Validation");
            return;
        }
        if (Model.SelectedTests.Count == 0)
        {
            isSuccess     = false;
            statusMessage = "Error: No tests selected.";
            Toast.Error(statusMessage, "Validation");
            return;
        }
        if (Model.bhcode == null || Model.bhcode == 0 || Model.cntcode == null || Model.cntcode == 0)
        {
            isSuccess     = false;
            statusMessage = "Error: Branch and Counter selection is mandatory.";
            Toast.Error(statusMessage, "Validation");
            return;
        }
        if (paidAmount > serverTotalAmount + 0.01)
        {
            isSuccess     = false;
            statusMessage = $"Error: Paid (₹{paidAmount:N2}) cannot exceed Net Payable (₹{serverTotalAmount:N2}).";
            Toast.Error(statusMessage, "Payment");
            return;
        }

        // ── Primary paymode ───────────────────────────────────────────────
        int primaryPmCode = 1;
        if (cardPaid > 0)
            primaryPmCode = paymodes.FirstOrDefault(p => p.name.Contains("Card", StringComparison.OrdinalIgnoreCase))?.pmcode ?? 2;
        else if (gPayPaid > 0)
            primaryPmCode = paymodes.FirstOrDefault(p => p.name.Contains("GPay",  StringComparison.OrdinalIgnoreCase) ||
                                                          p.name.Contains("UPI",   StringComparison.OrdinalIgnoreCase))?.pmcode ?? 3;

        bool isCashBill = paidAmount >= serverTotalAmount - 0.01;

        IsLoading = true;
        StateHasChanged();

        try
        {
            double distributedHomeCharge = Model.HomeCollection ? homeCharge : 0;
            int    testCount             = Model.SelectedTests.Count;
            double finalRequestAmount    = testGross + distributedHomeCharge;

            var finalItems = Model.SelectedTests.Select((t, index) =>
            {
                double ratio        = testGross > 0 ? t.BaseAmount / testGross : 1.0 / testCount;
                double itemDiscount = Math.Round(ratio * totalDiscount, 2);
                double itemHomeShare = (index == testCount - 1)
                    ? Math.Round(distributedHomeCharge - (Math.Round(distributedHomeCharge / testCount, 2) * (testCount - 1)), 2)
                    : Math.Round(distributedHomeCharge / testCount, 2);

                return (object)new
                {
                    tcode         = t.tcode,
                    testamount    = Math.Round(t.BaseAmount + itemHomeShare, 2),
                    testrate      = Math.Round(t.BaseAmount + itemHomeShare, 2),
                    standardprice = Math.Round(t.BaseAmount, 2),
                    discount      = itemDiscount,
                    collection    = Math.Round(t.BaseAmount - itemDiscount + itemHomeShare, 2),
                    qty           = 1,
                    ispack        = false
                };
            }).ToList();

            // ── FIX 1: send custid as null when not selected (0 causes server confusion)
            // ── FIX 2: always send name so the server's Validate() is satisfied
            var request = new LabCare.Models.createlabbillrequest();
            request.labrequestmaster = new LabCare.Models.lab_request_master
            {
                requestguid = editingBillGuid,
                custid = (Model.custid.HasValue && Model.custid.Value != 0) ? Model.custid : null,
                name = Model.PatientName,
                gender = Model.Gender,
                dateofbirth = Model.Dob?.ToString("yyyy-MM-dd"),
                ageyears = Model.AgeY?.ToString(),
                agemonths = Model.AgeM?.ToString(),
                agedays = Model.AgeD?.ToString(),
                mobileno = Model.SearchMobile,
                address = Model.Address,
                areacode = Model.areacode,
                cntcode = Model.cntcode ?? 1,
                tmcode = 1, ftcode = 1, ctcode = 1, icode = 1, ricode = 1, dlcode = 1,
                pmcode = primaryPmCode,
                dcode = Model.dcode,
                seconddcode = (int?)Model.seconddcode,
                seconddoctorname = Model.SecondaryReferral,
                requestamount = finalRequestAmount,
                totalamount = serverTotalAmount,
                discountamount = totalDiscount,
                discountper = Model.GeneralConcessionPercent,
                paidamount = paidAmount,
                iscashbill = isCashBill,
                iscreditbill = !isCashBill,
                billtype = isCashBill ? "Cash" : "Due Bill",
                enteredbhcode = (int)(Model.bhcode ?? 1),
                pmc1 = cashPaid,
                pmc2 = cardPaid,
                pmc3 = gPayPaid,
                card_refno = "",
                bank_app = "",
                ishomecollection = Model.HomeCollection,
                homecollectioncharge = homeCharge,
                doc1_dmid = Model.doc1_dmid,
                doc1_dmvalue = Model.doc1_dmvalue,
                doc2_dmid = Model.doc2_dmid,
                doc2_dmvalue = Model.doc2_dmvalue,
                doc1_path = Model.doc1_path,
                doc2_path = Model.doc2_path,
                careoftitile = Model.careoftitile,
                careofinitial = Model.careofinitial,
                careof = Model.careof
            };

            request.labrequestdetails = Model.SelectedTests.Select((t, index) =>
            {
                double itemDiscount = Math.Round(t.BaseAmount - t.TotalAmount, 2);
                double itemHomeShare = (index == testCount - 1)
                    ? Math.Round(distributedHomeCharge - (Math.Round(distributedHomeCharge / testCount, 2) * (testCount - 1)), 2)
                    : Math.Round(distributedHomeCharge / testCount, 2);

                return new LabCare.Models.lab_request_details
                {
                    requestdetailsid = Guid.NewGuid(),
                    tcode = t.tcode,
                    testamount = Math.Round(t.BaseAmount + itemHomeShare, 2),
                    testrate = Math.Round(t.BaseAmount + itemHomeShare, 2),
                    standardprice = Math.Round(t.BaseAmount, 2),
                    discount = itemDiscount,
                    collection = Math.Round(t.BaseAmount - itemDiscount + itemHomeShare, 2),
                    qty = 1,
                    ispack = false,
                    testsno = index + 1
                };
            }).ToList();

            // Set the request as the final payload
            var payload = request;

            // ── Construct flat payload for server compatibility ────────────────
            var finalPayload = new Dictionary<string, object?>();

            // Map master fields to root
            foreach (var prop in typeof(LabCare.Models.lab_request_master).GetProperties())
            {
                if (prop.GetCustomAttributes(typeof(Dapper.Contrib.Extensions.ComputedAttribute), true).Length > 0) continue;
                var val = prop.GetValue(request.labrequestmaster);
                if (val != null) finalPayload[prop.Name] = val;
            }

            finalPayload["preferredlanguage"] = Model.PreferredLanguage;
            finalPayload["occupation"] = Model.Occupation;
            finalPayload["isvip"] = Model.IsVIP;
            finalPayload["refconper"] = Model.ReferralConcessionPercent;
            finalPayload["refconamount"] = Model.ReferralConcessionValue;

            // Map details to 'testitems' property which the server expects
            finalPayload["testitems"] = request.labrequestdetails;

            // Handle updates by ensuring requestguid is present
            if (editingBillGuid.HasValue)
            {
                finalPayload["requestguid"] = editingBillGuid.Value.ToString();
            }

            using var client = CreateClient();
            var endpoint = "create";
            
            var json = Newtonsoft.Json.JsonConvert.SerializeObject(finalPayload);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await client.PostAsync($"{BaseUrl}Billing/{endpoint}", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BillResponseDto>();
                if (result != null)
                {
                    isSuccess     = true;
                    statusMessage = $"✓ Bill saved! Sample ID: {result.requestsnoprint}";
                    Toast.Success(statusMessage, "Billing");
                    Model.CaseNo  = result.requestsnoprint ?? Model.CaseNo;
                    if (result.requestdatetime != null)
                    {
                        Model.CollectedDate = result.requestdatetime.Value.DateTime;
                    }
                    if (result.cnttid.HasValue)
                    {
                        activeCnttid = result.cnttid;
                        await _sessionStorage.SetAsync("cnttid", result.cnttid.Value.ToString());
                    }

                    // Store the guid so the PRINT button can use it
                    if (result.requestguid.HasValue)
                        lastSavedGuid = result.requestguid;

                    // Auto-print the bill after save
                    await PrintBill();

                    ClearForm();

                    // Navigate to Result Search so the saved bill is immediately visible
                    NavigationManager.NavigateTo("/result-search", forceLoad: false);
                }
            }
            else
            {
                var errorBody   = await response.Content.ReadAsStringAsync();
                var debugPayload = JsonConvert.SerializeObject(payload, Formatting.Indented);
                isSuccess     = false;
                statusMessage = $"Server error: {errorBody}";
                Toast.Error(statusMessage, "Billing");
                Console.Error.WriteLine($"Billing failed: {errorBody}\nPayload: {debugPayload}");
            }
        }
        catch (Exception ex)
        {
            isSuccess     = false;
            statusMessage = $"Save error: {ex.Message}";
            Toast.Error(statusMessage, "Billing");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PrintBill — calls report/getbill?requestguid=, decodes base64 PDF
    // ─────────────────────────────────────────────────────────────────────────
    private async Task PrintBill()
    {
        // Use the guid from a freshly saved bill first, then fall back to the bill being edited
        var guidToUse = lastSavedGuid ?? editingBillGuid;
        if (guidToUse == null)
        {
            Toast.Warning("No bill to print. Please save the bill first.", "Print");
            return;
        }

        try
        {
            using var client = CreateClient();
            var resp = await client.GetAsync($"{BaseUrl}report/getbill?requestguid={guidToUse.Value}");
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                Toast.Error($"Print failed: {err}", "Print");
                return;
            }

            // The API returns either a plain base64 string or a JSON object with a base64 field
            var raw = await resp.Content.ReadAsStringAsync();
            // Strip surrounding quotes if the server returned a quoted JSON string
            var base64 = raw.Trim().Trim('"');

            // Open the PDF via JS interop (triggers printing protocol)
            await JSRuntime.InvokeVoidAsync("openBase64Pdf", base64);
        }
        catch (Exception ex)
        {
            Toast.Error($"Print error: {ex.Message}", "Print");
        }
    }

    private async Task PreviewBill()
    {
        var guidToUse = lastSavedGuid ?? editingBillGuid;
        if (guidToUse == null)
        {
            Toast.Warning("No bill to preview. Please save the bill first.", "Preview");
            return;
        }

        try
        {
            using var client = CreateClient();
            var resp = await client.GetAsync($"{BaseUrl}report/getbill?requestguid={guidToUse.Value}");
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                Toast.Error($"Preview failed: {err}", "Preview");
                return;
            }

            var raw = await resp.Content.ReadAsStringAsync();
            var base64 = raw.Trim().Trim('"');

            // Open PDF preview via JS interop
            await JSRuntime.InvokeVoidAsync("openPdfPreview", base64);
        }
        catch (Exception ex)
        {
            Toast.Error($"Preview error: {ex.Message}", "Preview");
        }
    }

    private async Task FetchBillNos()
    {
        try
        {
            using var client = CreateClient();
            // Using the specific endpoint requested by the user
            var url = $"Billing/billnos?bhcode={Model.bhcode}&cntcode={Model.cntcode}";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                try
                {
                    var token = Newtonsoft.Json.Linq.JToken.Parse(content);
                    if (token is Newtonsoft.Json.Linq.JArray arr && arr.Any())
                    {
                        billNosData = arr[0]["orderno"]?.ToString();
                    }
                    else if (token is Newtonsoft.Json.Linq.JObject obj)
                    {
                        billNosData = obj["orderno"]?.ToString();
                    }
                    else
                    {
                        billNosData = content.Replace("\"", "");
                    }
                }
                catch
                {
                    billNosData = content.Replace("\"", ""); 
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error fetching billnos: {ex.Message}") */;
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ClearForm — reset without losing the success message
    // ─────────────────────────────────────────────────────────────────────────
    private void ClearForm()
    {
        // Preserve any success/error message shown after save
        var preservedMessage = statusMessage;
        var preservedSuccess = isSuccess;
        var preservedCaseNo  = Model.CaseNo;
        var preservedCollectedDate = Model.CollectedDate;
        var preservedBhcode  = Model.bhcode;
        var preservedCntcode = Model.cntcode;
        var preservedBranch  = Model.Branch;
        var preservedCounter = Model.Counter;

        Model = new BillingModel 
        { 
            BillDate = DateTime.Now, 
            CollectedDate = preservedCollectedDate, 
            CaseNo = preservedCaseNo ?? "",
            bhcode = preservedBhcode,
            cntcode = preservedCntcode,
            Branch = preservedBranch,
            Counter = preservedCounter
        };
        paymentSplits = new()
        {
            new PaymentSplit { PaymodeName = PaymentMode.Cash, Amount = 0 },
            new PaymentSplit { PaymodeName = PaymentMode.Card, Amount = 0 },
            new PaymentSplit { PaymodeName = PaymentMode.GPay, Amount  = 0 }
        };
        primaryDoctorSearchQuery   = "";
        secondaryDoctorSearchQuery = "";
        areaSearchQuery            = "";
        homeAreaSearchQuery        = "";
        testSearchQuery            = "";
        filteredPrimaryDoctorResults.Clear();
        filteredTestResults.Clear();
        customerResults.Clear();

        statusMessage = preservedMessage;
        isSuccess     = preservedSuccess;
        editingBillGuid = null;
        patientType = "Human";
        showMoreInfo = false;

        StateHasChanged();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // EnsureBillNoSeries — Proactively initialize bill numbering to prevent server rejections
    // ─────────────────────────────────────────────────────────────────────────
    private async Task EnsureBillNoSeries()
    {
        try
        {
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}BillNo/getall");
            if (response.IsSuccessStatusCode)
            {
                var configs = await response.Content.ReadFromJsonAsync<List<BillNoModel>>();
                if (configs != null)
                {
                    availableBillSeries = configs;
                    StateHasChanged();
                }

                if (configs == null || !configs.Any(c => c.deleted != true))
                {
                    var defaultSeries = new 
                    {
                        name = "Master Billing Series",
                        shortname = "BIL",
                        isdefault = true,
                        allbranch = true,
                        allcounter = true,
                        isbillno = true,
                        issampleno = true,
                        isalldepartment = true,
                        restartfinancialyear = true,
                        entereddate = DateTime.Now,
                        tenant_code = TenantCode,
                        usercode = 1,
                        computercode = 1
                    };
                    await client.PostAsJsonAsync($"{BaseUrl}BillNo/insert", defaultSeries);
                }
            }
        }
        catch { }
    }

    private async Task LoadBillForEdit(Guid guid)
    {
        IsLoading = true;
        try
        {
            var bill = await BillingService.GetByGuidAsync(guid);
            if (bill != null)
            {
                editingBillGuid = guid;

                double commPercent = 0;
                if (bill.dcode.HasValue)
                {
                    var doc = doctorList.FirstOrDefault(d => d.dcode == bill.dcode.Value);
                    if (doc != null && doc.ftcode.HasValue)
                    {
                        var ft = feeTypesList.FirstOrDefault(f => f.ftcode == doc.ftcode.Value);
                        if (ft != null && ft.commissionpercentage.HasValue)
                        {
                            commPercent = ft.commissionpercentage.Value;
                        }
                    }
                }

                // Preserve existing bhcode if the loaded bill doesn't have a valid enteredbhcode
                long? targetBhcode = (bill.enteredbhcode.HasValue && bill.enteredbhcode.Value > 0)
                    ? (long)bill.enteredbhcode.Value
                    : Model.bhcode;

                Model = new BillingModel
                {
                    custid = bill.custid,
                    PatientName = bill.patientname ?? "",
                    Gender = bill.gender ?? "",
                    SearchMobile = bill.mobileno ?? "",
                    AgeY = int.TryParse(bill.ageyears, out var y) ? y : null,
                    AgeM = int.TryParse(bill.agemonths, out var m) ? m : null,
                    AgeD = int.TryParse(bill.agedays, out var d) ? d : null,
                    Address = bill.address ?? "",
                    Email = bill.email ?? "",
                    areacode = bill.areacode,
                    AreaName = bill.areaname ?? "",
                    careoftitile = bill.careoftitile ?? "",
                    careofinitial = bill.careofinitial ?? "",
                    careof = bill.careof ?? "",
                    PreferredLanguage = bill.preferredlanguage ?? "",
                    Occupation = bill.occupation ?? "",
                    IsVIP = bill.isvip ?? false,
                    BillAmount = bill.requestamount ?? 0,
                    GeneralConcessionPercent = bill.discountper ?? 0,
                    GeneralConcessionValue = Math.Max(0, Math.Round((bill.discountamount ?? 0) - (bill.refconamount ?? 0), 2)),
                    ReferralConcessionPercent = bill.refconper ?? 0,
                    ReferralConcessionValue = bill.refconamount ?? 0,
                    DiscountAmount = bill.discountamount ?? 0,
                    NetPayable = bill.totalamount ?? 0,
                    bhcode = targetBhcode,
                    cntcode = bill.cntcode.HasValue && bill.cntcode.Value > 0 ? bill.cntcode.Value : Model.cntcode,
                    CaseNo = bill.requestsnoprint ?? Model.CaseNo,
                    BillDate = bill.requestdatetime?.DateTime ?? DateTime.Now,
                    dcode = bill.dcode,
                    seconddcode = bill.seconddcode,
                    specialdiscount = bill.specialdiscount ?? 0,
                    ourdispercentage = bill.ourdispercentage ?? 0,
                    ourdiscount = bill.ourdiscount ?? 0,
                    ishomecollection = bill.ishomecollection ?? false,
                    HomeCollection = bill.ishomecollection ?? false,
                    homecollectioncharge = bill.homecollectioncharge,
                    homecollectionareacode = bill.homecollectionareacode,
                    Counter = bill.countername ?? Model.Counter,
                    SelectedTests = bill.testitems.Select((t, i) => {
                        double stdPrice = t.standardprice ?? 0;
                        double discAmt = t.discount ?? 0;
                        double discPercent = stdPrice > 0 ? Math.Round((discAmt / stdPrice) * 100, 2) : 0;
                        return new BillingTestItem
                        {
                            SNo = i + 1,
                            tcode = t.tcode,
                            TestDetails = t.testname ?? "Test",
                            BaseAmount = stdPrice,
                            CommissionPercent = discPercent,
                            TotalAmount = stdPrice - discAmt
                        };
                    }).ToList()
                };

                // Load primary and secondary doctor names directly from the API response with fallback lookups
                primaryDoctorSearchQuery = bill.doctorname ?? "";
                if (bill.dcode.HasValue)
                {
                    var doc = doctorList.FirstOrDefault(d => d.dcode == bill.dcode.Value);
                    if (doc != null)
                    {
                        primaryDoctorSearchQuery = doc.name;
                    }
                }

                secondaryDoctorSearchQuery = bill.seconddoctorname ?? "";
                Model.SecondaryReferral = bill.seconddoctorname ?? "";
                if (bill.seconddcode.HasValue)
                {
                    var doc = doctorList.FirstOrDefault(d => d.dcode == bill.seconddcode.Value);
                    if (doc != null)
                    {
                        secondaryDoctorSearchQuery = doc.name;
                        Model.SecondaryReferral = doc.name;
                    }
                }

                // Load area name directly from the API response with fallback lookup
                areaSearchQuery = bill.areaname ?? "";
                if (bill.areacode.HasValue)
                {
                    var area = areaList.FirstOrDefault(a => a.areacode == bill.areacode.Value);
                    if (area != null)
                    {
                        areaSearchQuery = area.areaname;
                        Model.AreaName = area.areaname;
                    }
                }

                paymentSplits = new()
                {
                    new PaymentSplit { PaymodeName = PaymentMode.Cash, Amount = bill.pmc1 ?? 0 },
                    new PaymentSplit { PaymodeName = PaymentMode.Card, Amount = bill.pmc2 ?? 0 },
                    new PaymentSplit { PaymodeName = PaymentMode.GPay, Amount = bill.pmc3 ?? 0 }
                };

                if (bill.cnttid.HasValue)
                {
                    activeCnttid = bill.cnttid;
                    await _sessionStorage.SetAsync("cnttid", bill.cnttid.Value.ToString());
                }

                // Proactively reload counters and bill numbering for the branch
                if (Model.bhcode.HasValue)
                {
                    await LoadCounters();
                    await FetchBillNos();
                }

                RecalculateTotals();

                statusMessage = $"Loaded Bill: {bill.requestsnoprint}";
                isSuccess = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error loading bill details: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleCloseCounter()
    {
        try
        {
            // Priority 1: Current active ID from memory/session
            // Priority 2: Fallback from storage
            // Priority 3: Hardcoded last resort (per user example)
            
            Guid? targetId = activeCnttid;
            
            if (targetId == null)
            {
                var cnttidResult = await _sessionStorage.GetAsync<string>("cnttid");
                if (cnttidResult.Success && Guid.TryParse(cnttidResult.Value, out var sid))
                    targetId = sid;
                else
                    targetId = Guid.Parse("199a6ac1-d94b-46c8-8d79-46ef27144d3c");
            }

            var dto = new CloseCounterDto { cnttid = targetId, usercode = 1 };
            
            IsLoading = true;
            StateHasChanged();

            if (await BillingService.CloseCounterAsync(dto))
            {
                statusMessage = $"✓ Counter {targetId} closed successfully.";
                isSuccess = true;
                Toast.Success(statusMessage, "Counter");
                activeCnttid = null;
                await _sessionStorage.DeleteAsync("cnttid");
            }
            else
            {
                statusMessage = "Error: Failed to close counter. Shift may already be closed.";
                isSuccess = false;
                Toast.Error(statusMessage, "Counter");
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error closing counter: {ex.Message}";
            isSuccess = false;
            Toast.Error(statusMessage, "Counter");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }



    private void AddPaymentSplit(PayModeModel pm)
    {
        if (paymentSplits.Count < 3)
        {
            paymentSplits.Add(new PaymentSplit
            {
                PaymodeCode = pm.pmcode,
                PaymodeName = pm.name,
                Amount      = GetBalanceDue() > 0 ? GetBalanceDue() : 0
            });
            StateHasChanged();
        }
    }

    private void RemovePaymentSplit(PaymentSplit split)
    {
        paymentSplits.Remove(split);
        StateHasChanged();
    }
