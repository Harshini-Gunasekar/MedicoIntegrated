    private async Task SelectTest(test_master test)
    {
        if (!Model.SelectedTests.Any(t => t.TestDetails == test.name))
        {
            double commPercent = 0;
            if (Model.dcode.HasValue)
            {
                var doc = doctorList.FirstOrDefault(d => d.dcode == Model.dcode.Value);
