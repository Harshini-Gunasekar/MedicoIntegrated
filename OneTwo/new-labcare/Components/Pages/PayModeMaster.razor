@page "/paymodemaster"
@using LabCare.Components.Layout
@using LabCare.Models
@using Newtonsoft.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject LabCare.Services.TenantSessionState TenantState

<div class="referral-page">
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">account_balance_wallet</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">PayMode Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Payment Configurations</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search payment modes..." @bind="SearchQuery" @bind:event="oninput" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 8px 16px 8px 36px; font-size: 13px; color: #1e293b; outline: none; width: 220px;" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewPayMode">+ Add New</button>
            </div>
        </div>
    </div>

    

    @if (showForm)
    {
            <div class="modal-overlay">
                <div class="modal-form-card" style="max-width: 600px; width: 90%;">
                    <div class="modal-header-bar">
                        <h3>@(isEditMode ? "Edit Payment Mode" : "New Payment Mode Entry")</h3>
                        <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                            </svg>
                        </button>
                    </div>
                    
                    <div class="modal-body pb-0" style="max-height: 70vh; overflow-y: auto;">
                        
                        <div class="mb-0 form-section">
                            <div class="mt-0">
                                <div class="um-grid-row">
                                    <div class="form-group position-relative">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                            <label style="margin-bottom: 0; font-weight: 700;">Pay Mode Name <span class="text-danger">*</span></label>
                                            @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                            {
                                                <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                            }
                                        </div>
                                        <input type="text" class="lab-input font-bold" style="font-size: 15px;" @bind="current.name" placeholder="e.g. UPI / Credit Card" @(isSubmitted && string.IsNullOrEmpty(current.name) ? "is-invalid" : "") required />
                                    </div>
                                </div>
                                <div class="um-grid-cols-3">
                                    <div class="form-group">
                                        <label>Order no</label>
                                        <input type="number" class="lab-input" @bind="current.orderno" placeholder="01" />
                                    </div>
                                    <div class="form-group">
                                        <label>Short Name</label>
                                        <input type="text" class="lab-input" @bind="current.shortname" />
                                    </div>
                                    <div class="form-group">
                                        <label>Duration Time</label>
                                        <input type="number" class="lab-input" @bind="current.durationtime" placeholder="0" />
                                    </div>
                                </div>
                                
                                <div class="form-row mt-3">
                                    <div class="form-group w-100">
                                        <label>Duration</label>
                                        <input type="text" class="lab-input" @bind="current.duration" placeholder="Duration (e.g. Days, Hours)" />
                                    </div>
                                </div>

                                <div class="form-row mt-3">
                                    <div class="form-group w-100">
                                        <label>Description</label>
                                        <input type="text" class="lab-input" @bind="current.description" placeholder="Description" />
                                    </div>
                                </div>
                                
                                <div class="form-row mt-3">
                                    <div class="form-group w-100">
                                        <label>Footer Text</label>
                                        <input type="text" class="lab-input" @bind="current.footer" placeholder="Footer Text" />
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-bar mt-4 border-t" style="padding-top: 16px;">
                        <button type="button"
                                class="btn-delete"
                                @onclick="() => SoftDeletePayMode(current.pmcode)"
                                disabled="@(current.pmcode == 0 || current.pmcode == null)">
                            Delete
                        </button>
                        <button type="button" class="btn-save" @onclick="SavePayMode">
                             <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                                <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                            </svg>
                            Save PayMode
                        </button>
                    </div>
                </div>
            </div>
    }

    <!-- Index Table -->
    <div class="directory-section" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-top: -4px;">

        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">ORDER NO</th>
                        <th>MODE NAME</th>
                        <th>SHORT NAME</th>
                        <th>DURATION</th>
                        <th>DESCRIPTION</th>
                        <th class="text-center" style="width: 80px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (paymodes != null && paymodes.Any())
                    {
                        @foreach (var pm in FilteredPayModesBySearch)
                        {
                            <tr>
                                <td><span class="td-order-no">@pm.orderno</span></td>
                                <td><span class="td-name">@pm.name</span></td>
                                <td><span style="color: #64748b; font-family: monospace;">@pm.shortname</span></td>
                                <td><span style="font-weight: 500; color: #475569;">@pm.durationtime @pm.duration</span></td>
                                <td><span class="td-narration">@pm.description</span></td>
                                <td class="text-center">
                                    <button type="button" class="btn-action btn-edit" @onclick="() => EditPayMode(pm)" title="Edit">
                                        <span class="material-symbols-outlined" style="font-size:16px;">edit</span>
                                    </button>
                                    <button type="button" class="btn-action btn-delete-action" @onclick="() => SoftDeletePayMode(pm.pmcode)" title="Delete">
                                        <span class="material-symbols-outlined" style="font-size:16px;">delete</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="p-8 text-center" style="color: #94a3b8;">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<PayModeModel> paymodes = new();
    private IEnumerable<PayModeModel> FilteredPayModes =>
        displayActiveOnly ? paymodes.Where(p => p.deleted == false || p.deleted == null) : paymodes;

    private IEnumerable<PayModeModel> FilteredPayModesBySearch =>
        FilteredPayModes.Where(p =>
            string.IsNullOrWhiteSpace(SearchQuery) ||
            (p.name != null && p.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (p.shortname != null && p.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    private PayModeModel current = new();
    
    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;
    private bool isEditMode = false;
    private bool displayActiveOnly = true;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";
    private string? errorMessage;

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    TenantState.SetSession(TenantCode, AuthToken, TenantName);

                    await LoadPayModes();
                    StateHasChanged();
                }
                else
                {
                    errorMessage = "Access denied: Missing valid session. Please log in again.";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Session error: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private async Task LoadPayModes()
    {
        try
        {
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}paymode/getall");
            if (response.IsSuccessStatusCode)
            {
                paymodes = await response.Content.ReadFromJsonAsync<List<PayModeModel>>() ?? new List<PayModeModel>();
            }
            else 
            {
                errorMessage = $"Error loading data: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch(Exception ex)
        {
            errorMessage = $"Error fetching API: {ex.Message}";
        }
    }

    private void NewPayMode()
    {
        current = new PayModeModel();
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private async Task EditPayMode(PayModeModel pm)
    {
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}paymode/getbyid?pmcode={pm.pmcode}";
            current = await client.GetFromJsonAsync<PayModeModel>(url) ?? new PayModeModel();
        }
        catch (Exception)
        {
            current = JsonConvert.DeserializeObject<PayModeModel>(JsonConvert.SerializeObject(pm)) ?? new PayModeModel();
        }
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SavePayMode()
    {
        isSubmitted = true;
        if (string.IsNullOrEmpty(TenantCode))
        {
            errorMessage = "Error: Tenant code is not loaded.";
            return;
        }

        if (string.IsNullOrWhiteSpace(current.name))
        {
            errorMessage = "Error: Payment Mode Name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(current.shortname))
        {
            errorMessage = "Error: Short Name is required.";
            return;
        }

        try
        {
            errorMessage = null;
            current.tenant_code = TenantCode;
            current.usercode = current.usercode ?? 1;
            current.computercode = current.computercode ?? 1;
            
            if(!isEditMode) current.entereddate = DateTime.Now;
            current.ibsdate = DateTime.Now;

            // Check for duplicates
            if (paymodes.Any(p => p.name?.Trim().Equals(current.name?.Trim(), StringComparison.OrdinalIgnoreCase) == true && p.pmcode != current.pmcode))
            {
                errorMessage = $"Error: A payment mode with the name '{current.name}' already exists.";
                return;
            }
            if (paymodes.Any(p => p.shortname?.Trim().Equals(current.shortname?.Trim(), StringComparison.OrdinalIgnoreCase) == true && p.pmcode != current.pmcode))
            {
                errorMessage = $"Error: A payment mode with the short name '{current.shortname}' already exists.";
                return;
            }

            using var client = CreateClient();
            HttpResponseMessage response;
            if (isEditMode)
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}paymode/update", current);
            }
            else
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}paymode/insert", current);
            }

            if (response.IsSuccessStatusCode)
            {
                await LoadPayModes();
                errorMessage = isEditMode ? "Payment mode updated successfully." : "New payment mode added.";
                showForm = false;
                StateHasChanged();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                errorMessage = $"Save failed ({response.StatusCode}): {errorBody}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving: {ex.Message}";
        }
    }

    private async Task SoftDeletePayMode(int code)
    {
        if (code == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this payment mode?"))
        {
            try
            {
                using var client = CreateClient();
                var response = await client.GetAsync($"{BaseUrl}paymode/softdelete?pmcode={code}");
                if(response.IsSuccessStatusCode)
                {
                    await LoadPayModes();
                    if(current.pmcode == code) showForm = false;
                }
                else 
                {
                    errorMessage = $"Delete failed: {await response.Content.ReadAsStringAsync()}";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Delete error: {ex.Message}";
            }
        }
    }

    private void CloseForm()
    {
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }
}