@layout LoginLayout
@page "/forgot-password"
@using LabCare.Models
@using System.Net.Http.Json
@rendermode @(new InteractiveServerRenderMode(prerender:false))
@inject IHttpClientFactory _httpClientFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject LabCare.Services.NotificationService Toast

<!-- Stripe Card for Password Recovery -->
<div class="stripe-card">
    <div class="stripe-logo-card">
        <span class="stripe-logo-text">LabCare <span>Elite</span></span>
    </div>
    @if (!isResetMode)
    {
        <h2>Forgot your password?</h2>
        <p style="font-size: 14px; color: #64748b; line-height: 1.5; margin-bottom: 24px;">
            Enter your email address and we'll send you an OTP code to reset your password.
        </p>

        <EditForm Model="@forgotModel" OnValidSubmit="HandleForgot">
            <DataAnnotationsValidator />
            
            <div class="stripe-form-group">
                <div class="stripe-label-row">
                    <label for="email">Email Address</label>
                </div>
                <InputText id="email" @bind-Value="forgotModel.Email" class="stripe-input" placeholder="name@example.com" />
                <ValidationMessage For="@(() => forgotModel.Email)" style="font-size: 13px; color: #ef4444; margin-top: 4px; display: block;" />
            </div>

            <button type="submit" class="stripe-btn-primary" disabled="@isLoading" style="margin-top: 8px;">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 1rem; height: 1rem;"></span>
                    <span>Sending OTP...</span>
                }
                else
                {
                    <span>Send OTP</span>
                }
            </button>
        </EditForm>
    }
    else
    {
        <h2>Reset your password</h2>
        
        <div style="background: rgba(37, 99, 235, 0.08); border: 1px solid rgba(37, 99, 235, 0.2); padding: 12px 16px; border-radius: 6px; margin-bottom: 24px; font-size: 14px; color: #2563eb; display: flex; align-items: center; gap: 8px;">
            <i class="bi bi-info-circle-fill"></i>
            <span>Resetting password for: <strong>@resetModel.Email</strong></span>
        </div>

        <EditForm Model="@resetModel" OnValidSubmit="HandleReset">
            <DataAnnotationsValidator />
            
            <div class="stripe-form-group">
                <div class="stripe-label-row">
                    <label for="otp">OTP Code</label>
                </div>
                <InputText id="otp" @bind-Value="resetModel.Otp" class="stripe-input" placeholder="6-digit code" autocomplete="one-time-code" inputmode="numeric" />
                <ValidationMessage For="@(() => resetModel.Otp)" style="font-size: 13px; color: #ef4444; margin-top: 4px; display: block;" />
            </div>

            <div class="stripe-form-group">
                <div class="stripe-label-row">
                    <label for="new_password">New Password</label>
                </div>
                <InputText id="new_password" @bind-Value="resetModel.NewPassword" type="password" class="stripe-input" placeholder="••••••••" />
                <ValidationMessage For="@(() => resetModel.NewPassword)" style="font-size: 13px; color: #ef4444; margin-top: 4px; display: block;" />
            </div>

            <button type="submit" class="stripe-btn-primary" disabled="@isLoading" style="margin-top: 8px;">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 1rem; height: 1rem;"></span>
                    <span>Resetting...</span>
                }
                else
                {
                    <span>Reset Password</span>
                }
            </button>

            <button type="button" class="stripe-divider-link" style="width: 100%; background: none; border: none; padding: 0; cursor: pointer; margin-top: 16px;" @onclick="() => isResetMode = false">
                Cancel and go back
            </button>
        </EditForm>
    }

    <div class="stripe-card-footer">
        <div class="stripe-register-section">
            <span>Remember your password?</span>
            <a href="/" class="stripe-register-link">Sign In</a>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordModel forgotModel = new();
    private ResetPasswordModel resetModel = new();
    private bool isResetMode = false;
    private bool isLoading = false;

    private async Task HandleForgot()
    {
        isLoading = true;

        try
        {
            var client = _httpClientFactory.CreateClient("LabCareApi");
            var response = await client.PostAsJsonAsync("Tenant/forgotpassword", forgotModel);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ForgetResponseModel>();
                if (result != null)
                {
                    string? tk = result.token ?? result.data?.token;
                    string? ot = result.otp ?? result.data?.otp;

                    // --- DEBUG POINT ---
                    /* Console.WriteLine($"[FORGOT PASSWORD DEBUG] Token: {tk}, OTP: {ot}") */;

                    if (!string.IsNullOrEmpty(tk))
                    {
                        resetModel.Token = tk;
                        resetModel.Email = forgotModel.Email;
                        resetModel.Otp = ot ?? ""; // Optional pre-fill for user convenience if API provides it
                        
                        Toast.Success("OTP sent successfully! Please check your email.");
                        isResetMode = true;
                    }
                    else
                    {
                        Toast.Error("Success, but no token was provided by the security service.");
                    }
                }
            }
            else
            {
                Toast.Error("Failed to send OTP. Please check your email address.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error("A connection error occurred. Please try again later.");
            /* Console.WriteLine(ex.Message) */;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleReset()
    {
        isLoading = true;

        try
        {
            var client = _httpClientFactory.CreateClient("LabCareApi");
            var response = await client.PostAsJsonAsync("Tenant/resetpassword", resetModel);
            
            if (response.IsSuccessStatusCode)
            {
                Toast.Success("Password reset successful! Redirecting to login...");
                await Task.Delay(2000);
                NavigationManager.NavigateTo("/");
            }
            else
            {
                Toast.Error("Invalid OTP or Token. Please try again.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error("A connection error occurred. Please try again later.");
            /* Console.WriteLine(ex.Message) */;
        }
        finally
        {
            isLoading = false;
        }
    }
}