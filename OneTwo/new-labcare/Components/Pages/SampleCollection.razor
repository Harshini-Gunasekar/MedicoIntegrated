@page "/sample-collection"
@rendermode @(new InteractiveServerRenderMode(prerender:false))
@using LabCare.Models
@using LIMS_Backend.Model
@using LabCare.Services
@using System.Net.Http.Json
@using System.Text.Json
@using System.Linq
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JSRuntime
@inject TenantSessionState TenantState
@inject NotificationService Toast
@inject BillingService BillingService
@inject SampleCollectionService SampleService
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager NavigationManager
@inject GroupService GroupService

<PageTitle>Sample Collection - LIMS</PageTitle>

<style>
    .sc-container {
        padding: 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #1e293b;
        background: #f8fafc;
        min-height: calc(100vh - 64px);
        display: flex;
        flex-direction: column;
    }

    .sc-top-header {
        background: #fff;
        padding: 16px 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #e2e8f0;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }

    .sc-header-group {
        display: flex;
        align-items: center;
        gap: 32px;
    }

    .sc-header-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .sc-header-label {
        font-size: 0.65rem;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .sc-header-value {
        font-size: 0.95rem;
        font-weight: 800;
        color: #1e293b;
    }

    .sc-header-value.blue {
        color: #4f46e5;
    }

    .sc-status-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #ecfdf5;
        color: #059669;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        border: 1px solid #d1fae5;
    }

    .sc-status-dot {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
    }

    .sc-main-content {
        padding: 32px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 32px;
        padding-bottom: 100px;
    }

    .sc-cards-row {
        display: grid;
        grid-template-columns: minmax(300px, 1fr) minmax(300px, 1fr) minmax(350px, 1.2fr);
        gap: 24px;
    }

    .sc-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
        overflow: hidden;
    }

    .sc-card-header {
        padding: 16px 20px 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sc-card-title {
        font-size: 0.8rem;
        font-weight: 800;
        color: #334155;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .sc-card-icon {
        color: #6366f1;
        font-size: 1rem;
    }

    .sc-card-body {
        padding: 0 20px 20px;
    }

    .sc-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .sc-form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .sc-form-group.full {
        grid-column: span 2;
    }

    .sc-label {
        font-size: 0.65rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .sc-input, .sc-select {
        height: 38px;
        padding: 0 12px;
        border-radius: 8px;
        border: 1.5px solid #e2e8f0;
        font-size: 0.85rem;
        font-weight: 600;
        color: #1e293b;
        background: #f8fafc;
        width: 100%;
        outline: none;
        transition: all 0.2s;
    }

    .sc-input:focus, .sc-select:focus {
        border-color: #6366f1;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }

    .sc-input[readonly] {
        background: #f1f5f9;
        color: #475569;
        border-color: #e2e8f0;
        cursor: not-allowed;
    }

    .sc-input.blue-text {
        color: #4f46e5;
    }

    .sc-toggle-group {
        display: flex;
        background: #f1f5f9;
        border-radius: 8px;
        padding: 4px;
        gap: 4px;
    }

    .sc-toggle-btn {
        flex: 1;
        padding: 8px;
        border-radius: 6px;
        border: none;
        background: transparent;
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        cursor: pointer;
        transition: all 0.2s;
    }

    .sc-toggle-btn.active-blue {
        background: #e0e7ff;
        color: #4f46e5;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }

    .sc-toggle-btn.active-white {
        background: #fff;
        color: #1e293b;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }

    /* Test Status Table */
    .sc-test-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: -12px;
    }

    .sc-test-table th {
        font-size: 0.65rem;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        padding: 12px 20px;
        text-align: left;
        border-bottom: 1px solid #f1f5f9;
    }

    .sc-test-table td {
        padding: 16px 20px;
        font-size: 0.85rem;
        font-weight: 700;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9;
    }

    .sc-test-status-badge {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.02em;
    }

    .sc-test-status-badge.pending {
        background: #fef3c7;
        color: #b45309;
    }

    .sc-test-status-badge.authorized {
        background: #d1fae5;
        color: #065f46;
    }

    /* Inventory Grid Section */
    .sc-grid-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        overflow: hidden;
    }

    .sc-grid-header-bar {
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #f1f5f9;
    }

    .sc-grid-title {
        font-size: 0.9rem;
        font-weight: 800;
        color: var(--lc-secondary);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sc-count-badge {
        background: #e0e7ff;
        color: #4f46e5;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.7rem;
    }

    .sc-grid-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .sc-available-dot {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        color: #94a3b8;
    }

    .sc-btn-collect-all {
        background: #eff6ff;
        color: #3b82f6;
        border: none;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }

    .sc-btn-collect-all:hover {
        background: #dbeafe;
    }

    .sc-inventory-table {
        width: 100%;
        border-collapse: collapse;
    }

    .sc-inventory-table th {
        background: #5a5ce6;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 16px 24px;
        text-align: left;
        letter-spacing: 0.05em;
    }

    .sc-inventory-table td {
        padding: 20px 24px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .sc-inventory-table tr:hover {
        background: #f8fafc;
    }

    .sc-sample-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sc-tube {
        width: 12px;
        height: 28px;
        border-radius: 6px;
        background: #e2e8f0;
        position: relative;
    }

    .sc-tube.red { background: linear-gradient(to bottom, #ef4444 50%, #fca5a5 100%); }
    .sc-tube.purple { background: linear-gradient(to bottom, #a855f7 50%, #d8b4fe 100%); }
    .sc-tube.grey { background: linear-gradient(to bottom, #94a3b8 50%, #cbd5e1 100%); }
    .sc-tube.blue { background: linear-gradient(to bottom, #3b82f6 50%, #93c5fd 100%); }
    .sc-tube.green { background: linear-gradient(to bottom, #10b981 50%, #6ee7b7 100%); }

    .sc-sample-name {
        font-size: 0.9rem;
        font-weight: 800;
        color: #1e293b;
        margin: 0;
    }

    .sc-sample-desc {
        font-size: 0.7rem;
        color: #94a3b8;
        font-weight: 600;
        margin: 2px 0 0;
        text-transform: uppercase;
    }

    .sc-barcode-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #4f46e5;
    }

    .sc-datetime-text {
        font-size: 0.85rem;
        color: #64748b;
        font-weight: 500;
    }

    .sc-action-cell {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sc-btn {
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        border: none;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .sc-btn-accept { background: #10b981; color: white; }
    .sc-btn-accept:hover { background: #059669; }

    .sc-btn-reject { background: #ef4444; color: white; }
    .sc-btn-reject:hover { background: #dc2626; }

    .sc-btn-resample { background: #f59e0b; color: white; }
    .sc-btn-resample:hover { background: #d97706; }

    .sc-pill-accepted {
        background: #10b981;
        color: white;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .sc-pill-rejected {
        background: #ef4444;
        color: white;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .sc-pill-resampling {
        background: #f59e0b;
        color: white;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .sc-btn-outline {
        background: #fff;
        color: #64748b;
        border: 1.5px solid #e2e8f0;
    }
    .sc-btn-outline:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
    }

    /* Bottom Bar */
    .sc-bottom-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #fff;
        border-top: 1px solid #e2e8f0;
        padding: 16px 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 100;
        box-shadow: 0 -4px 6px -1px rgba(0,0,0,0.02);
    }

    .sc-bottom-stats {
        display: flex;
        gap: 40px;
    }

    .sc-stat {
        display: flex;
        flex-direction: column;
    }

    .sc-stat-label {
        font-size: 0.65rem;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .sc-stat-value {
        font-size: 1.5rem;
        font-weight: 900;
        color: #1e293b;
        line-height: 1.2;
    }

    .sc-stat-value.blue {
        color: #4f46e5;
    }

    .sc-printer-group {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sc-printer-select {
        height: 38px;
        padding: 0 16px;
        border-radius: 8px;
        border: 1.5px solid #e2e8f0;
        font-size: 0.85rem;
        font-weight: 600;
        color: #334155;
        min-width: 250px;
    }

    .sc-bottom-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .sc-link-btn {
        background: transparent;
        border: none;
        color: #4f46e5;
        font-size: 0.75rem;
        font-weight: 800;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .sc-link-btn:hover {
        text-decoration: underline;
    }

    .sc-btn-primary {
        background: #4f46e5;
        color: white;
        height: 40px;
        padding: 0 24px;
        border-radius: 8px;
        font-weight: 800;
        border: none;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .sc-btn-primary:hover {
        background: #4338ca;
    }

    .sc-btn-danger {
        background: #ef4444;
        color: white;
        height: 40px;
        padding: 0 24px;
        border-radius: 8px;
        font-weight: 800;
        border: none;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .sc-btn-danger:hover {
        background: #dc2626;
    }

    .sc-btn-dark {
        background: #334155;
        color: white;
        height: 40px;
        padding: 0 24px;
        border-radius: 8px;
        font-weight: 800;
        border: none;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .sc-btn-dark:hover {
        background: #1e293b;
    }
    
    /* Custom Checkbox */
    .sc-checkbox {
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border: 2px solid #cbd5e1;
        appearance: none;
        cursor: pointer;
        position: relative;
        transition: all 0.2s;
    }
    .sc-checkbox:checked {
        background-color: #4f46e5;
        border-color: #4f46e5;
    }
    .sc-checkbox:checked::after {
        content: '\2714';
        font-size: 12px;
        color: white;
        position: absolute;
        top: -1px;
        left: 2px;
    }

    /* Modal Overlay & Dialog Styles */
    .sc-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        animation: fadeIn 0.2s ease-out;
    }
    
    .sc-modal-card {
        background: #fff;
        border-radius: 16px;
        width: 100%;
        max-width: 480px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        overflow: hidden;
        border: 1px solid #e2e8f0;
        animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    .sc-modal-header {
        padding: 20px 24px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .sc-modal-title {
        font-size: 1rem;
        font-weight: 800;
        color: var(--lc-secondary);
        margin: 0;
    }
    
    .sc-modal-close {
        background: none;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        font-size: 1.25rem;
        padding: 4px;
        border-radius: 6px;
        transition: all 0.2s;
    }
    
    .sc-modal-close:hover {
        background: #f1f5f9;
        color: #475569;
    }
    
    .sc-modal-body {
        padding: 24px;
    }
    
    .sc-modal-footer {
        padding: 16px 24px;
        background: #f8fafc;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    @@keyframes slideUp {
        from { transform: translateY(12px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    
    .sc-input-inline {
        height: 32px;
        padding: 0 10px;
        border-radius: 6px;
        border: 1.5px solid #e2e8f0;
        font-size: 0.8rem;
        font-weight: 600;
        color: #1e293b;
        background: #f8fafc;
        outline: none;
        transition: all 0.2s;
    }
    
    .sc-input-inline:focus {
        border-color: #6366f1;
        background: #fff;
    }
    
    .sc-input-grid {
        height: 32px;
        padding: 0 8px;
        border-radius: 6px;
        border: 1.5px solid #e2e8f0;
        font-size: 0.8rem;
        font-weight: 600;
        color: #1e293b;
        background: #f8fafc;
        width: 140px;
        outline: none;
        transition: all 0.2s;
    }
    
    .sc-input-grid:focus {
        border-color: #6366f1;
        background: #fff;
    }
</style>

<div class="sc-container">
    <!-- Top Header -->
    <div class="sc-top-header">
        <div class="sc-header-group">
            <div class="sc-header-item">
                <span class="sc-header-label">Counter</span>
                <span class="sc-header-value">@(activeCounterName ?? "COLLECTION-B3")</span>
            </div>
            <div class="sc-header-item">
                <span class="sc-header-label">Collection ID / Snoprint</span>
                <span class="sc-header-value blue">@(selectedRequestSnoprint ?? "PENDING SEARCH")</span>
            </div>
            <div class="sc-header-item">
                <span class="sc-header-label">Date & Time</span>
                <span class="sc-header-value">@(selectedRequestDateTime?.ToString("dd MMM yyyy HH:mm") ?? DateTime.Now.ToString("dd MMM yyyy HH:mm"))</span>
            </div>
            <div class="sc-header-item">
                <span class="sc-header-label">From Date</span>
                <input type="date" class="sc-input-inline" @bind="fromDate" @bind:after="OnDatesChanged" />
            </div>
            <div class="sc-header-item">
                <span class="sc-header-label">To Date</span>
                <input type="date" class="sc-input-inline" @bind="toDate" @bind:after="OnDatesChanged" />
            </div>
            <div class="sc-header-item">
                <span class="sc-header-label">Barcode Scan</span>
                <input type="text" class="sc-input-inline" placeholder="Scan barcode..." @bind="scannedBarcode" @bind:event="oninput" @onkeydown="HandleBarcodeKeyDown" />
            </div>
        </div>
        <div class="sc-status-badge">
            <div class="sc-status-dot"></div>
            SYSTEM ACTIVE
        </div>
    </div>

    <!-- Main Content -->
    <div class="sc-main-content">
        <!-- Top Cards Row -->
        <div class="sc-cards-row">
            <!-- Collection Context -->
            <div class="sc-card">
                <div class="sc-card-header">
                    <i class="fas fa-clipboard-list sc-card-icon"></i>
                    <h2 class="sc-card-title">Collection Context</h2>
                </div>
                <div class="sc-card-body">
                    <div class="sc-form-grid">
                        <div class="sc-form-group full">
                            <label class="sc-label">Collected By</label>
                            <select class="sc-select" @bind="selectedCollectedBy">
                                <option value="">Select Staff</option>
                                @foreach (var staff in usersList)
                                {
                                    <option value="@staff.name">@staff.name</option>
                                }
                            </select>
                        </div>
                        <div class="sc-form-group full">
                            <label class="sc-label">Sample By</label>
                            <select class="sc-select" @bind="selectedSampleBy">
                                <option value="">Select Phlebotomist</option>
                                @foreach (var staff in usersList)
                                {
                                    <option value="@staff.name">@staff.name</option>
                                }
                            </select>
                        </div>
                        <div class="sc-form-group">
                            <label class="sc-label">Year</label>
                            <input type="text" class="sc-input" @bind="searchYear" />
                        </div>
                        <div class="sc-form-group">
                            <label class="sc-label">Sample ID (Sno)</label>
                            <input type="text" class="sc-input" @bind="searchSampleId" placeholder="e.g. 6" @onkeydown="HandleSearchKeyDown" />
                        </div>
                        <div class="sc-form-group full">
                            <label class="sc-label">Department</label>
                            <select class="sc-select" @bind="selectedGcode" @bind:after="ApplyFilter">
                                <option value="">All Departments</option>
                                @foreach (var g in groupsList)
                                {
                                    <option value="@g.gcode">@g.name</option>
                                }
                            </select>
                        </div>
                        <div class="sc-form-group full">
                            <label class="sc-label">Filter Sample Status</label>
                            <div class="sc-toggle-group" style="flex-wrap: wrap; gap: 4px;">
                                <button class="sc-toggle-btn @(statusFilter == "ALL" ? "active-blue" : "")" @onclick='() => SetStatusFilter("ALL")'>ALL</button>
                                <button class="sc-toggle-btn @(statusFilter == "COLLECTED" ? "active-blue" : "")" @onclick='() => SetStatusFilter("COLLECTED")'>COLLECTED</button>
                                <button class="sc-toggle-btn @(statusFilter == "ACCEPTED" ? "active-blue" : "")" @onclick='() => SetStatusFilter("ACCEPTED")'>ACCEPTED</button>
                                <button class="sc-toggle-btn @(statusFilter == "REJECTED" ? "active-blue" : "")" @onclick='() => SetStatusFilter("REJECTED")'>REJECTED</button>
                                <button class="sc-toggle-btn @(statusFilter == "RESAMPLING" ? "active-blue" : "")" @onclick='() => SetStatusFilter("RESAMPLING")'>RESAMPLING</button>
                                <button class="sc-toggle-btn @(statusFilter == "RECEIVED" ? "active-blue" : "")" @onclick='() => SetStatusFilter("RECEIVED")'>RECEIVED</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Patient Details -->
            <div class="sc-card">
                <div class="sc-card-header">
                    <i class="fas fa-user-circle sc-card-icon"></i>
                    <h2 class="sc-card-title">Patient Details</h2>
                </div>
                <div class="sc-card-body">
                    <div class="sc-form-grid">
                        <div class="sc-form-group full">
                            <label class="sc-label">Patient ID / Snoprint</label>
                            <input type="text" class="sc-input blue-text" value="@selectedRequestSnoprint" readonly />
                        </div>
                        <div class="sc-form-group full">
                            <label class="sc-label">Full Name</label>
                            <input type="text" class="sc-input" value="@selectedPatientName" readonly />
                        </div>
                        <div class="sc-form-group">
                            <label class="sc-label">Age</label>
                            <input type="text" class="sc-input" value="@selectedPatientAge" readonly />
                        </div>
                        <div class="sc-form-group">
                            <label class="sc-label">Gender</label>
                            <input type="text" class="sc-input" value="@selectedPatientGender" readonly />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Test Status -->
            <div class="sc-card">
                <div class="sc-card-header" style="border-bottom: 1px solid #f1f5f9; padding-bottom: 16px;">
                    <h2 class="sc-card-title" style="color: #64748b;">Test Status</h2>
                </div>
                <div style="max-height: 200px; overflow-y: auto;">
                    <table class="sc-test-table">
                        <thead>
                            <tr>
                                <th>Test Name</th>
                                <th style="text-align: right;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!testLines.Any())
                            {
                                <tr>
                                    <td colspan="2" style="text-align: center; color: #94a3b8; font-style: italic; font-size: 0.8rem;">No tests loaded.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var t in testLines)
                                {
                                    <tr>
                                        <td>@t.testname</td>
                                        <td style="text-align: right;">
                                            <span class="sc-test-status-badge @(t.resultstatus == true ? "authorized" : "pending")">
                                                @(t.resultstatus == true ? "AUTHORIZED" : "PENDING")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Inventory Grid -->
        <div class="sc-grid-card">
            <div class="sc-grid-header-bar">
                <h2 class="sc-grid-title">
                    SAMPLE INVENTORY GRID
                    <span class="sc-count-badge">@activeSamples.Count SAMPLES</span>
                </h2>
                <div class="sc-grid-actions">
                    <div class="sc-available-dot">
                        <div class="sc-status-dot"></div> AVAILABLE
                    </div>
                    <button class="sc-btn-collect-all" @onclick="CollectAll">
                        <i class="fas fa-check-double"></i> Collect All
                    </button>
                </div>
            </div>
            <div class="dch-table-wrapper" style="border-radius: 0; border: none; box-shadow: none;">
                <div class="dch-table-inner">
                    <table class="dch-table">
                        <thead class="dch-table-thead">
                            <tr>
                                <th class="dch-table-th" style="width: 50px;">S.No</th>
                                <th class="dch-table-th">Sample ID</th>
                                <th class="dch-table-th">Patient Name</th>
                                <th class="dch-table-th">Sample Type</th>
                                <th class="dch-table-th">Barcode / ID</th>
                                <th class="dch-table-th">Date & Time</th>
                                <th class="dch-table-th">Sample Collected</th>
                                <th class="dch-table-th">Sampled By</th>
                                <th class="dch-table-th-center">Received</th>
                                <th class="dch-table-th-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr>
                                    <td colspan="10" style="text-align: center; padding: 40px; font-weight: 700; color: #6366f1;">
                                        <i class="fas fa-spinner fa-spin mr-2"></i> Loading samples...
                                    </td>
                                </tr>
                            }
                            else if (!activeSamples.Any())
                            {
                                <tr>
                                    <td colspan="10" style="text-align: center; padding: 40px; color: #94a3b8; font-style: italic;">
                                        No specimen samples found.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int idx = 1;
                                @foreach (var sample in activeSamples)
                                {
                                    <tr class="dch-table-tr @(sample.IsAccept == true ? "settled-row" : "pending-row")">
                                        <td class="dch-table-td">@(idx++)</td>
                                        <td class="dch-table-td-blue">@sample.RequestSnoprint</td>
                                        <td class="dch-table-td-dark">@sample.PatientName</td>
                                        <td class="dch-table-td">
                                            <div class="sc-sample-info">
                                                <div class="sc-tube @GetTubeColorClass(sample.SampleName)"></div>
                                                <div>
                                                    <p class="sc-sample-name">@sample.SampleName</p>
                                                    <p class="sc-sample-desc">@sample.SampleShortname</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="dch-table-td">
                                            @if (sample.IsAccept == true || sample.IsReject == true || sample.IsResampling == true)
                                            {
                                                <span class="sc-barcode-text">@sample.Barcode</span>
                                            }
                                            else
                                            {
                                                <input type="text" class="sc-input-grid" @bind="sample.Barcode" placeholder="Enter or scan..." />
                                            }
                                        </td>
                                        <td class="dch-table-td">
                                            <span class="sc-datetime-text">@((sample.CollectedTime ?? sample.RequestDateTime)?.ToString("dd-MMM-yyyy HH:mm"))</span>
                                        </td>
                                        <td class="dch-table-td">
                                            <div class="display-flex align-center gap-8">
                                                <input type="checkbox" class="sc-checkbox" @bind="sample.CollectedStatus" />
                                                <span class="sc-test-status-badge @(sample.CollectedStatus == true ? "authorized" : "pending")" style="font-size: 0.65rem;">
                                                    @(sample.CollectedStatus == true ? "COLLECTED" : "PENDING")
                                                </span>
                                            </div>
                                        </td>
                                        <td class="dch-table-td">
                                            <span class="dch-table-td-dark">@(selectedSampleBy ?? "System")</span>
                                        </td>
                                        <td class="dch-table-td-center">
                                            @if (sample.ReceivedStatus == true)
                                            {
                                                <div class="display-flex flex-column align-center gap-2">
                                                    <span class="sc-test-status-badge authorized" style="font-size: 0.65rem; background: #dcfce7; color: #15803d; border-color: #bbf7d0;">
                                                        RECEIVED
                                                    </span>
                                                    <span style="font-size: 0.65rem; color: #64748b;">@sample.ReceivedTime?.ToString("dd-MMM HH:mm")</span>
                                                </div>
                                            }
                                            else if (sample.LrsprId.HasValue)
                                            {
                                                <button class="sc-btn sc-btn-accept" style="padding: 4px 10px; font-size: 0.75rem; background: #0ea5e9; border: none;" @onclick="() => ReceiveSample(sample)">
                                                    Receive
                                                 </button>
                                            }
                                            else
                                            {
                                                <span style="color: #94a3b8; font-style: italic; font-size: 0.75rem;">-</span>
                                            }
                                        </td>
                                        <td class="dch-table-td-center">
                                            <div class="sc-action-cell">
                                                @if (sample.IsAccept == true)
                                                {
                                                    <div class="sc-pill-accepted" style="padding: 4px 10px; font-size: 0.75rem;">Accepted</div>
                                                    <button class="dch-btn-tr-icon" title="Revoke Status" @onclick="() => RevokeStatus(sample)"><span class="material-symbols-outlined" style="font-size: 16px;">undo</span></button>
                                                }
                                                else if (sample.IsReject == true)
                                                {
                                                    <div class="sc-pill-rejected" style="padding: 4px 10px; font-size: 0.75rem;" title="Reason: @sample.RejectReason">Rejected</div>
                                                    <button class="dch-btn-tr-icon" title="Revoke Status" @onclick="() => RevokeStatus(sample)"><span class="material-symbols-outlined" style="font-size: 16px;">undo</span></button>
                                                }
                                                else if (sample.IsResampling == true)
                                                {
                                                    <div class="sc-pill-resampling" style="padding: 4px 10px; font-size: 0.75rem;" title="Reason: @sample.ResamplingReason">Resampling</div>
                                                    <button class="dch-btn-tr-icon" title="Revoke Status" @onclick="() => RevokeStatus(sample)"><span class="material-symbols-outlined" style="font-size: 16px;">undo</span></button>
                                                }
                                                else
                                                {
                                                    <button class="sc-btn sc-btn-accept" style="padding: 4px 10px; font-size: 0.75rem;" @onclick="() => AcceptSample(sample)">Accept</button>
                                                    <button class="sc-btn sc-btn-reject" style="padding: 4px 10px; font-size: 0.75rem;" @onclick="() => PromptReject(sample)">Reject</button>
                                                    <button class="sc-btn sc-btn-resample" style="padding: 4px 10px; font-size: 0.75rem;" @onclick="() => PromptResampling(sample)">Resample</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Action Bar -->
    <div class="sc-bottom-bar">
        <div class="sc-bottom-stats">
            <div class="sc-stat">
                <span class="sc-stat-label">Total Samples</span>
                <span class="sc-stat-value">@activeSamples.Count</span>
            </div>
            <div class="sc-stat">
                <span class="sc-stat-label">Collected</span>
                <span class="sc-stat-value blue">@activeSamples.Count(s => s.CollectedStatus == true)</span>
            </div>
            <div class="sc-printer-group" style="margin-left: 20px;">
                <span class="sc-stat-label" style="margin-right: 8px;">Barcode Printer</span>
                <select class="sc-printer-select">
                    <option>ZEBRA-ZT411-PHLEB-L4</option>
                    <option>TSC-TTP-244-PRO-L1</option>
                </select>
            </div>
        </div>
        
        <div class="sc-bottom-actions">
            <button class="sc-link-btn" style="margin-right: 8px;" @onclick='() => Alert("Barcodes printing initiated.")'>PRINT BARCODES</button>
            <button class="sc-link-btn" style="margin-right: 16px;" @onclick='() => Alert("Serum tube labels printing initiated.")'>PRINT SERUM</button>
            <button class="sc-btn-primary" @onclick="SaveBarcodes">SAVE</button>
            <button class="sc-btn-danger" @onclick="ClearForm">CLEAR</button>
            <button class="sc-btn-dark" @onclick='() => Alert("Printing collection summary report...")'>PRINT</button>
        </div>
    </div>
</div>

<!-- Reason Input Dialog Modal -->
@if (showReasonModal)
{
    <div class="sc-modal-overlay">
        <div class="sc-modal-card">
            <div class="sc-modal-header">
                <h3 class="sc-modal-title">@modalTitle</h3>
                <button type="button" class="sc-modal-close" @onclick="CloseReasonModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="sc-modal-body">
                <div class="sc-form-group">
                    <label class="sc-label">@modalLabel</label>
                    <input type="text" class="sc-input" @bind="modalReasonValue" placeholder="Enter reason details..." />
                </div>
            </div>
            <div class="sc-modal-footer">
                <button type="button" class="sc-btn sc-btn-outline" @onclick="CloseReasonModal">Cancel</button>
                <button type="button" class="sc-btn sc-btn-accept" @onclick="ConfirmReasonAction">Confirm</button>
            </div>
        </div>
    </div>
}

@code {
    private List<LoadSampleCollectionDto> allSamples = new();
    private List<LoadSampleCollectionDto> activeSamples = new();
    private List<user_master> usersList = new();
    private List<BillDetailLineDto> testLines = new();
    private List<CounterModel> countersList = new();
    private List<GroupModel> groupsList = new();
    private long? selectedGcode;

    private string searchYear = DateTime.Now.Year.ToString();
    private string searchSampleId = "";
    private string statusFilter = "ALL";
    private DateTime fromDate = DateTime.Today;
    private DateTime toDate = DateTime.Today;
    private string scannedBarcode = "";
    private bool isLoading = false;
    private bool isAllChecked = true;

    // Active Selection Details
    private Guid? selectedRequestGuid;
    private string? selectedRequestSnoprint;
    private DateTimeOffset? selectedRequestDateTime;
    private string? selectedPatientName;
    private string? selectedPatientAge;
    private string? selectedPatientGender;
    private string? activeCounterName;
    private string selectedCollectedBy = "";
    private string selectedSampleBy = "";

    // Modal Fields
    private bool showReasonModal = false;
    private string modalTitle = "";
    private string modalLabel = "";
    private string modalReasonValue = "";
    private LoadSampleCollectionDto? modalTargetSample;
    private bool isRejectionMode = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userResult = await SessionStorage.GetAsync<UserDetailsModel>("UserDetails");
            if (userResult.Success && userResult.Value != null)
            {
                var user = userResult.Value;
                TenantState.SetSession(
                    user.TenantCode ?? "",
                    user.AuthToken ?? "",
                    user.TenantName ?? "",
                    user.UserCode ?? 0,
                    user.BranchCode,
                    user.CounterCode
                );

                await LoadStaffUsers();
                await LoadCounters();
                await LoadGroups();
                await LoadInitialData();
                StateHasChanged();
            }
            else
            {
                NavigationManager.NavigateTo("/");
            }
        }
    }

    private async Task LoadStaffUsers()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareApi");
            var response = await client.GetAsync("User/getall");
            if (response.IsSuccessStatusCode)
            {
                usersList = await response.Content.ReadFromJsonAsync<List<user_master>>() ?? new();
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading staff: {ex.Message}") */;
        }
    }

    private async Task LoadCounters()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareApi");
            var response = await client.GetAsync("Counter/get");
            if (response.IsSuccessStatusCode)
            {
                countersList = await response.Content.ReadFromJsonAsync<List<CounterModel>>() ?? new();
                UpdateActiveCounterName();
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading counters: {ex.Message}") */;
        }
    }

    private async Task LoadGroups()
    {
        try
        {
            groupsList = await GroupService.GetAllAsync();
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading groups: {ex.Message}") */;
        }
    }

    private void UpdateActiveCounterName()
    {
        if (TenantState.CounterCode.HasValue && countersList.Any())
        {
            var active = countersList.FirstOrDefault(c => c.cntcode == TenantState.CounterCode.Value);
            activeCounterName = active?.name?.ToUpper();
        }
    }

    private async Task LoadInitialData()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            if (statusFilter == "RECEIVED")
            {
                var receivedList = await SampleService.LoadSampleReceivedAsync(fromDate.ToString("yyyy-MM-dd"), toDate.ToString("yyyy-MM-dd"));
                allSamples = receivedList.Select(r => new LoadSampleCollectionDto
                {
                    RequestGuid = r.RequestGuid,
                    RequestSnoprint = r.RequestSnoprint,
                    PatientName = r.PatientName,
                    Gender = r.Gender,
                    AgeYears = r.AgeYears,
                    RequestDateTime = r.RequestDateTime,
                    Scode = r.Scode,
                    SampleName = r.SampleReference,
                    SampleShortname = r.SampleShortname,
                    LrspId = r.LrspId,
                    Barcode = r.Barcode,
                    CollectedStatus = true,
                    CollectedTime = r.CollectedTime,
                    IsAccept = r.IsAccept,
                    IsReject = r.IsReject,
                    IsResampling = false,
                    RejectReason = r.RejectReason,
                    LrsprId = r.LrsprId,
                    ReceivedStatus = r.ReceivedStatus,
                    ReceivedTime = r.ReceivedTime,
                    Gcode = r.Gcode,
                    GroupName = r.GroupName
                }).ToList();
            }
            else
            {
                allSamples = await SampleService.LoadSampleCollectionAsync(fromDate.ToString("yyyy-MM-dd"), toDate.ToString("yyyy-MM-dd"));
            }
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to load sample collections: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilter()
    {
        var query = allSamples.AsEnumerable();

        if (statusFilter == "COLLECTED")
        {
            query = query.Where(s => s.CollectedStatus == true);
        }
        else if (statusFilter == "ACCEPTED")
        {
            query = query.Where(s => s.IsAccept == true);
        }
        else if (statusFilter == "REJECTED")
        {
            query = query.Where(s => s.IsReject == true);
        }
        else if (statusFilter == "RESAMPLING")
        {
            query = query.Where(s => s.IsResampling == true);
        }

        if (selectedRequestGuid.HasValue)
        {
            query = query.Where(s => s.RequestGuid == selectedRequestGuid.Value);
        }

        if (selectedGcode.HasValue)
        {
            query = query.Where(s => s.Gcode == (int)selectedGcode.Value);
        }

        activeSamples = query.ToList();
    }

    private async Task OnDatesChanged()
    {
        await LoadInitialData();
    }

    private async Task SetStatusFilter(string filter)
    {
        statusFilter = filter;
        await LoadInitialData();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await TriggerSearch();
        }
    }

    private async Task TriggerSearch()
    {
        if (string.IsNullOrEmpty(searchSampleId))
        {
            Toast.Warning("Please enter a Sample ID.");
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            // First load all data for the date range
            allSamples = await SampleService.LoadSampleCollectionAsync(fromDate.ToString("yyyy-MM-dd"), toDate.ToString("yyyy-MM-dd"));
            
            // Find matched request
            var matched = allSamples.FirstOrDefault(s => MatchRequest(s, searchYear, searchSampleId));
            if (matched == null)
            {
                // Try searching with empty date filters to cover all dates
                var widerSearch = await SampleService.LoadSampleCollectionAsync("", "");
                matched = widerSearch.FirstOrDefault(s => MatchRequest(s, searchYear, searchSampleId));
                if (matched != null)
                {
                    allSamples = widerSearch;
                }
            }

            if (matched != null && matched.RequestGuid.HasValue)
            {
                await SelectRequest(matched.RequestGuid.Value);
                Toast.Success($"Found record for Patient: {selectedPatientName}");
            }
            else
            {
                Toast.Warning($"No sample record found matching Year {searchYear} and Sample ID {searchSampleId}.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Search error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private bool MatchRequest(LoadSampleCollectionDto dto, string year, string sampleId)
    {
        if (string.IsNullOrEmpty(dto.RequestSnoprint)) return false;

        var parts = dto.RequestSnoprint.Split('/');
        if (parts.Length >= 2)
        {
            var snPart = parts[1].TrimStart('0');
            if (snPart == sampleId)
            {
                if (!string.IsNullOrEmpty(year) && parts.Length >= 3)
                {
                    var yearPart = parts[2];
                    var shortYear = year.Substring(Math.Max(0, year.Length - 2));
                    return yearPart.StartsWith(shortYear);
                }
                return true;
            }
        }
        
        return dto.RequestSnoprint.Contains(sampleId) && 
               (string.IsNullOrEmpty(year) || dto.RequestDateTime?.Year.ToString() == year);
    }

    private async Task SelectRequest(Guid requestGuid)
    {
        selectedRequestGuid = requestGuid;
        var first = allSamples.FirstOrDefault(s => s.RequestGuid == requestGuid);
        if (first != null)
        {
            selectedRequestSnoprint = first.RequestSnoprint;
            selectedRequestDateTime = first.RequestDateTime;
            selectedPatientName = first.PatientName;
            selectedPatientAge = first.AgeYears;
            selectedPatientGender = first.Gender;
        }

        // Fetch Bill detail tests
        try
        {
            var bill = await BillingService.GetByGuidAsync(requestGuid);
            if (bill != null)
            {
                testLines = bill.testitems ?? new();
            }
        }
        catch
        {
            testLines = new();
        }

        ApplyFilter();
    }

    private async Task HandleBarcodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrEmpty(scannedBarcode))
        {
            var code = scannedBarcode.Trim();
            var matchedActive = activeSamples.FirstOrDefault(s => s.Barcode == code);
            if (matchedActive != null)
            {
                Toast.Success($"Barcode matches active sample: {matchedActive.SampleName}");
                scannedBarcode = "";
                return;
            }

            var matched = allSamples.FirstOrDefault(s => s.Barcode == code);
            if (matched != null && matched.RequestGuid.HasValue)
            {
                await SelectRequest(matched.RequestGuid.Value);
                Toast.Success($"Found request barcode for Patient: {selectedPatientName}");
                scannedBarcode = "";
                return;
            }

            // Search by loading all samples with no date limits
            var widerSearch = await SampleService.LoadSampleCollectionAsync("", "");
            var widerMatched = widerSearch.FirstOrDefault(s => s.Barcode == code);
            if (widerMatched != null && widerMatched.RequestGuid.HasValue)
            {
                allSamples = widerSearch;
                await SelectRequest(widerMatched.RequestGuid.Value);
                Toast.Success($"Found request barcode for Patient: {selectedPatientName}");
                scannedBarcode = "";
                return;
            }

            Toast.Warning($"Barcode '{code}' not found in LIMS database.");
            scannedBarcode = "";
        }
    }

    private async Task AcceptSample(LoadSampleCollectionDto sample)
    {
        if (string.IsNullOrEmpty(sample.Barcode))
        {
            sample.Barcode = GenerateBarcode(sample);
        }

        var req = new SaveSampleCollectionRequest
        {
            collection = new LabSampleCollectionModel
            {
                lrspid = sample.LrspId ?? Guid.NewGuid(),
                requestguid = sample.RequestGuid,
                samplereference = sample.SampleName,
                scode = (int?)sample.Scode,
                collectedstatus = true,
                collectedtime = DateTime.Now,
                isaccept = true,
                acceptdatetime = DateTime.Now,
                isreject = false,
                is_resampling = false,
                barcode = sample.Barcode,
                tenant_code = TenantState.TenantCode
            }
        };

        var success = await SampleService.SaveSampleCollectionAsync(req);
        if (success)
        {
            Toast.Success($"Sample '{sample.SampleName}' accepted successfully.");
            await ReloadActiveRequest();
        }
        else
        {
            Toast.Error("Failed to accept sample.");
        }
    }

    private async Task ReceiveSample(LoadSampleCollectionDto sample)
    {
        if (!sample.LrsprId.HasValue) return;

        try
        {
            var request = new SaveSampleReceiveRequest
            {
                lrsprid = sample.LrsprId.Value
            };

            var success = await SampleService.SaveSampleReceiveAsync(request);
            if (success)
            {
                Toast.Success($"Sample '{sample.SampleName}' marked as RECEIVED.");
                await LoadInitialData();
            }
            else
            {
                Toast.Error("Failed to mark sample as received.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error receiving sample: {ex.Message}");
        }
    }

    private void PromptReject(LoadSampleCollectionDto sample)
    {
        modalTargetSample = sample;
        isRejectionMode = true;
        modalTitle = "Reject Specimen Sample";
        modalLabel = "Reason for Rejection";
        modalReasonValue = "";
        showReasonModal = true;
    }

    private void PromptResampling(LoadSampleCollectionDto sample)
    {
        modalTargetSample = sample;
        isRejectionMode = false;
        modalTitle = "Request Resampling";
        modalLabel = "Reason for Resampling";
        modalReasonValue = "";
        showReasonModal = true;
    }

    private void CloseReasonModal()
    {
        showReasonModal = false;
        modalTargetSample = null;
    }

    private async Task ConfirmReasonAction()
    {
        if (modalTargetSample == null) return;
        if (string.IsNullOrWhiteSpace(modalReasonValue))
        {
            Toast.Warning("Please specify a reason.");
            return;
        }

        var sample = modalTargetSample;
        showReasonModal = false;

        if (string.IsNullOrEmpty(sample.Barcode))
        {
            sample.Barcode = GenerateBarcode(sample);
        }

        var req = new SaveSampleCollectionRequest
        {
            collection = new LabSampleCollectionModel
            {
                lrspid = sample.LrspId ?? Guid.NewGuid(),
                requestguid = sample.RequestGuid,
                samplereference = sample.SampleName,
                scode = (int?)sample.Scode,
                collectedstatus = true,
                collectedtime = DateTime.Now,
                isaccept = false,
                isreject = isRejectionMode,
                rejectdatetime = isRejectionMode ? DateTime.Now : null,
                is_resampling = !isRejectionMode,
                resamplingdatetime = !isRejectionMode ? DateTime.Now : null,
                barcode = sample.Barcode,
                tenant_code = TenantState.TenantCode
            },
            rejectreason = isRejectionMode ? modalReasonValue : null,
            resamplingreason = !isRejectionMode ? modalReasonValue : null
        };

        var success = await SampleService.SaveSampleCollectionAsync(req);
        if (success)
        {
            Toast.Success(isRejectionMode ? "Sample marked as rejected." : "Sample requested for resampling.");
            await ReloadActiveRequest();
        }
        else
        {
            Toast.Error("Failed to update status.");
        }
    }

