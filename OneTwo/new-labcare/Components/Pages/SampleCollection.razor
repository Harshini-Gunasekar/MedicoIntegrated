    private async Task CollectAll()
    {
        if (!activeSamples.Any())
        {
            Toast.Warning("No samples available to collect.");
            return;
        }

        int successCount = 0;
        foreach (var sample in activeSamples)
        {
            if (sample.IsAccept != true && sample.IsReject != true && sample.IsResampling != true)
            {
                var req = new SaveSampleCollectionRequest
                {
                    collection = new LabSampleCollectionModel
                    {
                        lrspid = sample.LrspId ?? Guid.NewGuid(),
                        requestguid = sample.RequestGuid,
                        samplereference = sample.SampleName,
                        scode = (int?)sample.Scode,
                        collectedstatus = true,
                        collectedtime = DateTime.Now,
                        isaccept = true,
                        acceptdatetime = DateTime.Now,
                        isreject = false,
                        is_resampling = false,
                        barcode = string.IsNullOrEmpty(sample.Barcode) ? GenerateBarcode(sample) : sample.Barcode,
                        tenant_code = TenantState.TenantCode
                    }
                };
                var success = await SampleService.SaveSampleCollectionAsync(req);
                if (success) successCount++;
            }
        }

        if (successCount > 0)
        {
            Toast.Success($"Collected {successCount} sample(s) successfully.");
            await ReloadActiveRequest();
        }
        else
        {
            Toast.Info("All active samples are already processed.");
        }
    }

    private async Task SaveBarcodes()
    {
        if (!activeSamples.Any())
        {
            Toast.Warning("No active samples to save.");
            return;
        }

        bool anySaved = false;
        foreach (var sample in activeSamples)
        {
            var req = new SaveSampleCollectionRequest
            {
                collection = new LabSampleCollectionModel
                {
                    lrspid = sample.LrspId ?? Guid.NewGuid(),
                    requestguid = sample.RequestGuid,
                    samplereference = sample.SampleName,
                    scode = (int?)sample.Scode,
                    collectedstatus = sample.CollectedStatus,
                    collectedtime = sample.CollectedTime ?? (sample.CollectedStatus == true ? DateTime.Now : null),
                    isaccept = sample.IsAccept,
                    acceptdatetime = sample.IsAccept == true ? (sample.CollectedTime ?? DateTime.Now) : null,
                    isreject = sample.IsReject,
                    rejectdatetime = sample.IsReject == true ? DateTime.Now : null,
                    is_resampling = sample.IsResampling,
                    resamplingdatetime = sample.IsResampling == true ? DateTime.Now : null,
                    barcode = sample.Barcode,
                    tenant_code = TenantState.TenantCode
                }
            };
            var success = await SampleService.SaveSampleCollectionAsync(req);
            if (success) anySaved = true;
        }

        if (anySaved)
        {
            Toast.Success("Barcodes saved successfully.");
            await ReloadActiveRequest();
        }
    }

    private async Task ReloadActiveRequest()
    {
        allSamples = await SampleService.LoadSampleCollectionAsync(fromDate.ToString("yyyy-MM-dd"), toDate.ToString("yyyy-MM-dd"));
        ApplyFilter();
    }

