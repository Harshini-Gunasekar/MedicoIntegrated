    private string GenerateBarcode(LoadSampleCollectionDto sample)
    {
        var snPart = sample.RequestSnoprint?.Split('/').ElementAtOrDefault(1) ?? "000";
        return $"BC-{DateTime.Now.Year}-{snPart}-{sample.Scode}";
    }

    private string GetTubeColorClass(string? sampleName)
    {
        if (string.IsNullOrEmpty(sampleName)) return "grey";
        var lower = sampleName.ToLower();
        if (lower.Contains("serum") || lower.Contains("sst") || lower.Contains("clot")) return "red";
        if (lower.Contains("edta") || lower.Contains("purple") || lower.Contains("lavender") || lower.Contains("cbc") || lower.Contains("blood")) return "purple";
        if (lower.Contains("fluoride") || lower.Contains("grey") || lower.Contains("sugar") || lower.Contains("glucose")) return "grey";
        if (lower.Contains("citrate") || lower.Contains("blue") || lower.Contains("coag")) return "blue";
        if (lower.Contains("heparin") || lower.Contains("green")) return "green";
        return "grey";
    }

