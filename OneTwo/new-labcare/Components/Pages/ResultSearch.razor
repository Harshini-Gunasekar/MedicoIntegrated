                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="re-empty-state">
                                        <div class="re-empty-icon"><i class="fas fa-flask"></i></div>
                                        <p>@(isLoading ? "Searching..." : "No results found. Adjust filters and try again.")</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (selectedRowIndex >= 0 && selectedRowIndex < filteredResults.Count)
        {
            <div class="re-side-panel">
                <div class="re-card" style="border: none; border-radius: 20px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);">
                    <div class="re-card-header" style="background: white; border-bottom: none; padding: 24px 24px 16px;">
                        <h3 class="re-card-title" style="margin: 0; font-size: 1rem; font-weight: 800; color: #4f46e5; display: flex; align-items: center; gap: 8px; letter-spacing: 0.05em;">
                            <i class="fas fa-list-check"></i> ORDERED TESTS
                        </h3>
                    </div>
                    <div class="re-table-container" style="max-height: 400px; padding: 0 20px 20px;">
                        <table class="re-table re-table-sm" style="border: 1px solid #f1f5f9; border-radius: 12px; overflow: hidden; border-collapse: separate; border-spacing: 0; width: 100%;">
                            <thead>
                                <tr>
                                    <th style="width: 40px; color: white; border: none; padding: 12px; font-size: 0.7rem; letter-spacing: 0.05em;">SEL</th>
                                    <th style="color: white; border: none; padding: 12px; font-size: 0.7rem; letter-spacing: 0.05em;">TEST NAME</th>
                                    <th style="color: white; border: none; padding: 12px; text-align: right; font-size: 0.7rem; letter-spacing: 0.05em;">STATUS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (isLoadingTests)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center p-4">
                                            <span class="re-spinner re-spinner-indigo"></span>
                                        </td>
                                    </tr>
                                }
                                else if (selectedTestDetails.Any())
                                {
                                    @foreach (var test in selectedTestDetails)
                                    {
                                        <tr>
                                            <td><input type="checkbox" @bind="test.isselected" /></td>
                                            <td class="font-medium">
                                                @test.testname
                                                @if (test.is_escalation == true)
                                                {
                                                    <span style="background-color: #fee2e2; color: #dc2626; padding: 2px 6px; border-radius: 4px; font-size: 0.65rem; font-weight: bold; margin-left: 8px; display: inline-flex; align-items: center; gap: 4px; border: 1px solid #fecaca;">
                                                        <i class="fas fa-exclamation-triangle" style="font-size: 0.65rem;"></i> ESCALATION
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <span class="re-badge @(test.ispending ? "re-badge-warning" : "re-badge-success")">
