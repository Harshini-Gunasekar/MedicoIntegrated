                                        <td style="color: #475569; font-weight: 600; font-size: 0.85rem;">@item.doctor</td>
                                        <td style="text-align: center;">
                                            @{
                                                var displayStatus = GetRecordStatus(item);
                                                var isPending = displayStatus.ToLower() == "pending" || displayStatus.ToLower() == "0" || displayStatus.ToLower() == "false" || displayStatus == "";
                                            }
                                            <span style="font-size: 0.65rem; font-weight: 800; padding: 4px 10px; border-radius: 6px; border: 1.5px solid @(isPending ? "#fcd34d" : "#86efac"); color: @(isPending ? "#d97706" : "#16a34a"); text-transform: uppercase;">
                                                @(isPending ? "IN PROGRESS" : "FINISHED")
                                            </span>
                                        </td>
                                        <td style="color: #cbd5e1; font-weight: 600; font-size: 0.75rem;">@(string.IsNullOrEmpty(item.billnoprint) ? "PATH-2026-000" : item.billnoprint)</td>
