                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center p-4 text-muted italic">No tests found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                        <div style="display: flex; flex-direction: column; gap: 12px; padding: 0 20px 24px;">
                            <button class="re-btn-primary" style="background: #059669; width: 100%; font-size: 0.72rem; padding: 14px; border-radius: 10px; box-shadow: 0 4px 10px rgba(5, 150, 105, 0.2); text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; border: none; color: white; cursor: pointer;">
                                PRINT BARCODE FOR SELECTED SAMPLES
                            </button>
                            <button class="re-btn-primary" style="width: 100%; font-size: 0.72rem; padding: 14px; border-radius: 10px; text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em;" @onclick="@(() => NavigateToEntry(filteredResults[selectedRowIndex]))">
                                <i class="fas fa-edit"></i> Open Result Entry
                            </button>
                            @if (filteredResults[selectedRowIndex].isculture == true)
                            {
                                <button class="re-btn-primary" style="background: #8b5cf6; width: 100%; font-size: 0.72rem; padding: 14px; border-radius: 10px; box-shadow: 0 4px 10px rgba(139, 92, 246, 0.2); text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; border: none; color: white; cursor: pointer;" @onclick="@(() => PrintReportBase64($"report/culture-report?requestguid={filteredResults[selectedRowIndex].requestguid}"))" disabled="@isLoading">
                                    <i class="fas fa-print"></i> Print Culture Report
                                </button>
                            }
                            else
                            {
                                <button class="re-btn-primary" style="background: #4f46e5; width: 100%; font-size: 0.72rem; padding: 14px; border-radius: 10px; box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2); text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; border: none; color: white; cursor: pointer;" @onclick="@(() => PrintReportBase64($"report/labreport?requestguid={filteredResults[selectedRowIndex].requestguid}"))" disabled="@isLoading">
                                    <i class="fas fa-print"></i> Print Lab Report
                                </button>
                            }
                        </div>
                    </div>
                </div>
        }
    </div>
</div>

@code {
    // Session key for persisting filter state
    private const string FilterStateKey = "ResultSearch_FilterState";

    // Data class to hold all filter state for serialization
    private class FilterState
    {
        public DateTime fromdate { get; set; }
        public DateTime todate { get; set; }
        public string sidfrom { get; set; } = "";
        public string sidto { get; set; } = "";
        public string maindept { get; set; } = "Lab";
        public string patientsearch { get; set; } = "";
        public string mobilesearch { get; set; } = "";
        public string selecteddepartment { get; set; } = "";
        public string testname { get; set; } = "";
        public string reporttype { get; set; } = "Lab";
        public string referredbysearch { get; set; } = "";
        public string pathologyno { get; set; } = "";
        public string resultstatus { get; set; } = "Pending";
        public bool showalltestinentry { get; set; }
        public bool showtat { get; set; }
        public int branchid { get; set; }
        public bool isfilteropen { get; set; } = true;
        public bool hasresults { get; set; }
        public string globalsearch { get; set; } = "";
    }

    // Auth & Branch
    private string token = "";
    private int branchID = 0;
    private List<Branch_Master> branches = new() { new Branch_Master { bhcode = 0, name = "All Branches" } };

    // Filters
    private bool isFilterOpen = true;
    private DateTime fromDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime toDate = DateTime.Now;
    private string sidFrom = "";
    private string sidTo = "";
    private string mainDept = "Lab";
    private string patientSearch = "";
    private string mobileSearch = "";
    private string selectedDepartment = "";
    private string testNameSearch = "";
    private string reportType = "Lab";
    private string referredBySearch = "";
    private int selectedDoctorCode = 0;
    private List<Doctor_Master> doctors = new();
    private string pathologyNo = "";
    private string resultStatus = "Pending";
    private bool showAllTestInEntry = false;
    private bool showTAT = false;
    private string globalSearch = "";
    
    // Test search
    private List<Test_Master> testSearchResults = new();
    private CancellationTokenSource? testSearchDebounceTokenSource;

    // State
    private bool isLoading = false;
    private int selectedRowIndex = -1;
    private List<ViewResultSearch> allResults = new();
    private List<ViewResultSearch> filteredResults = new();
    private List<TestDetailItem> selectedTestDetails = new();

    // Local model for test details
    public class TestDetailItem
    {
        public string testname { get; set; } = "";
        public bool ispending { get; set; }
        public bool isselected { get; set; }
        public bool? is_escalation { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Headers are set in individual requests or via http client factory
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
            if (userResult.Success && userResult.Value != null)
            {
                var user = userResult.Value;
                token = user.AuthToken ?? "";
                branchID = user.BranchCode ?? 0;
                
                await LoadBranchesAsync();
                await LoadDoctorsAsync();

                // Restore filter state if user navigated back from result entry
                await RestoreFilterStateAsync();

                StateHasChanged();
            }
        }
    }

    private async Task RestoreFilterStateAsync()
    {
        try
        {
            var saved = await _sessionStorage.GetAsync<FilterState>(FilterStateKey);
            if (saved.Success && saved.Value != null)
            {
                var s = saved.Value;
                fromDate = s.fromdate;
                toDate = s.todate;
                sidFrom = s.sidfrom;
                sidTo = s.sidto;
                mainDept = s.maindept;
                patientSearch = s.patientsearch;
                mobileSearch = s.mobilesearch;
                selectedDepartment = s.selecteddepartment;
                testNameSearch = s.testname;
                reportType = s.reporttype;
                referredBySearch = s.referredbysearch;
                pathologyNo = s.pathologyno;
                resultStatus = s.resultstatus;
                showAllTestInEntry = s.showalltestinentry;
                showTAT = s.showtat;
                globalSearch = s.globalsearch;
                isFilterOpen = s.isfilteropen;

                if (branches.Any(b => b.bhcode == s.branchid))
                    branchID = s.branchid;

                if (s.hasresults)
                    await SearchResults();

                await _sessionStorage.DeleteAsync(FilterStateKey);
            }
            else
            {
                // Default view: Search for today's results automatically if no filters are stored
                fromDate = DateTime.Now.Date;
                toDate = DateTime.Now.Date;
                await SearchResults();
            }
        }
        catch (Exception ex) 
        {
            /* Console.WriteLine($"Error restoring filter state: {ex.Message}") */;
        }
    }

    private async Task SaveFilterStateAsync()
    {
        try
        {
            var state = new FilterState
            {
                fromdate = fromDate,
                todate = toDate,
                sidfrom = sidFrom,
                sidto = sidTo,
                maindept = mainDept,
                patientsearch = patientSearch,
                mobilesearch = mobileSearch,
                selecteddepartment = selectedDepartment,
                testname = testNameSearch,
                reporttype = reportType,
                referredbysearch = referredBySearch,
                pathologyno = pathologyNo,
                resultstatus = resultStatus,
                showalltestinentry = showAllTestInEntry,
                showtat = showTAT,
                branchid = branchID,
                isfilteropen = isFilterOpen,
                hasresults = filteredResults.Any(),
                globalsearch = globalSearch
            };
            await _sessionStorage.SetAsync(FilterStateKey, state);
        }
        catch { }
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"{AppSettings.BaseUrl}Branch/get");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            // Add tenant_code header
            try {
                var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null && !string.IsNullOrEmpty(userResult.Value.TenantCode))
                    request.Headers.Add("tenant_code", userResult.Value.TenantCode);
            } catch {}

            var res = await http.SendAsync(request);
            if (res.IsSuccessStatusCode)
            {
                var list = await res.Content.ReadFromJsonAsync<List<Branch_Master>>() ?? new();
                if (list.Any())
                {
                    branches = list;
                    if (!branches.Any(b => b.bhcode == 0))
                        branches.Insert(0, new Branch_Master { bhcode = 0, name = "All Branches" });
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading branches: {ex.Message}") */;
        }
    }

    private async Task LoadAuthorizedUsersAsync()
    {
        // This was in the original but not used much in current UI
    }

    private async Task LoadDoctorsAsync()
    {
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"{AppSettings.BaseUrl}Doctor/get");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            // Add tenant_code header
            try {
                var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null && !string.IsNullOrEmpty(userResult.Value.TenantCode))
                    request.Headers.Add("tenant_code", userResult.Value.TenantCode);
            } catch {}

            var res = await http.SendAsync(request);
            if (res.IsSuccessStatusCode)
            {
                doctors = await res.Content.ReadFromJsonAsync<List<Doctor_Master>>() ?? new();
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading doctors: {ex.Message}") */;
        }
    }

    private async Task SearchResults()
    {
        try
        {
            isLoading = true;
            selectedRowIndex = -1;
            selectedTestDetails.Clear();
            StateHasChanged();

            string sd = fromDate.ToString("yyyy-MM-dd");
            string ed = toDate.ToString("yyyy-MM-dd");

            string apiUrl = $"{AppSettings.BaseUrl}labresult/viewresultsearch?fromdate={Uri.EscapeDataString(sd)}&todate={Uri.EscapeDataString(ed)}&t={DateTime.Now.Ticks}";
            /* Console.WriteLine($"[DEBUG] Fetching: {apiUrl}") */;

            if (branchID != 0)
            {
                apiUrl += $"&DCode={branchID}";
            }

            if (selectedDoctorCode != 0)
            {
                apiUrl += $"&refcode={selectedDoctorCode}";
            }

            if (!string.IsNullOrWhiteSpace(testNameSearch))
            {
                apiUrl += $"&testname={Uri.EscapeDataString(testNameSearch.TrimEnd('.'))}";
            }

            var request = new HttpRequestMessage(HttpMethod.Get, apiUrl);

            // Pass authentication and tenant headers explicitly
            try {
                var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null)
                {
                    var user = userResult.Value;
                    if (!string.IsNullOrEmpty(user.TenantCode))
                    {
                        if (request.Headers.Contains("tenant_code")) request.Headers.Remove("tenant_code");
                        request.Headers.Add("tenant_code", user.TenantCode);
                    }
                    
                    if (!string.IsNullOrEmpty(user.AuthToken))
                    {
                        if (request.Headers.Contains("Authorization")) request.Headers.Remove("Authorization");
                        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", user.AuthToken);
                    }

                    // Force bhcode header to match selected branchID to override global session handler
                    if (branchID > 0)
                    {
                        if (request.Headers.Contains("bhcode")) request.Headers.Remove("bhcode");
                        request.Headers.Add("bhcode", branchID.ToString());
                    }
                }
            } catch {}

            var res = await http.SendAsync(request);
            if (res.IsSuccessStatusCode)
            {
                var content = await res.Content.ReadAsStringAsync();
                var bills = JsonConvert.DeserializeObject<List<ViewResultSearch>>(content);

                if (bills != null)
                {
                    allResults = bills.ToList();
                    /* Console.WriteLine($"[DEBUG] API returned {allResults.Count} results.") */;
                    foreach (var item in allResults.Take(5))
                    {
                        /* Console.WriteLine($"[DEBUG] Row: SNo={item.requestsno}, IsLab={item.islab}, IsCulture={item.isculture}, IsScan={item.isscan}, Status={item.resultstatus}") */;
                    }
                    ApplyFilters();
                }
                else
                {
                    /* Console.WriteLine("[DEBUG] API returned null results.") */;
                    allResults = new();
                    filteredResults = new();
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error searching results: {ex.Message}") */;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        var filtered = allResults.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(globalSearch))
        {
            var searchLower = globalSearch.ToLower();
            filtered = filtered.Where(x => 
                (x.name ?? "").ToLower().Contains(searchLower) ||
                (x.custcode ?? "").ToLower().Contains(searchLower) ||
                (x.requestsno.ToString()).Contains(searchLower) ||
                (x.billnoprint ?? "").ToLower().Contains(searchLower) ||
                (x.mobile ?? "").Contains(searchLower) ||
                (x.testshortname ?? "").ToLower().Contains(searchLower) ||
                (x.testname ?? "").ToLower().Contains(searchLower)
            );
        }

        if (mainDept == "Lab")
            filtered = filtered.Where(x => x.isscan != true); // Show everything except explicit Scans in Lab dept
        else if (mainDept == "Scan")
            filtered = filtered.Where(x => x.isscan == true);

        if (reportType == "Lab")
            filtered = filtered.Where(x => x.isculture != true && x.isscan != true); // More permissive Lab view
        else if (reportType == "Culture")
            filtered = filtered.Where(x => x.isculture == true);
        else if (reportType == "Scan")
            filtered = filtered.Where(x => x.isscan == true);

        if (!string.IsNullOrEmpty(sidFrom) && int.TryParse(sidFrom, out int sFrom))
            filtered = filtered.Where(x => x.requestsno >= sFrom);
        if (!string.IsNullOrEmpty(sidTo) && int.TryParse(sidTo, out int sTo))
            filtered = filtered.Where(x => x.requestsno <= sTo);

        if (!string.IsNullOrWhiteSpace(patientSearch))
            filtered = filtered.Where(x => (x.name ?? "").ToLower().Contains(patientSearch.ToLower()));

        if (!string.IsNullOrWhiteSpace(mobileSearch))
            filtered = filtered.Where(x => (x.mobile ?? "").Contains(mobileSearch));

        if (!string.IsNullOrWhiteSpace(pathologyNo))
            filtered = filtered.Where(x => (x.billnoprint ?? "").Contains(pathologyNo));

        if (!string.IsNullOrWhiteSpace(testNameSearch))
        {
            var tSearch = testNameSearch.ToLower().TrimEnd('.');
            filtered = filtered.Where(x => 
                (x.testshortname ?? "").ToLower().Contains(tSearch) || 
                (x.testname ?? "").ToLower().Contains(tSearch)
            );
        }

        if (resultStatus == "Finished")
            filtered = filtered.Where(x => IsRecordFinished(x));
        else // Default to Pending for everything else
            filtered = filtered.Where(x => !IsRecordFinished(x));

        filteredResults = filtered
            .OrderByDescending(x => x.requestdatetime)
            .ThenByDescending(x => x.requestsno)
            .ToList();
    }

    private bool IsRecordPending(ViewResultSearch item)
    {
        return item.resultstatus != true;
    }

    private bool IsRecordFinished(ViewResultSearch item)
    {
        return item.resultstatus == true;
    }

    private string GetRecordStatus(ViewResultSearch item)
    {
        bool pending = IsRecordPending(item);
        if (pending) return "Pending";
        return "Finished";
    }

    private bool isLoadingTests = false;

    private void SelectRow(int index, ViewResultSearch item)
    {
        selectedRowIndex = index;
        selectedTestDetails.Clear();
        isLoadingTests = true;
        StateHasChanged();

        try
        {
            /* Console.WriteLine($"[SelectRow] Getting tests for SNo={item.requestsno}, GUID={item.requestguid}, CustCode={item.custcode} from local viewresultsearch list") */;

            // Filter local allResults list to find all rows matching this request
            var testsForRequest = allResults
                .Where(x => (x.requestguid != Guid.Empty && x.requestguid == item.requestguid) || 
                            (x.requestsno == item.requestsno && x.custcode == item.custcode))
                .Where(x => !string.IsNullOrEmpty(x.testname))
                .ToList();

            /* Console.WriteLine($"[SelectRow] Found {testsForRequest.Count} matching test rows locally") */;

            // Group by testname to display distinct tests
            var groupedTests = testsForRequest.GroupBy(x => x.testname);

            foreach (var g in groupedTests)
            {
                selectedTestDetails.Add(new TestDetailItem
                {
                    testname = g.Key ?? "Unknown Test",
                    ispending = g.Any(x => x.resultstatus != true),
                    isselected = true,
                    is_escalation = false
                });
            }
            /* Console.WriteLine($"[SelectRow] Grouped into {selectedTestDetails.Count} test items") */;
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading test details locally: {ex.Message}") */;
        }
        finally
        {
            isLoadingTests = false;
            StateHasChanged();
        }
    }

    private void ClearFilters()
    {
        fromDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        toDate = DateTime.Now;
        sidFrom = "";
        sidTo = "";
        mainDept = "Lab";
        patientSearch = "";
        mobileSearch = "";
        selectedDepartment = "";
        testNameSearch = "";
        reportType = "Lab";
        referredBySearch = "";
        pathologyNo = "";
        resultStatus = "Pending";
        showAllTestInEntry = false;
        showTAT = false;
        globalSearch = "";
        testSearchResults.Clear();
        selectedRowIndex = -1;
        filteredResults.Clear();
        selectedTestDetails.Clear();
        allResults.Clear();
        StateHasChanged();
    }

    private void OnTestSearchInputChanged(ChangeEventArgs e)
    {
        testNameSearch = e.Value?.ToString() ?? "";
        testSearchResults.Clear();
        
        ApplyFilters();

        testSearchDebounceTokenSource?.Cancel();
        testSearchDebounceTokenSource = new CancellationTokenSource();

        if (string.IsNullOrWhiteSpace(testNameSearch))
        {
            StateHasChanged();
            return;
        }

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(300, testSearchDebounceTokenSource.Token);
                await SearchTests();
            }
            catch (TaskCanceledException) { }
        });
    }

    private async Task SearchTests()
    {
        if (string.IsNullOrWhiteSpace(testNameSearch))
        {
            testSearchResults.Clear();
            StateHasChanged();
            return;
        }

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, 
                $"{AppSettings.BaseUrl}Test/get?testname={Uri.EscapeDataString(testNameSearch)}");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var res = await http.SendAsync(request);
            if (res.IsSuccessStatusCode)
            {
                var content = await res.Content.ReadAsStringAsync();
                testSearchResults = JsonConvert.DeserializeObject<List<Test_Master>>(content) ?? new();
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error searching tests: {ex.Message}") */;
            testSearchResults.Clear();
        }
        StateHasChanged();
    }

    private void SelectTest(Test_Master test)
    {
        testNameSearch = test.name;
        testSearchResults.Clear();
        ApplyFilters();
        StateHasChanged();
    }

    private void ToggleFilter() => isFilterOpen = !isFilterOpen;

    private async Task NavigateToEntry(ViewResultSearch item)
    {
        await SaveFilterStateAsync();

        if (reportType == "Culture")
        {
            NavigationManager.NavigateTo($"/culture-result-entry?requestGuid={item.requestguid}&custcode={item.custcode}");
        }
        else
        {
            NavigationManager.NavigateTo($"/result-entry?requestGuid={item.requestguid}&custcode={item.custcode}");
        }
    }

    private async Task PrintReportBase64(string endpointWithParams)
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            var request = new HttpRequestMessage(HttpMethod.Get, $"{AppSettings.BaseUrl}{endpointWithParams}");
            
            // Pass authentication and tenant headers explicitly
            var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
            if (userResult.Success && userResult.Value != null)
            {
                var user = userResult.Value;
                if (!string.IsNullOrEmpty(user.TenantCode))
                    request.Headers.Add("tenant_code", user.TenantCode);
                if (!string.IsNullOrEmpty(user.AuthToken))
                    request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", user.AuthToken);
            }

            var resp = await http.SendAsync(request);
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                Toast.Error($"Print failed: {err}", "Print");
                return;
            }

            var raw = await resp.Content.ReadAsStringAsync();
            var base64 = raw.Trim().Trim('"');
            await JSRuntime.InvokeVoidAsync("openBase64Pdf", base64);
        }
        catch (Exception ex)
        {
            Toast.Error($"Print error: {ex.Message}", "Print");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
