@page "/documentmaster"
@using LabCare.Components.Layout
@using LabCare.Models
@using Newtonsoft.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject LabCare.Services.TenantSessionState TenantState

<div class="referral-page">
    <div class="lab-header-card flex-between">
        <div class="header-left-content">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">description</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Document Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Identity & Records Directory</span>
                </div>
            </div>
        </div>
        <div class="header-controls">
            <div class="search-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search documents..." @bind="SearchQuery" @bind:event="oninput" class="search-input-field" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewDocument">+ Add New</button>
            </div>
        </div>
    </div>

    

    @if (showForm)
    {
        <div class="modal-overlay">
            <div class="modal-form-card">
                <div class="modal-header-bar">
                    <h3>@(isEditMode ? "Edit Document" : "New Document Entry")</h3>
                    <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                        </svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-section mb-0">
                        <div class="lc-section-divider mt-24 mb-16">
                            <span class="lc-divider-label">DOCUMENT DETAILS</span>
                            <div class="lc-divider-line"></div>
                        </div>
                        <div class="mt-0">
                            <div class="um-grid-row">
                                <div class="form-group">
                                    <label>Document Name</label>
                                    <input type="text" class="lab-input" @bind="current.dmname" placeholder="e.g. Aadhaar Card, Passport" required />
                                </div>
                            </div>
                            <div class="um-grid-cols-2">
                                <div class="form-group">
                                    <label>Short Name</label>
                                    <input type="text" class="lab-input" @bind="current.dmshortname" placeholder="e.g. UID, PPT" />
                                </div>
                                <div class="form-group">
                                    <label>Status</label>
                                    <div class="lc-select-wrapper">
                                        <select class="lab-input" @bind="current.isactive">
                                            <option value="true">Active</option>
                                            <option value="false">Inactive</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer-bar">
                    <button type="button" class="btn-delete" @onclick="() => SoftDeleteDocument(current.dmid)" disabled="@(current.dmid == 0)">
                        Delete
                    </button>
                    <button type="button" class="btn-save" @onclick="SaveDocument">
                         <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="btn-icon-mr">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                        </svg>
                        Save Document
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="directory-section directory-section-connected">
        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>DOCUMENT NAME</th>
                        <th>SHORT NAME</th>
                        <th class="text-center">STATUS</th>
                        <th>DATE ADDED</th>
                        <th class="text-center th-actions">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (documents != null && documents.Any())
                    {
                        @foreach (var doc in FilteredDocuments)
                        {
                            <tr>
                                <td class="td-order-no">@doc.dmid</td>
                                <td><span class="td-name">@doc.dmname</span></td>
                                <td class="td-shortname">@doc.dmshortname</td>
                                <td class="text-center">
                                    <span class="badge @(doc.isactive == true ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") border">
                                        @(doc.isactive == true ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>@doc.entereddate?.ToString("MMM dd, yyyy")</td>
                                <td class="text-center">
                                    <button type="button" class="btn-action btn-edit" @onclick="() => EditDocument(doc)" title="Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg>
                                    </button>
                                    <button type="button" class="btn-action btn-delete-action" @onclick="() => SoftDeleteDocument(doc.dmid)" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="td-narration p-24 text-center">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<document_master> documents = new();
    private document_master current = new();
    private bool showForm = false;
    private bool isEditMode = false;
    private string SearchQuery = "";
    private string? errorMessage;
    
    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;
    private string TenantCode = "";
    private string AuthToken = "";

    protected override void OnInitialized() => _appSettings = AppSettingsOptions.Value;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

            var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
            AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

            if (!string.IsNullOrEmpty(AuthToken))
            {
                await LoadDocuments();
                StateHasChanged();
            }
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode)) client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        if (!string.IsNullOrEmpty(AuthToken)) client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        return client;
    }

    private async Task LoadDocuments()
    {
        try
        {
            using var client = CreateClient();
            documents = await client.GetFromJsonAsync<List<document_master>>($"{BaseUrl}document/get") ?? new();
        }
        catch (Exception ex) { errorMessage = $"Load Error: {ex.Message}"; }
    }

    private IEnumerable<document_master> FilteredDocuments =>
        documents.Where(d => d.deleted != true && (string.IsNullOrWhiteSpace(SearchQuery) || 
            (d.dmname != null && d.dmname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (d.dmshortname != null && d.dmshortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))));

    private void NewDocument()
    {
        current = new document_master();
        isEditMode = false;
        showForm = true;
    }

    private void EditDocument(document_master doc)
    {
        current = JsonConvert.DeserializeObject<document_master>(JsonConvert.SerializeObject(doc)) ?? new();
        isEditMode = true;
        showForm = true;
    }

    private async Task SaveDocument()
    {
        if (string.IsNullOrWhiteSpace(current.dmname))
        {
            errorMessage = "Document name is required.";
            return;
        }

        try
        {
            current.tenant_code = TenantCode;
            using var client = CreateClient();
            var response = isEditMode 
                ? await client.PostAsJsonAsync($"{BaseUrl}document/update", current)
                : await client.PostAsJsonAsync($"{BaseUrl}document/insert", current);

            if (response.IsSuccessStatusCode)
            {
                await LoadDocuments();
                showForm = false;
            }
            else errorMessage = $"Save failed: {await response.Content.ReadAsStringAsync()}";
        }
        catch (Exception ex) { errorMessage = $"Save Error: {ex.Message}"; }
    }

    private async Task SoftDeleteDocument(int dmid)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Delete this document?"))
        {
            try
            {
                using var client = CreateClient();
                var response = await client.GetAsync($"{BaseUrl}document/softdelete?dmid={dmid}");
                if (response.IsSuccessStatusCode)
                {
                    await LoadDocuments();
                    showForm = false;
                }
            }
            catch (Exception ex) { errorMessage = $"Delete Error: {ex.Message}"; }
        }
    }

    private void CloseForm() => showForm = false;
}
