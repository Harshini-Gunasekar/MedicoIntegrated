@page "/user-rights"
@rendermode @(new InteractiveServerRenderMode(prerender:false))
@using LabCare.Models
@using LIMS_Backend.Model
@using LabCare.Services
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IHttpClientFactory ClientFactory
@inject TenantSessionState TenantState
@inject NotificationService Toast
@inject UserRightsService UserRightsService
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager NavigationManager

<PageTitle>User Rights Management - LIMS</PageTitle>

<div class="referral-page">
    <!-- ── Header Card ── -->
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">admin_panel_settings</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">User Rights Management</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Role-Based Access Control</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Two Column Layout ── -->
    <div class="ur-layout-container">
        <!-- Left Sidebar: Users List -->
        <div class="ur-sidebar">
            <div class="ur-sidebar-header">
                <span class="material-symbols-outlined ur-search-icon">search</span>
                <input type="text" placeholder="Search staff members..." 
                       @bind="userSearchQuery" @bind:event="oninput"
                       class="ur-search-input" />
            </div>
            <div class="ur-users-list scrollable-y no-scrollbar">
                @if (isLoadingUsers)
                {
                    <div class="ur-loading-state">
                        <span class="material-symbols-outlined animate-spin">autorenew</span>
                        <p>Loading users...</p>
                    </div>
                }
                else if (!FilteredUsers.Any())
                {
                    <div class="ur-empty-users">No users found.</div>
                }
                else
                {
                    @foreach (var u in FilteredUsers)
                    {
                        <div class="ur-user-item @(selectedUser?.user_code == u.user_code ? "active" : "")" @onclick="() => SelectUser(u)">
                            <div class="ur-user-avatar">
                                @(u.name?.Length > 0 ? u.name[0].ToString().ToUpper() : "?")
                            </div>
                            <div class="ur-user-info">
                                <p class="ur-user-name">@u.name</p>
                                <p class="ur-user-desc">@u.short_name</p>
                            </div>
                            <span class="material-symbols-outlined ur-chevron">chevron_right</span>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Right Side: Permissions Grid -->
        <div class="ur-content-panel">
            @if (selectedUser == null)
            {
                <div class="ur-placeholder-state">
                    <span class="material-symbols-outlined ur-placeholder-icon">security</span>
                    <h3>Select a Staff Member</h3>
                    <p>Select a user from the left pane to configure module-level read, write, edit, and delete permissions.</p>
                </div>
            }
            else
            {
                <div class="ur-active-header">
                    <div class="ur-active-user-badge">
                        <div class="ur-active-avatar">
                            @(selectedUser.name?[0].ToString().ToUpper() ?? "?")
                        </div>
                        <div>
                            <h4>@selectedUser.name</h4>
                            <p>@selectedUser.email | @selectedUser.mobile</p>
                        </div>
                    </div>
                    <div class="ur-quick-filters">
                        <span class="ur-quick-label">Filter Modules:</span>
                        <input type="text" placeholder="Search modules..." @bind="moduleFilterQuery" @bind:event="oninput" class="ur-module-search-input" />
                    </div>
                </div>

                <div class="directory-section lc-rounded-t-0" style="flex: 1; min-height: 0; display: flex; flex-direction: column;">
                    <div class="table-wrapper" style="flex: 1; overflow-y: auto;">
                        <table class="directory-table">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">S.No</th>
                                    <th>Module Name</th>
                                    <th>Department</th>
                                    <th class="text-center" style="width: 100px;">
                                        <div class="th-check-group">
                                            <input type="checkbox" checked="@isAllAdd" @onchange="ToggleAllAdd" />
                                            <span>ADD</span>
                                        </div>
                                    </th>
                                    <th class="text-center" style="width: 100px;">
                                        <div class="th-check-group">
                                            <input type="checkbox" checked="@isAllView" @onchange="ToggleAllView" />
                                            <span>VIEW</span>
                                        </div>
                                    </th>
                                    <th class="text-center" style="width: 100px;">
                                        <div class="th-check-group">
                                            <input type="checkbox" checked="@isAllEdit" @onchange="ToggleAllEdit" />
                                            <span>EDIT</span>
                                        </div>
                                    </th>
                                    <th class="text-center" style="width: 100px;">
                                        <div class="th-check-group">
                                            <input type="checkbox" checked="@isAllDelete" @onchange="ToggleAllDelete" />
                                            <span>DELETE</span>
                                        </div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (isLoadingRights)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center p-24" style="color: #64748b;">
                                            <span class="material-symbols-outlined animate-spin lc-vertical-middle">autorenew</span>
                                            Loading permissions...
                                        </td>
                                    </tr>
                                }
                                else if (!FilteredRights.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center p-24 italic" style="color: #94a3b8;">
                                            No modules found.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int rIndex = 1;
                                    @foreach (var right in FilteredRights)
                                    {
                                        <tr>
                                            <td>@(rIndex++)</td>
                                            <td style="font-weight: 600; color: #1e293b;">@right.ModuleName</td>
                                            <td style="color: #64748b; font-size: 0.8rem;">@right.Department</td>
                                            <td class="text-center">
                                                <input type="checkbox" class="ur-grid-checkbox" @bind="right.ToAdd" @bind:after="UpdateHeaderStates" />
                                            </td>
                                            <td class="text-center">
                                                <input type="checkbox" class="ur-grid-checkbox" @bind="right.ToView" @bind:after="UpdateHeaderStates" />
                                            </td>
                                            <td class="text-center">
                                                <input type="checkbox" class="ur-grid-checkbox" @bind="right.ToEdit" @bind:after="UpdateHeaderStates" />
                                            </td>
                                            <td class="text-center">
                                                <input type="checkbox" class="ur-grid-checkbox" @bind="right.ToDelete" @bind:after="UpdateHeaderStates" />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Footer Action Bar -->
                <div class="ur-footer-actions">
                    <button class="ur-btn-delete" @onclick="DeleteAllRights" disabled="@isSaving">
                        <span class="material-symbols-outlined">delete_forever</span> Clear All Rights
                    </button>
                    <div class="display-flex gap-12">
                        <button class="ur-btn-secondary" @onclick="ResetRights" disabled="@isSaving">
                            <span class="material-symbols-outlined">restart_alt</span> Reset
                        </button>
                        <button class="ur-btn-primary" @onclick="SaveRights" disabled="@isSaving">
                            <span class="material-symbols-outlined">save</span> Save Permissions
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

