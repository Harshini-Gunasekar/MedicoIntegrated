@code {
    private List<user_master> usersList = new();
    private List<UserFormRightsModel.usermodules> masterModules = new();
    private List<UserFormRightsModel.User_Rights> activeRights = new();

    private user_master? selectedUser;
    private string userSearchQuery = "";
    private string moduleFilterQuery = "";

    private bool isLoadingUsers = false;
    private bool isLoadingRights = false;
    private bool isSaving = false;

    // Header Toggle States
    private bool isAllAdd;
    private bool isAllView;
    private bool isAllEdit;
    private bool isAllDelete;

    private IEnumerable<user_master> FilteredUsers =>
        string.IsNullOrEmpty(userSearchQuery)
            ? usersList
            : usersList.Where(u => (u.name ?? "").Contains(userSearchQuery, StringComparison.OrdinalIgnoreCase) || 
                                  (u.short_name ?? "").Contains(userSearchQuery, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<UserFormRightsModel.User_Rights> FilteredRights =>
        string.IsNullOrEmpty(moduleFilterQuery)
            ? activeRights
            : activeRights.Where(r => (r.ModuleName ?? "").Contains(moduleFilterQuery, StringComparison.OrdinalIgnoreCase) ||
                                      (r.Department ?? "").Contains(moduleFilterQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userResult = await SessionStorage.GetAsync<UserDetailsModel>("UserDetails");
            if (userResult.Success && userResult.Value != null)
            {
                var user = userResult.Value;
                TenantState.SetSession(
                    user.TenantCode ?? "",
                    user.AuthToken ?? "",
                    user.TenantName ?? "",
                    user.UserCode ?? 0,
                    user.BranchCode,
                    user.CounterCode
                );

                await LoadUsers();
                await LoadModules();
                StateHasChanged();
            }
            else
            {
                NavigationManager.NavigateTo("/");
            }
        }
    }

    private async Task LoadUsers()
    {
        isLoadingUsers = true;
        try
        {
            var client = ClientFactory.CreateClient("LabCareApi");
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                if (client.DefaultRequestHeaders.Contains("tenant_code"))
                    client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }

            var response = await client.GetAsync("User/getall");
            if (response.IsSuccessStatusCode)
            {
                var wrapped = await response.Content.ReadFromJsonAsync<List<UserResponseWrapper>>() ?? new();
                usersList = wrapped.Select(w => w.User).Where(u => u != null && u.deleted != true).ToList();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Toast.Error($"Error loading staff users ({response.StatusCode}): {body}");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error loading staff users: {ex.Message}");
        }
        finally
        {
            isLoadingUsers = false;
            StateHasChanged();
        }
    }

    private async Task LoadModules()
    {
        try
        {
            masterModules = await UserRightsService.GetModulesAsync();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error loading modules: {ex.Message}");
        }
    }

    private async Task SelectUser(user_master user)
    {
        selectedUser = user;
        moduleFilterQuery = "";
        await LoadUserRights();
    }

    private async Task LoadUserRights()
    {
        if (selectedUser == null) return;
        isLoadingRights = true;
        StateHasChanged();

        try
        {
            var rawRights = await UserRightsService.GetModuleRightsAsync(selectedUser.user_code);
            
            // Merge master modules list with retrieved rights
            var merged = new List<UserFormRightsModel.User_Rights>();
            foreach (var mod in masterModules)
            {
                var existing = rawRights.FirstOrDefault(r => r.usermoduleid == mod.usermoduleid);
                if (existing != null)
                {
                    merged.Add(new UserFormRightsModel.User_Rights
                    {
                        UserModuleID = mod.usermoduleid,
                        Sno = mod.sno,
                        ModuleName = mod.modulename,
                        Department = mod.department,
                        UserModuleRightsID = existing.usermodulesrightsid,
                        UserCode = selectedUser.user_code,
                        ToAdd = existing.toadd,
                        ToView = existing.toview,
                        ToEdit = existing.toedit,
                        ToDelete = existing.todelete
                    });
                }
                else
                {
                    merged.Add(new UserFormRightsModel.User_Rights
                    {
                        UserModuleID = mod.usermoduleid,
                        Sno = mod.sno,
                        ModuleName = mod.modulename,
                        Department = mod.department,
                        UserModuleRightsID = 0,
                        UserCode = selectedUser.user_code,
                        ToAdd = false,
                        ToView = false,
                        ToEdit = false,
                        ToDelete = false
                    });
                }
            }

            activeRights = merged.OrderBy(m => m.Sno).ToList();
            UpdateHeaderStates();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error loading rights: {ex.Message}");
        }
        finally
        {
            isLoadingRights = false;
            StateHasChanged();
        }
    }

    private void UpdateHeaderStates()
    {
        if (!activeRights.Any())
        {
            isAllAdd = isAllView = isAllEdit = isAllDelete = false;
            return;
        }

        isAllAdd = activeRights.All(r => r.ToAdd);
        isAllView = activeRights.All(r => r.ToView);
        isAllEdit = activeRights.All(r => r.ToEdit);
        isAllDelete = activeRights.All(r => r.ToDelete);
    }

    private void ToggleAllAdd(ChangeEventArgs e)
    {
        isAllAdd = (bool)(e.Value ?? false);
        foreach (var r in activeRights) r.ToAdd = isAllAdd;
    }

    private void ToggleAllView(ChangeEventArgs e)
    {
        isAllView = (bool)(e.Value ?? false);
        foreach (var r in activeRights) r.ToView = isAllView;
    }

    private void ToggleAllEdit(ChangeEventArgs e)
    {
        isAllEdit = (bool)(e.Value ?? false);
        foreach (var r in activeRights) r.ToEdit = isAllEdit;
    }

    private void ToggleAllDelete(ChangeEventArgs e)
    {
        isAllDelete = (bool)(e.Value ?? false);
        foreach (var r in activeRights) r.ToDelete = isAllDelete;
    }

    private async Task SaveRights()
    {
        if (selectedUser == null) return;
        isSaving = true;
        StateHasChanged();

        try
        {
            // Step 1: Delete existing rights first for a clean save
            await UserRightsService.DeleteModuleRightsAsync(selectedUser.user_code);

            // Step 2: Only send rights that have at least one permission enabled
            var rightsWithPermissions = activeRights
                .Where(r => r.ToAdd || r.ToView || r.ToEdit || r.ToDelete)
                .ToList();

            if (rightsWithPermissions.Any())
            {
                var payloadList = rightsWithPermissions.Select(r => new UserFormRightsModel.usermodulerights
                {
                    usermodulesrightsid = 0, // Always 0 for new inserts after delete
                    usercode = selectedUser.user_code,
                    usermoduleid = r.UserModuleID,
                    toadd = r.ToAdd,
                    toview = r.ToView,
                    toedit = r.ToEdit,
                    todelete = r.ToDelete,
                    tenant_code = TenantState.TenantCode
                }).ToList();

                var request = new UserFormRightsModel.ModuleRightsUpsertRequest
                {
                    usercode = selectedUser.user_code,
                    rights = payloadList
                };

                var success = await UserRightsService.SaveModuleRightsAsync(request);
                if (success)
                {
                    Toast.Success("User rights saved successfully.");
                    await LoadUserRights(); // Reload to confirm persistence
                }
                else
                {
                    Toast.Error("Failed to save user rights.");
                }
            }
            else
            {
                // No permissions selected - just the delete was enough
                Toast.Success("All permissions cleared and saved.");
                await LoadUserRights();
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error saving rights: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAllRights()
    {
        if (selectedUser == null) return;
        
        bool confirm = await JS_Confirm($"Are you sure you want to clear all permissions for {selectedUser.name}?");
        if (!confirm) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            var success = await UserRightsService.DeleteModuleRightsAsync(selectedUser.user_code);
            if (success)
            {
                Toast.Success("Permissions cleared successfully.");
                await LoadUserRights();
            }
            else
            {
                Toast.Error("Failed to delete user rights.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error deleting rights: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task ResetRights()
    {
        await LoadUserRights();
        Toast.Info("Form reset to saved settings.");
    }

    private async Task<bool> JS_Confirm(string message)
    {
        try
        {
            return await JSRuntime.InvokeAsync<bool>("confirm", message);
        }
        catch
        {
            return false;
        }
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;
}
