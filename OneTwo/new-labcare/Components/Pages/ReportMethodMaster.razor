@page "/ReportMethodMaster"
@using LabCare.Components.Layout
@using LabCare.Models
@using Newtonsoft.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject LabCare.Services.TenantSessionState TenantState

<div class="referral-page">
    <div class="lab-header-card flex-between">
        <div class="gap-16 display-flex align-center">
            <div class="p-2 bg-indigo-50 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="text-white material-symbols-outlined icon-lg">science</span>
            </div>
            <div>
                <h2 class="m-0 lab-title-text">Report Method Master</h2>
                <div class="gap-8 flex-start mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Reporting Methods</span>
                </div>
            </div>
        </div>
        <div class="gap-12 display-flex align-center">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search methods..." @bind="SearchQuery" @bind:event="oninput" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 8px 16px 8px 36px; font-size: 13px; color: #1e293b; outline: none; width: 220px;" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewMethod">+ Add New</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background: #fee2e2; border: 1px solid #fca5a5; color: #b91c1c; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 13px; font-weight: 500;">
            @errorMessage
        </div>
    }

    @if (showForm)
    {
        <div class="modal-overlay">
            <div class="modal-form-card">
                <div class="modal-header-bar">
                    <h3>@(isEditMode ? "Edit Method" : "New Method Entry")</h3>
                    <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                        </svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-0 form-section">
                        <div class="mt-0">
                            <div class="um-grid-row">
                                <div class="form-group position-relative">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                        <label style="margin-bottom: 0;">Method Name</label>
                                        @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                        {
                                            <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                        }
                                    </div>
                                    <input type="text" class="lab-input" @bind="current.name" @bind:event="oninput" @onfocus="() => showMethodDropdown = true" @onblur="HideMethodDropdown" placeholder="Search or Edit Method Name" @(isSubmitted && string.IsNullOrEmpty(current.name) ? "is-invalid" : "") required />
                                    @if (showMethodDropdown && !string.IsNullOrWhiteSpace(current.name) && !isEditMode)
                                    {
                                        var matchedMethods = methods
                                            .Where(c => c.name != null && c.name.Contains(current.name, StringComparison.OrdinalIgnoreCase))
                                            .ToList();

                                        if (matchedMethods.Any())
                                        {
                                            <div class="master-search-dropdown show">
                                                @foreach (var c in matchedMethods)
                                                {
                                                    <button type="button" class="master-search-item" @onmousedown="() => SelectExistingMethod(c)">
                                                        @c.name
                                                    </button>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="um-grid-cols-3">
                                <div class="form-group">
                                    <label>Order no</label>
                                    <input type="number" class="lab-input" @bind="current.orderno" placeholder="01" />
                                </div>
                                <div class="form-group">
                                    <label>Short Name</label>
                                    <input type="text" class="lab-input" @bind="current.shortname" />
                                </div>
                                <div class="form-group">
                                    <label>Duration Type</label>
                                    <select class="lab-input" @bind="current.duration">
                                        <option value="">Select</option>
                                        <option value="Min">Min</option>
                                        <option value="Hrs">Hrs</option>
                                        <option value="Days">Days</option>
                                    </select>
                                </div>
                            </div>
                            <div class="um-grid-cols-3 mt-4">
                                <div class="form-group">
                                    <label>Duration Time</label>
                                    <input type="number" class="lab-input" @bind="current.durationtime" placeholder="0" />
                                </div>
                                <div class="form-group" style="grid-column: span 2;">
                                    <label>Narration / Description</label>
                                    <input type="text" class="lab-input" @bind="current.description" placeholder="Optional notes..." />
                                </div>
                            </div>
                            <div class="um-grid-row mt-4">
                                <div class="form-group">
                                    <label>Footer Text</label>
                                    <textarea class="lab-input" style="height: 60px; resize: vertical;" @bind="current.footer" placeholder="Footer text to print on reports..."></textarea>
                                </div>
                            </div>
                            <div class="um-grid-row mt-4">
                                <div class="form-group display-flex align-center gap-8" style="padding-top: 10px;">
                                    <input type="checkbox" id="isculture" @bind="current.isculture" style="width: 16px; height: 16px; cursor: pointer;" />
                                    <label for="isculture" style="margin: 0; cursor: pointer; user-select: none;">Is Culture Method</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer-bar">
                    <button type="button" class="btn-delete" @onclick="() => SoftDeleteMethod(current.rtmcode)" disabled="@(current.rtmcode == 0)">
                        Delete
                    </button>
                    <button type="button" class="btn-save" @onclick="SaveMethod">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z" />
                        </svg>
                        Save Method
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="directory-section" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-top: -4px;">
        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th style="width: 64px;">ORDER NO</th>
                        <th>SHORT NAME</th>
                        <th>METHOD NAME</th>
                        <th>DURATION</th>
                        <th>NARRATION</th>
                        <th class="text-center" style="width: 100px;">CULTURE</th>
                        <th>MODIFIED DATE</th>
                        <th class="text-center" style="width: 128px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (methods != null && methods.Any())
                    {
                        @foreach (var co in FilteredMethodsBySearch)
                        {
                            <tr>
                                <td><span class="td-order-no">@($"{co.orderno:00}")</span></td>
                                <td style="color: #64748b; font-family: monospace;">@co.shortname</td>
                                <td><span class="td-name">@co.name</span></td>
                                <td>
                                    @if (co.durationtime > 0 || !string.IsNullOrEmpty(co.duration))
                                    {
                                        <span>@co.durationtime @co.duration</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td><span class="td-narration">@co.description</span></td>
                                <td class="text-center">
                                    @if (co.isculture)
                                    {
                                        <span style="background: #dcfce7; color: #15803d; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 700;">Yes</span>
                                    }
                                    else
                                    {
                                        <span style="color: #94a3b8; font-size: 11px;">No</span>
                                    }
                                </td>
                                <td>@($"{co.ibsdate:MM/dd/yyyy hh:mm tt}")</td>
                                <td class="text-center">
                                    <button type="button" class="btn-action btn-edit" @onclick="() => EditMethod(co)" title="Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg>
                                    </button>
                                    <button type="button" class="btn-action btn-delete-action" @onclick="() => SoftDeleteMethod(co.rtmcode)" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="p-24 text-center td-narration">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<ReportMethodModel> methods = new();
    private IEnumerable<ReportMethodModel> FilteredMethods =>
        displayActiveOnly ? methods.Where(c => c.deleted != true) : methods;

    private IEnumerable<ReportMethodModel> FilteredMethodsBySearch =>
        FilteredMethods.Where(c =>
            string.IsNullOrWhiteSpace(SearchQuery) ||
            (c.name != null && c.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.shortname != null && c.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    private ReportMethodModel current = new();
    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;
    private bool isEditMode = false;
    private bool displayActiveOnly = true;
    private bool showForm = false;
    private bool isSubmitted = false;
    private bool showMethodDropdown = false;
    private string SearchQuery = "";

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";
    private string? errorMessage;

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    TenantState.SetSession(TenantCode, AuthToken, TenantName);
                    await LoadMethods();
                    StateHasChanged();
                }
                else
                {
                    errorMessage = "Access denied: Missing valid session. Please log in again.";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Session error: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private async Task LoadMethods()
    {
        if (string.IsNullOrEmpty(TenantCode))
        {
            errorMessage = "Unauthorized access. Missing tenant context.";
            return;
        }
        try
        {
            errorMessage = null;
            using var client = CreateClient();
            var url = $"{BaseUrl}ReportMethod/get";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                methods = await response.Content.ReadFromJsonAsync<List<ReportMethodModel>>() ?? new List<ReportMethodModel>();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error loading methods ({response.StatusCode}): {errorBody}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading methods: {ex.Message}";
        }
    }

    private void NewMethod()
    {
        current = new ReportMethodModel
        {
            orderno = methods.Any() ? methods.Max(m => m.orderno) + 1 : 1,
            duration = "Hrs"
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private async Task EditMethod(ReportMethodModel co)
    {
        if (co == null) return;
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}ReportMethod/get-culture"; // Can get all including culture
            var all = await client.GetFromJsonAsync<List<ReportMethodModel>>(url);
            var match = all?.FirstOrDefault(m => m.rtmcode == co.rtmcode);
            current = match ?? JsonConvert.DeserializeObject<ReportMethodModel>(JsonConvert.SerializeObject(co)) ?? new ReportMethodModel();
        }
        catch (Exception)
        {
            current = JsonConvert.DeserializeObject<ReportMethodModel>(JsonConvert.SerializeObject(co)) ?? new ReportMethodModel();
        }
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveMethod()
    {
        isSubmitted = true;
        if (string.IsNullOrEmpty(TenantCode))
        {
            errorMessage = "Error: Tenant code is not loaded.";
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(current.name))
        {
            errorMessage = "Error: Method Name is required.";
            StateHasChanged();
            return;
        }

        // Duplicate check
        if (methods.Any(c => c.name?.Trim().Equals(current.name?.Trim(), StringComparison.OrdinalIgnoreCase) == true && c.rtmcode != current.rtmcode))
        {
            errorMessage = $"Error: A method with name '{current.name}' already exists.";
            StateHasChanged();
            return;
        }

        try
        {
            errorMessage = null;
            current.tenant_code = TenantCode;
            current.ibsdate = DateTime.Now;
            if (!isEditMode)
            {
                current.entereddate = DateTime.Now;
            }

            using var client = CreateClient();
            var endpoint = isEditMode
                ? $"{BaseUrl}ReportMethod/update"
                : $"{BaseUrl}ReportMethod/insert";

            HttpResponseMessage response = await client.PostAsJsonAsync(endpoint, current);

            if (response.IsSuccessStatusCode)
            {
                await LoadMethods();
                errorMessage = isEditMode ? "Method updated successfully." : "Method added successfully.";
                NewMethod();
                showForm = false;
                StateHasChanged();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                errorMessage = $"Save failed ({response.StatusCode}): {errorBody}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task SoftDeleteMethod(long rtmcode)
    {
        if (rtmcode == 0) return;

        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this report method?"))
        {
            try
            {
                using var client = CreateClient();
                var url = $"{BaseUrl}ReportMethod/softdelete?rtmcode={rtmcode}";
                var response = await client.GetAsync(url);
                
                if (response.IsSuccessStatusCode)
                {
                    await LoadMethods();
                    if (current != null && current.rtmcode == rtmcode)
                    {
                        showForm = false;
                    }
                }
                else
                {
                    // Fallback to hard delete or POST if softdelete fails
                    var hardUrl = $"{BaseUrl}ReportMethod/delete?rtmcode={rtmcode}";
                    var delResponse = await client.DeleteAsync(hardUrl);
                    if (delResponse.IsSuccessStatusCode)
                    {
                        await LoadMethods();
                        if (current != null && current.rtmcode == rtmcode)
                        {
                            showForm = false;
                        }
                    }
                    else
                    {
                        var errorBody = await delResponse.Content.ReadAsStringAsync();
                        errorMessage = $"Delete failed: {errorBody}";
                        StateHasChanged();
                    }
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private void CloseForm()
    {
        current = new ReportMethodModel();
        isEditMode = false;
        showForm = false;
    }

    private async Task HideMethodDropdown()
    {
        await Task.Delay(200);
        showMethodDropdown = false;
        StateHasChanged();
    }

    private void SelectExistingMethod(ReportMethodModel existingMethod)
    {
        showMethodDropdown = false;
        _ = EditMethod(existingMethod);
    }
}
