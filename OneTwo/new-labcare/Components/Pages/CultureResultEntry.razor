    private async Task LoadSessionAsync()
    {
        try
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

            var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
            AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

            var claimResult = await _sessionStorage.GetAsync<UserAuth>("claim");
            if (claimResult.Success && claimResult.Value != null)
            {
                LoggedInUserCode = claimResult.Value.usercode;
            }

            var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
            int? branchCode = null;
            int? counterCode = null;
            string tenantName = "";

            if (userResult.Success && userResult.Value != null)
            {
                UserRole = userResult.Value.Role;
                LoggedInUserName = userResult.Value.UserName;
                tenantName = userResult.Value.TenantName ?? "";
                branchCode = userResult.Value.BranchCode;
                counterCode = userResult.Value.CounterCode;

                if (!LoggedInUserCode.HasValue || LoggedInUserCode == 0)
                {
                    LoggedInUserCode = userResult.Value.UserCode;
                }
            }

            if (!LoggedInUserCode.HasValue || LoggedInUserCode == 0)
            {
                if (TenantState.UserCode > 0)
                {
                    LoggedInUserCode = TenantState.UserCode;
                }
            }

            // Always set session to ensure TenantState is hydrated
            TenantState.SetSession(TenantCode, AuthToken ?? "", tenantName, LoggedInUserCode ?? 0, branchCode, counterCode);

             
            var activeUserCode = LoggedInUserCode ?? 0;
            if (activeUserCode != 0)
            {
                await LoadUserGCodeAsync(activeUserCode);
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Session error: {ex.Message}") */;
        }
    }

    private async Task LoadUserGCodeAsync(int userCode)
    {
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}userrights/authget?usercode={userCode}";
            /* Console.WriteLine($"[Debug] [LoadUserGCodeAsync] Fetching from URL: {url}") */;
            var response = await client.GetAsync(url);
            /* Console.WriteLine($"[Debug] [LoadUserGCodeAsync] Response Status: {response.StatusCode}") */;
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                /* Console.WriteLine($"[Debug] [LoadUserGCodeAsync] Raw Response: {content}") */;
                var jToken = Newtonsoft.Json.Linq.JToken.Parse(content);
                
                if (jToken is Newtonsoft.Json.Linq.JArray jArray && jArray.Any())
                {
                    var first = jArray.First;
                    UserGCode = first["gcode"]?.ToObject<int>() ?? first["GCode"]?.ToObject<int>() ?? first["gCode"]?.ToObject<int>();
                }
                else if (jToken is Newtonsoft.Json.Linq.JObject jObj)
                {
                    var data = jObj["data"] ?? jObj;
                    if (data is Newtonsoft.Json.Linq.JArray dArray && dArray.Any())
                    {
                        var first = dArray.First;
                        UserGCode = first["gcode"]?.ToObject<int>() ?? first["GCode"]?.ToObject<int>() ?? first["gCode"]?.ToObject<int>();
                    }
                    else
                    {
                        UserGCode = data["gcode"]?.ToObject<int>() ?? data["GCode"]?.ToObject<int>() ?? data["gCode"]?.ToObject<int>();
                    }
                }
                /* Console.WriteLine($"[Debug] [LoadUserGCodeAsync] Parsed UserGCode: {UserGCode}") */;
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"[Debug] [LoadUserGCodeAsync] Error: {ex.Message}") */;
        }
    }

    private bool IsAuthorizeDisabled()
    {
        if (ActiveTab == null) return true;
        if (!ActiveTab.resultcultureguid.HasValue) return true;
        
        // System Administrator bypasses gcode checks
        if (!string.IsNullOrEmpty(UserRole) && UserRole.Equals("Administrator", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        /* Console.WriteLine($"[Debug] [IsAuthorizeDisabled] UserRole: {UserRole}, UserGCode: {UserGCode}, TestGCode: {ActiveTab.gcode}") */;

        // If the test has no gcode restriction, anyone can authorize
        if (!ActiveTab.gcode.HasValue || ActiveTab.gcode.Value == 0)
        {
            return false;
        }

        // If the test requires a gcode but the user doesn't have one, block them
        if (!UserGCode.HasValue || UserGCode.Value == 0)
        {
            return true;
        }
        
        // Both have valid gcodes, they must match
        return UserGCode.Value != ActiveTab.gcode.Value;
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private async Task LoadTabsAsync(int? activeTCodeToKeep = null)
    {
        try
        {
            errorMessage = null;
            using var client = CreateClient();
            var url = $"{BaseUrl}culture/request-tests?requestguid={RequestGuid}";
            /* Console.WriteLine($"[Debug] [LoadTabsAsync] Fetching from URL: {url}") */;
            var response = await client.GetAsync(url);
            /* Console.WriteLine($"[Debug] [LoadTabsAsync] Response Status: {response.StatusCode}") */;
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                /* Console.WriteLine($"[Debug] [LoadTabsAsync] Raw JSON: {content}") */;
                var jToken = Newtonsoft.Json.Linq.JToken.Parse(content);
                
                if (jToken is Newtonsoft.Json.Linq.JArray jArray)
                {
                    CultureTabs = jArray.ToObject<List<CultureTestListDto>>() ?? new();
                }
                else if (jToken is Newtonsoft.Json.Linq.JObject jObj)
                {
                    var dataToken = jObj["data"] ?? jObj["tests"] ?? jObj["items"] ?? jObj;
                    if (dataToken is Newtonsoft.Json.Linq.JArray dataArray)
                    {
                        CultureTabs = dataArray.ToObject<List<CultureTestListDto>>() ?? new();
                    }
                    else
                    {
                        CultureTabs = new List<CultureTestListDto> { dataToken.ToObject<CultureTestListDto>() };
                    }
                }

                /* Console.WriteLine($"[Debug] [LoadTabsAsync] Loaded {CultureTabs.Count} tabs.") */;
                foreach (var t in CultureTabs)
                {
                    /* Console.WriteLine($"[Debug] [LoadTabsAsync] Tab - tcode: {t.tcode}, Name: {t.testname}, Guid: {t.resultcultureguid}") */;
                }

                if (CultureTabs.Any())
                {
                    CultureTestListDto? nextActiveTab = null;
                    if (activeTCodeToKeep.HasValue)
                    {
                        nextActiveTab = CultureTabs.FirstOrDefault(t => t.tcode == activeTCodeToKeep);
                    }
                    nextActiveTab ??= CultureTabs.First();
                    await SelectTabAsync(nextActiveTab);
                }
            }
            else
            {
                errorMessage = $"Error loading tests: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            /* Console.WriteLine($"[Debug] [LoadTabsAsync] Exception: {ex.Message}\n{ex.StackTrace}") */;
        }
    }

    private async Task SelectTabAsync(CultureTestListDto tab)
    {
        ActiveTab = tab;
        if (tab.tcode.HasValue && !TabStates.ContainsKey(tab.tcode.Value))
        {
            await LoadTabDataAsync(tab);
        }
        StateHasChanged();
    }

    private async Task LoadTabDataAsync(CultureTestListDto tab)
    {
        try
        {
            /* Console.WriteLine($"[Debug] [LoadTabDataAsync] Triggered for tcode: {tab.tcode}, testname: {tab.testname}, resultcultureguid: {tab.resultcultureguid}") */;
            using var client = CreateClient();
            CultureSaveRequestDto requestData = new()
            {
                tcode = tab.tcode,
                isolationRows = new(),
                culture = new LabCultureMaster
                {
                    requestguid = string.IsNullOrEmpty(RequestGuid) ? null : Guid.Parse(RequestGuid),
                    resultcultureguid = tab.resultcultureguid,
                    recode = 1001, // Default or from logic
                    reportstatus = "Preliminary",
                    isgrowth = false, // Set default so No Growth is checked initially
                    samplereceiveddate = DateTime.Now,
                    culturereporteddate = DateTime.Now.AddDays(3),
                    tenant_code = TenantCode
                }
            };

            Guid? resultGuid = tab.resultcultureguid;
            if (!resultGuid.HasValue)
            {
                var testsUrl = $"{BaseUrl}culture/tests?requestGuid={RequestGuid}";
                /* Console.WriteLine($"[Debug] [LoadTabDataAsync] resultcultureguid was null. Fetching result list from: {testsUrl}") */;
                var testsResponse = await client.GetAsync(testsUrl);
                /* Console.WriteLine($"[Debug] [LoadTabDataAsync] testsResponse Status: {testsResponse.StatusCode}") */;
                if (testsResponse.IsSuccessStatusCode)
                {
                    var testsContent = await testsResponse.Content.ReadAsStringAsync();
                    /* Console.WriteLine($"[Debug] [LoadTabDataAsync] culture/tests Raw Response: {testsContent}") */;
                    var jToken = Newtonsoft.Json.Linq.JToken.Parse(testsContent);
                    List<CultureTestListDto>? testsList = null;
                    
                    if (jToken is Newtonsoft.Json.Linq.JArray jArray)
                    {
                        testsList = jArray.ToObject<List<CultureTestListDto>>();
                    }
                    else if (jToken is Newtonsoft.Json.Linq.JObject jObj)
                    {
                        var dataToken = jObj["data"] ?? jObj["tests"] ?? jObj["items"] ?? jObj;
                        if (dataToken is Newtonsoft.Json.Linq.JArray dataArray)
                        {
                            testsList = dataArray.ToObject<List<CultureTestListDto>>();
                        }
                    }
                    
                    if (testsList != null)
                    {
                        /* Console.WriteLine($"[Debug] [LoadTabDataAsync] Parsed {testsList.Count} items from culture/tests.") */;
                        foreach (var item in testsList)
                        {
                            /* Console.WriteLine($"[Debug] [LoadTabDataAsync] Result test item - tcode: {item.tcode}, Name: {item.testname}, Guid: {item.resultcultureguid}") */;
                        }
                    }
                    
                    var matchedTest = testsList?.FirstOrDefault(t => t.tcode == tab.tcode);
                    if (matchedTest != null && matchedTest.resultcultureguid.HasValue)
                    {
                        resultGuid = matchedTest.resultcultureguid;
                        tab.resultcultureguid = resultGuid; // Map back to tab for checkmark updates
                        requestData.culture.resultcultureguid = resultGuid;
                        /* Console.WriteLine($"[Debug] [LoadTabDataAsync] Matched resultcultureguid: {resultGuid} for tcode: {tab.tcode}") */;
                    }
                    else
                    {
                        /* Console.WriteLine($"[Debug] [LoadTabDataAsync] No matching resultcultureguid found in culture/tests for tcode: {tab.tcode}") */;
                    }
                }
            }

            if (resultGuid.HasValue)
            {
                var url = $"{BaseUrl}Culture/entry?resultCultureGuid={resultGuid}";
                /* Console.WriteLine($"[Debug] [LoadTabDataAsync] Fetching detailed entry from: {url}") */;
                var response = await client.GetAsync(url);
                /* Console.WriteLine($"[Debug] [LoadTabDataAsync] Culture/entry Response Status: {response.StatusCode}") */;
                if (response.IsSuccessStatusCode)
                {
                    var content = await response.Content.ReadAsStringAsync();
                    /* Console.WriteLine($"[Debug] [LoadTabDataAsync] Culture/entry Raw Response: {content}") */;
                    var json = JObject.Parse(content);
                    
                    /* Console.WriteLine("--- FETCHED CULTURE ENTRY PAYLOAD FROM DB ---") */;
                    /* Console.WriteLine(json.ToString(Formatting.Indented)) */;
                    
                    // Resilient mapping: prioritize "culture" or "Culture" property matching the CultureEntryGetDto
                    var master = json["culture"] ?? json["Culture"] ?? json["master"] ?? json["Master"] ?? json;
                    if (master != null)
                    {
                        requestData.culture = master.ToObject<LabCultureMaster>() ?? requestData.culture;
                        requestData.culture.resultcultureguid = resultGuid;
                        /* Console.WriteLine($"[Debug] [LoadTabDataAsync] Mapped culture master record successfully. Sample: {requestData.culture.sample}, IsGrowth: {requestData.culture.isgrowth}") */;
                    }
                    else
                    {
                        /* Console.WriteLine("[Debug] [LoadTabDataAsync] Warning: No master culture node found in the entry payload.") */;
                    }

                    var entered = json["resultenteredbyname"]?.ToString()
                        ?? json["resultenteredByName"]?.ToString()
                        ?? json["culture"]?["resultenteredbyname"]?.ToString()
                        ?? json["culture"]?["resultenteredByName"]?.ToString()
                        ?? json["enteredbyname"]?.ToString() 
                        ?? json["enteredByName"]?.ToString() 
                        ?? json["culture"]?["enteredbyname"]?.ToString() 
                        ?? json["culture"]?["enteredByName"]?.ToString();
                        
                    var auth = json["resultauthorizedbyname"]?.ToString()
                        ?? json["resultauthorizedByName"]?.ToString()
                        ?? json["culture"]?["resultauthorizedbyname"]?.ToString()
                        ?? json["culture"]?["resultauthorizedByName"]?.ToString()
                        ?? json["authorizedbyname"]?.ToString() 
                        ?? json["authorizedByName"]?.ToString() 
                        ?? json["culture"]?["authorizedbyname"]?.ToString() 
                        ?? json["culture"]?["authorizedByName"]?.ToString();

                    if (tab.tcode.HasValue)
                    {
                        if (!string.IsNullOrEmpty(entered)) TabEnteredByNames[tab.tcode.Value] = entered;
                        if (!string.IsNullOrEmpty(auth)) TabAuthorizedByNames[tab.tcode.Value] = auth;
                    }

                    var iso = json["isolationRows"] ?? json["iso"] ?? json["isolationDetails"];
                    if (iso != null)
                    {
                        requestData.isolationRows = iso.ToObject<List<CultureIsolationRowDto>>() ?? new();
                        /* Console.WriteLine($"[Debug] [LoadTabDataAsync] Mapped {requestData.isolationRows.Count} isolation rows.") */;
                    }
                    else
                    {
                        /* Console.WriteLine("[Debug] [LoadTabDataAsync] Warning: No isolation rows node found in the entry payload.") */;
                    }
                }
            }
            else
            {
                /* Console.WriteLine($"[Debug] [LoadTabDataAsync] Skipped detail fetch: resultGuid is null.") */;
            }
            
            if (tab.tcode.HasValue)
            {
                TabStates[tab.tcode.Value] = requestData;
                /* Console.WriteLine($"[Debug] [LoadTabDataAsync] Saved requestData to TabStates for tcode: {tab.tcode.Value}. IsGrowth = {TabStates[tab.tcode.Value].culture.isgrowth}") */;
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"[Debug] [LoadTabDataAsync] Error loading tab data: {ex.Message}\n{ex.StackTrace}") */;
            if (tab.tcode.HasValue)
                TabStates[tab.tcode.Value] = new CultureSaveRequestDto { tcode = tab.tcode, isolationRows = new(), culture = new LabCultureMaster() };
        }
    }

