@page "/culture-result-entry"
@using LabCare.Models
@using Lims.Components.Model
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject LabCare.Services.TenantSessionState TenantState
@inject NavigationManager NavigationManager


<div class="culture-container">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px; border-radius: 8px; background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined">error</span>
            @errorMessage
        </div>
    }

    @if (CultureTabs == null)
    {
        <div style="text-align: center; padding: 40px; color: #64748b;">
            <div class="spinner"></div> Loading tests...
        </div>
    }
    else if (!CultureTabs.Any())
    {
        <div style="text-align: center; padding: 40px; background: white; border-radius: 12px; color: #64748b;">
            <span class="material-symbols-outlined" style="font-size: 48px; margin-bottom: 12px;">sentiment_dissatisfied</span>
            <p>No culture tests found for this request.</p>
        </div>
    }
    else
    {
        <!-- TABS -->
        <div class="culture-tabs">
            @{ int tabIndex = 1; }
            @foreach (var tab in CultureTabs)
            {
                <div class="culture-tab @(ActiveTab == tab ? "active" : "")" @onclick="() => SelectTabAsync(tab)">
                    <div class="tab-number">@tabIndex</div>
                    <div class="tab-text">
                        <div class="tab-title">Culture Type</div>
                        <div class="tab-name">@tab.testname</div>
                    </div>
                    @if (IsTabAuthorized(tab))
                    {
                        <span class="material-symbols-outlined" style="color: #10b981; font-size: 18px; margin-left: 8px;">check_circle</span>
                    }
                    else if (tab.resultcultureguid.HasValue || (tab.tcode.HasValue && IsTabModified(tab.tcode.Value)))
                    {
                        <span style="width: 8px; height: 8px; background: #f59e0b; border-radius: 50%; margin-left: 8px;"></span>
                    }
                </div>
                tabIndex++;
            }
        </div>

        @if (ActiveTab != null && ActiveData != null)
        {
            <!-- PATIENT HEADER CARD -->
            <div class="culture-card" style="border-left: 4px solid #6366f1;">
                <div class="culture-header-flex">
                    <div class="patient-info">
                        <div class="patient-name" style="display: flex; align-items: center; gap: 6px;">
                            <span>Patient Name:</span>
                            <span>@(PatientInfo?.customername ?? "Patient Details Not Available")</span>
                            
                        </div>
                        @if (PatientInfo?.custid.HasValue == true && PatientInfo.custid.Value != 0)
                        {
                            <div class="patient-detail" style="display: flex; align-items: center; gap: 4px;">
                                
                                <span>Cust.ID :</span>
                                <span class="patient-value">@PatientInfo.custid</span>
                            </div>
                        }
                        @if (PatientInfo?.billno.HasValue == true && PatientInfo.billno.Value != 0)
                        {
                            <div class="patient-detail" style="display: flex; align-items: center; gap: 4px;">
                               
                                <span>Bill No :</span>
                                <span class="patient-value">@PatientInfo.billno</span>
                            </div>
                        }
                        <div class="patient-detail" style="display: flex; align-items: center; gap: 4px;">
                            
                            <span>Ref.by :</span>
                            <span class="patient-value">@(string.IsNullOrEmpty(PatientInfo?.referralname) ? "Self" : PatientInfo.referralname)</span>
                        </div>
                        <div class="patient-detail" style="display: flex; align-items: center; gap: 4px;">
                            
                            <span>SID.No :</span>
                            <span class="patient-value">@RequestGuid</span>
                        </div>
                    </div>
                    <!-- Action buttons unified in footer -->
                </div>
            </div>

            <!-- MAIN FORM CARD -->
            <div class="culture-card">
                <div class="form-grid-3">
                    <!-- Column 1 -->
                    <div>
                        <div class="form-row">
                            <div class="form-label">Report Status</div>
                            <div class="radio-group">
                                <label class="radio-label">
                                    <input type="radio" name="reportStatus_@ActiveTab.tcode" checked="@(ActiveData.culture.reportstatus == "Preliminary")" @onchange="@(() => ActiveData.culture.reportstatus = "Preliminary")" /> Preliminary
                                </label>
                                <label class="radio-label">
                                    <input type="radio" name="reportStatus_@ActiveTab.tcode" checked="@(ActiveData.culture.reportstatus == "Supplementary")" @onchange="@(() => ActiveData.culture.reportstatus = "Supplementary")" /> Supplementary
                                </label>
                                <label class="radio-label">
                                    <input type="radio" name="reportStatus_@ActiveTab.tcode" checked="@(ActiveData.culture.reportstatus == "Final Report")" @onchange="@(() => ActiveData.culture.reportstatus = "Final Report")" /> Final Report
                                </label>
                            </div>
                        </div>

                        <div class="form-row" style="margin-top: 24px;">
                            <div class="form-label">Growth</div>
                            <div class="radio-group">
                                <label class="radio-label">
                                    <input type="radio" name="isGrowth_@ActiveTab.tcode" checked="@(ActiveData.culture.isgrowth == false)" @onchange="@(() => ActiveData.culture.isgrowth = false)" /> No Growth
                                </label>
                                <label class="radio-label">
                                    <input type="radio" name="isGrowth_@ActiveTab.tcode" checked="@(ActiveData.culture.isgrowth == true)" @onchange="@(() => ActiveData.culture.isgrowth = true)" /> Growth
                                </label>
                            </div>
                        </div>

                        <div class="form-row" style="margin-top: 24px;">
                            <div class="form-label form-label-required">Reporting Method</div>
                            <input type="text" class="form-input" @bind="ActiveData.culture.reportingmethod" />
                        </div>

                        <div class="form-row">
                            <div class="form-label form-label-required">Sample</div>
                            <select class="form-input" @bind="ActiveData.culture.sample">
                                <option value="">-- Select Sample --</option>
                                <option value="Urine">Urine</option>
                                <option value="Blood">Blood</option>
                                <option value="Stool">Stool</option>
                                <option value="Pus">Pus</option>
                                <option value="Sputum">Sputum</option>
                            </select>
                        </div>

                        <div class="form-row" style="align-items: flex-start;">
                            <div class="form-label">Direct Smear</div>
                            <textarea class="form-input" rows="2"></textarea>
                        </div>
                    </div>

                    <!-- Column 2 -->
                    <div>
                        <div class="form-row">
                            <div class="form-label">Sample Date</div>
                            <input type="datetime-local" class="form-input" @bind="ActiveData.culture.samplereceiveddate" />
                        </div>
                        <div class="form-row">
                            <div class="form-label">Reported Date</div>
                            <input type="datetime-local" class="form-input" @bind="ActiveData.culture.culturereporteddate" />
                        </div>
                        <div class="form-row">
                            <div class="form-label">Smear for AFB</div>
                            <input type="text" class="form-input" @bind="ActiveData.culture.smearafb" />
                        </div>
                        <div class="form-row">
                            <div class="form-label">Pus Cells</div>
                            <input type="text" class="form-input" @bind="ActiveData.culture.puscells" />
                        </div>
                        <div class="form-row" style="align-items: flex-start;">
                            <div class="form-label">Gram's Staining</div>
                            <textarea class="form-input" rows="2" @bind="ActiveData.culture.gramsstaining"></textarea>
                        </div>
                    </div>

                    <!-- Column 3 -->
                    <div>
                        <div class="info-box">
                            <div class="info-row">
                                <div class="info-label">Entered by</div>
                                <div>: <span class="info-val">@EnteredByName</span></div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Authorized by</div>
                                <div>: <span class="@(IsAuthorized ? "info-val" : "")" style="color: @(IsAuthorized ? "" : "#64748b"); font-weight: 600;">@AuthorizedByName</span></div>
                            </div>
                        </div>

                        <div class="form-row" style="align-items: flex-start; margin-top: 16px;">
                            <div class="form-label">Growth Grade</div>
                            <textarea class="form-input" rows="2" @bind="ActiveData.culture.growthgrade"></textarea>
                        </div>
                        <div class="form-row" style="align-items: flex-start;">
                            <div class="form-label">Diagnosis</div>
                            <textarea class="form-input" rows="3" @bind="ActiveData.culture.diagnosis"></textarea>
                        </div>
                    </div>
                </div>
            </div>


            
            <!-- ORGANISMS & SENSITIVITY GRID -->
            @if (ActiveData.culture.isgrowth == true)
            {
                <div class="culture-card" style="margin-top: 24px;">
                    <div style="display: flex; gap: 24px;">
                        <div style="width: 150px;"></div>
                        <div style="flex: 1; text-align: center; font-weight: 700; color: #ef4444; background: #fee2e2; padding: 8px; border-radius: 8px;">SECTION A</div>
                        <div style="flex: 1; text-align: center; font-weight: 700; color: #f59e0b; background: #fef3c7; padding: 8px; border-radius: 8px;">SECTION B</div>
                        <div style="flex: 1; text-align: center; font-weight: 700; color: #eab308; background: #fef9c3; padding: 8px; border-radius: 8px;">SECTION C</div>
                    </div>

                    <div style="display: flex; gap: 24px; margin-top: 16px; align-items: center;">
                        <div class="form-label" style="width: 150px; color: #ef4444;">ORGANISM GROWN</div>
                        <select class="form-input" @bind="ActiveData.culture.organismsgrown">
                            <option value="">-- Select Organism --</option>
                            @foreach(var org in AvailableOrganisms) { <option value="@org.name">@org.name</option> }
                        </select>
                        <select class="form-input" @bind="ActiveData.culture.organismsgrownb">
                            <option value="">-- Select Organism --</option>
                            @foreach(var org in AvailableOrganisms) { <option value="@org.name">@org.name</option> }
                        </select>
                        <select class="form-input" @bind="ActiveData.culture.organismsgrownc">
                            <option value="">-- Select Organism --</option>
                            @foreach(var org in AvailableOrganisms) { <option value="@org.name">@org.name</option> }
                        </select>
                    </div>

                    <div style="display: flex; gap: 24px; margin-top: 16px; align-items: center;">
                        <div class="form-label" style="width: 150px; color: #ef4444;">COLONY COUNT</div>
                        <input type="text" class="form-input" @bind="ActiveData.culture.colonycount" placeholder="Count..." />
                        <input type="text" class="form-input" @bind="ActiveData.culture.colonycountb" placeholder="Count..." />
                        <input type="text" class="form-input" @bind="ActiveData.culture.colonycountc" placeholder="Count..." />
                    </div>

                    <div style="display: flex; gap: 24px; margin-top: 16px; align-items: center;">
                        <div class="form-label" style="width: 150px; color: #ef4444;">COMMENTS</div>
                        <input type="text" class="form-input" @bind="ActiveData.culture.commentsa" placeholder="Notes..." />
                        <input type="text" class="form-input" @bind="ActiveData.culture.commentsb" placeholder="Notes..." />
                        <input type="text" class="form-input" @bind="ActiveData.culture.commentsc" placeholder="Notes..." />
                    </div>
                </div>

                <div style="display: flex; gap: 24px; margin-top: 24px;">
                    <!-- Available Antibiotics Sidebar -->
                    <div class="culture-card" style="width: 280px; margin-bottom: 0;">
                        <div style="font-weight: 700; color: #6366f1; margin-bottom: 12px; font-size: 12px;">AVAILABLE ANTIBIOTICS</div>
                        <input type="text" class="form-input" @bind="SearchAntibiotic" @bind:event="oninput" placeholder="Search..." style="margin-bottom: 16px;" />
                        
                        <div style="max-height: 400px; overflow-y: auto;">
                            @foreach (var ab in AvailableAntibiotics.Where(a => string.IsNullOrEmpty(SearchAntibiotic) || (a.name != null && a.name.Contains(SearchAntibiotic, StringComparison.OrdinalIgnoreCase))))
                            {
                                <div class="ab-drag-item" draggable="true" @ondragstart="() => OnDragStart(ab)" @ondragend="OnDragEnd">
                                    <span class="material-symbols-outlined" style="font-size: 16px; color: #94a3b8;">drag_indicator</span>
                                    @ab.name
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Main Tabs Panel for Drag Drop -->
                    <div style="flex: 1;">
                        <div style="display: flex; gap: 8px;">
                            <button class="section-tab @(ActiveSection == "A" ? "active-tab-a" : "")" @onclick="@(() => ActiveSection = "A")">SECTION A</button>
                            <button class="section-tab @(ActiveSection == "B" ? "active-tab-b" : "")" @onclick="@(() => ActiveSection = "B")">SECTION B</button>
                            <button class="section-tab @(ActiveSection == "C" ? "active-tab-c" : "")" @onclick="@(() => ActiveSection = "C")">SECTION C</button>
                        </div>
                        
                        <div class="culture-card drop-zone" style="border-top-left-radius: 0; min-height: 400px; position: relative;" @ondragover:preventDefault @ondrop="() => OnDrop()">
                            @if (isDragging && draggedAntibiotic != null)
                            {
                                <div class="drag-overlay">
                                    <div class="drag-header">
                                        SELECT SENSITIVITY: @draggedAntibiotic.name?.ToUpper()
                                    </div>
                                    <div class="drag-zones-container">
                                        <div class="drag-zone-item zone-sensitive @(activeDragZone == "S" ? "active" : "")" 
                                             @ondragover:preventDefault 
                                             @ondragenter='() => activeDragZone = "S"'
                                             @ondragleave='() => activeDragZone = ""'
                                             @ondrop='() => OnDropWithSensitivity("S")'
                                             @ondrop:stopPropagation>
                                            <div class="zone-char">S</div>
                                            <div class="zone-text">SENSITIVE</div>
                                        </div>
                                        
                                        <div class="drag-zone-item zone-intermediate @(activeDragZone == "I" ? "active" : "")" 
                                             @ondragover:preventDefault 
                                             @ondragenter='() => activeDragZone = "I"'
                                             @ondragleave='() => activeDragZone = ""'
                                             @ondrop='() => OnDropWithSensitivity("I")'
                                             @ondrop:stopPropagation>
                                            <div class="zone-char">I</div>
                                            <div class="zone-text">INTERMEDIATE</div>
                                        </div>
                                        
                                        <div class="drag-zone-item zone-resistant @(activeDragZone == "R" ? "active" : "")" 
                                             @ondragover:preventDefault 
                                             @ondragenter='() => activeDragZone = "R"'
                                             @ondragleave='() => activeDragZone = ""'
                                             @ondrop='() => OnDropWithSensitivity("R")'
                                             @ondrop:stopPropagation>
                                            <div class="zone-char">R</div>
                                            <div class="zone-text">RESISTANT</div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #e2e8f0; text-align: left;">
                                        <th style="padding: 12px; color: #64748b; width: 40px;">#</th>
                                        <th style="padding: 12px; color: #64748b;">Antibiotic</th>
                                        <th style="padding: 12px; color: #64748b; width: 100px;">Disk</th>
                                        <th style="padding: 12px; color: #64748b; width: 100px;">MM / MIC</th>
                                        <th style="padding: 12px; width: 40px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (ActiveData.isolationRows != null)
                                    {
                                        int index = 1;
                                        @foreach (var r in ActiveData.isolationRows.Where(r => 
                                            (ActiveSection == "A" && !string.IsNullOrEmpty(r.isolation_a)) ||
                                            (ActiveSection == "B" && !string.IsNullOrEmpty(r.isolation_b)) ||
                                            (ActiveSection == "C" && !string.IsNullOrEmpty(r.isolation_c))
                                        ))
                                        {
                                            var sens = ActiveSection == "A" ? r.isolation_a : (ActiveSection == "B" ? r.isolation_b : r.isolation_c);
                                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                                <td style="padding: 12px; color: #64748b;">@index</td>
                                                <td style="padding: 12px;">
                                                    <div style="display: flex; align-items: center; gap: 12px;">
                                                        <div class="@(sens == "S" ? "pill-s" : sens == "R" ? "pill-r" : "pill-i")" @onclick="() => ToggleSensitivity(r)">@sens</div>
                                                        <span style="font-weight: 600; color: var(--lc-secondary);">@r.columnname</span>
                                                    </div>
                                                </td>
                                                <td style="padding: 12px;">
                                                    @if (ActiveSection == "A") { <input type="text" class="form-input" style="width: 80px;" @bind="r.diskcontenta" /> }
                                                    @if (ActiveSection == "B") { <input type="text" class="form-input" style="width: 80px;" @bind="r.diskcontentb" /> }
                                                    @if (ActiveSection == "C") { <input type="text" class="form-input" style="width: 80px;" @bind="r.diskcontentc" /> }
                                                </td>
                                                <td style="padding: 12px;">
                                                    @if (ActiveSection == "A") { <input type="text" class="form-input" style="width: 80px;" @bind="r.mma1" /> }
                                                    @if (ActiveSection == "B") { <input type="text" class="form-input" style="width: 80px;" @bind="r.mma2" /> }
                                                    @if (ActiveSection == "C") { <input type="text" class="form-input" style="width: 80px;" @bind="r.mma3" /> }
                                                </td>
                                                <td style="padding: 12px; text-align: center;">
                                                    <button style="background: transparent; border: 1px solid #e2e8f0; border-radius: 4px; padding: 4px 8px; color: #94a3b8; cursor: pointer;" @onclick="() => RemoveAntibiotic(r)">
                                                        <span class="material-symbols-outlined" style="font-size: 16px;">close</span>
                                                    </button>
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                        
                                        @if (index == 1)
                                        {
                                            <tr><td colspan="5" style="padding: 24px; text-align: center; color: #94a3b8;">Drag antibiotics here...</td></tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- NOTES AND COMMENTS CARD -->
            <div class="culture-card" style="margin-top: 24px;">
                <div style="display: flex; gap: 24px;">
                    <div style="flex: 1;">
                        <div class="form-label" style="margin-bottom: 8px;">Note Message</div>
                        <textarea class="form-input" rows="2" placeholder="Enter message..."></textarea>
                    </div>
                    <div style="flex: 2;">
                        <div class="form-label" style="margin-bottom: 8px;">Comments</div>
                        <textarea class="form-input" rows="2" placeholder="Additional comments..." @bind="ActiveData.culture.comments"></textarea>
                    </div>
                </div>
            </div>
            
            <!-- FOOTER -->
            <div class="culture-footer" style="justify-content: center; gap: 12px;">
                <div class="footer-right" style="display: flex; gap: 12px; align-items: center; width: 100%; justify-content: center;">
                    @if (!(IsAuthorized && IsAuthorizeDisabled()))
                    {
                        <button class="btn-footer btn-save" @onclick="SaveAllAsync" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner" style="width: 14px; height: 14px; border-width: 2px;"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined" style="font-size: 18px;">save</span>
                                <span>Save</span>
                            }
                        </button>
                    }

                    @if (IsAuthorized && !IsAuthorizeDisabled())
                    {
                        <button class="btn-footer btn-delete" style="background-color: #ef4444; color: white; border-color: #ef4444;" @onclick="RevokeAsync">
                            <span class="material-symbols-outlined" style="font-size: 18px;">undo</span> Revoke
                        </button>
                    }
                    else if (!IsAuthorized && !IsAuthorizeDisabled())
                    {
                        <button class="btn-footer btn-print" @onclick="AuthorizeAsync">
                            <span class="material-symbols-outlined" style="font-size: 18px;">verified_user</span> Authorize
                        </button>
                    }

                    <button class="btn-footer btn-print" style="background-color: #8b5cf6; border-color: #8b5cf6; color: white;" @onclick="PreviewCultureReportExternal" disabled="@(isPreviewingCulture || string.IsNullOrEmpty(RequestGuid))">
                        @if (isPreviewingCulture)
                        {
                            <span class="spinner" style="width: 14px; height: 14px; border-width: 2px;"></span>
                            <span>Previewing...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="font-size: 18px;">visibility</span>
                            <span>Preview Report</span>
                        }
                    </button>

                    <button class="btn-footer btn-print" @onclick="PrintCultureReportExternal" disabled="@(isPrintingCulture || string.IsNullOrEmpty(RequestGuid))">
                        @if (isPrintingCulture)
                        {
                            <span class="spinner" style="width: 14px; height: 14px; border-width: 2px;"></span>
                            <span>Printing...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="font-size: 18px;">print</span>
                            <span>Print Report</span>
                        }
                    </button>
                    <button class="btn-footer btn-delete" @onclick="RevokeAsync" disabled="@(!ActiveTab.resultcultureguid.HasValue || (IsAuthorized && IsAuthorizeDisabled()))">
                        <span class="material-symbols-outlined" style="font-size: 18px;">close</span>
                        <span>close</span>
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    private string? RequestGuid;
    private List<CultureTestListDto>? CultureTabs;
    private CultureTestListDto? ActiveTab;
    private Dictionary<int, CultureSaveRequestDto> TabStates = new();
    private CultureSaveRequestDto? ActiveData => ActiveTab != null && ActiveTab.tcode.HasValue && TabStates.ContainsKey(ActiveTab.tcode.Value) ? TabStates[ActiveTab.tcode.Value] : null;
    private bool IsAuthorized => 
        ActiveTab?.isauthorized == true || 
        ActiveData?.culture?.isauthorized == true ||
        (ActiveTab?.reportstatus ?? "").Equals("Final Report", StringComparison.OrdinalIgnoreCase) ||
        (ActiveData?.culture?.reportstatus ?? "").Equals("Final Report", StringComparison.OrdinalIgnoreCase) ||
        (ActiveTab?.statuslabel ?? "").Equals("Authorized", StringComparison.OrdinalIgnoreCase) ||
        (ActiveTab?.statuslabel ?? "").Equals("Final", StringComparison.OrdinalIgnoreCase);

    private bool IsTabAuthorized(CultureTestListDto tab)
    {
        if (tab == null) return false;
        
        // 1. Check local state cache
        if (tab.tcode.HasValue && TabStates.TryGetValue(tab.tcode.Value, out var savedState))
        {
            if (savedState?.culture?.isauthorized == true ||
                (savedState?.culture?.reportstatus ?? "").Equals("Final Report", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }
        
        // 2. Check tab properties from DB
        return tab.isauthorized == true ||
               (tab.reportstatus ?? "").Equals("Final Report", StringComparison.OrdinalIgnoreCase) ||
               (tab.statuslabel ?? "").Equals("Authorized", StringComparison.OrdinalIgnoreCase) ||
               (tab.statuslabel ?? "").Equals("Final", StringComparison.OrdinalIgnoreCase);
    }
    private CultureBasicInfoDto? PatientInfo;
    private int? UserGCode;
    private string? UserRole;

    private string? LoggedInUserName;
    private int? LoggedInUserCode;
    private Dictionary<int, string> TabEnteredByNames = new();
    private Dictionary<int, string> TabAuthorizedByNames = new();

    private string EnteredByName => 
        ActiveTab != null && ActiveTab.tcode.HasValue && TabEnteredByNames.TryGetValue(ActiveTab.tcode.Value, out var val) && !string.IsNullOrEmpty(val)
            ? val
            : (!string.IsNullOrEmpty(LoggedInUserName) ? LoggedInUserName : "Admin");

    private string AuthorizedByName =>
        IsAuthorized
            ? (ActiveTab != null && ActiveTab.tcode.HasValue && TabAuthorizedByNames.TryGetValue(ActiveTab.tcode.Value, out var val) && !string.IsNullOrEmpty(val)
                ? val
                : (!string.IsNullOrEmpty(LoggedInUserName) ? LoggedInUserName : "Authorized User"))
            : "--";

    private string? errorMessage;
    private bool isSaving = false;
    private bool isPrintingCulture = false;
    private bool isPreviewingCulture = false;

    /// <summary>
    /// Prints the culture report by calling the external LabCare API directly.
    /// The API returns a base64-encoded PDF which is opened in a new browser tab via JS.
    /// </summary>
    private async Task PrintCultureReportExternal()
    {
        if (string.IsNullOrEmpty(RequestGuid)) return;

        try
        {
            isPrintingCulture = true;
            StateHasChanged();

            string endpoint = $"{BaseUrl}report/culture-report?requestguid={RequestGuid}";

            using var client = CreateClient();
            var resp = await client.GetAsync(endpoint);

            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                errorMessage = $"Print failed: {err}";
                StateHasChanged();
                return;
            }

            var raw = await resp.Content.ReadAsStringAsync();
            var base64 = raw.Trim().Trim('"');
            await JSRuntime.InvokeVoidAsync("openBase64Pdf", base64);
        }
        catch (Exception ex)
        {
            errorMessage = $"Print error: {ex.Message}";
        }
        finally
        {
            isPrintingCulture = false;
            StateHasChanged();
        }
    }

