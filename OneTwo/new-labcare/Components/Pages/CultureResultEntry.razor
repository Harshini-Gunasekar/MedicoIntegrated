    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("requestguid", out var guid))
        {
            RequestGuid = guid;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadSessionAsync();
            await LoadMasterDataAsync();
            if (!string.IsNullOrEmpty(RequestGuid))
            {
                await LoadPatientInfoAsync();
                await LoadTabsAsync();
            }
            else
            {
                errorMessage = "Request GUID is missing in the URL.";
            }
            StateHasChanged();
        }
    }

