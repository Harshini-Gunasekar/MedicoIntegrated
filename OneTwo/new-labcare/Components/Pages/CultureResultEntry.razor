    private async Task SaveAllAsync()
    {
        if (IsAuthorized && IsAuthorizeDisabled())
        {
            errorMessage = "Only the authorized person can save or alter authorized details.";
            return;
        }

        isSaving = true;
        errorMessage = null;
        try
        {
            using var client = CreateClient();
            var tabStatesList = TabStates.Values.ToList();
            
            // Inject GUIDs and Tenant codes in the local objects first so they are consistent
            foreach(var item in tabStatesList)
            {
                if (!item.culture.resultcultureguid.HasValue || item.culture.resultcultureguid == Guid.Empty)
                {
                    item.culture.resultcultureguid = Guid.NewGuid();
                }

                item.culture.tenant_code = TenantCode;
                item.culture.usercode = (TenantState.UserCode > 0) ? TenantState.UserCode : (LoggedInUserCode ?? UserGCode ?? 1);
                item.culture.computercode = 1;
                item.culture.resultenteredby = (TenantState.UserCode > 0) ? TenantState.UserCode : (LoggedInUserCode ?? UserGCode ?? 1);
                if (item.isolationRows != null)
                {
                    foreach(var row in item.isolationRows)
                    {
                        if (row.lcdiiid == Guid.Empty)
                        {
                            row.lcdiiid = Guid.NewGuid();
                        }
                        row.resultcultureguid = item.culture.resultcultureguid;
                        row.tenant_code = TenantCode;
                        row.tcode = item.tcode;
                    }
                }
            }

            // Project to exact JSON format requested by the user
            var formattedPayload = tabStatesList.Select(item => {
                var cultureName = CultureTabs?.FirstOrDefault(t => t.tcode == item.tcode)?.testname 
                    ?? (item.tcode == 234 ? "Blood Culture" : (item.tcode == 230 ? "Urine Culture" : "Culture"));
                
                bool isisolationa = !string.IsNullOrEmpty(item.culture.organismsgrown);
                bool isisolationb = !string.IsNullOrEmpty(item.culture.organismsgrownb);
                bool isisolationc = !string.IsNullOrEmpty(item.culture.organismsgrownc);

                string? bacteria = item.culture.organismsgrown;
                string? resultsms = item.culture.resultsms;
                if (string.IsNullOrEmpty(resultsms) && item.culture.isgrowth == true && !string.IsNullOrEmpty(bacteria))
                {
                    resultsms = $"Growth of {bacteria}";
                }

                var rows = new List<object>();
                if (item.isolationRows != null)
                {
                    int index = 1;
                    foreach(var row in item.isolationRows)
                    {
                        rows.Add(new {
                            tcode = item.tcode,
                            columnname = row.columnname,
                            actualsno = index,
                            sno = index,
                            abcode = row.abcode,
                            isolation_a = row.isolation_a,
                            isolation_b = row.isolation_b,
                            isolation_c = row.isolation_c,
                            diskcontenta = row.diskcontenta,
                            diskcontentb = row.diskcontentb,
                            diskcontentc = row.diskcontentc,
                            mma1 = row.mma1,
                            mma2 = row.mma2,
                            mma3 = row.mma3,
                            reportstatus = item.culture.reportstatus
                        });
                        index++;
                    }
                }

                return new {
                    tcode = item.tcode,
                    resultenteredby = (TenantState.UserCode > 0) ? TenantState.UserCode : (LoggedInUserCode ?? UserGCode ?? 1),
                    usercode = (TenantState.UserCode > 0) ? TenantState.UserCode : (LoggedInUserCode ?? UserGCode ?? 1),
                    UserCode = (TenantState.UserCode > 0) ? TenantState.UserCode : (LoggedInUserCode ?? UserGCode ?? 1),
                    culture = new {
                        resultcultureguid = item.culture.resultcultureguid == Guid.Empty ? null : item.culture.resultcultureguid,
                        requestguid = item.culture.requestguid,
                        recode = item.culture.recode.HasValue ? (int)item.culture.recode.Value : 1,
                        reportstatus = item.culture.reportstatus,
                        isgrowth = item.culture.isgrowth ?? false,
                        rtmcode = item.culture.rtmcode ?? 1,
                        reportingmethod = string.IsNullOrEmpty(item.culture.reportingmethod) ? "Standard" : item.culture.reportingmethod,
                        sample = item.culture.sample,
                        growthgrade = item.culture.growthgrade,
                        smearafb = item.culture.smearafb,
                        puscells = item.culture.puscells,
                        gramsstaining = item.culture.gramsstaining,
                        diagnosis = item.culture.diagnosis,
                        samplereceiveddate = item.culture.samplereceiveddate?.ToString("yyyy-MM-ddTHH:mm:ss"),
                        culturereporteddate = item.culture.culturereporteddate?.ToString("yyyy-MM-ddTHH:mm:ss"),
                        cfcode = item.culture.cfcode ?? 1,
                        footertext = string.IsNullOrEmpty(item.culture.footertext) ? "Report reviewed by microbiologist" : item.culture.footertext,
                        description = cultureName,
                        bacteria = bacteria,
                        comments = item.culture.comments,
                        organismsgrown = item.culture.organismsgrown,
                        organismsgrownb = item.culture.organismsgrownb,
                        organismsgrownc = item.culture.organismsgrownc,
                        isisolationa = isisolationa,
                        isisolationb = isisolationb,
                        isisolationc = isisolationc,
                        colonycount = item.culture.colonycount,
                        colonycountb = item.culture.colonycountb,
                        colonycountc = item.culture.colonycountc,
                        commentsa = item.culture.commentsa,
                        commentsb = item.culture.commentsb,
                        commentsc = item.culture.commentsc,
                        resultsms = resultsms,
                        resultenteredby = (TenantState.UserCode > 0) ? TenantState.UserCode : (LoggedInUserCode),
                        usercode = (TenantState.UserCode > 0) ? TenantState.UserCode : (LoggedInUserCode),
                        computercode = item.culture.computercode ?? 1
                    },
                    isolationRows = rows
                };
            }).ToList();

            var json = JsonConvert.SerializeObject(formattedPayload, Formatting.Indented);
            /* Console.WriteLine("--- CULTURE SAVE PAYLOAD ---") */;
            /* Console.WriteLine(json) */;
            /* await JSRuntime.InvokeVoidAsync("console.log", "--- CULTURE SAVE PAYLOAD ---", json) */;

            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await client.PostAsync($"{BaseUrl}Culture/save", content);
            if (response.IsSuccessStatusCode)
            {
                int? currentTCode = ActiveTab?.tcode;
                if (currentTCode.HasValue && !string.IsNullOrEmpty(LoggedInUserName))
                {
                    TabEnteredByNames[currentTCode.Value] = LoggedInUserName;
                }
                TabStates.Clear(); // Clear local cache to force re-fetch of hydrated DB state on next select
                await JSRuntime.InvokeVoidAsync("alert", "Results saved successfully!");
                await LoadTabsAsync(currentTCode); // Refresh tab list preserving active tab
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"Save failed: {error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task AuthorizeAsync()
    {
        if (ActiveTab == null || !ActiveTab.resultcultureguid.HasValue) return;
        
        try
        {
            using var client = CreateClient();
            var req = new AuthorizeCultureDto
            {
                resultcultureguid = ActiveTab.resultcultureguid.Value,
                authorizedby = (TenantState.UserCode > 0) ? TenantState.UserCode : (LoggedInUserCode ?? UserGCode ?? 1),
                reportstatus = "Final Report"
            };
            
            var reqJson = JsonConvert.SerializeObject(req, Formatting.Indented);
            /* Console.WriteLine("--- CULTURE AUTHORIZE PAYLOAD ---") */;
            /* Console.WriteLine(reqJson) */;
            /* await JSRuntime.InvokeVoidAsync("console.log", "--- CULTURE AUTHORIZE PAYLOAD ---", reqJson) */;
            
            var response = await client.PostAsJsonAsync($"{BaseUrl}culture/authorize?requestGuid={RequestGuid}", req);
            if (response.IsSuccessStatusCode)
            {
                int? currentTCode = ActiveTab?.tcode;
                if (currentTCode.HasValue && !string.IsNullOrEmpty(LoggedInUserName))
                {
                    TabAuthorizedByNames[currentTCode.Value] = LoggedInUserName;
                }
                TabStates.Clear(); // Clear local cache to force re-fetch
                await JSRuntime.InvokeVoidAsync("alert", "Result authorized!");
                await LoadTabsAsync(currentTCode);
            }
            else
            {
                errorMessage = "Authorization failed.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task RevokeAsync()
    {
        if (ActiveTab == null || !ActiveTab.resultcultureguid.HasValue) return;

        if (IsAuthorized && IsAuthorizeDisabled())
        {
            errorMessage = "Only the authorized person can revoke or alter authorized details.";
            return;
        }

        try
        {
            using var client = CreateClient();
            var response = await client.PostAsync($"{BaseUrl}culture/revoke?resultcultureguid={ActiveTab.resultcultureguid.Value}&requestGuid={RequestGuid}", null);
            if (response.IsSuccessStatusCode)
            {
                int? currentTCode = ActiveTab?.tcode;
                if (currentTCode.HasValue)
                {
                    TabAuthorizedByNames.Remove(currentTCode.Value);
                }
                TabStates.Clear(); // Clear local cache to force re-fetch
                await JSRuntime.InvokeVoidAsync("alert", "Result deleted successfully!");
                await LoadTabsAsync(currentTCode);
            }
            else
            {
                errorMessage = "Delete failed.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    // --- Master Data & Drag Drop Logic ---
    private List<AntibioticsGroupModel> AvailableAntibiotics = new();
    private List<CultureOrganismModel> AvailableOrganisms = new();
    private string SearchAntibiotic = "";
    private string ActiveSection = "A"; // "A", "B", or "C"
    private AntibioticsGroupModel? draggedAntibiotic;
    private bool isDragging = false;
    private string activeDragZone = "";

    private async Task LoadMasterDataAsync()
    {
        try
        {
            using var client = CreateClient();
            var abResponse = await client.GetAsync($"{BaseUrl}AntibioticsGroupMaster/get");
            if (abResponse.IsSuccessStatusCode)
            {
                AvailableAntibiotics = await abResponse.Content.ReadFromJsonAsync<List<AntibioticsGroupModel>>() ?? new();
            }

            var orgResponse = await client.GetAsync($"{BaseUrl}CultureOrganism/get");
            if (orgResponse.IsSuccessStatusCode)
            {
                AvailableOrganisms = await orgResponse.Content.ReadFromJsonAsync<List<CultureOrganismModel>>() ?? new();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading master data: {ex.Message}") */;
        }
    }

    private void OnDragStart(AntibioticsGroupModel ab)
    {
        draggedAntibiotic = ab;
        isDragging = true;
        activeDragZone = "";
    }

    private void OnDragEnd()
    {
        isDragging = false;
        activeDragZone = "";
        StateHasChanged();
    }

    private void OnDropWithSensitivity(string sensitivity)
    {
        if (draggedAntibiotic == null || ActiveData == null) return;
        
        if (ActiveData.isolationRows == null) ActiveData.isolationRows = new();
        
        var row = ActiveData.isolationRows.FirstOrDefault(r => r.columnname == draggedAntibiotic.name);
        if (row == null)
        {
            row = new CultureIsolationRowDto 
            { 
                tcode = ActiveTab?.tcode ?? 0,
                sno = ActiveData.isolationRows.Count + 1,
                reportstatus = ActiveData.culture.reportstatus,
                tenant_code = TenantCode,
                columnname = draggedAntibiotic.name,
                abcode = (int)draggedAntibiotic.abgcode
            };
            ActiveData.isolationRows.Add(row);
        }

        if (ActiveSection == "A") { row.isolation_a = sensitivity; }
        if (ActiveSection == "B") { row.isolation_b = sensitivity; }
        if (ActiveSection == "C") { row.isolation_c = sensitivity; }

        draggedAntibiotic = null;
        isDragging = false;
        activeDragZone = "";
        StateHasChanged();
    }

    private void OnDrop()
    {
        if (draggedAntibiotic == null || ActiveData == null) return;
        
        if (ActiveData.isolationRows == null) ActiveData.isolationRows = new();
        
        var row = ActiveData.isolationRows.FirstOrDefault(r => r.columnname == draggedAntibiotic.name);
        if (row == null)
        {
            row = new CultureIsolationRowDto 
            { 
                tcode = ActiveTab?.tcode ?? 0,
                sno = ActiveData.isolationRows.Count + 1,
                reportstatus = ActiveData.culture.reportstatus,
                tenant_code = TenantCode,
                columnname = draggedAntibiotic.name,
                abcode = (int)draggedAntibiotic.abgcode
            };
            ActiveData.isolationRows.Add(row);
        }

        if (ActiveSection == "A" && string.IsNullOrEmpty(row.isolation_a)) row.isolation_a = "S";
        if (ActiveSection == "B" && string.IsNullOrEmpty(row.isolation_b)) row.isolation_b = "S";
        if (ActiveSection == "C" && string.IsNullOrEmpty(row.isolation_c)) row.isolation_c = "S";

        draggedAntibiotic = null;
        StateHasChanged();
    }

    private void ToggleSensitivity(CultureIsolationRowDto row)
    {
        if (ActiveSection == "A") row.isolation_a = NextSens(row.isolation_a);
        if (ActiveSection == "B") row.isolation_b = NextSens(row.isolation_b);
        if (ActiveSection == "C") row.isolation_c = NextSens(row.isolation_c);
    }

    private string NextSens(string? current)
    {
        if (current == "S") return "I";
        if (current == "I") return "R";
        return "S";
    }

    private void RemoveAntibiotic(CultureIsolationRowDto row)
    {
        if (ActiveSection == "A") { row.isolation_a = null; row.diskcontenta = null; row.mma1 = null; }
        if (ActiveSection == "B") { row.isolation_b = null; row.diskcontentb = null; row.mma2 = null; }
        if (ActiveSection == "C") { row.isolation_c = null; row.diskcontentc = null; row.mma3 = null; }
        
        if (string.IsNullOrEmpty(row.isolation_a) && string.IsNullOrEmpty(row.isolation_b) && string.IsNullOrEmpty(row.isolation_c))
        {
            ActiveData?.isolationRows?.Remove(row);
        }
    }
