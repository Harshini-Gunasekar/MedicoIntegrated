    private async Task SaveContainer()
    {
        System.IO.File.AppendAllText("api_logs.txt", $"=== [SaveContainer] Entered at {DateTime.Now} ===\n" +
            $"Name: '{formData?.ContainerMaster?.container_name}'\n" +
            $"LinkedTests Count: {linkedTestsList?.Count ?? 0}\n");

        if (string.IsNullOrWhiteSpace(formData.ContainerMaster.container_name))
        {
            System.IO.File.AppendAllText("api_logs.txt", "Exit early: Container Name is empty\n");
            Toast.Error("Container Name is required.");
            return;
        }

        try
        {
            isSaving = true;
            StateHasChanged();
            
            bool isNew = (formData.ContainerMaster.container_id ?? 0) == 0;
            string endpoint = isNew ? "ContainerMaster/insert" : "ContainerMaster/update";
            
            using var client = CreateClient();
            
            // Update created dates and status dates
            var cm = formData.ContainerMaster;
            if (isNew)
            {
                cm.created_at = DateTime.Now;
            }
            cm.ibsdate = DateTime.Now;
            
            using var content = new MultipartFormDataContent();
            
            // 1. Add image file if selected
            if (selectedPhoto != null)
            {
                var fileContent = new StreamContent(selectedPhoto.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5));
                content.Add(fileContent, "containerImageFile", selectedPhoto.Name);
            }
            
            // 2. Add ContainerMaster properties
            content.Add(new StringContent(cm.container_id?.ToString() ?? "0"), "ContainerMaster.container_id");
            content.Add(new StringContent(cm.tenant_code ?? tenantCode), "ContainerMaster.tenant_code");
            content.Add(new StringContent(cm.container_code ?? ""), "ContainerMaster.container_code");
            content.Add(new StringContent(cm.container_name ?? ""), "ContainerMaster.container_name");
            content.Add(new StringContent(cm.cap_color ?? ""), "ContainerMaster.cap_color");
            content.Add(new StringContent(cm.additive ?? ""), "ContainerMaster.additive");
            content.Add(new StringContent(cm.sample_type ?? ""), "ContainerMaster.sample_type");
            content.Add(new StringContent(cm.min_volume_ml?.ToString() ?? ""), "ContainerMaster.min_volume_ml");
            content.Add(new StringContent(cm.description ?? ""), "ContainerMaster.description");
            content.Add(new StringContent(cm.container_image ?? ""), "ContainerMaster.container_image");
            content.Add(new StringContent((cm.is_active ?? true).ToString().ToLower()), "ContainerMaster.is_active");
            content.Add(new StringContent(cm.created_at?.ToString("yyyy-MM-ddTHH:mm:ssZ") ?? ""), "ContainerMaster.created_at");
            content.Add(new StringContent(cm.ibsdate?.ToString("yyyy-MM-ddTHH:mm:ssZ") ?? ""), "ContainerMaster.ibsdate");

            // Flat bindings for APIs that expect model properties at root level
            content.Add(new StringContent(cm.container_id?.ToString() ?? "0"), "container_id");
            content.Add(new StringContent(cm.tenant_code ?? tenantCode), "tenant_code");
            content.Add(new StringContent(cm.container_code ?? ""), "container_code");
            content.Add(new StringContent(cm.container_name ?? ""), "container_name");
            content.Add(new StringContent(cm.cap_color ?? ""), "cap_color");
            content.Add(new StringContent(cm.additive ?? ""), "additive");
            content.Add(new StringContent(cm.sample_type ?? ""), "sample_type");
            content.Add(new StringContent(cm.min_volume_ml?.ToString() ?? ""), "min_volume_ml");
            content.Add(new StringContent(cm.description ?? ""), "description");
            content.Add(new StringContent(cm.container_image ?? ""), "container_image");
            content.Add(new StringContent((cm.is_active ?? true).ToString().ToLower()), "is_active");
            content.Add(new StringContent(cm.created_at?.ToString("yyyy-MM-ddTHH:mm:ssZ") ?? ""), "created_at");
            content.Add(new StringContent(cm.ibsdate?.ToString("yyyy-MM-ddTHH:mm:ssZ") ?? ""), "ibsdate");
            
            // 3. Add ContainerDetails list properties
            if (formData.ContainerDetails != null)
            {
                for (int i = 0; i < formData.ContainerDetails.Count; i++)
                {
                    var detail = formData.ContainerDetails[i];
                    content.Add(new StringContent(detail.cd_id?.ToString() ?? "0"), $"ContainerDetails[{i}].cd_id");
                    content.Add(new StringContent((detail.container_id == 0 ? cm.container_id : detail.container_id)?.ToString() ?? "0"), $"ContainerDetails[{i}].container_id");
                    content.Add(new StringContent(detail.tenant_code ?? tenantCode), $"ContainerDetails[{i}].tenant_code");
                    content.Add(new StringContent(detail.entereddate?.ToString("yyyy-MM-ddTHH:mm:ss.fffZ") ?? ""), $"ContainerDetails[{i}].entereddate");
                    content.Add(new StringContent(detail.ibsdate?.ToString("yyyy-MM-ddTHH:mm:ss.fffZ") ?? ""), $"ContainerDetails[{i}].ibsdate");
                    content.Add(new StringContent(detail.usercode?.ToString() ?? "99"), $"ContainerDetails[{i}].usercode");
                    
                    if (detail.tcode != null)
                    {
                        for (int j = 0; j < detail.tcode.Length; j++)
                        {
                            content.Add(new StringContent(detail.tcode[j].ToString()), $"ContainerDetails[{i}].tcode[{j}]");
                        }
                    }
                    
                    if (detail.sampleid != null)
                    {
                        for (int j = 0; j < detail.sampleid.Length; j++)
                        {
                            content.Add(new StringContent(detail.sampleid[j].ToString()), $"ContainerDetails[{i}].sampleid[{j}]");
                        }
                    }
                }
            }
            
            // 4. Log local payload for reference
            var serializedDto = JsonConvert.SerializeObject(formData);
            /* Console.WriteLine($"Container Master Insert JSON Payload: {serializedDto}") */;
            System.IO.File.AppendAllText("api_logs.txt", $"Payload to serialize: {serializedDto}\n");
            
            var res = await client.PostAsync($"{AppSettings.BaseUrl}{endpoint}", content);
            System.IO.File.AppendAllText("api_logs.txt", $"Response status: {res.StatusCode}\n");
            
            if (res.IsSuccessStatusCode)
            {
                System.IO.File.AppendAllText("api_logs.txt", "Success!\n");
                Toast.Success(isNew ? "Container created successfully." : "Container updated successfully.");
                
                selectedPhoto = null;
                previewImageBase64 = "";
                
                await LoadContainers();
                
                // Select newly saved container
                var newlySaved = allContainers.FirstOrDefault(c => c.container_name == cm.container_name);
                if (newlySaved != null)
                {
                    if (newlySaved.container_id.HasValue)
                    {
                        containerImagesBase64.Remove(newlySaved.container_id.Value);
                    }
                    await SelectContainer(newlySaved);
                }
                else
                {
                    AddNew();
                }
            }
            else
            {
                var body = await res.Content.ReadAsStringAsync();
                /* Console.WriteLine($"Save Container API Failed (400 Bad Request): {body}") */;
                System.IO.File.AppendAllText("api_logs.txt", $"Failed body: {body}\n");
                Toast.Error($"Failed to save: {body}");
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error saving container: {ex.Message}") */;
            System.IO.File.AppendAllText("api_logs.txt", $"Exception: {ex}\n");
            Toast.Error($"Error occurred while saving container: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task DeleteContainer()
    {
        if (formData.ContainerMaster.container_id > 0)
        {
            try
            {
                using var client = CreateClient();
                var res = await client.DeleteAsync($"{AppSettings.BaseUrl}ContainerMaster/softdelete?container_id={formData.ContainerMaster.container_id}");
                if (res.IsSuccessStatusCode)
                {
                    Toast.Success("Container deleted successfully.");
                    await LoadContainers();
                    
                    if (allContainers.Any())
                    {
                        await SelectContainer(allContainers.First());
                    }
                    else
                    {
                        AddNew();
                    }
                }
                else
                {
                    var body = await res.Content.ReadAsStringAsync();
                    Toast.Error($"Failed to delete container: {body}");
                }
            }
            catch (Exception ex)
            {
                /* Console.WriteLine($"Error deleting container: {ex.Message}") */;
                Toast.Error($"Error occurred while deleting: {ex.Message}");
            }
        }
    }

