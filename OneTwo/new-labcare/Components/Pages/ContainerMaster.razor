@code {


    private List<LabCare.Models.ContainerMaster> allContainers = new();
    private List<LabCare.Models.ContainerMaster> filteredContainers => allContainers
        .Where(c => string.IsNullOrEmpty(searchTerm) || 
                   (c.container_name != null && c.container_name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                   (c.container_code != null && c.container_code.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                   (c.cap_color != null && c.cap_color.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
        .ToList();
        
    private LabCare.Models.ContainerMaster? selectedContainer;
    private ContainerInsertDto formData = new ContainerInsertDto();
    
    private string searchTerm = "";
    private bool isLoading = true;
    private bool isSaving = false;
    private string token = "";
    private string tenantCode = "";

    // Image handling fields
    private IBrowserFile? selectedPhoto;
    private string previewImageBase64 = "";
    private Dictionary<int, string> containerImagesBase64 = new();

    // Linked Tests configuration fields
    private List<test_master> allTestsList = new();
    private List<test_master> linkedTestsList = new();
    private List<SampleModel> allSpecimensList = new();
    private test_master? selectedTest;
    private string testSearchQuery = "";

    private IEnumerable<test_master> filteredAvailableTests => allTestsList
        .Where(t => !linkedTestsList.Any(l => l.tcode == t.tcode))
        .Where(t => string.IsNullOrWhiteSpace(testSearchQuery) || 
                   (t.name != null && t.name.Contains(testSearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                   t.tcode.ToString().Contains(testSearchQuery))
        .Take(12);



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                tenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                token = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(token))
                {
                    // Ensure the global state container is updated so HttpClient headers are injected
                    TenantState.SetSession(tenantCode, token);

                    await LoadContainers();
                    await LoadAllTests();
                    await LoadAllSpecimens();
                    
                    // Select first container by default or initiate blank
                    if (allContainers.Any())
                    {
                        await SelectContainer(allContainers.First());
                    }
                    else
                    {
                        AddNew();
                    }
                    
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                /* Console.WriteLine($"Error getting tenant data: {ex.Message}") */;
            }
        }
    }

    private void ConfigureHeaders(HttpRequestMessage request)
    {
        if (!string.IsNullOrEmpty(token))
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        if (!string.IsNullOrEmpty(tenantCode))
            request.Headers.Add("tenant_code", tenantCode);
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(tenantCode))
        {
            if (client.DefaultRequestHeaders.Contains("tenant_code"))
                client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Add("tenant_code", tenantCode);
        }
        if (!string.IsNullOrEmpty(token))
        {
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }
        return client;
    }

    private async Task LoadContainers()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            using var client = CreateClient();
            var res = await client.GetAsync($"{AppSettings.BaseUrl}ContainerMaster/getall");
            if (res.IsSuccessStatusCode)
            {
                var content = await res.Content.ReadAsStringAsync();
                allContainers = JsonConvert.DeserializeObject<List<LabCare.Models.ContainerMaster>>(content) ?? new();
                _ = LoadImagesForContainersAsync(allContainers);
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading containers: {ex.Message}") */;
            Toast.Error("Error loading specimen containers from backend.");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadImagesForContainersAsync(List<LabCare.Models.ContainerMaster> containers)
    {
        foreach (var c in containers)
        {
            if (c.container_id.HasValue && !string.IsNullOrEmpty(c.container_image) && !containerImagesBase64.ContainsKey(c.container_id.Value))
            {
                await FetchAndCacheImageAsync(c.container_id.Value, c.container_image);
            }
        }
    }

    private async Task FetchAndCacheImageAsync(int containerId, string fileName)
    {
        try
        {
            using var client = CreateClient();
            
            string key = fileName;
            if (!fileName.Contains("/"))
            {
                key = $"LabCare/{tenantCode}/containers/{containerId}/container_{fileName}";
            }
            else if (!fileName.StartsWith("LabCare/", StringComparison.OrdinalIgnoreCase))
            {
                key = $"LabCare/{fileName}";
            }
            
            string url = $"{AppSettings.BaseUrl}files/download?key={key}";
            var response = await client.GetAsync(url);
            
            if (response.IsSuccessStatusCode)
            {
                var jsonStr = await response.Content.ReadAsStringAsync();
                var downloadRes = JsonConvert.DeserializeObject<FileDownloadResponse>(jsonStr);
                if (downloadRes != null && !string.IsNullOrEmpty(downloadRes.base64))
                {
                    containerImagesBase64[containerId] = downloadRes.base64;
                    StateHasChanged();
                    return;
                }
            }
            
            // Fallback: if it was a filename and prefixed failed, try without container_ prefix
            if (!fileName.Contains("/"))
            {
                string urlWithoutPrefix = $"{AppSettings.BaseUrl}files/download?key=LabCare/{tenantCode}/containers/{containerId}/{fileName}";
                var response2 = await client.GetAsync(urlWithoutPrefix);
                if (response2.IsSuccessStatusCode)
                {
                    var jsonStr = await response2.Content.ReadAsStringAsync();
                    var downloadRes2 = JsonConvert.DeserializeObject<FileDownloadResponse>(jsonStr);
                    if (downloadRes2 != null && !string.IsNullOrEmpty(downloadRes2.base64))
                    {
                        containerImagesBase64[containerId] = downloadRes2.base64;
                        StateHasChanged();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Failed to load image for container {containerId}: {ex.Message}") */;
        }
    }

    private async Task LoadAllTests()
    {
        try
        {
            // Use injected TestService to fetch all active tests
            allTestsList = await TestService.GetAllTestsAsync();
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading tests: {ex.Message}") */;
        }
    }

    private async Task LoadAllSpecimens()
    {
        try
        {
            allSpecimensList = await TestService.GetSpecimensAsync();
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading specimens: {ex.Message}") */;
        }
    }

    private void AddNew()
    {
        selectedContainer = null;
        formData = new ContainerInsertDto
        {
            ContainerMaster = new LabCare.Models.ContainerMaster
            {
                is_active = true,
                tenant_code = tenantCode
            },
            ContainerDetails = new List<container_details>()
        };
        linkedTestsList.Clear();
        selectedTest = null;
        previewImageBase64 = "";
        selectedPhoto = null;
        testSearchQuery = "";
    }

    private async Task SelectContainer(LabCare.Models.ContainerMaster container)
    {
        selectedContainer = container;
        selectedTest = null;
        previewImageBase64 = "";
        selectedPhoto = null;
        testSearchQuery = "";
        
        if (container.container_id.HasValue && !string.IsNullOrEmpty(container.container_image) && !containerImagesBase64.ContainsKey(container.container_id.Value))
        {
            _ = FetchAndCacheImageAsync(container.container_id.Value, container.container_image);
        }
        
        // Initialize formData with the selected container details (which has name, cap_color, etc. loaded from allContainers)
        formData = new ContainerInsertDto
        {
            ContainerMaster = new LabCare.Models.ContainerMaster
            {
                container_id = container.container_id,
                tenant_code = container.tenant_code ?? tenantCode,
                container_code = container.container_code,
                container_name = container.container_name ?? "",
                cap_color = container.cap_color,
                additive = container.additive,
                sample_type = container.sample_type,
                min_volume_ml = container.min_volume_ml,
                description = container.description,
                container_image = container.container_image,
                is_active = container.is_active ?? true,
                ibsdate = container.ibsdate,
                created_at = container.created_at
            },
            ContainerDetails = new List<container_details>()
        };
        
        try
        {
            isLoading = true;
            StateHasChanged();
            
            using var client = CreateClient();
            var res = await client.GetAsync($"{AppSettings.BaseUrl}ContainerMaster/get?container_id={container.container_id}");
            if (res.IsSuccessStatusCode)
            {
                var content = await res.Content.ReadAsStringAsync();
                List<container_details> detailsList = new List<container_details>();
                
                if (content.Trim().StartsWith("["))
                {
                    if (content.Contains("\"ContainerMaster\"") || content.Contains("\"containerMaster\""))
                    {
                        var list = JsonConvert.DeserializeObject<List<ContainerInsertDto>>(content);
                        if (list != null && list.Any())
                        {
                            var dto = list.First();
                            if (dto.ContainerMaster != null)
                            {
                                formData.ContainerMaster = dto.ContainerMaster;
                            }
                            if (dto.ContainerDetails != null)
                            {
                                detailsList.AddRange(dto.ContainerDetails);
                            }
                        }
                    }
                    else if (content.Contains("\"sampleid\"") || content.Contains("\"tcode\""))
                    {
                        var details = JsonConvert.DeserializeObject<List<container_details>>(content);
                        if (details != null)
                        {
                            detailsList.AddRange(details);
                        }
                    }
                    else
                    {
                        var list = JsonConvert.DeserializeObject<List<ContainerWithTcodes>>(content);
                        if (list != null && list.Any())
                        {
                            var flat = list.First();
                            if (flat.tcode != null && flat.tcode.Any())
                            {
                                detailsList.Add(new container_details
                                {
                                    cd_id = null,
                                    container_id = flat.container_id ?? 0,
                                    tenant_code = flat.tenant_code ?? tenantCode,
                                    tcode = flat.tcode,
                                    sampleid = new int[] { }
                                });
                            }
                        }
                    }
                }
                else
                {
                    if (content.Contains("\"ContainerMaster\"") || content.Contains("\"containerMaster\""))
                    {
                        var dto = JsonConvert.DeserializeObject<ContainerInsertDto>(content);
                        if (dto != null)
                        {
                            if (dto.ContainerMaster != null)
                            {
                                formData.ContainerMaster = dto.ContainerMaster;
                            }
                            if (dto.ContainerDetails != null)
                            {
                                detailsList.AddRange(dto.ContainerDetails);
                            }
                        }
                    }
                    else if (content.Contains("\"sampleid\"") || content.Contains("\"tcode\""))
                    {
                        var detail = JsonConvert.DeserializeObject<container_details>(content);
                        if (detail != null)
                        {
                            detailsList.Add(detail);
                        }
                    }
                    else
                    {
                        var flat = JsonConvert.DeserializeObject<ContainerWithTcodes>(content);
                        if (flat != null && flat.tcode != null && flat.tcode.Any())
                        {
                            detailsList.Add(new container_details
                            {
                                cd_id = null,
                                container_id = flat.container_id ?? 0,
                                tenant_code = flat.tenant_code ?? tenantCode,
                                tcode = flat.tcode,
                                sampleid = new int[] { }
                            });
                        }
                    }
                }
                
                formData.ContainerDetails = detailsList;
                
                // Ensure all loaded details have fallback dates and tenant code
                foreach (var detail in formData.ContainerDetails)
                {
                    detail.tenant_code ??= tenantCode;
                    detail.entereddate ??= DateTimeOffset.Now;
                    detail.ibsdate ??= DateTimeOffset.Now;
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error fetching container details: {ex.Message}") */;
            Toast.Error("Failed to fetch container configuration details.");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

