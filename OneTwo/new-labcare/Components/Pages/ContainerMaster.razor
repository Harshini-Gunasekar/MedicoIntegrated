    private IEnumerable<SampleModel> GetFilteredSamples(container_details detail)
    {
        var q = GetSampleSearchQuery(detail);
        var mapped = detail.sampleid?.ToHashSet() ?? new HashSet<int>();
        
        return allSpecimensList
            .Where(s => !mapped.Contains((int)s.scode))
            .Where(s => string.IsNullOrWhiteSpace(q) || 
                       (s.name != null && s.name.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                       s.scode.ToString().Contains(q))
            .Take(8);
    }

    private IEnumerable<test_master> GetFilteredTests(container_details detail)
    {
        var q = GetTestSearchQuery(detail);
        var mapped = detail.tcode?.ToHashSet() ?? new HashSet<int>();
        
        return allTestsList
            .Where(t => !mapped.Contains((int)t.tcode))
            .Where(t => string.IsNullOrWhiteSpace(q) || 
                       (t.name != null && t.name.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                       t.tcode.ToString().Contains(q))
            .Take(8);
    }

