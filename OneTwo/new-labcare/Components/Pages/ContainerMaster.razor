    private string GetImageUrl(string? fileName, int? containerId = null)
    {
        if (string.IsNullOrEmpty(fileName)) return "";
        string key = fileName;
        if (!fileName.Contains("/"))
        {
            int id = containerId ?? formData.ContainerMaster.container_id ?? 0;
            key = $"LabCare/{tenantCode}/containers/{id}/container_{fileName}";
        }
        else if (!fileName.StartsWith("LabCare/", StringComparison.OrdinalIgnoreCase))
        {
            key = $"LabCare/{fileName}";
        }
        return $"{AppSettings.BaseUrl}files/download?key={key}";
    }

    private string GetCapColorHex(string? colorName)
    {
        if (string.IsNullOrWhiteSpace(colorName)) return "#64748b"; // Slate-500
        
        string name = colorName.Trim().ToLower();
        return name switch
        {
            "red"        => "#ef4444", // Red-500
            "blue"       => "#3b82f6", // Blue-500
            "light blue" => "#06b6d4", // Cyan-500
            "green"      => "#22c55e", // Green-500
            "yellow"     => "#eab308", // Yellow-500
            "purple"     => "#a855f7", // Purple-500
            "lavender"   => "#c084fc", // Lavender-400
            "grey"       => "#64748b", // Slate-500
            "gray"       => "#64748b", // Slate-500
            "black"      => "#1e293b", // Slate-800
            "white"      => "#f1f5f9", // Slate-100
            "pink"       => "#ec4899", // Pink-500
            "gold"       => "#d97706", // Amber-600
            "orange"     => "#f97316", // Orange-500
            _            => colorName  // Fallback to custom CSS value/hex
        };
    }

    private string GetLiquidColorHex(string? capColor)
    {
        if (string.IsNullOrWhiteSpace(capColor)) return "rgba(99, 102, 241, 0.15)";
        
        try
        {
            var hex = GetCapColorHex(capColor);
            if (hex.StartsWith("#") && hex.Length == 7)
            {
                int r = Convert.ToInt32(hex.Substring(1, 2), 16);
                int g = Convert.ToInt32(hex.Substring(3, 2), 16);
                int b = Convert.ToInt32(hex.Substring(5, 2), 16);
                return $"rgba({r}, {g}, {b}, 0.15)";
            }
        }
        catch { }
        
        return "rgba(99, 102, 241, 0.15)";
    }

    private string GetMimeType(string? fileName)
    {
        if (string.IsNullOrEmpty(fileName)) return "image/png";
        string ext = System.IO.Path.GetExtension(fileName).ToLower();
        return ext switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".webp" => "image/webp",
            ".gif" => "image/gif",
            _ => "image/png"
        };
    }

