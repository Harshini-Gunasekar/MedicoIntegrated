    private async Task ExecuteFilter()
    {
        try
        {
            using var client = CreateClient();
            string? reqType = currentType.ToString().ToLower();
            if (currentType == DueCollectionType.Patient && string.IsNullOrWhiteSpace(SearchPatient)) reqType = null;
            if (currentType == DueCollectionType.Referral && string.IsNullOrWhiteSpace(SearchDoctor)) reqType = null;
            if (currentType == DueCollectionType.Bill && string.IsNullOrWhiteSpace(SearchSampleId) && string.IsNullOrWhiteSpace(SearchBillNo)) reqType = null;
            if (currentType == DueCollectionType.Monthly && string.IsNullOrWhiteSpace(SearchMonthly)) reqType = null;

            var req = new DueCollectionFilterDto
            {
                type = reqType,
                sampleid = string.IsNullOrWhiteSpace(SearchSampleId) ? null : SearchSampleId,
                billno = string.IsNullOrWhiteSpace(SearchBillNo) ? null : SearchBillNo,
                patient = string.IsNullOrWhiteSpace(SearchPatient) ? null : SearchPatient,
                referral_name = string.IsNullOrWhiteSpace(SearchDoctor) ? null : SearchDoctor,
                fromdate = SearchFrom,
                todate = SearchTo == null ? null : SearchTo.Value.Date.AddHours(23).AddMinutes(59).AddSeconds(59),
                page = 1,
                pagesize = 10000
            };
            
            int bhCodeParsedValue = 0;
            int yearParsedValue = 0;
            
            if (int.TryParse(SearchBranch, out bhCodeParsedValue))
            {
                req.bhcode = bhCodeParsedValue;
            }
            if (int.TryParse(SearchYear, out yearParsedValue)) req.year = yearParsedValue;
            
            if (long.TryParse(Counter, out long counterCodeParsed))
            {
                req.cntcode = counterCodeParsed;
            }

            var settings = new JsonSerializerSettings 
            { 
                NullValueHandling = NullValueHandling.Ignore 
            };
            var payloadJson = JsonConvert.SerializeObject(req, settings);
            debugPayload = payloadJson;
            /* Console.WriteLine("DEBUG API REQUEST PAYLOAD: " + payloadJson) */;

            var httpContent = new StringContent(payloadJson, System.Text.Encoding.UTF8, "application/json");
            var response = await client.PostAsync($"{BaseUrl}DueCollection/filter", httpContent);
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                /* Console.WriteLine("DEBUG API RESPONSE: " + content) */;
                debugPayload += "\n\nAPI RESPONSE: " + (content.Length > 500 ? content.Substring(0, 500) + "..." : content);
                
                try
                {
                    var result = JsonConvert.DeserializeObject<DueCollectionResultDto>(content);
                    Trailers.Clear();
                    if (result != null && result?.data != null)
                    {
                        Trailers = result.data.OrderBy(d => d.requestdatetime).Select(d => new DueCollectionUIItem { Row = d }).ToList();
                        TotalRecords = Trailers.Count;
                        TotalPages = TotalRecords > 0 ? (int)Math.Ceiling((double)TotalRecords / PageSize) : 1;
                        
                        GrandBillCount = TotalRecords;
                        GrandTotalBalance = Trailers.Sum(t => t.Row.curr_balance);
                    }
                    else
                    {
                        TotalRecords = 0;
                        TotalPages = 1;
                        GrandBillCount = 0;
                        GrandTotalBalance = 0;
                    }
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    /* Console.WriteLine("Deserialization error: " + ex.Message) */;
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error filtering dues: {ex.Message}") */;
        }
        StateHasChanged();
    }

