    private bool IsAutoSelectEnabled()
    {
        if (currentType == DueCollectionType.Bill) return false;
        if (!Trailers.Any()) return false;
        
        if (currentType == DueCollectionType.Patient)
            return !string.IsNullOrWhiteSpace(SearchPatient);
            
        if (currentType == DueCollectionType.Referral)
            return !string.IsNullOrWhiteSpace(SearchDoctor);
            
        if (currentType == DueCollectionType.Monthly)
            return !string.IsNullOrWhiteSpace(SearchMonthly);
            
        return false;
    }
    
    private void AutoSelectDues()
    {
        if (Amount == null || Amount <= 0 || !Trailers.Any())
            return;

        double remaining = Amount.Value;

        foreach (var t in Trailers)
        {
            if (remaining > 0)
            {
                if (remaining >= t.Row.curr_balance)
                {
                    t.amount = t.Row.curr_balance;
                    remaining -= t.Row.curr_balance;
                }
                else
                {
                    t.amount = remaining;
                    remaining = 0;
                }

                t.isSelected = t.amount > 0;
            }
            else
            {
                t.amount = null;
                t.isSelected = false;
            }
        }
        
        StateHasChanged();
    }
