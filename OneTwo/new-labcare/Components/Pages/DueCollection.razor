        currentType = type;
        if (type == DueCollectionType.Bill)
        {
            Amount = null; // Clear amount as it is only for patient/referral/monthly
        }
    }



    private async Task SaveCollection()
    {
        if (_isSaving) return;
        
        if (string.IsNullOrEmpty(TenantCode))
        {
            errorMessage = "Error: Tenant code is missing.";
            return;
        }

        if (string.IsNullOrEmpty(PayMode))
        {
            errorMessage = "Please select a Pay Mode before saving.";
            return;
        }

        _isSaving = true;
        try
        {
            errorMessage = null;

            // Preparation of payload and saving logic intentionally removed
            // as user states no DueCollectionRequest/Header is needed.
            /*
            var requestPayload = new DueCollectionRequest
            {
            ...
            */
            using var client = CreateClient();
            
            int? selectedPmCode = null;
            var selectedPmObj = _paymodes.FirstOrDefault(p => (p["name"]?.ToString() ?? p["payModeName"]?.ToString() ?? p["paymode"]?.ToString() ?? p["paymodename"]?.ToString() ?? p["description"]?.ToString()) == PayMode);
            if (selectedPmObj != null)
            {
                if (int.TryParse(selectedPmObj["pmcode"]?.ToString() ?? selectedPmObj["id"]?.ToString() ?? "", out int code))
                    selectedPmCode = code;
            }
            
            var req = new SaveDueCollectionDto
            {
                collection_type = PayMode,
                pmcode = selectedPmCode,
                bankname = PayMode.Contains("Cheque", StringComparison.OrdinalIgnoreCase) ? BankName : null,
                chequeno = PayMode.Contains("Cheque", StringComparison.OrdinalIgnoreCase) ? ChequeNo : null,
                chequedate = PayMode.Contains("Cheque", StringComparison.OrdinalIgnoreCase) ? ChequeDate : null,
                items = Trailers.Where(t => t.isSelected && (t.amount > 0 || t.concession > 0))
                    .GroupBy(t => t.Row.requestguid).Select(g => g.First())
                    .Select(t => new SaveDueCollectionItemDto
                    {
                        requestguid = t.Row.requestguid,
                        collected_amount = t.amount ?? 0,
                        concession_amount = t.concession ?? 0
                    }).ToList()
            };

            var response = await client.PostAsJsonAsync($"{BaseUrl}DueCollection/save", req);

            if (response.IsSuccessStatusCode)
            {
                errorMessage = "Due collection saved successfully!";
                Amount = null;
                BankName = null;
                ChequeNo = null;
                ChequeDate = null;
                await ExecuteFilter();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                errorMessage = $"Save failed ({response.StatusCode}): {errorBody}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task HandlePageSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString() ?? "10", out int newPageSize))
        {
            PageSize = newPageSize;
            if (PageSize < 1) PageSize = 1;
            if (PageSize > 100) PageSize = 100;
            CurrentPage = 1;
            OnPageSizeChanged();
        }
    }

    private async Task HandlePageChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString() ?? "1", out int newPage))
        {
            CurrentPage = newPage;
            if (CurrentPage < 1) CurrentPage = 1;
            if (CurrentPage > TotalPages) CurrentPage = TotalPages;
            OnPageChanged();
        }
    }
