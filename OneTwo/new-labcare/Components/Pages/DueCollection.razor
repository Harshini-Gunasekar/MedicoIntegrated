    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (string.IsNullOrEmpty(AuthToken))
                {
                    errorMessage = "Access denied: Missing valid session. Please log in again.";
                    StateHasChanged();
                }
                else
                {
                    await LoadMasterData();
                    await LoadAllDue();
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Session error: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private async Task<List<T>> FetchMasterData<T>(HttpClient client, string url)
    {
        try
        {
            var res = await client.GetAsync(url);
            if (res.IsSuccessStatusCode)
            {
                var content = await res.Content.ReadAsStringAsync();
                try
                {
                    return JsonConvert.DeserializeObject<List<T>>(content) ?? new List<T>();
                }
                catch
                {
                    var obj = JsonConvert.DeserializeObject<dynamic>(content);
                    if (obj?["data"] != null)
                    {
                        return ((JArray)obj!["data"]).ToObject<List<T>>() ?? new List<T>();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error fetching {url}: {ex.Message}") */;
        }
        return new List<T>();
    }

    private async Task LoadMasterData()
    {
        try
        {
            using var client = CreateClient();

            _branches = (await FetchMasterData<BranchModel>(client, $"{BaseUrl}Branch/get")).Where(b => b.deleted != true).ToList();
            _counters = (await FetchMasterData<CounterModel>(client, $"{BaseUrl}Counter/get")).Where(c => c.deleted != true).ToList();
            
            // Fetch PayModes dynamically to handle arbitrary JSON property names (e.g. paymode vs payModeName vs name)
            try
            {
                var pmRes = await client.GetAsync($"{BaseUrl}paymode/get");
                if (!pmRes.IsSuccessStatusCode) pmRes = await client.GetAsync($"{BaseUrl}paymode/getall"); // Fallback
                
                if (pmRes.IsSuccessStatusCode)
                {
                    var pmContent = await pmRes.Content.ReadAsStringAsync();
                    var pmToken = JToken.Parse(pmContent);
                    if (pmToken is JArray pmArr) _paymodes = pmArr.OfType<JObject>().ToList();
                    else if (pmToken is JObject pmObj && pmObj["data"] is JArray pmData) _paymodes = pmData.OfType<JObject>().ToList();
                    
                    // Filter out deleted if flag exists
                    _paymodes = _paymodes.Where(p => p["deleted"] == null || p["deleted"]?.ToObject<bool>() != true).ToList();
                }
            }
            catch (Exception ex) { /* Console.WriteLine("Paymode fetch error: " + ex.Message) */; }
            
            _customers = (await FetchMasterData<CustomerModel>(client, $"{BaseUrl}Customer/get")).Where(c => c.deleted != true).ToList();
            _doctors = (await FetchMasterData<DoctorModel>(client, $"{BaseUrl}Doctor/get")).Where(d => d.deleted != true).ToList();
            _reimbursementCompanies = (await FetchMasterData<ReimbursementCompanyModel>(client, $"{BaseUrl}ReimbursementCompany/getall")).Where(c => c.deleted != true).ToList();
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading masters overall: {ex.Message}") */;
        }
    }


