                    {
                        Trailers = result.data.OrderBy(d => d.requestdatetime).Select(d => new DueCollectionUIItem { Row = d }).ToList();
                        TotalRecords = Trailers.Count;
                        TotalPages = TotalRecords > 0 ? (int)Math.Ceiling((double)TotalRecords / PageSize) : 1;

                        GrandBillCount = TotalRecords;
