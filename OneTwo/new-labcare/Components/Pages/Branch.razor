@code {
    [CascadingParameter]
    public UserDetailsModel? UserSession { get; set; }

    private BranchModel CurrentBranch = new BranchModel();
    private List<BranchModel> Branches = new List<BranchModel>();
    private List<CityModel> Cities = new();
    private List<StateModel> States = new();
    private List<AreaModel> Areas = new();
    private List<CountryModel> Countryies = new();
    private List<FeetypeModel> feeTypes = new();
    private string SearchQuery = "";
    private bool IsLoading = false;
    private string AlertMessage = "";
    private bool IsError = false;
    private AppSettings _appSettings = new();
    private string? UserToken;
    private string TenantCode = "";
    private string TenantName = "";
    private bool ShowOnlyActive = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private bool isEditMode = false;

    private string BaseUrl => _appSettings.BaseUrl;

    private bool IsActive
    {
        get => !CurrentBranch.deleted;
        set => CurrentBranch.deleted = !value;
    }

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;

        if (UserSession != null)
        {
            TenantCode = UserSession.TenantCode ?? "";
            TenantName = UserSession.TenantName ?? "";
            UserToken = UserSession.AuthToken;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        IsLoading = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(UserToken) && UserSession == null)
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                UserToken = tokenResult.Success ? tokenResult.Value ?? "" : "";
            }

            if (!string.IsNullOrEmpty(UserToken))
            {
                // Ensure the global state container is updated so HttpClient headers are injected
                TenantState.SetSession(TenantCode, UserToken, TenantName);

                await Task.WhenAll(LoadBranches(), LoadCities(), LoadStates(), LoadAreas(), LoadCountryies(), LoadFeeTypes());
                StateHasChanged();
            }
            else
            {
                ShowAlert("Session expired. Please log in again.", true);
                NavigationManager.NavigateTo("/");
                return;
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Failed to read session data. Error: {ex.Message}", true);
            IsLoading = false;
            StateHasChanged();
            return;
        }

        await LoadBranches();

        IsLoading = false;
        StateHasChanged();
    }

    private IEnumerable<BranchModel> FilteredBranches =>
        Branches.Where(b =>
            (!ShowOnlyActive || !b.deleted) &&
            (string.IsNullOrWhiteSpace(SearchQuery) ||
             (b.name != null && b.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
             (b.short_name != null && b.short_name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))));

    private HttpClient CreateClient() 
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(UserToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", UserToken);
        }
        return client;
    }

    private async Task LoadBranches()
    {
        try
        {
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}Branch/get");
            if (response.IsSuccessStatusCode)
            {
                Branches = await response.Content.ReadFromJsonAsync<List<BranchModel>>() ?? new List<BranchModel>();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                ShowAlert($"Failed to load branches. ({response.StatusCode}): {errorBody}", true);
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"A network error occurred: {ex.Message}", true);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
    private async Task LoadCities()
    {
        try
        {
            using var client = CreateClient();
            Cities = await client.GetFromJsonAsync<List<CityModel>>($"{BaseUrl}City/get") ?? new();
        }
        catch (Exception) { }
    }   
    private async Task LoadCountryies()
    {
        try
        {
            using var client = CreateClient();
            Countryies = await client.GetFromJsonAsync<List<CountryModel>>($"{BaseUrl}Country/get") ?? new();
        }
        catch (Exception) { }
    }

    private async Task LoadStates()
    {
        try
        {
            using var client = CreateClient();
            States = await client.GetFromJsonAsync<List<StateModel>>($"{BaseUrl}State/getall") ?? new();
        }
        catch (Exception) { }
    }

    private async Task LoadAreas()
    {
        try
        {
            using var client = CreateClient();
            Areas = await client.GetFromJsonAsync<List<AreaModel>>($"{BaseUrl}Area/get") ?? new();
        }
        catch (Exception) { }
    }
    
    private async Task LoadFeeTypes()
    {
        try
        {
            using var client = CreateClient();
            feeTypes = await client.GetFromJsonAsync<List<FeetypeModel>>($"{BaseUrl}Feetype/get") ?? new();
        }
        catch (Exception) { }
    }

    private void OnAreaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int areacode))
        {
            CurrentBranch.area_code = areacode;
            var area = Areas.FirstOrDefault(a => a.areacode == areacode);
            if (area != null)
            {
                CurrentBranch.pincode = area.areapincode;
                
                if (area.citycode.HasValue)
                {
                    var city = Cities.FirstOrDefault(c => c.citycode == area.citycode.Value);
                    if (city != null) CurrentBranch.city = city.cityname;
                }
                
                if (area.statecode.HasValue)
                {
                    var state = States.FirstOrDefault(s => s.statecode == area.statecode.Value);
                    if (state != null) CurrentBranch.state = state.statename;
                }
            }
        }
    }

    private void OnPincodeChanged(ChangeEventArgs e)
    {
        string? selectedPincode = e.Value?.ToString();
        CurrentBranch.pincode = selectedPincode;
        
        if (!string.IsNullOrEmpty(selectedPincode))
        {
            var area = Areas.FirstOrDefault(a => a.areapincode == selectedPincode);
            if (area != null)
            {
                CurrentBranch.area_code = area.areacode;
                
                if (area.citycode.HasValue)
                {
                    var city = Cities.FirstOrDefault(c => c.citycode == area.citycode.Value);
                    if (city != null)
                    {
                        CurrentBranch.city = city.cityname;
                    }
                }
                
                if (area.statecode.HasValue)
                {
                    var state = States.FirstOrDefault(s => s.statecode == area.statecode.Value);
                    if (state != null)
                    {
                        CurrentBranch.state = state.statename;
                    }
                }
                StateHasChanged(); 
            }
        }
    }

    private void NewBranch()
    {
        CurrentBranch = new BranchModel();
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveBranch()
    {
        isSubmitted = true;
        if (string.IsNullOrEmpty(TenantCode))
        {
            ShowAlert("Error: Tenant code is not loaded. Please refresh.", true);
            return;
        }

        if (string.IsNullOrWhiteSpace(CurrentBranch.name))
        {
            ShowAlert("Error: Branch Name is required.", true);
            return;
        }

        if (string.IsNullOrWhiteSpace(CurrentBranch.short_name))
        {
            ShowAlert("Error: Short Name is required.", true);
            return;
        }

        // Duplicate check
        if (Branches.Any(b => b.name?.Trim().Equals(CurrentBranch.name?.Trim(), StringComparison.OrdinalIgnoreCase) == true && b.bh_code != CurrentBranch.bh_code))
        {
            ShowAlert($"Error: A branch with name '{CurrentBranch.name}' already exists.", true);
            return;
        }
        if (Branches.Any(b => b.short_name?.Trim().Equals(CurrentBranch.short_name?.Trim(), StringComparison.OrdinalIgnoreCase) == true && b.bh_code != CurrentBranch.bh_code))
        {
            ShowAlert($"Error: A branch with short name '{CurrentBranch.short_name}' already exists.", true);
            return;
        }

        IsLoading = true;
        ShowAlert("", false);

        try
        {
            CurrentBranch.tenant_code = TenantCode;
            CurrentBranch.user_code = 1;
            CurrentBranch.entered_date = DateTime.Now;

            using var client = CreateClient();
            HttpResponseMessage response;
            if (!isEditMode)
                response = await client.PostAsJsonAsync($"{BaseUrl}Branch/insert", CurrentBranch);
            else
                response = await client.PostAsJsonAsync($"{BaseUrl}Branch/update", CurrentBranch);

            if (response.IsSuccessStatusCode)
            {
                ShowAlert(isEditMode ? "✅ Branch updated successfully!" : "✅ Branch created successfully!", false);
                CloseForm();
                await LoadBranches();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                ShowAlert($"❌ Save failed ({response.StatusCode}): {errorBody}", true);
            }
        }
        catch (Exception ex) { ShowAlert($"❌ Network error: {ex.Message}", true); }
        finally { IsLoading = false; }
    }

    private async Task HandleDelete(int? bh_code)
    {
        if (bh_code == null || bh_code == 0) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this branch?");
        if (!confirmed) return;

        IsLoading = true;
        try
        {
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}Branch/softdelete?bhcode={bh_code}");
            if (response.IsSuccessStatusCode)
            {
                ShowAlert("Branch removed successfully.", false);
                await LoadBranches();
                if (CurrentBranch.bh_code == bh_code) showForm = false;
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                ShowAlert($"Failed to delete. ({response.StatusCode}): {errorBody}", true);
            }
        }
        catch (Exception ex) { ShowAlert($"Delete error: {ex.Message}", true); }
        finally { IsLoading = false; }
    }

    private void EditBranch(BranchModel branch)
    {
        CurrentBranch = System.Text.Json.JsonSerializer.Deserialize<BranchModel>(System.Text.Json.JsonSerializer.Serialize(branch)) ?? new BranchModel();
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
        AlertMessage = "";
    }

    private void CloseForm()
    {
        CurrentBranch = new BranchModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
        AlertMessage = "";
    }

    private void ShowAlert(string msg, bool error)
    {
        AlertMessage = msg;
        IsError = error;
        StateHasChanged();
    }

    private void SetBranchType(string type)
    {
        CurrentBranch.is_main_branch = (type == "Main");
        CurrentBranch.is_branch = (type == "Branch");
        CurrentBranch.is_collection_centre = (type == "CC");
    }

    // Quick Add Modals states and methods
    private bool showCountryModal = false;
    private string newCountryName = "";
    private string newCountryShortName = "";
