                entereddate = DateTime.Now,
                ibsdate = DateTime.Now
            };
            using var client = CreateClient();
            var response = await client.PostAsJsonAsync($"{BaseUrl}FeeType/insert", ft);
            if (response.IsSuccessStatusCode)
            {
                showFeetypeModal = false;
                newFeetypeName = "";
                newFeetypeShortName = "";
                newFeetypeOrderNo = null;
                newFeetypeDescription = "";
                await LoadFeeTypes();
                var savedFt = feeTypes.FirstOrDefault(f => f.name?.Trim().Equals(ft.name.Trim(), StringComparison.OrdinalIgnoreCase) == true);
                if (savedFt != null)
                {
                    CurrentBranch.ftcode = savedFt.ftcode;
                }
                ShowAlert("✅ Fee Type added successfully!", false);
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                ShowAlert($"❌ Failed to save fee type: {err}", true);
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"❌ Error: {ex.Message}", true);
        }
    }
}