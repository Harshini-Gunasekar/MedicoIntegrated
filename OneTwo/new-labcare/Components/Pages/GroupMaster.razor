@page "/group-master"
@rendermode InteractiveServer
@using LabCare.Models
@using LIMS_Backend.Model
@inject LabCare.Services.GroupService GroupSvc
@inject LabCare.Services.NotificationService Toast
@inject LabCare.Services.TenantSessionState TenantState
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<div class="referral-page">

    <div class="lab-header-card flex-between">
        <div>
            <h2 class="lab-title-text m-0">Group Master</h2>
            <p class="font-14 text-slate-400 font-600 m-0">Laboratory Category Management</p>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Quick find..." @bind="SearchQuery" @bind:event="oninput" class="search-input-field" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewGroup">+ New Group Entry</button>
            </div>
        </div>
    </div>

    @if (showForm)
    {
        <div class="modal-overlay">
            <div class="modal-form-card" style="max-width: 850px;">
                <div class="modal-header-bar">
                    <h3>@(isEditMode ? "Edit Group" : "New Group Entry")</h3>
                    <button type="button" class="modal-close-btn" @onclick="CloseForm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                        </svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="display-flex gap-24">
                        <!-- Left: Main Form Fields -->
                        <div class="flex-1">
                            <div class="um-grid-row">
                                <div class="form-group position-relative">
                                    <label>Group Name</label>
                                    <input type="text" @bind="currentGroup.name" class="lab-input font-bold" placeholder="Ex: HAEMATOLOGY" required />
                                </div>
                            </div>
                            <div class="form-row form-cols-2 mt-3">
                                <div class="form-group">
                                    <label>Short Name</label>
                                    <input type="text" @bind="currentGroup.shortname" class="lab-input" placeholder="e.g. HEM" />
                                </div>
                                <div class="form-group">
                                    <label>Order No</label>
                                    <input type="number" @bind="currentGroup.orderno" class="lab-input" />
                                </div>
                            </div>

                            <div class="form-group mt-3">
                                <label>Department</label>
                                <div style="display: flex; gap: 12px; flex-wrap: wrap; background: #f8fafc; padding: 8px 12px; border-radius: 8px; border: 1px solid #e2e8f0;">
                                    <label style="display: flex; align-items: center; gap: 6px; font-size: 13px; cursor: pointer;">
                                        <input type="radio" name="dept" checked="@(currentGroup.isscan == true)" @onchange="@(() => SetDept("scan"))" />
                                        <span>Scan</span>
                                    </label>
                                    <label style="display: flex; align-items: center; gap: 6px; font-size: 13px; cursor: pointer;">
                                        <input type="radio" name="dept" checked="@(currentGroup.islab == true)" @onchange="@(() => SetDept("lab"))" />
                                        <span>Lab</span>
                                    </label>
                                    <label style="display: flex; align-items: center; gap: 6px; font-size: 13px; cursor: pointer;">
                                        <input type="radio" name="dept" checked="@(currentGroup.ispackage == true)" @onchange="@(() => SetDept("package"))" />
                                        <span>Package</span>
                                    </label>
                                    <label style="display: flex; align-items: center; gap: 6px; font-size: 13px; cursor: pointer;">
                                        <input type="radio" name="dept" checked="@(currentGroup.ischarges == true)" @onchange="@(() => SetDept("charges"))" />
                                        <span>Charges</span>
                                    </label>
                                </div>
                            </div>

                            <div class="form-group mt-3">
                                <label>Narration</label>
                                <input type="text" @bind="currentGroup.description" class="lab-input" placeholder="Internal notes..." />
                            </div>

                            <div class="form-group mt-3">
                                <label>Footer Text</label>
                                <textarea @bind="currentGroup.footer" class="lab-input h-60" style="resize: none;" placeholder="To be printed on reports..."></textarea>
                            </div>

                            <div class="form-row form-cols-2 mt-3 align-end">
                                <div class="form-group">
                                    <label>Work Order No</label>
                                    <input type="number" @bind="currentGroup.workorderno" class="lab-input" />
                                </div>
                                <div class="form-group flex-row gap-12" style="margin-bottom: 8px;">
                                    <label class="display-flex align-center gap-6 cursor-pointer">
                                        <input type="checkbox" @bind="currentGroup.isprintbarcode" />
                                        <span class="font-12 font-600">Print Barcode</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer-bar">
                    <button type="button" class="btn-delete" @onclick="() => DeleteGroup(currentGroup)" disabled="@(currentGroup.gcode == 0)">
                        Delete
                    </button>
                    <button type="button" class="btn-save" @onclick="SaveGroup" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span>Saving...</span>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="btn-icon-mr">
                                <path d="M11.354 1.646a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708 0l-3-3a.5.5 0 1 1 .708-.708L5.5 6.293l5.646-5.647a.5.5 0 0 1 .708 0z" />
                            </svg>
                            <span>Save Group</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Directory List -->
    <div class="directory-section">
        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">ORDER.NO</th>
                        <th style="width: 120px;">SHORT NAME</th>
                        <th>GROUP NAME</th>
                        <th class="text-center" style="width: 60px;">SCAN</th>
                        <th class="text-center" style="width: 60px;">LAB</th>
                        <th class="text-center" style="width: 80px;">PACKAGE</th>
                        <th class="text-center" style="width: 80px;">CHARGES</th>
                        <th>FOOTER NARRATION</th>
                        <th class="text-center" style="width: 80px;">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading && !allGroups.Any())
                    {
                        <tr>
                            <td colspan="9" style="padding: 48px; text-align: center; color: #64748b;">Loading Groups...</td>
                        </tr>
                    }
                    else if (!FilteredGroups.Any())
                    {
                        <tr>
                            <td colspan="9" style="padding: 48px; text-align: center; color: #64748b; font-style: italic;">No groups found matching your criteria.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var g in FilteredGroups)
                        {
                            <tr class="@(selectedGCode == g.gcode ? "selected-row" : "")" @onclick="() => SelectGroup(g)">
                                <td style="font-weight: 700; color: #4f46e5;">@g.orderno</td>
                                <td style="color: #64748b; font-family: monospace;">@g.shortname</td>
                                <td style="font-weight: 600; color: #1e293b;">@g.name</td>
                                <td class="text-center">
                                    <div class="table-status-indicator" style="background: @(g.isscan == true ? "#22c55e" : "#e2e8f0"); margin: 0 auto;"></div>
                                </td>
                                <td class="text-center">
                                    <div class="table-status-indicator" style="background: @(g.islab == true ? "#22c55e" : "#e2e8f0"); margin: 0 auto;"></div>
                                </td>
                                <td class="text-center">
                                    <div class="table-status-indicator" style="background: @(g.ispackage == true ? "#3b82f6" : "#e2e8f0"); margin: 0 auto;"></div>
                                </td>
                                <td class="text-center">
                                    <div class="table-status-indicator" style="background: @(g.ischarges == true ? "#f97316" : "#e2e8f0"); margin: 0 auto;"></div>
                                </td>
                                <td class="font-12 text-slate-500 truncate" style="max-width: 200px;">@g.footer</td>
                                <td class="text-center" @onclick:stopPropagation="true">
                                    <button @onclick="() => SelectGroup(g)" class="btn-action btn-edit" title="Edit"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg></button>
                                    <button @onclick="() => DeleteGroup(g)" class="btn-action btn-delete-action" title="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" /><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" /></svg></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<GroupModel> allGroups = new();
    private GroupModel currentGroup = new GroupModel();
    private bool isLoading = true;
    private bool showActiveOnly = true;
    private long selectedGCode = 0;
    private string SearchQuery = "";
    private bool showForm = false;
    private bool isEditMode = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");

                string tc = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
                string tk = tokenResult.Success ? tokenResult.Value ?? "" : "";
                string tn = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(tk))
                {
                    TenantState.SetSession(tc, tk, tn);
                    await LoadGroups();
                }
                else
                {
                    isLoading = false;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                /* Console.WriteLine($"Session error: {ex.Message}") */;
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadGroups()
    {
        isLoading = true;
        allGroups = await GroupSvc.GetAllAsync();
        isLoading = false;
        StateHasChanged();
    }

    private IEnumerable<GroupModel> FilteredGroups =>
        allGroups.Where(g =>
            (!showActiveOnly || !g.deleted) &&
            (string.IsNullOrWhiteSpace(SearchQuery) ||
             (g.name != null && g.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
             (g.shortname != null && g.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))));

    private void SetDept(string type)
    {
        currentGroup.isscan = false;
        currentGroup.islab = false;
        currentGroup.ispackage = false;
        currentGroup.ischarges = false;

        switch (type)
        {
            case "scan": currentGroup.isscan = true; break;
            case "lab": currentGroup.islab = true; break;
            case "package": currentGroup.ispackage = true; break;
            case "charges": currentGroup.ischarges = true; break;
        }
    }

    private void SelectGroup(GroupModel g)
    {
        selectedGCode = g.gcode;
        isEditMode = true;
        // Create a deep copy
        currentGroup = new GroupModel
        {
            gcode = g.gcode,
            orderno = g.orderno,
            shortname = g.shortname,
            name = g.name,
            description = g.description,
            footer = g.footer,
            departmentcode = g.departmentcode,
            isscan = g.isscan,
            islab = g.islab,
            ispackage = g.ispackage,
            ischarges = g.ischarges,
            isprintbarcode = g.isprintbarcode,
            workorderno = g.workorderno,
            deleted = g.deleted,
            tenant_code = g.tenant_code
        };
        showForm = true;
    }

    private async Task SaveGroup()
    {
        if (string.IsNullOrWhiteSpace(currentGroup.name))
        {
            Toast.Warning("Please enter a group name");
            return;
        }

        isLoading = true;
        bool success;
        if (currentGroup.gcode == 0)
        {
            success = await GroupSvc.InsertAsync(currentGroup);
            if (success) Toast.Success("Group created successfully");
        }
        else
        {
            success = await GroupSvc.UpdateAsync(currentGroup);
            if (success) Toast.Success("Group updated successfully");
        }

        if (success)
        {
            showForm = false;
            await LoadGroups();
            ResetForm();
        }
        else
        {
            Toast.Error("Save failed. Please try again.");
        }
        isLoading = false;
    }

    private async Task DeleteGroup(GroupModel g)
    {
        if (g.gcode == 0) return;
        
        if (!await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the group '{g.name}'?")) return;

        isLoading = true;
        if (await GroupSvc.SoftDeleteAsync(g.gcode))
        {
            Toast.Success("Group removed");
            showForm = false;
            await LoadGroups();
        }
        else
        {
            Toast.Error("Failed to remove group");
        }
        isLoading = false;
    }

    private void NewGroup()
    {
        currentGroup = new GroupModel { orderno = allGroups.Count + 1, islab = true };
        isEditMode = false;
        showForm = true;
        selectedGCode = 0;
    }

    private void ResetForm()
    {
        currentGroup = new GroupModel();
        selectedGCode = 0;
    }

    private void CloseForm()
    {
        showForm = false;
        ResetForm();
    }

    private async Task HandleClose()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
