    private string GetResultBgClass(LabResultEntry row)
    {
        if (string.IsNullOrWhiteSpace(row.enteredresult) || !double.TryParse(row.enteredresult, out double res))
        {
            row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
            return "";
        }

        string nv = row.normalvalue ?? "";
        // Define a dash pattern that covers hyphen, en-dash, and em-dash
        string dash = @"[\-\u2013\u2014]";

        // 1. Check for explicit "Borderline" ranges
        var borderMatch = Regex.Match(nv, @"(\d+\.?\d*)\s*" + dash + @"\s*(\d+\.?\d*)\s*[:\-]?\s*Borderline", RegexOptions.IgnoreCase);
        if (!borderMatch.Success) borderMatch = Regex.Match(nv, @"Borderline\s*[:\-]?\s*(\d+\.?\d*)\s*" + dash + @"\s*(\d+\.?\d*)", RegexOptions.IgnoreCase);
        
        if (borderMatch.Success)
        {
            if (double.TryParse(borderMatch.Groups[1].Value, out double bMin) && 
                double.TryParse(borderMatch.Groups[2].Value, out double bMax))
            {
                if (res >= bMin && res <= bMax)
                {
                    row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
                    return "re-bg-yellow";
                }
            }
        }

        // 2. Check for "Normal" or "Desirable" ranges
        var normalRangeMatch = Regex.Match(nv, @"(\d+\.?\d*)\s*" + dash + @"\s*(\d+\.?\d*)\s*[:\-]?\s*(Normal|Desirable)", RegexOptions.IgnoreCase);
        if (normalRangeMatch.Success)
        {
            if (double.TryParse(normalRangeMatch.Groups[1].Value, out double nMin) && 
                double.TryParse(normalRangeMatch.Groups[2].Value, out double nMax))
            {
                if (res >= nMin && res <= nMax)
                {
                    row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
                    return "re-bg-green";
                }
            }
        }
        else
        {
            normalRangeMatch = Regex.Match(nv, @"(Normal|Desirable)\s*[:\-]?\s*(\d+\.?\d*)\s*" + dash + @"\s*(\d+\.?\d*)", RegexOptions.IgnoreCase);
            if (normalRangeMatch.Success)
            {
                if (double.TryParse(normalRangeMatch.Groups[2].Value, out double nMin) && 
                    double.TryParse(normalRangeMatch.Groups[3].Value, out double nMax))
                {
                    if (res >= nMin && res <= nMax)
                    {
                        row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
                        return "re-bg-green";
                    }
                }
            }
        }

        // 3. Check for Normal/Desirable limits (< X or > X)
        var ltMatch = Regex.Match(nv, @"<\s*(\d+\.?\d*)");
        if (ltMatch.Success && double.TryParse(ltMatch.Groups[1].Value, out double ltLimit))
        {
            if (res < ltLimit)
            {
                row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
                return "re-bg-green";
            }
        }

        var gtMatch = Regex.Match(nv, @">\s*(\d+\.?\d*)");
        if (gtMatch.Success && double.TryParse(gtMatch.Groups[1].Value, out double gtLimit))
        {
            if (res > gtLimit)
            {
                row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
                return "re-bg-green";
            }
        }

        // 4. Fallback to generic min-max range check
        var genericMatch = Regex.Match(nv, @"(\d+\.?\d*)\s*" + dash + @"\s*(\d+\.?\d*)");
        if (genericMatch.Success)
        {
            if (double.TryParse(genericMatch.Groups[1].Value, out double fMin) && 
                double.TryParse(genericMatch.Groups[2].Value, out double fMax))
            {
                if (res > fMax) { row.resulthigh = true; row.resultlow = false; row.resultnormal = false; return "re-bg-red"; }
                if (res < fMin) { row.resulthigh = false; row.resultlow = true; row.resultnormal = false; return "re-bg-red"; }
                
                row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
                return "re-bg-green";
            }
        }

        // 5. Absolute High/Low detection based on any numbers in the string
        var numbers = Regex.Matches(nv, @"\d+\.?\d*").Cast<Match>()
            .Select(m => { double.TryParse(m.Value, out double d); return d; })
            .ToList();

        if (numbers.Any())
        {
            double absMax = numbers.Max();
            double absMin = numbers.Min();
            if (res > absMax) { row.resulthigh = true; row.resultlow = false; row.resultnormal = false; return "re-bg-red"; }
            if (res < absMin) { row.resulthigh = false; row.resultlow = true; row.resultnormal = false; return "re-bg-red"; }
        }

        row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
        return "";
    }

    private async Task FetchDeltaCheck()
    {
        if (_isDisposed || string.IsNullOrEmpty(CustCode)) return;
        isDeltaModalOpen = true;
        isDeltaLoading = true;
        StateHasChanged();
        try
        {
            var url = $"{appSettings.BaseUrl}Request/deltacheck?custcode={CustCode}";
            var request = new HttpRequestMessage(HttpMethod.Get, url);
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            if (!string.IsNullOrEmpty(tenantCode))
                request.Headers.Add("tenant_code", tenantCode);

            var ct = SafeToken;
            var res = await http.SendAsync(request, ct);
            if (res.IsSuccessStatusCode)
            {
                var content = await res.Content.ReadAsStringAsync(ct);
                deltaResults = JsonConvert.DeserializeObject<List<DeltaResult>>(content);
                
                // Calculate missing formula values for previous results
                if (deltaResults != null && deltaResults.Any())
                {
                    CalculatePreviousFormulas();
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Delta Check Error: {ex.Message}") */;
        }
        finally
        {
            isDeltaLoading = false;
            StateHasChanged();
        }
    }

    private void CalculatePreviousFormulas()
    {
        if (deltaResults == null || lre1 == null) return;

        try
        {
            // 1. Build a parameter dictionary from the historical data
            var histParams = new Dictionary<string, object>();
            foreach (var dr in deltaResults)
            {
                if (double.TryParse(dr.Result, out double val))
                {
                    var matchingRow = lre1.FirstOrDefault(x => (x.col2 ?? "").Trim().ToLower() == (dr.TestName ?? "").Trim().ToLower());
                    if (matchingRow != null)
                    {
                        histParams[matchingRow.tcode.ToString()] = val;
                        histParams[matchingRow.testresultid.ToString().ToLower()] = val;
                        string safeName = (matchingRow.col2 ?? "").Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "").Replace(".", "");
                        histParams[safeName] = val;
                    }
                }
            }

            // 2. Loop through our master list and calculate any formulas for the previous data
            foreach (var row in lre1)
            {
                if (row.resultvaluetype == "Calculated Value" && !string.IsNullOrEmpty(row.calculatedformula))
                {
                    // Check if this test already has a result in deltaResults
                    var existingDelta = deltaResults.FirstOrDefault(d => (d.TestName ?? "").Trim().ToLower() == (row.col2 ?? "").Trim().ToLower());
                    
                    // If it's empty or a GUID, try to calculate it
                    if (existingDelta == null || string.IsNullOrEmpty(existingDelta.Result) || Guid.TryParse(existingDelta.Result, out _))
                    {
                        try
                        {
                            var parts = row.calculatedformula.Split('|', StringSplitOptions.RemoveEmptyEntries);
                            var processedFormula = new System.Text.StringBuilder();
                            foreach (var p in parts)
                            {
                                string part = p.Trim();
                                if (Guid.TryParse(part, out _) || int.TryParse(part, out _))
                                    processedFormula.Append($"[{part}]");
                                else
                                    processedFormula.Append(part);
                            }

                            var expr = new Expression(processedFormula.ToString());
                            expr.Parameters = histParams;
                            var res = expr.Evaluate();
                            if (res != null)
                            {
                                string calcVal = res.ToString();
                                if (double.TryParse(calcVal, out double num))
                                    calcVal = Math.Round(num, 2).ToString();

                                if (existingDelta != null)
                                    existingDelta.Result = calcVal;
                                else
                                    deltaResults.Add(new DeltaResult { TestName = row.col2, Result = calcVal });
                            }
                        }
                        catch { }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error calculating previous formulas: {ex.Message}") */;
        }
    }

    private void ClearEntry()
    {
        // Reset all entered results in lre1
        foreach (var row in lre1)
        {
            row.enteredresult = string.Empty;
        }
        StateHasChanged();
    }

    // ── DeleteSubRow — removes a sub-test row from the grid ──────────────────
    private void DeleteSubRow(LabResultEntry row)
    {
        if (userCode != 1 && !isauthorized2)
        {
            return;
        }
        lre1.Remove(row);
        lre.Remove(row);

        // Cleanup associated Delta Check entry if it exists
        if (deltaResults != null && !string.IsNullOrEmpty(row.col2))
        {
            var matchingDelta = deltaResults.FirstOrDefault(d => (d.TestName ?? "").Trim().ToLower() == row.col2.Trim().ToLower());
            if (matchingDelta != null)
            {
                deltaResults.Remove(matchingDelta);
            }
        }

        StateHasChanged();
    }


    private Dictionary<long, TestInsertDto> _testConfigs = new();

    private bool IsRowEscalated(LabResultEntry row)
    {
        if (row == null) return false;
        if (row.is_escalation == true) return true;
        if (_testConfigs.TryGetValue(row.tcode, out var config))
        {
            if (config.TestMaster.is_escalation == true) return true;
            if (config.ResultRows != null && config.ResultRows.Any(r => r.ResultMaster.testresultid == row.testresultid && r.ResultMaster.is_escalation == true)) return true;
        }
        return false;
    }

    private int GetAssignedUserCode(long tcode)
    {
        if (_testConfigs.TryGetValue(tcode, out var config))
        {
            return config.TestMaster.usercode ?? 1;
        }
        return 1;
    }

    private bool IsTestEscalated(long tcode)
    {
        if (_testConfigs.TryGetValue(tcode, out var config))
        {
            if (config.TestMaster.is_escalation == true) return true;
            if (config.ResultRows != null && config.ResultRows.Any(r => r.ResultMaster.is_escalation == true)) return true;
        }
        if (lre1 != null && lre1.Any(x => x.tcode == tcode && x.is_escalation == true)) return true;
        return false;
    }

    // Save state
    private bool isSaving = false;
    private bool isAuth2Finished = false;
    private string saveMessage = "";
    private bool saveError = false;
    private System.Threading.CancellationTokenSource? _toastCts;

    private async Task SaveResults(int level)
    {
        /* Console.WriteLine($"[SAVE] SaveResults ENTERED: level={level}, userCode={userCode}, isSaving={isSaving}, isviewer={isviewer}") */;

        if (isSaving) { /* Console.WriteLine("[SAVE] Blocked: already saving.") */; return; }

        // If userCode is 0, try to recover from session before blocking
        if (userCode == 0)
        {
            /* Console.WriteLine("[SAVE] userCode=0 — attempting session re-read...") */;
            try
            {
                var claimResult = await sessionStorage.GetAsync<UserAuth>("claim");
                if (claimResult.Success && claimResult.Value != null)
                {
                    userCode = claimResult.Value.usercode;
                    token = claimResult.Value.token;
                    /* Console.WriteLine($"[SAVE] Re-read from claim: userCode={userCode}") */;
                }
                if (userCode == 0)
                {
                    var ud = await sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                    if (ud.Success && ud.Value != null)
                    {
                        userCode = ud.Value.UserCode ?? 0;
                        if (string.IsNullOrEmpty(token)) token = ud.Value.AuthToken ?? "";
                        /* Console.WriteLine($"[SAVE] Re-read from UserDetails: userCode={userCode}") */;
                    }
                }
            }
            catch (Exception ex) { /* Console.WriteLine($"[SAVE] Session re-read error: {ex.Message}") */; }
        }

        if (userCode == 0)
        {
            saveError = true;
            saveMessage = "⚠️ Session expired — please refresh the page and log in again.";
            Toast.Error(saveMessage, "Session Expired");
            /* Console.WriteLine("[SAVE] Blocked: userCode still 0 after re-read.") */;
            StateHasChanged();
            ShowToastThenClear();
            return;
        }

        // Force admin rights if not yet applied
        if (!isentered && !isauthorized1 && !isauthorized2)
        {
            isentered = true; isauthorized1 = true; isauthorized2 = true;
            /* Console.WriteLine("[SAVE] Rights defaulted to full for this save attempt.") */;
        }

        isSaving = true;
        currentSavingLevel = level;
        saveMessage = "";
        /* Console.WriteLine($"[SAVE] SaveResults proceeding: level={level}, userCode={userCode}, isentered={isentered}, isauth1={isauthorized1}, isauth2={isauthorized2}, lre1.Count={lre1.Count}") */;
        StateHasChanged();

        try
        {
            // Escalation Validation: If saving/authorizing at level 2 (Auth 2), check if any escalated row is being authorized by a non-assigned user.
            if (level == 2)
            {
                foreach (var row in lre1)
                {
                    if (IsRowEscalated(row))
                    {
                        int assignedUser = GetAssignedUserCode(row.tcode);
                        if (userCode != assignedUser)
                        {
                            saveError = true;
                            saveMessage = $"⚠️ Escalation test '{row.testname}' can only be authorized (Auth 2) by the assigned Pathologist/Doctor (User Code: {assignedUser}).";
                            Toast.Error(saveMessage, "Escalation Authorization Denied");
                            isSaving = false;
                            StateHasChanged();
                            return;
                        }
                    }
                }
            }

            bool canProceed = false;

            // Admin / full-rights bypass: if user has all three rights, they can always save at any level
            bool isAdmin = userCode == 1 || (isentered && isauthorized1 && isauthorized2);

            // Sanitize and Apply Authorization to the FULL master list (lre1)
            foreach (var row in lre1)
            {
                // Sync GUIDs
                if (string.IsNullOrEmpty(row.requestguid)) row.requestguid = RequestGuid ?? "";
                
                // Result status Logic: true if entered, else false
                row.status = !string.IsNullOrWhiteSpace(row.enteredresult?.Trim());

                if (string.IsNullOrEmpty(row.defaultunitvalue)) row.defaultunitvalue = row.unitname ?? "";
                
                // 1. Clean up normalvalue — strip display-only method suffix before saving
                if (row.normalvalue != null)
                {
                    row.normalvalue = row.normalvalue.Replace("Normal 0", "").Trim();
                    // Remove "/ (MethodName)" suffix added by LoadResults for display only
                    row.normalvalue = System.Text.RegularExpressions.Regex.Replace(
                        row.normalvalue, @"\s*/\s*\([^)]+\)\s*$", "").Trim();
                }

                // 2. Sync rtmcode — but do NOT modify normalvalue with method name here (save context)
                var methodObj = method.FirstOrDefault(x => x.rtmcode == row.rtmcode);

                if (methodObj != null && !string.IsNullOrEmpty(methodObj.name))
                {
                    // method found — use for rtmcode assignment only, do not modify normalvalue
                }
                else if (row.rtmcode == 0)
                {
                    row.normalvalue = (row.normalvalue ?? "").Replace("/ ()", "").Trim();
                }

                
                if (!string.IsNullOrEmpty(row.unitname))
                {
                    var unit = uom.FirstOrDefault(x => x.name == row.unitname);
                    if (unit != null) row.defaultunitscode = unit.ucode;
                }

                if (row.mccode == 0 && !string.IsNullOrEmpty(row.machinename))
                {
                    var m = machine.FirstOrDefault(x => x.name == row.machinename || x.shortname == row.machinename);
                    if (m != null) row.mccode = m.mccode;
                }

                if (row.scode == 0 && !string.IsNullOrEmpty(row.samplename))
                {
                    var s = sample.FirstOrDefault(x => x.name == row.samplename || x.shortname == row.samplename);
                    if (s != null) row.scode = s.scode;
                }

                if (row.rtmcode == 0)
                {
                    if (row.testresultid.HasValue && row.testresultid.Value != Guid.Empty)
                    {
                        var matchingMethod = method.FirstOrDefault(m => m.rtmcode > 0);
                        if (matchingMethod != null) row.rtmcode = matchingMethod.rtmcode;
                    }
                    if (row.rtmcode == 0 && method.Any())
                        row.rtmcode = method.First().rtmcode;
                }

                if (string.IsNullOrEmpty(row.machinename)) row.machinename = "Manual";
                
                row.enteredresult ??= "";
                if (string.IsNullOrEmpty(row.col2) && !string.IsNullOrEmpty(row.testname))
                {
                    bool isParentTestName = row.testname.Equals(row.groupname, StringComparison.OrdinalIgnoreCase) || 
                                            row.testname.Contains("Profile", StringComparison.OrdinalIgnoreCase) || 
                                            row.testname.Contains("Panel", StringComparison.OrdinalIgnoreCase) ||
                                            row.testname.Contains("Package", StringComparison.OrdinalIgnoreCase);
                    
                    if (!isParentTestName)
                    {
                        row.col2 = row.testname;
                    }
                }
                row.col2 ??= "";
                row.resultvaluetype ??= "Text";

                // Determine editability — admin bypass or per-row rights
                bool rowEditable = isAdmin || IsRowEditable(row);
                bool hasResult = !string.IsNullOrWhiteSpace(row.enteredresult?.Trim());
                
                /* Console.WriteLine($"[SAVE] Row tcode={row.tcode} col2='{row.col2}' rowEditable={rowEditable} hasResult={hasResult}") */;
                
                if (rowEditable)
                {
                    if (level == 2 && (isauthorized2 || isAdmin))
                    {
                        canProceed = true;
                        row.resultauthorizedby2 = userCode;
                        row.isauthorized2 = true;
                        row.status = hasResult;
                        if (row.resultauthorizedby == 0) row.resultauthorizedby = userCode;
                        row.isauthorized1 = true;
                        if (row.resultenteredby == 0 && hasResult) row.resultenteredby = userCode;
                    }
                    else if (level == 1 && (isauthorized1 || isAdmin))
                    {
                        canProceed = true;
                        row.resultauthorizedby = userCode;
                        row.isauthorized1 = true;
                        row.status = hasResult;
                        if (row.resultenteredby == 0 && hasResult) row.resultenteredby = userCode;
                    }
                    else if (level == 0 && (isentered || isAdmin))
                    {
                        canProceed = true;
                        if (hasResult)
                        {
                            if (row.resultenteredby == 0) row.resultenteredby = userCode;
                            row.status = true;
                        }
                        else
                        {
                            // If row is empty, ensure status is false to satisfy backend validation
                            row.status = false;
                        }
                    }
                }
            }

            /* Console.WriteLine($"[SAVE] canProceed={canProceed}") */;
            UpdateUserNames();
            StateHasChanged();

            if (!canProceed)
            {
                saveError = true;
                saveMessage = "Insufficient rights or record is locked.";
                Toast.Warning(saveMessage, "Access Denied");
                isSaving = false;
                StateHasChanged();
                return;
            }

            // Sanitize DetailedNormalValues required fields before sending to backend
            foreach (var row in lre1)
            {
                if (row.EditedDetailedNormalValues != null)
                {
                    foreach (var dnv in row.EditedDetailedNormalValues)
                    {
                        if (string.IsNullOrEmpty(dnv.agefromtype))  dnv.agefromtype  = "Years";
                        if (string.IsNullOrEmpty(dnv.agetotype))    dnv.agetotype    = "Years";
                        if (string.IsNullOrEmpty(dnv.agerangetype)) dnv.agerangetype = "Normal";
                        if (string.IsNullOrEmpty(dnv.sex))          dnv.sex          = "Both";
                        if (string.IsNullOrEmpty(dnv.rangetype))    dnv.rangetype    = "Normal";
                    }
                }
            }

            // Project to exact field names/casing the backend expects (derived from working LIMS payload).
            var emptyTextNV   = new List<Lab_Result_TextNormalValues>();
            var emptyDetailNV = new List<Lab_Result_DetailedNormalValues>();
            var emptyCF       = new List<Lab_Result_CalculatedFormula>();

            // Diagnostic: print key fields of every row before serializing
            /* Console.WriteLine("[SAVE-DIAG] --- Row diagnostics ---") */;
            foreach (var row in lre1)
            {
                /* Console.WriteLine($"[SAVE-DIAG] SLNo={row.slno} tcode={row.tcode} col2='{row.col2}' RequestGUID='{row.requestguid}' testresultid={row.testresultid} enteredresult='{row.enteredresult}' ResultEnteredBy={row.resultenteredby} isauth1={row.isauthorized1} status={row.status}") */;
            }
            /* Console.WriteLine("[SAVE-DIAG] --- End diagnostics ---") */;

            var savePayload = lre1.Select(row => new
            {
                requestguid = row.requestguid ?? "",
                slno = row.slno,
                tcode = row.tcode,
                testname = row.testname ?? "",
                orderno = row.orderno,
                grouporder = row.grouporder,
                gcode = row.gcode,
                groupname = row.groupname ?? "",
                col2 = row.col2 ?? "",
                enteredresult = row.enteredresult ?? "",
                resultvaluetype = row.resultvaluetype ?? "Text",
                normalvalue = row.normalvalue ?? "",
                testresultid = row.testresultid,
                status = row.status,
                defaultvalueforfxtype = row.defaultvalueforfxtype?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                fxtcode = row.fxtcode?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                fromtcode = row.fromtcode,
                fromtestresultid = row.fromtestresultid?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                resultnormal = row.resultnormal,
                resulthigh = row.resulthigh,
                resultlow = row.resultlow,
                resulttype = row.resulttype ?? "Result",
                simplenv = row.simplenv,
                detailednv = row.detailednv,
                calculatedformula = row.calculatedformula ?? "",
                defaultunitscode = row.defaultunitscode,
                defaultunitvalue = row.defaultunitvalue ?? "",
                mccode = row.mccode > 0 ? row.mccode : 1,
                machinename = row.mccode > 0 ? (row.machinename ?? "Manual") : "Manual",
                scode = row.scode > 0 ? row.scode : 1,
                rtmcode = row.rtmcode > 0 ? row.rtmcode : (method.FirstOrDefault()?.rtmcode ?? 1),

                resultenteredby = row.resultenteredby,
                isauthorized1 = row.isauthorized1,
                isauthorized2 = row.isauthorized2,
                resultauthorizedby = row.resultauthorizedby,
                resultauthorizedby2 = row.resultauthorizedby2,

                decimalvalue = row.decimalvalue,
                isgraph = row.isgraph ?? false,
                graphvalue = row.graphvalue ?? 0.0,
                footermessage = row.footermessage ?? "",
                conclusionforhigher = row.conclusionforhigher ?? "",
                conclusionforlower = row.conclusionforlower ?? "",
                conclusionforfixedtext = row.conclusionforfixedtext ?? "",
                showagedbased = row.showagedbased,
                printconclusioninreport = row.printconclusioninreport,
                printconclusioninbottom = row.printconclusioninbottom,
                showalertonhigherlower = row.showalertonhigherlower,
                printunitsinnormalvalues = row.printunitsinnormalvalues,
                printnormalvaluesatbottom = row.printnormalvaluesatbottom,
                printspecialfieldsatrightside = row.printspecialfieldsatrightside,
                groupvaluesbysex = row.groupvaluesbysex,
                groupvaluesbyspecialfield = row.groupvaluesbyspecialfield,

                editedtextnormalvalues = ((row.EditedTextNormalValues != null && row.EditedTextNormalValues.Any()) ? row.EditedTextNormalValues : (row.textnormalvalues ?? emptyTextNV)).Select(tnv => new {
                    trtid = tnv.trtid?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                    testresultid = row.testresultid?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                    sex = tnv.sex ?? "-",
                    normalvalue = tnv.normalvalue ?? "",
                    mccode = 1, performedcount = 1, scode = 1
                }).ToList(),

                editeddetailedNormalvalues = ((row.EditedDetailedNormalValues != null && row.EditedDetailedNormalValues.Any()) ? row.EditedDetailedNormalValues : (row.detailednormalvalues ?? emptyDetailNV)).Select(dnv => new {
                    trdnid = dnv.trdnid?.ToString() ?? dnv.dnvid?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                    testresultid = row.testresultid?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                    sno = dnv.sno,
                    agefrom = dnv.agefrom, agefromtype = dnv.agefromtype ?? "-",
                    ageto = dnv.ageto, agetotype = dnv.agetotype ?? "-",
                    sex = dnv.sex ?? "Both",
                    rangetype = dnv.rangetype ?? "-", rangefrom = dnv.rangefrom, rangeto = dnv.rangeto,
                    specialconditioncode = dnv.specialconditioncode ?? "00000000-0000-0000-0000-000000000000",
                    agerangetype = dnv.agerangetype ?? "-",
                    mccode = 1, performedcount = 1, scode = 1
                }).ToList(),

                editedcalculatedformulas = ((row.EditedCalculatedFormulas != null && row.EditedCalculatedFormulas.Any()) ? row.EditedCalculatedFormulas : (row.calculatedformulas ?? emptyCF)).Select(cf => new {
                    trcfid = cf.trcfid?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                    testresultid = row.testresultid?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                    sex = cf.sex ?? "-",
                    calculatedformula = cf.calculatedformula ?? "",
                    mccode = 1, performedcount = 1, scode = 1
                }).ToList()
            }).ToList();

            // Backend expects a bare JSON array: [{...}, ...]
            var json = JsonConvert.SerializeObject(savePayload);

            // ── Auth field diagnostic (untruncated, per-row) ──────────────────
            /* Console.WriteLine($"--- SAVE RESULTS PAYLOAD AUTH FIELDS ---") */;
            foreach (var r in savePayload)
            {
                var authSnap = JsonConvert.SerializeObject(new {
                    r.slno, r.tcode, r.col2,
                    r.isauthorized1, r.isauthorized2,
                    r.resultauthorizedby, r.resultauthorizedby2,
                    r.resultenteredby, r.status
                });
                /* Console.WriteLine($"[AUTH-DIAG] {authSnap}") */;
            }
            /* Console.WriteLine($"--- END AUTH FIELDS ---") */;

            /* Console.WriteLine($"--- SAVE RESULTS PAYLOAD LOG ---") */;
            /* Console.WriteLine($"Rows: {savePayload.Count}") */;
            /* Console.WriteLine($"URL: {appSettings.BaseUrl}labresult/saveresultentry") */;
            for (int i = 0; i < savePayload.Count; i++)
            {
                var rowJson = JsonConvert.SerializeObject(savePayload[i]);
                /* Console.WriteLine($"[PAYLOAD ROW {i+1}/{savePayload.Count}] {rowJson}") */;
            }
            // ── Dump full payload to file for easy Postman copy ──────────────
            try
            {
                var dumpPath = Path.Combine(AppContext.BaseDirectory, "payload_debug.json");
                var prettyJson = Newtonsoft.Json.Linq.JArray.Parse(json).ToString(Formatting.Indented);
                File.WriteAllText(dumpPath, prettyJson);
                /* Console.WriteLine($"[PAYLOAD] Full payload written to: {dumpPath}") */;
            }
            catch (Exception dumpEx) { /* Console.WriteLine($"[PAYLOAD] File dump failed: {dumpEx.Message}") */; }
            /* Console.WriteLine($"---------------------------------") */;
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

            var saveUrl = $"{appSettings.BaseUrl}labresult/saveresultentry?custcode={CustCode}";

            var request = new HttpRequestMessage(HttpMethod.Post, saveUrl)
            {
                Content = content
            };
            
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            if (!string.IsNullOrEmpty(tenantCode))
                request.Headers.Add("tenant_code", tenantCode);

            var res = await http.SendAsync(request, SafeToken);
            /* Console.WriteLine($"[SAVE] Response: {(int)res.StatusCode} {res.StatusCode}") */;
            try
            {
                var resBody = await res.Content.ReadAsStringAsync();
                /* Console.WriteLine($"[SAVE] Response Body: {resBody}") */;
            }
            catch (Exception ex)
            {
                /* Console.WriteLine($"[SAVE] Failed to read response body: {ex.Message}") */;
            }

            if (res.IsSuccessStatusCode)
            {
                saveError = false;
                saveMessage = "✓ Results saved successfully!";
                Toast.Success("Results saved successfully!", "Result Entry");
                /* Console.WriteLine("[SAVE] SUCCESS — results persisted.") */;

                UpdateUserNames();
                await RunCalculations();
                StateHasChanged();
            }
            else
            {
                var errContent = await res.Content.ReadAsStringAsync(SafeToken);
                saveError = true;
                saveMessage = $"Save failed: {res.StatusCode} - {errContent}";
                Toast.Error(saveMessage, "Save Failed");
                /* Console.WriteLine($"[SAVE] Backend Error: {res.StatusCode} - {errContent}") */;
            }
        }
        catch (OperationCanceledException) { /* Console.WriteLine("[SAVE] Cancelled.") */; }
        catch (ObjectDisposedException) { /* Console.WriteLine("[SAVE] ObjectDisposed (safe to ignore).") */; }
        catch (Exception ex)
        {
            saveError = true;
            saveMessage = $"Error: {ex.Message}";
            Toast.Error(saveMessage, "Save Error");
            /* Console.WriteLine($"[SAVE] EXCEPTION: {ex.GetType().Name}: {ex.Message}") */;
            /* Console.WriteLine($"[SAVE] StackTrace: {ex.StackTrace?.Split('\n').FirstOrDefault()}") */;
        }
        finally
        {
            isSaving = false;
            currentSavingLevel = -1;
            StateHasChanged();

            // Auto-dismiss toast after 3 seconds
            _toastCts?.Cancel();
            _toastCts = new System.Threading.CancellationTokenSource();
            var token = _toastCts.Token;
            _ = Task.Delay(3000, token).ContinueWith(_ =>
            {
                if (!token.IsCancellationRequested)
                {
                    saveMessage = "";
                    InvokeAsync(StateHasChanged);
                }
            }, token);
        }
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/result-search");
    }

    /// <summary>Shows the current saveMessage as a toast, then auto-dismisses after 4 seconds.</summary>
    private void ShowToastThenClear()
    {
        _toastCts?.Cancel();
        _toastCts = new System.Threading.CancellationTokenSource();
        var tok = _toastCts.Token;
        _ = Task.Delay(4000, tok).ContinueWith(_ =>
        {
            if (!tok.IsCancellationRequested)
            {
                saveMessage = "";
                saveError = false;
                InvokeAsync(StateHasChanged);
            }
        }, tok);
    }
