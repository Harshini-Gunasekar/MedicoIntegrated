    /// <summary>
    /// Prints the report by calling the external LabCare API directly.
    /// Culture reports use /api/report/culture-report, lab reports use /api/report/labreport.
    /// The response is a base64-encoded PDF which is opened via JS.
    /// </summary>
    private async Task PrintReportExternal()
    {
        if (string.IsNullOrEmpty(RequestGuid)) return;

        try
        {
            isPrinting = true;
            StateHasChanged();

            // ResultEntry.razor is always for lab (non-culture) requests.
            // Culture reports are handled by CultureResultEntry.razor.
            bool isLetterHead = PrintOption == "LetterHead";
            string endpoint = $"{appSettings.BaseUrl}report/labreport?requestguid={RequestGuid}&isletterhead={isLetterHead.ToString().ToLower()}";

            var request = new HttpRequestMessage(HttpMethod.Get, endpoint);

            // Pass authentication and tenant headers
            var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
            if (userResult.Success && userResult.Value != null)
            {
                var user = userResult.Value;
                if (!string.IsNullOrEmpty(user.TenantCode))
                    request.Headers.Add("tenant_code", user.TenantCode);
                if (!string.IsNullOrEmpty(user.AuthToken))
                    request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", user.AuthToken);
            }

            var resp = await http.SendAsync(request);
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                saveError = true;
                saveMessage = $"Print failed: {err}";
                StateHasChanged();
                return;
            }

            var raw = await resp.Content.ReadAsStringAsync();
            var base64 = raw.Trim().Trim('"');
            await JSRuntime.InvokeVoidAsync("openBase64Pdf", base64);
        }
        catch (Exception ex)
        {
            saveError = true;
            saveMessage = $"Print error: {ex.Message}";
        }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

