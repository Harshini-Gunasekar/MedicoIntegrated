    private async Task UserMasterAsync()
    {
        if (_isDisposed) return;
        try
        {
            var ct = SafeToken;
            var url = $"{appSettings.BaseUrl}User/getall";
            /* Console.WriteLine($"[DIAG-USER] Requesting: {url}") */;
            /* Console.WriteLine($"[DIAG-USER] Token present: {!string.IsNullOrEmpty(token)}, TenantCode: {tenantCode}") */;
            
            var request = new HttpRequestMessage(HttpMethod.Get, url);
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            if (!string.IsNullOrEmpty(tenantCode))
                request.Headers.Add("tenant_code", tenantCode);

            var res = await http.SendAsync(request, ct);
            /* Console.WriteLine($"[DIAG-USER] Response Status: {res.StatusCode}") */;
            
            if (res.IsSuccessStatusCode)
            {
                var contentStr = await res.Content.ReadAsStringAsync(ct);
                /* Console.WriteLine($"[DIAG-USER] Response length: {contentStr?.Length ?? 0}") */;
                if (contentStr != null && contentStr.Length > 200)
                    /* Console.WriteLine($"[DIAG-USER] Snippet: {contentStr.Substring(0, 200)}") */;
                else
                    /* Console.WriteLine($"[DIAG-USER] Content: {contentStr}") */;

                usermaster = JsonConvert.DeserializeObject<IList<User_Master>>(contentStr) ?? new List<User_Master>();
                /* Console.WriteLine($"USER MASTER LOADED: {usermaster.Count} users found.") */;
            }
            else
            {
                /* Console.WriteLine($"USER MASTER FAILED: {res.StatusCode}") */;
            }

            // Fallback to fetch individual user details if getall failed, returned empty, or does not contain current logged-in user
            if (usermaster == null || usermaster.Count == 0 || !usermaster.Any(x => x.usercode == userCode))
            {
                /* Console.WriteLine($"[DIAG-USER] Running fallback for userCode {userCode}...") */;
                if (userCode > 0)
                {
                    var fallbackUrl = $"{appSettings.BaseUrl}User/get?usercode={userCode}&user_code={userCode}";
                    var fallbackReq = new HttpRequestMessage(HttpMethod.Get, fallbackUrl);
                    if (!string.IsNullOrEmpty(token))
                        fallbackReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                    if (!string.IsNullOrEmpty(tenantCode))
                        fallbackReq.Headers.Add("tenant_code", tenantCode);

                    var fallbackRes = await http.SendAsync(fallbackReq, ct);
                    /* Console.WriteLine($"[DIAG-USER] Fallback Response Status: {fallbackRes.StatusCode}") */;
                    if (fallbackRes.IsSuccessStatusCode)
                    {
                        var contentStr = await fallbackRes.Content.ReadAsStringAsync(ct);
                        /* Console.WriteLine($"[DIAG-USER] Fallback content: {contentStr}") */;
                        var singleUser = JsonConvert.DeserializeObject<User_Master>(contentStr);
                        if (singleUser != null)
                        {
                            if (usermaster == null) usermaster = new List<User_Master>();
                            var existing = usermaster.FirstOrDefault(x => x.usercode == singleUser.usercode);
                            if (existing != null) usermaster.Remove(existing);
                            usermaster.Add(singleUser);
                            /* Console.WriteLine($"[DIAG-USER] Successfully resolved user via fallback: usercode={singleUser.usercode}, name={singleUser.name}, role={singleUser.role}, module={singleUser.module}") */;
                        }
                    }
                }
            }

            // Dynamically supplement/override current user rights based on latest usermaster config
            var loggedInUserRecord = usermaster?.FirstOrDefault(x => x.usercode == userCode);
            if (loggedInUserRecord != null)
            {
                var dynRole = loggedInUserRecord.module ?? loggedInUserRecord.role?.ToString();
                if (!string.IsNullOrEmpty(dynRole))
                {
                    var dynLower = dynRole.Trim().ToLower();
                    if (dynLower == "0" || dynLower == "result entry" || dynLower == "result_entry" || dynLower == "result-entry")
                    {
                        isentered = true;
                    }
                    else if (dynLower == "1" || dynLower == "auth1" || dynLower == "auth 1" || dynLower == "auth_1" || dynLower == "auth-1")
                    {
                        isentered = true;
                        isauthorized1 = true;
                    }
                    else if (dynLower == "2" || dynLower == "auth2" || dynLower == "auth 2" || dynLower == "auth_2" || dynLower == "auth-2")
                    {
                        isentered = true;
                        isauthorized1 = true;
                        isauthorized2 = true;
                    }
                    /* Console.WriteLine($"[DEBUG] Dynamic rights updated from usermaster: Role={dynRole}, Entry={isentered}, Auth1={isauthorized1}, Auth2={isauthorized2}") */;
                    
                    try
                    {
                        var userDetailsResult = await sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                        if (userDetailsResult.Success && userDetailsResult.Value != null)
                        {
                            userDetailsResult.Value.Role = dynRole;
                            await sessionStorage.SetAsync("UserDetails", userDetailsResult.Value);
                            /* Console.WriteLine($"[DIAG-USER] Synchronized session storage UserDetails.Role with latest: {dynRole}") */;
                        }
                    }
                    catch (Exception ex)
                    {
                        /* Console.WriteLine($"[DIAG-USER] Failed to sync session storage: {ex.Message}") */;
                    }
                }
            }
            
            UpdateUserNames();
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            /* Console.WriteLine($"UserMasterAsync Error: {ex.Message}") */;
        }
    }

    private void EnsureUserLoaded(int code)
    {
        if (code <= 1 || _isDisposed) return;
        
        if (usermaster != null && usermaster.Any(x => x.usercode == code)) return;
        
        lock (_pendingUserLoads)
        {
            if (_pendingUserLoads.Contains(code)) return;
            _pendingUserLoads.Add(code);
        }

        _ = Task.Run(async () =>
        {
            try
            {
                var ct = SafeToken;
                var fallbackUrl = $"{appSettings.BaseUrl}User/get?usercode={code}&user_code={code}";
                var fallbackReq = new HttpRequestMessage(HttpMethod.Get, fallbackUrl);
                if (!string.IsNullOrEmpty(token))
                    fallbackReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                if (!string.IsNullOrEmpty(tenantCode))
                    fallbackReq.Headers.Add("tenant_code", tenantCode);

                var fallbackRes = await http.SendAsync(fallbackReq, ct);
                if (fallbackRes.IsSuccessStatusCode)
                {
                    var contentStr = await fallbackRes.Content.ReadAsStringAsync(ct);
                    var singleUser = JsonConvert.DeserializeObject<User_Master>(contentStr);
                    if (singleUser != null)
                    {
                        await InvokeAsync(() =>
                        {
                            if (_isDisposed) return;
                            if (usermaster == null) usermaster = new List<User_Master>();
                            
                            var existing = usermaster.FirstOrDefault(x => x.usercode == singleUser.usercode);
                            if (existing != null) usermaster.Remove(existing);
                            usermaster.Add(singleUser);
                            
                            UpdateUserNames();
                            StateHasChanged();
                        });
                    }
                }
            }
            catch (Exception ex)
            {
                /* Console.WriteLine($"[EnsureUserLoaded] Error resolving user code {code}: {ex.Message}") */;
            }
            finally
            {
                lock (_pendingUserLoads)
                {
                    _pendingUserLoads.Remove(code);
                }
            }
        });
    }

    private void UpdateUserNames()
    {
        if (lre1 != null && lre1.Any())
        {
            // Aggregating IDs from all rows to find any recorded authorization
            int entId = lre1.Where(x => x.resultenteredby > 0).Select(x => x.resultenteredby).FirstOrDefault();
            int auth1Id = lre1.Where(x => x.resultauthorizedby > 0).Select(x => x.resultauthorizedby).FirstOrDefault();
            int auth2Id = lre1.Where(x => x.resultauthorizedby2 > 0).Select(x => x.resultauthorizedby2).FirstOrDefault();
            
            // Try to find ANY non-zero ID if the aggregation failed
            if (entId == 0) entId = lre1.Max(x => x.resultenteredby);
            if (auth1Id == 0) auth1Id = lre1.Max(x => x.resultauthorizedby);
            if (auth2Id == 0) auth2Id = lre1.Max(x => x.resultauthorizedby2);

            // Queue background resolution for missing user details
            if (entId > 1) EnsureUserLoaded(entId);
            if (auth1Id > 1) EnsureUserLoaded(auth1Id);
            if (auth2Id > 1) EnsureUserLoaded(auth2Id);

            // Helper local function to resolve name based on usermaster, current logged-in user fallback, or Admin
            string ResolveUserName(int code)
            {
                if (code <= 0) return "";
                if (code == 1) return "Admin";
                
                // 1. Try to find in usermaster list if available
                if (usermaster != null && usermaster.Any())
                {
                    var u = usermaster.FirstOrDefault(x => x.usercode == code);
                    if (u != null && !string.IsNullOrEmpty(u.name))
                        return u.name;
                }
                
                // 2. Fallback: check if the code matches the logged-in user code
                if (code == userCode && !string.IsNullOrEmpty(currentUserName))
                {
                    return currentUserName;
                }
                
                // 3. Last resort fallback: return placeholder if loading, else the code itself
                bool isPending = false;
                lock (_pendingUserLoads)
                {
                    isPending = _pendingUserLoads.Contains(code);
                }
                return isPending ? "..." : $"User ({code})";
            }

            if (entId > 0)
                ent1 = ResolveUserName(entId);
            
            if (auth1Id > 0)
                auth1 = ResolveUserName(auth1Id);
            
            if (auth2Id > 0)
                auth2 = ResolveUserName(auth2Id);
            
            bool hasEscalationRows = lre1.Any(x => IsRowEscalated(x));
            if (hasEscalationRows)
            {
                isAuth2Finished = lre1.Where(x => IsRowEscalated(x)).All(x => x.resultauthorizedby2 == GetAssignedUserCode(x.tcode));
            }
            else
            {
                isAuth2Finished = lre1.Any(x => x.isauthorized2 || x.resultauthorizedby2 > 0);
            }
            
            StateHasChanged();
        }
    }
    private async Task LoadResults()
    {
        if (_isDisposed || string.IsNullOrEmpty(RequestGuid)) return;

        try
        {
        var ct = SafeToken;
        // Add timestamp to bypass potential caching issues
        var url = $"{appSettings.BaseUrl}labresult/loadresultentry?requestGuid={RequestGuid}&custcode={CustCode}&t={DateTime.Now.Ticks}";
        var request = new HttpRequestMessage(HttpMethod.Get, url);
        if (!string.IsNullOrEmpty(token))
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        if (!string.IsNullOrEmpty(tenantCode))
            request.Headers.Add("tenant_code", tenantCode);

        var res = await http.SendAsync(request, ct);
        if (res.IsSuccessStatusCode)
        {
            var tt = await res.Content.ReadAsStringAsync(ct);
            /* Console.WriteLine($"LOADED DATA RAW: {tt.Substring(0, Math.Min(tt.Length, 500))}...") */; 

            re = JsonConvert.DeserializeObject<ResultEntryModel>(tt) ?? new();
            if (re.results?.Any() == true)
            {
                var firstRaw = JsonConvert.SerializeObject(re.results.First());
                /* Console.WriteLine($"DEBUG - First row JSON snapshot: {firstRaw}") */;
            }

            var rawResults = re.results ?? new List<LabResultEntry>();
            var cultureTestCodes = rawResults
                .Where(x => 
                    (x.testname != null && (x.testname.Contains("Culture", StringComparison.OrdinalIgnoreCase) || x.testname.Contains("Sensitivity", StringComparison.OrdinalIgnoreCase))) ||
                    (x.groupname != null && (x.groupname.Contains("Culture", StringComparison.OrdinalIgnoreCase) || x.groupname.Contains("Sensitivity", StringComparison.OrdinalIgnoreCase))) ||
                    x.resulttype == "L" || 
                    x.resulttype == "CU" ||
                    (x.resultvaluetype != null && (x.resultvaluetype.Contains("Culture", StringComparison.OrdinalIgnoreCase) || x.resultvaluetype.Contains("Sensitivity", StringComparison.OrdinalIgnoreCase)))
                )
                .Select(x => x.tcode)
                .Distinct()
                .ToHashSet();

            lre1 = rawResults.Where(x => !cultureTestCodes.Contains(x.tcode)).ToList();
            lre1 = lre1.OrderBy(x => x.grouporder).ThenBy(x => x.orderno).ThenBy(x => x.slno).ToList();
            
            // Pre-load test configurations to get escalation and pathologist details
            if (lre1 != null && lre1.Any())
            {
                var distinctTCodes = lre1.Select(x => x.tcode).Distinct().ToList();
                foreach (var tcode in distinctTCodes)
                {
                    if (!_testConfigs.ContainsKey(tcode))
                    {
                        try
                        {
                            var config = await TestSvc.GetTestResultAsync(tcode);
                            if (config != null)
                            {
                                _testConfigs[tcode] = config;
                            }
                        }
                        catch (Exception ex)
                        {
                            /* Console.WriteLine($"Error fetching config for test {tcode}: {ex.Message}") */;
                        }
                    }
                }
            }

            // Sync normalvalue from NormalValues or ReportingMethod if empty or "Normal 0"
            foreach (var row in lre1)
            {
                // Auto-assign default method if none is set to prevent orphaned or partial data states
                if (row.rtmcode == 0 && re.methods != null && re.methods.Any())
                {
                    row.rtmcode = re.methods.First().rtmcode;
                }

                if (row.normalvalue != null) row.normalvalue = row.normalvalue.Replace("Normal 0", "").Trim();
                
                // Populate col2 with testname if empty, but protect profile/group tests where testname holds the group/profile name
                if (string.IsNullOrEmpty(row.col2) && !string.IsNullOrEmpty(row.testname))
                {
                    bool isParentTestName = row.testname.Equals(row.groupname, StringComparison.OrdinalIgnoreCase) || 
                                            row.testname.Contains("Profile", StringComparison.OrdinalIgnoreCase) || 
                                            row.testname.Contains("Panel", StringComparison.OrdinalIgnoreCase) ||
                                            row.testname.Contains("Package", StringComparison.OrdinalIgnoreCase);
                    
                    if (!isParentTestName)
                    {
                        row.col2 = row.testname;
                    }
                }

                // Ensure DetailedNormalValues required fields are never null (backend [Required] validation)
                if (row.detailednormalvalues != null)
                {
                    foreach (var dnv in row.detailednormalvalues)
                    {
                        // Normalise "Yrs" → "Years" for consistency
                        if (string.IsNullOrEmpty(dnv.agefromtype))  dnv.agefromtype  = "Years";
                        else if (dnv.agefromtype == "Yrs")          dnv.agefromtype  = "Years";
                        if (string.IsNullOrEmpty(dnv.agetotype))    dnv.agetotype    = "Years";
                        else if (dnv.agetotype == "Yrs")            dnv.agetotype    = "Years";
                        if (string.IsNullOrEmpty(dnv.agerangetype)) dnv.agerangetype = "Normal";
                        if (string.IsNullOrEmpty(dnv.sex))          dnv.sex          = "Both";
                        if (string.IsNullOrEmpty(dnv.rangetype))    dnv.rangetype    = "Normal";
                    }
                }
                
                var m = re.methods?.FirstOrDefault(x => x.rtmcode == row.rtmcode);
                string mName = m?.name ?? "";

                // If normalvalue is empty or just contains the method name (with optional decorations), try to get a better range from NormalValues
                bool isPlaceholder = string.IsNullOrWhiteSpace(row.normalvalue) || 
                                     row.normalvalue == mName || 
                                     row.normalvalue == $"({mName})" ||
                                     row.normalvalue.Trim(' ', '/', '(', ')') == "";

                if (isPlaceholder)
                {
                    // ── Build normalvalue from TextNormalValues ──────────────────────
                    if (row.textnormalvalues?.Any(x => !string.IsNullOrEmpty(x.normalvalue)) == true)
                    {
                        var nvParts = row.textnormalvalues
                            .Where(x => !string.IsNullOrEmpty(x.normalvalue))
                            .Select(x =>
                            {
                                if (string.IsNullOrEmpty(x.sex)) return x.normalvalue!;
                                var sex = x.sex.Trim();
                                var label = sex.Equals("M", StringComparison.OrdinalIgnoreCase) ? "Males" :
                                            sex.Equals("F", StringComparison.OrdinalIgnoreCase) ? "Females" :
                                            sex.Equals("Both", StringComparison.OrdinalIgnoreCase) ? "" : sex;
                                return string.IsNullOrEmpty(label) ? x.normalvalue! : $"{label} : {x.normalvalue}";
                            });
                        row.normalvalue = string.Join(" | ", nvParts);
                    }
                    // ── Build normalvalue from DetailedNormalValues (range format) ──
                    else if (row.detailednormalvalues?.Any() == true)
                    {
                        var parts = row.detailednormalvalues
                            .GroupBy(d => d.sex ?? "Both")
                            .Select(g =>
                            {
                                var first = g.First();
                                var label = (first.agerangetype ?? g.Key).Trim();
                                var rangeStr = first.rangefrom == first.rangeto
                                    ? $"{first.rangefrom}"
                                    : $"{first.rangefrom} - {first.rangeto}";
                                return $"{label}: {rangeStr}";
                            });
                        row.normalvalue = string.Join(" | ", parts);
                    }
                }
                else if (m != null && !string.IsNullOrEmpty(mName))
                {
                    // Ensure method name is included in normalvalue
                    if (!row.normalvalue.Contains(mName))
                    {
                        row.normalvalue = $"{row.normalvalue} / ({mName})";
                    }
                }
                
                // Final trim to ensure no stray slashes
                if (row.normalvalue != null) row.normalvalue = row.normalvalue.Trim(' ', '/');
            }

            uom = re.units ?? new List<UOM_MASTER>();
            sample = re.samples ?? new List<Sample_Master>();
            machine = re.machines ?? new List<Machine_Master>();
            method = re.methods ?? new List<REPORT_METHOD>();

            // Build group list — distinct gcode + groupname from lre1
            groupList = lre1
                .Where(x => x.gcode > 0 && !string.IsNullOrWhiteSpace(x.groupname))
                .GroupBy(x => x.gcode)
                .Select(g => new GroupItem { gcode = g.Key, groupname = g.First().groupname! })
                .OrderBy(g => g.groupname)
                .ToList();

            // Build billed test list scoped to current group (default: All Groups)
            billedTestSelections = BuildBilledTestSelections(SelectedGroupCode);

            // Apply active filters to the newly loaded data
            ApplyUnifiedFilter();
            
            // Trigger calculations for any pre-filled data
            _ = RunCalculations();
            
            UpdateUserNames();
        }
        else
        {
            var tt = await res.Content.ReadAsStringAsync(ct);
            /* Console.WriteLine($"LoadResults failed: {res.StatusCode} - {tt}") */;
        }
        StateHasChanged();
        } // end try
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception ex) { /* Console.WriteLine($"LoadResults Error: {ex.Message}") */; }
    }


