    private async Task SelectRow(LabResultEntry row)
    {
        if (row == null) return;
        SelectedRowEntry = row;
        
        try 
        {
            // Update UI properties immediately with what we have
            SyncRowToUI(row);

            // Fetch fully populated details from the API
            var request = new HttpRequestMessage(HttpMethod.Get, $"{appSettings.BaseUrl}labresult/LoadTestResultDetails?testresultid={row.testresultid}");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            if (!string.IsNullOrEmpty(tenantCode))
                request.Headers.Add("tenant_code", tenantCode);

            var res = await http.SendAsync(request, _cts.Token);
            if (res.IsSuccessStatusCode)
            {
                var tt = await res.Content.ReadAsStringAsync();
                var detailedData = JsonConvert.DeserializeObject<TestResultDetailsModel>(tt);
                
                // Prioritize 'Properties' list if populated, otherwise map from 'LabProperties'
                LabResultEntry? detailedRow = null;
                
                if (detailedData?.properties?.Any() == true)
                {
                    var p = detailedData.properties.First();
                    detailedRow = new LabResultEntry
                    {
                        resultvaluetype = p.resultvaluetype,
                        normalvalue = p.normalvalue,
                        simplenv = p.simplenormalvalues ?? false,
                        detailednv = p.detailednormalvalues ?? false,
                        showagedbased = p.showagedbased ?? false,
                        rtmcode = p.rtmcode ?? 0,
                        decimalvalue = p.decimalvalue ?? 0,
                        showalertonhigherlower = p.showalertonhigherlower ?? false,
                        footermessage = p.footermessage
                    };
                }
                
                if (detailedRow == null && detailedData?.labproperties?.Any() == true)
                {
                    var lp = detailedData.labproperties.First();
                    detailedRow = new LabResultEntry
                    {
                        resultvaluetype = lp.resultvaluetype,
                        normalvalue = lp.normalvalue,
                        simplenv = lp.simplenormalvalues ?? false,
                        detailednv = lp.detailednormalvalues ?? false,
                        showagedbased = lp.showagedbased ?? false,
                        rtmcode = lp.rtmcode ?? 0,
                        decimalvalue = lp.decimalvalue ?? 0,
                        showalertonhigherlower = lp.showalertonhigherlower ?? false,
                        footermessage = lp.footermessage,
                        printconclusioninreport = lp.printconclusioninreport ?? false,
                        conclusionforfixedtext = lp.conclusionforfixedtext,
                        printnormalvaluesatbottom = lp.printnormalvaluesatbottom ?? false,
                        printunitsinnormalvalues = lp.printunitsinnormalvalues ?? false,
                        groupvaluesbysex = lp.groupvaluesbysex ?? false,
                        groupvaluesbyspecialfield = lp.groupvaluesbyspecialfield ?? false,
                        printconclusioninbottom = lp.printconclusioninbottom ?? false,
                        conclusionforlower = lp.conclusionforlower,
                        conclusionforhigher = lp.conclusionforhigher,
                        isgraph = lp.isgraph,
                        graphvalue = lp.graphvalue,
                        defaultvalue = lp.defaultvalue
                    };
                }
                
                if (detailedRow != null)
                {
                    // Update our row reference with fetched details
                    row.resultvaluetype = detailedRow.resultvaluetype ?? row.resultvaluetype;
                    row.normalvalue = detailedRow.normalvalue ?? row.normalvalue;
                    row.simplenv = detailedRow.simplenv;
                    row.detailednv = detailedRow.detailednv;
                    row.calculatedformula = detailedRow.calculatedformula ?? row.calculatedformula;
                    row.fixedvalues = detailedRow.fixedvalues ?? row.fixedvalues;
                    row.unitname = detailedRow.unitname ?? row.unitname;
                    row.machinename = detailedRow.machinename ?? row.machinename;
                    row.samplename = detailedRow.samplename ?? row.samplename;
                    
                    // Sync rtmcode from DB if available
                    if (detailedRow.rtmcode > 0) row.rtmcode = detailedRow.rtmcode;

                    // Sync advanced parameters
                    row.decimalvalue = detailedRow.decimalvalue;
                    row.showalertonhigherlower = detailedRow.showalertonhigherlower;
                    row.normalvalue = detailedRow.normalvalue ?? row.normalvalue;
                    row.footermessage = detailedRow.footermessage ?? row.footermessage;
                    row.printconclusioninreport = detailedRow.printconclusioninreport;
                    row.conclusionforfixedtext = detailedRow.conclusionforfixedtext ?? row.conclusionforfixedtext;
                    row.printnormalvaluesatbottom = detailedRow.printnormalvaluesatbottom;
                    row.printunitsinnormalvalues = detailedRow.printunitsinnormalvalues;
                    row.showagedbased = detailedRow.showagedbased;
                    row.printspecialfieldsatrightside = detailedRow.printspecialfieldsatrightside;
                    row.groupvaluesbyspecialfield = detailedRow.groupvaluesbyspecialfield;
                    row.groupvaluesbysex = detailedRow.groupvaluesbysex;
                    row.defaultvalue = detailedRow.defaultvalue ?? row.defaultvalue;
                    row.printconclusioninbottom = detailedRow.printconclusioninbottom;
                    row.conclusionforlower = detailedRow.conclusionforlower ?? row.conclusionforlower;
                    row.conclusionforhigher = detailedRow.conclusionforhigher ?? row.conclusionforhigher;
                    row.isgraph = detailedRow.isgraph;
                    row.graphvalue = detailedRow.graphvalue;

                    // Prioritize lab-prefixed collections from API
                    row.textnormalvalues = (detailedData?.labtextnormalvalues?.Any() == true) 
                        ? detailedData.labtextnormalvalues.Select(x => new Lab_Result_TextNormalValues { trtid = x.trtid, testresultid = x.testresultid, sex = x.sex, normalvalue = x.normalvalue }).ToList() 
                        : (detailedData?.textnormalvalues?.Select(x => new Lab_Result_TextNormalValues { trtid = x.trtid, testresultid = x.testresultid, sex = x.sex, normalvalue = x.normalvalue }).ToList() ?? new());

                    row.detailednormalvalues = (detailedData?.labdetailedNormalvalues?.Any() == true) 
                        ? detailedData.labdetailedNormalvalues.Select(x => new Lab_Result_DetailedNormalValues { dnvid = x.trdnid, testresultid = x.testresultid, sno = x.sno ?? 0, agefrom = x.agefrom ?? 0, agefromtype = x.agefromtype, ageto = x.ageto ?? 0, agetotype = x.agetotype, sex = x.sex, rangetype = x.rangetype, rangefrom = x.rangefrom ?? 0, rangeto = x.rangeto ?? 0 }).ToList() 
                        : (detailedData?.detailedNormalvalues?.Select(x => new Lab_Result_DetailedNormalValues { dnvid = x.trdnid, testresultid = x.testresultid, sno = x.sno ?? 0, agefrom = x.agefrom ?? 0, agefromtype = x.agefromtype, ageto = x.ageto ?? 0, agetotype = x.agetotype, sex = x.sex, rangetype = x.rangetype, rangefrom = x.rangefrom ?? 0, rangeto = x.rangeto ?? 0 }).ToList() ?? new());

                    row.calculatedformulas = (detailedData?.labcalculatedformulas?.Any() == true) 
                        ? detailedData.labcalculatedformulas.Select(x => new Lab_Result_CalculatedFormula { trcfid = x.trcfid, testresultid = x.testresultid, sex = x.sex, calculatedformula = x.calculatedformula }).ToList() 
                        : (detailedData?.calculatedformulas?.Select(x => new Lab_Result_CalculatedFormula { trcfid = x.trcfid, testresultid = x.testresultid, sex = x.sex, calculatedformula = x.calculatedformula }).ToList() ?? new());
                    
                    // Re-sync UI state after fetch
                    SyncRowToUI(row);
                }
            }
        }
        catch (Exception)
        {
        }
        
        StateHasChanged();
    }

