@page "/counter-master"
@using LabCare.Models
@using LIMS_Backend.Model
@using System.Net.Http.Json
@rendermode InteractiveServer
@inject IHttpClientFactory ClientFactory
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject LabCare.Services.CounterService CounterSvc
@inject LabCare.Services.NotificationService Toast
@inject LabCare.Services.TenantSessionState TenantState
@inject NavigationManager NavigationManager

<div class="referral-page">

    <div class="lab-header-card flex-between">
        <div>
            <h2 class="lab-title-text m-0">Counter Master</h2>
            <p class="font-14 text-slate-400 font-600 m-0">POS Configuration</p>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Quick find..." @bind="SearchQuery" @bind:event="oninput" class="search-input-field" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewCounter">+ New Counter Entry</button>
            </div>
        </div>
    </div>

    

    @if (showForm)
    {
            <div class="modal-overlay">
                <div class="modal-form-card">
                    <div class="modal-header-bar">
                        <h3>@(isEditMode ? "Edit Counter" : "New Counter Entry")</h3>
                        <button type="button" class="modal-close-btn" @onclick="CloseForm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                            </svg>
                        </button>
                    </div>
                    <div class="modal-body">
                        
                        <div class="mb-0 form-section">
                            <div class="mt-0">
                                <div class="um-grid-row">
                                    <div class="form-group position-relative">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                            <label style="margin-bottom: 0;">Counter Name</label>
                                            @if (isSubmitted && string.IsNullOrEmpty(CurrentCounter.name))
                                            {
                                                <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                            }
                                        </div>
                                        <input type="text" @bind="CurrentCounter.name" class="lab-input font-bold" placeholder="Ex: Reception A" @(isSubmitted && string.IsNullOrEmpty(CurrentCounter.name) ? "is-invalid" : "") required />
                                    </div>
                                </div>
                                <div class="form-row form-cols-3 mt-3">
                                    <div class="form-group">
                                        <label>Display Order</label>
                                        <input type="number" @bind="CurrentCounter.orderno" class="lab-input" />
                                    </div>
                                    <div class="form-group">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                            <label style="margin-bottom: 0;">Short Name</label>
                                            @if (isSubmitted && string.IsNullOrEmpty(CurrentCounter.shortname))
                                            {
                                                <span class="text-danger" style="font-size: 11px; font-weight: 500;">Required</span>
                                            }
                                        </div>
                                        <input type="text" @bind="CurrentCounter.shortname" class="lab-input" placeholder="Ex: PH-01" @(isSubmitted && string.IsNullOrEmpty(CurrentCounter.shortname) ? "is-invalid" : "") required />
                                    </div>
                                    <div class="form-group">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                            <label style="margin-bottom: 0;">Associated Branch</label>
                                            @if (isSubmitted && CurrentCounter.bhcode == 0)
                                            {
                                                <span class="text-danger" style="font-size: 11px; font-weight: 500;">Required</span>
                                            }
                                        </div>
                                        <select @bind="CurrentCounter.bhcode" class="lab-input font-bold @(isSubmitted && CurrentCounter.bhcode == 0 ? "is-invalid" : "")" required>
                                            <option value="">-- Select Branch --</option>
                                            @foreach (var branch in Branches)
                                            {
                                                <option value="@branch.bhcode">@branch.name (@branch.shortname)</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                
                                
                                
                                <div class="form-row form-cols-3 mt-3">
                                    <div class="form-group">
                                        <label>Expense Code</label>
                                        <input type="text" class="lab-input" placeholder="EXP-001" />
                                    </div>
                                    <div class="form-group">
                                        <label>Cash Ledger</label>
                                        <input type="text" class="lab-input" placeholder="CASH-01" />
                                    </div>
                                    <div class="form-group">
                                        <label>Bill Ledger</label>
                                        <input type="text" class="lab-input" />
                                    </div>
                                </div>

                                
                                
                                <div class="form-row mt-3 form-cols-2">
                                    <div class="form-group w-100">
                                        <label>Counter Description</label>
                                        <input type="text" class="lab-input" placeholder="Specify any specific instructions..." />
                                    </div>
                                    <div class="form-group">
                                        <label>Counter Color</label>
                                        <div class="color-input-container">
                                            <input type="color" value="@(CurrentCounter.bcolor != null ? DecimalToHex((decimal)CurrentCounter.bcolor) : "#4169E1")" 
                                                   @onchange="(e) => CurrentCounter.bcolor = ConvertColorToDecimal(e.Value?.ToString() ?? string.Empty)"
                                                   class="branch-color-input" />
                                            <span style="font-size: 12px; font-weight: 700; color: #64748b;">@(CurrentCounter.bcolor != null ? DecimalToHex((decimal)CurrentCounter.bcolor) : "#4169E1")</span>
                                        </div>
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-bar">
                        <button type="button" class="btn-delete" @onclick="() => HandleDelete(CurrentCounter.cntcode)" disabled="@(CurrentCounter.cntcode == null)">
                            Delete
                        </button>
                        <button type="button" class="btn-save" @onclick="SaveCounter" disabled="@IsLoading">
                             @if (IsLoading)
                             {
                                 <span>Saving...</span>
                             }
                             else
                             {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="btn-icon-mr">
                                    <path d="M11.354 1.646a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708 0l-3-3a.5.5 0 1 1 .708-.708L5.5 6.293l5.646-5.647a.5.5 0 0 1 .708 0z" />
                                </svg>
                                <span>Save Counter</span>
                             }
                        </button>
                    </div>
                </div>
            </div>
        }

    <!-- Directory List -->
    <div class="directory-section">
        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th>ORDER NO</th>
                        <th>SHORT NAME</th>
                        <th>COUNTER NAME</th>
                        <th>BRANCH NAME</th>
                        <th>NARRATION</th>
                        <th>ENTERED DATE</th>
                        <th>MODIFIED DATE</th>
                        <th class="text-center" style="width: 128px;">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsLoading && !Counters.Any())
                    {
                        <tr>
                            <td colspan="5" style="padding: 48px; text-align: center; color: #64748b;">Loading Counters...</td>
                        </tr>
                    }
                    else if (!FilteredCounters.Any())
                    {
                        <tr>
                            <td colspan="5" style="padding: 48px; text-align: center; color: #64748b; font-style: italic;">No counters found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var counter in FilteredCounters)
                        {
                            <tr>
                                <td style="font-weight: 700; color: #4f46e5;">@counter.orderno</td>
                                <td style="color: #64748b; font-family: monospace;">@counter.shortname</td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <div class="table-status-indicator" style="background: @(counter.bcolor != null ? DecimalToHex((decimal)counter.bcolor) : "#4f46e5")"></div>
                                        <span style="font-weight: 600; color: #1e293b;">@counter.name</span>
                                    </div>
                                </td>
                                <td>@(Branches.FirstOrDefault(b => b.bhcode == counter.bhcode)?.name ?? counter.bhcode.ToString())</td>
                                <td>@counter.description</td>
                                
                                <td>@($"{counter.entereddate:MM/dd/yyyy hh:mm tt}")</td>
                                <td>@($"{counter.ibsdate:MM/dd/yyyy hh:mm tt}")</td>
                                <td class="text-center">
                                    <button @onclick="() => EditCounter(counter)" class="btn-action btn-edit" title="Edit"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg></button>
                                    <button @onclick="() => HandleDelete(counter.cntcode)" class="btn-action btn-delete-action" title="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" /><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" /></svg></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public UserDetailsModel? UserSession { get; set; }

    private CounterModel CurrentCounter = new CounterModel();
    private List<CounterModel> Counters = new List<CounterModel>();
    private List<BranchModel> Branches = new List<BranchModel>();
    private string SearchQuery = "";
    private string AlertMessage = "";
    private bool IsError = false;
    private bool IsLoading = false;
    private AppSettings _appSettings = new();
    private string? UserToken;
    private string TenantCode = "";
    private string TenantName = "";
    private bool ShowOnlyActive = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private bool isEditMode = false;

    private string BaseUrl => _appSettings.BaseUrl;

    private bool IsActive 
    { 
        get => !(CurrentCounter.deleted ?? false); 
        set => CurrentCounter.deleted = !value; 
    }

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
        
        if (UserSession != null)
        {
            TenantCode = UserSession.TenantCode ?? "";
            TenantName = UserSession.TenantName ?? "";
            UserToken = UserSession.AuthToken;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        
        IsLoading = true;
        StateHasChanged();
        
        try
        {
            if (string.IsNullOrEmpty(UserToken) && UserSession == null)
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                UserToken = tokenResult.Success ? tokenResult.Value : "";
            }
            
            if (string.IsNullOrEmpty(UserToken))
            {
                NavigationManager.NavigateTo("/");
                return;
            }

            // Ensure global state is synced
            TenantState.SetSession(TenantCode, UserToken, TenantName);
        }
        catch (Exception ex)
        {
            ShowAlert($"Failed to read session data. Error: {ex.Message}", true);
            IsLoading = false;
            StateHasChanged();
            return;
        }

        await LoadBranches();
        await LoadCounters();

        IsLoading = false;
        StateHasChanged();
    }


    private IEnumerable<CounterModel> FilteredCounters =>
        Counters.Where(c =>
            (!ShowOnlyActive || !(c.deleted ?? false)) &&
            (string.IsNullOrWhiteSpace(SearchQuery) ||
             (c.name != null && c.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
             (c.shortname != null && c.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))));

    private HttpClient CreateClient() 
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(UserToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", UserToken);
        }
        return client;
    }

    private async Task LoadBranches()
    {
        try
        {
            Branches = await CounterSvc.GetCountersAsync().ContinueWith(t => new List<BranchModel>()); // Just fallback, we need a BranchService really
            // For now, keep the manual fetch for branches if not in CounterSvc
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}Branch/get");
            if (response.IsSuccessStatusCode)
            {
                Branches = await response.Content.ReadFromJsonAsync<List<BranchModel>>() ?? new List<BranchModel>();
            }
        }
        catch (Exception) { }
    }

    private async Task LoadCounters()
    {
        IsLoading = true;
        try { Counters = await CounterSvc.GetCountersAsync(); }
        catch (Exception ex) { Toast.Error($"Failed to load counters: {ex.Message}"); }
        finally { IsLoading = false; StateHasChanged(); }
    }

    private void NewCounter()
    {
        CurrentCounter = new CounterModel { orderno = Counters.Count + 1, timingfixed = true };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveCounter()
    {
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(CurrentCounter.name) || CurrentCounter.bhcode == 0) {
            Toast.Warning("Please fill required fields");
            return;
        }

        IsLoading = true;
        try
        {
            CurrentCounter.tenant_code = TenantCode;
            CurrentCounter.entereddate = DateTime.Now;

            bool ok = CurrentCounter.cntcode == null ? await CounterSvc.InsertCounterAsync(CurrentCounter) : await CounterSvc.UpdateCounterAsync(CurrentCounter);
            if (ok) {
                Toast.Success("Counter saved successfully");
                showForm = false;
                await LoadCounters();
            } else Toast.Error("Failed to save counter");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { IsLoading = false; }
    }

    private async Task HandleDelete(long? cntcode)
    {
        if (cntcode == null) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this counter?")) return;

        IsLoading = true;
        try {
            if (await CounterSvc.SoftDeleteCounterAsync(cntcode.Value)) {
                Toast.Success("Counter deleted");
                await LoadCounters();
                showForm = false;
            } else Toast.Error("Delete failed");
        } catch (Exception ex) { Toast.Error(ex.Message); }
        finally { IsLoading = false; }
    }

    // --- Timing Functionality ---
    private CounterModel? SelectedCounter;
    private List<CounterTimingModel> TimingList = new();
    private CounterTimingModel NewTiming = new();
    
    // UI Helpers for Time Picking
    private DateTime TimingFromDateOnly { get; set; } = DateTime.Today.AddHours(9);
    private DateTime TimingToDateOnly { get; set; } = DateTime.Today.AddHours(18);

    private async Task OpenTimingModal(CounterModel counter)
    {
        SelectedCounter = counter;
        TimingList = new();
        NewTiming = new CounterTimingModel { 
            cntcode = (int?)counter.cntcode, 
            bhcode = counter.bhcode,
            counterdate = DateTime.Today,
            shiftsno = 1
        };
        await LoadTimings();
    }

    private async Task LoadTimings()
    {
        if (SelectedCounter?.cntcode == null) return;
        TimingList = await CounterSvc.GetCounterTimingsAsync(SelectedCounter.cntcode.Value);
    }

    private async Task SaveTiming()
    {
        if (SelectedCounter == null) return;
        
        // Combine date and time
        var d = NewTiming.counterdate ?? DateTime.Today;
        NewTiming.fromdate = new DateTime(d.Year, d.Month, d.Day, TimingFromDateOnly.Hour, TimingFromDateOnly.Minute, 0);
        NewTiming.todate = new DateTime(d.Year, d.Month, d.Day, TimingToDateOnly.Hour, TimingToDateOnly.Minute, 0);
        NewTiming.tenant_code = TenantCode;
        NewTiming.cnttid = Guid.NewGuid();

        if (await CounterSvc.InsertCounterTimingAsync(NewTiming))
        {
            Toast.Success("Timing added");
            await LoadTimings();
            NewTiming.shiftsno++; // Increment for next entry
        }
        else Toast.Error("Failed to add timing");
    }

    private async Task DeleteTiming(Guid cnttid)
    {
        if (cnttid == Guid.Empty) return;
        if (await CounterSvc.DeleteCounterTimingAsync(cnttid))
        {
            Toast.Success("Deleted");
            await LoadTimings();
        }
        else Toast.Error("Delete failed");
    }

    private void EditCounter(CounterModel counter) {
        CurrentCounter = System.Text.Json.JsonSerializer.Deserialize<CounterModel>(System.Text.Json.JsonSerializer.Serialize(counter)) ?? new CounterModel();
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
        AlertMessage = "";
    }

    private void CloseForm() {
        CurrentCounter = new CounterModel();
        showForm = false;
        isSubmitted = false;
        AlertMessage = "";
    }

    private void ShowAlert(string msg, bool error) {
        AlertMessage = msg;
        IsError = error;
        StateHasChanged();
    }

    private decimal ConvertColorToDecimal(string hex) {
        if (string.IsNullOrEmpty(hex)) return 0;
        try { return (decimal)int.Parse(hex.Replace("#", ""), System.Globalization.NumberStyles.HexNumber); }
        catch { return 0; }
    }

    private string DecimalToHex(decimal dec) {
        try { return "#" + ((int)dec).ToString("X6"); }
        catch { return "#4169E1"; }
    }
}