@page "/feetypemaster"
@using LabCare.Components.Layout
@using LabCare.Models
@using Newtonsoft.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject LabCare.Services.TenantSessionState TenantState
@inject LabCare.Services.NotificationService Toast

<div class="referral-page">
    <div class="lab-header-card flex-between">
        <div class="gap-16 display-flex align-center">
            <div class="p-2 bg-indigo-50 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="text-white material-symbols-outlined icon-lg">payments</span>
            </div>
            <div>
                <h2 class="m-0 lab-title-text">Feetype Master</h2>
                <div class="gap-8 flex-start mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Financial configuration</span>
                </div>
            </div>
        </div>
        <div class="search-controls">
            <button class="btn-new-entry" @onclick="NewFeetype">+ Add New</button>
        </div>
    </div>
    @if (showForm)
    {
            <div class="modal-overlay">
                <div class="modal-form-card">
                    <div class="modal-header-bar">
                        <h3>@(isEditMode ? "Edit Feetype" : "New Feetype Entry")</h3>
                        <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                            </svg>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-0 form-section">
                            <div class="mt-0">
                                <div class="um-grid-row">
                                    <div class="form-group position-relative">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                            <label style="margin-bottom: 0;">Feetype Name</label>
                                            @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                            {
                                                <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                            }
                                        </div>
                                        <input type="text" class="lab-input" @bind="current.name" @bind:event="oninput" @onfocus="() => showFeetypeDropdown = true" @onblur="HideFeetypeDropdown" placeholder="Search or Edit Feetype Name" @(isSubmitted && string.IsNullOrEmpty(current.name) ? "is-invalid" : "") required />
                                        @if (showFeetypeDropdown && !string.IsNullOrWhiteSpace(current.name) && !isEditMode)
                                        {
                                            var matchedFeeTypes = feeTypes
                                                .Where(c => c.name != null && c.name.Contains(current.name, StringComparison.OrdinalIgnoreCase))
                                                .ToList();

                                            if (matchedFeeTypes.Any())
                                            {
                                                <div class="master-search-dropdown show">
                                                    @foreach (var c in matchedFeeTypes)
                                                    {
                                                        <button type="button" class="master-search-item" @onmousedown="() => SelectExistingFeetype(c)">
                                                            @c.name
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="um-grid-cols-3">
                                    <div class="form-group">
                                        <label>Order no</label>
                                        <input type="number" class="lab-input" @bind="current.orderno" placeholder="01" />
                                    </div>
                                    <div class="form-group">
                                        <label>Short Name</label>
                                        <input type="text" class="lab-input" @bind="current.shortname" />
                                    </div>
                                    <div class="form-group">
                                        <label>Narration</label>
                                        <input type="text" class="lab-input" @bind="current.description" placeholder="" />
                                    </div>
                                </div>
                                <div class="mt-16 form-group grid-col-full">
                                    <label>Rate Type Selection</label>
                                    <div class="radio-group-container">
                                        <label class="radio-label-inline">
                                            <input type="radio" name="modelRateType" checked="@(current.iscommission == true)" @onchange="@(() => HandleRateSelectionChange("Commission"))" />
                                            Commission Rate
                                        </label>
                                        <label class="radio-label-inline">
                                            <input type="radio" name="modelRateType" checked="@(current.isscheme == true)" @onchange="@(() => HandleRateSelectionChange("Scheme"))" />
                                            Scheme Rate
                                        </label>
                                        <label class="radio-label-inline">
                                            <input type="radio" name="modelRateType" checked="@(current.isspecial == true)" @onchange="@(() => HandleRateSelectionChange("Special"))" />
                                            Special Rate
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-bar">
                        <button type="button"
                                class="btn-delete"
                                @onclick="() => SoftDeleteFeetype(current.ftcode)"
                                disabled="@(current.ftcode == 0 || current.ftcode == null)">
                            Delete
                        </button>
                        <button type="button" class="btn-save" @onclick="SaveFeetype">
                             <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                                <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                            </svg>
                            Save Feetype
                        </button>
                    </div>
                </div>
            </div>
    }

    <div class="directory-section" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-top: -4px;">

        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th>ORDER NO</th>
                        <th>SHORT NAME</th>
                        <th>FEETYPE NAME</th>
                        <th>NARRATION</th>
                        <th>ENTERED DATE</th>
                        <th>IBSDATE DATE</th>
                        <th class="text-center">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (filteredFeeTypes != null && filteredFeeTypes.Any())
                    {
                        @foreach (var co in filteredFeeTypes)
                        {
                            <tr class="@(co.deleted ? "opacity-50 grayscale" : "")">
                                <td><span class="td-order-no">@(co.orderno?.ToString("00") ?? "00")</span></td>
                                <td>@co.shortname</td>
                                <td><span class="td-name">@co.name</span></td>
                                <td><span class="td-narration">@co.description</span></td>
                                <td>@(co.entereddate.ToString("M/d/yyyy h:mm tt"))</td>
                                <td>@(co.ibsdate.ToString("M/d/yyyy h:mm tt"))</td>
                                <td class="text-center">
                                    <button type="button" class="btn-action btn-edit" @onclick="() => EditFeetype(co)" title="Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg>
                                    </button>
                                    <button type="button" class="btn-action btn-delete-action" @onclick="() => SoftDeleteFeetype(co.ftcode)" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="p-24 text-center td-narration">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<FeetypeModel> feeTypes = new List<FeetypeModel>();
    private string SelectedFilterRate { get; set; } = "All";

    private List<FeetypeModel> filteredFeeTypes
    {
        get
        {
            var query = displayActiveOnly ? feeTypes.Where(c => c.deleted != true) : feeTypes;

            if (SelectedFilterRate == "Commission")
                query = query.Where(c => c.iscommission == true);
            else if (SelectedFilterRate == "Scheme")
                query = query.Where(c => c.isscheme == true);
            else if (SelectedFilterRate == "Special")
                query = query.Where(c => c.isspecial == true);

            return query.ToList();
        }
    }

    private FeetypeModel current = new FeetypeModel();
    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;
    private bool isEditMode = false;
    private bool displayActiveOnly = true;
    private bool showForm = false;
    private bool isSubmitted = false;
    private bool showFeetypeDropdown = false;

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    await LoadFeeTypes();
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                /* Console.WriteLine($"Error getting tenant data: {ex.Message}") */;
            }
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        return client;
    }

    private async Task LoadFeeTypes()
    {
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}Feetype/get";
            var result = await client.GetFromJsonAsync<List<FeetypeModel>>(url);
            feeTypes = result ?? new List<FeetypeModel>();
            if (!feeTypes.Any())
            {
                /* Console.WriteLine("Warning: Feetype/get returned 0 records.") */;
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error loading fee types: {ex.Message}");
            Console.Error.WriteLine(ex);
        }
    }

    private void NewFeetype()
    {
        current = new FeetypeModel();
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private async Task EditFeetype(FeetypeModel co)
    {
        if (co == null) return;
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}Feetype/getbyid?ftcode={co.ftcode}";
            current = await client.GetFromJsonAsync<FeetypeModel>(url) ?? new FeetypeModel();
        }
        catch (Exception)
        {
            current = JsonConvert.DeserializeObject<FeetypeModel>(JsonConvert.SerializeObject(co)) ?? new FeetypeModel();
        }
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveFeetype()
    {
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(current.name))
        {
            Toast.Error("Feetype Name is required.");
            return;
        }

        if (string.IsNullOrWhiteSpace(current.shortname))
        {
            Toast.Error("Short Name is required.");
            return;
        }

        // Duplicate check
        if (feeTypes.Any(f => f.name?.Trim().Equals(current.name?.Trim(), StringComparison.OrdinalIgnoreCase) == true && f.ftcode != current.ftcode))
        {
            Toast.Error($"A fee type with name '{current.name}' already exists.");
            return;
        }

        try
        {
            current.tenant_code = TenantCode;
            current.entereddate = DateTime.Now;
            current.ibsdate = DateTime.Now;

            using var client = CreateClient();
            if (isEditMode)
            {
                var url = $"{BaseUrl}Feetype/update";
                var response = await client.PostAsJsonAsync(url, current);
                response.EnsureSuccessStatusCode();
                Toast.Success("Fee type updated successfully.");
            }
            else
            {
                var url = $"{BaseUrl}FeeType/insert";
                var response = await client.PostAsJsonAsync(url, current);
                response.EnsureSuccessStatusCode();
                Toast.Success("Fee type added successfully.");
            }
            await LoadFeeTypes();
            NewFeetype();
            showForm = false;
        }
        catch (Exception ex)
        {
            Toast.Error($"Error saving fee type: {ex.Message}");
            Console.Error.WriteLine(ex);
        }
    }

    private async Task SoftDeleteFeetype(int? feetypecode = null)
    {
        if (!feetypecode.HasValue && current != null)
        {
            feetypecode = current.ftcode;
        }
        if (!feetypecode.HasValue || feetypecode.Value == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this fee type?"))
        {
            try
            {
                using var client = CreateClient();
                var url = $"{BaseUrl}FeeType/delete?ftcode={feetypecode.Value}";
                var response = await client.GetAsync(url);
                response.EnsureSuccessStatusCode();
                await LoadFeeTypes();
                Toast.Success("Fee type deleted successfully.");
                
                if (current != null && current.ftcode == feetypecode)
                {
                    NewFeetype();
                }
            }
            catch (Exception ex)
            {
                Toast.Error($"Error deleting fee type: {ex.Message}");
                Console.Error.WriteLine($"Error deleting fee type: {ex.Message}");
            }
        }
    }

    private void CloseForm()
    {
        current = new FeetypeModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }

    private void HandleRateSelectionChange(string selection)
    {
        if (current != null)
        {
            current.iscommission = (selection == "Commission");
            current.isscheme = (selection == "Scheme");
            current.isspecial = (selection == "Special");
        }
    }

    private async Task HideFeetypeDropdown()
    {
        await Task.Delay(200);
        showFeetypeDropdown = false;
        StateHasChanged();
    }

    private void SelectExistingFeetype(FeetypeModel existingFeetype)
    {
        showFeetypeDropdown = false;
        _ = EditFeetype(existingFeetype);
    }
}