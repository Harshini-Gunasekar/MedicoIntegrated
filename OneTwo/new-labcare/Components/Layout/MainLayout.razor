@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using LabCare.Models
@using LabCare.Services

<div class="flex h-screen overflow-hidden bg-slate-50">
    <!-- Sidebar / Navigation -->
    <NavMenu />

    <ToastNotification @rendermode="InteractiveServer" />

    <!-- Main Content -->
    <main id="main-content" class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Premium Top Bar -->
        
        <div class="flex-1 p-0 overflow-y-auto bg-slate-50">
            @Body
        </div>
    </main>
</div>

@code {
    // Session state management moved to NavMenu for stability in SSR layout
}
