@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using LabCare.Models
@using LabCare.Services
@using SharedComponents.Rcl.Models
@namespace LabCare.Components.Layout
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager NavigationManager
@inject TenantSessionState TenantState
@rendermode InteractiveServer
@implements IDisposable

<div id="sidebar" class="sidebar-wrapper">
    <!-- Branding Row -->
    <div class="sidebar-branding">
        <div class="logo-box">
            <span class="material-symbols-outlined">science</span>
        </div>
        <div class="logo-text nav-text-fade">
            <span class="main-title">LabCare <span class="highlight">Elite</span></span>
            <span class="sub-title">Clinical Intelligence</span>
        </div>
    </div>

    <!-- Toggle arrow -->
    <button id="nav-toggle-btn"
            class="sidebar-toggle-btn"
            @onclick="ToggleSidebar"
            title="@(isCollapsed ? "Expand Sidebar" : "Collapse Sidebar")">
        <span class="material-symbols-outlined lc-font-16">
            @(isCollapsed ? "chevron_right" : "chevron_left")
        </span>
    </button>

    @if (UserData != null)
    {
        <div class="px-4 mb-2 nav-text-fade">
            <div class="p-3">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-indigo-100 flex-shrink-0 flex items-center justify-center font-bold text-indigo-600 shadow-sm">
                        @(UserData.UserName?[0].ToString().ToUpper() ?? "U")
                    </div>
                    <div class="min-width-0">
                        <p class="text-[11px] text-slate-500 font-medium">@UserData.Role</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="menu-scroll no-scrollbar">
        @if (HasRight("Reception", "Billing") ||
             HasRight("Reception", "Due Collection") ||
             HasRight("OP", "Patient Registration OP") ||
             HasRight("IP", "Patient Registration IP") ||
             HasRight("Reception", "Refferal Case & Collection") ||
             HasRight("Configuration", "General") ||
             HasRight("Accounts", "Cash Entry") ||
             HasRight("Accounts", "Petty Cash"))
        {
            <div class="menu-group">
                <div class="group-label nav-text-fade">Reception</div>
                <nav class="v-nav">
                    @if (HasRight("Reception", "Billing"))
                    {
                        <NavLink class="v-nav-link" href="/billing" data-title="New Billing">
                            <span class="material-symbols-outlined mr-3">receipt_long</span>
                            <span class="nav-link-text">New Billing</span>
                        </NavLink>
                        <NavLink class="v-nav-link" href="/view-bills" data-title="View Bills">
                            <span class="material-symbols-outlined mr-3">description</span>
                            <span class="nav-link-text">View Bills</span>
                        </NavLink>
                    }
                    @if (HasRight("Reception", "Due Collection"))
                    {
                        <NavLink class="v-nav-link" href="/duecollection" data-title="View Due Collection">
                            <span class="material-symbols-outlined mr-3">account_balance</span>
                            <span class="nav-link-text">View Due Collection</span>
                        </NavLink>
                    }
                    @if (HasRight("OP", "Patient Registration OP") || HasRight("IP", "Patient Registration IP"))
                    {
                        <NavLink class="v-nav-link" href="/customermaster" data-title="Patient Registration">
                            <span class="material-symbols-outlined mr-3">person_add</span>
                            <span class="nav-link-text">Patient Registration</span>
                        </NavLink>
                    }
                    @if (HasRight("Reception", "Refferal Case & Collection") || HasRight("Configuration", "General"))
                    {
                        <NavLink class="v-nav-link" href="/lc-referral" data-title="Referral">
                            <span class="material-symbols-outlined mr-3">medical_information</span>
                            <span class="nav-link-text">Referral</span>
                        </NavLink>
                    }
                    @if (HasRight("Accounts", "Cash Entry") || HasRight("Accounts", "Petty Cash"))
                    {
                        <NavLink class="v-nav-link" href="/cash-advise" data-title="Cash Advise">
                            <span class="material-symbols-outlined mr-3">payments</span>
                            <span class="nav-link-text">Cash Advise</span>
                        </NavLink>
                    }
                </nav>
            </div>
        }

        @if (HasRight("Lab", "Lab Study") ||
             HasRight("Lab", "Result Entry") ||
             HasRight("Lab", "Print Lab Result") ||
             HasRight("Configuration", "General"))
        {
            <div class="menu-group">
                <div class="group-label nav-text-fade">Lab</div>
                <nav class="v-nav">
                    @if (HasRight("Lab", "Lab Study") || HasRight("Lab", "Result Entry"))
                    {
                        <NavLink class="v-nav-link" href="/sample-collection" data-title="Sample Collection">
                            <span class="material-symbols-outlined mr-3">colorize</span>
                            <span class="nav-link-text">Sample Collection</span>
                        </NavLink>
                    }
                    @if (HasRight("Lab", "Result Entry") || HasRight("Lab", "Print Lab Result"))
                    {
                        <NavLink class="v-nav-link" href="/result-search" data-title="Result Search">
                            <span class="material-symbols-outlined mr-3">manage_search</span>
                            <span class="nav-link-text">Result Search</span>
                        </NavLink>
                    }
                    @if (HasRight("Lab", "Result Entry"))
                    {
                        <NavLink class="v-nav-link" href="/result-entry" data-title="Result Entry">
                            <span class="material-symbols-outlined mr-3">edit_note</span>
                            <span class="nav-link-text">Result Entry</span>
                        </NavLink>
                        <NavLink class="v-nav-link" href="/pending-results" data-title="Pending Results">
                            <span class="material-symbols-outlined mr-3">hourglass_empty</span>
                            <span class="nav-link-text">Pending Results</span>
                        </NavLink>
                    }
                    @if (HasRight("Lab", "Print Lab Result"))
                    {
                        <NavLink class="v-nav-link" href="/finished-reports" data-title="Finished Reports">
                            <span class="material-symbols-outlined mr-3">task_alt</span>
                            <span class="nav-link-text">Finished Reports</span>
                        </NavLink>
                    }

                    @if (HasRight("Configuration", "General"))
                    {
                        <div class="v-nav-item">
                            <button class="nav-submenu-btn" @onclick='() => ToggleSubmenu("lab-masters")'>
                                <div class="flex items-center">
                                    <span class="material-symbols-outlined mr-3">folder_open</span>
                                    <span class="nav-link-text">Masters</span>
                                </div>
                                <span class="material-symbols-outlined nav-submenu-icon @(expandedSubmenus.Contains("lab-masters") ? "is-expanded" : "")">chevron_right</span>
                            </button>
                            <div class="nav-submenu-items @(expandedSubmenus.Contains("lab-masters") ? "is-expanded" : "")">
                                <NavLink class="v-nav-link submenu-item" href="/modify-test-master">
                                    <span class="nav-link-text">Test Master</span>
                                </NavLink>
                                <NavLink class="v-nav-link submenu-item" href="/group-master">
                                    <span class="nav-link-text">Group Master</span>
                                </NavLink>
                                <NavLink class="v-nav-link submenu-item" href="/samplemaster">
                                    <span class="nav-link-text">Sample Master</span>
                                </NavLink>
                                <NavLink class="v-nav-link submenu-item" href="/counter-master">
                                    <span class="nav-link-text">Counter</span>
                                </NavLink>
                                <NavLink class="v-nav-link submenu-item" href="/UnitMaster">
                                    <span class="nav-link-text">Unit Method</span>
                                </NavLink>
                                <NavLink class="v-nav-link submenu-item" href="/container-master">
                                    <span class="nav-link-text">Container Master</span>
                                </NavLink>
                                <NavLink class="v-nav-link submenu-item" href="/machine-master">
                                    <span class="nav-link-text">Machine Master</span>
                                </NavLink>
                                <NavLink class="v-nav-link submenu-item" href="/doctortypemaster">
                                    <span class="nav-link-text">Doctor Type Master</span>
                                </NavLink>
                                <NavLink class="v-nav-link submenu-item" href="/doctorspecialtymaster">
                                    <span class="nav-link-text">Doctor Specialty Master</span>
                                </NavLink>
                            </div>
                        </div>
                    }
                </nav>
            </div>
        }

        @if (HasRight("Configuration", "General"))
        {
            <div class="menu-group">
                <div class="group-label nav-text-fade">Admin</div>
                <nav class="v-nav">
                    <NavLink class="v-nav-link" href="/rate" data-title="Price Master">
                        <span class="material-symbols-outlined mr-3">sell</span>
                        <span class="nav-link-text">Price Master</span>
                    </NavLink>
                    <NavLink class="v-nav-link" href="/feetypemaster" data-title="IC Setting">
                        <span class="material-symbols-outlined mr-3">settings_account_box</span>
                        <span class="nav-link-text">IC Setting</span>
                    </NavLink>
                    <NavLink class="v-nav-link" href="/scheme-master" data-title="Scheme Master">
                        <span class="material-symbols-outlined mr-3">verified</span>
                        <span class="nav-link-text">Scheme Master</span>
                    </NavLink>
                </nav>
            </div>

            <div class="menu-group">
                <div class="group-label nav-text-fade">Configuration</div>
                <nav class="v-nav">
                    <NavLink class="v-nav-link" href="/reimbursementcompanymaster" data-title="Company Master">
                        <span class="material-symbols-outlined mr-3">corporate_fare</span>
                        <span class="nav-link-text">Company Master</span>
                    </NavLink>
                    <NavLink class="v-nav-link" href="/branch" data-title="Branch Master">
                        <span class="material-symbols-outlined mr-3">location_on</span>
                        <span class="nav-link-text">Branch Master</span>
                    </NavLink>
                    <NavLink class="v-nav-link" href="/general-settings" data-title="General Settings">
                        <span class="material-symbols-outlined mr-3">settings</span>
                        <span class="nav-link-text">General Settings</span>
                    </NavLink>

                    <div class="v-nav-item">
                        <button class="nav-submenu-btn" @onclick='() => ToggleSubmenu("config-masters")'>
                            <div class="flex items-center">
                                <span class="material-symbols-outlined mr-3">admin_panel_settings</span>
                                <span class="nav-link-text">Master</span>
                            </div>
                            <span class="material-symbols-outlined nav-submenu-icon @(expandedSubmenus.Contains("config-masters") ? "is-expanded" : "")">chevron_right</span>
                        </button>
                        <div class="nav-submenu-items @(expandedSubmenus.Contains("config-masters") ? "is-expanded" : "")">
                            <NavLink class="v-nav-link submenu-item" href="/areamaster">
                                <span class="nav-link-text">Area</span>
                            </NavLink>
                            <NavLink class="v-nav-link submenu-item" href="/citymaster">
                                <span class="nav-link-text">City</span>
                            </NavLink>
                            <NavLink class="v-nav-link submenu-item" href="/statemaster">
                                <span class="nav-link-text">State Country</span>
                            </NavLink>
                            <NavLink class="v-nav-link submenu-item" href="/countrymaster">
                                <span class="nav-link-text">Country Master</span>
                            </NavLink>
                            <NavLink class="v-nav-link submenu-item" href="/email-master">
                                <span class="nav-link-text">Email</span>
                            </NavLink>
                            <NavLink class="v-nav-link submenu-item" href="/user-master">
                                <span class="nav-link-text">User Master</span>
                            </NavLink>
                            <NavLink class="v-nav-link submenu-item" href="/user-rights">
                                <span class="nav-link-text">User Rights</span>
                            </NavLink>
                            <NavLink class="v-nav-link submenu-item" href="/pro-master">
                                <span class="nav-link-text">Pro Master</span>
                            </NavLink>
                            <NavLink class="v-nav-link submenu-item" href="/collection-master">
                                <span class="nav-link-text">Collection</span>
                            </NavLink>
                        </div>
                    </div>
                </nav>
            </div>
        }
        
        <div class="mt-auto p-4 flex flex-col gap-3">
             <button class="v-nav-link logout-btn-proper w-full" 
                     data-title="Sign Out" 
                     @onclick="RequestLogout">
                <span class="material-symbols-outlined mr-3">logout</span>
                <span class="nav-link-text">Sign Out</span>
            </button>
        </div>
    </div>
</div>

@code {
    private LabCare.Models.UserDetailsModel? UserData;
    private bool isCollapsed = false;
    private HashSet<string> expandedSubmenus = new();
    private List<User_Rights> UserRightsList = new();

    private bool HasRight(string department, string moduleName)
    {
        if (UserData?.Role == "Administrator")
        {
            return true;
        }
        if (UserRightsList == null || UserRightsList.Count == 0)
        {
            return false;
        }
        var right = UserRightsList.FirstOrDefault(r => 
            string.Equals(r.Department, department, StringComparison.OrdinalIgnoreCase) && 
            string.Equals(r.ModuleName, moduleName, StringComparison.OrdinalIgnoreCase));
        return right != null && right.ToView;
    }

    private void ToggleSubmenu(string id)
    {
        if (expandedSubmenus.Contains(id)) expandedSubmenus.Remove(id);
        else expandedSubmenus.Add(id);
        StateHasChanged();
    }

    private bool _isDisposed = false;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        TenantState.OnSessionChanged += OnSessionChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadSessionAsync();
            StateHasChanged();
        });
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadSessionAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _isDisposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;
        TenantState.OnSessionChanged -= OnSessionChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (_isDisposed) return;
                await LoadSessionAsync();
                
                if (_isDisposed) return;
                var savedState = await JS.InvokeAsync<string?>("localStorage.getItem", "sidebarCollapsed");
                if (savedState == "true")
                {
                    isCollapsed = true;
                    await ApplySidebarState();
                }
                if (!_isDisposed) StateHasChanged();
            }
            catch (OperationCanceledException) { }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            catch (Exception ex)
            {
                /* Console.WriteLine($"[DEBUG] NavMenu AfterRender error: {ex.Message}") */;
            }
        }
    }

    private async Task LoadSessionAsync()
    {
        try
        {
            if (_isDisposed) return;
            var result = await SessionStorage.GetAsync<LabCare.Models.UserDetailsModel>("UserDetails");
            if (_isDisposed) return;

            if (result.Success && result.Value != null)
            {
                UserData = result.Value;
                TenantState.SetSession(UserData.TenantCode ?? "", UserData.AuthToken ?? "", UserData.TenantName ?? "", UserData.UserCode ?? 0, UserData.BranchCode, UserData.CounterCode);
                /* Console.WriteLine($"[DEBUG] NavMenu: Session loaded for {UserData.UserName}") */;
            }
            else
            {
                UserData = null;
            }

            var rightsResult = await SessionStorage.GetAsync<List<User_Rights>>("UserRights");
            if (_isDisposed) return;

            if (rightsResult.Success && rightsResult.Value != null)
            {
                UserRightsList = rightsResult.Value;
                /* Console.WriteLine($"[DEBUG] NavMenu: {UserRightsList.Count} user rights loaded.") */;
            }
            else
            {
                UserRightsList = new List<User_Rights>();
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            /* Console.WriteLine("[DEBUG] NavMenu session load error: " + ex.Message) */;
        }
    }

    private async Task ToggleSidebar()
    {
        try
        {
            isCollapsed = !isCollapsed;
            await ApplySidebarState();
            await JS.InvokeVoidAsync("localStorage.setItem", "sidebarCollapsed", isCollapsed.ToString().ToLower());
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    private async Task ApplySidebarState()
    {
        try
        {
            if (isCollapsed)
            {
                await JS.InvokeVoidAsync("eval", "document.getElementById('sidebar')?.classList.add('nav-collapsed');");
            }
            else
            {
                await JS.InvokeVoidAsync("eval", "document.getElementById('sidebar')?.classList.remove('nav-collapsed');");
            }
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    private async Task RequestLogout()
    {
        /* Console.WriteLine("[DEBUG] NavMenu: Performing Logout.") */;
        try
        {
            await SessionStorage.DeleteAsync("UserDetails");
            await SessionStorage.DeleteAsync("authToken");
            await SessionStorage.DeleteAsync("claim");
            await SessionStorage.DeleteAsync("UserRights");
            await SessionStorage.DeleteAsync("branch");
            TenantState.Clear();
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            /* Console.WriteLine("[DEBUG] NavMenu logout error: " + ex.Message) */;
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
    }
}
