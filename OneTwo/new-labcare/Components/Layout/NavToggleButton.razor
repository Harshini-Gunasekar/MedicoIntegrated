@namespace LabCare.Components.Layout
@rendermode InteractiveServer
@inject IJSRuntime JS

<button @onclick="ToggleSidebar"
        id="nav-toggle-btn"
        class="sidebar-toggle-btn"
        title="@(isCollapsed ? "Expand Sidebar" : "Collapse Sidebar")">
    <span class="material-symbols-outlined" style="font-size:16px; transition: transform .3s ease;">
        @(isCollapsed ? "chevron_right" : "chevron_left")
    </span>
</button>

@code {
    private bool isCollapsed = false;

    // Sidebar open width = 280px → button left = 280 - 17 = 263px
    // Sidebar collapsed width = 68px → button left = 68 - 17 = 51px
    private const int OpenWidth = 280;
    private const int CollapsedWidth = 68;
    private const int BtnHalf = 17;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedState = await JS.InvokeAsync<string?>("localStorage.getItem", "sidebarCollapsed");
            if (savedState == "true")
            {
                isCollapsed = true;
                await ApplySidebarState();
                StateHasChanged();
            }
        }
    }

    private async Task ToggleSidebar()
    {
        isCollapsed = !isCollapsed;
        await ApplySidebarState();
        await JS.InvokeVoidAsync("localStorage.setItem", "sidebarCollapsed", isCollapsed.ToString().ToLower());
    }

    private async Task ApplySidebarState()
    {
        int btnLeft = isCollapsed ? (CollapsedWidth - BtnHalf) : (OpenWidth - BtnHalf);

        if (isCollapsed)
        {
            await JS.InvokeVoidAsync("eval",
                "document.getElementById('sidebar')?.classList.add('nav-collapsed');" +
                $"document.getElementById('nav-toggle-btn').style.left = '{btnLeft}px';");
        }
        else
        {
            await JS.InvokeVoidAsync("eval",
                "document.getElementById('sidebar')?.classList.remove('nav-collapsed');" +
                $"document.getElementById('nav-toggle-btn').style.left = '{btnLeft}px';");
        }
    }
}
