@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar @(collapseNavMenu ? "collapsed" : "")">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <div class="logo-box">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                        <path d="m3.3 7 8.7 5 8.7-5" />
                        <path d="M12 22V12" />
                    </svg>
                </div>
                <div class="sidebar-brand-text">
                    <div class="brand-title">Inventory <span class="accent-text">Management</span></div>
                </div>
            </div>
            <button class="sidebar-toggle" @onclick="ToggleNavMenu" title="@(collapseNavMenu ? "Expand Sidebar" : "Collapse Sidebar")">
                <i class="bi @(collapseNavMenu ? "bi-chevron-right" : "bi-chevron-left")"></i>
            </button>
        </div>
        
        <NavMenu IsCollapsed="@collapseNavMenu" />
    </div>

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<Inventory_management_frontend.Components.Shared.NotificationContainer />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool collapseNavMenu = false;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
