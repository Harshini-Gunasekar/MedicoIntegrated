@implements IDisposable
@inject NavigationManager Nav

<style>
    .collapsible-header {
        cursor: pointer;
        user-select: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-right: 16px !important;
        transition: all 0.2s ease;
        border-radius: 6px;
        margin: 0.2rem 12px 0.1rem 12px !important;
        padding-left: 12px !important;
    }
    .collapsible-header:hover {
        background-color: rgba(2, 101, 158, 0.08);
        color: #014b75 !important;
    }
    .collapsible-header:hover i {
        color: #014b75 !important;
    }
    .nav-section-title i {
        transition: transform 0.2s ease;
    }
</style>

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-section-title" style="margin-top: 0.2rem; padding-left: 24px;">MAIN</div>
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Overview and analytics">
                <div class="icon-box"><i class="bi bi-grid-1x2"></i></div>
                <span>Dashboard</span>
            </NavLink>
        </div>

        <!-- MASTERS SECTION -->
        <div class="nav-section-title collapsible-header" @onclick="ToggleMasters" title="Toggle Masters Section">
            <span>MASTERS</span>
            <i class="bi bi-chevron-@(isMastersExpanded ? "down" : "right")" style="font-size: 0.72rem; color: #02659e;"></i>
        </div>

        @if (isMastersExpanded)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="items" title="Manage all inventory items">
                    <div class="icon-box"><i class="bi bi-box-seam"></i></div>
                    <span>Item Master</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="parentcategorymaster" title="Manage parent categories">
                    <div class="icon-box"><i class="bi bi-folder"></i></div>
                    <span>Category Master</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="categorymaster" title="Manage sub categories">
                    <div class="icon-box"><i class="bi bi-folder2"></i></div>
                    <span>Sub Category Master</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="vendors" title="Manage vendor profiles">
                    <div class="icon-box"><i class="bi bi-people"></i></div>
                    <span>Vendor Master</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="uommaster" title="Manage units of measurement">
                    <div class="icon-box"><i class="bi bi-rulers"></i></div>
                    <span>Unit Master</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="warehouses" title="Manage warehouse profiles">
                    <div class="icon-box"><i class="bi bi-house-door"></i></div>
                    <span>Store Master</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="manufacturers" title="Manage manufacturer profiles">
                    <div class="icon-box"><i class="bi bi-building"></i></div>
                    <span>Manufacturer Master</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="ledgergroup" title="Manage accounting groups">
                    <div class="icon-box"><i class="bi bi-collection"></i></div>
                    <span>Ledger Group</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="ledgertype" title="Manage nature types">
                    <div class="icon-box"><i class="bi bi-tags"></i></div>
                    <span>Ledger Type</span>
                </NavLink>
            </div>
        }

        <!-- TRANSACTIONS SECTION -->
        <div class="nav-section-title collapsible-header" @onclick="ToggleTransactions" title="Toggle Transactions Section">
            <span>TRANSACTIONS</span>
            <i class="bi bi-chevron-@(isTransactionsExpanded ? "down" : "right")" style="font-size: 0.72rem; color: #02659e;"></i>
        </div>

        @if (isTransactionsExpanded)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="purchase" title="Manage purchase orders">
                    <div class="icon-box"><i class="bi bi-cart"></i></div>
                    <span>Purchase</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="sales" title="Manage sales bills">
                    <div class="icon-box"><i class="bi bi-receipt"></i></div>
                    <span>Sales</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="indent" title="Manage internal stock indent requests">
                    <div class="icon-box"><i class="bi bi-file-earmark-text"></i></div>
                    <span>Indent</span>
                </NavLink>
            </div>
        }

        <!-- INVENTORY SECTION -->
        <div class="nav-section-title collapsible-header" @onclick="ToggleInventory" title="Toggle Inventory Section">
            <span>INVENTORY</span>
            <i class="bi bi-chevron-@(isInventoryExpanded ? "down" : "right")" style="font-size: 0.72rem; color: #02659e;"></i>
        </div>

        @if (isInventoryExpanded)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="stock" title="View and manage current stock levels">
                    <div class="icon-box"><i class="bi bi-boxes"></i></div>
                    <span>Stock</span>
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    private bool isMastersExpanded = false;
    private bool isTransactionsExpanded = false;
    private bool isInventoryExpanded = false;

    protected override void OnInitialized()
    {
        AutoExpandSections();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        AutoExpandSections();
        StateHasChanged();
    }

    private void AutoExpandSections()
    {
        var relativeUri = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
        
        // Masters paths
        if (relativeUri.Contains("items") || 
            relativeUri.Contains("category") || 
            relativeUri.Contains("vendors") || 
            relativeUri.Contains("uom") || 
            relativeUri.Contains("warehouses") || 
            relativeUri.Contains("ledger") ||
            relativeUri.Contains("manufacturers"))
        {
            isMastersExpanded = true;
        }

        // Transactions paths
        if (relativeUri.Contains("purchase") || 
            relativeUri.Contains("sales") || 
            relativeUri.Contains("indent"))
        {
            isTransactionsExpanded = true;
        }

        // Inventory paths
        if (relativeUri.Contains("stock"))
        {
            isInventoryExpanded = true;
        }
    }

    private void ToggleMasters()
    {
        isMastersExpanded = !isMastersExpanded;
    }

    private void ToggleTransactions()
    {
        isTransactionsExpanded = !isTransactionsExpanded;
    }

    private void ToggleInventory()
    {
        isInventoryExpanded = !isInventoryExpanded;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
