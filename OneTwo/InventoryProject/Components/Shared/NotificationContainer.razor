@using Inventory_management_frontend.Services
@inject NotificationService NotificationService
@implements IDisposable

<div class="notification-container">
    @foreach (var notification in NotificationService.GetNotifications())
    {
        <div class="notification-item @notification.Type.ToString().ToLower()" @key="notification.Id">
            <div class="notification-inner">
                <div class="notification-content">
                    <div class="notification-icon-wrap">
                        <i class="bi @GetIcon(notification.Type)"></i>
                    </div>
                    <div class="notification-text">
                        <span>@notification.Message</span>
                    </div>
                </div>
                <button class="notification-close" @onclick="() => NotificationService.RemoveNotification(notification.Id)">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="notification-progress">
                <div class="notification-progress-bar"></div>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        NotificationService.OnChange += NotifyChanged;
    }

    private async void NotifyChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private string GetIcon(NotificationType type) => type switch
    {
        NotificationType.Success => "bi-check-circle-fill",
        NotificationType.Error => "bi-exclamation-octagon-fill",
        NotificationType.Warning => "bi-exclamation-triangle-fill",
        _ => "bi-info-circle-fill"
    };

    public void Dispose()
    {
        NotificationService.OnChange -= NotifyChanged;
    }
}

