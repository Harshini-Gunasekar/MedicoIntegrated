@page "/indent"
@using Inventory_management_frontend.Models
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS
@inject NotificationService NotificationService

<div class="items-page indent-page pt-0 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Indent Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total indents : @IndentList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by Indent No or Dept" @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    <button class="add-item-btn ms-2" @onclick="AddNewIndent">
                        <i class="bi bi-plus-lg"></i>
                        <span class="ms-1">New Indent</span>
                    </button>
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredIndents.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-file-earmark-text fs-1 d-block mb-3"></i>
                        No stock indents found. Click "New Indent" to create a stock request.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive" style="overflow-x: clip;">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">S.NO</th>
                                    <th>INDENT CODE</th>
                                    <th>INDENT NO</th>
                                    <th>INDENT DATE</th>
                                    <th>DEPT CODE</th>
                                    <th>REQUESTED BY</th>
                                    <th>STATUS</th>
                                    <th>APPROVED BY</th>
                                    <th style="width: 100px;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedIndents.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td>@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td class="fw-bold text-primary">#@row.value.indentcode</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.value.indentno) ? "N/A" : row.value.indentno)</td>
                                        <td>@row.value.indentdate.ToString("yyyy-MM-dd")</td>
                                        <td>@(row.value.departmentcode?.ToString() ?? "N/A")</td>
                                        <td>User @(row.value.requestedby?.ToString() ?? "N/A")</td>
                                        <td>
                                            <span class="@GetStatusBadgeClass(row.value.approvalstatus)">
                                                @(string.IsNullOrWhiteSpace(row.value.approvalstatus) ? "PENDING" : row.value.approvalstatus)
                                            </span>
                                        </td>
                                        <td>@(row.value.approvedby != null ? $"User {row.value.approvedby}" : "N/A")</td>
                                        <td>
                                            <button class="action-btn btn-edit" @onclick="async () => await EditIndent(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var indent in PagedIndents)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span>#@indent.indentcode</span>
                                    <div>
                                        <button class="action-btn btn-edit" @onclick="async () => await EditIndent(indent)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(indent)" title="Delete"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Indent No</span><strong>@(string.IsNullOrWhiteSpace(indent.indentno) ? "N/A" : indent.indentno)</strong></div>
                                    <div class="detail-row"><span>Indent Date</span><strong>@indent.indentdate.ToString("yyyy-MM-dd")</strong></div>
                                    <div class="detail-row"><span>Dept Code</span><strong>@(indent.departmentcode?.ToString() ?? "N/A")</strong></div>
                                    <div class="detail-row"><span>Requested By</span><strong>User @(indent.requestedby?.ToString() ?? "N/A")</strong></div>
                                    <div class="detail-row"><span>Status</span><strong>
                                        <span class="@GetStatusBadgeClass(indent.approvalstatus)">@(indent.approvalstatus ?? "PENDING")</span>
                                    </strong></div>
                                    <div class="detail-row"><span>Approved By</span><strong>@(indent.approvedby != null ? $"User {indent.approvedby}" : "N/A")</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                
                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredIndents.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredIndents.Count()))</strong> of <strong>@FilteredIndents.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 1100px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #02659e !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Indent Request" : "Add Indent Request")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentRequest" OnValidSubmit="SaveIndent" autocomplete="off">
                    <DataAnnotationsValidator />
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 0 10px 20px 0;">
                        
                        <!-- Section 1: Indent Master Information -->
                        <div class="form-section-header">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #02659e; text-transform: uppercase; letter-spacing: 0.5px;">Requisition Details</div>
                        </div>

                        <div class="form-grid">
                            <div class="field-group col-3">
                                <label class="field-label">Indent Number</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.indentno" placeholder="Auto-generated if empty" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label required">Indent Date</label>
                                <InputDate class="form-control premium-input" @bind-Value="CurrentRequest.master.indentdate" />
                                <ValidationMessage For="() => CurrentRequest.master.indentdate" class="text-danger small" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Requested By (User ID)</label>
                                <InputNumber class="form-control premium-input" @bind-Value="CurrentRequest.master.requestedby" placeholder="User ID" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Department Code</label>
                                <InputNumber class="form-control premium-input" @bind-Value="CurrentRequest.master.departmentcode" placeholder="Dept ID" />
                            </div>
                        </div>

                        <div class="form-grid mt-3">
                            <div class="field-group col-4">
                                <label class="field-label">Branch Code</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.branchcode" placeholder="Branch Code" />
                            </div>
                            <div class="field-group col-8">
                                <label class="field-label">Remarks</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.remarks" placeholder="Requisition reasons, notes, or explanations..." />
                            </div>
                        </div>

                        <!-- Section 2: Approval Status (PENDING/APPROVED/REJECTED) -->
                        <div class="form-section-header mt-4">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #02659e; text-transform: uppercase; letter-spacing: 0.5px;">Workflow Approval</div>
                        </div>

                        <div class="form-grid">
                            <div class="field-group col-3">
                                <label class="field-label">Approval Status</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.approvalstatus" @onchange="OnStatusChanged">
                                    <option value="PENDING">PENDING</option>
                                    <option value="APPROVED">APPROVED</option>
                                    <option value="REJECTED">REJECTED</option>
                                </InputSelect>
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Approved By (User ID)</label>
                                <InputNumber class="form-control premium-input" @bind-Value="CurrentRequest.master.approvedby" placeholder="Approver ID" disabled="@(CurrentRequest.master.approvalstatus == "PENDING")" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Approved Date</label>
                                <InputDate class="form-control premium-input" @bind-Value="CurrentRequest.master.approveddate" disabled="@(CurrentRequest.master.approvalstatus == "PENDING")" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Approval Remarks</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.approvalremarks" placeholder="Comments from approver" disabled="@(CurrentRequest.master.approvalstatus == "PENDING")" />
                            </div>
                        </div>

                        <!-- Section 3: Indent Detail Row items -->
                        <div class="form-section-header mt-4">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #02659e; text-transform: uppercase; letter-spacing: 0.5px;">Requested Items</div>
                        </div>

                        <div class="purchase-details-list mt-3">
                            @foreach (var row in CurrentRequest.details.Select((detail, index) => new { detail, index }))
                            {
                                var detail = row.detail;
                                <div class="purchase-detail-card mb-4" style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 24px !important; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); margin-bottom: 1.5rem !important;">
                                     <div class="purchase-detail-head" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1.5px solid #f1f5f9;">
                                         <div class="purchase-detail-title" style="font-size: 1rem; font-weight: 700; color: #0f678f; display: flex; align-items: center; gap: 8px; letter-spacing: normal; text-transform: none;">
                                             <span style="background: rgba(15, 103, 143, 0.1); color: #0f678f; width: 28px; height: 28px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;"><i class="bi bi-box-seam"></i></span>
                                             Item @(row.index + 1)
                                         </div>
                                     </div>
                                     <div style="display: flex; flex-direction: column; gap: 1rem;">
                                         <div class="form-grid" style="margin-bottom: 0;">
                                             <div class="field-group col-4">
                                                 <label class="field-label">Item Selection</label>
                                                 <select class="form-control premium-input"
                                                         value="@detail.itemcode" 
                                                         @onchange="@(e => { detail.itemcode = long.Parse(e.Value?.ToString() ?? "0"); })">
                                                     <option value="0">-- Select Item --</option>
                                                     @foreach (var item in ItemList)
                                                     {
                                                         <option value="@item.itemcode">@item.itemname</option>
                                                     }
                                                 </select>
                                             </div>
                                             <div class="field-group col-2">
                                                 <label class="field-label">Requested Qty</label>
                                                 <input type="number" class="form-control premium-input text-end" @bind="detail.requestedqty" />
                                             </div>
                                             <div class="field-group col-2">
                                                 <label class="field-label">Approved Qty</label>
                                                 <input type="number" class="form-control premium-input text-end" @bind="detail.approvedqty" disabled="@(CurrentRequest.master.approvalstatus == "PENDING")" />
                                             </div>
                                             <div class="field-group col-2">
                                                 <label class="field-label">Issued Qty</label>
                                                 <input type="number" class="form-control premium-input text-end" @bind="detail.issuedqty" disabled="@(CurrentRequest.master.approvalstatus == "PENDING")" />
                                             </div>
                                             <div class="field-group col-2">
                                                 <label class="field-label">Line Remarks</label>
                                                 <input type="text" class="form-control premium-input" @bind="detail.remarks" placeholder="Notes..." />
                                             </div>
                                         </div>
                                     </div>

                                     <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed #dbe6ef; width: 100%;">
                                         <button type="button" class="btn-add-custom purchase-add-item-btn" @onclick="AddDetailRow" title="Add Item" style="height: 36px; padding: 0 16px; font-size: 0.85rem; display: inline-flex; justify-content: center; align-items: center; margin: 0; border-radius: 10px;">
                                             <i class="bi bi-plus-circle me-1"></i> Add Item
                                         </button>
                                         @if (CurrentRequest.details.Count > 1)
                                         {
                                             <button type="button" class="purchase-remove-inline-btn" @onclick="() => RemoveDetailRow(detail)" title="Delete" style="height: 36px; padding: 0 16px; font-size: 0.85rem; display: inline-flex; align-items: center; justify-content: center; margin: 0; border-radius: 10px;">
                                                 <i class="bi bi-trash me-1"></i> Delete
                                             </button>
                                         }
                                     </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="modal-footer-actions" style="display: flex; justify-content: flex-end; gap: 16px; padding: 24px 32px; border-top: 1px solid #f0f0f0;">
                        <button type="button" class="btn btn-light" style="border-radius: 12px; padding: 12px 24px; border: 1px solid #e2e8f0; font-weight: 600; min-width: 120px;" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn-save-premium" disabled="@IsSaving" style="min-width: 150px; height: 48px; background: #1c9f5f; color: white;">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                            }
                            <span>@(IsEdit ? "Update Indent" : "Save Indent")</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeleteConfirm = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Indent Request</div>
            <div class="action-popup-body">Are you sure you want to delete this stock indent? This action cannot be undone.</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowDeleteConfirm = false">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<indent_master> IndentList = new();
    private List<item_master> ItemList = new();
    private indent_request CurrentRequest = new();
    
    private string SearchQuery = "";
    private bool IsLoading = true;
    private bool IsSaving = false;
    private bool ShowModal = false;
    private bool IsEdit = false;
    private bool IsCardView = false;
    private bool ShowDeleteConfirm = false;
    private indent_master? PendingDelete;
    
    private const string DefaultTenant = "TEN1011";
    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 10;

    private IEnumerable<indent_master> FilteredIndents => 
        string.IsNullOrWhiteSpace(SearchQuery) 
            ? IndentList 
            : IndentList.Where(i => 
                (i.indentno?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (i.departmentcode?.ToString().Contains(SearchQuery) ?? false) ||
                (i.indentcode.ToString().Contains(SearchQuery)) ||
                (i.approvalstatus?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<indent_master> PagedIndents => 
        FilteredIndents.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    private int TotalPages => (int)Math.Ceiling((double)FilteredIndents.Count() / ItemsPerPage);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadIndents(), LoadItems());
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("InventoryApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        return client;
    }

    private async Task LoadIndents()
    {
        IsLoading = true;
        try 
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getallindents");
            
            if (!string.IsNullOrWhiteSpace(response)) 
            {
                var directList = ParseIndentsList(response);
                IndentList = directList ?? new();
            }
        } 
        catch (Exception ex) 
        {
            NotificationService.ShowNotification($"Load Error: {ex.Message}", NotificationType.Error);
        } 
        finally 
        {
            IsLoading = false;
        }
    }

    private List<indent_master>? ParseIndentsList(string json)
    {
        var options = new JsonSerializerOptions 
        { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        // 1. Try parsing as ServiceResponse<List<indent_request>> (wrapped list of requests containing master & details)
        try 
        {
            var wrappedReq = JsonSerializer.Deserialize<ServiceResponse<List<indent_request>>>(json, options);
            if (wrappedReq?.data != null && wrappedReq.data.Any()) 
            {
                var masters = wrappedReq.data
                    .Select(x => x.master)
                    .Where(x => x != null && x.indentcode > 0 && !x.deleted)
                    .ToList();
                if (masters.Any()) return masters;
            }
        } 
        catch { }

        // 2. Try parsing as List<indent_request> (direct list of requests containing master & details)
        try 
        {
            var directReq = JsonSerializer.Deserialize<List<indent_request>>(json, options);
            if (directReq != null && directReq.Any()) 
            {
                var masters = directReq
                    .Select(x => x.master)
                    .Where(x => x != null && x.indentcode > 0 && !x.deleted)
                    .ToList();
                if (masters.Any()) return masters;
            }
        } 
        catch { }

        // 3. Try parsing as ServiceResponse<List<indent_master>> (wrapped list of masters directly)
        try 
        {
            var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<indent_master>>>(json, options);
            if (wrapped?.data != null && wrapped.data.Any()) 
            {
                var valid = wrapped.data.Where(x => x.indentcode > 0 && !x.deleted).ToList();
                if (valid.Any()) return valid;
            }
        } 
        catch { }

        // 4. Try parsing as List<indent_master> (direct list of masters)
        try 
        {
            var direct = JsonSerializer.Deserialize<List<indent_master>>(json, options);
            if (direct != null && direct.Any()) 
            {
                var valid = direct.Where(x => x.indentcode > 0 && !x.deleted).ToList();
                if (valid.Any()) return valid;
            }
        } 
        catch { }

        return null;
    }

    private async Task LoadItems()
    {
        try 
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getallitems");
            if (string.IsNullOrWhiteSpace(response)) return;

            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            try 
            {
                var direct = JsonSerializer.Deserialize<List<item_master>>(response, options);
                ItemList = direct ?? new();
            } 
            catch 
            {
                var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<item_master>>>(response, options);
                ItemList = wrapped?.data ?? new();
            }
        } 
        catch { }
    }

    private void AddNewIndent()
    {
        IsEdit = false;
        CurrentRequest = new indent_request 
        { 
            master = new indent_master 
            { 
                tenantcode = DefaultTenant, 
                indentdate = DateTime.Now,
                approvalstatus = "PENDING",
                branchcode = "BLR001",
                isactive = true,
                deleted = false
            },
            details = new List<indent_detail>()
        };
        AddDetailRow();
        ShowModal = true;
    }

    private async Task EditIndent(indent_master master)
    {
        IsEdit = true;
        IsLoading = true;
        try 
        {
            var client = CreateClient();
            var url = $"ItemMaster/getindentbycode?indentcode={master.indentcode}&tenantcode={DefaultTenant}";
            var responseString = await client.GetStringAsync(url);
            
            var loaded = ParseIndentRequest(responseString);
            if (loaded != null) 
            {
                CurrentRequest = loaded;
                CurrentRequest.master.tenantcode = DefaultTenant;
            }
            else 
            {
                CurrentRequest = new indent_request 
                {
                    master = master,
                    details = new List<indent_detail>()
                };
                AddDetailRow();
                NotificationService.ShowNotification("Details not retrieved. Loading basic data only.", NotificationType.Warning);
            }
            ShowModal = true;
        } 
        catch (Exception ex) 
        {
            NotificationService.ShowNotification($"Edit Error: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private indent_request? ParseIndentRequest(string json)
    {
        var options = new JsonSerializerOptions 
        { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        // 1. Try parsing as ServiceResponse<List<indent_request>> (wrapped list)
        try 
        {
            var wrappedList = JsonSerializer.Deserialize<ServiceResponse<List<indent_request>>>(json, options);
            if (wrappedList?.data != null && wrappedList.data.Any()) 
            {
                return wrappedList.data.First();
            }
        } 
        catch { }

        // 2. Try parsing as List<indent_request> (direct list)
        try 
        {
            var directList = JsonSerializer.Deserialize<List<indent_request>>(json, options);
            if (directList != null && directList.Any()) 
            {
                return directList.First();
            }
        } 
        catch { }

        // 3. Try parsing as ServiceResponse<indent_request> (wrapped single item)
        try 
        {
            var wrapped = JsonSerializer.Deserialize<ServiceResponse<indent_request>>(json, options);
            if (wrapped?.data != null && wrapped.data.master != null) return wrapped.data;
        } 
        catch { }

        // 4. Try parsing as indent_request directly
        try 
        {
            var direct = JsonSerializer.Deserialize<indent_request>(json, options);
            if (direct != null && direct.master != null) return direct;
        } 
        catch { }

        return null;
    }

    private void AddDetailRow()
    {
        CurrentRequest.details.Add(new indent_detail ());
    }

    private void RemoveDetailRow(indent_detail detail)
    {
        CurrentRequest.details.Remove(detail);
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        var status = e.Value?.ToString() ?? "PENDING";
        CurrentRequest.master.approvalstatus = status;
        
        if (status == "PENDING")
        {
            CurrentRequest.master.approvedby = null;
            CurrentRequest.master.approveddate = null;
            CurrentRequest.master.approvalremarks = null;
            foreach (var d in CurrentRequest.details)
            {
                d.approvedqty = 0;
                d.issuedqty = 0;
            }
        }
        else
        {
            CurrentRequest.master.approvedby ??= 101;
            CurrentRequest.master.approveddate ??= DateTime.Now;
            foreach (var d in CurrentRequest.details)
            {
                if (d.approvedqty <= 0) d.approvedqty = d.requestedqty;
            }
        }
    }

    private async Task SaveIndent()
    {
        CurrentRequest.details = CurrentRequest.details.Where(d => d.itemcode > 0 && d.requestedqty > 0).ToList();
        if (!CurrentRequest.details.Any()) 
        {
            NotificationService.ShowNotification("Please add at least one line item with quantity", NotificationType.Warning);
            AddDetailRow();
            return;
        }

        IsSaving = true;
        try 
        {
            var client = CreateClient();
            
            CurrentRequest.master.tenantcode = DefaultTenant;
            CurrentRequest.master.branchcode ??= "BLR001";
            CurrentRequest.master.isactive = true;
            CurrentRequest.master.deleted = false;

            var url = IsEdit ? "ItemMaster/updateindent" : "ItemMaster/insertindent";
            
            var options = new JsonSerializerOptions 
            {
                PropertyNamingPolicy = null 
            };
            
            var response = await client.PostAsJsonAsync(url, CurrentRequest, options);

            if (response.IsSuccessStatusCode) 
            {
                NotificationService.ShowNotification(IsEdit ? "Indent request updated successfully" : "Indent request recorded successfully", NotificationType.Success);
                ShowModal = false;
                await LoadIndents();
            } 
            else 
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                NotificationService.ShowNotification($"Save Failed: {errorBody}", NotificationType.Error);
            }
        } 
        catch (Exception ex) 
        {
            NotificationService.ShowNotification($"Save Error: {ex.Message}", NotificationType.Error);
        } 
        finally 
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(indent_master master)
    {
        PendingDelete = master;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteConfirmed()
    {
        if (PendingDelete == null) return;
        IsLoading = true;
        try 
        {
            var client = CreateClient();
            var url = $"ItemMaster/deleteindent?indentcode={PendingDelete.indentcode}";
            var response = await client.GetAsync(url);
            
            if (!response.IsSuccessStatusCode)
            {
                response = await client.DeleteAsync(url);
            }
            
            if (response.IsSuccessStatusCode) 
            {
                NotificationService.ShowNotification("Indent request deleted successfully", NotificationType.Success);
                await LoadIndents();
            } 
            else 
            {
                var softDeleteSuccess = await SoftDeleteViaUpdate(PendingDelete);
                if (softDeleteSuccess)
                {
                    NotificationService.ShowNotification("Indent request soft-deleted", NotificationType.Success);
                    await LoadIndents();
                }
                else
                {
                    NotificationService.ShowNotification("Delete failed. Verify API endpoint status.", NotificationType.Error);
                }
            }
        } 
        catch (Exception ex) 
        {
            NotificationService.ShowNotification($"Delete Error: {ex.Message}", NotificationType.Error);
        } 
        finally 
        {
            ShowDeleteConfirm = false;
            PendingDelete = null;
            IsLoading = false;
        }
    }

    private async Task<bool> SoftDeleteViaUpdate(indent_master entry)
    {
        try
        {
            var client = CreateClient();
            var detailUrl = $"ItemMaster/getindentbycode?indentcode={entry.indentcode}";
            var detailsResponse = await client.GetStringAsync(detailUrl);
            var req = ParseIndentRequest(detailsResponse);
            
            if (req != null)
            {
                req.master.deleted = true;
                req.master.isactive = false;
                req.master.tenantcode = DefaultTenant;
                
                var updateResponse = await client.PostAsJsonAsync("ItemMaster/updateindent", req);
                return updateResponse.IsSuccessStatusCode;
            }
        }
        catch {}
        return false;
    }

