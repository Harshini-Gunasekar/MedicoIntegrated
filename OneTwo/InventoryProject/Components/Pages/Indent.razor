    private string GetStatusBadgeClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "badge-indent-pending";
        return status.ToUpper() switch
        {
            "APPROVED" => "badge-indent-approved",
            "REJECTED" => "badge-indent-rejected",
            _ => "badge-indent-pending"
        };
    }

