@page "/"
@using Inventory_management_frontend.Models
@using System.Net.Http.Json
@using System.Text.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject NotificationService NotificationService

<link rel="stylesheet" href="Home.css" />

<div class="dashboard-page">
    <div class="dashboard-container">
        
        <!-- HEADER BLOCK -->
        <div class="dashboard-header">
            <div class="header-title-section">
                <h1>Inventory Dashboard</h1>
                <p>Real-time analytics and management console</p>
            </div>
            <div class="current-date-badge">
                <i class="bi bi-calendar3"></i>
                <span>@DateTime.Now.ToString("dd MMMM yyyy")</span>
            </div>
        </div>

        @if (isLoading)
        {
            <!-- LOADING SPINNER -->
            <div class="loading-wrapper">
                <div class="loading-spinner"></div>
                <span class="loading-text">Loading Dashboard Metrics...</span>
            </div>
        }
        else
        {
            <!-- KPI CARDS GRID -->
            <div class="kpi-grid">
                <div class="kpi-card kpi-card-skus" @onclick='() => NavigateTo("/items")'>
                    <div class="kpi-info">
                        <span class="kpi-label">Total SKUs</span>
                        <span class="kpi-value">@TotalSKUs</span>
                        <span class="kpi-subtext kpi-subtext-blue">
                            <i class="bi bi-box"></i> Active Items
                        </span>
                    </div>
                    <div class="kpi-icon-box bg-blue-light">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>

                <div class="kpi-card kpi-card-value" @onclick='() => NavigateTo("/stocks")'>
                    <div class="kpi-info">
                        <span class="kpi-label">Total Stock Value</span>
                        <span class="kpi-value">Rs. @TotalStockValuation.ToString("N2")</span>
                        <span class="kpi-subtext kpi-subtext-green">
                            <i class="bi bi-arrow-up-right"></i> Closing Valuation
                        </span>
                    </div>
                    <div class="kpi-icon-box bg-green-light">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                </div>

                <div class="kpi-card kpi-card-vendors" @onclick='() => NavigateTo("/vendors")'>
                    <div class="kpi-info">
                        <span class="kpi-label">Active Vendors</span>
                        <span class="kpi-value">@ActiveVendorsCount</span>
                        <span class="kpi-subtext kpi-subtext-purple">
                            <i class="bi bi-people"></i> Partners
                        </span>
                    </div>
                    <div class="kpi-icon-box bg-purple-light">
                        <i class="bi bi-people"></i>
                    </div>
                </div>

                <div class="kpi-card kpi-card-spend" @onclick='() => NavigateTo("/purchases")'>
                    <div class="kpi-info">
                        <span class="kpi-label">Total Purchases</span>
                        <span class="kpi-value">Rs. @TotalSpend.ToString("N2")</span>
                        <span class="kpi-subtext kpi-subtext-orange">
                            <i class="bi bi-cart"></i> Spend Summary
                        </span>
                    </div>
                    <div class="kpi-icon-box bg-orange-light">
                        <i class="bi bi-cart-check"></i>
                    </div>
                </div>
            </div>

            <!-- QUICK ACTIONS BAR -->
            <div class="quick-actions-bar">
                <div class="quick-actions-title">
                    <i class="bi bi-lightning-charge-fill"></i>
                    <span>Quick Actions Control Strip</span>
                </div>
                <div class="quick-buttons-list">
                    <button class="qa-btn qa-btn-blue" @onclick='() => NavigateTo("/items")'>
                        <i class="bi bi-plus-circle"></i> Add New Item
                    </button>
                    <button class="qa-btn qa-btn-green" @onclick='() => NavigateTo("/purchases")'>
                        <i class="bi bi-cart-plus"></i> New Purchase Bill
                    </button>
                    <button class="qa-btn qa-btn-slate" @onclick='() => NavigateTo("/vendors")'>
                        <i class="bi bi-person-plus"></i> Vendor Registry
                    </button>
                </div>
            </div>

            <!-- TWO-COLUMN GRID -->
            <div class="double-column-grid">
                
                <!-- LEFT COLUMN -->
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    
                    <!-- CRITICAL LOW STOCK ALERTS -->
                    <div class="custom-card">
                        <div class="custom-card-header">
                            <div>
                                <h3 class="custom-card-title">Critical Low Stock Alerts</h3>
                                <p class="custom-card-subtitle">Items requiring immediate replenishment</p>
                            </div>
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                        <div class="custom-card-body">
                            <div class="custom-table-container">
                                <table class="custom-table">
                                    <thead>
                                        <tr>
                                            <th>Item Name</th>
                                            <th>Category</th>
                                            <th class="table-text-right">Current Stock</th>
                                            <th class="table-text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (LowStockItems.Any())
                                        {
                                            @foreach (var item in LowStockItems.Take(5))
                                            {
                                                <tr>
                                                    <td class="fw-bold">@item.itemname</td>
                                                    <td>@(CategoryList.FirstOrDefault(c => c.parentcategorycode == item.categorycode)?.parentcategoryname ?? "Uncategorized")</td>
                                                    <td class="table-text-right">
                                                        <span class="badge-count">@item.currentstock</span>
                                                    </td>
                                                    <td class="table-text-center">
                                                        <button class="reorder-action-btn" @onclick='() => NavigateTo("/purchases")'>
                                                            Reorder
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center text-secondary py-4">
                                                    <i class="bi bi-check-circle-fill text-success fs-4 d-block mb-2"></i>
                                                    All stock levels are currently healthy!
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- CATEGORY VALUATION BREAKDOWN -->
                    <div class="custom-card">
                        <div class="custom-card-header">
                            <div>
                                <h3 class="custom-card-title">Category Valuation Breakdown</h3>
                                <p class="custom-card-subtitle">Value distribution by parent category</p>
                            </div>
                            <i class="bi bi-pie-chart"></i>
                        </div>
                        <div class="custom-card-body">
                            <div class="category-scroll-area">
                                @if (CategoryValuations.Any())
                                {
                                    @foreach (var val in CategoryValuations)
                                    {
                                        <div class="category-metric-row">
                                            <div class="category-metric-info">
                                                <span class="category-name">@val.CategoryName</span>
                                                <span class="category-value">
                                                    Rs. @val.Valuation.ToString("N2")
                                                    <span class="category-pct">(@val.Percentage%)</span>
                                                </span>
                                            </div>
                                            <div class="category-progress-track">
                                                <div class="category-progress-bar" style="width: @(val.Percentage)%"></div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center text-secondary py-4">No category valuation data available</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RIGHT COLUMN -->
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    
                    <!-- STOCK QUALITY & HEALTH -->
                    <div class="custom-card">
                        <div class="custom-card-header">
                            <div>
                                <h3 class="custom-card-title">Stock Quality & Health</h3>
                                <p class="custom-card-subtitle">Proportion of safe vs low-stock items</p>
                            </div>
                            <i class="bi bi-heart-pulse"></i>
                        </div>
                        <div class="custom-card-body">
                            <div class="health-section-layout">
                                <div class="health-score-box">
                                    <span class="health-score-value">@HealthScore%</span>
                                    <span class="health-score-label">Health Index</span>
                                </div>
                                <div class="health-breakdown-details">
                                    <h4 class="health-breakdown-title">Inventory Health Indicator</h4>
                                    <div class="health-progress-composite">
                                        <div class="health-bar-success" style="width: @(HealthScore)%"></div>
                                        <div class="health-bar-danger" style="width: @(100 - HealthScore)%"></div>
                                    </div>
                                    <span class="health-composite-subtext">
                                        @HealthScore% of active items are safely stocked, while @(100 - HealthScore)% require attention.
                                    </span>
                                </div>
                            </div>
                            
                            <div class="health-legend-row">
                                <div class="health-legend-col health-legend-col-border">
                                    <span class="legend-value legend-value-green">@(TotalSKUs - LowStockCount)</span>
                                    <span class="legend-label">
                                        <span class="dot-green"></span> Healthy Stock
                                    </span>
                                </div>
                                <div class="health-legend-col">
                                    <span class="legend-value legend-value-red">@LowStockCount</span>
                                    <span class="legend-label">
                                        <span class="dot-red"></span> Low Stock Alert
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- RECENT PURCHASE BILLS -->
                    <div class="custom-card">
                        <div class="custom-card-header">
                            <div>
                                <h3 class="custom-card-title">Recent Purchase Bills</h3>
                                <p class="custom-card-subtitle">Latest procurement activity feed</p>
                            </div>
                            <i class="bi bi-receipt"></i>
                        </div>
                        <div class="custom-card-body">
                            <div class="custom-table-container">
                                <table class="custom-table">
                                    <thead>
                                        <tr>
                                            <th>Bill No</th>
                                            <th>Vendor</th>
                                            <th class="table-text-right">Net Amount</th>
                                            <th class="table-text-center">Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (RecentPurchases.Any())
                                        {
                                            @foreach (var bill in RecentPurchases)
                                            {
                                                <tr>
                                                    <td class="fw-bold text-primary">
                                                        #@(string.IsNullOrEmpty(bill.billno) ? bill.purchasecode?.ToString() : bill.billno)
                                                    </td>
                                                    <td>
                                                        @(VendorList.FirstOrDefault(v => v.vendorCode == bill.vendorcode)?.vendorName ?? $"Vendor {bill.vendorcode}")
                                                    </td>
                                                    <td class="table-text-right fw-bold">
                                                        Rs. @((bill.netamount ?? 0).ToString("N2"))
                                                    </td>
                                                    <td class="table-text-center text-secondary">
                                                        @FormatBillDate(bill.billdate)
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center text-secondary py-4">No recent purchase transactions</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }
    </div>
</div>

@code {
    private List<item_master> ItemList = new();
    private List<VendorModel> VendorList = new();
    private List<PurchaseMasterModel> PurchaseList = new();
    private List<stock_master> StockList = new();
    private List<parent_category_master> CategoryList = new();
    private bool isLoading = true;

    // Compiled metrics
    private int TotalSKUs = 0;
    private decimal TotalStockValuation = 0;
    private int ActiveVendorsCount = 0;
    private decimal TotalSpend = 0;
    private int LowStockCount = 0;
    private decimal HealthScore = 100;
    private List<item_master> LowStockItems = new();
    private List<PurchaseMasterModel> RecentPurchases = new();
    private List<CategoryValuation> CategoryValuations = new();

    public class CategoryValuation
    {
        public string CategoryName { get; set; } = "";
        public decimal Valuation { get; set; }
        public double Percentage { get; set; }
    }

    private HttpClient CreateTenantClient()
    {
        var client = ClientFactory.CreateClient("InventoryApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", "TEN1011");
        return client;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = CreateTenantClient();
            
            // Asynchronously fetch all dashboard data
            await Task.WhenAll(
                LoadItems(client),
                LoadVendors(client),
                LoadPurchases(client),
                LoadStocks(client),
                LoadCategories(client)
            );

            CompileMetrics();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Dashboard Init Error: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadItems(HttpClient client)
    {
        try
        {
            var responseString = await client.GetStringAsync("ItemMaster/getallitems");
            try
            {
                var direct = JsonSerializer.Deserialize<List<item_master>>(responseString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (direct != null) ItemList = direct;
            }
            catch
            {
                var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<item_master>>>(responseString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (wrapped?.data != null) ItemList = wrapped.data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading items: " + ex.Message);
        }
    }

    private async Task LoadVendors(HttpClient client)
    {
        try
        {
            var responseString = await client.GetStringAsync("ItemMaster/getallvendors");
            try
            {
                var direct = JsonSerializer.Deserialize<List<VendorModel>>(responseString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (direct != null) VendorList = direct;
            }
            catch
            {
                var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<VendorModel>>>(responseString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (wrapped?.data != null) VendorList = wrapped.data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading vendors: " + ex.Message);
        }
    }

    private async Task LoadPurchases(HttpClient client)
    {
        try
        {
            var responseString = await client.GetStringAsync("ItemMaster/getallpurchases");
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            List<JsonElement>? rawList = null;

            try
            {
                rawList = JsonSerializer.Deserialize<List<JsonElement>>(responseString, options);
            }
            catch
            {
                var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<JsonElement>>>(responseString, options);
                if (wrapped?.data != null) rawList = wrapped.data;
            }

            if (rawList != null)
            {
                PurchaseList.Clear();
                foreach (var el in rawList)
                {
                    var m = MapFuzzyMaster(el, options);
                    if (m != null) PurchaseList.Add(m);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading purchases: " + ex.Message);
        }
    }

    private async Task LoadStocks(HttpClient client)
    {
        try
        {
            var responseString = await client.GetStringAsync("ItemMaster/getallstocks");
            var options = new JsonSerializerOptions 
            { 
                PropertyNameCaseInsensitive = true,
                NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
            };
            try
            {
                var direct = JsonSerializer.Deserialize<List<stock_master>>(responseString, options);
                if (direct != null) StockList = direct;
            }
            catch
            {
                var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<stock_master>>>(responseString, options);
                if (wrapped?.data != null) StockList = wrapped.data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading stocks: " + ex.Message);
        }
    }

    private async Task LoadCategories(HttpClient client)
    {
        try
        {
            var responseString = await client.GetStringAsync("ItemMaster/getparentcategory");
            try
            {
                var direct = JsonSerializer.Deserialize<List<parent_category_master>>(responseString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (direct != null) CategoryList = direct;
            }
            catch
            {
                var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<parent_category_master>>>(responseString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (wrapped?.data != null) CategoryList = wrapped.data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading categories: " + ex.Message);
        }
    }

    private PurchaseMasterModel? MapFuzzyMaster(JsonElement el, JsonSerializerOptions options)
    {
        try
        {
            var target = el;
            if (el.ValueKind == JsonValueKind.Object && el.TryGetProperty("master", out var mProp)) target = mProp;
            var m = JsonSerializer.Deserialize<PurchaseMasterModel>(target.GetRawText(), options);
            if (m == null) return null;

            // 1. Fuzzy map ID (billno)
            if (string.IsNullOrEmpty(m.billno))
            {
                foreach (var key in new[] { "billno", "billNo", "purchasecode", "purchaseCode", "prmBillNo" })
                {
                    if (target.TryGetProperty(key, out var p))
                    {
                        m.billno = p.ValueKind == JsonValueKind.Number ? p.GetInt64().ToString() : p.GetString();
                        break;
                    }
                }
            }

            // 2. Fuzzy map Date
            if (!m.billdate.HasValue)
            {
                foreach (var key in new[] { "billdate", "billDate", "date", "purchaseDate" })
                {
                    if (target.TryGetProperty(key, out var p))
                    {
                        if (p.ValueKind == JsonValueKind.String && DateTime.TryParse(p.GetString(), out var parsedDate))
                        {
                            m.billdate = parsedDate;
                            break;
                        }
                        else if (p.TryGetDateTime(out var d))
                        {
                            m.billdate = d;
                            break;
                        }
                    }
                }
            }

            // 3. Fuzzy map Net Amount
            if (m.netamount == null || m.netamount == 0)
            {
                foreach (var key in new[] { "netamount", "netAmount", "amount", "totalamount", "totalAmount", "prmNetAmount" })
                {
                    if (target.TryGetProperty(key, out var p))
                    {
                        if (p.ValueKind == JsonValueKind.Number)
                        {
                            m.netamount = p.GetDecimal();
                            break;
                        }
                        else if (p.ValueKind == JsonValueKind.String && decimal.TryParse(p.GetString(), out var parsedAmt))
                        {
                            m.netamount = parsedAmt;
                            break;
                        }
                    }
                }
            }

            // 4. Fuzzy map Vendor Code
            if (m.vendorcode == null || m.vendorcode == 0)
            {
                foreach (var key in new[] { "vendorcode", "vendorCode", "prmVendorCode" })
                {
                    if (target.TryGetProperty(key, out var p) && p.ValueKind == JsonValueKind.Number)
                    {
                        m.vendorcode = p.GetInt32();
                        break;
                    }
                }
            }

            return m;
        }
        catch (Exception ex)
        {
            Console.WriteLine("MapFuzzyMaster Error: " + ex.Message);
            return null;
        }
    }

    private void CompileMetrics()
    {
        try
        {
            // 1. Total SKUs
            TotalSKUs = ItemList.Count(i => i.isactive && !i.deleted);

            // 2. Active Vendors
            ActiveVendorsCount = VendorList.Count(v => v.isActive && !v.deleted);

            // 3. Total Stock Valuation & Low Stock Items
            TotalStockValuation = 0;
            LowStockCount = 0;
            LowStockItems.Clear();

            foreach (var stock in StockList)
            {
                if (stock.isactive && !stock.deleted)
                {
                    TotalStockValuation += stock.closingstock * stock.unitcost;
                }
            }

            var lowStockStocks = StockList
                .Where(s => s.isactive && !s.deleted && s.closingstock <= 10)
                .ToList();

            foreach (var s in lowStockStocks)
            {
                var item = ItemList.FirstOrDefault(i => i.itemcode == s.itemcode);
                if (item != null)
                {
                    if (!LowStockItems.Any(i => i.itemcode == item.itemcode))
                    {
                        item.currentstock = s.closingstock;
                        LowStockItems.Add(item);
                    }
                }
            }
            LowStockCount = LowStockItems.Count;

            // 4. Inventory Health Score
            if (TotalSKUs > 0)
            {
                HealthScore = Math.Round(((decimal)(TotalSKUs - LowStockCount) / TotalSKUs) * 100, 1);
            }
            else
            {
                HealthScore = 100;
            }

            // 5. Total Spend
            TotalSpend = PurchaseList
                .Where(p => p.billdate.HasValue)
                .Sum(p => p.netamount ?? 0);

            // 6. Recent Purchases
            RecentPurchases = PurchaseList
                .OrderByDescending(p => p.billdate)
                .Take(5)
                .ToList();

            // 7. Category Valuations
            CategoryValuations.Clear();
            var groupedValuations = new Dictionary<int, decimal>();
            foreach (var stock in StockList)
            {
                if (stock.isactive && !stock.deleted)
                {
                    var item = ItemList.FirstOrDefault(i => i.itemcode == stock.itemcode);
                    if (item != null)
                    {
                        var catCode = item.categorycode;
                        var val = stock.closingstock * stock.unitcost;
                        if (groupedValuations.ContainsKey(catCode))
                        {
                            groupedValuations[catCode] += val;
                        }
                        else
                        {
                            groupedValuations[catCode] = val;
                        }
                    }
                }
            }

            foreach (var kvp in groupedValuations)
            {
                var cat = CategoryList.FirstOrDefault(c => c.parentcategorycode == kvp.Key);
                var catName = cat?.parentcategoryname ?? $"Category {kvp.Key}";
                CategoryValuations.Add(new CategoryValuation
                {
                    CategoryName = catName,
                    Valuation = kvp.Value
                });
            }

            var totalCatVal = CategoryValuations.Sum(v => v.Valuation);
            if (totalCatVal > 0)
            {
                foreach (var v in CategoryValuations)
                {
                    v.Percentage = (double)Math.Round((v.Valuation / totalCatVal) * 100, 1);
                }
            }
            CategoryValuations = CategoryValuations.OrderByDescending(v => v.Valuation).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error compiling metrics: " + ex.Message);
        }
    }

    private string FormatBillDate(DateTime? date)
    {
        return date?.ToString("dd MMM yyyy") ?? "N/A";
    }

    private void NavigateTo(string path)
    {
        Nav.NavigateTo(path);
    }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }
}
