@page "/purchaseentry"
@page "/purchaseentries"
@using Inventory_management_frontend.Models
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject NotificationService NotificationService


<div class="items-page purchase-page pt-0 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Purchase Entry Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total entries : @PurchaseEntryList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by GRN No, Bill No or Vendor" @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    <label class="add-item-btn text-white bg-success border-0 ms-2" style="cursor: pointer; border-radius: 14px; font-weight: 700; gap: 8px; display: inline-flex !important; align-items: center !important; justify-content: center !important; height: 44px; padding: 0 1.25rem; line-height: 1; margin: 0; box-shadow: 0 8px 18px rgba(25, 135, 84, 0.22); box-sizing: border-box; vertical-align: middle;">
                        <i class="bi bi-file-earmark-excel" style="font-size: 1.05rem; line-height: 1; display: inline-flex; align-items: center; margin: 0;"></i>
                        <span style="display: inline-flex; align-items: center; line-height: 1; margin: 0;">Import</span>
                        <InputFile OnChange="HandleExcelUpload" style="display: none;" accept=".xlsx,.xls" />
                    </label>

                    <button class="add-item-btn ms-2" @onclick="AddNewPurchaseEntry">
                        <i class="bi bi-plus-lg"></i>
                        <span class="ms-1">New Entry</span>
                    </button>
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredEntries.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-receipt fs-1 d-block mb-3"></i>
                        No purchase entries found. Add a new entry or import an excel spreadsheet.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive" style="overflow-x: clip;">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 45px;">S.NO</th>
                                    <th style="width: 90px;">ENTRY CODE</th>
                                    <th style="width: 80px;">GRN NO</th>
                                    <th>GRN DATE</th>
                                    <th style="width: 30px;">BILL NO</th>
                                    <th>INVOICE NO</th>
                                    <th style="width: 200px;">VENDOR</th>
                                    <th>NET AMOUNT</th>
                                    <th>STATUS</th>
                                    <th style="width: 100px;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedEntries.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td>@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td class="fw-bold text-primary">#@row.value.purchaseentrycode</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.value.grnno) ? "N/A" : row.value.grnno)</td>
                                        <td>@row.value.grndate.ToString("yyyy-MM-dd")</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.value.billno) ? "N/A" : row.value.billno)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.value.invoiceno) ? "N/A" : row.value.invoiceno)</td>
                                        <td>@(VendorList.FirstOrDefault(v => v.vendorCode == row.value.vendorcode)?.vendorName ?? row.value.vendorcode.ToString())</td>
                                        <td class="fw-bold">₹@row.value.netamount.ToString("N2")</td>
                                        <td>
                                            <span class="badge @(row.value.paymentstatus == "Paid" ? "bg-success" : "bg-warning text-dark")">
                                                @(string.IsNullOrWhiteSpace(row.value.paymentstatus) ? "Pending" : row.value.paymentstatus)
                                            </span>
                                        </td>
                                        <td>
                                            <button class="action-btn btn-edit" @onclick="async () => await EditPurchaseEntry(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var entry in PagedEntries)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span>#@entry.purchaseentrycode</span>
                                    <div>
                                        <button class="action-btn btn-edit" @onclick="async () => await EditPurchaseEntry(entry)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(entry)" title="Delete"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>GRN No</span><strong>@(string.IsNullOrWhiteSpace(entry.grnno) ? "N/A" : entry.grnno)</strong></div>
                                    <div class="detail-row"><span>GRN Date</span><strong>@entry.grndate.ToString("yyyy-MM-dd")</strong></div>
                                    <div class="detail-row"><span>Bill No</span><strong>@(string.IsNullOrWhiteSpace(entry.billno) ? "N/A" : entry.billno)</strong></div>
                                    <div class="detail-row"><span>Invoice No</span><strong>@(string.IsNullOrWhiteSpace(entry.invoiceno) ? "N/A" : entry.invoiceno)</strong></div>
                                    <div class="detail-row"><span>Vendor</span><strong>@(VendorList.FirstOrDefault(v => v.vendorCode == entry.vendorcode)?.vendorName ?? entry.vendorcode.ToString())</strong></div>
                                    <div class="detail-row"><span>Net Amount</span><strong>₹@entry.netamount.ToString("N2")</strong></div>
                                    <div class="detail-row"><span>Status</span><strong>@(string.IsNullOrWhiteSpace(entry.paymentstatus) ? "Pending" : entry.paymentstatus)</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                
                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredEntries.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredEntries.Count()))</strong> of <strong>@FilteredEntries.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 1200px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #02659e !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Purchase Entry" : "Add Purchase Entry")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentRequest" OnValidSubmit="SavePurchaseEntry" autocomplete="off">
                    <DataAnnotationsValidator />
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 0 10px 20px 0;">
                        <!-- Header Section -->
                        <div class="form-section-header">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #02659e; text-transform: uppercase; letter-spacing: 0.5px;">Purchase Entry Details</div>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
                             <!-- Row 1 -->
                             <div class="form-grid" style="margin-bottom: 0;">
                                 <div class="field-group col-3">
                                     <label class="field-label">GRN Number</label>
                                     <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.grnno" placeholder="Auto-generated if empty" />
                                     <ValidationMessage For="() => CurrentRequest.master.grnno" class="text-danger small" />
                                 </div>
                                 <div class="field-group col-3">
                                     <label class="field-label required">GRN Date</label>
                                     <InputDate class="form-control premium-input" @bind-Value="CurrentRequest.master.grndate" />
                                     <ValidationMessage For="() => CurrentRequest.master.grndate" class="text-danger small" />
                                 </div>
                                 <div class="field-group col-3">
                                     <label class="field-label">Received By (User Code)</label>
                                     <InputNumber class="form-control premium-input" @bind-Value="CurrentRequest.master.receivedby" placeholder="User Id" />
                                 </div>
                                 <div class="field-group col-3">
                                     <label class="field-label required">Vendor</label>
                                     <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.vendorcode">
                                         <option value="0">-- Select Vendor --</option>
                                         @foreach (var v in VendorList)
                                         {
                                             <option value="@v.vendorCode">@v.vendorName</option>
                                         }
                                     </InputSelect>
                                     <ValidationMessage For="() => CurrentRequest.master.vendorcode" class="text-danger small" />
                                 </div>
                             </div>

                             <!-- Row 2 -->
                             <div class="form-grid" style="margin-bottom: 0;">
                                 <div class="field-group col-3">
                                     <label class="field-label">Bill No</label>
                                     <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.billno" placeholder="Enter Bill No" />
                                 </div>
                                 <div class="field-group col-3">
                                     <label class="field-label">Bill Date</label>
                                     <InputDate class="form-control premium-input" @bind-Value="CurrentRequest.master.billdate" />
                                 </div>
                                 <div class="field-group col-3">
                                     <label class="field-label">Invoice No</label>
                                     <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.invoiceno" placeholder="Enter Invoice No" />
                                 </div>
                                 <div class="field-group col-3">
                                     <label class="field-label">Invoice Date</label>
                                     <InputDate class="form-control premium-input" @bind-Value="CurrentRequest.master.invoicedate" />
                                 </div>
                             </div>

                             <!-- Row 3 -->
                             <div class="form-grid" style="margin-bottom: 0;">
                                 <div class="field-group col-3">
                                     <label class="field-label">Payment Mode</label>
                                     <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.paymentmode">
                                         <option value="Cash">Cash</option>
                                         <option value="Bank">Bank</option>
                                         <option value="UPI">UPI</option>
                                         <option value="Credit">Credit</option>
                                     </InputSelect>
                                 </div>
                                 <div class="field-group col-3">
                                     <label class="field-label">Payment Status</label>
                                     <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.paymentstatus">
                                         <option value="Pending">Pending</option>
                                         <option value="Paid">Paid</option>
                                         <option value="Partial">Partial</option>
                                     </InputSelect>
                                 </div>
                                 <div class="field-group col-6">
                                     <label class="field-label">Remarks</label>
                                     <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.remarks" placeholder="Optional comments..." />
                                 </div>
                             </div>
                        </div>

                        <!-- Details Section -->
                        <div class="form-section-header mt-4">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #02659e; text-transform: uppercase; letter-spacing: 0.5px;">Purchase Detail Items</div>
                        </div>

                        <div class="purchase-details-list mt-3">
                            @foreach (var row in CurrentRequest.details.Select((detail, index) => new { detail, index }))
                            {
                                var detail = row.detail;
                                <div class="purchase-detail-card mb-4" style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 24px !important; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); margin-bottom: 1.5rem !important;">
                                     <div class="purchase-detail-head" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1.5px solid #f1f5f9;">
                                         <div class="purchase-detail-title" style="font-size: 1rem; font-weight: 700; color: #0f678f; display: flex; align-items: center; gap: 8px; letter-spacing: normal; text-transform: none;">
                                             <span style="background: rgba(15, 103, 143, 0.1); color: #0f678f; width: 28px; height: 28px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;"><i class="bi bi-box-seam"></i></span>
                                             Item @(row.index + 1)
                                         </div>
                                     </div>
                                     <div style="display: flex; flex-direction: column; gap: 1rem;">
                                         <!-- Row 1: Item Selection and Quantities -->
                                         <div class="form-grid" style="margin-bottom: 0;">
                                             <div class="field-group col-3">
                                                 <label class="field-label">Item Selection</label>
                                                 <select class="form-control premium-input"
                                                         value="@detail.itemcode" 
                                                         @onchange="@(e => { detail.itemcode = long.Parse(e.Value?.ToString() ?? "0"); OnItemChanged(detail); })">
                                                     <option value="0">Select Item</option>
                                                     @foreach (var item in ItemList)
                                                     {
                                                         <option value="@item.itemcode">@item.itemname</option>
                                                     }
                                                 </select>
                                             </div>
                                             <div class="field-group col-2">
                                                 <label class="field-label">Qty</label>
                                                 <input type="number" class="form-control premium-input text-end" @bind="detail.quantity" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)" />
                                             </div>
                                             <div class="field-group col-2">
                                                 <label class="field-label">Ordered Qty</label>
                                                 <input type="number" class="form-control premium-input text-end" @bind="detail.orderedqty" />
                                             </div>
                                             <div class="field-group col-3">
                                                 <label class="field-label">Received Qty</label>
                                                 <input type="number" class="form-control premium-input text-end" @bind="detail.receivedqty" @bind:event="oninput" @onkeyup="() => CalculateTotals()" />
                                             </div>
                                             <div class="field-group col-2">
                                                 <label class="field-label">Rejected Qty</label>
                                                 <input type="number" class="form-control premium-input text-end" @bind="detail.rejectedqty" />
                                             </div>
                                         </div>
                                         
                                         <!-- Row 2: Rates, Discounts, and Taxes -->
                                         <div class="form-grid" style="margin-bottom: 0;">
                                             <div class="field-group col-2">
                                                 <label class="field-label">Rate (₹)</label>
                                                 <input type="number" class="form-control premium-input text-end" @bind="detail.rate" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)" />
                                             </div>
                                             <div class="field-group col-2">
                                                 <label class="field-label">Discount %</label>
                                                 <input type="number" class="form-control premium-input text-end" @bind="detail.discountpercentage" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)" />
                                             </div>
                                             <div class="field-group col-3">
                                                 <label class="field-label">Discount Amt</label>
                                                 <input type="text" class="form-control premium-input purchase-value-muted text-end" value="₹@detail.discountamount.ToString("N2")" readonly style="background-color: #f8fafc;" />
                                             </div>
                                             <div class="field-group col-2">
                                                 <label class="field-label">Tax %</label>
                                                 <input type="number" class="form-control premium-input text-end" @bind="detail.taxpercentage" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)" />
                                             </div>
                                             <div class="field-group col-3">
                                                 <label class="field-label">Tax Amount</label>
                                                 <input type="text" class="form-control premium-input purchase-value-muted text-end" value="₹@detail.taxamount.ToString("N2")" readonly style="background-color: #f8fafc;" />
                                             </div>
                                         </div>

                                         <!-- Row 3: Batches, Warehouses, and Total -->
                                         <div class="form-grid" style="margin-bottom: 0;">
                                             <div class="field-group col-2">
                                                 <label class="field-label">Batch No</label>
                                                 <input type="text" class="form-control premium-input" @bind="detail.batchno" />
                                             </div>
                                             <div class="field-group col-2">
                                                 <label class="field-label">Mfg Date</label>
                                                 <input type="date" class="form-control premium-input" 
                                                        value="@detail.manufacturingdate?.ToString("yyyy-MM-dd")"
                                                        @onchange="@(e => detail.manufacturingdate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!))" />
                                             </div>
                                             <div class="field-group col-2">
                                                 <label class="field-label">Expiry Date</label>
                                                 <input type="date" class="form-control premium-input" 
                                                        value="@detail.expirydate?.ToString("yyyy-MM-dd")"
                                                        @onchange="@(e => detail.expirydate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!))" />
                                             </div>
                                             <div class="field-group col-3">
                                                 <label class="field-label">Warehouse Code</label>
                                                 <input type="number" class="form-control premium-input" @bind="detail.warehousecode" placeholder="Whse Code" />
                                             </div>
                                             <div class="field-group col-3">
                                                 <label class="field-label">Total Amount</label>
                                                 <input type="text" class="form-control premium-input purchase-value-total text-end fw-bold" value="₹@detail.totalamount.ToString("N2")" readonly style="background-color: #f8fafc;" />
                                             </div>
                                         </div>
                                     </div>

                                     <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed #dbe6ef; width: 100%;">
                                         <button type="button" class="btn-add-custom purchase-add-item-btn" @onclick="AddDetailRow" title="Add Item" style="height: 36px; padding: 0 16px; font-size: 0.85rem; display: inline-flex; justify-content: center; align-items: center; margin: 0; border-radius: 10px;">
                                             <i class="bi bi-plus-circle me-1"></i> Add Item
                                         </button>
                                         @if (CurrentRequest.details.Count > 1)
                                         {
                                             <button type="button" class="purchase-remove-inline-btn" @onclick="() => RemoveDetailRow(detail)" title="Delete" style="height: 36px; padding: 0 16px; font-size: 0.85rem; display: inline-flex; align-items: center; justify-content: center; margin: 0; border-radius: 10px;">
                                                 <i class="bi bi-trash me-1"></i> Delete
                                             </button>
                                         }
                                     </div>
                                </div>
                            }
                        </div>

                        <!-- Real-time Computed Summary Card -->
                        <div class="mt-4 mb-4" style="display: flex; justify-content: flex-end; width: 100%; padding-right: 48px; box-sizing: border-box;">
                            <div style="width: 100%; max-width: 380px;">
                                <div class="compact-summary-card items-card">
                                    <div class="compact-summary-header">Computed Totals</div>
                                    
                                    <div class="compact-summary-row">
                                        <span class="compact-summary-label">Gross Amount</span>
                                        <span class="compact-summary-value">₹ @CurrentRequest.master.grossamount.ToString("N2")</span>
                                    </div>
                                    <div class="compact-summary-row">
                                        <span class="compact-summary-label">Discount Amount</span>
                                        <span class="compact-summary-value" style="color: #ef4444;">- ₹ @CurrentRequest.master.discountamount.ToString("N2")</span>
                                    </div>
                                 <div class="compact-summary-row">
                                        <span class="compact-summary-label">Tax Amount</span>
                                        <span class="compact-summary-value" style="color: #3b82f6;">+ ₹ @CurrentRequest.master.taxamount.ToString("N2")</span>
                                    </div>
                                    <div class="compact-summary-row">
                                        <span class="compact-summary-label">Other Charges (₹)</span>
                                        <input type="number" class="compact-summary-input" @bind="CurrentRequest.master.othercharges" @bind:event="oninput" @onkeyup="CalculateTotals" style="width: 80px; height: 26px; font-size: 0.8rem; padding: 0 6px;" />
                                    </div>
                                    <div class="compact-summary-row">
                                        <span class="compact-summary-label">Total Quantity</span>
                                        <span class="compact-summary-value">@CurrentRequest.master.totalqty.ToString("N1")</span>
                                    </div>
                                    
                                    <div class="compact-summary-net">
                                        <span class="compact-summary-net-label">Net Payable</span>
                                        <span class="compact-summary-net-value">₹ @CurrentRequest.master.netamount.ToString("N2")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-actions" style="display: flex; justify-content: flex-end; gap: 16px; padding: 24px 32px; border-top: 1px solid #f0f0f0;">
                        <button type="button" class="btn btn-light" style="border-radius: 12px; padding: 12px 24px; border: 1px solid #e2e8f0; font-weight: 600; min-width: 120px;" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn-save-premium" disabled="@IsSaving" style="min-width: 150px; height: 48px; background: #1c9f5f; color: white;">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                            }
                            <span>@(IsEdit ? "Update Entry" : "Save Entry")</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeleteConfirm = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Purchase Entry</div>
            <div class="action-popup-body">Are you sure you want to delete this purchase entry? This action cannot be undone.</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowDeleteConfirm = false">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<purchase_entry_master> PurchaseEntryList = new();
    private List<vendor_master> VendorList = new();
    private List<item_master> ItemList = new();
    private purchase_entry_request CurrentRequest = new();
    
    private string SearchQuery = "";
    private bool IsLoading = true;
    private bool IsSaving = false;
    private bool ShowModal = false;
    private bool IsEdit = false;
    private bool IsCardView = false;
    private bool ShowDeleteConfirm = false;
    private purchase_entry_master? PendingDelete;
    
    private const string DefaultTenant = "TEN1011";
    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 10;

    private IEnumerable<purchase_entry_master> FilteredEntries => 
        string.IsNullOrWhiteSpace(SearchQuery) 
            ? PurchaseEntryList 
            : PurchaseEntryList.Where(p => 
                (p.grnno?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.billno?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.purchaseentrycode.ToString().Contains(SearchQuery)) ||
                (VendorList.FirstOrDefault(v => v.vendorCode == p.vendorcode)?.vendorName?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<purchase_entry_master> PagedEntries => 
        FilteredEntries.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    private int TotalPages => (int)Math.Ceiling((double)FilteredEntries.Count() / ItemsPerPage);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadPurchaseEntries(), LoadVendors(), LoadItems());
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("InventoryApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        return client;
    }

    private async Task LoadPurchaseEntries()
    {
        IsLoading = true;
        try 
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getallpurchaseentries");
            
            if (!string.IsNullOrWhiteSpace(response)) 
            {
                var directList = ParsePurchaseEntriesList(response);
                PurchaseEntryList = directList ?? new();
            }
        } 
        catch (Exception ex) 
        {
            NotificationService.ShowNotification($"Load Error: {ex.Message}", NotificationType.Error);
        } 
        finally 
        {
            IsLoading = false;
        }
    }

    private List<purchase_entry_master>? ParsePurchaseEntriesList(string json)
    {
        var options = new JsonSerializerOptions 
        { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        // 1. Try parsing as ServiceResponse<List<purchase_entry_request>> (wrapped list of requests containing master & details)
        try 
        {
            var wrappedReq = JsonSerializer.Deserialize<ServiceResponse<List<purchase_entry_request>>>(json, options);
            if (wrappedReq?.data != null && wrappedReq.data.Any()) 
            {
                var masters = wrappedReq.data
                    .Select(x => x.master)
                    .Where(x => x != null && x.purchaseentrycode > 0 && !x.deleted)
                    .ToList();
                if (masters.Any()) return masters;
            }
        } 
        catch { }

        // 2. Try parsing as List<purchase_entry_request> (direct list of requests containing master & details)
        try 
        {
            var directReq = JsonSerializer.Deserialize<List<purchase_entry_request>>(json, options);
            if (directReq != null && directReq.Any()) 
            {
                var masters = directReq
                    .Select(x => x.master)
                    .Where(x => x != null && x.purchaseentrycode > 0 && !x.deleted)
                    .ToList();
                if (masters.Any()) return masters;
            }
        } 
        catch { }

        // 3. Try parsing as ServiceResponse<List<purchase_entry_master>> (wrapped list of masters directly)
        try 
        {
            var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<purchase_entry_master>>>(json, options);
            if (wrapped?.data != null && wrapped.data.Any()) 
            {
                var valid = wrapped.data.Where(x => x.purchaseentrycode > 0 && !x.deleted).ToList();
                if (valid.Any()) return valid;
            }
        } 
        catch { }

        // 4. Try parsing as List<purchase_entry_master> (direct list of masters)
        try 
        {
            var direct = JsonSerializer.Deserialize<List<purchase_entry_master>>(json, options);
            if (direct != null && direct.Any()) 
            {
                var valid = direct.Where(x => x.purchaseentrycode > 0 && !x.deleted).ToList();
                if (valid.Any()) return valid;
            }
        } 
        catch { }

        return null;
    }

    private async Task LoadVendors()
    {
        try 
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getallvendors");
            if (string.IsNullOrWhiteSpace(response)) return;

            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            try 
            {
                var direct = JsonSerializer.Deserialize<List<vendor_master>>(response, options);
                VendorList = direct ?? new();
            } 
            catch 
            {
                var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<vendor_master>>>(response, options);
                VendorList = wrapped?.data ?? new();
            }
        } 
        catch { }
    }

    private async Task LoadItems()
    {
        try 
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getallitems");
            if (string.IsNullOrWhiteSpace(response)) return;

            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            try 
            {
                var direct = JsonSerializer.Deserialize<List<item_master>>(response, options);
                ItemList = direct ?? new();
            } 
            catch 
            {
                var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<item_master>>>(response, options);
                ItemList = wrapped?.data ?? new();
            }
        } 
        catch { }
    }

    private void AddNewPurchaseEntry()
    {
        IsEdit = false;
        CurrentRequest = new purchase_entry_request 
        { 
            master = new purchase_entry_master 
            { 
                tenantcode = DefaultTenant, 
                grndate = DateTime.Now,
                billdate = DateTime.Now,
                invoicedate = DateTime.Now,
                paymentmode = "Cash",
                paymentstatus = "Pending",
                usercode = 101,
                branchcode = "BLR001",
                companycode = "CMP001"
            },
            details = new List<purchase_entry_detail>()
        };
        AddDetailRow();
        ShowModal = true;
    }

    private async Task EditPurchaseEntry(purchase_entry_master master)
    {
        IsEdit = true;
        IsLoading = true;
        try 
        {
            var client = CreateClient();
            var url = $"ItemMaster/getpurchaseentrybycode?purchaseentrycode={master.purchaseentrycode}&tenantcode={DefaultTenant}";
            var responseString = await client.GetStringAsync(url);
            
            var loaded = ParsePurchaseEntryRequest(responseString);
            if (loaded != null) 
            {
                CurrentRequest = loaded;
                CurrentRequest.master.tenantcode = DefaultTenant;
            }
            else 
            {
                // Fallback to row data if fetch of details fails
                CurrentRequest = new purchase_entry_request 
                {
                    master = master,
                    details = new List<purchase_entry_detail>()
                };
                AddDetailRow();
                NotificationService.ShowNotification("Details not found. Loading basic data only.", NotificationType.Warning);
            }
            ShowModal = true;
        } 
        catch (Exception ex) 
        {
            NotificationService.ShowNotification($"Edit Error: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private purchase_entry_request? ParsePurchaseEntryRequest(string json)
    {
        var options = new JsonSerializerOptions 
        { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        // 1. Try parsing as ServiceResponse<List<purchase_entry_request>> (wrapped list)
        try 
        {
            var wrappedList = JsonSerializer.Deserialize<ServiceResponse<List<purchase_entry_request>>>(json, options);
            if (wrappedList?.data != null && wrappedList.data.Any()) 
            {
                return wrappedList.data.First();
            }
        } 
        catch { }

        // 2. Try parsing as List<purchase_entry_request> (direct list)
        try 
        {
            var directList = JsonSerializer.Deserialize<List<purchase_entry_request>>(json, options);
            if (directList != null && directList.Any()) 
            {
                return directList.First();
            }
        } 
        catch { }

        // 3. Try parsing as ServiceResponse<purchase_entry_request> (wrapped single item)
        try 
        {
            var wrapped = JsonSerializer.Deserialize<ServiceResponse<purchase_entry_request>>(json, options);
            if (wrapped?.data != null && wrapped.data.master != null) return wrapped.data;
        } 
        catch { }

        // 4. Try parsing as purchase_entry_request directly
        try 
        {
            var direct = JsonSerializer.Deserialize<purchase_entry_request>(json, options);
            if (direct != null && direct.master != null) return direct;
        } 
        catch { }

        return null;
    }

    private void AddDetailRow()
    {
        CurrentRequest.details.Add(new purchase_entry_detail 
        { 
            tenantcode = DefaultTenant,
            manufacturingdate = DateTime.Now,
            expirydate = DateTime.Now.AddYears(1)
        });
    }

    private void RemoveDetailRow(purchase_entry_detail detail)
    {
        CurrentRequest.details.Remove(detail);
        CalculateTotals();
    }

    private void OnItemChanged(purchase_entry_detail detail)
    {
        var item = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
        if (item != null) 
        {
            detail.rate = item.purchaserate;
            detail.taxpercentage = item.gstpercentage;
            detail.quantity = 1;
            detail.orderedqty = 1;
            detail.receivedqty = 1;
            CalculateRow(detail);
        }
    }

    private void CalculateRow(purchase_entry_detail detail)
    {
        detail.amount = detail.quantity * detail.rate;
        detail.discountamount = (detail.amount * detail.discountpercentage) / 100;
        var afterDiscount = detail.amount - detail.discountamount;
        detail.taxamount = (afterDiscount * detail.taxpercentage) / 100;
        detail.totalamount = afterDiscount + detail.taxamount;
        CalculateTotals();
    }

    private void CalculateTotals()
    {
        CurrentRequest.master.grossamount = CurrentRequest.details.Sum(d => d.amount);
        CurrentRequest.master.discountamount = CurrentRequest.details.Sum(d => d.discountamount);
        CurrentRequest.master.taxamount = CurrentRequest.details.Sum(d => d.taxamount);
        CurrentRequest.master.totalqty = CurrentRequest.details.Sum(d => d.quantity);
        CurrentRequest.master.receivedqty = CurrentRequest.details.Sum(d => d.receivedqty);
        CurrentRequest.master.netamount = CurrentRequest.details.Sum(d => d.totalamount) + CurrentRequest.master.othercharges;
    }

    private async Task SavePurchaseEntry()
    {
        CalculateTotals();

        if (CurrentRequest.master.vendorcode <= 0) 
        {
            NotificationService.ShowNotification("Please select a vendor", NotificationType.Warning);
            return;
        }

        CurrentRequest.details = CurrentRequest.details.Where(d => d.itemcode > 0 && d.quantity > 0).ToList();
        if (!CurrentRequest.details.Any()) 
        {
            NotificationService.ShowNotification("Please add at least one valid item with quantity", NotificationType.Warning);
            AddDetailRow();
            return;
        }

        IsSaving = true;
        try 
        {
            var client = CreateClient();
            
            // Standardize metadata fields
            CurrentRequest.master.tenantcode = DefaultTenant;
            CurrentRequest.master.branchcode ??= "BLR001";
            CurrentRequest.master.companycode ??= "CMP001";
            CurrentRequest.master.usercode ??= 101;
            CurrentRequest.master.isactive = true;
            CurrentRequest.master.deleted = false;

            foreach (var d in CurrentRequest.details)
            {
                d.tenantcode = DefaultTenant;
                d.manufacturingdate ??= DateTime.Now;
                d.expirydate ??= DateTime.Now.AddYears(1);
            }

            var url = IsEdit ? "ItemMaster/updatepurchaseentry" : "ItemMaster/insertpurchaseentry";
            
            var options = new JsonSerializerOptions 
            {
                PropertyNamingPolicy = null 
            };
            
            var response = await client.PostAsJsonAsync(url, CurrentRequest, options);

            if (response.IsSuccessStatusCode) 
            {
                NotificationService.ShowNotification(IsEdit ? "Purchase Entry updated successfully" : "Purchase Entry recorded successfully", NotificationType.Success);
                ShowModal = false;
                await LoadPurchaseEntries();
            } 
            else 
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                NotificationService.ShowNotification($"Save Failed: {errorBody}", NotificationType.Error);
            }
        } 
        catch (Exception ex) 
        {
            NotificationService.ShowNotification($"Save Error: {ex.Message}", NotificationType.Error);
        } 
        finally 
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(purchase_entry_master master)
    {
        PendingDelete = master;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteConfirmed()
    {
        if (PendingDelete == null) return;
        IsLoading = true;
        try 
        {
            var client = CreateClient();
            // Try standard DELETE or GET request
            var url = $"ItemMaster/deletepurchaseentry?id={PendingDelete.purchaseentrycode}&tenantcode={DefaultTenant}";
            var response = await client.GetAsync(url);
            
            if (!response.IsSuccessStatusCode)
            {
                response = await client.DeleteAsync(url);
            }
            
            if (response.IsSuccessStatusCode) 
            {
                NotificationService.ShowNotification("Purchase entry deleted successfully", NotificationType.Success);
                await LoadPurchaseEntries();
            } 
            else 
            {
                // Fallback Soft Delete via Update
                var softDeleteSuccess = await SoftDeleteViaUpdate(PendingDelete);
                if (softDeleteSuccess)
                {
                    NotificationService.ShowNotification("Purchase entry soft-deleted", NotificationType.Success);
                    await LoadPurchaseEntries();
                }
                else
                {
                    NotificationService.ShowNotification("Delete failed. Verify API endpoint status.", NotificationType.Error);
                }
            }
        } 
        catch (Exception ex) 
        {
            NotificationService.ShowNotification($"Delete Error: {ex.Message}", NotificationType.Error);
        } 
        finally 
        {
            ShowDeleteConfirm = false;
            PendingDelete = null;
            IsLoading = false;
        }
    }

    private async Task<bool> SoftDeleteViaUpdate(purchase_entry_master entry)
    {
        try
        {
            var client = CreateClient();
            var detailUrl = $"ItemMaster/getpurchaseentrybycode?purchaseentrycode={entry.purchaseentrycode}&tenantcode={DefaultTenant}";
            var detailsResponse = await client.GetStringAsync(detailUrl);
            var req = ParsePurchaseEntryRequest(detailsResponse);
            
            if (req != null)
            {
                req.master.deleted = true;
                req.master.isactive = false;
                req.master.tenantcode = DefaultTenant;
                
                var updateResponse = await client.PostAsJsonAsync("ItemMaster/updatepurchaseentry", req);
                return updateResponse.IsSuccessStatusCode;
            }
        }
        catch {}
        return false;
    }

    private async Task HandleExcelUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        
        IsLoading = true;
        try
        {
            var client = CreateClient();
            using var content = new MultipartFormDataContent();
            
            var fileStream = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024); // 15MB limit
            var streamContent = new StreamContent(fileStream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            
            content.Add(streamContent, "file", file.Name);
            
            var response = await client.PostAsync("ItemMaster/upload-excel", content);
            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification("Excel sheet uploaded and parsed successfully!", NotificationType.Success);
                await LoadPurchaseEntries();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                NotificationService.ShowNotification($"Excel upload failed: {err}", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Excel Import Error: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void CloseModal() => ShowModal = false;
    private void SetView(bool card)
    {
        IsCardView = card;
        CurrentPage = 1;
    }
    private void OnSearchInput(ChangeEventArgs e) { SearchQuery = e.Value?.ToString() ?? ""; CurrentPage = 1; }
    private void ChangePage(int p) { if (p >= 1 && p <= TotalPages) CurrentPage = p; }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }
}



