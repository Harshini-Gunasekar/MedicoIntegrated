@page "/salesmaster"
@page "/sales"
@using Inventory_management_frontend.Models
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject NotificationService NotificationService

<style>
    @@keyframes blinker {
        50% { opacity: 0.3; }
    }
</style>

<PageTitle>Sales Master</PageTitle>

<div class="items-page purchase-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                            <polyline points="10 9 9 9 8 9" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Sales Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total sales : @SalesList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by bill no or customer..." @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    <button class="add-item-btn" @onclick="AddNewSales">
                        <i class="bi bi-plus-lg"></i>
                        <span class="ms-1">New Sales</span>
                    </button>
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredSales.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-receipt fs-1 d-block mb-3"></i>
                        No sales found.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive" style="overflow-x: clip;">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">S.NO</th>
                                    <th>BILL NO</th>
                                    <th>INVOICE NO</th>
                                    <th>DATE</th>
                                    <th>CUSTOMER</th>
                                    <th>NET AMOUNT</th>
                                    <th>PAYMENT MODE</th>
                                    <th>STATUS</th>
                                    <th style="width: 100px;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedSales.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td>@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td class="fw-bold text-primary">#@(string.IsNullOrEmpty(row.value.billno) ? row.value.salescode.ToString() : row.value.billno)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.value.invoiceno) ? "N/A" : row.value.invoiceno)</td>
                                        <td>@(row.value.billdate.ToString("yyyy-MM-dd"))</td>
                                        <td>@(CustomerList.FirstOrDefault(c => c.customercode == row.value.customercode)?.customername ?? (row.value.customercode > 0 ? row.value.customercode.ToString() : "N/A"))</td>
                                        <td class="fw-bold">₹@row.value.netamount.ToString("N2")</td>
                                        <td>@row.value.paymentmode</td>
                                        <td>
                                            <span class="badge @(row.value.paymentstatus == "Paid" ? "bg-success" : "bg-warning text-dark")">
                                                @row.value.paymentstatus
                                            </span>
                                        </td>
                                        <td>
                                            <button class="action-btn btn-edit" @onclick="async () => await EditSales(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var s in PagedSales)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span>#@s.billno</span>
                                    <div>
                                        <button class="action-btn btn-edit" @onclick="async () => await EditSales(s)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(s)" title="Delete"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                                <div class="item-card-body">
                                     <div class="detail-row"><span>Invoice No</span><strong>@(string.IsNullOrWhiteSpace(s.invoiceno) ? "N/A" : s.invoiceno)</strong></div>
                                     <div class="detail-row"><span>Date</span><strong>@(s.billdate.ToString("yyyy-MM-dd"))</strong></div>
                                     <div class="detail-row"><span>Customer</span><strong>@(CustomerList.FirstOrDefault(c => c.customercode == s.customercode)?.customername ?? s.customercode?.ToString())</strong></div>
                                     <div class="detail-row"><span>Net Amount</span><strong>₹@s.netamount.ToString("N2")</strong></div>
                                     <div class="detail-row"><span>Status</span><strong>@s.paymentstatus</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredSales.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredSales.Count()))</strong> of <strong>@FilteredSales.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 1100px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #02659e !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Sales" : "New Sales")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentRequest" OnValidSubmit="SaveSales" autocomplete="off">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 8px 12px 12px 0px;">
                        
                        <!-- Bill Information main wrapper divided into Left (fields) and Right (card) -->
                        <div class="purchase-bill-wrapper mb-4">
                            <!-- Left Section: Billing fields -->
                            <div class="purchase-bill-fields">
                                <div class="form-section-header" style="margin-top: 0; margin-bottom: 8px; padding-bottom: 2px; border-bottom: 1px solid #f1f5f9;">
                                    <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #02659e; text-transform: uppercase; letter-spacing: 0.5px;">Sales Information</div>
                                </div>
                                <!-- Row 1: Customer, Bill No, Invoice No in one line -->
                                <div class="form-grid" style="margin-bottom: 0;">
                                    <div class="field-group col-6">
                                        <label class="field-label required">Customer</label>
                                        <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.customercode">
                                            <option value="0">-- Select Customer --</option>
                                            @if (CurrentRequest.master.customercode > 0 && !CustomerList.Any(c => c.customercode == CurrentRequest.master.customercode))
                                            {
                                                <option value="@CurrentRequest.master.customercode">Unknown Customer (Code: @CurrentRequest.master.customercode)</option>
                                            }
                                            @foreach (var c in CustomerList)
                                            {
                                                <option value="@c.customercode">@c.customername</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="field-group col-3">
                                        <label class="field-label required">Bill No</label>
                                        <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.billno" disabled="@IsEdit" />
                                    </div>
                                    <div class="field-group col-3">
                                        <label class="field-label">Invoice No</label>
                                        <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.invoiceno" />
                                    </div>
                                </div>

                                <!-- Row 2: Entered Date, Invoice Date, Payment Mode, Payment Status, Store (Warehouse) -->
                                <div class="form-grid" style="margin-bottom: 0; grid-template-columns: repeat(24, 1fr);">
                                    <div class="field-group" style="grid-column: span 6;">
                                        <label class="field-label">Entered Date</label>
                                        <InputDate class="form-control premium-input" style="font-size: 0.76rem !important; padding: 0 6px !important;" @bind-Value="CurrentRequest.master.billdate" />
                                    </div>
                                    <div class="field-group" style="grid-column: span 6;">
                                        <label class="field-label">Invoice Date</label>
                                        <InputDate class="form-control premium-input" style="font-size: 0.76rem !important; padding: 0 6px !important;" @bind-Value="CurrentRequest.master.invoicedate" />
                                    </div>
                                    <div class="field-group" style="grid-column: span 6;">
                                        <label class="field-label">Payment Mode</label>
                                        <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.paymentmode">
                                            <option value="Cash">Cash</option>
                                            <option value="Bank">Bank</option>
                                            <option value="Credit">Credit</option>
                                        </InputSelect>
                                    </div>
                                    <div class="field-group" style="grid-column: span 6;">
                                        <label class="field-label">Payment Status</label>
                                        <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.paymentstatus">
                                            <option value="Pending">Pending</option>
                                            <option value="Paid">Paid</option>
                                            <option value="Partial">Partial</option>
                                        </InputSelect>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Section: Card matching design of left section -->
                            <div class="purchase-bill-summary">
                                <div class="bill-card-premium">
                                    <div class="bill-card-header-premium" style="color: #02659e !important; border-bottom-color: rgba(2, 101, 158, 0.25) !important;">
                                        Physical Bill Totals
                                    </div>
                                    
                                    <div style="display: flex; flex-direction: column; gap: 4px; flex-grow: 1; justify-content: center;">
                                        <!-- Gross Amount Row -->
                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                            <span style="font-size: 0.72rem; color: #475569; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Gross Amount</span>
                                            <input type="number" step="any" class="compact-summary-input input-premium-gross" @bind:get="GetManualGross()" @bind:set="SetManualGross" @bind:event="oninput" @onkeyup="CalculateManualNet" placeholder="0" style="width: 95px; height: 23px; font-size: 0.75rem; padding: 0 6px; text-align: right; box-sizing: border-box; border-radius: 6px;" />
                                        </div>

                                        <!-- Discount Row -->
                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                            <span style="font-size: 0.72rem; color: #475569; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Discount</span>
                                            <input type="number" step="any" class="compact-summary-input input-premium-discount" @bind:get="GetManualDiscount()" @bind:set="SetManualDiscount" @bind:event="oninput" @onkeyup="CalculateManualNet" placeholder="0" style="width: 95px; height: 23px; font-size: 0.75rem; padding: 0 6px; text-align: right; box-sizing: border-box; border-radius: 6px;" />
                                        </div>

                                        <!-- Tax Amount Row -->
                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                            <span style="font-size: 0.72rem; color: #475569; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Tax Amount</span>
                                            <input type="number" step="any" class="compact-summary-input input-premium-tax" @bind:get="GetManualTax()" @bind:set="SetManualTax" @bind:event="oninput" @onkeyup="CalculateManualNet" placeholder="0" style="width: 95px; height: 23px; font-size: 0.75rem; padding: 0 6px; text-align: right; box-sizing: border-box; border-radius: 6px;" />
                                        </div>
                                    </div>
                                    
                                    <div class="net-payable-wrapper-premium" style="margin-top: 2px; padding-top: 3px; border-top: 1.5px dashed rgba(2, 101, 158, 0.25); display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <span class="net-payable-label-premium" style="font-size: 0.75rem; font-weight: 800; color: #1e293b; text-transform: uppercase; letter-spacing: 0.5px;">Net Payable</span>
                                        <span class="net-payable-value-premium blink-payable-value" style="font-size: 1.12rem; font-weight: 800; color: #02659e; text-shadow: 0 1px 2px rgba(2, 101, 158, 0.1);">₹ @ManualNetAmount.ToString("N2")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-section-header" style="margin-top: 2.8rem !important; padding-top: 0.4rem; border-top: 1px solid #f1f5f9; margin-bottom: 8px; padding-bottom: 2px; border-bottom: 1px solid #f1f5f9;">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #02659e; text-transform: uppercase; letter-spacing: 0.5px;">Sales Details</div>
                        </div>

                        <!-- Table showing item entry and details -->
                        <div class="purchase-items-table-wrapper table-responsive">
                            <table class="table align-middle mb-0" style="font-size: 0.85rem;">
                                <thead class="purchase-items-table-header">
                                    <tr>
                                        <th style="width: 30px; text-align: center;">S.NO</th>
                                        <th style="width: 140px;">ITEM</th>
                                        <th style="width: 65px; text-align: center;">BATCH NO</th>
                                        <th style="width: 95px; text-align: center;">EXPIRY DATE</th>
                                        <th style="text-align: center; width: 45px;">QTY</th>
                                        <th style="text-align: center; width: 55px;">RATE</th>
                                        <th style="text-align: center; width: 48px;">DISC %</th>
                                        <th style="text-align: center; width: 38px;">TAX %</th>
                                        <th style="text-align: center; width: 55px;">TAX AMT</th>
                                        <th style="text-align: center; width: 65px;">TOTAL</th>
                                        <th style="text-align: center; width: 45px;">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in CurrentRequest.details.Select((detail, index) => new { detail, index }))
                                    {
                                        var detail = row.detail;
                                        var index = row.index;
                                        var rowId = $"row-{index}";
                                        <tr>
                                            <td style="padding: 10px 8px; color: #64748b; text-align: center; font-weight: 600; width: 30px;">@(index + 1)</td>
                                            <td style="padding: 10px 8px; min-width: 140px; width: 140px; position: relative;">
                                                @{ var searchKey = detail.GetHashCode(); }
                                                <input id="item-input-@index"
                                                       type="text"
                                                       class="purchase-item-select"
                                                       style="width: 100%;"
                                                       list="items-list-@index"
                                                       value="@(ItemSearchTexts.GetValueOrDefault(searchKey, ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname ?? (detail.itemcode > 0 ? $"Unknown Item (Code: {detail.itemcode})" : "")))"
                                                       placeholder="Type to search item..."
                                                       @oninput="@(e => OnItemTypeaheadInput(e, detail, searchKey))"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 0))" />
                                                <datalist id="items-list-@index">
                                                    @foreach (var item in ItemList)
                                                    {
                                                        <option value="@item.itemname" />
                                                    }
                                                </datalist>
                                            </td>
                                            <td style="padding: 10px 8px; text-align: center; width: 65px;">
                                                <input id="batch-@index" type="text" class="purchase-item-input text-center" @bind="detail.batchno"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 1))" />
                                            </td>
                                            <td style="padding: 10px 8px; text-align: center; width: 95px;">
                                                <input id="expiry-@index" type="date" class="purchase-item-input text-center"
                                                       value="@(detail.expirydate?.ToString("yyyy-MM-dd"))"
                                                       @onchange="@(e => { if(DateTime.TryParse(e.Value?.ToString(), out var dt)) detail.expirydate = dt; else detail.expirydate = null; })"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 2))" />
                                            </td>
                                            <td style="padding: 10px 8px; text-align: center; width: 45px;">
                                                <input id="qty-@index" type="number" step="any" class="purchase-item-input text-center" @bind:get="GetQty(detail)" @bind:set="(val) => SetQty(detail, val)" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 3))" placeholder="0" />
                                            </td>
                                            <td style="padding: 10px 8px; text-align: center; width: 55px;">
                                                <input id="rate-@index" type="number" step="any" class="purchase-item-input text-end" @bind:get="GetRate(detail)" @bind:set="(val) => SetRate(detail, val)" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 4))" placeholder="0" />
                                            </td>
                                            <td style="padding: 10px 8px; text-align: center; width: 48px;">
                                                <input id="disc-@index" type="number" step="any" class="purchase-item-input text-center" @bind:get="GetDisc(detail)" @bind:set="(val) => SetDisc(detail, val)" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 5))" placeholder="0" />
                                            </td>
                                            <td style="padding: 10px 8px; text-align: center; width: 38px;">
                                                <input id="tax-@index" type="number" step="any" class="purchase-item-input text-center" @bind:get="GetTax(detail)" @bind:set="(val) => SetTax(detail, val)" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 6))" placeholder="0" />
                                            </td>
                                            <td style="padding: 10px 8px; text-align: center; width: 55px;">
                                                <span class="purchase-item-readonly text-end">₹@detail.taxamount.ToString("N2")</span>
                                            </td>
                                            <td style="padding: 10px 8px; text-align: center; width: 65px;">
                                                <span class="purchase-item-readonly text-end fw-bold" style="color: #02659e;">₹@detail.totalamount.ToString("N2")</span>
                                            </td>
                                            <td style="padding: 10px 8px; text-align: center; width: 45px;">
                                                <button type="button" class="btn btn-outline-danger btn-sm" style="border-radius: 6px; padding: 4px 8px; border: none; background: rgba(239, 68, 68, 0.08); color: #dc2626;" @onclick="() => RemoveDetailRow(detail)" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div style="padding: 8px 0; display: flex; justify-content: space-between; align-items: center; width: 100%;">
                            <!-- Left Corner: Total Items count -->
                            <span style="color: #475569; font-weight: 600; font-size: 0.82rem; white-space: nowrap; flex: 1; text-align: left;">
                                Total Items: <span style="color: #02659e; font-weight: 700;">@(CurrentRequest.details?.Count(d => d.itemcode > 0) ?? 0)</span>
                            </span>
                            
                            <!-- Center: Dotted Add Item Button -->
                            <div style="flex: 1; text-align: center;">
                                <button type="button" class="btn-dotted-add" @onclick="AddDetailRow" style="padding: 5px 22px; font-size: 0.82rem; border-radius: 16px;">
                                    <i class="bi bi-plus-circle-fill" style="font-size: 0.9rem;"></i> Add Item
                                </button>
                            </div>
                            
                            <!-- Right Corner: Computed Total -->
                            <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px; font-size: 0.83rem; flex: 1; text-align: right; white-space: nowrap;">
                                <span style="color: #64748b; font-weight: 600;">Computed Items Total:</span>
                                <span style="font-weight: 800; font-size: 1.05rem; color: #02659e;">&#8377; @(CurrentRequest.master.netamount.ToString("N2"))</span>
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer-actions" style="display: flex; flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; padding-top: 16px; padding-bottom: 8px;">
                        <!-- Remarks section on the left -->
                        <div class="remarks-section flex-grow-1 me-3" style="max-width: 400px; text-align: left;">
                            <label class="field-label">Remarks</label>
                            <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.remarks" placeholder="Enter remarks..." style="height: 38px;" />
                        </div>

                        <!-- Action Buttons on the right -->
                        <div style="display: flex; flex-direction: row; align-items: center; gap: 12px; margin-top: 10px;">
                            <button type="button" class="modal-footer-btn-cancel" @onclick="CloseModal" style="height: 48px; min-width: 120px; display: flex; align-items: center; justify-content: center; margin: 0; position: relative; top: 0;">Cancel</button>
                            <button type="submit" class="btn-save-premium" disabled="@IsSaving" style="min-width: 150px; height: 48px; margin: 0; position: relative; top: 0;">
                                @if (IsSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                                }
                                <span>@(IsEdit ? "Update Bill" : "Save Bill")</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeleteConfirm = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Sales</div>
            <div class="action-popup-body">Are you sure you want to delete this sales bill? This action cannot be undone.</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowDeleteConfirm = false">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@if (ShowBillMatchPopup)
{
    <div class="action-popup-overlay" @onclick="() => ShowBillMatchPopup = false">
        <div class="action-popup-card" @onclick:stopPropagation="true" style="max-width: 440px;">
            <div class="action-popup-header" style="@(IsBillMatched ? "background: linear-gradient(135deg,#10b981,#059669);" : "background: linear-gradient(135deg,#ef4444,#dc2626);")">
                <i class="bi @(IsBillMatched ? "bi-check-circle-fill" : "bi-x-circle-fill")" style="margin-right: 8px; font-size: 1.1rem;"></i>
                @(IsBillMatched ? "Bill Matched" : "Bill Mismatched")
            </div>
            <div class="action-popup-body" style="text-align: center; padding: 24px 20px 12px;">
                <div style="font-size: 2.8rem; margin-bottom: 10px; color: @(IsBillMatched ? "#10b981" : "#ef4444");">
                    <i class="bi @(IsBillMatched ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i>
                </div>
                @if (IsBillMatched)
                {
                    <p style="margin: 0; font-size: 0.92rem; color: #1e293b;">
                        Physical bill amount <strong>₹ @ManualNetAmount.ToString("N2")</strong> matches the computed items total
                        <strong>₹ @(CurrentRequest.master.netamount.ToString("N2"))</strong>.
                        Proceed to save?
                    </p>
                }
                else
                {
                    <p style="margin: 0; font-size: 0.92rem; color: #1e293b;">
                        Physical bill amount <strong>₹ @ManualNetAmount.ToString("N2")</strong> does <strong>NOT</strong> match
                        the computed items total <strong>₹ @(CurrentRequest.master.netamount.ToString("N2"))</strong>.
                        Please review your entries before saving.
                    </p>
                }
            </div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowBillMatchPopup = false">
                    @(IsBillMatched ? "Cancel" : "Go Back & Fix")
                </button>
                @if (IsBillMatched)
                {
                    <button type="button" class="popup-btn" style="background: linear-gradient(135deg,#10b981,#059669); color:#fff; border:none;" @onclick="ProceedSaveAfterMatch">
                        <i class="bi bi-check2-circle me-1"></i> Proceed &amp; Save
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<sales_master> SalesList = new();
    private List<customer_master> CustomerList = new();
    private List<item_master> ItemList = new();
    private sales_request CurrentRequest = new() { master = new(), details = new() };
    private sales_detail NewDetailItem = new();

    // Typeahead: tracks the typed text per detail row (keyed by object hash)
    private Dictionary<int, string> ItemSearchTexts = new();

    private void OnItemTypeaheadInput(ChangeEventArgs e, sales_detail detail, int searchKey)
    {
        var typed = e.Value?.ToString() ?? "";
        ItemSearchTexts[searchKey] = typed;
        // Try to find an exact match in the item list
        var matched = ItemList.FirstOrDefault(i =>
            string.Equals(i.itemname, typed, StringComparison.OrdinalIgnoreCase));
        if (matched != null)
        {
            detail.itemcode = matched.itemcode;
            OnItemChanged(detail);
        }
        else
        {
            detail.itemcode = 0;
        }
    }

    // Field order in a row: 0=item, 1=batch, 2=expiry, 3=qty, 4=rate, 5=disc, 6=tax
    private readonly string[] _rowFieldPrefixes = { "item-input", "batch", "expiry", "qty", "rate", "disc", "tax" };

    private async Task HandleRowKeyDown(KeyboardEventArgs e, int rowIndex, int fieldIndex)
    {
        if (e.Key == "Enter" || e.Key == "Tab")
        {
            int nextField = fieldIndex + 1;
            int nextRow = rowIndex;
            if (nextField >= _rowFieldPrefixes.Length)
            {
                nextField = 0;
                nextRow = rowIndex + 1;
                // If next row doesn't exist, add one
                if (nextRow >= CurrentRequest.details.Count)
                    AddDetailRow();
            }
            var targetId = $"{_rowFieldPrefixes[nextField]}-{nextRow}";
            await JS.InvokeVoidAsync("focusElement", targetId);
        }
    }

    private HashSet<sales_detail> EditableRows = new();

    private bool IsRowEditable(sales_detail detail)
    {
        if (CurrentRequest.details != null && CurrentRequest.details.Count > 0 && CurrentRequest.details[0] == detail && detail.itemcode == 0)
        {
            return true;
        }
        return EditableRows.Contains(detail);
    }
    
    private string SearchQuery = "";
    private bool IsLoading = true;
    private bool IsSaving = false;
    private bool ShowModal = false;
    private bool IsEdit = false;
    private bool IsCardView = false;
    private bool ShowDeleteConfirm = false;
    private bool ShowBillMatchPopup = false;
    private bool IsBillMatched = false;
    private sales_master? PendingDelete;
    
    private decimal ManualGross = 0;
    private decimal ManualDiscount = 0;
    private decimal ManualTax = 0;
    private decimal ManualNetAmount = 0;

    private decimal? GetManualGross() => !IsEdit && ManualGross == 0 ? null : ManualGross;
    private void SetManualGross(decimal? value) => ManualGross = value ?? 0;

    private decimal? GetManualDiscount() => !IsEdit && ManualDiscount == 0 ? null : ManualDiscount;
    private void SetManualDiscount(decimal? value) => ManualDiscount = value ?? 0;

    private decimal? GetManualTax() => !IsEdit && ManualTax == 0 ? null : ManualTax;
    private void SetManualTax(decimal? value) => ManualTax = value ?? 0;

    private decimal? GetQty(sales_detail detail) => !IsEdit && detail.quantity == 0 ? null : detail.quantity;
    private void SetQty(sales_detail detail, decimal? value) => detail.quantity = value ?? 0;

    private decimal? GetRate(sales_detail detail) => !IsEdit && detail.rate == 0 ? null : detail.rate;
    private void SetRate(sales_detail detail, decimal? value) => detail.rate = value ?? 0;

    private decimal? GetDisc(sales_detail detail) => !IsEdit && detail.discountpercentage == 0 ? null : detail.discountpercentage;
    private void SetDisc(sales_detail detail, decimal? value) => detail.discountpercentage = value ?? 0;

    private decimal? GetTax(sales_detail detail) => !IsEdit && detail.taxpercentage == 0 ? null : detail.taxpercentage;
    private void SetTax(sales_detail detail, decimal? value) => detail.taxpercentage = value ?? 0;
    
    private const string DefaultTenant = "TEN1011";

    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 8;

    private IEnumerable<sales_master> FilteredSales => 
        string.IsNullOrWhiteSpace(SearchQuery) 
            ? SalesList 
            : SalesList.Where(s => 
                (s.billno?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                s.salescode.ToString().Contains(SearchQuery) ||
                CustomerList.Any(c => c.customercode == s.customercode && c.customername != null && c.customername.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<sales_master> PagedSales => 
        FilteredSales.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    private int TotalPages => (int)Math.Ceiling((double)FilteredSales.Count() / ItemsPerPage);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadSales(), LoadCustomers(), LoadItems());
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("InventoryApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        return client;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        CurrentPage = 1;
    }

    private void SetView(bool cardView)
    {
        IsCardView = cardView;
        CurrentPage = 1;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            StateHasChanged();
        }
    }

    private async Task LoadSales()
    {
        IsLoading = true;
        try {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getsales");
            
            if (!string.IsNullOrWhiteSpace(response)) {
                var masterList = ParseSalesListResponse(response);
                SalesList = masterList ?? new();
            }
        } catch (Exception ex) {
            NotificationService.ShowNotification($"Load Error: {ex.Message}", NotificationType.Error);
        } finally {
            IsLoading = false;
        }
    }

    private async Task LoadCustomers()
    {
        try {
            var client = CreateClient();
            var urls = new[] { "ItemMaster/getallcustomers", "ItemMaster/getcustomer", "ItemMaster/getallcustomer", "Customer/getallcustomers" };
            string? response = null;
            
            foreach (var url in urls) {
                try {
                    response = await client.GetStringAsync(url);
                    if (!string.IsNullOrWhiteSpace(response)) break;
                } catch { }
            }
            
            if (!string.IsNullOrWhiteSpace(response)) {
                var options = new System.Text.Json.JsonSerializerOptions { 
                    PropertyNameCaseInsensitive = true,
                    NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                };
                try {
                    var direct = System.Text.Json.JsonSerializer.Deserialize<List<customer_master>>(response, options);
                    CustomerList = direct ?? new();
                } catch {
                    var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<customer_master>>>(response, options);
                    CustomerList = wrapped?.data ?? new();
                }
            }
        } catch { }
        CustomerList ??= new();
    }

    private async Task LoadItems()
    {
        try {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getallitems");
            
            if (!string.IsNullOrWhiteSpace(response)) {
                var options = new System.Text.Json.JsonSerializerOptions { 
                    PropertyNameCaseInsensitive = true,
                    NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                };
                try {
                    var direct = System.Text.Json.JsonSerializer.Deserialize<List<item_master>>(response, options);
                    ItemList = direct ?? new();
                } catch {
                    var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<item_master>>>(response, options);
                    ItemList = wrapped?.data ?? new();
                }
            }
        } catch { }
        
        ItemList ??= new();
    }

    private void AddNewSales()
    {
        IsEdit = false;
        CurrentRequest = new sales_request { 
            master = new sales_master { 
                billno = null,
                tenantcode = DefaultTenant, 
                billdate = DateTime.Now.Date,
                paymentmode = "Cash",
                paymentstatus = "Pending",
                usercode = 101,
                branchcode = "BLR001",
                companycode = "CMP001"
            },
            details = new List<sales_detail>()
        };
        
        ManualGross = 0;
        ManualDiscount = 0;
        ManualTax = 0;
        ManualNetAmount = 0;
        EditableRows.Clear();
        ItemSearchTexts.Clear();
        NewDetailItem = new sales_detail { tenantcode = DefaultTenant };
        AddDetailRow();
        ShowModal = true;
    }

    private async Task EditSales(sales_master master)
    {
        IsEdit = true;
        var ids = new List<string>();
        if (master.salescode > 0) ids.Add(master.salescode.ToString());
        if (!string.IsNullOrEmpty(master.billno)) ids.Add(master.billno);
        if (!string.IsNullOrEmpty(master.invoiceno)) ids.Add(master.invoiceno);
        
        ids = ids.Distinct().ToList();

        if (!ids.Any()) {
            NotificationService.ShowNotification("Cannot edit: ID not found", NotificationType.Warning);
            return;
        }

        bool fetchSuccess = false;
        foreach (var id in ids) {
            var isNumeric = long.TryParse(id, out long numericId);
            var variations = new List<(string url, HttpMethod method, object? body)>();
            
            if (isNumeric) {
                variations.Add(($"ItemMaster/getsalesbycode?salescode={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"ItemMaster/getsalesbycode?salesCode={id}&tenantCode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"ItemMaster/getsalesbycode/{id}?tenantcode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"ItemMaster/getsales?salescode={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
            } else {
                variations.Add(($"ItemMaster/getsalesbycode?billno={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"ItemMaster/getsales?billno={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
            }

            foreach (var v in variations) {
                try {
                    var client = CreateClient();
                    HttpResponseMessage response;
                    if (v.method == HttpMethod.Get) {
                        response = await client.GetAsync(v.url);
                    } else {
                        response = await client.PostAsJsonAsync(v.url, v.body);
                    }

                    if (response.IsSuccessStatusCode) {
                        var responseString = await response.Content.ReadAsStringAsync();
                        var loaded = ParseRequestResponse(responseString);
                        if (loaded != null) {
                            CurrentRequest = loaded;
                            fetchSuccess = true;
                            break;
                        }
                    }
                } catch { }
            }
            if (fetchSuccess) break;
        }

        if (!fetchSuccess) {
            // Fallback load from the grid master
            CurrentRequest = new sales_request {
                master = new sales_master {
                    salescode = master.salescode,
                    billno = master.billno,
                    billdate = master.billdate,
                    invoiceno = master.invoiceno,
                    invoicedate = master.invoicedate,
                    customercode = master.customercode,
                    grossamount = master.grossamount,
                    discountamount = master.discountamount,
                    taxamount = master.taxamount,
                    netamount = master.netamount,
                    paymentmode = master.paymentmode,
                    paymentstatus = master.paymentstatus,
                    currencycode = master.currencycode,
                    isactive = master.isactive,
                    deleted = master.deleted,
                    remarks = master.remarks,
                    usercode = master.usercode,
                    tenantcode = master.tenantcode ?? DefaultTenant,
                    branchcode = master.branchcode ?? "BLR001",
                    companycode = master.companycode ?? "CMP001",
                    ordercode = master.ordercode
                },
                details = new List<sales_detail>()
            };
            NotificationService.ShowNotification("Loaded basic sale info.", NotificationType.Success);
        }

        CurrentRequest.details ??= new List<sales_detail>();

        ManualGross = CurrentRequest.master.grossamount;
        ManualDiscount = CurrentRequest.master.discountamount;
        ManualTax = CurrentRequest.master.taxamount;
        ManualNetAmount = CurrentRequest.master.netamount;

        ItemSearchTexts.Clear();
        if (CurrentRequest.details != null)
        {
            foreach (var d in CurrentRequest.details)
            {
                var key = d.GetHashCode();
                var itemName = ItemList.FirstOrDefault(i => i.itemcode == d.itemcode)?.itemname ?? "";
                ItemSearchTexts[key] = itemName;
            }
        }

        AddDetailRow();
        NewDetailItem = new sales_detail { tenantcode = DefaultTenant };
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
        IsSaving = false;
    }

    private void CalculateManualNet()
    {
        ManualNetAmount = ManualGross - ManualDiscount + ManualTax;
    }

    private void OnItemChanged(sales_detail detail)
    {
        var item = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
        if (item != null) {
            detail.rate = item.salesrate;
            detail.uomcode = item.uomcode;
            detail.taxpercentage = item.gstpercentage;
            detail.expirydate = null;
            CalculateRow(detail);
        }
    }

    private void CalculateRow(sales_detail detail)
    {
        detail.amount = detail.quantity * detail.rate;
        detail.discountamount = (detail.amount * detail.discountpercentage) / 100;
        var afterDiscount = detail.amount - detail.discountamount;
        detail.taxamount = (afterDiscount * detail.taxpercentage) / 100;
        detail.totalamount = afterDiscount + detail.taxamount;
        CalculateTotals();
    }

    private void CalculateTotals()
    {
        CurrentRequest.master.grossamount = CurrentRequest.details.Sum(d => d.amount);
        CurrentRequest.master.discountamount = CurrentRequest.details.Sum(d => d.discountamount);
        CurrentRequest.master.taxamount = CurrentRequest.details.Sum(d => d.taxamount);
        CurrentRequest.master.netamount = CurrentRequest.details.Sum(d => d.totalamount);
    }

    private void AddDetailRow()
    {
        EditableRows.Clear();
        var newRow = new sales_detail { 
            tenantcode = DefaultTenant,
            expirydate = null
        };
        CurrentRequest.details.Add(newRow);
        EditableRows.Add(newRow);
    }

    private void RemoveDetailRow(sales_detail detail)
    {
        var searchKey = detail.GetHashCode();
        ItemSearchTexts.Remove(searchKey);

        if (CurrentRequest.details != null && CurrentRequest.details.Count > 0 && CurrentRequest.details[0] == detail)
        {
            detail.itemcode = 0;
            detail.quantity = 0;
            detail.rate = 0;
            detail.discountpercentage = 0;
            detail.discountamount = 0;
            detail.taxpercentage = 0;
            detail.taxamount = 0;
            detail.amount = 0;
            detail.totalamount = 0;
            detail.batchno = "";
            EditableRows.Add(detail);
        }
        else if (CurrentRequest.details != null)
        {
            CurrentRequest.details.Remove(detail);
            EditableRows.Remove(detail);
        }
        CalculateTotals();
    }

    private async Task SaveSales()
    {
        CalculateTotals();

        if ((CurrentRequest.master.customercode ?? 0) <= 0) {
            NotificationService.ShowNotification("Please select a customer", NotificationType.Warning);
            return;
        }
        CurrentRequest.details = CurrentRequest.details.Where(d => (d.itemcode > 0) && (d.quantity > 0)).ToList();
        if (!CurrentRequest.details.Any()) {
            NotificationService.ShowNotification("Please add at least one valid item with quantity", NotificationType.Warning);
            if (!CurrentRequest.details.Any()) AddDetailRow();
            return;
        }

        IsBillMatched = Math.Round(ManualNetAmount, 2) == Math.Round(CurrentRequest.master.netamount, 2);
        ShowBillMatchPopup = true;
    }

    private async Task ProceedSaveAfterMatch()
    {
        ShowBillMatchPopup = false;
        IsSaving = true;
        try {
            var client = CreateClient();
            CurrentRequest.master.tenantcode = DefaultTenant;
            CurrentRequest.master.branchcode ??= "BLR001";
            CurrentRequest.master.companycode ??= "CMP001";
            CurrentRequest.master.usercode ??= 101;
            CurrentRequest.master.salescode = IsEdit ? CurrentRequest.master.salescode : 0;
            CurrentRequest.master.isactive = true;

            foreach (var detail in CurrentRequest.details)
            {
                detail.tenantcode = DefaultTenant;
                detail.salescode = CurrentRequest.master.salescode;
            }

            var url = IsEdit ? "ItemMaster/updatesales" : "ItemMaster/insertsales";
            var response = await client.PostAsJsonAsync(url, CurrentRequest);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification(IsEdit ? "Sales updated successfully" : "Sales saved successfully", NotificationType.Success);
                ShowModal = false;
                await LoadSales();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                NotificationService.ShowNotification($"Save failed: {err}", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error saving: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(sales_master master)
    {
        PendingDelete = master;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteConfirmed()
    {
        if (PendingDelete == null) return;
        ShowDeleteConfirm = false;
        
        try {
            var client = CreateClient();
            var salesCode = PendingDelete.salescode;

            var attempts = new Func<Task<HttpResponseMessage>>[]
            {
                () => client.GetAsync($"ItemMaster/deletesales?salescode={salesCode}"),
                () => client.DeleteAsync($"ItemMaster/deletesales?salescode={salesCode}"),
                () => client.DeleteAsync($"ItemMaster/deletesales/{salesCode}"),
                () => client.PostAsJsonAsync("ItemMaster/deletesales", new { salescode = salesCode, tenantcode = DefaultTenant }),
                () => client.PostAsync($"ItemMaster/deletesales?salescode={salesCode}", null)
            };

            bool success = false;
            foreach (var attempt in attempts)
            {
                try {
                    var response = await attempt();
                    if (response.IsSuccessStatusCode) {
                        success = true;
                        break;
                    }
                } catch {}
            }

            if (success) {
                NotificationService.ShowNotification("Sales deleted successfully", NotificationType.Success);
                await LoadSales();
            } else {
                NotificationService.ShowNotification("Delete failed", NotificationType.Error);
            }
        } catch (Exception ex) {
            NotificationService.ShowNotification($"Error deleting: {ex.Message}", NotificationType.Error);
        } finally {
            PendingDelete = null;
        }
    }

    private sales_master? ParseMaster(JsonElement el, JsonSerializerOptions options)
    {
        var target = el;
        if (el.TryGetProperty("master", out var mProp)) target = mProp;

        var m = JsonSerializer.Deserialize<sales_master>(target.GetRawText(), options);
        return m;
    }

    private List<sales_master> ParseSalesListResponse(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        var options = new JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };
        
        try {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            
            JsonElement arrayElement;
            if (root.ValueKind == JsonValueKind.Array) {
                arrayElement = root;
            } else if (root.ValueKind == JsonValueKind.Object) {
                if (root.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == JsonValueKind.Array) {
                    arrayElement = dataProp;
                } else {
                    bool found = false;
                    arrayElement = default;
                    foreach (var prop in root.EnumerateObject()) {
                        if (prop.Value.ValueKind == JsonValueKind.Array) {
                            arrayElement = prop.Value;
                            found = true;
                            break;
                        }
                    }
                    if (!found) return new();
                }
            } else return new();

            var result = new List<sales_master>();
            foreach (var item in arrayElement.EnumerateArray()) {
                var m = ParseMaster(item, options);
                if (m != null && !m.deleted) result.Add(m);
            }
            return result.OrderByDescending(x => x.billdate).ToList();
        } catch (Exception ex) {
            Console.WriteLine("Parse Error: " + ex.Message);
        }

        return new();
    }

    private sales_request? ParseRequestResponse(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        var options = new JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };
        
        try {
            var direct = JsonSerializer.Deserialize<sales_request>(json, options);
            if (direct != null && direct.master != null) return direct;
        } catch {}

        try {
            var wrapped = JsonSerializer.Deserialize<ServiceResponse<sales_request>>(json, options);
            if (wrapped?.data != null) return wrapped.data;
        } catch {}

        try {
            var directMaster = JsonSerializer.Deserialize<sales_master>(json, options);
            if (directMaster != null && directMaster.salescode > 0)
            {
                return new sales_request { master = directMaster, details = new() };
            }
        } catch {}

        return null;
    }

    public class customer_master
    {
        public long customercode { get; set; }
        public string? customername { get; set; }
    }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }
}
