@page "/categorymaster"
@page "/category"
@using Inventory_management_frontend.Models
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NotificationService NotificationService

<div class="items-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Category Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total categories : @ItemList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by name or code..." @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    <button class="add-item-btn" @onclick="AddNew">
                        <i class="bi bi-plus-lg"></i>
                        <span class="ms-1">Add Category</span>
                    </button>
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredItems.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-folder2 fs-1 d-block mb-3"></i>
                        No categories found.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive" style="overflow-x: clip;">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">S.NO</th>
                                    <th>CODE</th>
                                    <th>NAME</th>
                                    <th>PARENT CATEGORY</th>
                                    <th>SHORT NAME</th>
                                    <th>STATUS</th>
                                    <th style="width: 100px;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedItems.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td>@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td class="fw-bold text-primary">#@row.value.categorycode</td>
                                        <td>@row.value.categoryname</td>
                                        <td>
                                            @(ParentCategoryList.FirstOrDefault(p => p.parentcategorycode == row.value.parentcategorycode)?.parentcategoryname ?? row.value.parentcategorycode.ToString())
                                        </td>
                                        <td>@row.value.shortname</td>
                                        <td>
                                            @if (row.value.isactive) {
                                                <span class="badge bg-success">Active</span>
                                            } else {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="action-btn btn-edit" @onclick="() => Edit(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var item in PagedItems)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span>#@item.categorycode - @item.categoryname</span>
                                    <div>
                                        <button class="action-btn btn-edit" @onclick="() => Edit(item)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(item)" title="Delete"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Parent Category</span><strong>@(ParentCategoryList.FirstOrDefault(p => p.parentcategorycode == item.parentcategorycode)?.parentcategoryname ?? item.parentcategorycode.ToString())</strong></div>
                                    <div class="detail-row"><span>Short Name</span><strong>@item.shortname</strong></div>
                                    <div class="detail-row"><span>Status</span><strong>@(item.isactive ? "Active" : "Inactive")</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredItems.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredItems.Count()))</strong> of <strong>@FilteredItems.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 650px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #02659e !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Category" : "Add Category")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentItem" OnValidSubmit="Save" autocomplete="off">
                    <DataAnnotationsValidator />
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 8px 16px 8px 0px;">
                        <div class="form-section-header" style="margin-bottom: 10px; margin-top: 4px; padding-bottom: 4px; border-bottom: 1px solid #f1f5f9;">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #02659e; text-transform: uppercase; letter-spacing: 0.5px;">General Information</div>
                        </div>

                        <div class="form-grid">
                            <div class="field-group col-prefix">
                                <label class="field-label">Short Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.shortname" />
                            </div>
                            <div class="field-group col-main">
                                <label class="field-label required">Category Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.categoryname" />
                                <ValidationMessage For="() => CurrentItem.categoryname" class="text-danger small" />
                            </div>

                            <div class="field-group col-6">
                                <label class="field-label required">Parent Category</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentItem.parentcategorycode">
                                    <option value="0">-- Select Parent --</option>
                                    @foreach (var p in ParentCategoryList)
                                    {
                                        <option value="@p.parentcategorycode">@p.parentcategoryname</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="field-group col-6">
                                <label class="field-label">Is Active?</label>
                                <div class="premium-segmented-control-joined">
                                    <button type="button" class="segment-btn-joined btn-false @(CurrentItem.isactive ? "" : "active")" @onclick="() => CurrentItem.isactive = false">
                                        False
                                    </button>
                                    <button type="button" class="segment-btn-joined btn-true @(CurrentItem.isactive ? "active" : "")" @onclick="() => CurrentItem.isactive = true">
                                        True
                                    </button>
                                </div>
                            </div>

                            <div class="field-group col-12">
                                <label class="field-label">Description</label>
                                <InputTextArea class="form-control premium-input" @bind-Value="CurrentItem.description" rows="2" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-actions" style="display: flex; justify-content: flex-end; gap: 1rem; padding: 1.5rem 2rem; border-top: 1px solid #f1f5f9; background: #fff;">
                        <button type="button" class="btn-cancel-modal" @onclick="CloseModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.75rem 2rem; border-radius: 12px; font-weight: 700; min-width: 120px;">
                            Cancel
                        </button>
                        <button type="submit" class="btn-save-premium" disabled="@IsSaving" style="background: #1c9f5f; color: white; border: none; padding: 0.75rem 2.5rem; border-radius: 12px; font-weight: 700; display: flex; align-items: center; gap: 8px; min-width: 160px; box-shadow: 0 4px 12px rgba(28, 159, 95, 0.2);">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle" style="font-size: 1.2rem;"></i>
                            }
                            <span>@(IsEdit ? "Update" : "Save")</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeleteConfirm = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Category</div>
            <div class="action-popup-body">Are you sure you want to delete this category?</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowDeleteConfirm = false">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" disabled="@IsDeleteProcessing" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<category_master> ItemList = new();
    private List<parent_category_master> ParentCategoryList = new();
    private string SearchQuery = string.Empty;
    private bool IsLoading;
    private bool IsCardView;
    private const string DefaultTenantCode = "TEN1011";

    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 8;

    private bool ShowModal = false;
    private bool IsEdit = false;
    private bool IsSaving = false;
    private bool ShowDeleteConfirm = false;
    private bool IsDeleteProcessing = false;
    private category_master? PendingDelete;
    private category_master CurrentItem = new() { tenantcode = DefaultTenantCode, isactive = true };

    private IEnumerable<category_master> FilteredItems =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? ItemList
            : ItemList.Where(i =>
                (i.categoryname?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                i.categorycode.ToString().Contains(SearchQuery));

    private IEnumerable<category_master> PagedItems =>
        FilteredItems.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    private int TotalPages => (int)Math.Ceiling((double)FilteredItems.Count() / ItemsPerPage);

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        CurrentPage = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadParents();
        await LoadData();
    }

    private HttpClient CreateTenantClient()
    {
        var client = ClientFactory.CreateClient("InventoryApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenantCode);
        return client;
    }

    private void SetView(bool cardView)
    {
        IsCardView = cardView;
        CurrentPage = 1;
    }

    private async Task LoadParents()
    {
        try
        {
            var client = CreateTenantClient();
            var responseString = await client.GetStringAsync("ItemMaster/getparentcategory");

            try
            {
                var direct = System.Text.Json.JsonSerializer.Deserialize<List<parent_category_master>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ParentCategoryList = (direct ?? new List<parent_category_master>()).Where(x => !x.deleted).ToList();
            }
            catch
            {
                var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<parent_category_master>>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ParentCategoryList = (wrapped?.data ?? new List<parent_category_master>()).Where(x => !x.deleted).ToList();
            }
        }
        catch
        {
            ParentCategoryList = new List<parent_category_master>();
        }
    }

    private async Task LoadData()
    {
        IsLoading = true;
        try
        {
            var client = CreateTenantClient();
            var responseString = await client.GetStringAsync("ItemMaster/getcategory");

            try
            {
                var direct = System.Text.Json.JsonSerializer.Deserialize<List<category_master>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ItemList = (direct ?? new List<category_master>()).Where(x => !x.deleted).ToList();
            }
            catch
            {
                var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<category_master>>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ItemList = (wrapped?.data ?? new List<category_master>()).Where(x => !x.deleted).ToList();
            }
        }
        catch
        {
            ItemList = new List<category_master>();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void AddNew()
    {
        CurrentItem = new category_master { tenantcode = DefaultTenantCode, isactive = true };
        IsEdit = false;
        ShowModal = true;
    }

    private void Edit(category_master item)
    {
        CurrentItem = new category_master
        {
            categorycode = item.categorycode,
            categoryname = item.categoryname,
            shortname = item.shortname,
            description = item.description,
            parentcategorycode = item.parentcategorycode,
            isactive = item.isactive,
            tenantcode = DefaultTenantCode
        };
        IsEdit = true;
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
        IsSaving = false;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(CurrentItem.categoryname))
        {
            NotificationService.ShowNotification("Please provide a category name.", NotificationType.Warning);
            return;
        }
        
        if (CurrentItem.parentcategorycode <= 0)
        {
            NotificationService.ShowNotification("Please select a valid Parent Category.", NotificationType.Warning);
            return;
        }

        IsSaving = true;
        try
        {
            var client = CreateTenantClient();
            CurrentItem.tenantcode = DefaultTenantCode;
            CurrentItem.shortname ??= "";
            CurrentItem.description ??= "";

            var isUpdate = IsEdit;
            var baseUrl = isUpdate ? "ItemMaster/updatecategory" : "ItemMaster/insertcategory";
            
            var response = await client.PostAsJsonAsync(baseUrl, CurrentItem);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification(isUpdate ? "Updated successfully" : "Added successfully", NotificationType.Success);
                CloseModal();
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.ShowNotification($"Save failed: {error}", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(category_master item)
    {
        PendingDelete = item;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteConfirmed()
    {
        var item = PendingDelete;
        if (item is null)
        {
            ShowDeleteConfirm = false;
            return;
        }

        IsDeleteProcessing = true;
        try
        {
            var client = CreateTenantClient();
            var response = await client.DeleteAsync($"ItemMaster/deletecategory?id={item.categorycode}");
            
            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification("Deleted successfully", NotificationType.Success);
                await LoadData();
            }
            else
            {
                var fallbackResponse = await client.GetAsync($"ItemMaster/deletecategory?id={item.categorycode}");
                if (fallbackResponse.IsSuccessStatusCode)
                {
                    NotificationService.ShowNotification("Deleted successfully", NotificationType.Success);
                    await LoadData();
                }
                else
                {
                    NotificationService.ShowNotification("Delete failed.", NotificationType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error deleting: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsDeleteProcessing = false;
            ShowDeleteConfirm = false;
            PendingDelete = null;
        }
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            StateHasChanged();
        }
    }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }
}



