@page "/ledgermaster"
@page "/ledgers"
@using Inventory_management_frontend.Models
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject NotificationService NotificationService

<div class="items-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Ledger Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total ledgers : @LedgerList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by name, code, HSN..." @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    <button class="add-item-btn" @onclick="AddNewLedger">
                        <i class="bi bi-plus-lg"></i>
                        <span class="ms-1">Add Ledger</span>
                    </button>
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredLedgers.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        No ledgers found. Create a new ledger mapping.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive" style="overflow-x: clip;">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">S.NO</th>
                                    <th>LEDGER CODE</th>
                                    <th>LEDGER NAME</th>
                                    <th>TAX TYPE</th>
                                    <th>TAX SUB-TYPE</th>
                                    <th>TAX %</th>
                                    <th>GST %</th>
                                    <th>HSN CODE</th>
                                    <th>STATUS</th>
                                    <th style="width: 100px;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedLedgers.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td>@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td class="fw-bold text-primary">#@row.value.lcode</td>
                                        <td class="fw-bold text-dark">@row.value.ledgername</td>
                                        <td><span class="badge bg-light text-dark border">@row.value.taxtype</span></td>
                                        <td><span class="badge bg-light text-dark border">@row.value.taxsubtype</span></td>
                                        <td>@row.value.taxpercentage.ToString("N2")%</td>
                                        <td class="fw-bold text-success">@row.value.gstpercentage.ToString("N2")%</td>
                                        <td class="text-muted">@(string.IsNullOrEmpty(row.value.hsncode) ? "-" : row.value.hsncode)</td>
                                        <td>
                                            @if (row.value.isactive) {
                                                <span class="badge bg-success">Active</span>
                                            } else {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="action-btn btn-edit" @onclick="() => EditLedger(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var ledger in PagedLedgers)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span>#@ledger.lcode - @ledger.ledgername</span>
                                    <div>
                                        <button class="action-btn btn-edit" @onclick="() => EditLedger(ledger)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(ledger)" title="Delete"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Ledger Group</span><strong>@ledger.ldgcode</strong></div>
                                    <div class="detail-row"><span>Tax Details</span><strong>@ledger.taxtype / @ledger.taxsubtype</strong></div>
                                    <div class="detail-row"><span>Tax Rate</span><strong>@ledger.taxpercentage.ToString("N2")%</strong></div>
                                    <div class="detail-row"><span>GST Rate</span><strong class="text-success">@ledger.gstpercentage.ToString("N2")%</strong></div>
                                    <div class="detail-row"><span>HSN Code</span><strong>@(string.IsNullOrEmpty(ledger.hsncode) ? "-" : ledger.hsncode)</strong></div>
                                    <div class="detail-row"><span>Status</span><strong>@(ledger.isactive ? "Active" : "Inactive")</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredLedgers.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredLedgers.Count()))</strong> of <strong>@FilteredLedgers.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 800px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #02659e !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Ledger Master" : "Add Ledger Master")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentItem" OnValidSubmit="Save" autocomplete="off">
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 16px 16px 8px 0px;">
                        
                        <div class="form-grid">
                            <div class="field-group col-6">
                                <label class="field-label required">Ledger Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.ledgername" placeholder="E.g. Sales Ledger" />
                            </div>
                            
                            <!-- Dynamic Dropdowns for Ledger Type and Ledger Group -->
                            <div class="field-group col-3">
                                <label class="field-label required">Ledger Type</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentItem.lcode">
                                    <option value="">Select Type...</option>
                                    @foreach (var type in LedgerTypeList)
                                    {
                                        <option value="@type.ledgertypecode.ToString()">@type.ledgertypename</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label required">Ledger Group</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentItem.ldgcode">
                                    <option value="">Select Group...</option>
                                    @foreach (var group in LedgerGroupList)
                                    {
                                        <option value="@group.ledgergroupcode.ToString()">@group.ledgergroupname</option>
                                    }
                                </InputSelect>
                            </div>
                            
                            <div class="field-group col-3">
                                <label class="field-label">Tax Type</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.taxtype" placeholder="E.g. GST" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Tax Sub-type</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.taxsubtype" placeholder="E.g. CGST" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Tax Percentage (%)</label>
                                <InputNumber class="form-control premium-input" @bind-Value="TaxPercentageInput" placeholder="0.00" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label required">GST Percentage (%)</label>
                                <InputNumber class="form-control premium-input" @bind-Value="GstPercentageInput" placeholder="0.00" />
                            </div>

                            <div class="field-group col-6" style="margin-top: 10px;">
                                <label class="field-label">HSN Code</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.hsncode" placeholder="E.g. 9983" />
                            </div>
                            <div class="field-group col-6" style="margin-top: 10px;">
                                <label class="field-label">Is Active?</label>
                                <div class="premium-segmented-control-joined">
                                    <button type="button" class="segment-btn-joined btn-false @(CurrentItem.isactive ? "" : "active")" @onclick="() => CurrentItem.isactive = false">
                                        False
                                    </button>
                                    <button type="button" class="segment-btn-joined btn-true @(CurrentItem.isactive ? "active" : "")" @onclick="() => CurrentItem.isactive = true">
                                        True
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer-actions" style="display: flex; justify-content: flex-end; align-items: center; padding: 1.5rem 2rem; border-top: 1px solid #f1f5f9; background: #fff;">
                        <div class="footer-right" style="display: flex; gap: 1rem; align-items: center;">
                            <button type="button" class="btn-cancel-modal" @onclick="CloseModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.75rem 2rem; border-radius: 12px; font-weight: 700; min-width: 120px; transition: all 0.2s;">
                                Cancel
                            </button>
                            <button type="submit" class="btn-save-premium" disabled="@IsSaving" style="background: #1c9f5f; color: white; border: none; padding: 0.75rem 2.5rem; border-radius: 12px; font-weight: 700; display: flex; align-items: center; gap: 8px; min-width: 160px; box-shadow: 0 4px 12px rgba(28, 159, 95, 0.2); transition: all 0.2s;">
                                @if (IsSaving)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle" style="font-size: 1.2rem;"></i>
                                }
                                <span>@(IsEdit ? "Update Ledger" : "Save Ledger")</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation -->
@if (ShowDeletePopup)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeletePopup = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Ledger</div>
            <div class="action-popup-body">Are you sure you want to delete this ledger mapping?</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowDeletePopup = false">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" disabled="@IsDeleteProcessing" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<ledger_master> LedgerList = new();
    private List<ledger_type_master> LedgerTypeList = new();
    private List<ledger_group_master> LedgerGroupList = new();
    
    private string SearchQuery = string.Empty;
    private bool IsLoading;
    private bool IsSaving;
    private bool ShowModal;
    private bool IsEdit;
    private bool ShowDeletePopup;
    private bool IsDeleteProcessing;
    private bool IsCardView = false;
    
    private ledger_master CurrentItem = new();
    private ledger_master? PendingDelete;

    private const string DefaultTenantCode = "TEN1011";

    private decimal? TaxPercentageInput
    {
        get => !IsEdit && CurrentItem.taxpercentage == 0 ? null : CurrentItem.taxpercentage;
        set => CurrentItem.taxpercentage = value ?? 0;
    }

    private decimal? GstPercentageInput
    {
        get => !IsEdit && CurrentItem.gstpercentage == 0 ? null : CurrentItem.gstpercentage;
        set => CurrentItem.gstpercentage = value ?? 0;
    }

    private void SetView(bool cardView)
    {
        IsCardView = cardView;
        CurrentPage = 1;
    }

    private IEnumerable<ledger_master> FilteredLedgers =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? LedgerList
            : LedgerList.Where(l => 
                (l.ledgername?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.lcode?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.hsncode?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    // Pagination
    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 8;
    private int TotalPages => (int)Math.Ceiling((double)FilteredLedgers.Count() / ItemsPerPage);
    private IEnumerable<ledger_master> PagedLedgers => FilteredLedgers.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadLedgers(), LoadTypes(), LoadGroups());
    }

    private async Task LoadTypes()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getledgertype");
            var direct = System.Text.Json.JsonSerializer.Deserialize<List<ledger_type_master>>(response, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            LedgerTypeList = (direct ?? new List<ledger_type_master>()).Where(x => !x.deleted).ToList();
        }
        catch { }
    }
    
    private async Task LoadGroups()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getledgergroup");
            var direct = System.Text.Json.JsonSerializer.Deserialize<List<ledger_group_master>>(response, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            LedgerGroupList = (direct ?? new List<ledger_group_master>()).Where(x => !x.deleted).ToList();
        }
        catch { }
    }

    private async Task LoadLedgers()
    {
        IsLoading = true;
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getledger");
            
            try
            {
                var direct = System.Text.Json.JsonSerializer.Deserialize<List<ledger_master>>(response, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                LedgerList = (direct ?? new List<ledger_master>()).Where(x => !x.deleted).ToList();
            }
            catch
            {
                var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<ledger_master>>>(response, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                LedgerList = (wrapped?.data ?? new List<ledger_master>()).Where(x => !x.deleted).ToList();
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error loading ledgers: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("InventoryApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenantCode);
        return client;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        CurrentPage = 1;
    }

    private void AddNewLedger()
    {
        CurrentItem = new ledger_master 
        { 
            tenantcode = DefaultTenantCode, 
            deleted = false, 
            isactive = true,
            createddate = DateTime.Now,
            taxtype = "GST",
            taxsubtype = "CGST"
        };
        IsEdit = false;
        ShowModal = true;
    }

    private void EditLedger(ledger_master ledger)
    {
        CurrentItem = new ledger_master 
        { 
            ledgercode = ledger.ledgercode,
            ledgername = ledger.ledgername,
            lcode = ledger.lcode,
            ldgcode = ledger.ldgcode,
            taxtype = ledger.taxtype,
            taxsubtype = ledger.taxsubtype,
            taxpercentage = ledger.taxpercentage,
            gstpercentage = ledger.gstpercentage,
            hsncode = ledger.hsncode,
            isactive = ledger.isactive,
            tenantcode = ledger.tenantcode ?? DefaultTenantCode,
            deleted = ledger.deleted,
            createddate = ledger.createddate
        };
        IsEdit = true;
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
        IsSaving = false;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(CurrentItem.ledgername))
        {
            NotificationService.ShowNotification("Ledger Name is required", NotificationType.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(CurrentItem.lcode))
        {
            NotificationService.ShowNotification("Ledger Type is required", NotificationType.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(CurrentItem.ldgcode))
        {
            NotificationService.ShowNotification("Ledger Group is required", NotificationType.Warning);
            return;
        }

        IsSaving = true;
        try
        {
            var client = CreateClient();
            CurrentItem.tenantcode = DefaultTenantCode;
            CurrentItem.taxtype ??= "";
            CurrentItem.taxsubtype ??= "";
            CurrentItem.hsncode ??= "";

            HttpResponseMessage response;
            if (IsEdit)
            {
                response = await client.PostAsJsonAsync("ItemMaster/updateledger", CurrentItem);
            }
            else
            {
                response = await client.PostAsJsonAsync("ItemMaster/insertledger", CurrentItem);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification(IsEdit ? "Ledger updated successfully" : "Ledger added successfully", NotificationType.Success);
                ShowModal = false;
                await LoadLedgers();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                NotificationService.ShowNotification($"Save failed: {err}", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error saving ledger: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(ledger_master ledger)
    {
        PendingDelete = ledger;
        ShowDeletePopup = true;
    }

    private async Task DeleteConfirmed()
    {
        if (PendingDelete == null) return;

        IsDeleteProcessing = true;
        try
        {
            var client = CreateClient();
            var ledgerCode = PendingDelete.ledgercode;

            // Try multiple delete approaches for maximum backend compatibility
            var attempts = new Func<Task<HttpResponseMessage>>[]
            {
                () => client.GetAsync($"ItemMaster/deleteledger?ledgercode={ledgerCode}"),
                () => client.DeleteAsync($"ItemMaster/deleteledger?ledgercode={ledgerCode}"),
                () => client.DeleteAsync($"ItemMaster/deleteledger/{ledgerCode}"),
                () => client.PostAsJsonAsync("ItemMaster/deleteledger", new { ledgercode = ledgerCode, tenantcode = DefaultTenantCode }),
                () => client.PostAsync($"ItemMaster/deleteledger?ledgercode={ledgerCode}", null)
            };

            bool success = false;
            foreach (var attempt in attempts)
            {
                try {
                    var response = await attempt();
                    if (response.IsSuccessStatusCode) {
                        success = true;
                        break;
                    }
                } catch {}
            }

            if (success)
            {
                NotificationService.ShowNotification("Ledger deleted successfully", NotificationType.Success);
                ShowDeletePopup = false;
                await LoadLedgers();
            }
            else
            {
                NotificationService.ShowNotification("Delete failed", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsDeleteProcessing = false;
            PendingDelete = null;
        }
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }
}
