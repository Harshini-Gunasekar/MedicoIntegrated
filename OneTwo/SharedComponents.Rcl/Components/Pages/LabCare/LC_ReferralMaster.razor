    private async Task SaveQuickArea()
    {
        if (string.IsNullOrWhiteSpace(newAreaName))
        {
            ShowAlert("Error: Area Name is required.", true);
            return;
        }
        try
        {
            int? parsedCityCode = null;
            if (int.TryParse(newAreaCityCode, out int cc))
            {
                parsedCityCode = cc;
            }

            var areaObj = new AreaModel
            {
                areaname = newAreaName,
                shortname = newAreaShortName,
                orderno = newAreaOrderNo ?? 0,
                citycode = parsedCityCode,
                areapincode = newAreaPincode,
                homecollectioncharge = newAreaHomeCollectionCharge ?? 0,
                deleted = false,
                tenant_code = TenantCode,
                entereddate = DateTime.Now,
                ibsdate = DateTime.Now
            };

            // Automatically set State and Country codes based on the selected city
            if (parsedCityCode.HasValue)
            {
                var cityObj = cities.FirstOrDefault(c => c.citycode == parsedCityCode.Value);
                if (cityObj != null)
                {
                    areaObj.statecode = cityObj.statecode;
                    areaObj.countrycode = cityObj.countrycode;
                }
            }

            using var client = CreateClient();
            var response = await client.PostAsJsonAsync($"{BaseUrl}Area/insert", areaObj);
            if (response.IsSuccessStatusCode)
            {
                showAreaModal = false;
                newAreaName = "";
                newAreaShortName = "";
                newAreaOrderNo = null;
                newAreaCityCode = "";
                newAreaPincode = "";
                newAreaHomeCollectionCharge = null;
                await LoadAreas();

                // Auto-select the newly added Area
                var savedArea = areas.FirstOrDefault(a => a.areaname?.Trim().Equals(areaObj.areaname.Trim(), StringComparison.OrdinalIgnoreCase) == true);
                if (savedArea != null)
                {
                    SelectedArea = savedArea.areaname;
