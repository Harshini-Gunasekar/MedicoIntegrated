@code {
    private List<DoctorModel> doctors = new();
    private bool showForm = false;
    private DoctorModel newDoctor = new() { icpaymode = "Cash" };
    private bool isEditMode = false;
    private int CurrentPage = 1;
    private int PageSize = 5;
    private bool HasNextPage = true;
    private string searchTerm = "";
    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;
    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";
    private bool showDoctorDropdown = false;
    private bool showQualificationDropdown = false;
    private string qualificationSearchText = "";
    private bool showTypeDropdown = false;
    private string typeSearchText = "";
    private List<string> standardTypes = new() { "Doctor", "Lab", "Clinic", "Hospital", "Insurance", "Other" };
    private string AlertMessage = "";
    private bool IsError = false;
    private bool isSubmitted = false;

    private List<CityModel> cities = new();
    private List<StateModel> states = new();
    private List<CountryModel> countries = new();
    private List<AreaModel> areas = new();
    private List<PrefixModel> prefixesList = new();
    private List<DoctorTypeModel> doctorTypes = new();
    private List<DoctorSpecialtyMasterModel> doctorSpecialties = new();
    private List<QualificationModel> qualifications = new();
    private List<FeetypeModel> feeTypes = new();
    private List<ReimbursementCompanyModel> reimbursementCompanies = new();

    private void ShowAlert(string message, bool isError)
    {
        AlertMessage = message;
        IsError = isError;
        StateHasChanged();
    }


    private IEnumerable<DoctorModel> FilteredDoctors =>
        doctors.Where(d => string.IsNullOrWhiteSpace(searchTerm) ||
            (d.name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (d.email?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (d.mobile?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (d.address?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            d.dcode.ToString().Contains(searchTerm));

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    // Ensure global state is synced
                    TenantState.SetSession(TenantCode, AuthToken, TenantName);

                    await LoadDoctors();
                    await LoadCountries();
                    await LoadStates();
                    await LoadCities();
                    await LoadAreas();
                    await LoadPrefixes();
                    await LoadDoctorTypes();
                    await LoadDoctorSpecialties();
                    await LoadQualifications();
                    await LoadFeeTypes();
                    await LoadReimbursementCompanies();
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                /* Console.WriteLine($"Error getting tenant data during first render: {ex.Message}") */;
            }
        }
    }


    private async Task LoadDoctors()
    {
        try
        {
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}Doctor/partition?pagenumber={CurrentPage}&pagesize={PageSize}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var list = JsonConvert.DeserializeObject<List<DoctorModel>>(json) ?? new();
                doctors = list.Where(d => !d.deleted).ToList();
                HasNextPage = list.Count == PageSize;
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                ShowAlert($"Failed to load doctors. Code: {response.StatusCode}. Details: {errorBody}", true);
                Console.Error.WriteLine($"Error loading doctors: {response.StatusCode} - {errorBody}");
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Error loading doctors: {ex.Message}", true);
            /* Console.WriteLine($"Error loading doctors: {ex.Message}") */;
        }
    }

    private HttpClient CreateClient() 
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private async Task NextPage()
    {
        if (HasNextPage)
        {
            CurrentPage++;
            await LoadDoctors();
        }
    }

    private async Task PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            await LoadDoctors();
        }
    }

    private async Task LoadCities()
    {
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}City/get";
            cities = await client.GetFromJsonAsync<List<CityModel>>(url) ?? new();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading cities: {ex.Message}");
        }
    }
    private async Task LoadStates()
    {
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}State/getall";
            states = await client.GetFromJsonAsync<List<StateModel>>(url) ?? new();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading states: {ex.Message}");
        }
    }
    private async Task LoadCountries()
    {
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}Country/get";
            countries = await client.GetFromJsonAsync<List<CountryModel>>(url) ?? new();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading countries: {ex.Message}");
        }
    }
    private async Task LoadAreas()
    {
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}Area/get";
            areas = await client.GetFromJsonAsync<List<AreaModel>>(url) ?? new();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading areas: {ex.Message}");
        }
    }

    private async Task LoadPrefixes()
    {
        try
        {
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}prefixes/getall");
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                try
                {
                    var list = new List<PrefixModel>();
                    var token = Newtonsoft.Json.Linq.JToken.Parse(content);
                    if (token is Newtonsoft.Json.Linq.JArray array)
                    {
                        foreach (var item in array)
                        {
                            if (item.Type == Newtonsoft.Json.Linq.JTokenType.Object)
                            {
                                var model = item.ToObject<PrefixModel>() ?? new();
                                // Better fallback: prioritize likely names and exclude tenant/code fields
                                if (string.IsNullOrEmpty(model.DisplayName))
                                {
                                    var likelyNames = new[] { "name", "prefix", "title", "text", "value" };
                                    var obj = (Newtonsoft.Json.Linq.JObject)item;
                                    foreach (var ln in likelyNames)
                                    {
                                        var p = obj.Property(ln, StringComparison.OrdinalIgnoreCase);
                                        if (p != null && p.Value.Type == Newtonsoft.Json.Linq.JTokenType.String)
                                        {
                                            model.name = p.Value.ToString();
                                            break;
                                        }
                                    }

                                    if (string.IsNullOrEmpty(model.DisplayName))
                                    {
                                        foreach (var prop in obj.Properties())
                                        {
                                            if (prop.Value.Type == Newtonsoft.Json.Linq.JTokenType.String &&
                                                !prop.Name.Contains("tenant", StringComparison.OrdinalIgnoreCase) &&
                                                !prop.Name.Contains("code", StringComparison.OrdinalIgnoreCase))
                                            {
                                                model.name = prop.Value.ToString();
                                                break;
                                            }
                                        }
                                    }
                                }
                                list.Add(model);
                            }
                            else if (item.Type == Newtonsoft.Json.Linq.JTokenType.String)
                            {
                                list.Add(new PrefixModel { name = item.ToString() });
                            }
                        }
                    }
                    prefixesList = list;
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Error parsing prefixes content: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading prefixes: {ex.Message}");
        }
    }

