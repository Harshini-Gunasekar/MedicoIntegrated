                var err = await response.Content.ReadAsStringAsync();
                ShowAlert($"❌ Failed to save area: {err}", true);
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"❌ Error: {ex.Message}", true);
        }
    }

