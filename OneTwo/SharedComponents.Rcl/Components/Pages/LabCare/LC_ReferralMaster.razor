    private void CreateNewDoctor()
    {
        newDoctor = new() { icpaymode = "Cash" };
        qualificationSearchText = "";
        typeSearchText = "";
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveDoctor()
    {
        isSubmitted = true;
        if (string.IsNullOrEmpty(TenantCode))
        {
            ShowAlert("Error: Tenant code is not loaded. Please refresh.", true);
            return;
        }

        // Field Validation matching Branch Master style
        if (string.IsNullOrWhiteSpace(newDoctor.name))
        {
            ShowAlert("Error: Doctor Name is required.", true);
            return;
        }
        if (string.IsNullOrWhiteSpace(newDoctor.entrytype))
        {
            ShowAlert("Error: Doctor Type is required.", true);
            return;
        }
        if (string.IsNullOrWhiteSpace(newDoctor.qualification_dr))
        {
            ShowAlert("Error: Specialty is required.", true);
            return;
        }
        if (string.IsNullOrWhiteSpace(newDoctor.mobile))
        {
            ShowAlert("Error: Mobile Number is required.", true);
            return;
        }

        if (string.IsNullOrWhiteSpace(newDoctor.email))
        {
            ShowAlert("Error: Email Address is required.", true);
            return;
        }

        try
        {
            if (!string.IsNullOrWhiteSpace(qualificationSearchText))
            {
                var existingQual = qualifications.FirstOrDefault(q => 
                    (q.name?.Trim().Equals(qualificationSearchText.Trim(), StringComparison.OrdinalIgnoreCase) == true) ||
                    (q.shortname?.Trim().Equals(qualificationSearchText.Trim(), StringComparison.OrdinalIgnoreCase) == true)
                );

                if (existingQual != null)
                {
                    newDoctor.qualification = (int?)existingQual.qcode;
                }
                else
                {
                    var newQual = new QualificationModel
                    {
                        name = qualificationSearchText.Trim(),
                        shortname = qualificationSearchText.Length > 10 ? qualificationSearchText.Substring(0, 10).Trim() : qualificationSearchText.Trim(),
                        orderno = (qualifications.Any() ? (qualifications.Max(q => q.orderno) ?? 0) : 0) + 1,
                        deleted = false,
                        computercode = 1,
                        usercode = 1,
                        tenant_code = TenantCode,
                        entereddate = DateTime.Now,
                        ibsdate = DateTime.Now
                    };

                    using var qualClient = CreateClient();
                    var qualResponse = await qualClient.PostAsJsonAsync($"{BaseUrl}Qualification/insert", newQual);
                    if (qualResponse.IsSuccessStatusCode)
                    {
                        await LoadQualifications();
                        var createdQual = qualifications.FirstOrDefault(q => 
                            q.name?.Trim().Equals(qualificationSearchText.Trim(), StringComparison.OrdinalIgnoreCase) == true
                        );
                        if (createdQual != null)
                        {
                            newDoctor.qualification = (int?)createdQual.qcode;
                        }
                    }
                    else
                    {
                        var errBody = await qualResponse.Content.ReadAsStringAsync();
                        ShowAlert($"Failed to auto-create new qualification. Details: {errBody}", true);
                        return;
                    }
                }
            }
            else
            {
                newDoctor.qualification = null;
            }

            newDoctor.tenant_code = TenantCode;
            using var client = CreateClient();
            HttpResponseMessage response;
            if (isEditMode)
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}Doctor/update", newDoctor);
            }
            else
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}Doctor/insert", newDoctor);
            }

            if (response.IsSuccessStatusCode)
            {
                ShowAlert(isEditMode ? "Doctor updated successfully!" : "Doctor created successfully!", false);
                showForm = false;
                newDoctor = new();
                qualificationSearchText = "";
                typeSearchText = "";
                await LoadDoctors();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                ShowAlert($"Failed to save doctor. Code: {response.StatusCode}. Details: {errorBody}", true);
                /* Console.WriteLine($"API Error saving doctor: {response.StatusCode} - {errorBody}") */;
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Error saving doctor: {ex.Message}", true);
            /* Console.WriteLine($"Error saving doctor: {ex.Message}") */;
        }
    }

    private Task EditDoctor(int dcode)
    {
        try
        {
            var doctorToEdit = doctors.FirstOrDefault(d => d.dcode == dcode);
            if (doctorToEdit != null)
            {
                var json = JsonConvert.SerializeObject(doctorToEdit);
                newDoctor = JsonConvert.DeserializeObject<DoctorModel>(json) ?? new();
                if (newDoctor.qualification.HasValue)
                {
                    var qual = qualifications.FirstOrDefault(q => q.qcode == newDoctor.qualification.Value);
                    qualificationSearchText = qual != null ? (qual.name ?? qual.shortname ?? "") : "";
                }
                else
                {
                    qualificationSearchText = "";
                }
                typeSearchText = newDoctor.description ?? "";
                isEditMode = true;
                showForm = true;
                isSubmitted = false;
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error editing doctor: {ex.Message}") */;
        }
        return Task.CompletedTask;
    }

