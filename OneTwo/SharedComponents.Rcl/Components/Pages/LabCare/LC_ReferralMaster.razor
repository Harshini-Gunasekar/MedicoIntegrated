    {
        if (isEditMode && newDoctor.dcode > 0)
        {
            await DeleteDoctor(newDoctor.dcode);
        }
        else
        {
            showForm = false;
        }
    }

    private async Task DeleteDoctor(int dcode)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the doctor with ID {dcode}?"))
        {
            try
            {
                using var client = CreateClient();
                var response = await client.GetAsync($"{BaseUrl}Doctor/softdelete?dcode={dcode}");
                if (response.IsSuccessStatusCode)
                {
                    ShowAlert("Doctor removed successfully.", false);
                    await LoadDoctors();
                    if (showForm && isEditMode && newDoctor.dcode == dcode)
                    {
                        showForm = false;
                        newDoctor = new();
                    }
                }
                else
                {
                    var errorBody = await response.Content.ReadAsStringAsync();
                    ShowAlert($"Failed to delete doctor. Code: {response.StatusCode}. Details: {errorBody}", true);
                    /* Console.WriteLine($"API Error deleting doctor: {response.StatusCode} - {errorBody}") */;
                }
            }
            catch (Exception ex)
            {
                ShowAlert($"Error deleting doctor: {ex.Message}", true);
                /* Console.WriteLine($"Error deleting doctor: {ex.Message}") */;
            }
        }
    }

