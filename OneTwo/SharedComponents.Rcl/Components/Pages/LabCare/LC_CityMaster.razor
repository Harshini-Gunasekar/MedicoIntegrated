@page "/citymaster"
@using Newtonsoft.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject ProtectedSessionStorage _sessionStorage
@inject TenantSessionState TenantState

<div class="referral-page">
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">location_city</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">City Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Urban Directory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search cities..." @bind="SearchQuery" @bind:event="oninput" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 8px 16px 8px 36px; font-size: 13px; color: #1e293b; outline: none; width: 200px;" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewCity">+ Add New</button>
            </div>
        </div>
    </div>

    

    @if (showForm)
    {
            <div class="modal-overlay">
                <div class="modal-form-card">
                    <div class="modal-header-bar">
                        <h3>@(isEditMode ? "Edit City" : "New City Entry")</h3>
                        <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                            </svg>
                        </button>
                    </div>
                    <div class="modal-body">
                        
                        <div class="mb-0 form-section">
                            <div class="mt-0">
                                <div class="um-grid-row">
                                    <div class="form-group position-relative">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                            <label style="margin-bottom: 0;">City Name</label>
                                            @if (isSubmitted && string.IsNullOrEmpty(current.cityname))
                                            {
                                                <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                            }
                                        </div>
                                        <input type="text" class="lab-input" @bind="current.cityname" @bind:event="oninput" @onfocus="() => showCityDropdown = true" @onblur="HideCityDropdown" placeholder="Search or Edit City Name" @(isSubmitted && string.IsNullOrEmpty(current.cityname) ? "is-invalid" : "") required />
                                        @if (showCityDropdown && !string.IsNullOrWhiteSpace(current.cityname) && !isEditMode)
                                        {
                                            var matchedCities = cities
                                                .Where(c => c.cityname != null && c.cityname.Contains(current.cityname, StringComparison.OrdinalIgnoreCase))
                                                .ToList();

                                            if (matchedCities.Any())
                                            {
                                                <div class="master-search-dropdown show">
                                                    @foreach (var c in matchedCities)
                                                    {
                                                        <button type="button" class="master-search-item" @onmousedown="() => SelectExistingCity(c)">
                                                            @c.cityname
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="um-grid-cols-3">
                                    <div class="form-group">
                                        <label>Order no</label>
                                        <input type="number" class="lab-input" @bind="current.orderno" placeholder="01" />
                                    </div>
                                    <div class="form-group">
                                        <label>Short Name</label>
                                        <input type="text" class="lab-input" @bind="current.shortname" />
                                    </div>
                                    <div class="form-group">
                                        <label>Narration</label>
                                        <input type="text" class="lab-input" @bind="current.description" placeholder="" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-bar">
                        <button type="button" class="btn-delete" @onclick="() => SoftDeleteCity(current.citycode)" disabled="@(current.citycode == 0)">
                            Delete
                        </button>
                        <button type="button" class="btn-save" @onclick="SaveCity">
                             <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                                <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                            </svg>
                            Save City
                        </button>

                    </div>
                </div>
            </div>
        }

    <div class="directory-section" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-top: -4px;">

        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th style="width: 64px;">ORDER NO</th>
                        <th>SHORT NAME</th>
                        <th>CITY NAME</th>
                        <th>NARRATION</th>
                        <th>ENTERED DATE</th>
                        <th>MODIFIED DATE</th>
                        <th class="text-center" style="width: 128px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cities != null && cities.Any())
                    {
                        @foreach (var co in FilteredCitiesBySearch)
                        {
                            <tr>
                                <td><span class="td-order-no">@($"{co.orderno:00}")</span></td>
                                <td style="color: #64748b; font-family: monospace;">@co.shortname</td>
                                <td><span class="td-name">@co.cityname</span></td>
                                <td><span class="td-narration">@co.description</span></td>
                                <td>@($"{co.entereddate:M/d/yyyy h:mm tt}")</td>
                                <td>@($"{co.ibsdate:M/d/yyyy h:mm tt}")</td>
                                <td class="text-center">
                                    <button type="button" class="btn-action btn-edit" @onclick="() => EditCity(co)" title="Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg>
                                    </button>
                                    <button type="button" class="btn-action btn-delete-action" @onclick="() => SoftDeleteCity(co.citycode)" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="td-narration p-24 text-center">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<CityModel> cities = new();
    private IEnumerable<CityModel> FilteredCities =>
        displayActiveOnly ? cities.Where(c => c.deleted != true) : cities;

    private IEnumerable<CityModel> FilteredCitiesBySearch =>
        FilteredCities.Where(c => 
            string.IsNullOrWhiteSpace(SearchQuery) || 
            (c.cityname != null && c.cityname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.shortname != null && c.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (states.Any(s => s.statecode == c.statecode && s.statename != null && s.statename.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))) ||
            (countries.Any(co => co.countrycode == c.countrycode && co.countryname != null && co.countryname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))));
    
    private List<CountryModel> countries = new();
    private List<StateModel> states = new();

    private CityModel current = new();
    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;
    private bool isEditMode = false;
    private bool displayActiveOnly = true;
    private bool showForm = false;
    private bool isSubmitted = false;
    private bool showCityDropdown = false;
    private string SearchQuery = "";

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    // Ensure the global state container is updated so HttpClient headers are injected
                    TenantState.SetSession(TenantCode, AuthToken, TenantName);

                    await LoadCountries();
                    await LoadStates();
                    await LoadCities();
                    StateHasChanged();
                }
                else
                {
                    errorMessage = "Access denied: Missing valid session. Please log in again.";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Session Load Error: {ex.Message}";
                /* Console.WriteLine($"Error getting tenant data: {ex.Message}") */;
                StateHasChanged();
            }
        }
    }

    private HttpClient CreateClient() 
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private async Task LoadCountries()
    {
        if (string.IsNullOrEmpty(TenantCode)) 
        {
            errorMessage = "Unauthorized: Missing tenant code.";
            return;
        }
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}Country/get";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                countries = await response.Content.ReadFromJsonAsync<List<CountryModel>>() ?? new List<CountryModel>();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error loading countries ({response.StatusCode}): {errorBody}";
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Exception in LoadCountries: {ex.Message}");
        }
    }

    private async Task LoadStates()
    {
        if (string.IsNullOrEmpty(TenantCode)) 
        {
             errorMessage = "Unauthorized: Missing tenant code.";
             return;
        }
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}State/getall";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                states = await response.Content.ReadFromJsonAsync<List<StateModel>>() ?? new List<StateModel>();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error loading states ({response.StatusCode}): {errorBody}";
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Exception in LoadStates: {ex.Message}");
        }
    }

    private string? errorMessage;

    private async Task LoadCities()
    {
        try
        {
            errorMessage = null;
            using var client = CreateClient();
            var url = $"{BaseUrl}City/get";
            var result = await client.GetFromJsonAsync<List<CityModel>>(url);
            cities = result ?? new List<CityModel>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading cities: {ex.Message}";
            Console.Error.WriteLine(ex);
        }
    }

    private void NewCity()
    {
        current = new CityModel();
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private async Task EditCity(CityModel co)
    {
        if (co == null) return;
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}City/getbyid?citycode={co.citycode}";
            current = await client.GetFromJsonAsync<CityModel>(url) ?? new CityModel();
        }
        catch (Exception)
        {
            current = JsonConvert.DeserializeObject<CityModel>(JsonConvert.SerializeObject(co)) ?? new CityModel();
        }
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveCity()
    {
        isSubmitted = true;
        if (string.IsNullOrEmpty(TenantCode))
        {
            errorMessage = "Error: Tenant code is not loaded. Please refresh the page.";
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(current.cityname))
        {
            errorMessage = "Error: City Name is required.";
            StateHasChanged();
            return;
        }

        // Duplicate check
        if (cities.Any(co => co.cityname?.Trim().Equals(current.cityname?.Trim(), StringComparison.OrdinalIgnoreCase) == true && co.citycode != current.citycode))
        {
            errorMessage = $"Error: A city with the name '{current.cityname}' already exists.";
            StateHasChanged();
            return;
        }

        try
        {
            errorMessage = null;
            current.tenant_code = TenantCode;
            using var client = CreateClient();
            HttpResponseMessage response;
            if (isEditMode)
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}City/update", current);
            }
            else
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}City/insert", current);
            }

            if (response.IsSuccessStatusCode)
            {
                await LoadCities();
                errorMessage = isEditMode ? "City updated successfully." : "City added successfully.";
                NewCity();
                showForm = false;
                StateHasChanged();
            }
            else
            {
                errorMessage = $"Save failed ({response.StatusCode}): {await response.Content.ReadAsStringAsync()}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving city: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task SoftDeleteCity(int? citycode = null)
    {
        if (!citycode.HasValue && current != null)
        {
            citycode = current.citycode;
        }
        if (!citycode.HasValue || citycode.Value == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this city?"))
        {
            try
            {
                using var client = CreateClient();
                var url = $"{BaseUrl}City/softdelete?citycode={citycode.Value}";
                var response = await client.GetAsync(url);
                response.EnsureSuccessStatusCode();
                await LoadCities();
                
                if (current != null && current.citycode == citycode)
                {
                    showForm = false;
                }
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error deleting city: {ex.Message}");
            }
        }
    }

    private void CloseForm()
    {
        current = new CityModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }

    private async Task HideCityDropdown()
    {
        await Task.Delay(200);
        showCityDropdown = false;
        StateHasChanged();
    }

    private void SelectExistingCity(CityModel existingCity)
    {
        showCityDropdown = false;
        _ = EditCity(existingCity);
    }
}
