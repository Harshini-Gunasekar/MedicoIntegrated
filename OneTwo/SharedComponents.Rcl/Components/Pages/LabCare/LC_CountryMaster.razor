@page "/countrymaster"
@using Newtonsoft.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject ProtectedSessionStorage _sessionStorage
@inject TenantSessionState TenantState

<div class="referral-page">
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">public</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Country Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Global Directory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search countries..." @bind="SearchQuery" @bind:event="oninput" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 8px 16px 8px 36px; font-size: 13px; color: #1e293b; outline: none; width: 220px;" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewCountry">+ Add New</button>
            </div>
        </div>
    </div>

    @if (showForm)
    {
        <div class="modal-overlay">
            <div class="modal-form-card">
                <div class="modal-header-bar">
                    <h3>@(isEditMode ? "Edit Country" : "New Country Entry")</h3>
                    <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                        </svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-0 form-section">
                        <div class="mt-0">
                            <div class="um-grid-row">
                                <div class="form-group position-relative">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                        <label style="margin-bottom: 0;">Country Name</label>
                                        @if (isSubmitted && string.IsNullOrEmpty(current.countryname))
                                        {
                                            <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                        }
                                    </div>
                                    <input type="text" class="lab-input" @bind="current.countryname" @bind:event="oninput" @onfocus="() => showCountryDropdown = true" @onblur="HideCountryDropdown" placeholder="Search or Edit Country Name" required />
                                    @if (showCountryDropdown && !string.IsNullOrWhiteSpace(current.countryname) && !isEditMode)
                                    {
                                        var matchedCountries = countries
                                            .Where(c => c.countryname != null && c.countryname.Contains(current.countryname, StringComparison.OrdinalIgnoreCase))
                                            .ToList();
                                        if (matchedCountries.Any())
                                        {
                                            <div class="master-search-dropdown show">
                                                @foreach (var c in matchedCountries)
                                                {
                                                    <button type="button" class="master-search-item" @onmousedown="() => SelectExistingCountry(c)">
                                                        @c.countryname
                                                    </button>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="um-grid-cols-3">
                                <div class="form-group">
                                    <label>Order no</label>
                                    <input type="number" class="lab-input" @bind="current.orderno" placeholder="01" />
                                </div>
                                <div class="form-group">
                                    <label>Short Name</label>
                                    <input type="text" class="lab-input" @bind="current.shortname" />
                                </div>
                                <div class="form-group">
                                    <label>Narration</label>
                                    <input type="text" class="lab-input" @bind="current.description" placeholder="" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer-bar">
                    <button type="button" class="btn-delete" @onclick="() => SoftDeleteCountry(current.countrycode)" disabled="@(current.countrycode == 0)">
                        Delete
                    </button>
                    <button type="button" class="btn-save" @onclick="SaveCountry">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z" />
                        </svg>
                        Save Country
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="directory-section" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-top: -4px;">
        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th style="width: 64px;">ORDER NO</th>
                        <th>SHORT NAME</th>
                        <th>COUNTRY NAME</th>
                        <th>NARRATION</th>
                        <th>ENTERED DATE</th>
                        <th>MODIFIED DATE</th>
                        <th class="text-center" style="width: 128px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (countries != null && countries.Any())
                    {
                        @foreach (var co in FilteredCountriesBySearch)
                        {
                            <tr>
                                <td><span class="td-order-no">@($"{co.orderno:00}")</span></td>
                                <td style="color: #64748b; font-family: monospace;">@co.shortname</td>
                                <td><span class="td-name">@co.countryname</span></td>
                                <td><span class="td-narration">@co.description</span></td>
                                <td>@($"{co.entereddate:MM/dd/yyyy hh:mm tt}")</td>
                                <td>@($"{co.ibsdate:MM/dd/yyyy hh:mm tt}")</td>
                                <td class="text-center">
                                    <button type="button" class="btn-action btn-edit" @onclick="() => EditCountry(co)" title="Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg>
                                    </button>
                                    <button type="button" class="btn-action btn-delete-action" @onclick="() => SoftDeleteCountry(co.countrycode)" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="td-narration p-24 text-center">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<CountryModel> countries = new();
    private IEnumerable<CountryModel> FilteredCountries =>
        displayActiveOnly ? countries.Where(c => c.deleted != true) : countries;

    private IEnumerable<CountryModel> FilteredCountriesBySearch =>
        FilteredCountries.Where(c =>
            string.IsNullOrWhiteSpace(SearchQuery) ||
            (c.countryname != null && c.countryname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.shortname != null && c.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    private CountryModel current = new();
    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;
    private bool isEditMode = false;
    private bool displayActiveOnly = true;
    private bool showForm = false;
    private bool isSubmitted = false;
    private bool showCountryDropdown = false;
    private string SearchQuery = "";

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";
    private string? errorMessage;

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    TenantState.SetSession(TenantCode, AuthToken, TenantName);
                    await LoadCountries();
                    StateHasChanged();
                }
                else
                {
                    errorMessage = "Access denied: Please log in again.";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Session error: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        if (!string.IsNullOrEmpty(AuthToken))
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        return client;
    }

    private async Task LoadCountries()
    {
        if (string.IsNullOrEmpty(TenantCode)) { errorMessage = "Unauthorized access. Missing tenant context."; return; }
        try
        {
            errorMessage = null;
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}Country/get");
            if (response.IsSuccessStatusCode)
                countries = await response.Content.ReadFromJsonAsync<List<CountryModel>>() ?? new();
            else
                errorMessage = $"Error loading countries ({response.StatusCode}): {await response.Content.ReadAsStringAsync()}";
        }
        catch (Exception ex) { errorMessage = $"Error loading countries: {ex.Message}"; }
    }

    private void NewCountry() { current = new(); isEditMode = false; showForm = true; isSubmitted = false; }

    private async Task EditCountry(CountryModel co)
    {
        if (co == null) return;
        try
        {
            using var client = CreateClient();
            current = await client.GetFromJsonAsync<CountryModel>($"{BaseUrl}Country/getbyid?countrycode={co.countrycode}") ?? new();
        }
        catch { current = JsonConvert.DeserializeObject<CountryModel>(JsonConvert.SerializeObject(co)) ?? new(); }
        isEditMode = true; showForm = true; isSubmitted = false;
    }

    private async Task SaveCountry()
    {
        isSubmitted = true;
        if (string.IsNullOrEmpty(TenantCode)) { errorMessage = "Error: Tenant code is not loaded."; StateHasChanged(); return; }
        if (string.IsNullOrWhiteSpace(current.countryname)) { errorMessage = "Error: Country Name is required."; StateHasChanged(); return; }
        if (countries.Any(c => c.countryname?.Trim().Equals(current.countryname?.Trim(), StringComparison.OrdinalIgnoreCase) == true && c.countrycode != current.countrycode))
        { errorMessage = $"Error: A country with name '{current.countryname}' already exists."; StateHasChanged(); return; }
        try
        {
            errorMessage = null;
            current.tenant_code = TenantCode;
            using var client = CreateClient();
            var response = isEditMode
                ? await client.PostAsJsonAsync($"{BaseUrl}Country/update", current)
                : await client.PostAsJsonAsync($"{BaseUrl}Country/insert", current);
            if (response.IsSuccessStatusCode)
            { await LoadCountries(); errorMessage = isEditMode ? "Country updated successfully." : "Country added successfully."; NewCountry(); showForm = false; StateHasChanged(); }
            else
            { errorMessage = $"Save failed ({response.StatusCode}): {await response.Content.ReadAsStringAsync()}"; StateHasChanged(); }
        }
        catch (Exception ex) { errorMessage = $"Error saving: {ex.Message}"; StateHasChanged(); }
    }

    private async Task SoftDeleteCountry(int? countrycode = null)
    {
        if (!countrycode.HasValue && current != null) countrycode = current.countrycode;
        if (!countrycode.HasValue || countrycode.Value == 0) return;
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this country?"))
        {
            try
            {
                using var client = CreateClient();
                var response = await client.GetAsync($"{BaseUrl}Country/softdelete?countrycode={countrycode.Value}");
                response.EnsureSuccessStatusCode();
                await LoadCountries();
                if (current != null && current.countrycode == countrycode) showForm = false;
            }
            catch (Exception ex) { Console.Error.WriteLine($"Error deleting country: {ex.Message}"); }
        }
    }

    private void CloseForm() { current = new(); isEditMode = false; showForm = false; isSubmitted = false; }

    private async Task HideCountryDropdown()
    {
        await Task.Delay(200);
        showCountryDropdown = false;
        StateHasChanged();
    }

    private void SelectExistingCountry(CountryModel existingCountry)
    {
        showCountryDropdown = false;
        _ = EditCountry(existingCountry);
    }
}
