@using ReportingServer.Model
@using Microsoft.AspNetCore.Components

@if(statements != null)
{
    <table class="master-table">
        <thead>
            <!-- Page Header, Line and Title Row -->
            <tr>
                <td colspan="10">
                    <!-- ===== HEADER ===== -->
                    <table class="header-table">
                        <tr>
                            <td class="logo-cell">
                                @if (LogoImage != null && LogoImage.Length > 0)
                                {
                                    var base64 = Convert.ToBase64String(LogoImage);
                                    var src = base64.StartsWith("PHN2Zy") || base64.StartsWith("PD94bWw")
                                        ? $"data:image/svg+xml;base64,{base64}"
                                        : $"data:image/png;base64,{base64}";
                                    <img src="@src" class="logo-img" />
                                }
                            </td>
                            <td class="company-cell">
                                @if (!string.IsNullOrEmpty(BranchName))
                                {
                                    <div class="branch-name">@BranchName</div>
                                }
                                @if (!string.IsNullOrEmpty(CompanyName))
                                {
                                    <div class="company-name">@CompanyName</div>
                                }
                                @if (!string.IsNullOrEmpty(CompanyAddress))
                                {
                                    <div class="company-address">
                                        @{
                                            var addressLines = CompanyAddress.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                                            foreach (var line in addressLines)
                                            {
                                                <div>@line</div>
                                            }
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(CompanyContactNo))
                                {
                                    <div class="company-contact">Phone : @CompanyContactNo</div>
                                }
                                @if (!string.IsNullOrEmpty(CompanyEmail))
                                {
                                    <div class="company-contact">Email : @CompanyEmail</div>
                                }
                            </td>
                        </tr>
                    </table>

                    <!-- Separator Line -->
                    <hr class="header-line" />

                    <!-- ===== DOCUMENT TITLE ===== -->
                    <div class="statement-title-container">
                        <div class="statement-title">DATE WISE STATEMENTS <div class="title-date-time">[@fromdate.ToString("dd-MM-yyyy") - @todate.ToString("dd-MM-yyyy")]</div></div>
                    </div>
                </td>
            </tr>
        </thead>
        <tbody>
            <tr class="totals-row">
                <td colspan="5" style="border: none; padding: 0;">
                    <!-- ===== GRAND SUMMARY TOTALS (4 Squares in a Row) ===== -->
                    <table class="totals-cards-table">
                        <tr>
                            <td class="totals-card-cell">
                                <div class="card-label">Total Billed</div>
                                <div class="card-value">@((statements.Count()).ToString("N0"))</div>
                            </td>
                            <td class="totals-card-cell">
                                <div class="card-label">Total Billed Amount</div>
                                <div class="card-value">@TotalBilledAmount.ToString("N2")</div>
                            </td>
                            <td class="totals-card-cell">
                                <div class="card-label">Total Discount Amount</div>
                                <div class="card-value">@TotalDiscountAmount.ToString("N2")</div>
                            </td>
                            <td class="totals-card-cell">
                                <div class="card-label">Total Net Amount</div>
                                <div class="card-value">@TotalNetAmount.ToString("N2")</div>
                            </td>
                            <td class="totals-card-cell">
                                <div class="card-label">Total Paid Amount</div>
                                <div class="card-value">@TotalPaidAmount.ToString("N2")</div>
                            </td>
                            <td class="totals-card-cell">
                                <div class="card-label">Total Balance Amount</div>
                                <div class="card-value">@TotalBalanceAmount.ToString("N2")</div>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </tbody>
        <tbody>
            <tr>
                <td colspan="10" style="border: none; padding: 0;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr class="table-header-row">
                                <th class="col-id-date text-left">Sno</th>
                                <th class="col-id-date text-left">ID / Date</th>
                                <th class="col-patient text-left">Patient Info</th>
                                <th class="col-mob text-left">Mobile</th>
                                <th class="col-ref-mob text-left">Referral</th>
                                <th class="col-amount text-centre">Billed Amount</th>                                
                                <th class="col-amount text-centre">Discount</th>
                                <th class="col-amount text-centre">Net Amount</th>
                                <th class="col-amount text-centre">Paid</th>
                                <th class="col-amount text-centre">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var statement in statements)
                            {
								var index = statements.IndexOf(statement) + 1;
                                <tr class="statement-row">
                                    <td class="col-id-date">
                                        <div class="main-val bold">@index</div>
                                    </td>

                                    <td class="col-id-date">
                                        <div class="main-val bold">@statement.sampleid</div>
                                        <div class="sub-val">@statement.date.ToString("dd-MM-yyyy")</div>
                                    </td>
                            
                                    <!-- Col 2: Patient Info & Cust Code -->
                                    <td class="col-patient">
                                        <div class="main-val bold pname">@statement.patientname</div>
                                        <div class="sub-val">Code: @statement.custcode</div>
                                    </td>
                        
                                    <td class="col-mob">
                                        <div class="main-val-val">@(string.IsNullOrEmpty(statement.mobile) ? "-" : statement.mobile)</div>
                                    </td>
                            
                                    <!-- Col 3: Referral & Mobile -->
                                    <td class="col-ref-mob">
                                        <div class="main-val text-truncate">@(string.IsNullOrEmpty(statement.referral) ? "Self" : statement.referral)</div>
                                    </td>
                            
                                    <!-- Col 4: Net Amount -->
                                    <td class="col-amount text-centre">
                                        <div class="main-val">@statement.billedamount</div>
                                    </td>

                                    <td class="col-amount text-centre">
                                        <div class="main-val">@statement.discountamount</div>
                                    </td>
                                   <td class="col-amount text-centre">
                                        <div class="main-val">@statement.netamount</div>
                                   </td>
                            
                                    <!-- Col 5: Paid Amount -->
                                    <td class="col-amount text-centre">
                                        <div class="main-val">@statement.paidamount</div>
                                    </td>
                            
                                    <!-- Col 6: Balance Amount -->
                                    <td class="col-amount text-centre">
                                        <div class="main-val">@statement.balanceamount</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
}

<style>
    body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px;
        color: #000;
        margin: 0;
        padding: 0;
        background: #fff;
    }

    @@page {
        margin-top: 30px;
        margin-bottom: 30px;
        margin-left: 30px;
        margin-right: 30px;
    }

    /* ── MASTER TABLE (Multi-page header & alignment support) ── */
    .master-table {
        width: 100%;
        border-collapse: collapse;
        border: none;
    }

    .master-table > thead > tr > td {
        border: none;
        padding: 0;
    }

    thead {
        display: table-header-group;
    }

    /* Column headers styling */
    .table-header-row th {
        background-color: #f1f5f9;
        color: #0f172a;
        font-size: 10px;
        font-weight: bold;
        padding: 6px 10px;
        border: 1px solid #cbd5e1;
        box-sizing: border-box;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Data rows styling (joined boxes) */
    .statement-row td {
        padding: 8px 10px;
        vertical-align: middle;
        font-size: 11px;
        border: 1px solid #cbd5e1;
        box-sizing: border-box;
        background: #fff;
    }

    .statement-row {
        page-break-inside: avoid;
        break-inside: avoid;
    }

    /* Column widths */
    .col-id-date {
        width: 15%;
    }

    .col-patient {
        width: 32%;
    }

    .col-ref-mob {
        width: 23%;
    }

    .col-mob {
        width: 23%;
    }

    .col-amount {
        width: 10%;
    }

    .col-balance {
        width: 10%;
        background: #fff5f5 !important;
    }

    /* Typography & values */
    .main-val {
        color: #0f172a;
        font-size: 11px;
        margin-bottom: 1px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .main-val.bold {
        font-weight: bold;
    }

    .main-val.pname {
        color: #0055a5;
        text-transform: uppercase;
        font-weight: bold;
    }

    .sub-val {
        color: #64748b;
        font-size: 9.5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .text-truncate {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .text-left {
        text-align: left;
    }

    .text-right {
        text-align: centre;
    }

    .text-success {
        color: #16a34a !important;
        font-family: monospace;
        font-size: 11px;
        font-weight: bold;
    }

    .text-danger {
        color: #b91c1c !important;
        font-family: monospace;
        font-size: 11px;
    }

    /* ── HEADER ── */
    .header-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 2px;
    }

    .logo-cell {
        width: 45%;
        vertical-align: top;
        padding: 0;
    }

    .logo-img {
        height: 60px;
        max-width: 220px;
        display: block;
    }

    .company-cell {
        width: 55%;
        text-align: right;
        vertical-align: top;
        padding: 0;
    }

    .branch-name {
        font-size: 18px;
        font-weight: bold;
        color: #0055a5;
        margin-bottom: 2px;
        letter-spacing: 0.5px;
    }

    .company-name {
        font-size: 12px;
        font-weight: bold;
        color: #333;
        margin-bottom: 1px;
    }

    .company-address {
        font-size: 11px;
        color: #333;
        line-height: 1.4;
    }

    .company-contact {
        font-size: 11px;
        color: #000;
        margin-top: 1px;
    }

    /* ── SEPARATORS ── */
    .header-line {
        border: none;
        border-top: 2px solid #000;
        margin: 6px 0 8px 0;
        padding: 0;
    }

    /* ── TITLE BLOCK ── */
    .statement-title-container {
        text-align: center;
        margin-bottom: 12px; /* Consistent gap between title and column headers on all pages */
        width: 100%;
    }

    .statement-title {
        font-size: 15px;
        font-weight: bold;
        color: #000;
        letter-spacing: 0.5px;
        text-align: center;
        margin-bottom: 4px;
    }

    .totals-cards-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 4px 0;
        margin: 10px 0 15px 0;
        table-layout: fixed;
    }

    .totals-card-cell {
        width: 20%;
        background: #f8fafc;
        border: 1px solid #dbe3ee;
        border-radius: 8px;
        padding: 10px 6px;
        text-align: center;
        vertical-align: middle;
    }

    .totals-card-cell .card-label {
        font-size: 8px;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 600;
        margin-bottom: 4px;
        letter-spacing: 0.4px;
    }

    .totals-card-cell .card-value {
        font-size: 14px;
        font-weight: 700;
        color: #0f172a;
    }

    /* Color variations */
    .text-success {
        color: #16a34a !important;
    }
    
    .text-primary {
        color: #0284c7 !important;
    }

    .balance-card-cell {
        background: #fff5f5;
        border-color: #fecaca;
    }
    .title-date-time{
        font-size:11px;
    }

        .balance-card-cell .balance-label {
            color: #b91c1c;
        }

        .balance-card-cell .balance-value {
            font-size: 15px;
            font-weight: bold;
            color: #b91c1c;
        }

    .calc-label {
        width: 60%;
        text-align: left;
        padding-right: 15px;
        font-weight: bold;
        color: #555;
        vertical-align: middle;
    }

    .calc-value {
        width: 40%;
        text-align: right;
        color: #000;
        font-family: monospace;
        font-size: 12px;
        vertical-align: middle;
    }

    .bold-val {
        font-weight: bold;
    }

    .border-bottom-val {
        border-bottom: 1.2px solid #0056b3;
    }

    .balance-row-grand {
        @* border-top: 1.2px solid #0056b3; *@
    }

    .balance-label-grand {
        font-weight: bold;
        color: #0056b3;
        font-size: 12px;
        padding: 8px 15px 8px 0 !important;
    }

    .balance-value-grand {
        font-weight: bold;
        color: #0056b3;
        font-size: 12px;
        border-bottom: 1.2px solid #0056b3;
        padding: 8px 0 !important;
    }
</style>


@code{

    [Parameter]
    public IList<StatementsModel>? statements { get; set; }

    [Parameter]
    public byte[]? LogoImage { get; set; }
    [Parameter]
    public string? BranchName { get; set; }
    [Parameter]
    public string? CompanyName { get; set; }
    [Parameter]
    public string? CompanyAddress { get; set; }
    [Parameter]
    public string? CompanyContactNo { get; set; }
    [Parameter]
    public string? CompanyEmail { get; set; }
    [Parameter]
    public DateTime fromdate { get; set; }
    [Parameter]
    public DateTime todate { get; set; }

    private decimal ParseDecimal(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return 0;
        // Strip out any currency characters, spaces, or commas
        var cleaned = new string(val.Where(c => char.IsDigit(c) || c == '.' || c == '-').ToArray());
        return decimal.TryParse(cleaned, out decimal res) ? res : 0;
    }

    private string FormatCurrency(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return "0.00";
        var parsed = ParseDecimal(val);
        return parsed.ToString("N2");
    }

    private decimal TotalNetAmount => statements?.Sum(s => s.netamount) ?? 0;
    private decimal TotalPaidAmount => statements?.Sum(s => s.paidamount) ?? 0;
    private decimal TotalBalanceAmount => statements?.Sum(s => s.balanceamount) ?? 0;
	private decimal TotalDiscountAmount => statements?.Sum(s => s.discountamount) ?? 0;
    private decimal TotalBilledAmount => statements?.Sum(s => s.billedamount) ?? 0;
}