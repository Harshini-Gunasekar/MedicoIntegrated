@using ReportingServer.Model
@using System.Text
@using System.Globalization

@if (rrm != null)
{
    <table class="tb">
        <thead>
            <tr class="header-image-row">
                <td colspan="5" style="padding:0; border:none;">
                    @if (HeaderImage != null && HeaderImage.Length > 0 && !IsLetterhead)
                    {
                        <img src="data:image/png;base64,@Convert.ToBase64String(HeaderImage)"
                             style="width:100%; display:block;" />
                    }
                    else
                    {
                        <div style="height:120px; width:100%;"></div>
                    }
                </td>
            </tr>

            @* ── PATIENT INFO (single table, row-aligned with right side) ── *@
            <tr class="info-row">
                <td colspan="5" style="border:none; padding:0 20px;">
                    <table class="info-master">
                        <!-- Row 1: UHID -->
                        <tr>
                            <td class="lbl">UHID</td>
                            <td class="cln">:</td>
                            <td class="val" colspan="4">@rrm[0].HospitalID</td>
                            <td class="rt-col"></td>
                        </tr>
                        <!-- Row 2: Patient ID + Mobile | S ID -->
                        <tr>
                            <td class="lbl">Patient ID</td>
                            <td class="cln">:</td>
                            <td class="val">@rrm[0].CustCode</td>
                            <td class="lbl lbl2">Mobile No</td>
                            <td class="cln">:</td>
                            <td class="val">@rrm[0].MobileNo</td>
                            <td class="rt-col"><span class="sid-text">S ID: &nbsp;@rrm[0].RequestSnoPrint</span></td>
                        </tr>
                        <!-- Row 3: Name | Barcode -->
                        <tr>
                            <td class="lbl">Name</td>
                            <td class="cln">:</td>
                            <td class="val pname" colspan="4">@rrm[0].Name</td>
                            <td class="rt-col"><div class="bc-box">@((MarkupString)GenerateBarcodeSvg(rrm[0].RequestSnoPrint))</div></td>
                        </tr>
                        <!-- Row 4: Age + Sex | Drawn -->
                        <tr>
                            <td class="lbl">Age</td>
                            <td class="cln">:</td>
                            <td class="val">@rrm[0].DateofBirth</td>
                            <td class="lbl lbl2">Sex</td>
                            <td class="cln">:</td>
                            <td class="val">@rrm[0].Gender</td>
                            <td class="rt-col"><span class="dlbl">Drawn</span><span class="dcln">:</span><span class="dval">@rrm[0].CollectedDateTime?.ToString("dd-MM-yy  HH:mm")</span></td>
                        </tr>
                        <!-- Row 5: Doctor | Received -->
                        <tr>
                            <td class="lbl">Doctor</td>
                            <td class="cln">:</td>
                            <td class="val" colspan="4">@rrm[0].DoctorFullName</td>
                            <td class="rt-col"><span class="dlbl">Received</span><span class="dcln">:</span><span class="dval">@rrm[0].RequestedDateTime.ToString("dd-MM-yy  HH:mm")</span></td>
                        </tr>
                        <!-- Row 6: Ref.By | Reported -->
                        <tr>
                            <td class="lbl">Ref.By</td>
                            <td class="cln">:</td>
                            <td class="val" colspan="4">@rrm[0].SecondDoctorName</td>
                            <td class="rt-col"><span class="dlbl">Reported</span><span class="dcln">:</span><span class="dval">@rrm[0].ResultDateTime?.ToString("dd-MM-yy  HH:mm")</span></td>
                        </tr>
                    </table>
                </td>
            </tr>

            @* ── TITLE ── *@
            <tr>
                <td colspan="5" style="border:none; padding:8px 20px 4px 20px;">
                    <table style="width:100%; border-collapse:collapse; border:none;">
                        <tr>
                            <td style="text-align:center; border:none; font-size:13px; font-weight:700; letter-spacing:0.5px;">
                                LABORATORY INVESTIGATION REPORT
                            </td>
                            <td style="text-align:right; border:none; font-size:10px; white-space:nowrap; width:80px;">
                                Page <span class="pageNumber"></span> of <span class="totalPages"></span>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            @* ── COLUMN HEADERS ── *@
            <tr class="col-header">
                <th class="ch-sp">SPECIMEN</th>
                <th class="ch-inv">INVESTIGATION (METHOD)</th>
                <th class="ch-res">RESULT</th>
                <th class="ch-un">UNIT</th>
                <th class="ch-ref">REF. INTERVAL</th>
            </tr>
        </thead>

        @* ── DATA ROWS ── *@
        @foreach (var report in rrm.GroupBy(x => x.GroupName).Select(x => x.Key).ToList())
        {
            <tbody class="report-group">
                <tr>
                    <td colspan="5" class="group-name">@report</td>
                </tr>
                @if (rrm.Where(x => x.GroupName == report).ToList() != null)
                {
                    @foreach (var item in rrm.Where(x => x.GroupName == report).ToList())
                    {
                        @if (item.ResultValueType != null && item.ResultValueType.Trim() == "Title")
                        {
                            <tr><td class="row-title" colspan="5">@item.Description</td></tr>
                        }
                        else if (item.ResultValueType == "SubTitle")
                        {
                            <tr><td class="row-subtitle" colspan="5">@item.Description</td></tr>
                        }
                        else if (item.ResultType == "Result")
                        {
                            <tr class="data-row">
                                <td class="dc-sp">@item.ResultSample</td>
                                <td class="dc-inv">
                                    @item.Description
                                    @if (!string.IsNullOrWhiteSpace(item.ReportingMethod))
                                    {
                                        <br /><span class="meth">(@item.ReportingMethod)</span>
                                    }
                                </td>
                                <td class="dc-res @(item.ResultHigh ? "res-hi" : "") @(item.ResultLow ? "res-lo" : "")">
                                    @if (item.ResultHigh)
                                    {
                                        <span>@item.EnteredResult &nbsp;↑</span>
                                    }
                                    else if (item.ResultLow)
                                    {
                                        <span>@item.EnteredResult &nbsp;↓</span>
                                    }
                                    else
                                    {
                                        @item.EnteredResult
                                    }
                                </td>
                                @if (item.PrintResultOnly)
                                {
                                    <td class="dc-un"></td>
                                    <td class="dc-rf"></td>
                                }
                                else
                                {
                                    <td class="dc-un">@item.Units</td>
                                    <td class="dc-rf">@item.NormalValues</td>
                                }
                            </tr>
                        }
                        else if (item.ResultType == "Footer")
                        {
                            <tr class="row-footer"><td colspan="5">@item.Description</td></tr>
                        }
                    }
                }
            </tbody>
        }

        @* ── END OF REPORT ── *@
        <tbody>
            <tr>
                <td colspan="5" class="end-report-container">
                    <div class="validation-msg">All tests are issued after validation</div>
                    <div class="end-report-line">
                        <span class="line-segment"></span>
                        <span class="end-text">End of the Report</span>
                        <span class="line-segment"></span>
                    </div>
                </td>
            </tr>

            @* ── SIGNATURES ── *@
            <tr>
                <td colspan="5" class="sig-section">
                    <table class="sig-tbl">
                        <tr>
                            <td style="width:50%; border:none;"></td>
                            <td style="width:50%; border:none; text-align:right;">
                                <table style="margin-left:auto; width:auto; border-collapse:collapse; border:none;">
                                    <tr>
                                        <td class="sig-cell">
                                            @if (rrm[0].DefaultAuthorizeImage != null && rrm[0].DefaultAuthorizeImage.Length > 0)
                                            {
                                                <img src="data:image/png;base64,@Convert.ToBase64String(rrm[0].DefaultAuthorizeImage)" class="sig-img" />
                                            }
                                            <div class="sig-nm">@rrm[0].DefaultAuthorizeName</div>
                                            <div class="sig-dg">@rrm[0].DefaultAuthorizeDesignation</div>
                                        </td>
                                        @if (rrm[0].SignatureImage != null && rrm[0].SignatureImage.Length > 0)
                                        {
                                            <td class="sig-cell">
                                                <img src="data:image/png;base64,@Convert.ToBase64String(rrm[0].SignatureImage)" class="sig-img" />
                                                <div class="sig-nm">@rrm[0].DoctorFullName</div>
                                            </td>
                                        }
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
}
else
{
    <p>No routine reports available.</p>
}

@code {
    [Parameter] public IList<RoutineReportModel> rrm { get; set; }
    [Parameter] public byte[]? HeaderImage { get; set; }
    [Parameter] public bool IsLetterhead { get; set; } = false;

    private string GenerateBarcodeSvg(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) text = "123456";
        text = text.ToUpper();
        var alphabet = "*0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-. $/+%";
        var patterns = new[] {
            "1010011011010","1010011011010","1101001010110","1011001010110",
            "1101100101010","1010011010110","1101001101010","1011001101010",
            "1010010110110","1101001011010","1011001011010","1101010010110",
            "1011010010110","1101101001010","1010110010110","1101011001010",
            "1011011001010","1010100110110","1101010011010","1011010011010",
            "1010110011010","1101010100110","1011010100110","1101101010010",
            "1010110100110","1101011010010","1011011010010","1010101100110",
            "1101010110010","1011010110010","1010110110010","1100101010110",
            "1001101010110","1100110101010","1001011010110","1100101101010",
            "1001101101010","1001010110110","1100101011010","1001101011010",
            "1001001001010","1001001010010","1001010010010","1010010010010"
        };
        var fp = new StringBuilder();
        fp.Append(patterns[0]);
        foreach (var c in text)
        {
            int idx = alphabet.IndexOf(c);
            if (idx >= 0) fp.Append(patterns[idx]);
        }
        fp.Append(patterns[0]);
        var svg = new StringBuilder();
        svg.Append("<svg width='100%' height='100%' viewBox='0 0 320 40' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>");
        string pat = fp.ToString();
        float bw = 320f / pat.Length;
        for (int i = 0; i < pat.Length; i++)
        {
            if (pat[i] == '1')
                svg.Append($"<rect x='{(i * bw).ToString("F2", CultureInfo.InvariantCulture)}' y='0' width='{(bw + 0.1f).ToString("F2", CultureInfo.InvariantCulture)}' height='40' fill='black' />");
        }
        svg.Append("</svg>");
        return svg.ToString();
    }
}
<style>
    .tb { font-family:'Segoe UI',Verdana,Arial,sans-serif; font-size:10px; width:100%; border-collapse:collapse; color:#1a1a1a; }
    .header-image-row td { border:none!important; padding:0!important; }
    .header-image-row img { width:100%; height:auto; display:block; }
    .info-row td { border:none!important; }

    /* ── Master patient-info table (7 columns, row-aligned) ── */
    .info-master { width:100%; border-collapse:collapse; font-size:11px; line-height:1.55; }
    .info-master td { border:none!important; padding:1.5px 0; vertical-align:top; background:transparent!important; }
    .lbl  { width:62px; color:#333; font-size:11px; white-space:nowrap; }
    .lbl2 { padding-left:18px!important; width:auto; white-space:nowrap; }
    .cln  { width:10px; text-align:center; color:#333; }
    .val  { color:#1a1a1a; font-size:11px; }
    .pname { font-weight:700; font-size:13px; color:#000; }

    /* Right column */
    .rt-col { text-align:right; white-space:nowrap; width:220px; vertical-align:middle; }
    .sid-text { font-size:11px; font-weight:600; color:#000; }
    .bc-box { display:inline-block; width:160px; height:32px; }

    /* Date spans inside rt-col */
    .dlbl { font-size:10px; color:#333; display:inline-block; width:58px; text-align:right; }
    .dcln { font-size:10px; color:#333; display:inline-block; width:12px; text-align:center; }
    .dval { font-size:10px; font-weight:500; color:#1a1a1a; display:inline-block; text-align:right; }

    /* ── Column headers ── */
    .col-header th { padding:6px 8px; text-align:left; font-weight:700; font-size:10px; text-transform:uppercase; background:#fff; border:1px solid #000; border-top:2px solid #000; border-bottom:2px solid #000; }
    .ch-sp  { width:100px; }
    .ch-inv { width:auto; }
    .ch-res { width:110px; }
    .ch-un  { width:70px; }
    .ch-ref { width:110px; }

    /* ── Group name ── */
    .group-name { font-size:11px; font-weight:700; text-transform:uppercase; padding:8px 6px 3px 6px!important; border:none!important; }

    /* ── Data rows (bordered grid matching image) ── */
    .data-row td { padding:4px 6px; vertical-align:top; border:1px solid #aaa; font-size:10px; }
    .dc-sp  { font-size:10px; color:#333; }
    .dc-inv { font-size:10px; }
    .meth   { font-size:9px; color:#555; }
    .dc-res { font-size:10px; font-weight:700; }
    .dc-un  { font-size:10px; }
    .dc-rf  { font-size:10px; }
    .res-hi { color:#000; font-weight:700; }
    .res-lo { color:#000; font-weight:700; }

    /* ── Title / Subtitle / Footer rows ── */
    .row-title    { font-size:10px; font-weight:600; padding:4px 6px!important; border:none!important; }
    .row-subtitle { font-size:9.5px; font-weight:500; padding:3px 6px 3px 14px!important; border:none!important; }
    .row-footer td { font-size:9px; font-style:italic; color:#333; padding:4px 6px!important; border:none!important; text-decoration:underline; }

    /* ── End of report ── */
    .end-report-container { border:none!important; padding:15px 6px 10px 6px!important; }
    .validation-msg { font-size:10px; color:#000; text-align:left; margin-bottom:4px; padding-left:2px; }
    .end-report-line { display:flex; align-items:center; width:100%; }
    .line-segment { flex-grow:1; height:1px; background-color:#888; }
    .end-text { padding:0 15px; font-weight:bold; font-size:10px; color:#000; white-space:nowrap; }

    /* ── Print rules ── */
    .report-group { page-break-inside:avoid; break-inside:avoid; }
    thead { display:table-header-group; }

    /* ── Signatures ── */
    .sig-section { border:none!important; padding:20px 6px 10px 6px!important; }
    .sig-tbl { width:100%; border-collapse:collapse; }
    .sig-tbl td { border:none; }
    .sig-cell { text-align:center; vertical-align:bottom; padding:0 15px; border:none; }
    .sig-img { max-height:45px; max-width:140px; display:block; margin:0 auto 4px auto; }
    .sig-nm { font-size:10px; font-weight:700; }
    .sig-dg { font-size:9px; color:#444; }
</style>