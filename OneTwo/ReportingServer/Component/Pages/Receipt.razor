@using ReportingServer.Model
@using Microsoft.AspNetCore.Components

@if (ReceiptData != null)
{
        <table class="header-table">
            <tr>
                <td class="logo-cell">
                    @if (LogoImage != null && LogoImage.Length > 0)
                    {
                        var base64 = Convert.ToBase64String(LogoImage);
                        var src = base64.StartsWith("PHN2Zy") || base64.StartsWith("PD94bWw")
                            ? $"data:image/svg+xml;base64,{base64}"
                            : $"data:image/png;base64,{base64}";
                        <img src="@src" class="logo-img" />
                    }
                </td>
                <td class="company-cell">
                    @if (!string.IsNullOrEmpty(ReceiptData.BranchName))
                    {
                        <div class="branch-name">@ReceiptData.BranchName</div>
                    }
                    @if (!string.IsNullOrEmpty(ReceiptData.CompanyName))
                    {
                        <div class="company-name">@ReceiptData.CompanyName</div>
                    }
                    @if (!string.IsNullOrEmpty(ReceiptData.CompanyAddress))
                    {
                        <div class="company-address">
                            @{
                                var addressLines = ReceiptData.CompanyAddress.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                                foreach (var line in addressLines)
                                {
                                    <div>@line</div>
                                }
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(ReceiptData.CompanyContactNo))
                    {
                        <div class="company-contact">Phone : @ReceiptData.CompanyContactNo</div>
                    }
                    @if (!string.IsNullOrEmpty(ReceiptData.CompanyEmail))
                    {
                        <div class="company-contact">Email : @ReceiptData.CompanyEmail</div>
                    }
                </td>
            </tr>
        </table>

        <!-- Separator -->
        <hr class="header-line" />

        <!-- ===== TITLE BLOCK ===== -->
        <div class="receipt-title-container">
            <div class="receipt-title-only">PAYMENT VOUCHER</div>
        </div>

        <!-- ===== INFO & META SIDE-BY-SIDE ===== -->
        <table class="info-meta-container-table">
            <tr>
                <td class="info-container-left">
                    <table class="info-table">
                        <tr>
                            <td class="info-label">Dcode</td>
                            <td class="info-colon">:</td>
                            <td class="info-value">@ReceiptData.dcode</td>
                        </tr>
                        <tr>
                            <td class="info-label-ref">Referral Name</td>
                            <td class="info-colon">:</td>
                            <td class="info-value-ref">@ReceiptData.ReferralName</td>
                        </tr>
                        @if (!string.IsNullOrEmpty(ReceiptData.MobileNo))
                        {
                            <tr>
                                <td class="info-label">Mobile No</td>
                                <td class="info-colon">:</td>
                                <td class="info-value">@ReceiptData.MobileNo</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(ReceiptData.Address))
                        {
                            <tr>
                                <td class="info-label">Address</td>
                                <td class="info-colon">:</td>
                                <td class="info-value">@ReceiptData.Address</td>
                            </tr>
                        }
                        @if (ReceiptData.Totalbills.HasValue)
                        {
                            <tr>
                                <td class="info-label">Paid Bills</td>
                                <td class="info-colon">:</td>
                                <td class="info-value bold">@ReceiptData.Totalbills</td>
                            </tr>
                        }
                    </table>
                </td>
                <td class="info-container-right">
                    <table class="date-table">
                        <tr>
                            <td class="date-label">Receipt No</td>
                            <td class="date-colon">:</td>
                            <td class="date-value">@ReceiptData.ReceiptNo</td>
                        </tr>
                        <tr>
                            <td class="date-label">Receipt Date</td>
                            <td class="date-colon">:</td>
                            <td class="date-value">@ReceiptData.ReceiptDate.ToString("dd-MM-yyyy h.mm.ss tt")</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>


    <!-- TOTALS & AMOUNT IN WORDS SIDE-BY-SIDE -->
    <table class="totals-container-table">
        <tr>
            <!-- Left side: Amount in Words in a premium grey contrast box -->
            <td class="totals-left-col">
                <div class="amt-words-box">
                    <span class="amt-words-title">Total Amount in words:</span>
                    <div class="amt-words-content">@AmountToWords(ReceiptData.TotalAmount)</div>
                </div>
            </td>
            
            <!-- Right side: Financial Summary -->
            <td class="totals-right-col">
                <table class="totals-calc-table">
                    <tr>
                        <td class="calc-label">Total Amount</td>
                        <td class="calc-value bold-val">@ReceiptData.TotalAmount.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="calc-label">Paid Amount</td>
                        <td class="calc-value border-bottom-val">@ReceiptData.PaidAmount.ToString("N2")</td>
                    </tr>
                    <tr class="balance-row">
                        <td class="calc-label balance-label">Balance Amount</td>
                        <td class="calc-value balance-value">@ReceiptData.BalanceAmount.ToString("N2")</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
}

<style>

    body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px;
        color: #000;
        margin: 30px;
        padding: 0;
        background: #fff;
    }

    .receipt-page {
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
        padding: 15px 20px;
        box-sizing: border-box;
        position: relative;
        min-height: 700px;
    }

    /* ── HEADER ── */
    .header-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 2px;
    }

    .logo-cell {
        width: 45%;
        vertical-align: top;
        padding: 0;
    }

    .logo-img {
        height: 60px;
        max-width: 220px;
        display: block;
    }

    .company-cell {
        width: 55%;
        text-align: right;
        vertical-align: top;
        padding: 0;
    }

    .branch-name {
        font-size: 18px;
        font-weight: bold;
        color: #0055a5;
        margin-bottom: 2px;
        letter-spacing: 0.5px;
    }

    .company-name {
        font-size: 12px;
        font-weight: bold;
        color: #333;
        margin-bottom: 1px;
    }

    .company-address {
        font-size: 11px;
        color: #333;
        line-height: 1.4;
    }

    .company-contact {
        font-size: 11px;
        color: #000;
        margin-top: 1px;
    }

    /* ── SEPARATORS ── */
    .header-line {
        border: none;
        border-top: 2px solid #000;
        margin: 6px 0 8px 0;
        padding: 0;
    }

    .section-line {
        border: none;
        border-top: 1.5px solid #0055a5;
        margin: 10px 0 6px 0;
        padding: 0;
    }

    /* ── TITLE BLOCK ── */
    .receipt-title-container {
        text-align: center;
        margin-bottom: 8px;
        width: 100%;
    }

    .receipt-title-only {
        font-size: 15px;
        font-weight: bold;
        color: #000;
        letter-spacing: 0.5px;
        text-align: center;
        margin-bottom: 4px;
    }



    .date-table {
        border-collapse: collapse;
        font-size: 11px;
        line-height: 1.5;
        float: right;
    }

    .date-table td {
        padding: 2px 0;
        vertical-align: top;
    }

    .date-label {
        padding-right: 5px;
        color: #333;
        font-weight: normal;
        text-align: left;
        font-weight: bold;
    }

    .date-colon {
        padding: 0 8px;
        color: #333;
        font-weight: normal;
    }

    .date-value {
        font-weight: normal;
        color: #000;
        text-align: left;
        white-space: nowrap;
    }

    /* ── DOTTED-LINE TABLE (Amount / In word / For) ── */
    .dotted-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        margin-top: 16px;
        border-top: 1.2px solid #ddd;
    }

    .dotted-table tr:first-child td {
        padding-top: 10px;
    }

    .dot-label {
        width: 80px;
        font-weight: bold;
        color: #000;
        padding: 6px 0;
        vertical-align: bottom;
    }

    .dot-value {
        padding: 6px 4px;
        color: #000;
        vertical-align: bottom;
    }

    .dot-fill {
        border-bottom: 1.5px dotted #999;
        vertical-align: bottom;
    }

    /* ── TOTALS CONTAINER SIDE-BY-SIDE ── */
    .totals-container-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

    .totals-left-col {
        width: 50%;
        vertical-align: top;
        text-align: left;
        padding: 0;
    }

    .totals-right-col {
        width: 50%;
        vertical-align: top;
        padding: 0;
    }

    /* Left side: Premium Grey Amount in Words Box */
    .amt-words-box {
        background: #f4f6f9;
        border: 1px solid #e1e8f0;
        padding: 10px 12px;
        border-radius: 4px;
        font-family: Arial, sans-serif;
        font-size: 11px;
        color: #333;
        margin-top: 4px;
        margin-right: 20px;
    }

    .amt-words-title {
        font-weight: bold;
        color: #000;
        display: block;
        margin-bottom: 4px;
    }

    .amt-words-content {
        line-height: 1.4;
        color: #000;
    }

    /* Right side: Calculations list */
    .totals-calc-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

    .calc-label {
        width: 60%;
        text-align: right;
        padding: 4px 15px 4px 0;
        font-weight: bold;
        color: #555;
        vertical-align: middle;
    }

    .calc-value {
        width: 40%;
        text-align: right;
        padding: 4px 0;
        color: #000;
        vertical-align: middle;
    }

    .bold-val {
        font-weight: bold;
    }

    .border-bottom-val {
        border-bottom: 1.2px solid #0056b3;
    }

    .balance-label {
        font-weight: bold;
        color: #0056b3;
        font-size: 12px;
        padding: 8px 15px 8px 0;
    }

    .balance-value {
        font-weight: bold;
        color: #0056b3;
        font-size: 12px;
        border-top: 2px solid #0056b3;
        border-bottom: 2px solid #0056b3;
        padding: 8px 0;
    }

    /* ── INFO & META SIDE-BY-SIDE CONTAINER ── */
    .info-meta-container-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    .info-container-left {
        width: 60%;
        vertical-align: top;
        padding: 0;
    }

    .info-container-right {
        width: 40%;
        vertical-align: top;
        padding: 0;
        text-align: right;
    }

    /* ── INFO TABLE (Receipt details) ── */
    .info-table {
        width: 100%;
        font-size: 11px;
        line-height: 1.5;
        margin-top: 0;
    }

    .info-label {
        width: 100px;
        padding: 2px 0;
        color: #555;
        font-weight: normal;
        vertical-align: top;
    }

    .info-colon {
        width: 15px;
        padding: 2px 0;
        color: #555;
        font-weight: normal;
        vertical-align: top;
    }

    .info-value {
        color: #000;
        padding: 2px 0;
        vertical-align: top;
    }

    .info-label-ref {
        width: 100px;
        padding: 2px 0;
        color: #555;
        font-weight: bold;
        vertical-align: top;
    }
     .info-value-ref {
        color: #000;
        padding: 2px 0;
        vertical-align: top;
        font-weight: bold;
    }

    .bold {
        font-weight: bold;
    }

    .upper {
        text-transform: uppercase;
    }

    /* ── SIGNATURE ── */
    .signature-block {
        margin-top: 60px;
        text-align: right;
        padding-right: 10px;
    }

    .for-branch {
        font-size: 12px;
        font-weight: bold;
        color: #000;
        margin-bottom: 40px;
    }

    .signature-line {
        font-size: 11px;
        color: #555;
        font-style: italic;
    }

    /* ── FOOTER ── */
    .page-footer {
        margin-top: 40px;
        text-align: center;
    }

    .footer-line {
        border: none;
        border-top: 1px solid #ccc;
        margin: 0 0 5px 0;
    }

    .footer-text {
        font-size: 10px;
        color: #999;
    }

</style>

@code {

    [Parameter]
    public ReceiptPdfModel? ReceiptData { get; set; }

    [Parameter]
    public byte[]? LogoImage { get; set; }

    private string AmountToWords(decimal amount)
    {
        if (amount == 0) return "Zero";

        var ones = new[] { "", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine",
            "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen" };
        var tens = new[] { "", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety" };

        int num = (int)Math.Floor(amount);
        string words = "";

        if (num / 10000000 > 0) { words += ConvertGroup(num / 10000000, ones, tens) + " Crore "; num %= 10000000; }
        if (num / 100000 > 0) { words += ConvertGroup(num / 100000, ones, tens) + " Lakh "; num %= 100000; }
        if (num / 1000 > 0) { words += ConvertGroup(num / 1000, ones, tens) + " Thousand "; num %= 1000; }
        if (num / 100 > 0) { words += ones[num / 100] + " Hundred "; num %= 100; }
        if (num > 0)
        {
            if (words != "") words += "and ";
            if (num < 20) words += ones[num];
            else words += tens[num / 10] + (num % 10 > 0 ? " " + ones[num % 10] : "");
        }

        return words.Trim() + " Rupees Only";
    }

    private string ConvertGroup(int num, string[] ones, string[] tens)
    {
        string result = "";
        if (num / 100 > 0) { result += ones[num / 100] + " Hundred "; num %= 100; }
        if (num > 0)
        {
            if (result != "") result += "and ";
            if (num < 20) result += ones[num];
            else result += tens[num / 10] + (num % 10 > 0 ? " " + ones[num % 10] : "");
        }
        return result.Trim();
    }
}