@using Microsoft.AspNetCore.Components
@using ReportingServer.Model
@using System.Text
@using System.Globalization

<div style="width: 100%; font-family: Arial, Helvetica, sans-serif; box-sizing: border-box; background: white; padding: 0 10px;">
    <!-- TOP HEADER: Logo & Company Info -->
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 2px;">
        <tr>
            <td style="width: 45%; vertical-align: top; padding: 0;">
                @if (bills.logo != null && bills.logo.Length > 0)
                {
                    var base64 = Convert.ToBase64String(bills.logo);
                    var src = base64.StartsWith("PHN2Zy") || base64.StartsWith("PD94bWw") ? $"data:image/svg+xml;base64,{base64}" : $"data:image/png;base64,{base64}";
                    <img src="@src" style="height: 60px; max-width: 220px; display: block;" />
                }
            </td>
            <td style="width: 55%; text-align: right; vertical-align: top; padding: 0;">
                @if (!string.IsNullOrEmpty(bills.LabName))
                {
                    <div style="font-size: 18px; font-weight: bold; color: #0055a5; margin-bottom: 2px; letter-spacing: 0.5px;">@bills.LabName</div>
                }
                @if (!string.IsNullOrEmpty(bills.Address))
                {
                    <div style="font-size: 11px; color: #333; line-height: 1.4;">
                        @{
                            var addressLines = bills.Address.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                            foreach (var line in addressLines)
                            {
                                <div>@line</div>
                            }
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(bills.MobileNo))
                {
                    <div style="font-size: 11px; color: #000; margin-top: 1px;">Phone : @bills.MobileNo</div>
                }
                @if (!string.IsNullOrEmpty(bills.Email))
                {
                    <div style="font-size: 11px; color: #000; margin-top: 1px;">Email : @bills.Email</div>
                }
            </td>
        </tr>
    </table>

    <!-- Thick Separator Line -->
    <hr style="border: none; border-top: 2px solid #000; margin: 6px 0 8px 0; padding: 0;" />

    <!-- TITLE BLOCK -->
    <div style="width: 100%; text-align: center; font-size: 14px; font-weight: bold; color: #000; letter-spacing: 0.5px; margin: 8px 0 10px 0; text-transform: uppercase;">
        CASH BILL
    </div>

    <!-- 3 COLUMN PATIENT INFO TABLE -->
    <table class="patient-table">
        <tr>
            <!-- Column 1: Left patient info (42%) -->
            <td style="width: 42%; vertical-align: top;">
                <table style="width: 100%; border-collapse: collapse;">
                    <tr>
                        <td class="label">SID</td>
                        <td class="colon">:</td>
                        <td class="value-normal">@bills.BillNo</td>
                    </tr>
                    <tr>
                        <td class="label" style="font-weight: bold; color: #000;">Name</td>
                        <td class="colon" style="font-weight: bold; color: #000;">:</td>
                        <td class="bold-val" style="text-transform: uppercase;">@bills.PatientName</td>
                    </tr>
                    @if (!string.IsNullOrEmpty(bills.CareOf))
                    {
                        <tr>
                            <td class="label">Care Of</td>
                            <td class="colon">:</td>
                            <td class="value-normal">@bills.CareOf</td>
                        </tr>
                    }
                    <tr>
                        <td class="label">Age</td>
                        <td class="colon">:</td>
                        <td class="value-normal">@bills.Age</td>
                    </tr>
                    <tr>
                        <td class="label" style="font-weight: bold; color: #000;">Ref. By</td>
                        <td class="colon" style="font-weight: bold; color: #000;">:</td>
                        <td class="bold-val" style="text-transform: uppercase;">@(string.IsNullOrEmpty(bills.DoctorName) ? "SELF" : bills.DoctorName)</td>
                    </tr>
                    @if (!string.IsNullOrEmpty(bills.PatientAddress))
                    {
                        <tr>
                            <td class="label" style="vertical-align: top;">Address</td>
                            <td class="colon" style="vertical-align: top;">:</td>
                            <td class="value-normal" style="word-break: break-word; vertical-align: top; font-weight: normal;">@bills.PatientAddress</td>
                        </tr>
                    }
                    @if(!string.IsNullOrEmpty(bills.CusMobileNo))
                    {
                        <tr>
                            <td class="label" style="vertical-align: top;">Mobile No</td>
                            <td class="colon" style="vertical-align: top;">:</td>
                            <td class="value-normal" style="word-break: break-word; vertical-align: top; font-weight: normal;">@bills.CusMobileNo</td>
                        </tr>
                    }
                </table>
            </td>
            
            <!-- Column 2: Middle patient info (26%) -->
            <td style="width: 26%; vertical-align: top; padding-left: 10px;">
                <table style="width: 100%; border-collapse: collapse;">
                    <tr>
                        <td class="label" style="font-weight: bold; color: #000;">Pat. ID</td>
                        <td class="colon">:</td>
                        <td class="value-normal" style="font-weight: bold; color: #000;">@bills.PatientId</td>
                    </tr>
                    <tr>
                        <td class="label" style="width: 50px;">Gender</td>
                        <td class="colon">:</td>
                        <td class="value-normal" style="text-transform: uppercase;">@bills.Gender</td>
                    </tr>
                </table>
            </td>
            
            <!-- Column 3: Right barcode and dates (32%) -->
            <td style="width: 32%; vertical-align: top; text-align: right;">
                <div class="barcode-container">
                    @((MarkupString)GenerateBarcodeSvg(bills.RequestSnoPrint))
                </div>
                <table class="date-table">
                    <tr>
                        <td class="date-label" style="font-weight: bold; color: #000;">Bill Date</td>
                        <td class="date-colon">:</td>
                        <td class="date-val" style="font-weight: bold; color: #000;">@bills.BillDate.ToString("dd-MM-yyyy hh:mm tt")</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!-- Separator Line Before Table -->
    <hr style="border: none; border-top: 1.5px solid #000; margin: 8px 0 0 0; padding: 0;" />
</div>

<style>
    .patient-table {
        width: 100%;
        border-collapse: collapse;
        font-family: Arial, Helvetica, sans-serif;
    }

    .patient-table td {
        padding: 0;
    }

    .patient-table .label {
        font-size: 11px;
        color: #4a5568;
        width: 65px;
        padding: 2.5px 0;
    }

    .patient-table .colon {
        font-size: 11px;
        color: #4a5568;
        width: 12px;
        text-align: center;
        padding: 2.5px 0;
    }

    .patient-table .value-normal {
        font-size: 11px;
        color: #1a202c;
        font-weight: normal;
        padding: 2.5px 0;
    }

    .patient-table .bold-val {
        font-size: 11.5px;
        color: #000;
        font-weight: bold;
        padding: 2.5px 0;
    }

    .barcode-container {
        display: inline-block;
        width: 195px;
        height: 28px;
        margin-bottom: 5px;
    }

    .date-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 10px;
        margin-top: 2px;
    }

    .date-table td {
        padding: 1.5px 0;
    }

    .date-label {
        color: #718096;
        text-align: right;
        width: 80px;
    }

    .date-colon {
        color: #718096;
        text-align: center;
        width: 12px;
    }

    .date-val {
        color: #2d3748;
        text-align: left;
        white-space: nowrap;
        font-weight: 500;
    }
</style>

@code {
    [Parameter]
    public CashBillModel bills { get; set; }

    private string GetShortBarcodeText(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        
        // Case 1: Slash separated date at the end, e.g., /28/05/2026
        var parts = text.Split('/');
        if (parts.Length >= 4)
        {
            string last = parts[parts.Length - 1].Trim();
            string mid = parts[parts.Length - 2].Trim();
            string prev = parts[parts.Length - 3].Trim();
            
            bool isYear = last.Length == 4 && int.TryParse(last, out _);
            bool isMonth = (mid.Length == 2 || mid.Length == 1) && int.TryParse(mid, out _);
            bool isDay = (prev.Length == 2 || prev.Length == 1) && int.TryParse(prev, out _);
            
            if (isYear && isMonth && isDay)
            {
                return string.Join("/", parts.Take(parts.Length - 3));
            }
        }
        
        // Case 2: Hyphen or dot separated date in the last segment, e.g., /28-05-2026 or /28.05.2026
        if (parts.Length >= 2)
        {
            string lastSegment = parts[parts.Length - 1].Trim();
            var dateParts = lastSegment.Split(new[] { '-', '.' });
            if (dateParts.Length == 3)
            {
                string yearPart = dateParts[2].Trim();
                string monthPart = dateParts[1].Trim();
                string dayPart = dateParts[0].Trim();
                
                bool isYear = yearPart.Length == 4 && int.TryParse(yearPart, out _);
                bool isMonth = (monthPart.Length == 2 || monthPart.Length == 1) && int.TryParse(monthPart, out _);
                bool isDay = (dayPart.Length == 2 || dayPart.Length == 1) && int.TryParse(dayPart, out _);
                
                if (isYear && isMonth && isDay)
                {
                    return string.Join("/", parts.Take(parts.Length - 1));
                }
            }
        }
        
        return text;
    }

    private string GenerateBarcodeSvg(string text)
    {
        // Fallback to BillNo if RequestSnoPrint is null or empty to minimize barcode lines and ensure high efficiency.
        if (string.IsNullOrWhiteSpace(text)) text = bills.BillNo;
        if (string.IsNullOrWhiteSpace(text)) text = "123456";
        
        // Strip out the date suffix (if present) to keep the barcode lines minimum and scannable
        text = GetShortBarcodeText(text);
        
        text = text.ToUpper();
        
        var alphabet = "*0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-. $/+%";
        var cleanText = new StringBuilder();
        foreach (var c in text)
        {
            if (alphabet.Contains(c))
            {
                cleanText.Append(c);
            }
        }
        text = cleanText.ToString();

        var patterns = new[] {
            "1010011011010", // *
            "1010011011010", // 0
            "1101001010110", // 1
            "1011001010110", // 2
            "1101100101010", // 3
            "1010011010110", // 4
            "1101001101010", // 5
            "1011001101010", // 6
            "1010010110110", // 7
            "1101001011010", // 8
            "1011001011010", // 9
            "1101010010110", // A
            "1011010010110", // B
            "1101101001010", // C
            "1010110010110", // D
            "1101011001010", // E
            "1011011001010", // F
            "1010100110110", // G
            "1101010011010", // H
            "1011010011010", // I
            "1010110011010", // J
            "1101010100110", // K
            "1011010100110", // L
            "1101101010010", // M
            "1010110100110", // N
            "1101011010010", // O
            "1011011010010", // P
            "1010101100110", // Q
            "1101010110010", // R
            "1011010110010", // S
            "1010110110010", // T
            "1100101010110", // U
            "1001101010110", // V
            "1100110101010", // W
            "1001011010110", // X
            "1100101101010", // Y
            "1001101101010", // Z
            "1001010110110", // -
            "1100101011010", // .
            "1001101011010", // Space
            "1001001001010", // $
            "1001001010010", // /
            "1001010010010", // +
            "1010010010010"  // %
        };

        var fullPattern = new StringBuilder();
        
        // Start character '*'
        fullPattern.Append(patterns[0]);
        
        foreach (var c in text)
        {
            int idx = alphabet.IndexOf(c);
            if (idx >= 0)
            {
                fullPattern.Append(patterns[idx]);
            }
        }
        
        // Stop character '*'
        fullPattern.Append(patterns[0]);

        var svg = new StringBuilder();
        svg.Append("<svg width='100%' height='100%' viewBox='0 0 320 40' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>");
        
        string pat = fullPattern.ToString();
        float barWidth = 320f / pat.Length;
        
        for (int i = 0; i < pat.Length; i++)
        {
            if (pat[i] == '1')
            {
                svg.Append($"<rect x='{(i * barWidth).ToString("F2", CultureInfo.InvariantCulture)}' y='0' width='{(barWidth + 0.1f).ToString("F2", CultureInfo.InvariantCulture)}' height='40' fill='black' />");
            }
        }
        svg.Append("</svg>");
        return svg.ToString();
    }
}