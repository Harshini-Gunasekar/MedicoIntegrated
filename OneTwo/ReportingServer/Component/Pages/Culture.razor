@using ReportingServer.Model
@using Microsoft.AspNetCore.Components
@using System.Text
@using System.Globalization

@if (dto != null)
{
    @if (Section == "Header")
    {
        <style>
            .header-container {
                width: 100%;
                font-family: 'Segoe UI', Arial, sans-serif;
                color: #1a202c;
                background: #ffffff;
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            .branding-block {
                width: 100%;
                margin-bottom: 8px;
            }
            .branding-block img {
                width: 100%;
                height: auto;
                display: block;
            }
            .patient-info-container {
                padding: 0 20px;
                box-sizing: border-box;
                width: 100%;
            }
            .patient-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 11px;
                line-height: 1.45;
            }
            .patient-table td {
                vertical-align: top;
                padding: 2px 0;
            }
            .label {
                width: 55px;
                color: #4a5568;
            }
            .colon {
                width: 12px;
                text-align: center;
                color: #4a5568;
            }
            .value {
                font-weight: 500;
                color: #1a202c;
            }
            .bold-val {
                font-weight: 700;
                font-size: 11.5px;
                color: #000000;
            }
            .barcode-container {
                display: inline-block;
                width: 150px;
                height: 30px;
                margin-bottom: 6px;
            }
            .date-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 10px;
            }
            .date-table td {
                padding: 1px 0;
                vertical-align: middle;
            }
            .date-label {
                text-align: left;
                color: #4a5568;
            }
            .date-colon {
                width: 10px;
                text-align: center;
                color: #4a5568;
            }
            .date-val {
                text-align: left;
                font-weight: 500;
                white-space: nowrap;
            }
            .divider {
                border: none;
                border-top: 1.5px solid #1a202c;
                margin: 6px 0 0 0;
            }
        </style>
        <div class="header-container">
            <!-- Dynamic Header Image / Branding Block (Full Width) -->
            <div class="branding-block">
                @if (dto.headerimage != null && dto.headerimage.Length > 0 && !dto.isletterhead)
                {
                    var base64Header = Convert.ToBase64String(dto.headerimage);
                    <img src="data:image/png;base64,@base64Header" style="width:100%; display:block;" />
                }
                else
                {
                    <div style="height: 120px; width: 100%;"></div>
                }
            </div>

            <!-- Padded Patient Info Section -->
            <div class="patient-info-container">
                <table class="patient-table">
                    <tr>
                        <!-- Column 1: Left patient info (38%) -->
                        <td style="width: 38%; vertical-align: top;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <td class="label">SID</td>
                                    <td class="colon">:</td>
                                    <td class="value">@dto.SID</td>
                                </tr>
                                <tr>
                                    <td class="label" style="font-weight: bold; color: #000;">Name</td>
                                    <td class="colon" style="font-weight: bold; color: #000;">:</td>
                                    <td class="bold-val">@dto.PatientName</td>
                                </tr>
                                <tr>
                                    <td class="label">Age</td>
                                    <td class="colon">:</td>
                                    <td class="value">@dto.Age</td>
                                </tr>
                                <tr>
                                    <td class="label" style="font-weight: bold; color: #000;">Doctor</td>
                                    <td class="colon" style="font-weight: bold; color: #000;">:</td>
                                    <td class="bold-val">@dto.DoctorName</td>
                                </tr>
                                <tr>
                                    <td class="label">Ref. By</td>
                                    <td class="colon">:</td>
                                    <td class="value" style="text-transform: uppercase;">@dto.RefBy</td>
                                </tr>
                            </table>
                        </td>
                        
                        <!-- Column 2: Middle patient info (28%) -->
                        <td style="width: 28%; vertical-align: top; padding-left: 10px;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <td class="label" style="width: 45px;">Pat. ID</td>
                                    <td class="colon">:</td>
                                    <td class="value">@dto.PatId</td>
                                </tr>
                                <tr>
                                    <td class="label" style="width: 45px; height: 18px;"></td>
                                    <td class="colon"></td>
                                    <td class="value"></td>
                                </tr>
                                <tr>
                                    <td class="label" style="width: 45px;">Gender</td>
                                    <td class="colon">:</td>
                                    <td class="value">@dto.Gender</td>
                                </tr>
                            </table>
                        </td>
                        
                        <!-- Column 3: Right barcode and dates (34%) -->
                        <td style="width: 34%; vertical-align: top; text-align: right;">
                            <div class="barcode-container">
                                @((MarkupString)GenerateBarcodeSvg(dto.Barcode))
                            </div>
                            <table class="date-table">
                                <tr>
                                    <td class="date-label">Collected On</td>
                                    <td class="date-colon">:</td>
                                    <td class="date-val">@dto.CollectedOn.ToString("dd-MM-yyyy hh:mm tt")</td>
                                </tr>
                                <tr>
                                    <td class="date-label">Received On</td>
                                    <td class="date-colon">:</td>
                                    <td class="date-val">@dto.ReceivedOn.ToString("dd-MM-yyyy hh:mm tt")</td>
                                </tr>
                                <tr>
                                    <td class="date-label">Reported On</td>
                                    <td class="date-colon">:</td>
                                    <td class="date-val">@dto.ReportedOn.ToString("dd-MM-yyyy hh:mm tt")</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
                
                <!-- Bottom Separator Line -->
                <hr class="divider" />
            </div>
        </div>
    }
    else if (Section == "Footer")
    {
        <style>
            .footer-container {
                width: 100%;
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                background: #ffffff;
            }
            .footer-container img {
                width: 100%;
                height: auto;
                display: block;
            }
        </style>
        <div class="footer-container">
            <!-- Dynamic Footer Image / Branding Block -->
            @if (dto.footerimage != null && dto.footerimage.Length > 0 && !dto.isletterhead)
            {
                var base64Footer = Convert.ToBase64String(dto.footerimage);
                <img src="data:image/png;base64,@base64Footer" style="width:100%; display:block;" />
            }
            else
            {
                <div style="height: 30px; width: 100%;"></div>
            }
        </div>
    }
    else
    {
        <style>
            body {
                font-family: 'Segoe UI', Arial, sans-serif;
                color: #1a202c;
                margin: 0;
                padding: 0;
                background: #ffffff;
                -webkit-print-color-adjust: exact;
            }
            .test-block {
                margin-bottom: 20px;
                page-break-inside: avoid;
            }
            .report-title-section {
                text-align: center;
                margin-bottom: 12px;
            }
            .dept-title {
                margin: 0;
                font-size: 16.5px;
                font-weight: 700;
                color: #2d3748;
                letter-spacing: 0.5px;
            }
            .report-type {
                font-size: 11px;
                color: #718096;
                margin-top: 2px;
                text-transform: uppercase;
                letter-spacing: 0.8px;
            }
            .test-title {
                display: inline-block;
                font-size: 13.5px;
                font-weight: 700;
                color: #1a202c;
                text-decoration: underline;
                margin-top: 5px;
                padding-bottom: 2px;
            }
            .result-box {
                border: 1px solid #aaa;
                border-radius: 4px;
                padding: 8px 12px;
                margin-top: 6px;
                background-color: #ffffff;
            }
            .result-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 11.5px;
                line-height: 1.5;
            }
            .result-table td {
                vertical-align: top;
                padding: 4px 0;
            }
            .res-label {
                width: 140px;
                color: #4a5568;
            }
            .res-colon {
                width: 20px;
                text-align: center;
                color: #4a5568;
            }
            .res-value {
                font-weight: 500;
                color: #1a202c;
            }
            .bold-row {
                font-weight: 700 !important;
                color: #000000 !important;
            }
            .organism-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 11.5px;
                line-height: 1.5;
                margin-top: 6px;
            }
            .organism-table td {
                vertical-align: top;
                padding: 4px 0;
            }
            .antibiotics-table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 10px;
                font-size: 10.5px;
                border: 1px solid #aaa;
            }
            .antibiotics-table th, .antibiotics-table td {
                border: 1px solid #aaa;
                padding: 4px 6px;
                vertical-align: middle;
            }
            .antibiotics-table tr {
                page-break-inside: avoid;
                break-inside: avoid;
            }
            .antibiotics-table th {
                background-color: #ffffff;
                font-weight: bold;
                color: #000000;
                border-bottom: 1px solid #aaa;
            }
            .th-left {
                text-align: left;
                width: 35%;
            }
            .th-center {
                text-align: center;
                width: 15%;
            }
            .th-sub {
                text-align: center;
                font-size: 9px;
                font-weight: bold;
                padding: 2px 4px;
            }
            .border-right {
                border-right: 1px solid #aaa !important;
            }
            .end-report {
                text-align: center;
                margin-top: 30px;
                margin-bottom: 25px;
                font-size: 11px;
                font-weight: 700;
                color: #718096;
                letter-spacing: 0.5px;
                page-break-inside: avoid;
            }
            .signature-section {
                margin-top: 15px;
                float: right;
                text-align: center;
                width: 220px;
                page-break-inside: avoid;
            }
            .signature-image-container {
                height: 40px;
                margin-bottom: 4px;
                display: flex;
                align-items: center;
                justify-content: center;
            }
            .signature-image-container img {
                max-height: 40px;
                max-width: 180px;
                display: block;
            }
            .doctor-name {
                font-weight: 700;
                font-size: 11.5px;
                color: #1a202c;
                margin-bottom: 1px;
            }
            .doctor-designation {
                font-size: 10.5px;
                color: #4a5568;
            }
        </style>
        <div class="body-content">
            <!-- Dynamic test blocks -->
            @if (dto.Tests != null)
            {
                int globalBlockIndex = 0;
                for (int tIdx = 0; tIdx < dto.Tests.Count; tIdx++)
                {
                    var test = dto.Tests[tIdx];
                    if (test.Organisms != null && test.Organisms.Count > 0)
                    {
                        for (int oIdx = 0; oIdx < test.Organisms.Count; oIdx++)
                        {
                            var org = test.Organisms[oIdx];
                            var pageBreakStyle = globalBlockIndex > 0 ? "page-break-before: always; padding-top: 10px;" : "";
                            globalBlockIndex++;

                            char isolationLetter = (char)('A' + oIdx);
                            string commentsLabel = $"Comments {isolationLetter}";
                            if (!string.IsNullOrWhiteSpace(org.OrganismName))
                            {
                                int openBrack = org.OrganismName.IndexOf('[');
                                int closeBrack = org.OrganismName.IndexOf(']');
                                if (openBrack >= 0 && closeBrack > openBrack + 1)
                                {
                                    string inner = org.OrganismName.Substring(openBrack + 1, closeBrack - openBrack - 1).Trim('.');
                                    if (inner.Length > 0)
                                    {
                                        isolationLetter = inner[0];
                                        commentsLabel = $"Comments {isolationLetter}";
                                    }
                                }
                            }

                            <div class="test-block" style="@pageBreakStyle">
                                @if (oIdx == 0)
                                {
                                    var dept = !string.IsNullOrWhiteSpace(test.Department) ? test.Department : "Microbiology";
                                    var repType = !string.IsNullOrWhiteSpace(test.ReportType) ? test.ReportType : "Final Report";
                                    var tName = !string.IsNullOrWhiteSpace(test.TestName) ? test.TestName : "CULTURE & SENSITIVITY - URINE";
                                    var spec = !string.IsNullOrWhiteSpace(test.Specimen) ? test.Specimen : "Urine";
                                    var repMethod = !string.IsNullOrWhiteSpace(test.ReportingMethod) ? test.ReportingMethod : "ANEROBIC CULTURE";

                                    <div class="report-title-section">
                                        <h2 class="dept-title">@dept</h2>
                                        <div class="report-type">@repType</div>
                                        <div class="test-title">@tName</div>
                                    </div>

                                    <div class="result-box" style="margin-bottom: 15px;">
                                        <table class="result-table">
                                            <tr>
                                                <td class="res-label">Specimen</td>
                                                <td class="res-colon">:</td>
                                                <td class="res-value">@spec</td>
                                            </tr>
                                            <tr>
                                                <td class="res-label">Reporting Method</td>
                                                <td class="res-colon">:</td>
                                                <td class="res-value">@repMethod</td>
                                            </tr>
                                        </table>
                                    </div>
                                }

                                <table class="organism-table">
                                    @if (oIdx == 0 && !string.IsNullOrWhiteSpace(test.Diagnosis))
                                    {
                                        <tr>
                                            <td class="res-label">Diagnosis</td>
                                            <td class="res-colon">:</td>
                                            <td class="res-value">@test.Diagnosis</td>
                                        </tr>
                                    }
                                    <tr>
                                        <td class="res-label">@(oIdx == 0 ? "Organism Grown" : "Organism")</td>
                                        <td class="res-colon">:</td>
                                        <td class="res-value bold-row">@org.OrganismName</td>
                                    </tr>
                                    <tr>
                                        <td class="res-label">Colony Count</td>
                                        <td class="res-colon">:</td>
                                        <td class="res-value">@org.ColonyCount</td>
                                    </tr>
                                    <tr>
                                        <td class="res-label">@commentsLabel</td>
                                        <td class="res-colon">:</td>
                                        <td class="res-value">@org.Comments</td>
                                    </tr>
                                </table>

                                @if (org.Antibiotics != null && org.Antibiotics.Count > 0)
                                {
                                    int n = org.Antibiotics.Count;
                                    int mid = (n + 1) / 2;

                                    <table class="antibiotics-table">
                                        <thead>
                                            <tr>
                                                <th rowspan="2" class="th-left">Antibiotics</th>
                                                <th colspan="2" class="th-center border-right">Isolation @isolationLetter</th>
                                                <th rowspan="2" class="th-left" style="padding-left: 15px;">Antibiotics</th>
                                                <th colspan="2" class="th-center">Isolation @isolationLetter</th>
                                            </tr>
                                            <tr>
                                                <th class="th-sub">Result</th>
                                                <th class="th-sub border-right">MIC</th>
                                                <th class="th-sub" style="padding-left: 15px;">Result</th>
                                                <th class="th-sub">MIC</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < mid; i++)
                                            {
                                                var left = org.Antibiotics[i];
                                                var right = (i + mid < n) ? org.Antibiotics[i + mid] : null;

                                                <tr>
                                                    <td class="th-left">@left.AntibioticName</td>
                                                    <td style="text-align: center;">@left.Result</td>
                                                    <td class="border-right" style="text-align: center;">@left.MIC</td>
                                                    <td class="th-left" style="padding-left: 15px;">@right?.AntibioticName</td>
                                                    <td style="text-align: center;">@right?.Result</td>
                                                    <td style="text-align: center;">@right?.MIC</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        var pageBreakStyle = globalBlockIndex > 0 ? "page-break-before: always; padding-top: 10px;" : "";
                        globalBlockIndex++;

                        <div class="test-block" style="@pageBreakStyle">
                            <div class="report-title-section">
                                <h2 class="dept-title">@test.Department</h2>
                                <div class="report-type">@test.ReportType</div>
                                <div class="test-title">@test.TestName</div>
                            </div>

                            <div class="result-box">
                                <table class="result-table">
                                    <tr>
                                        <td class="res-label">Specimen</td>
                                        <td class="res-colon">:</td>
                                        <td class="res-value">@test.Specimen</td>
                                    </tr>
                                    <tr>
                                        <td class="res-label">Reporting Method</td>
                                        <td class="res-colon">:</td>
                                        <td class="res-value">@test.ReportingMethod</td>
                                    </tr>
                                    <tr class="bold-row">
                                        <td class="res-label bold-row">Interpretation</td>
                                        <td class="res-colon bold-row">:</td>
                                        <td class="res-value bold-row">
                                            @if (!string.IsNullOrWhiteSpace(test.Interpretation))
                                            {
                                                @((MarkupString)test.Interpretation.Replace("\n", "<br/>").Replace(",", "<br/>"))
                                            }
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    }
                }
            }

            <!-- Interpretation & Open Comments -->
            @if (HasAnyAntibiotics())
            {
                var interpretationVal = !string.IsNullOrWhiteSpace(dto.Interpretation) ? dto.Interpretation : "Sample Content about the comments here can be entered here\nOPen comments can be entered here";
                <div style="margin-top: 15px; font-size: 10px; color: #4a5568;">
                    S* - Sensitive; I* - Intermediate; R* - Resistant
                </div>
                <div style="margin-top: 12px; font-size: 11px;">
                    <div style="font-weight: bold;">Interpretation :</div>
                    <div style="margin-top: 4px; color: #2d3748; line-height: 1.4;">
                        @((MarkupString)interpretationVal.Replace("\n", "<br/>").Replace(",", "<br/>"))
                    </div>
                </div>
            }

            <!-- End of Report -->
            <div class="end-report">
                *** End of Report ***
            </div>

            <!-- Signature Block -->
            <div class="signature-section">
                <div class="signature-image-container">
                    @if (dto.SignatureImage != null && dto.SignatureImage.Length > 0)
                    {
                        var base64Sig = Convert.ToBase64String(dto.SignatureImage);
                        <img src="data:image/png;base64,@base64Sig" />
                    }
                </div>
                <div class="doctor-name">@dto.SignatureDoctorName</div>
                <div class="doctor-designation">@dto.SignatureDoctorDesignation</div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public CultureReportDto dto { get; set; }

    [Parameter]
    public string Section { get; set; } = "Body";

    protected override void OnParametersSet()
    {
        if (dto != null)
        {
            // If root-level organisms are passed, wrap them in a test item for unified processing
            if (dto.Organisms != null && dto.Organisms.Count > 0 && (dto.Tests == null || dto.Tests.Count == 0))
            {
                if (dto.Tests == null) dto.Tests = new List<CultureTestItemModel>();
                dto.Tests.Add(new CultureTestItemModel
                {
                    Department = dto.Department,
                    ReportType = dto.ReportType,
                    TestName = dto.TestName,
                    Specimen = dto.Specimen,
                    ReportingMethod = dto.ReportingMethod,
                    Diagnosis = dto.Diagnosis,
                    Organisms = dto.Organisms,
                    Interpretation = dto.Interpretation
                });
            }

            // Ensure Tests list is not null and has at least one item
            if (dto.Tests == null)
            {
                dto.Tests = new List<CultureTestItemModel>();
            }

            if (dto.Tests.Count == 0)
            {
                dto.Tests.Add(new CultureTestItemModel
                {
                    Department = !string.IsNullOrWhiteSpace(dto.Department) ? dto.Department : "Microbiology",
                    ReportType = !string.IsNullOrWhiteSpace(dto.ReportType) ? dto.ReportType : "Final Report",
                    TestName = !string.IsNullOrWhiteSpace(dto.TestName) ? dto.TestName : "CULTURE & SENSITIVITY - URINE",
                    Specimen = !string.IsNullOrWhiteSpace(dto.Specimen) ? dto.Specimen : "Urine",
                    ReportingMethod = !string.IsNullOrWhiteSpace(dto.ReportingMethod) ? dto.ReportingMethod : "ANEROBIC CULTURE",
                    Diagnosis = dto.Diagnosis,
                    Interpretation = !string.IsNullOrWhiteSpace(dto.Interpretation) ? dto.Interpretation : "No growth after 24 hours of incubation,Final report will follow after 5 days of incubation"
                });
            }
        }
    }

    private bool HasAnyAntibiotics()
    {
        if (dto?.Tests == null) return false;
        foreach (var test in dto.Tests)
        {
            if (test.Organisms == null) continue;
            foreach (var org in test.Organisms)
            {
                if (org.Antibiotics != null && org.Antibiotics.Count > 0)
                {
                    return true;
                }
            }
        }
        return false;
    }

    private string GenerateBarcodeSvg(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) text = "123456";
        text = text.ToUpper();
        
        var alphabet = "*0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-. $/+%";
        var patterns = new[] {
            "1010011011010", // *
            "1010011011010", // 0
            "1101001010110", // 1
            "1011001010110", // 2
            "1101100101010", // 3
            "1010011010110", // 4
            "1101001101010", // 5
            "1011001101010", // 6
            "1010010110110", // 7
            "1101001011010", // 8
            "1011001011010", // 9
            "1101010010110", // A
            "1011010010110", // B
            "1101101001010", // C
            "1010110010110", // D
            "1101011001010", // E
            "1011011001010", // F
            "1010100110110", // G
            "1101010011010", // H
            "1011010011010", // I
            "1010110011010", // J
            "1101010100110", // K
            "1011010100110", // L
            "1101101010010", // M
            "1010110100110", // N
            "1101011010010", // O
            "1011011010010", // P
            "1010101100110", // Q
            "1101010110010", // R
            "1011010110010", // S
            "1010110110010", // T
            "1100101010110", // U
            "1001101010110", // V
            "1100110101010", // W
            "1001011010110", // X
            "1100101101010", // Y
            "1001101101010", // Z
            "1001010110110", // -
            "1100101011010", // .
            "1001101011010", // Space
            "1001001001010", // $
            "1001001010010", // /
            "1001010010010", // +
            "1010010010010"  // %
        };

        var fullPattern = new StringBuilder();
        
        // Start character '*'
        fullPattern.Append(patterns[0]);
        
        foreach (var c in text)
        {
            int idx = alphabet.IndexOf(c);
            if (idx >= 0)
            {
                fullPattern.Append(patterns[idx]);
            }
        }
        
        // Stop character '*'
        fullPattern.Append(patterns[0]);

        var svg = new StringBuilder();
        svg.Append("<svg width='100%' height='100%' viewBox='0 0 320 40' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>");
        
        string pat = fullPattern.ToString();
        float barWidth = 320f / pat.Length;
        
        for (int i = 0; i < pat.Length; i++)
        {
            if (pat[i] == '1')
            {
                svg.Append($"<rect x='{(i * barWidth).ToString("F2", CultureInfo.InvariantCulture)}' y='0' width='{(barWidth + 0.1f).ToString("F2", CultureInfo.InvariantCulture)}' height='40' fill='black' />");
            }
        }
        svg.Append("</svg>");
        return svg.ToString();
    }
}
