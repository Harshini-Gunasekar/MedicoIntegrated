@using Microsoft.AspNetCore.Components
@using ReportingServer.Model

<div style="width: 100%; font-family: Arial, Helvetica, sans-serif; box-sizing: border-box; background: white; padding: 0 10px;">
    <!-- ITEMS TABLE -->
    <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 5px;">
        <thead>
            <tr style="background: #eef5fc; border-top: 1.5px solid #0056b3; border-bottom: 1.5px solid #0056b3;">
                <th style="width: 10%; text-align: center; padding: 8px 0; font-weight: bold; color: #0056b3;">S.No</th>
                <th style="width: 70%; text-align: left; padding: 8px 0; font-weight: bold; color: #0056b3;">Test Name</th>
                <th style="width: 20%; text-align: right; padding: 8px 0; font-weight: bold; color: #0056b3;">Amount</th>
            </tr>
        </thead>
        <tbody>
            @if (Items != null)
            {
                foreach (var item in Items)
                {
                    int sno = Items.IndexOf(item);
                    <tr style="border-bottom: 1px solid #e1e8f0;">
                        <td style="text-align: center; padding: 8px 0; color: #000;">@(sno + 1)</td>
                        <td style="text-align: left; padding: 8px 0; color: #000; text-transform: uppercase;">@item.TestName</td>
                        <td style="text-align: right; padding: 8px 0; color: #000;">@item.Amount.ToString("F2")</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- TOTALS & AMOUNT IN WORDS SIDE-BY-SIDE -->
    <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 15px;">
        <tr>
            <!-- Left side: Amount in Words in a premium grey contrast box -->
            <td style="width: 50%; vertical-align: top; text-align: left; padding: 0;">
                @if (Bills != null)
                {
                    <div style="background: #f4f6f9; border: 1px solid #e1e8f0; padding: 10px 12px; border-radius: 4px; font-family: Arial, sans-serif; font-size: 11px; color: #333; margin-top: 4px; margin-right: 20px;">
                        <span style="font-weight: bold; color: #000;">Amount in words:</span>
                        <div style="margin-top: 4px; line-height: 1.4; color: #000;">@AmountToWordsConverter.Convert(Bills.TotalAmount)</div>
                    </div>
                }
            </td>
            
            <!-- Right side: Financial Summary -->
            <td style="width: 50%; vertical-align: top; padding: 0;">
                @if (Bills != null)
                {
                    <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                        <tr>
                            <td style="width: 60%; text-align: right; padding: 4px 15px 4px 0; color: #555;">Total Amount</td>
                            <td style="width: 40%; text-align: right; padding: 4px 0; color: #000; font-weight: bold;">@Bills.TotalAmount.ToString("F2")</td>
                        </tr>
                        <tr>
                            <td style="width: 60%; text-align: right; padding: 4px 15px 4px 0; color: #555;">Discount Amount</td>
                            <td style="width: 40%; text-align: right; padding: 4px 0; color: #000;">@Bills.DiscountAmount.ToString("F2")</td>
                        </tr>
                        <tr>
                            <td style="width: 60%; text-align: right; padding: 4px 15px 4px 0; color: #555;">Net Amount</td>
                            <td style="width: 40%; text-align: right; padding: 4px 0; color: #000;">@Bills.NetAmount.ToString("F2")</td>
                        </tr>
                        <tr>
                            <td style="width: 60%; text-align: right; padding: 4px 15px 4px 0; color: #555;">Paid Amount</td>
                            <td style="width: 40%; text-align: right; padding: 4px 0; color: #000; border-bottom: 2px solid #0056b3;">@Bills.ReceivedAmount.ToString("F2")</td>
                        </tr>
                        <tr>
                            <td style="width: 60%; text-align: right; padding: 8px 15px 8px 0; font-weight: bold; color: #0056b3; font-size: 12px;">Balance Amount</td>
                            <td style="width: 40%; text-align: right; padding: 8px 0; font-weight: bold; color: #0056b3; font-size: 12px; border-bottom: 2px solid #0056b3;">@Bills.BalanceAmount.ToString("F2")</td>
                        </tr>
                    </table>
                }
            </td>
        </tr>
    </table>

   @*  <!-- SIGNATURE BLOCK -->
    @if (Bills != null)
    {
        <div style="width: 100%; display: flex; justify-content: flex-end; margin-top: 40px;">
            <div style="width: 200px; text-align: right; font-family: Arial, sans-serif;">
                <div style="font-size: 12px; font-weight: bold; color: #000; margin-bottom: 45px; text-transform: uppercase;">For @Bills.LabName</div>
                <div style="font-size: 11px; font-weight: normal; color: #555; letter-spacing: 0.2px;">Authorised Signatory</div>
            </div>
        </div>
    } *@
</div>

@code {
    [Parameter]
    public CashBillModel Bills { get; set; }

    [Parameter]
    public IList<CashBillItemModel> Items { get; set; }
}