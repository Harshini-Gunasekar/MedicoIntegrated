@page "/received"
@rendermode InteractiveServer



@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using TrackAdmin.Components.Layout
@using TrackAdmin.Data

@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.DropDowns
@using TrackAdmin.Models

@inject NavigationManager Navigation
@inject HttpClient http
@inject SfDialogService dp
@inject IJSRuntime JS
@inject HttpClient Http
@inject RiderTracking riderTracking
@inject MasterData msd
@inject PageMetadataService Metadata



@if (!pageReady)
{
    <div class="premium-loader-container">
        <div class="tactical-loader-orb">
            <i class="bi bi-box-seam-fill pulse"></i>
            <div class="loader-glow"></div>
        </div>
        <div class="loader-text-wrap">
            <h4>RIDO LOGISTICS</h4>
            <span>Syncing Received Samples...</span>
        </div>
    </div>
}
else
{
<section class="food-page animate-fade-in">
    <section class="container-fluid food-body">
        <section class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="stat-glass-card primary">
                    <div class="stat-icon-wrap"><i class="bi bi-calendar-check"></i></div>
                    <div class="stat-data">
                        <span class="stat-label">Total Visits</span>
                        <h3 class="stat-value">@scm.Count()</h3>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-glass-card success">
                    <div class="stat-icon-wrap"><i class="bi bi-droplet-fill"></i></div>
                    <div class="stat-data">
                        <span class="stat-label">Collected</span>
                        <h3 class="stat-value">@scm.Sum(x => x.CollectedQty)</h3>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-glass-card info">
                    <div class="stat-icon-wrap"><i class="bi bi-check-all"></i></div>
                    <div class="stat-data">
                        <span class="stat-label">Received</span>
                        <h3 class="stat-value">@scm.Sum(x => x.ReceivedQty)</h3>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-glass-card danger">
                    <div class="stat-icon-wrap"><i class="bi bi-x-circle-fill"></i></div>
                    <div class="stat-data">
                        <span class="stat-label">Rejected</span>
                        <h3 class="stat-value">@scm.Sum(x => x.RejectedQty)</h3>
                    </div>
                </div>
            </div>
        </section>

        <header class="food-toolbar premium-card mb-3">
            <div class="row g-3 p-2 px-3 align-items-center">
                <div class="col-xl-6">
                    <div class="premium-toolbar-group">
                        <div class="row g-0 align-items-center">
                            <div class="col border-end">
                                <div class="px-3 py-1">
                                    <label class="food-label d-flex align-items-center gap-2 mb-0" style="font-size: 10px;">
                                        <i class="bi bi-calendar-event text-primary"></i> From
                                    </label>
                                    <InputDate Type="InputDateType.Date" Value="@fdt" ValueExpression="() => fdt" ValueChanged="@((DateTime d) => { fdt = d; _ = btnrefresh(); })" class="form-control border-0 bg-transparent p-0 food-date-input" style="font-size: 13px;"></InputDate>
                                </div>
                            </div>
                            <div class="col border-end">
                                <div class="px-3 py-1">
                                    <label class="food-label d-flex align-items-center gap-2 mb-0" style="font-size: 10px;">
                                        <i class="bi bi-calendar-check text-primary"></i> To
                                    </label>
                                    <InputDate Type="InputDateType.Date" Value="@tdt" ValueExpression="() => tdt" ValueChanged="@((DateTime d) => { tdt = d; _ = btnrefresh(); })" class="form-control border-0 bg-transparent p-0 food-date-input" style="font-size: 13px;"></InputDate>
                                </div>
                            </div>
                            <div class="col-auto px-3">
                                <button type="button" @onclick="@btnrefresh" class="btn btn-primary btn-sm rounded-pill px-3" style="font-size: 11px; font-weight: 700;">
                                    <i class="bi bi-arrow-clockwise me-1"></i> REFRESH
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-6">
                    <div class="d-flex gap-2 justify-content-end align-items-center">
                        <div style="width: 180px;">
                            <SfComboBox DataSource="@rider" TValue="string" Placeholder="Rider" AllowFiltering=true Autofill=true FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" TItem="Rider_Master" CssClass="food-combo-sm">
                                <ComboBoxFieldSettings Text="Name" Value="Name"></ComboBoxFieldSettings>
                                <ComboBoxEvents OnValueSelect="@OnRiderSel" ValueChange="@OnRiderValueChange" TValue="String" TItem="Rider_Master"></ComboBoxEvents>
                            </SfComboBox>
                        </div>
                        <div style="width: 180px;">
                            <SfComboBox DataSource="@rm" TValue="string" Placeholder="Client" Autofill=true AllowFiltering=true FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" TItem="Referral_Master" CssClass="food-combo-sm">
                                <ComboBoxFieldSettings Text="Name" Value="Name"></ComboBoxFieldSettings>
                                <ComboBoxEvents OnValueSelect="@OnRefSel" ValueChange="@OnRefValueChange" TValue="String" TItem="Referral_Master"></ComboBoxEvents>
                            </SfComboBox>
                        </div>
                        <div class="food-status-wrap bg-light rounded-pill px-3 py-1 gap-3">
                            <SfRadioButton Label="All" Value="All" TChecked="string" @bind-Checked="@rdbreceived" Name="Received" @onchange="@ChangeReceive"></SfRadioButton>
                            <SfRadioButton Label="Pending" Value="false" TChecked="string" @bind-Checked="@rdbreceived" Name="Received" @onchange="@ChangeReceive"></SfRadioButton>
                            <SfRadioButton Label="Done" Value="true" TChecked="string" @bind-Checked="@rdbreceived" Name="Received" @onchange="@ChangeReceive"></SfRadioButton>
                        </div>
                    </div>
                </div>
            </div>
        </header>


    <section class="row g-4">
        <div class="col-xl-9">
            <div class="floating-row-container">
                <!-- Header Grid -->
                <div class="row-card-header d-none d-xl-flex">
                    <div class="col-ref">VISIT #</div>
                    <div class="col-client">CLIENT / FACILITY</div>
                    <div class="col-rider">ASSIGNED RIDER</div>
                    <div class="col-job">QTY</div>
                    <div class="col-status">TIME</div>
                    <div class="col-ops">ACTIONS</div>
                </div>

                @if (scm != null && scm.Count > 0)
                {
                    @foreach (var item in scm)
                    {
                        <div class="row-card @(scm2?.SPGuid == item.SPGuid ? "row-card-selected" : "") animate-slide-up" @onclick="@(() => OnSampleClick(item))">
                            <div class="status-indicator @(item.IsReceived ? "bg-success" : "bg-warning")"></div>
                            <div class="row-card-body">
                                <div class="col-ref">
                                    <span class="job-id">#@item.SPSno</span>
                                </div>
                                <div class="col-client">
                                    <div class="client-name">@(rm.FirstOrDefault(x => x.ReferralID == item.ReferralID)?.Name ?? "---")</div>
                                    <div class="client-id">REF: @item.ReferralID</div>
                                </div>
                                <div class="col-rider">
                                    <div class="rider-chip">
                                        <div class="rider-avatar">@((rider.FirstOrDefault(x => x.RiderID == item.RiderID)?.ShortName ?? "R")[0])</div>
                                        <span>@(rider.FirstOrDefault(x => x.RiderID == item.RiderID)?.Name ?? "---")</span>
                                    </div>
                                </div>
                                <div class="col-job">
                                    <div class="origin-pill mnl">@item.CollectedQty SAMPLES</div>
                                </div>
                                <div class="col-status">
                                    <div class="time-item"><i class="bi bi-clock"></i> @item.SPDate.ToString("hh:mm tt")</div>
                                    <div class="time-item highlight"><i class="bi bi-calendar"></i> @item.SPDate.ToString("dd MMM")</div>
                                </div>
                                <div class="col-ops">
                                    <div class="ops-actions">
                                        @if (item.IsReceived == false)
                                        {
                                            <button type="button" class="op-btn edit" title="Quick Receive" @onclick="@((args)=>QuickReceive(item))" @onclick:stopPropagation>
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                            <button type="button" class="op-btn delete" title="Reject" @onclick="@((args)=>AcceptSample(item))" @onclick:stopPropagation>
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn text-success p-0" title="Reverse" @onclick="@((args)=>SampleReverse(item))" @onclick:stopPropagation>
                                                <i class="bi bi-check-all fs-4"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-box-seam"></i>
                        <h5>No samples to receive</h5>
                        <p>Adjust your filters or date range</p>
                    </div>
                }
            </div>
        </div>

        <div class="col-xl-3">
            <div class="premium-card h-100" style="min-height: 400px;">
                <div class="p-3 border-bottom bg-light rounded-top-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-orb-sm"><i class="bi bi-info-circle-fill"></i></div>
                        <div>
                            <h6 class="mb-0 fw-800 text-primary">Visit #@Visitno</h6>
                            <small class="text-muted d-block text-truncate" style="max-width: 180px;">@client</small>
                        </div>
                    </div>
                </div>

                <div class="p-3">
                    @if (scd1 != null && scd1.Count > 0)
                    {
                        <div class="task-scroller-wrap" style="max-height: 500px; overflow-y: auto;">
                            @foreach (var sd in scd1)
                            {
                                <div class="transfer-item-compact mb-2">
                                    <div class="t-indicator"></div>
                                    <div class="t-info">
                                        <div class="t-top">
                                            <span class="t-id">@sd.Sample</span>
                                            <span class="t-time">Qty: @sd.Quantity</span>
                                        </div>
                                        <div class="d-flex gap-2 mt-1">
                                            <span class="badge bg-success-light text-success fs-xs">Acc: @sd.AcceptQty</span>
                                            <span class="badge bg-danger-light text-danger fs-xs">Rej: @sd.RejectedQty</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-cursor-fill d-block mb-2 fs-3 opacity-25"></i>
                            <small>Select a visit to view details</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
    </section>
    </section>

	<SfDialog Width="900px" Height="@hetdialog" Visible="@isvis" IsModal=true ShowCloseIcon=true>
		<DialogTemplates>
			<Header>Sample Details of Visit No : @Visitno - @client </Header>
			<Content>
				<section class="container-fluid position-relative">
					<section class="row py-1">
						<div class="col">
							<small>Recceived DateTime</small>
							<EditForm Model="@scm2">
								<InputDate Type="InputDateType.DateTimeLocal" @bind-Value=@scm2.ReceivedTime class="cal"></InputDate>
							</EditForm>
						</div>
						<div class="col">
							<small>Total Samples</small><br/>
							@scm2.CollectedQty
						</div>
						<div class="col">
							<small>Total Received</small><br/>
							@scm2.ReceivedQty
						</div>
						<div class="col">
							<small>Total Rejected</small><br />
							@scm2.RejectedQty
						</div>

					</section>

					<section class="row py-1">
						<div class="col">


							@if(scd1!=null & scd1.Count>0)
							{
								<SfGrid @ref="@grd2" DataSource="@scd1" Width="100%" Height="@het1" TValue="SampleCollection_Details" EnableStickyHeader=true >
									<GridSelectionSettings Mode="Syncfusion.Blazor.Grids.SelectionMode.Both"></GridSelectionSettings>
									<GridEditSettings AllowEditing=true Mode="EditMode.Batch" ShowConfirmDialog=false></GridEditSettings>
									<GridEvents OnCellSave="@CellSave" CellSelected="CellSelectHandler" TValue="SampleCollection_Details"></GridEvents>
									<GridColumns>
										<GridColumn Field="@nameof(SampleCollection_Details.SPDGuid)" IsPrimaryKey=true  Visible=false></GridColumn>
										<GridColumn Field="@nameof(SampleCollection_Details.Sample)" Width="150" HeaderText="Sample / Container "></GridColumn>
										<GridColumn Field="@nameof(SampleCollection_Details.Quantity)" Width="80" HeaderText="Collected Qty" EditType="EditType.DefaultEdit"></GridColumn>
										<GridColumn Field="@nameof(SampleCollection_Details.AcceptQty)" Width="80" HeaderText="Received Qty" EditType="EditType.DefaultEdit"></GridColumn>
										<GridColumn Field="@nameof(SampleCollection_Details.RejectedQty)" Width="80" HeaderText="Rejected Qty" EditType="EditType.DefaultEdit"></GridColumn>
										<GridColumn Field="@nameof(SampleCollection_Details.Reasons)" EditType="EditType.DefaultEdit" Width="150" HeaderText="Reasons"></GridColumn>
									</GridColumns>
								</SfGrid>

							}

						</div>
					</section>



					<section class="row py-1">

						<div class="col">
							<small>Overall Reasons</small><br/>
							<EditForm Model="@scm2">
								<SfTextArea @bind-Value=@scm2.QtyReasons Width="100%"></SfTextArea>
							</EditForm>

						</div>
					</section>
					<section class="row justify-content-center">
						<div class="col-auto">
							<button type="button" @onclick="@SaveReceive" class="btn-success border-0 rounded rounded-4 py-2 px-5"> <i class="bi bi-floppy"></i> Save</button>
						</div>
					</section>
				</section>
			</Content>
		</DialogTemplates>
		<DialogEvents OnClose="OnClosePop"></DialogEvents>
	</SfDialog>
}
@code {
	private bool pageReady = false;
	bool isvis=false;
	string hetdialog = "calc(100vh - 450px);";
	string het1 = "calc(100vh - 530px);";

	private void OnClosePop()
	{
		isvis = false;
	}

	string rdbreceived = "All";
	IList<SampleCollection_Master> scm = new List<SampleCollection_Master>();
	IList<SampleCollection_Master> scm1 = new List<SampleCollection_Master>();
	IList<SampleCollection_Details> scd = new List<SampleCollection_Details>();
	IList<SampleCollection_Details> scd1 = new List<SampleCollection_Details>();
	DateTime fdt=DateTime.Now.ToLocalTime();
	DateTime tdt = DateTime.Now.ToLocalTime();
	string userTimeZone = "";
	string apiurl = "";
	[Inject] IOptions<APIConfiguration> ApiConfig { get; set; }

	string client = "";
	string Visitno = "";

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			apiurl = ApiConfig.Value.BaseApiUrl;
			await btnrefresh();
			pageReady = true;
			await InvokeAsync(StateHasChanged);
		}
	}

    private void UpdateHeader()
    {
        Metadata.UpdatePage(
            "Samples Received", 
            "Audit and reconcile inbound samples", 
            "bi-box-seam",
            new List<PageStat> {
                new PageStat { Label = "Total Visits", Value = scm.Count.ToString() },
                new PageStat { Label = "Collected", Value = scm.Sum(x => x.CollectedQty).ToString(), Color = "text-success" },
                new PageStat { Label = "Received", Value = scm.Sum(x => x.ReceivedQty).ToString(), Color = "text-info" }
            }
        );
    }

	private async Task btnrefresh()
	{
		try
		{
			string sd = Convert.ToString(fdt.ToString("yyyy-MM-dd")) + " 00:00:00";
			string ed = Convert.ToString(tdt.ToString("yyyy-MM-dd")) + " 23:59:59";

			var res = await http.GetAsync($"{apiurl}SampleCollection/CollectionView?fd={Uri.EscapeUriString(sd)}&td={Uri.EscapeUriString(ed)}&rid=0");
			if (res.IsSuccessStatusCode)
			{
				var tt = res.Content.ReadAsStringAsync().Result;
				scm1 = JsonConvert.DeserializeObject<IList<SampleCollection_Master>>(tt);


				scm1 = scm1.OrderBy(x => x.SPSno).ToList();

				scm = scm1.Where(x => x.Deleted == false).ToList();

				Multipleids spguid = new();

				spguid.uids = string.Join(",", scm.Select(x => $"'{x.SPGuid}'::uuid"));
				string rid = string.Join(",", scm.Select(x => $"{x.ReferralID}"));
				string riderid = string.Join(",", scm.Select(x => $"{x.RiderID}"));
				var res1 = await http.PostAsJsonAsync($"{apiurl}SampleCollection/CollectionDetails", spguid);
				var tt1 = await res1.Content.ReadAsStringAsync();
				if (res1.IsSuccessStatusCode)
				{
					scd = JsonConvert.DeserializeObject<IList<SampleCollection_Details>>(tt1) ?? new List<SampleCollection_Details>();
					// if (scd != null && scd.Count > 0)
					// {
					// 	foreach (var x in scd)
					// 	{
					// 		x.AcceptQty=x.AcceptQty ?? 0;
					// 		x.RejectedQty=x.RejectedQty ?? 0;
					// 	}
					// }
				}
                await this.LoadReferralAsync(rid);
            }

            await InvokeAsync(StateHasChanged);
            UpdateHeader();
        }
        catch (Exception ex)
        {
            await dp.AlertAsync(ex.Message.ToString());
        }
    }


	IList<Referral_Master> rm = new List<Referral_Master>();
	IList<Rider_Master> rider = new List<Rider_Master>();
	private async Task LoadReferralAsync(string rid)
	{
        if (string.IsNullOrWhiteSpace(rid)) return;
        
		var res1 = await http.GetAsync($"{apiurl}referral/referralid?rname={Uri.EscapeUriString(rid)}");
		if (res1.IsSuccessStatusCode)
        {
		    var tt1 = await res1.Content.ReadAsStringAsync();
		    rm = JsonConvert.DeserializeObject<IList<Referral_Master>>(tt1) ?? new List<Referral_Master>();
		    await InvokeAsync(StateHasChanged);
        }
	}
	private async Task<string> GetRefName(int id)
	{
		return rm.Where(x => x.ReferralID == id).Select(x => x.Name).FirstOrDefault() ?? string.Empty;
	}
	private async Task LoadRiderAsync()
	{
		var res = await http.GetAsync($"{apiurl}User/GetFleetRiders");
		var tt = res.Content.ReadAsStringAsync().Result;
		var rider1 = JsonConvert.DeserializeObject<IList<Rider_Master>>(tt);
		foreach (var r in rider1)
		{
			riderTracking.TrimAllStrings(r);
		}

		rider = rider1;
		StateHasChanged();
	}
	SampleCollection_Master scm2 = new();
    private async Task OnSampleClick(SampleCollection_Master item)
    {
        scd1.Clear();
        scm2 = item;
        client = rm.Where(x=>x.ReferralID== item.ReferralID).Select(x=>x.Name).FirstOrDefault();
        Visitno =Convert.ToString(item.SPSno);

        if(scd!=null && scd.Count>0)
        { 
            scd1 = scd.Where(x => x.SPGuid == item.SPGuid).ToList();
        }

        StateHasChanged();
    }

	private async Task SampleSel(RowSelectEventArgs<SampleCollection_Master> args)
	{
		await OnSampleClick(args.Data);
	}
	int rid = 0; int refid = 0;
	private async Task OnRiderSel(SelectEventArgs<Rider_Master> args)
	{
		try
		{
			if (args != null)
			{

				rid = args.ItemData.RiderID;
				this.GridFilter();
			}
			else
			{
				//scm = scm1;

			}
			StateHasChanged();
		}catch(Exception ex)
		{
			await dp.AlertAsync(ex.Message.ToString());
		}
	}

	private void OnRiderValueChange(ChangeEventArgs<string,Rider_Master> args)
	{
		if(args.ItemData==null)
		{

			rid = 0;
			this.GridFilter();
		}
	}
	private async Task OnRefSel(SelectEventArgs<Referral_Master> args)
	{
		try
		{
			refid=args.ItemData.ReferralID;
			this.GridFilter();
			StateHasChanged();
		}
		catch (Exception ex)
		{
			await dp.AlertAsync(ex.Message.ToString());
		}
	}

	private void OnRefValueChange(ChangeEventArgs<string, Referral_Master> args)
	{
		if (args.ItemData == null)
		{

			refid = 0;
			this.GridFilter();
		}
	}
	private async Task QuickReceive(SampleCollection_Master args)
	{
		scm2=args;
		scm2.IsReceived=true;


		scm2.ReceivedTime = msd.ConvertToDubaiTime(msd.ConvertToUtc(DateTime.Now));

		scm2.ReceivedQty = scm2.CollectedQty;

		scd1 = scd.Where(x => x.SPGuid == args.SPGuid).ToList();
		foreach(var it in scd1)
		{
			it.AcceptQty = it.Quantity;
			it.RejectedQty = 0;

		}
		SampleCollectionRequest scr = new SampleCollectionRequest()
			{
				scm = scm2,
				scd = scd1
			};
		var res = await http.PostAsJsonAsync($"{apiurl}samplecollection/scentry", scr);
		if (res.IsSuccessStatusCode)
		{
			this.UpdateAppointments(Convert.ToString(scm2.AppID));
			await dp.AlertAsync("Successfully Save");
		}
		else
		{
			await dp.AlertAsync("Not Received Sample. Please try again");
		}

		this.btnrefresh();
		this.GridFilter();
		isvis = false;
		StateHasChanged();

	}
	private async Task UpdateAppointments(string id)
	{
		var res = await http.GetAsync($"{apiurl}samplecollection/appreceive?appid={Uri.EscapeUriString(id)}");
		var tt = res.Content.ReadAsStringAsync();
	}
	private async Task AcceptSample(SampleCollection_Master args)
	{
		isvis = !isvis;
		scd1 = scd.Where(x => x.SPGuid == args.SPGuid).ToList();
	}
	private async Task LoadCount()
	{
		scm2.CollectedQty=scd1.Sum(x=>x.Quantity);
		scm2.ReceivedQty=scd1.Sum(x=>x.AcceptQty);
		scm2.RejectedQty=scd1.Sum(x=>x.RejectedQty);

	}

	private async Task SaveReceive()
	{
		// args.ReceivedTime = DateTime.Now;
		// args.IsReceived = true;
		// IList<SampleCollection_Master> ssm = new List<SampleCollection_Master>();
		// ssm.Add(args);

		// var res = await http.PostAsJsonAsync($"{apiurl}samplecollection/updatereceive", ssm);
		// if (res.IsSuccessStatusCode)
		// {
		// 	await dp.AlertAsync($"{args.SPSno}Sample Received");
		// }
		// else
		// {
		// 	var tt = res.Content.ReadAsStringAsync().Result;
		// 	var tt1 = tt;
		// }
		scm2.IsReceived=true;
		

		SampleCollectionRequest scr = new SampleCollectionRequest()
			{
				scm = scm2,
				scd = scd1
			};
		var res = await http.PostAsJsonAsync($"{apiurl}samplecollection/scentry", scr);
		if(res.IsSuccessStatusCode)
		{
			this.UpdateAppointments(Convert.ToString(scm2.AppID));
			await dp.AlertAsync("Successfully Save");
		}
		else
		{
			await dp.AlertAsync("Not Received Sample. Please try again");
		}

		this.btnrefresh();
		this.GridFilter();
		isvis = false;
		StateHasChanged();
	}


	private async Task SampleReverse(SampleCollection_Master args)
	{
		bool isConfirm = await dp.ConfirmAsync($"Are you sure you want to Change {args.SPSno} Receive Status?", "Change Status");
		string confirmMessage = isConfirm ? "confirmed" : "canceled";

		if (isConfirm == true && confirmMessage == "confirmed")
		{


			args.ReceivedTime = DateTime.Now;
			args.IsReceived = false;
			IList<SampleCollection_Master> ssm = new List<SampleCollection_Master>();
			ssm.Add(args);

			var res = await http.PostAsJsonAsync($"{apiurl}samplecollection/updatereceive", ssm);
			if (res.IsSuccessStatusCode)
			{
				await dp.AlertAsync($"{args.SPSno} Status Changed Successfully");
			}
			else
			{
				var tt = res.Content.ReadAsStringAsync().Result;
				var tt1 = tt;
			}
			this.btnrefresh();
			this.GridFilter();
		}

	}



	private async Task ChangeReceive(ChangeEventArgs args)
	{
		this.GridFilter();
	}

	private async Task GridFilter()
	{
		// Start from full list
		var filteredList = scm1.AsQueryable();

		// Filter by RiderID if selected
		if (rid != 0)
		{
			filteredList = filteredList.Where(x => x.RiderID == rid);
		}

		// Filter by ReferralID if selected
		if (refid != 0)
		{
			filteredList = filteredList.Where(x => x.ReferralID == refid);
		}

		// Filter by Received status
		if (rdbreceived == "true")
		{
			filteredList = filteredList.Where(x => x.IsReceived == true);
		}
		else if (rdbreceived == "false")
		{
			filteredList = filteredList.Where(x => x.IsReceived == false);
		}

		// Finally convert to list
		scm = filteredList.ToList();
	}

	SfGrid<SampleCollection_Details> grd2;
	int rowindex = 0;
	public async Task CellSelectHandler(CellSelectEventArgs<SampleCollection_Details> args)
	{
		try
		{
			var cellIndexes = await grd2.GetSelectedRowCellIndexes();
			var rowIndex = cellIndexes[0].Item1;
			var columnIndex = (int)cellIndexes[0].Item2;
			rowindex = rowIndex;
			var fields = await grd2.GetColumnFieldNames();
			await grd2.EditCell(rowIndex, fields[columnIndex]);
		}
		catch(Exception ex)
		{
			await dp.AlertAsync(ex.Message.ToString());
		}
	}
	private async Task CellSave(CellSaveArgs<SampleCollection_Details> args)
	{
		try{

			if(args!=null && grd2!=null)
			{

				if(args.ColumnName=="AcceptQty")
				{
					var item=scd1.Where(x=>x.SPDGuid==args.Data.SPDGuid).FirstOrDefault();
					int newAcceptQty = Convert.ToInt32(args.Value);
					if(item!=null)
					{
						if (newAcceptQty > 0 && newAcceptQty <= item.Quantity)
						{
							item.AcceptQty = newAcceptQty;
							item.RejectedQty = item.Quantity - newAcceptQty;

							args.Data.RejectedQty = item.RejectedQty; // Refreshes UI
							args.RowData.RejectedQty = item.RejectedQty;

							await grd2.UpdateRowAsync(rowindex, args.Data);
						}
						else if(newAcceptQty>item.Quantity)
						{

							await dp.AlertAsync("Accepted qty must be between 0 and quantity");
						}
					}
				}
				else if (args.ColumnName == "RejectedQty")
				{
					var item = scd1.Where(x => x.SPDGuid == args.Data.SPDGuid).FirstOrDefault();
					int newAcceptQty = Convert.ToInt32(args.Value);
					if (item != null)
					{
						if (newAcceptQty > 0 && newAcceptQty <= item.Quantity)
						{
							item.RejectedQty = newAcceptQty;
							item.RejectedQty = item.Quantity - item.AcceptQty;

							args.Data.AcceptQty = item.AcceptQty; // Refreshes UI
							args.RowData.AcceptQty = item.AcceptQty;
							await grd2.UpdateRowAsync(rowindex, args.Data);
						}
						else if (newAcceptQty > item.Quantity)
						{

							await dp.AlertAsync("Rejected qty must be between 0 and quantity");
						}
					}
				}else if(args.ColumnName=="Reasons")
				{
					var item = scd1.Where(x => x.SPDGuid == args.Data.SPDGuid).FirstOrDefault();
					
					if (item != null)
					{
						item.Reasons = Convert.ToString(args.Value.ToString());
					}
				}
					this.LoadCount();
				StateHasChanged();
			}
			else
			{
				return;
			}

		}
		catch(Exception ex)
		{
			await dp.AlertAsync(ex.Message.ToString());
		}
	}

	private async Task AcceptAll()
	{
		try
		{
			foreach(var it in scd1)
			{
				it.AcceptQty=it.Quantity;
				it.RejectedQty = 0;

				await grd2.Refresh();

			}
			await this.LoadCount();

			await this.SaveReceive();

		

		}catch(Exception ex)
		{
			await dp.AlertAsync(ex.Message.ToString());
		}
	}
