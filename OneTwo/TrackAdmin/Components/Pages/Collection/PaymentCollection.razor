    private int currentPage = 1;
    private int pageSize = 10;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)filteredRequests.Count / pageSize));
    
    private void ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= TotalPages)
        {
            currentPage = newPage;
            StateHasChanged();
        }
    }

    private List<PaymentCollectionRequest> paginatedRequests
    {
        get
        {
            int totalPages = TotalPages;
            if (currentPage > totalPages) currentPage = Math.Max(1, totalPages);
            return filteredRequests.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
        }
    }

