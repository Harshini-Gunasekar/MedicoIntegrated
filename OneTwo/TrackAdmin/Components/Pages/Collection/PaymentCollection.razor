    // Custom Toast helper
    private void ShowToast(string message, string type = "success")
    {
        var title = type == "success" ? "Success" : (type == "error" ? "Error" : "Notice");
        var icon = type == "success" ? "bi-check-circle-fill" : (type == "error" ? "bi-exclamation-triangle-fill" : "bi-info-circle-fill");
        ShowPayToast(title, message, type, icon);
    }


    private async Task SubmitAssignAsync()
    {
        if (targetRiderId == null)
        {
            ShowToast("Please select a Rider.", "error");
            return;
        }

        try
        {
            var payload = new PaymentCollectionRequest
            {
                RequestID = selectedRequest.RequestID,
                RiderID = targetRiderId
            };

            var res = await http.PostAsJsonAsync($"{apiurl}PaymentCollection/admin/assign", payload);
            if (res.IsSuccessStatusCode)
            {
                CloseModals();
                await LoadRequestsAsync();
            }
            else
            {
                ShowToast("Failed to assign rider. Please try again.", "error");
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error assigning rider: {ex.Message}", "error");
        }
    }

    private async Task SubmitAuditAsync()
    {
        try
        {
            if (forceEqualizeAndResolve)
            {
                selectedRequest.CollectedAmount ??= selectedRequest.RequestedAmount;
                selectedRequest.ReferralConfirmedAmount = selectedRequest.CollectedAmount;
            }

            var payload = new PaymentCollectionRequest
            {
                RequestID = selectedRequest.RequestID,
                IsReceivedByLab = isReceivedByLab,
                AdminApprovedBy = 1,
                AdminNotes = adminNotes,
                CollectedAmount = selectedRequest.CollectedAmount,
                ReferralConfirmedAmount = selectedRequest.ReferralConfirmedAmount,
                ResolutionType = selectedRequest.CollectedAmount != selectedRequest.ReferralConfirmedAmount && !forceEqualizeAndResolve ? discrepancyResolution : null,
                ResolutionNotes = adminNotes
            };

            var res = await http.PostAsJsonAsync($"{apiurl}PaymentCollection/admin/approve", payload);
            if (res.IsSuccessStatusCode)
            {
                CloseModals();
                await LoadRequestsAsync();
            }
            else
            {
                ShowToast("Failed to submit lab audit. Please try again.", "error");
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error executing audit: {ex.Message}", "error");
        }
    }

    private async Task SubmitRejectResetAsync()
    {
        if (string.IsNullOrWhiteSpace(adminNotes))
        {
            ShowToast("Please enter a note / reason for rejecting and resetting the request.", "error");
            return;
        }

        try
        {
            var payload = new PaymentCollectionRequest
            {
                RequestID = selectedRequest.RequestID,
                AdminApprovedBy = 1,
                AdminNotes = adminNotes
            };

            var res = await http.PostAsJsonAsync($"{apiurl}PaymentCollection/admin/reject-reset", payload);
            if (res.IsSuccessStatusCode)
            {
                CloseModals();
                await LoadRequestsAsync();
            }
            else
            {
                ShowToast("Failed to reject and reset request. Please try again.", "error");
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error resetting request: {ex.Message}", "error");
        }
    }

    // Badge Helpers
    private string GetStatusColorClass(string status)
    {
        return status switch
        {
            "Requested"        => "bg-warning",
            "Assigned"         => "bg-info",
            "Accepted"         => "bg-primary",
            "Collected"        => "bg-indigo",
            "ReferralConfirmed"=> "bg-success animate-pulse",
            "Completed"        => "bg-success",
            "Discrepancy"      => "bg-danger",
            "Revisit"          => "bg-warning",
            _                  => "bg-secondary"
        };
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Requested"        => "bg-warning-light text-warning",
            "Assigned"         => "bg-info-light text-info fw-bold animate-pulse",
            "Accepted"         => "bg-primary-light text-primary",
            "Collected"        => "bg-info-light text-info",
            "ReferralConfirmed"=> "bg-success-light text-success",
            "Completed"        => "bg-success text-white",
            "Discrepancy"      => "bg-danger-light text-danger fw-bold animate-pulse",
            "Revisit"          => "bg-warning-light text-warning fw-bold",
            _                  => "bg-light text-secondary"
        };
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        if (payPollingTimer != null)
        {
            payPollingTimer.Stop();
            payPollingTimer.Dispose();
        }

        if (_payHubConnection != null)
        {
            try
            {
                await _payHubConnection.StopAsync();
                await _payHubConnection.DisposeAsync();
            }
            catch { }
        }
    }
