                 && x.IsDeficitSettled == true && x.DiscrepancyAmount.HasValue
                 && x.DeficitSettledTime.HasValue
                 && x.DeficitSettledTime.Value.Date >= filterStartDate.Date
                 && x.DeficitSettledTime.Value.Date <= filterEndDate.Date)
