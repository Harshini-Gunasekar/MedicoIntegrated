@page "/logistics/payment-collections"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using TrackAdmin.Components.Layout
@using TrackAdmin.Data
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.DropDowns
@using TrackAdmin.Models

@inject NavigationManager Navigation
@inject HttpClient http
@inject SfDialogService dp
@inject IJSRuntime JS
@inject RiderTracking riderTracking
@inject MasterData msd
@inject PageMetadataService Metadata
@inject TenantState _tenantState
@inject NotificationStore NotifStore

@if (!pageReady)
{
    <div class="premium-loader-container">
        <div class="tactical-loader-orb">
            <i class="bi bi-wallet2 pulse text-primary"></i>
            <div class="loader-glow"></div>
        </div>
        <div class="loader-text-wrap">
            <h4>RIDO LOGISTICS</h4>
            <span>Loading Payment Console...</span>
        </div>
    </div>
}
else
{
    <section class="food-page animate-fade-in">
        <section class="container-fluid food-body">
            
            <!-- Metrics Row -->
            <section class="row g-3 mb-4">
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="stat-glass-card primary">
                        <div class="stat-icon-wrap"><i class="bi bi-collection-fill"></i></div>
                        <div class="stat-data">
                            <span class="stat-label">Total Requests</span>
                            <h3 class="stat-value">@TotalRequestsCount</h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="stat-glass-card warning">
                        <div class="stat-icon-wrap"><i class="bi bi-hourglass-split"></i></div>
                        <div class="stat-data">
                            <span class="stat-label">Pending Action</span>
                            <h3 class="stat-value">@PendingActionCount</h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="stat-glass-card info">
                        <div class="stat-icon-wrap"><i class="bi bi-cash-stack"></i></div>
                        <div class="stat-data">
                            <span class="stat-label">@CollectedLabel</span>
                            <h3 class="stat-value">@CollectedTodayAmount.ToString("N0") AED</h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="stat-glass-card success">
                        <div class="stat-icon-wrap"><i class="bi bi-shield-check"></i></div>
                        <div class="stat-data">
                            <span class="stat-label">Completed</span>
                            <h3 class="stat-value">@CompletedCount</h3>
                        </div>
                    </div>
                </div>
                <!-- Recovery Amount Card -->
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="stat-glass-card" style="background: linear-gradient(135deg, rgba(6,182,212,0.08) 0%, rgba(6,182,212,0.03) 100%); border: 1px solid rgba(6,182,212,0.18);">
                        <div class="stat-icon-wrap" style="background: rgba(6,182,212,0.15); color: #06b6d4;"><i class="bi bi-arrow-repeat"></i></div>
                        <div class="stat-data">
                            <span class="stat-label" style="color: #06b6d4;">Recovery Amount</span>
                            <h3 class="stat-value" style="color: #06b6d4;">@RecoveryAmountInPeriod.ToString("N0") AED</h3>
                            <small style="font-size:9.5px;color:#64748b;font-weight:600;">Settled rider deficits</small>
                        </div>
                    </div>
                </div>
                <!-- Deficit Amount Card -->
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="stat-glass-card" style="background: linear-gradient(135deg, rgba(239,68,68,0.08) 0%, rgba(239,68,68,0.03) 100%); border: 1px solid rgba(239,68,68,0.18);">
                        <div class="stat-icon-wrap" style="background: rgba(239,68,68,0.15); color: #ef4444;"><i class="bi bi-exclamation-triangle-fill"></i></div>
                        <div class="stat-data">
                            <span class="stat-label" style="color: #ef4444;">Outstanding Deficit</span>
                            <h3 class="stat-value" style="color: #ef4444;">@DeficitAmountInPeriod.ToString("N0") AED</h3>
                            <small style="font-size:9.5px;color:#64748b;font-weight:600;">Unsettled shortfalls</small>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Collection Funnel & Weekly Trend Row -->
            <div class="row g-3 mb-4 animate-slide-up">
                <div class="col-xl-7">
                    <!-- Funnel Chart Card -->
                    <div class="premium-card h-100 p-3" style="background: rgba(255,255,255,0.7); backdrop-filter: blur(10px); border-radius:16px; border: 1px solid rgba(0,0,0,0.08);">
                        <h6 class="fw-bold mb-3 text-dark text-xs uppercase" style="letter-spacing: 0.5px;">
                            <i class="bi bi-funnel text-primary me-2"></i> Collection Funnel Chart
                        </h6>
                        <div class="funnel-flex">
                            <div class="funnel-stage">
                                <div class="stage-name">Requested</div>
                                <div class="stage-val">@FunnelRequested</div>
                                <div class="stage-pct">100%</div>
                                <div class="stage-sub">Start</div>
                            </div>
                            <div class="funnel-arrow"><i class="bi bi-chevron-right"></i></div>
                            <div class="funnel-stage">
                                <div class="stage-name">Assigned</div>
                                <div class="stage-val">@FunnelAssigned</div>
                                <div class="stage-pct">@GetConversionPercent(FunnelAssigned, FunnelRequested)</div>
                                <div class="stage-sub">from Prev</div>
                            </div>
                            <div class="funnel-arrow"><i class="bi bi-chevron-right"></i></div>
                            <div class="funnel-stage">
                                <div class="stage-name">Collected</div>
                                <div class="stage-val">@FunnelCollected</div>
                                <div class="stage-pct">@GetConversionPercent(FunnelCollected, FunnelAssigned)</div>
                                <div class="stage-sub">from Prev</div>
                            </div>
                            <div class="funnel-arrow"><i class="bi bi-chevron-right"></i></div>
                            <div class="funnel-stage">
                                <div class="stage-name">Confirmed</div>
                                <div class="stage-val">@FunnelConfirmed</div>
                                <div class="stage-pct">@GetConversionPercent(FunnelConfirmed, FunnelCollected)</div>
                                <div class="stage-sub">from Prev</div>
                            </div>
                            <div class="funnel-arrow"><i class="bi bi-chevron-right"></i></div>
                            <div class="funnel-stage active">
                                <div class="stage-name">Completed</div>
                                <div class="stage-val">@FunnelCompleted</div>
                                <div class="stage-pct">@GetOverallConversionPercent(FunnelCompleted, FunnelRequested)</div>
                                <div class="stage-sub">Overall Conv.</div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-xl-5">
                    <!-- Weekly Trend Card -->
                    <div class="premium-card h-100 p-3" style="background: rgba(255,255,255,0.7); backdrop-filter: blur(10px); border-radius:16px; border: 1px solid rgba(0,0,0,0.08);">
                        <h6 class="fw-bold mb-3 text-dark text-xs uppercase" style="letter-spacing: 0.5px;">
                            <i class="bi bi-graph-up-arrow text-primary me-2"></i> Weekly Trend Comparison
                        </h6>
                        <div class="row g-2 align-items-center h-100 pb-3">
                            <div class="col-6 border-end pe-3">
                                <div class="trend-metric-title">Weekly Collections</div>
                                <div class="d-flex align-items-baseline gap-2">
                                    <span class="trend-current-val">@ThisWeekCollectedAmount.ToString("N0") AED</span>
                                    <span class="trend-badge @(CollectionsTrendPercentage >= 0 ? "positive" : "negative")">
                                        <i class="bi @(CollectionsTrendPercentage >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                                        @Math.Abs(CollectionsTrendPercentage).ToString("F0")%
                                    </span>
                                </div>
                                <div class="trend-sub-label">vs Last Week: <strong class="text-dark">@LastWeekCollectedAmount.ToString("N0") AED</strong></div>
                            </div>
                            <div class="col-6 ps-3">
                                <div class="trend-metric-title">Weekly Deficits</div>
                                <div class="d-flex align-items-baseline gap-2">
                                    <span class="trend-current-val">@ThisWeekDeficitCount Deficits</span>
                                    <span class="trend-badge @(DeficitTrendPercentage <= 0 ? "positive-good" : "negative-bad")">
                                        <i class="bi @(DeficitTrendPercentage <= 0 ? "bi-arrow-down-short" : "bi-arrow-up-short")"></i>
                                        @Math.Abs(DeficitTrendPercentage).ToString("F0")%
                                    </span>
                                </div>
                                <div class="trend-sub-label">vs Last Week: <strong class="text-dark">@LastWeekDeficitCount Deficits</strong></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Toolbar Filters -->
            <header class="food-toolbar premium-card mb-3">
                <div class="row g-3 p-2 px-3 align-items-center">
                    <div class="col-xl-10">
                        <div class="premium-toolbar-group">
                            <div class="row g-0 align-items-center">
                                <div class="col border-end px-3 py-1">
                                    <label class="food-label mb-0" style="font-size: 10px;">
                                        <i class="bi bi-funnel text-primary"></i> Request Type
                                    </label>
                                    <select class="form-control border-0 bg-transparent p-0" style="font-size: 13px; font-weight: 600; outline: none; cursor: pointer;" @bind="selectedType">
                                        <option value="All">All Types</option>
                                        <option value="PaymentCollection">Payment Collection</option>
                                        <option value="EmptyContainer">Empty Container</option>
                                    </select>
                                </div>
                                <div class="col border-end px-3 py-1">
                                    <label class="food-label mb-0" style="font-size: 10px;">
                                        <i class="bi bi-flag text-primary"></i> Status Filter
                                    </label>
                                    <select class="form-control border-0 bg-transparent p-0" style="font-size: 13px; font-weight: 600; outline: none; cursor: pointer;" @bind="selectedStatus">
                                        <option value="All">All Statuses</option>
                                        <option value="Requested">Awaiting Rider</option>
                                        <option value="Assigned">Assigned (Pending Accept)</option>
                                        <option value="Accepted">Accepted / Active</option>
                                        <option value="Collected">Collected</option>
                                        <option value="ReferralConfirmed">Referral Confirmed</option>
                                        <option value="Completed">Completed</option>
                                    </select>
                                </div>
                                <div class="col border-end px-3 py-1">
                                    <label class="food-label mb-0" style="font-size: 10px;">
                                        <i class="bi bi-calendar-event text-primary"></i> From Date
                                    </label>
                                    <input type="date" class="form-control border-0 bg-transparent p-0 minimal-date-input" @bind="filterStartDate" @bind:format="yyyy-MM-dd" @bind:after="UpdateHeader" />
                                </div>
                                <div class="col border-end px-3 py-1">
                                    <label class="food-label mb-0" style="font-size: 10px;">
                                        <i class="bi bi-calendar-event text-primary"></i> To Date
                                    </label>
                                    <input type="date" class="form-control border-0 bg-transparent p-0 minimal-date-input" @bind="filterEndDate" @bind:format="yyyy-MM-dd" @bind:after="UpdateHeader" />
                                </div>
                                <div class="col-auto px-3">
                                    <button type="button" @onclick="LoadRequestsAsync" class="btn btn-primary btn-sm rounded-pill px-3" style="font-size: 11px; font-weight: 700;">
                                        <i class="bi bi-arrow-clockwise me-1"></i> REFRESH
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Table Section -->
            <section class="row">
                <div class="col-12">
                    <div class="floating-row-container">
                        <!-- Table Header -->
                        <div class="row-card-header d-none d-xl-flex">
                            <div class="col-ref">REQ #</div>
                            <div class="col-client">CLIENT / REFERRAL</div>
                            <div class="col-rider">ASSIGNED RIDER</div>
                            <div class="col-job">TYPE</div>
                            <div class="col-job">COLLECTED INFO</div>
                            <div class="col-status">STATUS</div>
                            <div class="col-ops">ACTIONS</div>
                        </div>

                        <!-- Data Iteration -->
                        @if (paginatedRequests != null && paginatedRequests.Any())
                        {
                            @foreach (var item in paginatedRequests)
                            {
                                <div class="row-card animate-slide-up">
                                    <div class="status-indicator @GetStatusColorClass(item.Status)"></div>
                                    <div class="row-card-body">
                                        <div class="col-ref">
                                            <span class="job-id">#@item.RequestID</span>
                                            <small class="text-muted d-block" style="font-size: 9px;">@item.EnteredDate.ToLocalTime().ToString("dd MMM hh:mm tt")</small>
                                        </div>
                                        <div class="col-client">
                                            <div class="d-flex align-items-center gap-2 profile-hover-trigger cursor-pointer" style="position: relative;">
                                                <div style="display: contents;">
                                                    <img src="@GetReferralProfileImage(item.ReferralID)" 
                                                         class="rounded-circle border cursor-pointer" 
                                                         style="width: 28px; height: 28px; object-fit: cover;" 
                                                         onerror="this.src='/images/default-avatar.png'" />
                                                    
                                                    <!-- Premium Hover Card Popover -->
                                                    <div class="premium-hover-card">
                                                        <div class="hover-card-header">
                                                            <img src="@GetReferralProfileImage(item.ReferralID)" 
                                                                 class="hover-card-avatar" 
                                                                 onerror="this.src='/images/default-avatar.png'" />
                                                            <div class="hover-card-title-wrap">
                                                                <div class="hover-card-name">@item.ReferralName</div>
                                                                <div class="hover-card-sub">Client Referral</div>
                                                            </div>
                                                        </div>
                                                        <div class="hover-card-body">
                                                            <div class="hover-info-row">
                                                                <span class="info-label">Referral ID:</span>
                                                                <span class="info-value">#@item.ReferralID</span>
                                                            </div>
                                                            <div class="hover-info-row">
                                                                <span class="info-label">Target Cash:</span>
                                                                <span class="info-value text-success fw-bold">@(item.RequestedAmount?.ToString("N2") ?? "0.00") AED</span>
                                                            </div>
                                                            <div class="hover-info-row">
                                                                <span class="info-label">Request Type:</span>
                                                                <span class="info-value">@item.RequestType</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div>
                                                    <div class="client-name fw-bold text-dark">@item.ReferralName</div>
                                                    <small class="client-id text-muted" style="font-size: 10px;">ID: @item.ReferralID</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-rider">
                                            @if (item.RiderID.HasValue && item.RiderID > 0)
                                            {
                                                <div class="rider-chip profile-hover-trigger cursor-pointer" style="position: relative;">
                                                    <div style="display: contents;">
                                                        <img src="@GetRiderProfileImage(item.RiderID.Value)" 
                                                             class="rider-avatar border cursor-pointer" 
                                                             style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover;" 
                                                             onerror="this.src='/images/default-avatar.png'" />
                                                        
                                                        <!-- Premium Hover Card Popover -->
                                                        <div class="premium-hover-card">
                                                            <div class="hover-card-header">
                                                                <img src="@GetRiderProfileImage(item.RiderID.Value)" 
                                                                     class="hover-card-avatar" 
                                                                     onerror="this.src='/images/default-avatar.png'" />
                                                                <div class="hover-card-title-wrap">
                                                                    <div class="hover-card-name">@item.RiderName</div>
                                                                    <div class="hover-card-sub">Field Logistics Rider</div>
                                                                </div>
                                                            </div>
                                                            <div class="hover-card-body">
                                                                <div class="hover-info-row">
                                                                    <span class="info-label">Rider ID:</span>
                                                                    <span class="info-value">#@item.RiderID</span>
                                                                </div>
                                                                <div class="hover-info-row">
                                                                    <span class="info-label">Cash Collected:</span>
                                                                    <span class="info-value text-success fw-bold">@(item.CollectedAmount?.ToString("N2") ?? "0.00") AED</span>
                                                                </div>
                                                                <div class="hover-info-row">
                                                                    <span class="info-label">Containers:</span>
                                                                    <span class="info-value">@(item.ContainerCount?.ToString() ?? "0") Units</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <span>@item.RiderName</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-light text-danger fw-700 animate-pulse px-3 py-2 rounded-pill">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Unassigned
                                                </span>
                                            }
                                        </div>
                                        <div class="col-job">
                                            @if (item.RequestType == "PaymentCollection")
                                            {
                                                <span class="badge bg-success-light text-success fw-bold rounded-pill px-3 py-1">
                                                    <i class="bi bi-cash me-1"></i> Cash Collection
                                                </span>
                                                <small class="text-muted d-block mt-1">Target: @(item.RequestedAmount?.ToString("N0") ?? "0") AED</small>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info-light text-info fw-bold rounded-pill px-3 py-1">
                                                    <i class="bi bi-box-seam me-1"></i> Container
                                                </span>
                                            }
                                        </div>
                                        <div class="col-job">
                                            @if (item.Status == "Requested" || item.Status == "Assigned" || item.Status == "Accepted")
                                            {
                                                <span class="text-muted italic text-xs">Awaiting collection...</span>
                                            }
                                            else
                                            {
                                                @if (item.RequestType == "PaymentCollection")
                                                {
                                                    <div class="fw-700 text-success">Col: @(item.CollectedAmount?.ToString("N0") ?? "0") AED</div>
                                                    @if (item.ReferralConfirmedAmount.HasValue)
                                                    {
                                                        <div class="text-xs text-primary">Conf: @item.ReferralConfirmedAmount?.ToString("N0") AED</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="fw-700 text-info">@item.ContainerCount Containers</div>
                                                }
                                            }
                                        </div>
                                        <div class="col-status">
                                            <span class="badge @GetStatusBadgeClass(item.Status) rounded-pill px-3 py-2 fw-700">
                                                @item.Status
                                            </span>
                                        </div>
                                        <div class="col-ops">
                                            <div class="ops-actions d-flex align-items-center">
                                                <button type="button" class="btn btn-outline-secondary btn-xs rounded-pill px-3 fw-700 me-2" style="font-size: 10px; border-color: rgba(0,0,0,0.15);" @onclick="() => OpenTimelineModal(item)">
                                                    <i class="bi bi-clock-history me-1"></i> DETAILS
                                                </button>
                                                @if (item.Status == "Requested" || item.Status == "Assigned")
                                                {
                                                    <button type="button" class="btn btn-warning btn-xs rounded-pill px-3 fw-700" @onclick="() => OpenAssignModal(item)">
                                                        <i class="bi bi-person-plus-fill me-1"></i> ASSIGN
                                                    </button>
                                                }
                                                else if (item.Status == "ReferralConfirmed" || item.Status == "Collected" || item.Status == "Discrepancy" || item.Status == "Revisit")
                                                {
                                                    <button type="button" class="btn btn-success btn-xs rounded-pill px-3 fw-700" @onclick="() => OpenAuditModal(item)">
                                                        <i class="bi bi-shield-check me-1"></i> @(item.Status == "Discrepancy" || item.Status == "Revisit" ? "RESOLVE" : "AUDIT")
                                                    </button>
                                                }
                                                else if (item.Status == "Completed")
                                                {
                                                    @if (item.RequestType == "PaymentCollection")
                                                    {
                                                        <a href="@($"{apiurl}PaymentCollection/receipt/{item.RequestID}?TenantId={_tenantState.TenantID}")" target="_blank" class="btn btn-outline-primary btn-xs rounded-pill px-3 fw-700 me-2" style="font-size: 10px;">
                                                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> RECEIPT
                                                        </a>
                                                    }
                                                    @if (item.ResolutionType == "RiderAccountable")
                                                    {
                                                        @if (item.IsDeficitSettled == true)
                                                        {
                                                            <div class="d-flex flex-column align-items-end">
                                                                <span class="badge bg-success-light text-success fw-bold rounded-pill px-2 py-1 text-xs">
                                                                    <i class="bi bi-patch-check-fill me-1"></i> Deficit Settled
                                                                </span>
                                                                <small class="text-muted mt-1" style="font-size: 8px;">Recovered: @(Math.Abs(item.DiscrepancyAmount ?? 0).ToString("N2")) AED</small>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn btn-xs rounded-pill px-3 fw-700 animate-pulse text-white" style="background: #f59e0b; border: none; font-size: 10px;" @onclick="() => OpenSettleModal(item)">
                                                                <i class="bi bi-cash-coin me-1"></i> SETTLE DEFICIT
                                                            </button>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-success text-xs fw-bold">
                                                            <i class="bi bi-check-all fs-5 me-1"></i> Closed
                                                        </span>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Pagination Controls -->
                            @if (TotalPages > 1)
                            {
                                <div class="d-flex align-items-center justify-content-between p-3" style="background: rgba(255, 255, 255, 0.4); backdrop-filter: blur(5px); border-top: 1px solid rgba(0, 0, 0, 0.05); border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;">
                                    <div style="font-size: 11px; color: #64748b; font-weight: 600;">
                                        Showing <strong style="color: #0f172a;">@(((currentPage - 1) * pageSize) + 1)</strong> to <strong style="color: #0f172a;">@Math.Min(currentPage * pageSize, filteredRequests.Count)</strong> of <strong style="color: #0f172a;">@filteredRequests.Count</strong> requests
                                    </div>
                                    <nav>
                                        <ul class="pagination pagination-sm m-0 gap-1 border-0" style="background: transparent;">
                                            <li class="page-item @(currentPage == 1 ? "disabled" : "")" style="border: none;">
                                                <button class="page-link rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px; border: 1px solid rgba(0,0,0,0.08); background: #fff; color: #475569; transition: all 0.2s; cursor: pointer; outline: none;" @onclick="() => ChangePage(currentPage - 1)" disabled="@(currentPage == 1)">
                                                    <i class="bi bi-chevron-left" style="font-size: 10px;"></i>
                                                </button>
                                            </li>
                                            @for (int i = 1; i <= TotalPages; i++)
                                            {
                                                var pageNumber = i;
                                                <li class="page-item @(currentPage == pageNumber ? "active" : "")" style="border: none;">
                                                    <button class="page-link rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 30px; height: 30px; border: @(currentPage == pageNumber ? "none" : "1px solid rgba(0,0,0,0.08)"); font-size: 11px; transition: all 0.2s; cursor: pointer; outline: none; @(currentPage == pageNumber ? "background: #2563eb; color: #fff; box-shadow: 0 4px 10px rgba(37,99,235,0.25);" : "background: #fff; color: #475569;")" @onclick="() => ChangePage(pageNumber)">
                                                        @pageNumber
                                                    </button>
                                                </li>
                                            }
                                            <li class="page-item @(currentPage == TotalPages ? "disabled" : "")" style="border: none;">
                                                <button class="page-link rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px; border: 1px solid rgba(0,0,0,0.08); background: #fff; color: #475569; transition: all 0.2s; cursor: pointer; outline: none;" @onclick="() => ChangePage(currentPage + 1)" disabled="@(currentPage == TotalPages)">
                                                    <i class="bi bi-chevron-right" style="font-size: 10px;"></i>
                                                </button>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="bi bi-cash-stack"></i>
                                <h5>No active collection requests found</h5>
                                <p>Adjust your toolbar filters or refresh</p>
                            </div>
                        }
                    </div>
                </div>
            </section>

            <!-- Rider Accountability League Table -->
            <section class="row mt-4 mb-5 animate-slide-up">
                <div class="col-12">
                    <div class="premium-card p-4" style="background: rgba(255,255,255,0.7); backdrop-filter: blur(10px); border-radius:16px; border: 1px solid rgba(0,0,0,0.08);">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-people-fill text-primary me-2"></i> Rider Accountability League Table</h6>
                                <p class="text-muted text-xs mb-0">Summary of collection performance and cash reconciliation status within selected dates</p>
                            </div>
                            <span class="badge bg-primary-light text-primary rounded-pill px-3 py-2 fw-bold text-xs">
                                Period: @filterStartDate.ToString("dd MMM") - @filterEndDate.ToString("dd MMM yyyy")
                            </span>
                        </div>
                        
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                                <thead class="table-light text-secondary text-xs uppercase" style="border-radius: 8px;">
                                    <tr>
                                        <th class="cursor-pointer" @onclick='() => SortLeague("Name")'>
                                            Rider Name 
                                            @if (sortColumn == "Name") { <i class="bi @(isSortAscending ? "bi-chevron-up" : "bi-chevron-down") ms-1"></i> }
                                        </th>
                                        <th class="cursor-pointer text-end" @onclick='() => SortLeague("Collections")'>
                                            Total Collections (AED) 
                                            @if (sortColumn == "Collections") { <i class="bi @(isSortAscending ? "bi-chevron-up" : "bi-chevron-down") ms-1"></i> }
                                        </th>
                                        <th class="cursor-pointer text-end" @onclick='() => SortLeague("Discrepancies")'>
                                            Outstanding Discrepancies (AED) 
                                            @if (sortColumn == "Discrepancies") { <i class="bi @(isSortAscending ? "bi-chevron-up" : "bi-chevron-down") ms-1"></i> }
                                        </th>
                                        <th class="cursor-pointer text-end" @onclick='() => SortLeague("Recovery")'>
                                            Recovery % 
                                            @if (sortColumn == "Recovery") { <i class="bi @(isSortAscending ? "bi-chevron-up" : "bi-chevron-down") ms-1"></i> }
                                        </th>
                                        <th class="text-center">Status Badge</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var leagueRecords = GetRiderLeague();
                                    }
                                    @if (leagueRecords.Any())
                                    {
                                        @foreach (var record in leagueRecords)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <img src="@GetRiderProfileImage(record.RiderID)" 
                                                             class="rounded-circle border" 
                                                             style="width: 28px; height: 28px; object-fit: cover;" 
                                                             onerror="this.src='/images/default-avatar.png'" />
                                                        <div>
                                                            <div>@record.RiderName</div>
                                                            <small class="text-muted" style="font-size: 10px;">ID: #@record.RiderID</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-end fw-bold text-success">@record.TotalCollections.ToString("N2") AED</td>
                                                <td class="text-end fw-bold text-danger">@record.TotalDiscrepancies.ToString("N2") AED</td>
                                                <td class="text-end fw-bold">
                                                    @record.RecoveryPercentage.ToString("F1")%
                                                    <div class="progress mt-1 ms-auto" style="height: 4px; width: 100px;">
                                                        <div class="progress-bar @(record.RecoveryPercentage >= 90 ? "bg-success" : "bg-danger")" 
                                                             role="progressbar" 
                                                             style="width: @(record.RecoveryPercentage)%;" 
                                                             aria-valuenow="@((int)record.RecoveryPercentage)" 
                                                             aria-valuemin="0" 
                                                             aria-valuemax="100"></div>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    @if (record.RecoveryPercentage >= 90)
                                                    {
                                                        <span class="badge bg-success-light text-success rounded-pill px-3 py-2 fw-700">
                                                            <i class="bi bi-shield-check me-1"></i> Healthy (>=90%)
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger-light text-danger rounded-pill px-3 py-2 fw-700 animate-pulse">
                                                            <i class="bi bi-shield-exclamation me-1"></i> Attention Required (&lt;90%)
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">No rider performance records in this period.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

        </section>
    </section>

    @* ── Real-time Centered Toast ── *@
    @if (isPayToastVisible)
    {
        <div class="rt-toast-overlay">
            <div class="rt-toast rt-toast-@payToastType @(isPayToastFading ? "rt-toast-out" : "rt-toast-in")">
                <div class="rt-toast-content">
                    @if (!string.IsNullOrEmpty(payToastPhoto))
                    {
                        <img src="@payToastPhoto" class="rt-toast-avatar" onerror="this.src='/images/default-avatar.png'" />
                    }
                    else
                    {
                        <div class="rt-toast-icon-wrap">
                            <i class="bi @payToastIcon rt-toast-ico"></i>
                        </div>
                    }
                    <div class="rt-toast-text">
                        <div class="rt-toast-title">@payToastTitle</div>
                        <div class="rt-toast-msg">@payToastMessage</div>
                    </div>
                    <button type="button" class="rt-toast-close" @onclick="() => isPayToastVisible = false">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
                <!-- Animated Progress Bar -->
                <div class="rt-toast-progress-track">
                    <div class="rt-toast-progress-bar @(isPayToastFading ? "" : "active")"></div>
                </div>
            </div>
        </div>
    }

    <style>
        /* ── Unified Premium Top-Right Toast ── */
        .rt-toast-overlay {
            position: fixed;
            top: 24px;
            right: 24px;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            z-index: 99999;
            pointer-events: none;
            gap: 12px;
        }
        .rt-toast {
            pointer-events: auto;
            display: flex;
            flex-direction: column;
            border-radius: 12px;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: #fff;
            box-shadow: 0 10px 40px rgba(0,0,0,0.25), 0 0 0 1px rgba(255,255,255,0.02) inset;
            width: 360px;
            max-width: calc(100vw - 48px);
            overflow: hidden;
            position: relative;
        }
        .rt-toast-content {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px;
        }
        .rt-toast-in  { animation: rtSlideIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
        .rt-toast-out { animation: rtSlideOut 0.4s cubic-bezier(0.6, -0.28, 0.735, 0.045) forwards; }
        @@keyframes rtSlideIn  { 
            0% { opacity:0; transform: translateX(120%) scale(0.95); } 
            100% { opacity:1; transform: translateX(0) scale(1); } 
        }
        @@keyframes rtSlideOut { 
            0% { opacity:1; transform: translateX(0) scale(1); height: auto; margin-bottom: 0; }   
            100% { opacity:0; transform: translateX(120%) scale(0.95); height: 0; margin-bottom: -12px; overflow: hidden; padding: 0; border: none; } 
        }
        
        .rt-toast-success .rt-toast-icon-wrap { background: rgba(16, 185, 129, 0.15); color: #34d399; }
        .rt-toast-info .rt-toast-icon-wrap    { background: rgba(56, 189, 248, 0.15); color: #38bdf8; }
        .rt-toast-error .rt-toast-icon-wrap   { background: rgba(248, 113, 113, 0.15); color: #f87171; }
        
        .rt-toast-icon-wrap {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 20px;
        }
        .rt-toast-avatar  { width:38px; height:38px; border-radius:10px; object-fit:cover; flex-shrink:0; border: 2px solid rgba(255,255,255,0.1); }
        .rt-toast-text    { display:flex; flex-direction:column; gap:4px; flex-grow: 1; min-width: 0; }
        .rt-toast-title   { font-weight:700; font-size:14px; line-height:1.2; letter-spacing: 0.3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .rt-toast-msg     { font-size:12.5px; color: #94a3b8; line-height:1.4; font-weight: 500; }
        
        .rt-toast-close {
            background: none;
            border: none;
            color: #64748b;
            font-size: 20px;
            cursor: pointer;
            padding: 4px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            margin-left: auto;
            align-self: flex-start;
        }
        .rt-toast-close:hover { color: #fff; background: rgba(255,255,255,0.1); }
        
        .rt-toast-progress-track {
            height: 3px;
            width: 100%;
            background: rgba(255,255,255,0.05);
            position: absolute;
            bottom: 0;
            left: 0;
        }
        .rt-toast-progress-bar {
            height: 100%;
            width: 100%;
            border-radius: 0 4px 4px 0;
            transform-origin: left;
        }
        .rt-toast-success .rt-toast-progress-bar { background: #34d399; }
        .rt-toast-info .rt-toast-progress-bar    { background: #38bdf8; }
        .rt-toast-error .rt-toast-progress-bar   { background: #f87171; }
        
        .rt-toast-progress-bar.active {
            animation: rtProgress 4.5s linear forwards;
        }
        @@keyframes rtProgress {
            from { transform: scaleX(1); }
            to { transform: scaleX(0); }
        }

        /* ── Funnel and Trend Visuals ── */
        .funnel-flex {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            width: 100%;
        }
        .funnel-stage {
            flex: 1;
            background: linear-gradient(135deg, rgba(37, 99, 235, 0.05) 0%, rgba(37, 99, 235, 0.01) 100%);
            border: 1px solid rgba(37, 99, 235, 0.1);
            border-radius: 12px;
            padding: 10px 8px;
            text-align: center;
            position: relative;
            transition: all 0.3s ease;
        }
        .funnel-stage:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.05);
            border-color: rgba(37, 99, 235, 0.3);
        }
        .funnel-stage.active {
            background: linear-gradient(135deg, rgba(34, 197, 94, 0.05) 0%, rgba(34, 197, 94, 0.01) 100%);
            border-color: rgba(34, 197, 94, 0.15);
        }
        .funnel-arrow {
            color: #94a3b8;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .stage-name {
            font-size: 11px;
            font-weight: 700;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .stage-val {
            font-size: 20px;
            font-weight: 800;
            color: #0f172a;
            margin: 4px 0;
        }
        .stage-pct {
            font-size: 10px;
            font-weight: 700;
            color: #2563eb;
            background: rgba(37, 99, 235, 0.08);
            padding: 2px 6px;
            border-radius: 10px;
            display: inline-block;
        }
        .funnel-stage.active .stage-pct {
            color: #16a34a;
            background: rgba(34, 197, 94, 0.08);
        }
        .stage-sub {
            font-size: 9px;
            color: #64748b;
            margin-top: 2px;
            font-weight: 500;
        }
        .trend-metric-title {
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }
        .trend-current-val {
            font-size: 20px;
            font-weight: 800;
            color: #0f172a;
        }
        .trend-badge {
            font-size: 11px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
        }
        .trend-badge.positive {
            background: rgba(34, 197, 94, 0.1);
            color: #16a34a;
        }
        .trend-badge.negative {
            background: rgba(239, 68, 68, 0.1);
            color: #dc2626;
        }
        .trend-badge.positive-good {
            background: rgba(34, 197, 94, 0.1);
            color: #16a34a;
        }
        .trend-badge.negative-bad {
            background: rgba(239, 68, 68, 0.1);
            color: #dc2626;
        }
        .trend-sub-label {
            font-size: 10px;
            color: #64748b;
            margin-top: 4px;
        }
    </style>

    <!-- Modal 1: Assign Rider Dialog -->
    <SfDialog Width="500px" IsModal=true ShowCloseIcon=false Visible="@isAssignModalOpen">
        <DialogTemplates>
            <Header>
                <div class="d-flex align-items-center justify-content-between w-100">
                    <span style="font-weight:700;font-size:15px;color:#0f172a;">Manual Dispatch - Request #@selectedRequest?.RequestID</span>
                    <button type="button" @onclick="CloseModals" class="dlg-close-btn"><i class="bi bi-x-lg"></i></button>
                </div>
            </Header>
            <Content>
                <div class="p-3">
                    <p class="text-muted text-xs mb-3">Select a Rider from active fleet to manually dispatch this payment/container collection request.</p>
                    
                    <div class="mb-4">
                        <label class="form-label text-xs fw-bold">Select Active Rider</label>
                        <SfComboBox DataSource="@fleetRiders" TValue="int?" Placeholder="Choose Rider" AllowFiltering=true TItem="Rider_Master" @bind-Value="@targetRiderId">
                            <ComboBoxFieldSettings Text="Name" Value="RiderID"></ComboBoxFieldSettings>
                        </SfComboBox>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light btn-sm rounded-pill px-3" @onclick="CloseModals">Cancel</button>
                        <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-700" @onclick="SubmitAssignAsync">
                            <i class="bi bi-check-circle me-1"></i> DISPATCH
                        </button>
                    </div>
                </div>
            </Content>
        </DialogTemplates>
        <DialogEvents OnClose="CloseModals"></DialogEvents>
    </SfDialog>

    <!-- Modal 2: Final Lab Audit Dialog -->
    <SfDialog Width="500px" IsModal=true ShowCloseIcon=false Visible="@isAuditModalOpen">
        <DialogTemplates>
            <Header>
                <div class="d-flex align-items-center justify-content-between w-100">
                    <span style="font-weight:700;font-size:15px;color:#0f172a;">Lab Verification & Reconciliation - Request #@(selectedRequest?.RequestID)</span>
                    <button type="button" @onclick="CloseModals" class="dlg-close-btn"><i class="bi bi-x-lg"></i></button>
                </div>
            </Header>
            <Content>
                <div class="p-3">
                    <div class="alert alert-info border-0 rounded-4 p-3 mb-3 shadow-sm" style="background: rgba(59, 130, 246, 0.05); border: 1px solid rgba(59, 130, 246, 0.15) !important;">
                        <div class="fw-bold mb-3 text-primary d-flex align-items-center gap-2" style="font-size: 15px;">
                            <i class="bi bi-shield-check"></i> Audit Comparison Summary
                        </div>
                        
                        <div class="d-flex flex-column gap-2 text-xs">
                            <!-- Request ID -->
                            <div class="d-flex justify-content-between py-1 border-bottom border-light">
                                <span class="text-muted">Request ID:</span>
                                <span class="fw-bold text-primary">#@(selectedRequest?.RequestID)</span>
                            </div>
                            
                            <!-- Client Info -->
                            <div class="d-flex justify-content-between py-1 border-bottom border-light">
                                <span class="text-muted">Client / Referral:</span>
                                <span class="fw-bold text-dark">
                                    @(selectedRequest?.ReferralName ?? "Unknown") (ID: @(selectedRequest?.ReferralID))
                                </span>
                            </div>

                            <!-- Rider Info -->
                            <div class="d-flex justify-content-between py-1 border-bottom border-light">
                                <span class="text-muted">Assigned Rider:</span>
                                <span class="fw-bold text-dark">
                                    @if (selectedRequest?.RiderID.HasValue == true)
                                    {
                                        @($"{selectedRequest.RiderName ?? "Rider"} (ID: {selectedRequest.RiderID})")
                                    }
                                    else
                                    {
                                        <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Unassigned</span>
                                    }
                                </span>
                            </div>

                            <!-- Type Info -->
                            <div class="d-flex justify-content-between py-1 border-bottom border-light">
                                <span class="text-muted">Collection Type:</span>
                                <span class="fw-bold text-dark">
                                    @(selectedRequest?.RequestType == "EmptyContainer" ? "📦 Empty Container Pickup" : "💵 Cash Collection")
                                </span>
                            </div>

                            @if (selectedRequest?.RequestType == "EmptyContainer")
                            {
                                <!-- Container Count comparison -->
                                <div class="d-flex justify-content-between py-1 border-bottom border-light">
                                    <span class="text-muted">Rider Collected:</span>
                                    <span class="fw-bold text-info">
                                        @(selectedRequest?.ContainerCount.HasValue == true ? $"{selectedRequest.ContainerCount} Containers" : "Pending collection...")
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between py-1 border-bottom border-light">
                                    <span class="text-muted">Client Confirmation:</span>
                                    <span class="fw-bold">
                                        @if (selectedRequest?.Status == "ReferralConfirmed" || selectedRequest?.Status == "Completed" || selectedRequest?.Status == "Discrepancy" || selectedRequest?.Status == "Revisit")
                                        {
                                             <span class="text-success"><i class="bi bi-patch-check-fill me-1"></i> Handover Confirmed</span>
                                        }
                                        else
                                        {
                                             <span class="text-warning"><i class="bi bi-clock-history me-1"></i> Pending Client...</span>
                                        }
                                    </span>
                                </div>
                            }
                            else
                            {
                                <!-- Cash Amounts comparison -->
                                <div class="d-flex justify-content-between py-1 border-bottom border-light">
                                    <span class="text-muted">Target Amount (Requested):</span>
                                    <span class="fw-bold text-dark">@(selectedRequest?.RequestedAmount?.ToString("N2") ?? "0.00") AED</span>
                                </div>
                                <div class="d-flex justify-content-between py-1 border-bottom border-light">
                                    <span class="text-muted">Rider Collected Amount:</span>
                                    <span class="fw-bold text-info">
                                        @(selectedRequest?.CollectedAmount.HasValue == true ? $"{selectedRequest.CollectedAmount?.ToString("N2")} AED" : "Pending Rider collection...")
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between py-1 border-bottom border-light">
                                    <span class="text-muted">Client Confirmed Amount:</span>
                                    <span class="fw-bold text-success">
                                        @if (selectedRequest?.ReferralConfirmedAmount.HasValue == true)
                                        {
                                            @($"{selectedRequest.ReferralConfirmedAmount?.ToString("N2")} AED")
                                        }
                                        else if (selectedRequest?.Status == "ReferralConfirmed" || selectedRequest?.Status == "Completed")
                                        {
                                            @($"{((selectedRequest.CollectedAmount ?? selectedRequest.RequestedAmount) ?? 0).ToString("N2")} AED")
                                        }
                                        else
                                        {
                                            <span>Pending Client confirmation...</span>
                                        }
                                    </span>
                                </div>

                                @if (selectedRequest?.CollectedAmount.HasValue == true && selectedRequest?.ReferralConfirmedAmount.HasValue == true)
                                {
                                    @if (selectedRequest.CollectedAmount != selectedRequest.ReferralConfirmedAmount)
                                    {
                                        <div class="mt-3 p-2 rounded text-danger fw-bold d-flex align-items-center gap-2 justify-content-center text-center animate-pulse" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); font-size: 11px;">
                                            <i class="bi bi-exclamation-triangle-fill"></i> Discrepancy: Mismatch of @(Math.Abs((selectedRequest.CollectedAmount ?? 0) - (selectedRequest.ReferralConfirmedAmount ?? 0)).ToString("N2")) AED detected!
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-3 p-2 rounded text-success fw-bold d-flex align-items-center gap-2 justify-content-center text-center" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); font-size: 11px;">
                                            <i class="bi bi-patch-check-fill"></i> Amounts Match Perfect (No Discrepancy)
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>

                    @if (selectedRequest?.RequestType == "EmptyContainer" && selectedRequest?.Status != "ReferralConfirmed" && selectedRequest?.Status != "Completed")
                    {
                        <div class="mb-3 p-3 rounded-4" style="background: rgba(16, 185, 129, 0.05); border: 1px dashed rgba(16, 185, 129, 0.25);">
                            <label class="d-flex align-items-center gap-2 text-xs fw-bold text-success pointer m-0">
                                <input type="checkbox" @bind="forceEqualizeAndResolve" style="width: 16px; height: 16px; accent-color: #10b981;" />
                                <span>Force Approve & Close (Confirm receipt without waiting for client's app confirmation)</span>
                            </label>
                        </div>
                    }
                    else if (selectedRequest?.RequestType != "EmptyContainer" && (selectedRequest?.Status == "Discrepancy" || selectedRequest?.Status == "Revisit" || (selectedRequest?.CollectedAmount.HasValue == true && selectedRequest?.ReferralConfirmedAmount.HasValue == true && selectedRequest.CollectedAmount != selectedRequest.ReferralConfirmedAmount) || selectedRequest?.ReferralConfirmedAmount.HasValue == false))
                    {
                        <div class="mb-3 p-3 rounded-4" style="background: rgba(16, 185, 129, 0.05); border: 1px dashed rgba(16, 185, 129, 0.25);">
                            <label class="d-flex align-items-center gap-2 text-xs fw-bold text-success pointer m-0">
                                <input type="checkbox" @bind="forceEqualizeAndResolve" style="width: 16px; height: 16px; accent-color: #10b981;" />
                                <span>Force Resolve & Complete (Equalize confirmed amount to match Rider Collected Amount)</span>
                            </label>
                        </div>
                    }

                    @if (selectedRequest?.RequestType != "EmptyContainer" && selectedRequest?.CollectedAmount != selectedRequest?.ReferralConfirmedAmount && !forceEqualizeAndResolve)
                    {
                        <div class="mb-3 p-3 rounded-4" style="background: rgba(245, 158, 11, 0.05); border: 1px solid rgba(245, 158, 11, 0.2); box-shadow: 0 4px 12px rgba(245, 158, 11, 0.03);">
                            <div class="d-flex align-items-center gap-2 mb-2 text-warning fw-bold text-xs">
                                <i class="bi bi-shield-fill-exclamation fs-6"></i>
                                <span>CASH DISCREPANCY RESOLUTION WORKFLOW</span>
                            </div>
                            <p class="text-muted mb-3" style="font-size: 11px;">
                                A cash collection mismatch of <strong>@(Math.Abs((selectedRequest.CollectedAmount ?? 0) - (selectedRequest.ReferralConfirmedAmount ?? 0)).ToString("N2")) AED</strong> exists. Please select the accountability action below:
                            </p>
                            
                            <div class="d-flex flex-column gap-2">
                                <label class="d-flex align-items-center gap-2 p-2 rounded border border-light text-xs pointer bg-white" style="transition: all 0.2s;">
                                    <input type="radio" name="discResolution" checked="@(discrepancyResolution == "RiderAccountable")" @onclick='() => discrepancyResolution = "RiderAccountable"' />
                                    <div>
                                        <span class="fw-bold text-dark d-block">Hold Rider Accountable (Ledger Deficit)</span>
                                        <span class="text-muted d-block" style="font-size: 10px;">Charge the missing amount to the Rider's deficit balance.</span>
                                    </div>
                                </label>
                                
                                <label class="d-flex align-items-center gap-2 p-2 rounded border border-light text-xs pointer bg-white" style="transition: all 0.2s;">
                                    <input type="radio" name="discResolution" checked="@(discrepancyResolution == "ClientAccepted")" @onclick='() => discrepancyResolution = "ClientAccepted"' />
                                    <div>
                                        <span class="fw-bold text-dark d-block">Accept Client Claim (Equalize Cash)</span>
                                        <span class="text-muted d-block" style="font-size: 10px;">Equalize the records by accepting the client's claimed amount.</span>
                                    </div>
                                </label>
                                
                                <label class="d-flex align-items-center gap-2 p-2 rounded border border-light text-xs pointer bg-white" style="transition: all 0.2s;">
                                    <input type="radio" name="discResolution" checked="@(discrepancyResolution == "WriteOff")" @onclick='() => discrepancyResolution = "WriteOff"' />
                                    <div>
                                        <span class="fw-bold text-dark d-block">Company Write-Off (Absorb Deficit)</span>
                                        <span class="text-muted d-block" style="font-size: 10px;">Close the request and absorb the cash difference as an operational expense.</span>
                                    </div>
                                </label>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label text-xs fw-bold">Verification Decision</label>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="d-flex align-items-center gap-2 text-sm pointer">
                                <input type="radio" name="isReceived" checked="@(isReceivedByLab == true && !isRejectResetDecision)" @onclick="() => { isReceivedByLab = true; isRejectResetDecision = false; }" />
                                @(selectedRequest?.RequestType == "EmptyContainer" ? "Containers Received by Lab" : "Amount Received by Lab")
                            </label>
                            <label class="d-flex align-items-center gap-2 text-sm pointer">
                                <input type="radio" name="isReceived" checked="@(isReceivedByLab == false && !isRejectResetDecision)" @onclick="() => { isReceivedByLab = false; isRejectResetDecision = false; }" />
                                Not Received / Discrepancy
                            </label>
                            <label class="d-flex align-items-center gap-2 text-sm pointer text-danger fw-600">
                                <input type="radio" name="isReceived" checked="@(isRejectResetDecision)" @onclick="() => { isReceivedByLab = false; isRejectResetDecision = true; }" />
                                <i class="bi bi-arrow-counterclockwise"></i> Reject & Reset Rider
                            </label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-xs fw-bold">Audit Notes / Narration</label>
                        <textarea class="form-control rounded-4 text-sm" rows="3" placeholder="Enter reconciliation notes..." @bind="adminNotes"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light btn-sm rounded-pill px-3" @onclick="CloseModals">Cancel</button>
                        
                        @if (isRejectResetDecision)
                        {
                            <button type="button" class="btn btn-danger btn-sm rounded-pill px-4 fw-700" @onclick="SubmitRejectResetAsync">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> REJECT & RESET REQUEST
                            </button>
                        }
                        else
                        {
                            var canApprove = (selectedRequest?.Status == "ReferralConfirmed" || selectedRequest?.Status == "Completed" || selectedRequest?.Status == "Discrepancy" || selectedRequest?.Status == "Revisit" || forceEqualizeAndResolve);
                            <button type="button" class="btn btn-success btn-sm rounded-pill px-4 fw-700" disabled="@(!canApprove)" @onclick="SubmitAuditAsync">
                                <i class="bi bi-shield-check me-1"></i> APPROVE & CLOSE
                            </button>
                        }
                    </div>
                </div>
            </Content>
        </DialogTemplates>
        <DialogEvents OnClose="CloseModals"></DialogEvents>
    </SfDialog>

    <!-- Beautiful Premium Lifecycle Timeline Modal -->
    <SfDialog Width="550px" IsModal="true" ShowCloseIcon="false" Visible="@isTimelineModalOpen" ZIndex="999">
        <DialogTemplates>
            <Header>
                <div class="d-flex align-items-center justify-content-between w-100">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history text-primary fs-4"></i>
                        <div>
                            <div class="fw-800 text-dark" style="font-size: 16px;">Request Lifecycle History</div>
                            <div class="text-xs text-muted">Tracking & audit timeline for request #@(timelineRequest?.RequestID)</div>
                        </div>
                    </div>
                    <button type="button" @onclick="CloseTimelineModal" class="dlg-close-btn"><i class="bi bi-x-lg"></i></button>
                </div>
            </Header>
            <Content>
                @if (timelineRequest != null)
                {
                    <div class="p-3">
                        <!-- Request Metadata Card -->
                        <div class="mb-4 p-3 rounded-4 bg-light border border-light-dark" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);">
                            <div class="row g-2 text-xs">
                                <div class="col-6">
                                    <span class="text-muted d-block">Client / Referral:</span>
                                    <span class="fw-bold text-dark fs-6">@(timelineRequest.ReferralName ?? "N/A")</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted d-block">Assigned Rider:</span>
                                    <span class="fw-bold text-dark fs-6">@(timelineRequest.RiderName ?? "Unassigned")</span>
                                </div>
                                <div class="col-6 mt-2">
                                    @if (timelineRequest.RequestType == "EmptyContainer")
                                    {
                                        <span class="text-muted d-block">Collection Type:</span>
                                        <span class="badge bg-info text-white fw-bold">Empty Container Pickup</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted d-block">Target Amount:</span>
                                        <span class="fw-bold text-primary fs-6">@(timelineRequest.RequestedAmount?.ToString("N2") ?? "0.00") AED</span>
                                    }
                                </div>
                                <div class="col-6 mt-2">
                                    <span class="text-muted d-block">Current Status:</span>
                                    <span class="badge @(GetStatusBadgeClass(timelineRequest.Status))">@timelineRequest.Status</span>
                                </div>
                            </div>
                        </div>

                        <!-- Beautiful Vertical Timeline -->
                        <div class="lifecycle-timeline ps-3" style="border-left: 2px solid #e2e8f0; position: relative;">
                            
                            <!-- Step 1: Raised -->
                            <div class="timeline-item mb-4" style="position: relative;">
                                <div class="timeline-marker bg-warning" style="width: 14px; height: 14px; border-radius: 50%; position: absolute; left: -21px; top: 4px; border: 3px solid #fff; box-shadow: 0 0 0 2px #f59e0b;"></div>
                                <div class="timeline-details">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-dark text-sm">Step 1: Request Raised</span>
                                        <span class="text-muted text-xs">@timelineRequest.EnteredDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                                    </div>
                                    @if (timelineRequest.RequestType == "EmptyContainer")
                                    {
                                        <p class="text-muted text-xs m-0 mt-1">Empty container pickup request was raised by @(timelineRequest.ReferralName ?? "Client").</p>
                                    }
                                    else
                                    {
                                        <p class="text-muted text-xs m-0 mt-1">Payment request of <strong>@(timelineRequest.RequestedAmount?.ToString("N2")) AED</strong> was raised by @(timelineRequest.ReferralName ?? "Client").</p>
                                    }
                                </div>
                            </div>

                            <!-- Step 2: Assigned / Accepted -->
                            <div class="timeline-item mb-4" style="position: relative;">
                                @if (timelineRequest.AcceptedTime.HasValue || timelineRequest.CollectedTime.HasValue || timelineRequest.Status == "Collected" || timelineRequest.Status == "ReferralConfirmed" || timelineRequest.Status == "Completed" || timelineRequest.Status == "Discrepancy" || timelineRequest.Status == "Revisit")
                                {
                                    var displayTime = timelineRequest.AcceptedTime ?? timelineRequest.CollectedTime ?? timelineRequest.EnteredDate;
                                    <div class="timeline-marker bg-info" style="width: 14px; height: 14px; border-radius: 50%; position: absolute; left: -21px; top: 4px; border: 3px solid #fff; box-shadow: 0 0 0 2px #0ea5e9;"></div>
                                    <div class="timeline-details">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold text-dark text-sm">Step 2: Rider Assigned</span>
                                            <span class="text-muted text-xs">@displayTime.ToString("dd MMM yyyy, hh:mm tt")</span>
                                        </div>
                                        <p class="text-muted text-xs m-0 mt-1">Request was accepted and assigned to Rider <strong>@(timelineRequest.RiderName ?? "Rider")</strong>.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="timeline-marker bg-secondary" style="width: 14px; height: 14px; border-radius: 50%; position: absolute; left: -21px; top: 4px; border: 3px solid #fff; box-shadow: 0 0 0 2px #94a3b8;"></div>
                                    <div class="timeline-details opacity-50">
                                        <span class="fw-bold text-secondary text-sm">Step 2: Rider Assigned</span>
                                        <p class="text-muted text-xs m-0 mt-1">Pending rider acceptance.</p>
                                    </div>
                                }
                            </div>

                            <!-- Step 3: Collected -->
                            <div class="timeline-item mb-4" style="position: relative;">
                                @if (timelineRequest.CollectedTime.HasValue)
                                {
                                    <div class="timeline-marker bg-indigo" style="width: 14px; height: 14px; border-radius: 50%; position: absolute; left: -21px; top: 4px; border: 3px solid #fff; box-shadow: 0 0 0 2px #6366f1;"></div>
                                    <div class="timeline-details">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold text-dark text-sm">@(timelineRequest.RequestType == "EmptyContainer" ? "Step 3: Containers Collected" : "Step 3: Cash Collected")</span>
                                            <span class="text-muted text-xs">@timelineRequest.CollectedTime.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                                        </div>
                                        @if (timelineRequest.RequestType == "EmptyContainer")
                                        {
                                            <p class="text-muted text-xs m-0 mt-1">
                                                Rider collected <strong>@(timelineRequest.ContainerCount ?? 0) Containers</strong>.
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="text-muted text-xs m-0 mt-1">
                                                Rider collected <strong>@(timelineRequest.CollectedAmount?.ToString("N2")) AED</strong>.
                                                <span class="d-block mt-1 text-xs">
                                                    <i class="bi bi-wallet2 text-primary me-1"></i> Payment Mode: 
                                                    <span class="badge bg-primary text-white fw-bold">@(timelineRequest.PaymentMode ?? "CASH")</span>
                                                </span>
                                            </p>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="timeline-marker bg-secondary" style="width: 14px; height: 14px; border-radius: 50%; position: absolute; left: -21px; top: 4px; border: 3px solid #fff; box-shadow: 0 0 0 2px #94a3b8;"></div>
                                    <div class="timeline-details opacity-50">
                                        <span class="fw-bold text-secondary text-sm">@(timelineRequest.RequestType == "EmptyContainer" ? "Step 3: Containers Collected" : "Step 3: Cash Collected")</span>
                                        <p class="text-muted text-xs m-0 mt-1">@(timelineRequest.RequestType == "EmptyContainer" ? "Awaiting empty containers collection." : "Awaiting rider cash collection.")</p>
                                    </div>
                                }
                            </div>

                            <!-- Step 4: Client Confirmed -->
                            <div class="timeline-item mb-4" style="position: relative;">
                                 @if (timelineRequest.ReferralConfirmedTime.HasValue || timelineRequest.Status == "ReferralConfirmed" || timelineRequest.Status == "Completed" || timelineRequest.Status == "Discrepancy" || timelineRequest.Status == "Revisit")
                                 {
                                     var displayTime = timelineRequest.ReferralConfirmedTime ?? timelineRequest.AdminActionTime ?? timelineRequest.CollectedTime ?? timelineRequest.EnteredDate;
                                     <div class="timeline-marker bg-success" style="width: 14px; height: 14px; border-radius: 50%; position: absolute; left: -21px; top: 4px; border: 3px solid #fff; box-shadow: 0 0 0 2px #10b981;"></div>
                                     <div class="timeline-details">
                                         <div class="d-flex justify-content-between align-items-center">
                                             <span class="fw-bold text-dark text-sm">Step 4: Client Confirmed</span>
                                             <span class="text-muted text-xs">@displayTime.ToString("dd MMM yyyy, hh:mm tt")</span>
                                         </div>
                                         @if (timelineRequest.RequestType == "EmptyContainer")
                                         {
                                             <p class="text-muted text-xs m-0 mt-1">Client confirmed hand-over of empty containers.</p>
                                         }
                                         else
                                         {
                                             var confAmt = timelineRequest.ReferralConfirmedAmount ?? timelineRequest.CollectedAmount ?? timelineRequest.RequestedAmount;
                                             <p class="text-muted text-xs m-0 mt-1">Client confirmed payment hand-over of <strong>@(confAmt?.ToString("N2")) AED</strong>.</p>
                                         }
                                     </div>
                                 }
                                 else
                                 {
                                     <div class="timeline-marker bg-secondary" style="width: 14px; height: 14px; border-radius: 50%; position: absolute; left: -21px; top: 4px; border: 3px solid #fff; box-shadow: 0 0 0 2px #94a3b8;"></div>
                                     <div class="timeline-details opacity-50">
                                         <span class="fw-bold text-secondary text-sm">Step 4: Client Confirmed</span>
                                         <p class="text-muted text-xs m-0 mt-1">Awaiting client confirmation.</p>
                                     </div>
                                 }
                             </div>

                            <!-- Step 5: Audited / Closed -->
                            <div class="timeline-item" style="position: relative;">
                                @if (timelineRequest.AdminActionTime.HasValue)
                                {
                                    <div class="timeline-marker bg-success" style="width: 14px; height: 14px; border-radius: 50%; position: absolute; left: -21px; top: 4px; border: 3px solid #fff; box-shadow: 0 0 0 2px #10b981;"></div>
                                    <div class="timeline-details">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold text-dark text-sm">Step 5: Lab Reconciled & Closed</span>
                                            <span class="text-muted text-xs">@timelineRequest.AdminActionTime.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                                        </div>
                                        <p class="text-muted text-xs m-0 mt-1">
                                            Job reconciled and approved by Lab Admin.
                                            @if (!string.IsNullOrEmpty(timelineRequest.AdminNotes))
                                            {
                                                <span class="d-block mt-2 p-2 rounded bg-light border text-xs italic text-dark" style="background-color: #f8fafc;">
                                                    <strong>Admin Notes:</strong> @timelineRequest.AdminNotes
                                                </span>
                                            }
                                            @if (timelineRequest.RequestType == "PaymentCollection")
                                            {
                                                <div class="mt-3">
                                                    <a href="@($"{apiurl}PaymentCollection/receipt/{timelineRequest.RequestID}?TenantId={_tenantState.TenantID}")" target="_blank" class="btn btn-primary btn-xs rounded-pill px-3 text-white fw-bold">
                                                        <i class="bi bi-file-earmark-pdf-fill me-1"></i> Download PDF Receipt
                                                    </a>
                                                </div>
                                            }
                                        </p>
                                    </div>
                                }
                                else
                                {
                                    <div class="timeline-marker bg-secondary" style="width: 14px; height: 14px; border-radius: 50%; position: absolute; left: -21px; top: 4px; border: 3px solid #fff; box-shadow: 0 0 0 2px #94a3b8;"></div>
                                    <div class="timeline-details opacity-50">
                                        <span class="fw-bold text-secondary text-sm">Step 5: Lab Reconciled & Closed</span>
                                        <p class="text-muted text-xs m-0 mt-1">Awaiting final lab audit verification.</p>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                }
            </Content>
            <FooterTemplate>
                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-light rounded-pill px-4 py-2 text-sm fw-bold border border-light-dark" style="background: #ffffff; color: #475569; transition: all 0.2s;" @onclick="CloseTimelineModal">
                        <i class="bi bi-x-circle me-1"></i> Close Window
                    </button>
                </div>
            </FooterTemplate>
        </DialogTemplates>
        <DialogEvents OnClose="CloseTimelineModal"></DialogEvents>
    </SfDialog>

    <!-- Rider accountable deficit settlement dialog -->
    <SfDialog Width="500px" IsModal="true" ShowCloseIcon="false" Visible="@isSettleModalOpen" ZIndex="999">
        <DialogTemplates>
            <Header>
                <div class="d-flex align-items-center justify-content-between w-100">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-cash-coin text-warning fs-4"></i>
                        <div>
                            <div class="fw-800 text-dark" style="font-size: 16px;">Settle Rider Accountable Deficit</div>
                            <div class="text-xs text-muted">Recover cash mismatch for request #@(settleRequest?.RequestID)</div>
                        </div>
                    </div>
                    <button type="button" @onclick="CloseModals" class="dlg-close-btn"><i class="bi bi-x-lg"></i></button>
                </div>
            </Header>
            <Content>
                @if (settleRequest != null)
                {
                    <div class="p-3">
                        <div class="mb-4 p-3 rounded-4 bg-light border border-light-dark" style="background: linear-gradient(135deg, #fffbf2 0%, #fffbeb 100%); border-color: rgba(245, 158, 11, 0.2) !important;">
                            <div class="row g-2 text-xs">
                                <div class="col-6">
                                    <span class="text-muted d-block">Client / Referral:</span>
                                    <span class="fw-bold text-dark fs-6">@(settleRequest.ReferralName ?? "N/A")</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted d-block">Held Rider Accountable:</span>
                                    <span class="fw-bold text-dark fs-6 text-danger">@(settleRequest.RiderName ?? "Unknown")</span>
                                </div>
                                <div class="col-12 mt-2 pt-2 border-top border-light-dark">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted d-block">Discrepancy Deficit Amount:</span>
                                            <span class="fw-extrabold text-danger fs-5">@(Math.Abs(settleRequest.DiscrepancyAmount ?? 0).ToString("N2")) AED</span>
                                        </div>
                                        <div>
                                            <span class="text-muted d-block">Total Collected cash:</span>
                                            <span class="fw-bold text-success fs-6">@(settleRequest.CollectedAmount?.ToString("N2")) AED</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-xs fw-bold text-dark">Deficit Recovery Notes / Narration</label>
                            <textarea class="form-control rounded-4 text-sm" rows="3" placeholder="Explain recovery method (e.g. cash paid in office, salary deduction etc)..." @bind="settlementNotes"></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-light btn-sm rounded-pill px-3" @onclick="CloseModals">Cancel</button>
                            <button type="button" class="btn btn-warning btn-sm rounded-pill px-4 fw-700 text-white" style="background: #f59e0b; border: none;" @onclick="SubmitSettlementAsync">
                                <i class="bi bi-check2-all me-1"></i> CONFIRM RECOVERY & SETTLE
                            </button>
                        </div>
                    </div>
                }
            </Content>
        </DialogTemplates>
        <DialogEvents OnClose="CloseModals"></DialogEvents>
    </SfDialog>

