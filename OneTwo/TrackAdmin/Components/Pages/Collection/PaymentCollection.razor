    private List<Rider_Master> fleetRiders = new();

    // Dialog controllers
    private bool isAssignModalOpen = false;
    private bool isAuditModalOpen = false;
    private PaymentCollectionRequest selectedRequest;
    private int? targetRiderId;
    
    private bool isReceivedByLab = true;
    private bool isRejectResetDecision = false;
