@code {
    // League Table Sorting properties
    private string sortColumn = "Collections";
    private bool isSortAscending = false;

    private void SortLeague(string columnName)
    {
        if (sortColumn == columnName)
        {
            isSortAscending = !isSortAscending;
        }
        else
        {
            sortColumn = columnName;
            isSortAscending = false;
        }
    }

    public class RiderLeagueRecord
    {
        public int RiderID { get; set; }
        public string RiderName { get; set; }
        public decimal TotalCollections { get; set; }
        public decimal TotalDiscrepancies { get; set; }
        public decimal TotalExpected { get; set; }
        public decimal SettledDeficits { get; set; }
        
        public decimal RecoveryPercentage
        {
            get
            {
                if (TotalExpected <= 0) return 100;
                return Math.Min(100, Math.Max(0, ((TotalCollections + SettledDeficits) / TotalExpected) * 100));
            }
        }
    }

    private List<RiderLeagueRecord> GetRiderLeague()
    {
        var league = new List<RiderLeagueRecord>();
        
        var periodRequests = requests
            .Where(x => x.RiderID.HasValue && x.RiderID.Value > 0 &&
                        x.EnteredDate.Date >= filterStartDate.Date &&
                        x.EnteredDate.Date <= filterEndDate.Date)
            .ToList();
            
        var grouped = periodRequests.GroupBy(x => x.RiderID.Value);
        
        foreach (var g in grouped)
        {
            int riderId = g.Key;
            string riderName = fleetRiders.FirstOrDefault(r => r.RiderID == riderId)?.Name 
                               ?? g.FirstOrDefault()?.RiderName 
                               ?? $"Rider #{riderId}";
            
            decimal totalCollections = g
                .Where(x => x.Status == "Collected" || x.Status == "ReferralConfirmed" || x.Status == "Completed")
                .Sum(x => x.CollectedAmount ?? 0);
                
            decimal totalDiscrepancies = g
                .Where(x => x.Status == "Completed" && x.ResolutionType == "RiderAccountable" && x.IsDeficitSettled != true)
                .Sum(x => x.DiscrepancyAmount ?? 0);
                
            decimal settledDeficits = g
                .Where(x => x.Status == "Completed" && x.ResolutionType == "RiderAccountable" && x.IsDeficitSettled == true)
                .Sum(x => x.DiscrepancyAmount ?? 0);
                
            decimal totalExpected = g
                .Sum(x => x.ReferralConfirmedAmount ?? x.CollectedAmount ?? x.RequestedAmount ?? 0);
                
            league.Add(new RiderLeagueRecord
            {
                RiderID = riderId,
                RiderName = riderName,
                TotalCollections = totalCollections,
                TotalDiscrepancies = totalDiscrepancies,
                TotalExpected = totalExpected,
                SettledDeficits = settledDeficits
            });
        }
        
        if (sortColumn == "Name")
        {
            return isSortAscending ? league.OrderBy(l => l.RiderName).ToList() : league.OrderByDescending(l => l.RiderName).ToList();
        }
        else if (sortColumn == "Collections")
        {
            return isSortAscending ? league.OrderBy(l => l.TotalCollections).ToList() : league.OrderByDescending(l => l.TotalCollections).ToList();
        }
        else if (sortColumn == "Discrepancies")
        {
            return isSortAscending ? league.OrderBy(l => l.TotalDiscrepancies).ToList() : league.OrderByDescending(l => l.TotalDiscrepancies).ToList();
        }
        else if (sortColumn == "Recovery")
        {
            return isSortAscending ? league.OrderBy(l => l.RecoveryPercentage).ToList() : league.OrderByDescending(l => l.RecoveryPercentage).ToList();
        }
        
        return league.OrderByDescending(l => l.TotalCollections).ToList();
    }

    // Funnel count properties
    private int FunnelRequested => requests
        .Count(x => x.EnteredDate.Date >= filterStartDate.Date && x.EnteredDate.Date <= filterEndDate.Date);

    private int FunnelAssigned => requests
        .Count(x => (x.Status != "Requested" || x.RiderID.HasValue) &&
                    x.EnteredDate.Date >= filterStartDate.Date && x.EnteredDate.Date <= filterEndDate.Date);

    private int FunnelCollected => requests
        .Count(x => (x.Status == "Collected" || x.Status == "ReferralConfirmed" || x.Status == "Completed" || x.Status == "Discrepancy" || x.Status == "Revisit") &&
                    x.EnteredDate.Date >= filterStartDate.Date && x.EnteredDate.Date <= filterEndDate.Date);

    private int FunnelConfirmed => requests
        .Count(x => (x.Status == "ReferralConfirmed" || x.Status == "Completed" || x.Status == "Discrepancy" || x.Status == "Revisit") &&
                    x.EnteredDate.Date >= filterStartDate.Date && x.EnteredDate.Date <= filterEndDate.Date);

    private int FunnelCompleted => requests
        .Count(x => x.Status == "Completed" &&
                    x.EnteredDate.Date >= filterStartDate.Date && x.EnteredDate.Date <= filterEndDate.Date);

    private string GetConversionPercent(int current, int previous)
    {
        if (previous <= 0) return "0%";
        double pct = ((double)current / previous) * 100;
        return $"{pct:F0}%";
    }

    private string GetOverallConversionPercent(int current, int requested)
    {
        if (requested <= 0) return "0%";
        double pct = ((double)current / requested) * 100;
        return $"{pct:F0}%";
    }

    // Trend comparison metrics
    private decimal ThisWeekCollectedAmount => requests
        .Where(x => x.RequestType == "PaymentCollection" &&
                    (x.Status == "Collected" || x.Status == "ReferralConfirmed" || x.Status == "Completed") &&
                    x.EnteredDate.Date >= startOfThisWeek &&
                    x.EnteredDate.Date <= endOfThisWeek)
        .Sum(x => x.CollectedAmount ?? 0);

    private decimal LastWeekCollectedAmount => requests
        .Where(x => x.RequestType == "PaymentCollection" &&
                    (x.Status == "Collected" || x.Status == "ReferralConfirmed" || x.Status == "Completed") &&
                    x.EnteredDate.Date >= startOfLastWeek &&
                    x.EnteredDate.Date <= endOfLastWeek)
        .Sum(x => x.CollectedAmount ?? 0);

    private int ThisWeekDeficitCount => requests
        .Count(x => x.RequestType == "PaymentCollection" &&
                    x.Status == "Completed" &&
                    x.ResolutionType == "RiderAccountable" &&
                    x.EnteredDate.Date >= startOfThisWeek &&
                    x.EnteredDate.Date <= endOfThisWeek);

    private int LastWeekDeficitCount => requests
        .Count(x => x.RequestType == "PaymentCollection" &&
                    x.Status == "Completed" &&
                    x.ResolutionType == "RiderAccountable" &&
                    x.EnteredDate.Date >= startOfLastWeek &&
                    x.EnteredDate.Date <= endOfLastWeek);

    private DateTime startOfThisWeek
    {
        get
        {
            DateTime today = DateTime.Today;
            int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
            return today.AddDays(-1 * diff).Date;
        }
    }

    private DateTime endOfThisWeek => startOfThisWeek.AddDays(6).Date;
    private DateTime startOfLastWeek => startOfThisWeek.AddDays(-7).Date;
    private DateTime endOfLastWeek => startOfLastWeek.AddDays(6).Date;

    private decimal CollectionsTrendPercentage
    {
        get
        {
            if (LastWeekCollectedAmount <= 0) return ThisWeekCollectedAmount > 0 ? 100 : 0;
            return ((ThisWeekCollectedAmount - LastWeekCollectedAmount) / LastWeekCollectedAmount) * 100;
        }
    }

    private decimal DeficitTrendPercentage
    {
        get
        {
            if (LastWeekDeficitCount <= 0) return ThisWeekDeficitCount > 0 ? 100 : 0;
            return ((ThisWeekDeficitCount - LastWeekDeficitCount) / (decimal)LastWeekDeficitCount) * 100;
        }
    }

    private bool pageReady = false;
