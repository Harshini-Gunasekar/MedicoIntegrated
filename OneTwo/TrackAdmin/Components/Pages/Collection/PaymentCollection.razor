    [Inject] IOptions<APIConfiguration> ApiConfig { get; set; }

    // SignalR hub connection (Issues 4 & 5)
    private HubConnection? _payHubConnection;

    private bool   isPayToastVisible = false;
    private bool   isPayToastFading  = false;
    private string payToastTitle   = "";
    private string payToastMessage = "";
    private string payToastType    = "success";
    private string payToastIcon    = "bi-check-circle-fill";
