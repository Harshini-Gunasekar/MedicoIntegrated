    private async void ShowPayToast(string title, string message, string type = "success", string icon = "bi-check-circle-fill", string photoUrl = "")
    {
        payToastTitle   = title;
        payToastMessage = message;
        payToastType    = type;
        payToastIcon    = icon;
        payToastPhoto   = photoUrl;
        isPayToastFading  = false;
        isPayToastVisible = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2500);
        isPayToastFading = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(350);
        isPayToastVisible = false;
        isPayToastFading  = false;
        payToastPhoto     = "";
        await InvokeAsync(StateHasChanged);
    }
    private void ClosePayToast()
    {
        isPayToastVisible = false;
        payToastPhoto = "";
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(async () =>
        {
            var uri = Navigation.ToAbsoluteUri(e.Location);
            if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("requestId", out var reqIdVal) 
                && int.TryParse(reqIdVal, out var reqId))
            {
                if (pageReady)
                {
                    await HandleRequestDeepLink(reqId);
                }
            }
        });
    }

    private async Task HandleRequestDeepLink(int reqId)
    {
        var req = requests.FirstOrDefault(x => x.RequestID == reqId);
        if (req == null)
        {
            await LoadRequestsAsync();
            req = requests.FirstOrDefault(x => x.RequestID == reqId);
        }

        if (req != null)
        {
            if (req.Status == "ReferralConfirmed" || req.Status == "Collected" || req.Status == "Discrepancy" || req.Status == "Revisit")
            {
                await OpenAuditModal(req);
            }
            else
            {
                await OpenTimelineModal(req);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            apiurl = ApiConfig.Value.BaseApiUrl;

            // Connect to notificationHub for real-time "PaymentStatusChanged" pushes
            if (_payHubConnection == null)
            {
                // Use exact same URL pattern as AppointmentsEntry (which works)
                _payHubConnection = new HubConnectionBuilder()
                    .WithUrl($"{ApiConfig.Value.BaseApiUrl}notificationHub?TenantId={_tenantState.TenantID}")
                    .WithAutomaticReconnect()
                    .Build();

                // Issues 4 & 5: Real-time payment status push from API
                _payHubConnection.On<System.Text.Json.JsonElement>("PaymentStatusChanged", async (payload) =>
                {
                    try
                    {
                        int    reqId    = payload.TryGetProperty("requestId",  out var ri)  ? ri.GetInt32()   : 0;
                        string status   = payload.TryGetProperty("status",     out var st)  ? st.GetString()  : "";
                        int    riderId  = payload.TryGetProperty("riderId",    out var rid) ? rid.GetInt32()  : 0;
                        string rPhoto   = payload.TryGetProperty("riderPhoto", out var rp)  ? rp.GetString()  : "";
                        string cName    = payload.TryGetProperty("clientName", out var cn)  ? cn.GetString()  : "";

                        // Build absolute photo URL
                        if (!string.IsNullOrEmpty(rPhoto) && rPhoto.StartsWith("User/"))
                            rPhoto = apiurl + rPhoto;

                        await InvokeAsync(async () =>
                        {
                            await LoadRequestsAsync();

                            string riderName = riderId > 0
                                ? (fleetRiders.FirstOrDefault(r => r.RiderID == riderId)?.Name
                                   ?? fleetRiders.FirstOrDefault(r => r.RiderID == riderId)?.ShortName
                                   ?? "Rider")
                                : "Rider";

                            switch (status?.ToLower())
                            {
                                case "requested":
                                    ShowPayToast("🆕 New Request", $"New payment request #{reqId}" + (string.IsNullOrEmpty(cName) ? "" : $" from {cName}"), "info", "bi-bell-fill");
                                    NotifStore.Add("🆕 Payment Requested", $"New payment request #{reqId}" + (string.IsNullOrEmpty(cName) ? "" : $" from {cName}"), "info", "bi-bell-fill");
                                    break;
                                case "assigned":
                                    ShowPayToast("📋 Assigned", $"Request #{reqId} assigned to {riderName}", "info", "bi-person-fill", rPhoto);
                                    NotifStore.Add("📋 Payment Assigned", $"Payment request #{reqId} assigned to {riderName}", "info", "bi-person-fill", rPhoto);
                                    break;
                                case "accepted":
                                    ShowPayToast("✅ Rider Accepted", $"Rider {riderName} accepted Request #{reqId}", "success", "bi-person-check-fill", rPhoto);
                                    NotifStore.Add("✅ Payment Accepted", $"Rider {riderName} accepted payment request #{reqId}", "accepted", "bi-person-check-fill", rPhoto);
                                    break;
                                case "collected":
                                    ShowPayToast("💵 Cash Collected", $"Rider {riderName} collected for Request #{reqId}", "info", "bi-cash-stack", rPhoto);
                                    NotifStore.Add("💵 Payment Collected", $"Rider {riderName} collected payment for Request #{reqId}", "collected", "bi-cash-stack", rPhoto);
                                    break;
                                case "referralconfirmed":
                                    ShowPayToast("✔️ Referral Confirmed", $"Request #{reqId} confirmed by client", "success", "bi-patch-check-fill");
                                    NotifStore.Add("✔️ Payment Confirmed", $"Payment request #{reqId} confirmed by client", "referral", "bi-patch-check-fill");
                                    break;
                                case "discrepancy":
                                    ShowPayToast("⚠️ Discrepancy", $"Amount mismatch on Request #{reqId} — review needed", "error", "bi-exclamation-triangle-fill");
                                    NotifStore.Add("⚠️ Payment Discrepancy", $"Amount mismatch on payment request #{reqId}", "escalation", "bi-exclamation-triangle-fill");
                                    break;
                                case "completed":
                                    ShowPayToast("⭐ Completed", $"Request #{reqId} fully resolved", "success", "bi-check-circle-fill");
                                    NotifStore.Add("⭐ Payment Completed", $"Payment request #{reqId} completed", "referral", "bi-check-circle-fill");
                                    break;
                            }

                            await InvokeAsync(StateHasChanged);
                        });
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"PaymentStatusChanged handler error: {ex.Message}");
                    }
                });

                try
                {
                    await _payHubConnection.StartAsync();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"PaymentCollection SignalR connect error: {ex.Message}");
                }
            }

            await LoadRequestsAsync();
            await LoadFleetRidersAsync();

            // 30-second polling fallback (catches any edge-case missed pushes)
            payPollingTimer = new System.Timers.Timer(30000);
            payPollingTimer.Elapsed += async (sender, e) => await PollAndDiffPayments();
            payPollingTimer.AutoReset = true;
            payPollingTimer.Enabled = true;

            pageReady = true;
            await InvokeAsync(StateHasChanged);

            // Check query parameter 'requestId' on initial load
            var initUri = Navigation.ToAbsoluteUri(Navigation.Uri);
            if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(initUri.Query).TryGetValue("requestId", out var reqIdVal) 
                && int.TryParse(reqIdVal, out var reqId))
            {
                await HandleRequestDeepLink(reqId);
            }
        }
    }

    private System.Timers.Timer? payPollingTimer;

    /// <summary>
    /// 30-second polling fallback: diffs statuses and fires toasts for any changes
    /// missed by the SignalR push (e.g. mobile app offline, reconnect gaps).
    /// </summary>
    private async Task PollAndDiffPayments()
    {
        try
        {
            var oldStatuses = requests.ToDictionary(x => x.RequestID, x => x.Status ?? "");
            await InvokeAsync(async () => await LoadRequestsAsync());

            foreach (var req in requests)
            {
                if (!oldStatuses.TryGetValue(req.RequestID, out var oldStatus)) continue;
                var newStatus = req.Status ?? "";
                if (oldStatus == newStatus) continue;

                var riderName = fleetRiders.FirstOrDefault(r => r.RiderID == req.RiderID)?.Name ?? "Rider";
                var rPhoto = req.RiderID.HasValue
                    ? $"{apiurl}User/GetImage?imageType=profile-pics&riderId={req.RiderID}"
                    : "";

                await InvokeAsync(() =>
                {
                    if (oldStatus == "Assigned" && newStatus == "Accepted")
                    {
                        ShowPayToast("✅ Rider Accepted", $"Rider {riderName} accepted Request #{req.RequestID}", "success", "bi-person-check-fill", rPhoto);
                        NotifStore.Add("✅ Payment Accepted", $"Rider {riderName} accepted payment request #{req.RequestID}", "accepted", "bi-person-check-fill", rPhoto);
                    }
                    else if (oldStatus == "Accepted" && newStatus == "Collected")
                    {
                        ShowPayToast("💵 Cash Collected", $"Rider {riderName} collected for Request #{req.RequestID}", "info", "bi-cash-stack", rPhoto);
                        NotifStore.Add("💵 Payment Collected", $"Rider {riderName} collected payment for Request #{req.RequestID}", "collected", "bi-cash-stack", rPhoto);
                    }
                    else if (newStatus == "ReferralConfirmed")
                    {
                        ShowPayToast("✔️ Referral Confirmed", $"Request #{req.RequestID} confirmed by client", "success", "bi-patch-check-fill");
                        NotifStore.Add("✔️ Payment Confirmed", $"Payment request #{req.RequestID} confirmed by client", "referral", "bi-patch-check-fill");
                    }
                    else if (newStatus == "Discrepancy")
                    {
                        ShowPayToast("⚠️ Discrepancy", $"Amount mismatch on Request #{req.RequestID}", "error", "bi-exclamation-triangle-fill");
                        NotifStore.Add("⚠️ Payment Discrepancy", $"Amount mismatch on payment request #{req.RequestID}", "escalation", "bi-exclamation-triangle-fill");
                    }
                    else if (newStatus == "Completed" && oldStatus != "Completed")
                    {
                        ShowPayToast("⭐ Completed", $"Request #{req.RequestID} fully resolved", "success", "bi-check-circle-fill");
                        NotifStore.Add("⭐ Payment Completed", $"Payment request #{req.RequestID} completed", "referral", "bi-check-circle-fill");
                    }
                    StateHasChanged();
                    return Task.CompletedTask;
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"PaymentCollection polling error: {ex.Message}");
        }
    }

    private async Task LoadRequestsAsync()
    {
        try
        {
            var res = await http.GetAsync($"{apiurl}PaymentCollection/admin/list");
            if (res.IsSuccessStatusCode)
            {
                var json = await res.Content.ReadAsStringAsync();
                requests = JsonConvert.DeserializeObject<List<PaymentCollectionRequest>>(json) ?? new();
            }
            UpdateHeader();
        }
        catch (Exception ex)
        {
            await dp.AlertAsync($"Error loading requests: {ex.Message}");
        }
    }

    private async Task LoadFleetRidersAsync()
    {
        try
        {
            var res = await http.GetAsync($"{apiurl}User/GetFleetRiders");
            if (res.IsSuccessStatusCode)
            {
                var json = await res.Content.ReadAsStringAsync();
                fleetRiders = JsonConvert.DeserializeObject<List<Rider_Master>>(json) ?? new();
            }
        }
        catch (Exception) { }
    }

    private void UpdateHeader()
    {
        Metadata.UpdatePage(
            "Payment & Container Collections", 
            "Manage non-appointment cash and sample container logistics", 
            "bi-wallet2",
            new List<PageStat> {
                new PageStat { Label = "Total Collections", Value = TotalRequestsCount.ToString() },
                new PageStat { Label = "Awaiting Action", Value = requests.Count(x => (x.Status == "Requested" || x.Status == "Assigned" || x.Status == "ReferralConfirmed") && x.EnteredDate.Date >= filterStartDate.Date && x.EnteredDate.Date <= filterEndDate.Date).ToString(), Color = "text-warning" },
                new PageStat { Label = (filterStartDate.Date == filterEndDate.Date && filterStartDate.Date == DateTime.Today) ? "Closed Today" : "Closed Period", Value = CompletedCount.ToString(), Color = "text-success" }
            }
        );
    }

    // Modal Actions
    private void OpenAssignModal(PaymentCollectionRequest req)
    {
        selectedRequest = req;
        targetRiderId = null;
        isAssignModalOpen = true;
    }

    private async Task OpenAuditModal(PaymentCollectionRequest req)
    {
        selectedRequest = req;
        isReceivedByLab = true;
        isRejectResetDecision = false;
        adminNotes = "";

        try
        {
            var res = await http.GetAsync($"{apiurl}PaymentCollection/track?requestId={req.RequestID}");
            if (res.IsSuccessStatusCode)
            {
                var json = await res.Content.ReadAsStringAsync();
                var latest = JsonConvert.DeserializeObject<dynamic>(json);
                if (latest != null)
                {
                    req.Status = latest.status?.ToString() ?? req.Status;
                    req.RiderID = latest.riderID != null ? (int?)latest.riderID : req.RiderID;
                    req.RiderName = latest.riderName?.ToString() ?? req.RiderName;
                    req.CollectedAmount = latest.collectedAmount != null ? (decimal?)latest.collectedAmount : req.CollectedAmount;
                    req.ContainerCount = latest.containerCount != null ? (int?)latest.containerCount : req.ContainerCount;
                    req.ReferralConfirmedAmount = latest.referralConfirmedAmount != null ? (decimal?)latest.referralConfirmedAmount : req.ReferralConfirmedAmount;
                }
            }
        }
        catch (Exception)
        {
            // Fallback gracefully to existing grid row data on error
        }

        isAuditModalOpen = true;
    }

    private void CloseModals()
    {
        isAssignModalOpen = false;
        isAuditModalOpen = false;
        isSettleModalOpen = false;
        selectedRequest = null;
        settleRequest = null;
        forceEqualizeAndResolve = false;
        isRejectResetDecision = false;
        discrepancyResolution = "RiderAccountable";
    }

    private void OpenSettleModal(PaymentCollectionRequest req)
    {
        settleRequest = req;
        settlementNotes = "";
        isSettleModalOpen = true;
    }

    private async Task SubmitSettlementAsync()
    {
        try
        {
            if (settleRequest == null) return;

            var payload = new PaymentCollectionRequest
            {
                RequestID = settleRequest.RequestID,
                AdminApprovedBy = 1,
                DeficitSettlementNotes = settlementNotes
            };

            var res = await http.PostAsJsonAsync($"{apiurl}PaymentCollection/admin/settle-deficit", payload);
            if (res.IsSuccessStatusCode)
            {
                isSettleModalOpen = false;
                settleRequest = null;
                await LoadRequestsAsync();
                ShowToast("Rider accountable cash deficit settled successfully!", "success");
            }
            else
            {
                ShowToast("Failed to settle deficit. Please try again.", "error");
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error executing settlement: {ex.Message}", "error");
        }
    }

