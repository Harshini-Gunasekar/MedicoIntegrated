@page "/transfer"
@rendermode InteractiveServer

@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using TrackAdmin.Components.Layout
@using TrackAdmin.Data
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.DropDowns
@using TrackAdmin.Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject NavigationManager Navigation
@inject HttpClient http
@inject SfDialogService dp
@inject IJSRuntime JS
@inject RiderTracking riderTracking
@inject MasterData msd
@inject TenantState _tenantState
@inject ProtectedSessionStorage protectedSessionStore
@inject PageMetadataService Metadata
@inject UserSessionService session



@if (!pageReady)
{
    <div class="premium-loader-container">
        <div class="tactical-loader-orb">
            <i class="bi bi-truck pulse"></i>
            <div class="loader-glow"></div>
        </div>
        <div class="loader-text-wrap">
            <h4>RIDO LOGISTICS</h4>
            <span>Syncing Sample Transfers...</span>
        </div>
    </div>
}
else
{
<section class="food-page animate-fade-in">
    <section class="container-fluid food-body">
        <section class="row g-3 mb-4">
            <div class="col-xl-4 col-md-6">
                <div class="stat-glass-card primary">
                    <div class="stat-icon-wrap"><i class="bi bi-arrow-left-right"></i></div>
                    <div class="stat-data">
                        <span class="stat-label">Total Transfers</span>
                        <h3 class="stat-value">@transferList.Count()</h3>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-md-6">
                <div class="stat-glass-card info">
                    <div class="stat-icon-wrap"><i class="bi bi-truck"></i></div>
                    <div class="stat-data">
                        <span class="stat-label">Transferred Today</span>
                        <h3 class="stat-value">@transferList.Count(x => x.CreatedAt?.Date == DateTime.Today)</h3>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-md-6">
                <div class="stat-glass-card success">
                    <div class="stat-icon-wrap"><i class="bi bi-check-circle-fill"></i></div>
                    <div class="stat-data">
                        <span class="stat-label">Accepted</span>
                        <h3 class="stat-value">@transferList.Count(x => x.IsAccepted == true)</h3>
                    </div>
                </div>
            </div>
        </section>

        <header class="food-toolbar premium-card mb-3">
            <div class="row g-3 p-2 px-3 align-items-center">
                <div class="col-xl-6">
                    <div class="premium-toolbar-group">
                        <div class="row g-0 align-items-center">
                            <div class="col border-end">
                                <div class="px-3 py-1">
                                    <label class="food-label d-flex align-items-center gap-2 mb-0" style="font-size: 10px;">
                                        <i class="bi bi-calendar-event text-primary"></i> From
                                    </label>
                                    <InputDate Type="InputDateType.Date" Value="@fdt" ValueExpression="() => fdt" ValueChanged="@((DateTime d) => { fdt = d; _ = LoadTransfers(); })" class="form-control border-0 bg-transparent p-0 food-date-input" style="font-size: 13px;"></InputDate>
                                </div>
                            </div>
                            <div class="col border-end">
                                <div class="px-3 py-1">
                                    <label class="food-label d-flex align-items-center gap-2 mb-0" style="font-size: 10px;">
                                        <i class="bi bi-calendar-check text-primary"></i> To
                                    </label>
                                    <InputDate Type="InputDateType.Date" Value="@tdt" ValueExpression="() => tdt" ValueChanged="@((DateTime d) => { tdt = d; _ = LoadTransfers(); })" class="form-control border-0 bg-transparent p-0 food-date-input" style="font-size: 13px;"></InputDate>
                                </div>
                            </div>
                            <div class="col-auto px-3">
                                <button type="button" @onclick="@LoadTransfers" class="btn btn-primary btn-sm rounded-pill px-3" style="font-size: 11px; font-weight: 700;">
                                    <i class="bi bi-arrow-clockwise me-1"></i> REFRESH
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-6">
                    <div class="d-flex gap-2 justify-content-end align-items-center">
                        <div class="food-search-group" style="width: 250px;">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" class="food-search-input" placeholder="Search driver, bus..." @bind-value="searchTerm" @bind-value:event="oninput" />
                        </div>
                        <div style="width: 180px;">
                            <SfComboBox DataSource="@riderMasters" TValue="int?" TItem="Rider_Master" @bind-Value="@selectedRiderId" Placeholder="Filter Rider" CssClass="food-combo-sm">
                                <ComboBoxFieldSettings Text="Name" Value="RiderID"></ComboBoxFieldSettings>
                                <ComboBoxEvents TValue="int?" TItem="Rider_Master" ValueChange="OnRiderChange"></ComboBoxEvents>
                            </SfComboBox>
                        </div>
                        <div class="food-status-wrap bg-light rounded-pill px-3 py-1 gap-3">
                            <SfRadioButton Label="All" Name="Status" Value="" TChecked="string" @bind-Checked="@selectedStatus" ValueChange="OnStatusChange"></SfRadioButton>
                            <SfRadioButton Label="Pending" Name="Status" Value="Pending" TChecked="string" @bind-Checked="@selectedStatus" ValueChange="OnStatusChange"></SfRadioButton>
                            <SfRadioButton Label="Done" Name="Status" Value="Accepted" TChecked="string" @bind-Checked="@selectedStatus" ValueChange="OnStatusChange"></SfRadioButton>
                        </div>
                    </div>
                </div>
            </div>
        </header>

<div class="animate-up">
        <div class="floating-row-container">
            <!-- Header Grid -->
            <div class="row-card-header d-none d-xl-flex">
                <div class="col-ref">TRANSFER ID</div>
                <div class="col-rider">SENDER RIDER</div>
                <div class="col-origin">TYPE</div>
                <div class="col-client">DETAILS (BUS/DRIVER)</div>
                <div class="col-status">STATUS</div>
                <div class="col-ops">OPERATIONS</div>
            </div>

            @if (PaginatedList != null && PaginatedList.Count > 0)
            {
                @foreach (var item in PaginatedList)
                {
                    <div class="row-card animate-slide-up">
                        <div class="status-indicator @(item.IsAccepted == true ? "bg-success" : item.IsAccepted == false ? "bg-danger" : "bg-warning")"></div>
                        <div class="row-card-body">
                            <div class="col-ref">
                                <span class="job-id">#@item.Id</span>
                            </div>
                            <div class="col-rider">
                                <div class="rider-chip">
                                    <div class="rider-avatar">@((item.SenderName ?? "R")[0])</div>
                                    <span>@(item.SenderName ?? "Rider " + item.RiderId)</span>
                                </div>
                            </div>
                            <div class="col-origin">
                                <div class="origin-pill @(item.SendingType?.Equals("Bus", StringComparison.OrdinalIgnoreCase) == true ? "mnl" : "wa")">
                                    <i class="bi @(item.SendingType?.Equals("Bus", StringComparison.OrdinalIgnoreCase) == true ? "bi-truck" : "bi-scooter") me-1"></i>
                                    @item.SendingType
                                </div>
                            </div>
                            <div class="col-client">
                                @if (!string.IsNullOrEmpty(item.BusNumber))
                                {
                                    <div class="client-name"><i class="bi bi-bus-front small text-primary me-2"></i>@item.BusNumber</div>
                                }
                                @if (!string.IsNullOrEmpty(item.DriverName))
                                {
                                    <div class="client-id"><i class="bi bi-person small me-2"></i>@item.DriverName (@item.DriverNumber)</div>
                                }
                                <div class="time-item mt-1"><i class="bi bi-clock small me-1"></i> @item.CreatedAt?.ToString("dd MMM, hh:mm tt")</div>
                            </div>
                            <div class="col-status">
                                @if (item.IsAccepted == true)
                                {
                                    <span class="badge bg-success-light text-success border-success-subtle px-3 rounded-pill">Accepted</span>
                                }
                                else if (item.IsAccepted == false)
                                {
                                    <span class="badge bg-danger-light text-danger border-danger-subtle px-3 rounded-pill">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-light text-warning border-warning-subtle px-3 rounded-pill">Pending</span>
                                }
                            </div>
                            <div class="col-ops">
                                <div class="ops-actions">
                                    <button class="op-btn edit" title="View Details" @onclick="() => ViewDetails(item)">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h5>No transfer records found</h5>
                    <p>Adjust filters or date range</p>
                </div>
            }

            <div class="premium-pagination">
                <div class="page-info">
                    Showing <b>@(((currentPage - 1) * pageSize) + 1)</b> - <b>@Math.Min(currentPage * pageSize, TotalItems)</b> of <b>@TotalItems</b>
                </div>
                <div class="page-actions">
                    <button class="page-nav-btn" disabled="@(currentPage <= 1)" @onclick="PreviousPage">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <div class="page-numbers">
                        @for (int i = 1; i <= TotalPages; i++) {
                            var p = i;
                            <button class="page-num @(currentPage == p ? "active" : "")" @onclick="() => currentPage = p">@p</button>
                        }
                    </div>
                    <button class="page-nav-btn" disabled="@(currentPage >= TotalPages || TotalPages == 0)" @onclick="NextPage">
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>
</section>

<SfDialog Target="#main" Width="650px" IsModal="true" ShowCloseIcon="false" @bind-Visible="@showDetailDialog">
    <DialogTemplates>
        <Header>
            <div class="d-flex align-items-center justify-content-between w-100">
                <div class="d-flex align-items-center gap-3">
                    <span style="font-weight:700;font-size:16px;color:#0f172a;">Transfer Details #@selectedTransfer?.Id</span>
                    @if (selectedTransfer?.IsAccepted == true)
                    {
                        <span class="badge bg-success text-white px-3 rounded-pill" style="font-size: 10px;">Accepted</span>
                    }
                    else if (selectedTransfer?.IsAccepted == false && !string.IsNullOrEmpty(selectedTransfer?.RejectionReason))
                    {
                        <span class="badge bg-danger text-white px-3 rounded-pill" style="font-size: 10px;">Rejected</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark px-3 rounded-pill" style="font-size: 10px;">@selectedTransfer?.Status</span>
                    }
                </div>
                <button type="button" @onclick="() => showDetailDialog = false" class="dlg-close-btn">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </Header>
        <Content>
            @if (selectedTransfer != null)
            {
                <div class="p-3">
                    <div class="row mb-3">
                        <div class="col-4">
                            <label class="text-muted small">Sender</label>
                            <div class="fw-bold">@selectedTransfer.SenderName</div>
                        </div>
                        <div class="col-4">
                            <label class="text-muted small">Recipient</label>
                            <div class="fw-bold">
                                @(selectedTransfer.SendingType?.Equals("Bus", StringComparison.OrdinalIgnoreCase) == true 
                                    ? "Bus Transfer" 
                                    : (selectedTransfer.ReceiverName ?? "N/A"))
                            </div>
                        </div>
                        <div class="col-4">
                            <label class="text-muted small">Type</label>
                            <div class="alpha-badge badge-primary">@selectedTransfer.SendingType</div>
                        </div>
                    </div>
                    
                    <div class="row mb-4">
                        <div class="col-6">
                            <label class="text-muted small">Bus Number</label>
                            <div class="@(string.IsNullOrEmpty(selectedTransfer.BusNumber) ? "text-muted" : "fw-bold")">
                                @(string.IsNullOrEmpty(selectedTransfer.BusNumber) ? "---" : selectedTransfer.BusNumber)
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small">@(selectedTransfer.SendingType?.Equals("Bus", StringComparison.OrdinalIgnoreCase) == true ? "Bus Driver" : "Sender Rider")</label>
                            <div>
                                @selectedTransfer.DriverName 
                                @(string.IsNullOrEmpty(selectedTransfer.DriverNumber) ? "" : $"({selectedTransfer.DriverNumber})")
                            </div>
                        </div>
                    </div>

                    @if (selectedTransfer.SendingType?.Equals("Bus", StringComparison.OrdinalIgnoreCase) == true && !string.IsNullOrEmpty(selectedTransfer.ReceiverName))
                    {
                        <div class="row mb-4">
                            <div class="col-12">
                                <label class="text-primary small fw-bold"><i class="bi bi-person-check-fill"></i> Assigned Rider (Receiver)</label>
                                <div class="p-2 bg-primary-light text-primary rounded border border-primary-subtle">
                                    @selectedTransfer.ReceiverName
                                </div>
                            </div>
                        </div>
                    }

                    <div class="mb-4">
                        <label class="text-muted small">Narration / Notes</label>
                        <div class="p-2 bg-light rounded">@(string.IsNullOrEmpty(selectedTransfer.Narration) ? "No notes added." : selectedTransfer.Narration)</div>
                    </div>

                    @if (selectedTransfer.IsAccepted == false && !string.IsNullOrEmpty(selectedTransfer.RejectionReason))
                    {
                        <div class="mb-4">
                            <label class="text-danger small fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Rejection Reason</label>
                            <div class="p-2 bg-danger-light text-danger rounded border border-danger-subtle">@selectedTransfer.RejectionReason</div>
                        </div>
                    }

                    <div class="row mb-4">
                        <div class="col-6">
                            <label class="text-muted small">Created At</label>
                            <div>@selectedTransfer.CreatedAt?.ToString("MMM dd, yyyy hh:mm tt")</div>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small">Processed At (Decision)</label>
                            <div>@(selectedTransfer.ReceivedAt?.ToString("MMM dd, yyyy hh:mm tt") ?? "Pending Decision")</div>
                        </div>
                    </div>

                    @if (session.Rights.HasAccess("sample_transfer", "Edit"))
                    {
                        @if ((selectedTransfer.Status?.Trim().Equals("Rejected", StringComparison.OrdinalIgnoreCase) ?? false) || 
                             (selectedTransfer.SendingType?.Equals("Bus", StringComparison.OrdinalIgnoreCase) == true && (selectedTransfer.ToRiderId == null || selectedTransfer.ToRiderId == 0)))
                        {
                            <div class="reassign-section p-3 mb-4 bg-light rounded border border-primary-subtle">
                                <h6 class="text-primary mb-2"><i class="bi bi-person-plus-fill"></i> Reassign to New Rider</h6>
                                <div class="row align-items-end">
                                    <div class="col-8">
                                        <label class="small text-muted mb-1">Select Target Rider</label>
                                        <SfComboBox TValue="int?" TItem="Rider_Master" DataSource="@riderMasters" @bind-Value="@reassignRiderId" Placeholder="Select a rider...">
                                            <ComboBoxFieldSettings Text="Name" Value="RiderID"></ComboBoxFieldSettings>
                                        </SfComboBox>
                                    </div>
                                    <div class="col-4">
                                        <button class="btn btn-primary w-100" disabled="@(reassignRiderId == null || isReassigning)" @onclick="HandleReassign">
                                            @if (isReassigning)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                            }
                                            Reassign
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <label class="text-muted small mb-2">Attached Photos (@selectedTransfer.ImageUrls.Count)</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var url in selectedTransfer.ImageUrls)
                        {
                            <div class="transfer-photo-wrap">
                                <img src="@url" class="img-thumbnail" style="width: 120px; height: 120px; object-fit: cover; cursor: pointer;" @onclick="() => OpenImage(url)" />
                            </div>
                        }
                    </div>
                </div>
            }
        </Content>
    </DialogTemplates>
</SfDialog>
}
@code {
    private bool pageReady = false;
    private DateTime fdt = DateTime.Now.Date.AddDays(-7);
    private DateTime tdt = DateTime.Now.Date;
    private string searchTerm = "";
    private int? selectedRiderId = 0;
    private string selectedStatus = "";
    private int currentPage = 1;
    private int pageSize = 10;
    private string apiurl = "";
    private int? reassignRiderId;
    private bool isReassigning = false;

    private IList<SampleTransferResponse> transferList = new List<SampleTransferResponse>();
    private IList<Rider_Master> riderMasters = new List<Rider_Master>();

    private bool showDetailDialog = false;
    private SampleTransferResponse selectedTransfer;

    [Inject] IOptions<APIConfiguration> ApiConfig { get; set; }

    protected override void OnInitialized()
    {
        apiurl = ApiConfig.Value.BaseApiUrl;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Ensure TenantID is loaded if it's missing (happens on browser refresh)
            if (string.IsNullOrWhiteSpace(_tenantState.TenantID))
            {
                var tenantId = await protectedSessionStore.GetAsync<string>("TenantID");
                if (tenantId.Success && !string.IsNullOrWhiteSpace(tenantId.Value))
                {
                    _tenantState.TenantID = tenantId.Value;
                }
            }

            await LoadRiderAsync();
            await LoadTransfers();
            pageReady = true;
            UpdateHeader();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateHeader()
    {
        Metadata.UpdatePage(
            "Sample Transfers", 
            "Track custody transfers between field units", 
            "bi-truck",
            new List<PageStat> {
                new PageStat { Label = "Total", Value = transferList.Count.ToString() },
                new PageStat { Label = "Today", Value = transferList.Count(x => x.CreatedAt?.Date == DateTime.Today).ToString(), Color = "text-info" },
                new PageStat { Label = "Accepted", Value = transferList.Count(x => x.IsAccepted == true).ToString(), Color = "text-success" }
            }
        );
    }

    private async Task LoadRiderAsync()
    {
        try
        {
            riderMasters = await msd.GetMasters<Rider_Master>($"{apiurl}User/GetFleetRiders");
            foreach (var r in riderMasters) riderTracking.TrimAllStrings(r);
            StateHasChanged();
        }
        catch (Exception ex) 
        {
            Console.WriteLine($"LoadRider Error: {ex.Message}");
        }
    }

    private async Task LoadTransfers()
    {
        try
        {
            string sd = fdt.ToString("yyyy-MM-dd") + " 00:00:00";
            string ed = tdt.ToString("yyyy-MM-dd") + " 23:59:59";
            int rid = selectedRiderId ?? 0;

            transferList = await msd.GetSampleTransfers(apiurl, sd, ed, rid, selectedStatus);
        }
        catch (Exception) { }
        currentPage = 1;
        await InvokeAsync(StateHasChanged);
        UpdateHeader();
    }


    private void OnRiderChange(dynamic args)
    {
        selectedRiderId = args.Value;
        Task.Run(async () => await LoadTransfers());
    }

    private void OnStatusChange(dynamic args)
    {
        selectedStatus = args.Value;
        Task.Run(async () => await LoadTransfers());
    }

    private void ViewDetails(SampleTransferResponse item)
    {
        selectedTransfer = item;
        reassignRiderId = null;
        isReassigning = false;
        showDetailDialog = true;
    }

    private async Task HandleReassign()
    {
        if (reassignRiderId == null || selectedTransfer == null) return;

        isReassigning = true;
        StateHasChanged();

        try
        {
            var result = await msd.ReassignTransfer(apiurl, selectedTransfer.Id, reassignRiderId.Value);
            if (result.Success)
            {
                showDetailDialog = false;
                await LoadTransfers();
            }
            else
            {
                await dp.AlertAsync($"Failed to reassign: {result.Message}");
                // If it failed because it was already accepted, refresh the list to show the new status
                if (result.Message?.Contains("already been accepted", StringComparison.OrdinalIgnoreCase) == true)
                {
                    await LoadTransfers();
                }
            }
        }
        catch (Exception ex) 
        {
            await dp.AlertAsync($"Error: {ex.Message}");
        }
        finally
        {
            isReassigning = false;
            StateHasChanged();
        }
    }

    private async Task OpenImage(string url)
    {
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private IEnumerable<SampleTransferResponse> FilteredList => transferList
        .Where(x => (string.IsNullOrWhiteSpace(searchTerm) || 
                     x.Id.ToString().Contains(searchTerm) ||
                     (x.DriverName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                     (x.BusNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                     (riderMasters.FirstOrDefault(r => r.RiderID == x.RiderId)?.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)));

    private IList<SampleTransferResponse> PaginatedList => FilteredList
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    private int TotalItems => FilteredList.Count();
    private int TotalPages => (int)Math.Ceiling(TotalItems / (double)pageSize);

    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void PreviousPage() { if (currentPage > 1) currentPage--; }
}

<style>
    .bg-success-light { background-color: rgba(25, 135, 84, 0.1); }
    .text-success { color: #198754 !important; }
    .bg-danger-light { background-color: rgba(220, 53, 69, 0.1); }
    .text-danger { color: #dc3545 !important; }
    .bg-warning-light { background-color: rgba(255, 193, 7, 0.1); }
    .text-warning { color: #856404 !important; }
    
    .transfer-photo-wrap img:hover { transform: scale(1.05); transition: transform 0.2s; }
</style>
