	public async Task<List<Coordinate>> GetSnappedPointsAsync(List<Coordinate> rawPoints, string apiKey)
	{
		using var httpClient = new HttpClient();

		var path = string.Join("|", rawPoints.Select(p => $"{p.Lat},{p.Lng}"));
		var requestUrl = $"https://roads.googleapis.com/v1/snapToRoads?path={path}&interpolate=true&key={apiKey}";

		var response = await httpClient.GetAsync(requestUrl);
		var tt = response.Content.ReadAsStringAsync();
		if (!response.IsSuccessStatusCode)
			throw new Exception($"Roads API failed: {response.StatusCode}");

		var json = await response.Content.ReadAsStringAsync();
		var result = System.Text.Json.JsonSerializer.Deserialize<RoadsApiResponse>(json, new JsonSerializerOptions
			{
				PropertyNameCaseInsensitive = true
			});

		return result.SnappedPoints
			.Select(p => new Coordinate { Lat = p.Location.Latitude, Lng = p.Location.Longitude })
			.ToList();
	}
	public double GetTotalDistanceInKm(List<Coordinate> snappedPoints)
	{
		double totalDistance = 0;
		for (int i = 0; i < snappedPoints.Count - 1; i++)
		{
			Double dist = 0;

			dist = HaversineDistance(snappedPoints[i], snappedPoints[i + 1]);
			totalDistance += dist;
		}
		return totalDistance;
	}

	public double HaversineDistance(Coordinate c1, Coordinate c2)
	{
		const double R = 6371; // km
		double lat1 = ToRadians(c1.Lat);
		double lon1 = ToRadians(c1.Lng);
		double lat2 = ToRadians(c2.Lat);
		double lon2 = ToRadians(c2.Lng);

		double dLat = lat2 - lat1;
		double dLon = lon2 - lon1;

		double a = Math.Pow(Math.Sin(dLat / 2), 2) +
							Math.Cos(lat1) * Math.Cos(lat2) * Math.Pow(Math.Sin(dLon / 2), 2);

		double c = 2 * Math.Asin(Math.Sqrt(a));
		return R * c;
	}

	public double ToRadians(double angle) => angle * Math.PI / 180.0;
	public class RoadsApiResponse
	{
		public List<SnappedPoint> SnappedPoints { get; set; }
	}

	public class SnappedPoint
	{
		public Location Location { get; set; }
		public int? OriginalIndex { get; set; }
		public string PlaceId { get; set; }
	}

	public class Location
	{
		public double Latitude { get; set; }
		public double Longitude { get; set; }
	}
	private List<Coordinate> FilterClosePoints(List<Coordinate> points, double thresholdMeters = 2.0)
	{
		var filtered = new List<Coordinate>();
		Coordinate last = null;

		foreach (var point in points)
		{
			if (last == null || GetDistanceMeters(last, point) > thresholdMeters)
			{
				filtered.Add(point);
				last = point;
			}
		}

		return filtered;
	}

	private double GetDistanceMeters(Coordinate a, Coordinate b)
	{
		var R = 6371000; // Earth radius in meters
		var dLat = (b.Lat - a.Lat) * Math.PI / 180;
		var dLon = (b.Lng - a.Lng) * Math.PI / 180;
		var lat1 = a.Lat * Math.PI / 180;
		var lat2 = b.Lat * Math.PI / 180;

		var x = dLat / 2;
		var y = dLon / 2;

		var aHarv = Math.Sin(x) * Math.Sin(x) + Math.Cos(lat1) * Math.Cos(lat2) * Math.Sin(y) * Math.Sin(y);
		var c = 2 * Math.Atan2(Math.Sqrt(aHarv), Math.Sqrt(1 - aHarv));

		return R * c;
	}
