	private readonly string _apiKey = "AIzaSyDAD8wIVTxpl_xPsM4QJ1pUOsRyfK2MK9k";

	public async Task<(double distanceMeters, double durationSeconds)> GetDistanceAndDurationAsync(List<Coordinate> snappedPoints)
	{
		if (snappedPoints.Count < 2) return (0, 0);

		var origin = $"{snappedPoints.First().Lat},{snappedPoints.First().Lng}";
		var destination = $"{snappedPoints.Last().Lat},{snappedPoints.Last().Lng}";
		var waypoints = string.Join("|", snappedPoints.Skip(1).Take(snappedPoints.Count - 2)
																.Select(p => $"{p.Lat},{p.Lng}"));

		string url = $"https://maps.googleapis.com/maps/api/directions/json?" +
						$"origin={origin}&destination={destination}&key={_apiKey}&mode=driving";

		if (!string.IsNullOrWhiteSpace(waypoints))
			url += $"&waypoints=optimize:false|{waypoints}";

		var response = await http.GetAsync(url);
		if (!response.IsSuccessStatusCode) return (0, 0);

		var json = await response.Content.ReadAsStringAsync();
		using var doc = JsonDocument.Parse(json);

		var route = doc.RootElement.GetProperty("routes")[0];
		var legs = route.GetProperty("legs");

		double totalDistance = 0;
		double totalDuration = 0;

		foreach (var leg in legs.EnumerateArray())
		{
			totalDistance += leg.GetProperty("distance").GetProperty("value").GetDouble(); // meters
			totalDuration += leg.GetProperty("duration").GetProperty("value").GetDouble(); // seconds
		}

		return (totalDistance, totalDuration);
	}


