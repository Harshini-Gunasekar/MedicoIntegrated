
@page "/RiderRegisterTemp"
@rendermode InteractiveServer



@using Newtonsoft.Json
@using TrackAdmin.Components.Layout


@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using TrackAdmin.Models
@inject NavigationManager Navigation
@inject HttpClient http
@inject SfDialogService DialogService

<h2 class="py-3"> <i class="bi bi-person-lines-fill"></i> Registration</h2>
<h4 @onclick="@getback" class="py-3">Back</h4>

<section class="container-fluid">
    <section class="row">
        <div class="col">

            <SfTextBox FloatLabelType="FloatLabelType.Auto" Placeholder="Short Name" @bind-Value="@sname"></SfTextBox>
        </div>
    </section>	
    <section class="row">
        <div class="col">
            <SfTextBox FloatLabelType="FloatLabelType.Auto" Placeholder="Name" @bind-Value="@name"></SfTextBox>
        </div>
    </section>
    <section class="row">
        <div class="col">
            <InputDate Type="InputDateType.Date" @bind-Value="@dob"></InputDate>
        </div>
        <div class="col">
            <SfNumericTextBox ShowClearButton=false ShowSpinButton=false @bind-Value="@age"></SfNumericTextBox>
        </div>

    </section>
    <section class="row">
        <div class="col">
            <SfTextBox FloatLabelType="FloatLabelType.Auto" Placeholder="Mobile" @bind-Value="@mobile"></SfTextBox>
        </div>
    </section>
    <section class="row">
        <div class="col">
            <SfTextBox FloatLabelType="FloatLabelType.Auto" Placeholder="Email" @bind-Value="@email"></SfTextBox>
        </div>
    </section>
    <section class="row">
        <div class="col">
            <SfTextBox FloatLabelType="FloatLabelType.Auto" Placeholder="Passport No" @bind-Value="@passport"></SfTextBox>
        </div>
    </section>
    <section class="row">
        <div class="col">
            <SfTextBox FloatLabelType="FloatLabelType.Auto" Placeholder="Emirates ID" @bind-Value="@eid"></SfTextBox>
        </div>
    </section>
    <section class="row">
        <div class="col">
            <SfTextBox FloatLabelType="FloatLabelType.Auto" Placeholder="Status" @bind-Value="@status"></SfTextBox>
        </div>
    </section>
    <section class="row">
        <div class="col">
            <SfTextBox FloatLabelType="FloatLabelType.Auto" Placeholder="Gender" @bind-Value="@gender"></SfTextBox>
        </div>
    </section>

    <section class="row">
        <Syncfusion.Blazor.Buttons.SfButton Content="Save" OnClick="btn" ></Syncfusion.Blazor.Buttons.SfButton>
    </section>
</section>


