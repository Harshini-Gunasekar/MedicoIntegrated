.rm-drawer-body { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 16px; }
.rm-drawer-section { background: #f8fafc; border-radius: 14px; overflow: hidden; border: 1px solid #e8edf5; }
.rm-drawer-section-title {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 14px; font-size: 11px; font-weight: 800; color: #64748b;
