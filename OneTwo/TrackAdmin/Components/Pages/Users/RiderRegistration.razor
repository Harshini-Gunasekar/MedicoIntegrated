.rm-kpi-lbl { display: block; font-size: 11px; color: rgba(255,255,255,0.45); font-weight: 600; margin-top: 2px; letter-spacing: 0.3px; text-transform: uppercase; }
.rm-kpi-glow { position: absolute; width: 60px; height: 60px; border-radius: 50%; right: -10px; top: -10px; opacity: 0.15; filter: blur(15px); }
.blue-glow { background: #60a5fa; } .green-glow { background: #34d399; } .amber-glow { background: #fbbf24; }
.red-glow { background: #f87171; } .purple-glow { background: #a78bfa; } .teal-glow { background: #2dd4bf; }

/* ── TOOLBAR ── */
.rm-toolbar {
    display: flex; align-items: center; gap: 12px;
    padding: 16px 24px; background: #fff;
    border-bottom: 1px solid #e2e8f0;
