.rm-status-toggle-btn.deactive-status { background: rgba(100,116,139,0.1); color: #475569; }
.rm-status-toggle-btn.deactive-status:hover { background: #475569; color: #fff; }

/* ── LIST VIEW ── */
.rm-list-container {
    background: #fff; border-radius: 16px;
