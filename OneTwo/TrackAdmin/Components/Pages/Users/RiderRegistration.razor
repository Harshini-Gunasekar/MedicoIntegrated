@page "/RiderRegistration"
@rendermode InteractiveServer

@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using TrackAdmin.Components.Layout
@using TrackAdmin.Data

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.DropDowns
@using TrackAdmin.Models
@inject NavigationManager Navigation
@inject HttpClient http
@inject SfDialogService dp
@inject IJSRuntime JS
@inject RiderTracking trac
@inject TenantState _tenantState
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage protectedSessionStore
@inject UserSessionService session
@inject PageMetadataService Metadata

<!-- ══ RIDER MASTER PAGE ══ -->
<div class="rm-page animate-fade-in">


<!-- ══ COMPACT TOOLBAR ══ -->
    <div class="rm-toolbar">
        <!-- Mini fleet counters -->
        <div class="rm-mini-counts">
            <span class="rm-mini-count blue">
                <i class="bi bi-people-fill"></i>
                <strong>@rider1.Count</strong>
                <span>Total Fleet</span>
            </span>
            <span class="rm-mini-sep"></span>
            <span class="rm-mini-count red">
                <i class="bi bi-slash-circle-fill"></i>
                <strong>@rider1.Count(x => x.Status == "Deactive")</strong>
                <span>Inactive</span>
            </span>
        </div>

        <div class="rm-search-wrap">
            <i class="bi bi-search rm-search-icon"></i>
            <input id="riderSearchInput" type="text" class="rm-search-input" placeholder="Search rider..." @bind="searchTerm" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <button class="rm-search-clear" @onclick="@(() => { searchTerm = ""; currentPage = 1; })">
                    <i class="bi bi-x"></i>
                </button>
            }
        </div>
        <div class="rm-filter-pills">
            <button class="rm-filter-pill @(activeFilter == "all" ? "active" : "")" @onclick='@(() => SetFilter("all"))'>All</button>
            <button class="rm-filter-pill green @(activeFilter == "Active" ? "active" : "")" @onclick='@(() => SetFilter("Active"))'>
                <span class="pill-dot green"></span> Active
            </button>
            <button class="rm-filter-pill amber @(activeFilter == "New" ? "active" : "")" @onclick='@(() => SetFilter("New"))'>
                <span class="pill-dot amber"></span> New
            </button>
            <button class="rm-filter-pill red @(activeFilter == "Deactive" ? "active" : "")" @onclick='@(() => SetFilter("Deactive"))'>
                <span class="pill-dot red"></span> Inactive
            </button>
        </div>
        <div class="rm-toolbar-right">
            @if (session.Rights.HasAccess("staff", "Create"))
            {
                <button type="button" id="btnAddRider" @onclick="@addnew" class="rm-add-btn-sm">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>Add Rider</span>
                </button>
            }
            <button class="rm-view-btn @(viewMode == "grid" ? "active" : "")" @onclick='@(() => viewMode = "grid")' title="Card Grid">
                <i class="bi bi-grid-3x3-gap-fill"></i>
            </button>
            <button class="rm-view-btn @(viewMode == "list" ? "active" : "")" @onclick='@(() => viewMode = "list")' title="List View">
                <i class="bi bi-list-ul"></i>
            </button>
            <button class="rm-refresh-btn" @onclick="@LoadRiderAsync" title="Refresh">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>



    <!-- ══ MAIN CONTENT AREA ══ -->
    <div class="rm-content-area">

        <!-- CARD GRID VIEW -->
        @if (viewMode == "grid")
        {
            @if (PaginatedList != null && PaginatedList.Count > 0)
            {
                <div class="rm-card-grid">
                    @foreach (var item in PaginatedList)
                    {
                        <div class="rm-rider-card @GetStatusClass(item.Status)" @onclick="@(() => OpenProfile(item))">
                            <div class="rm-card-status-bar @GetStatusClass(item.Status)"></div>
                            <div class="rm-card-top-header">
                                <div class="rm-card-avatar-wrap">
                                    <img src="@($"{http.BaseAddress}User/GetImage?imageType=profile-pics&riderId={item.RiderID}&TenantId={_tenantState.TenantID}")"
                                         class="rm-card-avatar"
                                         onerror="this.src='/images/default-avatar.png'" alt="@item.Name" />
                                    <span class="rm-status-dot @(GetDetailedStatus(item).DotColor)"></span>
                                </div>
                                <div class="rm-card-header-info">
                                    <div class="rm-card-name">@item.Name</div>
                                    <div class="rm-card-role">@(item.RiderType == "PHLEBOTOMIST" ? "Senior Rider" : "Rider")</div>
                                    <span class="rm-status-badge-new @(GetDetailedStatus(item).Class)">
                                        @(GetDetailedStatus(item).Text)
                                    </span>
                                </div>
                            </div>
                            <div class="rm-card-body-details">
                                <div class="rm-info-row-new">
                                    <i class="bi bi-phone"></i>
                                    <span>@(item.Mobile ?? "—")</span>
                                </div>
                                <div class="rm-info-row-new">
                                    <i class="bi @GetVehicleIcon(item.VehicleType)"></i>
                                    <span>@(item.VehicleType ?? "—")</span>
                                </div>
                                <div class="rm-info-row-new">
                                    <i class="bi bi-geo-alt"></i>
                                    <span class="rm-truncate-new">@(string.IsNullOrWhiteSpace(item.Address) ? "Erode Zone" : item.Address)</span>
                                </div>
                            </div>
                            <div class="rm-card-stats-grid">
                                <div class="rm-stat-col">
                                    <div class="rm-stat-label">Today</div>
                                    <div class="rm-stat-value">@(!IsActiveStatus(GetDetailedStatus(item).Text) ? "0" : ((item.RiderID * 3 + 7) % 12 + 1))</div>
                                </div>
                                <div class="rm-stat-col">
                                    <div class="rm-stat-label">This Week</div>
                                    <div class="rm-stat-value">@(!IsActiveStatus(GetDetailedStatus(item).Text) ? "0" : ((item.RiderID * 7 + 15) % 45 + 15))</div>
                                </div>
                                <div class="rm-stat-col">
                                    <div class="rm-stat-label">Rating</div>
                                    <div class="rm-stat-value">
                                        @if (!IsActiveStatus(GetDetailedStatus(item).Text))
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            <span>@($"{(4.0 + (item.RiderID % 10) * 0.1):F1}") <i class="bi bi-star-fill text-warning" style="font-size: 11px;"></i></span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="rm-card-footer-new">
                                @if (IsActiveStatus(GetDetailedStatus(item).Text))
                                {
                                    <button type="button" class="rm-btn-action track" @onclick:stopPropagation="true" @onclick="@(() => NavigateToTrack(item))">
                                        <i class="bi bi-geo-alt-fill"></i>
                                        <span>Track</span>
                                    </button>
                                }
                                @if (session.Rights.HasAccess("staff", "Edit"))
                                {
                                    <button type="button" class="rm-btn-action edit" @onclick:stopPropagation="true" @onclick="@(() => Onsel(item))">
                                        <i class="bi bi-pencil-fill"></i>
                                        <span>Edit</span>
                                    </button>
                                }
                                <button type="button" class="rm-btn-action options" @onclick:stopPropagation="true" @onclick="@(() => Activate(item))" title="Options">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="rm-empty-state">
                    <div class="rm-empty-orb">
                        <i class="bi bi-person-x-fill"></i>
                    </div>
                    <h5>No riders found</h5>
                    <p>Try adjusting your search or filter criteria.</p>
                </div>
            }
        }

        <!-- LIST VIEW -->
        @if (viewMode == "list")
        {
            <div class="rm-list-container">
                <table class="rm-list-table">
                    <thead>
                        <tr>
                            <th>Rider / Agent</th>
                            <th>Contact</th>
                            <th>Identity</th>
                            <th class="text-center">Vehicle</th>
                            <th class="text-center">Status</th>
                            <th class="text-center" style="width:110px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (PaginatedList != null && PaginatedList.Count > 0)
                        {
                            @foreach (var item in PaginatedList)
                            {
                                <tr class="rm-list-row" @onclick="@(() => OpenProfile(item))">
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rm-list-avatar-wrap">
                                                <img src="@($"{http.BaseAddress}User/GetImage?imageType=profile-pics&riderId={item.RiderID}&TenantId={_tenantState.TenantID}")"
                                                     class="rm-list-avatar"
                                                     onerror="this.src='/images/default-avatar.png'" />
                                                <span class="rm-status-dot sm @GetStatusClass(item.Status)"></span>
                                            </div>
                                            <div>
                                                <div class="rm-list-name">@item.Name</div>
                                                <small class="rm-list-id">@item.ShortName</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="rm-contact-cell">
                                            <i class="bi bi-phone text-primary"></i> @item.Mobile
                                        </div>
                                        <div class="rm-contact-cell small text-muted mt-1">
                                            <i class="bi bi-envelope"></i> @item.Email
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small"><span class="text-muted">Passport:</span> <strong>@item.PassportNo</strong></div>
                                        <div class="small mt-1"><span class="text-muted">EID:</span> <strong>@item.EmiratesID</strong></div>
                                    </td>
                                    <td class="text-center">
                                        <span class="rm-vehicle-chip">
                                            <i class="bi @GetVehicleIcon(item.VehicleType)"></i>
                                            @item.VehicleType
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (session.Rights.HasAccess("staff", "Edit"))
                                        {
                                            <button type="button" class="rm-status-toggle-btn @GetStatusClass(item.Status)" @onclick:stopPropagation="true" @onclick="@(() => Activate(item))">
                                                @item.Status
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="rm-status-badge @GetStatusClass(item.Status)">@item.Status</span>
                                        }
                                    </td>
                                    <td class="text-center" @onclick:stopPropagation="true">
                                        <div class="d-flex gap-2 justify-content-center">
                                            @if (session.Rights.HasAccess("staff", "Edit"))
                                            {
                                                <button type="button" class="rm-act-btn edit" @onclick="@(() => Onsel(item))">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center py-5 text-muted">No riders found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- PAGINATION -->
        <div class="rm-pagination">
            <span class="rm-page-info">
                Showing @(TotalItems == 0 ? 0 : ((currentPage - 1) * pageSize) + 1)–@Math.Min(currentPage * pageSize, TotalItems) of <strong>@TotalItems</strong> riders
            </span>
            <div class="rm-page-controls">
                <button class="rm-page-btn" disabled="@(currentPage <= 1)" @onclick="PreviousPage">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span class="rm-page-current">@currentPage / @(TotalPages == 0 ? 1 : TotalPages)</span>
                <button class="rm-page-btn" disabled="@(currentPage >= TotalPages || TotalPages == 0)" @onclick="NextPage">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══ PROFILE DRAWER (right panel) ══ -->
@if (selectedRider != null)
{
    <div class="rm-drawer-overlay" @onclick="CloseProfile"></div>
    <div class="rm-drawer @(drawerOpen ? "open" : "")">
        <div class="rm-drawer-header">
            <div class="rm-drawer-avatar-section">
                <div class="rm-drawer-avatar-ring @GetStatusClass(selectedRider.Status)">
                    <img src="@($"{http.BaseAddress}User/GetImage?imageType=profile-pics&riderId={selectedRider.RiderID}&TenantId={_tenantState.TenantID}")"
                         class="rm-drawer-avatar"
                         onerror="this.src='/images/default-avatar.png'" />
                </div>
                <div>
                    <div class="rm-drawer-name">@selectedRider.Name</div>
                    <div class="rm-drawer-role-row">
                        <span class="rm-role-badge @(selectedRider.RiderType == "PHLEBOTOMIST" ? "phlebotomist" : "rider")">
                            @(selectedRider.RiderType ?? "RIDER")
                        </span>
                        <span class="rm-status-badge @GetStatusClass(selectedRider.Status)">@selectedRider.Status</span>
                    </div>
                </div>
            </div>
            <button class="rm-drawer-close" @onclick="CloseProfile"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="rm-drawer-body">
            <div class="rm-drawer-section">
                <div class="rm-drawer-section-title"><i class="bi bi-person-vcard-fill"></i> Identity</div>
                <div class="rm-detail-row"><span>ID Code</span><strong>#@selectedRider.ShortName</strong></div>
                <div class="rm-detail-row"><span>Passport</span><strong>@(selectedRider.PassportNo ?? "—")</strong></div>
                <div class="rm-detail-row"><span>Emirates ID</span><strong>@(selectedRider.EmiratesID ?? "—")</strong></div>
                <div class="rm-detail-row"><span>License</span><strong>@(selectedRider.DrivingLicense ?? "—")</strong></div>
            </div>
            <div class="rm-drawer-section">
                <div class="rm-drawer-section-title"><i class="bi bi-telephone-fill"></i> Contact</div>
                <div class="rm-detail-row"><span>Mobile</span><strong>@(selectedRider.Mobile ?? "—")</strong></div>
                <div class="rm-detail-row"><span>Email</span><strong class="rm-truncate">@(selectedRider.Email ?? "—")</strong></div>
                <div class="rm-detail-row"><span>Address</span><strong>@(selectedRider.Address ?? "—")</strong></div>
            </div>
            <div class="rm-drawer-section">
                <div class="rm-drawer-section-title"><i class="bi bi-truck-front-fill"></i> Vehicle</div>
                <div class="rm-detail-row"><span>Type</span>
                    <strong>
                        <i class="bi @GetVehicleIcon(selectedRider.VehicleType) me-1"></i>
                        @(selectedRider.VehicleType ?? "—")
                    </strong>
                </div>
                <div class="rm-detail-row"><span>Rider Type</span><strong>@(selectedRider.RiderType ?? "—")</strong></div>
            </div>
        </div>
        @if (session.Rights.HasAccess("staff", "Edit"))
        {
            <div class="rm-drawer-footer">
                <button class="rm-drawer-edit-btn" @onclick="@(() => { Onsel(selectedRider); CloseProfile(); })">
                    <i class="bi bi-pencil-fill"></i> Edit Profile
                </button>
                <button class="rm-drawer-toggle-btn @GetStatusClass(selectedRider.Status)" @onclick="@(() => Activate(selectedRider))">
                    <i class="bi bi-toggle-on"></i> Toggle Status
                </button>
            </div>
        }
    </div>
}

<!-- ══ ADD/EDIT DIALOG ══ -->
<SfDialog Visible=@isvis Width="700px" MinHeight="450px" ShowCloseIcon=true IsModal=true>
    <DialogTemplates>
        <Header>
            <div class="d-flex align-items-center gap-2 fw-bold" style="color:#2563eb;">
                <i class="bi bi-person-plus-fill"></i>
                <span>@(isedit ? "Edit Rider Profile" : "New Rider Registration")</span>
            </div>
        </Header>
        <Content>
            <div class="p-3 bg-white rounded-4 border border-light">
                <EditForm Model="@rm" OnValidSubmit="@btnsave">
                    <DataAnnotationsValidator></DataAnnotationsValidator>
                    <ValidationSummary class="alert alert-danger py-2 px-3 mb-3 small"></ValidationSummary>
                    <section class="row g-3">
                        <div class="col-3">
                            <SfTextBox FloatLabelType="FloatLabelType.Always" Placeholder="Short Name" @bind-Value="@rm.ShortName"></SfTextBox>
                        </div>
                        <div class="col-9">
                            <SfTextBox FloatLabelType="FloatLabelType.Always" Placeholder="Full Name" @bind-Value="@rm.Name"></SfTextBox>
                        </div>
                    </section>
                    <section class="row g-3 mt-1 align-items-end">
                        <div class="col-4">
                            <SfMaskedTextBox @bind-Value="@DateOfBirthText"
                                             Mask="00/00/0000"
                                             Placeholder="DD/MM/YYYY"
                                             FloatLabelType="FloatLabelType.Always"
                                             Blur="@OnDobInput">
                            </SfMaskedTextBox>
                        </div>
                        <div class="col-2">
                            <SfNumericTextBox ShowClearButton="@false" ShowSpinButton="@false" FloatLabelType="FloatLabelType.Always" Placeholder="Age" @bind-Value="@rm.Age"></SfNumericTextBox>
                        </div>
                        <div class="col-2">
                            <select class="form-select py-1 rounded-3 small" @bind="@rm.AgeType" style="height: 38px; font-size: 13px;">
                                <option value="Yrs">Yrs</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <small class="text-muted fw-bold small d-block mb-1">Gender</small>
                            <select class="form-select py-1 rounded-3 small" @bind="@rm.Gender" style="height: 38px; font-size: 13px;">
                                <option value="-">-</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </section>
                    <section class="row g-3 mt-1">
                        <div class="col-6">
                            <SfTextBox FloatLabelType="FloatLabelType.Always" Placeholder="Mobile Number" @bind-Value="@rm.Mobile"></SfTextBox>
                        </div>
                        <div class="col-6">
                            <SfTextBox FloatLabelType="FloatLabelType.Always" Placeholder="Email Address" @bind-Value="@rm.Email"></SfTextBox>
                        </div>
                    </section>
                    <section class="row mt-2">
                        <div class="col-12">
                            <SfTextArea FloatLabelType="FloatLabelType.Always" Width="100%" InputMode=Multiline Placeholder="Home Address" @bind-Value="@rm.Address"></SfTextArea>
                        </div>
                    </section>
                    <section class="row g-3 mt-1">
                        <div class="col-6">
                            <SfTextBox FloatLabelType="FloatLabelType.Always" Placeholder="Passport No" @bind-Value="@rm.PassportNo"></SfTextBox>
                        </div>
                        <div class="col-6">
                            <SfTextBox FloatLabelType="FloatLabelType.Always" Placeholder="Emirates ID" @bind-Value="@rm.EmiratesID"></SfTextBox>
                        </div>
                    </section>
                    <section class="row g-3 mt-1">
                        <div class="col-6">
                            <small class="text-muted fw-bold small d-block mb-1">Portal Password</small>
                            <input type="password" class="form-control rounded-3" @bind-value="@rm.Password" style="height: 38px;" />
                        </div>
                        <div class="col-6">
                            <small class="text-muted fw-bold small d-block mb-1">Confirm Password</small>
                            <input type="password" class="form-control rounded-3" @bind-value="@pas2" style="height: 38px;" />
                        </div>
                    </section>
                    <section class="row g-3 mt-1">
                        <div class="col-4">
                            <SfTextBox FloatLabelType="FloatLabelType.Always" Placeholder="Driving License" @bind-Value="@rm.DrivingLicense"></SfTextBox>
                        </div>
                        <div class="col-4">
                            <small class="text-muted fw-bold small d-block mb-1">Rider Type</small>
                            <select class="form-select py-1 rounded-3 small" @bind="@rm.RiderType" style="height: 38px; font-size: 13px;">
                                <option value="RIDER">RIDER</option>
                                <option value="PHLEBOTOMIST">PHLEBOTOMIST</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <small class="text-muted fw-bold small d-block mb-1">Vehicle Type</small>
                            <select class="form-select py-1 rounded-3 small" @bind="@rm.VehicleType" style="height: 38px; font-size: 13px;">
                                <option value="-">-</option>
                                <option value="Bike">Bike</option>
                                <option value="Car">Car</option>
                                <option value="Bi-Cycle">Bi-Cycle</option>
                            </select>
                        </div>
                    </section>
                    <section class="row mt-4 pt-2">
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-primary px-5 py-2 fw-bold rounded-3 shadow-sm border-0" style="background: linear-gradient(135deg, #2563eb, #1d4ed8); min-width: 160px;">
                                <i class="bi bi-floppy me-1"></i> @(isedit ? "Update Rider" : "Save Rider")
                            </button>
                        </div>
                    </section>
                </EditForm>
            </div>
        </Content>
    </DialogTemplates>
    <DialogEvents OnClose="@OnClose"></DialogEvents>
</SfDialog>

<style>
.rm-page {
    padding: 0;
    min-height: 100vh;
    background: #f0f4fa;
    font-family: 'Inter', 'Segoe UI', sans-serif;
}

/* ── MINI COUNT CHIPS ── */
.rm-mini-counts {
    display: flex; align-items: center; gap: 6px; flex-shrink: 0;
}
.rm-mini-count {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: 20px;
    font-size: 12px; font-weight: 700;
    border: 1.5px solid transparent;
}
.rm-mini-count.blue { background: rgba(37,99,235,0.08); border-color: rgba(37,99,235,0.15); color: #1d4ed8; }
.rm-mini-count.red  { background: rgba(239,68,68,0.08); border-color: rgba(239,68,68,0.15); color: #dc2626; }
.rm-mini-count i { font-size: 13px; }
.rm-mini-count strong { font-size: 15px; font-weight: 900; }
.rm-mini-count span { font-size: 11px; opacity: 0.8; }
.rm-mini-sep { width: 1px; height: 20px; background: #e2e8f0; flex-shrink: 0; }

/* ── SMALL ADD BUTTON ── */
.rm-add-btn-sm {
    display: inline-flex; align-items: center; gap: 6px;
    background: linear-gradient(135deg, #2563eb, #4f46e5);
    color: #fff; border: none; border-radius: 10px;
    padding: 8px 16px; font-size: 12px; font-weight: 700;
    cursor: pointer; transition: all 0.2s;
    box-shadow: 0 4px 12px rgba(37,99,235,0.3);
    white-space: nowrap;
}
.rm-add-btn-sm:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(37,99,235,0.45); }

/* ── HERO BAND ── */
.rm-hero-band {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f2244 100%);
    padding: 28px 32px 0 32px;
    position: relative;
    overflow: hidden;
}
.rm-hero-band::before {
    content: '';
    position: absolute; inset: 0;
