.rm-empty-state p { color: #94a3b8; font-size: 13px; }

/* ── PAGINATION ── */
.rm-pagination {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 4px;
}
.rm-page-info { font-size: 13px; color: #64748b; }
.rm-page-controls { display: flex; align-items: center; gap: 12px; }
.rm-page-btn {
    width: 36px; height: 36px; border-radius: 10px;
