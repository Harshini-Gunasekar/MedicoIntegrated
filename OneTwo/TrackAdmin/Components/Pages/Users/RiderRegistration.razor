.pill-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
.pill-dot.green { background: #10b981; } .pill-dot.amber { background: #f59e0b; } .pill-dot.red { background: #ef4444; }
.rm-toolbar-right { display: flex; align-items: center; gap: 8px; margin-left: auto; }
.rm-view-btn, .rm-refresh-btn {
