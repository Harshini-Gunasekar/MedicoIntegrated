.rm-card-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 14px 20px;
    background: #f8fafc;
    border-bottom: 1px solid #f1f5f9;
}
.rm-stat-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-right: 1px solid #e2e8f0;
}
.rm-stat-col:last-child {
    border-right: none;
}
.rm-stat-label {
    font-size: 10px;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    margin-bottom: 4px;
}
.rm-stat-value {
    font-size: 13px;
    font-weight: 800;
    color: #0f172a;
}

.rm-card-footer-new {
    padding: 12px 20px;
    display: flex;
    gap: 8px;
    align-items: center;
}
.rm-btn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 36px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    border: 1.5px solid #cbd5e1;
    background: #fff;
    color: #475569;
}
.rm-btn-action.track {
    background: rgba(37,99,235,0.06);
    border-color: rgba(37,99,235,0.15);
    color: #2563eb;
    flex: 1.2;
}
.rm-btn-action.track:hover {
    background: #2563eb;
    color: #fff;
    border-color: #2563eb;
}
.rm-btn-action.edit {
    color: #2563eb;
    border-color: rgba(37,99,235,0.15);
    flex: 1;
}
.rm-btn-action.edit:hover {
    background: rgba(37,99,235,0.05);
}
.rm-btn-action.options {
    width: 36px;
    padding: 0;
    flex-shrink: 0;
    color: #64748b;
}
.rm-btn-action.options:hover {
    background: #f1f5f9;
    color: #0f172a;
}

@@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
</style>

@code {
    string api = "";
    [Inject] IOptions<APIConfiguration> ApiConfig { get; set; }
    Rider_Master rm = new();
    bool isvis = false;
    private void OnClose() { isvis = false; }

    string chk = "1";
    string viewMode = "grid";
    string activeFilter = "all";
    Rider_Master? selectedRider = null;
    bool drawerOpen = false;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            var res = await protectedSessionStore.GetAsync<string>("TenantID");
            if (res.Success) _tenantState.TenantID = res.Value;
            api = ApiConfig.Value.BaseApiUrl;
            this.LoadRiderAsync();
        }
    }

    // Pagination & Search State
    private int currentPage = 1;
    private int pageSize = 12;
    private string _searchTerm = "";
    private string searchTerm
    {
        get => _searchTerm;
        set { _searchTerm = value; currentPage = 1; }
    }

    private IEnumerable<Rider_Master> FilteredRiderList => rider
        .Where(x => string.IsNullOrWhiteSpace(searchTerm) ||
                    (x.Name ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (x.Mobile ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (x.Email ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (x.ShortName ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private IList<Rider_Master> PaginatedList => FilteredRiderList
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    private int TotalItems => FilteredRiderList.Count();
    private int TotalPages => (int)Math.Ceiling(TotalItems / (double)pageSize);

    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void PreviousPage() { if (currentPage > 1) currentPage--; }

    IList<Rider_Master> rider = new List<Rider_Master>();
    IList<Rider_Master> rider1 = new List<Rider_Master>();

    private async Task LoadRiderAsync()
    {
        if (string.IsNullOrEmpty(_tenantState.TenantID))
        {
            var resStore = await protectedSessionStore.GetAsync<string>("TenantID");
            if (resStore.Success) _tenantState.TenantID = resStore.Value;
        }

        var request = new HttpRequestMessage(HttpMethod.Get, $"{api}User/AllUsers");
        request.Headers.Add("TenantId", _tenantState.TenantID ?? "");

        var res = await http.SendAsync(request);
        if (res.IsSuccessStatusCode)
        {
            var tt = await res.Content.ReadAsStringAsync();
            rider1 = JsonConvert.DeserializeObject<IList<Rider_Master>>(tt) ?? new List<Rider_Master>();
            foreach (var r in rider1) { trac.TrimAllStrings(r); }
            rider = rider1;
        }
        // Update top header
        Metadata.UpdatePage(
            "Rider Master",
            "Fleet personnel management & registration",
            "bi-people-fill",
            new List<TrackAdmin.Data.PageStat>
            {
                new TrackAdmin.Data.PageStat { Label = "Total Fleet", Value = rider1.Count.ToString() },
                new TrackAdmin.Data.PageStat { Label = "Inactive", Value = rider1.Count(x => x.Status == "Deactive").ToString(), Color = "text-danger" }
            }
        );
        StateHasChanged();
    }

    private void SetFilter(string filter)
    {
        activeFilter = filter;
        currentPage = 1;
        rider = filter switch
        {
            "Active" => rider1.Where(x => x.Status == "Active").ToList(),
            "New" => rider1.Where(x => x.Status == "New").ToList(),
            "Deactive" => rider1.Where(x => x.Status == "Deactive").ToList(),
            _ => rider1.ToList()
        };
        StateHasChanged();
    }

    private void OpenProfile(Rider_Master item)
    {
        selectedRider = item;
        drawerOpen = true;
        StateHasChanged();
    }

    private void CloseProfile()
    {
        drawerOpen = false;
        Task.Delay(350).ContinueWith(_ => { selectedRider = null; InvokeAsync(StateHasChanged); });
    }

    private string GetStatusClass(string? status) => status?.ToLower() switch
    {
        "active" => "active-status",
        "new" => "new-status",
        "deactive" => "deactive-status",
        _ => "deactive-status"
    };

    private string GetVehicleIcon(string? vehicle) => vehicle?.ToLower() switch
    {
        "car" => "bi-car-front-fill",
        "bike" => "bi-scooter",
        "bi-cycle" => "bi-bicycle",
        _ => "bi-truck"
    };

    private async Task addnew()
    {
        rm = new();
        isvis = !isvis;
    }

    private async Task btnsave()
    {
        rm.ShortName = rm.ShortName?.Trim() ?? "";
        rm.Address = rm.Address?.Trim() ?? "";
        rm.PassportNo = rm.PassportNo?.Trim() ?? "";
        rm.EmiratesID = rm.EmiratesID?.Trim() ?? "";
        rm.AgeType = rm.AgeType?.Trim() ?? "Yrs";
        rm.Gender = rm.Gender?.Trim() ?? "-";
        rm.DrivingLicense = rm.DrivingLicense?.Trim() ?? "";
        rm.VehicleType = rm.VehicleType?.Trim() ?? "";
        rm.RiderType = rm.RiderType?.Trim()?.ToUpper() ?? "RIDER";
        rm.Status = rm.Status?.Trim() ?? "New";
        rm.EnteredDate = DateTime.Now;
        rm.ModifiedDate = DateTime.Now;
        if (rm.Password == pas2)
        {
            var targetUrl = isedit ? $"{api}user/UpdateRider" : $"{api}user/Registration";
            var request = new HttpRequestMessage(HttpMethod.Post, targetUrl);
            request.Headers.Add("TenantId", _tenantState.TenantID);
            request.Content = JsonContent.Create(rm);

            var res = await http.SendAsync(request);
            if (isedit) isedit = false;

            if (res.IsSuccessStatusCode)
            {
                await dp.AlertAsync("Successfully Saved");
                rm = new();
                isvis = false;
                await LoadRiderAsync();
            }
            else
            {
                await dp.AlertAsync(res.Content.ReadAsStringAsync().Result);
            }
        }
        else
        {
            await dp.AlertAsync("Password Mismatch. Try again");
        }
    }

    private async Task OnDobInput(MaskBlurEventArgs args)
    {
        var dobString = args?.MaskedValue?.ToString();
        if (DateTime.TryParseExact(dobString, "dd/MM/yyyy", null, System.Globalization.DateTimeStyles.None, out var parsedDob))
        {
            IsValidDate = true;
            CalculateAge(parsedDob);
            if (DateTime.TryParseExact(dobString, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var dob))
            {
                rm.DateofBirth = DateTime.Parse(dob.ToString("yyyy-MM-dd"));
            }
        }
        else
        {
            IsValidDate = false;
            AgeYears = AgeMonths = AgeDays = 0;
        }
        StateHasChanged();
    }

    private string DateOfBirthText { get; set; } = "";
    private int AgeYears; private int AgeMonths; private int AgeDays;
    private bool IsValidDate = false;

    private void CalculateAge(DateTime dob)
    {
        var today = DateTime.Today;
        if (dob > today) { AgeYears = AgeMonths = AgeDays = 0; return; }
        AgeYears = today.Year - dob.Year;
        AgeMonths = today.Month - dob.Month;
        AgeDays = today.Day - dob.Day;
        if (AgeDays < 0) { AgeMonths--; var prev = today.AddMonths(-1); AgeDays += DateTime.DaysInMonth(prev.Year, prev.Month); }
        if (AgeMonths < 0) { AgeYears--; AgeMonths += 12; }
        string agetype = "";
        if (AgeYears > 0) { age = AgeYears; agetype = "Yrs"; }
        else if (AgeMonths > 0) { age = AgeMonths; agetype = "Mths"; }
        else { age = AgeDays; agetype = "Days"; }
        rm.Age = age; rm.AgeType = agetype;
    }

    int riderid = 0; int age = 0; string agetype = "";
    string gender = ""; string password = "";
    string pas1 = ""; string pas2 = "";
    bool isedit = false;

    private async Task Onsel(Rider_Master args)
    {
        rm = new();
        rm = args;
        DateOfBirthText = rm.DateofBirth.ToString("dd-MM-yyyy");
        isvis = !isvis;
        isedit = true;
    }

    private async Task Activate(Rider_Master args)
    {
        try
        {
            isvis = false;
            Rider_Master rm1 = args;
            string stat = args.Status switch
            {
                "New" => "Active",
                "Active" => "Deactive",
                "Deactive" => "Active",
                _ => "Active"
            };
            bool isConfirm = await dp.ConfirmAsync($"Change {rm1.Name} status to {stat}?", "Change Rider Status");
            if (isConfirm)
            {
                var updateReq = new { RiderID = rm1.RiderID, Status = stat };
                var request = new HttpRequestMessage(HttpMethod.Post, $"{api}user/UpdateRiderActivationStatus");
                request.Headers.Add("TenantId", _tenantState.TenantID);
                request.Content = JsonContent.Create(updateReq);
                var res = await http.SendAsync(request);
                if (res.IsSuccessStatusCode)
                {
                    await dp.AlertAsync("Status Updated");
                    await LoadRiderAsync();
                }
            }
        }
        catch (Exception ex) { var msg = ex.Message.ToString(); }
    }

    private async Task StatusFilter(ChangeEventArgs args)
    {
        var value = args?.Value?.ToString();
        currentPage = 1;
        rider = value switch
        {
            "1" => rider1.ToList(),
            "2" => rider1.Where(x => x.Status == "New").ToList(),
            "3" => rider1.Where(x => x.Status == "Active").ToList(),
            "4" => rider1.Where(x => x.Status == "Deactive").ToList(),
            _ => rider1.ToList()
        };
    }

    private (string Text, string Class, string DotColor) GetDetailedStatus(Rider_Master item)
    {
        string statusLower = item.Status?.Trim()?.ToLower() ?? "";
        if (statusLower == "deactive")
        {
            return ("Deactive", "inactive", "red");
        }

        string defaultStatus = (statusLower == "active" || statusLower == "new") ? "online" : "offline";
        string curStat = item.CurrentStatus?.Trim()?.ToLower() ?? defaultStatus;
        if (string.IsNullOrWhiteSpace(curStat))
        {
            curStat = defaultStatus;
        }

        return curStat switch
        {
            "online" => ("Online", "available", "green"),
            "active" => ("Online", "available", "green"),
            "available" => ("Online", "available", "green"),
            "intransit" => ("Online", "available", "green"),
            "offline" => ("Offline", "inactive", "red"),
            "away" => ("Offline", "inactive", "red"),
            "loggedout" => ("Offline", "inactive", "red"),
            "on-hold" => ("On-Hold", "on-delivery", "amber"),
            "onhold" => ("On-Hold", "on-delivery", "amber"),
            "on hold" => ("On-Hold", "on-delivery", "amber"),
            "busy" => ("Busy", "on-delivery", "amber"),
            "engaged" => ("Busy", "on-delivery", "amber"),
            "permission" => ("Permission", "on-leave", "gray"),
            "on-leave" => ("Permission", "on-leave", "gray"),
            "onleave" => ("Permission", "on-leave", "gray"),
            _ => (item.CurrentStatus ?? "Offline", "inactive", "red")
        };
    }

    private void NavigateToTrack(Rider_Master item)
    {
        Navigation.NavigateTo($"/Maps");
    }

    private bool IsActiveStatus(string statusText)
    {
        return statusText == "Online" || statusText == "On-Hold" || statusText == "On Delivery" || statusText == "Busy";
    }
}
