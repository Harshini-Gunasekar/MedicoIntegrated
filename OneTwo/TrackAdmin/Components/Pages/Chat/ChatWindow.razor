    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private HubConnection? hubConnection;
    private List<ChatMessage> messages = new();
    private string _newMessage = "";
    private string newMessage
    {
        get => _newMessage;
        set
        {
            if (_newMessage != value)
            {
                _newMessage = value;
                _ = OnNewMessageInput(value);
            }
        }
    }
    private string? currentlyLoadingRiderId;
    private int tempUploadCounter = 0;
    private bool isLoading = true;
    private bool isUploadingPhoto = false; // Bug 2: photo upload loading indicator

    // Chat Upgrade state variables
    private bool isRiderTyping = false;
    private bool isRiderRecordingVoice = false;
    private HashSet<int> preloadedAudioMessageIds = new();
    private string? galleryPhotoUrl;
    private bool isRecording = false;
    private int recordDuration = 0;
    private System.Threading.Timer? recordTimer;
    private bool showEmojiPicker = false;
    private System.Threading.Timer? typingTimer;
    private bool isTypingSent = false;
    private readonly string[] emojis = new[] { "😀", "😃", "😄", "😁", "😆", "😅", "😂", "🤣", "😊", "😇", "🙂", "🙃", "😉", "😌", "😍", "🥰", "😘", "😗", "😙", "😚", "😋", "😛", "😝", "😜", "🤪", "🤨", "🧐", "🤓", "😎", "🤩", "🥳", "😏", "😒", "😞", "😔", "😟", "😕", "🙁", "☹️", "😣", "😖", "😫", "😩", "🥺", "😢", "😭", "😤", "😠", "😡", "🤬", "🤯", "😳", "🥵", "🥶", "😱", "😨", "😰", "😥", "😓", "🤗", "🤔", "🤭", "🤫", "🤥", "😶", "😐", "😑", "😬", "🙄", "😯", "😦", "😧", "😮", "😲", "🥱", "😴", "🤤", "😪", "😵", "🤐", "🥴", "🤢", "🤮", "🤧", "😷", "🤒", "🤕" };

    // Contact List state variables
    private List<ChatMember> chatMembers = new();
    private Dictionary<int, int> unreadCounts = new();
    private string chatSearchQuery = "";
    private ChatMember? selectedMemberForDetails;

    private List<ChatMember> filteredMembers => chatMembers
        .Where(x => string.IsNullOrWhiteSpace(chatSearchQuery) || 
                    x.Name.Contains(chatSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (x.Mobile ?? "").Contains(chatSearchQuery))
        .OrderByDescending(x => x.LastMessageTime ?? DateTime.MinValue)
        .ToList();

    private string GetConnectionStatusText()
    {
        if (hubConnection == null) return "Offline";
        return hubConnection.State switch
        {
            HubConnectionState.Connected => "Connected",
            HubConnectionState.Connecting => "Connecting...",
            HubConnectionState.Reconnecting => "Reconnecting...",
            HubConnectionState.Disconnected => "Disconnected. Retrying...",
            _ => "Offline"
        };
    }

    private int getUnreadCount(int senderId)
    {
        return unreadCounts.TryGetValue(senderId, out var count) ? count : 0;
    }

    [Inject] IOptions<APIConfiguration> ApiConfig { get; set; }

    private string? previousRiderId;

    protected override async Task OnParametersSetAsync()
    {
        // 1. Establish session if not resolved
        if (session.UserID == 0 || string.IsNullOrWhiteSpace(_tenantState.TenantID))
        {
            try
            {
                var authState = await authStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                if (user.Identity != null && user.Identity.IsAuthenticated)
                {
                    var userIdClaim = user.FindFirst("sub")?.Value ?? user.FindFirst("UserIdentifier")?.Value;
                    if (int.TryParse(userIdClaim, out var parsedId))
                    {
                        session.UserID = parsedId;
                    }
                    var tenantId = user.FindFirst("TenantId")?.Value;
                    if (!string.IsNullOrEmpty(tenantId))
                    {
                        session.TenantID = tenantId;
                        _tenantState.TenantID = tenantId;
                    }
                    var nameClaim = user.FindFirst("unique_name")?.Value ?? user.Identity.Name;
                    if (!string.IsNullOrEmpty(nameClaim))
                    {
                        session.UserName = nameClaim;
                    }
                    session.IsLoggedIn = true;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error resolving user session in ChatWindow: " + ex.Message);
            }

            // Fallback to protectedSessionStore if authStateProvider failed to resolve
            if (session.UserID == 0 || string.IsNullOrWhiteSpace(_tenantState.TenantID))
            {
                var loginState = await protectedSessionStore.GetAsync<bool>("IsLoggedIn");
                if (loginState.Success && loginState.Value)
                {
                    var tenant = await protectedSessionStore.GetAsync<string>("TenantID");
                    var userId = await protectedSessionStore.GetAsync<int>("UserID");
                    var userName = await protectedSessionStore.GetAsync<string>("UserName");

                    session.IsLoggedIn = true;
                    session.TenantID = tenant.Success ? tenant.Value : null;
                    session.UserID = userId.Success ? userId.Value : 0;
                    session.UserName = userName.Success ? userName.Value : null;

                    _tenantState.TenantID = session.TenantID;
                }
            }
        }

        // 2. Load members & unread counts initially
        if (chatMembers.Count == 0)
        {
            await LoadMembers();
            await LoadUnreadCounts();
        }

        // If Rider is null, automatically select the most recent conversation
        if (Rider == null && chatMembers.Count > 0)
        {
            var mostRecentMember = filteredMembers.FirstOrDefault();
            if (mostRecentMember != null)
            {
                var nextRider = new RiderLocation
                {
                    RiderId = mostRecentMember.Id.ToString(),
                    RiderName = mostRecentMember.Name
                };
                Rider = nextRider;
            }
        }

        // 3. Switch conversation if Rider parameter changes
        if (Rider != null && Rider.RiderId != currentlyLoadingRiderId)
        {
            currentlyLoadingRiderId = Rider.RiderId;
            previousRiderId = Rider.RiderId;
            messages.Clear();
            isLoading = true;
            await LoadHistory();
            await InitializeSignalR();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (messages != null)
        {
            var voiceMsgs = messages.Where(m => m.MessageType == "Voice" && m.Id >= 0 && !preloadedAudioMessageIds.Contains(m.Id)).ToList();
            foreach (var msg in voiceMsgs)
            {
                preloadedAudioMessageIds.Add(msg.Id);
                var playerElementId = $"voice-player-{msg.Id}";
                var fileUrl = (msg.FilePath ?? "").StartsWith("data:", StringComparison.OrdinalIgnoreCase)
                    ? msg.FilePath
                    : $"{ApiConfig.Value.BaseApiUrl}Chat/file?path={Uri.EscapeDataString(msg.FilePath ?? "")}&TenantId={_tenantState.TenantID}";
                try
                {
                    await JS.InvokeVoidAsync("chatInterop.preloadDuration", fileUrl, playerElementId);
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Error preloading voice duration: " + ex.Message);
                }
            }
        }
    }

    private async Task LoadMembers()
    {
        try
        {
            var baseUrl = ApiConfig.Value.BaseApiUrl;
            var response = await Http.GetAsync($"{baseUrl}Chat/members?riderId={session.UserID}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                chatMembers = JsonConvert.DeserializeObject<List<ChatMember>>(json) ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading chat members: " + ex.Message);
        }
    }

    private async Task LoadUnreadCounts()
    {
        try
        {
            var baseUrl = ApiConfig.Value.BaseApiUrl;
            var response = await Http.GetAsync($"{baseUrl}Chat/unread-counts?recipientId={session.UserID}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var list = JsonConvert.DeserializeObject<List<ChatUnreadCount>>(json) ?? new();
                unreadCounts = list.ToDictionary(x => x.SenderId, x => x.UnreadCount);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading unread counts: " + ex.Message);
        }
    }

    private async Task SwitchActiveRider(ChatMember member)
    {
        var nextRider = new RiderLocation
        {
            RiderId = member.Id.ToString(),
            RiderName = member.Name
        };
        Rider = nextRider;
        currentlyLoadingRiderId = Rider.RiderId;
        previousRiderId = Rider.RiderId;

        // Bug 3 fix: Show skeleton loader BEFORE clearing messages to prevent empty-then-flicker
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        messages.Clear();
        preloadedAudioMessageIds.Clear();
        isRiderRecordingVoice = false;
        isRiderTyping = false;

        await LoadHistory();
        await InitializeSignalR();
    }

    private async Task InitializeSignalR()
    {
        try
        {
            if (hubConnection != null)
            {
                await hubConnection.DisposeAsync();
            }

            if (session.UserID == 0 || string.IsNullOrWhiteSpace(_tenantState.TenantID) || Rider == null)
            {
                return;
            }

            var rootUrl = ApiConfig.Value.BaseApiUrl.Replace("/api/", "/").TrimEnd('/');
            var hubUrl = $"{rootUrl}/chatHub?riderId={session.UserID}&TenantId={_tenantState.TenantID}";

            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<ChatMessage>("ReceiveMessage", async (message) =>
            {
                if ((message.SenderId == int.Parse(Rider.RiderId)) || 
                    (message.RecipientId == int.Parse(Rider.RiderId) && message.SenderId == session.UserID))
                {
                    messages.Add(message);
                    
                    if (message.SenderId == int.Parse(Rider.RiderId))
                    {
                        // Play notification sound for incoming rider messages
                        try { await JS.InvokeVoidAsync("chatInterop.playNotificationSound"); } catch { }

                        try
                        {
                            await hubConnection.InvokeAsync("MarkAsRead", message.SenderId, session.UserID);
                            unreadCounts[message.SenderId] = 0;
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine("Error calling MarkAsRead in ReceiveMessage: " + ex.Message);
                        }
                    }

                    await InvokeAsync(StateHasChanged);
                    await ScrollToBottom();
                }
                else
                {
                    // Update unread count for other members and play sound
                    if (unreadCounts.ContainsKey(message.SenderId))
                        unreadCounts[message.SenderId]++;
                    else
                        unreadCounts[message.SenderId] = 1;

                    // Play notification sound for messages from other riders too
                    try { await JS.InvokeVoidAsync("chatInterop.playNotificationSound"); } catch { }

                    await InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On<int>("MessagesDelivered", async (recipientId) =>
            {
                if (Rider != null && recipientId == int.Parse(Rider.RiderId))
                {
                    foreach (var msg in messages.Where(m => m.SenderId == session.UserID && !m.IsDelivered))
                    {
                        msg.IsDelivered = true;
                    }
                    await InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On<int>("MessagesRead", async (recipientId) =>
            {
                if (Rider != null && recipientId == int.Parse(Rider.RiderId))
                {
                    foreach (var msg in messages.Where(m => m.SenderId == session.UserID))
                    {
                        msg.IsDelivered = true;
                        msg.IsRead = true;
                    }
                    await InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On<int, string>("UserTyping", async (senderId, senderName) =>
            {
                if (Rider != null && senderId == int.Parse(Rider.RiderId))
                {
                    isRiderTyping = true;
                    await InvokeAsync(StateHasChanged);
                    await ScrollToBottom();
                }
            });

            hubConnection.On<int>("UserStoppedTyping", async (senderId) =>
            {
                if (Rider != null && senderId == int.Parse(Rider.RiderId))
                {
                    isRiderTyping = false;
                    await InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On<int, string>("UserRecordingVoice", async (senderId, senderName) =>
            {
                if (Rider != null && senderId == int.Parse(Rider.RiderId))
                {
                    isRiderRecordingVoice = true;
                    await InvokeAsync(StateHasChanged);
                    await ScrollToBottom();
                }
            });

            hubConnection.On<int>("UserStoppedRecordingVoice", async (senderId) =>
            {
                if (Rider != null && senderId == int.Parse(Rider.RiderId))
                {
                    isRiderRecordingVoice = false;
                    await InvokeAsync(StateHasChanged);
                }
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chat SignalR Connection failed: {ex.Message}");
        }
    }

    private async Task LoadHistory()
    {
        try
        {
            if (session.UserID == 0 || Rider == null) return;

            preloadedAudioMessageIds.Clear();
            isRiderRecordingVoice = false;
            isRiderTyping = false;

            var baseUrl = ApiConfig.Value.BaseApiUrl;
            var url = $"{baseUrl}Chat/history?riderId={session.UserID}&targetRiderId={Rider.RiderId}";
            
            var response = await Http.GetAsync(url);
            var tt = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                if (!string.IsNullOrWhiteSpace(tt) && (tt.Trim().StartsWith("[") || tt.Trim().StartsWith("{")))
                {
                    messages = JsonConvert.DeserializeObject<List<ChatMessage>>(tt) ?? new();

                    // Fix data inconsistency: if IsRead=true but IsDelivered=false, correct it
                    // This can happen if DB data was inserted before is_read column existed
                    foreach (var msg in messages)
                    {
                        if (msg.IsRead && !msg.IsDelivered)
                        {
                            msg.IsDelivered = true;
                        }
                    }

                    try
                    {
                        var markReadUrl = $"{baseUrl}Chat/mark-read";
                        await Http.PostAsJsonAsync(markReadUrl, new { SenderId = int.Parse(Rider.RiderId), RecipientId = session.UserID });
                        unreadCounts[int.Parse(Rider.RiderId)] = 0;

                        // Mark all messages from the rider as read in local state too
                        foreach (var msg in messages.Where(m => m.SenderId != session.UserID))
                        {
                            msg.IsRead = true;
                            msg.IsDelivered = true;
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine("Error calling mark-read in LoadHistory: " + ex.Message);
                    }
                }
                else
                {
                    messages = new();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception in LoadHistory: " + ex.Message);
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
            ScrollToBottom();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage) || Rider == null) return;

        var msg = new ChatMessage
        {
            SenderId = session.UserID,
            RecipientId = int.Parse(Rider.RiderId),
            MessageType = "Text",
            Content = newMessage,
            CreatedAt = DateTime.UtcNow
        };

        newMessage = "";

        // Bug 1 fix: Stop typing indicator immediately on send
        if (isTypingSent && hubConnection != null && hubConnection.State == HubConnectionState.Connected)
        {
            isTypingSent = false;
            try { await hubConnection.InvokeAsync("TypingStopped", int.Parse(Rider.RiderId)); } catch { }
        }
        if (typingTimer != null) { await typingTimer.DisposeAsync(); typingTimer = null; }

        await SendHubMessage(msg);
    }

    private async Task SendHubMessage(ChatMessage msg)
    {
        if (hubConnection == null || hubConnection.State != HubConnectionState.Connected)
        {
            await InitializeSignalR();
            if (hubConnection == null || hubConnection.State != HubConnectionState.Connected)
            {
                return;
            }
        }

        try
        {
            await hubConnection.InvokeAsync("SendMessage", msg);
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Chat: Error sending hub message: " + ex.Message);
        }
    }

    private async Task OnNewMessageInput(string val)
    {
        if (string.IsNullOrEmpty(val))
        {
            if (isTypingSent && hubConnection != null && hubConnection.State == HubConnectionState.Connected && Rider != null)
            {
                isTypingSent = false;
                try { await hubConnection.InvokeAsync("TypingStopped", int.Parse(Rider.RiderId)); } catch { }
            }
            if (typingTimer != null)
            {
                await typingTimer.DisposeAsync();
                typingTimer = null;
            }
            return;
        }

        if (hubConnection != null && hubConnection.State == HubConnectionState.Connected && Rider != null)
        {
            if (!isTypingSent)
            {
                isTypingSent = true;
                await hubConnection.InvokeAsync("TypingStarted", int.Parse(Rider.RiderId));
            }

            if (typingTimer != null)
            {
                await typingTimer.DisposeAsync();
            }

            typingTimer = new System.Threading.Timer(async _ =>
            {
                if (isTypingSent && hubConnection != null && hubConnection.State == HubConnectionState.Connected && Rider != null)
                {
                    isTypingSent = false;
                    await hubConnection.InvokeAsync("TypingStopped", int.Parse(Rider.RiderId));
                }
            }, null, 2000, System.Threading.Timeout.Infinite);
        }
    }

    private async Task StartVoiceRecording()
    {
        if (isRecording) return;
        
        bool started = await JS.InvokeAsync<bool>("chatInterop.startRecording");
        if (started)
        {
            isRecording = true;
            recordDuration = 0;

            if (hubConnection != null && hubConnection.State == HubConnectionState.Connected && Rider != null)
            {
                try { await hubConnection.InvokeAsync("RecordingVoiceStarted", int.Parse(Rider.RiderId)); } catch { }
            }

            recordTimer = new System.Threading.Timer(async _ =>
            {
                recordDuration++;
                if (recordDuration >= 60)
                {
                    await StopVoiceRecording();
                }
                await InvokeAsync(StateHasChanged);
            }, null, 1000, 1000);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopVoiceRecording()
    {
        if (!isRecording) return;

        isRecording = false;
        if (recordTimer != null)
        {
            await recordTimer.DisposeAsync();
            recordTimer = null;
        }

        if (hubConnection != null && hubConnection.State == HubConnectionState.Connected && Rider != null)
        {
            try { await hubConnection.InvokeAsync("RecordingVoiceStopped", int.Parse(Rider.RiderId)); } catch { }
        }

        string base64Audio = await JS.InvokeAsync<string>("chatInterop.stopRecording");
        if (!string.IsNullOrEmpty(base64Audio) && Rider != null)
        {
            var tempMsg = new ChatMessage
            {
                Id = -999 - tempUploadCounter++,
                SenderId = session.UserID,
                RecipientId = int.Parse(Rider.RiderId),
                MessageType = "Voice",
                Content = "Uploading...",
                FilePath = "",
                CreatedAt = DateTime.UtcNow
            };

            bool uploadSucceeded = false;
            try
            {
                messages.Add(tempMsg);
                await InvokeAsync(StateHasChanged);
                await ScrollToBottom();

                byte[] bytes = Convert.FromBase64String(base64Audio);
                using var stream = new MemoryStream(bytes);
                using var content = new MultipartFormDataContent();
                using var streamContent = new StreamContent(stream);

                // Detect actual mimeType from base64 header for correct content-type
                string detectedMime = "audio/webm";
                string detectedExt = "webm";
                if (base64Audio.Length > 4)
                {
                    // MediaRecorder on iOS/Safari produces mp4
                    string header = base64Audio.Substring(0, Math.Min(8, base64Audio.Length));
                    byte[] headerBytes = Convert.FromBase64String(header.PadRight(header.Length + (4 - header.Length % 4) % 4, '='));
                    if (headerBytes.Length >= 4 && headerBytes[0] == 0x00 && headerBytes[1] == 0x00 && headerBytes[2] == 0x00)
                    {
                        detectedMime = "audio/mp4";
                        detectedExt = "m4a";
                    }
                    else if (headerBytes.Length >= 4 && headerBytes[0] == 0x4F && headerBytes[1] == 0x67 && headerBytes[2] == 0x67)
                    {
                        detectedMime = "audio/ogg";
                        detectedExt = "ogg";
                    }
                }

                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(detectedMime);
                content.Add(streamContent, "file", $"voice_note.{detectedExt}");

                var baseUrl = ApiConfig.Value.BaseApiUrl;
                var response = await Http.PostAsync($"{baseUrl}Chat/uploadVoice", content);
                if (response.IsSuccessStatusCode)
                {
                    var resultJson = await response.Content.ReadAsStringAsync();
                    var result = JsonConvert.DeserializeAnonymousType(resultJson, new { FilePath = "" });
                    
                    if (result != null && !string.IsNullOrEmpty(result.FilePath))
                    {
                        messages.RemoveAll(m => m.Id == tempMsg.Id);
                        uploadSucceeded = true;

                        var msg = new ChatMessage
                        {
                            SenderId = session.UserID,
                            RecipientId = int.Parse(Rider.RiderId),
                            MessageType = "Voice",
                            Content = "",
                            FilePath = result.FilePath,
                            CreatedAt = DateTime.UtcNow
                        };
                        await SendHubMessage(msg);
                    }
                }
                else
                {
                    var errText = await response.Content.ReadAsStringAsync();
                    Console.WriteLine("Voice upload failed: " + errText);
                    await JS.InvokeVoidAsync("alert", "Failed to upload voice message: " + (string.IsNullOrWhiteSpace(errText) ? response.ReasonPhrase : errText));
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error processing voice upload: " + ex.Message);
                await JS.InvokeVoidAsync("alert", "Error uploading voice message: " + ex.Message);
            }
            finally
            {
                // Only remove temp message if upload didn't succeed (on success, already removed above)
                if (!uploadSucceeded)
                {
                    messages.RemoveAll(m => m.Id == tempMsg.Id);
                }
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task PlayVoiceMessage(string fileUrl, string playerElementId)
    {
        await JS.InvokeVoidAsync("chatInterop.playAudio", fileUrl, playerElementId);
    }

    private async Task TriggerPhotoInput()
    {
        await JS.InvokeVoidAsync("eval", "document.getElementById('photo-input').click()");
    }

    private async Task UploadPhotoFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || Rider == null) return;

        double sizeInMb = (double)file.Size / (1024 * 1024);
        if (sizeInMb > 5.0)
        {
            await JS.InvokeVoidAsync("alert", $"Image size exceeds the 5 MB limit (Selected: {sizeInMb:F2} MB). Please select an image smaller than 5 MB.");
            return;
        }

        string sizeStr = sizeInMb >= 0.1 ? $"{sizeInMb:F2} MB" : $"{(file.Size / 1024.0):F2} KB";

        var tempMsg = new ChatMessage
        {
            Id = -999 - tempUploadCounter++,
            SenderId = session.UserID,
            RecipientId = int.Parse(Rider.RiderId),
            MessageType = "Photo",
            Content = "Uploading...",
            FilePath = "",
            CreatedAt = DateTime.UtcNow
        };

        bool uploadSucceeded = false;
        try
        {
            messages.Add(tempMsg);
            isUploadingPhoto = true;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();

            // Buffer the file stream into memory to ensure reliability in Blazor Server
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            using var content = new MultipartFormDataContent();
            using var streamContent = new StreamContent(ms);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType ?? "image/jpeg");
            content.Add(streamContent, "file", file.Name);

            var baseUrl = ApiConfig.Value.BaseApiUrl;
            var response = await Http.PostAsync($"{baseUrl}Chat/uploadPhoto", content);
            if (response.IsSuccessStatusCode)
            {
                var resultJson = await response.Content.ReadAsStringAsync();
                var result = JsonConvert.DeserializeAnonymousType(resultJson, new { FilePath = "" });
                
                if (result != null && !string.IsNullOrEmpty(result.FilePath))
                {
                    uploadSucceeded = true;

                    // Update tempMsg in-place: change it from spinner to the real image.
                    // This avoids remove → blank flash → ReceiveMessage adds real msg race condition.
                    tempMsg.Content = "";
                    tempMsg.FilePath = result.FilePath;
                    await InvokeAsync(StateHasChanged);

                    // Wait a moment so browser starts loading the image before SignalR replaces tempMsg
                    await Task.Delay(300);

                    var msg = new ChatMessage
                    {
                        SenderId = session.UserID,
                        RecipientId = int.Parse(Rider.RiderId),
                        MessageType = "Photo",
                        Content = "",
                        FilePath = result.FilePath,
                        CreatedAt = DateTime.UtcNow
                    };
                    await SendHubMessage(msg);
                }
            }
            else
            {
                var errText = await response.Content.ReadAsStringAsync();
                Console.WriteLine("Upload photo failed: " + errText);
                await JS.InvokeVoidAsync("alert", $"Failed to upload photo (Size: {sizeStr}): " + (string.IsNullOrWhiteSpace(errText) ? response.ReasonPhrase : errText));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error uploading photo file: " + ex.Message);
            await JS.InvokeVoidAsync("alert", $"Error uploading photo (Size: {sizeStr}): " + ex.Message);
        }
        finally
        {
            // Always remove tempMsg (real message will arrive via SignalR ReceiveMessage)
            messages.RemoveAll(m => m.Id == tempMsg.Id);
            isUploadingPhoto = false;
            await InvokeAsync(StateHasChanged);
        }
    }

