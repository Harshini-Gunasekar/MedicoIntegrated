    private bool IsShiftChangeRequest(string content, out ShiftChangeRequest? request)
    {
        request = null;
        if (string.IsNullOrWhiteSpace(content)) return false;
        
        string trimmed = content.Trim();
        if (trimmed.StartsWith("{") && trimmed.EndsWith("}"))
        {
            try
            {
                var temp = JsonConvert.DeserializeObject<ShiftChangeRequest>(trimmed);
                if (temp != null && (!string.IsNullOrEmpty(temp.CurrentShiftName) || !string.IsNullOrEmpty(temp.RequestedShiftName)))
                {
                    request = temp;
                    if (request.Items == null) request.Items = new List<ShiftChangeRequestItem>();
                    if (request.Items.Count == 0)
                    {
                        request.Items.Add(new ShiftChangeRequestItem
                        {
                            CurrentShiftName = request.CurrentShiftName,
                            ShiftDetailsText = request.ShiftDetailsText,
                            RequestedShiftName = request.RequestedShiftName
                        });
                    }
                    return true;
                }
            }
            catch
            {
                // Fallback gracefully on parsing error
            }
        }
        else if (trimmed.StartsWith("[SHIFT_REQUEST]"))
        {
            try
            {
                var req = new ShiftChangeRequest();
                
                int riderIdx = trimmed.IndexOf("Rider:");
                int targetIdx = trimmed.IndexOf("Target:");
                if (riderIdx != -1 && targetIdx != -1)
                {
                    string riderPart = trimmed.Substring(riderIdx + 6, targetIdx - (riderIdx + 6)).Trim();
                    int openParen = riderPart.IndexOf("(");
                    if (openParen != -1)
                    {
                        req.RiderName = riderPart.Substring(0, openParen).Trim();
                        string idStr = riderPart.Substring(openParen).Replace("(ID:", "").Replace(")", "").Trim();
                        if (int.TryParse(idStr, out int rId))
                        {
                            req.RiderId = rId;
                        }
                    }
                    else
                    {
                        req.RiderName = riderPart;
                    }
                }

                int reasonIdx = trimmed.IndexOf("Reason:");
                if (targetIdx != -1 && reasonIdx != -1)
                {
                    req.RequestedShiftName = trimmed.Substring(targetIdx + 7, reasonIdx - (targetIdx + 7)).Trim();
                }

                int shiftsIdx = trimmed.IndexOf("Shifts:");
                if (reasonIdx != -1 && shiftsIdx != -1)
                {
                    req.Reason = trimmed.Substring(reasonIdx + 7, shiftsIdx - (reasonIdx + 7)).Trim();
                }

                if (shiftsIdx != -1)
                {
                    string shiftsPart = trimmed.Substring(shiftsIdx + 7).Trim();
                    if (shiftsPart.StartsWith("-"))
                    {
                        shiftsPart = shiftsPart.Substring(1).Trim();
                    }

                    // Parse segment parts separated by |
                    var parts = shiftsPart.Split('|', StringSplitOptions.RemoveEmptyEntries)
                        .Select(p => p.Trim())
                        .ToList();

                    int i = 0;
                    string curShift = "";
                    if (parts.Count > 0)
                    {
                        curShift = parts[0];
                        i = 1;
                    }

                    while (i < parts.Count)
                    {
                        string datePart = parts[i];
                        string timePart = (i + 1 < parts.Count) ? parts[i + 1] : "";
                        string changePart = (i + 2 < parts.Count) ? parts[i + 2] : "";

                        string targetShift = "";
                        string nextShift = "";

                        if (!string.IsNullOrEmpty(changePart))
                        {
                            string cleanChange = changePart;
                            if (cleanChange.StartsWith("Changed to:", StringComparison.OrdinalIgnoreCase))
                            {
                                cleanChange = cleanChange.Substring(11).Trim();
                            }
                            else if (cleanChange.StartsWith("Change to:", StringComparison.OrdinalIgnoreCase))
                            {
                                cleanChange = cleanChange.Substring(10).Trim();
                            }

                            var changeParts = System.Text.RegularExpressions.Regex.Split(cleanChange, @"\s+[-–—]\s+");
                            if (changeParts.Length > 1)
                            {
                                targetShift = changeParts[0].Trim();
                                nextShift = changeParts[1].Trim();
                            }
                            else
                            {
                                targetShift = cleanChange;
                            }
                        }

                        var item = new ShiftChangeRequestItem
                        {
                            CurrentShiftName = curShift,
                            ShiftDetailsText = $"{datePart} | {timePart}",
                            RequestedShiftName = !string.IsNullOrEmpty(targetShift) ? targetShift : req.RequestedShiftName
                        };
                        req.Items.Add(item);

                        curShift = nextShift;
                        i += 3;
                    }

                    // Fallback to top-level properties if nothing was parsed in collection
                    if (req.Items.Count == 0)
                    {
                        req.Items.Add(new ShiftChangeRequestItem
                        {
                            CurrentShiftName = req.CurrentShiftName,
                            ShiftDetailsText = req.ShiftDetailsText,
                            RequestedShiftName = req.RequestedShiftName
                        });
                    }
                    else
                    {
                        req.CurrentShiftName = req.Items[0].CurrentShiftName;
                        req.ShiftDetailsText = req.Items[0].ShiftDetailsText;
                        req.RequestedShiftName = req.Items[0].RequestedShiftName;
                    }
                }

                request = req;
                return true;
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error parsing text shift request: " + ex.Message);
            }
        }
        return false;
    }

