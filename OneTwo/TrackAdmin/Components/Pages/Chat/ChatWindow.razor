@using Microsoft.AspNetCore.SignalR.Client
@using TrackAdmin.Models
@using TrackAdmin.Data
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Newtonsoft.Json
@inject HttpClient Http
@inject UserSessionService session
@inject IJSRuntime JS
@implements IAsyncDisposable

@inject TenantState _tenantState
@inject ProtectedSessionStorage protectedSessionStore
@inject NavigationManager Navigation
@inject AuthenticationStateProvider authStateProvider

<div class="chat-sidebar-drawer animate-slide-left">
        <div class="chat-sidebar-backdrop" @onclick="Close"></div>
        <div class="chat-sidebar-content">
            <!-- Split Layout -->
            <div class="chat-split-container">
                
                <!-- Left Pane: Conversation List -->
                <div class="chat-left-pane">
                    <div class="chat-search-header">
                        <div class="search-input-wrap">
                            <i class="bi bi-search"></i>
                            <input type="text" placeholder="Search conversation" @bind="chatSearchQuery" @bind:event="oninput" />
                            <i class="bi bi-filter filter-icon" title="Filter list"></i>
                        </div>
                    </div>
                    
                    <div class="chat-members-list">
                        @if (filteredMembers == null || !filteredMembers.Any())
                        {
                            <div class="empty-members">
                                <i class="bi bi-person-x-fill mb-2 fs-2 text-muted"></i>
                                <span>No contacts found</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var member in filteredMembers)
                            {
                                var isActive = Rider != null && member.Id.ToString() == Rider.RiderId;
                                var unreadCount = getUnreadCount(member.Id);
                                <div class="chat-member-item @(isActive ? "active" : "")" @onclick="() => SwitchActiveRider(member)">
                                    <div class="member-avatar-wrap" @onclick:stopPropagation="true" @onclick="() => ShowMemberDetails(member)" title="Click to view details">
                                        <img src="@GetRiderProfileImage(member.Id)" class="member-avatar" onerror="this.src='/images/default-avatar.png'" />
                                        <span class="member-status-dot @((member.Status?.Trim().ToLower() == "active" || member.Status?.Trim().ToLower() == "available" || member.Status?.Trim().ToLower() == "intransit" || member.Status?.Trim().ToLower() == "online") ? "online" : "")"></span>
                                    </div>
                                    <div class="member-info">
                                        <div class="member-name-row">
                                            <span class="member-name">@member.Name</span>
                                            <span class="member-time">@(member.LastMessageTime.HasValue ? member.LastMessageTime.Value.ToLocalTime().ToString("hh:mm tt") : "")</span>
                                        </div>
                                        <div class="member-message-row">
                                            <span class="member-snippet text-muted">@member.LastMessage</span>
                                            @if (unreadCount > 0)
                                            {
                                                <span class="member-unread-badge">@unreadCount</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
                
                <!-- Right Pane: Active Conversation -->
                <div class="chat-right-pane">
                    @if (Rider != null)
                    {
                        <div class="chat-pane-header">
                            <div class="pane-header-title d-flex flex-column align-items-start">
                                <span class="pane-app-title" style="line-height: 1.2;">@Rider.RiderName</span>
                                <span class="pane-subtitle" style="font-size: 11px; font-weight: 600; margin-top: 2px; display: flex; align-items: center; gap: 4px; color: @(hubConnection?.State == HubConnectionState.Connected ? "#10b981" : "#d97706");">
                                    <span class="status-dot" style="width: 6px; height: 6px; border-radius: 50%; display: inline-block; background-color: @(hubConnection?.State == HubConnectionState.Connected ? "#10b981" : "#d97706");"></span>
                                    @(GetConnectionStatusText())
                                </span>
                            </div>
                            <button class="pane-close-btn" @onclick="Close" title="Close Chat Drawer"><i class="bi bi-x-lg"></i></button>
                        </div>
                        
                        <div class="chat-body" id="chat-body-@Rider.RiderId">
                            @if (isLoading)
                            {
                                <div class="chat-loading-overlay">
                                    <div class="chat-history-skeleton">
                                        @for (int sk = 0; sk < 6; sk++)
                                        {
                                            var isOdd = sk % 2 == 0;
                                            <div class="skeleton-row @(isOdd ? "sk-me" : "sk-them")">
                                                <div class="skeleton-bubble @(isOdd ? "sk-me" : "sk-them")" style="width: @(isOdd ? "55" : "65")%"></div>
                                            </div>
                                        }
                                    </div>
                                    <div class="chat-loading-label"><i class="bi bi-hourglass-split me-1"></i>Loading messages, please wait...</div>
                                </div>
                            }
                            else if (messages.Count == 0)
                            {
                                <div class="empty-chat">
                                    <i class="bi bi-chat-dots"></i>
                                    <p>No messages yet. Say hi!</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var msg in messages)
                                {
                                    var isMe = msg.SenderId == session.UserID;
                                    <div class="msg-row @(isMe ? "me" : "them")">
                                        @if (!isMe)
                                        {
                                            <img src="@GetRiderProfileImage(msg.SenderId)" class="chat-bubble-avatar" onerror="this.src='/images/default-avatar.png'" />
                                        }
                                        <div class="msg-bubble-wrap">
                                            <div class="msg-bubble">
                                                @if (msg.MessageType == "Voice")
                                                {
                                                    if (msg.Id < 0 && msg.Content == "Uploading...")
                                                    {
                                                        <div class="voice-msg-uploading-state d-flex align-items-center gap-2 py-1 px-2" style="color: #2563eb;">
                                                            <div class="spinner-border text-primary" role="status" style="width: 16px; height: 16px; border-width: 1.5px;"></div>
                                                            <span style="font-size: 13px; font-weight: 600;">Sending audio note...</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        var playerElementId = $"voice-player-{msg.Id}";
                                                        var fileUrl = (msg.FilePath ?? "").StartsWith("data:", StringComparison.OrdinalIgnoreCase)
                                                            ? msg.FilePath
                                                            : $"{ApiConfig.Value.BaseApiUrl}Chat/file?path={Uri.EscapeDataString(msg.FilePath ?? "")}&TenantId={_tenantState.TenantID}";
                                                        <div class="voice-msg-player" id="@playerElementId">
                                                            <button class="audio-play-btn" @onclick="() => PlayVoiceMessage(fileUrl, playerElementId)" @onclick:stopPropagation="true">
                                                                <i class="bi bi-play-fill"></i>
                                                            </button>
                                                            <div class="audio-progress-bar-wrap">
                                                                <div class="audio-progress-line" style="width:0%"></div>
                                                                <div class="audio-progress-thumb" style="left:0%"></div>
                                                            </div>
                                                            <span class="audio-duration">--:--</span>
                                                        </div>
                                                    }
                                                }
                                                else if (msg.MessageType == "Photo")
                                                {
                                                    if (msg.Id < 0 && msg.Content == "Uploading...")
                                                    {
                                                        <div class="photo-msg-uploading-state d-flex flex-column align-items-center justify-content-center" style="width: 240px; height: 160px; background: rgba(0, 0, 0, 0.03); border-radius: 12px; border: 1.5px dashed rgba(37, 99, 235, 0.25);">
                                                            <div class="spinner-border text-primary mb-2" role="status" style="width: 24px; height: 24px; border-width: 2px;"></div>
                                                            <span style="font-size: 13px; font-weight: 600; color: #2563eb;">Uploading photo...</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        var fileUrl = !string.IsNullOrEmpty(msg.FilePath)
                                                            ? (msg.FilePath.StartsWith("data:", StringComparison.OrdinalIgnoreCase)
                                                                ? msg.FilePath
                                                                : $"{ApiConfig.Value.BaseApiUrl}Chat/file?path={Uri.EscapeDataString(msg.FilePath)}&TenantId={_tenantState.TenantID}")
                                                            : "";
                                                        var imgId = $"chat-photo-{msg.Id}";
                                                        if (!string.IsNullOrEmpty(fileUrl))
                                                        {
                                                            <div class="photo-msg-wrap" @onclick="() => OpenGallery(fileUrl)" @onclick:stopPropagation="true" style="cursor: pointer; position: relative;">
                                                                <img id="@imgId"
                                                                     src="@fileUrl"
                                                                     class="photo-msg-img"
                                                                     style="max-width: 240px; border-radius: 12px; border: 1px solid rgba(0,0,0,0.1); display: block;"
                                                                     onerror="(function(img){
                                                                          img.onerror=null;
                                                                          setTimeout(function(){
                                                                              var errDiv=document.getElementById('err-'+img.id);
                                                                              var freshSrc=img.src.split('&_t=')[0]+'&_t='+Date.now();
                                                                              img.onerror=function(){
                                                                                  img.style.display='none';
                                                                                  if(errDiv) errDiv.style.display='flex';
                                                                              };
                                                                              img.src=freshSrc;
                                                                          },1500);
                                                                      })(this)" />
                                                                <div id="err-@imgId" class="photo-error-state" style="display:none;"
                                                                     @onclick:stopPropagation="true">
                                                                    <i class="bi bi-camera-video-off photo-error-icon"></i>
                                                                    <span class="photo-error-text">Image failed to load</span>
                                                                    <button class="photo-retry-btn"
                                                                            onclick="(function(btn){var img=document.getElementById('@imgId');if(img){img.style.display='';document.getElementById('err-@imgId').style.display='none';img.src=img.src.split('&_t=')[0]+'&_t='+Date.now();}})(this)">
                                                                        <i class="bi bi-arrow-clockwise"></i> Retry
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="photo-error-state static">
                                                                <i class="bi bi-image photo-error-icon"></i>
                                                                <span class="photo-error-text">Image unavailable</span>
                                                            </div>
                                                        }
                                                    }
                                                }
                                                 else if (msg.MessageType == "File")
                                                 {
                                                     var fileUrl = !string.IsNullOrEmpty(msg.FilePath)
                                                         ? (msg.FilePath.StartsWith("data:", StringComparison.OrdinalIgnoreCase)
                                                             ? msg.FilePath
                                                             : $"{ApiConfig.Value.BaseApiUrl}Chat/file?path={Uri.EscapeDataString(msg.FilePath)}&TenantId={_tenantState.TenantID}")
                                                         : "";
                                                     <div class="file-msg-wrap d-flex align-items-center gap-2 rounded-3" style="background: rgba(15, 23, 42, 0.03); border: 1.5px solid rgba(15, 23, 42, 0.08); width: 240px; padding: 10px; pointer-events: auto;">
                                                         <i class="bi bi-file-earmark-text-fill text-primary" style="font-size: 26px;"></i>
                                                         <div class="file-msg-info d-flex flex-column" style="min-width: 0; flex: 1;">
                                                             <span class="file-msg-name text-dark fw-bold text-truncate" style="font-size: 13px;" title="@msg.Content">@msg.Content</span>
                                                             @if (!string.IsNullOrEmpty(fileUrl))
                                                             {
                                                                 <a href="@fileUrl" target="_blank" download="@msg.Content" class="file-msg-download text-primary fw-bold text-decoration-none mt-1 d-flex align-items-center gap-1" style="font-size: 11px; width: fit-content;" @onclick:stopPropagation="true">
                                                                     <i class="bi bi-download"></i> Download
                                                                 </a>
                                                             }
                                                         </div>
                                                     </div>
                                                 }
                                                else if (IsShiftChangeRequest(msg.Content, out var shiftReq) && shiftReq != null)
                                                {
                                                    <div class="shift-change-card" @onclick="GoToRoster">
                                                         <div class="card-header-row">
                                                             <i class="bi bi-arrow-left-right card-header-icon"></i>
                                                             <span class="card-header-title">SHIFT CHANGE REQUEST</span>
                                                         </div>
                                                         <div class="card-body-row">
                                                             <span class="card-label">Rider:</span>
                                                             <span class="card-value fw-bold text-dark">@shiftReq.RiderName (ID: @shiftReq.RiderId)</span>
                                                         </div>
                                                         <div class="card-section-title">SHIFTS TO CHANGE:</div>
                                                         <div style="max-height: 200px; overflow-y: auto; padding-right: 2px;">
                                                             @foreach (var item in shiftReq.Items)
                                                             {
                                                                 <div class="card-shift-box mb-2" style="border-left: 3px solid #6366f1; padding-left: 10px; background: rgba(99, 102, 241, 0.03); border-radius: 4px; padding-top: 6px; padding-bottom: 6px; margin-bottom: 8px;">
                                                                     <div class="d-flex align-items-center gap-1 flex-wrap mb-1">
                                                                         <i class="bi bi-clock-history text-primary" style="font-size: 13px;"></i>
                                                                         <span class="fw-bold text-dark text-xs" style="font-size: 11px;">@item.CurrentShiftName</span>
                                                                         <i class="bi bi-arrow-right text-muted" style="font-size: 11px; margin: 0 2px;"></i>
                                                                         <span class="badge bg-success-light text-success fw-bold rounded px-1.5 py-0.5 text-xxs" style="font-size: 10px; font-weight: 700;">Change to: @item.RequestedShiftName</span>
                                                                     </div>
                                                                     <div class="text-muted text-xxs" style="font-size: 10.5px; font-weight: 500; margin-left: 16px;">@item.ShiftDetailsText</div>
                                                                 </div>
                                                             }
                                                         </div>
                                                         <div class="card-body-row pt-1 flex-column align-items-start">
                                                             <span class="card-label mb-1">Reason:</span>
                                                             <span class="card-reason-notes italic text-muted">@shiftReq.Reason</span>
                                                         </div>
                                                         
                                                         @if (!string.IsNullOrEmpty(shiftReq.StatusText))
                                                         {
                                                             <div class="card-status-indicator text-success border-top pt-2 mt-2 text-xs d-flex align-items-center gap-1">
                                                                 <i class="bi bi-check-circle-fill"></i> @(shiftReq.StatusText.Replace("Changed to:", "Change to:", StringComparison.OrdinalIgnoreCase))
                                                             </div>
                                                         }
                                                         else
                                                         {
                                                             <div class="card-status-indicator text-success border-top pt-2 mt-2 text-xs d-flex align-items-center gap-1">
                                                                 <i class="bi bi-check-circle-fill"></i> Change Requested
                                                             </div>
                                                         }
                                                     </div>
                                                }
                                                else
                                                {
                                                    <p class="msg-content">@msg.Content</p>
                                                }
                                            </div>
                                            <div class="msg-time-container">
                                                <span class="msg-time">@msg.CreatedAt.ToLocalTime().ToString("hh:mm tt")</span>
                                                @if (isMe)
                                                {
                                                    @if (msg.IsRead)
                                                    {
                                                        <i class="bi bi-check-all ms-1" style="font-size: 15px; color: #2563eb !important;" title="Read"></i>
                                                    }
                                                    else if (msg.IsDelivered)
                                                    {
                                                        <i class="bi bi-check-all ms-1" style="font-size: 15px; color: #94a3b8 !important;" title="Delivered"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-check ms-1" style="font-size: 15px; color: #94a3b8 !important;" title="Sent"></i>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (isRiderRecordingVoice)
                                {
                                    <div class="msg-row them animate-fade-in">
                                        <img src="@GetRiderProfileImage(int.Parse(Rider.RiderId))" class="chat-bubble-avatar" onerror="this.src='/images/default-avatar.png'" />
                                        <div class="msg-bubble-wrap">
                                            <div class="msg-bubble recording-bubble d-flex align-items-center gap-2" style="background: rgba(239, 68, 68, 0.08); color: #ef4444; border: 1.5px solid rgba(239, 68, 68, 0.15); padding: 10px 14px; border-radius: 18px; border-top-left-radius: 4px;">
                                                <span class="recording-dot"></span>
                                                <span style="font-size: 13px; font-weight: 600;">Recording voice message...</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (isRiderTyping)
                                {
                                    <div class="msg-row them animate-fade-in">
                                        <img src="@GetRiderProfileImage(int.Parse(Rider.RiderId))" class="chat-bubble-avatar" onerror="this.src='/images/default-avatar.png'" />
                                        <div class="msg-bubble-wrap">
                                            <div class="msg-bubble typing-bubble">
                                                <div class="typing-dots">
                                                    <span class="typing-dot"></span>
                                                    <span class="typing-dot"></span>
                                                    <span class="typing-dot"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        
                        <div class="chat-footer" style="position: relative;">
                            <InputFile id="photo-input" OnChange="UploadPhotoFile" style="display:none;" accept="image/*" />

                            @if (isUploadingPhoto)
                            {
                                <div class="photo-upload-overlay">
                                    <div class="photo-upload-spinner"></div>
                                    <span class="photo-upload-label">Uploading image, please wait...</span>
                                </div>
                            }
                            
                            <button class="footer-action-btn me-1" title="Send Photo" @onclick="TriggerPhotoInput" disabled="@isUploadingPhoto"><i class="bi bi-camera"></i></button>
                            <button class="footer-action-btn me-2" title="Add Emoji" @onclick="ToggleEmojiPicker"><i class="bi bi-emoji-smile"></i></button>
                            
                            @if (showEmojiPicker)
                            {
                                <div class="emoji-picker-popup shadow-lg border rounded-3 p-2">
                                    <div class="emoji-grid">
                                        @foreach (var emoji in emojis)
                                        {
                                            <span class="emoji-item" @onclick="() => AppendEmoji(emoji)">@emoji</span>
                                        }
                                    </div>
                                </div>
                            }

                            @if (isRecording)
                            {
                                <div class="recording-indicator-bar flex-grow-1 d-flex align-items-center gap-2 px-3 py-1.5 rounded-pill" style="background: rgba(239, 68, 68, 0.08); color: #ef4444;">
                                    <span class="recording-dot"></span>
                                    <span style="font-size: 13px; font-weight: 600;">Recording voice message... @(recordDuration)s / 60s</span>
                                </div>
                            }
                            else
                            {
                                <input type="text" 
                                       class="chat-input" 
                                       placeholder="@(isUploadingPhoto ? "Uploading image..." : (session.Rights.IsAdmin || session.Rights.chat_level == 2 ? "Type your message..." : session.Rights.chat_level == 1 ? "Read-only access..." : "Chat disabled..."))" 
                                       @bind="newMessage"
                                       @bind:event="oninput"
                                       @onkeyup="HandleKeyUp"
                                       disabled="@(isUploadingPhoto || !(session.Rights.IsAdmin || session.Rights.chat_level == 2))" />
                            }

                            @if (string.IsNullOrWhiteSpace(newMessage) && (session.Rights.IsAdmin || session.Rights.chat_level == 2))
                            {
                                <button class="footer-action-btn mic-btn ms-1 @(isRecording ? "recording" : "")"
                                        @onmousedown="StartVoiceRecording"
                                        @onmouseup="StopVoiceRecording"
                                        @onmouseleave="StopVoiceRecording"
                                        @ontouchstart="StartVoiceRecording"
                                        @ontouchend="StopVoiceRecording"
                                        title="Hold to record voice note">
                                    <i class="bi bi-mic-fill"></i>
                                </button>
                            }
                            else
                            {
                                <button class="send-btn @(!(session.Rights.IsAdmin || session.Rights.chat_level == 2) ? "disabled" : "")" @onclick="SendMessage" disabled="@(isUploadingPhoto || !(session.Rights.IsAdmin || session.Rights.chat_level == 2))">
                                    <i class="bi bi-arrow-right-short" style="font-size: 24px;"></i>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="chat-pane-header no-chat-header" style="justify-content: flex-end; border-bottom: 1px solid rgba(0,0,0,0.05); background: transparent; padding: 14px 24px;">
                            <button class="pane-close-btn" @onclick="Close" title="Close Chat Drawer"><i class="bi bi-x-lg"></i></button>
                        </div>
                        <div class="empty-chat-pane" style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px; text-align: center;">
                            <i class="bi bi-chat-left-dots-fill text-muted mb-3" style="font-size: 48px; opacity: 0.4;"></i>
                            <h5 class="text-muted" style="font-weight: 500;">Select a conversation to start chatting</h5>
                        </div>
                    }
                </div>
            </div>
    </div>
</div>

@if (selectedMemberForDetails != null)
{
    <div class="member-details-modal-backdrop" @onclick="CloseMemberDetails"></div>
    <div class="member-details-modal animate-slide-up">
        <div class="details-modal-header">
            <h5>Contact Details</h5>
            <button class="modal-close-btn" @onclick="CloseMemberDetails"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="details-modal-body">
            <div class="details-avatar-wrap">
                <img src="@GetRiderProfileImage(selectedMemberForDetails.Id)" class="details-avatar" onerror="this.src='/images/default-avatar.png'" />
            </div>
            <h4 class="details-name">@selectedMemberForDetails.Name</h4>
            <span class="details-role">@selectedMemberForDetails.Type</span>
            
            <div class="details-info-grid">
                <div class="info-row">
                    <i class="bi bi-telephone-fill"></i>
                    <div class="info-content">
                        <span class="info-label">Phone</span>
                        <span class="info-value">@selectedMemberForDetails.Mobile</span>
                    </div>
                </div>
                <div class="info-row">
                    <i class="bi bi-envelope-fill"></i>
                    <div class="info-content">
                        <span class="info-label">Email</span>
                        <span class="info-value">@(string.IsNullOrEmpty(selectedMemberForDetails.Email) ? "No email provided" : selectedMemberForDetails.Email)</span>
                    </div>
                </div>
                <div class="info-row">
                    <i class="bi bi-activity"></i>
                    <div class="info-content">
                        <span class="info-label">Status</span>
                        <span class="info-value">@selectedMemberForDetails.Status</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(galleryPhotoUrl))
{
    <div class="gallery-modal-backdrop" @onclick="CloseGallery"></div>
    <div class="gallery-modal animate-fade-in" @onclick="CloseGallery">
        <div class="gallery-modal-content" @onclick:stopPropagation="true">
            <button class="gallery-close-btn" @onclick="CloseGallery"><i class="bi bi-x-lg"></i></button>
            <img src="@galleryPhotoUrl" class="gallery-large-img" />
        </div>
    </div>
}

<style>
    /* Premium Sliding Split Chat Drawer Layout */
    .chat-sidebar-drawer {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 100000;
        display: flex;
        justify-content: flex-end;
        background: none;
        pointer-events: auto;
    }

    .chat-sidebar-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.35); /* Slate-800 style transparent backdrop */
        z-index: 1;
    }

    .chat-sidebar-content {
        width: 850px;
        max-width: 95vw;
        height: 100%;
        background: #ffffff;
        box-shadow: -10px 0 40px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        border-left: 1px solid #e2e8f0;
        overflow: hidden;
        font-family: 'Inter', 'Outfit', sans-serif;
        z-index: 2;
        position: relative;
    }

    .chat-split-container {
        display: flex;
        flex: 1;
        min-height: 0;
        height: 100%;
    }

    /* Left contacts side-pane */
    .chat-left-pane {
        width: 320px;
        border-right: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        background: #f8fafc;
    }

    .chat-search-header {
        padding: 16px;
        border-bottom: 1px solid #e2e8f0;
    }

    .search-input-wrap {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

