@page "/sso-login"
@using TrackAdmin.Data
@using TrackAdmin.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Newtonsoft.Json
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject TenantService TenantService

<div class="sso-landing-container">
    <div class="sso-card">
        <div class="sso-spinner"></div>
        <h3>Secure Login in Progress</h3>
        <p>Synchronizing your session with the Identity Hub...</p>
    </div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery]
    public string? Token { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Token))
        {
            NavManager.NavigateTo("/"); // Redirect to login page if no token
            return;
        }

        try
        {
            var authProvider = (JwtAuthenticationStateProvider)AuthStateProvider;
            
            // Create a FULL session object from the token claims
            var session = authProvider.CreateSessionFromToken(Token);
            
            // 1. Fetch User Rights for RIDO Product (Current App)
            try
            {
                var perm = await TenantService.GetUserPermissionsAsync(int.Parse(session.UserID), session.TenantID, "RIDO_APP");
                session.Rights = JsonConvert.DeserializeObject<UserRights>(perm.RightsJson) ?? new UserRights();
            }
            catch { session.Rights = new UserRights(); }

            // 2. Update Auth State
            await authProvider.UpdateAuthenticationState(session);

            // Give the state a moment to propagate
            await Task.Delay(300);

            // Smooth redirect to the dashboard/appointments
            NavManager.NavigateTo("/Appointments");
        }
        catch (Exception)
        {
            NavManager.NavigateTo("/?error=sso_failed");
        }
    }
}

<style>
    .sso-landing-container {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        background: #f8fafc;
        font-family: 'Inter', sans-serif;
    }

    .sso-card {
        text-align: center;
        padding: 40px;
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    }

    .sso-spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #e2e8f0;
        border-top-color: #38bdf8;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .sso-card h3 {
        color: #1e293b;
        margin-bottom: 10px;
    }

    .sso-card p {
        color: #64748b;
        font-size: 0.9rem;
    }
</style>
