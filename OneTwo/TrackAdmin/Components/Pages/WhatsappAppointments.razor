    private async Task GetAppList(int id)
    {
        string sd = fdt.ToString("yyyy-MM-dd") + " 00:00:00";
        string ed = tdt.ToString("yyyy-MM-dd") + " 23:59:59";
        string url = "";

        if (id == 1)
        {
            url = $"{apiurl}sampleCollection/whatsappdate?sd={Uri.EscapeUriString(sd)}&ed={Uri.EscapeUriString(ed)}&isupcoming={false}";
        }
        else if (id == 2)
        {
            url = $"{apiurl}sampleCollection/whatsappdate?sd={Uri.EscapeUriString(sd)}&ed={Uri.EscapeUriString(ed)}&isupcoming={true}";
        }

        var res = await http.GetAsync(url);
        var tt = await res.Content.ReadAsStringAsync();
        applist1 = (JsonConvert.DeserializeObject<IList<WhatsappAppointment>>(tt) ?? new List<WhatsappAppointment>())
            .OrderByDescending(x => x.wapp_id).ToList();

        if (applist1.Count > 0)
        {
            var distinctIds = applist1
                .Where(x => x.referral_id > 0)
                .Select(x => x.referral_id)
                .Distinct()
                .ToList();

            if (distinctIds.Any())
            {
                string rid = string.Join(",", distinctIds);
                var response = await http.GetAsync(apiurl + "Referral/referralid?rname=" + Uri.EscapeUriString(rid));
                var tt1 = await response.Content.ReadAsStringAsync();
                rm1 = JsonConvert.DeserializeObject<IList<Referral_Master>>(tt1);
            }
        }
        
        await InvokeAsync(StateHasChanged);
        UpdateHeader();
    }

