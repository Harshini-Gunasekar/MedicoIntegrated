@page "/WhatsappAppointments"
@rendermode InteractiveServer
@implements IDisposable

@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using System.Text.Json
@using TrackAdmin.Components.Layout
@using TrackAdmin.Data
@using Syncfusion.Blazor.Notifications

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.DropDowns
@using TrackAdmin.Models
@inject NavigationManager Navigation
@inject HttpClient http
@inject SfDialogService dp
@inject IJSRuntime JS
@inject HttpClient Http
@inject RiderTracking riderTracking
@inject MasterData msd
@inject PageMetadataService Metadata

<SfToast @ref="toastObj" Timeout="5000" Icon="e-info">
    <ToastPosition X="Right" Y="Top"></ToastPosition>
</SfToast>

@if (!pageReady)
{
    <div class="premium-loader-container">
        <div class="tactical-loader-orb">
            <i class="bi bi-whatsapp pulse"></i>
            <div class="loader-glow"></div>
        </div>
        <div class="loader-text-wrap">
            <h4>RIDO LOGISTICS</h4>
            <span>Syncing WhatsApp Bookings...</span>
        </div>
    </div>
}
else
{
<section class="food-page animate-fade-in split-pane-wrapper p-0">
    
    <!-- MASTER PANE (Left Column) -->
    <div class="master-pane @(isvis ? "compressed" : "full")">
        <section class="container-fluid food-body" style="padding-bottom: 20px;">
            
            <!-- Premium Unified Toolbar -->
            <header class="food-toolbar premium-card mb-3">
                <div class="row g-3 p-2 px-3 align-items-center">
                    
                    <!-- View Toggle Filter -->
                    <div class="col-xl-3 col-md-4">
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted fw-bold" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px;">View Mode:</span>
                            <div class="btn-group btn-group-sm w-100">
                                <button type="button" class="btn @(currentView == 1 ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetView(1)" style="font-size: 11px; font-weight: 700;">HISTORY</button>
                                <button type="button" class="btn @(currentView == 2 ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetView(2)" style="font-size: 11px; font-weight: 700;">UPCOMING</button>
                            </div>
                        </div>
                    </div>

                    <!-- Date Range Selection -->
                    <div class="col-xl-4 col-md-8">
                        <div class="premium-toolbar-group">
                            <div class="row g-0 align-items-center">
                                <div class="col-6 border-end">
                                    <div class="px-3 py-1">
                                        <label class="food-label d-flex align-items-center gap-2 mb-0" style="font-size: 10px;">
                                            <i class="bi bi-calendar-event text-primary"></i> From
                                        </label>
                                        <InputDate Type="InputDateType.Date" Value="@fdt" ValueExpression="() => fdt" ValueChanged="@((DateTime d) => { fdt = d; _ = GetAppList(currentView); })" class="form-control border-0 bg-transparent p-0 food-date-input" style="font-size: 13px;"></InputDate>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="px-3 py-1">
                                        <label class="food-label d-flex align-items-center gap-2 mb-0" style="font-size: 10px;">
                                            <i class="bi bi-calendar-check text-primary"></i> To
                                        </label>
                                        <InputDate Type="InputDateType.Date" Value="@tdt" ValueExpression="() => tdt" ValueChanged="@((DateTime d) => { tdt = d; _ = GetAppList(currentView); })" class="form-control border-0 bg-transparent p-0 food-date-input" style="font-size: 13px;"></InputDate>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Interactive Live Search -->
                    <div class="col-xl-5 col-md-12">
                        <div class="food-search-group">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" class="food-search-input" placeholder="Search number or message preview..." @bind="searchTerm" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(searchTerm))
                            {
                                <button class="clear-btn" type="button" @onclick='() => { searchTerm = ""; }'>
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                            <button class="refresh-btn" type="button" @onclick="@(() => GetAppList(currentView))">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </header>

            <!-- Dynamic Statistics Bar -->
            <section class="row g-3 mb-4 animate-fade-in">
                <div class="col-xl-2 col-md-4 col-6">
                    <div class="stat-glass-card primary @(currentStat == "1" ? "active" : "")" @onclick='() => SetStatFilter("1")'>
                        <div class="stat-icon-wrap"><i class="bi bi-whatsapp"></i></div>
                        <div class="stat-data">
                            <span class="stat-label">Total Inbox</span>
                            <h3 class="stat-value">@applist1.Count</h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-6">
                    <div class="stat-glass-card warning @(currentStat == "2" ? "active" : "")" @onclick='() => SetStatFilter("2")'>
                        <div class="stat-icon-wrap"><i class="bi bi-clock-history"></i></div>
                        <div class="stat-data">
                            <span class="stat-label">Pending</span>
                            <h3 class="stat-value">@applist1.Count(x => x.Status == "Pending" || x.Status == "New")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-6">
                    <div class="stat-glass-card info @(currentStat == "4" ? "active" : "")" @onclick='() => SetStatFilter("4")'>
                        <div class="stat-icon-wrap"><i class="bi bi-person-check-fill"></i></div>
                        <div class="stat-data">
                            <span class="stat-label">Accepted</span>
                            <h3 class="stat-value">@applist1.Count(x => x.Status == "Accepted")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-6">
                    <div class="stat-glass-card danger @(currentStat == "3" ? "active" : "")" @onclick='() => SetStatFilter("3")'>
                        <div class="stat-icon-wrap"><i class="bi bi-x-circle-fill"></i></div>
                        <div class="stat-data">
                            <span class="stat-label">Rejected</span>
                            <h3 class="stat-value">@applist1.Count(x => x.Status == "Rejected")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-6">
                    <div class="stat-glass-card secondary @(currentStat == "5" ? "active" : "")" @onclick='() => SetStatFilter("5")'>
                        <div class="stat-icon-wrap"><i class="bi bi-box-seam-fill"></i></div>
                        <div class="stat-data">
                            <span class="stat-label">Collected</span>
                            <h3 class="stat-value">@applist1.Count(x => x.Status == "Collected")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-6">
                    <div class="stat-glass-card success @(currentStat == "6" ? "active" : "")" @onclick='() => SetStatFilter("6")'>
                        <div class="stat-icon-wrap"><i class="bi bi-check-all"></i></div>
                        <div class="stat-data">
                            <span class="stat-label">Completed</span>
                            <h3 class="stat-value">@applist1.Count(x => x.Status == "Completed")</h3>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Table Tabular Grid Layout -->
            <section class="row">
                <div class="col-12 mb-4">
                    <div class="floating-row-container">
                        
                        <!-- Row Header -->
                        <div class="row-card-header d-none d-xl-flex">
                            <div class="col-origin">ID</div>
                            <div class="col-ref">ALERT</div>
                            <div class="col-job">WA NUMBER</div>
                            <div class="col-client">MESSAGE PREVIEW</div>
                            <div class="col-rider">ASSIGNED RIDER</div>
                            <div class="col-time">SCHEDULE DETAILS</div>
                            <div class="col-status">STATUS</div>
                        </div>

                        <!-- Data Rows -->
                        @if (PaginatedList != null && PaginatedList.Count > 0)
                        {
                            @foreach (var item in PaginatedList)
                            {
                                var isSelected = selectedApt != null && selectedApt.wapp_id == item.wapp_id;
                                var statusClass = $"status-{item.Status?.ToLower()}";

                                <div class="row-card @statusClass @(IsOverdue(item) ? "overdue alert-pulse-glow" : "") @(isSelected ? "active-row" : "") cursor-pointer animate-slide-up" @onclick="() => SelectAppointment(item)">
                                    <div class="status-indicator"></div>
                                    <div class="row-card-body">
                                        
                                        <!-- ID Column -->
                                        <div class="col-origin">
                                            <div class="origin-tag">#@item.wapp_id</div>
                                        </div>

                                        <!-- Alert Column -->
                                        <div class="col-ref">
                                            @if (IsOverdue(item))
                                            {
                                                <div class="tactical-alert level-2 glow">
                                                    <div class="alert-pulse"></div>
                                                    <span class="alert-text">SLA</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="safe-indicator">
                                                    <i class="bi bi-shield-check text-success"></i>
                                                </div>
                                            }
                                        </div>

                                        <!-- WhatsApp Mobile Column -->
                                        <div class="col-job">
                                            <div class="d-flex align-items-center gap-2 fw-bold text-dark">
                                                <i class="bi bi-whatsapp text-success"></i>
                                                <span>@item.wa_number</span>
                                            </div>
                                        </div>

                                        <!-- Message Preview Column -->
                                        <div class="col-client">
                                            <div class="client-name text-truncate fw-medium text-dark" style="max-width: 280px;" title="@item.appointment_Text">
                                                @item.appointment_Text
                                            </div>
                                            <div class="client-id fw-semibold text-primary">
                                                @(rm1.FirstOrDefault(x => x.ReferralID == item.referral_id)?.ShortName ?? "Pending Resolution")
                                            </div>
                                        </div>

                                        <!-- Assigned Rider Column -->
                                        <div class="col-rider">
                                            @if (item.rider_id > 0)
                                            {
                                                <div class="rider-chip">
                                                    <div class="rider-avatar">@((rider.FirstOrDefault(x => x.RiderID == item.rider_id)?.ShortName ?? "R")[0])</div>
                                                    <span>@(rider.FirstOrDefault(x => x.RiderID == item.rider_id)?.ShortName ?? "Assigned")</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted fs-xs fw-semibold">Not Assigned</span>
                                            }
                                        </div>

                                        <!-- Schedule Column -->
                                        <div class="col-time">
                                            <div class="time-item text-muted">
                                                <i class="bi bi-clock me-1"></i> Received: @(item.updated_Time?.ToString("dd MMM, hh:mm tt") ?? "--")
                                            </div>
                                            <div class="time-item highlight fw-semibold text-primary">
                                                <i class="bi bi-calendar-check me-1"></i> Target: @(item.appointment?.ToString("dd MMM, hh:mm tt") ?? "--")
                                            </div>
                                        </div>

                                        <!-- Status Badge Column -->
                                        <div class="col-status">
                                            <span class="badge @GetBadgeClass(item.Status)" style="font-size: 11px; padding: 5px 10px; font-weight: 700; border-radius: 6px;">@item.Status</span>
                                        </div>

                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state py-5 text-center">
                                <i class="bi bi-clipboard-x text-muted" style="font-size: 4rem;"></i>
                                <h5 class="mt-3 fw-bold text-dark">No WhatsApp Bookings</h5>
                                <p class="text-muted">Adjust dates or filters to load historical bookings.</p>
                            </div>
                        }

                        <!-- Premium Pagination Controls -->
                        <div class="premium-pagination">
                            <div class="page-info text-muted fw-semibold">
                                Showing <b>@(((currentPage - 1) * pageSize) + 1)</b> - <b>@Math.Min(currentPage * pageSize, TotalItems)</b> of <b>@TotalItems</b>
                            </div>
                            <div class="page-actions">
                                <button class="page-nav-btn" disabled="@(currentPage <= 1)" @onclick="PreviousPage">
                                    <i class="bi bi-arrow-left"></i>
                                </button>
                                <div class="page-numbers">
                                    @for (int i = 1; i <= TotalPages; i++) {
                                        var p = i;
                                        <button class="page-num @(currentPage == p ? "active" : "")" @onclick="() => currentPage = p">@p</button>
                                    }
                                </div>
                                <button class="page-nav-btn" disabled="@(currentPage >= TotalPages || TotalPages == 0)" @onclick="NextPage">
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

        </section>
    </div>

    <!-- DETAIL SHUTTER PANE (Right Column) -->
    <div class="detail-pane @(isvis ? "open" : "")">
        @if (selectedApt != null)
        {
            var clientFullName = rm1.FirstOrDefault(x => x.ReferralID == selectedApt.referral_id)?.Name ?? "Pending Resolution";
            var riderName = rider.FirstOrDefault(x => x.RiderID == selectedApt.rider_id)?.Name ?? "Unassigned Rider";
            
            <div class="detail-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 rounded bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-whatsapp fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark" style="font-size: 15px;">WA Inbound Details</h5>
                        <small class="text-muted fw-semibold">Booking ID: #@selectedApt.wapp_id</small>
                    </div>
                </div>
                <button type="button" class="btn-close" @onclick="CloseDetails"></button>
            </div>

            <div class="detail-body">
                
                <!-- Raw Message Block -->
                <div class="wa-hud-section mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="wa-hud-label fw-bold text-muted" style="font-size: 10px;"><i class="bi bi-chat-text-fill text-success me-1"></i>Raw Booking Prompt</span>
                        <button type="button" class="btn btn-sm btn-link text-primary p-0 fw-bold" style="font-size: 11px; text-decoration: none;" @onclick="CopyPromptToClipboard">
                            <i class="bi bi-clipboard me-1"></i>Copy Prompt
                        </button>
                    </div>
                    <div class="wa-hud-bubble shadow-sm">@selectedApt.appointment_Text</div>
                </div>

                <!-- Parameters Telemetry Grid -->
                <div class="wa-hud-section mb-4">
                    <span class="wa-hud-label fw-bold text-muted mb-2 d-block" style="font-size: 10px;"><i class="bi bi-sliders text-primary me-1"></i>Dispatch Telemetry</span>
                    <div class="wa-hud-meta-grid">
                        <div class="wa-hud-meta-card shadow-xs">
                            <label class="text-muted" style="font-size: 9px; font-weight: 800; text-transform: uppercase;">Mapped Client</label>
                            <span title="@clientFullName" class="text-truncate fw-bold d-block text-dark">@clientFullName</span>
                        </div>
                        <div class="wa-hud-meta-card shadow-xs">
                            <label class="text-muted" style="font-size: 9px; font-weight: 800; text-transform: uppercase;">Fleet Rider</label>
                            <span title="@riderName" class="text-truncate fw-bold d-block text-dark">@riderName</span>
                        </div>
                        <div class="wa-hud-meta-card shadow-xs">
                            <label class="text-muted" style="font-size: 9px; font-weight: 800; text-transform: uppercase;">Received On</label>
                            <span class="fw-bold d-block text-dark">@(selectedApt.updated_Time?.ToString("dd MMM, hh:mm tt") ?? "--")</span>
                        </div>
                        <div class="wa-hud-meta-card shadow-xs">
                            <label class="text-muted" style="font-size: 9px; font-weight: 800; text-transform: uppercase;">Target Schedule</label>
                            <span class="fw-bold d-block text-dark">@(selectedApt.appointment?.ToString("dd MMM, hh:mm tt") ?? "--")</span>
                        </div>
                    </div>
                </div>

                <!-- SLA Progress Milestone Timelines -->
                <div class="wa-hud-section mb-4">
                    <span class="wa-hud-label fw-bold text-muted mb-2 d-block" style="font-size: 10px;"><i class="bi bi-activity text-info me-1"></i>SLA Milestone Logs</span>
                    <div class="wa-hud-timeline">
                        <div class="wa-timeline-item">
                            <div class="wa-timeline-dot active"></div>
                            <div class="wa-timeline-content">
                                <span class="wa-timeline-title fw-bold text-dark">Booking Ingested via Gateway</span>
                                <span class="wa-timeline-time text-muted">@(selectedApt.updated_Time?.ToString("hh:mm tt") ?? "--")</span>
                            </div>
                        </div>
                        <div class="wa-timeline-item">
                            <div class="wa-timeline-dot @(IsOverdue(selectedApt) ? "alert animate-pulse" : "active")"></div>
                            <div class="wa-timeline-content">
                                <span class="wa-timeline-title fw-bold text-dark">SLA Expiry Watcher Monitoring</span>
                                <span class="wa-timeline-time text-muted">@(IsOverdue(selectedApt) ? "SLA Breached (Unassigned > 5 mins)" : "Active Watcher Online")</span>
                            </div>
                        </div>
                        <div class="wa-timeline-item">
                            <div class="wa-timeline-dot active"></div>
                            <div class="wa-timeline-content">
                                <span class="wa-timeline-title fw-bold text-dark">Operational Status Resolved: <b>@selectedApt.Status</b></span>
                                <span class="wa-timeline-time text-muted">Milestone log complete</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actionable Operator Guidance -->
                <div class="wa-hud-section mt-4 pt-3 border-top">
                    <div class="p-3 rounded-3 bg-light border">
                        <h6 class="fw-bold text-dark mb-1" style="font-size: 12px;"><i class="bi bi-info-circle-fill text-primary me-2"></i>Operator Guide</h6>
                        <p class="text-muted small m-0" style="line-height: 1.5; font-size: 11px;">
                            Copy the raw prompt text above and navigate to the <b>Appointments Entry</b> console to dispatch or update this order.
                        </p>
                    </div>
                </div>

            </div>
        }
    </div>

    <!-- 🚨 Actionable SLA Breach Popup Modal -->
    @if (activeSlaBreachApp != null)
    {
        <div class="sla-popup-backdrop animate-fade-in">
            <div class="sla-popup-box glass-morphic">
                <div class="sla-popup-icon animate-pulse-glow">
                    <i class="bi bi-bell-fill"></i>
                </div>
                <h4 class="fw-bold text-dark mt-3" style="font-size: 17px;">SLA Alert: Dispatch Action Required!</h4>
                <p class="text-muted px-2 mt-2" style="font-size: 13px; line-height: 1.5;">
                    WhatsApp Appointment from <b>@activeSlaBreachApp.wa_number</b> is in <b>@activeSlaBreachApp.Status</b> status and has breached the acceptable dispatch SLA time!
                </p>
                
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <button type="button" class="btn btn-primary px-3 py-2" @onclick="() => RespondToBreach(activeSlaBreachApp)" style="border-radius: 8px; font-weight: 700; font-size: 13px;">
                        <i class="bi bi-chat-dots-fill me-1"></i> Respond
                    </button>
                    <button type="button" class="btn btn-warning text-dark px-3 py-2" @onclick="() => SnoozeBreachAlert(activeSlaBreachApp)" style="border-radius: 8px; font-weight: 700; font-size: 13px;">
                        <i class="bi bi-clock-fill me-1"></i> Snooze (30m)
                    </button>
                    <button type="button" class="btn btn-outline-danger px-3 py-2" @onclick="() => StopBreachAlert(activeSlaBreachApp)" style="border-radius: 8px; font-weight: 700; font-size: 13px;">
                        <i class="bi bi-bell-slash-fill me-1"></i> Silence
                    </button>
                </div>
            </div>
        </div>
    }
    <style>
        .col-origin { width: 80px !important; flex-shrink: 0; }
        .col-ref { width: 70px !important; flex-shrink: 0; text-align: center; }
        .col-job { width: 160px !important; flex-shrink: 0; }
        .col-client { flex: 2 !important; min-width: 220px; }
        .col-rider { flex: 1.2 !important; min-width: 140px; }
        .col-time { flex: 1.6 !important; min-width: 185px; }
        .col-status { width: 110px !important; flex-shrink: 0; text-align: center; }
        
        .row-card-body {
            gap: 16px !important;
        }
    </style>
</section>
}

@code {
    private bool pageReady = false;
    private SfToast toastObj;
    private System.Timers.Timer alertTimer;

    // Actionable SLA Breach Popup Variables
    private WhatsappAppointment? activeSlaBreachApp = null;
    private Dictionary<string, DateTime> snoozedAlerts = new();
    private HashSet<string> ignoredAlertIds = new();
    private DateTime? globalSnoozeUntil = null;
    
    // Default dates extended to 30 days ago and 7 days forward to automatically load history!
	DateTime fdt = DateTime.Today.AddDays(-30);
	DateTime tdt = DateTime.Today.AddDays(7);

	DateTime cdt;

	string userTimeZone = "";
	DateTime aptime = DateTime.Now;

	IList<Referral_Master> rm = new List<Referral_Master>();
	IList<Referral_Master> rm1 = new List<Referral_Master>();
	Referral_Master referal = new();

	IList<Rider_Master> rider = new List<Rider_Master>();

	string refname = ""; int refid = 0;
	string ridername = ""; int riderid = 0;

	WhatsappAppointment apts = new();

    // Active Selected Appointment & Split Pane state
    private WhatsappAppointment selectedApt;
    private bool isvis = false;

    private void SelectAppointment(WhatsappAppointment item)
    {
        selectedApt = item;
        isvis = true;
        StateHasChanged();
    }

    private void CloseDetails()
    {
        selectedApt = null;
        isvis = false;
        StateHasChanged();
    }

    private async Task CopyPromptToClipboard()
    {
        if (selectedApt != null && !string.IsNullOrEmpty(selectedApt.appointment_Text))
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", selectedApt.appointment_Text);
                if (toastObj != null)
                {
                    await toastObj.ShowAsync(new ToastModel
                    {
                        Title = "Copied!",
                        Content = "WhatsApp message prompt copied to clipboard.",
                        CssClass = "e-toast-success",
                        Icon = "e-success"
                    });
                }
            }
            catch (Exception)
            {
                if (toastObj != null)
                {
                    await toastObj.ShowAsync(new ToastModel
                    {
                        Title = "Copy Failed",
                        Content = "Unable to copy text dynamically.",
                        CssClass = "e-toast-warning",
                        Icon = "e-warning"
                    });
                }
            }
        }
    }

    // Pagination & Search State
    private int currentPage = 1;
    private int pageSize = 10;
    private string _searchTerm = "";
    private string searchTerm
    {
        get => _searchTerm;
        set { _searchTerm = value; currentPage = 1; }
    }

    private string currentStat = "1"; // "1": All, "2": Pending, etc.

    private IEnumerable<WhatsappAppointment> FilteredAppList => (applist1 ?? new List<WhatsappAppointment>())
        .Where(x => {
            if (currentStat == "1") return true;
            if (string.IsNullOrWhiteSpace(x.Status)) return false;
            
            var s = x.Status.Trim();
            return currentStat switch {
                "2" => s.Equals("New", StringComparison.OrdinalIgnoreCase) || s.Equals("Pending", StringComparison.OrdinalIgnoreCase),
                "3" => s.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) || s.Equals("Rejected", StringComparison.OrdinalIgnoreCase),
                "4" => s.Equals("Accepted", StringComparison.OrdinalIgnoreCase),
                "5" => s.Equals("Collected", StringComparison.OrdinalIgnoreCase),
                "6" => s.Equals("Completed", StringComparison.OrdinalIgnoreCase) || s.Equals("Finished", StringComparison.OrdinalIgnoreCase),
                _ => true
            };
        })
        .Where(x => string.IsNullOrWhiteSpace(searchTerm) || 
                    (x.wa_number?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.appointment_Text?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.wapp_id?.ToString().Contains(searchTerm) ?? false));

