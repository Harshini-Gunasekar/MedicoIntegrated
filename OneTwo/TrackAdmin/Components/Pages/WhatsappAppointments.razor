    private string GetBadgeClass(string status)
    {
        if (string.IsNullOrEmpty(status)) return "bg-secondary text-dark border";
        return status.ToLower() switch
        {
            "new" or "pending" => "bg-warning text-dark border",
            "accepted" => "bg-info text-dark border",
            "collected" => "bg-primary text-white border",
            "completed" or "finished" => "bg-success text-white border",
            "rejected" or "cancelled" => "bg-danger text-white border",
            _ => "bg-secondary text-dark border"
        };
    }

    protected override void OnInitialized()
    {
        alertTimer = new System.Timers.Timer(60000); // 60 seconds
        alertTimer.Elapsed += async (sender, e) => await CheckOverdueAppointments();
        alertTimer.AutoReset = true;
        alertTimer.Enabled = true;
    }

    private async Task CheckOverdueAppointments()
    {
        if (globalSnoozeUntil.HasValue && DateTime.Now < globalSnoozeUntil.Value) return;
        if (applist1 == null || applist1.Count == 0) return;

        try
        {
            // Find first un-snoozed, un-ignored overdue booking (either >5m unaccepted, or >15m uncollected)
            var breachApp = applist1.FirstOrDefault(x => 
                IsOverdue(x) && 
                !ignoredAlertIds.Contains(x.wapp_id) && 
                (!snoozedAlerts.ContainsKey(x.wapp_id) || DateTime.Now >= snoozedAlerts[x.wapp_id])
            );

            if (breachApp != null && activeSlaBreachApp == null)
            {
                activeSlaBreachApp = breachApp;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception) { }
    }

    private async Task RespondToBreach(WhatsappAppointment app)
    {
        globalSnoozeUntil = DateTime.Now.AddMinutes(15);
        if (app != null)
        {
            SelectAppointment(app);
            snoozedAlerts[app.wapp_id] = DateTime.Now.AddMinutes(15);
        }
        await SaveSnoozeStateAsync();
        activeSlaBreachApp = null;
        StateHasChanged();
     }
 
     private async Task SnoozeBreachAlert(WhatsappAppointment app)
     {
        globalSnoozeUntil = DateTime.Now.AddMinutes(30);
        if (app != null)
        {
            snoozedAlerts[app.wapp_id] = DateTime.Now.AddMinutes(30);
        }
        await SaveSnoozeStateAsync();
        activeSlaBreachApp = null;
        StateHasChanged();
    }

    private async Task StopBreachAlert(WhatsappAppointment app)
    {
        if (app != null)
        {
            ignoredAlertIds.Add(app.wapp_id);
        }
        await SaveSnoozeStateAsync();
        activeSlaBreachApp = null;
        StateHasChanged();
    }

    private async Task LoadSnoozeStateAsync()
    {
        try
        {
            var globalSnoozeStr = await JS.InvokeAsync<string>("localStorage.getItem", "rido_wa_global_snooze_until");
            if (!string.IsNullOrEmpty(globalSnoozeStr) && DateTime.TryParse(globalSnoozeStr, null, System.Globalization.DateTimeStyles.RoundtripKind, out var globalSnooze))
            {
                globalSnoozeUntil = globalSnooze;
            }

            var snoozedAlertsStr = await JS.InvokeAsync<string>("localStorage.getItem", "rido_wa_snoozed_alerts");
            if (!string.IsNullOrEmpty(snoozedAlertsStr))
            {
                snoozedAlerts = JsonConvert.DeserializeObject<Dictionary<string, DateTime>>(snoozedAlertsStr) ?? new();
            }

            var ignoredAlertIdsStr = await JS.InvokeAsync<string>("localStorage.getItem", "rido_wa_ignored_alert_ids");
            if (!string.IsNullOrEmpty(ignoredAlertIdsStr))
            {
                ignoredAlertIds = JsonConvert.DeserializeObject<HashSet<string>>(ignoredAlertIdsStr) ?? new();
            }
        }
        catch (Exception) { }
    }

    private async Task SaveSnoozeStateAsync()
    {
        try
        {
            if (globalSnoozeUntil.HasValue)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "rido_wa_global_snooze_until", globalSnoozeUntil.Value.ToString("o"));
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", "rido_wa_global_snooze_until");
            }

            await JS.InvokeVoidAsync("localStorage.setItem", "rido_wa_snoozed_alerts", JsonConvert.SerializeObject(snoozedAlerts));
            await JS.InvokeVoidAsync("localStorage.setItem", "rido_wa_ignored_alert_ids", JsonConvert.SerializeObject(ignoredAlertIds));
        }
        catch (Exception) { }
    }

    private bool IsOverdue(WhatsappAppointment app)
    {
        if (app == null || !app.updated_Time.HasValue) return false;
        
        // SLA Ignored or Snoozed Check
        if (ignoredAlertIds.Contains(app.wapp_id)) return false;
        if (snoozedAlerts.TryGetValue(app.wapp_id, out var snoozeUntil) && DateTime.Now < snoozeUntil) return false;

        try
        {
            var tt2 = msd.ConvertToUtc(DateTime.Now);
            var now = msd.ConvertToDubaiTime(tt2);
            
            // 1. Unassigned / Unaccepted SLA (> 5m)
            if (app.Status == "Pending" || app.Status == "New")
            {
                return (now - app.updated_Time.Value).TotalMinutes > 5;
            }

            // 2. Accepted but not Collected SLA (> 15m)
            if (app.Status == "Accepted")
            {
                return (now - app.updated_Time.Value).TotalMinutes > 15;
            }
        }
        catch { }
        return false;
    }

    public void Dispose()
    {
        if (alertTimer != null)
        {
            alertTimer.Stop();
            alertTimer.Dispose();
        }
    }
