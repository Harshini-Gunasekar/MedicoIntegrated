@code {
    string chk1 = "1";
    bool isvis = false;
    string viewMode = "grid";
    string activeFilter = "all";
    string activeType = "";

    private async Task OnClose()
    {
        isvis = false;
        dotNetRef?.Dispose();
        this.GetReferralAsync();
        referral = new();
        chk1 = "1";
    }

    string search = "";
    int referralid = 0;
    Referral_Master referral = new();
    IList<Referral_Master> refm1 = new List<Referral_Master>();
    IList<Referral_Master> refm = new List<Referral_Master>();
    IList<Rider_Master> rm = new List<Rider_Master>();
    private DotNetObjectReference<ReferralMaster>? dotNetRef;

    [Inject] IOptions<APIConfiguration> ApiConfig { get; set; }
    string rider = "";
    string apiurl = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            apiurl = ApiConfig.Value.BaseApiUrl;
            this.GetRiderAsync();
            this.GetReferralAsync();
            StateHasChanged();
        }
    }

    Double Latitude = 0;
    Double Longitude = 0;

    private async Task UpdateRadius()
    {
        await JS.InvokeVoidAsync("focusOnAddress", "maprefrral", search);
    }

    [JSInvokable("ReferralLocation")]
    public Task SetDestinationLocation(double lat, double lng)
    {
        referral.Latitude = lat;
        referral.Longitude = lng;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task GetRiderAsync()
    {
        try
        {
            var response = await http.GetAsync(apiurl + "User/GetFleetRiders");
            var tt = response.Content.ReadAsStringAsync();
            var rid = JsonConvert.DeserializeObject<List<Rider_Master>>(tt.Result);
            rm = rid;
            StateHasChanged();
        }
        catch (Exception ex) { var mtm = ex.Message.ToString(); }
    }

    private async Task GetReferralAsync()
    {
        try
        {
            var response = await http.GetAsync(apiurl + "Referral/allreferral");
            var tt = response.Content.ReadAsStringAsync();
            refm1 = JsonConvert.DeserializeObject<List<Referral_Master>>(tt.Result);
            ApplyFilters();
            // Update top header
            Metadata.UpdatePage(
                "Client Master",
                "Healthcare partners, clinics & geofence configuration",
                "bi-buildings-fill",
                new List<TrackAdmin.Data.PageStat>
                {
                    new TrackAdmin.Data.PageStat { Label = "Total Partners", Value = refm1.Count.ToString() },
                    new TrackAdmin.Data.PageStat { Label = "Active", Value = refm1.Count(x => x.Status == "Active").ToString(), Color = "text-success" },
                    new TrackAdmin.Data.PageStat { Label = "Archived", Value = refm1.Count(x => x.Status == "Deleted").ToString(), Color = "text-danger" }
                }
            );
            StateHasChanged();
        }
        catch (Exception ex) { var mtm = ex.Message.ToString(); }
    }

    private void ApplyFilters()
    {
        IEnumerable<Referral_Master> filtered = refm1;

        // Status filter
        filtered = activeFilter switch
        {
            "Active" => filtered.Where(x => x.Status == "Active"),
            "Deleted" => filtered.Where(x => x.Status == "Deleted"),
            _ => filtered.Where(x => x.Status != "Deleted")
        };

        // Type filter
        if (!string.IsNullOrEmpty(activeType))
            filtered = filtered.Where(x => (x.ReferralType ?? "").Equals(activeType, StringComparison.OrdinalIgnoreCase));

        refm = filtered.OrderBy(x => x.Name).ToList();
        currentPage = 1;
    }

    private void SetFilter(string filter)
    {
        activeFilter = filter;
        ApplyFilters();
        StateHasChanged();
    }

    private void SetTypeFilter(string type)
    {
        activeType = activeType == type ? "" : type;
        ApplyFilters();
        StateHasChanged();
    }

    private async Task RadiusChange(int? args)
    {
        referral.Radius = (int)args;
        await JS.InvokeVoidAsync("updateCircleRadius", (double)referral.Radius);
        StateHasChanged();
    }

    private async Task btnsave()
    {
        if (referralid > 0) { referral.ModifiedDate = DateTime.Now; }
        else { referral.EnteredDate = DateTime.Now; }

        referral.Status = referral.Status ?? "Active";
        referral.MobileNo = referral.MobileNo?.Trim() ?? "";
        referral.Email = referral.Email?.Trim() ?? "";
        if (referral.DefaultRider == null) { referral.DefaultRider = 0; }
        if (referral.ReferralType == null) { referral.ReferralType = "Hospital"; }

        HttpResponseMessage response;
        if (referralid > 0)
            response = await http.PostAsJsonAsync(apiurl + "Referral/Update", referral);
        else
            response = await http.PostAsJsonAsync(apiurl + "Referral/Add", referral);

        var tt = await response.Content.ReadAsStringAsync();
        string alertMsg = tt;
        try
        {
            var jsonObj = JsonConvert.DeserializeObject<Dictionary<string, string>>(tt);
            if (jsonObj != null && jsonObj.ContainsKey("Message")) alertMsg = jsonObj["Message"];
        }
        catch { }

        await dp.AlertAsync(alertMsg);

        if (response.IsSuccessStatusCode)
        {
            referral = new();
            referralid = 0;
            isvis = false;
        }
        this.GetReferralAsync();
    }

    private async Task OnRiderSel(SelectEventArgs<Rider_Master> args)
    {
        referral.DefaultRider = args.ItemData.RiderID;
    }

    private async Task SelRef(Referral_Master args)
    {
        try
        {
            isvis = !isvis;
            dotNetRef = DotNetObjectReference.Create(this);
            await Task.Delay(50);
            await JS.InvokeVoidAsync("initReferralMap", dotNetRef);

            referralid = args.ReferralID;
            referral = new();
            referral = args;
            referral.ContactPerson = referral.ContactPerson?.Trim() ?? "";
            referral.ContactNo = referral.ContactNo?.Trim() ?? "";
            rider = rm.Where(x => x.RiderID == args.DefaultRider).Select(x => x.Name).FirstOrDefault() ?? "Select Rider";

            await Task.Delay(500);
            await JS.InvokeVoidAsync("initialReferralMap", args.Radius, args.Latitude, args.Longitude, args.Name);
            await Task.Delay(50);
            StateHasChanged();
        }
        catch (Exception ex) { var mg = ex.Message.ToString(); }
    }

    private async Task AddNew()
    {
        try
        {
            referral = new();
            referral.Radius = 20;
            isvis = !isvis;
            dotNetRef = DotNetObjectReference.Create(this);
            await Task.Delay(50);
            await JS.InvokeVoidAsync("initReferralMap", dotNetRef);
            StateHasChanged();
        }
        catch (Exception ex) { await dp.AlertAsync(ex.Message.ToString()); }
    }

    // Pagination & Search
    private int currentPage = 1;
    private int pageSize = 12;
    private string _searchTerm = "";
    private string searchTerm
    {
        get => _searchTerm;
        set { _searchTerm = value; currentPage = 1; }
    }

    private IEnumerable<Referral_Master> FilteredList => refm
        .Where(x => string.IsNullOrWhiteSpace(searchTerm) ||
                    (x.Name ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (x.ContactPerson ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (x.Email ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private IList<Referral_Master> PaginatedList => FilteredList
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    private int TotalItems => FilteredList.Count();
    private int TotalPages => (int)Math.Ceiling(TotalItems / (double)pageSize);

    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void PreviousPage() { if (currentPage > 1) currentPage--; }

    private async Task DeleteReferral(Referral_Master args)
    {
        Referral_Master apoint = args;
        string refsat = ""; string reftit = "";
        if (args.Status == "Active")
        {
            apoint.Status = "Deleted";
            refsat = $"Archive {apoint.Name}?";
            reftit = "Archive Client";
        }
        else
        {
            apoint.Status = "Active";
            refsat = $"Restore {apoint.Name} back to Active?";
            reftit = "Restore Client";
        }

        bool isConfirm = await dp.ConfirmAsync(refsat, reftit);
        if (isConfirm)
        {
            var res = await http.PostAsJsonAsync($"{apiurl}Referral/Update", apoint);
            this.GetReferralAsync();
        }
    }

    // Helper methods for type styling
    private string GetTypeClass(string? type) => type?.ToLower() switch
    {
        "hospital" => "hospital",
        "clinic" => "clinic",
        "company" => "company",
        "doctor" => "doctor",
        _ => "others"
    };

    private string GetTypeIcon(string? type) => type?.ToLower() switch
    {
        "hospital" => "bi-hospital-fill",
        "clinic" => "bi-plus-square-fill",
        "company" => "bi-building-fill",
        "doctor" => "bi-person-badge-fill",
        _ => "bi-buildings"
    };

    private string GetStatusCss(string? status) => status?.ToLower() switch
    {
        "active" => "active-status",
        "deleted" => "deleted-status",
        _ => "active-status"
    };
}
