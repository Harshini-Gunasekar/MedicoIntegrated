@page "/Referral"
@rendermode InteractiveServer

@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using TrackAdmin.Components.Layout
@using TrackAdmin.Data

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using TrackAdmin.Models
@inject NavigationManager Navigation
@inject HttpClient http
@inject SfDialogService dp
@inject IJSRuntime JS
@inject UserSessionService session
@inject PageMetadataService Metadata

<!-- ══ CLIENT MASTER PAGE ══ -->
<div class="cm-page animate-fade-in">

    <!-- ══ COMPACT TOOLBAR ══ -->
    <div class="cm-toolbar">
        <!-- Mini partner counters -->
        <div class="cm-mini-counts">
            <span class="cm-mini-count blue">
                <i class="bi bi-buildings-fill"></i>
                <strong>@refm1.Count</strong>
                <span>Total Partners</span>
            </span>
            <span class="cm-mini-sep"></span>
            <span class="cm-mini-count red">
                <i class="bi bi-archive-fill"></i>
                <strong>@refm1.Count(x => x.Status == "Deleted")</strong>
                <span>Archived</span>
            </span>
        </div>
        <div class="cm-search-wrap">
            <i class="bi bi-search cm-search-icon"></i>
            <input id="clientSearchInput" type="text" class="cm-search-input" placeholder="Search client..." @bind="searchTerm" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <button class="cm-search-clear" @onclick="@(() => { searchTerm = ""; currentPage = 1; })">
                    <i class="bi bi-x"></i>
                </button>
            }
        </div>
        <div class="cm-filter-pills">
            <button class="cm-filter-pill @(activeFilter == "all" ? "active" : "")" @onclick='@(() => SetFilter("all"))'>All</button>
            <button class="cm-filter-pill green @(activeFilter == "Active" ? "active" : "")" @onclick='@(() => SetFilter("Active"))'>
                <span class="cpill-dot green"></span> Active
            </button>
            <button class="cm-filter-pill red @(activeFilter == "Deleted" ? "active" : "")" @onclick='@(() => SetFilter("Deleted"))'>
                <span class="cpill-dot red"></span> Archived
            </button>
        </div>
        <!-- Type filter chips -->
        <div class="cm-type-chips">
            @foreach (var t in new[] { "Hospital", "Clinic", "Company", "Doctor", "Others" })
            {
                <button class="cm-type-chip @GetTypeClass(t) @(activeType == t ? "active" : "")"
                        @onclick="@(() => SetTypeFilter(t))">
                    <i class="bi @GetTypeIcon(t)"></i> @t
                </button>
            }
        </div>
        <div class="cm-toolbar-right">
            @if (session.Rights.HasAccess("client", "Create"))
            {
                <button type="button" id="btnAddClient" @onclick="@AddNew" class="cm-add-btn-sm">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>New Client</span>
                </button>
            }
            <button class="cm-view-btn @(viewMode == "grid" ? "active" : "")" @onclick='@(() => viewMode = "grid")' title="Card Grid">
                <i class="bi bi-grid-3x3-gap-fill"></i>
            </button>
            <button class="cm-view-btn @(viewMode == "list" ? "active" : "")" @onclick='@(() => viewMode = "list")' title="Table View">
                <i class="bi bi-table"></i>
            </button>
            <button class="cm-refresh-btn" @onclick="@GetReferralAsync" title="Refresh">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- ══ MAIN CONTENT ══ -->
    <div class="cm-content-area">

        <!-- CARD GRID VIEW -->
        @if (viewMode == "grid")
        {
            @if (PaginatedList != null && PaginatedList.Count > 0)
            {
                <div class="cm-card-grid">
                    @foreach (var item in PaginatedList)
                    {
                        <div class="cm-client-card @GetStatusCss(item.Status)">
                            <div class="cm-card-top-accent @GetTypeClass(item.ReferralType)"></div>

                            <!-- Card Header -->
                            <div class="cm-card-head">
                                <div class="cm-client-icon @GetTypeClass(item.ReferralType)">
                                    <i class="bi @GetTypeIcon(item.ReferralType)"></i>
                                </div>
                                <div class="cm-card-head-info">
                                    <div class="cm-client-name">@item.Name</div>
                                    <span class="cm-type-badge @GetTypeClass(item.ReferralType)">
                                        <i class="bi @GetTypeIcon(item.ReferralType)"></i>
                                        @item.ReferralType
                                    </span>
                                </div>
                                <div class="cm-card-status-wrap">
                                    <span class="cm-status-dot @GetStatusCss(item.Status)"></span>
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="cm-card-body">
                                @if (!string.IsNullOrWhiteSpace(item.ContactPerson))
                                {
                                    <div class="cm-info-row">
                                        <i class="bi bi-person-fill"></i>
                                        <span>@item.ContactPerson</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.MobileNo))
                                {
                                    <div class="cm-info-row">
                                        <i class="bi bi-phone-fill text-primary"></i>
                                        <span>@item.MobileNo</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Email))
                                {
                                    <div class="cm-info-row">
                                        <i class="bi bi-envelope-fill text-info"></i>
                                        <span class="cm-truncate">@item.Email</span>
                                    </div>
                                }
                                <div class="cm-meta-strip">
                                    @if (item.DefaultRider > 0)
                                    {
                                        <span class="cm-rider-chip">
                                            <i class="bi bi-scooter"></i>
                                            @(rm.FirstOrDefault(x => x.RiderID == item.DefaultRider)?.Name ?? "Assigned")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="cm-rider-chip unassigned">
                                            <i class="bi bi-person-dash"></i> Unassigned
                                        </span>
                                    }
                                    @if (item.Radius > 0)
                                    {
                                        <span class="cm-geo-chip">
                                            <i class="bi bi-geo-alt-fill"></i> @item.Radius m
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Card Footer Actions -->
                            <div class="cm-card-footer">
                                @if (session.Rights.HasAccess("client", "Edit"))
                                {
                                    <button type="button" class="cm-card-action map" @onclick="@(() => SelRef(item))" title="View on Map / Edit">
                                        <i class="bi bi-geo-alt"></i> <span>Map &amp; Edit</span>
                                    </button>
                                }
                                @if (session.Rights.HasAccess("client", "Delete"))
                                {
                                    <button type="button" class="cm-card-action @(item.Status == "Active" ? "del" : "restore")" @onclick="@(() => DeleteReferral(item))"
                                            title="@(item.Status == "Active" ? "Archive" : "Restore")">
                                        <i class="bi @(item.Status == "Active" ? "bi-archive" : "bi-arrow-counterclockwise")"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="cm-empty-state">
                    <div class="cm-empty-orb">
                        <i class="bi bi-building-exclamation"></i>
                    </div>
                    <h5>No clients found</h5>
                    <p>Adjust your search or filter criteria, or add a new client partner.</p>
                </div>
            }
        }

        <!-- TABLE / LIST VIEW -->
        @if (viewMode == "list")
        {
            <div class="cm-table-container">
                <table class="cm-table">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <th>Client / Clinic</th>
                            <th>Contact Details</th>
                            <th>Primary Rider</th>
                            <th class="text-center">Geofence</th>
                            <th class="text-center">Status</th>
                            <th class="text-center" style="width:130px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (PaginatedList != null && PaginatedList.Count > 0)
                        {
                            int idx = (currentPage - 1) * pageSize + 1;
                            @foreach (var item in PaginatedList)
                            {
                                <tr class="cm-table-row">
                                    <td class="text-center fw-bold text-secondary">@(idx++)</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="cm-tbl-icon @GetTypeClass(item.ReferralType)">
                                                <i class="bi @GetTypeIcon(item.ReferralType)"></i>
                                            </div>
                                            <div>
                                                <div class="cm-tbl-name">@item.Name</div>
                                                <span class="cm-type-badge @GetTypeClass(item.ReferralType)">@item.ReferralType</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="cm-info-row small"><i class="bi bi-person text-muted me-1"></i>@item.ContactPerson</div>
                                        <div class="cm-info-row small text-muted mt-1">
                                            <i class="bi bi-phone me-1"></i>@item.MobileNo
                                            @if (!string.IsNullOrWhiteSpace(item.Email))
                                            {
                                                <span class="mx-1">·</span>
                                                <i class="bi bi-envelope me-1"></i>@item.Email
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.DefaultRider > 0)
                                        {
                                            <span class="cm-rider-chip">
                                                <i class="bi bi-scooter"></i>
                                                @(rm.FirstOrDefault(x => x.RiderID == item.DefaultRider)?.Name ?? "Assigned")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="cm-rider-chip unassigned"><i class="bi bi-person-dash"></i> Unassigned</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.Radius > 0)
                                        {
                                            <span class="cm-geo-chip">
                                                <i class="bi bi-geo-alt-fill"></i> @item.Radius m
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="cm-status-badge @GetStatusCss(item.Status)">@item.Status</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex gap-2 justify-content-center">
                                            @if (session.Rights.HasAccess("client", "Edit"))
                                            {
                                                <button type="button" class="cm-act-btn edit" @onclick="@(() => SelRef(item))" title="Edit &amp; Map">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            }
                                            @if (session.Rights.HasAccess("client", "Delete"))
                                            {
                                                <button type="button" class="cm-act-btn @(item.Status == "Active" ? "del" : "restore")"
                                                        @onclick="@(() => DeleteReferral(item))"
                                                        title="@(item.Status == "Active" ? "Archive" : "Restore")">
                                                    <i class="bi @(item.Status == "Active" ? "bi-archive" : "bi-arrow-counterclockwise")"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center py-5 text-muted">No clients found matching the search.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- PAGINATION -->
        <div class="cm-pagination">
            <span class="cm-page-info">
                Showing @(TotalItems == 0 ? 0 : ((currentPage - 1) * pageSize) + 1)–@Math.Min(currentPage * pageSize, TotalItems) of <strong>@TotalItems</strong> clients
            </span>
            <div class="cm-page-controls">
                <button class="cm-page-btn" disabled="@(currentPage <= 1)" @onclick="PreviousPage">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span class="cm-page-current">@currentPage / @(TotalPages == 0 ? 1 : TotalPages)</span>
                <button class="cm-page-btn" disabled="@(currentPage >= TotalPages || TotalPages == 0)" @onclick="NextPage">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══ ADD / EDIT DIALOG (Full width with map) ══ -->
<SfDialog visible="@isvis" Model="true" Width="95%" ShowCloseIcon="false">
    <DialogTemplates>
        <Header>
            <div class="d-flex align-items-center justify-content-between w-100">
                <div class="d-flex align-items-center gap-2 fw-bold" style="color:#2563eb;">
                    <i class="bi bi-pencil-square"></i>
                    <span>Partner Registration &amp; Geofence Configuration</span>
                </div>
                <button type="button" @onclick="OnClose" class="dlg-close-btn"><i class="bi bi-x-lg"></i></button>
            </div>
        </Header>
        <Content>
            <div class="row g-4 p-2">
                <!-- LEFT: Form -->
                <section class="col-6 p-4 rounded-4 bg-white shadow-sm border border-light">
                    <EditForm Model="@referral" OnValidSubmit="@btnsave">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger py-2 px-3 mb-3 small" />
                        <div class="row g-3">
                            <div class="col-4">
                                <SfTextBox FloatLabelType="FloatLabelType.Always" Placeholder="Short Name" @bind-Value="@referral.ShortName"></SfTextBox>
                            </div>
                            <div class="col-8">
                                <SfTextBox FloatLabelType="FloatLabelType.Always" Placeholder="Referral Name" @bind-Value="@referral.Name"></SfTextBox>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12">
                                <SfTextBox FloatLabelType="FloatLabelType.Always" Placeholder="Contact Person" @bind-Value="@referral.ContactPerson"></SfTextBox>
                            </div>
                        </div>
                        <div class="row g-3 mt-2">
                            <div class="col-6">
                                <SfTextBox FloatLabelType="FloatLabelType.Always" Placeholder="Mobile" @bind-Value="@referral.MobileNo"></SfTextBox>
                            </div>
                            <div class="col-6">
                                <SfTextBox FloatLabelType="FloatLabelType.Always" Placeholder="Contact No" @bind-Value="@referral.ContactNo"></SfTextBox>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12">
                                <SfTextBox FloatLabelType="FloatLabelType.Always" Placeholder="Email" @bind-Value="@referral.Email"></SfTextBox>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12">
                                <SfTextArea Width="100%" FloatLabelType="FloatLabelType.Always" Placeholder="Billing Address" @bind-Value="@referral.BillingAddress"></SfTextArea>
                            </div>
                        </div>
                        <div class="row g-3 mt-2 align-items-end">
                            <div class="col-6">
                                <small class="text-muted fw-bold small d-block mb-1">Geofence Radius (meters)</small>
                                <SfNumericTextBox ValueChanged="@RadiusChange" Value="@referral.Radius" TValue="int?"></SfNumericTextBox>
                            </div>
                            <div class="col-6">
                                <small class="text-muted fw-bold small d-block mb-1">Referral Type</small>
                                <select @bind="@referral.ReferralType" class="form-select py-1 rounded-3" style="font-size: 13px; height: 38px;">
                                    <option value="Doctor">Doctor</option>
                                    <option value="Hospital">Hospital</option>
                                    <option value="Clinic">Clinic</option>
                                    <option value="Company">Company</option>
                                    <option value="Others">Other(s)</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12">
                                <SfDropDownList DataSource="@rm" TItem="Rider_Master" @bind-Value="@rider" AllowFiltering=true FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" TValue="string" FloatLabelType="FloatLabelType.Always" Placeholder="Assign Default Rider">
                                    <DropDownListFieldSettings Text="Name" Value="Name"></DropDownListFieldSettings>
                                    <DropDownListEvents OnValueSelect="OnRiderSel" TValue="string" TItem="Rider_Master"></DropDownListEvents>
                                </SfDropDownList>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-primary px-5 py-2 fw-bold rounded-3 shadow-sm border-0" style="background: linear-gradient(135deg, #2563eb, #1d4ed8); min-width: 160px;">
                                    <i class="bi bi-floppy me-1"></i> Save Partner
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </section>

                <!-- RIGHT: Map -->
                <section class="col-6 position-relative">
                    <div class="row position-absolute z-3 d-flex justify-content-end" style="right: 15px; top: 15px;">
                        <div class="col-auto d-flex px-0 shadow-sm rounded-3 bg-white" style="margin-top:2px; overflow: hidden; border: 1px solid #e2e8f0;">
                            <SfTextBox @bind-Value="search" Placeholder="Search map address..." Width="220px"></SfTextBox>
                        </div>
                        <div class="col-auto px-0" style="margin-right: 15px; margin-top:2px;">
                            <button type="button" @onclick="@UpdateRadius" class="btn btn-primary border-0 rounded-3 shadow-sm" style="height: 38px; width: 38px; display: flex; align-items: center; justify-content: center; background: #2563eb; margin-left: 5px;">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                    <div class="z-0 rounded-4 overflow-hidden border" id="mapreferral" style="height: 480px; border-color: #cbd5e1 !important; box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);"></div>
                    <div class="row mt-3 g-2 align-items-center">
                        <div class="col-5">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-muted small">Lat</span>
                                <input class="form-control" @bind-value="@referral.Latitude" readonly style="font-size: 12px;" />
                            </div>
                        </div>
                        <div class="col-5">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-muted small">Lng</span>
                                <input class="form-control" @bind-value="@referral.Longitude" readonly style="font-size: 12px;" />
                            </div>
                        </div>
                        <div class="col-2 text-end">
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-3 px-2 w-100" @onclick="@UpdateRadius" title="Recenter Map">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                    </div>
                </section>
            </div>
        </Content>
    </DialogTemplates>
    <DialogEvents onclose="@OnClose"></DialogEvents>
</SfDialog>

<style>
/* ══ CLIENT MASTER - NEXT LEVEL DESIGN ══ */
.cm-page {
    padding: 0;
    min-height: 100vh;
    background: #f0f4fa;
    font-family: 'Inter', 'Segoe UI', sans-serif;
}

/* ── HERO BAND ── */
.cm-hero-band {
    background: linear-gradient(135deg, #0a2540 0%, #16345e 55%, #0d2844 100%);
    padding: 28px 32px 0 32px;
    position: relative; overflow: hidden;
}
.cm-hero-band::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 80% 50%, rgba(6,182,212,0.08) 0%, transparent 60%);
    pointer-events: none;
}
.cm-hero-content { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
.cm-hero-left { display: flex; align-items: center; gap: 16px; }
.cm-hero-icon-orb {
    width: 52px; height: 52px; border-radius: 16px;
    background: linear-gradient(135deg, #06b6d4, #2563eb);
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; color: #fff;
    box-shadow: 0 8px 24px rgba(6,182,212,0.4);
}
.cm-hero-title { color: #fff; font-size: 26px; font-weight: 900; margin: 0; line-height: 1.1; }
.cm-hero-sub { color: rgba(255,255,255,0.5); font-size: 13px; margin: 4px 0 0 0; }
.cm-add-btn {
    display: inline-flex; align-items: center; gap: 8px;
    background: linear-gradient(135deg, #06b6d4, #2563eb);
    color: #fff; border: none; border-radius: 12px;
    padding: 12px 24px; font-size: 13px; font-weight: 700;
    cursor: pointer; transition: all 0.25s;
    box-shadow: 0 8px 20px rgba(6,182,212,0.4);
}
.cm-add-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(6,182,212,0.55); }

/* ── KPI STRIP ── */
.cm-kpi-strip {
    display: flex; gap: 0; overflow-x: auto;
    padding-bottom: 0; margin: 0 -32px;
    scrollbar-width: none;
}
.cm-kpi-strip::-webkit-scrollbar { display: none; }
.cm-kpi-card {
    flex: 1; min-width: 110px;
    display: flex; align-items: center; gap: 12px;
    padding: 16px 20px;
    border-top: 1px solid rgba(255,255,255,0.06);
    border-right: 1px solid rgba(255,255,255,0.06);
    position: relative; overflow: hidden;
    cursor: default; transition: background 0.2s;
}
.cm-kpi-card:hover { background: rgba(255,255,255,0.04); }
.cm-kpi-card:last-child { border-right: none; }
.cm-kpi-icon { font-size: 22px; flex-shrink: 0; }
.cm-kpi-card.blue .cm-kpi-icon { color: #60a5fa; }
.cm-kpi-card.green .cm-kpi-icon { color: #34d399; }
.cm-kpi-card.teal .cm-kpi-icon { color: #2dd4bf; }
.cm-kpi-card.purple .cm-kpi-icon { color: #a78bfa; }
.cm-kpi-card.amber .cm-kpi-icon { color: #fbbf24; }
.cm-kpi-card.red .cm-kpi-icon { color: #f87171; }
.cm-kpi-num { display: block; font-size: 26px; font-weight: 900; color: #fff; line-height: 1; }
.cm-kpi-lbl { display: block; font-size: 11px; color: rgba(255,255,255,0.45); font-weight: 600; margin-top: 2px; letter-spacing: 0.3px; text-transform: uppercase; }
.cm-kpi-glow { position: absolute; width: 60px; height: 60px; border-radius: 50%; right: -10px; top: -10px; opacity: 0.15; filter: blur(15px); }
.blue-glow { background: #60a5fa; } .green-glow { background: #34d399; } .teal-glow { background: #2dd4bf; }
.amber-glow { background: #fbbf24; } .purple-glow { background: #a78bfa; } .red-glow { background: #f87171; }

/* ── TOOLBAR ── */
.cm-toolbar {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 24px; background: #fff;
    border-bottom: 1px solid #e2e8f0;
    flex-wrap: wrap;
}
.cm-search-wrap {
    position: relative; display: flex; align-items: center;
    background: #f8fafc; border: 1.5px solid #e2e8f0;
    border-radius: 12px; flex: 1; min-width: 200px; max-width: 320px;
    transition: border-color 0.2s;
}
.cm-search-wrap:focus-within { border-color: #06b6d4; box-shadow: 0 0 0 3px rgba(6,182,212,0.12); }
.cm-search-icon { position: absolute; left: 12px; color: #94a3b8; font-size: 14px; }
.cm-search-input {
    flex: 1; border: none; background: transparent;
    padding: 10px 12px 10px 36px; font-size: 13px; color: #0f172a;
    outline: none; border-radius: 12px;
}
.cm-search-clear { background: none; border: none; color: #94a3b8; padding: 0 10px; cursor: pointer; font-size: 16px; }
.cm-search-clear:hover { color: #ef4444; }
.cm-filter-pills { display: flex; align-items: center; gap: 6px; }
.cm-filter-pill {
    display: inline-flex; align-items: center; gap: 6px;
