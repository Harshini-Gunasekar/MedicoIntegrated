@page "/Appointments"
@rendermode InteractiveServer

@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using TrackAdmin.Components.Layout
@using TrackAdmin.Data
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.DropDowns
@using TrackAdmin.Models
@inject NavigationManager Navigation
@inject HttpClient http
@inject SfDialogService dp
@inject IJSRuntime JS
@inject RiderTracking riderTracking
@inject MasterData msd
@inject UserSessionService session
@inject ProtectedSessionStorage protectedSessionStore

@if (!pageReady)
{
    <div class="food-loading">
        <p>Loading...</p>
    </div>
}
else
{
    @if (showDeleteConfirm)
    {
        <div class="delete-popup-backdrop">
            <div class="delete-popup-box">
                <div class="delete-popup-icon">
                    <i class="bi bi-trash3-fill"></i>
                </div>

                <h4>Delete Appointment?</h4>
                <p>
                    Are you sure you want to delete appointment
                    <strong>@deleteAppSno</strong>?
                </p>

                <div class="delete-popup-actions">
                    <button class="btn btn-light" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    }
    <section class="food-page">
        <div class="food-header">
            <div class="food-header-left">
                <h2 class="food-page-title">Appointments</h2>
                <p class="food-page-subtitle">Alpha Rido • Fast booking and rider operations</p>
            </div>

            <div class="food-header-chip">
                <i class="bi bi-lightning-charge-fill"></i>
                <span>Live Operations</span>
            </div>
        </div>

        <section class="container-fluid food-body">
            <header class="food-toolbar">
                <section class="row py-2 align-items-end">
                    <div class="col-1">
                        <label class="food-label">From Date</label>
                    </div>
                    <div class="col-2">
                        <InputDate Type="InputDateType.Date" @bind-Value="@fdt" class="form-control food-date-input"></InputDate>
                    </div>

                    <div class="col-1">
                        <label class="food-label">To Date</label>
                    </div>
                    <div class="col-2">
                        <InputDate Type="InputDateType.Date" @bind-Value="@tdt" class="form-control food-date-input"></InputDate>
                    </div>

                    <div class="col-2">
                        <button type="button" class="food-btn-primary" @onclick="@(() => GetAppList(1))">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-2">
                        <button type="button" class="food-btn-secondary" @onclick="@AddNew">
                            <i class="bi bi-plus-circle"></i> New Appointment
                        </button>
                    </div>
                </section>

                <section class="row py-2 align-items-center">
                    <div class="col-3">
                        <small class="food-label">Search</small>
                        <span>
                            <SfTextBox Input="OnInput"></SfTextBox>
                        </span>
                    </div>

                    <div class="col-9">
                        <div class="food-status-wrap">
                            <SfRadioButton Label="All" Name="Status" Value="1" TChecked="String" @bind-Checked="@stats" @onchange="StatChange"></SfRadioButton>
                            <SfRadioButton Label="Pending" Name="Status" Value="2" TChecked="String" @bind-Checked="@stats" @onchange="StatChange"></SfRadioButton>
                            <SfRadioButton Label="Rejected" Name="Status" Value="3" TChecked="String" @bind-Checked="@stats" @onchange="StatChange"></SfRadioButton>
                            <SfRadioButton Label="Accepted" Name="Status" Value="4" TChecked="String" @bind-Checked="@stats" @onchange="StatChange"></SfRadioButton>
                            <SfRadioButton Label="Collected" Name="Status" Value="5" TChecked="String" @bind-Checked="@stats" @onchange="StatChange"></SfRadioButton>
                            <SfRadioButton Label="Completed" Name="Status" Value="6" TChecked="String" @bind-Checked="@stats" @onchange="StatChange"></SfRadioButton>
                        </div>
                    </div>
                </section>
            </header>

            <section class="row mb-3">
                <div class="col p-2 text-center">
                    <section class="food-stat-card card-orange">
                        <small>Total Appointments</small><br />
                        <h4>@applist.Count</h4>
                    </section>
                </div>

                <div class="col p-2 text-center">
                    <section class="food-stat-card card-yellow">
                        <small>Pending</small><br />
                        <h4>@applist.Where(x => x.Status == "Pending" || x.Status == "New").Count()</h4>
                    </section>
                </div>

                <div class="col p-2 text-center">
                    <section class="food-stat-card card-blue">
                        <small>Accepted</small><br />
                        <h4>@applist.Where(x => x.Status == "Accepted").Count()</h4>
                    </section>
                </div>

                <div class="col p-2 text-center">
                    <section class="food-stat-card card-red">
                        <small>Rejected</small><br />
                        <h4>@applist.Where(x => x.Status == "Rejected").Count()</h4>
                    </section>
                </div>

                <div class="col p-2 text-center">
                    <section class="food-stat-card card-slate">
                        <small>Collected</small><br />
                        <h4>@applist.Where(x => x.Status == "Collected").Count()</h4>
                    </section>
                </div>

                <div class="col p-2 text-center">
                    <section class="food-stat-card card-green">
                        <small>Completed</small><br />
                        <h4>@applist.Where(x => x.Status == "Completed").Count()</h4>
                    </section>
                </div>
            </section>

            @{
                string het1 = "calc(100vh-160px);";
            }

            <SfDialog Visible="@isvis" ShowCloseIcon="true" IsModal="true" Width="80%" Height="@het1">
                <DialogTemplates>
                    <Header>@(isedit ? "Edit Appointment" : "Add New Appointment")</Header>
                    <Content>
                        <section class="row">
                            <section class="col-5">
                                <EditForm Model="@apts" OnInvalidSubmit="btnsave">
                                    <DataAnnotationsValidator></DataAnnotationsValidator>
                                    <ValidationSummary></ValidationSummary>

                                    <section class="row">
                                        <div class="col">
                                            <small class="food-label">Appointment ID</small><br />
                                            <SfNumericTextBox @bind-Value="@apts.AppSno" ShowClearButton="false" ShowSpinButton="false" Enabled="false"></SfNumericTextBox>
                                        </div>
                                        <div class="col">
                                            <small class="food-label">Status</small><br />
                                            <span>
                                                <select @bind="@apts.Status" class="form-select" disabled="true">
                                                    <option value="New">New</option>
                                                    <option value="Pending">Pending</option>
                                                    <option value="Collected">Collected</option>
                                                    <option value="Completed">Completed</option>
                                                    <option value="Cancelled">Cancelled</option>
                                                    <option value="Rejected">Rejected</option>
                                                </select>
                                            </span>
                                        </div>
                                    </section>

                                    <section class="row mt-2">
                                        <div class="col">
                                            <small class="food-label">Called Time</small><br />
                                            <SfDateTimePicker @bind-Value="@apts.CalledTime" Placeholder="Choose date & time" ShowClearButton="true"></SfDateTimePicker>
                                        </div>
                                        <div class="col">
                                            <small class="food-label">Appointment Time</small><br />
                                            <SfDateTimePicker @bind-Value="@apts.AppointmentOn" Placeholder="Choose date & time" Min="@cdt" ShowClearButton="true"></SfDateTimePicker>
                                        </div>
                                    </section>

                                    <section class="row mt-2">
                                        <div class="col">
                                            <small class="food-label">Select Client</small><br />
                                            <SfAutoComplete @ref="@drpref" TValue="string" TItem="Referral_Master" @bind-Value="@refname">
                                                <AutoCompleteFieldSettings Text="Name" Value="Name"></AutoCompleteFieldSettings>
                                                <AutoCompleteEvents Filtering="@OnReferralFilter" OnValueSelect="@OnRefSel" TValue="string" TItem="Referral_Master"></AutoCompleteEvents>
                                            </SfAutoComplete>
                                        </div>
                                    </section>

                                    @if (nearbyriders != null && nearbyriders.Count > 0)
                                    {
                                        <section class="row py-2">
                                            <strong class="text-decoration-underline">Rider and Distance</strong>
                                            <SfGrid DataSource="@nearbyriders.Take(5).ToList()">
                                                <GridColumns>
                                                    <GridColumn Field="riderName"></GridColumn>
                                                    <GridColumn Field="distance"></GridColumn>
                                                </GridColumns>
                                            </SfGrid>
                                        </section>
                                    }

                                    <section class="row mt-2">
                                        <div class="col">
                                            <small class="food-label">Select Rider ID</small><br />
                                            <SfComboBox DataSource="@rider" TValue="string" TItem="Rider_Master" @bind-Value="@ridername">
                                                <ComboBoxFieldSettings Text="Name"></ComboBoxFieldSettings>
                                                <ComboBoxEvents OnValueSelect="@OnSelRider" TValue="string" TItem="Rider_Master"></ComboBoxEvents>
                                            </SfComboBox>
                                        </div>
                                    </section>

                                    <section class="row mt-2">
                                        <div class="col">
                                            <small class="food-label">Remarks</small><br />
                                            <SfTextArea Type="InputDateType.DateTimeLocal" @bind-Value="@apts.Narration" Width="100%"></SfTextArea>
                                        </div>
                                    </section>

                                    <footer class="row py-3">
                                        <div class="col ms-auto">
                                            <button type="button" @onclick="@btnsave" class="food-btn-primary">Save</button>
                                        </div>
                                        <div class="col ms-auto">
                                            <button type="button" @onclick="@ClearFields" class="food-btn-secondary">Clear</button>
                                        </div>
                                    </footer>
                                </EditForm>
                            </section>

                            <section class="col">
                                <div class="food-map-box z-0" id="mapreferral"></div>
                            </section>
                        </section>
                    </Content>
                </DialogTemplates>
                <DialogEvents OnClose="CloseDialog"></DialogEvents>
            </SfDialog>
            <SfToast @ref="toastObj" Timeout="2500">
                <ToastPosition X="Right" Y="Top"></ToastPosition>
            </SfToast>

            <section class="row">
                @{
                    string het = "calc(100vh - 410px);";
                }

                <div class="col-9">
                    <section class="food-grid-box">
                        <SfGrid @ref="@grd1" DataSource="@applist" EnableStickyHeader="true" Width="100%" Height="@het" AllowPaging="true">
                            <GridPageSettings PageCount="5" PageSizes="true"></GridPageSettings>
                            <GridEvents QueryCellInfo="CustomizeCell" TValue="Appointments"></GridEvents>
                            <GridColumns>
                                <GridColumn HeaderText="Source" Width="70" TextAlign="TextAlign.Center">
                                    <Template Context="data">
                                        @{
                                            var item = (Appointments)data;
                                        }

                                        @if (item.AppType == 1)
                                        {
                                            <img src="images/whatsapp.jpg" alt="WhatsApp" style="width:20px;height:20px;" />
                                        }
                                        else
                                        {
                                            <img src="images/manual.png" alt="Manual" style="width:20px;height:20px;" />
                                        }
                                    </Template>
                                </GridColumn>

                                <GridColumn Field="@nameof(Appointments.AppSno)" HeaderText="ID" Width="70" TextAlign="TextAlign.Center"></GridColumn>
                                <GridForeignColumn Field="@nameof(Appointments.ReferralID)" ForeignKeyField="ReferralID" ForeignKeyValue="ShortName" ForeignDataSource="@rm1" HeaderText="Client"></GridForeignColumn>
                                <GridForeignColumn Field="@nameof(Appointments.RiderID)" ForeignKeyField="RiderID" ForeignKeyValue="ShortName" ForeignDataSource="@rider" HeaderText="Rider"></GridForeignColumn>
                                <GridColumn Field="@nameof(Appointments.CalledTime)" Format="dd-MM-yyyy hh:mm tt" HeaderText="Called Time"></GridColumn>
                                <GridColumn Field="@nameof(Appointments.AppointmentOn)" Format="dd-MM-yyyy hh:mm tt" HeaderText="Appointment Time"></GridColumn>
                                <GridColumn Field="@nameof(Appointments.Status)" Width="100px" TextAlign="TextAlign.Center" HeaderText="Status"></GridColumn>

                                <GridColumn HeaderText="Edit" Width="110" TextAlign="TextAlign.Center">
                                    <Template Context="item">
                                        @{
                                            var row = item as Appointments;
                                        }
                                        <button type="button"
                                                class="btn btn-sm btn-primary"
                                                @onclick="async () => await EditAppointByAppSno(row.AppSno)">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </button>
                                    </Template>
                                </GridColumn>

                                <GridColumn HeaderText="Delete" Width="110" TextAlign="TextAlign.Center">
                                    <Template Context="item">
                                        @{
                                            var row = item as Appointments;
                                        }
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                @onclick="async () => await DeleteAppointByAppSno(row.AppSno)">
                                            <i class="bi bi-trash3"></i> Delete
                                        </button>
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </section>
                </div>

                <div class="col-3">
                    <section class="food-rider-box">
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-person-fill-up text-danger fs-3 me-2"></i>
                            <h5 class="mb-0">Rider Overview</h5>
                        </div>

                        @foreach (var it in rider)
                        {
                            var Collected = applist.Where(x => x.RiderID == it.RiderID && x.Status == "Collected").Count();
                            var Allocated = applist.Where(x => x.RiderID == it.RiderID).Count();

                            if (Allocated > 0)
                            {
                                var progressPercent = Allocated == 0 ? 0 : (int)((double)Collected / Allocated * 100);
                                string progressColor = GetProgressColor(rider.IndexOf(it));

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div>
                                            <small>@it.ShortName</small>
                                        </div>
                                        <small>@Collected / @Allocated collected</small>
                                    </div>
                                    <div class="progress" style="height: 12px;">
                                        <div class="progress-bar @progressColor" role="progressbar"
                                             style="width: @progressPercent%" aria-valuenow="@progressPercent"
                                             aria-valuemin="0" aria-valuemax="100">
                                            @progressPercent%
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </section>
                </div>
            </section>
        </section>
    </section>
}

@code {
    private SfToast toastObj;
    private bool pageReady = false;
    bool showDeleteConfirm = false;
    int deleteAppSno = 0;
    string stats = "1";
    DateTime fdt = DateTime.UtcNow;
    DateTime tdt = DateTime.UtcNow;
    DateTime cdt;

    string userTimeZone = "";
    DateTime aptime = DateTime.Now;

    IList<Referral_Master> rm = new List<Referral_Master>();
    IList<Referral_Master> rm1 = new List<Referral_Master>();
    Referral_Master referal = new();

    IList<Rider_Master> rider = new List<Rider_Master>();

    string refname = "";
    int refid = 0;

    string ridername = "";
    int riderid = 0;

    Appointments apts = new();

    [Inject] IOptions<APIConfiguration> ApiConfig { get; set; }

    SfAutoComplete<string, Referral_Master> drpref;
    bool isedit = false;
    bool isvis = false;

    private DotNetObjectReference<AppointmentsEntry>? dotNetRef;

    IList<dynamic> nearbyriders = new List<dynamic>();
    IList<Appointments> rapp = new List<Appointments>();
    IList<Appointments> applist = new List<Appointments>();
    IList<Appointments> applist1 = new List<Appointments>();
    IList<RiderLocation> rloc = new List<RiderLocation>();

    SfGrid<Appointments> grd1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var loginState = await protectedSessionStore.GetAsync<bool>("IsLoggedIn");

            if (!loginState.Success || !loginState.Value)
            {
                Navigation.NavigateTo("/");
                return;
            }

            var tenant = await protectedSessionStore.GetAsync<string>("TenantID");
            var userId = await protectedSessionStore.GetAsync<int>("UserID");
            var userName = await protectedSessionStore.GetAsync<string>("UserName");

            session.IsLoggedIn = true;
            session.TenantID = tenant.Success ? tenant.Value : null;
            session.UserID = userId.Success ? userId.Value : 0;
            session.UserName = userName.Success ? userName.Value : null;

            pageReady = true;
            StateHasChanged();

            try
            {
                var tt2 = msd.ConvertToUtc(DateTime.Now);
                cdt = msd.ConvertToDubaiTime(tt2);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                await dp.AlertAsync(ex.Message);
            }

            await LoadRiderAsync();
            await GetSno();

            if (apts.EnteredDate == null)
            {
                apts.EnteredDate = DateTime.Now;
                apts.CalledTime = DateTime.Now;
                apts.AppointmentOn = DateTime.Now;
            }

            await GetAppList(1);
        }
    }

    private async Task GetSno()
    {
        var res = await http.GetAsync("SampleCollection/Appointmentid");
        var tt = await res.Content.ReadAsStringAsync();
        apts.AppSno = Convert.ToInt32(tt);
        StateHasChanged();
    }

    private async Task OnRefSel(SelectEventArgs<Referral_Master> args)
    {
        try
        {
            refid = args.ItemData.ReferralID;
            await RiderCLAsync();
            await JS.InvokeVoidAsync("initialReferralMapwithRiders", args.ItemData.Radius, args.ItemData.Latitude, args.ItemData.Longitude, args.ItemData.Name, rloc, dotNetRef);
        }
        catch (Exception ex)
        {
            await dp.AlertAsync(ex.Message);
        }
    }

    [JSInvokable]
    public async Task ReceiveNearestRider(JsonElement nearestRider)
    {
        nearbyriders.Clear();
        var jsonString = nearestRider.GetRawText();

        nearbyriders = JsonConvert.DeserializeObject<IList<dynamic>>(jsonString);

        if (nearbyriders != null && nearbyriders.Count > 0)
        {
            nearbyriders = nearbyriders.OrderBy(x => x.distance).ToList();
        }

        StateHasChanged();
    }

    private async Task OnReferralFilter(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(args.Text))
            {
                var res = await http.GetAsync("referral/referralquery?rname=" + args.Text);
                var tt = await res.Content.ReadAsStringAsync();
                rm = JsonConvert.DeserializeObject<IList<Referral_Master>>(tt);
                await drpref.FilterAsync(rm);
            }
            else
            {
                rm = new List<Referral_Master>();
            }

            StateHasChanged();
        }
        catch
        {
        }
    }

    private async Task GetReferral(int id)
    {
        if (id > 0)
        {
            var res = await http.GetAsync("referral/referralid/rname=" + id);
            var tt = await res.Content.ReadAsStringAsync();
            referal = JsonConvert.DeserializeObject<Referral_Master>(tt);
        }
    }

    private async Task LoadRiderAsync()
    {
        var res = await http.GetAsync("user/alluser");
        var tt = await res.Content.ReadAsStringAsync();
        var rider1 = JsonConvert.DeserializeObject<IList<Rider_Master>>(tt);
        rider = rider1.Where(x => x.Status.Trim() == "Active").ToList();
        StateHasChanged();
    }

    private async Task OnSelRider(SelectEventArgs<Rider_Master> args)
    {
        riderid = args.ItemData.RiderID;
    }

    private async Task btnsave()
    {
        apts.RiderID = riderid;
        apts.ReferralID = refid;
        apts.Deleted = false;

        if (!apts.IsNext)
        {
            apts.IsNext = false;
        }

        apts.Narration = apts.Narration ?? "";
        apts.EnteredDate = apts.EnteredDate ?? DateTime.Now.ToLocalTime();

        if (riderid > 0 && refid > 0)
        {
            HttpResponseMessage res;

            if (isedit == false)
            {
                res = await http.PostAsJsonAsync("samplecollection/appointment", apts);
            }
            else
            {
                res = await http.PostAsJsonAsync("samplecollection/updateappointment", apts);
            }

            var tt = await res.Content.ReadAsStringAsync();

            if (res.IsSuccessStatusCode)
            {
                isvis = false;
                await ClearFields();
                await GetAppList(1);

                await toastObj.ShowAsync(new ToastModel
                {
                    Title = "Success",
                    Content = "Successfully Saved"
                });
            }
        }
    }

    private async Task ClearFields()
    {
        apts = new();
        apts.CalledTime = msd.ConvertToDubaiTime(msd.ConvertToUtc(DateTime.Now));
        apts.AppointmentOn = msd.ConvertToDubaiTime(msd.ConvertToUtc(DateTime.Now));
        apts.Status = "New";
        nearbyriders.Clear();
        refname = "";
        ridername = "";
        refid = 0;
        riderid = 0;
        apts.IsNext = false;
        apts.Deleted = false;
        isedit = false;

        try
        {
            var tt1 = DateTime.Now;
            var tt2 = msd.ConvertToUtc(tt1);
            cdt = msd.ConvertToDubaiTime(tt2);
        }
        catch (Exception ex)
        {
            await dp.AlertAsync(ex.Message);
        }

        await GetSno();
    }

    private async Task RiderUpcomingAppointment()
    {
        rapp.Clear();

        if (riderid > 0)
        {
            var res = await http.GetAsync("sample/fixedapp?id=" + riderid);
            var tt = await res.Content.ReadAsStringAsync();
            rapp = JsonConvert.DeserializeObject<IList<Appointments>>(tt);
        }

        StateHasChanged();
    }

    private async Task GetAppList(int id)
    {
        string sd = fdt.ToString("yyyy-MM-dd") + " 00:00:00";
        string ed = tdt.ToString("yyyy-MM-dd") + " 23:59:59";
        string url = "";

        if (id == 1)
        {
            url = $"sampleCollection/appdate?sd={Uri.EscapeUriString(sd)}&ed={Uri.EscapeUriString(ed)}&isupcoming={false}";
        }
        else if (id == 2)
        {
            url = $"sampleCollection/appdate?sd={Uri.EscapeUriString(sd)}&ed={Uri.EscapeUriString(ed)}&isupcoming={true}";
        }

        var res = await http.GetAsync(url);
        var tt = await res.Content.ReadAsStringAsync();
        applist1 = JsonConvert.DeserializeObject<IList<Appointments>>(tt);
        applist = applist1.Where(x => x.Deleted == false).ToList();
        applist = applist.OrderByDescending(x => x.AppSno).ToList();

        if (applist.Count > 0)
        {
            string rid = string.Join(",", applist.Select(x => $"{x.ReferralID}"));
            var res1 = await http.GetAsync($"referral/referralid?rname={Uri.EscapeUriString(rid)}");
            var tt1 = await res1.Content.ReadAsStringAsync();
            rm1 = JsonConvert.DeserializeObject<IList<Referral_Master>>(tt1);
        }

        StateHasChanged();
    }

    private async Task AddNew()
    {
        try
        {
            isedit = false;
            refname = "";
            nearbyriders.Clear();
            ridername = "";
            riderid = 0;
            refid = 0;
            isvis = true;
            apts = new Appointments();
            apts.Status = "New";
            apts.Deleted = false;
            apts.IsNext = false;

            try
            {
                apts.CalledTime = cdt;
                apts.AppointmentOn = cdt;
            }
            catch (Exception ex)
            {
                await dp.AlertAsync(ex.Message);
            }

            await GetSno();

            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initReferralMap", dotNetRef);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await dp.AlertAsync(ex.Message);
        }
    }

    private async Task CloseDialog()
    {
        isvis = false;
        await GetAppList(1);
    }

    private async Task RiderCLAsync()
    {
        rloc.Clear();

        var rcl = await riderTracking.GetRCL();

        if (rcl != null && rcl.Count > 0)
        {
            foreach (var it in rcl)
            {
                string? tname = rider.Where(x => x.RiderID == it.RiderID).Select(x => x.ShortName).FirstOrDefault() ?? "Unknown";

                rloc.Add(new RiderLocation()
                {
                    RiderId = Convert.ToString(it.RiderID),
                    RiderName = tname,
                    vehicleType = it.Vehicle,
                    Latitude = Convert.ToDouble(it.Latitude),
                    Longitude = Convert.ToDouble(it.Longitude)
                });
            }
        }
    }

    private async Task DeleteAppoint(Appointments args)
    {
        bool isConfirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this item?");

        if (isConfirm)
        {
            Appointments apoint = new Appointments();
            apoint = args;
            apoint.Id = args.Id;
            apoint.Deleted = true;

            var res = await http.PostAsJsonAsync("SampleCollection/updateappointment", apoint);
            var tt = await res.Content.ReadAsStringAsync();

            if (res.IsSuccessStatusCode)
            {
                await GetAppList(1);

                if (grd1 != null)
                {
                    await grd1.Refresh();
                }

                await InvokeAsync(StateHasChanged);
                await dp.AlertAsync("Deleted successfully");
            }
            else
            {
                await dp.AlertAsync(tt);
            }
        }
    }
    private async Task EditAppoint(Appointments args)
    {
        try
        {
            isedit = true;
            isvis = true;

            await RiderCLAsync();

            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initReferralMap", dotNetRef);

            apts = new Appointments()
            {
                Id = args.Id,
                AppSno = args.AppSno,
                AppType = args.AppType,
                ReferralID = args.ReferralID,
                CustID = args.CustID,
                RiderID = args.RiderID,
                CalledTime = args.CalledTime,
                AppointmentOn = args.AppointmentOn,
                Deleted = args.Deleted,
                Narration = args.Narration,
                EnteredDate = args.EnteredDate,
                Status = args.Status,
                IsNext = args.IsNext
            };

            refid = args.ReferralID.GetValueOrDefault();
            riderid = args.RiderID.GetValueOrDefault();

            var rm2 = rm1.Where(x => x.ReferralID == args.ReferralID).ToList();
            if (rm2.Count > 0)
            {
                await drpref.FilterAsync(rm2);
                await Task.Delay(300);
                drpref.Value = rm2[0].Name;
                refname = Convert.ToString(rm2[0].Name.Trim());
                refid = rm2[0].ReferralID;

                await JS.InvokeVoidAsync(
                    "initialReferralMapwithRiders",
                    rm2[0].Radius,
                    rm2[0].Latitude,
                    rm2[0].Longitude,
                    rm2[0].Name,
                    rloc,
                    dotNetRef
                );
            }

            var rid = rider.Where(x => x.RiderID == args.RiderID.GetValueOrDefault()).ToList();
            if (rid.Count > 0)
            {
                ridername = rid[0].Name;
                riderid = rid[0].RiderID;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await dp.AlertAsync(ex.Message);
        }
    }

    private async Task StatChange(ChangeEventArgs args)
    {
        var value = args.Value;

        if (value == "All")
        {
            applist = applist1;
        }
        else
        {
            applist = value switch
            {
                "1" => applist1.ToList(),
                "2" => applist1.Where(x => x.Status == "New" || x.Status == "Pending").ToList(),
                "3" => applist1.Where(x => x.Status == "Cancelled" || x.Status == "Rejected").ToList(),
                "4" => applist1.Where(x => x.Status == "Accepted").ToList(),
                "5" => applist1.Where(x => x.Status == "Collected").ToList(),
                "6" => applist1.Where(x => x.Status == "Completed" || x.Status == "Finished").ToList(),
                _ => new List<Appointments>()
            };
        }

        StateHasChanged();
    }

    private async Task OnInput(InputEventArgs args)
    {
        if (!string.IsNullOrWhiteSpace(args.Value))
        {
            await grd1.SearchAsync(args.Value);
        }
        else
        {
            await grd1.SearchAsync(string.Empty);
        }
    }

    private static readonly string[] ProgressColors = new[]
    {
        "bg-primary", "bg-success", "bg-info", "bg-warning", "bg-danger", "bg-secondary"
    };

    private string GetProgressColor(int riderId)
    {
        int index = Math.Abs(riderId.GetHashCode()) % ProgressColors.Length;
        return ProgressColors[index];
    }

    public void CustomizeCell(QueryCellInfoEventArgs<Appointments> args)
    {
        if (args.Column.Field == "Status")
        {
            if (args.Data.Status == "Pending" || args.Data.Status == "New")
            {
                args.Cell.AddClass(new string[] { "food-status-pending" });
            }
            else if (args.Data.Status == "Rejected" || args.Data.Status == "Cancelled")
            {
                args.Cell.AddClass(new string[] { "food-status-rejected" });
            }
            else if (args.Data.Status == "Accepted")
            {
                args.Cell.AddClass(new string[] { "food-status-accepted" });
            }
            else if (args.Data.Status == "Completed" || args.Data.Status == "Finished")
            {
                args.Cell.AddClass(new string[] { "food-status-completed" });
            }
        }
    }
    private async Task EditAppointByAppSno(int appSno)
    {
        var args = applist.FirstOrDefault(x => x.AppSno == appSno);
        if (args == null)
        {
            await dp.AlertAsync("Appointment not found");
            return;
        }

        await EditAppoint(args);
    }

    private async Task DeleteAppointByAppSno(int appSno)
    {
        var args = applist.FirstOrDefault(x => x.AppSno == appSno);
        if (args == null)
        {
            await dp.AlertAsync("Appointment not found");
            return;
        }

        await DeleteAppoint(args);
    }
    private void OpenDeleteConfirmByAppSno(int appSno)
    {
        deleteAppSno = appSno;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        deleteAppSno = 0;
    }

    private async Task ConfirmDelete()
    {
        showDeleteConfirm = false;

        await DeleteAppointByAppSno(deleteAppSno);

        deleteAppSno = 0;
    }
}