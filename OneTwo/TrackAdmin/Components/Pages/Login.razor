                new FeatureDetail { Icon = "bi-bar-chart-line", Header = "Performance Insights", Text = "Data-driven decisions" }
            }
        },
        new SlideItem { 
            Badge = "WELCOME TO RIDO",
            Title = "Logistics Intelligence That Delivers", 
