@layout LoginLayout
@page "/"
@attribute [AllowAnonymous]

@rendermode @(new InteractiveServerRenderMode(prerender:false))

@using Microsoft.Extensions.Options
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using TrackAdmin.Components.Layout
@using TrackAdmin.Data
@using Syncfusion.Blazor.Popups
@using TrackAdmin.Models

@inject NavigationManager Navigation
@inject HttpClient http
@inject SfDialogService dp
@inject UserSessionService session
@inject ProtectedSessionStorage protectedSessionStore
@inject TenantState _tenantState
@inject AuthenticationStateProvider authStateProvider
@inject TenantService TenantService
@using Newtonsoft.Json

<section class="split-view-wrapper">
    <div class="login-theater-box">
        <!-- Immersive Animated Background Slideshow -->
        <div class="slideshow-bg-container">
            @for (int i = 0; i < slides.Count; i++)
            {
                var slide = slides[i];
                <div class="bg-slide @(i == activeSlideIndex ? "active" : "")" style="background-image: url('@slide.PosterUrl');"></div>
            }
        </div>
        <div class="video-overlay-global"></div>

    <div class="left-hero-panel">
        <div class="hero-content-wrapper">
            @for (int i = 0; i < slides.Count; i++)
            {
                var slide = slides[i];
                <div class="slide-content-block @(i == activeSlideIndex ? "active" : "")">
                    <span class="hero-badge">@slide.Badge</span>
                    <h1 class="hero-title">@slide.Title</h1>
                    <p class="hero-subtitle">@slide.Description</p>
                    
                    <div class="hero-features-list">
                        @foreach (var feat in slide.Features)
                        {
                            <div class="feature-item-row">
                                <div class="feature-icon-circle">
                                    <i class="bi @feat.Icon"></i>
                                </div>
                                <div class="feature-text-block">
                                    <h3>@feat.Header</h3>
                                    <p>@feat.Text</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="slider-dots-bottom">
                @for (int i = 0; i < slides.Count; i++)
                {
                    <div class="dot @(i == activeSlideIndex ? "active" : "")" @onclick="() => SetActiveSlide(i)"></div>
                }
            </div>
        </div>
    </div>

    <div class="right-form-panel">
        <div class="form-card-wrap">
            <div class="brand-identity-container">
                @if (isInitializing)
                {
                    <div class="login-logo-wrapper" style="min-height: 100px;">
                        <div class="spinner-border text-primary" style="width: 2.2rem; height: 2.2rem;" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="login-logo-wrapper">
                        <img src="@GetLogoWithFallback(logoUrl)" onerror="this.src='/images/rido-logo-pro.png'" class="login-brand-logo" />
                    </div>
                }
            </div>

            <div class="card-login-header">
                <h2>Welcome back</h2>
                <p>Sign in to continue</p>
            </div>

            <div class="form-body">
                @if (isInitializing)
                {
                    <div class="text-center py-5">
                        <div class="spinner-grow text-primary" role="status"></div>
                        <p class="mt-3 text-muted small fw-bold">ESTABLISHING SECURE LINK...</p>
                    </div>
                }
                else
                {
                    @if (string.IsNullOrEmpty(txttenant) || !isTenantAutoResolved)
                    {
                        <div class="form-group-modern">
                            <label>Organization Domain</label>
                            <div class="input-wrap">
                                <i class="bi bi-building"></i>
                                <input type="text" @bind="txttenant" @onblur="@(() => ResolveTenantLogo(txttenant))" placeholder="Enter Domain" />
                            </div>
                        </div>
                    }

                    <div class="form-group-modern">
                        <label>User ID</label>
                        <div class="input-wrap">
                            <i class="bi bi-person"></i>
                            <input type="text" @bind="txtuser" @onkeyup="HandleKeyUp" placeholder="Enter your User ID" />
                        </div>
                    </div>

                    <div class="form-group-modern">
                        <label>Password</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock"></i>
                            <input type="@PasswordInputType" @bind="txtpass" @onkeyup="HandleKeyUp" placeholder="Enter your Password" />
                            <button type="button" class="toggle-trigger" @onclick="TogglePassword">
                                <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert-modern animate-shake">
                            <i class="bi bi-shield-exclamation"></i>
                            <span>@errorMessage</span>
                        </div>
                    }

                    <div class="form-checkbox-row">
                        <label class="checkbox-container">
                            <input type="checkbox" @bind="rememberTenant" />
                            <span class="checkmark"></span>
                            Remember me
                        </label>
                        <a href="#" class="forgot-link">Forgot password?</a>
                    </div>

                    <button class="btn-primary-action" @onclick="GetUserAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <span>SIGN IN</span>
                        }
                    </button>

                    <div class="form-help-footer" style="display: flex; flex-direction: column; gap: 8px; align-items: center;">
                        <div style="margin-bottom: 4px;">
                            <button type="button" @onclick="GoToRegister" class="btn btn-link register-link" style="color: #2563eb; text-decoration: none; font-weight: bold; padding: 0; border: none; background: none; font-size: inherit;">
                                <i class="bi bi-person-plus-fill" style="margin-right: 4px;"></i>New Register
                            </button>
                        </div>
                        <span>Need help? <a href="#">Contact Support</a></span>
                    </div>
                }
            </div>
        </div>
    </div>
    </div>
</section>

@code {
    [Inject] IOptions<APIConfiguration> ApiConfig { get; set; }

