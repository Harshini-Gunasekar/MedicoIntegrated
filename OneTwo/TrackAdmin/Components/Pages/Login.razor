    public class SlideItem {
        public string Badge { get; set; }
        public string Title { get; set; }
        public string Description { get; set; }
        public string PosterUrl { get; set; }
        public List<FeatureDetail> Features { get; set; }
    }

    public class FeatureDetail {
        public string Icon { get; set; }
        public string Header { get; set; }
        public string Text { get; set; }
    }

    private void SetActiveSlide(int index) {
        activeSlideIndex = index;
        StateHasChanged();
    }

    private string PasswordInputType => showPassword ? "text" : "password";

    protected override async Task OnInitializedAsync()
    {
        api = ApiConfig.Value.BaseApiUrl;
        
        // Start Slider Timer
        sliderTimer = new System.Timers.Timer(5000);
        sliderTimer.Elapsed += (s, e) => {
            activeSlideIndex = (activeSlideIndex + 1) % slides.Count;
            InvokeAsync(StateHasChanged);
        };
        sliderTimer.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                var uri = new Uri(Navigation.BaseUri);
                var host = uri.Host;

                var encodedHost = System.Net.WebUtility.UrlEncode(host);
                var response = await http.GetAsync($"{api}Tenant/GetIdByHost?host={encodedHost}");
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<TenantResponse>();
                    if (result != null && !string.IsNullOrEmpty(result.TenantId))
                    {
                        txttenant = result.TenantId;
                        _tenantState.TenantID = txttenant;
                        isTenantAutoResolved = true; 
                        
                        if (!string.IsNullOrEmpty(result.TenantId))
                        {
                            logoUrl = $"{api}Tenant/GetLogo?tenantId={result.TenantId}";
                        }
                        else
                        {
                            logoUrl = "/images/rido-logo-pro.png";
                        }
                        if (!string.IsNullOrEmpty(result.TenantName))
                        {
                            brandName = result.TenantName;
                        }
                    }
                }
            }
            catch (Exception) { }
            
            if (string.IsNullOrEmpty(txttenant))
            {
                var savedTenant = await protectedSessionStore.GetAsync<string>("SavedTenantID");
                if (savedTenant.Success && !string.IsNullOrWhiteSpace(savedTenant.Value))
                {
                    txttenant = savedTenant.Value;
                    rememberTenant = true;
                    _tenantState.TenantID = txttenant;
                    await ResolveTenantLogo(txttenant);
                }
            }

            isInitializing = false;
            StateHasChanged();
        }
    }

    private async Task ResolveTenantLogo(string tid)
    {
        try
        {
            var response = await http.GetAsync($"{api}Tenant/GetBasicTenantInfo?tenantIdentifier={tid}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<TenantResponse>();
                if (result != null && !string.IsNullOrEmpty(result.TenantId))
                {
                    logoUrl = $"{api}Tenant/GetLogo?tenantId={result.TenantId}";
                    brandName = !string.IsNullOrEmpty(result.TenantName) ? result.TenantName : "Rido";
                    StateHasChanged();
                }
                else
                {
                    logoUrl = "/images/rido-logo-pro.png";
                    brandName = "Rido";
                    StateHasChanged();
                }
            }
        }
        catch { }
    }

    public class TenantResponse 
    { 
        public string TenantId { get; set; } 
        public string LogoUrl { get; set; }
        public string TenantName { get; set; }
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    public class LoginResponse
    {
        public int UserID { get; set; }
        public string GlobalUserID { get; set; }
        public string UserName { get; set; }
        public string TenantID { get; set; }
        public string Token { get; set; }
        public bool IsAdmin { get; set; }
    }

    private async Task GetUserAsync()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(txttenant))
        {
            errorMessage = "Please enter tenant ID";
            return;
        }

        if (string.IsNullOrWhiteSpace(txtuser))
        {
            errorMessage = "Please enter user ID / Email / Mobile";
            return;
        }

        if (string.IsNullOrWhiteSpace(txtpass))
        {
            errorMessage = "Please enter password";
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            lm.TenantID = txttenant;
            lm.LoginId = txtuser;
            lm.Password = txtpass;
            lm.IsMobile = false;

            _tenantState.TenantID = txttenant;
            
            // Reverting to the standard injected client. 
            // We will let the TenantHeaderHandler handle the header logic exclusively.
            var res = await http.PostAsJsonAsync($"{api}Login/GetLoginDetails", lm);

            if (res.IsSuccessStatusCode)
            {
                var result = await res.Content.ReadFromJsonAsync<LoginResponse>();

                session.IsLoggedIn = true;
                session.TenantID = result.TenantID;
                session.UserID = result.UserID;
                session.UserName = result.UserName;
                session.IsAdmin = result.IsAdmin;
                session.Rights.IsAdmin = result.IsAdmin;

                _tenantState.TenantID = result.TenantID;
                _tenantState.TenantName = brandName;

                await protectedSessionStore.SetAsync("IsLoggedIn", true);
                await protectedSessionStore.SetAsync("TenantID", result.TenantID);
                await protectedSessionStore.SetAsync("TenantName", brandName);
                await protectedSessionStore.SetAsync("UserID", result.UserID);
                await protectedSessionStore.SetAsync("UserName", result.UserName);

                if (rememberTenant)
                    await protectedSessionStore.SetAsync("SavedTenantID", txttenant);
                else
                    await protectedSessionStore.DeleteAsync("SavedTenantID");

                var userSession = new UserSession
                {
                    UserID = result.UserID.ToString(),
                    GlobalUserID = result.GlobalUserID,
                    UserName = result.UserName,
                    TenantID = result.TenantID,
                    Token = result.Token,
                    IsAdmin = result.IsAdmin
                };

                // Fetch real-time rights from DB
                try
                {
                    var rightsResult = await TenantService.GetUserPermissionsAsync(result.UserID, result.TenantID, "RIDO_APP", result.Token);
                    if (rightsResult != null && !string.IsNullOrEmpty(rightsResult.RightsJson))
                    {
                        var jObj = Newtonsoft.Json.Linq.JObject.Parse(rightsResult.RightsJson);
                        if (jObj["Features"] != null || jObj["features"] != null)
                        {
                            // Parse top-level properties first
                            if (jObj["chat_level"] != null) userSession.Rights.chat_level = (int)jObj["chat_level"];
                            if (jObj["IsAdmin"] != null) userSession.Rights.IsAdmin = (bool)jObj["IsAdmin"];

                            var featuresToken = jObj["Features"] ?? jObj["features"];
                            foreach (var feature in (Newtonsoft.Json.Linq.JObject)featuresToken)
                            {
                                var featureKey = feature.Key;
                                var access = feature.Value;
                                
                                if (!userSession.Rights.Features.ContainsKey(featureKey)) 
                                    userSession.Rights.Features[featureKey] = new FeatureAccess();
                                
                                userSession.Rights.Features[featureKey].View = (bool)(access["View"] ?? access["view"] ?? false);
                                userSession.Rights.Features[featureKey].Create = (bool)(access["Create"] ?? access["create"] ?? false);
                                userSession.Rights.Features[featureKey].Edit = (bool)(access["Edit"] ?? access["edit"] ?? false);
                                userSession.Rights.Features[featureKey].Delete = (bool)(access["Delete"] ?? access["delete"] ?? false);
                                userSession.Rights.Features[featureKey].Export = (bool)(access["Export"] ?? access["export"] ?? false);
                            }
                        }
                        else
                        {
                            // Fallback for old format
                            foreach (var prop in jObj.Properties())
                            {
                                if (prop.Name.Equals("chat_level", StringComparison.OrdinalIgnoreCase)) userSession.Rights.chat_level = (int)prop.Value;
                                else if (prop.Name.Equals("IsAdmin", StringComparison.OrdinalIgnoreCase)) userSession.Rights.IsAdmin = (bool)prop.Value;
                                else if (prop.Value.Type == Newtonsoft.Json.Linq.JTokenType.Boolean)
                                {
                                    var rawKey = prop.Name.Replace("can_view_", "").Replace("can_edit_", "").Replace("can_delete_", "").Replace("can_create_", "");
                                    var targetKey = rawKey switch {
                                        "details" => "staff",
                                        "rider" => "staff",
                                        "referral" => "client",
                                        _ => rawKey
                                    };

                                    if (!userSession.Rights.Features.ContainsKey(targetKey)) 
                                        userSession.Rights.Features[targetKey] = new FeatureAccess();
                                    
                                    if (prop.Name.Contains("view")) userSession.Rights.Features[targetKey].View = (bool)prop.Value;
                                    if (prop.Name.Contains("create")) userSession.Rights.Features[targetKey].Create = (bool)prop.Value;
                                    if (prop.Name.Contains("edit")) userSession.Rights.Features[targetKey].Edit = (bool)prop.Value;
                                    if (prop.Name.Contains("delete")) userSession.Rights.Features[targetKey].Delete = (bool)prop.Value;
                                }
                            }
                        }
                    }
                    userSession.Rights.IsAdmin = result.IsAdmin;
                    session.Rights = userSession.Rights;
                }
                catch { }

                await ((JwtAuthenticationStateProvider)authStateProvider).UpdateAuthenticationState(userSession);

                // Set global state logo before redirecting so MainLayout has it immediately
                _tenantState.SetLogo(TenantService.GetLogoUrl(result.TenantID, "sidebar"));
                _tenantState.SetTenantName(brandName);

                Navigation.NavigateTo("/Appointments");
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrWhiteSpace(err)
                    ? "Invalid tenant ID or credentials"
                    : err;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Connection error: " + ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await GetUserAsync();
        }
    }
    private void GoToRegister()
    {
        Navigation.NavigateTo("/edit-profile", forceLoad: true);
    }
    private string GetLogoWithFallback(string rawUrl)
    {
        if (string.IsNullOrEmpty(rawUrl) || 
            rawUrl == "/favicon.png" || 
            rawUrl == "favicon.png")
        {
            return "/images/rido-logo-pro.png";
        }
        return rawUrl;
    }
}