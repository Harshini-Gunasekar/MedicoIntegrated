                new FeatureDetail { Icon = "bi-clock-history", Header = "On-time Performance", Text = "Guaranteed swift handovers" }
            }
        },
        new SlideItem { 
            Badge = "RIDO ENTERPRISE WORKSPACE",
            Title = "Every Dispatch Matters", 
            Description = "AI-powered platform for smarter routing, real-time operations, and better clinical outcomes.",
            PosterUrl = "/images/slide_measuring.png",
            Features = new List<FeatureDetail>
            {
                new FeatureDetail { Icon = "bi-percent", Header = "99.8% On-time Rate", Text = "Industry leading accuracy" },
                new FeatureDetail { Icon = "bi-box-seam", Header = "2.5M+ Deliveries", Text = "Successfully completed" },
                new FeatureDetail { Icon = "bi-globe2", Header = "500+ Cities Covered", Text = "Active logistics network" }
            }
        },
        new SlideItem { 
            Badge = "RIDO ENTERPRISE WORKSPACE",
