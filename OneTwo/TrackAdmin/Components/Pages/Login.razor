    string txttenant = "";
    string txtuser = "";
    string txtpass = "";
    string api = "";

    bool showPassword = false;
    bool isLoading = false;
    bool isInitializing = true;
    bool rememberTenant = true;
    string errorMessage = "";

    bool isTenantAutoResolved = false;
    LoginDetailsModel lm = new();

    // Slider Data
    private int activeSlideIndex = 0;
    private System.Timers.Timer sliderTimer;
    private List<SlideItem> slides = new List<SlideItem>
    {
        new SlideItem { 
            Badge = "WELCOME TO RIDO",
