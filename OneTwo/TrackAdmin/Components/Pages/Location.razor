@page "/location"
@using Microsoft.AspNetCore.Authorization
@* @attribute [Authorize] *@
@rendermode InteractiveServer

@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage protectedSessionStore
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.DropDowns
@using System.Globalization
@using TrackAdmin.Data
@using TrackAdmin.Models
@using System.Text.Json

@inject NavigationManager Navigation
@inject HttpClient http
@inject SfDialogService dp

@inject RiderTracking riderTracking
@inject MasterData msd

<h3>Geolocation Example</h3>
<section class="row">
    <div class="col">
        <button type="button" @onclick="GetTrip">Get Trip</button> <br />
        <div id="distance" style="margin-top: 10px; font-weight: bold;"></div>
        @totaldistance
    </div>

    <div class="col">
        <div id="mapstart" style="width:100%;height:500px"></div>
    </div>
</section>

@if (error != null)
{
    <p style="color: red">@error</p>
}
else if (latitude != null && longitude != null)
{
    <p><b>Latitude:</b> @latitude</p>
    <p><b>Longitude:</b> @longitude</p>
}
else
{
    <p>Fetching location...</p>
}

