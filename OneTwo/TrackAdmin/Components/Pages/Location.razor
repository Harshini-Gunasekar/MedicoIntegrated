    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var loginState = await protectedSessionStore.GetAsync<bool>("IsLoggedIn");
            if (!loginState.Success || !loginState.Value)
            {
                Navigation.NavigateTo("/");
                return;
            }

            try
            {

                var position = await JS.InvokeAsync<GeolocationCoordinates>("getLocation");
                latitude = position.Latitude;
                longitude = position.Longitude;

                StateHasChanged();
            }
            catch (Exception ex)
            {
                error = $"Error: {ex.Message}";
                StateHasChanged();
            }
        }
    }

