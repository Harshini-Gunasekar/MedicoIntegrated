    string _accessToken = "YOUR_ACTUAL_SECRET_TOKEN";

    List<MapboxMatchingResponse> distres = new List<MapboxMatchingResponse>();

    public async Task<MapboxMatchingResponse> GetMatchedRouteAsync(List<(double longitude, double latitude)> coordinates, string profile = "driving")
    {
        var coordString = string.Join(";",
            coordinates.Select(c => $"{c.longitude},{c.latitude}"));

        var url = $"https://api.mapbox.com/matching/v5/mapbox/{profile}/{coordString}" +
                  $"?access_token={_accessToken}&geometries=geojson";

        var response = await http.GetFromJsonAsync<MapboxMatchingResponse>(url);

        return response;
    }

    public class MapboxMatchingResponse
    {
        public List<MapboxMatch> Matchings { get; set; }
        public List<MapboxTracepoint> Tracepoints { get; set; }

        public double GetTotalDistance()
        {
            return Matchings?.Sum(m => m.Distance) ?? 0;
        }
    }

    public class MapboxMatch
    {
        public double Distance { get; set; } // in meters
        public double Duration { get; set; } // in seconds
        public MapboxGeometry Geometry { get; set; }
    }

    public class MapboxGeometry
    {
        public string Type { get; set; }
        public List<List<double>> Coordinates { get; set; }
    }

    public class MapboxTracepoint
    {
        public int MatchingsIndex { get; set; }
        public int WaypointIndex { get; set; }
        public List<double> Location { get; set; }
