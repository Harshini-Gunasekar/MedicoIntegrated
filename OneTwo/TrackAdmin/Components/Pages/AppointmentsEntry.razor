    private async Task btnsave()
    {
        if (isSaving) return;

        try
        {
            isSaving = true;
            apts.RiderID = riderid > 0 ? riderid : null;
            apts.ReferralID = refid;
            apts.Deleted = false;
            apts.AssignedBy = session.UserID;

            if (!apts.IsNext)
            {
                apts.IsNext = false;
            }

            apts.Narration = apts.Narration ?? "";
            if (apts.EnteredDate == null)
            {
                apts.EnteredDate = msd.ConvertToDubaiTime(DateTime.UtcNow);
            }

            if (refid > 0)
            {
                HttpResponseMessage res;

                if (isedit == false)
                {
                    res = await http.PostAsJsonAsync("samplecollection/appointment", apts);
                }
                else
                {
                    res = await http.PostAsJsonAsync("samplecollection/updateappointment", apts);
                }

                var tt = await res.Content.ReadAsStringAsync();

                if (res.IsSuccessStatusCode)
                {
                    isvis = false;
                    await ClearFields();
                    await GetAppList(1);

                    await ShowCustomToast("Success", "Appointment booked successfully!", "success", "bi-check-circle-fill");
                }
                else
                {
                    var errorMsg = await res.Content.ReadAsStringAsync();
                    await dp.AlertAsync("Failed to save: " + errorMsg);
                }
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ShowCustomToast(string title, string message, string type = "success", string icon = "bi-check-circle-fill", string photoUrl = "")
    {
        toastTitle = title;
        toastMessage = message;
        toastType = type;
        toastIcon = icon;
        toastPhoto = photoUrl;
        isToastFading = false;
        showToast = true;
        await InvokeAsync(StateHasChanged);
        
        // Wait 2.5 seconds, then start fade-out animation (total 2.85s duration)
        await Task.Delay(2500);
        isToastFading = true;
        await InvokeAsync(StateHasChanged);
        
        // Wait 350ms for fade-out animation to complete
        await Task.Delay(350);
        showToast = false;
        isToastFading = false;
        toastPhoto = "";
        await InvokeAsync(StateHasChanged);
    }

