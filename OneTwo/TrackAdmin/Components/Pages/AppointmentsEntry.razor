@code {
    private string selectedAddress = "";

    private string GetNearestRiderDistance()
    {
        try
        {
            if (nearbyriders != null && nearbyriders.Count > 0)
            {
                var first = nearbyriders[0];
                if (first != null)
                {
                    double dist = 0;
                    if (first.distance != null)
                    {
                        if (double.TryParse(first.distance.ToString(), out dist))
                        {
                            return $"{dist:F1} km";
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error getting nearest rider distance: " + ex.Message);
        }
        return "--";
    }

    private string GetNearestRiderEta()
    {
        try
        {
            if (nearbyriders != null && nearbyriders.Count > 0)
            {
                var first = nearbyriders[0];
                if (first != null)
                {
                    double dist = 0;
                    if (first.distance != null)
                    {
                        if (double.TryParse(first.distance.ToString(), out dist))
                        {
                            double etaMinutes = dist * 3.3;
                            if (etaMinutes < 2 && dist > 0)
                            {
                                etaMinutes = 2;
                            }
                            return $"{(int)Math.Round(etaMinutes)} mins";
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error getting nearest rider ETA: " + ex.Message);
        }
        return "--";
    }

    private bool showToast = false;
    private bool isToastFading = false;
    private string toastTitle = "";
    private string toastMessage = "";
