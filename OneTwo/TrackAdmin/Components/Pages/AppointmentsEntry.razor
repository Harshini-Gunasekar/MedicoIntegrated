    private IEnumerable<Appointments> FilteredAppList => applist
        .Where(x => string.IsNullOrWhiteSpace(searchTerm) || 
                    (rm1.FirstOrDefault(r => r.ReferralID == x.ReferralID)?.ShortName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (rider.FirstOrDefault(r => r.RiderID == x.RiderID)?.ShortName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.Status?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.EscalationStatus?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    x.AppSno.ToString().Contains(searchTerm));

    private IList<Appointments> PaginatedList => FilteredAppList
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    private int TotalItems => FilteredAppList.Count();
    private int TotalPages => (int)Math.Ceiling(TotalItems / (double)pageSize);

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
            StateHasChanged();
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            StateHasChanged();
        }
    }

