    private async Task HandleTimelineDrop(int targetRiderId, DateTime targetSlot)
    {
        if (draggedAppId == null) return;

        var app = applist1.FirstOrDefault(a => a.Id == draggedAppId.Value);
        if (app == null) { draggedAppId = null; return; }

        // Update rider assignment and reschedule slot
        app.RiderID = targetRiderId;
        app.AppointmentOn = targetSlot;

        try
        {
            var res = await http.PostAsJsonAsync("samplecollection/updateappointment", app);
            if (res.IsSuccessStatusCode)
            {
                await ShowCustomToast("Rescheduled", $"Moved to {targetSlot:hh:mm tt}", "success", "bi-kanban-fill");
                await GetAppList(1);
            }
            else
            {
                await ShowCustomToast("Error", "Could not save the change.", "error", "bi-exclamation-triangle-fill");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Timeline drop error: " + ex.Message);
        }
        finally
        {
            draggedAppId = null;
            StateHasChanged();
        }
    }


