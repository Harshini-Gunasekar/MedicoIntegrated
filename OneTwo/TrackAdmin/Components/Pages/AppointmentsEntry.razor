    private async Task GetAppList(int id)
    {
        string sd = fdt.ToString("yyyy-MM-dd") + " 00:00:00";
        string ed = tdt.ToString("yyyy-MM-dd") + " 23:59:59";
        string url = "";

        if (id == 1)
        {
            url = $"sampleCollection/appdate?sd={Uri.EscapeUriString(sd)}&ed={Uri.EscapeUriString(ed)}&isupcoming={false}";
        }
        else if (id == 2)
        {
            url = $"sampleCollection/appdate?sd={Uri.EscapeUriString(sd)}&ed={Uri.EscapeUriString(ed)}&isupcoming={true}";
        }

        var res = await http.GetAsync(url);
        var tt = await res.Content.ReadAsStringAsync();
        applist1 = JsonConvert.DeserializeObject<IList<Appointments>>(tt);

        // Issues 1 & 2: Fetch yesterday's data to compute real deltas
        try
        {
            var yest = DateTime.Today.AddDays(-1);
            string ysd = yest.ToString("yyyy-MM-dd") + " 00:00:00";
            string yed = yest.ToString("yyyy-MM-dd") + " 23:59:59";
            var yRes = await http.GetAsync($"sampleCollection/appdate?sd={Uri.EscapeUriString(ysd)}&ed={Uri.EscapeUriString(yed)}&isupcoming={false}");
            if (yRes.IsSuccessStatusCode)
            {
                var yTt = await yRes.Content.ReadAsStringAsync();
                var yList = JsonConvert.DeserializeObject<IList<Appointments>>(yTt);
                yesterdayBookings = yList?.Count(x => x.Deleted == false) ?? 0;
                yesterdayCollected = yList?.Count(x => x.Deleted == false && (x.Status == "Collected" || x.Status == "Completed" || x.Status == "Sample Collected")) ?? 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error fetching yesterday data: " + ex.Message);
        }
        applist = applist1.Where(x => x.Deleted == false).ToList();
        applist = applist.OrderByDescending(x => x.AppSno).ToList();

        try
        {
            var resSC = await http.GetAsync($"SampleCollection/CollectionView?fd={Uri.EscapeUriString(sd)}&td={Uri.EscapeUriString(ed)}&rid=0");
            if (resSC.IsSuccessStatusCode)
            {
                var ttSC = await resSC.Content.ReadAsStringAsync();
                scmList = JsonConvert.DeserializeObject<IList<SampleCollection_Master>>(ttSC) ?? new List<SampleCollection_Master>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading sample collections: " + ex.Message);
        }

        // Fetch payment collection requests and compute financial totals
        try
        {
            var resPay = await http.GetAsync("PaymentCollection/admin/list");
            if (resPay.IsSuccessStatusCode)
            {
                var jsonPay = await resPay.Content.ReadAsStringAsync();
                paymentRequestsList = JsonConvert.DeserializeObject<List<PaymentCollectionRequest>>(jsonPay) ?? new();
            }

            // Filter by the selected date range
            var rangeRequests = paymentRequestsList
                .Where(x => x.EnteredDate.Date >= fdt.Date && x.EnteredDate.Date <= tdt.Date);

            // Collected = sample collection amounts + completed payment collection amounts
            decimal sampleCollected = (decimal)scmList.Sum(x => x.Amount);
            decimal payCollected = rangeRequests
                .Where(x => x.RequestType == "PaymentCollection" && x.Status == "Completed")
                .Sum(x => x.CollectedAmount ?? 0);
            totalCollectedAmount = sampleCollected + payCollected;

            // Recovery = settled rider deficits (cash recovered from riders for discrepancies)
            totalRecoveredAmount = rangeRequests
                .Where(x => x.Status == "Completed" && x.ResolutionType == "RiderAccountable"
                         && x.IsDeficitSettled == true && x.DiscrepancyAmount.HasValue)
                .Sum(x => Math.Abs(x.DiscrepancyAmount!.Value));
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading payment collections: " + ex.Message);
        }

        if (applist.Count > 0)
        {
            // Improved RID generation: distinct, non-zero IDs only
            var distinctIds = applist
                .Where(x => x.ReferralID.HasValue && x.ReferralID > 0)
                .Select(x => x.ReferralID.Value)
                .Distinct()
                .ToList();

            if (distinctIds.Any())
            {
                string rid = string.Join(",", distinctIds);
                var res1 = await http.GetAsync($"referral/referralid?rname={Uri.EscapeUriString(rid)}");
                var tt1 = await res1.Content.ReadAsStringAsync();
                rm1 = JsonConvert.DeserializeObject<IList<Referral_Master>>(tt1);
            }
        }

        await InvokeAsync(StateHasChanged);
        UpdateHeader();
    }

