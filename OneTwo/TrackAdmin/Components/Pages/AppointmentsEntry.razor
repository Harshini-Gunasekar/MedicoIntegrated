    private System.Timers.Timer? pollingTimer;

    /// <summary>
    /// Polling bridge for Issues 4 & 5: fetches latest list every 30s,
    /// diffs against previous snapshot to detect status transitions,
    /// then fires toasts + bell panel entries ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â no API hub broadcasts needed.
    /// </summary>
    private async Task PollAndDiffAppointments()
    {
        try
        {
            // Snapshot old statuses before refresh
            var oldStatuses = applist1
                .Where(x => x.Deleted == false)
                .ToDictionary(x => x.AppSno, x => x.Status ?? "");

            // Silently refresh
            await InvokeAsync(async () => await GetAppList(1));

            // Diff new statuses
            foreach (var app in applist1.Where(x => x.Deleted == false))
            {
                var appSno = app.AppSno;
                var newStatus = app.Status ?? "";

                if (!oldStatuses.TryGetValue(appSno, out var oldStatus))
                    continue; // brand-new booking ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â skip (already in list after refresh)

                if (oldStatus == newStatus) continue; // no change

                // Resolve rider name + photo for this appointment
                var riderObj = rider.FirstOrDefault(r => r.RiderID == app.RiderID);
                var riderName = riderObj?.Name ?? riderObj?.ShortName ?? "Rider";
                var riderPhoto = app.RiderID.HasValue
                    ? $"{ApiConfig.Value.BaseApiUrl}User/GetImage?imageType=profile-pics&riderId={app.RiderID}"
                    : "";

                // Resolve client/referral name
                var refObj = rm1.FirstOrDefault(r => r.ReferralID == app.ReferralID);
                var clientName = refObj?.ShortName ?? refObj?.Name ?? "Client";

                await InvokeAsync(async () =>
                {
                    // New ÃƒÂ¢Ã¢â‚¬Â Ã¢â‚¬â„¢ Accepted/Assigned: Rider accepted the booking
                    if ((oldStatus == "New" || oldStatus == "Pending") &&
                        (newStatus == "Accepted" || newStatus == "Assigned"))
                    {
                        var msg = $"Rider {riderName} accepted Booking #{appSno} for {clientName}";
                        AddNotif("✅ Rider Accepted", msg, "accepted", "bi-person-check-fill", riderPhoto);
                        await ShowCustomToast("✅ Rider Accepted", $"Rider {riderName} accepted Booking #{appSno}", "success", "bi-person-check-fill", riderPhoto);
                    }
                    // Accepted ÃƒÂ¢Ã¢â‚¬Â Ã¢â‚¬â„¢ Collected: Sample collected
                    else if ((oldStatus == "Accepted" || oldStatus == "Assigned" || oldStatus == "On Route" || oldStatus == "Started" || oldStatus == "EnRoute") &&
                             (newStatus == "Collected" || newStatus == "Sample Collected"))
                    {
                        var msg = $"Rider {riderName} collected sample for Booking #{appSno} ({clientName})";
                        AddNotif("🧪 Sample Collected", msg, "collected", "bi-prescription2", riderPhoto);
                        await ShowCustomToast("🧪 Sample Collected", $"Rider {riderName} collected sample for Booking #{appSno}", "info", "bi-prescription2", riderPhoto);
                    }
                    // Collected ÃƒÂ¢Ã¢â‚¬Â Ã¢â‚¬â„¢ Completed/Delivered: Referral/Lab confirmed
                    else if ((oldStatus == "Collected" || oldStatus == "Sample Collected") &&
                             (newStatus == "Completed" || newStatus == "Delivered" || newStatus == "Finished"))
                    {
                        var msg = $"Booking #{appSno} for {clientName} marked as Completed";
                        AddNotif("🏁ÃƒÂ¯Ã‚Â¸Ã‚Â Referral Confirmed", msg, "referral", "bi-patch-check-fill");
                        await ShowCustomToast("🏁ÃƒÂ¯Ã‚Â¸Ã‚Â Completed", $"Booking #{appSno} for {clientName} is completed", "success", "bi-check-circle-fill");
                    }

                    await InvokeAsync(StateHasChanged);
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Polling diff error: {ex.Message}");
        }
    }

    private async Task CheckOverdueAppointments()
    {
        if (globalSnoozeUntil.HasValue && DateTime.Now < globalSnoozeUntil.Value) return;
        if (applist1 == null || applist1.Count == 0) return;

        try
        {
            var now = msd.ConvertToDubaiTime(DateTime.UtcNow);

            // Find first un-snoozed, un-ignored overdue booking (either >5m unaccepted, or >15m uncollected)
            var breachApp = applist1.FirstOrDefault(x => 
                IsOverdue(x) && 
                !ignoredAlertIds.Contains(x.AppSno) && 
                (!snoozedAlerts.ContainsKey(x.AppSno) || DateTime.Now >= snoozedAlerts[x.AppSno])
            );

            if (breachApp != null && activeSlaBreachApp == null && !showEscalationPopup)
            {
                activeSlaBreachApp = breachApp;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception) { }
    }

