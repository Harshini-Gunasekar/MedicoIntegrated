    private void AddNotif(string title, string sub, string type, string icon, string photoUrl = "")
    {
        NotifStore.Add(title, sub, type, icon, photoUrl);
    }

    private bool isPaymentDetailsVis = false;
    private PaymentCollectionRequest? selectedPaymentForDetails;

    private async Task HandleNotifClick(NotifEntry n)
    {
        showNotifPanel = false;
        
        // Find if it's an appointment (Booking) or payment collection request by searching for #ID in Sub or Title
        int hashIdx = n.Sub.IndexOf('#');
        if (hashIdx == -1) hashIdx = n.Title.IndexOf('#');
        
        if (hashIdx != -1)
        {
            int len = 0;
            while (hashIdx + 1 + len < n.Sub.Length && char.IsDigit(n.Sub[hashIdx + 1 + len]))
            {
                len++;
            }
            string numStr = "";
            if (len > 0)
            {
                numStr = n.Sub.Substring(hashIdx + 1, len);
            }
            else
            {
                hashIdx = n.Title.IndexOf('#');
                len = 0;
                while (hashIdx + 1 + len < n.Title.Length && char.IsDigit(n.Title[hashIdx + 1 + len]))
                {
                    len++;
                }
                if (len > 0)
                {
                    numStr = n.Title.Substring(hashIdx + 1, len);
                }
            }
            
            if (int.TryParse(numStr, out int parsedId))
            {
                bool isAppointment = n.Title.Contains("Booking", StringComparison.OrdinalIgnoreCase) || 
                                     n.Sub.Contains("Booking", StringComparison.OrdinalIgnoreCase) ||
                                     n.Title.Contains("Appointment", StringComparison.OrdinalIgnoreCase) ||
                                     n.Sub.Contains("Appointment", StringComparison.OrdinalIgnoreCase) ||
                                     n.Title.Contains("Escalation", StringComparison.OrdinalIgnoreCase) ||
                                     n.Sub.Contains("Escalation", StringComparison.OrdinalIgnoreCase);
                                     
                if (isAppointment)
                {
                    searchTerm = parsedId.ToString();
                    await EditAppointByAppSno(parsedId);
                }
                else
                {
                    await OpenPaymentDetailsDialog(parsedId);
                }
            }
        }
    }

    private async Task OpenPaymentDetailsDialog(int requestId)
    {
        try
        {
            var res = await http.GetAsync($"{ApiConfig.Value.BaseApiUrl}PaymentCollection/track?requestId={requestId}");
            if (res.IsSuccessStatusCode)
            {
                var json = await res.Content.ReadAsStringAsync();
                selectedPaymentForDetails = JsonConvert.DeserializeObject<PaymentCollectionRequest>(json);
                if (selectedPaymentForDetails != null)
                {
                    isPaymentDetailsVis = true;
                    StateHasChanged();
                }
                else
                {
                    await dp.AlertAsync("Failed to parse payment details.");
                }
            }
            else
            {
                await dp.AlertAsync($"Failed to fetch payment details: {res.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            await dp.AlertAsync($"Error fetching payment details: {ex.Message}");
        }
    }
    
    private void ClosePaymentDetailsDialog()
    {
        isPaymentDetailsVis = false;
        selectedPaymentForDetails = null;
    }

