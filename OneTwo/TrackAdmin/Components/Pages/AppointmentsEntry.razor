        }
    }

    private string GetClientInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        
        var cleanName = name;
        if (cleanName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase))
        {
            cleanName = cleanName.Substring(3).Trim();
        }

        var parts = cleanName.Split(new[] { ' ', '.', ',' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "U";
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();
    }

    private static readonly string[] PastelColors = new[]
    {
        "#6366f1", "#8b5cf6", "#ec4899", "#f43f5e", "#10b981", "#06b6d4", "#f59e0b", "#3b82f6"
    };

    private string GetRandomPastelColor(int id)
    {
        int index = Math.Abs(id.GetHashCode()) % PastelColors.Length;
        return PastelColors[index];
    }

    private string GetStatusClass(string? status)
    {
        if (string.IsNullOrEmpty(status)) return "pending";
        return status.ToLower() switch
        {
            "new" or "pending" => "pending",
            "accepted" or "assigned" => "accepted",
            "on route" or "started" or "enroute" => "onroute",
            "collected" or "sample collected" => "collected",
            "completed" or "delivered" or "finished" => "delivered",
            "rejected" or "cancelled" => "rejected",
            _ => "pending"
        };
    }

    public class ActivityLog
    {
        public string Title { get; set; } = "";
        public string Time { get; set; } = "";
        public string DotColor { get; set; } = "";
        public string Icon { get; set; } = "";
    }

    private List<ActivityLog> GetRecentActivities()
    {
        var list = new List<ActivityLog>();
        var recentApps = applist1.OrderByDescending(x => x.EnteredDate).Take(5).ToList();
        foreach (var app in recentApps)
        {
            var client = rm1.FirstOrDefault(c => c.ReferralID == app.ReferralID)?.ShortName ?? "Client";
            var riderObj = rider.FirstOrDefault(r => r.RiderID == app.RiderID);
            if (app.Status == "New" || app.Status == "Pending")
            {
                list.Add(new ActivityLog {
                    Title = $"Booking #{app.AppSno} created for {client}",
                    Time = app.EnteredDate?.ToString("hh:mm tt") ?? "Just now",
                    DotColor = "warning",
                    Icon = "bi-plus-circle"
                });
            }
            else if (app.Status == "Accepted")
            {
                list.Add(new ActivityLog {
                    Title = $"Rider {riderObj?.ShortName ?? "Rider"} assigned to #{app.AppSno}",
                    Time = app.EnteredDate?.AddMinutes(10).ToString("hh:mm tt") ?? "10 min ago",
                    DotColor = "primary",
                    Icon = "bi-person-check"
                });
            }
            else if (app.Status == "Collected")
            {
                list.Add(new ActivityLog {
                    Title = $"Samples collected from {client} for #{app.AppSno}",
                    Time = app.EnteredDate?.AddMinutes(25).ToString("hh:mm tt") ?? "25 min ago",
                    DotColor = "success",
                    Icon = "bi-check2-circle"
                });
            }
            else if (app.Status == "Completed")
            {
                list.Add(new ActivityLog {
                    Title = $"Samples delivered to lab for #{app.AppSno}",
                    Time = app.EnteredDate?.AddMinutes(45).ToString("hh:mm tt") ?? "45 min ago",
                    DotColor = "success",
                    Icon = "bi-building"
                });
            }
        }
        if (list.Count == 0)
        {
            list.Add(new ActivityLog { Title = "No recent system logs", Time = "Today", DotColor = "primary", Icon = "bi-info-circle" });
        }
        return list;
    }
