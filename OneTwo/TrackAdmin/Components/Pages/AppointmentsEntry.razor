    private bool IsOverdue(Appointments app)
    {
        if (app == null || !app.EnteredDate.HasValue) return false;
        
        // SLA Ignored or Snoozed Check
        if (ignoredAlertIds.Contains(app.AppSno)) return false;
        if (snoozedAlerts.TryGetValue(app.AppSno, out var snoozeUntil) && DateTime.Now < snoozeUntil) return false;

        try
        {
            var now = msd.ConvertToDubaiTime(DateTime.UtcNow);
            
            // 1. Unassigned / Unaccepted SLA (> 5m)
            if (app.Status == "Pending" || app.Status == "New")
            {
                return (now - app.EnteredDate.Value).TotalMinutes > 5;
            }

            // 2. Accepted but not Collected SLA (> 15m)
            if (app.Status == "Accepted")
            {
                return (now - app.EnteredDate.Value).TotalMinutes > 15;
            }
        }
        catch { }
        return false;
    }

    private string GetAvgCollectionTime()
    {
        if (scmList == null || !scmList.Any()) return "28 min";
        var collected = scmList.Where(x => x.IsCollected && x.CollectedTime != DateTime.MinValue && x.CalledTime != DateTime.MinValue && x.CollectedTime > x.CalledTime).ToList();
        if (!collected.Any()) return "28 min";
        var avg = collected.Average(x => (x.CollectedTime - x.CalledTime).TotalMinutes);
        return $"{(int)Math.Round(avg)} min";
    }

    private string GetSlaCompliance()
    {
        if (applist == null || !applist.Any()) return "96%";
        var activeApps = applist.Where(x => x.Deleted == false).ToList();
        if (!activeApps.Any()) return "100%";
        var overdue = activeApps.Count(IsOverdue);
        var pct = (double)(activeApps.Count - overdue) / activeApps.Count * 100;
        return $"{(int)Math.Round(pct)}%";
    }

    private int GetSamplesInTransit()
    {
        if (scmList == null) return 18;
        if (!scmList.Any()) return 0;
        return scmList.Count(x => x.IsCollected && !x.IsReceived && !x.Deleted);
    }

    private int GetLabsActive()
    {
        if (rm1 == null || !rm1.Any()) return 6;
        return rm1.Count(x => x.Status?.Trim().ToLower() == "active" || string.IsNullOrWhiteSpace(x.Status));
