    private Dictionary<int, string> riderImageCache = new();

    private string GetRiderProfileImage(int riderId)
    {
        if (riderImageCache.TryGetValue(riderId, out var cachedImg))
        {
            return cachedImg;
        }

        // Return placeholder but trigger async fetch
        riderImageCache[riderId] = "/images/default-avatar.png";
        _ = Task.Run(async () =>
        {
            try
            {
                var request = new HttpRequestMessage(HttpMethod.Get, $"User/GetImage?imageType=profile-pics&riderId={riderId}");
                request.Headers.Add("TenantId", _tenantState.TenantID ?? "");
                var response = await http.SendAsync(request);
                if (response.IsSuccessStatusCode)
                {
                    var bytes = await response.Content.ReadAsByteArrayAsync();
                    var b64 = $"data:{response.Content.Headers.ContentType};base64,{Convert.ToBase64String(bytes)}";
                    riderImageCache[riderId] = b64;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { }
        });

        return "/images/default-avatar.png";
    }

    private int GetEscalationLevel(Appointments app)
    {
        if (app == null) return 0;

        // PRIORITIZE the database-defined escalation level if it's already set to a valid level (> 0)
        if (app.EscalationLevel.HasValue && app.EscalationLevel.Value > 0)
        {
            return app.EscalationLevel.Value;
        }

        if (app.Status != "Pending" && app.Status != "New") return 0;
        if (!app.EnteredDate.HasValue) return 0;

        try
        {
            var now = msd.ConvertToDubaiTime(DateTime.UtcNow);
            double minutes = (now - app.EnteredDate.Value).TotalMinutes;

            if (minutes > 10) return 2; // L2 Escalation (Manager Alert)
            if (minutes > 5) return 1;  // L1 Escalation (Admin Alert)
        }
        catch { }

        return 0;
    }

    private int CompletedCount => applist1.Count(x => x.Status == "Completed" || x.Status == "Collected" || x.Status == "Finished");
    private int PendingCount => applist1.Count(x => x.Status == "Pending" || x.Status == "New" || x.Status == "Accepted");
    private int CancelledCount => applist1.Count(x => x.Status == "Cancelled" || x.Status == "Rejected");

    private double TotalAppointmentsForDonut => CompletedCount + PendingCount + CancelledCount;

    private string CompletedStrokeDash
    {
        get
        {
            double total = TotalAppointmentsForDonut;
            if (total == 0) return "0 175.929";
            double val = CompletedCount * 175.929 / total;
            return $"{val:F1} 175.929";
        }
    }

