    private async Task LoadSnoozeStateAsync()
    {
        try
        {
            var globalSnoozeStr = await JS.InvokeAsync<string>("localStorage.getItem", "rido_apt_global_snooze_until");
            if (!string.IsNullOrEmpty(globalSnoozeStr) && DateTime.TryParse(globalSnoozeStr, null, System.Globalization.DateTimeStyles.RoundtripKind, out var globalSnooze))
            {
                globalSnoozeUntil = globalSnooze;
            }

            var snoozedAlertsStr = await JS.InvokeAsync<string>("localStorage.getItem", "rido_apt_snoozed_alerts");
            if (!string.IsNullOrEmpty(snoozedAlertsStr))
            {
                snoozedAlerts = JsonConvert.DeserializeObject<Dictionary<int, DateTime>>(snoozedAlertsStr) ?? new();
            }

            var ignoredAlertIdsStr = await JS.InvokeAsync<string>("localStorage.getItem", "rido_apt_ignored_alert_ids");
            if (!string.IsNullOrEmpty(ignoredAlertIdsStr))
            {
                ignoredAlertIds = JsonConvert.DeserializeObject<HashSet<int>>(ignoredAlertIdsStr) ?? new();
            }
        }
        catch (Exception) { }
    }

    private async Task SaveSnoozeStateAsync()
    {
        try
        {
            if (globalSnoozeUntil.HasValue)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "rido_apt_global_snooze_until", globalSnoozeUntil.Value.ToString("o"));
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", "rido_apt_global_snooze_until");
            }

            await JS.InvokeVoidAsync("localStorage.setItem", "rido_apt_snoozed_alerts", JsonConvert.SerializeObject(snoozedAlerts));
            await JS.InvokeVoidAsync("localStorage.setItem", "rido_apt_ignored_alert_ids", JsonConvert.SerializeObject(ignoredAlertIds));
        }
        catch (Exception) { }
    }

