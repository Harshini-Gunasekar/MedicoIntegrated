    private async Task ToggleClientHeatmap()
    {
        showClientHeatmap = !showClientHeatmap;
        if (showClientHeatmap)
        {
            var heatmapPoints = refm.Select(r => {
                int weight = pendingAppointments.Count(a => a.ReferralID == r.ReferralID);
                return new {
                    lat = r.Latitude,
                    lng = r.Longitude,
                    weight = weight > 0 ? weight : 1
                };
            }).Where(p => p.lat != 0 && p.lng != 0).ToList();

            await JS.InvokeVoidAsync("toggleClientHeatmap", true, heatmapPoints);
        }
        else
        {
            await JS.InvokeVoidAsync("toggleClientHeatmap", false, new object[] {});
        }
    }

    private async Task StartRoutePlayback(RiderLocation rider)
    {
        try
        {
            int riderId = int.Parse(rider.RiderId);
            string sd = DateTime.Today.ToString("yyyy-MM-dd 00:00:00");
            string ed = DateTime.Today.ToString("yyyy-MM-dd 23:59:59");

            var request = new HttpRequestMessage(HttpMethod.Get, $"LiveTracker/RiderRoute?id={riderId}&sd={Uri.EscapeDataString(sd)}&ed={Uri.EscapeDataString(ed)}");
            request.Headers.Add("TenantId", _tenantState.TenantID);
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                var rawRoute = JsonConvert.DeserializeObject<IList<RiderStatus>>(content) ?? new List<RiderStatus>();

                var routePoints = rawRoute
                    .Select(r => {
                        double lat = 0;
                        double lng = 0;
                        double.TryParse(r.latitude, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out lat);
                        double.TryParse(r.longitude, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out lng);
                        return new { lat, lng, time = r.StartTime };
                    })
                    .Where(p => p.lat != 0 && p.lng != 0)
                    .OrderBy(p => p.time)
                    .ToList();

                if (routePoints.Count == 0)
                {
                    await JS.InvokeVoidAsync("alert", $"No GPS route data available for {rider.RiderName} today.");
                    return;
                }

                await JS.InvokeVoidAsync("startRoutePlayback", rider.RiderId, rider.RiderName, routePoints);
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Failed to retrieve route playback data.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Playback error: " + ex.Message);
        }
    }

