    private void HandleStateChange()
    {
        if (_tenantState.ChatOpenRiderId != null)
        {
            var riderIdStr = _tenantState.ChatOpenRiderId;
            var riderName = _tenantState.ChatOpenRiderName ?? "Rider";
            
            var rider = Locations.FirstOrDefault(l => l.RiderId == riderIdStr);
            if (rider == null)
            {
                rider = new RiderLocation
                {
                    RiderId = riderIdStr,
                    RiderName = riderName,
                    FullName = riderName
                };
            }
            
            selectedRiderForChat = rider;
            _tenantState.ClearOpenChatRequest();
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _tenantState.OnStateChange -= HandleStateChange;
        _cts.Cancel();
        _timer?.Dispose();
        _clockTimer?.Dispose();
        _objRef?.Dispose();
    }
