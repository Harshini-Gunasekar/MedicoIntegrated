    private void OpenChat(RiderLocation rider)
    {
        selectedRiderForChat = rider;
        _ = MarkAsRead(rider);
    }

    private void CloseChat() => selectedRiderForChat = null;

    private async Task MarkAsRead(RiderLocation rider)
    {
        if (rider.UnreadCount <= 0) return;
        try {
            var payload = new { senderId = int.Parse(rider.RiderId), recipientId = session.UserID };
            var request = new HttpRequestMessage(HttpMethod.Post, "Chat/mark-read");
            request.Headers.Add("TenantId", _tenantState.TenantID);
            request.Content = JsonContent.Create(payload);
            await Http.SendAsync(request);
            
            rider.UnreadCount = 0;
            unreadCounts[int.Parse(rider.RiderId)] = 0;
            await InvokeAsync(StateHasChanged);
        } catch { }
    }

