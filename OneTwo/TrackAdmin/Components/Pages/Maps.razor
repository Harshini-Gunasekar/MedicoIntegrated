    [JSInvokable]
    public async Task ToggleRiderStatus(string riderId, string currentStatus)
    {
        try
        {
            var rider = locations.FirstOrDefault(x => x.RiderID.ToString() == riderId);
            if (rider == null) return;

            string newStatus = (currentStatus.ToLower() == "available" || currentStatus.ToLower() == "active") ? "Offline" : "Available";

            LoadLocation ls = new LoadLocation {
                rcl = new Rider_Current_Location { RiderID = rider.RiderID, Vehicle = rider.Vehicle ?? "Bike", Latitude = rider.Latitude, Longitude = rider.Longitude, Status = newStatus, EnteredDate = DateTime.Now },
                rs = new RiderStatus { ID = Guid.NewGuid(), Session = "Admin Override", latitude = rider.Latitude.ToString(), longitude = rider.Longitude.ToString(), StartTime = DateTime.Now, EndTime = DateTime.Now, RiderID = rider.RiderID }
            };

            var request = new HttpRequestMessage(HttpMethod.Post, "LiveTracker/updatestatus");
            request.Headers.Add("TenantId", _tenantState.TenantID);
            request.Content = JsonContent.Create(ls);
            var res = await Http.SendAsync(request);
            if (res.IsSuccessStatusCode) {
                var loc = Locations.FirstOrDefault(x => x.RiderId == riderId);
                if (loc != null) loc.Status = newStatus;
                await RefreshLoop();
            }
        }
        catch { }
    }

