    private async Task LoadPendingAppointmentsAsync()
    {
        try {
            DateTime dt = DateTime.Now;
            string sd = dt.ToString("yyyy-MM-dd") + " 00:00:00";
            string ed = dt.ToString("yyyy-MM-dd") + " 23:59:59";
            
            var request = new HttpRequestMessage(HttpMethod.Get, $"SampleCollection/appdate?sd={Uri.EscapeUriString(sd)}&ed={Uri.EscapeUriString(ed)}&isupcoming={false}");
            request.Headers.Add("TenantId", _tenantState.TenantID);
            var res = await Http.SendAsync(request);
            if (res.IsSuccessStatusCode)
            {
                var rr = await res.Content.ReadAsStringAsync();
                var apps = JsonConvert.DeserializeObject<IList<Appointments>>(rr);
                if (apps != null)
                {
                    pendingAppointments = apps.Where(x => (x.Status == "Pending" || x.Status == "New" || x.Status == "Accepted") && x.Deleted != true).ToList();
                    escalatedApps = apps.Where(x => x.EscalationLevel > 0 && 
                                                    (string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase) || string.Equals(x.Status, "New", StringComparison.OrdinalIgnoreCase)) && 
                                                    x.Deleted != true).ToList();
                    pendingAppsCount = nextride.Count + pendingAppointments.Count;
                }
            }
        } catch { }
    }

