    private void ComputePulseStrip()
    {
        // Compute live status counts based on real-time CurrentStatus with defensive trimming to avoid fixed-length char padding issues
        liveOnline = allRiders.Count(r => {
            var status = (r.CurrentStatus ?? "").Trim().ToLower();
            return status == "available" || status == "active" || status == "online";
        });
        liveOffline = allRiders.Count(r => {
            var status = (r.CurrentStatus ?? "").Trim().ToLower();
            return status == "offline" || status == "loggedout" || string.IsNullOrEmpty(status);
        });
        liveOnHold = allRiders.Count(r => {
            var status = (r.CurrentStatus ?? "").Trim().ToLower();
            return status == "on-hold" || status == "on hold" || status == "busy" || status == "engaged";
        });
        livePermission = allRiders.Count(r => {
            var status = (r.CurrentStatus ?? "").Trim().ToLower();
            return status == "permission";
        });
        liveActiveCollections = paymentRequests.Count(x => {
            var status = (x.Status ?? "").Trim().ToLower();
            return status == "inprogress" || status == "pending" || status == "new";
        });
        lastPulseRefresh = DateTime.Now.ToString("hh:mm tt");
    }

    private void ComputeAIInsights()
    {
        aiInsights.Clear();
        var sevenDaysAgo = DateTime.Today.AddDays(-7);
        var week = paymentRequests.Where(x => x.EnteredDate.Date >= sevenDaysAgo).ToList();
        var weekApps = pendingAppointments.Concat(escalatedApps).ToList();

        // 1. High-Deficit Rider
        var highDeficitRider = week
            .Where(x => x.RiderID.HasValue && x.ResolutionType == "RiderAccountable" && x.IsDeficitSettled != true && x.DiscrepancyAmount.HasValue)
            .GroupBy(x => x.RiderID.Value)
            .Select(g => new { RiderID = g.Key, Name = g.FirstOrDefault()?.RiderName ?? $"Rider #{g.Key}", Total = g.Sum(x => Math.Abs(x.DiscrepancyAmount.Value)) })
            .OrderByDescending(x => x.Total)
            .FirstOrDefault();
        if (highDeficitRider != null && highDeficitRider.Total > 0)
            aiInsights.Add(new InsightCard { Icon = "bi-exclamation-triangle-fill", Color = "danger", Title = "High Outstanding Deficit", Description = $"{highDeficitRider.Name} has ₹{highDeficitRider.Total:N0} in unresolved deficits this week.", ActionUrl = "/PaymentCollection", ActionLabel = "Review" });

        // 2. Unassigned Appointments
        var unassigned = pendingAppointments.Count(a => !a.RiderID.HasValue && (a.Status == "New" || a.Status == "Pending"));
        if (unassigned > 0)
            aiInsights.Add(new InsightCard { Icon = "bi-person-x-fill", Color = "warning", Title = $"{unassigned} Appointments Unassigned", Description = $"{unassigned} pending appointment{(unassigned > 1 ? "s" : "")} have no rider assigned — assign now.", ActionUrl = "/appointments", ActionLabel = "Assign" });

        // 3. SLA Score
        int totalToday = pendingAppointments.Count + escalatedApps.Count;
        if (totalToday > 0)
        {
            int slaScore = (int)Math.Round((double)(totalToday - escalatedApps.Count) * 100.0 / totalToday);
            string slaColor = slaScore >= 90 ? "success" : slaScore >= 70 ? "warning" : "danger";
            string slaIcon = slaScore >= 90 ? "bi-shield-check-fill" : "bi-shield-exclamation";
            aiInsights.Add(new InsightCard { Icon = slaIcon, Color = slaColor, Title = $"Today's SLA Score: {slaScore}%", Description = slaScore >= 90 ? "Excellent! Service levels are well within targets." : $"{escalatedApps.Count} escalated appointment{(escalatedApps.Count > 1 ? "s" : "")} are impacting SLA.", ActionUrl = escalatedApps.Count > 0 ? "/appointments" : null, ActionLabel = "View Escalations" });
        }

        // 4. Zero-Activity Clients
        var busyReferralIds = pendingAppointments.Where(a => a.ReferralID.HasValue).Select(a => a.ReferralID.Value).Distinct().ToHashSet();
        var quietClients = refm.Where(r => !busyReferralIds.Contains(r.ReferralID)).Take(3).ToList();
        if (quietClients.Count > 0)
            aiInsights.Add(new InsightCard { Icon = "bi-building-x", Color = "info", Title = $"{quietClients.Count} Client{(quietClients.Count > 1 ? "s" : "")} With No Activity Today", Description = $"{string.Join(", ", quietClients.Select(r => r.Name ?? "Unknown").Take(2))}{(quietClients.Count > 2 ? " & more" : "")} had 0 pickups today.", ActionUrl = "/appointments", ActionLabel = "Check In" });

        // 5. Collection Rate
        int totalCollections = week.Count;
        int completedWk = week.Count(x => x.Status == "Completed");
        if (totalCollections > 5)
        {
            int rate = (int)Math.Round((double)completedWk * 100.0 / totalCollections);
            if (rate < 80)
                aiInsights.Add(new InsightCard { Icon = "bi-cash-stack", Color = "warning", Title = $"7-Day Collection Rate: {rate}%", Description = $"{totalCollections - completedWk} payment requests are still unresolved this week. Consider follow-up.", ActionUrl = "/PaymentCollection", ActionLabel = "Resolve" });
        }
    }

