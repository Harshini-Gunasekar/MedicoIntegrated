@page "/Home"
@using Microsoft.AspNetCore.Authorization
@* @attribute [Authorize] *@

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using TrackAdmin.Models
@using TrackAdmin.Data
@using Newtonsoft.Json
@inject IJSRuntime JS
@inject HttpClient Http
@inject MasterData msd
@using Microsoft.Extensions.Options
@inject IOptions<APIConfiguration> ApiConfig
@inject UserSessionService session
@inject TenantState _tenantState
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage protectedSessionStore
@inject PageMetadataService Metadata
@implements IDisposable

@if (!pageReady)
{
    <div class="premium-loader-container">
        <div class="tactical-loader-orb">
            <i class="bi bi-grid-1x2 pulse"></i>
            <div class="loader-glow"></div>
        </div>
        <div class="loader-text-wrap">
            <h4>RIDO LOGISTICS</h4>
            <span>Aggregating Control Tower Analytics...</span>
        </div>
    </div>
}
else
{
    <!-- Welcome Popup Modal -->
    @if (showWelcomeCard)
    {
        <div class="welcome-modal-overlay" @onclick="DismissWelcome">
            <div class="welcome-modal-card" @onclick:stopPropagation="true">
                <div class="wc-avatar-wrap">
                    <div class="wc-avatar-ring">
                        <img src="/images/welcome_avatar.png" class="wc-avatar-img" alt="Welcome Avatar" />
                    </div>
                    <div class="wc-wave-hand">👋</div>
                </div>
                <div class="wc-greeting-text">
                    <h3>Hi there! <span class="wc-hi-anim">😊</span></h3>
                    <p class="wc-user-name">Welcome back, <strong>@(session?.UserName ?? "User")</strong>!</p>
                    <p class="wc-msg">Your logistics control tower is ready.<br/>Let's check what's happening today.</p>
                </div>
                <div class="wc-stats-mini">
                    <div class="wc-stat">
                        <span class="wc-stat-val">@pendingAppointments.Count</span>
                        <span class="wc-stat-lbl">Pending Tasks</span>
                    </div>
                    <div class="wc-stat">
                        <span class="wc-stat-val">@nextride.Count</span>
                        <span class="wc-stat-lbl">Trips Today</span>
                    </div>
                    <div class="wc-stat">
                        <span class="wc-stat-val">@escalatedApps.Count</span>
                        <span class="wc-stat-lbl">Alerts</span>
                    </div>
                </div>
                <button class="wc-dismiss-btn" @onclick="DismissWelcome">
                    <i class="bi bi-arrow-right-circle-fill me-2"></i>Let's Go!
                </button>
                <div class="wc-auto-close">Auto-closes in a few seconds...</div>
            </div>
        </div>
    }

    <div class="control-tower-container animate-fade-in">
        
        <!-- Header Section -->
        <header class="tower-header mb-4">
            <div class="header-main-info">
                <div class="tower-logo-wrap">
                    <i class="bi bi-shield-shaded"></i>
                </div>
                <div>
                    <h2 class="tower-title">Logistics Control Tower</h2>
                </div>
            </div>
            <div class="header-actions">
                <div class="clock-display me-3">
                    <i class="bi bi-clock me-1 text-primary"></i> @currentTime
                </div>
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 py-2 font-bold" @onclick="RefreshDashboardData">
                    <i class="bi bi-arrow-clockwise me-1"></i> REFRESH DATA
                </button>
            </div>
        </header>

        <!-- ══════════ LIVE PULSE STRIP ══════════ -->
        <section class="live-pulse-strip mb-4">
            <div class="lps-inner">
                <!-- Live dot indicator -->
                <div class="lps-live-badge">
                    <span class="lps-live-dot"></span>
                    <span class="lps-live-text">LIVE</span>
                </div>

                <div class="lps-divider"></div>

                <!-- Online -->
                <div class="lps-pill green">
                    <div class="lps-pill-orb"></div>
                    <span class="lps-pill-count">@liveOnline</span>
                    <span class="lps-pill-label">Online</span>
                </div>

                <!-- Offline -->
                <div class="lps-pill red">
                    <div class="lps-pill-orb"></div>
                    <span class="lps-pill-count">@liveOffline</span>
                    <span class="lps-pill-label">Offline</span>
                </div>

                <!-- On Hold -->
                <div class="lps-pill orange">
                    <div class="lps-pill-orb"></div>
                    <span class="lps-pill-count">@liveOnHold</span>
                    <span class="lps-pill-label">On Hold</span>
                </div>

                <!-- Permission -->
                <div class="lps-pill gray">
                    <div class="lps-pill-orb"></div>
                    <span class="lps-pill-count">@livePermission</span>
                    <span class="lps-pill-label">Permission</span>
                </div>

                <div class="lps-divider"></div>

                <!-- Active Collections -->
                <div class="lps-pill blue">
                    <i class="bi bi-lightning-fill lps-icon"></i>
                    <span class="lps-pill-count">@liveActiveCollections</span>
                    <span class="lps-pill-label">Active Collections</span>
                </div>

                <!-- Total Fleet -->
                <div class="lps-pill indigo">
                    <i class="bi bi-people-fill lps-icon"></i>
                    <span class="lps-pill-count">@allRiders.Count</span>
                    <span class="lps-pill-label">Total Fleet</span>
                </div>

                <div class="lps-spacer"></div>

                <!-- Last refresh timestamp -->
                <div class="lps-timestamp">
                    <i class="bi bi-arrow-clockwise me-1"></i>
                    Updated: @lastPulseRefresh
                </div>
            </div>
        </section>

        <!-- ══════════ AI INSIGHTS PANEL ══════════ -->
        <section class="ai-insights-section mb-4">
            <div class="ai-section-header">
                <div class="ai-header-left">
                    <div class="ai-brain-orb">
                        <i class="bi bi-cpu-fill"></i>
                    </div>
                    <div>
                        <h4 class="ai-section-title">AI Operations Insights</h4>
                        <small class="ai-section-sub">Auto-computed from last 7 days · @DateTime.Now.ToString("dd MMM, hh:mm tt")</small>
                    </div>
                </div>
                <div class="ai-badge">
                    <i class="bi bi-stars me-1"></i>Smart Analysis
                </div>
            </div>

            @if (aiInsights.Any())
            {
                <div class="ai-insights-grid">
                    @for (int i = 0; i < aiInsights.Count; i++)
                    {
                        var insight = aiInsights[i];
                        var delay = i * 80;
                        <div class="ai-insight-card @insight.Color" style="animation-delay: @(delay)ms">
                            <div class="ai-card-left-bar"></div>
                            <div class="ai-card-icon-wrap">
                                <i class="bi @insight.Icon"></i>
                            </div>
                            <div class="ai-card-body">
                                <div class="ai-card-title">@insight.Title</div>
                                <div class="ai-card-desc">@insight.Description</div>
                            </div>
                            @if (!string.IsNullOrEmpty(insight.ActionUrl))
                            {
                                <a href="@insight.ActionUrl" class="ai-card-action">
                                    @insight.ActionLabel <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="ai-all-clear">
                    <i class="bi bi-shield-check-fill text-success me-2"></i>
                    All operational metrics look healthy for the last 7 days. No issues detected.
                </div>
            }
        </section>

        <!-- Cash Summary Cards Row -->
        <section class="row g-3 mb-3">
            <!-- Collected Today -->
            <div class="col-xl-3 col-md-6">
                <div class="glass-card d-flex align-items-center gap-3 px-4 py-3" style="border-radius: 20px;">
                    <div style="width:44px;height:44px;border-radius:14px;background:rgba(16,185,129,0.12);display:flex;align-items:center;justify-content:center;font-size:20px;color:#10b981;flex-shrink:0;">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div>
                        <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;">Collected Today</div>
                        <div style="font-size:20px;font-weight:850;color:#0f172a;line-height:1.2;">AED @paymentRequests.Where(x => x.RequestType == "PaymentCollection" && x.EnteredDate.Date == DateTime.Today && x.Status == "Completed").Sum(x => x.CollectedAmount ?? 0).ToString("N0")</div>
                        <div style="font-size:10.5px;color:#64748b;font-weight:600;">@paymentRequests.Count(x => x.RequestType == "PaymentCollection" && x.EnteredDate.Date == DateTime.Today && x.Status == "Completed") collections closed</div>
                    </div>
                </div>
            </div>

            <!-- Recovery Today -->
            <div class="col-xl-3 col-md-6">
                <div class="glass-card d-flex align-items-center gap-3 px-4 py-3" style="border-radius: 20px;">
                    <div style="width:44px;height:44px;border-radius:14px;background:rgba(6,182,212,0.12);display:flex;align-items:center;justify-content:center;font-size:20px;color:#06b6d4;flex-shrink:0;">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <div>
                        <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;">Recovery Today</div>
                        <div style="font-size:20px;font-weight:850;color:#0f172a;line-height:1.2;">AED @settledRecoveries.ToString("N0")</div>
                        <div style="font-size:10.5px;color:#64748b;font-weight:600;">Rider deficit cash recovered</div>
                    </div>
                </div>
            </div>

            <!-- Outstanding Deficits -->
            <div class="col-xl-3 col-md-6">
                <div class="glass-card d-flex align-items-center gap-3 px-4 py-3" style="border-radius: 20px;">
                    <div style="width:44px;height:44px;border-radius:14px;background:rgba(239,68,68,0.12);display:flex;align-items:center;justify-content:center;font-size:20px;color:#ef4444;flex-shrink:0;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div>
                        <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;">Outstanding Deficits</div>
                        <div style="font-size:20px;font-weight:850;color:#ef4444;line-height:1.2;">AED @outstandingRiderDeficits.ToString("N0")</div>
                        <div style="font-size:10.5px;color:#64748b;font-weight:600;">Unrecovered rider shortfalls</div>
                    </div>
                </div>
            </div>

            <!-- Net Revenue -->
            <div class="col-xl-3 col-md-6">
                <div class="glass-card d-flex align-items-center gap-3 px-4 py-3" style="border-radius: 20px;">
                    <div style="width:44px;height:44px;border-radius:14px;background:rgba(99,102,241,0.12);display:flex;align-items:center;justify-content:center;font-size:20px;color:#6366f1;flex-shrink:0;">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <div>
                        <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;">Net Revenue</div>
                        @{
                            var todayCollected = paymentRequests.Where(x => x.RequestType == "PaymentCollection" && x.EnteredDate.Date == DateTime.Today && x.Status == "Completed").Sum(x => x.CollectedAmount ?? 0);
                            var netRevenue = todayCollected + settledRecoveries - outstandingRiderDeficits;
                        }
                        <div style="font-size:20px;font-weight:850;color:#6366f1;line-height:1.2;">AED @netRevenue.ToString("N0")</div>
                        <div style="font-size:10.5px;color:#64748b;font-weight:600;">Collected + Recovery − Deficits</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Gauges Row: Operations Control Rings -->
        <section class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="gauge-card glass-card">
                    <div class="gauge-ring-wrap">
                        <svg class="gauge-svg" viewBox="0 0 36 36">
                            <path class="ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <path class="ring-fg active-trips" stroke-dasharray="@activeTripsRate, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        </svg>
                        <div class="gauge-inner">
                            <span class="rate">@activeTripsRate%</span>
                        </div>
                    </div>
                    <div class="gauge-label-wrap">
                        <span class="label">Active Trips</span>
                        <small class="sub">@nextride.Count(t => t.EndTime == null && t.StartTime != null) running / @nextride.Count scheduled</small>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="gauge-card glass-card">
                    <div class="gauge-ring-wrap">
                        <svg class="gauge-svg" viewBox="0 0 36 36">
                            <path class="ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <path class="ring-fg pending-pickups" stroke-dasharray="@pendingPickupsRate, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        </svg>
                        <div class="gauge-inner">
                            <span class="rate text-warning">@pendingPickupsRate%</span>
                        </div>
                    </div>
                    <div class="gauge-label-wrap">
                        <span class="label">Pending Pickups</span>
                        <small class="sub">@pendingAppointments.Count(a => a.Status == "New" || a.Status == "Pending") tasks en route</small>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="gauge-card glass-card">
                    <div class="gauge-ring-wrap">
                        <svg class="gauge-svg" viewBox="0 0 36 36">
                            <path class="ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <path class="ring-fg collections" stroke-dasharray="@completedCollectionsRate, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        </svg>
                        <div class="gauge-inner">
                            <span class="rate text-success">@completedCollectionsRate%</span>
                        </div>
                    </div>
                    <div class="gauge-label-wrap">
                        <span class="label">Collection Success</span>
                        <small class="sub">@paymentRequests.Count(r => r.Status == "Completed") closed / @paymentRequests.Count total</small>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="gauge-card glass-card">
                    <div class="gauge-ring-wrap">
                        <svg class="gauge-svg" viewBox="0 0 36 36">
                            <path class="ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <path class="ring-fg escalations" stroke-dasharray="@criticalAlertsRate, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        </svg>
                        <div class="gauge-inner">
                            <span class="rate text-danger">@criticalAlertsRate%</span>
                        </div>
                    </div>
                    <div class="gauge-label-wrap">
                        <span class="label">Escalation Danger</span>
                        <small class="sub">@escalatedApps.Count critical active breaches</small>
                    </div>
                </div>
            </div>
        </section>

        <!-- Main Charts & Operations Grid -->
        <div class="row g-4 mb-4">
            
            <!-- Column 1: Daily Cash Chart & Curvy Spline line chart -->
            <div class="col-xl-7">
                <!-- Grouped Bar Chart -->
                <div class="dashboard-card glass-card mb-4">
                    <div class="card-header-tactical mb-3">
                        <div class="icon-wrap bg-primary-light text-primary"><i class="bi bi-bar-chart-fill"></i></div>
                        <div>
                            <h4>Reconciled Cash Trend</h4>
                            <small>Daily Target vs. Reconciled Collections (AED)</small>
                        </div>
                    </div>

                    <div class="chart-container py-2">
                        <svg width="100%" height="220" viewBox="0 0 600 220" preserveAspectRatio="none" class="svg-chart">
                            <!-- SVG Grid Lines -->
                            <line x1="40" y1="30" x2="580" y2="30" stroke="#f1f5f9" stroke-width="1" />
                            <line x1="40" y1="80" x2="580" y2="80" stroke="#f1f5f9" stroke-width="1" />
                            <line x1="40" y1="130" x2="580" y2="130" stroke="#f1f5f9" stroke-width="1" />
                            <line x1="40" y1="180" x2="580" y2="180" stroke="#e2e8f0" stroke-width="2" />

                            @for (int idx = 0; idx < dailyMetrics.Count; idx++)
                            {
                                var m = dailyMetrics[idx];
                                decimal maxVal = Math.Max(dailyMetrics.Max(x => Math.Max(x.TargetCash, x.CollectedCash)), 1000);
                                double targetHeight = (double)m.TargetCash * 140 / (double)maxVal;
                                double collectedHeight = (double)m.CollectedCash * 140 / (double)maxVal;
                                
                                int groupX = 60 + idx * 75;

                                <!-- Target Cash Bar (Indigo) -->
                                <rect x="@(groupX)" y="@(180 - targetHeight)" width="18" height="@targetHeight" rx="4" fill="#6366f1" class="bar target-bar">
                                    <title>@m.DayLabel - Target: @m.TargetCash.ToString("N0") AED</title>
                                </rect>

                                <!-- Collected Cash Bar (Green) -->
                                <rect x="@(groupX + 22)" y="@(180 - collectedHeight)" width="18" height="@collectedHeight" rx="4" fill="#10b981" class="bar collected-bar">
                                    <title>@m.DayLabel - Reconciled: @m.CollectedCash.ToString("N0") AED</title>
                                </rect>

                                <!-- X Axis Labels -->
                                @((MarkupString)$"<text x='{groupX + 18}' y='202' text-anchor='middle' font-size='10' font-weight='700' fill='#64748b'>{m.DayLabel.Split(' ')[0]}</text>")
                            }
                        </svg>

                        <!-- Legend -->
                        <div class="chart-legend-row" style="margin-top: 10px;">
                            <div class="legend-item"><span class="color-dot bg-indigo"></span> Target cash</div>
                            <div class="legend-item"><span class="color-dot bg-emerald"></span> Reconciled Cash</div>
                        </div>
                    </div>
                </div>

                <!-- Smooth Spline Curvy Line Chart (Similar to 'Deals' in Reference) -->
                <div class="dashboard-card glass-card">
                    <div class="card-header-tactical mb-2">
                        <div class="icon-wrap bg-info-light text-info"><i class="bi bi-graph-up-arrow"></i></div>
                        <div>
                            <h4>Logistics Dispatch Volume Trend</h4>
                            <small>Smooth spline curvy path with linear gradient background</small>
                        </div>
                    </div>

                    <div class="chart-container py-2 position-relative">
                        <svg width="100%" height="200" viewBox="0 0 600 200" preserveAspectRatio="none" class="svg-chart">
                            <defs>
                                <linearGradient id="splineGradient" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#0ea5e9" stop-opacity="0.3" />
                                    <stop offset="100%" stop-color="#0ea5e9" stop-opacity="0.0" />
                                </linearGradient>
                            </defs>

                            <!-- SVG Grid Lines -->
                            <line x1="40" y1="30" x2="580" y2="30" stroke="#f8fafc" stroke-width="1.5" />
                            <line x1="40" y1="80" x2="580" y2="80" stroke="#f8fafc" stroke-width="1.5" />
                            <line x1="40" y1="130" x2="580" y2="130" stroke="#f8fafc" stroke-width="1.5" />
                            <line x1="40" y1="170" x2="580" y2="170" stroke="#cbd5e1" stroke-width="1.5" />

                            <!-- Gradient Mapped Fill Path -->
                            <path d="@splineFillPath" fill="url(#splineGradient)" />

                            <!-- Curvy Spline Line -->
                            <path d="@splineLinePath" fill="none" stroke="#0ea5e9" stroke-width="3" stroke-linecap="round" />

                            <!-- Plots Coordinate Points -->
                            @for (int idx = 0; idx < splinePoints.Count; idx++)
                            {
                                var pt = splinePoints[idx];
                                <circle cx="@pt.X" cy="@pt.Y" r="5" fill="#ffffff" stroke="#0ea5e9" stroke-width="2.5" />

                                @if (idx == splinePoints.Count - 2) // Last active highlighted bubble (like '146' in Deals reference image)
                                {
                                    <circle cx="@pt.X" cy="@pt.Y" r="12" fill="#0ea5e9" fill-opacity="0.2" class="glow-orb" />
                                    <g transform="translate(@pt.X, @(pt.Y - 14))">
                                        <rect x="-18" y="-12" width="36" height="18" rx="6" fill="#0f172a" />
                                        <text x="0" y="1" text-anchor="middle" font-size="9" font-weight="800" fill="#ffffff">Active</text>
                                    </g>
                                }
                            }

                            <!-- X Axis Date Labels -->
                            @for (int idx = 0; idx < dailyMetrics.Count; idx++)
                            {
                                int labelX = 60 + idx * 75;
                                @((MarkupString)$"<text x='{labelX}' y='190' text-anchor='middle' font-size='10' font-weight='700' fill='#94a3b8'>{dailyMetrics[idx].DayLabel.Split(' ')[0]}</text>")
                            }
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Column 2: Donut Chart & Deficit Status Matrix -->
            <div class="col-xl-5">
                <!-- Round Donut Chart Card (Similar to 'Dispatch Planning' in Reference) -->
                <div class="dashboard-card glass-card mb-4">
                    <div class="card-header-tactical mb-3">
                        <div class="icon-wrap bg-success-light text-success"><i class="bi bi-pie-chart-fill"></i></div>
                        <div>
                            <h4>Dispatch Planning & Allocation</h4>
                            <small>Rider and phlebotomist request assignments</small>
                        </div>
                    </div>

                    <div class="donut-chart-wrapper d-flex align-items-center gap-4 py-2">
                        <!-- Round SVG Donut -->
                        <div class="donut-svg-container" style="width: 130px; height: 130px; position: relative;">
                            <svg viewBox="0 0 64 64" width="100%" height="100%">
                                <circle cx="32" cy="32" r="28" fill="transparent" stroke="#f1f5f9" stroke-width="5" />
                                
                                <!-- Pending (Indigo) -->
                                <circle cx="32" cy="32" r="28" fill="transparent" stroke="#6366f1" stroke-width="5" 
                                        stroke-dasharray="@pendingStrokeDash" stroke-dashoffset="@pendingStrokeOffset" stroke-linecap="round" />
                                
                                <!-- Active (Green) -->
                                <circle cx="32" cy="32" r="28" fill="transparent" stroke="#10b981" stroke-width="5" 
                                        stroke-dasharray="@acceptStrokeDash" stroke-dashoffset="@acceptStrokeOffset" stroke-linecap="round" />
                                
                                <!-- Cancelled/Rejected (Teal) -->
                                <circle cx="32" cy="32" r="28" fill="transparent" stroke="#06b6d4" stroke-width="5" 
                                        stroke-dasharray="@rejectStrokeDash" stroke-dashoffset="@rejectStrokeOffset" stroke-linecap="round" />
                            </svg>
                            <div class="donut-inner-label d-flex flex-column align-items-center justify-content-center" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0;">
                                <span class="fw-extrabold text-dark" style="font-size: 16px; font-weight: 850;">@nextride.Count</span>
                                <small class="text-muted" style="font-size: 9px; font-weight: 600; text-transform: uppercase;">Trips</small>
                            </div>
                        </div>

                        <!-- Donut Legend Details -->
                        <div class="donut-legend flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="color-dot bg-indigo" style="width: 10px; height: 10px;"></span>
                                    <span class="legend-text text-muted" style="font-size: 11px; font-weight: 600;">Indent Pending</span>
                                </div>
                                <span class="legend-value text-dark fw-bold" style="font-size: 12px;">@pendingAppointments.Count(a => a.Status == "Pending" || a.Status == "New")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="color-dot bg-emerald" style="width: 10px; height: 10px;"></span>
                                    <span class="legend-text text-muted" style="font-size: 11px; font-weight: 600;">Indent acceptance pending</span>
                                </div>
                                <span class="legend-value text-dark fw-bold" style="font-size: 12px;">@nextride.Count(t => t.EndTime == null && t.StartTime != null)</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="color-dot bg-info" style="width: 10px; height: 10px;"></span>
                                    <span class="legend-text text-muted" style="font-size: 11px; font-weight: 600;">Rejected Indents</span>
                                </div>
                                <span class="legend-value text-dark fw-bold" style="font-size: 12px;">@paymentRequests.Count(x => x.Status == "Rejected" || x.Status == "Cancelled")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Foot Notice -->
                    <div class="donut-footer mt-3 pt-3 border-top d-flex justify-content-between align-items-center" style="font-size: 11px; font-weight: 600;">
                        <span class="text-muted"><i class="bi bi-shield-exclamation me-1 text-warning"></i> Vehicle assignment pending</span>
                        <span class="badge bg-warning-light text-warning">@pendingAppointments.Count(a => a.RiderID == null || a.RiderID == 0) Unassigned</span>
                    </div>
                </div>

                <!-- Deficit Status Matrix -->
                <div class="dashboard-card glass-card mb-4">
                    <div class="card-header-tactical mb-3">
                        <div class="icon-wrap bg-warning-light text-warning"><i class="bi bi-cash-stack"></i></div>
                        <div>
                            <h4>Reconciliation Status Matrix</h4>
                            <small>Cash deficit & recovery breakdown</small>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <div class="matrix-box">
                                <span class="m-label text-muted">Total Discrepancies</span>
                                <h3 class="m-val text-dark">@totalDiscrepancies.ToString("N2") <small>AED</small></h3>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="matrix-box danger-border">
                                <span class="m-label text-danger">Outstanding Deficits</span>
                                <h3 class="m-val text-danger">@outstandingRiderDeficits.ToString("N2") <small>AED</small></h3>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="matrix-box success-border">
                                <span class="m-label text-success">Recovered Settlements</span>
                                <h3 class="m-val text-success">@settledRecoveries.ToString("N2") <small>AED</small></h3>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="matrix-box info-border">
                                <span class="m-label text-info">Lab Absorbed Deficits</span>
                                <h3 class="m-val text-info">@labAbsorbedDeficits.ToString("N2") <small>AED</small></h3>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Threat Monitor: Delayed Escalations -->
                <div class="dashboard-card glass-card">
                    <div class="escalation-monitor-box">
                        <div class="sec-subtitle mb-2">
                            <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i> Active Escalation Breaches
                        </div>
                        @if (escalatedApps.Any())
                        {
                            <div class="escalation-items-list">
                                @foreach (var esc in escalatedApps.Take(3))
                                {
                                    <div class="esc-item-row level-@esc.EscalationLevel">
                                        <div class="esc-header">
                                            <span class="badge bg-danger-light text-danger">L@(esc.EscalationLevel)</span>
                                            <span class="esc-id">#@esc.AppSno</span>
                                        </div>
                                        <div class="esc-body">
                                            <div class="name text-dark fw-bold">@GetReferralName(esc.ReferralID ?? 0)</div>
                                            <div class="sub text-muted">Assigned Rider: @GetRiderName(esc.RiderID ?? 0)</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="esc-empty p-3 text-center rounded-3 bg-light text-muted" style="font-size: 11px;">
                                <i class="bi bi-shield-check-fill text-success me-1"></i> All rider logistics en route with zero breaches.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>



        <!-- Rider Leaderboard & Recent Transfers Grid -->
        <div class="row g-4">
            

            <!-- Column 1: Rider Leaderboard -->
            <div class="col-xl-6">
                <div class="dashboard-card glass-card h-100">
                    <div class="card-header-tactical mb-3">
                        <div class="icon-wrap bg-success-light text-success"><i class="bi bi-trophy-fill"></i></div>
                        <div>
                            <h4>Rider Workload & Cash Performance</h4>
                            <small>Top logistics collection riders</small>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table leaderboard-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Rider</th>
                                    <th class="text-center">Collections</th>
                                    <th class="text-end">Outstanding Deficit</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (riderLeaderboard.Any())
                                {
                                    @foreach (var rider in riderLeaderboard)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    <img src="@GetRiderProfileImageLink(rider.RiderID)" 
                                                         class="leaderboard-avatar" 
                                                         onerror="this.src='/images/default-avatar.png'" />
                                                    <div>
                                                        <div class="r-name">@rider.RiderName</div>
                                                        <small class="r-id">ID: #@rider.RiderID</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center fw-bold text-dark">@rider.TotalCollections</td>
                                            <td class="text-end">
                                                @if (rider.OutstandingDeficit > 0)
                                                {
                                                    <span class="badge bg-danger-light text-danger fw-bold rounded-pill px-3 py-1">
                                                        @rider.OutstandingDeficit.ToString("N0") AED Deficit
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-light text-success fw-bold rounded-pill px-3 py-1">
                                                        <i class="bi bi-shield-check me-1"></i> 100% Cleared
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted">No riders active in the database.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Column 2: Recent Outbound Transfers -->
            <div class="col-xl-6">
                <div class="dashboard-card glass-card h-100">
                    <div class="card-header-tactical mb-3">
                        <div class="icon-wrap bg-info-light text-info"><i class="bi bi-box-seam-fill"></i></div>
                        <div>
                            <h4>Outbound Sample Guide Logistics</h4>
                            <small>Hub dispatches & transfer statuses</small>
                        </div>
                    </div>

                    <div class="transfer-list-grid">
                        @if (recentTransfers.Any())
                        {
                            @foreach (var transfer in recentTransfers.Take(5))
                            {
                                <div class="transfer-log-item">
                                    <div class="transfer-icon bg-light text-dark">
                                        <i class="bi bi-bus-front"></i>
                                    </div>
                                    <div class="transfer-details-wrap">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="trans-id">Vehicle: @transfer.BusNumber</span>
                                            <span class="trans-time text-muted">@transfer.CreatedAt?.ToString("hh:mm tt")</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-1">
                                            <small class="text-muted">Status: @transfer.Status</small>
                                            <span class="badge bg-info-light text-info">Dispatched</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center rounded-3 bg-light text-muted" style="font-size: 12px;">
                                <i class="bi bi-inboxes-fill me-1"></i> No outbound transfers initiated today.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        
    </div>

    <style>
        /* LIVE PULSE STRIP */
        .live-pulse-strip { background: linear-gradient(135deg, rgba(15,23,42,0.97) 0%, rgba(30,41,59,0.95) 100%); border: 1px solid rgba(255,255,255,0.07); border-radius: 18px; padding: 10px 20px; backdrop-filter: blur(20px); box-shadow: 0 4px 24px rgba(0,0,0,0.12); }
        .lps-inner { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
        .lps-live-badge { display: flex; align-items: center; gap: 7px; background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.25); border-radius: 20px; padding: 4px 12px; flex-shrink: 0; }
        .lps-live-dot { width: 8px; height: 8px; border-radius: 50%; background: #10b981; display: inline-block; animation: lps-blink 1.2s infinite ease-in-out; }
        @@keyframes lps-blink { 0%, 100% { box-shadow: 0 0 0 0 rgba(16,185,129,0.5); } 50% { box-shadow: 0 0 0 6px rgba(16,185,129,0); } }
        .lps-live-text { font-size: 10px; font-weight: 900; letter-spacing: 1.5px; color: #10b981; text-transform: uppercase; }
        .lps-divider { width: 1px; height: 28px; background: rgba(255,255,255,0.08); flex-shrink: 0; }
        .lps-pill { display: flex; align-items: center; gap: 7px; padding: 5px 14px; border-radius: 20px; cursor: default; transition: transform 0.2s ease; }
        .lps-pill:hover { transform: translateY(-2px); }
        .lps-pill.green { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.2); }
        .lps-pill.red { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.2); }
        .lps-pill.orange { background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2); }
        .lps-pill.gray { background: rgba(148,163,184,0.1); border: 1px solid rgba(148,163,184,0.2); }
        .lps-pill.blue { background: rgba(14,165,233,0.1); border: 1px solid rgba(14,165,233,0.2); }
        .lps-pill.indigo { background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.2); }
        .lps-pill-orb { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
        .lps-pill.green .lps-pill-orb { background: #10b981; } .lps-pill.red .lps-pill-orb { background: #ef4444; } .lps-pill.orange .lps-pill-orb { background: #f59e0b; } .lps-pill.gray .lps-pill-orb { background: #94a3b8; } .lps-pill.blue .lps-pill-orb { background: #0ea5e9; } .lps-pill.indigo .lps-pill-orb { background: #6366f1; }
        .lps-pill-count { font-size: 15px; font-weight: 900; color: #ffffff; line-height: 1; }
        .lps-pill-label { font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.6); white-space: nowrap; }
        .lps-icon { font-size: 13px; } .lps-pill.green .lps-icon { color: #10b981; } .lps-pill.blue .lps-icon { color: #0ea5e9; } .lps-pill.indigo .lps-icon { color: #6366f1; }
        .lps-spacer { flex: 1; }
        .lps-timestamp { font-size: 11px; color: rgba(255,255,255,0.35); font-weight: 500; white-space: nowrap; }
        /* AI INSIGHTS PANEL */
        .ai-insights-section { background: linear-gradient(135deg, #ffffff 0%, #f8faff 100%); border: 1px solid #e8edf8; border-radius: 22px; padding: 24px 28px; box-shadow: 0 4px 20px rgba(99,102,241,0.06); }
        .ai-section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
        .ai-header-left { display: flex; align-items: center; gap: 16px; }
        .ai-brain-orb { width: 46px; height: 46px; border-radius: 14px; background: linear-gradient(135deg, #6366f1, #8b5cf6); display: flex; align-items: center; justify-content: center; color: white; font-size: 20px; box-shadow: 0 8px 20px rgba(99,102,241,0.35); flex-shrink: 0; }
        .ai-section-title { font-size: 16px; font-weight: 800; color: #0f172a; margin-bottom: 2px; }
        .ai-section-sub { font-size: 11px; color: #64748b; font-weight: 500; }
        .ai-badge { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; font-size: 11px; font-weight: 700; padding: 6px 14px; border-radius: 20px; }
        .ai-insights-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
        .ai-insight-card { display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: 16px; border: 1px solid transparent; position: relative; overflow: hidden; animation: ai-card-in 0.5s ease both; transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .ai-insight-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(0,0,0,0.08); }
        @@keyframes ai-card-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
        .ai-insight-card.danger { background: rgba(239,68,68,0.05); border-color: rgba(239,68,68,0.15); }
        .ai-insight-card.warning { background: rgba(245,158,11,0.05); border-color: rgba(245,158,11,0.15); }
        .ai-insight-card.info { background: rgba(14,165,233,0.05); border-color: rgba(14,165,233,0.15); }
        .ai-insight-card.success { background: rgba(16,185,129,0.05); border-color: rgba(16,185,129,0.15); }
        .ai-card-left-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; border-radius: 4px 0 0 4px; }
        .ai-insight-card.danger .ai-card-left-bar { background: #ef4444; } .ai-insight-card.warning .ai-card-left-bar { background: #f59e0b; } .ai-insight-card.info .ai-card-left-bar { background: #0ea5e9; } .ai-insight-card.success .ai-card-left-bar { background: #10b981; }
        .ai-card-icon-wrap { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 17px; flex-shrink: 0; }
        .ai-insight-card.danger .ai-card-icon-wrap { background: rgba(239,68,68,0.12); color: #ef4444; } .ai-insight-card.warning .ai-card-icon-wrap { background: rgba(245,158,11,0.12); color: #f59e0b; } .ai-insight-card.info .ai-card-icon-wrap { background: rgba(14,165,233,0.12); color: #0ea5e9; } .ai-insight-card.success .ai-card-icon-wrap { background: rgba(16,185,129,0.12); color: #10b981; }
        .ai-card-body { flex: 1; min-width: 0; }
        .ai-card-title { font-size: 12.5px; font-weight: 750; color: #1e293b; line-height: 1.3; margin-bottom: 3px; }
        .ai-card-desc { font-size: 11px; color: #64748b; font-weight: 500; line-height: 1.4; }
        .ai-card-action { font-size: 11px; font-weight: 700; padding: 5px 12px; border-radius: 10px; white-space: nowrap; flex-shrink: 0; text-decoration: none; }
        .ai-insight-card.danger .ai-card-action { background: rgba(239,68,68,0.1); color: #ef4444; } .ai-insight-card.warning .ai-card-action { background: rgba(245,158,11,0.1); color: #f59e0b; } .ai-insight-card.info .ai-card-action { background: rgba(14,165,233,0.1); color: #0ea5e9; } .ai-insight-card.success .ai-card-action { background: rgba(16,185,129,0.1); color: #10b981; }
        .ai-all-clear { padding: 18px 24px; border-radius: 14px; background: rgba(16,185,129,0.05); border: 1px solid rgba(16,185,129,0.15); font-size: 13px; color: #065f46; font-weight: 600; }

        .control-tower-container {
            padding: 12px 24px;
        }

        .tower-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-main-info {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .tower-logo-wrap {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 22px;
            box-shadow: 0 8px 16px -4px rgba(59, 130, 246, 0.4);
        }

        .tower-title {
            font-weight: 850;
            font-size: 22px;
            color: #0f172a;
            margin-bottom: 2px;
            letter-spacing: -0.5px;
        }

        .tower-subtitle {
            font-size: 13px;
            color: #64748b;
            margin-bottom: 0;
        }

        .header-actions {
            display: flex;
            align-items: center;
        }

        .clock-display {
            font-size: 13px;
            font-weight: 750;
            color: #334155;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 8px 16px;
            border-radius: 20px;
        }

        /* Circular Gauges styling */
        .gauge-card {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 20px;
            border-radius: 20px;
        }

        .gauge-ring-wrap {
            position: relative;
            width: 64px;
            height: 64px;
        }

        .gauge-svg {
            transform: rotate(-90deg);
            width: 100%;
            height: 100%;
        }

        .ring-bg {
            fill: none;
            stroke: #f1f5f9;
            stroke-width: 3.5;
        }

        .ring-fg {
            fill: none;
            stroke-width: 3.5;
            stroke-linecap: round;
            transition: stroke-dasharray 0.8s ease-in-out;
        }

        .ring-fg.active-trips { stroke: #6366f1; }
        .ring-fg.pending-pickups { stroke: #f59e0b; }
        .ring-fg.collections { stroke: #10b981; }
        .ring-fg.escalations { stroke: #ef4444; }

        .gauge-inner {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .gauge-inner .rate {
            font-size: 13px;
            font-weight: 800;
            color: #6366f1;
        }

        .gauge-label-wrap {
            display: flex;
            flex-direction: column;
        }

        .gauge-label-wrap .label {
            font-weight: 800;
            color: #0f172a;
            font-size: 15px;
        }

        .gauge-label-wrap .sub {
            font-size: 10px;
            color: #64748b;
            font-weight: 500;
        }

        /* Dashboard and Glass cards */
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 10px 30px -10px rgba(0,0,0,0.04);
            border-radius: 20px;
        }

        .dashboard-card {
            padding: 24px;
            border-radius: 24px;
        }

        .card-header-tactical {
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid #f1f5f9;
            padding-bottom: 14px;
        }

        .card-header-tactical h4 {
            font-weight: 800;
            font-size: 15px;
            color: #0f172a;
            margin-bottom: 0px;
        }

        .card-header-tactical small {
            font-size: 11px;
            color: #64748b;
            font-weight: 500;
        }

        .icon-wrap {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .bg-primary-light { background: rgba(99, 102, 241, 0.1); }
        .bg-warning-light { background: rgba(245, 158, 11, 0.1); }
        .bg-success-light { background: rgba(16, 185, 129, 0.1); }
        .bg-info-light { background: rgba(6, 182, 212, 0.1); }

        /* SVG Daily Cash Chart */
        .chart-container {
            width: 100%;
            height: 100%;
        }

        .svg-chart {
            overflow: visible;
        }

        .bar {
            cursor: pointer;
            transition: opacity 0.2s;
        }

        .bar:hover {
            opacity: 0.85;
        }

        .chart-legend-row {
            display: flex;
            gap: 16px;
            justify-content: center;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 600;
            color: #64748b;
        }

        .color-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .color-dot.bg-indigo { background: #6366f1; }
        .color-dot.bg-emerald { background: #10b981; }

        /* Donut SVG styling */
        .donut-svg-container svg {
            transform: rotate(-90deg);
        }
        
        .donut-inner-label span {
            line-height: 1.1;
        }

        .glow-orb {
            animation: pulseGlow 2s infinite ease-in-out;
        }

        @@keyframes pulseGlow {
            0% { r: 8px; fill-opacity: 0.15; }
            50% { r: 14px; fill-opacity: 0.35; }
            100% { r: 8px; fill-opacity: 0.15; }
        }

        /* Matrix Box breakdown cards */
        .matrix-box {
            padding: 16px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .matrix-box.danger-border { border-left: 4px solid #ef4444; background: rgba(239, 68, 68, 0.02); }
        .matrix-box.success-border { border-left: 4px solid #10b981; background: rgba(16, 185, 129, 0.02); }
        .matrix-box.info-border { border-left: 4px solid #06b6d4; background: rgba(6, 182, 212, 0.02); }

        .m-label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .m-val {
