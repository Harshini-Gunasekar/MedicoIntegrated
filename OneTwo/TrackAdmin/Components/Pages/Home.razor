    private List<Appointments> escalatedApps = new();
    private List<TripView> nextride = new List<TripView>();
    private List<Rider_Master> allRiders = new();
    private IList<SampleTransferResponse> recentTransfers = new List<SampleTransferResponse>();
    private List<Referral_Master> refm = new();

    // Reconciled Cash and Deficit breakdown properties
    private decimal totalDiscrepancies = 0;
    private decimal outstandingRiderDeficits = 0;
    private decimal settledRecoveries = 0;
    private decimal labAbsorbedDeficits = 0;

    // Rates computed dynamically for circular gauges
    private double activeTripsRate = 0;
    private double pendingPickupsRate = 0;
    private double completedCollectionsRate = 0;
    private double criticalAlertsRate = 0;

    // Sub-modules rows list
    private List<RiderLeaderboardRow> riderLeaderboard = new();
    private List<DailyMetric> dailyMetrics = new();

    // Donut chart properties
    private string pendingStrokeDash = "0 175.9";
    private string acceptStrokeDash = "0 175.9";
    private string rejectStrokeDash = "0 175.9";
    private string pendingStrokeOffset = "0";
    private string acceptStrokeOffset = "0";
    private string rejectStrokeOffset = "0";

    // Spline curve paths
    private string splineLinePath = "";
    private string splineFillPath = "";
    private List<PlotPoint> splinePoints = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var loginState = await protectedSessionStore.GetAsync<bool>("IsLoggedIn");
            if (loginState.Success && loginState.Value)
            {
                var tenant = await protectedSessionStore.GetAsync<string>("TenantID");
                var userId = await protectedSessionStore.GetAsync<int>("UserID");
                var userName = await protectedSessionStore.GetAsync<string>("UserName");

                session.IsLoggedIn = true;
                session.TenantID = tenant.Success ? tenant.Value : null;
                session.UserID = userId.Success ? userId.Value : 0;
                session.UserName = userName.Success ? userName.Value : null;

                _tenantState.TenantID = session.TenantID;
            }

            await LoadDashboardDataAsync();
            
            _clockTimer = new Timer(_ => {
                currentTime = DateTime.Now.ToString("hh:mm:ss tt");
                InvokeAsync(StateHasChanged);
            }, null, 0, 1000);

            _tenantState.OnStateChange += HandleStateChange;
            UpdateHeader();
            pageReady = true;
            showWelcomeCard = true;
            await InvokeAsync(StateHasChanged);
            // Auto-dismiss welcome card after 6 seconds
            _welcomeTimer = new System.Threading.Timer(async _ =>
            {
                showWelcomeCard = false;
                await InvokeAsync(StateHasChanged);
            }, null, 6000, System.Threading.Timeout.Infinite);
        }
    }

    private async Task RefreshDashboardData()
    {
        pageReady = false;
        await InvokeAsync(StateHasChanged);
        await LoadDashboardDataAsync();
        UpdateHeader();
        pageReady = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDashboardDataAsync()
    {
        try
        {
            apiurl = ApiConfig.Value.BaseApiUrl;

            // 1. Fetch Payment Collections list
            var resPay = await Http.GetAsync($"{apiurl}PaymentCollection/admin/list");
            if (resPay.IsSuccessStatusCode)
            {
                var json = await resPay.Content.ReadAsStringAsync();
                paymentRequests = JsonConvert.DeserializeObject<List<PaymentCollectionRequest>>(json) ?? new();
            }

            // 2. Fetch active riders
            var resRiders = await Http.GetAsync($"{apiurl}User/GetFleetRiders");
            if (resRiders.IsSuccessStatusCode)
            {
                var json = await resRiders.Content.ReadAsStringAsync();
                allRiders = JsonConvert.DeserializeObject<List<Rider_Master>>(json) ?? new();
            }

            // 3. Fetch referrals list
            var resRefs = await Http.GetAsync($"{apiurl}referral/allreferral");
            if (resRefs.IsSuccessStatusCode)
            {
                var json = await resRefs.Content.ReadAsStringAsync();
                refm = JsonConvert.DeserializeObject<List<Referral_Master>>(json) ?? new();
            }

            // 4. Fetch scheduled appointments
            DateTime dt = DateTime.Now;
            string sd = dt.ToString("yyyy-MM-dd") + " 00:00:00";
            string ed = dt.ToString("yyyy-MM-dd") + " 23:59:59";
            
            var resApps = await Http.GetAsync($"{apiurl}SampleCollection/appdate?sd={Uri.EscapeUriString(sd)}&ed={Uri.EscapeUriString(ed)}&isupcoming={false}");
            if (resApps.IsSuccessStatusCode)
            {
                var rr = await resApps.Content.ReadAsStringAsync();
                var apps = JsonConvert.DeserializeObject<IList<Appointments>>(rr);
                if (apps != null)
                {
                    pendingAppointments = apps.Where(x => (x.Status == "Pending" || x.Status == "New" || x.Status == "Accepted") && x.Deleted != true).ToList();
                    escalatedApps = apps.Where(x => x.EscalationLevel > 0 && 
                                                    (string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase) || string.Equals(x.Status, "New", StringComparison.OrdinalIgnoreCase)) && 
                                                    x.Deleted != true).ToList();
                }
            }

            // 5. Fetch operational trips
            var resTrips = await Http.GetAsync($"{apiurl}LiveTracker/GetNextTrip?sd={Uri.EscapeUriString(sd)}&ed={Uri.EscapeUriString(ed)}");
            if (resTrips.IsSuccessStatusCode)
            {
                var rr = await resTrips.Content.ReadAsStringAsync();
                var nex = JsonConvert.DeserializeObject<IList<TripView>>(rr);
                if (nex != null)
                {
                    nextride = nex.ToList();
                }
            }

            // 6. Fetch outbound sample transfers at Hub
            var todaySd = DateTime.Today.ToString("yyyy-MM-dd");
            var todayEd = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
            recentTransfers = await msd.GetSampleTransfers(_tenantState.TenantID, todaySd, todayEd, 0);

            // COMPUTE FINANCIAL DISCREPANCY METRICS
            totalDiscrepancies = paymentRequests.Where(x => x.Status == "Completed" && x.DiscrepancyAmount.HasValue).Sum(x => Math.Abs(x.DiscrepancyAmount.Value));
            outstandingRiderDeficits = paymentRequests.Where(x => x.Status == "Completed" && x.ResolutionType == "RiderAccountable" && x.IsDeficitSettled != true && x.DiscrepancyAmount.HasValue).Sum(x => Math.Abs(x.DiscrepancyAmount.Value));
            // FIX: Filter by DeficitSettledTime.Date == today so we only count TODAY's recovered cash, not all-time history
            settledRecoveries = paymentRequests.Where(x => x.Status == "Completed" && x.ResolutionType == "RiderAccountable" && x.IsDeficitSettled == true && x.DiscrepancyAmount.HasValue && x.DeficitSettledTime.HasValue && x.DeficitSettledTime.Value.Date == DateTime.Today).Sum(x => Math.Abs(x.DiscrepancyAmount.Value));
            labAbsorbedDeficits = paymentRequests.Where(x => x.Status == "Completed" && x.ResolutionType == "Equalized" && x.DiscrepancyAmount.HasValue).Sum(x => Math.Abs(x.DiscrepancyAmount.Value));

            // COMPUTE DOCK CONTROL GAUGE RATES
            int totalScheduledTrips = nextride.Count;
            int runningTrips = nextride.Count(t => t.EndTime == null && t.StartTime != null);
            activeTripsRate = totalScheduledTrips > 0 ? Math.Round((double)runningTrips * 100 / totalScheduledTrips, 0) : 0;

            int totalTodayAppointments = pendingAppointments.Count + escalatedApps.Count;
            int pendingPickups = pendingAppointments.Count(a => a.Status == "New" || a.Status == "Pending");
            pendingPickupsRate = totalTodayAppointments > 0 ? Math.Round((double)pendingPickups * 100 / totalTodayAppointments, 0) : 0;

            int totalCollectionsCount = paymentRequests.Count;
            int completedCollectionsCount = paymentRequests.Count(r => r.Status == "Completed");
            completedCollectionsRate = totalCollectionsCount > 0 ? Math.Round((double)completedCollectionsCount * 100 / totalCollectionsCount, 0) : 0;

            int totalEscalations = escalatedApps.Count;
            criticalAlertsRate = totalTodayAppointments > 0 ? Math.Round((double)totalEscalations * 100 / totalTodayAppointments, 0) : 0;

            // COMPUTE SVG GROUPED DAILY TREND DETAILS
            dailyMetrics.Clear();
            for (int i = 6; i >= 0; i--)
            {
                var targetDate = DateTime.Today.AddDays(-i);
                var dayLabel = targetDate.ToString("ddd d MMM");
                
                var targetRequests = paymentRequests.Where(x => x.EnteredDate.Date == targetDate.Date);
                decimal targetCash = targetRequests.Where(x => x.RequestType == "PaymentCollection").Sum(x => x.RequestedAmount ?? 0);
                decimal collectedCash = targetRequests.Where(x => x.RequestType == "PaymentCollection").Sum(x => x.CollectedAmount ?? 0);

                dailyMetrics.Add(new DailyMetric
                {
                    DayLabel = dayLabel,
                    TargetCash = targetCash,
                    CollectedCash = collectedCash
                });
            }

            // COMPUTE RIDER WORKLOAD LEADERBOARD
            var groupedRiders = paymentRequests
                .Where(x => x.RiderID.HasValue && x.RiderID > 0)
                .GroupBy(x => x.RiderID.Value)
                .Select(g => {
                    var riderId = g.Key;
                    var riderName = g.FirstOrDefault()?.RiderName ?? $"Rider #{riderId}";
                    var successfulCollections = g.Count(x => x.Status == "Completed");
                    var outstandingDeficit = g.Where(x => x.ResolutionType == "RiderAccountable" && x.IsDeficitSettled != true && x.DiscrepancyAmount.HasValue).Sum(x => Math.Abs(x.DiscrepancyAmount.Value));

                    return new RiderLeaderboardRow
                    {
                        RiderID = riderId,
                        RiderName = riderName,
                        TotalCollections = successfulCollections,
                        OutstandingDeficit = outstandingDeficit
                    };
                })
                .OrderByDescending(r => r.TotalCollections)
                .Take(5)
                .ToList();

            riderLeaderboard = groupedRiders;

            // Compute Round Donut Chart Segment parameters
            ComputeDonutChart();

            // Compute Curvy Spline Line coordinates
            ComputeSplineChart();

            // Compute Live Pulse Strip counts
            ComputePulseStrip();

            // Compute AI Insights (7-day window)
            ComputeAIInsights();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error in Control Tower pipeline: " + ex.Message);
        }
    }

    private void ComputeDonutChart()
    {
        double total = pendingAppointments.Count(a => a.Status == "Pending" || a.Status == "New") + 
                       nextride.Count(t => t.EndTime == null && t.StartTime != null) + 
                       paymentRequests.Count(x => x.Status == "Rejected" || x.Status == "Cancelled");

        if (total == 0) total = 3; // Seed defaults if empty database

        double pVal = pendingAppointments.Count(a => a.Status == "Pending" || a.Status == "New");
        double aVal = nextride.Count(t => t.EndTime == null && t.StartTime != null);
        double rVal = paymentRequests.Count(x => x.Status == "Rejected" || x.Status == "Cancelled");

        if (pVal == 0 && aVal == 0 && rVal == 0)
        {
            pVal = 5; aVal = 3; rVal = 1;
            total = 9;
        }

        // Circumference of Donut circle (r=28) is 2 * PI * 28 = 175.929
        double circ = 175.929;

        double pDash = pVal * circ / total;
        double aDash = aVal * circ / total;
        double rDash = rVal * circ / total;

        pendingStrokeDash = $"{pDash:F1} {circ:F1}";
        acceptStrokeDash = $"{aDash:F1} {circ:F1}";
        rejectStrokeDash = $"{rDash:F1} {circ:F1}";

        pendingStrokeOffset = "0";
        acceptStrokeOffset = $"-{pDash:F1}";
        rejectStrokeOffset = $"-{(pDash + aDash):F1}";
    }

    private void ComputeSplineChart()
    {
        splinePoints.Clear();
        if (dailyMetrics.Count == 0) return;

        decimal maxVal = Math.Max(dailyMetrics.Max(x => x.CollectedCash), 100);
        
        for (int i = 0; i < dailyMetrics.Count; i++)
        {
            double x = 60 + i * 75;
            // Map values to height scale [150, 40]
            double y = 160 - ((double)dailyMetrics[i].CollectedCash * 110 / (double)maxVal);
            splinePoints.Add(new PlotPoint { X = x, Y = y });
        }

        // Draw Spline command using cubic bezier interpolation curves
        System.Text.StringBuilder sb = new System.Text.StringBuilder();
        sb.Append($"M {splinePoints[0].X:F1} {splinePoints[0].Y:F1}");

        for (int i = 0; i < splinePoints.Count - 1; i++)
        {
            var curr = splinePoints[i];
            var next = splinePoints[i + 1];
            double cpX1 = curr.X + 35;
            double cpY1 = curr.Y;
            double cpX2 = next.X - 35;
            double cpY2 = next.Y;
            sb.Append($" C {cpX1:F1} {cpY1:F1}, {cpX2:F1} {cpY2:F1}, {next.X:F1} {next.Y:F1}");
        }

        splineLinePath = sb.ToString();
        splineFillPath = $"{splineLinePath} L {splinePoints.Last().X:F1} 170 L {splinePoints.First().X:F1} 170 Z";
    }

