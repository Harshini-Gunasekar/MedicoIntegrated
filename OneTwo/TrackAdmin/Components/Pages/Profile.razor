@page "/Profile"
@rendermode InteractiveServer

@using TrackAdmin.Models
@using TrackAdmin.Data
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Notifications
@inject HttpClient Http
@inject UserSessionService Session
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="profile-container animate-fade-in">
    <div class="profile-header">
        <div class="header-content">
            <div class="profile-avatar">
                <i class="bi bi-person-badge-fill"></i>
            </div>
            <div class="header-text">
                <h1>Account Profile</h1>
                <p>Manage your account details and escalation settings</p>
            </div>
        </div>
    </div>

    <div class="profile-card glass-morphic">
        @if (isLoading)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary" role="status"></div>
                <p>Loading your profile...</p>
            </div>
        }
        else if (user == null)
        {
            <div class="error-state">
                <i class="bi bi-exclamation-triangle"></i>
                <p>Could not load profile. Please try again.</p>
                <SfButton Content="Retry" CssClass="e-primary" OnClick="LoadProfile"></SfButton>
            </div>
        }
        else
        {
            <div class="profile-form">
                <div class="form-section">
                    <h3><i class="bi bi-person-fill"></i> Personal Information</h3>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Full Name</label>
                            <SfTextBox @bind-Value="user.Name" Placeholder="Enter your name"></SfTextBox>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Email Address</label>
                            <SfTextBox @bind-Value="user.Email" Placeholder="Enter email" Enabled="false"></SfTextBox>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Personal Mobile</label>
                            <SfTextBox @bind-Value="user.Mobile" Placeholder="Enter mobile number"></SfTextBox>
                        </div>
                    </div>
                </div>

                <div class="form-section highlight">
                    <h3><i class="bi bi-whatsapp"></i> Escalation Settings</h3>
                    <p class="section-hint">This mobile number will receive WhatsApp notifications when appointments are escalated to the manager level.</p>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Manager's WhatsApp Mobile</label>
                            <SfTextBox @bind-Value="user.manager_mobile" Placeholder="e.g. 971501234567"></SfTextBox>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <SfButton Content="Save Changes" IconCss="bi bi-check-circle" IsPrimary="true" OnClick="SaveChanges" Disabled="isSaving"></SfButton>
                    <SfButton Content="Cancel" CssClass="e-outline" OnClick="GoBack"></SfButton>
                </div>
            </div>
        }
    </div>
</div>

<SfToast @ref="ToastObj" Timeout="3000">
    <ToastPosition X="Right" Y="Top"></ToastPosition>
</SfToast>

<style>
    .profile-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .profile-header {
        margin-bottom: 30px;
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .profile-avatar {
        width: 80px;
        height: 80px;
        background: var(--primary-glow);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 40px;
        box-shadow: 0 10px 20px rgba(59, 130, 246, 0.2);
    }

    .header-text h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 800;
        color: var(--text-main);
    }

    .header-text p {
        margin: 0;
        color: var(--text-muted);
        font-weight: 500;
    }

    .profile-card {
        padding: 40px;
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .form-section {
        margin-bottom: 40px;
    }

    .form-section h3 {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 15px;
        color: var(--text-main);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-section.highlight {
        background: rgba(59, 130, 246, 0.05);
        padding: 25px;
        border-radius: 16px;
        border-left: 4px solid var(--primary-glow);
    }

    .section-hint {
        font-size: 13px;
        color: var(--text-muted);
        margin-bottom: 20px;
    }

    .form-section label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 8px;
    }

    .form-actions {
        display: flex;
        gap: 15px;
        border-top: 1px solid rgba(0,0,0,0.05);
        padding-top: 30px;
    }

    .loading-state, .error-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px;
        gap: 20px;
        color: var(--text-muted);
    }

    .error-state i {
        font-size: 48px;
        color: #f43f5e;
    }
</style>

@code {
    private User_Master? user;
    private bool isLoading = true;
    private bool isSaving = false;
    private SfToast ToastObj;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var userId = Session.UserID;
            if (userId == 0)
            {
                Navigation.NavigateTo("/");
                return;
            }

            // Get all users and find the one matching current session
            var users = await Http.GetFromJsonAsync<List<User_Master>>("User/LabUsers");
            if (users != null)
            {
                user = users.FirstOrDefault(u => u.UserID == userId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading profile: " + ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveChanges()
    {
        if (user == null) return;

        try
        {
            isSaving = true;
            var response = await Http.PostAsJsonAsync("User/UpdateAdminUser", user);
            
            if (response.IsSuccessStatusCode)
            {
                await ToastObj.ShowAsync(new ToastModel { Title = "Success", Content = "Profile updated successfully!", CssClass = "e-toast-success" });
                Session.UserName = user.Name;
                await JS.InvokeVoidAsync("alert", "Profile saved successfully!");
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                await ToastObj.ShowAsync(new ToastModel { Title = "Error", Content = "Failed to save: " + err, CssClass = "e-toast-danger" });
            }
        }
        catch (Exception ex)
        {
            await ToastObj.ShowAsync(new ToastModel { Title = "Error", Content = "Failed to save profile: " + ex.Message, CssClass = "e-toast-danger" });
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/Appointments");
    }
}
