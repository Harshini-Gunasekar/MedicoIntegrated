@attribute [StreamRendering(true)]
@rendermode @(new InteractiveServerRenderMode(prerender:false))

@using Syncfusion.Blazor.SplitButtons
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using TrackAdmin.Data

@inject NavigationManager NavManager
@inject UserSessionService session
@inject ProtectedSessionStorage protectedSessionStore
@inject IJSRuntime JS
@inject LogoutStateService _logoutService

<div class="alpha-topbar glass-morphic animate-fade-in">

    <div class="alpha-topbar-left">
        <div class="logo-orb">
            <img src="/images/rido-logo-pro.png" class="alpha-logo" />
        </div>
        <div class="alpha-title-wrap">
            <span class="alpha-title">Rido</span>
            <span class="alpha-sub">Admin Console</span>
        </div>
    </div>

    <div class="alpha-topbar-right">

        <div class="alpha-live-indicator">
            <span class="pulse-dot"></span>
            <span class="status-text">Live Ops</span>
        </div>

        <TrackAdmin.Components.Shared.AppSwitcher />
        
        <TrackAdmin.Components.Shared.BranchSwitcher />

        <div class="user-profile-wrapper">
            <SfDropDownButton Content="@DisplayName"
                              CssClass="alpha-user-btn"
                              IconCss="e-icons e-user">

                <DropDownButtonEvents ItemSelected="@OnMenuSelect"></DropDownButtonEvents>

                <DropDownMenuItems>
                    <DropDownMenuItem Text="Profile Settings" IconCss="e-icons e-settings" Id="profile"></DropDownMenuItem>
                    <DropDownMenuItem Text="Change Password" IconCss="e-icons e-edit" Id="changepassword"></DropDownMenuItem>
                    <DropDownMenuItem Separator="true"></DropDownMenuItem>
                    <DropDownMenuItem Text="Logout" IconCss="e-icons e-logout" Id="logout"></DropDownMenuItem>
                </DropDownMenuItems>

            </SfDropDownButton>
        </div>

    </div>

</div>

<style>
    .alpha-topbar {
        position: sticky;
        top: 15px;
        margin: 15px 25px;
        height: 70px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 30px;
        z-index: 1100;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    }

    .alpha-topbar-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .logo-orb {
        width: 45px;
        height: 45px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .alpha-logo {
        height: 28px;
        filter: drop-shadow(0 0 5px rgba(56, 189, 248, 0.5));
    }

    .alpha-title-wrap {
        display: flex;
        flex-direction: column;
    }

    .alpha-title {
        font-size: 20px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.5px;
        line-height: 1;
    }

    .alpha-sub {
        font-size: 11px;
        font-weight: 600;
        color: var(--accent-primary);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .alpha-topbar-right {
        display: flex;
        align-items: center;
        gap: 25px;
    }

    .alpha-live-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(16, 185, 129, 0.1);
        padding: 6px 14px;
        border-radius: 50px;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 10px #10b981;
        animation: pulse 2s infinite;
    }

    .status-text {
        font-size: 12px;
        font-weight: 700;
        color: #10b981;
    }

    @@keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
        100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .alpha-user-btn {
        background: transparent !important;
        border: none !important;
        font-weight: 600 !important;
        color: #ffffff !important;
    }
</style>

@code {

    private string UserName = "";

    private string DisplayName =>
        string.IsNullOrWhiteSpace(UserName) ? "Rido" : UserName;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userName = await protectedSessionStore.GetAsync<string>("UserName");

            if (userName.Success && !string.IsNullOrWhiteSpace(userName.Value))
            {
                UserName = userName.Value;
                StateHasChanged();
            }
        }
    }

    private async Task OnMenuSelect(MenuEventArgs args)
    {
        var id = args.Item.Id?.Trim();
        var text = args.Item.Text?.Trim();

        if (string.Equals(id, "logout", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(text, "Logout", StringComparison.OrdinalIgnoreCase))
        {
            await Logout();
        }
        else if (string.Equals(id, "profile", StringComparison.OrdinalIgnoreCase) ||
                 string.Equals(text, "Profile Settings", StringComparison.OrdinalIgnoreCase))
        {
            NavManager.NavigateTo("/Profile");
        }
        else if (string.Equals(id, "changepassword", StringComparison.OrdinalIgnoreCase) ||
                 string.Equals(text, "Change password", StringComparison.OrdinalIgnoreCase))
        {
            // NavManager.NavigateTo("/ChangePassword");
        }
    }

    private async Task Logout()
    {
        await _logoutService.RequestLogoutAsync();
    }
}