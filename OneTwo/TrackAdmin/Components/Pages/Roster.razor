    private List<DateTime?> GetCalendarGridDates()
    {
        var dates = new List<DateTime?>();
        var firstDayOfMonth = new DateTime(calendarMonth.Year, calendarMonth.Month, 1);
        int dayOfWeekVal = (int)firstDayOfMonth.DayOfWeek;
        int offset = dayOfWeekVal == 0 ? 6 : dayOfWeekVal - 1; // 0 for Mon, 1 for Tue, ..., 6 for Sun
        
        for (int i = 0; i < offset; i++)
        {
            dates.Add(null);
        }
        
        int daysInMonth = DateTime.DaysInMonth(calendarMonth.Year, calendarMonth.Month);
        for (int day = 1; day <= daysInMonth; day++)
        {
            dates.Add(new DateTime(calendarMonth.Year, calendarMonth.Month, day));
        }
        
        return dates;
    }

    private void PrevCalendarMonth()
    {
        calendarMonth = calendarMonth.AddMonths(-1);
    }

    private void NextCalendarMonth()
    {
