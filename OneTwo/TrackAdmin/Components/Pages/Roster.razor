</SfDialog>

<!-- 6. Export Options Modal -->
<SfDialog Width="450px" ShowCloseIcon="false" IsModal="true" @bind-Visible="showExportModal" CssClass="light-roster-dialog">
    <DialogTemplates>
        <Header>
            <div class="dialog-header-custom">
                <div class="dialog-header-title">
                    <i class="bi bi-download me-2 text-primary"></i> Export Duty Roster
                </div>
                <button class="dlg-close-btn" @onclick="() => showExportModal = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </Header>
        <Content>
            <div class="dialog-form">
                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Select Export Scope</label>
                    <div class="export-scope-options mt-2">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="exportScope" id="scopeDay" value="day" checked="@(exportScope == "day")" @onchange='() => exportScope = "day"' />
                            <label class="form-check-label ms-2" for="scopeDay">
                                <strong>Selected Day</strong> (@selectedDailyDate.ToString("yyyy-MM-dd"))
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="exportScope" id="scopeWeek" value="week" checked="@(exportScope == "week")" @onchange='() => exportScope = "week"' />
                            <label class="form-check-label ms-2" for="scopeWeek">
                                <strong>Current Week</strong> (@startDate.ToString("MMM dd") - @endDate.ToString("MMM dd"))
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="exportScope" id="scopeMonth" value="month" checked="@(exportScope == "month")" @onchange='() => exportScope = "month"' />
                            <label class="form-check-label ms-2" for="scopeMonth">
                                <strong>Current Month</strong> (@selectedDailyDate.ToString("MMMM yyyy"))
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="exportScope" id="scopeCustom" value="custom" checked="@(exportScope == "custom")" @onchange='() => exportScope = "custom"' />
                            <label class="form-check-label ms-2" for="scopeCustom">
                                <strong>Custom Date Range</strong>
                            </label>
                        </div>
                    </div>

                    @if (exportScope == "custom")
                    {
                        <div class="row g-2 mt-2 p-2 border rounded bg-light">
                            <div class="col-6">
                                <label class="form-label text-xs fw-bold mb-1" style="font-size: 11px;">Start Date</label>
                                <input type="date" class="form-control-custom" style="padding: 4px 8px; font-size: 12px; border-radius: 6px;" @bind="exportStartDate" @bind:format="yyyy-MM-dd" />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-xs fw-bold mb-1" style="font-size: 11px;">End Date</label>
                                <input type="date" class="form-control-custom" style="padding: 4px 8px; font-size: 12px; border-radius: 6px;" @bind="exportEndDate" @bind:format="yyyy-MM-dd" />
                            </div>
                        </div>
                    }
                </div>

                <div class="dialog-actions-row">
                    <button class="btn-cancel" @onclick="() => showExportModal = false">Cancel</button>
                    <button class="btn-save" @onclick="() => GenerateAndDownloadCSV(exportScope)">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
                    </button>
                </div>
            </div>
        </Content>
    </DialogTemplates>
