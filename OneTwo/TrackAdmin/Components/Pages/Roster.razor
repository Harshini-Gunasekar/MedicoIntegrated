    private async Task SaveAssignment()
    {
        if (dialogActionType == "Assign")
        {
            if (selectedSlotId == 0 || selectedDutyTypeId == 0)
            {
                await DialogService.AlertAsync("Please select both a valid time slot and duty category.");
                return;
            }

            if (isHeaderCreate)
            {
                if (selectedBulkRiderIds == null || !selectedBulkRiderIds.Any())
                {
                    await DialogService.AlertAsync("Please select at least one rider.");
                    return;
                }

                var activeDates = selectedBulkDates.ToList();
                if (!activeDates.Any())
                {
                    await DialogService.AlertAsync("Please select at least one date.");
                    return;
                }

                try
                {
                    var bulkRequest = new RosterBulkAssignmentRequest
                    {
                        RiderIds = selectedBulkRiderIds,
                        Dates = activeDates,
                        SlotId = selectedSlotId,
                        DutyTypeId = selectedDutyTypeId,
                        Zone = selectedZone
                    };

                    var response = await http.PostAsJsonAsync("roster/assignments/bulk-save", bulkRequest);
                    if (response.IsSuccessStatusCode)
                    {
                        showAssignModal = false;
                        await LoadAssignmentsAsync();
                        CalculateStats();
                        UpdatePageHeaderMetadata();
                    }
                    else
                    {
                        await DialogService.AlertAsync("Failed to save bulk assignments. Please try again.");
                    }
                }
                catch (Exception ex)
                {
                    await DialogService.AlertAsync($"Error saving assignments: {ex.Message}");
                }
            }
            else
            {
                var newAssignment = new RosterAssignment
                {
                    RiderId = selectedRiderId,
                    SlotId = selectedSlotId,
                    DutyTypeId = selectedDutyTypeId,
                    DutyDate = selectedDate,
                    Zone = selectedZone,
                    IsActive = true
                };

                try
                {
                    var response = await http.PostAsJsonAsync("roster/assignments", newAssignment);
                    if (response.IsSuccessStatusCode)
                    {
                        showAssignModal = false;
                        await LoadAssignmentsAsync();
                        CalculateStats();
                        UpdatePageHeaderMetadata();
                    }
                    else
                    {
                        await DialogService.AlertAsync("Failed to save roster assignment.");
                    }
                }
                catch (Exception ex)
                {
                    await DialogService.AlertAsync($"Error saving assignment: {ex.Message}");
                }
            }
        }
        else // Clear Mode
        {
            if (isHeaderCreate)
            {
                if (selectedBulkRiderIds == null || !selectedBulkRiderIds.Any())
                {
                    await DialogService.AlertAsync("Please select at least one rider.");
                    return;
                }

                var activeDates = selectedBulkDates.ToList();
                if (!activeDates.Any())
                {
                    await DialogService.AlertAsync("Please select at least one date.");
                    return;
                }

                bool confirm = await DialogService.ConfirmAsync(
                    $"Are you sure you want to CLEAR shifts for the {selectedBulkRiderIds.Count} selected rider(s) across {activeDates.Count} selected date(s)?",
                    "Confirm Bulk Clear"
                );
                if (!confirm) return;

                try
                {
                    var bulkClearRequest = new RosterBulkClearRequest
                    {
                        RiderIds = selectedBulkRiderIds,
                        Dates = activeDates
                    };

                    var response = await http.PostAsJsonAsync("roster/assignments/bulk-clear", bulkClearRequest);
                    if (response.IsSuccessStatusCode)
                    {
                        showAssignModal = false;
                        await LoadAssignmentsAsync();
                        CalculateStats();
                        UpdatePageHeaderMetadata();
                    }
                    else
                    {
                        await DialogService.AlertAsync("Failed to clear bulk assignments. Please try again.");
                    }
                }
                catch (Exception ex)
                {
                    await DialogService.AlertAsync($"Error clearing assignments: {ex.Message}");
                }
            }
            else // Single Clear
            {
                bool confirm = await DialogService.ConfirmAsync("Are you sure you want to remove this scheduled shift?", "Confirm Deletion");
                if (!confirm) return;

                try
                {
                    var response = await http.PostAsync($"roster/assignments/clear?riderId={selectedRiderId}&date={selectedDate:yyyy-MM-dd}", null);
                    if (response.IsSuccessStatusCode)
                    {
                        showAssignModal = false;
                        await LoadAssignmentsAsync();
                        CalculateStats();
                        UpdatePageHeaderMetadata();
                    }
                    else
                    {
                        await DialogService.AlertAsync("Failed to clear assignment.");
                    }
                }
                catch (Exception ex)
                {
                    await DialogService.AlertAsync($"Error clearing assignment: {ex.Message}");
                }
            }
        }
    }

    private async Task DeleteAssignment(Guid assignmentId)
    {
        bool confirm = await DialogService.ConfirmAsync("Are you sure you want to remove this scheduled shift?", "Confirm Deletion");
        if (!confirm) return;

        try
        {
            var response = await http.DeleteAsync($"roster/assignments/{assignmentId}");
            if (response.IsSuccessStatusCode)
            {
                await LoadAssignmentsAsync();
                CalculateStats();
                UpdatePageHeaderMetadata();
            }
            else
            {
                await DialogService.AlertAsync("Failed to remove shift assignment.");
            }
        }
        catch (Exception ex)
        {
            await DialogService.AlertAsync($"Error: {ex.Message}");
        }
    }

    // Shift Swap Logic
    private void OpenSwapModal(int riderId, DateTime date)
    {
        selectedRiderId = riderId;
        selectedRiderName = riderMasters.FirstOrDefault(r => r.RiderID == riderId)?.Name ?? "Rider";
        selectedDate = date;
        swapTargetRiderId = 0;
        showSwapModal = true;
    }

    private async Task ExecuteShiftSwap()
    {
        if (swapTargetRiderId == 0)
        {
            await DialogService.AlertAsync("Please select a target rider to swap shifts with.");
            return;
        }

        var request = new ShiftSwapRequest
        {
            RiderIdA = selectedRiderId,
            RiderIdB = swapTargetRiderId,
            Date = selectedDate
        };

        try
        {
            var response = await http.PostAsJsonAsync("roster/swap", request);
            if (response.IsSuccessStatusCode)
            {
                showSwapModal = false;
                await LoadAssignmentsAsync();
                CalculateStats();
            }
            else
            {
                await DialogService.AlertAsync("Failed to swap rider shifts. Please verify if shifts exist.");
            }
        }
        catch (Exception ex)
        {
            await DialogService.AlertAsync($"Error performing swap: {ex.Message}");
        }
    }

    // Weekly copy schedule logic
    private void OpenCopyWeekModal(int riderId, string name)
    {
        selectedRiderId = riderId;
        selectedRiderName = name;
        copyTargetRiderId = riderId; // Default to copying to self (next week)
        showCopyModal = true;
    }

    private async Task ExecuteWeekCopy()
    {
        if (copyTargetRiderId == 0)
        {
            await DialogService.AlertAsync("Please select a valid target rider.");
            return;
        }

        var request = new ShiftCopyRequest
        {
            SourceRiderId = selectedRiderId,
            TargetRiderId = copyTargetRiderId,
            SourceWeekStart = startDate,
            TargetWeekStart = copyTargetWeekStart
        };

        try
        {
            var response = await http.PostAsJsonAsync("roster/copy", request);
            if (response.IsSuccessStatusCode)
            {
                showCopyModal = false;
                
                // If copied to the current viewed week, reload assignments immediately
                if (copyTargetWeekStart.Date == startDate.Date)
                {
                    await LoadAssignmentsAsync();
                    CalculateStats();
                }
                else
                {
                    await DialogService.AlertAsync("Week schedule copied successfully!");
                }
            }
            else
            {
                await DialogService.AlertAsync("Failed to copy weekly schedule. Verify source roster exists.");
            }
        }
        catch (Exception ex)
        {
            await DialogService.AlertAsync($"Error: {ex.Message}");
        }
    }

    // Time Slots Configuration management
    private void OpenTimeSlotsManager()
    {
        editingSlotId = 0;
        newSlotName = "";
        newSlotStartTime = DateTime.Today.AddHours(8);
        newSlotEndTime = DateTime.Today.AddHours(16);
        showTimeSlotsModal = true;
