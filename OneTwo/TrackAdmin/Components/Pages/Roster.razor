    .light-roster-dialog .calendar-month-label {
        font-size: 13px;
        color: #0f172a;
    }

    .light-roster-dialog .btn-icon-round {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
