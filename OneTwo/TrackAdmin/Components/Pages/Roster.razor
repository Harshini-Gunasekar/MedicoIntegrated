    private void SelectCalendarWeekdays()
    {
        int daysInMonth = DateTime.DaysInMonth(calendarMonth.Year, calendarMonth.Month);
        for (int day = 1; day <= daysInMonth; day++)
        {
            var dt = new DateTime(calendarMonth.Year, calendarMonth.Month, day);
            if (dt.DayOfWeek != DayOfWeek.Saturday && dt.DayOfWeek != DayOfWeek.Sunday)
            {
                selectedBulkDates.Add(dt);
            }
        }
    }

    private void SelectCalendarWeekends()
    {
        int daysInMonth = DateTime.DaysInMonth(calendarMonth.Year, calendarMonth.Month);
        for (int day = 1; day <= daysInMonth; day++)
        {
            var dt = new DateTime(calendarMonth.Year, calendarMonth.Month, day);
            if (dt.DayOfWeek == DayOfWeek.Saturday || dt.DayOfWeek == DayOfWeek.Sunday)
            {
                selectedBulkDates.Add(dt);
            }
        }
    }

    private void SelectCalendarAll()
    {
        int daysInMonth = DateTime.DaysInMonth(calendarMonth.Year, calendarMonth.Month);
        for (int day = 1; day <= daysInMonth; day++)
        {
            var dt = new DateTime(calendarMonth.Year, calendarMonth.Month, day);
            selectedBulkDates.Add(dt);
        }
    }

