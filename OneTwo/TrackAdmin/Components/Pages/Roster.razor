    .roster-calendar-table .zone-text {
        font-size: 10px;
        color: #64748b;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: inline-flex;
        align-items: center;
    }

    .roster-calendar-table .assignment-actions {
        display: flex;
        gap: 4px;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .roster-calendar-table .assignment-card:hover .assignment-actions {
        opacity: 1;
    }

    .roster-calendar-table .cell-action-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        padding: 2px;
    }

    .roster-calendar-table .cell-action-btn:hover {
        color: #334155;
    }

    .roster-calendar-table .cell-action-btn.edit:hover {
        color: #2563eb;
    }

    .roster-calendar-table .cell-action-btn.delete:hover {
        color: #ef4444;
    }

    .yet-to-assign-container {
        display: flex;
        align-items: center;
