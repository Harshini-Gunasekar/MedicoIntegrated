        font-weight: 700;
        color: #1e293b;
    }

    .rider-card-wrap .rider-code {
        font-size: 10px;
        color: #64748b;
    }

    .copy-week-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        padding: 4px;
        margin-left: auto;
    }

    .copy-week-btn:hover {
        color: #2563eb;
    }

    .roster-calendar-table .schedule-cell {
        height: 80px;
        position: relative;
    }

    .roster-calendar-table .schedule-cell.is-today {
        background-color: #eff6ff25;
    }

    .roster-calendar-table .assign-placeholder-btn {
        width: 100%;
        height: 44px;
        background: transparent;
        border: 1.5px dashed #e2e8f0;
        border-radius: 8px;
        color: #94a3b8;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .roster-calendar-table .assign-placeholder-btn:hover {
        border-color: #3b82f6;
        color: #3b82f6;
        background-color: #eff6ff50;
    }

    .roster-calendar-table .assignment-card {
        border-left: 3px solid #3b82f6;
        background-color: #f8fafc;
        border-radius: 8px;
