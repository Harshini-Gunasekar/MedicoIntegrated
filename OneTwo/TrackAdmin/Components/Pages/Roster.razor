    // Formatting & Calculation Helpers
    private string FormatTimeSpan(TimeSpan time)
    {
        return DateTime.Today.Add(time).ToString("hh:mm tt");
    }

    private string CalculateHours(TimeSpan start, TimeSpan end)
    {
        var diff = end - start;
        if (diff.TotalHours < 0) diff = diff.Add(TimeSpan.FromDays(1));
        return diff.TotalHours.ToString("0");
    }

    // Pagination commands
    private void PrevPage()
    {
        if (HasPrevPage) currentPage--;
    }

    private void NextPage()
    {
        if (HasNextPage) currentPage++;
    }

    private void GoToPage(int pageIdx)
    {
        currentPage = pageIdx;
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
    }

    private async Task ApplyFilters()
    {
        isFilterActive = true;
        startDate = filterStartDate;
        endDate = filterEndDate;
        calendarDaysCount = (filterEndDate.Date - filterStartDate.Date).Days + 1;
        if (calendarDaysCount <= 0) calendarDaysCount = 1;

        if (currentView == RosterViewMode.Table)
        {
            selectedDailyDate = filterStartDate;
        }

        currentPage = 1;
        await LoadAssignmentsAsync();
        CalculateStats();
        UpdatePageHeaderMetadata();
        StateHasChanged();
    }

    private async Task ResetFilters()
    {
        isFilterActive = false;
        filterStartDate = DateTime.Today;
        filterEndDate = DateTime.Today.AddDays(6);
        selectedFilterSlotId = 0;
        calendarDaysCount = 7;

        // Reset to default week
        DateTime today = DateTime.Today;
        int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
        startDate = today.AddDays(-1 * diff).Date;
        endDate = startDate.AddDays(6).Date;
        selectedDailyDate = DateTime.Today;

        currentPage = 1;
        await LoadAssignmentsAsync();
        CalculateStats();
        UpdatePageHeaderMetadata();
        StateHasChanged();
    }

    // Excel & PDF Exporters
    private void ExportData()
    {
        exportScope = "day";
        showExportModal = true;
    }

    private async Task GenerateAndDownloadCSV(string scope)
    {
        List<RosterAssignmentDTO> exportAssignments = new List<RosterAssignmentDTO>();
        List<DateTime> dates = new List<DateTime>();

        if (scope == "day")
        {
            dates.Add(selectedDailyDate);
            await LoadAssignmentsAsync();
            exportAssignments = assignments.Where(a => a.DutyDate.Date == selectedDailyDate.Date).ToList();
        }
        else if (scope == "week")
        {
            for (int i = 0; i < 7; i++)
            {
                dates.Add(startDate.AddDays(i));
            }
            await LoadAssignmentsAsync();
            exportAssignments = assignments;
        }
        else if (scope == "month")
        {
            DateTime monthStart = new DateTime(selectedDailyDate.Year, selectedDailyDate.Month, 1);
            DateTime monthEnd = monthStart.AddMonths(1).AddDays(-1);
            for (var d = monthStart; d <= monthEnd; d = d.AddDays(1))
            {
                dates.Add(d);
            }
            
            try
            {
                var result = await http.GetFromJsonAsync<List<RosterAssignmentDTO>>(
                    $"roster/assignments?startDate={monthStart:yyyy-MM-dd}&endDate={monthEnd:yyyy-MM-dd}"
                );
                if (result != null)
                {
                    exportAssignments = result;
                }
            }
            catch (Exception ex)
            {
                await DialogService.AlertAsync($"Error fetching month data: {ex.Message}");
                return;
            }
        }
        else if (scope == "custom")
        {
            if (exportStartDate > exportEndDate)
            {
                await DialogService.AlertAsync("Start date cannot be after end date.");
                return;
            }
            for (var d = exportStartDate.Date; d <= exportEndDate.Date; d = d.AddDays(1))
            {
                dates.Add(d);
            }
            
            try
            {
                var result = await http.GetFromJsonAsync<List<RosterAssignmentDTO>>(
                    $"roster/assignments?startDate={exportStartDate:yyyy-MM-dd}&endDate={exportEndDate:yyyy-MM-dd}"
                );
                if (result != null)
                {
                    exportAssignments = result;
                }
            }
            catch (Exception ex)
            {
                await DialogService.AlertAsync($"Error fetching custom range data: {ex.Message}");
                return;
            }
        }

        var csvBuilder = new System.Text.StringBuilder();
        csvBuilder.AppendLine("Rider ID,Rider Name,Date,Status,Shift Name,Start Time,End Time,Zone / Area");

        foreach (var rider in riderMasters)
        {
            foreach (var date in dates)
            {
                var assignment = exportAssignments.FirstOrDefault(a => a.RiderId == rider.RiderID && a.DutyDate.Date == date.Date);
                
                string riderId = $"RID{rider.RiderID:D8}";
                string riderName = EscapeCSVField(rider.Name);
                string dateStr = date.ToString("yyyy-MM-dd");
                
                if (assignment != null)
                {
                    string status = "Assigned";
                    string shiftName = EscapeCSVField(assignment.SlotName);
                    string startTime = FormatTimeSpan(assignment.StartTime);
                    string endTime = FormatTimeSpan(assignment.EndTime);
                    string zone = EscapeCSVField(assignment.Zone ?? "");
                    
                    csvBuilder.AppendLine($"{riderId},{riderName},{dateStr},{status},{shiftName},{startTime},{endTime},{zone}");
                }
                else
                {
                    csvBuilder.AppendLine($"{riderId},{riderName},{dateStr},Unassigned,---,---,---,---");
                }
            }
        }

        string filename = (scope == "custom") 
            ? $"Rido_Roster_custom_{exportStartDate:yyyyMMdd}_to_{exportEndDate:yyyyMMdd}.csv"
            : $"Rido_Roster_{scope}_{selectedDailyDate:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("DownloadFile", filename, "text/csv", csvBuilder.ToString());
        showExportModal = false;
    }

    private string EscapeCSVField(string field)
    {
        if (string.IsNullOrEmpty(field)) return "";
        if (field.Contains(",") || field.Contains("\"") || field.Contains("\n") || field.Contains("\r"))
        {
            return "\"" + field.Replace("\"", "\"\"") + "\"";
        }
        return field;
    }
