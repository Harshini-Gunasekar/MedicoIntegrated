@page "/Roster"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using TrackAdmin.Models
@using TrackAdmin.Data
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Syncfusion.Blazor.Popups

@inject HttpClient http
@inject IJSRuntime JS
@inject TenantState _tenantState
@inject ProtectedSessionStorage protectedSessionStore
@inject PageMetadataService Metadata
@inject SfDialogService DialogService

<PageTitle>Riders Duty Roster</PageTitle>

@if (!pageReady)
{
    <div class="premium-loader-container">
        <div class="tactical-loader-orb">
            <i class="bi bi-calendar-week pulse"></i>
            <div class="loader-glow"></div>
        </div>
        <div class="loader-text-wrap">
            <h4>RIDO ROSTER</h4>
            <span>Loading Duty Schedules...</span>
        </div>
    </div>
}
else
{
    <div class="roster-workspace animate-fade-in">
        <!-- Page Title Header -->
        <div class="page-header-row mb-4">
            <div class="header-left">
                <h1 class="page-title-main">Duty Roster</h1>
                <p class="page-subtitle-main">Manage and assign duty schedules for riders</p>
            </div>
            <div class="header-right">
                <div class="date-selector-container">
                    <input type="date" class="date-picker-custom" @bind="selectedDailyDate" @bind:after="OnDailyDateChanged" />
                </div>
                <button class="header-action-btn secondary @(isFilterActive ? "active-filter-btn" : "")" @onclick="ToggleFilters">
                    <i class="bi bi-funnel me-1"></i> Filters
                </button>
                <button class="header-action-btn primary" @onclick="OpenAssignModalFromHeader">
                    <i class="bi bi-plus-lg me-1"></i> Create Roster
                </button>
            </div>
        </div>

        @if (showFilters)
        {
            <div class="filters-panel p-3 mb-4 bg-white border rounded-3 shadow-sm animate-fade-in" style="border-radius: 16px !important; border-color: #e2e8f0 !important;">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-muted" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Start Date</label>
                        <input type="date" class="form-control form-control-custom" @bind="filterStartDate" style="height: 38px; font-size: 13px; border-radius: 8px;" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-muted" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">End Date</label>
                        <input type="date" class="form-control form-control-custom" @bind="filterEndDate" style="height: 38px; font-size: 13px; border-radius: 8px;" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-muted" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Shift / Slot</label>
                        <select class="form-select form-select-custom" @bind="selectedFilterSlotId" style="height: 38px; font-size: 13px; border-radius: 8px; border: 1px solid #e2e8f0; padding: 0 12px; outline: none; background: #fff; width: 100%;">
                            <option value="0">All Shifts</option>
                            <option value="-1">Unassigned</option>
                            @foreach (var slot in timeSlots)
                            {
                                <option value="@slot.SlotId">@slot.SlotName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button class="btn btn-primary w-50" style="height: 38px; border-radius: 8px; font-size: 13px; font-weight: 600; background-color: #2563eb; border-color: #2563eb; color: #fff;" @onclick="ApplyFilters">
                            Apply
                        </button>
                        <button class="btn btn-outline-secondary w-50" style="height: 38px; border-radius: 8px; font-size: 13px; font-weight: 600; background-color: #fff; border-color: #cbd5e1; color: #475569;" @onclick="ResetFilters">
                            Reset
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Dashboard Stat Cards Row -->
        <div class="row g-4 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="dashboard-stat-card clickable @(activeCardFilter == "All" ? "active" : "")" @onclick='() => SetCardFilter("All")'>
                    <div class="card-icon-wrap blue">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div class="card-info">
                        <span class="card-label">Total Riders</span>
                        <h2 class="card-value">@riderMasters.Count</h2>
                        <span class="card-trend text-blue">Active Riders</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="dashboard-stat-card clickable @(activeCardFilter == "Assigned" ? "active" : "")" @onclick='() => SetCardFilter("Assigned")'>
                    <div class="card-icon-wrap green">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="card-info">
                        <span class="card-label">@(isFilterActive ? "Assigned In Range" : "Assigned Today")</span>
                        <h2 class="card-value text-success">@assignedTodayCount</h2>
                        <span class="card-trend text-green">Riders on duty</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="dashboard-stat-card clickable @(activeCardFilter == "Unassigned" ? "active" : "")" @onclick='() => SetCardFilter("Unassigned")'>
                    <div class="card-icon-wrap purple">
                        <i class="bi bi-clipboard-x"></i>
                    </div>
                    <div class="card-info">
                        <span class="card-label">@(isFilterActive ? "Unassigned In Range" : "Unassigned")</span>
                        <h2 class="card-value text-danger">@unassignedTodayCount</h2>
                        <span class="card-trend text-purple">Riders off duty</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="dashboard-stat-card overview-card">
                    <div class="overview-header">
                        <span class="card-label font-weight-bold">Roster Overview</span>
                    </div>
                    <div class="overview-content">
                        <div class="pie-placeholder">
                            <svg class="progress-ring" width="48" height="48">
                                <circle class="progress-ring__circle" stroke="#e2e8f0" stroke-width="5" fill="transparent" r="18" cx="24" cy="24" />
                                <circle class="progress-ring__circle text-blue" stroke="#3b82f6" stroke-width="5" stroke-dasharray="113" stroke-dashoffset="@(113 - (113 * assignedTodayCount / Math.Max(1, riderMasters.Count)))" fill="transparent" r="18" cx="24" cy="24" stroke-linecap="round" />
                            </svg>
                        </div>
                        <div class="overview-legend">
                            <div class="legend-item">
                                <span class="legend-dot morning"></span>
                                <span class="legend-text">Morning: <strong>@morningShiftCount</strong></span>
                            </div>
                            <div class="legend-item">
                                <span class="legend-dot afternoon"></span>
                                <span class="legend-text">Afternoon: <strong>@afternoonShiftCount</strong></span>
                            </div>
                            <div class="legend-item">
                                <span class="legend-dot night"></span>
                                <span class="legend-text">Night: <strong>@nightShiftCount</strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search & Status Filter Row -->
        <div class="search-filter-row p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="search-wrapper">
                <div class="search-input-group">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" class="form-control-custom search-input" placeholder="Search rider name or ID..." @bind="searchQuery" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button class="search-clear-btn" @onclick='() => searchQuery = ""'><i class="bi bi-x-circle-fill"></i></button>
                    }
                </div>
            </div>
            <div class="status-filters-group">
                <span class="filter-label me-2">Status:</span>
                <button class="status-filter-pill @(activeStatusFilter == "All" ? "active" : "")" @onclick='() => SetStatusFilter("All")'>All</button>
                <button class="status-filter-pill @(activeStatusFilter == "Online" ? "active" : "")" @onclick='() => SetStatusFilter("Online")'>
                    <span class="status-indicator online"></span> Online
                </button>
                <button class="status-filter-pill @(activeStatusFilter == "Offline" ? "active" : "")" @onclick='() => SetStatusFilter("Offline")'>
                    <span class="status-indicator offline"></span> Offline
                </button>
                <button class="status-filter-pill @(activeStatusFilter == "Permission" ? "active" : "")" @onclick='() => SetStatusFilter("Permission")'>
                    <span class="status-indicator permission"></span> Permission
                </button>
                <button class="status-filter-pill @(activeStatusFilter == "On Hold" ? "active" : "")" @onclick='() => SetStatusFilter("On Hold")'>
                    <span class="status-indicator onhold"></span> On Hold
                </button>
                <button class="status-filter-pill @(activeStatusFilter == "Busy" ? "active" : "")" @onclick='() => SetStatusFilter("Busy")'>
                    <span class="status-indicator busy"></span> Busy / Engaged
                </button>
            </div>
        </div>

        <div class="roster-card-panel mb-5">
            <div class="panel-header">
                <h3 class="panel-title">Rider Duty Schedule</h3>
                <div class="panel-actions">
                    <div class="view-toggle-buttons">
                        <button class="view-btn @(currentView == RosterViewMode.Table ? "active" : "")" @onclick="() => SetViewMode(RosterViewMode.Table)">
                            <i class="bi bi-table me-1"></i> Table View
                        </button>
                        <button class="view-btn @(currentView == RosterViewMode.Calendar ? "active" : "")" @onclick="() => SetViewMode(RosterViewMode.Calendar)">
                            <i class="bi bi-calendar3 me-1"></i> Calendar View
                        </button>
                    </div>
                    <button class="panel-action-btn" @onclick="ExportData">
                        <i class="bi bi-download me-1"></i> Export
                    </button>
                </div>
            </div>

            @if (currentView == RosterViewMode.Table)
            {
                <!-- TABLE VIEW (Daily Operations View) -->
                <div class="table-responsive">
                    <table class="rido-table">
                        <thead>
                            <tr>
                                <th>Rider Details</th>
                                <th>Shift</th>
                                <th>Duty Time</th>
                                <th>Zone / Area</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!paginatedRiders.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-people-fill display-6 mb-3 d-block text-secondary"></i>
                                        <h5>No riders found for selected date</h5>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var rider in paginatedRiders)
                                {
                                    var assignment = GetAssignmentForRiderAndDate(rider.RiderID, selectedDailyDate);
                                    <tr>
                                        <td>
                                            <div class="rider-table-profile">
                                                <div class="rider-avatar-wrap">
                                                    <img src="@GetRiderProfileImageLink(rider.RiderID)" 
                                                         class="rider-profile-img" 
                                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                                    <div class="rider-profile-avatar" style="display: none;">
                                                        @rider.Name[0]
                                                    </div>
                                                </div>
                                                <div class="rider-profile-details">
                                                    <span class="rider-name">@rider.Name</span>
                                                    <span class="rider-id">RID@(rider.RiderID.ToString("D8"))</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (assignment != null)
                                            {
                                                <span class="shift-badge-pill" style="--shift-color: @assignment.ColorHex; background-color: @(assignment.ColorHex + "15"); color: @assignment.ColorHex">
                                                    @if (assignment.SlotName.Contains("Morning", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <i class="bi bi-brightness-high-fill me-1"></i>
                                                    }
                                                    else if (assignment.SlotName.Contains("Afternoon", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <i class="bi bi-cloud-sun-fill me-1"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-moon-stars-fill me-1"></i>
                                                    }
                                                    @assignment.SlotName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">--</span>
                                            }
                                        </td>
                                        <td>
                                            @if (assignment != null)
                                            {
                                                <div class="duty-time-container">
                                                    <span class="duty-time-range">@FormatTimeSpan(assignment.StartTime) - @FormatTimeSpan(assignment.EndTime)</span>
                                                    <span class="duty-duration">@CalculateHours(assignment.StartTime, assignment.EndTime) Hrs</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">--</span>
                                            }
                                        </td>
                                        <td>
                                            @if (assignment != null && !string.IsNullOrWhiteSpace(assignment.Zone))
                                            {
                                                <span class="zone-badge">
                                                    <i class="bi bi-geo-alt-fill me-1 text-danger"></i> @assignment.Zone
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">--</span>
                                            }
                                        </td>
                                        <td>
                                            @if (assignment != null)
                                            {
                                                <span class="status-badge-pill success">
                                                    <span class="status-dot"></span> Assigned
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge-pill warning">
                                                    <span class="status-dot"></span> Unassigned
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (assignment == null)
                                            {
                                                <button class="assign-action-btn" @onclick="() => OpenAssignModal(rider.RiderID, selectedDailyDate)">
                                                    <i class="bi bi-plus-lg me-1"></i> Assign
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="action-buttons-group">
                                                    <button class="list-action-btn edit" @onclick="() => OpenAssignModal(rider.RiderID, selectedDailyDate)" title="Edit Shift">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="list-action-btn delete" @onclick="() => DeleteAssignment(assignment.AssignmentId)" title="Delete Shift">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                <div class="table-pagination-footer">
                    <span class="pagination-info">Showing @(PageStart + 1) to @(Math.Min(PageEnd, filteredRiders.Count())) of @filteredRiders.Count() riders</span>
                    
                    <div class="pagination-controls">
                        <button class="pager-btn" disabled="@(!HasPrevPage)" @onclick="PrevPage"><i class="bi bi-chevron-left"></i></button>
                        @for (int pageIdx = 1; pageIdx <= TotalPages; pageIdx++)
                        {
                            var currentIdx = pageIdx;
                            <button class="pager-btn @(currentIdx == currentPage ? "active" : "")" @onclick="() => GoToPage(currentIdx)">@currentIdx</button>
                        }
                        <button class="pager-btn" disabled="@(!HasNextPage)" @onclick="NextPage"><i class="bi bi-chevron-right"></i></button>
                    </div>

                    <div class="page-size-selector">
                        <select class="form-select-custom size-select" @bind="pageSize">
                            <option value="5">5 / page</option>
                            <option value="10">10 / page</option>
                            <option value="20">20 / page</option>
                        </select>
                    </div>
                </div>
            }
            else
            {
                <!-- CALENDAR VIEW (Weekly Rotation Scheduler) -->
                <div class="calendar-view-toolbar p-3 border-bottom d-flex justify-content-between align-items-center">
                    <div class="week-nav-group">
                        <button class="nav-btn-week" @onclick="NavigateToPreviousWeek"><i class="bi bi-chevron-left"></i></button>
                        <button class="nav-btn-week today" @onclick="NavigateToCurrentWeek">Today</button>
                        <button class="nav-btn-week" @onclick="NavigateToNextWeek"><i class="bi bi-chevron-right"></i></button>
                        <span class="week-label ms-3">
                            @startDate.ToString("MMM dd") &mdash; @endDate.ToString("MMM dd, yyyy")
                        </span>
                    </div>
                    <div class="weekly-actions">
                        <button class="action-btn config-btn" @onclick="OpenTimeSlotsManager">
                            <i class="bi bi-alarm-fill text-cyan"></i> Config Slots
                        </button>
                        <button class="action-btn config-btn" @onclick="OpenDutyTypesManager">
                            <i class="bi bi-tags-fill text-pink"></i> Config Duties
                        </button>
                        <button class="action-btn config-btn" @onclick="OpenBulkCopyModal">
                            <i class="bi bi-arrow-repeat text-indigo"></i> Repeat Schedule
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="roster-calendar-table" id="roster-schedule-table">
                        <thead>
                            <tr>
                                <th class="rider-header-col">Riders Fleet</th>
                                @for (int i = 0; i < calendarDaysCount; i++)
                                {
                                    var dayDate = startDate.AddDays(i);
                                    <th class="day-header-col @(dayDate.Date == DateTime.Today ? "is-today" : "")">
                                        <div class="day-title">@dayDate.ToString("ddd")</div>
                                        <div class="day-number">@dayDate.ToString("dd")</div>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rider in paginatedRiders)
                            {
                                <tr>
                                    <td class="rider-info-cell">
                                        <div class="rider-card-wrap">
                                            <div class="rider-avatar-wrap">
                                                <img src="@GetRiderProfileImageLink(rider.RiderID)" 
                                                     class="rider-profile-img" 
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                                <div class="rider-avatar" style="display: none;">
                                                    @rider.Name[0]
                                                </div>
                                            </div>
                                            <div class="rider-details">
                                                <div class="rider-name">@rider.Name</div>
                                                <div class="rider-code">ID: @rider.RiderID</div>
                                            </div>
                                            <button class="copy-week-btn" @onclick="() => OpenCopyWeekModal(rider.RiderID, rider.Name)" title="Copy Schedule">
                                                <i class="bi bi-copy"></i>
                                            </button>
                                        </div>
                                    </td>
                                    @for (int i = 0; i < calendarDaysCount; i++)
                                    {
                                        var dayDate = startDate.AddDays(i);
                                        var assignment = GetAssignmentForRiderAndDate(rider.RiderID, dayDate);

                                        <td class="schedule-cell @(dayDate.Date == DateTime.Today ? "is-today" : "")">
                                            @if (assignment != null)
                                            {
                                                <div class="assignment-card" style="border-left-color: @assignment.ColorHex">
                                                    <div class="assignment-details">
                                                        <span class="slot-name">@assignment.SlotName</span>
                                                        <span class="zone-text" title="@assignment.Zone"><i class="bi bi-geo-alt-fill text-danger text-xs"></i> @(string.IsNullOrWhiteSpace(assignment.Zone) ? "No Zone" : assignment.Zone)</span>
                                                    </div>
                                                    <div class="assignment-actions">
                                                        <button class="cell-action-btn edit" @onclick="() => OpenAssignModal(rider.RiderID, dayDate)" title="Edit Shift">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="cell-action-btn swap" @onclick="() => OpenSwapModal(rider.RiderID, dayDate)" title="Swap Shift">
                                                            <i class="bi bi-arrow-left-right"></i>
                                                        </button>
                                                        <button class="cell-action-btn delete" @onclick="() => DeleteAssignment(assignment.AssignmentId)" title="Delete Assignment">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="yet-to-assign-container">
                                                    <span class="yet-to-assign-text">Yet to assign</span>
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                <div class="table-pagination-footer">
                    <span class="pagination-info">Showing @(PageStart + 1) to @(Math.Min(PageEnd, filteredRiders.Count())) of @filteredRiders.Count() riders</span>
                    
                    <div class="pagination-controls">
                        <button class="pager-btn" disabled="@(!HasPrevPage)" @onclick="PrevPage"><i class="bi bi-chevron-left"></i></button>
                        @for (int pageIdx = 1; pageIdx <= TotalPages; pageIdx++)
                        {
                            var currentIdx = pageIdx;
                            <button class="pager-btn @(currentIdx == currentPage ? "active" : "")" @onclick="() => GoToPage(currentIdx)">@currentIdx</button>
                        }
                        <button class="pager-btn" disabled="@(!HasNextPage)" @onclick="NextPage"><i class="bi bi-chevron-right"></i></button>
                    </div>

                    <div class="page-size-selector">
                        <select class="form-select-custom size-select" @bind="pageSize">
                            <option value="5">5 / page</option>
                            <option value="10">10 / page</option>
                            <option value="20">20 / page</option>
                        </select>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Modals & Dialogs (Sleek light design matching user screenshot) -->

<!-- 1. Assignment Modal -->
<SfDialog Width="980px" ShowCloseIcon="false" IsModal="true" @bind-Visible="showAssignModal" CssClass="light-roster-dialog">
    <DialogTemplates>
        <Header>
            <div class="dialog-header-custom">
                <div class="dialog-header-title">
                    <i class="bi bi-calendar-plus me-2 text-primary"></i> @(isHeaderCreate ? "Create Roster Assignment" : "Edit Roster Shift")
                </div>
                <button class="dlg-close-btn" @onclick="() => showAssignModal = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </Header>
        <Content>
            <div class="dialog-form container-fluid px-0">
                <!-- Action Mode at the top (full width) -->
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label fw-bold d-block mb-2">Action Mode</label>
                        <div class="segmented-control">
                            <button type="button" class="segmented-btn @(dialogActionType == "Assign" ? "active" : "")" @onclick='() => dialogActionType = "Assign"'>
                                <i class="bi bi-calendar-plus me-1"></i> Assign Shift
                            </button>
                            <button type="button" class="segmented-btn danger @(dialogActionType == "Clear" ? "active" : "")" @onclick='() => dialogActionType = "Clear"'>
                                <i class="bi bi-calendar-minus me-1"></i> Clear Shift
                            </button>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <!-- Left Column: Yet to Select Riders -->
                    <div class="col-md-3 d-flex flex-column border-end" style="height: 425px; padding-right: 15px;">
                        @if (isHeaderCreate)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-slate" style="font-size: 13px;">Yet to Select (@(riderMasters.Count - selectedBulkRiderIds.Count))</span>
                                <button type="button" class="btn btn-link text-xs p-0 text-primary text-decoration-none" style="font-size: 11px;" @onclick="SelectAllBulkRiders">Select All</button>
                            </div>
                            <div class="multi-select-container flex-grow-1 border rounded p-2" style="overflow-y: auto; background-color: #f8fafc; height: 385px;">
                                @foreach (var rider in riderMasters.Where(r => !selectedBulkRiderIds.Contains(r.RiderID)))
                                {
                                    <div @key="rider.RiderID" class="form-check d-flex align-items-center gap-2 mb-1 py-1 px-2 rounded hover-bg-light">
                                        <input type="checkbox" class="form-checkbox-custom" id="bulk-rider-yet-@rider.RiderID" 
                                               checked="@false"
                                               @onchange='(e) => ToggleBulkRider(rider.RiderID, true)' />
                                        <label class="form-check-label text-sm cursor-pointer flex-grow-1 mb-0" for="bulk-rider-yet-@rider.RiderID" style="font-size: 12px; color: #334155;">
                                            @rider.Name
                                        </label>
                                    </div>
                                }
                                @if (riderMasters.Count - selectedBulkRiderIds.Count == 0)
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100 text-muted" style="font-size: 11.5px; min-height: 150px;">
                                        All riders selected
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="form-info-banner mb-3">
                                <div class="banner-label">RIDER</div>
                                <div class="banner-value">@selectedRiderName</div>

                                <div class="banner-label mt-2">DATE</div>
                                <div class="banner-value text-primary">@selectedDate.ToString("dddd, MMMM dd, yyyy")</div>
                            </div>
                        }
                    </div>

                    <!-- Middle Column: Selected Riders -->
                    <div class="col-md-3 d-flex flex-column border-end" style="height: 425px; padding-left: 15px; padding-right: 15px;">
                        @if (isHeaderCreate)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-success" style="font-size: 13px;">Selected (@selectedBulkRiderIds.Count)</span>
                                @if (selectedBulkRiderIds.Any())
                                {
                                    <button type="button" class="btn btn-link text-xs p-0 text-danger text-decoration-none" style="font-size: 11px;" @onclick="ClearAllBulkRiders">Clear All</button>
                                }
                            </div>
                            <div class="multi-select-container flex-grow-1 border rounded p-2" style="overflow-y: auto; background-color: #f0fdf4; border-color: #bbf7d0 !important; height: 385px;">
                                @foreach (var rider in riderMasters.Where(r => selectedBulkRiderIds.Contains(r.RiderID)))
                                {
                                    <div @key="rider.RiderID" class="form-check d-flex align-items-center gap-2 mb-1 py-1 px-2 rounded hover-bg-light">
                                        <input type="checkbox" class="form-checkbox-custom" id="bulk-rider-sel-@rider.RiderID" 
                                               checked="@true"
                                               @onchange='(e) => ToggleBulkRider(rider.RiderID, false)' />
                                        <label class="form-check-label text-sm cursor-pointer flex-grow-1 mb-0" for="bulk-rider-sel-@rider.RiderID" style="font-size: 12px; color: #065f46; font-weight: 600;">
                                            @rider.Name
                                        </label>
                                    </div>
                                }
                                @if (!selectedBulkRiderIds.Any())
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100 text-muted" style="font-size: 11.5px; min-height: 150px;">
                                        No riders selected
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted text-center py-5" style="font-size: 12px;">
                                Single-rider mode
                            </div>
                        }
                    </div>

                    <!-- Right Column: Date Selection & Details -->
                    <div class="col-md-6 d-flex flex-column" style="height: 425px; padding-left: 15px;">
                        @if (isHeaderCreate)
                        {
                            <div class="calendar-select-title-row d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-slate" style="font-size: 13px;">Select Dates</span>
                                <div class="select-links">
                                    <button type="button" class="btn btn-link text-xs p-0 text-primary me-2 text-decoration-none" style="font-size: 11px;" @onclick="SelectCalendarWeekdays">Weekdays</button>
                                    <button type="button" class="btn btn-link text-xs p-0 text-primary me-2 text-decoration-none" style="font-size: 11px;" @onclick="SelectCalendarWeekends">Weekends</button>
                                    <button type="button" class="btn btn-link text-xs p-0 text-primary me-2 text-decoration-none" style="font-size: 11px;" @onclick="SelectCalendarAll">All</button>
                                    <button type="button" class="btn btn-link text-xs p-0 text-muted text-decoration-none" style="font-size: 11px;" @onclick="ClearCalendarAll">Clear</button>
                                </div>
                            </div>

                            <!-- Mini Calendar Container -->
                            <div class="mini-calendar-wrapper p-1.5 border rounded mb-2 bg-white" style="user-select: none;" @onmouseup="EndDateDrag">
                                <div class="calendar-nav-row d-flex justify-content-between align-items-center mb-1" style="height: 24px;">
                                    <button type="button" class="btn btn-sm btn-icon-round" style="width: 22px; height: 22px;" @onclick="PrevCalendarMonth">
                                        <i class="bi bi-chevron-left" style="font-size: 10px;"></i>
                                    </button>
                                    <span class="calendar-month-label fw-bold" style="font-size: 11.5px;">@calendarMonth.ToString("MMMM yyyy")</span>
                                    <button type="button" class="btn btn-sm btn-icon-round" style="width: 22px; height: 22px;" @onclick="NextCalendarMonth">
                                        <i class="bi bi-chevron-right" style="font-size: 10px;"></i>
                                    </button>
                                </div>
                                
                                <div class="calendar-grid-header d-grid text-center mb-0.5">
                                    <span class="grid-day-name">M</span>
                                    <span class="grid-day-name">T</span>
                                    <span class="grid-day-name">W</span>
                                    <span class="grid-day-name">T</span>
                                    <span class="grid-day-name">F</span>
                                    <span class="grid-day-name text-danger">S</span>
                                    <span class="grid-day-name text-danger">S</span>
                                </div>
                                
                                <div class="calendar-grid-body d-grid">
                                    @foreach (var dateVal in GetCalendarGridDates())
                                    {
                                        @if (dateVal.HasValue)
                                        {
                                            var currDate = dateVal.Value;
                                            var isSelected = selectedBulkDates.Contains(currDate);
                                            var isWeekend = currDate.DayOfWeek == DayOfWeek.Saturday || currDate.DayOfWeek == DayOfWeek.Sunday;
                                            
                                            <div class="calendar-grid-cell @(isSelected ? "selected" : "") @(isWeekend ? "weekend" : "")"
                                                 @onmousedown="() => StartDateDrag(currDate)"
                                                 @onmouseenter="() => EnterDateDrag(currDate)">
                                                @currDate.Day
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="calendar-grid-cell empty"></div>
                                        }
                                    }
                                </div>
                            </div>
                        }

                        @if (dialogActionType == "Assign")
                        {
                            <div class="row g-2 mb-1">
                                <div class="col-6">
                                    <label class="form-label text-xs fw-bold mb-1" style="font-size: 11px; margin-bottom: 2px;">Time Slot</label>
                                    <select class="form-select-custom" style="padding: 5px 8px; font-size: 12px; border-radius: 6px;" @bind="selectedSlotId">
                                        <option value="0">-- Select Shift --</option>
                                        @foreach (var slot in timeSlots)
                                        {
                                            <option value="@slot.SlotId">@slot.SlotName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-xs fw-bold mb-1" style="font-size: 11px; margin-bottom: 2px;">Duty Type</label>
                                    <select class="form-select-custom" style="padding: 5px 8px; font-size: 12px; border-radius: 6px;" @bind="selectedDutyTypeId">
                                        <option value="0">-- Select Category --</option>
                                        @foreach (var type in dutyTypes)
                                        {
                                            <option value="@type.DutyTypeId">@type.TypeName</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="form-group mb-2">
                                <label class="form-label text-xs fw-bold mb-1" style="font-size: 11px; margin-bottom: 2px;">Zone / Area Name</label>
                                <input type="text" class="form-control-custom" style="padding: 5px 8px; font-size: 12px; border-radius: 6px;" placeholder="e.g. Anna Nagar, Guindy" @bind="selectedZone" list="zone-list" />
                                <datalist id="zone-list">
                                    <option value="Anna Nagar" />
                                    <option value="Guindy" />
                                    <option value="T. Nagar" />
                                    <option value="Adyar" />
                                    <option value="Velachery" />
                                    <option value="Nungambakkam" />
                                    <option value="Mylapore" />
                                    <option value="Tambaram" />
                                    <option value="Koyambedu" />
                                    <option value="OMR" />
                                    <option value="ECR" />
                                    <option value="Porur" />
                                    <option value="Chromepet" />
                                </datalist>
                            </div>
                        }

                        <div class="dialog-actions-row mt-auto pt-2 border-top" style="margin-top: 5px;">
                            <button class="btn-cancel" style="padding: 6px 12px; font-size: 12px; border-radius: 6px;" @onclick="() => showAssignModal = false">Cancel</button>
                            <button class="@(dialogActionType == "Assign" ? "btn-save" : "btn-save bg-danger border-0")" style="padding: 6px 12px; font-size: 12px; border-radius: 6px;" @onclick="SaveAssignment">
                                @(dialogActionType == "Assign" ? "Save Assignment" : "Clear Assignments")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<!-- Repeat Schedule (Bulk Copy) Modal -->
<SfDialog Width="440px" ShowCloseIcon="false" IsModal="true" @bind-Visible="showBulkCopyModal" CssClass="light-roster-dialog">
    <DialogTemplates>
        <Header>
            <div class="dialog-header-custom">
                <div class="dialog-header-title">
                    <i class="bi bi-arrow-repeat me-2 text-indigo"></i> Repeat Past Schedule
                </div>
                <button class="dlg-close-btn" @onclick="() => showBulkCopyModal = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </Header>
        <Content>
            <div class="dialog-form">
                <div class="alert alert-info-custom mb-3 py-2 px-3" style="font-size: 12.5px; border-radius: 8px;">
                    <i class="bi bi-info-circle-fill me-2 text-indigo"></i>
                    Duplicate shift schedules from a past period. Existing target assignments will be replaced.
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Replication Period Type</label>
                    <select class="form-select-custom" @bind="bulkCopyType">
                        <option value="Week">Week-to-Week (7 Days)</option>
                        <option value="Month">Month-to-Month (Full Calendar Month)</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Source Period Start Date</label>
                    <input type="date" class="form-control-custom" value="@bulkCopySourceStart.ToString("yyyy-MM-dd")" @onchange='(e) => { if (DateTime.TryParse(e.Value?.ToString(), out var dt)) bulkCopySourceStart = dt; }' />
                    <small class="form-text text-muted" style="font-size: 11px; display: block; margin-top: 4px;">
                        @(bulkCopyType == "Week" ? "Choose the Monday starting the source week." : "Choose any date within the source month.")
                    </small>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label">Target Period Start Date</label>
                    <input type="date" class="form-control-custom" value="@bulkCopyTargetStart.ToString("yyyy-MM-dd")" @onchange='(e) => { if (DateTime.TryParse(e.Value?.ToString(), out var dt)) bulkCopyTargetStart = dt; }' />
                    <small class="form-text text-muted" style="font-size: 11px; display: block; margin-top: 4px;">
                        @(bulkCopyType == "Week" ? "Choose the Monday starting the destination week." : "Choose any date within the destination month.")
                    </small>
                </div>

                <div class="dialog-actions-row">
                    <button class="btn-cancel" @onclick="() => showBulkCopyModal = false">Cancel</button>
                    <button class="btn-save bg-indigo text-white border-0" @onclick="ExecuteBulkCopy">
                        <i class="bi bi-check-lg me-1"></i> Copy Schedule
                    </button>
                </div>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<!-- 2. Swap Shift Modal -->
<SfDialog Width="400px" ShowCloseIcon="false" IsModal="true" @bind-Visible="showSwapModal" CssClass="light-roster-dialog">
    <DialogTemplates>
        <Header>
            <div class="dialog-header-custom">
                <div class="dialog-header-title">
                    <i class="bi bi-arrow-left-right me-2 text-warning"></i> Swap Rider Shift
                </div>
                <button class="dlg-close-btn" @onclick="() => showSwapModal = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </Header>
        <Content>
            <div class="dialog-form">
                <div class="form-info-banner mb-3">
                    <div class="banner-label">DATE</div>
                    <div class="banner-value">@selectedDate.ToString("dddd, MMMM dd, yyyy")</div>
                    <div class="banner-label mt-2">RIDER A (CURRENT SHIFT)</div>
                    <div class="banner-value">@selectedRiderName</div>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label">Select Rider B to Swap with</label>
                    <select class="form-select-custom" @bind="swapTargetRiderId">
                        <option value="0">-- Select Target Rider --</option>
                        @foreach (var rider in riderMasters.Where(r => r.RiderID != selectedRiderId))
                        {
                            <option value="@rider.RiderID">@rider.Name (ID: @rider.RiderID)</option>
                        }
                    </select>
                </div>

                <div class="dialog-actions-row">
                    <button class="btn-cancel" @onclick="() => showSwapModal = false">Cancel</button>
                    <button class="btn-save swap" @onclick="ExecuteShiftSwap">Execute Swap</button>
                </div>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<!-- 3. Copy Week Modal -->
<SfDialog Width="430px" ShowCloseIcon="false" IsModal="true" @bind-Visible="showCopyModal" CssClass="light-roster-dialog">
    <DialogTemplates>
        <Header>
            <div class="dialog-header-custom">
                <div class="dialog-header-title">
                    <i class="bi bi-copy me-2 text-primary"></i> Copy Weekly Roster
                </div>
                <button class="dlg-close-btn" @onclick="() => showCopyModal = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </Header>
        <Content>
            <div class="dialog-form">
                <div class="form-info-banner mb-3">
                    <div class="banner-label">SOURCE RIDER</div>
                    <div class="banner-value">@selectedRiderName</div>
                    <div class="banner-label mt-2">SOURCE WEEK</div>
                    <div class="banner-value">@startDate.ToString("MMM dd") &mdash; @endDate.ToString("MMM dd, yyyy")</div>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Copy Schedule To</label>
                    <select class="form-select-custom" @bind="copyTargetRiderId">
                        <option value="0">-- Select Target Rider (or Self) --</option>
                        @foreach (var rider in riderMasters)
                        {
                            <option value="@rider.RiderID">@rider.Name (ID: @rider.RiderID)</option>
                        }
                    </select>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label">Target Week Start Date</label>
                    <input type="date" class="form-control-custom" @bind="copyTargetWeekStart" />
                </div>

                <div class="dialog-actions-row">
                    <button class="btn-cancel" @onclick="() => showCopyModal = false">Cancel</button>
                    <button class="btn-save" @onclick="ExecuteWeekCopy">Apply Schedule</button>
                </div>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<!-- 4. Time Slots Manager Modal -->
<SfDialog Width="580px" ShowCloseIcon="false" IsModal="true" @bind-Visible="showTimeSlotsModal" CssClass="light-roster-dialog">
    <DialogTemplates>
        <Header>
            <div class="dialog-header-custom">
                <div class="dialog-header-title">
                    <i class="bi bi-alarm-fill me-2 text-primary"></i> Time Slots Manager
                </div>
                <button class="dlg-close-btn" @onclick="() => showTimeSlotsModal = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </Header>
        <Content>
            <div class="dialog-form">
                <div class="sub-form mb-4">
                    <div class="sub-form-title">Create / Edit Time Slot</div>
                    <div class="row g-2">
                        <div class="col-sm-5">
                            <input type="text" class="form-control-custom" placeholder="Shift Name (e.g. Morning Shift)" @bind="newSlotName" />
                        </div>
                        <div class="col-sm-3">
                            <input type="time" class="form-control-custom" @bind="newSlotStartTime" />
                        </div>
                        <div class="col-sm-3">
                            <input type="time" class="form-control-custom" @bind="newSlotEndTime" />
                        </div>
                        <div class="col-sm-1">
                            <button class="btn-action-add" @onclick="SaveTimeSlot">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="items-list-wrap">
                    <table class="items-list-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Start</th>
                                <th>End</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var slot in timeSlots)
                            {
                                <tr>
                                    <td class="fw-bold">@slot.SlotName</td>
                                    <td>@FormatTimeSpan(slot.StartTime)</td>
                                    <td>@FormatTimeSpan(slot.EndTime)</td>
                                    <td class="text-end">
                                        <button class="list-action-btn edit" @onclick="() => EditTimeSlot(slot)"><i class="bi bi-pencil"></i></button>
                                        <button class="list-action-btn delete" @onclick="() => DeleteTimeSlot(slot.SlotId)"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<!-- 5. Duty Types Manager Modal -->
<SfDialog Width="580px" ShowCloseIcon="false" IsModal="true" @bind-Visible="showDutyTypesModal" CssClass="light-roster-dialog">
    <DialogTemplates>
        <Header>
            <div class="dialog-header-custom">
                <div class="dialog-header-title">
                    <i class="bi bi-tags-fill me-2 text-primary"></i> Duty Categories
                </div>
                <button class="dlg-close-btn" @onclick="() => showDutyTypesModal = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </Header>
        <Content>
            <div class="dialog-form">
                <div class="sub-form mb-4">
                    <div class="sub-form-title">Create / Edit Duty Category</div>
                    <div class="row g-2 align-items-center">
                        <div class="col-sm-7">
                            <input type="text" class="form-control-custom" placeholder="Duty Category Name" @bind="newTypeName" />
                        </div>
                        <div class="col-sm-3 d-flex align-items-center gap-2">
                            <label class="form-label mb-0 text-nowrap">Color:</label>
                            <input type="color" class="form-control-color-custom" @bind="newColorHex" />
                        </div>
                        <div class="col-sm-2">
                            <button class="btn-action-add w-100" @onclick="SaveDutyType">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="items-list-wrap">
                    <table class="items-list-table">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Color Tag</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var type in dutyTypes)
                            {
                                <tr>
                                    <td class="fw-bold">@type.TypeName</td>
                                    <td>
                                        <span class="color-preview-badge" style="background-color: @type.ColorHex">
                                            @type.ColorHex
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="list-action-btn edit" @onclick="() => EditDutyType(type)"><i class="bi bi-pencil"></i></button>
                                        <button class="list-action-btn delete" @onclick="() => DeleteDutyType(type.DutyTypeId)"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
