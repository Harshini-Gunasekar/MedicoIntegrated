    // Computed Properties for Pagination
    private IEnumerable<Rider_Master> filteredRiders
    {
        get
        {
            var query = riderMasters.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                query = query.Where(r => r.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || 
                                         r.RiderID.ToString().Contains(searchQuery) ||
                                         (r.ShortName != null && r.ShortName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)));
            }

            if (activeCardFilter == "Assigned")
            {
                query = query.Where(r => assignments.Any(a => a.RiderId == r.RiderID && a.DutyDate.Date == selectedDailyDate.Date));
            }
            else if (activeCardFilter == "Unassigned")
            {
                query = query.Where(r => !assignments.Any(a => a.RiderId == r.RiderID && a.DutyDate.Date == selectedDailyDate.Date));
            }

            if (selectedFilterSlotId > 0)
            {
                if (currentView == RosterViewMode.Table)
                {
                    query = query.Where(r => assignments.Any(a => a.RiderId == r.RiderID && a.DutyDate.Date == selectedDailyDate.Date && a.SlotId == selectedFilterSlotId));
                }
                else
                {
                    query = query.Where(r => assignments.Any(a => a.RiderId == r.RiderID && a.DutyDate.Date >= startDate.Date && a.DutyDate.Date <= endDate.Date && a.SlotId == selectedFilterSlotId));
                }
            }
            else if (selectedFilterSlotId == -1) // Unassigned
            {
                if (currentView == RosterViewMode.Table)
                {
                    query = query.Where(r => !assignments.Any(a => a.RiderId == r.RiderID && a.DutyDate.Date == selectedDailyDate.Date));
                }
                else
                {
                    query = query.Where(r => {
                        for (int i = 0; i < calendarDaysCount; i++)
                        {
                            var dayDate = startDate.AddDays(i);
                            if (!assignments.Any(a => a.RiderId == r.RiderID && a.DutyDate.Date == dayDate.Date))
                            {
                                return true;
                            }
                        }
                        return false;
                    });
                }
            }

            if (activeStatusFilter != "All")
            {
                query = query.Where(r => {
                    var status = (r.CurrentStatus ?? r.Status ?? "Offline").Trim().ToLower();
                    return activeStatusFilter.ToLower() switch
                    {
                        "online" => status == "online" || status == "active" || status == "available",
                        "offline" => status == "offline",
                        "permission" => status == "permission",
                        "on hold" => status == "on hold" || status == "onhold",
                        "busy" => status == "busy" || status == "engaged",
                        "engaged" => status == "engaged" || status == "busy",
                        _ => true
                    };
                });
            }

            return query.ToList();
        }
    }

