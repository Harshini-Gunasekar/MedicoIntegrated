    .roster-calendar-table .assignment-details {
        display: flex;
        flex-direction: column;
        gap: 2px;
        overflow: hidden;
    }

    .roster-calendar-table .slot-name {
        font-size: 11.5px;
        font-weight: 700;
        color: #1e293b;
