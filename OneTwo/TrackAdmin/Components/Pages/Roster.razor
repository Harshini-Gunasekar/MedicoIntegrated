    private void CalculateStats()
    {
        if (isFilterActive)
        {
            var uniqueRidersAssigned = assignments
                .Where(a => a.DutyDate.Date >= startDate.Date && a.DutyDate.Date <= endDate.Date)
                .Select(a => a.RiderId)
                .Distinct()
                .Count();
            assignedTodayCount = uniqueRidersAssigned;
            unassignedTodayCount = Math.Max(0, riderMasters.Count - assignedTodayCount);

            morningShiftCount = assignments.Count(a => a.DutyDate.Date >= startDate.Date && a.DutyDate.Date <= endDate.Date && a.SlotName.Contains("Morning", StringComparison.OrdinalIgnoreCase));
            afternoonShiftCount = assignments.Count(a => a.DutyDate.Date >= startDate.Date && a.DutyDate.Date <= endDate.Date && a.SlotName.Contains("Afternoon", StringComparison.OrdinalIgnoreCase));
            nightShiftCount = assignments.Count(a => a.DutyDate.Date >= startDate.Date && a.DutyDate.Date <= endDate.Date && a.SlotName.Contains("Night", StringComparison.OrdinalIgnoreCase));
        }
        else
        {
            assignedTodayCount = assignments.Count(a => a.DutyDate.Date == selectedDailyDate.Date);
            unassignedTodayCount = Math.Max(0, riderMasters.Count - assignedTodayCount);

            morningShiftCount = assignments.Count(a => a.DutyDate.Date == selectedDailyDate.Date && a.SlotName.Contains("Morning", StringComparison.OrdinalIgnoreCase));
            afternoonShiftCount = assignments.Count(a => a.DutyDate.Date == selectedDailyDate.Date && a.SlotName.Contains("Afternoon", StringComparison.OrdinalIgnoreCase));
            nightShiftCount = assignments.Count(a => a.DutyDate.Date == selectedDailyDate.Date && a.SlotName.Contains("Night", StringComparison.OrdinalIgnoreCase));
        }
    }

