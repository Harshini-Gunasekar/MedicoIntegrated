        border-right: 2px solid #cbd5e1;
    }

    .rider-card-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .rider-card-wrap .rider-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
