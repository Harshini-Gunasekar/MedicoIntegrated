    private void EditTimeSlot(RosterTimeSlot slot)
    {
        editingSlotId = slot.SlotId;
        newSlotName = slot.SlotName;
        newSlotStartTime = DateTime.Today.Add(slot.StartTime);
        newSlotEndTime = DateTime.Today.Add(slot.EndTime);
    }

    private async Task SaveTimeSlot()
    {
        if (string.IsNullOrWhiteSpace(newSlotName))
        {
            await DialogService.AlertAsync("Please enter a valid shift name.");
            return;
        }

        var slot = new RosterTimeSlot
        {
            SlotId = editingSlotId,
            SlotName = newSlotName,
            StartTime = newSlotStartTime.TimeOfDay,
            EndTime = newSlotEndTime.TimeOfDay
        };

        try
        {
            var response = await http.PostAsJsonAsync("roster/slots", slot);
            if (response.IsSuccessStatusCode)
            {
                editingSlotId = 0;
                newSlotName = "";
                await LoadRosterConfigurationsAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error saving slot: " + ex.Message);
        }
    }

    private async Task DeleteTimeSlot(int slotId)
    {
        bool confirm = await DialogService.ConfirmAsync("Deleting this slot will also remove all scheduled assignments associated with it. Continue?", "Confirm Delete Slot");
        if (!confirm) return;

        try
        {
            var response = await http.DeleteAsync($"roster/slots/{slotId}");
            if (response.IsSuccessStatusCode)
            {
                await LoadRosterConfigurationsAsync();
                await LoadAssignmentsAsync();
                CalculateStats();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error deleting slot: " + ex.Message);
        }
    }

