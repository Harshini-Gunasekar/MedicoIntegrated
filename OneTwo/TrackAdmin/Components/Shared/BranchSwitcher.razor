@using TrackAdmin.Data
@using SharedComponents.Rcl.Models
@using Syncfusion.Blazor.DropDowns

@inject TenantService TenantService
@inject TenantState State

<div class="branch-switcher-container">
    <i class="bi bi-geo-alt-fill branch-icon"></i>
    <SfDropDownList TValue="int?" TItem="BranchMaster" 
                    DataSource="@branches" 
                    @bind-Value="@State.SelectedBranchCode"
                    Placeholder="Select Branch"
                    CssClass="branch-dropdown"
                    Width="180px">
        <DropDownListEvents TValue="int?" TItem="BranchMaster" ValueChange="OnBranchChange"></DropDownListEvents>
        <DropDownListFieldSettings Text="Name" Value="BhCode"></DropDownListFieldSettings>
    </SfDropDownList>
</div>

<style>
    .branch-switcher-container {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.05);
        padding: 4px 12px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .branch-icon {
        color: #38bdf8;
        font-size: 14px;
    }

    .branch-dropdown .e-input-group {
        background: transparent !important;
        border: none !important;
    }

    .branch-dropdown .e-input {
        color: #fff !important;
        font-size: 13px !important;
        font-weight: 600 !important;
    }

    .branch-dropdown .e-ddl-icon {
        color: rgba(255, 255, 255, 0.5) !important;
    }
</style>

@code {
    private List<BranchMaster> branches = new();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(State.TenantID))
        {
            branches = await TenantService.GetBranchesAsync(State.TenantID);
            
            if (State.SelectedBranchCode == null && branches.Count > 0)
            {
                var mainBranch = branches.FirstOrDefault(x => x.IsMainBranch == true) ?? branches.First();
                State.SetBranch(mainBranch.BhCode, mainBranch.Name);
            }
        }
    }

    private void OnBranchChange(ChangeEventArgs<int?, BranchMaster> args)
    {
        if (args.ItemData != null)
        {
            State.SetBranch(args.ItemData.BhCode, args.ItemData.Name);
        }
    }
}
