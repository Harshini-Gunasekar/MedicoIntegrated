@using TrackAdmin.Data
@using TrackAdmin.Models
@using Syncfusion.Blazor.SplitButtons
@using Microsoft.AspNetCore.Components.Authorization

@inject TenantState State
@inject TenantService TenantService
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<div class="app-switcher-container">
    @if (products.Any())
    {
        <SfDropDownButton Content="@State.SelectedApp" 
                          CssClass="app-switcher-btn"
                          IconCss="e-icons e-more-vertical-1">
            <DropDownButtonEvents ItemSelected="OnAppSelect"></DropDownButtonEvents>
            <DropDownMenuItems>
                @foreach (var product in products)
                {
                    <DropDownMenuItem Text="@product.ProductName" Id="@product.ProductId" IconCss="@product.IconCss"></DropDownMenuItem>
                }
            </DropDownMenuItems>
        </SfDropDownButton>
    }
</div>

<style>
    .app-switcher-btn {
        background: rgba(56, 189, 248, 0.1) !important;
        border: 1px solid rgba(56, 189, 248, 0.2) !important;
        color: #38bdf8 !important;
        font-weight: 700 !important;
        border-radius: 10px !important;
        padding: 2px 10px !important;
    }

    .app-switcher-btn:hover {
        background: rgba(56, 189, 248, 0.2) !important;
    }
</style>

@code {
    private List<ProductList> products = new();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(State.TenantID))
        {
            products = await TenantService.GetTenantProductsAsync(State.TenantID);
        }
    }

    private async Task OnAppSelect(MenuEventArgs args)
    {
        var product = products.FirstOrDefault(p => p.ProductId == args.Item.Id);
        if (product != null && !string.IsNullOrEmpty(product.BaseUrl))
        {
            State.SetApp(product.ProductName);
            
            // Get current session token for SSO
            var authProvider = (JwtAuthenticationStateProvider)AuthStateProvider;
            var session = await authProvider.GetUserSessionAsync();
            
            if (session != null && !string.IsNullOrEmpty(session.Token))
            {
                // Construct SSO URL: BaseUrl/sso-login?token={JWT}
                var separator = product.BaseUrl.Contains("?") ? "&" : "?";
                var ssoUrl = $"{product.BaseUrl}/sso-login{separator}token={System.Net.WebUtility.UrlEncode(session.Token)}";
                
                await Task.Delay(200); // Stabilization delay for Syncfusion
                NavManager.NavigateTo(ssoUrl, forceLoad: true);
            }
            else
            {
                // Fallback for non-SSO links or if session is missing
                await Task.Delay(200); 
                NavManager.NavigateTo(product.BaseUrl, forceLoad: true);
            }
        }
    }
}
