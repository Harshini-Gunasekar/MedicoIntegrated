    <script>
        window.initializeInactivityTimer = (dotNetHelper) => {
            var lastUpdate = 0;
            const throttleMs = 5000; // Notify at most once every 5 seconds
            
            function resetTimer() {
                var now = Date.now();
                if (now - lastUpdate > throttleMs) {
                    lastUpdate = now;
                    try {
                        if (dotNetHelper) {
                            dotNetHelper.invokeMethodAsync('OnActivityDetected')
                                .catch(() => { /* Silent catch if Blazor is disconnected */ });
                        }
                    } catch (e) {
                        /* Silent catch */
                    }
                }
            }
            window.onclick = resetTimer;
            window.onmousemove = resetTimer;
            window.onkeypress = resetTimer;
            window.onscroll = resetTimer;
        };
        window.getBrowserTz = function() {
            try {
                return Intl.DateTimeFormat().resolvedOptions().timeZone || "";
            } catch(e) {
                return "";
            }
        };
        window.toggleBodyTheme = function(isDark) {
            if (isDark) {
                document.body.classList.remove("light-theme");
            } else {
                document.body.classList.add("light-theme");
            }
        };
    </script>
