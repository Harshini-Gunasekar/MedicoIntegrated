@rendermode InteractiveServer
@using TrackAdmin.Data
@inject UserSessionService session
@inject NavigationManager NavManager
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage protectedSessionStore
@inject LogoutStateService _logoutService

<footer class="alpha-global-footer glass-morphic animate-slide-up">
    <div class="footer-left">
        <div class="footer-brand">
            <img src="/images/rido-logo-pro.png" class="footer-logo" />
            <div class="brand-text">
                <span class="main">Rido Admin</span>
                <span class="sub">V2.0 Professional</span>
            </div>
        </div>
        <div class="footer-divider"></div>
        <div class="footer-live-status">
            <span class="pulse-dot"></span>
            <span class="status-label">Operational</span>
        </div>
    </div>

    <div class="footer-right">
        <div class="admin-quick-actions">
            <button class="footer-action-btn" title="Support">
                <i class="bi bi-headset"></i>
            </button>
            <button class="footer-action-btn" title="Notifications">
                <i class="bi bi-bell"></i>
                <span class="btn-badge">3</span>
            </button>
        </div>
        <div class="footer-divider"></div>
        <div class="user-admin-dropdown">
            <div class="user-pill" @onclick="ToggleProfile">
                <div class="u-avatar">@(!string.IsNullOrEmpty(session.UserName) ? session.UserName[0].ToString() : "A")</div>
                <div class="u-info">
                    <span class="u-name">@session.UserName</span>
                    <span class="u-role">Administrator</span>
                </div>
                <i class="bi bi-chevron-up ms-2"></i>
            </div>
            
            @if (showProfile)
            {
                <div class="profile-popup animate-fade-in">
                    <div class="popup-header">Account Management</div>
                    <button class="popup-item" @onclick='() => NavTo("/profile")'>
                        <i class="bi bi-person-gear"></i> Profile Settings
                    </button>
                    <button class="popup-item" @onclick='() => NavTo("/changepassword")'>
                        <i class="bi bi-shield-lock"></i> Security
                    </button>
                    <div class="popup-divider"></div>
                    <button class="popup-item text-danger" @onclick="Logout">
                        <i class="bi bi-box-arrow-right"></i> Sign Out
                    </button>
                </div>
            }
        </div>
    </div>
</footer>

@code {
    private bool showProfile = false;

    private void ToggleProfile() => showProfile = !showProfile;

    private void NavTo(string path)
    {
        showProfile = false;
        NavManager.NavigateTo(path);
    }

    private async Task Logout()
    {
        showProfile = false;
        await _logoutService.RequestLogoutAsync();
    }
}

<style>
    .alpha-global-footer {
        position: fixed;
        bottom: 20px;
        left: 340px; /* Sidebar width + gap */
        right: 20px;
        height: 60px;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        z-index: 1000;
        box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.03);
        transition: left 0.3s ease;
    }

    .main-layout.collapsed .alpha-global-footer {
        left: 100px; /* Adjust for collapsed sidebar if applicable */
    }

    .footer-left, .footer-right {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .footer-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .footer-logo {
        height: 24px;
        width: auto;
    }

    .brand-text {
        display: flex;
        flex-direction: column;
    }

    .brand-text .main {
        font-weight: 800;
        font-size: 14px;
        color: var(--text-primary);
        line-height: 1;
    }

    .brand-text .sub {
        font-size: 10px;
        color: var(--text-secondary);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .footer-divider {
        width: 1px;
        height: 24px;
        background: rgba(0, 0, 0, 0.05);
    }

    .footer-live-status {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        background: rgba(16, 185, 129, 0.08);
        border-radius: 20px;
    }

    .status-label {
        font-size: 11px;
        font-weight: 700;
        color: #059669;
        text-transform: uppercase;
    }

    .footer-action-btn {
        background: transparent;
        border: none;
        color: var(--text-secondary);
        font-size: 18px;
        padding: 8px;
        border-radius: 10px;
        transition: all 0.2s;
        position: relative;
    }

    .footer-action-btn:hover {
        background: rgba(0, 0, 0, 0.03);
        color: var(--accent-primary);
    }

    .btn-badge {
        position: absolute;
        top: 4px;
        right: 4px;
        background: var(--accent-primary);
        color: white;
        font-size: 9px;
        font-weight: 800;
        padding: 2px 5px;
        border-radius: 10px;
        border: 2px solid white;
    }

    .user-pill {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 12px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .user-pill:hover {
        background: #ffffff;
        border-color: var(--accent-primary);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);
    }

    .u-avatar {
        width: 28px;
        height: 28px;
        background: var(--accent-primary);
        color: white;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 12px;
    }

    .u-info {
        display: flex;
        flex-direction: column;
    }

    .u-name {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
    }

    .u-role {
        font-size: 10px;
        color: var(--text-secondary);
    }

    .profile-popup {
        position: absolute;
        bottom: 75px;
        right: 20px;
        width: 220px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        border: 1px solid #f1f5f9;
        overflow: hidden;
        z-index: 1100;
    }

    .popup-header {
        padding: 12px 16px;
        font-size: 11px;
        font-weight: 800;
        color: var(--text-secondary);
        text-transform: uppercase;
        background: #f8fafc;
        border-bottom: 1px solid #f1f5f9;
    }

    .popup-item {
        width: 100%;
        text-align: left;
        padding: 12px 16px;
        background: transparent;
        border: none;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        font-weight: 600;
        color: var(--text-primary);
        transition: all 0.2s;
    }

    .popup-item:hover {
        background: #f1f5f9;
        color: var(--accent-primary);
    }

    .popup-divider {
        height: 1px;
        background: #f1f5f9;
    }
</style>
