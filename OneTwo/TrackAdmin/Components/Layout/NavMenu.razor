@using Microsoft.AspNetCore.Components.Authorization
@using TrackAdmin.Data
@inject UserSessionService session
@inject NavigationManager NavManager
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage protectedSessionStore
@inject TenantState _tenantState
@inject AuthenticationStateProvider AuthStateProvider
@inject AuthenticationStateProvider AuthStateProvider
@inject LogoutStateService _logoutService
@implements IDisposable

<div class="food-sidebar-shell @(IsCollapsed ? "collapsed" : "")">
    <div class="food-sidebar">
        
        <div class="sidebar-branding">
            <div class="branding-card">
                <div class="brand-orb-glow @(_tenantState.LogoUrl == "/images/rido-logo-pro.png" ? "logo-shimmer" : "")">
                    <img src="@_tenantState.LogoUrl" class="sidebar-logo-img" onerror="this.src='/images/rido-logo-pro.png'" />
                </div>
                <div class="branding-info">
                    <h2 class="branding-title">@_tenantState.SelectedApp</h2>
                    <span class="branding-subtitle">@(string.IsNullOrWhiteSpace(_tenantState.TenantName) ? $"TID: {_tenantState.TenantID}" : _tenantState.TenantName)</span>
                </div>
                <button class="sidebar-toggle-btn" @onclick="ToggleSidebar" title="@(IsCollapsed ? "Expand Sidebar" : "Collapse Sidebar")">
                    <i class="bi @(IsCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
                </button>
            </div>
        </div>

        <nav class="food-nav">
            <!-- CORE OPS -->
            @if (session.Rights.HasAccess("dashboard") || session.Rights.HasAccess("appointments") || session.Rights.HasAccess("whatsapp") || session.IsAdmin)
            {
                <div class="nav-category @(isOpsOpen ? "expanded" : "")">
                    <div class="category-header" @onclick="() => isOpsOpen = !isOpsOpen">
                        <span>CORE OPS</span>
                        <i class="bi bi-chevron-right chevron"></i>
                    </div>
                    <div class="category-items">
                        @if (session.Rights.HasAccess("dashboard") || session.IsAdmin)
                        {
                            <NavLink class="food-nav-link" href="/Home" Match="NavLinkMatch.All">
                                <div class="food-icon-box">
                                    <i class="bi bi-grid-1x2-fill"></i>
                                </div>
                                <div class="nav-text-wrap">
                                    <span class="nav-main-text">Control Tower</span>
                                    <span class="nav-sub-text">Overview & Analytics</span>
                                </div>
                            </NavLink>
                        }
                        @if (session.Rights.HasAccess("maps") || session.Rights.HasAccess("live_fleets") || session.IsAdmin)
                        {
                            <NavLink class="food-nav-link" href="/Maps">
                                <div class="food-icon-box">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </div>
                                <div class="nav-text-wrap">
                                    <span class="nav-main-text">Live Maps & Fleets</span>
                                    <span class="nav-sub-text">Real-time tracking</span>
                                </div>
                            </NavLink>
                        }        @if (session.Rights.HasAccess("appointments") || session.IsAdmin)
                        {
                            <NavLink class="food-nav-link" href="/Appointments">
                                <div class="food-icon-box">
                                    <i class="bi bi-calendar2-range-fill"></i>
                                </div>
                                <div class="nav-text-wrap">
                                    <span class="nav-main-text">Appointments</span>
                                    <span class="nav-sub-text">Booking list</span>
                                </div>
                            </NavLink>
                        }

                        @if (session.IsAdmin || session.Rights.HasAccess("roster"))
                        {
                            <NavLink class="food-nav-link" href="/Roster">
                                <div class="food-icon-box text-info">
                                    <i class="bi bi-calendar-week-fill"></i>
                                </div>
                                <div class="nav-text-wrap">
                                    <span class="nav-main-text">Riders Roster</span>
                                    <span class="nav-sub-text">Duty shifts & swaps</span>
                                </div>
                            </NavLink>
                        }

                        @if (session.Rights.HasAccess("whatsapp") || session.IsAdmin)
                        {
                            <NavLink class="food-nav-link" href="/WhatsappAppointments">
                                <div class="food-icon-box">
                                    <i class="bi bi-whatsapp"></i>
                                </div>
                                <div class="nav-text-wrap">
                                    <span class="nav-main-text">WhatsApp</span>
                                    <span class="nav-sub-text">Message bookings</span>
                                </div>
                            </NavLink>
                        }
                    </div>
                </div>
            }

            <!-- LOGISTICS -->
            @if (session.Rights.HasAccess("sample_receive") || session.Rights.HasAccess("sample_transfer") || session.IsAdmin)
            {
                <div class="nav-category @(isLogisticsOpen ? "expanded" : "")">
                    <div class="category-header" @onclick="() => isLogisticsOpen = !isLogisticsOpen">
                        <span>LOGISTICS</span>
                        <i class="bi bi-chevron-right chevron"></i>
                    </div>
                    <div class="category-items">
                        @if (session.Rights.HasAccess("sample_receive") || session.IsAdmin)
                        {
                            <NavLink class="food-nav-link" href="/received">
                                <div class="food-icon-box sub-icon">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                </div>
                                <div class="nav-text-wrap">
                                    <span class="nav-main-text">Sample Receive</span>
                                    <span class="nav-sub-text">Inbound logistics</span>
                                </div>
                            </NavLink>
                        }
                        @if (session.Rights.HasAccess("sample_transfer") || session.IsAdmin)
                        {
                            <NavLink class="food-nav-link" href="/transfer">
                                <div class="food-icon-box sub-icon">
                                    <i class="bi bi-box-arrow-right"></i>
                                </div>
                                <div class="nav-text-wrap">
                                    <span class="nav-main-text">Logistics Transfer</span>
                                    <span class="nav-sub-text">Outbound flow</span>
                                </div>
                            </NavLink>
                        }
                        @if (session.IsAdmin)
                        {
                            <NavLink class="food-nav-link" href="/logistics/payment-collections">
                                <div class="food-icon-box sub-icon text-warning">
                                    <i class="bi bi-wallet2"></i>
                                </div>
                                <div class="nav-text-wrap">
                                    <span class="nav-main-text">Payment Collections</span>
                                    <span class="nav-sub-text">Cash & Container log</span>
                                </div>
                            </NavLink>
                        }
                    </div>
                </div>
            }

            <!-- MASTER DATA -->
            @if (session.Rights.HasAccess("staff") || session.Rights.HasAccess("client") || session.Rights.HasAccess("details") || session.Rights.HasAccess("referral") || session.IsAdmin)
            {
                <div class="nav-category @(isMasterOpen ? "expanded" : "")">
                    <div class="category-header" @onclick="() => isMasterOpen = !isMasterOpen">
                        <span>MASTER DATA</span>
                        <i class="bi bi-chevron-right chevron"></i>
                    </div>
                    <div class="category-items">
                        @if (session.Rights.HasAccess("client") || session.Rights.HasAccess("referral") || session.IsAdmin)
                        {
                            <NavLink class="food-nav-link" href="/Referral">
                                <div class="food-icon-box sub-icon">
                                    <i class="bi bi-buildings-fill"></i>
                                </div>
                                <div class="nav-text-wrap">
                                    <span class="nav-main-text">Client Master</span>
                                    <span class="nav-sub-text">Partner records</span>
                                </div>
                            </NavLink>
                        }

                        @if (session.Rights.HasAccess("staff") || session.Rights.HasAccess("details") || session.Rights.HasAccess("rider") || session.IsAdmin)
                        {
                            <NavLink class="food-nav-link" href="/RiderRegistration">
                                <div class="food-icon-box sub-icon">
                                    <i class="bi bi-scooter"></i>
                                </div>
                                <div class="nav-text-wrap">
                                    <span class="nav-main-text">Rider Fleet</span>
                                    <span class="nav-sub-text">Personnel management</span>
                                </div>
                            </NavLink>
                        }
                    </div>
                </div>
            }

            <!-- ANALYTICS -->
            @if (session.Rights.HasAccess("reports") || session.IsAdmin)
            {
                <div class="nav-category @(isAnalyticsOpen ? "expanded" : "")">
                    <div class="category-header" @onclick="() => isAnalyticsOpen = !isAnalyticsOpen">
                        <span>ANALYTICS</span>
                        <i class="bi bi-chevron-right chevron"></i>
                    </div>
                    <div class="category-items">
                        <NavLink class="food-nav-link" href="/report">
                            <div class="food-icon-box sub-icon">
                                <i class="bi bi-pie-chart-fill"></i>
                            </div>
                            <div class="nav-text-wrap">
                                <span class="nav-main-text">Insights</span>
                                <span class="nav-sub-text">Data & performance</span>
                            </div>
                        </NavLink>
                    </div>
                </div>
            }

            <!-- ADMINISTRATION -->
            @if (session.IsAdmin || session.Rights.HasAccess("tenants"))
            {
                <div class="nav-category @(isAdminOpen ? "expanded" : "")">
                    <div class="category-header" @onclick="() => isAdminOpen = !isAdminOpen">
                        <span>ADMINISTRATION</span>
                        <i class="bi bi-chevron-right chevron"></i>
                    </div>
                    <div class="category-items">
                        <NavLink class="food-nav-link" href="/TenantManagement">
                            <div class="food-icon-box">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <div class="nav-text-wrap">
                                <span class="nav-main-text">Tenant Settings</span>
                                <span class="nav-sub-text">Profile & Modules</span>
                            </div>
                        </NavLink>

                        <NavLink class="food-nav-link" href="/ProductFeatures">
                            <div class="food-icon-box">
                                <i class="bi bi-gear-wide-connected"></i>
                            </div>
                            <div class="nav-text-wrap">
                                <span class="nav-main-text">Feature Registry</span>
                                <span class="nav-sub-text">Dev Console</span>
                            </div>
                        </NavLink>

                        <NavLink class="food-nav-link" href="/UserRights">
                            <div class="food-icon-box">
                                <i class="bi bi-person-check-fill"></i>
                            </div>
                            <div class="nav-text-wrap">
                                <span class="nav-main-text">User Rights</span>
                                <span class="nav-sub-text">RBAC Control</span>
                            </div>
                        </NavLink>
                    </div>
                </div>
            }
        </nav>

        <!-- USER FOOTER (Admin Part) -->
        <div class="sidebar-user-footer">
            <div class="user-profile-main">
                <div class="user-avatar-wrap">
                    <div class="user-avatar">@(!string.IsNullOrEmpty(session.UserName) ? session.UserName[0].ToString() : "A")</div>
                    <div class="user-status-dot"></div>
                </div>
                <div class="user-info-wrap">
                    <span class="user-name">@session.UserName</span>
                    <span class="user-role">@(session.IsAdmin ? "Super User" : "Staff User")</span>
                </div>
            </div>
            
            <div class="user-actions-row">
                <button class="user-footer-btn" title="System Settings" @onclick='() => NavTo("/profile")'>
                    <i class="bi bi-gear-wide-connected"></i>
                </button>
                <button class="user-footer-btn" title="Security" @onclick='() => NavTo("/changepassword")'>
                    <i class="bi bi-shield-lock"></i>
                </button>
                <button class="user-footer-btn text-danger" title="Sign Out" @onclick="Logout">
                    <i class="bi bi-power"></i>
                </button>
            </div>
        </div>

    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> authState { get; set; }
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    private bool isOpsOpen = true;
    private bool isLogisticsOpen = false;
    private bool isMasterOpen = false;
    private bool isAnalyticsOpen = false;
    private bool isAdminOpen = false;

    protected override async Task OnParametersSetAsync()
    {
        var state = await authState;
        if (state.User.Identity.IsAuthenticated)
        {
            var authProvider = (JwtAuthenticationStateProvider)AuthStateProvider;
            var userSession = await authProvider.GetUserSessionAsync();
            if (userSession != null)
            {
                session.Rights = userSession.Rights;
                session.IsAdmin = userSession.IsAdmin;
                session.Rights.IsAdmin = userSession.IsAdmin;
            }
        }
    }

    protected override void OnInitialized()
    {
        _tenantState.OnStateChange += StateHasChanged;
    }

    private void NavTo(string path)
    {
        NavManager.NavigateTo(path);
    }

    private async Task Logout()
    {
        await _logoutService.RequestLogoutAsync();
    }

    private async Task ToggleSidebar()
    {
        await OnToggle.InvokeAsync();
    }

    public void Dispose()
    {
        _tenantState.OnStateChange -= StateHasChanged;
    }
}