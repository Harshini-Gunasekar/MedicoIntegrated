<div class="bg-canvas">
    <div class="medical-pattern"></div>
    <div class="medical-blobs">
        <div class="blob b1"></div>
        <div class="blob b2"></div>
    </div>
    
    @foreach (var iconClass in GetRandomIcons())
    {
        var rnd = new Random(Guid.NewGuid().GetHashCode());
        var duration = rnd.Next(15, 30);
        var delay = rnd.Next(0, 10);
        var size = 54;
        var top = rnd.Next(5, 95);
        var left = rnd.Next(5, 95);
        var opacity = 0.15 + (rnd.NextDouble() * 0.10); // Slightly more visible
        
        <i class="bi @iconClass m-tool" 
           style="top: @(top)%; left: @(left)%; font-size: @(size)px; animation-duration: @(duration)s; animation-delay: @(delay)s; opacity: @(opacity.ToString("F2"));"></i>
    }
</div>

@code {
    private List<string> GetRandomIcons()
    {
        var icons = new List<string> { 
            "bi-capsule", "bi-capsule-pill", "bi-droplet-half", "bi-heart-pulse", 
            "bi-thermometer-half", "bi-bandaid", "bi-clipboard-pulse", "bi-dna", 
            "bi-hospital", "bi-lungs", "bi-microscope", "bi-patch-plus", 
            "bi-shield-plus", "bi-stethoscopes", "bi-virus", "bi-activity",
            "bi-bag-plus", "bi-clipboard2-medical", "bi-heart-fill", "bi-prescription2",
            "bi-capsule-pill", "bi-thermometer-high"
        };
        
        return icons.OrderBy(x => Guid.NewGuid()).ToList();
    }
}
