            FullName = riderName
        };

        var member = _members.FirstOrDefault(m => m.Id == int.Parse(riderId));
        if (member != null)
        {
            member.UnreadCount = 0;
        }

        // Call mark-read API
        try
        {
            var baseUrl = ApiConfig.Value.BaseApiUrl;
            var markReadUrl = $"{baseUrl}Chat/mark-read";
            await Http.PostAsJsonAsync(markReadUrl, new { SenderId = int.Parse(riderId), RecipientId = session.UserID });
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error calling mark-read: " + ex.Message);
        }

        var toast = _toasts.FirstOrDefault(t => t.RiderId == riderId);
        if (toast != null)
        {
            _toasts.Remove(toast);
        }

        _showSidebar = false; // Hide sidebar when chat window opens
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadChatMembers()
    {
        try
        {
            if (session.UserID == 0)
            {
                var loginState = await protectedSessionStore.GetAsync<bool>("IsLoggedIn");
                if (loginState.Success && loginState.Value)
                {
                    var tenant = await protectedSessionStore.GetAsync<string>("TenantID");
                    var userId = await protectedSessionStore.GetAsync<int>("UserID");
                    var userName = await protectedSessionStore.GetAsync<string>("UserName");

                    session.IsLoggedIn = true;
                    session.TenantID = tenant.Success ? tenant.Value : null;
                    session.UserID = userId.Success ? userId.Value : 0;
                    session.UserName = userName.Success ? userName.Value : null;
                }
            }

            if (session.UserID == 0) return;

            var baseUrl = ApiConfig.Value.BaseApiUrl;
            var response = await Http.GetAsync($"{baseUrl}Chat/members?riderId={session.UserID}");
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                _members = JsonConvert.DeserializeObject<List<ChatMember>>(content) ?? new();
                
                // Sort immediately so the user sees the list in the correct order right away!
                FilterMembers();
                
                // Fetch unread counts
                var countsResponse = await Http.GetAsync($"{baseUrl}Chat/unread-counts?recipientId={session.UserID}");
                if (countsResponse.IsSuccessStatusCode)
                {
                    var countsContent = await countsResponse.Content.ReadAsStringAsync();
                    var counts = JsonConvert.DeserializeObject<List<UnreadCountInfo>>(countsContent) ?? new();
                    
                    foreach (var m in _members)
                    {
                        var info = counts.FirstOrDefault(c => c.SenderId == m.Id);
                        m.UnreadCount = info != null ? info.UnreadCount : 0;
                    }
                    
                    // Re-sort to apply unread count updates
                    FilterMembers();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading chat members: " + ex.Message);
        }
    }

    private void FilterMembers()
    {
        var queryList = string.IsNullOrWhiteSpace(_searchQuery)
            ? _members
            : _members.Where(m => (m.Name != null && m.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)) || 
                                  (m.Mobile != null && m.Mobile.Contains(_searchQuery)));

        _filteredMembers = queryList
            .OrderByDescending(m => m.LastMessageTime ?? DateTime.MinValue)
            .ThenBy(m => m.Name ?? "")
            .ToList();

        StateHasChanged();
    }

