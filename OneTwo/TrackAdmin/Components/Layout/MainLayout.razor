                await JS.InvokeVoidAsync("console.log", "[DEBUG] Conditions met. Calling LoadWelcomeStats()");
            }
            catch { }
            await LoadWelcomeStats();
        }
    }

    private async Task LoadWelcomeStats()
    {
        if (session.IsAdmin && !session.WelcomeCardShown)
        {
            isLoadingStats = true;
            showWelcomeOverlay = true;
            StateHasChanged();

            // Set greeting based on Dubai time
            var dubaiZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Dubai");
            var dubaiNow = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, dubaiZone);
            var hour = dubaiNow.Hour;
            if (hour >= 5 && hour < 12) greetingMessage = "Good morning";
            else if (hour >= 12 && hour < 17) greetingMessage = "Good afternoon";
            else greetingMessage = "Good evening";

            try
            {
                stats = await _tenantService.GetWelcomeStatsAsync();
                try
                {
                    await JS.InvokeVoidAsync("console.log", $"[DEBUG] LoadWelcomeStats success. Stats null? {stats == null}");
                }
                catch { }
            }
            catch (Exception ex)
            {
                try
                {
                    await JS.InvokeVoidAsync("console.error", "Error loading welcome stats: " + ex.Message);
                }
                catch { }
            }
            finally
            {
                isLoadingStats = false;
                StateHasChanged();
            }
        }
    }

