    private void ProceedToBroadcastConfirm()
    {
        if (string.IsNullOrWhiteSpace(broadcastMessage))
        {
            broadcastError = "Message cannot be empty.";
            return;
        }
        if (broadcastTarget == "Specific" && !broadcastSpecificRiderId.HasValue)
        {
            broadcastError = "Please select a specific rider.";
            return;
        }
        broadcastError = "";
        broadcastConfirmStep = true;
    }

    private string GetBroadcastTargetLabel()
    {
        if (broadcastTarget == "Specific")
        {
            var rider = broadcastRiderList.FirstOrDefault(r => r.RiderID == broadcastSpecificRiderId);
            return rider != null ? $"{rider.ShortName} (ID: #{rider.RiderID})" : "Specific Rider";
        }
        return broadcastTarget == "Online" ? "Online Only" : broadcastTarget == "Offline" ? "Offline Only" : "All Riders";
    }

    private async Task SendBroadcast()
    {
        broadcastSending = true;
        broadcastError = "";
        StateHasChanged();

        try
        {
            var baseUrl = ApiConfig.Value.BaseApiUrl;
            var request = new
            {
                Message = broadcastMessage,
                TargetType = broadcastTarget,
                SpecificRiderId = broadcastSpecificRiderId,
                Priority = broadcastPriority
            };

            var response = await Http.PostAsJsonAsync($"{baseUrl}Broadcast/send", request);
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                var result = JsonConvert.DeserializeObject<BroadcastResultModel>(content);
                if (result != null && result.SentCount > 0)
                {
                    broadcastSentCount = result.SentCount;
                    broadcastSent = true;
                    broadcastError = "";
                }
                else
                {
                    broadcastSentCount = 0;
                    broadcastSent = false;
                    var err = (result?.Errors != null && result.Errors.Any()) 
                        ? string.Join(", ", result.Errors) 
                        : "No active device tokens found for the selected riders.";
                    broadcastError = $"Failed: {err}";
                }
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                broadcastError = $"Failed: {errorText}";
            }
        }
        catch (Exception ex)
        {
            broadcastError = $"Error: {ex.Message}";
        }
        finally
        {
            broadcastSending = false;
            StateHasChanged();
        }
    }

    public class BroadcastResultModel
    {
        public int SentCount { get; set; }
        public int FailedCount { get; set; }
        public List<string> Errors { get; set; } = new();
    }

