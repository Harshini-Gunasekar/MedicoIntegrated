    private async Task InitializeChatListener()
    {
        if (_chatHubConnection != null) return;

        try
        {
            var rootUrl = ApiConfig.Value.BaseApiUrl.Replace("/api/", "/").TrimEnd('/');
            var hubUrl = $"{rootUrl}/chatHub?riderId={session.UserID}&TenantId={_tenantState.TenantID}";

            _chatHubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            _chatHubConnection.On<ChatMessage>("ReceiveMessage", async (message) =>
            {
                if (message.SenderId != session.UserID && message.RecipientId == session.UserID)
                {
                    if (activeRiderForChat != null && activeRiderForChat.RiderId == message.SenderId.ToString())
                    {
                        await InvokeAsync(StateHasChanged);
                        return;
                    }

                    var member = _members.FirstOrDefault(m => m.Id == message.SenderId);
                    if (member != null)
                    {
                        member.UnreadCount++;
                        member.LastMessageTime = DateTime.UtcNow;
                        FilterMembers();
                    }
                    else
                    {
                        await LoadChatMembers();
                    }

                    await HandleIncomingMessage(message);
                }
            });

            await _chatHubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MainLayout: Failed to connect to ChatHub: {ex.Message}");
        }
    }

    private async Task HandleIncomingMessage(ChatMessage message)
    {
        var name = "Rider";
        try
        {
            name = await _tenantService.GetRiderNameAsync(message.SenderId);
        }
        catch {}

        var content = message.MessageType == "Voice" ? "🎤 Voice message" : message.Content;

        var toast = new ActiveToast
        {
            RiderId = message.SenderId.ToString(),
            RiderName = name,
            Message = content
        };

        _toasts.Add(toast);
        await InvokeAsync(StateHasChanged);

        // Play premium chime sound
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                try {
                    const audio = new Audio('https://assets.mixkit.co/active_storage/sfx/2869/2869-84.wav');
                    audio.volume = 0.5;
                    audio.play().catch(e => console.log('Audio autoplay blocked:', e));
                } catch(e) {}
            ");
        }
        catch {}

        // Auto dismiss after 2 seconds
        _ = Task.Delay(2000).ContinueWith(async _ =>
        {
            _toasts.Remove(toast);
            await InvokeAsync(StateHasChanged);
        });
    }

    private void DismissToast(string toastId)
    {
        var toast = _toasts.FirstOrDefault(t => t.Id == toastId);
