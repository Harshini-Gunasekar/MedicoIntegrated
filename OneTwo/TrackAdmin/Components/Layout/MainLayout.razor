@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.Components.Authorization
@using TrackAdmin.Data
@using Microsoft.AspNetCore.SignalR.Client
@using TrackAdmin.Models
@using Newtonsoft.Json
@inject HttpClient Http
@inject ProtectedSessionStorage protectedSessionStore
@inject TenantState _tenantState
@inject InactivityService _inactivityService
@inject TenantService _tenantService
@inject IJSRuntime JS
@inject UserSessionService session
@inject NavigationManager NavManager
@inject LogoutStateService _logoutService
@inject AuthenticationStateProvider authStateProvider
@inject Microsoft.Extensions.Options.IOptions<APIConfiguration> ApiConfig
@inject NotificationStore NotifStore
@implements IDisposable


<div class="main-layout @(isCollapsed ? "collapsed" : "")">
    <aside class="sidebar-area">
        <NavMenu IsCollapsed="isCollapsed" OnToggle="ToggleSidebar" />
    </aside>

    <main class="main-content">
        <ContextualHeader />
        <article class="content-area">
            <div class="col-12">
                @Body
            </div>
        </article>
    </main>
    <SfDialogProvider></SfDialogProvider>
</div>

@if (showWelcomeOverlay && session.IsLoggedIn && session.IsAdmin)
{
    <div class="wc-backdrop @(welcomeExitClass)" @onclick="DismissWelcome">
        <div class="wc-panel @(welcomeExitClass)" @onclick:stopPropagation="true">

            <!-- ── HEADER ── -->
            <div class="wc-top-header">
                <div class="wc-avatar-blob">
                    <img src="/images/welcome_avatar.png" class="wc-hero-avatar" alt="Admin Avatar"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                    <div class="wc-avatar-fallback-text" style="display:none;">@GetInitials(session.UserName)</div>
                </div>
                <div class="wc-top-greeting">
                    <h2 class="wc-main-title">@greetingMessage, @session.UserName! 👋</h2>
                    <p class="wc-main-sub">Here's your operational snapshot for today.</p>
                </div>
                <div class="wc-top-controls">
                    <div class="wc-date-pill">
                        <i class="bi bi-calendar3"></i>
                        <span>@DateTime.Now.ToString("dd MMM yyyy")</span>
                    </div>
                    <button class="wc-x-btn" @onclick="DismissWelcome"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>

            <!-- ── SCROLLABLE BODY ── -->
            <div class="wc-scroll-body">
                @if (isLoadingStats)
                {
                    <div class="wc-loader-area">
                        <div class="wc-spinner-dots">
                            <span></span><span></span><span></span>
                        </div>
                        <p class="wc-loader-text">Retrieving dashboard metrics...</p>
                    </div>
                }
                else if (stats != null)
                {
                    <!-- ── TODAY AT A GLANCE ── -->
                    <div class="wc-glance-section">
                        <div class="wc-glance-header">
                            <div class="wc-glance-icon-box"><i class="bi bi-grid-1x2-fill"></i></div>
                            <span class="wc-glance-title">TODAY AT A GLANCE</span>
                        </div>
                        <div class="wc-glance-grid">
                            <div class="wc-glance-card green">
                                <div class="wc-glance-card-icon"><i class="bi bi-people-fill"></i></div>
                                <div class="wc-glance-num">@stats.RiderStats.TotalRiders</div>
                                <div class="wc-glance-lbl">Active Riders</div>
                                <div class="wc-glance-trend up">↑ vs Yesterday</div>
                            </div>
                            <div class="wc-glance-card blue">
                                <div class="wc-glance-card-icon"><i class="bi bi-droplet-fill"></i></div>
                                <div class="wc-glance-num">@stats.TodayStats.SampleCollectionsCount</div>
                                <div class="wc-glance-lbl">Collections</div>
                                <div class="wc-glance-trend up">↑ vs Yesterday</div>
                            </div>
                            <div class="wc-glance-card purple">
                                <div class="wc-glance-card-icon"><i class="bi bi-calendar-check-fill"></i></div>
                                <div class="wc-glance-num">@stats.TodayStats.TotalAppointments</div>
                                <div class="wc-glance-lbl">Appointments</div>
                                <div class="wc-glance-trend up">↑ vs Yesterday</div>
                            </div>
                            <div class="wc-glance-card orange">
                                <div class="wc-glance-card-icon"><i class="bi bi-cash-stack"></i></div>
                                <div class="wc-glance-num">@stats.TodayStats.PaymentRequestsCompletedCount / @stats.TodayStats.PaymentRequestsRaisedCount</div>
                                <div class="wc-glance-lbl">Payments</div>
                                <div class="wc-glance-trend" style="font-size: 0.72rem; color: #d97706; font-weight: 500;">
                                    Completed: @stats.TodayStats.PaymentRequestsCompletedCount | Pending: @stats.TodayStats.PaymentRequestsPendingCount
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── TODAY'S WORK PLAN ── -->
                    <div class="wc-plan-section">
                        <div class="wc-plan-header">
                            <div class="wc-glance-icon-box indigo"><i class="bi bi-lightning-charge-fill"></i></div>
                            <span class="wc-glance-title">TODAY'S WORK PLAN</span>
                            <div class="wc-plan-progress-wrap">
                                <div class="wc-plan-progress-bar">
                                    <div class="wc-plan-progress-fill" style="width: 60%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="wc-task-list">
                            <!-- Rider Check-in -->
                            <div class="wc-task-row">
                                <div class="wc-task-icon-wrap green"><i class="bi bi-check-circle-fill"></i></div>
                                <div class="wc-task-info">
                                    <div class="wc-task-name">Rider Check-in</div>
                                    <div class="wc-task-desc">Ensure all riders are active</div>
                                </div>
                                <div class="wc-task-right">
                                    <div class="wc-task-count">@stats.RiderStats.TotalRiders / @stats.RiderStats.TotalRiders</div>
                                    <div class="wc-task-status completed">Completed</div>
                                </div>
                                <i class="bi bi-chevron-right wc-task-chevron"></i>
                            </div>
                            <!-- Sample Collections -->
                            <div class="wc-task-row">
                                <div class="wc-task-icon-wrap blue"><i class="bi bi-droplet-fill"></i></div>
                                <div class="wc-task-info">
                                    <div class="wc-task-name">Sample Collections</div>
                                    <div class="wc-task-desc">Track and confirm collections</div>
                                </div>
                                <div class="wc-task-right">
                                    <div class="wc-task-count">@stats.TodayStats.TotalSamplesCollected / @(stats.YesterdayStats.TotalSamplesCollected > 0 ? stats.YesterdayStats.TotalSamplesCollected : stats.TodayStats.TotalSamplesCollected)</div>
                                    <div class="wc-task-status @(stats.TodayStats.TotalSamplesCollected > 0 ? "inprogress" : "pending")">@(stats.TodayStats.TotalSamplesCollected > 0 ? "In Progress" : "Pending")</div>
                                </div>
                                <i class="bi bi-chevron-right wc-task-chevron"></i>
                            </div>
                            <!-- Appointments -->
                            <div class="wc-task-row">
                                <div class="wc-task-icon-wrap purple"><i class="bi bi-calendar-check-fill"></i></div>
                                <div class="wc-task-info">
                                    <div class="wc-task-name">Appointments</div>
                                    <div class="wc-task-desc">Manage today's appointments</div>
                                </div>
                                <div class="wc-task-right">
                                    <div class="wc-task-count">@stats.TodayStats.TotalAppointments / @(stats.YesterdayStats.TotalAppointments > 0 ? stats.YesterdayStats.TotalAppointments : stats.TodayStats.TotalAppointments)</div>
                                    <div class="wc-task-status @(stats.TodayStats.TotalAppointments > 0 ? "inprogress" : "pending")">@(stats.TodayStats.TotalAppointments > 0 ? "In Progress" : "Pending")</div>
                                </div>
                                <i class="bi bi-chevron-right wc-task-chevron"></i>
                            </div>
                            <!-- Payment Collection -->
                            <div class="wc-task-row">
                                <div class="wc-task-icon-wrap orange"><i class="bi bi-cash-stack"></i></div>
                                <div class="wc-task-info">
                                    <div class="wc-task-name">Payment Collection</div>
                                    <div class="wc-task-desc">Completed: @stats.TodayStats.PaymentRequestsCompletedCount | Pending: @stats.TodayStats.PaymentRequestsPendingCount</div>
                                </div>
                                <div class="wc-task-right">
                                    <div class="wc-task-count">@stats.TodayStats.PaymentRequestsCompletedCount / @stats.TodayStats.PaymentRequestsRaisedCount</div>
                                    <div class="wc-task-status @(stats.TodayStats.PaymentRequestsCompletedCount == stats.TodayStats.PaymentRequestsRaisedCount && stats.TodayStats.PaymentRequestsRaisedCount > 0 ? "completed" : (stats.TodayStats.PaymentRequestsRaisedCount > 0 ? "inprogress" : "pending"))">
                                        @(stats.TodayStats.PaymentRequestsCompletedCount == stats.TodayStats.PaymentRequestsRaisedCount && stats.TodayStats.PaymentRequestsRaisedCount > 0 ? "Completed" : (stats.TodayStats.PaymentRequestsRaisedCount > 0 ? "In Progress" : "Pending"))
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right wc-task-chevron"></i>
                            </div>
                            <!-- Data Sync -->
                            <div class="wc-task-row last">
                                <div class="wc-task-icon-wrap teal"><i class="bi bi-cloud-arrow-up-fill"></i></div>
                                <div class="wc-task-info">
                                    <div class="wc-task-name">Data Sync</div>
                                    <div class="wc-task-desc">Sync all data and close the day</div>
                                </div>
                                <div class="wc-task-right">
                                    <div class="wc-task-count">&nbsp;</div>
                                    <div class="wc-task-status pending">Pending</div>
                                </div>
                                <i class="bi bi-chevron-right wc-task-chevron"></i>
                            </div>
                        </div>
                    </div>

                    <!-- ── SHIFT + QUICK STATS ── -->
                    <div class="wc-bottom-row">
                        <!-- Shift Breakdown -->
                        <div class="wc-shift-panel">
                            <div class="wc-plan-header">
                                <div class="wc-glance-icon-box blue"><i class="bi bi-clock-history"></i></div>
                                <span class="wc-glance-title">SHIFT BREAKDOWN</span>
                            </div>
                            <div class="wc-shift-donut-wrap">
                                <div class="wc-donut-container">
                                    <div class="wc-donut-ring">
                                        <svg viewBox="0 0 100 100" class="wc-donut-svg">
                                            <circle cx="50" cy="50" r="38" fill="none" stroke="#f1f5f9" stroke-width="14"/>
                                            @{
                                                var total = stats.RiderStats.TotalRiders > 0 ? stats.RiderStats.TotalRiders : 1;
                                                var morningPct = (double)stats.RiderStats.MorningShift / total;
                                                var eveningPct = (double)stats.RiderStats.EveningShift / total;
                                                var nightPct = (double)stats.RiderStats.NightShift / total;
                                                var circ = 2 * Math.PI * 38;
                                                var mDash = morningPct * circ;
                                                var eDash = eveningPct * circ;
                                                var nDash = nightPct * circ;
                                                var mOffset = 0;
                                                var eOffset = -(mDash);
                                                var nOffset = -(mDash + eDash);
                                            }
                                            <circle cx="50" cy="50" r="38" fill="none" stroke="#f59e0b" stroke-width="14"
                                                    stroke-dasharray="@(mDash.ToString("F2")) @((circ - mDash).ToString("F2"))"
                                                    stroke-dashoffset="@(circ * 0.25)" stroke-linecap="round"/>
                                            <circle cx="50" cy="50" r="38" fill="none" stroke="#8b5cf6" stroke-width="14"
                                                    stroke-dasharray="@(eDash.ToString("F2")) @((circ - eDash).ToString("F2"))"
                                                    stroke-dashoffset="@((circ * 0.25) - mDash)" stroke-linecap="round"/>
                                            <circle cx="50" cy="50" r="38" fill="none" stroke="#6366f1" stroke-width="14"
                                                    stroke-dasharray="@(nDash.ToString("F2")) @((circ - nDash).ToString("F2"))"
                                                    stroke-dashoffset="@((circ * 0.25) - mDash - eDash)" stroke-linecap="round"/>
                                        </svg>
                                        <div class="wc-donut-center">
                                            <span class="wc-donut-num">@stats.RiderStats.TotalRiders</span>
                                            <span class="wc-donut-label">Riders</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="wc-shift-legend">
                                    <div class="wc-legend-item">
                                        <span class="wc-legend-dot" style="background:#f59e0b;"></span>
                                        <span class="wc-legend-text">Morning <strong>@stats.RiderStats.MorningShift</strong></span>
                                    </div>
                                    <div class="wc-legend-item">
                                        <span class="wc-legend-dot" style="background:#8b5cf6;"></span>
                                        <span class="wc-legend-text">Evening <strong>@stats.RiderStats.EveningShift</strong></span>
                                    </div>
                                    <div class="wc-legend-item">
                                        <span class="wc-legend-dot" style="background:#6366f1;"></span>
                                        <span class="wc-legend-text">Night <strong>@stats.RiderStats.NightShift</strong></span>
                                    </div>
                                    <a href="/Roster" class="wc-view-full" @onclick="DismissWelcome">View Full Details →</a>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Stats -->
                        <div class="wc-quickstats-panel">
                            <div class="wc-plan-header">
                                <div class="wc-glance-icon-box green"><i class="bi bi-bar-chart-fill"></i></div>
                                <span class="wc-glance-title">QUICK STATS</span>
                            </div>
                            <div class="wc-qs-list">
                                <div class="wc-qs-row">
                                    <div class="wc-qs-icon-wrap"><i class="bi bi-cash-stack" style="color:#10b981;"></i></div>
                                    <div class="wc-qs-info">
                                        <div class="wc-qs-label">Payments Today</div>
                                        <div class="wc-qs-sub">Completed: @stats.TodayStats.PaymentRequestsCompletedCount | Pending: @stats.TodayStats.PaymentRequestsPendingCount</div>
                                    </div>
                                    <div class="wc-qs-value green">@stats.TodayStats.PaymentRequestsCompletedCount / @stats.TodayStats.PaymentRequestsRaisedCount</div>
                                </div>
                                <div class="wc-qs-row">
                                    <div class="wc-qs-icon-wrap"><i class="bi bi-calendar2-check-fill" style="color:#6366f1;"></i></div>
                                    <div class="wc-qs-info">
                                        <div class="wc-qs-label">Appointments</div>
                                        <div class="wc-qs-sub">vs Yesterday</div>
                                    </div>
                                    <div class="wc-qs-value blue">@stats.TodayStats.TotalAppointments</div>
                                </div>
                                <div class="wc-qs-row">
                                    <div class="wc-qs-icon-wrap"><i class="bi bi-droplet-half" style="color:#06b6d4;"></i></div>
                                    <div class="wc-qs-info">
                                        <div class="wc-qs-label">Collections</div>
                                        <div class="wc-qs-sub">vs Yesterday (@stats.YesterdayStats.SampleCollectionsCount)</div>
                                    </div>
                                    <div class="wc-qs-value cyan">@stats.TodayStats.SampleCollectionsCount</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── QUICK ACTIONS ── -->
                    <div class="wc-actions-section">
                        <div class="wc-plan-header">
                            <div class="wc-glance-icon-box orange"><i class="bi bi-lightning-fill"></i></div>
                            <span class="wc-glance-title">QUICK ACTIONS</span>
                        </div>
                        <div class="wc-actions-row">
                            <a href="/maps" class="wc-action-btn" @onclick="DismissWelcome">
                                <div class="wc-action-icon" style="background:rgba(16,185,129,0.1);color:#10b981;"><i class="bi bi-geo-alt-fill"></i></div>
                                <span>Rider Tracking</span>
                            </a>
                            <a href="/appointments" class="wc-action-btn" @onclick="DismissWelcome">
                                <div class="wc-action-icon" style="background:rgba(99,102,241,0.1);color:#6366f1;"><i class="bi bi-calendar-plus-fill"></i></div>
                                <span>Add Appointment</span>
                            </a>
                            <a href="/transfer" class="wc-action-btn" @onclick="DismissWelcome">
                                <div class="wc-action-icon" style="background:rgba(6,182,212,0.1);color:#06b6d4;"><i class="bi bi-droplet-fill"></i></div>
                                <span>New Collection</span>
                            </a>
                            <a href="/report    " class="wc-action-btn" @onclick="DismissWelcome">
                                <div class="wc-action-icon" style="background:rgba(245,158,11,0.1);color:#f59e0b;"><i class="bi bi-bar-chart-fill"></i></div>
                                <span>Reports</span>
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="wc-err-box">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Unable to load statistics. Please try again.
                    </div>
                }
            </div>

            <!-- ── FIXED FOOTER ── -->
            <div class="wc-footer">
                <div class="wc-footer-left">
                    <i class="bi bi-lightning-charge-fill" style="color:#f59e0b;"></i>
                    <span>Keep up the excellent work!</span>
                </div>
                <button class="wc-letsgo-btn" @onclick="DismissWelcome">
                    <i class="bi bi-rocket-takeoff-fill"></i> Let's Go!
                </button>
            </div>

        </div>
    </div>
}

<!-- ── GOODBYE / LOGOUT OVERLAY ── -->
@if (showLogoutOverlay)
{
    <div class="lo-backdrop @(logoutSlideClass)">
        <div class="lo-card @(logoutSlideClass)">

            <!-- Confetti particles -->
            <div class="lo-confetti-wrap" aria-hidden="true">
                <span class="lo-conf c1">🎉</span><span class="lo-conf c2">⭐</span>
                <span class="lo-conf c3">🌟</span><span class="lo-conf c4">✨</span>
                <span class="lo-conf c5">🎊</span><span class="lo-conf c6">💫</span>
                <span class="lo-conf c7">🌈</span><span class="lo-conf c8">🎈</span>
            </div>

            <!-- Header gradient band -->
            <div class="lo-header-band">
                <div class="lo-badge-row">
                    <div class="lo-gift-badge">🎁 Day Wrap-up</div>
                </div>
                <h1 class="lo-headline">Congratulations! 🎉</h1>
                <p class="lo-sub-headline">You crushed it today, @session.UserName!</p>
            </div>

            <!-- Avatar section with Tata speech bubble -->
            <div class="lo-avatar-section">
                <div class="lo-avatar-stage">
                    <div class="lo-avatar-glow"></div>
                    <div class="lo-avatar-circle">
                        <img src="/images/welcome_avatar.png" class="lo-avatar-img" alt="Admin"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                        <div class="lo-avatar-initials-fb">@GetInitials(session.UserName)</div>
                    </div>
                    <!-- Tata speech bubble on the avatar -->
                    <div class="lo-speech-bubble">
                        <span class="lo-tata-text">Ta-ta! 👋</span>
                    </div>
                </div>
            </div>

            <!-- Today's achievements summary -->
            @if (stats != null)
            {
                <div class="lo-achievements">
                    <h3 class="lo-ach-title">🏆 Today's Achievements</h3>
                    <div class="lo-ach-grid">
                        <div class="lo-ach-card">
                            <div class="lo-ach-icon" style="background:rgba(16,185,129,0.12);color:#059669;">👥</div>
                            <div class="lo-ach-num">@stats.RiderStats.TotalRiders</div>
                            <div class="lo-ach-lbl">Riders Managed</div>
                        </div>
                        <div class="lo-ach-card">
                            <div class="lo-ach-icon" style="background:rgba(59,130,246,0.12);color:#2563eb;">📋</div>
                            <div class="lo-ach-num">@stats.TodayStats.TotalAppointments</div>
                            <div class="lo-ach-lbl">Appointments</div>
                        </div>
                        <div class="lo-ach-card">
                            <div class="lo-ach-icon" style="background:rgba(6,182,212,0.12);color:#0891b2;">💉</div>
                            <div class="lo-ach-num">@stats.TodayStats.TotalSamplesCollected</div>
                            <div class="lo-ach-lbl">Samples Collected</div>
                        </div>
                        <div class="lo-ach-card">
                            <div class="lo-ach-icon" style="background:rgba(245,158,11,0.12);color:#d97706;">💰</div>
                            <div class="lo-ach-num">@stats.TodayStats.PaymentRequestsCompletedCount / @stats.TodayStats.PaymentRequestsRaisedCount</div>
                            <div class="lo-ach-lbl">Payments</div>
                            <div style="padding: 2px 6px; border-radius: 6px; background: rgba(245,158,11,0.1); color: #d97706; font-size: 0.68rem; font-weight: 600; margin-top: 2px; display: inline-block;">
                                Completed: @stats.TodayStats.PaymentRequestsCompletedCount | Pending: @stats.TodayStats.PaymentRequestsPendingCount
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Goodbye messages -->
            <div class="lo-bye-section">
                <div class="lo-bye-message">@currentByeMessage</div>
            </div>

            <!-- Progress bar showing logout countdown -->
            <div class="lo-progress-section">
                <div class="lo-progress-bar">
                    <div class="lo-progress-fill" style="animation-duration: @(logoutCountdown)s;"></div>
                </div>
                <p class="lo-progress-label">Signing you out securely...</p>
            </div>

        </div>
    </div>
}

@if (isRedirecting)
{
    <div class="premium-loader-container" style="background: rgba(11, 15, 25, 0.95); backdrop-filter: blur(15px); z-index: 10005;">
        <div class="tactical-loader-orb">
            <div class="loader-glow" style="box-shadow: 0 0 30px rgba(99, 102, 241, 0.45);"></div>
            <i class="bi bi-shield-lock-fill" style="color: #6366f1; font-size: 2rem;"></i>
        </div>
        <div class="loader-text-wrap" style="text-align: center; margin-top: 20px;">
            <h4 style="color: #fff; font-size: 1.25rem; font-weight: 700; margin-bottom: 6px;">Secure Logout</h4>
            <span style="color: #94a3b8; font-size: 0.875rem;">Loading secure portal...</span>
        </div>
    </div>
}

<div class="chat-notifications-container">
    @foreach (var toast in _toasts)
    {
        <div class="chat-toast animate-slide-in" @onclick="() => OpenRiderChat(toast.RiderId, toast.RiderName)">
            <img src="@($"{ApiConfig.Value.BaseApiUrl}User/GetImage?imageType=profile-pics&riderId={toast.RiderId}&TenantId={_tenantState.TenantID}")" 
                 class="toast-profile-pic" 
                 style="width: 40px; height: 40px; border-radius: 12px; object-fit: cover; border: 1px solid rgba(255,255,255,0.15);" 
                 onerror="this.onerror=null; this.src='/images/default-avatar.png';" />
            <div class="toast-info">
                <span class="toast-sender">@toast.RiderName</span>
                <span class="toast-message">@toast.Message</span>
            </div>
            <button class="toast-close-btn" @onclick:stopPropagation="true" @onclick="() => DismissToast(toast.Id)">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }
</div>

<!-- Floating Comm Hub Speed Dial -->
<div class="global-comm-hub-wrapper" id="globalCommHub" style="position: fixed; bottom: 20px; right: 20px; z-index: 10000; touch-action: none; user-select: none;">
    <!-- Unread indicator for Chat when hub is collapsed -->
    @if (!isCommHubExpanded)
    {
        var unreadCount = GetTotalUnreadCount();
        @if (unreadCount > 0)
        {
            <div class="global-unread-badge-hub">@unreadCount</div>
        }
    }

    <!-- Chat Launcher Button (appears above hub when expanded) -->
    @if (session.Rights.IsAdmin || session.Rights.chat_level > 0)
    {
        var unreadCount = GetTotalUnreadCount();
        <div class="global-chat-launcher-hub @(isCommHubExpanded ? "expanded" : "")" @onclick="ToggleChatSidebar" title="Secure Chat with Riders">
            <div class="launcher-icon-orb">
                <i class="bi bi-chat-right-dots-fill"></i>
            </div>
            @if (unreadCount > 0)
            {
