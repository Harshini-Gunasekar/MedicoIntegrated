    /// <summary>Called by NavMenu / RightTop instead of direct logout.</summary>
    public async Task TriggerLogoutOverlay()
    {
        // Pick a random goodbye message
        currentByeMessage = ByeMessages[new Random().Next(ByeMessages.Length)];
        logoutSlideClass = "";
        showLogoutOverlay = true;
        isRedirecting = false;
        StateHasChanged();

        // ── Background logout happens IMMEDIATELY while the slide plays ──
        // Clear session on the UI/dispatcher thread concurrently with the animation
        var clearSessionTask = ClearSessionStorageAsync();

        // 6-second goodbye display runs concurrently with the background logout
        await Task.Delay(6000);

        // Slide out
        logoutSlideClass = "lo-exit";
        isRedirecting = true;
        StateHasChanged();

        // Initiate redirect immediately so that the login screen loads as the slide exits
        NavManager.NavigateTo("/", true);
    }

