    private List<NotifEntry> GetFilteredHistoryNotifications()
    {
        var items = NotifStore.Items.ToList();
        if (notifFilter == "All") return items;

        return items.Where(n =>
        {
            var type = (n.Type ?? "").ToLower();
            return notifFilter switch
            {
                "Alerts" => type == "danger" || type == "warning" || type == "alert",
                "Chat" => type == "chat" || type == "message",
                "Payments" => type == "payment" || type == "success" || type == "info",
                "System" => type == "system" || type == "info",
                _ => true
            };
        }).ToList();
    }

    private string GetRelativeTime(DateTime time)
    {
        var diff = DateTime.Now - time;
        if (diff.TotalSeconds < 60) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return time.ToString("dd MMM, hh:mm tt");
    }

