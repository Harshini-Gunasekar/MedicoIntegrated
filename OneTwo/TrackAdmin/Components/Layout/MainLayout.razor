<script>
    window.initializeHubDrag = () => {
        const hub = document.getElementById('globalCommHub');
        const trigger = document.getElementById('globalCommHubTrigger');
        if (!hub || !trigger) return;

        let isDragging = false;
        let dragMoved = false;
        let startX = 0, startY = 0;
        let offset = { x: 0, y: 0 };

        const startDrag = (clientX, clientY) => {
            isDragging = true;
            dragMoved = false;
            startX = clientX;
            startY = clientY;
            offset.x = clientX - hub.offsetLeft;
            offset.y = clientY - hub.offsetTop;
            hub.classList.add('dragging');
        };

        const doDrag = (clientX, clientY) => {
            if (!isDragging) return;
            const dx = clientX - startX;
            const dy = clientY - startY;
            if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
                dragMoved = true;
            }
            
            let x = clientX - offset.x;
            let y = clientY - offset.y;
            
            const maxX = window.innerWidth - hub.offsetWidth;
            const maxY = window.innerHeight - hub.offsetHeight;
            x = Math.max(0, Math.min(x, maxX));
            y = Math.max(0, Math.min(y, maxY));

            hub.style.left = x + 'px';
            hub.style.top = y + 'px';
            hub.style.right = 'auto';
            hub.style.bottom = 'auto';
        };

        const stopDrag = () => {
            if (isDragging) {
                isDragging = false;
                hub.classList.remove('dragging');
                if (dragMoved) {
                    trigger.classList.add('dragged-prevent-click');
                    setTimeout(() => {
                        trigger.classList.remove('dragged-prevent-click');
                    }, 50);
                }
            }
        };

        // Capture phase click handler to block trigger click on drag release
        trigger.addEventListener('click', (e) => {
            if (trigger.classList.contains('dragged-prevent-click')) {
                e.stopPropagation();
                e.preventDefault();
            }
        }, true);

        // Mouse events
        trigger.addEventListener('mousedown', (e) => {
            if (e.button !== 0) return;
            startDrag(e.clientX, e.clientY);
        });

        document.addEventListener('mousemove', (e) => {
            doDrag(e.clientX, e.clientY);
        });

        document.addEventListener('mouseup', stopDrag);

        // Touch events
        trigger.addEventListener('touchstart', (e) => {
            const touch = e.touches[0];
            startDrag(touch.clientX, touch.clientY);
        }, { passive: true });

        document.addEventListener('touchmove', (e) => {
            if (!isDragging) return;
            const touch = e.touches[0];
            doDrag(touch.clientX, touch.clientY);
        }, { passive: false });

        document.addEventListener('touchend', stopDrag);
    };
</script>

<!-- Broadcast Composer Modal -->
@if (showBroadcastModal)
{
    <div class="broadcast-modal-backdrop" @onclick="CloseBroadcastModal">
        <div class="broadcast-modal-card" @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="bm-header">
                <div class="bm-header-left">
                    <div class="bm-brain-orb">
                        <i class="bi bi-megaphone-fill"></i>
                    </div>
                    <div>
                        <div class="bm-title">Admin Broadcast</div>
                        <div class="bm-sub">Send push notification to riders</div>
                    </div>
                </div>
                <button class="bm-close-btn" @onclick="CloseBroadcastModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            @if (!broadcastConfirmStep)
            {
                <!-- Compose Step -->
                <div class="bm-body">
                    <!-- Target selector -->
                    <div class="bm-field">
                        <label class="bm-label">Send To</label>
                        <div class="bm-target-pills">
                            @foreach (var t in new[] { ("All", "bi-people-fill", "All Riders"), ("Online", "bi-circle-fill", "Online Only"), ("Offline", "bi-x-circle-fill", "Offline Only"), ("Specific", "bi-person-fill", "Specific Rider") })
                            {
                                var tValue = t.Item1; var tIcon = t.Item2; var tLabel = t.Item3;
                                <div class="bm-target-pill @(broadcastTarget == tValue ? "active" : "")" @onclick="() => broadcastTarget = tValue">
                                    <i class="bi @tIcon me-1"></i>@tLabel
                                </div>
                            }
                        </div>
                    </div>

                    @if (broadcastTarget == "Specific")
                    {
                        <div class="bm-field">
                            <label class="bm-label">Select Rider</label>
                            <select class="bm-select" @bind="broadcastSpecificRiderId">
                                <option value="">-- Select --</option>
                                @foreach (var r in broadcastRiderList)
                                {
                                    <option value="@r.RiderID">@r.ShortName (@r.Status)</option>
                                }
                            </select>
                        </div>
                    }

                    <!-- Priority -->
                    <div class="bm-field">
                        <label class="bm-label">Priority</label>
                        <div class="bm-priority-row">
                            <div class="bm-priority-pill @(broadcastPriority == "Normal" ? "active" : "")" @onclick='() => broadcastPriority = "Normal"'>
                                <i class="bi bi-bell me-1"></i>Normal
                            </div>
                            <div class="bm-priority-pill urgent @(broadcastPriority == "Urgent" ? "active" : "")" @onclick='() => broadcastPriority = "Urgent"'>
                                <i class="bi bi-exclamation-octagon-fill me-1"></i>🔴 Urgent
                            </div>
                        </div>
                    </div>

                    <!-- Message -->
                    <div class="bm-field">
                        <label class="bm-label">Message <span class="bm-char-count @(broadcastMessage.Length > 180 ? "warn" : "")">@broadcastMessage.Length / 200</span></label>
                        <textarea class="bm-textarea" maxlength="200" rows="4" placeholder="Type your announcement here..." @bind="broadcastMessage" @bind:event="oninput"></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(broadcastError))
                    {
                        <div class="bm-error">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@broadcastError
                        </div>
                    }

                    <button class="bm-send-btn" @onclick="ProceedToBroadcastConfirm" disabled="@(string.IsNullOrWhiteSpace(broadcastMessage))">
                        <i class="bi bi-send-fill me-2"></i>Preview & Send
                    </button>
                </div>
            }
            else if (!broadcastSent)
            {
                <!-- Confirm Step -->
                <div class="bm-body bm-confirm">
                    <div class="bm-confirm-icon">
                        <i class="bi bi-send-check-fill"></i>
                    </div>
                    <div class="bm-confirm-title">Ready to Broadcast?</div>
                    <div class="bm-confirm-preview">
                        <div class="bm-preview-to">To: <strong>@GetBroadcastTargetLabel()</strong></div>
                        <div class="bm-preview-priority @(broadcastPriority == "Urgent" ? "urgent" : "")">Priority: @broadcastPriority</div>
                        <div class="bm-preview-msg">"@broadcastMessage"</div>
                    </div>
                    @if (!string.IsNullOrEmpty(broadcastError))
                    {
                        <div class="bm-error">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@broadcastError
                        </div>
                    }
                    <div class="bm-confirm-btns">
                        <button class="bm-back-btn" @onclick="() => broadcastConfirmStep = false">
                            <i class="bi bi-arrow-left me-1"></i>Edit
                        </button>
                        <button class="bm-confirm-send-btn" @onclick="SendBroadcast" disabled="@broadcastSending">
                            @if (broadcastSending)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Sending...</span>
                            }
                            else
                            {
                                <i class="bi bi-megaphone-fill me-2"></i>
                                <span>Send Now</span>
                            }
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Success Step -->
                <div class="bm-body bm-success">
                    <div class="bm-success-icon">✅</div>
                    <div class="bm-success-title">Broadcast Sent!</div>
                    <div class="bm-success-sub">Sent to <strong>@broadcastSentCount</strong> rider(s) successfully.</div>
                    <button class="bm-send-btn" @onclick="CloseBroadcastModal">Close</button>
                </div>
            }
        </div>
    </div>
}

