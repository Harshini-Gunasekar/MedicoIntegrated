@using TrackAdmin.Data
@inject PageMetadataService Metadata
@inject IJSRuntime JS
@implements IDisposable

<header class="alpha-context-header glass-morphic animate-fade-in">
    <div class="header-left">
        <div class="page-icon-orb">
            <i class="bi @Metadata.Icon"></i>
        </div>
        <div class="page-title-group">
            <h1 class="page-title">@Metadata.Title</h1>
            <span class="page-subtitle">@Metadata.Subtitle</span>
        </div>
    </div>

    <div class="header-right">
        @if (Metadata.Stats != null && Metadata.Stats.Any())
        {
            <div class="page-stats-container">
                @{
                    var statsList = Metadata.Stats.ToList();
                    for (int i = 0; i < statsList.Count; i++)
                    {
                        var stat = statsList[i];
                        <div class="header-stat-item">
                            <span class="stat-label">@stat.Label</span>
                            <span class="stat-value @stat.Color">@stat.Value</span>
                        </div>
                        @if (i < statsList.Count - 1)
                        {
                            <div class="stat-separator"></div>
                        }
                    }
                }
            </div>
        }

        <button type="button" class="theme-toggle-btn ms-3" @onclick="ToggleTheme" title="Toggle Light/Dark Theme">
            <i class="bi @(isDarkTheme ? "bi-sun-fill text-warning animate-spin-once" : "bi-moon-stars-fill text-primary-glow")"></i>
        </button>
    </div>
</header>

@code {
    private bool isDarkTheme;

    protected override void OnInitialized()
    {
        Metadata.OnChange += OnMetadataChange;
    }

    private void OnMetadataChange()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("ThemeManager.getTheme");
                isDarkTheme = (theme == "dark");
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            isDarkTheme = await JS.InvokeAsync<bool>("ThemeManager.toggleTheme");
            StateHasChanged();
        }
        catch { }
    }

    public void Dispose()
    {
        Metadata.OnChange -= OnMetadataChange;
    }
}

<style>
    .alpha-context-header {
        height: 80px;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--border-light);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 30px;
        position: sticky;
        top: 0;
        z-index: 900;
        margin-bottom: 25px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .page-icon-orb {
        width: 48px;
        height: 48px;
        background: var(--accent-primary);
        color: white;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.2);
    }

    .page-title-group {
        display: flex;
        flex-direction: column;
    }

    .page-title {
        font-size: 20px;
        font-weight: 800;
        color: var(--text-primary);
        margin: 0;
        letter-spacing: -0.5px;
    }

    .page-subtitle {
        font-size: 12px;
        color: var(--text-secondary);
        font-weight: 600;
    }

    .header-right {
        display: flex;
        align-items: center;
    }

    .page-stats-container {
        display: flex;
        align-items: center;
        gap: 24px;
        background: #f8fafc;
        padding: 10px 24px;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .header-stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .stat-label {
        font-size: 10px;
        font-weight: 800;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-value {
        font-size: 16px;
        font-weight: 800;
        line-height: 1.2;
    }

    .stat-separator {
        width: 1px;
        height: 24px;
        background: #cbd5e1;
    }
</style>
