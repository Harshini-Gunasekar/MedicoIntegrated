@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<div class="sf-rich-text-wrapper @(ClassName)">
    <div @ref="toolbarElement" class="sf-toolbar">
        <span class="ql-formats">
            <select class="ql-font">
                <option selected>Sans Serif</option>
                <option value="serif">Serif</option>
                <option value="monospace">Monospace</option>
            </select>
            <select class="ql-size">
                <option value="8px">8px</option>
                <option value="10px">10px</option>
                <option value="12px">12px</option>
                <option value="14px" selected>14px</option>
                <option value="16px">16px</option>
                <option value="18px">18px</option>
                <option value="20px">20px</option>
                <option value="24px">24px</option>
                <option value="32px">32px</option>
            </select>
        </span>
        <span class="ql-formats">
            <button class="ql-bold" title="Bold"></button>
            <button class="ql-italic" title="Italic"></button>
            <button class="ql-underline" title="Underline"></button>
            <button class="ql-strike" title="Strike"></button>
        </span>
        <span class="ql-formats">
            <button class="ql-script" value="sub" title="Subscript (Subset)"></button>
            <button class="ql-script" value="super" title="Superscript (Superset)"></button>
        </span>
        <span class="ql-formats">
            <select class="ql-align" title="Alignment"></select>
            <button class="ql-list" value="ordered" title="Ordered List"></button>
            <button class="ql-list" value="bullet" title="Bullet List"></button>
        </span>
        <span class="ql-formats">
            <button type="button" @onclick="IncreaseFontSize" title="Increase Font Size">
                <i class="fas fa-plus" style="font-size: 10px;"></i>
                <span style="font-size: 14px; font-weight: bold; margin-left: 2px;">A</span>
            </button>
            <button type="button" @onclick="DecreaseFontSize" title="Decrease Font Size">
                <i class="fas fa-minus" style="font-size: 10px;"></i>
                <span style="font-size: 11px; font-weight: bold; margin-left: 2px;">A</span>
            </button>
        </span>
        <span class="ql-formats">
            <button class="ql-color"></button>
            <button class="ql-background"></button>
        </span>
        <span class="ql-formats">
            <button class="ql-clean" title="Clear Formatting"></button>
        </span>
    </div>
    <div @ref="editorElement" id="@Id" class="sf-editor-container"></div>
</div>

<style>
    .sf-rich-text-wrapper {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        display: flex;
        flex-direction: column;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .sf-rich-text-wrapper:focus-within {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }

    .sf-toolbar {
        border-bottom: 1px solid #f1f5f9 !important;
        background: #f8fafc !important;
        padding: 8px !important;
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    .ql-toolbar.ql-snow {
        border: none !important;
    }

    .sf-editor-container {
        min-height: 150px;
        font-family: 'Public Sans', sans-serif;
    }

    .ql-container.ql-snow {
        border: none !important;
    }

    .ql-editor {
        padding: 16px !important;
        font-size: 14px;
        line-height: 1.6;
        color: #1e293b;
    }

    .ql-editor.ql-blank::before {
        color: #94a3b8 !important;
        font-style: normal !important;
    }

    .sf-toolbar button[type="button"] {
        background: none;
        border: none;
        cursor: pointer;
        display: inline-block;
        float: left;
        height: 24px;
        padding: 3px 5px;
        width: 32px;
        color: #444;
        border-radius: 4px;
        transition: background 0.2s;
    }

    .sf-toolbar button[type="button"]:hover {
        background-color: #e2e8f0;
        color: #06c;
    }
</style>

@code {
    [Parameter] public string Id { get; set; } = $"sf-editor-{Guid.NewGuid():N}";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Type here...";
    [Parameter] public string ClassName { get; set; } = "";

    private ElementReference editorElement;
    private ElementReference toolbarElement;
    private bool _isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("QuillHelper.init", editorElement, toolbarElement, Placeholder, Value, DotNetObjectReference.Create(this));
            _isInitialized = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_isInitialized && Value != await GetHtml())
        {
            await SetHtml(Value);
        }
    }

    [JSInvokable]
    public async Task OnContentChanged(string html)
    {
        Value = html;
        await ValueChanged.InvokeAsync(Value);
    }

    public async Task<string> GetHtml()
    {
        return await JSRuntime.InvokeAsync<string>("QuillHelper.getHtml", Id);
    }

    public async Task SetHtml(string html)
    {
        await JSRuntime.InvokeVoidAsync("QuillHelper.setHtml", Id, html);
    }

    private async Task IncreaseFontSize()
    {
        await JSRuntime.InvokeVoidAsync("QuillHelper.changeFontSize", Id, 2);
    }

    private async Task DecreaseFontSize()
    {
        await JSRuntime.InvokeVoidAsync("QuillHelper.changeFontSize", Id, -2);
    }
}
