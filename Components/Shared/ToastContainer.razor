@using Booking.Services
@inject ToastService ToastService
@implements IDisposable

<div class="toast-container">
    @foreach (var toast in ToastService.Toasts)
    {
        <div class="toast-item @toast.Type" role="alert">
            <div class="toast-glow-accent"></div>
            
            <div class="toast-icon-outer">
                @if (toast.Type == "success")
                {
                    <div class="icon-pulse-wrapper success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                }
                else if (toast.Type == "info")
                {
                    <div class="icon-pulse-wrapper info">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                    </div>
                }
                else if (toast.Type == "warning")
                {
                    <div class="icon-pulse-wrapper warning">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                    </div>
                }
                else
                {
                    <div class="icon-pulse-wrapper error">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="15" y1="9" x2="9" y2="15"></line>
                            <line x1="9" y1="9" x2="15" y2="15"></line>
                        </svg>
                    </div>
                }
            </div>

            <div class="toast-content">
                <div class="toast-header-row">
                    <span class="toast-title">
                        @(toast.Type == "success" ? "Success" : toast.Type == "info" ? "Notice" : toast.Type == "warning" ? "Warning" : "Error")
                    </span>
                    <span class="toast-timestamp">Just now</span>
                </div>
                <div class="toast-message">@toast.Message</div>
            </div>

            <button type="button" class="toast-close-btn" @onclick="() => CloseToast(toast)" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>

            <div class="toast-progress"></div>
        </div>
    }
</div>

<style>
    .toast-container {
        position: fixed;
        top: 1.5rem;
        right: 1.5rem;
        z-index: 999999;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        pointer-events: none;
        font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    
    .toast-item {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        min-width: 360px;
        max-width: 440px;
        padding: 1.1rem 1.25rem 1.25rem 1.1rem;
        background: rgba(15, 23, 42, 0.88);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        box-shadow: 
            0 20px 40px -15px rgba(0, 0, 0, 0.5),
            0 0 0 1px rgba(255, 255, 255, 0.08) inset,
            0 1px 0 0 rgba(255, 255, 255, 0.2) inset;
        pointer-events: auto;
        overflow: hidden;
        animation: toastEntrance 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards, toastExit 0.4s cubic-bezier(0.7, 0, 0.84, 0) 4.6s forwards;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .toast-item:hover {
        transform: translateY(-3px) scale(1.01);
        box-shadow: 
            0 25px 50px -12px rgba(0, 0, 0, 0.65),
            0 0 25px rgba(255, 255, 255, 0.15),
            0 0 0 1px rgba(255, 255, 255, 0.25) inset;
    }

    /* Left Glowing Accent Bar */
    .toast-glow-accent {
        position: absolute;
        top: 12px;
        left: 0;
        bottom: 12px;
        width: 4px;
        border-radius: 0 4px 4px 0;
        transition: all 0.3s ease;
    }

    .toast-item.success .toast-glow-accent {
        background: linear-gradient(180deg, #10b981, #34d399);
        box-shadow: 0 0 12px #10b981, 0 0 20px rgba(16, 185, 129, 0.6);
    }
    .toast-item.info .toast-glow-accent {
        background: linear-gradient(180deg, #06b6d4, #38bdf8);
        box-shadow: 0 0 12px #06b6d4, 0 0 20px rgba(6, 182, 212, 0.6);
    }
    .toast-item.warning .toast-glow-accent {
        background: linear-gradient(180deg, #f59e0b, #fbbf24);
        box-shadow: 0 0 12px #f59e0b, 0 0 20px rgba(245, 158, 11, 0.6);
    }
    .toast-item.error .toast-glow-accent {
        background: linear-gradient(180deg, #f43f5e, #fb7185);
        box-shadow: 0 0 12px #f43f5e, 0 0 20px rgba(244, 63, 94, 0.6);
    }

    /* Icon Pulse Container */
    .toast-icon-outer {
        flex-shrink: 0;
        margin-top: 1px;
    }

    .icon-pulse-wrapper {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        transition: all 0.3s ease;
    }

    .icon-pulse-wrapper.success {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #34d399;
        box-shadow: 0 0 15px rgba(16, 185, 129, 0.2);
    }
    .icon-pulse-wrapper.info {
        background: rgba(6, 182, 212, 0.15);
        border: 1px solid rgba(6, 182, 212, 0.3);
        color: #38bdf8;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.2);
    }
    .icon-pulse-wrapper.warning {
        background: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.3);
        color: #fbbf24;
        box-shadow: 0 0 15px rgba(245, 158, 11, 0.2);
    }
    .icon-pulse-wrapper.error {
        background: rgba(244, 63, 94, 0.15);
        border: 1px solid rgba(244, 63, 94, 0.3);
        color: #fb7185;
        box-shadow: 0 0 15px rgba(244, 63, 94, 0.2);
    }

    .toast-item:hover .icon-pulse-wrapper {
        transform: scale(1.08);
    }

    /* Content Area */
    .toast-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .toast-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .toast-title {
        font-size: 0.92rem;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: -0.01em;
        line-height: 1.2;
    }

    .toast-timestamp {
        font-size: 0.72rem;
        font-weight: 500;
        color: #64748b;
        background: rgba(255, 255, 255, 0.06);
        padding: 2px 8px;
        border-radius: 99px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        letter-spacing: 0.02em;
    }

    .toast-message {
        font-size: 0.84rem;
        font-weight: 450;
        color: #cbd5e1;
        line-height: 1.45;
        word-break: break-word;
    }

    /* Close Button */
    .toast-close-btn {
        flex-shrink: 0;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        width: 26px;
        height: 26px;
        cursor: pointer;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        margin-top: 1px;
    }

    .toast-close-btn:hover {
        background: rgba(255, 255, 255, 0.18);
        border-color: rgba(255, 255, 255, 0.3);
        color: #ffffff;
        transform: rotate(90deg) scale(1.1);
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
    }

    .toast-close-btn:active {
        transform: rotate(90deg) scale(0.95);
    }

    /* Animated Glowing Progress Bar */
    .toast-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 3px;
        border-radius: 0 0 16px 16px;
        animation: progress 4.6s linear forwards;
    }

    .toast-item.success .toast-progress {
        background: linear-gradient(90deg, #10b981, #34d399, #059669);
        box-shadow: 0 0 10px #10b981, 0 0 4px #34d399;
    }
    .toast-item.info .toast-progress {
        background: linear-gradient(90deg, #06b6d4, #38bdf8, #2563eb);
        box-shadow: 0 0 10px #06b6d4, 0 0 4px #38bdf8;
    }
    .toast-item.warning .toast-progress {
        background: linear-gradient(90deg, #f59e0b, #fbbf24, #d97706);
        box-shadow: 0 0 10px #f59e0b, 0 0 4px #fbbf24;
    }
    .toast-item.error .toast-progress {
        background: linear-gradient(90deg, #f43f5e, #fb7185, #dc2626);
        box-shadow: 0 0 10px #f43f5e, 0 0 4px #fb7185;
    }

    @@keyframes toastEntrance {
        0% {
            transform: translateX(120%) scale(0.85) rotate(2deg);
            opacity: 0;
            filter: blur(8px);
        }
        70% {
            transform: translateX(-4px) scale(1.02) rotate(-0.5deg);
            opacity: 1;
            filter: blur(0);
        }
        100% {
            transform: translateX(0) scale(1) rotate(0deg);
            opacity: 1;
            filter: blur(0);
        }
    }

    @@keyframes toastExit {
        0% {
            transform: translateX(0) scale(1);
            opacity: 1;
            filter: blur(0);
        }
        100% {
            transform: translateX(120%) scale(0.9);
            opacity: 0;
            filter: blur(10px);
        }
    }

    @@keyframes progress {
        0% { width: 100%; }
        100% { width: 0%; }
    }
</style>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnShow += NotifyStateChanged;
    }

    private void NotifyStateChanged() => InvokeAsync(StateHasChanged);

    private void CloseToast(ToastMessage toast)
    {
        ToastService.Toasts.Remove(toast);
        StateHasChanged();
    }

    public void Dispose()
    {
        ToastService.OnShow -= NotifyStateChanged;
    }
}

