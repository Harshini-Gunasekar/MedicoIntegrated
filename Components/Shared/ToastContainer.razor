@using Booking.Services
@inject ToastService ToastService
@implements IDisposable

<div class="toast-container">
    @foreach (var toast in ToastService.Toasts)
    {
        <div class="toast-item @toast.Type">
            <div class="toast-icon-outer">
                @if (toast.Type == "success")
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="12" fill="url(#successGradient)"/>
                        <path d="M7.5 12L10.5 15L16.5 9" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <defs>
                            <linearGradient id="successGradient" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#10b981"/>
                                <stop offset="1" stop-color="#059669"/>
                            </linearGradient>
                        </defs>
                    </svg>
                }
                else if (toast.Type == "info")
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="12" fill="url(#infoGradient)"/>
                        <rect x="11" y="10" width="2" height="7" rx="1" fill="white"/>
                        <circle cx="12" cy="6.5" r="1.5" fill="white"/>
                        <defs>
                            <linearGradient id="infoGradient" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#3b82f6"/>
                                <stop offset="1" stop-color="#2563eb"/>
                            </linearGradient>
                        </defs>
                    </svg>
                }
                else if (toast.Type == "warning")
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="12" fill="url(#warnGradient)"/>
                        <rect x="11" y="9" width="2" height="6" rx="1" fill="white"/>
                        <circle cx="12" cy="18" r="1.5" fill="white"/>
                        <defs>
                            <linearGradient id="warnGradient" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#f59e0b"/>
                                <stop offset="1" stop-color="#d97706"/>
                            </linearGradient>
                        </defs>
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="12" fill="url(#errorGradient)"/>
                        <rect x="11" y="9" width="2" height="6" rx="1" fill="white"/>
                        <circle cx="12" cy="18" r="1.5" fill="white"/>
                        <defs>
                            <linearGradient id="errorGradient" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#ef4444"/>
                                <stop offset="1" stop-color="#dc2626"/>
                            </linearGradient>
                        </defs>
                    </svg>
                }
            </div>
            <div class="toast-content">
                <div class="toast-title">@(toast.Type == "success" ? "Success" : toast.Type == "info" ? "Info" : toast.Type == "warning" ? "Warning" : "Error")</div>
                <div class="toast-message">@toast.Message</div>
            </div>
            <button type="button" class="toast-close-btn" @onclick="() => CloseToast(toast)" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                </svg>
            </button>
            <div class="toast-progress"></div>
        </div>
    }
</div>

<style>
    .toast-container {
        position: fixed;
        top: 2rem;
        right: 2rem;
        z-index: 10000;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        pointer-events: none;
    }
    
    .toast-item {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 12px;
        padding: 1rem 1.25rem;
        box-shadow: 0 10px 40px -10px rgba(0,0,0,0.1), 0 0 0 1px rgba(255,255,255,0.2) inset;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        min-width: 340px;
        max-width: 420px;
        pointer-events: auto;
        position: relative;
        overflow: hidden;
        animation: toastSlideIn 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.1) forwards, toastSlideOut 0.5s cubic-bezier(0.8, -0.1, 1, 1) 4.5s forwards;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .toast-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 45px -10px rgba(0,0,0,0.15), 0 0 0 1px rgba(255,255,255,0.3) inset;
    }
    

    .toast-icon-outer {
        margin-top: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));
    }
    
    .toast-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .toast-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
        font-family: 'Inter', system-ui, sans-serif;
        text-transform: capitalize;
    }

    .toast-message { 
        font-size: 0.85rem; 
        font-weight: 500; 
        color: #475569; 
        font-family: 'Inter', system-ui, sans-serif;
        line-height: 1.4;
    }

    .toast-close-btn {
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 4px;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        transition: all 0.2s ease;
        margin-top: -2px;
        margin-right: -4px;
    }
    .toast-close-btn:hover {
        background: rgba(0, 0, 0, 0.05);
        color: #0f172a;
    }

    .toast-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 3px;
        background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.8) 50%, rgba(255,255,255,0) 100%);
        animation: progress 4.5s linear forwards;
    }
    
    .toast-item.success .toast-progress { background: #10b981; }
    .toast-item.info .toast-progress { background: #3b82f6; }
    .toast-item.warning .toast-progress { background: #f59e0b; }
    .toast-item.error .toast-progress { background: #ef4444; }

    @@keyframes toastSlideIn {
        from { transform: translateX(120%) scale(0.9); opacity: 0; }
        to { transform: translateX(0) scale(1); opacity: 1; }
    }
    @@keyframes toastSlideOut {
        from { transform: translateX(0) scale(1); opacity: 1; }
        to { transform: translateX(120%) scale(0.9); opacity: 0; }
    }
    @@keyframes progress {
        from { width: 100%; }
        to { width: 0%; }
    }
</style>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnShow += NotifyStateChanged;
    }

    private void NotifyStateChanged() => InvokeAsync(StateHasChanged);

    private void CloseToast(ToastMessage toast)
    {
        ToastService.Toasts.Remove(toast);
        StateHasChanged();
    }

    public void Dispose()
    {
        ToastService.OnShow -= NotifyStateChanged;
    }
}
