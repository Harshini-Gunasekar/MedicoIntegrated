@using Booking.Services
@inject ToastService ToastService
@implements IDisposable

<div class="toast-container">
    @foreach (var toast in ToastService.Toasts)
    {
        <div class="toast-item @toast.Type">
            <div class="toast-icon"><i class="bi @(toast.Type == "error" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")"></i></div>
            <div class="toast-content">
                <div class="toast-message">@toast.Message</div>
            </div>
        </div>
    }
</div>

<style>
    .toast-container {
        position: fixed;
        top: 1.5rem;
        right: 1.5rem;
        z-index: 10000;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        pointer-events: none;
    }
    .toast-item {
        background: white;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 300px;
        pointer-events: auto;
        border-left: 4px solid transparent;
        animation: toastIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), toastOut 0.5s ease-in 4.5s forwards;
    }
    .toast-item.error { border-left-color: #ef4444; }
    .toast-item.success { border-left-color: #10b981; }
    
    .toast-icon { font-size: 1.25rem; }
    .toast-item.error .toast-icon { color: #ef4444; }
    .toast-item.success .toast-icon { color: #10b981; }
    
    .toast-message { font-size: 0.9rem; font-weight: 700; color: #1e293b; }

    @@keyframes toastIn {
        from { transform: translateX(120%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
    @@keyframes toastOut {
        from { transform: scale(1); opacity: 1; }
        to { transform: scale(0.95); opacity: 0; }
    }
</style>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnShow += NotifyStateChanged;
    }

    private void NotifyStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ToastService.OnShow -= NotifyStateChanged;
    }
}
