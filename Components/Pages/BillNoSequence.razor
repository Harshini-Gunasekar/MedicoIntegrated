@page "/billno-sequence"
@rendermode InteractiveServer
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.CounterMasterService CounterService
@inject Booking.Services.ToastService ToastService
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JsRuntime
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@using Booking.Models
@using Newtonsoft.Json

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">format_list_numbered</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Bill No Sequence Configuration</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Numbering Inventory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            @if (TenantState.HasActionRight("Lab", "Print Lab Result", "Create"))
            {
                <button class="btn-new-entry" @onclick="OpenCreateModal">+ Add New Sequence</button>
            }
        </div>
    </div>

    @* --- Directory List Table --- *@
    <div class="directory-section">
        <div class="lc-table-container">
            @if (isLoadingList)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (sequenceList == null || !sequenceList.data.Any())
            {
                <div class="text-center py-5 text-slate-400 italic">
                    No bill number sequences configured yet.
                </div>
            }
            else
            {
                <table class="lc-table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">S.NO</th>
                            <th>RECEIPT NAME</th>
                            <th style="width: 140px;">SHORTNAME</th>
                            <th style="width: 100px;">DEFAULT</th>
                            <th style="width: 150px;">RESTART RULE</th>
                            <th>BRANCH / COUNTER SCOPE</th>
                            <th style="width: 120px;">ROWS USED</th>
                            <th class="text-center" style="width: 100px;">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int sno = (listRequest.page - 1) * listRequest.pagesize + 1; }
                        @foreach (var seq in sequenceList.data)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"{sno++:00}")</span></td>
                                <td class="font-bold text-slate-800">@seq.name</td>
                                <td><span class="badge-custom badge-purple">@seq.shortname</span></td>
                                <td>
                                    @if (seq.isdefault)
                                    {
                                        <span class="badge-custom badge-green">Default</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">-</span>
                                    }
                                </td>
                                <td>
                                    @if (seq.restartmonthly) { <span>Monthly</span> }
                                    else if (seq.restartdaily) { <span>Daily</span> }
                                    else if (seq.restartfinancialyear) { <span>Financial Year</span> }
                                    else if (seq.restartcalendaryear) { <span>Calendar Year</span> }
                                    else { <span>Never</span> }
                                </td>
                                <td class="text-slate-600">
                                    @{
                                        var branchLabel = seq.allbranch ? "All Branches" : (branches.FirstOrDefault(b => b.bh_code == seq.bhcode)?.name ?? $"Branch {seq.bhcode}");
                                        var counterLabel = seq.allcounter ? "All Counters" : (counters.FirstOrDefault(c => c.cntcode == seq.cntcode)?.name ?? $"Counter {seq.cntcode}");
                                    }
                                    @branchLabel / @counterLabel
                                </td>
                                <td class="text-slate-500 font-bold">@(seq.sequence_rows_in_use ?? 0)</td>
                                <td class="text-center">
                                    <div style="display: flex; justify-content: center; gap: 6px;">
                                        @if (TenantState.HasActionRight("Lab", "Print Lab Result", "Edit"))
                                        {
                                            <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => OpenEditModal(seq)" title="Edit">
                                                <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                            </button>
                                        }
                                        <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => PromptDeleteSequence(seq)" title="Delete" style="color: #ef4444;">
                                            <span class="material-symbols-outlined font-18" style="color: #ef4444;">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @* --- Pagination --- *@
                <div class="pagination-area">
                    <div class="pagination-info">
                        Showing @((listRequest.page - 1) * listRequest.pagesize + (sequenceList?.data.Count > 0 ? 1 : 0)) to @((listRequest.page - 1) * listRequest.pagesize + (sequenceList?.data.Count ?? 0)) of @(sequenceList?.total ?? 0) records
                    </div>
                    <div class="pagination-controls">
                        <button class="page-btn" disabled="@(listRequest.page <= 1)" @onclick="PrevPage">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button class="page-btn" disabled="@(sequenceList?.data.Count < listRequest.pagesize)" @onclick="NextPage">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* --- FORM MODAL --- *@
@if (showModal)
{
    <div class="modal-overlay">
        <div class="modal-form-card">
            <div class="modal-header-bar">
                <h3>@(isEditMode ? "Edit Configuration Entry" : "New Configuration Entry")</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseModal" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>
            
            <div class="modal-body">
                <div class="um-grid-cols-2">
                    @* --- Left Column --- *@
                    <div>
                        <div class="form-group">
                            <label>Receipt Name *</label>
                            <input type="text" class="lab-input" @bind="currentConfig.name" placeholder="Receipt Number" required />
                        </div>
                        <div class="form-group">
                            <label>Short Name (Prefix) *</label>
                            <input type="text" class="lab-input" @bind="currentConfig.shortname" placeholder="RCP" required />
                        </div>
                        <div class="form-group">
                            <label>Initial Order No</label>
                            <input type="number" class="lab-input" @bind="currentConfig.orderno" placeholder="0" />
                        </div>
                    </div>

                    @* --- Right Column --- *@
                    <div>
                        <div class="form-group">
                            <label>RESTART LOGIC</label>
                            <select class="lab-input" value="@GetRestartLogic()" @onchange="OnRestartLogicChanged">
                                <option value="none">Never</option>
                                <option value="daily">Daily</option>
                                <option value="monthly">Monthly</option>
                                <option value="calendaryear">Calendar Year</option>
                                <option value="financialyear">Financial Year</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>BRANCH</label>
                            <select class="lab-input" value="@currentConfig.bhcode" @onchange="OnBranchChanged">
                                <option value="">-- Select Branch --</option>
                                @foreach (var b in branches)
                                {
                                    <option value="@b.bh_code">@b.name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>COUNTER</label>
                            <select class="lab-input" @bind="currentConfig.cntcode">
                                <option value="">-- Select Counter --</option>
                                @foreach (var c in filteredCounters)
                                {
                                    <option value="@c.cntcode">@c.name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                


                @if (isEditMode)
                {
                    <div class="alert alert-danger mb-0 mt-3" style="font-size: 0.85rem; border-radius: 10px; padding: 12px; margin-top: 16px;">
                        <span>
                            <strong>Note:</strong> This sequence has already been used for <strong>@(currentConfig.sequence_rows_in_use ?? 0)</strong> @(currentConfig.sequence_rows_in_use == 1 ? "row" : "rows"). Changing logic may affect ongoing sequences.
                        </span>
                    </div>
                }
            </div>

            <div class="modal-footer-bar" style="display: flex; justify-content: space-between; align-items: center;">
                @if (isEditMode)
                {
                    <button type="button" class="btn-delete-seq" @onclick="() => PromptDeleteSequence(currentConfig)" disabled="@isSaving">
                        <span class="material-symbols-outlined" style="font-size:16px; margin-right:6px;">delete</span>
                        <span>Delete</span>
                    </button>
                }
                else
                {
                    <div></div>
                }
                <button type="button" class="btn-save" @onclick="SaveSequenceAsync" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                        </svg>
                        <span>Save Configuration</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* --- DELETE CONFIRMATION MODAL CARD --- *@
@if (showDeleteModal && sequenceToDelete != null)
{
    <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1300; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px);" @onclick="CancelDeleteModal"></div>
    <div class="confirm-card-modal" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1301; max-width: 440px; width: 90%; background: #ffffff; border-radius: 16px; box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.25); overflow: hidden; animation: popIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);">
        <div class="confirm-card-header" style="display: flex; align-items: center; justify-content: space-between; padding: 18px 24px; border-bottom: 1px solid #f1f5f9; background: #ffffff;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: #fef2f2; color: #ef4444; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: #0f172a;">Delete Sequence</h3>
                    <span style="font-size: 0.78rem; color: #64748b;">Confirm sequence deletion</span>
                </div>
            </div>
            <button type="button" @onclick="CancelDeleteModal" style="background: none; border: none; font-size: 22px; color: #94a3b8; cursor: pointer; padding: 4px; line-height: 1;">&times;</button>
        </div>
        <div class="confirm-card-body" style="padding: 20px 24px;">
            <p style="margin-bottom: 0.75rem; font-size: 0.92rem; color: #334155; line-height: 1.5;">
                Are you sure you want to delete the sequence <strong style="color: #0f172a;">'@sequenceToDelete.name'</strong> (@sequenceToDelete.shortname)?
            </p>
            <div style="display: flex; align-items: flex-start; gap: 10px; background: #fff1f2; border: 1px solid #ffe4e6; border-radius: 8px; padding: 12px; color: #be123c; font-size: 0.82rem;">
                <i class="bi bi-exclamation-triangle-fill" style="color: #e11d48; margin-top: 1px;"></i>
                <span>This action cannot be undone and will permanently remove this numbering configuration.</span>
            </div>
        </div>
        <div class="confirm-card-footer" style="display: flex; justify-content: flex-end; gap: 10px; padding: 16px 24px; background: #f8fafc; border-top: 1px solid #f1f5f9;">
            <button type="button" class="btn-confirm-cancel" style="padding: 8px 18px; border-radius: 8px; border: 1px solid #cbd5e1; background: #ffffff; color: #475569; font-weight: 600; font-size: 0.88rem; cursor: pointer; transition: all 0.2s;" @onclick="CancelDeleteModal" disabled="@isDeleteProcessing">Cancel</button>
            <button type="button" class="btn-confirm-action" style="padding: 8px 20px; border-radius: 8px; border: none; background: linear-gradient(135deg, #ef4444, #dc2626); color: #ffffff; font-weight: 600; font-size: 0.88rem; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);" @onclick="ExecuteDeleteSequenceAsync" disabled="@isDeleteProcessing">
                @if (isDeleteProcessing)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Deleting...</span>
                }
                else
                {
                    <i class="bi bi-trash3 me-1"></i>
                    <span>Yes, Delete</span>
                }
            </button>
        </div>
    </div>
}

@code {
    private string TenantCode = "";
    private string AuthToken = "";

    private BillNoListRequest listRequest = new BillNoListRequest { page = 1, pagesize = 20 };
    private BillNoListResponse? sequenceList;
    private bool isLoadingList = true;

    private bool showModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private BillNoConfig currentConfig = new BillNoConfig();

    private bool showDeleteModal = false;
    private bool isDeleteProcessing = false;
    private BillNoConfig? sequenceToDelete = null;

    private List<Booking.Models.BranchModel> branches = new();
    private List<Medico_Backend.Model.CounterMasterModel> counters = new();
    private List<Medico_Backend.Model.CounterMasterModel> filteredCounters = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadListAsync();
        await LoadCountersAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                await LoadBranchesAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading session details: {ex.Message}");
            }
        }
    }

    private async Task LoadListAsync()
    {
        isLoadingList = true;
        StateHasChanged();
        
        sequenceList = await HmsBillingService.ListBillNoConfigsAsync(listRequest);
        if (sequenceList?.data != null)
        {
            // Filter out deleted items
            var rawList = sequenceList.data.Where(seq => !seq.deleted).ToList();

            // Deduplicate items:
            // 1. Deduplicate by unique bncode if bncode > 0
            // 2. Deduplicate by unique scope (same name, shortname, branch, counter, and restart rule)
            var deduplicated = new List<BillNoConfig>();
            var seenKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var item in rawList)
            {
                string? bnKey = item.bncode.HasValue && item.bncode.Value > 0 ? $"bn_{item.bncode.Value}" : null;
                string scopeKey = $"scope_{item.name?.Trim()}_{item.shortname?.Trim()}_{item.bhcode}_{item.cntcode}_{item.allbranch}_{item.allcounter}";

                if (bnKey != null)
                {
                    if (!seenKeys.Add(bnKey)) continue;
                }
                if (!seenKeys.Add(scopeKey))
                {
                    continue;
                }

                deduplicated.Add(item);
            }

            sequenceList.data = deduplicated;
            sequenceList.total = deduplicated.Count;

            if (branches.Any() && !await IsTenantAdminLoginAsync())
            {
                var allowedCodes = branches.Select(b => b.bh_code).ToHashSet();
                sequenceList.data = sequenceList.data
                    .Where(seq => seq.allbranch == true || !seq.bhcode.HasValue || allowedCodes.Contains(seq.bhcode.Value))
                    .ToList();
                sequenceList.total = sequenceList.data.Count;
            }
        }
        
        isLoadingList = false;
        StateHasChanged();
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }
            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                branches = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branches = branches.Where(b => !b.deleted).ToList();
                await FilterBranchesByUserAccessAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }

    private async Task<bool> IsTenantAdminLoginAsync()
    {
        try
        {
            var isTenantAdminResult = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
            if (isTenantAdminResult.Success && isTenantAdminResult.Value == true)
            {
                return true;
            }
            var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (userDetailsResult.Success && userDetailsResult.Value != null)
            {
                var ud = userDetailsResult.Value;
                if (ud.UserCode == 0 || ud.UserCode == 1 ||
                    string.Equals(ud.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(ud.Role, "Admin", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(ud.Role, "Owner", StringComparison.OrdinalIgnoreCase))
                {
                    return true;
                }
            }
        }
        catch {}
        return false;
    }

    private async Task FilterBranchesByUserAccessAsync()
    {
        try
        {
            if (await IsTenantAdminLoginAsync())
            {
                return;
            }

            var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (userDetailsResult.Success && userDetailsResult.Value != null)
            {
                var ud = userDetailsResult.Value;
                if (ud.Branches != null && ud.Branches.Any())
                {
                    var allowedCodes = ud.Branches
                        .Select(b => b.bh_code != 0 ? b.bh_code : (b.bhcode ?? 0))
                        .Where(code => code > 0)
                        .ToHashSet();

                    if (allowedCodes.Any())
                    {
                        var filtered = branches.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                        if (filtered.Any())
                        {
                            branches = filtered;
                            return;
                        }
                    }
                }
            }

            var branchCodesResult = await _sessionStorage.GetAsync<List<int>>("UserBranchCodes");
            if (branchCodesResult.Success && branchCodesResult.Value != null && branchCodesResult.Value.Any())
            {
                var allowedCodes = branchCodesResult.Value.ToHashSet();
                var filtered = branches.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                if (filtered.Any())
                {
                    branches = filtered;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering branches by user access: {ex.Message}");
        }
    }

    private async Task LoadCountersAsync()
    {
        try
        {
            counters = await CounterService.GetCountersAsync();
            FilterCounters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading counters: {ex.Message}");
        }
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        currentConfig = new BillNoConfig
        {
            name = "Receipt Number",
            shortname = "RCP",
            orderno = 0,
            bhcode = null,
            cntcode = null,
            isdefault = false,
            allbranch = false,
            allcounter = false,
            restartfinancialyear = false,
            restartcalendaryear = false,
            restartmonthly = true,
            restartdaily = false,
            issampleno = true,
            isreceiptno = true,
            usercode = 1,
            computercode = 1
        };
        if (branches.Any())
        {
            currentConfig.bhcode = branches.First().bh_code;
        }
        FilterCounters();
        showModal = true;
    }

    private async Task OpenEditModal(BillNoConfig seq)
    {
        var detail = await HmsBillingService.GetBillNoConfigAsync(seq.bncode ?? 0);
        if (detail != null)
        {
            currentConfig = detail;
        }
        else
        {
            currentConfig = new BillNoConfig
            {
                bncode = seq.bncode,
                name = seq.name,
                shortname = seq.shortname,
                orderno = seq.orderno,
                bhcode = seq.bhcode,
                cntcode = seq.cntcode,
                isdefault = seq.isdefault,
                allbranch = seq.allbranch,
                allcounter = seq.allcounter,
                restartfinancialyear = seq.restartfinancialyear,
                restartcalendaryear = seq.restartcalendaryear,
                restartmonthly = seq.restartmonthly,
                restartdaily = seq.restartdaily,
                issampleno = seq.issampleno,
                isreceiptno = seq.isreceiptno,
                deleted = seq.deleted,
                tenant_code = seq.tenant_code,
                entereddate = seq.entereddate,
                sequence_rows_in_use = seq.sequence_rows_in_use,
                usercode = 1,
                computercode = 1
            };
        }
        
        FilterCounters();
        isEditMode = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private string GetRestartLogic()
    {
        if (currentConfig.restartdaily) return "daily";
        if (currentConfig.restartmonthly) return "monthly";
        if (currentConfig.restartcalendaryear) return "calendaryear";
        if (currentConfig.restartfinancialyear) return "financialyear";
        return "none";
    }

    private void OnRestartLogicChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        currentConfig.restartdaily = false;
        currentConfig.restartmonthly = false;
        currentConfig.restartcalendaryear = false;
        currentConfig.restartfinancialyear = false;

        if (val == "daily") currentConfig.restartdaily = true;
        if (val == "monthly") currentConfig.restartmonthly = true;
        if (val == "calendaryear") currentConfig.restartcalendaryear = true;
        if (val == "financialyear") currentConfig.restartfinancialyear = true;
    }

    private void OnBranchChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int bhcode))
        {
            currentConfig.bhcode = bhcode;
            FilterCounters();
        }
        else
        {
            currentConfig.bhcode = null;
            filteredCounters = new List<Medico_Backend.Model.CounterMasterModel>();
        }
        currentConfig.cntcode = null;
    }

    private void FilterCounters()
    {
        if (currentConfig.bhcode.HasValue)
        {
            filteredCounters = counters.Where(c => c.bhcode == currentConfig.bhcode.Value).ToList();
        }
        else
        {
            filteredCounters = new List<Medico_Backend.Model.CounterMasterModel>();
        }
    }

    private void OnAllBranchChanged(ChangeEventArgs e)
    {
        var val = (bool)(e.Value ?? false);
        currentConfig.allbranch = val;
        if (val)
        {
            currentConfig.bhcode = null;
            currentConfig.allcounter = true;
            currentConfig.cntcode = null;
        }
    }

    private void OnAllCounterChanged(ChangeEventArgs e)
    {
        var val = (bool)(e.Value ?? false);
        currentConfig.allcounter = val;
        if (val)
        {
            currentConfig.cntcode = null;
        }
    }

    private async Task SaveSequenceAsync()
    {
        if (string.IsNullOrWhiteSpace(currentConfig.name) || string.IsNullOrWhiteSpace(currentConfig.shortname))
        {
            ToastService.ShowError("Name and Shortname are required.");
            return;
        }

        // Auto-set allbranch and allcounter based on selections
        currentConfig.allbranch = !currentConfig.bhcode.HasValue;
        currentConfig.allcounter = !currentConfig.cntcode.HasValue;

        // Prevent duplicate creation for same shortname & branch/counter
        if (!isEditMode && sequenceList?.data != null)
        {
            bool exists = sequenceList.data.Any(s =>
                !s.deleted &&
                string.Equals(s.shortname?.Trim(), currentConfig.shortname?.Trim(), StringComparison.OrdinalIgnoreCase) &&
                s.bhcode == currentConfig.bhcode &&
                s.cntcode == currentConfig.cntcode
            );
            if (exists)
            {
                ToastService.ShowError($"A bill sequence with prefix '{currentConfig.shortname}' already exists for this branch and counter.");
                return;
            }
        }

        currentConfig.issampleno = true;
        currentConfig.isreceiptno = true;

        // Set logged-in user identifiers on the payload
        currentConfig.usercode = TenantState.UserCode > 0 ? TenantState.UserCode : 1;
        currentConfig.computercode = TenantState.UserCode > 0 ? TenantState.UserCode : 1;

        // Print entered values payload JSON to the terminal/console
        try
        {
            var serializeOptions = new System.Text.Json.JsonSerializerOptions {
                WriteIndented = true,
                PropertyNamingPolicy = null
            };
            var jsonPayload = System.Text.Json.JsonSerializer.Serialize(currentConfig, serializeOptions);
            Console.WriteLine("--- Sequence Save Payload JSON ---");
            Console.WriteLine(jsonPayload);
            Console.WriteLine("----------------------------------");
            await JsRuntime.InvokeVoidAsync("console.log", "Sending Sequence JSON Payload:", jsonPayload);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error serializing sequence payload: {ex.Message}");
        }

        isSaving = true;
        try
        {
            string result;
            if (isEditMode)
            {
                result = await HmsBillingService.UpdateBillNoConfigAsync(currentConfig);
            }
            else
            {
                result = await HmsBillingService.CreateBillNoConfigAsync(currentConfig);
            }

            if (!string.IsNullOrEmpty(result) && !result.Contains("Error", StringComparison.OrdinalIgnoreCase))
            {
                ToastService.ShowSuccess(isEditMode ? "Sequence updated successfully!" : "Sequence created successfully!");
                CloseModal();
                await LoadListAsync();
            }
            else
            {
                ToastService.ShowError($"Failed to save: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Exception: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void PromptDeleteSequence(BillNoConfig seq)
    {
        sequenceToDelete = seq;
        showDeleteModal = true;
    }

    private void CancelDeleteModal()
    {
        showDeleteModal = false;
        sequenceToDelete = null;
        isDeleteProcessing = false;
    }

    private async Task ExecuteDeleteSequenceAsync()
    {
        if (sequenceToDelete == null || !sequenceToDelete.bncode.HasValue)
        {
            CancelDeleteModal();
            return;
        }

        int bncode = sequenceToDelete.bncode.Value;
        int usercode = TenantState.UserCode > 0 ? TenantState.UserCode : 1;

        // Print delete payload to terminal/console
        Console.WriteLine("--- Sequence Delete Payload JSON ---");
        Console.WriteLine($"{{ \"bncode\": {bncode}, \"usercode\": {usercode} }}");
        Console.WriteLine("------------------------------------");
        await JsRuntime.InvokeVoidAsync("console.log", "Sending Delete Payload:", $"bncode={bncode}, usercode={usercode}");

        isDeleteProcessing = true;
        StateHasChanged();
        try
        {
            var result = await HmsBillingService.DeleteBillNoConfigAsync(bncode, usercode);
            if (!string.IsNullOrEmpty(result) && !result.Contains("Error", StringComparison.OrdinalIgnoreCase))
            {
                ToastService.ShowSuccess($"Sequence \"{sequenceToDelete.name}\" deleted successfully!");
                CancelDeleteModal();
                if (showModal) CloseModal();
                await LoadListAsync();
            }
            else
            {
                ToastService.ShowError($"Failed to delete: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Exception: {ex.Message}");
        }
        finally
        {
            isDeleteProcessing = false;
            StateHasChanged();
        }
    }

    private async Task NextPage()
    {
        listRequest.page++;
        await LoadListAsync();
    }

    private async Task PrevPage()
    {
        if (listRequest.page > 1)
        {
            listRequest.page--;
            await LoadListAsync();
        }
    }
}
