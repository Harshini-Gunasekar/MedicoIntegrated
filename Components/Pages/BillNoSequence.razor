@page "/billno-sequence"
@rendermode InteractiveServer
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.CounterMasterService CounterService
@inject Booking.Services.ToastService ToastService
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JsRuntime
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@using Booking.Models
@using Newtonsoft.Json

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">list_ol</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Bill No Sequence Configuration</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Numbering Inventory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            @if (TenantState.HasActionRight("Lab", "Print Lab Result", "Create"))
            {
                <button class="btn-new-entry" @onclick="OpenCreateModal">+ Add New Sequence</button>
            }
        </div>
    </div>

    @* --- Directory List Table --- *@
    <div class="directory-section">
        <div class="lc-table-container">
            @if (isLoadingList)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (sequenceList == null || !sequenceList.data.Any())
            {
                <div class="text-center py-5 text-slate-400 italic">
                    No bill number sequences configured yet.
                </div>
            }
            else
            {
                <table class="lc-table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">S.NO</th>
                            <th>RECEIPT NAME</th>
                            <th style="width: 140px;">SHORTNAME</th>
                            <th style="width: 100px;">DEFAULT</th>
                            <th style="width: 150px;">RESTART RULE</th>
                            <th>BRANCH / COUNTER SCOPE</th>
                            <th style="width: 120px;">ROWS USED</th>
                            <th class="text-center" style="width: 100px;">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int sno = (listRequest.page - 1) * listRequest.pagesize + 1; }
                        @foreach (var seq in sequenceList.data)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"{sno++:00}")</span></td>
                                <td class="font-bold text-slate-800">@seq.name</td>
                                <td><span class="badge-custom badge-purple">@seq.shortname</span></td>
                                <td>
                                    @if (seq.isdefault)
                                    {
                                        <span class="badge-custom badge-green">Default</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">-</span>
                                    }
                                </td>
                                <td>
                                    @if (seq.restartmonthly) { <span>Monthly</span> }
                                    else if (seq.restartdaily) { <span>Daily</span> }
                                    else if (seq.restartfinancialyear) { <span>Financial Year</span> }
                                    else if (seq.restartcalendaryear) { <span>Calendar Year</span> }
                                    else { <span>Never</span> }
                                </td>
                                <td class="text-slate-600">
                                    @{
                                        var branchLabel = seq.allbranch ? "All Branches" : (branches.FirstOrDefault(b => b.bh_code == seq.bhcode)?.name ?? $"Branch {seq.bhcode}");
                                        var counterLabel = seq.allcounter ? "All Counters" : (counters.FirstOrDefault(c => c.cntcode == seq.cntcode)?.name ?? $"Counter {seq.cntcode}");
                                    }
                                    @branchLabel / @counterLabel
                                </td>
                                <td class="text-slate-500 font-bold">@(seq.sequence_rows_in_use ?? 0)</td>
                                <td class="text-center">
                                    @if (TenantState.HasActionRight("Lab", "Print Lab Result", "Edit"))
                                    {
                                        <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => OpenEditModal(seq)" title="Edit">
                                            <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @* --- Pagination --- *@
                <div class="pagination-area">
                    <div class="pagination-info">
                        Showing @((listRequest.page - 1) * listRequest.pagesize + (sequenceList?.data.Count > 0 ? 1 : 0)) to @((listRequest.page - 1) * listRequest.pagesize + (sequenceList?.data.Count ?? 0)) of @(sequenceList?.total ?? 0) records
                    </div>
                    <div class="pagination-controls">
                        <button class="page-btn" disabled="@(listRequest.page <= 1)" @onclick="PrevPage">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button class="page-btn" disabled="@(sequenceList?.data.Count < listRequest.pagesize)" @onclick="NextPage">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* --- FORM MODAL --- *@
@if (showModal)
{
    <div class="modal-overlay">
        <div class="modal-form-card">
            <div class="modal-header-bar">
                <h3>@(isEditMode ? "Edit Configuration Entry" : "New Configuration Entry")</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseModal" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>
            
            <div class="modal-body">
                <div class="um-grid-cols-2">
                    @* --- Left Column --- *@
                    <div>
                        <div class="form-group">
                            <label>Receipt Name *</label>
                            <input type="text" class="lab-input" @bind="currentConfig.name" placeholder="Receipt Number" required />
                        </div>
                        <div class="form-group">
                            <label>Short Name (Prefix) *</label>
                            <input type="text" class="lab-input" @bind="currentConfig.shortname" placeholder="RCP" required />
                        </div>
                        <div class="form-group">
                            <label>Initial Order No</label>
                            <input type="number" class="lab-input" @bind="currentConfig.orderno" placeholder="0" />
                        </div>
                    </div>

                    @* --- Right Column --- *@
                    <div>
                        <div class="form-group">
                            <label>RESTART LOGIC</label>
                            <select class="lab-input" value="@GetRestartLogic()" @onchange="OnRestartLogicChanged">
                                <option value="none">Never</option>
                                <option value="daily">Daily</option>
                                <option value="monthly">Monthly</option>
                                <option value="calendaryear">Calendar Year</option>
                                <option value="financialyear">Financial Year</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>BRANCH</label>
                            <select class="lab-input" value="@currentConfig.bhcode" @onchange="OnBranchChanged" disabled="@currentConfig.allbranch">
                                <option value="">-- Select Branch --</option>
                                @foreach (var b in branches)
                                {
                                    <option value="@b.bh_code">@b.name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>COUNTER</label>
                            <select class="lab-input" @bind="currentConfig.cntcode" disabled="@(currentConfig.allcounter || currentConfig.allbranch)">
                                <option value="">-- Select Counter --</option>
                                @foreach (var c in filteredCounters)
                                {
                                    <option value="@c.cntcode">@c.name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                
                @* --- Checkbox Pills --- *@
                <div class="checkbox-box-container">
                    <div class="checkbox-pills-grid">
                        <label class="checkbox-pill @(currentConfig.isdefault ? "checked" : "")">
                            <input type="checkbox" @bind="currentConfig.isdefault" />
                            <span>Is Default</span>
                        </label>
                        <label class="checkbox-pill @(currentConfig.allbranch ? "checked" : "")">
                            <input type="checkbox" checked="@currentConfig.allbranch" @onchange="OnAllBranchChanged" />
                            <span>All Branches</span>
                        </label>
                        <label class="checkbox-pill @(currentConfig.allcounter ? "checked" : "")">
                            <input type="checkbox" checked="@currentConfig.allcounter" @onchange="OnAllCounterChanged" disabled="@currentConfig.allbranch" />
                            <span>All Counters</span>
                        </label>
                        <label class="checkbox-pill @(currentConfig.issampleno ? "checked" : "")">
                            <input type="checkbox" @bind="currentConfig.issampleno" />
                            <span>Is Sample No</span>
                        </label>
                        <label class="checkbox-pill @(currentConfig.isreceiptno ? "checked" : "")">
                            <input type="checkbox" @bind="currentConfig.isreceiptno" />
                            <span>Is Receipt No</span>
                        </label>
                    </div>
                </div>

                @if (isEditMode)
                {
                    <div class="alert alert-danger mb-0 mt-3" style="font-size: 0.85rem; border-radius: 10px; padding: 12px; margin-top: 16px;">
                        <strong>Note:</strong> This sequence has already been used for <strong>@(currentConfig.sequence_rows_in_use ?? 0)</strong> rows. Changing logic may affect ongoing sequences.
                    </div>
                }
            </div>

            <div class="modal-footer-bar">
                <button type="button" class="btn-delete" @onclick="DeleteSequenceAsync" disabled="@(!isEditMode)">Delete</button>
                <button type="button" class="btn-save" @onclick="SaveSequenceAsync" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                        </svg>
                        <span>Save Configuration</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string TenantCode = "";
    private string AuthToken = "";

    private BillNoListRequest listRequest = new BillNoListRequest { page = 1, pagesize = 20 };
    private BillNoListResponse? sequenceList;
    private bool isLoadingList = true;

    private bool showModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private BillNoConfig currentConfig = new BillNoConfig();

    private List<Booking.Models.BranchModel> branches = new();
    private List<Medico_Backend.Model.CounterMasterModel> counters = new();
    private List<Medico_Backend.Model.CounterMasterModel> filteredCounters = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadListAsync();
        await LoadCountersAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                await LoadBranchesAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading session details: {ex.Message}");
            }
        }
    }

    private async Task LoadListAsync()
    {
        isLoadingList = true;
        StateHasChanged();
        
        sequenceList = await HmsBillingService.ListBillNoConfigsAsync(listRequest);
        
        isLoadingList = false;
        StateHasChanged();
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }
            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                branches = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branches = branches.Where(b => !b.deleted).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }

    private async Task LoadCountersAsync()
    {
        try
        {
            counters = await CounterService.GetCountersAsync();
            filteredCounters = counters;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading counters: {ex.Message}");
        }
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        currentConfig = new BillNoConfig
        {
            name = "Receipt Number",
            shortname = "RCP",
            orderno = 0,
            bhcode = null,
            cntcode = null,
            isdefault = false,
            allbranch = false,
            allcounter = false,
            restartfinancialyear = false,
            restartcalendaryear = false,
            restartmonthly = true,
            restartdaily = false,
            issampleno = false,
            isreceiptno = false,
            usercode = 1,
            computercode = 1
        };
        filteredCounters = counters;
        showModal = true;
    }

    private async Task OpenEditModal(BillNoConfig seq)
    {
        var detail = await HmsBillingService.GetBillNoConfigAsync(seq.bncode ?? 0);
        if (detail != null)
        {
            currentConfig = detail;
        }
        else
        {
            currentConfig = new BillNoConfig
            {
                bncode = seq.bncode,
                name = seq.name,
                shortname = seq.shortname,
                orderno = seq.orderno,
                bhcode = seq.bhcode,
                cntcode = seq.cntcode,
                isdefault = seq.isdefault,
                allbranch = seq.allbranch,
                allcounter = seq.allcounter,
                restartfinancialyear = seq.restartfinancialyear,
                restartcalendaryear = seq.restartcalendaryear,
                restartmonthly = seq.restartmonthly,
                restartdaily = seq.restartdaily,
                issampleno = seq.issampleno,
                isreceiptno = seq.isreceiptno,
                deleted = seq.deleted,
                tenant_code = seq.tenant_code,
                entereddate = seq.entereddate,
                sequence_rows_in_use = seq.sequence_rows_in_use,
                usercode = 1,
                computercode = 1
            };
        }
        
        FilterCounters();
        isEditMode = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private string GetRestartLogic()
    {
        if (currentConfig.restartdaily) return "daily";
        if (currentConfig.restartmonthly) return "monthly";
        if (currentConfig.restartcalendaryear) return "calendaryear";
        if (currentConfig.restartfinancialyear) return "financialyear";
        return "none";
    }

    private void OnRestartLogicChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        currentConfig.restartdaily = false;
        currentConfig.restartmonthly = false;
        currentConfig.restartcalendaryear = false;
        currentConfig.restartfinancialyear = false;

        if (val == "daily") currentConfig.restartdaily = true;
        if (val == "monthly") currentConfig.restartmonthly = true;
        if (val == "calendaryear") currentConfig.restartcalendaryear = true;
        if (val == "financialyear") currentConfig.restartfinancialyear = true;
    }

    private void OnBranchChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int bhcode))
        {
            currentConfig.bhcode = bhcode;
            FilterCounters();
        }
        else
        {
            currentConfig.bhcode = null;
            filteredCounters = counters;
        }
        currentConfig.cntcode = null;
    }

    private void FilterCounters()
    {
        if (currentConfig.bhcode.HasValue)
        {
            filteredCounters = counters.Where(c => c.bhcode == currentConfig.bhcode.Value).ToList();
        }
        else
        {
            filteredCounters = counters;
        }
    }

    private void OnAllBranchChanged(ChangeEventArgs e)
    {
        var val = (bool)(e.Value ?? false);
        currentConfig.allbranch = val;
        if (val)
        {
            currentConfig.bhcode = null;
            currentConfig.allcounter = true;
            currentConfig.cntcode = null;
        }
    }

    private void OnAllCounterChanged(ChangeEventArgs e)
    {
        var val = (bool)(e.Value ?? false);
        currentConfig.allcounter = val;
        if (val)
        {
            currentConfig.cntcode = null;
        }
    }

    private async Task SaveSequenceAsync()
    {
        if (string.IsNullOrWhiteSpace(currentConfig.name) || string.IsNullOrWhiteSpace(currentConfig.shortname))
        {
            ToastService.ShowError("Name and Shortname are required.");
            return;
        }

        isSaving = true;
        try
        {
            string result;
            if (isEditMode)
            {
                result = await HmsBillingService.UpdateBillNoConfigAsync(currentConfig);
            }
            else
            {
                result = await HmsBillingService.CreateBillNoConfigAsync(currentConfig);
            }

            if (!string.IsNullOrEmpty(result) && !result.Contains("Error", StringComparison.OrdinalIgnoreCase))
            {
                ToastService.ShowSuccess(isEditMode ? "Sequence updated successfully!" : "Sequence created successfully!");
                CloseModal();
                await LoadListAsync();
            }
            else
            {
                ToastService.ShowError($"Failed to save: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Exception: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteSequenceAsync()
    {
        if (!isEditMode)
        {
            CloseModal();
            return;
        }

        bool confirm = await JsRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete this sequence config '{currentConfig.name}'?");
        if (!confirm) return;

        currentConfig.deleted = true;
        isSaving = true;
        try
        {
            var result = await HmsBillingService.UpdateBillNoConfigAsync(currentConfig);
            if (!string.IsNullOrEmpty(result) && !result.Contains("Error", StringComparison.OrdinalIgnoreCase))
            {
                ToastService.ShowSuccess("Sequence deleted successfully!");
                CloseModal();
                await LoadListAsync();
            }
            else
            {
                ToastService.ShowError($"Failed to delete: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Exception: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task NextPage()
    {
        listRequest.page++;
        await LoadListAsync();
    }

    private async Task PrevPage()
    {
        if (listRequest.page > 1)
        {
            listRequest.page--;
            await LoadListAsync();
        }
    }
}
