@page "/billno-sequence"
@rendermode InteractiveServer
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.ToastService ToastService
@inject IJSRuntime JsRuntime
@using Booking.Models

<div class="bills-wrapper">
    <!-- Header -->
    <div class="bills-header">
        <div class="header-title-area">
            <div class="header-icon-box">
                <i class="bi bi-list-ol"></i>
            </div>
            <div class="header-text-container">
                <h1 class="header-title">Bill No Sequence Configuration</h1>
                <span class="header-subtitle">Manage billing and receipt numbering logic</span>
            </div>
        </div>
        <div class="header-actions">
            <button class="btn btn-outline btn-add-new" @onclick="OpenCreateModal">
                <i class="bi bi-plus-lg"></i> Add New Sequence
            </button>
        </div>
    </div>

    <!-- Main List -->
    <div class="table-card mt-3">
        @if (isLoadingList)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (sequenceList == null || !sequenceList.data.Any())
        {
            <div class="text-center py-5 text-muted">
                No bill number sequences configured yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="bills-table">
                    <thead>
                        <tr>
                            <th>S.NO</th>
                            <th>NAME</th>
                            <th>SHORTNAME</th>
                            <th>DEFAULT</th>
                            <th>RESTART RULE</th>
                            <th>SCOPE</th>
                            <th>ROWS USED</th>
                            <th class="text-center">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int sno = (listRequest.page - 1) * listRequest.pagesize + 1; }
                        @foreach (var seq in sequenceList.data)
                        {
                            <tr>
                                <td>@(sno++)</td>
                                <td class="fw-bold">@seq.name</td>
                                <td><span class="badge-custom badge-purple">@seq.shortname</span></td>
                                <td>
                                    @if (seq.isdefault)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (seq.restartmonthly) { <span>Monthly</span> }
                                    else if (seq.restartdaily) { <span>Daily</span> }
                                    else if (seq.restartfinancialyear) { <span>Financial Year</span> }
                                    else if (seq.restartcalendaryear) { <span>Calendar Year</span> }
                                    else { <span>Never</span> }
                                </td>
                                <td>
                                    @(seq.allbranch ? "All Branches" : "Specific") / @(seq.allcounter ? "All Counters" : "Specific")
                                </td>
                                <td>@(seq.sequence_rows_in_use ?? 0)</td>
                                <td class="action-cell">
                                    <button class="action-btn text-primary" @onclick="() => OpenEditModal(seq)" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="pagination-area">
                <div class="pagination-info">
                    Showing @((listRequest.page - 1) * listRequest.pagesize + (sequenceList?.data.Count > 0 ? 1 : 0)) to @((listRequest.page - 1) * listRequest.pagesize + (sequenceList?.data.Count ?? 0)) of @(sequenceList?.total ?? 0) records
                </div>
                <div class="pagination-controls">
                    <button class="page-btn" disabled="@(listRequest.page <= 1)" @onclick="PrevPage">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button class="page-btn" disabled="@(sequenceList?.data.Count < listRequest.pagesize)" @onclick="NextPage">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Add/Edit Modal -->
@if (showModal)
{
    <div class="modal-backdrop">
        <div class="modal-content-lg">
            <div class="modal-header">
                <h5 class="mb-0">
                    @(isEditMode ? "Edit Configuration Entry" : "New Configuration Entry")
                </h5>
                <button type="button" class="btn-close-custom" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
            </div>
            
            <div class="modal-body">
                <div class="modal-form-grid">
                    <!-- Left Column -->
                    <div class="form-column">
                        <div class="form-group-modern">
                            <label>Receipt Name</label>
                            <input type="text" class="form-control" @bind="currentConfig.name" placeholder="Receipt Number" />
                        </div>
                        <div class="form-group-modern">
                            <label>Short Name (Prefix)</label>
                            <input type="text" class="form-control" @bind="currentConfig.shortname" placeholder="RCP" />
                        </div>
                        <div class="form-group-modern">
                            <label>Initial Order No</label>
                            <input type="number" class="form-control" @bind="currentConfig.orderno" placeholder="0" />
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="form-column">
                        <div class="form-group-modern">
                            <label class="label-uppercase">RESTART LOGIC</label>
                            <select class="form-select" value="@GetRestartLogic()" @onchange="OnRestartLogicChanged">
                                <option value="none">Never</option>
                                <option value="daily">Daily</option>
                                <option value="monthly">Monthly</option>
                                <option value="calendaryear">Calendar Year</option>
                                <option value="financialyear">Financial Year</option>
                            </select>
                        </div>
                        <div class="form-group-modern">
                            <label class="label-uppercase">BRANCH</label>
                            <select class="form-select" @bind="currentConfig.bhcode" disabled="@currentConfig.allbranch">
                                <option value="">-- Select Branch --</option>
                                <option value="1">Erode Center (1)</option>
                                <option value="2">Main Branch (2)</option>
                                <option value="3">Salem Clinic (3)</option>
                            </select>
                        </div>
                        <div class="form-group-modern">
                            <label class="label-uppercase">COUNTER</label>
                            <select class="form-select" @bind="currentConfig.cntcode" disabled="@currentConfig.allcounter">
                                <option value="">-- Select Counter --</option>
                                <option value="1">Billing Counter 1 (1)</option>
                                <option value="2">Sample Counter (2)</option>
                                <option value="3">Billing Counter 2 (3)</option>
                            </select>
                        </div>
                    </div>
                </div>
                
                <!-- Checkbox Box Container -->
                <div class="checkbox-container-box">
                    <div class="checkbox-pills-grid">
                        <label class="checkbox-pill @(currentConfig.isdefault ? "checked" : "")">
                            <input type="checkbox" @bind="currentConfig.isdefault" />
                            <span>Is Default</span>
                        </label>
                        <label class="checkbox-pill @(currentConfig.allbranch ? "checked" : "")">
                            <input type="checkbox" @bind="currentConfig.allbranch" />
                            <span>All Branches</span>
                        </label>
                        <label class="checkbox-pill @(currentConfig.allcounter ? "checked" : "")">
                            <input type="checkbox" @bind="currentConfig.allcounter" />
                            <span>All Counters</span>
                        </label>
                        <label class="checkbox-pill @(currentConfig.issampleno ? "checked" : "")">
                            <input type="checkbox" @bind="currentConfig.issampleno" />
                            <span>Is Sample No</span>
                        </label>
                        <label class="checkbox-pill @(currentConfig.isreceiptno ? "checked" : "")">
                            <input type="checkbox" @bind="currentConfig.isreceiptno" />
                            <span>Is Receipt No</span>
                        </label>
                    </div>
                </div>

                @if (isEditMode)
                {
                    <div class="alert alert-warning mb-0 mt-3" style="font-size: 0.85rem; border-radius: 10px;">
                        <strong>Note:</strong> This sequence has already been used for <strong>@(currentConfig.sequence_rows_in_use ?? 0)</strong> rows. Changing logic may affect ongoing sequences.
                    </div>
                }
            </div>

            <div class="modal-footer">
                <div style="flex-grow: 1;"></div>
                <div class="footer-actions-right">
                    <button type="button" class="btn-delete" @onclick="DeleteSequenceAsync">Delete</button>
                    <button type="button" class="btn-save-custom" @onclick="SaveSequenceAsync" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-send me-2"></i>
                            <span>Save Configuration</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private BillNoListRequest listRequest = new BillNoListRequest { page = 1, pagesize = 20 };
    private BillNoListResponse? sequenceList;
    private bool isLoadingList = true;

    private bool showModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private BillNoConfig currentConfig = new BillNoConfig();

    protected override async Task OnInitializedAsync()
    {
        await LoadListAsync();
    }

    private async Task LoadListAsync()
    {
        isLoadingList = true;
        StateHasChanged();
        
        sequenceList = await HmsBillingService.ListBillNoConfigsAsync(listRequest);
        
        isLoadingList = false;
        StateHasChanged();
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        currentConfig = new BillNoConfig
        {
            name = "Receipt Number",
            shortname = "RCP",
            orderno = 0,
            bhcode = null,
            cntcode = null,
            isdefault = false,
            allbranch = true,
            allcounter = true,
            restartfinancialyear = false,
            restartcalendaryear = false,
            restartmonthly = true,
            restartdaily = false,
            issampleno = false,
            isreceiptno = true,
            usercode = 1,
            computercode = 1
        };
        showModal = true;
    }

    private async Task OpenEditModal(BillNoConfig seq)
    {
        // Load fresh to get exact details if needed, or use the list model
        var detail = await HmsBillingService.GetBillNoConfigAsync(seq.bncode ?? 0);
        if (detail != null)
        {
            currentConfig = detail;
        }
        else
        {
            // Fallback to clone
            currentConfig = new BillNoConfig
            {
                bncode = seq.bncode,
                name = seq.name,
                shortname = seq.shortname,
                orderno = seq.orderno,
                bhcode = seq.bhcode,
                cntcode = seq.cntcode,
                isdefault = seq.isdefault,
                allbranch = seq.allbranch,
                allcounter = seq.allcounter,
                restartfinancialyear = seq.restartfinancialyear,
                restartcalendaryear = seq.restartcalendaryear,
                restartmonthly = seq.restartmonthly,
                restartdaily = seq.restartdaily,
                issampleno = seq.issampleno,
                isreceiptno = seq.isreceiptno,
                deleted = seq.deleted,
                tenant_code = seq.tenant_code,
                entereddate = seq.entereddate,
                sequence_rows_in_use = seq.sequence_rows_in_use,
                usercode = 1,
                computercode = 1
            };
        }
        
        isEditMode = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private string GetRestartLogic()
    {
        if (currentConfig.restartdaily) return "daily";
        if (currentConfig.restartmonthly) return "monthly";
        if (currentConfig.restartcalendaryear) return "calendaryear";
        if (currentConfig.restartfinancialyear) return "financialyear";
        return "none";
    }

    private void OnRestartLogicChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        currentConfig.restartdaily = false;
        currentConfig.restartmonthly = false;
        currentConfig.restartcalendaryear = false;
        currentConfig.restartfinancialyear = false;

        if (val == "daily") currentConfig.restartdaily = true;
        if (val == "monthly") currentConfig.restartmonthly = true;
        if (val == "calendaryear") currentConfig.restartcalendaryear = true;
        if (val == "financialyear") currentConfig.restartfinancialyear = true;
    }

    private async Task SaveSequenceAsync()
    {
        if (string.IsNullOrWhiteSpace(currentConfig.name) || string.IsNullOrWhiteSpace(currentConfig.shortname))
        {
            ToastService.ShowError("Name and Shortname are required.");
            return;
        }

        isSaving = true;
        try
        {
            string result;
            if (isEditMode)
            {
                result = await HmsBillingService.UpdateBillNoConfigAsync(currentConfig);
            }
            else
            {
                result = await HmsBillingService.CreateBillNoConfigAsync(currentConfig);
            }

            if (!string.IsNullOrEmpty(result) && !result.Contains("Error", StringComparison.OrdinalIgnoreCase))
            {
                ToastService.ShowSuccess(isEditMode ? "Sequence updated successfully!" : "Sequence created successfully!");
                CloseModal();
                await LoadListAsync();
            }
            else
            {
                ToastService.ShowError($"Failed to save: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Exception: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteSequenceAsync()
    {
        if (!isEditMode)
        {
            CloseModal();
            return;
        }

        bool confirm = await JsRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete this sequence config '{currentConfig.name}'?");
        if (!confirm) return;

        currentConfig.deleted = true;
        isSaving = true;
        try
        {
            var result = await HmsBillingService.UpdateBillNoConfigAsync(currentConfig);
            if (!string.IsNullOrEmpty(result) && !result.Contains("Error", StringComparison.OrdinalIgnoreCase))
            {
                ToastService.ShowSuccess("Sequence deleted successfully!");
                CloseModal();
                await LoadListAsync();
            }
            else
            {
                ToastService.ShowError($"Failed to delete: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Exception: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task NextPage()
    {
        listRequest.page++;
        await LoadListAsync();
    }

    private async Task PrevPage()
    {
        if (listRequest.page > 1)
        {
            listRequest.page--;
            await LoadListAsync();
        }
    }
}
