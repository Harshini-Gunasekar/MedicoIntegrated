    private async Task LoadPaymodesAsync()
    {
        try
        {
            paymodesList = await PaymodeService.GetPaymodeMastersAsync();
            paymodesList = paymodesList.Where(p => !p.deleted).OrderBy(p => p.orderno).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading paymodes: {ex.Message}");
            paymodesList = new();
        }

        if (paymodesList == null || !paymodesList.Any())
        {
            paymodesList = new List<PaymodeMasterModel>
            {
                new() { pmcode = 1, shortname = "CASH", name = "Cash" },
                new() { pmcode = 2, shortname = "CARD", name = "Card" },
                new() { pmcode = 3, shortname = "UPI", name = "UPI / GPay" }
            };
        }

        // Ensure Advance paymode is in the list
        var advancePm = paymodesList.FirstOrDefault(p => 
            string.Equals(p.name, "ADVANCE", StringComparison.OrdinalIgnoreCase) || 
            string.Equals(p.shortname, "ADVANCE", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(p.shortname, "ADV", StringComparison.OrdinalIgnoreCase)
        );
        if (advancePm == null)
        {
            advancePm = new PaymodeMasterModel { pmcode = 99, shortname = "ADVANCE", name = "Advance" };
            paymodesList.Add(advancePm);
        }

        if (paymodesList.Count > 0)
        {
            var cashPm = paymodesList.FirstOrDefault(p => string.Equals(p.shortname, "CASH", StringComparison.OrdinalIgnoreCase)) ?? paymodesList[0];
            var cardPm = paymodesList.FirstOrDefault(p => string.Equals(p.shortname, "CARD", StringComparison.OrdinalIgnoreCase));
            var upiPm  = paymodesList.FirstOrDefault(p => string.Equals(p.shortname, "UPI", StringComparison.OrdinalIgnoreCase) || string.Equals(p.shortname, "GPAY", StringComparison.OrdinalIgnoreCase));

            if (billModel.pmc1 == null || !paymodesList.Any(p => (double)p.pmcode == billModel.pmc1.Value))
            {
                billModel.pmc1 = (double)cashPm.pmcode;
            }

            if (billModel.pmc2 == null && cardPm != null)
            {
                billModel.pmc2 = (double)cardPm.pmcode;
            }

            if (billModel.pmc3 == null && upiPm != null)
            {
                billModel.pmc3 = (double)upiPm.pmcode;
            }
        }
    }

