    private string TenantCode = "";
    private string AuthToken = "";
    private int activeUserCode = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                // Initialise TenantState so LabCare services can attach auth headers
                if (!string.IsNullOrEmpty(AuthToken))
                    TenantState.SetSession(TenantCode, AuthToken, "");

                try
                {
                    var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userDetailsResult.Success && userDetailsResult.Value != null && userDetailsResult.Value.UserCode.HasValue && userDetailsResult.Value.UserCode.Value > 0)
                    {
                        activeUserCode = userDetailsResult.Value.UserCode.Value;
                    }
                    else if (TenantState.UserCode > 0)
                    {
                        activeUserCode = TenantState.UserCode;
                    }
                }
                catch { }

                await LoadBranchesAsync();
                await LoadCountersAsync();
                await LoadPaymodesAsync();
                await LoadTestMastersAsync();
                await LoadUserPermissionsAsync();
                if (activeUserCode > 0) billModel.usercode = activeUserCode;
                await CheckCounterShiftOpenAsync(showPrompt: true);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error loading session: {ex.Message}");
            }
        }
    }

    private async Task LoadUserPermissionsAsync()
    {
        try
        {
            var userCode = TenantState.UserCode;
            if (userCode <= 0) return;

            using var client = CreateClient(true);
            var response = await client.GetAsync($"api/user/get?user_code={userCode}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var userDetails = Newtonsoft.Json.JsonConvert.DeserializeObject<LIMS_Backend.Model.user_master>(json,
                    new Newtonsoft.Json.JsonSerializerSettings { MissingMemberHandling = Newtonsoft.Json.MissingMemberHandling.Ignore });
                if (userDetails != null)
                {
                    canEditBill  = userDetails.edit_bill  ?? true;
                    canPrintBill = userDetails.print_bill ?? true;
                    Console.WriteLine($"[Billing] User {userCode} — edit_bill={canEditBill}, print_bill={canPrintBill}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Billing] LoadUserPermissionsAsync error: {ex.Message}");
        }
    }


    private HttpClient CreateClient(bool isLabCare = false)
    {
        var clientName = isLabCare ? "LabCareUrl" : "DoctorApi";
        var client = ClientFactory.CreateClient(clientName);
        var tCode = !string.IsNullOrEmpty(TenantCode) ? TenantCode : TenantState.TenantCode;
        var token = !string.IsNullOrEmpty(AuthToken) ? AuthToken : TenantState.AuthToken;

        if (!string.IsNullOrEmpty(tCode))
        {
            client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Add("tenant_code", tCode);
        }
        if (!string.IsNullOrEmpty(token))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
        return client;
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            using var client = CreateClient(true);
            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                branchesList = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branchesList = branchesList.Where(b => !b.deleted).ToList();
            }

            if (branchesList == null || !branchesList.Any())
            {
                using var doctorClient = CreateClient(false);
                var docRes = await doctorClient.GetAsync("api/Branch/get");
                if (docRes.IsSuccessStatusCode)
                {
                    var docJson = await docRes.Content.ReadAsStringAsync();
                    branchesList = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(docJson) ?? new();
                    branchesList = branchesList.Where(b => !b.deleted).ToList();
                }
            }

            await FilterBranchesByUserAccessAsync();

            if (branchesList == null || !branchesList.Any())
            {
                branchesList = new List<Booking.Models.BranchModel>
                {
                    new() { bh_code = 1, name = "Main Branch" }
                };
            }

            // Set active branch from session storage if available
            int savedBhCode = 0;
            try
            {
                var bhCodeResult = await _sessionStorage.GetAsync<string>("bhcode");
                if (bhCodeResult.Success && !string.IsNullOrEmpty(bhCodeResult.Value))
                {
                    int.TryParse(bhCodeResult.Value, out savedBhCode);
                }
            }
            catch { }

            if (savedBhCode > 0)
            {
                activeBranchCode = savedBhCode;
            }

            if (BillingStateSvc.HasState && billModel.enteredbhcode > 0 && branchesList.Any(b => b.bh_code == billModel.enteredbhcode))
            {
                // Keep restored branch code from BillingStateSvc
            }
            else if (activeBranchCode > 0 && branchesList.Any(b => b.bh_code == activeBranchCode))
            {
                billModel.enteredbhcode = activeBranchCode;
            }
            else if (branchesList.Any() && (billModel.enteredbhcode <= 0 || !branchesList.Any(b => b.bh_code == billModel.enteredbhcode)))
            {
                billModel.enteredbhcode = branchesList.First().bh_code;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
            if (branchesList == null || !branchesList.Any())
            {
                branchesList = new List<Booking.Models.BranchModel>
                {
                    new() { bh_code = 1, name = "Main Branch" }
                };
                billModel.enteredbhcode = 1;
            }
        }
    }

    private async Task FilterBranchesByUserAccessAsync()
    {
        try
        {
            var isTenantAdminResult = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
            if (isTenantAdminResult.Success && isTenantAdminResult.Value == true)
            {
                return;
            }

            var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (userDetailsResult.Success && userDetailsResult.Value != null)
            {
                var ud = userDetailsResult.Value;
                if (ud.UserCode == 0 || ud.UserCode == 1 ||
                    string.Equals(ud.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(ud.Role, "Admin", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(ud.Role, "Owner", StringComparison.OrdinalIgnoreCase))
                {
                    return; // Admins/Owners see all branches
                }

                if (ud.Branches != null && ud.Branches.Any())
                {
                    var allowedCodes = ud.Branches
                        .Select(b => b.bh_code != 0 ? b.bh_code : (b.bhcode ?? 0))
                        .Where(code => code > 0)
                        .ToHashSet();

                    if (allowedCodes.Any())
                    {
                        var filtered = branchesList.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                        if (filtered.Any())
                        {
                            branchesList = filtered;
                            return;
                        }
                    }
                }
            }

            var branchCodesResult = await _sessionStorage.GetAsync<List<int>>("UserBranchCodes");
            if (branchCodesResult.Success && branchCodesResult.Value != null && branchCodesResult.Value.Any())
            {
                var allowedCodes = branchCodesResult.Value.ToHashSet();
                var filtered = branchesList.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                if (filtered.Any())
                {
                    branchesList = filtered;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering branches by user access: {ex.Message}");
        }
    }

    private async Task<int> GetDefaultCounterCodeAsync()
    {
        var available = GetFilteredCounters().ToList();
        if (!available.Any()) return 1;

        // 1. Try saved counter code from Session Storage
        try
        {
            var cntCodeResult = await _sessionStorage.GetAsync<string>("cntcode");
            if (cntCodeResult.Success && !string.IsNullOrEmpty(cntCodeResult.Value) && int.TryParse(cntCodeResult.Value, out int savedCnt) && savedCnt > 0)
            {
                if (available.Any(c => c.cntcode == savedCnt))
                {
                    return savedCnt;
                }
            }
        }
        catch { }

        // 2. Try TenantState.CounterCode
        if (TenantState.CounterCode.HasValue && TenantState.CounterCode.Value > 0)
        {
            int tenantCnt = TenantState.CounterCode.Value;
            if (available.Any(c => c.cntcode == tenantCnt))
            {
                return tenantCnt;
            }
        }

        // 3. Try UserDetails from Session Storage
        try
        {
            var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (userDetailsResult.Success && userDetailsResult.Value?.CounterCode != null && userDetailsResult.Value.CounterCode > 0)
            {
                int userCnt = userDetailsResult.Value.CounterCode.Value;
                if (available.Any(c => c.cntcode == userCnt))
                {
                    return userCnt;
                }
            }
        }
        catch { }

        // 4. Try active open shift counter for this branch
        try
        {
            var openCounters = await HmsBillingService.GetOpenCountersAsync();
            var openCnt = available.FirstOrDefault(c => openCounters.Any(s => s.cntcode == (int)c.cntcode && (billModel.enteredbhcode == 0 || s.bhcode == null || s.bhcode == 0 || s.bhcode == billModel.enteredbhcode)));
            if (openCnt != null)
            {
                return (int)openCnt.cntcode;
            }
        }
        catch { }

        // 5. Fall back to first available counter for this branch
        return (int)available.First().cntcode;
    }

    private async Task LoadCountersAsync()
    {
        try
        {
            countersList = await CounterMasterService.GetCountersAsync();
            if (countersList == null || !countersList.Any())
            {
                using var client = CreateClient(false);
                var res = await client.GetAsync("api/CounterMaster/get");
                if (res.IsSuccessStatusCode)
                {
                    var json = await res.Content.ReadAsStringAsync();
                    countersList = JsonConvert.DeserializeObject<List<CounterMasterModel>>(json) ?? new();
                }
            }

            if (countersList == null || !countersList.Any())
            {
                countersList = new List<CounterMasterModel>
                {
                    new() { cntcode = 1, bhcode = billModel.enteredbhcode > 0 ? billModel.enteredbhcode : 1, name = "Main Counter" }
                };
            }

            if (BillingStateSvc.HasState && billModel.cntcode > 0 && countersList.Any(c => c.cntcode == billModel.cntcode))
            {
                // Keep restored counter code from BillingStateSvc
            }
            else
            {
                int defaultCnt = await GetDefaultCounterCodeAsync();
                if (defaultCnt > 0)
                {
                    billModel.cntcode = defaultCnt;
                    try
                    {
                        await _sessionStorage.SetAsync("cntcode", defaultCnt.ToString());
                    }
                    catch { }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading counters: {ex.Message}");
            if (countersList == null || !countersList.Any())
            {
                countersList = new List<CounterMasterModel>
                {
                    new() { cntcode = 1, bhcode = billModel.enteredbhcode > 0 ? billModel.enteredbhcode : 1, name = "Main Counter" }
                };
                billModel.cntcode = 1;
            }
        }
    }

    private IEnumerable<CounterMasterModel> GetFilteredCounters()
    {
        if (countersList == null || !countersList.Any()) return Enumerable.Empty<CounterMasterModel>();

        var filtered = countersList.Where(x => x.bhcode == billModel.enteredbhcode || x.bhcode == 0 || x.bhcode == null || billModel.enteredbhcode == 0).ToList();
        if (!filtered.Any())
        {
            filtered = countersList.ToList();
        }
        return filtered;
    }

    private async Task OnBranchSelectionChanged()
    {
        var availableCounters = GetFilteredCounters();
        if (availableCounters.Any())
        {
            int defaultCnt = await GetDefaultCounterCodeAsync();
            billModel.cntcode = defaultCnt;
            try
            {
                await _sessionStorage.SetAsync("cntcode", defaultCnt.ToString());
            }
            catch { }
            await CheckCounterShiftOpenAsync(showPrompt: true);
        }
        else
        {
            billModel.cntcode = 0;
        }
    }

    private async Task OnCounterSelectionChanged()
    {
        if (billModel.cntcode > 0)
        {
            try
            {
                await _sessionStorage.SetAsync("cntcode", billModel.cntcode.ToString());
            }
            catch { }
        }

        if (billModel.cntcode > 0 && billModel.enteredbhcode > 0)
        {
            await CheckCounterShiftOpenAsync(showPrompt: true);
        }
    }

    private async Task SelectCustomerPatient(Booking.Models.CustomerWithOpModel pat)
    {
        // 1. Immediately set patient details on billModel for zero UI delay
        billModel.custid = pat.custid;
        billModel.op_id = pat.op_id;
        selectedOpNo = !string.IsNullOrEmpty(pat.op_no) ? pat.op_no : "-";

        var activeIp = activeAdmissions.FirstOrDefault(a => a.custid == pat.custid && (string.Equals(a.ip_status, "ADMITTED", StringComparison.OrdinalIgnoreCase) || a.dischargedate == null));
        if (activeIp != null)
        {
            billModel.ip_id = activeIp.ip_id;
            selectedIpNo = activeIp.ip_no;
        }
        else
        {
            billModel.ip_id = null;
            selectedIpNo = "-";
        }

        billModel.patient_name = string.IsNullOrEmpty(pat.namewithinitials) ? pat.name : pat.namewithinitials;
        billModel.mobileno = pat.mobile;
        billModel.gender = pat.gender;
        billModel.ageyears = pat.ageyears.ToString();
        billModel.agemonths = pat.agemonths.ToString();
        billModel.agedays = pat.agedays.ToString();
        billModel.dateofbirth = pat.dateofbirth?.ToString("yyyy-MM-dd");
        if (pat.dateofbirth.HasValue)
        {
            dobSelected = DateOnly.FromDateTime(pat.dateofbirth.Value);
        }
        
        if (pat.ftcode.HasValue && pat.ftcode.Value > 0)
        {
            billModel.ftcode = pat.ftcode.Value;
        }

        patientSearchQuery = $"{(string.IsNullOrEmpty(pat.namewithinitials) ? pat.name : pat.namewithinitials)} (CUST-{pat.custid})";
        selectedPatientBadgeVisible = true;
        showPatientDropdown = false;

        // Render patient details instantly to UI
        StateHasChanged();

        // 2. Lookup OP ID asynchronously if not already set
        if (string.IsNullOrEmpty(pat.op_id))
        {
            try
            {
                using var client = CreateClient(false); // Medico URL
                var searchKey = !string.IsNullOrEmpty(pat.mobile) ? pat.mobile : pat.custid.ToString();
                var response = await client.GetAsync($"api/OpRegistration/customers-with-op?key={Uri.EscapeDataString(searchKey)}");
                if (response.IsSuccessStatusCode)
                {
                    var rawJson = await response.Content.ReadAsStringAsync();
                    var settings = new Newtonsoft.Json.JsonSerializerSettings 
                    { 
                        NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore,
                        Error = (sender, args) => { args.ErrorContext.Handled = true; }
                    };
                    var medicoList = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.CustomerWithOpModel>>(rawJson, settings) ?? new();
                    var match = medicoList.FirstOrDefault(m => m.custid == pat.custid && !string.IsNullOrEmpty(m.op_id));
                    if (match != null)
                    {
                        pat.op_id = match.op_id;
                        pat.op_no = match.op_no;
                        billModel.op_id = match.op_id;
                        selectedOpNo = match.op_no;
                        StateHasChanged();
                    }
                }
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error retrieving patient op_id: {ex.Message}");
            }
        }

        // Auto-load ordered tests from Case Sheet and lookup registration details
        if (!string.IsNullOrEmpty(pat.op_id))
        {
            await LoadExistingBillOrRegistrationAsync(pat.op_id, clearFormFirst: false);
        }
        else if (billModel.ip_id.HasValue && billModel.ip_id.Value != Guid.Empty)
        {
            await LoadExistingBillOrRegistrationAsync(billModel.ip_id.Value.ToString(), clearFormFirst: false);
        }
        else if (pat.custid > 0)
        {
            await LoadExistingBillOrRegistrationAsync(pat.custid.ToString(), clearFormFirst: false);
        }
        else
        {
            await LoadUnbilledChargesAsync();
        }

        if (pat.custid > 0)
        {
            await CheckPatientAdvanceAsync((decimal)pat.custid);
        }

        RecalculateTotals();
        SaveStateToService();
        StateHasChanged();
    }

