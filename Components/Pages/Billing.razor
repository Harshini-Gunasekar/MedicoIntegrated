@page "/billing"
@page "/billing/{OpIdStr}"
@rendermode InteractiveServer
@using Newtonsoft.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.AppointmentBookingService AppointmentBookingService
@inject Booking.Services.CaseSheetService CaseSheetService
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.ToastService ToastService
@inject NavigationManager Navigation
@inject IHttpClientFactory ClientFactory
@inject ProtectedSessionStorage _sessionStorage
@using Medico_Backend.Model
@using LabCare.Models
@inject Booking.Services.CounterMasterService CounterMasterService
@inject LabCare.Services.TestService LabCareTestSvc
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState


<div class="billing-wrapper">
    <!-- Patient Info Horizontal Card -->
    <div class="billing-card patient-top-card" style="margin-bottom: 0.5rem;">
        <div class="patient-top-search">
            <div style="display: flex; gap: 1rem; align-items: center;">
                <div class="billing-form-group" style="width: 220px;">
                    <label>Branch</label>
                    <select class="billing-select" @bind="billModel.enteredbhcode">
                        <option value="0">Select Branch</option>
                        @foreach (var bh in branchesList)
                        {
                            <option value="@bh.bh_code">@bh.name</option>
                        }
                    </select>
                </div>
                <div class="billing-form-group" style="width: 160px;">
                    <label>Counter</label>
                    <select class="billing-select" @bind="billModel.cntcode">
                        <option value="0">Select Counter</option>
                        @foreach (var c in countersList)
                        {
                            <option value="@((int)c.cntcode)">@c.name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="billing-form-group" style="margin-left: auto;">
                <label>Search Mobile / UID</label>
                <div class="autocomplete-search-wrapper">
                    <input type="text" class="billing-input" placeholder="Search Patient Name or Mobile..." 
                           @bind="patientSearchQuery" @bind:event="oninput" @onkeyup="OnPatientSearchKeyUp" />
                    @if (showPatientDropdown && searchedPatients.Count > 0)
                    {
                        <div class="autocomplete-dropdown">
                            @foreach (var pat in searchedPatients)
                            {
                                <div class="autocomplete-item" @onclick="() => SelectCustomerPatient(pat)">
                                    <div>
                                        <span style="font-weight: 600; color: #0f172a;">@pat.name (CUST-@pat.custid)</span>
                                        <div style="font-size: 0.8em; color: #64748b;">
                                            📞 @pat.mobile | 📍 @(string.IsNullOrEmpty(pat.area) ? "No Area" : pat.area), @pat.city
                                            @if (!string.IsNullOrEmpty(pat.op_no))
                                            {
                                                <span> | 📄 OP No: @pat.op_no</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="autocomplete-code">@pat.custcode</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="patient-details-horizontal">
            <div class="patient-info-item">
                <span class="info-label">Patient Name</span>
                <span class="info-value">
                    @(string.IsNullOrWhiteSpace(billModel.patient_name) 
                        ? "-" 
                        : ((!string.IsNullOrWhiteSpace(patientPrefix) && !billModel.patient_name.StartsWith(patientPrefix, StringComparison.OrdinalIgnoreCase)) 
                            ? $"{patientPrefix} {billModel.patient_name}" 
                            : billModel.patient_name))
                </span>
            </div>
            <div class="patient-info-item">
                <span class="info-label">Cust ID</span>
                <span class="info-value">@(billModel.custid > 0 ? $"CUST-{billModel.custid}" : "-")</span>
            </div>
            <div class="patient-info-item">
                <span class="info-label">OP ID</span>
                <span class="info-value">@(string.IsNullOrEmpty(selectedOpNo) || selectedOpNo == "-" ? "-" : selectedOpNo)</span>
            </div>
           
            <div class="patient-info-item">
                <span class="info-label">Mobile number</span>
                <span class="info-value">@(string.IsNullOrWhiteSpace(billModel.mobileno) ? "-" : billModel.mobileno)</span>
            </div>
            <div class="patient-info-item">
                <span class="info-label">Date of Birth</span>
                <span class="info-value">@(dobSelected?.ToString("MM/dd/yyyy") ?? "-")</span>
            </div>
            <div class="patient-info-item">
                <span class="info-label">Gender</span>
                <span class="info-value">@(string.IsNullOrWhiteSpace(billModel.gender) ? "-" : billModel.gender)</span>
            </div>
            <div class="patient-info-item">
                <span class="info-label">Age</span>
                <span class="info-value">
                    @if (string.IsNullOrEmpty(billModel.ageyears))
                    {
                        @("-")
                    }
                    else
                    {
                        @($"{(string.IsNullOrEmpty(billModel.ageyears) ? "0" : billModel.ageyears)}")
                    }
                </span>
            </div>
            
            <div style="margin-left: auto; display: flex; align-items: center; gap: 0.5rem;">
                
                <button type="button" class="btn btn-sm" @onclick="ToggleMoreInfo" style="border: none; background: transparent; padding: 0.25rem 0.5rem; color: #64748b; font-size: 1.2rem;" title="More Info">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
            </div>
        </div>

        @if (showMoreInfo)
        {
            <div class="more-info-box" style="flex-direction: row; flex-wrap: wrap;">
                <div class="billing-form-group" style="flex: 1; min-width: 150px;">
                    <label>ID Type 1</label>
                    <select class="billing-select">
                        <option>Aadhaar Card</option>
                        <option>PAN Card</option>
                        <option>Driving License</option>
                    </select>
                    <input type="text" class="billing-input mt-1" placeholder="ID Number..." />
                </div>
                <div class="billing-form-group" style="flex: 1; min-width: 150px;">
                    <label>ID Type 2</label>
                    <select class="billing-select">
                        <option>Passport</option>
                        <option>Voter ID</option>
                        <option>Insurance ID</option>
                    </select>
                    <input type="text" class="billing-input mt-1" placeholder="ID Number..." />
                </div>
                <div class="billing-form-group" style="flex: 1; min-width: 150px;">
                    <label>Preferred Language</label>
                    <select class="billing-select">
                        <option>English</option>
                        <option>Hindi</option>
                        <option>Tamil</option>
                        <option>Telugu</option>
                    </select>
                </div>
                <div class="billing-form-group" style="flex: 1; min-width: 150px;">
                    <label>Occupation</label>
                    <input type="text" class="billing-input" placeholder="e.g. Engineer, Teacher, Doctor" />
                </div>
                <div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.25rem; flex: 1; min-width: 150px;">
                    <input type="checkbox" id="vip_patient" @bind="isVipPatient" style="width:16px; height:16px; cursor:pointer;" />
                    <label for="vip_patient" style="font-size:0.75rem; font-weight:700; color:#334155; cursor:pointer; margin:0;">VIP Patient</label>
                </div>
            </div>
        }
    </div>

    <!-- Doctor & Billing Info Section -->
    <div class="top-cards-grid" style="margin-bottom: 0.5rem;">
        <!-- Doctor Details Card -->
        <div class="billing-card" style="flex: 1; min-width: 300px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; align-items: end;">
            <div class="billing-form-group">
                <label>Consultant Doctor</label>
                <select class="billing-select" @bind="billModel.consultantdcode">
                    <option value="0">-- Direct / Walk-in --</option>
                    @foreach (var doc in doctorsCache)
                    {
                        <option value="@doc.dcode">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</option>
                    }
                </select>
            </div>
            <div class="billing-form-group">
                <label>Referred Doctor</label>
                <input type="text" class="billing-input" placeholder="Enter secondary referral..." />
            </div>
        </div>

        <!-- Billing Info Card -->
        <div class="billing-card" style="margin-bottom: 0; display: flex; flex-direction: column; gap: 0.85rem; justify-content: center;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed #e2e8f0; padding-bottom: 0.5rem;">
                <span style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Billing Serial No.</span>
                <span style="font-weight: 800; color: #0f172a; font-size: 0.95rem;">
                    @(string.IsNullOrEmpty(billModel.requestguid) ? "NEW BILL" : $"BILL ID: {billModel.requestguid.Substring(0, 8).ToUpper()}")
                </span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Billing Time</span>
                <span style="font-weight: 600; color: #475569; font-size: 0.85rem;">
                    @billingTimeDisplay
                </span>
            </div>
        </div>
    </div>

    <!-- Main Layout Grid -->
    <div class="billing-layout-grid">

        <!-- Middle Column: Test Selection & Grid -->
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            
            <!-- Test Selection & Services -->
            <div class="billing-card test-grid-card">
                

                <div class="billing-form-group">
                    <label>Search by Test Name / Short Code...</label>
                    <div class="autocomplete-search-wrapper">
                        <input type="text" class="billing-input" placeholder="Type test name or short code (e.g. CBC)..."
                               @bind="testSearchQuery" @bind:event="oninput" @onkeyup="OnTestSearchKeyUp" />
                        @if (showTestDropdown && filteredTestMasters.Count > 0)
                        {
                            <div class="autocomplete-dropdown">
                                @foreach (var tm in filteredTestMasters)
                                {
                                    <div class="autocomplete-item" @onclick="() => SelectTestMaster(tm)">
                                        <div style="display:flex; flex-direction:column; gap:2px;">
                                            <span style="font-weight:700; color:#0f172a;">@tm.name</span>
                                            @if (!string.IsNullOrWhiteSpace(tm.shortname))
                                            {
                                                <span style="font-size:0.72rem; color:#64748b; font-family:monospace;">@tm.shortname</span>
                                            }
                                        </div>
                                        <span class="autocomplete-code">₹ @tm.amount.ToString("F2")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div style="border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden; margin-top: 0.5rem; flex: 1;">
                    <table class="charge-table">
                        <thead>
                            <tr>
                                <th class="col-sno-charge">S.No</th>
                                <th class="col-details-charge">Test Details</th>
                                <th class="col-base-charge">Base Amount</th>
                                <th class="col-discount-charge">Discount (₹)</th>
                                <th class="col-total-charge">Total Amt</th>
                                <th class="col-action-charge">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (billModel.items.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" style="text-align:center; padding: 3rem; color: #94a3b8;">
                                        No tests selected. Search and select a test above to add.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in billModel.items)
                                {
                                    <tr>
                                        <td class="col-sno-charge">@row.sno</td>
                                        <td class="col-details-charge">@row.item_name</td>
                                        <td class="col-base-charge">
                                            <input type="number" class="charge-input" @bind="row.unit_rate" @bind:after="() => CalculateRow(row)" />
                                        </td>
                                        <td class="col-discount-charge">
                                            <input type="number" class="charge-input" @bind="row.discount" @bind:after="() => CalculateRow(row)" />
                                        </td>
                                        <td class="col-total-charge">₹ @row.amount.ToString("F2")</td>
                                        <td class="col-action-charge">
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveTestItem(row)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Bottom grid remarks -->
               
            </div>
        </div>

        <!-- Right Column: Collection By, Financial Summary, Payment Box -->
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          

            <!-- Unified Financial Summary Card -->
            <div style="background: #fdfdff; border: 1px solid #f1f5f9; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.02); display: flex; flex-direction: column;">
                
                <!-- Bill Amount -->
                <div style="padding: 0.75rem 1rem 0.5rem; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-weight: 700; color: #1e293b; font-size: 0.85rem;">Bill Amount (@billModel.items.Count Tests)</span>
                    <span style="font-weight: 700; color: #6366f1; font-size: 1rem;">₹ @totalBaseAmount.ToString("F2")</span>
                </div>

                <!-- General Concession -->
                <div style="padding: 0.5rem 1rem; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-weight: 600; color: #64748b; font-size: 0.65rem; display: flex; align-items: center; gap: 0.5rem; text-transform: uppercase;">
                        GENERAL CONCESSION <i class="bi bi-info-circle" style="color: #6366f1; font-size: 0.75rem;"></i>
                    </span>
                    <div style="display: flex; gap: 0.5rem; align-items: center; font-size: 0.65rem; font-weight: 600; color: #64748b;">
                        <input type="number" style="width: 45px; text-align: center; border: 1px solid #e2e8f0; border-radius: 6px; padding: 0.15rem; height: 26px; font-weight: 600; color: #0f172a;" @bind="billModel.discountper" @bind:after="OnGeneralConcessionPerChanged" />
                        %
                        <input type="number" style="width: 45px; text-align: center; border: 1px solid #e2e8f0; border-radius: 6px; padding: 0.15rem; height: 26px; font-weight: 600; color: #0f172a;" @bind="billModel.discountamount" @bind:after="OnGeneralConcessionAmtChanged" />
                        VAL
                    </div>
                </div>

                <!-- Dashed Separator -->
                <div style="margin: 0 1rem; border-bottom: 1px dashed #cbd5e1;"></div>

                <!-- Referral Concession -->
                <div style="padding: 0.5rem 1rem; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-weight: 600; color: #64748b; font-size: 0.65rem; display: flex; align-items: center; gap: 0.5rem; text-transform: uppercase;">
                        REFERRAL CONCESSION <i class="bi bi-info-circle" style="color: #6366f1; font-size: 0.75rem;"></i>
                    </span>
                    <div style="display: flex; gap: 0.5rem; align-items: center; font-size: 0.65rem; font-weight: 600; color: #64748b;">
                        <input type="number" style="width: 45px; text-align: center; border: 1px solid #e2e8f0; border-radius: 6px; padding: 0.15rem; height: 26px; font-weight: 600; color: #0f172a;" @bind="billModel.ourdispercentage" @bind:after="OnReferralConcessionPerChanged" />
                        %
                        <input type="number" style="width: 45px; text-align: center; border: 1px solid #e2e8f0; border-radius: 6px; padding: 0.15rem; height: 26px; font-weight: 600; color: #0f172a;" @bind="billModel.ourdiscount" @bind:after="OnReferralConcessionAmtChanged" />
                        VAL
                    </div>
                </div>

                <!-- Solid Separator -->
                <div style="margin: 0 1rem; border-bottom: 2px solid #e2e8f0;"></div>

                <!-- Net Payable -->
                <div style="padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-weight: 700; color: #1e293b; font-size: 0.85rem; text-transform: uppercase;">NET PAYABLE</span>
                    <span style="font-weight: 700; color: #6366f1; font-size: 1rem;">₹ @netPayable.ToString("F2")</span>
                </div>

                <!-- Payment Box (Lavendar) -->
                <div style="margin: 0 1rem 0.75rem; background: #f8faff; border-radius: 12px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-weight: 600; color: #1e293b; font-size: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
                            <i class="bi bi-cash" style="color: #10b981; font-size: 1rem;"></i> CASH
                        </span>
                        <input type="number" style="width: 90px; text-align: right; border: none; border-radius: 8px; padding: 0.3rem 0.5rem; height: 30px; font-weight: 700; color: #0f172a; box-shadow: 0 1px 2px rgba(0,0,0,0.05);" @bind="billModel.pmc1" @bind:after="RecalculateTotals" />
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-weight: 600; color: #1e293b; font-size: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
                            <i class="bi bi-credit-card" style="color: #0ea5e9; font-size: 1rem;"></i> CARD
                        </span>
                        <input type="number" style="width: 90px; text-align: right; border: none; border-radius: 8px; padding: 0.3rem 0.5rem; height: 30px; font-weight: 700; color: #0f172a; box-shadow: 0 1px 2px rgba(0,0,0,0.05);" @bind="billModel.pmc2" @bind:after="RecalculateTotals" />
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-weight: 600; color: #1e293b; font-size: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
                            <i class="bi bi-google-play" style="color: #ea4335; font-size: 1rem;"></i> GPAY / UPI
                        </span>
                        <input type="number" style="width: 90px; text-align: right; border: none; border-radius: 8px; padding: 0.3rem 0.5rem; height: 30px; font-weight: 700; color: #0f172a; box-shadow: 0 1px 2px rgba(0,0,0,0.05);" @bind="billModel.pmc3" @bind:after="RecalculateTotals" />
                    </div>
                </div>

                <!-- Balance Due Box -->
                <div style="background: #4f46e5; padding: 0.75rem 1rem; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-weight: 700; color: #ffffff; font-size: 0.85rem; text-transform: uppercase;">BALANCE DUE</span>
                    @if (balanceDue <= 0)
                    {
                        <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.15rem;">
                            <span style="font-weight: 700; color: #f97316; font-size: 1.05rem;">₹ 0.00</span>
                            <span style="font-size: 0.6rem; font-weight: 700; color: #10b981; background: #ffffff; padding: 0.1rem 0.3rem; border-radius: 4px; text-transform: uppercase;">Fully Settled</span>
                        </div>
                    }
                    else
                    {
                        <span style="font-weight: 700; color: #f97316; font-size: 1.05rem;">₹ @balanceDue.ToString("F2")</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Action Footer Row -->
    <div class="billing-footer">
        <div class="footer-left-actions">
            <div style="display:flex; flex-direction:column; gap:0.25rem;">
                <label style="font-size:0.65rem; font-weight:800; color:#64748b; text-transform:uppercase;">Barcode Printer</label>
                <select class="billing-select" style="height:36px; width: 220px;">
                    <option>ZEBRA-ZT411-PHLE (DEFAULT)</option>
                    <option>EPSON-L3110-COUNTER</option>
                    <option>MOCK-PRINTER-PORTABLE</option>
                </select>
            </div>
            <button type="button" class="btn-billing-footer outline" style="margin-top:auto;" @onclick="MockPrintBarcodes">
                <i class="bi bi-qr-code"></i> Print Barcodes
            </button>
            <button type="button" class="btn-billing-footer outline" style="margin-top:auto;" @onclick="MockPrintSerum">
                <i class="bi bi-droplet-half"></i> Print Serum
            </button>
        </div>

        <div class="footer-right-actions">
            <button type="button" class="btn-billing-footer clear" @onclick="ClearForm">
                <i class="bi bi-arrow-counterclockwise"></i> Clear
            </button>
            <button type="button" class="btn-billing-footer preview" @onclick="MockPreview">
                <i class="bi bi-eye"></i> Preview
            </button>
            <button type="button" class="btn-billing-footer print" @onclick="MockPrintInvoice">
                <i class="bi bi-printer"></i> Print Invoice
            </button>
            <button type="button" class="btn-billing-footer save" @onclick="SaveBillAsync" disabled="@savingInProgress">
                @if (savingInProgress)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                }
                <i class="bi bi-save"></i> Save Bill
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? OpIdStr { get; set; }

    private HmsBillModel billModel = new();
    
    // UI Helpers
    private string billingTimeDisplay = DateTime.Now.ToString("MM/dd/yyyy hh:mm tt");
    private string billingDateDisplay = DateTime.Now.ToString("yyyy-MM-dd");
    private bool isHuman = true;
    private bool showMoreInfo = false;
    private bool isVipPatient = false;
    private bool savingInProgress = false;

    // Prefixes
    private string patientPrefix = "Mr.";
    private string careOfPrefix = "S/O";
    private string careOfName = string.Empty;

    // Extra Patient Meta fields
    private DateOnly? dobSelected = null;
    private string patientEmail = string.Empty;

    // Search and Autocomplete cache lists
    private string patientSearchQuery = string.Empty;
    private bool showPatientDropdown = false;
    private List<OPRegistrationModel.OpRegistrationModel> allRegistrations = new();
    private List<OPRegistrationModel.OpRegistrationModel> filteredRegistrations = new();
    private List<DoctorBookingListModel> bookingsCache = new();
    private string? selectedOpNo = "-";
    
    private List<Booking.Models.CustomerWithOpModel> searchedPatients = new();
    private List<CustomerModel> allCustomersCache = new();
    private bool isCustomersCacheLoaded = false;
    private List<Booking.Models.BranchModel> branchesList = new();
    private List<CounterMasterModel> countersList = new();
    private string TenantCode = "";
    private string AuthToken = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                // Initialise TenantState so LabCare services can attach auth headers
                if (!string.IsNullOrEmpty(AuthToken))
                    TenantState.SetSession(TenantCode, AuthToken, "");

                await LoadBranchesAsync();
                await LoadCountersAsync();
                await LoadTestMastersAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error loading session: {ex.Message}");
            }
        }
    }

    private HttpClient CreateClient(bool isLabCare = false)
    {
        var clientName = isLabCare ? "LabCareUrl" : "DoctorApi";
        var client = ClientFactory.CreateClient(clientName);
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            using var client = CreateClient(true);
            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
