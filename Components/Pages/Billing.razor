    private async Task PrintSavedBillAsync()
    {
        if (!canPrintBill)
        {
            ToastService.ShowError("You do not have permission to print bills.");
            return;
        }
        if (string.IsNullOrEmpty(savedRequestGuid)) return;
        try
        {
            isPrintingSavedBill = true;
            StateHasChanged();

            // Fetch the bill PDF with the selected letterhead option and directly print it
            string url = $"api/Report/getbill?isletterhead={printWithLetterhead.ToString().ToLower()}&requestguid={savedRequestGuid}";
            var resp = await Http.GetAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                var raw = await resp.Content.ReadAsStringAsync();
                var base64 = raw.Trim().Trim('"');
                await JS.InvokeVoidAsync("openPdfPreviewModal", base64, "Bill Receipt Preview");
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to fetch bill PDF: {err}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Print error: {ex.Message}");
        }
        finally
        {
            isPrintingSavedBill = false;
            StateHasChanged();
        }
    }

    private async Task CloseSavedBillView()
    {
        savedRequestGuid = null;
        printWithLetterhead = true;
        BillingStateSvc?.Clear();
        await ClearFormAsync();
        StateHasChanged();
    }

    private void SaveStateToService()
    {
        if (BillingStateSvc != null && billModel != null)
        {
            BillingStateSvc.SaveState(
                billModel,
                patientPrefix,
                careOfPrefix,
                careOfName,
                patientEmail,
                dobSelected,
                patientSearchQuery,
                selectedPatientBadgeVisible,
                selectedOpNo,
                selectedIpNo,
                unbilledCharges,
                showPaymode2,
                showPaymode3,
                showAddConsultationForm,
                consultationRate,
                consultationQty,
                isHuman,
                isVipPatient,
                showMoreInfo,
                savedRequestGuid,
                printWithLetterhead,
                patientAdvanceAvailable,
                patientAdvanceSummary
            );
        }
    }

    private void RestoreStateFromService()
    {
        if (BillingStateSvc != null && BillingStateSvc.HasState && BillingStateSvc.BillModel != null)
        {
            billModel = BillingStateSvc.BillModel;
            savedRequestGuid = BillingStateSvc.SavedRequestGuid;
            printWithLetterhead = BillingStateSvc.PrintWithLetterhead;
            patientPrefix = BillingStateSvc.PatientPrefix;
            careOfPrefix = BillingStateSvc.CareOfPrefix;
            careOfName = BillingStateSvc.CareOfName;
            patientEmail = BillingStateSvc.PatientEmail;
            dobSelected = BillingStateSvc.DobSelected;
            patientSearchQuery = BillingStateSvc.PatientSearchQuery;
            selectedPatientBadgeVisible = BillingStateSvc.SelectedPatientBadgeVisible;
            selectedOpNo = BillingStateSvc.SelectedOpNo;
            selectedIpNo = BillingStateSvc.SelectedIpNo;
            unbilledCharges = BillingStateSvc.UnbilledCharges != null ? new List<UnbilledChargeSummary>(BillingStateSvc.UnbilledCharges) : new();
            showPaymode2 = BillingStateSvc.ShowPaymode2;
            showPaymode3 = BillingStateSvc.ShowPaymode3;
            showAddConsultationForm = BillingStateSvc.ShowAddConsultationForm;
            consultationRate = BillingStateSvc.ConsultationRate;
            consultationQty = BillingStateSvc.ConsultationQty;
            isHuman = BillingStateSvc.IsHuman;
            isVipPatient = BillingStateSvc.IsVipPatient;
            showMoreInfo = BillingStateSvc.ShowMoreInfo;
            patientAdvanceAvailable = BillingStateSvc.PatientAdvanceAvailable;
            patientAdvanceSummary = BillingStateSvc.PatientAdvanceSummary;

            RecalculateTotals();
        }
    }

    public void Dispose()
    {
        SaveStateToService();
    }
