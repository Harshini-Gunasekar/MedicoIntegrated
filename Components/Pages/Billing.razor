                        <button type="button" style="border: none; background: #fef2f2; color: #ef4444; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.85rem;" @onclick="ClearPaymode2" title="Clear Paymode 2">
