    private void RemoveTestItem(HmsBillItemModel item)
    {
        billModel.items.Remove(item);
        for (int i = 0; i < billModel.items.Count; i++)
        {
            billModel.items[i].sno = i + 1;
        }
        RecalculateTotals();
    }

    // --- Calculations ---
    private void CalculateRow(HmsBillItemModel row)
    {
        if (row.qty < 1) row.qty = 1;
        if (row.discount < 0) row.discount = 0;
        
        row.amount = (row.unit_rate * row.qty) - row.discount;
        if (row.amount < 0) row.amount = 0;

        RecalculateTotals();
    }

    private void OnGeneralConcessionPerChanged()
    {
        if (billModel.discountper < 0) billModel.discountper = 0;
        if (billModel.discountper > 100) billModel.discountper = 100;

        billModel.discountamount = totalBaseAmount * (billModel.discountper / 100m);
        RecalculateTotals();
    }

    private void OnGeneralConcessionAmtChanged()
    {
        if (billModel.discountamount < 0) billModel.discountamount = 0;
        if (billModel.discountamount > totalBaseAmount) billModel.discountamount = totalBaseAmount;

        if (totalBaseAmount > 0)
        {
            billModel.discountper = Math.Round((billModel.discountamount / totalBaseAmount) * 100m, 2);
        }
        else
        {
            billModel.discountper = 0;
        }
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {
        totalBaseAmount = 0;
        foreach (var item in billModel.items)
        {
            totalBaseAmount += item.amount;
        }

        // Concessions
        if (billModel.discountper > 0)
        {
            billModel.discountamount = totalBaseAmount * (billModel.discountper / 100m);
        }

        netPayable = totalBaseAmount - billModel.discountamount - billModel.specialdiscount;
        if (netPayable < 0) netPayable = 0;

        billModel.paidamount = billModel.pmc1 + billModel.pmc2 + billModel.pmc3;

        // Balance due calculation
        balanceDue = netPayable - billModel.paidamount;

        // Payment type mapping
        if (billModel.pmc1 > 0 && billModel.pmc2 == 0 && billModel.pmc3 == 0)
        {
            billModel.collection_type = "CASH";
            billModel.iscashbill = true;
            billModel.iscreditbill = false;
        }
        else if (billModel.pmc2 > 0 && billModel.pmc1 == 0 && billModel.pmc3 == 0)
        {
            billModel.collection_type = "CARD";
            billModel.iscashbill = false;
            billModel.iscreditbill = false;
        }
        else if (billModel.pmc3 > 0 && billModel.pmc1 == 0 && billModel.pmc2 == 0)
        {
            billModel.collection_type = "GPAY";
            billModel.iscashbill = false;
            billModel.iscreditbill = false;
        }
        else
        {
            billModel.collection_type = "MULTI";
            billModel.iscashbill = billModel.pmc1 > 0;
            billModel.iscreditbill = false;
        }
    }

    private void OnDobChanged()
    {
        if (dobSelected.HasValue)
        {
            billModel.dateofbirth = dobSelected.Value.ToString("yyyy-MM-dd");
            var today = DateOnly.FromDateTime(DateTime.Today);
            var ageSpan = today.DayNumber - dobSelected.Value.DayNumber;
            
            // Approximate calculation
            var years = today.Year - dobSelected.Value.Year;
            if (today.Month < dobSelected.Value.Month || (today.Month == dobSelected.Value.Month && today.Day < dobSelected.Value.Day))
            {
                years--;
            }
            
            billModel.ageyears = years.ToString();
            billModel.agemonths = "0";
            billModel.agedays = "0";
        }
    }

    private void OnAgeFieldsInput()
