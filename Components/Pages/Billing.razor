                    </label>
                    <button type="button" class="btn-billing-footer print" @onclick="PrintSavedBillAsync" disabled="@isPrintingSavedBill" style="background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; display: flex; align-items: center; gap: 0.35rem; padding: 0 1rem; height: 36px; border-radius: 6px; font-weight: 600;">
                        @if (isPrintingSavedBill)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" style="width: 12px; height: 12px; border-width: 1.5px;"></span>
                            <span>Printing...</span>
                        }
                        else
                        {
                            <i class="bi bi-printer"></i>
                            <span>Print Bill</span>
                        }
                    </button>
                    <button type="button" class="btn-billing-footer clear" @onclick="CloseSavedBillView" style="display: flex; align-items: center; gap: 0.35rem; padding: 0 1rem; height: 36px; border-radius: 6px; font-weight: 600;">
                        <i class="bi bi-plus-circle"></i> New Bill
                    </button>
                </div>
            }
            else
            {
                <button type="button" class="btn-billing-footer clear" @onclick="ClearForm">
                    <i class="bi bi-arrow-counterclockwise"></i> Clear
                </button>
                <button type="button" class="btn-billing-footer preview" @onclick="MockPreview">
                    <i class="bi bi-eye"></i> Preview
                </button>
                @if (canPrintBill)
                {
                    <button type="button" class="btn-billing-footer print" @onclick="MockPrintInvoice">
                        <i class="bi bi-printer"></i> Print Invoice
                    </button>
                }
                <button type="button" class="btn-billing-footer save" @onclick="SaveBillAsync" disabled="@savingInProgress">
                    @if (savingInProgress)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                    }
                    <i class="bi bi-save"></i> Save Bill
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? OpIdStr { get; set; }

