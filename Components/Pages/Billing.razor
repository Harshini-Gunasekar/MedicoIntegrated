    private async Task HandlePatientSaved(SharedComponents.Rcl.Models.CustomerModel savedPatient)
    {
        showNewPatientModal = false;
        if (savedPatient != null && savedPatient.custid > 0)
        {
            if (allCustomersCache != null && !allCustomersCache.Any(c => c.custid == savedPatient.custid))
