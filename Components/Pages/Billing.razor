    // --- Actions ---
    private async Task SaveBillAsync()
    {
        if (savingInProgress) return;
        savingInProgress = true;
        StateHasChanged();

        if (string.IsNullOrWhiteSpace(billModel.patient_name))
        {
            savingInProgress = false;
            ToastService.ShowError("Please enter Patient Name.");
            return;
        }
        if (billModel.items.Count == 0)
        {
            savingInProgress = false;
            ToastService.ShowError("Please add at least one test to the billing grid.");
            return;
        }
        if (billModel.pmc1 == null && billModel.pmc2 == null && billModel.pmc3 == null)
        {
            savingInProgress = false;
            ToastService.ShowError("Please select a payment mode.");
            return;
        }

        // Check counter shift status before saving
        bool isShiftOpen = await CheckCounterShiftOpenAsync(showPrompt: true);
        if (!isShiftOpen)
        {
            savingInProgress = false;
            pendingSaveAfterOpenShift = true;
            return;
        }

        int resolvedUserCode = activeUserCode > 0 ? activeUserCode : (TenantState.UserCode > 0 ? TenantState.UserCode : 1);
        billModel.usercode = resolvedUserCode;

        // Detect if Advance paymode was used
        double advanceUsed = 0;
        var advancePaymodeCodes = paymodesList
            .Where(p => string.Equals(p.name, "ADVANCE", StringComparison.OrdinalIgnoreCase) || 
                        string.Equals(p.shortname, "ADVANCE", StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(p.shortname, "ADV", StringComparison.OrdinalIgnoreCase))
            .Select(p => (double)p.pmcode)
            .ToList();
        
        if (!advancePaymodeCodes.Contains(99)) advancePaymodeCodes.Add(99);

        if (billModel.pmc1.HasValue && advancePaymodeCodes.Contains(billModel.pmc1.Value) && (billModel.pmc1_amount ?? 0) > 0)
            advanceUsed += billModel.pmc1_amount.Value;
        if (billModel.pmc2.HasValue && advancePaymodeCodes.Contains(billModel.pmc2.Value) && (billModel.pmc2_amount ?? 0) > 0)
            advanceUsed += billModel.pmc2_amount.Value;
        if (billModel.pmc3.HasValue && advancePaymodeCodes.Contains(billModel.pmc3.Value) && (billModel.pmc3_amount ?? 0) > 0)
            advanceUsed += billModel.pmc3_amount.Value;

        if (advanceUsed > 0 && advanceUsed > (patientAdvanceAvailable + 0.01))
        {
            savingInProgress = false;
            ToastService.ShowError($"Advance amount to use (₹ {advanceUsed:N2}) exceeds available advance balance (₹ {patientAdvanceAvailable:N2}).");
            return;
        }

        // Cap paymode amounts before saving/updating
        double? origPmc1Code = billModel.pmc1;
        double? origPmc2Code = billModel.pmc2;
        double? origPmc3Code = billModel.pmc3;
        double? origPmc1 = billModel.pmc1_amount;
        double? origPmc2 = billModel.pmc2_amount;
        double? origPmc3 = billModel.pmc3_amount;
        decimal origPaidAmount = billModel.paidamount;
        string? origCollectionType = billModel.collection_type;
        bool origIsCashBill = billModel.iscashbill;
        bool origIsCreditBill = billModel.iscreditbill;

        if (advanceUsed > 0)
        {
            // For SaveBillAsync: bill is saved with remaining non-advance amount so that
            // CollectBulkDueAsync can collect the advance amount against the bill and record
            // it into receipt_advances (deducting the patient advance balance on the backend).
            var nonAdvModes = new List<(double mode, double amt)>();
            if (billModel.pmc1.HasValue && !advancePaymodeCodes.Contains(billModel.pmc1.Value) && (billModel.pmc1_amount ?? 0) > 0)
                nonAdvModes.Add((billModel.pmc1.Value, billModel.pmc1_amount.Value));
            if (billModel.pmc2.HasValue && !advancePaymodeCodes.Contains(billModel.pmc2.Value) && (billModel.pmc2_amount ?? 0) > 0)
                nonAdvModes.Add((billModel.pmc2.Value, billModel.pmc2_amount.Value));
            if (billModel.pmc3.HasValue && !advancePaymodeCodes.Contains(billModel.pmc3.Value) && (billModel.pmc3_amount ?? 0) > 0)
                nonAdvModes.Add((billModel.pmc3.Value, billModel.pmc3_amount.Value));

            if (nonAdvModes.Count > 0)
            {
                billModel.pmc1 = nonAdvModes[0].mode;
                billModel.pmc1_amount = nonAdvModes[0].amt;
            }
            else
            {
                var cashPm = paymodesList.FirstOrDefault(p => string.Equals(p.shortname, "CASH", StringComparison.OrdinalIgnoreCase)) ?? paymodesList.FirstOrDefault();
                billModel.pmc1 = cashPm != null ? (double)cashPm.pmcode : 1;
                billModel.pmc1_amount = 0;
            }

            if (nonAdvModes.Count > 1)
            {
                billModel.pmc2 = nonAdvModes[1].mode;
                billModel.pmc2_amount = nonAdvModes[1].amt;
            }
            else
            {
                billModel.pmc2 = null;
                billModel.pmc2_amount = 0;
            }

            if (nonAdvModes.Count > 2)
            {
                billModel.pmc3 = nonAdvModes[2].mode;
                billModel.pmc3_amount = nonAdvModes[2].amt;
            }
            else
            {
                billModel.pmc3 = null;
                billModel.pmc3_amount = 0;
            }

            decimal nonAdvancePaid = (decimal)nonAdvModes.Sum(m => m.amt);
            decimal maxNonAdvAllowed = Math.Max(0m, netPayable - (decimal)advanceUsed);
            billModel.paidamount = Math.Min(nonAdvancePaid, maxNonAdvAllowed);

            if (nonAdvModes.Count > 1)
            {
                billModel.collection_type = "MULTI";
                billModel.iscashbill = nonAdvModes.Any(m => {
                    var pm = paymodesList.FirstOrDefault(p => (double)p.pmcode == m.mode);
                    return string.Equals(pm?.shortname, "CASH", StringComparison.OrdinalIgnoreCase);
                });
                billModel.iscreditbill = false;
            }
            else if (nonAdvModes.Count == 1)
            {
                var pm = paymodesList.FirstOrDefault(p => (double)p.pmcode == nonAdvModes[0].mode);
                billModel.collection_type = pm?.shortname ?? "CASH";
                billModel.iscashbill = string.Equals(billModel.collection_type, "CASH", StringComparison.OrdinalIgnoreCase);
                billModel.iscreditbill = false;
            }
            else
            {
                billModel.collection_type = "DUE";
                billModel.iscashbill = false;
                billModel.iscreditbill = true;
            }
        }
        else if (totalEnteredPaid > netPayable)
        {
            decimal targetPaid = netPayable;
            decimal remaining = targetPaid;

            if (billModel.pmc1_amount.HasValue && billModel.pmc1_amount.Value > 0)
            {
                double val = (double)Math.Min((decimal)billModel.pmc1_amount.Value, remaining);
                billModel.pmc1_amount = val;
                remaining -= (decimal)val;
            }
            if (billModel.pmc2_amount.HasValue && billModel.pmc2_amount.Value > 0)
            {
                double val = (double)Math.Min((decimal)billModel.pmc2_amount.Value, remaining);
                billModel.pmc2_amount = val;
                remaining -= (decimal)val;
            }
            if (billModel.pmc3_amount.HasValue && billModel.pmc3_amount.Value > 0)
            {
                double val = (double)Math.Min((decimal)billModel.pmc3_amount.Value, remaining);
                billModel.pmc3_amount = val;
                remaining -= (decimal)val;
            }

            billModel.paidamount = netPayable;
        }

        try
        {
            string? originalOpId = billModel.op_id;
            if (!string.IsNullOrEmpty(selectedOpNo) && selectedOpNo != "-")
            {
                billModel.op_id = selectedOpNo;
            }

            // Retrieve latest unbilled charges from backend to get their current unbilledids (especially for room rent where Guid changes on every query)
            List<UnbilledChargeSummary> latestUnbilled = new();
            try
            {
                latestUnbilled = await HmsBillingService.GetUnbilledChargesByVisitAsync(originalOpId, billModel.ip_id) ?? new();
                var allLatest = await HmsBillingService.GetAllUnbilledChargesAsync() ?? new();
                foreach (var uc in allLatest)
                {
                    if (!latestUnbilled.Any(l => !string.IsNullOrEmpty(l.unbilledid) && !string.IsNullOrEmpty(uc.unbilledid) && string.Equals(l.unbilledid, uc.unbilledid, StringComparison.OrdinalIgnoreCase)))
                    {
                        latestUnbilled.Add(uc);
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error fetching latest unbilled charges for ID mapping: {ex.Message}");
            }

            var unbilledIdsToPass = new List<string>();
            foreach (var item in billModel.items)
            {
                // Try to find the matching unbilled charge from the latest API response
                var match = latestUnbilled.FirstOrDefault(uc =>
                    (!string.IsNullOrEmpty(item.requestdetailsid) && !string.IsNullOrEmpty(uc.unbilledid) && string.Equals(item.requestdetailsid.Trim(), uc.unbilledid.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(item.item_ref_id) && !string.IsNullOrEmpty(uc.entryid) && string.Equals(item.item_ref_id.Trim(), uc.entryid.Trim(), StringComparison.OrdinalIgnoreCase))
                );

                if (match != null && !string.IsNullOrEmpty(match.unbilledid))
                {
                    unbilledIdsToPass.Add(match.unbilledid);
                }
                else if (!string.IsNullOrEmpty(item.requestdetailsid))
                {
                    unbilledIdsToPass.Add(item.requestdetailsid);
                }
            }

            // Also include any unbilled consultation/registration charges for this OP visit or customer
            foreach (var uc in latestUnbilled)
            {
                if (uc.billedstatus == true) continue;
                if (!string.IsNullOrEmpty(uc.unbilledid))
                {
                    bool matchOp = (!string.IsNullOrEmpty(originalOpId) && string.Equals(uc.opvisitid, originalOpId, StringComparison.OrdinalIgnoreCase)) ||
                                   (!string.IsNullOrEmpty(selectedOpNo) && string.Equals(uc.opvisitid, selectedOpNo, StringComparison.OrdinalIgnoreCase)) ||
                                   (billModel.ip_id.HasValue && billModel.ip_id.Value != Guid.Empty && uc.ip_id == billModel.ip_id) ||
                                   (billModel.custid > 0 && uc.custid == billModel.custid);

                    if (matchOp && (string.Equals(uc.entrytype, "CONSULTATION", StringComparison.OrdinalIgnoreCase) || (uc.amount ?? 0) <= 0))
                    {
                        unbilledIdsToPass.Add(uc.unbilledid);
                    }
                }
            }

            billModel.unbilled_charge_ids = unbilledIdsToPass.Distinct().ToList();

            string result;
            if (!string.IsNullOrEmpty(billModel.requestguid))
            {
                result = await HmsBillingService.UpdateBillAsync(billModel);
            }
            else
            {
                // Ensure requestguid is passed as null for saving as requested
                billModel.requestguid = null;
                result = await HmsBillingService.SaveBillAsync(billModel);
            }

            // Restore the original op_id Guid so the UI and appointment update functions can use it
            billModel.op_id = originalOpId;

            bool isSuccess = false;
            string displayMessage = "";

            if (!string.IsNullOrEmpty(result))
            {
                if (result.Contains("Error", StringComparison.OrdinalIgnoreCase))
                {
                    isSuccess = false;
                    displayMessage = result;
                }
                else if (result.Trim().StartsWith("{") && result.Trim().EndsWith("}"))
                {
                    try
                    {
                        var jsonObj = Newtonsoft.Json.Linq.JObject.Parse(result);
                        if (jsonObj["message"] != null)
                        {
                            var msg = jsonObj["message"].ToString();
                            if (msg.Contains("not open", StringComparison.OrdinalIgnoreCase) || 
                                msg.Contains("shift is closed", StringComparison.OrdinalIgnoreCase))
                            {
                                isSuccess = false;
                                displayMessage = msg;
                                pendingSaveAfterOpenShift = true;
                                await CheckCounterShiftOpenAsync(showPrompt: true);
                                savingInProgress = false;
                                return;
                            }
                            else if (msg.Contains("error", StringComparison.OrdinalIgnoreCase) || 
                                     msg.Contains("fail", StringComparison.OrdinalIgnoreCase) ||
                                     msg.Contains("invalid", StringComparison.OrdinalIgnoreCase))
                            {
                                isSuccess = false;
                                displayMessage = msg;
                            }
                            else
                            {
                                isSuccess = true;
                                displayMessage = msg;
                            }
                        }
                        else if (jsonObj["requestguid"] != null || jsonObj["bill_no"] != null)
                        {
                            isSuccess = true;
                            displayMessage = "Bill Saved and Posted Successfully!";
                        }
                        else
                        {
                            isSuccess = false;
                            displayMessage = result;
                        }
                    }
                    catch
                    {
                        isSuccess = true;
                        displayMessage = "Bill Saved and Posted Successfully!";
                    }
                }
                else
                {
                    isSuccess = true;
                    displayMessage = "Bill Saved and Posted Successfully!";
                }
            }

            if (isSuccess)
            {
                // Extract saved request GUID to display preview
                string? savedGuid = null;
                if (!string.IsNullOrEmpty(billModel.requestguid))
                {
                    savedGuid = billModel.requestguid;
                }
                else if (!string.IsNullOrEmpty(result) && result.Trim().StartsWith("{") && result.Trim().EndsWith("}"))
                {
                    try
                    {
                        var jsonObj = Newtonsoft.Json.Linq.JObject.Parse(result);
                        if (jsonObj["requestguid"] != null)
                        {
                            savedGuid = jsonObj["requestguid"].ToString();
                        }
                    }
                    catch { }
                }

                savedRequestGuid = !string.IsNullOrEmpty(savedGuid) ? savedGuid : "SAVED";
                billModel.requestguid = savedRequestGuid;

                // Deduct patient advance if Advance paymode was used (Exact Cash Counter Logic)
                if (advanceUsed > 0 && !string.IsNullOrEmpty(savedRequestGuid) && savedRequestGuid != "SAVED")
                {
                    try
                    {
                        var bulkItem = new HmsBulkDueCollectionItem
                        {
                            requestguid     = savedRequestGuid,
                            cash_collected  = 0,
                            advance_to_use  = advanceUsed,
                            collection_type = "ADVANCE",
                            isbill          = true,
                            ispatient       = true
                        };

                        var bulkReq = new HmsBulkDueCollectionRequest
                        {
                            items           = new List<HmsBulkDueCollectionItem> { bulkItem },
                            collection_type = "ADVANCE",
                            cntcode         = billModel.cntcode > 0 ? billModel.cntcode : 1,
                            usercode        = resolvedUserCode > 0 ? resolvedUserCode : 10,
                            enteredbhcode   = billModel.enteredbhcode > 0 ? billModel.enteredbhcode : 1,
                            computercode    = billModel.computercode > 0 ? billModel.computercode : 1,
                            isbill          = true,
                            ispatient       = true
                        };

                        var dueRes = await DueCollectionService.CollectBulkDueAsync(bulkReq);
                        if (dueRes != null)
                        {
                            Console.WriteLine($"[Billing] Advance collection posted successfully for bill {savedRequestGuid}: receipt {dueRes.receipt_no}");
                        }
                        else
                        {
                            var useReq = new HmsAdvanceUseRequest
                            {
                                custid          = billModel.custid,
                                amount_to_use   = advanceUsed,
                                enteredbhcode   = billModel.enteredbhcode > 0 ? billModel.enteredbhcode : 1,
                                cntcode         = billModel.cntcode > 0 ? billModel.cntcode : 1,
                                usercode        = resolvedUserCode > 0 ? resolvedUserCode : 10,
                                computercode    = billModel.computercode > 0 ? billModel.computercode : 1,
                                remarks         = $"Billing payment using advance for bill {savedRequestGuid}"
                            };

                            var useRes = await DueCollectionService.UseAdvanceAsync(useReq);
                            if (useRes != null)
                            {
                                Console.WriteLine($"[Billing] Advance use endpoint posted successfully for patient {billModel.custid}: amount {advanceUsed}, receipt: {useRes.receipt_no}");
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.Error.WriteLine($"[Billing] Error deducting patient advance: {ex.Message}");
                    }
                }

                if (billModel.custid > 0)
                {
                    await CheckPatientAdvanceAsync(billModel.custid);
                }

                SaveStateToService();
                ToastService.ShowSuccess(!string.IsNullOrEmpty(displayMessage) ? displayMessage : "Bill Saved and Posted Successfully!");
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError($"Failed to save bill. API error: {displayMessage}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Exception while saving bill: {ex.Message}");
        }
        finally
        {
            // Restore original amounts for UI consistency
            billModel.pmc1 = origPmc1Code;
            billModel.pmc2 = origPmc2Code;
            billModel.pmc3 = origPmc3Code;
            billModel.pmc1_amount = origPmc1;
            billModel.pmc2_amount = origPmc2;
            billModel.pmc3_amount = origPmc3;
            billModel.paidamount = origPaidAmount;
            billModel.collection_type = origCollectionType;
            billModel.iscashbill = origIsCashBill;
            billModel.iscreditbill = origIsCreditBill;
            savingInProgress = false;
        }
    }

    private void ClearForm()
    {
        int initialBranchCode = activeBranchCode > 0 && branchesList.Any(b => b.bh_code == activeBranchCode)
            ? activeBranchCode
            : (branchesList.FirstOrDefault()?.bh_code ?? 1);

        int resolvedUserCode = activeUserCode > 0 ? activeUserCode : (TenantState.UserCode > 0 ? TenantState.UserCode : 1);

        int initialCounterCode = 1;
        var availableCounters = GetFilteredCounters().ToList();
        if (availableCounters.Any())
        {
            initialCounterCode = (int)availableCounters.First().cntcode;
        }

        billModel = new HmsBillModel
        {
            enteredbhcode = initialBranchCode,
            cntcode = initialCounterCode,
            usercode = resolvedUserCode,
            computercode = 1,
            ftcode = 1,
            pmcode = 1,
            ctcode = 2
        };

        // Default first paymode to Cash if available
        var cashPaymode = paymodesList.FirstOrDefault(p => string.Equals(p.shortname, "CASH", StringComparison.OrdinalIgnoreCase)) ?? paymodesList.FirstOrDefault();
        if (cashPaymode != null)
        {
            billModel.pmc1 = (double)cashPaymode.pmcode;
            billModel.pmc1_amount = null;
        }
        else
        {
            billModel.pmc1 = 1;
            billModel.pmc1_amount = null;
        }

        var cardPaymode = paymodesList.FirstOrDefault(p => string.Equals(p.shortname, "CARD", StringComparison.OrdinalIgnoreCase));
        billModel.pmc2 = cardPaymode != null ? (double)cardPaymode.pmcode : 2;
        billModel.pmc2_amount = null;

        var upiPaymode = paymodesList.FirstOrDefault(p => string.Equals(p.shortname, "UPI", StringComparison.OrdinalIgnoreCase) || string.Equals(p.shortname, "GPAY", StringComparison.OrdinalIgnoreCase));
        billModel.pmc3 = upiPaymode != null ? (double)upiPaymode.pmcode : 3;
        billModel.pmc3_amount = null;

        dobSelected = null;
        patientPrefix = "Mr.";
        billModel.dateofbirth = null;
        billModel.gender = null;
        billModel.ageyears = null;
        billModel.agemonths = null;
        billModel.agedays = null;
        careOfName = string.Empty;
        patientEmail = string.Empty;
        patientSearchQuery = string.Empty;
        testSearchQuery = string.Empty;
        areaSearchQuery = string.Empty;
        selectedPatientBadgeVisible = false;
        isCustomersCacheLoaded = false;
        selectedOpNo = "-";
        selectedIpNo = "-";
        
        unbilledCharges.Clear();
        showAddConsultationForm = false;
        
        showPaymode2 = false;
        showPaymode3 = false;
        
        savedRequestGuid = null;
        printWithLetterhead = true;
        
        BillingStateSvc?.Clear();
        patientAdvanceAvailable = 0;
        patientAdvanceSummary = null;
        RecalculateTotals();
    }

    private async Task ClearFormAsync()
    {
        ClearForm();
        int defaultCnt = await GetDefaultCounterCodeAsync();
        if (defaultCnt > 0)
        {
            billModel.cntcode = defaultCnt;
            try
            {
                await _sessionStorage.SetAsync("cntcode", defaultCnt.ToString());
            }
            catch { }
        }
        StateHasChanged();
    }

