    // --- Calculations ---
    private void CalculateRow(HmsBillItemModel row)
    {
        if (row.qty < 1) row.qty = 1;
        if (row.discount < 0) row.discount = 0;
        
        row.amount = (row.unit_rate * row.qty) - row.discount;
        if (row.amount < 0) row.amount = 0;

        RecalculateTotals();
    }

    private void OnGeneralConcessionPerChanged()
    {
        if (billModel.discountper < 0) billModel.discountper = 0;
        if (billModel.discountper > 100) billModel.discountper = 100;

        billModel.discountamount = totalBaseAmount * (billModel.discountper / 100m);
        RecalculateTotals();
    }

    private void OnGeneralConcessionAmtChanged()
    {
        if (billModel.discountamount < 0) billModel.discountamount = 0;
        if (billModel.discountamount > totalBaseAmount) billModel.discountamount = totalBaseAmount;

        if (totalBaseAmount > 0)
        {
            billModel.discountper = Math.Round((billModel.discountamount / totalBaseAmount) * 100m, 2);
        }
        else
        {
            billModel.discountper = 0;
        }
        RecalculateTotals();
    }

    private void OnReferralConcessionPerChanged()
    {
        if (billModel.ourdispercentage < 0) billModel.ourdispercentage = 0;
        if (billModel.ourdispercentage > 100) billModel.ourdispercentage = 100;

        billModel.ourdiscount = totalBaseAmount * (billModel.ourdispercentage / 100m);
        RecalculateTotals();
    }

    private void OnReferralConcessionAmtChanged()
    {
        if (billModel.ourdiscount < 0) billModel.ourdiscount = 0;
        if (billModel.ourdiscount > totalBaseAmount) billModel.ourdiscount = totalBaseAmount;

        if (totalBaseAmount > 0)
        {
            billModel.ourdispercentage = Math.Round((billModel.ourdiscount / totalBaseAmount) * 100m, 2);
        }
        else
        {
            billModel.ourdispercentage = 0;
        }
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {
        totalBaseAmount = 0;
        foreach (var item in billModel.items)
        {
            totalBaseAmount += item.amount;
        }

        // Concessions
        if (billModel.discountper > 0)
        {
            billModel.discountamount = totalBaseAmount * (billModel.discountper / 100m);
        }

        if (billModel.ourdispercentage > 0)
        {
            billModel.ourdiscount = totalBaseAmount * (billModel.ourdispercentage / 100m);
        }

        billModel.specialdiscount = billModel.ourdiscount;

        netPayable = totalBaseAmount - billModel.discountamount - billModel.ourdiscount;
        if (netPayable < 0) netPayable = 0;

        billModel.paidamount = (decimal)((billModel.pmc1_amount ?? 0) + (billModel.pmc2_amount ?? 0) + (billModel.pmc3_amount ?? 0));

        // Balance due calculation
        balanceDue = netPayable - billModel.paidamount;

        // Payment type mapping based on selected paymodes from DB
        int activeCount = 0;
        string? activeType = null;
        bool hasCash = false;

        if (billModel.pmc1.HasValue && (billModel.pmc1_amount ?? 0) > 0)
        {
            activeCount++;
            var pm = paymodesList.FirstOrDefault(p => (double)p.pmcode == billModel.pmc1.Value);
            activeType = pm?.shortname ?? "CASH";
            if (string.Equals(activeType, "CASH", StringComparison.OrdinalIgnoreCase)) hasCash = true;
        }
        if (billModel.pmc2.HasValue && (billModel.pmc2_amount ?? 0) > 0)
        {
            activeCount++;
            var pm = paymodesList.FirstOrDefault(p => (double)p.pmcode == billModel.pmc2.Value);
            activeType = pm?.shortname ?? "CARD";
            if (string.Equals(pm?.shortname, "CASH", StringComparison.OrdinalIgnoreCase)) hasCash = true;
        }
        if (billModel.pmc3.HasValue && (billModel.pmc3_amount ?? 0) > 0)
        {
            activeCount++;
            var pm = paymodesList.FirstOrDefault(p => (double)p.pmcode == billModel.pmc3.Value);
            activeType = pm?.shortname ?? "GPAY";
            if (string.Equals(pm?.shortname, "CASH", StringComparison.OrdinalIgnoreCase)) hasCash = true;
        }

        if (activeCount == 1)
        {
            billModel.collection_type = activeType ?? "CASH";
            billModel.iscashbill = hasCash;
            billModel.iscreditbill = false;
        }
        else if (activeCount > 1)
        {
            billModel.collection_type = "MULTI";
            billModel.iscashbill = hasCash;
            billModel.iscreditbill = false;
        }
        else
        {
            billModel.collection_type = "CASH";
            billModel.iscashbill = true;
            billModel.iscreditbill = false;
        }
    }

