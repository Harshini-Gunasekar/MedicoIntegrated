                    <label class="letterhead-toggle-label" style="display: flex; align-items: center; gap: 0.4rem; font-weight: 700; font-size: 0.85rem; color: #334155; cursor: pointer; user-select: none;">
                        <input type="checkbox" @bind="printWithLetterhead" style="width: 16px; height: 16px; cursor: pointer;" />
