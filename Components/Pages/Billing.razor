    private async Task LoadCustomersCacheAsync(bool forceReload = false)
    {
        if (isCustomersCacheLoaded && !forceReload) return;
        try
        {
            using var client = CreateClient(true);
            var response = await client.GetAsync("api/Customer/get");
            if (response.IsSuccessStatusCode)
            {
                allCustomersCache = await response.Content.ReadFromJsonAsync<List<CustomerModel>>() ?? new();
                isCustomersCacheLoaded = true;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading customers cache: {ex.Message}");
        }
    }

    private async Task OnPatientSearchKeyUp(KeyboardEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(patientSearchQuery))
        {
            searchedPatients.Clear();
            showPatientDropdown = false;
            return;
        }

        try
        {
            using var client = CreateClient(true);
            var response = await client.GetAsync($"api/Customer/search?key={Uri.EscapeDataString(patientSearchQuery)}");
            if (response.IsSuccessStatusCode)
            {
                var list = await response.Content.ReadFromJsonAsync<List<CustomerModel>>() ?? new();
                searchedPatients = list.Take(10).ToList();
                showPatientDropdown = true;
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Console.Error.WriteLine($"Error searching patients: {response.StatusCode} - {err}");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error searching patients: {ex.Message}");
        }
    }

