@page "/billing"
@page "/billing/{OpIdStr}"
@rendermode InteractiveServer
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.AppointmentBookingService AppointmentBookingService
@inject Booking.Services.CaseSheetService CaseSheetService
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.ToastService ToastService
@inject NavigationManager Navigation

<div class="billing-wrapper">
    <!-- Top Bar -->
    <div class="billing-top-bar">
        <div class="top-bar-item">
            <label>Branch</label>
            <select @bind="billModel.enteredbhcode">
                <option value="1">Erode Center</option>
                <option value="2">Main Branch</option>
                <option value="3">Salem Clinic</option>
            </select>
        </div>
        <div class="top-bar-item">
            <label>Counter</label>
            <select @bind="billModel.cntcode">
                <option value="2">Sample Counter</option>
                <option value="1">Billing Counter 1</option>
                <option value="3">Billing Counter 2</option>
            </select>
        </div>
        <div class="top-bar-item">
            <label>Billing Serial No.</label>
            <span class="serial-no-badge">
                @(string.IsNullOrEmpty(billModel.requestguid) ? "NEW BILL (AUTO-GENERATE)" : $"BILL ID: {billModel.requestguid.Substring(0, 8).ToUpper()}")
            </span>
        </div>
        <div class="top-bar-item">
            <label>Billing Time</label>
            <input type="text" value="@billingTimeDisplay" disabled />
        </div>
        <div class="top-bar-item">
            <label>Sample Collection Time</label>
            <input type="text" value="@billingTimeDisplay" disabled />
        </div>
    </div>

    <!-- Main Layout Grid -->
    <div class="billing-layout-grid">
        
        <!-- Left Panel: Patient Identification -->
        <div class="billing-card">
            <div class="billing-card-header">
                <span class="card-title-text"><i class="bi bi-person-bounding-box"></i> Patient Identification</span>
            </div>

            
            <div class="billing-form-group">
                <label>Search Mobile / UID</label>
                <div class="autocomplete-search-wrapper">
                    <input type="text" class="billing-input" placeholder="Search Patient Name or Mobile..." 
                           @bind="patientSearchQuery" @bind:event="oninput" @onkeyup="OnPatientSearchKeyUp" />
                    @if (showPatientDropdown && filteredRegistrations.Count > 0)
                    {
                        <div class="autocomplete-dropdown">
                            @foreach (var reg in filteredRegistrations)
                            {
                                var bk = bookingsCache.FirstOrDefault(b => b.custid == reg.custid);
                                var patientName = bk?.patient_name ?? $"Patient ID {reg.custid}";
                                var mobile = bk?.notes ?? reg.op_no; // notes or op_no for display
                                <div class="autocomplete-item" @onclick="() => SelectPatient(reg, patientName, mobile)">
                                    <div>
                                        <span>@patientName (CUST-@reg.custid)</span>
                                        <div style="font-size: 0.8em; color: #64748b;">📞 @mobile</div>
                                    </div>
                                    <span class="autocomplete-code">@reg.op_no</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (selectedPatientBadgeVisible)
            {
                <div class="patient-search-result-badge">
                    <span>Selected: <b>@billModel.patient_name</b></span>
                    <button type="button" class="close-btn" style="font-size:1.1rem; line-height:1;" @onclick="ClearSelectedPatient">×</button>
                </div>
            }

            <div class="billing-form-group">
                <label>Prefix</label>
                <select class="billing-select" @bind="patientPrefix" @bind:after="OnPrefixChanged">
                    <option value="Mr.">Mr.</option>
                    <option value="Ms.">Ms.</option>
                    <option value="Mrs.">Mrs.</option>
                    <option value="Dr.">Dr.</option>
                    <option value="Baby">Baby</option>
                    <option value="Mast.">Mast.</option>
                </select>
            </div>

            <div class="billing-form-group">
                <label>Patient Name<span class="required">*</span></label>
                <input type="text" class="billing-input" placeholder="Ankit Sharma" @bind="billModel.patient_name" />
            </div>

            <div class="careof-grid">
                <div class="billing-form-group">
                    <label>C/O Type</label>
                    <select class="billing-select" @bind="careOfPrefix">
                        <option value="S/O">S/O</option>
                        <option value="D/O">D/O</option>
                        <option value="W/O">W/O</option>
                        <option value="C/O">C/O</option>
                    </select>
                </div>
                <div class="billing-form-group">
                    <label>Care Of Details</label>
                    <input type="text" class="billing-input" placeholder="Father/Spouse Name..." @bind="careOfName" />
                </div>
            </div>

            <div class="billing-form-group">
                <label>Date of Birth</label>
                <input type="date" class="billing-input" @bind="dobSelected" @bind:after="OnDobChanged" />
            </div>

            <div class="billing-form-group">
                <label>Gender</label>
                <select class="billing-select" @bind="billModel.gender">
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="billing-form-group">
                <label>Age</label>
                <div class="age-grid">
                    <div class="age-input-wrapper">
                        <input type="text" class="billing-input" placeholder="YY" @bind="billModel.ageyears" @bind:after="OnAgeFieldsInput" />
                        <span class="age-unit-label">YY</span>
                    </div>
                    <div class="age-input-wrapper">
                        <input type="text" class="billing-input" placeholder="MM" @bind="billModel.agemonths" @bind:after="OnAgeFieldsInput" />
                        <span class="age-unit-label">MM</span>
                    </div>
                    <div class="age-input-wrapper">
                        <input type="text" class="billing-input" placeholder="DD" @bind="billModel.agedays" @bind:after="OnAgeFieldsInput" />
                        <span class="age-unit-label">DD</span>
                    </div>
                </div>
            </div>

            <div class="billing-form-group">
                <label>Email ID</label>
                <input type="text" class="billing-input" placeholder="patient@example.com" @bind="patientEmail" />
            </div>

            <div class="billing-form-group">
                <label>Address</label>
                <input type="text" class="billing-input" placeholder="17/19, Street Name..." @bind="billModel.address" />
            </div>

            <div class="billing-form-group">
                <label>Area</label>
                <input type="text" class="billing-input" placeholder="Search Area..." @bind="areaSearchQuery" />
            </div>

            <!-- More Info Section -->
            <button type="button" class="more-info-toggle" @onclick="ToggleMoreInfo">
                <span>More Info</span> <i class="bi @(showMoreInfo ? "bi-chevron-up" : "bi-chevron-down")"></i>
            </button>

            @if (showMoreInfo)
            {
                <div class="more-info-box">
                    <div class="billing-form-group">
                        <label>ID Type 1</label>
                        <select class="billing-select">
                            <option>Aadhaar Card</option>
                            <option>PAN Card</option>
                            <option>Driving License</option>
                        </select>
                        <input type="text" class="billing-input mt-1" placeholder="ID Number..." />
                    </div>
                    <div class="billing-form-group">
                        <label>ID Type 2</label>
                        <select class="billing-select">
                            <option>Passport</option>
                            <option>Voter ID</option>
                            <option>Insurance ID</option>
                        </select>
                        <input type="text" class="billing-input mt-1" placeholder="ID Number..." />
                    </div>
                    <div class="billing-form-group">
                        <label>Preferred Language</label>
                        <select class="billing-select">
                            <option>English</option>
                            <option>Hindi</option>
                            <option>Tamil</option>
                            <option>Telugu</option>
                        </select>
                    </div>
                    <div class="billing-form-group">
                        <label>Occupation</label>
                        <input type="text" class="billing-input" placeholder="e.g. Engineer, Teacher, Doctor" />
                    </div>
                    <div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.25rem;">
                        <input type="checkbox" id="vip_patient" @bind="isVipPatient" style="width:16px; height:16px; cursor:pointer;" />
                        <label for="vip_patient" style="font-size:0.75rem; font-weight:700; color:#334155; cursor:pointer; margin:0;">VIP Patient</label>
                    </div>
                </div>
            }
        </div>

        <!-- Middle Column: Referral Details + Test Selection & Grid -->
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            
            <!-- Referral Details -->
            <div class="billing-card">
                <div class="billing-card-header">
                    <span class="card-title-text"><i class="bi bi-people-fill"></i> Referral Details</span>
                </div>
                
                <div class="billing-form-group">
                    <label>Primary Referral (Doctor)</label>
                    <select class="billing-select" @bind="billModel.consultantdcode">
                        <option value="0">-- Direct / Walk-in --</option>
                        @foreach (var doc in doctorsCache)
                        {
                            <option value="@doc.dcode">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</option>
                        }
                    </select>
                </div>

                <div class="billing-form-group">
                    <label>Secondary Referral</label>
                    <input type="text" class="billing-input" placeholder="Enter secondary referral..." />
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem;">
                    <div class="billing-form-group">
                        <label>Room Number</label>
                        <input type="text" class="billing-input" placeholder="e.g. 101" />
                    </div>
                    <div class="billing-form-group">
                        <label>Hospital ID</label>
                        <input type="text" class="billing-input" placeholder="HOSP-123" />
                    </div>
                    <div class="billing-form-group">
                        <label>Hospital Patient ID</label>
                        <input type="text" class="billing-input" placeholder="HPID-456" />
                    </div>
                </div>
            </div>

            <!-- Test Selection & Services -->
            <div class="billing-card test-grid-card">
                <div class="billing-card-header">
                    <span class="card-title-text">
                        <i class="bi bi-journal-plus"></i> Test Selection & Services
                    </span>
                    <span class="test-count-badge">COUNT: @billModel.items.Count</span>
                </div>

                <div class="billing-form-group">
                    <label>Search by Test Name...</label>
                    <div class="autocomplete-search-wrapper">
                        <input type="text" class="billing-input" placeholder="Type test name (e.g. CBC)..." 
                               @bind="testSearchQuery" @bind:event="oninput" @onkeyup="OnTestSearchKeyUp" />
                        @if (showTestDropdown && filteredItems.Count > 0)
                        {
                            <div class="autocomplete-dropdown">
                                @foreach (var item in filteredItems)
                                {
                                    <div class="autocomplete-item" @onclick="() => SelectTestItem(item)">
                                        <span>@item.itemname</span>
                                        <span class="autocomplete-code">₹ @item.salesrate</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div style="border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden; margin-top: 0.5rem; flex: 1;">
                    <table class="charge-table">
                        <thead>
                            <tr>
                                <th class="col-sno-charge">S.No</th>
                                <th class="col-details-charge">Test Details</th>
                                <th class="col-base-charge">Base Amount</th>
                                <th class="col-discount-charge">Discount (₹)</th>
                                <th class="col-total-charge">Total Amt</th>
                                <th class="col-action-charge">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (billModel.items.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" style="text-align:center; padding: 3rem; color: #94a3b8;">
                                        No tests selected. Search and select a test above to add.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in billModel.items)
                                {
                                    <tr>
                                        <td class="col-sno-charge">@row.sno</td>
                                        <td class="col-details-charge">@row.item_name</td>
                                        <td class="col-base-charge">
                                            <input type="number" class="charge-input" @bind="row.unit_rate" @bind:after="() => CalculateRow(row)" />
                                        </td>
                                        <td class="col-discount-charge">
                                            <input type="number" class="charge-input" @bind="row.discount" @bind:after="() => CalculateRow(row)" />
                                        </td>
                                        <td class="col-total-charge">₹ @row.amount.ToString("F2")</td>
                                        <td class="col-action-charge">
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveTestItem(row)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Bottom grid remarks -->
                <div style="display:grid; grid-template-columns: 140px 1fr; gap: 0.75rem; align-items: center; margin-top: 0.5rem;">
                    <div class="billing-form-group">
                        <label>Report Delivery Date</label>
                        <input type="date" class="billing-input" value="@billingDateDisplay" disabled />
                    </div>
                    <div class="billing-form-group">
                        <label>Internal Remarks</label>
                        <input type="text" class="billing-input" placeholder="Add any billing notes..." @bind="billModel.concessionreason" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Collection By, Financial Summary, Payment Box -->
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          

            <!-- Financial Summary -->
            <div class="billing-card">
                <div class="billing-card-header">
                    <span class="card-title-text"><i class="bi bi-calculator"></i> Financial Summary</span>
                </div>

                <div class="concession-row" style="font-size:0.8rem; font-weight:700; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem;">
                    <span>Bill Amount (@billModel.items.Count Tests)</span>
                    <span></span>
                    <span style="text-align:right;">₹ @totalBaseAmount.ToString("F2")</span>
                </div>

                <!-- Concessions Layout -->
                <div class="concession-row">
                    <span class="concession-label">General Concession</span>
                    <div class="concession-input-group">
                        <input type="number" class="charge-input" style="text-align:right;" @bind="billModel.discountper" @bind:after="OnGeneralConcessionPerChanged" />
                        <span>%</span>
                    </div>
                    <div class="concession-input-group">
                        <input type="number" class="charge-input" style="text-align:right;" @bind="billModel.discountamount" @bind:after="OnGeneralConcessionAmtChanged" />
                        <span>VAL</span>
                    </div>
                </div>

                <div class="concession-row">
                    <span class="concession-label">Referral Concession</span>
                    <div class="concession-input-group">
                        <input type="number" class="charge-input" style="text-align:right;" value="0" disabled />
                        <span>%</span>
                    </div>
                    <div class="concession-input-group">
                        <input type="number" class="charge-input" style="text-align:right;" @bind="billModel.specialdiscount" @bind:after="RecalculateTotals" />
                        <span>VAL</span>
                    </div>
                </div>

                <!-- Net Payable -->
                <div class="summary-net-payable">
                    <span class="net-payable-label">Net Payable</span>
                    <span class="net-payable-amount">₹ @netPayable.ToString("F2")</span>
                </div>
            </div>

            <!-- Payment Interface -->
            <div class="payment-interface-card">
                <span class="payment-interface-title"><i class="bi bi-wallet2"></i> Payment Interface</span>
                
                <div class="payment-channel-row">
                    <span>CASH</span>
                    <input type="number" class="payment-channel-input" @bind="billModel.pmc1" @bind:after="RecalculateTotals" />
                </div>
                <div class="payment-channel-row">
                    <span>CARD</span>
                    <input type="number" class="payment-channel-input" @bind="billModel.pmc2" @bind:after="RecalculateTotals" />
                </div>
                <div class="payment-channel-row">
                    <span>GPAY / UPI</span>
                    <input type="number" class="payment-channel-input" @bind="billModel.pmc3" @bind:after="RecalculateTotals" />
                </div>

                <div class="payment-balance-due-row">
                    <span style="font-weight:700;">BALANCE DUE</span>
                    @if (balanceDue <= 0)
                    {
                        <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.25rem;">
                            <span class="balance-due-amount settled">₹ 0.00</span>
                            <span class="fully-settled-badge">Fully Settled</span>
                        </div>
                    }
                    else
                    {
                        <span class="balance-due-amount">₹ @balanceDue.ToString("F2")</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Action Footer Row -->
    <div class="billing-footer">
        <div class="footer-left-actions">
            <div style="display:flex; flex-direction:column; gap:0.25rem;">
                <label style="font-size:0.65rem; font-weight:800; color:#64748b; text-transform:uppercase;">Barcode Printer</label>
                <select class="billing-select" style="height:36px; width: 220px;">
                    <option>ZEBRA-ZT411-PHLE (DEFAULT)</option>
                    <option>EPSON-L3110-COUNTER</option>
                    <option>MOCK-PRINTER-PORTABLE</option>
                </select>
            </div>
            <button type="button" class="btn-billing-footer outline" style="margin-top:auto;" @onclick="MockPrintBarcodes">
                <i class="bi bi-qr-code"></i> Print Barcodes
            </button>
            <button type="button" class="btn-billing-footer outline" style="margin-top:auto;" @onclick="MockPrintSerum">
                <i class="bi bi-droplet-half"></i> Print Serum
            </button>
        </div>

        <div class="footer-right-actions">
            <button type="button" class="btn-billing-footer clear" @onclick="ClearForm">
                <i class="bi bi-arrow-counterclockwise"></i> Clear
            </button>
            <button type="button" class="btn-billing-footer preview" @onclick="MockPreview">
                <i class="bi bi-eye"></i> Preview
            </button>
            <button type="button" class="btn-billing-footer print" @onclick="MockPrintInvoice">
                <i class="bi bi-printer"></i> Print Invoice
            </button>
            <button type="button" class="btn-billing-footer save" @onclick="SaveBillAsync" disabled="@savingInProgress">
                @if (savingInProgress)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                }
                <i class="bi bi-save"></i> Save Bill
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? OpIdStr { get; set; }

    private HmsBillModel billModel = new();
    
    // UI Helpers
    private string billingTimeDisplay = DateTime.Now.ToString("MM/dd/yyyy hh:mm tt");
    private string billingDateDisplay = DateTime.Now.ToString("yyyy-MM-dd");
    private bool isHuman = true;
    private bool showMoreInfo = false;
    private bool isVipPatient = false;
    private bool savingInProgress = false;

    // Prefixes
    private string patientPrefix = "Mr.";
    private string careOfPrefix = "S/O";
    private string careOfName = string.Empty;

    // Extra Patient Meta fields
    private DateOnly? dobSelected = DateOnly.FromDateTime(DateTime.Today.AddYears(-30));
    private string patientEmail = string.Empty;

    // Search and Autocomplete cache lists
    private string patientSearchQuery = string.Empty;
    private bool showPatientDropdown = false;
    private List<OPRegistrationModel.OpRegistrationModel> allRegistrations = new();
    private List<OPRegistrationModel.OpRegistrationModel> filteredRegistrations = new();
    private List<DoctorBookingListModel> bookingsCache = new();

    private string testSearchQuery = string.Empty;
    private bool showTestDropdown = false;
    private List<item_master> allItems = new();
    private List<item_master> filteredItems = new();
    private string areaSearchQuery = string.Empty;

    // Doctors cache
    private List<DoctorMasterModel> doctorsCache = new();

    // Calculations
    private decimal totalBaseAmount = 0;
    private decimal balanceDue = 0;
    private decimal netPayable = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupDataAsync();
        
        if (!string.IsNullOrEmpty(OpIdStr) && Guid.TryParse(OpIdStr, out var opId))
        {
            await LoadExistingBillOrRegistrationAsync(opId);
        }
        else
        {
            ClearForm();
        }
    }

    private async Task LoadLookupDataAsync()
    {
        try
        {
            doctorsCache = await DoctorService.GetDoctorsAsync() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctors: {ex.Message}");
            doctorsCache ??= new();
        }

        try
        {
            allRegistrations = await AppointmentBookingService.GetAllOpRegistrationsAsync() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading registrations: {ex.Message}");
            allRegistrations ??= new();
        }

        try
        {
            allItems = await CaseSheetService.GetAllItemsAsync() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading items: {ex.Message}");
            allItems ??= new();
        }

        try
        {
            if (doctorsCache != null)
            {
                // Cache doctor bookings to pull patient names easily by custid
                foreach (var doc in doctorsCache)
                {
                    try
                    {
                        var bookList = await AppointmentBookingService.GetDoctorBookingsAsync(doc.dcode, DateOnly.FromDateTime(DateTime.Today));
                        if (bookList != null)
                        {
                            bookingsCache.AddRange(bookList);
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error loading bookings for doctor {doc.dcode}: {ex.Message}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error caching doctor bookings: {ex.Message}");
        }

        EnsurePredefinedData();
    }

    private void EnsurePredefinedData()
    {
        var predefinedPatients = new List<(decimal CustId, string Name, string Mobile, string OpNo, string OpId)>
        {
            (1001, "Ankit Sharma", "9876543210", "OP-1001", "e74e6f9d-5a82-4148-8dfa-97c9b0e25287"),
            (1002, "Priya Patel", "8765432109", "OP-1002", "f74e6f9d-5a82-4148-8dfa-97c9b0e25288"),
            (1003, "John Doe", "7654321098", "OP-1003", "074e6f9d-5a82-4148-8dfa-97c9b0e25289"),
            (1004, "Sarah Connor", "6543210987", "OP-1004", "174e6f9d-5a82-4148-8dfa-97c9b0e25290"),
            (1005, "Rajesh Kumar", "9988776655", "OP-1005", "274e6f9d-5a82-4148-8dfa-97c9b0e25291")
        };

        if (allRegistrations == null) allRegistrations = new();
        if (bookingsCache == null) bookingsCache = new();
        if (doctorsCache == null) doctorsCache = new();
        if (allItems == null) allItems = new();

        foreach (var p in predefinedPatients)
        {
            if (!allRegistrations.Any(r => r.custid == p.CustId))
            {
                allRegistrations.Add(new OPRegistrationModel.OpRegistrationModel
                {
                    op_id = Guid.Parse(p.OpId),
                    op_no = p.OpNo,
                    custid = p.CustId,
                    visit_date = DateOnly.FromDateTime(DateTime.Today),
                    visit_status = "WAITING",
                    dcode = doctorsCache.FirstOrDefault()?.dcode ?? 1
                });
            }

            if (!bookingsCache.Any(b => b.custid == p.CustId))
            {
                bookingsCache.Add(new DoctorBookingListModel
                {
                    custid = p.CustId,
                    patient_name = p.Name,
                    notes = p.Mobile,
                    booking_status = "CONFIRMED",
                    appointment_date = DateOnly.FromDateTime(DateTime.Today),
                    dcode = doctorsCache.FirstOrDefault()?.dcode ?? 1
                });
            }
        }

        var predefinedTests = new List<item_master>
        {
            new item_master { itemcode = 201, itemname = "Complete Blood Count (CBC)", shortname = "CBC", description = "CBC Test", itemtype = "TEST", salesrate = 350, gstpercentage = 12, isactive = true, tenantcode = "TEN1011" },
