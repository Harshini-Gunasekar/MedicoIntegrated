    private async Task OnPatientSearchKeyUp(KeyboardEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(patientSearchQuery))
        {
            searchedPatients.Clear();
            showPatientDropdown = false;
            StateHasChanged();
            return;
        }

        try
        {
            using var client = CreateClient(true); // LabCareUrl
            var response = await client.GetAsync($"api/Customer/partition?pagenumber=1&pagesize=50&key={Uri.EscapeDataString(patientSearchQuery)}");
            var rawJson = await response.Content.ReadAsStringAsync();
            
            try
            {
                var logDir = @"d:\Iscan\Medico\scratch";
                if (!Directory.Exists(logDir)) Directory.CreateDirectory(logDir);
                var logPath = Path.Combine(logDir, "billing_search_log.txt");
                File.WriteAllText(logPath, $"Query: {patientSearchQuery}\nStatus: {response.StatusCode}\nJSON: {rawJson}\n");
            }
            catch {}

            if (response.IsSuccessStatusCode)
            {
                var settings = new Newtonsoft.Json.JsonSerializerSettings 
                { 
                    NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore 
                };
                var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.CustomerWithOpModel>>(rawJson, settings) ?? new();
                
                // Fallback local filtering in case partition API doesn't filter server-side
                var lowerQuery = patientSearchQuery.ToLower();
                var filtered = list.Where(p => 
                    (p.name != null && p.name.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (p.namewithinitials != null && p.namewithinitials.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (p.mobile != null && p.mobile.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase)) ||
                    p.custid.ToString().Contains(lowerQuery)
                ).ToList();

                searchedPatients = filtered.Any() ? filtered.Take(10).ToList() : list.Take(10).ToList();

                try { File.AppendAllText(@"d:\Iscan\Medico\scratch\billing_search_log.txt", $"Parsed Count: {searchedPatients.Count}\n"); } catch {}
                showPatientDropdown = searchedPatients.Count > 0;
            }
            else
            {
                Console.Error.WriteLine($"Error searching patients: {response.StatusCode} - {rawJson}");
                searchedPatients.Clear();
                showPatientDropdown = false;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error searching patients: {ex.Message}");
            searchedPatients.Clear();
            showPatientDropdown = false;
        }

        StateHasChanged();
    }

