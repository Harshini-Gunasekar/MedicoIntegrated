    // --- Actions ---
    private async Task SaveBillAsync()
    {
        if (string.IsNullOrWhiteSpace(billModel.patient_name))
        {
            ToastService.ShowError("Please enter Patient Name.");
            return;
        }
        if (billModel.items.Count == 0)
        {
            ToastService.ShowError("Please add at least one test to the billing grid.");
            return;
        }

        savingInProgress = true;
        try
        {
            string result;
            if (!string.IsNullOrEmpty(billModel.requestguid))
            {
                result = await HmsBillingService.UpdateBillAsync(billModel);
            }
            else
            {
                // Ensure requestguid is passed as null for saving as requested
                billModel.requestguid = null;
                result = await HmsBillingService.SaveBillAsync(billModel);
            }
            if (!string.IsNullOrEmpty(result) && !result.Contains("Error", StringComparison.OrdinalIgnoreCase))
            {
                ToastService.ShowSuccess("Bill Saved and Posted Successfully!");
                
                // If it was loaded from outpatient flow, update the status to COMPLETED
                if (!string.IsNullOrEmpty(billModel.op_id) && Guid.TryParse(billModel.op_id, out var opId))
                {
                    await AppointmentBookingService.UpdateOpStatusAsync(opId, "COMPLETED");
                }
                
                // Stay on page but refresh serial
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError($"Failed to save bill. API error: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Exception while saving bill: {ex.Message}");
        }
        finally
        {
            savingInProgress = false;
        }
    }

