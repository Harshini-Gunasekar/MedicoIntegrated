    private async Task LoadLookupDataAsync()
    {
        await LoadBranchesAsync();
        await LoadCountersAsync();

        try
        {
            doctorsCache = await DoctorService.GetDoctorsAsync() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctors: {ex.Message}");
            doctorsCache ??= new();
        }

        await LoadPaymodesAsync();

        try
        {
            allRegistrations = await AppointmentBookingService.GetAllOpRegistrationsAsync() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading registrations: {ex.Message}");
            allRegistrations ??= new();
        }

        try
        {
            activeAdmissions = await IpRegistrationService.GetActiveAdmissionsAsync() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading active admissions: {ex.Message}");
            activeAdmissions ??= new();
        }

        try
        {
            allItems = await CaseSheetService.GetAllItemsAsync() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading items: {ex.Message}");
            allItems ??= new();
        }

        // test_master loaded separately after session is ready (see LoadTestMastersAsync)

        try
        {
            if (doctorsCache != null)
            {
                // Cache doctor bookings to pull patient names easily by custid
                foreach (var doc in doctorsCache)
                {
                    try
                    {
                        var bookList = await AppointmentBookingService.GetDoctorBookingsAsync(doc.dcode, DateOnly.FromDateTime(DateTime.Today));
                        if (bookList != null)
                        {
                            bookingsCache.AddRange(bookList);
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error loading bookings for doctor {doc.dcode}: {ex.Message}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error caching doctor bookings: {ex.Message}");
        }

        EnsurePredefinedData();
    }

    private void EnsurePredefinedData()
    {
        if (allRegistrations == null) allRegistrations = new();
        if (bookingsCache == null) bookingsCache = new();
        if (doctorsCache == null) doctorsCache = new();
        if (allItems == null) allItems = new();
    }

    private async Task<SharedComponents.Rcl.Models.CustomerModel?> FetchCustomerByIdAsync(decimal custId)
    {
        if (custId <= 0) return null;

        var cached = allCustomersCache.FirstOrDefault(c => c.custid == (long)custId);
        if (cached != null && !string.IsNullOrWhiteSpace(cached.name))
        {
            return cached;
        }

        try
        {
            using var client = CreateClient(true);
            var response = await client.GetAsync($"api/Customer/get?custid={custId}");
            if (response.IsSuccessStatusCode)
            {
                var rawJson = await response.Content.ReadAsStringAsync();
                var cust = Newtonsoft.Json.JsonConvert.DeserializeObject<SharedComponents.Rcl.Models.CustomerModel>(rawJson);
                if (cust != null && cust.custid == (long)custId && !string.IsNullOrWhiteSpace(cust.name))
                {
                    if (!allCustomersCache.Any(c => c.custid == cust.custid))
                    {
                        allCustomersCache.Add(cust);
                    }
                    return cust;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FetchCustomerByIdAsync] Error getting customer {custId}: {ex.Message}");
        }

        try
        {
            using var client = CreateClient(true);
            var response = await client.GetAsync($"api/Customer/search?key={custId}");
            if (response.IsSuccessStatusCode)
            {
                var rawJson = await response.Content.ReadAsStringAsync();
                var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<SharedComponents.Rcl.Models.CustomerModel>>(rawJson);
                var match = list?.FirstOrDefault(c => c.custid == (long)custId);
                if (match != null)
                {
                    if (!allCustomersCache.Any(c => c.custid == match.custid))
                    {
                        allCustomersCache.Add(match);
                    }
                    return match;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FetchCustomerByIdAsync] Error searching customer {custId}: {ex.Message}");
        }

        return null;
    }

    private async Task LoadExistingBillOrRegistrationAsync(string opIdStr, bool clearFormFirst = false)
    {
        if (string.IsNullOrWhiteSpace(opIdStr)) return;

        try
        {
            if (clearFormFirst)
            {
                ClearForm();
            }
            _loadedOpIdStr = opIdStr;

            Guid opId = Guid.Empty;
            Guid.TryParse(opIdStr, out opId);

            // First find expected registration record to get expected custid & op_id
            var reg = allRegistrations.FirstOrDefault(r => 
                (opId != Guid.Empty && (r.op_id == opId || r.booking_id == opId)) ||
                (!string.IsNullOrEmpty(r.op_no) && string.Equals(r.op_no.Trim(), opIdStr.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                (r.custid.ToString() == opIdStr.Trim())
            );

            if (reg == null)
            {
                var allRegs = await AppointmentBookingService.GetAllOpRegistrationsAsync();
                if (allRegs != null)
                {
                    allRegistrations = allRegs;
                    reg = allRegistrations.FirstOrDefault(r => 
                        (opId != Guid.Empty && (r.op_id == opId || r.booking_id == opId)) ||
                        (!string.IsNullOrEmpty(r.op_no) && string.Equals(r.op_no.Trim(), opIdStr.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                        (r.custid.ToString() == opIdStr.Trim())
                    );
                }
            }

            // 0. Try to load as a direct edit (requestguid)
            var billResp = await HmsBillingService.GetBillByGuidAsync(opIdStr);
            if (billResp != null && !string.IsNullOrEmpty(billResp.requestguid))
            {
                bool isDirectMatch = string.Equals(billResp.requestguid, opIdStr, StringComparison.OrdinalIgnoreCase);
                bool isOpIdMatch = !string.IsNullOrEmpty(billResp.op_id) && (
                    string.Equals(billResp.op_id, opIdStr, StringComparison.OrdinalIgnoreCase) ||
                    (reg != null && string.Equals(billResp.op_id, reg.op_id.ToString(), StringComparison.OrdinalIgnoreCase))
                );
                bool isIpIdMatch = billResp.ip_id.HasValue && (
                    (opId != Guid.Empty && billResp.ip_id.Value == opId) ||
                    string.Equals(billResp.ip_id.Value.ToString(), opIdStr, StringComparison.OrdinalIgnoreCase)
                );
                bool isOpVisitIdMatch = !string.IsNullOrEmpty(billResp.opvisitid) && string.Equals(billResp.opvisitid.Trim(), opIdStr.Trim(), StringComparison.OrdinalIgnoreCase);
                bool isCustIdMatch = (reg != null && billResp.custid.HasValue && billResp.custid.Value == reg.custid) ||
                                     (billResp.custid.HasValue && billResp.custid.Value.ToString() == opIdStr.Trim());

                if (isDirectMatch || isOpIdMatch || isIpIdMatch || isOpVisitIdMatch || isCustIdMatch)
                {
                    int resolvedDcode = billResp.dcode ?? 0;
                    if (resolvedDcode == 0 && !string.IsNullOrWhiteSpace(billResp.doctor_name))
                    {
                        var cleanName = billResp.doctor_name.Replace("Dr.", "", StringComparison.OrdinalIgnoreCase).Trim();
                        var matchedDoc = doctorsCache.FirstOrDefault(d => 
                            (d.name != null && d.name.Contains(cleanName, StringComparison.OrdinalIgnoreCase)) ||
                            (d.doctorfullname != null && d.doctorfullname.Contains(cleanName, StringComparison.OrdinalIgnoreCase))
                        );
                        if (matchedDoc != null)
                        {
                            resolvedDcode = matchedDoc.dcode;
                        }
                    }

                    string patName = billResp.patient_name;
                    if (string.IsNullOrWhiteSpace(patName) || patName.StartsWith("Patient ID", StringComparison.OrdinalIgnoreCase))
                    {
                        var custMatch = await FetchCustomerByIdAsync(billResp.custid ?? 0);
                        if (custMatch != null)
                        {
                            var resolved = string.IsNullOrEmpty(custMatch.namewithinitials) ? custMatch.name : custMatch.namewithinitials;
                            if (!string.IsNullOrWhiteSpace(resolved)) patName = resolved;
                        }
                    }

                    billModel = new HmsBillModel
                    {
                        requestguid = billResp.requestguid,
                        op_id = billResp.op_id, 
                        ip_id = billResp.ip_id,
                        custid = billResp.custid ?? (reg != null ? (long)reg.custid : 0),
                        patient_name = patName,
                        mobileno = billResp.mobileno,
                        gender = billResp.gender,
                        dateofbirth = billResp.dateofbirth,
                        ageyears = billResp.ageyears,
                        dcode = resolvedDcode,
                        consultantdcode = resolvedDcode,
                        enteredbhcode = billResp.enteredbhcode ?? 1,
                        cntcode = billResp.cntcode ?? (billModel.cntcode > 0 ? billModel.cntcode : 1),
                        paidamount = (decimal)(billResp.paid_amount ?? 0),
                        discountper = (decimal)(billResp.general_concession_per ?? 0),
                        discountamount = (decimal)(billResp.general_concession_amount ?? 0),
                        ourdispercentage = (decimal)(billResp.referral_concession_per ?? 0),
                        ourdiscount = (decimal)(billResp.referral_concession_amount ?? 0),
                        specialdiscount = (decimal)(billResp.referral_concession_amount ?? 0),
                        pmc1 = billResp.pmc1,
                        pmc2 = billResp.pmc2,
                        pmc3 = billResp.pmc3,
                        pmc1_amount = billResp.pmc1_amount,
                        pmc2_amount = billResp.pmc2_amount,
                        pmc3_amount = billResp.pmc3_amount,
                        collection_type = billResp.pay_mode ?? "CASH",
                        items = billResp.items?.Select(i => new HmsBillItemModel
                        {
                            item_name = i.item_name,
                            tcode = i.tcode ?? 0,
                            unit_rate = (decimal)(i.unit_rate ?? 0),
                            qty = (decimal)(i.qty ?? 1),
                            amount = (decimal)(i.amount ?? 0),
                            discount = (decimal)(i.discount ?? 0),
                            charge_type = i.charge_type ?? "INVESTIGATION",
                            requestdetailsid = i.requestdetailsid,
                            item_ref_id = i.item_ref_id
                        }).ToList() ?? new List<HmsBillItemModel>()
                    };

                    showPaymode2 = (billModel.pmc2 != null || (billModel.pmc2_amount ?? 0) > 0);
                    showPaymode3 = (billModel.pmc3 != null || (billModel.pmc3_amount ?? 0) > 0);

                    selectedOpNo = billModel.op_id;
                    if (!string.IsNullOrEmpty(billModel.op_id) && Guid.TryParse(billModel.op_id, out var opIdGuid))
                    {
                        var regMatch = allRegistrations.FirstOrDefault(r => r.op_id == opIdGuid || r.booking_id == opIdGuid);
                        if (regMatch != null)
                        {
                            selectedOpNo = regMatch.op_no;
                        }
                    }

                    selectedIpNo = "-";
                    if (billModel.ip_id != null)
                    {
                        var activeIp = activeAdmissions.FirstOrDefault(a => a.ip_id == billModel.ip_id.Value);
                        if (activeIp != null)
                        {
                            selectedIpNo = activeIp.ip_no;
                        }
                        else
                        {
                            var ipReg = await IpRegistrationService.GetIpRegistrationByIdAsync(billModel.ip_id.Value);
                            if (ipReg != null)
                            {
                                selectedIpNo = ipReg.ip_no;
                            }
                        }
                    }

                    if (billModel.patient_name != null)
                    {
                        var spaceIndex = billModel.patient_name.IndexOf(' ');
                        if (spaceIndex > 0)
                        {
                            var potentialPrefix = billModel.patient_name.Substring(0, spaceIndex);
                            if (potentialPrefix == "Mr." || potentialPrefix == "Ms." || potentialPrefix == "Mrs." || potentialPrefix == "Dr.")
                            {
                                patientPrefix = potentialPrefix;
                            }
                        }
                    }

                    if (!string.IsNullOrEmpty(billModel.dateofbirth) && DateOnly.TryParse(billModel.dateofbirth, out var parsedDob))
                    {
                        dobSelected = parsedDob;
                    }

                    patientSearchQuery = string.IsNullOrWhiteSpace(billModel.patient_name) 
                        ? $"CUST-{billModel.custid}" 
                        : $"{billModel.patient_name} (CUST-{billModel.custid})";
                    selectedPatientBadgeVisible = true;
                    showPatientDropdown = false;

                    for(int i = 0; i < billModel.items.Count; i++) billModel.items[i].sno = i + 1;

                    RecalculateTotals();
                    ToastService.ShowSuccess("Loaded bill for editing.");
                    if (billModel.custid > 0)
                    {
                        await CheckPatientAdvanceAsync((decimal)billModel.custid);
                    }
                    await LoadUnbilledChargesAsync();
                    return;
                }
            }

            // 1. Try to load an existing bill by OpId
            if (opId != Guid.Empty)
            {
                var existingBill = await HmsBillingService.GetBillAsync(opId);
                if (existingBill != null)
                {
                    bool isOpIdMatch = !string.IsNullOrEmpty(existingBill.op_id) && (
                        string.Equals(existingBill.op_id, opIdStr, StringComparison.OrdinalIgnoreCase) ||
                        (reg != null && string.Equals(existingBill.op_id, reg.op_id.ToString(), StringComparison.OrdinalIgnoreCase))
                    );
                    bool isCustIdMatch = reg != null && existingBill.custid == reg.custid;

                    if (isOpIdMatch || isCustIdMatch)
                    {
                        billModel = existingBill;
                        if (string.IsNullOrWhiteSpace(billModel.patient_name) || billModel.patient_name.StartsWith("Patient ID", StringComparison.OrdinalIgnoreCase))
                        {
                            var custMatch = await FetchCustomerByIdAsync(billModel.custid);
                            if (custMatch != null)
                            {
                                var resolved = string.IsNullOrEmpty(custMatch.namewithinitials) ? custMatch.name : custMatch.namewithinitials;
                                if (!string.IsNullOrWhiteSpace(resolved)) billModel.patient_name = resolved;
                            }
                        }

                        var regMatch = allRegistrations.FirstOrDefault(r => r.op_id == opId || r.booking_id == opId);
                        selectedOpNo = regMatch?.op_no ?? billModel.op_id;

                        selectedIpNo = "-";
                        if (billModel.ip_id != null)
                        {
                            var activeIp = activeAdmissions.FirstOrDefault(a => a.ip_id == billModel.ip_id.Value);
                            if (activeIp != null)
                            {
                                selectedIpNo = activeIp.ip_no;
                            }
                            else
                            {
                                var ipReg = await IpRegistrationService.GetIpRegistrationByIdAsync(billModel.ip_id.Value);
                                if (ipReg != null)
                                {
                                    selectedIpNo = ipReg.ip_no;
                                }
                            }
                        }
                        
                        if (billModel.patient_name != null)
                        {
                            var spaceIndex = billModel.patient_name.IndexOf(' ');
                            if (spaceIndex > 0)
                            {
                                var potentialPrefix = billModel.patient_name.Substring(0, spaceIndex);
                                if (potentialPrefix == "Mr." || potentialPrefix == "Ms." || potentialPrefix == "Mrs." || potentialPrefix == "Dr.")
                                {
                                    patientPrefix = potentialPrefix;
                                }
                            }
                        }

                        if (!string.IsNullOrEmpty(billModel.dateofbirth) && DateOnly.TryParse(billModel.dateofbirth, out var parsedDob))
                        {
                            dobSelected = parsedDob;
                        }

                        patientSearchQuery = string.IsNullOrWhiteSpace(billModel.patient_name) 
                            ? $"CUST-{billModel.custid}" 
                            : $"{billModel.patient_name} (CUST-{billModel.custid})";
                        selectedPatientBadgeVisible = true;
                        showPatientDropdown = false;

                        totalBaseAmount = 0;
                        foreach (var item in billModel.items)
                        {
                            totalBaseAmount += item.amount;
                        }

                        if (billModel.ourdispercentage == 0 && billModel.ourdiscount > 0 && totalBaseAmount > 0)
                        {
                            billModel.ourdispercentage = Math.Round((billModel.ourdiscount / totalBaseAmount) * 100m, 2);
                        }
                        else if (billModel.ourdispercentage == 0 && billModel.specialdiscount > 0 && totalBaseAmount > 0)
                        {
                            billModel.ourdispercentage = Math.Round((billModel.specialdiscount / totalBaseAmount) * 100m, 2);
                            billModel.ourdiscount = billModel.specialdiscount;
                        }

                        RecalculateTotals();
                        ToastService.ShowSuccess("Loaded existing bill.");
                        if (billModel.custid > 0)
                        {
                            await CheckPatientAdvanceAsync((decimal)billModel.custid);
                        }
                        await LoadUnbilledChargesAsync();
                        return;
                    }
                }
            }

            // 2. If no matching bill exists yet, pull the patient OP registration details to prefill the invoice
            if (reg != null)
            {
                string patientName = !string.IsNullOrWhiteSpace(reg.patient_name) ? reg.patient_name : "";
                string mobile = !string.IsNullOrWhiteSpace(reg.mobile) ? reg.mobile : reg.notes ?? reg.op_no;

                if (string.IsNullOrEmpty(patientName) || patientName.StartsWith("Patient ID", StringComparison.OrdinalIgnoreCase))
                {
                    var bk = bookingsCache.FirstOrDefault(b => b.custid == reg.custid);
                    if (bk != null && !string.IsNullOrWhiteSpace(bk.patient_name) && !bk.patient_name.StartsWith("Patient ID", StringComparison.OrdinalIgnoreCase))
                    {
                        patientName = bk.patient_name;
                        if (!string.IsNullOrWhiteSpace(bk.notes)) mobile = bk.notes;
                    }
                }

                if (string.IsNullOrEmpty(patientName) || patientName.StartsWith("Patient ID", StringComparison.OrdinalIgnoreCase))
                {
                    var bookingsOnDay = await AppointmentBookingService.GetDoctorBookingsAsync(reg.dcode, reg.visit_date);
                    var match = bookingsOnDay?.FirstOrDefault(b => b.custid == reg.custid);
                    if (match != null && !string.IsNullOrWhiteSpace(match.patient_name) && !match.patient_name.StartsWith("Patient ID", StringComparison.OrdinalIgnoreCase))
                    {
                        patientName = match.patient_name;
                        if (!string.IsNullOrWhiteSpace(match.notes)) mobile = match.notes;
                    }
                }

                var custMatch = await FetchCustomerByIdAsync(reg.custid);
                if (custMatch != null)
                {
                    var resolvedName = string.IsNullOrEmpty(custMatch.namewithinitials) ? custMatch.name : custMatch.namewithinitials;
                    if (!string.IsNullOrWhiteSpace(resolvedName))
                    {
                        patientName = resolvedName;
                    }
                    if (!string.IsNullOrWhiteSpace(custMatch.mobile))
                    {
                        mobile = custMatch.mobile;
                    }
                    if (!string.IsNullOrWhiteSpace(custMatch.gender))
                    {
                        billModel.gender = custMatch.gender;
                    }
                    billModel.ageyears = custMatch.ageyears.ToString();
                    billModel.agemonths = custMatch.agemonths.ToString();
                    billModel.agedays = custMatch.agedays.ToString();
                    if (custMatch.dateofbirth.HasValue)
                    {
                        billModel.dateofbirth = custMatch.dateofbirth.Value.ToString("yyyy-MM-dd");
                        dobSelected = DateOnly.FromDateTime(custMatch.dateofbirth.Value);
                    }
                }

                if (string.IsNullOrEmpty(patientName))
                {
                    patientName = $"Patient ID {reg.custid}";
                }

                if (string.IsNullOrEmpty(mobile) || mobile == reg.op_no)
                {
                    if (!string.IsNullOrEmpty(billModel.mobileno) && billModel.mobileno != "-")
                    {
                        mobile = billModel.mobileno;
                    }
                }

                SelectPatient(reg, patientName, mobile, false);
                
                billModel.op_id = reg.op_id.ToString();
                billModel.dcode = reg.dcode;
                billModel.consultantdcode = reg.dcode;

                patientSearchQuery = $"{patientName} (CUST-{reg.custid})";
                selectedPatientBadgeVisible = true;
                showPatientDropdown = false;
            }
            else
            {
                var ipMatch = activeAdmissions.FirstOrDefault(a => 
                    (opId != Guid.Empty && a.ip_id == opId) ||
                    (!string.IsNullOrEmpty(a.ip_no) && string.Equals(a.ip_no.Trim(), opIdStr.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                    (a.custid.ToString() == opIdStr.Trim())
                );
                if (ipMatch == null && opId != Guid.Empty)
                {
                    try
                    {
                        ipMatch = await IpRegistrationService.GetIpRegistrationByIdAsync(opId);
                    }
                    catch { }
                }
                if (ipMatch == null)
                {
                    try
                    {
                        var allIps = await IpRegistrationService.GetIpRegistrationsAsync("");
                        if (allIps != null)
                        {
                            ipMatch = allIps.FirstOrDefault(a =>
                                (opId != Guid.Empty && a.ip_id == opId) ||
                                (!string.IsNullOrEmpty(a.ip_no) && string.Equals(a.ip_no.Trim(), opIdStr.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                                (a.custid.ToString() == opIdStr.Trim())
                            );
                        }
                    }
                    catch { }
                }

                if (ipMatch != null)
                {
                    billModel.ip_id = ipMatch.ip_id;
                    billModel.op_id = null;
                    selectedIpNo = !string.IsNullOrWhiteSpace(ipMatch.ip_no) ? ipMatch.ip_no : "-";
                    selectedOpNo = "-";
                    billModel.custid = (long)ipMatch.custid;
                    billModel.dcode = ipMatch.dcode;
                    billModel.consultantdcode = ipMatch.dcode;
                    billModel.patient_name = ipMatch.patient_name;
                    billModel.mobileno = ipMatch.mobile;

                    var custMatch = await FetchCustomerByIdAsync(ipMatch.custid);
                    if (custMatch != null)
                    {
                        var resolvedName = string.IsNullOrEmpty(custMatch.namewithinitials) ? custMatch.name : custMatch.namewithinitials;
                        if (!string.IsNullOrWhiteSpace(resolvedName))
                        {
                            billModel.patient_name = resolvedName;
                        }
                        if (!string.IsNullOrWhiteSpace(custMatch.mobile))
                        {
                            billModel.mobileno = custMatch.mobile;
                        }
                        if (!string.IsNullOrWhiteSpace(custMatch.gender))
                        {
                            billModel.gender = custMatch.gender;
                        }
                        billModel.ageyears = custMatch.ageyears.ToString();
                        billModel.agemonths = custMatch.agemonths.ToString();
                        billModel.agedays = custMatch.agedays.ToString();
                        if (custMatch.dateofbirth.HasValue)
                        {
                            billModel.dateofbirth = custMatch.dateofbirth.Value.ToString("yyyy-MM-dd");
                            dobSelected = DateOnly.FromDateTime(custMatch.dateofbirth.Value);
                        }
                        if (custMatch.ftcode.HasValue && custMatch.ftcode.Value > 0)
                        {
                            billModel.ftcode = custMatch.ftcode.Value;
                        }
                    }

                    patientSearchQuery = string.IsNullOrWhiteSpace(billModel.patient_name)
                        ? $"CUST-{ipMatch.custid}"
                        : $"{billModel.patient_name} (CUST-{ipMatch.custid})";
                    selectedPatientBadgeVisible = true;
                    showPatientDropdown = false;
                }
            }
            if (billModel.custid > 0)
            {
                await CheckPatientAdvanceAsync((decimal)billModel.custid);
            }
            await LoadUnbilledChargesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading existing bill or registration: {ex.Message}");
        }
    }

    private async Task OpenUnbilledModal()
    {
        await LoadUnbilledChargesAsync();
        showUnbilledModal = true;
    }

    private async Task LoadUnbilledChargesAsync()
    {
        unbilledCharges.Clear();
        if (string.IsNullOrEmpty(billModel.op_id) && billModel.ip_id == null && billModel.custid <= 0)
        {
            return;
        }

        loadingUnbilled = true;
        try
        {
            // 1. Hit api/UnbilledCharges/ip-room-rent-summary BEFORE by-visit to generate/calculate room rent entries
            if (billModel.ip_id != null && billModel.ip_id != Guid.Empty)
            {
                try { await HmsBillingService.GetIpRoomRentSummaryAsync(billModel.ip_id.Value); } catch { }
            }

            // 2. Fetch visit-specific unbilled charges
            List<UnbilledChargeSummary> visitCharges = new();
            if (!string.IsNullOrEmpty(billModel.op_id) || billModel.ip_id != null)
            {
                try
                {
                    visitCharges = await HmsBillingService.GetUnbilledChargesByVisitAsync(billModel.op_id, billModel.ip_id) ?? new();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error fetching visit charges: {ex.Message}");
                }
            }

            // 3. Fetch ALL unbilled charges across system to bring all unbilled charges for this patient
            List<UnbilledChargeSummary> allUnbilledList = new();
            try
            {
                allUnbilledList = await HmsBillingService.GetAllUnbilledChargesAsync() ?? new();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error fetching all unbilled charges: {ex.Message}");
            }

            // 4. Gather all OP / Visit IDs associated with this patient
            var patientOpIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            if (!string.IsNullOrEmpty(billModel.op_id)) patientOpIds.Add(billModel.op_id.Trim());
            if (!string.IsNullOrEmpty(selectedOpNo) && selectedOpNo != "-") patientOpIds.Add(selectedOpNo.Trim());
            
            if (billModel.custid > 0 && allRegistrations != null)
            {
                foreach (var reg in allRegistrations.Where(r => r.custid == billModel.custid))
                {
                    if (reg.op_id != Guid.Empty) patientOpIds.Add(reg.op_id.ToString());
                    if (!string.IsNullOrEmpty(reg.op_no)) patientOpIds.Add(reg.op_no.Trim());
                    if (reg.booking_id != Guid.Empty) patientOpIds.Add(reg.booking_id.ToString());
                }
            }

            // Filter allUnbilledList for charges belonging to this patient
            var matchedPatientCharges = allUnbilledList.Where(uc => {
                if (uc.billedstatus == true) return false;
                
                // Match by patient CustId
                if (billModel.custid > 0 && uc.custid.HasValue && uc.custid.Value == billModel.custid)
                    return true;

                // Match by IP ID
                if (billModel.ip_id.HasValue && billModel.ip_id.Value != Guid.Empty && uc.ip_id == billModel.ip_id)
                    return true;

                // Match by OP Visit ID / OP Number
                if (!string.IsNullOrEmpty(uc.opvisitid) && patientOpIds.Contains(uc.opvisitid.Trim()))
                    return true;

                return false;
            }).ToList();

            // Merge visitCharges and matchedPatientCharges deduplicating by unbilledid (and entryid)
            var mergedMap = new Dictionary<string, UnbilledChargeSummary>(StringComparer.OrdinalIgnoreCase);
            
            foreach (var uc in visitCharges)
            {
                if (uc.billedstatus == true) continue;
                var key = !string.IsNullOrWhiteSpace(uc.unbilledid) ? uc.unbilledid.Trim() : (!string.IsNullOrWhiteSpace(uc.entryid) ? uc.entryid.Trim() : Guid.NewGuid().ToString());
                mergedMap[key] = uc;
            }

            foreach (var uc in matchedPatientCharges)
            {
                var key = !string.IsNullOrWhiteSpace(uc.unbilledid) ? uc.unbilledid.Trim() : (!string.IsNullOrWhiteSpace(uc.entryid) ? uc.entryid.Trim() : Guid.NewGuid().ToString());
                if (!mergedMap.ContainsKey(key))
                {
                    mergedMap[key] = uc;
                }
            }

            var mergedCharges = mergedMap.Values.ToList();

            // Write debug info to trace matching
            try
            {
                var logLines = new List<string>
                {
                    $"=== LoadUnbilledChargesAsync at {DateTime.Now} for CustId={billModel.custid}, OpId={billModel.op_id} ===",
                    $"Grid items count: {billModel.items.Count}"
                };
                foreach (var item in billModel.items)
                {
                    logLines.Add($"  Grid Item: Name={item.item_name}, requestdetailsid='{item.requestdetailsid}', ref_id='{item.item_ref_id}'");
                }
                logLines.Add($"Merged unbilled charges count: {mergedCharges.Count}");
                foreach (var uc in mergedCharges)
                {
                    logLines.Add($"  Unbilled Charge: Name={GetUnbilledChargeName(uc)}, Type={uc.entrytype}, unbilledid='{uc.unbilledid}', entryid='{uc.entryid}', custid='{uc.custid}', opvisitid='{uc.opvisitid}', rate={uc.rate}, amount={uc.amount}");
                }
                logLines.Add("===============================================\n");
                System.IO.File.AppendAllLines(@"d:\Iscan\Medico\unbilled_debug.txt", logLines);
            }
            catch { }

            // Filter out charges that are already added to the billing grid (casing-independent matching by unbilledid OR stable entryid/item_ref_id)
            unbilledCharges = mergedCharges.Where(uc => 
                !billModel.items.Any(i => 
                    (!string.IsNullOrEmpty(i.requestdetailsid) && !string.IsNullOrEmpty(uc.unbilledid) && string.Equals(i.requestdetailsid.Trim(), uc.unbilledid.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(i.item_ref_id) && !string.IsNullOrEmpty(uc.entryid) && string.Equals(i.item_ref_id.Trim(), uc.entryid.Trim(), StringComparison.OrdinalIgnoreCase))
                )
            ).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading unbilled charges: {ex.Message}");
        }
        finally
        {
            loadingUnbilled = false;
        }
    }

    private string GetUnbilledChargeName(UnbilledChargeSummary uc)
    {
        string displayItemName = !string.IsNullOrWhiteSpace(uc.particulars) ? uc.particulars : uc.item_name;
        if (string.IsNullOrWhiteSpace(displayItemName))
        {
            if (uc.tcode.HasValue && allTestMasters.Any())
            {
                var tmMatch = allTestMasters.FirstOrDefault(t => t.tcode == uc.tcode.Value);
                if (tmMatch != null && !string.IsNullOrWhiteSpace(tmMatch.name))
                {
                    return tmMatch.name;
                }
            }
            
            if (string.Equals(uc.entrytype, "CONSULTATION", StringComparison.OrdinalIgnoreCase))
                return "Consultation Charge";

            if (string.Equals(uc.entrytype, "ROOMRENT", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(uc.entrytype, "ROOM RENT", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(uc.entrytype, "ROOM_RENT", StringComparison.OrdinalIgnoreCase))
                return "Room Rent Charge";

            if (string.Equals(uc.entrytype, "OBSERVATION", StringComparison.OrdinalIgnoreCase))
                return "Observation Charge";
            
            return !string.IsNullOrWhiteSpace(uc.entrytype) ? $"{uc.entrytype} Charge" : "Unbilled Charge";
        }
        return displayItemName;
    }

    private async Task AddUnbilledChargeItem(UnbilledChargeSummary uc)
    {
        if (billModel.items.Any(i => i.requestdetailsid == uc.unbilledid))
        {
            ToastService.ShowError("This charge is already added to the billing grid.");
            return;
        }

        var rate = (decimal)(uc.rate ?? 0);
        var qty = (decimal)(uc.quantity ?? 1);
        var amt = (decimal)(uc.amount ?? 0);

        string displayItemName = GetUnbilledChargeName(uc);

        billModel.items.Add(new HmsBillItemModel
        {
            sno = billModel.items.Count + 1,
            charge_type = uc.entrytype ?? "INVESTIGATION",
            item_name = displayItemName,
            tcode = uc.tcode.HasValue ? (decimal)uc.tcode.Value : 0m,
            item_ref_id = uc.entryid ?? "UNBILLED",
            unit_rate = rate,
            qty = qty,
            discount = 0,
            gst_per = 0,
            amount = amt,
            requestdetailsid = uc.unbilledid // Link to original unbilled charge
        });

        RecalculateTotals();
        await LoadUnbilledChargesAsync();
        ToastService.ShowSuccess($"Added: {displayItemName}");
    }

    private async Task AddAllUnbilledCharges()
    {
        int addedCount = 0;
        foreach (var uc in unbilledCharges)
        {
            if (!billModel.items.Any(i => i.requestdetailsid == uc.unbilledid))
            {
                var rate = (decimal)(uc.rate ?? 0);
                var qty = (decimal)(uc.quantity ?? 1);
                var amt = (decimal)(uc.amount ?? 0);

                string displayItemName = GetUnbilledChargeName(uc);

                billModel.items.Add(new HmsBillItemModel
                {
                    sno = billModel.items.Count + 1,
                    charge_type = uc.entrytype ?? "INVESTIGATION",
                    item_name = displayItemName,
                    tcode = uc.tcode.HasValue ? (decimal)uc.tcode.Value : 0m,
                    item_ref_id = uc.entryid ?? "UNBILLED",
                    unit_rate = rate,
                    qty = qty,
                    discount = 0,
                    gst_per = 0,
                    amount = amt,
                    requestdetailsid = uc.unbilledid
                });
                addedCount++;
            }
        }
        if (addedCount > 0)
        {
            RecalculateTotals();
            await LoadUnbilledChargesAsync();
            ToastService.ShowSuccess($"Added {addedCount} unbilled charges to grid.");
        }
    }

    private async Task AddConsultationChargeAsync()
    {
        if (string.IsNullOrEmpty(billModel.op_id))
        {
            ToastService.ShowError("Please select a patient with active OP ID first.");
            return;
        }

        var request = new AddUnbilledConsultationRequest
        {
            op_id = billModel.op_id,
            custid = billModel.custid,
            tcode = null,
            rate = consultationRate,
            amount = consultationRate * consultationQty,
            quantity = consultationQty
        };

        var result = await HmsBillingService.AddUnbilledConsultationAsync(request);
        if (!string.IsNullOrEmpty(result) && (result.Contains("success", StringComparison.OrdinalIgnoreCase) || result.Contains("unbilled", StringComparison.OrdinalIgnoreCase) || result.Contains("id", StringComparison.OrdinalIgnoreCase)))
        {
            ToastService.ShowSuccess("Consultation charge added successfully.");
            showAddConsultationForm = false;
            await LoadUnbilledChargesAsync();
        }
