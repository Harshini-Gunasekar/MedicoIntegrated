    private void SelectTestItem(item_master item)
    {
        var exists = billModel.items.Any(i => i.tcode == item.itemcode);
        if (exists)
        {
            ToastService.ShowError($"{item.itemname} is already added to the billing table.");
            testSearchQuery = string.Empty;
            showTestDropdown = false;
            return;
        }

        var row = new HmsBillItemModel
        {
            sno = billModel.items.Count + 1,
            charge_type = "INVESTIGATION",
            item_name = item.itemname,
            tcode = item.itemcode,
            item_ref_id = string.IsNullOrWhiteSpace(item.shortname) ? $"REF-{item.itemcode}" : item.shortname,
            unit_rate = item.salesrate,
            qty = 1,
            discount = 0,
            gst_per = item.gstpercentage,
