    private void OnPatientSearchKeyUp(KeyboardEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(patientSearchQuery))
        {
            filteredRegistrations.Clear();
            showPatientDropdown = false;
            return;
        }

        filteredRegistrations = allRegistrations
            .Where(r => 
            {
                var bk = bookingsCache.FirstOrDefault(b => b.custid == r.custid);
                var patientName = bk?.patient_name ?? "";
                var mobile = bk?.notes ?? ""; // using notes placeholder for mobile lookup
                return r.op_no.Contains(patientSearchQuery, StringComparison.OrdinalIgnoreCase) || 
                       r.custid.ToString().Contains(patientSearchQuery) ||
                       patientName.Contains(patientSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                       mobile.Contains(patientSearchQuery);
            })
            .Take(6)
            .ToList();

        showPatientDropdown = true;
    }

