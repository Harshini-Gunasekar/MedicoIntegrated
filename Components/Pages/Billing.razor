                agedays = savedPatient.agedays,
                dateofbirth = savedPatient.dateofbirth,
                ftcode = savedPatient.ftcode,
                area = savedPatient.area,
                city = savedPatient.city
            };

            await SelectCustomerPatient(pat);
            ToastService.ShowSuccess($"New patient '{savedPatient.name}' added successfully!");
        }
