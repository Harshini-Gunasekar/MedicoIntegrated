                                    string.Equals(p.shortname, "ADV", StringComparison.OrdinalIgnoreCase))
                        .Select(p => (double)p.pmcode)
                        .ToList();
                    if (!advancePaymodeCodes.Contains(99)) advancePaymodeCodes.Add(99);

                    double currentAdvUsed = 0;
                    if (billModel.pmc1.HasValue && advancePaymodeCodes.Contains(billModel.pmc1.Value) && (billModel.pmc1_amount ?? 0) > 0)
                        currentAdvUsed += billModel.pmc1_amount.Value;
                    if (billModel.pmc2.HasValue && advancePaymodeCodes.Contains(billModel.pmc2.Value) && (billModel.pmc2_amount ?? 0) > 0)
                        currentAdvUsed += billModel.pmc2_amount.Value;
                    if (billModel.pmc3.HasValue && advancePaymodeCodes.Contains(billModel.pmc3.Value) && (billModel.pmc3_amount ?? 0) > 0)
