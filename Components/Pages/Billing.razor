                    <button type="button" class="btn-billing-footer clear" @onclick="CloseSavedBillView" style="display: flex; align-items: center; gap: 0.35rem; padding: 0 1rem; height: 36px; border-radius: 6px; font-weight: 600;">
                        <i class="bi bi-plus-circle"></i> New Bill
                    </button>
                </div>
            }
            else
            {
                <button type="button" class="btn-billing-footer clear" @onclick="ClearFormAsync">
                    <i class="bi bi-arrow-counterclockwise"></i> Clear
                </button>
                
                <button type="button" class="btn-billing-footer save" @onclick="SaveBillAsync" disabled="@savingInProgress" style="@(savingInProgress ? "opacity: 0.65; cursor: not-allowed; pointer-events: none;" : "")">
                    @if (savingInProgress)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-save"></i>
                        <span>Save Bill</span>
                    }
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? OpIdStr { get; set; }

    private string? savedRequestGuid = null;
    private bool printWithLetterhead = true;
    private bool isPrintingSavedBill = false;

    // Shift Open Prompt Modal state
    private bool showOpenShiftPromptModal = false;
    private string promptCounterName = "";
    private string promptBranchName = "";
    private bool isOpeningShiftInBilling = false;
    private bool pendingSaveAfterOpenShift = false;

    private async Task<bool> CheckCounterShiftOpenAsync(bool showPrompt = true)
    {
        if (billModel.enteredbhcode <= 0 || billModel.cntcode <= 0)
        {
            return true;
        }

        try
        {
            var openCounters = await HmsBillingService.GetOpenCountersAsync();
            var activeShift = openCounters.FirstOrDefault(s => 
                s.cntcode == billModel.cntcode && 
                (billModel.enteredbhcode == 0 || s.bhcode == null || s.bhcode == 0 || s.bhcode == billModel.enteredbhcode))
                ?? openCounters.FirstOrDefault(s => s.cntcode == billModel.cntcode);

            if (activeShift != null)
            {
                showOpenShiftPromptModal = false;
                return true;
            }

            if (showPrompt)
            {
                var counterObj = countersList.FirstOrDefault(c => (int)c.cntcode == billModel.cntcode);
                var branchObj = branchesList.FirstOrDefault(b => b.bh_code == billModel.enteredbhcode);

                promptCounterName = counterObj?.name ?? $"Counter {billModel.cntcode}";
                promptBranchName = branchObj?.name ?? $"Branch {billModel.enteredbhcode}";
                showOpenShiftPromptModal = true;
                StateHasChanged();
            }

            return false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking shift status: {ex.Message}");
            return true;
        }
    }

    private void CancelOpenShiftPrompt()
    {
        showOpenShiftPromptModal = false;
        pendingSaveAfterOpenShift = false;
    }

    private async Task ConfirmOpenShiftForSelectedCounterAsync()
    {
        if (billModel.cntcode <= 0 || billModel.enteredbhcode <= 0) return;

        isOpeningShiftInBilling = true;
        StateHasChanged();

        try
        {
            var openReq = new Booking.Models.OpenShiftRequest
            {
                bhcode = billModel.enteredbhcode,
                cntcode = billModel.cntcode,
                counterdate = DateTime.Today
            };

            var rawResponse = await HmsBillingService.OpenShiftAsync(openReq);

            bool isSuccess = false;
            string displayMsg = "Shift opened successfully.";

            if (!string.IsNullOrEmpty(rawResponse) && !rawResponse.StartsWith("Error|"))
            {
                if (rawResponse.Trim().StartsWith("{") && rawResponse.Trim().EndsWith("}"))
                {
                    try
                    {
                        var jsonObj = Newtonsoft.Json.Linq.JObject.Parse(rawResponse);
                        if (jsonObj["message"] != null)
                        {
                            var msg = jsonObj["message"].ToString();
                            if (msg.Contains("success", StringComparison.OrdinalIgnoreCase) ||
                                msg.Contains("open", StringComparison.OrdinalIgnoreCase) ||
                                msg.Contains("ok", StringComparison.OrdinalIgnoreCase))
                            {
                                isSuccess = true;
                                displayMsg = msg;
                            }
                            else
                            {
                                isSuccess = false;
                                displayMsg = msg;
                            }
                        }
                        else if (jsonObj["cnttid"] != null || jsonObj["shiftsno"] != null)
                        {
                            isSuccess = true;
                        }
                    }
                    catch
                    {
                        isSuccess = true;
                    }
                }
                else
                {
                    isSuccess = true;
                }
            }
            else if (!string.IsNullOrEmpty(rawResponse) && rawResponse.StartsWith("Error|"))
            {
                isSuccess = false;
                displayMsg = rawResponse.Replace("Error|", "");
            }

            if (isSuccess)
            {
                ToastService.ShowSuccess($"Shift for counter '{promptCounterName}' opened successfully!");
                showOpenShiftPromptModal = false;
                StateHasChanged();

                if (pendingSaveAfterOpenShift)
                {
                    pendingSaveAfterOpenShift = false;
                    await SaveBillAsync();
                }
            }
            else
            {
                ToastService.ShowError($"Failed to open shift: {displayMsg}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error opening shift: {ex.Message}");
        }
        finally
        {
            isOpeningShiftInBilling = false;
            StateHasChanged();
        }
    }

    private async Task PerformLogoutAsync()
    {
        try
        {
            await _sessionStorage.DeleteAsync("authToken");
            await _sessionStorage.DeleteAsync("tenant_code");
            await _sessionStorage.DeleteAsync("tenant_name");
            await _sessionStorage.DeleteAsync("UserDetails");
            await _sessionStorage.DeleteAsync("UserRights");
            await _sessionStorage.DeleteAsync("bhcode");
            await _sessionStorage.DeleteAsync("cntcode");
            await _sessionStorage.DeleteAsync("UserBranches");
            await _sessionStorage.DeleteAsync("UserBranchCodes");
        }
        catch { }
        TenantState.Clear();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void OnBranchChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int bhCode))
        {
            billModel.enteredbhcode = bhCode;
            billModel.cntcode = 0; // Reset counter
        }
    }

    private HmsBillModel billModel = new();
    private bool showPaymode2 = false;
    private bool showPaymode3 = false;

    // Patient Advance State
    private double patientAdvanceAvailable = 0;
    private HmsPatientAdvanceSummary? patientAdvanceSummary;

    private async Task CheckPatientAdvanceAsync(decimal custId)
    {
        if (custId <= 0)
        {
            patientAdvanceAvailable = 0;
            patientAdvanceSummary = null;
            return;
        }

        try
        {
            patientAdvanceSummary = await DueCollectionService.GetPatientAdvanceSummaryAsync(custId);
            if (patientAdvanceSummary != null)
            {
                double calculatedBal = patientAdvanceSummary.total_advance_deposited - patientAdvanceSummary.total_advance_used - patientAdvanceSummary.total_advance_refunded;
                patientAdvanceAvailable = patientAdvanceSummary.available_balance > 0 
                    ? patientAdvanceSummary.available_balance 
                    : Math.Max(0, calculatedBal);
            }
            else
            {
                patientAdvanceAvailable = 0;
            }
            
            AutoApplyAdvanceIfAvailable();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking patient advance in Billing: {ex.Message}");
            patientAdvanceAvailable = 0;
            patientAdvanceSummary = null;
        }
    }

    private void AutoApplyAdvanceIfAvailable()
    {
        double dueAmt = (double)netPayable;

        if (patientAdvanceAvailable > 0)
        {
            var advancePm = paymodesList.FirstOrDefault(p => 
                string.Equals(p.name, "ADVANCE", StringComparison.OrdinalIgnoreCase) || 
                string.Equals(p.shortname, "ADVANCE", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(p.shortname, "ADV", StringComparison.OrdinalIgnoreCase)
            );

            if (advancePm == null)
            {
                advancePm = new PaymodeMasterModel { pmcode = 99, shortname = "ADVANCE", name = "Advance" };
                if (!paymodesList.Any(p => p.pmcode == 99))
                {
                    paymodesList.Add(advancePm);
                }
            }

            var cashPm = paymodesList.FirstOrDefault(p => string.Equals(p.shortname, "CASH", StringComparison.OrdinalIgnoreCase));
            bool isCashOrZero = billModel.pmc1 == null || (cashPm != null && (double)cashPm.pmcode == billModel.pmc1.Value && (billModel.pmc1_amount ?? 0) == 0);
            bool isAlreadyAdvance = billModel.pmc1.HasValue && (double)advancePm.pmcode == billModel.pmc1.Value;

            if (isCashOrZero || isAlreadyAdvance)
            {
                billModel.pmc1 = (double)advancePm.pmcode;
                if (dueAmt > 0)
                {
                    billModel.pmc1_amount = Math.Min(dueAmt, patientAdvanceAvailable);
                }
                RecalculateTotals();
            }
        }
    }

