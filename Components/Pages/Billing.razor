    // --- Actions ---
    private async Task SaveBillAsync()
    {
        if (string.IsNullOrWhiteSpace(billModel.patient_name))
        {
            ToastService.ShowError("Please enter Patient Name.");
            return;
        }
        if (billModel.items.Count == 0)
        {
            ToastService.ShowError("Please add at least one test to the billing grid.");
            return;
        }

        savingInProgress = true;
        try
        {
            string result;
            if (!string.IsNullOrEmpty(billModel.requestguid))
            {
                result = await HmsBillingService.UpdateBillAsync(billModel);
            }
            else
            {
                // Ensure requestguid is passed as null for saving as requested
                billModel.requestguid = null;
                result = await HmsBillingService.SaveBillAsync(billModel);
            }
            bool isSuccess = false;
            string displayMessage = "";

            if (!string.IsNullOrEmpty(result))
            {
                if (result.Contains("Error", StringComparison.OrdinalIgnoreCase))
                {
                    isSuccess = false;
                    displayMessage = result;
                }
                else if (result.Trim().StartsWith("{") && result.Trim().EndsWith("}"))
                {
                    try
                    {
                        var jsonObj = Newtonsoft.Json.Linq.JObject.Parse(result);
                        if (jsonObj["message"] != null)
                        {
                            var msg = jsonObj["message"].ToString();
                            if (msg.Contains("not open", StringComparison.OrdinalIgnoreCase) || 
                                msg.Contains("error", StringComparison.OrdinalIgnoreCase) || 
                                msg.Contains("fail", StringComparison.OrdinalIgnoreCase) ||
                                msg.Contains("invalid", StringComparison.OrdinalIgnoreCase))
                            {
                                isSuccess = false;
                                displayMessage = msg;
                            }
                            else
                            {
                                isSuccess = true;
                                displayMessage = msg;
                            }
                        }
                        else if (jsonObj["requestguid"] != null || jsonObj["bill_no"] != null)
                        {
                            isSuccess = true;
                            displayMessage = "Bill Saved and Posted Successfully!";
                        }
                        else
                        {
                            isSuccess = false;
                            displayMessage = result;
                        }
                    }
                    catch
                    {
                        isSuccess = true;
                        displayMessage = "Bill Saved and Posted Successfully!";
                    }
                }
                else
                {
                    isSuccess = true;
                    displayMessage = "Bill Saved and Posted Successfully!";
                }
            }

            if (isSuccess)
            {
                ToastService.ShowSuccess(!string.IsNullOrEmpty(displayMessage) ? displayMessage : "Bill Saved and Posted Successfully!");
                
                // If it was loaded from outpatient flow, update the status to COMPLETED
                if (!string.IsNullOrEmpty(billModel.op_id) && Guid.TryParse(billModel.op_id, out var opId))
                {
                    await AppointmentBookingService.UpdateOpStatusAsync(opId, "COMPLETED");
                }
                
                // Stay on page but refresh serial
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError($"Failed to save bill. API error: {displayMessage}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Exception while saving bill: {ex.Message}");
        }
        finally
        {
            savingInProgress = false;
        }
    }

