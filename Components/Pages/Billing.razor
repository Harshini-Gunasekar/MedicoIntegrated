    private List<OPRegistrationModel.OpRegistrationModel> allRegistrations = new();
    private List<OPRegistrationModel.OpRegistrationModel> filteredRegistrations = new();
    private List<DoctorBookingListModel> bookingsCache = new();
    private string? selectedOpNo = "-";
    
    private List<Booking.Models.CustomerWithOpModel> searchedPatients = new();
    private List<CustomerModel> allCustomersCache = new();
    private bool isCustomersCacheLoaded = false;
    private List<Booking.Models.BranchModel> branchesList = new();
    private List<CounterMasterModel> countersList = new();
    private List<PaymodeMasterModel> paymodesList = new();
    private string TenantCode = "";
    private string AuthToken = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                // Initialise TenantState so LabCare services can attach auth headers
                if (!string.IsNullOrEmpty(AuthToken))
                    TenantState.SetSession(TenantCode, AuthToken, "");

                await LoadBranchesAsync();
                await LoadCountersAsync();
                await LoadTestMastersAsync();
                await LoadUserPermissionsAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error loading session: {ex.Message}");
            }
        }
    }

    private async Task LoadUserPermissionsAsync()
    {
        try
        {
            var userCode = TenantState.UserCode;
            if (userCode <= 0) return;

            using var client = CreateClient(true);
            var response = await client.GetAsync($"api/user/get?user_code={userCode}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var userDetails = Newtonsoft.Json.JsonConvert.DeserializeObject<LIMS_Backend.Model.user_master>(json,
                    new Newtonsoft.Json.JsonSerializerSettings { MissingMemberHandling = Newtonsoft.Json.MissingMemberHandling.Ignore });
                if (userDetails != null)
                {
                    canEditBill  = userDetails.edit_bill  ?? true;
                    canPrintBill = userDetails.print_bill ?? true;
                    Console.WriteLine($"[Billing] User {userCode} — edit_bill={canEditBill}, print_bill={canPrintBill}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Billing] LoadUserPermissionsAsync error: {ex.Message}");
        }
    }

    private HttpClient CreateClient(bool isLabCare = false)
    {
        var clientName = isLabCare ? "LabCareUrl" : "DoctorApi";
        var client = ClientFactory.CreateClient(clientName);
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            using var client = CreateClient(true);
            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                branchesList = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branchesList = branchesList.Where(b => !b.deleted).ToList();

                await FilterBranchesByUserAccessAsync();

                if (branchesList.Any() && (billModel.enteredbhcode <= 1 || !branchesList.Any(b => b.bh_code == billModel.enteredbhcode)))
                {
                    billModel.enteredbhcode = branchesList.First().bh_code;
                }
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Console.Error.WriteLine($"Error loading branches: {response.StatusCode} - {err}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }

    private async Task FilterBranchesByUserAccessAsync()
    {
        try
        {
            var isTenantAdminResult = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
            if (isTenantAdminResult.Success && isTenantAdminResult.Value == true)
            {
                return;
            }

            var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (userDetailsResult.Success && userDetailsResult.Value != null && userDetailsResult.Value.UserCode == 0)
            {
                return;
            }

            if (userDetailsResult.Success && userDetailsResult.Value?.Branches != null && userDetailsResult.Value.Branches.Any())
            {
                var allowedCodes = userDetailsResult.Value.Branches
                    .Select(b => b.bh_code != 0 ? b.bh_code : (b.bhcode ?? 0))
                    .Where(code => code > 0)
                    .ToHashSet();

                if (allowedCodes.Any())
                {
                    branchesList = branchesList.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                    return;
                }
            }

            var branchCodesResult = await _sessionStorage.GetAsync<List<int>>("UserBranchCodes");
            if (branchCodesResult.Success && branchCodesResult.Value != null && branchCodesResult.Value.Any())
            {
                var allowedCodes = branchCodesResult.Value.ToHashSet();
                branchesList = branchesList.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering branches by user access: {ex.Message}");
        }
    }

    private async Task LoadCountersAsync()
    {
        try
        {
            countersList = await CounterMasterService.GetCountersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading counters: {ex.Message}");
        }
    }

    private async Task SelectCustomerPatient(Booking.Models.CustomerWithOpModel pat)
    {
        // Lookup OP ID using medico api/OpRegistration/customers-with-op
        try
        {
            using var client = CreateClient(false); // Medico URL
            var searchKey = !string.IsNullOrEmpty(pat.mobile) ? pat.mobile : pat.custid.ToString();
            var response = await client.GetAsync($"api/OpRegistration/customers-with-op?key={Uri.EscapeDataString(searchKey)}");
            if (response.IsSuccessStatusCode)
            {
                var rawJson = await response.Content.ReadAsStringAsync();
                var settings = new Newtonsoft.Json.JsonSerializerSettings 
                { 
                    NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore 
                };
                var medicoList = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.CustomerWithOpModel>>(rawJson, settings) ?? new();
                var match = medicoList.FirstOrDefault(m => m.custid == pat.custid && !string.IsNullOrEmpty(m.op_id));
                if (match != null)
                {
                    pat.op_id = match.op_id;
                    pat.op_no = match.op_no;
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error retrieving patient op_id: {ex.Message}");
        }

        billModel.custid = pat.custid;
        billModel.op_id = pat.op_id;
        selectedOpNo = pat.op_no;
        billModel.patient_name = string.IsNullOrEmpty(pat.namewithinitials) ? pat.name : pat.namewithinitials;
        billModel.mobileno = pat.mobile;
        billModel.gender = pat.gender;
        billModel.ageyears = pat.ageyears.ToString();
        billModel.agemonths = pat.agemonths.ToString();
        billModel.agedays = pat.agedays.ToString();
        billModel.dateofbirth = pat.dateofbirth?.ToString("yyyy-MM-dd");
        if (pat.dateofbirth.HasValue)
        {
            dobSelected = DateOnly.FromDateTime(pat.dateofbirth.Value);
        }
        
        if (pat.ftcode.HasValue && pat.ftcode.Value > 0)
        {
            billModel.ftcode = pat.ftcode.Value;
        }

        patientSearchQuery = $"{(string.IsNullOrEmpty(pat.namewithinitials) ? pat.name : pat.namewithinitials)} (CUST-{pat.custid})";
        selectedPatientBadgeVisible = true;
        showPatientDropdown = false;

        // Auto-load ordered tests from Case Sheet and lookup registration details
        if (!string.IsNullOrEmpty(pat.op_id) && Guid.TryParse(pat.op_id, out var opId))
        {
            await LoadExistingBillOrRegistrationAsync(opId);
        }

        RecalculateTotals();
    }

    private string testSearchQuery = string.Empty;
    private bool showTestDropdown = false;
    private List<item_master> allItems = new();            // kept for case-sheet auto-load fallback
    private List<item_master> filteredItems = new();
    private List<test_master> allTestMasters = new();      // live test_master data (primary source)
    private List<test_master> filteredTestMasters = new();
    private string areaSearchQuery = string.Empty;

    // Doctors cache
    private List<DoctorMasterModel> doctorsCache = new();

    // Calculations
    private decimal totalBaseAmount = 0;
    private decimal balanceDue = 0;
    private decimal netPayable = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupDataAsync();
        
        if (!string.IsNullOrEmpty(OpIdStr) && Guid.TryParse(OpIdStr, out var opId))
        {
            await LoadExistingBillOrRegistrationAsync(opId);
        }
        else
        {
            ClearForm();
        }
    }

    private async Task LoadLookupDataAsync()
    {
        try
        {
            doctorsCache = await DoctorService.GetDoctorsAsync() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctors: {ex.Message}");
            doctorsCache ??= new();
        }

        try
        {
            paymodesList = await PaymodeService.GetPaymodeMastersAsync();
            paymodesList = paymodesList.Where(p => !p.deleted).OrderBy(p => p.orderno).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading paymodes: {ex.Message}");
            paymodesList ??= new();
        }

        try
        {
            allRegistrations = await AppointmentBookingService.GetAllOpRegistrationsAsync() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading registrations: {ex.Message}");
            allRegistrations ??= new();
        }

        try
        {
            allItems = await CaseSheetService.GetAllItemsAsync() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading items: {ex.Message}");
            allItems ??= new();
        }

        // test_master loaded separately after session is ready (see LoadTestMastersAsync)

        try
        {
            if (doctorsCache != null)
            {
                // Cache doctor bookings to pull patient names easily by custid
                foreach (var doc in doctorsCache)
                {
                    try
                    {
                        var bookList = await AppointmentBookingService.GetDoctorBookingsAsync(doc.dcode, DateOnly.FromDateTime(DateTime.Today));
                        if (bookList != null)
                        {
                            bookingsCache.AddRange(bookList);
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error loading bookings for doctor {doc.dcode}: {ex.Message}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error caching doctor bookings: {ex.Message}");
        }

        EnsurePredefinedData();
    }

    private void EnsurePredefinedData()
    {
        if (allRegistrations == null) allRegistrations = new();
        if (bookingsCache == null) bookingsCache = new();
        if (doctorsCache == null) doctorsCache = new();
        if (allItems == null) allItems = new();
    }

    private async Task LoadExistingBillOrRegistrationAsync(Guid opId)
    {
        try
        {
            // 0. Try to load as a direct edit (requestguid)
            var billResp = await HmsBillingService.GetBillByGuidAsync(opId.ToString());
            if (billResp != null && !string.IsNullOrEmpty(billResp.requestguid))
            {
                int resolvedDcode = billResp.dcode ?? 0;
                if (resolvedDcode == 0 && !string.IsNullOrWhiteSpace(billResp.doctor_name))
                {
                    var cleanName = billResp.doctor_name.Replace("Dr.", "", StringComparison.OrdinalIgnoreCase).Trim();
                    var matchedDoc = doctorsCache.FirstOrDefault(d => 
                        (d.name != null && d.name.Contains(cleanName, StringComparison.OrdinalIgnoreCase)) ||
                        (d.doctorfullname != null && d.doctorfullname.Contains(cleanName, StringComparison.OrdinalIgnoreCase))
                    );
                    if (matchedDoc != null)
                    {
                        resolvedDcode = matchedDoc.dcode;
                    }
                }

                billModel = new HmsBillModel
                {
                    requestguid = billResp.requestguid,
                    op_id = billResp.op_id, 
                    custid = billResp.custid ?? 0,
                    patient_name = billResp.patient_name,
                    mobileno = billResp.mobileno,
                    gender = billResp.gender,
                    dateofbirth = billResp.dateofbirth,
                    ageyears = billResp.ageyears,
                    dcode = resolvedDcode,
                    consultantdcode = resolvedDcode,
                    enteredbhcode = billResp.enteredbhcode ?? 1,
                    cntcode = billResp.cntcode ?? 2,
                    paidamount = (decimal)(billResp.paid_amount ?? 0),
                    discountper = (decimal)(billResp.general_concession_per ?? 0),
                    discountamount = (decimal)(billResp.general_concession_amount ?? 0),
                    ourdispercentage = (decimal)(billResp.referral_concession_per ?? 0),
                    ourdiscount = (decimal)(billResp.referral_concession_amount ?? 0),
                    specialdiscount = (decimal)(billResp.referral_concession_amount ?? 0),
                    pmc1 = billResp.pmc1,
                    pmc2 = billResp.pmc2,
                    pmc3 = billResp.pmc3,
                    pmc1_amount = billResp.pmc1_amount,
                    pmc2_amount = billResp.pmc2_amount,
                    pmc3_amount = billResp.pmc3_amount,
                    collection_type = billResp.pay_mode ?? "CASH",
                    items = billResp.items?.Select(i => new HmsBillItemModel
                    {
                        item_name = i.item_name,
                        tcode = i.tcode ?? 0,
                        unit_rate = (decimal)(i.unit_rate ?? 0),
                        qty = (decimal)(i.qty ?? 1),
                        amount = (decimal)(i.amount ?? 0),
                        discount = (decimal)(i.discount ?? 0),
                        charge_type = i.charge_type ?? "INVESTIGATION",
                        requestdetailsid = i.requestdetailsid
                    }).ToList() ?? new List<HmsBillItemModel>()
                };

                selectedOpNo = billModel.op_id;
                if (!string.IsNullOrEmpty(billModel.op_id) && Guid.TryParse(billModel.op_id, out var opIdGuid))
                {
                    var regMatch = allRegistrations.FirstOrDefault(r => r.op_id == opIdGuid);
                    if (regMatch != null)
                    {
                        selectedOpNo = regMatch.op_no;
                    }
                }

                // Parse prefix out of name if possible
                if (billModel.patient_name != null)
                {
                    var spaceIndex = billModel.patient_name.IndexOf(' ');
                    if (spaceIndex > 0)
                    {
                        var potentialPrefix = billModel.patient_name.Substring(0, spaceIndex);
                        if (potentialPrefix == "Mr." || potentialPrefix == "Ms." || potentialPrefix == "Mrs." || potentialPrefix == "Dr.")
                        {
                            patientPrefix = potentialPrefix;
                        }
                    }
                }

                if (!string.IsNullOrEmpty(billModel.dateofbirth) && DateOnly.TryParse(billModel.dateofbirth, out var parsedDob))
                {
                    dobSelected = parsedDob;
                }

                for(int i = 0; i < billModel.items.Count; i++) billModel.items[i].sno = i + 1;

                RecalculateTotals();
                ToastService.ShowSuccess("Loaded bill for editing.");
                await LoadUnbilledChargesAsync();
                return;
            }

            // 1. Try to load an existing bill by OpId
            var existingBill = await HmsBillingService.GetBillAsync(opId);
            if (existingBill != null)
            {
                billModel = existingBill;
                var regMatch = allRegistrations.FirstOrDefault(r => r.op_id == opId);
                selectedOpNo = regMatch?.op_no ?? billModel.op_id;
                
                // Parse prefix out of name if possible
                if (billModel.patient_name != null)
                {
                    var spaceIndex = billModel.patient_name.IndexOf(' ');
                    if (spaceIndex > 0)
                    {
                        var potentialPrefix = billModel.patient_name.Substring(0, spaceIndex);
                        if (potentialPrefix == "Mr." || potentialPrefix == "Ms." || potentialPrefix == "Mrs." || potentialPrefix == "Dr.")
                        {
                            patientPrefix = potentialPrefix;
                        }
                    }
                }

                if (!string.IsNullOrEmpty(billModel.dateofbirth) && DateOnly.TryParse(billModel.dateofbirth, out var parsedDob))
                {
                    dobSelected = parsedDob;
                }

                totalBaseAmount = 0;
                foreach (var item in billModel.items)
                {
                    totalBaseAmount += item.amount;
                }

                if (billModel.ourdispercentage == 0 && billModel.ourdiscount > 0 && totalBaseAmount > 0)
                {
                    billModel.ourdispercentage = Math.Round((billModel.ourdiscount / totalBaseAmount) * 100m, 2);
                }
                else if (billModel.ourdispercentage == 0 && billModel.specialdiscount > 0 && totalBaseAmount > 0)
                {
                    billModel.ourdispercentage = Math.Round((billModel.specialdiscount / totalBaseAmount) * 100m, 2);
                    billModel.ourdiscount = billModel.specialdiscount;
                }

                RecalculateTotals();
                ToastService.ShowSuccess("Loaded existing bill.");
                await LoadUnbilledChargesAsync();
                return;
            }

            // 2. If no bill exists yet, pull the patient OP registration details to prefill the invoice
            var reg = allRegistrations.FirstOrDefault(r => r.op_id == opId);
            if (reg != null)
            {
                var bk = bookingsCache.FirstOrDefault(b => b.custid == reg.custid);
                string patientName = bk?.patient_name ?? string.Empty;
                string mobile = bk?.notes ?? reg.op_no;

                if (string.IsNullOrEmpty(patientName))
                {
                    // Query doctor bookings on the day of registration to get the patient name
                    var bookingsOnDay = await AppointmentBookingService.GetDoctorBookingsAsync(reg.dcode, reg.visit_date);
                    var match = bookingsOnDay?.FirstOrDefault(b => b.custid == reg.custid);
                    if (match != null)
                    {
                        patientName = match.patient_name ?? "";
                        mobile = match.notes ?? reg.op_no;
                    }
                }

                if (string.IsNullOrEmpty(patientName))
                {
                    if (!string.IsNullOrEmpty(billModel.patient_name) && !billModel.patient_name.StartsWith("Patient ID"))
                    {
                        patientName = billModel.patient_name;
                    }
                    else
                    {
                        patientName = $"Patient ID {reg.custid}";
                    }
                }
                
                if (string.IsNullOrEmpty(mobile) || mobile == reg.op_no)
                {
                    if (!string.IsNullOrEmpty(billModel.mobileno) && billModel.mobileno != "-")
                    {
                        mobile = billModel.mobileno;
                    }
                }

                SelectPatient(reg, patientName, mobile, false);
                
                // Set OP ID and Consultant Code from registration
                billModel.op_id = reg.op_id.ToString();
                billModel.dcode = reg.dcode;
                billModel.consultantdcode = reg.dcode;
                
                // Note: Auto-loading tests from the doctor's case sheet directly into the grid is disabled.
                // Users should now explicitly add them from the "Unbilled Charges / Pending Copay" panel above.
            }
            await LoadUnbilledChargesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading existing bill or registration: {ex.Message}");
        }
    }

