    // UI Helpers
    private string billingTimeDisplay = DateTime.Now.ToString("MM/dd/yyyy hh:mm tt");
    private string billingDateDisplay = DateTime.Now.ToString("yyyy-MM-dd");
    private bool isHuman = true;
