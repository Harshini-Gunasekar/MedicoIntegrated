        var itm = ItemList.FirstOrDefault(x => x.itemcode == itemcode);
        return itm?.itemname ?? $"Item #{itemcode}";
    }

    private string GetUomName(long? uomcode)
    {
        if (!uomcode.HasValue || uomcode == 0) return "-";
        var u = UomList.FirstOrDefault(x => x.ucode == uomcode);
        return u?.name ?? "Nos";
    }

    private int GetItemCount(long transfercode)
    {
        if (TransferDetailsMap.TryGetValue(transfercode, out var list))
        {
            return list.Count;
        }
        return 0;
    }

    private decimal GetTransferTotalQty(long transfercode)
    {
        if (TransferDetailsMap.TryGetValue(transfercode, out var list))
        {
            return list.Sum(d => d.transferqty);
        }
        return 0;
    }

    private decimal GetTransferTotalValue(long transfercode)
    {
        if (TransferDetailsMap.TryGetValue(transfercode, out var list))
        {
            return list.Sum(d => d.stockvalue);
        }
        return 0;
    }

    private decimal GetTotalTransferredValue()
    {
        return TransferDetailsMap.Values.SelectMany(d => d).Sum(x => x.stockvalue);
    }

    private string GetStatusClass(string? status)
    {
        return status?.ToUpper() switch
        {
            "DRAFT" => "status-draft",
            "PENDING" => "status-pending",
            "IN-TRANSIT" => "status-intransit",
            "COMPLETED" => "status-completed",
            "ACCEPTED" => "status-completed",
            "REJECTED" => "status-rejected",
            "CANCELLED" => "status-cancelled",
            _ => "status-draft"
        };
    }

    public class ServiceResponse<T>
    {
        public bool success { get; set; }
        public string? message { get; set; }
        public T? data { get; set; }
    }
}
