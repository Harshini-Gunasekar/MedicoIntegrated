                            Cancel
                        </button>
                        <button type="submit" class="btn-primary-solid">
                            <i class="bi bi-check-lg"></i>
                            <span>Save & Process Transfer</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

