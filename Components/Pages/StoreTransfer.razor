    // Helper Getters
    private string GetStoreName(long? warehousecode)
    {
        if (!warehousecode.HasValue || warehousecode == 0) return "-";
        var w = WarehouseList.FirstOrDefault(x => x.warehousecode == warehousecode);
        return w?.warehousename ?? $"Store #{warehousecode}";
    }

    private string GetUserName(long? userCode, long? indentCode = null)
    {
        if (indentCode.HasValue && indentCode.Value > 0)
        {
            var ind = IndentList.FirstOrDefault(i => i.indentcode == indentCode.Value);
            if (ind?.requestedby != null && ind.requestedby.Value > 0)
            {
                var u = UsersList.FirstOrDefault(x => x.user != null && x.user.user_code == ind.requestedby.Value);
                if (u?.user != null)
                {
                    if (!string.IsNullOrWhiteSpace(u.user.name)) return u.user.name;
                    if (!string.IsNullOrWhiteSpace(u.user.short_name)) return u.user.short_name;
                }
                if (ind.requestedby.Value == loggedInUserCode && !string.IsNullOrWhiteSpace(loggedInUserName))
                {
                    return loggedInUserName;
                }
            }
        }

        if (userCode.HasValue && userCode.Value > 0)
        {
            if (userCode.Value == loggedInUserCode && !string.IsNullOrWhiteSpace(loggedInUserName))
            {
                return loggedInUserName;
            }

            var matched = UsersList.FirstOrDefault(u => u.user != null && u.user.user_code == userCode.Value);
            if (matched?.user != null)
            {
                if (!string.IsNullOrWhiteSpace(matched.user.name)) return matched.user.name;
                if (!string.IsNullOrWhiteSpace(matched.user.short_name)) return matched.user.short_name;
            }
        }

        if (!string.IsNullOrWhiteSpace(loggedInUserName))
        {
            return loggedInUserName;
        }

        return userCode.HasValue && userCode.Value > 0 ? $"User #{userCode.Value}" : "-";
    }

    private string GetItemName(long itemcode)
    {
        var itm = ItemList.FirstOrDefault(x => x.itemcode == itemcode);
        return itm?.itemname ?? $"Item #{itemcode}";
    }

    private string GetUomName(long? uomcode)
    {
        if (!uomcode.HasValue || uomcode == 0) return "-";
        var u = UomList.FirstOrDefault(x => x.ucode == uomcode);
        return u?.name ?? "Nos";
    }

