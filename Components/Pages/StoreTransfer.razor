                if (!string.IsNullOrEmpty(DefaultTenant)) directClient.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
                var resp = await directClient.GetStringAsync("http://medicoapi.iscansoft.com/api/ItemMaster/getallitems");
                if (!string.IsNullOrWhiteSpace(resp))
                {
                    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    var direct = JsonSerializer.Deserialize<List<item_master>>(resp, options);
                    if (direct != null && direct.Any()) ItemList = direct.Where(i => !i.deleted).ToList();
                }
            }
            catch { }
        }

        EnsureItemFallbacks();
    }

    private async Task LoadStocks()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallstocks");
            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions 
                { 
                    PropertyNameCaseInsensitive = true,
                    NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                };
                try
                {
                    var direct = JsonSerializer.Deserialize<List<stock_master>>(response, options);
                    if (direct != null && direct.Any()) StockList = direct.Where(s => !s.deleted).ToList();
                }
                catch
                {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<stock_master>>>(response, options);
                    if (wrapped?.data != null && wrapped.data.Any()) StockList = wrapped.data.Where(s => !s.deleted).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stocks: {ex.Message}");
        }

        if (!StockList.Any())
        {
            try
            {
                using var directClient = new HttpClient();
                if (!string.IsNullOrEmpty(DefaultTenant)) directClient.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
                var resp = await directClient.GetStringAsync("http://medicoapi.iscansoft.com/api/ItemMaster/getallstocks");
                if (!string.IsNullOrWhiteSpace(resp))
                {
                    var options = new JsonSerializerOptions 
                    { 
                        PropertyNameCaseInsensitive = true,
                        NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                    };
                    var direct = JsonSerializer.Deserialize<List<stock_master>>(resp, options);
                    if (direct != null && direct.Any()) StockList = direct.Where(s => !s.deleted).ToList();
                }
            }
            catch { }
        }
    }

    private async Task LoadUoms()
    {
        try
        {
            var client = CreateClient();
            var uomResponse = await client.GetFromJsonAsync<List<uom_master>>("api/Uom/getalluom");
            if (uomResponse != null && uomResponse.Any())
            {
                UomList = uomResponse;
