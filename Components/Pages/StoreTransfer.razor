    private string DefaultTenant = "";

    // Search and Filters
    private string SearchText = "";
    private long SelectedFromStoreFilter = 0;
    private long SelectedToStoreFilter = 0;
    private string SelectedStatusFilter = "";

    // Pagination
    private int CurrentPage = 1;
    private int PageSize = 10;

    // Active typeahead tracking
    private int activeItemSearchIndex = -1;
    private Dictionary<int, string> itemSearchQueries = new();

    // Data lists
    private List<store_transfer_header> TransferList = new();
    private Dictionary<long, List<store_transfer_detail>> TransferDetailsMap = new();
    private List<warehouse_master> WarehouseList = new();
    private List<item_master> ItemList = new();
