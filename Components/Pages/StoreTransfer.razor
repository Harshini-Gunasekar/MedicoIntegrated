            {
                transfercode = (TransferList.Any() ? TransferList.Max(t => t.transfercode) + 1 : 1001),
                transferno = $"TRF-{DateTime.Now.Year}-{(TransferList.Count + 1):D4}",
                transferdate = DateTime.Today,
                transfertype = "Standard",
                status = "PENDING",
                fromwarehousecode = WarehouseList.FirstOrDefault()?.warehousecode ?? 1,
                towarehousecode = WarehouseList.Skip(1).FirstOrDefault()?.warehousecode ?? 2,
                createdby = "Admin",
                createddate = DateTime.Now
            },
            details = new List<store_transfer_detail>()
        };

        // Add 1 clean default line item
        AddDetailRow();
