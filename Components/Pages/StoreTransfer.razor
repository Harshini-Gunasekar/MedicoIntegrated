@page "/storetransfer"
@page "/store-transfer"
@using Booking.Models
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<PageTitle>Store to Store Transfer - Inventory</PageTitle>

<link rel="stylesheet" href="Components/Pages/StoreTransfer.razor.css" />

<div class="transfer-page pt-2 pb-4">
    <div class="transfer-shell px-3">
        <div class="transfer-content">
            <!-- Header Card -->
            <div class="premium-header-card">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <i class="bi bi-arrow-left-right fs-4"></i>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Store to Store Transfer</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Inter-Store & Warehouse Stock Movement
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <button class="add-transfer-btn" @onclick="OpenNewTransferModal">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>New Transfer</span>
                    </button>
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon-wrapper stat-icon-primary">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value">@TransferList.Count</span>
                        <span class="stat-label">Total Transfers</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon-wrapper stat-icon-warning">
                        <i class="bi bi-truck"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value">@TransferList.Count(t => t.status == "PENDING" || t.status == "IN-TRANSIT")</span>
                        <span class="stat-label">Pending / In-Transit</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon-wrapper stat-icon-success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value">@TransferList.Count(t => t.status == "COMPLETED")</span>
                        <span class="stat-label">Completed</span>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon-wrapper stat-icon-info">
                        <i class="bi bi-currency-rupee"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value">₹ @GetTotalTransferredValue().ToString("N0")</span>
                        <span class="stat-label">Total Stock Value</span>
                    </div>
                </div>
            </div>

            <!-- Filter & Action Toolbar -->
            <div class="filter-toolbar">
                <div class="filter-left-group">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search Transfer No, Store, Reason..." @bind="SearchText" @bind:event="oninput" />
                    </div>

                    <select class="filter-select" @bind="SelectedFromStoreFilter">
                        <option value="0">All Source Stores</option>
                        @foreach (var store in WarehouseList)
                        {
                            <option value="@store.warehousecode">From: @store.warehousename</option>
                        }
                    </select>

                    <select class="filter-select" @bind="SelectedToStoreFilter">
                        <option value="0">All Destination Stores</option>
                        @foreach (var store in WarehouseList)
                        {
                            <option value="@store.warehousecode">To: @store.warehousename</option>
                        }
                    </select>

                    <select class="filter-select" @bind="SelectedStatusFilter">
                        <option value="">All Statuses</option>
                        <option value="DRAFT">DRAFT</option>
                        <option value="PENDING">PENDING</option>
                        <option value="IN-TRANSIT">IN-TRANSIT</option>
                        <option value="COMPLETED">COMPLETED</option>
                        <option value="CANCELLED">CANCELLED</option>
                    </select>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="view-toggle" title="Switch View">
                        <button type="button" class="@(IsCardView ? "" : "active")" @onclick="() => IsCardView = false">
                            <i class="bi bi-table"></i>
                        </button>
                        <button type="button" class="@(IsCardView ? "active" : "")" @onclick="() => IsCardView = true">
                            <i class="bi bi-grid-3x3-gap"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Main Listing Card -->
            <div class="items-main-card shadow-sm">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading transfers...</span>
                        </div>
                    </div>
                }
                else if (!FilteredTransfers.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inboxes fs-1 d-block mb-3 text-secondary"></i>
                        <h6 class="fw-bold">No Store Transfers Found</h6>
                        <p class="text-muted small">Click "New Transfer" above to initiate a store-to-store stock movement.</p>
                    </div>
                }
                else if (!IsCardView)
                {
                    <!-- Table View -->
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table">
                            <thead>
                                <tr>
                                    <th style="width: 55px; text-align: center;">S.NO</th>
                                    <th>TRANSFER NO</th>
                                    <th>DATE</th>
                                    <th>TYPE</th>
                                    <th>FROM STORE</th>
                                    <th>TO STORE</th>
                                    <th class="text-center">ITEMS</th>
                                    <th class="text-end">TOTAL VALUE (₹)</th>
                                    <th class="text-center">STATUS</th>
                                    <th style="width: 120px; text-align: center;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedTransfers.Select((t, i) => new { item = t, index = i }))
                                {
                                    var transfer = row.item;
                                    <tr>
                                        <td style="text-align: center; color: #64748b; font-weight: 600;">
                                            @(((CurrentPage - 1) * PageSize) + row.index + 1)
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold text-primary" style="font-size: 0.85rem;">@(string.IsNullOrWhiteSpace(transfer.transferno) ? $"#TRF-{transfer.transfercode:D4}" : transfer.transferno)</span>
                                                <span class="text-muted" style="font-size: 0.7rem;">Code: #@transfer.transfercode</span>
                                            </div>
                                        </td>
                                        <td>@transfer.transferdate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@transfer.transfertype</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-1">
                                                <i class="bi bi-building-up text-secondary" style="font-size: 0.85rem;"></i>
                                                <span class="fw-semibold">@GetStoreName(transfer.fromwarehousecode)</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-1">
                                                <i class="bi bi-building-down text-primary" style="font-size: 0.85rem;"></i>
                                                <span class="fw-semibold">@GetStoreName(transfer.towarehousecode)</span>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-2">
                                                @GetItemCount(transfer.transfercode)
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            ₹ @GetTransferTotalValue(transfer.transfercode).ToString("N2")
                                        </td>
                                        <td class="text-center">
                                            <span class="status-pill @GetStatusClass(transfer.status)">
                                                @transfer.status
                                            </span>
                                        </td>
                                        <td>
                                            <div class="action-btn-group justify-content-center">
                                                <button class="action-btn btn-view" title="View Slip" @onclick="() => ViewTransferSlip(transfer)">
                                                    <i class="bi bi-receipt"></i>
                                                </button>
                                                <button class="action-btn btn-edit" title="Edit" @onclick="() => EditTransfer(transfer)">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                <button class="action-btn btn-delete" title="Delete" @onclick="() => DeleteTransfer(transfer)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <!-- Card View Grid -->
                    <div class="cards-grid">
                        @foreach (var transfer in PagedTransfers)
                        {
                            <div class="transfer-grid-card">
                                <div class="card-header-row">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold text-primary" style="font-size: 0.95rem;">@(string.IsNullOrWhiteSpace(transfer.transferno) ? $"#TRF-{transfer.transfercode:D4}" : transfer.transferno)</span>
                                        <span class="badge bg-light text-dark border small">@transfer.transfertype</span>
                                    </div>
                                    <span class="status-pill @GetStatusClass(transfer.status)">@transfer.status</span>
                                </div>

                                <div class="card-route-box">
                                    <div class="route-point">
                                        <span class="route-label">From Store</span>
                                        <span class="route-name">@GetStoreName(transfer.fromwarehousecode)</span>
                                    </div>
                                    <i class="bi bi-arrow-right route-arrow"></i>
                                    <div class="route-point text-end">
                                        <span class="route-label">To Store</span>
                                        <span class="route-name">@GetStoreName(transfer.towarehousecode)</span>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center small text-muted pt-1 border-top">
                                    <div>
                                        <i class="bi bi-calendar-event me-1"></i>
                                        <span>@transfer.transferdate.ToString("yyyy-MM-dd")</span>
                                    </div>
                                    <div>
                                        <i class="bi bi-box me-1"></i>
                                        <span>@GetItemCount(transfer.transfercode) Items</span>
                                    </div>
                                    <div class="fw-bold text-dark">
                                        ₹ @GetTransferTotalValue(transfer.transfercode).ToString("N2")
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(transfer.reason))
                                {
                                    <div class="small text-secondary fst-italic">
                                        <i class="bi bi-info-circle me-1"></i>Reason: @transfer.reason
                                    </div>
                                }

                                <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                                    <button class="action-btn btn-view" title="View Slip" @onclick="() => ViewTransferSlip(transfer)">
                                        <i class="bi bi-receipt"></i>
                                    </button>
                                    <button class="action-btn btn-edit" title="Edit" @onclick="() => EditTransfer(transfer)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="action-btn btn-delete" title="Delete" @onclick="() => DeleteTransfer(transfer)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Pagination Footer -->
                @if (TotalPages > 1)
                {
                    <div class="pagination-wrapper">
                        <div class="small text-muted">
                            Showing @(((CurrentPage - 1) * PageSize) + 1) to @(Math.Min(CurrentPage * PageSize, FilteredTransfers.Count)) of @FilteredTransfers.Count entries
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <button class="page-btn" @onclick="() => CurrentPage--" disabled="@(CurrentPage <= 1)">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            @for (int p = 1; p <= TotalPages; p++)
                            {
                                var pageNum = p;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => CurrentPage = pageNum">
                                    @pageNum
                                </button>
                            }
                            <button class="page-btn" @onclick="() => CurrentPage++" disabled="@(CurrentPage >= TotalPages)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- NEW / EDIT TRANSFER MODAL -->
@if (ShowTransferModal)
{
    <div class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header-bar">
                <div class="modal-title-wrap">
                    <div class="modal-title-icon">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>
                    <div>
                        <h3 class="modal-title">@(IsEditMode ? "Edit Store Transfer" : "New Store to Store Transfer")</h3>
                        <span class="text-muted" style="font-size: 0.75rem;">Create voucher & dispatch inventory across stores</span>
                    </div>
                </div>
                <button class="btn-close-modal" @onclick="CloseTransferModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-scroll-area">
                <EditForm Model="CurrentTransfer" OnValidSubmit="SaveTransfer">
                    <!-- Section 1: Header Information -->
                    <div class="form-section-title">
                        <i class="bi bi-card-heading"></i> Transfer Header Information
                    </div>

                    <div class="form-grid">
                        <!-- Row 1: Transfer No, Date, Type, Status -->
                        <div class="field-group col-3">
                            <label class="field-label">Transfer No</label>
                            <InputText class="form-control premium-input" @bind-Value="CurrentTransfer.master.transferno" placeholder="Auto / TRF-2026-0001" />
                        </div>

                        <div class="field-group col-3">
                            <label class="field-label required">Transfer Date</label>
                            <InputDate class="form-control premium-input" @bind-Value="CurrentTransfer.master.transferdate" />
                        </div>

                        <div class="field-group col-3">
                            <label class="field-label required">Transfer Type</label>
                            <InputSelect class="form-control premium-input" @bind-Value="CurrentTransfer.master.transfertype">
                                <option value="Standard">Standard Transfer</option>
                                <option value="Emergency">Emergency / Priority</option>
                                <option value="Replenishment">Replenishment</option>
                                <option value="Inter-Branch">Inter-Branch Transfer</option>
                                <option value="Return to Main">Return to Main Store</option>
                            </InputSelect>
                        </div>

                        <div class="field-group col-3">
                            <label class="field-label">Status</label>
                            <InputSelect class="form-control premium-input" @bind-Value="CurrentTransfer.master.status">
                                <option value="DRAFT">DRAFT</option>
                                <option value="PENDING">PENDING</option>
                                <option value="IN-TRANSIT">IN-TRANSIT</option>
                                <option value="COMPLETED">COMPLETED</option>
                                <option value="CANCELLED">CANCELLED</option>
                            </InputSelect>
                        </div>

                        <!-- Row 2: From Store, To Store -->
                        <div class="field-group col-6">
                            <label class="field-label required">From Store (Source Warehouse)</label>
                            <InputSelect class="form-control premium-input" @bind-Value="CurrentTransfer.master.fromwarehousecode" @bind-Value:after="OnSourceStoreChanged">
                                <option value="0">-- Select Source Store --</option>
                                @foreach (var w in WarehouseList)
                                {
                                    <option value="@w.warehousecode">@w.warehousename</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="field-group col-6">
                            <label class="field-label required">To Store (Destination Warehouse)</label>
                            <InputSelect class="form-control premium-input" @bind-Value="CurrentTransfer.master.towarehousecode">
                                <option value="0">-- Select Destination Store --</option>
                                @foreach (var w in WarehouseList)
                                {
                                    <option value="@w.warehousecode" disabled="@(w.warehousecode == CurrentTransfer.master.fromwarehousecode)">
                                        @w.warehousename @(w.warehousecode == CurrentTransfer.master.fromwarehousecode ? "(Source Store)" : "")
                                    </option>
                                }
                            </InputSelect>
                        </div>

                        <!-- Row 3: Indent Code, Branch Code, Created By -->
                        <div class="field-group col-4">
                            <label class="field-label">Linked Indent Code (Optional)</label>
                            <div class="input-with-action">
                                <InputNumber class="form-control premium-input" @bind-Value="CurrentTransfer.master.indentcode" placeholder="Indent Code" />
                                <button type="button" class="btn-pull-action" @onclick="FetchIndentItems" title="Load items from Indent">
                                    <i class="bi bi-cloud-arrow-down"></i> Pull
                                </button>
                            </div>
                        </div>

                        <div class="field-group col-4">
                            <label class="field-label">Branch Code</label>
                            <InputText class="form-control premium-input" @bind-Value="CurrentTransfer.master.branchcode" placeholder="Main / Branch Code" />
                        </div>

                        <div class="field-group col-4">
                            <label class="field-label">Created By</label>
                            <InputText class="form-control premium-input" @bind-Value="CurrentTransfer.master.createdby" placeholder="User Name / ID" />
                        </div>

                        <!-- Row 4: Reason, Remarks -->
                        <div class="field-group col-6">
                            <label class="field-label">Transfer Reason</label>
                            <InputText class="form-control premium-input" @bind-Value="CurrentTransfer.master.reason" placeholder="e.g., Department Replenishment, Emergency Patient Requirement" />
                        </div>

                        <div class="field-group col-6">
                            <label class="field-label">Header Remarks / Notes</label>
                            <InputText class="form-control premium-input" @bind-Value="CurrentTransfer.master.remarks" placeholder="Special handling instructions, transport vehicle notes..." />
                        </div>
                    </div>

                    <!-- Section 2: Transfer Details (Line Items) -->
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="form-section-title m-0 border-0">
                            <i class="bi bi-list-check"></i> Transfer Items Details (@CurrentTransfer.details.Count items)
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" @onclick="AddDetailRow">
                            <i class="bi bi-plus-lg me-1"></i> Add Line Item
                        </button>
                    </div>

                    <div class="detail-grid-wrapper table-responsive mt-2">
                        <table class="table detail-table align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 35px;">#</th>
                                    <th style="width: 230px; text-align: left;">ITEM SELECTION *</th>
                                    <th style="width: 170px; text-align: left;">BATCH NO (DROPDOWN)</th>
                                    <th style="width: 110px;">MFG DATE</th>
                                    <th style="width: 110px;">EXPIRY DATE</th>
                                    <th style="width: 90px;">UOM</th>
                                    <th style="width: 80px;" class="text-end">AVAIL QTY</th>
                                    <th style="width: 80px;" class="text-end">REQ QTY</th>
                                    <th style="width: 80px;" class="text-end">APPR QTY</th>
                                    <th style="width: 85px;" class="text-end">TRF QTY *</th>
                                    <th style="width: 90px;" class="text-end">UNIT COST (₹)</th>
                                    <th style="width: 100px;" class="text-end">STOCK VALUE (₹)</th>
                                    <th style="width: 120px;">REMARKS</th>
                                    <th style="width: 45px;">DEL</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!CurrentTransfer.details.Any())
                                {
                                    <tr>
                                        <td colspan="14" class="text-center py-4 text-muted">
                                            No items added yet. Click "Add Line Item" to select products to transfer.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in CurrentTransfer.details.Select((d, idx) => new { item = d, index = idx }))
                                    {
                                        var detail = row.item;
                                        var index = row.index;
                                        var availableBatches = GetBatchesForItem(detail.itemcode, CurrentTransfer.master.fromwarehousecode);

                                        <tr>
                                            <td class="text-center text-muted fw-bold" style="font-size: 0.75rem;">@(index + 1)</td>
                                            
                                            <!-- Item Selection with Typeahead -->
                                            <td class="position-relative">
                                                <input type="text"
                                                       class="detail-input"
                                                       placeholder="Type to search item..."
                                                       value="@GetItemSearchLabel(detail)"
                                                       @oninput="@(e => OnItemSearchInput(detail, e.Value?.ToString()))"
                                                       @onfocus="@(() => activeItemSearchIndex = index)"
                                                       @onblur="OnSearchBlur" />

                                                @if (activeItemSearchIndex == index)
                                                {
                                                    var searchText = itemSearchQueries.GetValueOrDefault(index, "");
                                                    var filtered = ItemList
                                                        .Where(i => string.IsNullOrWhiteSpace(searchText) || (i.itemname != null && i.itemname.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                                                        .Take(20)
                                                        .ToList();

                                                    if (filtered.Any())
                                                    {
                                                        <div class="custom-typeahead-dropdown shadow">
                                                            @foreach (var itm in filtered)
                                                            {
                                                                <div class="custom-typeahead-item" @onmousedown="() => SelectItemForDetail(detail, itm, index)">
                                                                    <div class="fw-bold">@itm.itemname</div>
                                                                    <div class="small text-muted">Code: #@itm.itemcode | Stock: @itm.currentstock | Rate: ₹@itm.purchaserate</div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </td>

                                            <!-- Batch No Dropdown / Input -->
                                            <td>
                                                @if (availableBatches.Any())
                                                {
                                                    <select class="detail-input" value="@detail.batchno" @onchange="@(e => OnBatchSelectChanged(detail, e.Value?.ToString()))">
                                                        <option value="">-- Select Batch --</option>
                                                        @foreach (var b in availableBatches)
                                                        {
                                                            <option value="@b.batchno">
                                                                @b.batchno (Stock: @b.closingstock | Exp: @(b.expirydate?.ToString("dd/MM/yyyy") ?? "N/A"))
                                                            </option>
                                                        }
                                                    </select>
                                                }
                                                else
                                                {
                                                    <input type="text" class="detail-input" @bind="detail.batchno" placeholder="Batch No" />
                                                }
                                            </td>

                                            <!-- Mfg Date -->
                                            <td>
                                                <input type="date" class="detail-input" @bind="detail.manufacturingdate" />
                                            </td>

                                            <!-- Expiry Date -->
                                            <td>
                                                <input type="date" class="detail-input" @bind="detail.expirydate" />
                                            </td>

                                            <!-- UOM Code -->
                                            <td>
                                                <select class="detail-input" @bind="detail.uomcode">
                                                    <option value="0">Select</option>
                                                    @foreach (var u in UomList)
                                                    {
                                                        <option value="@u.ucode">@u.name</option>
                                                    }
                                                </select>
                                            </td>

                                            <!-- Available Qty (Readonly) -->
                                            <td>
                                                <input type="number" step="any" class="detail-input detail-input-readonly text-end fw-bold" @bind="detail.availableqty" readonly />
                                            </td>

                                            <!-- Requested Qty -->
                                            <td>
                                                <input type="number" step="any" class="detail-input text-end" @bind="detail.requestedqty" />
                                            </td>

                                            <!-- Approved Qty -->
                                            <td>
                                                <input type="number" step="any" class="detail-input text-end" @bind="detail.approvedqty" />
                                            </td>

                                            <!-- Transfer Qty (Editable) -->
                                            <td>
                                                <input type="number" step="any" class="detail-input text-end fw-bold text-primary" @bind="detail.transferqty" @bind:after="() => CalculateRowStockValue(detail)" min="0" />
                                            </td>

                                            <!-- Unit Cost -->
                                            <td>
                                                <input type="number" step="any" class="detail-input text-end" @bind="detail.unitcost" @bind:after="() => CalculateRowStockValue(detail)" />
                                            </td>

                                            <!-- Stock Value (Calculated) -->
                                            <td>
                                                <input type="text" class="detail-input detail-input-readonly text-end fw-bold text-dark" value="@detail.stockvalue.ToString("N2")" readonly />
                                            </td>

                                            <!-- Remarks -->
                                            <td>
                                                <input type="text" class="detail-input" @bind="detail.remarks" placeholder="Notes" />
                                            </td>

                                            <!-- Delete Action -->
                                            <td class="text-center">
