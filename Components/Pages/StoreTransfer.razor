            // if (resp != null) TransferList = resp;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading transfers: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenNewTransferModal()
