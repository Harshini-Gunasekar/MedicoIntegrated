                    if (direct != null && direct.Any()) ItemList = direct.Where(i => !i.deleted).ToList();
                }
                catch
                {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<item_master>>>(response, options);
                    if (wrapped?.data != null && wrapped.data.Any()) ItemList = wrapped.data.Where(i => !i.deleted).ToList();
                }
            }
