    // Active Models
    private store_transfer_request CurrentTransfer = new();
    private store_transfer_header? SelectedSlipTransfer;

    private List<store_transfer_header> FilteredTransfers => TransferList
        .Where(t => 
            (string.IsNullOrWhiteSpace(SearchText) || 
             (t.transferno != null && t.transferno.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
             (t.reason != null && t.reason.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
             (t.remarks != null && t.remarks.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
             GetStoreName(t.fromwarehousecode).Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
             GetStoreName(t.towarehousecode).Contains(SearchText, StringComparison.OrdinalIgnoreCase)) &&
            (SelectedFromStoreFilter == 0 || t.fromwarehousecode == SelectedFromStoreFilter) &&
            (SelectedToStoreFilter == 0 || t.towarehousecode == SelectedToStoreFilter) &&
            (string.IsNullOrWhiteSpace(SelectedStatusFilter) || t.status.Equals(SelectedStatusFilter, StringComparison.OrdinalIgnoreCase))
        )
        .OrderByDescending(t => t.transferdate)
        .ThenByDescending(t => t.transfercode)
        .ToList();

    private List<store_transfer_header> PagedTransfers => FilteredTransfers
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize)
        .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredTransfers.Count / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var res = await _sessionStorage.GetAsync<string>("tenant_code");
            if (res.Success && !string.IsNullOrWhiteSpace(res.Value))
            {
                DefaultTenant = res.Value;
            }
        }
        catch { }

        await Task.WhenAll(LoadWarehouses(), LoadItems(), LoadStocks(), LoadUoms());
        await LoadTransfers();
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Remove("tenant-code");
        if (!string.IsNullOrEmpty(DefaultTenant))
        {
            client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant-code", DefaultTenant);
        }
        return client;
    }

    private async Task LoadWarehouses()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallwarehouse");
            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                try
                {
                    var direct = JsonSerializer.Deserialize<List<warehouse_master>>(response, options);
                    if (direct != null && direct.Any())
                    {
                        WarehouseList = direct.Where(w => !w.isdeleted).ToList();
                    }
                }
                catch
                {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<warehouse_master>>>(response, options);
                    if (wrapped?.data != null && wrapped.data.Any())
                    {
                        WarehouseList = wrapped.data.Where(w => !w.isdeleted).ToList();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading warehouses: {ex.Message}");
        }

        // Direct fallback to exact url if needed
        if (!WarehouseList.Any())
        {
            try
            {
                using var directClient = new HttpClient();
                if (!string.IsNullOrEmpty(DefaultTenant)) directClient.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
                var resp = await directClient.GetStringAsync("http://medicoapi.iscansoft.com/api/ItemMaster/getallwarehouse");
                if (!string.IsNullOrWhiteSpace(resp))
                {
                    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    var direct = JsonSerializer.Deserialize<List<warehouse_master>>(resp, options);
                    if (direct != null && direct.Any()) WarehouseList = direct.Where(w => !w.isdeleted).ToList();
                }
            }
            catch { }
        }

        EnsureWarehouseFallbacks();
    }

