@code {
    // State variables
    private bool IsLoading = false;
    private bool IsCardView = false;
    private bool ShowDetailModal = false;
    private bool ShowSlipModal = false;
    private string DefaultTenant = "";
    private string ActiveTab = "ALL";

    // Search and Filters
    private string _searchText = "";
    private string SearchText
    {
        get => _searchText;
        set
        {
            if (_searchText != value)
            {
                _searchText = value;
                CurrentPage = 1;
            }
        }
    }

    private long _selectedFromStoreFilter = 0;
    private long SelectedFromStoreFilter
    {
        get => _selectedFromStoreFilter;
        set
        {
            if (_selectedFromStoreFilter != value)
            {
                _selectedFromStoreFilter = value;
                CurrentPage = 1;
            }
        }
    }

    private long _selectedToStoreFilter = 0;
    private long SelectedToStoreFilter
    {
        get => _selectedToStoreFilter;
        set
        {
            if (_selectedToStoreFilter != value)
            {
                _selectedToStoreFilter = value;
                CurrentPage = 1;
            }
        }
    }

    private string _selectedStatusFilter = "";
    private string SelectedStatusFilter
    {
        get => _selectedStatusFilter;
        set
        {
            if (_selectedStatusFilter != value)
            {
                _selectedStatusFilter = value;
                CurrentPage = 1;
            }
        }
    }

    private DateTime? _filterFromDate = null;
    private DateTime? FilterFromDate
    {
        get => _filterFromDate;
        set
        {
            if (_filterFromDate != value)
            {
                _filterFromDate = value;
                CurrentPage = 1;
            }
        }
    }

    private DateTime? _filterToDate = null;
    private DateTime? FilterToDate
    {
        get => _filterToDate;
        set
        {
            if (_filterToDate != value)
            {
                _filterToDate = value;
                CurrentPage = 1;
            }
        }
    }

    // Pagination
    private int CurrentPage = 1;
    private int PageSize = 10;

    // Data lists
    private List<stock_transfer_master> TransferList = new();
    private Dictionary<long, List<stock_transfer_detail>> TransferDetailsMap = new();
    private List<warehouse_master> WarehouseList = new();
    private List<item_master> ItemList = new();
    private List<stock_master> StockList = new();
    private List<uom_master> UomList = new();
    private List<GetUser> UsersList = new();
    private List<indent_master> IndentList = new();
    private long loggedInUserCode = 0;
    private string loggedInUserName = "";

    // Selected Models
    private stock_transfer_master? SelectedRecordTransfer;
    private stock_transfer_master? SelectedSlipTransfer;

    private void SetActiveTab(string tab)
    {
        ActiveTab = tab;
        CurrentPage = 1;
    }

    private void ResetFilters()
    {
        _searchText = "";
        _selectedFromStoreFilter = 0;
        _selectedToStoreFilter = 0;
        _selectedStatusFilter = "";
        _filterFromDate = null;
        _filterToDate = null;
        CurrentPage = 1;
    }

    private bool MatchesTransferSearch(stock_transfer_master t, string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return true;
        var q = query.Trim();

        // 1. Direct case-insensitive contains
        if (t.transferno != null && t.transferno.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (t.transfercode.ToString().Contains(q)) return true;
        if (t.reason != null && t.reason.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (t.remarks != null && t.remarks.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (t.createdby != null && t.createdby.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (t.branchcode != null && t.branchcode.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (GetStoreName(t.fromwarehousecode).Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (GetStoreName(t.towarehousecode).Contains(q, StringComparison.OrdinalIgnoreCase)) return true;

        // 2. Linked Indent search
        if (t.indentcode.HasValue && t.indentcode.Value > 0)
        {
            if (t.indentcode.Value.ToString().Contains(q)) return true;
            if ($"IND-{t.indentcode.Value}".Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
            if ($"#IND-{t.indentcode.Value}".Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        }

        // 3. Normalized alphanumeric search (matches "TRF 000027", "TRF000027", "TRF-000027", "000027", "27")
        var cleanQ = new string(q.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
        if (!string.IsNullOrEmpty(cleanQ))
        {
            var cleanTrfNo = new string((t.transferno ?? "").Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
            if (cleanTrfNo.Contains(cleanQ)) return true;

            var cleanCode = t.transfercode.ToString();
            if (cleanCode.Contains(cleanQ) || cleanQ.Contains(cleanCode)) return true;

            // Numeric check against transfer number digits & transfer code
            var digitsQ = new string(q.Where(char.IsDigit).ToArray());
            if (!string.IsNullOrEmpty(digitsQ))
            {
                if (long.TryParse(digitsQ, out var numQ) && numQ > 0)
                {
                    if (t.transfercode == numQ) return true;
                    if (t.indentcode.HasValue && t.indentcode.Value == numQ) return true;
                    var trfDigits = new string((t.transferno ?? "").Where(char.IsDigit).ToArray());
                    if (trfDigits.Contains(digitsQ) || (long.TryParse(trfDigits, out var trfNum) && trfNum == numQ)) return true;
                }
            }
        }

        // 4. Item name & batch search
        if (TransferDetailsMap.TryGetValue(t.transfercode, out var itms) && itms.Any())
        {
            if (itms.Any(d => GetItemName(d.itemcode).Contains(q, StringComparison.OrdinalIgnoreCase) ||
                              (!string.IsNullOrWhiteSpace(d.batchno) && d.batchno.Contains(q, StringComparison.OrdinalIgnoreCase))))
            {
                return true;
            }
        }

        return false;
    }

    private long GetTransferSortKey(stock_transfer_master t)
    {
        if (t == null) return 0;
        if (!string.IsNullOrWhiteSpace(t.transferno))
        {
            var digits = new string(t.transferno.Where(char.IsDigit).ToArray());
            if (long.TryParse(digits, out var num) && num > 0) return num;
        }
        return t.transfercode;
    }

    private int PendingCount => TransferList.Count(t => t.status == "PENDING" || t.status == "IN-TRANSIT" || t.status == "IN_TRANSIT" || t.status == "DISPATCHED");
    private int CompletedCount => TransferList.Count(t => t.status == "COMPLETED" || t.status == "ACCEPTED" || t.status == "RECEIVED" || t.status == "PARTIALLY_RECEIVED");
    private int RejectedCount => TransferList.Count(t => t.status == "REJECTED" || t.status == "CANCELLED" || t.status == "RETURNED");

    private void SetView(bool isCard)
    {
        IsCardView = isCard;
    }

    private string FormatTransferNo(string? trfNo)
    {
        if (string.IsNullOrWhiteSpace(trfNo)) return "-";
        if (trfNo.StartsWith("TRF", StringComparison.OrdinalIgnoreCase))
        {
            var clean = trfNo.Replace("TRF-", "").Replace("TRF ", "").Replace("TRF", "").Trim();
            if (int.TryParse(clean, out int num))
            {
                return $"TRF-{num:D6}";
            }
        }
        return trfNo;
    }

    private string GetStatusColor(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "#64748b";
        var s = status.Trim().ToUpperInvariant().Replace("-", "_");
        if (s == "RECEIVED" || s == "COMPLETED" || s == "ACCEPTED") return "#059669";
        if (s == "PARTIALLY_RECEIVED" || s == "PARTIAL") return "#d97706";
        if (s == "IN_TRANSIT" || s == "DISPATCHED") return "#0284c7";
        if (s == "REJECTED" || s == "CANCELLED" || s == "RETURNED") return "#dc2626";
        if (s == "PENDING") return "#6366f1";
        return "#64748b";
    }

    private bool MatchesStatusFilter(string? recordStatus, string? filterStatus)
    {
        if (string.IsNullOrWhiteSpace(filterStatus)) return true;
        if (string.IsNullOrWhiteSpace(recordStatus)) return false;

        var r = recordStatus.Trim().ToUpperInvariant().Replace("-", "_");
        var f = filterStatus.Trim().ToUpperInvariant().Replace("-", "_");

        if (f == "RECEIVED")
        {
            return r == "RECEIVED" || r == "COMPLETED" || r == "ACCEPTED";
        }
        if (f == "IN_TRANSIT")
        {
            return r == "IN_TRANSIT" || r == "DISPATCHED";
        }
        if (f == "REJECTED")
        {
            return r == "REJECTED" || r == "CANCELLED" || r == "RETURNED";
        }
        if (f == "PARTIALLY_RECEIVED")
        {
            return r == "PARTIALLY_RECEIVED" || r == "PARTIAL";
        }
        if (f == "PENDING")
        {
            return r == "PENDING";
        }

        return r == f;
    }

    private List<stock_transfer_master> FilteredTransfers => TransferList
        .Where(t => 
            (ActiveTab == "ALL" ||
             (ActiveTab == "PENDING" && (t.status == "PENDING" || t.status == "IN-TRANSIT" || t.status == "IN_TRANSIT" || t.status == "DISPATCHED")) ||
             (ActiveTab == "COMPLETED" && (t.status == "COMPLETED" || t.status == "ACCEPTED" || t.status == "RECEIVED" || t.status == "PARTIALLY_RECEIVED")) ||
             (ActiveTab == "REJECTED" && (t.status == "REJECTED" || t.status == "CANCELLED" || t.status == "RETURNED"))) &&
            MatchesTransferSearch(t, SearchText) &&
            (SelectedFromStoreFilter == 0 || t.fromwarehousecode == SelectedFromStoreFilter) &&
            (SelectedToStoreFilter == 0 || t.towarehousecode == SelectedToStoreFilter) &&
            (string.IsNullOrWhiteSpace(SelectedStatusFilter) || MatchesStatusFilter(t.status, SelectedStatusFilter)) &&
            (!FilterFromDate.HasValue || t.transferdate.Date >= FilterFromDate.Value.Date) &&
            (!FilterToDate.HasValue || t.transferdate.Date <= FilterToDate.Value.Date)
        )
        .OrderByDescending(t => GetTransferSortKey(t))
        .ThenByDescending(t => t.transferdate)
        .ThenByDescending(t => t.transfercode)
        .ToList();

    private List<stock_transfer_master> PagedTransfers
    {
        get
        {
            var list = FilteredTransfers;
            int maxP = Math.Max(1, (int)Math.Ceiling(list.Count / (double)PageSize));
            if (CurrentPage > maxP)
            {
                CurrentPage = 1;
            }
            return list.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredTransfers.Count / (double)PageSize));

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private IEnumerable<int> GetVisiblePageNumbers()
    {
        int total = TotalPages;
        int current = CurrentPage;

        if (total <= 5)
        {
            return Enumerable.Range(1, Math.Max(1, total));
        }

        int start = current - 2;
        if (current <= 2)
        {
            start = 1;
        }
        else if (current >= total - 1)
        {
            start = total - 4;
        }

        start = Math.Max(1, Math.Min(start, total - 4));
        return Enumerable.Range(start, 5);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null)
                {
                    loggedInUserName = userResult.Value.UserName ?? "";
                    if (userResult.Value.UserCode.HasValue && userResult.Value.UserCode.Value > 0)
                    {
                        loggedInUserCode = userResult.Value.UserCode.Value;
                    }
                }
                
                if (string.IsNullOrWhiteSpace(loggedInUserName))
                {
                    var nameRes = await _sessionStorage.GetAsync<string>("username");
                    if (nameRes.Success && !string.IsNullOrWhiteSpace(nameRes.Value))
                    {
                        loggedInUserName = nameRes.Value;
                    }
                }
                StateHasChanged();
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var res = await _sessionStorage.GetAsync<string>("tenant_code");
            if (res.Success && !string.IsNullOrWhiteSpace(res.Value))
            {
                DefaultTenant = res.Value;
            }
        }
        catch { }

        await Task.WhenAll(LoadWarehouses(), LoadItems(), LoadStocks(), LoadUoms(), LoadUsers(), LoadIndents());
        await LoadTransfers();
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Remove("tenant-code");
        if (!string.IsNullOrEmpty(DefaultTenant))
        {
            client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant-code", DefaultTenant);
        }
        return client;
    }

