    private List<stock_master> GetBatchesForItem(long itemcode, long? warehousecode)
    {
        if (itemcode <= 0) return new();

        var itemMatches = StockList
            .Where(s => s.itemcode == itemcode && !string.IsNullOrWhiteSpace(s.batchno))
            .ToList();

        if (!itemMatches.Any()) return new();

        if (warehousecode.HasValue && warehousecode.Value > 0)
        {
            var storeMatches = itemMatches.Where(s => s.warehousecode == warehousecode.Value).ToList();
            if (storeMatches.Any())
            {
                return storeMatches
                    .OrderByDescending(s => s.closingstock > 0)
                    .ThenBy(s => s.expirydate ?? DateTime.MaxValue)
                    .GroupBy(s => s.batchno)
                    .Select(g => g.First())
                    .ToList();
            }
        }

        return itemMatches
            .OrderByDescending(s => s.closingstock > 0)
            .ThenBy(s => s.expirydate ?? DateTime.MaxValue)
            .GroupBy(s => s.batchno)
            .Select(g => g.First())
            .ToList();
    }

