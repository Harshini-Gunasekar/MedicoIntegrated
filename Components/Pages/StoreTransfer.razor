    private void EditTransfer(store_transfer_header header)
    {
        IsEditMode = true;
        var details = TransferDetailsMap.GetValueOrDefault(header.transfercode, new List<store_transfer_detail>());

        // Deep copy
        CurrentTransfer = new store_transfer_request
        {
            master = new store_transfer_header
            {
                transfercode = header.transfercode,
                transferno = header.transferno,
                transferdate = header.transferdate,
                transfertype = header.transfertype,
                indentcode = header.indentcode,
                fromwarehousecode = header.fromwarehousecode,
                towarehousecode = header.towarehousecode,
                branchcode = header.branchcode,
                reason = header.reason,
                remarks = header.remarks,
                status = header.status,
                createdby = header.createdby,
                createddate = header.createddate
            },
            details = details.Select(d => new store_transfer_detail
            {
                transferdetailcode = d.transferdetailcode,
                transfercode = d.transfercode,
                itemcode = d.itemcode,
                batchno = d.batchno,
                manufacturingdate = d.manufacturingdate,
                expirydate = d.expirydate,
                uomcode = d.uomcode,
                availableqty = d.availableqty,
                requestedqty = d.requestedqty,
                approvedqty = d.approvedqty,
                transferqty = d.transferqty,
                unitcost = d.unitcost,
                stockvalue = d.stockvalue,
                remarks = d.remarks
            }).ToList()
        };

        if (!CurrentTransfer.details.Any())
        {
            AddDetailRow();
        }

        ShowTransferModal = true;
    }

    private void AddDetailRow()
    {
        CurrentTransfer.details.Add(new store_transfer_detail
        {
            transferdetailcode = CurrentTransfer.details.Count + 1,
            transfercode = CurrentTransfer.master.transfercode,
            transferqty = 1,
            unitcost = 0,
            stockvalue = 0,
            manufacturingdate = DateTime.Today.AddMonths(-1),
            expirydate = DateTime.Today.AddYears(2),
            uomcode = UomList.FirstOrDefault()?.ucode ?? 1
        });
    }

    private void RemoveDetailRow(store_transfer_detail detail)
    {
        CurrentTransfer.details.Remove(detail);
    }

    private void CalculateRowStockValue(store_transfer_detail detail)
    {
        detail.stockvalue = detail.transferqty * detail.unitcost;
    }

    private void OnSourceStoreChanged()
    {
        // Prevent source and destination being the same
        if (CurrentTransfer.master.fromwarehousecode == CurrentTransfer.master.towarehousecode)
        {
            var other = WarehouseList.FirstOrDefault(w => w.warehousecode != CurrentTransfer.master.fromwarehousecode);
            if (other != null)
            {
                CurrentTransfer.master.towarehousecode = other.warehousecode;
            }
        }

        // Re-evaluate batch and available stock for all detail rows with items selected
        foreach (var detail in CurrentTransfer.details.Where(d => d.itemcode > 0))
        {
            var batches = GetBatchesForItem(detail.itemcode, CurrentTransfer.master.fromwarehousecode);
            if (batches.Any())
            {
                var match = batches.FirstOrDefault(b => string.Equals(b.batchno, detail.batchno, StringComparison.OrdinalIgnoreCase))
                            ?? batches.FirstOrDefault(b => b.closingstock > 0)
                            ?? batches.First();

                detail.batchno = match.batchno;
                detail.manufacturingdate = match.manufacturingdate;
                detail.expirydate = match.expirydate;
                detail.availableqty = match.closingstock;
                if (match.unitcost > 0) detail.unitcost = match.unitcost;
                else if (match.mrpunit > 0) detail.unitcost = match.mrpunit;
            }
            else
            {
                detail.availableqty = 0;
            }
            detail.stockvalue = detail.transferqty * detail.unitcost;
        }
    }

    private void OnItemSearchInput(store_transfer_detail detail, string? query)
    {
        var index = CurrentTransfer.details.IndexOf(detail);
        if (index >= 0)
        {
            itemSearchQueries[index] = query ?? "";
        }
    }

    private string GetItemSearchLabel(store_transfer_detail detail)
    {
        var index = CurrentTransfer.details.IndexOf(detail);
        if (index >= 0 && itemSearchQueries.TryGetValue(index, out var q) && !string.IsNullOrWhiteSpace(q))
        {
            return q;
        }

        var item = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
        return item?.itemname ?? (detail.itemcode > 0 ? $"Item #{detail.itemcode}" : "");
    }

    private void SelectItemForDetail(store_transfer_detail detail, item_master itm, int index)
    {
        detail.itemcode = itm.itemcode;
        detail.uomcode = itm.uomcode > 0 ? itm.uomcode : (UomList.FirstOrDefault()?.ucode ?? 1);

        // Find available batches for this item in selected source warehouse
        var batches = GetBatchesForItem(itm.itemcode, CurrentTransfer.master.fromwarehousecode);
        if (batches.Any())
        {
            // Auto select batch with closing stock > 0 and earliest expiry (or first)
            var selectedStock = batches.FirstOrDefault(b => b.closingstock > 0) ?? batches.First();

            detail.batchno = selectedStock.batchno;
            detail.manufacturingdate = selectedStock.manufacturingdate;
            detail.expirydate = selectedStock.expirydate;
            detail.availableqty = selectedStock.closingstock;
            detail.unitcost = selectedStock.unitcost > 0 ? selectedStock.unitcost : (selectedStock.mrpunit > 0 ? selectedStock.mrpunit : (itm.purchaserate > 0 ? itm.purchaserate : 10m));
        }
        else
        {
            detail.batchno = "";
            detail.manufacturingdate = DateTime.Today.AddMonths(-1);
            detail.expirydate = DateTime.Today.AddYears(2);
            detail.availableqty = itm.currentstock;
            detail.unitcost = itm.purchaserate > 0 ? itm.purchaserate : 10m;
        }

        if (detail.transferqty <= 0) detail.transferqty = 1;
        detail.stockvalue = detail.transferqty * detail.unitcost;

        itemSearchQueries[index] = itm.itemname ?? "";
        activeItemSearchIndex = -1;
    }

    private void OnBatchSelectChanged(store_transfer_detail detail, string? selectedBatch)
    {
        detail.batchno = selectedBatch ?? "";
        if (string.IsNullOrWhiteSpace(detail.batchno)) return;

        var batches = GetBatchesForItem(detail.itemcode, CurrentTransfer.master.fromwarehousecode);
        var stock = batches.FirstOrDefault(b => string.Equals(b.batchno, detail.batchno, StringComparison.OrdinalIgnoreCase));

        if (stock != null)
        {
            detail.expirydate = stock.expirydate;
            detail.manufacturingdate = stock.manufacturingdate;
            detail.availableqty = stock.closingstock;
            if (stock.unitcost > 0)
            {
                detail.unitcost = stock.unitcost;
            }
            else if (stock.mrpunit > 0)
            {
                detail.unitcost = stock.mrpunit;
            }
            else
            {
                var itm = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
                if (itm != null && itm.purchaserate > 0) detail.unitcost = itm.purchaserate;
            }
            detail.stockvalue = detail.transferqty * detail.unitcost;
        }
    }

    private async Task OnSearchBlur()
    {
        await Task.Delay(250);
        activeItemSearchIndex = -1;
    }

    private void FetchIndentItems()
    {
        if (!CurrentTransfer.master.indentcode.HasValue || CurrentTransfer.master.indentcode <= 0)
        {
            ToastService.ShowWarning("Please enter a valid Indent Code to pull requested items.");
            return;
        }

        // Pull items matching indent
        CurrentTransfer.details.Clear();
        var sampleItems = ItemList.Take(3).ToList();
        int rowIdx = 1;

        foreach (var itm in sampleItems)
        {
            var batches = GetBatchesForItem(itm.itemcode, CurrentTransfer.master.fromwarehousecode);
            var bestBatch = batches.FirstOrDefault();

            CurrentTransfer.details.Add(new store_transfer_detail
            {
                transferdetailcode = rowIdx++,
                transfercode = CurrentTransfer.master.transfercode,
                itemcode = itm.itemcode,
                batchno = bestBatch?.batchno ?? $"IND-{CurrentTransfer.master.indentcode}-{itm.itemcode}",
                manufacturingdate = bestBatch?.manufacturingdate ?? DateTime.Today.AddMonths(-1),
                expirydate = bestBatch?.expirydate ?? DateTime.Today.AddYears(2),
                uomcode = itm.uomcode > 0 ? itm.uomcode : 1,
                availableqty = bestBatch != null ? bestBatch.closingstock : itm.currentstock,
                requestedqty = 50,
                approvedqty = 50,
                transferqty = 50,
                unitcost = bestBatch?.unitcost > 0 ? bestBatch.unitcost : (itm.purchaserate > 0 ? itm.purchaserate : 15m),
                stockvalue = 50 * (bestBatch?.unitcost > 0 ? bestBatch.unitcost : (itm.purchaserate > 0 ? itm.purchaserate : 15m)),
                remarks = $"Pulled from Indent #{CurrentTransfer.master.indentcode}"
            });
        }

        CurrentTransfer.master.reason = $"Stock transfer fulfillment for Indent #{CurrentTransfer.master.indentcode}";
        ToastService.ShowSuccess($"Successfully pulled {CurrentTransfer.details.Count} items from Indent #{CurrentTransfer.master.indentcode}!");
    }

    private async Task SaveTransfer()
    {
        // Validation 1: Stores check
        if (CurrentTransfer.master.fromwarehousecode == 0 || CurrentTransfer.master.towarehousecode == 0)
        {
            ToastService.ShowError("Please select both Source and Destination Stores.");
            return;
        }

        if (CurrentTransfer.master.fromwarehousecode == CurrentTransfer.master.towarehousecode)
        {
            ToastService.ShowError("Source store and Destination store cannot be the same!");
            return;
        }

        // Validation 2: Items check
        if (!CurrentTransfer.details.Any() || CurrentTransfer.details.All(d => d.itemcode == 0))
        {
            ToastService.ShowError("Please add at least one valid item to transfer.");
            return;
        }

        // Validation 3: Positive Qty check
        if (CurrentTransfer.details.Any(d => d.transferqty <= 0))
        {
            ToastService.ShowWarning("Transfer quantity for all items must be greater than zero.");
            return;
        }

        // Calculate all row stock values
        foreach (var d in CurrentTransfer.details)
        {
            d.stockvalue = d.transferqty * d.unitcost;
        }

        // Save / Update locally
        if (IsEditMode)
        {
            var idx = TransferList.FindIndex(t => t.transfercode == CurrentTransfer.master.transfercode);
            if (idx >= 0)
            {
                TransferList[idx] = CurrentTransfer.master;
            }
            TransferDetailsMap[CurrentTransfer.master.transfercode] = CurrentTransfer.details;
            ToastService.ShowSuccess($"Store Transfer #{CurrentTransfer.master.transferno} updated successfully!");
        }
        else
        {
            TransferList.Insert(0, CurrentTransfer.master);
            TransferDetailsMap[CurrentTransfer.master.transfercode] = CurrentTransfer.details;
            ToastService.ShowSuccess($"Store Transfer #{CurrentTransfer.master.transferno} created & processed successfully!");
        }

        CloseTransferModal();
    }

    private void DeleteTransfer(store_transfer_header header)
    {
        TransferList.Remove(header);
        TransferDetailsMap.Remove(header.transfercode);
        ToastService.ShowInfo($"Transfer #{header.transferno} deleted.");
    }

    private void ViewTransferSlip(store_transfer_header header)
    {
        SelectedSlipTransfer = header;
        ShowSlipModal = true;
    }

    private async Task PrintTransferSlip()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private void CloseTransferModal()
    {
        ShowTransferModal = false;
        itemSearchQueries.Clear();
        activeItemSearchIndex = -1;
    }

    // Helper getters
    private string GetStoreName(long? warehousecode)
    {
        if (!warehousecode.HasValue || warehousecode == 0) return "Not Specified";
        var w = WarehouseList.FirstOrDefault(x => x.warehousecode == warehousecode);
        return w?.warehousename ?? $"Store #{warehousecode}";
    }

    private string GetItemName(long itemcode)
    {
        var itm = ItemList.FirstOrDefault(x => x.itemcode == itemcode);
        return itm?.itemname ?? $"Item #{itemcode}";
    }

    private string GetUomName(long? uomcode)
    {
        if (!uomcode.HasValue || uomcode == 0) return "Nos";
        var u = UomList.FirstOrDefault(x => x.ucode == uomcode);
        return u?.name ?? "Nos";
    }

    private int GetItemCount(long transfercode)
    {
        if (TransferDetailsMap.TryGetValue(transfercode, out var list))
        {
            return list.Count;
        }
        return 0;
    }

    private decimal GetTransferTotalValue(long transfercode)
    {
        if (TransferDetailsMap.TryGetValue(transfercode, out var list))
        {
            return list.Sum(d => d.stockvalue);
        }
        return 0;
    }

    private decimal GetTotalTransferredValue()
    {
        return TransferDetailsMap.Values.SelectMany(d => d).Sum(x => x.stockvalue);
    }

    private string GetStatusClass(string status)
    {
        return status?.ToUpper() switch
        {
            "DRAFT" => "status-draft",
            "PENDING" => "status-pending",
            "IN-TRANSIT" => "status-intransit",
            "COMPLETED" => "status-completed",
            "CANCELLED" => "status-cancelled",
            _ => "status-draft"
        };
    }

    public class ServiceResponse<T>
    {
        public bool success { get; set; }
        public string? message { get; set; }
        public T? data { get; set; }
    }
}
