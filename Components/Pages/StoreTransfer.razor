    private decimal GetTotalTransferredValue()
    {
        return TransferDetailsMap.Values.SelectMany(d => d).Sum(x => x.stockvalue);
    }

    private string GetStatusClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "status-draft";
        var s = status.Trim().ToUpperInvariant().Replace("-", "_");
        return s switch
        {
            "PENDING" => "status-pending",
            "IN_TRANSIT" or "DISPATCHED" => "status-intransit",
            "RECEIVED" or "COMPLETED" or "ACCEPTED" => "status-completed",
            "PARTIALLY_RECEIVED" or "PARTIAL" => "status-pending",
            "REJECTED" or "CANCELLED" or "RETURNED" => "status-rejected",
            _ => "status-draft"
        };
    }

