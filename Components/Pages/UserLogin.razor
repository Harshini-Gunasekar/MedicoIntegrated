@page "/user-login"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@inject IHttpClientFactory HttpClientFactory
@inject LabCare.Services.UserService UserService
@inject NavigationManager NavigationManager
@inject Booking.Services.ToastService Toast
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
<div class="login-page-container">
    <div class="login-card">
        <div class="login-header">
            <h2 class="brand-title">Medico <span class="brand-highlight">Portal</span></h2>
            <h3 class="page-title">Sign In</h3>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger p-2 mb-3" style="font-size: 0.9rem;">@errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success p-2 mb-3" style="font-size: 0.9rem;">
                <strong>@successMessage</strong><br/>
                Welcome @userName
            </div>
        }

        <div class="form-group">
            <label class="form-label">Email Address or Mobile Number</label>
            <input type="text" class="form-control custom-input" @bind="loginModel.Input" placeholder="Email Address or Mobile Number" />
        </div>

        <div class="form-group password-group">
            <div class="d-flex justify-content-between">
                <label class="form-label">Password</label>
                <a href="/forgot-password?role=staff" class="forgot-link">Forgot your password?</a>
            </div>
            <div class="password-input-wrapper">
                <input type="@passwordInputType" class="form-control custom-input" @bind="loginModel.Password" placeholder="........" />
                <button type="button" class="btn-eye" @onclick="TogglePasswordVisibility">
                    @if (showPassword)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye-off"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                    }
                </button>
            </div>
        </div>

        <div class="form-check stay-signed-in">
            <input class="form-check-input custom-checkbox" type="checkbox" id="staySignedIn" checked>
            <label class="form-check-label" for="staySignedIn">
                Stay signed in
            </label>
        </div>

        <button class="btn btn-continue" @onclick="HandleLogin" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            Continue
        </button>

        <div class="login-footer-links">
            <a href="/login" class="staff-login-link">Use Admin Login instead</a>
            <p class="register-text">New laboratory? <a href="/register" class="register-link">Register Facility</a></p>
        </div>
    </div>
    
    <div class="page-footer">
        <span>© LabCare</span>
        <a href="#">Contact</a>
        <a href="#">Privacy & terms</a>
    </div>
</div>

@code {
    private UserLoginModel loginModel = new UserLoginModel { Input = "", Password = "" };
    private string? errorMessage;
    private string? successMessage;
    private string? userName;
    private bool isLoading;
    private bool showPassword = false;
    private string passwordInputType => showPassword ? "text" : "password";

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var payload = new LIMS_Backend.Model.LoginDto 
            {
                input = loginModel.Input,
                password = loginModel.Password
            };

            var response = await UserService.LoginAsync(payload);

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[UserLogin] Raw Response: {responseContent}");
                
                var json = JObject.Parse(responseContent);
                string? token = json["token"]?.ToString() ?? json["Token"]?.ToString();
                
                var userDetailsJson = json["userdetails"] ?? json["UserDetails"] ?? json["user"] ?? json["User"];
                string? name = userDetailsJson?["name"]?.ToString() ?? userDetailsJson?["Name"]?.ToString() ?? "Staff Member";
                
                // Extract tenant_code with fallbacks
                string? tenantCode = userDetailsJson?["tenant_code"]?.ToString() 
                    ?? userDetailsJson?["tenantCode"]?.ToString() 
                    ?? userDetailsJson?["TenantCode"]?.ToString() 
                    ?? userDetailsJson?["tenantcode"]?.ToString()
                    ?? userDetailsJson?["tenant_id"]?.ToString()
                    ?? userDetailsJson?["tenantId"]?.ToString()
                    ?? userDetailsJson?["TenantId"]?.ToString();
                
                if (string.IsNullOrEmpty(tenantCode))
                {
                    var rightsArray = json["rights"] as JArray ?? json["Rights"] as JArray;
                    if (rightsArray != null && rightsArray.Count > 0)
                    {
                        foreach (var right in rightsArray)
                        {
                            var tId = right["tenant_id"]?.ToString() ?? right["tenantId"]?.ToString() ?? right["TenantId"]?.ToString() ?? right["tenant_code"]?.ToString();
                            if (!string.IsNullOrEmpty(tId))
                            {
                                tenantCode = tId;
                                break;
                            }
                        }
                    }
                }
                
                if (string.IsNullOrEmpty(tenantCode))
                {
                    tenantCode = json["tenant_code"]?.ToString() ?? json["tenant_id"]?.ToString();
                }

                if (!string.IsNullOrEmpty(tenantCode))
                {
                    successMessage = "Login successful!";
                    userName = name;
                    string safeToken = token ?? "";

                    List<UserRight> userRightsRaw = new List<UserRight>();
                    bool isUserAdmin = false;
                    string userRoleName = "";
                    var rightsArray = json["rights"] as JArray ?? json["Rights"] as JArray;
                    if (rightsArray != null)
                    {
                        userRightsRaw = rightsArray.ToObject<List<UserRight>>() ?? new List<UserRight>();
                        var firstRight = userRightsRaw.FirstOrDefault();
                        if (firstRight != null)
                        {
                            userRoleName = firstRight.RoleName ?? "";
                            if (!string.IsNullOrEmpty(firstRight.RightsJson))
                            {
                                try
                                {
                                    var rObj = Newtonsoft.Json.Linq.JObject.Parse(firstRight.RightsJson);
                                    if (rObj["IsAdmin"]?.ToObject<bool>() == true)
                                    {
                                        isUserAdmin = true;
                                    }
                                }
                                catch {}
                            }
                        }
                    }
                    var resolvedUserRights = ConvertPermissionsToUserRights(userRightsRaw);

                    int? bhCodeVal = userDetailsJson?["bhcode"]?.ToObject<int?>() ?? userDetailsJson?["bh_code"]?.ToObject<int?>();
                    int? counterCodeVal = userDetailsJson?["cntcode"]?.ToObject<int?>() ?? userDetailsJson?["cnt_code"]?.ToObject<int?>();
                    int resolvedUserCode = userDetailsJson?["usercode"]?.ToObject<int?>() ?? userDetailsJson?["user_code"]?.ToObject<int?>() ?? 0;

                    var userBranches = new List<SharedComponents.Rcl.Models.BranchModel>();
                    var branchesToken = userDetailsJson?["branches"] as JArray ?? userDetailsJson?["Branches"] as JArray;
                    if (branchesToken != null)
                    {
                        foreach (var bToken in branchesToken)
                        {
                            int resolvedBhCode = bToken["bhcode"]?.ToObject<int?>() ?? bToken["bh_code"]?.ToObject<int?>() ?? bToken["id"]?.ToObject<int?>() ?? 0;
                            if (resolvedBhCode > 0)
                            {
                                userBranches.Add(new SharedComponents.Rcl.Models.BranchModel
                                {
                                    bh_code = resolvedBhCode,
                                    name = bToken["name"]?.ToString() ?? bToken["branch_name"]?.ToString() ?? $"Branch {resolvedBhCode}"
                                });
                            }
                        }
                    }

                    bool finalIsAdmin = isUserAdmin || 
                                       string.Equals(userRoleName, "Admin", StringComparison.OrdinalIgnoreCase) || 
                                       string.Equals(userRoleName, "Administrator", StringComparison.OrdinalIgnoreCase);

                    var userDetails = new SharedComponents.Rcl.Models.UserDetailsModel
                    {
                        UserName = name,
                        Role = finalIsAdmin ? "Administrator" : (!string.IsNullOrEmpty(userRoleName) ? userRoleName : (userDetailsJson?["role"]?.ToString() ?? "0")),
                        TenantCode = tenantCode,
                        TenantName = name,
                        AuthToken = safeToken,
                        UserCode = resolvedUserCode,
                        BranchCode = bhCodeVal,
                        CounterCode = counterCodeVal,
                        Branches = userBranches,
                        Claim = null
                    };
                    
                    await _sessionStorage.SetAsync("authToken", safeToken);
                    await _sessionStorage.SetAsync("tenant_code", tenantCode);
                    await _sessionStorage.SetAsync("tenant_name", name);
                    await _sessionStorage.SetAsync("IsTenantAdmin", false);
                    if (bhCodeVal.HasValue) await _sessionStorage.SetAsync("bhcode", bhCodeVal.Value.ToString());
                    if (counterCodeVal.HasValue) await _sessionStorage.SetAsync("cntcode", counterCodeVal.Value.ToString());
                    await _sessionStorage.SetAsync("UserDetails", userDetails);
                    await _sessionStorage.SetAsync("UserRights", resolvedUserRights);
                    await _sessionStorage.SetAsync("UserBranches", userBranches);
                    var userBranchCodes = userBranches.Select(b => b.bh_code).Distinct().ToList();
                    await _sessionStorage.SetAsync("UserBranchCodes", userBranchCodes);
                    
                    TenantState.SetSession(tenantCode, safeToken, name, resolvedUserCode, bhCodeVal, counterCodeVal, userDetails, resolvedUserRights);
                    
                    Toast.ShowSuccess($"Login successful! Tenant: {tenantCode}");
                    await Task.Delay(1000);
                    NavigationManager.NavigateTo("/home");
                }
                else
                {
                    errorMessage = "Login succeeded but tenant code was empty.";
                }
            }
            else
            {
                errorMessage = $"Login failed. Status Code: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while attempting to log in: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<SharedComponents.Rcl.Models.User_Rights> ConvertPermissionsToUserRights(List<UserRight>? permissions)
    {
        var list = new List<SharedComponents.Rcl.Models.User_Rights>();
        if (permissions == null) return list;

        foreach (var p in permissions)
        {
            if (string.IsNullOrEmpty(p.RightsJson)) continue;

            try
            {
                var jObj = Newtonsoft.Json.Linq.JObject.Parse(p.RightsJson);
                var features = jObj["Features"] as Newtonsoft.Json.Linq.JObject;
                if (features == null) continue;

                foreach (var prop in features.Properties())
                {
                    var featureKey = prop.Name;
                    var access = prop.Value as Newtonsoft.Json.Linq.JObject;
                    if (access == null) continue;

                    bool view = access["View"]?.ToObject<bool>() ?? false;
                    bool create = access["Create"]?.ToObject<bool>() ?? false;
                    bool edit = access["Edit"]?.ToObject<bool>() ?? false;
                    bool delete = access["Delete"]?.ToObject<bool>() ?? false;

                    var r = new SharedComponents.Rcl.Models.User_Rights
                    {
                        Department = "",
                        ModuleName = "",
                        ToAdd = create,
                        ToView = view,
                        ToEdit = edit,
                        ToDelete = delete
                    };

                    string normKey = featureKey.Trim().ToLower();

                    if (normKey.Contains("bill_no_sequence") || normKey.Contains("bill_list") || normKey.Contains("billlist"))
                    {
                        r.Department = "Lab";
                        r.ModuleName = featureKey;
                    }
                    else if (normKey.Contains("billnoconfiguration") || normKey.Contains("sequence"))
                    {
                        r.Department = "Configuration";
                        r.ModuleName = featureKey;
                    }
                    else if (normKey.Contains("billing") || normKey.Contains("bill"))
                    {
                        r.Department = "Reception";
                        r.ModuleName = featureKey;
                    }
                    else if (normKey.Contains("due collection") || normKey.Contains("due-collection") || normKey.Contains("due_collection"))
                    {
                        r.Department = "Reception";
                        r.ModuleName = featureKey;
                    }
                    else if (normKey.Contains("doctor_patient_list") || normKey.Contains("patient_list") || normKey.Contains("sample collection"))
                    {
                        r.Department = "Lab";
                        r.ModuleName = featureKey;
                    }
                    else if (normKey.Contains("patient registration") || normKey.Contains("patientmaster") || normKey.Contains("patient"))
                    {
                        r.Department = "OP";
                        r.ModuleName = featureKey;

                        var existingIp = list.FirstOrDefault(x => x.Department == "IP" && x.ModuleName == "Patient Registration IP");
                        if (existingIp != null)
                        {
                            existingIp.ToView = existingIp.ToView || view;
                            existingIp.ToAdd = existingIp.ToAdd || create;
                            existingIp.ToEdit = existingIp.ToEdit || edit;
                            existingIp.ToDelete = existingIp.ToDelete || delete;
                        }
                        else
                        {
                            var rIp = new SharedComponents.Rcl.Models.User_Rights
                            {
                                Department = "IP",
                                ModuleName = "Patient Registration IP",
                                ToAdd = create,
                                ToView = view,
                                ToEdit = edit,
                                ToDelete = delete
                            };
                            list.Add(rIp);
                        }
                    }
                    else if (normKey.Contains("refferal master") || normKey.Contains("reception") || normKey.Contains("customer") || normKey.Contains("outpatient"))
                    {
                        r.Department = "Reception";
                        r.ModuleName = featureKey;
                    }
                    else if (normKey.Contains("result entry"))
                    {
                        r.Department = "Lab";
                        r.ModuleName = featureKey;
                    }
                    else if (normKey.Contains("print lab result") || normKey.Contains("finished reports") || normKey.Contains("report result") || normKey.Contains("bills") || normKey.Contains("billno"))
                    {
                        r.Department = "Lab";
                        r.ModuleName = featureKey;
                    }
                    else if (normKey.Contains("cash entry") || normKey.Contains("petty cash") || normKey.Contains("cash-advise") || normKey.Contains("cash advise"))
                    {
                        r.Department = "Accounts";
                        r.ModuleName = featureKey;

                        var existingPetty = list.FirstOrDefault(x => x.Department == "Accounts" && x.ModuleName == "Petty Cash");
                        if (existingPetty != null)
                        {
                            existingPetty.ToView = existingPetty.ToView || view;
                            existingPetty.ToAdd = existingPetty.ToAdd || create;
                            existingPetty.ToEdit = existingPetty.ToEdit || edit;
                            existingPetty.ToDelete = existingPetty.ToDelete || delete;
                        }
                        else
                        {
                            var rPetty = new SharedComponents.Rcl.Models.User_Rights
                            {
                                Department = "Accounts",
                                ModuleName = "Petty Cash",
                                ToAdd = create,
                                ToView = view,
                                ToEdit = edit,
                                ToDelete = delete
                            };
                            list.Add(rPetty);
                        }
                    }
                    else
                    {
                        r.Department = "Configuration";
                        r.ModuleName = featureKey;
                    }

                    if (!string.IsNullOrEmpty(r.Department) && !string.IsNullOrEmpty(r.ModuleName))
                    {
                        var existing = list.FirstOrDefault(x => x.Department == r.Department && x.ModuleName == r.ModuleName);
                        if (existing != null)
                        {
                            existing.ToView = existing.ToView || r.ToView;
                            existing.ToAdd = existing.ToAdd || r.ToAdd;
                            existing.ToEdit = existing.ToEdit || r.ToEdit;
                            existing.ToDelete = existing.ToDelete || r.ToDelete;
                        }
                        else
                        {
                            list.Add(r);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error parsing rights_json JObject: {ex.Message}");
            }
        }

        // Sync layout category view permissions for sidebar section headers
        if (list.Any(x => x.Department == "Configuration" && x.ToView))
        {
            if (!list.Any(x => x.Department == "Configuration" && x.ModuleName == "General"))
            {
                list.Add(new SharedComponents.Rcl.Models.User_Rights { Department = "Configuration", ModuleName = "General", ToView = true });
            }
        }
        if (list.Any(x => x.Department == "Reception" && x.ToView))
        {
            if (!list.Any(x => x.Department == "Reception" && x.ModuleName == "Refferal Case & Collection"))
            {
                list.Add(new SharedComponents.Rcl.Models.User_Rights { Department = "Reception", ModuleName = "Refferal Case & Collection", ToView = true });
            }
            if (!list.Any(x => x.Department == "Reception" && x.ModuleName == "Billing"))
            {
                list.Add(new SharedComponents.Rcl.Models.User_Rights { Department = "Reception", ModuleName = "Billing", ToView = true });
            }
            if (!list.Any(x => x.Department == "Reception" && x.ModuleName == "Due Collection"))
            {
                list.Add(new SharedComponents.Rcl.Models.User_Rights { Department = "Reception", ModuleName = "Due Collection", ToView = true });
            }
        }
        if (list.Any(x => x.Department == "Lab" && x.ToView))
        {
            if (!list.Any(x => x.Department == "Lab" && x.ModuleName == "Print Lab Result"))
            {
                list.Add(new SharedComponents.Rcl.Models.User_Rights { Department = "Lab", ModuleName = "Print Lab Result", ToView = true });
            }
            if (!list.Any(x => x.Department == "Lab" && x.ModuleName == "Lab Study"))
            {
                list.Add(new SharedComponents.Rcl.Models.User_Rights { Department = "Lab", ModuleName = "Lab Study", ToView = true });
            }
        }
        if (list.Any(x => x.Department == "OP" && x.ToView))
        {
            if (!list.Any(x => x.Department == "OP" && x.ModuleName == "Patient Registration OP"))
            {
                list.Add(new SharedComponents.Rcl.Models.User_Rights { Department = "OP", ModuleName = "Patient Registration OP", ToView = true });
            }
        }

        return list;
    }

    public class UserLoginModel
    {
        public string Input { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public class UserLoginResponse
    {
        [JsonPropertyName("token")]
        public string Token { get; set; } = "";

        [JsonPropertyName("userdetails")]
        public UserDetails? UserDetails { get; set; }

        [JsonPropertyName("rights")]
        public List<UserRight>? Rights { get; set; }
    }

    public class UserDetails
    {
        [JsonPropertyName("usercode")]
        public int UserCode { get; set; }
        
        [JsonPropertyName("name")]
        public string Name { get; set; } = "";
        
        [JsonPropertyName("shortname")]
        public string? ShortName { get; set; }

        [JsonPropertyName("description")]
        public string? Description { get; set; }

        [JsonPropertyName("email")]
        public string? Email { get; set; }
        
        [JsonPropertyName("mobile")]
        public string? Mobile { get; set; }
        
        [JsonPropertyName("poweruser")]
        public bool PowerUser { get; set; }

        [JsonPropertyName("tenant_code")]
        public string? TenantCode { get; set; }
    }

    public class UserRight
    {
        [JsonProperty("id")]
        [JsonPropertyName("id")]
        public int Id { get; set; }

        [JsonProperty("user_id")]
        [JsonPropertyName("user_id")]
        public int UserId { get; set; }

        [JsonProperty("tenant_id")]
        [JsonPropertyName("tenant_id")]
        public string? TenantId { get; set; }

        [JsonProperty("product_id")]
        [JsonPropertyName("product_id")]
        public string? ProductId { get; set; }

        [JsonProperty("role_name")]
        [JsonPropertyName("role_name")]
        public string? RoleName { get; set; }

        [JsonProperty("rights_json")]
        [JsonPropertyName("rights_json")]
        public string? RightsJson { get; set; }

        [JsonProperty("modified_date")]
        [JsonPropertyName("modified_date")]
        public DateTime? ModifiedDate { get; set; }
    }
}




