            await _sessionStorage.SetAsync("user_name", displayName);
            await _sessionStorage.SetAsync("login_input", displayName);
            await _sessionStorage.SetAsync("user_role", "Administrator");
            await _sessionStorage.SetAsync("user_code", 1);
            await _sessionStorage.SetAsync("IsTenantAdmin", true);
            await _sessionStorage.DeleteAsync("bhcode");
            await _sessionStorage.SetAsync("UserDetails", userDetails);
            await _sessionStorage.SetAsync("UserRights", defaultRights);

            try
            {
                var crossTabSession = new
                {
                    authToken = safeToken,
                    tenant_code = tenantCode,
                    tenant_name = "Medico Healthcare Hospital",
                    user_name = displayName,
                    login_input = displayName,
                    user_role = "Administrator",
                    user_code = 1,
                    bhcode = (int?)null,
                    cntcode = 1,
                    isAdmin = true,
                    session_branch_confirmed = false
                };
                await JSRuntime.InvokeVoidAsync("medicoSessionHelper.saveSession", JsonConvert.SerializeObject(crossTabSession));
