    private void AddOrUpdateRight(List<SharedComponents.Rcl.Models.User_Rights> list, string dept, string module, bool view, bool create, bool edit, bool delete, bool export)
    {
        if (string.IsNullOrEmpty(module)) return;
        var existing = list.FirstOrDefault(x => string.Equals(x.Department, dept, StringComparison.OrdinalIgnoreCase) && 
                                                string.Equals(x.ModuleName, module, StringComparison.OrdinalIgnoreCase));
        if (existing != null)
        {
            existing.ToView = existing.ToView || view;
            existing.ToAdd = existing.ToAdd || create;
            existing.ToEdit = existing.ToEdit || edit;
            existing.ToDelete = existing.ToDelete || delete;
            existing.ToExport = existing.ToExport || export;
        }
        else
        {
            list.Add(new SharedComponents.Rcl.Models.User_Rights
            {
                Department = dept,
                ModuleName = module,
                ToView = view,
                ToAdd = create,
                ToEdit = edit,
                ToDelete = delete,
                ToExport = export
            });
        }
    }

