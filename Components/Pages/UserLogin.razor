    private async Task<bool> TryAdminLoginAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("LabCareUrl");
            var payload = new 
            {
                email = loginModel.Input,
                password = loginModel.Password
            };

            var response = await client.PostAsJsonAsync("api/Tenant/login", payload);
            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[AdminLoginFallback] Raw Response: {responseContent}");
                
                var json = JObject.Parse(responseContent);
                string? token = json["token"]?.ToString() ?? json["Token"]?.ToString() ?? json["token_key"]?.ToString();
                
                string? tenantCodeVal = json["tenant_Code"]?.ToString() 
                    ?? json["tenant_code"]?.ToString() 
                    ?? json["Tenant_Code"]?.ToString()
                    ?? json["tenantCode"]?.ToString()
                    ?? json["TenantCode"]?.ToString()
                    ?? json["tenantcode"]?.ToString()
                    ?? json["tenant_id"]?.ToString()
                    ?? json["Tenant_Id"]?.ToString();
                    
                string? tenantNameVal = json["tenant_Name"]?.ToString() 
                    ?? json["tenant_name"]?.ToString() 
                    ?? json["Tenant_Name"]?.ToString()
                    ?? json["tenantName"]?.ToString()
                    ?? json["TenantName"]?.ToString();

                if (!string.IsNullOrEmpty(tenantCodeVal))
                {
                    successMessage = "Login successful!";
                    
                    string inputDisplayName = (!string.IsNullOrWhiteSpace(loginModel.Input)) 
                        ? (loginModel.Input.Contains("@") ? loginModel.Input.Split('@')[0] : loginModel.Input) 
                        : "Administrator";

                    userName = inputDisplayName;
                    string safeToken = token ?? "";
                    
                    string tenantCleanName = (!string.IsNullOrWhiteSpace(tenantNameVal) && !string.Equals(tenantNameVal.Trim(), "Main branch", StringComparison.OrdinalIgnoreCase))
                        ? tenantNameVal.Trim()
                        : "Medico Healthcare Hospital";

                    var userDetails = new SharedComponents.Rcl.Models.UserDetailsModel
                    {
                        UserName = userName,
                        Role = "Administrator",
                        TenantCode = tenantCodeVal,
                        TenantName = tenantCleanName,
                        AuthToken = safeToken,
                        UserCode = 0,
                        BranchCode = null,
                        CounterCode = null,
                        Claim = null
                    };

                    var adminPerms = RoleCatalogDefaults.GetDefaultPermissions();
                    RoleService.SetUserPermissions(adminPerms);
                    await _sessionStorage.SetAsync("UserRolePermissions", adminPerms);
                    var adminRights = RoleMasterService.ConvertEffectivePermissionsToUserRights(adminPerms, 0);

                    await _sessionStorage.SetAsync("authToken", safeToken);
                    await _sessionStorage.SetAsync("tenant_code", tenantCodeVal);
                    await _sessionStorage.SetAsync("tenant_name", tenantCleanName);
                    await _sessionStorage.SetAsync("user_name", userName);
                    await _sessionStorage.SetAsync("login_input", userName);
                    await _sessionStorage.SetAsync("user_role", "Administrator");
                    await _sessionStorage.SetAsync("user_code", 0);
                    await _sessionStorage.SetAsync("IsTenantAdmin", true);
                    await _sessionStorage.DeleteAsync("bhcode");
                    await _sessionStorage.SetAsync("UserDetails", userDetails);
                    await _sessionStorage.SetAsync("UserRights", adminRights);
                    
                    try
                    {
                        var crossTabSession = new
                        {
                            authToken = safeToken,
                            tenant_code = tenantCodeVal,
                            tenant_name = tenantCleanName,
                            user_name = userName,
                            login_input = userName,
                            user_role = "Administrator",
                            user_code = 0,
                            bhcode = (int?)null,
                            cntcode = (int?)null,
                            isAdmin = true,
                            session_branch_confirmed = false
                        };
                        await JSRuntime.InvokeVoidAsync("medicoSessionHelper.saveSession", JsonConvert.SerializeObject(crossTabSession));
                    }
                    catch { }

                    TenantState.SetSession(tenantCodeVal, safeToken, tenantCleanName, 0, null, null, userDetails, adminRights);
                    
                    Toast.ShowSuccess($"Admin login successful!");
                    await Task.Delay(1000);
                    NavigationManager.NavigateTo("/home", replace: true);
                    return true;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminLoginFallback] Exception: {ex.Message}");
        }
        return false;
    }

    private string ExtractErrorMessage(string responseContent)
    {
        if (string.IsNullOrWhiteSpace(responseContent)) return string.Empty;
        try
        {
            var json = JObject.Parse(responseContent);
            string? msg = json["message"]?.ToString() 
                ?? json["Message"]?.ToString() 
                ?? json["error"]?.ToString() 
                ?? json["Error"]?.ToString() 
                ?? json["detail"]?.ToString() 
                ?? json["title"]?.ToString();
                
            if (!string.IsNullOrEmpty(msg)) return msg;
        }
        catch
        {
            if (responseContent.Length < 200 && !responseContent.StartsWith("<"))
            {
                return responseContent.Trim();
            }
        }
        return string.Empty;
    }

    private static bool IsSampleBranch(string? name, string? shortName, int code)
    {
        if (code <= 0) return true;
        if (!string.IsNullOrWhiteSpace(name))
        {
            var n = name.Trim();
            if (n.Contains("sample", StringComparison.OrdinalIgnoreCase)) return true;
            if (n.Contains("smpl", StringComparison.OrdinalIgnoreCase)) return true;
            if (n.Contains("dummy", StringComparison.OrdinalIgnoreCase)) return true;
        }
        if (!string.IsNullOrWhiteSpace(shortName))
        {
            var s = shortName.Trim();
            if (s.Contains("sample", StringComparison.OrdinalIgnoreCase)) return true;
            if (s.Contains("smpl", StringComparison.OrdinalIgnoreCase)) return true;
            if (s.Contains("dummy", StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

