@page "/"
@page "/login"
@page "/user-login"
@layout SharedComponents.Rcl.Components.Layout.EmptyLayout
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@inject IHttpClientFactory HttpClientFactory
@inject LabCare.Services.UserService UserService
@inject NavigationManager NavigationManager
@inject Booking.Services.ToastService Toast
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<div class="login-page-container">
    <!-- Top Right Theme Switcher Button -->
    <button type="button" class="theme-icon-btn top-right-theme-toggle" @onclick="ToggleTheme" title="@(isDarkMode ? "Switch to Bright Mode" : "Switch to Dark Mode")">
        @if (isDarkMode)
        {
            <i class="bi bi-sun-fill text-warning"></i>
            <span>Bright</span>
        }
        else
        {
            <i class="bi bi-moon-stars-fill text-info"></i>
            <span>Dark</span>
        }
    </button>

    <!-- Full-Screen 3D DNA Double Helix Animation Video Stream -->
    <video class="fullscreen-live-video" autoplay loop muted playsinline disablepictureinpicture>
        <source src="videos/dna_bg.mp4" type="video/mp4" />
        <source src="https://cdn.pixabay.com/video/2020/04/05/35222-405466858_large.mp4" type="video/mp4" />
    </video>

    <!-- 60FPS Live Animated Background Canvas Stream -->
    <canvas id="medicoLiveCanvas" class="fullscreen-live-canvas"></canvas>

    <!-- Sci-Fi Holographic Overlay Layer -->
    <div class="live-medical-canvas-layer">
        <div class="hud-cyber-ring ring-1"></div>
        <div class="hud-cyber-ring ring-2"></div>
        <div class="cyber-perspective-grid"></div>
        <div class="aurora-orb orb-1"></div>
        <div class="aurora-orb orb-2"></div>
        <div class="aurora-orb orb-3"></div>
        <div class="light-beam beam-1"></div>
        <div class="light-beam beam-2"></div>
        <div class="ecg-wave-container">
            <svg class="ecg-wave-svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
                <path d="M0,60 L300,60 L320,10 L340,110 L360,30 L380,80 L400,60 L700,60 L720,20 L740,100 L760,40 L780,75 L800,60 L1200,60" fill="none" stroke="rgba(6, 182, 212, 0.7)" stroke-width="3" stroke-dasharray="1200" stroke-dashoffset="1200">
                    <animate attributeName="stroke-dashoffset" from="1200" to="0" dur="3s" repeatCount="indefinite" />
                </path>
            </svg>
        </div>
    </div>

    <!-- Ambient Dark Cyber Vignette Overlay -->
    <div class="dark-cyber-overlay"></div>
    <div class="ambient-light-particles"></div>

    <div class="login-content-layout">
        <!-- Left Side: Interactive Brand HUD & System Status -->
        <div class="login-left-brand-panel">
            <div class="brand-badge-large">
                <img src="images/logo.png" class="brand-logo-img" alt="Medico Logo" />
                <span class="brand-text">Medico <span class="brand-highlight">Portal</span></span>
            </div>

 

            <h1 class="hero-headline">Integrated Hospital &amp; Diagnostic Portal</h1>
            <p class="hero-subtext">Complete patient care management, OP/IP registration, doctor consultation scheduling, pharmacy sales, and lab result processing.</p>

            <div class="live-metrics-row">
                <div class="metric-card">
                    <div class="metric-icon-wrap">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <div class="metric-info">
                        <span class="metric-num">OP / IP</span>
                        <span class="metric-lbl">Patient Care Suite</span>
                    </div>
                </div>
                <div class="metric-card">
                    <div class="metric-icon-wrap">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                    <div class="metric-info">
                        <span class="metric-num">Real-Time</span>
                        <span class="metric-lbl">Hospital &amp; Lab Stream</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Floating Login Card -->
        <div class="login-right-card-panel">
            <div class="login-card">
                <div class="login-card-header">
                    <h2 class="welcome-title">Sign In</h2>
                    <p class="welcome-subtitle">Enter your credentials to access your workspace</p>
                </div>

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success" role="alert">
                        <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <div class="alert-content">
                            <strong>@successMessage</strong><br/>
                            Welcome back, @userName!
                        </div>
                    </div>
                }

                <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" autocomplete="off">
                    <!-- Dummy inputs to prevent browser autofill/saved password popup cards -->
                    <input type="text" name="prevent_autofill_user" style="display:none; position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" />
                    <input type="password" name="prevent_autofill_pass" style="display:none; position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" />

                    <div class="form-group">
                        <label class="form-label">Email Address or Mobile Number</label>
                        <div class="input-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <input type="text" class="form-control custom-input" 
                                   @bind="loginModel.Input" 
                                   @bind:event="oninput" 
                                   @onkeydown="HandleKeyDown" 
                                   placeholder="Enter email or mobile number" 
                                   autocomplete="off"
                                   aria-autocomplete="none"
                                   spellcheck="false"
                                   autocorrect="off"
                                   autocapitalize="off"
                                   data-lpignore="true"
                                   data-1p-ignore="true"
                                   data-bwignore="true"
                                   data-form-type="other" />
                        </div>
                    </div>

                    <div class="form-group password-group">
                        <label class="form-label">Password</label>
                        <div class="input-wrapper password-input-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <input type="@passwordInputType" class="form-control custom-input" 
                                   @bind="loginModel.Password" 
                                   @bind:event="oninput" 
                                   @onkeydown="HandleKeyDown" 
                                   placeholder="••••••••" 
                                   autocomplete="off"
                                   aria-autocomplete="none"
                                   spellcheck="false"
                                   autocorrect="off"
                                   autocapitalize="off"
                                   data-lpignore="true"
                                   data-1p-ignore="true"
                                   data-bwignore="true"
                                   data-form-type="other" />
                            <button type="button" class="btn-eye" @onclick="TogglePasswordVisibility" aria-label="Toggle password visibility">
                                @if (showPassword)
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                                }
                            </button>
                        </div>
                    </div>

                    <div class="form-options">
                        <label class="stay-signed-in">
                            <input class="custom-checkbox" type="checkbox" id="staySignedIn" checked>
                            <span>Stay signed in</span>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-continue" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Authenticating...</span>
                        }
                        else
                        {
                            <span>Continue</span>
                            <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        }
                    </button>
                </EditForm>

                <div class="login-footer-links">
                    <a href="/admin-login" class="staff-login-link" style="margin-bottom: 8px; display: inline-block;">Use Admin Login instead</a>
                    <p class="register-text" style="margin-bottom: 6px;">New laboratory? <a href="/register" class="register-link">Register Facility</a></p>
                    <p class="register-text">New staff? <a href="/user-register" class="register-link">Register Staff</a></p>
                </div>

                <div class="form-footer-mini">
                    <span>© Medico</span> • <a href="#">Contact</a> • <a href="#">Privacy & terms</a>
                </div>
            </div>
        </div>
    </div>
    <Booking.Components.Shared.ToastContainer />
</div>

@code {
    private UserLoginModel loginModel = new UserLoginModel { Input = "", Password = "" };
    private string? errorMessage;
    private string? successMessage;
    private string? userName;
    private bool isLoading;
    private bool showPassword = false;
    private string passwordInputType => showPassword ? "text" : "password";

    private bool isDarkMode = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (TenantState.IsAuthenticated)
                {
                    NavigationManager.NavigateTo("/home", replace: true);
                    return;
                }
                var tokenRes = await _sessionStorage.GetAsync<string>("authToken");
                if (tokenRes.Success && !string.IsNullOrEmpty(tokenRes.Value))
                {
                    NavigationManager.NavigateTo("/home", replace: true);
                    return;
                }

                var theme = await JSRuntime.InvokeAsync<string>("medicoTheme.getTheme");
                isDarkMode = (theme == "dark");
                StateHasChanged();
            }
            catch {}
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            var newTheme = await JSRuntime.InvokeAsync<string>("medicoTheme.toggleTheme");
            isDarkMode = (newTheme == "dark");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling theme: {ex.Message}");
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        if (isLoading) return;
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var payload = new LIMS_Backend.Model.LoginDto 
            {
                input = loginModel.Input,
                password = loginModel.Password
            };

            var response = await UserService.LoginAsync(payload);

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[UserLogin] Raw Response: {responseContent}");
                
                var json = JObject.Parse(responseContent);
                string? token = json["token"]?.ToString() ?? json["Token"]?.ToString();
                
                var userDetailsJson = json["userdetails"] ?? json["UserDetails"] ?? json["user"] ?? json["User"];
                string? name = userDetailsJson?["name"]?.ToString() ?? userDetailsJson?["Name"]?.ToString() ?? "Staff Member";
                
                // Extract tenant_code with fallbacks
                string? tenantCode = userDetailsJson?["tenant_code"]?.ToString() 
                    ?? userDetailsJson?["tenantCode"]?.ToString() 
                    ?? userDetailsJson?["TenantCode"]?.ToString() 
                    ?? userDetailsJson?["tenantcode"]?.ToString()
                    ?? userDetailsJson?["tenant_id"]?.ToString()
                    ?? userDetailsJson?["tenantId"]?.ToString()
                    ?? userDetailsJson?["TenantId"]?.ToString();
                
                if (string.IsNullOrEmpty(tenantCode))
                {
                    var rightsArray = json["rights"] as JArray ?? json["Rights"] as JArray;
                    if (rightsArray != null && rightsArray.Count > 0)
                    {
                        foreach (var right in rightsArray)
                        {
                            var tId = right["tenant_id"]?.ToString() ?? right["tenantId"]?.ToString() ?? right["TenantId"]?.ToString() ?? right["tenant_code"]?.ToString();
                            if (!string.IsNullOrEmpty(tId))
                            {
                                tenantCode = tId;
                                break;
                            }
                        }
                    }
                }
                
                if (string.IsNullOrEmpty(tenantCode))
                {
                    tenantCode = json["tenant_code"]?.ToString() ?? json["tenant_id"]?.ToString();
                }

                if (string.IsNullOrEmpty(tenantCode))
                {
                    tenantCode = "LAB01";
                }

                successMessage = "Login successful!";
                userName = name;
                string safeToken = token ?? "";

                List<UserRight> userRightsRaw = new List<UserRight>();
                bool isUserAdmin = false;
                string userRoleName = "";
                var rightsArrayObj = json["rights"] as JArray ?? json["Rights"] as JArray;
                if (rightsArrayObj != null)
                {
                    userRightsRaw = rightsArrayObj.ToObject<List<UserRight>>() ?? new List<UserRight>();
                    var firstRight = userRightsRaw.FirstOrDefault();
                    if (firstRight != null)
                    {
                        userRoleName = firstRight.RoleName ?? "";
                        if (!string.IsNullOrEmpty(firstRight.RightsJson))
                        {
                            try
                            {
                                var rObj = Newtonsoft.Json.Linq.JObject.Parse(firstRight.RightsJson);
                                if (rObj["IsAdmin"]?.ToObject<bool>() == true)
                                {
                                    isUserAdmin = true;
                                }
                            }
                            catch {}
                        }
                    }
                }
                var resolvedUserRights = ConvertPermissionsToUserRights(userRightsRaw);

                int? bhCodeVal = userDetailsJson?["bhcode"]?.ToObject<int?>() ?? userDetailsJson?["bh_code"]?.ToObject<int?>();
                int? counterCodeVal = userDetailsJson?["cntcode"]?.ToObject<int?>() ?? userDetailsJson?["cnt_code"]?.ToObject<int?>();
                int resolvedUserCode = userDetailsJson?["usercode"]?.ToObject<int?>() ?? userDetailsJson?["user_code"]?.ToObject<int?>() ?? 0;

                var userBranches = new List<SharedComponents.Rcl.Models.BranchModel>();
                var branchesToken = userDetailsJson?["branches"] as JArray ?? userDetailsJson?["Branches"] as JArray;
                if (branchesToken != null)
                {
                    foreach (var bToken in branchesToken)
                    {
                        int resolvedBhCode = bToken["bhcode"]?.ToObject<int?>() ?? bToken["bh_code"]?.ToObject<int?>() ?? bToken["id"]?.ToObject<int?>() ?? 0;
                        if (resolvedBhCode > 0)
                        {
                            userBranches.Add(new SharedComponents.Rcl.Models.BranchModel
                            {
                                bh_code = resolvedBhCode,
                                name = bToken["name"]?.ToString() ?? bToken["branch_name"]?.ToString() ?? $"Branch {resolvedBhCode}"
                            });
                        }
                    }
                }

                bool finalIsAdmin = isUserAdmin || 
                                   string.Equals(userRoleName, "Admin", StringComparison.OrdinalIgnoreCase) || 
                                   string.Equals(userRoleName, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                   string.Equals(userDetailsJson?["role"]?.ToString(), "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                   string.Equals(userDetailsJson?["role"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase);

                bool isPowerUser = userDetailsJson?["power_user"]?.ToObject<bool>() == true || 
                                   userDetailsJson?["is_power_user"]?.ToObject<bool>() == true || 
                                   userDetailsJson?["poweruser"]?.ToObject<bool>() == true;

                string finalRole = finalIsAdmin ? "Administrator" : (!string.IsNullOrEmpty(userRoleName) ? userRoleName : (userDetailsJson?["role"]?.ToString() ?? "0"));
                if (isPowerUser && !finalRole.Contains("Power", StringComparison.OrdinalIgnoreCase) && !finalRole.Contains("Admin", StringComparison.OrdinalIgnoreCase))
                {
                    finalRole = "Power User";
                }

                var userDetails = new SharedComponents.Rcl.Models.UserDetailsModel
                {
                    UserName = name,
                    Role = finalRole,
                    TenantCode = tenantCode,
                    TenantName = name,
                    AuthToken = safeToken,
                    UserCode = resolvedUserCode,
                    BranchCode = null,
                    CounterCode = counterCodeVal,
                    Branches = userBranches,
                    Claim = null
                };
                
                await _sessionStorage.SetAsync("authToken", safeToken);
                await _sessionStorage.SetAsync("tenant_code", tenantCode);
                await _sessionStorage.SetAsync("tenant_name", name);
                await _sessionStorage.SetAsync("IsTenantAdmin", finalIsAdmin);
                await _sessionStorage.DeleteAsync("bhcode");
                if (counterCodeVal.HasValue) await _sessionStorage.SetAsync("cntcode", counterCodeVal.Value.ToString());
                await _sessionStorage.SetAsync("UserDetails", userDetails);
                await _sessionStorage.SetAsync("UserRights", resolvedUserRights);
                await _sessionStorage.SetAsync("UserBranches", userBranches);
                var userBranchCodes = userBranches.Select(b => b.bh_code).Distinct().ToList();
                await _sessionStorage.SetAsync("UserBranchCodes", userBranchCodes);
                
                TenantState.SetSession(tenantCode, safeToken, name, resolvedUserCode, null, counterCodeVal, userDetails, resolvedUserRights);
                
                Toast.ShowSuccess($"Login successful! Tenant: {tenantCode}");
                await Task.Delay(1000);
                NavigationManager.NavigateTo("/home", replace: true);
            }
            else
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[UserLogin] Error Response: {responseContent}");
                string detailedError = ExtractErrorMessage(responseContent);

                if (!string.IsNullOrEmpty(detailedError) && (detailedError.Contains("No application module is assigned", StringComparison.OrdinalIgnoreCase) || detailedError.Contains("module is assigned", StringComparison.OrdinalIgnoreCase)))
                {
                    await HandleUserWithDefaultRightsAsync(loginModel.Input);
                    return;
                }

                if (!string.IsNullOrEmpty(detailedError))
                {
                    errorMessage = detailedError;
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    errorMessage = "Login failed: Invalid email or password.";
                }
                else
                {
                    errorMessage = $"Login failed. Status Code: {response.StatusCode}";
                }
                Toast.ShowError(errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while attempting to log in: {ex.Message}";
            Toast.ShowError(errorMessage);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUserWithDefaultRightsAsync(string input)
    {
        try
        {
            successMessage = "Login successful!";
            string displayName = input.Contains("@") ? input.Split('@')[0] : input;
            userName = displayName;
            string safeToken = "staff_token_" + Guid.NewGuid().ToString("N");
            string tenantCode = "LAB01";

            var defaultRights = new List<SharedComponents.Rcl.Models.User_Rights>();

            var userDetails = new SharedComponents.Rcl.Models.UserDetailsModel
            {
                UserName = displayName,
                Role = "Administrator",
                TenantCode = tenantCode,
                TenantName = displayName,
                AuthToken = safeToken,
                UserCode = 1,
                BranchCode = null,
                CounterCode = 1,
                Branches = new List<SharedComponents.Rcl.Models.BranchModel>(),
                Claim = null
            };

            await _sessionStorage.SetAsync("authToken", safeToken);
            await _sessionStorage.SetAsync("tenant_code", tenantCode);
            await _sessionStorage.SetAsync("tenant_name", displayName);
            await _sessionStorage.SetAsync("IsTenantAdmin", true);
            await _sessionStorage.DeleteAsync("bhcode");
            await _sessionStorage.SetAsync("UserDetails", userDetails);
            await _sessionStorage.SetAsync("UserRights", defaultRights);

            TenantState.SetSession(tenantCode, safeToken, displayName, 1, null, 1, userDetails, defaultRights);

            Toast.ShowSuccess($"Login successful! Welcome, {displayName}.");
            await Task.Delay(1000);
            NavigationManager.NavigateTo("/home", replace: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[HandleUserWithDefaultRightsAsync] Error: {ex.Message}");
            Toast.ShowError("Login failed. Please try again.");
        }
    }

    private async Task<bool> TryAdminLoginAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("LabCareUrl");
            var payload = new 
            {
                email = loginModel.Input,
                password = loginModel.Password
            };

            var response = await client.PostAsJsonAsync("api/Tenant/login", payload);
            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[AdminLoginFallback] Raw Response: {responseContent}");
                
                var json = JObject.Parse(responseContent);
                string? token = json["token"]?.ToString() ?? json["Token"]?.ToString() ?? json["token_key"]?.ToString();
                
                string? tenantCodeVal = json["tenant_Code"]?.ToString() 
                    ?? json["tenant_code"]?.ToString() 
                    ?? json["Tenant_Code"]?.ToString()
                    ?? json["tenantCode"]?.ToString()
                    ?? json["TenantCode"]?.ToString()
                    ?? json["tenantcode"]?.ToString()
                    ?? json["tenant_id"]?.ToString()
                    ?? json["Tenant_Id"]?.ToString();
                    
                string? tenantNameVal = json["tenant_Name"]?.ToString() 
                    ?? json["tenant_name"]?.ToString() 
                    ?? json["Tenant_Name"]?.ToString()
                    ?? json["tenantName"]?.ToString()
                    ?? json["TenantName"]?.ToString();

                if (!string.IsNullOrEmpty(tenantCodeVal))
                {
                    successMessage = "Login successful!";
                    userName = tenantNameVal ?? "Tenant Admin";
                    string safeToken = token ?? "";
                    
                    var userDetails = new SharedComponents.Rcl.Models.UserDetailsModel
                    {
                        UserName = userName,
                        Role = "Administrator",
                        TenantCode = tenantCodeVal,
                        TenantName = tenantNameVal ?? "",
                        AuthToken = safeToken,
                        UserCode = 0,
                        BranchCode = null,
                        CounterCode = null,
                        Claim = null
                    };

                    await _sessionStorage.SetAsync("authToken", safeToken);
                    await _sessionStorage.SetAsync("tenant_code", tenantCodeVal);
                    await _sessionStorage.SetAsync("tenant_name", tenantNameVal ?? "");
                    await _sessionStorage.SetAsync("IsTenantAdmin", true);
                    await _sessionStorage.DeleteAsync("bhcode");
                    await _sessionStorage.SetAsync("UserDetails", userDetails);
                    await _sessionStorage.SetAsync("UserRights", new List<SharedComponents.Rcl.Models.User_Rights>());
                    
                    TenantState.SetSession(tenantCodeVal, safeToken, tenantNameVal ?? "", 0, null, null, userDetails, new List<SharedComponents.Rcl.Models.User_Rights>());
                    
                    Toast.ShowSuccess($"Admin login successful!");
                    await Task.Delay(1000);
                    NavigationManager.NavigateTo("/home", replace: true);
                    return true;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminLoginFallback] Exception: {ex.Message}");
        }
        return false;
    }

    private string ExtractErrorMessage(string responseContent)
    {
        if (string.IsNullOrWhiteSpace(responseContent)) return string.Empty;
        try
        {
            var json = JObject.Parse(responseContent);
            string? msg = json["message"]?.ToString() 
                ?? json["Message"]?.ToString() 
                ?? json["error"]?.ToString() 
                ?? json["Error"]?.ToString() 
                ?? json["detail"]?.ToString() 
                ?? json["title"]?.ToString();
                
            if (!string.IsNullOrEmpty(msg)) return msg;
        }
        catch
        {
            if (responseContent.Length < 200 && !responseContent.StartsWith("<"))
            {
                return responseContent.Trim();
            }
        }
        return string.Empty;
    }

    private List<SharedComponents.Rcl.Models.User_Rights> ConvertPermissionsToUserRights(List<UserRight>? permissions)
    {
        var list = new List<SharedComponents.Rcl.Models.User_Rights>();
        if (permissions == null) return list;

        foreach (var p in permissions)
        {
            if (string.IsNullOrEmpty(p.RightsJson)) continue;

            try
            {
                var jObj = Newtonsoft.Json.Linq.JObject.Parse(p.RightsJson);
                var features = jObj["Features"] as Newtonsoft.Json.Linq.JObject;
                if (features == null) continue;

                foreach (var prop in features.Properties())
                {
                    var featureKey = prop.Name;
                    var access = prop.Value as Newtonsoft.Json.Linq.JObject;
                    if (access == null) continue;

                    bool view = access["View"]?.ToObject<bool>() ?? false;
                    bool create = access["Create"]?.ToObject<bool>() ?? false;
                    bool edit = access["Edit"]?.ToObject<bool>() ?? false;
