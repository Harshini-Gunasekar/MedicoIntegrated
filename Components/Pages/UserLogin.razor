@page "/"
@page "/login"
@page "/user-login"
@layout SharedComponents.Rcl.Components.Layout.EmptyLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@inject IHttpClientFactory HttpClientFactory
@inject LabCare.Services.UserService UserService
@inject NavigationManager NavigationManager
@inject Booking.Services.ToastService Toast
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Booking.Services.RoleMasterService RoleService

<div class="login-page-container">
    <!-- Top Right Theme Switcher Button -->
    <button type="button" class="theme-icon-btn top-right-theme-toggle" @onclick="ToggleTheme" title="@(isDarkMode ? "Switch to Bright Mode" : "Switch to Dark Mode")">
        @if (isDarkMode)
        {
            <i class="bi bi-sun-fill text-warning"></i>
            <span>Bright</span>
        }
        else
        {
            <i class="bi bi-moon-stars-fill text-info"></i>
            <span>Dark</span>
        }
    </button>

    <!-- Full-Screen 3D DNA Double Helix Animation Video Stream -->
    <video class="fullscreen-live-video" autoplay loop muted playsinline disablepictureinpicture>
        <source src="videos/dna_bg.mp4" type="video/mp4" />
        <source src="https://cdn.pixabay.com/video/2020/04/05/35222-405466858_large.mp4" type="video/mp4" />
    </video>

    <!-- 60FPS Live Animated Background Canvas Stream -->
    <canvas id="medicoLiveCanvas" class="fullscreen-live-canvas"></canvas>

    <!-- Sci-Fi Holographic Overlay Layer -->
    <div class="live-medical-canvas-layer">
        <div class="hud-cyber-ring ring-1"></div>
        <div class="hud-cyber-ring ring-2"></div>
        <div class="cyber-perspective-grid"></div>
        <div class="aurora-orb orb-1"></div>
        <div class="aurora-orb orb-2"></div>
        <div class="aurora-orb orb-3"></div>
        <div class="light-beam beam-1"></div>
        <div class="light-beam beam-2"></div>
        <div class="ecg-wave-container">
            <svg class="ecg-wave-svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
                <path d="M0,60 L300,60 L320,10 L340,110 L360,30 L380,80 L400,60 L700,60 L720,20 L740,100 L760,40 L780,75 L800,60 L1200,60" fill="none" stroke="rgba(6, 182, 212, 0.7)" stroke-width="3" stroke-dasharray="1200" stroke-dashoffset="1200">
                    <animate attributeName="stroke-dashoffset" from="1200" to="0" dur="3s" repeatCount="indefinite" />
                </path>
            </svg>
        </div>
    </div>

    <!-- Ambient Dark Cyber Vignette Overlay -->
    <div class="dark-cyber-overlay"></div>
    <div class="ambient-light-particles"></div>

    <div class="login-content-layout">
        <!-- Left Side: Interactive Brand HUD & System Status -->
        <div class="login-left-brand-panel">
            <div class="brand-badge-large">
                <img src="images/logo.png" class="brand-logo-img" alt="Medico Logo" />
                <span class="brand-text">Medico <span class="brand-highlight">Portal</span></span>
            </div>

 

            <h1 class="hero-headline">Integrated Hospital &amp; Diagnostic Portal</h1>
            <p class="hero-subtext">Complete patient care management, OP/IP registration, doctor consultation scheduling, pharmacy sales, and lab result processing.</p>

            <div class="live-metrics-row">
                <div class="metric-card">
                    <div class="metric-icon-wrap">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <div class="metric-info">
                        <span class="metric-num">OP / IP</span>
                        <span class="metric-lbl">Patient Care Suite</span>
                    </div>
                </div>
                <div class="metric-card">
                    <div class="metric-icon-wrap">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                    <div class="metric-info">
                        <span class="metric-num">Real-Time</span>
                        <span class="metric-lbl">Hospital &amp; Lab Stream</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Floating Login Card -->
        <div class="login-right-card-panel">
            <div class="login-card">
                <div class="login-card-header">
                    <h2 class="welcome-title">Sign In</h2>
                    <p class="welcome-subtitle">Enter your credentials to access your workspace</p>
                </div>

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success" role="alert">
                        <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <div class="alert-content">
                            <strong>@successMessage</strong><br/>
                            Welcome back, @userName!
                        </div>
                    </div>
                }

                <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" autocomplete="off">
                    <!-- Dummy inputs to prevent browser autofill/saved password popup cards -->
                    <input type="text" name="prevent_autofill_user" style="display:none; position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" />
                    <input type="password" name="prevent_autofill_pass" style="display:none; position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" />

                    <div class="form-group">
                        <label class="form-label">Email Address or Mobile Number</label>
                        <div class="input-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <input type="text" class="form-control custom-input" 
                                   @bind="loginModel.Input" 
                                   @bind:event="oninput" 
                                   @onkeydown="HandleKeyDown" 
                                   placeholder="Enter email or mobile number" 
                                   autocomplete="off"
                                   aria-autocomplete="none"
                                   spellcheck="false"
                                   autocorrect="off"
                                   autocapitalize="off"
                                   data-lpignore="true"
                                   data-1p-ignore="true"
                                   data-bwignore="true"
                                   data-form-type="other" />
                        </div>
                    </div>

                    <div class="form-group password-group">
                        <label class="form-label">Password</label>
                        <div class="input-wrapper password-input-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <input type="@passwordInputType" class="form-control custom-input" 
                                   @bind="loginModel.Password" 
                                   @bind:event="oninput" 
                                   @onkeydown="HandleKeyDown" 
                                   placeholder="••••••••" 
                                   autocomplete="off"
                                   aria-autocomplete="none"
                                   spellcheck="false"
                                   autocorrect="off"
                                   autocapitalize="off"
                                   data-lpignore="true"
                                   data-1p-ignore="true"
                                   data-bwignore="true"
                                   data-form-type="other" />
                            <button type="button" class="btn-eye" @onclick="TogglePasswordVisibility" aria-label="Toggle password visibility">
                                @if (showPassword)
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                                }
                            </button>
                        </div>
                    </div>

                    <div class="form-options">
                        <label class="stay-signed-in">
                            <input class="custom-checkbox" type="checkbox" id="staySignedIn" checked>
                            <span>Stay signed in</span>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-continue" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Authenticating...</span>
                        }
                        else
                        {
                            <span>Continue</span>
                            <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        }
                    </button>
                </EditForm>

                <div class="login-footer-links">
                    <a href="/admin-login" class="staff-login-link" style="margin-bottom: 8px; display: inline-block;">Use Admin Login instead</a>
                    <p class="register-text" style="margin-bottom: 6px;">New laboratory? <a href="/register" class="register-link">Register Facility</a></p>
                    <p class="register-text">New staff? <a href="/user-register" class="register-link">Register Staff</a></p>
                </div>

                <div class="form-footer-mini">
                    <span>© Medico</span> • <a href="#">Contact</a> • <a href="#">Privacy & terms</a>
                </div>
            </div>

            <!-- Project Version Number below Login card end -->
            <div class="login-card-version">
                <div class="version-badge" title="Medico Portal v@(AppVersionInfo.Version)">
                    <span class="version-dot"></span>
                    <span>v@(AppVersionInfo.Version)</span>
                </div>
            </div>
        </div>
    </div>
    <Booking.Components.Shared.ToastContainer />
</div>

@code {
    private UserLoginModel loginModel = new UserLoginModel { Input = "", Password = "" };
    private string? errorMessage;
    private string? successMessage;
    private string? userName;
    private bool isLoading;
    private bool showPassword = false;
    private string passwordInputType => showPassword ? "text" : "password";

    private bool isDarkMode = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (TenantState.IsAuthenticated)
                {
                    NavigationManager.NavigateTo("/home", replace: true);
                    return;
                }
                var tokenRes = await _sessionStorage.GetAsync<string>("authToken");
                if (tokenRes.Success && !string.IsNullOrEmpty(tokenRes.Value))
                {
                    NavigationManager.NavigateTo("/home", replace: true);
                    return;
                }

                var theme = await JSRuntime.InvokeAsync<string>("medicoTheme.getTheme");
                isDarkMode = (theme == "dark");
                StateHasChanged();
            }
            catch {}
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            var newTheme = await JSRuntime.InvokeAsync<string>("medicoTheme.toggleTheme");
            isDarkMode = (newTheme == "dark");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling theme: {ex.Message}");
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        if (isLoading) return;
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var payload = new LIMS_Backend.Model.LoginDto 
            {
                input = loginModel.Input,
                password = loginModel.Password
            };

            var response = await UserService.LoginAsync(payload);

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[UserLogin] Raw Response: {responseContent}");
                
                var json = JObject.Parse(responseContent);
                string? token = json["token"]?.ToString() ?? json["Token"]?.ToString();
                
                var userDetailsJson = json["userdetails"] ?? json["UserDetails"] ?? json["user"] ?? json["User"];
                
                string inputDisplayName = (!string.IsNullOrWhiteSpace(loginModel.Input)) 
                    ? (loginModel.Input.Contains("@") ? loginModel.Input.Split('@')[0] : loginModel.Input) 
                    : "";

                string? rawName = userDetailsJson?["name"]?.ToString() 
                    ?? userDetailsJson?["Name"]?.ToString() 
                    ?? userDetailsJson?["username"]?.ToString() 
                    ?? userDetailsJson?["UserName"]?.ToString() 
                    ?? userDetailsJson?["user_name"]?.ToString() 
                    ?? userDetailsJson?["full_name"]?.ToString() 
                    ?? userDetailsJson?["fullName"]?.ToString();

                string name = (!string.IsNullOrWhiteSpace(rawName) && !string.Equals(rawName.Trim(), "Staff Member", StringComparison.OrdinalIgnoreCase) && !string.Equals(rawName.Trim(), "Main branch", StringComparison.OrdinalIgnoreCase)) 
                    ? rawName.Trim() 
                    : inputDisplayName;
                
                // Extract tenant_code with fallbacks
                string? tenantCode = userDetailsJson?["tenant_code"]?.ToString() 
                    ?? userDetailsJson?["tenantCode"]?.ToString() 
                    ?? userDetailsJson?["TenantCode"]?.ToString() 
                    ?? userDetailsJson?["tenantcode"]?.ToString()
                    ?? userDetailsJson?["tenant_id"]?.ToString()
                    ?? userDetailsJson?["tenantId"]?.ToString()
                    ?? userDetailsJson?["TenantId"]?.ToString();
                
                if (string.IsNullOrEmpty(tenantCode))
                {
                    var rightsArray = json["rights"] as JArray ?? json["Rights"] as JArray;
                    if (rightsArray != null && rightsArray.Count > 0)
                    {
                        foreach (var right in rightsArray)
                        {
                            var tId = right["tenant_id"]?.ToString() ?? right["tenantId"]?.ToString() ?? right["TenantId"]?.ToString() ?? right["tenant_code"]?.ToString();
                            if (!string.IsNullOrEmpty(tId))
                            {
                                tenantCode = tId;
                                break;
                            }
                        }
                    }
                }
                
                if (string.IsNullOrEmpty(tenantCode))
                {
                    tenantCode = json["tenant_code"]?.ToString() ?? json["tenant_id"]?.ToString();
                }

                if (string.IsNullOrEmpty(tenantCode))
                {
                    tenantCode = "LAB01";
                }

                successMessage = "Login successful!";
                userName = name;
                string safeToken = token ?? "";

                List<SharedComponents.Rcl.Models.User_Rights> resolvedUserRights = new();
                bool isUserAdmin = false;
                string userRoleName = "";
                var rightsArrayObj = json["rights"] as JArray ?? json["Rights"] as JArray;
                if (rightsArrayObj != null && rightsArrayObj.Count > 0)
                {
                    foreach (var item in rightsArrayObj)
                    {
                        var rJson = item["rights_json"]?.ToString() ?? item["RightsJson"]?.ToString();
                        var rName = item["role_name"]?.ToString() ?? item["RoleName"]?.ToString();
                        if (!string.IsNullOrEmpty(rName) && string.IsNullOrEmpty(userRoleName)) userRoleName = rName;
                        if (!string.IsNullOrEmpty(rJson))
                        {
                            try
                            {
                                var rObj = Newtonsoft.Json.Linq.JObject.Parse(rJson);
                                if (rObj["IsAdmin"]?.ToObject<bool>() == true) isUserAdmin = true;
                            }
                            catch { }
                        }

                        var modName = item["ModuleName"]?.ToString() ?? item["module_name"]?.ToString() ?? item["module"]?.ToString();
                        var deptName = item["Department"]?.ToString() ?? item["department"]?.ToString() ?? item["dept"]?.ToString();
                        bool toView = item["ToView"]?.ToObject<bool>() == true || item["to_view"]?.ToObject<bool>() == true || item["toview"]?.ToObject<bool>() == true;
                        bool toAdd = item["ToAdd"]?.ToObject<bool>() == true || item["to_add"]?.ToObject<bool>() == true || item["toadd"]?.ToObject<bool>() == true;
                        bool toEdit = item["ToEdit"]?.ToObject<bool>() == true || item["to_edit"]?.ToObject<bool>() == true || item["toedit"]?.ToObject<bool>() == true;
                        bool toDel = item["ToDelete"]?.ToObject<bool>() == true || item["to_delete"]?.ToObject<bool>() == true || item["todelete"]?.ToObject<bool>() == true;

                        if (!string.IsNullOrEmpty(modName) || !string.IsNullOrEmpty(deptName))
                        {
                            resolvedUserRights.Add(new SharedComponents.Rcl.Models.User_Rights
                            {
                                UserModuleID = item["UserModuleID"]?.ToObject<int>() ?? item["user_module_id"]?.ToObject<int>() ?? 0,
                                ModuleName = modName ?? "",
                                Department = deptName ?? "",
                                UserCode = userDetailsJson?["usercode"]?.ToObject<int?>() ?? userDetailsJson?["user_code"]?.ToObject<int?>() ?? 0,
                                ToView = toView,
                                ToAdd = toAdd,
                                ToEdit = toEdit,
                                ToDelete = toDel
                            });
                        }
                    }
                }

                int? bhCodeVal = userDetailsJson?["bhcode"]?.ToObject<int?>() 
                    ?? userDetailsJson?["bh_code"]?.ToObject<int?>()
                    ?? json["bhcode"]?.ToObject<int?>()
                    ?? json["bh_code"]?.ToObject<int?>()
                    ?? json["branch_code"]?.ToObject<int?>()
                    ?? json["branchCode"]?.ToObject<int?>();
                int? counterCodeVal = userDetailsJson?["cntcode"]?.ToObject<int?>() ?? userDetailsJson?["cnt_code"]?.ToObject<int?>();
                int resolvedUserCode = userDetailsJson?["usercode"]?.ToObject<int?>() ?? userDetailsJson?["user_code"]?.ToObject<int?>() ?? 0;

                var userBranches = new List<SharedComponents.Rcl.Models.BranchModel>();
                var branchesToken = userDetailsJson?["branches"] as JArray 
                    ?? userDetailsJson?["Branches"] as JArray
                    ?? json["branches"] as JArray
                    ?? json["Branches"] as JArray
                    ?? userDetailsJson?["branch"] as JArray
                    ?? json["branch"] as JArray
                    ?? userDetailsJson?["user_branches"] as JArray
                    ?? json["user_branches"] as JArray;
                if (branchesToken != null)
                {
                    foreach (var bToken in branchesToken)
                    {
                        int resolvedBhCode = bToken["bhcode"]?.ToObject<int?>() ?? bToken["bh_code"]?.ToObject<int?>() ?? bToken["id"]?.ToObject<int?>() ?? 0;
                        string bName = bToken["name"]?.ToString() 
                            ?? bToken["branch_name"]?.ToString() 
                            ?? bToken["branchName"]?.ToString() 
                            ?? bToken["b_name"]?.ToString() 
                            ?? bToken["branchname"]?.ToString() 
                            ?? "";
                        string bShort = bToken["short_name"]?.ToString() ?? bToken["shortname"]?.ToString() ?? "";

                        if (resolvedBhCode > 0 && !IsSampleBranch(bName, bShort, resolvedBhCode))
                        {
                            userBranches.Add(new SharedComponents.Rcl.Models.BranchModel
                            {
                                bh_code = resolvedBhCode,
                                name = !string.IsNullOrWhiteSpace(bName) ? bName.Trim() : (!string.IsNullOrWhiteSpace(bShort) ? bShort.Trim() : $"Branch {resolvedBhCode}")
                            });
                        }
                    }
                }

                // ALWAYS fetch the valid operating branches directly from LabCareUrl (labcareapi)
                try
                {
                    var branchClient = HttpClientFactory.CreateClient("LabCareUrl");
                    if (!string.IsNullOrEmpty(tenantCode))
                    {
                        branchClient.DefaultRequestHeaders.Remove("tenant_code");
                        branchClient.DefaultRequestHeaders.Add("tenant_code", tenantCode);
                        branchClient.DefaultRequestHeaders.Remove("tenantcode");
                        branchClient.DefaultRequestHeaders.Add("tenantcode", tenantCode);
                        branchClient.DefaultRequestHeaders.Remove("tenant-code");
                        branchClient.DefaultRequestHeaders.Add("tenant-code", tenantCode);
                    }
                    if (!string.IsNullOrEmpty(safeToken))
                    {
                        branchClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", safeToken);
                    }
                    var bRes = await branchClient.GetAsync("api/Branch/get");
                    if (bRes.IsSuccessStatusCode)
                    {
                        var bJson = await bRes.Content.ReadAsStringAsync();
                        var dbBranches = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(bJson) ?? new();
                        var validBranches = dbBranches
                            .Where(b => !b.deleted && !IsSampleBranch(b.name, b.short_name, b.bh_code))
                            .ToList();
                        if (validBranches.Any())
                        {
                            userBranches = validBranches.Select(vb => new SharedComponents.Rcl.Models.BranchModel
                            {
                                bh_code = vb.bh_code,
                                name = !string.IsNullOrWhiteSpace(vb.name) ? vb.name.Trim() : (!string.IsNullOrWhiteSpace(vb.short_name) ? vb.short_name.Trim() : $"Branch {vb.bh_code}")
                            }).ToList();
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[UserLogin] Error fetching branches from LabCareUrl: {ex.Message}");
                }

                // Filter out Sample Branch and ensure unique branches
                userBranches = userBranches
                    .Where(b => !IsSampleBranch(b.name, b.short_name, b.bh_code))
                    .GroupBy(b => b.bh_code)
                    .Select(g => g.First())
                    .ToList();

                string detectedRole = !string.IsNullOrEmpty(userRoleName) 
                    ? userRoleName 
                    : (userDetailsJson?["role"]?.ToString() ?? json["role"]?.ToString() ?? "");

                bool finalIsAdmin = isUserAdmin || 
                                   string.Equals(detectedRole, "Admin", StringComparison.OrdinalIgnoreCase) || 
                                   string.Equals(detectedRole, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                   string.Equals(detectedRole, "Super Admin", StringComparison.OrdinalIgnoreCase) ||
                                   string.Equals(detectedRole, "SuperAdmin", StringComparison.OrdinalIgnoreCase) ||
                                   string.Equals(detectedRole, "Tenant", StringComparison.OrdinalIgnoreCase) ||
                                   string.Equals(detectedRole, "Power User", StringComparison.OrdinalIgnoreCase) ||
                                   string.Equals(detectedRole, "PowerUser", StringComparison.OrdinalIgnoreCase);

                string finalRole = finalIsAdmin ? "Administrator" : (!string.IsNullOrWhiteSpace(detectedRole) ? detectedRole : "User");

                string? extractedTenantName = json["tenant_name"]?.ToString() 
                    ?? json["tenantName"]?.ToString() 
                    ?? json["TenantName"]?.ToString() 
                    ?? json["Tenant_Name"]?.ToString()
                    ?? json["hospital_name"]?.ToString()
                    ?? json["hospitalName"]?.ToString()
                    ?? json["HospitalName"]?.ToString()
                    ?? json["company_name"]?.ToString()
                    ?? json["CompanyName"]?.ToString()
                    ?? userDetailsJson?["tenant_name"]?.ToString()
                    ?? userDetailsJson?["tenantName"]?.ToString()
                    ?? userDetailsJson?["TenantName"]?.ToString()
                    ?? userDetailsJson?["hospital_name"]?.ToString()
                    ?? userDetailsJson?["hospitalName"]?.ToString()
                    ?? userDetailsJson?["HospitalName"]?.ToString()
                    ?? userDetailsJson?["company_name"]?.ToString();

                string resolvedTenantName = !string.IsNullOrWhiteSpace(extractedTenantName) && !string.Equals(extractedTenantName.Trim(), "Main branch", StringComparison.OrdinalIgnoreCase)
                    ? extractedTenantName 
                    : "Medico Healthcare Hospital";

                var validOperatingBranches = userBranches
                    .Where(b => !IsSampleBranch(b.name, b.short_name, b.bh_code))
                    .ToList();

                int? defaultBhCode = (validOperatingBranches.Count == 1) 
                    ? validOperatingBranches[0].bh_code 
                    : null;

                var userDetails = new SharedComponents.Rcl.Models.UserDetailsModel
                {
                    UserName = name,
                    Role = finalRole,
                    TenantCode = tenantCode,
                    TenantName = resolvedTenantName,
                    AuthToken = safeToken,
                    UserCode = resolvedUserCode,
                    BranchCode = defaultBhCode,
                    CounterCode = counterCodeVal,
                    Branches = userBranches,
                    Claim = null
                };
                
                await _sessionStorage.SetAsync("authToken", safeToken);
                await _sessionStorage.SetAsync("tenant_code", tenantCode);
                await _sessionStorage.SetAsync("tenant_name", resolvedTenantName);
                await _sessionStorage.SetAsync("user_name", name);
                await _sessionStorage.SetAsync("login_input", inputDisplayName);
                await _sessionStorage.SetAsync("user_role", finalRole);
                await _sessionStorage.SetAsync("user_code", resolvedUserCode);
                await _sessionStorage.SetAsync("IsTenantAdmin", finalIsAdmin);
                if (defaultBhCode.HasValue && defaultBhCode.Value > 0)
                {
                    await _sessionStorage.SetAsync("bhcode", defaultBhCode.Value.ToString());
                    await _sessionStorage.SetAsync("session_branch_confirmed", true);
                }
                else
                {
                    await _sessionStorage.DeleteAsync("bhcode");
                    await _sessionStorage.DeleteAsync("session_branch_confirmed");
                }
                if (counterCodeVal.HasValue) await _sessionStorage.SetAsync("cntcode", counterCodeVal.Value.ToString());
                await _sessionStorage.SetAsync("UserDetails", userDetails);
                await _sessionStorage.SetAsync("UserBranches", userBranches);
                var userBranchCodes = userBranches.Select(b => b.bh_code).Distinct().ToList();
                await _sessionStorage.SetAsync("UserBranchCodes", userBranchCodes);

                try
                {
                    var localSessionJson = await JSRuntime.InvokeAsync<string>("medicoSessionHelper.getSession");
                    var jObj = string.IsNullOrWhiteSpace(localSessionJson) ? new JObject() : JObject.Parse(localSessionJson);
                    if (defaultBhCode.HasValue && defaultBhCode.Value > 0)
                    {
                        jObj["bhcode"] = defaultBhCode.Value;
                        jObj["session_branch_confirmed"] = true;
                    }
                    else
                    {
                        jObj.Remove("bhcode");
                        jObj.Remove("session_branch_confirmed");
                    }
                    await JSRuntime.InvokeVoidAsync("medicoSessionHelper.saveSession", jObj.ToString());
                }
                catch { }
                
                // Initialize session early so DelegatingHandlers have tenantCode
                TenantState.SetSession(tenantCode, safeToken, resolvedTenantName, resolvedUserCode, defaultBhCode, counterCodeVal, userDetails, resolvedUserRights);

                try
                {
                    var crossTabSession = new
                    {
                        authToken = safeToken,
                        tenant_code = tenantCode,
                        tenant_name = resolvedTenantName,
                        user_name = name,
                        login_input = inputDisplayName,
                        user_role = finalRole,
                        user_code = resolvedUserCode,
                        bhcode = defaultBhCode,
                        cntcode = counterCodeVal,
                        isAdmin = finalIsAdmin,
                        session_branch_confirmed = (defaultBhCode.HasValue && defaultBhCode.Value > 0)
                    };
                    await JSRuntime.InvokeVoidAsync("medicoSessionHelper.saveSession", JsonConvert.SerializeObject(crossTabSession));
                }
                catch { }

                List<Booking.Models.RolePermissionItem> effectivePerms = new();
                if (resolvedUserRights.Any())
                {
                    effectivePerms = RoleMasterService.ConvertUserRightsToPermissions(resolvedUserRights);
                }
                else if (resolvedUserCode > 0)
                {
                    try
                    {
                        effectivePerms = await RoleService.GetUserEffectivePermissionsAsync(resolvedUserCode);
                    }
                    catch (Exception permEx)
                    {
                        Console.WriteLine($"[UserLogin] Error fetching user role permissions: {permEx.Message}");
                    }
                }

                if (finalIsAdmin && (!effectivePerms.Any()))
                {
                    effectivePerms = RoleCatalogDefaults.GetDefaultPermissions();
                }

                RoleService.SetUserPermissions(effectivePerms);
                await _sessionStorage.SetAsync("UserRolePermissions", effectivePerms);

                if (!resolvedUserRights.Any() && effectivePerms.Any())
                {
                    resolvedUserRights = RoleMasterService.ConvertEffectivePermissionsToUserRights(effectivePerms, resolvedUserCode);
                }
                await _sessionStorage.SetAsync("UserRights", resolvedUserRights);
                TenantState.SetSession(tenantCode, safeToken, resolvedTenantName, resolvedUserCode, defaultBhCode, counterCodeVal, userDetails, resolvedUserRights);
                
                try
                {
                    var crossTabSession = new
                    {
                        authToken = safeToken,
                        tenant_code = tenantCode,
                        tenant_name = resolvedTenantName,
                        user_name = name,
                        login_input = inputDisplayName,
                        user_role = finalRole,
                        user_code = resolvedUserCode,
                        bhcode = defaultBhCode,
                        cntcode = counterCodeVal,
                        isAdmin = finalIsAdmin,
                        session_branch_confirmed = (defaultBhCode.HasValue && defaultBhCode.Value > 0)
                    };
                    await JSRuntime.InvokeVoidAsync("medicoSessionHelper.saveSession", JsonConvert.SerializeObject(crossTabSession));
                }
                catch { }

                Toast.ShowSuccess($"Login successful! Tenant: {tenantCode}");
                await Task.Delay(1000);
                NavigationManager.NavigateTo("/home", replace: true);
            }
            else
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[UserLogin] Error Response: {responseContent}");
                string detailedError = ExtractErrorMessage(responseContent);

                if (!string.IsNullOrEmpty(detailedError) && (detailedError.Contains("No application module is assigned", StringComparison.OrdinalIgnoreCase) || detailedError.Contains("module is assigned", StringComparison.OrdinalIgnoreCase)))
                {
                    await HandleUserWithDefaultRightsAsync(loginModel.Input);
                    return;
                }

                if (!string.IsNullOrEmpty(detailedError))
                {
                    errorMessage = detailedError;
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    errorMessage = "Login failed: Invalid email or password.";
                }
                else
                {
                    errorMessage = $"Login failed. Status Code: {response.StatusCode}";
                }
                Toast.ShowError(errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while attempting to log in: {ex.Message}";
            Toast.ShowError(errorMessage);
        }
        finally
        {
            isLoading = false;
        }
    }

