@page "/reimbursements"
@page "/reimbursementcompanymaster"
@rendermode InteractiveServer

@using Booking.Models
@using Booking.Services
@inject ReimbursementCompanyMasterService ReimbursementService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">list_alt</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Reimbursement Company Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Classification Inventory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search companies..." @bind="SearchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewCompany">+ Add New</button>
            </div>
        </div>
    </div>

    @* --- directory list --- *@
    <div class="directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">ORDER NO</th>
                        <th style="width: 150px;">SHORT NAME</th>
                        <th>REIMBURSEMENT COMPANY NAME</th>
                        <th>DESCRIPTION</th>
                        <th style="width: 180px;">ENTERED DATE</th>
                        <th style="width: 180px;">MODIFIED DATE</th>
                        <th class="text-center" style="width: 120px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (companies != null && companies.Any())
                    {
                        @foreach (var c in FilteredCompaniesBySearch)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"{c.orderno:00}")</span></td>
                                <td class="lc-color-slate-500 lc-font-mono lc-font-700 lc-font-13">@c.shortname</td>
                                <td class="font-bold text-slate-800">@c.name</td>
                                <td class="text-slate-500">@c.description</td>
                                <td class="text-slate-400 font-12">@(c.entereddate != default ? c.entereddate.ToString("dd-MM-yyyy hh:mm tt") : "")</td>
                                <td class="text-slate-400 font-12">@(c.ibsdate != default ? c.ibsdate.ToString("dd-MM-yyyy hh:mm tt") : "")</td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px;">
                                        <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => EditCompany(c)" title="Edit">
                                            <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                        </button>
                                        <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => DeleteCompany(c.ricode)" title="Delete">
                                            <span class="material-symbols-outlined font-18 text-slate-400">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center p-48 text-slate-400 italic">No reimbursement company records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- FORM SECTION (Modal) --- *@
@if (showForm)
{
    <div class="modal-overlay">
        <div class="modal-form-card">
            <div class="modal-header-bar">
                <h3>@(isEditMode ? "Edit Reimbursement Company" : "New Reimbursement Company Entry")</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-0 form-section">
                    <div class="mt-0">
                        @* Line 1: Company Name *@
                        <div class="um-grid-row">
                            <div class="form-group position-relative">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label style="margin-bottom: 0;">Reimbursement Company Name *</label>
                                    @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                    {
                                        <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                    }
                                </div>
                                <input type="text" class="lab-input" @bind="current.name" placeholder="e.g. National Health Insurance Ltd" required />
                            </div>
                        </div>

                        @* Line 2: Order No, Short Name, Fee Type (ftcode), Contact Name *@
                        <div class="um-grid-cols-4">
                            <div class="form-group">
                                <label>Order No</label>
                                <input type="number" class="lab-input" @bind="current.orderno" placeholder="e.g. 1" />
                            </div>
                            <div class="form-group">
                                <label>Short Name</label>
                                <input type="text" class="lab-input" @bind="current.shortname" placeholder="e.g. NHI" />
                            </div>
                            <div class="form-group">
                                <label>Fee Type Code (ftcode)</label>
                                <input type="number" class="lab-input" @bind="current.ftcode" placeholder="e.g. 2" />
                            </div>
                            <div class="form-group">
                                <label>Contact Person</label>
                                <input type="text" class="lab-input" @bind="current.contactname" placeholder="e.g. Ramesh Kumar" />
                            </div>
                        </div>

                        @* Line 3: Email, Mobile, Phone, Fax *@
                        <div class="um-grid-cols-4">
                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" class="lab-input" @bind="current.email" placeholder="contact@nhi.in" />
                            </div>
                            <div class="form-group">
                                <label>Mobile</label>
                                <input type="text" class="lab-input" @bind="current.mobile" placeholder="9876543210" />
                            </div>
                            <div class="form-group">
                                <label>Phone</label>
                                <input type="text" class="lab-input" @bind="current.phone" placeholder="044-23456789" />
                            </div>
                            <div class="form-group">
                                <label>Fax</label>
                                <input type="text" class="lab-input" @bind="current.fax" placeholder="044-23456790" />
                            </div>
                        </div>

                        @* Line 4: Website, Monthly Type, Area Code, Location Code (LCode) *@
                        <div class="um-grid-cols-4">
                            <div class="form-group">
                                <label>Website</label>
                                <input type="text" class="lab-input" @bind="current.website" placeholder="www.nhi.in" />
                            </div>
                            <div class="form-group">
                                <label>Monthly Type</label>
                                <select class="lab-input" @bind="current.monthlytype">
                                    <option value="">Select billing type</option>
                                    <option value="MONTHLY">MONTHLY</option>
                                    <option value="WEEKLY">WEEKLY</option>
                                    <option value="IMMEDIATE">IMMEDIATE</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Area Code</label>
                                <input type="number" class="lab-input" @bind="current.areacode" placeholder="e.g. 101" />
                            </div>
                            <div class="form-group">
                                <label>Location Code (LCode)</label>
                                <input type="text" class="lab-input" @bind="current.lcode" placeholder="e.g. LC001" />
                            </div>
                        </div>

                        @* Line 5: Address *@
                        <div class="um-grid-row">
                            <div class="form-group">
                                <label>Address</label>
                                <input type="text" class="lab-input" @bind="current.address" placeholder="12, Anna Salai, Chennai" />
                            </div>
                        </div>

                        @* Line 6: City, State, Country, Pincode *@
                        <div class="um-grid-cols-4">
                            <div class="form-group">
                                <label>City</label>
                                <input type="text" class="lab-input" @bind="current.city" placeholder="Chennai" />
                            </div>
                            <div class="form-group">
                                <label>State</label>
                                <input type="text" class="lab-input" @bind="current.state" placeholder="Tamil Nadu" />
                            </div>
                            <div class="form-group">
                                <label>Country</label>
                                <input type="text" class="lab-input" @bind="current.country" placeholder="India" />
                            </div>
                            <div class="form-group">
                                <label>Pincode</label>
                                <input type="text" class="lab-input" @bind="current.pincode" placeholder="600002" />
                            </div>
                        </div>

                        @* Line 7: Description *@
                        <div class="um-grid-row">
                            <div class="form-group">
                                <label>Description</label>
                                <input type="text" class="lab-input" @bind="current.description" placeholder="Leading health reimbursement company in South India" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer-bar">
                <button type="button"
                        class="btn-delete"
                        @onclick="() => DeleteCompany(current.ricode)"
                        disabled="@(current.ricode == 0)">
                    Delete
                </button>
                <button type="button" class="btn-save" @onclick="SaveCompany">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                    </svg>
                    Save Company
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ReimbursementCompanyMasterModel> companies = new();
    private ReimbursementCompanyMasterModel current = new();
    private bool isEditMode = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";

    private IEnumerable<ReimbursementCompanyMasterModel> FilteredCompanies =>
        companies.Where(c => !c.deleted);

    private IEnumerable<ReimbursementCompanyMasterModel> FilteredCompaniesBySearch =>
        FilteredCompanies.Where(c => 
            string.IsNullOrWhiteSpace(SearchQuery) || 
            (c.name != null && c.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.shortname != null && c.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.description != null && c.description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.city != null && c.city.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadCompanies();
    }

    private async Task LoadCompanies()
    {
        try
        {
            companies = await ReimbursementService.GetReimbursementCompaniesAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading companies: {ex.Message}");
        }
    }

    private void NewCompany()
    {
        current = new ReimbursementCompanyMasterModel { 
            deleted = false,
            computercode = 1,
            usercode = 1,
            entereddate = DateTime.Now,
            ibsdate = DateTime.Now,
            orderno = companies.Count + 1,
            tenant_code = "TEN007",
            ftcode = 2
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private void EditCompany(ReimbursementCompanyMasterModel c)
    {
        if (c == null) return;
        current = new ReimbursementCompanyMasterModel
        {
            ricode = c.ricode,
            orderno = c.orderno,
            ftcode = c.ftcode,
            shortname = c.shortname,
            name = c.name,
            address = c.address,
            city = c.city,
            pincode = c.pincode,
            state = c.state,
            country = c.country,
            phone = c.phone,
            contactname = c.contactname,
            mobile = c.mobile,
            fax = c.fax,
            email = c.email,
            website = c.website,
            description = c.description,
            areacode = c.areacode,
            deleted = c.deleted,
            usercode = c.usercode,
            computercode = c.computercode,
            entereddate = c.entereddate,
            ibsdate = c.ibsdate,
            lcode = c.lcode,
            monthlytype = c.monthlytype,
            tenant_code = c.tenant_code
        };
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveCompany()
    {
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(current.name))
        {
            ToastService.ShowError("Reimbursement Company Name is required.");
            StateHasChanged();
            return;
        }

        try
        {
            current.tenant_code = "TEN007";
            current.computercode = 1;
            current.usercode = 1;
            current.ibsdate = DateTime.Now;

            bool success;
            if (isEditMode)
            {
                success = await ReimbursementService.UpdateReimbursementCompanyAsync(current);
            }
            else
            {
                current.entereddate = DateTime.Now;
                success = await ReimbursementService.InsertReimbursementCompanyAsync(current);
            }

            if (success)
            {
                await LoadCompanies();
                ToastService.ShowSuccess(isEditMode ? "Company updated successfully!" : "Company added successfully!");
                showForm = false;
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Save failed on backend.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving company: {ex.Message}");
            StateHasChanged();
        }
    }

    private async Task DeleteCompany(decimal ricode)
    {
        if (ricode == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this company?"))
        {
            try
            {
                bool success = await ReimbursementService.DeleteReimbursementCompanyAsync(ricode);
                if (success)
                {
                    await LoadCompanies();
                    ToastService.ShowSuccess("Company deleted successfully!");
                    if (current != null && current.ricode == ricode)
                    {
                        showForm = false;
                    }
                    StateHasChanged();
                }
                else
                {
                    ToastService.ShowError("Delete failed on backend.");
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error deleting: {ex.Message}");
                StateHasChanged();
            }
        }
    }

    private void CloseForm()
    {
        current = new ReimbursementCompanyMasterModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }
}
