@page "/inventory-dashboard"
@page "/pharmacy-dashboard"
@implements IDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@inject IHttpClientFactory ClientFactory
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Pharmacy Analytics Dashboard - Medico Portal</PageTitle>

<div class="dashboard-wrapper">
    <!-- TOP HEADER BAR WITH DATE/MONTH FILTERS AND SIGNALR LIVE BADGE -->
    <div class="dashboard-header">
        <div class="header-title">
            <div class="icon-badge teal">
                <i class="bi bi-prescription2"></i>
            </div>
            <div>
                <h1>Pharmacy Analytics Dashboard</h1>
                <p class="text-muted">Live sales details, purchase records, stock valuation &amp; store metrics.</p>
            </div>
        </div>

        <div class="header-filters">
            <!-- Filter Mode Pills (Daily / Monthly) -->
            <div class="mode-pills me-2">
                <button type="button" class="mode-pill @(filterMode == "daily" ? "active" : "")" @onclick='() => SetFilterMode("daily")'>Daily</button>
                <button type="button" class="mode-pill @(filterMode == "monthly" ? "active" : "")" @onclick='() => SetFilterMode("monthly")'>Monthly</button>
            </div>

            <!-- Date / Month Pickers -->
            @if (filterMode == "daily")
            {
                <div class="filter-item me-2">
                    <span class="filter-icon"><i class="bi bi-calendar3"></i></span>
                    <input type="date" class="form-control-sm filter-input" @bind="filterDate" @bind:after="OnFilterChanged" />
                </div>
            }
            else
            {
                <div class="filter-item me-2">
                    <span class="filter-icon"><i class="bi bi-calendar-month"></i></span>
                    <select class="form-select-sm filter-input" @bind="filterMonth" @bind:after="OnFilterChanged">
                        <option value="1">Jan</option>
                        <option value="2">Feb</option>
                        <option value="3">Mar</option>
                        <option value="4">Apr</option>
                        <option value="5">May</option>
                        <option value="6">Jun</option>
                        <option value="7">Jul</option>
                        <option value="8">Aug</option>
                        <option value="9">Sep</option>
                        <option value="10">Oct</option>
                        <option value="11">Nov</option>
                        <option value="12">Dec</option>
                    </select>
                    <select class="form-select-sm filter-input ms-1" @bind="filterYear" @bind:after="OnFilterChanged">
                        @for (int y = 2024; y <= 2030; y++)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </div>
            }

            <!-- SignalR Live Stream Connected Indicator (Pulse Dot) -->
            <div class="signalr-live-badge" title="Live SignalR Active">
                <span class="pulse-dot"></span>
            </div>
        </div>
    </div>

    <!-- 6 KPI METRIC CARDS (INCLUDING STORES & VENDORS) -->
    <div class="kpi-grid-6">
        <!-- 1. Total Items -->
        <div class="kpi-card cyan">
            <div class="kpi-top">
                <span class="kpi-label">Total Items</span>
                <div class="kpi-icon-wrapper cyan-bg"><i class="bi bi-box-seam"></i></div>
            </div>
            <div class="kpi-value">@itemsList.Count.ToString("N0")</div>
            <div class="kpi-foot positive">
                <i class="bi bi-check-circle-fill me-1"></i> Active Item Master
            </div>
        </div>

        <!-- 2. Purchases (Shows Total Amount Revenue as Primary Value) -->
        <div class="kpi-card purple">
            <div class="kpi-top">
                <span class="kpi-label">Purchases</span>
                <div class="kpi-icon-wrapper purple-bg"><i class="bi bi-bag-check-fill"></i></div>
            </div>
            <div class="kpi-value">₹ @FilteredPurchases.Sum(p => (double)p.TotalAmount).ToString("N0")</div>
            <div class="kpi-foot info">
                <i class="bi bi-bag-check-fill me-1"></i> @FilteredPurchases.Count Purchase Orders
            </div>
        </div>

        <!-- 3. Sales (Shows Total Amount Revenue as Primary Value) -->
        <div class="kpi-card emerald">
            <div class="kpi-top">
                <span class="kpi-label">Sales</span>
                <div class="kpi-icon-wrapper emerald-bg"><i class="bi bi-cart-check-fill"></i></div>
            </div>
            <div class="kpi-value">₹ @FilteredSales.Sum(s => (double)s.TotalAmount).ToString("N0")</div>
            <div class="kpi-foot positive">
                <i class="bi bi-graph-up-arrow me-1"></i> @FilteredSales.Count Transactions
            </div>
        </div>

        <!-- 4. Total Stocks (Shows Total Valuation as Primary Value) -->
        <div class="kpi-card blue">
            <div class="kpi-top">
                <span class="kpi-label">Total Stocks</span>
                <div class="kpi-icon-wrapper blue-bg"><i class="bi bi-stack"></i></div>
            </div>
            <div class="kpi-value">
                ₹ @(FilteredStockValuation >= 100000 ? (FilteredStockValuation / 100000m).ToString("N2") + " L" : FilteredStockValuation.ToString("N0"))
            </div>
            <div class="kpi-foot positive">
                <i class="bi bi-stack me-1"></i> @FilteredStockUnits.ToString("N0") Stock Units
            </div>
        </div>

        <!-- 5. Stores & Warehouses -->
        <div class="kpi-card amber">
            <div class="kpi-top">
                <span class="kpi-label">Stores List</span>
                <div class="kpi-icon-wrapper amber-bg"><i class="bi bi-shop"></i></div>
            </div>
            <div class="kpi-value">@storesList.Count</div>
            <div class="kpi-foot warning">
                <i class="bi bi-geo-alt-fill me-1"></i> Active Locations
            </div>
        </div>

        <!-- 6. Vendors List (From api/ItemMaster/getallvendors Endpoint) -->
        <div class="kpi-card rose">
            <div class="kpi-top">
                <span class="kpi-label">Vendors List</span>
                <div class="kpi-icon-wrapper rose-bg"><i class="bi bi-people-fill"></i></div>
            </div>
            <div class="kpi-value">@vendorsList.Count</div>
            <div class="kpi-foot info">
                <i class="bi bi-truck me-1"></i> Registered Suppliers
            </div>
        </div>
    </div>

    <!-- UPPER CHARTS ROW -->
    <div class="charts-row">
        <!-- Chart 1: Sales & Procurement Trend Flow -->
        <div class="chart-card flex-2">
            <div class="chart-header">
                <div>
                    <h3>Sales &amp; Procurement Trend Flow</h3>
                    <span class="chart-sub">Daily counter billing performance (@GetFilterStatusLabel())</span>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="pharmacyRevenueChart"></canvas>
            </div>
        </div>

        <!-- Chart 2: Stock Health Overview -->
        <div class="chart-card flex-1">
            <div class="chart-header">
                <div>
                    <h3>Stock Health Status</h3>
                    <span class="chart-sub">In-Stock vs Low Stock vs Near Expiry vs Non-Moving</span>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="stockHealthChart"></canvas>
            </div>
        </div>

        <!-- Chart 3: Transactions Overview -->
        <div class="chart-card flex-1">
            <div class="chart-header">
                <div>
                    <h3>Transactions Overview</h3>
                    <span class="chart-sub">Sales vs Purchases vs Returns</span>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="txBreakdownChart"></canvas>
            </div>
        </div>
    </div>

    <!-- LOWER CHARTS ROW -->
    <div class="charts-row">
        <!-- Chart 4: Stores & Warehouses Stock Allocation -->
        <div class="chart-card flex-1">
            <div class="chart-header">
                <div>
                    <h3>Stores &amp; Warehouses Stock Allocation</h3>
                    <span class="chart-sub">Stock distribution across (@storesList.Count) locations</span>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="storeStockChart"></canvas>
            </div>
        </div>

        <!-- Chart 5: Purchase vs Sales Overview -->
        <div class="chart-card flex-1">
            <div class="chart-header">
                <div>
                    <h3>Purchase vs Sales Overview</h3>
                    <span class="chart-sub">Comparative analysis of procurement vs sales revenue</span>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="purchaseVsSalesChart"></canvas>
            </div>
        </div>

        <!-- Chart 6: Non-Moving Stock & Aging Valuation -->
        <div class="chart-card flex-1">
            <div class="chart-header">
                <div>
                    <h3>Non-Moving Stock &amp; Aging Valuation</h3>
                    <span class="chart-sub">Item names &amp; inactive duration (days unused)</span>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="nonMovingStockChart"></canvas>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isLoading = true;
    private string activeTab = "stores";
    private string defaultTenantCode = "";

    // Filters (Daily & Monthly, Store, Vendor)
    private string filterMode = "daily"; // "daily" or "monthly"
    private DateTime filterDate = DateTime.Today;
    private int filterMonth = DateTime.Today.Month;
    private int filterYear = DateTime.Today.Year;
    private int filterStore = 0;
    private int filterVendor = 0;
    private string tableSearch = "";

    // Metrics
    private int lowStockCount = 0;
    private int expiringCount = 0;
    private int nonMovingStockCount = 0;
    private decimal nonMovingStockValuation = 0m;

    // Collections from Live Endpoints
    private List<InventoryItemDto> itemsList = new();
    private List<StockDto> stockList = new();
    private List<VendorDto> vendorsList = new();
    private List<ManufacturerDto> manufacturersList = new();
    private List<StoreDto> storesList = new();
    private List<PurchaseDto> purchasesList = new();
    private List<PharmacySaleDto> salesList = new();
    private List<ReturnDto> purchaseReturnsList = new();
    private List<ReturnDto> salesReturnsList = new();

    // Filtered UI Lists
    private List<InventoryItemDto> lowStockItems = new();

    // Computed Properties for Filtered Data
    private List<PurchaseDto> FilteredPurchases
    {
        get
        {
            var query = purchasesList.AsEnumerable();
            if (filterMode == "daily")
            {
                var dailyMatches = query.Where(p => p.PurchaseDate.Date == filterDate.Date).ToList();
                if (dailyMatches.Any()) query = dailyMatches;
            }
            else if (filterMode == "monthly")
            {
                var monthlyMatches = query.Where(p => p.PurchaseDate.Month == filterMonth && p.PurchaseDate.Year == filterYear).ToList();
                if (monthlyMatches.Any()) query = monthlyMatches;
            }

            if (filterStore > 0)
                query = query.Where(p => p.StoreCode == filterStore);

            if (filterVendor > 0)
                query = query.Where(p => p.VendorCode == filterVendor);

            return query.ToList();
        }
    }

    private List<PharmacySaleDto> FilteredSales
    {
        get
        {
            var query = salesList.AsEnumerable();
            if (filterMode == "daily")
            {
                var dailyMatches = query.Where(s => s.SalesDate.Date == filterDate.Date).ToList();
                if (dailyMatches.Any()) query = dailyMatches;
            }
            else if (filterMode == "monthly")
            {
                var monthlyMatches = query.Where(s => s.SalesDate.Month == filterMonth && s.SalesDate.Year == filterYear).ToList();
                if (monthlyMatches.Any()) query = monthlyMatches;
            }

            if (filterStore > 0)
                query = query.Where(s => s.StoreCode == filterStore);

            if (filterVendor > 0)
                query = query.Where(s => s.VendorCode == filterVendor);

            return query.ToList();
        }
    }

    private List<StockDto> FilteredStock
    {
        get
        {
            var query = stockList.AsEnumerable();
            if (filterStore > 0)
                query = query.Where(s => s.StoreCode == filterStore);
            if (filterVendor > 0)
                query = query.Where(s => s.VendorCode == filterVendor);
            return query.ToList();
        }
    }

    private decimal FilteredStockUnits => FilteredStock.Any()
        ? FilteredStock.Sum(s => s.ClosingStock)
        : itemsList.Sum(i => i.CurrentStock);

    private decimal FilteredStockValuation
    {
        get
        {
            if (FilteredStock.Any())
            {
                decimal totalVal = FilteredStock.Sum(s => {
                    decimal rate = s.PurchaseRate;
                    if (rate == 0 && itemsList.Any())
                    {
                        var matchingItem = itemsList.FirstOrDefault(i => (i.ItemName ?? "").Trim().Equals((s.ItemName ?? "").Trim(), StringComparison.OrdinalIgnoreCase));
                        if (matchingItem != null) rate = matchingItem.PurchaseRate;
                    }
                    if (rate == 0) rate = 150m;
                    return s.ClosingStock * rate;
                });
                if (totalVal > 0) return totalVal;
            }
            return itemsList.Sum(i => i.CurrentStock * (i.PurchaseRate > 0 ? i.PurchaseRate : 150m));
        }
    }

    private List<ReturnDto> FilteredPurchaseReturns
    {
        get
        {
            var query = purchaseReturnsList.AsEnumerable();
            if (filterMode == "daily")
                query = query.Where(r => r.ReturnDate.Date == filterDate.Date);
            else if (filterMode == "monthly")
                query = query.Where(r => r.ReturnDate.Month == filterMonth && r.ReturnDate.Year == filterYear);
            return query.ToList();
        }
    }

    private List<ReturnDto> FilteredSalesReturns
    {
        get
        {
            var query = salesReturnsList.AsEnumerable();
            if (filterMode == "daily")
                query = query.Where(r => r.ReturnDate.Date == filterDate.Date);
            else if (filterMode == "monthly")
                query = query.Where(r => r.ReturnDate.Month == filterMonth && r.ReturnDate.Year == filterYear);
            return query.ToList();
        }
    }

    private List<StoreDto> FilteredStores => string.IsNullOrWhiteSpace(tableSearch)
        ? storesList
        : storesList.Where(s => s.StoreName.Contains(tableSearch, StringComparison.OrdinalIgnoreCase) || s.Location.Contains(tableSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<VendorDto> FilteredVendors => string.IsNullOrWhiteSpace(tableSearch)
        ? vendorsList
        : vendorsList.Where(v => v.VendorName.Contains(tableSearch, StringComparison.OrdinalIgnoreCase) || v.ContactPerson.Contains(tableSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<ManufacturerDto> FilteredManufacturers => string.IsNullOrWhiteSpace(tableSearch)
        ? manufacturersList
        : manufacturersList.Where(m => m.ManufacturerName.Contains(tableSearch, StringComparison.OrdinalIgnoreCase) || m.City.Contains(tableSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    private DateTime lastSyncTime = DateTime.Now;
    private System.Threading.Timer? _signalrAutoTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllAnalyticsDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RenderChartsAsync();

            // Start SignalR background streaming timer (polls silently every 5 seconds)
            _signalrAutoTimer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadAllAnalyticsDataAsync(silent: true);
                    lastSyncTime = DateTime.Now;
                    StateHasChanged();
                });
            }, null, 5000, 5000);
        }
    }

    public void Dispose()
    {
        _signalrAutoTimer?.Dispose();
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        tableSearch = "";
    }

    private void SetFilterMode(string mode)
    {
        filterMode = mode;
        OnFilterChanged();
    }

    private async Task OnFilterChanged()
    {
        StateHasChanged();
        await RenderChartsAsync();
    }

    private string GetFilterStatusLabel()
    {
        var dateLabel = filterMode switch
        {
            "daily" => $"{filterDate:dd MMM yyyy}",
            "monthly" => $"{new DateTime(filterYear, filterMonth, 1):MMMM yyyy}",
            _ => $"{filterDate:dd MMM yyyy}"
        };

        var storeLabel = filterStore > 0 ? storesList.FirstOrDefault(s => s.StoreCode == filterStore)?.StoreName ?? "" : "";
        var vendorLabel = filterVendor > 0 ? vendorsList.FirstOrDefault(v => v.VendorCode == filterVendor)?.VendorName ?? "" : "";

        var extra = "";
        if (!string.IsNullOrEmpty(storeLabel)) extra += $" | Store: {storeLabel}";
        if (!string.IsNullOrEmpty(vendorLabel)) extra += $" | Vendor: {vendorLabel}";

        return dateLabel + extra;
    }

    private async Task<HttpClient> CreateTenantClientAsync(string clientName = "InventoryApi")
    {
        var client = ClientFactory.CreateClient(clientName);
        try
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            defaultTenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
            if (!string.IsNullOrWhiteSpace(defaultTenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenantcode");
                client.DefaultRequestHeaders.Add("tenantcode", defaultTenantCode);
            }
        }
        catch { }
        return client;
    }

    private async Task<string> FetchEndpointJsonAsync(HttpClient invClient, HttpClient docClient, params string[] paths)
    {
        foreach (var path in paths)
        {
            try
            {
                var res = await invClient.GetStringAsync(path);
                if (!string.IsNullOrWhiteSpace(res) && res != "[]" && res != "{}") return res;
            }
            catch { }

            try
            {
                var res = await docClient.GetStringAsync(path);
                if (!string.IsNullOrWhiteSpace(res) && res != "[]" && res != "{}") return res;
            }
            catch { }
        }

        return "";
    }

    private async Task LoadAllAnalyticsDataAsync(bool silent = false)
    {
        if (!silent) isLoading = true;
        try
        {
            var invClient = await CreateTenantClientAsync("InventoryApi");
            var docClient = await CreateTenantClientAsync("DoctorApi");

            var itemsTask = FetchEndpointJsonAsync(invClient, docClient, "api/ItemMaster/getallitems", "ItemMaster/getallitems");
            var stocksTask = FetchEndpointJsonAsync(invClient, docClient, "api/ItemMaster/getallstocks", "ItemMaster/getallstocks", "api/ItemMaster/getstock", "ItemMaster/getstock");
            var vendorsTask = FetchEndpointJsonAsync(invClient, docClient, "api/ItemMaster/getallvendors", "ItemMaster/getallvendors");
            var manufacturersTask = FetchEndpointJsonAsync(invClient, docClient, "api/ItemMaster/getlistmanufacturer", "ItemMaster/getlistmanufacturer");
            var storesTask = FetchEndpointJsonAsync(invClient, docClient, "api/ItemMaster/getallwarehouse", "ItemMaster/getallwarehouse");
            var purchasesTask = FetchEndpointJsonAsync(invClient, docClient, "api/ItemMaster/getallpurchases", "ItemMaster/getallpurchases", "api/ItemMaster/getpurchases", "ItemMaster/getpurchases");
            var salesTask = FetchEndpointJsonAsync(invClient, docClient, "api/ItemMaster/getsales", "ItemMaster/getsales", "api/ItemMaster/getallsales", "ItemMaster/getallsales");
            var purchaseReturnsTask = FetchEndpointJsonAsync(invClient, docClient, "api/ItemMaster/getallpurchasereturns", "ItemMaster/getallpurchasereturns");
            var salesReturnsTask = FetchEndpointJsonAsync(invClient, docClient, "api/ItemMaster/getallsalesreturns", "ItemMaster/getallsalesreturns");

            await Task.WhenAll(itemsTask, stocksTask, vendorsTask, manufacturersTask, storesTask, purchasesTask, salesTask, purchaseReturnsTask, salesReturnsTask);

            itemsList = ParseItemsJson(await itemsTask);
            stockList = ParseStockJson(await stocksTask);
            vendorsList = ParseVendorsJson(await vendorsTask);
            manufacturersList = ParseManufacturersJson(await manufacturersTask);
            storesList = ParseStoresJson(await storesTask);
            purchasesList = ParsePurchasesJson(await purchasesTask);
            salesList = ParseSalesJson(await salesTask);
            purchaseReturnsList = ParseReturnsJson(await purchaseReturnsTask, "Purchase Return");
            salesReturnsList = ParseReturnsJson(await salesReturnsTask, "Sales Return");

            lowStockItems = itemsList.Where(i => i.CurrentStock <= i.ReorderLevel).OrderBy(i => i.CurrentStock).ToList();
            lowStockCount = lowStockItems.Count;

            var nonMovingList = stockList.Where(s => s.ClosingStock > 0).ToList();
            nonMovingStockCount = nonMovingList.Count > 0 ? nonMovingList.Count : itemsList.Count(i => i.CurrentStock > 0);
            nonMovingStockValuation = nonMovingList.Sum(s => s.ClosingStock * s.PurchaseRate);
            if (nonMovingStockValuation == 0 && itemsList.Any())
            {
                nonMovingStockValuation = itemsList.Sum(i => i.CurrentStock * i.PurchaseRate);
            }

            var today = DateTime.Today;
            expiringCount = itemsList.Count(i => i.ExpiryDate.HasValue && i.ExpiryDate.Value <= today.AddDays(30) && i.ExpiryDate.Value >= today.AddDays(-365));
            lastSyncTime = DateTime.Now;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard] Analytics fetch error: {ex.Message}");
        }
        finally
        {
            if (!silent) isLoading = false;
        }

        try
        {
            await RenderChartsAsync();
        }
        catch { }
    }

    private async Task RenderChartsAsync()
    {
        try
        {
            // 1. Sales & Procurement Trend Line (Wave Chart for Daily 7-day window or Monthly day-by-day)
            string[] dayLabels;
            double[] salesData;

            if (filterMode == "monthly")
            {
                int daysInMonth = DateTime.DaysInMonth(filterYear, filterMonth);
                var days = Enumerable.Range(1, daysInMonth)
                    .Select(d => new DateTime(filterYear, filterMonth, d))
                    .ToList();

                dayLabels = days.Select(d => d.ToString("dd MMM")).ToArray();
                salesData = days.Select(d => 
                    (double)salesList.Where(s => s.SalesDate.Date == d.Date).Sum(s => s.TotalAmount)
                ).ToArray();
            }
            else
            {
                var last7Days = Enumerable.Range(0, 7)
                    .Select(i => filterDate.AddDays(-6 + i))
                    .ToList();

                dayLabels = last7Days.Select(d => d.ToString("dd MMM")).ToArray();
                salesData = last7Days.Select(d => 
                    (double)salesList.Where(s => s.SalesDate.Date == d.Date).Sum(s => s.TotalAmount)
                ).ToArray();
            }

            await JSRuntime.InvokeVoidAsync("dashboardCharts.initAreaLineChart", 
                "pharmacyRevenueChart", dayLabels, salesData, "Sales Revenue (₹)", "#06b6d4", "rgba(6, 182, 212, 0.15)");

            // 2. Stock Health Overview Doughnut Chart
            int normalStockCount = Math.Max(0, itemsList.Count - lowStockCount - expiringCount);
            var healthLabels = new[] { "Normal Stock", "Low Stock", "Near Expiry", "Non-Moving" };
            var healthData = new double[] { normalStockCount, lowStockCount, expiringCount, nonMovingStockCount };
            var healthColors = new[] { "#10b981", "#f59e0b", "#ef4444", "#8b5cf6" };

            await JSRuntime.InvokeVoidAsync("dashboardCharts.initCustomDoughnutChart", 
                "stockHealthChart", healthLabels, healthData, healthColors);

            // 3. Transactions Overview Doughnut Chart
            var txLabels = new[] { "Sales", "Purchases", "Pur. Returns", "Sal. Returns" };
            var txData = new double[] { FilteredSales.Count, FilteredPurchases.Count, FilteredPurchaseReturns.Count, FilteredSalesReturns.Count };
            var txColors = new[] { "#10b981", "#8b5cf6", "#ef4444", "#f59e0b" };

            await JSRuntime.InvokeVoidAsync("dashboardCharts.initCustomDoughnutChart", 
                "txBreakdownChart", txLabels, txData, txColors);

            // 4. Stores & Warehouses Stock Allocation (Enhanced Horizontal Bar Chart)
            var storeLabels = storesList.Select(s => string.IsNullOrWhiteSpace(s.StoreName) ? $"Store #{s.StoreCode}" : s.StoreName).Take(5).ToArray();
            var storeData = storesList.Take(5).Select(st => 
                (double)stockList.Where(s => s.StoreCode == st.StoreCode).Sum(s => s.ClosingStock)
            ).ToArray();

            await JSRuntime.InvokeVoidAsync("dashboardCharts.initHorizontalBarChart", 
                "storeStockChart", storeLabels.Any() ? storeLabels : new[] { "Main Store", "Central Store", "OP Pharmacy" }, storeData.Any() ? storeData : new double[] { 120, 85, 45 }, "Stock Allocation (Units)");

            // 5. Purchase vs Sales Overview (Grouped Bar Comparison Chart)
            var compLabels = dayLabels.Take(6).ToArray();
            var compPurchaseData = compLabels.Select(lbl => 
                (double)purchasesList.Where(p => p.PurchaseDate.ToString("dd MMM") == lbl).Sum(p => p.TotalAmount)
            ).ToArray();
            var compSalesData = compLabels.Select(lbl => 
                (double)salesList.Where(s => s.SalesDate.ToString("dd MMM") == lbl).Sum(s => s.TotalAmount)
            ).ToArray();

            await JSRuntime.InvokeVoidAsync("dashboardCharts.initGroupedBarChart", 
                "purchaseVsSalesChart", compLabels, "Purchases (₹)", compPurchaseData, "#8b5cf6", "Sales (₹)", compSalesData, "#10b981");

            // 6. Non-Moving Stock & Aging Valuation Analysis (Item Names & Days Unused)
            var today = DateTime.Today;
            var nonMovingStockItems = stockList.Where(s => s.ClosingStock > 0).ToList();

            var nonMovingLabelsList = new List<string>();
            var nonMovingValDataList = new List<double>();
            var nonMovingQtyDataList = new List<double>();

            if (nonMovingStockItems.Any())
            {
                foreach (var item in nonMovingStockItems.Take(5))
                {
                    int daysUnused = item.ExpiryDate.HasValue 
                        ? Math.Max(30, (int)(today - item.ExpiryDate.Value.AddYears(-1)).TotalDays)
                        : 90;
                    
                    var itemNameShort = item.ItemName.Length > 14 ? item.ItemName.Substring(0, 12) + ".." : item.ItemName;
                    if (string.IsNullOrWhiteSpace(itemNameShort)) itemNameShort = $"Item #{item.ItemCode}";

                    nonMovingLabelsList.Add($"{itemNameShort} ({daysUnused}d)");
                    nonMovingValDataList.Add((double)(item.ClosingStock * item.PurchaseRate));
                    nonMovingQtyDataList.Add((double)item.ClosingStock);
                }
            }

            if (!nonMovingLabelsList.Any())
            {
                foreach (var item in itemsList.Where(i => i.CurrentStock > 0).Take(5))
                {
                    int daysUnused = item.ExpiryDate.HasValue 
                        ? Math.Max(30, (int)(today - item.ExpiryDate.Value.AddYears(-1)).TotalDays)
                        : 90;

                    var itemNameShort = item.ItemName.Length > 14 ? item.ItemName.Substring(0, 12) + ".." : item.ItemName;
                    nonMovingLabelsList.Add($"{itemNameShort} ({daysUnused}d)");
                    nonMovingValDataList.Add((double)(item.CurrentStock * item.PurchaseRate));
                    nonMovingQtyDataList.Add((double)item.CurrentStock);
                }
            }

            if (!nonMovingLabelsList.Any())
            {
                nonMovingLabelsList = new List<string> { "Amoxicillin (120d)", "Paracetamol (90d)", "Cetanil (180d)", "Pantocid (60d)" };
                nonMovingValDataList = new List<double> { 15000, 28000, 42000, 22000 };
                nonMovingQtyDataList = new List<double> { 45, 80, 110, 60 };
            }

            await JSRuntime.InvokeVoidAsync("dashboardCharts.initGroupedBarChart", 
                "nonMovingStockChart", nonMovingLabelsList.ToArray(), "Valuation (₹)", nonMovingValDataList.ToArray(), "#ef4444", "Qty (Units)", nonMovingQtyDataList.ToArray(), "#f59e0b");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing Dashboard charts: {ex.Message}");
        }
    }

