    private List<InventoryItemDto> ParseItemsJson(string json)
    {
        var list = new List<InventoryItemDto>();
        if (string.IsNullOrWhiteSpace(json)) return list;
        try
        {
            using var doc = JsonDocument.Parse(json);
            JsonElement root = doc.RootElement;
            if (root.ValueKind == JsonValueKind.Object)
            {
                if (root.TryGetProperty("data", out var dataArr)) root = dataArr;
                else if (root.TryGetProperty("value", out var valArr)) root = valArr;
            }
            if (root.ValueKind == JsonValueKind.Array)
            {
                foreach (var el in root.EnumerateArray())
                {
                    var dto = new InventoryItemDto();
                    if (el.TryGetProperty("itemname", out var iname) || el.TryGetProperty("item_name", out iname)) dto.ItemName = iname.GetString() ?? "";
                    if (el.TryGetProperty("categoryname", out var cname) || el.TryGetProperty("category_name", out cname)) dto.CategoryName = cname.GetString() ?? "General";
                    if (el.TryGetProperty("currentstock", out var cs) || el.TryGetProperty("current_stock", out cs) || el.TryGetProperty("closingstock", out cs) || el.TryGetProperty("closing_stock", out cs) || el.TryGetProperty("qty", out cs))
                    {
                        if (cs.ValueKind == JsonValueKind.Number) dto.CurrentStock = cs.GetDecimal();
                    }
                    if (el.TryGetProperty("reorderlevel", out var rl) || el.TryGetProperty("reorder_level", out rl))
                    {
                        if (rl.ValueKind == JsonValueKind.Number) dto.ReorderLevel = rl.GetDecimal();
                    }
                    if (el.TryGetProperty("purchaserate", out var pr) || el.TryGetProperty("purchase_rate", out pr) || el.TryGetProperty("rate", out pr))
                    {
                        if (pr.ValueKind == JsonValueKind.Number) dto.PurchaseRate = pr.GetDecimal();
                    }
                    if (!string.IsNullOrEmpty(dto.ItemName)) list.Add(dto);
                }
            }
        }
        catch { }
        return list;
    }

    private List<StockDto> ParseStockJson(string json)
    {
        var list = new List<StockDto>();
        if (string.IsNullOrWhiteSpace(json)) return list;
        try
        {
            using var doc = JsonDocument.Parse(json);
            JsonElement root = doc.RootElement;
            if (root.ValueKind == JsonValueKind.Object)
            {
                if (root.TryGetProperty("data", out var dataArr)) root = dataArr;
                else if (root.TryGetProperty("value", out var valArr)) root = valArr;
                else
                {
                    foreach (var prop in root.EnumerateObject())
                    {
                        if (prop.Value.ValueKind == JsonValueKind.Array) { root = prop.Value; break; }
                    }
                }
            }

            if (root.ValueKind == JsonValueKind.Array)
            {
                foreach (var el in root.EnumerateArray())
                {
                    var target = el;
                    if (el.ValueKind == JsonValueKind.Object && el.TryGetProperty("master", out var mProp)) target = mProp;

                    if (target.TryGetProperty("deleted", out var del) && del.ValueKind == JsonValueKind.True) continue;

                    var dto = new StockDto();
                    if (target.TryGetProperty("itemcode", out var ic) || target.TryGetProperty("item_code", out ic))
                    {
                        if (ic.ValueKind == JsonValueKind.Number) dto.ItemCode = ic.GetInt32();
                    }
                    if (target.TryGetProperty("itemname", out var iname) || target.TryGetProperty("item_name", out iname)) dto.ItemName = iname.GetString() ?? "";

                    if (target.TryGetProperty("closingstock", out var cs) || target.TryGetProperty("closing_stock", out cs) || target.TryGetProperty("currentstock", out cs) || target.TryGetProperty("current_stock", out cs) || target.TryGetProperty("qty", out cs) || target.TryGetProperty("quantity", out cs) || target.TryGetProperty("availableqty", out cs))
                    {
                        if (cs.ValueKind == JsonValueKind.Number) dto.ClosingStock = cs.GetDecimal();
                        else if (cs.ValueKind == JsonValueKind.String && decimal.TryParse(cs.GetString(), out var val)) dto.ClosingStock = val;
                    }

                    decimal rate = 0m;
                    if (target.TryGetProperty("unitcost", out var uc) || target.TryGetProperty("unit_cost", out uc) || target.TryGetProperty("purchaserate", out uc) || target.TryGetProperty("purchase_rate", out uc) || target.TryGetProperty("mrp", out uc) || target.TryGetProperty("unitrate", out uc) || target.TryGetProperty("rate", out uc) || target.TryGetProperty("cost", out uc))
                    {
                        if (uc.ValueKind == JsonValueKind.Number) rate = uc.GetDecimal();
                        else if (uc.ValueKind == JsonValueKind.String && decimal.TryParse(uc.GetString(), out var val)) rate = val;
                    }

                    if (rate == 0m && (target.TryGetProperty("stockvalue", out var sv) || target.TryGetProperty("stock_value", out sv)))
                    {
                        decimal sVal = 0m;
                        if (sv.ValueKind == JsonValueKind.Number) sVal = sv.GetDecimal();
                        else if (sv.ValueKind == JsonValueKind.String && decimal.TryParse(sv.GetString(), out var val)) sVal = val;

                        if (sVal > 0 && dto.ClosingStock > 0) rate = sVal / dto.ClosingStock;
                        else if (sVal > 0) rate = sVal;
                    }

                    dto.PurchaseRate = rate;

                    if (target.TryGetProperty("warehousecode", out var wc) || target.TryGetProperty("warehouse_code", out wc) || target.TryGetProperty("storecode", out wc) || target.TryGetProperty("store_code", out wc))
                    {
                        if (wc.ValueKind == JsonValueKind.Number) dto.StoreCode = wc.GetInt32();
                        else if (wc.ValueKind == JsonValueKind.String && int.TryParse(wc.GetString(), out int code)) dto.StoreCode = code;
                    }

                    if (target.TryGetProperty("vendorcode", out var vc) || target.TryGetProperty("vendor_code", out vc))
                    {
                        if (vc.ValueKind == JsonValueKind.Number) dto.VendorCode = vc.GetInt32();
                        else if (vc.ValueKind == JsonValueKind.String && int.TryParse(vc.GetString(), out int code)) dto.VendorCode = code;
                    }

                    if (target.TryGetProperty("expirydate", out var ed) || target.TryGetProperty("expiry_date", out ed) || target.TryGetProperty("expdate", out ed) || target.TryGetProperty("exp_date", out ed))
                    {
                        if (ed.ValueKind == JsonValueKind.String && DateTime.TryParse(ed.GetString(), out var dt)) dto.ExpiryDate = dt;
                    }

                    list.Add(dto);
                }
            }
        }
        catch { }
        return list;
    }

