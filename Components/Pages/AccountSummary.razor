    private async Task LoadSummaryAsync()
    {
        isLoading = true;
        errorMessage = "";
        StateHasChanged();

        try
        {
            var client = ClientFactory.CreateClient("Medico");
            client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Remove("tenantcode");
            client.DefaultRequestHeaders.TryAddWithoutValidation("tenant_code", DefaultTenant);
            client.DefaultRequestHeaders.TryAddWithoutValidation("tenantcode", DefaultTenant);
            if (!string.IsNullOrWhiteSpace(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }

            var queryParams = new List<string>
            {
                $"fromdate={fromDate:yyyy-MM-dd}",
                $"todate={toDate:yyyy-MM-dd}",
                $"tenant_code={Uri.EscapeDataString(DefaultTenant)}"
            };
            if (selectedBhCode > 0)
            {
                queryParams.Add($"bhcode={selectedBhCode}");
            }
            if (selectedCntCode > 0)
            {
                queryParams.Add($"cntcode={selectedCntCode}");
            }

            var url = $"api/HmsBilling/reports/fast-collection-summary?{string.Join("&", queryParams)}";
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            using var response = await client.GetAsync(url, timeout.Token);
            response.EnsureSuccessStatusCode();

            var json = await response.Content.ReadAsStringAsync();
            reportData = DeserializeFastCollectionSummary(json);

            pharmacySalesReturnError = "";
            if (reportData?.categories?.Any(row => IsPharmacyCategory(row.category) && row.sales_return.HasValue) != true)
            {
                await LoadPharmacySalesReturnsAsync();
            }
            else
            {
                pharmacySalesReturns.Clear();
            }

            if (reportData == null)
            {
                errorMessage = "Account Summary could not be loaded. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AccountSummary] Error loading summary: {ex.Message}");
            errorMessage = "Account Summary could not be loaded. Please try again.";
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private static HmsOpCategoryCollectionResponse? DeserializeFastCollectionSummary(string json)
    {
        using var document = JsonDocument.Parse(json);
        var root = document.RootElement;

        while (root.ValueKind == JsonValueKind.Object)
        {
            JsonElement? payload = null;
            foreach (var property in root.EnumerateObject())
            {
                if (property.Value.ValueKind == JsonValueKind.Object &&
                    (string.Equals(property.Name, "data", StringComparison.OrdinalIgnoreCase) ||
                     string.Equals(property.Name, "result", StringComparison.OrdinalIgnoreCase) ||
                     string.Equals(property.Name, "value", StringComparison.OrdinalIgnoreCase)))
                {
                    payload = property.Value;
                    break;
                }
            }

            if (!payload.HasValue)
            {
                break;
            }

            root = payload.Value;
        }

        if (root.ValueKind != JsonValueKind.Object)
        {
            throw new JsonException("Fast collection summary did not return a JSON object.");
        }

        var rootFields = root
            .EnumerateObject()
            .Select(property => property.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (!rootFields.Contains("totals") || !rootFields.Contains("department_summary"))
        {
            throw new JsonException("Fast collection summary returned an unsupported response shape.");
        }

        var fastSummary = JsonSerializer.Deserialize<HmsFastCollectionSummaryResponse>(
            root.GetRawText(),
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        if (fastSummary?.totals == null ||
            fastSummary.department_summary == null ||
            fastSummary.paymode_wise == null)
        {
            throw new JsonException("Fast collection summary is missing required report data.");
        }

        var categories = fastSummary.department_summary
            .Select(department =>
            {
                var billPaymodes = fastSummary.paymode_wise
                    .Where(mode =>
                        string.Equals(mode.dept, department.dept, StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(mode.source, "BILL", StringComparison.OrdinalIgnoreCase))
                    .GroupBy(mode => mode.paymode?.Trim() ?? "", StringComparer.OrdinalIgnoreCase)
                    .Where(group => !string.IsNullOrWhiteSpace(group.Key))
                    .Select(group => new HmsOpPaymodeAmount
                    {
                        paymode = group.Key,
                        amount = group.Sum(mode => mode.amount)
                    })
                    .ToList();

                return new HmsOpCategoryAmountRow
                {
                    category = department.dept,
                    visit_count = department.visit_count,
                    bill_count = department.bill_count,
                    gross_amount = department.gross_amount,
                    discount_amount = department.discount_amount,
                    net_amount = department.net_amount,
                    collected_amount = department.collected_amount,
                    collected = department.collected_amount,
                    due_amount = department.due_amount,
                    due = department.due_amount,
                    advance_adjusted = department.advance_used,
                    total_collected = department.total_collected,
                    due_collected = department.due_collected,
                    sales_return = department.sales_return,
                    cancelled_bill_total_amount = department.cancelled_bill_total_amount,
                    paymodes = billPaymodes
                };
            })
            .ToList();

        var ipDepartment = fastSummary.department_summary.FirstOrDefault(
            department => IsIpCategory(department.dept));
        var ipCategory = categories.FirstOrDefault(category => IsIpCategory(category.category));
        var duePaymodes = fastSummary.paymode_wise
            .Where(mode =>
                !string.IsNullOrWhiteSpace(mode.source) &&
                mode.source.Contains("DUE", StringComparison.OrdinalIgnoreCase))
            .Select(mode => new HmsOpPaymodeAmount
            {
                paymode = mode.paymode,
                amount = mode.amount
            })
            .ToList();
        var advancePaymodes = fastSummary.advance_deposited_paymodes ?? new List<HmsOpPaymodeAmount>();
        if (advancePaymodes.Count == 0)
        {
            advancePaymodes = FindAdvanceDepositedPaymodes(root);
        }

        return new HmsOpCategoryCollectionResponse
        {
            fromdate = fastSummary.fromdate,
            todate = fastSummary.todate,
            total_visits = fastSummary.department_summary.Sum(department => department.visit_count),
            total_gross = fastSummary.totals.gross_amount,
            total_discount = fastSummary.totals.discount_amount,
            total_net = fastSummary.totals.net_amount,
            total_collected = fastSummary.totals.total_collected,
            total_due = fastSummary.totals.due_amount,
            total_bill_amount = fastSummary.totals.gross_amount,
            total_ip_amount = ipCategory == null ? 0 : CategoryBillAmount(ipCategory),
            ip_bill_count = ipDepartment?.bill_count ?? 0,
            ip_total_collected = ipDepartment?.total_collected ?? 0,
            ip_advance_collected = ipDepartment?.advance_deposited ?? 0,
            ip_advance_used = ipDepartment?.advance_used ?? 0,
            ip_advance_refunded = ipDepartment?.advance_refunded ?? 0,
            ip_cash_collected = ipCategory?.paymodes
                .Where(mode => HmsOpCategoryAmountRow.IsCash(mode.paymode, mode.pmcode))
                .Sum(mode => mode.amount) ?? 0,
            ip_upi_collected = ipCategory?.paymodes
                .Where(mode => HmsOpCategoryAmountRow.IsUpi(mode.paymode, mode.pmcode))
                .Sum(mode => mode.amount) ?? 0,
            ip_other_collected = ipCategory?.paymodes
                .Where(mode => !HmsOpCategoryAmountRow.IsCash(mode.paymode, mode.pmcode) &&
                               !HmsOpCategoryAmountRow.IsUpi(mode.paymode, mode.pmcode))
                .Sum(mode => mode.amount) ?? 0,
            ip_paymodes = ipCategory?.paymodes ?? new(),
            total_due_cleared = fastSummary.totals.due_collected,
            due_cleared_today = fastSummary.totals.due_collected,
            due_cleared_by_paymode = duePaymodes,
            total_advance_collected = fastSummary.totals.advance_deposited,
            advance_collected = fastSummary.totals.advance_deposited,
            advance_collected_by_paymode = advancePaymodes,
            total_advance_used = fastSummary.totals.advance_used,
            advance_used = fastSummary.totals.advance_used,
            total_advance_refunded = fastSummary.totals.advance_refunded,
            advance_refunded = fastSummary.totals.advance_refunded,
            cancelled_bill_count = GetCancelledBillCount(root),
            cancelled_bill_total_amount = GetCancelledBillAmount(root, fastSummary),
            categories = categories
        };
    }

    private static int GetCancelledBillCount(JsonElement root)
    {
        var totals = FindJsonProperty(root, "totals");
        var reportedCount = GetJsonNumber(root, "cancelled_bill_count")
            ?? (totals.HasValue ? GetJsonNumber(totals.Value, "cancelled_bill_count") : null);
        if (reportedCount.GetValueOrDefault() > 0)
        {
            return (int)reportedCount.Value;
        }

        var cancelledBills = FindJsonProperty(root, "cancelled_bills");
        if (!cancelledBills.HasValue && totals.HasValue)
        {
            cancelledBills = FindJsonProperty(totals.Value, "cancelled_bills");
        }

        return cancelledBills?.ValueKind == JsonValueKind.Array
            ? cancelledBills.Value.GetArrayLength()
            : 0;
    }

    private static double GetCancelledBillAmount(JsonElement root, HmsFastCollectionSummaryResponse fastSummary)
    {
        var totals = FindJsonProperty(root, "totals");
        var reportedAmounts = new[]
        {
            fastSummary.totals.cancelled_bill_total_amount,
            GetJsonNumber(root, "cancelled_bill_amount"),
            GetJsonNumber(root, "cancelled_bill_total_amount"),
            totals.HasValue ? GetJsonNumber(totals.Value, "cancelled_bill_amount") : null,
            totals.HasValue ? GetJsonNumber(totals.Value, "cancelled_bill_total_amount") : null
        };
        var reportedAmount = reportedAmounts.FirstOrDefault(amount => amount.GetValueOrDefault() > 0);
        if (reportedAmount.HasValue)
        {
            return reportedAmount.Value;
        }

        var cancelledBills = FindJsonProperty(root, "cancelled_bills");
        if (!cancelledBills.HasValue && totals.HasValue)
        {
            cancelledBills = FindJsonProperty(totals.Value, "cancelled_bills");
        }
        if (cancelledBills?.ValueKind == JsonValueKind.Array)
        {
            var listedAmount = cancelledBills.Value
                .EnumerateArray()
                .Sum(bill => GetJsonNumber(bill, "amount") ?? GetJsonNumber(bill, "total_amount") ?? 0);
            if (listedAmount > 0)
            {
                return listedAmount;
            }
        }

        return fastSummary.department_summary
            .Sum(department => department.cancelled_bill_total_amount.GetValueOrDefault());
    }

    private static JsonElement? FindJsonProperty(JsonElement element, string propertyName)
    {
        if (element.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        foreach (var property in element.EnumerateObject())
        {
            if (string.Equals(property.Name, propertyName, StringComparison.OrdinalIgnoreCase))
            {
                return property.Value;
            }
        }

        return null;
    }

    private static double? GetJsonNumber(JsonElement element, string propertyName)
    {
        var property = FindJsonProperty(element, propertyName);
        return property.HasValue &&
               property.Value.ValueKind == JsonValueKind.Number &&
               property.Value.TryGetDouble(out var amount)
            ? amount
            : null;
    }

    private static List<HmsOpPaymodeAmount> FindAdvanceDepositedPaymodes(JsonElement element)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in element.EnumerateObject())
            {
                if (string.Equals(property.Name, "advance_deposited_paymodes", StringComparison.OrdinalIgnoreCase) &&
                    property.Value.ValueKind == JsonValueKind.Array)
                {
                    return JsonSerializer.Deserialize<List<HmsOpPaymodeAmount>>(
                        property.Value.GetRawText(),
                        new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                }
            }

            foreach (var property in element.EnumerateObject())
            {
                var nestedPaymodes = FindAdvanceDepositedPaymodes(property.Value);
                if (nestedPaymodes.Count > 0)
                {
                    return nestedPaymodes;
                }
            }
        }
        else if (element.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in element.EnumerateArray())
            {
                var nestedPaymodes = FindAdvanceDepositedPaymodes(item);
                if (nestedPaymodes.Count > 0)
                {
                    return nestedPaymodes;
                }
            }
        }

        return new();
    }

    private async Task LoadPharmacySalesReturnsAsync()
    {
        pharmacySalesReturns = new();
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.TryAddWithoutValidation("tenantcode", DefaultTenant);
        client.DefaultRequestHeaders.TryAddWithoutValidation("tenant_code", DefaultTenant);
        if (!string.IsNullOrWhiteSpace(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }

        var urls = new[]
        {
            $"api/ItemMaster/getallsalesreturn?tenantcode={Uri.EscapeDataString(DefaultTenant)}",
            "api/ItemMaster/getallsalesreturn",
            "ItemMaster/getallsalesreturn",
            $"api/ItemMaster/getallsalesreturns?tenantcode={Uri.EscapeDataString(DefaultTenant)}",
            "api/ItemMaster/getallsalesreturns"
        };
        System.Net.HttpStatusCode? lastStatusCode = null;
        string? lastRequestError = null;

        foreach (var url in urls)
        {
            try
            {
                using var response = await client.GetAsync(url);
                if (!response.IsSuccessStatusCode)
                {
                    lastStatusCode = response.StatusCode;
                    continue;
                }

                var json = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(json))
                {
                    continue;
                }

                using var document = JsonDocument.Parse(json);
                var root = document.RootElement;
                if (root.ValueKind == JsonValueKind.Object)
                {
                    foreach (var property in root.EnumerateObject())
                    {
                        if (string.Equals(property.Name, "data", StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(property.Name, "value", StringComparison.OrdinalIgnoreCase))
                        {
                            root = property.Value;
                            break;
                        }
                    }
                }

                if (root.ValueKind != JsonValueKind.Array)
                {
                    pharmacySalesReturnError = "Pharmacy sales returns were returned in an unsupported format.";
                    return;
                }

                pharmacySalesReturns = JsonSerializer.Deserialize<List<sales_return_master>>(
                    root.GetRawText(),
                    new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true,
                        NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                    }) ?? new();
                return;
            }
            catch (HttpRequestException ex)
            {
                lastRequestError = ex.Message;
            }
            catch (JsonException ex)
            {
                pharmacySalesReturnError = $"Pharmacy sales returns could not be read: {ex.Message}";
                return;
            }
        }

        pharmacySalesReturnError = lastStatusCode.HasValue
            ? $"Pharmacy sales returns could not be loaded (HTTP {(int)lastStatusCode.Value})."
            : $"Pharmacy sales returns could not be loaded: {lastRequestError ?? "No response was returned."}";
    }

