    private void OnBranchChanged()
    {
        if (!FilteredCounters.Any(counter => (int)counter.cntcode == selectedCntCode))
        {
            selectedCntCode = 0;
        }
    }

    private async Task LoadSummaryAsync()
    {
        isLoading = true;
        errorMessage = "";
        pharmacyDataError = "";
        StateHasChanged();

        try
        {
            var reportTask = BillingService.GetOpCategoryCollectionReportAsync(
                fromDate,
                toDate,
                selectedBhCode > 0 ? selectedBhCode : null,
                selectedCntCode > 0 ? selectedCntCode : null,
                tenantCode: DefaultTenant,
                authToken: AuthToken);
            var dueCollectionsTask = PharmacyDueCollectionService.GetAllDueCollectionsAsync(DefaultTenant);
            var salesReturnsTask = LoadSalesReturnRefundsAsync();

            await Task.WhenAll(reportTask, dueCollectionsTask, salesReturnsTask);
            reportData = await reportTask;

            var dueCollectionsResult = await dueCollectionsTask;
            pharmacyDueCollections = dueCollectionsResult.Success ? dueCollectionsResult.Data : new();
            if (!dueCollectionsResult.Success)
            {
                pharmacyDataError = $"Pharmacy due collections could not be loaded: {dueCollectionsResult.Message}";
            }

            var salesReturnsResult = await salesReturnsTask;
            salesReturnRefunds = salesReturnsResult.Success ? salesReturnsResult.Data : new();
            if (!salesReturnsResult.Success)
            {
                var salesReturnError = $"Pharmacy sales returns could not be loaded: {salesReturnsResult.Message}";
                pharmacyDataError = string.IsNullOrEmpty(pharmacyDataError)
                    ? salesReturnError
                    : $"{pharmacyDataError} {salesReturnError}";
            }

            if (reportData == null)
            {
                errorMessage = "Account Summary could not be loaded. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AccountSummary] Error loading summary: {ex.Message}");
            errorMessage = "Account Summary could not be loaded. Please try again.";
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task<(bool Success, string Message, List<sales_return_master> Data)> LoadSalesReturnRefundsAsync()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        var tenantCode = Uri.EscapeDataString(DefaultTenant);
        var urls = new[]
        {
            $"api/ItemMaster/getallsalesreturn?tenantcode={tenantCode}",
            "api/ItemMaster/getallsalesreturn",
            "ItemMaster/getallsalesreturn",
            $"api/ItemMaster/getallsalesreturns?tenantcode={tenantCode}",
            "api/ItemMaster/getallsalesreturns"
        };
        string? lastError = null;

        foreach (var url in urls)
        {
            try
            {
                using var request = new HttpRequestMessage(HttpMethod.Get, url);
                request.Headers.TryAddWithoutValidation("tenantcode", DefaultTenant);
                request.Headers.TryAddWithoutValidation("tenant_code", DefaultTenant);
                request.Headers.TryAddWithoutValidation("tenant-code", DefaultTenant);
                if (!string.IsNullOrWhiteSpace(AuthToken))
                {
                    request.Headers.Authorization =
                        new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
                }

                using var response = await client.SendAsync(request);
                if (!response.IsSuccessStatusCode)
                {
                    lastError = $"HTTP {(int)response.StatusCode} from {url}.";
                    continue;
                }

                var json = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(json))
                {
                    lastError = $"The response from {url} was empty.";
                    continue;
                }

                using var document = JsonDocument.Parse(json);
                var root = document.RootElement;
                for (var depth = 0; depth < 3 && root.ValueKind == JsonValueKind.Object; depth++)
                {
                    if (TryGetJsonProperty(root, out var nested, "data", "value", "result", "records") &&
                        nested.ValueKind is JsonValueKind.Array or JsonValueKind.Object)
                    {
                        root = nested;
                    }
                    else
                    {
                        break;
                    }
                }

                if (root.ValueKind != JsonValueKind.Array)
                {
                    lastError = $"The response from {url} did not contain a sales return list.";
                    continue;
                }

                var records = root.EnumerateArray()
                    .Where(item => item.ValueKind == JsonValueKind.Object)
                    .Select(ParseSalesReturnSummaryRecord)
                    .Where(salesReturn => !salesReturn.deleted)
                    .ToList();
                return (true, "", records);
            }
            catch (Exception ex)
            {
                lastError = $"{url}: {ex.Message}";
            }
        }

        return (false, lastError ?? "No sales return endpoint responded.", new());
    }

    private static sales_return_master ParseSalesReturnSummaryRecord(JsonElement item) => new()
    {
        refundamount = ReadJsonDecimal(item, "refundamount", "refund_amount"),
        paymentmode = ReadJsonText(item, "paymentmode", "payment_mode"),
        referenceno = ReadJsonText(item, "referenceno", "reference_no", "referenceNumber"),
        cnttid = ReadJsonText(item, "cnttid", "countershiftid", "counter_shift_id"),
        bh_code = ReadJsonInt(item, "bh_code", "bhcode", "branchcode"),
        cntcode = ReadJsonDecimal(item, "cntcode", "countercode"),
        tenantcode = ReadJsonText(item, "tenantcode", "tenant_code", "tenantCode"),
        createddate = ReadJsonDate(item, "createddate", "created_date", "returndate", "return_date"),
        deleted = ReadJsonBoolean(item, "deleted")
    };

    private static bool TryGetJsonProperty(JsonElement element, out JsonElement value, params string[] names)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in element.EnumerateObject())
            {
                if (names.Any(name => string.Equals(property.Name, name, StringComparison.OrdinalIgnoreCase)))
                {
                    value = property.Value;
                    return true;
                }
            }
        }

        value = default;
        return false;
    }

    private static string? ReadJsonText(JsonElement element, params string[] names)
    {
        if (!TryGetJsonProperty(element, out var value, names) ||
            value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
        {
            return null;
        }

        return value.ValueKind == JsonValueKind.String ? value.GetString() : value.ToString();
    }

    private static decimal? ReadJsonDecimal(JsonElement element, params string[] names) =>
        decimal.TryParse(
            ReadJsonText(element, names),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out var value)
            ? value
            : null;

    private static int? ReadJsonInt(JsonElement element, params string[] names) =>
        int.TryParse(ReadJsonText(element, names), out var value) ? value : null;

    private static DateTime ReadJsonDate(JsonElement element, params string[] names)
    {
        if (!TryGetJsonProperty(element, out var value, names))
        {
            return default;
        }

        if (value.ValueKind == JsonValueKind.Number && value.TryGetInt64(out var timestamp))
        {
            try
            {
                return timestamp > 1000000000000L
                    ? DateTimeOffset.FromUnixTimeMilliseconds(timestamp).LocalDateTime
                    : DateTimeOffset.FromUnixTimeSeconds(timestamp).LocalDateTime;
            }
            catch (ArgumentOutOfRangeException)
            {
                return default;
            }
        }

        return DateTime.TryParse(
            ReadJsonText(element, names),
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeLocal,
            out var date)
            ? date
            : default;
    }

    private static bool ReadJsonBoolean(JsonElement element, params string[] names)
    {
        if (!TryGetJsonProperty(element, out var value, names))
        {
            return false;
        }

        return value.ValueKind == JsonValueKind.True ||
            (value.ValueKind == JsonValueKind.String && bool.TryParse(value.GetString(), out var parsed) && parsed) ||
            (value.ValueKind == JsonValueKind.Number && value.TryGetInt32(out var number) && number != 0);
    }

    private async Task ResetFiltersAsync()
    {
        fromDate = DateTime.Today;
        toDate = DateTime.Today;
        selectedBhCode = 0;
        selectedCntCode = 0;
        await LoadSummaryAsync();
    }

