@page "/account-summary"
@page "/billing/account-summary"
@rendermode InteractiveServer
@using System.Text.Json
@using Booking.Models
@using Booking.Services
@using SharedComponents.Rcl.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject HmsBillingService BillingService
@inject Booking.Services.PharmacyDueCollectionService PharmacyDueCollectionService
@inject CounterMasterService CounterMasterService
@inject IHttpClientFactory ClientFactory
@inject TenantSessionState TenantState
@inject ProtectedLocalStorage SessionStorage
@inject ToastService ToastService
@inject RoleMasterService RoleService
@implements IDisposable

<PageTitle>Account Summary | Medico</PageTitle>

<div class="account-summary-page">
    @if (!hasViewRight)
    {
        <div class="account-summary-empty account-summary-denied">
            <i class="bi bi-shield-lock"></i>
            <h2>Access denied</h2>
            <p>You do not have permission to view Account Summary.</p>
        </div>
    }
    else
    {
        <header class="account-summary-header">
            <div class="account-summary-heading">
                <div class="account-summary-heading-icon"><i class="bi bi-wallet2"></i></div>
                <div class="account-summary-heading-copy">
                    <h1>Account Summary</h1>
                </div>
            </div>

            <section class="account-summary-filter" aria-label="Account summary filters">
                <div class="account-summary-filter-field">
                    <label for="account-summary-branch"><i class="bi bi-building"></i> Branch</label>
                    <select id="account-summary-branch" class="form-select" @bind="selectedBhCode" @bind:after="OnBranchChanged">
                        <option value="0">All branches</option>
                        @foreach (var branch in branches)
                        {
                            <option value="@branch.bh_code">@branch.name</option>
                        }
                    </select>
                </div>
                <div class="account-summary-filter-field">
                    <label for="account-summary-counter"><i class="bi bi-shop"></i> Counter</label>
                    <select id="account-summary-counter" class="form-select" @bind="selectedCntCode">
                        <option value="0">All counters</option>
                        @foreach (var counter in FilteredCounters)
                        {
                            <option value="@((int)counter.cntcode)">@(string.IsNullOrWhiteSpace(counter.name) ? $"Counter {counter.cntcode}" : counter.name)</option>
                        }
                    </select>
                </div>
                <div class="account-summary-filter-field">
                    <label for="account-summary-from"><i class="bi bi-calendar3"></i> From</label>
                    <input id="account-summary-from" type="date" class="form-control" @bind="fromDate" />
                </div>
                <div class="account-summary-filter-field">
                    <label for="account-summary-to"><i class="bi bi-calendar3"></i> To</label>
                    <input id="account-summary-to" type="date" class="form-control" @bind="toDate" />
                </div>
                <div class="account-summary-filter-actions">
                    <button type="button" class="account-summary-search" @onclick="LoadSummaryAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Loading</span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                            <span>Search</span>
                        }
                    </button>
                    <button type="button" class="account-summary-reset" @onclick="ResetFiltersAsync" disabled="@isLoading">
                        <i class="bi bi-arrow-clockwise"></i>
                        <span>Reset</span>
                    </button>
                </div>
            </section>

            @if (reportData != null)
            {
                <aside class="account-summary-grand-total" aria-label="Total amount collected">
                    <div class="grand-total-heading">
                        <span>Total Amount Collected</span>
                    </div>
                    <strong class="grand-total-amount">@(string.IsNullOrEmpty(pharmacyDataError) ? Money(GrandTotalCollected) : "Unavailable")</strong>
                    <div class="grand-total-modes" aria-label="Cash and UPI split">
                        <span class="grand-total-mode grand-total-cash">
                            <span class="grand-total-mode-label">Cash:</span>
                            <b>@Money(CombinedCashReceived)</b>
                        </span>
                        <span class="grand-total-mode grand-total-upi">
                            <span class="grand-total-mode-label">UPI:</span>
                            <b>@Money(CombinedUpiReceived)</b>
                        </span>
                    </div>
                </aside>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="account-summary-error" role="alert">
                <i class="bi bi-exclamation-circle"></i>
                <span>@errorMessage</span>
            </div>
        }
        else if (isLoading && reportData == null)
        {
            <div class="account-summary-empty">
                <span class="spinner-border text-primary" role="status"></span>
                <span>Loading account summary...</span>
            </div>
        }
        else if (reportData != null)
        {
            <section class="account-summary-overview" aria-label="Hospital and pharmacy totals">
                <div class="account-summary-overview-clinical">
                    <div class="account-summary-overview-heading">
                        <span class="overview-heading-icon clinical-icon"><i class="bi bi-heart-pulse"></i></span>
                        <div>
                            <h2>Hospital</h2>
                            <p>Departments + advance + due − refund − discount</p>
                        </div>
                    </div>
                    <div class="account-summary-stat-grid">
                        <article class="account-summary-stat stat-clinical">
                            <span><i class="bi bi-hospital"></i> Department collection</span>
                            <strong>@Money(ClinicalCollected)</strong>
                            @if (ClinicalCollected > 0)
                            {
                                <small>Cash @Money(ClinicalCash) <b>·</b> UPI @Money(ClinicalUpi)</small>
                            }
                        </article>
                        <article class="account-summary-stat stat-due">
                            <span><i class="bi bi-check2-circle"></i> Due collected</span>
                            <strong>@Money(DueClearedAmount)</strong>
                            <small>Cash @Money(DueClearedCash) <b>·</b> UPI @Money(DueClearedUpi)</small>
                        </article>
                        <article class="account-summary-stat stat-advance">
                            <span><i class="bi bi-piggy-bank"></i> Patient advance</span>
                            <strong>@Money(AdvanceCollected)</strong>
                            <small>Used in bills @Money(AdvanceUsed)</small>
                        </article>
                        <article class="account-summary-stat stat-discount">
                            <span><i class="bi bi-tag"></i> Discount</span>
                            <strong>@Money(ClinicalDiscount)</strong>
                            <small>Across clinical departments</small>
                        </article>
                        <article class="account-summary-stat stat-refund">
                            <span><i class="bi bi-arrow-return-left"></i> Advance refund</span>
                            <strong>@Money(AdvanceRefunded)</strong>
                            <small>Returned to patients</small>
                        </article>
                        <article class="account-summary-stat stat-hospital-total">
                            <span><i class="bi bi-calculator"></i> Hospital total</span>
                            <strong>@Money(HospitalNetCollected)</strong>
                            <small>After refund and discount</small>
                        </article>
                    </div>
                    <div class="hospital-calculation" aria-label="Hospital total calculation">
                        <span><b>@Money(ClinicalCollected)</b> Department collection</span>
                        <b class="calculation-plus">+</b>
                        <span><b>@Money(AdvanceCollected)</b> Patient advance</span>
                        <b class="calculation-plus">+</b>
                        <span><b>@Money(DueClearedAmount)</b> Due collected</span>
                        <b class="calculation-minus">−</b>
                        <span><b>@Money(AdvanceRefunded)</b> Refund</span>
                        <b class="calculation-minus">−</b>
                        <span><b>@Money(ClinicalDiscount)</b> Discount</span>
                        <b class="calculation-equals">=</b>
                        <strong>@Money(HospitalNetCollected)</strong>
                    </div>
                </div>

                <aside class="account-summary-overview-pharmacy">
                    <div class="account-summary-overview-heading">
                        <span class="overview-heading-icon pharmacy-icon"><i class="bi bi-capsule"></i></span>
                        <div>
                            <h2>Pharmacy</h2>
                            <p>Payments received + due − sales returns</p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(pharmacyDataError))
                    {
                        <div class="pharmacy-data-warning" role="alert">@pharmacyDataError</div>
                    }
                    <strong class="pharmacy-total">@(string.IsNullOrEmpty(pharmacyDataError) ? Money(PharmacyFinalCollected) : "Unavailable")</strong>
                    <span class="pharmacy-total-label">Final pharmacy amount</span>
                    <div class="pharmacy-overview-adjustments">
                        <div class="pharmacy-adjustment pharmacy-discount">
                            <span><i class="bi bi-tag-fill"></i> Discount</span>
                            <strong>− @Money(PharmacyDiscount)</strong>
                        </div>
                        <div class="pharmacy-adjustment pharmacy-due">
                            <span title="Outstanding amount not yet collected"><i class="bi bi-hourglass-split"></i> Due outstanding</span>
                            <strong>@Money(PharmacyDue)</strong>
                        </div>
                        <div class="pharmacy-adjustment pharmacy-due-collected">
                            <span><i class="bi bi-check2-circle"></i> Due collected</span>
                            <strong>@(string.IsNullOrEmpty(pharmacyDataError) ? Money(PharmacyDueCollected) : "Unavailable")</strong>
                        </div>
                        <div class="pharmacy-adjustment pharmacy-sales-return">
                            <span><i class="bi bi-arrow-return-left"></i> Sales return</span>
                            <strong>@(string.IsNullOrEmpty(pharmacyDataError) ? $"− {Money(PharmacySalesReturnAmount)}" : "Unavailable")</strong>
                        </div>
                    </div>
                    <div class="pharmacy-payment-split">
                        <div><span>Cash</span><strong>@Money(PharmacyCash)</strong></div>
                        <div><span>UPI</span><strong>@Money(PharmacyUpi)</strong></div>
                    </div>
                </aside>
            </section>

            <section class="account-summary-report-grid" aria-label="Hospital and pharmacy collection details">
                <section class="account-summary-departments clinical-report-panel">
                    <div class="account-summary-section-heading">
                        <div>
                            <span class="panel-eyebrow"><i class="bi bi-heart-pulse"></i> Hospital</span>
                            <h2>Department summary</h2>
                            <p>Cash and UPI collected by department</p>
                        </div>
                        <span class="account-summary-count">@ClinicalCollections.Count departments</span>
                    </div>
                    <div class="account-summary-table-wrap">
                        <table class="account-summary-table">
                            <thead>
                                <tr>
                                    <th class="table-department-heading">Department</th>
                                    <th class="table-cash-heading"><i class="bi bi-cash-stack"></i> Cash</th>
                                    <th class="table-upi-heading"><i class="bi bi-qr-code"></i> UPI</th>
                                    <th class="table-total-heading"><i class="bi bi-wallet2"></i> Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ClinicalCollections.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="account-summary-no-data">No clinical collections found for this period.</td>
                                    </tr>
                                }
                                else
                                {
                                    @for (var index = 0; index < ClinicalCollections.Count; index++)
                                    {
                                        var department = ClinicalCollections[index];
                                        <tr>
                                            <td>
                                                <span class="account-summary-department">
                                                    <span class="account-summary-department-icon department-tone-@(index % 6)"><i class="bi bi-building"></i></span>
                                                    <span class="account-summary-department-name">@department.category</span>
                                                </span>
                                            </td>
                                            <td class="amount-cash">@Money(department.CashAmount)</td>
                                            <td class="amount-upi">@Money(department.UpiAmount)</td>
                                            <td class="amount-total">@Money(department.collected_amount)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            @if (ClinicalCollections.Count > 0)
                            {
                                <tfoot>
                                    <tr>
                                        <th class="table-total-label">Department total</th>
                                        <th class="amount-cash">@Money(ClinicalCash)</th>
                                        <th class="amount-upi">@Money(ClinicalUpi)</th>
                                        <th class="amount-total">@Money(ClinicalCollected)</th>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </section>

                <section class="account-summary-departments pharmacy-report-panel">
                    <div class="account-summary-section-heading">
                        <div>
                            <span class="panel-eyebrow pharmacy-eyebrow"><i class="bi bi-capsule"></i> Pharmacy</span>
                            <h2>Payment summary</h2>
                            <p>Collected amount by payment mode</p>
                        </div>
                    </div>
                    @if (string.IsNullOrEmpty(pharmacyDataError) &&
                        PharmacyCollections.Count == 0 &&
                        PharmacyDueCollected == 0 &&
                        PharmacySalesReturnAmount == 0)
                    {
                        <div class="pharmacy-empty-state">
                            <i class="bi bi-capsule"></i>
                            <span>No pharmacy collection found for this period.</span>
                        </div>
                    }
                    else
                    {
                        <div class="pharmacy-report-content">
                            <div class="pharmacy-report-modes">
                                <article class="pharmacy-mode-card mode-cash">
                                    <span><i class="bi bi-cash-stack"></i> Cash</span>
                                    <strong>@Money(PharmacyCash)</strong>
                                </article>
                                <article class="pharmacy-mode-card mode-upi">
                                    <span><i class="bi bi-qr-code"></i> UPI</span>
                                    <strong>@Money(PharmacyUpi)</strong>
                                </article>
                                <article class="pharmacy-mode-card mode-card">
                                    <span><i class="bi bi-credit-card"></i> Card</span>
                                    <strong>@Money(PharmacyCard)</strong>
                                </article>
                                <article class="pharmacy-mode-card mode-advance">
                                    <span><i class="bi bi-piggy-bank"></i> Advance</span>
                                    <strong>@Money(PharmacyAdvance)</strong>
                                </article>
                            </div>
                            <div class="pharmacy-report-total">
                                <span>Final pharmacy amount</span>
                                <strong>@(string.IsNullOrEmpty(pharmacyDataError) ? Money(PharmacyFinalCollected) : "Unavailable")</strong>
                            </div>
                        </div>
                    }
                </section>
            </section>

            <footer class="account-summary-bottom-totals" aria-label="Final hospital and pharmacy collection totals">
                <div class="bottom-total-item hospital-bottom-total">
                    <span><i class="bi bi-hospital"></i> Hospital total collected</span>
                    <strong>@Money(HospitalNetCollected)</strong>
                </div>
                <div class="bottom-total-item pharmacy-bottom-total">
                    <span><i class="bi bi-capsule"></i> Final pharmacy amount</span>
                    <strong>@(string.IsNullOrEmpty(pharmacyDataError) ? Money(PharmacyFinalCollected) : "Unavailable")</strong>
                </div>
            </footer>
        }
    }
</div>

@code {
    private HmsOpCategoryCollectionResponse? reportData;
    private List<PharmacyDueCollectionRecord> pharmacyDueCollections = new();
    private List<sales_return_master> salesReturnRefunds = new();
    private List<Booking.Models.BranchModel> branches = new();
    private List<Medico_Backend.Model.CounterMasterModel> counters = new();
    private DateTime fromDate = DateTime.Today;
    private DateTime toDate = DateTime.Today;
    private int selectedBhCode;
    private int selectedCntCode;
    private string DefaultTenant = "";
    private string AuthToken = "";
    private string errorMessage = "";
    private string pharmacyDataError = "";
    private bool isLoading;
    private bool hasViewRight = true;
    private bool hasLoadedData;

    private bool IsAdmin => UserPermissionHelper.IsAdmin(null, TenantState);

    private List<HmsOpCategoryAmountRow> ClinicalCollections =>
        reportData?.categories?
            .Where(row => !IsPharmacyCategory(row.category))
            .OrderBy(row => row.category, StringComparer.OrdinalIgnoreCase)
            .ToList() ?? new();

    private List<HmsOpCategoryAmountRow> PharmacyCollections =>
        reportData?.categories?
            .Where(row => IsPharmacyCategory(row.category))
            .ToList() ?? new();

    private IEnumerable<PharmacyDueCollectionRecord> PharmacyDueCollectionsInPeriod
    {
        get
        {
            var query = pharmacyDueCollections.Where(record =>
                record.master != null &&
                !record.master.deleted &&
                MatchesTenant(record.master.tenantcode));

            if (selectedBhCode > 0)
            {
                query = query.Where(record => record.master!.bh_code == selectedBhCode);
            }

            if (selectedCntCode > 0)
            {
                query = query.Where(record => record.master!.cntcode == selectedCntCode);
            }

            return query.Where(record =>
            {
                var date = record.master!.requestdate != default
                    ? record.master.requestdate
                    : record.master.createddate;
                return date.Date >= fromDate.Date && date.Date <= toDate.Date;
            });
        }
    }

    private IEnumerable<sales_return_master> PharmacySalesReturnsInPeriod =>
        salesReturnRefunds
            .Where(salesReturn =>
                !salesReturn.deleted &&
                IsRefundedSalesReturn(salesReturn) &&
                MatchesTenant(salesReturn.tenantcode) &&
                salesReturn.createddate.Date >= fromDate.Date &&
                salesReturn.createddate.Date <= toDate.Date)
            .Where(salesReturn => selectedBhCode <= 0 || salesReturn.bh_code == selectedBhCode)
            .Where(salesReturn => selectedCntCode <= 0 || salesReturn.cntcode == selectedCntCode);

    private static bool IsPharmacyCategory(string? category) =>
        !string.IsNullOrWhiteSpace(category) &&
        category.Contains("PHARMACY", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<Medico_Backend.Model.CounterMasterModel> FilteredCounters
    {
        get
        {
            if (selectedBhCode <= 0)
            {
                return counters;
            }

            var branchCounters = counters
                .Where(counter => counter.bhcode == selectedBhCode || counter.bhcode == 0 || counter.bhcode == null)
                .ToList();
            return branchCounters.Count > 0 ? branchCounters : counters;
        }
    }

    private double AdvanceCollected =>
        reportData == null ? 0 :
        reportData.total_advance_collected > 0 ? reportData.total_advance_collected : reportData.advance_collected;

    private double AdvanceUsed =>
        reportData == null ? 0 :
        reportData.total_advance_used > 0 ? reportData.total_advance_used :
        reportData.total_advance_adjusted > 0 ? reportData.total_advance_adjusted : reportData.advance_used;

    private double AdvanceRefunded =>
        reportData == null ? 0 :
        reportData.total_advance_refunded > 0 ? reportData.total_advance_refunded : reportData.advance_refunded;

    private double DueClearedAmount =>
        reportData == null ? 0 :
        reportData.total_due_cleared > 0 ? reportData.total_due_cleared :
        reportData.due_cleared_today > 0 ? reportData.due_cleared_today :
        reportData.due_cleared_bills.Sum(row => row.amount_cleared);

    private double DueClearedCash =>
        reportData?.due_cleared_by_paymode?.Any() == true
            ? reportData.due_cleared_by_paymode.Where(row => HmsOpCategoryAmountRow.IsCash(row.paymode, row.pmcode)).Sum(row => row.amount)
            : reportData?.due_cleared_bills?.Where(row => HmsOpCategoryAmountRow.IsCash(row.paymode, row.pmcode)).Sum(row => row.amount_cleared) ?? 0;

    private double DueClearedUpi =>
        reportData?.due_cleared_by_paymode?.Any() == true
            ? reportData.due_cleared_by_paymode.Where(row => HmsOpCategoryAmountRow.IsUpi(row.paymode, row.pmcode)).Sum(row => row.amount)
            : reportData?.due_cleared_bills?.Where(row => HmsOpCategoryAmountRow.IsUpi(row.paymode, row.pmcode)).Sum(row => row.amount_cleared) ?? 0;

    private double AdvanceCash =>
        reportData?.advance_collected_by_paymode?.Any() == true
            ? reportData.advance_collected_by_paymode.Where(row => HmsOpCategoryAmountRow.IsCash(row.paymode, row.pmcode)).Sum(row => row.amount)
            : AdvanceCollected;

    private double AdvanceUpi =>
        reportData?.advance_collected_by_paymode?
            .Where(row => HmsOpCategoryAmountRow.IsUpi(row.paymode, row.pmcode))
            .Sum(row => row.amount) ?? 0;

    private double ClinicalCollected => ClinicalCollections.Sum(row => row.collected_amount);
    private double ClinicalCash => ClinicalCollected > 0 ? ClinicalCollections.Sum(row => row.CashAmount) : 0;
    private double ClinicalUpi => ClinicalCollected > 0 ? ClinicalCollections.Sum(row => row.UpiAmount) : 0;
    private double ClinicalDiscount => ClinicalCollections.Sum(row =>
        Math.Abs(row.discount_amount != 0 ? row.discount_amount : row.discount));
    private double PharmacyCollected => PharmacyCollections.Sum(row => row.collected_amount);
    private double PharmacyCash => PharmacyCollections.Sum(row => row.CashAmount);
    private double PharmacyUpi => PharmacyCollections.Sum(row => row.UpiAmount);
    private double PharmacyCard => PharmacyCollections.Sum(row => row.CardAmount);
    private double PharmacyAdvance => PharmacyCollections.Sum(row => row.AdvanceAmount);
    private double PharmacyDiscount => PharmacyCollections.Sum(row =>
        Math.Abs(row.discount_amount != 0 ? row.discount_amount : row.discount));
    private double PharmacyDue => PharmacyCollections.Sum(row => row.due_amount);
    private double PharmacyDueCollected => PharmacyDueCollectionsInPeriod.Sum(record =>
        (double)(record.master?.totalcollectedamount ?? 0));
    private double PharmacySalesReturnAmount => PharmacySalesReturnsInPeriod.Sum(salesReturn =>
        (double)salesReturn.refundamount.GetValueOrDefault());
    private double PharmacyFinalCollected => PharmacyCollected + PharmacyDueCollected - PharmacySalesReturnAmount;
    private double HospitalNetCollected =>
        ClinicalCollected + AdvanceCollected + DueClearedAmount - AdvanceRefunded - ClinicalDiscount;
    private double GrandTotalCollected => HospitalNetCollected + PharmacyFinalCollected;
    private double CombinedCashReceived => ClinicalCash + DueClearedCash + AdvanceCash + PharmacyCash;
    private double CombinedUpiReceived => ClinicalUpi + DueClearedUpi + AdvanceUpi + PharmacyUpi;

    private bool MatchesTenant(string? itemTenant)
    {
        if (string.IsNullOrWhiteSpace(DefaultTenant) || string.IsNullOrWhiteSpace(itemTenant))
        {
            return true;
        }

        return string.Equals(itemTenant.Trim(), DefaultTenant.Trim(), StringComparison.OrdinalIgnoreCase) ||
            (int.TryParse(itemTenant.Trim(), out var itemTenantNumber) &&
             int.TryParse(DefaultTenant.Trim(), out var defaultTenantNumber) &&
             itemTenantNumber == defaultTenantNumber);
    }

    private static bool IsRefundedSalesReturn(sales_return_master salesReturn) =>
        !string.IsNullOrWhiteSpace(salesReturn.paymentmode) &&
        !string.IsNullOrWhiteSpace(salesReturn.cnttid) &&
        salesReturn.referenceno?.StartsWith("SR-REFUNDED:", StringComparison.OrdinalIgnoreCase) == true;

    private static string Money(double amount) => $"₹{amount:N2}";

    protected override async Task OnInitializedAsync()
    {
        RoleService.OnPermissionsChanged += HandlePermissionsChanged;
        EvaluateRights();
        if (hasViewRight)
        {
            await InitializeDataAsync();
        }
    }

    private void EvaluateRights()
    {
        if (IsAdmin)
        {
            hasViewRight = true;
            return;
        }

        if (RoleService.IsPermissionsLoaded)
        {
            hasViewRight = RoleService.HasRoleId(1056) ||
                RoleService.HasAction("Billing Portal", "Account Summary", "View") ||
                RoleService.HasRoleId(1043) ||
                RoleService.HasAction("Billing Portal", "Billing Categorization", "View") ||
                RoleService.HasRight("Billing Portal", "Billing Categorization") ||
                RoleService.HasRight("Billing Portal", "Billing Categories");
            return;
        }

        var rights = UserPermissionHelper.GetRights(
            null,
            TenantState,
            TenantState?.UserRightsList?.ToList(),
            "Account Summary",
            "Account_Summary",
            "Billing Categorization",
            "Billing Categories",
            "Billing_Categorization");
        hasViewRight = rights.View;
    }

    private void HandlePermissionsChanged()
    {
        _ = InvokeAsync(async () =>
        {
            EvaluateRights();
            if (hasViewRight && !hasLoadedData)
            {
                await InitializeDataAsync();
            }
            StateHasChanged();
        });
    }

    private async Task InitializeDataAsync()
    {
        if (hasLoadedData)
        {
            return;
        }

        hasLoadedData = true;
        await LoadSessionAndTenantAsync();
        await Task.WhenAll(LoadBranchesAsync(), LoadCountersAsync());
        await LoadSummaryAsync();
    }

    private async Task LoadSessionAndTenantAsync()
    {
        var tenantResult = await SessionStorage.GetAsync<string>("tenant_code");
        DefaultTenant = tenantResult.Success && !string.IsNullOrWhiteSpace(tenantResult.Value)
            ? tenantResult.Value
            : TenantState?.TenantCode ?? "0010";

        var tokenResult = await SessionStorage.GetAsync<string>("authToken");
        if (!tokenResult.Success || string.IsNullOrWhiteSpace(tokenResult.Value))
        {
            tokenResult = await SessionStorage.GetAsync<string>("auth_token");
        }
        AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : TenantState?.AuthToken ?? "";
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Remove("tenantcode");
            client.DefaultRequestHeaders.TryAddWithoutValidation("tenant_code", DefaultTenant);
            client.DefaultRequestHeaders.TryAddWithoutValidation("tenantcode", DefaultTenant);
            if (!string.IsNullOrWhiteSpace(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }

            using var response = await client.GetAsync("api/Branch/get");
            if (!response.IsSuccessStatusCode)
            {
                ToastService.ShowError("Unable to load branches for Account Summary.");
                return;
            }

            var json = await response.Content.ReadAsStringAsync();
            branches = JsonSerializer.Deserialize<List<Booking.Models.BranchModel>>(
                json,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true })?
                .Where(branch => !branch.deleted)
                .ToList() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AccountSummary] Error loading branches: {ex.Message}");
            ToastService.ShowError("Unable to load branches for Account Summary.");
        }
    }

    private async Task LoadCountersAsync()
