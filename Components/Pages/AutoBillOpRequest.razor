    private void AutoSetCounterForBranch(int bh)
    {
        selectedBranchCode = bh;

        // 1. Priority 1: Check if any counter has an ACTIVE OPEN SHIFT on this branch
        var openShiftOnBranch = openCountersList
            .FirstOrDefault(s => s.todate == null && s.cntcode.HasValue && (bh == 0 || s.bhcode == bh));

        if (openShiftOnBranch != null && openShiftOnBranch.cntcode.HasValue)
        {
            selectedCounterCode = openShiftOnBranch.cntcode.Value;
            return;
        }

        // 2. Priority 2: Pick the first configured counter in this branch
        if (bh > 0)
        {
            var branchCounter = countersList
                .Where(c => !c.deleted && c.bhcode == bh && c.cntcode > 0)
                .OrderBy(c => c.orderno > 0 ? c.orderno : (int)c.cntcode)
                .FirstOrDefault();

            if (branchCounter != null)
            {
                selectedCounterCode = (int)branchCounter.cntcode;
                return;
            }

            var anyBranchShift = openCountersList
                .FirstOrDefault(s => s.bhcode == bh && s.cntcode.HasValue && s.cntcode.Value > 0);
            if (anyBranchShift != null && anyBranchShift.cntcode.HasValue)
            {
                selectedCounterCode = anyBranchShift.cntcode.Value;
                return;
            }
        }

        // 3. Fallback: If "All Branches" (bh == 0) or no branch-specific counter found
        var anyOpen = openCountersList.FirstOrDefault(s => s.todate == null && s.cntcode.HasValue && s.cntcode.Value > 0);
        if (anyOpen != null && anyOpen.cntcode.HasValue)
        {
            selectedCounterCode = anyOpen.cntcode.Value;
            return;
        }

        var availableForBranch = AvailableCountersForBranch.ToList();
        if (availableForBranch.Any(c => c.CntCode == selectedCounterCode))
        {
            return;
        }

        if (availableForBranch.Any())
        {
            selectedCounterCode = availableForBranch.First().CntCode;
        }
        else
        {
            selectedCounterCode = 1;
        }
    }

