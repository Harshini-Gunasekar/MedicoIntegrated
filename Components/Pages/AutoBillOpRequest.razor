    private async Task<(bool Success, string Message)> ExecuteAutoBillSingleAsync(string opIdStr, string effTenant, string effToken)
    {
        var activeShift = CurrentCounterOpenShift;

        // Determine branch code to send
        // Priority 1: If open shift has a bhcode > 0, send that
        // Priority 2: If selectedBranchCode > 0, send selectedBranchCode
        // Priority 3: null (allow backend to match open shift without branch conflict)
        int? branchToSend = (activeShift != null && activeShift.bhcode.HasValue && activeShift.bhcode.Value > 0)
            ? activeShift.bhcode.Value
            : (selectedBranchCode > 0 ? selectedBranchCode : null);

        var request = new Booking.Models.AutoBillOpRequest
        {
            op_id = opIdStr,
            enteredbhcode = branchToSend,
            cntcode = selectedCounterCode
        };

        var (success, message, raw) = await HmsBillingService.AutoBillOpAsync(request, effTenant, effToken);

        // Smart fallback retry:
        // If the backend returns "Selected billing counter shift session is not open."
        // it means the backend query couldn't match counter_timing.bhcode = @enteredbhcode.
        // We retry with enteredbhcode = null or activeShift.bhcode!
        if (!success && (message.Contains("shift session is not open", StringComparison.OrdinalIgnoreCase) ||
                         raw.Contains("shift session is not open", StringComparison.OrdinalIgnoreCase)))
        {
            if (request.enteredbhcode.HasValue)
            {
                Console.WriteLine($"[AutoBillOp] Retry attempt 1 with enteredbhcode = null for OP {opIdStr}");
                request.enteredbhcode = null;
                var res2 = await HmsBillingService.AutoBillOpAsync(request, effTenant, effToken);
                success = res2.Success;
                message = res2.Message;
                raw = res2.RawResponse;
            }

            if (!success && activeShift != null && activeShift.bhcode.HasValue && activeShift.bhcode.Value > 0 && request.enteredbhcode != activeShift.bhcode)
            {
                Console.WriteLine($"[AutoBillOp] Retry attempt 2 with enteredbhcode = {activeShift.bhcode} for OP {opIdStr}");
                request.enteredbhcode = activeShift.bhcode;
                var res3 = await HmsBillingService.AutoBillOpAsync(request, effTenant, effToken);
                success = res3.Success;
                message = res3.Message;
                raw = res3.RawResponse;
            }
        }

        return (success, message);
    }

    private async Task MoveToCashAsync(OpUnbilledRow item)
    {
        if (!hasCreateRight)
        {
            ToastService.ShowWarning("You do not have permission to generate auto bills / move to cash.");
            return;
        }

        var activeShift = CurrentCounterOpenShift;
        if (activeShift == null)
        {
            var effTenantQuick = await GetEffectiveTenantCodeAsync();
            openCountersList = await HmsBillingService.GetOpenCountersAsync(returnAllUnclosed: true, tenantCode: effTenantQuick) ?? new();
            activeShift = CurrentCounterOpenShift;
        }

        if (activeShift == null)
        {
            ToastService.ShowWarning($"Cash Counter #{selectedCounterCode} has no open shift. Please open shift first.");
            return;
        }

        var opIdStr = item.op_id.ToString();
        processingOpId = opIdStr;
        StateHasChanged();

        try
        {
            var effTenant = await GetEffectiveTenantCodeAsync();
            var effToken = !string.IsNullOrWhiteSpace(TenantState?.AuthToken) ? TenantState.AuthToken : "";

            var (success, message) = await ExecuteAutoBillSingleAsync(opIdStr, effTenant, effToken);

            if (success)
            {
                ToastService.ShowSuccess(message);
                selectedOpIds.Remove(opIdStr);
                allUnbilledList.RemoveAll(x => x.op_id == item.op_id);
                ApplyFilters();
            }
            else
            {
                ToastService.ShowError(message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            processingOpId = null;
            StateHasChanged();
        }
    }

    private async Task BulkMoveToCashAsync()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowWarning("You do not have permission to generate auto bills / move to cash.");
            return;
        }

        var activeShift = CurrentCounterOpenShift;
        if (activeShift == null)
        {
            var effTenantQuick = await GetEffectiveTenantCodeAsync();
            openCountersList = await HmsBillingService.GetOpenCountersAsync(returnAllUnclosed: true, tenantCode: effTenantQuick) ?? new();
            activeShift = CurrentCounterOpenShift;
        }

        if (activeShift == null)
        {
            ToastService.ShowWarning($"Cash Counter #{selectedCounterCode} has no open shift. Please open shift first.");
            return;
        }

        if (!selectedOpIds.Any())
        {
            ToastService.ShowWarning("Please select at least one patient to move to cash.");
            return;
        }

        isBulkProcessing = true;
        bulkProcessedCount = 0;
        StateHasChanged();

        int successCount = 0;
        int failureCount = 0;
        var opIdsToProcess = selectedOpIds.ToList();

        try
        {
            var effTenant = await GetEffectiveTenantCodeAsync();
            var effToken = !string.IsNullOrWhiteSpace(TenantState?.AuthToken) ? TenantState.AuthToken : "";

            foreach (var opId in opIdsToProcess)
            {
                bulkProcessedCount++;
                StateHasChanged();

                var (success, _) = await ExecuteAutoBillSingleAsync(opId, effTenant, effToken);
                if (success)
                {
                    successCount++;
                    selectedOpIds.Remove(opId);
                    allUnbilledList.RemoveAll(x => x.op_id.ToString() == opId);
                }
                else
                {
                    failureCount++;
                }
            }

            ApplyFilters();

            if (failureCount == 0)
            {
                ToastService.ShowSuccess($"Successfully moved {successCount} OP patient(s) to cash counter!");
            }
            else
            {
                ToastService.ShowWarning($"Moved {successCount} OP patient(s) successfully. {failureCount} failed.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Bulk move error: {ex.Message}");
        }
        finally
        {
            isBulkProcessing = false;
            StateHasChanged();
            await LoadDataAsync();
        }
    }
