    private async Task<string> GetEffectiveTenantCodeAsync()
    {
        if (!string.IsNullOrWhiteSpace(TenantState?.TenantCode))
            return TenantState.TenantCode;

        try
        {
            var t1 = await _sessionStorage.GetAsync<string>("tenant_code");
            if (t1.Success && !string.IsNullOrWhiteSpace(t1.Value)) return t1.Value;

            var t2 = await _sessionStorage.GetAsync<string>("tenantcode");
            if (t2.Success && !string.IsNullOrWhiteSpace(t2.Value)) return t2.Value;

            var ud = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (ud.Success && !string.IsNullOrWhiteSpace(ud.Value?.TenantCode)) return ud.Value.TenantCode;
        }
        catch { }

        return "";
    }

    private bool IsAdmin => Booking.Helpers.UserPermissionHelper.IsAdmin(null, TenantState);

    private bool hasViewRight = false;
    private bool hasCreateRight = false;
    private bool hasEditRight = false;
    private bool hasDeleteRight = false;

    private void EvaluateRights()
    {
        if (IsAdmin)
        {
            hasViewRight = true;
            hasCreateRight = true;
            hasEditRight = true;
            hasDeleteRight = true;
            return;
        }

        if (RoleService.IsPermissionsLoaded)
        {
            hasCreateRight = RoleService.HasRoleId(1040) || RoleService.HasAction("Billing Portal", "Auto Bill OP", "Create");
            hasEditRight = RoleService.HasRoleId(1041) || RoleService.HasAction("Billing Portal", "Auto Bill OP", "Edit");
            hasDeleteRight = RoleService.HasRoleId(1042) || RoleService.HasAction("Billing Portal", "Auto Bill OP", "Delete");
            hasViewRight = RoleService.HasRoleId(1039) || RoleService.HasAction("Billing Portal", "Auto Bill OP", "View") || hasCreateRight || hasEditRight || hasDeleteRight;
        }
        else
        {
            var rightsList = TenantState?.UserRightsList?.ToList();
            var r = UserPermissionHelper.GetRights(null, TenantState, rightsList, "Auto Bill OP", "AutoBill OP", "Auto Bill", "AutoBillOpRequest");
            hasCreateRight = r.Add;
            hasEditRight = r.Edit;
            hasDeleteRight = r.Delete;
            hasViewRight = r.View || r.Add || r.Edit || r.Delete;
        }
    }

    private void HandlePermissionsChanged()
    {
        InvokeAsync(() =>
        {
            EvaluateRights();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        RoleService.OnPermissionsChanged -= HandlePermissionsChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        RoleService.OnPermissionsChanged += HandlePermissionsChanged;

        if (!RoleService.IsPermissionsLoaded)
        {
            try
            {
                var sessionPerms = await _sessionStorage.GetAsync<List<RolePermissionItem>>("UserRolePermissions");
                if (sessionPerms.Success && sessionPerms.Value != null && sessionPerms.Value.Any())
                {
                    RoleService.SetUserPermissions(sessionPerms.Value);
                }
                else if (TenantState.UserCode > 0)
                {
                    await RoleService.LoadUserPermissionsAsync(TenantState.UserCode, TenantState.TenantCode);
                }
            }
            catch
            {
                if (TenantState.UserCode > 0)
                {
                    await RoleService.LoadUserPermissionsAsync(TenantState.UserCode, TenantState.TenantCode);
                }
            }
        }

        EvaluateRights();
        if (hasViewRight)
        {
            await LoadMasterDataAsync();
            await LoadDataAsync();
        }
    }

    private async Task LoadMasterDataAsync()
    {
        try
        {
            var effTenant = await GetEffectiveTenantCodeAsync();
            var doctorsTask = DoctorService.GetDoctorsAsync();
            var countersTask = CounterMasterService.GetCountersAsync();
            var openCountersTask = HmsBillingService.GetOpenCountersAsync(returnAllUnclosed: true, tenantCode: effTenant);
            var branchesTask = LoadBranchesInternalAsync();

            await Task.WhenAll(doctorsTask, countersTask, openCountersTask, branchesTask);

            doctorsList = (await doctorsTask) ?? new();
            countersList = (await countersTask) ?? new();
            openCountersList = (await openCountersTask) ?? new();
            branchesList = await branchesTask;

            // 1. Resolve counter & branch: Prioritize active open shift!
            var anyOpenShift = openCountersList.FirstOrDefault(s => s.todate == null && s.cntcode.HasValue);
            if (anyOpenShift != null && anyOpenShift.cntcode.HasValue)
            {
                selectedCounterCode = anyOpenShift.cntcode.Value;
                if (anyOpenShift.bhcode.HasValue && anyOpenShift.bhcode.Value > 0)
                {
                    selectedBranchCode = anyOpenShift.bhcode.Value;
                }
                else if (branchesList.Any())
                {
                    selectedBranchCode = branchesList.First().bh_code;
                }
            }
            else
            {
                // Fallback to saved session
                int savedBh = 0;
                try
                {
                    var bhRes = await _sessionStorage.GetAsync<string>("bhcode");
                    if (bhRes.Success && !string.IsNullOrEmpty(bhRes.Value)) int.TryParse(bhRes.Value, out savedBh);
                }
                catch { }

                if (savedBh > 0 && branchesList.Any(b => b.bh_code == savedBh))
                {
                    selectedBranchCode = savedBh;
                }
                else if (branchesList.Any())
                {
                    selectedBranchCode = branchesList.First().bh_code;
                }

                int savedCnt = 0;
                try
                {
                    var cntRes = await _sessionStorage.GetAsync<string>("cntcode");
                    if (cntRes.Success && !string.IsNullOrEmpty(cntRes.Value)) int.TryParse(cntRes.Value, out savedCnt);
                }
                catch { }

                if (savedCnt > 0 && AvailableCountersForBranch.Any(c => c.CntCode == savedCnt))
                {
                    selectedCounterCode = savedCnt;
                }
                else
                {
                    AutoSetCounterForBranch(selectedBranchCode);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AutoBillOp] Error loading masters: {ex.Message}");
        }
    }

    private async Task<List<Booking.Models.BranchModel>> LoadBranchesInternalAsync()
    {
        // 1. Session storage cache from MainLayout
        try
        {
            var sessRes = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.BranchModel>>("UserBranches");
            if (sessRes.Success && sessRes.Value != null && sessRes.Value.Any())
            {
                var list = sessRes.Value
                    .Where(b => b.bh_code > 0)
                    .Select(b => new Booking.Models.BranchModel
                    {
                        bh_code = b.bh_code,
                        name = !string.IsNullOrWhiteSpace(b.name) ? b.name.Trim() : $"Branch #{b.bh_code}"
                    })
                    .GroupBy(b => b.bh_code)
                    .Select(g => g.First())
                    .ToList();

                if (list.Any())
                {
                    return list;
                }
            }
        }
        catch { }

        // 2. Query LabCareUrl then DoctorApi
        var effTenant = await GetEffectiveTenantCodeAsync();
        var effToken = !string.IsNullOrWhiteSpace(TenantState?.AuthToken) ? TenantState.AuthToken : "";

        string[] clientNames = new[] { "LabCareUrl", "DoctorApi" };
        foreach (var cName in clientNames)
        {
            try
            {
                var client = ClientFactory.CreateClient(cName);
                if (!string.IsNullOrEmpty(effTenant))
                {
                    client.DefaultRequestHeaders.Remove("tenant_code");
                    client.DefaultRequestHeaders.Remove("tenantcode");
                    client.DefaultRequestHeaders.Remove("tenant-code");
                    client.DefaultRequestHeaders.Add("tenant_code", effTenant);
                    client.DefaultRequestHeaders.Add("tenantcode", effTenant);
                    client.DefaultRequestHeaders.Add("tenant-code", effTenant);
                }
                if (!string.IsNullOrEmpty(effToken))
                {
                    client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effToken);
                }

                var response = await client.GetAsync("api/Branch/get");
                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync();
                    var parsed = ParseBranchesFromJson(json);
                    if (parsed.Any())
                    {
                        return parsed;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[AutoBillOp] Error loading branches from {cName}: {ex.Message}");
            }
        }

        return new List<Booking.Models.BranchModel> { new() { bh_code = 1, name = "Main Branch" } };
    }

    private List<Booking.Models.BranchModel> ParseBranchesFromJson(string json)
    {
        var result = new List<Booking.Models.BranchModel>();
        try
        {
            var jArr = Newtonsoft.Json.Linq.JArray.Parse(json);
            foreach (var item in jArr)
            {
                int code = item["bh_code"]?.ToObject<int>()
                    ?? item["bhcode"]?.ToObject<int>()
                    ?? item["code"]?.ToObject<int>()
                    ?? item["id"]?.ToObject<int>()
                    ?? 0;

                string rawName = item["name"]?.ToString()
                    ?? item["branch_name"]?.ToString()
                    ?? item["branchName"]?.ToString()
                    ?? item["b_name"]?.ToString()
                    ?? item["short_name"]?.ToString()
                    ?? "";

                bool isDel = item["deleted"]?.ToObject<bool>() == true || item["is_deleted"]?.ToObject<bool>() == true;

                if (code > 0 && !isDel)
                {
                    result.Add(new Booking.Models.BranchModel
                    {
                        bh_code = code,
                        name = !string.IsNullOrWhiteSpace(rawName) ? rawName.Trim() : $"Branch #{code}"
                    });
                }
            }
        }
        catch
        {
            try
            {
                var list = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                result = list.Where(b => !b.deleted && b.bh_code > 0).ToList();
            }
            catch { }
        }

        return result.GroupBy(b => b.bh_code).Select(g => g.First()).ToList();
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        StateHasChanged();

        try
        {
            // 1. Fetch OP Registrations
            var opTask = BookingService.GetAllOpRegistrationsAsync();

            // 2. Fetch all unbilled charges
            var unbilledChargesTask = HmsBillingService.GetAllUnbilledChargesAsync();

            // 3. Fetch bills to verify already billed visits
            var billsTask = HmsBillingService.ListBillsAsync(new HmsBillFilterRequest { pagesize = 1000 });

            // 4. Refresh open counters status
            var openCountersTask = HmsBillingService.GetOpenCountersAsync(returnAllUnclosed: true);

            await Task.WhenAll(opTask, unbilledChargesTask, billsTask, openCountersTask);

            var rawOps = (await opTask) ?? new();
            var allUnbilledCharges = (await unbilledChargesTask) ?? new();
            var billsResponse = await billsTask;
            var bills = billsResponse?.data ?? new();
            openCountersList = (await openCountersTask) ?? new();

            // Index bills by opvisitid, op_id, and custid
            var billedOpNos = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var b in bills)
            {
                if (!string.IsNullOrWhiteSpace(b.opvisitid)) billedOpNos.Add(b.opvisitid.Trim());
            }

            // Index unbilled charges by opvisitid and op_id
            var unbilledByOp = new Dictionary<string, List<UnbilledChargeSummary>>(StringComparer.OrdinalIgnoreCase);
            foreach (var charge in allUnbilledCharges)
            {
                if (charge.billedstatus == true) continue;
                if (!string.IsNullOrWhiteSpace(charge.opvisitid))
                {
                    var k = charge.opvisitid.Trim();
                    if (!unbilledByOp.ContainsKey(k)) unbilledByOp[k] = new();
                    unbilledByOp[k].Add(charge);
                }
            }

            var rowList = new List<OpUnbilledRow>();

            foreach (var op in rawOps)
            {
                if (op.isdeleted) continue;

                var opIdStr = op.op_id.ToString();
                var opNoStr = (op.op_no ?? "").Trim();

                // Check billed status
                bool isBilledFromDb = string.Equals(op.billed_status, "BILLED", StringComparison.OrdinalIgnoreCase);
                bool hasBillGenerated = (!string.IsNullOrEmpty(opNoStr) && billedOpNos.Contains(opNoStr))
                                     || billedOpNos.Contains(opIdStr);

                // Collect unbilled charges for this OP
                var charges = new List<UnbilledChargeSummary>();
                if (!string.IsNullOrEmpty(opIdStr) && unbilledByOp.TryGetValue(opIdStr, out var c1))
                {
                    charges.AddRange(c1);
                }
                if (!string.IsNullOrEmpty(opNoStr) && unbilledByOp.TryGetValue(opNoStr, out var c2))
                {
                    foreach (var c in c2)
                    {
                        if (!charges.Any(x => string.Equals(x.unbilledid, c.unbilledid, StringComparison.OrdinalIgnoreCase)))
                            charges.Add(c);
                    }
                }

                // If already billed and no outstanding unbilled charges, skip
                if ((isBilledFromDb || hasBillGenerated) && !charges.Any())
                {
                    continue;
                }

                decimal chargesTotal = charges.Sum(c => (decimal)(c.amount ?? 0));

                rowList.Add(new OpUnbilledRow
                {
                    op_id = op.op_id,
                    op_no = !string.IsNullOrWhiteSpace(op.op_no) ? op.op_no : $"OP-{op.custid}",
                    custid = op.custid,
                    patient_name = !string.IsNullOrWhiteSpace(op.patient_name) ? op.patient_name : "Unknown Patient",
                    mobile = op.mobile ?? "",
                    doctor_name = op.doctor_name ?? "",
                    dcode = op.dcode,
                    token_no = op.token_no ?? "",
                    visit_type = op.visit_type ?? "NEWVISIT",
                    visit_date = op.visit_date,
                    created_at = op.created_at,
                    unbilled_charges_count = charges.Count,
                    unbilled_charges_total = chargesTotal,
                    charges = charges
                });
            }

            allUnbilledList = rowList.OrderByDescending(x => x.created_at).ToList();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AutoBillOp] Error loading data: {ex.Message}");
            ToastService.ShowError($"Failed to load unbilled OP list: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        var result = allUnbilledList.AsEnumerable();

        // 1. Date Filter
        if (dateFilterMode == "TODAY")
        {
            var today = DateTime.UtcNow.ToIndianTime().Date;
            result = result.Where(x => x.visit_date.ToDateTime(TimeOnly.MinValue).Date == today);
        }
        else if (dateFilterMode == "YESTERDAY")
        {
            var yest = DateTime.UtcNow.ToIndianTime().Date.AddDays(-1);
            result = result.Where(x => x.visit_date.ToDateTime(TimeOnly.MinValue).Date == yest);
        }
        else if (dateFilterMode == "CUSTOM")
        {
            var f = fromDate.Date;
            var t = toDate.Date;
            result = result.Where(x => {
                var d = x.visit_date.ToDateTime(TimeOnly.MinValue).Date;
                return d >= f && d <= t;
            });
        }

        // 2. Doctor Filter
        if (selectedDoctorCode > 0)
        {
            result = result.Where(x => x.dcode == selectedDoctorCode);
        }

        // 3. Search Query
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLowerInvariant();
            result = result.Where(x =>
                x.patient_name.ToLowerInvariant().Contains(q) ||
                x.op_no.ToLowerInvariant().Contains(q) ||
                x.mobile.Contains(q) ||
                x.custid.ToString().Contains(q) ||
                x.doctor_name.ToLowerInvariant().Contains(q) ||
                x.token_no.ToLowerInvariant().Contains(q));
        }

        filteredList = result.ToList();
    }

