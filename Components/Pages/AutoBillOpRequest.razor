@page "/auto-bill-op"
@page "/billing/auto-bill-op"
@page "/AutoBillOpRequest"
@rendermode InteractiveServer
@using Booking.Models
@using Booking.Services
@using Booking.Helpers
@using medico_backend.Model
@using Medico_Backend.Model
@using Newtonsoft.Json
@inject HmsBillingService HmsBillingService
@inject AppointmentBookingService BookingService
@inject DoctorService DoctorService
@inject CounterMasterService CounterMasterService
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject IHttpClientFactory ClientFactory
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage _sessionStorage
@inject Booking.Services.RoleMasterService RoleService
@implements IDisposable

<PageTitle>Auto Bill OP - Medico Billing</PageTitle>

<div class="autobill-page-wrapper">
    @if (!hasViewRight)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="card p-5 text-center shadow-sm" style="max-width: 520px; border-radius: 16px; border: 1px solid #fee2e2; background: #fff5f5;">
                <i class="bi bi-shield-lock-fill text-danger mb-3" style="font-size: 3rem;"></i>
                <h3 class="fw-bold text-danger">Access Denied</h3>
                <p class="text-muted mt-2">You do not have permission to view the Auto Bill OP module. Please contact your system administrator to assign the required user rights.</p>
                <div class="mt-3">
                    <a href="/" class="btn btn-primary px-4" style="border-radius: 8px;">Back to Home</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- 1. Header Card -->
        <div class="autobill-header-card">
        <div class="header-title-group">
            <div class="header-icon-box">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div>
                <h2 class="header-title">Auto Bill OP Request</h2>
                <div class="header-subtitle">
                    <span class="status-pulse-dot"></span>
                    <span>Convert unbilled OP registrations to cash bills and transfer to cash counter</span>
                </div>
            </div>
        </div>

        <div class="header-metrics-row">
            <div class="metric-card total">
                <div class="metric-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">UNBILLED OP</span>
                    <span class="metric-val">@filteredList.Count</span>
                </div>
            </div>

            <div class="metric-card charges">
                <div class="metric-icon">
                    <i class="bi bi-file-earmark-medical-fill"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">WITH CHARGES</span>
                    <span class="metric-val">@filteredList.Count(x => x.unbilled_charges_count > 0)</span>
                </div>
            </div>

            <div class="metric-card @(IsCurrentCounterShiftOpen ? "shift-open" : "shift-closed")">
                <div class="metric-icon">
                    <i class="bi @(IsCurrentCounterShiftOpen ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
                </div>
                <div class="metric-content">
                    <span class="metric-label">COUNTER SHIFT</span>
                    <span class="metric-val" style="font-size: 0.85rem;">
                        @(IsCurrentCounterShiftOpen ? "Shift Open" : "Shift Not Open")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Controls & Filter Card -->
    <div class="config-card">
        <div class="config-main-row">
            <div class="config-left-group">
                <!-- Branch Selector -->
                <div class="control-pill-group">
                    <span class="control-pill-label">
                        <i class="bi bi-building"></i> Branch:
                    </span>
                    <select class="control-pill-select" value="@selectedBranchCode" @onchange="OnBranchChanged">
                        <option value="0">All Branches (Auto)</option>
                        @foreach (var b in branchesList)
                        {
                            <option value="@b.bh_code">@b.name (@b.bh_code)</option>
                        }
                    </select>
                </div>

                <!-- Cash Counter Selector -->
                <div class="control-pill-group">
                    <span class="control-pill-label">
                        <i class="bi bi-wallet2"></i> Cash Counter:
                    </span>
                    <select @key="@($"counter-select-{selectedBranchCode}")" class="control-pill-select" value="@selectedCounterCode" @onchange="OnCounterChanged">
                        @if (!AvailableCountersForBranch.Any())
                        {
                            <option value="1">Counter 1</option>
                        }
                        else
                        {
                            @foreach (var c in AvailableCountersForBranch)
                            {
                                <option value="@c.CntCode">
                                    @c.DisplayName @(c.HasOpenShift ? "🟢 (Shift Open)" : "⚪ (Closed)")
                                </option>
                            }
                        }
                    </select>
                </div>

                <!-- Shift Status Pill & Quick Open -->
                @if (IsCurrentCounterShiftOpen)
                {
                    var shift = CurrentCounterOpenShift;
                    <span class="shift-status-badge open">
                        <i class="bi bi-check-circle-fill"></i> Shift Active (Counter #@selectedCounterCode@(shift?.bhcode > 0 ? $" • Branch #{shift.bhcode}" : ""))
                    </span>
                }
                else
                {
                    <span class="shift-status-badge closed" title="Cash counter must have an open shift for auto billing">
                        <i class="bi bi-exclamation-octagon-fill"></i> Shift Closed
                    </span>
                    <button type="button" class="btn-quick-open" @onclick="OpenShiftForCurrentCounterAsync" disabled="@isOpeningShift">
                        @if (isOpeningShift)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Opening...</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Open Shift Now</span>
                        }
                    </button>
                }
            </div>

            <div class="config-right-group">
                @if (selectedOpIds.Any() && hasCreateRight)
                {
                    <button type="button" class="btn-bulk-move" @onclick="BulkMoveToCashAsync" disabled="@(isBulkProcessing || !IsCurrentCounterShiftOpen)">
                        @if (isBulkProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Processing (@bulkProcessedCount/@selectedOpIds.Count)...</span>
                        }
                        else
                        {
                            <i class="bi bi-lightning-charge-fill"></i>
                            <span>Move Selected (@selectedOpIds.Count) to Cash</span>
                        }
                    </button>
                }

                <button type="button" class="btn-refresh" @onclick="RefreshDataAsync" disabled="@loading" title="Refresh list">
                    <i class="bi bi-arrow-clockwise @(loading ? "spin" : "")"></i>
                    <span>Refresh</span>
                </button>
            </div>
        </div>

        <!-- Filter Row -->
        <div class="filter-row">
            <!-- Search Input -->
            <div class="search-box-wrap">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search by patient name, OP No, mobile, ID..." 
                       value="@searchQuery" @oninput="OnSearchInput" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button type="button" class="search-clear-btn" @onclick="ClearSearch" title="Clear search">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>

            <!-- Date Tabs & Doctor Filter Group -->
            <div class="filter-controls-group">
                <div class="date-pill-tabs">
                    <button type="button" class="date-tab-btn @(dateFilterMode == "TODAY" ? "active" : "")" @onclick='() => SetDateFilter("TODAY")'>
                        Today
                    </button>
                    <button type="button" class="date-tab-btn @(dateFilterMode == "YESTERDAY" ? "active" : "")" @onclick='() => SetDateFilter("YESTERDAY")'>
                        Yesterday
                    </button>
                    <button type="button" class="date-tab-btn @(dateFilterMode == "ALL" ? "active" : "")" @onclick='() => SetDateFilter("ALL")'>
                        All Pending
                    </button>
                    <button type="button" class="date-tab-btn @(dateFilterMode == "CUSTOM" ? "active" : "")" @onclick='() => SetDateFilter("CUSTOM")'>
                        Custom
                    </button>
                </div>

                @if (dateFilterMode == "CUSTOM")
                {
                    <div class="custom-date-container">
                        <input type="date" class="form-control custom-date-input"
                               value="@fromDate.ToString("yyyy-MM-dd")" @onchange="OnFromDateChanged" />
                        <span class="custom-date-sep">to</span>
                        <input type="date" class="form-control custom-date-input"
                               value="@toDate.ToString("yyyy-MM-dd")" @onchange="OnToDateChanged" />
                    </div>
                }

                <!-- Doctor Filter -->
                <div class="doctor-filter-container">
                    <i class="bi bi-person-badge text-primary me-1" style="font-size: 0.85rem;"></i>
                    <select class="doctor-select" value="@selectedDoctorCode" @onchange="OnDoctorChanged">
                        <option value="0">All Doctors</option>
                        @foreach (var doc in doctorsList)
                        {
                            <option value="@doc.dcode">@doc.name</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Table Card -->
    <div class="table-card">
        <div class="table-header-info">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-dark">Unbilled Outpatient (OP) Registrations</span>
                <span class="badge-records">@filteredList.Count Records</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (selectedOpIds.Any())
                {
                    <span class="selected-count-badge">
                        <i class="bi bi-check2-square"></i> @selectedOpIds.Count patient(s) selected
                    </span>
                }
                <div class="target-counter-badge">
                    <i class="bi bi-geo-alt-fill text-primary" style="font-size: 0.72rem;"></i>
                    <span>Target: <strong>@(GetSelectedBranchDisplayName())</strong> &bull; <strong>Counter #@selectedCounterCode</strong></span>
                </div>
            </div>
        </div>

        @if (loading)
        {
            <div class="loading-box">
                <div class="spinner-border text-primary" role="status"></div>
                <span style="font-size: 0.88rem; font-weight: 600;">Loading unbilled OP patients...</span>
            </div>
        }
        else if (!filteredList.Any())
        {
            <div class="empty-state-box">
                <div class="empty-icon-circle">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <h4 class="empty-title">No Unbilled OP Registrations</h4>
                <p class="empty-desc">
                    All outpatient registrations for the selected filter have already been billed or moved to cash counter.
                </p>
                <button type="button" class="btn-check-again" @onclick="RefreshDataAsync">
                    <i class="bi bi-arrow-clockwise me-1 @(loading ? "spin" : "")"></i> Check Again
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="autobill-table">
                    <thead>
                        <tr>
                            <th style="width: 40px; text-align: center;">
                                <input type="checkbox" checked="@IsAllSelected" @onchange="ToggleSelectAll" />
                            </th>
                            <th style="width: 60px;">#</th>
                            <th>Patient Details</th>
                            <th>OP Number / Date</th>
                            <th>Doctor & Dept</th>
                            <th>Visit Type</th>
                            <th>Unbilled Items</th>
                            <th>Status</th>
                            <th style="text-align: center; width: 150px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < filteredList.Count; i++)
                        {
                            var index = i + 1;
                            var item = filteredList[i];
                            var opIdStr = item.op_id.ToString();
                            bool isSelected = selectedOpIds.Contains(opIdStr);
                            bool isProcessingThis = processingOpId == opIdStr;

                            <tr style="@(isSelected ? "background: #f0fdf4;" : "")">
                                <td style="text-align: center;">
                                    <input type="checkbox" checked="@isSelected" @onchange="() => ToggleItemSelection(opIdStr)" />
                                </td>
                                <td style="color: #64748b; font-weight: 600;">@index</td>
                                <td>
                                    <div class="patient-cell">
                                        <span class="patient-name-text">@item.patient_name</span>
                                        <div class="patient-sub-text">
                                            <span><i class="bi bi-person-badge"></i> #@item.custid</span>
                                            @if (!string.IsNullOrEmpty(item.mobile))
                                            {
                                                <span>&bull;</span>
                                                <span><i class="bi bi-telephone"></i> @item.mobile</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="op-badge-pill">@item.op_no</span>
                                            @if (!string.IsNullOrEmpty(item.token_no))
                                            {
                                                <span class="token-badge" title="Token Number">T#@item.token_no</span>
                                            }
                                        </div>
                                        <span class="text-muted" style="font-size: 0.72rem;">
                                            <i class="bi bi-calendar3 me-1"></i>@item.visit_date.ToString("dd MMM yyyy")
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold" style="color: #1e293b; font-size: 0.8rem;">
                                            @(string.IsNullOrWhiteSpace(item.doctor_name) ? "Not Assigned" : item.doctor_name)
                                        </span>
                                        <span class="text-muted" style="font-size: 0.7rem;">
                                            Consultant Doctor
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border" style="font-size: 0.72rem;">
                                        @(string.IsNullOrWhiteSpace(item.visit_type) ? "OP VISIT" : item.visit_type)
                                    </span>
                                </td>
                                <td>
                                    @if (item.unbilled_charges_count > 0)
                                    {
                                        <button type="button" class="charges-chip" @onclick="() => OpenChargesModal(item)" title="Click to view unbilled charges breakdown">
                                            <i class="bi bi-file-earmark-medical"></i>
                                            <span>@item.unbilled_charges_count items</span>
                                            <strong class="text-primary ms-1">₹@item.unbilled_charges_total.ToString("N0")</strong>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.72rem;">Standard Consultation</span>
                                    }
                                </td>
                                <td>
                                    <span class="unbilled-status-pill">
                                        <i class="bi bi-hourglass-split"></i> UNBILLED
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    @if (hasCreateRight)
                                    {
                                        <button type="button" class="btn-move-cash" 
                                                @onclick="() => MoveToCashAsync(item)" 
                                                disabled="@(isProcessingThis || isBulkProcessing || !IsCurrentCounterShiftOpen)"
                                                title="@(!IsCurrentCounterShiftOpen ? "Open counter shift to enable Move to Cash" : "Auto bill and transfer to cash counter")">
                                            @if (isProcessingThis)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                                <span>Moving...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-right-circle-fill"></i>
                                                <span>Move to Cash</span>
                                            }
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small" style="font-size: 0.75rem;">View Only</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    }
</div>

<!-- Modal: View Unbilled Charges Details -->
@if (showChargesModal && modalPatient != null)
{
    <div class="modal-backdrop-custom" @onclick="CloseChargesModal"></div>
    <div class="modal-dialog-custom">
        <div class="modal-header-custom">
            <h4 class="modal-title-custom">
                <i class="bi bi-receipt text-primary"></i> Unbilled Charges Breakdown
            </h4>
            <button type="button" class="modal-close-btn" @onclick="CloseChargesModal">&times;</button>
        </div>
        <div class="modal-body-custom">
            <div class="p-2 bg-light rounded border d-flex justify-content-between align-items-center">
                <div>
                    <strong class="d-block text-dark">@modalPatient.patient_name</strong>
                    <span class="text-muted" style="font-size: 0.75rem;">OP: @modalPatient.op_no &bull; ID: #@modalPatient.custid</span>
                </div>
                <div class="text-end">
                    <span class="text-muted d-block" style="font-size: 0.7rem;">TOTAL AMOUNT</span>
                    <strong class="text-primary" style="font-size: 1.1rem;">₹@modalPatient.unbilled_charges_total.ToString("N2")</strong>
                </div>
            </div>

            <div style="max-height: 240px; overflow-y: auto;">
                <table class="table table-sm table-bordered" style="font-size: 0.78rem; margin: 0;">
                    <thead class="table-light">
                        <tr>
                            <th>Particulars</th>
                            <th style="text-align: center;">Qty</th>
                            <th style="text-align: right;">Rate</th>
                            <th style="text-align: right;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in modalPatient.charges)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(c.particulars) ? (c.item_name ?? c.entrytype ?? "Charge") : c.particulars)</td>
                                <td style="text-align: center;">@(c.quantity ?? 1)</td>
                                <td style="text-align: right;">₹@string.Format("{0:N2}", c.rate ?? 0)</td>
                                <td style="text-align: right; font-weight: 700; color: #0284c7;">₹@string.Format("{0:N2}", c.amount ?? 0)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer-custom">
            <button type="button" class="btn-modal-secondary" @onclick="CloseChargesModal">Close</button>
            @if (hasCreateRight)
            {
                <button type="button" class="btn-modal-primary" @onclick="() => { CloseChargesModal(); MoveToCashAsync(modalPatient); }" disabled="@(!IsCurrentCounterShiftOpen)">
                    <i class="bi bi-arrow-right-circle-fill"></i> Move to Cash
                </button>
            }
        </div>
    </div>
}

@code {
    public class OpUnbilledRow
    {
        public Guid op_id { get; set; }
        public string op_no { get; set; } = string.Empty;
        public decimal custid { get; set; }
        public string patient_name { get; set; } = string.Empty;
        public string mobile { get; set; } = string.Empty;
        public string doctor_name { get; set; } = string.Empty;
        public int dcode { get; set; }
        public string token_no { get; set; } = string.Empty;
        public string visit_type { get; set; } = string.Empty;
        public DateOnly visit_date { get; set; }
        public DateTime created_at { get; set; }
        public int unbilled_charges_count { get; set; }
        public decimal unbilled_charges_total { get; set; }
        public List<UnbilledChargeSummary> charges { get; set; } = new();
    }

    private bool loading = true;
    private bool isOpeningShift = false;
    private string? processingOpId = null;
    private bool isBulkProcessing = false;
    private int bulkProcessedCount = 0;

    // Selections & Filters
    private int selectedBranchCode = 0; // 0 means All Branches (Auto)
    private int selectedCounterCode = 1;
    private int selectedDoctorCode = 0;
    private string searchQuery = string.Empty;
    private string dateFilterMode = "TODAY"; // "TODAY", "YESTERDAY", "ALL", "CUSTOM"
    private DateTime fromDate = DateTime.UtcNow.ToIndianTime().Date;
    private DateTime toDate = DateTime.UtcNow.ToIndianTime().Date;

    // Master data
    private List<Booking.Models.BranchModel> branchesList = new();
    private List<CounterMasterModel> countersList = new();
    private List<CounterTimingDto> openCountersList = new();
    private List<DoctorMasterModel> doctorsList = new();

    // Data lists
    private List<OpUnbilledRow> allUnbilledList = new();
    private List<OpUnbilledRow> filteredList = new();
    private HashSet<string> selectedOpIds = new();

    // Modal
    private bool showChargesModal = false;
    private OpUnbilledRow? modalPatient = null;

    public class CounterDisplayItem
    {
        public int CntCode { get; set; }
        public int? BhCode { get; set; }
        public string Name { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public bool HasOpenShift { get; set; }
    }

    private IEnumerable<CounterDisplayItem> AvailableCountersForBranch
    {
        get
        {
            if (selectedBranchCode <= 0)
            {
                return AllAvailableCounters;
            }

            var list = new List<CounterDisplayItem>();
            var seen = new HashSet<int>();

            // 1. From counters explicitly configured for this branch
            foreach (var c in countersList.Where(c => !c.deleted && c.bhcode == selectedBranchCode))
            {
                int code = (int)c.cntcode;
                if (code <= 0 || !seen.Add(code)) continue;

                bool isOpen = openCountersList.Any(s => s.cntcode == code && s.todate == null);
                string baseName = !string.IsNullOrWhiteSpace(c.name) ? c.name.Trim() : $"Counter {code}";

                var branchObj = branchesList.FirstOrDefault(b => b.bh_code == c.bhcode);
                string branchTag = branchObj != null ? $" ({branchObj.name})" : $" (Branch #{c.bhcode})";

                list.Add(new CounterDisplayItem
                {
                    CntCode = code,
                    BhCode = c.bhcode,
                    Name = baseName,
                    DisplayName = $"{baseName}{branchTag}",
                    HasOpenShift = isOpen
                });
            }

            // 2. Also include any open shift records associated with this branch
            foreach (var s in openCountersList.Where(s => s.todate == null && s.cntcode.HasValue && s.bhcode == selectedBranchCode))
            {
                int code = s.cntcode!.Value;
                if (code <= 0 || !seen.Add(code)) continue;

                string baseName = $"Counter {code}";
                var branchObj = branchesList.FirstOrDefault(b => b.bh_code == s.bhcode);
                string branchTag = branchObj != null ? $" ({branchObj.name})" : $" (Branch #{s.bhcode})";

                list.Add(new CounterDisplayItem
                {
                    CntCode = code,
                    BhCode = s.bhcode,
                    Name = baseName,
                    DisplayName = $"{baseName}{branchTag}",
                    HasOpenShift = true
                });
            }

            // 3. Fallback: If no counters explicitly mapped to this branch, allow unassigned counters
            if (!list.Any())
            {
                foreach (var c in countersList.Where(c => !c.deleted && (c.bhcode == null || c.bhcode == 0)))
                {
                    int code = (int)c.cntcode;
                    if (code <= 0 || !seen.Add(code)) continue;

                    bool isOpen = openCountersList.Any(s => s.cntcode == code && s.todate == null);
                    string baseName = !string.IsNullOrWhiteSpace(c.name) ? c.name.Trim() : $"Counter {code}";

                    list.Add(new CounterDisplayItem
                    {
                        CntCode = code,
                        BhCode = c.bhcode,
                        Name = baseName,
                        DisplayName = $"{baseName} (Universal)",
                        HasOpenShift = isOpen
                    });
                }
            }

            if (!list.Any())
            {
                list.Add(new CounterDisplayItem
                {
                    CntCode = 1,
                    Name = "Counter 1",
                    DisplayName = "Counter 1",
                    HasOpenShift = openCountersList.Any(s => s.cntcode == 1 && s.todate == null)
                });
            }

            return list.OrderBy(x => x.CntCode);
        }
    }

    private IEnumerable<CounterDisplayItem> AllAvailableCounters
    {
        get
        {
            var list = new List<CounterDisplayItem>();
            var seen = new HashSet<int>();

            foreach (var c in countersList)
            {
                int code = (int)c.cntcode;
                if (code <= 0 || !seen.Add(code)) continue;

                bool isOpen = openCountersList.Any(s => s.cntcode == code && s.todate == null);
                string baseName = !string.IsNullOrWhiteSpace(c.name) ? c.name.Trim() : $"Counter {code}";

                var branchObj = branchesList.FirstOrDefault(b => b.bh_code == c.bhcode);
                string branchTag = branchObj != null 
                    ? $" ({branchObj.name})" 
                    : (c.bhcode.HasValue && c.bhcode.Value > 0 ? $" (Branch #{c.bhcode})" : "");

                list.Add(new CounterDisplayItem
                {
                    CntCode = code,
                    BhCode = c.bhcode,
                    Name = baseName,
                    DisplayName = $"{baseName}{branchTag}",
                    HasOpenShift = isOpen
                });
            }

            foreach (var s in openCountersList.Where(s => s.todate == null && s.cntcode.HasValue))
            {
                int code = s.cntcode!.Value;
                if (code <= 0 || !seen.Add(code)) continue;

                string baseName = $"Counter {code}";
                var branchObj = branchesList.FirstOrDefault(b => b.bh_code == s.bhcode);
                string branchTag = branchObj != null 
                    ? $" ({branchObj.name})" 
                    : (s.bhcode.HasValue && s.bhcode.Value > 0 ? $" (Branch #{s.bhcode})" : "");

                list.Add(new CounterDisplayItem
                {
                    CntCode = code,
                    BhCode = s.bhcode,
                    Name = baseName,
                    DisplayName = $"{baseName}{branchTag}",
                    HasOpenShift = true
                });
            }

            if (!list.Any())
            {
                list.Add(new CounterDisplayItem
                {
                    CntCode = 1,
                    Name = "Counter 1",
                    DisplayName = "Counter 1",
                    HasOpenShift = openCountersList.Any(s => s.cntcode == 1 && s.todate == null)
                });
            }

            return list.OrderBy(x => x.CntCode);
        }
    }

