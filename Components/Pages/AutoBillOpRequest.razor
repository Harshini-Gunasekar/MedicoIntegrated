    private void OnCounterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var cnt))
        {
            selectedCounterCode = cnt;

            // If selected counter has an open shift, sync selectedBranchCode to that shift's branch
            var shift = openCountersList.FirstOrDefault(s => s.cntcode == cnt && s.todate == null);
            if (shift != null && shift.bhcode.HasValue && shift.bhcode.Value > 0)
            {
                selectedBranchCode = shift.bhcode.Value;
            }
            else
            {
                var cm = countersList.FirstOrDefault(c => (int)c.cntcode == cnt);
                if (cm?.bhcode.HasValue == true && cm.bhcode.Value > 0)
                {
                    selectedBranchCode = cm.bhcode.Value;
                }
            }
            StateHasChanged();
        }
    }

