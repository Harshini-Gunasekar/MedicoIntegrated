    private async Task LoadItems()
    {
        IsLoading = true;
        try
        {
            var client = CreateTenantClient();
            var responseString = await client.GetStringAsync("ItemMaster/getallitems");

            try
            {
                var direct = System.Text.Json.JsonSerializer.Deserialize<List<item_master>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ItemsList = (direct ?? new List<item_master>()).Where(x => !x.deleted).ToList();
                foreach (var item in ItemsList)
                {
                    item.expiryrequired = item.isexpiry;
                }
            }
            catch
            {
                var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<item_master>>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ItemsList = (wrapped?.data ?? new List<item_master>()).Where(x => !x.deleted).ToList();
                foreach (var item in ItemsList)
                {
                    item.expiryrequired = item.isexpiry;
                }
            }
        }
        catch
        {
            ItemsList = new List<item_master>();
        }
        finally
        {
            IsLoading = false;
        }
    }

