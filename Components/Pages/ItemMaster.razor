@code {
    // Quick Add Modal States
    private bool showQuickManufacturerModal = false;
    private bool showQuickCategoryModal = false;
    private bool showQuickItemTypeModal = false;
    private bool showQuickUomModal = false;
    private bool showQuickLedgerGroupModal = false;
    private bool isQuickSaving = false;

    private manufacturer_master quickManufacturer = new();
    private parent_category_master quickCategory = new();
    private category_master quickItemType = new();
    private uom_master quickUom = new();
    private ledger_group_master quickLedgerGroup = new();
    private int quickLedgerGroupMappedType = 0;
    private string quickUomActiveField = "name";

    private string[] SpecialSymbols = new[] {
        "μ", "α", "β", "γ", "±", "°C", "℧", "÷", "×",
        "⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹", "⁺", "⁻", "⁼", "⁽", "⁾", "⁻¹",
        "₀", "₁", "₂", "₃", "₄", "₅", "₆", "₇", "₈", "₉", "₊", "₋", "₌", "₍", "₎", "ₓ", "ᵢ"
    };

    private void InsertQuickUomSymbol(string symbol)
    {
