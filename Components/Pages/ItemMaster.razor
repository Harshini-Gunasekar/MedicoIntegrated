        get => CurrentItem.ledgergroupcode == 0 ? CurrentItem.taxcode : CurrentItem.ledgergroupcode;
        set
        {
            CurrentItem.taxcode = value;
            CurrentItem.ledgergroupcode = value;

            var group = LedgerGroupList.FirstOrDefault(g => g.ledgergroupcode == value);
            if (group != null)
            {
                var type = LedgerTypeList.FirstOrDefault(t => t.ledgertypecode == group.ledgertypecode);
                CurrentItem.naturetype = type != null ? type.naturetype : group.ledgertypecode;
            }
            else
            {
                CurrentItem.naturetype = 0;
            }
        }
    }

    private string GetSelectedNatureTypeName()
    {
        return CurrentItem.naturetype switch
        {
            1 => "Asset",
            2 => "Liability",
            3 => "Expense",
            4 => "Income",
            5 => "Duties & Taxes",
            _ => string.Empty
        };
    }

    private void AddNewItem()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add items.");
            return;
        }
        OpenAddModal();
    }

    private async Task EditItem(item_master item)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit items.");
            return;
        }
        await OpenEditModal(item);
    }

    private void OpenAddModal()
    {
        CurrentItem = new item_master { tenantcode = DefaultTenantCode, isactive = true, packsize = 1, schedule = "", isnarcoticdrug = false };
        IsModalEdit = false;
        ShowItemModal = true;
    }

    private async Task OpenEditModal(item_master item)
    {
        IsModalEdit = true;
        ShowItemModal = true;
        try
        {
            var client = CreateTenantClient();
            var response = await client.GetStringAsync($"ItemMaster/getitembycode?itemcode={item.itemcode}");
            var loaded = ParseItemResponse(response);
            if (loaded is not null)
            {
                loaded.tenantcode = DefaultTenantCode;
                CurrentItem = loaded;

                if (CurrentItem.naturetype == 0)
                {
                    var group = LedgerGroupList.FirstOrDefault(g => g.ledgergroupcode == (CurrentItem.ledgergroupcode == 0 ? CurrentItem.taxcode : CurrentItem.ledgergroupcode));
                    if (group != null)
                    {
                        var type = LedgerTypeList.FirstOrDefault(t => t.ledgertypecode == group.ledgertypecode);
                        CurrentItem.naturetype = type != null ? type.naturetype : group.ledgertypecode;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error loading item: {ex.Message}", NotificationType.Error);
        }
    }

    private void CloseItemModal()
    {
        ShowItemModal = false;
        IsModalSaving = false;
        CurrentItem = new item_master { tenantcode = DefaultTenantCode, isactive = true, packsize = 1, schedule = "", isnarcoticdrug = false };
    }

    private void ToggleSchedule(string schedule)
    {
        if (CurrentItem.schedule == schedule)
        {
            CurrentItem.schedule = "";
        }
        else
        {
            CurrentItem.schedule = schedule;
        }
    }

    private void OnCategoryChanged()
    {
        if (IsMedicineSelected)
        {
            CurrentItem.expiryrequired = true;
        }
    }


    private async Task SaveItemFromModal()
    {
        if (IsModalEdit && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit items.");
            return;
        }
        if (!IsModalEdit && !hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add items.");
            return;
        }
        if (!IsMedicineSelected)
        {
            CurrentItem.schedule = "";
            CurrentItem.isnarcoticdrug = false;
            CurrentItem.drugname = "";
        }

        // Manual Validation Check
        var errors = new List<string>();
        if (string.IsNullOrWhiteSpace(CurrentItem.itemname)) errors.Add("Item Name");
        if (CurrentItem.categorycode <= 0) errors.Add("Category");
        if (CurrentItem.purchaserate <= 0) errors.Add("Purchase Rate");

        if (errors.Any())
        {
            var msg = $"Please provide valid: {string.Join(", ", errors)}";
            NotificationService.ShowNotification(msg, NotificationType.Warning);
            return;
        }

        IsModalSaving = true;
        try
        {
            var client = CreateTenantClient();
            CurrentItem.tenantcode = DefaultTenantCode;
            CurrentItem.isactive = true;

            // Sanitize string fields
            CurrentItem.shortname ??= "";
            CurrentItem.description ??= "";
            CurrentItem.itemtype ??= "";
            CurrentItem.manufacturer ??= "";
            CurrentItem.drugname ??= "";
            CurrentItem.packaging ??= "";
            CurrentItem.schedule ??= "";
            if (CurrentItem.ledgergroupcode == 0)
            {
                CurrentItem.ledgergroupcode = CurrentItem.taxcode;
            }
            
            if (CurrentItem.naturetype == 0)
            {
                var saveGroup = LedgerGroupList.FirstOrDefault(g => g.ledgergroupcode == CurrentItem.ledgergroupcode);
                if (saveGroup != null)
                {
                    var type = LedgerTypeList.FirstOrDefault(t => t.ledgertypecode == saveGroup.ledgertypecode);
                    CurrentItem.naturetype = type != null ? type.naturetype : saveGroup.ledgertypecode;
                }
            }
            CurrentItem.isexpiry = CurrentItem.expiryrequired;
            if (!CurrentItem.expiryrequired)
            {
                CurrentItem.expiryalertdays = 0;
            }

            // Print entered values payload JSON to the terminal/console
            try
            {
                var serializeOptions = new System.Text.Json.JsonSerializerOptions {
                    WriteIndented = true,
                    PropertyNamingPolicy = null
                };
                var jsonPayload = System.Text.Json.JsonSerializer.Serialize(CurrentItem, serializeOptions);
                Console.WriteLine("--- Item Save Payload JSON ---");
                Console.WriteLine(jsonPayload);
                Console.WriteLine("------------------------------");
                await JS.InvokeVoidAsync("console.log", "Sending Item JSON Payload:", jsonPayload);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error serializing item payload: {ex.Message}");
            }

            var isUpdate = CurrentItem.itemcode > 0;

            var baseUrl = isUpdate ? "ItemMaster/updateitem" : "ItemMaster/insertitem";
            var urls = new List<string> { baseUrl };
            if (isUpdate) urls.Add($"{baseUrl}?itemcode={CurrentItem.itemcode}");

            HttpResponseMessage? response = null;
            foreach (var targetUrl in urls)
            {
                try {
                    response = await client.PostAsJsonAsync(targetUrl, CurrentItem);
                    if (response.IsSuccessStatusCode) break;
                } catch { }
            }

            if (response != null && response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification(isUpdate ? "Item updated successfully" : "Item added successfully", NotificationType.Success);
                CloseItemModal();
                await LoadItems();
            }
            else
            {
                var error = response != null ? await response.Content.ReadAsStringAsync() : "Unknown error";
                NotificationService.ShowNotification($"Save failed: {error}", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsModalSaving = false;
        }
    }

    private async Task DeleteItemFromModal()
    {
        var code = CurrentItem?.itemcode ?? 0;
        if (code <= 0)
        {
            NotificationService.ShowNotification("Invalid item code for delete.", NotificationType.Error);
            return;
        }

        try
        {
            var success = await DeleteItem(code);
            if (success)
            {
                NotificationService.ShowNotification("Deleted successfully", NotificationType.Success);
                ShowItemModal = false;
                await LoadItems();
            }
            else
            {
                NotificationService.ShowNotification("Delete failed. Please verify API delete endpoint mapping.", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error deleting item: {ex.Message}", NotificationType.Error);
        }
    }

    private void ConfirmDelete(item_master item)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete items.");
            return;
        }
        PendingDeleteItem = item;
        ShowDeleteConfirmPopup = true;
    }

    private void CancelDeletePrompt()
    {
        ShowDeleteConfirmPopup = false;
        IsDeleteProcessing = false;
        PendingDeleteItem = null;
    }

    private async Task DeleteConfirmed()
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete items.");
            return;
        }
        var item = PendingDeleteItem;
        if (item is null)
        {
            CancelDeletePrompt();
            return;
        }

        IsDeleteProcessing = true;
        try
        {
            var success = await DeleteItem(item.itemcode);
            if (success)
            {
                NotificationService.ShowNotification("Item deleted successfully", NotificationType.Success);
                await LoadItems();
                CancelDeletePrompt();
            }
            else
            {
                CancelDeletePrompt();
                NotificationService.ShowNotification("Delete failed. Please verify API delete endpoint mapping.", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            CancelDeletePrompt();
            NotificationService.ShowNotification($"Error deleting item: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsDeleteProcessing = false;
        }
    }


    private async Task<bool> DeleteItem(int itemCode)
    {
        var client = CreateTenantClient();

        var attempts = new Func<Task<HttpResponseMessage>>[]
        {
            () => client.GetAsync($"ItemMaster/deleteitem?itemcode={itemCode}"),
            () => client.DeleteAsync($"ItemMaster/deleteitem?itemcode={itemCode}"),
            () => client.DeleteAsync($"ItemMaster/deleteitem/{itemCode}"),
            () => client.PostAsJsonAsync("ItemMaster/deleteitem", new { itemcode = itemCode, tenantcode = DefaultTenantCode }),
            () => client.PostAsync($"ItemMaster/deleteitem?itemcode={itemCode}", null)
        };

        foreach (var attempt in attempts)
        {
            var response = await attempt();
            if (response.IsSuccessStatusCode)
            {
                return true;
            }
        }

        return await SoftDeleteViaUpdate(itemCode);
    }

    private async Task<bool> SoftDeleteViaUpdate(int itemCode)
    {
        try
        {
            var client = CreateTenantClient();
            var responseText = await client.GetStringAsync($"ItemMaster/getitembycode?itemcode={itemCode}");
            var item = ParseItemResponse(responseText);

            if (item is null)
            {
                return false;
            }

            item.deleted = true;
            item.isactive = false;
            item.tenantcode = DefaultTenantCode;

            var updateResponse = await client.PostAsJsonAsync("ItemMaster/updateitem", item);
            return updateResponse.IsSuccessStatusCode;
        }
        catch
        {
            return false;
        }
    }

    private item_master? ParseItemResponse(string json)
    {
        var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };

        try
        {
            var direct = System.Text.Json.JsonSerializer.Deserialize<item_master>(json, options);
            if (direct is not null && direct.itemcode > 0)
            {
                direct.expiryrequired = direct.isexpiry;
                return direct;
            }
        }
        catch
        {
        }

        try
        {
            var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<item_master>>(json, options);
            if (wrapped?.data is not null && wrapped.data.itemcode > 0)
            {
                wrapped.data.expiryrequired = wrapped.data.isexpiry;
                return wrapped.data;
            }
        }
        catch
        {
        }

        return null;
    }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }
}



