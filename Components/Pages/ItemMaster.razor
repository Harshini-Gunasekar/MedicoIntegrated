@page "/itemmaster"
@page "/items"
@using Booking.Models
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.NotificationService NotificationService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject Booking.Services.ToastService ToastService

<div class="items-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                            <path d="m3.3 7 8.7 5 8.7-5" />
                            <path d="M12 22V12" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Item Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total items : @ItemsList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search items..." @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    @if (hasCreateRight)
                    {
                        <button class="add-item-btn" @onclick="AddNewItem">
                            <i class="bi bi-plus-lg"></i>
                            <span class="ms-1">Add Item</span>
                        </button>
                    }
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredItems.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        No items found. Adjust filters or create a new item.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive" style="overflow-x: clip;">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 30px;">S.NO</th>
                                    <th style="width: 65px;">ITEM CODE</th>
                                    <th style="width: 12%;">ITEM NAME</th>
                                    <th style="width: 70px;">SHORT NAME</th>
                                    <th style="width: 120px;">CATEGORY</th>
                                    <th style="width: 100px;">ITEM TYPE</th>
                                    <th style="width: 25px;">UOM<br/>CODE</th>
                                    <th style="width: 85px;">PURCHASE<br/>RATE</th>
                                    <th style="width: 85px;">MRP<br/>RATE</th>
                                    <th style="width: 55px;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedItems.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td>@((((CurrentPage - 1) * ItemsPerPage) + row.index + 1).ToString("D2"))</td>
                                        <td class="fw-bold text-primary">#@row.value.itemcode</td>
                                        <td>@row.value.itemname</td>
                                        <td>@row.value.shortname</td>
                                        <td>@(ParentCategoryList.FirstOrDefault(p => p.parentcategorycode == row.value.categorycode)?.parentcategoryname ?? row.value.categorycode.ToString())</td>
                                        <td>@(CategoryList.FirstOrDefault(c => c.categorycode == row.value.subcategorycode)?.categoryname ?? row.value.subcategorycode.ToString())</td>
                                        <td>
                                            @{
                                                var uom = UomList.FirstOrDefault(u => u.ucode == row.value.uomcode);
                                                if (uom != null)
                                                {
                                                    @(string.IsNullOrWhiteSpace(uom.shortname) ? uom.name : uom.shortname)
                                                }
                                                else
                                                {
                                                    @row.value.uomcode.ToString()
                                                }
                                            }
                                        </td>
                                        <td>₹@row.value.purchaserate.ToString("N2")</td>
                                        <td>₹@row.value.mrp.ToString("N2")</td>
                                        <td>
                                            @if (hasEditRight)
                                            {
                                                <button class="action-btn btn-edit" @onclick="async () => await EditItem(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            }
                                            @if (hasDeleteRight)
                                            {
                                                <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var item in PagedItems)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span><span class="card-item-code">#@item.itemcode</span> <span class="card-item-name">@item.itemname</span></span>
                                    <div>
                                        @if (hasEditRight)
                                        {
                                            <button class="action-btn btn-edit" @onclick="async () => await EditItem(item)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(item)" title="Delete"><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Short Name</span><strong>@item.shortname</strong></div>
                                    <div class="detail-row"><span>Manufacturer</span><strong>@(ManufacturerList.FirstOrDefault(m => m.manufacturercode == item.manufacturercode)?.manufacturername ?? item.manufacturer ?? "")</strong></div>
                                    <div class="detail-row"><span>Category</span><strong>@(ParentCategoryList.FirstOrDefault(p => p.parentcategorycode == item.categorycode)?.parentcategoryname ?? item.categorycode.ToString())</strong></div>
                                    <div class="detail-row"><span>Item Type</span><strong>@(CategoryList.FirstOrDefault(c => c.categorycode == item.subcategorycode)?.categoryname ?? item.subcategorycode.ToString())</strong></div>
                                    <div class="detail-row"><span>Uom Name</span><strong>@(UomList.FirstOrDefault(u => u.ucode == item.uomcode)?.name ?? item.uomcode.ToString())</strong></div>
                                    <div class="detail-row"><span>Purchase Rate</span><strong>₹@item.purchaserate.ToString("N2")</strong></div>
                                    <div class="detail-row"><span>MRP Rate</span><strong>₹@item.mrp.ToString("N2")</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredItems.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredItems.Count()))</strong> of <strong>@FilteredItems.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    
                    <div class="pagination-bar" style="margin-right: 0; display: flex; align-items: center; gap: 4px;">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        
                        @if (TotalPages > 0)
                        {
                            @foreach (var pageNum in GetVisiblePageNumbers())
                            {
                                var p = pageNum;
                                <button class="page-btn @(CurrentPage == p ? "active" : "")" @onclick="() => ChangePage(p)">
                                    @p
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowItemModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 950px; width: 95%;">
            <div class="modal-header-bar" style="padding: 12px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #000000 !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsModalEdit ? "Edit Item" : "Add Item")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseItemModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentItem" OnValidSubmit="SaveItemFromModal" autocomplete="off">
                    <DataAnnotationsValidator />
                    <div class="modal-scroll-area purchase-bill-fields" style="overflow-x: hidden; padding: 8px 24px 8px 8px;">
                        <!-- Section 1: General Information -->
                        <div class="form-section-header" style="margin-bottom: 10px; margin-top: 4px; padding-bottom: 4px; border-bottom: 1px solid #f1f5f9;">
                             <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">General Information</div>
                        </div>

                        <div class="form-grid" style="margin-bottom: 12px; row-gap: 12px;">
                            <div class="field-group col-3">
                                <label class="field-label required">Item Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.itemname" />
                                <ValidationMessage For="() => CurrentItem.itemname" class="text-danger small" />
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Short Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.shortname" />
                            </div>
                            <div class="field-group col-4">
                                <label class="field-label">Description</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.description" />
                            </div>
                             <div class="field-group col-3">
                                 <div class="field-label-row">
                                     <label class="field-label mb-0">Manufacturer</label>
                                     <button type="button" class="btn-quick-add-mini" title="Add Manufacturer" @onclick="OpenQuickManufacturerModal">
                                         <i class="bi bi-plus-lg"></i>
                                     </button>
                                 </div>
                                 <InputSelect class="form-control premium-input" @bind-Value="CurrentItem.manufacturercode" @bind-Value:after="OnManufacturerChanged">
                                     <option value="0">-- Select Manufacturer --</option>
                                     @foreach (var m in ManufacturerList)
                                     {
                                         <option value="@m.manufacturercode">@m.manufacturername</option>
                                     }
                                 </InputSelect>
                             </div>
                        </div>

                        <!-- Section: Category -->
                        <div class="form-section-header" style="margin-bottom: 10px; margin-top: 8px; padding-bottom: 4px; border-bottom: 1px solid #f1f5f9;">
                             <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Category</div>
                        </div>

                        <div class="form-grid" style="margin-bottom: 12px; row-gap: 12px;">
                            <div class="field-group col-3">
                                <div class="field-label-row">
                                    <label class="field-label required mb-0">Category</label>
                                    <button type="button" class="btn-quick-add-mini" title="Add Category" @onclick="OpenQuickCategoryModal">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentItem.categorycode" @bind-Value:after="OnCategoryChanged">
                                    <option value="0">-- Select Category --</option>
                                    @foreach (var p in ParentCategoryList)
                                    {
                                        <option value="@p.parentcategorycode">@p.parentcategoryname</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => CurrentItem.categorycode" class="text-danger small" />
                            </div>
                            <div class="field-group col-3">
                                <div class="field-label-row">
                                    <label class="field-label mb-0">Item Type</label>
                                    <button type="button" class="btn-quick-add-mini" title="Add Item Type" @onclick="OpenQuickItemTypeModal">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentItem.subcategorycode">
                                    <option value="0">-- Select Item Type --</option>
                                    @foreach (var c in CategoryList.Where(x => x.parentcategorycode == CurrentItem.categorycode))
                                    {
                                        <option value="@c.categorycode">@c.categoryname</option>
                                    }
                                </InputSelect>
                            </div>
                            @if (IsMedicineSelected)
                            {
                                <div class="field-group col-3">
                                    <label class="field-label">Schedule</label>
                                    <div class="schedule-checkboxes-group" style="height: 32px;">
                                        <label class="schedule-check-item">
                                            <input class="schedule-check-input" type="checkbox" checked="@(CurrentItem.schedule == "OTC")" @onclick='() => ToggleSchedule("OTC")' />
                                            <span class="schedule-check-label">OTC</span>
                                        </label>
                                        <label class="schedule-check-item">
                                            <input class="schedule-check-input" type="checkbox" checked="@(CurrentItem.schedule == "H")" @onclick='() => ToggleSchedule("H")' />
                                            <span class="schedule-check-label">H</span>
                                        </label>
                                        <label class="schedule-check-item">
                                            <input class="schedule-check-input" type="checkbox" checked="@(CurrentItem.schedule == "H1")" @onclick='() => ToggleSchedule("H1")' />
                                            <span class="schedule-check-label">H1</span>
                                        </label>
                                        <label class="schedule-check-item">
                                            <input class="schedule-check-input" type="checkbox" checked="@(CurrentItem.schedule == "X")" @onclick='() => ToggleSchedule("X")' />
                                            <span class="schedule-check-label">X</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="field-group col-3">
                                    <label class="field-label">Drug Name</label>
                                    <InputText class="form-control premium-input" @bind-Value="CurrentItem.drugname" placeholder="Drug Name" />
                                </div>
                                <div class="field-group col-2">
                                    <label class="field-label">Narcotic Drug</label>
                                    <div class="premium-segmented-control-joined">
                                        <button type="button" class="segment-btn-joined btn-false @(CurrentItem.isnarcoticdrug ? "" : "active")" @onclick="() => CurrentItem.isnarcoticdrug = false">
                                            False
                                        </button>
                                        <button type="button" class="segment-btn-joined btn-true @(CurrentItem.isnarcoticdrug ? "active" : "")" @onclick="() => CurrentItem.isnarcoticdrug = true">
                                            True
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Section 2: Pricing & Inventory -->
                         <div class="form-section-header" style="margin-bottom: 10px; margin-top: 8px; padding-bottom: 4px; border-bottom: 1px solid #f1f5f9;">
                             <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Pricing & Inventory</div>
                         </div>

                        <div class="form-grid" style="margin-bottom: 12px; row-gap: 12px;">
                            <div class="field-group col-2">
                                <label class="field-label required">Purchase Rate (₹)</label>
                                <InputNumber class="form-control premium-input" @bind-Value="PurchaseRateInput" placeholder="0.00" />
                                <ValidationMessage For="() => CurrentItem.purchaserate" class="text-danger small" />
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Sales Rate (₹)</label>
                                <InputNumber class="form-control premium-input" @bind-Value="SalesRateInput" placeholder="0.00" />
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">MRP Rate (₹)</label>
                                <InputNumber class="form-control premium-input" @bind-Value="MrpInput" placeholder="0.00" />
                            </div>
                            <div class="field-group col-4">
                                <div class="field-label-row">
                                    <label class="field-label mb-0">Unit of Measure (UOM)</label>
                                    <button type="button" class="btn-quick-add-mini" title="Add Unit of Measure" @onclick="OpenQuickUomModal">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentItem.uomcode">
                                    <option value="0">Select UOM</option>
                                    @foreach (var uom in UomList)
                                    {
                                        <option value="@uom.ucode">@uom.name (@uom.shortname)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Pack Size</label>
                                <InputNumber class="form-control premium-input" @bind-Value="PackSizeInput" placeholder="0" />
                            </div>
                        </div>

                        <!-- Section 3: Taxation & Expiry -->
                         <div class="form-section-header" style="margin-bottom: 10px; margin-top: 8px; padding-bottom: 4px; border-bottom: 1px solid #f1f5f9;">
                             <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Taxation & Expiry</div>
                         </div>

                        <div class="form-grid" style="margin-bottom: 12px; row-gap: 12px;">
                            <div class="field-group col-2">
                                <label class="field-label">HSN Code</label>
                                <InputNumber class="form-control premium-input" @bind-Value="HsnCodeInput" placeholder="0" />
                            </div>
                            <div class="field-group col-2">
                                <div class="field-label-row">
                                    <label class="field-label mb-0">Accounting Group</label>
                                    <button type="button" class="btn-quick-add-mini" title="Add Accounting Group" @onclick="OpenQuickLedgerGroupModal">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                                <InputSelect class="form-control premium-input" @bind-Value="SelectedAccountingGroup">
                                    <option value="0">-- Select Group --</option>
                                    @foreach (var group in LedgerGroupList)
                                    {
                                        <option value="@group.ledgergroupcode">@group.ledgergroupname</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="field-group col-2">
                                 <label class="field-label">Nature Type</label>
                                 <InputSelect class="form-control premium-input" @bind-Value="CurrentItem.naturetype">
                                     <option value="0">-- Select Nature --</option>
                                     <option value="1">Asset</option>
                                     <option value="2">Liability</option>
                                     <option value="3">Expense</option>
                                     <option value="4">Income</option>
                                     <option value="5">Duties & Taxes</option>
                                 </InputSelect>
                             </div>
                            <div class="field-group col-2">
                                <label class="field-label">GST %</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentItem.gstpercentage">
                                    <option value="0">-- Select GST % --</option>
                                    @foreach (var pct in LedgerTypeList.Where(x => x.isgstapplicable).Select(x => (int)(x.sgstpercentage + x.cgstpercentage)).Distinct().OrderBy(x => x))
                                    {
                                        <option value="@pct">GST @($"{pct}%")</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Min Stock</label>
                                <InputNumber class="form-control premium-input" @bind-Value="MinStockInput" placeholder="0" />
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Reorder Level</label>
                                <InputNumber class="form-control premium-input" @bind-Value="ReorderLevelInput" placeholder="0" />
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Is Expiry?</label>
                                <div class="premium-segmented-control-joined">
                                    <button type="button" class="segment-btn-joined btn-false @(CurrentItem.expiryrequired ? "" : "active")" @onclick="() => CurrentItem.expiryrequired = false">
                                        False
                                    </button>
                                    <button type="button" class="segment-btn-joined btn-true @(CurrentItem.expiryrequired ? "active" : "")" @onclick="() => CurrentItem.expiryrequired = true">
                                        True
                                    </button>
                                </div>
                            </div>
                            <div class="field-group col-2">
                                @if (CurrentItem.expiryrequired)
                                {
                                    <label class="field-label">No of Days</label>
                                    <InputNumber class="form-control premium-input" @bind-Value="ExpiryAlertDaysInput" placeholder="0" />
                                }
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-actions" style="display: flex; justify-content: flex-end; align-items: center; padding: 10px 24px; border-top: 1px solid #f1f5f9; background: #fff;">
                        <div class="footer-right" style="display: flex; gap: 0.75rem; align-items: center;">
                            <button type="button" class="btn-cancel-modal" @onclick="CloseItemModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.5rem 1.5rem; border-radius: 12px; font-weight: 700; min-width: 100px; transition: all 0.2s;">
                                Cancel
                            </button>
                            <button type="submit" class="btn-save-premium" disabled="@IsModalSaving" style="background: #1c9f5f; color: white; border: none; padding: 0.5rem 1.75rem; border-radius: 12px; font-weight: 700; display: flex; align-items: center; gap: 8px; min-width: 140px; box-shadow: 0 4px 12px rgba(28, 159, 95, 0.2); transition: all 0.2s;">
                                @if (IsModalSaving)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle" style="font-size: 1.2rem;"></i>
                                }
                                <span>@(IsModalEdit ? "Update Item" : "Save Item")</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirmPopup)
{
    <div class="action-popup-overlay" @onclick="CancelDeletePrompt">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Item</div>
            <div class="action-popup-body">Are you sure you want to delete?</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="CancelDeletePrompt">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" disabled="@IsDeleteProcessing" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

<!-- Quick Add Manufacturer Modal -->
@if (showQuickManufacturerModal)
{
    <div class="quick-modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 800px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
