    private async Task RefreshDataAsync()
    {
        loading = true;
        try
        {
            allBeds = await BedService.GetBedMastersAsync();
            
            int? blockParam = selectedBlock > 0 ? selectedBlock : null;
            int? floorParam = selectedFloor > 0 ? selectedFloor : null;
            int? wardParam = selectedWard > 0 ? selectedWard : null;
            
            availableBeds = await BedService.GetAvailableBedsAsync(blockParam, floorParam, wardParam);
            activeAdmissions = await IpService.GetIpRegistrationsAsync("ADMITTED");
            bedTransfers = await BedTransferService.GetBedTransfersAsync();
            bedStatuses = await BedStatusService.GetBedStatusesAsync();
            pendingCleaningBeds = await BedService.GetPendingCleaningBedsAsync();
            
            FilterAllBeds();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading beds data: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void FilterAllBeds()
    {
        filteredAllBeds = allBeds.Where(b => 
            (selectedFloor == 0 || b.flrcode == selectedFloor) && 
            (selectedWard == 0 || b.wrdcode == selectedWard)
        )
        .OrderBy(b => b.bedname)
        .ToList();

        var occupiedBedCodes = new HashSet<int>();
        foreach (var a in activeAdmissions)
        {
            var latestTransfer = bedTransfers
                .Where(t => t.lastvisitid == a.ip_id.ToString())
                .OrderByDescending(t => t.transferdate)
                .FirstOrDefault();
            var currentBedCode = latestTransfer != null ? latestTransfer.transbed : a.bedcode;
            if (currentBedCode.HasValue)
            {
                occupiedBedCodes.Add(currentBedCode.Value);
            }
        }

        foreach (var bed in filteredAllBeds)
        {
            var isPC = pendingCleaningBeds.Any(pc => pc.bedcode == bed.bedcode);
            var isOccupied = occupiedBedCodes.Contains(bed.bedcode);
            var av = availableBeds.FirstOrDefault(ab => ab.bedcode == bed.bedcode);

            if (isPC || (!isOccupied && av == null))
            {
                bed.bed_status = "DIRTY";
                bed.is_cleaned = false;
            }
            else if (isOccupied)
            {
                bed.bed_status = "OCCUPIED";
            }
            else if (av != null)
            {
                bed.bed_status = av.bed_status ?? "AVAILABLE";
                bed.is_cleaned = av.is_cleaned;
                bed.admitted_at = av.admitted_at;
                bed.discharged_at = av.discharged_at;
                bed.cleaned_at = av.cleaned_at;
                bed.cleaned_by = av.cleaned_by;
            }
        }

        if (selectedBed != null)
        {
            if (!filteredAllBeds.Any(b => b.bedcode == selectedBed.bedcode))
            {
                selectedBed = null;
                occupiedPatientDetails = null;
                occupiedCustomerDetails = null;
            }
        }
    }

    private async Task OnFiltersChanged()
    {
        await RefreshDataAsync();
    }

    private void OnBedClicked(BedMasterModel bed)
    {
        if (selectedBed != null && selectedBed.bedcode == bed.bedcode)
        {
            selectedBed = null;
            occupiedPatientDetails = null;
            occupiedCustomerDetails = null;
        }
        else
        {
            selectedBed = bed;
            cleaningStatusToggle = "DIRTY";
            cleanedBy = "";
            cleaningNotes = "";
            var isAvailable = bed.bed_status == "AVAILABLE";
            if (isAvailable)
            {
                occupiedPatientDetails = null;
                occupiedCustomerDetails = null;
                ToastService.ShowSuccess($"Selected Available Bed: {bed.bedname}");
            }
            else
            {
                // Find patient details for occupied bed
                occupiedPatientDetails = activeAdmissions.FirstOrDefault(a => 
                {
                    var latestTransfer = bedTransfers.Where(t => t.lastvisitid == a.ip_id.ToString()).OrderByDescending(t => t.transferdate).FirstOrDefault();
                    var currentBedCode = latestTransfer != null ? latestTransfer.transbed : a.bedcode;
                    return currentBedCode == bed.bedcode;
                });
                if (occupiedPatientDetails != null)
                {
                    occupiedCustomerDetails = customersList.FirstOrDefault(c => c.custid.ToString() == occupiedPatientDetails.custid.ToString());
                }
                else
                {
                    occupiedCustomerDetails = null;
                }
            }
        }
    }

    private async Task ConfirmBedAllocation()
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to allocate beds.");
            return;
        }
        if (selectedBed == null) return;
        if (draftAdmission == null)
        {
            ToastService.ShowError("No registration in progress. Please start from the Admissions dashboard.");
            return;
        }

        if (selectedBed == null)
        {
            ToastService.ShowError("Please select a bed.");
            return;
        }

        try
        {
            draftAdmission.bedcode = selectedBed.bedcode;
            draftAdmission.blockcode = floorsList.FirstOrDefault(f => f.flrcode == selectedBed.flrcode)?.blockcode;
            draftAdmission.flrcode = selectedBed.flrcode;
            draftAdmission.wrdcode = selectedBed.wrdcode;
            draftAdmission.rmtcode = selectedBed.rmtcode;

            var payloadJson = Newtonsoft.Json.JsonConvert.SerializeObject(draftAdmission, Newtonsoft.Json.Formatting.Indented);
            Console.WriteLine("--- SENDING IP REGISTRATION PAYLOAD TO BACKEND DATABASE ---");
            Console.WriteLine(payloadJson);
            Console.WriteLine("-----------------------------------------------------------");

            bool success = await IpService.AdmitPatientAsync(draftAdmission);
            if (success)
            {
                ToastService.ShowSuccess("Bed allocated and patient admitted successfully!");
                await _sessionStorage.DeleteAsync("DraftAdmission");
                Navigation.NavigateTo("/booking/ip-registration");
            }
            else
            {
                ToastService.ShowError("Failed to allocate bed and admit patient.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error confirming admission: {ex.Message}");
        }
    }

    private void OpenAdmitModal()
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to admit patients from here.");
            return;
        }
        if (selectedBed == null) return;
        selectedPatientSearchName = "";
        admitRequest = new IPRegistrationModel.CreateIpRegistrationRequest
        {
            admission_type = "PLANNED",
            admitdate = DateTime.Now,
            branchcode = 101,
            bedcode = selectedBed.bedcode,
            blockcode = floorsList.FirstOrDefault(f => f.flrcode == selectedBed.flrcode)?.blockcode,
            flrcode = selectedBed.flrcode,
            wrdcode = selectedBed.wrdcode,
            rmtcode = selectedBed.rmtcode,
            isinsurancepatient = false
        };
        showAdmitModal = true;
    }

    private void CloseAdmitModal()
    {
        showAdmitModal = false;
    }

    private async Task ExecuteAdmit()
    {
        if (admitRequest.custid <= 0)
        {
            ToastService.ShowError("Please select a patient.");
            return;
        }
        if (admitRequest.dcode <= 0)
        {
            ToastService.ShowError("Please select a doctor.");
            return;
        }
        if (admitRequest.bedcode <= 0)
        {
            ToastService.ShowError("Please allocate a bed.");
            return;
        }

        try
        {
            var payloadJson = Newtonsoft.Json.JsonConvert.SerializeObject(admitRequest, Newtonsoft.Json.Formatting.Indented);
            Console.WriteLine("--- SENDING IP REGISTRATION PAYLOAD TO BACKEND DATABASE ---");
            Console.WriteLine(payloadJson);
            Console.WriteLine("-----------------------------------------------------------");
            try
            {
                await JSRuntime.InvokeVoidAsync("console.log", "Sending IP Registration Payload to Backend Database:", payloadJson);
            }
            catch { }

            bool success = await IpService.AdmitPatientAsync(admitRequest);
            if (success)
            {
                ToastService.ShowSuccess("Patient admitted successfully!");
                showAdmitModal = false;
                selectedBed = null;
                await RefreshDataAsync();
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Failed to admit patient.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error admitting patient: {ex.Message}");
        }
    }

    private async Task MarkBedAsCleaned()
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to update cleaning status.");
            return;
        }
        if (selectedBed == null) return;

        if (cleaningStatusToggle == "DIRTY")
        {
            selectedBed = null;
            return;
        }

        if (string.IsNullOrEmpty(cleanedBy))
        {
            ToastService.ShowError("Please mention the member who cleaned the bed.");
            return;
        }
        
        try
        {
            var req = new medico_backend.Model.MarkBedCleanedRequest
            {
                bedcode = selectedBed.bedcode,
                cleaned_by = cleanedBy,
                notes = string.IsNullOrEmpty(cleaningNotes) ? "Sanitized and linen changed" : cleaningNotes
            };

            bool success = await BedStatusService.MarkBedCleanedAsync(req);
            if (success)
            {
                ToastService.ShowSuccess($"{selectedBed.bedname} marked as cleaned and is now available!");
                selectedBed = null;
                await RefreshDataAsync();
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Failed to update bed status on backend.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error marking bed cleaned: {ex.Message}");
        }
    }
