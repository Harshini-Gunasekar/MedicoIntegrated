    private string selectedPatientSearchName = "";
    private bool showPatientDropdown = false;
    private int activeDropdownIndex = 0;
    private List<SharedComponents.Rcl.Models.CustomerModel> filteredPatientsForDropdown = new();

    private void OnPatientSearchInput(ChangeEventArgs e)
    {
        selectedPatientSearchName = e.Value?.ToString() ?? "";
        UpdateFilteredPatients();
        showPatientDropdown = true;
        activeDropdownIndex = 0;
    }

    private void UpdateFilteredPatients()
    {
        if (string.IsNullOrWhiteSpace(selectedPatientSearchName))
        {
            filteredPatientsForDropdown = customersList.Take(50).ToList();
        }
        else
        {
            filteredPatientsForDropdown = customersList
                .Where(c => (c.name != null && c.name.Contains(selectedPatientSearchName, StringComparison.OrdinalIgnoreCase)) ||
                            (c.custcode != null && c.custcode.Contains(selectedPatientSearchName, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    private void ShowPatientDropdown()
    {
        UpdateFilteredPatients();
        showPatientDropdown = true;
    }

    private async Task HidePatientDropdownWithDelay()
    {
        await Task.Delay(250);
        showPatientDropdown = false;
    }

    private void SelectPatientFromDropdown(SharedComponents.Rcl.Models.CustomerModel p)
    {
        admitRequest.custid = p.custid;
        selectedPatientSearchName = $"{p.custcode} {p.name}";
        showPatientDropdown = false;
        StateHasChanged();
        PrintPayload();
    }

    private void OnPatientSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown")
        {
            if (filteredPatientsForDropdown.Any())
            {
                activeDropdownIndex = (activeDropdownIndex + 1) % filteredPatientsForDropdown.Count;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            if (filteredPatientsForDropdown.Any())
            {
                activeDropdownIndex = (activeDropdownIndex - 1 + filteredPatientsForDropdown.Count) % filteredPatientsForDropdown.Count;
            }
        }
        else if (e.Key == "Enter")
        {
            if (filteredPatientsForDropdown.Any() && activeDropdownIndex >= 0 && activeDropdownIndex < filteredPatientsForDropdown.Count)
            {
                SelectPatientFromDropdown(filteredPatientsForDropdown[activeDropdownIndex]);
            }
        }
    }
