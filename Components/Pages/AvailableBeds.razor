@page "/booking/available-beds"
@rendermode InteractiveServer

@using Medico_Backend.Model
@using medico_backend.Model
@using Booking.Services
@using Newtonsoft.Json
@using Booking.Models
@inject BedMasterService BedService
@inject BlockMasterService BlockService
@inject FloorMasterService FloorService
@inject WardMasterService WardService
@inject DoctorService DoctorService
@inject ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject NavigationManager Navigation
@inject IpRegistrationService IpService
@inject RoomTypeMasterService RoomTypeService
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation
@inject BedTransferService BedTransferService
@inject BedStatusService BedStatusService
@inject NurseMasterService NurseService
@inject IJSRuntime JSRuntime
@inject LabSettingService LabSettingService

<PageTitle>Available Beds Visualizer</PageTitle>

<style>
    .um-grid-cols-3 {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 1.25rem !important;
        margin-bottom: 0.75rem !important;
    }
</style>

<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
</div>

<div class="dashboard-container">
    @* --- HEADER --- *@
    <div class="dashboard-header">
        <div class="dashboard-title">
            <h1>Available Beds</h1>
            <p>Search and select the available beds.</p>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <div style="position: relative; width: 280px;">
                <i class="bi bi-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #64748b; font-size: 0.85rem;"></i>
                <input type="text" class="filter-control" style="padding-left: 2.2rem; height: 38px;" 
                       @bind="filterSearch" @bind:event="oninput" @bind:after="FilterAllBeds" 
                       placeholder="Search by patient name/IP no..." />
            </div>
            @if (draftAdmission != null)
            {
                <span class="selection-badge" style="background-color: #eff6ff; border-color: #3b82f6; color: #1e40af; font-weight: 700;">
                    Admitting Patient: @(customersList.FirstOrDefault(c => c.custid.ToString() == draftAdmission.custid.ToString())?.name ?? draftAdmission.custid.ToString())
                </span>
            }
            <button class="btn-header-action" @onclick="RefreshDataAsync" disabled="@loading">
                @if (loading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                }
                <i class="bi bi-arrow-clockwise"></i> Refresh 
            </button>
        </div>
    </div>

    @* --- FILTERS & LEGEND --- *@
    <div class="filters-card">
        <div class="filters-row" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 1rem;">
            <div style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
                <div class="filter-group" style="max-width: 160px; min-width: 140px;">
                    <label>Block</label>
                    <select class="filter-control" @bind="selectedBlock" @bind:after="OnFiltersChanged">
                        <option value="0">All Blocks</option>
                        @foreach (var blk in blocksList)
                        {
                            <option value="@blk.blockcode">@blk.name</option>
                        }
                    </select>
                </div>
                <div class="filter-group" style="max-width: 160px; min-width: 140px;">
                    <label>Floor</label>
                    <select class="filter-control" @bind="selectedFloor" @bind:after="OnFiltersChanged">
                        <option value="0">All Floors</option>
                        @foreach (var flr in floorsList)
                        {
                            <option value="@flr.flrcode">@flr.name</option>
                        }
                    </select>
                </div>
                <div class="filter-group" style="max-width: 160px; min-width: 140px;">
                    <label>Ward</label>
                    <select class="filter-control" @bind="selectedWard" @bind:after="OnFiltersChanged">
                        <option value="0">All Wards</option>
                        @foreach (var wrd in wardsList)
                        {
                            <option value="@wrd.wrdcode">@wrd.name</option>
                        }
                    </select>
                </div>
            </div>
            
            @* --- TOP LEGEND --- *@
            <div class="top-legend">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <div class="legend-box available" style="width: 16px; height: 16px; border-radius: 4px;"></div>
                    <span>Available</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <div class="legend-box occupied" style="width: 16px; height: 16px; border-radius: 4px;"></div>
                    <span>Booked</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <div class="legend-box dirty" style="width: 16px; height: 16px; border-radius: 4px;"></div>
                    <span>Pending Cleaning</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <div class="legend-box selected" style="width: 16px; height: 16px; border-radius: 4px;"></div>
                    <span>Selected</span>
                </div>
            </div>
        </div>
    </div>

    @* --- LAYOUT MAIN --- *@
    <div class="layout-main">
        @* --- BEDS GRID --- *@
        <div class="beds-view-card">
            @if (selectedBed != null)
            {
                <div class="view-header" style="margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center;">
                    <div class="selection-badge">
                        Selected Bed: <strong>@selectedBed.bedname</strong>
                    </div>
                </div>
            }

            @if (loading)
            {
                <div class="loading-state" style="padding: 3rem 0;">
                    <DnaLoader IsLoading="true" Overlay="false" Message="Loading Available Beds" />
                </div>
            }
            else if (!filteredAllBeds.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <h4>No beds found</h4>
                    <p>Try adjusting your block, floor, or ward filters.</p>
                </div>
            }
            else
            {
                <div class="beds-grid">
                    @foreach (var bed in filteredAllBeds)
                    {
                        var isAvailable = bed.bed_status == "AVAILABLE";
                        var isDirty = bed.bed_status == "DIRTY";
                        var isSelected = selectedBed != null && selectedBed.bedcode == bed.bedcode;
 
                        <button type="button" 
                                class="bed-box @(isSelected ? "selected" : (isDirty ? "dirty" : (isAvailable ? "available" : "occupied")))"
                                @onclick="() => OnBedClicked(bed)">
                            <div class="bed-icon">
                                @if (isSelected)
                                {
                                    <i class="bi bi-check-circle-fill"></i>
                                }
                                else if (isDirty)
                                {
                                    <i class="bi bi-door-open"></i>
                                }
                                else if (isAvailable)
                                {
                                    <i class="bi bi-door-open"></i>
                                }
                                else
                                {
                                    <i class="bi bi-person-workspace"></i>
                                }
                            </div>
                            <div class="bed-number">@bed.bedname</div>
                            <div class="bed-info">
                                @(wardsList.FirstOrDefault(w => w.wrdcode == bed.wrdcode)?.name ?? "Ward")
                            </div>
                        </button>
                    }
                </div>
            }
        </div>

        @* Details Column was removed to stretch the bed layout, details are now shown as a popup modal *@
    </div>
</div>

@* --- ADMIT PATIENT MODAL --- *@
@if (showAdmitModal)
{
    <div class="modal-backdrop"></div>
    <div class="glass-modal large-modal-custom">
        <div class="modal-header">
            <h3>New Inpatient Admission @(selectedBed?.bedname)</h3>
            <button class="close-btn" @onclick="CloseAdmitModal">&times;</button>
        </div>
        <div class="modal-body">
            @* Row 1: Patient, Doctor, Type, Reason *@
            <div class="um-grid-cols-4">
                <div class="form-group" style="position: relative;">
                    <label>Select Patient *</label>
                    <div style="position: relative;">
                        <input type="text" class="filter-control" placeholder="-- Choose Patient --" 
                               value="@selectedPatientSearchName" 
                               @oninput="OnPatientSearchInput" 
                               @focus="ShowPatientDropdown" 
                               @onblur="HidePatientDropdownWithDelay" 
                               @onkeydown="OnPatientSearchKeyDown" />
                        
                        @if (showPatientDropdown)
                        {
                            <div style="position: absolute; top: 100%; left: 0; right: 0; z-index: 1050; max-height: 200px; overflow-y: auto; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); margin-top: 2px;">
                                @if (filteredPatientsForDropdown.Any())
                                {
                                    @for (int idx = 0; idx < filteredPatientsForDropdown.Count; idx++)
                                    {
                                        var pIndex = idx;
                                        var p = filteredPatientsForDropdown[idx];
                                        <div @onmousedown="() => SelectPatientFromDropdown(p)" 
                                             style="padding: 6px 12px; cursor: pointer; font-size: 0.8rem; color: #1e293b; background-color: @(idx == activeDropdownIndex ? "#f1f5f9" : "transparent");">
                                            @p.custcode @p.name
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div style="padding: 8px 12px; font-size: 0.8rem; color: #64748b; font-style: italic;">No patients found</div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="form-group">
                    <label>Assigned Doctor *</label>
                    <select class="filter-control" @bind="admitRequest.dcode" @bind:after="PrintPayload">
                        <option value="0">-- Choose Doctor --</option>
                        @foreach (var d in doctorsList)
                        {
                            <option value="@d.dcode">Dr. @d.name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Admission Type</label>
                    <select class="filter-control" @bind="admitRequest.admission_type" @bind:after="PrintPayload">
                        <option value="PLANNED">PLANNED</option>
                        <option value="EMERGENCY">EMERGENCY</option>
                        <option value="REFERRAL">REFERRAL</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Admission Reason</label>
                    <input type="text" class="filter-control" @bind="admitRequest.admission_reason" @bind:event="oninput" @bind:after="PrintPayload" placeholder="e.g. Appendectomy" />
                </div>
            </div>

            @* Row 2: Expected Discharge Date & Guardian Info *@
            <div class="um-grid-cols-4">
                <div class="form-group">
                    <label>Expected Discharge Date</label>
                    <input type="date" class="filter-control" @bind="admitRequest.expected_dischargedate" @bind:after="PrintPayload" />
                </div>
                <div class="form-group">
                    <label>Guardian Name</label>
                    <input type="text" class="filter-control" @bind="admitRequest.guardian_name" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Name" />
                </div>
                <div class="form-group">
                    <label>Relation</label>
                    <input type="text" class="filter-control" @bind="admitRequest.guardian_relation" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Relation" />
                </div>
                <div class="form-group">
                    <label>Contact No</label>
                    <input type="text" class="filter-control" @bind="admitRequest.guardian_contact" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Contact" />
                </div>
            </div>

            @* Row 2.5: ID Proof & Identification Mark (Single Line) *@
            <div class="um-grid-cols-3">
                <div class="form-group">
                    <label>ID Proof Name</label>
                    <input type="text" class="filter-control" @bind="admitRequest.id_proof_name" @bind:event="oninput" @bind:after="PrintPayload" placeholder="e.g. Aadhar / Passport" />
                </div>
                <div class="form-group">
                    <label>ID Proof No</label>
                    <input type="text" class="filter-control" @bind="admitRequest.id_proof_id" @bind:event="oninput" @bind:after="PrintPayload" placeholder="ID Number" />
                </div>
                <div class="form-group">
                    <label>Identification Mark</label>
                    <input type="text" class="filter-control" @bind="admitRequest.identification_mark" @bind:event="oninput" @bind:after="PrintPayload" placeholder="e.g. Mole on right cheek" />
                </div>
            </div>

            @* Row 3: Billing Room Type, Billing Type & Notes *@
            <div class="um-grid-cols-4">
                <div class="form-group">
                    <label>Billing Room Type</label>
                    <select class="filter-control" @bind="admitRequest.billing_rmtcode" @bind:after="PrintPayload">
                        <option value="">-- Choose Room Type --</option>
                        @foreach (var r in roomTypes.Where(r => !r.deleted))
                        {
                            <option value="@r.rmtcode">@r.name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Billing Type</label>
                    <select class="filter-control" @bind="admitRequest.billing_type" @bind:after="PrintPayload">
                        <option value="">-- Choose Billing Type --</option>
                        <option value="AC">AC</option>
                        <option value="Non-AC">Non-AC</option>
                    </select>
                </div>
                <div class="form-group" style="grid-column: span 2;">
                    <label>Admission Notes</label>
                    <input type="text" class="filter-control" @bind="admitRequest.notes" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Notes" />
                </div>
            </div>

            @* Row 4: Is Insurance Patient *@
            <div class="um-grid-cols-4">
                <div class="form-group" style="flex-direction: row; align-items: center; gap: 8px; margin-top: 10px;">
                    <input type="checkbox" id="isinsurance" @bind="admitRequest.isinsurancepatient" @bind:after="PrintPayload" style="width: 16px; height: 16px; cursor: pointer;" />
                    <label for="isinsurance" style="margin-bottom: 0; cursor: pointer; text-transform: none;">Is Insurance Patient</label>
                </div>
            </div>

            @if (admitRequest.isinsurancepatient)
            {
                @* Row 4: Insurance details (Insurance, Policy No, Auth No, TPA) *@
                <div class="um-grid-cols-4">
                    <div class="form-group">
                        <label>Insurance Company</label>
                        <input type="text" class="filter-control" @bind="admitRequest.insurance_company" @bind:event="oninput" @bind:after="PrintPayload" placeholder="e.g. Star Health" />
                    </div>
                    <div class="form-group">
                        <label>Policy No</label>
                        <input type="text" class="filter-control" @bind="admitRequest.policyno" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Policy No" />
                    </div>
                    <div class="form-group">
                        <label>Authorization No</label>
                        <input type="text" class="filter-control" @bind="admitRequest.authorizationno" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Auth No" />
                    </div>
                    <div class="form-group">
                        <label>TPA Name</label>
                        <input type="text" class="filter-control" @bind="admitRequest.tpa_name" @bind:event="oninput" @bind:after="PrintPayload" placeholder="TPA" />
                    </div>
                </div>
                
                @* Row 5: Approved Amount *@
                <div class="um-grid-cols-4">
                    <div class="form-group">
                        <label>Approved Amount</label>
                        <input type="number" step="any" class="filter-control" @bind="admitRequest.insurance_approved_amount" @bind:event="oninput" @bind:after="PrintPayload" placeholder="0.00" />
                    </div>
                </div>
            }

        </div>
        <div class="modal-footer">
            <button class="btn-modal cancel" @onclick="CloseAdmitModal">Cancel</button>
            <button class="btn-modal confirm" @onclick="ExecuteAdmit">Admit Patient</button>
        </div>
    </div>
}

@* ════════════════════ AC BED BILLING SELECTION MODAL ════════════════════ *@
@if (showAcBillingPromptModal)
{
    <div class="modal-backdrop"></div>
    <div class="glass-modal" style="max-width: 520px; text-align: center; padding: 2rem; border-radius: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.2);">
        <div style="width: 64px; height: 64px; border-radius: 50%; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 1.25rem auto; border: 2px solid #bae6fd;">
            <i class="bi @(showNonAcRoomTypeSelector ? "bi-building-gear" : "bi-snow")"></i>
        </div>

        @if (!showNonAcRoomTypeSelector)
        {
            <h3 style="font-size: 1.3rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem;">AC Bed Allocation</h3>
            <p style="font-size: 0.92rem; color: #475569; margin-bottom: 1.75rem; line-height: 1.55;">
                The allocated bed <strong>@selectedBed?.bedname</strong> belongs to an AC Room type (<strong>@currentAcRoomTypeName</strong>).<br />
                Do you want to continue with AC billing or switch to Non-AC billing?
            </p>

            <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                <button class="btn-modal" style="background: #0284c7; color: #ffffff; padding: 0.65rem 1.25rem; font-size: 0.88rem; font-weight: 700; border-radius: 10px; border: none;" @onclick="() => ProcessAcBillingChoice(false)">
                    <i class="bi bi-check-circle-fill me-1"></i> Continue with AC
                </button>
                <button class="btn-modal" style="background: #f59e0b; color: #ffffff; padding: 0.65rem 1.25rem; font-size: 0.88rem; font-weight: 700; border-radius: 10px; border: none;" @onclick="OpenNonAcTypeSelector">
                    <i class="bi bi-arrow-repeat me-1"></i> Switch to Non-AC
                </button>
                <button class="btn-modal cancel" style="padding: 0.65rem 1rem; font-size: 0.88rem; border-radius: 10px;" @onclick="CancelAcBillingPrompt">
                    Cancel
                </button>
            </div>
        }
        else
        {
            <h3 style="font-size: 1.3rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem;">Select Non-AC Room Type</h3>
            <p style="font-size: 0.88rem; color: #475569; margin-bottom: 1.25rem;">
                Select the Non-AC room type to apply for patient billing:
            </p>

            <div class="form-group" style="text-align: left; margin-bottom: 1.5rem;">
                <label style="font-weight: 700; color: #334155; font-size: 0.85rem; margin-bottom: 0.35rem; display: block;">Non-AC Room Type for Billing <span style="color:#ef4444;">*</span></label>
                <select class="filter-control" style="width: 100%; padding: 0.6rem 0.85rem; font-size: 0.9rem; border-radius: 8px;" @bind="selectedNonAcRmtCode">
                    <option value="0">-- Select Non-AC Room Type --</option>
                    @foreach (var rt in GetNonAcRoomTypes())
                    {
                        <option value="@rt.rmtcode">@rt.name @(!string.IsNullOrWhiteSpace(rt.shortname) ? $"({rt.shortname})" : "")</option>
                    }
                </select>
            </div>

            <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                <button class="btn-modal" style="background: #10b981; color: #ffffff; padding: 0.65rem 1.25rem; font-size: 0.88rem; font-weight: 700; border-radius: 10px; border: none;" @onclick="ConfirmNonAcRoomTypeSelection">
                    <i class="bi bi-check-lg me-1"></i> Confirm & Admit
                </button>
                <button class="btn-modal cancel" style="padding: 0.65rem 1rem; font-size: 0.88rem; border-radius: 10px;" @onclick="() => showNonAcRoomTypeSelector = false">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </button>
            </div>
        }
    </div>
}

@* --- BED DETAILS POPUP MODAL --- *@
@if (selectedBed != null && !showAdmitModal && !showAcBillingPromptModal)
{
    <div class="modal-backdrop" @onclick="CloseDetails"></div>
    <div class="glass-modal" style="max-width: 400px; width: 95%; border-radius: 16px;">
        <div class="modal-header" style="background: #f8fafc; border-radius: 16px 16px 0 0; padding: 0.65rem 1rem;">
            <h3 style="margin: 0; color: #1e293b; font-size: 1rem;">Bed Details: @selectedBed.bedname</h3>
            <button class="close-btn" @onclick="CloseDetails">&times;</button>
        </div>
        <div class="modal-body" style="padding: 1rem;">
            @if (selectedBed.bed_status == "AVAILABLE")
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div style="background: rgba(240, 253, 244, 0.7); border: 1px solid #bbf7d0; border-radius: 12px; padding: 1rem;">
                        <h4 style="margin: 0 0 0.75rem 0; color: #15803d; font-size: 0.95rem; font-weight: 700;">Available Bed</h4>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.85rem; color: #475569;">
                            <div><strong>Bed No:</strong> @selectedBed.bedname</div>
                            <div><strong>Room Type:</strong> @(roomTypes.FirstOrDefault(r => r.rmtcode == selectedBed.rmtcode)?.name ?? selectedBed.rmtcode?.ToString() ?? "-")</div>
                            <div><strong>Ward:</strong> @(wardsList.FirstOrDefault(w => w.wrdcode == selectedBed.wrdcode)?.name ?? selectedBed.wrdcode?.ToString() ?? "-")</div>
                            <div><strong>Floor:</strong> @(floorsList.FirstOrDefault(f => f.flrcode == selectedBed.flrcode)?.name ?? selectedBed.flrcode.ToString())</div>
                        </div>
                    </div>
                    
                    <p style="font-size: 0.85rem; color: #64748b; margin: 0;">Do you want to allocate this bed to the patient?</p>

                    <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 0.5rem;">
                        <button class="btn-modal cancel" style="padding: 0.5rem 1rem; font-size: 0.85rem;" @onclick="CloseDetails">Cancel</button>
                        @if (hasEditRight)
                        {
                            @if (draftAdmission != null)
                            {
                                <button class="btn-modal confirm" style="background-color: #10b981; padding: 0.5rem 1rem; font-size: 0.85rem;" @onclick="ConfirmBedAllocation">
                                    Confirm Bed
                                </button>
                            }
                            else
                            {
                                <button class="btn-modal confirm" style="background-color: #3b82f6; padding: 0.5rem 1rem; font-size: 0.85rem;" @onclick="OpenAdmitModal">
                                    Admit Patient
                                </button>
                            }
                        }
                    </div>
                </div>
            }
            else if (selectedBed.bed_status == "DIRTY")
            {
                <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="font-weight: 600; color: #475569; font-size: 0.8rem; text-transform: uppercase;">Status</label>
                            <select class="filter-control" style="padding: 8px 12px; font-size: 0.8rem;" @bind="cleaningStatusToggle">
                                <option value="DIRTY">Pending Cleaning</option>
                                <option value="CLEANED">Cleaned</option>
                            </select>
                        </div>

                        @if (cleaningStatusToggle == "CLEANED")
                        {
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-weight: 600; color: #475569; font-size: 0.8rem; text-transform: uppercase;">Cleaned By *</label>
                                <input type="text" class="filter-control" style="padding: 8px 12px; font-size: 0.8rem;" @bind="cleanedBy" placeholder="Housekeeping name" />
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-weight: 600; color: #475569; font-size: 0.8rem; text-transform: uppercase;">Notes</label>
                                <input type="text" class="filter-control" style="padding: 8px 12px; font-size: 0.8rem;" @bind="cleaningNotes" placeholder="" />
                            </div>
                        }
                    </div>

                    <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 0.5rem;">
                        <button class="btn-modal cancel" style="padding: 0.5rem 1rem; font-size: 0.8rem;" @onclick="CloseDetails">Cancel</button>
                        @if (hasEditRight)
                        {
                            <button class="btn-modal confirm" style="background-color: @(cleaningStatusToggle == "CLEANED" ? "#10b981" : "#f59e0b"); padding: 0.5rem 1rem; font-size: 0.8rem; border: none; color: #ffffff;" @onclick="MarkBedAsCleaned">
                                <i class="bi bi-stars" style="margin-right: 5px;"></i> Mark as @(cleaningStatusToggle == "CLEANED" ? "Cleaned" : "Under Cleaning")
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    @if (occupiedPatientDetails != null)
                    {
                        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 0.65rem;">
                            <div style="display: grid; grid-template-columns: 1fr; gap: 0.5rem; font-size: 0.76rem; color: #475569;">
                              
                                <div><strong>Patient ID:</strong> <span style="color: #64748b; font-weight: 700;">@(GetDisplayPatientId(occupiedCustomerDetails, occupiedPatientDetails))</span></div>
                                <div><strong>Patient Name:</strong> <span style="color: #4f46e5; font-weight: 700;">@(GetDisplayPatientName(occupiedCustomerDetails, occupiedPatientDetails))</span></div>
                                <div><strong>Contact Number:</strong> <span style="color: #0d9488; font-weight: 700;">@(GetDisplayPatientMobile(occupiedCustomerDetails, occupiedPatientDetails))</span></div>
                                <div><strong>Admission Type:</strong> <span class="badge-type @(occupiedPatientDetails.admission_type == "EMERGENCY" ? "walkin" : "online")" style="padding: 0.1rem 0.4rem; font-size: 0.68rem; display: inline-block;">@occupiedPatientDetails.admission_type</span></div>
                                <div><strong>Admitted On:</strong> <span style="color: #d97706; font-weight: 700;">@occupiedPatientDetails.admitdate.ToString("dd-MM-yyyy hh:mm tt")</span></div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 1.25rem; color: #64748b; font-style: italic; font-size: 0.8rem;">
                            <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                            Loading occupant details...
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private List<BlockMasterModel> blocksList = new();
    private List<FloorMasterModel> floorsList = new();
    private List<WardMasterModel> wardsList = new();
    private List<RoomTypeMasterModel> roomTypes = new();
    
    private List<BedMasterModel> allBeds = new();
    private List<BedMasterModel> availableBeds = new();
    private List<BedMasterModel> filteredAllBeds = new();
    private List<IPRegistrationModel.IpRegistrationModel> activeAdmissions = new();
    private List<SharedComponents.Rcl.Models.CustomerModel> customersList = new();
    private List<DoctorMasterModel> doctorsList = new();
    private List<BedTransferModel> bedTransfers = new();
    private List<medico_backend.Model.BedStatusModel> bedStatuses = new();
    private List<NurseMasterModel> nursesList = new();
    private string cleanedBy = "";
    private string cleaningNotes = "";
    private List<BedMasterModel> pendingCleaningBeds = new();
    private string cleaningStatusToggle = "DIRTY";

    private int selectedBlock = 0;
    private int selectedFloor = 0;
    private int selectedWard = 0;
    private string filterSearch = "";
    
    private bool loading = true;
    private BedMasterModel? selectedBed;

    private IPRegistrationModel.CreateIpRegistrationRequest? draftAdmission;
    private IPRegistrationModel.CreateIpRegistrationRequest admitRequest = new();
    private IPRegistrationModel.IpRegistrationModel? occupiedPatientDetails;
    private SharedComponents.Rcl.Models.CustomerModel? occupiedCustomerDetails;

    private string TenantCode = "";
    private string AuthToken = "";
    private bool showAdmitModal = false;
    private bool showAcBillingPromptModal = false;
    private bool showNonAcRoomTypeSelector = false;
    private int selectedNonAcRmtCode = 0;
    private string pendingAdmissionType = "";
    private string currentAcRoomTypeName = "";
    private bool hasViewRight = true;
    private bool hasEditRight = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDropdownDataAsync();
        await RefreshDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                var draftResult = await _sessionStorage.GetAsync<IPRegistrationModel.CreateIpRegistrationRequest>("DraftAdmission");
                if (draftResult.Success)
                {
                    draftAdmission = draftResult.Value;
                }

                await LoadCustomersAsync();
                await RefreshDataAsync();

                try
                {
                    bool isAdmin = false;
                    try
                    {
                        var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                        if (userResult.Success && userResult.Value != null)
                        {
                            isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                      userResult.Value.UserCode == 0 ||
                                      userResult.Value.UserCode == 1;
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error checking user details: {ex.Message}");
                    }

                    if (isAdmin)
                    {
                        hasViewRight = true;
                        hasEditRight = true;
                    }
                    else
                    {
                        var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                        if (rightsResult.Success && rightsResult.Value != null)
                        {
                            var bedsRight = rightsResult.Value.FirstOrDefault(r => 
                                r.ModuleName != null && 
                                r.ModuleName.Trim().Equals("Available_Beds", StringComparison.OrdinalIgnoreCase));
                            
                            if (bedsRight != null)
                            {
                                hasViewRight = bedsRight.ToView;
                                hasEditRight = bedsRight.ToEdit;
                            }
                            else
                            {
                                hasViewRight = false;
                                hasEditRight = false;
                            }
                        }
                        else
                        {
                            hasViewRight = false;
                            hasEditRight = false;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking Available_Beds rights: {ex.Message}");
                    hasViewRight = false;
                    hasEditRight = false;
                }

                if (!hasViewRight)
                {
                    ToastService.ShowError("You do not have permission to view available beds.");
                    Navigation.NavigateTo("/home");
                    return;
                }

                StateHasChanged();
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error loading session details: {ex.Message}");
            }
        }
    }

    private async Task LoadCustomersAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }

            LabSettingModel? setting = null;
            try { setting = await LabSettingService.GetLabSettingAsync(); } catch { }

            string endpoint = (setting?.show_all_customers ?? true)
                ? "api/Customer/partition?pagenumber=1&pagesize=1000"
                : "api/customer/getcus";

            var response = await client.GetAsync(endpoint);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                customersList = JsonConvert.DeserializeObject<List<SharedComponents.Rcl.Models.CustomerModel>>(json) ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
        }
    }

    private async Task LoadDropdownDataAsync()
    {
        try
        {
            blocksList = await BlockService.GetBlockMastersAsync();
            floorsList = await FloorService.GetFloorMastersAsync();
            wardsList = await WardService.GetWardMastersAsync();
            roomTypes = await RoomTypeService.GetRoomTypeMastersAsync();
            doctorsList = await DoctorService.GetDoctorsAsync();
            nursesList = await NurseService.GetNurseMastersAsync();
            nursesList = nursesList.Where(n => n.deleted != true).ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading master filters: {ex.Message}");
        }
    }

    private async Task RefreshDataAsync()
    {
        loading = true;
        try
        {
            allBeds = await BedService.GetBedMastersAsync();
            
            int? blockParam = selectedBlock > 0 ? selectedBlock : null;
            int? floorParam = selectedFloor > 0 ? selectedFloor : null;
            int? wardParam = selectedWard > 0 ? selectedWard : null;
            
            availableBeds = await BedService.GetAvailableBedsAsync(blockParam, floorParam, wardParam);
            activeAdmissions = await IpService.GetIpRegistrationsAsync("ADMITTED");
            bedTransfers = await BedTransferService.GetBedTransfersAsync();
            bedStatuses = await BedStatusService.GetBedStatusesAsync();
            pendingCleaningBeds = await BedService.GetPendingCleaningBedsAsync();
            
            FilterAllBeds();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading beds data: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void FilterAllBeds()
    {
        var baseList = allBeds.Where(b => 
            (selectedFloor == 0 || b.flrcode == selectedFloor) && 
            (selectedWard == 0 || b.wrdcode == selectedWard)
        )
        .OrderBy(b => b.bedname)
        .ToList();

        var occupiedBedCodes = new HashSet<int>();
        var matchingOccupiedBedCodes = new HashSet<int>();
        bool isSearching = !string.IsNullOrWhiteSpace(filterSearch);
        var searchTrimmed = (filterSearch ?? "").Trim();

        foreach (var a in activeAdmissions)
        {
            var latestTransfer = bedTransfers
                .Where(t => t.lastvisitid == a.ip_id.ToString())
                .OrderByDescending(t => t.transferdate)
                .FirstOrDefault();
            var currentBedCode = latestTransfer != null ? latestTransfer.transbed : a.bedcode;
            if (currentBedCode.HasValue)
            {
                occupiedBedCodes.Add(currentBedCode.Value);

                if (isSearching)
                {
                    var cust = customersList.FirstOrDefault(c => c.custid == a.custid || c.custid.ToString() == a.custid.ToString());
                    bool matchesPatient = 
                        (a.ip_no != null && a.ip_no.Contains(searchTrimmed, StringComparison.OrdinalIgnoreCase)) ||
                        (a.patient_name != null && a.patient_name.Contains(searchTrimmed, StringComparison.OrdinalIgnoreCase)) ||
                        (a.custid.ToString().Contains(searchTrimmed, StringComparison.OrdinalIgnoreCase)) ||
                        (a.mobile != null && a.mobile.Contains(searchTrimmed, StringComparison.OrdinalIgnoreCase)) ||
                        (cust != null && !string.IsNullOrEmpty(cust.name) && cust.name.Contains(searchTrimmed, StringComparison.OrdinalIgnoreCase)) ||
                        (cust != null && !string.IsNullOrEmpty(cust.custcode) && cust.custcode.Contains(searchTrimmed, StringComparison.OrdinalIgnoreCase)) ||
                        (cust != null && !string.IsNullOrEmpty(cust.mobile) && cust.mobile.Contains(searchTrimmed, StringComparison.OrdinalIgnoreCase));

                    if (matchesPatient)
                    {
                        matchingOccupiedBedCodes.Add(currentBedCode.Value);
                    }
                }
            }
        }

        foreach (var bed in baseList)
        {
            var isPC = pendingCleaningBeds.Any(pc => pc.bedcode == bed.bedcode);
            var isOccupied = occupiedBedCodes.Contains(bed.bedcode);
            var av = availableBeds.FirstOrDefault(ab => ab.bedcode == bed.bedcode);

            if (isPC || (!isOccupied && av == null))
            {
                bed.bed_status = "DIRTY";
                bed.is_cleaned = false;
            }
            else if (isOccupied)
            {
                bed.bed_status = "OCCUPIED";
            }
            else if (av != null)
            {
                bed.bed_status = av.bed_status ?? "AVAILABLE";
                bed.is_cleaned = av.is_cleaned;
                bed.admitted_at = av.admitted_at;
                bed.discharged_at = av.discharged_at;
                bed.cleaned_at = av.cleaned_at;
                bed.cleaned_by = av.cleaned_by;
            }
        }

        if (isSearching)
        {
            filteredAllBeds = baseList.Where(bed => 
                matchingOccupiedBedCodes.Contains(bed.bedcode) ||
                (bed.bedname != null && bed.bedname.Contains(searchTrimmed, StringComparison.OrdinalIgnoreCase)) ||
                bed.bedcode.ToString().Contains(searchTrimmed, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
        else
        {
            filteredAllBeds = baseList;
        }

        if (selectedBed != null)
        {
            if (!filteredAllBeds.Any(b => b.bedcode == selectedBed.bedcode))
            {
                selectedBed = null;
                occupiedPatientDetails = null;
                occupiedCustomerDetails = null;
            }
        }
    }

    private async Task OnFiltersChanged()
    {
        await RefreshDataAsync();
    }

    private async Task OnBedClicked(BedMasterModel bed)
    {
        if (selectedBed != null && selectedBed.bedcode == bed.bedcode)
        {
            selectedBed = null;
            occupiedPatientDetails = null;
            occupiedCustomerDetails = null;
        }
        else
        {
            selectedBed = bed;
            cleaningStatusToggle = "DIRTY";
            cleanedBy = "";
            cleaningNotes = "";
            var isAvailable = bed.bed_status == "AVAILABLE";
            if (isAvailable)
            {
                occupiedPatientDetails = null;
                occupiedCustomerDetails = null;
                ToastService.ShowSuccess($"Selected Available Bed: {bed.bedname}");
            }
            else
            {
                // Find patient details for occupied bed
                occupiedPatientDetails = activeAdmissions.FirstOrDefault(a => 
                {
                    var latestTransfer = bedTransfers.Where(t => t.lastvisitid == a.ip_id.ToString()).OrderByDescending(t => t.transferdate).FirstOrDefault();
                    var currentBedCode = latestTransfer != null ? latestTransfer.transbed : a.bedcode;
                    return currentBedCode == bed.bedcode;
                });
                if (occupiedPatientDetails != null)
                {
                    occupiedCustomerDetails = customersList.FirstOrDefault(c => c.custid.ToString() == occupiedPatientDetails.custid.ToString() || c.custid == occupiedPatientDetails.custid);
                    if (occupiedCustomerDetails == null && occupiedPatientDetails.custid > 0)
                    {
                        try
                        {
                            var client = ClientFactory.CreateClient("LabCareUrl");
                            if (!string.IsNullOrEmpty(TenantCode))
                            {
                                client.DefaultRequestHeaders.Remove("tenant_code");
                                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
                            }
                            if (!string.IsNullOrEmpty(AuthToken))
                            {
                                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
                            }
                            var response = await client.GetAsync($"api/Customer/get?custid={occupiedPatientDetails.custid}");
                            if (response.IsSuccessStatusCode)
                            {
                                var json = (await response.Content.ReadAsStringAsync())?.Trim() ?? "";
                                SharedComponents.Rcl.Models.CustomerModel? cust = null;
                                if (json.StartsWith("["))
                                {
                                    var list = JsonConvert.DeserializeObject<List<SharedComponents.Rcl.Models.CustomerModel>>(json);
                                    cust = list?.FirstOrDefault(c => c.custid == occupiedPatientDetails.custid) ?? list?.FirstOrDefault();
                                }
                                else if (json.StartsWith("{"))
                                {
                                    cust = JsonConvert.DeserializeObject<SharedComponents.Rcl.Models.CustomerModel>(json);
                                }

                                if (cust != null && !string.IsNullOrWhiteSpace(cust.name))
                                {
                                    occupiedCustomerDetails = cust;
                                    if (!customersList.Any(c => c.custid == cust.custid))
                                    {
                                        customersList.Add(cust);
                                    }
                                    StateHasChanged();
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"Error fetching customer details on demand: {ex.Message}");
                        }
                    }
                }
                else
                {
                    occupiedCustomerDetails = null;
                }
            }
        }
    }

    private string GetDisplayPatientName(SharedComponents.Rcl.Models.CustomerModel? cust, IPRegistrationModel.IpRegistrationModel? admission)
    {
        if (cust != null && !string.IsNullOrWhiteSpace(cust.name))
            return cust.name;
        if (cust != null && !string.IsNullOrWhiteSpace(cust.namewithinitials))
            return cust.namewithinitials;
        if (admission != null && !string.IsNullOrWhiteSpace(admission.patient_name))
            return admission.patient_name;
        if (admission != null && admission.custid > 0)
            return $"Patient #{admission.custid}";
        return "Unknown Patient";
    }

    private string GetDisplayPatientId(SharedComponents.Rcl.Models.CustomerModel? cust, IPRegistrationModel.IpRegistrationModel? admission)
    {
        if (cust != null && !string.IsNullOrWhiteSpace(cust.custcode))
            return cust.custcode;
        if (admission != null && !string.IsNullOrWhiteSpace(admission.ip_no))
            return admission.ip_no;
        if (admission != null && admission.custid > 0)
            return admission.custid.ToString();
        return "-";
    }

    private string GetDisplayPatientMobile(SharedComponents.Rcl.Models.CustomerModel? cust, IPRegistrationModel.IpRegistrationModel? admission)
    {
        if (cust != null && !string.IsNullOrWhiteSpace(cust.mobile))
            return cust.mobile;
        if (admission != null && !string.IsNullOrWhiteSpace(admission.mobile))
            return admission.mobile;
        if (admission != null && !string.IsNullOrWhiteSpace(admission.guardian_contact))
            return admission.guardian_contact;
        return "N/A";
    }

    private bool IsAcRoomType(RoomTypeMasterModel? roomType)
    {
        if (roomType == null) return false;
        var name = (roomType.name ?? roomType.shortname ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name)) return false;

        bool containsAc = name.Contains("AC", StringComparison.OrdinalIgnoreCase);
        bool containsNonAc = name.Contains("NON AC", StringComparison.OrdinalIgnoreCase) || 
                             name.Contains("NON-AC", StringComparison.OrdinalIgnoreCase) ||
                             name.Contains("NONAC", StringComparison.OrdinalIgnoreCase);

        return containsAc && !containsNonAc;
    }

    private async Task ConfirmBedAllocation()
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to allocate beds.");
            return;
        }
        if (selectedBed == null)
        {
            ToastService.ShowError("Please select a bed.");
            return;
        }
        if (draftAdmission == null)
        {
            ToastService.ShowError("No registration in progress. Please start from the Admissions dashboard.");
            return;
        }

        var roomType = roomTypes.FirstOrDefault(r => r.rmtcode == selectedBed.rmtcode);
        if (IsAcRoomType(roomType))
        {
            pendingAdmissionType = "DRAFT";
            currentAcRoomTypeName = roomType?.name ?? "AC Room";
            showAcBillingPromptModal = true;
            return;
        }

        draftAdmission.billing_type = roomType?.name;
        draftAdmission.billing_rmtcode = selectedBed.rmtcode;
        await SubmitAdmissionAsync(draftAdmission);
    }

    private void OpenAdmitModal()
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to admit patients from here.");
            return;
        }
        if (selectedBed == null) return;
        selectedPatientSearchName = "";
        admitRequest = new IPRegistrationModel.CreateIpRegistrationRequest
        {
            admission_type = "PLANNED",
            admitdate = DateTime.Now,
            branchcode = 101,
            bedcode = selectedBed.bedcode,
            blockcode = floorsList.FirstOrDefault(f => f.flrcode == selectedBed.flrcode)?.blockcode,
            flrcode = selectedBed.flrcode,
            wrdcode = selectedBed.wrdcode,
            rmtcode = selectedBed.rmtcode,
            isinsurancepatient = false
        };
        showAdmitModal = true;
    }

    private void CloseAdmitModal()
    {
        showAdmitModal = false;
    }

    private async Task ExecuteAdmit()
    {
        if (admitRequest.custid <= 0)
        {
            ToastService.ShowError("Please select a patient.");
            return;
        }
        if (admitRequest.dcode <= 0)
        {
            ToastService.ShowError("Please select a doctor.");
            return;
        }
        if (admitRequest.bedcode <= 0)
        {
            ToastService.ShowError("Please allocate a bed.");
            return;
        }

        var roomType = roomTypes.FirstOrDefault(r => r.rmtcode == selectedBed?.rmtcode);
        if (IsAcRoomType(roomType))
        {
            pendingAdmissionType = "DIRECT";
            currentAcRoomTypeName = roomType?.name ?? "AC Room";
            showAcBillingPromptModal = true;
            return;
        }

        admitRequest.billing_type = roomType?.name;
        admitRequest.billing_rmtcode = selectedBed?.rmtcode;
        await SubmitAdmissionAsync(admitRequest);
    }

    private IEnumerable<RoomTypeMasterModel> GetNonAcRoomTypes()
    {
        var list = roomTypes.Where(r => r.deleted != true &&
            ((r.name != null && (r.name.Contains("NON AC", StringComparison.OrdinalIgnoreCase) || r.name.Contains("NON-AC", StringComparison.OrdinalIgnoreCase) || r.name.Contains("NONAC", StringComparison.OrdinalIgnoreCase))) ||
             (r.shortname != null && (r.shortname.Contains("NON AC", StringComparison.OrdinalIgnoreCase) || r.shortname.Contains("NON-AC", StringComparison.OrdinalIgnoreCase) || r.shortname.Contains("NONAC", StringComparison.OrdinalIgnoreCase)))));

        if (!list.Any()) return roomTypes.Where(r => r.deleted != true);
        return list;
    }

    private void OpenNonAcTypeSelector()
    {
        var firstNonAc = GetNonAcRoomTypes().FirstOrDefault();
        selectedNonAcRmtCode = firstNonAc?.rmtcode ?? 0;
        showNonAcRoomTypeSelector = true;
    }

    private async Task ConfirmNonAcRoomTypeSelection()
    {
        if (selectedNonAcRmtCode <= 0)
        {
            ToastService.ShowError("Please select a Non-AC room type.");
            return;
        }

        var chosenRoomType = roomTypes.FirstOrDefault(r => r.rmtcode == selectedNonAcRmtCode);
        if (chosenRoomType == null)
        {
            ToastService.ShowError("Invalid room type selected.");
            return;
        }

        showAcBillingPromptModal = false;
        showNonAcRoomTypeSelector = false;

        var targetReq = pendingAdmissionType == "DRAFT" ? draftAdmission : admitRequest;
        if (targetReq == null) return;

        targetReq.billing_type = chosenRoomType.name;
        targetReq.billing_rmtcode = chosenRoomType.rmtcode;

        ToastService.ShowInfo($"Billing room type set to '{chosenRoomType.name}' (Code: {chosenRoomType.rmtcode}).");
        await SubmitAdmissionAsync(targetReq);
    }

    private async Task ProcessAcBillingChoice(bool switchToNonAc)
    {
        if (switchToNonAc)
        {
            OpenNonAcTypeSelector();
            return;
        }

        showAcBillingPromptModal = false;
        showNonAcRoomTypeSelector = false;
        var targetReq = pendingAdmissionType == "DRAFT" ? draftAdmission : admitRequest;
        if (targetReq == null || selectedBed == null) return;

        var currentRoomType = roomTypes.FirstOrDefault(r => r.rmtcode == selectedBed.rmtcode);
        targetReq.billing_type = currentRoomType?.name ?? "AC";
        targetReq.billing_rmtcode = currentRoomType?.rmtcode ?? selectedBed.rmtcode;

        await SubmitAdmissionAsync(targetReq);
    }

    private void CancelAcBillingPrompt()
    {
        showAcBillingPromptModal = false;
        showNonAcRoomTypeSelector = false;
        pendingAdmissionType = "";
    }

    private async Task SubmitAdmissionAsync(IPRegistrationModel.CreateIpRegistrationRequest req)
    {
        if (selectedBed != null)
        {
            req.bedcode = selectedBed.bedcode;
            req.blockcode = floorsList.FirstOrDefault(f => f.flrcode == selectedBed.flrcode)?.blockcode;
            req.flrcode = selectedBed.flrcode;
            req.wrdcode = selectedBed.wrdcode;
            req.rmtcode = selectedBed.rmtcode;
        }

        try
        {
            var payloadJson = Newtonsoft.Json.JsonConvert.SerializeObject(req, Newtonsoft.Json.Formatting.Indented);
            Console.WriteLine("--- SENDING IP REGISTRATION PAYLOAD TO BACKEND DATABASE ---");
            Console.WriteLine(payloadJson);
            Console.WriteLine("-----------------------------------------------------------");

            bool success = await IpService.AdmitPatientAsync(req);
            if (success)
            {
                ToastService.ShowSuccess("Patient admitted successfully!");
                if (pendingAdmissionType == "DRAFT" || draftAdmission != null)
                {
                    await _sessionStorage.DeleteAsync("DraftAdmission");
                    Navigation.NavigateTo("/booking/ip-registration");
                }
                else
                {
                    showAdmitModal = false;
                    selectedBed = null;
                    await RefreshDataAsync();
                    StateHasChanged();
                }
            }
            else
            {
                ToastService.ShowError("Failed to admit patient.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error admitting patient: {ex.Message}");
        }
    }

    private async Task MarkBedAsCleaned()
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to update cleaning status.");
            return;
        }
        if (selectedBed == null) return;

        if (cleaningStatusToggle == "DIRTY")
        {
            selectedBed = null;
            return;
        }

        if (string.IsNullOrEmpty(cleanedBy))
        {
            ToastService.ShowError("Please mention the member who cleaned the bed.");
            return;
        }
        
        try
        {
            var req = new medico_backend.Model.MarkBedCleanedRequest
            {
                bedcode = selectedBed.bedcode,
                cleaned_by = cleanedBy,
                notes = string.IsNullOrEmpty(cleaningNotes) ? "Sanitized and linen changed" : cleaningNotes
            };

            bool success = await BedStatusService.MarkBedCleanedAsync(req);
            if (success)
            {
                ToastService.ShowSuccess($"{selectedBed.bedname} marked as cleaned and is now available!");
                selectedBed = null;
                await RefreshDataAsync();
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Failed to update bed status on backend.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error marking bed cleaned: {ex.Message}");
        }
    }
    private void PrintPayload()
    {
        try
        {
            var payloadJson = Newtonsoft.Json.JsonConvert.SerializeObject(admitRequest, Newtonsoft.Json.Formatting.Indented);
            Console.WriteLine("--- CreateIpRegistrationRequest Current Payload JSON ---");
            Console.WriteLine(payloadJson);
            Console.WriteLine("---------------------------------------------------------");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error serializing admission payload: {ex.Message}");
        }
    }

    private void CloseDetails()
    {
        selectedBed = null;
        occupiedPatientDetails = null;
        occupiedCustomerDetails = null;
    }

    private string selectedPatientSearchName = "";
    private bool showPatientDropdown = false;
    private int activeDropdownIndex = 0;
    private List<SharedComponents.Rcl.Models.CustomerModel> filteredPatientsForDropdown = new();

    private void OnPatientSearchInput(ChangeEventArgs e)
    {
        selectedPatientSearchName = e.Value?.ToString() ?? "";
        UpdateFilteredPatients();
        showPatientDropdown = true;
        activeDropdownIndex = 0;
    }

    private void UpdateFilteredPatients()
    {
        if (string.IsNullOrWhiteSpace(selectedPatientSearchName))
        {
            filteredPatientsForDropdown = customersList.Take(50).ToList();
        }
        else
        {
            filteredPatientsForDropdown = customersList
                .Where(c => (c.name != null && c.name.Contains(selectedPatientSearchName, StringComparison.OrdinalIgnoreCase)) ||
                            (c.custcode != null && c.custcode.Contains(selectedPatientSearchName, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    private void ShowPatientDropdown()
    {
        UpdateFilteredPatients();
        showPatientDropdown = true;
    }

    private async Task HidePatientDropdownWithDelay()
    {
        await Task.Delay(250);
        showPatientDropdown = false;
    }

    private void SelectPatientFromDropdown(SharedComponents.Rcl.Models.CustomerModel p)
    {
        admitRequest.custid = p.custid;
        selectedPatientSearchName = $"{p.custcode} {p.name}";
        showPatientDropdown = false;
        StateHasChanged();
        PrintPayload();
    }

    private void OnPatientSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown")
        {
            if (filteredPatientsForDropdown.Any())
            {
                activeDropdownIndex = (activeDropdownIndex + 1) % filteredPatientsForDropdown.Count;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            if (filteredPatientsForDropdown.Any())
            {
                activeDropdownIndex = (activeDropdownIndex - 1 + filteredPatientsForDropdown.Count) % filteredPatientsForDropdown.Count;
            }
        }
        else if (e.Key == "Enter")
        {
            if (filteredPatientsForDropdown.Any() && activeDropdownIndex >= 0 && activeDropdownIndex < filteredPatientsForDropdown.Count)
            {
                SelectPatientFromDropdown(filteredPatientsForDropdown[activeDropdownIndex]);
            }
        }
    }
}
