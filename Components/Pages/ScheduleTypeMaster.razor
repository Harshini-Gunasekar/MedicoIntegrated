@page "/schedule-types"
@page "/schedule-type-master"
@rendermode InteractiveServer

@using medico_backend.Model
@using Booking.Services
@using Booking.Helpers
@inject NurseNotesMasterService NotesMasterService
@inject ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">event_available</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Schedule Type Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Clinical Schedule Categories & Types Directory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search types..." @bind="SearchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            <div class="search-controls">
                @if (hasCreateRight)
                {
                    <button class="btn-new-entry" @onclick="NewEntry">+ Add Schedule Type</button>
                }
            </div>
        </div>
    </div>

    @* --- DIRECTORY LIST --- *@
    <div class="directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">TYPE ID</th>
                        <th>TYPE NAME</th>
                        <th style="width: 130px;" class="text-center">STATUS</th>
                        <th style="width: 180px;">CREATED AT</th>
                        <th style="width: 180px;">UPDATED AT</th>
                        <th class="text-center" style="width: 120px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6" class="text-center p-48 text-slate-400">
                                <div class="spinner-border spinner-border-sm text-indigo-600 mb-2"></div>
                                <div>Loading schedule types...</div>
                            </td>
                        </tr>
                    }
                    else if (FilteredList.Any())
                    {
                        @foreach (var item in FilteredList)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"#{item.type_id:00}")</span></td>
                                <td>
                                    <span class="schedule-badge">@item.type_name</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(item.is_active ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger") fw-bold px-2 py-1" style="font-size: 0.72rem;">
                                        @(item.is_active ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-slate-400 font-12">@(FormatDate(item.created_at))</td>
                                <td class="text-slate-400 font-12">@(FormatDate(item.updated_at))</td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px;">
                                        @if (hasEditRight)
                                        {
                                            <button type="button" class="lc-circle-btn-32" @onclick="() => EditEntry(item)" title="Edit">
                                                <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                            </button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button type="button" class="lc-circle-btn-32" @onclick="() => PromptDelete(item.type_id)" title="Delete">
                                                <span class="material-symbols-outlined font-18 text-slate-400">delete</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center p-48 text-slate-400 italic">No schedule types found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- MODAL FORM --- *@
@if (showForm)
{
    <div class="modal-overlay" @onclick="CloseForm">
        <div class="modal-form-card" @onclick:stopPropagation>
            <div class="modal-header-bar">
                <h3>@(isEditMode ? "Edit Schedule Type" : "Add Schedule Type")</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseForm" disabled="@isSaving" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <fieldset disabled="@isSaving" style="border: none; padding: 0; margin: 0; display: contents;">
                    <div class="form-group">
                        <label>Type Name *</label>
                        <input type="text" class="lab-input" @bind="formName" @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await SaveEntry(); })" placeholder="e.g. MEDICINE / DIET / PROCEDURE / INVESTIGATION / OTHER" required />
                        @if (isSubmitted && string.IsNullOrWhiteSpace(formName))
                        {
                            <span class="text-danger" style="font-size: 11px;">Type name is required</span>
                        }
                    </div>

                    @if (isEditMode)
                    {
                        <div class="form-group mt-2">
                            <label class="d-flex align-items-center gap-2" style="cursor: pointer;">
                                <input type="checkbox" @bind="formIsActive" @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await SaveEntry(); })" />
                                <span>Is Active</span>
                            </label>
                        </div>
                    }
                </fieldset>
            </div>
            
            <div class="modal-footer-bar">
                <button type="button" class="btn-secondary-outline" @onclick="CloseForm" disabled="@isSaving">Cancel</button>
                <button type="button" class="btn-save" @onclick="SaveEntry" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle"></i>
                        <span>@(isEditMode ? "Update Type" : "Save Type")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* --- DELETE CONFIRMATION MODAL --- *@
@if (showDeleteConfirm)
{
    <div class="modal-overlay">
        <div class="modal-form-card" style="max-width: 400px; padding: 24px; text-align: center;">
            <div style="margin-bottom: 20px;">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-1 mb-2 d-block"></i>
                <p style="margin: 0; font-size: 15px; font-weight: 700; color: #1e293b;">Are you sure you want to deactivate this schedule type?</p>
            </div>
            <div style="display: flex; justify-content: center; gap: 12px; width: 100%;">
                <button type="button" class="btn-secondary-outline" @onclick="CancelDelete" style="flex: 1;">Cancel</button>
                <button type="button" class="btn-danger-filled" @onclick="ExecuteDelete" style="flex: 1;">Deactivate</button>
            </div>
        </div>
    </div>
}

@code {
    private List<ScheduleTypeMasterModel> typesList = new();
    private bool isLoading = true;
    private string SearchQuery = "";
    private bool showForm = false;
    private bool isEditMode = false;
    private bool isSubmitted = false;
    private bool isSaving = false;
    private int selectedId = 0;
    private string formName = "";
    private bool formIsActive = true;

    private bool showDeleteConfirm = false;
    private int deleteTargetId = 0;

    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadRights();
        await LoadData();
    }

    private async Task LoadRights()
    {
        try
        {
            var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (userResult.Success && userResult.Value != null)
            {
                bool isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                               userResult.Value.UserCode == 0 ||
                               userResult.Value.UserCode == 1;
                if (isAdmin)
                {
                    hasCreateRight = true;
                    hasEditRight = true;
                    hasDeleteRight = true;
                    return;
                }
            }
        }
        catch { }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            typesList = await NotesMasterService.GetScheduleTypesAsync(activeOnly: true);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading schedule types: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<ScheduleTypeMasterModel> FilteredList =>
        typesList.Where(t => string.IsNullOrWhiteSpace(SearchQuery) ||
                             t.type_name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                             t.type_id.ToString().Contains(SearchQuery));

    private void NewEntry()
    {
        selectedId = 0;
        formName = "";
        formIsActive = true;
        isEditMode = false;
        isSubmitted = false;
        showForm = true;
    }

    private void EditEntry(ScheduleTypeMasterModel item)
    {
        selectedId = item.type_id;
        formName = item.type_name;
        formIsActive = item.is_active;
        isEditMode = true;
        isSubmitted = false;
        showForm = true;
    }

    private async Task SaveEntry()
    {
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(formName)) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            bool success;
            if (isEditMode)
            {
                success = await NotesMasterService.UpdateScheduleTypeAsync(new UpdateScheduleTypeRequest
                {
                    type_id = selectedId,
                    type_name = formName.Trim().ToUpper(),
                    is_active = formIsActive
                });
            }
            else
            {
                success = await NotesMasterService.AddScheduleTypeAsync(new AddScheduleTypeRequest
                {
                    type_name = formName.Trim().ToUpper()
                });
            }

            if (success)
            {
                ToastService.ShowSuccess(isEditMode ? "Schedule type updated successfully!" : "Schedule type added successfully!");
                showForm = false;
                await LoadData();
            }
            else
            {
                ToastService.ShowError("Failed to save schedule type.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void CloseForm()
    {
        if (isSaving) return;
        showForm = false;
    }

    private void PromptDelete(int id)
    {
        deleteTargetId = id;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        deleteTargetId = 0;
    }

    private async Task ExecuteDelete()
    {
        try
        {
            var success = await NotesMasterService.DeleteScheduleTypeAsync(deleteTargetId);
            if (success)
            {
                ToastService.ShowSuccess("Schedule type deactivated successfully.");
                showDeleteConfirm = false;
                await LoadData();
            }
            else
            {
                ToastService.ShowError("Failed to delete schedule type.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private string FormatDate(DateTime? dt)
    {
        if (dt == null || dt == DateTime.MinValue) return "-";
        return dt.Value.ToString("dd-MM-yyyy hh:mm tt");
    }
}
