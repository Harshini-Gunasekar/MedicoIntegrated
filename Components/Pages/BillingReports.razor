    private async Task<string> FetchReportBase64(string reportKey)
    {
        var urls = BuildReportUrls(reportKey);
        var client = CreateClient();
        string lastError = "";

        foreach (var url in urls)
        {
            try
            {
                var req = new HttpRequestMessage(HttpMethod.Get, url);
                var effectiveToken = !string.IsNullOrEmpty(AuthToken) ? AuthToken : TenantState?.AuthToken;
                if (!string.IsNullOrEmpty(effectiveToken))
                {
                    req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
                }
                req.Headers.Add("tenantcode", DefaultTenant);
                req.Headers.Add("tenant_code", DefaultTenant);
                req.Headers.Add("tenant-code", DefaultTenant);

                var response = await client.SendAsync(req);
                if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
                {
                    var contentStr = await response.Content.ReadAsStringAsync();
                    contentStr = contentStr.Trim('"').Trim();

                    string base64Data = contentStr;
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(contentStr);
                        var root = doc.RootElement;
                        if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {
                            if (root.TryGetProperty("data", out var dProp)) base64Data = dProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("base64", out var bProp)) base64Data = bProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("file", out var fProp)) base64Data = fProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("report", out var rProp)) base64Data = rProp.GetString() ?? contentStr;
                        }
                        else if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                        {
                            base64Data = root.GetString() ?? contentStr;
                        }
                    }
                    catch { }

                    if (!string.IsNullOrWhiteSpace(base64Data) && base64Data.Length >= 50)
                    {
                        return base64Data;
                    }
                }
                else
                {
                    var errContent = await response.Content.ReadAsStringAsync();
                    lastError = $"HTTP {(int)response.StatusCode} ({response.ReasonPhrase}): {errContent}";
                }
            }
            catch (Exception ex)
            {
                lastError = ex.Message;
            }
        }

        throw new Exception(string.IsNullOrEmpty(lastError) ? "Backend report service returned empty data." : lastError);
    }

    private async Task GeneratePayModeCollectionReport()
    {
        int effectiveBhCode = selectedBranchCode;
        if (effectiveBhCode == 0 && !IsAdmin())
        {
            var allowed = GetAuthorizedBranchCodes();
            if (allowed.Count == 1)
            {
                effectiveBhCode = allowed[0];
            }
        }

        int? effBh = effectiveBhCode > 0 ? effectiveBhCode : null;
        int? effCnt = selectedCounterCode > 0 ? selectedCounterCode : null;

        var reportData = await HmsBillingService.GetPayModeCollectionReportAsync(
            selectedFromDate,
            selectedToDate,
            effBh,
            effCnt,
            DefaultTenant,
            AuthToken);

        if (reportData == null)
        {
            throw new Exception("Unable to retrieve paymode collection data from server.");
        }

        currentLoadedHtml = BuildPayModeCollectionHtml(reportData, effBh, effCnt);

        // Try converting to PDF Base64
        try
        {
            currentLoadedBase64 = await JS.InvokeAsync<string>("convertHtmlToPdfBase64", currentLoadedHtml, "Pay_Mode_Collection");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BillingReports] convertHtmlToPdfBase64 notice: {ex.Message}");
            currentLoadedBase64 = "";
        }

        hasLoadedReport = true;
        StateHasChanged();
        await Task.Delay(50);

        if (!string.IsNullOrWhiteSpace(currentLoadedBase64))
        {
            await JS.InvokeVoidAsync("setIframePdfBase64", "billingReportModalFrame", currentLoadedBase64);
        }
        else
        {
            await JS.InvokeVoidAsync("setIframeHtml", "billingReportModalFrame", currentLoadedHtml);
        }
    }

    private string BuildPayModeCollectionHtml(HmsPayModeCollectionResponse data, int? requestedBh, int? requestedCnt)
    {
        string hospitalName = !string.IsNullOrWhiteSpace(TenantState?.TenantName) ? TenantState.TenantName : "MEDICO HEALTHCARE HOSPITAL";
        string branchDisplay = "All Branches";
        int effBh = data.bhcode ?? requestedBh ?? selectedBranchCode;
        if (effBh > 0)
        {
            var foundBranch = branches.FirstOrDefault(b => b.bh_code == effBh);
            branchDisplay = foundBranch != null ? foundBranch.name : $"Branch #{effBh}";
        }

        string counterDisplay = "All Counters";
        int effCnt = data.cntcode ?? requestedCnt ?? selectedCounterCode;
        if (effCnt > 0)
        {
            var foundCounter = counters.FirstOrDefault(c => (int)c.cntcode == effCnt);
            counterDisplay = foundCounter != null && !string.IsNullOrWhiteSpace(foundCounter.name) ? foundCounter.name : $"Counter #{effCnt}";
        }

        string fromStr = data.fromdate.ToString("dd-MMM-yyyy");
        string toStr = data.todate.ToString("dd-MMM-yyyy");
        string printTime = DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt");
        string userName = !string.IsNullOrWhiteSpace(TenantState?.UserData?.UserName) ? TenantState.UserData.UserName : "Administrator";

        int totalBills = data.items?.Sum(i => i.bill_count) ?? 0;
        int totalReceipts = data.total_receipts > 0 ? data.total_receipts : (data.items?.Sum(i => i.receipt_count) ?? 0);
        double grandTotal = data.grand_total > 0 ? data.grand_total : (data.items?.Sum(i => i.total_collected) ?? 0);

        var rowsHtml = new System.Text.StringBuilder();
        if (data.items != null && data.items.Any())
        {
            int sNo = 1;
            foreach (var item in data.items)
            {
                string pName = !string.IsNullOrWhiteSpace(item.paymode_name) ? item.paymode_name : "Cash";
                string badgeClass = pName.ToLower() switch
                {
                    var p when p.Contains("cash") => "cash",
                    var p when p.Contains("card") => "card",
                    var p when p.Contains("upi") || p.Contains("gpay") => "upi",
                    var p when p.Contains("advance") || p.Contains("advan") => "advance",
                    _ => "default"
                };

                double sharePct = item.percentage;
                if (sharePct <= 0 && grandTotal > 0)
                {
                    sharePct = Math.Round((item.total_collected / grandTotal) * 100, 2);
                }

                rowsHtml.Append($@"
                    <tr>
                        <td style=""text-align: center; font-weight: 600;"">{sNo++}</td>
                        <td><span class=""mode-badge {badgeClass}"">{System.Web.HttpUtility.HtmlEncode(pName)}</span></td>
