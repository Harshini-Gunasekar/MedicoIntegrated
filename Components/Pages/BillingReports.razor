.btn-report-show {
    height: 38px;
    padding: 0 22px;
    background: #4f46e5;
    color: #ffffff;
    border: 1px solid #4f46e5;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(79, 70, 229, 0.2);
}

.btn-report-show:hover:not(:disabled) {
    background: #4338ca;
    border-color: #4338ca;
    transform: translateY(-1px);
}

.btn-report-print {
    height: 38px;
    padding: 0 20px;
    background: #ffffff;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.btn-report-print:hover:not(:disabled) {
    background: #f8fafc;
    border-color: #94a3b8;
    transform: translateY(-1px);
}

.btn-report-popup {
    height: 38px;
    padding: 0 16px;
    background: #f8fafc;
    color: #4f46e5;
    border: 1px solid #c7d2fe;
