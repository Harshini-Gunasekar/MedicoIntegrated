.preview-modal-container {
    background: #ffffff;
    border-radius: 16px;
    width: 96vw;
    max-width: 1250px;
    height: 92vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    border: 1px solid #cbd5e1;
    animation: modalScaleIn 0.2s ease-out;
