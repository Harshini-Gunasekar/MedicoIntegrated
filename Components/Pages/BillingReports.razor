@code {
    private string DefaultTenant = "0010";
    private string AuthToken = "";
    private string selectedReportKey = "";
    private bool showPreviewModal = false;
    private string currentLoadedBase64 = "";
    private bool isGeneratingReport = false;
    private bool hasLoadedReport = false;
    private string errorMessage = "";

    private int selectedBranchCode = 0;
    private int selectedCounterCode = 0;
    private DateTime selectedFromDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime selectedToDate = DateTime.Now;

    private List<Booking.Models.BranchModel> branches = new();
    private List<Medico_Backend.Model.CounterMasterModel> counters = new();
    private string currentLoadedHtml = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSessionAndTenant();
        await LoadBranches();
        await LoadCounters();
    }

    private async Task LoadSessionAndTenant()
    {
        try
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success && !string.IsNullOrEmpty(tenantCodeResult.Value) ? tenantCodeResult.Value : (TenantState?.TenantCode ?? "0010");

            var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
            if (!tokenResult.Success || string.IsNullOrEmpty(tokenResult.Value))
            {
                tokenResult = await _sessionStorage.GetAsync<string>("auth_token");
            }
            AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : (TenantState?.AuthToken ?? "");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BillingReports] Session init error: {ex.Message}");
        }
    }

    private async Task LoadBranches()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }

            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                branches = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branches = branches.Where(b => !b.deleted).ToList();

                if (!IsAdmin())
                {
                    var allowed = GetAuthorizedBranchCodes();
                    if (allowed.Any())
                    {
                        branches = branches.Where(b => allowed.Contains(b.bh_code)).ToList();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BillingReports] Load branches error: {ex.Message}");
        }
    }

    private bool IsAdmin()
    {
        var role = TenantState.UserData?.Role;
        return TenantState.UserCode == 1 ||
               string.Equals(role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(role, "Owner", StringComparison.OrdinalIgnoreCase);
    }

    private List<int> GetAuthorizedBranchCodes()
    {
        if (TenantState.UserData?.Branches != null && TenantState.UserData.Branches.Any())
        {
            return TenantState.UserData.Branches
                .Select(b => b.bh_code != 0 ? b.bh_code : (b.bhcode ?? 0))
                .Where(c => c > 0 && c != 21)
                .Distinct()
                .ToList();
        }
        return new List<int>();
    }

    private async Task LoadCounters()
    {
        try
        {
            var result = await CounterMasterService.GetCountersAsync();
            counters = (result ?? new List<Medico_Backend.Model.CounterMasterModel>())
                .Where(c => !c.deleted)
                .ToList();

            var cntResult = await _sessionStorage.GetAsync<string>("cntcode");
            if (cntResult.Success && int.TryParse(cntResult.Value, out var cCode) && cCode > 0)
            {
                if (counters.Any(c => (int)c.cntcode == cCode))
                {
                    selectedCounterCode = cCode;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BillingReports] Load counters error: {ex.Message}");
        }
    }

    private IEnumerable<Medico_Backend.Model.CounterMasterModel> FilteredCounters
    {
        get
        {
            if (counters == null || !counters.Any()) return Enumerable.Empty<Medico_Backend.Model.CounterMasterModel>();
            if (selectedBranchCode > 0)
            {
                var branchFiltered = counters.Where(c => c.bhcode == selectedBranchCode).ToList();
                if (branchFiltered.Any()) return branchFiltered;
            }
            return counters;
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("Medico");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Remove("tenant-code");
        if (!string.IsNullOrEmpty(DefaultTenant))
        {
            client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant-code", DefaultTenant);
        }
        var effectiveToken = !string.IsNullOrEmpty(AuthToken) ? AuthToken : TenantState?.AuthToken;
        if (!string.IsNullOrEmpty(effectiveToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
        }
        return client;
    }

    private async Task OpenReportPreview(string reportKey)
    {
        selectedReportKey = reportKey;
        showPreviewModal = true;
        isGeneratingReport = true;
        hasLoadedReport = false;
        errorMessage = "";
        currentLoadedBase64 = "";
        currentLoadedHtml = "";
        StateHasChanged();

        string title = GetReportDisplayName(reportKey);

        try
        {
            if (reportKey == "PAYMODE_COLLECTION")
            {
                await GeneratePayModeCollectionReport();
                return;
            }

            try
            {
                currentLoadedBase64 = await FetchReportBase64(reportKey);
            }
            catch (Exception) when (reportKey == "PAYMODE_SUMMARY")
            {
                // Fallback for Pay Mode Summary to the paymode collection endpoint
                await GeneratePayModeCollectionReport();
                return;
            }

            if (!string.IsNullOrWhiteSpace(currentLoadedBase64))
            {
                hasLoadedReport = true;
                StateHasChanged();
                await Task.Delay(50);
                await JS.InvokeVoidAsync("setIframePdfBase64", "billingReportModalFrame", currentLoadedBase64);
            }
            else
            {
                errorMessage = $"Backend returned empty report data for {title}.";
                ToastService.ShowError(errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            ToastService.ShowError($"Error generating {title}: {ex.Message}");
        }
        finally
        {
            isGeneratingReport = false;
            StateHasChanged();
        }
    }

    private void ClosePreviewModal()
    {
        showPreviewModal = false;
        isGeneratingReport = false;
        hasLoadedReport = false;
        currentLoadedBase64 = "";
        currentLoadedHtml = "";
        errorMessage = "";
        StateHasChanged();
    }

    private async Task DownloadCurrentReport()
    {
        string cleanTitle = GetReportDisplayName(selectedReportKey).Replace(" ", "_");
        string fileName = $"{cleanTitle}_{selectedFromDate:ddMMyyyy}_{selectedToDate:ddMMyyyy}.pdf";

        if (!string.IsNullOrWhiteSpace(currentLoadedBase64))
        {
            await JS.InvokeVoidAsync("downloadPdfFile", currentLoadedBase64, fileName);
            ToastService.ShowSuccess($"Downloading {GetReportDisplayName(selectedReportKey)}...");
        }
        else if (!string.IsNullOrWhiteSpace(currentLoadedHtml))
        {
            var pdfBase64 = await JS.InvokeAsync<string>("convertHtmlToPdfBase64", currentLoadedHtml, cleanTitle);
            if (!string.IsNullOrWhiteSpace(pdfBase64))
            {
                currentLoadedBase64 = pdfBase64;
                await JS.InvokeVoidAsync("downloadPdfFile", currentLoadedBase64, fileName);
                ToastService.ShowSuccess($"Downloading {GetReportDisplayName(selectedReportKey)}...");
            }
            else
            {
                await JS.InvokeVoidAsync("printIframePdf", "billingReportModalFrame", "");
            }
        }
    }

    private async Task PrintCurrentReport()
    {
        if (!string.IsNullOrWhiteSpace(currentLoadedBase64) || !string.IsNullOrWhiteSpace(currentLoadedHtml))
        {
            await JS.InvokeVoidAsync("printIframePdf", "billingReportModalFrame", currentLoadedBase64 ?? "");
            ToastService.ShowSuccess($"{GetReportDisplayName(selectedReportKey)} sent to printer.");
        }
    }

