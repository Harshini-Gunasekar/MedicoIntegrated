            border: 1px solid #0f172a;
        }}
        table.collection-table td {{
            padding: 9px 12px;
            border: 1px solid #e2e8f0;
            color: #1e293b;
        }}
        table.collection-table tbody tr:nth-child(even) {{
            background: #f8fafc;
        }}
        .mode-badge {{
            display: inline-block;
            padding: 3px 9px;
            border-radius: 5px;
            font-weight: 750;
            font-size: 11.5px;
            background: #e0f2fe;
            color: #0369a1;
            border: 1px solid #bae6fd;
        }}
        .mode-badge.cash {{ background: #dcfce7; color: #15803d; border-color: #bbf7d0; }}
        .mode-badge.card {{ background: #ede9fe; color: #6d28d9; border-color: #ddd6fe; }}
        .mode-badge.upi {{ background: #ffedd5; color: #c2410c; border-color: #fed7aa; }}
        .mode-badge.advance {{ background: #fef3c7; color: #b45309; border-color: #fde68a; }}
        .share-wrap {{
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
        }}
        .share-bar-bg {{
            width: 50px;
            height: 6px;
            background: #e2e8f0;
            border-radius: 3px;
            overflow: hidden;
            display: inline-block;
        }}
        .share-bar-fill {{
            height: 100%;
            background: #2563eb;
            border-radius: 3px;
        }}
        table.collection-table tfoot tr {{
            background: #f1f5f9;
            font-weight: 850;
            border-top: 2.5px solid #0f172a;
            border-bottom: 2.5px solid #0f172a;
        }}
        table.collection-table tfoot td {{
            padding: 10px 12px;
            color: #0f172a;
            font-size: 13px;
            border: 1px solid #cbd5e1;
        }}
        .signatures-grid {{
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-top: 36px;
            padding-top: 10px;
        }}
        .sig-box {{
            text-align: center;
        }}
        .sig-line {{
            border-top: 1px dashed #94a3b8;
            margin-bottom: 6px;
        }}
        .sig-title {{
            font-size: 10.5px;
            font-weight: 750;
            color: #475569;
            text-transform: uppercase;
        }}
        .sig-sub {{
            font-size: 9.5px;
            color: #94a3b8;
        }}
        .system-footer {{
            margin-top: 22px;
            border-top: 1px solid #e2e8f0;
            padding-top: 8px;
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            color: #94a3b8;
        }}
        @media print {{
            body {{ padding: 0; }}
            .no-print {{ display: none !important; }}
            table.collection-table th {{ background: #0f172a !important; color: #fff !important; -webkit-print-color-adjust: exact; }}
            .kpi-card.highlight {{ background: #f0fdf4 !important; -webkit-print-color-adjust: exact; }}
            .mode-badge {{ -webkit-print-color-adjust: exact; }}
        }}
    </style>
</head>
<body>
    <div class=""report-page"">
        <div class=""report-header"">
            <div class=""hospital-brand"">
                <div class=""hospital-icon"">✚</div>
                <div>
                    <h1 class=""hospital-title"">{System.Web.HttpUtility.HtmlEncode(hospitalName)}</h1>
                    <div class=""hospital-subtitle"">Official Billing &amp; Financial Management</div>
                </div>
            </div>
            <div class=""report-title-badge"">
                <h2 class=""report-main-title"">Pay Mode Collection</h2>
                <div class=""report-sub-title"">Summary Report</div>
            </div>
        </div>

        <div class=""meta-strip"">
            <div class=""meta-item"">
                <span class=""meta-lbl"">From Date</span>
                <span class=""meta-val"">{fromStr}</span>
            </div>
            <div class=""meta-item"">
                <span class=""meta-lbl"">To Date</span>
                <span class=""meta-val"">{toStr}</span>
            </div>
            <div class=""meta-item"">
                <span class=""meta-lbl"">Branch</span>
                <span class=""meta-val"">{System.Web.HttpUtility.HtmlEncode(branchDisplay)}</span>
            </div>
            <div class=""meta-item"">
                <span class=""meta-lbl"">Cash Counter</span>
                <span class=""meta-val"">{System.Web.HttpUtility.HtmlEncode(counterDisplay)}</span>
            </div>
        </div>

        <div class=""kpi-row"">
            <div class=""kpi-card highlight"">
                <div class=""kpi-lbl"">Grand Total Collected</div>
                <div class=""kpi-val"">₹{grandTotal:N2}</div>
            </div>
            <div class=""kpi-card purple"">
                <div class=""kpi-lbl"">Total Receipts</div>
                <div class=""kpi-val"">{totalReceipts}</div>
            </div>
            <div class=""kpi-card amber"">
                <div class=""kpi-lbl"">Total Bills Settled</div>
                <div class=""kpi-val"">{totalBills}</div>
            </div>
            <div class=""kpi-card"">
                <div class=""kpi-lbl"">Payment Modes</div>
                <div class=""kpi-val"">{data.items?.Count ?? 0}</div>
            </div>
        </div>

        <table class=""collection-table"">
            <thead>
                <tr>
                    <th style=""width: 45px; text-align: center;"">#</th>
                    <th>Payment Mode</th>
                    <th style=""width: 110px; text-align: right;"">Receipts</th>
                    <th style=""width: 100px; text-align: right;"">Bills</th>
                    <th style=""width: 170px; text-align: right;"">Amount Collected (₹)</th>
                    <th style=""width: 130px; text-align: right;"">Share (%)</th>
                </tr>
            </thead>
            <tbody>
                {rowsHtml}
            </tbody>
            <tfoot>
                <tr>
                    <td colspan=""2"" style=""text-align: right; text-transform: uppercase;"">GRAND TOTAL:</td>
                    <td style=""text-align: right;"">{totalReceipts}</td>
                    <td style=""text-align: right;"">{totalBills}</td>
                    <td style=""text-align: right; font-size: 14px; color: #15803d;"">₹{grandTotal:N2}</td>
                    <td style=""text-align: right;"">100.00%</td>
                </tr>
            </tfoot>
        </table>

        <div class=""signatures-grid"">
            <div class=""sig-box"">
                <div class=""sig-line""></div>
                <div class=""sig-title"">Prepared By</div>
                <div class=""sig-sub"">{System.Web.HttpUtility.HtmlEncode(userName)}</div>
            </div>
            <div class=""sig-box"">
                <div class=""sig-line""></div>
                <div class=""sig-title"">Verified By</div>
                <div class=""sig-sub"">Supervisor</div>
            </div>
            <div class=""sig-box"">
                <div class=""sig-line""></div>
                <div class=""sig-title"">Cashier / Counter</div>
                <div class=""sig-sub"">In-charge</div>
            </div>
            <div class=""sig-box"">
                <div class=""sig-line""></div>
                <div class=""sig-title"">Accounts Officer</div>
                <div class=""sig-sub"">Authorized Signatory</div>
            </div>
        </div>

        <div class=""system-footer"">
            <span>Official Report &bull; Medico Hospital Billing System</span>
            <span>Generated on {printTime}</span>
        </div>
    </div>
</body>
</html>";
    }
}
