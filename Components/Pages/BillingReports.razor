    private async Task<string> FetchReportBase64(string reportKey)
    {
        var urls = BuildReportUrls(reportKey);
        var client = CreateClient();
        string lastError = "";

        foreach (var url in urls)
        {
            try
            {
                var req = new HttpRequestMessage(HttpMethod.Get, url);
                var effectiveToken = !string.IsNullOrEmpty(AuthToken) ? AuthToken : TenantState?.AuthToken;
                if (!string.IsNullOrEmpty(effectiveToken))
                {
                    req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
                }
                req.Headers.Add("tenantcode", DefaultTenant);
                req.Headers.Add("tenant_code", DefaultTenant);
                req.Headers.Add("tenant-code", DefaultTenant);

                var response = await client.SendAsync(req);
                if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
                {
                    var contentStr = await response.Content.ReadAsStringAsync();
                    contentStr = contentStr.Trim('"').Trim();

                    string base64Data = contentStr;
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(contentStr);
                        var root = doc.RootElement;
                        if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {
                            if (root.TryGetProperty("data", out var dProp)) base64Data = dProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("base64", out var bProp)) base64Data = bProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("file", out var fProp)) base64Data = fProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("report", out var rProp)) base64Data = rProp.GetString() ?? contentStr;
                        }
                        else if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                        {
                            base64Data = root.GetString() ?? contentStr;
                        }
                    }
                    catch { }

                    if (!string.IsNullOrWhiteSpace(base64Data) && base64Data.Length >= 50)
                    {
                        return base64Data;
                    }
                }
                else
                {
                    var errContent = await response.Content.ReadAsStringAsync();
                    lastError = $"HTTP {(int)response.StatusCode} ({response.ReasonPhrase}): {errContent}";
                }
            }
            catch (Exception ex)
            {
                lastError = ex.Message;
            }
        }

        throw new Exception(string.IsNullOrEmpty(lastError) ? "Backend report service returned empty data." : lastError);
    }

    private async Task LoadReportPreview()
    {
        if (string.IsNullOrEmpty(selectedReportKey)) return;

        isGeneratingReport = true;
        hasLoadedReport = false;
        StateHasChanged();

        string title = GetReportDisplayName(selectedReportKey);

        try
        {
            currentLoadedBase64 = await FetchReportBase64(selectedReportKey);

            if (!string.IsNullOrWhiteSpace(currentLoadedBase64))
            {
                hasLoadedReport = true;
                StateHasChanged();
                await Task.Delay(50);
                await JS.InvokeVoidAsync("setIframePdfBase64", "billingReportFrame", currentLoadedBase64);
            }
            else
            {
                ToastService.ShowError($"Unable to load {title}: Empty report data.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error generating {title}: {ex.Message}");
        }
        finally
        {
            isGeneratingReport = false;
            StateHasChanged();
        }
    }

    private async Task OpenInteractiveModal()
    {
        if (string.IsNullOrEmpty(selectedReportKey)) return;

        isGeneratingReport = true;
        StateHasChanged();

        string title = GetReportDisplayName(selectedReportKey);

        try
        {
            if (string.IsNullOrWhiteSpace(currentLoadedBase64))
            {
                currentLoadedBase64 = await FetchReportBase64(selectedReportKey);
            }

            if (!string.IsNullOrWhiteSpace(currentLoadedBase64))
            {
                hasLoadedReport = true;
                await JS.InvokeVoidAsync("openPdfPreviewModal", currentLoadedBase64, $"{title} ({selectedFromDate:dd-MMM} to {selectedToDate:dd-MMM-yyyy})");
            }
            else
            {
                ToastService.ShowError($"Unable to load {title}: Empty report data.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error generating {title}: {ex.Message}");
        }
        finally
        {
            isGeneratingReport = false;
            StateHasChanged();
        }
    }

    private async Task PrintCurrentReport()
    {
        if (string.IsNullOrWhiteSpace(currentLoadedBase64))
        {
            await LoadReportPreview();
        }

        if (!string.IsNullOrWhiteSpace(currentLoadedBase64))
        {
            await JS.InvokeVoidAsync("openBase64Pdf", currentLoadedBase64, GetReportDisplayName(selectedReportKey));
            ToastService.ShowSuccess($"{GetReportDisplayName(selectedReportKey)} sent to printer.");
        }
    }
