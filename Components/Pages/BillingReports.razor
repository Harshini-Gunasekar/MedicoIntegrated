.btn-print-report {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0.48rem 1.35rem;
    border-radius: 8px;
    border: 1.5px solid #4f46e5;
    background: #4f46e5;
    color: #ffffff;
