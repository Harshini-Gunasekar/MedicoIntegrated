.preview-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.75rem;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}

.preview-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
}

.preview-header-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #eef2ff;
    color: #4f46e5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    border: 1px solid rgba(79, 70, 229, 0.15);
}

.preview-header-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
    line-height: 1.2;
}

.preview-header-subtitle {
    font-size: 0.78rem;
    color: #64748b;
