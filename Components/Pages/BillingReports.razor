@page "/billing-reports"
@page "/billingreports"
@page "/billing/reports"
@page "/reports"
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using Booking.Models
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<PageTitle>@(string.IsNullOrEmpty(selectedReportKey) ? "Billing Reports" : GetReportDisplayName(selectedReportKey))</PageTitle>

<div class="items-page billing-reports-page pt-3 pb-3">
    <div class="items-shell px-3">
        <div class="items-content">
            <!-- Premium Header Card -->
            <div class="premium-header-card mb-4">
                <div class="header-card-left">
                    @if (!string.IsNullOrEmpty(selectedReportKey))
                    {
                        <button type="button" class="btn-back-circle me-1" @onclick="CloseReportDetail" title="Back to Reports List">
                            <i class="bi bi-arrow-left"></i>
                        </button>
                    }
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                            <polyline points="10 9 9 9 8 9" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">@(string.IsNullOrEmpty(selectedReportKey) ? "Billing Reports" : GetReportDisplayName(selectedReportKey))</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Official financial statements, summaries & billing reports
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    @if (!string.IsNullOrEmpty(selectedReportKey))
                    {
                        <button type="button" class="btn-close-modal" @onclick="CloseReportDetail" title="Back to Reports">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
            </div>

            @if (string.IsNullOrEmpty(selectedReportKey))
            {
                <!-- ========================================== -->
                <!-- VIEW 1: MASTER REPORTS LIST (TEXT LINKS) -->
                <!-- ========================================== -->
                <div class="reports-list-card">
                    <div class="report-links-panel">
                        <div class="report-links-grid">
                            <!-- Column 1 (Items 1 - 7) -->
                            <div class="report-column">
                                <div class="report-link-item" @onclick='() => OpenReportDateModal("STATEMENT")'>
                                    <span class="report-index">1.</span>
                                    <span class="report-link-text">Statement</span>
                                </div>

                                <div class="report-link-item" @onclick='() => OpenReportDateModal("DUE_STATEMENT")'>
                                    <span class="report-index">2.</span>
                                    <span class="report-link-text">Due Statement</span>
                                </div>

                                <div class="report-link-item" @onclick='() => OpenReportDateModal("DISCOUNT_STATEMENT")'>
                                    <span class="report-index">3.</span>
                                    <span class="report-link-text">Discount Statement</span>
                                </div>

                                <div class="report-link-item" @onclick='() => OpenReportDateModal("REFERRAL_STATEMENT")'>
                                    <span class="report-index">4.</span>
                                    <span class="report-link-text">Referral Statement</span>
                                </div>

                                <div class="report-link-item" @onclick='() => OpenReportDateModal("DISCOUNT_SUMMARY")'>
                                    <span class="report-index">5.</span>
                                    <span class="report-link-text">Discount Summary</span>
                                </div>

                                <div class="report-link-item" @onclick='() => OpenReportDateModal("DUE_SUMMARY")'>
                                    <span class="report-index">6.</span>
                                    <span class="report-link-text">Due Summary</span>
                                </div>

                                <div class="report-link-item" @onclick='() => OpenReportDateModal("GROUP_STATEMENT")'>
                                    <span class="report-index">7.</span>
                                    <span class="report-link-text">Group Statement</span>
                                </div>
                            </div>

                            <!-- Column 2 (Items 8 - 14) -->
                            <div class="report-column">
                                <div class="report-link-item" @onclick='() => OpenReportDateModal("GROUP_SUMMARY")'>
                                    <span class="report-index">8.</span>
                                    <span class="report-link-text">Group Summary</span>
                                </div>

                                <div class="report-link-item" @onclick='() => OpenReportDateModal("TEST_STATEMENT")'>
                                    <span class="report-index">9.</span>
                                    <span class="report-link-text">Test Statement</span>
                                </div>

                                <div class="report-link-item" @onclick='() => OpenReportDateModal("TEST_SUMMARY")'>
                                    <span class="report-index">10.</span>
                                    <span class="report-link-text">Test Summary</span>
                                </div>

                                <div class="report-link-item" @onclick='() => OpenReportDateModal("REFERRAL_SUMMARY")'>
                                    <span class="report-index">11.</span>
                                    <span class="report-link-text">Referral Summary</span>
                                </div>

                                <div class="report-link-item" @onclick='() => OpenReportDateModal("SUMMARY")'>
                                    <span class="report-index">12.</span>
                                    <span class="report-link-text">Summary</span>
                                </div>

                                <div class="report-link-item" @onclick='() => OpenReportDateModal("PAYMODE_STATEMENT")'>
                                    <span class="report-index">13.</span>
                                    <span class="report-link-text">Pay Mode Statement</span>
                                </div>

                                <div class="report-link-item" @onclick='() => OpenReportDateModal("PAYMODE_SUMMARY")'>
                                    <span class="report-index">14.</span>
                                    <span class="report-link-text">Pay Mode Summary</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- ========================================== -->
                <!-- VIEW 2: DEDICATED REPORT PREVIEW PAGE      -->
                <!-- ========================================== -->
                <div class="report-runner-card mb-4">
                    <!-- Toolbar Controls -->
                    <div class="report-runner-toolbar">
                        @if (branches.Any())
                        {
                            <div class="filter-item-wrap filter-item-branch">
                                <label class="filter-label"><i class="bi bi-hospital me-1 text-primary"></i> BRANCH</label>
                                <select class="form-control premium-filter-control" @bind="selectedBranchCode">
                                    <option value="0">All Branches</option>
                                    @foreach (var b in branches)
                                    {
                                        <option value="@b.bh_code">@b.name</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="filter-item-wrap filter-item-date">
                            <label class="filter-label"><i class="bi bi-calendar-event me-1 text-primary"></i> FROM</label>
                            <input type="date" class="form-control premium-filter-control" @bind="selectedFromDate" />
                        </div>

                        <div class="filter-item-wrap filter-item-date">
                            <label class="filter-label"><i class="bi bi-calendar-check me-1 text-primary"></i> TO</label>
                            <input type="date" class="form-control premium-filter-control" @bind="selectedToDate" />
                        </div>

                        <div class="filter-actions-wrap">
                            <button type="button" class="btn-report-show" disabled="@isGeneratingReport" @onclick="LoadReportPreview">
                                @if (isGeneratingReport)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Loading...</span>
                                }
                                else
                                {
                                    <i class="bi bi-play-circle me-1"></i>
                                    <span>Show</span>
                                }
                            </button>

                            <button type="button" class="btn-report-print" disabled="@isGeneratingReport" @onclick="PrintCurrentReport">
                                <i class="bi bi-printer me-1"></i>
                                <span>Print</span>
                            </button>

                            <button type="button" class="btn-report-popup" disabled="@isGeneratingReport" @onclick="OpenInteractiveModal" title="Open Full Preview Window">
                                <i class="bi bi-arrows-fullscreen me-1"></i>
                                <span>Full View</span>
                            </button>
                        </div>
                    </div>

                    <!-- In-Page PDF Frame -->
                    <div class="report-preview-frame-container">
                        @if (isGeneratingReport)
                        {
                            <div class="preview-loading-overlay">
                                <div class="spinner-border text-primary" style="width: 2.5rem; height: 2.5rem;" role="status"></div>
                                <span class="mt-2 fw-semibold text-muted">Generating @GetReportDisplayName(selectedReportKey)...</span>
                            </div>
                        }

                        @if (!hasLoadedReport && !isGeneratingReport)
                        {
                            <div class="preview-placeholder">
                                <i class="bi bi-file-earmark-pdf text-muted" style="font-size: 3.5rem;"></i>
                                <h4 class="mt-3 text-secondary fw-bold">Report Ready to Generate</h4>
                                <p class="text-muted" style="font-size: 0.85rem;">Select date range above, then click <strong>Show</strong> to view.</p>
                                <button type="button" class="btn btn-primary btn-sm px-4 mt-1" @onclick="LoadReportPreview">
                                    <i class="bi bi-play-fill me-1"></i> Show Report
                                </button>
                            </div>
                        }

                        <iframe id="billingReportFrame" class="report-pdf-iframe @(hasLoadedReport ? "visible" : "hidden")"
                                title="Billing Report Preview"></iframe>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Date Selection Prompt Modal -->
@if (showDateModal)
{
    <div class="modal-backdrop-custom" @onclick="CloseDateModal">
        <div class="date-picker-modal-content" @onclick:stopPropagation>
            <div class="date-modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-calendar3 text-primary" style="font-size: 1.25rem;"></i>
                    <div>
                        <h5 class="date-modal-title mb-0">@GetReportDisplayName(modalReportKey)</h5>
                        <span class="date-modal-subtitle">Select date range to view report</span>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" @onclick="CloseDateModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="date-modal-body">
                @if (branches.Any())
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">BRANCH</label>
                        <select class="form-control premium-filter-control" @bind="selectedBranchCode">
                            <option value="0">All Branches</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.bh_code">@b.name</option>
                            }
                        </select>
                    </div>
                }

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-bold small text-muted">FROM DATE</label>
                        <input type="date" class="form-control premium-filter-control" @bind="selectedFromDate" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold small text-muted">TO DATE</label>
                        <input type="date" class="form-control premium-filter-control" @bind="selectedToDate" />
                    </div>
                </div>
            </div>
            <div class="date-modal-footer">
                <button type="button" class="btn btn-light px-3" @onclick="CloseDateModal">Cancel</button>
                <button type="button" class="btn btn-outline-primary px-3" @onclick="() => ConfirmReportSelection(false)">
                    <i class="bi bi-eye me-1"></i> View on Page
                </button>
                <button type="button" class="btn btn-primary px-4" @onclick="() => ConfirmReportSelection(true)">
                    <i class="bi bi-file-earmark-pdf me-1"></i> Open Preview
                </button>
            </div>
        </div>
    </div>
}

<style>
.billing-reports-page {
    background: transparent !important;
    min-height: 100vh;
}

.items-shell {
    max-width: 1400px;
    margin: 0 auto;
}

/* Premium Header Card */
