@page "/billing-reports"
@page "/billingreports"
@page "/billing/reports"
@page "/reports"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using Booking.Models
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.CounterMasterService CounterMasterService

<PageTitle>Billing Reports</PageTitle>

<div class="billing-reports-page-wrapper">
    <div class="reports-main-container">

        <!-- ========================================================= -->
        <!-- ENHANCED TOP HEADER: TITLE & BRANCH / DATE CONTROLS       -->
        <!-- ========================================================= -->
        <div class="reports-header-card">
            <div class="header-left">
                <div class="header-icon-box">
                    <i class="bi bi-file-earmark-bar-graph-fill"></i>
                </div>
                <div class="header-title-box">
                    <h1 class="header-title">Billing Reports</h1>
                    <div class="header-subtitle">
                        <span class="status-pulse-dot"></span>
                        <span>OFFICIAL FINANCIAL STATEMENTS, SUMMARIES &amp; BILLING REPORTS</span>
                    </div>
                </div>
            </div>

            <!-- Enhanced Right Filters: Branch, From Date, To Date -->
            <div class="header-filters-wrapper">
                @if (branches.Any())
                {
                    <div class="header-filter-control-group branch-group">
                        <label class="header-filter-lbl"><i class="bi bi-hospital text-primary"></i> BRANCH</label>
                        <select class="form-select header-filter-input" @bind="selectedBranchCode">
                            <option value="0">All Branches</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.bh_code">@b.name</option>
                            }
                        </select>
                    </div>
                }

                @if (counters.Any())
                {
                    <div class="header-filter-control-group branch-group">
                        <label class="header-filter-lbl"><i class="bi bi-wallet2 text-primary"></i> COUNTER</label>
                        <select class="form-select header-filter-input" @bind="selectedCounterCode">
                            <option value="0">All Counters</option>
                            @foreach (var c in FilteredCounters)
                            {
                                <option value="@((int)c.cntcode)">@(string.IsNullOrWhiteSpace(c.name) ? $"Counter {c.cntcode}" : c.name)</option>
                            }
                        </select>
                    </div>
                }

                <div class="header-filter-control-group date-group">
                    <label class="header-filter-lbl"><i class="bi bi-calendar3 text-primary"></i> FROM DATE</label>
                    <input type="date" class="form-control header-filter-input" @bind="selectedFromDate" />
                </div>

                <div class="header-filter-control-group date-group">
                    <label class="header-filter-lbl"><i class="bi bi-calendar-check text-primary"></i> TO DATE</label>
                    <input type="date" class="form-control header-filter-input" @bind="selectedToDate" />
                </div>
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- CLEAN 2-COLUMN TEXT LIST (ONLY TEXT LINKS)                -->
        <!-- ========================================================= -->
        <div class="reports-content-card">
            <div class="reports-text-grid">
                <!-- Column 1 (Left: Items 1 - 7) -->
                <div class="reports-text-column">
                    <div class="report-text-row" @onclick='() => OpenReportPreview("STATEMENT")'>
                        <span class="report-link-text">Statement</span>
                    </div>

                    <div class="report-text-row" @onclick='() => OpenReportPreview("DUE_STATEMENT")'>
                        <span class="report-link-text">Due Statement</span>
                    </div>

                    <div class="report-text-row" @onclick='() => OpenReportPreview("DISCOUNT_STATEMENT")'>
                        <span class="report-link-text">Discount Statement</span>
                    </div>

                    <div class="report-text-row" @onclick='() => OpenReportPreview("REFERRAL_STATEMENT")'>
                        <span class="report-link-text">Referral Statement</span>
                    </div>

                    <div class="report-text-row" @onclick='() => OpenReportPreview("DISCOUNT_SUMMARY")'>
                        <span class="report-link-text">Discount Summary</span>
                    </div>

                    <div class="report-text-row" @onclick='() => OpenReportPreview("DUE_SUMMARY")'>
                        <span class="report-link-text">Due Summary</span>
                    </div>

                    <div class="report-text-row" @onclick='() => OpenReportPreview("GROUP_STATEMENT")'>
                        <span class="report-link-text">Group Statement</span>
                    </div>
                </div>

                <!-- Column 2 (Right: Items 8 - 14) -->
                <div class="reports-text-column">
                    <div class="report-text-row" @onclick='() => OpenReportPreview("GROUP_SUMMARY")'>
                        <span class="report-link-text">Group Summary</span>
                    </div>

                    <div class="report-text-row" @onclick='() => OpenReportPreview("TEST_STATEMENT")'>
                        <span class="report-link-text">Test Statement</span>
                    </div>

                    <div class="report-text-row" @onclick='() => OpenReportPreview("TEST_SUMMARY")'>
                        <span class="report-link-text">Test Summary</span>
                    </div>

                    <div class="report-text-row" @onclick='() => OpenReportPreview("REFERRAL_SUMMARY")'>
                        <span class="report-link-text">Referral Summary</span>
                    </div>

                    <div class="report-text-row" @onclick='() => OpenReportPreview("SUMMARY")'>
                        <span class="report-link-text">Summary</span>
                    </div>

                    <div class="report-text-row" @onclick='() => OpenReportPreview("PAYMODE_STATEMENT")'>
                        <span class="report-link-text">Pay Mode Statement</span>
                    </div>

@* Hidden per user request:
                    <div class="report-text-row" @onclick='() => OpenReportPreview("PAYMODE_SUMMARY")'>
                        <span class="report-link-text">Pay Mode Summary</span>
                    </div>

                    <div class="report-text-row" @onclick='() => OpenReportPreview("PAYMODE_COLLECTION")'>
                        <span class="report-link-text">Pay Mode Collection</span>
                    </div>
*@
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ========================================================= -->
<!-- REPORT PREVIEW MODAL                                      -->
<!-- ========================================================= -->
@if (showPreviewModal)
{
    <div class="preview-modal-backdrop" @onclick="ClosePreviewModal">
        <div class="preview-modal-container" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div class="preview-modal-header">
                <div class="preview-header-left">
                    <div class="preview-header-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                    <div>
                        <h4 class="preview-header-title">Report Preview</h4>
                        <div class="preview-header-subtitle">Review before printing &bull; @GetReportDisplayName(selectedReportKey)</div>
                    </div>
                </div>

                <div class="preview-header-actions">
                    <button type="button" class="btn-save-pdf" disabled="@(isGeneratingReport || !hasLoadedReport)" @onclick="DownloadCurrentReport">
                        <i class="bi bi-download me-1"></i>
                        <span>Save PDF</span>
                    </button>

                    <button type="button" class="btn-print-report" disabled="@(isGeneratingReport || !hasLoadedReport)" @onclick="PrintCurrentReport">
                        <i class="bi bi-printer me-1"></i>
                        <span>Print</span>
                    </button>

                    <button type="button" class="btn-close-preview" @onclick="ClosePreviewModal" title="Close Preview">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Modal Content / Iframe Viewer -->
            <div class="preview-modal-body">
                @if (isGeneratingReport)
                {
                    <div class="preview-modal-loading">
                        <div class="spinner-border text-primary" style="width: 3.5rem; height: 3.5rem;" role="status"></div>
                        <h5 class="mt-3 text-dark fw-bold">Generating @GetReportDisplayName(selectedReportKey)...</h5>
                        <p class="text-muted small">Fetching records for @selectedFromDate.ToString("dd-MMM-yyyy") to @selectedToDate.ToString("dd-MMM-yyyy")</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="preview-modal-error">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
                        <h5 class="mt-3 text-danger fw-bold">Unable to Load Report</h5>
                        <p class="text-muted px-4" style="max-width: 500px;">@errorMessage</p>
                        <div class="d-flex gap-2 mt-2">
                            <button class="btn btn-outline-secondary btn-sm px-3" @onclick="ClosePreviewModal">Close</button>
                            <button class="btn btn-primary btn-sm px-3" @onclick='() => OpenReportPreview(selectedReportKey)'>
                                <i class="bi bi-arrow-clockwise me-1"></i> Retry
                            </button>
                        </div>
                    </div>
                }

                <iframe id="billingReportModalFrame" class="preview-modal-iframe @(hasLoadedReport && !isGeneratingReport ? "visible" : "hidden")"
                        title="Billing Report Preview"></iframe>
            </div>
        </div>
    </div>
}

