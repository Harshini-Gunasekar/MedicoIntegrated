}

.header-card-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid rgba(99, 102, 241, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.08);
}

.header-card-icon svg {
    stroke: #4f46e5;
}

.header-card-text {
    display: flex;
    flex-direction: column;
    text-align: left;
}

.header-card-heading {
    color: #312e81;
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
