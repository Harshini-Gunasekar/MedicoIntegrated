/* ========================================================= */
/* 3. REPORT PREVIEW MODAL                                   */
/* ========================================================= */
.preview-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.7);
