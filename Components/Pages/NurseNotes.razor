/* Schedule Status Filter Group */
.sched-filter-group {
    display: inline-flex;
    align-items: center;
    background: #f1f5f9;
    padding: 3px;
    border-radius: 9999px;
    gap: 3px;
    border: 1px solid #e2e8f0;
}

.sched-filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 11.5px;
    font-weight: 700;
    border: none;
    background: transparent;
    color: #64748b;
    cursor: pointer;
    transition: all 0.18s ease;
}

.sched-filter-pill:hover {
    color: #1e293b;
    background: rgba(255, 255, 255, 0.7);
}

.sched-filter-pill.active-all {
    background: #4f46e5;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(79, 70, 229, 0.25);
}

.sched-filter-pill.active-pending {
    background: #d97706;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(217, 119, 6, 0.25);
}

.sched-filter-pill.active-completed {
    background: #16a34a;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(22, 163, 74, 0.25);
}

.sched-filter-pill.active-missed {
    background: #dc2626;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(220, 38, 38, 0.25);
}

.sched-filter-badge {
    padding: 0 5px;
    border-radius: 9999px;
    font-size: 10.5px;
    font-weight: 800;
    background: rgba(0, 0, 0, 0.08);
}

.sched-filter-pill.active-all .sched-filter-badge,
.sched-filter-pill.active-pending .sched-filter-badge,
.sched-filter-pill.active-completed .sched-filter-badge,
.sched-filter-pill.active-missed .sched-filter-badge {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
}

.fs-8 { font-size: 11px; }
.fs-7 { font-size: 12px; }

/* Fluid Stats Bar */
.fluid-stats-bar {
