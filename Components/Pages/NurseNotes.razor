@page "/ip/nurse-notes"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using medico_backend.Model
@using Medico_Backend.Model
@using static medico_backend.Model.IpBedsideChartModel
@using Booking.Services
@using Booking.Models
@using Booking.Helpers
@using System.Globalization

@inject NurseNotesService NurseNotesService
@inject NurseNotesMasterService NotesMasterService
@inject NurseMasterService NurseMasterService
@inject IpRegistrationService IpService
@inject DoctorService DoctorService
@inject DoctorSpecialtyMasterService SpecialtyService
@inject WardMasterService WardMasterService
@inject BedMasterService BedMasterService
@inject AppointmentBookingService AppointmentBookingService
@inject CaseSheetService CaseSheetService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory ClientFactory
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>IP Nurse Notes — @(isChartView ? (selectedPatient?.patient_name ?? "Bedside Chart") : "Inpatient Admissions")</PageTitle>

<!-- Background blobs & animation (Doctor Patient List / OT Console Style) -->
<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
</div>

<div class="dashboard-container" @onclick="HandlePageClick">
    <!-- ========================================================================= -->
    <!-- 1. DASHBOARD HEADER (OT CONSOLE & DOCTOR PATIENT LIST STYLE)               -->
    <!-- ========================================================================= -->
    <div class="dashboard-header" style="margin-top: 10px; margin-bottom: 8px;">
        <div class="dashboard-title">
            <h1 style="font-size: 1.15rem; font-weight: 800; margin: 0; color: #034f75; display: flex; align-items: center; gap: 0.5rem;">
                IP Nurse Notes
            </h1>
        </div>

        <div style="display: flex; gap: 8px; align-items: center; position: relative;">
            <!-- Nurse On Duty Chip -->
            <div class="nurse-duty-chip">
                <i class="bi bi-person-heart text-primary"></i>
                <span class="nurse-chip-name">@(string.IsNullOrWhiteSpace(currentUserName) ? "Duty Staff" : currentUserName)</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle nurse-chip-shift">@currentShiftDisplay</span>
            </div>

            <!-- Show Stats Toggle Button -->
            <button type="button" class="btn-header-action" @onclick="() => showListStats = !showListStats" title="Toggle Summary Statistics">
                <i class="bi bi-bar-chart-fill" style="color: #0284c7;"></i>
                <span>@(showListStats ? "Hide Stats" : "Show Stats")</span>
            </button>

            <!-- Refresh Queue Button -->
            <button type="button" class="btn-header-action" @onclick="RefreshAdmissionsList" disabled="@isLoadingPatients" title="Refresh in-patient list">
                @if (isLoadingPatients)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise" style="color: #0284c7;"></i>
                }
                <span>Refresh Queue</span>
            </button>
        </div>
    </div>

    <!-- Summary Stats Cards -->
    @if (showListStats)
    {
        <div class="nn-stats-grid mb-3">
            <div class="nn-stat-card card-indigo">
                <div class="stat-icon-wrap"><i class="bi bi-people-fill"></i></div>
                <div class="stat-info">
                    <span class="stat-label">CURRENTLY ADMITTED</span>
                    <span class="stat-value">@admittedPatients.Count(a => a.ip_status == "ADMITTED" || string.IsNullOrWhiteSpace(a.ip_status))</span>
                </div>
            </div>
            <div class="nn-stat-card card-emerald">
                <div class="stat-icon-wrap"><i class="bi bi-calendar-check-fill"></i></div>
                <div class="stat-info">
                    <span class="stat-label">TODAY'S ADMISSIONS</span>
                    <span class="stat-value">@admittedPatients.Count(a => a.admitdate.Date == DateTime.Today)</span>
                </div>
            </div>
            <div class="nn-stat-card card-amber">
                <div class="stat-icon-wrap"><i class="bi bi-heart-pulse-fill"></i></div>
                <div class="stat-info">
                    <span class="stat-label">ICU / CRITICAL</span>
                    <span class="stat-value">@admittedPatients.Count(a => GetWardBedText(a.wrdcode, a.bedcode).Contains("ICU", StringComparison.OrdinalIgnoreCase))</span>
                </div>
            </div>
            <div class="nn-stat-card card-purple">
                <div class="stat-icon-wrap"><i class="bi bi-building-fill-check"></i></div>
                <div class="stat-info">
                    <span class="stat-label">PRIVATE / SPECIAL</span>
                    <span class="stat-value">@admittedPatients.Count(a => GetWardBedText(a.wrdcode, a.bedcode).Contains("Special", StringComparison.OrdinalIgnoreCase) || GetWardBedText(a.wrdcode, a.bedcode).Contains("Deluxe", StringComparison.OrdinalIgnoreCase))</span>
                </div>
            </div>
            <div class="nn-stat-card card-blue">
                <div class="stat-icon-wrap"><i class="bi bi-hospital-fill"></i></div>
                <div class="stat-info">
                    <span class="stat-label">GENERAL WARD</span>
                    <span class="stat-value">@admittedPatients.Count(a => GetWardBedText(a.wrdcode, a.bedcode).Contains("General", StringComparison.OrdinalIgnoreCase))</span>
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- 2. TOOLBAR FILTERS CARD (DOCTOR PATIENT LIST / OT CONSOLE STYLE)          -->
    <!-- ========================================================================= -->
    <div class="filter-card">
        <div class="filter-flex">
            <!-- Admission Date -->
            <div class="filter-group filter-date-col">
                <label class="filter-label">ADMISSION DATE</label>
                <input type="date" class="form-control filter-input" @bind="listFilterDate" @bind:after="ApplyListFilters" />
            </div>

            <!-- Attending Doctor -->
            <div class="filter-group filter-doc-col">
                <label class="filter-label">ATTENDING DOCTOR</label>
                <select class="form-select filter-select" @bind="listFilterDoctorDcode" @bind:after="ApplyListFilters">
                    <option value="">All Attending Doctors</option>
                    @foreach (var doc in doctorsList.OrderBy(d => d.name))
                    {
                        <option value="@doc.dcode">@doc.GetFormattedName()</option>
                    }
                </select>
            </div>

            <!-- Ward / Room -->
            <div class="filter-group filter-ward-col">
                <label class="filter-label">WARD / ROOM</label>
                <select class="form-select filter-select" @bind="listFilterWardCode" @bind:after="ApplyListFilters">
                    <option value="">All Wards &amp; Rooms</option>
                    @foreach (var wrd in wardsList.OrderBy(w => w.name))
                    {
                        <option value="@wrd.wrdcode">@wrd.name</option>
                    }
                </select>
            </div>

            <!-- Admission Type -->
            <div class="filter-group filter-type-col">
                <label class="filter-label">ADMISSION TYPE</label>
                <select class="form-select filter-select" @bind="listFilterAdmissionType" @bind:after="ApplyListFilters">
                    <option value="ALL">All Types</option>
                    <option value="EMERGENCY">Emergency</option>
                    <option value="ROUTINE">Routine / Planned</option>
                    <option value="TRANSFER">Transfer</option>
                    <option value="SURGICAL">Surgical / OT</option>
                    <option value="MLC">Medico-Legal (MLC)</option>
                </select>
            </div>

            <!-- Referral Status -->
            <div class="filter-group filter-ref-col">
                <label class="filter-label">REFERRAL STATUS</label>
                <select class="form-select filter-select" @bind="listFilterReferral" @bind:after="ApplyListFilters">
                    <option value="ALL">All Patients</option>
                    <option value="REFERRED">Referred to Visiting</option>
                </select>
            </div>

            <!-- Pagination Toggle -->
            <div class="filter-group filter-pagination-col">
                <label class="filter-label">PAGINATION</label>
                <select class="form-select filter-select" @bind="paginationOption" @bind:after="OnPaginationToggle">
                    <option value="YES">Yes</option>
                    <option value="NO">No</option>
                </select>
            </div>

            <!-- Search Patient / IP / Doctor / Ward -->
            <div class="filter-group filter-search-col">
                <label class="filter-label">SEARCH PATIENT / IP / DOCTOR / WARD</label>
                <div class="search-input-group">
                    <input type="text"
                           placeholder="Type to search..."
                           class="form-control filter-input"
                           @bind="listSearchText"
                           @bind:event="oninput"
                           @bind:after="ApplyListFilters" />
                    @if (!string.IsNullOrEmpty(listSearchText))
                    {
                        <button type="button" class="btn-clear-search" @onclick="ClearListSearch" title="Clear search">&times;</button>
                    }
                </div>
            </div>

            <!-- Reset Filters -->
            <div class="filter-action-group">
                <button type="button" class="btn-reset" @onclick="ResetListFilters" title="Reset all filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 3. INPATIENT ADMISSIONS TABLE (MEDICO TABLE STYLE)                        -->
    <!-- ========================================================================= -->
    <div class="table-card">
        <div class="table-responsive">
            @{
                var filtered = GetFilteredAdmissions();
                var pagedList = enableListPagination ? filtered.Skip((listCurrentPage - 1) * listPageSize).Take(listPageSize).ToList() : filtered;
                int sNoBase = (listCurrentPage - 1) * listPageSize;
            }
            <table class="medico-table">
                <thead>
                    <tr>
                        <th style="width: 45px; text-align: center;">S.NO</th>
                        <th style="width: 180px;">PATIENT DETAILS</th>
                        <th style="width: 145px;">IP NO. &amp; STATUS</th>
                        <th>WARD / BED LOCATION</th>
                        <th>ATTENDING DOCTOR</th>
                        <th style="width: 155px;">ADMISSION DATE &amp; TIME</th>
                        <th style="width: 110px; text-align: center;">ADMISSION TYPE</th>
                        <th>REFERRED VISITING DOCTOR</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoadingPatients)
                    {
                        <tr>
                            <td colspan="8" class="text-center p-48">
                                <div class="spinner-border text-primary me-2" style="width: 1.5rem; height: 1.5rem;" role="status"></div>
                                <span class="text-slate-500 font-semibold">Loading admitted patients...</span>
                            </td>
                        </tr>
                    }
                    else if (!filtered.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center p-48 text-slate-400 italic">No admitted in-patients found matching your criteria.</td>
                        </tr>
                    }
                    else
                    {
                        for (int i = 0; i < pagedList.Count; i++)
                        {
                            var pat = pagedList[i];
                            var rowSNo = sNoBase + i + 1;
                            var isReferred = ipVisitingDoctorMap.TryGetValue(pat.ip_id, out var info) && info.IsReferred;
                            var visitingDocName = isReferred ? info.DoctorName : "";
                            var isVip = pat.isvip == true || pat.is_vip == true;
                            var vipRole = isVip ? (!string.IsNullOrWhiteSpace(pat.viprole) ? pat.viprole : GetPatientVipRole(pat.custid)) : string.Empty;

                            <tr class="lc-table-row clickable-row"
                                @ondblclick="() => OpenPatientBedsideChart(pat)"
                                style="cursor: pointer;"
                                title="Double-click to open Bedside Clinical Chart for @pat.patient_name">
                                <td class="font-mono text-slate-500 font-bold" style="text-align: center;">@rowSNo</td>
                                <td>
                                    <div class="row-patient-cell" style="display: flex; flex-direction: column; gap: 2px;">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="patient-primary-name font-bold text-slate-800">@pat.patient_name</span>
                                            @if (!string.IsNullOrWhiteSpace(vipRole))
                                            {
                                                <span class="badge bg-warning text-dark font-11" title="@vipRole">VIP</span>
                                            }
                                        </div>
                                        <span class="patient-mrd-sub" style="font-size: 0.72rem; color: #64748b; font-weight: 600;">@GetPatientAgeGenderFor(pat)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <span class="font-bold text-slate-800 font-mono" style="font-size: 0.82rem;">@pat.ip_no</span>
                                        <span class="badge @(pat.ip_status?.ToLower() == "discharged" ? "bg-secondary-subtle text-secondary" : "bg-success-subtle text-success border border-success-subtle") font-11" style="width: fit-content;">
                                             @(string.IsNullOrWhiteSpace(pat.ip_status) ? "ADMITTED" : pat.ip_status)
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-slate-800 font-bold" style="font-size: 0.82rem;">
                                        <span>@GetWardBedText(pat.wrdcode, pat.bedcode)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="doc-info-col">
                                        <div class="doc-name-text font-bold text-slate-800" style="font-size: 0.82rem;">
                                            @GetDoctorName(pat.dcode)
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="text-slate-800 font-bold" style="font-size: 0.8rem;">@pat.admitdate.ToIndianTime().ToString("dd-MMM-yyyy")</span>
                                        <span class="text-slate-500" style="font-size: 0.73rem; font-weight: 500;">@pat.admitdate.ToIndianTime().ToString("hh:mm tt")</span>
                                    </div>
                                </td>
                                <td style="text-align: center;">
                                    <span class="badge @(pat.admission_type == "EMERGENCY" ? "bg-danger text-white" : "bg-primary-subtle text-primary border border-primary-subtle") font-11">
                                        @(string.IsNullOrWhiteSpace(pat.admission_type) ? "ROUTINE" : pat.admission_type)
                                    </span>
                                </td>
                                <td>
                                    @if (isReferred && !string.IsNullOrWhiteSpace(visitingDocName))
                                    {
                                        <span class="text-slate-800 font-bold" style="font-size: 0.8rem; line-height: 1.35; display: inline-block;">@visitingDocName</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 font-bold" style="font-size: 0.85rem;">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- ========================================================================= -->
        <!-- 4. PAGINATION FOOTER (OT CONSOLE & DOCTOR PATIENT LIST STYLE)              -->
        <!-- ========================================================================= -->
        @if (filtered.Count > 0)
        {
            if (enableListPagination)
            {
                var totalPages = Math.Max(1, (int)Math.Ceiling((double)filtered.Count / listPageSize));
                <div class="pagination-footer">
                    <div class="pagination-info">
                        Showing <span class="pagination-info-highlight">@(((listCurrentPage - 1) * listPageSize) + 1)</span> to <span class="pagination-info-highlight">@(Math.Min(listCurrentPage * listPageSize, filtered.Count))</span> of <span class="pagination-info-highlight">@filtered.Count</span> in-patients
                    </div>
                    @if (totalPages > 1)
                    {
                        <div class="pagination-btns">
                            <button type="button" class="page-btn" disabled="@(listCurrentPage <= 1)" @onclick="() => listCurrentPage--" title="Previous Page">&lsaquo;</button>

                            @for (int p = Math.Max(1, listCurrentPage - 2); p <= Math.Min(totalPages, listCurrentPage + 2); p++)
                            {
                                var pageNum = p;
                                <button type="button" class="page-btn @(listCurrentPage == pageNum ? "active" : "")" @onclick="() => listCurrentPage = pageNum">@pageNum</button>
                            }

                            <button type="button" class="page-btn" disabled="@(listCurrentPage >= totalPages)" @onclick="() => listCurrentPage++" title="Next Page">&rsaquo;</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="pagination-footer" style="justify-content: flex-end;">
                    <div class="pagination-info">
                        Showing all <span class="pagination-info-highlight">@filtered.Count</span> in-patients
                    </div>
                </div>
            }
        }
    </div>
</div>

    <!-- ========================================================================= -->
    <!-- 2. BEDSIDE CLINICAL OBSERVATION & CARE CHART (AUTHENTIC CASE SHEET MODAL) -->
    <!-- ========================================================================= -->
    @if (isChartView && selectedPatient != null)
    {
        <div class="casesheet-backdrop" @onclick="BackToPatientList">
            <div class="casesheet-modal" @onclick:stopPropagation>
                <!-- Case Sheet Header -->
                <div class="casesheet-header">
                    <div class="header-patient-info">
                        <div class="patient-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="patient-meta">
                            <h2 class="patient-title">
                                @(selectedPatient.patient_name ?? "Walk-in Patient")
                                <span class="patient-id-badge"># @selectedPatient.ip_no</span>
                                <span class="status-badge admitted">
                                    @(string.IsNullOrWhiteSpace(selectedPatient.ip_status) ? "ADMITTED" : selectedPatient.ip_status.ToUpper())
                                </span>
                            </h2>
                            <span class="patient-sub">
                                Age / Gender: @GetPatientAgeGender()
                                <span> | Ward: @GetPatientWardBed()</span>
                                <span> | Attending Doctor: @GetDoctorName(selectedPatient.dcode)</span>
                                <span> | Admission Date: @(selectedPatient.admitdate.ToIndianTime().ToString("dd-MMM-yyyy"))</span>
                            </span>
                        </div>
                    </div>

                    <div class="header-actions">
                        <button type="button" class="btn-casesheet-op" @onclick="OpenCaseSheetModal" title="Open doctor's clinical case sheet">
                            <i class="bi bi-file-earmark-medical"></i>
                            <span>Doctor Case Sheet</span>
                        </button>
                        <button type="button" class="btn-close-modal" @onclick="BackToPatientList" title="Close Chart">×</button>
                    </div>
                </div>

                <!-- Modal Body -->
                <div class="casesheet-body">
                    <div class="workspace-left">
                        <!-- Tab Navigation Strip -->
                        <div class="tabs-container">
                            <button type="button" class="tab-btn @(activeTab == "temperature" ? "active" : "")" @onclick='() => SetActiveTab("temperature")'>
                                <i class="bi bi-thermometer-half"></i>
                                <span>Temperature</span>
                                @if (temperatureList.Any())
                                {
                                    <span class="tab-badge-pill">@temperatureList.Count</span>
                                }
                            </button>

                            <button type="button" class="tab-btn @(activeTab == "vitals" ? "active" : "")" @onclick='() => SetActiveTab("vitals")'>
                                <i class="bi bi-heart-pulse"></i>
                                <span>Vitals</span>
                                @if (vitalsList.Any())
                                {
                                    <span class="tab-badge-pill">@vitalsList.Count</span>
                                }
                            </button>

                            <button type="button" class="tab-btn @(activeTab == "input_output" ? "active" : "")" @onclick='() => SetActiveTab("input_output")'>
                                <i class="bi bi-droplet-half"></i>
                                <span>Input / Output</span>
                                @if (inputOutputList.Any())
                                {
                                    <span class="tab-badge-pill">@inputOutputList.Count</span>
                                }
                            </button>

                            <button type="button" class="tab-btn @(activeTab == "service" ? "active" : "")" @onclick='() => SetActiveTab("service")'>
                                <i class="bi bi-gear-wide-connected"></i>
                                <span>Service</span>
                                @if (serviceList.Any())
                                {
                                    <span class="tab-badge-pill">@serviceList.Count</span>
                                }
                            </button>

                            <button type="button" class="tab-btn @(activeTab == "medicine" ? "active" : "")" @onclick='() => SetActiveTab("medicine")'>
                                <i class="bi bi-capsule"></i>
                                <span>Medicine</span>
                                @if (medicineList.Any())
                                {
                                    <span class="tab-badge-pill">@medicineList.Count</span>
                                }
                            </button>

                            <button type="button" class="tab-btn @(activeTab == "visiting_doctor" ? "active" : "")" @onclick='() => SetActiveTab("visiting_doctor")'>
                                <i class="bi bi-person-badge"></i>
                                <span>Doctor Visiting</span>
                                @if (visitingDoctorList.Any())
                                {
                                    <span class="tab-badge-pill">@visitingDoctorList.Count</span>
                                }
                            </button>

                            <button type="button" class="tab-btn @(activeTab == "schedule" ? "active" : "")" @onclick='() => SetActiveTab("schedule")'>
                                <i class="bi bi-alarm"></i>
                                <span>Schedule</span>
                                @if (scheduleList.Any())
                                {
                                    <span class="tab-badge-pill">@scheduleList.Count</span>
                                }
                            </button>

                            <button type="button" class="tab-btn @(activeTab == "referred_visiting_doctors" ? "active" : "")" @onclick='() => SetActiveTab("referred_visiting_doctors")'>
                                <i class="bi bi-person-check"></i>
                                <span>Referred Doctors</span>
                                @if (GetReferredVisitingDoctorList().Any())
                                {
                                    <span class="tab-badge-pill">@GetReferredVisitingDoctorList().Count</span>
                                }
                            </button>

                            <button type="button" class="tab-btn @(activeTab == "other" ? "active" : "")" @onclick='() => SetActiveTab("other")'>
                                <i class="bi bi-journal-text"></i>
                                <span>Other Notes</span>
                                @if (otherList.Any())
                                {
                                    <span class="tab-badge-pill">@otherList.Count</span>
                                }
                            </button>
                        </div>

                        <!-- Tab Content Area with Smooth Scroll -->
                        <div class="tab-content casesheet-nurse-tab-content">
                            @if (isLoadingData)
                            {
                                <div class="loading-state-box" style="padding: 4rem; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                    <div class="spinner-border text-indigo-600" style="width: 2.75rem; height: 2.75rem;" role="status"></div>
                                    <span class="text-slate-700 font-bold mt-3" style="font-size: 13px;">Loading bedside observations...</span>
                                </div>
                            }
                            else
                            {
                                @* ═══════════════════════════════════════════════════════════════════ *@
                                @* TAB 1: TEMPERATURE                                                 *@
                                @* ═══════════════════════════════════════════════════════════════════ *@
                                @if (activeTab == "temperature")
                                {
                                    <div class="tab-section-flow">
                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-thermometer-half text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Temperature Observation Log</span>
                                    <span class="table-pill-count ms-1">@temperatureList.Count @(temperatureList.Count == 1 ? "Record" : "Records")</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="inline-entry-tip-pill">
                                        <i class="bi bi-arrow-return-left me-1 text-indigo-500"></i>Type values &amp; press Enter to save (new row automatically appears below)
                                    </span>
                                </div>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table spreadsheet-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 45px; text-align: center;">S.NO.</th>
                                            <th style="width: 145px; white-space: nowrap;">TIME &amp; SHIFT</th>
                                            <th style="width: 110px;">TEMPERATURE</th>
                                            <th style="width: 85px; min-width: 85px; text-align: center;">UNIT</th>
                                            <th style="min-width: 120px;">REMARKS / FINDINGS</th>
                                            <th style="width: 115px; text-align: center; white-space: nowrap;">RECORDED BY</th>
                                            <th style="width: 85px; min-width: 85px; text-align: center; white-space: nowrap;">ACTION</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- 1. All previously saved records in chronological sequence -->
                                        @{ int sNo = 1; }
                                        @foreach (var t in temperatureList.OrderBy(x => x.created_at))
                                        {
                                            var rowSNo = sNo++;
                                            var isRowEditing = editingTempId.HasValue && editingTempId.Value == t.temp_id;
                                            if (isRowEditing)
                                            {
                                                <tr class="table-inline-entry-row is-inline-editing">
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <span class="badge-edit-mode">@rowSNo</span>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <div class="inline-time-shift-wrap">
                                                            <input type="text"
                                                                   class="inline-table-input time-input"
                                                                   placeholder="05:45 PM"
                                                                   @bind="tempTimeDisplay" />
                                                            <select class="inline-table-select shift-select"
                                                                    @bind="tempShift">
                                                                <option value="MORNING">Morning</option>
                                                                <option value="AFTERNOON">Afternoon</option>
                                                                <option value="EVENING">Evening</option>
                                                                <option value="NIGHT">Night</option>
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="number"
                                                               step="0.1"
                                                               class="inline-table-input temp-val-input font-bold text-indigo-700"
                                                               placeholder="98.6"
                                                               @bind="tempValue"
                                                               @bind:event="oninput" />
                                                    </td>
                                                    <td style="vertical-align: middle; text-align: center;">
                                                        <select class="inline-table-select unit-select font-bold"
                                                                @bind="tempUnit">
                                                            <option value="F">°F</option>
                                                            <option value="C">°C</option>
                                                        </select>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="text"
                                                               class="inline-table-input remarks-input"
                                                               placeholder="Remarks (Press Enter to update)..."
                                                               @bind="tempRemarks"
                                                               @bind:event="oninput"
                                                               @onkeydown="(e) => HandleExistingTempKeyDown(e, t)" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <div class="inline-recorded-by">
                                                            <span class="user-chip-mini">@GetAddedByText(t.usercode)</span>
                                                        </div>
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center gap-1">
                                                            <button type="button" class="btn-action-icon btn-action-save" title="Save changes" @onclick="() => SaveExistingTemperatureAsync(t)">
                                                                <i class="bi bi-check-circle-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Cancel Edit" @onclick="CancelEditTemp">
                                                                <i class="bi bi-x-circle-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr class="lc-table-row saved-row" @ondblclick="() => StartEditTemp(t)" title="Double-click to edit row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@rowSNo</td>
                                                    <td>
                                                        <span class="font-bold text-slate-800">@FormatEntryTime(t.entry_time, t.created_at)</span>
                                                        <span class="tag-shift-indigo ms-2">@t.shift</span>
                                                    </td>
                                                    <td class="font-bold text-indigo-600">
                                                        @t.temperature
                                                        @if (t.temperature >= 100.4m || (t.unit == "C" && t.temperature >= 38m))
                                                        {
                                                            <span class="badge bg-danger ms-1" style="font-size: 10px;">High Fever</span>
                                                        }
                                                    </td>
                                                    <td class="text-slate-600">°@t.unit</td>
                                                    <td class="text-slate-700">@(string.IsNullOrWhiteSpace(t.remarks) ? "—" : t.remarks)</td>
                                                    <td class="text-slate-600">@GetAddedByText(t.usercode)</td>
                                                    <td style="text-align: center; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit row" @onclick="() => StartEditTemp(t)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Delete record" @onclick="() => DeleteTemperatureAsync(t.temp_id)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }

                                        <!-- 2. Active New Input Row (Always at the bottom, auto-saves and creates new row on Enter) -->
                                        <tr class="table-inline-entry-row active-new-row">
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span class="badge-new-entry" title="Next Entry Row">@sNo</span>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <div class="inline-time-shift-wrap">
                                                    <input type="text"
                                                           class="inline-table-input time-input"
                                                           placeholder="05:45 PM"
                                                           @bind="newTempTime"
                                                           title="Time (hh:mm AM/PM)" />
                                                    <select class="inline-table-select shift-select"
                                                            @bind="newTempShift"
                                                            title="Shift">
                                                        <option value="MORNING">Morning</option>
                                                        <option value="AFTERNOON">Afternoon</option>
                                                        <option value="EVENING">Evening</option>
                                                        <option value="NIGHT">Night</option>
                                                    </select>
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input @ref="newTempInputRef"
                                                       type="number"
                                                       step="0.1"
                                                       class="inline-table-input temp-val-input font-bold text-indigo-700"
                                                       placeholder="e.g. 98.6"
                                                       @bind="newTempValue"
                                                       @bind:event="oninput"
                                                       title="Type temperature" />
                                            </td>
                                            <td style="vertical-align: middle; text-align: center;">
                                                <select class="inline-table-select unit-select font-bold"
                                                        @bind="newTempUnit"
                                                        title="Unit">
                                                    <option value="F">°F</option>
                                                    <option value="C">°C</option>
                                                </select>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="text"
                                                       class="inline-table-input remarks-input"
                                                       placeholder="Type remarks & press Enter to save..."
                                                       @bind="newTempRemarks"
                                                       @bind:event="oninput"
                                                       @onkeydown="HandleNewTempKeyDown"
                                                       title="Type remarks & press Enter to save" />
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <div class="inline-recorded-by">
                                                    <span class="user-chip-mini" title="Logged-in User">
                                                        <i class="bi bi-person-check-fill me-1 text-indigo-500"></i>
                                                        @(string.IsNullOrWhiteSpace(currentUserName) ? "Duty Staff" : currentUserName)
                                                    </span>
                                                </div>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <button type="button" class="badge-enter-key" @onclick="SaveNewTemperatureInlineAsync" title="Save record (or press Enter on keyboard)">
                                                    <i class="bi bi-arrow-return-left"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 2: VITALS                                                       *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "vitals")
                {
                    <div class="tab-section-flow">
                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-heart-pulse text-rose-600 fs-6"></i>
                                    <span class="table-card-heading">Vitals Observation History</span>
                                    <span class="table-pill-count ms-1">@vitalsList.Count @(vitalsList.Count == 1 ? "Record" : "Records")</span>
                                </div>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 45px; text-align: center;">S.NO.</th>
                                            <th style="width: 140px; white-space: nowrap;">DATE &amp; TIME</th>
                                            <th style="width: 110px;">BP (MMHG)</th>
                                            <th style="width: 65px;">PULSE</th>
                                            <th style="width: 65px;">SPO2</th>
                                            <th style="width: 65px;">RESP</th>
                                            <th style="width: 70px;">TEMP</th>
                                            <th style="width: 70px;">GRBS</th>
                                            <th style="width: 70px;">PAIN</th>
                                            <th style="min-width: 120px;">CLINICAL NOTES</th>
                                            <th style="width: 85px; min-width: 85px; text-align: center; white-space: nowrap;">ACTION</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sNo = 1;
                                        }
                                        <!-- 1. Previously Saved Rows in Chronological Order -->
                                        @foreach (var v in vitalsList.OrderBy(x => x.created_at))
                                        {
                                            var rowSNo = sNo++;
                                            var isEditing = editingVitalId == v.vital_id;
                                            if (isEditing)
                                            {
                                                <tr class="table-inline-entry-row is-inline-editing">
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <span class="badge-edit-mode">EDIT @rowSNo</span>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <div class="font-bold text-slate-800">@FormatDateTime(v.created_at)</div>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <div style="display: flex; align-items: center; gap: 3px;">
                                                            <input type="number" class="inline-table-input text-center font-bold" placeholder="Sys" @bind="vitalSys" @bind:event="oninput" style="width: 55px;" />
                                                            <span>/</span>
                                                            <input type="number" class="inline-table-input text-center font-bold" placeholder="Dia" @bind="vitalDia" @bind:event="oninput" style="width: 55px;" />
                                                        </div>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="number" class="inline-table-input text-center" placeholder="Pulse" @bind="vitalPulse" @bind:event="oninput" style="width: 65px;" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="number" step="0.1" class="inline-table-input text-center" placeholder="SpO2" @bind="vitalSpo2" @bind:event="oninput" style="width: 65px;" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="number" class="inline-table-input text-center" placeholder="RR" @bind="vitalResp" @bind:event="oninput" style="width: 60px;" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="number" step="0.1" class="inline-table-input text-center" placeholder="Temp" @bind="vitalTemp" @bind:event="oninput" style="width: 70px;" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="number" step="0.1" class="inline-table-input text-center" placeholder="GRBS" @bind="vitalSugar" @bind:event="oninput" style="width: 70px;" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <select class="inline-table-select" @bind="vitalPain" style="width: 85px;">
                                                            <option value="0">0 - None</option>
                                                            <option value="2">2 - Mild</option>
                                                            <option value="4">4 - Mod</option>
                                                            <option value="6">6 - Sev</option>
                                                            <option value="8">8 - V.Sev</option>
                                                            <option value="10">10 - Max</option>
                                                        </select>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="text" class="inline-table-input remarks-input" placeholder="Notes (Press Enter to update)..." @bind="vitalNotes" @bind:event="oninput" @onkeydown="(e) => HandleExistingVitalsKeyDown(e, v)" />
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center gap-1">
                                                            <button type="button" class="btn-action-icon btn-action-save" title="Save changes" @onclick="() => SaveExistingVitalsAsync(v)">
                                                                <i class="bi bi-check-circle-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Cancel Edit" @onclick="CancelEditVitals">
                                                                <i class="bi bi-x-circle-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr class="lc-table-row saved-row" @ondblclick="() => StartEditVitals(v)" title="Double-click to edit row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@rowSNo</td>
                                                    <td class="font-bold text-slate-800">@FormatDateTime(v.created_at)</td>
                                                    <td class="font-bold text-indigo-600">
                                                        @if (v.bp_systolic.HasValue || v.bp_diastolic.HasValue)
                                                        {
                                                            <span>@v.bp_systolic / @v.bp_diastolic</span>
                                                        }
                                                        else { <span>—</span> }
                                                    </td>
                                                    <td class="text-slate-700">@(v.pulse_rate?.ToString() ?? "—") bpm</td>
                                                    <td class="text-slate-700">
                                                        @(v.spo2?.ToString() ?? "—")%
                                                        @if (v.spo2.HasValue && v.spo2 < 95)
                                                        {
                                                            <span class="badge bg-warning text-dark ms-1" style="font-size: 10px;">Low</span>
                                                        }
                                                    </td>
                                                    <td class="text-slate-700">@(v.respiratory_rate?.ToString() ?? "—")</td>
                                                    <td class="text-slate-700">@(v.temperature_f?.ToString() ?? "—")°F</td>
                                                    <td class="text-slate-700">@(v.sugar_level?.ToString() ?? "—")</td>
                                                    <td class="text-slate-700">@(v.pain_scale?.ToString() ?? "—")/10</td>
                                                    <td class="text-slate-600">@(string.IsNullOrWhiteSpace(v.allergy_notes) ? "—" : v.allergy_notes)</td>
                                                    <td style="text-align: center; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit row" @onclick="() => StartEditVitals(v)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>

                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }

                                        <!-- 2. Active New Input Row (Always at the bottom, auto-saves and creates new row on Enter) -->
                                        <tr class="table-inline-entry-row active-new-row">
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span class="badge-new-entry" title="Next Entry Row">@sNo</span>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <div class="inline-time-shift-wrap">
                                                    <input type="text"
                                                           class="inline-table-input time-input"
                                                           placeholder="05:45 PM"
                                                           @bind="newVitTime"
                                                           title="Time" />
                                                    <select class="inline-table-select shift-select"
                                                            @bind="newVitShift"
                                                            title="Shift">
                                                        <option value="MORNING">Morning</option>
                                                        <option value="AFTERNOON">Afternoon</option>
                                                        <option value="EVENING">Evening</option>
                                                        <option value="NIGHT">Night</option>
                                                    </select>
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <div style="display: flex; align-items: center; gap: 3px;">
                                                    <input @ref="newVitBpSysRef"
                                                           type="number"
                                                           class="inline-table-input text-center font-bold text-indigo-700"
                                                           placeholder="120"
                                                           @bind="newVitBpSys"
                                                           @bind:event="oninput"
                                                           style="width: 55px;"
                                                           title="Systolic BP" />
                                                    <span class="text-slate-400 font-bold">/</span>
                                                    <input type="number"
                                                           class="inline-table-input text-center font-bold text-indigo-700"
                                                           placeholder="80"
                                                           @bind="newVitBpDia"
                                                           @bind:event="oninput"
                                                           style="width: 55px;"
                                                           title="Diastolic BP" />
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="number"
                                                       class="inline-table-input text-center"
                                                       placeholder="72"
                                                       @bind="newVitPulse"
                                                       @bind:event="oninput"
                                                       style="width: 65px;"
                                                       title="Pulse (bpm)" />
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="number"
                                                       step="0.1"
                                                       class="inline-table-input text-center"
                                                       placeholder="98"
                                                       @bind="newVitSpo2"
                                                       @bind:event="oninput"
                                                       style="width: 65px;"
                                                       title="SpO2 (%)" />
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="number"
                                                       class="inline-table-input text-center"
                                                       placeholder="18"
                                                       @bind="newVitRr"
                                                       @bind:event="oninput"
                                                       style="width: 60px;"
                                                       title="Respiratory Rate" />
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="number"
                                                       step="0.1"
                                                       class="inline-table-input text-center"
                                                       placeholder="98.6"
                                                       @bind="newVitTemp"
                                                       @bind:event="oninput"
                                                       style="width: 70px;"
                                                       title="Temp (°F)" />
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="number"
                                                       step="0.1"
                                                       class="inline-table-input text-center"
                                                       placeholder="110"
                                                       @bind="newVitSugar"
                                                       @bind:event="oninput"
                                                       style="width: 70px;"
                                                       title="GRBS / Blood Sugar (mg/dL)" />
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <select class="inline-table-select"
                                                        @bind="newVitPain"
                                                        style="width: 85px;"
                                                        title="Pain Scale (0-10)">
                                                    <option value="0">0 - None</option>
                                                    <option value="2">2 - Mild</option>
                                                    <option value="4">4 - Mod</option>
                                                    <option value="6">6 - Sev</option>
                                                    <option value="8">8 - V.Sev</option>
                                                    <option value="10">10 - Max</option>
                                                </select>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="text"
                                                       class="inline-table-input remarks-input"
                                                       placeholder="Type clinical notes & press Enter to save..."
                                                       @bind="newVitNotes"
                                                       @bind:event="oninput"
                                                       @onkeydown="HandleNewVitalsKeyDown"
                                                       title="Clinical Notes / Findings" />
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <button type="button" class="badge-enter-key" @onclick="SaveNewVitalsInlineAsync" title="Save record (or press Enter on keyboard)">
                                                    <i class="bi bi-arrow-return-left"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 3: INPUT / OUTPUT                                               *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "input_output")
                {
                    <div class="tab-section-flow">
                        <!-- Fluid Balance Summary Pill Bar -->
                        <div class="fluid-stats-bar mb-2">
                            <div class="fluid-pill pill-intake">
                                <span class="fluid-lbl">TOTAL INTAKE:</span>
                                <span class="fluid-val">@inputOutputList.Where(x => string.Equals(x.io_type, "INPUT", StringComparison.OrdinalIgnoreCase)).Sum(x => x.quantity ?? 0) ml</span>
                            </div>
                            <div class="fluid-pill pill-output">
                                <span class="fluid-lbl">TOTAL OUTPUT:</span>
                                <span class="fluid-val">@inputOutputList.Where(x => string.Equals(x.io_type, "OUTPUT", StringComparison.OrdinalIgnoreCase)).Sum(x => x.quantity ?? 0) ml</span>
                            </div>
                            <div class="fluid-pill pill-net">
                                <span class="fluid-lbl">FLUID BALANCE:</span>
                                <span class="fluid-val">@CalculateFluidBalance() ml</span>
                            </div>
                        </div>

                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-cup-straw text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Input / Output Fluid Flow Log</span>
                                    <span class="table-pill-count ms-1">@inputOutputList.Count Entries</span>
                                </div>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 45px; text-align: center;">S.NO.</th>
                                            <th style="width: 145px; white-space: nowrap;">TIME &amp; SHIFT</th>
                                            <th style="width: 90px;">TYPE</th>
                                            <th style="width: 180px;">PARTICULARS</th>
                                            <th style="width: 90px;">QUANTITY</th>
                                            <th style="min-width: 120px;">REMARKS</th>
                                            <th style="width: 115px; text-align: center; white-space: nowrap;">RECORDED BY</th>
                                            <th style="width: 85px; min-width: 85px; text-align: center; white-space: nowrap;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sNo = 1;
                                        }
                                        <!-- 1. Previously Saved Rows in Chronological Order -->
                                        @foreach (var item in inputOutputList.OrderBy(x => x.created_at))
                                        {
                                            var rowSNo = sNo++;
                                            var isEditing = editingIoId == item.io_id;
                                            if (isEditing)
                                            {
                                                <tr class="table-inline-entry-row is-inline-editing">
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <span class="badge-edit-mode">EDIT @rowSNo</span>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <div class="inline-time-shift-wrap">
                                                            <span class="font-bold text-slate-800">@FormatEntryTime(item.entry_time, item.created_at)</span>
                                                            <select class="inline-table-select shift-select" @bind="ioShift">
                                                                <option value="MORNING">Morning</option>
                                                                <option value="AFTERNOON">Afternoon</option>
                                                                <option value="EVENING">Evening</option>
                                                                <option value="NIGHT">Night</option>
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <select class="inline-table-select font-bold" @bind="ioType">
                                                            <option value="INPUT">INPUT</option>
                                                            <option value="OUTPUT">OUTPUT</option>
                                                        </select>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="text" class="inline-table-input font-bold" @bind="ioParticulars" @bind:event="oninput" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <div style="display: flex; align-items: center; gap: 3px;">
                                                            <input type="number" class="inline-table-input font-bold text-center" @bind="ioQuantity" @bind:event="oninput" style="width: 70px;" />
                                                            <span class="text-slate-500 font-bold">ml</span>
                                                        </div>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="text" class="inline-table-input remarks-input" placeholder="Remarks & Enter to update..." @bind="ioRemarks" @bind:event="oninput" @onkeydown="(e) => HandleExistingIoKeyDown(e, item)" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <span class="user-chip-mini">@GetAddedByText(item.usercode)</span>
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center gap-1">
                                                            <button type="button" class="btn-action-icon btn-action-save" title="Save changes" @onclick="() => SaveExistingIoAsync(item)">
                                                                <i class="bi bi-check-circle-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Cancel Edit" @onclick="CancelEditIo">
                                                                <i class="bi bi-x-circle-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr class="lc-table-row saved-row" @ondblclick="() => StartEditIo(item)" title="Double-click to edit row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@rowSNo</td>
                                                    <td>
                                                        <span class="font-bold text-slate-800">@FormatEntryTime(item.entry_time, item.created_at)</span>
                                                        <span class="tag-shift-indigo ms-2">@item.shift</span>
                                                    </td>
                                                    <td>
                                                        @if (string.Equals(item.io_type, "INPUT", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-indigo-50 text-indigo-600 font-bold px-2 py-1">INPUT</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark font-bold px-2 py-1">OUTPUT</span>
                                                        }
                                                    </td>
                                                    <td class="font-bold text-slate-800">@item.particulars</td>
                                                    <td class="font-bold text-indigo-600">@(item.quantity?.ToString() ?? "0") @item.unit</td>
                                                    <td class="text-slate-700">@(string.IsNullOrWhiteSpace(item.remarks) ? "—" : item.remarks)</td>
                                                    <td class="text-slate-600">@GetAddedByText(item.usercode)</td>
                                                    <td style="text-align: center; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit row" @onclick="() => StartEditIo(item)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Delete record" @onclick="() => DeleteInputOutputAsync(item.io_id)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }

                                        <!-- 2. Active New Input Row (Always at bottom, auto-saves on Enter) -->
                                        <tr class="table-inline-entry-row active-new-row">
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span class="badge-new-entry" title="Next Entry Row">@sNo</span>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <div class="inline-time-shift-wrap">
                                                    <input type="text"
                                                           class="inline-table-input time-input"
                                                           placeholder="05:45 PM"
                                                           @bind="newIoTime"
                                                           title="Time" />
                                                    <select class="inline-table-select shift-select"
                                                            @bind="newIoShift"
                                                            title="Shift">
                                                        <option value="MORNING">Morning</option>
                                                        <option value="AFTERNOON">Afternoon</option>
                                                        <option value="EVENING">Evening</option>
                                                        <option value="NIGHT">Night</option>
                                                    </select>
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <select class="inline-table-select font-bold"
                                                        @bind="newIoType"
                                                        title="IO Type">
                                                    <option value="INPUT">INPUT</option>
                                                    <option value="OUTPUT">OUTPUT</option>
                                                </select>
                                            </td>
                                            <td style="vertical-align: middle; position: relative;">
                                                <div class="custom-dropdown-wrap position-relative">
                                                    <input @ref="newIoParticularRef"
                                                           type="text"
                                                           class="inline-table-input font-bold text-indigo-700"
                                                           placeholder="e.g. IV Fluid / Urine"
                                                           value="@newIoParticular"
                                                           @oninput="OnNewIoParticularInput"
                                                           @onfocus="OnNewIoParticularFocus"
                                                           @onkeydown="HandleNewIoParticularKeyDown"
                                                           autocomplete="off"
                                                           title="Type particulars & press Enter" />

                                                    @if (isParticularsDropdownOpen)
                                                    {
                                                        <div class="custom-particulars-dropdown shadow-lg" @onclick:stopPropagation>
                                                            @{
                                                                var items = GetFilteredParticulars().ToList();
                                                            }
                                                            @if (items.Any())
                                                            {
                                                                @for (int idx = 0; idx < items.Count; idx++)
                                                                {
                                                                    var itm = items[idx];
                                                                    var isHigh = idx == highlightedParticularIndex;
                                                                    <div class="particular-dropdown-item @(isHigh ? "highlighted" : "")"
                                                                         @onclick="() => SelectNewIoParticular(itm.particular_name)"
                                                                         @onmouseenter="() => highlightedParticularIndex = idx">
                                                                        <span class="particular-item-name">@itm.particular_name</span>
                                                                        @if (!string.IsNullOrWhiteSpace(itm.io_type))
                                                                        {
                                                                            <span class="particular-type-tag type-@itm.io_type.ToLower()">@itm.io_type</span>
                                                                        }
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <div style="display: flex; align-items: center; gap: 3px;">
                                                    <input type="number"
                                                           class="inline-table-input font-bold text-indigo-700 text-center"
                                                           placeholder="500"
                                                           @bind="newIoQty"
                                                           @bind:event="oninput"
                                                           style="width: 70px;"
                                                           title="Quantity (ml)" />
                                                    <span class="text-slate-500 font-bold" style="font-size: 11px;">ml</span>
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="text"
                                                       class="inline-table-input remarks-input"
                                                       placeholder="Type remarks & press Enter to save..."
                                                       @bind="newIoRemarks"
                                                       @bind:event="oninput"
                                                       @onkeydown="HandleNewIoKeyDown"
                                                       title="Remarks / Findings" />
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <div class="inline-recorded-by">
                                                    <span class="user-chip-mini" title="Logged-in User">
                                                        <i class="bi bi-person-check-fill me-1 text-indigo-500"></i>
                                                        @(string.IsNullOrWhiteSpace(currentUserName) ? "Duty Staff" : currentUserName)
                                                    </span>
                                                </div>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <button type="button" class="badge-enter-key" @onclick="SaveNewIoInlineAsync" title="Save record (or press Enter on keyboard)">
                                                    <i class="bi bi-arrow-return-left"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 4: SERVICE                                                      *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "service")
                {
                    <div class="tab-section-flow">
                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-person-gear text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Nursing Services Rendered</span>
                                    <span class="table-pill-count ms-1">@serviceList.Count Records</span>
                                </div>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 55px; text-align: center;">S.NO.</th>
                                            <th style="width: 175px; white-space: nowrap;">TIME &amp; SHIFT</th>
                                            <th style="width: 220px; white-space: nowrap;">SERVICE NAME</th>
                                            <th style="min-width: 160px;">ACTION TAKEN</th>
                                            <th style="min-width: 160px;">REMARKS</th>
                                            <th style="width: 125px; text-align: center; white-space: nowrap;">RENDERED BY</th>
                                            <th style="width: 95px; text-align: center; white-space: nowrap;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sNo = 1;
                                        }
                                        <!-- 1. Previously Saved Rows in Chronological Order -->
                                        @foreach (var s in serviceList.OrderBy(x => x.created_at))
                                        {
                                            var rowSNo = sNo++;
                                            var isEditing = editingServiceId == s.service_id;
                                            if (isEditing)
                                            {
                                                <tr class="table-inline-entry-row is-inline-editing">
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <span class="badge-edit-mode">EDIT @rowSNo</span>
                                                    </td>
                                                    <td style="vertical-align: middle; white-space: nowrap;">
                                                        <div class="inline-time-shift-compact">
                                                            <span class="font-bold text-slate-800" style="font-size: 11.5px; min-width: 60px;">@FormatEntryTime(s.entry_time, s.created_at)</span>
                                                            <select class="inline-table-select shift-select-mini" @bind="serviceShift">
                                                                <option value="MORNING">Morning</option>
                                                                <option value="AFTERNOON">Afternoon</option>
                                                                <option value="EVENING">Evening</option>
                                                                <option value="NIGHT">Night</option>
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="text" class="inline-table-input font-bold" @bind="serviceName" @bind:event="oninput" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="text" class="inline-table-input" @bind="serviceAction" @bind:event="oninput" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="text" class="inline-table-input remarks-input" placeholder="Remarks & Enter to update..." @bind="serviceRemarks" @bind:event="oninput" @onkeydown="(e) => HandleExistingServiceKeyDown(e, s)" />
                                                    </td>
                                                    <td style="vertical-align: middle; text-align: center; white-space: nowrap;">
                                                        <div class="d-flex justify-content-center">
                                                            <span class="user-chip-mini">@GetAddedByText(s.usercode)</span>
                                                        </div>
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center gap-1">
                                                            <button type="button" class="btn-action-icon btn-action-save" title="Save changes" @onclick="() => SaveExistingServiceAsync(s)">
                                                                <i class="bi bi-check-circle-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Cancel Edit" @onclick="CancelEditService">
                                                                <i class="bi bi-x-circle-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr class="lc-table-row saved-row" @ondblclick="() => StartEditService(s)" title="Double-click to edit row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@rowSNo</td>
                                                    <td style="white-space: nowrap; vertical-align: middle;">
                                                        <div class="d-flex align-items-center gap-2 flex-nowrap" style="white-space: nowrap;">
                                                            <span class="font-bold text-slate-800" style="font-size: 11.5px;">@FormatEntryTime(s.entry_time, s.created_at)</span>
                                                            <span class="tag-shift-indigo">@s.shift</span>
                                                        </div>
                                                    </td>
                                                    <td style="white-space: nowrap; vertical-align: middle;">
                                                        <span class="font-bold text-indigo-600" style="font-size: 12px;">@s.service_name</span>
                                                    </td>
                                                    <td class="text-slate-800" style="vertical-align: middle; line-height: 1.4; font-size: 11.5px;">
                                                        @(string.IsNullOrWhiteSpace(s.action) ? "—" : s.action)
                                                    </td>
                                                    <td class="text-slate-700" style="vertical-align: middle; line-height: 1.4; font-size: 11.5px;">
                                                        @(string.IsNullOrWhiteSpace(s.remarks) ? "—" : s.remarks)
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <div class="d-flex justify-content-center">
                                                            <span class="user-chip-mini">@GetAddedByText(s.usercode)</span>
                                                        </div>
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit row" @onclick="() => StartEditService(s)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Delete record" @onclick="() => DeleteServiceAsync(s.service_id)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }

                                        <!-- 2. Active New Input Row (Always at bottom, auto-saves on Enter) -->
                                        <tr class="table-inline-entry-row active-new-row">
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span class="badge-new-entry" title="Next Entry Row">@sNo</span>
                                            </td>
                                            <td style="vertical-align: middle; white-space: nowrap;">
                                                <div class="inline-time-shift-compact">
                                                    <input type="text"
                                                           class="inline-table-input time-input-mini"
                                                           placeholder="05:45 PM"
                                                           @bind="newServiceTime"
                                                           style="width: 80px; height: 32px; font-size: 11.5px;"
                                                           title="Time" />
                                                    <select class="inline-table-select shift-select-mini"
                                                            @bind="newServiceShift"
                                                            style="height: 32px; font-size: 11px;"
                                                            title="Shift">
                                                        <option value="MORNING">Morning</option>
                                                        <option value="AFTERNOON">Afternoon</option>
                                                        <option value="EVENING">Evening</option>
                                                        <option value="NIGHT">Night</option>
                                                    </select>
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle; position: relative; white-space: nowrap;">
                                                <div class="custom-dropdown-wrap position-relative" style="width: 100%;">
                                                    <input @ref="newServiceNameRef"
                                                           type="text"
                                                           class="inline-table-input font-bold text-indigo-700"
                                                           placeholder="e.g. Wound Dressing / Suction"
                                                           value="@newServiceName"
                                                           @oninput="OnNewServiceNameInput"
                                                           @onfocus="OnNewServiceNameFocus"
                                                           @onkeydown="HandleNewServiceNameKeyDown"
                                                           autocomplete="off"
                                                           style="width: 100%; height: 32px; font-size: 11.5px;"
                                                           title="Service Name" />

                                                    @if (isServiceDropdownOpen)
                                                    {
                                                        <div class="custom-particulars-dropdown shadow-lg" @onclick:stopPropagation>
                                                            @{
                                                                var sItems = GetFilteredServices().ToList();
                                                            }
                                                            @if (sItems.Any())
                                                            {
                                                                @for (int idx = 0; idx < sItems.Count; idx++)
                                                                {
                                                                    var sitm = sItems[idx];
                                                                    var isHigh = idx == highlightedServiceIndex;
                                                                    <div class="particular-dropdown-item @(isHigh ? "highlighted" : "")"
                                                                         @onclick="() => SelectNewServiceName(sitm.service_name)"
                                                                         @onmouseenter="() => highlightedServiceIndex = idx">
                                                                        <span class="particular-item-name">@sitm.service_name</span>
                                                                        <span class="particular-type-tag type-input">SERVICE</span>
                                                                    </div>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <div class="particular-no-results">
                                                                    <i class="bi bi-search me-1"></i> No services found
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="text"
                                                       class="inline-table-input"
                                                       placeholder="e.g. Dressing changed, sterile dressing done"
                                                       @bind="newServiceAction"
                                                       @bind:event="oninput"
                                                       style="width: 100%; height: 32px; font-size: 11.5px;"
                                                       title="Action Taken" />
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="text"
                                                       class="inline-table-input remarks-input"
                                                       placeholder="Type remarks & press Enter to save..."
                                                       @bind="newServiceRemarks"
                                                       @bind:event="oninput"
                                                       @onkeydown="HandleNewServiceKeyDown"
                                                       style="width: 100%; height: 32px; font-size: 11.5px;"
                                                       title="Remarks / Observations" />
                                            </td>
                                            <td style="vertical-align: middle; text-align: center; white-space: nowrap;">
                                                <div class="d-flex justify-content-center">
                                                    <span class="user-chip-mini" title="Logged-in User">
                                                        <i class="bi bi-person-check-fill me-1 text-indigo-500"></i>
                                                        @(string.IsNullOrWhiteSpace(currentUserName) ? "Duty Staff" : currentUserName)
                                                    </span>
                                                </div>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                <button type="button" class="badge-enter-key" @onclick="SaveNewServiceInlineAsync" title="Save record (or press Enter on keyboard)">
                                                    <i class="bi bi-arrow-return-left"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

