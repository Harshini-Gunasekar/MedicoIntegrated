    width: 100%;
}

.lc-table th {
    padding: 0.55rem 0.55rem;
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.25;
}

.lc-table thead th {
