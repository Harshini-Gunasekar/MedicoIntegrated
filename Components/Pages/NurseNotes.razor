                            <div class="nn-form-group">
                                <label class="nn-label">Depth (cm)</label>
                                <input type="number" step="0.1" class="nn-input" @bind="noteForm.wound_depth" />
                            </div>
                        </div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Wound Condition</label>
                                <select class="nn-select" @bind="noteForm.wound_condition">
                                    <option value="">-- Condition --</option>
                                    <option value="CLEAN">Clean</option>
                                    <option value="INFECTED">Infected</option>
                                    <option value="NECROTIC">Necrotic</option>
                                    <option value="GRANULATING">Granulating</option>
                                    <option value="SLOUGHY">Sloughy</option>
