    private async Task SaveScheduleAsync()
    {
        if (selectedPatient == null) return;
        if (string.IsNullOrWhiteSpace(scheduleName))
        {
            ToastService.ShowWarning("Please enter schedule task / item name.");
            return;
        }

        isSubmitting = true;
        try
        {
            var formattedTime = scheduleTime.HasValue ? scheduleTime.Value.ToString("HH:mm:ss") : "08:00:00";
            var formattedDate = scheduleDate.HasValue ? scheduleDate.Value.ToString("yyyy-MM-dd") : DateTime.UtcNow.ToIndianTime().ToString("yyyy-MM-dd");

            if (editingScheduleId.HasValue)
            {
                var req = new UpdateScheduleRequest
                {
                    schedule_id = editingScheduleId.Value,
                    shift = scheduleShift,
                    scheduled_date = formattedDate,
                    scheduled_time = formattedTime,
                    item_type = scheduleType,
                    item_name = scheduleName.Trim(),
                    instructions = string.IsNullOrWhiteSpace(scheduleInstructions) ? null : scheduleInstructions.Trim(),
                    status = scheduleStatus,
                    remarks = string.IsNullOrWhiteSpace(scheduleRemarks) ? null : scheduleRemarks.Trim()
                };
                var (ok, msg) = await NurseNotesService.UpdateScheduleAsync(req, DefaultTenant, currentUserCode);
                if (ok)
                {
                    ToastService.ShowSuccess("Schedule item updated.");
                    CancelEditSchedule();
                    scheduleList = await NurseNotesService.GetSchedulesAsync(selectedPatient.ip_id, DefaultTenant, currentUserCode);
                    EvaluateUpcomingSchedules();
                }
                else ToastService.ShowError(msg);
            }
            else
            {
                var req = new AddScheduleRequest
                {
                    ip_id = selectedPatient.ip_id,
                    custid = selectedPatient.custid,
                    shift = scheduleShift,
                    scheduled_date = formattedDate,
                    scheduled_time = formattedTime,
                    item_type = scheduleType,
                    item_name = scheduleName.Trim(),
                    instructions = string.IsNullOrWhiteSpace(scheduleInstructions) ? null : scheduleInstructions.Trim(),
                    status = scheduleStatus,
                    remarks = string.IsNullOrWhiteSpace(scheduleRemarks) ? null : scheduleRemarks.Trim()
                };
                var (ok, msg) = await NurseNotesService.AddScheduleAsync(req, DefaultTenant, currentUserCode);
                if (ok)
                {
                    ToastService.ShowSuccess("Schedule item added.");
                    scheduleName = "";
                    scheduleInstructions = "";
                    scheduleRemarks = "";
                    scheduleStatus = "PENDING";
                    scheduleDate = DateTime.Today;
                    scheduleTime = new TimeOnly(8, 0, 0);
