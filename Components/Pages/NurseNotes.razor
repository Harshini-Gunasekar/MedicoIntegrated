    private IEnumerable<IoParticularsMasterModel> GetFilteredParticulars()
    {
        var list = ioParticularsMasterList.Where(p => p.is_active);

        // Filter by matching ioType (INPUT / OUTPUT / BOTH) if applicable
        if (!string.IsNullOrWhiteSpace(ioType))
        {
            var typeMatches = list.Where(p => string.Equals(p.io_type, ioType, StringComparison.OrdinalIgnoreCase) || string.Equals(p.io_type, "BOTH", StringComparison.OrdinalIgnoreCase));
            if (typeMatches.Any())
            {
                list = typeMatches;
            }
        }

        if (!string.IsNullOrWhiteSpace(ioParticulars))
        {
            var q = ioParticulars.Trim().ToLower();
            list = list.Where(p => !string.IsNullOrWhiteSpace(p.particular_name) && p.particular_name.ToLower().Contains(q));
        }

        return list;
    }

