@page "/ip/nurse-notes"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using medico_backend.Model
@using Medico_Backend.Model
@using Booking.Services
@using Booking.Models
@using Booking.Helpers

@inject NurseNotesService NurseNotesService
@inject NurseMasterService NurseMasterService
@inject TestMasterService TestMasterService
@inject IpRegistrationService IpService
@inject DoctorService DoctorService
@inject AppointmentBookingService AppointmentBookingService
@inject CaseSheetService CaseSheetService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory ClientFactory
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<PageTitle>Nurse Notes — IP Care</PageTitle>

<div class="nn-page">

    @* ══════════════════════════════════════════════════════ HEADER ══════════════════════════════════ *@
    <div class="nn-header">
        <div class="nn-header-left">
            <div class="nn-header-icon">
                <i class="bi bi-clipboard2-pulse-fill"></i>
            </div>
            <div>
                <h1 class="nn-header-title">Nurse Notes</h1>
                <p class="nn-header-sub">Inpatient Clinical Nursing Documentation</p>
            </div>
        </div>
        <div class="nn-header-actions">
            <button class="nn-btn nn-btn-outline" @onclick="LoadPatientsAsync" disabled="@isLoadingPatients">
                <i class="bi bi-arrow-clockwise @(isLoadingPatients ? "nn-spin" : "")"></i>
                Refresh
            </button>
            @if (selectedPatient != null)
            {
                <button class="nn-btn nn-btn-primary" @onclick="OpenAddNoteModal">
                    <i class="bi bi-plus-circle-fill"></i>
                    Add Note
                </button>
            }
        </div>
    </div>

    @* ══════════════════════════════════════════════════════ BODY ══════════════════════════════════ *@
    <div class="nn-body">

        @* ── LEFT PANEL: Patient List ── *@
        <div class="nn-patient-panel">
            <div class="nn-panel-header">
                <span class="nn-panel-title"><i class="bi bi-people-fill"></i> IP Patients</span>
                <span class="nn-badge">@GetFilteredPatients().Count()</span>
            </div>

            <div class="nn-search-box">
                <i class="bi bi-search nn-search-icon"></i>
                <input type="text" class="nn-search-input" placeholder="Search patient..." 
                       @bind="patientSearch" @bind:event="oninput" />
            </div>

            <div class="nn-patient-list">
                @if (isLoadingPatients)
                {
                    <div class="nn-state-center">
                        <span class="spinner-border text-primary" style="width:2rem;height:2rem;"></span>
                        <p style="margin-top:.75rem;font-size:.82rem;color:#64748b;">Loading patients…</p>
                    </div>
                }
                else if (!GetFilteredPatients().Any())
                {
                    <div class="nn-state-center">
                        <i class="bi bi-person-exclamation" style="font-size:2rem;color:#cbd5e1;"></i>
                        <p style="margin-top:.5rem;font-size:.82rem;color:#94a3b8;">No patients found</p>
                    </div>
                }
                else
                {
                    @foreach (var p in GetFilteredPatients())
                    {
                        var isActive = selectedPatient?.ip_id == p.ip_id;
                        <div class="nn-patient-card @(isActive ? "active" : "")" @onclick="() => SelectPatient(p)">
                            <div class="nn-pat-avatar">@GetInitials(p.patient_name)</div>
                            <div class="nn-pat-info">
                                <div class="nn-pat-name">@p.patient_name</div>
                                <div class="nn-pat-meta">
                                    <span><i class="bi bi-person-badge"></i> @p.ip_no</span>
                                    @if (!string.IsNullOrWhiteSpace(p.mobile))
                                    {
                                        <span><i class="bi bi-telephone"></i> @p.mobile</span>
                                    }
                                </div>
                            </div>
                            <div class="nn-pat-status @(p.ip_status == "ADMITTED" ? "admitted" : "discharged")">
                                @(p.ip_status == "ADMITTED" ? "Admitted" : "Discharged")
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* ── MAIN CONTENT AREA ── *@
        <div class="nn-main">
            @if (selectedPatient == null)
            {
                <div class="nn-empty-state">
                    <div class="nn-empty-icon">
                        <i class="bi bi-clipboard2-pulse"></i>
                    </div>
                    <h3>Select a Patient</h3>
                    <p>Choose a patient from the list to view and manage nursing notes.</p>
                </div>
            }
            else
            {
                @* Patient Info Bar *@
                <div class="nn-patient-bar">
                    <div class="nn-patient-bar-info">
                        <div class="nn-patient-bar-avatar">@GetInitials(selectedPatient.patient_name)</div>
                        <div>
                            <div class="nn-patient-bar-name">@selectedPatient.patient_name</div>
                            <div class="nn-patient-bar-meta">
                                IP No: <strong>@selectedPatient.ip_no</strong> &nbsp;|&nbsp;
                                Admitted: <strong>@selectedPatient.admitdate.ToString("dd MMM yyyy")</strong>
                                @if (selectedPatient.dcode > 0)
                                {
                                    <span> &nbsp;|&nbsp; Dr: <strong>@GetDoctorName(selectedPatient.dcode)</strong></span>
                                }
                            </div>
                        </div>
                    </div>
                    <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;">
                        <select class="nn-filter-select" @bind="noteTypeFilter" @bind:after="FilterNotesAsync">
                            <option value="">All Note Types</option>
                            <option value="DRESSING">Dressing / Wound</option>
                            <option value="MEDICATION">Medication</option>
                            <option value="PROCEDURE">Procedure</option>
                            <option value="INFUSION">Infusion</option>
                            <option value="OXYGEN">Oxygen</option>
                            <option value="INTAKE_OUTPUT">Intake / Output</option>
                            <option value="GENERAL">General</option>
                            <option value="SKIN_ASSESSMENT">Skin Assessment</option>
                            <option value="CATHETER">Catheter Care</option>
                            <option value="RESTRAINT">Restraint</option>
                            <option value="ISOLATION">Isolation</option>
                        </select>
                    </div>
                </div>

                @* Tab navigation *@
                <div class="nn-tabs">
                    <button class="nn-tab @(activeMainTab == "notes" ? "active" : "")" @onclick='() => SwitchTab("notes")'>
                        <i class="bi bi-clipboard2-pulse"></i> Nursing Notes
                    </button>
                    <button class="nn-tab @(activeMainTab == "casesheet" ? "active" : "")" @onclick='() => SwitchTab("casesheet")'>
                        <i class="bi bi-file-earmark-medical"></i> OP Case Sheet
                    </button>
                    <button class="nn-tab @(activeMainTab == "vitals" ? "active" : "")" @onclick='() => SwitchTab("vitals")'>
                        <i class="bi bi-heart-pulse"></i> Vitals
                    </button>
                </div>

                <div class="nn-tab-content">

                    @* ═════════════ NOTES TAB ═════════════ *@
                    @if (activeMainTab == "notes")
                    {
                        @if (isLoadingNotes)
                        {
                            <div class="nn-state-center">
                                <span class="spinner-border text-primary" style="width:2.5rem;height:2.5rem;"></span>
                                <p style="margin-top:1rem;color:#64748b;">Loading nursing notes…</p>
                            </div>
                        }
                        else if (!nurseNotes.Any())
                        {
                            <div class="nn-empty-state" style="padding:3rem;">
                                <i class="bi bi-clipboard2" style="font-size:3rem;color:#cbd5e1;"></i>
                                <h4 style="margin-top:1rem;color:#94a3b8;">No nursing notes recorded</h4>
                                <p style="color:#94a3b8;font-size:.85rem;">Click <strong>Add Note</strong> to create the first entry.</p>
                            </div>
                        }
                        else
                        {
                            <div class="nn-notes-list">
                                @foreach (var note in nurseNotes.OrderByDescending(n => n.note_datetime))
                                {
                                    <div class="nn-note-card @GetNoteStatusClass(note.note_status) @(note.isdeleted ? "deleted" : "")">
                                        @* Note Header *@
                                        <div class="nn-note-header">
                                            <div class="nn-note-type-badge @GetNoteTypeBadgeClass(note.note_type)">
                                                <i class="bi @GetNoteTypeIcon(note.note_type)"></i>
                                                @FormatNoteType(note.note_type)
                                            </div>
                                            <div class="nn-note-meta">
                                                @if (!string.IsNullOrWhiteSpace(note.shift))
                                                {
                                                    <span class="nn-shift-badge @note.shift.ToLower()">
                                                        <i class="bi @GetShiftIcon(note.shift)"></i> @note.shift
                                                    </span>
                                                }
                                                <span class="nn-note-time">
                                                    <i class="bi bi-clock"></i>
                                                    @(DateTimeHelper.ConvertUtcToIst((DateTime?)note.note_datetime)?.ToString("dd MMM yyyy hh:mm tt") ?? note.note_datetime.ToString("dd MMM yyyy hh:mm tt"))
                                                </span>
                                                <div class="nn-note-status-dot @note.note_status.ToLower()">@note.note_status</div>
                                            </div>
                                        </div>

                                        @* Note Body — show only fields that have values *@
                                        <div class="nn-note-body">
                                            @RenderNoteFields(note)
                                        </div>

                                        @* Note Footer Actions *@
                                        @if (!note.isdeleted)
                                        {
                                            <div class="nn-note-footer">
                                                @if (note.note_status != "CANCELLED")
                                                {
                                                    <button class="nn-action-btn edit" @onclick="() => OpenEditNoteModal(note)" title="Edit">
                                                        <i class="bi bi-pencil-fill"></i> Edit
                                                    </button>
                                                }
                                                @if (note.verified_by == null && note.note_status != "CANCELLED")
                                                {
                                                    <button class="nn-action-btn verify" @onclick="() => VerifyNote(note)" title="Verify">
                                                        <i class="bi bi-patch-check-fill"></i> Verify
                                                    </button>
                                                }
                                                else if (note.verified_by != null)
                                                {
                                                    <span class="nn-verified-badge"><i class="bi bi-patch-check-fill"></i> Verified</span>
                                                }
                                                @if (note.note_status != "CANCELLED")
                                                {
                                                    <button class="nn-action-btn cancel" @onclick="() => ConfirmCancelNote(note)" title="Cancel">
                                                        <i class="bi bi-x-circle-fill"></i> Cancel
                                                    </button>
                                                }
                                                <button class="nn-action-btn delete" @onclick="() => ConfirmDeleteNote(note)" title="Delete">
                                                    <i class="bi bi-trash3-fill"></i> Delete
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }

                    @* ═════════════ CASE SHEET TAB ═════════════ *@
                    else if (activeMainTab == "casesheet")
                    {
                        @if (isLoadingCaseSheet)
                        {
                            <div class="nn-state-center">
                                <span class="spinner-border text-primary" style="width:2.5rem;height:2.5rem;"></span>
                                <p style="margin-top:1rem;color:#64748b;">Loading case sheet…</p>
                            </div>
                        }
                        else if (caseSheet == null)
                        {
                            <div class="nn-empty-state" style="padding:3rem;">
                                <i class="bi bi-file-earmark-x" style="font-size:3rem;color:#cbd5e1;"></i>
                                <h4 style="margin-top:1rem;color:#94a3b8;">No Case Sheet Found</h4>
                                <p style="color:#94a3b8;font-size:.85rem;">No OP case sheet has been recorded for this patient.</p>
                            </div>
                        }
                        else
                        {
                            <div class="nn-casesheet-preview">
                                <div class="nn-cs-header">
                                    <div>
                                        <div class="nn-cs-patient">Patient: <strong>@selectedPatient?.patient_name</strong></div>
                                        <div class="nn-cs-date">
                                            Date: @(caseSheet.visit_date.HasValue ? caseSheet.visit_date.Value.ToString("dd-MMM-yyyy") : "-")
                                        </div>
                                    </div>
                                    <span class="nn-cs-status @caseSheet.sheet_status?.ToLower()">@caseSheet.sheet_status</span>
                                </div>

                                <div class="nn-cs-body">
                                    @* Chief Complaint *@
                                    @if (!string.IsNullOrWhiteSpace(caseSheet.chief_complaint))
                                    {
                                        <div class="nn-cs-section">
                                            <div class="nn-cs-section-label">Chief Complaint</div>
                                            <div class="nn-cs-section-value">@caseSheet.chief_complaint</div>
                                        </div>
                                    }

                                    @* Symptoms *@
                                    @if (!string.IsNullOrWhiteSpace(caseSheet.symptoms))
                                    {
                                        <div class="nn-cs-section">
                                            <div class="nn-cs-section-label">Symptoms</div>
                                            <div class="nn-cs-section-value">@caseSheet.symptoms</div>
                                        </div>
                                    }

                                    @* Symptom List *@
                                    @if (caseSheet.symptom_list != null && caseSheet.symptom_list.Any())
                                    {
                                        <div class="nn-cs-section">
                                            <div class="nn-cs-section-label">Symptom List</div>
                                            <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                                                @foreach (var s in caseSheet.symptom_list)
                                                {
                                                    <span class="nn-cs-chip">@s.symptom_text @(!string.IsNullOrWhiteSpace(s.severity) ? $"({s.severity})" : "")</span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @* Examination *@
                                    @if (!string.IsNullOrWhiteSpace(caseSheet.examination))
                                    {
                                        <div class="nn-cs-section">
                                            <div class="nn-cs-section-label">Clinical Examination</div>
                                            <div class="nn-cs-section-value">@caseSheet.examination</div>
                                        </div>
                                    }

                                    @* Diagnosis *@
                                    @if (caseSheet.diagnosis_list != null && caseSheet.diagnosis_list.Any())
                                    {
                                        <div class="nn-cs-section">
                                            <div class="nn-cs-section-label">Diagnosis (ICD-10)</div>
                                            <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                                                @foreach (var d in caseSheet.diagnosis_list)
                                                {
                                                    <span class="nn-cs-chip diagnosis">@d.icd_code — @d.icd_description</span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @* Prescription *@
                                    @if (caseSheet.prescription?.items != null && caseSheet.prescription.items.Any())
                                    {
                                        <div class="nn-cs-section">
                                            <div class="nn-cs-section-label">Prescription</div>
                                            <table class="nn-cs-table">
                                                <thead>
                                                    <tr><th>#</th><th>Drug</th><th>M/A/E/N</th><th>Route</th><th>Days</th></tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var rx in caseSheet.prescription.items)
                                                    {
                                                        <tr>
                                                            <td>@rx.sno</td>
                                                            <td>@rx.drug_name</td>
                                                            <td>@rx.morning-@rx.afternoon-@rx.evening-@rx.night</td>
                                                            <td>@rx.route</td>
                                                            <td>@(rx.days.HasValue ? $"{rx.days} d" : "-")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    @* Investigations *@
                                    @if (caseSheet.investigation?.tests != null && caseSheet.investigation.tests.Any())
                                    {
                                        <div class="nn-cs-section">
                                            <div class="nn-cs-section-label">Investigations</div>
                                            <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                                                @foreach (var t in caseSheet.investigation.tests)
                                                {
                                                    <span class="nn-cs-chip inv">@t.test_name</span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @* Advise *@
                                    @if (!string.IsNullOrWhiteSpace(caseSheet.advise))
                                    {
                                        <div class="nn-cs-section">
                                            <div class="nn-cs-section-label">Advise / Recommendations</div>
                                            <div class="nn-cs-section-value">@caseSheet.advise</div>
                                        </div>
                                    }

                                    @* Follow Up *@
                                    @if (caseSheet.followup_date.HasValue || !string.IsNullOrWhiteSpace(caseSheet.followup_notes))
                                    {
                                        <div class="nn-cs-section">
                                            <div class="nn-cs-section-label">Follow Up</div>
                                            <div style="display:flex;gap:1rem;flex-wrap:wrap;">
                                                @if (caseSheet.followup_date.HasValue)
                                                {
                                                    <span class="nn-cs-chip fu"><i class="bi bi-calendar-event"></i> @caseSheet.followup_date.Value.ToString("dd MMM yyyy")</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(caseSheet.followup_notes))
                                                {
                                                    <span class="nn-cs-section-value">@caseSheet.followup_notes</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }

                    @* ═════════════ VITALS TAB ═════════════ *@
                    else if (activeMainTab == "vitals")
                    {
                        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem; padding-bottom:0.5rem; border-bottom:1px solid #e2e8f0;">
                            <h5 style="margin:0; font-weight:700; color:#0f172a; font-size:0.95rem;">
                                <i class="bi bi-heart-pulse-fill text-danger me-1"></i> Recorded Patient Vitals
                            </h5>
                            <button class="nn-btn nn-btn-primary" style="padding:0.4rem 0.85rem; font-size:0.85rem;" @onclick="OpenAddVitalsModal">
                                <i class="bi bi-plus-lg me-1"></i> Add Vitals
                            </button>
                        </div>

                        @if (isLoadingVitals)
                        {
                            <div class="nn-state-center">
                                <span class="spinner-border text-primary" style="width:2.5rem;height:2.5rem;"></span>
                                <p style="margin-top:1rem;color:#64748b;">Loading vitals…</p>
                            </div>
                        }
                        else if (vitalsList == null || !vitalsList.Any())
                        {
                            <div class="nn-empty-state" style="padding:3rem;">
                                <i class="bi bi-heart-pulse" style="font-size:3rem;color:#cbd5e1;"></i>
                                <h4 style="margin-top:1rem;color:#94a3b8;">No Vitals Recorded</h4>
                                <p style="color:#94a3b8;font-size:.85rem;margin-bottom:1rem;">No vitals have been recorded for this patient.</p>
                                <button class="nn-btn nn-btn-primary" @onclick="OpenAddVitalsModal">
                                    <i class="bi bi-plus-lg me-1"></i> Add Vitals Now
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="nn-vitals-grid">
                                @foreach (var v in vitalsList.OrderByDescending(v => v.created_at))
                                {
                                    <div class="nn-vitals-card">
                                        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.75rem; padding-bottom:0.5rem; border-bottom:1px dashed #e2e8f0;">
                                            <div class="nn-vitals-card-time" style="margin-bottom:0;">
                                                <i class="bi bi-clock-history"></i>
                                                @(DateTimeHelper.ConvertUtcToIst((DateTime?)v.created_at)?.ToString("dd MMM yyyy hh:mm tt") ?? v.created_at.ToString("g"))
                                            </div>
                                            <div style="display:flex; align-items:center; gap:0.25rem;">
                                                <button type="button" class="btn btn-sm btn-outline-primary" style="padding:0.25rem 0.45rem; font-size:0.8rem; border-radius:6px; line-height:1;" title="Edit Vitals" @onclick="() => OpenEditVitalsModal(v)">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="nn-vitals-metrics">
                                            @if (v.bp_systolic.HasValue && v.bp_diastolic.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#fee2e2;color:#dc2626;"><i class="bi bi-heart-fill"></i></span>
                                                    <div><div class="nn-vit-label">BP</div><div class="nn-vit-value">@v.bp_systolic/@v.bp_diastolic <small>mmHg</small></div></div>
                                                </div>
                                            }
                                            @if (v.pulse_rate.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#fce7f3;color:#db2777;"><i class="bi bi-activity"></i></span>
                                                    <div><div class="nn-vit-label">Pulse</div><div class="nn-vit-value">@v.pulse_rate <small>bpm</small></div></div>
                                                </div>
                                            }
                                            @if (v.temperature_f.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#fef3c7;color:#d97706;"><i class="bi bi-thermometer-half"></i></span>
                                                    <div><div class="nn-vit-label">Temp</div><div class="nn-vit-value">@v.temperature_f <small>°F</small></div></div>
                                                </div>
                                            }
                                            @if (v.spo2.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#dbeafe;color:#2563eb;"><i class="bi bi-droplet-fill"></i></span>
                                                    <div><div class="nn-vit-label">SpO2</div><div class="nn-vit-value">@v.spo2 <small>%</small></div></div>
                                                </div>
                                            }
                                            @if (v.respiratory_rate.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#d1fae5;color:#059669;"><i class="bi bi-lungs-fill"></i></span>
                                                    <div><div class="nn-vit-label">RR</div><div class="nn-vit-value">@v.respiratory_rate <small>/min</small></div></div>
                                                </div>
                                            }
                                            @if (v.height_cm.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#e0f2fe;color:#0284c7;"><i class="bi bi-ruler"></i></span>
                                                    <div><div class="nn-vit-label">Height</div><div class="nn-vit-value">@v.height_cm <small>cm</small></div></div>
                                                </div>
                                            }
                                            @if (v.weight_kg.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#ede9fe;color:#7c3aed;"><i class="bi bi-person-fill"></i></span>
                                                    <div><div class="nn-vit-label">Weight</div><div class="nn-vit-value">@v.weight_kg <small>kg</small></div></div>
                                                </div>
                                            }
                                            @if (v.bmi.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#e0e7ff;color:#4338ca;"><i class="bi bi-calculator-fill"></i></span>
                                                    <div><div class="nn-vit-label">BMI</div><div class="nn-vit-value">@v.bmi <small>kg/m²</small></div></div>
                                                </div>
                                            }
                                            @if (v.sugar_level.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#fef9c3;color:#ca8a04;"><i class="bi bi-droplet-half"></i></span>
                                                    <div><div class="nn-vit-label">Sugar</div><div class="nn-vit-value">@v.sugar_level <small>mg/dL</small></div></div>
                                                </div>
                                            }
                                            @if (v.hba1c.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#fef3c7;color:#b45309;"><i class="bi bi-pie-chart-fill"></i></span>
                                                    <div><div class="nn-vit-label">HbA1c</div><div class="nn-vit-value">@v.hba1c <small>%</small></div></div>
                                                </div>
                                            }
                                            @if (v.head_circumference_cm.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#f1f5f9;color:#475569;"><i class="bi bi-circle"></i></span>
                                                    <div><div class="nn-vit-label">Head Circ.</div><div class="nn-vit-value">@v.head_circumference_cm <small>cm</small></div></div>
                                                </div>
                                            }
                                            @if (v.waist_cm.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#f1f5f9;color:#475569;"><i class="bi bi-distribute-horizontal"></i></span>
                                                    <div><div class="nn-vit-label">Waist</div><div class="nn-vit-value">@v.waist_cm <small>cm</small></div></div>
                                                </div>
                                            }
                                            @if (v.hip_cm.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#f1f5f9;color:#475569;"><i class="bi bi-distribute-vertical"></i></span>
                                                    <div><div class="nn-vit-label">Hip</div><div class="nn-vit-value">@v.hip_cm <small>cm</small></div></div>
                                                </div>
                                            }
                                            @if (v.pain_scale.HasValue)
                                            {
                                                <div class="nn-vitals-metric">
                                                    <span class="nn-vit-icon" style="background:#fee2e2;color:#b91c1c;"><i class="bi bi-emoji-frown-fill"></i></span>
                                                    <div><div class="nn-vit-label">Pain</div><div class="nn-vit-value">@v.pain_scale <small>/10</small></div></div>
                                                </div>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(v.allergy_notes))
                                        {
                                            <div class="nn-vitals-allergy">
                                                <i class="bi bi-exclamation-triangle-fill"></i> Allergy: @v.allergy_notes
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }

                </div>
            }
        </div>

    </div>

</div>

@* ══════════════════════════════════════════════════════════ ADD/EDIT NOTE MODAL ══════════════════════════════════ *@
@if (showNoteModal)
{
    <div class="nn-modal-backdrop">
        <div class="nn-modal" @onclick:stopPropagation>
            <div class="nn-modal-header">
                <div class="nn-modal-title">
                    <i class="bi @(editingNote == null ? "bi-plus-circle-fill" : "bi-pencil-fill")"></i>
                    @(editingNote == null ? "Add Nurse Note" : "Edit Nurse Note")
                </div>
                <button class="nn-modal-close" @onclick="CloseNoteModal">×</button>
            </div>

            <div class="nn-modal-body">
                @* Category Selector Card *@
                <div class="nn-modal-card">
                    <label class="nn-label-bold"><i class="bi bi-grid-3x3-gap-fill text-primary"></i> Select Note Type <span class="nn-required">*</span></label>
                    <select class="nn-select" @bind="noteForm.note_type">
                        <option value="">-- Select Note Type --</option>
                        <option value="DRESSING">Dressing / Wound</option>
                        <option value="MEDICATION">Medication Administration</option>
                        <option value="PROCEDURE">Procedure</option>
                        <option value="INFUSION">IV Infusion</option>
                        <option value="OXYGEN">Oxygen Therapy</option>
                        <option value="INTAKE_OUTPUT">Intake / Output</option>
                        <option value="GENERAL">General / Patient Status</option>
                        <option value="SKIN_ASSESSMENT">Skin & Pressure Sore Assessment</option>
                        <option value="CATHETER">Catheter Care</option>
                        <option value="RESTRAINT">Restraint Monitoring</option>
                        <option value="ISOLATION">Isolation & Infection Control</option>
                    </select>
                </div>

                @* Shift Selector & Metadata Card *@
                <div class="nn-modal-card">
                    <div class="nn-form-row-2" style="margin-bottom:0.5rem;">
                        <div class="nn-form-group" style="margin-bottom:0;">
                            <label class="nn-label"><i class="bi bi-clock-history"></i> Select Shift</label>
                            <div class="nn-shift-pills">
                                <button type="button" class="nn-shift-pill @(noteForm.shift == "MORNING" ? "active morning" : "")" @onclick='() => noteForm.shift = "MORNING"'>
                                    <i class="bi bi-sunrise"></i> Morning
                                </button>
                                <button type="button" class="nn-shift-pill @(noteForm.shift == "AFTERNOON" ? "active afternoon" : "")" @onclick='() => noteForm.shift = "AFTERNOON"'>
                                    <i class="bi bi-sun"></i> Afternoon
                                </button>
                                <button type="button" class="nn-shift-pill @(noteForm.shift == "EVENING" ? "active evening" : "")" @onclick='() => noteForm.shift = "EVENING"'>
                                    <i class="bi bi-sunset"></i> Evening
                                </button>
                                <button type="button" class="nn-shift-pill @(noteForm.shift == "NIGHT" ? "active night" : "")" @onclick='() => noteForm.shift = "NIGHT"'>
                                    <i class="bi bi-moon-stars-fill"></i> Night
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="nn-form-row-2" style="margin-bottom:0; margin-top: 0.75rem;">
                        <div class="nn-form-group" style="margin-bottom:0;">
                            <label class="nn-label"><i class="bi bi-calendar-event"></i> Date & Time</label>
                            <input type="datetime-local" class="nn-input" @bind="noteDateTimeLocal" />
                        </div>
                        <div class="nn-form-group" style="margin-bottom:0;">
                            <label class="nn-label"><i class="bi bi-person-badge"></i> Given By (Nurse)</label>
                            <select class="nn-select" @bind="noteForm.given_by">
                                <option value="">-- Select Nurse --</option>
                                @if (nursesList != null && nursesList.Any())
                                {
                                    @foreach (var n in nursesList)
                                    {
                                        <option value="@n.ncode">@(string.IsNullOrWhiteSpace(n.nursename) ? (n.shortname ?? $"Nurse #{n.ncode}") : n.nursename)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                @* FALL RISK *@
                @if (noteForm.note_type == "FALL_RISK")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-exclamation-triangle-fill"></i> Fall Risk Details</div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Risk Score</label>
                                <input type="number" class="nn-input" placeholder="e.g. 45" @bind="noteForm.fall_risk_score" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Risk Level</label>
                                <select class="nn-select" @bind="noteForm.fall_risk_level">
                                    <option value="">-- Level --</option>
                                    <option value="LOW">Low</option>
                                    <option value="MODERATE">Moderate</option>
                                    <option value="HIGH">High</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Risk Scale</label>
                                <select class="nn-select" @bind="noteForm.fall_risk_scale">
                                    <option value="">-- Scale --</option>
                                    <option value="MORSE">Morse</option>
                                    <option value="HENDRICH_II">Hendrich II</option>
                                </select>
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Fall Precautions</label>
                                <textarea class="nn-textarea" rows="2" placeholder="e.g. Bed rails up, non-slip footwear…" @bind="noteForm.fall_precautions"></textarea>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Fall Occurred?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.fall_occurred" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.fall_occurred == true ? "Yes, incident occurred" : "No fall")</span>
                                </div>
                                @if (noteForm.fall_occurred == true)
                                {
                                    <textarea class="nn-textarea" rows="2" placeholder="Fall incident details…" @bind="noteForm.fall_incident_details" style="margin-top:.5rem;"></textarea>
                                }
                            </div>
                        </div>
                    </div>
                }

                @* DRESSING *@
                @if (noteForm.note_type == "DRESSING")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-bandaid-fill"></i> Dressing / Wound Details</div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Dressing Site</label>
                                <input type="text" class="nn-input" placeholder="e.g. Left lower abdomen" @bind="noteForm.dressing_site" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Wound Type</label>
                                <select class="nn-select" @bind="noteForm.wound_type">
                                    <option value="">-- Type --</option>
                                    <option value="SURGICAL">Surgical</option>
                                    <option value="TRAUMATIC">Traumatic</option>
                                    <option value="PRESSURE">Pressure</option>
                                    <option value="BURN">Burn</option>
                                    <option value="DIABETIC">Diabetic</option>
                                    <option value="VENOUS">Venous</option>
                                    <option value="OTHER">Other</option>
                                </select>
                            </div>
                        </div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Length (cm)</label>
                                <input type="number" step="0.1" class="nn-input" @bind="noteForm.wound_length" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Width (cm)</label>
                                <input type="number" step="0.1" class="nn-input" @bind="noteForm.wound_width" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Depth (cm)</label>
                                <input type="number" step="0.1" class="nn-input" @bind="noteForm.wound_depth" />
                            </div>
                        </div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Wound Condition</label>
                                <select class="nn-select" @bind="noteForm.wound_condition">
                                    <option value="">-- Condition --</option>
                                    <option value="CLEAN">Clean</option>
                                    <option value="INFECTED">Infected</option>
                                    <option value="NECROTIC">Necrotic</option>
                                    <option value="GRANULATING">Granulating</option>
                                    <option value="SLOUGHY">Sloughy</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Discharge</label>
                                <select class="nn-select" @bind="noteForm.wound_discharge">
                                    <option value="">-- Discharge --</option>
                                    <option value="NIL">Nil</option>
                                    <option value="MINIMAL_SEROUS">Minimal Serous</option>
                                    <option value="SEROUS">Serous</option>
                                    <option value="SEROSANGUINOUS">Serosanguinous</option>
                                    <option value="SANGUINOUS">Sanguinous</option>
                                    <option value="PURULENT">Purulent</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Dressing Status</label>
                                <select class="nn-select" @bind="noteForm.dressing_status">
                                    <option value="">-- Status --</option>
                                    <option value="COMPLETED">Completed</option>
                                    <option value="PENDING">Pending</option>
                                    <option value="NOT_REQUIRED">Not Required</option>
                                </select>
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Bleeding?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.bleeding" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.bleeding == true ? "Yes" : "No")</span>
                                </div>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Infection Signs?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.infection_sign" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.infection_sign == true ? "Yes" : "No")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @* MEDICATION *@
                @if (noteForm.note_type == "MEDICATION")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-capsule-pill"></i> Medication Details</div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Medication Source</label>
                                <select class="nn-select" @bind="noteForm.medication_source">
                                    <option value="PRESCRIBED">Prescribed Medicine</option>
                                    <option value="NURSE_INITIATED">Nurse Initiated</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Medication Status</label>
                                <select class="nn-select" @bind="noteForm.medication_status">
                                    <option value="">-- Status --</option>
                                    <option value="GIVEN">Given</option>
                                    <option value="SKIPPED">Skipped</option>
                                    <option value="REFUSED">Refused</option>
                                    <option value="HELD">Held</option>
                                </select>
                            </div>
                        </div>

                        @if (noteForm.medication_source == "NURSE_INITIATED")
                        {
                            <div class="nn-form-row-3">
                                <div class="nn-form-group" style="position:relative;">
                                    <label class="nn-label">Drug Name</label>
                                    <input type="text" class="nn-input" placeholder="Type to search drug/item (e.g., Paracetamol 500mg)..." 
                                           value="@noteForm.standalone_drug_name" 
                                           @oninput="OnDrugInputChanged" 
                                           @onfocus="OnDrugInputFocus" 
                                           @onblur="OnDrugInputBlur" 
                                           @onkeydown="OnDrugKeyDown" />
                                    @if (showDrugDropdown && filteredDrugItems != null && filteredDrugItems.Any())
                                    {
                                        <div class="nn-autocomplete-dropdown">
                                            @for (int i = 0; i < filteredDrugItems.Count; i++)
                                            {
                                                var idx = i;
                                                var item = filteredDrugItems[idx];
                                                var displayName = !string.IsNullOrWhiteSpace(item.itemname) ? item.itemname : item.drugname;
                                                <div class="nn-autocomplete-item @(selectedDrugIndex == idx ? "active" : "")" 
                                                     @onclick="() => SelectDrugItem(displayName)"
                                                     @mousedown="() => SelectDrugItem(displayName)"
                                                     @onmouseover="() => selectedDrugIndex = idx">
                                                    <i class="bi bi-capsule-pill me-2 text-primary"></i> @displayName
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="nn-form-group">
                                    <label class="nn-label">Dosage</label>
                                    <input type="text" class="nn-input" placeholder="e.g. 500 mg / 1 tab" @bind="noteForm.standalone_dosage" />
                                </div>
                                <div class="nn-form-group">
                                    <label class="nn-label">Route</label>
                                    <select class="nn-select" @bind="noteForm.standalone_route">
                                        <option value="">-- Route --</option>
                                        <option value="ORAL">Oral</option>
                                        <option value="IV">IV (Intravenous)</option>
                                        <option value="IM">IM (Intramuscular)</option>
                                        <option value="TOPICAL">Topical</option>
                                        <option value="SUBCUTANEOUS">Subcutaneous</option>
                                        <option value="INHALATION">Inhalation</option>
                                        <option value="OTHER">Other</option>
                                    </select>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="nn-form-row-1">
                                <div class="nn-form-group">
                                    <label class="nn-label">Prescribed Medicine (from Case Sheet)</label>
                                    <select class="nn-select" value="@noteForm.prescription_detail_id?.ToString()" @onchange="OnPrescriptionSelected">
                                        <option value="">-- Select Prescribed Medicine --</option>
                                        @if (caseSheet?.prescription?.items != null && caseSheet.prescription.items.Any())
                                        {
                                            @foreach (var med in caseSheet.prescription.items)
                                            {
                                                <option value="@med.pr_det_id">
                                                    @med.drug_name (@(string.Join("-", med.morning, med.afternoon, med.evening, med.night)) - @med.route)
                                                </option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        }

                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Scheduled Time</label>
                                <input type="datetime-local" class="nn-input" @bind="scheduledTimeLocal" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Given Time</label>
                                <input type="datetime-local" class="nn-input" @bind="givenTimeLocal" />
                            </div>
                        </div>
                    </div>
                }

                @* INTAKE/OUTPUT *@
                @if (noteForm.note_type == "INTAKE_OUTPUT")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-droplet-half"></i> Intake / Output</div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Oral Intake (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.oral_intake_ml" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">IV Fluid (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.iv_fluid_ml" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Tube Feed (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.tube_feed_ml" />
                            </div>
                        </div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Urine Output (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.urine_ml" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Vomit (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.vomit_ml" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Drain (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.drain_ml" />
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Stool Count</label>
                                <input type="number" class="nn-input" @bind="noteForm.stool_count" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Total Output (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.total_output_ml" />
                            </div>
                        </div>
                    </div>
                }

                @* OXYGEN *@
                @if (noteForm.note_type == "OXYGEN")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-lungs-fill"></i> Oxygen Therapy</div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Device</label>
                                <input type="text" class="nn-input" placeholder="e.g. Nasal Cannula" @bind="noteForm.oxygen_device" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Flow Rate</label>
                                <input type="number" step="0.5" class="nn-input" @bind="noteForm.oxygen_flow_rate" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Flow Unit</label>
                                <input type="text" class="nn-input" placeholder="L/min" @bind="noteForm.oxygen_flow_unit" />
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">FiO2 (%)</label>
                                <input type="number" step="1" class="nn-input" @bind="noteForm.fio2" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Status</label>
                                <select class="nn-select" @bind="noteForm.oxygen_status">
                                    <option value="">-- Status --</option>
                                    <option value="STARTED">Started</option>
                                    <option value="ONGOING">Ongoing</option>
                                    <option value="STOPPED">Stopped</option>
                                    <option value="WEANED">Weaned</option>
                                </select>
                            </div>
                        </div>
                    </div>
                }

                @* GENERAL / PATIENT STATUS *@
                @if (noteForm.note_type == "GENERAL" || string.IsNullOrWhiteSpace(noteForm.note_type))
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-person-heart"></i> Patient Clinical Status</div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Patient Status</label>
                                <select class="nn-select" @bind="noteForm.patient_status">
                                    <option value="">-- Status --</option>
                                    <option value="STABLE">Stable</option>
                                    <option value="CRITICAL">Critical</option>
                                    <option value="IMPROVING">Improving</option>
                                    <option value="DETERIORATING">Deteriorating</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Consciousness</label>
                                <select class="nn-select" @bind="noteForm.consciousness_status">
                                    <option value="">-- Consciousness --</option>
                                    <option value="ALERT">Alert & Oriented</option>
                                    <option value="DROWSY">Drowsy</option>
                                    <option value="STUPOR">Stupor</option>
                                    <option value="COMATOSE">Comatose</option>
                                    <option value="CONFUSED">Confused</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Mobility</label>
                                <select class="nn-select" @bind="noteForm.mobility_status">
                                    <option value="">-- Mobility --</option>
                                    <option value="AMBULATORY">Ambulatory</option>
                                    <option value="ASSISTED">Assisted</option>
                                    <option value="BEDRIDDEN">Bedridden</option>
                                    <option value="WHEELCHAIR">Wheelchair</option>
                                </select>
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Diet Type</label>
                                <select class="nn-select" @bind="noteForm.diet_type">
                                    <option value="">-- Diet --</option>
                                    <option value="REGULAR">Regular</option>
                                    <option value="SOFT">Soft Diet</option>
                                    <option value="LIQUID">Liquid Diet</option>
                                    <option value="NPO">NPO (Nil Per Os)</option>
                                    <option value="DIABETIC">Diabetic</option>
                                    <option value="LOW_SODIUM">Low Sodium</option>
                                    <option value="TUBE_FEED">Tube Feeding</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Clinical Condition Details</label>
                                <input type="text" class="nn-input" placeholder="e.g. Patient resting comfortably" @bind="noteForm.clinical_condition" />
                            </div>
                        </div>
                    </div>
                }

                @* INFUSION *@
                @if (noteForm.note_type == "INFUSION")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-droplet-fill"></i> IV Infusion Details</div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Infusion Name</label>
                                <input type="text" class="nn-input" placeholder="e.g. Normal Saline 0.9%" @bind="noteForm.infusion_name" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Fluid Type</label>
                                <input type="text" class="nn-input" placeholder="e.g. Crystalloid / Colloid" @bind="noteForm.fluid_type" />
                            </div>
                        </div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Volume (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.infusion_volume" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Rate (mL/hr)</label>
                                <input type="number" class="nn-input" @bind="noteForm.infusion_rate" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">IV Site</label>
                                <input type="text" class="nn-input" placeholder="e.g. Left forearm IV cannula" @bind="noteForm.infusion_site" />
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Infusion Status</label>
                                <select class="nn-select" @bind="noteForm.infusion_status">
                                    <option value="">-- Status --</option>
                                    <option value="STARTED">Started</option>
                                    <option value="ONGOING">Ongoing</option>
                                    <option value="COMPLETED">Completed</option>
                                    <option value="STOPPED">Stopped</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Total Volume Given (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.total_volume_given" />
                            </div>
                        </div>
                    </div>
                }

                @* PAIN *@
                @if (noteForm.note_type == "PAIN")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-emoji-frown"></i> Pain Assessment</div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Pain Present?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.pain_present" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.pain_present == true ? "Yes" : "No")</span>
                                </div>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Location</label>
                                <input type="text" class="nn-input" placeholder="e.g. Lower back" @bind="noteForm.pain_location" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Pain Type</label>
                                <select class="nn-select" @bind="noteForm.pain_type">
                                    <option value="">-- Type --</option>
                                    <option value="ACUTE">Acute</option>
                                    <option value="CHRONIC">Chronic</option>
                                    <option value="THROBBING">Throbbing</option>
                                    <option value="SHARP">Sharp</option>
                                    <option value="DULL">Dull</option>
                                    <option value="BURNING">Burning</option>
                                </select>
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Intervention Applied</label>
                                <input type="text" class="nn-input" placeholder="e.g. Analgesic administered, hot pack applied" @bind="noteForm.pain_intervention" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Score After Intervention (0-10)</label>
                                <input type="number" min="0" max="10" class="nn-input" @bind="noteForm.pain_after_intervention_score" />
                            </div>
                        </div>
                    </div>
                }

                @* PROCEDURE *@
                @if (noteForm.note_type == "PROCEDURE")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-tools"></i> Bedside Procedure Details</div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group" style="position:relative;">
                                <label class="nn-label">Procedure Name</label>
                                <input type="text" class="nn-input" placeholder="Type to search test names (e.g., Bedside Glucometry, ECG)..." 
                                       value="@noteForm.procedure_name" 
                                       @oninput="OnProcedureInputChanged" 
                                       @onfocus="OnProcedureInputFocus" 
                                       @onblur="OnProcedureInputBlur" 
                                       @onkeydown="OnProcedureKeyDown" />
                                @if (showTestDropdown && filteredTestMasters != null && filteredTestMasters.Any())
                                {
                                    <div class="nn-autocomplete-dropdown">
                                        @for (int i = 0; i < filteredTestMasters.Count; i++)
                                        {
                                            var idx = i;
                                            var test = filteredTestMasters[idx];
                                            <div class="nn-autocomplete-item @(selectedTestIndex == idx ? "active" : "")" 
                                                 @onclick="() => SelectProcedureTest(test.name)"
                                                 @mousedown="() => SelectProcedureTest(test.name)"
                                                 @onmouseover="() => selectedTestIndex = idx">
                                                <i class="bi bi-file-earmark-medical me-2 text-primary"></i> @test.name
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Site / Region</label>
                                <input type="text" class="nn-input" placeholder="e.g. Left index finger" @bind="noteForm.procedure_site" />
                            </div>
                        </div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Status</label>
                                <select class="nn-select" @bind="noteForm.procedure_status">
                                    <option value="">-- Status --</option>
                                    <option value="PERFORMED">Performed</option>
                                    <option value="ASSISTED">Assisted Doctor</option>
                                    <option value="IN_PROGRESS">In Progress</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Result Value</label>
                                <input type="text" class="nn-input" placeholder="e.g. 140" @bind="noteForm.procedure_result_value" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Result Unit</label>
                                <input type="text" class="nn-input" placeholder="e.g. mg/dL" @bind="noteForm.procedure_result_unit" />
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Patient Response</label>
                                <input type="text" class="nn-input" placeholder="e.g. Tolerated procedure well" @bind="noteForm.patient_response" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Complications?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.complication" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.complication == true ? "Complication noted" : "No complications")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @* PATIENT MOVEMENT *@
                @if (noteForm.note_type == "PATIENT_MOVEMENT")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-person-walking"></i> Patient Movement / Transfer</div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Movement Type</label>
                                <select class="nn-select" @bind="noteForm.movement_type">
                                    <option value="">-- Type --</option>
                                    <option value="TRANSFER">Ward Transfer</option>
                                    <option value="AMBULATION">Ambulation Walk</option>
                                    <option value="ICU_TRANSFER">ICU Transfer</option>
                                    <option value="RADIOLOGY">Radiology Visit</option>
                                    <option value="OPERATION">OR / Operation Theater</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">From Location</label>
                                <input type="text" class="nn-input" placeholder="e.g. Ward Bed 102" @bind="noteForm.from_location" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">To Location</label>
                                <input type="text" class="nn-input" placeholder="e.g. Radiology Scan Room" @bind="noteForm.to_location" />
                            </div>
                        </div>
                        <div class="nn-form-group">
                            <label class="nn-label">Reason for Movement</label>
                            <input type="text" class="nn-input" placeholder="e.g. CT Scan examination" @bind="noteForm.movement_reason" />
                        </div>
                    </div>
                }

                @* SKIN ASSESSMENT *@
                @if (noteForm.note_type == "SKIN_ASSESSMENT")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-person-bounding-box"></i> Skin & Pressure Sore Assessment</div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Skin Integrity</label>
                                <select class="nn-select" @bind="noteForm.skin_integrity">
                                    <option value="">-- Integrity --</option>
                                    <option value="INTACT">Intact</option>
                                    <option value="DRY">Dry / Scaly</option>
                                    <option value="DIAPHORETIC">Diaphoretic</option>
                                    <option value="RASH">Rash / Lesion</option>
                                    <option value="ERYTHEMA">Erythema</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Braden Score (6-23)</label>
                                <input type="number" min="6" max="23" class="nn-input" @bind="noteForm.braden_score" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Repositioning Done?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.repositioning_done" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.repositioning_done == true ? "Repositioned" : "Not Done")</span>
                                </div>
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Pressure Sore Present?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.pressure_sore_present" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.pressure_sore_present == true ? "Sore Present" : "No Pressure Sore")</span>
                                </div>
                            </div>
                            @if (noteForm.pressure_sore_present == true)
                            {
                                <div class="nn-form-group">
                                    <label class="nn-label">Sore Site & Stage</label>
                                    <input type="text" class="nn-input" placeholder="e.g. Sacrum - Stage 2" @bind="noteForm.pressure_sore_site" />
                                </div>
                            }
                        </div>
                    </div>
                }

                @* CATHETER *@
                @if (noteForm.note_type == "CATHETER")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-moisture"></i> Catheter & Lines Care</div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Catheter / Line Type</label>
                                <select class="nn-select" @bind="noteForm.catheter_type">
                                    <option value="">-- Type --</option>
                                    <option value="FOLEY">Foley Urinary Catheter</option>
                                    <option value="CONDOM">Condom Catheter</option>
                                    <option value="CENTRAL_LINE">Central Venous Line</option>
                                    <option value="IV_CANNULA">Peripheral IV Cannula</option>
                                    <option value="PICC">PICC Line</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Size / Fr</label>
                                <input type="text" class="nn-input" placeholder="e.g. 16 Fr" @bind="noteForm.catheter_size" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Catheter Care Done?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.catheter_care_done" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.catheter_care_done == true ? "Care Performed" : "Pending")</span>
                                </div>
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Bladder Status</label>
                                <input type="text" class="nn-input" placeholder="e.g. Normal, Distended, Continous drain" @bind="noteForm.bladder_status" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Bowel Movement</label>
                                <input type="text" class="nn-input" placeholder="e.g. Passed stool once, Soft" @bind="noteForm.bowel_movement" />
                            </div>
                        </div>
                    </div>
                }

                @* RESTRAINT *@
                @if (noteForm.note_type == "RESTRAINT")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-lock-fill"></i> Restraint Monitoring</div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Restraint Used?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.restraint_used" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.restraint_used == true ? "Applied" : "Not Applied")</span>
                                </div>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Restraint Type</label>
                                <select class="nn-select" @bind="noteForm.restraint_type">
                                    <option value="">-- Type --</option>
                                    <option value="WRIST">Wrist Restraint</option>
                                    <option value="ANKLE">Ankle Restraint</option>
                                    <option value="BED_RAILS">Bed Side Rails</option>
                                    <option value="CHEMICAL">Chemical Restraint</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Site Checked & Cleaned?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.restraint_site_checked" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.restraint_site_checked == true ? "Checked" : "Pending")</span>
                                </div>
                            </div>
                        </div>
                        <div class="nn-form-group">
                            <label class="nn-label">Reason for Restraint</label>
                            <input type="text" class="nn-input" placeholder="e.g. Patient disoriented, pulling at ET tube / IV lines" @bind="noteForm.restraint_reason" />
                        </div>
                    </div>
                }

                @* ISOLATION *@
                @if (noteForm.note_type == "ISOLATION")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-shield-fill"></i> Isolation & Infection Control</div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Isolation Required?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.isolation_required" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.isolation_required == true ? "Isolated" : "No Isolation")</span>
                                </div>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Isolation Type</label>
                                <select class="nn-select" @bind="noteForm.isolation_type">
                                    <option value="">-- Type --</option>
                                    <option value="CONTACT">Contact Isolation</option>
                                    <option value="DROPLET">Droplet Isolation</option>
                                    <option value="AIRBORNE">Airborne Isolation</option>
                                    <option value="PROTECTIVE">Protective Isolation</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Hand Hygiene Complied?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.hand_hygiene_compliance" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.hand_hygiene_compliance == true ? "Complied" : "Pending")</span>
                                </div>
                            </div>
                        </div>
                        <div class="nn-form-group">
                            <label class="nn-label">PPE Equipment Used</label>
                            <input type="text" class="nn-input" placeholder="e.g. N95 Mask, Isolation Gown, Gloves, Face Shield" @bind="noteForm.ppe_used" />
                        </div>
                    </div>
                }

                @* EDUCATION *@
                @if (noteForm.note_type == "EDUCATION")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-mortarboard-fill"></i> Patient & Family Education</div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Education Topic</label>
                                <input type="text" class="nn-input" placeholder="e.g. Insulin self-injection / Wound hygiene" @bind="noteForm.education_topic" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Education Given To</label>
                                <select class="nn-select" @bind="noteForm.education_given_to">
                                    <option value="">-- Recipient --</option>
                                    <option value="PATIENT">Patient Only</option>
                                    <option value="FAMILY">Family Member</option>
                                    <option value="CAREGIVER">Caregiver</option>
                                </select>
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Method</label>
                                <select class="nn-select" @bind="noteForm.education_method">
                                    <option value="">-- Method --</option>
                                    <option value="VERBAL">Verbal Explanation</option>
                                    <option value="DEMONSTRATION">Practical Demonstration</option>
                                    <option value="PAMPHLET">Printed Booklet / Pamphlet</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Understanding Level</label>
                                <select class="nn-select" @bind="noteForm.patient_understanding">
                                    <option value="">-- Level --</option>
                                    <option value="GOOD">Good Understanding</option>
                                    <option value="FAIR">Fair Understanding</option>
                                    <option value="NEEDS_REINFORCEMENT">Needs Reinforcement</option>
                                </select>
                            </div>
                        </div>
                    </div>
                }

                @* HANDOVER *@
                @if (noteForm.note_type == "HANDOVER")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-arrow-repeat"></i> Shift Handover Details</div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Handover To (Staff ID)</label>
                                <input type="number" class="nn-input" placeholder="Staff ID" @bind="noteForm.handover_to" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Pending Medications</label>
                                <input type="text" class="nn-input" placeholder="e.g. Evening Dose Antibiotics at 8 PM" @bind="noteForm.pending_medications" />
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Pending Investigations</label>
                                <input type="text" class="nn-input" placeholder="e.g. Repeat CBC report expected" @bind="noteForm.pending_investigations" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Special Instructions</label>
                                <input type="text" class="nn-input" placeholder="e.g. Monitor SpO2 hourly" @bind="noteForm.special_instructions" />
                            </div>
                        </div>
                    </div>
                }

                @* GENERAL NOTES *@
                <div class="nn-modal-card" style="margin-bottom:0;">
                    <div class="nn-form-group" style="margin-bottom:0;">
                        <label class="nn-label"><i class="bi bi-journal-text"></i> Additional Notes</label>
                        <textarea class="nn-textarea" rows="3" placeholder="Enter any additional observations, clinical findings, or nurse remarks…" @bind="noteForm.notes"></textarea>
                    </div>
                </div>
            </div>

            <div class="nn-modal-footer">
                <button class="nn-btn nn-btn-ghost" @onclick="CloseNoteModal" disabled="@isSavingNote">Cancel</button>
                <button class="nn-btn nn-btn-primary" @onclick="SaveNoteAsync" disabled="@isSavingNote">
                    @if (isSavingNote)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-floppy-fill"></i>
                    }
                    @(editingNote == null ? "Add Note" : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════════════ CANCEL MODAL ══════════════════════════════════════ *@
@if (showCancelModal)
{
    <div class="nn-modal-backdrop" @onclick="() => showCancelModal = false">
        <div class="nn-modal" style="max-width:440px;" @onclick:stopPropagation>
            <div class="nn-modal-header">
                <div class="nn-modal-title"><i class="bi bi-x-circle-fill" style="color:#dc2626;"></i> Cancel Note</div>
                <button class="nn-modal-close" @onclick="() => showCancelModal = false">×</button>
            </div>
            <div class="nn-modal-body">
                <div class="nn-form-group">
                    <label class="nn-label">Cancel Reason <span class="nn-required">*</span></label>
                    <textarea class="nn-textarea" rows="3" placeholder="Enter reason for cancellation…" @bind="cancelReason"></textarea>
                </div>
                <div class="nn-form-group">
                    <label class="nn-label">Cancelled By (Staff ID)</label>
                    <input type="number" class="nn-input" @bind="cancelledBy" />
                </div>
            </div>
            <div class="nn-modal-footer">
                <button class="nn-btn nn-btn-ghost" @onclick="() => showCancelModal = false">Back</button>
                <button class="nn-btn" style="background:#dc2626;color:#fff;" @onclick="ExecuteCancelNote" disabled="@isSavingNote">
                    @if (isSavingNote) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-x-circle-fill"></i> }
                    Confirm Cancel
                </button>
            </div>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════════════ ADD VITALS MODAL ══════════════════════════════════════ *@
@if (showVitalsModal)
{
    <div class="nn-modal-backdrop" @onclick="CloseVitalsModal">
        <div class="nn-modal" style="max-width:650px;" @onclick:stopPropagation>
            <div class="nn-modal-header">
                <div class="nn-modal-title">
                    <i class="bi bi-heart-pulse-fill" style="color:#dc2626;"></i> @(editingVitals != null ? "Edit Patient Vitals" : "Record Patient Vitals")
                </div>
                <button class="nn-modal-close" @onclick="CloseVitalsModal">×</button>
            </div>
            <div class="nn-modal-body" style="background:#f8fafc;">
                <div class="nn-modal-card">
                    <div class="nn-form-row-2">
                        <div class="nn-form-group">
                            <label class="nn-label">BP Systolic (mmHg)</label>
                            <input type="number" class="nn-input" placeholder="e.g. 120" @bind="newVitals.bp_systolic" />
                        </div>
                        <div class="nn-form-group">
                            <label class="nn-label">BP Diastolic (mmHg)</label>
                            <input type="number" class="nn-input" placeholder="e.g. 80" @bind="newVitals.bp_diastolic" />
                        </div>
                    </div>
                    <div class="nn-form-row-3">
                        <div class="nn-form-group">
                            <label class="nn-label">Pulse (bpm)</label>
                            <input type="number" class="nn-input" placeholder="e.g. 72" @bind="newVitals.pulse_rate" />
                        </div>
                        <div class="nn-form-group">
                            <label class="nn-label">Temp (°F)</label>
                            <input type="number" step="0.1" class="nn-input" placeholder="e.g. 98.6" @bind="newVitals.temperature_f" />
                        </div>
                        <div class="nn-form-group">
                            <label class="nn-label">SpO2 (%)</label>
                            <input type="number" class="nn-input" placeholder="e.g. 98" @bind="newVitals.spo2" />
                        </div>
                    </div>
                    <div class="nn-form-row-3">
                        <div class="nn-form-group">
                            <label class="nn-label">Respiratory Rate (/min)</label>
                            <input type="number" class="nn-input" placeholder="e.g. 18" @bind="newVitals.respiratory_rate" />
                        </div>
                        <div class="nn-form-group">
                            <label class="nn-label">Height (cm)</label>
                            <input type="number" step="0.1" class="nn-input" placeholder="e.g. 170" @bind="newVitals.height_cm" />
                        </div>
                        <div class="nn-form-group">
                            <label class="nn-label">Weight (kg)</label>
                            <input type="number" step="0.1" class="nn-input" placeholder="e.g. 70" @bind="newVitals.weight_kg" />
                        </div>
                    </div>
                    <div class="nn-form-row-3">
                        <div class="nn-form-group">
                            <label class="nn-label">Blood Sugar (mg/dL)</label>
                            <input type="number" class="nn-input" placeholder="e.g. 110" @bind="newVitals.sugar_level" />
                        </div>
                        <div class="nn-form-group">
                            <label class="nn-label">Pain Scale (0-10)</label>
                            <input type="number" min="0" max="10" class="nn-input" placeholder="e.g. 2" @bind="newVitals.pain_scale" />
                        </div>
                        <div class="nn-form-group">
                            <label class="nn-label">HbA1c (%)</label>
                            <input type="number" step="0.1" class="nn-input" placeholder="e.g. 5.6" @bind="newVitals.hba1c" />
                        </div>
                    </div>
                    <div class="nn-form-group" style="margin-bottom:0;">
                        <label class="nn-label">Allergies / Vitals Remarks</label>
                        <textarea class="nn-textarea" rows="2" placeholder="e.g. Penicillin allergy noted, patient resting" @bind="newVitals.allergy_notes"></textarea>
                    </div>
                </div>
            </div>
            <div class="nn-modal-footer">
                <button class="nn-btn nn-btn-ghost" @onclick="CloseVitalsModal" disabled="@isSavingVitals">Cancel</button>
                <button class="nn-btn nn-btn-primary" @onclick="SaveVitalsAsync" disabled="@isSavingVitals">
                    @if (isSavingVitals) { <span class="spinner-border spinner-border-sm me-1"></span> } else { <i class="bi bi-floppy-fill me-1"></i> }
                    @(editingVitals != null ? "Update Vitals" : "Save Vitals")
                </button>
            </div>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════════════ DELETE VITALS MODAL ══════════════════════════════════════ *@
@if (showDeleteVitalsModal && vitalsToDelete != null)
{
    <div class="nn-modal-backdrop" @onclick="() => showDeleteVitalsModal = false">
        <div class="nn-modal" style="max-width:440px;" @onclick:stopPropagation>
            <div class="nn-modal-header">
                <div class="nn-modal-title"><i class="bi bi-trash-fill text-danger me-1"></i> Delete Vitals Record</div>
                <button class="nn-modal-close" @onclick="() => showDeleteVitalsModal = false">×</button>
            </div>
            <div class="nn-modal-body">
                <p style="color:#334155; font-size:0.9rem; margin-bottom:0.5rem;">Are you sure you want to delete this recorded vitals entry from <strong>@(DateTimeHelper.ConvertUtcToIst((DateTime?)vitalsToDelete.created_at)?.ToString("dd MMM yyyy hh:mm tt") ?? vitalsToDelete.created_at.ToString("g"))</strong>?</p>
                <p style="color:#ef4444; font-size:0.8rem; font-weight:600; margin:0;">This action cannot be undone.</p>
            </div>
            <div class="nn-modal-footer">
                <button class="nn-btn nn-btn-ghost" @onclick="() => showDeleteVitalsModal = false" disabled="@isDeletingVitals">Cancel</button>
                <button class="btn btn-danger" style="padding:0.4rem 1rem; font-size:0.85rem; border-radius:8px; font-weight:600;" @onclick="DeleteVitalsAsync" disabled="@isDeletingVitals">
                    @if (isDeletingVitals) { <span class="spinner-border spinner-border-sm me-1"></span> } else { <i class="bi bi-trash-fill me-1"></i> }
                    Confirm Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
