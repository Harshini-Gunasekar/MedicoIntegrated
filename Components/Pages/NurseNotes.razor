    private string GetWardBedText(int? wrdcode, int? bedcode)
    {
        string ward = "General Ward";
        string bed = "";
        if (wrdcode.HasValue)
        {
            var w = wardsList.FirstOrDefault(x => x.wrdcode == wrdcode.Value);
            if (w != null && !string.IsNullOrWhiteSpace(w.name)) ward = w.name;
        }
        if (bedcode.HasValue)
        {
            var b = bedsList.FirstOrDefault(x => x.bedcode == bedcode.Value);
            if (b != null && !string.IsNullOrWhiteSpace(b.bedname))
