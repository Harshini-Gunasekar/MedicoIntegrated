    private List<IPRegistrationModel.IpRegistrationModel> GetFilteredAdmissions()
    {
        var query = admittedPatients.AsEnumerable();

        if (listFilterDate.HasValue)
        {
            query = query.Where(a => a.admitdate.Date == listFilterDate.Value.Date);
        }

        if (!string.IsNullOrWhiteSpace(listFilterDoctorDcode) && int.TryParse(listFilterDoctorDcode, out var docCode))
        {
            query = query.Where(a => a.dcode == docCode);
        }

        if (!string.IsNullOrWhiteSpace(listFilterWardCode) && int.TryParse(listFilterWardCode, out var wardCode))
        {
            query = query.Where(a => (a.wrdcode == wardCode) || (bedsList.FirstOrDefault(b => b.bedcode == a.bedcode)?.wrdcode == wardCode));
        }

        if (!string.IsNullOrWhiteSpace(listFilterAdmissionType) && listFilterAdmissionType != "ALL")
        {
            query = query.Where(a => string.Equals(a.admission_type, listFilterAdmissionType, StringComparison.OrdinalIgnoreCase));
        }

        if (listFilterReferral == "REFERRED")
        {
            query = query.Where(a => ipVisitingDoctorMap.TryGetValue(a.ip_id, out var info) && info.IsReferred);
        }

        if (!string.IsNullOrWhiteSpace(listSearchText))
        {
            var s = listSearchText.Trim().ToLowerInvariant();
            query = query.Where(a =>
                (a.patient_name != null && a.patient_name.ToLowerInvariant().Contains(s)) ||
                (a.ip_no != null && a.ip_no.ToLowerInvariant().Contains(s)) ||
                (a.mobile != null && a.mobile.Contains(s)) ||
                GetWardBedText(a.wrdcode, a.bedcode).ToLowerInvariant().Contains(s) ||
                GetDoctorName(a.dcode).ToLowerInvariant().Contains(s));
        }

        return query.OrderByDescending(a => a.admitdate).ToList();
    }

    private int GetTotalListPages()
