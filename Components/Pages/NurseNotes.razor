            </div>
            <div class="add-particular-modal-body">
                <div class="form-group mb-3">
                    <label class="nt-form-label font-bold mb-1">Task Name <span class="text-danger">*</span></label>
                    <input type="text"
                           class="nt-input-control w-100"
                           placeholder="e.g. Insulin 10 units / Diabetic lunch / Wound dressing"
                           @bind="newScheduleTypeName"
                           @bind:event="oninput"
                           @onkeydown="HandleAddScheduleTypeKeyDown"
                           autofocus />
                    @if (isScheduleSubmitting && string.IsNullOrWhiteSpace(newScheduleTypeName))
                    {
                        <span class="text-danger fs-8">Task name is required</span>
                    }
                </div>
            </div>
            <div class="add-particular-modal-footer">
                <button type="button" class="btn-cancel-modal" @onclick="CloseAddScheduleTypeModal" disabled="@isScheduleSubmitting">
                    Cancel
                </button>
                <button type="button" class="btn-save-particular" @onclick="SaveNewScheduleTypeAsync" disabled="@isScheduleSubmitting">
                    @if (isScheduleSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>Save Task</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
