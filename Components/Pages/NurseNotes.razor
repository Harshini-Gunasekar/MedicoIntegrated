    private decimal CalculateFluidBalance()
    {
        var intake = inputOutputList.Where(x => string.Equals(x.io_type, "INPUT", StringComparison.OrdinalIgnoreCase)).Sum(x => x.quantity ?? 0);
        var output = inputOutputList.Where(x => string.Equals(x.io_type, "OUTPUT", StringComparison.OrdinalIgnoreCase)).Sum(x => x.quantity ?? 0);
        return intake - output;
    }

