        }
        if (doc == null && !string.IsNullOrWhiteSpace(doctorName))
        {
            var clean = doctorName.Trim();
            if (clean.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase)) clean = clean.Substring(3).Trim();
            else if (clean.StartsWith("Dr ", StringComparison.OrdinalIgnoreCase)) clean = clean.Substring(3).Trim();

            doc = doctorsList.FirstOrDefault(d => 
                string.Equals(d.name?.Trim(), doctorName.Trim(), StringComparison.OrdinalIgnoreCase) ||
                string.Equals(d.doctorfullname?.Trim(), doctorName.Trim(), StringComparison.OrdinalIgnoreCase) ||
                string.Equals(d.name?.Trim(), clean, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(d.GetFormattedName().Trim(), doctorName.Trim(), StringComparison.OrdinalIgnoreCase));
        }
        return doc;
    }

    private string GetDoctorImageSrc(DoctorMasterModel? doc)
    {
        if (doc == null) return "";
        if (!string.IsNullOrWhiteSpace(doc.DoctorImageBase64))
        {
            if (doc.DoctorImageBase64.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
                return doc.DoctorImageBase64;
            return $"data:image/jpeg;base64,{doc.DoctorImageBase64}";
        }
        if (!string.IsNullOrWhiteSpace(doc.doctorimage))
        {
            if (doc.doctorimage.StartsWith("data:image", StringComparison.OrdinalIgnoreCase) ||
                doc.doctorimage.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                doc.doctorimage.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
                doc.doctorimage.StartsWith("/"))
            {
                return doc.doctorimage;
            }
            return $"api/files/download?key={Uri.EscapeDataString(doc.doctorimage)}";
        }
        return "";
    }

