                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center gap-1">
                                                            <button type="button" class="btn-action-icon btn-action-save" title="Save changes" @onclick="() => SaveExistingMedAsync(m)">
                                                                <i class="bi bi-check-circle-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Cancel Edit" @onclick="CancelEditMed">
                                                                <i class="bi bi-x-circle-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr class="lc-table-row saved-row" @ondblclick="() => StartEditMed(m)" title="Double-click to edit row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@rowSNo</td>
                                                    <td style="white-space: nowrap; vertical-align: middle;">
                                                        <div class="d-flex align-items-center gap-2 flex-nowrap" style="white-space: nowrap;">
                                                            <span class="font-bold text-slate-800" style="font-size: 11.5px;">@FormatEntryTime(m.entry_time, m.created_at)</span>
                                                            <span class="tag-shift-indigo">@m.shift</span>
                                                        </div>
                                                    </td>
                                                    <td style="white-space: nowrap; vertical-align: middle;">
                                                        <span class="font-bold text-indigo-700" style="font-size: 12px;">@m.medicine_name</span>
                                                    </td>
                                                    <td style="white-space: nowrap; vertical-align: middle;">
                                                        <div class="d-flex align-items-center gap-1.5 flex-nowrap">
                                                            <span class="font-bold text-slate-800" style="font-size: 12px;">@(m.dose?.ToString() ?? "—") @m.unit</span>
                                                            @if (!string.IsNullOrWhiteSpace(m.route))
                                                            {
                                                                <span class="badge bg-indigo-50 text-indigo-700 border border-indigo-200" style="font-size: 9.5px; font-weight: 700; padding: 2px 6px;">@m.route</span>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td style="text-align: center; white-space: nowrap; vertical-align: middle;">
                                                        @if (string.Equals(m.status, "GIVEN", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-1 font-bold" style="font-size: 10px;"><i class="bi bi-check2-circle me-1"></i>GIVEN</span>
                                                        }
                                                        else if (string.Equals(m.status, "REFUSED", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-rose-50 text-rose-700 border border-rose-200 px-2 py-1 font-bold" style="font-size: 10px;"><i class="bi bi-x-circle me-1"></i>REFUSED</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-amber-50 text-amber-800 border border-amber-200 px-2 py-1 font-bold" style="font-size: 10px;"><i class="bi bi-exclamation-triangle me-1"></i>MISSED</span>
                                                        }
                                                    </td>
                                                    <td class="text-slate-700" style="vertical-align: middle; line-height: 1.4; font-size: 11.5px;">
                                                        @(string.IsNullOrWhiteSpace(m.remarks) ? "—" : m.remarks)
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <div class="d-flex justify-content-center">
                                                            <span class="user-chip-mini">@GetAddedByText(m.usercode)</span>
                                                        </div>
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit row" @onclick="() => StartEditMed(m)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Delete record" @onclick="() => DeleteMedicineAsync(m.med_id)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }

                                        <!-- 2. Active New Input Row (Always at bottom, auto-saves on Enter) -->
                                        <tr class="table-inline-entry-row active-new-row">
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span class="badge-new-entry" title="Next Entry Row">@sNo</span>
                                            </td>
                                            <td style="vertical-align: middle; white-space: nowrap;">
                                                <div class="inline-time-shift-compact">
                                                    <input type="text"
                                                           class="inline-table-input time-input-mini"
                                                           placeholder="05:45 PM"
                                                           @bind="newMedTime"
                                                           style="width: 80px; height: 32px; font-size: 11.5px;"
                                                           title="Time" />
                                                    <select class="inline-table-select shift-select-mini"
                                                           @bind="newMedShift"
                                                           style="height: 32px; font-size: 11px;"
                                                           title="Shift">
                                                        <option value="MORNING">Morning</option>
                                                        <option value="AFTERNOON">Afternoon</option>
                                                        <option value="EVENING">Evening</option>
                                                        <option value="NIGHT">Night</option>
                                                    </select>
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle; position: relative; white-space: nowrap;">
                                                <div class="custom-dropdown-wrap position-relative" style="width: 100%;">
                                                    <input @ref="newMedNameRef"
                                                           type="text"
                                                           class="inline-table-input font-bold text-indigo-700"
                                                           placeholder="e.g. Paracetamol 650mg, Inj Pantop..."
                                                           value="@newMedName"
                                                           @oninput="OnNewMedNameInput"
                                                           @onfocus="OnNewMedNameFocus"
                                                           @onkeydown="HandleNewMedNameKeyDown"
                                                           autocomplete="off"
                                                           style="width: 100%; height: 32px; font-size: 11.5px;"
                                                           title="Medicine Name" />

                                                    @if (isMedicineDropdownOpen)
                                                    {
                                                        <div class="custom-particulars-dropdown shadow-lg" @onclick:stopPropagation>
                                                            @{
                                                                var mItems = GetFilteredMedicines().ToList();
                                                            }
                                                            @if (mItems.Any())
                                                            {
                                                                @for (int idx = 0; idx < mItems.Count; idx++)
                                                                {
                                                                    var mitm = mItems[idx];
                                                                    var isHigh = idx == highlightedMedicineIndex;
                                                                    <div class="particular-dropdown-item @(isHigh ? "highlighted" : "")"
                                                                         @onclick="() => SelectNewMedName(mitm.itemname ?? string.Empty)"
                                                                         @onmouseenter="() => highlightedMedicineIndex = idx">
                                                                        <span class="particular-item-name">@mitm.itemname</span>
                                                                        <span class="particular-type-tag type-both">@(string.IsNullOrWhiteSpace(mitm.itemtype) ? "MEDICINE" : mitm.itemtype)</span>
                                                                    </div>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <div class="particular-no-results">
                                                                    <i class="bi bi-search me-1"></i> No medicines found matching "@newMedName"
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle; white-space: nowrap;">
                                                <div style="display: flex; align-items: center; gap: 4px; flex-wrap: nowrap;">
                                                    <input type="number"
                                                           step="0.1"
                                                           class="inline-table-input text-center font-bold"
                                                           placeholder="500"
                                                           @bind="newMedDose"
                                                           @bind:event="oninput"
                                                           style="width: 52px; height: 32px; font-size: 11.5px;"
                                                           title="Dose" />
                                                    <select class="inline-table-select"
                                                            @bind="newMedUnit"
                                                            style="width: 58px; height: 32px; font-size: 11px; padding: 2px 4px;"
                                                            title="Unit">
                                                        <option value="mg">mg</option>
                                                        <option value="ml">ml</option>
                                                        <option value="gm">gm</option>
                                                        <option value="tab">tab</option>
                                                        <option value="cap">cap</option>
                                                        <option value="puff">puff</option>
                                                        <option value="drops">drops</option>
                                                        <option value="vial">vial</option>
                                                        <option value="unit">unit</option>
                                                    </select>
                                                    <select class="inline-table-select"
                                                            @bind="newMedRoute"
                                                            style="width: 65px; height: 32px; font-size: 11px; padding: 2px 4px;"
                                                            title="Route">
                                                        <option value="Oral">Oral</option>
                                                        <option value="IV">IV</option>
                                                        <option value="IM">IM</option>
                                                        <option value="SC">SC</option>
                                                        <option value="Topical">Topical</option>
                                                        <option value="Inhalation">Inhalation</option>
                                                        <option value="Sublingual">Sublingual</option>
                                                        <option value="PR">PR</option>
                                                    </select>
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle; text-align: center; white-space: nowrap;">
                                                <select class="inline-table-select font-bold"
                                                        @bind="newMedStatus"
                                                        style="width: 100%; height: 32px; font-size: 11px; padding: 2px 4px; text-align: center;"
                                                        title="Status">
                                                    <option value="GIVEN">GIVEN</option>
                                                    <option value="REFUSED">REFUSED</option>
                                                    <option value="MISSED">MISSED</option>
                                                </select>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="text"
                                                       class="inline-table-input remarks-input"
                                                       placeholder="Type remarks & press Enter to save..."
                                                       @bind="newMedRemarks"
                                                       @bind:event="oninput"
                                                       @onkeydown="HandleNewMedKeyDown"
                                                       style="width: 100%; height: 32px; font-size: 11.5px;"
                                                       title="Remarks / Findings" />
                                            </td>
                                            <td style="vertical-align: middle; text-align: center; white-space: nowrap;">
                                                <div class="d-flex justify-content-center">
                                                    <span class="user-chip-mini" title="Logged-in User">
                                                        <i class="bi bi-person-check-fill me-1 text-indigo-500"></i>
                                                        @(string.IsNullOrWhiteSpace(currentUserName) ? "Duty Staff" : currentUserName)
                                                    </span>
                                                </div>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                <button type="button" class="badge-enter-key" @onclick="SaveNewMedInlineAsync" title="Save record (or press Enter on keyboard)">
                                                    <i class="bi bi-arrow-return-left"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 6: DOCTOR VISITING                                              *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "visiting_doctor")
                {
                    <div class="tab-section-flow">
                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-person-lines-fill text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Doctor Visiting Observation Log</span>
                                    <span class="table-pill-count ms-1">@visitingDoctorList.Count @(visitingDoctorList.Count == 1 ? "Visit" : "Visits")</span>
                                </div>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 55px; text-align: center;">S.NO.</th>
                                            <th style="width: 185px; white-space: nowrap;">ENTRY DATE &amp; SHIFT</th>
                                            <th style="width: 220px; white-space: nowrap;">DOCTOR VISITING</th>
                                            <th style="width: 105px; text-align: center; white-space: nowrap;">VISIT TIME</th>
                                            <th style="min-width: 150px;">DIAGNOSIS &amp; FINDINGS</th>
                                            <th style="min-width: 150px;">ADVICE &amp; PLAN</th>
                                            <th style="width: 125px; text-align: center; white-space: nowrap;">RECORDED BY</th>
                                            <th style="width: 95px; text-align: center; white-space: nowrap;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sNo = 1;
                                        }
                                        <!-- 1. Previously Saved Rows in Chronological Order -->
                                        @foreach (var v in visitingDoctorList.OrderBy(x => x.created_at))
                                        {
                                            var rowSNo = sNo++;
                                            var isEditing = editingVisitId == v.visit_id;
                                            if (isEditing)
                                            {
                                                <tr class="table-inline-entry-row is-inline-editing">
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <span class="badge-edit-mode">EDIT @rowSNo</span>
                                                    </td>
                                                    <td style="vertical-align: middle; white-space: nowrap;">
                                                        <div class="inline-time-shift-compact">
                                                            <input type="date"
                                                                   class="inline-table-input"
                                                                   @bind="visitDate"
                                                                   style="height: 32px; font-size: 11px; width: 105px; padding: 2px 4px;"
                                                                   title="Entry Date" />
                                                            <select class="inline-table-select shift-select-mini" @bind="visitShift" style="height: 32px; font-size: 11px;" title="Shift">
                                                                <option value="MORNING">Morning</option>
                                                                <option value="AFTERNOON">Afternoon</option>
                                                                <option value="EVENING">Evening</option>
                                                                <option value="NIGHT">Night</option>
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="text" class="inline-table-input font-bold" @bind="visitDoctorName" @bind:event="oninput" style="width: 100%; height: 32px; font-size: 11.5px;" placeholder="Doctor Name" />
                                                    </td>
                                                    <td style="vertical-align: middle; text-align: center;">
                                                        <input type="time" class="inline-table-input text-center font-bold" @bind="visitTime" style="width: 80px; height: 32px; font-size: 11.5px;" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="text" class="inline-table-input" placeholder="Clinical findings..." @bind="visitDiagnosis" @bind:event="oninput" style="width: 100%; height: 32px; font-size: 11.5px;" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="text" class="inline-table-input remarks-input" placeholder="Advice & Enter to update..." @bind="visitAdvice" @bind:event="oninput" @onkeydown="(e) => HandleExistingVisitKeyDown(e, v)" style="width: 100%; height: 32px; font-size: 11.5px;" />
                                                    </td>
                                                    <td style="vertical-align: middle; text-align: center; white-space: nowrap;">
                                                        <div class="d-flex justify-content-center">
                                                            <span class="user-chip-mini">@GetAddedByText(v.usercode)</span>
                                                        </div>
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center gap-1">
                                                            <button type="button" class="btn-action-icon btn-action-save" title="Save changes" @onclick="() => SaveExistingVisitAsync(v)">
                                                                <i class="bi bi-check-circle-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Cancel Edit" @onclick="CancelEditVisitingDoctor">
                                                                <i class="bi bi-x-circle-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr class="lc-table-row saved-row" @ondblclick="() => StartEditVisitingDoctor(v)" title="Double-click to edit row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@rowSNo</td>
                                                    <td style="white-space: nowrap; vertical-align: middle;">
                                                        <div class="d-flex align-items-center gap-1.5 flex-nowrap" style="white-space: nowrap;">
                                                            <span class="font-bold text-slate-800" style="font-size: 11.5px;">@(v.entry_date.ToIndianTime().ToString("dd-MMM"))</span>
                                                            <span class="text-slate-600 font-bold" style="font-size: 11px;">@FormatEntryTime(v.entry_time, v.created_at)</span>
                                                            <span class="tag-shift-indigo">@v.shift</span>
                                                        </div>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <div style="display: flex; flex-direction: column; gap: 4px;">
                                                            <span class="font-bold text-slate-800" style="font-size: 12px; display: block;">@v.doctor_name</span>
                                                            @if (!string.IsNullOrWhiteSpace(v.specialization))
                                                            {
                                                                <span class="text-indigo-600 font-semibold" style="font-size: 10.5px; line-height: 1.2; display: block;">@v.specialization</span>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <span class="font-bold text-slate-700" style="font-size: 11.5px;">@FormatVisitDisplayTime(v.visit_time)</span>
                                                    </td>
                                                    <td class="text-slate-800" style="vertical-align: middle; line-height: 1.4; font-size: 11.5px;">
                                                        @(string.IsNullOrWhiteSpace(v.diagnosis_notes) ? "—" : v.diagnosis_notes)
                                                    </td>
                                                    <td class="text-emerald-700 font-bold" style="vertical-align: middle; line-height: 1.4; font-size: 11.5px;">
                                                        @(string.IsNullOrWhiteSpace(v.advice) ? "—" : v.advice)
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <div class="d-flex justify-content-center">
                                                            <span class="user-chip-mini">@GetAddedByText(v.usercode)</span>
                                                        </div>
                                                    </td>
                                                    <td style="text-align: center; white-space: nowrap; vertical-align: middle;">
                                                        <div class="action-buttons-flex justify-content-center">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit row" @onclick="() => StartEditVisitingDoctor(v)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Delete record" @onclick="() => DeleteVisitingDoctorAsync(v.visit_id)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }

                                        <!-- 2. Active New Input Row (Always at bottom, auto-saves on Enter) -->
                                        <tr class="table-inline-entry-row active-new-row">
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span class="badge-new-entry" title="Next Entry Row">@sNo</span>
                                            </td>
                                            <td style="vertical-align: middle; white-space: nowrap;">
                                                <div class="inline-time-shift-compact">
                                                    <input type="date"
                                                           class="inline-table-input"
                                                           @bind="newVisitDate"
                                                           style="height: 32px; font-size: 11px; width: 105px; padding: 2px 4px;"
                                                           title="Entry Date" />
                                                    <select class="inline-table-select shift-select-mini"
                                                            @bind="newVisitShift"
                                                            style="height: 32px; font-size: 11px;"
                                                            title="Shift">
                                                        <option value="MORNING">Morning</option>
                                                        <option value="AFTERNOON">Afternoon</option>
                                                        <option value="EVENING">Evening</option>
                                                        <option value="NIGHT">Night</option>
                                                    </select>
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle; position: relative; white-space: nowrap;">
                                                <div class="custom-dropdown-wrap position-relative" style="width: 100%;">
                                                    <input @ref="newVisitDocNameRef"
                                                           type="text"
                                                           class="inline-table-input font-bold text-indigo-700"
                                                           placeholder="e.g. Dr. Karthik Raja"
                                                           value="@newVisitDocName"
                                                           @oninput="OnNewVisitDocInput"
                                                           @onclick="OnNewVisitDocClick"
                                                           @onclick:stopPropagation
                                                           @onkeydown="HandleNewVisitDocNameKeyDown"
                                                           autocomplete="off"
                                                           style="width: 100%; height: 32px; font-size: 11.5px;"
                                                           title="Visiting Doctor Name (Click to select)" />

                                                    @if (isVisitingDoctorDropdownOpen)
                                                    {
                                                        <div class="custom-particulars-dropdown shadow-lg" @onclick:stopPropagation>
                                                            @{
                                                                var docItems = GetFilteredVisitingDoctors().ToList();
                                                            }
                                                            @if (docItems.Any())
                                                            {
                                                                @for (int idx = 0; idx < docItems.Count; idx++)
                                                                {
                                                                    var doc = docItems[idx];
                                                                    var spec = GetDoctorSpecialty(doc);
                                                                    var isHigh = idx == highlightedVisitingDocIndex;
                                                                    <div class="particular-dropdown-item @(isHigh ? "highlighted" : "")"
                                                                         @onclick="() => SelectNewVisitingDoctor(doc)"
                                                                         @onmouseenter="() => highlightedVisitingDocIndex = idx">
                                                                        <span class="particular-item-name">@doc.name</span>
                                                                        @if (!string.IsNullOrWhiteSpace(spec))
                                                                        {
                                                                            <span class="particular-type-tag type-input">@spec</span>
                                                                        }
                                                                    </div>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <div class="particular-no-results">
                                                                    <i class="bi bi-search me-1"></i> No visiting doctors found
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle; text-align: center;">
                                                <input type="text"
                                                       class="inline-table-input time-input-mini"
                                                       placeholder="12:00 PM"
                                                       @bind="newVisitTime"
                                                       style="width: 80px !important; max-width: 80px !important; height: 32px; font-size: 11.5px; text-align: center;"
                                                       title="Visit Time" />
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="text"
                                                       class="inline-table-input"
                                                       placeholder="Clinical findings / Diagnosis..."
                                                       @bind="newVisitDiagnosis"
                                                       @bind:event="oninput"
                                                       style="width: 100%; height: 32px; font-size: 11.5px;"
                                                       title="Diagnosis & Clinical Findings" />
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="text"
                                                       class="inline-table-input font-bold text-emerald-700 remarks-input"
                                                       placeholder="Advice & Care plan..."
                                                       @bind="newVisitAdvice"
                                                       @bind:event="oninput"
                                                       @onkeydown="HandleNewVisitKeyDown"
                                                       style="width: 100%; height: 32px; font-size: 11.5px;"
                                                       title="Advice / Care Plan" />
                                            </td>
                                            <td style="vertical-align: middle; text-align: center; white-space: nowrap;">
                                                <div class="d-flex justify-content-center">
                                                    <span class="user-chip-mini" title="Logged-in User">
                                                        <i class="bi bi-person-check-fill me-1 text-indigo-500"></i>
                                                        @(string.IsNullOrWhiteSpace(currentUserName) ? "Duty Staff" : currentUserName)
                                                    </span>
                                                </div>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                <button type="button" class="badge-enter-key" @onclick="SaveNewVisitInlineAsync" title="Save record (or press Enter on keyboard)">
                                                    <i class="bi bi-arrow-return-left"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 7: SCHEDULE                                                     *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "schedule")
                {
                    <div class="tab-section-flow">
                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-clock-history text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Care Schedule &amp; Task Roster</span>
                                    <span class="table-pill-count ms-1">@GetFilteredSchedules().Count() @(GetFilteredSchedules().Count() == 1 ? "Item" : "Items")</span>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <!-- Quick Status Filter Pills -->
                                    <div class="sched-filter-group">
                                        <button type="button" class="sched-filter-pill @(scheduleFilter == "ALL" ? "active-all" : "")" @onclick='() => scheduleFilter = "ALL"'>
                                            <span>All</span>
                                            <span class="sched-filter-badge">@scheduleList.Count</span>
                                        </button>
                                        <button type="button" class="sched-filter-pill @(scheduleFilter == "PENDING" ? "active-pending" : "")" @onclick='() => scheduleFilter = "PENDING"'>
                                            <span>Pending</span>
                                            <span class="sched-filter-badge">@scheduleList.Count(x => string.Equals(x.status, "PENDING", StringComparison.OrdinalIgnoreCase))</span>
                                        </button>
                                        <button type="button" class="sched-filter-pill @(scheduleFilter == "COMPLETED" ? "active-completed" : "")" @onclick='() => scheduleFilter = "COMPLETED"'>
                                            <span>Completed</span>
                                            <span class="sched-filter-badge">@scheduleList.Count(x => string.Equals(x.status, "COMPLETED", StringComparison.OrdinalIgnoreCase))</span>
                                        </button>
                                        <button type="button" class="sched-filter-pill @(scheduleFilter == "MISSED" ? "active-missed" : "")" @onclick='() => scheduleFilter = "MISSED"'>
                                            <span>Missed</span>
                                            <span class="sched-filter-badge">@scheduleList.Count(x => string.Equals(x.status, "MISSED", StringComparison.OrdinalIgnoreCase))</span>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 55px; text-align: center;">S.NO.</th>
                                            <th style="width: 175px; white-space: nowrap;">SCHEDULED TIME &amp; SHIFT</th>
                                            <th style="width: 260px; white-space: nowrap;">TASK / ITEM &amp; TYPE</th>
                                            <th>INSTRUCTIONS</th>
                                            <th style="width: 125px; text-align: center;">STATUS</th>
                                            <th style="width: 125px; text-align: center; white-space: nowrap;">RECORDED BY</th>
                                            <th style="width: 95px; text-align: center; white-space: nowrap;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sNo = 1;
                                        }
                                        <!-- 1. Previously Saved Rows in Chronological Order -->
                                        @foreach (var s in GetFilteredSchedules())
                                        {
                                            var rowSNo = sNo++;
                                            var isEditing = editingScheduleId == s.schedule_id;
                                            if (isEditing)
                                            {
                                                <tr class="table-inline-entry-row is-inline-editing">
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <span class="badge-edit-mode">EDIT @rowSNo</span>
                                                    </td>
                                                    <td style="vertical-align: middle; white-space: nowrap;">
                                                        <div class="inline-time-shift-compact">
                                                            <input type="time" class="inline-table-input time-input-mini" @bind="scheduleTime" title="Scheduled Time" style="width: 80px; height: 32px; font-size: 11.5px;" />
                                                            <select class="inline-table-select shift-select-mini" @bind="scheduleShift" title="Shift" style="height: 32px; font-size: 11px;">
                                                                <option value="MORNING">Morning</option>
                                                                <option value="AFTERNOON">Afternoon</option>
                                                                <option value="EVENING">Evening</option>
                                                                <option value="NIGHT">Night</option>
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="vertical-align: middle; white-space: nowrap;">
                                                        <div style="display: flex; flex-direction: row; align-items: center; gap: 6px; flex-wrap: nowrap;">
                                                            <input type="text" class="inline-table-input font-bold text-indigo-700" @bind="scheduleName" @bind:event="oninput" placeholder="Task / Item name" style="flex: 1; min-width: 0; height: 32px; font-size: 11.5px;" />
                                                            <select class="inline-table-select" @bind="scheduleType" style="height: 32px; font-size: 10.5px; font-weight: 700; width: 92px; flex-shrink: 0;">
                                                                <option value="MEDICINE">MEDICINE</option>
                                                                <option value="DIET">DIET</option>
                                                                <option value="PROCEDURE">PROCEDURE</option>
                                                                <option value="OTHER">OTHER</option>
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="text" class="inline-table-input" @bind="scheduleInstructions" @bind:event="oninput" placeholder="Instructions..." style="width: 100%; height: 32px; font-size: 11.5px;" />
                                                    </td>
                                                    <td style="vertical-align: middle; text-align: center;">
                                                        <select class="inline-table-select font-bold" @bind="scheduleStatus" @onkeydown="(e) => HandleExistingSchedKeyDown(e, s)" style="width: 100%; height: 32px; font-size: 11px; padding: 2px 4px; text-align: center;">
                                                            <option value="PENDING">PENDING</option>
                                                            <option value="COMPLETED">COMPLETED</option>
                                                            <option value="MISSED">MISSED</option>
                                                        </select>
                                                    </td>
                                                    <td style="vertical-align: middle; text-align: center; white-space: nowrap;">
                                                        <div class="d-flex justify-content-center">
                                                            <span class="user-chip-mini">@GetAddedByText(s.usercode)</span>
                                                        </div>
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center gap-1">
                                                            <button type="button" class="btn-action-icon btn-action-save" title="Save changes" @onclick="() => SaveExistingSchedAsync(s)">
                                                                <i class="bi bi-check-circle-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Cancel Edit" @onclick="CancelEditSchedule">
                                                                <i class="bi bi-x-circle-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr class="lc-table-row saved-row" @ondblclick="() => StartEditSchedule(s)" title="Double-click to edit row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@rowSNo</td>
                                                    <td style="white-space: nowrap; vertical-align: middle;">
                                                        <div class="d-flex align-items-center gap-2 flex-nowrap" style="white-space: nowrap;">
                                                            <span class="text-slate-800 font-bold" style="font-size: 11.5px;">@FormatScheduleDisplayTime(s.scheduled_time)</span>
                                                            <span class="tag-shift-indigo">@s.shift</span>
                                                        </div>
                                                    </td>
                                                    <td style="white-space: nowrap; vertical-align: middle;">
                                                        <div style="display: flex; flex-direction: row; align-items: center; gap: 8px; flex-wrap: nowrap;">
                                                            <span class="font-bold text-slate-800" style="font-size: 12px; display: inline-block; max-width: 175px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@s.item_name">@s.item_name</span>
                                                            <span class="badge @GetScheduleTypeBadge(s.item_type)" style="font-size: 9px; font-weight: 750; flex-shrink: 0; padding: 2.5px 6px; letter-spacing: 0.3px;">@s.item_type</span>
                                                        </div>
                                                    </td>
                                                    <td class="text-slate-700" style="vertical-align: middle; line-height: 1.4; font-size: 11.5px;">
                                                        @(string.IsNullOrWhiteSpace(s.instructions) ? "—" : s.instructions)
                                                    </td>
                                                    <td style="text-align: center; white-space: nowrap; vertical-align: middle;">
                                                        @if (string.Equals(s.status, "COMPLETED", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-1 font-bold" style="font-size: 10px;"><i class="bi bi-check2-circle me-1"></i>COMPLETED</span>
                                                        }
                                                        else if (string.Equals(s.status, "MISSED", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-rose-50 text-rose-700 border border-rose-200 px-2 py-1 font-bold" style="font-size: 10px;"><i class="bi bi-x-circle me-1"></i>MISSED</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-amber-50 text-amber-800 border border-amber-200 px-2 py-1 font-bold" style="font-size: 10px;"><i class="bi bi-hourglass-split me-1"></i>PENDING</span>
                                                        }
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <span class="user-chip-mini">@GetAddedByText(s.usercode)</span>
                                                    </td>
                                                    <td style="text-align: center; white-space: nowrap; vertical-align: middle;">
                                                        <div class="action-buttons-flex justify-content-center">
                                                            @if (string.Equals(s.status, "PENDING", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <button type="button" class="btn-action-icon btn-action-done" title="Mark as Completed" @onclick="() => QuickCompleteScheduleAsync(s)">
                                                                    <i class="bi bi-check-lg"></i>
                                                                </button>
                                                            }
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit row" @onclick="() => StartEditSchedule(s)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            @if (string.Equals(s.status, "PENDING", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <button type="button" class="btn-action-icon btn-action-delete" title="Delete record" @onclick="() => DeleteScheduleAsync(s.schedule_id)">
                                                                    <i class="bi bi-trash-fill"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }

                                        <!-- 2. Active New Input Row (Always at bottom, auto-saves on Enter) -->
                                        <tr class="table-inline-entry-row active-new-row">
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span class="badge-new-entry" title="Next Entry Row">@sNo</span>
                                            </td>
                                            <td style="vertical-align: middle; white-space: nowrap;">
                                                <div class="inline-time-shift-compact">
                                                    <input type="time"
                                                           class="inline-table-input time-input-mini"
                                                           @bind="newSchedTime"
                                                           style="width: 80px; height: 32px; font-size: 11.5px;"
                                                           title="Scheduled Time" />
                                                    <select class="inline-table-select shift-select-mini"
                                                           @bind="newSchedShift"
                                                           style="height: 32px; font-size: 11px;"
                                                           title="Shift">
                                                        <option value="MORNING">Morning</option>
                                                        <option value="AFTERNOON">Afternoon</option>
                                                        <option value="EVENING">Evening</option>
                                                        <option value="NIGHT">Night</option>
                                                    </select>
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle; position: relative; white-space: nowrap;">
                                                <div style="display: flex; flex-direction: row; align-items: center; gap: 6px; flex-wrap: nowrap;">
                                                    <div class="custom-dropdown-wrap position-relative" style="flex: 1; min-width: 0;">
                                                        <input @ref="newSchedNameRef"
                                                               type="text"
                                                               class="inline-table-input font-bold text-indigo-700"
                                                               placeholder="Task / Item name"
                                                               value="@newSchedName"
                                                               @oninput="OnNewSchedNameInput"
                                                               @onclick="OnNewSchedNameClick"
                                                               @onclick:stopPropagation
                                                               @onkeydown="HandleNewSchedNameKeyDown"
                                                               autocomplete="off"
                                                               style="width: 100%; height: 32px; font-size: 11.5px;"
                                                               title="Task / Item Name" />

                                                        @if (isScheduleDropdownOpen)
                                                        {
                                                            <div class="custom-particulars-dropdown shadow-lg" style="min-width: 220px;" @onclick:stopPropagation>
                                                                @{
                                                                    var schItems = GetFilteredScheduleTasks().ToList();
                                                                }
                                                                @if (schItems.Any())
                                                                {
                                                                    @for (int idx = 0; idx < schItems.Count; idx++)
                                                                    {
                                                                        var sitm = schItems[idx];
                                                                        var isHigh = idx == highlightedScheduleIndex;
                                                                        <div class="particular-dropdown-item @(isHigh ? "highlighted" : "")"
                                                                             @onclick="() => SelectNewScheduleTask(sitm.type_name)"
                                                                             @onmouseenter="() => highlightedScheduleIndex = idx">
                                                                            <span class="particular-item-name">@sitm.type_name</span>
                                                                            <span class="particular-type-tag type-input">SCHEDULE</span>
                                                                        </div>
                                                                    }
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                    <select class="inline-table-select"
                                                            @bind="newSchedType"
                                                            style="height: 32px; font-size: 10.5px; font-weight: 700; width: 92px; flex-shrink: 0;"
                                                            title="Schedule Type">
                                                        <option value="MEDICINE">MEDICINE</option>
                                                        <option value="DIET">DIET</option>
                                                        <option value="PROCEDURE">PROCEDURE</option>
                                                        <option value="OTHER">OTHER</option>
                                                    </select>
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input type="text"
                                                       class="inline-table-input"
                                                       placeholder="Instructions (e.g. Give 30m before food)..."
                                                       @bind="newSchedInstructions"
                                                       @bind:event="oninput"
                                                       style="width: 100%; height: 32px; font-size: 11.5px;"
                                                       title="Special Instructions" />
                                            </td>
                                            <td style="vertical-align: middle; text-align: center;">
                                                <select class="inline-table-select font-bold"
                                                        @bind="newSchedStatus"
                                                        @onkeydown="HandleNewSchedKeyDown"
                                                        style="width: 100%; height: 32px; font-size: 11px; padding: 2px 4px; text-align: center;"
                                                        title="Initial Status">
                                                    <option value="PENDING">PENDING</option>
                                                    <option value="COMPLETED">COMPLETED</option>
                                                    <option value="MISSED">MISSED</option>
                                                </select>
                                            </td>
                                            <td style="vertical-align: middle; text-align: center; white-space: nowrap;">
                                                <div class="d-flex justify-content-center">
                                                    <span class="user-chip-mini" title="Logged-in User">
                                                        <i class="bi bi-person-check-fill me-1 text-indigo-500"></i>
                                                        @(string.IsNullOrWhiteSpace(currentUserName) ? "Duty Staff" : currentUserName)
                                                    </span>
                                                </div>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                <button type="button" class="badge-enter-key" @onclick="SaveNewSchedInlineAsync" title="Save record (or press Enter on keyboard)">
                                                    <i class="bi bi-arrow-return-left"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 8: REFERRED TO VISITING DOCTORS                                 *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "referred_visiting_doctors")
                {
                    <div class="tab-section-flow">
                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-person-check-fill text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Referred Doctors</span>
                                </div>
                                <span class="table-pill-count">@GetReferredVisitingDoctorList().Count @(GetReferredVisitingDoctorList().Count == 1 ? "Doctor" : "Doctors")</span>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 60px; text-align: center;">S.NO.</th>
                                            <th style="width: 260px;">NAME OF VISITING DOCTOR</th>
                                            <th style="width: 220px;">QUALIFICATION</th>
                                            <th>REFERRED NOTES</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var refDocList = GetReferredVisitingDoctorList();
                                        }
                                        @if (!refDocList.Any())
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center p-48 text-slate-400 italic">
                                                    <i class="bi bi-person-x d-block fs-3 mb-1 text-slate-300"></i>
                                                    <span>No visiting doctors have been referred for this patient in the OP/IP Case Sheet.</span>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int sNo = 1;
                                            @foreach (var docItem in refDocList)
                                            {
                                                var docMaster = GetDoctorMaster(docItem.dcode, docItem.doctor_name);
                                                var imgSrc = GetDoctorImageSrc(docMaster);
                                                var qual = GetDoctorQualification(docItem.dcode, docItem.doctor_name);
                                                <tr class="lc-table-row">
                                                    <td style="text-align: center; vertical-align: middle;" class="font-bold text-slate-500">@(sNo++)</td>
                                                    <td style="vertical-align: middle; white-space: nowrap;">
                                                        <div style="display: inline-flex; flex-direction: row; align-items: center; gap: 10px; vertical-align: middle;">
                                                            @if (!string.IsNullOrWhiteSpace(imgSrc))
                                                            {
                                                                <img src="@imgSrc" alt="@docItem.doctor_name" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1.5px solid #cbd5e1; flex-shrink: 0;" />
                                                            }
                                                            else
                                                            {
                                                                <div style="background: #e0e7ff; color: #4338ca; width: 32px; height: 32px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; flex-shrink: 0; text-transform: uppercase;">
                                                                    @GetDoctorInitialLetter(docItem.doctor_name)
                                                                </div>
                                                            }
                                                            <span class="font-bold text-indigo-700 fs-7" style="line-height: 1; display: inline-block;">@docItem.doctor_name</span>
                                                        </div>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        @if (!string.IsNullOrWhiteSpace(qual) && qual != "—")
                                                        {
                                                            <span class="badge bg-slate-100 text-slate-700 border px-2 py-1" style="font-size: 11px; font-weight: 600;">@qual</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-slate-400">—</span>
                                                        }
                                                    </td>
                                                    <td class="text-slate-800" style="white-space: pre-wrap; line-height: 1.5; vertical-align: middle;">
                                                        @(string.IsNullOrWhiteSpace(docItem.notes) ? "—" : docItem.notes)
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 9: OTHER NOTES                                                  *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "other")
                {
                    <div class="tab-section-flow">
                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-file-earmark-text text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">General Progress Notes History</span>
                                    <span class="table-pill-count ms-1">@otherList.Count @(otherList.Count == 1 ? "Note" : "Notes")</span>
                                </div>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 45px; text-align: center;">S.NO.</th>
                                            <th style="width: 145px; white-space: nowrap;">TIME &amp; SHIFT</th>
                                            <th style="min-width: 160px;">NURSING OBSERVATION / PROGRESS NOTE</th>
                                            <th style="width: 115px; text-align: center; white-space: nowrap;">RECORDED BY</th>
                                            <th style="width: 85px; min-width: 85px; text-align: center; white-space: nowrap;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sNo = 1;
                                        }
                                        <!-- 1. Previously Saved Rows in Chronological Order -->
                                        @foreach (var o in otherList.OrderBy(x => x.created_at))
                                        {
                                            var rowSNo = sNo++;
                                            var isEditing = editingOtherId == o.other_id;
                                            if (isEditing)
                                            {
                                                <tr class="table-inline-entry-row is-inline-editing">
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <span class="badge-edit-mode">EDIT @rowSNo</span>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <div class="inline-time-shift-wrap">
                                                            <span class="font-bold text-slate-800">@FormatEntryTime(o.entry_time, o.created_at)</span>
                                                            <select class="inline-table-select shift-select" @bind="otherShift" @onkeydown="(e) => HandleExistingOtherKeyDown(e, o)">
                                                                <option value="MORNING">Morning</option>
                                                                <option value="AFTERNOON">Afternoon</option>
                                                                <option value="EVENING">Evening</option>
                                                                <option value="NIGHT">Night</option>
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <input type="text" class="inline-table-input font-bold" @bind="otherNoteText" @bind:event="oninput" @onkeydown="(e) => HandleExistingOtherKeyDown(e, o)" />
                                                    </td>
                                                    <td style="vertical-align: middle;">
                                                        <span class="user-chip-mini">@GetAddedByText(o.usercode)</span>
                                                    </td>
                                                    <td style="text-align: center; vertical-align: middle; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center gap-1">
                                                            <button type="button" class="btn-action-icon btn-action-save" title="Save changes" @onclick="() => SaveExistingOtherAsync(o)">
                                                                <i class="bi bi-check-circle-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Cancel Edit" @onclick="CancelEditOther">
                                                                <i class="bi bi-x-circle-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr class="lc-table-row saved-row" @ondblclick="() => StartEditOther(o)" title="Double-click to edit row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@rowSNo</td>
                                                    <td>
                                                        <span class="font-bold text-slate-800">@FormatEntryTime(o.entry_time, o.created_at)</span>
                                                        <span class="tag-shift-indigo ms-2">@o.shift</span>
                                                    </td>
                                                    <td class="font-bold text-slate-800">@o.note</td>
                                                    <td class="text-slate-600">@GetAddedByText(o.usercode)</td>
                                                    <td style="text-align: center; white-space: nowrap;">
                                                        <div class="action-buttons-flex justify-content-center">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit row" @onclick="() => StartEditOther(o)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Delete record" @onclick="() => DeleteOtherAsync(o.other_id)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }

                                        <!-- 2. Active New Input Row (Always at bottom, auto-saves on Enter) -->
                                        <tr class="table-inline-entry-row active-new-row">
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span class="badge-new-entry" title="Next Entry Row">@sNo</span>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <div class="inline-time-shift-wrap">
                                                    <input type="text"
                                                           class="inline-table-input time-input"
                                                           placeholder="05:45 PM"
                                                           @bind="newOtherTime"
                                                           title="Time" />
                                                    <select class="inline-table-select shift-select"
                                                            @bind="newOtherShift"
                                                            title="Shift">
                                                        <option value="MORNING">Morning</option>
                                                        <option value="AFTERNOON">Afternoon</option>
                                                        <option value="EVENING">Evening</option>
                                                        <option value="NIGHT">Night</option>
                                                    </select>
                                                </div>
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <input @ref="newOtherNoteRef"
                                                       type="text"
                                                       class="inline-table-input font-bold text-slate-800 remarks-input"
                                                       placeholder="Type nursing observation / progress note & press Enter to save..."
                                                       @bind="newOtherNoteText"
                                                       @bind:event="oninput"
                                                       @onkeydown="HandleNewOtherKeyDown"
                                                       title="Nursing Progress Note" />
                                            </td>
                                            <td style="vertical-align: middle;">
                                                <div class="inline-recorded-by">
                                                    <span class="user-chip-mini" title="Logged-in User">
                                                        <i class="bi bi-person-check-fill me-1 text-indigo-500"></i>
                                                        @(string.IsNullOrWhiteSpace(currentUserName) ? "Duty Staff" : currentUserName)
                                                    </span>
                                                </div>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <button type="button" class="badge-enter-key" @onclick="SaveNewOtherInlineAsync" title="Save record (or press Enter on keyboard)">
                                                    <i class="bi bi-arrow-return-left"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ============================================================================= -->
    <!-- BOTTOM-RIGHT UPCOMING SCHEDULE NOTIFICATION POPUP (PREMIUM GLASSMORPHIC UI)   -->
    <!-- ============================================================================= -->
    @if (activeScheduleAlerts.Any())
    {
        <div class="schedule-alerts-fixed-container" @onclick:stopPropagation>
            @foreach (var alert in activeScheduleAlerts)
            {
                <div class="schedule-alert-popup-card shadow-2xl lc-fadeInUp" @key="alert.Schedule.schedule_id">
                    <!-- Glowing Top Accent Line -->
                    <div class="schedule-alert-top-bar"></div>

                    <!-- Alert Header with Radar Ripple Beacon -->
                    <div class="schedule-alert-header">
                        <div class="d-flex align-items-center gap-2">
                            <div class="beacon-wrap">
                                <span class="beacon-radar"></span>
                                <span class="beacon-core"></span>
                            </div>
                            <div class="schedule-alert-title-wrap">
                                <span class="schedule-alert-main-title">
                                    <i class="bi bi-bell-fill text-rose-600 me-1"></i>
                                    SCHEDULE ALERT
                                </span>
                                <span class="schedule-alert-countdown-badge">
                                    @(alert.MinutesRemaining <= 0 ? "DUE NOW" : $"IN {alert.MinutesRemaining} MINS")
                                </span>
                            </div>
                        </div>
                        <button type="button" class="schedule-alert-close-btn" @onclick="() => DismissScheduleAlert(alert.Schedule.schedule_id)" title="Dismiss Notification">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <!-- Alert Body -->
                    <div class="schedule-alert-body">
                        <!-- Patient Info Strip (Clickable to switch patient) -->
                        <div class="schedule-alert-patient-strip" @onclick="() => NavigateToScheduleFromAlertAsync(alert)" title="Click to view this patient">
                            <div class="patient-avatar-mini">
                                @GetInitials(alert.PatientName)
                            </div>
                            <div class="schedule-alert-patient-text">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="schedule-alert-patient-name">@alert.PatientName</span>
                                    <span class="badge-patient-ip">IP: @alert.IpNo</span>
                                </div>
                                <div class="schedule-alert-patient-sub">
                                    <i class="bi bi-geo-alt-fill text-rose-500 me-1" style="font-size: 0.68rem;"></i>
                                    <span>@(string.IsNullOrWhiteSpace(alert.WardBed) ? "General Ward" : alert.WardBed)</span>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right text-slate-400 ms-auto fs-8"></i>
                        </div>

                        <!-- Task & Instructions Card -->
                        <div class="schedule-alert-task-box">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="schedule-type-badge type-@alert.Schedule.item_type?.ToLower()">
                                    <i class="bi bi-tag-fill me-1" style="font-size: 0.6rem;"></i>@alert.Schedule.item_type
                                </span>
                                <span class="schedule-time-text">
                                    <i class="bi bi-clock-fill me-1 text-rose-500"></i>@FormatAlertScheduleTime(alert.Schedule.scheduled_time, alert.Schedule.shift)
                                    <span class="schedule-shift-tag">@alert.Schedule.shift</span>
                                </span>
                            </div>
                            <div class="schedule-task-name-text">@alert.Schedule.item_name</div>
                            
                            <div class="schedule-instructions-box">
                                <div class="instructions-header">
                                    <i class="bi bi-card-text me-1 text-rose-600"></i>
                                    <span>Special Instructions</span>
                                </div>
                                <div class="instructions-content">
                                    @(string.IsNullOrWhiteSpace(alert.Schedule.instructions) ? "Routine patient care procedure / administration" : alert.Schedule.instructions)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Alert Actions Footer -->
                    <div class="schedule-alert-footer">
                        <button type="button" class="btn-schedule-alert-view" @onclick="() => NavigateToScheduleFromAlertAsync(alert)" title="Open patient schedule tab">
                            <i class="bi bi-box-arrow-up-right me-1"></i>
                            <span>Switch &amp; View</span>
                        </button>
                        <button type="button" class="btn-schedule-alert-complete" @onclick="() => CompleteScheduleFromAlertAsync(alert)" title="Mark task completed directly">
                            <i class="bi bi-check2-circle me-1"></i>
                            <span>Mark Completed</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    }

