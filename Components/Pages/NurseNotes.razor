        if (!string.IsNullOrWhiteSpace(note.pain_location)) AddField("Location", note.pain_location);
        if (!string.IsNullOrWhiteSpace(note.pain_type)) AddField("Type", note.pain_type);
        if (!string.IsNullOrWhiteSpace(note.pain_intervention)) AddField("Intervention", note.pain_intervention);
        if (note.pain_after_intervention_score.HasValue) AddField("Score After", note.pain_after_intervention_score.ToString());

        // Patient Movement
        if (!string.IsNullOrWhiteSpace(note.movement_type)) AddField("Movement", note.movement_type);
        if (!string.IsNullOrWhiteSpace(note.from_location)) AddField("From", note.from_location);
        if (!string.IsNullOrWhiteSpace(note.to_location)) AddField("To", note.to_location);
        if (!string.IsNullOrWhiteSpace(note.movement_reason)) AddField("Reason", note.movement_reason);

        // Skin Assessment
