    private async Task EnsureNursesLoadedAsync()
    {
        if (nursesList == null || !nursesList.Any())
        {
            try
            {
                nursesList = await NurseMasterService.GetNurseMastersAsync() ?? new();
                nursesList = nursesList.Where(n => n.deleted != true).ToList();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error fetching nurses: {ex.Message}");
            }
        }
