            weight_kg = v.weight_kg,
            bmi = v.bmi,
            sugar_level = v.sugar_level,
            pain_scale = v.pain_scale,
            hba1c = v.hba1c,
            waist_cm = v.waist_cm,
            hip_cm = v.hip_cm,
            head_circumference_cm = v.head_circumference_cm,
