    min-height: 120px;
}

.lc-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
}

.lc-table thead tr {
    background: #fafbfc;
    border-bottom: 1px solid #e2e8f0;
}

.lc-table-fixed {
