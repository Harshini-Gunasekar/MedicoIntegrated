        isSubmitting = true;
        try
        {
            if (editingTempId.HasValue)
            {
                var req = new UpdateTemperatureRequest
                {
                    temp_id = editingTempId.Value,
                    shift = tempShift,
                    temperature = tempValue.Value,
                    unit = tempUnit,
                    remarks = tempRemarks
                };
                var (ok, msg) = await NurseNotesService.UpdateTemperatureAsync(req, DefaultTenant);
                if (ok)
                {
                    ToastService.ShowSuccess("Temperature record updated.");
                    CancelEditTemp();
                    temperatureList = await NurseNotesService.GetTemperaturesAsync(selectedPatient.ip_id, DefaultTenant);
                }
                else ToastService.ShowError(msg);
            }
            else
            {
                var req = new AddTemperatureRequest
                {
                    ip_id = selectedPatient.ip_id,
                    custid = selectedPatient.custid,
                    shift = tempShift,
                    temperature = tempValue.Value,
                    unit = tempUnit,
                    remarks = tempRemarks
                };
                var (ok, msg) = await NurseNotesService.AddTemperatureAsync(req, DefaultTenant);
                if (ok)
                {
                    ToastService.ShowSuccess("Temperature recorded.");
                    tempValue = null;
                    tempRemarks = "";
                    tempTimeDisplay = DateTime.UtcNow.ToIndianTime().ToString("hh:mm tt");
                    temperatureList = await NurseNotesService.GetTemperaturesAsync(selectedPatient.ip_id, DefaultTenant);
                    try { await JSRuntime.InvokeVoidAsync("focusNurseTabPrimaryField"); } catch { }
                }
                else ToastService.ShowError(msg);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Save failed: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

