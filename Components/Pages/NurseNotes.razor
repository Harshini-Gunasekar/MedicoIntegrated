    private IEnumerable<IPRegistrationModel.IpRegistrationModel> GetFilteredPatients()
    {
        if (string.IsNullOrWhiteSpace(patientSearchText)) return admittedPatients;
        var q = patientSearchText.Trim().ToLower();
        return admittedPatients.Where(p =>
            (!string.IsNullOrWhiteSpace(p.patient_name) && p.patient_name.ToLower().Contains(q)) ||
            (!string.IsNullOrWhiteSpace(p.ip_no) && p.ip_no.ToLower().Contains(q)) ||
            (!string.IsNullOrWhiteSpace(p.mobile) && p.mobile.Contains(q))
        );
    }

