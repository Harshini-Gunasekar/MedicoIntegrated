    // ─────────────────────────────────────────────────────────────────────────
    // SCHEDULE UPCOMING ALERT TIMING & MONITORING (GLOBAL MULTI-PATIENT SUPPORT)
    // ─────────────────────────────────────────────────────────────────────────
    private void StartScheduleAlertMonitoring()
    {
        scheduleAlertTimer?.Dispose();
        scheduleAlertTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                if ((DateTime.UtcNow - lastAllSchedulesFetchTime).TotalSeconds > 15 || !allPatientsSchedulesMap.Any())
                {
                    await RefreshAllPatientsSchedulesAsync();
                }
                EvaluateUpcomingSchedules();
            });
        }, null, TimeSpan.FromMilliseconds(500), TimeSpan.FromSeconds(3));
    }

    private async Task RefreshAllPatientsSchedulesAsync()
    {
        if (admittedPatients == null || !admittedPatients.Any()) return;
        try
        {
            var tasks = admittedPatients.Select(async pat =>
            {
                try
                {
                    var schList = await NurseNotesService.GetSchedulesAsync(pat.ip_id, DefaultTenant, currentUserCode);
                    return (pat.ip_id, schList);
                }
                catch
                {
                    return (pat.ip_id, new List<NurseScheduleModel>());
                }
            });

            var results = await Task.WhenAll(tasks);
            foreach (var (ipId, list) in results)
            {
                allPatientsSchedulesMap[ipId] = list;
            }

            lastAllSchedulesFetchTime = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AllPatientsSchedules] Error: {ex.Message}");
        }
    }

    private void EvaluateUpcomingSchedules()
    {
        try
        {
            var nowIst = DateTime.UtcNow.ToIndianTime();
            var currentAlerts = new List<UpcomingScheduleAlertItem>();

            var schedulesToCheck = new List<(IPRegistrationModel.IpRegistrationModel Patient, NurseScheduleModel Schedule)>();

            if (admittedPatients != null && admittedPatients.Any())
            {
                foreach (var pat in admittedPatients)
                {
                    if (selectedPatient != null && pat.ip_id == selectedPatient.ip_id && scheduleList != null && scheduleList.Any())
                    {
                        foreach (var s in scheduleList)
                        {
                            schedulesToCheck.Add((pat, s));
                        }
                    }
                    else if (allPatientsSchedulesMap.TryGetValue(pat.ip_id, out var patSchedules))
                    {
                        foreach (var s in patSchedules)
                        {
                            schedulesToCheck.Add((pat, s));
                        }
                    }
                }
            }
            else if (selectedPatient != null && scheduleList != null)
            {
                foreach (var s in scheduleList)
                {
                    schedulesToCheck.Add((selectedPatient, s));
                }
            }

            foreach (var (pat, s) in schedulesToCheck.Where(x => string.Equals(x.Schedule.status, "PENDING", StringComparison.OrdinalIgnoreCase)))
            {
                if (dismissedScheduleAlertIds.Contains(s.schedule_id)) continue;

                if (TryParseScheduleDateTime(s, out var schedDt))
                {
                    var diff = schedDt - nowIst;
                    // Trigger starting 5 minutes before scheduled time up to 15 minutes past the fixed time (if still PENDING)
                    if (diff.TotalMinutes <= 5.0 && diff.TotalMinutes >= -15.0)
                    {
                        var wardBed = GetWardBedText(pat.wrdcode, pat.bedcode);
                        currentAlerts.Add(new UpcomingScheduleAlertItem
                        {
                            Schedule = s,
                            Patient = pat,
                            PatientName = pat.patient_name ?? "Patient",
                            IpNo = pat.ip_no ?? "",
                            WardBed = wardBed,
                            IpId = pat.ip_id,
                            ScheduledDateTime = schedDt,
                            MinutesRemaining = Math.Max(0, Math.Ceiling(diff.TotalMinutes))
                        });
                    }
                }
            }

            activeScheduleAlerts = currentAlerts;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ScheduleAlert] Error: {ex.Message}");
        }
    }

    private string FormatAlertScheduleTime(string? timeStr, string? shift)
    {
        if (string.IsNullOrWhiteSpace(timeStr)) return "08:00 AM";
        if (TimeOnly.TryParse(timeStr, out var t))
        {
            return t.ToString("hh:mm tt");
        }
        return timeStr;
    }

    private bool TryParseScheduleDateTime(NurseScheduleModel s, out DateTime result)
    {
        result = DateTime.MinValue;
        if (s == null || string.IsNullOrWhiteSpace(s.scheduled_date)) return false;

        var dateStr = s.scheduled_date.Trim();
        var timeStr = string.IsNullOrWhiteSpace(s.scheduled_time) ? "08:00:00" : s.scheduled_time.Trim();
        var shift = s.shift?.Trim().ToUpperInvariant() ?? "MORNING";

        if (!DateTime.TryParse(dateStr, out var baseDate))
        {
            string[] dFormats = { "yyyy-MM-dd", "dd-MM-yyyy", "yyyy/MM/dd", "dd/MM/yyyy" };
            if (!DateTime.TryParseExact(dateStr, dFormats, CultureInfo.InvariantCulture, DateTimeStyles.None, out baseDate))
            {
                return false;
            }
        }

        // Parse time component
        TimeSpan timeSpan;
        if (!TimeSpan.TryParse(timeStr, out timeSpan))
        {
            if (DateTime.TryParse(timeStr, out var dtTime))
            {
                timeSpan = dtTime.TimeOfDay;
            }
            else
            {
                timeSpan = TimeSpan.FromHours(8);
            }
        }

        int hours = timeSpan.Hours;
        int minutes = timeSpan.Minutes;
        int seconds = timeSpan.Seconds;

        // Shift-aware 12hr -> 24hr smart normalization:
        if (shift == "NIGHT")
        {
            if (hours == 12)
            {
                // 12:00 at night is midnight:
                // Check if current IST is closer to end of baseDate (20:00+)
                var nowIst = DateTime.UtcNow.ToIndianTime();
                if (nowIst.Date == baseDate.Date && nowIst.Hour >= 20)
                {
                    result = baseDate.Date.AddDays(1).AddMinutes(minutes).AddSeconds(seconds);
                    return true;
                }
                else
                {
                    result = baseDate.Date.AddMinutes(minutes).AddSeconds(seconds);
                    return true;
                }
            }
            else if (hours >= 8 && hours <= 11)
            {
                // 08:00 PM to 11:59 PM
                hours += 12;
            }
            // For hours 0 to 7 (e.g. 00:25 or 01:00 AM), baseDate is already the exact date!
        }
        else if (shift == "EVENING")
        {
            // 04:00 to 11:00 in EVENING shift means 16:00 to 23:00 (PM)
            if (hours >= 1 && hours <= 11)
            {
                hours += 12;
            }
        }
        else if (shift == "AFTERNOON")
        {
            // 01:00 to 06:00 in AFTERNOON shift means 13:00 to 18:00 (PM)
            if (hours >= 1 && hours <= 6)
            {
                hours += 12;
            }
        }

        result = baseDate.Date.AddHours(hours).AddMinutes(minutes).AddSeconds(seconds);
        return true;
    }

    private void DismissScheduleAlert(Guid scheduleId)
    {
        dismissedScheduleAlertIds.Add(scheduleId);
        activeScheduleAlerts.RemoveAll(x => x.Schedule.schedule_id == scheduleId);
        StateHasChanged();
    }

    private async Task CompleteScheduleFromAlertAsync(UpcomingScheduleAlertItem item)
    {
        dismissedScheduleAlertIds.Add(item.Schedule.schedule_id);
        activeScheduleAlerts.RemoveAll(x => x.Schedule.schedule_id == item.Schedule.schedule_id);

        try
        {
            var req = new UpdateScheduleRequest
            {
                schedule_id = item.Schedule.schedule_id,
                shift = item.Schedule.shift ?? "MORNING",
                scheduled_date = item.Schedule.scheduled_date,
                scheduled_time = NurseNotesService.FormatTimeForApi(item.Schedule.scheduled_time, "08:00:00"),
                item_type = item.Schedule.item_type,
                item_name = item.Schedule.item_name,
                instructions = item.Schedule.instructions,
                status = "COMPLETED",
                remarks = item.Schedule.remarks
            };
            var (ok, msg) = await NurseNotesService.UpdateScheduleAsync(req, DefaultTenant, currentUserCode);
            if (ok)
            {
                ToastService.ShowSuccess($"Task marked COMPLETED for {item.PatientName}: {item.Schedule.item_name}");

                if (allPatientsSchedulesMap.TryGetValue(item.IpId, out var schList))
                {
                    var match = schList.FirstOrDefault(x => x.schedule_id == item.Schedule.schedule_id);
                    if (match != null) match.status = "COMPLETED";
                }
                if (selectedPatient != null && selectedPatient.ip_id == item.IpId)
                {
                    scheduleList = await NurseNotesService.GetSchedulesAsync(selectedPatient.ip_id, DefaultTenant, currentUserCode);
                }
                EvaluateUpcomingSchedules();
            }
            else
            {
                ToastService.ShowError(msg);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task NavigateToScheduleFromAlertAsync(UpcomingScheduleAlertItem item)
    {
        dismissedScheduleAlertIds.Add(item.Schedule.schedule_id);
        activeScheduleAlerts.RemoveAll(x => x.Schedule.schedule_id == item.Schedule.schedule_id);

        if (selectedPatient == null || selectedPatient.ip_id != item.IpId)
        {
            var targetPat = admittedPatients.FirstOrDefault(x => x.ip_id == item.IpId) ?? item.Patient;
            if (targetPat != null)
            {
                await SelectPatientFromModal(targetPat);
            }
        }

        activeTab = "schedule";
        StateHasChanged();
    }

    public void Dispose()
    {
        scheduleAlertTimer?.Dispose();
    }
}

<script>
    window.initNurseNotesNavigation = function () {
        document.removeEventListener('keydown', window._nurseEnterHandler);
        window._nurseEnterHandler = function (e) {
            if (e.key !== 'Enter') return;
            const target = e.target;
            if (!target) return;
            
            // Ignore search inputs, popovers, custom dropdown inputs, modals, or buttons
            if (target.classList.contains('lc-rounded-pill-input') || 
                target.closest('.patient-search-relative') ||
                target.closest('.custom-dropdown-wrap') ||
                (target.closest && target.closest('.casesheet-modal')) || 
                (target.closest && target.closest('.add-particular-modal-card')) || 
                (target.closest && target.closest('.add-service-modal-card')) || 
                (target.closest && target.closest('.add-schedule-type-modal-card')) || 
                (target.closest && target.closest('.ip-patients-modal-container')) || 
                target.tagName === 'BUTTON') {
                return;
            }

            const row = target.closest('.form-horizontal-row, .vitals-grid-row');
            if (!row) return;

            const fields = Array.from(row.querySelectorAll('input:not([disabled]):not([type=hidden]):not([readonly]), select:not([disabled])'));
            const idx = fields.indexOf(target);
            if (idx >= 0 && idx < fields.length - 1) {
                e.preventDefault();
                target.dispatchEvent(new Event('input', { bubbles: true }));
                target.dispatchEvent(new Event('change', { bubbles: true }));
                const nextField = fields[idx + 1];
                nextField.focus();
                if (nextField.select) nextField.select();
            } else if (idx === fields.length - 1) {
                e.preventDefault();
                target.dispatchEvent(new Event('input', { bubbles: true }));
                target.dispatchEvent(new Event('change', { bubbles: true }));
                target.blur();
                setTimeout(function () {
                    const btn = row.querySelector('.btn-indigo-action');
                    if (btn && !btn.disabled) {
                        btn.click();
                    }
                }, 60);
            }
        };
        document.addEventListener('keydown', window._nurseEnterHandler);
    };

