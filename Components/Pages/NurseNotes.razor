    private async Task LoadSessionData()
    {
        try
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success && !string.IsNullOrEmpty(tenantCodeResult.Value) ? tenantCodeResult.Value : (TenantState?.TenantCode ?? "0010");

            var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
            if (!tokenResult.Success || string.IsNullOrEmpty(tokenResult.Value))
            {
                tokenResult = await _sessionStorage.GetAsync<string>("auth_token");
            }
            AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : (TenantState?.AuthToken ?? "");

            if (!string.IsNullOrWhiteSpace(TenantState?.UserData?.UserName))
            {
                currentUserName = TenantState.UserData.UserName;
            }

            try
            {
                var userDetailsRes = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                if (userDetailsRes.Success && userDetailsRes.Value != null && !string.IsNullOrWhiteSpace(userDetailsRes.Value.UserName))
                {
                    currentUserName = userDetailsRes.Value.UserName;
                }
            }
            catch { }

            if (string.IsNullOrWhiteSpace(currentUserName))
            {
                var userResult = await _sessionStorage.GetAsync<string>("user_name");
                if (userResult.Success && !string.IsNullOrWhiteSpace(userResult.Value))
                {
                    currentUserName = userResult.Value;
                }
            }

            // Restore active tab
            if (!string.IsNullOrWhiteSpace(QueryTab) && IsValidTab(QueryTab))
            {
                activeTab = QueryTab.ToLower();
            }
            else
            {
                var savedTabResult = await _sessionStorage.GetAsync<string>("nurse_notes_active_tab");
                if (savedTabResult.Success && !string.IsNullOrWhiteSpace(savedTabResult.Value) && IsValidTab(savedTabResult.Value))
                {
                    activeTab = savedTabResult.Value.ToLower();
                }
            }

            // Restore saved patient ID only if explicitly provided in query params
            if (!string.IsNullOrWhiteSpace(QueryIpId))
            {
                savedIpId = QueryIpId;
            }
            else
            {
                savedIpId = null;
            }

            // Restore pagination option per tenant
            try
            {
                var tenant = string.IsNullOrWhiteSpace(DefaultTenant) ? (TenantState?.TenantCode ?? "0010") : DefaultTenant;
                var key = $"nurse_notes_pagination_{tenant}";
                var paginationResult = await _sessionStorage.GetAsync<string>(key);
                if (paginationResult.Success && !string.IsNullOrWhiteSpace(paginationResult.Value))
                {
                    paginationOption = paginationResult.Value;
                }
            }
            catch { }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NurseNotes] LoadSessionData error: {ex.Message}");
        }
    }

    private bool IsValidTab(string tab)
    {
        var t = tab.ToLower();
        return t == "temperature" || t == "vitals" || t == "input_output" || t == "service" || t == "medicine" || t == "other" || t == "visiting_doctor" || t == "schedule" || t == "referred_visiting_doctors";
    }

    private string GetCurrentShiftName()
    {
        var istNow = DateTime.UtcNow.ToIndianTime();
        int hour = istNow.Hour;
        if (hour >= 6 && hour < 14) return "MORNING";
        if (hour >= 14 && hour < 22) return "EVENING";
        return "NIGHT";
    }

    private void CalculateCurrentShift()
    {
        var istNow = DateTime.UtcNow.ToIndianTime();
        int hour = istNow.Hour;
        string shiftName = "MORNING";
        if (hour >= 6 && hour < 14)
        {
            currentShiftDisplay = "Morning Shift";
            shiftName = "MORNING";
        }
        else if (hour >= 14 && hour < 22)
        {
            currentShiftDisplay = "Evening Shift";
            shiftName = "EVENING";
        }
        else
        {
            currentShiftDisplay = "Night Shift";
            shiftName = "NIGHT";
        }

        tempShift = newTempShift = vitalShift = newVitShift = ioShift = newIoShift = serviceShift = newServiceShift = medShift = newMedShift = otherShift = newOtherShift = visitShift = newVisitShift = scheduleShift = newSchedShift = shiftName;
    }

    private async Task LoadReferenceDataAsync()
    {
        try
        {
            var t1 = DoctorService.GetDoctorsAsync();
            var t2 = WardMasterService.GetWardMastersAsync();
            var t3 = BedMasterService.GetBedMastersAsync();
            var t4 = LoadIoParticularsMasterAsync();
            var t5 = LoadServiceNamesMasterAsync();
            var t6 = LoadInventoryItemsAsync();
            var t7 = LoadDoctorSpecialtiesAsync();
            var t8 = LoadScheduleTypesMasterAsync();
            await Task.WhenAll(t1, t2, t3, t4, t5, t6, t7, t8);

            doctorsList = t1.Result ?? new();
            wardsList = t2.Result ?? new();
            bedsList = t3.Result ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NurseNotes] LoadReferenceDataAsync error: {ex.Message}");
        }
    }

