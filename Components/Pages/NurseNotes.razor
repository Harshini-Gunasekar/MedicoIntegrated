/* ─────────────────────────────────────────────────────────────────────────────
   ENHANCED PARTICULARS DROPDOWN & HIGHLIGHTED RIGHT-EDGE + BUTTON
   ───────────────────────────────────────────────────────────────────────────── */
.custom-dropdown-wrap {
    position: relative;
    width: 100%;
}

.btn-input-edge-add {
    position: absolute;
    right: 5px;
    top: 50%;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    border: none;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 1px 3px rgba(79, 70, 229, 0.35);
    transition: all 0.15s ease;
    z-index: 5;
    padding: 0;
}

.btn-input-edge-add:hover {
    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 2px 6px rgba(79, 70, 229, 0.5);
}

[data-theme="dark"] .btn-input-edge-add {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
}

.custom-particulars-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    width: 100%;
    min-width: 320px;
    max-height: 270px;
    overflow-y: auto;
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    box-shadow: 0 16px 36px -4px rgba(0, 0, 0, 0.22), 0 8px 16px -6px rgba(0, 0, 0, 0.12);
    z-index: 99999 !important;
    padding: 4px;
}

.particular-dropdown-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 12.5px;
    font-weight: 500;
    color: #1e293b;
    transition: all 0.12s ease;
    border-bottom: 1px solid #f8fafc;
}

.particular-dropdown-item:last-child {
    border-bottom: none;
}

.particular-dropdown-item:hover,
.particular-dropdown-item.highlighted {
    background: #eef2ff;
    color: #3730a3;
    font-weight: 600;
}

.particular-item-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 8px;
}

.particular-type-tag {
    font-size: 9.5px;
    font-weight: 800;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.5px;
}

.particular-type-tag.type-input {
    background: #eff6ff;
    color: #2563eb;
    border: 1px solid #bfdbfe;
}

.particular-type-tag.type-output {
    background: #fff7ed;
    color: #ea580c;
    border: 1px solid #fed7aa;
}

.particular-type-tag.type-both {
    background: #f5f3ff;
    color: #7c3aed;
    border: 1px solid #ddd6fe;
}

.particular-no-results {
    padding: 10px;
    font-size: 12px;
    color: #475569;
    text-align: center;
    cursor: pointer;
    border-radius: 6px;
    transition: background 0.15s ease;
}

.particular-no-results:hover {
    background: #eef2ff;
    color: #4f46e5;
}

/* Quick Add IO Particular Modal */
.add-particular-modal-card {
