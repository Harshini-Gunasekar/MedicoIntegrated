    private RenderFragment RenderNoteFields(NurseNotesModel note) => builder =>
    {
        int seq = 0;

        void AddField(string label, string? value)
        {
            if (string.IsNullOrWhiteSpace(value)) return;
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "nn-field");
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "nn-field-label");
            builder.AddContent(seq++, label);
            builder.CloseElement();
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "nn-field-value");
            builder.AddContent(seq++, value);
            builder.CloseElement();
            builder.CloseElement();
        }

        // Fall Risk
        if (note.fall_risk_score.HasValue) AddField("Risk Score", note.fall_risk_score.ToString());
        if (!string.IsNullOrWhiteSpace(note.fall_risk_level)) AddField("Risk Level", note.fall_risk_level);
        if (!string.IsNullOrWhiteSpace(note.fall_risk_scale)) AddField("Scale", note.fall_risk_scale);
        if (!string.IsNullOrWhiteSpace(note.fall_precautions)) AddField("Precautions", note.fall_precautions);
        if (note.fall_occurred.HasValue) AddField("Fall Occurred", note.fall_occurred.Value ? "Yes" : "No");
        if (!string.IsNullOrWhiteSpace(note.fall_incident_details)) AddField("Incident", note.fall_incident_details);

        // Dressing
        if (!string.IsNullOrWhiteSpace(note.dressing_site)) AddField("Site", note.dressing_site);
        if (!string.IsNullOrWhiteSpace(note.wound_type)) AddField("Wound Type", note.wound_type);
        if (note.wound_length.HasValue) AddField("L×W×D", $"{note.wound_length}×{note.wound_width}×{note.wound_depth} cm");
        if (!string.IsNullOrWhiteSpace(note.wound_condition)) AddField("Condition", note.wound_condition);
        if (!string.IsNullOrWhiteSpace(note.wound_discharge)) AddField("Discharge", note.wound_discharge);
        if (note.bleeding.HasValue) AddField("Bleeding", note.bleeding.Value ? "Yes" : "No");
        if (note.infection_sign.HasValue) AddField("Infection Signs", note.infection_sign.Value ? "Yes" : "No");
        if (!string.IsNullOrWhiteSpace(note.dressing_status)) AddField("Status", note.dressing_status);

        // Medication
        if (!string.IsNullOrWhiteSpace(note.medication_status)) AddField("Med Status", note.medication_status);
        if (note.scheduled_time.HasValue) AddField("Scheduled", note.scheduled_time.Value.ToLocalTime().ToString("hh:mm tt"));
        if (note.given_time.HasValue) AddField("Given At", note.given_time.Value.ToLocalTime().ToString("hh:mm tt"));

        // Intake/Output
        if (note.oral_intake_ml.HasValue) AddField("Oral Intake", $"{note.oral_intake_ml} mL");
        if (note.iv_fluid_ml.HasValue) AddField("IV Fluid", $"{note.iv_fluid_ml} mL");
        if (note.urine_ml.HasValue) AddField("Urine", $"{note.urine_ml} mL");
        if (note.vomit_ml.HasValue) AddField("Vomit", $"{note.vomit_ml} mL");
        if (note.drain_ml.HasValue) AddField("Drain", $"{note.drain_ml} mL");
        if (note.stool_count.HasValue) AddField("Stool", $"{note.stool_count} times");
        if (note.total_output_ml.HasValue) AddField("Total Out", $"{note.total_output_ml} mL");

        // Oxygen
        if (!string.IsNullOrWhiteSpace(note.oxygen_device)) AddField("O2 Device", note.oxygen_device);
        if (note.oxygen_flow_rate.HasValue) AddField("Flow Rate", $"{note.oxygen_flow_rate} {note.oxygen_flow_unit}");
        if (note.fio2.HasValue) AddField("FiO2", $"{note.fio2}%");
        if (!string.IsNullOrWhiteSpace(note.oxygen_status)) AddField("O2 Status", note.oxygen_status);

        // Pain
        if (note.pain_present.HasValue) AddField("Pain Present", note.pain_present.Value ? "Yes" : "No");
        if (!string.IsNullOrWhiteSpace(note.pain_location)) AddField("Pain Location", note.pain_location);
        if (note.pain_after_intervention_score.HasValue) AddField("Pain Score After", note.pain_after_intervention_score.ToString());

        // General
        if (!string.IsNullOrWhiteSpace(note.notes)) AddField("Notes", note.notes);
    };
