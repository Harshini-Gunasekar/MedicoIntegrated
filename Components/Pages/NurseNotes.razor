    text-overflow: ellipsis;
}

.nurse-duty-chip {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 4px 14px 4px 5px;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 9999px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.03);
