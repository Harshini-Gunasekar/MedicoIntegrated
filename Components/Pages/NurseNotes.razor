            if (timeField) {
                timeField.focus();
            }
        }, 50);
    };

    window.focusNextFieldFromScheduleTask = function () {
        setTimeout(function () {
            const row = document.querySelector('.nurse-workspace-card .form-two-row-grid');
            if (!row) return;
            const instField = row.querySelector('.form-horizontal-row:nth-child(2) input');
            if (instField) {
                instField.focus();
                if (instField.select) instField.select();
            }
        }, 50);
    };

    window.focusNurseTabPrimaryField = function () {
        setTimeout(function () {
            const activeCard = document.querySelector('.nurse-workspace-card');
            if (!activeCard) return;
            const firstField = activeCard.querySelector('.form-horizontal-row input:not([disabled]):not([type=hidden]):not([readonly]), .vitals-grid-row input:not([disabled]):not([type=hidden])');
            if (firstField) {
                firstField.focus();
                if (firstField.select) firstField.select();
            }
        }, 150);
    };
</script>
