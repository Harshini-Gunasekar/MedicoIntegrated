    private string GetPatientAgeGenderFor(IPRegistrationModel.IpRegistrationModel pat)
    {
        if (pat == null) return "45 Y / Male";
        var cust = customersList.FirstOrDefault(c => c.custid == pat.custid);
        if (cust != null)
        {
            string ageStr = cust.ageyears > 0 ? $"{cust.ageyears} Y" : "";
            string genderStr = !string.IsNullOrWhiteSpace(cust.gender) ? cust.gender : "";
            if (!string.IsNullOrEmpty(ageStr) && !string.IsNullOrEmpty(genderStr))
                return $"{ageStr} / {genderStr}";
            if (!string.IsNullOrEmpty(ageStr)) return ageStr;
            if (!string.IsNullOrEmpty(genderStr)) return genderStr;
        }
        return "45 Y / Male";
    }

