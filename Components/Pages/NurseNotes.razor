@page "/ip/nurse-notes"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using medico_backend.Model
@using Medico_Backend.Model
@using static medico_backend.Model.IpBedsideChartModel
@using Booking.Services
@using Booking.Models
@using Booking.Helpers
@using System.Globalization

@inject NurseNotesService NurseNotesService
@inject NurseNotesMasterService NotesMasterService
@inject NurseMasterService NurseMasterService
@inject IpRegistrationService IpService
@inject DoctorService DoctorService
@inject DoctorSpecialtyMasterService SpecialtyService
@inject WardMasterService WardMasterService
@inject BedMasterService BedMasterService
@inject AppointmentBookingService AppointmentBookingService
@inject CaseSheetService CaseSheetService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory ClientFactory
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>IP Nurse Notes — Bedside Chart</PageTitle>

<div class="referral-page lc-fadeInUp" @onclick="HandlePageClick">
    <!-- ========================================================================= -->
    <!-- 1. HEADER CONSOLE (BED TRANSFER MASTER THEMED)                            -->
    <!-- ========================================================================= -->
    <div class="lab-header-card mb-3">
        <div class="header-left-wrap">
            <div class="header-icon-box">
                <i class="bi bi-clipboard2-pulse text-indigo-600 fs-4"></i>
            </div>
            <div>
                <h2 class="lab-title-text m-0">IP Nurse Notes</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Bedside Clinical Observation &amp; Care Chart</span>
                </div>
            </div>
        </div>

        <div class="header-right-wrap">
            <!-- IP Patients Button (LEFT OF SEARCH BAR) -->
            <button type="button" class="btn-ip-patients-nav" @onclick="OpenIpPatientsModal" title="View all admitted IP patients list">
                <i class="bi bi-people-fill me-1.5"></i>
                <span>IP Patients</span>
                <span class="ip-count-badge">@admittedPatients.Count</span>
            </button>

            <!-- Patient Search Autocomplete Pill Box -->
            <div class="patient-search-relative" @onclick:stopPropagation>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon-svg">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text"
                       placeholder="Search patient name / IP / mobile..."
                       class="lc-rounded-pill-input"
                       @bind="patientSearchText"
                       @bind:event="oninput"
                       @onfocus="() => { isPatientDropdownOpen = true; highlightedPatientIndex = 0; }"
                       @onkeydown="HandlePatientSearchKeyDown" />
                @if (!string.IsNullOrEmpty(patientSearchText))
                {
                    <button type="button" class="btn-search-clear" @onclick="ClearPatientSearch" title="Clear">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }

                @if (isPatientDropdownOpen)
                {
                    <div class="patient-search-popover shadow-lg">
                        <div class="popover-header">
                            <span>Admitted In-Patients (@GetFilteredPatients().Count())</span>
                        </div>
                        <div class="popover-list">
                            @if (isLoadingPatients)
                            {
                                <div class="p-3 text-center text-muted">
                                    <span class="spinner-border spinner-border-sm text-indigo-600 me-2"></span>
                                    <span>Loading admitted patients...</span>
                                </div>
                            }
                            else if (!GetFilteredPatients().Any())
                            {
                                <div class="p-4 text-center text-muted">
                                    <i class="bi bi-person-x fs-3 text-secondary d-block mb-1"></i>
                                    <span>No matching admitted in-patients found.</span>
                                </div>
                            }
                            else
                            {
                                var pList = GetFilteredPatients().ToList();
                                @for (int pIdx = 0; pIdx < pList.Count; pIdx++)
                                {
                                    var pat = pList[pIdx];
                                    var isCurrent = selectedPatient?.ip_id == pat.ip_id;
                                    var isHigh = pIdx == highlightedPatientIndex;
                                    <div class="popover-patient-item @(isCurrent ? "active-pat" : "") @(isHigh ? "highlighted-pat" : "")" 
                                         @onclick="() => SelectPatientFromDropdown(pat)"
                                         @onmouseenter="() => highlightedPatientIndex = pIdx">
                                        <div class="popover-avatar">@GetInitials(pat.patient_name)</div>
                                        <div class="popover-details">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="popover-pat-name">@pat.patient_name</span>
                                                <span class="popover-ip-badge">@pat.ip_no</span>
                                            </div>
                                            <div class="popover-sub-meta">
                                                <span><i class="bi bi-door-open me-1"></i>@GetWardBedText(pat.wrdcode, pat.bedcode)</span>
                                                <span class="ms-2"><i class="bi bi-person-badge me-1"></i>@GetDoctorName(pat.dcode)</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Nurse On Duty Chip -->
            <div class="nurse-duty-chip">
                <div class="nurse-chip-avatar">
                    <i class="bi bi-person-heart"></i>
                </div>
                <div class="nurse-chip-text">
                    <span class="nurse-chip-name">@(string.IsNullOrWhiteSpace(currentUserName) ? "Duty Staff" : currentUserName)</span>
                    <span class="nurse-chip-shift">@currentShiftDisplay</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 2. PATIENT DETAILS BANNER                                                 -->
    <!-- ========================================================================= -->
    @if (selectedPatient != null)
    {
        <div class="patient-banner-card mb-2">
            <div class="banner-left-wrap">
                <div class="pat-avatar-indigo">
                    @GetInitials(selectedPatient.patient_name)
                </div>
                <div class="pat-text-wrap">
                    <div class="d-flex align-items-center gap-2" style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                        <span class="pat-name-heading">@(selectedPatient.patient_name ?? "Unknown Patient")</span>
                        <span class="badge-ip-indigo">IP: @selectedPatient.ip_no</span>
                        <span class="badge-status-admitted">ADMITTED</span>
                    </div>

                    <div class="pat-meta-row">
                        <div class="meta-item">
                            <span class="meta-lbl">AGE / GENDER</span>
                            <span class="meta-val">@GetPatientAgeGender()</span>
                        </div>
                        <div class="meta-divider"></div>
                        <div class="meta-item">
                            <span class="meta-lbl">WARD / BED LOCATION</span>
                            <span class="meta-val text-indigo-600 font-bold">@GetPatientWardBed()</span>
                        </div>
                        <div class="meta-divider"></div>
                        <div class="meta-item">
                            <span class="meta-lbl">ATTENDING DOCTOR</span>
                            <span class="meta-val">@GetDoctorName(selectedPatient.dcode)</span>
                        </div>
                        <div class="meta-divider"></div>
                        <div class="meta-item">
                            <span class="meta-lbl">ADMISSION DATE</span>
                            <span class="meta-val">@(selectedPatient.admitdate.ToIndianTime().ToString("dd-MMM-yyyy"))</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="banner-right-wrap">
                @if (isReferredToVisitingDoctor)
                {
                    <div class="referred-visiting-card" title="Patient is referred to visiting doctor">
                        <div class="referred-badge-tag">
                            <i class="bi bi-person-check-fill me-1"></i>
                            <span>Referred to Visiting Doctor</span>
                        </div>
                        <div class="referred-doc-name">
                            <i class="bi bi-person-badge-fill me-1 text-emerald-600"></i>
                            <span>@(string.IsNullOrWhiteSpace(visitingDoctorDisplayName) ? "Visiting Doctor" : visitingDoctorDisplayName)</span>
                        </div>
                    </div>
                }

                <button type="button" class="btn-op-casesheet" @onclick="OpenCaseSheetModal" title="Open doctor's clinical case sheet for this IP patient">
                    <i class="bi bi-file-earmark-medical-fill me-1"></i>
                    <span>View OP Case Sheet</span>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="patient-empty-banner mb-3" @onclick="() => isPatientDropdownOpen = true">
            <i class="bi bi-person-search text-indigo-600 fs-4 me-2"></i>
            <span>No patient selected. <strong>Search an admitted patient above</strong> to view bedside observation charts.</span>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- 3. WORKSPACE CARD & TABS                                                  -->
    <!-- ========================================================================= -->
    <div class="nurse-workspace-card">
        <!-- Tab Navigation Strip -->
        <div class="workspace-tabs-strip">
            <button type="button" class="nt-tab-btn @(activeTab == "temperature" ? "active" : "")" @onclick='() => SetActiveTab("temperature")'>
                <i class="bi bi-thermometer-half tab-icon"></i>
                <span>Temperature</span>
                @if (temperatureList.Any())
                {
                    <span class="tab-badge-pill">@temperatureList.Count</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "vitals" ? "active" : "")" @onclick='() => SetActiveTab("vitals")'>
                <i class="bi bi-heart-pulse tab-icon"></i>
                <span>Vitals</span>
                @if (vitalsList.Any())
                {
                    <span class="tab-badge-pill">@vitalsList.Count</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "input_output" ? "active" : "")" @onclick='() => SetActiveTab("input_output")'>
                <i class="bi bi-cup-straw tab-icon"></i>
                <span>Input / Output</span>
                @if (inputOutputList.Any())
                {
                    <span class="tab-badge-pill">@inputOutputList.Count</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "service" ? "active" : "")" @onclick='() => SetActiveTab("service")'>
                <i class="bi bi-person-gear tab-icon"></i>
                <span>Service</span>
                @if (serviceList.Any())
                {
                    <span class="tab-badge-pill">@serviceList.Count</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "medicine" ? "active" : "")" @onclick='() => SetActiveTab("medicine")'>
                <i class="bi bi-capsule tab-icon"></i>
                <span>Medicine</span>
                @if (medicineList.Any())
                {
                    <span class="tab-badge-pill">@medicineList.Count</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "visiting_doctor" ? "active" : "")" @onclick='() => SetActiveTab("visiting_doctor")'>
                <i class="bi bi-person-badge tab-icon"></i>
                <span>Doctor Visiting</span>
                @if (visitingDoctorList.Any())
                {
                    <span class="tab-badge-pill">@visitingDoctorList.Count</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "schedule" ? "active" : "")" @onclick='() => SetActiveTab("schedule")'>
                <i class="bi bi-calendar2-check tab-icon"></i>
                <span>Schedule</span>
                @if (scheduleList.Any())
                {
                    <span class="tab-badge-pill">@scheduleList.Count</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "other" ? "active" : "")" @onclick='() => SetActiveTab("other")'>
                <i class="bi bi-file-earmark-text tab-icon"></i>
                <span>Other Notes</span>
                @if (otherList.Any())
                {
                    <span class="tab-badge-pill">@otherList.Count</span>
                }
            </button>
        </div>

        <!-- Tab Body Container -->
        <div class="workspace-body-wrap">
            @if (selectedPatient == null)
            {
                <div class="empty-state-box">
                    <div class="empty-state-icon">
                        <i class="bi bi-clipboard2-pulse"></i>
                    </div>
                    <h3 class="font-bold text-slate-800 fs-5 mb-1">No In-Patient Selected</h3>
                    <p class="text-slate-600 fs-7 mb-3" style="max-width: 440px; margin: 0 auto 1.25rem auto;">
                        Please search and select an admitted patient from the header to view bedside observation logs.
                    </p>
                    <button type="button" class="btn-indigo-action" @onclick="() => isPatientDropdownOpen = true">
                        <i class="bi bi-search me-1"></i> Search Admitted In-Patients
                    </button>
                </div>
            }
            else if (isLoadingData)
            {
                <div class="loading-state-box">
                    <div class="spinner-border text-indigo-600" style="width: 2.75rem; height: 2.75rem;" role="status"></div>
                    <span class="text-slate-700 font-bold mt-3" style="font-size: 13px;">Loading bedside observations...</span>
                </div>
            }
            else
            {
                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 1: TEMPERATURE                                                  *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "temperature")
                {
                    <div class="tab-section-flow">
                        <!-- Entry Box -->
                        <div class="entry-card-box">
                            <div class="entry-card-header-inline mb-3 pb-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-thermometer-half text-indigo-600 fs-6"></i>
                                    <span class="entry-title-text">@(editingTempId.HasValue ? "Edit Temperature Observation" : "Add Temperature Record")</span>
                                </div>
                            </div>

                            <div class="form-horizontal-row" style="display: flex; align-items: flex-end; gap: 8px; width: 100%; flex-wrap: nowrap;">
                                <div class="form-field-unit" style="flex: 0 0 110px; min-width: 100px;">
                                    <label class="nt-form-label">Time <span class="text-danger">*</span></label>
                                    <div class="input-icon-relative">
                                        <input type="text" class="nt-input-control" placeholder="04:30 PM" @bind="tempTimeDisplay" />
                                        <i class="bi bi-clock input-end-icon"></i>
                                    </div>
                                </div>

                                <div class="form-field-unit" style="flex: 0 0 95px; min-width: 90px;">
                                    <label class="nt-form-label">Shift</label>
                                    <select class="nt-select-control" @bind="tempShift">
                                        <option value="MORNING">Morning</option>
                                        <option value="AFTERNOON">Afternoon</option>
                                        <option value="EVENING">Evening</option>
                                        <option value="NIGHT">Night</option>
                                    </select>
                                </div>

                                <div class="form-field-unit" style="flex: 0 0 100px; min-width: 90px;">
                                    <label class="nt-form-label">Temperature <span class="text-danger">*</span></label>
                                    <input type="number" step="0.1" class="nt-input-control" placeholder="98.6" @bind="tempValue" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit" style="flex: 0 0 70px; min-width: 65px;">
                                    <label class="nt-form-label">Unit</label>
                                    <select class="nt-select-control" @bind="tempUnit">
                                        <option value="F">°F</option>
                                        <option value="C">°C</option>
                                    </select>
                                </div>

                                <div class="form-field-unit flex-grow-1" style="flex: 1 1 0; min-width: 0;">
                                    <label class="nt-form-label">Remarks / Findings</label>
                                    <input type="text" class="nt-input-control" style="width: 100%;" placeholder="e.g. Normal, Afebrile, Slight chills..." @bind="tempRemarks" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit btn-field-align" style="flex: 0 0 auto; white-space: nowrap;">
                                    <button type="button" class="btn-indigo-action" disabled="@isSubmitting" @onclick="SaveTemperatureAsync">
                                        @if (isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        else
                                        {
                                            <i class="bi @(editingTempId.HasValue ? "bi-check2-circle" : "bi-plus-circle") me-1"></i>
                                            <span>@(editingTempId.HasValue ? "Update" : "Add Record")</span>
                                        }
                                    </button>
                                    @if (editingTempId.HasValue)
                                    {
                                        <button type="button" class="btn-cancel-action ms-2" @onclick="CancelEditTemp">Cancel</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-list-columns-reverse text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Temperature Observation Log</span>
                                </div>
                                <span class="table-pill-count">@temperatureList.Count @(temperatureList.Count == 1 ? "Record" : "Records")</span>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 60px; text-align: center;">S.NO.</th>
                                            <th>TIME &amp; SHIFT</th>
                                            <th>TEMPERATURE</th>
                                            <th>UNIT</th>
                                            <th>REMARKS</th>
                                            <th>RECORDED BY</th>
                                            <th style="width: 110px; text-align: center;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!temperatureList.Any())
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center p-48 text-slate-400 italic">
                                                    <i class="bi bi-thermometer d-block fs-3 mb-1 text-slate-300"></i>
                                                    <span>No temperature records logged yet for this patient.</span>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int sNo = 1;
                                            @foreach (var t in temperatureList.OrderByDescending(x => x.created_at))
                                            {
                                                <tr class="lc-table-row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@(sNo++)</td>
                                                    <td>
                                                        <span class="font-bold text-slate-800">@FormatEntryTime(t.entry_time, t.created_at)</span>
                                                        <span class="tag-shift-indigo ms-2">@t.shift</span>
                                                    </td>
                                                    <td class="font-bold text-indigo-600">
                                                        @t.temperature
                                                        @if (t.temperature >= 100.4m || (t.unit == "C" && t.temperature >= 38m))
                                                        {
                                                            <span class="badge bg-danger ms-1" style="font-size: 10px;">High Fever</span>
                                                        }
                                                    </td>
                                                    <td class="text-slate-600">°@t.unit</td>
                                                    <td class="text-slate-700">@(string.IsNullOrWhiteSpace(t.remarks) ? "—" : t.remarks)</td>
                                                    <td class="text-slate-600">@GetAddedByText(t.usercode)</td>
                                                    <td style="text-align: center; white-space: nowrap;">
                                                        <div class="action-buttons-flex">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit" @onclick="() => StartEditTemp(t)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Delete" @onclick="() => DeleteTemperatureAsync(t.temp_id)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 2: VITALS (COMPACT SAME-LINE ROW)                               *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "vitals")
                {
                    <div class="tab-section-flow">
                        <!-- Entry Box -->
                        <div class="entry-card-box">
                            <div class="entry-card-header-inline mb-3 pb-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-heart-pulse text-rose-600 fs-6"></i>
                                    <span class="entry-title-text">@(editingVitalId.HasValue ? "Edit Patient Vitals" : "Record Bedside Vitals")</span>
                                </div>
                            </div>

                            <div class="vitals-grid-row">
                                <div class="form-field-unit">
                                    <label class="nt-form-label" title="Blood Pressure (Systolic / Diastolic)">BP (S/D)</label>
                                    <div class="bp-inputs-wrap">
                                        <input type="number" class="nt-input-control text-center bp-box" placeholder="120" @bind="vitalSys" @bind:event="oninput" />
                                        <span class="bp-slash">/</span>
                                        <input type="number" class="nt-input-control text-center bp-box" placeholder="80" @bind="vitalDia" @bind:event="oninput" />
                                    </div>
                                </div>

                                <div class="form-field-unit">
                                    <label class="nt-form-label" title="Pulse Rate (bpm)">Pulse</label>
                                    <input type="number" class="nt-input-control text-center" placeholder="72" @bind="vitalPulse" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit">
                                    <label class="nt-form-label" title="SpO2 Percentage">SpO2</label>
                                    <input type="number" step="0.1" class="nt-input-control text-center" placeholder="98" @bind="vitalSpo2" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit">
                                    <label class="nt-form-label" title="Respiratory Rate (/min)">Resp</label>
                                    <input type="number" class="nt-input-control text-center" placeholder="18" @bind="vitalResp" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit">
                                    <label class="nt-form-label" title="Temperature (°F)">Temp(°F)</label>
                                    <input type="number" step="0.1" class="nt-input-control text-center" placeholder="98.6" @bind="vitalTemp" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit">
                                    <label class="nt-form-label" title="GRBS / Blood Sugar (mg/dL)">GRBS</label>
                                    <input type="number" step="0.1" class="nt-input-control text-center" placeholder="110" @bind="vitalSugar" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit">
                                    <label class="nt-form-label" title="Pain Scale (0-10)">Pain</label>
                                    <select class="nt-select-control px-1" @bind="vitalPain">
                                        <option value="0">0-None</option>
                                        <option value="2">2-Mild</option>
                                        <option value="4">4-Mod</option>
                                        <option value="6">6-Sev</option>
                                        <option value="8">8-V.Sev</option>
                                        <option value="10">10-Max</option>
                                    </select>
                                </div>

                                <div class="form-field-unit">
                                    <label class="nt-form-label" title="Clinical Notes / Findings">Notes / Findings</label>
                                    <input type="text" class="nt-input-control px-2" placeholder="Patient stable" @bind="vitalNotes" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit d-flex flex-row align-items-end">
                                    <button type="button" class="btn-indigo-action px-3" disabled="@isSubmitting" @onclick="SaveVitalsAsync">
                                        @if (isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        else
                                        {
                                            <i class="bi @(editingVitalId.HasValue ? "bi-check2-circle" : "bi-plus-circle") me-1"></i>
                                            <span>@(editingVitalId.HasValue ? "Update" : "Record")</span>
                                        }
                                    </button>
                                    @if (editingVitalId.HasValue)
                                    {
                                        <button type="button" class="btn-cancel-action ms-1 px-2" @onclick="CancelEditVitals">Cancel</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-list-columns-reverse text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Vitals Observation History</span>
                                </div>
                                <span class="table-pill-count">@vitalsList.Count @(vitalsList.Count == 1 ? "Record" : "Records")</span>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 60px; text-align: center;">S.NO.</th>
                                            <th>DATE &amp; TIME</th>
                                            <th>BP (MMHG)</th>
                                            <th>PULSE</th>
                                            <th>SPO2</th>
                                            <th>RESP</th>
                                            <th>TEMP</th>
                                            <th>GRBS</th>
                                            <th>PAIN</th>
                                            <th>CLINICAL NOTES</th>
                                            <th style="width: 70px; text-align: center;">ACTION</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!vitalsList.Any())
                                        {
                                            <tr>
                                                <td colspan="11" class="text-center p-48 text-slate-400 italic">
                                                    <i class="bi bi-heart-pulse d-block fs-3 mb-1 text-slate-300"></i>
                                                    <span>No vitals recorded for this patient yet.</span>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int sNo = 1;
                                            @foreach (var v in vitalsList.OrderByDescending(x => x.created_at))
                                            {
                                                <tr class="lc-table-row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@(sNo++)</td>
                                                    <td class="font-bold text-slate-800">@FormatDateTime(v.created_at)</td>
                                                    <td class="font-bold text-indigo-600">
                                                        @if (v.bp_systolic.HasValue || v.bp_diastolic.HasValue)
                                                        {
                                                            <span>@v.bp_systolic / @v.bp_diastolic</span>
                                                        }
                                                        else { <span>—</span> }
                                                    </td>
                                                    <td class="text-slate-700">@(v.pulse_rate?.ToString() ?? "—") bpm</td>
                                                    <td class="text-slate-700">
                                                        @(v.spo2?.ToString() ?? "—")%
                                                        @if (v.spo2.HasValue && v.spo2 < 95)
                                                        {
                                                            <span class="badge bg-warning text-dark ms-1" style="font-size: 10px;">Low</span>
                                                        }
                                                    </td>
                                                    <td class="text-slate-700">@(v.respiratory_rate?.ToString() ?? "—")</td>
                                                    <td class="text-slate-700">@(v.temperature_f?.ToString() ?? "—")°F</td>
                                                    <td class="text-slate-700">@(v.sugar_level?.ToString() ?? "—")</td>
                                                    <td class="text-slate-700">@(v.pain_scale?.ToString() ?? "—")/10</td>
                                                    <td class="text-slate-600">@(string.IsNullOrWhiteSpace(v.allergy_notes) ? "—" : v.allergy_notes)</td>
                                                    <td style="text-align: center; white-space: nowrap;">
                                                        <div class="action-buttons-flex">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit" @onclick="() => StartEditVitals(v)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 3: INPUT / OUTPUT                                               *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "input_output")
                {
                    <div class="tab-section-flow">
                        <!-- Entry Box -->
                        <div class="entry-card-box">
                            <div class="entry-card-header-inline mb-3 pb-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-cup-straw text-indigo-600 fs-6"></i>
                                    <span class="entry-title-text">@(editingIoId.HasValue ? "Edit Input / Output Fluid Record" : "Add Input / Output Fluid Entry")</span>
                                </div>
                            </div>

                            <div class="form-horizontal-row" style="display: flex; align-items: flex-end; gap: 8px; width: 100%; flex-wrap: nowrap;">
                                <div class="form-field-unit" style="flex: 0 0 95px; min-width: 90px;">
                                    <label class="nt-form-label">Type <span class="text-danger">*</span></label>
                                    <select class="nt-select-control font-bold" @bind="ioType">
                                        <option value="INPUT">INPUT</option>
                                        <option value="OUTPUT">OUTPUT</option>
                                    </select>
                                </div>

                                <div class="form-field-unit" style="flex: 0 0 95px; min-width: 90px;">
                                    <label class="nt-form-label">Shift</label>
                                    <select class="nt-select-control" @bind="ioShift">
                                        <option value="MORNING">Morning</option>
                                        <option value="AFTERNOON">Afternoon</option>
                                        <option value="EVENING">Evening</option>
                                        <option value="NIGHT">Night</option>
                                    </select>
                                </div>

                                <div class="form-field-unit flex-grow-1 position-relative" style="flex: 1.2 1 0; min-width: 0;">
                                    <label class="nt-form-label">Particulars <span class="text-danger">*</span></label>
                                    <div class="custom-dropdown-wrap">
                                        <input type="text"
                                               class="nt-input-control w-100"
                                               style="padding-right: 32px;"
                                               placeholder="e.g. IV Fluid, Urine, Water..."
                                               value="@ioParticulars"
                                               @oninput="OnParticularsInput"
                                               @onfocus="OnParticularsFocus"
                                               @onkeydown="OnParticularsKeyDown"
                                               autocomplete="off" />

                                        <button type="button" 
                                                class="btn-input-edge-add" 
                                                @onclick="OpenAddParticularModal" 
                                                @onclick:stopPropagation
                                                title="Add New IO Particular">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>

                                        @if (isParticularsDropdownOpen)
                                        {
                                            <div class="custom-particulars-dropdown shadow-lg" @onclick:stopPropagation>
                                                @{
                                                    var items = GetFilteredParticulars().ToList();
                                                }
                                                @if (!items.Any())
                                                {
                                                    <div class="particular-no-results" @onclick="OpenAddParticularModal">
                                                        <i class="bi bi-plus-circle me-1 text-indigo-600"></i>
                                                        <span>No match found. Click to add <strong>"@ioParticulars"</strong></span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @for (int idx = 0; idx < items.Count; idx++)
                                                    {
                                                        var item = items[idx];
                                                        var isHighlighted = idx == highlightedParticularIndex;
                                                        <div class="particular-dropdown-item @(isHighlighted ? "highlighted" : "")"
                                                             @onclick="() => SelectParticular(item.particular_name)"
                                                             @onmouseenter="() => highlightedParticularIndex = idx">
                                                            <span class="particular-item-name">@item.particular_name</span>
                                                            @if (!string.IsNullOrWhiteSpace(item.io_type))
                                                            {
                                                                <span class="particular-type-tag type-@item.io_type.ToLower()">@item.io_type</span>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="form-field-unit" style="flex: 0 0 80px; min-width: 75px;">
                                    <label class="nt-form-label">Quantity <span class="text-danger">*</span></label>
                                    <input type="number" class="nt-input-control" placeholder="500" @bind="ioQuantity" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit" style="flex: 0 0 65px; min-width: 60px;">
                                    <label class="nt-form-label">Unit</label>
                                    <input type="text" class="nt-input-control text-center" @bind="ioUnit" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit flex-grow-1" style="flex: 1 1 0; min-width: 0;">
                                    <label class="nt-form-label">Remarks</label>
                                    <input type="text" class="nt-input-control" style="width: 100%;" placeholder="e.g. Clear, Infused over 4 hrs" @bind="ioRemarks" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit btn-field-align" style="flex: 0 0 auto; white-space: nowrap;">
                                    <button type="button" class="btn-indigo-action" disabled="@isSubmitting" @onclick="SaveInputOutputAsync">
                                        <i class="bi @(editingIoId.HasValue ? "bi-check2-circle" : "bi-plus-circle") me-1"></i>
                                        <span>@(editingIoId.HasValue ? "Update" : "Add Record")</span>
                                    </button>
                                    @if (editingIoId.HasValue)
                                    {
                                        <button type="button" class="btn-cancel-action ms-2" @onclick="CancelEditIo">Cancel</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Fluid Balance Summary Pill Bar -->
                        <div class="fluid-stats-bar mb-2">
                            <div class="fluid-pill pill-intake">
                                <span class="fluid-lbl">TOTAL INTAKE:</span>
                                <span class="fluid-val">@inputOutputList.Where(x => string.Equals(x.io_type, "INPUT", StringComparison.OrdinalIgnoreCase)).Sum(x => x.quantity ?? 0) ml</span>
                            </div>
                            <div class="fluid-pill pill-output">
                                <span class="fluid-lbl">TOTAL OUTPUT:</span>
                                <span class="fluid-val">@inputOutputList.Where(x => string.Equals(x.io_type, "OUTPUT", StringComparison.OrdinalIgnoreCase)).Sum(x => x.quantity ?? 0) ml</span>
                            </div>
                            <div class="fluid-pill pill-net">
                                <span class="fluid-lbl">FLUID BALANCE:</span>
                                <span class="fluid-val">@CalculateFluidBalance() ml</span>
                            </div>
                        </div>

                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-list-columns-reverse text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Input / Output Fluid Flow Log</span>
                                </div>
                                <span class="table-pill-count">@inputOutputList.Count Entries</span>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 60px; text-align: center;">S.NO.</th>
                                            <th>TIME &amp; SHIFT</th>
                                            <th>TYPE</th>
                                            <th>PARTICULARS</th>
                                            <th>QUANTITY</th>
                                            <th>REMARKS</th>
                                            <th>RECORDED BY</th>
                                            <th style="width: 110px; text-align: center;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!inputOutputList.Any())
                                        {
                                            <tr>
                                                <td colspan="8" class="text-center p-48 text-slate-400 italic">
                                                    <i class="bi bi-cup-straw d-block fs-3 mb-1 text-slate-300"></i>
                                                    <span>No input/output fluid records entered for this patient.</span>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int sNo = 1;
                                            @foreach (var item in inputOutputList.OrderByDescending(x => x.created_at))
                                            {
                                                <tr class="lc-table-row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@(sNo++)</td>
                                                    <td>
                                                        <span class="font-bold text-slate-800">@FormatEntryTime(item.entry_time, item.created_at)</span>
                                                        <span class="tag-shift-indigo ms-2">@item.shift</span>
                                                    </td>
                                                    <td>
                                                        @if (string.Equals(item.io_type, "INPUT", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-indigo-50 text-indigo-600 font-bold px-2 py-1">INPUT</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark font-bold px-2 py-1">OUTPUT</span>
                                                        }
                                                    </td>
                                                    <td class="font-bold text-slate-800">@item.particulars</td>
                                                    <td class="font-bold text-indigo-600">@(item.quantity?.ToString() ?? "0") @item.unit</td>
                                                    <td class="text-slate-700">@(string.IsNullOrWhiteSpace(item.remarks) ? "—" : item.remarks)</td>
                                                    <td class="text-slate-600">@GetAddedByText(item.usercode)</td>
                                                    <td style="text-align: center; white-space: nowrap;">
                                                        <div class="action-buttons-flex">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit" @onclick="() => StartEditIo(item)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Delete" @onclick="() => DeleteInputOutputAsync(item.io_id)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 4: SERVICE                                                      *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "service")
                {
                    <div class="tab-section-flow">
                        <!-- Entry Box -->
                        <div class="entry-card-box">
                            <div class="entry-card-header-inline mb-3 pb-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-person-gear text-indigo-600 fs-6"></i>
                                    <span class="entry-title-text">@(editingServiceId.HasValue ? "Edit Bedside Service Record" : "Add Nursing Service Procedure")</span>
                                </div>
                            </div>

                            <div class="form-horizontal-row" style="display: flex; align-items: flex-end; gap: 10px; width: 100%; flex-wrap: nowrap;">
                                <div class="form-field-unit" style="flex: 0 0 100px; min-width: 95px;">
                                    <label class="nt-form-label">Shift</label>
                                    <select class="nt-select-control" @bind="serviceShift">
                                        <option value="MORNING">Morning</option>
                                        <option value="AFTERNOON">Afternoon</option>
                                        <option value="EVENING">Evening</option>
                                        <option value="NIGHT">Night</option>
                                    </select>
                                </div>

                                <div class="form-field-unit flex-grow-1 position-relative" style="flex: 1.2 1 0; min-width: 0;">
                                    <label class="nt-form-label">Service Name <span class="text-danger">*</span></label>
                                    <div class="custom-dropdown-wrap">
                                        <input type="text"
                                               class="nt-input-control w-100"
                                               style="padding-right: 32px;"
                                               placeholder="Wound Dressing, Catheter Care, Nebulization..."
                                               value="@serviceName"
                                               @oninput="OnServiceNameInput"
                                               @onfocus="OnServiceNameFocus"
                                               @onkeydown="OnServiceNameKeyDown"
                                               autocomplete="off" />

                                        <button type="button" 
                                                class="btn-input-edge-add" 
                                                @onclick="OpenAddServiceModal" 
                                                @onclick:stopPropagation
                                                title="Add New Service Name">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>

                                        @if (isServiceDropdownOpen)
                                        {
                                            <div class="custom-particulars-dropdown shadow-lg" @onclick:stopPropagation>
                                                @{
                                                    var sItems = GetFilteredServices().ToList();
                                                }
                                                @if (!sItems.Any())
                                                {
                                                    <div class="particular-no-results" @onclick="OpenAddServiceModal">
                                                        <i class="bi bi-plus-circle me-1 text-indigo-600"></i>
                                                        <span>No match found. Click to add <strong>"@serviceName"</strong></span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @for (int idx = 0; idx < sItems.Count; idx++)
                                                    {
                                                        var item = sItems[idx];
                                                        var isHighlighted = idx == highlightedServiceIndex;
                                                        <div class="particular-dropdown-item @(isHighlighted ? "highlighted" : "")"
                                                             @onclick="() => SelectServiceName(item.service_name)"
                                                             @onmouseenter="() => highlightedServiceIndex = idx">
                                                            <span class="particular-item-name">@item.service_name</span>
                                                            <span class="particular-type-tag type-input">SERVICE</span>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="form-field-unit flex-grow-1" style="flex: 1.2 1 0; min-width: 0;">
                                    <label class="nt-form-label">Action Taken <span class="text-danger">*</span></label>
                                    <input type="text" class="nt-input-control" style="width: 100%;" placeholder="e.g. Sterile dressing changed, antiseptic applied" @bind="serviceAction" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit flex-grow-1" style="flex: 1 1 0; min-width: 0;">
                                    <label class="nt-form-label">Remarks</label>
                                    <input type="text" class="nt-input-control" style="width: 100%;" placeholder="Wound clean, no oozing observed" @bind="serviceRemarks" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit btn-field-align" style="flex: 0 0 auto; white-space: nowrap;">
                                    <button type="button" class="btn-indigo-action" disabled="@isSubmitting" @onclick="SaveServiceAsync">
                                        <i class="bi @(editingServiceId.HasValue ? "bi-check2-circle" : "bi-plus-circle") me-1"></i>
                                        <span>@(editingServiceId.HasValue ? "Update" : "Add Service")</span>
                                    </button>
                                    @if (editingServiceId.HasValue)
                                    {
                                        <button type="button" class="btn-cancel-action ms-2" @onclick="CancelEditService">Cancel</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-list-columns-reverse text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Nursing Services Rendered</span>
                                </div>
                                <span class="table-pill-count">@serviceList.Count Records</span>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 60px; text-align: center;">S.NO.</th>
                                            <th>TIME &amp; SHIFT</th>
                                            <th>SERVICE NAME</th>
                                            <th>ACTION TAKEN</th>
                                            <th>REMARKS</th>
                                            <th>RENDERED BY</th>
                                            <th style="width: 110px; text-align: center;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!serviceList.Any())
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center p-48 text-slate-400 italic">
                                                    <i class="bi bi-person-gear d-block fs-3 mb-1 text-slate-300"></i>
                                                    <span>No nursing service procedures recorded for this patient.</span>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int sNo = 1;
                                            @foreach (var s in serviceList.OrderByDescending(x => x.created_at))
                                            {
                                                <tr class="lc-table-row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@(sNo++)</td>
                                                    <td>
                                                        <span class="font-bold text-slate-800">@FormatEntryTime(s.entry_time, s.created_at)</span>
                                                        <span class="tag-shift-indigo ms-2">@s.shift</span>
                                                    </td>
                                                    <td class="font-bold text-indigo-600">@s.service_name</td>
                                                    <td class="text-slate-800">@(string.IsNullOrWhiteSpace(s.action) ? "—" : s.action)</td>
                                                    <td class="text-slate-700">@(string.IsNullOrWhiteSpace(s.remarks) ? "—" : s.remarks)</td>
                                                    <td class="text-slate-600">@GetAddedByText(s.usercode)</td>
                                                    <td style="text-align: center; white-space: nowrap;">
                                                        <div class="action-buttons-flex">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit" @onclick="() => StartEditService(s)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Delete" @onclick="() => DeleteServiceAsync(s.service_id)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 5: MEDICINE                                                     *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "medicine")
                {
                    <div class="tab-section-flow">
                        <!-- Entry Box -->
                        <div class="entry-card-box">
                            <div class="entry-card-header-inline mb-3 pb-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-capsule text-indigo-600 fs-6"></i>
                                    <span class="entry-title-text">@(editingMedId.HasValue ? "Edit Medication Administration" : "Record Medication Administration")</span>
                                </div>
                            </div>

                            <div class="form-horizontal-row" style="display: flex; align-items: flex-end; gap: 8px; width: 100%; flex-wrap: nowrap;">
                                <div class="form-field-unit" style="flex: 0 0 95px; min-width: 90px;">
                                    <label class="nt-form-label">Shift</label>
                                    <select class="nt-select-control" @bind="medShift">
                                        <option value="MORNING">Morning</option>
                                        <option value="AFTERNOON">Afternoon</option>
                                        <option value="EVENING">Evening</option>
                                        <option value="NIGHT">Night</option>
                                    </select>
                                </div>

                                <div class="form-field-unit flex-grow-1 position-relative" style="flex: 1.5 1 0; min-width: 0;">
                                    <label class="nt-form-label">Medicine Name <span class="text-danger">*</span></label>
                                    <div class="custom-dropdown-wrap">
                                        <input type="text"
                                               class="nt-input-control w-100"
                                               placeholder="e.g. Paracetamol 650mg, Inj Pantop..."
                                               value="@medName"
                                               @oninput="OnMedicineInput"
                                               @onfocus="OnMedicineFocus"
                                               @onkeydown="OnMedicineKeyDown"
                                               autocomplete="off" />

                                        @if (isMedicineDropdownOpen)
                                        {
                                            <div class="custom-particulars-dropdown shadow-lg" @onclick:stopPropagation>
                                                @{
                                                    var mItems = GetFilteredMedicines().ToList();
                                                }
                                                @if (!mItems.Any())
                                                {
                                                    <div class="particular-no-results">
                                                        <i class="bi bi-capsule me-1 text-indigo-600"></i>
                                                        <span>No medicine items matching "@medName"</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @for (int idx = 0; idx < mItems.Count; idx++)
                                                    {
                                                        var item = mItems[idx];
                                                        var isHighlighted = idx == highlightedMedicineIndex;
                                                        <div class="particular-dropdown-item @(isHighlighted ? "highlighted" : "")"
                                                             @onclick="() => SelectMedicineName(item.itemname ?? string.Empty)"
                                                             @onmouseenter="() => highlightedMedicineIndex = idx">
                                                            <span class="particular-item-name">@item.itemname</span>
                                                            @if (!string.IsNullOrWhiteSpace(item.itemtype) || !string.IsNullOrWhiteSpace(item.packaging))
                                                            {
                                                                <span class="particular-type-tag type-both">@(string.IsNullOrWhiteSpace(item.itemtype) ? item.packaging : item.itemtype)</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="particular-type-tag type-both">MEDICINE</span>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="form-field-unit" style="flex: 0 0 75px; min-width: 65px;">
                                    <label class="nt-form-label">Dose</label>
                                    <input type="number" step="0.1" class="nt-input-control" placeholder="500" @bind="medDose" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit" style="flex: 0 0 70px; min-width: 65px;">
                                    <label class="nt-form-label">Unit</label>
                                    <select class="nt-select-control" @bind="medUnit">
                                        <option value="mg">mg</option>
                                        <option value="ml">ml</option>
                                        <option value="gm">gm</option>
                                        <option value="tab">tab</option>
                                        <option value="cap">cap</option>
                                        <option value="puff">puff</option>
                                        <option value="drops">drops</option>
                                        <option value="vial">vial</option>
                                        <option value="unit">unit</option>
                                    </select>
                                </div>

                                <div class="form-field-unit" style="flex: 0 0 85px; min-width: 75px;">
                                    <label class="nt-form-label">Route</label>
                                    <select class="nt-select-control" @bind="medRoute">
                                        <option value="Oral">Oral</option>
                                        <option value="IV">IV</option>
                                        <option value="IM">IM</option>
                                        <option value="SC">SC</option>
                                        <option value="Topical">Topical</option>
                                        <option value="Inhalation">Inhalation</option>
                                        <option value="Sublingual">Sublingual</option>
                                        <option value="PR">PR</option>
                                    </select>
                                </div>

                                <div class="form-field-unit" style="flex: 0 0 95px; min-width: 85px;">
                                    <label class="nt-form-label">Status <span class="text-danger">*</span></label>
                                    <select class="nt-select-control font-bold" @bind="medStatus">
                                        <option value="GIVEN">GIVEN</option>
                                        <option value="REFUSED">REFUSED</option>
                                        <option value="MISSED">MISSED</option>
                                    </select>
                                </div>

                                <div class="form-field-unit flex-grow-1" style="flex: 1.2 1 0; min-width: 0;">
                                    <label class="nt-form-label">Remarks</label>
                                    <input type="text" class="nt-input-control" style="width: 100%;" placeholder="e.g. Given after food" @bind="medRemarks" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit btn-field-align" style="flex: 0 0 auto; white-space: nowrap;">
                                    <button type="button" class="btn-indigo-action" disabled="@isSubmitting" @onclick="SaveMedicineAsync">
                                        <i class="bi @(editingMedId.HasValue ? "bi-check2-circle" : "bi-plus-circle") me-1"></i>
                                        <span>@(editingMedId.HasValue ? "Update" : "Add Log")</span>
                                    </button>
                                    @if (editingMedId.HasValue)
                                    {
                                        <button type="button" class="btn-cancel-action ms-2" @onclick="CancelEditMed">Cancel</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-list-columns-reverse text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Medication Administration Record (MAR)</span>
                                </div>
                                <span class="table-pill-count">@medicineList.Count Records</span>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 60px; text-align: center;">S.NO.</th>
                                            <th>TIME &amp; SHIFT</th>
                                            <th>MEDICINE NAME</th>
                                            <th>DOSE &amp; ROUTE</th>
                                            <th>STATUS</th>
                                            <th>REMARKS</th>
                                            <th>ADMINISTERED BY</th>
                                            <th style="width: 110px; text-align: center;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!medicineList.Any())
                                        {
                                            <tr>
                                                <td colspan="8" class="text-center p-48 text-slate-400 italic">
                                                    <i class="bi bi-capsule d-block fs-3 mb-1 text-slate-300"></i>
                                                    <span>No medication administration logs recorded for this patient.</span>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int sNo = 1;
                                            @foreach (var m in medicineList.OrderByDescending(x => x.created_at))
                                            {
                                                <tr class="lc-table-row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@(sNo++)</td>
                                                    <td>
                                                        <span class="font-bold text-slate-800">@FormatEntryTime(m.entry_time, m.created_at)</span>
                                                        <span class="tag-shift-indigo ms-2">@m.shift</span>
                                                    </td>
                                                    <td class="font-bold text-indigo-600">@m.medicine_name</td>
                                                    <td>
                                                        <span class="font-bold text-slate-800">@(m.dose?.ToString() ?? "—") @m.unit</span>
                                                        <span class="badge bg-light text-dark border ms-1">@m.route</span>
                                                    </td>
                                                    <td>
                                                        @if (string.Equals(m.status, "GIVEN", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-success px-2 py-1"><i class="bi bi-check2 me-1"></i>GIVEN</span>
                                                        }
                                                        else if (string.Equals(m.status, "REFUSED", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-danger px-2 py-1"><i class="bi bi-x-circle me-1"></i>REFUSED</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-exclamation-triangle me-1"></i>MISSED</span>
                                                        }
                                                    </td>
                                                    <td class="text-slate-700">@(string.IsNullOrWhiteSpace(m.remarks) ? "—" : m.remarks)</td>
                                                    <td class="text-slate-600">@GetAddedByText(m.usercode)</td>
                                                    <td style="text-align: center; white-space: nowrap;">
                                                        <div class="action-buttons-flex">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit" @onclick="() => StartEditMed(m)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Delete" @onclick="() => DeleteMedicineAsync(m.med_id)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 6: OTHER NOTES                                                  *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "other")
                {
                    <div class="tab-section-flow">
                        <!-- Entry Box -->
                        <div class="entry-card-box">
                            <div class="entry-card-header-inline mb-3 pb-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-file-earmark-text text-indigo-600 fs-6"></i>
                                    <span class="entry-title-text">@(editingOtherId.HasValue ? "Edit Nursing Progress Note" : "Add Nursing Progress Note")</span>
                                </div>
                            </div>

                            <div class="form-horizontal-row" style="display: flex; align-items: flex-end; gap: 10px; width: 100%; flex-wrap: nowrap;">
                                <div class="form-field-unit" style="flex: 0 0 110px; min-width: 100px;">
                                    <label class="nt-form-label">Shift</label>
                                    <select class="nt-select-control" @bind="otherShift">
                                        <option value="MORNING">Morning</option>
                                        <option value="AFTERNOON">Afternoon</option>
                                        <option value="EVENING">Evening</option>
                                        <option value="NIGHT">Night</option>
                                    </select>
                                </div>

                                <div class="form-field-unit flex-grow-1" style="flex: 1 1 auto; min-width: 0;">
                                    <label class="nt-form-label">Progress Note / Clinical Observation <span class="text-danger">*</span></label>
                                    <input type="text" class="nt-input-control" style="width: 100%;" placeholder="e.g. Patient complained of mild dizziness. Doctor informed. Rechecked BP, normal..." @bind="otherNoteText" @bind:event="oninput" />
                                </div>

                                <div class="form-field-unit btn-field-align" style="flex: 0 0 auto; white-space: nowrap;">
                                    <button type="button" class="btn-indigo-action" disabled="@isSubmitting" @onclick="SaveOtherAsync">
                                        <i class="bi @(editingOtherId.HasValue ? "bi-check2-circle" : "bi-plus-circle") me-1"></i>
                                        <span>@(editingOtherId.HasValue ? "Update Note" : "Add Note")</span>
                                    </button>
                                    @if (editingOtherId.HasValue)
                                    {
                                        <button type="button" class="btn-cancel-action ms-2" @onclick="CancelEditOther">Cancel</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-list-columns-reverse text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">General Progress Notes History</span>
                                </div>
                                <span class="table-pill-count">@otherList.Count @(otherList.Count == 1 ? "Note" : "Notes")</span>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 60px; text-align: center;">S.NO.</th>
                                            <th style="width: 160px;">TIME &amp; SHIFT</th>
                                            <th>NURSING OBSERVATION / PROGRESS NOTE</th>
                                            <th style="width: 150px;">RECORDED BY</th>
                                            <th style="width: 110px; text-align: center;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!otherList.Any())
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center p-48 text-slate-400 italic">
                                                    <i class="bi bi-file-earmark-text d-block fs-3 mb-1 text-slate-300"></i>
                                                    <span>No nursing progress notes entered for this patient.</span>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int sNo = 1;
                                            @foreach (var o in otherList.OrderByDescending(x => x.created_at))
                                            {
                                                <tr class="lc-table-row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@(sNo++)</td>
                                                    <td>
                                                        <span class="font-bold text-slate-800">@FormatEntryTime(o.entry_time, o.created_at)</span>
                                                        <span class="tag-shift-indigo ms-2">@o.shift</span>
                                                    </td>
                                                    <td class="font-bold text-slate-800">@o.note</td>
                                                    <td class="text-slate-600">@GetAddedByText(o.usercode)</td>
                                                    <td style="text-align: center; white-space: nowrap;">
                                                        <div class="action-buttons-flex">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit" @onclick="() => StartEditOther(o)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Delete" @onclick="() => DeleteOtherAsync(o.other_id)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 7: DOCTOR VISITING                                              *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "visiting_doctor")
                {
                    <div class="tab-section-flow">
                        <!-- Entry Box (2 Lines Form) -->
                        <div class="entry-card-box">
                            <div class="entry-card-header-inline mb-3 pb-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-person-badge text-indigo-600 fs-6"></i>
                                    <span class="entry-title-text">@(editingVisitId.HasValue ? "Edit Doctor Visiting Record" : "Add Doctor Visiting Record")</span>
                                </div>
                            </div>

                            <div class="form-two-row-grid">
                                <!-- Line 1: Basic Visit Parameters -->
                                <div class="form-horizontal-row" style="display: flex; align-items: flex-end; gap: 10px; width: 100%;">
                                    <div class="form-field-unit" style="flex: 0 0 120px; min-width: 110px;">
                                        <label class="nt-form-label">Shift</label>
                                        <select class="nt-select-control" @bind="visitShift">
                                            <option value="MORNING">Morning</option>
                                            <option value="AFTERNOON">Afternoon</option>
                                            <option value="EVENING">Evening</option>
                                            <option value="NIGHT">Night</option>
                                        </select>
                                    </div>

                                    <div class="form-field-unit position-relative" style="flex: 1.6 1 200px; min-width: 160px;">
                                        <label class="nt-form-label">Doctor Name <span class="text-danger">*</span></label>
                                        <div class="custom-dropdown-wrap">
                                            <input type="text"
                                                   class="nt-input-control w-100"
                                                   placeholder="e.g. Dr. Karthik Raja"
                                                   value="@visitDoctorName"
                                                   @oninput="OnVisitingDoctorInput"
                                                   @onfocus="OnVisitingDoctorFocus"
                                                   @onkeydown="OnVisitingDoctorKeyDown"
                                                   autocomplete="off" />

                                            @if (isVisitingDoctorDropdownOpen)
                                            {
                                                <div class="custom-particulars-dropdown shadow-lg" @onclick:stopPropagation>
                                                    @{
                                                        var docItems = GetFilteredVisitingDoctors().ToList();
                                                    }
                                                    @if (!docItems.Any())
                                                    {
                                                        <div class="particular-no-results">
                                                            <i class="bi bi-person-x me-1 text-indigo-600"></i>
                                                            <span>No doctor matching "@visitDoctorName"</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @for (int idx = 0; idx < docItems.Count; idx++)
                                                        {
                                                            var doc = docItems[idx];
                                                            var spec = GetDoctorSpecialty(doc);
                                                            var isHighlighted = idx == highlightedVisitingDocIndex;
                                                            <div class="particular-dropdown-item @(isHighlighted ? "highlighted" : "")"
                                                                 @onclick="() => SelectVisitingDoctor(doc)"
                                                                 @onmouseenter="() => highlightedVisitingDocIndex = idx">
                                                                <span class="particular-item-name">@doc.name</span>
                                                                @if (!string.IsNullOrWhiteSpace(spec))
                                                                {
                                                                    <span class="particular-type-tag type-input">@spec</span>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="form-field-unit" style="flex: 1.4 1 180px; min-width: 140px;">
                                        <label class="nt-form-label">Specialization</label>
                                        <input type="text" class="nt-input-control" placeholder="Specialization (auto-filled)" @bind="visitSpecialization" @bind:event="oninput" />
                                    </div>

                                    <div class="form-field-unit" style="flex: 0 0 130px; min-width: 120px;">
                                        <label class="nt-form-label">Visit Time</label>
                                        <input type="time" class="nt-input-control" @bind="visitTime" />
                                    </div>
                                </div>

                                <!-- Line 2: Clinical Details, Remarks & Submit -->
                                <div class="form-horizontal-row mt-2" style="display: flex; align-items: flex-end; gap: 10px; width: 100%;">
                                    <div class="form-field-unit" style="flex: 1.5 1 200px; min-width: 150px;">
                                        <label class="nt-form-label">Diagnosis / Clinical Findings</label>
                                        <input type="text" class="nt-input-control" placeholder="Patient stable, mild tachycardia noted" @bind="visitDiagnosis" @bind:event="oninput" />
                                    </div>

                                    <div class="form-field-unit" style="flex: 1.5 1 200px; min-width: 150px;">
                                        <label class="nt-form-label">Advice / Plan</label>
                                        <input type="text" class="nt-input-control" placeholder="Continue medication, review tomorrow" @bind="visitAdvice" @bind:event="oninput" />
                                    </div>

                                    <div class="form-field-unit" style="flex: 1.2 1 160px; min-width: 130px;">
                                        <label class="nt-form-label">Remarks</label>
                                        <input type="text" class="nt-input-control" placeholder="Family informed about progress" @bind="visitRemarks" @bind:event="oninput" />
                                    </div>

                                    <div class="form-field-unit btn-field-align" style="flex: 0 0 auto; white-space: nowrap;">
                                        <button type="button" class="btn-indigo-action" disabled="@isSubmitting" @onclick="SaveVisitingDoctorAsync">
                                            <i class="bi @(editingVisitId.HasValue ? "bi-check2-circle" : "bi-plus-circle") me-1"></i>
                                            <span>@(editingVisitId.HasValue ? "Update Visit" : "Add Visit")</span>
                                        </button>
                                        @if (editingVisitId.HasValue)
                                        {
                                            <button type="button" class="btn-cancel-action ms-2" @onclick="CancelEditVisitingDoctor">Cancel</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-person-lines-fill text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Doctor Visiting Observation Log</span>
                                </div>
                                <span class="table-pill-count">@visitingDoctorList.Count @(visitingDoctorList.Count == 1 ? "Visit" : "Visits")</span>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table lc-table-fixed">
                                    <thead>
                                        <tr>
                                            <th style="width: 45px; text-align: center;">S.NO.</th>
                                            <th style="width: 135px;">ENTRY DATE<br /><span class="th-sub">&amp; SHIFT</span></th>
                                            <th style="width: 170px;">DOCTOR VISITING<br /><span class="th-sub">&amp; SPECIALIZATION</span></th>
                                            <th style="width: 90px;">VISIT TIME</th>
                                            <th>DIAGNOSIS<br /><span class="th-sub">&amp; FINDINGS</span></th>
                                            <th>ADVICE<br /><span class="th-sub">&amp; PLAN</span></th>
                                            <th>REMARKS</th>
                                            <th style="width: 120px;">RECORDED BY</th>
                                            <th style="width: 90px; text-align: center; white-space: nowrap;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!visitingDoctorList.Any())
                                        {
                                            <tr>
                                                <td colspan="9" class="text-center p-48 text-slate-400 italic">
                                                    <i class="bi bi-person-badge d-block fs-3 mb-1 text-slate-300"></i>
                                                    <span>No doctor visiting observations logged yet for this patient.</span>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int sNo = 1;
                                            @foreach (var v in visitingDoctorList.OrderByDescending(x => x.created_at))
                                            {
                                                <tr class="lc-table-row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@(sNo++)</td>
                                                    <td class="cell-wrap">
                                                        <div class="font-bold text-slate-800">@(v.entry_date.ToIndianTime().ToString("dd-MMM-yyyy"))</div>
                                                        <div class="d-flex align-items-center gap-1 mt-0.5">
                                                            <span class="text-slate-500 fs-8">@FormatEntryTime(v.entry_time, v.created_at)</span>
                                                            <span class="tag-shift-indigo">@v.shift</span>
                                                        </div>
                                                    </td>
                                                    <td class="cell-wrap">
                                                        <div class="font-bold text-indigo-700">@v.doctor_name</div>
                                                        @if (!string.IsNullOrWhiteSpace(v.specialization))
                                                        {
                                                            <span class="badge bg-slate-100 text-slate-700 border mt-0.5" style="font-size: 10px; font-weight: 600;">@v.specialization</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="font-bold text-slate-700">@(string.IsNullOrWhiteSpace(v.visit_time) ? "—" : v.visit_time)</span>
                                                    </td>
                                                    <td class="cell-wrap text-slate-800">
                                                        @(string.IsNullOrWhiteSpace(v.diagnosis_notes) ? "—" : v.diagnosis_notes)
                                                    </td>
                                                    <td class="cell-wrap text-emerald-800 font-bold">
                                                        @(string.IsNullOrWhiteSpace(v.advice) ? "—" : v.advice)
                                                    </td>
                                                    <td class="cell-wrap text-slate-600">
                                                        @(string.IsNullOrWhiteSpace(v.remarks) ? "—" : v.remarks)
                                                    </td>
                                                    <td class="cell-wrap text-slate-600 fs-8">
                                                        @GetAddedByText(v.usercode)
                                                    </td>
                                                    <td style="text-align: center; white-space: nowrap;">
                                                        <div class="action-buttons-flex">
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit" @onclick="() => StartEditVisitingDoctor(v)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Delete" @onclick="() => DeleteVisitingDoctorAsync(v.visit_id)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════════ *@
                @* TAB 8: SCHEDULE                                                     *@
                @* ═══════════════════════════════════════════════════════════════════ *@
                @if (activeTab == "schedule")
                {
                    <div class="tab-section-flow">
                        <!-- Entry Box (2 Lines Form) -->
                        <div class="entry-card-box">
                            <div class="entry-card-header-inline mb-3 pb-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-calendar2-check text-indigo-600 fs-6"></i>
                                    <span class="entry-title-text">@(editingScheduleId.HasValue ? "Edit Patient Care Schedule" : "Add Patient Care Schedule / Task")</span>
                                </div>
                            </div>

                            <div class="form-two-row-grid">
                                <!-- Line 1: Primary schedule parameters -->
                                <div class="form-horizontal-row" style="display: flex; align-items: flex-end; gap: 10px; width: 100%;">
                                    <div class="form-field-unit" style="flex: 0 0 120px; min-width: 110px;">
                                        <label class="nt-form-label">Shift</label>
                                        <select class="nt-select-control" @bind="scheduleShift">
                                            <option value="MORNING">Morning</option>
                                            <option value="AFTERNOON">Afternoon</option>
                                            <option value="EVENING">Evening</option>
                                            <option value="NIGHT">Night</option>
                                        </select>
                                    </div>

                                    <div class="form-field-unit" style="flex: 0 0 150px; min-width: 140px;">
                                        <label class="nt-form-label">Scheduled Date <span class="text-danger">*</span></label>
                                        <input type="date" class="nt-input-control" @bind="scheduleDate" />
                                    </div>

                                    <div class="form-field-unit" style="flex: 0 0 130px; min-width: 120px;">
                                        <label class="nt-form-label">Time <span class="text-danger">*</span></label>
                                        <input type="time" class="nt-input-control" @bind="scheduleTime" />
                                    </div>

                                    <div class="form-field-unit" style="flex: 0 0 140px; min-width: 130px;">
                                        <label class="nt-form-label">Type <span class="text-danger">*</span></label>
                                        <select class="nt-select-control font-bold" @bind="scheduleType">
                                            <option value="MEDICINE">Medicine</option>
                                            <option value="DIET">Diet</option>
                                            <option value="PROCEDURE">Procedure</option>
                                            <option value="OTHER">Other</option>
                                        </select>
                                    </div>

                                    <div class="form-field-unit flex-grow-1 position-relative" style="flex: 1.8 1 200px; min-width: 160px;">
                                        <label class="nt-form-label">Item / Task Name <span class="text-danger">*</span></label>
                                        <div class="custom-dropdown-wrap">
                                            <input type="text"
                                                   class="nt-input-control w-100"
                                                   style="padding-right: 32px;"
                                                   placeholder="e.g. Insulin 10 units / Diabetic lunch"
                                                   value="@scheduleName"
                                                   @oninput="OnScheduleTaskInput"
                                                   @onfocus="OnScheduleTaskFocus"
                                                   @onkeydown="OnScheduleTaskKeyDown"
                                                   autocomplete="off" />

                                            <button type="button" 
                                                    class="btn-input-edge-add" 
                                                    @onclick="OpenAddScheduleTypeModal" 
                                                    @onclick:stopPropagation
                                                    title="Add New Schedule Task">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>

                                            @if (isScheduleDropdownOpen)
                                            {
                                                <div class="custom-particulars-dropdown shadow-lg" @onclick:stopPropagation>
                                                    @{
                                                        var schItems = GetFilteredScheduleTasks().ToList();
                                                    }
                                                    @if (!schItems.Any())
                                                    {
                                                        <div class="particular-no-results" @onclick="OpenAddScheduleTypeModal">
                                                            <i class="bi bi-plus-circle me-1 text-indigo-600"></i>
                                                            <span>No match found. Click to add <strong>"@scheduleName"</strong></span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @for (int idx = 0; idx < schItems.Count; idx++)
                                                        {
                                                            var item = schItems[idx];
                                                            var isHighlighted = idx == highlightedScheduleIndex;
                                                            <div class="particular-dropdown-item @(isHighlighted ? "highlighted" : "")"
                                                                 @onclick="() => SelectScheduleTask(item.type_name)"
                                                                 @onmouseenter="() => highlightedScheduleIndex = idx">
                                                                <span class="particular-item-name">@item.type_name</span>
                                                                <span class="particular-type-tag type-input">SCHEDULE</span>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Line 2: Instructions, Status, Remarks & Submit -->
                                <div class="form-horizontal-row mt-2" style="display: flex; align-items: flex-end; gap: 10px; width: 100%;">
                                    <div class="form-field-unit" style="flex: 1.8 1 220px; min-width: 160px;">
                                        <label class="nt-form-label">Instructions</label>
                                        <input type="text" class="nt-input-control" placeholder="e.g. Give subcutaneously before breakfast" @bind="scheduleInstructions" @bind:event="oninput" />
                                    </div>

                                    <div class="form-field-unit" style="flex: 0 0 140px; min-width: 130px;">
                                        <label class="nt-form-label">Status <span class="text-danger">*</span></label>
                                        <select class="nt-select-control font-bold" @bind="scheduleStatus">
                                            <option value="PENDING">PENDING</option>
                                            <option value="COMPLETED">COMPLETED</option>
                                            <option value="MISSED">MISSED</option>
                                        </select>
                                    </div>

                                    <div class="form-field-unit" style="flex: 1.4 1 180px; min-width: 130px;">
                                        <label class="nt-form-label">Remarks</label>
                                        <input type="text" class="nt-input-control" placeholder="e.g. Blood sugar 142 mg/dL" @bind="scheduleRemarks" @bind:event="oninput" />
                                    </div>

                                    <div class="form-field-unit btn-field-align" style="flex: 0 0 auto; white-space: nowrap;">
                                        <button type="button" class="btn-indigo-action" disabled="@isSubmitting" @onclick="SaveScheduleAsync">
                                            <i class="bi @(editingScheduleId.HasValue ? "bi-check2-circle" : "bi-plus-circle") me-1"></i>
                                            <span>@(editingScheduleId.HasValue ? "Update Schedule" : "Add Schedule")</span>
                                        </button>
                                        @if (editingScheduleId.HasValue)
                                        {
                                            <button type="button" class="btn-cancel-action ms-2" @onclick="CancelEditSchedule">Cancel</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Data Table Box -->
                        <div class="directory-section">
                            <div class="table-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-clock-history text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Care Schedule &amp; Task Roster</span>
                                    <span class="table-pill-count ms-1">@GetFilteredSchedules().Count() Items</span>
                                </div>

                                <!-- Quick Status Filter Pills -->
                                <div class="sched-filter-group">
                                    <button type="button" class="sched-filter-pill @(scheduleFilter == "ALL" ? "active-all" : "")" @onclick='() => scheduleFilter = "ALL"'>
                                        <span>All</span>
                                        <span class="sched-filter-badge">@scheduleList.Count</span>
                                    </button>
                                    <button type="button" class="sched-filter-pill @(scheduleFilter == "PENDING" ? "active-pending" : "")" @onclick='() => scheduleFilter = "PENDING"'>
                                        <span>Pending</span>
                                        <span class="sched-filter-badge">@scheduleList.Count(x => string.Equals(x.status, "PENDING", StringComparison.OrdinalIgnoreCase))</span>
                                    </button>
                                    <button type="button" class="sched-filter-pill @(scheduleFilter == "COMPLETED" ? "active-completed" : "")" @onclick='() => scheduleFilter = "COMPLETED"'>
                                        <span>Completed</span>
                                        <span class="sched-filter-badge">@scheduleList.Count(x => string.Equals(x.status, "COMPLETED", StringComparison.OrdinalIgnoreCase))</span>
                                    </button>
                                    <button type="button" class="sched-filter-pill @(scheduleFilter == "MISSED" ? "active-missed" : "")" @onclick='() => scheduleFilter = "MISSED"'>
                                        <span>Missed</span>
                                        <span class="sched-filter-badge">@scheduleList.Count(x => string.Equals(x.status, "MISSED", StringComparison.OrdinalIgnoreCase))</span>
                                    </button>
                                </div>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table lc-table-fixed">
                                    <thead>
                                        <tr>
                                            <th style="width: 45px; text-align: center;">S.NO.</th>
                                            <th style="width: 140px;">SCHEDULED DATE<br /><span class="th-sub">&amp; TIME</span></th>
                                            <th style="width: 170px;">TASK / ITEM<br /><span class="th-sub">&amp; TYPE</span></th>
                                            <th>INSTRUCTIONS</th>
                                            <th style="width: 110px; text-align: center;">STATUS</th>
                                            <th>REMARKS</th>
                                            <th style="width: 120px;">RECORDED BY</th>
                                            <th style="width: 125px; text-align: center; white-space: nowrap;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!GetFilteredSchedules().Any())
                                        {
                                            <tr>
                                                <td colspan="8" class="text-center p-48 text-slate-400 italic">
                                                    <i class="bi bi-calendar2-x d-block fs-3 mb-1 text-slate-300"></i>
                                                    <span>No schedule items found.</span>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int sNo = 1;
                                            @foreach (var s in GetFilteredSchedules())
                                            {
                                                <tr class="lc-table-row">
                                                    <td style="text-align: center;" class="font-bold text-slate-500">@(sNo++)</td>
                                                    <td class="cell-wrap">
                                                        <div class="font-bold text-slate-800 fs-7">@s.scheduled_date</div>
                                                        <div class="d-flex align-items-center gap-1 mt-0.5">
                                                            <span class="text-slate-500 fs-8"><i class="bi bi-clock me-0.5"></i>@s.scheduled_time</span>
                                                            <span class="tag-shift-indigo">@s.shift</span>
                                                        </div>
                                                    </td>
                                                    <td class="cell-wrap">
                                                        <div class="font-bold text-indigo-700">@s.item_name</div>
                                                        <span class="badge @GetScheduleTypeBadge(s.item_type) mt-0.5" style="font-size: 10px; font-weight: 700;">@s.item_type</span>
                                                    </td>
                                                    <td class="cell-wrap text-slate-800">
                                                        @(string.IsNullOrWhiteSpace(s.instructions) ? "—" : s.instructions)
                                                    </td>
                                                    <td style="text-align: center;">
                                                        @if (string.Equals(s.status, "COMPLETED", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-success px-2 py-1" style="font-size: 10.5px; font-weight: 700;"><i class="bi bi-check-circle-fill me-1"></i>COMPLETED</span>
                                                        }
                                                        else if (string.Equals(s.status, "MISSED", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-danger px-2 py-1" style="font-size: 10.5px; font-weight: 700;"><i class="bi bi-exclamation-triangle-fill me-1"></i>MISSED</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark px-2 py-1" style="font-size: 10.5px; font-weight: 700;"><i class="bi bi-hourglass-split me-1"></i>PENDING</span>
                                                        }
                                                    </td>
                                                    <td class="cell-wrap text-slate-600">
                                                        @(string.IsNullOrWhiteSpace(s.remarks) ? "—" : s.remarks)
                                                    </td>
                                                    <td class="cell-wrap text-slate-600 fs-8">
                                                        @GetAddedByText(s.usercode)
                                                    </td>
                                                    <td style="text-align: center; white-space: nowrap;">
                                                        <div class="action-buttons-flex">
                                                            @if (string.Equals(s.status, "PENDING", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <button type="button" class="btn-action-icon btn-action-done" title="Mark as Completed" @onclick="() => QuickCompleteScheduleAsync(s)">
                                                                    <i class="bi bi-check-lg"></i>
                                                                </button>
                                                            }
                                                            <button type="button" class="btn-action-icon btn-action-edit" title="Edit" @onclick="() => StartEditSchedule(s)">
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-icon btn-action-delete" title="Delete" @onclick="() => DeleteScheduleAsync(s.schedule_id)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- ============================================================================= -->
<!-- BOTTOM-RIGHT UPCOMING SCHEDULE NOTIFICATION POPUP (PREMIUM GLASSMORPHIC UI)   -->
<!-- ============================================================================= -->
@if (activeScheduleAlerts.Any())
{
    <div class="schedule-alerts-fixed-container" @onclick:stopPropagation>
        @foreach (var alert in activeScheduleAlerts)
        {
            <div class="schedule-alert-popup-card shadow-2xl lc-fadeInUp" @key="alert.Schedule.schedule_id">
                <!-- Glowing Top Accent Line -->
                <div class="schedule-alert-top-bar"></div>

                <!-- Alert Header with Radar Ripple Beacon -->
                <div class="schedule-alert-header">
                    <div class="d-flex align-items-center gap-2">
                        <div class="beacon-wrap">
                            <span class="beacon-radar"></span>
                            <span class="beacon-core"></span>
                        </div>
                        <div class="schedule-alert-title-wrap">
                            <span class="schedule-alert-main-title">
                                <i class="bi bi-bell-fill text-rose-600 me-1"></i>
                                SCHEDULE ALERT
                            </span>
                            <span class="schedule-alert-countdown-badge">
                                @(alert.MinutesRemaining <= 0 ? "DUE NOW" : $"IN {alert.MinutesRemaining} MINS")
                            </span>
                        </div>
                    </div>
                    <button type="button" class="schedule-alert-close-btn" @onclick="() => DismissScheduleAlert(alert.Schedule.schedule_id)" title="Dismiss Notification">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- Alert Body -->
                <div class="schedule-alert-body">
                    <!-- Patient Info Strip (Clickable to switch patient) -->
                    <div class="schedule-alert-patient-strip" @onclick="() => NavigateToScheduleFromAlertAsync(alert)" title="Click to view this patient">
                        <div class="patient-avatar-mini">
                            @GetInitials(alert.PatientName)
                        </div>
                        <div class="schedule-alert-patient-text">
                            <div class="d-flex align-items-center gap-2">
                                <span class="schedule-alert-patient-name">@alert.PatientName</span>
                                <span class="badge-patient-ip">IP: @alert.IpNo</span>
                            </div>
                            <div class="schedule-alert-patient-sub">
                                <i class="bi bi-geo-alt-fill text-rose-500 me-1" style="font-size: 0.68rem;"></i>
                                <span>@(string.IsNullOrWhiteSpace(alert.WardBed) ? "General Ward" : alert.WardBed)</span>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-slate-400 ms-auto fs-8"></i>
                    </div>

                    <!-- Task & Instructions Card -->
                    <div class="schedule-alert-task-box">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="schedule-type-badge type-@alert.Schedule.item_type?.ToLower()">
                                <i class="bi bi-tag-fill me-1" style="font-size: 0.6rem;"></i>@alert.Schedule.item_type
                            </span>
                            <span class="schedule-time-text">
                                <i class="bi bi-clock-fill me-1 text-rose-500"></i>@FormatAlertScheduleTime(alert.Schedule.scheduled_time, alert.Schedule.shift)
                                <span class="schedule-shift-tag">@alert.Schedule.shift</span>
                            </span>
                        </div>
                        <div class="schedule-task-name-text">@alert.Schedule.item_name</div>
                        
                        <div class="schedule-instructions-box">
                            <div class="instructions-header">
                                <i class="bi bi-card-text me-1 text-rose-600"></i>
                                <span>Special Instructions</span>
                            </div>
                            <div class="instructions-content">
                                @(string.IsNullOrWhiteSpace(alert.Schedule.instructions) ? "Routine patient care procedure / administration" : alert.Schedule.instructions)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Alert Actions Footer -->
                <div class="schedule-alert-footer">
                    <button type="button" class="btn-schedule-alert-view" @onclick="() => NavigateToScheduleFromAlertAsync(alert)" title="Open patient schedule tab">
                        <i class="bi bi-box-arrow-up-right me-1"></i>
                        <span>Switch &amp; View</span>
                    </button>
                    <button type="button" class="btn-schedule-alert-complete" @onclick="() => CompleteScheduleFromAlertAsync(alert)" title="Mark task completed directly">
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>Mark Completed</span>
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- ============================================================================= -->
<!-- IP PATIENTS LIST MODAL                                                        -->
<!-- ============================================================================= -->
@if (showIpPatientsModal)
{
    <div class="ip-modal-backdrop" @onclick="CloseIpPatientsModal">
        <div class="ip-patients-modal-container" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div class="ip-modal-header">
                <div class="ip-modal-header-left">
                    <div class="ip-modal-icon">
                        <i class="bi bi-hospital-fill text-indigo-600 fs-4"></i>
                    </div>
                    <div>
                        <h3 class="ip-modal-title">Admitted IP Patients</h3>
                        <p class="ip-modal-subtitle">Bed allocations, attending doctors, and visiting doctor referrals</p>
                    </div>
                </div>
                <button type="button" class="ip-modal-close-btn" @onclick="CloseIpPatientsModal" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Modal Search & Filters Strip (Half Width Search Bar Right-Aligned near Filters) -->
            <div class="ip-modal-toolbar">
                <div class="ip-modal-toolbar-right">
                    <div class="ip-modal-filter-pills">
                        <button type="button" class="filter-pill-btn @(ipModalReferralFilter == "ALL" ? "active" : "")" @onclick='() => ipModalReferralFilter = "ALL"'>
                            All (@admittedPatients.Count)
                        </button>
                        <button type="button" class="filter-pill-btn @(ipModalReferralFilter == "REFERRED" ? "active" : "")" @onclick='() => ipModalReferralFilter = "REFERRED"'>
                            <i class="bi bi-check2-circle me-1"></i>Referred to Visiting (@GetReferredCount())
                        </button>
                    </div>

                    <div class="ip-modal-search-box">
                        <i class="bi bi-search ip-modal-search-icon"></i>
                        <input type="text"
                               class="ip-modal-search-input"
                               placeholder="Search patient, IP, bed..."
                               @bind="ipModalSearchText"
                               @bind:event="oninput" />
                        @if (!string.IsNullOrEmpty(ipModalSearchText))
                        {
                            <button type="button" class="ip-modal-search-clear" @onclick="() => ipModalSearchText = string.Empty" title="Clear">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Modal Table Content -->
            <div class="ip-modal-body">
                @if (isLoadingPatients)
                {
                    <div class="ip-modal-loading">
                        <span class="spinner-border text-indigo-600 me-2"></span>
                        <span>Loading IP patient records...</span>
                    </div>
                }
                else if (!GetFilteredModalPatients().Any())
                {
                    <div class="ip-modal-empty">
                        <i class="bi bi-person-x fs-1 text-slate-300 mb-2"></i>
                        <h4 class="text-slate-700 font-bold mb-1">No In-Patients Found</h4>
                        <p class="text-slate-400 fs-7 m-0">No admitted patients match your search criteria.</p>
                    </div>
                }
                else
                {
                    <div class="ip-modal-table-wrap">
                        <table class="ip-modal-table">
                            <thead>
                                <tr>
                                    <th style="width: 50px; text-align: center;">S.NO.</th>
                                    <th style="width: 200px;">PATIENT NAME</th>
                                    <th style="width: 140px;">IP NO</th>
                                    <th style="width: 130px;">PHONE NO</th>
                                    <th style="width: 140px;">ADMISSION DATE</th>
                                    <th style="width: 180px;">BED NO</th>
                                    <th style="width: 170px;">ATTENDING DOCTOR</th>
                                    <th style="width: 230px;">REFERRED TO VISITING DOCTOR</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int modalIdx = 1; }
                                @foreach (var pat in GetFilteredModalPatients())
                                {
                                    var isSel = selectedPatient?.ip_id == pat.ip_id;
                                    var refInfo = GetPatientVisitingDoctorInfo(pat);
                                    var phone = GetPatientPhone(pat);

                                    <tr class="ip-modal-tr @(isSel ? "row-selected" : "")" @onclick="() => SelectPatientFromModal(pat)" title="Click to view @pat.patient_name's bedside chart">
                                        <td style="text-align: center;" class="font-bold text-slate-500">@(modalIdx++)</td>
                                        <td>
                                            <div>
                                                <div class="font-bold text-slate-800 text-truncate">@(pat.patient_name ?? "—")</div>
                                                <div class="fs-8 text-slate-500">@GetPatientAgeGenderFor(pat)</div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge-ip-no">@pat.ip_no</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-1 text-slate-700 font-medium fs-7">
                                                <i class="bi bi-telephone text-indigo-500 fs-8"></i>
                                                <span>@(string.IsNullOrWhiteSpace(phone) ? "—" : phone)</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="text-slate-800 font-bold fs-7">@(pat.admitdate.ToIndianTime().ToString("dd-MMM-yyyy"))</div>
                                            <div class="text-slate-500 fs-8">@(pat.admitdate.ToIndianTime().ToString("hh:mm tt"))</div>
                                        </td>
                                        <td>
                                            <div class="font-bold text-indigo-700 fs-7">@GetWardBedText(pat.wrdcode, pat.bedcode)</div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-1 text-slate-800 font-semibold fs-7">
                                                <i class="bi bi-person-badge text-slate-400"></i>
                                                <span>@GetDoctorName(pat.dcode)</span>
                                            </div>
                                        </td>
                                        <td>
                                            @if (refInfo.IsReferred)
                                            {
                                                <div class="visiting-ref-box">
                                                    <span class="visiting-yes-pill">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Referred
                                                    </span>
                                                    <div class="visiting-doc-title">
                                                        <i class="bi bi-person-fill me-1"></i>@(string.IsNullOrWhiteSpace(refInfo.DoctorName) ? "Visiting Doctor" : refInfo.DoctorName)
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="visiting-none-pill">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

