}

.btn-action-delete:hover {
    background: #ef4444;
    color: #ffffff;
}

/* Schedule Status Filter Group */
.sched-filter-group {
    display: inline-flex;
    align-items: center;
    background: #f1f5f9;
    padding: 3px;
