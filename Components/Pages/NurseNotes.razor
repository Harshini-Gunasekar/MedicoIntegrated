    private string GetWardBedText(int? wrdcode, int? bedcode)
    {
        string ward = "General Ward";
        string bed = "";
        if (wrdcode.HasValue)
        {
            var w = wardsList.FirstOrDefault(x => x.wrdcode == wrdcode.Value);
            if (w != null && !string.IsNullOrWhiteSpace(w.name)) ward = w.name;
        }
        if (bedcode.HasValue)
        {
            var b = bedsList.FirstOrDefault(x => x.bedcode == bedcode.Value);
            if (b != null && !string.IsNullOrWhiteSpace(b.bedname))
            {
                var bedNameClean = b.bedname.Trim();
                if (bedNameClean.StartsWith("Bed", StringComparison.OrdinalIgnoreCase))
                {
                    bed = $" / {bedNameClean}";
                }
                else
                {
                    bed = $" / Bed {bedNameClean}";
                }
            }
        }
        return $"{ward}{bed}";
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "IP";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }

    private string GetAddedByText(int? usercode)
    {
        if (!string.IsNullOrWhiteSpace(currentUserName)) return currentUserName;
        return usercode.HasValue ? $"Staff #{usercode.Value}" : "Staff";
    }

    private string FormatEntryTime(TimeSpan time, DateTime createdAt)
    {
        try
        {
            if (createdAt != DateTime.MinValue && createdAt != default)
            {
                return createdAt.ToIndianTime().ToString("hh:mm tt");
            }

            var utcDt = DateTime.SpecifyKind(DateTime.UtcNow.Date.Add(time), DateTimeKind.Utc);
            return utcDt.ToIndianTime().ToString("hh:mm tt");
        }
        catch
        {
            return (createdAt != DateTime.MinValue && createdAt != default)
                ? createdAt.ToIndianTime().ToString("hh:mm tt")
                : DateTime.UtcNow.ToIndianTime().ToString("hh:mm tt");
        }
    }

    private string FormatDateTime(DateTime? dt)
    {
        if (!dt.HasValue || dt.Value == DateTime.MinValue) return "—";
        return dt.Value.ToIndianTime().ToString("dd-MM-yyyy hh:mm tt");
    }

    private string GetScheduleTypeBadge(string? type)
    {
        return (type?.ToUpperInvariant()) switch
        {
            "MEDICINE" => "bg-indigo-100 text-indigo-700 border border-indigo-200",
            "DIET" => "bg-emerald-100 text-emerald-700 border border-emerald-200",
            "PROCEDURE" => "bg-amber-100 text-amber-800 border border-amber-200",
            _ => "bg-slate-100 text-slate-700 border border-slate-200"
        };
    }
}

<script>
    window.initNurseNotesNavigation = function () {
        document.removeEventListener('keydown', window._nurseEnterHandler);
        window._nurseEnterHandler = function (e) {
            if (e.key !== 'Enter') return;
            const target = e.target;
            if (!target) return;
            
            // Ignore search inputs, case sheet modal inputs, or buttons
            if (target.classList.contains('lc-rounded-pill-input') || (target.closest && target.closest('.casesheet-modal')) || target.tagName === 'BUTTON') return;

            const row = target.closest('.form-horizontal-row, .vitals-grid-row');
            if (!row) return;

            const fields = Array.from(row.querySelectorAll('input:not([disabled]):not([type=hidden]):not([readonly]), select:not([disabled])'));
            const idx = fields.indexOf(target);
            if (idx >= 0 && idx < fields.length - 1) {
                e.preventDefault();
                target.dispatchEvent(new Event('input', { bubbles: true }));
                target.dispatchEvent(new Event('change', { bubbles: true }));
                const nextField = fields[idx + 1];
                nextField.focus();
                if (nextField.select) nextField.select();
            } else if (idx === fields.length - 1) {
                e.preventDefault();
                target.dispatchEvent(new Event('input', { bubbles: true }));
                target.dispatchEvent(new Event('change', { bubbles: true }));
                target.blur();
                setTimeout(function () {
                    const btn = row.querySelector('.btn-indigo-action');
                    if (btn && !btn.disabled) {
                        btn.click();
                    }
                }, 60);
            }
        };
        document.addEventListener('keydown', window._nurseEnterHandler);
    };

    window.focusNurseTabPrimaryField = function () {
        setTimeout(function () {
            const activeCard = document.querySelector('.nurse-workspace-card');
            if (!activeCard) return;
            const firstField = activeCard.querySelector('.form-horizontal-row input:not([disabled]):not([type=hidden]):not([readonly]), .vitals-grid-row input:not([disabled]):not([type=hidden])');
            if (firstField) {
                firstField.focus();
                if (firstField.select) firstField.select();
            }
        }, 150);
    };
</script>
