    private async Task SaveNewTemperatureInlineAsync()
    {
        if (selectedPatient == null) return;
        if (isSavingTemp) return;
        if (!newTempValue.HasValue || newTempValue.Value <= 0)
        {
            ToastService.ShowWarning("Please enter a valid temperature value (e.g. 98.6).");
            return;
        }

        isSavingTemp = true;
        try
        {
            var req = new AddTemperatureRequest
            {
                ip_id = selectedPatient.ip_id,
                custid = selectedPatient.custid,
                shift = newTempShift,
                temperature = newTempValue.Value,
                unit = newTempUnit,
                remarks = newTempRemarks
            };

            var (ok, msg) = await NurseNotesService.AddTemperatureAsync(req, DefaultTenant);
            if (ok)
            {
                ToastService.ShowSuccess("Temperature observation saved.");
                newTempValue = null;
                newTempRemarks = "";
                newTempTime = DateTime.UtcNow.ToIndianTime().ToString("hh:mm tt");
                newTempShift = GetCurrentShiftName();
                newTempUnit = "F";
                temperatureList = await NurseNotesService.GetTemperaturesAsync(selectedPatient.ip_id, DefaultTenant);
                
                try
                {
                    await newTempInputRef.FocusAsync();
                }
                catch { }
            }
            else
            {
                ToastService.ShowError(msg);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Save failed: {ex.Message}");
        }
        finally
        {
            isSavingTemp = false;
        }
    }

