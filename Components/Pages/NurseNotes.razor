            {
                activeTab = QueryTab.ToLower();
            }
            else
            {
                var savedTabResult = await _sessionStorage.GetAsync<string>("nurse_notes_active_tab");
                if (savedTabResult.Success && !string.IsNullOrWhiteSpace(savedTabResult.Value) && IsValidTab(savedTabResult.Value))
