}

.popover-list {
    max-height: 290px;
    overflow-y: auto;
    padding: 4px 0;
    background: #ffffff;
}

.popover-list::-webkit-scrollbar {
    width: 5px;
}

.popover-list::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
}

.popover-patient-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    cursor: pointer;
    transition: background 0.15s ease, border-left-color 0.15s ease;
    border-bottom: 1px solid #f8fafc;
    border-left: 3px solid transparent;
    text-decoration: none;
    user-select: none;
}

.popover-patient-item:last-child {
    border-bottom: none;
}

.popover-patient-item:hover {
    background-color: #f1f5f9;
    border-left-color: #818cf8;
}

.popover-patient-item.active-pat,
.popover-patient-item.highlighted-pat {
    background-color: #eef2ff;
    border-left-color: #4f46e5;
}

.popover-avatar {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 4px rgba(79, 70, 229, 0.2);
}

.popover-details {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.popover-pat-name {
    font-size: 12.5px;
    font-weight: 700;
    color: #1e293b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.popover-ip-badge {
    font-size: 10px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 4px;
    background: #eef2ff;
    color: #4f46e5;
    border: 1px solid #c7d2fe;
    white-space: nowrap;
}

.popover-sub-meta {
    display: flex;
    align-items: center;
