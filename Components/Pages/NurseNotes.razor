    private string GetPatientAgeGender()
    {
        if (selectedPatient == null) return "—";
        return GetPatientAgeGenderFor(selectedPatient);
    }

    private string GetPatientAgeGenderFor(IPRegistrationModel.IpRegistrationModel? pat)
    {
        if (pat == null) return "—";
        var cust = customersList.FirstOrDefault(c => c.custid == (long)pat.custid);
        if (cust != null)
        {
            var ageVal = cust.ageyears > 0 ? (int?)cust.ageyears : null;
            var ageStr = ageVal.HasValue ? $"{ageVal.Value} Y" : "";
            var genderStr = !string.IsNullOrWhiteSpace(cust.gender) ? cust.gender : "";
            if (!string.IsNullOrEmpty(ageStr) && !string.IsNullOrEmpty(genderStr))
                return $"{ageStr} / {genderStr}";
            if (!string.IsNullOrEmpty(ageStr)) return ageStr;
            if (!string.IsNullOrEmpty(genderStr)) return genderStr;
        }
        return "—";
    }

    private IEnumerable<IPRegistrationModel.IpRegistrationModel> GetFilteredModalPatients()
    {
        var list = (IEnumerable<IPRegistrationModel.IpRegistrationModel>)admittedPatients;

        if (ipModalReferralFilter == "REFERRED")
        {
            list = list.Where(p => GetPatientVisitingDoctorInfo(p).IsReferred);
        }

        if (!string.IsNullOrWhiteSpace(ipModalSearchText))
        {
            var q = ipModalSearchText.Trim().ToLower();
            list = list.Where(p =>
                (!string.IsNullOrWhiteSpace(p.patient_name) && p.patient_name.ToLower().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(p.ip_no) && p.ip_no.ToLower().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(p.mobile) && p.mobile.Contains(q)) ||
                (customersList.FirstOrDefault(c => c.custid == p.custid)?.mobile?.Contains(q) ?? false) ||
                GetWardBedText(p.wrdcode, p.bedcode).ToLower().Contains(q) ||
                GetDoctorName(p.dcode).ToLower().Contains(q) ||
                GetPatientVisitingDoctorInfo(p).DoctorName.ToLower().Contains(q)
            );
        }

        return list;
    }

