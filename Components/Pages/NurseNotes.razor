    private async Task LoadAdmissionsAsync()
    {
        isLoadingPatients = true;
        try
        {
            admittedPatients = await IpService.GetIpRegistrationsAsync("ADMITTED") ?? new();
            if (!admittedPatients.Any())
            {
                admittedPatients = await IpService.GetIpRegistrationsAsync("") ?? new();
            }

            // Check if user previously had a patient selected
            IPRegistrationModel.IpRegistrationModel? targetPat = null;
            if (!string.IsNullOrWhiteSpace(savedIpId) && Guid.TryParse(savedIpId, out var parsedGuid))
            {
                targetPat = admittedPatients.FirstOrDefault(p => p.ip_id == parsedGuid);
            }

            if (targetPat == null && admittedPatients.Any())
            {
                targetPat = admittedPatients.First();
            }

            if (targetPat != null)
            {
                await SelectPatient(targetPat, updateUrl: true);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading IP admissions: {ex.Message}");
        }
        finally
        {
            isLoadingPatients = false;
        }
    }

