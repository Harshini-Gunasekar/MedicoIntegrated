/* IP Patients Modal */
.ip-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(4px);
    z-index: 1200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: ipModalFadeIn 0.2s ease-out;
}

@@keyframes ipModalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.ip-patients-modal-container {
    background: #ffffff;
    border-radius: 14px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.08);
    border: 1px solid #e2e8f0;
    width: 100%;
    max-width: 1180px;
    height: 72vh;
    min-height: 520px;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: ipModalSlideUp 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

@@keyframes ipModalSlideUp {
    from { transform: translateY(20px) scale(0.98); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
}

.ip-modal-header {
    background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
    border-bottom: 1px solid rgba(79, 70, 229, 0.15);
    padding: 1rem 1.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.ip-modal-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
}

.ip-modal-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 4px rgba(79, 70, 229, 0.15);
}

.ip-modal-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #312e81;
    margin: 0;
}

.ip-modal-subtitle {
    font-size: 11.5px;
    color: #64748b;
    margin: 2px 0 0 0;
}

.ip-modal-close-btn {
    background: #ffffff;
    border: 1px solid #c7d2fe;
    color: #64748b;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s;
}

.ip-modal-close-btn:hover {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #ef4444;
}

.ip-modal-toolbar {
    padding: 0.65rem 1.4rem;
    background: #fafbfc;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
}

.ip-modal-toolbar-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    flex-wrap: wrap;
}

.ip-modal-search-box {
    position: relative;
    width: 210px;
    max-width: 230px;
}

.ip-modal-search-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
    pointer-events: none;
    font-size: 11px;
}

.ip-modal-search-input {
    width: 100%;
    padding: 5px 26px 5px 28px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    font-size: 12px;
    color: #1e293b;
    outline: none;
    transition: all 0.2s;
}

.ip-modal-search-input:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
}

.ip-modal-search-clear {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    padding: 0;
    font-size: 12px;
}

.ip-modal-filter-pills {
    display: flex;
    align-items: center;
    gap: 6px;
}

.filter-pill-btn {
    padding: 5px 12px;
    border-radius: 9999px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
}

.filter-pill-btn:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
    color: #334155;
}

.filter-pill-btn.active {
    background: #eef2ff;
    border-color: #818cf8;
    color: #4338ca;
    font-weight: 700;
}

.ip-modal-body {
    flex: 1 1 auto;
    overflow-y: auto;
    background: #ffffff;
    min-height: 380px;
}

.ip-modal-table-wrap {
    width: 100%;
    overflow-x: auto;
}

.ip-modal-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
}

.ip-modal-table thead th {
    background: #f8fafc;
    color: #475569;
    font-size: 10.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 10px 14px;
    border-bottom: 2px solid #e2e8f0;
    white-space: nowrap;
    position: sticky;
    top: 0;
    z-index: 10;
}

.ip-modal-tr {
    border-bottom: 1px solid #f1f5f9;
    cursor: pointer;
    transition: background 0.15s ease;
}

.ip-modal-tr:hover {
    background-color: #f8fafc;
}

.ip-modal-tr.row-selected {
    background-color: #eef2ff !important;
}

.ip-modal-tr td {
    padding: 10px 14px;
    vertical-align: middle;
}

.ip-modal-pat-avatar {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.badge-ip-no {
    display: inline-block;
    padding: 2px 7px;
    border-radius: 6px;
    background: #eef2ff;
    color: #4338ca;
    font-weight: 700;
    font-size: 11px;
    border: 1px solid #c7d2fe;
    font-family: monospace;
}

.visiting-ref-box {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.visiting-yes-pill {
    display: inline-flex;
    align-items: center;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    color: #059669;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    padding: 1px 6px;
    border-radius: 4px;
    width: fit-content;
}

.visiting-doc-title {
    font-size: 11.5px;
    font-weight: 700;
    color: #1e293b;
    display: flex;
    align-items: center;
}

.visiting-none-pill {
    color: #94a3b8;
    font-weight: 600;
    font-size: 12px;
}

.btn-select-patient {
    background: #ffffff;
    border: 1px solid #c7d2fe;
    color: #4338ca;
    font-weight: 700;
    font-size: 11px;
    padding: 4px 12px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s;
}

.btn-select-patient:hover {
    background: #4f46e5;
    color: #ffffff;
    border-color: #4f46e5;
}

.btn-select-patient.btn-active-selected {
    background: #10b981;
    color: #ffffff;
    border-color: #10b981;
}

.ip-modal-footer {
    padding: 0.85rem 1.4rem;
    background: #fafbfc;
    border-top: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.ip-modal-footer-info {
    font-size: 12px;
    color: #64748b;
    display: flex;
    align-items: center;
}

.btn-modal-close {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #475569;
    font-weight: 600;
    font-size: 12px;
    padding: 6px 16px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s;
}

.btn-modal-close:hover {
    background: #f1f5f9;
    color: #1e293b;
}

.ip-modal-loading, .ip-modal-empty {
    padding: 4rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 280px;
}

