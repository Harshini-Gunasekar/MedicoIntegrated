    private List<TestMasterModel> testMasters = new();
    private List<TestMasterModel> filteredTestMasters = new();
    private bool showTestDropdown = false;
    private int selectedTestIndex = 0;

    private async Task EnsureTestMastersLoadedAsync()
    {
        if (testMasters == null || !testMasters.Any())
        {
            try
            {
                testMasters = await TestMasterService.GetTestMastersAsync() ?? new();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading test masters: {ex.Message}");
            }
        }
    }

    private void FilterTestMasters(string? searchText)
    {
        selectedTestIndex = 0;
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredTestMasters = testMasters.Take(15).ToList();
            showTestDropdown = filteredTestMasters.Any();
            return;
        }

        var q = searchText.Trim().ToLower();
        filteredTestMasters = testMasters
            .Where(t => !string.IsNullOrWhiteSpace(t.name) && t.name.ToLower().Contains(q))
            .Take(15)
            .ToList();
        showTestDropdown = filteredTestMasters.Any();
    }

    private void OnProcedureInputChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        noteForm.procedure_name = val;
        FilterTestMasters(val);
    }

    private void OnProcedureInputFocus()
    {
        FilterTestMasters(noteForm.procedure_name);
    }

    private async Task OnProcedureInputBlur()
    {
        await Task.Delay(200);
        showTestDropdown = false;
    }

    private void OnProcedureKeyDown(KeyboardEventArgs e)
    {
        if (!showTestDropdown || filteredTestMasters == null || !filteredTestMasters.Any()) return;

        if (e.Key == "ArrowDown")
        {
            selectedTestIndex = (selectedTestIndex + 1) % filteredTestMasters.Count;
        }
        else if (e.Key == "ArrowUp")
        {
            selectedTestIndex = (selectedTestIndex - 1 + filteredTestMasters.Count) % filteredTestMasters.Count;
        }
        else if (e.Key == "Enter")
        {
            if (selectedTestIndex >= 0 && selectedTestIndex < filteredTestMasters.Count)
            {
                SelectProcedureTest(filteredTestMasters[selectedTestIndex].name);
            }
            else if (filteredTestMasters.Any())
            {
                SelectProcedureTest(filteredTestMasters[0].name);
            }
        }
        else if (e.Key == "Escape")
        {
            showTestDropdown = false;
        }
    }

    private void SelectProcedureTest(string? testName)
    {
        if (!string.IsNullOrWhiteSpace(testName))
        {
            noteForm.procedure_name = testName;
        }
        showTestDropdown = false;
    }

    private List<item_master> drugItems = new();
    private List<item_master> filteredDrugItems = new();
    private bool showDrugDropdown = false;
    private int selectedDrugIndex = 0;

    private async Task EnsureDrugItemsLoadedAsync()
    {
        if (drugItems == null || !drugItems.Any())
        {
            try
            {
                drugItems = await CaseSheetService.GetAllItemsAsync() ?? new();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading item master for drugs: {ex.Message}");
            }
        }
    }

    private void FilterDrugItems(string? searchText)
    {
        selectedDrugIndex = 0;
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredDrugItems = drugItems.Take(15).ToList();
            showDrugDropdown = filteredDrugItems.Any();
            return;
        }

        var q = searchText.Trim().ToLower();
        filteredDrugItems = drugItems
            .Where(i => (!string.IsNullOrWhiteSpace(i.itemname) && i.itemname.ToLower().Contains(q)) ||
                        (!string.IsNullOrWhiteSpace(i.drugname) && i.drugname.ToLower().Contains(q)))
            .Take(15)
            .ToList();
        showDrugDropdown = filteredDrugItems.Any();
    }

    private void OnDrugInputChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        noteForm.standalone_drug_name = val;
        FilterDrugItems(val);
    }

    private void OnDrugInputFocus()
    {
        FilterDrugItems(noteForm.standalone_drug_name);
    }

    private async Task OnDrugInputBlur()
    {
        await Task.Delay(200);
        showDrugDropdown = false;
    }

    private void OnDrugKeyDown(KeyboardEventArgs e)
    {
        if (!showDrugDropdown || filteredDrugItems == null || !filteredDrugItems.Any()) return;

        if (e.Key == "ArrowDown")
        {
            selectedDrugIndex = (selectedDrugIndex + 1) % filteredDrugItems.Count;
        }
        else if (e.Key == "ArrowUp")
        {
            selectedDrugIndex = (selectedDrugIndex - 1 + filteredDrugItems.Count) % filteredDrugItems.Count;
        }
        else if (e.Key == "Enter")
        {
            if (selectedDrugIndex >= 0 && selectedDrugIndex < filteredDrugItems.Count)
            {
                var item = filteredDrugItems[selectedDrugIndex];
                SelectDrugItem(!string.IsNullOrWhiteSpace(item.itemname) ? item.itemname : item.drugname);
            }
            else if (filteredDrugItems.Any())
            {
                var item = filteredDrugItems[0];
                SelectDrugItem(!string.IsNullOrWhiteSpace(item.itemname) ? item.itemname : item.drugname);
            }
        }
        else if (e.Key == "Escape")
        {
            showDrugDropdown = false;
        }
    }

    private void SelectDrugItem(string? name)
    {
        if (!string.IsNullOrWhiteSpace(name))
        {
            noteForm.standalone_drug_name = name;
        }
        showDrugDropdown = false;
    }

    // ─── Add/Edit Modal ──────────────────────────────────────
    private async Task OpenAddNoteModal()
    {
        await EnsureNursesLoadedAsync();
        await EnsureTestMastersLoadedAsync();
        await EnsureDrugItemsLoadedAsync();
        editingNote = null;
        noteForm = new AddNurseNoteRequest();
        noteDateTimeLocal = DateTime.Now;
        scheduledTimeLocal = null;
        givenTimeLocal = null;
        prescriptionDetailIdStr = "";
        cancelReason = "";
        showTestDropdown = false;
        showDrugDropdown = false;
        showNoteModal = true;
    }

    private async Task OpenEditNoteModal(NurseNotesModel note)
    {
        await EnsureNursesLoadedAsync();
        await EnsureTestMastersLoadedAsync();
        await EnsureDrugItemsLoadedAsync();
        showDrugDropdown = false;
        editingNote = note;
        noteForm = new AddNurseNoteRequest
        {
            ip_id = note.ip_id,
            note_type = note.note_type,
            shift = note.shift,
            given_by = note.given_by,
            notes = note.notes,
            medication_source = note.medication_source ?? "PRESCRIBED",
            prescription_detail_id = note.prescription_detail_id,
            standalone_drug_name = note.standalone_drug_name,
            standalone_dosage = note.standalone_dosage,
            standalone_route = note.standalone_route,
            medication_status = note.medication_status,
            fall_risk_score = note.fall_risk_score,
            fall_risk_level = note.fall_risk_level,
            fall_risk_scale = note.fall_risk_scale,
            fall_precautions = note.fall_precautions,
            fall_occurred = note.fall_occurred,
            fall_incident_details = note.fall_incident_details,
            dressing_site = note.dressing_site,
            wound_type = note.wound_type,
            wound_length = note.wound_length,
            wound_width = note.wound_width,
            wound_depth = note.wound_depth,
            wound_condition = note.wound_condition,
            wound_discharge = note.wound_discharge,
            wound_discharge_amount = note.wound_discharge_amount,
            bleeding = note.bleeding,
            infection_sign = note.infection_sign,
            dressing_status = note.dressing_status,
            oral_intake_ml = note.oral_intake_ml,
            iv_fluid_ml = note.iv_fluid_ml,
            urine_ml = note.urine_ml,
            vomit_ml = note.vomit_ml,
            drain_ml = note.drain_ml,
            stool_count = note.stool_count,
            total_output_ml = note.total_output_ml,
            oxygen_device = note.oxygen_device,
            oxygen_flow_rate = note.oxygen_flow_rate,
            oxygen_flow_unit = note.oxygen_flow_unit,
            fio2 = note.fio2,
            oxygen_status = note.oxygen_status,
        };
        noteDateTimeLocal = note.note_datetime.ToLocalTime();
        scheduledTimeLocal = note.scheduled_time?.ToLocalTime();
        givenTimeLocal = note.given_time?.ToLocalTime();
        prescriptionDetailIdStr = note.prescription_detail_id?.ToString() ?? "";
        showNoteModal = true;
    }

    private void OnPrescriptionSelected(ChangeEventArgs e)
    {
        var str = e.Value?.ToString();
        if (Guid.TryParse(str, out var pId))
        {
            noteForm.prescription_detail_id = pId;
            prescriptionDetailIdStr = str;
        }
        else
        {
            noteForm.prescription_detail_id = null;
            prescriptionDetailIdStr = "";
        }
    }

    private void CloseNoteModal() => showNoteModal = false;

    private async Task SaveNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(noteForm.note_type))
        {
            ToastService.ShowError("Please select a note type.");
            return;
        }

        isSavingNote = true;
        try
        {
            noteForm.ip_id = selectedPatient!.ip_id;
            noteForm.note_datetime = DateTime.SpecifyKind(noteDateTimeLocal.ToUniversalTime(), DateTimeKind.Utc);
            if (scheduledTimeLocal.HasValue)
                noteForm.scheduled_time = DateTime.SpecifyKind(scheduledTimeLocal.Value.ToUniversalTime(), DateTimeKind.Utc);
            if (givenTimeLocal.HasValue)
                noteForm.given_time = DateTime.SpecifyKind(givenTimeLocal.Value.ToUniversalTime(), DateTimeKind.Utc);
            if (Guid.TryParse(prescriptionDetailIdStr, out var pId))
                noteForm.prescription_detail_id = pId;

            if (editingNote == null)
            {
                var (ok, msg) = await NurseNotesService.AddNurseNoteAsync(noteForm);
