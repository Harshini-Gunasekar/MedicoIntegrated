    private RenderFragment RenderNoteFields(NurseNotesModel note) => builder =>
    {
        int seq = 0;

        void AddField(string label, string? value)
        {
            if (string.IsNullOrWhiteSpace(value)) return;
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "nn-field");
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "nn-field-label");
            builder.AddContent(seq++, label.TrimEnd(':') + " :");
            builder.CloseElement();
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "nn-field-value");
            builder.AddContent(seq++, " " + value);
            builder.CloseElement();
            builder.CloseElement();
        }

        // General / Patient Status
        if (!string.IsNullOrWhiteSpace(note.patient_status)) AddField("Status", note.patient_status);
        if (!string.IsNullOrWhiteSpace(note.consciousness_status)) AddField("Consciousness", note.consciousness_status);
        if (!string.IsNullOrWhiteSpace(note.clinical_condition)) AddField("Condition", note.clinical_condition);
        if (!string.IsNullOrWhiteSpace(note.mobility_status)) AddField("Mobility", note.mobility_status);
        if (!string.IsNullOrWhiteSpace(note.diet_type)) AddField("Diet", note.diet_type);

        // Fall Risk
        if (note.fall_risk_score.HasValue) AddField("Risk Score", note.fall_risk_score.ToString());
        if (!string.IsNullOrWhiteSpace(note.fall_risk_level)) AddField("Risk Level", note.fall_risk_level);
        if (!string.IsNullOrWhiteSpace(note.fall_risk_scale)) AddField("Scale", note.fall_risk_scale);
        if (!string.IsNullOrWhiteSpace(note.fall_precautions)) AddField("Precautions", note.fall_precautions);
        if (note.fall_occurred.HasValue) AddField("Fall Occurred", note.fall_occurred.Value ? "Yes" : "No");
        if (!string.IsNullOrWhiteSpace(note.fall_incident_details)) AddField("Incident", note.fall_incident_details);

        // Dressing
        if (!string.IsNullOrWhiteSpace(note.dressing_site)) AddField("Site", note.dressing_site);
        if (!string.IsNullOrWhiteSpace(note.wound_type)) AddField("Wound Type", note.wound_type);
        if (!string.IsNullOrWhiteSpace(note.dressing_type)) AddField("Dressing Type", note.dressing_type);
        if (note.wound_length.HasValue) AddField("L×W×D", $"{note.wound_length}×{note.wound_width}×{note.wound_depth} cm");
        if (!string.IsNullOrWhiteSpace(note.wound_condition)) AddField("Condition", note.wound_condition);
        if (!string.IsNullOrWhiteSpace(note.wound_discharge)) AddField("Discharge", note.wound_discharge);
        if (note.bleeding.HasValue) AddField("Bleeding", note.bleeding.Value ? "Yes" : "No");
        if (note.infection_sign.HasValue) AddField("Infection Signs", note.infection_sign.Value ? "Yes" : "No");
        if (!string.IsNullOrWhiteSpace(note.dressing_status)) AddField("Status", note.dressing_status);

        // Medication
        if (!string.IsNullOrWhiteSpace(note.medication_source))
            AddField("Source", note.medication_source == "NURSE_INITIATED" ? "Nurse Initiated" : "Prescribed");
        if (!string.IsNullOrWhiteSpace(note.standalone_drug_name)) AddField("Drug", note.standalone_drug_name);
        if (!string.IsNullOrWhiteSpace(note.standalone_dosage)) AddField("Dosage", note.standalone_dosage);
        if (!string.IsNullOrWhiteSpace(note.standalone_route)) AddField("Route", note.standalone_route);
        if (!string.IsNullOrWhiteSpace(note.medication_status)) AddField("Med Status", note.medication_status);
        if (note.scheduled_time.HasValue) AddField("Scheduled", note.scheduled_time.Value.ToLocalTime().ToString("hh:mm tt"));
        if (note.given_time.HasValue) AddField("Given At", note.given_time.Value.ToLocalTime().ToString("hh:mm tt"));

        // Infusion
        if (!string.IsNullOrWhiteSpace(note.infusion_name)) AddField("Infusion", note.infusion_name);
        if (!string.IsNullOrWhiteSpace(note.fluid_type)) AddField("Fluid Type", note.fluid_type);
        if (note.infusion_volume.HasValue) AddField("Volume", $"{note.infusion_volume} mL");
        if (note.infusion_rate.HasValue) AddField("Rate", $"{note.infusion_rate} mL/hr");
        if (!string.IsNullOrWhiteSpace(note.infusion_site)) AddField("Site", note.infusion_site);
        if (!string.IsNullOrWhiteSpace(note.infusion_status)) AddField("Status", note.infusion_status);
        if (note.total_volume_given.HasValue) AddField("Total Given", $"{note.total_volume_given} mL");

        // Procedure
        if (!string.IsNullOrWhiteSpace(note.procedure_name)) AddField("Procedure", note.procedure_name);
        if (!string.IsNullOrWhiteSpace(note.procedure_site)) AddField("Site", note.procedure_site);
        if (!string.IsNullOrWhiteSpace(note.procedure_status)) AddField("Status", note.procedure_status);
        if (!string.IsNullOrWhiteSpace(note.patient_response)) AddField("Response", note.patient_response);
        if (note.complication.HasValue) AddField("Complication", note.complication.Value ? "Yes" : "No");
        if (!string.IsNullOrWhiteSpace(note.complication_details)) AddField("Complication Details", note.complication_details);
        if (!string.IsNullOrWhiteSpace(note.procedure_result_value)) AddField("Result", $"{note.procedure_result_value} {note.procedure_result_unit}");

