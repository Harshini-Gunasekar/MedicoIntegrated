        newVitals = new OPRegistrationModel.PatientVitalsModel
        {
            vital_id = v.vital_id,
            op_id = v.op_id,
            ip_id = v.ip_id,
            ip_no = v.ip_no,
            custid = v.custid,
            dcode = v.dcode,
            bp_systolic = v.bp_systolic,
            bp_diastolic = v.bp_diastolic,
            pulse_rate = v.pulse_rate,
            temperature_f = v.temperature_f,
            spo2 = v.spo2,
            respiratory_rate = v.respiratory_rate,
