    private async Task LoadCustomersAsync()
    {
        try
        {
            using var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(DefaultTenant))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }

            string endpoint = "api/customer/getcus";
            var response = await client.GetAsync(endpoint);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                customersList = Newtonsoft.Json.JsonConvert.DeserializeObject<List<SharedComponents.Rcl.Models.CustomerModel>>(json) ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NurseNotes] LoadCustomersAsync error: {ex.Message}");
        }
    }

    private async Task LoadSelectedPatientCaseSheetAsync()
    {
        if (selectedPatient == null) return;
        try
        {
            var cs = await CaseSheetService.GetCaseSheetByVisitAsync(selectedPatient.op_id, selectedPatient.ip_id);
            currentPatientCaseSheet = cs;
            if (cs != null && cs.referred_to_visiting_doctor)
            {
                var docNames = "";
                if (cs.visiting_doctor_list != null && cs.visiting_doctor_list.Any())
                {
                    docNames = string.Join(", ", cs.visiting_doctor_list.Select(d => d.doctor_name).Where(n => !string.IsNullOrWhiteSpace(n)));
                }
                ipVisitingDoctorMap[selectedPatient.ip_id] = (true, docNames);
            }
            else
            {
                ipVisitingDoctorMap[selectedPatient.ip_id] = (false, "");
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NurseNotes] LoadSelectedPatientCaseSheetAsync error: {ex.Message}");
        }
    }

    private async Task LoadAllIpVisitingDoctorStatusAsync()
    {
        if (!admittedPatients.Any()) return;
        try
        {
            var tasks = admittedPatients.Select(async p =>
            {
                try
                {
                    var cs = await CaseSheetService.GetCaseSheetByVisitAsync(p.op_id, p.ip_id);
                    if (cs != null && cs.referred_to_visiting_doctor)
                    {
                        var docNames = "";
                        if (cs.visiting_doctor_list != null && cs.visiting_doctor_list.Any())
                        {
                            docNames = string.Join(", ", cs.visiting_doctor_list.Select(d => d.doctor_name).Where(n => !string.IsNullOrWhiteSpace(n)));
                        }
                        ipVisitingDoctorMap[p.ip_id] = (true, docNames);
                    }
                    else
                    {
                        ipVisitingDoctorMap[p.ip_id] = (false, "");
                    }
                }
                catch
                {
                    if (!ipVisitingDoctorMap.ContainsKey(p.ip_id))
                    {
                        ipVisitingDoctorMap[p.ip_id] = (false, "");
                    }
                }
            });
            await Task.WhenAll(tasks);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NurseNotes] LoadAllIpVisitingDoctorStatusAsync error: {ex.Message}");
        }
    }

