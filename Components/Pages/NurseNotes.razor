        if (!string.IsNullOrWhiteSpace(note.bladder_status)) AddField("Bladder", note.bladder_status);
        if (!string.IsNullOrWhiteSpace(note.bowel_movement)) AddField("Bowel", note.bowel_movement);

        // Restraint
        if (note.restraint_used.HasValue) AddField("Restraint Used", note.restraint_used.Value ? "Yes" : "No");
        if (!string.IsNullOrWhiteSpace(note.restraint_type)) AddField("Type", note.restraint_type);
        if (!string.IsNullOrWhiteSpace(note.restraint_reason)) AddField("Reason", note.restraint_reason);
        if (note.restraint_site_checked.HasValue) AddField("Site Checked", note.restraint_site_checked.Value ? "Yes" : "No");

        // Isolation
        if (note.isolation_required.HasValue) AddField("Isolation Required", note.isolation_required.Value ? "Yes" : "No");
        if (!string.IsNullOrWhiteSpace(note.isolation_type)) AddField("Type", note.isolation_type);
        if (!string.IsNullOrWhiteSpace(note.ppe_used)) AddField("PPE Used", note.ppe_used);
        if (note.hand_hygiene_compliance.HasValue) AddField("Hand Hygiene", note.hand_hygiene_compliance.Value ? "Complied" : "Pending");

        // Education
        if (!string.IsNullOrWhiteSpace(note.education_topic)) AddField("Topic", note.education_topic);
