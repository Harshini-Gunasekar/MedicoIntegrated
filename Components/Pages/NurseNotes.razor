}

.pill-intake { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
.pill-output { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }
.pill-net { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }

.fluid-lbl { font-size: 10px; text-transform: uppercase; }
.fluid-val { font-size: 13px; font-weight: 800; }

/* Empty & Loading */
.empty-state-box {
