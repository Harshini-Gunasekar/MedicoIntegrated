        };
        showVitalsModal = true;
    }

    private void CloseVitalsModal()
    {
        showVitalsModal = false;
        editingVitals = null;
    }

    private async Task SaveVitalsAsync()
    {
        if (selectedPatient == null) return;
        isSavingVitals = true;
        try
        {
            newVitals.ip_id = selectedPatient.ip_id;
            newVitals.custid = selectedPatient.custid;
            newVitals.dcode = selectedPatient.dcode;

            if (newVitals.height_cm.HasValue && newVitals.height_cm.Value > 0 && newVitals.weight_kg.HasValue)
            {
                var heightM = newVitals.height_cm.Value / 100m;
                newVitals.bmi = Math.Round(newVitals.weight_kg.Value / (heightM * heightM), 2);
            }

            bool ok = false;
            if (editingVitals != null && editingVitals.vital_id != Guid.Empty)
            {
                newVitals.vital_id = editingVitals.vital_id;
                ok = await AppointmentBookingService.UpdateOpVitalsAsync(newVitals);
                if (!ok)
                {
                    ok = await AppointmentBookingService.SaveOpVitalsAsync(newVitals);
                }
            }
            else
            {
                ok = await AppointmentBookingService.SaveOpVitalsAsync(newVitals);
            }

            if (ok)
            {
                ToastService.ShowSuccess(editingVitals != null ? "Vitals updated successfully!" : "Vitals recorded successfully!");
                showVitalsModal = false;
                editingVitals = null;
                vitalsLoaded = false;
                await LoadVitalsAsync();
            }
            else
            {
                ToastService.ShowError("Failed to save vitals.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving vitals: {ex.Message}");
        }
        finally
        {
            isSavingVitals = false;
        }
    }

    private void ConfirmDeleteVitals(OPRegistrationModel.PatientVitalsModel v)
    {
        vitalsToDelete = v;
        showDeleteVitalsModal = true;
    }

    private async Task DeleteVitalsAsync()
    {
        if (vitalsToDelete == null) return;
        isDeletingVitals = true;
        try
        {
            var ok = await AppointmentBookingService.DeleteOpVitalsAsync(vitalsToDelete.vital_id);
            if (ok || vitalsList != null)
            {
                vitalsList?.Remove(vitalsToDelete);
                ToastService.ShowSuccess("Vitals record deleted.");
            }
            showDeleteVitalsModal = false;
            vitalsToDelete = null;
            vitalsLoaded = false;
            await LoadVitalsAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting vitals: {ex.Message}");
        }
        finally
        {
            isDeletingVitals = false;
        }
    }

    // ─── Lifecycle ───────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadPatientsAsync();
    }

    private async Task LoadPatientsAsync()
    {
        isLoadingPatients = true;
        try
        {
            doctorsList = await DoctorService.GetDoctorsAsync() ?? new();
            nursesList = await NurseMasterService.GetNurseMastersAsync() ?? new();
            nursesList = nursesList.Where(n => n.deleted != true).ToList();
            patients = await IpService.GetIpRegistrationsAsync("") ?? new();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading patients: {ex.Message}");
        }
        finally
        {
            isLoadingPatients = false;
        }
    }

    private string GetNurseName(int? ncode)
    {
        if (!ncode.HasValue || ncode.Value <= 0) return "";
        var nurse = nursesList.FirstOrDefault(n => n.ncode == ncode.Value);
        return nurse != null && !string.IsNullOrWhiteSpace(nurse.nursename) ? nurse.nursename : $"Nurse #{ncode.Value}";
    }

    private bool caseSheetLoaded = false;
    private bool vitalsLoaded = false;

    private async Task SelectPatient(IPRegistrationModel.IpRegistrationModel p)
    {
        if (selectedPatient?.ip_id == p.ip_id) return;

        selectedPatient = p;
        activeMainTab = "notes";

        // Reset patient state
        caseSheet = null;
        vitalsList = new();
        caseSheetLoaded = false;
        vitalsLoaded = false;

        // Concurrently pre-fetch Notes, Case Sheet, and Vitals in parallel!
        var t1 = LoadNotesAsync();
        var t2 = LoadCaseSheetAsync();
        var t3 = LoadVitalsAsync();

        await Task.WhenAll(t1, t2, t3);
    }

    private async Task SwitchTab(string tab)
    {
        activeMainTab = tab;
        if (tab == "casesheet" && !caseSheetLoaded && !isLoadingCaseSheet)
        {
            await LoadCaseSheetAsync();
        }
        else if (tab == "vitals" && !vitalsLoaded && !isLoadingVitals)
        {
            await LoadVitalsAsync();
        }
    }

    private async Task LoadNotesAsync()
    {
        if (selectedPatient == null) return;
        isLoadingNotes = true;
        try
        {
            nurseNotes = await NurseNotesService.GetNotesByIpAsync(selectedPatient.ip_id, string.IsNullOrWhiteSpace(noteTypeFilter) ? null : noteTypeFilter);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading notes: {ex.Message}");
        }
        finally { isLoadingNotes = false; }
    }

    private async Task FilterNotesAsync()
    {
        await LoadNotesAsync();
    }

    private async Task LoadCaseSheetAsync()
    {
        if (selectedPatient == null) return;
        isLoadingCaseSheet = true;
        try
        {
            caseSheet = await CaseSheetService.GetCaseSheetByVisitAsync(null, selectedPatient.ip_id);
            caseSheetLoaded = true;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading case sheet: {ex.Message}");
        }
        finally { isLoadingCaseSheet = false; }
