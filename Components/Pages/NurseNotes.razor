    private async Task LoadBedsideChartDataAsync()
    {
        if (selectedPatient == null) return;
        isLoadingData = true;
        StateHasChanged();

        try
        {
            // 1. Fetch summary (GET api/IpBedsideChart/summary/{ip_id}) and vitals in parallel
            var tSummary = NurseNotesService.GetSummaryAsync(selectedPatient.ip_id, DefaultTenant);
            var tVitals = AppointmentBookingService.GetOpVitalsAsync(null, selectedPatient.ip_id);

            await Task.WhenAll(tSummary, tVitals);

            var summary = tSummary.Result;
            vitalsList = tVitals.Result ?? new();

            if (summary != null && (summary.temperature.Any() || summary.input_output.Any() || summary.service.Any() || summary.medicine.Any() || summary.other.Any() || summary.visiting_doctor.Any() || summary.schedule.Any()))
            {
                temperatureList = summary.temperature ?? new();
                inputOutputList = summary.input_output ?? new();
                serviceList = summary.service ?? new();
                medicineList = summary.medicine ?? new();
                otherList = summary.other ?? new();
                visitingDoctorList = summary.visiting_doctor ?? new();
                scheduleList = summary.schedule ?? new();
                EvaluateUpcomingSchedules();
            }
            else
            {
                // Fallback to individual segment endpoints
                var t1 = NurseNotesService.GetTemperaturesAsync(selectedPatient.ip_id, DefaultTenant);
                var t3 = NurseNotesService.GetInputOutputsAsync(selectedPatient.ip_id, DefaultTenant);
                var t4 = NurseNotesService.GetServicesAsync(selectedPatient.ip_id, DefaultTenant);
                var t5 = NurseNotesService.GetMedicinesAsync(selectedPatient.ip_id, DefaultTenant);
                var t6 = NurseNotesService.GetOthersAsync(selectedPatient.ip_id, DefaultTenant);
                var t7 = NurseNotesService.GetVisitingDoctorsAsync(selectedPatient.ip_id, DefaultTenant);
                var t8 = NurseNotesService.GetSchedulesAsync(selectedPatient.ip_id, DefaultTenant);

                await Task.WhenAll(t1, t3, t4, t5, t6, t7, t8);

                temperatureList = t1.Result ?? new();
                inputOutputList = t3.Result ?? new();
                serviceList = t4.Result ?? new();
                medicineList = t5.Result ?? new();
                otherList = t6.Result ?? new();
                visitingDoctorList = t7.Result ?? new();
                scheduleList = t8.Result ?? new();
                EvaluateUpcomingSchedules();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading chart records: {ex.Message}");
        }
        finally
        {
            isLoadingData = false;
            StateHasChanged();
        }
    }

