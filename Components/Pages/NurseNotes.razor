<!-- ============================================================================= -->
<!-- OFFICIAL CASESHEET MODAL (EMBEDDED CASESHEET COMPONENT)                        -->
<!-- ============================================================================= -->
@if (selectedPatient != null && showCaseSheetModal)
{
    <CaseSheetComponent Visible="showCaseSheetModal"
                        VisibleChanged="HandleCaseSheetVisibilityChanged"
                        IpId="selectedPatient.ip_id"
                        IpNo="@(selectedPatient.ip_no ?? string.Empty)"
                        CustId="selectedPatient.custid"
                        Dcode="selectedPatient.dcode"
                        PatientName="@(selectedPatient.patient_name ?? string.Empty)"
                        VisitDate="selectedPatient.admitdate"
                        OpStatus="ADMITTED" />
}

<!-- ============================================================================= -->
<!-- QUICK ADD IO PARTICULAR MODAL                                                  -->
<!-- ============================================================================= -->
@if (showAddParticularModal)
{
    <div class="ip-modal-backdrop" @onclick="CloseAddParticularModal">
        <div class="add-particular-modal-card" @onclick:stopPropagation>
            <div class="add-particular-modal-header">
                <h3 class="m-0 font-bold fs-5 text-slate-800">Add IO Particular</h3>
                <button type="button" class="ip-modal-close-btn" @onclick="CloseAddParticularModal" disabled="@isParticularSubmitting" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="add-particular-modal-body">
                <div class="form-group mb-3">
                    <label class="nt-form-label font-bold mb-1">Particular Name <span class="text-danger">*</span></label>
                    <input type="text"
                           class="nt-input-control w-100"
                           placeholder="e.g. IV Fluids / Urine Output"
                           @bind="newParticularName"
                           @bind:event="oninput"
                           @onkeydown="HandleAddParticularKeyDown"
                           autofocus />
                    @if (isParticularSubmitting && string.IsNullOrWhiteSpace(newParticularName))
                    {
                        <span class="text-danger fs-8">Particular name is required</span>
                    }
                </div>

                <div class="form-group mb-3">
                    <label class="nt-form-label font-bold mb-1">IO Type <span class="text-danger">*</span></label>
                    <select class="nt-select-control w-100" @bind="newParticularIoType" @onkeydown="HandleAddParticularKeyDown">
                        <option value="INPUT">INPUT (Intake: IV Fluids, Oral, etc.)</option>
                        <option value="OUTPUT">OUTPUT (Output: Urine, Vomit, Drain, etc.)</option>
                        <option value="BOTH">BOTH (Bi-directional)</option>
                    </select>
                </div>
            </div>
            <div class="add-particular-modal-footer">
                <button type="button" class="btn-cancel-modal" @onclick="CloseAddParticularModal" disabled="@isParticularSubmitting">
                    Cancel
                </button>
                <button type="button" class="btn-save-particular" @onclick="SaveNewParticularAsync" disabled="@isParticularSubmitting">
                    @if (isParticularSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>Save Particular</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ============================================================================= -->
<!-- QUICK ADD SERVICE NAME MODAL                                                   -->
<!-- ============================================================================= -->
@if (showAddServiceModal)
{
    <div class="ip-modal-backdrop" @onclick="CloseAddServiceModal">
        <div class="add-particular-modal-card add-service-modal-card" @onclick:stopPropagation>
            <div class="add-particular-modal-header">
                <h3 class="m-0 font-bold fs-5 text-slate-800">Add Service Name</h3>
                <button type="button" class="ip-modal-close-btn" @onclick="CloseAddServiceModal" disabled="@isServiceSubmitting" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="add-particular-modal-body">
                <div class="form-group mb-3">
                    <label class="nt-form-label font-bold mb-1">Service Name <span class="text-danger">*</span></label>
                    <input type="text"
                           class="nt-input-control w-100"
                           placeholder="e.g. Wound Dressing / Nebulization / Catheterization"
                           @bind="newServiceName"
                           @bind:event="oninput"
                           @onkeydown="HandleAddServiceKeyDown"
                           autofocus />
                    @if (isServiceSubmitting && string.IsNullOrWhiteSpace(newServiceName))
                    {
                        <span class="text-danger fs-8">Service name is required</span>
                    }
                </div>
            </div>
            <div class="add-particular-modal-footer">
                <button type="button" class="btn-cancel-modal" @onclick="CloseAddServiceModal" disabled="@isServiceSubmitting">
                    Cancel
                </button>
                <button type="button" class="btn-save-particular" @onclick="SaveNewServiceAsync" disabled="@isServiceSubmitting">
                    @if (isServiceSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>Save Service</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ============================================================================= -->
<!-- QUICK ADD SCHEDULE TYPE / TASK MODAL                                           -->
<!-- ============================================================================= -->
@if (showAddScheduleTypeModal)
{
    <div class="ip-modal-backdrop" @onclick="CloseAddScheduleTypeModal">
        <div class="add-particular-modal-card add-schedule-type-modal-card" @onclick:stopPropagation>
            <div class="add-particular-modal-header">
                <h3 class="m-0 font-bold fs-5 text-slate-800">Add Schedule Task</h3>
                <button type="button" class="ip-modal-close-btn" @onclick="CloseAddScheduleTypeModal" disabled="@isScheduleSubmitting" title="Close">
                    <i class="bi bi-x-lg"></i>
