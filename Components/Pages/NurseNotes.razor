.custom-dropdown-wrap {
    position: relative;
    width: 100%;
}

.btn-input-edge-add {
    position: absolute;
    right: 5px;
    top: 50%;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    border: none;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 1px 3px rgba(79, 70, 229, 0.35);
    transition: all 0.15s ease;
    z-index: 5;
    padding: 0;
