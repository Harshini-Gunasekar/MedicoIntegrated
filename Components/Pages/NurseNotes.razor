                                    <option value="NIL">Nil</option>
                                    <option value="MINIMAL_SEROUS">Minimal Serous</option>
                                    <option value="SEROUS">Serous</option>
                                    <option value="SEROSANGUINOUS">Serosanguinous</option>
                                    <option value="SANGUINOUS">Sanguinous</option>
                                    <option value="PURULENT">Purulent</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Dressing Status</label>
                                <select class="nn-select" @bind="noteForm.dressing_status">
                                    <option value="">-- Status --</option>
                                    <option value="COMPLETED">Completed</option>
                                    <option value="PENDING">Pending</option>
                                    <option value="NOT_REQUIRED">Not Required</option>
                                </select>
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Bleeding?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.bleeding" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.bleeding == true ? "Yes" : "No")</span>
                                </div>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Infection Signs?</label>
                                <div class="nn-toggle-row">
                                    <label class="nn-toggle">
                                        <input type="checkbox" @bind="noteForm.infection_sign" />
                                        <span class="nn-toggle-slider"></span>
                                    </label>
                                    <span class="nn-toggle-text">@(noteForm.infection_sign == true ? "Yes" : "No")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @* MEDICATION *@
                @if (noteForm.note_type == "MEDICATION")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-capsule-pill"></i> Medication Details</div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Medication Status</label>
                                <select class="nn-select" @bind="noteForm.medication_status">
                                    <option value="">-- Status --</option>
                                    <option value="GIVEN">Given</option>
                                    <option value="SKIPPED">Skipped</option>
                                    <option value="REFUSED">Refused</option>
                                    <option value="HELD">Held</option>
                                </select>
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Prescription Detail ID</label>
                                <input type="text" class="nn-input" placeholder="GUID" @bind="prescriptionDetailIdStr" />
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Scheduled Time</label>
                                <input type="datetime-local" class="nn-input" @bind="scheduledTimeLocal" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Given Time</label>
                                <input type="datetime-local" class="nn-input" @bind="givenTimeLocal" />
                            </div>
                        </div>
                    </div>
                }

                @* INTAKE/OUTPUT *@
                @if (noteForm.note_type == "INTAKE_OUTPUT")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-droplet-half"></i> Intake / Output</div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Oral Intake (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.oral_intake_ml" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">IV Fluid (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.iv_fluid_ml" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Tube Feed (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.tube_feed_ml" />
                            </div>
                        </div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Urine Output (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.urine_ml" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Vomit (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.vomit_ml" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Drain (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.drain_ml" />
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">Stool Count</label>
                                <input type="number" class="nn-input" @bind="noteForm.stool_count" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Total Output (mL)</label>
                                <input type="number" class="nn-input" @bind="noteForm.total_output_ml" />
                            </div>
                        </div>
                    </div>
                }

                @* OXYGEN *@
                @if (noteForm.note_type == "OXYGEN")
                {
                    <div class="nn-modal-card">
                        <div class="nn-form-section-title"><i class="bi bi-lungs-fill"></i> Oxygen Therapy</div>
                        <div class="nn-form-row-3">
                            <div class="nn-form-group">
                                <label class="nn-label">Device</label>
                                <input type="text" class="nn-input" placeholder="e.g. Nasal Cannula" @bind="noteForm.oxygen_device" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Flow Rate</label>
                                <input type="number" step="0.5" class="nn-input" @bind="noteForm.oxygen_flow_rate" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Flow Unit</label>
                                <input type="text" class="nn-input" placeholder="L/min" @bind="noteForm.oxygen_flow_unit" />
                            </div>
                        </div>
                        <div class="nn-form-row-2">
                            <div class="nn-form-group">
                                <label class="nn-label">FiO2 (%)</label>
                                <input type="number" step="1" class="nn-input" @bind="noteForm.fio2" />
                            </div>
                            <div class="nn-form-group">
                                <label class="nn-label">Status</label>
                                <select class="nn-select" @bind="noteForm.oxygen_status">
                                    <option value="">-- Status --</option>
                                    <option value="STARTED">Started</option>
                                    <option value="ONGOING">Ongoing</option>
                                    <option value="STOPPED">Stopped</option>
                                    <option value="WEANED">Weaned</option>
                                </select>
                            </div>
                        </div>
                    </div>
                }

                @* GENERAL NOTES *@
                <div class="nn-modal-card" style="margin-bottom:0;">
                    <div class="nn-form-group" style="margin-bottom:0;">
                        <label class="nn-label"><i class="bi bi-journal-text"></i> Additional Notes</label>
                        <textarea class="nn-textarea" rows="3" placeholder="Enter any additional observations, clinical findings, or nurse remarks…" @bind="noteForm.notes"></textarea>
                    </div>
                </div>
            </div>

            <div class="nn-modal-footer">
                <button class="nn-btn nn-btn-ghost" @onclick="CloseNoteModal" disabled="@isSavingNote">Cancel</button>
                <button class="nn-btn nn-btn-primary" @onclick="SaveNoteAsync" disabled="@isSavingNote">
                    @if (isSavingNote)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-floppy-fill"></i>
                    }
                    @(editingNote == null ? "Add Note" : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════════════ CANCEL MODAL ══════════════════════════════════════ *@
@if (showCancelModal)
{
    <div class="nn-modal-backdrop" @onclick="() => showCancelModal = false">
        <div class="nn-modal" style="max-width:440px;" @onclick:stopPropagation>
            <div class="nn-modal-header">
                <div class="nn-modal-title"><i class="bi bi-x-circle-fill" style="color:#dc2626;"></i> Cancel Note</div>
                <button class="nn-modal-close" @onclick="() => showCancelModal = false">×</button>
            </div>
            <div class="nn-modal-body">
                <div class="nn-form-group">
                    <label class="nn-label">Cancel Reason <span class="nn-required">*</span></label>
                    <textarea class="nn-textarea" rows="3" placeholder="Enter reason for cancellation…" @bind="cancelReason"></textarea>
                </div>
                <div class="nn-form-group">
                    <label class="nn-label">Cancelled By (Staff ID)</label>
                    <input type="number" class="nn-input" @bind="cancelledBy" />
                </div>
            </div>
            <div class="nn-modal-footer">
                <button class="nn-btn nn-btn-ghost" @onclick="() => showCancelModal = false">Back</button>
                <button class="nn-btn" style="background:#dc2626;color:#fff;" @onclick="ExecuteCancelNote" disabled="@isSavingNote">
                    @if (isSavingNote) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-x-circle-fill"></i> }
                    Confirm Cancel
                </button>
            </div>
        </div>
    </div>
}

@code {
    // ─── State ──────────────────────────────────────────────
    private bool isLoadingPatients = false;
    private bool isLoadingNotes = false;
    private bool isLoadingCaseSheet = false;
    private bool isLoadingVitals = false;
    private bool isSavingNote = false;

    private string patientSearch = "";
    private string noteTypeFilter = "";
    private string activeMainTab = "notes";

    private List<IPRegistrationModel.IpRegistrationModel> patients = new();
    private List<DoctorMasterModel> doctorsList = new();
    private IPRegistrationModel.IpRegistrationModel? selectedPatient;

    private List<NurseNotesModel> nurseNotes = new();
    private CaseSheetViewModel? caseSheet;
    private List<OPRegistrationModel.PatientVitalsModel>? vitalsList;

    // ─── Add/Edit Modal ──────────────────────────────────────
    private bool showNoteModal = false;
    private NurseNotesModel? editingNote;
    private AddNurseNoteRequest noteForm = new();
    private DateTime noteDateTimeLocal = DateTime.Now;
    private DateTime? scheduledTimeLocal;
    private DateTime? givenTimeLocal;
    private string prescriptionDetailIdStr = "";

    // ─── Cancel Modal ────────────────────────────────────────
    private bool showCancelModal = false;
    private NurseNotesModel? noteToCancel;
    private string cancelReason = "";
    private int cancelledBy = 1;

    // ─── Lifecycle ───────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadPatientsAsync();
    }

    private async Task LoadPatientsAsync()
    {
        isLoadingPatients = true;
        try
        {
            doctorsList = await DoctorService.GetDoctorsAsync() ?? new();
            patients = await IpService.GetIpRegistrationsAsync("") ?? new();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading patients: {ex.Message}");
        }
        finally
        {
            isLoadingPatients = false;
        }
    }

    private async Task SelectPatient(IPRegistrationModel.IpRegistrationModel p)
    {
        selectedPatient = p;
        activeMainTab = "notes";
        await LoadNotesAsync();
    }

    private async Task LoadNotesAsync()
    {
        if (selectedPatient == null) return;
        isLoadingNotes = true;
        try
        {
            nurseNotes = await NurseNotesService.GetNotesByIpAsync(selectedPatient.ip_id, string.IsNullOrWhiteSpace(noteTypeFilter) ? null : noteTypeFilter);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading notes: {ex.Message}");
        }
        finally { isLoadingNotes = false; }
    }

    private async Task FilterNotesAsync()
    {
        await LoadNotesAsync();
    }

    private async Task LoadCaseSheetAsync()
    {
        if (selectedPatient == null) return;
        isLoadingCaseSheet = true;
        try
        {
            caseSheet = await CaseSheetService.GetCaseSheetByVisitAsync(null, selectedPatient.ip_id);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading case sheet: {ex.Message}");
        }
        finally { isLoadingCaseSheet = false; }
    }

    private async Task LoadVitalsAsync()
    {
        if (selectedPatient == null) return;
        isLoadingVitals = true;
        try
        {
            vitalsList = await AppointmentBookingService.GetOpVitalsAsync(null, selectedPatient.ip_id);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading vitals: {ex.Message}");
        }
        finally { isLoadingVitals = false; }
    }

    // ─── Add/Edit Modal ──────────────────────────────────────
    private void OpenAddNoteModal()
    {
        editingNote = null;
        noteForm = new AddNurseNoteRequest();
        noteDateTimeLocal = DateTime.Now;
        scheduledTimeLocal = null;
        givenTimeLocal = null;
        prescriptionDetailIdStr = "";
        cancelReason = "";
        showNoteModal = true;
    }

    private void OpenEditNoteModal(NurseNotesModel note)
    {
        editingNote = note;
        noteForm = new AddNurseNoteRequest
        {
            ip_id = note.ip_id,
            note_type = note.note_type,
            shift = note.shift,
            given_by = note.given_by,
            notes = note.notes,
            fall_risk_score = note.fall_risk_score,
            fall_risk_level = note.fall_risk_level,
            fall_risk_scale = note.fall_risk_scale,
            fall_precautions = note.fall_precautions,
            fall_occurred = note.fall_occurred,
            fall_incident_details = note.fall_incident_details,
            dressing_site = note.dressing_site,
            wound_type = note.wound_type,
            wound_length = note.wound_length,
            wound_width = note.wound_width,
            wound_depth = note.wound_depth,
            wound_condition = note.wound_condition,
            wound_discharge = note.wound_discharge,
            wound_discharge_amount = note.wound_discharge_amount,
            bleeding = note.bleeding,
            infection_sign = note.infection_sign,
            dressing_status = note.dressing_status,
            medication_status = note.medication_status,
            oral_intake_ml = note.oral_intake_ml,
            iv_fluid_ml = note.iv_fluid_ml,
            urine_ml = note.urine_ml,
            vomit_ml = note.vomit_ml,
            drain_ml = note.drain_ml,
            stool_count = note.stool_count,
            total_output_ml = note.total_output_ml,
            oxygen_device = note.oxygen_device,
            oxygen_flow_rate = note.oxygen_flow_rate,
            oxygen_flow_unit = note.oxygen_flow_unit,
            fio2 = note.fio2,
            oxygen_status = note.oxygen_status,
        };
        noteDateTimeLocal = note.note_datetime.ToLocalTime();
        scheduledTimeLocal = note.scheduled_time?.ToLocalTime();
        givenTimeLocal = note.given_time?.ToLocalTime();
        prescriptionDetailIdStr = note.prescription_detail_id?.ToString() ?? "";
        showNoteModal = true;
    }

    private void CloseNoteModal() => showNoteModal = false;

    private async Task SaveNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(noteForm.note_type))
        {
            ToastService.ShowError("Please select a note type.");
            return;
        }

        isSavingNote = true;
        try
        {
            noteForm.ip_id = selectedPatient!.ip_id;
            noteForm.note_datetime = DateTime.SpecifyKind(noteDateTimeLocal.ToUniversalTime(), DateTimeKind.Utc);
            if (scheduledTimeLocal.HasValue)
                noteForm.scheduled_time = DateTime.SpecifyKind(scheduledTimeLocal.Value.ToUniversalTime(), DateTimeKind.Utc);
            if (givenTimeLocal.HasValue)
                noteForm.given_time = DateTime.SpecifyKind(givenTimeLocal.Value.ToUniversalTime(), DateTimeKind.Utc);
            if (Guid.TryParse(prescriptionDetailIdStr, out var pId))
                noteForm.prescription_detail_id = pId;

            if (editingNote == null)
            {
                var (ok, msg) = await NurseNotesService.AddNurseNoteAsync(noteForm);
                if (ok) { ToastService.ShowSuccess(msg); showNoteModal = false; await LoadNotesAsync(); }
                else ToastService.ShowError(msg);
            }
            else
            {
                var updateReq = new UpdateNurseNoteRequest
                {
                    note_id = editingNote.note_id,
                    ip_id = noteForm.ip_id,
                    note_type = noteForm.note_type,
                    shift = noteForm.shift,
                    given_by = noteForm.given_by,
                    notes = noteForm.notes,
                    dressing_site = noteForm.dressing_site,
                    wound_condition = noteForm.wound_condition,
                    wound_discharge = noteForm.wound_discharge,
                    dressing_status = noteForm.dressing_status,
                    fall_risk_score = noteForm.fall_risk_score,
                    fall_risk_level = noteForm.fall_risk_level,
                    fall_risk_scale = noteForm.fall_risk_scale,
                    fall_precautions = noteForm.fall_precautions,
                    fall_occurred = noteForm.fall_occurred,
                    medication_status = noteForm.medication_status,
                };
                var (ok, msg) = await NurseNotesService.UpdateNurseNoteAsync(updateReq);
                if (ok) { ToastService.ShowSuccess(msg); showNoteModal = false; await LoadNotesAsync(); }
                else ToastService.ShowError(msg);
            }
        }
        finally { isSavingNote = false; }
    }

    // ─── Verify ──────────────────────────────────────────────
    private async Task VerifyNote(NurseNotesModel note)
    {
        var req = new VerifyNurseNoteRequest { note_id = note.note_id, verified_by = 1 };
        var (ok, msg) = await NurseNotesService.VerifyNurseNoteAsync(req);
        if (ok) { ToastService.ShowSuccess(msg); await LoadNotesAsync(); }
        else ToastService.ShowError(msg);
    }

    // ─── Cancel ──────────────────────────────────────────────
    private void ConfirmCancelNote(NurseNotesModel note)
    {
        noteToCancel = note;
        cancelReason = "";
        cancelledBy = 1;
        showCancelModal = true;
    }

    private async Task ExecuteCancelNote()
    {
        if (string.IsNullOrWhiteSpace(cancelReason))
        {
            ToastService.ShowError("Please provide a cancel reason.");
            return;
        }
        isSavingNote = true;
        var req = new CancelNurseNoteRequest { note_id = noteToCancel!.note_id, cancelled_by = cancelledBy, cancel_reason = cancelReason };
        var (ok, msg) = await NurseNotesService.CancelNurseNoteAsync(req);
        isSavingNote = false;
        if (ok) { ToastService.ShowSuccess(msg); showCancelModal = false; await LoadNotesAsync(); }
        else ToastService.ShowError(msg);
    }

    // ─── Delete ──────────────────────────────────────────────
    private async Task ConfirmDeleteNote(NurseNotesModel note)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete this nursing note? This action cannot be undone.");
        if (!confirmed) return;
        var (ok, msg) = await NurseNotesService.DeleteNurseNoteAsync(note.note_id);
        if (ok) { ToastService.ShowSuccess(msg); await LoadNotesAsync(); }
        else ToastService.ShowError(msg);
    }

    // ─── Helpers ─────────────────────────────────────────────
    private IEnumerable<IPRegistrationModel.IpRegistrationModel> GetFilteredPatients()
    {
        var result = patients.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(patientSearch))
        {
            var q = patientSearch.Trim().ToLower();
            result = result.Where(p =>
                (p.patient_name != null && p.patient_name.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (p.ip_no != null && p.ip_no.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (p.mobile != null && p.mobile.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }
        return result;
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private string GetDoctorName(int dcode)
    {
        var doc = doctorsList.FirstOrDefault(d => d.dcode == dcode);
        if (doc == null) return $"Dr. #{dcode}";
        return string.IsNullOrWhiteSpace(doc.name) ? $"Dr. #{dcode}" : $"Dr. {doc.name}";
    }

