/* ─────────────────────────────────────────────────────────────────────────────
   SCHEDULE ALERT POPUP (COMPACT PREMIUM FLOATING CARD)
   ───────────────────────────────────────────────────────────────────────────── */
.schedule-alerts-fixed-container {
    position: fixed;
    bottom: 18px;
    right: 18px;
    z-index: 10005;
    display: flex;
    flex-direction: column-reverse;
    gap: 8px;
    max-width: 310px;
    width: calc(100vw - 36px);
    pointer-events: auto;
}

.schedule-alert-popup-card {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 12px;
    border: 1px solid rgba(244, 63, 94, 0.28);
    box-shadow: 0 12px 28px -6px rgba(15, 23, 42, 0.16),
                0 0 0 1px rgba(244, 63, 94, 0.12),
                0 4px 10px -2px rgba(244, 63, 94, 0.12);
    overflow: hidden;
    animation: scheduleAlertPop 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transition: all 0.2s ease;
}

.schedule-alert-top-bar {
    height: 3px;
    background: linear-gradient(90deg, #f43f5e 0%, #fb7185 50%, #e11d48 100%);
    width: 100%;
}

@@keyframes scheduleAlertPop {
    0% {
        opacity: 0;
        transform: translateY(16px) scale(0.95);
    }
    100% {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.schedule-alert-header {
    background: linear-gradient(135deg, #fff5f5 0%, #ffe4e6 100%);
    padding: 6px 10px;
    border-bottom: 1px solid #fed7aa;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.beacon-wrap {
    position: relative;
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.beacon-core {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e11d48;
    z-index: 2;
    box-shadow: 0 0 6px rgba(225, 29, 72, 0.8);
}

.beacon-radar {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgba(225, 29, 72, 0.4);
    animation: beaconRadarWave 1.4s infinite ease-out;
}

@@keyframes beaconRadarWave {
    0% {
        transform: scale(0.6);
        opacity: 1;
    }
    100% {
        transform: scale(2.2);
        opacity: 0;
    }
}

.schedule-alert-title-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
}

.schedule-alert-main-title {
    font-size: 0.7rem;
    font-weight: 800;
    color: #9f1239;
    letter-spacing: 0.3px;
    text-transform: uppercase;
}

.schedule-alert-countdown-badge {
    background: linear-gradient(135deg, #e11d48 0%, #be123c 100%);
    color: #ffffff;
    font-size: 0.58rem;
    font-weight: 800;
    padding: 1px 6px;
    border-radius: 9999px;
    letter-spacing: 0.3px;
    box-shadow: 0 2px 6px rgba(225, 29, 72, 0.35);
    animation: badgePulse 1.2s infinite ease-in-out;
}

@@keyframes badgePulse {
    0%, 100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.05);
    }
}

.schedule-alert-close-btn {
    background: rgba(225, 29, 72, 0.08);
    border: none;
    color: #9f1239;
    font-size: 0.72rem;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
}

.schedule-alert-close-btn:hover {
    background: #e11d48;
    color: #ffffff;
    transform: rotate(90deg);
}

.schedule-alert-body {
    padding: 7px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.schedule-alert-patient-strip {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 4px 7px;
    background: #f8fafc;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    cursor: pointer;
    transition: all 0.15s ease;
}

.schedule-alert-patient-strip:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
}

.patient-avatar-mini {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.62rem;
    font-weight: 800;
    flex-shrink: 0;
}

.schedule-alert-patient-name {
    font-size: 0.76rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
}

.badge-patient-ip {
    background: #e0e7ff;
    color: #3730a3;
    font-size: 0.58rem;
    font-weight: 700;
    padding: 0px 4px;
    border-radius: 3px;
}

.schedule-alert-patient-sub {
    font-size: 0.65rem;
    color: #64748b;
    font-weight: 600;
    display: flex;
    align-items: center;
    margin-top: 1px;
}

.schedule-alert-task-box {
    background: #fff5f5;
    border-radius: 8px;
    padding: 6px 8px;
    border: 1px solid #fecdd3;
}

.schedule-type-badge {
    font-size: 0.58rem;
    font-weight: 800;
    padding: 1px 5px;
