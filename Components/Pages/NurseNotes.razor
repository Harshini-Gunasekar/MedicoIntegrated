    private IEnumerable<NurseScheduleModel> GetFilteredSchedules()
    {
        if (scheduleFilter == "ALL") return scheduleList.OrderBy(x => x.scheduled_date).ThenBy(x => x.scheduled_time);
        return scheduleList.Where(x => string.Equals(x.status, scheduleFilter, StringComparison.OrdinalIgnoreCase))
                           .OrderByDescending(x => x.scheduled_date).ThenBy(x => x.scheduled_time);
    }

