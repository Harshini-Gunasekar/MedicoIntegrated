    private IEnumerable<IPRegistrationModel.IpRegistrationModel> GetFilteredPatients()
    {
        var result = patients.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(patientSearch))
        {
            var q = patientSearch.Trim().ToLower();
            result = result.Where(p =>
                (p.patient_name != null && p.patient_name.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (p.ip_no != null && p.ip_no.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (p.mobile != null && p.mobile.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }
        return result;
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private string GetDoctorName(int dcode)
    {
        var doc = doctorsList.FirstOrDefault(d => d.dcode == dcode);
        if (doc == null) return $"Dr. #{dcode}";
        return string.IsNullOrWhiteSpace(doc.name) ? $"Dr. #{dcode}" : $"Dr. {doc.name}";
    }

