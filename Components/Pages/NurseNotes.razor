    private async Task OnParticularsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown")
        {
            var count = GetFilteredParticulars().Count();
            if (count > 0)
            {
                highlightedParticularIndex = (highlightedParticularIndex + 1) % count;
            }
            isParticularsDropdownOpen = true;
        }
        else if (e.Key == "ArrowUp")
        {
            var count = GetFilteredParticulars().Count();
            if (count > 0)
            {
                highlightedParticularIndex = (highlightedParticularIndex - 1 + count) % count;
            }
            isParticularsDropdownOpen = true;
        }
        else if (e.Key == "Enter")
        {
            if (isParticularsDropdownOpen)
            {
                var items = GetFilteredParticulars().ToList();
                if (items.Any())
                {
                    var idx = (highlightedParticularIndex >= 0 && highlightedParticularIndex < items.Count) ? highlightedParticularIndex : 0;
                    SelectParticular(items[idx].particular_name);
                    try { await JSRuntime.InvokeVoidAsync("focusNextFieldFromParticulars"); } catch { }
                }
                else if (!string.IsNullOrWhiteSpace(ioParticulars))
                {
                    OpenAddParticularModal();
                }
            }
            else
            {
                try { await JSRuntime.InvokeVoidAsync("focusNextFieldFromParticulars"); } catch { }
            }
        }
        else if (e.Key == "Escape")
        {
            isParticularsDropdownOpen = false;
        }
    }

