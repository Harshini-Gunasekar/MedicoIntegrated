        if (!bookStartTime.HasValue)
        {
            ToastService.ShowWarning("Please specify a start time.");
            return;
        }

        if (!bookEndTime.HasValue)
        {
            ToastService.ShowWarning("Please specify an estimated end time.");
            return;
        }

        if (bookEndTime.Value <= bookStartTime.Value)
        {
            ToastService.ShowWarning("Estimated end time must be after start time.");
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            var req = new AddOtScheduleRequest
            {
                request_id = bookRequestId,
                ot_id = bookOtId,
                custid = bookCustId,
                scheduled_date = bookDate,
                scheduled_time = bookStartTime.Value,
                estimated_end_time = bookEndTime.Value,
                notes = bookNotes
