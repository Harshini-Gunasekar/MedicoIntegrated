            }

            if (!string.IsNullOrWhiteSpace(selectedStatusFilter) && selectedStatusFilter != "ALL")
            {
                list = list.Where(s => {
                    var req = allRequests.FirstOrDefault(r => r.request_id == s.request_id);
                    var effStatus = GetEffectiveSurgeryStatus(s, req);
                    if (selectedStatusFilter == "BOOKED")
                    {
                        return effStatus is "BOOKED" or "SCHEDULED" or "REQUESTED";
                    }
                    if (selectedStatusFilter == "IN_PROGRESS")
                    {
                        return effStatus is "IN_PROGRESS" or "IN_OP" or "IN_SURGERY" or "SURGERY";
                    }
                    if (selectedStatusFilter == "COMPLETED")
                    {
                        return effStatus is "COMPLETED" or "FINISHED";
                    }
                    return effStatus.Equals(selectedStatusFilter, StringComparison.OrdinalIgnoreCase);
                });
            }

            if (!string.IsNullOrWhiteSpace(slotSearchQuery))
            {
                var q = slotSearchQuery.Trim().ToLowerInvariant();
                list = list.Where(s => {
                    var req = allRequests.FirstOrDefault(r => r.request_id == s.request_id);
                    var patName = (req?.patient_name ?? GetPatientName(s.custid)).ToLowerInvariant();
                    var docName = (req?.doctor_name ?? GetDoctorName(req?.dcode ?? 0)).ToLowerInvariant();
