            var nowTime = TimeOnly.FromDateTime(now);
            double offset = GetHoursFromShiftStart(nowTime, false);
            if (offset >= 0.0 && offset <= 12.0)
            {
                return (offset / 12.0) * 100.0;
            }
            return null;
        }
    }

