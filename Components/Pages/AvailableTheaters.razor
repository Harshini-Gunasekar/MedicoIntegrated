@page "/ot-availability"
@page "/available-theaters"
@page "/booking/available-theaters"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using medico_backend.Model
@using Medico_Backend.Model
@using Booking.Models
@using Booking.Services
@using Booking.Helpers
@inject OtService OtService
@inject DoctorService DoctorService
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<PageTitle>Available Operation Theaters &amp; Daily Schedule</PageTitle>

<div class="referral-page available-theaters-page">
    <!-- ========================================================================= -->
    <!-- 1. TOP HEADER (VIEW SELECTOR, THEATER SELECTOR, DATE NAV, & SCHEDULE CTA) -->
    <!-- ========================================================================= -->
    <div class="theater-page-header">
        <div class="header-title-left">
            <div class="header-icon-box">
                <i class="bi bi-hospital"></i>
            </div>
            <div class="header-text-group">
                <h1 class="page-main-title">Available Operation Theaters</h1>
                <p class="page-subtitle">Visual suite vacancy &amp; real-time slot schedule (IST)</p>
            </div>
        </div>

        <div class="header-controls-right">
            <!-- View Mode Segmented Selector (Timeline / Cards / Table - Icons Only) -->
            <div class="view-mode-segmented" title="Choose View Format">
                <button type="button"
                        class="btn-view-mode @(currentViewMode == ViewMode.Timeline ? "active" : "")"
                        @onclick="() => SetViewMode(ViewMode.Timeline)"
                        title="Timeline Schedule Grid View">
                    <i class="bi bi-clock-history"></i>
                </button>
                <button type="button"
                        class="btn-view-mode @(currentViewMode == ViewMode.Cards ? "active" : "")"
                        @onclick="() => SetViewMode(ViewMode.Cards)"
                        title="Booked Slots Card View">
                    <i class="bi bi-grid-fill"></i>
                </button>
                <button type="button"
                        class="btn-view-mode @(currentViewMode == ViewMode.Table ? "active" : "")"
                        @onclick="() => SetViewMode(ViewMode.Table)"
                        title="Booked Slots Table View">
                    <i class="bi bi-table"></i>
                </button>
            </div>

            <!-- OT Theater Single Dropdown Filter -->
            <div class="header-filter-select-wrap">
                <i class="bi bi-door-open header-filter-icon"></i>
                <select class="header-filter-select" value="@selectedOtFilterString" @onchange="OnHeaderOtFilterChanged">
                    <option value="">All OT Theaters (@allTheaters.Count)</option>
                    @foreach (var ot in allTheaters)
                    {
                        var schedCount = GetSchedulesForTheater(ot.ot_id).Count;
                        <option value="@ot.ot_id.ToString()">@ot.ot_name @(schedCount > 0 ? $"({schedCount} ops)" : "")</option>
                    }
                </select>
                <i class="bi bi-chevron-down header-filter-chevron"></i>
            </div>

            <!-- Date Navigation Controls (Date Only without Today button) -->
            <div class="header-date-nav">
                <button type="button" class="btn-nav-date" @onclick="GoPreviousDay" title="Previous Day">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <div class="header-date-picker-box" onclick="this.querySelector('input[type=date]')?.showPicker?.()" title="Click to choose date">
                    <i class="bi bi-calendar3 header-date-icon"></i>
                    <input type="date"
                           class="header-date-input"
                           value="@scheduledDate.ToString("yyyy-MM-dd")"
                           @onchange="OnDateChanged"
                           onclick="this.showPicker && this.showPicker()" />
                </div>
                <button type="button" class="btn-nav-date" @onclick="GoNextDay" title="Next Day">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>

            <!-- Action: Schedule Slot CTA -->
            <button type="button" class="btn-schedule-primary" @onclick="() => OpenAddScheduleModal(null)">
                <i class="bi bi-calendar-plus-fill me-1.5"></i>
                <span>Schedule OT Slot</span>
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="loading-state-box p-5 text-center bg-white rounded-3 border flex-1 d-flex flex-column justify-content-center align-items-center">
            <div class="spinner-border text-indigo-600" style="width: 2.25rem; height: 2.25rem;" role="status"></div>
            <div class="text-slate-700 font-bold mt-2 font-13">Loading live theater availability &amp; surgery schedule...</div>
        </div>
    }
    else
    {
        <div class="theaters-workspace-scroll">
            @if (currentViewMode == ViewMode.Timeline)
            {
                <!-- ========================================================================= -->
                <!-- 2A. FULL-WIDTH DAILY SCHEDULE TIMELINE GRID WITH SHIFT TOGGLE             -->
                <!-- ========================================================================= -->
                <div class="daily-schedule-main-layout">
                    <div class="timeline-container-card">
                        <!-- Timeline Card Header Bar (With Enhanced Day/Night Toggle in Right Corner) -->
                        <div class="timeline-card-header">
                            <div class="timeline-header-left">
                                <h3 class="timeline-main-title">
                                    Daily schedule @(selectedOtId.HasValue ? $"({GetTheaterName(selectedOtId.Value)})" : "(all theatres)")
                                </h3>
                            </div>

                            <!-- Enhanced Day / Night Shift Toggle in the Right Corner -->
                            <div class="timeline-header-right">
                                <div class="shift-toggle-segmented" title="Switch Shift Timing Window">
                                    <button type="button"
                                            class="btn-shift-toggle @(isDayShift ? "active-day" : "")"
                                            @onclick="() => SetShift(true)">
                                        <i class="bi bi-sun-fill shift-icon"></i>
                                        <span class="shift-label">Day Shift</span>
                                        <span class="shift-time-tag">07:00 – 19:00</span>
                                    </button>
                                    <button type="button"
                                            class="btn-shift-toggle @(!isDayShift ? "active-night" : "")"
                                            @onclick="() => SetShift(false)">
                                        <i class="bi bi-moon-stars-fill shift-icon"></i>
                                        <span class="shift-label">Night Shift</span>
                                        <span class="shift-time-tag">19:00 – 07:00</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Timeline Scrollable Grid Viewport -->
                        <div class="timeline-scroll-viewport">
                            <div class="timeline-grid-wrapper">
                                <!-- Timeline Axis Header Row (12 Synchronized Columns) -->
                                <div class="timeline-axis-header">
                                    <div class="axis-theater-column">Theatre</div>
                                    <div class="axis-time-slots-row">
                                        @foreach (var h in CurrentShiftHours)
                                        {
                                            <div class="axis-hour-cell">
                                                <span class="hour-24">@($"{h:D2}:00")</span>
                                                <span class="hour-12-sub">@FormatHour12(h)</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Timeline Rows for Each Theater -->
                                <div class="timeline-body-rows">
                                    <!-- Real-time Orange Marker Line (if within today & current shift window) -->
                                    @if (IsToday(scheduledDate) && CurrentTimeLeftPercent.HasValue)
                                    {
                                        <div class="current-time-marker-line" style="left: calc(160px + (100% - 160px) * @(CurrentTimeLeftPercent.Value / 100.0));">
                                            <div class="current-time-diamond-head"></div>
                                            <div class="current-time-badge">@CurrentIstTimeString</div>
                                        </div>
                                    }

                                    @if (!DisplayTheatersList.Any())
                                    {
                                        <div class="theater-empty-state-card">
                                            <div class="empty-state-icon-circle">
                                                <i class="bi bi-door-closed"></i>
                                            </div>
                                            <h4 class="empty-state-heading">No Operation Theaters Found</h4>
                                            <p class="empty-state-description">No active operation theater suites found matching the selected filters.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var ot in DisplayTheatersList)
                                        {
                                            var theaterSchedules = GetSchedulesForTheater(ot.ot_id);
                                            var visibleSchedules = theaterSchedules.Where(IsScheduleInActiveShift).ToList();
                                            var isSelected = selectedOtId == ot.ot_id;

                                            <div class="timeline-theater-row @(isSelected ? "selected-row" : "")">
                                                <!-- Theater Identity Column on Left -->
                                                <div class="row-theater-identity">
                                                    <div class="row-theater-name">@ot.ot_name</div>
                                                    <div class="row-ops-count">
                                                        @if (visibleSchedules.Any())
                                                        {
                                                            <span class="text-indigo-600 font-bold">@visibleSchedules.Count @(visibleSchedules.Count == 1 ? "procedure" : "procedures")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-emerald-600 font-semibold">Vacant</span>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Timeline Track Area (12 Synchronized Columns) -->
                                                <div class="row-timeline-track">
                                                    <!-- Background 12 Hour Grid Columns -->
                                                    <div class="track-grid-columns">
                                                        @for (int i = 0; i < 12; i++)
                                                        {
                                                            <div class="track-hour-col"></div>
                                                        }
                                                    </div>

                                                    <!-- Placed Surgery Procedure Event Blocks (Green Time Box) -->
                                                    @if (visibleSchedules.Any())
                                                    {
                                                        @for (int i = 0; i < visibleSchedules.Count; i++)
                                                        {
                                                            var sched = visibleSchedules[i];
                                                            var req = allRequests.FirstOrDefault(r => r.request_id == sched.request_id);
                                                            var procName = !string.IsNullOrWhiteSpace(req?.procedure_name) ? req.procedure_name : (!string.IsNullOrWhiteSpace(sched.notes) ? sched.notes : "Surgery Procedure");
                                                            var patName = !string.IsNullOrWhiteSpace(req?.patient_name) ? req.patient_name : null;
                                                            var docName = !string.IsNullOrWhiteSpace(req?.doctor_name) ? req.doctor_name : GetDoctorName(req?.dcode ?? 0);

                                                            var (leftPct, widthPct) = GetSchedulePosition(sched);
                                                            var colorClass = GetProcedureColorClass(i, req?.priority);
                                                            var isRightAligned = leftPct > 45 || (leftPct + widthPct) > 65;
                                                            var rightOffset = Math.Max(0.0, 100.0 - (leftPct + widthPct));

                                                            var startIst = sched.scheduled_time.ToString("hh\\:mm tt");
                                                            var endIst = sched.estimated_end_time.ToString("hh\\:mm tt");

                                                            <div class="procedure-event-block @colorClass compact-slot @(isRightAligned ? "align-pop-right" : "align-pop-left")"
                                                                 style="left: @leftPct.ToString("0.##")%; width: @widthPct.ToString("0.##")%; --right-offset: @rightOffset.ToString("0.##")%;"
                                                                 @onclick="() => OpenSlotDetailModal(sched, req, ot)"
                                                                 title="@procName @(!string.IsNullOrWhiteSpace(patName) ? $"- {patName}" : "") | Dr. @docName | @startIst to @endIst">

                                                                <!-- Default View: Shows Procedure Name & 'View details' in Green Box -->
                                                                <div class="compact-default-label">
                                                                    <span class="compact-proc-title">@procName</span>
                                                                    <span class="btn-view-details-pill"><i class="bi bi-eye me-1"></i>View details</span>
                                                                </div>

                                                                <!-- On Hover: Displays full details clearly in expanded floating card -->
                                                                <div class="compact-hover-popup">
                                                                    <!-- Row 1: Surgery name - Patient name -->
                                                                    <div class="event-title-wrap">
                                                                        <div class="event-proc-and-patient">
                                                                            <span class="event-proc-name">@procName</span>
                                                                            @if (!string.IsNullOrWhiteSpace(patName))
                                                                            {
                                                                                <span class="event-hyphen">-</span>
                                                                                <span class="event-patient-name">@patName</span>
                                                                            }
                                                                        </div>
                                                                        @if (req?.priority == "URGENT" || req?.priority == "EMERGENCY")
                                                                        {
                                                                            <span class="event-urgent-dot" title="Priority: @req.priority">!</span>
                                                                        }
                                                                    </div>

                                                                    <!-- Row 2: Doctor name -->
                                                                    <div class="event-doc-row">
                                                                        <i class="bi bi-person-fill-gear event-row-icon"></i>
                                                                        <span class="event-doc-name">Dr. @docName</span>
                                                                    </div>

                                                                    <!-- Row 3: Timings -->
                                                                    <div class="event-timing-row">
                                                                        <span class="event-time-text">@startIst - @endIst</span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <!-- Vacant Suite Watermark / Click to Book -->
                                                        <div class="track-vacant-indicator" @onclick="() => OpenAddScheduleModal(ot)">
                                                            <span class="vacant-text">
                                                                <i class="bi bi-calendar-plus me-1 text-emerald-500"></i>Available in this window
                                                            </span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (currentViewMode == ViewMode.Cards)
            {
                <!-- ========================================================================= -->
                <!-- 2B. BOOKED SLOTS CARD GRID VIEW                                           -->
                <!-- ========================================================================= -->
                <div class="booked-slots-card-view-layout">
                    <!-- Subheader Bar with Summary, Search & Filters -->
                    <div class="view-sub-header-bar">
                        <div class="sub-header-left">
                            <div class="sub-header-title-wrap">
                                <i class="bi bi-grid-fill text-indigo-600 fs-5"></i>
                                <h3 class="sub-header-title">
                                    Booked Slots for @scheduledDate.ToString("dd MMMM yyyy") @(selectedOtId.HasValue ? $"— {GetTheaterName(selectedOtId.Value)}" : "")
                                </h3>
                                <span class="badge-slot-count">@FilteredBookedSlots.Count() Booked</span>
                            </div>
                        </div>
                        <div class="sub-header-right">
                            <!-- Search Box -->
                            <div class="slot-search-input-box">
                                <i class="bi bi-search slot-search-icon"></i>
                                <input type="text"
                                       class="slot-search-input"
                                       placeholder="Search procedure, patient, surgeon..."
                                       value="@slotSearchQuery"
                                       @oninput="OnSlotSearchInput" />
                                @if (!string.IsNullOrWhiteSpace(slotSearchQuery))
                                {
                                    <button type="button" class="btn-clear-slot-search" @onclick='() => slotSearchQuery = ""'>
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>

                            <!-- Status Filter Pills -->
                            <div class="status-filter-pills">
                                <button type="button" class="btn-status-pill @(selectedStatusFilter == "ALL" ? "active" : "")" @onclick='() => selectedStatusFilter = "ALL"'>All</button>
                                <button type="button" class="btn-status-pill @(selectedStatusFilter == "BOOKED" ? "active" : "")" @onclick='() => selectedStatusFilter = "BOOKED"'>Booked</button>
                                <button type="button" class="btn-status-pill @(selectedStatusFilter == "IN_PROGRESS" ? "active" : "")" @onclick='() => selectedStatusFilter = "IN_PROGRESS"'>In Surgery</button>
                                <button type="button" class="btn-status-pill @(selectedStatusFilter == "COMPLETED" ? "active" : "")" @onclick='() => selectedStatusFilter = "COMPLETED"'>Completed</button>
                            </div>
                        </div>
                    </div>

                    @if (!FilteredBookedSlots.Any())
                    {
                        <div class="empty-slots-card-box">
                            <div class="empty-icon-wrap">
                                <i class="bi bi-calendar-x text-slate-300"></i>
                            </div>
                            <h4 class="empty-title">No Booked Slots Found</h4>
                            <p class="empty-sub">No surgery bookings found for @scheduledDate.ToString("dd MMM yyyy") matching your filter criteria.</p>
                            <button type="button" class="btn-schedule-primary mt-2" @onclick="() => OpenAddScheduleModal(null)">
                                <i class="bi bi-calendar-plus-fill me-1.5"></i> Schedule New Slot
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="booked-slots-card-grid">
                            @foreach (var sched in FilteredBookedSlots)
                            {
                                var req = allRequests.FirstOrDefault(r => r.request_id == sched.request_id);
                                var procName = !string.IsNullOrWhiteSpace(req?.procedure_name) ? req.procedure_name : (!string.IsNullOrWhiteSpace(sched.notes) ? sched.notes : "Surgery Procedure");
                                var patName = !string.IsNullOrWhiteSpace(req?.patient_name) ? req.patient_name : GetPatientName(sched.custid);
                                var docName = !string.IsNullOrWhiteSpace(req?.doctor_name) ? req.doctor_name : GetDoctorName(req?.dcode ?? 0);
                                var ot = allTheaters.FirstOrDefault(t => t.ot_id == sched.ot_id);
                                var effStatus = GetEffectiveSurgeryStatus(sched, req);
                                var isEmergency = req?.priority?.ToUpper() == "EMERGENCY";
                                var startIst = sched.scheduled_time.ToString("hh\\:mm tt");
                                var endIst = sched.estimated_end_time.ToString("hh\\:mm tt");
                                var durMins = (int)(sched.estimated_end_time - sched.scheduled_time).TotalMinutes;
                                if (durMins <= 0) durMins += 24 * 60;
                                var isPostponed = IsPostponed(sched, req);

                                <div class="slot-card-item @(isEmergency ? "card-emergency-border" : "")" @onclick="() => OpenSlotDetailModal(sched, req, ot)">
                                    <div class="slot-card-header">
                                        <div class="slot-theater-badge">
                                            <span class="theater-icon-pill">
                                                <i class="bi bi-door-closed-fill"></i>
                                            </span>
                                            <div class="theater-title-group">
                                                <span class="slot-theater-name">@(ot?.ot_name ?? "OT Suite")</span>
                                                @if (!string.IsNullOrWhiteSpace(ot?.location))
                                                {
                                                    <span class="slot-theater-loc">@ot.location</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="slot-badges-right">
                                            <span class="status-pill @GetStatusPillClass(effStatus)">
                                                <span class="status-dot"></span>
                                                <span>@GetStatusDisplayName(effStatus)</span>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="slot-card-body">
                                        <div class="slot-proc-header">
                                            <h4 class="slot-proc-name" title="@procName">@procName</h4>
                                        </div>

                                        <!-- Single-Line Scheduled Time & Duration (Guaranteed Single Line with Mild Colors) -->
                                        <div class="slot-time-banner-single">
                                            <div class="time-range-group">
                                                <i class="bi bi-clock-fill time-icon-accent"></i>
                                                <span class="time-digits">@startIst – @endIst</span>
                                            </div>
                                            <span class="time-dur-pill">@(durMins >= 60 ? $"{durMins / 60}h {(durMins % 60 > 0 ? $"{durMins % 60}m" : "")}" : $"{durMins}m")</span>
                                        </div>

                                        <div class="slot-meta-card-section">
                                            <!-- Patient Meta Item -->
                                            <div class="slot-meta-item">
                                                <div class="meta-icon-avatar patient-avatar">
                                                    <i class="bi bi-person-fill"></i>
                                                </div>
                                                <div class="meta-content">
                                                    <span class="meta-label-text">Patient</span>
                                                    <div class="meta-val-text">
                                                        <span class="font-bold text-slate-800">@patName</span>
                                                        <span class="patient-id-tag">#@sched.custid.ToString("0")</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Surgeon Meta Item -->
                                            <div class="slot-meta-item">
                                                <div class="meta-icon-avatar doctor-avatar">
                                                    <i class="bi bi-person-badge-fill"></i>
                                                </div>
                                                <div class="meta-content">
                                                    <span class="meta-label-text">Surgeon</span>
                                                    <span class="meta-val-text font-semibold text-slate-700">Dr. @docName</span>
                                                </div>
                                            </div>

                                            <!-- Tags Row: Category, Priority & Postponed -->
                                            <div class="slot-tags-row">
                                                @if (!string.IsNullOrWhiteSpace(req?.surgery_type))
                                                {
                                                    <span class="category-chip @GetSurgeryTypeClass(req.surgery_type)">
                                                        <i class="bi bi-tag-fill me-1 font-9"></i>@req.surgery_type
                                                    </span>
                                                }
                                                <span class="priority-pill @GetPriorityPillClass(req?.priority)">
                                                    @if (isEmergency)
                                                    {
                                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                    }
                                                    else if (req?.priority?.ToUpper() == "URGENT")
                                                    {
                                                        <i class="bi bi-lightning-fill me-1"></i>
                                                    }
                                                    @(req?.priority?.ToUpper() ?? "ELECTIVE")
                                                </span>
                                                @if (isPostponed)
                                                {
                                                    <span class="badge-postponed-pill" title="@sched.notes">
                                                        <i class="bi bi-clock-history me-1 font-9"></i>Postponed
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="slot-card-footer" @onclick:stopPropagation>
                                        <button type="button" class="btn-card-action btn-card-details" @onclick="() => OpenSlotDetailModal(sched, req, ot)">
                                            <i class="bi bi-eye-fill"></i>
                                            <span>View Details</span>
                                        </button>
                                        <button type="button" class="btn-card-action btn-card-manage" @onclick="() => OpenEditScheduleModal(sched)">
                                            <i class="bi bi-pencil-square"></i>
                                            <span>Edit Schedule</span>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (currentViewMode == ViewMode.Table)
            {
                <!-- ========================================================================= -->
                <!-- 2C. BOOKED SLOTS TABLE VIEW                                               -->
                <!-- ========================================================================= -->
                <div class="booked-slots-table-view-layout">
                    <!-- Subheader Bar with Summary, Search & Filters -->
                    <div class="view-sub-header-bar">
                        <div class="sub-header-left">
                            <div class="sub-header-title-wrap">
                                <i class="bi bi-table text-indigo-600 fs-5"></i>
                                <h3 class="sub-header-title">
                                    Booked Slots for @scheduledDate.ToString("dd MMMM yyyy") @(selectedOtId.HasValue ? $"— {GetTheaterName(selectedOtId.Value)}" : "")
                                </h3>
                                <span class="badge-slot-count">@FilteredBookedSlots.Count() Booked</span>
                            </div>
                        </div>
                        <div class="sub-header-right">
                            <!-- Search Box -->
                            <div class="slot-search-input-box">
                                <i class="bi bi-search slot-search-icon"></i>
                                <input type="text"
                                       class="slot-search-input"
                                       placeholder="Search procedure, patient, surgeon..."
                                       value="@slotSearchQuery"
                                       @oninput="OnSlotSearchInput" />
                                @if (!string.IsNullOrWhiteSpace(slotSearchQuery))
                                {
                                    <button type="button" class="btn-clear-slot-search" @onclick='() => slotSearchQuery = ""'>
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>

                            <!-- Status Filter Pills -->
                            <div class="status-filter-pills">
                                <button type="button" class="btn-status-pill @(selectedStatusFilter == "ALL" ? "active" : "")" @onclick='() => selectedStatusFilter = "ALL"'>All</button>
                                <button type="button" class="btn-status-pill @(selectedStatusFilter == "BOOKED" ? "active" : "")" @onclick='() => selectedStatusFilter = "BOOKED"'>Booked</button>
                                <button type="button" class="btn-status-pill @(selectedStatusFilter == "IN_PROGRESS" ? "active" : "")" @onclick='() => selectedStatusFilter = "IN_PROGRESS"'>In Surgery</button>
                                <button type="button" class="btn-status-pill @(selectedStatusFilter == "COMPLETED" ? "active" : "")" @onclick='() => selectedStatusFilter = "COMPLETED"'>Completed</button>
                            </div>
                        </div>
                    </div>

                    <div class="table-container-card">
                        <div class="table-responsive">
                            <table class="table ot-availability-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="col-th-time">SLOT TIME</th>
                                        <th class="col-th-theater">THEATER SUITE</th>
                                        <th class="col-th-proc">PROCEDURE</th>
                                        <th class="col-th-patient">PATIENT</th>
                                        <th class="col-th-surgeon">SURGEON</th>
                                        <th class="col-th-priority">PRIORITY</th>
                                        <th class="col-th-status">STATUS</th>
                                        <th class="col-th-actions text-end pe-3">ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!FilteredBookedSlots.Any())
                                    {
                                        <tr>
                                            <td colspan="8" class="p-0 border-0">
                                                <div class="empty-table-state-box">
                                                    <i class="bi bi-calendar-x fs-2 text-slate-300 mb-2"></i>
                                                    <span class="font-13 font-bold text-slate-700 d-block mb-1">No Booked Slots Found</span>
                                                    <span class="font-11 text-slate-400 d-block mb-3">No surgery bookings found matching your search or filters.</span>
                                                    <button type="button" class="btn-schedule-primary btn-sm" @onclick="() => OpenAddScheduleModal(null)">
                                                        <i class="bi bi-calendar-plus-fill me-1"></i> Schedule Slot
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var sched in FilteredBookedSlots)
                                        {
                                            var req = allRequests.FirstOrDefault(r => r.request_id == sched.request_id);
                                            var procName = !string.IsNullOrWhiteSpace(req?.procedure_name) ? req.procedure_name : (!string.IsNullOrWhiteSpace(sched.notes) ? sched.notes : "Surgery Procedure");
                                            var patName = !string.IsNullOrWhiteSpace(req?.patient_name) ? req.patient_name : GetPatientName(sched.custid);
                                            var docName = !string.IsNullOrWhiteSpace(req?.doctor_name) ? req.doctor_name : GetDoctorName(req?.dcode ?? 0);
                                            var ot = allTheaters.FirstOrDefault(t => t.ot_id == sched.ot_id);
                                            var effStatus = GetEffectiveSurgeryStatus(sched, req);
                                            var isEmergency = req?.priority?.ToUpper() == "EMERGENCY";
                                            var startIst = sched.scheduled_time.ToString("hh\\:mm tt");
                                            var endIst = sched.estimated_end_time.ToString("hh\\:mm tt");
                                            var durMins = (int)(sched.estimated_end_time - sched.scheduled_time).TotalMinutes;
                                            if (durMins <= 0) durMins += 24 * 60;
                                            var isPostponed = IsPostponed(sched, req);

                                            <tr class="avail-table-row @(isEmergency ? "row-emergency-accent" : "")"
                                                @ondblclick="() => OpenSlotDetailModal(sched, req, ot)"
                                                title="Double click to view full details"
                                                style="cursor: pointer;">
                                                <td class="col-th-time">
                                                    <!-- Clean Time Box in Table (No Harsh Green Outline) -->
                                                    <div class="table-time-green-pill">
                                                        <i class="bi bi-clock-fill"></i>
                                                        <span>@startIst – @endIst</span>
                                                        <span class="table-dur-tag">@(durMins >= 60 ? $"{durMins / 60}h {(durMins % 60 > 0 ? $"{durMins % 60}m" : "")}" : $"{durMins}m")</span>
                                                    </div>
                                                </td>
                                                <td class="col-th-theater">
                                                    <div class="tbl-theater-cell">
                                                        <span class="tbl-theater-name">@(ot?.ot_name ?? "OT Suite")</span>
                                                        @if (!string.IsNullOrWhiteSpace(ot?.location))
                                                        {
                                                            <span class="tbl-theater-loc">@ot.location</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="col-th-proc">
                                                    <div class="tbl-proc-cell">
                                                        <div class="tbl-proc-title-row">
                                                            <span class="tbl-proc-name" title="@procName">@procName</span>
                                                            @if (!string.IsNullOrWhiteSpace(req?.surgery_type))
                                                            {
                                                                <span class="category-chip @GetSurgeryTypeClass(req.surgery_type)">@req.surgery_type</span>
                                                            }
                                                            @if (isPostponed)
                                                            {
                                                                <span class="badge-postponed-pill" title="@sched.notes">
                                                                    <i class="bi bi-clock-history me-1"></i>Postponed
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="col-th-patient">
                                                    <div class="tbl-patient-cell">
                                                        <div class="patient-avatar-badge">@GetPatientInitial(patName)</div>
                                                        <div class="tbl-patient-info">
                                                            <span class="tbl-patient-name">@patName</span>
                                                            <span class="tbl-patient-id">ID: #@sched.custid.ToString("0")</span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="col-th-surgeon">
                                                    <div class="tbl-surgeon-cell">
                                                        <div class="doc-avatar-badge">
                                                            <i class="bi bi-person-fill"></i>
                                                        </div>
                                                        <div class="tbl-surgeon-info">
                                                            <span class="tbl-surgeon-name">Dr. @docName</span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="col-th-priority">
                                                    <span class="priority-pill @GetPriorityPillClass(req?.priority)">
                                                        @if (isEmergency)
                                                        {
                                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                        }
                                                        else if (req?.priority?.ToUpper() == "URGENT")
                                                        {
                                                            <i class="bi bi-lightning-fill me-1"></i>
                                                        }
                                                        @(req?.priority?.ToUpper() ?? "ELECTIVE")
                                                    </span>
                                                </td>
                                                <td class="col-th-status">
                                                    <span class="status-pill @GetStatusPillClass(effStatus)">
                                                        <span class="status-dot"></span>
                                                        <span>@GetStatusDisplayName(effStatus)</span>
                                                    </span>
                                                </td>
                                                <td class="col-th-actions text-end pe-3" @onclick:stopPropagation>
                                                    <div class="tbl-actions-wrap">
                                                        <button type="button" class="btn-tbl-action btn-tbl-view" @onclick="() => OpenSlotDetailModal(sched, req, ot)" title="View Slot Details">
                                                            <i class="bi bi-eye-fill"></i>
                                                        </button>
                                                        <button type="button" class="btn-tbl-action btn-tbl-edit" @onclick="() => OpenEditScheduleModal(sched)" title="Edit Schedule Slot">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ========================================================================= -->
<!-- 3. SCHEDULE OT SLOT MODAL                                                 -->
<!-- ========================================================================= -->
@if (showAddScheduleModal)
{
    <div class="modal-overlay">
        <div class="modal-form-card" style="max-width: 600px;" @onclick:stopPropagation>
            <div class="modal-header-bar">
                <div class="modal-header-left">
                    <div class="modal-header-icon-box">
                        <i class="bi bi-calendar-plus-fill"></i>
                    </div>
                    <div class="modal-header-text-block">
                        <h3 class="modal-title-text">Schedule OT Slot</h3>
                        <p class="modal-subtitle-text">Assign operation theater suite and timing window for surgery</p>
                    </div>
                </div>
                <button type="button" class="modal-close-btn" @onclick="CloseAddScheduleModal" title="Close">&times;</button>
            </div>

            <div class="modal-body assign-modal-body">
                <!-- Surgery Request Selection (Search-as-you-type Autocomplete) -->
                <div class="modal-form-group mb-3">
                    <label class="modal-field-label">Select Surgery Request <span class="text-danger">*</span></label>
                    <div class="modal-search-autocomplete-wrapper">
                        <div class="modal-search-input-box">
                            <i class="bi bi-search modal-search-icon"></i>
                            <input type="text"
                                   class="form-control modal-input-control with-search-icon @(bookRequestId != Guid.Empty ? "has-selection" : "")"
                                   placeholder="Search patient name, procedure, surgeon, or code..."
                                   value="@bookSearchText"
                                   @oninput="OnBookSearchInput"
                                   @onfocus="() => isBookDropdownOpen = true" />
                            @if (!string.IsNullOrWhiteSpace(bookSearchText) || bookRequestId != Guid.Empty)
                            {
                                <button type="button" class="btn-clear-search" @onclick="ClearBookSurgerySelection" title="Clear selection">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn-dropdown-arrow" @onclick="() => isBookDropdownOpen = !isBookDropdownOpen" title="Toggle list">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                            }
                        </div>

                        @if (isBookDropdownOpen)
                        {
                            <div class="modal-typeahead-dropdown shadow-lg">
                                @if (filteredBookSurgeryRequests.Any())
                                {
                                    @foreach (var req in filteredBookSurgeryRequests.Take(30))
                                    {
                                        var pat = GetPatientName(req.custid);
                                        var doc = GetDoctorName(req.dcode);
                                        var isSelected = req.request_id == bookRequestId;
                                        var isEmergency = req.priority?.ToUpper() == "EMERGENCY";

                                        <div class="typeahead-option-item @(isSelected ? "selected" : "")"
                                             @onmousedown="() => SelectBookSurgeryRequest(req)">
                                            <div class="typeahead-item-layout">
                                                <div class="typeahead-item-icon">
                                                    <i class="bi bi-activity"></i>
                                                </div>
                                                <div class="typeahead-item-main">
                                                    <div class="typeahead-proc-line">
                                                        <span class="typeahead-proc-title">@req.procedure_name</span>
                                                        @if (isEmergency)
                                                        {
                                                            <span class="typeahead-emergency-badge">EMERGENCY</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(req.surgery_type))
                                                        {
                                                            <span class="typeahead-chip">@req.surgery_type</span>
                                                        }
                                                    </div>
                                                    <div class="typeahead-meta-line">
                                                        <span class="typeahead-meta-item"><i class="bi bi-person-fill text-indigo-500 me-1"></i><strong>@pat</strong></span>
                                                        <span class="typeahead-dot">&bull;</span>
                                                        <span class="typeahead-meta-item"><i class="bi bi-person-badge text-slate-400 me-1"></i>Dr. @doc</span>
                                                    </div>
                                                </div>
                                                <div class="typeahead-item-right">
                                                    <span class="typeahead-duration-pill">
                                                        <i class="bi bi-clock-fill me-1"></i>@(req.expected_duration_minutes ?? 60)m
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="typeahead-empty-state">
                                        <i class="bi bi-inbox text-slate-300 fs-4 d-block mb-1.5"></i>
                                        <span class="d-block font-bold text-slate-600 mb-0.5">No unscheduled surgery requests</span>
                                        <span class="font-11 text-slate-400">All pending requests have already been scheduled into OT slots.</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Selected Case Preview Card -->
                @{
                    var activeReq = allRequests.FirstOrDefault(r => r.request_id == bookRequestId);
                }
                @if (activeReq != null)
                {
                    var patName = GetPatientName(activeReq.custid);
                    var docName = GetDoctorName(activeReq.dcode);
                    <div class="selected-case-preview-card mb-3">
                        <div class="case-preview-badge">
                            <i class="bi bi-person-fill-check"></i>
                        </div>
                        <div class="case-preview-details">
                            <div class="case-preview-title">@activeReq.procedure_name</div>
                            <div class="case-preview-sub">
                                <span><i class="bi bi-person me-1"></i><strong>@patName</strong></span>
                                <span class="preview-dot">•</span>
                                <span><i class="bi bi-person-badge me-1"></i>Dr. @docName</span>
                                <span class="preview-dot">•</span>
                                <span class="badge bg-indigo-50 text-indigo-700 font-10 border border-indigo-100">
                                    <i class="bi bi-clock me-0.5"></i>@(activeReq.expected_duration_minutes ?? 60) mins
                                </span>
                            </div>
                        </div>
                    </div>
                }

                <!-- Row 1: OT Theater Suite & Scheduled Date -->
                <div class="modal-form-row mb-4">
                    <div class="modal-form-col">
                        <label class="modal-field-label">Operation Theater (OT Suite) <span class="text-danger">*</span></label>
                        <select class="form-select modal-select-control" @bind="bookOtId">
                            <option value="@Guid.Empty">-- Select OT Suite --</option>
                            @foreach (var ot in allTheaters.Where(t => t.is_active))
                            {
                                <option value="@ot.ot_id">@ot.ot_name @(!string.IsNullOrWhiteSpace(ot.location) ? $"({ot.location})" : "")</option>
                            }
                        </select>
                    </div>

                    <div class="modal-form-col">
                        <label class="modal-field-label">Scheduled Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control modal-input-control" value="@bookDate.ToString("yyyy-MM-dd")" @onchange="OnBookDateChanged" />
                    </div>
                </div>

                <!-- Row 2: Timing Window -->
                <div class="modal-form-row mb-4">
                    <div class="modal-form-col">
                        <label class="modal-field-label">Start Time (HH:mm) <span class="text-danger">*</span></label>
                        <input type="time" class="form-control modal-input-control" value="@(bookStartTime.HasValue ? bookStartTime.Value.ToString("HH\\:mm") : "")" @onchange="OnBookStartTimeChanged" />
                    </div>

                    <div class="modal-form-col">
                        <label class="modal-field-label">Estimated End Time (HH:mm) <span class="text-danger">*</span></label>
                        <input type="time" class="form-control modal-input-control" value="@(bookEndTime.HasValue ? bookEndTime.Value.ToString("HH\\:mm") : "")" @onchange="OnBookEndTimeChanged" />
                    </div>
                </div>

                <!-- Row 3: Notes -->
                <div class="modal-form-group mb-2">
                    <label class="modal-field-label">Scheduling Notes / Special Equipment Prep</label>
                    <textarea class="form-control modal-textarea-control" rows="3" placeholder="e.g. First case of the day, requires laparoscopy tower..." @bind="bookNotes"></textarea>
                </div>
            </div>

            <div class="modal-footer-bar">
                <button type="button" class="btn-modal-cancel" @onclick="CloseAddScheduleModal">Cancel</button>
                <button type="button" class="btn-modal-save" @onclick="SaveAddScheduleAsync" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Booking...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle-fill me-1"></i>
                        <span>Confirm Slot Booking</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- 3B. EDIT SCHEDULE OT SLOT MODAL                                           -->
<!-- ========================================================================= -->
@if (showEditScheduleModal && editingSchedule != null)
{
    var editReq = allRequests.FirstOrDefault(r => r.request_id == editingSchedule.request_id);
    var editPatName = !string.IsNullOrWhiteSpace(editReq?.patient_name) ? editReq.patient_name : GetPatientName(editingSchedule.custid);
    var editDocName = !string.IsNullOrWhiteSpace(editReq?.doctor_name) ? editReq.doctor_name : GetDoctorName(editReq?.dcode ?? 0);
    var editProcName = !string.IsNullOrWhiteSpace(editReq?.procedure_name) ? editReq.procedure_name : (!string.IsNullOrWhiteSpace(editingSchedule.notes) ? editingSchedule.notes : "Surgery Procedure");

    <div class="modal-overlay" @onclick="CloseEditScheduleModal">
        <div class="modal-form-card" style="max-width: 600px;" @onclick:stopPropagation>
            <div class="modal-header-bar">
                <div class="modal-header-left">
                    <div class="modal-header-icon-box">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div class="modal-header-text-block">
                        <h3 class="modal-title-text">Edit Schedule Slot</h3>
                        <p class="modal-subtitle-text">Update theater suite, schedule date, timing window, status, or notes</p>
                    </div>
                </div>
                <button type="button" class="modal-close-btn" @onclick="CloseEditScheduleModal" title="Close">&times;</button>
            </div>

            <div class="modal-body assign-modal-body">
                <!-- Case Preview Card -->
                <div class="selected-case-preview-card mb-3">
                    <div class="case-preview-badge">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <div class="case-preview-details">
                        <div class="case-preview-title">@editProcName</div>
                        <div class="case-preview-sub">
                            <span><i class="bi bi-person me-1"></i><strong>@editPatName</strong></span>
                            <span class="preview-dot">•</span>
                            <span><i class="bi bi-person-badge me-1"></i>Dr. @editDocName</span>
                            @if (!string.IsNullOrWhiteSpace(editReq?.surgery_type))
                            {
                                <span class="preview-dot">•</span>
                                <span class="category-chip @GetSurgeryTypeClass(editReq.surgery_type)">@editReq.surgery_type</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(editReq?.priority))
                            {
                                <span class="preview-dot">•</span>
                                <span class="priority-pill @GetPriorityPillClass(editReq.priority)">@editReq.priority</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Row 1: OT Theater Suite & Scheduled Date -->
                <div class="modal-form-row mb-3">
                    <div class="modal-form-col">
                        <label class="modal-field-label">Operation Theater Suite <span class="text-danger">*</span></label>
                        <select class="form-select modal-select-control" @bind="editOtId">
                            @foreach (var ot in allTheaters.Where(t => t.is_active || t.ot_id == editOtId))
                            {
                                <option value="@ot.ot_id">@ot.ot_name @(!string.IsNullOrWhiteSpace(ot.location) ? $"({ot.location})" : "")</option>
                            }
                        </select>
                    </div>

                    <div class="modal-form-col">
                        <label class="modal-field-label">Scheduled Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control modal-input-control" value="@editDate.ToString("yyyy-MM-dd")" @onchange="OnEditDateChanged" />
                    </div>
                </div>

                <!-- Row 2: Timing Window -->
                <div class="modal-form-row mb-3">
                    <div class="modal-form-col">
                        <label class="modal-field-label">Start Time (HH:mm) <span class="text-danger">*</span></label>
                        <input type="time" class="form-control modal-input-control" value="@(editStartTime.HasValue ? editStartTime.Value.ToString("HH\\:mm") : "")" @onchange="OnEditStartTimeChanged" />
                    </div>

                    <div class="modal-form-col">
                        <label class="modal-field-label">Estimated End Time (HH:mm) <span class="text-danger">*</span></label>
                        <input type="time" class="form-control modal-input-control" value="@(editEndTime.HasValue ? editEndTime.Value.ToString("HH\\:mm") : "")" @onchange="OnEditEndTimeChanged" />
                    </div>
                </div>

                <!-- Row 3: Slot Status -->
                <div class="modal-form-group mb-3">
                    <label class="modal-field-label">Slot Status <span class="text-danger">*</span></label>
                    <select class="form-select modal-select-control" @bind="editStatus">
                        <option value="BOOKED">BOOKED (Scheduled)</option>
                        <option value="IN_PROGRESS">IN_PROGRESS (Patient in OT / In Surgery)</option>
                        <option value="COMPLETED">COMPLETED (Surgery Finished)</option>
                        <option value="POSTPONED">POSTPONED (Rescheduled / On Hold)</option>
                        <option value="CANCELLED">CANCELLED (Sync back to Requested)</option>
                    </select>
                </div>

                <!-- Row 4: Rescheduling Notes / Special Prep -->
                <div class="modal-form-group mb-2">
                    <label class="modal-field-label">Scheduling / Rescheduling Notes &amp; Special Equipment Prep</label>
                    <textarea class="form-control modal-textarea-control" rows="3" placeholder="e.g. Rescheduled due to prior emergency case, requires laparoscopy tower..." @bind="editNotes"></textarea>
                </div>
            </div>

            <div class="modal-footer-bar">
                <button type="button" class="btn-modal-cancel" @onclick="CloseEditScheduleModal">Cancel</button>
                <button type="button" class="btn-modal-save" @onclick="SaveEditScheduleAsync" disabled="@isEditSaving">
                    @if (isEditSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle-fill me-1"></i>
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- 4. SURGERY SLOT DETAILS INSPECT MODAL                                    -->
<!-- ========================================================================= -->
@if (showSlotDetailModal && inspectedSchedule != null)
{
    var req = inspectedRequest;
    var ot = inspectedTheater;
    var procName = !string.IsNullOrWhiteSpace(req?.procedure_name) ? req.procedure_name : (!string.IsNullOrWhiteSpace(inspectedSchedule.notes) ? inspectedSchedule.notes : "Surgery Procedure");
    var patName = !string.IsNullOrWhiteSpace(req?.patient_name) ? req.patient_name : GetPatientName(inspectedSchedule.custid);
    var docName = !string.IsNullOrWhiteSpace(req?.doctor_name) ? req.doctor_name : GetDoctorName(req?.dcode ?? 0);
    var startIst = inspectedSchedule.scheduled_time.ToString("hh\\:mm tt");
    var endIst = inspectedSchedule.estimated_end_time.ToString("hh\\:mm tt");

    <div class="modal-overlay" @onclick="CloseSlotDetailModal">
        <div class="modal-form-card team-modal-card" style="max-width: 560px;" @onclick:stopPropagation>
            <div class="modal-header-bar">
                <div class="modal-header-left">
                    <div class="modal-header-icon-box">
                        <i class="bi bi-clipboard-pulse"></i>
                    </div>
                    <div class="modal-header-text-block">
                        <h3 class="modal-title-text">Surgery Slot Details</h3>
                        <p class="modal-subtitle-text">@(ot?.ot_name ?? "OT Suite") &bull; @inspectedSchedule.scheduled_date.ToString("dd MMM yyyy")</p>
                    </div>
                </div>
                <button type="button" class="modal-close-btn" @onclick="CloseSlotDetailModal" title="Close">&times;</button>
            </div>

            <div class="modal-body assign-modal-body">
                <div class="selected-case-preview-card mb-3">
                    <div class="case-preview-badge">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <div class="case-preview-details">
                        <div class="case-preview-title">@procName</div>
                        <div class="case-preview-sub">
                            <span><i class="bi bi-person me-1"></i><strong>@patName</strong></span>
                            <span class="preview-dot">•</span>
                            <span><i class="bi bi-person-badge me-1"></i>Dr. @docName</span>
                        </div>
                    </div>
                </div>

                <div class="slot-details-grid">
                    <div class="slot-detail-item">
                        <span class="slot-detail-label">OT Suite</span>
                        <span class="slot-detail-val font-bold">@(ot?.ot_name ?? "Operation Theater") @(!string.IsNullOrWhiteSpace(ot?.location) ? $"({ot.location})" : "")</span>
                    </div>
                    <div class="slot-detail-item">
                        <span class="slot-detail-label">Timing (IST)</span>
                        <span class="slot-detail-val font-mono font-bold text-indigo-600">@startIst – @endIst</span>
                    </div>
                    <div class="slot-detail-item">
                        <span class="slot-detail-label">Status</span>
                        <span class="slot-detail-val">
                            @{
                                var effectiveStatus = GetEffectiveSurgeryStatus(inspectedSchedule, req);
                            }
                            <span class="badge @GetStatusBadgeClass(effectiveStatus) font-bold">@effectiveStatus.Replace("_", " ")</span>
                        </span>
                    </div>
                    <div class="slot-detail-item">
                        <span class="slot-detail-label">Priority</span>
                        <span class="slot-detail-val">
                            <span class="badge @(req?.priority == "EMERGENCY" ? "bg-danger text-white" : "bg-warning text-dark") font-bold">@(req?.priority ?? "ELECTIVE")</span>
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(inspectedSchedule.notes))
                    {
                        <div class="slot-detail-item full-width">
                            <span class="slot-detail-label">Scheduling Notes / Prep</span>
                            <span class="slot-detail-val">@inspectedSchedule.notes</span>
                        </div>
                    }
                </div>
            </div>

            <div class="modal-footer-bar">
                <button type="button" class="btn-modal-cancel" @onclick="CloseSlotDetailModal">Close</button>
                <button type="button" class="btn-assign-primary btn-sm" @onclick="() => { var s = inspectedSchedule; CloseSlotDetailModal(); OpenEditScheduleModal(s); }">
                    <i class="bi bi-pencil-square me-1"></i>
