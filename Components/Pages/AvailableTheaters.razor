    private bool IsToday(DateOnly date) => date == DateOnly.FromDateTime(DateTime.Today);

    private string GetEffectiveSurgeryStatus(OtScheduleModel? sched, OtSurgeryRequestListModel? req)
    {
        var reqStatus = req?.status?.Trim()?.ToUpperInvariant();
        var schedStatus = sched?.status?.Trim()?.ToUpperInvariant();

        // 1. In-progress status from OT console
        if (reqStatus is "IN_PROGRESS" or "IN_OP" or "IN_SURGERY" or "SURGERY" || schedStatus is "IN_PROGRESS" or "IN_OP" or "IN_SURGERY" or "SURGERY")
        {
            return "IN_PROGRESS";
        }

        // 2. Completed status
        if (reqStatus is "COMPLETED" or "FINISHED" || schedStatus is "COMPLETED" or "FINISHED")
        {
            return "COMPLETED";
        }

        // 3. In recovery status
        if (reqStatus is "IN_RECOVERY" or "RECOVERY" or "RECOVERED" || schedStatus is "IN_RECOVERY" or "RECOVERY" or "RECOVERED")
        {
            return "IN_RECOVERY";
        }

        // 4. Transferred / Discharged status
        if (reqStatus is "TRANSFERRED" or "DISCHARGED" || schedStatus is "TRANSFERRED" or "DISCHARGED")
        {
            return "TRANSFERRED";
        }

        // 5. Postponed status
        if (reqStatus == "POSTPONED" || schedStatus == "POSTPONED" || (!string.IsNullOrWhiteSpace(sched?.notes) && sched.notes.Contains("POSTPONED", StringComparison.OrdinalIgnoreCase)))
        {
            return "POSTPONED";
        }

        // 6. Cancelled status
        if (reqStatus == "CANCELLED" || schedStatus == "CANCELLED")
        {
            return "CANCELLED";
        }

        // 7. Default: Scheduled case -> Booked
        return "BOOKED";
    }

    private bool IsPostponed(OtScheduleModel? sched, OtSurgeryRequestListModel? req)
    {
        var status = GetEffectiveSurgeryStatus(sched, req);
        if (status.Equals("POSTPONED", StringComparison.OrdinalIgnoreCase)) return true;
        if (!string.IsNullOrWhiteSpace(sched?.notes) && sched.notes.Contains("POSTPONED", StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private string GetPatientInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "P";
        var clean = name.Trim();
        return clean.Substring(0, 1).ToUpperInvariant();
    }

    private string GetStatusDisplayName(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Booked";
        var s = status.ToUpperInvariant();
        return s switch
        {
            "IN_PROGRESS" or "IN_OP" or "SURGERY" or "IN_SURGERY" => "In Surgery",
            "COMPLETED" or "FINISHED" => "Completed",
            "IN_RECOVERY" or "RECOVERY" or "RECOVERED" => "In Recovery",
            "TRANSFERRED" or "DISCHARGED" => "Transferred",
            "POSTPONED" => "Postponed",
            "CANCELLED" => "Cancelled",
            _ => "Booked"
        };
    }

    private string GetStatusPillClass(string? status)
    {
        return (status?.ToUpperInvariant()) switch
        {
            "IN_PROGRESS" or "IN_OP" or "SURGERY" or "IN_SURGERY" => "status-in-progress",
            "COMPLETED" or "FINISHED" => "status-completed",
            "IN_RECOVERY" or "RECOVERY" or "RECOVERED" => "status-recovery",
            "TRANSFERRED" or "DISCHARGED" => "status-transferred",
            "CANCELLED" => "status-cancelled",
            "POSTPONED" => "status-postponed",
            _ => "status-scheduled"
        };
    }

    private string GetPriorityPillClass(string? priority)
    {
        return (priority?.ToUpperInvariant()) switch
        {
            "EMERGENCY" => "priority-emergency",
            "URGENT" => "priority-urgent",
            _ => "priority-elective"
        };
    }

    private string GetSurgeryTypeClass(string? type)
    {
        return (type?.ToUpperInvariant()) switch
        {
            "MAJOR" => "chip-major",
            "MINOR" => "chip-minor",
            "DAYCARE" or "DAY_CARE" => "chip-daycare",
            _ => "chip-default"
        };
    }

    private string GetStatusBadgeClass(string? status)
    {
        return (status?.ToUpperInvariant()) switch
        {
            "IN_PROGRESS" or "IN_OP" or "SURGERY" or "IN_SURGERY" => "bg-purple-100 text-purple-800 border border-purple-200",
            "COMPLETED" or "FINISHED" => "bg-emerald-100 text-emerald-800 border border-emerald-200",
            "IN_RECOVERY" or "RECOVERY" or "RECOVERED" => "bg-sky-100 text-sky-800 border border-sky-200",
            "TRANSFERRED" or "DISCHARGED" => "bg-teal-100 text-teal-800 border border-teal-200",
            "CANCELLED" or "POSTPONED" => "bg-rose-100 text-rose-800 border border-rose-200",
            "REQUESTED" => "bg-amber-100 text-amber-800 border border-amber-200",
            _ => "bg-indigo-100 text-indigo-800 border border-indigo-200"
        };
    }
}
