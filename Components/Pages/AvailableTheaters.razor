    private bool IsScheduleInActiveShift(OtScheduleModel s)
    {
        var start = s.scheduled_time;
        var end = s.estimated_end_time;
        if (end <= start)
        {
            end = start.AddHours(1);
        }

        if (isDayShift)
        {
            // Day window: 07:00 to 19:00
            var shiftStart = new TimeOnly(7, 0);
            var shiftEnd = new TimeOnly(19, 0);
            return start < shiftEnd && end > shiftStart;
        }
        else
        {
            // Night window: 19:00 to 07:00
            var nightStart = new TimeOnly(19, 0);
            var nightEnd = new TimeOnly(7, 0);

            bool startsInNight = (start >= nightStart || start < nightEnd);
            bool endsInNight = (end > nightStart || end <= nightEnd);
            return startsInNight || endsInNight;
        }
    }

    private double GetHoursFromShiftStart(TimeOnly time, bool forEnd = false)
    {
        double h = time.Hour + (time.Minute / 60.0);
        if (isDayShift)
        {
            return h - 7.0;
        }
        else
        {
            if (h >= 19.0)
            {
                return h - 19.0;
            }
            else if (h <= 7.0)
            {
                return (24.0 - 19.0) + h;
            }
            else
            {
                return forEnd ? 12.0 : -1.0;
            }
        }
    }

    private (double leftPct, double widthPct) GetSchedulePosition(OtScheduleModel s)
    {
        var start = s.scheduled_time;
        var end = s.estimated_end_time;
        if (end <= start)
        {
            end = start.AddHours(1);
        }

        double startOffset = GetHoursFromShiftStart(start, false);
        double endOffset = GetHoursFromShiftStart(end, true);

        if (startOffset < 0) startOffset = 0;
        if (endOffset > 12.0) endOffset = 12.0;

        if (endOffset <= startOffset)
        {
            endOffset = Math.Min(12.0, startOffset + 1.0);
        }

        double leftPct = (startOffset / 12.0) * 100.0;
        double widthPct = ((endOffset - startOffset) / 12.0) * 100.0;

        leftPct = Math.Clamp(leftPct, 0.0, 96.0);
        widthPct = Math.Clamp(widthPct, 4.0, 100.0 - leftPct);

        return (leftPct, widthPct);
    }

    private double? CurrentTimeLeftPercent
