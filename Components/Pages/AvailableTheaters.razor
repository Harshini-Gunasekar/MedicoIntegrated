    private IEnumerable<OtScheduleModel> FilteredBookedSlots
    {
        get
        {
            var list = allSchedules
                .Where(s => s.scheduled_date == scheduledDate && !s.isdeleted && s.status != "CANCELLED")
                .Where(s => {
                    var req = allRequests.FirstOrDefault(r => r.request_id == s.request_id);
                    return req?.status != "CANCELLED";
                });

            if (selectedOtId.HasValue && selectedOtId.Value != Guid.Empty)
