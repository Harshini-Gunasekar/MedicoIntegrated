                    var theaterName = GetTheaterName(s.ot_id).ToLowerInvariant();
                    var notes = (s.notes ?? "").ToLowerInvariant();

                    return patName.Contains(q) ||
                           docName.Contains(q) ||
                           procName.Contains(q) ||
                           theaterName.Contains(q) ||
                           notes.Contains(q) ||
                           s.custid.ToString().Contains(q);
                });
            }

            return list.OrderBy(s => s.scheduled_time);
