    private async Task LoadRclProducts()
    {
        try
        {
            var client = ClientFactory.CreateClient("Medico");
            var targetTenantCode = string.IsNullOrEmpty(TenantCode) ? TenantState.TenantCode : TenantCode;
            if (client.DefaultRequestHeaders.Contains("tenant_code")) client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Add("tenant_code", targetTenantCode);
            var response = await client.GetAsync($"Tenant/GetTenantProducts?tenantCode={targetTenantCode}");
            if (response.IsSuccessStatusCode)
            {
                var jsonStr = await response.Content.ReadAsStringAsync();
                var rawProducts = Newtonsoft.Json.JsonConvert.DeserializeObject<List<ProductList>>(jsonStr) ?? new();
                var medicoProd = rawProducts.FirstOrDefault(p =>
                    (p.ProductName != null && p.ProductName.Contains("MEDICO", StringComparison.OrdinalIgnoreCase)) ||
                    (p.ProductId != null && p.ProductId.Contains("MEDICO", StringComparison.OrdinalIgnoreCase)));

                if (medicoProd != null)
                {
                    rclProducts = new List<ProductList> { medicoProd };
                    selectedProductId = medicoProd.ProductId;
                }
                else if (rawProducts.Any())
                {
                    var filtered = rawProducts.Where(p =>
                        (p.ProductName != null && p.ProductName.Contains("MEDICO", StringComparison.OrdinalIgnoreCase)) ||
                        (p.ProductId != null && p.ProductId.Contains("MEDICO", StringComparison.OrdinalIgnoreCase))).ToList();

                    if (filtered.Any())
                    {
                        rclProducts = filtered;
                    }
                    else
                    {
                        rclProducts = new List<ProductList>
                        {
                            new ProductList { ProductId = "MEDICO_APP", ProductName = "MEDICO" }
                        };
                    }
                    selectedProductId = rclProducts.First().ProductId;
                }
                else
                {
                    rclProducts = new List<ProductList>
                    {
                        new ProductList { ProductId = "MEDICO_APP", ProductName = "MEDICO" }
                    };
                    selectedProductId = "MEDICO_APP";
                }
                await LoadRclRoleTemplates();
            }
            else
            {
                rclProducts = new List<ProductList>
                {
                    new ProductList { ProductId = "MEDICO_APP", ProductName = "MEDICO" }
                };
                selectedProductId = "MEDICO_APP";
                await LoadRclRoleTemplates();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RCL Sync] Error loading products: {ex.Message}");
            rclProducts = new List<ProductList>
            {
                new ProductList { ProductId = "MEDICO_APP", ProductName = "MEDICO" }
            };
            selectedProductId = "MEDICO_APP";
        }
    }

