    private async Task LoadUserModuleRights(int usercode)
    {
        try
        {
            var rightsList = await UserRightsService.GetModuleRightsAsync(usercode);
            
            // Only attempt to guess the module from rights if we don't already have one selected
            if (selectedModuleId <= 0)
            {
                var activeRight = rightsList.FirstOrDefault(r => r.toadd || r.toview || r.toedit || r.todelete);
                if (activeRight != null)
                {
                    selectedModuleId = activeRight.usermoduleid;
                }
                else
                {
                    selectedModuleId = current.role switch
                    {
                        "0" => allModules.FirstOrDefault(m => (m.modulename ?? "").Contains("result", StringComparison.OrdinalIgnoreCase))?.usermoduleid ?? 0,
                        "1" => allModules.FirstOrDefault(m => (m.modulename ?? "").Contains("auth1", StringComparison.OrdinalIgnoreCase))?.usermoduleid ?? 0,
                        "2" => allModules.FirstOrDefault(m => (m.modulename ?? "").Contains("auth2", StringComparison.OrdinalIgnoreCase))?.usermoduleid ?? 0,
                        _ => 0
                    };
                    
                    if (selectedModuleId == 0 && !string.IsNullOrEmpty(current.module))
                    {
                        selectedModuleId = allModules.FirstOrDefault(m => (m.modulename ?? "").Equals(current.module, StringComparison.OrdinalIgnoreCase))?.usermoduleid ?? 0;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading user module rights: {ex.Message}") */;
            selectedModuleId = 0;
        }
    }

    private async Task SaveUserModuleRights(int usercode)
    {
        if (selectedModuleId <= 0) return;
        
        try
        {
            var rawRights = await UserRightsService.GetModuleRightsAsync(usercode);
            var existing = rawRights.FirstOrDefault(r => r.usermoduleid == selectedModuleId);
            
            var targetTenantCode = string.IsNullOrEmpty(TenantCode) ? TenantState.TenantCode : TenantCode;
            
            var rights = new List<UserFormRightsModel.usermodulerights>
            {
                new UserFormRightsModel.usermodulerights
                {
                    usermodulesrightsid = existing?.usermodulesrightsid ?? 0,
                    usercode = usercode,
                    usermoduleid = selectedModuleId,
                    toadd = true,
                    toview = true,
                    toedit = false,
                    todelete = false,
                    tenant_code = targetTenantCode
                }
            };
            
            var request = new UserFormRightsModel.ModuleRightsUpsertRequest
            {
                usercode = usercode,
                rights = rights
            };
            
            var success = await UserRightsService.SaveModuleRightsAsync(request);
            if (!success)
            {
                Toast.Error("Failed to save user module permissions. Please configure them in User Rights Management.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error persisting module rights: {ex.Message}");
        }
    }
