    private async Task LoadImagesForUsersAsync(List<user_master> userList)
    {
        foreach (var u in userList)
        {
            if (!string.IsNullOrEmpty(u.user_image) && !IsBase64String(u.user_image) && !userImagesBase64.ContainsKey(u.user_code))
            {
                await FetchAndCacheUserImageAsync(u.user_code, u.user_image);
            }
            if (!string.IsNullOrEmpty(u.signature_image) && !IsBase64String(u.signature_image) && !signatureImagesBase64.ContainsKey(u.user_code))
            {
                await FetchAndCacheSignatureImageAsync(u.user_code, u.signature_image);
            }
        }
    }

    private async Task FetchAndCacheUserImageAsync(int usercode, string fileName)
    {
        if (string.IsNullOrEmpty(fileName)) return;
        try
        {
            using var client = CreateClient();
            string key = fileName;
            if (!fileName.Contains("/"))
            {
                key = $"LabCare/{TenantCode}/users/{usercode}/user_{fileName}";
            }
            else if (!fileName.StartsWith("LabCare/", StringComparison.OrdinalIgnoreCase))
            {
                key = $"LabCare/{fileName}";
            }
            
            string url = $"{BaseUrl}api/files/download?key={key}";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var jsonStr = await response.Content.ReadAsStringAsync();
                var downloadRes = JsonConvert.DeserializeObject<FileDownloadResponse>(jsonStr);
                if (downloadRes != null && !string.IsNullOrEmpty(downloadRes.base64))
                {
                    userImagesBase64[usercode] = downloadRes.base64;
                    StateHasChanged();
                    return;
                }
            }
            
            if (!fileName.Contains("/"))
            {
                string urlWithoutPrefix = $"{BaseUrl}api/files/download?key=LabCare/{TenantCode}/users/{usercode}/{fileName}";
                var response2 = await client.GetAsync(urlWithoutPrefix);
                if (response2.IsSuccessStatusCode)
                {
                    var jsonStr = await response2.Content.ReadAsStringAsync();
                    var downloadRes2 = JsonConvert.DeserializeObject<FileDownloadResponse>(jsonStr);
                    if (downloadRes2 != null && !string.IsNullOrEmpty(downloadRes2.base64))
                    {
                        userImagesBase64[usercode] = downloadRes2.base64;
                        StateHasChanged();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Failed to load user image for user {usercode}: {ex.Message}") */;
        }
    }

