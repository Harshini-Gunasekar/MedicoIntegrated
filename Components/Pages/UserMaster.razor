    private async Task LoadUserProductPermission(int usercode)
    {
        userSelectedRoleIds.Clear();
        selectedTemplateGuid = null;
        selectedRoleTemplateName = current.role ?? "";

        // First check if role_ids came with the user from GetAllUsers
        var getUserResult = AllUsersRaw.FirstOrDefault(x => x.user?.user_code == usercode);
        if (getUserResult != null && getUserResult.role_ids != null && getUserResult.role_ids.Any())
        {
            userSelectedRoleIds = new HashSet<long>(getUserResult.role_ids);
        }
        else
        {
            try
            {
                var effectiveTenant = !string.IsNullOrEmpty(TenantCode) ? TenantCode : TenantState.TenantCode;
                var roles = await RoleService.GetUserRolesAsync(usercode, effectiveTenant);
                if (roles != null && roles.Any())
                {
                    userSelectedRoleIds = new HashSet<long>(roles);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[UserMaster] Error loading user roles: {ex.Message}");
            }
        }

        // Match with roleTemplates if available
        if (roleTemplates.Any())
        {
            if (userSelectedRoleIds.Any())
            {
                var matchingTemplate = roleTemplates.FirstOrDefault(t =>
                    t.AssignedRoleIds.Count == userSelectedRoleIds.Count &&
                    t.AssignedRoleIds.All(id => userSelectedRoleIds.Contains(id)));
                if (matchingTemplate != null)
                {
                    selectedTemplateGuid = matchingTemplate.RoleNameGUID;
                    if (string.IsNullOrEmpty(selectedRoleTemplateName))
                    {
                        selectedRoleTemplateName = matchingTemplate.Role_Name;
                    }
                }
            }
            else if (!string.IsNullOrEmpty(selectedRoleTemplateName))
            {
                var matchingTemplate = roleTemplates.FirstOrDefault(t =>
                    string.Equals(t.Role_Name, selectedRoleTemplateName, StringComparison.OrdinalIgnoreCase));
                if (matchingTemplate != null)
                {
                    selectedTemplateGuid = matchingTemplate.RoleNameGUID;
                    userSelectedRoleIds = new HashSet<long>(matchingTemplate.AssignedRoleIds);
                }
            }
        }

        SyncHierarchySelections();

        // Auto-expand modules that have active selections
        foreach (var mod in hierarchyTree)
        {
            if (mod.SubModules.SelectMany(s => s.Actions).Any(a => a.IsSelected))
            {
                mod.IsExpanded = true;
            }
        }
    }
