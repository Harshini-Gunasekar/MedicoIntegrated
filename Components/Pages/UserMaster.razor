@code {
    // ── Data ──────────────────────────────────────────────────────────────────
    private List<user_master> users = new();
    private user_master current = new();
    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;

    // Branches
    private List<Booking.Models.BranchModel> allBranches = new();
    private List<int> selectedBranchCodes = new();

    private void ToggleBranch(int bhCode, object? isChecked)
    {
        bool check = false;
        if (isChecked is bool b) check = b;
        else if (isChecked is string s && bool.TryParse(s, out var sb)) check = sb;

        if (check)
        {
            if (!selectedBranchCodes.Contains(bhCode)) selectedBranchCodes.Add(bhCode);
        }
        else
        {
            selectedBranchCodes.Remove(bhCode);
        }
        StateHasChanged();
    }

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";
    // UI Properties for nullable booleans
    private bool EditBillValue
    {
        get => current.edit_bill ?? false;
        set => current.edit_bill = value;
    }
    
    private bool PrintBillValue
    {
        get => current.print_bill ?? false;
        set => current.print_bill = value;
    }

    private string photoError = "";

    // ── UI State ──────────────────────────────────────────────────────────────
    private bool showForm = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private bool isSaving = false;
    private bool ShowPwd = false;

    private string SearchQuery = "";

    private string newPassword = "";

    private string? errorMessage;
    private string? formError;

    // Image handling fields
    private byte[]? selectedUserPhotoBytes;
    private string? selectedUserPhotoName;
    private byte[]? selectedSignaturePhotoBytes;
    private string? selectedSignaturePhotoName;
    private string previewUserImageBase64 = "";
    private string previewSignatureImageBase64 = "";
    private Dictionary<int, string> userImagesBase64 = new();
    private Dictionary<int, string> signatureImagesBase64 = new();
    
    // Store full raw users with branches and departments
    private List<GetUser> AllUsersRaw = new();

    // Authorized groups fields
    private List<GroupModel> allGroups = new();
    private List<GroupModel> authorizedGroups = new();
    private long selectedGroupCodeToAuthorize = 0;

    // Module rights fields
    private List<UserFormRightsModel.usermodules> allModules = new();
    private int selectedModuleId = 0;

    private int SelectedModuleId
    {
        get => selectedModuleId;
        set
        {
            selectedModuleId = value;
            var selectedModule = allModules.FirstOrDefault(m => m.usermoduleid == selectedModuleId);
            if (selectedModule != null)
            {
                current.module = selectedModule.modulename;
                current.role = (selectedModule.modulename ?? "").Trim().ToLower() switch
                {
                    "result entry" or "result_entry" => "0",
                    "auth1" => "1",
                    "auth2" => "2",
                    _ => "0"
                };
            }
        }
    }

    // ── Filtering ─────────────────────────────────────────────────────────────
    private IEnumerable<user_master> FilteredUsers =>
        users.Where(u =>
            u.deleted != true &&
            (string.IsNullOrWhiteSpace(SearchQuery) ||
             (u.name?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (u.short_name?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (u.email?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (u.mobile?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)));

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        using var client = ClientFactory.CreateClient("LabCareUrl");
        var baseUrlStr = client.BaseAddress?.ToString() ?? "";
        if (!string.IsNullOrEmpty(baseUrlStr) && !baseUrlStr.EndsWith("/"))
        {
            baseUrlStr += "/";
        }
        _appSettings = new AppSettings { BaseUrl = baseUrlStr };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    TenantState.SetSession(TenantCode, AuthToken, TenantName);
                    await LoadBranches();
                    await LoadModules();
                    await LoadUsers();
                    await LoadGroups();
                    StateHasChanged();
                }
                else
                {
                    errorMessage = "Access denied: Missing valid session. Please log in again.";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Session error: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    // ── HTTP Client ───────────────────────────────────────────────────────────
    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareUrl");
        if (!string.IsNullOrEmpty(TenantCode))
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        if (!string.IsNullOrEmpty(AuthToken))
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        return client;
    }

    // ── Load Branches ─────────────────────────────────────────────────────────
    private async Task LoadBranches()
    {
        try
        {
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                allBranches = await response.Content.ReadFromJsonAsync<List<Booking.Models.BranchModel>>() ?? new();
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading branches: {ex.Message}") */;
        }
    }

    // ── Load Users ────────────────────────────────────────────────────────────
    private static readonly JsonSerializerSettings _userJsonSettings = new()
    {
        MissingMemberHandling = MissingMemberHandling.Ignore,
        NullValueHandling     = NullValueHandling.Ignore
    };

    private async Task LoadUsers()
    {
        if (string.IsNullOrEmpty(TenantCode))
        {
            errorMessage = "Unauthorized access. Missing tenant context.";
            return;
        }
        isLoading = true;
        StateHasChanged();
        try
        {
            errorMessage = null;
            AllUsersRaw = await UserService.GetAllAsync();
            users = AllUsersRaw.Select(w => w.user).Where(u => u != null).ToList();
            _ = LoadImagesForUsersAsync(users);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading users: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ── CRUD: New / Edit / Save ───────────────────────────────────────────────
    private void NewUser()
    {
        current = new user_master { role = "2", module = "auth2" };
        newPassword = "";
        ShowPwd = false;
        formError = null;
        isEditMode = false;
        showForm = true;
        selectedUserPhotoBytes = null;
        selectedUserPhotoName = null;
        selectedSignaturePhotoBytes = null;
        selectedSignaturePhotoName = null;
        previewUserImageBase64 = "";
        previewSignatureImageBase64 = "";
        authorizedGroups.Clear();
        selectedGroupCodeToAuthorize = 0;
        selectedModuleId = allModules.FirstOrDefault(m => (m.modulename ?? "").Contains("auth2", StringComparison.OrdinalIgnoreCase))?.usermoduleid ?? 0;
    }

    private async Task EditUser(user_master u)
    {
        formError = null;
        isLoading = true;
        StateHasChanged();
        
        selectedUserPhotoBytes = null;
        selectedUserPhotoName = null;
        selectedSignaturePhotoBytes = null;
        selectedSignaturePhotoName = null;
        previewUserImageBase64 = "";
        previewSignatureImageBase64 = "";
        authorizedGroups.Clear();
        selectedGroupCodeToAuthorize = 0;
        
        try
        {
            var getUserResult = AllUsersRaw.FirstOrDefault(x => x.user?.user_code == u.user_code);
            if (getUserResult != null && getUserResult.user != null)
            {
                // Clone the user so edits don't mutate the grid immediately
                var serialized = Newtonsoft.Json.JsonConvert.SerializeObject(getUserResult.user);
                current = Newtonsoft.Json.JsonConvert.DeserializeObject<user_master>(serialized) ?? new();
                
                if (string.IsNullOrWhiteSpace(current.address))
                {
                    current.address = !string.IsNullOrWhiteSpace(current.permanent_address) ? current.permanent_address : current.current_address;
                }
                
                if (getUserResult.branch != null)
                {
                    selectedBranchCodes = getUserResult.branch
                        .Select(b => b.bhcode ?? 0)
                        .Where(c => c > 0)
                        .ToList();
                }
                
                if (getUserResult.department != null && allGroups.Any())
                {
                    authorizedGroups = getUserResult.department
                        .Where(d => d.dcode.HasValue) // Deserialized from 'gcode' JSON property
                        .Select(d => allGroups.FirstOrDefault(g => g.gcode == d.dcode))
                        .Where(g => g != null)
                        .ToList()!;
                }
                
                if (!string.IsNullOrEmpty(current.module))
                {
                    // Sync the dropdown ID
                    var matchingModule = allModules.FirstOrDefault(m => string.Equals(m.modulename, current.module.Trim(), StringComparison.OrdinalIgnoreCase));
                    if (matchingModule != null)
                    {
                        selectedModuleId = matchingModule.usermoduleid;
                    }
                    else
                    {
                        selectedModuleId = 0;
                    }
                    
                    if (string.IsNullOrEmpty(current.role))
                    {
                        current.role = current.module.Trim().ToLower() switch
                        {
                            "result entry" or "result_entry" => "0",
                            "auth1" => "1",
                            "auth2" => "2",
                            _ => "0"
                        };
                    }
                }
                else
                {
                    selectedModuleId = 0;
                }
                if (!string.IsNullOrEmpty(current.user_image) && !IsBase64String(current.user_image))
                {
                    _ = FetchAndCacheUserImageAsync(current.user_code, current.user_image);
                }
                if (!string.IsNullOrEmpty(current.signature_image) && !IsBase64String(current.signature_image))
                {
                    _ = FetchAndCacheSignatureImageAsync(current.user_code, current.signature_image);
                }
            }
            else
            {
                CloneLocalUser(u);
                selectedBranchCodes = new();
            }
        }
        catch
        {
            CloneLocalUser(u);
            selectedBranchCodes = new();
        }
        finally
        {
            isLoading = false;
        }

        newPassword = "";
        ShowPwd = false;
        isEditMode = true;
        showForm = true;
        
        // Remove await LoadAuthorizedGroups() since we parse it directly from GetUser
        await LoadUserModuleRights(u.user_code);
        StateHasChanged();
    }

    private void CloneLocalUser(user_master u)
    {
        current = new user_master
        {
            user_code      = u.user_code,
            name          = u.name,
            short_name     = u.short_name,
            description   = u.description,
            mobile        = u.mobile,
            email         = u.email,
            address       = !string.IsNullOrWhiteSpace(u.address) ? u.address : (!string.IsNullOrWhiteSpace(u.permanent_address) ? u.permanent_address : u.current_address),
            permanent_address = u.permanent_address,
            current_address = u.current_address,
            password      = u.password,
            role          = u.role,
            module        = u.module,
            power_user     = u.power_user,
            is_verified   = u.is_verified,
            tenant_code   = u.tenant_code,
            user_image     = u.user_image,
            signature_image= u.signature_image,
        };

        if (string.IsNullOrEmpty(current.role) && !string.IsNullOrEmpty(current.module))
        {
            current.role = current.module.Trim().ToLower() switch
            {
                "result entry" or "result_entry" => "0",
                "auth1" => "1",
                "auth2" => "2",
                _ => "0"
            };
        }
    }

    private async Task SaveUser()
    {
        formError = null;

        // ── Client-side validation ──
        if (string.IsNullOrWhiteSpace(current.name))
        {
            formError = "Full Name is required.";
            return;
        }
        if (string.IsNullOrEmpty(current.role))
        {
            current.role = "0"; // Default to result entry behind the scenes
        }
        if (string.IsNullOrWhiteSpace(current.mobile))
        {
            formError = "Mobile number is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(current.email))
        {
            formError = "Email address is required.";
            return;
        }
        if (!current.email.Contains('@') || !current.email.Contains('.'))
        {
            formError = "Please enter a valid email address.";
            return;
        }
        if (string.IsNullOrWhiteSpace(current.short_name))
        {
            formError = "Short Name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(current.description))
        {
            formError = "Description is required.";
            return;
        }
        if (!isEditMode && string.IsNullOrWhiteSpace(newPassword))
        {
            formError = "Password is required for new users.";
            return;
        }

        isSaving = true;
        StateHasChanged();
        try
        {
            var branchList = new List<UserBranchMaster>();
            if (selectedBranchCodes != null && selectedBranchCodes.Any())
            {
                foreach (var bhCode in selectedBranchCodes)
                {
                    branchList.Add(new UserBranchMaster
                    {
                        bhcode = bhCode,
                        user_code = isEditMode ? current.user_code : (int?)null,
                        tenant_code = TenantCode,
                        deleted = false
                    });
                }
            }

            if (!string.IsNullOrEmpty(newPassword))
            {
                current.password = newPassword;
            }
            else if (isEditMode)
            {
                if (string.IsNullOrWhiteSpace(current.password))
                {
                    current.password = "********";
                }
            }

            var departmentList = new List<UserDepartmentMaster>();
            if (authorizedGroups != null && authorizedGroups.Any())
            {
                foreach (var ag in authorizedGroups)
                {
                    departmentList.Add(new UserDepartmentMaster
                    {
                        dcode = (int)ag.gcode,
                        user_code = isEditMode ? current.user_code : (int?)null,
                        tenant_code = TenantCode,
                        deleted = false
                    });
                }
            }

            current.permanent_address = current.address;
            current.current_address = current.address;

            HttpResponseMessage response;
            Console.WriteLine($"[SaveUser] UI State -> edit_bill: {current.edit_bill}, print_bill: {current.print_bill}");
            Console.WriteLine($"[SaveUser] UI State -> selectedBranchCodes: {string.Join(",", selectedBranchCodes)}");

            if (isEditMode)
            {
                response = await UserService.UpdateAsync(
                    current,
                    branchList,
                    departmentList,
                    selectedUserPhotoBytes,
                    selectedUserPhotoName,
                    selectedSignaturePhotoBytes,
                    selectedSignaturePhotoName);
            }
            else
            {
                response = await UserService.RegisterAsync(
                    current,
                    branchList,
                    departmentList,
                    selectedUserPhotoBytes,
                    selectedUserPhotoName,
                    selectedSignaturePhotoBytes,
                    selectedSignaturePhotoName);
            }

            if (response.IsSuccessStatusCode)
            {
                int savedUserCode = current.user_code;
                if (!isEditMode)
                {
                    var responseBody = await response.Content.ReadAsStringAsync();
                    try
                    {
                        var jObj = JsonConvert.DeserializeObject<Newtonsoft.Json.Linq.JObject>(responseBody);
                        if (jObj != null)
                        {
                            savedUserCode = jObj["user_code"]?.ToObject<int>() 
                                            ?? jObj["usercode"]?.ToObject<int>() 
                                            ?? jObj["userCode"]?.ToObject<int>() 
                                            ?? jObj["data"]?["user_code"]?.ToObject<int>() 
                                            ?? jObj["data"]?["usercode"]?.ToObject<int>() 
                                            ?? 0;
                        }
                    }
                    catch (Exception ex)
                    {
                        /* Console.WriteLine($"Failed to parse user code from response: {ex.Message}") */;
                    }
                }
                
                if (savedUserCode > 0)
                {
                    await SaveUserModuleRights(savedUserCode);
                }

                Toast.Success(isEditMode ? "User updated successfully." : "User created successfully.");
                if (isEditMode)
                {
                    userImagesBase64.Remove(current.user_code);
                    signatureImagesBase64.Remove(current.user_code);
                }
                await LoadUsers();
                CloseForm();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                formError = $"Save failed ({response.StatusCode}): {body}";
            }
        }
        catch (Exception ex)
        {
            formError = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CloseForm()
    {
        showForm = false;
        formError = null;
        newPassword = "";
        current = new user_master();
        selectedUserPhotoBytes = null;
        selectedUserPhotoName = null;
        selectedSignaturePhotoBytes = null;
        selectedSignaturePhotoName = null;
        previewUserImageBase64 = "";
        previewSignatureImageBase64 = "";
        authorizedGroups.Clear();
        selectedGroupCodeToAuthorize = 0;
        selectedModuleId = 0;
    }

    // ── Delete ────────────────────────────────────────────────────────────────
    private async Task SoftDeleteUser(int usercode)
    {
        if (usercode == 0) return;
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Delete this user?");
        if (!confirmed) return;
        try
        {
            var response = await UserService.SoftDeleteAsync(usercode);
            if (response.IsSuccessStatusCode)
            {
                Toast.Success("User deleted.");
                await LoadUsers();
                if (isEditMode && current.user_code == usercode)
                    CloseForm();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Toast.Error($"Delete failed: {body}");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    // ── Verify ────────────────────────────────────────────────────────────────
    private async Task VerifyUser(int usercode)
    {
        try
        {
            var response = await UserService.VerifyAsync(usercode);
            if (response.IsSuccessStatusCode)
            {
                Toast.Success("User verified successfully.");
                current.is_verified = true;
                await LoadUsers();
                StateHasChanged();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Toast.Error($"Verify failed: {body}");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    // ── Image Upload ──────────────────────────────────────────────────────────
    private async Task OnUserImageUpload(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                selectedUserPhotoName = file.Name;
                current.user_image = file.Name;
                
                using var stream = file.OpenReadStream(maxAllowedSize: 10_240_000);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                selectedUserPhotoBytes = ms.ToArray();
                previewUserImageBase64 = Convert.ToBase64String(selectedUserPhotoBytes);
                StateHasChanged();
            }
        }
        catch (Exception ex) { formError = $"Image upload error: {ex.Message}"; }
    }

    private async Task OnSignatureUpload(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                selectedSignaturePhotoName = file.Name;
                current.signature_image = file.Name;
                
                using var stream = file.OpenReadStream(maxAllowedSize: 10_240_000);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                selectedSignaturePhotoBytes = ms.ToArray();
                previewSignatureImageBase64 = Convert.ToBase64String(selectedSignaturePhotoBytes);
                StateHasChanged();
            }
        }
        catch (Exception ex) { formError = $"Signature upload error: {ex.Message}"; }
    }

    private void RemoveUserPhoto()
    {
        selectedUserPhotoBytes = null;
        selectedUserPhotoName = null;
        previewUserImageBase64 = "";
        current.user_image = null;
        if (current.user_code != 0)
        {
