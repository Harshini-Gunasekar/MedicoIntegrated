    private async Task EditUser(user_master u)
    {
        activeTab = "profile";
        formError = null;
        isLoading = true;
        StateHasChanged();
        
        selectedUserPhotoBytes = null;
        selectedUserPhotoName = null;
        selectedSignaturePhotoBytes = null;
        selectedSignaturePhotoName = null;
        previewUserImageBase64 = "";
        previewSignatureImageBase64 = "";
        authorizedGroups.Clear();
        selectedGroupCodeToAuthorize = 0;
        
        try
        {
            var getUserResult = AllUsersRaw.FirstOrDefault(x => x.user?.user_code == u.user_code);
            if (getUserResult != null && getUserResult.user != null)
            {
                // Clone the user so edits don't mutate the grid immediately
                var serialized = Newtonsoft.Json.JsonConvert.SerializeObject(getUserResult.user);
                current = Newtonsoft.Json.JsonConvert.DeserializeObject<user_master>(serialized) ?? new();
                
                if (string.IsNullOrWhiteSpace(current.address))
                {
                    current.address = !string.IsNullOrWhiteSpace(current.permanent_address) ? current.permanent_address : current.current_address;
                }
                
                if (getUserResult.branch != null)
                {
                    selectedBranchCodes = getUserResult.branch
                        .Select(b => b.bhcode ?? 0)
                        .Where(c => c > 0)
                        .ToList();
                }
                
                if (getUserResult.department != null && allGroups.Any())
                {
                    authorizedGroups = getUserResult.department
                        .Where(d => d.dcode.HasValue) // Deserialized from 'gcode' JSON property
                        .Select(d => allGroups.FirstOrDefault(g => g.gcode == d.dcode))
                        .Where(g => g != null)
                        .ToList()!;
                }
                
                if (!string.IsNullOrEmpty(current.module) && string.IsNullOrEmpty(current.role))
                {
                    current.role = current.module.Trim().ToLower() switch
                    {
                        "result entry" or "result_entry" => "0",
                        "auth1" => "1",
                        "auth2" => "2",
                        _ => "0"
                    };
                }
                if (!string.IsNullOrEmpty(current.user_image) && !IsBase64String(current.user_image))
                {
                    _ = FetchAndCacheUserImageAsync(current.user_code, current.user_image);
                }
                if (!string.IsNullOrEmpty(current.signature_image) && !IsBase64String(current.signature_image))
                {
                    _ = FetchAndCacheSignatureImageAsync(current.user_code, current.signature_image);
                }
            }
            else
            {
                CloneLocalUser(u);
                selectedBranchCodes = new();
            }
        }
        catch
        {
            CloneLocalUser(u);
            selectedBranchCodes = new();
        }
        finally
        {
            isLoading = false;
        }

        newPassword = "";
        ShowPwd = false;
        
        if (rclProducts != null && rclProducts.Any())
        {
            selectedProductId = rclProducts.First().ProductId;
            await LoadRclRoleTemplates();
            await LoadUserProductPermission(u.user_code);
        }
        else
        {
            selectedProductId = "";
            selectedRoleTemplateName = "";
        }

        isEditMode = true;
        showForm = true;
        StateHasChanged();
    }

    private void CloneLocalUser(user_master u)
    {
        current = new user_master
        {
            user_code      = u.user_code,
            name          = u.name,
            short_name     = u.short_name,
            description   = u.description,
            mobile        = u.mobile,
            email         = u.email,
            address       = !string.IsNullOrWhiteSpace(u.address) ? u.address : (!string.IsNullOrWhiteSpace(u.permanent_address) ? u.permanent_address : u.current_address),
            permanent_address = u.permanent_address,
            current_address = u.current_address,
            password      = u.password,
            role          = u.role,
            module        = u.module,
            power_user     = u.power_user,
            is_verified   = u.is_verified,
            tenant_code   = u.tenant_code,
            user_image     = u.user_image,
            signature_image= u.signature_image,
        };

        if (string.IsNullOrEmpty(current.role) && !string.IsNullOrEmpty(current.module))
        {
            current.role = current.module.Trim().ToLower() switch
            {
                "result entry" or "result_entry" => "0",
                "auth1" => "1",
                "auth2" => "2",
                _ => "0"
            };
        }
    }

    private async Task SaveUser()
    {
        formError = null;

        // ── Client-side validation ──
        if (string.IsNullOrWhiteSpace(current.name))
        {
            formError = "Full Name is required.";
            return;
        }
        if (string.IsNullOrEmpty(current.role))
        {
            current.role = "0"; // Default to result entry behind the scenes
        }
        if (string.IsNullOrWhiteSpace(current.mobile))
        {
            formError = "Mobile number is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(current.email))
        {
            formError = "Email address is required.";
            return;
        }
        if (!current.email.Contains('@') || !current.email.Contains('.'))
        {
            formError = "Please enter a valid email address.";
            return;
        }
        if (string.IsNullOrWhiteSpace(current.short_name))
        {
            formError = "Short Name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(current.description))
        {
            formError = "Description is required.";
            return;
        }
        if (!isEditMode && string.IsNullOrWhiteSpace(newPassword))
        {
            formError = "Password is required for new users.";
            return;
        }

        isSaving = true;
        StateHasChanged();
        try
        {
            var branchList = new List<UserBranchMaster>();
            if (selectedBranchCodes != null && selectedBranchCodes.Any())
            {
                foreach (var bhCode in selectedBranchCodes)
                {
                    branchList.Add(new UserBranchMaster
                    {
                        bhcode = bhCode,
                        user_code = isEditMode ? current.user_code : (int?)null,
                        tenant_code = TenantCode,
                        deleted = false
                    });
                }
            }

            if (!string.IsNullOrEmpty(newPassword))
            {
                current.password = newPassword;
            }
            else if (isEditMode)
            {
                if (string.IsNullOrWhiteSpace(current.password))
                {
                    current.password = "********";
                }
            }

            var departmentList = new List<UserDepartmentMaster>();
            if (authorizedGroups != null && authorizedGroups.Any())
            {
                foreach (var ag in authorizedGroups)
                {
                    departmentList.Add(new UserDepartmentMaster
                    {
                        dcode = (int)ag.gcode,
                        user_code = isEditMode ? current.user_code : (int?)null,
                        tenant_code = TenantCode,
                        deleted = false
                    });
                }
            }

            current.permanent_address = current.address;
            current.current_address = current.address;

            HttpResponseMessage response;
            Console.WriteLine($"[SaveUser] UI State -> edit_bill: {current.edit_bill}, print_bill: {current.print_bill}");
            if (!string.IsNullOrEmpty(selectedRoleTemplateName))
            {
                current.role = selectedRoleTemplateName;
            }

            if (isEditMode)
            {
                response = await UserService.UpdateAsync(
                    current,
                    branchList,
                    departmentList,
                    selectedUserPhotoBytes,
                    selectedUserPhotoName,
                    selectedSignaturePhotoBytes,
                    selectedSignaturePhotoName,
                    userSelectedRoleIds.ToList(),
                    selectedRoleTemplateName,
                    selectedTemplateGuid);
            }
            else
            {
                response = await UserService.RegisterAsync(
                    current,
                    branchList,
                    departmentList,
                    selectedUserPhotoBytes,
                    selectedUserPhotoName,
                    selectedSignaturePhotoBytes,
                    selectedSignaturePhotoName,
                    isAnonymousRegister: false,
                    roleIds: userSelectedRoleIds.ToList(),
                    roleTemplateName: selectedRoleTemplateName,
                    roleTemplateGuid: selectedTemplateGuid);
            }

            if (response.IsSuccessStatusCode)
            {
                if (isEditMode && current.user_code > 0)
                {
                    try
                    {
                        var effectiveTenant = !string.IsNullOrEmpty(TenantCode) ? TenantCode : TenantState.TenantCode;
                        await RoleService.SaveUserRolesAsync(current.user_code, userSelectedRoleIds.ToList(), effectiveTenant);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[UserMaster] RoleService.SaveUserRolesAsync: {ex.Message}");
                    }
                }

                Toast.Success(isEditMode ? "User updated successfully." : "User created successfully.");
                if (isEditMode)
                {
                    userImagesBase64.Remove(current.user_code);
                    signatureImagesBase64.Remove(current.user_code);
                }
                await LoadUsers();
                CloseForm();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                formError = $"Save failed ({response.StatusCode}): {body}";
            }
        }
        catch (Exception ex)
        {
            formError = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

