    private async Task LoadGroups()
    {
        try
        {
            var client = ClientFactory.CreateClient("DoctorApi");
            if (!string.IsNullOrEmpty(TenantCode))
            {
                if (client.DefaultRequestHeaders.Contains("tenant_code"))
                    client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }

            var response = await client.GetAsync("api/GroupMaster/get");
            if (response.IsSuccessStatusCode)
            {
                var apiGroups = await response.Content.ReadFromJsonAsync<List<Booking.Models.GroupMasterModel>>() ?? new();
                allGroups = apiGroups.Select(g => new GroupModel
                {
                    gcode = (long)g.gcode,
                    name = g.name,
                    shortname = g.shortname,
                    description = g.description,
                    tenant_code = g.tenant_code
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading groups: {ex.Message}") */;
        }
    }

    private async Task LoadAuthorizedGroups()
    {
        if (current.user_code == 0)
        {
            authorizedGroups.Clear();
            return;
        }

        try
        {
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}api/userrights/authget?usercode={current.user_code}");
            if (response.IsSuccessStatusCode)
            {
                var jsonStr = await response.Content.ReadAsStringAsync();
                /* Console.WriteLine($"[LoadAuthorizedGroups] Raw JSON: {jsonStr}") */;
                var rights = JsonConvert.DeserializeObject<List<UserRightModel>>(jsonStr) ?? new();
                authorizedGroups = allGroups
                    .Where(g => rights.Any(r => r.gcode == g.gcode))
                    .ToList();
            }
            else
            {
                authorizedGroups.Clear();
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading authorized groups: {ex.Message}") */;
            authorizedGroups.Clear();
        }
        StateHasChanged();
    }

    private async Task AuthorizeSelectedGroup()
    {
        if (selectedGroupCodeToAuthorize == 0 || current.user_code == 0) return;
        
        try
        {
            using var client = CreateClient();
            var payload = new List<UserRightModel>();
            
            if (authorizedGroups != null)
            {
                foreach (var ag in authorizedGroups)
                {
                    payload.Add(new UserRightModel
                    {
                        usercode = current.user_code,
                        gcode = ag.gcode,
                        tenant_code = TenantCode
                    });
                }
            }
            
            if (!payload.Any(x => x.gcode == selectedGroupCodeToAuthorize))
            {
                payload.Add(new UserRightModel
                {
                    usercode = current.user_code,
                    gcode = selectedGroupCodeToAuthorize,
                    tenant_code = TenantCode
                });
            }
            
            var json = JsonConvert.SerializeObject(payload);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await client.PostAsync($"{BaseUrl}api/userrights/authorization", content);
            if (response.IsSuccessStatusCode)
            {
                Toast.Success("Group authorized successfully.");
                selectedGroupCodeToAuthorize = 0;
                await LoadAuthorizedGroups();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Toast.Error($"Failed to authorize group: {body}");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private async Task DeauthorizeGroup(long gcode)
    {
        if (current.user_code == 0) return;
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Remove authorization for this group?");
        if (!confirmed) return;
        
        try
        {
            using var client = CreateClient();
            var response = await client.DeleteAsync($"{BaseUrl}api/userrights/authdelete?usercode={current.user_code}&gcode={gcode}");
            if (response.IsSuccessStatusCode)
            {
                Toast.Success("Authorization removed.");
                await LoadAuthorizedGroups();
            }
            else
            {
                // Try GET fallback just in case the backend implemented it as a GET
                var responseGet = await client.GetAsync($"{BaseUrl}api/userrights/authdelete?usercode={current.user_code}&gcode={gcode}");
                if (responseGet.IsSuccessStatusCode)
                {
                    Toast.Success("Authorization removed.");
                    await LoadAuthorizedGroups();
                }
                else
                {
                    var body = await response.Content.ReadAsStringAsync();
                    Toast.Error($"Failed to remove authorization: {body}");
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

