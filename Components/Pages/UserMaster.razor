@page "/user-master"
@using Booking.Components.Layout
@using Booking.Models
@using Booking.Services
@using LIMS_Backend.Model
@using SharedComponents.Rcl.Models
@using SharedComponents.Rcl.Services
@using System.Net.Http.Json
@using System.Text.Json
@using Newtonsoft.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject ProtectedSessionStorage _sessionStorage
@inject TenantSessionState TenantState
@inject ToastService Toast
@inject LabCare.Services.UserService UserService
@inject Booking.Services.RoleMasterService RoleService

@if (!showForm)
{
    <!-- ── Header Card ── -->
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">manage_accounts</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">User Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Identity &amp; Access Management</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <!-- Search -->
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search users..."
                       @bind="SearchQuery" @bind:event="oninput"
                       class="lc-search-input-field-custom" />
            </div>

            <div class="search-controls">
                @if (TenantState.HasActionRight("Configuration", "General", "Create")) { <button class="btn-new-entry" @onclick="NewUser">+ Add New</button> }
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════
         USER TABLE
    ════════════════════════════════════ -->
    <div class="directory-section lc-rounded-t-0 lc-mt-neg-4">
        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>NAME</th>
                        <th>SHORT</th>
                        <th>MOBILE</th>
                        <th>EMAIL</th>
                        <th>PRICE EDIT</th>
                        <th>PRINT BILL</th>
                        <th>VERIFIED</th>
                        <th>DESCRIPTION</th>
                        <th class="text-center lc-width-120">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="10" class="td-narration p-24 text-center lc-color-slate-400">
                                <span class="material-symbols-outlined lc-font-18 lc-vertical-middle lc-mr-6 lc-animate-spin">autorenew</span>
                                Loading users...
                            </td>
                        </tr>
                    }
                    else if (FilteredUsers.Any())
                    {
                        int sno = ((currentPage - 1) * pageSize) + 1;
                        @foreach (var u in PaginatedUsers)
                        {
                            <tr>
                                <td>@(sno++)</td>
                                <td>
                                    <div class="lc-flex-center-inline lc-gap-8">
                                        @if (!string.IsNullOrEmpty(u.user_image))
                                        {
                                            @if (IsBase64String(u.user_image))
                                            {
                                                <img src="data:image/jpeg;base64,@u.user_image" alt="@u.name" class="container-img-small lc-rounded-full" />
                                            }
                                            else if (userImagesBase64.TryGetValue(u.user_code, out var base64Str))
                                            {
                                                <img src="data:@GetMimeType(u.user_image);base64,@base64Str" alt="@u.name" class="container-img-small lc-rounded-full" />
                                            }
                                            else
                                            {
                                                <div class="lc-avatar-initials-mini">
                                                    @(u.name?.Length > 0 ? u.name[0].ToString().ToUpper() : "?")
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="lc-avatar-initials-mini">
                                                @(u.name?.Length > 0 ? u.name[0].ToString().ToUpper() : "?")
                                            </div>
                                        }
                                        <span class="td-name">@u.name</span>
                                    </div>
                                </td>
                                <td>@u.short_name</td>
                                <td>@u.mobile</td>
                                <td>@u.email</td>
                                <td>
                                     @if (u.is_power_user == true)
                                     {
                                         <span class="lc-color-green-500 lc-font-12 lc-font-600">✓ Allowed</span>
                                     }
                                     else
                                     {
                                         <span class="lc-color-slate-400 lc-font-12">No</span>
                                     }
                                 </td>
                                 <td>
                                     @if (u.power_user == true)
                                     {
                                         <span class="lc-color-green-500 lc-font-12 lc-font-600">✓ Allowed</span>
                                     }
                                     else
                                     {
                                         <span class="lc-color-slate-400 lc-font-12">No</span>
                                     }
                                 </td>
                                <td>
                                    @if (u.is_verified == true)
                                    {
                                        <span class="lc-color-green-500 lc-font-12 lc-font-600">✓ Verified</span>
                                    }
                                    else
                                    {
                                        <span class="lc-color-orange-500 lc-font-12">Pending</span>
                                    }
                                </td>
                                <td><span class="td-narration">@u.description</span></td>
                                <td class="text-center">
                                    @if (TenantState.HasActionRight("Configuration", "General", "Edit")) {
                                    <button type="button" class="btn-action btn-edit" @onclick="() => EditUser(u)" title="Edit User">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5z" />
                                        </svg>
                                    </button>
                                    <button type="button" class="btn-action btn-rights" @onclick="() => EditUserWithRights(u)" title="Role & Branch Rights">
                                        <span class="material-symbols-outlined" style="font-size: 15px;">shield_person</span>
                                    </button>
                                    }
                                    @if (TenantState.HasActionRight("Configuration", "General", "Delete")) {
                                    <button type="button" class="btn-action btn-delete-action" @onclick="() => SoftDeleteUser(u.user_code)" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3h11V2h-11z" />
                                        </svg>
                                    </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="td-narration p-24 text-center">No users found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ════════════════════════════════════
             PAGINATION FOOTER
        ════════════════════════════════════ -->
        @if (FilteredUsers.Any())
        {
            <div class="table-pagination-footer">
                <div class="pagination-info">
                    Showing <span class="font-bold">@(((currentPage - 1) * pageSize) + 1)</span> to <span class="font-bold">@(Math.Min(currentPage * pageSize, FilteredUsers.Count()))</span> of <span class="font-bold">@FilteredUsers.Count()</span> users
                </div>
                @if (TotalPages > 1)
                {
                    <div class="pagination-controls">
                        <button type="button" class="pg-btn pg-nav" disabled="@(currentPage <= 1)" @onclick="() => ChangePage(currentPage - 1)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
                            </svg>
                            <span>Previous</span>
                        </button>

                        <div class="pg-numbers">
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button type="button" class="pg-btn pg-num @(currentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        </div>

                        <button type="button" class="pg-btn pg-nav" disabled="@(currentPage >= TotalPages)" @onclick="() => ChangePage(currentPage + 1)">
                            <span>Next</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
                            </svg>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <!-- ════════════════════════════════════
         FULL SCREEN USER EDIT / CREATE VIEW
    ════════════════════════════════════ -->
    <div class="user-editor-fullscreen">
        <!-- ── Top Navigation & Action Header ── -->
        <div class="lab-header-card flex-between">
            <div class="display-flex align-center gap-16">
                <button type="button" class="user-back-btn" @onclick="CloseForm" title="Back to Directory">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                    </svg>
                    <span>Back to Directory</span>
                </button>
                <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                    <span class="material-symbols-outlined text-indigo-600 icon-lg">@(isEditMode ? "manage_accounts" : "person_add")</span>
                </div>
                <div>
                    <div class="display-flex align-center gap-10">
                        <h2 class="lab-title-text m-0">@(isEditMode ? "Edit User" : "New User Entry")</h2>
                        @if (isEditMode)
                        {
                            <span class="user-badge-code">Code: #@current.user_code</span>
                            @if (current.is_verified == true)
                            {
                                <span class="user-badge-verified">
                                    <span class="material-symbols-outlined" style="font-size: 14px;">verified</span> Verified
                                </span>
                            }
                            else
                            {
                                <span class="user-badge-pending">Pending Verification</span>
                            }
                        }
                    </div>
                    <div class="flex-start gap-8 mt-2px">
                        <span class="status-pulse-dot"></span>
                        <span class="status-text">@(isEditMode ? $"Updating user profile for {current.name}" : "Create new user account and credentials")</span>
                    </div>
                </div>
            </div>

            <!-- Top Actions -->
            <div class="display-flex align-center gap-12">
                <button type="button" class="btn-cancel-flat" @onclick="CloseForm">
                    Cancel
                </button>
                @if (isEditMode)
                {
                    @if (TenantState.HasActionRight("Configuration", "General", "Delete"))
                    {
                        <button type="button" class="btn-delete" @onclick="() => SoftDeleteUser(current.user_code)" disabled="@(current.user_code == 0 || isSaving)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="lc-mr-6">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3h11V2h-11z" />
                            </svg>
                            Delete
                        </button>
                    }
                    @if (current.is_verified != true)
                    {
                        <button type="button" class="lc-btn lc-btn-primary lc-font-13 lc-p-8-18" @onclick="() => VerifyUser(current.user_code)" disabled="@isSaving">
                            <span class="material-symbols-outlined lc-font-15 lc-vertical-middle lc-mr-4">verified_user</span>
                            Verify
                        </button>
                    }
                }
                <button type="button" class="btn-save" @onclick="SaveUser" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="material-symbols-outlined lc-font-16 lc-animate-spin lc-mr-6">autorenew</span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="lc-mr-8">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11Z" />
                        </svg>
                        <span>@(isSaving ? "Saving..." : (isEditMode ? "Update User" : "Create User"))</span>
                    }
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(formError))
        {
            <div class="alert alert-danger lc-alert-danger-sm display-flex align-center justify-between" style="border-radius: 10px; margin-top: 4px;">
                <div class="display-flex align-center gap-8">
                    <span class="material-symbols-outlined" style="font-size: 18px;">error</span>
                    <span>@formError</span>
                </div>
                <button type="button" class="btn-close" @onclick="() => formError = null"></button>
            </div>
        }

        <!-- ── Option Tabs: User Profile, Role Rights, Branch Rights ── -->
        <div class="user-form-tabs-container">
            <div class="user-form-tabs">
                <button type="button" class="user-form-tab-btn @(activeTab == "profile" ? "active" : "")" @onclick='() => activeTab = "profile"'>
                    <span class="material-symbols-outlined">person</span>
                    <span>User Profile</span>
                </button>

                <button type="button" class="user-form-tab-btn @(activeTab == "role_rights" ? "active" : "")" @onclick='() => activeTab = "role_rights"'>
                    <span class="material-symbols-outlined">shield_person</span>
                    <span>Role Rights</span>
                    <span class="user-tab-badge @(userSelectedRoleIds.Count > 0 ? "has-count" : "")">
                        @userSelectedRoleIds.Count / @(masterCatalog.Count > 0 ? masterCatalog.Count : 364)
                    </span>
                </button>

                <button type="button" class="user-form-tab-btn @(activeTab == "branch_rights" ? "active" : "")" @onclick='() => activeTab = "branch_rights"'>
                    <span class="material-symbols-outlined">domain</span>
                    <span>Branch Rights</span>
                    <span class="user-tab-badge @(selectedBranchCodes.Count > 0 ? "has-count" : "")">
                        @selectedBranchCodes.Count / @allBranches.Count
                    </span>
                </button>
            </div>
        </div>

        @if (activeTab == "profile")
        {
            <!-- ── Main 2-Column Form Grid ── -->
            <div class="user-editor-grid">
                <!-- Left Column: User Information & Credentials -->
                <div class="user-card-panel">
                    <div class="user-panel-header">
                        <h4 class="user-panel-title">
                            <span class="material-symbols-outlined text-indigo-600" style="font-size: 18px;">badge</span>
                            User Information
                        </h4>
                        <span class="user-panel-subtitle">Profile details &amp; credentials</span>
                    </div>

                    <div class="user-fields-2col">
                        <!-- Full Name -->
                        <div class="user-field-item">
                            <label class="user-field-label">
                                Full Name <span class="lc-text-danger">*</span>
                            </label>
                            <input type="text" class="lab-input" @bind="current.name" placeholder="e.g. Alice Johnson" autocomplete="off" />
                        </div>

                        <!-- Short Name -->
                        <div class="user-field-item">
                            <label class="user-field-label">
                                Short Name <span class="lc-text-danger">*</span>
                            </label>
                            <input type="text" class="lab-input" @bind="current.short_name" placeholder="e.g. ALC" maxlength="10" autocomplete="off" />
                        </div>

                        <!-- Mobile -->
                        <div class="user-field-item">
                            <label class="user-field-label">
                                Mobile Number <span class="lc-text-danger">*</span>
                            </label>
                            <input type="tel" class="lab-input" @bind="current.mobile" placeholder="10-digit number" maxlength="15" autocomplete="off" />
                        </div>

                        <!-- Email -->
                        <div class="user-field-item">
                            <label class="user-field-label">
                                Email Address <span class="lc-text-danger">*</span>
                            </label>
                            <input type="email" class="lab-input" @bind="current.email" placeholder="user@lab.com" autocomplete="off" />
                        </div>

                        <!-- Description -->
                        <div class="user-field-item">
                            <label class="user-field-label">
                                Description <span class="lc-text-danger">*</span>
                            </label>
                            <input type="text" class="lab-input" @bind="current.description" placeholder="e.g. Duty Medical Officer / Billing Staff" autocomplete="off" />
                        </div>

                        <!-- Password -->
                        <div class="user-field-item">
                            @if (!isEditMode)
                            {
                                <label class="user-field-label">
                                    Password <span class="lc-text-danger">*</span>
                                </label>
                                <div class="lc-relative">
                                    <input type="text" class="lab-input lc-pr-40" style="@pwdMaskStyle" @bind="newPassword"
                                           placeholder="Min 6 characters" autocomplete="off" aria-autocomplete="none" spellcheck="false" autocorrect="off" autocapitalize="off" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" data-form-type="other" />
                                    <button type="button" @onclick="() => ShowPwd = !ShowPwd" class="lc-pwd-toggle-btn" title="@(ShowPwd ? "Hide password" : "Show password")">
                                        <span class="material-symbols-outlined lc-font-18">
                                            @(ShowPwd ? "visibility_off" : "visibility")
                                        </span>
                                    </button>
                                </div>
                                <span class="user-field-hint">Must be at least 6 characters.</span>
                            }
                            else
                            {
                                <label class="user-field-label">
                                    New Password <span class="lc-color-slate-400 lc-font-11 font-normal">(leave blank to keep current)</span>
                                </label>
                                <div class="lc-relative">
                                    <input type="text" class="lab-input lc-pr-40" style="@pwdMaskStyle" @bind="newPassword"
                                           placeholder="Enter to change password" autocomplete="off" aria-autocomplete="none" spellcheck="false" autocorrect="off" autocapitalize="off" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" data-form-type="other" />
                                    <button type="button" @onclick="() => ShowPwd = !ShowPwd" class="lc-pwd-toggle-btn" title="@(ShowPwd ? "Hide password" : "Show password")">
                                        <span class="material-symbols-outlined lc-font-18">
                                            @(ShowPwd ? "visibility_off" : "visibility")
                                        </span>
                                    </button>
                                </div>
                                <span class="user-field-hint">Leave blank if not changing.</span>
                            }
                        </div>

                        <!-- Address -->
                        <div class="user-field-item user-field-span2">
                            <label class="user-field-label">
                                Address
                            </label>
                            <textarea class="lab-input" @bind="current.address" placeholder="Residential or Office address" rows="2" autocomplete="off" style="resize: vertical; min-height: 52px;"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Profile Photo & Signature -->
                <div class="user-card-panel">
                    <div class="user-panel-header">
                        <h4 class="user-panel-title">
                            <span class="material-symbols-outlined text-indigo-600" style="font-size: 18px;">photo_library</span>
                            Profile Images
                        </h4>
                        <span class="user-panel-subtitle">Photo &amp; Signature</span>
                    </div>

                    <div class="user-media-grid">
                        <!-- User Photo Upload -->
                        <div class="user-media-card">
                            <label class="user-field-label">
                                <span class="material-symbols-outlined" style="font-size: 16px;">account_circle</span>
                                User Photo
                            </label>

                            @if (!string.IsNullOrEmpty(previewUserImageBase64))
                            {
                                <div class="user-media-preview-box">
                                    <img src="data:image/png;base64,@previewUserImageBase64" alt="Photo Preview" class="user-media-thumb" />
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="font-size: 13px; font-weight: 600; color: #1e293b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            @(selectedUserPhotoName ?? "New Photo")
                                        </div>
                                        <div style="font-size: 11px; color: #10b981; font-weight: 500;">Ready to upload</div>
                                    </div>
                                    <button type="button" class="btn-delete-text" @onclick="RemoveUserPhoto" title="Remove Photo" style="color: #ef4444; border: none; background: transparent; cursor: pointer; padding: 6px;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3h11V2h-11z"/>
                                        </svg>
                                    </button>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(current.user_image))
                            {
                                <div class="user-media-preview-box">
                                    @if (IsBase64String(current.user_image))
                                    {
                                        <img src="data:image/jpeg;base64,@current.user_image" alt="Photo" class="user-media-thumb" />
                                    }
                                    else if (userImagesBase64.TryGetValue(current.user_code, out var base64Str))
                                    {
                                        <img src="data:@GetMimeType(current.user_image);base64,@base64Str" alt="Photo" class="user-media-thumb" />
                                    }
                                    else
                                    {
                                        <div class="user-media-thumb display-flex align-center justify-center text-slate-400">
                                            <span class="material-symbols-outlined">image</span>
                                        </div>
                                    }
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="font-size: 13px; font-weight: 600; color: #1e293b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            @current.user_image
                                        </div>
                                        <div style="font-size: 11px; color: #64748b;">Current profile photo</div>
                                    </div>
                                    <button type="button" class="btn-delete-text" @onclick="RemoveUserPhoto" title="Remove Photo" style="color: #ef4444; border: none; background: transparent; cursor: pointer; padding: 6px;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3h11V2h-11z"/>
                                        </svg>
                                    </button>
                                </div>
                            }

                            <label for="userPhotoInput" class="cm-file-upload @(selectedUserPhotoBytes != null || !string.IsNullOrEmpty(current.user_image) ? "selected" : "")" style="width: 100%;">
                                <span class="material-symbols-outlined">add_photo_alternate</span> 
                                @(selectedUserPhotoBytes != null ? "Replace Photo" : (!string.IsNullOrEmpty(current.user_image) ? "Change Photo" : "Upload User Photo"))
                            </label>
                            <Microsoft.AspNetCore.Components.Forms.InputFile id="userPhotoInput" OnChange="OnUserImageUpload" accept=".jpg,.jpeg,.png,.webp" hidden />
                        </div>

                        <!-- Signature Upload -->
                        <div class="user-media-card">
                            <label class="user-field-label">
                                <span class="material-symbols-outlined" style="font-size: 16px;">draw</span>
                                Signature
                            </label>

                            @if (!string.IsNullOrEmpty(previewSignatureImageBase64))
                            {
                                <div class="user-media-preview-box">
                                    <img src="data:image/png;base64,@previewSignatureImageBase64" alt="Signature Preview" class="user-signature-thumb" />
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="font-size: 13px; font-weight: 600; color: #1e293b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            @(selectedSignaturePhotoName ?? "New Signature")
                                        </div>
                                        <div style="font-size: 11px; color: #10b981; font-weight: 500;">Ready to upload</div>
                                    </div>
                                    <button type="button" class="btn-delete-text" @onclick="RemoveSignaturePhoto" title="Remove Signature" style="color: #ef4444; border: none; background: transparent; cursor: pointer; padding: 6px;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3h11V2h-11z"/>
                                        </svg>
                                    </button>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(current.signature_image))
                            {
                                <div class="user-media-preview-box">
                                    @if (IsBase64String(current.signature_image))
                                    {
                                        <img src="data:image/jpeg;base64,@current.signature_image" alt="Signature" class="user-signature-thumb" />
                                    }
                                    else if (signatureImagesBase64.TryGetValue(current.user_code, out var base64Str))
                                    {
                                        <img src="data:@GetMimeType(current.signature_image);base64,@base64Str" alt="Signature" class="user-signature-thumb" />
                                    }
                                    else
                                    {
                                        <div class="user-signature-thumb display-flex align-center justify-center text-slate-400">
                                            <span class="material-symbols-outlined">draw</span>
                                        </div>
                                    }
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="font-size: 13px; font-weight: 600; color: #1e293b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            @current.signature_image
                                        </div>
                                        <div style="font-size: 11px; color: #64748b;">Current signature file</div>
                                    </div>
                                    <button type="button" class="btn-delete-text" @onclick="RemoveSignaturePhoto" title="Remove Signature" style="color: #ef4444; border: none; background: transparent; cursor: pointer; padding: 6px;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3h11V2h-11z"/>
                                        </svg>
                                    </button>
                                </div>
                            }

                            <label for="signatureInput" class="cm-file-upload @(selectedSignaturePhotoBytes != null || !string.IsNullOrEmpty(current.signature_image) ? "selected" : "")" style="width: 100%;">
                                <span class="material-symbols-outlined">draw</span> 
                                @(selectedSignaturePhotoBytes != null ? "Replace Signature" : (!string.IsNullOrEmpty(current.signature_image) ? "Change Signature" : "Upload Signature"))
                            </label>
                            <Microsoft.AspNetCore.Components.Forms.InputFile id="signatureInput" OnChange="OnSignatureUpload" accept=".jpg,.jpeg,.png,.webp" hidden />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Role & Branch Rights Overview Banner Card -->
            <div class="um-rights-banner-card">
                <div class="um-rights-banner-content">
                    <div class="um-rights-banner-icon">
                        <span class="material-symbols-outlined">verified_user</span>
                    </div>
                    <div class="um-rights-banner-text">
                        <h4 class="um-rights-banner-title">Role Rights &amp; Branch Access</h4>
                        <p class="um-rights-banner-desc">
                            Assign permissions using a preconfigured role template or customize individual rights directly. Control which hospital branches this user is authorized to access.
                        </p>
                        <div class="um-rights-banner-meta">
                            <span class="um-rights-status-chip">
                                <span class="material-symbols-outlined">shield</span>
                                <strong>@userSelectedRoleIds.Count</strong> Rights Granted
                            </span>
                            @if (selectedTemplateGuid != null)
                            {
                                var tName = roleTemplates.FirstOrDefault(t => t.RoleNameGUID == selectedTemplateGuid)?.Role_Name;
                                if (!string.IsNullOrEmpty(tName))
                                {
                                    <span class="um-rights-template-chip">
                                        <span class="material-symbols-outlined">auto_awesome</span>
                                        Template: @tName
                                    </span>
                                }
                            }
                            <span class="um-rights-status-chip">
                                <span class="material-symbols-outlined">domain</span>
                                <strong>@selectedBranchCodes.Count</strong> of <strong>@allBranches.Count</strong> Branches
                            </span>
                        </div>
                    </div>
                    <div class="display-flex gap-8">
                        <button type="button" class="um-btn-open-rights-hero" @onclick='() => activeTab = "role_rights"'>
                            <span class="material-symbols-outlined">shield_person</span>
                            <span>Configure Role Rights</span>
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </button>
                        <button type="button" class="um-btn-open-rights-hero secondary" @onclick='() => activeTab = "branch_rights"'>
                            <span class="material-symbols-outlined">domain</span>
                            <span>Configure Branches</span>
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </button>
                    </div>
                </div>
            </div>
        }
        else if (activeTab == "role_rights")
        {
            <!-- ══════════════════════════════════════════════════════════════
                 TAB 2: ROLE RIGHTS WORKSPACE (TEMPLATE SELECTOR + DIRECT MATRIX EDITING)
            ══════════════════════════════════════════════════════════════ -->
            <div class="umr-role-rights-panel">
                <!-- Meta Bar: Role Template Selector, Search & Quick Actions -->
                <div class="umr-role-meta-bar">
                    <div class="umr-input-group">
                        <label class="umr-input-label" for="roleTemplateSelect">
                            <span class="material-symbols-outlined" style="font-size: 15px; vertical-align: middle;">badge</span>
                            Role Template <span class="umr-req-star">*</span>
                        </label>
                        <div class="umr-input-wrapper">
                            <select id="roleTemplateSelect"
                                    class="umr-input"
                                    value="@(selectedTemplateGuid?.ToString() ?? "")"
                                    @onchange="OnRoleTemplateChanged">
                                <option value="">-- Custom Rights (Without Template) --</option>
                                @foreach (var t in roleTemplates)
                                {
                                    <option value="@t.RoleNameGUID">@t.Role_Name (@t.TotalPermissionsAssigned permissions)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="umr-filter-group">
                        <label class="umr-input-label" for="permissionSearch">
                            <span class="material-symbols-outlined" style="font-size: 15px; vertical-align: middle;">search</span>
                            Filter Permissions
                        </label>
                        <div class="umr-input-wrapper">
                            <input id="permissionSearch" type="text" class="umr-input"
                                   placeholder="Filter module, sub-module, or action name..."
                                   @bind="permissionSearchQuery" @bind:event="oninput" @onkeyup="OnSearchPermissionChanged" />
                            @if (!string.IsNullOrWhiteSpace(permissionSearchQuery))
                            {
                                <button type="button" class="umr-clear-search-btn" @onclick="ClearPermissionSearch" title="Clear filter">
                                    <span class="material-symbols-outlined">close</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="umr-counter-block">
                        <div class="umr-selection-counter-badge">
                            <span class="material-symbols-outlined">verified</span>
                            <div>
                                <span class="umr-counter-val">@SelectedCount</span>
                                <span class="umr-counter-max">/ @(masterCatalog.Count > 0 ? masterCatalog.Count : 364)</span>
                                <span class="umr-counter-lbl">(@SelectedPercent%)</span>
                            </div>
                        </div>
                    </div>

                    <div class="umr-quick-actions">
                        <button type="button" class="umr-quick-btn select-all" @onclick="SelectAllPermissions" title="Grant all permissions">
                            <span class="material-symbols-outlined">done_all</span>
                            <span>Select All</span>
                        </button>
                        <button type="button" class="umr-quick-btn clear-all" @onclick="DeselectAllPermissions" title="Clear all permissions">
                            <span class="material-symbols-outlined">remove_done</span>
                            <span>Clear All</span>
                        </button>
                        <button type="button" class="umr-quick-btn expand-toggle" @onclick="ToggleExpandAllModules" title="@(isAllExpanded ? "Collapse all modules" : "Expand all modules")">
                            <span class="material-symbols-outlined">@(isAllExpanded ? "unfold_less" : "unfold_more")</span>
                            <span>@(isAllExpanded ? "Collapse All" : "Expand All")</span>
                        </button>
                    </div>
                </div>

                <!-- Notice / Tip -->
                <div class="umr-tab-notice">
                    <span class="material-symbols-outlined" style="font-size: 16px; color: #4f46e5;">info</span>
                    <span>
                        You can select a predefined role template above and then customize permissions directly by checking or unchecking any option below.
                    </span>
                </div>

                <!-- Hierarchical Matrix Workspace -->
                <div class="umr-hierarchy-workspace">
                    @if (!hierarchyTree.Any(m => m.IsVisible))
                    {
                        <div class="umr-empty-search">
                            <span class="material-symbols-outlined umr-empty-icon">search_off</span>
                            <h4>No matching permissions found</h4>
                            <p>No modules match "<strong>@permissionSearchQuery</strong>". Try clearing your search filter.</p>
                            <button type="button" class="btn-cancel-flat" @onclick="ClearPermissionSearch" style="margin-top: 10px;">Clear Filter</button>
                        </div>
                    }
                    else
                    {
                        @foreach (var modNode in hierarchyTree)
                        {
                            if (!modNode.IsVisible) continue;

                            <div class="umr-main-module-card @(modNode.IsExpanded ? "is-expanded" : "") @(modNode.IsAllSelected ? "is-all-selected" : modNode.SelectedCount > 0 ? "has-selection" : "")">
                                <!-- Level 1: Main Module Header -->
                                <div class="umr-main-header">
                                    <div class="umr-main-header-left" @onclick="() => modNode.IsExpanded = !modNode.IsExpanded">
                                        <div class="umr-main-icon-wrap">
                                            <span class="material-symbols-outlined">@GetMaterialIcon(modNode.ModuleName)</span>
                                        </div>
                                        <div class="umr-main-title-wrap">
                                            <div class="umr-main-title">
                                                <span>@modNode.ModuleName</span>
                                                <span class="umr-submodules-count">(@modNode.SubModules.Count(s => s.IsVisible) sub-modules)</span>
                                            </div>
                                            <div class="umr-main-meta">
                                                <span class="umr-group-badge @(modNode.SelectedCount > 0 ? "has-selected" : "")">
                                                    @modNode.SelectedCount / @modNode.TotalCount selected
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="umr-main-header-right" @onclick:stopPropagation="true">
                                        <label class="umr-checkbox-label">
                                            <input type="checkbox"
                                                   class="umr-checkbox"
                                                   checked="@modNode.IsAllSelected"
                                                   @onchange="(e) => ToggleModuleSelectAll(modNode, e)" />
                                            <span class="umr-checkbox-custom @(modNode.SelectedCount > 0 && !modNode.IsAllSelected ? "is-indeterminate" : "")"></span>
                                            <span class="umr-checkbox-text">Select All Module</span>
                                        </label>
                                        <button type="button" class="umr-toggle-chevron-btn" @onclick="() => modNode.IsExpanded = !modNode.IsExpanded" title="Toggle section">
                                            <span class="material-symbols-outlined @(modNode.IsExpanded ? "rotate-open" : "")">expand_more</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Level 2 & 3: Sub-Modules and Action Chips -->
                                @if (modNode.IsExpanded)
                                {
                                    <div class="umr-sub-modules-body">
                                        @foreach (var subNode in modNode.SubModules)
                                        {
                                            if (!subNode.IsVisible) continue;

                                            <div class="umr-sub-module-block">
                                                <div class="umr-sub-header">
                                                    <div class="umr-sub-title-wrap" @onclick="() => subNode.IsExpanded = !subNode.IsExpanded" style="cursor: pointer;">
                                                        <span class="material-symbols-outlined umr-sub-icon">folder_open</span>
                                                        <span class="umr-sub-title">@subNode.SubModuleName</span>
                                                        <span class="umr-sub-badge @(subNode.SelectedCount > 0 ? "active" : "")">
                                                            @subNode.SelectedCount / @subNode.TotalCount
                                                        </span>
                                                    </div>

                                                    <div class="display-flex align-center gap-12" @onclick:stopPropagation="true">
                                                        <label class="umr-checkbox-label umr-sub-select-all">
                                                            <input type="checkbox"
                                                                   class="umr-checkbox"
                                                                   checked="@subNode.IsAllSelected"
                                                                   @onchange="(e) => ToggleSubModuleSelectAll(subNode, e)" />
                                                            <span class="umr-checkbox-custom @(subNode.SelectedCount > 0 && !subNode.IsAllSelected ? "is-indeterminate" : "")"></span>
                                                            <span class="umr-checkbox-text">Select Sub-Module</span>
                                                        </label>
                                                    </div>
                                                </div>

                                                @if (subNode.IsExpanded)
                                                {
                                                    <div class="umr-actions-grid">
                                                        @foreach (var act in subNode.Actions)
                                                        {
                                                            if (!act.IsVisible) continue;

                                                            <div class="umr-action-chip @(act.IsSelected ? "is-checked" : "")"
                                                                 @onclick="() => ToggleActionSelection(act)">
                                                                <div class="umr-action-check-wrap">
                                                                    <input type="checkbox"
                                                                           class="umr-checkbox"
                                                                           checked="@act.IsSelected"
                                                                           @onclick:stopPropagation="true"
                                                                           @onchange="() => ToggleActionSelection(act)" />
                                                                    <span class="umr-checkbox-custom"></span>
                                                                </div>
                                                                <div class="umr-action-info">
                                                                    <span class="umr-action-name" title="@act.ActionName">@act.ActionName</span>
                                                                    <span class="umr-role-id-tag">ID #@act.Role_id</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
        else if (activeTab == "branch_rights")
        {
            <!-- ══════════════════════════════════════════════════════════════
                 TAB 3: BRANCH RIGHTS WORKSPACE
            ══════════════════════════════════════════════════════════════ -->
            <div class="ubr-panel">
                <!-- Top Toggle Bar -->
                <div class="ubr-all-toggle">
                    <label class="umr-checkbox-label">
                        <input type="checkbox"
                               class="umr-checkbox"
                               checked="@isAllBranchesSelected"
                               @onchange="(e) => ToggleAllBranches((bool)(e.Value ?? false))" />
                        <span class="umr-checkbox-custom @(selectedBranchCodes.Count > 0 && !isAllBranchesSelected ? "is-indeterminate" : "")"></span>
                        <span class="umr-checkbox-text" style="font-size: 14px; font-weight: 700; color: #0f172a;">Select All Branches</span>
                    </label>
                    <div class="ubr-selected-counter">
                        <span class="ubr-counter-pill @(selectedBranchCodes.Count > 0 ? "has-selection" : "")">
                            <strong>@selectedBranchCodes.Count</strong> of <strong>@allBranches.Count</strong> branches selected
                        </span>
                        @if (selectedBranchCodes.Count == 0)
                        {
                            <span class="ubr-hint-text">(All branches accessible by default when none selected)</span>
                        }
                    </div>
                </div>

                <!-- Notice -->
                <div class="umr-tab-notice">
                    <span class="material-symbols-outlined" style="font-size: 16px; color: #4f46e5;">domain</span>
                    <span>
                        Configure which branches this user is authorized to access and switch between. When no specific branches are selected, universal access is applied.
                    </span>
                </div>

                @if (allBranches.Any())
                {
                    <div class="ubr-branches-grid">
                        @foreach (var branch in allBranches)
                        {
                            int bCode = branch.bh_code > 0 ? branch.bh_code : (branch.bhcode ?? 0);
                            var isChecked = selectedBranchCodes.Contains(bCode);
                            <div class="ubr-branch-chip @(isChecked ? "is-checked" : "")"
                                 @onclick="() => ToggleBranchRight(bCode)">
                                <div class="umr-action-check-wrap">
                                    <input type="checkbox"
                                           class="umr-checkbox"
                                           checked="@isChecked"
                                           @onclick:stopPropagation="true"
                                           @onchange="() => ToggleBranchRight(bCode)" />
                                    <span class="umr-checkbox-custom"></span>
                                </div>
                                <div class="ubr-branch-info">
                                    <div class="ubr-branch-name" title="@branch.name">@branch.name</div>
                                    @if (!string.IsNullOrWhiteSpace(branch.short_name ?? branch.shortname))
                                    {
                                        <div class="ubr-branch-short">Code: @(branch.short_name ?? branch.shortname) (#@bCode)</div>
                                    }
                                    else
                                    {
                                        <div class="ubr-branch-short">Branch ID: #@bCode</div>
                                    }
                                    <div class="ubr-branch-type-tags">
                                        @if (branch.is_main_branch == true || branch.ismainbranch == true)
                                        {
                                            <span class="ubr-tag main">Main</span>
                                        }
                                        @if (branch.is_branch == true || branch.isbranch == true)
                                        {
                                            <span class="ubr-tag branch">Branch</span>
                                        }
                                        @if (branch.is_collection_centre == true || branch.iscollectioncentre == true)
                                        {
                                            <span class="ubr-tag cc">Collection Centre</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="umr-empty-search">
                        <span class="material-symbols-outlined umr-empty-icon">store_off</span>
                        <h4>No branches found</h4>
                        <p>No branches are currently configured for this organization.</p>
                    </div>
                }
            </div>
        }

        <!-- ── Bottom Action Footer ── -->
        <div class="user-editor-footer">
            <div class="display-flex align-center gap-12">
                <button type="button" class="btn-cancel-flat" @onclick="CloseForm">
                    Cancel
                </button>
                <span style="font-size: 12px; color: #64748b;">
                    @if (activeTab == "role_rights")
                    {
                        <span>Configuring Role Rights: <strong>@userSelectedRoleIds.Count</strong> selected</span>
                    }
                    else if (activeTab == "branch_rights")
                    {
                        <span>Configuring Branch Rights: <strong>@selectedBranchCodes.Count</strong> of <strong>@allBranches.Count</strong> selected</span>
                    }
                    else
                    {
                        <span>User Profile for <strong>@(string.IsNullOrEmpty(current.name) ? "New User" : current.name)</strong></span>
                    }
                </span>
            </div>

            <div class="display-flex align-center gap-12">
                @if (isEditMode)
                {
                    @if (TenantState.HasActionRight("Configuration", "General", "Delete"))
                    {
                        <button type="button" class="btn-delete" @onclick="() => SoftDeleteUser(current.user_code)" disabled="@(current.user_code == 0 || isSaving)">
                            Delete
                        </button>
                    }
                    @if (current.is_verified != true)
                    {
                        <button type="button" class="lc-btn lc-btn-primary lc-font-13 lc-p-8-18" @onclick="() => VerifyUser(current.user_code)" disabled="@isSaving">
                            <span class="material-symbols-outlined lc-font-15 lc-vertical-middle lc-mr-4">verified_user</span>
                            Verify
                        </button>
                    }
                }
                <button type="button" class="btn-save" @onclick="SaveUser" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="material-symbols-outlined lc-font-16 lc-animate-spin lc-mr-6">autorenew</span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="lc-mr-8">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11Z" />
                        </svg>
                        <span>@(isSaving ? "Saving..." : (isEditMode ? "Save Changes" : "Create User"))</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

