    private void OnSearchPermissionChanged()
    {
        if (string.IsNullOrWhiteSpace(permissionSearchQuery))
        {
            ClearPermissionSearch();
            return;
        }

        var q = permissionSearchQuery.Trim().ToLowerInvariant();

        foreach (var mod in hierarchyTree)
        {
            var modMatches = mod.ModuleName.ToLowerInvariant().Contains(q);
            var anySubMatches = false;

            foreach (var sub in mod.SubModules)
            {
                var subMatches = sub.SubModuleName.ToLowerInvariant().Contains(q);
                var anyActMatches = false;

                foreach (var act in sub.Actions)
                {
                    var actMatches = modMatches || subMatches || act.ActionName.ToLowerInvariant().Contains(q) || act.Role_id.ToString().Contains(q);
                    act.IsVisible = actMatches;
                    if (actMatches) anyActMatches = true;
                }

                sub.IsVisible = subMatches || anyActMatches;
                if (sub.IsVisible)
                {
                    anySubMatches = true;
                    sub.IsExpanded = true;
                }
            }

            mod.IsVisible = modMatches || anySubMatches;
            if (mod.IsVisible)
            {
                mod.IsExpanded = true;
            }
        }
    }

    private void ClearPermissionSearch()
    {
        permissionSearchQuery = string.Empty;
        foreach (var mod in hierarchyTree)
        {
            mod.IsVisible = true;
            foreach (var sub in mod.SubModules)
            {
                sub.IsVisible = true;
                foreach (var act in sub.Actions)
                {
                    act.IsVisible = true;
                }
            }
        }
    }

