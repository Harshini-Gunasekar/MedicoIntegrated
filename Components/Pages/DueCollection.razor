                var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.CustomerWithOpModel>>(rawJson, settings) ?? new();
                searchedPatients = list.Take(10).ToList();
                showPatientDropdown = searchedPatients.Count > 0;
