    private async Task SearchPatientAdvance()
    {
        if (string.IsNullOrWhiteSpace(advanceSearchText))
        {
            ToastService.ShowError("Please enter a Patient ID or Name to search.");
            return;
        }

        // Numeric input → treat as patient ID directly
        if (decimal.TryParse(advanceSearchText.Trim(), out var parsedId))
        {
            advancePatientId = parsedId;
        }
        else
        {
            // Name input → resolve custid via history/filter search
            advancePatientId = null;
            loadingAdvance = true;
            StateHasChanged();
            try
            {
                // Use due-bills endpoint which supports patient name/ID/mobile search
                var billsRes = await DueCollectionService.GetDueBillsResponseAsync(new HmsAllDueFilterRequest
                {
                    search = advanceSearchText.Trim(),
                    page = 1,
                    pagesize = 100
                });
                
                var billMatch = billsRes?.data?.FirstOrDefault(r => 
                    r.custid.HasValue && 
                    (r.patient_name != null && r.patient_name.Contains(advanceSearchText.Trim(), StringComparison.OrdinalIgnoreCase)));
                
                if (billMatch == null && billsRes?.data != null)
                {
                    billMatch = billsRes.data.FirstOrDefault(r => r.custid.HasValue);
                }

                if (billMatch != null)
                {
                    advancePatientId = billMatch.custid;
                }
                else
                {
                    // Try paid history
                    var paidRes = await DueCollectionService.GetPaidHistoryAsync(new HmsPaidHistoryFilterRequest
                    {
                        search = advanceSearchText.Trim(),
                        page = 1,
                        pagesize = 50
                    });
                    var paidMatch = paidRes?.data?.FirstOrDefault(r => 
                        r.custid.HasValue && 
                        (r.patient_name != null && r.patient_name.Contains(advanceSearchText.Trim(), StringComparison.OrdinalIgnoreCase)));
                    
                    if (paidMatch == null && paidRes?.data != null)
                    {
                        paidMatch = paidRes.data.FirstOrDefault(r => r.custid.HasValue);
                    }

                    if (paidMatch?.custid != null)
                    {
                        advancePatientId = (decimal)paidMatch.custid.Value;
                    }
                    else
                    {
                        // Fallback: try history/filter search
                        var histRes = await DueCollectionService.GetDueHistoryResponseAsync(new HmsDueCollectionFilterRequest
                        {
                            search = advanceSearchText.Trim(),
                            page = 1,
                            pagesize = 50
                        });
                        var histMatch = histRes?.data?.FirstOrDefault(r => 
                            (r.custid.HasValue || r.patient_id.HasValue) &&
                            (r.patient_name != null && r.patient_name.Contains(advanceSearchText.Trim(), StringComparison.OrdinalIgnoreCase)));

                        if (histMatch == null && histRes?.data != null)
                        {
                            histMatch = histRes.data.FirstOrDefault(r => r.custid.HasValue || r.patient_id.HasValue);
                        }

                        if (histMatch != null)
                        {
                            advancePatientId = histMatch.custid ?? (histMatch.patient_id.HasValue ? (decimal)histMatch.patient_id.Value : (decimal?)null);
                        }
                        else
                        {
                            // Try list endpoint as well
                            var listRes = await DueCollectionService.GetUnfilteredDueHistoryResponseAsync(new HmsDueCollectionFilterRequest
                            {
                                search = advanceSearchText.Trim(),
                                page = 1,
                                pagesize = 50
                            });
                            var listMatch = listRes?.data?.FirstOrDefault(r => 
                                (r.custid.HasValue || r.patient_id.HasValue) &&
                                (r.patient_name != null && r.patient_name.Contains(advanceSearchText.Trim(), StringComparison.OrdinalIgnoreCase)));

                            if (listMatch == null && listRes?.data != null)
                            {
                                listMatch = listRes.data.FirstOrDefault(r => r.custid.HasValue || r.patient_id.HasValue);
                            }

                            if (listMatch != null)
                            {
                                advancePatientId = listMatch.custid ?? (listMatch.patient_id.HasValue ? (decimal)listMatch.patient_id.Value : (decimal?)null);
                            }
                        }
                    }
                }

                if (advancePatientId == null)
                {
                    // Final fallback: fetch all due bills and search locally
                    var allDue = await DueCollectionService.GetDueBillsAsync(new HmsAllDueFilterRequest
                    {
                        page = 1,
                        pagesize = 1000
                    });
                    var localMatch = allDue.FirstOrDefault(r => 
                        r.custid.HasValue && 
                        (r.patient_name != null && r.patient_name.Contains(advanceSearchText.Trim(), StringComparison.OrdinalIgnoreCase)));
                    if (localMatch != null)
                    {
                        advancePatientId = localMatch.custid;
                    }
                }

                if (advancePatientId == null)
                {
                    ToastService.ShowError($"No patient found matching '{advanceSearchText}'.");
                    loadingAdvance = false;
                    StateHasChanged();
                    return;
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Search failed: {ex.Message}");
                loadingAdvance = false;
                StateHasChanged();
                return;
            }
        }

        showDepositRefund = true;
        showTransactionHistory = false;
        await LoadPatientAdvance();
    }

    private async Task FetchAdvanceSummaryHistory()
    {
        if (advancePatientId == null)
        {
            ToastService.ShowError("Please search for a patient first.");
            return;
        }
        showDepositRefund = true;
        showTransactionHistory = true;

        // If we already have the summary loaded, only load the ledger table
        if (advanceSummary != null)
        {
            await LoadLedgerOnly();
        }
        else
        {
            await LoadPatientAdvance();
        }
    }

    private async Task LoadLedgerOnly()
    {
        if (advancePatientId == null || advanceSummary == null) return;

        // Refresh advance summary without full page spinner
        try
        {
            var freshSummary = await DueCollectionService.GetPatientAdvanceSummaryAsync(advancePatientId.Value);
            if (freshSummary != null)
            {
                advanceSummary = freshSummary;
            }
        }
        catch { /* keep existing summary */ }

        if (advanceSummary.ledger == null || advanceSummary.ledger.Count == 0)
        {
            StateHasChanged();
            return;
        }

        resolvedTransactionTypes.Clear();
        resolvedCustomerNames.Clear();
        resolvedDoctorNames.Clear();
        resolvedBillNos.Clear();

        loadingLedger = true;
        StateHasChanged();

        try
        {
            var usedRows = advanceSummary.ledger.Where(r => (r.transaction_type ?? "USED").ToUpperInvariant() == "USED").ToList();
            bool hasUsedRows = usedRows.Count > 0;
            HashSet<string> actualBillGuids = new(StringComparer.OrdinalIgnoreCase);
            Dictionary<string, HmsPaidHistoryRow> paidHistoryByGuid = new(StringComparer.OrdinalIgnoreCase);

            if (hasUsedRows)
            {
                var paidReq = new HmsPaidHistoryFilterRequest
                {
                    custid = advancePatientId,
                    page = 1,
                    pagesize = 100
                };
                var paidRes = await DueCollectionService.GetPaidHistoryAsync(paidReq);
                if (paidRes?.data != null)
                {
                    foreach (var r in paidRes.data)
                    {
                        if (!string.IsNullOrEmpty(r.bill_guid))
                        {
                            actualBillGuids.Add(r.bill_guid);
                        }
                        if (!string.IsNullOrEmpty(r.receipt_no))
                        {
                            paidHistoryByGuid[r.receipt_no] = r;
                        }
                    }
                }
            }

            foreach (var row in advanceSummary.ledger)
            {
                var rawType = (row.transaction_type ?? "USED").ToUpperInvariant();
                if (rawType == "DEPOSIT")
                {
                    resolvedTransactionTypes[row] = "DEPOSIT";
                    resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                    resolvedDoctorNames[row] = "-";
                    resolvedBillNos[row] = "-";
                }
                else if (rawType == "USED")
                {
                    if (!string.IsNullOrEmpty(row.requestguid) && actualBillGuids.Contains(row.requestguid))
                    {
                        resolvedTransactionTypes[row] = "USED";
                        if (paidHistoryByGuid.TryGetValue(row.receiptsnoprint ?? "", out var ph))
                        {
                            resolvedCustomerNames[row] = ph.patient_name ?? advanceSummary.patient_name ?? "";
                            resolvedDoctorNames[row] = ph.doctor_name ?? "-";
                            resolvedBillNos[row] = ph.bill_no ?? "-";
                        }
                        else
                        {
                            resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                            resolvedDoctorNames[row] = "-";
                            resolvedBillNos[row] = "-";
                        }
                    }
                    else
                    {
                        resolvedTransactionTypes[row] = "REFUNDED";
                        resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                        resolvedDoctorNames[row] = "-";
                        resolvedBillNos[row] = "-";
                    }
                }
                else
                {
                    bool isRefund = rawType == "REFUND" || rawType == "REFUNDED";
                    resolvedTransactionTypes[row] = isRefund ? "REFUNDED" : rawType;
                    resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                    resolvedDoctorNames[row] = "-";
                    resolvedBillNos[row] = "-";
                }
            }
        }
        finally
        {
            loadingLedger = false;
            StateHasChanged();
        }
    }

    private async Task LoadPatientAdvance()
    {
        if (advancePatientId == null)
        {
            ToastService.ShowError("Please search for a patient first.");
            return;
        }

        loadingAdvance = true;
        StateHasChanged();
        try
        {
            advanceSummary = await DueCollectionService.GetPatientAdvanceSummaryAsync(advancePatientId.Value);
            if (advanceSummary == null)
            {
                ToastService.ShowError("No patient record or advance summary found for the given Patient ID.");
                loadingAdvance = false;
                StateHasChanged();
                return;
            }

            resolvedTransactionTypes.Clear();
            resolvedCustomerNames.Clear();
            resolvedDoctorNames.Clear();
            resolvedBillNos.Clear();

            // First stage: render the summary cards and forms instantly
            loadingAdvance = false;
            StateHasChanged();

            // Second stage: load and resolve ledger details
            if (showTransactionHistory && advanceSummary.ledger != null && advanceSummary.ledger.Count > 0)
            {
                loadingLedger = true;
                StateHasChanged();

                try
                {
                    // Fetch paid history to see actual bill payment usages of advance.
                    // This avoids calling the extremely slow due history 'list' endpoint.
                    var usedRows = advanceSummary.ledger.Where(r => (r.transaction_type ?? "USED").ToUpperInvariant() == "USED").ToList();
                    bool hasUsedRows = usedRows.Count > 0;
                    HashSet<string> actualBillGuids = new(StringComparer.OrdinalIgnoreCase);
                    Dictionary<string, HmsPaidHistoryRow> paidHistoryByGuid = new(StringComparer.OrdinalIgnoreCase);

                    if (hasUsedRows)
                    {
                        var paidReq = new HmsPaidHistoryFilterRequest
                        {
                            custid = advancePatientId,
                            page = 1,
                            pagesize = 100
                        };
                        var paidRes = await DueCollectionService.GetPaidHistoryAsync(paidReq);
                        if (paidRes?.data != null)
                        {
                            foreach (var r in paidRes.data)
                            {
                                if (!string.IsNullOrEmpty(r.bill_guid))
                                {
                                    actualBillGuids.Add(r.bill_guid);
                                }
                                if (!string.IsNullOrEmpty(r.receipt_no))
                                {
                                    paidHistoryByGuid[r.receipt_no] = r;
                                }
                            }
                        }
                    }

                    // Resolve exact transaction types and fetch details
                    foreach (var row in advanceSummary.ledger)
                    {
                        var rawType = (row.transaction_type ?? "USED").ToUpperInvariant();
                        if (rawType == "DEPOSIT")
                        {
                            resolvedTransactionTypes[row] = "DEPOSIT";
                            resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                            resolvedDoctorNames[row] = "-";
                            resolvedBillNos[row] = "-";
                        }
                        else if (rawType == "USED")
                        {
                            // If the row's requestguid matches an actual bill guid from paid history, it is a bill usage (USED)
                            // Otherwise, if there is no matching bill receipt, it was a REFUND
                            if (!string.IsNullOrEmpty(row.requestguid) && actualBillGuids.Contains(row.requestguid))
                            {
                                resolvedTransactionTypes[row] = "USED";
                                if (paidHistoryByGuid.TryGetValue(row.receiptsnoprint ?? "", out var ph))
                                {
                                    resolvedCustomerNames[row] = ph.patient_name ?? advanceSummary.patient_name ?? "";
                                    resolvedDoctorNames[row] = ph.doctor_name ?? "-";
                                    resolvedBillNos[row] = ph.bill_no ?? "-";
                                }
                                else
                                {
                                    resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                                    resolvedDoctorNames[row] = "-";
                                    resolvedBillNos[row] = "-";
                                }
                            }
                            else
                            {
                                resolvedTransactionTypes[row] = "REFUNDED";
                                resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                                resolvedDoctorNames[row] = "-";
                                resolvedBillNos[row] = "-";
                            }
                        }
                        else
                        {
                            bool isRefund = rawType == "REFUND" || rawType == "REFUNDED";
                            resolvedTransactionTypes[row] = isRefund ? "REFUNDED" : rawType;
                            resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                            resolvedDoctorNames[row] = "-";
                            resolvedBillNos[row] = "-";
                        }
                    }
                }
                finally
                {
                    loadingLedger = false;
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load advance summary: {ex.Message}");
            loadingAdvance = false;
            StateHasChanged();
        }
    }

    private async Task DepositAdvance()
    {
        if (advanceSummary == null || depositAmount <= 0) return;
        actionRunning = true;
        StateHasChanged();

        try
        {
            var req = new HmsAdvanceDepositRequest
            {
                custid = advanceSummary.custid,
                patient_name = advanceSummary.patient_name,
                amount = depositAmount,
                collection_type = depositPayMode,
                remarks = depositRemarks,
                usercode = UserCode,
                cntcode = CounterCodeVal,
                enteredbhcode = BranchCodeVal
            };
            
            var res = await DueCollectionService.DepositAdvanceAsync(req);
            if (res != null)
            {
                ToastService.ShowSuccess($"Deposited ₹ {depositAmount:N2} advance successfully.");
                depositAmount = 0;
                depositRemarks = string.Empty;
                await LoadPatientAdvance();
            }
            else
            {
                ToastService.ShowError("Failed to deposit advance. Verify connection details.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            actionRunning = false;
            StateHasChanged();
        }
    }

    private async Task RefundAdvance()
    {
        if (advanceSummary == null || refundAmount <= 0) return;
        actionRunning = true;
        StateHasChanged();

        try
        {
            var req = new HmsAdvanceRefundRequest
            {
                custid = advanceSummary.custid,
                refund_amount = refundAmount,
                remarks = refundRemarks,
                usercode = UserCode,
                cntcode = CounterCodeVal,
                enteredbhcode = BranchCodeVal
            };

            var res = await DueCollectionService.RefundAdvanceAsync(req);
            if (res != null)
            {
                ToastService.ShowSuccess($"Refunded ₹ {refundAmount:N2} successfully.");
                refundAmount = 0;
                refundRemarks = string.Empty;
                await LoadPatientAdvance();
            }
            else
            {
                ToastService.ShowError("Failed to refund advance.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            actionRunning = false;
            StateHasChanged();
        }
    }

    private string GetTransactionType(HmsAdvanceLedgerRow row)
    {
        if (resolvedTransactionTypes.TryGetValue(row, out var resolvedType))
        {
            return resolvedType;
        }
        return row.transaction_type ?? "USED";
    }
