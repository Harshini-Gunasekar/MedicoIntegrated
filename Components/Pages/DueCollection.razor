    // --- Tab 1: Collect Dues ---
    private async Task LoadDueBills()
    {
        loadingBills = true;
        StateHasChanged();
        try
        {
            int? parsedBranch = null;
            if (int.TryParse(filterBranch, out var b)) parsedBranch = b;
            
            int? parsedCounter = null;
            if (int.TryParse(filterCounter, out var c)) parsedCounter = c;

            decimal? parsedCustId = null;
            if (filterType != "referral" && filterType != "monthly")
            {
                if (decimal.TryParse(filterPatient, out var cust)) parsedCustId = cust;
            }

            int? parsedDcode = null;
            string? searchVal = searchQuery;

            if (filterType == "referral")
            {
                if (int.TryParse(filterDoctor, out var dc)) parsedDcode = dc;
            }
            else if (filterType == "monthly")
            {
                searchVal = filterCompany;
            }
            else
            {
                searchVal = string.IsNullOrEmpty(filterPatient) ? searchQuery : filterPatient;
            }

            var filter = new HmsAllDueFilterRequest
            {
                search = searchVal,
                bhcode = parsedBranch,
                cntcode = parsedCounter,
                custid = parsedCustId,
                dcode = parsedDcode,
                fromdate = filterFromDate,
                todate = filterToDate,
                min_due = 1,
                page = currentPage,
                pagesize = pageSize
            };
            
            
            var res = await DueCollectionService.GetDueBillsResponseAsync(filter);
            if (res != null)
            {
                dueBills = res.data ?? new();
                totalBillsCount = res.totalCount;
                dueBillsSummary = res.summary;

                if (dueBillsSummary == null)
                {
                    dueBillsSummary = new HmsAllDueSummary
                    {
                        total_bills = totalBillsCount
                    };
                }

                if (totalBillsCount <= pageSize)
                {
                    dueBillsSummary.total_due = dueBills.Sum(b => b.due_amount);
                }
                else
                {
                    var summaryFilter = new HmsAllDueFilterRequest
                    {
                        search = filter.search,
                        bhcode = filter.bhcode,
                        cntcode = filter.cntcode,
                        custid = filter.custid,
                        fromdate = filter.fromdate,
                        todate = filter.todate,
                        min_due = 1,
                        page = 1,
                        pagesize = 10000
                    };
                    var summaryRes = await DueCollectionService.GetDueBillsResponseAsync(summaryFilter);
                    if (summaryRes?.data != null)
                    {
                        dueBillsSummary.total_due = summaryRes.data.Sum(b => b.due_amount);
                    }
                }
            }
            else
            {
                dueBills = new();
                totalBillsCount = 0;
                dueBillsSummary = null;
            }
            
            // Re-sync selection dictionary to remove any bills that are no longer in the list
            var currentGuids = dueBills.Select(b => b.requestguid).ToHashSet();
            var keysToRemove = selectedBills.Keys.Where(k => !currentGuids.Contains(k)).ToList();
            foreach (var key in keysToRemove)
            {
                selectedBills.Remove(key);
                previewResponses.Remove(key);
                collectedAmounts.Remove(key);
            }

            // Auto-select and auto-allocate advance if available
            decimal? filteredCustId = null;
            if (!string.IsNullOrWhiteSpace(filterPatient) && decimal.TryParse(filterPatient.Trim(), out var fId))
            {
                filteredCustId = fId;
            }

            double advanceAvail = 0;
            if (filteredCustId.HasValue && dueBills.Count > 0)
            {
                var matchingBills = dueBills.Where(b => b.custid == filteredCustId.Value).ToList();
                if (matchingBills.Count > 0)
                {
                    advanceAvail = matchingBills.Max(b => b.advance_available);
                }
            }

            if (advanceAvail > 0 && filteredCustId.HasValue)
            {
                payMode = "ADVANCE";
                selectedBills.Clear();
                previewResponses.Clear();
                collectedAmounts.Clear();

                double remainingAdvance = advanceAvail;
                foreach (var bill in dueBills.Where(b => b.custid == filteredCustId.Value))
                {
                    if (remainingAdvance <= 0) break;

                    var guid = bill.requestguid ?? "";
                    double due = bill.due_amount;
                    double useAmount = Math.Min(due, remainingAdvance);

                    // Add to selection
                    var req = new HmsDueCollectionRequest
                    {
                        requestguid     = guid,
                        collection_type = "ADVANCE",
                        cash_collected  = 0,
                        advance_to_use  = useAmount,
                        usercode        = 10,
                        cntcode         = 1,
                        enteredbhcode   = bill.enteredbhcode ?? 1
                    };
                    selectedBills[guid] = req;

                    // Put in collectedAmounts to show in the collected input box
                    collectedAmounts[guid] = useAmount;

                    // Add preview response
                    var preview = new HmsDuePreviewResponse
                    {
                        requestguid = guid,
                        bill_no = bill.bill_no,
                        bill_date = bill.bill_date,
                        bill_type = bill.bill_type,
                        custid = bill.custid,
                        patient_name = bill.patient_name,
                        mobileno = bill.mobileno,
                        opvisitid = bill.opvisitid,
                        doctor_name = bill.doctor_name,
                        dcode = bill.dcode,
                        total_bill_amount = bill.total_bill_amount,
                        previous_paid = bill.paid_amount,
                        current_due = due,
                        advance_available = remainingAdvance,
                        advance_to_use = useAmount,
                        amount_to_collect = 0,
                        due_after = Math.Max(0, due - useAmount)
                    };
                    previewResponses[guid] = preview;

                    remainingAdvance -= useAmount;
                }

                advanceAmountToUse = selectedBills.Values.Sum(b => b.advance_to_use);
                
                // Allow Blazor to render first, then update DOM inputs
                _ = Task.Delay(100).ContinueWith(async _ => 
                {
                    await InvokeAsync(async () => 
                    {
                        await ApplyCollectedAmountsToDOM();
                        StateHasChanged();
                    });
                });
            }
            else if (payMode == "ADVANCE")
            {
                payMode = "";
                selectedBills.Clear();
                previewResponses.Clear();
                collectedAmounts.Clear();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load bills: {ex.Message}");
        }
        finally
        {
            loadingBills = false;
            StateHasChanged();
        }
    }

