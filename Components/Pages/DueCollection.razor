    private async Task OnPayModeChanged()
    {
        if (payMode == "ADVANCE")
        {
            var selectedGuids = selectedBills.Keys.ToHashSet();
            advanceAmountToUse = Math.Min(TotalAdvanceAvailable, dueBills.Where(b => b.requestguid != null && selectedGuids.Contains(b.requestguid)).Sum(b => b.due_amount));
            AllocateAdvanceAmount();
        }
        else
        {
            advanceAmountToUse = 0;
        }
    }

    private void OnAdvanceAmountToUseChanged()
    {
        AllocateAdvanceAmount();
    }

    private void AllocateAdvanceAmount()
    {
        if (selectedBills.Count == 0) return;

        double remaining = advanceAmountToUse;

        foreach (var bill in dueBills)
        {
            var guid = bill.requestguid ?? "";
            if (!selectedBills.TryGetValue(guid, out var req)) continue;

            previewResponses.TryGetValue(guid, out var p);

            double billCap = Math.Max(0, bill.due_amount);

            double allocate;
            if (remaining <= 0)
            {
                allocate = 0;
            }
            else if (remaining >= billCap)
            {
                allocate = billCap;
                remaining -= billCap;
            }
            else
            {
                allocate = remaining;
                remaining = 0;
            }

            req.advance_to_use = allocate;
            req.cash_collected = 0;

            if (p != null)
            {
                p.advance_to_use = allocate;
                p.amount_to_collect = 0;
                p.due_after = Math.Max(0, p.current_due - allocate);
            }
        }
        StateHasChanged();
    }

