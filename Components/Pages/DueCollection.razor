    private async Task AddBillToSelection(HmsAllDueBillRow bill)
    {
        var guid = bill.requestguid ?? "";
        var req = new HmsDueCollectionRequest
        {
            requestguid     = guid,
            collection_type = payMode,
            cash_collected  = bill.due_amount,
            advance_to_use  = 0,
            usercode        = UserCode,
            cntcode         = CounterCodeVal,
            enteredbhcode   = bill.enteredbhcode ?? BranchCodeVal
        };
        selectedBills[guid] = req;
        // NOTE: do NOT write collectedAmounts here.
        // AutoAllocateAmount writes it once with the final allocated value,
        // preventing any intermediate render from showing a stale/zero value.

        var preview = await DueCollectionService.PreviewAdvanceAsync(guid, 0);
        if (preview != null)
        {
            preview.current_due = bill.due_amount;
            preview.due_after = Math.Max(0, preview.current_due - preview.advance_to_use - preview.amount_to_collect);
            previewResponses[guid] = preview;
            req.advance_to_use  = preview.advance_to_use;
            req.cash_collected  = preview.amount_to_collect;
            // collectedAmounts intentionally NOT updated here
        }
    }

    private double GetCollectedAmount(HmsAllDueBillRow bill)
    {
