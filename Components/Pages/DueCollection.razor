@page "/due-collection"
@rendermode InteractiveServer
@using medico_backend.Model
@using Medico_Backend.Model
@using Newtonsoft.Json
@using Booking.Models
@inject HmsDueCollectionService DueCollectionService
@inject Booking.Services.CounterMasterService CounterService
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.ReimbursementCompanyMasterService CompanyService
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject IHttpClientFactory ClientFactory
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<div class="due-collection-wrapper">
    <style>
        .btn-primary-custom {
            background: #6366f1 !important;
            color: #ffffff !important;
            border: none !important;
            border-radius: 6px !important;
            font-weight: 700 !important;
            box-shadow: 0 4px 6px -1px rgba(99, 102, 241, 0.2);
        }
        .btn-primary-custom:hover:not(:disabled) {
            background: #4f46e5 !important;
        }
        .btn-primary-custom:disabled {
            background: #a5b4fc !important;
            color: #ffffff !important;
            cursor: not-allowed;
            box-shadow: none;
        }
        .advance-content-layout {
            display: flex !important;
            gap: 1.5rem !important;
            margin-top: 1.5rem !important;
            align-items: flex-start !important;
        }
        .toggle-pill-btn {
            background: transparent !important;
            border: 1px solid transparent !important;
            padding: 0.5rem 1.5rem !important;
            border-radius: 30px !important;
            font-size: 0.85rem !important;
            font-weight: 700 !important;
            color: #64748b !important;
            cursor: pointer !important;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 0.4rem !important;
        }
        .toggle-pill-btn:hover:not(.active) {
            background: #e2e8f0 !important;
            color: #334155 !important;
        }
        .toggle-pill-btn.active.deposit-tab {
            background: linear-gradient(135deg, #10b981, #059669) !important;
            color: #ffffff !important;
            border: 1px solid transparent !important;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25) !important;
        }
        .toggle-pill-btn.active.refund-tab {
            background: linear-gradient(135deg, #ef4444, #dc2626) !important;
            color: #ffffff !important;
            border: 1px solid transparent !important;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25) !important;
        }
        .btn-fetch-ledger {
            background: #f0f6ff !important;
            color: #2563eb !important;
            border: 2px dashed #bfdbfe !important;
            border-radius: 8px !important;
            font-weight: 700 !important;
            font-size: 0.9rem !important;
            padding: 0.65rem 1.75rem !important;
            box-shadow: none !important;
            transition: all 0.2s ease-in-out !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer !important;
            gap: 0.5rem !important;
        }
        .btn-fetch-ledger:hover:not(:disabled) {
            background: #dbeafe !important;
            border-color: #3b82f6 !important;
            color: #1d4ed8 !important;
            transform: translateY(-1px) !important;
        }
        .btn-fetch-ledger:active:not(:disabled) {
            transform: translateY(0px) !important;
        }
        .btn-fetch-ledger:disabled {
            background: #cbd5e1 !important;
            color: #94a3b8 !important;
            cursor: not-allowed !important;
            box-shadow: none !important;
            transform: none !important;
            border-style: solid !important;
        }
        .btn-refresh-ledger {
            background: #ffffff !important;
            border: 1px solid #e2e8f0 !important;
            color: #64748b !important;
            border-radius: 50% !important;
            width: 36px !important;
            height: 36px !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05) !important;
            cursor: pointer !important;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
        }
        .btn-refresh-ledger:hover:not(:disabled) {
            background: #eff6ff !important;
            border-color: #3b82f6 !important;
            color: #1d4ed8 !important;
            box-shadow: 0 4px 10px rgba(59, 130, 246, 0.15) !important;
        }
        .btn-refresh-ledger i {
            display: inline-block;
        }
        .btn-refresh-ledger:disabled {
            background: #f1f5f9 !important;
            color: #cbd5e1 !important;
            cursor: not-allowed !important;
            box-shadow: none !important;
        }
        .ledger-history-box {
            background: #f8fafc !important;
            border: 1px solid #e2e8f0 !important;
            border-radius: 12px !important;
            padding: 1.5rem !important;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02) !important;
            flex: 1 1 auto !important;
            min-height: 420px !important;
            display: flex !important;
            flex-direction: column !important;
        }
        .ledger-history-box .table-container {
            background: #ffffff !important;
            border: 1px solid #e2e8f0 !important;
            border-radius: 12px !important;
            overflow-x: auto !important;
            overflow-y: auto !important;
            max-height: 380px !important;
        }
        .small-ledger-table th {
            position: sticky !important;
            top: 0 !important;
            z-index: 10 !important;
            background: #f8fafc !important;
        }
        .badge-paymode.deposit {
            background: #dcfce7 !important;
            color: #16a34a !important;
            font-weight: 700 !important;
        }
        .badge-paymode.refund, 
        .badge-paymode.refunded {
            background: #fee2e2 !important;
            color: #dc2626 !important;
            font-weight: 700 !important;
        }
        .badge-paymode.used {
            background: #dbeafe !important;
            color: #2563eb !important;
            font-weight: 700 !important;
        }
        .text-success {
            color: #10b981 !important;
        }
        .text-warning, .text-danger {
            color: #ef4444 !important;
        }
        /* Autocomplete/Search Results list */
        .autocomplete-search-wrapper {
            position: relative;
            width: 100%;
        }

        .autocomplete-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            background: #ffffff;
            border: 1.5px solid #cbd5e1;
            border-radius: 8px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            max-height: 200px;
            overflow-y: auto;
            z-index: 100;
            margin-top: 4px;
        }

        .autocomplete-item {
            padding: 0.5rem 0.85rem;
            font-size: 0.8rem;
            color: #334155;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #f1f5f9;
        }

        .autocomplete-item:hover {
            background-color: #f0f9ff;
            color: #026aa7;
        }

        .autocomplete-code {
            font-weight: 700;
            color: #64748b;
            font-size: 0.72rem;
            background: #f1f5f9;
            padding: 0.15rem 0.35rem;
            border-radius: 4px;
        }
    </style>
    <!-- Top Header Card -->
    <div class="due-header-card">
        <div style="display: flex; align-items: center; gap: 1.25rem;">
            <div class="header-icon-container">
                <i class="bi bi-wallet2"></i>
            </div>
            <div class="header-text-container">
                <h1>Due Collection</h1>
                <p><span class="header-status-dot"></span> PAYMENT MANAGEMENT</p>
            </div>
        </div>
        @if (activeTab == "collect" || activeTab == "history")
        {
            <button class="btn-history-filter-trigger @(IsFilterOpen() ? "active" : "")" @onclick="ToggleActiveFilter" style="margin-left: auto; display: flex; align-items: center; gap: 0.5rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.6rem 1.2rem; font-size: 0.9rem; font-weight: 500; color: #475569; transition: all 0.2s;">
                <i class="bi bi-funnel"></i> Filter
            </button>
        }
    </div>

    <!-- Navigation Tabs -->
    <div class="due-tabs">
        <button class="tab-btn @(activeTab == "collect" ? "active" : "")" @onclick='() => SetActiveTab("collect")'>
            <i class="bi bi-cash-coin"></i> Collect Dues
        </button>
        <button class="tab-btn @(activeTab == "advance" ? "active" : "")" @onclick='() => SetActiveTab("advance")'>
            <i class="bi bi-piggy-bank"></i> Patient Advance
        </button>
        <button class="tab-btn @(activeTab == "history" ? "active" : "")" @onclick='() => SetActiveTab("history")'>
            <i class="bi bi-clock-history"></i> View History
        </button>
    </div>

    <div class="tab-content">
        @if (activeTab == "collect")
        {
            <!-- Tab 1: Collect Dues -->
            <div class="collect-tab-layout">
                <!-- Advanced Filter Card -->
                @if (showCollectFilter)
                {
                    <div class="advanced-filter-card">
                    <div class="filter-type-row">
                        <span class="type-label">TYPE</span>
                        <div class="radio-options">
                            <label class="radio-label">
                                <input type="radio" name="filterType" value="bill" checked="@(filterType == "bill")" @onchange='() => SetFilterType("bill")' />
                                <span>Bill</span>
                            </label>
                            <label class="radio-label">
                                <input type="radio" name="filterType" value="patient" checked="@(filterType == "patient")" @onchange='() => SetFilterType("patient")' />
                                <span>Patient</span>
                            </label>
                            <label class="radio-label">
                                <input type="radio" name="filterType" value="referral" checked="@(filterType == "referral")" @onchange='() => SetFilterType("referral")' />
                                <span>Referral</span>
                            </label>
                            <label class="radio-label">
                                <input type="radio" name="filterType" value="monthly" checked="@(filterType == "monthly")" @onchange='() => SetFilterType("monthly")' />
                                <span>Monthly</span>
                            </label>
                        </div>
                    </div>

                    <div class="filter-boxes-grid" style="display: flex; flex-direction: column; gap: 1rem;">
                        <!-- First Row: BRANCH, COUNTER, PATIENT -->
                        <div style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap; width: 100%;">
                            <div class="form-group-filter" style="flex: 1; min-width: 180px;">
                                <label>BRANCH</label>
                                <select class="filter-select" @bind="filterBranch" @bind:after="OnBranchChanged" style="width: 100%;">
                                    <option value="">Select the branch</option>
                                    @foreach (var b in branchesList)
                                    {
                                        <option value="@b.bh_code">@b.name</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group-filter" style="flex: 1; min-width: 180px;">
                                <label>COUNTER</label>
                                <select class="filter-select" @bind="filterCounter" style="width: 100%;">
                                    <option value="">Select Counter</option>
                                    @foreach (var c in filteredCountersList)
                                    {
                                        <option value="@c.cntcode">@c.name</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group-filter" style="flex: 1.5; min-width: 250px;">
                                @if (filterType == "referral")
                                {
                                    <label>DOCTOR</label>
                                    <select class="filter-select" @bind="filterDoctor" style="width: 100%;">
                                        <option value="">Select Doctor</option>
                                        @foreach (var doc in doctorsList)
                                        {
                                            <option value="@doc.dcode">@doc.name</option>
                                        }
                                    </select>
                                }
                                else if (filterType == "monthly")
                                {
                                    <label>COMPANY</label>
                                    <select class="filter-select" @bind="filterCompany" style="width: 100%;">
                                        <option value="">Select Company</option>
                                        @foreach (var comp in companiesList)
                                        {
                                            <option value="@comp.name">@comp.name</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <label>PATIENT</label>
                                    <div class="autocomplete-search-wrapper">
                                        <input type="text" class="filter-input" placeholder="Search Patient Name or Mobile..." 
                                               @bind="patientSearchQuery" @bind:event="oninput" @onkeyup="OnPatientSearchKeyUp" style="width: 100%;" />
                                        @if (showPatientDropdown && searchedPatients.Count > 0)
                                        {
                                            <div class="autocomplete-dropdown">
                                                @foreach (var pat in searchedPatients)
                                                {
                                                    <div class="autocomplete-item" @onclick="() => SelectCustomerPatient(pat)">
                                                        <div>
                                                            <span style="font-weight: 600; color: #0f172a;">@pat.name (CUST-@pat.custid)</span>
                                                            <div style="font-size: 0.8em; color: #64748b;">
                                                                📞 @pat.mobile | 📍 @(string.IsNullOrEmpty(pat.area) ? "No Area" : pat.area), @pat.city
                                                            </div>
                                                        </div>
                                                        <span class="autocomplete-code">@pat.custcode</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Second Row: RECEIPT NO, RECEIPT DATE, FROM, TO, TIME -->
                        <div style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap; width: 100%;">
                            <div class="form-group-filter" style="flex: 1.2; min-width: 130px;">
                                <label>RECEIPT NO</label>
                                <input type="text" class="filter-input" placeholder="Receipt No" @bind="filterReceiptNo" style="width: 100%;" />
                            </div>
                            <div class="form-group-filter" style="flex: 1; min-width: 125px;">
                                <label>RECEIPT DATE</label>
                                <input type="date" class="filter-input" @bind="filterReceiptDate" style="padding: 0.25rem 0.5rem; font-size: 0.85rem; width: 100%;" />
                            </div>
                            <div class="form-group-filter" style="flex: 1; min-width: 125px;">
                                <label>FROM</label>
                                <input type="date" class="filter-input" @bind="filterFromDate" style="padding: 0.25rem 0.5rem; font-size: 0.85rem; width: 100%;" />
                            </div>
                            <div class="form-group-filter" style="flex: 1; min-width: 125px;">
                                <label>TO</label>
                                <input type="date" class="filter-input" @bind="filterToDate" style="padding: 0.25rem 0.5rem; font-size: 0.85rem; width: 100%;" />
                            </div>
                            <div class="form-group-filter" style="flex: 0.8; min-width: 95px;">
                                <label>TIME</label>
                                <input type="time" class="filter-input" @bind="filterTime" style="padding: 0.25rem 0.5rem; font-size: 0.85rem; width: 100%;" />
                            </div>
                        </div>

                        <!-- Third Row: PAY MODE, TXN REF NO, AMOUNT, Auto select, Reset, Search -->
                        <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; width: 100%; margin-top: 0.5rem;">
                            <!-- Left side: Payment Fields -->
                            <div style="display: flex; gap: 0.75rem; align-items: flex-end; flex-wrap: wrap;">
                                <div class="form-group-filter" style="width: 125px;">
                                    <label>PAY MODE</label>
                                    <select class="filter-select" @bind="payMode" @bind:after="OnPayModeChanged" style="padding: 0.25rem 0.5rem; font-size: 0.85rem; width: 100%;">
                                        <option value="">Select</option>
                                        <option value="CASH">CASH</option>
                                        <option value="CARD">CARD</option>
                                        <option value="GPAY">GPAY</option>
                                        <option value="UPI">UPI</option>
                                        @if ((filterType == "patient" || filterType == "bill") && !string.IsNullOrWhiteSpace(filterPatient) && decimal.TryParse(filterPatient.Trim(), out _))
                                        {
                                            <option value="ADVANCE">ADVANCE</option>
                                        }
                                    </select>
                                </div>

                                @if (payMode == "ADVANCE")
                                {
                                    <div class="form-group-filter" style="width: 150px;">
                                        <label class="@(TotalAdvanceAvailable > 0 ? "flicker-effect" : "")" style="white-space: nowrap; font-size: 0.65rem;">ADVANCE BAL: @TotalAdvanceAvailable.ToString("N2")</label>
                                        <input type="number" step="any" class="filter-input @(TotalAdvanceAvailable > 0 ? "flicker-effect" : "")" placeholder="0.00" style="padding: 0.25rem 0.5rem; font-size: 0.85rem; width: 100%;"
                                               @bind="advanceAmountToUse"
                                               @bind:event="oninput"
                                               @onchange="OnAdvanceAmountToUseChanged" />
                                    </div>
                                }

                                @if (payMode == "CARD" || payMode == "GPAY" || payMode == "UPI")
                                {
                                    <div class="form-group-filter" style="width: 180px;">
                                        <label>TXN REF NO</label>
                                        <input type="text" class="filter-input" placeholder="Ref No..." style="padding: 0.25rem 0.5rem; font-size: 0.85rem; width: 100%;" @bind="txnReferenceNo" />
                                    </div>
                                }

                                <div class="form-group-filter" style="width: 250px;">
                                    <label>AMOUNT</label>
                                    <div class="amount-field-container" style="display: flex; align-items: center; gap: 0.4rem;">
                                         <input type="number" step="any" class="filter-input" placeholder="0" style="flex-grow: 1; padding: 0.25rem 0.5rem; font-size: 0.85rem;"
                                                @bind="totalAmountToAllocate"
                                                @bind:event="oninput" />
                                         <button class="btn-link" @onclick="() => AutoAllocateAmount(true)" style="white-space: nowrap; font-size: 0.85rem;" disabled="@(!isPatientSearched || string.IsNullOrWhiteSpace(filterPatient) || string.IsNullOrEmpty(payMode) || totalAmountToAllocate == null || totalAmountToAllocate <= 0)">Auto select</button>
                                     </div>
                                </div>
                            </div>

                            <!-- Right side: Actions -->
                            <div style="display: flex; gap: 0.75rem; align-items: flex-end;">
                                <button class="btn-reset-filters" @onclick="ResetFilters">
                                    <i class="bi bi-x-circle"></i> Reset
                                </button>
                                <button class="btn-search-blue" @onclick="SearchDueBills">
                                    <i class="bi bi-search"></i> Search
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                }

                <!-- Filters & Header Row -->
                <div class="controls-card">
                    <div class="controls-right" style="width: 100%; justify-content: flex-end; align-items: flex-end; gap: 1.5rem;">
                        <div class="control-group search-group" style="width: 250px;">
                            <label>REFERENCE / SEARCH</label>
                            <div class="search-input-wrapper">
                                <i class="bi bi-search"></i>
                                <input type="text" class="control-input" placeholder="Search invoice or vendor..." @bind="searchQuery" @onkeyup="OnSearchKeyUp" />
                                @if (!string.IsNullOrEmpty(searchQuery))
                                {
                                    <button class="clear-search-btn" @onclick="ClearSearch">×</button>
                                }
                            </div>
                        </div>

                        <div class="control-actions">
                            <button class="btn-save" @onclick="SaveCollections" disabled="@(selectedBills.Count == 0 || saving)">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <i class="bi bi-save"></i>
                                }
                                Save
                            </button>
                        </div>
                    </div>
                </div>



                <!-- Bills Table -->
                <div class="table-container shadow-sm">
                    <table class="due-table">
                        <thead>
                            <tr>
                                <th class="col-check">
                                    <input type="checkbox" checked="@IsAllSelected()" @onchange="ToggleSelectAll" />
                                </th>
                                <th class="col-sample-id">SAMPLE ID</th>
                                <th class="col-datetime">DATE/TIME</th>
                                <th class="col-patient-id">PATIENT ID</th>
                                <th class="col-customer-name">CUSTOMER NAME</th>
                                <th class="col-referred">REFERRED BY</th>
                                <th class="col-balance text-end">TOTAL AMOUNT</th>
                                <th class="col-curr-bal text-end">BALANCE</th>
                                <th class="col-collected text-center">COLLECTED</th>
                                <th class="col-concession text-center">CONCESSION</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (loadingBills)
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-5">
                                        <div class="spinner-border text-primary" role="status"></div>
                                        <div class="mt-2 text-muted">Loading pending due bills...</div>
                                    </td>
                                </tr>
                            }
                            else if (dueBills.Count == 0)
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-5 text-muted">
                                        <i class="bi bi-file-earmark-check font-xxl"></i>
                                        <div class="mt-2">No pending due bills found.</div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var bill in dueBills)
                                {
                                    var guid = bill.requestguid ?? "";
                                    if (!collectedAmounts.ContainsKey(guid)) collectedAmounts[guid] = null;
                                    if (!concessionAmounts.ContainsKey(guid)) concessionAmounts[guid] = null;
                                    var isSelected = selectedBills.ContainsKey(guid);
                                    var collectedVal = GetCollectedAmount(bill);
                                    var concessionVal = GetConcessionAmount(bill);
                                    <tr class="@(isSelected ? "row-selected" : "")">
                                        <td class="col-check">
                                            <input type="checkbox" checked="@isSelected" @onchange="() => ToggleSelectBill(bill)" />
                                        </td>
                                        <td class="col-sample-id font-mono">
                                            <span class="text-primary font-bold">@bill.bill_no</span>
                                        </td>
                                        <td class="col-datetime font-sm text-muted">
                                            @(bill.bill_date?.ToString("dd-MMM-yyyy HH:mm") ?? "-")
                                        </td>
                                        <td class="col-patient-id font-mono font-sm">
                                            @bill.custid
                                        </td>
                                        <td class="col-customer-name font-bold text-dark">
                                            @bill.patient_name
                                        </td>
                                        <td class="col-referred text-muted">
                                            @bill.doctor_name
                                        </td>
                                        <td class="col-balance text-end font-bold">
                                            @bill.total_bill_amount.ToString("N2")
                                        </td>
                                        <td class="col-curr-bal text-end font-bold text-danger">
                                            @if (previewResponses.TryGetValue(guid, out var p))
                                            {
                                                @p.due_after.ToString("N2")
                                            }
                                            else
                                            {
                                                @bill.due_amount.ToString("N2")
                                            }
                                        </td>
                                        <td class="col-collected">
                                            <input id="@($"collected_{guid}")"
                                                   type="number" step="any" class="row-input text-end"
                                                   @bind="collectedAmounts[guid]"
                                                   @bind:event="oninput"
                                                   @bind:after="() => OnCollectedAmountChanged(guid)"
                                                   @onclick="() => EnsureBillSelected(bill)"
                                                   @onfocus="() => EnsureBillSelected(bill)" />
                                        </td>
                                        <td class="col-concession">
                                            <input id="@($"concession_{guid}")"
                                                   type="number" step="any" class="row-input text-end"
                                                   @bind="concessionAmounts[guid]"
                                                   @bind:event="oninput"
                                                   @onclick="() => EnsureBillSelected(bill)"
                                                   @onfocus="() => EnsureBillSelected(bill)" />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Controls -->
                <div class="due-pagination-container">
                    <span class="pagination-info">Showing @(Math.Min((currentPage - 1) * pageSize + 1, totalBillsCount)) to @(Math.Min(currentPage * pageSize, totalBillsCount)) of @totalBillsCount records</span>
                    <div class="pagination-buttons">
                        <button class="pag-btn" disabled="@(currentPage == 1)" @onclick="() => ChangePage(currentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNumber = i;
                            <button class="pag-btn @(currentPage == pageNumber ? "active" : "")" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                        }
                        <button class="pag-btn" disabled="@(currentPage == TotalPages || TotalPages == 0)" @onclick="() => ChangePage(currentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Summary Cards at the Bottom -->
                <div class="due-bottom-summary-grid">
                    <div class="summary-card-lg balance">
                        <div class="card-icon-bg">
                            <i class="bi bi-bank"></i>
                        </div>
                        <div class="card-info-content">
                            <span class="summary-label">TOTAL BALANCE</span>
                            <span class="summary-value">₹ @(dueBillsSummary?.total_due.ToString("N2") ?? "0.00")</span>
                        </div>
                    </div>
                    <div class="summary-card-lg count">
                        <div class="card-icon-bg">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <div class="card-info-content">
                            <span class="summary-label">BILL COUNT</span>
                            <span class="summary-value">@(dueBillsSummary?.total_bills ?? totalBillsCount)</span>
                        </div>
                    </div>
                    <div class="summary-card-lg collected">
                        <div class="card-icon-bg">
                            <i class="bi bi-cash-coin"></i>
                        </div>
                        <div class="card-info-content">
                            <span class="summary-label">COLLECTED AMT</span>
                            <span class="summary-value">₹ @TotalCollectedEntered.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="summary-card-lg concession">
                        <div class="card-icon-bg">
                            <i class="bi bi-tags"></i>
                        </div>
                        <div class="card-info-content">
                            <span class="summary-label">CONCESSION (REF)</span>
                            <span class="summary-value">₹ @TotalConcessionsEntered.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>
        }



        else if (activeTab == "advance")
        {
            <!-- Tab 4: Patient Advance Management -->
            <div class="advance-tab-layout">
                <div class="controls-card" style="justify-content: flex-end;">
                    <div class="controls-right" style="display: flex; align-items: flex-end; gap: 0.75rem; flex-wrap: nowrap;">
                        <!-- Label + Input stacked, then buttons on same row via the outer flex -->
                        <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.65rem; font-weight: 800; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; margin: 0;">PATIENT ID / NAME</label>
                            <div class="search-input-wrapper" style="min-width: 300px;">
                                <i class="bi bi-person-badge"></i>
                                <input type="text" class="control-input" style="width: 100%; height: 38px;" placeholder="Enter Patient ID or Name..." @bind="advanceSearchText" @onkeyup="@(async (e) => { if (e.Key == "Enter") await SearchPatientAdvance(); })" />
                            </div>
                        </div>
                        <button class="btn-search-blue" style="height: 38px; padding: 0 1.25rem; display: flex; align-items: center; justify-content: center; border: none; white-space: nowrap;" @onclick="SearchPatientAdvance">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                    </div>
                </div>

                @if (loadingAdvance)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div class="mt-2 text-muted">Fetching patient advance summary...</div>
                    </div>
                }
                else if (advanceSummary != null)
                {
                    <!-- Patient Summary Cards -->
                    <div class="advance-summary-container mt-3">
                        <div class="patient-info-header">
                            <div class="avatar-circle">
                                @(advanceSummary.patient_name?.FirstOrDefault().ToString().ToUpper() ?? "?")
                            </div>
                            <div>
                                <h2>@advanceSummary.patient_name</h2>
                                <p>Customer ID: <b>@advanceSummary.custid</b></p>
                            </div>
                        </div>

                        <div class="history-summary-grid mt-3">
                            <div class="summary-card-sm blue">
                                <span class="label">Total Advance Deposited</span>
                                <span class="value">₹ @advanceSummary.total_advance_deposited.ToString("N2")</span>
                            </div>
                            <div class="summary-card-sm green">
                                <span class="label">Total Advance Used</span>
                                <span class="value">₹ @((advanceSummary.total_advance_used - advanceSummary.total_advance_refunded).ToString("N2"))</span>
                            </div>
                            <div class="summary-card-sm orange">
                                <span class="label">Total Advance Refunded</span>
                                <span class="value">₹ @advanceSummary.total_advance_refunded.ToString("N2")</span>
                            </div>
                            <div class="summary-card-sm border-thick highlight-balance">
                                <span class="label">Available Balance</span>
                                <span class="value">₹ @((advanceSummary.total_advance_deposited - advanceSummary.total_advance_used).ToString("N2"))</span>
                            </div>
                        </div>

                        <div class="advance-content-layout @(showTransactionHistory ? "has-history" : "") mt-4">
                            @if (showDepositRefund)
                            {
                                <!-- Left/Center Column: Selected Action Box with Toggle above it -->
                                <div class="advance-left-column">
                                    <div class="advance-toggle-pills mb-3">
                                        <button class="toggle-pill-btn @(advanceSubTab == "deposit" ? "active deposit-tab" : "")" @onclick='() => advanceSubTab = "deposit"'>
                                            <i class="bi bi-plus-circle"></i> Deposit
                                        </button>
                                        <button class="toggle-pill-btn @(advanceSubTab == "refund" ? "active refund-tab" : "")" @onclick='() => advanceSubTab = "refund"'>
                                            <i class="bi bi-dash-circle"></i> Refund
                                        </button>
                                    </div>

                                    @if (advanceSubTab == "deposit")
                                    {
                                        <!-- Deposit Advance Box -->
                                        <div class="action-box compact-action-box deposit-theme">
                                            <h3><i class="bi bi-plus-circle"></i> Deposit New Advance</h3>
                                            <div class="form-group-custom mt-2">
                                                <label>Amount (₹)</label>
                                                <input type="number" step="any" class="control-input" placeholder="Enter amount to deposit..." @bind="depositAmount" />
                                            </div>
                                            <div class="form-group-custom mt-2">
                                                <label>Pay Mode</label>
                                                <select class="control-select" @bind="depositPayMode">
                                                    <option value="CASH">CASH</option>
                                                    <option value="CARD">CARD</option>
                                                    <option value="GPAY">GPAY</option>
                                                    <option value="UPI">UPI</option>
                                                </select>
                                            </div>
                                                                            <div class="form-group-custom mt-2">
                                                <label>Remarks / Notes</label>
                                                <textarea class="control-input" style="height: 45px; resize: none; padding-top: 0.35rem;" placeholder="e.g. advance for lab package..." @bind="depositRemarks"></textarea>
                                            </div>
                                            <div class="d-flex justify-content-center w-100 mt-3">
                                                <button class="btn btn-success-custom w-75" style="margin: 0 auto; display: block;" @onclick="DepositAdvance" disabled="@(depositAmount <= 0 || actionRunning)">
                                                    @if (actionRunning)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                                    }
                                                    Deposit Advance
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else if (advanceSubTab == "refund")
                                    {
                                        <!-- Refund Advance Box -->
                                        <div class="action-box compact-action-box refund-theme">
                                            <h3><i class="bi bi-dash-circle"></i> Refund Available Balance</h3>
                                            <div class="form-group-custom mt-2">
                                                <label>Refund Amount (₹)</label>
                                                <input type="number" step="any" class="control-input" placeholder="Max: @(advanceSummary.total_advance_deposited - advanceSummary.total_advance_used)" @bind="refundAmount" />
                                            </div>
                                            <div class="form-group-custom mt-2">
                                                <label>Remarks / Notes</label>
                                                <textarea class="control-input" style="height: 90px; resize: none; padding-top: 0.35rem;" placeholder="e.g. patient requested refund..." @bind="refundRemarks"></textarea>
                                            </div>
                                            <div class="d-flex justify-content-center w-100 mt-3">
                                                <button class="btn btn-warning-custom w-75" style="margin: 0 auto; display: block;" @onclick="RefundAdvance" disabled="@(refundAmount <= 0 || refundAmount > (advanceSummary.total_advance_deposited - advanceSummary.total_advance_used) || actionRunning)">
                                                    @if (actionRunning)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                                    }
                                                    Refund Advance
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Ledger History Table Box -->
                            <div class="action-box ledger-history-box flex-grow-1">
                                <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 0.75rem;">
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <h3 style="margin: 0 !important; font-size: 1.1rem !important; font-weight: 700 !important; color: #1e293b !important; display: flex !important; align-items: center !important; gap: 0.5rem !important;">
                                            <i class="bi bi-list-stars"></i> Transaction Ledger History
                                        </h3>
                                    </div>
                                    <div>
                                        <button class="btn-refresh-ledger" @onclick="FetchAdvanceSummaryHistory" disabled="@(advancePatientId == null)" title="Refresh Ledger">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="table-container shadow-sm mt-2">
                                    <table class="due-table small-ledger-table">
                                        <thead>
                                            <tr>
                                                <th>DATE</th>
                                                <th>RECEIPT/BILL NO</th>
                                                <th>CUSTOMER</th>
                                                <th>TYPE</th>
                                                <th class="text-end">AMOUNT</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                              @if (!showTransactionHistory)
                                              {
                                                  <tr style="height: 280px;">
                                                      <td colspan="5" class="text-center" style="vertical-align: middle;">
                                                          <button class="btn-fetch-ledger" @onclick="FetchAdvanceSummaryHistory" disabled="@(advancePatientId == null)">
                                                              <i class="bi bi-list-stars me-2"></i> Fetch Summary
                                                          </button>
                                                      </td>
                                                  </tr>
                                              }
                                              else
                                              {
                                                  if (loadingLedger)
                                                  {
                                                      <tr>
                                                          <td colspan="5" class="text-center py-4">
                                                              <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                              <span class="ms-2 text-muted">Loading ledger history...</span>
                                                          </td>
                                                      </tr>
                                                  }
                                                  else if (advanceSummary.ledger == null || advanceSummary.ledger.Count == 0)
                                                  {
                                                      <tr>
                                                          <td colspan="5" class="text-center py-4 text-muted">No ledger transactions recorded yet.</td>
                                                      </tr>
                                                  }
                                                  else
                                                  {
                                                     @foreach (var row in advanceSummary.ledger)
                                                     {
                                                         var typeDisplay = GetTransactionType(row);
                                                         resolvedCustomerNames.TryGetValue(row, out var patientName);
                                                         <tr>
                                                             <td>@(row.receiptdate?.ToString("dd-MMM-yyyy HH:mm") ?? "-")</td>
                                                             <td class="font-mono font-bold">@row.receiptsnoprint</td>
                                                             <td class="font-bold">@(patientName ?? advanceSummary.patient_name ?? "-")</td>
                                                             <td>
                                                                 <span class="badge-paymode @(typeDisplay.ToLower())">
                                                                      @typeDisplay
                                                                 </span>
                                                             </td>
                                                             <td class="text-end font-bold @(typeDisplay == "DEPOSIT" ? "text-success" : typeDisplay == "USED" ? "text-primary" : "text-danger")">
                                                                 ₹ @row.receiptamount.ToString("N2")
                                                             </td>
                                                         </tr>
                                                     }
                                                 }
                                             }
                                         </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeTab == "history")
        {
            <DueCollectionHistory @ref="historyComponent" IsEmbedded="true" />
        }
    </div>
</div>

<!-- Bulk Result Modal -->
@if (showBulkResultModal && bulkResult != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-card-custom shadow modal-bulk-result">
            <div class="modal-header-custom bulk-success-header">
                <div class="bulk-header-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <h3>Bulk Collection Complete</h3>
                    <p class="bulk-receipt-subtitle">Receipt: <span class="bulk-receipt-no">@bulkResult.receipt_no</span></p>
                </div>
                <button class="close-btn" @onclick="CloseBulkResultModal">×</button>
            </div>

            <div class="modal-body-custom">
                <!-- Summary strip -->
                <div class="bulk-summary-strip">
                    <div class="bulk-stat">
                        <span class="bulk-stat-label">Bills Processed</span>
                        <span class="bulk-stat-value text-success">@bulkResult.items_processed</span>
                    </div>
                    @if (bulkResult.items_skipped > 0)
                    {
                        <div class="bulk-stat">
                            <span class="bulk-stat-label">Bills Skipped</span>
                            <span class="bulk-stat-value text-danger">@bulkResult.items_skipped</span>
                        </div>
                    }
                    <div class="bulk-stat">
                        <span class="bulk-stat-label">Total Cash Collected</span>
                        <span class="bulk-stat-value">₹ @bulkResult.total_cash_collected.ToString("N2")</span>
                    </div>
                    @if (bulkResult.total_advance_used > 0)
                    {
                        <div class="bulk-stat">
                            <span class="bulk-stat-label">Advance Used</span>
                            <span class="bulk-stat-value text-info">₹ @bulkResult.total_advance_used.ToString("N2")</span>
                        </div>
                    }
                    <div class="bulk-stat">
                        <span class="bulk-stat-label">Total Settled</span>
                        <span class="bulk-stat-value text-primary">₹ @bulkResult.total_settled.ToString("N2")</span>
                    </div>
                </div>

                <!-- Per-bill breakdown -->
                <div class="bulk-items-table-wrap mt-3">
                    <table class="due-table">
                        <thead>
                            <tr>
                                <th>BILL NO</th>
                                <th>PATIENT</th>
                                <th class="text-end">DUE BEFORE</th>
                                <th class="text-end">SETTLED</th>
                                <th class="text-end">DUE AFTER</th>
                                <th class="text-center">STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in bulkResult.items)
                            {
                                <tr>
                                    <td class="font-mono font-bold">@item.bill_no</td>
                                    <td class="font-bold">@item.patient_name</td>
                                    <td class="text-end">₹ @item.due_before.ToString("N2")</td>
                                    <td class="text-end text-success font-bold">₹ @item.total_settled.ToString("N2")</td>
                                    <td class="text-end @(item.due_after > 0 ? "text-danger" : "text-success") font-bold">₹ @item.due_after.ToString("N2")</td>
                                    <td class="text-center">
                                        @if (item.status == "collected")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Collected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark" title="@item.message"><i class="bi bi-skip-forward"></i> Skipped</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer-custom">
                <button class="btn btn-primary-custom" @onclick="CloseBulkResultModal">
                    <i class="bi bi-check"></i> Done
                </button>
            </div>
        </div>
    </div>
}


@code {
    private DueCollectionHistory? historyComponent;
    private string activeTab = "collect";
    private string payMode = "";
    private string txnReferenceNo = "";
    private double? totalAmountToAllocate;
    private string searchQuery = string.Empty;

    // Filter parameters
    private string filterType = "patient";
    private string filterBranch = "";
    private string _filterPatient = "";
    private string filterPatient
    {
        get => _filterPatient;
        set
        {
            if (_filterPatient != value)
            {
                _filterPatient = value;
                isPatientSearched = false;
            }
        }
    }
    private bool isPatientSearched = false;
    private DateTime? filterFromDate;
    private DateTime? filterToDate;
    private string filterCounter = "";
    private string filterReceiptNo = "";
    private DateTime? filterReceiptDate;
    private TimeOnly? filterTime;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalBillsCount = 0;
    private HmsAllDueSummary? dueBillsSummary;

    // Concession
    private Dictionary<string, double?> concessionAmounts = new();

    // Collected (mirrors concessionAmounts pattern — avoids Blazor input-value diffing issues)
    private Dictionary<string, double?> collectedAmounts = new();

    // Loading indicators
    private bool loadingBills = false;
    private bool loadingAdvance = false;
    private bool loadingLedger = false;
    private bool saving = false;
    private bool actionRunning = false;

    // Cache lists
    private List<HmsAllDueBillRow> dueBills = new();
    private HmsPatientAdvanceSummary? advanceSummary;
    private Dictionary<HmsAdvanceLedgerRow, string> resolvedTransactionTypes = new();
    private Dictionary<HmsAdvanceLedgerRow, string> resolvedCustomerNames = new();
    private Dictionary<HmsAdvanceLedgerRow, string> resolvedDoctorNames = new();
    private Dictionary<HmsAdvanceLedgerRow, string> resolvedBillNos = new();

    private bool showCollectFilter = false;         // collect filter hidden by default


    // Bulk result modal
    private bool showBulkResultModal = false;
    private HmsBulkDueCollectionResponse? bulkResult;

    // Selected Dues tracking
    private Dictionary<string, HmsDueCollectionRequest> selectedBills = new();
    private Dictionary<string, HmsDuePreviewResponse> previewResponses = new();

    // Cancellation modal
    // Search and Input bindings for tabs
    private decimal? advancePatientId;
    private string advanceSearchText = "";
    private bool showDepositRefund = false;
    private bool showTransactionHistory = false;
    private string advanceSubTab = "deposit";

    // Advance deposit / refund form bindings
    private double depositAmount = 0;
    private string depositPayMode = "CASH";
    private string depositRemarks = string.Empty;
    private double refundAmount = 0;
    private string refundRemarks = string.Empty;

    // Calculated values
    private double advanceAmountToUse = 0;
    private double TotalAdvanceAvailable
    {
        get
        {
            if (previewResponses.Count > 0)
            {
                return previewResponses.Values.Max(p => p.advance_available);
            }
            if (selectedBills.Count > 0)
            {
                var guids = selectedBills.Keys.ToHashSet();
                var matchingBills = dueBills.Where(b => b.requestguid != null && guids.Contains(b.requestguid)).ToList();
                if (matchingBills.Count > 0)
                {
                    return matchingBills.Max(b => b.advance_available);
                }
            }
            return 0;
        }
    }

    private double TotalCollectedEntered => selectedBills.Values.Sum(b => b.cash_collected);
    private double TotalConcessionsEntered => concessionAmounts.Values.Sum(v => v ?? 0);
    private int TotalPages => (int)Math.Ceiling((double)totalBillsCount / pageSize);

    private int UserCode => TenantState.UserCode != 0 ? TenantState.UserCode : 10;

    private int CounterCodeVal
    {
        get
        {
            if (int.TryParse(filterCounter, out var c)) return c;
            if (TenantState.CounterCode.HasValue && TenantState.CounterCode.Value != 0) return TenantState.CounterCode.Value;
            return 1;
        }
    }

    private int BranchCodeVal
    {
        get
        {
            if (int.TryParse(filterBranch, out var b)) return b;
            if (TenantState.BranchCode.HasValue && TenantState.BranchCode.Value != 0) return TenantState.BranchCode.Value;
            return 1;
        }
    }

    private List<Booking.Models.BranchModel> branchesList = new();
    private List<Medico_Backend.Model.CounterMasterModel> allCounters = new();
    private List<Medico_Backend.Model.CounterMasterModel> filteredCountersList = new();
    private List<Booking.Models.DoctorMasterModel> doctorsList = new();
    private List<Booking.Models.ReimbursementCompanyMasterModel> companiesList = new();

    private string filterDoctor = "";
    private string filterCompany = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDueBills();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var bhCodeResult = await _sessionStorage.GetAsync<string>("bhcode");
                if (bhCodeResult.Success && !string.IsNullOrEmpty(bhCodeResult.Value))
                {
                    filterBranch = bhCodeResult.Value;
                }

                var cntCodeResult = await _sessionStorage.GetAsync<string>("cntcode");
                if (cntCodeResult.Success && !string.IsNullOrEmpty(cntCodeResult.Value))
                {
                    filterCounter = cntCodeResult.Value;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error retrieving branch/counter defaults: {ex.Message}");
            }

            await LoadBranchesAsync();
            await LoadCountersAsync();
            await LoadDoctorsAsync();
            await LoadCompaniesAsync();
            await LoadDueBills();
            StateHasChanged();
        }
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }

            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                branchesList = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branchesList = branchesList.Where(b => !b.deleted).ToList();

                await FilterBranchesByUserAccessAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }

    private async Task FilterBranchesByUserAccessAsync()
    {
        try
        {
            var isTenantAdminResult = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
            if (isTenantAdminResult.Success && isTenantAdminResult.Value == true)
            {
                return;
            }

            var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (userDetailsResult.Success && userDetailsResult.Value != null && userDetailsResult.Value.UserCode == 0)
            {
                return;
            }

            if (userDetailsResult.Success && userDetailsResult.Value?.Branches != null && userDetailsResult.Value.Branches.Any())
            {
                var allowedCodes = userDetailsResult.Value.Branches
                    .Select(b => b.bh_code != 0 ? b.bh_code : (b.bhcode ?? 0))
                    .Where(code => code > 0)
                    .ToHashSet();

                if (allowedCodes.Any())
                {
                    branchesList = branchesList.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                    return;
                }
            }

            var branchCodesResult = await _sessionStorage.GetAsync<List<int>>("UserBranchCodes");
            if (branchCodesResult.Success && branchCodesResult.Value != null && branchCodesResult.Value.Any())
            {
                var allowedCodes = branchCodesResult.Value.ToHashSet();
                branchesList = branchesList.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering branches by user access: {ex.Message}");
        }
    }

    private async Task LoadCountersAsync()
    {
        try
        {
            var res = await CounterService.GetCountersAsync();
