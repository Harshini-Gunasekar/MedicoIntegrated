        return 0;
    }

    private void OnCollectedAmountChanged(string guid)
    {
        var amount = collectedAmounts.GetValueOrDefault(guid, null) ?? 0;
        if (selectedBills.TryGetValue(guid, out var req))
            req.cash_collected = amount;
        // update preview locally
        if (previewResponses.TryGetValue(guid, out var p))
        {
            if (p.current_due <= 0)
            {
                var bill = dueBills.FirstOrDefault(b => b.requestguid == guid);
                if (bill != null) p.current_due = bill.due_amount;
            }
            p.amount_to_collect = amount;
            p.due_after = Math.Max(0, p.current_due - p.advance_to_use - amount);
        }
    }

    /// <summary>
    /// Distributes <see cref="totalAmountToAllocate"/> across all currently-visible
    /// bills in order.
    ///
    /// Behaviour:
    ///  • If no bills are manually checked, ALL visible bills are auto-selected first.
    ///  • The entered cash is distributed greedily: fill bill 1 fully, then bill 2, etc.
    ///  • Cap per bill = bill.due_amount so the user's cash is never silently swallowed.
    ///  • Only bills that receive a non-zero allocation are selected (checked).
    ///  • collectedAmounts dictionary is always kept in sync with req.cash_collected.
    /// </summary>
    private async Task AutoAllocateAmount(bool showWarning = false)
    {
        if (totalAmountToAllocate == null || totalAmountToAllocate <= 0)
        {
            if (showWarning)
            {
                ToastService.ShowError("Please enter an amount greater than zero before using Auto Select.");
            }
            return;
        }

        if (dueBills.Count == 0)
        {
            ToastService.ShowError("No bills loaded. Search for a patient first.");
            return;
        }

        // Clear previous selections — we re-select only bills that get a non-zero allocation
        selectedBills.Clear();
        previewResponses.Clear();
        collectedAmounts.Clear();

        double remaining = totalAmountToAllocate ?? 0;

        foreach (var bill in dueBills)
        {
            if (remaining <= 0) break;  // no money left — skip remaining bills entirely

            var guid = bill.requestguid ?? "";
            double billCap = Math.Max(0, bill.due_amount);

            if (billCap <= 0) continue;  // bill already fully paid — skip

            double allocate = Math.Min(remaining, billCap);
            remaining -= allocate;

            // Select this bill (calls PreviewAdvanceAsync for the balance column)
            await AddBillToSelection(bill);

            // Override collected amount with the computed allocation
            if (selectedBills.TryGetValue(guid, out var req))
            {
                req.cash_collected = allocate;
            }
            collectedAmounts[guid] = allocate == 0 ? null : allocate;

            // Recalculate Curr. Bal column in preview
            if (previewResponses.TryGetValue(guid, out var p))
            {
                if (p.current_due <= 0) p.current_due = bill.due_amount;
                p.amount_to_collect = allocate;
                p.due_after = Math.Max(0, p.current_due - p.advance_to_use - allocate);
            }
        }

        StateHasChanged();
        // Allow Blazor to flush the render to the DOM before we read/write elements via JS
        await Task.Delay(50);
        await ApplyCollectedAmountsToDOM();
    }

    /// <summary>
    /// Directly sets the DOM .value PROPERTY (not the HTML attribute) for each
    /// collected input via JavaScript interop.
    /// Blazor diffs via setAttribute — browsers ignore attribute updates on
    /// existing inputs they own. Setting element.value = x via JS always works.
    /// </summary>
    private async Task ApplyCollectedAmountsToDOM()
    {
        foreach (var (guid, amount) in collectedAmounts)
        {
            if (!selectedBills.ContainsKey(guid)) continue;
            try
            {
                await JS.InvokeVoidAsync("DueCollection.setInputValue", $"collected_{guid}", amount);
            }
            catch { /* element may not be in DOM yet, ignore */ }
        }
    }

    private async Task SaveCollections()
    {
        if (selectedBills.Count == 0) return;

        if (string.IsNullOrWhiteSpace(payMode))
        {
            ToastService.ShowError("Please, select the payment mode");
            return;
        }

        saving = true;
        StateHasChanged();
 
        try
        {
            var effectiveRef = string.IsNullOrWhiteSpace(txnReferenceNo) ? null : txnReferenceNo;
            // Build bulk request — one shared receipt for all selected bills
            var items = new List<HmsBulkDueCollectionItem>();
            foreach (var req in selectedBills.Values)
            {
                var item = new HmsBulkDueCollectionItem
                {
                    requestguid     = req.requestguid,
                    cash_collected  = req.cash_collected,
                    advance_to_use  = req.advance_to_use,
                    collection_type = payMode,
                    reference_no    = effectiveRef,
                    bank_name       = req.bank_name,
                    card_no         = payMode == "CARD" ? effectiveRef : req.card_no,
                    cheque_date     = req.cheque_date,
                    card_date       = req.card_date,
                    pmcode          = req.pmcode,
                    ctcode          = req.ctcode,
                    tmcode          = req.tmcode,
                    remarks         = req.remarks,
                    isbill          = req.isbill,
                    isrefferal      = req.isrefferal,
                    ismonthly       = req.ismonthly,
                    ispatient       = req.ispatient,
                    isrefund        = req.isrefund,
                    payledgercode   = req.payledgercode,
                };
 
                // ADVANCE mode: use typed/allocated advance
                if (payMode == "ADVANCE")
                {
                    item.advance_to_use = req.advance_to_use;
                    item.cash_collected = 0;
                }
 
                items.Add(item);
            }
 
            // Pick common metadata from the first selected bill
            var first = selectedBills.Values.First();
            var bulkReq = new HmsBulkDueCollectionRequest
            {
                items           = items,
                collection_type = payMode,
                reference_no    = effectiveRef,
                enteredbhcode   = first.enteredbhcode,
                usercode        = first.usercode,
                computercode    = first.computercode,
                cntcode         = first.cntcode,
                cnttid          = first.cnttid,
                pmcode          = first.pmcode,
                ctcode          = first.ctcode,
                tmcode          = first.tmcode,
                isbill          = first.isbill,
                isrefferal      = first.isrefferal,
                ismonthly       = first.ismonthly,
                ispatient       = first.ispatient,
                isrefund        = first.isrefund,
                payledgercode   = first.payledgercode,
            };

            var res = await DueCollectionService.CollectBulkDueAsync(bulkReq);
            if (res != null)
            {
                bulkResult = res;
                showBulkResultModal = false;

                selectedBills.Clear();
                previewResponses.Clear();
                totalAmountToAllocate = null;
                txnReferenceNo = "";

                if (res.items_skipped == 0)
                    ToastService.ShowSuccess("Collection completed successfully");
                else
                    ToastService.ShowError($"{res.items_processed} collected, {res.items_skipped} skipped. Receipt: {res.receipt_no}");

                await LoadDueBills();
            }
            else
            {
                ToastService.ShowError("Bulk collection failed. Check console logs.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving due collection: {ex.Message}");
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }

