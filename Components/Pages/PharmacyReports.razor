@page "/pharmacy-reports"
@page "/pharmacyreports"
@page "/sales-reports"
@page "/salesreports"
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using Booking.Models
@using medico_backend.Model
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Booking.Services.RoleMasterService RoleService
@inject IConfiguration Configuration

<PageTitle>@(string.IsNullOrEmpty(selectedReportKey) ? "Pharmacy Reports" : GetReportDisplayName(selectedReportKey))</PageTitle>

<div class="items-page pharmacy-reports-page pt-3 pb-3">
    <div class="items-shell px-3">
        <div class="items-content">
            <!-- Premium Header Card (Consistent with other Medico pages) -->
            <div class="premium-header-card mb-4">
                <div class="header-card-left">
                    @if (!string.IsNullOrEmpty(selectedReportKey))
                    {
                        <button type="button" class="btn-back-circle me-1" @onclick="CloseReportDetail" title="Back to Reports List">
                            <i class="bi bi-arrow-left"></i>
                        </button>
                    }
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                            <polyline points="10 9 9 9 8 9" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">@(string.IsNullOrEmpty(selectedReportKey) ? "Pharmacy Reports" : GetReportDisplayName(selectedReportKey))</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Official GST returns, sales registers & inventory statements
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    @if (!string.IsNullOrEmpty(selectedReportKey))
                    {
                        <button type="button" class="btn-close-modal" @onclick="CloseReportDetail" title="Back to Reports">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
            </div>

            @if (string.IsNullOrEmpty(selectedReportKey))
            {
                <!-- ========================================== -->
                <!-- VIEW 1: MASTER REPORTS LIST (TEXT LINKS) -->
                <!-- ========================================== -->
                <div class="reports-list-card">
                    <div class="report-links-panel">
                        <div class="report-links-grid">
                            <!-- Column 1 -->
                            <div class="report-column">
                                <div class="report-link-item" @onclick='() => SelectReport("GST_INWARD")'>
                                    <span class="report-index">1.</span>
                                    <span class="report-link-text">GST Inward Return Report</span>
                                </div>

                                <div class="report-link-item" @onclick='() => SelectReport("GST_OUTWARD")'>
                                    <span class="report-index">2.</span>
                                    <span class="report-link-text">GST Outward Return Report</span>
                                </div>

                                <div class="report-link-item" @onclick='() => SelectReport("SALES_REGISTER")'>
                                    <span class="report-index">3.</span>
                                    <span class="report-link-text">Sales Register</span>
                                </div>
                            </div>

                            <!-- Column 2 -->
                            <div class="report-column">
                                <div class="report-link-item" @onclick='() => SelectReport("SALES_REPORT")'>
                                    <span class="report-index">4.</span>
                                    <span class="report-link-text">Sales Report</span>
                                </div>

                                <div class="report-link-item" @onclick='() => SelectReport("STOCK_REPORT")'>
                                    <span class="report-index">5.</span>
                                    <span class="report-link-text">Stock Report</span>
                                </div>

                                <div class="report-link-item" @onclick='() => SelectReport("ITEM_PATIENT_SALES")'>
                                    <span class="report-index">6.</span>
                                    <span class="report-link-text">Item-wise Patient Sales & Stock Movement Report</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- ========================================== -->
                <!-- VIEW 2: DEDICATED REPORT PREVIEW PAGE      -->
                <!-- ========================================== -->
                <div class="report-runner-card mb-4">
                    <!-- Toolbar Controls in Single Horizontal Line -->
                    <!-- Toolbar Controls in Single Line / Responsive Grid -->
                    <div class="report-runner-toolbar">
                        <div class="filter-item-wrap filter-item-store">
                            <label class="filter-label"><i class="bi bi-shop me-1 text-primary"></i> STORE</label>
                            <select class="form-control premium-filter-control" value="@selectedWarehouseCode" @onchange="OnWarehouseChanged">
                                @if (!WarehouseList.Any())
                                {
                                    <option value="0">Loading Stores...</option>
                                }
                                else
                                {
                                    @foreach (var w in WarehouseList)
                                    {
                                        <option value="@w.warehousecode">@w.warehousename</option>
                                    }
                                }
                            </select>
                        </div>

                        @if (selectedReportKey == "ITEM_PATIENT_SALES")
                        {
                            <!-- Search Item Box in Header -->
                            <div class="filter-item-wrap filter-item-search position-relative">
                                <label class="filter-label"><i class="bi bi-search me-1 text-primary"></i> SEARCH ITEM NAME</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0" style="height: 38px;"><i class="bi bi-search text-muted"></i></span>
                                    <input type="text"
                                           class="form-control premium-filter-control border-start-0"
                                           placeholder="Type to filter items in store..."
                                           value="@searchTerm"
                                           @oninput="OnSearchInput" />
                                    @if (!string.IsNullOrEmpty(searchTerm))
                                    {
                                        <button type="button" class="btn btn-outline-secondary border-start-0 bg-white" style="height: 38px;" @onclick="ClearSearch" title="Clear Search">
                                            <i class="bi bi-x-lg text-muted"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        <div class="filter-item-wrap filter-item-date">
                            <label class="filter-label"><i class="bi bi-calendar-event me-1 text-primary"></i> FROM</label>
                            <input type="date" class="form-control premium-filter-control" @bind="selectedFromDate" />
                        </div>

                        <div class="filter-item-wrap filter-item-date">
                            <label class="filter-label"><i class="bi bi-calendar-check me-1 text-primary"></i> TO</label>
                            <input type="date" class="form-control premium-filter-control" @bind="selectedToDate" />
                        </div>

                        @if (selectedReportKey == "ITEM_PATIENT_SALES")
                        {
                            <div class="filter-item-wrap filter-item-salestype">
                                <label class="filter-label"><i class="bi bi-funnel me-1 text-primary"></i> SALE TYPE</label>
                                <select class="form-control premium-filter-control" @bind="selectedSalesType">
                                    <option value="ALL">All Sales</option>
                                    <option value="OP">OP (Outpatient)</option>
                                    <option value="IP">IP (Inpatient)</option>
                                    <option value="COUNTER">Counter Sales</option>
                                </select>
                            </div>
                        }

                        <div class="filter-actions-wrap">
                            @if (selectedReportKey == "ITEM_PATIENT_SALES")
                            {
                                @if (hasLoadedReport)
                                {
                                    <button type="button" class="btn btn-outline-primary" @onclick="BackToItemList" style="height: 38px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 0.85rem; padding: 0 16px;">
                                        <i class="bi bi-arrow-left"></i>
                                        <span>Back to Items</span>
                                    </button>

                                    @if (hasPrintReportRight)
                                    {
                                        <button type="button" class="btn-report-print" disabled="@isGeneratingReport" @onclick="PrintCurrentReport">
                                            <i class="bi bi-printer me-1"></i>
                                            <span>Print</span>
                                        </button>
                                    }
                                }
                                else
                                {
                                    @if (hasPreviewReportRight)
                                    {
                                        <button type="button" class="btn-report-show" disabled="@(selectedItem == null || isGeneratingReport)" @onclick="LoadReportPreview">
                                            @if (isGeneratingReport)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                <span>Loading...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-play-circle me-1"></i>
                                                <span>Show</span>
                                            }
                                        </button>
                                    }
                                }
                            }
                            else
                            {
                                @if (hasPreviewReportRight)
                                {
                                    <button type="button" class="btn-report-show" disabled="@isGeneratingReport" @onclick="LoadReportPreview">
                                        @if (isGeneratingReport)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                            <span>Loading...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-play-circle me-1"></i>
                                            <span>Show</span>
                                        }
                                    </button>
                                }

                                @if (hasPrintReportRight)
                                {
                                    <button type="button" class="btn-report-print" disabled="@isGeneratingReport" @onclick="PrintCurrentReport">
                                        <i class="bi bi-printer me-1"></i>
                                        <span>Print</span>
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    @if (selectedReportKey == "ITEM_PATIENT_SALES" && !hasLoadedReport)
                    {
                        <!-- Store Items List Table View -->
                        <div class="store-items-table-container p-3">
                            <!-- Table Header Stats & Hint Bar -->
                            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" style="font-weight: 700; font-size: 0.82rem;">
                                        <i class="bi bi-box-seam me-1"></i> @FilteredStoreItems.Count() Items
                                    </span>
                                    @if (!string.IsNullOrEmpty(searchTerm))
                                    {
                                        <span class="text-muted small">
                                            Filtered by: <strong class="text-dark">"@searchTerm"</strong>
                                        </span>
                                    }
                                </div>
                                <div class="text-muted small d-flex align-items-center gap-1">
                                    <i class="bi bi-mouse text-primary"></i>
                                    <span><strong>Double-click</strong> any item row to preview report</span>
                                </div>
                            </div>

                            @if (isLoadingStoreItems)
                            {
                                <div class="text-center py-5 bg-white rounded border">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <p class="mt-2 text-muted fw-semibold mb-0">Loading items for selected store...</p>
                                </div>
                            }
                            else if (!FilteredStoreItems.Any())
                            {
                                <div class="text-center py-5 bg-white rounded border">
                                    <i class="bi bi-inbox text-muted fs-1 mb-2 d-block"></i>
                                    <h5 class="fw-bold text-secondary">No items found</h5>
                                    <p class="text-muted small mb-3">
                                        @if (!string.IsNullOrEmpty(searchTerm))
                                        {
                                            <span>No items match your search "<strong>@searchTerm</strong>" in this store.</span>
                                        }
                                        else
                                        {
                                            <span>No items available in the selected store.</span>
                                        }
                                    </p>
                                    @if (!string.IsNullOrEmpty(searchTerm))
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearSearch">
                                            Clear Search
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive bg-white rounded border shadow-sm" style="max-height: calc(100vh - 295px); overflow-y: auto;">
                                    <table class="table table-hover table-striped align-middle mb-0 items-ledger-table">
                                        <thead class="table-light sticky-top" style="z-index: 5; border-bottom: 2px solid #cbd5e1;">
                                            <tr>
                                                <th style="width: 50px;" class="text-center">#</th>
                                                <th style="width: 100px;">CODE</th>
                                                <th>ITEM NAME</th>
                                                <th>DRUG / GENERIC NAME</th>
                                                <th style="width: 110px;">PACKAGING</th>
                                                <th style="width: 110px;" class="text-end">MRP</th>
                                                <th style="width: 110px;" class="text-center">STOCK</th>
                                                <th style="width: 130px;" class="text-center">ACTION</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{ int rowIdx = 1; }
                                            @foreach (var item in FilteredStoreItems)
                                            {
                                                var isSel = selectedItem?.itemcode == item.itemcode;
                                                <tr class="@(isSel ? "table-active border-primary" : "") cursor-pointer"
                                                    style="user-select: none;"
                                                    @onclick="() => selectedItem = item"
                                                    @ondblclick="() => HandleItemDoubleClick(item)"
                                                    title="Double-click to view report">
                                                    <td class="text-center text-muted fw-semibold">@(rowIdx++)</td>
                                                    <td>
                                                        <span class="badge bg-light text-dark border">@item.itemcode</span>
                                                    </td>
                                                    <td>
                                                        <div class="fw-bold text-primary">@item.itemname</div>
                                                    </td>
                                                    <td class="text-muted small">
                                                        @(string.IsNullOrWhiteSpace(item.drugname) ? "-" : item.drugname)
                                                    </td>
                                                    <td>
                                                        <small class="text-secondary">@item.packaging</small>
                                                    </td>
                                                    <td class="text-end fw-bold text-dark">
                                                        ₹@(item.mrp?.ToString("0.00") ?? "0.00")
                                                    </td>
                                                    <td class="text-center">
                                                        @if ((item.currentstock ?? 0) > 0)
                                                        {
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-bold">
                                                                @item.currentstock?.ToString("0.##")
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-muted border px-2 py-1">
                                                                0
                                                            </span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-primary px-2 py-1"
                                                                style="font-size: 0.78rem; font-weight: 600;"
                                                                @onclick="() => HandleItemDoubleClick(item)"
                                                                @onclick:stopPropagation="true">
                                                            <i class="bi bi-file-earmark-pdf me-1"></i> View Report
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- In-Page PDF Frame (for standard reports 1-5, and for ITEM_PATIENT_SALES when viewing report) -->
                        <div class="report-preview-frame-container">
                            @if (isGeneratingReport)
                            {
                                <div class="preview-loading-overlay">
                                    <div class="spinner-border text-primary" style="width: 2.5rem; height: 2.5rem;" role="status"></div>
                                    <span class="mt-2 fw-semibold text-muted">Generating @(selectedReportKey == "ITEM_PATIENT_SALES" ? (selectedItem?.itemname ?? "Item") : GetReportDisplayName(selectedReportKey))...</span>
                                </div>
                            }

                            @if (!hasLoadedReport && !isGeneratingReport)
                            {
                                <div class="preview-placeholder">
                                    <i class="bi bi-file-earmark-pdf text-muted" style="font-size: 3.5rem;"></i>
                                    <h4 class="mt-3 text-secondary fw-bold">Report Ready to Generate</h4>
                                    <p class="text-muted" style="font-size: 0.85rem;">Select store & dates above, then click <strong>Show</strong> to view.</p>
                                    <button type="button" class="btn btn-primary btn-sm px-4 mt-1" @onclick="LoadReportPreview">
                                        <i class="bi bi-play-fill me-1"></i> Show Report
                                    </button>
                                </div>
                            }

                            <iframe id="pharmacyReportFrame" class="report-pdf-iframe @(hasLoadedReport ? "visible" : "hidden")"
                                    title="Report Preview"></iframe>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
.pharmacy-reports-page {
    background: transparent !important;
    min-height: 100vh;
}

.items-shell {
    max-width: 1400px;
    margin: 0 auto;
}

/* Premium Header Card (Matches Medico theme) */
.premium-header-card {
    background: linear-gradient(135deg, #f0f3ff 0%, #e6ebff 100%);
    border: 1px solid rgba(99, 102, 241, 0.15);
    border-radius: 16px;
    padding: 1.15rem 1.75rem;
    color: #1e1b4b;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 4px 18px rgba(99, 102, 241, 0.06);
    margin-top: 0.5rem;
}

.header-card-left {
    display: flex;
    align-items: center;
    gap: 14px;
}

.btn-back-circle {
    background: #ffffff;
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4f46e5;
    cursor: pointer;
    font-size: 1.05rem;
    transition: all 0.2s;
    box-shadow: 0 2px 6px rgba(99, 102, 241, 0.08);
}

.btn-back-circle:hover {
    background: #4f46e5;
    color: #ffffff;
    transform: translateX(-2px);
}

.header-card-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid rgba(99, 102, 241, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.08);
}

.header-card-icon svg {
    stroke: #4f46e5;
}

.header-card-text {
    display: flex;
    flex-direction: column;
    text-align: left;
}

.header-card-heading {
    color: #312e81;
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.3px;
}

.header-card-subheading {
    font-size: 0.68rem;
    font-weight: 700;
    color: #6366f1;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    margin-top: 4px;
}

.status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
    margin-right: 6px;
    display: inline-block;
    box-shadow: 0 0 8px #10b981;
}

.header-card-right {
    display: flex;
    align-items: center;
    gap: 0.85rem;
}

.btn-close-modal {
    background: #ffffff;
    border: 1px solid rgba(99, 102, 241, 0.15);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 0.88rem;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
}

.btn-close-modal:hover {
    background: #fee2e2;
    color: #dc2626;
    border-color: #fca5a5;
    transform: scale(1.05);
}

/* Master Reports List Card */
.reports-list-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    min-height: calc(100vh - 220px);
    display: flex;
    flex-direction: column;
}

.report-links-panel {
    padding: 3rem 3.5rem;
    flex: 1;
}

.report-links-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem 5rem;
    max-width: 960px;
}

.report-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.report-link-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    cursor: pointer;
    padding: 8px 14px;
    border-radius: 8px;
    transition: all 0.18s ease;
    user-select: none;
}

.report-link-item:hover {
    background: #f0fdf4;
    transform: translateX(6px);
}

.report-index {
    font-size: 1rem;
    font-weight: 700;
    color: #475569;
    min-width: 22px;
}

.report-link-text {
    font-size: 1rem;
    font-weight: 700;
    color: #0284c7;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: all 0.15s ease;
}

.report-link-item:hover .report-link-text {
    color: #0369a1;
    border-bottom-color: #0284c7;
}

/* Report Runner Toolbar & Preview */
.report-runner-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 220px);
}

.report-runner-toolbar {
    padding: 0.85rem 1.5rem !important;
    background: #ffffff !important;
    border-bottom: 1px solid #e2e8f0 !important;
    display: flex !important;
    flex-direction: row !important;
    align-items: flex-end !important;
    gap: 1.25rem !important;
    flex-wrap: nowrap !important;
    width: 100% !important;
}

.filter-item-wrap {
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important;
}

.filter-item-store {
    flex: 0 0 280px !important;
    max-width: 280px !important;
    min-width: 200px !important;
}

.filter-item-date {
    flex: 0 0 170px !important;
    max-width: 170px !important;
    min-width: 150px !important;
}

.filter-actions-wrap {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    margin-left: auto !important;
    padding-bottom: 1px !important;
}

.filter-label {
    font-size: 0.72rem !important;
    font-weight: 700 !important;
    color: #475569 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.4px !important;
    margin-bottom: 0 !important;
}

.premium-filter-control {
    height: 38px !important;
    border: 1px solid #cbd5e1 !important;
    border-radius: 8px !important;
    padding: 0 12px !important;
    font-size: 0.85rem !important;
    font-weight: 600 !important;
    color: #1e293b !important;
    background: #f8fafc !important;
    width: 100% !important;
    box-sizing: border-box !important;
}

.premium-filter-control:focus {
    background: #ffffff !important;
    border-color: #4f46e5 !important;
    outline: none !important;
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12) !important;
}

.btn-report-show {
    height: 38px;
    padding: 0 22px;
    background: #4f46e5;
    color: #ffffff;
    border: 1px solid #4f46e5;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(79, 70, 229, 0.2);
}

.btn-report-show:hover:not(:disabled) {
