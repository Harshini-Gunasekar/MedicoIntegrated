@code {
    private string DefaultTenant = "0010";
    private string AuthToken = "";
    private string selectedReportKey = "";
    private string currentLoadedBase64 = "";
    private bool isGeneratingReport = false;
    private bool hasLoadedReport = false;

    private long selectedWarehouseCode = 0;
    private DateTime selectedFromDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime selectedToDate = DateTime.Now;

    private List<warehouse_master> WarehouseList = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSessionAndTenant();
        await LoadWarehouses();
    }

    private async Task LoadSessionAndTenant()
    {
        try
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success && !string.IsNullOrEmpty(tenantCodeResult.Value) ? tenantCodeResult.Value : (TenantState?.TenantCode ?? "0010");

            var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
            if (!tokenResult.Success || string.IsNullOrEmpty(tokenResult.Value))
            {
                tokenResult = await _sessionStorage.GetAsync<string>("auth_token");
            }
            AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : (TenantState?.AuthToken ?? "");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PharmacyReports] Session init error: {ex.Message}");
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Remove("tenant-code");
        if (!string.IsNullOrEmpty(DefaultTenant))
        {
            client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant-code", DefaultTenant);
        }
        var effectiveToken = !string.IsNullOrEmpty(AuthToken) ? AuthToken : TenantState?.AuthToken;
        if (!string.IsNullOrEmpty(effectiveToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
        }
        return client;
    }

    private async Task LoadWarehouses()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallwarehouse");
            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                List<warehouse_master> allWh = new();
                try
                {
                    allWh = System.Text.Json.JsonSerializer.Deserialize<List<warehouse_master>>(response, options) ?? new();
                }
                catch
                {
                    var wrapped = System.Text.Json.JsonSerializer.Deserialize<SalesMaster.ServiceResponse<List<warehouse_master>>>(response, options);
                    allWh = wrapped?.data ?? new();
                }

                // Filter by the current logged-in user's tenant!
                if (!string.IsNullOrWhiteSpace(DefaultTenant))
                {
                    var exactTenantStores = allWh
                        .Where(w => !w.isdeleted && string.Equals(w.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase))
                        .ToList();

                    if (exactTenantStores.Any())
                    {
                        WarehouseList = exactTenantStores;
                    }
                    else
                    {
                        // Fallback to tenant or empty tenant stores
                        WarehouseList = allWh
                            .Where(w => !w.isdeleted && (string.IsNullOrEmpty(w.tenantcode) || string.Equals(w.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase)))
                            .ToList();
                    }
                }
                else
                {
                    WarehouseList = allWh.Where(w => !w.isdeleted).ToList();
                }

                if (WarehouseList.Any())
                {
                    selectedWarehouseCode = WarehouseList.First().warehousecode ?? 0;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PharmacyReports] LoadWarehouses error: {ex.Message}");
        }
    }

    private void SelectReport(string reportKey)
    {
        selectedReportKey = reportKey;
        hasLoadedReport = false;
        currentLoadedBase64 = "";
        StateHasChanged();

        // Auto trigger preview for smooth UX
        _ = LoadReportPreview();
    }

    private void CloseReportDetail()
    {
        selectedReportKey = "";
        hasLoadedReport = false;
        currentLoadedBase64 = "";
        StateHasChanged();
    }

    private string GetReportDisplayName(string reportKey) => reportKey switch
    {
        "GST_INWARD" => "GST Inward Return Report",
        "GST_OUTWARD" => "GST Outward Return Report",
        "SALES_REGISTER" => "Sales Register",
        "SALES_REPORT" => "Sales Report",
        "STOCK_REPORT" => "Stock Report",
        _ => "Pharmacy Report"
    };

    private List<string> BuildReportUrls(string reportKey)
    {
        string fromStr = selectedFromDate.ToString("yyyy-MM-dd");
        string toStr = selectedToDate.ToString("yyyy-MM-dd");
        long whCode = selectedWarehouseCode;

        var list = new List<string>();

        switch (reportKey)
        {
            case "GST_INWARD":
                list.Add($"https://medicoapi.iscansoft.com/api/report/getgstbill?fromdate={fromStr}&todate={toStr}&billtype=inward&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                list.Add($"api/report/getgstbill?fromdate={fromStr}&todate={toStr}&billtype=inward&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                list.Add($"api/report/getgstbill?fromdate={fromStr}&todate={toStr}&billtype=inward");
                list.Add($"https://medicoapi.iscansoft.com/api/Report/getgstbill?fromdate={fromStr}&todate={toStr}&billtype=inward&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                break;

            case "GST_OUTWARD":
                list.Add($"https://medicoapi.iscansoft.com/api/report/getgstbill?fromdate={fromStr}&todate={toStr}&billtype=outward&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                list.Add($"api/report/getgstbill?fromdate={fromStr}&todate={toStr}&billtype=outward&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                list.Add($"api/report/getgstbill?fromdate={fromStr}&todate={toStr}&billtype=outward");
                list.Add($"https://medicoapi.iscansoft.com/api/Report/getgstbill?fromdate={fromStr}&todate={toStr}&billtype=outward&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                break;

            case "SALES_REGISTER":
                list.Add($"https://medicoapi.iscansoft.com/api/report/getsalesregister?fromdate={fromStr}&todate={toStr}&warehousecode={whCode}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                list.Add($"api/report/getsalesregister?fromdate={fromStr}&todate={toStr}&warehousecode={whCode}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                list.Add($"api/report/getsalesregister?fromdate={fromStr}&todate={toStr}&warehousecode={whCode}");
                list.Add($"https://medicoapi.iscansoft.com/api/Report/getsalesregister?fromdate={fromStr}&todate={toStr}&warehousecode={whCode}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                break;

            case "SALES_REPORT":
                list.Add($"https://medicoapi.iscansoft.com/api/report/sales-report?warehousecode={whCode}&fromdate={fromStr}&todate={toStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                list.Add($"api/report/sales-report?warehousecode={whCode}&fromdate={fromStr}&todate={toStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                list.Add($"https://medicoapi.iscansoft.com/api/Report/SalesReport?warehousecode={whCode}&fromdate={fromStr}&todate={toStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                break;

            case "STOCK_REPORT":
                list.Add($"https://medicoapi.iscansoft.com/api/report/stock-report?warehousecode={whCode}&date={toStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                list.Add($"api/report/stock-report?warehousecode={whCode}&date={toStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                list.Add($"https://medicoapi.iscansoft.com/api/Report/StockReport?warehousecode={whCode}&date={toStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
                break;
        }

        return list;
    }

    private async Task<string> FetchReportBase64(string reportKey)
    {
        var urls = BuildReportUrls(reportKey);
        var client = CreateClient();
        string lastError = "";

        foreach (var url in urls)
        {
            try
            {
                var req = new HttpRequestMessage(HttpMethod.Get, url);
                var effectiveToken = !string.IsNullOrEmpty(AuthToken) ? AuthToken : TenantState?.AuthToken;
                if (!string.IsNullOrEmpty(effectiveToken))
                {
                    req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
                }
                req.Headers.Add("tenantcode", DefaultTenant);
                req.Headers.Add("tenant_code", DefaultTenant);
                req.Headers.Add("tenant-code", DefaultTenant);

                var response = await client.SendAsync(req);
                if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
                {
                    var contentStr = await response.Content.ReadAsStringAsync();
                    contentStr = contentStr.Trim('"').Trim();

                    string base64Data = contentStr;
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(contentStr);
                        var root = doc.RootElement;
                        if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {
                            if (root.TryGetProperty("data", out var dProp)) base64Data = dProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("base64", out var bProp)) base64Data = bProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("file", out var fProp)) base64Data = fProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("report", out var rProp)) base64Data = rProp.GetString() ?? contentStr;
                        }
                        else if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                        {
                            base64Data = root.GetString() ?? contentStr;
                        }
                    }
                    catch { }

                    if (!string.IsNullOrWhiteSpace(base64Data) && base64Data.Length >= 50)
                    {
                        return base64Data;
                    }
                }
                else
                {
                    var errContent = await response.Content.ReadAsStringAsync();
                    lastError = $"HTTP {(int)response.StatusCode} ({response.ReasonPhrase}): {errContent}";
                }
            }
            catch (Exception ex)
            {
                lastError = ex.Message;
            }
        }

        throw new Exception(string.IsNullOrEmpty(lastError) ? "Backend report service returned empty data." : lastError);
    }

    private async Task LoadReportPreview()
    {
        if (string.IsNullOrEmpty(selectedReportKey)) return;

        isGeneratingReport = true;
        hasLoadedReport = false;
        StateHasChanged();

        string title = GetReportDisplayName(selectedReportKey);

        try
        {
            currentLoadedBase64 = await FetchReportBase64(selectedReportKey);

            if (!string.IsNullOrWhiteSpace(currentLoadedBase64))
            {
                hasLoadedReport = true;
                StateHasChanged();
                await Task.Delay(50);
                await JS.InvokeVoidAsync("setIframePdfBase64", "pharmacyReportFrame", currentLoadedBase64);
            }
            else
            {
                ToastService.ShowError($"Unable to load {title}: Empty report data.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error generating {title}: {ex.Message}");
        }
        finally
        {
            isGeneratingReport = false;
            StateHasChanged();
        }
    }

    private async Task PrintCurrentReport()
    {
        if (string.IsNullOrWhiteSpace(currentLoadedBase64))
        {
            await LoadReportPreview();
        }

        if (!string.IsNullOrWhiteSpace(currentLoadedBase64))
        {
            await JS.InvokeVoidAsync("openBase64Pdf", currentLoadedBase64, GetReportDisplayName(selectedReportKey));
            ToastService.ShowSuccess($"{GetReportDisplayName(selectedReportKey)} sent to printer.");
        }
    }
