    private async Task LoadStoreItemsAsync()
    {
        if (selectedWarehouseCode <= 0 && WarehouseList.Any())
        {
            selectedWarehouseCode = WarehouseList.First().warehousecode ?? 0;
        }
        if (selectedWarehouseCode <= 0) return;

        isLoadingStoreItems = true;
        StateHasChanged();

        try
        {
            var client = CreateClient();
            long whCode = selectedWarehouseCode;
            string url = $"api/Report/getitemsforsalesreport?search=&warehousecode={whCode}";

            var resp = await client.GetAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                var contentStr = await resp.Content.ReadAsStringAsync();
                var opt = new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true,
                    NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                };

                using var doc = JsonDocument.Parse(contentStr);
                JsonElement targetElement = doc.RootElement;
                if (doc.RootElement.ValueKind == JsonValueKind.Object)
                {
                    if (doc.RootElement.TryGetProperty("data", out var dEl)) targetElement = dEl;
                    else if (doc.RootElement.TryGetProperty("Data", out var dEl2)) targetElement = dEl2;
                }

                if (targetElement.ValueKind == JsonValueKind.Array)
                {
                    storeItemsList = JsonSerializer.Deserialize<List<ItemSalesReportItemDto>>(targetElement.GetRawText(), opt) ?? new();
                }
                else
                {
                    storeItemsList.Clear();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PharmacyReports] LoadStoreItemsAsync error: {ex.Message}");
        }
        finally
        {
            isLoadingStoreItems = false;
            StateHasChanged();
        }
    }

    private IEnumerable<ItemSalesReportItemDto> FilteredStoreItems
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchTerm))
                return storeItemsList;

            var term = searchTerm.Trim();
            return storeItemsList.Where(i =>
                (!string.IsNullOrEmpty(i.itemname) && i.itemname.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(i.drugname) && i.drugname.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (i.itemcode.HasValue && i.itemcode.Value.ToString().Contains(term, StringComparison.OrdinalIgnoreCase))
            );
        }
    }

    private async Task HandleItemDoubleClick(ItemSalesReportItemDto item)
    {
        selectedItem = item;
        await LoadReportPreview();
    }

    private async Task FetchItemReport()
    {
        if (selectedItem == null || selectedItem.itemcode == null)
        {
            ToastService.ShowWarning("Please select a medicine first.");
            return;
        }

        isGeneratingReport = true;
        itemReportData = null;
        StateHasChanged();

        try
        {
            var client = CreateClient();
            string fromStr = selectedFromDate.ToString("yyyy-MM-dd");
            string toStr = selectedToDate.ToString("yyyy-MM-dd");
            long itemCode = selectedItem.itemcode.Value;
            string saleType = string.IsNullOrEmpty(selectedSalesType) ? "ALL" : selectedSalesType;

            string[] endpoints = new[]
            {
                $"api/Report/item-sales-report/details?itemcode={itemCode}&fromdate={fromStr}&todate={toStr}&salestype={saleType}&warehousecode={selectedWarehouseCode}",
                $"api/Report/getitempatientsalesreport?itemcode={itemCode}&fromdate={fromStr}&todate={toStr}&salestype={saleType}&warehousecode={selectedWarehouseCode}"
            };

            HttpResponseMessage? resp = null;
            string errorDetails = "";
            foreach (var ep in endpoints)
            {
                try
                {
                    resp = await client.GetAsync(ep);
                    if (resp.IsSuccessStatusCode) break;
                    else
                    {
                        errorDetails = await resp.Content.ReadAsStringAsync();
                    }
                }
                catch (Exception ex)
                {
                    errorDetails = ex.Message;
                }
            }

            if (resp != null && resp.IsSuccessStatusCode)
            {
                var contentStr = await resp.Content.ReadAsStringAsync();
                var opt = new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true,
                    NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                };

                using var doc = JsonDocument.Parse(contentStr);
                JsonElement targetElement = doc.RootElement;
                if (doc.RootElement.ValueKind == JsonValueKind.Object)
                {
                    if (doc.RootElement.TryGetProperty("data", out var dEl)) targetElement = dEl;
                    else if (doc.RootElement.TryGetProperty("Data", out var dEl2)) targetElement = dEl2;
                }

                itemReportData = JsonSerializer.Deserialize<ItemSalesReportResponse>(targetElement.GetRawText(), opt);
                if (itemReportData == null)
                {
                    ToastService.ShowError("Received empty report details from server.");
                }
            }
            else
            {
                ToastService.ShowError(string.IsNullOrWhiteSpace(errorDetails) ? "Failed to load report from server." : errorDetails);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading report: {ex.Message}");
        }
        finally
        {
            isGeneratingReport = false;
            StateHasChanged();
        }
    }

    private async Task ExportItemReportToCsv()
    {
        if (itemReportData == null || itemReportData.transactions == null || !itemReportData.transactions.Any())
        {
            ToastService.ShowWarning("No transaction data available to export.");
            return;
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Bill No,Date,Particulars,Type,Batch,Expiry,Receive (In),Issue (Out),Balance,Rate,Amount");

        foreach (var r in itemReportData.transactions)
        {
            string billNo = $"\"{r.bill_no?.Replace("\"", "\"\"")}\"";
            string dateStr = $"\"{FormatReportDate(r.trans_date)}\"";
            string part = $"\"{r.particulars?.Replace("\"", "\"\"")}\"";
            string type = $"\"{(string.IsNullOrEmpty(r.sales_type) ? r.transaction_type : r.sales_type)}\"";
            string batch = $"\"{r.batch_no?.Replace("\"", "\"\"")}\"";
            string expiry = $"\"{FormatExpiryDate(r.expiry_date)}\"";
            decimal rec = r.receive_qty ?? 0;
            decimal iss = r.issue_qty ?? 0;
            decimal bal = r.balance_qty ?? 0;
            decimal rate = r.rate ?? 0;
            decimal amt = r.total_amount ?? 0;

            sb.AppendLine($"{billNo},{dateStr},{part},{type},{batch},{expiry},{rec},{iss},{bal},{rate},{amt}");
        }

        string fileName = $"{itemReportData.item?.itemname ?? "Item"}_Ledger.csv";
        fileName = string.Join("_", fileName.Split(System.IO.Path.GetInvalidFileNameChars()));

        await JS.InvokeVoidAsync("downloadCsvFile", sb.ToString(), fileName);
        ToastService.ShowSuccess("CSV exported successfully.");
    }

    private string FormatReportDate(string? d)
    {
        if (string.IsNullOrWhiteSpace(d)) return "-";
        if (DateTime.TryParse(d, out var dt))
        {
            return dt.ToString("dd/MM/yyyy");
        }
        return d;
    }

    private string FormatExpiryDate(string? d)
    {
        if (string.IsNullOrWhiteSpace(d)) return "-";
        if (DateTime.TryParse(d, out var dt))
        {
            return dt.ToString("dd/MM/yyyy");
        }
        return d;
    }

