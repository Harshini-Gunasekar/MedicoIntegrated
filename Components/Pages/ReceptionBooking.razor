    private async Task RescheduleBookingAsync()
    {
        if (selectedBookingToReschedule == null) return;

        if (selectedRescheduleSlot == null)
        {
            ToastService.ShowError("Please select a new available time slot!");
            return;
        }

        if (string.IsNullOrWhiteSpace(rescheduleReason))
        {
            ToastService.ShowError("Please enter a reason for rescheduling!");
            return;
        }

        bookingInProgress = true;
        try
        {
            var req = new RescheduleAppointmentRequest
            {
                old_booking_id = selectedBookingToReschedule.booking_id,
                booking_type = selectedBookingToReschedule.booking_type,
                reschedule_reason = rescheduleReason,
                new_booking = new AppointmentBookingModel
                {
                    custid = selectedBookingToReschedule.custid,
                    dcode = rescheduleDcode, // Assign selected new doctor!
                    slot_detail_id = selectedRescheduleSlot.slot_detail_id,
                    slot_master_id = selectedRescheduleSlot.slot_master_id,
                    appointment_date = selectedRescheduleSlot.appointment_date,
                    slot_start_time = selectedRescheduleSlot.slot_start_time,
                    slot_end_time = selectedRescheduleSlot.slot_end_time,
                    booking_type = selectedBookingToReschedule.booking_type,
                    notes = selectedBookingToReschedule.notes,
                    isdeleted = false
                }
            };

            var success = await BookingService.RescheduleAppointmentAsync(req);
            if (success)
            {
                ToastService.ShowSuccess("Appointment rescheduled successfully!");
                showRescheduleModal = false;
                await LoadBookingsAsync();
            }
            else
            {
                ToastService.ShowError("Failed to reschedule on the Medico API.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Rescheduling error: {ex.Message}");
        }
        finally
        {
            bookingInProgress = false;
        }
    }

