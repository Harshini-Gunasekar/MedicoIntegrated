            return;
        }

        walkinDcode = 0;
        walkinDate = DateTime.UtcNow.ToIndianTime().Date;
        walkinCustid = 0;
        walkinNotes = string.Empty;
        selectedWalkinSlot = null;
        walkinSlots.Clear();
        showWalkinModal = true;
        isWalkinMinimized = false;
        
        patientSearchQuery = "";
