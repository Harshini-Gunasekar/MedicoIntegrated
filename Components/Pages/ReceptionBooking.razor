    private async Task UpdateBookingStatus(AppointmentBookingModel booking, string newStatus)
    {
        if (newStatus == "CONFIRMED")
        {
            var today = DateOnly.FromDateTime(DateTime.UtcNow.ToIndianTime());
            if (booking.appointment_date > today)
            {
                ToastService.ShowError("Cannot confirm bookings for future dates.");
                selectRefreshKey++; // Force dropdown to reset
                return;
            }

            try
            {
                var docObj = doctors.FirstOrDefault(d => d.dcode == booking.dcode);
                int deptCode = (docObj?.spcode.HasValue == true && docObj.spcode.Value > 0) ? docObj.spcode.Value : 3;

                var opReq = new OPRegistrationModel.OpRegistrationModel
                {
                    booking_id = booking.booking_id,
                    booking_no = booking.booking_no,
                    slot_detail_id = booking.slot_detail_id,
                    custid = booking.custid,
                    dcode = booking.dcode,
                    department_code = deptCode,
                    visit_type = "NEWVISIT",
                    reg_type = "ONLINE",
                    is_direct_walkin = false,
                    notes = "Patient confirmed",
                    visit_date = DateOnly.FromDateTime(DateTime.UtcNow.ToIndianTime())
                };

                await BookingService.RegisterOpAsync(opReq);

                var success = await BookingService.UpdateStatusAsync(booking.booking_id, "CONFIRMED");
                if (success)
                {
                    ToastService.ShowSuccess("Appointment confirmed successfully!");
                    await LoadBookingsAsync();
                }
                else
                {
                    ToastService.ShowError("Failed to update status on the Medico API.");
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Confirmation error: {ex.Message}");
            }
            return;
        }

        try
        {
            var success = await BookingService.UpdateStatusAsync(booking.booking_id, newStatus);
            if (success)
            {
                ToastService.ShowSuccess($"Appointment status set to {newStatus}!");
                await LoadBookingsAsync();
            }
            else
            {
                ToastService.ShowError("Failed to update status on the Medico API.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Status transition error: {ex.Message}");
        }
    }

    // Modal 1: Walk-in Booking logic
    private Dictionary<int, int> doctorAvailableSlotsMap = new();

    private async Task LoadDoctorSlotsStatusAsync()
    {
        doctorAvailableSlotsMap.Clear();
        if (doctors == null || !doctors.Any()) return;

        var dateOnly = DateOnly.FromDateTime(walkinDate);
        var tasks = doctors.Select(async doc =>
        {
            try
            {
                var slots = await BookingService.GetAvailableSlotsAsync(doc.dcode, dateOnly);
                if (slots == null || !slots.Any()) return (dcode: doc.dcode, count: 0);

                var totalAvail = slots.Sum(s => 
                    s.remaining_online > 0 ? s.remaining_online : 
                    (s.remaining_seats > 0 ? s.remaining_seats : 
                    (s.remaining_walkin > 0 ? s.remaining_walkin : 
                    Math.Max(0, s.max_patients - s.patient_count)))
                );
                return (dcode: doc.dcode, count: totalAvail);
            }
            catch
            {
                return (dcode: doc.dcode, count: 0);
            }
        });

        var results = await Task.WhenAll(tasks);
        foreach (var r in results)
        {
            doctorAvailableSlotsMap[r.dcode] = r.count;
        }
        StateHasChanged();
    }

