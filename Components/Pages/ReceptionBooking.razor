@page "/booking/reception"
@rendermode InteractiveServer
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.AppointmentBookingService BookingService
@inject Booking.Services.ToastService ToastService
@inject NavigationManager Navigation
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.LabSettingService LabSettingService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject Booking.Services.WalkinStateService WalkinStateSvc
@implements IDisposable
@using Booking.Helpers
@using Medico_Backend.Model

<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
    <div class="pattern-overlay"></div>
</div>

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <div class="dashboard-title">
            <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                <h1 style="margin-bottom: 0;">Reception Scheduling Portal</h1>
                <span class="kutty-user-badge" title="Total users/patients matching current filters">
                    <i class="bi bi-people-fill"></i> @filteredBookings.Count @(filteredBookings.Count == 1 ? "User" : "Users")
                </span>
            </div>
            <p style="margin-top: 0.25rem;">Monitor patient queues, verify bookings, transition statuses, and handle rescheduling pipelines.</p>
        </div>
        <div style="display:flex; gap:0.5rem; align-items: center; position: relative;">
            <button class="btn-header-action secondary" @onclick="() => showStatsPopover = !showStatsPopover" style="height: 38px;">
                <i class="bi bi-bar-chart-fill" style="color: #0284c7;"></i>
                <span>@(showStatsPopover ? "Hide Stats" : "Show Stats")</span>
            </button>
            <button class="btn-header-action secondary" @onclick="LoadBookingsAsync" disabled="@loading" style="height: 38px;">
                <i class="bi bi-arrow-clockwise"></i> Refresh Queue
            </button>
            @if (TenantState.HasActionRight("Reception", "Refferal Case & Collection", "Edit"))
            {
                <button class="btn-header-action secondary" @onclick="OpenRescheduleWholeSlotModal" style="height: 38px;">
                    <i class="bi bi-arrow-left-right"></i> Move Whole Slot
                </button>
            }
            <button class="btn-header-action" @onclick="OpenWalkinModal" style="height: 38px;">
                <i class="bi bi-plus-circle"></i> Add Walk-in
            </button>

            @if (showStatsPopover)
            {
                <div class="stats-popup-card">
                    <div class="stats-popup-header">
                        <span>DASHBOARD SUMMARY STATS</span>
                        <button type="button" class="close-btn" @onclick="() => showStatsPopover = false">&times;</button>
                    </div>
                    <div class="stats-popup-list">
                        <div class="stat-popup-item blue">
                            <i class="bi bi-calendar3"></i>
                            <span class="label">Total Scheduled</span>
                            <span class="num">@filteredBookings.Count</span>
                        </div>
                        <div class="stat-popup-item orange">
                            <i class="bi bi-hourglass-split"></i>
                            <span class="label">Pending</span>
                            <span class="num">@filteredBookings.Count(b => b.booking_status == "BOOKED")</span>
                        </div>
                        <div class="stat-popup-item green">
                            <i class="bi bi-check2-all"></i>
                            <span class="label">Confirmed/Served</span>
                            <span class="num">@filteredBookings.Count(b => b.booking_status == "CONFIRMED" || b.booking_status == "COMPLETED" || b.booking_status == "VISITED")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Live Filters Control Board -->
    <div class="filters-card">
        <div class="filters-row">
            <div class="filter-group">
                <label>Filter Date</label>
                <input type="date" class="filter-control" @bind="filterDate" @bind:after="OnFiltersChanged" />
            </div>
            <div class="filter-group">
                <label>Doctor Specialist</label>
                <select class="filter-control" @bind="filterDoctor" @bind:after="OnFiltersChanged">
                    <option value="0">All Specialists</option>
                    @foreach (var doc in doctors)
                    {
                        <option value="@doc.dcode">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Status</label>
                <select class="filter-control" @bind="filterStatus" @bind:after="OnFiltersChanged">
                    <option value="ALL">All Statuses</option>
                    <option value="BOOKED">BOOKED</option>
                    <option value="CONFIRMED">CONFIRMED</option>
                    <option value="CANCELLED">CANCELLED</option>
                    <option value="RESCHEDULED">RESCHEDULED</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Booking Type</label>
                <select class="filter-control" @bind="filterType" @bind:after="OnFiltersChanged">
                    <option value="ALL">All Types</option>
                    <option value="ONLINE">ONLINE</option>
                    <option value="WALKIN">WALKIN</option>
                </select>
            </div>
            @if (labSetting.is_slot_required != false)
            {
                <div class="filter-group">
                    <label>Time Slot</label>
                    <select class="filter-control" @bind="filterSlot" @bind:after="OnFiltersChanged">
                        <option value="ALL">All Slots</option>
                        @foreach (var slot in GetDistinctSlots())
                        {
                            <option value="@slot.Value">@slot.Text</option>
                        }
                    </select>
                </div>
            }
            <div class="filter-group">
                <label>Search Patient / Doctor</label>
                <input type="text" class="filter-control" @bind="filterSearch" @bind:event="oninput" @bind:after="OnFiltersChanged" placeholder="e.g. CUST-1001, 2026..." />
            </div>
            <div style="display:flex; gap:0.5rem; align-self: flex-end;">
                <button class="btn-header-action secondary" style="height:38px; padding:0 1rem;" @onclick="ClearFilters">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </button>
            </div>
        </div>
    </div>

    <!-- Live Queue Board Table -->
    <div class="table-card">
        <div class="table-bar-header">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <i class="bi bi-person-lines-fill" style="color: #026aa7; font-size: 1.1rem;"></i>
                <span style="font-weight: 700; color: #1e293b; font-size: 0.95rem;">Queue Appointments</span>
                @{
                    var baseList = allBookings.AsQueryable();
                    if (filterDate.HasValue)
                    {
                        var dOnly = DateOnly.FromDateTime(filterDate.Value);
                        baseList = baseList.Where(b => b.appointment_date == dOnly);
                    }
                    if (filterDoctor > 0)
                    {
                        baseList = baseList.Where(b => b.dcode == filterDoctor);
                    }
                    var baseListItems = baseList.ToList();

                    int totalCnt = baseListItems.Count;
                    int bookedCnt = baseListItems.Count(b => string.IsNullOrEmpty(b.booking_status) || b.booking_status.Equals("BOOKED", StringComparison.OrdinalIgnoreCase));
                    int confirmedCnt = baseListItems.Count(b => !string.IsNullOrEmpty(b.booking_status) && b.booking_status.Equals("CONFIRMED", StringComparison.OrdinalIgnoreCase));
                    int cancelledCnt = baseListItems.Count(b => !string.IsNullOrEmpty(b.booking_status) && b.booking_status.Equals("CANCELLED", StringComparison.OrdinalIgnoreCase));
                }
                <span class="kutty-user-badge alt @(filterStatus == "ALL" ? "active-filter" : "")" style="cursor: pointer;" title="Click to view all appointments" @onclick='() => SetStatusFilter("ALL")'>
                    <i class="bi bi-people-fill me-1"></i> Total: @totalCnt
                </span>
                <span class="kutty-user-badge status-booked @(filterStatus == "BOOKED" ? "active-filter" : "")" style="cursor: pointer;" title="Click to filter Booked appointments" @onclick='() => SetStatusFilter("BOOKED")'>
                    <i class="bi bi-hourglass-split me-1"></i> Booked: @bookedCnt
                </span>
                <span class="kutty-user-badge status-confirmed @(filterStatus == "CONFIRMED" ? "active-filter" : "")" style="cursor: pointer;" title="Click to filter Confirmed appointments" @onclick='() => SetStatusFilter("CONFIRMED")'>
                    <i class="bi bi-check-circle-fill me-1"></i> Confirmed: @confirmedCnt
                </span>
                <span class="kutty-user-badge status-cancelled @(filterStatus == "CANCELLED" ? "active-filter" : "")" style="cursor: pointer;" title="Click to filter Cancelled appointments" @onclick='() => SetStatusFilter("CANCELLED")'>
                    <i class="bi bi-x-circle-fill me-1"></i> Cancelled: @cancelledCnt
                </span>
            </div>
            @if (filteredBookings.Any())
            {
                <span style="font-size: 0.8rem; color: #64748b; font-weight: 600;">
                    Page @currentPage of @((int)Math.Ceiling((double)filteredBookings.Count / pageSize))
                </span>
            }
        </div>
        @if (loading)
        {
            <div style="text-align: center; padding: 4rem; color: #026aa7;">
                <div class="spinner-border" role="status" style="width: 3rem; height: 3rem; margin-bottom: 1rem;"></div>
                <p style="font-weight: 600;">Updating scheduler logs...</p>
            </div>
        }
        else
        {
            @if (filteredBookings.Any())
            {
                <div class="table-responsive">
                    <table class="medico-table">
                        <thead>
                            <tr>
                                <th>Booking No</th>
                                <th>Patient Name</th>
                                <th>Phone</th>
                                <th>Specialist</th>
                                <th>Time Slot</th>
                                <th>Type</th>
                                <th>Notes</th>
                                <th>Status</th>
                                <th style="text-align:center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var pagedBookings = filteredBookings.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
                            }
                            @foreach (var book in pagedBookings)
                            {
                                var displayType = book.booking_type;
                                var displayNotes = book.notes ?? "-";
                                if (book.booking_type == "ONLINE" && book.notes != null && book.notes.StartsWith("[WALKIN]"))
                                {
                                    displayType = "WALKIN";
                                    displayNotes = book.notes.Substring("[WALKIN]".Length).Trim();
                                    if (string.IsNullOrWhiteSpace(displayNotes)) displayNotes = "-";
                                }
                                <tr class="@(book.isvip == true || book.is_vip == true ? "vip-row" : "")">
                                    <td style="font-weight: 800; color: #026aa7;">#@book.booking_no</td>
                                    <td>
                                        <span style="font-weight: 700; color: #334155;">@GetPatientName(book)</span>
                                        @{
                                            var bookVipRole = (book.isvip == true || book.is_vip == true)
                                                ? (!string.IsNullOrWhiteSpace(book.viprole) ? book.viprole : GetPatientVipRole(book))
                                                : string.Empty;
                                        }
                                        @if (book.isvip == true || book.is_vip == true)
                                        {
                                            <span class="vip-badge" style="background: #fffbeb; border: 1px solid #fde68a; color: #d97706; padding: 2px 6px; border-radius: 4px; font-weight: 700; font-size: 0.7rem; margin-left: 8px; display: inline-flex; align-items: center; gap: 2px;" title="VIP Patient">&#11088; VIP</span>
                                            @if (!string.IsNullOrWhiteSpace(bookVipRole))
                                            {
                                                <span style="font-size: 0.68rem; color: #b45309; font-weight: 600; margin-left: 4px; background: #fef3c7; border: 1px solid #fde68a; border-radius: 3px; padding: 1px 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px; display: inline-block; vertical-align: middle;" title="@bookVipRole">@bookVipRole</span>
                                            }
                                        }
                                    </td>
                                    <td><span style="color: #64748b; font-weight: 600;">@GetPatientPhone(book)</span></td>
                                    <td style="font-weight: 700; color: #334155;">Dr. @GetDoctorName(book.dcode)</td>
                                    <td>
                                        @if (book.slot_start_time == default(TimeOnly) && book.slot_end_time == default(TimeOnly))
                                        {
                                            <span class="text-muted" style="margin-left: 14px; font-weight: 700;">-</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-clock" style="color:#94a3b8; margin-right:4px;"></i>
                                            @($"{FormatTime(book.slot_start_time)} - {FormatTime(book.slot_end_time)}")
                                        }
                                    </td>
                                    <td>
                                        <span class="badge-type @displayType.ToLower()">@displayType</span>
                                    </td>
                                    <td style="font-size: 0.8rem; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@displayNotes">
                                        @displayNotes
                                    </td>
                                    <td>
                                        <select class="status-dropdown @book.booking_status.ToLower()" 
                                                @key="@($"{book.booking_id}_{selectRefreshKey}")"
                                                value="@book.booking_status"
                                                disabled='@(book.booking_status == "CANCELLED" || book.booking_status == "CONFIRMED" || book.booking_status == "RESCHEDULED" || !TenantState.HasActionRight("Reception", "Refferal Case & Collection", "Edit"))'
                                                @onchange='(e) => UpdateBookingStatus(book, e.Value?.ToString() ?? "")'>
                                            <option value="BOOKED">Booked</option>
                                            <option value="CONFIRMED">Confirm</option>
                                            
                                            @if (book.booking_status == "RESCHEDULED")
                                            {
                                                <option value="RESCHEDULED">Rescheduled</option>
                                            }
                                            @if (book.booking_status == "CANCELLED")
                                            {
                                                <option value="CANCELLED">Cancelled</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <div class="action-buttons-cell" style="justify-content: center;">
                                            @if (book.booking_status == "BOOKED")
                                            {
                                                @if (TenantState.HasActionRight("Reception", "Refferal Case & Collection", "Edit"))
                                                {
                                                    <button class="btn-table-action reschedule" title="Reschedule Single Slot" @onclick="() => OpenRescheduleModal(book)">
                                                        <i class="bi bi-calendar2-range"></i>
                                                    </button>
                                                }
                                                @if (TenantState.HasActionRight("Reception", "Refferal Case & Collection", "Delete"))
                                                {
                                                    <button class="btn-table-action cancel" title="Cancel Appointment" @onclick="() => OpenCancelModal(book)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            }
                                            @if (book.booking_status == "CONFIRMED")
                                            {
                                                <span style="font-size: 0.75rem; color:#10b981; font-weight:700;">
                                                    Confirmed
                                                </span>
                                            }
                                            @if (book.booking_status == "RESCHEDULED")
                                            {
                                                <span style="font-size: 0.75rem; color:#d97706; font-weight:600;" title="@book.reschedule_reason">
                                                    Rescheduled
                                                </span>
                                            }
                                            @if (book.booking_status == "CANCELLED")
                                            {
                                                <span style="font-size: 0.75rem; color:#ef4444; font-weight:600;" title="@book.cancel_reason">
                                                    Cancelled
                                                </span>
                                            }
                                            @if (book.booking_status == "COMPLETED" || book.booking_status == "VISITED")
                                            {
                                                <span style="font-size: 0.75rem; color:#10b981; font-weight:600;">
                                                    Completed
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (filteredBookings.Any())
                {
                    var totalItems = filteredBookings.Count;
                    var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
                    if (totalPages > 1)
                    {
                        <div class="pagination-footer">
                            <div class="pagination-info">
                                Showing <span class="pagination-info-highlight">@(((currentPage - 1) * pageSize) + 1)</span> to <span class="pagination-info-highlight">@(Math.Min(currentPage * pageSize, totalItems))</span> of <span class="pagination-info-highlight">@totalItems</span> entries
                            </div>
                            <div class="pagination-btns">
                                <button class="page-btn" disabled="@(currentPage == 1)" @onclick="() => currentPage = 1" title="First Page">&laquo;</button>
                                <button class="page-btn" disabled="@(currentPage == 1)" @onclick="() => currentPage--" title="Previous Page">&lsaquo;</button>

                                @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                                {
                                    var pageNum = p;
                                    <button class="page-btn @(currentPage == pageNum ? "active" : "")" @onclick="() => currentPage = pageNum">@pageNum</button>
                                }

                                <button class="page-btn" disabled="@(currentPage == totalPages)" @onclick="() => currentPage++" title="Next Page">&rsaquo;</button>
                                <button class="page-btn" disabled="@(currentPage == totalPages)" @onclick="() => currentPage = totalPages" title="Last Page">&raquo;</button>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <div style="text-align: center; padding: 4rem; color: #64748b;">
                    <i class="bi bi-calendar-x" style="font-size: 3rem; display: block; margin-bottom: 1rem; color: #cbd5e1;"></i>
                    <p style="font-size: 1.1rem; font-weight: 600;">No scheduled appointments match the current filters.</p>
                </div>
            }
        }
    </div>
</div>

<!-- MODAL 1: WALK-IN BOOKING MODAL -->
@if (showWalkinModal && !isWalkinMinimized)
{
    <div class="modal-backdrop" @onclick="CloseWalkinModal"></div>
    <div class="glass-modal" style="max-width: 780px; width: 95%;">
        <div class="modal-header" style="padding: 1.25rem 2rem; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <i class="bi bi-person-plus-fill" style="color: #026aa7; font-size: 1.2rem;"></i>
                <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700;">Add Walk-in Appointment</h3>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <button type="button" class="btn btn-sm" @onclick="ToggleWalkinMinimize" title="Minimize card to bottom right rounded capsule" style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 8px; padding: 4px 10px; font-size: 0.82rem; font-weight: 700; color: #475569; display: flex; align-items: center; gap: 4px;">
                    <i class="bi bi-dash-lg"></i> Minimize
                </button>
                <button class="close-btn" @onclick="CloseWalkinModal">×</button>
            </div>
        </div>
        <div class="modal-body" style="padding: 1.75rem 2rem;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start;">
                <!-- Left Column: Form Fields -->
                <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                    <!-- 1. Patient Selection -->
                    <div class="form-group" style="margin-bottom: 0; position: relative;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <label style="margin: 0; font-weight: 600;">Search Patient MobileNo <span style="color:#ef4444;">*</span></label>
                            <button type="button" class="btn btn-sm" @onclick="OpenAddNewPatientModal" style="font-size: 0.78rem; font-weight: 700; padding: 2px 10px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px; border: 1px solid #026aa7; color: #026aa7; background: #f0f9ff;">
                                <i class="bi bi-person-plus-fill"></i> + Add New Patient
                            </button>
                        </div>
                        <div class="autocomplete-search-wrapper">
                            <input type="text" class="filter-control" placeholder="Search Patient MobileNo..."
                                   value="@patientSearchQuery" @oninput="OnPatientSearchInput" @onkeydown="OnPatientSearchKeyDown" style="height: 42px; border-radius: 8px; width: 100%;" />
                            @if (showPatientDropdown && searchedPatients.Count > 0)
                            {
                                <div class="autocomplete-dropdown">
                                    @for (int i = 0; i < searchedPatients.Count; i++)
                                    {
                                        var patIdx = i;
                                        var pat = searchedPatients[i];
                                        <div class="autocomplete-item @(patIdx == activePatientIndex ? "active-focused" : "")" 
                                             @onclick="() => SelectCustomerPatient(pat)"
                                             @onmouseover="() => activePatientIndex = patIdx">
                                            <div>
                                                <span style="font-weight: 600; color: #0f172a;">@pat.name (CUST-@pat.custid)</span>
                                                <div style="font-size: 0.8em; color: #64748b;">
                                                    📞 @pat.mobile
                                                </div>
                                            </div>
                                            <span class="autocomplete-code">@pat.custcode</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 2. Appointment Date -->
                    <div class="form-group" style="margin-bottom: 0;">
                        <label>Appointment Date</label>
                        <input type="date" class="filter-control" @bind="walkinDate" @bind:after="OnWalkinDoctorOrDateChanged" style="height: 42px; border-radius: 8px;" />
                    </div>

                    <!-- 3. Doctor Selection -->
                    <div class="form-group" style="margin-bottom: 0;">
                        <label>Select Doctor Specialist</label>
                        <div class="doctor-selector-wrapper">
                            <button type="button" class="doctor-selector-button @(showWalkinDoctorDropdown ? "active" : "")" @onclick="() => showWalkinDoctorDropdown = !showWalkinDoctorDropdown">
                                <span>
                                    @if (walkinDcode > 0)
                                    {
                                        @($"Dr. {(doctors.FirstOrDefault(d => d.dcode == walkinDcode)?.name ?? "Selected")}")
                                    }
                                    else
                                    {
                                        <span style="color: #94a3b8;">Select Doctor</span>
                                    }
                                </span>
                                <i class="bi bi-chevron-down dropdown-icon"></i>
                            </button>
                            @if (showWalkinDoctorDropdown)
                            {
                                <div class="doctor-selector-dropdown">
                                    @foreach (var doc in doctors)
                                    {
                                        var avail = doctorAvailableSlotsMap.ContainsKey(doc.dcode) ? doctorAvailableSlotsMap[doc.dcode] : -1;
                                        var rawName = string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname ?? "Specialist" : doc.name;
                                        var docName = rawName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? rawName : $"Dr. {rawName}";
                                        var isSelected = walkinDcode == doc.dcode;
                                        var hasSlots = labSetting.is_slot_required != false ? avail > 0 : true;

                                        <div class="doctor-option-item @(isSelected ? "selected" : "")" 
                                             @onclick="async () => { walkinDcode = doc.dcode; showWalkinDoctorDropdown = false; await OnWalkinDoctorOrDateChanged(); }">
                                            <div class="doctor-availability-indicator @(hasSlots ? "available" : "unavailable")">
                                                @if (hasSlots)
                                                {
                                                    <i class="bi bi-check-circle"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-x-circle"></i>
                                                }
                                            </div>
                                            <div class="doctor-option-content">
                                                <div class="doctor-option-name">@docName</div>
                                                <div class="doctor-option-slots">
                                                    @if (labSetting.is_slot_required != false)
                                                    {
                                                        @if (avail > 0)
                                                        {
                                                            <span>@avail Available Slots</span>
                                                        }
                                                        else
                                                        {
                                                            <span style="color: #ef4444; font-weight: 600;">No Slots Available</span>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 4. Notes -->
                    <div class="form-group" style="margin-bottom: 0;">
                        <label>Notes</label>
                        <textarea class="filter-control" style="min-height:90px; border-radius: 8px; line-height: 1.4; resize: none;" @bind="walkinNotes" @bind:after="SaveWalkinDraftAsync" placeholder="Reason for walk-in consultation..."></textarea>
                    </div>
                </div>

                <!-- Right Column: Slots Selection -->
                <div class="form-group" style="margin-bottom: 0; display: flex; flex-direction: column; height: 100%;">
                    <label>Select Available Time Slot</label>
                    <div style="display: flex; flex-direction: column; min-height: 330px; justify-content: stretch; flex: 1;">
                        @if (loadingWalkinSlots)
                        {
                            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; border: 2px dashed #cbd5e1; border-radius: 12px; background: #f8fafc; padding: 2rem;">
                                <div class="spinner-border text-primary" role="status" style="width: 2rem; height: 2rem; margin-bottom: 1rem; color: #026aa7;"></div>
                                <span style="font-weight: 600; color: #475569; font-size: 0.9rem;">Fetching active slots...</span>
                            </div>
                        }
                        else
                        {
                            @if (walkinDcode > 0)
                            {
                                @if (walkinSlots.Any())
                                {
                                    <div class="slots-subgrid" style="max-height: 330px; flex: 1; overflow-y: auto; margin-top: 0; padding: 0.75rem;">
                                        @foreach (var s in walkinSlots)
                                        {
                                            var isSelected = selectedWalkinSlot?.slot_detail_id == s.slot_detail_id;
                                            var availWalkin = s.remaining_online > 0 ? s.remaining_online :
                                                              (s.remaining_seats > 0 ? s.remaining_seats :
                                                              (s.remaining_walkin > 0 ? s.remaining_walkin :
                                                              (s.max_patients > 0 ? Math.Max(0, s.max_patients - s.patient_count) : Math.Max(0, s.max_online - s.online_count))));
                                            var isFull = availWalkin <= 0;
                                            <div class="slot-subitem @(isSelected ? "selected" : "") @(isFull ? "disabled" : "")" 
                                                 @onclick="async () => { if (!isFull) { selectedWalkinSlot = s; await SaveWalkinDraftAsync(); } }">
                                                <div class="slot-time-text">
                                                    <i class="bi bi-clock me-1"></i>
                                                    @s.slot_start_time.ToString("hh:mm tt") - @s.slot_end_time.ToString("hh:mm tt")
                                                </div>
                                                <div class="slot-ratio-badge @(isFull ? "full" : "")">@availWalkin Available</div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; border: 1.5px solid #fca5a5; border-radius: 12px; background: #fef2f2; padding: 2rem; text-align: center; color: #b91c1c;">
                                        <i class="bi bi-exclamation-circle-fill" style="font-size: 2rem; margin-bottom: 0.75rem;"></i>
                                        <span style="font-weight: 700; font-size: 0.95rem;">No active slots found on this day.</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; border: 2px dashed #cbd5e1; border-radius: 14px; background: #f8fafc; padding: 2rem; text-align: center; color: #64748b;">
                                    <i class="bi bi-calendar3" style="font-size: 2.5rem; color: #94a3b8; margin-bottom: 1rem;"></i>
                                    <span style="font-weight: 700; color: #475569; font-size: 0.95rem; margin-bottom: 0.25rem;">Available Time Slots</span>
                                    <p style="font-size: 0.8rem; color: #64748b; margin: 0; max-width: 220px; line-height: 1.4;">Select a doctor specialist and date on the left to display slots.</p>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer" style="padding: 1.25rem 2rem;">
            <button class="btn-modal cancel" @onclick="CloseWalkinModal">Cancel</button>
            <button class="btn-modal confirm" @onclick="BookWalkinAsync" disabled="@(selectedWalkinSlot == null || walkinCustid <= 0 || bookingInProgress)">
                @if (bookingInProgress)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                }
                Add Walk-in
            </button>
        </div>
    </div>
}

<!-- MODAL 2: CANCEL BOOKING MODAL -->
@if (showCancelModal)
{
    <div class="modal-backdrop" @onclick="CloseCancelModal"></div>
    <div class="glass-modal" style="max-width:450px;">
        <div class="modal-header">
            <h3>Cancel Appointment</h3>
            <button class="close-btn" @onclick="CloseCancelModal">×</button>
        </div>
        <div class="modal-body">
            <div class="info-alert-panel" style="background:#fef2f2; color:#b91c1c; border-color:#fca5a5; margin-bottom:1.25rem;">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>Are you sure you want to cancel this booking? This decrement slot bookings.</span>
            </div>
            <div class="form-group">
                <label>Cancellation Reason <span style="color:#ef4444;">*</span></label>
                <textarea class="filter-control" style="min-height:90px;" @bind="cancelReason" placeholder="Enter reason (e.g. Patient not available, Doctor emergency)..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-modal cancel" @onclick="CloseCancelModal">Keep Appointment</button>
            <button class="btn-modal danger" @onclick="CancelBookingAsync" disabled="@(string.IsNullOrWhiteSpace(cancelReason) || bookingInProgress)">
                @if (bookingInProgress)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                }
                Cancel Appointment
            </button>
        </div>
    </div>
}

<!-- MODAL 3: RESCHEDULE SINGLE APPOINTMENT MODAL -->
@if (showRescheduleModal)
{
    <div class="modal-backdrop" @onclick="CloseRescheduleModal"></div>
    <div class="glass-modal" style="max-width: 780px; width: 95%;">
        <div class="modal-header" style="padding: 1.25rem 2rem;">
            <h3>Reschedule Appointment</h3>
            <button class="close-btn" @onclick="CloseRescheduleModal">×</button>
        </div>
        <div class="modal-body" style="padding: 1.75rem 2rem;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start;">
                <!-- Left Column: Form Fields & Details -->
                <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                    <div class="reschedule-original-summary" style="margin-bottom: 0; padding: 1.25rem; border-radius: 10px; background: #f8fafc; border: 1px solid #e2e8f0; display:flex; flex-direction:column; justify-content:center;">
                        <div style="font-weight:800; text-transform:uppercase; font-size:0.75rem; margin-bottom:0.6rem; color:#475569; border-bottom:1px solid #cbd5e1; padding-bottom:0.25rem; letter-spacing: 0.5px;">Original Slot</div>
                        <div style="font-size:0.85rem; margin-bottom:0.3rem;">Patient ID: <b>@selectedBookingToReschedule?.custid</b></div>
                        <div style="font-size:0.85rem; margin-bottom:0.3rem;">Doctor: <b>Dr. @GetDoctorName(selectedBookingToReschedule!.dcode)</b></div>
                        <div style="font-size:0.85rem; line-height: 1.4;">Time: <b>@selectedBookingToReschedule.appointment_date.ToString("dd MMM yyyy")</b><br/><b>@FormatTime(selectedBookingToReschedule.slot_start_time) - @FormatTime(selectedBookingToReschedule.slot_end_time)</b></div>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label>Select Doctor Specialist</label>
                        <div class="doctor-selector-wrapper">
                            <button type="button" class="doctor-selector-button @(showRescheduleDoctorDropdown ? "active" : "")" @onclick="() => showRescheduleDoctorDropdown = !showRescheduleDoctorDropdown">
                                <span>
                                    @if (rescheduleDcode > 0)
                                    {
                                        @($"Dr. {(doctors.FirstOrDefault(d => d.dcode == rescheduleDcode)?.name ?? doctors.FirstOrDefault(d => d.dcode == rescheduleDcode)?.doctorfullname ?? "Selected")}")
                                    }
                                    else
                                    {
                                        <span style="color: #94a3b8;">Select Doctor</span>
                                    }
                                </span>
                                <i class="bi bi-chevron-down dropdown-icon"></i>
                            </button>
                            @if (showRescheduleDoctorDropdown)
                            {
                                <div class="doctor-selector-dropdown">
                                    @foreach (var doc in doctors)
                                    {
                                        var isSelected = rescheduleDcode == doc.dcode;
                                        <div class="doctor-option-item @(isSelected ? "selected" : "")" 
                                             @onclick="async () => { rescheduleDcode = doc.dcode; showRescheduleDoctorDropdown = false; await LoadRescheduleSlotsAsync(); }">
                                            <div class="doctor-availability-indicator available">
                                                <i class="bi bi-check-circle"></i>
                                            </div>
                                            <div class="doctor-option-content">
                                                <div class="doctor-option-name">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label>Choose New Date</label>
                        <input type="date" class="filter-control" @bind="rescheduleDate" @bind:after="LoadRescheduleSlotsAsync" style="height:42px; border-radius:8px;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label>Reschedule Reason <span style="color:#ef4444;">*</span></label>
                        <textarea class="filter-control" style="min-height:90px; border-radius: 8px; line-height: 1.4; resize: none;" @bind="rescheduleReason" placeholder="Enter reason (e.g. Patient requested morning slot, Doctor schedule changed)..."></textarea>
                    </div>
                </div>

                <!-- Right Column: Slots Selection -->
                <div class="form-group" style="margin-bottom: 0; display: flex; flex-direction: column; height: 100%;">
                    <label>Select New Available Slot</label>
                    <div style="display: flex; flex-direction: column; min-height: 350px; justify-content: stretch; flex: 1;">
                        @if (loadingRescheduleSlots)
                        {
                            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; border: 2px dashed #cbd5e1; border-radius: 12px; background: #f8fafc; padding: 2rem; min-height: 350px;">
                                <div class="spinner-border text-primary" role="status" style="width: 2rem; height: 2rem; margin-bottom: 1rem; color: #026aa7;"></div>
                                <span style="font-weight: 600; color: #475569; font-size: 0.9rem;">Retrieving available slots...</span>
                            </div>
                        }
                        else
                        {
                            @if (rescheduleSlots.Any())
                            {
                                <div class="slots-subgrid" style="max-height: 330px; flex: 1; overflow-y: auto; margin-top: 0; padding: 0.75rem;">
                                    @foreach (var s in rescheduleSlots)
                                    {
                                        var isSelected = selectedRescheduleSlot?.slot_detail_id == s.slot_detail_id;
                                        var isFull = s.remaining_seats <= 0 && s.booked_count >= s.max_patients;
                                        <div class="slot-subitem @(isSelected ? "selected" : "") @(isFull ? "disabled" : "")" 
                                             @onclick="() => { if (!isFull) selectedRescheduleSlot = s; }"
                                             style="padding: 0.65rem 0.8rem; border-radius: 8px;">
                                            <div style="font-weight: 700; font-size: 0.85rem;">@FormatTime(s.slot_start_time)</div>
                                            <div style="font-size:0.65rem; opacity:0.8; margin-top: 2px;">@s.remaining_seats left</div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; border: 1.5px solid #fca5a5; border-radius: 12px; background: #fef2f2; padding: 2rem; text-align: center; color: #b91c1c;">
                                    <i class="bi bi-exclamation-circle-fill" style="font-size: 2rem; margin-bottom: 0.75rem;"></i>
                                    <span style="font-weight: 700; font-size: 0.95rem;">No active slots found on this day.</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer" style="padding: 1.25rem 2rem;">
            <button class="btn-modal cancel" @onclick="CloseRescheduleModal">Cancel</button>
            <button class="btn-modal confirm" @onclick="RescheduleBookingAsync" disabled="@bookingInProgress">
                @if (bookingInProgress)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                }
                Reschedule Slot
            </button>
        </div>
    </div>
}

<!-- MODAL 4: RESCHEDULE WHOLE SLOT MODAL (Doctor unavailable/leave) -->
@if (showRescheduleWholeSlotModal)
{
    <div class="modal-backdrop" @onclick="CloseRescheduleWholeSlotModal"></div>
    <div class="glass-modal" style="max-width: 950px; width: 95%;">
        <div class="modal-header" style="padding: 1.25rem 2rem;">
            <h3>Reschedule Whole Slot Master</h3>
            <button class="close-btn" @onclick="CloseRescheduleWholeSlotModal">×</button>
        </div>
        <div class="modal-body" style="padding: 1.5rem 2rem;">
            <div class="info-alert-panel" style="margin-bottom: 1.5rem; padding: 0.85rem 1.25rem; font-size: 0.88rem;">
                <i class="bi bi-info-circle-fill" style="margin-right: 8px;"></i>
                <span>Use this when a doctor is on leave or unavailable. All patient bookings under the selected slot will be moved to the new slot.</span>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:2.5rem; margin-bottom:1.5rem;">
                <!-- Source Column (Original Slot) -->
                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:14px; padding:1.75rem; box-shadow: inset 0 1px 3px rgba(0,0,0,0.01);">
                    <h4 style="color:#475569; font-size:0.85rem; font-weight:800; text-transform:uppercase; margin-bottom:1.25rem; border-bottom:1px solid #cbd5e1; padding-bottom:0.5rem; letter-spacing: 0.5px;">SOURCE (Original Slot)</h4>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="font-weight: 700; font-size: 0.82rem; margin-bottom: 0.35rem; color:#475569;">Doctor</label>
                            <div class="doctor-selector-wrapper">
                                <button type="button" class="doctor-selector-button @(showWholeSrcDoctorDropdown ? "active" : "")" @onclick="() => showWholeSrcDoctorDropdown = !showWholeSrcDoctorDropdown" style="height: 42px;">
                                    <span style="font-size: 0.875rem;">
                                        @if (wholeSourceDcode > 0)
                                        {
                                            @($"Dr. {(doctors.FirstOrDefault(d => d.dcode == wholeSourceDcode)?.name ?? doctors.FirstOrDefault(d => d.dcode == wholeSourceDcode)?.doctorfullname ?? "Selected")}")
                                        }
                                        else
                                        {
                                            <span style="color: #94a3b8;">Select Doctor</span>
                                        }
                                    </span>
                                    <i class="bi bi-chevron-down dropdown-icon"></i>
                                </button>
                                @if (showWholeSrcDoctorDropdown)
                                {
                                    <div class="doctor-selector-dropdown">
                                        @foreach (var doc in doctors)
                                        {
                                            var isSelected = wholeSourceDcode == doc.dcode;
                                            <div class="doctor-option-item @(isSelected ? "selected" : "")" 
                                                 @onclick="async () => { wholeSourceDcode = doc.dcode; showWholeSrcDoctorDropdown = false; await OnWholeSourceChanged(); }">
                                                <div class="doctor-availability-indicator available">
                                                    <i class="bi bi-check-circle"></i>
                                                </div>
                                                <div class="doctor-option-content">
                                                    <div class="doctor-option-name" style="font-size: 0.9rem;">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="font-weight: 700; font-size: 0.82rem; margin-bottom: 0.35rem; color:#475569;">Date</label>
                            <input type="date" class="filter-control" @bind="wholeSourceDate" @bind:after="OnWholeSourceChanged" style="padding: 0.5rem 0.75rem; font-size:0.875rem; height:42px; border-radius:8px;" />
                        </div>
                    </div>

                    @if (loadingWholeSourceSlots)
                    {
                        <div style="text-align:center; padding:3rem; color:#026aa7; font-size:0.85rem;">
                            <span class="spinner-border spinner-border-sm" role="status" style="width:18px; height:18px; margin-right:6px;"></span> Fetching source slots...
                        </div>
                    }
                    else
                    {
                        @if (wholeSourceDcode > 0)
                        {
                            <label style="font-size:0.8rem; font-weight:700; color:#475569; display:block; margin-bottom:0.6rem;">Select Original Slot</label>
                            @if (wholeSourceSlots.Any())
                            {
                                <div class="slots-subgrid" style="max-height:260px; padding: 2px;">
                                    @foreach (var s in wholeSourceSlots)
                                    {
                                        var isSel = selectedWholeSourceSlot?.slot_detail_id == s.slot_detail_id;
                                        <div class="slot-subitem @(isSel ? "selected" : "")" @onclick="() => selectedWholeSourceSlot = s" style="font-size:0.85rem; padding:0.65rem 0.85rem; border-radius: 8px;">
                                            <div style="font-weight: 700;">@FormatTime(s.slot_start_time)</div>
                                            <div style="font-size:0.68rem; color:#475569; font-weight:800; margin-top:3px;">Booked: @s.booked_count</div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div style="font-size:0.85rem; color:#dc2626; font-style:italic; padding: 1.5rem 0;">No active slots found on this day.</div>
                            }
                        }
                    }
                </div>

                <!-- Target Column (Destination Slot) -->
                <div style="background:#f0f9ff; border:1px solid #bae6fd; border-radius:14px; padding:1.75rem; box-shadow: inset 0 1px 3px rgba(0,0,0,0.01);">
                    <h4 style="color:#026aa7; font-size:0.85rem; font-weight:800; text-transform:uppercase; margin-bottom:1.25rem; border-bottom:1px solid #93c5fd; padding-bottom:0.5rem; letter-spacing: 0.5px;">TARGET (Destination Slot)</h4>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
