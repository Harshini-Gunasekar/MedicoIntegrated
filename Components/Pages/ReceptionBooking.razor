    private async Task RestoreWalkinDraftAsync()
    {
        try
        {
            if (WalkinStateSvc.HasActiveDraft)
            {
                showWalkinModal = WalkinStateSvc.ShowWalkinModal;
                isWalkinMinimized = WalkinStateSvc.IsWalkinMinimized;
                patientSearchQuery = WalkinStateSvc.PatientSearchQuery ?? "";
                walkinCustid = WalkinStateSvc.WalkinCustid;
                walkinDate = WalkinStateSvc.WalkinDate != default ? WalkinStateSvc.WalkinDate : DateTime.UtcNow.ToIndianTime().Date;
                walkinDcode = WalkinStateSvc.WalkinDcode;
                walkinNotes = WalkinStateSvc.WalkinNotes ?? "";

                if (walkinDcode > 0)
                {
                    await FetchWalkinSlotsQuietlyAsync();
                    if (WalkinStateSvc.SelectedSlotDetailId.HasValue && walkinSlots != null)
                    {
                        selectedWalkinSlot = walkinSlots.FirstOrDefault(s => s.slot_detail_id == WalkinStateSvc.SelectedSlotDetailId.Value);
                    }
                    else
                    {
                        selectedWalkinSlot = WalkinStateSvc.SelectedWalkinSlot;
                    }
                }
                StateHasChanged();
                return;
            }

            var res = await _sessionStorage.GetAsync<string>("WalkinDraftState");
            if (res.Success && !string.IsNullOrWhiteSpace(res.Value))
            {
                var model = Newtonsoft.Json.JsonConvert.DeserializeObject<WalkinDraftModel>(res.Value);
                if (model != null && model.ShowWalkinModal)
                {
                    showWalkinModal = true;
                    isWalkinMinimized = model.IsWalkinMinimized;
                    patientSearchQuery = model.PatientSearchQuery ?? "";
                    walkinCustid = model.WalkinCustid;
                    walkinDate = model.WalkinDate != default ? model.WalkinDate : DateTime.UtcNow.ToIndianTime().Date;
                    walkinDcode = model.WalkinDcode;
                    walkinNotes = model.WalkinNotes ?? "";

                    if (walkinDcode > 0)
                    {
                        await FetchWalkinSlotsQuietlyAsync();
                        if (model.SelectedSlotDetailId.HasValue && walkinSlots != null)
                        {
                            selectedWalkinSlot = walkinSlots.FirstOrDefault(s => s.slot_detail_id == model.SelectedSlotDetailId.Value);
                        }
                    }

                    WalkinStateSvc.ShowWalkinModal = showWalkinModal;
                    WalkinStateSvc.IsWalkinMinimized = isWalkinMinimized;
                    WalkinStateSvc.PatientSearchQuery = patientSearchQuery;
                    WalkinStateSvc.WalkinCustid = walkinCustid;
                    WalkinStateSvc.WalkinDate = walkinDate;
                    WalkinStateSvc.WalkinDcode = walkinDcode;
                    WalkinStateSvc.WalkinNotes = walkinNotes;
                    WalkinStateSvc.SelectedWalkinSlot = selectedWalkinSlot;
                    WalkinStateSvc.SelectedSlotDetailId = selectedWalkinSlot?.slot_detail_id;

                    StateHasChanged();
                }
            }
        }
        catch { }
    }

    private async Task FetchWalkinSlotsQuietlyAsync()
    {
        if (walkinDcode <= 0) return;
        loadingWalkinSlots = true;
        try
        {
            var allSlots = await BookingService.GetAvailableSlotsAsync(walkinDcode, DateOnly.FromDateTime(walkinDate));
            walkinSlots = allSlots ?? new List<AvailableSlotModel>();

            var totalAvail = walkinSlots.Sum(s => 
                s.remaining_online > 0 ? s.remaining_online : 
                (s.remaining_seats > 0 ? s.remaining_seats : 
                (s.remaining_walkin > 0 ? s.remaining_walkin : 
                Math.Max(0, s.max_patients - s.patient_count)))
            );
            doctorAvailableSlotsMap[walkinDcode] = totalAvail;
        }
        catch { }
        finally
        {
            loadingWalkinSlots = false;
        }
    }

    private async Task ClearWalkinDraftAsync()
    {
        WalkinStateSvc.Clear();
        try
        {
            await _sessionStorage.DeleteAsync("WalkinDraftState");
        }
        catch { }
    }

    private void OpenWalkinModal()
    {
        if (WalkinStateSvc.HasActiveDraft)
        {
            showWalkinModal = true;
            isWalkinMinimized = false;
            _ = SaveWalkinDraftAsync();
