                IsWalkinMinimized = isWalkinMinimized,
                PatientSearchQuery = patientSearchQuery,
                WalkinCustid = walkinCustid,
                WalkinDate = walkinDate,
                WalkinDcode = walkinDcode,
                WalkinNotes = walkinNotes,
                SelectedSlotDetailId = selectedWalkinSlot?.slot_detail_id
            };
