    private void ApplyFilters()
    {
        var query = allBookings.AsQueryable();

        // 0. Date filter
        if (filterDate.HasValue)
        {
            var filterDateOnly = DateOnly.FromDateTime(filterDate.Value);
            query = query.Where(b => b.appointment_date == filterDateOnly);
        }

        // 1. Doctor filter
        if (filterDoctor > 0)
        {
            query = query.Where(b => b.dcode == filterDoctor);
        }

        // 2. Status filter
        if (filterStatus != "ALL")
        {
            query = query.Where(b => b.booking_status == filterStatus);
        }

        // 3. Booking Type filter
        if (filterType != "ALL")
        {
            if (filterType == "WALKIN")
            {
                query = query.Where(b => b.booking_type == "WALKIN" || (b.booking_type == "ONLINE" && b.notes != null && b.notes.StartsWith("[WALKIN]")));
            }
            else if (filterType == "ONLINE")
            {
                query = query.Where(b => b.booking_type == "ONLINE" && (b.notes == null || !b.notes.StartsWith("[WALKIN]")));
            }
            else
            {
                query = query.Where(b => b.booking_type == filterType);
            }
        }

        // 4. Time Slot filter
        if (!string.IsNullOrWhiteSpace(filterSlot) && filterSlot != "ALL")
        {
            var parts = filterSlot.Split('_');
            if (parts.Length == 2 && TimeOnly.TryParse(parts[0], out var sStart) && TimeOnly.TryParse(parts[1], out var sEnd))
            {
                query = query.Where(b => b.slot_start_time == sStart && b.slot_end_time == sEnd);
            }
        }

        // 5. Search Filter (by Booking No, Patient ID or Doctor ID/Name)
        if (!string.IsNullOrWhiteSpace(filterSearch))
        {
            var searchLower = filterSearch.Trim().ToLower();
            query = query.Where(b => 
                (b.booking_no != null && b.booking_no.ToLower().Contains(searchLower)) ||
                ("cust-" + b.custid).ToLower().Contains(searchLower) ||
                b.custid.ToString().Contains(searchLower) ||
                ("doc-" + b.dcode).ToLower().Contains(searchLower) ||
                b.dcode.ToString().Contains(searchLower)
            );
        }

        filteredBookings = query.OrderBy(b => b.appointment_date).ThenBy(b => b.slot_start_time).ThenBy(b => b.token_no).ToList();
        currentPage = 1;

        // Recalculate statistics from the current live filtered set
        statsTotal = filteredBookings.Count;
        statsConfirmed = filteredBookings.Count(b => b.booking_status == "CONFIRMED");
        statsCompleted = filteredBookings.Count(b => b.booking_status == "COMPLETED" || b.booking_status == "VISITED");
        statsCancelled = filteredBookings.Count(b => b.booking_status == "CANCELLED");
    }

