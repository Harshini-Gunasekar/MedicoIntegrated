    private async Task RescheduleWholeSlotAsync()
    {
        if (selectedWholeSourceSlot == null || selectedWholeTargetSlot == null) return;
        if (string.IsNullOrWhiteSpace(wholeRescheduleReason))
        {
            ToastService.ShowError("Reschedule Reason is required.");
            return;
        }
        bookingInProgress = true;
        try
        {
            var req = new RescheduleWholeSlotRequest
            {
                slot_master_id = selectedWholeSourceSlot.slot_master_id,
                new_slot_detail_id = selectedWholeTargetSlot.slot_detail_id,
                new_slot_master_id = selectedWholeTargetSlot.slot_master_id,
                new_appointment_date = selectedWholeTargetSlot.appointment_date,
                new_slot_start_time = selectedWholeTargetSlot.slot_start_time,
                new_slot_end_time = selectedWholeTargetSlot.slot_end_time,
                new_dcode = selectedWholeTargetSlot.dcode,
                reschedule_reason = wholeRescheduleReason
            };

            var success = await BookingService.RescheduleWholeSlotAsync(req);
            if (success)
            {
                ToastService.ShowSuccess($"Moved whole slot bookings successfully!");
                showRescheduleWholeSlotModal = false;
                await LoadBookingsAsync();
            }
            else
            {
                ToastService.ShowError("Failed to move whole slot bookings. Ensure target slot has enough remaining capacity.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Slot migration error: {ex.Message}");
        }
        finally
        {
            bookingInProgress = false;
        }
    }
