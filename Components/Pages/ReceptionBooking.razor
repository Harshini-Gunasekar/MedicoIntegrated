                                <button type="button" class="doctor-selector-button @(showWholeTgtDoctorDropdown ? "active" : "")" @onclick="() => showWholeTgtDoctorDropdown = !showWholeTgtDoctorDropdown" style="height: 42px;">
                                    <span style="font-size: 0.875rem;">
                                        @if (wholeTargetDcode > 0)
                                        {
                                            @($"Dr. {(doctors.FirstOrDefault(d => d.dcode == wholeTargetDcode)?.name ?? doctors.FirstOrDefault(d => d.dcode == wholeTargetDcode)?.doctorfullname ?? "Selected")}")
                                        }
                                        else
                                        {
                                            <span style="color: #94a3b8;">Select Doctor</span>
                                        }
                                    </span>
                                    <i class="bi bi-chevron-down dropdown-icon"></i>
                                </button>
                                @if (showWholeTgtDoctorDropdown)
                                {
                                    <div class="doctor-selector-dropdown">
                                        @foreach (var doc in doctors)
                                        {
                                            var isSelected = wholeTargetDcode == doc.dcode;
                                            <div class="doctor-option-item @(isSelected ? "selected" : "")" 
                                                 @onclick="async () => { wholeTargetDcode = doc.dcode; showWholeTgtDoctorDropdown = false; await OnWholeTargetChanged(); }">
                                                <div class="doctor-availability-indicator available">
                                                    <i class="bi bi-check-circle"></i>
                                                </div>
                                                <div class="doctor-option-content">
                                                    <div class="doctor-option-name" style="font-size: 0.9rem;">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="font-weight: 700; font-size: 0.82rem; margin-bottom: 0.35rem; color:#026aa7;">Date</label>
                            <input type="date" class="filter-control" @bind="wholeTargetDate" @bind:after="OnWholeTargetChanged" style="padding: 0.5rem 0.75rem; font-size:0.875rem; height:42px; border-radius:8px;" />
                        </div>
                    </div>

                    @if (loadingWholeTargetSlots)
                    {
                        <div style="text-align:center; padding:3rem; color:#026aa7; font-size:0.85rem;">
                            <span class="spinner-border spinner-border-sm" role="status" style="width:18px; height:18px; margin-right:6px;"></span> Fetching target slots...
                        </div>
                    }
                    else
                    {
                        @if (wholeTargetDcode > 0)
                        {
                            <label style="font-size:0.8rem; font-weight:700; color:#475569; display:block; margin-bottom:0.6rem;">Select New Destination Slot</label>
                            @if (wholeTargetSlots.Any())
                            {
                                <div class="slots-subgrid" style="max-height:260px; padding: 2px;">
                                    @foreach (var s in wholeTargetSlots)
                                    {
                                        var isSel = selectedWholeTargetSlot?.slot_detail_id == s.slot_detail_id;
                                        <div class="slot-subitem @(isSel ? "selected" : "")" @onclick="() => selectedWholeTargetSlot = s" style="font-size:0.85rem; padding:0.65rem 0.85rem; border-radius: 8px;">
                                            <div style="font-weight: 700;">@FormatTime(s.slot_start_time)</div>
                                            <div style="font-size:0.68rem; color:#059669; font-weight:800; margin-top:3px;">Available: @s.remaining_seats</div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div style="font-size:0.85rem; color:#dc2626; font-style:italic; padding: 1.5rem 0;">No active slots found on this day.</div>
                            }
                        }
                    }
                </div>
            </div>

            <div class="form-group" style="margin-top: 1.25rem;">
                <label style="font-weight: 700; font-size: 0.92rem; margin-bottom: 0.5rem; display:block; color:#334155;">Reschedule Reason <span style="color:#ef4444;">*</span></label>
                <textarea class="filter-control" style="min-height:90px; padding: 0.85rem; font-size:0.92rem; border-radius:8px; line-height: 1.4;" @bind="wholeRescheduleReason" placeholder="Reason (e.g. Doctor leave — moved slots)..."></textarea>
            </div>
        </div>
        <div class="modal-footer" style="padding: 1.25rem 2.5rem;">
            <button class="btn-modal cancel" @onclick="CloseRescheduleWholeSlotModal" style="padding: 0.65rem 1.75rem; font-size: 0.92rem;">Cancel</button>
            <button class="btn-modal confirm" @onclick="RescheduleWholeSlotAsync" disabled="@(selectedWholeSourceSlot == null || selectedWholeTargetSlot == null || bookingInProgress)" style="padding: 0.65rem 2rem; font-size: 0.92rem;">
                @if (bookingInProgress)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                }
                Migrate All Bookings
            </button>
        </div>
    </div>
}

<!-- MODAL 5: REGISTER OUTPATIENT MODAL -->
@if (showRegisterModal && selectedBookingForReg != null)
{
    <div class="modal-backdrop" @onclick="CloseRegisterModal"></div>
    <div class="glass-modal">
        <div class="modal-header">
            <h3>Register Outpatient</h3>
            <button class="close-btn" @onclick="CloseRegisterModal">×</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Booking No</label>
                <input type="text" class="filter-control" value="@selectedBookingForReg.booking_no" disabled />
            </div>
            <div class="form-group">
                <label>Visit Type</label>
                <select class="filter-control" @bind="newOpRequest.visit_type">
                    <option value="NEWVISIT">New Visit</option>
                    <option value="FOLLOWUP">Follow-up</option>
                </select>
            </div>
            <div class="form-group">
                <label>Notes</label>
                <textarea class="filter-control" @bind="newOpRequest.notes" placeholder="Enter arrival notes..."></textarea>
            </div>
        </div>
