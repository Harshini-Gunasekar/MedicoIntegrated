    private async Task BookWalkinAsync()
    {
        if (selectedWalkinSlot == null || walkinCustid <= 0) return;
        bookingInProgress = true;
        try
        {
            // Force the booking and OP workflow to ONLINE-only to match the API contract.
            // This prevents the backend from selecting a walk-in token range on slots that do not support it.
            const string resolvedBookingType = "ONLINE";

            string finalNotes = string.IsNullOrWhiteSpace(walkinNotes) ? "Walk-in booking" : walkinNotes;
            finalNotes = finalNotes.Replace("[WALKIN]", string.Empty, StringComparison.OrdinalIgnoreCase).Trim();

            var newBooking = new AppointmentBookingModel
            {
                booking_id = Guid.NewGuid(),
                custid = walkinCustid,
                dcode = walkinDcode,
                slot_detail_id = selectedWalkinSlot.slot_detail_id,
                slot_master_id = selectedWalkinSlot.slot_master_id,
                appointment_date = selectedWalkinSlot.appointment_date,
                slot_start_time = selectedWalkinSlot.slot_start_time,
                slot_end_time = selectedWalkinSlot.slot_end_time,
                booking_type = resolvedBookingType,
                booking_status = "BOOKED",
                notes = finalNotes,
                isdeleted = false
            };

            var docObj = doctors.FirstOrDefault(d => d.dcode == walkinDcode);
            int? deptCode = docObj?.spcode > 0 ? docObj.spcode : 3;

            var (res, opRes, tokenNo, bookingId) = await BookingService.BookAppointmentWithOpRegistrationAsync(newBooking, deptCode);
            if (res.StartsWith("Success", StringComparison.OrdinalIgnoreCase))
            {
                ToastService.ShowSuccess("Walk-in appointment and OP registration created successfully!");
                showWalkinModal = false;
                isWalkinMinimized = false;
                await ClearWalkinDraftAsync();
                await LoadBookingsAsync();
            }
            else
            {
                ToastService.ShowError($"Failed to create booking: {res}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Walk-in creation error: {ex.Message}");
        }
        finally
        {
            bookingInProgress = false;
        }
    }

