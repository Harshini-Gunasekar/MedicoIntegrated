@page "/nurses"
@page "/nurse-master"
@rendermode InteractiveServer

@using Medico_Backend.Model
@using Booking.Services
@using Newtonsoft.Json
@using Booking.Models
@inject NurseMasterService NurseService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">support_agent</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Nurse Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Nurse Staff Directory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search nurses..." @bind="SearchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            <div class="search-controls">
                @if (hasCreateRight)
                {
                    <button class="btn-new-entry" @onclick="NewNurse">+ Add Nurse</button>
                }
            </div>
        </div>
    </div>

    @* --- directory list --- *@
    <div class="directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">NCODE</th>
                        <th style="width: 150px;">SHORT NAME</th>
                        <th>NURSE NAME</th>
                        <th>CONTACT NO</th>
                        <th>NURSE TYPE</th>
                        <th style="width: 180px;">ENTERED DATE</th>
                        <th style="width: 180px;">MODIFIED DATE</th>
                        <th class="text-center" style="width: 120px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (nurses != null && nurses.Any())
                    {
                        @foreach (var n in FilteredNursesBySearch)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"{n.ncode:00}")</span></td>
                                <td class="lc-color-slate-500 lc-font-mono lc-font-700 lc-font-13">@n.shortname</td>
                                <td class="font-bold text-slate-800">@n.nursename</td>
                                <td class="text-slate-700">@(n.ncontact.HasValue ? n.ncontact.Value.ToString("0") : "-")</td>
                                <td><span class="lc-color-slate-600 font-bold">@n.ntype</span></td>
                                <td class="text-slate-400 font-12">@(n.entereddate.HasValue && n.entereddate != default ? n.entereddate.Value.ToString("dd-MM-yyyy hh:mm tt") : "")</td>
                                <td class="text-slate-400 font-12">@(n.ibsdate.HasValue && n.ibsdate != default ? n.ibsdate.Value.ToString("dd-MM-yyyy hh:mm tt") : "")</td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px;">
                                        @if (hasEditRight)
                                        {
                                            <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => EditNurse(n)" title="Edit">
                                                <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                            </button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => PromptDelete(n.ncode)" title="Delete">
                                                <span class="material-symbols-outlined font-18 text-slate-400">delete</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center p-48 text-slate-400 italic">No nurse records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- FORM SECTION (Modal) --- *@
@if (showForm)
{
    <div class="modal-overlay">
        <div class="modal-form-card">
            <div class="modal-header-bar">
                <h3>@(isEditMode ? "Edit Nurse" : "Nurse Entry")</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-0 form-section">
                    <div class="mt-0">
                        @* Line 1: Nurse Name, Short Name *@
                        <div style="display: grid; grid-template-columns: 3.5fr 1fr; gap: 1.25rem;">
                            <div class="form-group position-relative">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label style="margin-bottom: 0;">Nurse Name *</label>
                                    @if (isSubmitted && string.IsNullOrEmpty(current.nursename))
                                    {
                                        <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                    }
                                </div>
                                <input type="text" class="lab-input" @bind="current.nursename" placeholder="e.g. Priya Sharma" required />
                            </div>
                            <div class="form-group">
                                <label>Short Name</label>
                                <input type="text" class="lab-input" @bind="current.shortname" placeholder="e.g. Priya" />
                            </div>
                        </div>

                        @* Line 2: Contact No, Nurse Type *@
                        <div class="um-grid-cols-2">
                            <div class="form-group">
                                <label>Contact No</label>
                                <input type="number" class="lab-input" @bind="current.ncontact" placeholder="e.g. 9876543210" />
                            </div>
                            <div class="form-group">
                                <label>Nurse Type</label>
                                <input type="text" class="lab-input" @bind="current.ntype" placeholder="e.g. Staff Nurse / Head Nurse" />
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            
            <div class="modal-footer-bar">
                <button type="button"
                        class="btn-delete"
                        @onclick="() => PromptDelete(current.ncode)"
                        disabled="@(current.ncode == 0 || !hasDeleteRight)">
                    Delete
                </button>
                <button type="button" class="btn-save" @onclick="SaveNurse">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                    </svg>
                    Save Nurse
                </button>
            </div>
        </div>
    </div>
}

@* --- DELETE CONFIRMATION MODAL --- *@
@if (showDeleteConfirm)
{
    <div class="modal-overlay">
        <div class="modal-form-card delete-confirm-card" style="max-width: 400px; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: white; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
            <div style="text-align: center; margin-bottom: 20px;">
                <p style="margin: 0; font-size: 15px; font-weight: 600; color: #1e293b;">Are you sure you want to delete the nurse?</p>
            </div>
            <div style="display: flex; justify-content: center; gap: 12px; width: 100%;">
                <button type="button" class="btn-secondary-outline" @onclick="CancelDelete" style="flex: 1; max-width: 120px; border-radius: 6px;">Cancel</button>
                <button type="button" class="btn-danger-filled" @onclick="ExecuteDelete" style="flex: 1; max-width: 120px; border-radius: 6px;">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<NurseMasterModel> nurses = new();
    private NurseMasterModel current = new();
    private bool isEditMode = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";
    private bool showDeleteConfirm = false;
    private int deleteNCode = 0;
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    private string TenantCode = "";
    private string AuthToken = "";

    private IEnumerable<NurseMasterModel> FilteredNurses =>
        nurses.Where(n => n.deleted != true);

    private IEnumerable<NurseMasterModel> FilteredNursesBySearch =>
        FilteredNurses.Where(n => 
            string.IsNullOrWhiteSpace(SearchQuery) || 
            (n.nursename != null && n.nursename.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (n.shortname != null && n.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (n.ntype != null && n.ntype.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (n.ncontact.HasValue && n.ncontact.Value.ToString().Contains(SearchQuery)));

    protected override async Task OnInitializedAsync()
    {
        await LoadNurses();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                await LoadNurses();

                try
                {
                    bool isAdmin = false;
                    try
                    {
                        var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                        if (userResult.Success && userResult.Value != null)
                        {
                            isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                      userResult.Value.UserCode == 0 ||
                                      userResult.Value.UserCode == 1;
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error checking user details: {ex.Message}");
                    }

                    if (isAdmin)
                    {
                        hasCreateRight = true;
                        hasEditRight = true;
                        hasDeleteRight = true;
                    }
                    else
                    {
                        var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                        if (rightsResult.Success && rightsResult.Value != null)
                        {
                            var pageRight = rightsResult.Value.FirstOrDefault(r => 
                                r.ModuleName != null && 
                                r.ModuleName.Trim().Equals("Nurse_Master", StringComparison.OrdinalIgnoreCase));
                            
                            if (pageRight != null)
                            {
                                hasCreateRight = pageRight.ToAdd;
                                hasEditRight = pageRight.ToEdit;
                                hasDeleteRight = pageRight.ToDelete;
                            }
                            else
                            {
                                hasCreateRight = false;
                                hasEditRight = false;
                                hasDeleteRight = false;
                            }
                        }
                        else
                        {
                            hasCreateRight = false;
                            hasEditRight = false;
                            hasDeleteRight = false;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking Nurse_Master rights: {ex.Message}");
                    hasCreateRight = false;
                    hasEditRight = false;
                    hasDeleteRight = false;
                }

                StateHasChanged();
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error loading session details: {ex.Message}");
            }
        }
    }

    private async Task LoadNurses()
    {
        try
        {
            nurses = await NurseService.GetNurseMastersAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading nurses: {ex.Message}");
        }
    }

    private void NewNurse()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add nurses.");
            return;
        }
        current = new NurseMasterModel { 
            deleted = false,
            computercode = 1,
            usercode = 1,
            entereddate = DateTime.Now,
            ibsdate = DateTime.Now,
            tenant_code = "TEN007",
            ncontact = null,
            ntype = ""
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private void EditNurse(NurseMasterModel n)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit nurses.");
            return;
        }
        if (n == null) return;
        current = new NurseMasterModel
        {
            ncode = n.ncode,
            tenant_code = n.tenant_code,
            shortname = n.shortname,
            nursename = n.nursename,
            ncontact = n.ncontact,
            ntype = n.ntype,
            deleted = n.deleted,
            usercode = n.usercode,
            computercode = n.computercode,
            entereddate = n.entereddate,
            ibsdate = n.ibsdate
        };
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveNurse()
    {
        if (isEditMode && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit nurses.");
            return;
        }
        if (!isEditMode && !hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add nurses.");
            return;
        }
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(current.nursename))
        {
            ToastService.ShowError("Nurse Name is required.");
            StateHasChanged();
            return;
        }

        try
        {
            current.tenant_code = "TEN007";
            current.computercode = 1;
            current.usercode = 1;
            current.ibsdate = DateTime.Now;

            bool success;
            if (isEditMode)
            {
                success = await NurseService.UpdateNurseMasterAsync(current);
            }
            else
            {
                current.entereddate = DateTime.Now;
                success = await NurseService.InsertNurseMasterAsync(current);
            }

            if (success)
            {
                await LoadNurses();
                ToastService.ShowSuccess(isEditMode ? "Nurse updated successfully!" : "Nurse added successfully!");
                if (isEditMode)
                {
                    showForm = false;
                }
                else
                {
                    NewNurse();
                }
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Save failed on backend.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving nurse: {ex.Message}");
            StateHasChanged();
        }
    }

    private void PromptDelete(int ncode)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete nurses.");
            return;
        }
        if (ncode == 0) return;
        deleteNCode = ncode;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        deleteNCode = 0;
        showDeleteConfirm = false;
    }

    private async Task ExecuteDelete()
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete nurses.");
            return;
        }
        if (deleteNCode == 0) return;
        try
        {
            bool success = await NurseService.DeleteNurseMasterAsync(deleteNCode);
            if (success)
            {
                await LoadNurses();
                ToastService.ShowSuccess("Nurse deleted successfully!");
                if (current != null && current.ncode == deleteNCode)
                {
                    showForm = false;
                }
                showDeleteConfirm = false;
                deleteNCode = 0;
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Delete failed on backend.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting: {ex.Message}");
            StateHasChanged();
        }
    }

    private void CloseForm()
    {
        current = new NurseMasterModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }
}
