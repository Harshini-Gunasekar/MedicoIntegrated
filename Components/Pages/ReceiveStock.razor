                {
                    ItemList = parsed
                        .Where(i => !i.deleted && i.isactive && (string.IsNullOrEmpty(DefaultTenant) || string.IsNullOrEmpty(i.tenantcode) || string.Equals(i.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase)))
                        .OrderBy(i => i.itemname)
                        .ToList();
                }
            }
        }
        catch { }
    }

    private async Task LoadTransfers()
    {
        try
        {
            string url = "http://medicoapi.iscansoft.com/api/ItemMaster/getallstocktransfer";
            if (!string.IsNullOrEmpty(DefaultTenant))
            {
                url += $"?tenantcode={DefaultTenant}";
            }

            Console.WriteLine($"[ReceiveStock] Loading stock transfers from: {url}");

            string response = "";
            try
            {
                using var directClient = new HttpClient();
                if (!string.IsNullOrEmpty(DefaultTenant))
                {
                    directClient.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
                    directClient.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
                }
                response = await directClient.GetStringAsync(url);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ReceiveStock] Error direct fetch from {url}: {ex.Message}. Falling back to configured client.");
                try
                {
                    var client = CreateClient();
                    response = await client.GetStringAsync($"api/ItemMaster/getallstocktransfer?tenantcode={DefaultTenant}");
                }
                catch
                {
                    try
                    {
                        var client = CreateClient();
                        response = await client.GetStringAsync("api/ItemMaster/getallstocktransfer");
                    }
                    catch { }
                }
            }

            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions 
                { 
                    PropertyNameCaseInsensitive = true,
                    NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                };

                try
                {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<stock_transfer_request>>>(response, options);
                    if (wrapped?.data != null && wrapped.data.Any())
                    {
                        var reqs = wrapped.data.Where(r => r.master != null && (string.IsNullOrEmpty(DefaultTenant) || string.IsNullOrEmpty(r.master.tenantcode) || string.Equals(r.master.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase))).ToList();
                        TransferList = reqs.Select(r => r.master).ToList();
                        TransferDetailsMap.Clear();
                        foreach (var r in reqs)
                        {
                            TransferDetailsMap[r.master.transfercode] = r.details ?? new();
                        }
                        return;
                    }
                }
                catch { }

                try
                {
                    var directReq = JsonSerializer.Deserialize<List<stock_transfer_request>>(response, options);
                    if (directReq != null && directReq.Any())
                    {
                        var reqs = directReq.Where(r => r.master != null && (string.IsNullOrEmpty(DefaultTenant) || string.IsNullOrEmpty(r.master.tenantcode) || string.Equals(r.master.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase))).ToList();
                        TransferList = reqs.Select(r => r.master).ToList();
                        TransferDetailsMap.Clear();
                        foreach (var r in reqs)
                        {
                            TransferDetailsMap[r.master.transfercode] = r.details ?? new();
                        }
                        return;
                    }
                }
                catch { }

                try
                {
                    var wrappedM = JsonSerializer.Deserialize<ServiceResponse<List<stock_transfer_master>>>(response, options);
                    if (wrappedM?.data != null && wrappedM.data.Any())
                    {
                        TransferList = wrappedM.data.Where(m => string.IsNullOrEmpty(DefaultTenant) || string.IsNullOrEmpty(m.tenantcode) || string.Equals(m.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase)).ToList();
                        foreach (var m in TransferList)
                        {
                            if (m.details != null && m.details.Any())
                            {
                                TransferDetailsMap[m.transfercode] = m.details;
                            }
                        }
                        return;
                    }
                }
                catch { }

                try
                {
                    var directM = JsonSerializer.Deserialize<List<stock_transfer_master>>(response, options);
                    if (directM != null && directM.Any())
                    {
                        TransferList = directM.Where(m => string.IsNullOrEmpty(DefaultTenant) || string.IsNullOrEmpty(m.tenantcode) || string.Equals(m.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase)).ToList();
                        foreach (var m in TransferList)
                        {
                            if (m.details != null && m.details.Any())
                            {
                                TransferDetailsMap[m.transfercode] = m.details;
                            }
                        }
                        return;
                    }
                }
                catch { }
            }
        }
        catch { }
    }

