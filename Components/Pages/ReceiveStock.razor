    private string GetStoreName(long? warehousecode)
    {
        if (!warehousecode.HasValue || warehousecode == 0) return "-";
        var w = WarehouseList.FirstOrDefault(x => x.warehousecode == warehousecode);
        return w?.warehousename ?? $"Store #{warehousecode}";
    }

    private string GetItemName(long itemcode)
    {
        var itm = ItemList.FirstOrDefault(x => x.itemcode == itemcode);
        return itm?.itemname ?? $"Item #{itemcode}";
    }

    private int GetItemCount(long transfercode) => TransferDetailsMap.TryGetValue(transfercode, out var list) ? list.Count : 0;
    private decimal GetTransferTotalQty(long transfercode) => TransferDetailsMap.TryGetValue(transfercode, out var list) ? list.Sum(d => d.transferqty) : 0;
    private decimal GetTransferTotalValue(long transfercode) => TransferDetailsMap.TryGetValue(transfercode, out var list) ? list.Sum(d => d.stockvalue) : 0;

    private string GetStatusBadgeClass(string? status) => status?.Trim().ToUpperInvariant() switch
    {
        "PENDING" or "DISPATCHED" or "DISPATCH" or "ISSUED" => "bg-warning text-dark",
        "IN-TRANSIT" or "IN TRANSIT" or "IN_TRANSIT" => "bg-info text-dark",
        "COMPLETED" or "ACCEPTED" or "RECEIVED" => "bg-success text-white",
        "REJECTED" or "CANCELLED" or "RETURNED" => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };

