    private async Task<bool> SendActionRequest(string endpoint, stock_transfer_action_request payload)
    {
        var json = JsonSerializer.Serialize(payload);
        Console.WriteLine($"[ReceiveStock] Calling {endpoint} with payload: {json}");

        // 1. Try DoctorApi client
        try
        {
            var client = CreateClient();
            var resp = await client.PostAsJsonAsync(endpoint, payload);
            if (resp.IsSuccessStatusCode) return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ReceiveStock] Error calling {endpoint} via DoctorApi: {ex.Message}");
        }

        // 2. Direct fallback to configured ApiBaseUrl / live API
        try
        {
            using var directClient = new HttpClient();
            if (!string.IsNullOrEmpty(DefaultTenant))
            {
                directClient.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
                directClient.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
            }
            string url = $"http://medicoapi.iscansoft.com/{endpoint.TrimStart('/')}";
            if (!string.IsNullOrEmpty(DefaultTenant))
            {
                url += (url.Contains("?") ? "&" : "?") + $"tenantcode={DefaultTenant}";
            }
            var resp = await directClient.PostAsJsonAsync(url, payload);
            if (resp.IsSuccessStatusCode) return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ReceiveStock] Error calling {endpoint} via fallback: {ex.Message}");
        }

        return false;
    }

    private async Task<(bool success, long transfercode, string message)> SendInsertTransferRequest(stock_transfer_request payload)
    {
        // 1. Try DoctorApi client
        try
        {
            var client = CreateClient();
            var resp = await client.PostAsJsonAsync("api/ItemMaster/insertstocktransfer", payload);
            var content = await resp.Content.ReadAsStringAsync();
            if (resp.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(content);
                long newCode = 0;
                if (doc.RootElement.TryGetProperty("transfercode", out var codeProp))
                {
                    newCode = codeProp.GetInt64();
                }
                else if (doc.RootElement.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == JsonValueKind.Object && dataProp.TryGetProperty("transfercode", out var dataCodeProp))
                {
                    newCode = dataCodeProp.GetInt64();
                }
                return (true, newCode, "");
            }
            return (false, 0, content);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ReceiveStock] Error insert transfer via DoctorApi: {ex.Message}");
        }

        // 2. Direct fallback
        try
        {
            using var directClient = new HttpClient();
            if (!string.IsNullOrEmpty(DefaultTenant))
            {
                directClient.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
                directClient.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
            }
            string url = $"http://medicoapi.iscansoft.com/api/ItemMaster/insertstocktransfer";
            if (!string.IsNullOrEmpty(DefaultTenant))
            {
                url += $"?tenantcode={DefaultTenant}";
            }
            var resp = await directClient.PostAsJsonAsync(url, payload);
            var content = await resp.Content.ReadAsStringAsync();
            if (resp.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(content);
                long newCode = 0;
                if (doc.RootElement.TryGetProperty("transfercode", out var codeProp))
                {
                    newCode = codeProp.GetInt64();
                }
                else if (doc.RootElement.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == JsonValueKind.Object && dataProp.TryGetProperty("transfercode", out var dataCodeProp))
                {
                    newCode = dataCodeProp.GetInt64();
                }
                return (true, newCode, "");
            }
            return (false, 0, content);
        }
        catch (Exception ex)
        {
            return (false, 0, ex.Message);
        }
    }

    private async Task ExecuteConfirmReceipt()
    {
        if (SelectedTransfer == null) return;

        IsProcessing = true;
        try
        {
            var acceptedQty = GetTotalAcceptedQty();
            var rejectedQty = GetTotalRejectedQty();

            if (acceptedQty == 0)
            {
                // All items were rejected
                await ExecuteRejectTransfer();
                return;
            }

            if (rejectedQty == 0)
            {
                // Full Acceptance: All items received as dispatched
                string remarksText = "Store Inward Accepted and Verified (Full Receipt)";
                var actionPayload = new stock_transfer_action_request
                {
                    transfercode = SelectedTransfer.transfercode,
                    usercode = 101,
                    remarks = remarksText
                };

                bool postSuccess = await SendActionRequest("api/ItemMaster/receivestocktransfer", actionPayload);
                if (postSuccess)
                {
                    SelectedTransfer.status = "COMPLETED";
                    SelectedTransfer.remarks = remarksText;
                    ToastService.ShowSuccess($"Transfer #{SelectedTransfer.transferno} successfully RECEIVED! {acceptedQty:N0} items credited to stock.");
                    ShowConfirmReceiveModal = false;
                    ShowDetailsModal = false;
                    await LoadTransfers();
                }
                else
                {
                    ToastService.ShowError($"Failed to receive transfer #{SelectedTransfer.transferno}. Please check backend service.");
                    ShowConfirmReceiveModal = false;
                }
            }
            else
            {
                // Partial Acceptance:
                // Only accepted items must pass to the receiving store, and rejected items must go back to the issuing store.
                var rejections = ReceiveItemStates.Values
                    .Where(v => v.rejectedqty > 0)
                    .Select(v => $"{GetItemName(v.itemcode)}: {v.rejectedqty:N0} rejected ({v.rejectreason})");
                string rejectionSummary = string.Join(", ", rejections);
                string partialRemarks = $"Partial Inward ({acceptedQty:N0} Accepted, {rejectedQty:N0} Rejected). Details: {rejectionSummary}";

                // Step 1: Reject the original transfer to release 100% of dispatched stock back to the issuing store
                var rejectOriginalPayload = new stock_transfer_action_request
                {
                    transfercode = SelectedTransfer.transfercode,
                    usercode = 101,
                    remarks = partialRemarks
                };

                bool rejectSuccess = await SendActionRequest("api/ItemMaster/rejectstocktransfer", rejectOriginalPayload);
                if (!rejectSuccess)
                {
                    ToastService.ShowError($"Failed to process partial rejection for transfer #{SelectedTransfer.transferno}.");
                    ShowConfirmReceiveModal = false;
                    return;
                }

                // Step 2: Create a new stock transfer containing ONLY the accepted items
                var acceptedDetails = new List<stock_transfer_detail>();
                if (TransferDetailsMap.TryGetValue(SelectedTransfer.transfercode, out var originalDetails) && originalDetails != null)
                {
                    foreach (var d in originalDetails)
                    {
                        var state = GetItemReceiveState(d);
                        if (state.receivedqty > 0)
                        {
                            var accDetail = new stock_transfer_detail
                            {
                                transferdetailcode = 0,
                                transfercode = 0,
                                itemcode = d.itemcode,
                                batchno = d.batchno,
                                manufacturingdate = d.manufacturingdate,
                                expirydate = d.expirydate,
                                uomcode = d.uomcode,
                                availableqty = d.availableqty,
                                requestedqty = state.receivedqty,
                                approvedqty = state.receivedqty,
                                transferqty = state.receivedqty,
                                unitcost = d.unitcost,
                                stockvalue = state.receivedqty * d.unitcost,
                                remarks = state.rejectedqty > 0 ? $"{state.receivedqty:N0} Accepted (from TRF #{SelectedTransfer.transferno}, {state.rejectedqty:N0} Rejected: {state.rejectreason})" : "Accepted Inward",
                                tenantcode = d.tenantcode ?? DefaultTenant
                            };
                            acceptedDetails.Add(accDetail);
                        }
                    }
                }

                var acceptedMaster = new stock_transfer_master
                {
                    transfercode = 0,
                    transferno = "",
                    transferdate = DateTime.Now,
                    transfertype = SelectedTransfer.transfertype ?? "Standard",
                    indentcode = SelectedTransfer.indentcode,
                    fromwarehousecode = SelectedTransfer.fromwarehousecode,
                    towarehousecode = SelectedTransfer.towarehousecode,
                    branchcode = SelectedTransfer.branchcode,
                    reason = "Partial Inward Acceptance",
                    remarks = $"Accepted Inward Receipt ({acceptedQty:N0} items) for Voucher #{SelectedTransfer.transferno}. Rejections: {rejectionSummary}",
                    status = "PENDING",
                    createdby = 101,
                    tenantcode = SelectedTransfer.tenantcode ?? DefaultTenant
                };

                var insertReq = new stock_transfer_request
                {
                    master = acceptedMaster,
                    details = acceptedDetails
                };

                var insertResult = await SendInsertTransferRequest(insertReq);
                if (!insertResult.success || insertResult.transfercode <= 0)
                {
                    ToastService.ShowError($"Failed to create accepted inward stock transfer. {insertResult.message}");
                    ShowConfirmReceiveModal = false;
                    await LoadTransfers();
                    return;
                }

                long acceptedTransferCode = insertResult.transfercode;

                // Step 3: Dispatch the accepted transfer to deduct accepted items from issuing store
                var dispatchAccPayload = new stock_transfer_action_request
                {
                    transfercode = acceptedTransferCode,
                    usercode = 101,
                    remarks = $"Dispatched accepted stock for TRF #{SelectedTransfer.transferno}"
                };
                await SendActionRequest("api/ItemMaster/dispatchstocktransfer", dispatchAccPayload);

                // Step 4: Receive the accepted transfer to credit accepted items into receiving store
                var receiveAccPayload = new stock_transfer_action_request
                {
                    transfercode = acceptedTransferCode,
                    usercode = 101,
                    remarks = $"Store Inward Accepted ({acceptedQty:N0} items credited to stock)"
                };
                bool accRecSuccess = await SendActionRequest("api/ItemMaster/receivestocktransfer", receiveAccPayload);

                if (accRecSuccess)
                {
                    ToastService.ShowSuccess($"Transfer #{SelectedTransfer.transferno}: {acceptedQty:N0} items credited to receiving store. {rejectedQty:N0} rejected items returned to {GetStoreName(SelectedTransfer.fromwarehousecode)}.");
                }
                else
                {
                    ToastService.ShowWarning($"Accepted transfer #{acceptedTransferCode} created and dispatched, but final inward receipt status needs verification.");
                }

                ShowConfirmReceiveModal = false;
                ShowDetailsModal = false;
                await LoadTransfers();
            }

            StateHasChanged();
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task ExecuteRejectTransfer()
    {
        if (SelectedTransfer == null) return;

        IsProcessing = true;
        try
        {
            var actionPayload = new stock_transfer_action_request
            {
                transfercode = SelectedTransfer.transfercode,
                usercode = 101,
                remarks = $"REJECTED ({RejectReason}): {RejectRemarks}".Trim()
            };

            bool postSuccess = await SendActionRequest("api/ItemMaster/rejectstocktransfer", actionPayload);

            if (postSuccess)
            {
                SelectedTransfer.status = "REJECTED";
                SelectedTransfer.remarks = actionPayload.remarks;
                ToastService.ShowWarning($"Transfer #{SelectedTransfer.transferno} has been REJECTED and marked for return to issuing store.");
                ShowRejectModal = false;
                ShowDetailsModal = false;
                await LoadTransfers();
            }
            else
            {
                ToastService.ShowError($"Failed to reject transfer #{SelectedTransfer.transferno}. Please check backend service.");
                ShowRejectModal = false;
            }

            StateHasChanged();
        }
        finally
        {
            IsProcessing = false;
        }
    }

