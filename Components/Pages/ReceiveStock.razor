    public class TransferItemReceiveState
    {
        public long transferdetailcode { get; set; }
        public long itemcode { get; set; }
        public decimal dispatchedqty { get; set; }
        public decimal receivedqty { get; set; }
        public decimal rejectedqty => Math.Max(0, dispatchedqty - receivedqty);
        public decimal unitcost { get; set; }
        public decimal receivedvalue => receivedqty * unitcost;
        public decimal rejectedvalue => rejectedqty * unitcost;
        public string action { get; set; } = "ACCEPT"; // ACCEPT, PARTIAL, REJECT
        public string rejectreason { get; set; } = "Damaged in transit";
        public string itemremarks { get; set; } = "";
    }

    private Dictionary<long, TransferItemReceiveState> ReceiveItemStates = new();

    private void OpenTransferDetails(stock_transfer_master trf)
    {
        SelectedTransfer = trf;
        InitReceiveStates(trf);
        ShowDetailsModal = true;
    }

    private void InitReceiveStates(stock_transfer_master trf)
    {
        ReceiveItemStates.Clear();
        if (TransferDetailsMap.TryGetValue(trf.transfercode, out var dList) && dList != null)
        {
            foreach (var d in dList)
            {
                ReceiveItemStates[d.transferdetailcode] = new TransferItemReceiveState
                {
                    transferdetailcode = d.transferdetailcode,
                    itemcode = d.itemcode,
                    dispatchedqty = d.transferqty,
                    receivedqty = d.transferqty,
                    unitcost = d.unitcost,
                    action = "ACCEPT",
                    rejectreason = "Damaged in transit",
                    itemremarks = ""
                };
            }
        }
    }

    private TransferItemReceiveState GetItemReceiveState(stock_transfer_detail d)
    {
        if (!ReceiveItemStates.TryGetValue(d.transferdetailcode, out var state))
        {
            state = new TransferItemReceiveState
            {
                transferdetailcode = d.transferdetailcode,
                itemcode = d.itemcode,
                dispatchedqty = d.transferqty,
                receivedqty = d.transferqty,
                unitcost = d.unitcost,
                action = "ACCEPT",
                rejectreason = "Damaged in transit",
                itemremarks = ""
            };
            ReceiveItemStates[d.transferdetailcode] = state;
        }
        return state;
    }

    private void SetItemAction(long detailCode, string action)
    {
        if (ReceiveItemStates.TryGetValue(detailCode, out var state))
        {
            state.action = action;
            if (action == "ACCEPT")
            {
                state.receivedqty = state.dispatchedqty;
            }
            else if (action == "REJECT")
            {
                state.receivedqty = 0;
            }
            else if (action == "PARTIAL")
            {
                if (state.receivedqty == state.dispatchedqty)
                {
                    state.receivedqty = state.dispatchedqty > 1 ? state.dispatchedqty - 1 : 0;
                }
            }
        }
        StateHasChanged();
    }

    private void OnReceivedQtyInput(long detailCode, ChangeEventArgs e)
    {
        if (ReceiveItemStates.TryGetValue(detailCode, out var state))
        {
            var strVal = e.Value?.ToString()?.Trim();
            if (string.IsNullOrEmpty(strVal))
            {
                state.receivedqty = 0;
                state.action = "REJECT";
            }
            else if (decimal.TryParse(strVal, out var val))
            {
                val = Math.Max(0, Math.Min(state.dispatchedqty, val));
                state.receivedqty = val;
                if (val == state.dispatchedqty)
                {
                    state.action = "ACCEPT";
                }
                else if (val == 0)
                {
                    state.action = "REJECT";
                }
                else
                {
                    state.action = "PARTIAL";
                }
            }
        }
    }

    private void OnReceivedQtyChange(long detailCode, ChangeEventArgs e)
    {
        OnReceivedQtyInput(detailCode, e);
        StateHasChanged();
    }

    private void AcceptAllItems()
    {
        foreach (var state in ReceiveItemStates.Values)
        {
            state.action = "ACCEPT";
            state.receivedqty = state.dispatchedqty;
        }
    }

    private void RejectAllItems()
    {
        foreach (var state in ReceiveItemStates.Values)
        {
            state.action = "REJECT";
            state.receivedqty = 0;
        }
    }

    private decimal GetTotalAcceptedQty()
    {
        if (ReceiveItemStates.Any())
        {
            return ReceiveItemStates.Values.Sum(s => s.receivedqty);
        }
        return SelectedTransfer != null ? GetTransferTotalQty(SelectedTransfer.transfercode) : 0;
    }

    private decimal GetTotalRejectedQty()
    {
        if (ReceiveItemStates.Any())
        {
            return ReceiveItemStates.Values.Sum(s => s.rejectedqty);
        }
        return 0;
    }

    private decimal GetTotalAcceptedValue()
    {
        if (ReceiveItemStates.Any())
        {
            return ReceiveItemStates.Values.Sum(s => s.receivedvalue);
        }
        return SelectedTransfer != null ? GetTransferTotalValue(SelectedTransfer.transfercode) : 0;
    }

    private decimal GetTotalRejectedValue()
    {
        if (ReceiveItemStates.Any())
        {
            return ReceiveItemStates.Values.Sum(s => s.rejectedvalue);
        }
        return 0;
    }

