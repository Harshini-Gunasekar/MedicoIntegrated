@page "/parentcategorymaster"
@page "/parentcategory"
@using Booking.Models
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.NotificationService NotificationService

<div class="items-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Parent Category Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total parent categories : @ItemList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by name or code..." @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    <button class="add-item-btn" @onclick="AddNew">
                        <i class="bi bi-plus-lg"></i>
                        <span class="ms-1">Add Parent Category</span>
                    </button>
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredItems.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-folder2-open fs-1 d-block mb-3"></i>
                        No parent categories found.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 70px; text-align: center;">S.NO</th>
                                    <th style="width: 120px; text-align: center;">CODE</th>
                                    <th style="width: 25%; text-align: center;">NAME</th>
                                    <th style="width: 18%; text-align: center;">SHORT NAME</th>
                                    <th style="width: 28%; text-align: center;">DESCRIPTION</th>
                                    <th style="width: 120px; text-align: center;">STATUS</th>
                                    <th style="width: 100px; text-align: center;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedItems.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td style="text-align: center; font-weight: 700; color: #3b82f6;">@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td style="text-align: center; font-weight: 700; color: #4f46e5;">#@row.value.parentcategorycode</td>
                                        <td style="font-weight: 700; color: #0f172a; text-align: center;">@row.value.parentcategoryname</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.shortname) ? "N/A" : row.value.shortname)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.description) ? "N/A" : row.value.description)</td>
                                        <td style="text-align: center;">
                                            @if (row.value.isactive) {
                                                <span style="color: #059669; font-weight: 700; font-size: 0.78rem; text-transform: uppercase;">Active</span>
                                            } else {
                                                <span style="color: #64748b; font-weight: 700; font-size: 0.78rem; text-transform: uppercase;">Inactive</span>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            <button class="action-btn btn-edit" @onclick="() => Edit(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var item in PagedItems)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span class="card-item-code">#@item.parentcategorycode</span>
                                    <div>
                                        <button class="action-btn btn-edit" @onclick="() => Edit(item)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(item)" title="Delete"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Category Name</span><strong style="color: #0f172a;">@item.parentcategoryname</strong></div>
                                    <div class="detail-row"><span>Short Name</span><strong>@(string.IsNullOrWhiteSpace(item.shortname) ? "N/A" : item.shortname)</strong></div>
                                    <div class="detail-row"><span>Description</span><strong>@(string.IsNullOrWhiteSpace(item.description) ? "N/A" : item.description)</strong></div>
                                    <div class="detail-row"><span>Status</span><strong style="color: @(item.isactive ? "#059669" : "#64748b"); font-weight: 700;">@(item.isactive ? "Active" : "Inactive")</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredItems.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredItems.Count()))</strong> of <strong>@FilteredItems.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 650px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #1e293b !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Category" : "Add Parent Category")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentItem" OnValidSubmit="Save" autocomplete="off">
                    <DataAnnotationsValidator />
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 0 10px 20px 0;">
                        
                        <div class="form-section-header">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Category Details</div>
                        </div>

                        <div class="form-grid" style="display: flex; flex-direction: column; gap: 16px;">
                            <!-- Line 1: Parent Category Name & Short Name -->
                            <div style="display: flex; align-items: flex-start; gap: 16px; width: 100%;">
                                <div class="field-group" style="flex: 2;">
                                    <label class="field-label">Parent Category Name *</label>
                                    <InputText class="form-control premium-input" @bind-Value="CurrentItem.parentcategoryname" placeholder="Enter category name" />
                                    <ValidationMessage For="() => CurrentItem.parentcategoryname" class="text-danger small" />
                                </div>
                                <div class="field-group" style="flex: 1;">
                                    <label class="field-label">Short Name</label>
                                    <InputText class="form-control premium-input" @bind-Value="CurrentItem.shortname" placeholder="e.g. CAT" />
                                </div>
                            </div>

                            <!-- Line 2: Description & Is Active -->
                            <div style="display: flex; align-items: flex-start; gap: 16px; width: 100%;">
                                <div class="field-group" style="flex: 3.5;">
                                    <label class="field-label">Description</label>
                                    <InputText class="form-control premium-input" @bind-Value="CurrentItem.description" placeholder="Enter optional description..." />
                                </div>
                                <div class="field-group" style="flex: 1;">
                                    <label class="field-label" style="opacity: 0;">&nbsp;</label>
                                    <div class="form-check form-switch mb-0" style="display: flex; align-items: center; height: 42px;">
                                        <InputCheckbox class="form-check-input" @bind-Value="CurrentItem.isactive" id="parentActiveSwitch" style="transform: scale(1.2); margin-right: 8px; cursor: pointer;" />
                                        <label class="form-check-label fw-bold" for="parentActiveSwitch" style="font-size: 0.85rem; color: #1e293b; cursor: pointer; white-space: nowrap;">Is Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-actions">
                        <button type="button" class="btn-cancel-modal" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn-save-premium" disabled="@IsSaving">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                            }
                            <span>@(IsEdit ? "Update Category" : "Save Category")</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeleteConfirm = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Category</div>
            <div class="action-popup-body">Are you sure you want to delete this parent category?</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowDeleteConfirm = false">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" disabled="@IsDeleteProcessing" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<parent_category_master> ItemList = new();
    private string SearchQuery = string.Empty;
    private bool IsLoading;
    private bool IsCardView;
    private const string DefaultTenantCode = "TEN1011";

    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 12;

    private bool ShowModal = false;
    private bool IsEdit = false;
    private bool IsSaving = false;
    private bool ShowDeleteConfirm = false;
    private bool IsDeleteProcessing = false;
    private parent_category_master? PendingDelete;
    private parent_category_master CurrentItem = new() { tenantcode = DefaultTenantCode, isactive = true };

    private IEnumerable<parent_category_master> FilteredItems =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? ItemList
            : ItemList.Where(i =>
                (i.parentcategoryname?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                i.parentcategorycode.ToString().Contains(SearchQuery));

    private IEnumerable<parent_category_master> PagedItems =>
        FilteredItems.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    private int TotalPages => (int)Math.Ceiling((double)FilteredItems.Count() / ItemsPerPage);

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        CurrentPage = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private HttpClient CreateTenantClient()
    {
        var client = ClientFactory.CreateClient("InventoryApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenantCode);
        return client;
    }

    private void SetView(bool cardView)
    {
        IsCardView = cardView;
        CurrentPage = 1;
    }

    private async Task LoadData()
    {
        IsLoading = true;
        try
        {
            var client = CreateTenantClient();
            var responseString = await client.GetStringAsync("ItemMaster/getparentcategory");

            try
            {
                var direct = System.Text.Json.JsonSerializer.Deserialize<List<parent_category_master>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ItemList = (direct ?? new List<parent_category_master>()).Where(x => !x.deleted).ToList();
            }
            catch
            {
                var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<parent_category_master>>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ItemList = (wrapped?.data ?? new List<parent_category_master>()).Where(x => !x.deleted).ToList();
            }
        }
        catch
        {
            ItemList = new List<parent_category_master>();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void AddNew()
    {
        CurrentItem = new parent_category_master { tenantcode = DefaultTenantCode, isactive = true };
        IsEdit = false;
        ShowModal = true;
    }

    private void Edit(parent_category_master item)
    {
        CurrentItem = new parent_category_master
        {
            parentcategorycode = item.parentcategorycode,
            parentcategoryname = item.parentcategoryname,
            shortname = item.shortname,
            description = item.description,
            isactive = item.isactive,
            tenantcode = DefaultTenantCode
        };
        IsEdit = true;
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
        IsSaving = false;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(CurrentItem.parentcategoryname))
        {
            NotificationService.ShowNotification("Please provide a category name.", NotificationType.Warning);
            return;
        }

        IsSaving = true;
        try
        {
            var client = CreateTenantClient();
            CurrentItem.tenantcode = DefaultTenantCode;
            CurrentItem.shortname ??= "";
            CurrentItem.description ??= "";

            var isUpdate = IsEdit;
            var baseUrl = isUpdate ? "ItemMaster/updateparentcategory" : "ItemMaster/insertparentcategory";
            
            var response = await client.PostAsJsonAsync(baseUrl, CurrentItem);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification(isUpdate ? "Updated successfully" : "Added successfully", NotificationType.Success);
                CloseModal();
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.ShowNotification($"Save failed: {error}", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(parent_category_master item)
    {
        PendingDelete = item;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteConfirmed()
    {
        var item = PendingDelete;
        if (item is null)
        {
            ShowDeleteConfirm = false;
            return;
        }

        IsDeleteProcessing = true;
        try
        {
            var client = CreateTenantClient();
            var response = await client.DeleteAsync($"ItemMaster/deleteparentcategory?parentcategorycode={item.parentcategorycode}");
            
            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification("Deleted successfully", NotificationType.Success);
                await LoadData();
            }
            else
            {
                // Fallback attempt with GET or POST based on other modules
                var fallbackResponse = await client.GetAsync($"ItemMaster/deleteparentcategory?parentcategorycode={item.parentcategorycode}");
                if (fallbackResponse.IsSuccessStatusCode)
                {
                    NotificationService.ShowNotification("Deleted successfully", NotificationType.Success);
                    await LoadData();
                }
                else
                {
                    NotificationService.ShowNotification("Delete failed.", NotificationType.Error);
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error deleting: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsDeleteProcessing = false;
            ShowDeleteConfirm = false;
            PendingDelete = null;
        }
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            StateHasChanged();
        }
    }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }
}