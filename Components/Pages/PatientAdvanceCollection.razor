                await LoadActiveIpAdmissionsAsync();
            FilterModalDepositIpPatients();
            StateHasChanged();
            return;
        }

        _modalDepositSearchCts?.Cancel();
        _modalDepositSearchCts = new System.Threading.CancellationTokenSource();
        var token = _modalDepositSearchCts.Token;

        await SearchModalDepositPatientsAsync(token);
    }

    private async Task OnModalDepositSearchFocus()
    {
        if (modalDepositSearchMode == "IP")
        {
            if (allIpAdmissions == null || allIpAdmissions.Count == 0)
                await LoadActiveIpAdmissionsAsync();
            FilterModalDepositIpPatients();
        }
        else
        {
            await SearchModalDepositPatientsAsync();
        }
        StateHasChanged();
    }

    private void OnModalDepositSearchKeyDown(KeyboardEventArgs e)
    {
        int count = modalDepositSearchMode == "IP" ? searchedModalDepositIpPatients.Count : modalDepositSearchResults.Count;
        if (count == 0) return;

        if (e.Key == "ArrowDown")
        {
            activeModalDepositIndex = (activeModalDepositIndex + 1) % count;
            showModalDepositDropdown = true;
        }
        else if (e.Key == "ArrowUp")
        {
            activeModalDepositIndex = (activeModalDepositIndex - 1 + count) % count;
            showModalDepositDropdown = true;
        }
        else if (e.Key == "Enter" && activeModalDepositIndex >= 0 && activeModalDepositIndex < count)
        {
            if (modalDepositSearchMode == "IP")
                SelectModalDepositIpPatient(searchedModalDepositIpPatients[activeModalDepositIndex]);
            else
                SelectModalDepositPatient(modalDepositSearchResults[activeModalDepositIndex]);
        }
        else if (e.Key == "Escape")
        {
            showModalDepositDropdown = false;
        }
    }

    private async Task SearchModalDepositPatientsAsync(System.Threading.CancellationToken token = default)
    {
        await EnsureModalPatientsMasterLoadedAsync();
        if (string.IsNullOrWhiteSpace(modalDepositSearchQuery))
        {
            modalDepositSearchResults = modalPatientsMasterCache.Take(25).ToList();
            showModalDepositDropdown = modalDepositSearchResults.Any();
            StateHasChanged();
            return;
        }

        var q = modalDepositSearchQuery.Trim();
        var matches = modalPatientsMasterCache.Where(p =>
            (!string.IsNullOrEmpty(p.name) && p.name.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(p.namewithinitials) && p.namewithinitials.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(p.custcode) && p.custcode.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(p.mobile) && p.mobile.Contains(q, StringComparison.OrdinalIgnoreCase))
        ).Take(25).ToList();

        modalDepositSearchResults = matches;
        showModalDepositDropdown = modalDepositSearchResults.Any();
        StateHasChanged();

        try
        {
            await Task.Delay(250, token);
            if (token.IsCancellationRequested) return;

            using var client = CreateClient(true);
            var response = await client.GetAsync($"api/Customer/search?key={Uri.EscapeDataString(q)}", token);
            if (token.IsCancellationRequested) return;

            if (!response.IsSuccessStatusCode)
            {
                response = await client.GetAsync($"api/OpRegistration/customers-with-op?key={Uri.EscapeDataString(q)}", token);
            }
            if (token.IsCancellationRequested) return;

            if (response.IsSuccessStatusCode)
            {
                var raw = await response.Content.ReadAsStringAsync(token);
                if (token.IsCancellationRequested) return;

                var apiList = ParseModalCustomersJson(raw);
                if (apiList.Any())
                {
                    foreach (var pat in apiList)
                    {
                        if (!modalDepositSearchResults.Any(x => x.custid == pat.custid))
                        {
                            modalDepositSearchResults.Add(pat);
                            if (!modalPatientsMasterCache.Any(x => x.custid == pat.custid))
                                modalPatientsMasterCache.Add(pat);
                        }
                    }
                    showModalDepositDropdown = modalDepositSearchResults.Any();
                    StateHasChanged();
                }
            }
        }
        catch { }
    }

