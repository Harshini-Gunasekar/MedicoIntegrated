    private async Task LoadActiveIpAdmissionsAsync()
    {
        try
        {
            var res = await IpService.GetIpRegistrationsAsync();
            if (res == null || res.Count == 0)
            {
                res = await IpService.GetActiveAdmissionsAsync();
            }
            if (res == null || res.Count == 0)
            {
                res = await IpService.GetIpRegistrationsAsync("ADMITTED");
            }
            if (res == null || res.Count == 0)
            {
                res = await IpService.GetActiveAdmissionsAsync();
