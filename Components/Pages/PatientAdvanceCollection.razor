        var q = modalDepositSearchQuery.Trim();
        searchedModalDepositIpPatients = allIpAdmissions
            .Where(x => (!string.IsNullOrEmpty(x.patient_name) && x.patient_name.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(x.mobile) && x.mobile.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(x.ip_no) && x.ip_no.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(x.custcode) && x.custcode.Contains(q, StringComparison.OrdinalIgnoreCase)))
