            align-items: center;
            line-height: 1.2;
            white-space: nowrap;
        }

        .search-toggle-btn:hover {
            color: #1e1b4b;
        }

        .search-toggle-btn.active {
            background: #4f46e5;
            color: #ffffff;
            box-shadow: 0 2px 4px rgba(79, 70, 229, 0.25);
        }

        /* Advance List Card */
        .advance-list-card {
            background: #ffffff;
            border-radius: 14px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .advance-list-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            padding-bottom: 1.25rem;
            border-bottom: 1px solid #f1f5f9;
        }

        .advance-list-title-wrap {
            display: flex;
            align-items: center;
            gap: 0.85rem;
        }

        .advance-list-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 1.35rem;
            box-shadow: 0 4px 10px rgba(79, 70, 229, 0.25);
        }

        .advance-list-title {
            font-size: 1.15rem;
            font-weight: 800;
            color: #0f172a;
            margin: 0;
            letter-spacing: -0.02em;
        }

        .advance-list-subtitle {
            font-size: 0.82rem;
            color: #64748b;
            margin: 0.15rem 0 0 0;
        }

        .badge-count {
            background: #eef2ff;
            color: #4f46e5;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 12px;
            border: 1px solid rgba(79, 70, 229, 0.2);
        }

        .advance-list-tools {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .list-search-wrap {
            position: relative;
            min-width: 260px;
        }

        .list-search-icon {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.85rem;
            pointer-events: none;
        }

        .list-search-input {
            width: 100%;
            padding: 0.5rem 2rem 0.5rem 2.2rem;
            font-size: 0.84rem;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            background: #f8fafc;
            color: #0f172a;
            transition: all 0.2s;
        }

        .list-search-input:focus {
            background: #ffffff;
            border-color: #6366f1;
            outline: none;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
        }

        .list-search-clear {
            position: absolute;
            right: 0.5rem;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #94a3b8;
            cursor: pointer;
            padding: 2px 4px;
        }

        .btn-refresh-list {
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 0.85rem;
            font-size: 0.82rem;
            font-weight: 600;
            color: #475569;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-refresh-list:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

        .spin-icon {
            animation: spin 1s linear infinite;
        }

        @@keyframes spin { 100% { transform: rotate(360deg); } }

        /* Metrics Bar */
        .advance-metrics-bar {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 0.85rem;
            margin: 1.25rem 0;
            padding: 0.85rem 1rem;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border-radius: 10px;
            border: 1px solid #e2e8f0;
        }

        .metric-pill {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
        }

        .metric-label {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #64748b;
        }

        .metric-val {
            font-size: 1.15rem;
            font-weight: 800;
            letter-spacing: -0.01em;
        }

        .text-indigo { color: #4338ca; }
        .text-amber { color: #d97706; }
        .text-rose { color: #e11d48; }
        .text-emerald { color: #059669; }

        .metric-highlight {
            background: #ecfdf5;
            padding: 0.5rem 0.85rem;
            border-radius: 8px;
            border: 1px solid #a7f3d0;
        }

        /* CashCounter Advance KPI Cards */
        .advance-kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 0.85rem;
            margin-bottom: 1.15rem;
