    private async Task LoadLedgerOnly()
    {
        if (advancePatientId == null || advanceSummary == null) return;

        try
        {
            var freshSummary = await DueCollectionService.GetPatientAdvanceSummaryAsync(advancePatientId.Value);
            if (freshSummary != null)
            {
                advanceSummary = freshSummary;
            }
        }
        catch { }

        if (advanceSummary.ledger == null || advanceSummary.ledger.Count == 0)
        {
            StateHasChanged();
            return;
        }

        resolvedTransactionTypes.Clear();
        resolvedCustomerNames.Clear();

        loadingLedger = true;
        StateHasChanged();

        try
        {
            foreach (var row in advanceSummary.ledger)
            {
                var rawType = (row.transaction_type ?? "USED").ToUpperInvariant();
                if (rawType == "DEPOSIT")
                {
                    resolvedTransactionTypes[row] = "DEPOSIT";
                    resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                }
                else if (rawType == "USED")
                {
                    resolvedTransactionTypes[row] = "USED";
                    resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                }
                else
                {
                    bool isRefund = rawType == "REFUND" || rawType == "REFUNDED";
                    resolvedTransactionTypes[row] = isRefund ? "REFUNDED" : rawType;
                    resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                }
            }
        }
        finally
        {
            loadingLedger = false;
            StateHasChanged();
        }
    }

    private async Task LoadPatientAdvance()
    {
        if (advancePatientId == null) return;

        loadingAdvance = true;
        StateHasChanged();
        try
        {
            advanceSummary = await DueCollectionService.GetPatientAdvanceSummaryAsync(advancePatientId.Value);
            if (advanceSummary == null)
            {
                ToastService.ShowError("No patient record or advance summary found for the given Patient ID.");
                loadingAdvance = false;
                StateHasChanged();
                return;
            }

            // If API doesn't return patient_name, fallback to the name stored from search
            if (string.IsNullOrWhiteSpace(advanceSummary.patient_name) && !string.IsNullOrEmpty(selectedPatientName))
            {
                advanceSummary.patient_name = selectedPatientName;
            }

            resolvedTransactionTypes.Clear();
            resolvedCustomerNames.Clear();

            loadingAdvance = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load advance summary: {ex.Message}");
            loadingAdvance = false;
            StateHasChanged();
        }
    }

    private async Task DepositAdvance()
    {
        if (advanceSummary == null || depositAmount <= 0) return;
        actionRunning = true;
        StateHasChanged();

        try
        {
            var req = new HmsAdvanceDepositRequest
            {
                custid = advanceSummary.custid,
                patient_name = advanceSummary.patient_name,
                amount = depositAmount,
                collection_type = depositPayMode,
                remarks = depositRemarks,
                usercode = UserCode,
                cntcode = CounterCodeVal,
                enteredbhcode = BranchCodeVal
            };

            var payloadJson = System.Text.Json.JsonSerializer.Serialize(req, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            Console.WriteLine("\n==================================================");
            Console.WriteLine("[PATIENT ADVANCE DEPOSIT PAYLOAD SUBMITTED]");
            Console.WriteLine(payloadJson);
            Console.WriteLine("==================================================\n");

            var res = await DueCollectionService.DepositAdvanceAsync(req);
            if (res != null)
            {
                ToastService.ShowSuccess($"Deposited ₹ {depositAmount:N2} advance successfully.");
                var newReceiptKey = !string.IsNullOrWhiteSpace(res.receipt_guid) ? res.receipt_guid : res.receipt_no;
                depositAmount = 0;
                depositAmountText = "";
                depositRemarks = string.Empty;
                await LoadPatientAdvance();
                if (!string.IsNullOrEmpty(newReceiptKey))
                {
                    await PrintAdvanceReceiptAsync(newReceiptKey);
                }
            }
            else
            {
                ToastService.ShowError("Failed to deposit advance.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            actionRunning = false;
            StateHasChanged();
        }
    }

    private async Task RefundAdvance()
    {
        if (advanceSummary == null || refundAmount <= 0) return;
        actionRunning = true;
        StateHasChanged();

        try
        {
            var req = new HmsAdvanceRefundRequest
            {
                custid = advanceSummary.custid,
                refund_amount = refundAmount,
                remarks = refundRemarks,
                usercode = UserCode,
                cntcode = CounterCodeVal,
                enteredbhcode = BranchCodeVal
            };

            var payloadJson = System.Text.Json.JsonSerializer.Serialize(req, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            Console.WriteLine("\n==================================================");
            Console.WriteLine("[PATIENT ADVANCE REFUND PAYLOAD SUBMITTED]");
            Console.WriteLine(payloadJson);
            Console.WriteLine("==================================================\n");

            var res = await DueCollectionService.RefundAdvanceAsync(req);
            if (res != null)
            {
                ToastService.ShowSuccess($"Refunded ₹ {refundAmount:N2} successfully.");
                var newReceiptKey = !string.IsNullOrWhiteSpace(res.receipt_guid) ? res.receipt_guid : res.receipt_no;
                refundAmount = 0;
                refundAmountText = "";
                refundRemarks = string.Empty;
                await LoadPatientAdvance();
                if (!string.IsNullOrEmpty(newReceiptKey))
                {
                    await PrintRefundReceiptAsync(newReceiptKey);
                }
            }
            else
            {
                ToastService.ShowError("Failed to refund advance.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            actionRunning = false;
            StateHasChanged();
        }
    }

    private string GetTransactionType(HmsAdvanceLedgerRow row)
    {
        if (resolvedTransactionTypes.TryGetValue(row, out var resolvedType))
        {
            return resolvedType;
        }

        var rawType = (row.transaction_type ?? "").ToUpper().Trim();

        return rawType switch
        {
            "DEPOSIT"  => "DEPOSIT",
            "REFUND"   => "REFUNDED",
            "REFUNDED" => "REFUNDED",
            "USED"     => "USED",
            "USE"      => "USED",
            _          => string.IsNullOrEmpty(rawType) ? "DEPOSIT" : rawType
        };
    }

    private double GetTotalDeposited()
    {
        if (advanceSummary?.ledger != null && advanceSummary.ledger.Count > 0)
        {
            return advanceSummary.ledger
                .Where(r => GetTransactionType(r) == "DEPOSIT")
                .Sum(r => r.receiptamount);
        }
        return advanceSummary?.total_advance_deposited ?? 0;
    }

    private double GetTotalUsed()
    {
        if (advanceSummary?.ledger != null && advanceSummary.ledger.Count > 0)
        {
            return advanceSummary.ledger
                .Where(r => GetTransactionType(r) == "USED")
                .Sum(r => r.receiptamount);
        }
        return advanceSummary?.total_advance_used ?? 0;
    }

    private double GetTotalRefunded()
    {
        if (advanceSummary?.ledger != null && advanceSummary.ledger.Count > 0)
        {
            return advanceSummary.ledger
                .Where(r => GetTransactionType(r) == "REFUNDED")
                .Sum(r => r.receiptamount);
        }
        return advanceSummary?.total_advance_refunded ?? 0;
    }

    private double GetAvailableBalance()
    {
        return Math.Max(0, GetTotalDeposited() - GetTotalUsed() - GetTotalRefunded());
    }

    private static DateTime ConvertToIst(DateTime dt)
    {
        DateTime utc = dt.Kind == DateTimeKind.Utc ? dt : DateTime.SpecifyKind(dt, DateTimeKind.Utc);
        try
        {
            TimeZoneInfo istZone = TimeZoneInfo.FindSystemTimeZoneById("India Standard Time");
            return TimeZoneInfo.ConvertTimeFromUtc(utc, istZone);
        }
        catch
        {
            try
            {
                TimeZoneInfo istZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata");
                return TimeZoneInfo.ConvertTimeFromUtc(utc, istZone);
            }
            catch
            {
                return utc.AddHours(5).AddMinutes(30);
            }
        }
    }

    private string FormatIstDateTime(DateTime dt)
    {
        var ist = ConvertToIst(dt);
        return ist.ToString("dd-MMM-yyyy hh:mm tt");
    }

    #region Advance & Refund Receipt Print Logic

    private string selectedPageFormat = "A4";
    private bool isPrintingReceipt = false;
    private string printingReceiptKey = "";

    private async Task PrintAdvanceReceiptAsync(string? receiptKey)
    {
        if (string.IsNullOrWhiteSpace(receiptKey))
        {
            ToastService.ShowWarning("No receipt number or GUID found for this transaction.");
            return;
        }

        isPrintingReceipt = true;
        printingReceiptKey = receiptKey;
        StateHasChanged();

        try
        {
            var base64 = await DueCollectionService.GetAdvanceReceiptBase64Async(
                receiptguid: receiptKey,
                pageformat: selectedPageFormat,
                tenant_code: TenantState.TenantCode);

            if (!string.IsNullOrEmpty(base64))
            {
                await JS.InvokeVoidAsync("openBase64Pdf", base64, $"Advance Receipt - {receiptKey}");
            }
            else
            {
                ToastService.ShowError("Failed to fetch advance receipt PDF.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing advance receipt: {ex}");
            ToastService.ShowError($"Error printing advance receipt: {ex.Message}");
        }
        finally
        {
            isPrintingReceipt = false;
            printingReceiptKey = "";
            StateHasChanged();
        }
    }

