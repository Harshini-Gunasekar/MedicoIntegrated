    private async Task SubmitRequestRefundAsync()
    {
        if (newRefundRequestModel.custid <= 0)
        {
            ToastService.ShowWarning("Please select a patient.");
            return;
        }
        if (newRefundRequestModel.refund_amount <= 0)
        {
            ToastService.ShowWarning("Please enter a valid refund amount.");
            return;
        }
        if (modalRefundPatientSummary != null && newRefundRequestModel.refund_amount > modalRefundPatientSummary.available_balance)
        {
            ToastService.ShowWarning($"Refund amount cannot exceed available balance of ₹{modalRefundPatientSummary.available_balance:N2}.");
            return;
        }

        isSubmittingRefundRequest = true;
        try
        {
            newRefundRequestModel.usercode = TenantState.UserCode > 0 ? TenantState.UserCode : 1;
            newRefundRequestModel.user_name = TenantState.UserData?.UserName ?? "Ward Staff";
            newRefundRequestModel.tenant_code = TenantState.TenantCode;

            var res = await DueCollectionService.CreateRefundRequestAsync(newRefundRequestModel);
            if (res.success)
            {
                ToastService.ShowSuccess($"Advance refund request sent to Cash Counter! Request #{res.data?.request_no}");
                showRequestRefundModal = false;
            }
            else
            {
                ToastService.ShowError(res.message ?? "Failed to send refund request.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isSubmittingRefundRequest = false;
            StateHasChanged();
        }
    }

