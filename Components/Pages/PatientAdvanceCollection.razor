            align-items: center;
            justify-content: flex-end;
            gap: 0.75rem;
        }

        .btn-modal-keep {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            padding: 0.52rem 1.15rem;
            border-radius: 9px;
            font-size: 0.85rem;
            font-weight: 700;
            border: 1.5px solid #cbd5e1;
            background: #ffffff;
            color: #475569;
            cursor: pointer;
            transition: all 0.18s ease;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        }

        .btn-modal-keep:hover:not(:disabled) {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #94a3b8;
        }

        .btn-modal-confirm {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            padding: 0.52rem 1.35rem;
            border-radius: 9px;
            font-size: 0.85rem;
            font-weight: 700;
            border: 1px solid #dc2626;
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: #ffffff;
            cursor: pointer;
            transition: all 0.18s ease;
            box-shadow: 0 3px 8px rgba(220, 38, 38, 0.28);
        }

        .btn-modal-confirm:hover:not(:disabled) {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            box-shadow: 0 5px 12px rgba(220, 38, 38, 0.38);
            transform: translateY(-1px);
        }

        .btn-modal-confirm:disabled, .btn-modal-keep:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none !important;
        }

        /* Compact, consistent layout for all advance tabs */
        .due-collection-wrapper {
            font-family: 'Inter', sans-serif !important;
            font-size: 0.72rem;
        }

        .due-collection-wrapper,
        .due-collection-wrapper button,
        .due-collection-wrapper input,
        .due-collection-wrapper select,
        .due-collection-wrapper textarea,
        .due-collection-wrapper table {
            font-family: 'Inter', sans-serif !important;
        }

        .due-collection-wrapper .due-header-card {
            padding: 0.75rem 1rem;
            margin-bottom: 0.85rem;
            gap: 0.75rem;
        }

        .due-collection-wrapper .advance-main-card,
        .due-collection-wrapper .advance-list-card,
        .due-collection-wrapper .ledger-panel {
            border-radius: 10px;
        }

        .due-collection-wrapper .advance-main-card {
            padding: 0.85rem;
        }

        .due-collection-wrapper .advance-list-header,
        .due-collection-wrapper .ledger-header {
            gap: 0.5rem;
            padding: 0.7rem 0.85rem;
        }

        .due-collection-wrapper .advance-list-title,
        .due-collection-wrapper .ledger-title {
            font-size: 0.95rem;
            line-height: 1.2;
        }

        .due-collection-wrapper .advance-list-subtitle,
        .due-collection-wrapper .ledger-subtitle {
            font-size: 0.68rem;
            line-height: 1.35;
        }

        .due-collection-wrapper .tab-pills {
            gap: 0.35rem;
            margin-bottom: 0.7rem;
        }

        .due-collection-wrapper .tab-pill,
        .due-collection-wrapper .btn-advance-refresh,
        .due-collection-wrapper .btn-select-advance,
        .due-collection-wrapper .btn-ledger-action-print,
        .due-collection-wrapper .btn-ledger-action-cancel,
        .due-collection-wrapper .btn-back-to-list,
        .due-collection-wrapper .btn-patient-request-deposit,
        .due-collection-wrapper .btn-patient-request-refund {
            font-size: 0.7rem;
            line-height: 1.2;
            padding: 0.38rem 0.65rem;
        }

        .due-collection-wrapper .advance-metrics-bar {
            gap: 0.65rem;
            padding: 0.65rem 0.75rem;
        }

        .due-collection-wrapper .advance-metrics-bar > div,
        .due-collection-wrapper .stat-card {
            min-width: 0;
        }

        .due-collection-wrapper .advance-table-responsive {
            overflow-x: auto;
        }

        .due-collection-wrapper .advance-table {
            width: 100%;
            font-size: 0.7rem;
            table-layout: auto;
        }

        .due-collection-wrapper .advance-table th {
            padding: 0.48rem 0.55rem;
            font-size: 0.62rem;
            line-height: 1.2;
            white-space: nowrap;
            vertical-align: middle;
        }

        .due-collection-wrapper .advance-table td {
            padding: 0.5rem 0.55rem;
            line-height: 1.25;
            vertical-align: middle;
        }

        .due-collection-wrapper .advance-table td:first-child,
        .due-collection-wrapper .advance-table th:first-child {
            text-align: center;
        }

        .due-collection-wrapper .list-search-input,
        .due-collection-wrapper select,
        .due-collection-wrapper input:not([type="checkbox"]):not([type="radio"]),
        .due-collection-wrapper textarea {
            font-size: 0.72rem;
        }

        .due-collection-wrapper .form-label,
        .due-collection-wrapper label {
            font-size: 0.68rem;
        }

        .due-collection-wrapper .badge,
        .due-collection-wrapper .badge-count {
            font-size: 0.64rem;
            line-height: 1.2;
        }

        @@media (max-width: 768px) {
            .due-collection-wrapper {
                padding: 0.55rem;
            }

            .due-collection-wrapper .advance-list-header,
            .due-collection-wrapper .ledger-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .due-collection-wrapper .advance-list-tools {
                width: 100%;
            }
        }
    </style>

    <!-- Top Header Card (Matching DueCollection) -->
    <div class="due-header-card">
        <div style="display: flex; align-items: center; gap: 1.25rem; flex-shrink: 0;">
            <div class="header-icon-container">
                <i class="bi bi-piggy-bank"></i>
            </div>
            <div class="header-text-container">
                <h1>Patient Advance Collection</h1>
                <p><span class="header-status-dot"></span> ADVANCE MANAGEMENT &amp; DEPOSITS</p>
            </div>
        </div>

        <!-- Header Controls: Search + Branch + Counter -->
        <div class="header-controls-group">

            <!-- Patient Search Autocomplete -->
                        <!-- Patient Search Autocomplete with IP / All Toggle -->
            <div class="header-control-item">
                <div class="header-control-label-row">
                    <label><i class="bi bi-person-badge me-1"></i> PATIENT SEARCH</label>
                    <div class="patient-search-toggle-group">
                        <button type="button" 
                                class="search-toggle-btn @(patientSearchMode == "IP" ? "active" : "")" 
                                @onclick='() => SetSearchMode("IP")' 
                                title="Search and dropdown only IP Admitted Patients">
                            <i class="bi bi-hospital me-1"></i> IP Patients
                        </button>
                        <button type="button" 
                                class="search-toggle-btn @(patientSearchMode == "ALL" ? "active" : "")" 
                                @onclick='() => SetSearchMode("ALL")' 
                                title="Search and dropdown all registered patients">
                            <i class="bi bi-people me-1"></i> All Patients
                        </button>
                    </div>
                </div>
                <div class="header-search-wrapper" style="position: relative;">
                    <i class="bi bi-search header-search-icon"></i>
                    <input @key="@("advance_patient_search_input_" + patientSearchMode)"
                           type="text"
                           class="header-search-input"
                           placeholder="@(patientSearchMode == "IP" ? "Search IP Patient (Name, Mobile, IP No)..." : "Search Patient Name or Mobile...")"
                           value="@patientSearchQuery"
                           @oninput="OnPatientSearchInput"
                           @onfocus="OnPatientSearchFocus"
                           @onkeydown="OnPatientSearchKeyDown"
                           autocomplete="off" />
                    @if (patientSearchMode == "IP" && showIpPatientDropdown && searchedIpPatients.Count > 0)
                    {
                        <div class="patient-autocomplete-dropdown">
                            @for (int i = 0; i < searchedIpPatients.Count; i++)
                            {
                                var ipIdx = i;
                                var ip = searchedIpPatients[i];
                                var displayName = ip.GetPatientName();
                                if (string.IsNullOrWhiteSpace(displayName)) displayName = $"Patient {ip.custid}";
                                var initialChar = displayName.FirstOrDefault(c => char.IsLetterOrDigit(c));
                                var avatarChar = initialChar != default ? initialChar.ToString().ToUpper() : "P";

                                <div @key="@($"ip_drop_{ip.ip_id}_{ipIdx}")" 
                                     class="patient-dropdown-item @(ipIdx == activePatientIndex ? "active-focused" : "")" 
                                     @onclick="() => SelectIpPatient(ip)" 
                                     @onmouseover="() => activePatientIndex = ipIdx"
                                     @onmousedown:preventDefault="true">
                                    <div class="dropdown-patient-avatar" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); color: #ffffff !important; font-weight: 800;">
                                        @avatarChar
                                    </div>
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
                                            <div class="dropdown-patient-name">@displayName (CUST-@ip.custid)</div>
                                        </div>
                                        <div class="dropdown-patient-id">
                                            <span class="fw-semibold text-primary"><i class="bi bi-hospital me-1"></i>IP No: @(string.IsNullOrWhiteSpace(ip.ip_no) ? "-" : ip.ip_no)</span>
                                            <span class="mx-1">|</span>
                                            <i class="bi bi-telephone me-1 text-muted"></i>@(string.IsNullOrWhiteSpace(ip.mobile) ? "No Mobile" : ip.mobile)
                                            @if (!string.IsNullOrWhiteSpace(ip.admission_type))
                                            {
                                                <span> | <i class="bi bi-hospital me-1 text-muted"></i>@ip.admission_type</span>
                                            }
                                            <span class="badge bg-success-subtle text-success ms-1" style="font-size: 0.65rem; border: 1px solid rgba(16, 185, 129, 0.2);">@ip.ip_status</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (patientSearchMode == "ALL" && showPatientDropdown && searchedPatients.Count > 0)
                    {
                        <div class="patient-autocomplete-dropdown">
                            @for (int i = 0; i < searchedPatients.Count; i++)
                            {
                                var patIdx = i;
                                var pat = searchedPatients[i];
                                var displayName = !string.IsNullOrWhiteSpace(pat.namewithinitials) 
                                    ? pat.namewithinitials 
                                    : (!string.IsNullOrWhiteSpace(pat.name) ? pat.name : $"Customer {pat.custid}");
                                var initialChar = displayName.FirstOrDefault(c => char.IsLetterOrDigit(c));
                                var avatarChar = initialChar != default ? initialChar.ToString().ToUpper() : "P";

                                <div @key="pat.custid > 0 ? pat.custid : (long)patIdx" class="patient-dropdown-item @(patIdx == activePatientIndex ? "active-focused" : "")" 
                                     @onclick="() => SelectCustomerPatient(pat)" 
                                     @onmouseover="() => activePatientIndex = patIdx"
                                     @onmousedown:preventDefault="true">
                                    <div class="dropdown-patient-avatar" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); color: #ffffff !important; font-weight: 800;">
                                        @avatarChar
                                    </div>
                                    <div>
                                        <div class="dropdown-patient-name">@displayName (CUST-@pat.custid)</div>
                                        <div class="dropdown-patient-id">
                                            <i class="bi bi-telephone me-1 text-muted"></i>@(string.IsNullOrWhiteSpace(pat.mobile) ? (string.IsNullOrWhiteSpace(pat.phone) ? "No Mobile" : pat.phone) : pat.mobile)
                                            @if (!string.IsNullOrWhiteSpace(pat.area) || !string.IsNullOrWhiteSpace(pat.city))
                                            {
                                                <span> | <i class="bi bi-geo-alt me-1 text-muted"></i>@pat.area@(string.IsNullOrWhiteSpace(pat.city) ? "" : $", {pat.city}")</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Branch Dropdown -->
            <div class="header-control-item">
                <div class="header-control-label-row">
                    <label><i class="bi bi-building me-1"></i> BRANCH</label>
                </div>
                <select class="header-select" @bind="selectedBranchCode" @bind:after="OnHeaderBranchChanged">
                    <option value="">All Branches</option>
                    @foreach (var b in branchesList)
                    {
                        <option value="@b.bh_code">@b.name</option>
                    }
                </select>
            </div>

            <!-- Counter Dropdown -->
            <div class="header-control-item">
                <div class="header-control-label-row">
                    <label><i class="bi bi-grid-3x2-gap me-1"></i> COUNTER</label>
                </div>
                <select class="header-select" @bind="selectedCounterCode">
                    <option value="">All Counters</option>
                    @foreach (var c in filteredCountersList)
                    {
                        <option value="@c.cntcode">@c.name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div>
        @if (loadingAdvance)
        {
            <div class="advance-main-card" style="text-align: center; padding: 3rem;">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2 text-muted" style="font-size:0.85rem;">Fetching patient advance summary...</div>
            </div>
        }
        else if (advanceSummary != null)
        {
            <div class="advance-main-card">

                <!-- Patient Row -->
                                <!-- Patient Row -->
                <div class="patient-row" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <div class="patient-avatar-lg">
                            @(advanceSummary.patient_name?.FirstOrDefault().ToString().ToUpper() ?? "?")
                        </div>
                        <div>
                            <p class="patient-name-lg">@advanceSummary.patient_name</p>
                            <p class="patient-id-sm">UHID: <b>@advanceSummary.custid</b></p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                        <button type="button" class="btn-patient-request-deposit" @onclick="OpenRequestDepositForSelectedPatient" title="Send advance deposit request to Cash Counter">
                            <i class="bi bi-plus-circle-fill"></i> + Request Deposit
                        </button>
                        <button type="button" class="btn-patient-request-refund" @onclick="OpenRequestRefundForSelectedPatient" title="Send advance refund request to Cash Counter">
                            <i class="bi bi-arrow-counterclockwise"></i> + Request Refund
                        </button>
                        <button type="button" class="btn-back-to-list" @onclick="ClearSelectedPatient" title="Return to All Advance Patients List">
                            <i class="bi bi-arrow-left me-1"></i> Back to Advance List
                        </button>
                    </div>
                </div>

                <!-- Summary Stats -->
                <div class="summary-grid-4">
                    <div class="stat-card deposited">
                        <span class="stat-label">Total Advance Deposited</span>
                        <span class="stat-value">₹ @GetTotalDeposited().ToString("N2")</span>
                    </div>
                    <div class="stat-card used">
                        <span class="stat-label">Total Advance Used</span>
                        <span class="stat-value">₹ @GetTotalUsed().ToString("N2")</span>
                    </div>
                    <div class="stat-card refunded">
                        <span class="stat-label">Total Advance Refunded</span>
                        <span class="stat-value">₹ @GetTotalRefunded().ToString("N2")</span>
                    </div>
                    <div class="stat-card balance">
                        <span class="stat-label">Available Balance</span>
                        <span class="stat-value">₹ @GetAvailableBalance().ToString("N2")</span>
                    </div>
                </div>

                <!-- Deposit/Refund + Ledger -->
                <div class="content-split">

                    <!-- Left: Deposit / Refund Form -->
                    <div class="left-panel">
                        <!-- Tab Pills: Only Deposit and Refund -->
                        <div class="tab-pills">
                            <button class="tab-pill @(advanceSubTab == "deposit" ? "active-deposit" : "")" @onclick='() => advanceSubTab = "deposit"'>
                                <i class="bi bi-plus-circle"></i> Deposit
                            </button>
                            <button class="tab-pill @(advanceSubTab == "refund" ? "active-refund" : "")" @onclick='() => advanceSubTab = "refund"'>
                                <i class="bi bi-dash-circle"></i> Refund
                            </button>
                        </div>

                        @if (advanceSubTab == "deposit")
                        {
                            <div class="form-panel">
                                <h3><i class="bi bi-plus-circle text-success"></i> Deposit New Advance</h3>
                                <div class="field-group">
                                    <label class="field-label">Amount (₹)</label>
                                    <input @key="@("advance_deposit_amt")" type="text" inputmode="decimal" class="field-input" placeholder="Enter amount to deposit..." value="@depositAmountText" @oninput="OnDepositAmountInput" />
                                </div>
                                <div class="field-group">
                                    <label class="field-label">Pay Mode</label>
                                    <select class="field-input" @bind="depositPayMode">
                                        <option value="CASH">CASH</option>
                                        <option value="CARD">CARD</option>
                                        <option value="GPAY">GPAY</option>
                                        <option value="UPI">UPI</option>
                                    </select>
                                </div>
                                <div class="field-group">
                                    <label class="field-label">Remarks / Notes</label>
                                    <textarea class="field-input" style="height: 50px; resize: none;" placeholder="e.g. advance for IP or lab..." @bind="depositRemarks"></textarea>
                                </div>
                                <button class="btn-deposit-main" @onclick="DepositAdvance" disabled="@(depositAmount <= 0 || actionRunning)">
                                    @if (actionRunning)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    }
                                    Deposit Advance
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="form-panel">
                                <h3><i class="bi bi-dash-circle text-danger"></i> Refund Available Balance</h3>
                                <div class="field-group">
                                    <label class="field-label">Refund Amount (₹)</label>
                                    <input @key="@("advance_refund_amt")" type="text" inputmode="decimal" class="field-input" placeholder="Max: @GetAvailableBalance().ToString("N2")" value="@refundAmountText" @oninput="OnRefundAmountInput" />
                                </div>
                                <div class="field-group">
                                    <label class="field-label">Remarks / Notes</label>
                                    <textarea class="field-input" style="height: 85px; resize: none;" placeholder="e.g. patient requested refund..." @bind="refundRemarks"></textarea>
                                </div>
                                <button class="btn-refund-main" @onclick="RefundAdvance" disabled="@(refundAmount <= 0 || refundAmount > GetAvailableBalance() || actionRunning)">
                                    @if (actionRunning)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    }
                                    Refund Advance
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Right: Transaction Ledger -->
                    <div class="right-panel">
                        <div class="ledger-panel">
                            <div class="ledger-header" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                                <h3 class="ledger-title" style="margin: 0;">
                                    <i class="bi bi-list-stars"></i> Transaction Ledger History
                                </h3>
                                <div style="display: flex; align-items: center; gap: 0.45rem;">
                                    <div class="page-format-pill-toggle" role="group" aria-label="Receipt Paper Format">
                                        <button type="button" class="format-btn @(selectedPageFormat == "A4" ? "active" : "")" @onclick='() => selectedPageFormat = "A4"' title="Format: A4 (Full Page)">
                                            <i class="bi bi-file-earmark-text-fill format-icon"></i>
                                            <span>A4</span>
                                        </button>
                                        <button type="button" class="format-btn @(selectedPageFormat == "A5" ? "active" : "")" @onclick='() => selectedPageFormat = "A5"' title="Format: A5 (Half Page)">
                                            <i class="bi bi-file-earmark-fill format-icon"></i>
                                            <span>A5</span>
                                        </button>
                                    </div>
                                    <button class="btn btn-sm" style="background: #eef2ff; color: #4f46e5; border: 1px solid #c7d2fe; border-radius: 8px; font-weight: 700; font-size: 0.75rem; height: 32px; padding: 0 0.65rem; display: inline-flex; align-items: center; gap: 4px;"
                                            @onclick="PrintAllPatientReceiptsAsync" disabled="@(advancePatientId == null || isPrintingReceipt)" title="Print all receipts for this patient (each on separate page)">
                                        @if (isPrintingReceipt && printingReceiptKey == "ALL")
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status" style="width: 12px; height: 12px;"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-printer-fill" style="font-size: 0.78rem;"></i>
                                        }
                                        <span>Print All</span>
                                    </button>
                                    <button class="btn-icon-sm" @onclick="FetchAdvanceSummaryHistory" disabled="@(advancePatientId == null)" title="Refresh">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </div>
                            </div>
                            <div style="overflow-x: auto; max-height: 360px; overflow-y: auto;">
                                <table class="ledger-table">
                                    <thead>
                                        <tr>
                                            <th>DATE</th>
                                            <th>RECEIPT / BILL NO</th>
                                            <th>CUSTOMER</th>
                                            <th>UHID</th>
                                            <th>TYPE</th>
                                            <th style="text-align:right;">AMOUNT</th>
                                            <th style="text-align:center; width: 85px;">ACTION</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (loadingLedger)
                                        {
                                            <tr><td colspan="7" style="text-align:center; padding: 2rem;">
                                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                <span class="ms-2 text-muted" style="font-size:0.82rem;">Loading ledger...</span>
                                            </td></tr>
                                        }
                                        else if (advanceSummary.ledger == null || advanceSummary.ledger.Count == 0)
                                        {
                                            <tr><td colspan="7" style="text-align:center; padding: 2rem; color:#94a3b8; font-size:0.82rem;">No transactions recorded yet.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var row in advanceSummary.ledger)
                                            {
                                                var typeDisplay = GetTransactionType(row);
                                                resolvedCustomerNames.TryGetValue(row, out var patientName);
                                                var rowReceiptKey = (typeDisplay == "REFUND" || typeDisplay == "REFUNDED")
                                                    ? (!string.IsNullOrWhiteSpace(row.requestguid)
                                                        ? row.requestguid
                                                        : (!string.IsNullOrWhiteSpace(row.receiptguid) ? row.receiptguid : row.receiptsnoprint))
                                                    : (!string.IsNullOrWhiteSpace(row.receiptguid) ? row.receiptguid : row.receiptsnoprint);
                                                <tr>
                                                    <td>@(row.receiptdate.HasValue ? FormatIstDateTime(row.receiptdate.Value) : "-")</td>
                                                    <td style="font-family: monospace; font-weight: 700;">@row.receiptsnoprint</td>
                                                    <td style="font-weight: 600;">@(patientName ?? advanceSummary.patient_name ?? "-")</td>
                                                    <td><span class="badge bg-light text-dark border">@(advanceSummary.custid > 0 ? advanceSummary.custid.ToString() : "-")</span></td>
                                                    <td>
                                                        <span class="type-badge @(typeDisplay.ToLower())">@typeDisplay</span>
                                                    </td>
                                                    <td style="text-align:right; font-weight: 700; color: @(typeDisplay == "DEPOSIT" ? "#16a34a" : typeDisplay == "USED" ? "#1d4ed8" : "#dc2626");">
                                                        ₹ @row.receiptamount.ToString("N2")
                                                    </td>
                                                    <td style="text-align:center; white-space: nowrap;">
                                                        <div style="display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem;">
                                                            @if (typeDisplay == "DEPOSIT")
                                                            {
                                                                <button type="button" class="btn-ledger-action-print deposit" 
                                                                        @onclick="() => PrintAdvanceReceiptAsync(rowReceiptKey)" 
                                                                        disabled="@(isPrintingReceipt && printingReceiptKey == rowReceiptKey)"
                                                                        title="Print Advance Receipt (@selectedPageFormat)"
                                                                        aria-label="Print Advance Receipt">
                                                                    @if (isPrintingReceipt && printingReceiptKey == rowReceiptKey)
                                                                    {
                                                                        <span class="spinner-border spinner-border-sm" role="status" style="width: 11px; height: 11px;"></span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="bi bi-printer"></i>
                                                                    }
                                                                </button>
                                                                <button type="button" class="btn-ledger-action-cancel" 
                                                                        @onclick="() => PromptCancelAdvance(row)" 
                                                                        disabled="@(actionRunning || isCancellingAdvance)"
                                                                        title="Cancel this advance deposit receipt"
                                                                        aria-label="Cancel advance deposit receipt">
                                                                    <i class="bi bi-x-circle"></i>
                                                                </button>
                                                            }
                                                            else if (typeDisplay == "REFUND" || typeDisplay == "REFUNDED")
                                                            {
                                                                <button type="button" class="btn-ledger-action-print refund" 
                                                                        @onclick="() => PrintRefundReceiptAsync(rowReceiptKey)" 
                                                                        disabled="@(isPrintingReceipt && printingReceiptKey == rowReceiptKey)"
                                                                        title="Print Refund Receipt (@selectedPageFormat)"
                                                                        aria-label="Print Refund Receipt">
                                                                    @if (isPrintingReceipt && printingReceiptKey == rowReceiptKey)
                                                                    {
                                                                        <span class="spinner-border spinner-border-sm" role="status" style="width: 11px; height: 11px;"></span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="bi bi-printer"></i>
                                                                    }
                                                                </button>
                                                                <button type="button" class="btn-ledger-action-cancel" 
                                                                        @onclick="() => PromptCancelAdvance(row)" 
                                                                        disabled="@(actionRunning || isCancellingAdvance)"
                                                                        title="Cancel this advance refund receipt"
                                                                        aria-label="Cancel advance refund receipt">
                                                                    <i class="bi bi-x-circle"></i>
                                                                </button>
                                                            }
                                                            else if (typeDisplay == "USED")
                                                            {
                                                                <button type="button" class="btn-ledger-action-revert"
                                                                        @onclick="() => OpenRevertAdvanceModal(row)"
                                                                        disabled="@(isRevertingAdvance || string.IsNullOrWhiteSpace(row.requestguid))"
                                                                        title="Revert advance used for this bill">
                                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                                    <span>Revert Advance</span>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted" style="font-size:0.75rem;">-</span>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
        else
        {
            <!-- Patient Advance Workspace (Subtabs matching CashCounter) -->
            <div class="advance-container-card">
                <!-- Advance Sub-Navigation Header -->
                <div class="advance-nav-header" style="margin-bottom: 1.25rem;">
                    <div class="advance-subtabs-group">
                        <button type="button" class="advance-subtab-btn @(advanceMainTab == "LEDGER" ? "active" : "")" @onclick='() => SetAdvanceMainTab("LEDGER")' title="Patient Advance Balances & Ledger">
                            <i class="bi bi-journal-text"></i>
                            <span>Advance Ledger</span>
                            <span class="subtab-badge">@filteredAdvanceList.Count</span>
                        </button>
                        <button type="button" class="advance-subtab-btn @(advanceMainTab == "DEPOSIT_REQUESTS" ? "active" : "")" @onclick='() => SetAdvanceMainTab("DEPOSIT_REQUESTS")' title="Advance Deposit Requests Queue">
                            <i class="bi bi-inbox-arrow-down"></i>
                            <span>Deposit Requests</span>
                            @if (advanceRequestsSummary.pending_count > 0)
                            {
                                <span class="subtab-badge pulse-badge">@advanceRequestsSummary.pending_count</span>
                            }
                        </button>
                        <button type="button" class="advance-subtab-btn @(advanceMainTab == "REFUND_REQUESTS" ? "active" : "")" @onclick='() => SetAdvanceMainTab("REFUND_REQUESTS")' title="Advance Refund Requests Queue">
                            <i class="bi bi-inbox-arrow-up"></i>
                            <span>Refund Requests</span>
                            @if (refundRequestsSummary.pending_count > 0)
                            {
                                <span class="subtab-badge pulse-badge" style="background: #ef4444; color: #fff;">@refundRequestsSummary.pending_count</span>
                            }
                        </button>
                        <button type="button" class="advance-subtab-btn @(advanceMainTab == "REFUND_HISTORY" ? "active" : "")" @onclick='() => SetAdvanceMainTab("REFUND_HISTORY")' title="Refund Audit Log">
                            <i class="bi bi-journal-arrow-down"></i>
                            <span>Refund History</span>
                            <span class="subtab-badge">@refundHistoryList.Count</span>
                        </button>
                    </div>
                </div>

                @if (advanceMainTab == "DEPOSIT_REQUESTS")
                {
                    <!-- Tab 1: Advance Deposit Requests Queue -->
                    <div class="queue-kpi-row">
                        <div class="queue-kpi-card pending">
                            <div class="kpi-icon"><i class="bi bi-hourglass-split"></i></div>
                            <div class="kpi-info">
                                <span class="kpi-title">PENDING DEPOSIT REQUESTS</span>
                                <div class="kpi-numbers">
                                    <span class="kpi-count">@advanceRequestsSummary.pending_count Requests</span>
                                    <span class="kpi-amount">₹@advanceRequestsSummary.pending_amount.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                        <div class="queue-kpi-card collected">
                            <div class="kpi-icon"><i class="bi bi-check2-circle"></i></div>
                            <div class="kpi-info">
                                <span class="kpi-title">COLLECTED TODAY</span>
                                <div class="kpi-numbers">
                                    <span class="kpi-count">@advanceRequestsSummary.received_count Requests</span>
                                    <span class="kpi-amount">₹@advanceRequestsSummary.received_amount.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Queue Filter / Search Bar -->
                    <div class="advance-list-card" style="padding: 1rem 1.25rem; margin-bottom: 1rem;">
                        <div class="advance-filter-row">
                            <div class="status-toggle-group">
                                <button type="button" class="filter-pill-btn @(advanceRequestStatusFilter == "PENDING" ? "active" : "")" @onclick='() => SetAdvanceQueueStatusFilter("PENDING")'>Pending</button>
                                <button type="button" class="filter-pill-btn @(advanceRequestStatusFilter == "ALL" ? "active" : "")" @onclick='() => SetAdvanceQueueStatusFilter("ALL")'>All</button>
                                <button type="button" class="filter-pill-btn @(advanceRequestStatusFilter == "RECEIVED" ? "active" : "")" @onclick='() => SetAdvanceQueueStatusFilter("RECEIVED")'>Received</button>
                                <button type="button" class="filter-pill-btn @(advanceRequestStatusFilter == "CANCELLED" ? "active" : "")" @onclick='() => SetAdvanceQueueStatusFilter("CANCELLED")'>Cancelled</button>
                            </div>
                            <div class="d-flex align-items-center gap-1 ms-2">
                                <span class="small text-muted fw-bold">FROM:</span>
                                <input type="date" class="form-control form-control-sm" style="width: 130px;" @bind="advanceRequestFromDate" @bind:after="LoadAdvanceRequestsAsync" />
                                <span class="small text-muted fw-bold ms-1">TO:</span>
                                <input type="date" class="form-control form-control-sm" style="width: 130px;" @bind="advanceRequestToDate" @bind:after="LoadAdvanceRequestsAsync" />
                            </div>
                            <div class="list-search-wrap" style="flex: 1; min-width: 200px;">
                                <i class="bi bi-search list-search-icon"></i>
                                <input type="text" class="list-search-input" @bind="advanceRequestSearch" placeholder="Search by Patient, UHID or Request #..." />
                            </div>
                            <button type="button" class="btn-advance-refresh" @onclick="LoadAdvanceRequestsAsync" title="Refresh Queue">
                                <i class="bi bi-arrow-clockwise @(isLoadingAdvanceRequests ? "spin-icon" : "")"></i> Refresh
                            </button>
                            <button type="button" class="btn-header-request-deposit" @onclick="OpenRequestDepositModal" title="New Deposit Request">
                                <i class="bi bi-plus-circle-fill"></i> + New Request
                            </button>
                        </div>
                    </div>

                    <!-- Deposit Requests Table Card -->
                    <div class="advance-list-card" style="padding: 0; overflow: hidden;">
                        <div style="padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
                            <h4 style="margin: 0; font-size: 0.95rem; font-weight: 800; color: #1e293b;">Deposit Requests Queue</h4>
                            <span class="badge-count">Total: @FilteredAdvanceRequests.Count requests</span>
                        </div>
                        <div class="advance-table-responsive" style="border: none; border-radius: 0;">
                            <table class="advance-table">
                                <thead>
                                    <tr>
                                        <th style="width: 48px; text-align: center;">S.No</th>
                                        <th>REQUEST NO &amp; TIME</th>
                                        <th>PATIENT</th>
                                        <th>UHID</th>
                                        <th>MOBILE</th>
                                        <th style="text-align: right;">REQUESTED AMOUNT</th>
                                        <th>SOURCE DEPT</th>
                                        <th>NOTES</th>
                                        <th>STATUS</th>
                                        <th style="text-align: center; width: 170px;">ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (FilteredAdvanceRequests.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="10" class="advance-table-empty">
                                                <i class="bi bi-inbox" style="font-size: 2.2rem; color: #cbd5e1; display: block; margin-bottom: 0.5rem;"></i>
                                                No advance deposit requests found in this queue.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        int qidx = 1;
                                        @foreach (var req in FilteredAdvanceRequests)
                                        {
                                            <tr>
                                                <td style="text-align: center; color: #94a3b8; font-weight: 600;">@qidx</td>
                                                <td>
                                                    <div style="font-weight: 700; color: #0284c7; font-family: monospace;">@req.request_no</div>
                                                    <small class="text-muted">@req.request_time.ToLocalTime().ToString("dd-MMM-yyyy hh:mm tt")</small>
                                                </td>
                                                <td>
                                                    <span style="font-weight: 700; color: #0f172a;">@req.patient_name</span>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border font-monospace">@GetUhidDisplay(req.custid, req.custcode)</span>
                                                </td>
                                                <td>@(string.IsNullOrWhiteSpace(req.mobile) ? "-" : req.mobile)</td>
                                                <td style="text-align: right; font-weight: 800; color: #16a34a; font-size: 0.95rem;">
                                                    ₹@req.amount.ToString("N2")
                                                </td>
                                                <td>
                                                    <span class="badge bg-secondary-subtle text-secondary border">@req.source_type</span>
                                                </td>
                                                <td>
                                                    <span class="text-muted small text-truncate d-inline-block" style="max-width: 180px;" title="@req.notes">@(string.IsNullOrWhiteSpace(req.notes) ? "-" : req.notes)</span>
                                                </td>
                                                <td>
                                                    @if (req.status == "PENDING")
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">Pending</span>
                                                    }
                                                    else if (req.status == "RECEIVED" || req.status == "COLLECTED")
                                                    {
                                                        <span class="badge bg-success-subtle text-success-emphasis border border-success">Collected</span>
                                                    }
                                                    else if (req.status == "CANCELLED")
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger-emphasis border border-danger">Cancelled</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-dark border">@req.status</span>
                                                    }
                                                </td>
                                                <td style="text-align: center;">
                                                    @if (req.status == "PENDING")
                                                    {
                                                        <div style="display: inline-flex; align-items: center; gap: 0.4rem;">
                                                            <button type="button" class="btn-select-advance" @onclick='() => SelectPatientFromQueueRequest(req, "deposit")' title="Manage / Collect Advance">
                                                                <i class="bi bi-wallet2 me-1"></i> Collect
                                                            </button>
                                                            <button type="button" class="btn-ledger-action-cancel" @onclick="() => PromptCancelQueueRequest(req)" title="Cancel request">
                                                                <i class="bi bi-x-circle"></i> Cancel
                                                            </button>
                                                        </div>
                                                    }
                                                    else if (req.status == "RECEIVED" || req.status == "COLLECTED")
                                                    {
                                                        var depReceiptKey = !string.IsNullOrWhiteSpace(req.receiptguid) ? req.receiptguid : req.request_no;
                                                        <div style="display: inline-flex; align-items: center; gap: 0.4rem;">
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.74rem; padding: 4px 8px; font-weight: 700;">
                                                                <i class="bi bi-check2-circle me-1"></i>Settled
                                                            </span>
                                                            <button type="button" class="btn-ledger-action-print deposit" @onclick="() => PrintAdvanceReceiptAsync(depReceiptKey)" disabled="@(isPrintingReceipt && printingReceiptKey == depReceiptKey)" title="Preview & Print Receipt">
                                                                <i class="bi bi-printer"></i> Receipt
                                                            </button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-muted border border-secondary-subtle" style="font-size: 0.74rem; padding: 4px 8px;">
                                                            @req.status
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                            qidx++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else if (advanceMainTab == "REFUND_REQUESTS")
                {
                    <!-- Tab 2: Advance Refund Requests Queue -->
                    <div class="queue-kpi-row">
                        <div class="queue-kpi-card pending" style="border-left: 4px solid #ef4444;">
                            <div class="kpi-icon" style="background: rgba(239, 68, 68, 0.15); color: #dc2626;"><i class="bi bi-arrow-return-left"></i></div>
                            <div class="kpi-info">
                                <span class="kpi-title">PENDING REFUND REQUESTS</span>
                                <div class="kpi-numbers">
                                    <span class="kpi-count">@refundRequestsSummary.pending_count Requests</span>
                                    <span class="kpi-amount text-danger">₹@refundRequestsSummary.pending_amount.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                        <div class="queue-kpi-card collected" style="border-left: 4px solid #d97706;">
                            <div class="kpi-icon" style="background: rgba(217, 119, 6, 0.15); color: #d97706;"><i class="bi bi-check2-all"></i></div>
                            <div class="kpi-info">
                                <span class="kpi-title">REFUNDED TODAY</span>
                                <div class="kpi-numbers">
                                    <span class="kpi-count">@refundRequestsSummary.refunded_count Requests</span>
                                    <span class="kpi-amount" style="color: #d97706;">₹@refundRequestsSummary.refunded_amount.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Refund Queue Filter / Search Bar -->
                    <div class="advance-list-card" style="padding: 1rem 1.25rem; margin-bottom: 1rem;">
                        <div class="advance-filter-row">
                            <div class="status-toggle-group">
                                <button type="button" class="filter-pill-btn @(refundRequestStatusFilter == "PENDING" ? "active" : "")" @onclick='() => SetRefundQueueStatusFilter("PENDING")'>Pending</button>
                                <button type="button" class="filter-pill-btn @(refundRequestStatusFilter == "ALL" ? "active" : "")" @onclick='() => SetRefundQueueStatusFilter("ALL")'>All</button>
                                <button type="button" class="filter-pill-btn @(refundRequestStatusFilter == "REFUNDED" ? "active" : "")" @onclick='() => SetRefundQueueStatusFilter("REFUNDED")'>Refunded</button>
                                <button type="button" class="filter-pill-btn @(refundRequestStatusFilter == "CANCELLED" ? "active" : "")" @onclick='() => SetRefundQueueStatusFilter("CANCELLED")'>Cancelled</button>
                            </div>
                            <div class="list-search-wrap" style="flex: 1; min-width: 200px;">
                                <i class="bi bi-search list-search-icon"></i>
                                <input type="text" class="list-search-input" @bind="refundRequestSearch" placeholder="Search by Patient, UHID, Request # or Reason..." />
                            </div>
                            <button type="button" class="btn-advance-refresh" @onclick="LoadRefundRequestsAsync" title="Refresh Queue">
                                <i class="bi bi-arrow-clockwise @(isLoadingRefundRequests ? "spin-icon" : "")"></i> Refresh
                            </button>
                            <button type="button" class="btn-header-request-refund" @onclick="OpenRequestRefundModal" title="New Refund Request">
                                <i class="bi bi-arrow-counterclockwise"></i> + New Request
                            </button>
                        </div>
                    </div>

                    <!-- Refund Requests Table Card -->
                    <div class="advance-list-card" style="padding: 0; overflow: hidden;">
                        <div style="padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
                            <h4 style="margin: 0; font-size: 0.95rem; font-weight: 800; color: #1e293b;">Refund Requests Queue</h4>
                            <span class="badge-count">Total: @FilteredRefundRequests.Count requests</span>
                        </div>
                        <div class="advance-table-responsive" style="border: none; border-radius: 0;">
                            <table class="advance-table">
                                <thead>
                                    <tr>
                                        <th style="width: 48px; text-align: center;">S.No</th>
                                        <th>REQUEST NO &amp; TIME</th>
                                        <th>PATIENT</th>
                                        <th>UHID</th>
                                        <th>MOBILE</th>
                                        <th style="text-align: right;">REFUND AMOUNT</th>
                                        <th>REASON</th>
                                        <th>STATUS</th>
                                        <th style="text-align: center; width: 170px;">ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (FilteredRefundRequests.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="9" class="advance-table-empty">
                                                <i class="bi bi-inbox" style="font-size: 2.2rem; color: #cbd5e1; display: block; margin-bottom: 0.5rem;"></i>
                                                No advance refund requests found in this queue.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        int rqidx = 1;
                                        @foreach (var req in FilteredRefundRequests)
                                        {
                                            <tr>
                                                <td style="text-align: center; color: #94a3b8; font-weight: 600;">@rqidx</td>
                                                <td>
                                                    <div style="font-weight: 700; color: #ea580c; font-family: monospace;">@req.request_no</div>
                                                    <small class="text-muted">@req.request_time.ToLocalTime().ToString("dd-MMM-yyyy hh:mm tt")</small>
                                                </td>
                                                <td>
                                                    <span style="font-weight: 700; color: #0f172a;">@req.patient_name</span>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border font-monospace">@GetUhidDisplay(req.custid, req.custcode)</span>
                                                </td>
                                                <td>@(string.IsNullOrWhiteSpace(req.mobile) ? "-" : req.mobile)</td>
                                                <td style="text-align: right; font-weight: 800; color: #dc2626; font-size: 0.95rem;">
                                                    ₹@req.amount.ToString("N2")
                                                </td>
                                                <td>
                                                    <span class="badge bg-warning-subtle text-dark border">@(string.IsNullOrWhiteSpace(req.source_type) ? (req.notes ?? "Discharge Refund") : req.source_type)</span>
                                                </td>
                                                <td>
                                                    @if (req.status == "PENDING")
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">Pending</span>
                                                    }
                                                    else if (req.status == "REFUNDED" || req.status == "COLLECTED")
                                                    {
                                                        <span class="badge bg-success-subtle text-success-emphasis border border-success">Disbursed</span>
                                                    }
                                                    else if (req.status == "CANCELLED")
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger-emphasis border border-danger">Cancelled</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-dark border">@req.status</span>
                                                    }
                                                </td>
                                                <td style="text-align: center;">
                                                    @if (req.status == "PENDING")
                                                    {
                                                        <div style="display: inline-flex; align-items: center; gap: 0.4rem;">
                                                            <button type="button" class="btn-select-advance" style="background: #fff7ed; color: #ea580c; border-color: #fed7aa;" @onclick='() => SelectPatientFromQueueRequest(req, "refund")' title="Manage / Disburse Refund">
                                                                <i class="bi bi-arrow-return-left me-1"></i> Refund
                                                            </button>
                                                            <button type="button" class="btn-ledger-action-cancel" @onclick="() => PromptCancelQueueRequest(req)" title="Cancel request">
                                                                <i class="bi bi-x-circle"></i> Cancel
                                                            </button>
                                                        </div>
                                                    }
                                                    else if (req.status == "REFUNDED" || req.status == "COLLECTED")
                                                    {
                                                        var refReceiptKey = !string.IsNullOrWhiteSpace(req.receiptguid) ? req.receiptguid : req.request_no;
                                                        <div style="display: inline-flex; align-items: center; gap: 0.4rem;">
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.74rem; padding: 4px 8px; font-weight: 700;">
                                                                <i class="bi bi-check2-circle me-1"></i>Refunded
                                                            </span>
                                                            <button type="button" class="btn-ledger-action-print refund" @onclick="() => PrintRefundReceiptAsync(refReceiptKey)" disabled="@(isPrintingReceipt && printingReceiptKey == refReceiptKey)" title="Preview & Print Refund Receipt">
                                                                <i class="bi bi-printer"></i> Receipt
                                                            </button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-muted border border-secondary-subtle" style="font-size: 0.74rem; padding: 4px 8px;">
                                                            @req.status
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                            rqidx++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else if (advanceMainTab == "LEDGER")
                {
                    <!-- Tab 3: Advance Ledger (Advance Deposited Patients) -->
                    <div class="advance-list-card">
                        <!-- Header of Advance Patients List with Request Deposit and Refund buttons near the title text -->
                        <div class="advance-list-header">
                            <div class="advance-list-title-wrap">
                                <div class="advance-list-icon">
                                    <i class="bi bi-wallet2"></i>
                                </div>
                                <div>
                                    <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                                        <h3 class="advance-list-title">Advance Deposited Patients</h3>
                                        <span class="badge-count">@filteredAdvanceList.Count Patients</span>
                                        <button type="button" class="btn-header-request-deposit ms-2" @onclick="OpenRequestDepositModal" title="Send advance deposit request to Cash Counter">
                                            <i class="bi bi-plus-circle-fill"></i> + Request Deposit
                                        </button>
                                        <button type="button" class="btn-header-request-refund ms-1" @onclick="OpenRequestRefundModal" title="Send advance refund request to Cash Counter">
                                            <i class="bi bi-arrow-counterclockwise"></i> + Request Refund
                                        </button>
                                    </div>
                                    <p class="advance-list-subtitle">List of all patients with deposited advance balance and transaction summary</p>
                                </div>
                            </div>

                            <div class="advance-list-tools">
                                <!-- Quick search within advance list -->
                                <div class="list-search-wrap">
                                    <i class="bi bi-search list-search-icon"></i>
                                    <input type="text" 
                                           class="list-search-input" 
                                           placeholder="Filter advance list..." 
                                           @bind="advanceFilterQuery" 
                                           @bind:event="oninput" />
                                    @if (!string.IsNullOrWhiteSpace(advanceFilterQuery))
                                    {
                                        <button type="button" class="list-search-clear" @onclick='() => advanceFilterQuery = ""'>
                                            <i class="bi bi-x"></i>
                                        </button>
                                    }
                                </div>

                                <!-- Refresh button -->
                                <button type="button" class="btn-refresh-list" @onclick="LoadAllAdvancePatientsAsync" title="Refresh advance list">
                                    <i class="bi bi-arrow-clockwise @(loadingAllAdvances ? "spin-icon" : "")"></i>
                                    <span class="ms-1">Refresh</span>
                                </button>
                            </div>
                        </div>

                        <!-- Advance Metrics Summary Bar -->
                        @if (allAdvancePatients.Count > 0)
                        {
                            <div class="advance-metrics-bar">
                                <div class="metric-pill">
                                    <span class="metric-label">Total Deposited</span>
                                    <span class="metric-val text-indigo">₹@allAdvancePatients.Sum(x => x.total_deposited).ToString("N2")</span>
                                </div>
                                <div class="metric-pill">
                                    <span class="metric-label">Total Used</span>
                                    <span class="metric-val text-amber">₹@allAdvancePatients.Sum(x => x.total_used).ToString("N2")</span>
                                </div>
                                <div class="metric-pill">
                                    <span class="metric-label">Total Refunded</span>
                                    <span class="metric-val text-rose">₹@allAdvancePatients.Sum(x => x.total_refunded).ToString("N2")</span>
                                </div>
                                <div class="metric-pill metric-highlight">
                                    <span class="metric-label">Total Available Balance</span>
                                    <span class="metric-val text-emerald">₹@allAdvancePatients.Sum(x => x.available_balance).ToString("N2")</span>
                                </div>
                            </div>
                        }

                        <!-- Advance Patients Table -->
                        @if (loadingAllAdvances)
                        {
                            <div style="text-align: center; padding: 4rem 2rem;">
                                <div class="spinner-border text-primary" role="status" style="width: 2.2rem; height: 2.2rem;"></div>
                                <div class="mt-2 text-muted" style="font-size: 0.88rem; font-weight: 500;">Loading advance deposited patients...</div>
                            </div>
                        }
                        else if (filteredAdvanceList.Count == 0)
                        {
                            <div class="advance-table-empty">
                                <i class="bi bi-inbox" style="font-size: 2.5rem; color: #cbd5e1;"></i>
                                <p style="font-size: 0.95rem; font-weight: 600; color: #475569; margin: 0.6rem 0 0.2rem 0;">No advance deposits found</p>
                                <p style="font-size: 0.82rem; color: #94a3b8; margin: 0;">
                                    @(string.IsNullOrWhiteSpace(advanceFilterQuery) ? "No patients have deposited advance yet." : $"No patients match '{advanceFilterQuery}'.")
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="advance-table-responsive">
                                <table class="advance-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 48px; text-align: center;">S.No</th>
                                            <th>PATIENT</th>
                                            <th>UHID</th>
                                            <th>MOBILE</th>
                                            <th style="text-align: right;">TOTAL DEPOSITED</th>
                                            <th style="text-align: right;">TOTAL USED</th>
                                            <th style="text-align: right;">TOTAL REFUNDED</th>
                                            <th style="text-align: right;">AVAILABLE BALANCE</th>
                                            <th style="text-align: center;">LAST DEPOSIT DATE</th>
                                            <th style="text-align: center; width: 180px;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < filteredAdvanceList.Count; i++)
                                        {
                                            var item = filteredAdvanceList[i];
                                            var rowIdx = i + 1;

                                            <tr class="advance-table-row" @onclick="() => SelectAdvancePatientFromList(item)" @ondblclick="() => SelectAdvancePatientFromList(item)">
                                                <td style="text-align: center; color: #94a3b8; font-weight: 600; font-size: 0.82rem;">
                                                    @rowIdx.ToString("00")
                                                </td>
                                                <td>
                                                    <span class="row-patient-name">@item.patient_name</span>
                                                    @if (!string.IsNullOrWhiteSpace(item.city))
                                                    {
                                                        <small class="text-muted d-block">@item.city</small>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border font-monospace">@GetUhidDisplay(item.custid, item.custcode)</span>
                                                </td>
                                                <td>@(string.IsNullOrWhiteSpace(item.mobile) ? "-" : item.mobile)</td>
                                                <td style="text-align: right; font-weight: 700; color: #1e1b4b; font-size: 0.92rem;">
                                                    ₹@item.total_deposited.ToString("N2")
                                                </td>
                                                <td style="text-align: right; font-weight: 600; color: #f59e0b; font-size: 0.9rem;">
                                                    ₹@item.total_used.ToString("N2")
                                                </td>
                                                <td style="text-align: right; font-weight: 600; color: #ef4444; font-size: 0.9rem;">
                                                    ₹@item.total_refunded.ToString("N2")
                                                </td>
                                                <td style="text-align: right;">
                                                    <span class="balance-badge @(item.available_balance > 0 ? "balance-positive" : "balance-zero")">
                                                        ₹@item.available_balance.ToString("N2")
                                                    </span>
                                                </td>
                                                <td style="text-align: center; font-size: 0.8rem; color: #64748b;">
                                                    @(item.last_deposit_date.HasValue ? item.last_deposit_date.Value.ToString("dd-MMM-yyyy") : "-")
                                                </td>
                                                <td style="text-align: center;">
                                                    <button type="button"
                                                            class="btn-select-advance"
                                                            @onclick="() => SelectAdvancePatientFromList(item)" 
                                                            @onclick:stopPropagation="true">
                                                        <i class="bi bi-journal-text me-1"></i>
                                                        <span>Ledger</span>
                                                        <i class="bi bi-chevron-right ms-1"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
                else if (advanceMainTab == "REFUND_HISTORY")
                {
                    <!-- Tab 4: Refund History Tab matching CashCounter -->
                    <div class="advance-list-card" style="padding: 1rem 1.25rem; margin-bottom: 1rem;">
                        <div style="display: flex; flex-wrap: nowrap; gap: 0.75rem; align-items: flex-end; overflow-x: auto;">
                            <div style="flex: 0 0 150px;">
                                <label style="font-size: 0.72rem; font-weight: 700; color: #64748b; text-transform: uppercase;">FROM DATE</label>
                                <input type="date" class="form-control form-control-sm" @bind="refundFromDate" />
                            </div>
                            <div style="flex: 0 0 150px;">
                                <label style="font-size: 0.72rem; font-weight: 700; color: #64748b; text-transform: uppercase;">TO DATE</label>
                                <input type="date" class="form-control form-control-sm" @bind="refundToDate" />
                            </div>
                            <div style="flex: 1 1 auto; min-width: 260px;">
                                <label style="font-size: 0.72rem; font-weight: 700; color: #64748b; text-transform: uppercase;">PATIENT / RECEIPT SEARCH</label>
                                <div class="list-search-wrap" style="width: 100%;">
                                    <i class="bi bi-search list-search-icon"></i>
                                    <input type="text" class="list-search-input" @bind="refundSearchQuery" placeholder="Receipt No, Patient Name or Mobile..." />
                                </div>
                            </div>
                            <div style="display: flex; flex: 0 0 auto; gap: 0.5rem;">
                                <button type="button" class="btn-advance-refresh" style="background: #4f46e5; color: #fff; border-color: #4f46e5;" @onclick="LoadRefundHistoryAsync">
                                    <i class="bi bi-search"></i> Filter
                                </button>
                                <button type="button" class="btn-advance-refresh" @onclick="ResetRefundHistoryFilterAsync">
                                    <i class="bi bi-arrow-clockwise"></i> Reset
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Refund History Table Card -->
                    <div class="advance-list-card" style="padding: 0; overflow: hidden;">
                        <div style="padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
                            <h4 style="margin: 0; font-size: 0.95rem; font-weight: 800; color: #1e293b;">Refund History Audit Log</h4>
                            <span class="badge-count">Total: @FilteredRefundHistory.Count refunds</span>
                        </div>
                        <div class="advance-table-responsive" style="border: none; border-radius: 0;">
                            <table class="advance-table">
                                <thead>
                                    <tr>
                                        <th style="width: 48px; text-align: center;">S.No</th>
                                        <th>RECEIPT NO</th>
                                        <th>DATE &amp; TIME</th>
                                        <th style="min-width: 220px;">PATIENT</th>
                                        <th>UHID</th>
                                        <th style="text-align: right;">REFUND AMOUNT</th>
                                        <th>PROCESSED BY</th>
                                        <th>COUNTER</th>
                                        <th>REMARKS</th>
                                        <th style="text-align: center; width: 80px;">PRINT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (FilteredRefundHistory.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="10" class="advance-table-empty">
                                                <i class="bi bi-clock-history" style="font-size: 2.2rem; color: #cbd5e1; display: block; margin-bottom: 0.5rem;"></i>
                                                No refund records found for the selected period.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        int ridx = 1;
                                        @foreach (var r in FilteredRefundHistory)
                                        {
                                            var refHistoryKey = !string.IsNullOrWhiteSpace(r.receiptguid) ? r.receiptguid : r.receiptsnoprint;
                                            <tr>
                                                <td style="text-align: center; color: #94a3b8; font-weight: 600;">@ridx</td>
                                                <td>
                                                    <span style="font-weight: 700; font-family: monospace; color: #0284c7;">@r.receiptsnoprint</span>
                                                </td>
                                                <td>@(r.receiptdate?.ToLocalTime().ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</td>
                                                <td>
                                                    <span style="font-weight: 700; color: #0f172a;">@r.patient_name</span>
                                                    @if (!string.IsNullOrWhiteSpace(r.mobile))
                                                    {
                                                        <br /><small class="text-muted">@r.mobile</small>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border font-monospace">@GetUhidDisplay(r.custid, r.custcode)</span>
                                                </td>
                                                <td style="text-align: right; font-weight: 800; color: #dc2626; font-size: 0.95rem;">
                                                    ₹@r.refund_amount.ToString("N2")
                                                </td>
                                                <td>@(string.IsNullOrWhiteSpace(r.processed_by) ? "Staff" : r.processed_by)</td>
                                                <td>@(string.IsNullOrWhiteSpace(r.counter_name) ? "Counter" : r.counter_name)</td>
                                                <td>
                                                    <span class="text-muted small text-truncate d-inline-block" style="max-width: 200px;" title="@r.remarks">@(string.IsNullOrWhiteSpace(r.remarks) ? "-" : r.remarks)</span>
                                                </td>
                                                <td style="text-align: center;">
                                                    <button type="button" class="btn-ledger-action-print refund" @onclick="() => PrintRefundReceiptAsync(refHistoryKey)" disabled="@(isPrintingReceipt && printingReceiptKey == refHistoryKey)" title="Preview & Print Refund Receipt">
                                                        <i class="bi bi-printer"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                            ridx++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (showCancelModal && cancellingRow != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-card-custom">
            <div class="modal-header-custom">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div class="modal-icon-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div>
                        <h4 style="margin: 0; font-size: 1.05rem; font-weight: 800; color: #0f172a;">Cancel Advance Receipt</h4>
                        <span style="font-size: 0.76rem; color: #64748b;">Reverses this advance transaction</span>
                    </div>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseCancelModal" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body-custom">
                <div class="cancel-summary-box">
                    <div class="cancel-info-row">
                        <span class="cancel-label">Receipt No:</span>
                        <span class="cancel-val" style="font-family: monospace; letter-spacing: 0.5px;">@cancellingRow.receiptsnoprint</span>
                    </div>
                    <div class="cancel-info-row">
                        <span class="cancel-label">Type:</span>
                        <span class="cancel-val"><span class="type-badge @(GetTransactionType(cancellingRow).ToLower())">@GetTransactionType(cancellingRow)</span></span>
                    </div>
                    <div class="cancel-info-row">
                        <span class="cancel-label">Amount:</span>
                        <span class="cancel-val" style="color: #e11d48; font-weight: 800; font-size: 1rem;">@cancellingRow.receiptamount.ToString("N2")</span>
                    </div>
                    <div class="cancel-info-row">
                        <span class="cancel-label">Receipt Date:</span>
                        <span class="cancel-val">@(cancellingRow.receiptdate.HasValue ? FormatIstDateTime(cancellingRow.receiptdate.Value) : "-")</span>
                    </div>
                </div>

                <div class="modal-reason-group">
                    <label style="font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.25rem;">
                        Cancellation Reason <span style="color: #ef4444;">*</span>
                    </label>
                    <textarea class="modal-textarea-custom" 
                              rows="3" 
                              placeholder="Enter detailed reason for cancelling this advance..." 
                              @bind="cancelReason"></textarea>
                </div>

            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn-modal-keep" @onclick="CloseCancelModal" disabled="@isCancellingAdvance">
                    <i class="bi bi-arrow-left-circle"></i>
                    <span>Keep Receipt</span>
                </button>
                <button type="button" class="btn-modal-confirm" @onclick="ConfirmCancelAdvanceAsync" disabled="@isCancellingAdvance">
                    @if (isCancellingAdvance)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" style="width: 14px; height: 14px;"></span>
                        <span>Cancelling...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash3-fill"></i>
                        <span>Confirm Cancel</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (showRevertAdvanceModal && revertingAdvanceRow != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-card-custom">
            <div class="modal-header-custom">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div class="modal-icon-danger" style="background: #fff7ed; color: #ea580c;">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </div>
                    <div>
                        <h4 style="margin: 0; font-size: 1.05rem; font-weight: 800; color: #0f172a;">Revert Used Advance</h4>
                        <span style="font-size: 0.76rem; color: #64748b;">Update the bill payment mode and restore the advance balance</span>
                    </div>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseRevertAdvanceModal" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body-custom">
                <div class="cancel-summary-box">
                    <div class="cancel-info-row">
                        <span class="cancel-label">Bill No:</span>
                        <span class="cancel-val font-monospace">@revertingAdvanceRow.bill_no</span>
                    </div>
                    <div class="cancel-info-row">
                        <span class="cancel-label">Amount:</span>
                        <span class="cancel-val" style="color: #ea580c; font-weight: 800;">₹@revertingAdvanceRow.receiptamount.ToString("N2")</span>
                    </div>
                </div>
                <div class="modal-reason-group">
                    <label style="font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 0.4rem; display: block;">New Paymode</label>
                    <select class="modal-select-field" @bind="revertAdvancePaymode">
                        @foreach (var paymode in revertAdvancePaymodes)
                        {
                            <option value="@(paymode.shortname ?? paymode.name)">
                                @(paymode.name ?? paymode.shortname)
                            </option>
                        }
                    </select>
                </div>
                <div class="modal-reason-group">
                    <label style="font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 0.4rem; display: block;">Reference / Reason</label>
                    <textarea class="modal-textarea-custom" rows="2" @bind="revertAdvanceReason" placeholder="Enter reason for changing the paymode..."></textarea>
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn-modal-keep" @onclick="CloseRevertAdvanceModal" disabled="@isRevertingAdvance">Cancel</button>
                <button type="button" class="btn-modal-confirm" @onclick="ConfirmRevertAdvanceAsync" disabled="@isRevertingAdvance">
                    @if (isRevertingAdvance)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Updating...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle"></i>
                        <span>REVERT</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

