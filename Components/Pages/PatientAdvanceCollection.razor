    private void OnModalRefundSearchKeyDown(KeyboardEventArgs e)
    {
        int count = modalRefundSearchMode == "IP" ? searchedModalRefundIpPatients.Count : modalRefundSearchResults.Count;
        if (count == 0) return;

        if (e.Key == "ArrowDown")
        {
            activeModalRefundIndex = (activeModalRefundIndex + 1) % count;
            showModalRefundDropdown = true;
        }
        else if (e.Key == "ArrowUp")
        {
            activeModalRefundIndex = (activeModalRefundIndex - 1 + count) % count;
            showModalRefundDropdown = true;
        }
        else if (e.Key == "Enter" && activeModalRefundIndex >= 0 && activeModalRefundIndex < count)
        {
            if (modalRefundSearchMode == "IP")
                _ = SelectModalRefundIpPatient(searchedModalRefundIpPatients[activeModalRefundIndex]);
            else
                _ = SelectModalRefundPatient(modalRefundSearchResults[activeModalRefundIndex]);
        }
        else if (e.Key == "Escape")
        {
            showModalRefundDropdown = false;
        }
    }

    private async Task SearchModalRefundPatientsAsync(System.Threading.CancellationToken token = default)
    {
        await EnsureModalPatientsMasterLoadedAsync();
        if (string.IsNullOrWhiteSpace(modalRefundSearchQuery))
        {
            modalRefundSearchResults = modalPatientsMasterCache.Take(25).ToList();
            showModalRefundDropdown = modalRefundSearchResults.Any();
            StateHasChanged();
            return;
        }

        var q = modalRefundSearchQuery.Trim();
        var matches = modalPatientsMasterCache.Where(p =>
            (!string.IsNullOrEmpty(p.name) && p.name.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(p.namewithinitials) && p.namewithinitials.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(p.custcode) && p.custcode.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(p.mobile) && p.mobile.Contains(q, StringComparison.OrdinalIgnoreCase))
        ).Take(25).ToList();

        modalRefundSearchResults = matches;
        showModalRefundDropdown = modalRefundSearchResults.Any();
        StateHasChanged();

        try
        {
            await Task.Delay(250, token);
            if (token.IsCancellationRequested) return;

            using var client = CreateClient(true);
            var response = await client.GetAsync($"api/Customer/search?key={Uri.EscapeDataString(q)}", token);
            if (token.IsCancellationRequested) return;

            if (!response.IsSuccessStatusCode)
            {
                response = await client.GetAsync($"api/OpRegistration/customers-with-op?key={Uri.EscapeDataString(q)}", token);
            }
            if (token.IsCancellationRequested) return;

            if (response.IsSuccessStatusCode)
            {
                var raw = await response.Content.ReadAsStringAsync(token);
                if (token.IsCancellationRequested) return;

                var apiList = ParseModalCustomersJson(raw);
                if (apiList.Any())
                {
                    foreach (var pat in apiList)
                    {
                        if (!modalRefundSearchResults.Any(x => x.custid == pat.custid))
                        {
                            modalRefundSearchResults.Add(pat);
                            if (!modalPatientsMasterCache.Any(x => x.custid == pat.custid))
                                modalPatientsMasterCache.Add(pat);
                        }
                    }
                    showModalRefundDropdown = modalRefundSearchResults.Any();
                    StateHasChanged();
                }
            }
        }
        catch { }
    }

