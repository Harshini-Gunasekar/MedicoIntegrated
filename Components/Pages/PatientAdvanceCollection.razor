    private async Task OpenRevertAdvanceModal(HmsAdvanceLedgerRow row)
        {
            try
            {
                revertingAdvanceRow = row;
                var paymodes = await PaymodeService.GetPaymodeMastersAsync();
                revertAdvancePaymodes = paymodes
                    .Where(p => !p.deleted && (!string.IsNullOrWhiteSpace(p.shortname) || !string.IsNullOrWhiteSpace(p.name)))
                    .OrderBy(p => p.orderno)
                    .ThenBy(p => p.name)
                    .ToList();
                if (revertAdvancePaymodes.Count == 0)
                {
                    ToastService.ShowError("No paymodes are available in Paymode Master.");
                    revertingAdvanceRow = null;
                    return;
                }

                var cashPaymode = revertAdvancePaymodes.FirstOrDefault(p =>
                    string.Equals(p.shortname, "CASH", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(p.name, "CASH", StringComparison.OrdinalIgnoreCase));
                revertAdvancePaymode = cashPaymode?.shortname ?? cashPaymode?.name ??
                    revertAdvancePaymodes.First().shortname ??
                    revertAdvancePaymodes.First().name ??
                    string.Empty;
                revertAdvanceReason = "Advance paymode changed";
                showRevertAdvanceModal = true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                revertingAdvanceRow = null;
                ToastService.ShowError($"Unable to load paymodes: {ex.Message}");
            }
        }

        private void CloseRevertAdvanceModal()
        {
            showRevertAdvanceModal = false;
            revertingAdvanceRow = null;
            StateHasChanged();
        }

        private async Task ConfirmRevertAdvanceAsync()
        {
            if (revertingAdvanceRow == null || string.IsNullOrWhiteSpace(revertingAdvanceRow.requestguid))
            {
                ToastService.ShowWarning("No bill was found for this advance usage.");
                return;
            }

            isRevertingAdvance = true;
            StateHasChanged();
            try
            {
                var paymodes = await PaymodeService.GetPaymodeMastersAsync();
                var selectedPaymode = paymodes.FirstOrDefault(p =>
                    string.Equals(p.shortname, revertAdvancePaymode, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(p.name, revertAdvancePaymode, StringComparison.OrdinalIgnoreCase));
                if (selectedPaymode == null)
                {
                    ToastService.ShowError("Selected paymode is not configured.");
                    return;
                }

                var bill = await HmsBillingService.GetBillByGuidAsync(revertingAdvanceRow.requestguid);
                if (bill == null)
                {
                    ToastService.ShowError("Unable to load the bill payment details.");
                    return;
                }

                var replacementAmount = revertingAdvanceRow.receiptamount;
                var (revertResult, revertMessage) = await DueCollectionService.RevertUsedAdvanceAsync(new HmsAdvanceRevertRequest
                {
                    requestguid = revertingAdvanceRow.requestguid,
                    revert_amount = replacementAmount,
                    pmcode = selectedPaymode.pmcode,
                    reference_no = string.Empty,
                    enteredbhcode = BranchCodeVal,
                    cntcode = CounterCodeVal,
                    usercode = UserCode,
                    computercode = 1,
                    reason = revertAdvanceReason
                });

                if (revertResult == null)
                {
                    ToastService.ShowError(revertMessage ?? "Advance could not be reverted.");
                    return;
                }

                var advancePaymodeCodes = new[] { 99d };
                var pmc1 = bill.pmc1;
                var pmc2 = bill.pmc2;
                var pmc3 = bill.pmc3;
                var pmc1Amount = bill.pmc1_amount;
                var pmc2Amount = bill.pmc2_amount;
                var pmc3Amount = bill.pmc3_amount;
                var advanceSlotFound = false;

                if (pmc1.HasValue && advancePaymodeCodes.Contains(pmc1.Value))
                {
                    pmc1 = (double)selectedPaymode.pmcode;
                    pmc1Amount = replacementAmount;
                    advanceSlotFound = true;
                }
                else if (pmc2.HasValue && advancePaymodeCodes.Contains(pmc2.Value))
                {
                    pmc2 = (double)selectedPaymode.pmcode;
                    pmc2Amount = replacementAmount;
                    advanceSlotFound = true;
                }
                else if (pmc3.HasValue && advancePaymodeCodes.Contains(pmc3.Value))
                {
                    pmc3 = (double)selectedPaymode.pmcode;
                    pmc3Amount = replacementAmount;
                    advanceSlotFound = true;
                }

                if (!advanceSlotFound)
                {
                    pmc1 = (double)selectedPaymode.pmcode;
                    pmc1Amount = replacementAmount;
                }

                var totalPaid = (pmc1Amount ?? 0) + (pmc2Amount ?? 0) + (pmc3Amount ?? 0);
                var activePaymodeCount = new[] { pmc1Amount, pmc2Amount, pmc3Amount }
                    .Count(amount => (amount ?? 0) > 0);
                var hasCashPaymode = (pmc1 == (double)selectedPaymode.pmcode && string.Equals(selectedPaymode.shortname, "CASH", StringComparison.OrdinalIgnoreCase)) ||
                    (pmc2 == (double)selectedPaymode.pmcode && string.Equals(selectedPaymode.shortname, "CASH", StringComparison.OrdinalIgnoreCase)) ||
                    (pmc3 == (double)selectedPaymode.pmcode && string.Equals(selectedPaymode.shortname, "CASH", StringComparison.OrdinalIgnoreCase));
                var updateResult = await HmsBillingService.UpdateBillAsync(new HmsBillModel
                {
                    requestguid = bill.requestguid,
                    op_id = bill.op_id,
                    ip_id = bill.ip_id,
                    custid = bill.custid ?? advanceSummary?.custid ?? 0,
                    patient_name = bill.patient_name,
                    mobileno = bill.mobileno,
                    dateofbirth = bill.dateofbirth,
                    ageyears = bill.ageyears,
                    dcode = bill.dcode ?? 0,
                    consultantdcode = bill.dcode ?? 0,
                    enteredbhcode = bill.enteredbhcode ?? BranchCodeVal,
                    cntcode = bill.cntcode ?? CounterCodeVal,
                    usercode = UserCode,
                    pmc1 = pmc1,
                    pmc1_amount = pmc1Amount,
                    pmc2 = pmc2,
                    pmc2_amount = pmc2Amount,
                    pmc3 = pmc3,
                    pmc3_amount = pmc3Amount,
                    paidamount = (decimal)totalPaid,
                    collection_type = activePaymodeCount > 1 ? "MULTI" : selectedPaymode.shortname ?? selectedPaymode.name,
                    iscashbill = hasCashPaymode,
                    iscreditbill = false,
                    items = bill.items?.Select((item, index) => new HmsBillItemModel
                    {
                        sno = index + 1,
                        charge_type = item.charge_type ?? "INVESTIGATION",
                        item_name = item.item_name,
                        tcode = item.tcode ?? 0,
                        item_ref_id = item.item_ref_id,
                        unit_rate = (decimal)(item.unit_rate ?? 0),
                        amount = (decimal)(item.amount ?? 0),
                        qty = (decimal)(item.qty ?? 1),
                        discount = (decimal)(item.discount ?? 0),
                        requestdetailsid = item.requestdetailsid
                    }).ToList() ?? new()
                });

                if (string.IsNullOrWhiteSpace(updateResult) ||
                    updateResult.Contains("error", StringComparison.OrdinalIgnoreCase) ||
                    updateResult.Contains("failed", StringComparison.OrdinalIgnoreCase))
                {
                    ToastService.ShowError("Advance was reverted, but the bill paymode split could not be updated.");
                    return;
                }

                ToastService.ShowSuccess("Advance reverted and bill paymode updated successfully.");
                CloseRevertAdvanceModal();
                await LoadPatientAdvance();
                _ = LoadAllAdvancePatientsAsync();
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Unable to revert advance: {ex.Message}");
            }
            finally
            {
                isRevertingAdvance = false;
                StateHasChanged();
            }
    }

