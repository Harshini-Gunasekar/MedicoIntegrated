        .btn-modal-keep {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            padding: 0.52rem 1.15rem;
            border-radius: 9px;
            font-size: 0.85rem;
            font-weight: 700;
            border: 1.5px solid #cbd5e1;
            background: #ffffff;
            color: #475569;
            cursor: pointer;
            transition: all 0.18s ease;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        }

        .btn-modal-keep:hover:not(:disabled) {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #94a3b8;
        }

        .btn-modal-confirm {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            padding: 0.52rem 1.35rem;
            border-radius: 9px;
            font-size: 0.85rem;
            font-weight: 700;
            border: 1px solid #dc2626;
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: #ffffff;
            cursor: pointer;
            transition: all 0.18s ease;
            box-shadow: 0 3px 8px rgba(220, 38, 38, 0.28);
        }

        .btn-modal-confirm:hover:not(:disabled) {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            box-shadow: 0 5px 12px rgba(220, 38, 38, 0.38);
            transform: translateY(-1px);
        }

        .btn-modal-confirm:disabled, .btn-modal-keep:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none !important;
        }
    </style>

    <!-- Top Header Card (Matching DueCollection) -->
    <div class="due-header-card">
        <div style="display: flex; align-items: center; gap: 1.25rem; flex-shrink: 0;">
            <div class="header-icon-container">
                <i class="bi bi-piggy-bank"></i>
            </div>
            <div class="header-text-container">
                <h1>Patient Advance Collection</h1>
                <p><span class="header-status-dot"></span> ADVANCE MANAGEMENT &amp; DEPOSITS</p>
            </div>
        </div>

        <!-- Header Controls: Search + Branch + Counter -->
        <div class="header-controls-group">

            <!-- Patient Search Autocomplete -->
                        <!-- Patient Search Autocomplete with IP / All Toggle -->
            <div class="header-control-item">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.25rem;">
                    <label style="margin-bottom: 0;"><i class="bi bi-person-badge me-1"></i> PATIENT SEARCH</label>
                    <div class="patient-search-toggle-group">
                        <button type="button" 
                                class="search-toggle-btn @(patientSearchMode == "IP" ? "active" : "")" 
                                @onclick='() => SetSearchMode("IP")' 
                                title="Search and dropdown only IP Admitted Patients">
                            <i class="bi bi-hospital me-1"></i> IP Patients
                        </button>
                        <button type="button" 
                                class="search-toggle-btn @(patientSearchMode == "ALL" ? "active" : "")" 
                                @onclick='() => SetSearchMode("ALL")' 
                                title="Search and dropdown all registered patients">
                            <i class="bi bi-people me-1"></i> All Patients
                        </button>
                    </div>
                </div>
                <div class="header-search-wrapper" style="position: relative;">
                    <i class="bi bi-search header-search-icon"></i>
                    <input @key="@("advance_patient_search_input_" + patientSearchMode)"
                           type="text"
                           class="header-search-input"
                           placeholder="@(patientSearchMode == "IP" ? "Search IP Patient (Name, Mobile, IP No)..." : "Search Patient Name or Mobile...")"
                           value="@patientSearchQuery"
                           @oninput="OnPatientSearchInput"
                           @onfocus="OnPatientSearchFocus"
                           @onkeydown="OnPatientSearchKeyDown"
                           autocomplete="off" />
                    @if (patientSearchMode == "IP" && showIpPatientDropdown && searchedIpPatients.Count > 0)
                    {
                        <div class="patient-autocomplete-dropdown">
                            @for (int i = 0; i < searchedIpPatients.Count; i++)
                            {
                                var ipIdx = i;
                                var ip = searchedIpPatients[i];
                                var displayName = ip.GetPatientName();
                                if (string.IsNullOrWhiteSpace(displayName)) displayName = $"Patient {ip.custid}";
                                var initialChar = displayName.FirstOrDefault(c => char.IsLetterOrDigit(c));
                                var avatarChar = initialChar != default ? initialChar.ToString().ToUpper() : "P";

                                <div @key="@($"ip_drop_{ip.ip_id}_{ipIdx}")" 
                                     class="patient-dropdown-item @(ipIdx == activePatientIndex ? "active-focused" : "")" 
                                     @onclick="() => SelectIpPatient(ip)" 
                                     @onmouseover="() => activePatientIndex = ipIdx"
                                     @onmousedown:preventDefault="true">
                                    <div class="dropdown-patient-avatar" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">
                                        @avatarChar
                                    </div>
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
                                            <div class="dropdown-patient-name">@displayName (CUST-@ip.custid)</div>
                                            @if (!string.IsNullOrWhiteSpace(ip.ip_no))
                                            {
                                                <span class="badge bg-primary text-white" style="font-size: 0.68rem; font-weight: 700; padding: 2px 6px; border-radius: 4px;">@ip.ip_no</span>
                                            }
                                        </div>
                                        <div class="dropdown-patient-id">
                                            <i class="bi bi-telephone me-1 text-muted"></i>@(string.IsNullOrWhiteSpace(ip.mobile) ? "No Mobile" : ip.mobile)
                                            @if (!string.IsNullOrWhiteSpace(ip.admission_type))
                                            {
                                                <span> | <i class="bi bi-hospital me-1 text-muted"></i>@ip.admission_type</span>
                                            }
                                            <span class="badge bg-success-subtle text-success ms-1" style="font-size: 0.65rem; border: 1px solid rgba(16, 185, 129, 0.2);">@ip.ip_status</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (patientSearchMode == "ALL" && showPatientDropdown && searchedPatients.Count > 0)
                    {
                        <div class="patient-autocomplete-dropdown">
                            @for (int i = 0; i < searchedPatients.Count; i++)
                            {
                                var patIdx = i;
                                var pat = searchedPatients[i];
                                var displayName = !string.IsNullOrWhiteSpace(pat.namewithinitials) 
                                    ? pat.namewithinitials 
                                    : (!string.IsNullOrWhiteSpace(pat.name) ? pat.name : $"Customer {pat.custid}");
                                var initialChar = displayName.FirstOrDefault(c => char.IsLetterOrDigit(c));
                                var avatarChar = initialChar != default ? initialChar.ToString().ToUpper() : "P";

                                <div @key="pat.custid > 0 ? pat.custid : (long)patIdx" class="patient-dropdown-item @(patIdx == activePatientIndex ? "active-focused" : "")" 
                                     @onclick="() => SelectCustomerPatient(pat)" 
                                     @onmouseover="() => activePatientIndex = patIdx"
                                     @onmousedown:preventDefault="true">
                                    <div class="dropdown-patient-avatar">
                                        @avatarChar
                                    </div>
                                    <div>
                                        <div class="dropdown-patient-name">@displayName (CUST-@pat.custid)</div>
                                        <div class="dropdown-patient-id">
                                            <i class="bi bi-telephone me-1 text-muted"></i>@(string.IsNullOrWhiteSpace(pat.mobile) ? (string.IsNullOrWhiteSpace(pat.phone) ? "No Mobile" : pat.phone) : pat.mobile)
                                            @if (!string.IsNullOrWhiteSpace(pat.area) || !string.IsNullOrWhiteSpace(pat.city))
                                            {
                                                <span> | <i class="bi bi-geo-alt me-1 text-muted"></i>@pat.area@(string.IsNullOrWhiteSpace(pat.city) ? "" : $", {pat.city}")</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Branch Dropdown -->
            <div class="header-control-item">
                <label><i class="bi bi-building me-1"></i> BRANCH</label>
                <select class="header-select" @bind="selectedBranchCode" @bind:after="OnHeaderBranchChanged">
                    <option value="">All Branches</option>
                    @foreach (var b in branchesList)
                    {
                        <option value="@b.bh_code">@b.name</option>
                    }
                </select>
            </div>

            <!-- Counter Dropdown -->
            <div class="header-control-item">
                <label><i class="bi bi-grid-3x2-gap me-1"></i> COUNTER</label>
                <select class="header-select" @bind="selectedCounterCode">
                    <option value="">All Counters</option>
                    @foreach (var c in filteredCountersList)
                    {
                        <option value="@c.cntcode">@c.name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div>
        @if (loadingAdvance)
        {
            <div class="advance-main-card" style="text-align: center; padding: 3rem;">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2 text-muted" style="font-size:0.85rem;">Fetching patient advance summary...</div>
            </div>
        }
        else if (advanceSummary != null)
        {
            <div class="advance-main-card">

                <!-- Patient Row -->
                                <!-- Patient Row -->
                <div class="patient-row" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <div class="patient-avatar-lg">
                            @(advanceSummary.patient_name?.FirstOrDefault().ToString().ToUpper() ?? "?")
                        </div>
                        <div>
                            <p class="patient-name-lg">@advanceSummary.patient_name</p>
                            <p class="patient-id-sm">UHID: <b>@advanceSummary.custid</b></p>
                        </div>
                    </div>
                    <button type="button" class="btn-back-to-list" @onclick="ClearSelectedPatient" title="Return to All Advance Patients List">
                        <i class="bi bi-arrow-left me-1"></i> Back to Advance List
                    </button>
                </div>

                <!-- Summary Stats -->
                <div class="summary-grid-4">
                    <div class="stat-card deposited">
                        <span class="stat-label">Total Advance Deposited</span>
                        <span class="stat-value">₹ @GetTotalDeposited().ToString("N2")</span>
                    </div>
                    <div class="stat-card used">
                        <span class="stat-label">Total Advance Used</span>
                        <span class="stat-value">₹ @GetTotalUsed().ToString("N2")</span>
                    </div>
                    <div class="stat-card refunded">
                        <span class="stat-label">Total Advance Refunded</span>
                        <span class="stat-value">₹ @GetTotalRefunded().ToString("N2")</span>
                    </div>
                    <div class="stat-card balance">
                        <span class="stat-label">Available Balance</span>
                        <span class="stat-value">₹ @GetAvailableBalance().ToString("N2")</span>
                    </div>
                </div>

                <!-- Deposit/Refund + Ledger -->
                <div class="content-split">

                    <!-- Left: Deposit / Refund Form -->
                    <div class="left-panel">
                        <!-- Tab Pills -->
                        <div class="tab-pills">
                            <button class="tab-pill @(advanceSubTab == "deposit" ? "active-deposit" : "")" @onclick='() => advanceSubTab = "deposit"'>
                                <i class="bi bi-plus-circle"></i> Deposit
                            </button>
                            <button class="tab-pill @(advanceSubTab == "refund" ? "active-refund" : "")" @onclick='() => advanceSubTab = "refund"'>
                                <i class="bi bi-dash-circle"></i> Refund
                            </button>
                        </div>

                        @if (advanceSubTab == "deposit")
                        {
                            <div class="form-panel">
                                <h3><i class="bi bi-plus-circle text-success"></i> Deposit New Advance</h3>
                                <div class="field-group">
                                    <label class="field-label">Amount (₹)</label>
                                    <input @key="@("advance_deposit_amt")" type="text" inputmode="decimal" class="field-input" placeholder="Enter amount to deposit..." value="@depositAmountText" @oninput="OnDepositAmountInput" />
                                </div>
                                <div class="field-group">
                                    <label class="field-label">Pay Mode</label>
                                    <select class="field-input" @bind="depositPayMode">
                                        <option value="CASH">CASH</option>
                                        <option value="CARD">CARD</option>
                                        <option value="GPAY">GPAY</option>
                                        <option value="UPI">UPI</option>
                                    </select>
                                </div>
                                <div class="field-group">
                                    <label class="field-label">Remarks / Notes</label>
                                    <textarea class="field-input" style="height: 50px; resize: none;" placeholder="e.g. advance for IP or lab..." @bind="depositRemarks"></textarea>
                                </div>
                                <button class="btn-deposit-main" @onclick="DepositAdvance" disabled="@(depositAmount <= 0 || actionRunning)">
                                    @if (actionRunning)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    }
                                    Deposit Advance
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="form-panel">
                                <h3><i class="bi bi-dash-circle text-danger"></i> Refund Available Balance</h3>
                                <div class="field-group">
                                    <label class="field-label">Refund Amount (₹)</label>
                                    <input @key="@("advance_refund_amt")" type="text" inputmode="decimal" class="field-input" placeholder="Max: @GetAvailableBalance().ToString("N2")" value="@refundAmountText" @oninput="OnRefundAmountInput" />
                                </div>
                                <div class="field-group">
                                    <label class="field-label">Remarks / Notes</label>
                                    <textarea class="field-input" style="height: 85px; resize: none;" placeholder="e.g. patient requested refund..." @bind="refundRemarks"></textarea>
                                </div>
                                <button class="btn-refund-main" @onclick="RefundAdvance" disabled="@(refundAmount <= 0 || refundAmount > GetAvailableBalance() || actionRunning)">
                                    @if (actionRunning)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    }
                                    Refund Advance
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Right: Transaction Ledger -->
                    <div class="right-panel">
                        <div class="ledger-panel">
                            <div class="ledger-header" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                                <h3 class="ledger-title" style="margin: 0;">
                                    <i class="bi bi-list-stars"></i> Transaction Ledger History
                                </h3>
                                <div style="display: flex; align-items: center; gap: 0.45rem;">
                                    <div class="page-format-pill-toggle" role="group" aria-label="Receipt Paper Format">
                                        <button type="button" class="format-btn @(selectedPageFormat == "A4" ? "active" : "")" @onclick='() => selectedPageFormat = "A4"' title="Format: A4 (Full Page)">
                                            <i class="bi bi-file-earmark-text-fill format-icon"></i>
                                            <span>A4</span>
                                        </button>
                                        <button type="button" class="format-btn @(selectedPageFormat == "A5" ? "active" : "")" @onclick='() => selectedPageFormat = "A5"' title="Format: A5 (Half Page)">
                                            <i class="bi bi-file-earmark-fill format-icon"></i>
                                            <span>A5</span>
                                        </button>
                                    </div>
                                    <button class="btn btn-sm" style="background: #eef2ff; color: #4f46e5; border: 1px solid #c7d2fe; border-radius: 8px; font-weight: 700; font-size: 0.75rem; height: 32px; padding: 0 0.65rem; display: inline-flex; align-items: center; gap: 4px;"
                                            @onclick="PrintAllPatientReceiptsAsync" disabled="@(advancePatientId == null || isPrintingReceipt)" title="Print all receipts for this patient (each on separate page)">
                                        @if (isPrintingReceipt && printingReceiptKey == "ALL")
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status" style="width: 12px; height: 12px;"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-printer-fill" style="font-size: 0.78rem;"></i>
                                        }
                                        <span>Print All</span>
                                    </button>
                                    <button class="btn-icon-sm" @onclick="FetchAdvanceSummaryHistory" disabled="@(advancePatientId == null)" title="Refresh">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </div>
                            </div>
                            <div style="overflow-x: auto; max-height: 360px; overflow-y: auto;">
                                <table class="ledger-table">
                                    <thead>
                                        <tr>
                                            <th>DATE</th>
                                            <th>RECEIPT / BILL NO</th>
                                            <th>CUSTOMER</th>
                                            <th>UHID</th>
                                            <th>TYPE</th>
                                            <th style="text-align:right;">AMOUNT</th>
                                            <th style="text-align:center; width: 85px;">ACTION</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (loadingLedger)
                                        {
                                            <tr><td colspan="7" style="text-align:center; padding: 2rem;">
                                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                <span class="ms-2 text-muted" style="font-size:0.82rem;">Loading ledger...</span>
                                            </td></tr>
                                        }
                                        else if (advanceSummary.ledger == null || advanceSummary.ledger.Count == 0)
                                        {
                                            <tr><td colspan="7" style="text-align:center; padding: 2rem; color:#94a3b8; font-size:0.82rem;">No transactions recorded yet.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var row in advanceSummary.ledger)
                                            {
                                                var typeDisplay = GetTransactionType(row);
                                                resolvedCustomerNames.TryGetValue(row, out var patientName);
                                                var rowReceiptKey = !string.IsNullOrWhiteSpace(row.receiptguid) ? row.receiptguid : row.receiptsnoprint;
                                                <tr>
                                                    <td>@(row.receiptdate.HasValue ? FormatIstDateTime(row.receiptdate.Value) : "-")</td>
                                                    <td style="font-family: monospace; font-weight: 700;">@row.receiptsnoprint</td>
                                                    <td style="font-weight: 600;">@(patientName ?? advanceSummary.patient_name ?? "-")</td>
                                                    <td><span class="badge bg-light text-dark border">@(advanceSummary.custid > 0 ? advanceSummary.custid.ToString() : "-")</span></td>
                                                    <td>
                                                        <span class="type-badge @(typeDisplay.ToLower())">@typeDisplay</span>
                                                    </td>
                                                    <td style="text-align:right; font-weight: 700; color: @(typeDisplay == "DEPOSIT" ? "#16a34a" : typeDisplay == "USED" ? "#1d4ed8" : "#dc2626");">
                                                        ₹ @row.receiptamount.ToString("N2")
                                                    </td>
                                                    <td style="text-align:center; white-space: nowrap;">
                                                        <div style="display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem;">
                                                            @if (typeDisplay == "DEPOSIT")
                                                            {
                                                                <button type="button" class="btn-receipt-print deposit" 
                                                                        @onclick="() => PrintAdvanceReceiptAsync(rowReceiptKey)" 
                                                                        disabled="@(isPrintingReceipt && printingReceiptKey == rowReceiptKey)"
                                                                        title="Print Advance Receipt (@selectedPageFormat)">
                                                                    @if (isPrintingReceipt && printingReceiptKey == rowReceiptKey)
                                                                    {
                                                                        <span class="spinner-border spinner-border-sm" role="status" style="width: 11px; height: 11px;"></span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="bi bi-printer"></i>
                                                                    }
                                                                    <span class="ms-1">Receipt</span>
                                                                </button>
                                                                <button type="button" class="btn-receipt-cancel" 
                                                                        @onclick="() => PromptCancelAdvance(row)" 
                                                                        disabled="@(actionRunning || isCancellingAdvance)"
                                                                        title="Cancel this advance deposit receipt">
                                                                    <i class="bi bi-x-circle"></i>
                                                                    <span class="ms-1">Cancel</span>
                                                                </button>
                                                            }
                                                            else if (typeDisplay == "REFUND" || typeDisplay == "REFUNDED")
                                                            {
                                                                <button type="button" class="btn-receipt-print refund" 
                                                                        @onclick="() => PrintRefundReceiptAsync(rowReceiptKey)" 
                                                                        disabled="@(isPrintingReceipt && printingReceiptKey == rowReceiptKey)"
                                                                        title="Print Refund Receipt (@selectedPageFormat)">
                                                                    @if (isPrintingReceipt && printingReceiptKey == rowReceiptKey)
                                                                    {
                                                                        <span class="spinner-border spinner-border-sm" role="status" style="width: 11px; height: 11px;"></span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="bi bi-printer"></i>
                                                                    }
                                                                    <span class="ms-1">Receipt</span>
                                                                </button>
                                                                <button type="button" class="btn-receipt-cancel" 
                                                                        @onclick="() => PromptCancelAdvance(row)" 
                                                                        disabled="@(actionRunning || isCancellingAdvance)"
                                                                        title="Cancel this advance refund receipt">
                                                                    <i class="bi bi-x-circle"></i>
                                                                    <span class="ms-1">Cancel</span>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted" style="font-size:0.75rem;">-</span>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
        else
        {
                        <div class="advance-list-card">
                <!-- Header of Advance Patients List -->
                <div class="advance-list-header">
                    <div class="advance-list-title-wrap">
                        <div class="advance-list-icon">
                            <i class="bi bi-wallet2"></i>
                        </div>
                        <div>
                            <div style="display: flex; align-items: center; gap: 0.6rem;">
                                <h3 class="advance-list-title">Advance Deposited Patients</h3>
                                <span class="badge-count">@filteredAdvanceList.Count Patients</span>
                            </div>
                            <p class="advance-list-subtitle">List of all patients with deposited advance balance and transaction summary</p>
                        </div>
                    </div>

                    <div class="advance-list-tools">
                        <!-- Quick search within advance list -->
                        <div class="list-search-wrap">
                            <i class="bi bi-search list-search-icon"></i>
                            <input type="text" 
                                   class="list-search-input" 
                                   placeholder="Filter advance list..." 
                                   @bind="advanceFilterQuery" 
                                   @bind:event="oninput" />
                            @if (!string.IsNullOrWhiteSpace(advanceFilterQuery))
                            {
                                <button type="button" class="list-search-clear" @onclick='() => advanceFilterQuery = ""'>
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                        </div>

                        <!-- Refresh button -->
                        <button type="button" class="btn-refresh-list" @onclick="LoadAllAdvancePatientsAsync" title="Refresh advance list">
                            <i class="bi bi-arrow-clockwise @(loadingAllAdvances ? "spin-icon" : "")"></i>
                            <span class="ms-1">Refresh</span>
                        </button>
                    </div>
                </div>

                <!-- Advance Metrics Summary Bar -->
                @if (allAdvancePatients.Count > 0)
                {
                    <div class="advance-metrics-bar">
                        <div class="metric-pill">
                            <span class="metric-label">Total Deposited</span>
                            <span class="metric-val text-indigo">â‚¹@allAdvancePatients.Sum(x => x.total_deposited).ToString("N2")</span>
                        </div>
                        <div class="metric-pill">
                            <span class="metric-label">Total Used</span>
                            <span class="metric-val text-amber">â‚¹@allAdvancePatients.Sum(x => x.total_used).ToString("N2")</span>
                        </div>
                        <div class="metric-pill">
                            <span class="metric-label">Total Refunded</span>
                            <span class="metric-val text-rose">â‚¹@allAdvancePatients.Sum(x => x.total_refunded).ToString("N2")</span>
                        </div>
                        <div class="metric-pill metric-highlight">
                            <span class="metric-label">Total Available Balance</span>
                            <span class="metric-val text-emerald">â‚¹@allAdvancePatients.Sum(x => x.available_balance).ToString("N2")</span>
                        </div>
                    </div>
                }

                <!-- Advance Patients Table -->
                @if (loadingAllAdvances)
                {
                    <div style="text-align: center; padding: 4rem 2rem;">
                        <div class="spinner-border text-primary" role="status" style="width: 2.2rem; height: 2.2rem;"></div>
                        <div class="mt-2 text-muted" style="font-size: 0.88rem; font-weight: 500;">Loading advance deposited patients...</div>
                    </div>
