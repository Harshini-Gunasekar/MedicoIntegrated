<!-- Modal 1: Request Deposit to Cash Counter -->
@if (showRequestDepositModal)
{
    <div class="modal-backdrop" style="position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); z-index: 1050; backdrop-filter: blur(3px);"></div>
    <div class="payment-modal animated-modal" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: #fff; width: 95%; max-width: 550px; border-radius: 18px; box-shadow: 0 25px 60px -12px rgba(15, 23, 42, 0.35); z-index: 1055; overflow: hidden; border: 1px solid rgba(2, 132, 199, 0.2);">
        <!-- Modal Header -->
        <div style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); padding: 1.15rem 1.4rem; display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 0.85rem;">
                <div style="background: rgba(255, 255, 255, 0.2); color: #ffffff; width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <h3 style="color: #ffffff; margin: 0; font-size: 1.15rem; font-weight: 800; letter-spacing: -0.01em;">Request Advance Deposit</h3>
                    <p style="color: #e0f2fe; margin: 0; font-size: 0.78rem;">Send deposit request directly to Cash Counter</p>
                </div>
            </div>
            <button type="button" class="btn-modal-close-icon" @onclick="CloseRequestDepositModal" aria-label="Close" title="Close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div style="padding: 1.4rem; max-height: calc(85vh - 130px); overflow-y: auto;">
            <!-- Patient Search Autocomplete Dropdown with IP / All Toggle -->
            <div class="modal-form-group position-relative">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.35rem;">
                    <label class="modal-form-label" style="margin-bottom: 0;">
                        <span><i class="bi bi-person-badge me-1 text-primary"></i> SELECT / SEARCH PATIENT <span class="text-danger">*</span></span>
                    </label>
                    <div class="patient-search-toggle-group">
