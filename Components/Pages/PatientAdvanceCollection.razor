    private async Task EnsureModalPatientsMasterLoadedAsync()
    {
        if (modalPatientsMasterCache.Count >= 25) return;
        isLoadingModalPatientsMaster = true;
        try
        {
            // 1. Prioritize active IP admissions
            foreach (var ip in allIpAdmissions)
            {
                if (modalPatientsMasterCache.Any(p => p.custid == (long)ip.custid)) continue;
                modalPatientsMasterCache.Add(new Booking.Models.CustomerWithOpModel
                {
                    custid = (long)ip.custid,
                    custcode = ip.ip_no,
                    name = ip.patient_name,
                    namewithinitials = ip.patient_name,
                    mobile = ip.mobile
                });
            }

            // 2. Add patients with existing advance balances
            foreach (var adv in allAdvancePatients)
            {
                if (modalPatientsMasterCache.Any(p => p.custid == adv.custid)) continue;
                modalPatientsMasterCache.Add(new Booking.Models.CustomerWithOpModel
                {
                    custid = (long)adv.custid,
                    custcode = adv.custcode,
                    name = adv.patient_name,
                    namewithinitials = adv.patient_name,
                    mobile = adv.mobile
                });
            }

            // 3. Query Customer partition endpoint for patient master
            using var client = CreateClient(true);
            var response = await client.GetAsync("api/Customer/partition?pagenumber=1&pagesize=50");
            if (response.IsSuccessStatusCode)
            {
                var raw = await response.Content.ReadAsStringAsync();
                var list = ParseModalCustomersJson(raw);
                foreach (var c in list)
                {
                    if (!modalPatientsMasterCache.Any(p => p.custid == c.custid))
                    {
                        modalPatientsMasterCache.Add(c);
                    }
                }
            }
        }
        catch { }
        finally
        {
            isLoadingModalPatientsMaster = false;
        }
    }

    private List<Booking.Models.CustomerWithOpModel> ParseModalCustomersJson(string rawJson)
    {
        if (string.IsNullOrWhiteSpace(rawJson)) return new();
        try
        {
            var settings = new Newtonsoft.Json.JsonSerializerSettings { NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore };
            var jToken = Newtonsoft.Json.Linq.JToken.Parse(rawJson);
            if (jToken is Newtonsoft.Json.Linq.JObject obj && obj["value"] != null)
            {
                return obj["value"].ToObject<List<Booking.Models.CustomerWithOpModel>>(Newtonsoft.Json.JsonSerializer.Create(settings)) ?? new();
            }
            else if (jToken is Newtonsoft.Json.Linq.JArray)
            {
                return Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.CustomerWithOpModel>>(rawJson, settings) ?? new();
            }
        }
        catch { }
        return new();
    }

