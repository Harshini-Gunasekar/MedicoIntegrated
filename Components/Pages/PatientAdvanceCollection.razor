    </style>

    <!-- Top Header Card (Matching DueCollection) -->
    <div class="due-header-card">
        <div style="display: flex; align-items: center; gap: 1.25rem; flex-shrink: 0;">
            <div class="header-icon-container">
                <i class="bi bi-piggy-bank"></i>
            </div>
            <div class="header-text-container">
                <h1>Patient Advance Collection</h1>
                <p><span class="header-status-dot"></span> ADVANCE MANAGEMENT &amp; DEPOSITS</p>
            </div>
        </div>

        <!-- Header Controls: Search + Branch + Counter -->
        <div class="header-controls-group">

            <!-- Patient Search Autocomplete -->
            <div class="header-control-item">
                <label><i class="bi bi-person-badge me-1"></i> PATIENT SEARCH</label>
                <div class="header-search-wrapper" style="position: relative;">
                    <i class="bi bi-search header-search-icon"></i>
                    <input type="text"
                           class="header-search-input"
                           placeholder="Search Patient Name or Mobile..."
                           value="@patientSearchQuery"
                           @oninput="OnPatientSearchInput"
                           @onkeydown="OnPatientSearchKeyDown"
                           autocomplete="off" />
                    @if (showPatientDropdown && searchedPatients.Count > 0)
                    {
                        <div class="patient-autocomplete-dropdown">
                            @for (int i = 0; i < searchedPatients.Count; i++)
                            {
                                var patIdx = i;
                                var pat = searchedPatients[i];
                                var displayName = !string.IsNullOrWhiteSpace(pat.namewithinitials) 
                                    ? pat.namewithinitials 
                                    : (!string.IsNullOrWhiteSpace(pat.name) ? pat.name : $"Customer {pat.custid}");
                                var initialChar = displayName.FirstOrDefault(c => char.IsLetterOrDigit(c));
                                var avatarChar = initialChar != default ? initialChar.ToString().ToUpper() : "P";

                                <div class="patient-dropdown-item @(patIdx == activePatientIndex ? "active-focused" : "")" 
                                     @onclick="() => SelectCustomerPatient(pat)" 
                                     @onmouseover="() => activePatientIndex = patIdx"
                                     @onmousedown:preventDefault="true">
                                    <div class="dropdown-patient-avatar">
                                        @avatarChar
                                    </div>
                                    <div>
                                        <div class="dropdown-patient-name">@displayName (CUST-@pat.custid)</div>
                                        <div class="dropdown-patient-id">
                                            📞 @(string.IsNullOrWhiteSpace(pat.mobile) ? (string.IsNullOrWhiteSpace(pat.phone) ? "No Mobile" : pat.phone) : pat.mobile) 
                                            @if (!string.IsNullOrWhiteSpace(pat.area) || !string.IsNullOrWhiteSpace(pat.city))
                                            {
                                                <span> | 📍 @pat.area@(string.IsNullOrWhiteSpace(pat.city) ? "" : $", {pat.city}")</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Branch Dropdown -->
            <div class="header-control-item">
                <label><i class="bi bi-building me-1"></i> BRANCH</label>
                <select class="header-select" @bind="selectedBranchCode" @bind:after="OnHeaderBranchChanged">
                    <option value="">All Branches</option>
                    @foreach (var b in branchesList)
                    {
                        <option value="@b.bh_code">@b.name</option>
                    }
                </select>
            </div>

            <!-- Counter Dropdown -->
            <div class="header-control-item">
                <label><i class="bi bi-grid-3x2-gap me-1"></i> COUNTER</label>
                <select class="header-select" @bind="selectedCounterCode">
                    <option value="">All Counters</option>
                    @foreach (var c in filteredCountersList)
                    {
                        <option value="@c.cntcode">@c.name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div>
        @if (loadingAdvance)
        {
            <div class="advance-main-card" style="text-align: center; padding: 3rem;">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2 text-muted" style="font-size:0.85rem;">Fetching patient advance summary...</div>
            </div>
        }
        else if (advanceSummary != null)
        {
            <div class="advance-main-card">

                <!-- Patient Row -->
                <div class="patient-row">
                    <div class="patient-avatar-lg">
                        @(advanceSummary.patient_name?.FirstOrDefault().ToString().ToUpper() ?? "?")
                    </div>
                    <div>
                        <p class="patient-name-lg">@advanceSummary.patient_name</p>
                        <p class="patient-id-sm">Customer ID: <b>@advanceSummary.custid</b></p>
                    </div>
                </div>

                <!-- Summary Stats -->
                <div class="summary-grid-4">
                    <div class="stat-card deposited">
                        <span class="stat-label">Total Advance Deposited</span>
                        <span class="stat-value">₹ @GetTotalDeposited().ToString("N2")</span>
                    </div>
                    <div class="stat-card used">
                        <span class="stat-label">Total Advance Used</span>
                        <span class="stat-value">₹ @GetTotalUsed().ToString("N2")</span>
                    </div>
                    <div class="stat-card refunded">
                        <span class="stat-label">Total Advance Refunded</span>
                        <span class="stat-value">₹ @GetTotalRefunded().ToString("N2")</span>
                    </div>
                    <div class="stat-card balance">
                        <span class="stat-label">Available Balance</span>
                        <span class="stat-value">₹ @GetAvailableBalance().ToString("N2")</span>
                    </div>
                </div>

                <!-- Deposit/Refund + Ledger -->
                <div class="content-split">

                    <!-- Left: Deposit / Refund Form -->
                    <div class="left-panel">
                        <!-- Tab Pills -->
                        <div class="tab-pills">
                            <button class="tab-pill @(advanceSubTab == "deposit" ? "active-deposit" : "")" @onclick='() => advanceSubTab = "deposit"'>
                                <i class="bi bi-plus-circle"></i> Deposit
                            </button>
                            <button class="tab-pill @(advanceSubTab == "refund" ? "active-refund" : "")" @onclick='() => advanceSubTab = "refund"'>
                                <i class="bi bi-dash-circle"></i> Refund
                            </button>
                        </div>

                        @if (advanceSubTab == "deposit")
                        {
                            <div class="form-panel">
                                <h3><i class="bi bi-plus-circle text-success"></i> Deposit New Advance</h3>
                                <div class="field-group">
                                    <label class="field-label">Amount (₹)</label>
                                    <input type="number" step="any" class="field-input" placeholder="Enter amount to deposit..." @bind="depositAmount" @bind:event="oninput" />
                                </div>
                                <div class="field-group">
                                    <label class="field-label">Pay Mode</label>
                                    <select class="field-input" @bind="depositPayMode">
                                        <option value="CASH">CASH</option>
                                        <option value="CARD">CARD</option>
                                        <option value="GPAY">GPAY</option>
                                        <option value="UPI">UPI</option>
                                    </select>
                                </div>
                                <div class="field-group">
                                    <label class="field-label">Remarks / Notes</label>
                                    <textarea class="field-input" style="height: 50px; resize: none;" placeholder="e.g. advance for IP or lab..." @bind="depositRemarks"></textarea>
                                </div>
                                <button class="btn-deposit-main" @onclick="DepositAdvance" disabled="@(depositAmount <= 0 || actionRunning)">
                                    @if (actionRunning)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    }
                                    Deposit Advance
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="form-panel">
                                <h3><i class="bi bi-dash-circle text-danger"></i> Refund Available Balance</h3>
                                <div class="field-group">
                                    <label class="field-label">Refund Amount (₹)</label>
                                    <input type="number" step="any" class="field-input" placeholder="Max: @GetAvailableBalance().ToString("N2")" @bind="refundAmount" @bind:event="oninput" />
                                </div>
                                <div class="field-group">
                                    <label class="field-label">Remarks / Notes</label>
                                    <textarea class="field-input" style="height: 85px; resize: none;" placeholder="e.g. patient requested refund..." @bind="refundRemarks"></textarea>
                                </div>
                                <button class="btn-refund-main" @onclick="RefundAdvance" disabled="@(refundAmount <= 0 || refundAmount > GetAvailableBalance() || actionRunning)">
                                    @if (actionRunning)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    }
                                    Refund Advance
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Right: Transaction Ledger -->
                    <div class="right-panel">
                        <div class="ledger-panel">
                            <div class="ledger-header">
                                <h3 class="ledger-title">
                                    <i class="bi bi-list-stars"></i> Transaction Ledger History
                                </h3>
                                <button class="btn-icon-sm" @onclick="FetchAdvanceSummaryHistory" disabled="@(advancePatientId == null)" title="Refresh">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                            <div style="overflow-x: auto; max-height: 360px; overflow-y: auto;">
                                <table class="ledger-table">
                                    <thead>
                                        <tr>
                                            <th>DATE</th>
                                            <th>RECEIPT / BILL NO</th>
                                            <th>CUSTOMER</th>
                                            <th>TYPE</th>
                                            <th style="text-align:right;">AMOUNT</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (loadingLedger)
                                        {
                                            <tr><td colspan="5" style="text-align:center; padding: 2rem;">
                                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                <span class="ms-2 text-muted" style="font-size:0.82rem;">Loading ledger...</span>
                                            </td></tr>
                                        }
                                        else if (advanceSummary.ledger == null || advanceSummary.ledger.Count == 0)
                                        {
                                            <tr><td colspan="5" style="text-align:center; padding: 2rem; color:#94a3b8; font-size:0.82rem;">No transactions recorded yet.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var row in advanceSummary.ledger)
                                            {
                                                var typeDisplay = GetTransactionType(row);
                                                resolvedCustomerNames.TryGetValue(row, out var patientName);
                                                <tr>
                                                    <td>@(row.receiptdate.HasValue ? FormatIstDateTime(row.receiptdate.Value) : "-")</td>
                                                    <td style="font-family: monospace; font-weight: 700;">@row.receiptsnoprint</td>
                                                    <td style="font-weight: 600;">@(patientName ?? advanceSummary.patient_name ?? "-")</td>
                                                    <td>
                                                        <span class="type-badge @(typeDisplay.ToLower())">@typeDisplay</span>
                                                    </td>
                                                    <td style="text-align:right; font-weight: 700; color: @(typeDisplay == "DEPOSIT" ? "#16a34a" : typeDisplay == "USED" ? "#1d4ed8" : "#dc2626");">
                                                        ₹ @row.receiptamount.ToString("N2")
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
        else
        {
            <div class="empty-state-card">
                <div class="empty-icon-box">
                    <i class="bi bi-piggy-bank"></i>
                </div>
                <h4 style="font-size: 1.2rem; font-weight: 800; color: #1e1b4b; margin: 0 0 0.5rem 0;">Patient Advance Management</h4>
                <p style="color: #64748b; font-size: 0.88rem; max-width: 460px; margin: 0 auto; line-height: 1.6;">Search for a patient using the search bar above to view their advance balance, deposit new advance, process refunds, and track ledger history.</p>
            </div>
        }
    </div>
</div>

@code {
    private bool loadingAdvance = false;
    private bool loadingLedger = false;
    private bool actionRunning = false;

    private decimal? advancePatientId;
    private string advanceSearchText = "";
    private string selectedPatientName = ""; // Store name from search since API may return null
    private bool showDepositRefund = false;
    private bool showTransactionHistory = false;
    private string advanceSubTab = "deposit";
    private int activePatientIndex = -1;

    // Autocomplete search state (matching Billing Portal)
    private string patientSearchQuery = string.Empty;
    private List<Booking.Models.CustomerWithOpModel> searchedPatients = new();
    private bool showPatientDropdown = false;

    // Branch & Counter (for the header dropdowns)
    private List<Booking.Models.BranchModel> branchesList = new();
    private List<CounterMasterModel> allCounters = new();
    private List<CounterMasterModel> filteredCountersList = new();

    private string selectedBranchCode = "";
    private string selectedCounterCode = "";

    private HmsPatientAdvanceSummary? advanceSummary;
    private Dictionary<HmsAdvanceLedgerRow, string> resolvedTransactionTypes = new();
    private Dictionary<HmsAdvanceLedgerRow, string> resolvedCustomerNames = new();

    private double depositAmount = 0;
    private string depositPayMode = "CASH";
    private string depositRemarks = string.Empty;
    private double refundAmount = 0;
    private string refundRemarks = string.Empty;

    private int UserCode => TenantState.UserCode != 0 ? TenantState.UserCode : 10;

    // Use selected branch/counter from header dropdowns, falling back to TenantState
    private int CounterCodeVal
    {
        get
        {
            if (int.TryParse(selectedCounterCode, out var sc) && sc > 0) return sc;
            if (TenantState.CounterCode.HasValue && TenantState.CounterCode.Value != 0) return TenantState.CounterCode.Value;
            return 1;
        }
    }

    private int BranchCodeVal
    {
        get
        {
            if (int.TryParse(selectedBranchCode, out var sb) && sb > 0) return sb;
            return 1;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBranchesAsync();
        await LoadCountersAsync();

        // Pre-select branch/counter from TenantState
        try
        {
            if (TenantState.CounterCode.HasValue && TenantState.CounterCode.Value > 0)
            {
                selectedCounterCode = TenantState.CounterCode.Value.ToString();
            }
        }
        catch { }
    }

    private HttpClient CreateClient(bool isLabCare = false)
    {
        var clientName = isLabCare ? "LabCareUrl" : "DoctorApi";
        var client = ClientFactory.CreateClient(clientName);
        if (!string.IsNullOrEmpty(TenantState.TenantCode))
        {
            client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
        }
        if (!string.IsNullOrEmpty(TenantState.AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
        }
        return client;
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }
            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var all = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branchesList = all.Where(b => !b.deleted).ToList();

                // Filter by user allowed branches
                try
                {
                    var isTenantAdmin = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
                    if (isTenantAdmin.Success && isTenantAdmin.Value) { /* see all */ }
                    else
                    {
                        var branchCodes = await _sessionStorage.GetAsync<List<int>>("UserBranchCodes");
                        if (branchCodes.Success && branchCodes.Value != null && branchCodes.Value.Any())
                        {
                            var allowed = branchCodes.Value.ToHashSet();
                            var filtered = branchesList.Where(b => allowed.Contains(b.bh_code)).ToList();
                            if (filtered.Any()) branchesList = filtered;
                        }
                    }
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }

    private async Task LoadCountersAsync()
    {
        try
        {
            var res = await CounterService.GetCountersAsync();
            if (res != null)
            {
                allCounters = res.OrderBy(c => c.orderno).ToList();
                ApplyCounterFilter();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading counters: {ex.Message}");
        }
    }



    private void ApplyCounterFilter()
    {
        if (int.TryParse(selectedBranchCode, out var bCode) && bCode > 0)
        {
            filteredCountersList = allCounters.Where(c => c.bhcode == bCode && !c.deleted).ToList();
        }
        else
        {
            filteredCountersList = allCounters.Where(c => !c.deleted).ToList();
        }
    }

    private void OnHeaderBranchChanged()
    {
        ApplyCounterFilter();
        // Clear counter selection if the counter is no longer in the filtered list
        if (!string.IsNullOrEmpty(selectedCounterCode) &&
            !filteredCountersList.Any(c => c.cntcode.ToString() == selectedCounterCode))
        {
            selectedCounterCode = "";
        }
        StateHasChanged();
    }

    // Patient autocomplete search
    private System.Threading.CancellationTokenSource? _patientSearchCts;

    private async Task OnPatientSearchInput(ChangeEventArgs e)
    {
        patientSearchQuery = e.Value?.ToString() ?? "";
        activePatientIndex = -1;

        _patientSearchCts?.Cancel();
        _patientSearchCts = new System.Threading.CancellationTokenSource();
        var token = _patientSearchCts.Token;

        if (string.IsNullOrWhiteSpace(patientSearchQuery))
        {
            searchedPatients.Clear();
            showPatientDropdown = false;
            activePatientIndex = -1;
            StateHasChanged();
            return;
        }

        try
        {
            await Task.Delay(250, token);

            using var client = CreateClient(true); // LabCareUrl matching Billing portal
            var response = await client.GetAsync($"api/Customer/search?key={Uri.EscapeDataString(patientSearchQuery)}", token);

            if (token.IsCancellationRequested) return;

            if (!response.IsSuccessStatusCode)
            {
                response = await client.GetAsync($"api/OpRegistration/customers-with-op?key={Uri.EscapeDataString(patientSearchQuery)}", token);
            }

            if (token.IsCancellationRequested) return;

            if (response.IsSuccessStatusCode)
            {
                var rawJson = await response.Content.ReadAsStringAsync(token);
                if (token.IsCancellationRequested) return;

                var settings = new Newtonsoft.Json.JsonSerializerSettings 
                { 
                    NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore 
                };
                
                List<Booking.Models.CustomerWithOpModel> list = new();
                try
                {
                    var jToken = Newtonsoft.Json.Linq.JToken.Parse(rawJson);
                    if (jToken is Newtonsoft.Json.Linq.JObject obj && obj["value"] != null)
                    {
                        list = obj["value"].ToObject<List<Booking.Models.CustomerWithOpModel>>(Newtonsoft.Json.JsonSerializer.Create(settings)) ?? new();
                    }
                    else
                    {
                        list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.CustomerWithOpModel>>(rawJson, settings) ?? new();
                    }
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Error parsing search results JSON: {ex.Message}");
                }

                var currentSetting = await LabSettingService.GetLabSettingAsync();
                bool showAll = currentSetting?.show_all_customers ?? true;
                if (!showAll)
                {
                    list = list.Where(p => string.IsNullOrEmpty(p.tenant_code) || string.Equals(p.tenant_code, TenantState.TenantCode, StringComparison.OrdinalIgnoreCase)).ToList();
                }

                var lowerQuery = patientSearchQuery.Trim().ToLower();
                var filtered = list.Where(p => 
                    (!string.IsNullOrEmpty(p.name) && p.name.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(p.namewithinitials) && p.namewithinitials.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(p.mobile) && p.mobile.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(p.phone) && p.phone.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase)) ||
                    p.custid.ToString().Contains(lowerQuery)
                ).ToList();

                searchedPatients = filtered.Any() ? filtered.Take(12).ToList() : list.Take(12).ToList();
                showPatientDropdown = searchedPatients.Count > 0;
                activePatientIndex = -1;
            }
            else
            {
                searchedPatients.Clear();
                showPatientDropdown = false;
                activePatientIndex = -1;
            }
        }
        catch (OperationCanceledException)
        {
            // Cancelled due to newer user input
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error searching patients: {ex.Message}");
            searchedPatients.Clear();
            showPatientDropdown = false;
            activePatientIndex = -1;
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void OnPatientSearchKeyDown(KeyboardEventArgs e)
    {
        if (!showPatientDropdown || searchedPatients.Count == 0) return;

        if (e.Key == "ArrowDown")
        {
            if (activePatientIndex < searchedPatients.Count - 1)
            {
                activePatientIndex++;
            }
            else
            {
                activePatientIndex = 0;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            if (activePatientIndex > 0)
            {
                activePatientIndex--;
            }
            else
            {
                activePatientIndex = searchedPatients.Count - 1;
            }
        }
        else if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            if (activePatientIndex >= 0 && activePatientIndex < searchedPatients.Count)
            {
                _ = SelectCustomerPatient(searchedPatients[activePatientIndex]);
                activePatientIndex = -1;
            }
        }
        else if (e.Key == "Escape")
        {
            showPatientDropdown = false;
            activePatientIndex = -1;
        }
    }

    private async Task OnPatientSearchKeyUp(KeyboardEventArgs e)
    {
        // Retained for backward compatibility
    }

    private async Task SelectCustomerPatient(Booking.Models.CustomerWithOpModel pat)
    {
        var displayName = !string.IsNullOrWhiteSpace(pat.namewithinitials) 
            ? pat.namewithinitials 
            : (!string.IsNullOrWhiteSpace(pat.name) ? pat.name : $"Customer {pat.custid}");

        patientSearchQuery = $"{displayName} (CUST-{pat.custid})";
        selectedPatientName = displayName;
        advancePatientId = pat.custid;
        showPatientDropdown = false;
        searchedPatients.Clear();
        activePatientIndex = -1;
        showDepositRefund = true;
        showTransactionHistory = true;
        StateHasChanged();
        await LoadPatientAdvance();
    }

    private async Task SearchPatientAdvance()
    {
        if (string.IsNullOrWhiteSpace(advanceSearchText))
        {
            ToastService.ShowError("Please enter a Patient ID or Name to search.");
            return;
        }

        if (decimal.TryParse(advanceSearchText.Trim(), out var parsedId))
        {
            advancePatientId = parsedId;
        }
        else
        {
            advancePatientId = null;
            loadingAdvance = true;
            StateHasChanged();
            try
            {
                var billsRes = await DueCollectionService.GetDueBillsResponseAsync(new HmsAllDueFilterRequest
                {
                    search = advanceSearchText.Trim(),
                    page = 1,
                    pagesize = 100
                });

                var billMatch = billsRes?.data?.FirstOrDefault(r => 
                    r.custid.HasValue && 
                    (r.patient_name != null && r.patient_name.Contains(advanceSearchText.Trim(), StringComparison.OrdinalIgnoreCase)));

                if (billMatch == null && billsRes?.data != null)
                {
                    billMatch = billsRes.data.FirstOrDefault(r => r.custid.HasValue);
                }

                if (billMatch != null)
                {
                    advancePatientId = billMatch.custid;
                }
                else
                {
                    var paidRes = await DueCollectionService.GetPaidHistoryAsync(new HmsPaidHistoryFilterRequest
                    {
                        search = advanceSearchText.Trim(),
                        page = 1,
                        pagesize = 50
                    });
                    var paidMatch = paidRes?.data?.FirstOrDefault(r => 
                        r.custid.HasValue && 
                        (r.patient_name != null && r.patient_name.Contains(advanceSearchText.Trim(), StringComparison.OrdinalIgnoreCase)));

                    if (paidMatch == null && paidRes?.data != null)
                    {
                        paidMatch = paidRes.data.FirstOrDefault(r => r.custid.HasValue);
                    }

                    if (paidMatch?.custid != null)
                    {
                        advancePatientId = (decimal)paidMatch.custid.Value;
                    }
                }

                if (advancePatientId == null)
                {
                    ToastService.ShowError($"No patient found matching '{advanceSearchText}'.");
                    loadingAdvance = false;
                    StateHasChanged();
                    return;
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Search failed: {ex.Message}");
                loadingAdvance = false;
                StateHasChanged();
                return;
            }
        }

        showDepositRefund = true;
        showTransactionHistory = true;
        await LoadPatientAdvance();
    }

    private async Task FetchAdvanceSummaryHistory()
    {
        if (advancePatientId == null)
        {
            ToastService.ShowError("Please search for a patient first.");
            return;
        }
        showDepositRefund = true;
        showTransactionHistory = true;

        if (advanceSummary != null)
        {
            await LoadLedgerOnly();
        }
        else
        {
            await LoadPatientAdvance();
        }
    }

    private async Task LoadLedgerOnly()
    {
        if (advancePatientId == null || advanceSummary == null) return;

        try
        {
            var freshSummary = await DueCollectionService.GetPatientAdvanceSummaryAsync(advancePatientId.Value);
            if (freshSummary != null)
            {
                advanceSummary = freshSummary;
            }
        }
        catch { }

        if (advanceSummary.ledger == null || advanceSummary.ledger.Count == 0)
        {
            StateHasChanged();
            return;
        }

        resolvedTransactionTypes.Clear();
        resolvedCustomerNames.Clear();

        loadingLedger = true;
        StateHasChanged();

        try
        {
            foreach (var row in advanceSummary.ledger)
            {
                var rawType = (row.transaction_type ?? "USED").ToUpperInvariant();
                if (rawType == "DEPOSIT")
                {
                    resolvedTransactionTypes[row] = "DEPOSIT";
                    resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                }
                else if (rawType == "USED")
                {
                    resolvedTransactionTypes[row] = "USED";
                    resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                }
                else
                {
                    bool isRefund = rawType == "REFUND" || rawType == "REFUNDED";
                    resolvedTransactionTypes[row] = isRefund ? "REFUNDED" : rawType;
                    resolvedCustomerNames[row] = advanceSummary.patient_name ?? "";
                }
            }
        }
        finally
        {
            loadingLedger = false;
            StateHasChanged();
        }
    }

    private async Task LoadPatientAdvance()
    {
        if (advancePatientId == null) return;

        loadingAdvance = true;
        StateHasChanged();
        try
        {
            advanceSummary = await DueCollectionService.GetPatientAdvanceSummaryAsync(advancePatientId.Value);
            if (advanceSummary == null)
            {
                ToastService.ShowError("No patient record or advance summary found for the given Patient ID.");
                loadingAdvance = false;
                StateHasChanged();
                return;
            }

            // If API doesn't return patient_name, fallback to the name stored from search
            if (string.IsNullOrWhiteSpace(advanceSummary.patient_name) && !string.IsNullOrEmpty(selectedPatientName))
            {
                advanceSummary.patient_name = selectedPatientName;
            }

            resolvedTransactionTypes.Clear();
            resolvedCustomerNames.Clear();

            loadingAdvance = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load advance summary: {ex.Message}");
            loadingAdvance = false;
            StateHasChanged();
        }
    }

    private async Task DepositAdvance()
    {
        if (advanceSummary == null || depositAmount <= 0) return;
        actionRunning = true;
        StateHasChanged();

        try
        {
            var req = new HmsAdvanceDepositRequest
            {
                custid = advanceSummary.custid,
                patient_name = advanceSummary.patient_name,
                amount = depositAmount,
                collection_type = depositPayMode,
                remarks = depositRemarks,
                usercode = UserCode,
                cntcode = CounterCodeVal,
                enteredbhcode = BranchCodeVal
            };

            var payloadJson = System.Text.Json.JsonSerializer.Serialize(req, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            Console.WriteLine("\n==================================================");
            Console.WriteLine("[PATIENT ADVANCE DEPOSIT PAYLOAD SUBMITTED]");
            Console.WriteLine(payloadJson);
            Console.WriteLine("==================================================\n");

            var res = await DueCollectionService.DepositAdvanceAsync(req);
            if (res != null)
            {
                ToastService.ShowSuccess($"Deposited ₹ {depositAmount:N2} advance successfully.");
                depositAmount = 0;
                depositRemarks = string.Empty;
                await LoadPatientAdvance();
            }
            else
            {
                ToastService.ShowError("Failed to deposit advance.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            actionRunning = false;
            StateHasChanged();
        }
    }

