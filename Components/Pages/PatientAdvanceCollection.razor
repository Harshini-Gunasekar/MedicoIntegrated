        }
    }

    private string GetTransactionType(HmsAdvanceLedgerRow row)
    {
        if (resolvedTransactionTypes.TryGetValue(row, out var resolvedType))
        {
            return resolvedType;
        }

        var rawType = (row.transaction_type ?? "").ToUpper().Trim();

        // The API returns transaction_type="USED" for BOTH billing-use and refunds.
        // The key difference: refund rows have a non-null requestguid,
        // while actual billing-use rows have requestguid = null.
        if (rawType == "USED" && !string.IsNullOrEmpty(row.requestguid))
        {
            return "REFUNDED";
        }

        return rawType switch
        {
            "DEPOSIT"  => "DEPOSIT",
            "REFUND"   => "REFUNDED",
            "REFUNDED" => "REFUNDED",
            "USED"     => "USED",
            "USE"      => "USED",
            _          => string.IsNullOrEmpty(rawType) ? "DEPOSIT" : rawType
        };
    }
