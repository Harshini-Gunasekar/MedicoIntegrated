@code {
    // Search mode: "ALL" vs "IP"
    private string patientSearchMode = "ALL";
    private List<IPRegistrationModel.IpRegistrationModel> allIpAdmissions = new();
    private List<IPRegistrationModel.IpRegistrationModel> searchedIpPatients = new();
    private bool showIpPatientDropdown = false;

    // All advance deposited patients list
    private List<HmsAdvancePatientItem> allAdvancePatients = new();
    private bool loadingAllAdvances = false;
    private string advanceFilterQuery = "";
    private List<HmsAdvancePatientItem> filteredAdvanceList
    {
        get
        {
            if (string.IsNullOrWhiteSpace(advanceFilterQuery))
                return allAdvancePatients;
            var q = advanceFilterQuery.Trim().ToLowerInvariant();
            return allAdvancePatients.Where(p =>
                (!string.IsNullOrWhiteSpace(p.patient_name) && p.patient_name.ToLowerInvariant().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(p.mobile) && p.mobile.Contains(q)) ||
                (!string.IsNullOrWhiteSpace(p.city) && p.city.ToLowerInvariant().Contains(q)) ||
                p.custid.ToString().Contains(q)
            ).ToList();
        }
    }
    // Cancel Advance state
    private bool showCancelModal = false;
    private HmsAdvanceLedgerRow? cancellingRow = null;
    private string cancelReason = "";
    private bool isCancellingAdvance = false;

    private void PromptCancelAdvance(HmsAdvanceLedgerRow row)
    {
        cancellingRow = row;
        cancelReason = "";
        showCancelModal = true;
        StateHasChanged();
    }

    private void CloseCancelModal()
    {
        cancellingRow = null;
        cancelReason = "";
        showCancelModal = false;
        StateHasChanged();
    }

    private async Task ConfirmCancelAdvanceAsync()
    {
        if (cancellingRow == null || string.IsNullOrWhiteSpace(cancellingRow.receiptguid))
        {
            ToastService.ShowWarning("No receipt selected to cancel.");
            return;
        }

        if (string.IsNullOrWhiteSpace(cancelReason))
        {
            ToastService.ShowWarning("Please provide a reason for cancellation.");
            return;
        }

        isCancellingAdvance = true;
        StateHasChanged();

        try
        {
            var req = new HmsAdvanceCancelRequest
            {
                receiptguid = cancellingRow.receiptguid,
                usercode = UserCode,
                reason = cancelReason.Trim()
            };

            var (success, message, data) = await DueCollectionService.CancelAdvanceAsync(req);
            if (success)
            {
                ToastService.ShowSuccess(message);
                CloseCancelModal();
                await LoadPatientAdvance();
                _ = LoadAllAdvancePatientsAsync();
            }
            else
            {
                ToastService.ShowError(message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Cancel failed: {ex.Message}");
        }
        finally
        {
            isCancellingAdvance = false;
            StateHasChanged();
        }
    }

    private bool loadingAdvance = false;
    private bool loadingLedger = false;
    private bool actionRunning = false;

    private decimal? advancePatientId;
    private string advanceSearchText = "";
    private string selectedPatientName = ""; // Store name from search since API may return null
    private bool showDepositRefund = false;
    private bool showTransactionHistory = false;
    private string advanceSubTab = "deposit";
    private int activePatientIndex = -1;

    // Autocomplete search state (matching Billing Portal)
    private string patientSearchQuery = string.Empty;
    private List<Booking.Models.CustomerWithOpModel> searchedPatients = new();
    private bool showPatientDropdown = false;

    // Branch & Counter (for the header dropdowns)
    private List<Booking.Models.BranchModel> branchesList = new();
    private List<CounterMasterModel> allCounters = new();
    private List<CounterMasterModel> filteredCountersList = new();

    private string selectedBranchCode = "";
    private string selectedCounterCode = "";

    private HmsPatientAdvanceSummary? advanceSummary;
    private Dictionary<HmsAdvanceLedgerRow, string> resolvedTransactionTypes = new();
    private Dictionary<HmsAdvanceLedgerRow, string> resolvedCustomerNames = new();

    private double depositAmount = 0;
    private string depositAmountText = "";
    private string depositPayMode = "CASH";
    private string depositRemarks = string.Empty;
    private double refundAmount = 0;
    private string refundAmountText = "";

    private void OnDepositAmountInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        depositAmountText = raw;
        if (!string.IsNullOrWhiteSpace(raw) && double.TryParse(raw.Trim(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double val))
        {
            depositAmount = Math.Max(0, val);
        }
        else
        {
            depositAmount = 0;
        }
    }

    private void OnRefundAmountInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        refundAmountText = raw;
        if (!string.IsNullOrWhiteSpace(raw) && double.TryParse(raw.Trim(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double val))
        {
            refundAmount = Math.Max(0, val);
        }
        else
        {
            refundAmount = 0;
        }
    }
    private string refundRemarks = string.Empty;

    private int UserCode => TenantState.UserCode != 0 ? TenantState.UserCode : 10;

    // Use selected branch/counter from header dropdowns, falling back to TenantState
    private int CounterCodeVal
    {
        get
        {
            if (int.TryParse(selectedCounterCode, out var sc) && sc > 0) return sc;
            if (TenantState.CounterCode.HasValue && TenantState.CounterCode.Value != 0) return TenantState.CounterCode.Value;
            return 1;
        }
    }

    private int BranchCodeVal
    {
        get
        {
            if (int.TryParse(selectedBranchCode, out var sb) && sb > 0) return sb;
            return 1;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        selectedPageFormat = "A4";
        await LoadBranchesAsync();
        await LoadCountersAsync();
        _ = LoadAllAdvancePatientsAsync();
        _ = LoadActiveIpAdmissionsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeBranchAndCounterDefaultsAsync();
            await LoadBranchesAsync();
            await LoadCountersAsync();

            if (string.IsNullOrEmpty(selectedBranchCode) && branchesList.Any())
            {
                selectedBranchCode = branchesList.First().bh_code.ToString();
            }

            ApplyCounterFilter();
            StateHasChanged();
        }
    }

    private async Task InitializeBranchAndCounterDefaultsAsync()
    {
        try
        {
            // 1. Try session storage "bhcode"
            string? savedBh = null;
            try
            {
                var bhCodeResult = await _sessionStorage.GetAsync<string>("bhcode");
                if (bhCodeResult.Success && !string.IsNullOrEmpty(bhCodeResult.Value) && bhCodeResult.Value != "0")
                {
                    savedBh = bhCodeResult.Value;
                }
                else
                {
                    var bhIntResult = await _sessionStorage.GetAsync<int>("bhcode");
                    if (bhIntResult.Success && bhIntResult.Value > 0)
                    {
                        savedBh = bhIntResult.Value.ToString();
                    }
                }
            }
            catch { }

            // 2. Try TenantState.BranchCode or TenantState.UserData.BranchCode
            if (string.IsNullOrEmpty(savedBh))
            {
                if (TenantState.BranchCode.HasValue && TenantState.BranchCode.Value > 0)
                {
                    savedBh = TenantState.BranchCode.Value.ToString();
                }
                else if (TenantState.UserData?.BranchCode.HasValue == true && TenantState.UserData.BranchCode.Value > 0)
                {
                    savedBh = TenantState.UserData.BranchCode.Value.ToString();
                }
            }

            // 3. Try UserDetails from session storage
            if (string.IsNullOrEmpty(savedBh))
            {
                try
                {
                    var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userDetailsResult.Success && userDetailsResult.Value?.BranchCode != null && userDetailsResult.Value.BranchCode > 0)
                    {
                        savedBh = userDetailsResult.Value.BranchCode.Value.ToString();
                    }
                }
                catch { }
            }

            if (!string.IsNullOrEmpty(savedBh))
            {
                selectedBranchCode = savedBh;
            }

            // --- COUNTER DEFAULT ---
            string? savedCnt = null;
            try
            {
                var cntCodeResult = await _sessionStorage.GetAsync<string>("cntcode");
                if (cntCodeResult.Success && !string.IsNullOrEmpty(cntCodeResult.Value) && cntCodeResult.Value != "0")
                {
                    savedCnt = cntCodeResult.Value;
                }
                else
                {
                    var cntIntResult = await _sessionStorage.GetAsync<int>("cntcode");
                    if (cntIntResult.Success && cntIntResult.Value > 0)
                    {
                        savedCnt = cntIntResult.Value.ToString();
                    }
                }
            }
            catch { }

            if (string.IsNullOrEmpty(savedCnt))
            {
                if (TenantState.CounterCode.HasValue && TenantState.CounterCode.Value > 0)
                {
                    savedCnt = TenantState.CounterCode.Value.ToString();
                }
            }

            if (!string.IsNullOrEmpty(savedCnt))
            {
                selectedCounterCode = savedCnt;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing branch and counter defaults: {ex.Message}");
        }
    }

    private HttpClient CreateClient(bool isLabCare = false)
    {
        var clientName = isLabCare ? "LabCareUrl" : "DoctorApi";
        var client = ClientFactory.CreateClient(clientName);
        if (!string.IsNullOrEmpty(TenantState.TenantCode))
        {
            client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
        }
        if (!string.IsNullOrEmpty(TenantState.AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
        }
        return client;
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }
            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var all = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branchesList = all.Where(b => !b.deleted).ToList();

                // Filter by user allowed branches
                try
                {
                    var isTenantAdmin = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
                    if (isTenantAdmin.Success && isTenantAdmin.Value) { /* see all */ }
                    else
                    {
                        var branchCodes = await _sessionStorage.GetAsync<List<int>>("UserBranchCodes");
                        if (branchCodes.Success && branchCodes.Value != null && branchCodes.Value.Any())
                        {
                            var allowed = branchCodes.Value.ToHashSet();
                            var filtered = branchesList.Where(b => allowed.Contains(b.bh_code)).ToList();
                            if (filtered.Any()) branchesList = filtered;
                        }
                    }
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }

    private async Task LoadCountersAsync()
    {
        try
        {
            var res = await CounterService.GetCountersAsync();
            if (res != null)
            {
                allCounters = res.OrderBy(c => c.orderno).ToList();
                ApplyCounterFilter();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading counters: {ex.Message}");
        }
    }



    private void ApplyCounterFilter()
    {
        if (int.TryParse(selectedBranchCode, out var bCode) && bCode > 0)
        {
            filteredCountersList = allCounters.Where(c => c.bhcode == bCode && !c.deleted).ToList();
        }
        else
        {
            filteredCountersList = allCounters.Where(c => !c.deleted).ToList();
        }
    }

    private void OnHeaderBranchChanged()
    {
        ApplyCounterFilter();
        // Clear counter selection if the counter is no longer in the filtered list
        if (!string.IsNullOrEmpty(selectedCounterCode) &&
            !filteredCountersList.Any(c => c.cntcode.ToString() == selectedCounterCode))
        {
            selectedCounterCode = "";
        }
        StateHasChanged();
    }

    // Patient autocomplete search
    private System.Threading.CancellationTokenSource? _patientSearchCts;
    private Booking.Models.LabSettingModel? cachedLabSetting;

    private async Task OnPatientSearchInput(ChangeEventArgs e)
    {
        patientSearchQuery = e.Value?.ToString() ?? "";
        activePatientIndex = -1;

        _patientSearchCts?.Cancel();
        _patientSearchCts = new System.Threading.CancellationTokenSource();
        var token = _patientSearchCts.Token;

        if (patientSearchMode == "IP")
        {
            if (allIpAdmissions == null || allIpAdmissions.Count == 0)
            {
                await LoadActiveIpAdmissionsAsync();
            }
            FilterIpPatients();
            StateHasChanged();
            return;
        }
        if (string.IsNullOrWhiteSpace(patientSearchQuery))
        {
            searchedPatients.Clear();
            showPatientDropdown = false;
            activePatientIndex = -1;
            StateHasChanged();
            return;
        }

        try
        {
            await Task.Delay(280, token);

            using var client = CreateClient(true); // LabCareUrl matching Billing portal
            var response = await client.GetAsync($"api/Customer/search?key={Uri.EscapeDataString(patientSearchQuery)}", token);

            if (token.IsCancellationRequested) return;

            if (!response.IsSuccessStatusCode)
            {
                response = await client.GetAsync($"api/OpRegistration/customers-with-op?key={Uri.EscapeDataString(patientSearchQuery)}", token);
            }

            if (token.IsCancellationRequested) return;

            if (response.IsSuccessStatusCode)
            {
                var rawJson = await response.Content.ReadAsStringAsync(token);
                if (token.IsCancellationRequested) return;

                var settings = new Newtonsoft.Json.JsonSerializerSettings 
                { 
                    NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore 
                };
                
                List<Booking.Models.CustomerWithOpModel> list = new();
                try
                {
                    var jToken = Newtonsoft.Json.Linq.JToken.Parse(rawJson);
                    if (jToken is Newtonsoft.Json.Linq.JObject obj && obj["value"] != null)
                    {
                        list = obj["value"].ToObject<List<Booking.Models.CustomerWithOpModel>>(Newtonsoft.Json.JsonSerializer.Create(settings)) ?? new();
                    }
                    else
                    {
                        list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.CustomerWithOpModel>>(rawJson, settings) ?? new();
                    }
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Error parsing search results JSON: {ex.Message}");
                }

                if (cachedLabSetting == null)
                {
                    cachedLabSetting = await LabSettingService.GetLabSettingAsync();
                }
                var currentSetting = cachedLabSetting;
                bool showAll = currentSetting?.show_all_customers ?? true;
                if (!showAll)
                {
                    var effectiveTenant = TenantState?.TenantCode ?? "";
                    list = list.Where(p => !string.IsNullOrEmpty(p.tenant_code) && string.Equals(p.tenant_code, effectiveTenant, StringComparison.OrdinalIgnoreCase)).ToList();
                    if (!list.Any())
                    {
                        try
                        {
                            var getcusResp = await client.GetAsync("api/customer/getcus", token);
                            if (getcusResp.IsSuccessStatusCode)
                            {
                                var cusJson = await getcusResp.Content.ReadAsStringAsync(token);
                                var cusList = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.CustomerWithOpModel>>(cusJson, settings) ?? new();
                                var lower = patientSearchQuery.Trim().ToLowerInvariant();
                                list = cusList.Where(p => 
                                    (!string.IsNullOrEmpty(p.name) && p.name.ToLowerInvariant().Contains(lower)) ||
                                    (!string.IsNullOrEmpty(p.mobile) && p.mobile.Contains(lower)) ||
                                    (p.custid.ToString().Contains(lower))
                                ).ToList();
                            }
                        }
                        catch { }
                    }
                }

                var lowerQuery = patientSearchQuery.Trim().ToLower();
                var filtered = list.Where(p => 
                    (!string.IsNullOrEmpty(p.name) && p.name.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(p.namewithinitials) && p.namewithinitials.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(p.mobile) && p.mobile.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(p.phone) && p.phone.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase)) ||
                    p.custid.ToString().Contains(lowerQuery)
                ).ToList();

                searchedPatients = filtered.Any() ? filtered.Take(12).ToList() : list.Take(12).ToList();
                showPatientDropdown = searchedPatients.Count > 0;
                activePatientIndex = -1;
            }
            else
            {
                searchedPatients.Clear();
                showPatientDropdown = false;
                activePatientIndex = -1;
            }
        }
        catch (OperationCanceledException)
        {
            // Cancelled due to newer user input
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error searching patients: {ex.Message}");
            searchedPatients.Clear();
            showPatientDropdown = false;
            activePatientIndex = -1;
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void OnPatientSearchKeyDown(KeyboardEventArgs e)
    {
        if (patientSearchMode == "IP")
        {
            if (!showIpPatientDropdown || searchedIpPatients.Count == 0) return;

            if (e.Key == "ArrowDown")
            {
                if (activePatientIndex < searchedIpPatients.Count - 1) activePatientIndex++;
                else activePatientIndex = 0;
            }
            else if (e.Key == "ArrowUp")
            {
                if (activePatientIndex > 0) activePatientIndex--;
                else activePatientIndex = searchedIpPatients.Count - 1;
            }
            else if (e.Key == "Enter" || e.Key == "NumpadEnter")
            {
                if (activePatientIndex >= 0 && activePatientIndex < searchedIpPatients.Count)
                {
                    _ = SelectIpPatient(searchedIpPatients[activePatientIndex]);
                    activePatientIndex = -1;
                }
            }
            else if (e.Key == "Escape")
            {
                showIpPatientDropdown = false;
                activePatientIndex = -1;
            }
            return;
        }

        if (!showPatientDropdown || searchedPatients.Count == 0) return;

        if (e.Key == "ArrowDown")
        {
            if (activePatientIndex < searchedPatients.Count - 1)
            {
                activePatientIndex++;
            }
            else
            {
                activePatientIndex = 0;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            if (activePatientIndex > 0)
            {
                activePatientIndex--;
            }
            else
            {
                activePatientIndex = searchedPatients.Count - 1;
            }
        }
        else if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            if (activePatientIndex >= 0 && activePatientIndex < searchedPatients.Count)
            {
                _ = SelectCustomerPatient(searchedPatients[activePatientIndex]);
                activePatientIndex = -1;
            }
        }
        else if (e.Key == "Escape")
        {
            showPatientDropdown = false;
            activePatientIndex = -1;
        }
    }

    private async Task OnPatientSearchKeyUp(KeyboardEventArgs e)
