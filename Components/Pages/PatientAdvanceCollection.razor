        if (string.IsNullOrWhiteSpace(modalDepositSearchQuery))
        {
            searchedModalDepositIpPatients = allIpAdmissions.Take(25).ToList();
            showModalDepositDropdown = searchedModalDepositIpPatients.Any();
            return;
