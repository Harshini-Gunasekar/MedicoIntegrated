    private void FilterIpPatients()
    {
        if (allIpAdmissions == null || allIpAdmissions.Count == 0)
        {
            searchedIpPatients.Clear();
            showIpPatientDropdown = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(patientSearchQuery))
        {
            searchedIpPatients = allIpAdmissions.Take(15).ToList();
        }
        else
        {
            var q = patientSearchQuery.Trim().ToLowerInvariant();
            searchedIpPatients = allIpAdmissions.Where(ip =>
                (!string.IsNullOrWhiteSpace(ip.GetPatientName()) && ip.GetPatientName().ToLowerInvariant().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(ip.patient_name) && ip.patient_name.ToLowerInvariant().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(ip.name) && ip.name.ToLowerInvariant().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(ip.ip_no) && ip.ip_no.ToLowerInvariant().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(ip.mobile) && ip.mobile.Contains(q)) ||
                ip.custid.ToString().Contains(q)
            ).Take(15).ToList();
        }

        showIpPatientDropdown = searchedIpPatients.Count > 0;
        showPatientDropdown = false;
    }

