@page "/edit-profile"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using SharedComponents.Rcl.Models
@using SharedComponents.Rcl.Services
@layout SharedComponents.Rcl.Components.Layout.EmptyLayout
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService

<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet" />

<style>
    body {
        background: @(IsDarkMode ? "radial-gradient(circle at 50% 50%, #151030 0%, #07070d 70%, #030305 100%)" : "linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%)") !important;
        background-attachment: fixed !important;
        background-color: @(IsDarkMode ? "#07070b" : "#f8fafc") !important;
        margin: 0 !important;
        padding: 0 !important;
    }
</style>

<section class="register-container edit-profile-section @(IsDarkMode ? "" : "light-theme")">
    <div class="register-card shadow-lg border border-opacity-20">
        
        <!-- Header -->
        <div class="card-header">
            <div class="header-main-row" style="display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
                <div>
                    <h2 class="page-title text-glow">Manage Member Profile</h2>
                    <p class="page-subtitle">Verify your identity via OTP and update your professional information.</p>
                </div>
                
                <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                    <!-- Premium Theme Selector Button -->
                    <button type="button" class="theme-toggle-btn" @onclick="ToggleTheme" title="Toggle Light/Dark Theme">
                        <span class="material-icons-outlined">@(IsDarkMode ? "light_mode" : "dark_mode")</span>
                        <span>@(IsDarkMode ? "Light Mode" : "Dark Mode")</span>
                    </button>

                    <!-- Back Button -->
                    <button type="button" class="theme-toggle-btn" @onclick="GoBack" title="Back to Registration">
                        <span class="material-icons-outlined">arrow_back</span>
                        <span>Back</span>
                    </button>
                </div>
            </div>
            
            <!-- Step Indicators -->
            <div class="step-indicator-wrapper" style="display: flex; gap: 1rem; margin-top: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.75rem;">
                <div class="step-badge @(Step == 1 ? "active" : "")">1. Verification</div>
                <div class="step-badge @(Step == 2 ? "active" : "")">2. OTP Security</div>
                <div class="step-badge @(Step == 3 ? "active" : "")">3. Edit Profile</div>
            </div>
        </div>

        <!-- Step 1: Member Verification -->
        @if (Step == 1)
        {
            <div class="card-body">
                <div class="registration-column" style="max-width: 550px; margin: 0 auto; padding: 1.5rem 0;">
                    <div class="section-title">
                        <span class="material-icons-outlined">fingerprint</span>
                        <h3>Lookup Profile</h3>
                    </div>
                    
                    <p class="section-desc" style="color: var(--text-muted); margin-bottom: 1.5rem;">
                        Enter your registered Mobile Number, Email Address, or Full Name to search your existing profile.
                    </p>

                    <div class="form-group full-width" style="margin-bottom: 1.5rem;">
                        <label class="form-label lbl-req">Registered Identifier</label>
                        <div class="input-icon-wrapper">
                            <span class="material-icons-outlined input-icon-left">contact_mail</span>
                            <input type="text" 
                                   @bind="Identifier" 
                                   class="form-control" 
                                   placeholder="e.g. Shankar, shankar@example.com, or 9876543210" 
                                   @onkeyup="HandleLookupKey" />
                        </div>
                    </div>

                    <!-- Premium Cyberpunk Error Card -->
                    @if (MemberNotFound)
                    {
                        <div class="error-glow-card" style="margin: 1.5rem 0; padding: 1.5rem; background: rgba(239, 68, 68, 0.08); border: 1px dashed rgba(239, 68, 68, 0.4); border-radius: 12px; box-shadow: 0 0 15px rgba(239, 68, 68, 0.1);">
                            <div style="display: flex; gap: 1rem; align-items: flex-start;">
                                <span class="material-icons-outlined" style="color: #ef4444; font-size: 2rem;">warning</span>
                                <div>
                                    <h4 style="color: #ef4444; font-weight: 600; margin: 0 0 0.5rem 0; font-size: 1.1rem;">No Profile Matching Your Lookup Was Found</h4>
                                    <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0 0 1rem 0; line-height: 1.5;">
                                        We searched for <strong>"@Identifier"</strong> but could not find an active user profile. Would you like to create a new registration instead?
                                    </p>
                                    <button type="button" class="btn btn-primary" style="background: linear-gradient(135deg, #ef4444, #b91c1c); border: none;" @onclick="GoToRegister">
                                        <span>Register New Laboratory</span>
                                        <span class="material-icons-outlined">app_registration</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem;">
                        <button type="button" class="btn btn-primary" disabled="@IsLoading" @onclick="VerifyIdentity">
                            @(IsLoading ? "Verifying..." : "Verify Profile")
                            @if (!IsLoading) { <span class="material-icons-outlined">search</span> }
                        </button>
                    </div>
                </div>
            </div>
        }
        else if (Step == 2)
        {
            <!-- Step 2: OTP Verification -->
            <div class="card-body">
                <div class="registration-column" style="max-width: 500px; margin: 0 auto; padding: 1.5rem 0;">
                    <div class="section-title">
                        <span class="material-icons-outlined">security</span>
                        <h3>OTP Security Verification</h3>
                    </div>
                    
                    <p class="section-desc" style="color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.5;">
                        We found your profile! A verification code has been dispatched via SMS to your registered mobile number: 
                        <strong style="color: var(--accent); letter-spacing: 1px; font-size: 1.05rem;">@MaskedMobile</strong>.
                    </p>

                    <div class="form-group full-width" style="margin-bottom: 1.5rem;">
                        <label class="form-label lbl-req">Enter 6-Digit OTP</label>
                        <div class="input-icon-wrapper">
                            <span class="material-icons-outlined input-icon-left">lock_open</span>
                            <input type="text" 
                                   @bind="OtpCode" 
                                   class="form-control text-center" 
                                   style="letter-spacing: 6px; font-size: 1.25rem; font-weight: bold;" 
                                   placeholder="••••••" 
                                   maxlength="6" 
                                   @onkeyup="HandleOtpKey" />
                        </div>
                    </div>

                    <!-- Resend Countdown -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem;">
                        @if (ResendCountdown > 0)
                        {
                            <span style="font-size: 0.9rem; color: var(--text-muted);">
                                Resend code in <strong style="color: var(--accent);">@ResendCountdown</strong> seconds
                            </span>
                        }
                        else
                        {
                            <button type="button" class="btn btn-text" style="color: var(--accent); font-weight: 500;" @onclick="TriggerResendOtp">
                                <span class="material-icons-outlined" style="font-size: 1.1rem; margin-right: 0.25rem;">refresh</span>
                                Resend Verification Code
                            </button>
                        }
                    </div>

                    <div style="display: flex; justify-content: space-between; gap: 1rem; margin-top: 2.5rem;">
                        <button type="button" class="btn btn-text" @onclick="ResetToLookup">Change Input</button>
                        <button type="button" class="btn btn-primary" disabled="@IsLoading" @onclick="VerifyOtp">
                            @(IsLoading ? "Verifying..." : "Confirm & Continue")
                            @if (!IsLoading) { <span class="material-icons-outlined">verified</span> }
                        </button>
                    </div>
                </div>
            </div>
        }
        else if (Step == 3)
        {
            <!-- Step 3: Edit Profile Form -->
            @if (EditSuccess)
            {
                <div class="card-body text-center" style="padding: 3rem 1.5rem;">
                    <span class="material-icons-round" style="font-size: 5rem; color: #10b981; filter: drop-shadow(0 0 10px rgba(16,185,129,0.3));">task_alt</span>
                    <h3 style="margin-top: 1.5rem; color: #10b981; font-weight: 600;">Profile Updated Successfully!</h3>
                    <p style="color: var(--text-muted); max-width: 450px; margin: 0.5rem auto 2rem auto;">
                        Your administrative and professional profile details have been securely synchronized.
                    </p>
                    <button type="button" class="btn btn-primary" @onclick="GoToLogin">
                        <span>Done & Return to Login</span>
                        <span class="material-icons-outlined">arrow_forward</span>
                    </button>
                </div>
            }
            else
            {
                <EditForm EditContext="editContext" OnValidSubmit="SaveChanges">
                    <div class="card-body" style="max-height: 60vh; overflow-y: auto;">
                        <div class="registration-grid">
                            
                            <!-- Left Column: Organization Details -->
                            <div class="registration-column">
                                <div class="section-title">
                                    <span class="material-icons-outlined">business</span>
                                    <h3>1. Organization Details</h3>
                                </div>
                                <div class="form-grid">
                                    <div class="form-group full-width">
                                        <label class="form-label lbl-req">Laboratory Name</label>
                                        <InputText @bind-Value="ProfileData.tenant_name" class="form-control" placeholder="Lab Name" />
                                        <ValidationMessage For="@(() => ProfileData.tenant_name)" />
                                    </div>
                                    <div class="form-group full-width">
                                        <label class="form-label lbl-req">Legal Name</label>
                                        <InputText @bind-Value="ProfileData.legal_name" class="form-control" placeholder="Legal Name" />
                                        <ValidationMessage For="@(() => ProfileData.legal_name)" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label lbl-req">Lab Type</label>
                                        <div class="form-select-wrapper">
                                            <InputSelect @bind-Value="ProfileData.business_type" class="form-control">
                                                <option value="">Select Lab Type</option>
                                                <option value="Hospital Labs">Hospital Labs</option>
                                                <option value="Private Labs">Private Labs</option>
                                                <option value="Diagnostic Center">Diagnostic Center</option>
                                                <option value="Radiology Center">Radiology Center</option>
                                            </InputSelect>
                                        </div>
                                        <ValidationMessage For="@(() => ProfileData.business_type)" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Registration Number</label>
                                        <InputText @bind-Value="ProfileData.register_num" class="form-control" placeholder="Licensing ID" />
                                        <ValidationMessage For="@(() => ProfileData.register_num)" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">GST Number</label>
                                        <InputText @bind-Value="ProfileData.gst_number" class="form-control" placeholder="GSTIN" />
                                        <ValidationMessage For="@(() => ProfileData.gst_number)" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">PAN Number</label>
                                        <InputText @bind-Value="ProfileData.pan_number" class="form-control" placeholder="PAN" />
                                        <ValidationMessage For="@(() => ProfileData.pan_number)" />
                                    </div>
                                    <div class="form-group full-width">
                                        <label class="form-label">Website</label>
                                        <InputText @bind-Value="ProfileData.website" class="form-control" placeholder="www.example.com" />
                                        <ValidationMessage For="@(() => ProfileData.website)" />
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: Contact & Location Info -->
                            <div class="registration-column">
                                <div class="section-title">
                                    <span class="material-icons-outlined">place</span>
                                    <h3>2. Contact & Location Info</h3>
                                </div>
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label class="form-label lbl-req">Contact Person Name</label>
                                        <InputText @bind-Value="ProfileData.contact_person" class="form-control" placeholder="Full name" />
                                        <ValidationMessage For="@(() => ProfileData.contact_person)" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label lbl-req">Email Address</label>
                                        <InputText @bind-Value="ProfileData.contact_email" type="email" class="form-control" placeholder="name@domain.com" />
                                        <ValidationMessage For="@(() => ProfileData.contact_email)" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label lbl-req">Contact Number</label>
                                        <InputText @bind-Value="ProfileData.contact_number" type="tel" class="form-control" placeholder="10-digit number" maxlength="10" readonly />
                                        <ValidationMessage For="@(() => ProfileData.contact_number)" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Alternate Mobile</label>
                                        <InputText @bind-Value="ProfileData.alternate_mobile" type="tel" class="form-control" placeholder="Optional alternate" maxlength="10" />
                                        <ValidationMessage For="@(() => ProfileData.alternate_mobile)" />
                                    </div>
                                    <div class="form-group full-width">
                                        <label class="form-label lbl-req">Address Line 1</label>
                                        <InputText @bind-Value="ProfileData.address_line1" class="form-control" placeholder="Street address, building, suite" />
                                        <ValidationMessage For="@(() => ProfileData.address_line1)" />
                                    </div>
                                    <div class="form-group full-width">
                                        <label class="form-label">Address Line 2</label>
                                        <InputText @bind-Value="ProfileData.address_line2" class="form-control" placeholder="Locality, area, landmark" />
                                        <ValidationMessage For="@(() => ProfileData.address_line2)" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label lbl-req">City</label>
                                        <InputText @bind-Value="ProfileData.city" class="form-control" placeholder="City" />
                                        <ValidationMessage For="@(() => ProfileData.city)" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label lbl-req">State</label>
                                        <InputText @bind-Value="ProfileData.state" class="form-control" placeholder="State" />
                                        <ValidationMessage For="@(() => ProfileData.state)" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label lbl-req">Pincode</label>
                                        <InputText @bind-Value="ProfileData.pincode" class="form-control" placeholder="Pincode" />
                                        <ValidationMessage For="@(() => ProfileData.pincode)" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Country</label>
                                        <InputText @bind-Value="ProfileData.country" class="form-control" placeholder="Country" />
                                        <ValidationMessage For="@(() => ProfileData.country)" />
                                    </div>
                                    <div class="form-group full-width">
                                        <label class="form-label lbl-req">Password / Security Key</label>
                                        <InputText @bind-Value="ProfileData.password_hash" type="password" class="form-control" placeholder="••••••••" />
                                        <ValidationMessage For="@(() => ProfileData.password_hash)" />
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    
                    <div class="card-footer" style="display: flex; justify-content: space-between; gap: 1rem;">
                        <button type="button" class="btn btn-text" @onclick="ResetToLookup">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@IsLoading">
                            @(IsLoading ? "Saving Changes..." : "Save Laboratory Profile")
                            @if (!IsLoading) { <span class="material-icons-outlined">save</span> }
                        </button>
                    </div>
                </EditForm>
            }
        }
    </div>
</section>

@code {
    private int Step = 1;
    private string Identifier = string.Empty;
    private bool MemberNotFound = false;
    private bool IsLoading = false;
    private bool IsDarkMode = true;

    // Resolved Details
    private string ResolvedMobile = string.Empty;
    private string MaskedMobile = string.Empty;

    // Step 2: OTP State
    private string OtpCode = string.Empty;
    private int ResendCountdown = 0;
    private System.Threading.Timer? CountdownTimer;

    // Step 3: Form State
    private RegisterModel ProfileData = new RegisterModel();
    private EditContext editContext = default!;
    private bool EditSuccess = false;

    private HttpClient Http = default!;
    private ToastWrapper Toast = default!;

    protected override void OnInitialized()
    {
        Http = HttpClientFactory.CreateClient("RidoUrl");
        Toast = new ToastWrapper(ToastService);
        editContext = new EditContext(ProfileData);
    }

    private void ToggleTheme()
    {
        IsDarkMode = !IsDarkMode;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Handled dynamically via Blazor class bindings without JS interop
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/register");
    }

    private void GoToRegister()
    {
        NavigationManager.NavigateTo("/register");
    }

    private void GoToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }

    private async Task HandleLookupKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await VerifyIdentity();
        }
    }

    private async Task HandleOtpKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && OtpCode.Length == 6)
        {
            await VerifyOtp();
        }
    }

    // Step 1: Lookup Identity
    private async Task VerifyIdentity()
    {
        if (string.IsNullOrWhiteSpace(Identifier))
        {
            Toast.Warning("Please enter your Mobile, Email, or Name.");
            return;
        }

        IsLoading = true;
        MemberNotFound = false;
        StateHasChanged();

        try
        {
            string url = $"api/Identity/VerifyMember?identifier={Uri.EscapeDataString(Identifier)}";

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<VerifyResult>();
                if (result != null && result.Exists)
                {
                    ResolvedMobile = result.Mobile;
                    MaskedMobile = result.MaskedMobile;
                    
                    // Trigger OTP SMS Send
                    await SendVerificationCode();
                    
                    Step = 2;
                    StartResendTimer();
                }
                else
                {
                    MemberNotFound = true;
                }
            }
            else
            {
                MemberNotFound = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Lookup Error] {ex.Message}");
            MemberNotFound = true;
            Toast.Error("An error occurred during lookup. Please try again.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Trigger sending SMS via OTP controller
    private async Task SendVerificationCode()
    {
        try
        {
            string url = $"api/Identity/SendOTP?mobile={Uri.EscapeDataString(ResolvedMobile)}";
            
            var response = await Http.PostAsync(url, null);
            if (response.IsSuccessStatusCode)
            {
                Toast.Success($"A 6-digit verification code has been dispatched to {MaskedMobile}!");
            }
            else
            {
                Toast.Warning("Dispatched code with fallback simulated logic.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Send OTP Error] {ex.Message}");
        }
    }

    private async Task TriggerResendOtp()
    {
        OtpCode = string.Empty;
        await SendVerificationCode();
        StartResendTimer();
    }

    private void StartResendTimer()
    {
        ResendCountdown = 30;
        CountdownTimer?.Dispose();
        CountdownTimer = new System.Threading.Timer((_) =>
        {
            if (ResendCountdown > 0)
            {
                ResendCountdown--;
                InvokeAsync(StateHasChanged);
            }
            else
            {
                CountdownTimer?.Dispose();
            }
        }, null, 0, 1000);
    }

    // Step 2: Verify OTP
    private async Task VerifyOtp()
    {
        if (string.IsNullOrWhiteSpace(OtpCode) || OtpCode.Length < 6)
        {
            Toast.Warning("Please enter the complete 6-digit OTP code.");
            return;
        }

        IsLoading = true;
        StateHasChanged();

        try
        {
            string url = $"api/Identity/VerifyOTP?mobile={Uri.EscapeDataString(ResolvedMobile)}&otp={Uri.EscapeDataString(OtpCode)}";

            var response = await Http.PostAsync(url, null);
            if (response.IsSuccessStatusCode)
            {
                // OTP verified, load user details
                await LoadUserProfile();
            }
            else
            {
                Toast.Error("The security code entered is invalid or has expired.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Verify OTP Error] {ex.Message}");
            Toast.Error("OTP verification failed due to a gateway mismatch.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Step 3: Load Profile Data
    private async Task LoadUserProfile()
    {
        try
        {
            string url = $"api/Tenant/details?mobile={Uri.EscapeDataString(ResolvedMobile)}";

            var tenant = await Http.GetFromJsonAsync<RegisterModel>(url);
            if (tenant != null)
            {
                ProfileData = tenant;
                editContext = new EditContext(ProfileData);
                Step = 3;
                Toast.Success("Security clearance verified! You can now edit your profile.");
            }
            else
            {
                Toast.Error("Unable to retrieve laboratory details. Please try again.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Load User Profile Error] {ex.Message}");
            Toast.Error("Failed to synchronize profile metadata.");
        }
    }

    // Step 3: Save Updated Profile
    private async Task SaveChanges()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("api/Tenant/update", ProfileData);
            if (response.IsSuccessStatusCode)
            {
                EditSuccess = true;
                Toast.Success("Laboratory profile successfully updated!");
            }
            else
            {
                var errMsg = await response.Content.ReadAsStringAsync();
                Toast.Error($"Update failed: {errMsg}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Save Changes Error] {ex.Message}");
            Toast.Error("Failed to commit laboratory updates.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void ResetToLookup()
    {
        Step = 1;
        Identifier = string.Empty;
        OtpCode = string.Empty;
        MemberNotFound = false;
        CountdownTimer?.Dispose();
        StateHasChanged();
    }

    public void Dispose()
    {
        CountdownTimer?.Dispose();
    }

    private class VerifyResult
    {
        public bool Exists { get; set; }
        public string Mobile { get; set; } = string.Empty;
        public string MaskedMobile { get; set; } = string.Empty;
    }

    public class ToastWrapper
    {
        private readonly Booking.Services.ToastService _service;
        public ToastWrapper(Booking.Services.ToastService service) => _service = service;
        public void Success(string msg) => _service.ShowSuccess(msg);
        public void Error(string msg) => _service.ShowError(msg);
        public void Warning(string msg) => _service.ShowError(msg);
    }
}
