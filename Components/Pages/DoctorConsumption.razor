    private async Task LoadCustomers()
    {
        try
        {
            var effectiveTenant = !string.IsNullOrWhiteSpace(DefaultTenant) ? DefaultTenant : (TenantState?.TenantCode ?? "");
            var effectiveToken = TenantState?.AuthToken;

            var clients = new[] { "LabCareUrl", "DoctorApi" };
            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
            };

            var urls = new[]
            {
                "api/customer/getcus",
                "api/Customer/partition?pagenumber=1&pagesize=1000",
                "api/Customer/get",
                "api/Customer/getallcustomer"
            };

            var loadedList = new List<CustomerModel>();

            foreach (var clientName in clients)
            {
                try
                {
                    var client = ClientFactory.CreateClient(clientName);
                    if (!string.IsNullOrEmpty(effectiveTenant))
                    {
                        client.DefaultRequestHeaders.Remove("tenant_code");
                        client.DefaultRequestHeaders.Remove("tenantcode");
                        client.DefaultRequestHeaders.Add("tenant_code", effectiveTenant);
                        client.DefaultRequestHeaders.Add("tenantcode", effectiveTenant);
                    }
                    if (!string.IsNullOrEmpty(effectiveToken))
                    {
                        client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
                    }

                    foreach (var url in urls)
                    {
                        try
                        {
                            var resp = await client.GetStringAsync(url);
                            if (!string.IsNullOrWhiteSpace(resp))
                            {
                                List<CustomerModel>? list = null;
                                try
                                {
                                    list = JsonSerializer.Deserialize<List<CustomerModel>>(resp, options);
                                }
                                catch
                                {
                                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<CustomerModel>>>(resp, options);
                                    list = wrapped?.data;
                                }

                                if (list != null && list.Any())
                                {
                                    foreach (var c in list)
                                    {
                                        if (c.custid > 0 && !loadedList.Any(x => x.custid == c.custid))
                                        {
                                            loadedList.Add(c);
                                            if (!string.IsNullOrWhiteSpace(c.name))
                                            {
                                                _cachedCustomerNames[c.custid] = c.name.Trim();
                                            }
                                        }
                                    }
                                    break;
                                }
                            }
                        }
                        catch { }
                    }
                }
                catch { }
            }

            if (loadedList.Any())
            {
                CustomersList = loadedList.OrderBy(c => c.name).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DoctorConsumption] Error loading customers: {ex.Message}");
        }
    }

    private async Task LoadDoctorRooms()
    {
        try
        {
            var client = CreateClient();
            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
            };

            List<warehouse_master> allWarehouses = new();

            var urls = new[]
            {
                $"api/ItemMaster/getallwarehouse?tenantcode={DefaultTenant}",
                "api/ItemMaster/getallwarehouse",
                "ItemMaster/getallwarehouse"
            };

            foreach (var url in urls)
            {
                try
                {
                    var resp = await client.GetStringAsync(url);
                    if (!string.IsNullOrWhiteSpace(resp))
                    {
                        try
                        {
                            var direct = JsonSerializer.Deserialize<List<warehouse_master>>(resp, options);
                            if (direct != null && direct.Any())
                            {
                                allWarehouses = direct;
                                break;
                            }
                        }
                        catch
                        {
                            var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<warehouse_master>>>(resp, options);
                            if (wrapped?.data != null && wrapped.data.Any())
                            {
                                allWarehouses = wrapped.data;
                                break;
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[DoctorConsumption] Try url '{url}' failed: {ex.Message}");
                }
            }

            AllWarehousesList = allWarehouses.Where(w => !w.isdeleted).ToList();

            DoctorRoomList = allWarehouses
                .Where(w => (w.isdoctor_room || w.isdoctorroom || w.isdoctorallowed || w.isdoctor_allowed || w.is_doctor_room || w.doctorroom) && !w.isdeleted && w.isactive)
                .OrderBy(w => w.warehousename)
                .ToList();

            if (SelectedRoomWarehouseCode > 0 && !DoctorRoomList.Any(r => r.warehousecode == SelectedRoomWarehouseCode))
            {
                SelectedRoomWarehouseCode = 0;
                RoomStockList.Clear();
                ConsumedItemsList.Clear();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctor rooms: {ex.Message}");
            AllWarehousesList = new();
            DoctorRoomList = new();
        }
    }

