    private async Task LoadRoomStock(long roomCode)
    {
        if (roomCode <= 0)
        {
            RoomStockList.Clear();
            return;
        }

        IsLoadingRoomStock = true;
        StateHasChanged();
        try
        {
            var client = CreateClient();
            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
            };

            var url = $"api/ItemMaster/getdoctorroomstock?roomwarehousecode={roomCode}";
            var resp = await client.GetStringAsync(url);

            List<RoomStockBatchDto> list = new();
            try
            {
                list = JsonSerializer.Deserialize<List<RoomStockBatchDto>>(resp, options) ?? new();
            }
            catch
            {
                var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<RoomStockBatchDto>>>(resp, options);
                list = wrapped?.data ?? new();
            }

            // Also check stock_master deserialization mapping if availableqty is named closingstock
            if (list == null || !list.Any())
            {
                try
                {
                    var stockMasters = JsonSerializer.Deserialize<List<stock_master>>(resp, options);
                    if (stockMasters != null && stockMasters.Any())
                    {
                        list = stockMasters.Select(s => new RoomStockBatchDto
                        {
                            stockcode = s.stockcode,
                            itemcode = s.itemcode,
                            batchno = s.batchno,
                            expirydate = s.expirydate,
                            availableqty = s.closingstock,
                            closingstock = s.closingstock,
                            unitcost = s.unitcost,
                            mrpunit = s.mrpunit
                        }).ToList();
                    }
                }
                catch { }
            }

            // Ensure availableqty is positive
            foreach (var item in list)
            {
                if (item.availableqty == 0 && item.closingstock > 0)
                {
                    item.availableqty = item.closingstock;
                }
            }

            RoomStockList = list.Where(r => r.availableqty > 0).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctor room stock: {ex.Message}");
            RoomStockList = new();
        }
        finally
        {
            IsLoadingRoomStock = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AddItemToConsume(RoomStockBatchDto batch)
    {
        if (ConsumedItemsList.Any(c => c.stockcode == batch.stockcode))
        {
            ToastService.ShowWarning("Batch is already added to consumption list.");
            return;
        }

        var newRow = new ConsumedItemRowModel
        {
            consumptiondetailcode = 0,
            stockcode = batch.stockcode,
            itemcode = batch.itemcode,
            itemname = GetItemName(batch.itemcode, batch.itemname),
            batchno = batch.batchno,
            availableqty = batch.availableqty,
            consumedqty = 1,
            unitcost = batch.unitcost,
            stockvalue = batch.unitcost * 1,
            remarks = ""
        };

        ConsumedItemsList.Add(newRow);
    }

    private void IncrementConsumedQty(ConsumedItemRowModel item, decimal step)
    {
        if (item.consumedqty + step <= item.availableqty)
        {
            item.consumedqty += step;
            RecalculateItemValue(item);
        }
        else
        {
            ToastService.ShowWarning($"Consumed quantity cannot exceed available stock ({item.availableqty}).");
        }
    }

    private void DecrementConsumedQty(ConsumedItemRowModel item, decimal step)
    {
        if (item.consumedqty - step >= 1)
        {
            item.consumedqty -= step;
            RecalculateItemValue(item);
        }
    }

    private void RecalculateItemValue(ConsumedItemRowModel item)
    {
        if (item.consumedqty > item.availableqty)
        {
            item.consumedqty = item.availableqty;
            ToastService.ShowWarning($"Quantity adjusted to max available ({item.availableqty}).");
        }
        else if (item.consumedqty < 1)
        {
            item.consumedqty = 1;
        }

        item.stockvalue = item.consumedqty * item.unitcost;
    }

    private void RemoveConsumedItem(ConsumedItemRowModel item)
    {
        ConsumedItemsList.Remove(item);
    }

