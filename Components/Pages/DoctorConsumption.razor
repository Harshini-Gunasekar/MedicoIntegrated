    private async Task LoadDoctorRooms()
    {
        try
        {
            var client = CreateClient();
            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
            };

            // Attempt 1: Fetch dedicated getdoctorrooms
            try
            {
                var resp = await client.GetStringAsync("api/ItemMaster/getdoctorrooms");
                try
                {
                    var direct = JsonSerializer.Deserialize<List<warehouse_master>>(resp, options);
                    if (direct != null && direct.Any())
                    {
                        DoctorRoomList = direct.Where(w => !w.isdeleted && w.isactive).OrderBy(w => w.warehousename).ToList();
                        return;
                    }
                }
                catch
                {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<warehouse_master>>>(resp, options);
                    if (wrapped?.data != null && wrapped.data.Any())
                    {
                        DoctorRoomList = wrapped.data.Where(w => !w.isdeleted && w.isactive).OrderBy(w => w.warehousename).ToList();
                        return;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"getdoctorrooms fallback: {ex.Message}");
            }

            // Fallback: getallwarehouse and filter isdoctor_room == true
            var fallbackResp = await client.GetStringAsync("api/ItemMaster/getallwarehouse");
            try
            {
                var direct = JsonSerializer.Deserialize<List<warehouse_master>>(fallbackResp, options);
                var all = direct ?? new List<warehouse_master>();
                var docRooms = all.Where(w => w.isdoctor_room && !w.isdeleted && w.isactive).ToList();
                DoctorRoomList = (docRooms.Any() ? docRooms : all.Where(w => !w.isdeleted && w.isactive).ToList()).OrderBy(w => w.warehousename).ToList();
            }
            catch
            {
                var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<warehouse_master>>>(fallbackResp, options);
                var all = wrapped?.data ?? new List<warehouse_master>();
                var docRooms = all.Where(w => w.isdoctor_room && !w.isdeleted && w.isactive).ToList();
                DoctorRoomList = (docRooms.Any() ? docRooms : all.Where(w => !w.isdeleted && w.isactive).ToList()).OrderBy(w => w.warehousename).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctor rooms: {ex.Message}");
            DoctorRoomList = new();
        }
    }

