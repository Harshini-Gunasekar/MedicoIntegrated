        top: 50% !important;
        transform: translateY(-50%) !important;
        color: #94a3b8 !important;
        font-size: 0.75rem !important;
        pointer-events: none !important;
    }

    .return-search-clear {
        position: absolute !important;
        right: 7px !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        color: #94a3b8 !important;
        font-size: 0.75rem !important;
        cursor: pointer !important;
    }

    .return-search-clear:hover {
        color: #ef4444 !important;
    }

    .modal-close-btn {
        background: transparent !important;
        border: none !important;
        color: #94a3b8 !important;
        cursor: pointer !important;
        transition: all 0.2s ease !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 34px !important;
        height: 34px !important;
        border-radius: 8px !important;
        line-height: 1 !important;
        padding: 0 !important;
    }

    .modal-close-btn:hover {
        color: #ef4444 !important;
        background: #fef2f2 !important;
        transform: rotate(90deg) !important;
    }

    /* Action Confirmation Popup */
    .action-popup-overlay {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        background: rgba(15, 23, 42, 0.6) !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        z-index: 1200 !important;
    }

    .action-popup-card {
        background: #ffffff !important;
        border-radius: 14px !important;
        width: 90% !important;
        max-width: 420px !important;
        padding: 24px !important;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.15) !important;
        text-align: center !important;
    }

    .action-popup-header {
        font-size: 1.15rem !important;
        font-weight: 800 !important;
        color: #0f172a !important;
        margin-bottom: 8px !important;
    }

    .action-popup-body {
        font-size: 0.85rem !important;
        color: #64748b !important;
        margin-bottom: 20px !important;
        line-height: 1.5 !important;
    }

    .action-popup-actions {
        display: flex !important;
        justify-content: center !important;
        gap: 12px !important;
    }

    .popup-btn {
        padding: 8px 20px !important;
        border-radius: 8px !important;
        font-size: 0.85rem !important;
        font-weight: 700 !important;
        cursor: pointer !important;
        border: none !important;
    }

    .popup-btn-cancel {
        background: #f1f5f9 !important;
        color: #334155 !important;
    }

    .popup-btn-delete {
        background: #dc2626 !important;
        color: #ffffff !important;
    }
</style>

<div class="doctor-cons-main-wrapper" @onclick="CloseAllPatientDropdowns">
    <!-- Top Header Card -->
    <div class="premium-header-card">
        <div class="header-card-left">
            <div class="header-card-icon">
                <i class="bi bi-capsule" style="font-size: 1.4rem;"></i>
            </div>
            <div class="header-card-text">
                <h2 class="header-card-heading">
                    Doctor Room Stock Consumption
                </h2>
                <div class="header-card-subheading">
                    <span class="status-dot"></span> Real-time clinical inventory audit & doctor room deduction
                </div>
            </div>
        </div>

        <div class="header-card-right d-flex align-items-center gap-2">
            <button type="button" class="btn-header-log" @onclick="OpenConsumptionLogsModal" title="View Doctor Room Consumption History Logs">
                <i class="bi bi-clock-history"></i>
                <span>Consumption Logs</span>
                @if (ConsumptionLogsList.Any())
                {
                    <span class="badge-log-count">@ConsumptionLogsList.Count</span>
                }
            </button>
        </div>
    </div>

    <!-- Edit Mode Active Alert -->
    @if (IsEditMode)
    {
        <div class="edit-mode-banner">
            <div class="edit-mode-text">
                <i class="bi bi-pencil-square" style="font-size: 1.1rem;"></i>
                <span>Currently Editing Consumption Record <strong>@(string.IsNullOrWhiteSpace(EditConsumptionNo) ? $"#{EditConsumptionCode}" : EditConsumptionNo)</strong>. You can adjust quantities and save updates.</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-dark" @onclick="CancelEditMode" style="border-radius: 8px; font-weight: 700; font-size: 0.78rem; padding: 4px 12px; background: #ffffff;">
                <i class="bi bi-x-circle me-1"></i> Cancel Edit
            </button>
        </div>
    }

    <!-- Filter & Header Master Form Card (Clean 2-Row Design) -->
    <div class="filter-card-main">
        <!-- Row 1: Date, Doctor Room Store, Department, Suggested Doctor -->
        <div class="filter-grid-row-1">
            <!-- Date -->
            <div class="filter-field-group">
                <label class="filter-field-label">
                    <i class="bi bi-calendar3" style="color: #6366f1;"></i> Date <span class="required-star">*</span>
                </label>
                <input type="datetime-local" class="form-control premium-cons-input" @bind="ConsumptionDate" />
            </div>

            <!-- Doctor Room / Warehouse -->
            <div class="filter-field-group">
                <label class="filter-field-label">
                    <i class="bi bi-shop" style="color: #6366f1;"></i> Doctor Room Store <span class="required-star">*</span>
                </label>
                <div style="position: relative;">
                    <select class="form-control premium-cons-input" style="appearance: none !important; padding-right: 28px;"
                            value="@SelectedRoomWarehouseCode"
                            @onchange="OnDoctorRoomChanged">
                        <option value="0">-- Select Doctor Room Store --</option>
                        @foreach (var room in DoctorRoomList)
                        {
                            <option value="@room.warehousecode">@room.warehousename @(string.IsNullOrWhiteSpace(room.location) ? "" : $"— {room.location}")</option>
                        }
                    </select>
                    <i class="bi bi-chevron-down" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b; font-size: 0.85rem;"></i>
                </div>
            </div>

            <!-- Department Name -->
            <div class="filter-field-group">
                <label class="filter-field-label">
                    <i class="bi bi-building" style="color: #6366f1;"></i> Department
                </label>
                <input type="text" class="form-control premium-cons-input" placeholder="E.g. Cardiology, OPD" @bind="DepartmentName" />
            </div>

            <!-- Suggested Doctor (From Doctor Master) -->
            <div class="filter-field-group">
                <label class="filter-field-label">
                    <i class="bi bi-person-badge" style="color: #6366f1;"></i> Suggested Doctor (Doctor Master)
                </label>
                <div style="position: relative;">
                    <select class="form-control premium-cons-input" style="appearance: none !important; padding-right: 28px;"
                            value="@(HeaderDcode ?? 0)"
                            @onchange="OnHeaderDoctorChanged">
                        <option value="0">-- Select Suggested Doctor --</option>
                        @foreach (var doc in DoctorsList)
                        {
                            <option value="@doc.dcode">@GetDoctorDisplayName(doc)</option>
                        }
                    </select>
                    <i class="bi bi-chevron-down" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b; font-size: 0.85rem;"></i>
                </div>
            </div>
        </div>

        <!-- Row 2: Search Consumed Patient (Autocomplete Dropdown), Remarks, and Filter Room Stock -->
        <div class="filter-grid-row-2">
            <!-- Consumed Customer (Searchable with Live Dropdown matching OutPatient Visiting) -->
            <div class="filter-field-group" @onclick:stopPropagation="true">
                <label class="filter-field-label">
                    <i class="bi bi-person-heart" style="color: #6366f1;"></i> Search Consumed Patient / Customer
                </label>
                <div class="autocomplete-search-wrapper">
                    <input type="text" class="form-control premium-cons-input"
                           placeholder="Search Patient Name, MobileNo, or CUST ID..."
                           value="@HeaderPatientSearchQuery"
                           @oninput="OnHeaderPatientSearchInput"
                           @onfocus="OnHeaderPatientSearchFocus"
                           style="padding-right: 30px;" />
                    @if (!string.IsNullOrWhiteSpace(HeaderPatientSearchQuery))
                    {
                        <i class="bi bi-x-circle-fill search-clear-btn" @onclick="ClearHeaderPatientSearch" title="Clear customer"></i>
                    }
                    @if (ShowHeaderPatientDropdown && SearchedHeaderPatients.Count > 0)
                    {
                        <div class="autocomplete-dropdown">
                            @for (int i = 0; i < SearchedHeaderPatients.Count; i++)
                            {
                                var pat = SearchedHeaderPatients[i];
                                <div class="autocomplete-item" @onclick="() => SelectHeaderCustomerPatient(pat)">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="width: 32px; height: 32px; border-radius: 50%; background: #e0e7ff; color: #4338ca; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 800; flex-shrink: 0;">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <span style="font-weight: 700; color: #0f172a; font-size: 0.85rem; display: block;">@pat.name</span>
                                            <div style="font-size: 0.74rem; color: #64748b; margin-top: 1px;">
                                                📞 @(string.IsNullOrWhiteSpace(pat.mobile) ? "No mobile" : pat.mobile)
                                            </div>
                                        </div>
                                    </div>
                                    <span class="autocomplete-code">@(string.IsNullOrWhiteSpace(pat.custcode) ? $"CUST-{pat.custid}" : pat.custcode)</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Remarks -->
            <div class="filter-field-group">
                <label class="filter-field-label">
                    <i class="bi bi-chat-left-text" style="color: #6366f1;"></i> Remarks / Consumption Note
                </label>
                <input type="text" class="form-control premium-cons-input" placeholder="E.g. Morning OPD clinical stock consumption, injection usage..." @bind="MasterRemarks" />
            </div>

            <!-- Item Search Filter -->
            <div class="filter-field-group">
                <label class="filter-field-label">
                    <i class="bi bi-search" style="color: #6366f1;"></i> Filter Room Stock
                </label>
                <div class="search-input-field-wrap">
                    <input type="text" class="form-control premium-cons-input"
                           placeholder="Type to search items or batches..."
                           value="@ItemSearchQuery"
                           @oninput="OnItemSearchInput" />
                    <i class="bi bi-search item-field-search-icon"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Parallel Tables: Available Room Stock vs Consumed Items -->
    <div class="parallel-tables-row">
        <!-- Left Table: Available Room Batches -->
        <div class="table-card">
            <div class="table-card-header">
                <h6>
                    <i class="bi bi-boxes" style="color: #4f46e5; font-size: 1.1rem;"></i>
                    Available Room Stock
                </h6>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-pill">
                        @FilteredRoomStock.Count() Batches
                    </span>
                    @if (SelectedRoomWarehouseCode > 0)
                    {
                        <button type="button" class="btn btn-sm btn-light p-1 px-2" @onclick="() => LoadRoomStock(SelectedRoomWarehouseCode)" title="Refresh Room Stock" style="font-size: 0.75rem; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="table-card-body">
                <table class="custom-cons-table">
                    <thead>
                        <tr>
                            <th style="text-align: left;">Item Name</th>
                            <th style="text-align: center;">Batch No</th>
                            <th style="text-align: center;">Expiry</th>
                            <th style="text-align: right;">Unit Cost</th>
                            <th style="text-align: right;">Available</th>
                            <th style="text-align: center; width: 75px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoadingRoomStock)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    <span class="ms-2 text-muted" style="font-size: 0.85rem;">Loading room stock...</span>
                                </td>
                            </tr>
                        }
                        else if (SelectedRoomWarehouseCode == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5" style="text-align: center !important;">
                                    <i class="bi bi-shop" style="font-size: 2.2rem; color: #cbd5e1; display: block; margin-bottom: 8px;"></i>
                                    Please select a Doctor Room Store from above to view available stock.
                                </td>
                            </tr>
                        }
                        else if (!FilteredRoomStock.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5" style="text-align: center !important;">
                                    <i class="bi bi-inbox" style="font-size: 2.2rem; color: #cbd5e1; display: block; margin-bottom: 8px;"></i>
                                    No stock batches found for this Doctor Room.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in FilteredRoomStock)
                            {
                                var alreadyAdded = ConsumedItemsList.Any(c => c.stockcode == row.stockcode);
                                <tr class="@(alreadyAdded ? "table-active-row" : "")" @onclick="() => AddItemToConsume(row)" style="cursor: pointer;">
                                    <td style="font-weight: 600; color: #0f172a;">
                                        @GetItemName(row.itemcode, row.itemname)
                                    </td>
                                    <td style="text-align: center;">
                                        <span class="batch-badge">@(string.IsNullOrWhiteSpace(row.batchno) ? "N/A" : row.batchno)</span>
                                    </td>
                                    <td style="text-align: center; color: #64748b; font-size: 0.76rem;">
                                        @(row.expirydate.HasValue ? row.expirydate.Value.ToString("MMM yyyy") : "-")
                                    </td>
                                    <td style="text-align: right; color: #475569; font-weight: 600;">
                                        ₹@row.unitcost.ToString("N2")
                                    </td>
                                    <td style="text-align: right; font-weight: 700; color: #059669;">
                                        @row.availableqty.ToString("N0")
                                    </td>
                                    <td style="text-align: center;">
                                        @if (alreadyAdded)
                                        {
                                            <span class="badge" style="background: #e2e8f0; color: #64748b; font-size: 0.72rem; padding: 4px 8px; border-radius: 6px;">
                                                <i class="bi bi-check"></i> Added
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn-add-action" title="Add to Consumption List">
                                                <i class="bi bi-plus-circle-fill"></i> <span>Add</span>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="table-card-footer">
                <span style="font-weight: 600; color: #64748b;">Available Batches: <strong>@FilteredRoomStock.Count()</strong></span>
                <div>
                    <span style="color: #059669; font-weight: 700;">
                        Total Stock: @FilteredRoomStock.Sum(r => r.availableqty).ToString("N0")
                    </span>
                </div>
            </div>
        </div>

        <!-- Right Column: Consumed Items Table & Actions -->
        <div class="right-cons-column">
            <div class="table-card">
                <div class="table-card-header">
                    <h6>
                        <i class="bi bi-cart-dash" style="color: #059669; font-size: 1.1rem;"></i>
                        Items to Consume
                    </h6>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge-pill badge-pill-success">
                            @ConsumedItemsList.Count Items Selected
                        </span>
                        @if (ConsumedItemsList.Any() && ((HeaderDcode.HasValue && HeaderDcode.Value > 0) || (HeaderCustId.HasValue && HeaderCustId.Value > 0)))
                        {
                            <button type="button" class="btn-apply-all-header" @onclick="ApplyHeaderDoctorAndCustomerToAll" title="Apply Header Doctor & Customer to all consumed items">
                                <i class="bi bi-arrow-down-circle"></i> Apply Header Doc & Cust to All
                            </button>
                        }
                    </div>
                </div>
                <div class="table-card-body">
                    <table class="custom-cons-table">
                        <thead>
                            <tr>
                                <th style="text-align: left; min-width: 120px;">Item Name</th>
                                <th style="text-align: center; width: 60px;">Batch</th>
                                <th style="text-align: right; width: 45px;">Avail</th>
                                <th style="text-align: center; width: 110px;">Consumed Qty</th>
                                <th style="text-align: left; min-width: 130px;">Suggested Doctor</th>
                                <th style="text-align: left; min-width: 155px;">Consumed Customer</th>
                                <th style="text-align: right; width: 65px;">Unit Cost</th>
                                <th style="text-align: right; width: 70px;">Value</th>
                                <th style="text-align: center; width: 40px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ConsumedItemsList.Any())
                            {
                                @foreach (var item in ConsumedItemsList)
                                {
                                    <tr>
                                        <td style="font-weight: 600; color: #0f172a;">
                                            <div style="line-height: 1.25;">@GetItemName(item.itemcode, item.itemname)</div>
                                        </td>
                                        <td style="text-align: center;">
                                            <span class="batch-badge">@(string.IsNullOrWhiteSpace(item.batchno) ? "N/A" : item.batchno)</span>
                                        </td>
                                        <td style="text-align: right; color: #64748b; font-weight: 600;">
                                            @item.availableqty.ToString("N0")
                                        </td>
                                        <td style="text-align: center;">
                                            <div class="qty-stepper-wrapper">
                                                <button type="button" class="btn-stepper btn-minus" @onclick="() => DecrementConsumedQty(item, 1)" title="-1">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <input type="number" step="1" min="1" max="@item.availableqty" class="stepper-input"
                                                       @bind="item.consumedqty"
                                                       @bind:event="oninput"
                                                       @onchange="() => RecalculateItemValue(item)" />
                                                <button type="button" class="btn-stepper btn-plus" @onclick="() => IncrementConsumedQty(item, 1)" title="+1">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm table-select-custom"
                                                    value="@(item.dcode ?? 0)"
                                                    @onchange="(e) => OnItemDoctorChanged(item, e)">
                                                <option value="0">-- Select Doctor --</option>
                                                @foreach (var doc in DoctorsList)
                                                {
                                                    <option value="@doc.dcode">@GetDoctorDisplayName(doc)</option>
                                                }
                                            </select>
                                        </td>
                                        <!-- Customer Searchable Autocomplete in row -->
                                        <td style="position: relative;" @onclick:stopPropagation="true">
                                            <div class="autocomplete-search-wrapper" style="min-width: 155px; max-width: 220px;">
                                                <input type="text" class="form-control row-customer-input"
                                                       placeholder="Search patient / CUST ID..."
                                                       value="@GetRowPatientDisplay(item)"
                                                       @oninput="(e) => OnRowPatientSearchInput(item, e)"
                                                       @onfocus="() => OnRowPatientSearchFocus(item)" />
                                                @if ((item.custid.HasValue && item.custid.Value > 0) || !string.IsNullOrWhiteSpace(item.SearchQuery))
                                                {
                                                    <i class="bi bi-x-circle-fill search-clear-btn" style="right: 8px; font-size: 0.75rem;" @onclick="() => ClearRowPatient(item)" title="Clear customer"></i>
                                                }
                                                @if (item.ShowDropdown && item.SearchedPatients.Count > 0)
                                                {
                                                    <div class="row-autocomplete-dropdown">
                                                        @foreach (var pat in item.SearchedPatients)
                                                        {
                                                            <div class="autocomplete-item" @onclick="() => SelectRowCustomerPatient(item, pat)">
                                                                <div style="display: flex; align-items: center; gap: 8px;">
                                                                    <div style="width: 28px; height: 28px; border-radius: 50%; background: #e0e7ff; color: #4338ca; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; flex-shrink: 0;">
                                                                        <i class="bi bi-person-fill"></i>
                                                                    </div>
                                                                    <div>
                                                                        <span style="font-weight: 700; color: #0f172a; font-size: 0.8rem; display: block; line-height: 1.2;">@pat.name</span>
                                                                        <div style="font-size: 0.72rem; color: #64748b; margin-top: 1px;">
                                                                            📞 @(string.IsNullOrWhiteSpace(pat.mobile) ? "No mobile" : pat.mobile)
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <span class="autocomplete-code">@(string.IsNullOrWhiteSpace(pat.custcode) ? $"CUST-{pat.custid}" : pat.custcode)</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                        <td style="text-align: right; color: #475569; font-size: 0.78rem;">
                                            ₹@item.unitcost.ToString("N2")
                                        </td>
                                        <td style="text-align: right; font-weight: 700; color: #4338ca; font-size: 0.82rem;">
                                            ₹@item.stockvalue.ToString("N2")
                                        </td>
                                        <td style="text-align: center;">
                                            <button type="button" class="btn-remove-action" @onclick="() => RemoveConsumedItem(item)" title="Remove item">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-5" style="text-align: center !important;">
                                        <i class="bi bi-capsule" style="font-size: 2.2rem; color: #cbd5e1; display: block; margin-bottom: 8px;"></i>
                                        Click <strong>"+ Add"</strong> on any available batch from the left table to record consumption.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="table-card-footer">
                    <span style="color: #64748b;">
                        Total Items: <strong style="color: #1e293b; margin-left: 4px;">@ConsumedItemsList.Count</strong>
                        | Total Qty: <strong style="color: #4338ca; margin-left: 4px;">@ConsumedItemsList.Sum(c => c.consumedqty).ToString("N0")</strong>
                    </span>
                    <span style="font-weight: 700; color: #1e1b4b; font-size: 0.9rem;">
                        Total Value: <span style="color: #059669;">₹@ConsumedItemsList.Sum(c => c.stockvalue).ToString("N2")</span>
                    </span>
                </div>
            </div>

            <!-- Action Buttons exactly below Consumed Items table matching Stock Adjustment -->
            @if (ConsumedItemsList.Any())
            {
                <div style="display: flex; justify-content: flex-end; align-items: center; gap: 12px; margin-top: 6px; width: 100%;">
                    <button type="button" class="btn-cancel-modal" @onclick="ResetForm" style="background: #ffffff; color: #334155; border: 1.5px solid #cbd5e1; padding: 0.55rem 1.6rem; border-radius: 10px; font-weight: 700; font-size: 0.85rem; transition: all 0.2s; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
                        Reset
                    </button>
                    <button type="button" class="btn-save-premium" @onclick="SaveDoctorConsumption" disabled="@IsSaving" style="min-width: 180px; height: 42px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; border-radius: 10px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; font-weight: 700; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3); transition: all 0.2s; cursor: pointer;">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Saving Consumption...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                            <span>@(IsEditMode ? "Update Consumption" : "Save Consumption")</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- =========================================================
     DOCTOR CONSUMPTION LOGS MODAL (High Fidelity & Full Width)
     ========================================================= -->
@if (ShowLogsModal)
{
    <div class="log-modal-backdrop"></div>
    <div class="log-modal-dialog" @onclick:stopPropagation="true">
        <!-- Modal Single Line Header with Left Title and Right-Aligned Search, Store, and Cross Close button -->
        <div class="log-modal-header" style="display: flex !important; flex-direction: row !important; align-items: center !important; justify-content: space-between !important; padding: 14px 22px !important; width: 100% !important; box-sizing: border-box !important; border-bottom: 1px solid #e2e8f0 !important; background: #ffffff !important; gap: 16px !important;">
            <!-- Left Group: Title + Total Badge + Subtitle -->
            <div class="header-card-left" style="display: flex !important; flex-direction: row !important; align-items: center !important; gap: 12px !important; flex-shrink: 0 !important;">
                <div class="header-card-icon" style="width: 40px !important; height: 40px !important; border-radius: 10px !important; background: #eef2ff !important; border: 1px solid #c7d2fe !important; display: flex !important; align-items: center !important; justify-content: center !important; color: #4f46e5 !important; font-size: 1.2rem !important; flex-shrink: 0 !important;">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="header-card-text" style="display: flex !important; flex-direction: column !important; text-align: left !important;">
                    <div class="return-log-title-row" style="display: inline-flex !important; align-items: center !important; gap: 8px !important;">
                        <h4 style="font-size: 1.05rem !important; font-weight: 800 !important; color: #1e293b !important; margin: 0 !important; line-height: 1.2 !important; white-space: nowrap !important;">Doctor Room Consumption History Logs</h4>
                        <span class="return-log-count-badge" style="background: #e0e7ff !important; color: #4338ca !important; font-size: 0.74rem !important; padding: 2px 8px !important; border-radius: 20px !important; font-weight: 700 !important; border: 1px solid #c7d2fe !important; white-space: nowrap !important;">Total: @FilteredLogs.Count</span>
                    </div>
                    <span style="font-size: 0.72rem !important; color: #64748b !important; font-weight: 500 !important; margin-top: 2px !important; white-space: nowrap !important;">Audit trail of all clinical doctor room stock deductions</span>
                </div>
            </div>

            <!-- Right Controls: Right-Aligned Search Bar + Store Filter + Cross Close Button -->
            <div style="display: flex !important; flex-direction: row !important; align-items: center !important; gap: 10px !important; margin-left: auto !important; flex-shrink: 0 !important;">
                <!-- Search Bar -->
                <div class="return-search-wrapper" style="width: 220px !important; position: relative !important; display: inline-flex !important; align-items: center !important;">
                    <input type="text" class="return-search-input" placeholder="Search by Store, Doctor, Customer..."
                           value="@LogSearchQuery"
                           @oninput="(e) => { LogSearchQuery = e.Value?.ToString() ?? string.Empty; StateHasChanged(); }"
                           style="height: 34px !important; font-size: 0.8rem !important; padding-left: 30px !important; padding-right: 24px !important; border-radius: 8px !important; border: 1px solid #cbd5e1 !important; background: #f8fafc !important; width: 100% !important; color: #1e293b !important; outline: none !important;" />
                    <i class="bi bi-search return-search-icon" style="position: absolute !important; left: 9px !important; top: 50% !important; transform: translateY(-50%) !important; color: #94a3b8 !important; font-size: 0.78rem !important; pointer-events: none !important;"></i>
                    @if (!string.IsNullOrEmpty(LogSearchQuery))
                    {
                        <i class="bi bi-x-circle-fill return-search-clear" @onclick='() => { LogSearchQuery = ""; StateHasChanged(); }' style="position: absolute !important; right: 7px !important; top: 50% !important; transform: translateY(-50%) !important; color: #94a3b8 !important; font-size: 0.78rem !important; cursor: pointer !important;"></i>
                    }
                </div>

                <!-- Store Dropdown -->
                <div style="display: flex !important; align-items: center !important; gap: 6px !important; flex-shrink: 0 !important;">
                    <label style="font-size: 0.72rem !important; font-weight: 700 !important; color: #475569 !important; margin: 0 !important; text-transform: uppercase !important; white-space: nowrap !important;">Store:</label>
                    <select class="form-select form-select-sm" style="height: 34px !important; font-size: 0.8rem !important; border-radius: 8px !important; border: 1px solid #cbd5e1 !important; width: 150px !important; color: #1e293b !important; padding: 3px 8px !important;"
                            value="@LogStoreFilter"
                            @onchange="(e) => { LogStoreFilter = long.TryParse(e.Value?.ToString(), out var v) ? v : 0; StateHasChanged(); }">
                        <option value="0">All Stores</option>
                        @foreach (var room in DoctorRoomList)
                        {
                            <option value="@room.warehousecode">@room.warehousename</option>
                        }
                    </select>
                </div>

                <!-- Cross Symbol Close Button (Hover Red) -->
                <button type="button" class="modal-close-btn" @onclick="CloseConsumptionLogsModal" title="Close" aria-label="Close" style="margin-left: 4px !important;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Modal Body Table -->
        <div class="log-modal-body">
            @if (IsLoadingLogs)
            {
                <div class="text-center py-5 text-muted" style="text-align: center !important;">
                    <div class="spinner-border text-primary" role="status" style="width: 2.2rem; height: 2.2rem;"></div>
                    <p class="mt-2 text-muted" style="font-size: 0.85rem;">Loading consumption history logs...</p>
                </div>
            }
            else if (!FilteredLogs.Any())
            {
                <div class="text-center py-5" style="background: #f8fafc; border-radius: 12px; border: 1px dashed #cbd5e1; margin: 20px; text-align: center !important;">
                    <i class="bi bi-inbox" style="font-size: 2.5rem; color: #94a3b8;"></i>
                    <h5 class="mt-2" style="font-size: 0.95rem; font-weight: 700; color: #475569;">No Doctor Room Consumption Logs Found</h5>
                    <p class="text-muted mb-0" style="font-size: 0.8rem;">There are no consumption records matching the selected search criteria.</p>
                </div>
            }
            else
            {
                <table class="custom-cons-table mb-0">
                    <thead>
                        <tr>
                            <th style="width: 90px; text-align: center;">ID</th>
                            <th style="text-align: center; width: 110px;">DATE & TIME</th>
                            <th style="text-align: left;">DOCTOR ROOM STORE</th>
                            <th style="text-align: left;">SUGGESTED DOCTOR</th>
                            <th style="text-align: left;">CONSUMED CUSTOMER</th>
                            <th style="text-align: right; width: 60px;">ITEMS</th>
                            <th style="text-align: right; width: 70px;">TOTAL QTY</th>
                            <th style="text-align: right; width: 85px;">TOTAL VALUE</th>
                            <th style="text-align: center; width: 60px;">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in FilteredLogs)
                        {
                            var roomName = DoctorRoomList.FirstOrDefault(r => r.warehousecode == log.roomwarehousecode)?.warehousename
                                           ?? AllWarehousesList.FirstOrDefault(r => r.warehousecode == log.roomwarehousecode)?.warehousename
                                           ?? (log.roomwarehousecode > 0 ? $"Store #{log.roomwarehousecode}" : "N/A");
                            var docDisp = GetDoctorNameByCode(log.dcode, log.doctorname);
                            var custDisp = GetCustomerNameById(log.custid, log.customername);
                            <tr>
                                <td style="text-align: center; font-weight: 700; color: #4f46e5;">
                                    @(string.IsNullOrWhiteSpace(log.consumptionno) ? $"#{log.consumptioncode}" : log.consumptionno)
                                </td>
                                <td style="text-align: center; color: #475569; font-size: 0.78rem;">
                                    @(log.consumptiondate != default ? log.consumptiondate.ToString("dd-MM-yyyy HH:mm") : log.createddate.ToString("dd-MM-yyyy"))
                                </td>
                                <td style="font-weight: 600; color: #0f172a;">
                                    <i class="bi bi-shop text-primary me-1"></i> @roomName
                                </td>
                                <td style="color: #334155; font-size: 0.8rem;">
                                    <i class="bi bi-person-badge text-indigo me-1"></i> @docDisp
                                </td>
                                <td style="color: #334155; font-size: 0.8rem;">
                                    <i class="bi bi-person-heart text-success me-1"></i> @custDisp
                                </td>
                                <td style="text-align: right; color: #475569; font-weight: 600;">
                                    @log.totalitems.ToString("N0")
                                </td>
                                <td style="text-align: right; font-weight: 700; color: #059669;">
                                    @log.totalqty.ToString("N0")
                                </td>
                                <td style="text-align: right; font-weight: 700; color: #4338ca;">
                                    ₹@log.totalvalue.ToString("N2")
                                </td>
                                <td style="text-align: center;">
                                    <button type="button" class="btn btn-sm" @onclick="() => EditConsumptionRecord(log)" title="Edit this consumption" style="border: 1px solid #c7d2fe; background: #eef2ff; color: #4338ca; border-radius: 6px; width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem; padding: 0;">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Modal Footer -->
        <div class="log-modal-footer" style="padding: 12px 22px !important; border-top: 1px solid #e2e8f0 !important; background: #ffffff !important; display: flex !important; align-items: center !important; justify-content: space-between !important;">
            <div style="font-size: 0.82rem; color: #64748b; font-weight: 500;">
                Showing <strong>@FilteredLogs.Count</strong> of <strong>@ConsumptionLogsList.Count</strong> consumption logs
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Popup -->
@if (ShowDeleteConfirmModal && PendingDeleteLog != null)
{
    <div class="action-popup-overlay" @onclick="CancelDelete">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Consumption Record</div>
            <div class="action-popup-body">
                Are you sure you want to delete consumption record <strong>@(string.IsNullOrWhiteSpace(PendingDeleteLog.consumptionno) ? $"#{PendingDeleteLog.consumptioncode}" : PendingDeleteLog.consumptionno)</strong>?
                <br /><small class="text-danger mt-1 d-block">This action will revert the consumed stock deductions.</small>
            </div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" disabled="@IsDeleting" @onclick="ConfirmDeleteConsumption">
                    @if (IsDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    <span>Delete</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    // Top Master Form State
    private DateTime ConsumptionDate = DateTime.Now;
    private long SelectedRoomWarehouseCode = 0;
    private string DepartmentName = "";
    private int? HeaderDcode = null;
    private string DoctorName = "";
    private decimal? HeaderCustId = null;
    private string CustomerName = "";
    private string HeaderPatientSearchQuery = "";
    private bool ShowHeaderPatientDropdown = false;
    private List<CustomerModel> SearchedHeaderPatients = new();
    private System.Threading.CancellationTokenSource? _headerSearchCts;

    private string MasterRemarks = "";
    private string ItemSearchQuery = "";

    // Edit Mode State
    private bool IsEditMode = false;
    private long EditConsumptionCode = 0;
    private string? EditConsumptionNo = null;

    // Loading / Saving states
    private bool IsLoadingRoomStock = false;
    private bool IsSaving = false;
    private bool IsLoadingLogs = false;
    private bool IsDeleting = false;

    // Modals
    private bool ShowLogsModal = false;
    private bool ShowDeleteConfirmModal = false;
    private consumption_master? PendingDeleteLog = null;
    private string LogSearchQuery = "";
    private long LogStoreFilter = 0;

    // Data Collections
    private List<warehouse_master> AllWarehousesList = new();
    private List<warehouse_master> DoctorRoomList = new();
    private List<inventory_item_master> AllItemsList = new();
    private List<DoctorMasterModel> DoctorsList = new();
    private List<CustomerModel> CustomersList = new();
    private List<RoomStockBatchDto> RoomStockList = new();
    private List<ConsumedItemRowModel> ConsumedItemsList = new();
    private List<consumption_master> ConsumptionLogsList = new();
    private Dictionary<decimal, string> _cachedCustomerNames = new();

    // Session Data
    private string DefaultTenant = "1011";
    private string DefaultBranch = "MAIN";
    private long LoggedInUserCode = 1;

    private long GetEffectiveUserCode()
    {
        if (LoggedInUserCode > 0 && LoggedInUserCode != 1 && LoggedInUserCode != 5) return LoggedInUserCode;
        if (TenantState?.UserCode > 0) return TenantState.UserCode;
        if (TenantState?.UserData?.UserCode.HasValue == true && TenantState.UserData.UserCode.Value > 0)
            return TenantState.UserData.UserCode.Value;
        return LoggedInUserCode > 0 ? LoggedInUserCode : 1;
    }

    // DTO / View Models
    public class RoomStockBatchDto
    {
        public long stockcode { get; set; }
        public long itemcode { get; set; }
        public string? itemname { get; set; }
        public string? batchno { get; set; }
        public DateTime? expirydate { get; set; }
        public decimal availableqty { get; set; }
        public decimal closingstock { get; set; }
        public decimal unitcost { get; set; }
        public decimal mrpunit { get; set; }
        public decimal packsize { get; set; }
    }

    public class ConsumedItemRowModel
    {
        public long consumptiondetailcode { get; set; }
        public long stockcode { get; set; }
        public long itemcode { get; set; }
        public string? itemname { get; set; }
        public string? batchno { get; set; }
        public decimal availableqty { get; set; }
        public decimal consumedqty { get; set; }
        public decimal unitcost { get; set; }
        public decimal stockvalue { get; set; }
        public int? dcode { get; set; }
        public string? doctorname { get; set; }
        public decimal? custid { get; set; }
        public string? customername { get; set; }
        public string? remarks { get; set; }

        // Row Patient Search State
        public string SearchQuery { get; set; } = "";
        public bool ShowDropdown { get; set; } = false;
        public List<CustomerModel> SearchedPatients { get; set; } = new();
    }

    public class ServiceResponse<T>
    {
        public bool success { get; set; }
        public string? message { get; set; }
        public T? data { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            if (tenantCodeResult.Success && !string.IsNullOrWhiteSpace(tenantCodeResult.Value))
            {
                DefaultTenant = tenantCodeResult.Value;
            }

            var branchCodeResult = await _sessionStorage.GetAsync<string>("branch_code");
            if (branchCodeResult.Success && !string.IsNullOrWhiteSpace(branchCodeResult.Value))
            {
                DefaultBranch = branchCodeResult.Value;
            }

            try
            {
                var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null && userResult.Value.UserCode.HasValue && userResult.Value.UserCode.Value > 0)
                {
                    LoggedInUserCode = userResult.Value.UserCode.Value;
                }
                else if (TenantState?.UserCode > 0)
                {
                    LoggedInUserCode = TenantState.UserCode;
                }
                else
                {
                    var intRes = await _sessionStorage.GetAsync<int>("usercode");
                    if (intRes.Success && intRes.Value > 0)
                    {
                        LoggedInUserCode = intRes.Value;
                    }
                }
            }
            catch { }

            await Task.WhenAll(LoadDoctorRooms(), LoadAllItems(), LoadDoctors(), LoadCustomers(), LoadConsumptionLogs());
            StateHasChanged();
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
        var effUser = GetEffectiveUserCode();
        if (effUser > 0)
        {
            client.DefaultRequestHeaders.Remove("usercode");
            client.DefaultRequestHeaders.Add("usercode", effUser.ToString());
            client.DefaultRequestHeaders.Remove("user_code");
            client.DefaultRequestHeaders.Add("user_code", effUser.ToString());
        }
        return client;
    }

    private void CloseAllPatientDropdowns()
    {
        ShowHeaderPatientDropdown = false;
        foreach (var item in ConsumedItemsList)
        {
            item.ShowDropdown = false;
        }
    }

    private string GetItemName(long itemcode, string? explicitName = null)
    {
        if (!string.IsNullOrWhiteSpace(explicitName)) return explicitName;
        var found = AllItemsList.FirstOrDefault(i => i.itemcode == itemcode);
        return found?.itemname ?? $"Item #{itemcode}";
    }

    private string GetDoctorDisplayName(DoctorMasterModel doc)
    {
        if (doc == null) return "-";
        if (!string.IsNullOrWhiteSpace(doc.doctorfullname) && !doc.doctorfullname.Trim().Equals("Self", StringComparison.OrdinalIgnoreCase))
            return doc.doctorfullname;
        
        if (!string.IsNullOrWhiteSpace(doc.name) && !doc.name.Trim().Equals("Self", StringComparison.OrdinalIgnoreCase))
        {
            string title = !string.IsNullOrWhiteSpace(doc.nametitle) ? doc.nametitle.Trim() : "Dr.";
            if (!title.EndsWith(".")) title += ".";
            return $"{title} {doc.name.Trim()}";
        }

        return $"Doctor #{doc.dcode}";
    }

    private string GetDoctorNameByCode(int? code, string? fallbackName = null)
    {
        if (!string.IsNullOrWhiteSpace(fallbackName) && fallbackName.Trim() != "-")
        {
            return fallbackName.Trim();
        }
        if (code.HasValue && code.Value > 0)
        {
            var doc = DoctorsList.FirstOrDefault(d => d.dcode == code.Value);
            if (doc != null) return GetDoctorDisplayName(doc);
            return $"Doctor #{code.Value}";
        }
        return "-";
    }

    private string GetCustomerDisplayName(CustomerModel cust)
    {
        if (cust == null) return "-";
        if (!string.IsNullOrWhiteSpace(cust.name)) return cust.name.Trim();
        if (!string.IsNullOrWhiteSpace(cust.namewithinitials)) return cust.namewithinitials.Trim();
        return $"Customer #{cust.custid}";
    }

    private string GetCustomerNameById(decimal? id, string? fallbackName = null)
    {
        if (id.HasValue && id.Value > 0)
        {
            if (_cachedCustomerNames.TryGetValue(id.Value, out var cachedName) && !string.IsNullOrWhiteSpace(cachedName) && !cachedName.StartsWith("Customer #", StringComparison.OrdinalIgnoreCase))
            {
                return cachedName;
            }

            var cust = CustomersList.FirstOrDefault(c => c.custid == id.Value);
            if (cust != null)
            {
                var dispName = GetCustomerDisplayName(cust);
                if (!string.IsNullOrWhiteSpace(dispName) && !dispName.StartsWith("Customer #", StringComparison.OrdinalIgnoreCase))
                {
                    _cachedCustomerNames[id.Value] = dispName;
                    return dispName;
                }
            }
        }

        if (!string.IsNullOrWhiteSpace(fallbackName) && fallbackName.Trim() != "-" && !fallbackName.StartsWith("Customer #", StringComparison.OrdinalIgnoreCase))
        {
            return fallbackName.Trim();
        }

        if (id.HasValue && id.Value > 0)
        {
            return $"Customer #{id.Value}";
        }

        return "-";
    }

    private string GetRowPatientDisplay(ConsumedItemRowModel item)
    {
        if (!string.IsNullOrWhiteSpace(item.SearchQuery))
        {
            return item.SearchQuery;
        }
        if (item.custid.HasValue && item.custid.Value > 0)
        {
            return !string.IsNullOrWhiteSpace(item.customername) ? $"{item.customername} (CUST-{item.custid})" : $"CUST-{item.custid}";
        }
        return "";
    }

    private IEnumerable<RoomStockBatchDto> FilteredRoomStock =>
        string.IsNullOrWhiteSpace(ItemSearchQuery)
            ? RoomStockList
            : RoomStockList.Where(r =>
                (GetItemName(r.itemcode, r.itemname).Contains(ItemSearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (r.batchno?.Contains(ItemSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    private List<consumption_master> FilteredLogs =>
        ConsumptionLogsList.Where(l =>
            (LogStoreFilter == 0 || l.roomwarehousecode == LogStoreFilter) &&
            (string.IsNullOrWhiteSpace(LogSearchQuery) ||
                (l.consumptionno?.Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.consumptioncode.ToString().Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (l.departmentname?.Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.doctorname?.Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.customername?.Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (GetDoctorNameByCode(l.dcode).Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (GetCustomerNameById(l.custid).Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (l.remarks?.Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (DoctorRoomList.FirstOrDefault(r => r.warehousecode == l.roomwarehousecode)?.warehousename?.Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (AllWarehousesList.FirstOrDefault(r => r.warehousecode == l.roomwarehousecode)?.warehousename?.Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
            )
        ).ToList();

    private void OnItemSearchInput(ChangeEventArgs e)
    {
        ItemSearchQuery = e.Value?.ToString() ?? "";
    }

    private void OnHeaderDoctorChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var docCode) && docCode > 0)
        {
            HeaderDcode = docCode;
            var doc = DoctorsList.FirstOrDefault(d => d.dcode == docCode);
            DoctorName = doc != null ? GetDoctorDisplayName(doc) : "";
        }
        else
        {
            HeaderDcode = null;
            DoctorName = "";
        }
    }

    private async Task OnHeaderPatientSearchInput(ChangeEventArgs e)
    {
        HeaderPatientSearchQuery = e.Value?.ToString() ?? "";
        _headerSearchCts?.Cancel();
        _headerSearchCts = new System.Threading.CancellationTokenSource();
        var token = _headerSearchCts.Token;

        if (string.IsNullOrWhiteSpace(HeaderPatientSearchQuery))
        {
            SearchedHeaderPatients.Clear();
            ShowHeaderPatientDropdown = false;
            HeaderCustId = null;
            CustomerName = "";
            StateHasChanged();
            return;
        }

        var query = HeaderPatientSearchQuery.Trim();
        SearchedHeaderPatients = FilterPatientsLocally(query, 12);
        ShowHeaderPatientDropdown = SearchedHeaderPatients.Count > 0;
        StateHasChanged();

        try
        {
            await Task.Delay(250, token);
            var apiList = await SearchCustomersFromApi(query, token);
            if (token.IsCancellationRequested) return;

            if (apiList.Any())
            {
                foreach (var pat in apiList)
                {
                    if (!SearchedHeaderPatients.Any(p => p.custid == pat.custid))
                    {
                        SearchedHeaderPatients.Add(pat);
                    }
                }
                ShowHeaderPatientDropdown = SearchedHeaderPatients.Count > 0;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"[DoctorConsumption] Header patient search error: {ex.Message}");
        }
    }

    private void OnHeaderPatientSearchFocus()
    {
        CloseAllPatientDropdowns();
        if (!string.IsNullOrWhiteSpace(HeaderPatientSearchQuery))
        {
            SearchedHeaderPatients = FilterPatientsLocally(HeaderPatientSearchQuery.Trim(), 12);
            ShowHeaderPatientDropdown = SearchedHeaderPatients.Count > 0;
        }
        else if (CustomersList.Any())
        {
