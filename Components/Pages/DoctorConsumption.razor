<div class="doctor-cons-main-wrapper">
    <!-- Top Header Card -->
    <div class="premium-header-card">
        <div class="header-card-left">
            <div class="header-card-icon">
                <i class="bi bi-capsule" style="font-size: 1.4rem;"></i>
            </div>
            <div class="header-card-text">
                <h2 class="header-card-heading">
                    Doctor Room Stock Consumption
                </h2>
                <div class="header-card-subheading">
                    <span class="status-dot"></span> Real-time clinical inventory audit & doctor room deduction
                </div>
            </div>
        </div>

        <div class="header-card-right d-flex align-items-center gap-2">
            <button type="button" class="btn-header-log" @onclick="OpenConsumptionLogsModal" title="View Doctor Room Consumption History Logs">
                <i class="bi bi-clock-history"></i>
                <span>Consumption Logs</span>
                @if (ConsumptionLogsList.Any())
                {
                    <span class="badge-log-count">@ConsumptionLogsList.Count</span>
                }
            </button>
        </div>
    </div>

    <!-- Edit Mode Active Alert -->
    @if (IsEditMode)
    {
        <div class="edit-mode-banner">
            <div class="edit-mode-text">
                <i class="bi bi-pencil-square" style="font-size: 1.1rem;"></i>
                <span>Currently Editing Consumption Record <strong>@(string.IsNullOrWhiteSpace(EditConsumptionNo) ? $"#{EditConsumptionCode}" : EditConsumptionNo)</strong>. You can adjust quantities and save updates.</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-dark" @onclick="CancelEditMode" style="border-radius: 8px; font-weight: 700; font-size: 0.78rem; padding: 4px 12px; background: #ffffff;">
                <i class="bi bi-x-circle me-1"></i> Cancel Edit
            </button>
        </div>
    }

    <!-- Filter & Header Master Form Card (Clean 2-Row Design) -->
    <div class="filter-card-main">
        <!-- Row 1: Date, Doctor Room Store, Department, Doctor Name -->
        <div class="filter-grid-row-1">
            <!-- Date -->
            <div class="filter-field-group">
                <label class="filter-field-label">
                    <i class="bi bi-calendar3" style="color: #6366f1;"></i> Date <span class="required-star">*</span>
                </label>
                <input type="datetime-local" class="form-control premium-cons-input" @bind="ConsumptionDate" />
            </div>

            <!-- Doctor Room / Warehouse -->
            <div class="filter-field-group">
                <label class="filter-field-label">
                    <i class="bi bi-shop" style="color: #6366f1;"></i> Doctor Room Store <span class="required-star">*</span>
                </label>
                <div style="position: relative;">
                    <select class="form-control premium-cons-input" style="appearance: none !important; padding-right: 28px;"
                            value="@SelectedRoomWarehouseCode"
                            @onchange="OnDoctorRoomChanged">
                        <option value="0">-- Select Doctor Room Store --</option>
                        @foreach (var room in DoctorRoomList)
                        {
                            <option value="@room.warehousecode">@room.warehousename @(string.IsNullOrWhiteSpace(room.location) ? "" : $"— {room.location}")</option>
                        }
                    </select>
                    <i class="bi bi-chevron-down" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b; font-size: 0.85rem;"></i>
                </div>
            </div>

            <!-- Department Name -->
            <div class="filter-field-group">
                <label class="filter-field-label">
                    <i class="bi bi-building" style="color: #6366f1;"></i> Department
                </label>
                <input type="text" class="form-control premium-cons-input" placeholder="E.g. Cardiology, OPD" @bind="DepartmentName" />
            </div>

            <!-- Doctor Name -->
            <div class="filter-field-group">
                <label class="filter-field-label">
                    <i class="bi bi-person-badge" style="color: #6366f1;"></i> Doctor Name
                </label>
                <input type="text" class="form-control premium-cons-input" placeholder="E.g. Dr. Kumar" @bind="DoctorName" />
            </div>
        </div>

        <!-- Row 2: Remarks (Wider) & Item Search Filter -->
        <div class="filter-grid-row-2">
            <!-- Remarks -->
            <div class="filter-field-group">
                <label class="filter-field-label">
                    <i class="bi bi-chat-left-text" style="color: #6366f1;"></i> Remarks / Consumption Note
                </label>
                <input type="text" class="form-control premium-cons-input" placeholder="E.g. Morning OPD clinical stock consumption, injection usage..." @bind="MasterRemarks" />
            </div>

            <!-- Item Search Filter -->
            <div class="filter-field-group">
                <label class="filter-field-label">
                    <i class="bi bi-search" style="color: #6366f1;"></i> Filter Room Stock
                </label>
                <div class="search-input-field-wrap">
                    <input type="text" class="form-control premium-cons-input"
                           placeholder="Type to search items or batches..."
                           value="@ItemSearchQuery"
                           @oninput="OnItemSearchInput" />
                    <i class="bi bi-search item-field-search-icon"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Parallel Tables: Available Room Stock vs Consumed Items -->
    <div class="parallel-tables-row">
        <!-- Left Table: Available Room Batches -->
        <div class="table-card">
            <div class="table-card-header">
                <h6>
                    <i class="bi bi-boxes" style="color: #4f46e5; font-size: 1.1rem;"></i>
                    Available Room Stock
                </h6>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-pill">
                        @FilteredRoomStock.Count() Batches
                    </span>
                    @if (SelectedRoomWarehouseCode > 0)
                    {
                        <button type="button" class="btn btn-sm btn-light p-1 px-2" @onclick="() => LoadRoomStock(SelectedRoomWarehouseCode)" title="Refresh Room Stock" style="font-size: 0.75rem; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="table-card-body">
                <table class="custom-cons-table">
                    <thead>
                        <tr>
                            <th style="text-align: left;">Item Name</th>
                            <th style="text-align: center;">Batch No</th>
                            <th style="text-align: center;">Expiry</th>
                            <th style="text-align: right;">Unit Cost</th>
                            <th style="text-align: right;">Available</th>
                            <th style="text-align: center; width: 80px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoadingRoomStock)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    <span class="ms-2 text-muted" style="font-size: 0.85rem;">Loading room stock...</span>
                                </td>
                            </tr>
                        }
                        else if (SelectedRoomWarehouseCode == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5" style="text-align: center !important;">
                                    <i class="bi bi-shop" style="font-size: 2.2rem; color: #cbd5e1; display: block; margin-bottom: 8px;"></i>
                                    Please select a Doctor Room Store from above to view available stock.
                                </td>
                            </tr>
                        }
                        else if (!FilteredRoomStock.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5" style="text-align: center !important;">
                                    <i class="bi bi-inbox" style="font-size: 2.2rem; color: #cbd5e1; display: block; margin-bottom: 8px;"></i>
                                    No stock batches found for this Doctor Room.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in FilteredRoomStock)
                            {
                                var alreadyAdded = ConsumedItemsList.Any(c => c.stockcode == row.stockcode);
                                <tr>
                                    <td style="font-weight: 600; color: #0f172a;">
                                        @GetItemName(row.itemcode, row.itemname)
                                    </td>
                                    <td style="text-align: center;">
                                        <span class="batch-badge">@(string.IsNullOrWhiteSpace(row.batchno) ? "N/A" : row.batchno)</span>
                                    </td>
                                    <td style="text-align: center; color: #64748b; font-size: 0.76rem;">
                                        @(row.expirydate.HasValue ? row.expirydate.Value.ToString("MMM yyyy") : "-")
                                    </td>
                                    <td style="text-align: right; color: #475569; font-weight: 600;">
                                        ₹@row.unitcost.ToString("N2")
                                    </td>
                                    <td style="text-align: right; font-weight: 700; color: #059669;">
                                        @row.availableqty.ToString("N0")
                                    </td>
                                    <td style="text-align: center;">
                                        @if (alreadyAdded)
                                        {
                                            <span class="badge" style="background: #e2e8f0; color: #64748b; font-size: 0.72rem; padding: 4px 8px; border-radius: 6px;">
                                                <i class="bi bi-check"></i> Added
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn-add-action" @onclick="() => AddItemToConsume(row)" title="Add to Consumption List">
                                                <i class="bi bi-plus-circle-fill"></i> <span>Add</span>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="table-card-footer">
                <span style="font-weight: 600; color: #64748b;">Available Batches: <strong>@FilteredRoomStock.Count()</strong></span>
                <div>
                    <span style="color: #059669; font-weight: 700;">
                        Total Stock: @FilteredRoomStock.Sum(r => r.availableqty).ToString("N0")
                    </span>
                </div>
            </div>
        </div>

        <!-- Right Column: Consumed Items Table & Actions -->
        <div class="right-cons-column">
            <div class="table-card">
                <div class="table-card-header">
                    <h6>
                        <i class="bi bi-cart-dash" style="color: #059669; font-size: 1.1rem;"></i>
                        Items to Consume
                    </h6>
                    <span class="badge-pill badge-pill-success">
                        @ConsumedItemsList.Count Items Selected
                    </span>
                </div>
                <div class="table-card-body">
                    <table class="custom-cons-table">
                        <thead>
                            <tr>
                                <th style="text-align: left;">Item Name</th>
                                <th style="text-align: center;">Batch</th>
                                <th style="text-align: right;">Avail</th>
                                <th style="text-align: center; width: 120px;">Consumed Qty</th>
                                <th style="text-align: right;">Unit Cost</th>
                                <th style="text-align: right;">Value</th>
                                <th style="text-align: center; width: 60px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ConsumedItemsList.Any())
                            {
                                @foreach (var item in ConsumedItemsList)
                                {
                                    <tr>
                                        <td style="font-weight: 600; color: #0f172a;">
                                            @GetItemName(item.itemcode, item.itemname)
                                        </td>
                                        <td style="text-align: center;">
                                            <span class="batch-badge">@(string.IsNullOrWhiteSpace(item.batchno) ? "N/A" : item.batchno)</span>
                                        </td>
                                        <td style="text-align: right; color: #64748b; font-weight: 600;">
                                            @item.availableqty.ToString("N0")
                                        </td>
                                        <td style="text-align: center;">
                                            <div class="qty-stepper-wrapper">
                                                <button type="button" class="btn-stepper btn-minus" @onclick="() => DecrementConsumedQty(item, 1)" title="-1">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <input type="number" step="1" min="1" max="@item.availableqty" class="stepper-input"
                                                       @bind="item.consumedqty"
                                                       @bind:event="oninput"
                                                       @onchange="() => RecalculateItemValue(item)" />
                                                <button type="button" class="btn-stepper btn-plus" @onclick="() => IncrementConsumedQty(item, 1)" title="+1">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td style="text-align: right; color: #475569;">
                                            ₹@item.unitcost.ToString("N2")
                                        </td>
                                        <td style="text-align: right; font-weight: 700; color: #4338ca;">
                                            ₹@item.stockvalue.ToString("N2")
                                        </td>
                                        <td style="text-align: center;">
                                            <button type="button" class="btn-remove-action" @onclick="() => RemoveConsumedItem(item)" title="Remove item">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-5" style="text-align: center !important;">
                                        <i class="bi bi-capsule" style="font-size: 2.2rem; color: #cbd5e1; display: block; margin-bottom: 8px;"></i>
                                        Click <strong>"+ Add"</strong> on any available batch from the left table to record consumption.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="table-card-footer">
                    <span style="color: #64748b;">
                        Total Items: <strong style="color: #1e293b; margin-left: 4px;">@ConsumedItemsList.Count</strong>
                        | Total Qty: <strong style="color: #4338ca; margin-left: 4px;">@ConsumedItemsList.Sum(c => c.consumedqty).ToString("N0")</strong>
                    </span>
                    <span style="font-weight: 700; color: #1e1b4b; font-size: 0.9rem;">
                        Total Value: <span style="color: #059669;">₹@ConsumedItemsList.Sum(c => c.stockvalue).ToString("N2")</span>
                    </span>
                </div>
            </div>

            <!-- Action Buttons below the Consumed Items Table -->
            @if (ConsumedItemsList.Any())
            {
                <div style="display: flex; justify-content: flex-end; align-items: center; gap: 12px; margin-top: 6px; width: 100%;">
                    <button type="button" class="btn-cancel-modal" @onclick="ResetForm" style="background: #ffffff; color: #334155; border: 1.5px solid #cbd5e1; padding: 0.55rem 1.6rem; border-radius: 10px; font-weight: 700; font-size: 0.85rem; transition: all 0.2s; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
                        Reset
                    </button>
                    <button type="button" class="btn-save-premium" @onclick="SaveDoctorConsumption" disabled="@IsSaving" style="min-width: 190px; height: 42px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; border-radius: 10px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; font-weight: 700; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3); transition: all 0.2s; cursor: pointer;">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Saving Consumption...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                            <span>@(IsEditMode ? "Update Consumption" : "Save Consumption")</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- =========================================================
     DOCTOR CONSUMPTION LOGS MODAL (High Fidelity & Full Width)
     ========================================================= -->
@if (ShowLogsModal)
{
    <div class="log-modal-backdrop" @onclick="CloseConsumptionLogsModal"></div>
    <div class="log-modal-dialog">
        <!-- Modal Header -->
        <div class="log-modal-header">
            <div class="header-card-left">
                <div class="header-card-icon" style="width: 42px; height: 42px;">
                    <i class="bi bi-clock-history" style="font-size: 1.25rem;"></i>
                </div>
                <div class="header-card-text">
                    <div class="return-log-title-row">
                        <h4 style="font-size: 1.1rem; font-weight: 800; color: #1e293b; margin: 0; line-height: 1.2;">Doctor Room Consumption History Logs</h4>
                        <span class="return-log-count-badge">Total: @FilteredLogs.Count</span>
                    </div>
                    <span style="font-size: 0.74rem; color: #64748b; font-weight: 500; margin-top: 2px;">Audit trail of all clinical doctor room stock deductions</span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="button" class="return-refresh-btn" @onclick="LoadConsumptionLogs" disabled="@IsLoadingLogs">
                    <i class="bi bi-arrow-clockwise @(IsLoadingLogs ? "spin" : "")"></i>
                    <span>Refresh</span>
                </button>
                <button type="button" class="btn-close ms-2" @onclick="CloseConsumptionLogsModal" aria-label="Close"></button>
            </div>
        </div>

        <!-- Search and Filter Bar -->
        <div style="padding: 12px 24px; border-bottom: 1px solid #f1f5f9; background: #ffffff; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <div class="return-search-wrapper" style="width: 360px;">
                <input type="text" class="return-search-input" placeholder="Search by Doctor, Department, Store, Log #..."
                       value="@LogSearchQuery"
                       @oninput="(e) => { LogSearchQuery = e.Value?.ToString() ?? string.Empty; StateHasChanged(); }" />
                <i class="bi bi-search return-search-icon"></i>
                @if (!string.IsNullOrEmpty(LogSearchQuery))
                {
                    <i class="bi bi-x-circle-fill return-search-clear" @onclick='() => { LogSearchQuery = ""; StateHasChanged(); }'></i>
                }
            </div>

            <div class="d-flex align-items-center gap-2">
                <label style="font-size: 0.76rem; font-weight: 700; color: #475569; margin: 0; text-transform: uppercase;">Store:</label>
                <select class="form-select form-select-sm" style="height: 36px; font-size: 0.8rem; border-radius: 8px; border: 1px solid #cbd5e1; min-width: 180px;"
                        value="@LogStoreFilter"
                        @onchange="(e) => { LogStoreFilter = long.TryParse(e.Value?.ToString(), out var v) ? v : 0; StateHasChanged(); }">
                    <option value="0">All Stores</option>
                    @foreach (var room in DoctorRoomList)
                    {
                        <option value="@room.warehousecode">@room.warehousename</option>
                    }
                </select>
            </div>
        </div>

        <!-- Modal Body Table -->
        <div class="log-modal-body">
            @if (IsLoadingLogs)
            {
                <div class="text-center py-5 text-muted" style="text-align: center !important;">
                    <div class="spinner-border text-primary" role="status" style="width: 2.2rem; height: 2.2rem;"></div>
                    <p class="mt-2 text-muted" style="font-size: 0.85rem;">Loading consumption history logs...</p>
                </div>
            }
            else if (!FilteredLogs.Any())
            {
                <div class="text-center py-5" style="background: #f8fafc; border-radius: 12px; border: 1px dashed #cbd5e1; margin: 20px; text-align: center !important;">
                    <i class="bi bi-inbox" style="font-size: 2.5rem; color: #94a3b8;"></i>
                    <h5 class="mt-2" style="font-size: 0.95rem; font-weight: 700; color: #475569;">No Doctor Room Consumption Logs Found</h5>
                    <p class="text-muted mb-0" style="font-size: 0.8rem;">There are no consumption records matching the selected search criteria.</p>
                </div>
            }
            else
            {
                <table class="custom-cons-table mb-0">
                    <thead>
                        <tr>
                            <th style="width: 65px; text-align: center;">LOG #</th>
                            <th style="text-align: center;">DATE & TIME</th>
                            <th style="text-align: left;">DOCTOR ROOM STORE</th>
                            <th style="text-align: left;">DEPARTMENT</th>
                            <th style="text-align: left;">DOCTOR NAME</th>
                            <th style="text-align: right;">ITEMS</th>
                            <th style="text-align: right;">TOTAL QTY</th>
                            <th style="text-align: right;">TOTAL VALUE</th>
                            <th style="text-align: left;">REMARKS</th>
                            <th style="text-align: center; width: 110px;">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in FilteredLogs)
                        {
                            var roomName = DoctorRoomList.FirstOrDefault(r => r.warehousecode == log.roomwarehousecode)?.warehousename
                                           ?? (log.roomwarehousecode > 0 ? $"Store #{log.roomwarehousecode}" : "N/A");
                            <tr>
                                <td style="text-align: center; font-weight: 700; color: #4f46e5;">
                                    @(string.IsNullOrWhiteSpace(log.consumptionno) ? $"#{log.consumptioncode}" : log.consumptionno)
                                </td>
                                <td style="text-align: center; color: #475569; font-size: 0.78rem;">
                                    @(log.consumptiondate != default ? log.consumptiondate.ToString("dd-MM-yyyy HH:mm") : log.createddate.ToString("dd-MM-yyyy"))
                                </td>
                                <td style="font-weight: 600; color: #0f172a;">
                                    <i class="bi bi-shop text-primary me-1"></i> @roomName
                                </td>
                                <td style="color: #334155;">
                                    @(string.IsNullOrWhiteSpace(log.departmentname) ? "-" : log.departmentname)
                                </td>
                                <td style="color: #1e1b4b; font-weight: 600;">
                                    <i class="bi bi-person text-secondary me-1"></i> @(string.IsNullOrWhiteSpace(log.doctorname) ? "-" : log.doctorname)
                                </td>
                                <td style="text-align: right; color: #475569; font-weight: 600;">
                                    @log.totalitems.ToString("N0")
                                </td>
                                <td style="text-align: right; font-weight: 700; color: #059669;">
                                    @log.totalqty.ToString("N0")
                                </td>
                                <td style="text-align: right; font-weight: 700; color: #4338ca;">
                                    ₹@log.totalvalue.ToString("N2")
                                </td>
                                <td style="color: #64748b; font-size: 0.78rem; max-width: 150px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                    @(string.IsNullOrWhiteSpace(log.remarks) ? "-" : log.remarks)
                                </td>
                                <td style="text-align: center;">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" class="btn btn-sm" @onclick="() => EditConsumptionRecord(log)" title="Edit this consumption" style="border: 1px solid #c7d2fe; background: #eef2ff; color: #4338ca; border-radius: 6px; padding: 2px 8px; font-size: 0.75rem; font-weight: 600;">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </button>
                                        <button type="button" class="btn btn-sm" @onclick="() => PromptDeleteConsumption(log)" title="Delete this consumption" style="border: 1px solid #fecaca; background: #fef2f2; color: #dc2626; border-radius: 6px; padding: 2px 8px; font-size: 0.75rem; font-weight: 600;">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Modal Footer -->
        <div class="log-modal-footer">
            <div style="font-size: 0.8rem; color: #64748b; font-weight: 500;">
                Showing <strong>@FilteredLogs.Count</strong> of <strong>@ConsumptionLogsList.Count</strong> consumption logs
            </div>
            <button type="button" class="btn-cancel-modal" @onclick="CloseConsumptionLogsModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.45rem 1.4rem; border-radius: 10px; font-weight: 700; cursor: pointer;">
                Close
            </button>
        </div>
    </div>
}

<!-- Delete Confirmation Popup -->
@if (ShowDeleteConfirmModal && PendingDeleteLog != null)
{
    <div class="action-popup-overlay" @onclick="CancelDelete">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Consumption Record</div>
            <div class="action-popup-body">
                Are you sure you want to delete consumption record <strong>@(string.IsNullOrWhiteSpace(PendingDeleteLog.consumptionno) ? $"#{PendingDeleteLog.consumptioncode}" : PendingDeleteLog.consumptionno)</strong>?
                <br /><small class="text-danger mt-1 d-block">This action will revert the consumed stock deductions.</small>
            </div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" disabled="@IsDeleting" @onclick="ConfirmDeleteConsumption">
                    @if (IsDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    <span>Delete</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    // Top Master Form State
    private DateTime ConsumptionDate = DateTime.Now;
    private long SelectedRoomWarehouseCode = 0;
    private string DepartmentName = "";
    private string DoctorName = "";
    private string MasterRemarks = "";
    private string ItemSearchQuery = "";

    // Edit Mode State
    private bool IsEditMode = false;
    private long EditConsumptionCode = 0;
    private string? EditConsumptionNo = null;

    // Loading / Saving states
    private bool IsLoadingRoomStock = false;
    private bool IsSaving = false;
    private bool IsLoadingLogs = false;
    private bool IsDeleting = false;

    // Modals
    private bool ShowLogsModal = false;
    private bool ShowDeleteConfirmModal = false;
    private consumption_master? PendingDeleteLog = null;
    private string LogSearchQuery = "";
    private long LogStoreFilter = 0;

    // Data Collections
    private List<warehouse_master> DoctorRoomList = new();
    private List<inventory_item_master> AllItemsList = new();
    private List<RoomStockBatchDto> RoomStockList = new();
    private List<ConsumedItemRowModel> ConsumedItemsList = new();
    private List<consumption_master> ConsumptionLogsList = new();

    // Session Data
    private string DefaultTenant = "1011";
    private string DefaultBranch = "MAIN";
    private long LoggedInUserCode = 5;

    // DTO / View Models
    public class RoomStockBatchDto
    {
        public long stockcode { get; set; }
        public long itemcode { get; set; }
        public string? itemname { get; set; }
        public string? batchno { get; set; }
        public DateTime? expirydate { get; set; }
        public decimal availableqty { get; set; }
        public decimal closingstock { get; set; }
        public decimal unitcost { get; set; }
        public decimal mrpunit { get; set; }
        public decimal packsize { get; set; }
    }

    public class ConsumedItemRowModel
    {
        public long consumptiondetailcode { get; set; }
        public long stockcode { get; set; }
        public long itemcode { get; set; }
        public string? itemname { get; set; }
        public string? batchno { get; set; }
        public decimal availableqty { get; set; }
        public decimal consumedqty { get; set; }
        public decimal unitcost { get; set; }
        public decimal stockvalue { get; set; }
        public string? remarks { get; set; }
    }

    public class ServiceResponse<T>
    {
        public bool success { get; set; }
        public string? message { get; set; }
        public T? data { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            if (tenantCodeResult.Success && !string.IsNullOrWhiteSpace(tenantCodeResult.Value))
            {
                DefaultTenant = tenantCodeResult.Value;
            }

            var branchCodeResult = await _sessionStorage.GetAsync<string>("branch_code");
            if (branchCodeResult.Success && !string.IsNullOrWhiteSpace(branchCodeResult.Value))
            {
                DefaultBranch = branchCodeResult.Value;
            }

            try
            {
                var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null && userResult.Value.UserCode.HasValue && userResult.Value.UserCode.Value > 0)
                {
                    LoggedInUserCode = userResult.Value.UserCode.Value;
                }
                else
                {
                    var intRes = await _sessionStorage.GetAsync<int>("usercode");
                    if (intRes.Success && intRes.Value > 0)
                    {
                        LoggedInUserCode = intRes.Value;
                    }
                }
            }
            catch { }

            await Task.WhenAll(LoadDoctorRooms(), LoadAllItems(), LoadConsumptionLogs());
            StateHasChanged();
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
        return client;
    }

    private string GetItemName(long itemcode, string? explicitName = null)
    {
        if (!string.IsNullOrWhiteSpace(explicitName)) return explicitName;
        var found = AllItemsList.FirstOrDefault(i => i.itemcode == itemcode);
        return found?.itemname ?? $"Item #{itemcode}";
    }

    private IEnumerable<RoomStockBatchDto> FilteredRoomStock =>
        string.IsNullOrWhiteSpace(ItemSearchQuery)
            ? RoomStockList
            : RoomStockList.Where(r =>
                (GetItemName(r.itemcode, r.itemname).Contains(ItemSearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (r.batchno?.Contains(ItemSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    private List<consumption_master> FilteredLogs =>
        ConsumptionLogsList.Where(l =>
            (LogStoreFilter == 0 || l.roomwarehousecode == LogStoreFilter) &&
            (string.IsNullOrWhiteSpace(LogSearchQuery) ||
                (l.consumptionno?.Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.consumptioncode.ToString().Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (l.departmentname?.Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.doctorname?.Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.remarks?.Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (DoctorRoomList.FirstOrDefault(r => r.warehousecode == l.roomwarehousecode)?.warehousename?.Contains(LogSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
            )
        ).ToList();

