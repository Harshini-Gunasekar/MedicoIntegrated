    private async Task SaveDoctorConsumption()
    {
        if (SelectedRoomWarehouseCode <= 0)
        {
            ToastService.ShowWarning("Please select a Doctor Room Store.");
            return;
        }

        if (!ConsumedItemsList.Any())
        {
            ToastService.ShowWarning("Please add at least one item to consume.");
            return;
        }

        // Validate consumption quantities
        foreach (var item in ConsumedItemsList)
        {
            if (item.consumedqty <= 0)
            {
                ToastService.ShowWarning($"Consumed quantity for {item.itemname} must be greater than 0.");
                return;
            }
            if (item.consumedqty > item.availableqty && !IsEditMode)
            {
                ToastService.ShowWarning($"Consumed quantity for {item.itemname} exceeds available stock ({item.availableqty}).");
                return;
            }
        }

        IsSaving = true;
        try
        {
            var client = CreateClient();

            // Determine doctor and customer defaults
            var effectiveDcode = HeaderDcode ?? ConsumedItemsList.FirstOrDefault(c => c.dcode.HasValue && c.dcode.Value > 0)?.dcode;
            var effectiveDoctorName = !string.IsNullOrWhiteSpace(DoctorName) ? DoctorName : (ConsumedItemsList.FirstOrDefault(c => !string.IsNullOrWhiteSpace(c.doctorname))?.doctorname ?? "");
            var effectiveCustId = HeaderCustId ?? ConsumedItemsList.FirstOrDefault(c => c.custid.HasValue && c.custid.Value > 0)?.custid;
            var effectiveCustomerName = !string.IsNullOrWhiteSpace(CustomerName) ? CustomerName : (ConsumedItemsList.FirstOrDefault(c => !string.IsNullOrWhiteSpace(c.customername))?.customername ?? "");

            // Prepare Master
            var masterPayload = new consumption_master
            {
                consumptioncode = IsEditMode ? EditConsumptionCode : 0,
                consumptionno = IsEditMode ? EditConsumptionNo : null,
                consumptiondate = ConsumptionDate,
                roomwarehousecode = SelectedRoomWarehouseCode,
                departmentname = DepartmentName ?? "",
                dcode = effectiveDcode,
                doctorname = effectiveDoctorName,
                custid = effectiveCustId,
                customername = effectiveCustomerName,
                remarks = MasterRemarks ?? "",
                totalitems = ConsumedItemsList.Count,
                totalqty = ConsumedItemsList.Sum(c => c.consumedqty),
                totalvalue = ConsumedItemsList.Sum(c => c.stockvalue),
                usercode = GetEffectiveUserCode(),
                branchcode = DefaultBranch,
                tenantcode = DefaultTenant,
                isactive = true,
                deleted = false,
                createddate = DateTime.Now
            };

            // Prepare Details
            var detailsPayload = ConsumedItemsList.Select(c => new consumption_detail
            {
                consumptiondetailcode = c.consumptiondetailcode,
                consumptioncode = IsEditMode ? EditConsumptionCode : 0,
                stockcode = c.stockcode,
                itemcode = c.itemcode,
                batchno = c.batchno ?? "",
                availableqty = c.availableqty,
                consumedqty = c.consumedqty,
                unitcost = c.unitcost,
                stockvalue = c.stockvalue,
                dcode = (c.dcode.HasValue && c.dcode.Value > 0) ? c.dcode : effectiveDcode,
                doctorname = !string.IsNullOrWhiteSpace(c.doctorname) ? c.doctorname : effectiveDoctorName,
                custid = (c.custid.HasValue && c.custid.Value > 0) ? c.custid : effectiveCustId,
                customername = !string.IsNullOrWhiteSpace(c.customername) ? c.customername : effectiveCustomerName,
                remarks = c.remarks ?? "",
                tenantcode = DefaultTenant
            }).ToList();

            var reqPayload = new consumption_request
            {
                master = masterPayload,
                details = detailsPayload
            };

            var endpoint = IsEditMode ? "api/ItemMaster/updateconsumption" : "api/ItemMaster/insertconsumption";
            var response = await client.PostAsJsonAsync(endpoint, reqPayload);

            if (response.IsSuccessStatusCode)
            {
                var successMsg = IsEditMode ? "Consumption record updated successfully." : "Consumption recorded successfully.";
                ToastService.ShowSuccess(successMsg);

                // Reload Room Stock and Logs
                await Task.WhenAll(LoadRoomStock(SelectedRoomWarehouseCode), LoadConsumptionLogs());
                ResetForm();
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to save consumption: {errorText}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"An error occurred while saving: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

