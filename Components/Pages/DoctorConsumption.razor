    private async Task LoadConsumptionLogs()
    {
        IsLoadingLogs = true;
        StateHasChanged();
        try
        {
            var client = CreateClient();
            var resp = await client.GetStringAsync("api/ItemMaster/getallconsumption");
            ConsumptionLogsList = ParseConsumptionLogs(resp);

            foreach (var log in ConsumptionLogsList)
            {
                if (log.custid.HasValue && log.custid.Value > 0)
                {
                    if (!string.IsNullOrWhiteSpace(log.customername) && !log.customername.StartsWith("Customer #", StringComparison.OrdinalIgnoreCase))
                    {
                        _cachedCustomerNames[log.custid.Value] = log.customername.Trim();
                    }
                    else
                    {
                        var match = CustomersList.FirstOrDefault(c => c.custid == log.custid.Value);
                        if (match != null && !string.IsNullOrWhiteSpace(match.name))
                        {
                            _cachedCustomerNames[log.custid.Value] = match.name.Trim();
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading consumption logs: {ex.Message}");
            ConsumptionLogsList = new();
        }
        finally
        {
            IsLoadingLogs = false;
            await InvokeAsync(StateHasChanged);
        }

        _ = ResolveMissingCustomerNamesAsync(ConsumptionLogsList);
    }

    private async Task ResolveMissingCustomerNamesAsync(List<consumption_master> logs)
    {
        try
        {
            var effectiveTenant = !string.IsNullOrEmpty(DefaultTenant) ? DefaultTenant : (TenantState?.TenantCode ?? "");
            var effectiveToken = TenantState?.AuthToken;

            var missingCustIds = logs
                .Where(l => l.custid.HasValue && l.custid.Value > 0)
                .Select(l => l.custid!.Value)
                .Distinct()
                .Where(id => (!_cachedCustomerNames.ContainsKey(id) || _cachedCustomerNames[id].StartsWith("Customer #", StringComparison.OrdinalIgnoreCase))
                             && !CustomersList.Any(c => c.custid == id && !string.IsNullOrWhiteSpace(c.name)))
                .ToList();

            if (!missingCustIds.Any()) return;

            bool anyUpdated = false;
            foreach (var custId in missingCustIds)
            {
                var fetchedName = await FetchCustomerNameByIdFromApi(custId, effectiveTenant, effectiveToken);
                if (!string.IsNullOrWhiteSpace(fetchedName))
                {
                    _cachedCustomerNames[custId] = fetchedName;
                    anyUpdated = true;
                }
            }

            if (anyUpdated)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DoctorConsumption] Error resolving missing customer names: {ex.Message}");
        }
    }

    private async Task<string?> FetchCustomerNameByIdFromApi(decimal custId, string tenantCode, string? token)
    {
        var clients = new[] { "LabCareUrl", "DoctorApi" };
        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

        foreach (var clientName in clients)
        {
            try
            {
                var client = ClientFactory.CreateClient(clientName);
                if (!string.IsNullOrEmpty(tenantCode))
                {
                    client.DefaultRequestHeaders.Remove("tenant_code");
                    client.DefaultRequestHeaders.Add("tenant_code", tenantCode);
                    client.DefaultRequestHeaders.Remove("tenantcode");
                    client.DefaultRequestHeaders.Add("tenantcode", tenantCode);
                }
                if (!string.IsNullOrEmpty(token))
                {
                    client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                }

                // 1. Try search by custId
                var searchUrl = $"api/Customer/search?key={custId}";
                var response = await client.GetAsync(searchUrl);
                if (response.IsSuccessStatusCode)
                {
                    var raw = await response.Content.ReadAsStringAsync();
                    if (!string.IsNullOrWhiteSpace(raw))
                    {
                        List<CustomerModel>? list = null;
                        try
                        {
                            list = JsonSerializer.Deserialize<List<CustomerModel>>(raw, options);
                        }
                        catch
                        {
                            var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<CustomerModel>>>(raw, options);
                            list = wrapped?.data;
                        }

                        var match = list?.FirstOrDefault(c => c.custid == custId);
                        if (match != null && !string.IsNullOrWhiteSpace(match.name))
                        {
                            if (!CustomersList.Any(c => c.custid == match.custid))
                            {
                                CustomersList.Add(match);
                            }
                            return match.name.Trim();
                        }
                    }
                }

                // 2. Try get by custid
                var getUrl = $"api/Customer/get?custid={custId}";
                var getResp = await client.GetAsync(getUrl);
                if (getResp.IsSuccessStatusCode)
                {
                    var raw = await getResp.Content.ReadAsStringAsync();
                    if (!string.IsNullOrWhiteSpace(raw))
                    {
                        CustomerModel? custObj = null;
                        try
                        {
                            custObj = JsonSerializer.Deserialize<CustomerModel>(raw, options);
                        }
                        catch
                        {
                            var list = JsonSerializer.Deserialize<List<CustomerModel>>(raw, options);
                            custObj = list?.FirstOrDefault(c => c.custid == custId);
                        }

                        if (custObj != null && !string.IsNullOrWhiteSpace(custObj.name))
                        {
                            if (!CustomersList.Any(c => c.custid == custObj.custid))
                            {
                                CustomersList.Add(custObj);
                            }
                            return custObj.name.Trim();
                        }
                    }
                }
            }
            catch { }
        }
        return null;
    }

    private List<consumption_master> ParseConsumptionLogs(string json)
    {
        var resultList = new List<consumption_master>();
        if (string.IsNullOrWhiteSpace(json)) return resultList;

        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            JsonElement arrayElement = root;
            if (root.ValueKind == JsonValueKind.Object)
            {
                if (root.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == JsonValueKind.Array)
                {
                    arrayElement = dataProp;
                }
                else if (root.TryGetProperty("master", out var masterProp) && masterProp.ValueKind == JsonValueKind.Array)
                {
                    arrayElement = masterProp;
                }
                else if (root.TryGetProperty("result", out var resProp) && resProp.ValueKind == JsonValueKind.Array)
                {
                    arrayElement = resProp;
                }
                else if (root.TryGetProperty("consumptions", out var consProp) && consProp.ValueKind == JsonValueKind.Array)
                {
                    arrayElement = consProp;
                }
            }

            if (arrayElement.ValueKind == JsonValueKind.Array)
            {
                foreach (var elem in arrayElement.EnumerateArray())
                {
                    JsonElement masterObj = elem;
                    if (elem.ValueKind == JsonValueKind.Object && elem.TryGetProperty("master", out var mObj) && mObj.ValueKind == JsonValueKind.Object)
                    {
                        masterObj = mObj;
                    }

                    var master = new consumption_master();

                    try
                    {
                        var des = JsonSerializer.Deserialize<consumption_master>(masterObj.GetRawText(), options);
                        if (des != null) master = des;
                    }
                    catch { }

                    if (master.consumptioncode == 0)
                    {
                        master.consumptioncode = GetLong(masterObj, "consumptioncode", "consumption_code", "code", "id", "consumptionId");
                    }
                    if (string.IsNullOrWhiteSpace(master.consumptionno))
                    {
                        master.consumptionno = GetString(masterObj, "consumptionno", "consumption_no", "docno", "no");
                    }
                    if (master.consumptiondate == default)
                    {
                        master.consumptiondate = GetDateTime(masterObj, "consumptiondate", "consumption_date", "date", "createddate");
                    }
                    if (master.roomwarehousecode == 0)
                    {
                        master.roomwarehousecode = GetLong(masterObj, "roomwarehousecode", "roomwarehouse_code", "warehousecode", "roomcode", "storecode");
                    }
                    if (string.IsNullOrWhiteSpace(master.departmentname))
                    {
                        master.departmentname = GetString(masterObj, "departmentname", "department_name", "department", "deptname");
                    }
                    if (master.dcode == null || master.dcode == 0)
                    {
                        var dc = GetLong(masterObj, "dcode", "doctor_code", "doctorcode", "doccode");
                        if (dc == 0) dc = GetLong(elem, "dcode", "doctor_code", "doctorcode", "doccode");
                        if (dc > 0) master.dcode = (int)dc;
                    }
                    if (string.IsNullOrWhiteSpace(master.doctorname))
                    {
                        var dn = GetString(masterObj, "doctorname", "doctor_name", "doctor", "docname");
                        if (string.IsNullOrWhiteSpace(dn)) dn = GetString(elem, "doctorname", "doctor_name", "doctor", "docname");
                        if (!string.IsNullOrWhiteSpace(dn)) master.doctorname = dn;
                    }
                    if (master.custid == null || master.custid == 0)
                    {
                        var ci = GetDecimal(masterObj, "custid", "customer_id", "customerid", "patient_id", "patientid", "cust_id", "patid", "patientcode", "custcode");
                        if (ci == 0) ci = GetDecimal(elem, "custid", "customer_id", "customerid", "patient_id", "patientid", "cust_id", "patid", "patientcode", "custcode");
                        if (ci > 0) master.custid = ci;
                    }
                    if (string.IsNullOrWhiteSpace(master.customername))
                    {
                        var cn = GetString(masterObj, "customername", "customer_name", "custname", "patient_name", "patientname", "patname", "name", "client_name", "clientname");
                        if (string.IsNullOrWhiteSpace(cn)) cn = GetString(elem, "customername", "customer_name", "custname", "patient_name", "patientname", "patname", "name", "client_name", "clientname");
                        if (!string.IsNullOrWhiteSpace(cn)) master.customername = cn;
                    }
                    if (string.IsNullOrWhiteSpace(master.remarks))
                    {
                        master.remarks = GetString(masterObj, "remarks", "remark", "note", "notes", "description");
                    }

                    if (elem.ValueKind == JsonValueKind.Object && elem.TryGetProperty("details", out var detailsElem) && detailsElem.ValueKind == JsonValueKind.Array)
                    {
                        decimal calcQty = 0;
                        decimal calcVal = 0;
                        int count = 0;
                        foreach (var d in detailsElem.EnumerateArray())
                        {
                            count++;
                            calcQty += GetDecimal(d, "consumedqty", "consumed_qty", "qty", "quantity");
                            calcVal += GetDecimal(d, "stockvalue", "stock_value", "totalvalue", "value");

                            if ((master.custid == null || master.custid == 0))
                            {
                                var dCustId = GetDecimal(d, "custid", "customer_id", "customerid", "patient_id", "patientid", "cust_id", "patid");
                                if (dCustId > 0) master.custid = dCustId;
                            }
                            if (string.IsNullOrWhiteSpace(master.customername))
                            {
                                var dCustName = GetString(d, "customername", "customer_name", "custname", "patient_name", "patientname", "patname", "name");
                                if (!string.IsNullOrWhiteSpace(dCustName)) master.customername = dCustName;
                            }
                            if (master.dcode == null || master.dcode == 0)
                            {
                                var dDoc = GetLong(d, "dcode", "doctor_code", "doctorcode");
                                if (dDoc > 0) master.dcode = (int)dDoc;
                            }
                            if (string.IsNullOrWhiteSpace(master.doctorname))
                            {
                                var dDocName = GetString(d, "doctorname", "doctor_name", "doctor", "docname");
                                if (!string.IsNullOrWhiteSpace(dDocName)) master.doctorname = dDocName;
                            }
                        }
                        if (master.totalitems == 0 && count > 0) master.totalitems = count;
                        if (master.totalqty == 0 && calcQty > 0) master.totalqty = calcQty;
                        if (master.totalvalue == 0 && calcVal > 0) master.totalvalue = calcVal;
                    }

                    if (master.totalitems == 0)
                    {
                        master.totalitems = GetDecimal(masterObj, "totalitems", "total_items", "itemscount");
                    }
                    if (master.totalqty == 0)
                    {
                        master.totalqty = GetDecimal(masterObj, "totalqty", "total_qty", "consumedqty");
                    }
                    if (master.totalvalue == 0)
                    {
                        master.totalvalue = GetDecimal(masterObj, "totalvalue", "total_value", "amount", "totalamount");
                    }

                    resultList.Add(master);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing consumption logs: {ex.Message}");
        }

        return resultList.Where(l => !l.deleted).OrderByDescending(l => l.consumptiondate).ThenByDescending(l => l.consumptioncode).ToList();
    }

    private async Task EditConsumptionRecord(consumption_master log)
    {
        try
        {
            CloseConsumptionLogsModal();

            IsEditMode = true;
            EditConsumptionCode = log.consumptioncode;
            EditConsumptionNo = log.consumptionno;
            ConsumptionDate = log.consumptiondate != default ? log.consumptiondate : log.createddate;
            SelectedRoomWarehouseCode = log.roomwarehousecode;
            DepartmentName = log.departmentname ?? "";
            HeaderDcode = log.dcode;
            DoctorName = log.doctorname ?? (log.dcode.HasValue ? GetDoctorNameByCode(log.dcode) : "");
            HeaderCustId = log.custid;
            CustomerName = log.customername ?? (log.custid.HasValue ? GetCustomerNameById(log.custid) : "");
            HeaderPatientSearchQuery = log.custid.HasValue && log.custid.Value > 0
                ? (!string.IsNullOrWhiteSpace(CustomerName) ? $"{CustomerName} (CUST-{log.custid})" : $"CUST-{log.custid}")
                : CustomerName;
            MasterRemarks = log.remarks ?? "";

            var client = CreateClient();
            var resp = await client.GetStringAsync($"api/ItemMaster/getconsumptionbycode?consumptioncode={log.consumptioncode}");

            var detailsList = ParseConsumptionDetails(resp);
            if (detailsList.Any())
            {
                foreach (var item in detailsList)
                {
                    if (!item.dcode.HasValue && HeaderDcode.HasValue) item.dcode = HeaderDcode;
                    if (string.IsNullOrWhiteSpace(item.doctorname) && !string.IsNullOrWhiteSpace(DoctorName)) item.doctorname = DoctorName;
                    if (!item.custid.HasValue && HeaderCustId.HasValue) item.custid = HeaderCustId;
                    if (string.IsNullOrWhiteSpace(item.customername) && !string.IsNullOrWhiteSpace(CustomerName)) item.customername = CustomerName;
                    item.SearchQuery = item.custid.HasValue && item.custid.Value > 0
                        ? (!string.IsNullOrWhiteSpace(item.customername) ? $"{item.customername} (CUST-{item.custid})" : $"CUST-{item.custid}")
                        : (item.customername ?? "");
                }
                ConsumedItemsList = detailsList;
            }
            else
            {
                ConsumedItemsList.Clear();
            }

            await LoadRoomStock(SelectedRoomWarehouseCode);
            ToastService.ShowInfo($"Loaded consumption record #{log.consumptioncode} for editing.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load record details: {ex.Message}");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private List<ConsumedItemRowModel> ParseConsumptionDetails(string json)
    {
        var resultList = new List<ConsumedItemRowModel>();
        if (string.IsNullOrWhiteSpace(json)) return resultList;

        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            JsonElement detailsArray = default;
            if (root.ValueKind == JsonValueKind.Array)
            {
                detailsArray = root;
            }
            else if (root.ValueKind == JsonValueKind.Object)
            {
                if (root.TryGetProperty("details", out var dProp) && dProp.ValueKind == JsonValueKind.Array)
                {
                    detailsArray = dProp;
                }
                else if (root.TryGetProperty("data", out var dataProp))
                {
                    if (dataProp.ValueKind == JsonValueKind.Array)
                    {
                        detailsArray = dataProp;
                    }
                    else if (dataProp.ValueKind == JsonValueKind.Object && dataProp.TryGetProperty("details", out var innerDetails) && innerDetails.ValueKind == JsonValueKind.Array)
                    {
                        detailsArray = innerDetails;
                    }
                }
            }

            if (detailsArray.ValueKind == JsonValueKind.Array)
            {
                foreach (var d in detailsArray.EnumerateArray())
                {
                    var docCode = GetLong(d, "dcode", "doctor_code", "doctorcode");
                    var custIdVal = GetDecimal(d, "custid", "customer_id", "customerid", "patient_id");
                    var custNameVal = GetString(d, "customername", "customer_name", "custname", "patient_name");

                    var row = new ConsumedItemRowModel
                    {
                        consumptiondetailcode = GetLong(d, "consumptiondetailcode", "consumptiondetail_code", "id", "detailcode"),
                        stockcode = GetLong(d, "stockcode", "stock_code"),
                        itemcode = GetLong(d, "itemcode", "item_code"),
                        itemname = GetString(d, "itemname", "item_name"),
                        batchno = GetString(d, "batchno", "batch_no", "batch"),
                        availableqty = GetDecimal(d, "availableqty", "available_qty", "closingstock"),
                        consumedqty = GetDecimal(d, "consumedqty", "consumed_qty", "qty"),
                        unitcost = GetDecimal(d, "unitcost", "unit_cost", "rate", "price"),
                        stockvalue = GetDecimal(d, "stockvalue", "stock_value", "totalvalue", "value"),
                        dcode = docCode > 0 ? (int)docCode : null,
                        doctorname = GetString(d, "doctorname", "doctor_name", "doctor", "docname"),
                        custid = custIdVal > 0 ? custIdVal : null,
                        customername = custNameVal,
                        SearchQuery = custIdVal > 0 ? (!string.IsNullOrWhiteSpace(custNameVal) ? $"{custNameVal} (CUST-{custIdVal})" : $"CUST-{custIdVal}") : (custNameVal ?? ""),
                        remarks = GetString(d, "remarks", "remark", "note")
                    };

                    if (string.IsNullOrWhiteSpace(row.itemname))
                    {
                        row.itemname = GetItemName(row.itemcode);
                    }
                    if (row.stockvalue == 0 && row.consumedqty > 0 && row.unitcost > 0)
                    {
                        row.stockvalue = row.consumedqty * row.unitcost;
                    }

                    resultList.Add(row);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing consumption details: {ex.Message}");
        }

        return resultList;
    }

    private static string? GetString(JsonElement elem, params string[] propertyNames)
    {
        if (elem.ValueKind != JsonValueKind.Object) return null;
        foreach (var name in propertyNames)
        {
            foreach (var prop in elem.EnumerateObject())
            {
                if (string.Equals(prop.Name, name, StringComparison.OrdinalIgnoreCase))
                {
                    return prop.Value.ValueKind switch
                    {
                        JsonValueKind.String => prop.Value.GetString(),
                        JsonValueKind.Number => prop.Value.ToString(),
                        _ => null
                    };
                }
            }
        }
        return null;
    }

    private static long GetLong(JsonElement elem, params string[] propertyNames)
    {
        if (elem.ValueKind != JsonValueKind.Object) return 0;
        foreach (var name in propertyNames)
        {
            foreach (var prop in elem.EnumerateObject())
            {
                if (string.Equals(prop.Name, name, StringComparison.OrdinalIgnoreCase))
                {
                    if (prop.Value.ValueKind == JsonValueKind.Number && prop.Value.TryGetInt64(out var val)) return val;
                    if (prop.Value.ValueKind == JsonValueKind.String && long.TryParse(prop.Value.GetString(), out var sVal)) return sVal;
                }
            }
        }
        return 0;
    }

    private static decimal GetDecimal(JsonElement elem, params string[] propertyNames)
    {
        if (elem.ValueKind != JsonValueKind.Object) return 0;
        foreach (var name in propertyNames)
        {
            foreach (var prop in elem.EnumerateObject())
            {
                if (string.Equals(prop.Name, name, StringComparison.OrdinalIgnoreCase))
                {
                    if (prop.Value.ValueKind == JsonValueKind.Number && prop.Value.TryGetDecimal(out var val)) return val;
                    if (prop.Value.ValueKind == JsonValueKind.String && decimal.TryParse(prop.Value.GetString(), out var sVal)) return sVal;
                }
            }
        }
        return 0;
    }

    private static DateTime GetDateTime(JsonElement elem, params string[] propertyNames)
    {
        if (elem.ValueKind != JsonValueKind.Object) return default;
        foreach (var name in propertyNames)
        {
            foreach (var prop in elem.EnumerateObject())
            {
                if (string.Equals(prop.Name, name, StringComparison.OrdinalIgnoreCase))
                {
                    if (prop.Value.ValueKind == JsonValueKind.String && DateTime.TryParse(prop.Value.GetString(), out var dt)) return dt;
                }
            }
        }
        return default;
    }

    private void PromptDeleteConsumption(consumption_master log)
    {
        PendingDeleteLog = log;
        ShowDeleteConfirmModal = true;
    }

    private void CancelDelete()
    {
        PendingDeleteLog = null;
        ShowDeleteConfirmModal = false;
    }

    private async Task ConfirmDeleteConsumption()
    {
        if (PendingDeleteLog == null) return;

        IsDeleting = true;
        try
        {
            var client = CreateClient();
            var url = $"api/ItemMaster/deleteconsumption?consumptioncode={PendingDeleteLog.consumptioncode}";
            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess($"Consumption record #{PendingDeleteLog.consumptioncode} deleted successfully.");
                ShowDeleteConfirmModal = false;
                PendingDeleteLog = null;

                // Reload logs and room stock
                await Task.WhenAll(LoadConsumptionLogs(), LoadRoomStock(SelectedRoomWarehouseCode));
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to delete record: {errorText}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"An error occurred while deleting: {ex.Message}");
        }
        finally
        {
            IsDeleting = false;
            await InvokeAsync(StateHasChanged);
        }
    }
