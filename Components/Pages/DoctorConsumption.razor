    private List<CustomerModel> FilterPatientsLocally(string query, int maxCount)
    {
        if (string.IsNullOrWhiteSpace(query)) return CustomersList.Take(maxCount).ToList();
        return CustomersList.Where(c =>
            (c.name != null && c.name.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
            (c.namewithinitials != null && c.namewithinitials.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
            (c.mobile != null && c.mobile.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
            (c.custid.ToString().Contains(query, StringComparison.OrdinalIgnoreCase)) ||
            (c.custcode != null && c.custcode.Contains(query, StringComparison.OrdinalIgnoreCase))
        ).Take(maxCount).ToList();
    }

    private async Task<List<CustomerModel>> SearchCustomersFromApi(string query, System.Threading.CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(query)) return new();

        var clients = new[] { "LabCareUrl", "DoctorApi" };
        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        foreach (var clientName in clients)
        {
            try
            {
                var client = ClientFactory.CreateClient(clientName);
                if (!string.IsNullOrEmpty(DefaultTenant))
                {
                    client.DefaultRequestHeaders.Remove("tenant_code");
                    client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
                    client.DefaultRequestHeaders.Remove("tenantcode");
                    client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
                }

                var requestUrl = $"api/Customer/search?key={Uri.EscapeDataString(query)}";
                var response = await client.GetAsync(requestUrl, token);
                if (response.IsSuccessStatusCode)
                {
                    var rawJson = await response.Content.ReadAsStringAsync(token);
                    if (!string.IsNullOrWhiteSpace(rawJson))
                    {
                        List<CustomerModel>? list = null;
                        try
                        {
                            list = JsonSerializer.Deserialize<List<CustomerModel>>(rawJson, options);
                        }
                        catch
                        {
                            var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<CustomerModel>>>(rawJson, options);
                            list = wrapped?.data;
                        }

                        if (list != null && list.Any())
                        {
                            LabSettingModel? setting = null;
                            try { setting = await LabSettingService.GetLabSettingAsync(); } catch { }
                            bool showAll = setting?.show_all_customers ?? true;
                            if (!showAll)
                            {
                                var effectiveTenant = !string.IsNullOrEmpty(DefaultTenant) ? DefaultTenant : (TenantState?.TenantCode ?? "");
                                list = list.Where(c => !string.IsNullOrEmpty(c.tenant_code) && string.Equals(c.tenant_code, effectiveTenant, StringComparison.OrdinalIgnoreCase)).ToList();
                            }
                            return list;
                        }
                    }
                }
            }
            catch (OperationCanceledException) { throw; }
            catch (Exception ex)
            {
                Console.WriteLine($"[DoctorConsumption] Customer API search '{clientName}' error: {ex.Message}");
            }
        }

        return new();
    }

