@page "/salesmaster"
@page "/sales"
@using Booking.Models
@using medico_backend.Model
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Booking.Services.CaseSheetService CaseSheetService


<style>
    @@keyframes blinker {
        50% { opacity: 0.3; }
    }
    .custom-typeahead-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1000;
        max-height: 200px;
        overflow-y: auto;
        background: white;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        margin-top: 2px;
    }
    .custom-typeahead-item {
        padding: 6px 10px;
        cursor: pointer;
        font-size: 0.75rem;
        text-align: left;
        color: #1e293b;
        transition: background-color 0.2s;
    }
    .custom-typeahead-item:hover {
        background-color: #f1f5f9;
        color: #02659e;
    }
</style>

<PageTitle>Billing</PageTitle>

<link rel="stylesheet" href="SalesMaster.css" />

<div class="items-page purchase-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                            <polyline points="10 9 9 9 8 9" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Pharmacy Billing</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total billing : @(SalesList.Count(s => string.IsNullOrEmpty(DefaultTenant) || string.IsNullOrEmpty(s.tenantcode) || string.Equals(s.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase)))
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <!-- Search Input -->
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by bill no or customer..." @oninput="OnSearchInput" />
                    </div>

                    <!-- View Toggle -->
                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    @if (hasCreateRight)
                    {
                        <button class="add-item-btn" @onclick="AddNewSales">
                            <i class="bi bi-plus-lg"></i>
                            <span class="ms-1">Pharmacy Billing</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Filters & Report Actions Row (Left Aligned Filters & Right Aligned Compact Action Buttons) -->
            <div class="d-flex justify-content-between align-items-center mb-4 gap-2 flex-wrap w-100" style="display: flex !important; justify-content: space-between !important; align-items: center !important; width: 100% !important;">
                <!-- Left Aligned Filters -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <!-- Warehouse Filter -->
                    <div class="filter-group">
                        <span class="filter-label">
                            <i class="bi bi-building"></i> Warehouse:
                        </span>
                        <select class="filter-select" @bind="selectedReportWarehouseCode" @bind:after="OnFilterChanged">
                            <option value="0">All Warehouses</option>
                            @foreach (var wh in WarehouseList)
                            {
                                <option value="@wh.warehousecode">@wh.warehousename</option>
                            }
                        </select>
                    </div>

                    <!-- From Date Filter -->
                    <div class="filter-group">
                        <span class="filter-label">
                            <i class="bi bi-calendar3"></i> From:
                        </span>
                        <input type="date" class="filter-input-date" @bind="selectedReportFromDate" />
                    </div>

                    <!-- To Date Filter -->
                    <div class="filter-group">
                        <span class="filter-label">
                            <i class="bi bi-calendar3"></i> To:
                        </span>
                        <input type="date" class="filter-input-date" @bind="selectedReportToDate" />
                    </div>
                </div>

                <!-- Right Aligned Compact Action Buttons -->
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <button class="btn-report-preview" @onclick="PreviewSalesReport" disabled="@isPrinting" title="Preview Sales Report">
                        @if (isPrinting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Loading...</span>
                        }
                        else
                        {
                            <i class="bi bi-printer me-1"></i> <span>Sales Report</span>
                        }
                    </button>

                    <button class="btn-report-download" @onclick="PrintSalesReportDirect" disabled="@isPrintingPdf" title="Print Sales Report">
                        @if (isPrintingPdf)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Printing...</span>
                        }
                        else
                        {
                            <i class="bi bi-printer me-1"></i> <span>Print Report</span>
                        }
                    </button>
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredSales.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-receipt fs-1 d-block mb-3"></i>
                        No sales found.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">S.NO</th>
                                    <th>BILL NO</th>
                                    <th>DATE</th>
                                    <th>CUSTOMER_ID</th>
                                    <th>CUSTOMER_NAME</th>
                                    <th>NET AMOUNT</th>
                                    <th>PAYMENT MODE</th>
                                    <th>STATUS</th>
                                    <th style="width: 120px; text-align: center;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedSales.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td>@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td class="fw-bold text-primary">#@(string.IsNullOrEmpty(row.value.billno) ? row.value.salescode.ToString() : row.value.billno)</td>
                                        <td>@(row.value.billdate.ToString("yyyy-MM-dd"))</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.value.patientid) ? (row.value.customercode > 0 ? row.value.customercode.ToString() : "N/A") : row.value.patientid)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.value.patientname) ? (CustomerList.FirstOrDefault(c => c.customercode == row.value.customercode)?.customername ?? "N/A") : row.value.patientname)</td>
                                        <td class="fw-bold">₹@row.value.netamount.ToString("N2")</td>
                                        <td>@row.value.paymentmode</td>
                                        <td>
                                            <span class="badge @(row.value.paymentstatus == "Paid" ? "bg-success" : "bg-warning text-dark")">
                                                @row.value.paymentstatus
                                            </span>
                                        </td>
                                        <td>
                                            <button class="action-btn btn-report" @onclick="() => PreviewPharmacyBillReport(row.value)" title="Billing Report" disabled="@(activeReportBillNo == (string.IsNullOrEmpty(row.value.billno) ? row.value.salescode.ToString() : row.value.billno))">
                                                @if (activeReportBillNo == (string.IsNullOrEmpty(row.value.billno) ? row.value.salescode.ToString() : row.value.billno))
                                                {
                                                    <span class="spinner-border spinner-border-sm" role="status" style="width: 12px; height: 12px; border-width: 2px;"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-file-earmark-text"></i>
                                                }
                                            </button>
                                            @if (hasEditRight)
                                            {
                                                <button class="action-btn btn-edit" @onclick="async () => await EditSales(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            }
                                            @if (hasDeleteRight)
                                            {
                                                <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var s in PagedSales)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span class="card-item-code">#@(string.IsNullOrEmpty(s.billno) ? s.salescode.ToString() : s.billno)</span>
                                    <div>
                                        <button class="action-btn btn-report" @onclick="() => PreviewPharmacyBillReport(s)" title="Billing Report" disabled="@(activeReportBillNo == (string.IsNullOrEmpty(s.billno) ? s.salescode.ToString() : s.billno))">
                                            @if (activeReportBillNo == (string.IsNullOrEmpty(s.billno) ? s.salescode.ToString() : s.billno))
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status" style="width: 12px; height: 12px; border-width: 2px;"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-file-earmark-text"></i>
                                            }
                                        </button>
                                        @if (hasEditRight)
                                        {
                                            <button class="action-btn btn-edit" @onclick="async () => await EditSales(s)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(s)" title="Delete"><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
                                </div>
                                <div class="item-card-body">
                                     <div class="detail-row"><span>Date</span><strong>@(s.billdate.ToString("yyyy-MM-dd"))</strong></div>
                                     <div class="detail-row"><span>Customer ID</span><strong>@(string.IsNullOrWhiteSpace(s.patientid) ? (s.customercode > 0 ? s.customercode.ToString() : "N/A") : s.patientid)</strong></div>
                                     <div class="detail-row"><span>Customer Name</span><strong>@(string.IsNullOrWhiteSpace(s.patientname) ? (CustomerList.FirstOrDefault(c => c.customercode == s.customercode)?.customername ?? "N/A") : s.patientname)</strong></div>
                                     <div class="detail-row"><span>Net Amount</span><strong>₹@s.netamount.ToString("N2")</strong></div>
                                     <div class="detail-row"><span>Status</span><strong>@s.paymentstatus</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="display-controls px-4 py-3 border-top">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredSales.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredSales.Count()))</strong> of <strong>@FilteredSales.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1" style="align-items: center;">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @foreach (var pageNum in GetVisiblePageNumbers())
                            {
                                var p = pageNum;
                                <button class="page-btn @(CurrentPage == p ? "active" : "")" @onclick="() => ChangePage(p)">
                                    @p
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 1250px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #1e293b !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Sales" : "Pharmacy Billing")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentRequest" OnValidSubmit="SaveSales" autocomplete="off">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 4px 0px 8px 0px;">
                        
                        <!-- Bill Information wrapper -->
                        <div class="purchase-bill-wrapper mb-2">
                            <!-- Billing fields -->
                            <div class="purchase-bill-fields" style="flex: 1; display: flex; flex-direction: column; gap: 8px;">
                                <!-- Row 1 -->
                                <div style="display: grid; grid-template-columns: 2.5fr 5.5fr 4.0fr; gap: 10px; align-items: end;">
                                    <!-- Sales Type -->
                                    <div class="field-group">
                                        <label class="field-label">Sales Type</label>
                                        <div style="position: relative;">
                                            <select class="form-control premium-input" @bind="SelectedSalesType" style="appearance: none !important; -webkit-appearance: none !important; -moz-appearance: none !important; padding-right: 24px; width: 100%;">
                                                <option value="IP / OP Sales">IP / OP Sales</option>                                          
                                                <option value="Counter Sales">Counter Sales</option>
                                            </select>
                                            <i class="bi bi-chevron-down" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b; font-size: 0.8rem;"></i>
                                        </div>
                                    </div>

                                    @if (SelectedSalesType == "IP / OP Sales")
                                    {
                                        <!-- Patient Search Inputs -->
                                        <div class="field-group">
                                            <label class="field-label required">Patient</label>
                                            <div style="display: flex; gap: 8px; align-items: center; position: relative;">
                                                <div style="position: relative; width: 100px; min-width: 100px;">
                                                    <input type="text" class="form-control premium-input text-center" 
                                                           style="width: 100%;"
                                                           placeholder="Patient ID" 
                                                           @bind="PatientIdSearchText" 
                                                           @bind:event="oninput"
                                                           @onfocus='@(() => ActivePatientSearchField = "ID")' 
                                                           @onblur="OnPatientSearchBlur"
                                                           @onkeydown="HandlePatientIdKeyDown" />
                                                    
                                                    @if (ActivePatientSearchField == "ID")
                                                    {
                                                        var filtered = PatientPartitionList
                                                            .Where(p => string.IsNullOrEmpty(PatientIdSearchText) 
                                                                || (p.custid != null && p.custid.Value.ToString().Contains(PatientIdSearchText, StringComparison.OrdinalIgnoreCase)))
                                                            .Take(15)
                                                            .ToList();

                                                        if (filtered.Any())
                                                        {
                                                            <div class="custom-typeahead-dropdown" style="width: 300px; max-height: 250px;">
                                                                @foreach (var p in filtered)
                                                                {
                                                                    <div class="custom-typeahead-item" 
                                                                         @onmousedown="@(() => SelectPatient(p))">
                                                                        <strong>@p.custid</strong> - @p.name
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                                
                                                <div style="position: relative; flex: 1;">
                                                    <input type="text" class="form-control premium-input" 
                                                           style="width: 100%;"
                                                           placeholder="Patient Name" 
                                                           @bind="PatientNameSearchText" 
                                                           @bind:event="oninput"
                                                           @onfocus='@(() => ActivePatientSearchField = "Name")' 
                                                           @onblur="OnPatientSearchBlur"
                                                           @onkeydown="HandlePatientNameKeyDown" />
                                                    
                                                    @if (ActivePatientSearchField == "Name")
                                                    {
                                                        var filtered = PatientPartitionList
                                                            .Where(p => string.IsNullOrEmpty(PatientNameSearchText) 
                                                                || (p.name != null && p.name.Contains(PatientNameSearchText, StringComparison.OrdinalIgnoreCase)))
                                                            .Take(15)
                                                            .ToList();

                                                        if (filtered.Any())
                                                        {
                                                            <div class="custom-typeahead-dropdown" style="width: 100%; max-height: 250px;">
                                                                @foreach (var p in filtered)
                                                                {
                                                                    <div class="custom-typeahead-item" 
                                                                         @onmousedown="@(() => SelectPatient(p))">
                                                                        <strong>@p.custid</strong> - @p.name
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Address Editable -->
                                        <div class="field-group">
                                            <label class="field-label">Address</label>
                                            <InputText class="form-control premium-input" placeholder="Address" @bind-Value="CurrentRequest.master.address" />
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Patient ID & Name text inputs -->
                                        <div class="field-group">
                                            <label class="field-label required">Patient</label>
                                            <div style="display: flex; gap: 8px; align-items: center;">
                                                <InputText class="form-control premium-input text-center" style="width: 100px; min-width: 100px;" placeholder="Patient ID" @bind-Value="CurrentRequest.master.patientid" />
                                                <InputText class="form-control premium-input" style="flex: 1;" placeholder="Patient Name" @bind-Value="CurrentRequest.master.patientname" />
                                            </div>
                                        </div>

                                        <!-- Address Editable -->
                                        <div class="field-group">
                                            <label class="field-label">Address</label>
                                            <InputText class="form-control premium-input" placeholder="Address" @bind-Value="CurrentRequest.master.address" />
                                        </div>
                                    }
                                </div>

                                <!-- Row 2 -->
                                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; align-items: end;">
                                    <!-- Consultant -->
                                    <div class="field-group">
                                        <label class="field-label">Consultant</label>
                                        <InputText class="form-control premium-input" placeholder="Consultant Name" @bind-Value="CurrentRequest.master.consultant" />
                                    </div>

                                    <!-- Bill No -->
                                    <div class="field-group">
                                        <label class="field-label">Bill.No</label>
                                        <input type="text" class="form-control premium-input" value="@(string.IsNullOrEmpty(CurrentRequest.master.billno) ? (CurrentRequest.master.salescode > 0 ? CurrentRequest.master.salescode.ToString() : "1") : CurrentRequest.master.billno)" disabled style="background-color: #f8fafc; font-weight: 700; color: #4f46e5;" />
                                    </div>

                                    <!-- Bill Date -->
                                    <div class="field-group">
                                        <label class="field-label">Bill Date</label>
                                        <InputDate class="form-control premium-input" @bind-Value="CurrentRequest.master.billdate" />
                                    </div>

                                    <!-- Store Dropdown -->
                                    <div class="field-group">
                                        <label class="field-label">Store</label>
                                        <div style="position: relative;">
                                            <select class="form-control premium-input" @bind="SelectedWarehouseCode" style="appearance: none !important; -webkit-appearance: none !important; -moz-appearance: none !important; padding-right: 24px; width: 100%;">
                                                <option value="0">-- Select Store --</option>
                                                @foreach (var w in WarehouseList)
                                                {
                                                    <option value="@w.warehousecode">@w.warehousename</option>
                                                }
                                            </select>
                                            <i class="bi bi-chevron-down" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b; font-size: 0.8rem;"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-section-header" style="margin-top: 0.5rem !important; padding-top: 0.2rem; margin-bottom: 4px; padding-bottom: 2px; border-bottom: 1px solid #f1f5f9;">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Billing Details</div>
                        </div>

                        <!-- Table showing item entry and details -->
                        <div class="purchase-items-table-wrapper table-responsive">
                            <table class="table align-middle mb-0" style="font-size: 0.85rem;">
                                <thead class="purchase-items-table-header">
                                    <tr>
                                        <th style="width: 30px; text-align: center;">S.NO</th>
                                        <th style="width: 140px;">ITEM</th>
                                        <th style="width: 85px; text-align: center;">BATCH NO</th>
                                        <th style="width: 95px; text-align: center;">EXPIRY DATE</th>
                                        <th style="text-align: center; width: 45px;">QTY</th>
                                        <th style="text-align: center; width: 55px;">RATE</th>
                                        <th style="text-align: center; width: 48px;">DISC %</th>
                                        <th style="text-align: center; width: 38px;">TAX %</th>
                                        <th style="text-align: center; width: 55px;">TAX AMT</th>
                                        <th style="text-align: center; width: 65px;">TOTAL</th>
                                        <th style="text-align: center; width: 45px;">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in CurrentRequest.details.Select((detail, index) => new { detail, index }))
                                    {
                                        var detail = row.detail;
                                        var index = row.index;
                                        var rowId = $"row-{index}";
                                        <tr>
                                            <td style="padding: 4px 8px; color: #64748b; text-align: center; font-weight: 600; width: 30px;">@(index + 1)</td>
                                            <td style="padding: 4px 8px; min-width: 140px; width: 140px; position: relative;">
                                                <input id="item-input-@index"
                                                       type="text"
                                                       class="purchase-item-select"
                                                       style="width: 100%;"
                                                       placeholder="Type to search item..."
                                                       autocomplete="off"
                                                       value="@(ItemSearchTexts.GetValueOrDefault(detail, ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname ?? (detail.itemcode > 0 ? $"Unknown Item (Code: {detail.itemcode})" : "")))"
                                                       @oninput="@(e => OnItemTypeaheadInput(e, detail))"
                                                       @onfocus="@(() => ActiveItemSearchRow = index)"
                                                       @onblur="OnSearchBlur"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 0))" />

                                                @if (ActiveItemSearchRow == index)
                                                {
                                                    var searchText = ItemSearchTexts.GetValueOrDefault(detail, "");
                                                    var filteredItems = ItemList
                                                        .Where(i => string.IsNullOrEmpty(searchText) || (i.itemname != null && i.itemname.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                                                        .ToList();

                                                    if (filteredItems.Any())
                                                    {
