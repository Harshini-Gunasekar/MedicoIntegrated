    private bool IsDetailExpired(sales_detail detail)
    {
        if (detail == null || !detail.expirydate.HasValue) return false;
        return detail.expirydate.Value.Date < DateTime.Today;
    }

    private Dictionary<int, string> ExpiryDateTexts = new();

    private string GetExpiryDateDisplay(sales_detail detail)
    {
        var key = detail.GetHashCode();
        if (ExpiryDateTexts.TryGetValue(key, out var text))
        {
            return text;
        }
        return detail.expirydate.HasValue 
            ? detail.expirydate.Value.ToString("MM/yy", System.Globalization.CultureInfo.InvariantCulture) 
            : string.Empty;
    }

    private void OnExpiryDateInput(sales_detail detail, string? val)
    {
        var key = detail.GetHashCode();
        if (string.IsNullOrEmpty(val))
        {
            ExpiryDateTexts[key] = string.Empty;
            detail.expirydate = null;
            return;
        }

        string formatted = FormatExpiryInput(val);
        ExpiryDateTexts[key] = formatted;

        // Parse into detail.expirydate when full MM/YY is provided
        if (formatted.Length == 5 && formatted.Contains('/'))
        {
            var parts = formatted.Split('/');
            if (parts.Length == 2 && int.TryParse(parts[0], out int month) && int.TryParse(parts[1], out int yy))
            {
                if (month >= 1 && month <= 12)
                {
                    int year = 2000 + yy;
                    int days = DateTime.DaysInMonth(year, month);
                    var parsedDate = new DateTime(year, month, days);
                    detail.expirydate = parsedDate;
                    if (parsedDate.Date < DateTime.Today)
                    {
                        var itemName = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname ?? "Item";
                        ToastService.ShowError($"Medicine '{itemName}' entered expiry date ({formatted}) is expired. Expired medicines cannot be billed.");
                    }
                    return;
                }
            }
        }
        detail.expirydate = null;
    }

    private string FormatExpiryInput(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;

        var clean = raw.Trim();
        
        // If user typed single digit month followed by slash (e.g., "3/" or "3/28")
        if (clean.Contains('/'))
        {
            var slashParts = clean.Split('/');
            if (slashParts.Length >= 1 && slashParts[0].Length == 1 && int.TryParse(slashParts[0], out int singleM) && singleM >= 1 && singleM <= 9)
            {
                clean = "0" + slashParts[0] + (slashParts.Length > 1 ? "/" + slashParts[1] : "/");
            }
        }

        var digitsOnly = new string(clean.Where(char.IsDigit).ToArray());
        if (digitsOnly.Length == 0) return string.Empty;

        if (digitsOnly.Length > 4)
        {
            digitsOnly = digitsOnly.Substring(0, 4);
        }

        // If first digit is 2-9, auto prepend 0 (e.g. '3' -> '03')
        if (digitsOnly.Length == 1 && digitsOnly[0] > '1')
        {
            digitsOnly = "0" + digitsOnly;
        }

        if (digitsOnly.Length <= 2)
        {
            if (digitsOnly.Length == 2)
            {
                if (int.TryParse(digitsOnly, out int m))
                {
                    if (m > 12) digitsOnly = "12";
                    else if (m == 0) digitsOnly = "01";
                }
                return digitsOnly + "/";
            }
            return digitsOnly;
        }
        else
        {
            var mm = digitsOnly.Substring(0, 2);
            if (int.TryParse(mm, out int m))
            {
                if (m > 12) mm = "12";
                else if (m == 0) mm = "01";
            }
            var yy = digitsOnly.Substring(2);
            return mm + "/" + yy;
        }
    }

    private void OnExpiryDateChange(sales_detail detail, string? val)
    {
        OnExpiryDateInput(detail, val);
        if (detail.expirydate.HasValue && detail.expirydate.Value.Date < DateTime.Today)
        {
            var itemName = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname ?? "Item";
            var expStr = detail.expirydate.Value.ToString("MM/yy", System.Globalization.CultureInfo.InvariantCulture);
            ToastService.ShowError($"Medicine '{itemName}' entered expiry date ({expStr}) is expired. Expired medicines cannot be billed.");
        }
    }
    
