    private async Task OpenUnbilledPrescriptionModal()
    {
        long? targetId = null;
        if (CurrentRequest.master.customercode.HasValue && CurrentRequest.master.customercode.Value > 0)
        {
            targetId = CurrentRequest.master.customercode.Value;
        }
        else if (long.TryParse(PatientIdSearchText, out var parsedId))
        {
            targetId = parsedId;
        }
        else if (long.TryParse(CurrentRequest.master.patientid, out var parsedPid))
        {
            targetId = parsedPid;
        }
        else if (!string.IsNullOrWhiteSpace(CurrentRequest.master.patientid))
        {
            var opMatch = OpRegistrationList.FirstOrDefault(o => o.op_no == CurrentRequest.master.patientid);
            if (opMatch != null && opMatch.custid > 0) targetId = (long)opMatch.custid;
            else
            {
                var ipMatch = IpRegistrationList.FirstOrDefault(i => i.ip_no == CurrentRequest.master.patientid);
                if (ipMatch != null && ipMatch.custid > 0) targetId = (long)ipMatch.custid;
            }
        }

        if (!targetId.HasValue || targetId.Value <= 0)
        {
            var pName = !string.IsNullOrWhiteSpace(PatientNameSearchText) ? PatientNameSearchText : CurrentRequest.master.patientname;
            if (!string.IsNullOrWhiteSpace(pName))
            {
                var patMatch = PatientPartitionList.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.name) && string.Equals(p.name.Trim(), pName.Trim(), StringComparison.OrdinalIgnoreCase));
                if (patMatch != null && patMatch.custid.HasValue && patMatch.custid.Value > 0) targetId = patMatch.custid.Value;
            }
        }

        if (targetId.HasValue && targetId.Value > 0)
        {
            await LoadPrescriptions(targetId.Value);
        }
        else if (string.IsNullOrWhiteSpace(PatientNameSearchText) && string.IsNullOrWhiteSpace(CurrentRequest.master.patientname))
        {
            ToastService.ShowWarning("Please select or enter a Patient Name first.");
            return;
        }

        showUnbilledPrescriptionModal = true;
        StateHasChanged();
    }

    private async Task LoadPrescriptions(long custId)
    {
        try
        {
            loadingPendingPrescriptions = true;
            PendingPrescriptions.Clear();

            await HydratePatientSavedSalesAsync(custId, CurrentRequest?.master?.patientid ?? PatientIdSearchText, CurrentRequest?.master?.patientname ?? PatientNameSearchText);

            List<PharmacyPrescriptionQueueRow>? rows = null;

            // 1. Try fetching from pharmacy queue with standard tenant headers
            try
            {
                var client = CreateClient();
                var responseString = await client.GetStringAsync($"api/ItemMaster/pharmacy-queue/by-custid?custid={custId}&billed=false");
                if (!string.IsNullOrWhiteSpace(responseString))
                {
                    rows = ParsePharmacyQueueJson(responseString);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Pharmacy queue default tenant request exception: " + ex.Message);
            }

            // 2. If no valid queue rows found, retry pharmacy queue with tenantcode header "0010"
            if (rows == null || !rows.Any(r => !IsQueueRowBilledOrDispensed(r, custId)))
            {
                try
                {
                    var client = CreateClient();
                    client.DefaultRequestHeaders.Remove("tenantcode");
                    client.DefaultRequestHeaders.Add("tenantcode", "0010");
                    var responseString = await client.GetStringAsync($"api/ItemMaster/pharmacy-queue/by-custid?custid={custId}&billed=false");
                    if (!string.IsNullOrWhiteSpace(responseString))
                    {
                        var parsed = ParsePharmacyQueueJson(responseString);
                        if (parsed != null && parsed.Any())
                        {
                            rows = parsed;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Pharmacy queue 0010 tenant request exception: " + ex.Message);
                }
            }

            var validRows = rows?.Where(r => !IsQueueRowBilledOrDispensed(r, custId)).ToList();

            if (validRows != null && validRows.Any())
            {
                foreach (var row in validRows)
                {
                    string mDose = !string.IsNullOrWhiteSpace(row.morning_dose) ? row.morning_dose : (!string.IsNullOrWhiteSpace(row.morning) ? row.morning : "0");
                    string aDose = !string.IsNullOrWhiteSpace(row.afternoon_dose) ? row.afternoon_dose : (!string.IsNullOrWhiteSpace(row.afternoon) ? row.afternoon : "0");
                    string eDose = !string.IsNullOrWhiteSpace(row.evening_dose) ? row.evening_dose : (!string.IsNullOrWhiteSpace(row.evening) ? row.evening : "0");
                    string nDose = !string.IsNullOrWhiteSpace(row.night_dose) ? row.night_dose : (!string.IsNullOrWhiteSpace(row.night) ? row.night : "0");

                    long itemCode = row.matched_itemcode ?? 0;
                    string drugName = !string.IsNullOrWhiteSpace(row.matched_itemname) ? row.matched_itemname : (row.drug_name ?? "Medicine");
                    
                    var matchedItem = ItemList.FirstOrDefault(i => (itemCode > 0 && i.itemcode == itemCode) ||
                        string.Equals(i.itemname, drugName, StringComparison.OrdinalIgnoreCase) ||
                        (!string.IsNullOrWhiteSpace(i.itemname) && i.itemname.Trim().Equals(drugName.Trim(), StringComparison.OrdinalIgnoreCase)));

                    if (matchedItem == null && drugName.Length >= 3)
                    {
                        matchedItem = ItemList.FirstOrDefault(i => i.itemname != null && i.itemname.Contains(drugName, StringComparison.OrdinalIgnoreCase));
                    }

                    if (matchedItem != null && itemCode == 0)
                    {
                        itemCode = matchedItem.itemcode;
                    }

                    decimal unitMrp = matchedItem != null ? GetItemUnitMrp(matchedItem) : 0;
                    bool isTab = IsTabletItem(itemCode, drugName);
                    decimal dailyDose = CalculateDailyDose(mDose, aDose, eDose, nDose);

                    int? itemDays = ParseDaysFromQueueRow(row);
                    if ((!itemDays.HasValue || itemDays.Value <= 0) && row.qty.HasValue && row.qty.Value > 0 && dailyDose > 0)
                    {
                        itemDays = Math.Max(1, (int)Math.Round(row.qty.Value / dailyDose));
                    }
                    if (!itemDays.HasValue || itemDays.Value <= 0)
                    {
                        itemDays = 1;
                    }

                    decimal finalQty = isTab ? CalculatePrescriptionQuantity(true, dailyDose, itemDays.Value) : 1;
                    if (row.qty.HasValue && row.qty.Value > 0 && (dailyDose <= 0 || !isTab))
                    {
                        finalQty = isTab ? (decimal)Math.Max(1, (int)Math.Ceiling(row.qty.Value)) : 1;
                    }
                    else if (row.qty.HasValue && row.qty.Value > 0 && isTab && finalQty == 1 && row.qty.Value > 1)
                    {
                        finalQty = (decimal)Math.Max(1, (int)Math.Ceiling(row.qty.Value));
                    }
                    decimal estimatedAmt = unitMrp * finalQty;

                    var dosageParts = new List<string>();
                    if (!string.IsNullOrWhiteSpace(mDose) && mDose != "0") dosageParts.Add($"M: {mDose}");
                    if (!string.IsNullOrWhiteSpace(aDose) && aDose != "0") dosageParts.Add($"A: {aDose}");
                    if (!string.IsNullOrWhiteSpace(eDose) && eDose != "0") dosageParts.Add($"E: {eDose}");
                    if (!string.IsNullOrWhiteSpace(nDose) && nDose != "0") dosageParts.Add($"N: {nDose}");
                    string dosageStr = string.Join(", ", dosageParts);

                    PendingPrescriptions.Add(new PendingPrescriptionDisplayItem
                    {
                        DrugName = drugName,
                        MatchedItemCode = itemCode > 0 ? itemCode : null,
                        MatchedItemName = matchedItem?.itemname ?? drugName,
                        ItemTypeName = GetItemTypeName(matchedItem),
                        Qty = finalQty,
                        Days = itemDays,
                        Duration = !string.IsNullOrWhiteSpace(row.duration) ? row.duration : itemDays.Value.ToString(),
                        Dosage = !string.IsNullOrWhiteSpace(dosageStr) ? dosageStr : (!string.IsNullOrWhiteSpace(row.duration) ? row.duration : null),
                        Morning = mDose,
                        Afternoon = aDose,
                        Evening = eDose,
                        Night = nDose,
                        Instructions = row.before_food ? "Before Food" : (row.after_food ? "After Food" : row.notes),
                        EstimatedRate = unitMrp,
                        EstimatedAmount = estimatedAmt,
                        Date = row.created_at,
                        QueueId = row.queue_id,
                        PrDetId = row.pr_det_id,
                        Source = "Pharmacy Queue",
                        RawQueueRow = row,
                        IsAdded = IsPrescriptionItemInGrid(itemCode, row.queue_id, drugName, row.pr_det_id)
                    });
                }

                StateHasChanged();
                return;
            }

            // 3. Fallback: Query Case Sheet history for patient to retrieve saved prescribed medicines
            if (CaseSheetService != null)
            {
                var history = await CaseSheetService.GetPatientHistoryAsync((decimal)custId, 1, 20);
                if (history != null && history.Any())
                {
                    // Locate the latest visit with unbilled prescription items
                    var latestWithPrescription = history
                        .Where(h => h.prescription != null && h.prescription.items != null && h.prescription.items.Any(i => !string.IsNullOrWhiteSpace(i.drug_name) && !IsCaseSheetItemBilled(i, custId, h.visit_date)))
                        .OrderByDescending(h => h.visit_date ?? DateTime.MinValue)
                        .FirstOrDefault();

                    if (latestWithPrescription != null && latestWithPrescription.prescription?.items != null)
                    {
                        foreach (var item in latestWithPrescription.prescription.items)
                        {
                            if (string.IsNullOrWhiteSpace(item.drug_name)) continue;
                            if (IsCaseSheetItemBilled(item, custId, latestWithPrescription.visit_date)) continue;

                            string mDose = !string.IsNullOrWhiteSpace(item.morning_dose) ? item.morning_dose : (!string.IsNullOrWhiteSpace(item.morning) ? item.morning : "0");
                            string aDose = !string.IsNullOrWhiteSpace(item.afternoon_dose) ? item.afternoon_dose : (!string.IsNullOrWhiteSpace(item.afternoon) ? item.afternoon : "0");
                            string eDose = !string.IsNullOrWhiteSpace(item.evening_dose) ? item.evening_dose : (!string.IsNullOrWhiteSpace(item.evening) ? item.evening : "0");
                            string nDose = !string.IsNullOrWhiteSpace(item.night_dose) ? item.night_dose : (!string.IsNullOrWhiteSpace(item.night) ? item.night : "0");

                            int? itemDays = ParseDaysFromDuration(item.days, item.duration);

                            long itemCode = item.drug_code.HasValue ? (long)item.drug_code.Value : 0;
                            string drugName = item.drug_name;

                            var matchedItem = ItemList.FirstOrDefault(i => (itemCode > 0 && i.itemcode == itemCode) ||
                                string.Equals(i.itemname, drugName, StringComparison.OrdinalIgnoreCase) ||
                                (!string.IsNullOrWhiteSpace(i.itemname) && i.itemname.Trim().Equals(drugName.Trim(), StringComparison.OrdinalIgnoreCase)));

                            if (matchedItem == null && drugName.Length >= 3)
                            {
                                matchedItem = ItemList.FirstOrDefault(i => i.itemname != null && i.itemname.Contains(drugName, StringComparison.OrdinalIgnoreCase));
                            }

                            if (matchedItem != null && itemCode == 0)
                            {
                                itemCode = matchedItem.itemcode;
                            }

                            decimal unitMrp = matchedItem != null ? GetItemUnitMrp(matchedItem) : 0;
                            bool isTab = IsTabletItem(itemCode, drugName);
                            decimal dailyDose = CalculateDailyDose(mDose, aDose, eDose, nDose);

                            if ((!itemDays.HasValue || itemDays.Value <= 0) && item.qty.HasValue && item.qty.Value > 0 && dailyDose > 0)
                            {
                                itemDays = Math.Max(1, (int)Math.Round(item.qty.Value / dailyDose));
                            }
                            if (!itemDays.HasValue || itemDays.Value <= 0)
                            {
                                itemDays = 1;
                            }

                            decimal finalQty = isTab ? CalculatePrescriptionQuantity(true, dailyDose, itemDays.Value) : 1;
                            if (item.qty.HasValue && item.qty.Value > 0 && (dailyDose <= 0 || !isTab))
                            {
                                finalQty = isTab ? (decimal)Math.Max(1, (int)Math.Ceiling(item.qty.Value)) : 1;
                            }
                            else if (item.qty.HasValue && item.qty.Value > 0 && isTab && finalQty == 1 && item.qty.Value > 1)
                            {
                                finalQty = (decimal)Math.Max(1, (int)Math.Ceiling(item.qty.Value));
                            }
                            decimal estimatedAmt = unitMrp * finalQty;

                            var dosageParts = new List<string>();
                            if (!string.IsNullOrWhiteSpace(mDose) && mDose != "0") dosageParts.Add($"M: {mDose}");
                            if (!string.IsNullOrWhiteSpace(aDose) && aDose != "0") dosageParts.Add($"A: {aDose}");
                            if (!string.IsNullOrWhiteSpace(eDose) && eDose != "0") dosageParts.Add($"E: {eDose}");
                            if (!string.IsNullOrWhiteSpace(nDose) && nDose != "0") dosageParts.Add($"N: {nDose}");
                            string dosageStr = string.Join(", ", dosageParts);

                            PendingPrescriptions.Add(new PendingPrescriptionDisplayItem
                            {
                                DrugName = drugName,
                                MatchedItemCode = itemCode > 0 ? itemCode : null,
                                MatchedItemName = matchedItem?.itemname ?? drugName,
                                ItemTypeName = GetItemTypeName(matchedItem),
                                Qty = finalQty,
                                Days = itemDays,
                                Duration = !string.IsNullOrWhiteSpace(item.duration) ? item.duration : itemDays.Value.ToString(),
                                Dosage = !string.IsNullOrWhiteSpace(dosageStr) ? dosageStr : (!string.IsNullOrWhiteSpace(item.duration) ? item.duration : null),
                                Morning = mDose,
                                Afternoon = aDose,
                                Evening = eDose,
                                Night = nDose,
                                Instructions = item.before_food ? "Before Food" : (item.after_food ? "After Food" : null),
                                EstimatedRate = unitMrp,
                                EstimatedAmount = estimatedAmt,
                                Date = latestWithPrescription.visit_date,
                                PrDetId = item.pr_det_id,
                                Source = "Case Sheet",
                                RawCaseSheetRow = item,
                                IsAdded = IsPrescriptionItemInGrid(itemCode, null, drugName, item.pr_det_id)
                            });
                        }

                        StateHasChanged();
                        return;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading prescriptions: {ex.Message}");
        }
        finally
        {
            loadingPendingPrescriptions = false;
            StateHasChanged();
        }
    }

    private List<PharmacyPrescriptionQueueRow>? ParsePharmacyQueueJson(string responseString)
    {
        var options = new JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try
        {
            using var doc = JsonDocument.Parse(responseString);
            var root = doc.RootElement;
            JsonElement dataElement = root;

            if (root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var dataProp))
            {
                dataElement = dataProp;
            }

            if (dataElement.ValueKind == JsonValueKind.Array)
            {
                if (dataElement.GetArrayLength() > 0)
                {
                    var first = dataElement[0];
                    if (first.ValueKind == JsonValueKind.Object && first.TryGetProperty("items", out _))
                    {
                        var groups = JsonSerializer.Deserialize<List<PharmacyQueueGroup>>(dataElement.GetRawText(), options);
                        return groups?.SelectMany(g => g.items ?? new List<PharmacyPrescriptionQueueRow>()).ToList();
                    }
                    else
                    {
                        return JsonSerializer.Deserialize<List<PharmacyPrescriptionQueueRow>>(dataElement.GetRawText(), options);
                    }
                }
                return new List<PharmacyPrescriptionQueueRow>();
            }
            else if (dataElement.ValueKind == JsonValueKind.Object)
            {
                if (dataElement.TryGetProperty("items", out _))
                {
                    var group = JsonSerializer.Deserialize<PharmacyQueueGroup>(dataElement.GetRawText(), options);
                    return group?.items;
                }
                else
                {
                    var singleRow = JsonSerializer.Deserialize<PharmacyPrescriptionQueueRow>(dataElement.GetRawText(), options);
                    return singleRow != null ? new List<PharmacyPrescriptionQueueRow> { singleRow } : null;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error parsing prescription queue JSON: " + ex.Message);
        }
        return null;
    }

    private int? ParseDaysFromDuration(int? daysVal, string? durationVal)
    {
        if (daysVal.HasValue && daysVal.Value > 0) return daysVal.Value;
        if (!string.IsNullOrWhiteSpace(durationVal))
        {
            var match = System.Text.RegularExpressions.Regex.Match(durationVal, @"\d+");
            if (match.Success && int.TryParse(match.Value, out var num) && num > 0)
            {
                return num;
            }
        }
        return null;
    }

    private int? ParseDaysFromQueueRow(PharmacyPrescriptionQueueRow? row)
    {
        if (row == null) return null;
        if (row.days.HasValue && row.days.Value > 0) return row.days.Value;
        if (row.no_of_days.HasValue && row.no_of_days.Value > 0) return row.no_of_days.Value;
        if (row.prescribed_days.HasValue && row.prescribed_days.Value > 0) return row.prescribed_days.Value;
        if (row.prescribeddays.HasValue && row.prescribeddays.Value > 0) return row.prescribeddays.Value;
        if (row.feed_days.HasValue && row.feed_days.Value > 0) return row.feed_days.Value;
        return ParseDaysFromDuration(null, row.duration);
    }

    private string GetItemTypeName(long? itemCode, string? fallbackName = null)
    {
        var matchedItem = ItemList.FirstOrDefault(i => (itemCode.HasValue && itemCode.Value > 0 && i.itemcode == itemCode.Value) ||
            (!string.IsNullOrWhiteSpace(fallbackName) && (
                string.Equals(i.itemname, fallbackName, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrWhiteSpace(i.itemname) && i.itemname.Trim().Equals(fallbackName.Trim(), StringComparison.OrdinalIgnoreCase))
            )));

        if (matchedItem == null && !string.IsNullOrWhiteSpace(fallbackName) && fallbackName.Trim().Length >= 3)
        {
            matchedItem = ItemList.FirstOrDefault(i => i.itemname != null && i.itemname.Contains(fallbackName.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        return GetItemTypeName(matchedItem);
    }

    private string GetItemTypeName(inventory_item_master? item)
    {
        if (item != null)
        {
            if (item.subcategorycode > 0 && CategoryList != null && CategoryList.Any())
            {
                var cat = CategoryList.FirstOrDefault(c => c.categorycode == item.subcategorycode);
                if (cat != null && !string.IsNullOrWhiteSpace(cat.categoryname))
                {
                    return cat.categoryname;
                }
            }

            if (!string.IsNullOrWhiteSpace(item.itemtype))
            {
                return item.itemtype;
            }
        }

        return "PRESCRIPTION";
    }

    private bool IsTabletItem(long? itemCode, string? itemName)
    {
        var item = itemCode.HasValue && itemCode.Value > 0 ? ItemList.FirstOrDefault(i => i.itemcode == itemCode.Value) : null;
        string name = (item?.itemname ?? itemName ?? "").Trim().ToLowerInvariant();
        string type = (item?.itemtype ?? "").Trim().ToLowerInvariant();
        string cat = (item != null && item.categorycode > 0 && CategoryList != null ? CategoryList.FirstOrDefault(c => c.categorycode == item.categorycode)?.categoryname ?? "" : "").Trim().ToLowerInvariant();
        string subcat = (item != null && item.subcategorycode > 0 && CategoryList != null ? CategoryList.FirstOrDefault(c => c.categorycode == item.subcategorycode)?.categoryname ?? "" : "").Trim().ToLowerInvariant();

        // Check non-tablet indicators
        string[] nonTabletKeywords = new[] { 
            "syrup", "syp", "suspension", "susp", "drop", "drops", "ointment", "oint", 
            "cream", "crm", "gel", "lotion", "lot", "spray", "inhaler", "respule", "respules",
            "injection", "inj", "iv", "infusion", "solution", "sol", "wash", "mouthwash",
            "powder", "pwd", "oil", "shampoo", "soap", "paste", "sachet", "enema", "granules",
            "device", "strips", "bandage", "cotton"
        };

        foreach (var kw in nonTabletKeywords)
        {
            if (name.Contains(kw) || type.Contains(kw) || cat.Contains(kw) || subcat.Contains(kw))
            {
                return false;
            }
        }

        // Check tablet/capsule indicators
        string[] tabletKeywords = new[] { "tab", "tablet", "tablets", "cap", "capsule", "capsules", "cap.", "tab.", "pill", "pills" };
        foreach (var kw in tabletKeywords)
        {
            if (name.Contains(kw) || type.Contains(kw) || cat.Contains(kw) || subcat.Contains(kw))
            {
                return true;
            }
        }

        return true;
    }

    private decimal ParseDoseValue(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return 0;
        val = val.Trim();
        if (val == "1/2" || val == "½") return 0.5m;
        if (val == "1/4" || val == "¼") return 0.25m;
        if (val == "3/4" || val == "¾") return 0.75m;
        if (val == "1 1/2" || val == "1.5") return 1.5m;
        if (decimal.TryParse(val, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
        {
            return parsed;
        }
        return 0;
    }

    private decimal CalculateDailyDose(string? m, string? a, string? e, string? n)
    {
        return ParseDoseValue(m) + ParseDoseValue(a) + ParseDoseValue(e) + ParseDoseValue(n);
    }

    private decimal CalculatePrescriptionQuantity(bool isTablet, decimal dailyDose, int days)
    {
        if (!isTablet) return 1;
        if (days <= 0) days = 1;
        if (dailyDose <= 0) dailyDose = 1;
        
        decimal total = dailyDose * (decimal)days;
        // Round off to integer (never decimal)
        return (decimal)Math.Max(1, (int)Math.Ceiling(total));
    }

    private void AddPrescriptionItemToGrid(PendingPrescriptionDisplayItem item)
    {
        if (item == null) return;

        if (CurrentRequest.details.Count == 1 && CurrentRequest.details[0].itemcode == 0)
        {
            ItemSearchTexts.Remove(CurrentRequest.details[0]);
            CurrentRequest.details.Clear();
            EditableRows.Clear();
        }

        bool isTablet = IsTabletItem(item.MatchedItemCode, item.DrugName);
        decimal dailyDose = CalculateDailyDose(item.Morning, item.Afternoon, item.Evening, item.Night);
        int itemDays = item.Days.HasValue && item.Days.Value > 0 ? item.Days.Value : 1;
        decimal calculatedQty = isTablet ? (item.Qty > 0 ? (decimal)Math.Max(1, (int)Math.Ceiling(item.Qty)) : CalculatePrescriptionQuantity(true, dailyDose, itemDays)) : 1;

        var detail = new sales_detail
        {
            tenantcode = DefaultTenant,
            itemcode = item.MatchedItemCode ?? 0,
            days = itemDays,
            prescribeddays = itemDays,
            no_of_days = itemDays,
            duration = item.Duration ?? itemDays.ToString(),
            quantity = calculatedQty,
            morning = item.Morning,
            afternoon = item.Afternoon,
            evening = item.Evening,
            night = item.Night,
            morning_dose = item.Morning,
            afternoon_dose = item.Afternoon,
            evening_dose = item.Evening,
            night_dose = item.Night,
            dosage = item.Dosage,
            queue_id = item.QueueId ?? Guid.Empty,
            pr_det_id = item.PrDetId
        };

        if (detail.itemcode == 0 && !string.IsNullOrWhiteSpace(item.DrugName))
        {
            var localMatch = ItemList.FirstOrDefault(i => 
                string.Equals(i.itemname, item.DrugName, StringComparison.OrdinalIgnoreCase) ||
                (i.itemname != null && i.itemname.Trim().Equals(item.DrugName.Trim(), StringComparison.OrdinalIgnoreCase))
            );
            if (localMatch == null && item.DrugName.Length >= 3)
            {
                localMatch = ItemList.FirstOrDefault(i => i.itemname != null && i.itemname.Contains(item.DrugName, StringComparison.OrdinalIgnoreCase));
            }
            if (localMatch != null)
            {
                detail.itemcode = localMatch.itemcode;
            }
        }

        if (detail.itemcode > 0)
        {
            OnItemChanged(detail);
            detail.days = itemDays; // Preserve prescribed days from queue
            detail.prescribeddays = itemDays;
            detail.no_of_days = itemDays;
            detail.duration = item.Duration ?? itemDays.ToString();
            detail.quantity = calculatedQty; // Preserve calculated prescription quantity
        }

        CurrentRequest.details.Add(detail);
        EditableRows.Add(detail);

        _originalPrescriptionMap[detail] = (detail.quantity, itemDays);
        if (itemDays > (CurrentRequest.master.prescribeddays ?? 0))
        {
            CurrentRequest.master.prescribeddays = itemDays;
        }

        var matchedName = detail.itemcode > 0 ? ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname : null;
        ItemSearchTexts[detail] = !string.IsNullOrWhiteSpace(matchedName) ? matchedName : (!string.IsNullOrWhiteSpace(item.MatchedItemName) ? item.MatchedItemName : item.DrugName);

        item.IsAdded = true;
        CalculateTotals();
        StateHasChanged();
        ToastService.ShowSuccess($"Added '{item.DrugName}' to billing table.");
    }

    private void AddAllPrescriptionsToGrid()
    {
        var itemsToAdd = PendingPrescriptions.Where(p => !p.IsAdded && !IsPrescriptionItemInGrid(p.MatchedItemCode ?? 0, p.QueueId, p.DrugName, p.PrDetId)).ToList();
        if (!itemsToAdd.Any())
        {
            ToastService.ShowInfo("All prescription medicines are already in the table.");
            return;
        }

        foreach (var item in itemsToAdd)
        {
            AddPrescriptionItemToGrid(item);
        }

        showUnbilledPrescriptionModal = false;
        ToastService.ShowSuccess($"Added {itemsToAdd.Count} prescription medicine(s) to billing table.");
    }

    private bool IsPrescriptionItemInGrid(long itemCode, Guid? queueId, string? drugName, Guid? prDetId = null)
    {
        if (CurrentRequest?.details == null || !CurrentRequest.details.Any()) return false;
        var cleanDrugNorm = !string.IsNullOrWhiteSpace(drugName) ? System.Text.RegularExpressions.Regex.Replace(drugName.Trim().ToUpperInvariant(), @"[^A-Z0-9]", "") : "";

        return CurrentRequest.details.Any(d =>
            (queueId.HasValue && queueId.Value != Guid.Empty && d.queue_id == queueId.Value) ||
            (prDetId.HasValue && prDetId.Value != Guid.Empty && d.pr_det_id == prDetId.Value) ||
            (itemCode > 0 && d.itemcode == itemCode) ||
            (!string.IsNullOrWhiteSpace(cleanDrugNorm) && (
                (d.itemcode > 0 && ItemList.Any(i => i.itemcode == d.itemcode && 
                    System.Text.RegularExpressions.Regex.Replace((i.itemname ?? "").Trim().ToUpperInvariant(), @"[^A-Z0-9]", "") == cleanDrugNorm
                )) ||
                (ItemSearchTexts.TryGetValue(d, out var txt) && !string.IsNullOrWhiteSpace(txt) && 
                    System.Text.RegularExpressions.Regex.Replace(txt.Trim().ToUpperInvariant(), @"[^A-Z0-9]", "") == cleanDrugNorm
                )
            ))
        );
    }

    private IEnumerable<inventory_item_master> GetAvailableItemsForRow(sales_detail detail)
    {
        if (SelectedWarehouseCode == null || SelectedWarehouseCode <= 0)
        {
            return Enumerable.Empty<inventory_item_master>();
        }
        var storeStocks = StockList
            .Where(s => s.warehousecode == SelectedWarehouseCode && s.closingstock > 0)
            .ToList();

        if (!storeStocks.Any())
        {
            return Enumerable.Empty<inventory_item_master>();
        }

        var storeItemCodes = storeStocks.Where(s => s.itemcode > 0).Select(s => s.itemcode).ToHashSet();

        return ItemList.Where(i => storeItemCodes.Contains(i.itemcode));
    }

    private int? ActiveBatchSearchRow = null;

    private bool IsStockMatchForItem(sales_detail detail, stock_master stock)
    {
        if (detail == null || stock == null) return false;

        // 1. Exact itemcode match (primary key comparison)
        if (detail.itemcode > 0 && stock.itemcode > 0)
            return detail.itemcode == stock.itemcode;

        var detailItem = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
        var stockItem = ItemList.FirstOrDefault(i => i.itemcode == stock.itemcode);

        string name1 = detailItem?.itemname ?? ItemSearchTexts.GetValueOrDefault(detail, "");
        string name2 = stockItem?.itemname ?? "";

        if (string.IsNullOrWhiteSpace(name1) || string.IsNullOrWhiteSpace(name2))
            return false;

        // Exact name match
        if (string.Equals(name1.Trim(), name2.Trim(), StringComparison.OrdinalIgnoreCase))
            return true;

        // Exact normalized name match (ignoring whitespace and special punctuation)
        string norm1 = System.Text.RegularExpressions.Regex.Replace(name1.ToLowerInvariant(), @"[^a-z0-9]", "");
        string norm2 = System.Text.RegularExpressions.Regex.Replace(name2.ToLowerInvariant(), @"[^a-z0-9]", "");
        
        if (!string.IsNullOrEmpty(norm1) && norm1 == norm2)
            return true;

        return false;
    }

    private IEnumerable<stock_master> GetAvailableStocks(sales_detail detail)
    {
        if (detail == null || detail.itemcode <= 0)
            return Enumerable.Empty<stock_master>();
            
        if (SelectedWarehouseCode == null || SelectedWarehouseCode <= 0)
            return Enumerable.Empty<stock_master>();

        var query = StockList.Where(s => s.warehousecode == SelectedWarehouseCode 
                                      && s.closingstock > 0 
                                      && !string.IsNullOrWhiteSpace(s.batchno) 
                                      && IsStockMatchForItem(detail, s));

        if (!string.IsNullOrEmpty(detail.batchno) && ActiveBatchSearchRow != null)
        {
            query = query.Where(s => s.batchno!.Contains(detail.batchno, StringComparison.OrdinalIgnoreCase));
        }
        
        return query.OrderBy(s => s.expirydate ?? DateTime.MaxValue).GroupBy(s => s.batchno).Select(g => g.First()).ToList();
    }

    private decimal GetItemUnitMrp(inventory_item_master? item)
    {
        if (item == null) return 0;
        decimal packSize = item.packsize > 0 ? item.packsize : 1;
        if (item.mrp > 0)
        {
            return Math.Round(item.mrp / packSize, 2);
        }
        if (item.salesrate > 0)
        {
            return Math.Round(item.salesrate / packSize, 2);
        }
        return 0;
    }

    private void UpdateItemBatchAndExpiryForStore(sales_detail detail, long warehouseCode)
    {
        if (detail == null) return;

        var matchedItem = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
        if (matchedItem != null)
        {
            detail.rate = GetItemUnitMrp(matchedItem);
            detail.uomcode = matchedItem.uomcode;
            detail.taxpercentage = matchedItem.gstpercentage;
        }

        if (warehouseCode <= 0)
        {
            detail.batchno = "";
            detail.expirydate = null;
            CalculateRow(detail);
            return;
        }

        var itemStocks = StockList
            .Where(s => s.warehousecode == warehouseCode 
                     && s.closingstock > 0 
                     && !string.IsNullOrWhiteSpace(s.batchno) 
                     && IsStockMatchForItem(detail, s))
            .ToList();

        if (!itemStocks.Any())
        {
            detail.batchno = "";
            detail.expirydate = null;
            if (detail.itemcode > 0)
            {
                var itemName = matchedItem?.itemname ?? $"Item {detail.itemcode}";
                ToastService.ShowWarning($"Stock is unavailable for '{itemName}' in the selected store.");
            }
            CalculateRow(detail);
            return;
        }

        stock_master? stock = null;
        if (!string.IsNullOrWhiteSpace(detail.batchno))
        {
            stock = itemStocks.FirstOrDefault(s => string.Equals(s.batchno, detail.batchno, StringComparison.OrdinalIgnoreCase));
        }

        if (stock == null)
        {
            // Prefer earliest expiring unexpired batch first, or fallback to earliest
            stock = itemStocks.Where(s => s.expirydate == null || s.expirydate.Value.Date >= DateTime.Today).OrderBy(s => s.expirydate).FirstOrDefault()
                 ?? itemStocks.OrderBy(s => s.expirydate ?? DateTime.MaxValue).FirstOrDefault();
        }

        if (stock != null)
        {
            detail.batchno = stock.batchno;
            detail.expirydate = stock.expirydate;
            detail.manufacturingdate = stock.manufacturingdate;
            ExpiryDateTexts.Remove(detail.GetHashCode());
            if (matchedItem != null)
            {
                detail.rate = GetItemUnitMrp(matchedItem);
            }
            else if (stock.mrpunit > 0)
            {
                detail.rate = stock.mrpunit;
            }
            if (detail.expirydate.HasValue && detail.expirydate.Value.Date < DateTime.Today)
            {
                var itemName = matchedItem?.itemname ?? "Item";
                var expStr = detail.expirydate.Value.ToString("MM/yy", System.Globalization.CultureInfo.InvariantCulture);
                ToastService.ShowError($"Medicine '{itemName}' batch '{stock.batchno}' is expired ({expStr}). Expired medicines cannot be billed.");
            }
        }
        CalculateRow(detail);
    }

    private void OnBatchInput(ChangeEventArgs e, sales_detail detail)
    {
        detail.batchno = e.Value?.ToString() ?? "";
        ActiveBatchSearchRow = CurrentRequest.details.IndexOf(detail);
        
        var pool = SelectedWarehouseCode > 0 
            ? StockList.Where(s => s.warehousecode == SelectedWarehouseCode)
            : StockList;

        var stock = pool.FirstOrDefault(s => (detail.itemcode <= 0 || s.itemcode == detail.itemcode || IsStockMatchForItem(detail, s)) 
                                           && string.Equals(s.batchno, detail.batchno, StringComparison.OrdinalIgnoreCase));
        if (stock == null && !string.IsNullOrWhiteSpace(detail.batchno))
        {
            stock = pool.FirstOrDefault(s => (detail.itemcode <= 0 || s.itemcode == detail.itemcode || IsStockMatchForItem(detail, s)) 
                                            && s.batchno != null 
                                            && s.batchno.Contains(detail.batchno, StringComparison.OrdinalIgnoreCase));
        }

        if (stock != null)
        {
            detail.expirydate = stock.expirydate;
            detail.manufacturingdate = stock.manufacturingdate;
            ExpiryDateTexts.Remove(detail.GetHashCode());
            var matchedItem = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode || (stock != null && i.itemcode == stock.itemcode));
            if (matchedItem != null)
            {
                detail.rate = GetItemUnitMrp(matchedItem);
            }
            else if (stock.mrpunit > 0)
            {
                detail.rate = stock.mrpunit;
            }
            if (detail.itemcode <= 0 && stock.itemcode > 0)
            {
                detail.itemcode = stock.itemcode;
                var itemName = ItemList.FirstOrDefault(i => i.itemcode == stock.itemcode)?.itemname;
                if (!string.IsNullOrEmpty(itemName))
                {
                    ItemSearchTexts[detail] = itemName;
                }
            }
        }
        else
        {
            var matchedItem = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
            if (matchedItem != null && detail.rate <= 0)
            {
                detail.rate = GetItemUnitMrp(matchedItem);
            }
        }
        CalculateRow(detail);
    }

