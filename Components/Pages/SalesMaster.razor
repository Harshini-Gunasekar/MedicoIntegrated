        if (targetId.HasValue) {
            await LoadPrescriptions(targetId.Value);
        } else {
            ToastService.ShowWarning("Please enter or select a valid Patient ID first.");
        }
    }

    private async Task LoadPrescriptions(long custId)
    {
        try
        {
            List<PharmacyPrescriptionQueueRow>? rows = null;

            // 1. Try fetching from pharmacy queue with standard tenant headers
            try
            {
                var client = CreateClient();
                var responseString = await client.GetStringAsync($"api/ItemMaster/pharmacy-queue/by-custid?custid={custId}");
                if (!string.IsNullOrWhiteSpace(responseString))
                {
                    rows = ParsePharmacyQueueJson(responseString);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Pharmacy queue default tenant request exception: " + ex.Message);
            }

            // 2. If no valid queue rows found, retry pharmacy queue with tenantcode header "0010"
            if (rows == null || !rows.Any(r => r.status != "DISPENSED" && r.status != "CANCELLED"))
            {
                try
                {
                    var client = CreateClient();
                    client.DefaultRequestHeaders.Remove("tenantcode");
                    client.DefaultRequestHeaders.Add("tenantcode", "0010");
                    var responseString = await client.GetStringAsync($"api/ItemMaster/pharmacy-queue/by-custid?custid={custId}");
                    if (!string.IsNullOrWhiteSpace(responseString))
                    {
                        var parsed = ParsePharmacyQueueJson(responseString);
                        if (parsed != null && parsed.Any())
                        {
                            rows = parsed;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Pharmacy queue 0010 tenant request exception: " + ex.Message);
                }
            }

            var validRows = rows?.Where(r => r.status != "DISPENSED" && r.status != "CANCELLED").ToList();

            if (validRows != null && validRows.Any())
            {
                PopulateGridWithQueueRows(validRows);
                return;
            }

            // 3. Fallback: Query Case Sheet history for patient to retrieve saved prescribed medicines
            if (CaseSheetService != null)
            {
                var history = await CaseSheetService.GetPatientHistoryAsync((decimal)custId, 1, 20);
                if (history != null && history.Any())
                {
                    // Locate the latest visit with prescription items
                    var latestWithPrescription = history
                        .Where(h => h.prescription != null && h.prescription.items != null && h.prescription.items.Any(i => !string.IsNullOrWhiteSpace(i.drug_name)))
                        .OrderByDescending(h => h.visit_date ?? DateTime.MinValue)
                        .FirstOrDefault();

                    if (latestWithPrescription != null && latestWithPrescription.prescription?.items != null)
                    {
                        PopulateGridWithCaseSheetItems(latestWithPrescription.prescription.items);
                        return;
                    }
                }
            }

            ToastService.ShowWarning($"No pending prescriptions found for Patient ID: CUST-{custId}.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading prescriptions: {ex.Message}");
            Console.WriteLine($"Error loading prescriptions: {ex.Message}");
            StateHasChanged();
        }
    }

    private List<PharmacyPrescriptionQueueRow>? ParsePharmacyQueueJson(string responseString)
    {
        var options = new JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try
        {
            using var doc = JsonDocument.Parse(responseString);
            var root = doc.RootElement;
            JsonElement dataElement = root;

            if (root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var dataProp))
            {
                dataElement = dataProp;
            }

            if (dataElement.ValueKind == JsonValueKind.Array)
            {
                if (dataElement.GetArrayLength() > 0)
                {
                    var first = dataElement[0];
                    if (first.ValueKind == JsonValueKind.Object && first.TryGetProperty("items", out _))
                    {
                        var groups = JsonSerializer.Deserialize<List<PharmacyQueueGroup>>(dataElement.GetRawText(), options);
                        return groups?.SelectMany(g => g.items ?? new List<PharmacyPrescriptionQueueRow>()).ToList();
                    }
                    else
                    {
                        return JsonSerializer.Deserialize<List<PharmacyPrescriptionQueueRow>>(dataElement.GetRawText(), options);
                    }
                }
                return new List<PharmacyPrescriptionQueueRow>();
            }
            else if (dataElement.ValueKind == JsonValueKind.Object)
            {
                if (dataElement.TryGetProperty("items", out _))
                {
                    var group = JsonSerializer.Deserialize<PharmacyQueueGroup>(dataElement.GetRawText(), options);
                    return group?.items;
                }
                else
                {
                    var singleRow = JsonSerializer.Deserialize<PharmacyPrescriptionQueueRow>(dataElement.GetRawText(), options);
                    return singleRow != null ? new List<PharmacyPrescriptionQueueRow> { singleRow } : null;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error parsing prescription queue JSON: " + ex.Message);
        }
        return null;
    }

    private int? ParseDaysFromDuration(int? daysVal, string? durationVal)
    {
        if (daysVal.HasValue && daysVal.Value > 0) return daysVal.Value;
        if (!string.IsNullOrWhiteSpace(durationVal))
        {
            var match = System.Text.RegularExpressions.Regex.Match(durationVal, @"\d+");
            if (match.Success && int.TryParse(match.Value, out var num) && num > 0)
            {
                return num;
            }
        }
        return null;
    }

    private void PopulateGridWithQueueRows(List<PharmacyPrescriptionQueueRow> validRows)
    {
        if (CurrentRequest.details.Count == 1 && CurrentRequest.details[0].itemcode == 0)
        {
            ItemSearchTexts.Remove(CurrentRequest.details[0]);
            CurrentRequest.details.Clear();
            EditableRows.Clear();
        }

        bool itemsAdded = false;
        int detectedPrescDays = 0;
        foreach (var item in validRows)
        {
            int? itemDays = ParseDaysFromDuration(item.days, item.duration);
            if (itemDays.HasValue && itemDays.Value > detectedPrescDays)
            {
                detectedPrescDays = itemDays.Value;
            }

            var detail = new sales_detail
            {
                tenantcode = DefaultTenant,
                itemcode = item.matched_itemcode ?? 0,
                days = itemDays,
                quantity = item.qty ?? 1,
                queue_id = item.queue_id
            };
            
            if (detail.itemcode == 0 && !string.IsNullOrWhiteSpace(item.drug_name))
            {
                var localMatch = ItemList.FirstOrDefault(i => 
                    string.Equals(i.itemname, item.drug_name, StringComparison.OrdinalIgnoreCase) ||
                    (i.itemname != null && i.itemname.Trim().Equals(item.drug_name.Trim(), StringComparison.OrdinalIgnoreCase))
                );
                if (localMatch == null && item.drug_name.Length >= 3)
                {
                    localMatch = ItemList.FirstOrDefault(i => i.itemname != null && i.itemname.Contains(item.drug_name, StringComparison.OrdinalIgnoreCase));
                }
                if (localMatch != null)
                {
                    detail.itemcode = localMatch.itemcode;
                }
            }

            if (detail.itemcode > 0)
            {
                OnItemChanged(detail);
            }

            CurrentRequest.details.Add(detail);
            EditableRows.Add(detail);

            if (itemDays.HasValue && itemDays.Value > 0)
            {
                _originalPrescriptionMap[detail] = (detail.quantity, itemDays.Value);
            }
            else
            {
                _originalPrescriptionMap[detail] = (detail.quantity, 1);
            }
            
            var matchedName = detail.itemcode > 0 ? ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname : null;
            ItemSearchTexts[detail] = !string.IsNullOrWhiteSpace(matchedName) ? matchedName : (!string.IsNullOrWhiteSpace(item.matched_itemname) ? item.matched_itemname : (item.drug_name ?? ""));

            itemsAdded = true;
        }
        
        if (detectedPrescDays > 0)
        {
            CurrentRequest.master.prescribeddays = detectedPrescDays;
        }

        if (itemsAdded)
        {
            CalculateTotals();
            StateHasChanged();
            ToastService.ShowSuccess($"Loaded {validRows.Count} prescription item(s) from pharmacy queue.");
        }
    }

    private void PopulateGridWithCaseSheetItems(List<OpPrescriptionDetailModel> prescItems)
    {
        if (CurrentRequest.details.Count == 1 && CurrentRequest.details[0].itemcode == 0)
        {
            ItemSearchTexts.Remove(CurrentRequest.details[0]);
            CurrentRequest.details.Clear();
            EditableRows.Clear();
        }

        bool itemsAdded = false;
        int count = 0;
        int detectedPrescDays = 0;
        foreach (var item in prescItems)
        {
            if (string.IsNullOrWhiteSpace(item.drug_name)) continue;

            int? itemDays = ParseDaysFromDuration(item.days, item.duration);
            if (itemDays.HasValue && itemDays.Value > detectedPrescDays)
            {
                detectedPrescDays = itemDays.Value;
            }

            var detail = new sales_detail
            {
                tenantcode = DefaultTenant,
                itemcode = item.drug_code.HasValue ? (long)item.drug_code.Value : 0,
                days = itemDays,
                quantity = item.qty ?? 1
            };

            // Match against ItemList if itemcode is missing/invalid or 0
            if (detail.itemcode == 0 || !ItemList.Any(i => i.itemcode == detail.itemcode))
            {
                var localMatch = ItemList.FirstOrDefault(i => 
                    string.Equals(i.itemname, item.drug_name, StringComparison.OrdinalIgnoreCase) ||
                    (i.itemname != null && i.itemname.Trim().Equals(item.drug_name.Trim(), StringComparison.OrdinalIgnoreCase))
                );

                if (localMatch == null && item.drug_name.Length >= 3)
                {
                    localMatch = ItemList.FirstOrDefault(i => i.itemname != null && i.itemname.Contains(item.drug_name, StringComparison.OrdinalIgnoreCase));
                }

                if (localMatch != null)
                {
                    detail.itemcode = localMatch.itemcode;
                }
            }

            if (detail.itemcode > 0)
            {
                OnItemChanged(detail);
            }

            CurrentRequest.details.Add(detail);
            EditableRows.Add(detail);

            if (itemDays.HasValue && itemDays.Value > 0)
            {
                _originalPrescriptionMap[detail] = (detail.quantity, itemDays.Value);
            }
            else
            {
                _originalPrescriptionMap[detail] = (detail.quantity, 1);
            }

            var matchedName = detail.itemcode > 0 ? ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname : null;
            ItemSearchTexts[detail] = !string.IsNullOrWhiteSpace(matchedName) ? matchedName : (item.drug_name ?? "");

            itemsAdded = true;
            count++;
        }

        if (detectedPrescDays > 0)
        {
            CurrentRequest.master.prescribeddays = detectedPrescDays;
        }

        if (itemsAdded)
        {
            CalculateTotals();
            StateHasChanged();
            ToastService.ShowSuccess($"Loaded {count} prescribed medicine(s) from Case Sheet.");
        }
    }

    private IEnumerable<inventory_item_master> GetAvailableItemsForRow(sales_detail detail)
    {
        if (SelectedWarehouseCode == null || SelectedWarehouseCode <= 0)
        {
            return Enumerable.Empty<inventory_item_master>();
        }
        var storeStocks = StockList
            .Where(s => s.warehousecode == SelectedWarehouseCode && s.closingstock > 0)
            .ToList();

        if (!storeStocks.Any())
        {
            return Enumerable.Empty<inventory_item_master>();
        }

        var storeItemCodes = storeStocks.Where(s => s.itemcode > 0).Select(s => s.itemcode).ToHashSet();

        return ItemList.Where(i => 
            storeItemCodes.Contains(i.itemcode) ||
            storeStocks.Any(s => s.itemcode == i.itemcode || (!string.IsNullOrWhiteSpace(i.itemname) && !string.IsNullOrWhiteSpace(s.batchno) && string.Equals(i.itemname.Trim(), s.batchno.Trim(), StringComparison.OrdinalIgnoreCase)))
        );
    }

    private int? ActiveBatchSearchRow = null;

    private bool IsStockMatchForItem(sales_detail detail, stock_master stock)
    {
        if (detail == null || stock == null) return false;

        if (detail.itemcode > 0 && stock.itemcode == detail.itemcode)
            return true;

        var detailItem = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
        var stockItem = ItemList.FirstOrDefault(i => i.itemcode == stock.itemcode);

        string name1 = detailItem?.itemname ?? ItemSearchTexts.GetValueOrDefault(detail, "");
        string name2 = stockItem?.itemname ?? "";

        if (string.IsNullOrWhiteSpace(name1) || string.IsNullOrWhiteSpace(name2))
            return false;

        if (string.Equals(name1.Trim(), name2.Trim(), StringComparison.OrdinalIgnoreCase))
            return true;

        string norm1 = System.Text.RegularExpressions.Regex.Replace(name1.ToLowerInvariant(), @"[^a-z0-9]", "");
        string norm2 = System.Text.RegularExpressions.Regex.Replace(name2.ToLowerInvariant(), @"[^a-z0-9]", "");
        
        if (norm1 == norm2 || (norm1.Length >= 4 && norm2.Length >= 4 && (norm1.Contains(norm2) || norm2.Contains(norm1))))
            return true;

        var nums1 = System.Text.RegularExpressions.Regex.Matches(name1, @"\d+").Select(m => m.Value).ToList();
        var nums2 = System.Text.RegularExpressions.Regex.Matches(name2, @"\d+").Select(m => m.Value).ToList();

        var prefix1 = System.Text.RegularExpressions.Regex.Match(name1.ToLowerInvariant(), @"[a-z]{3}").Value;
        var prefix2 = System.Text.RegularExpressions.Regex.Match(name2.ToLowerInvariant(), @"[a-z]{3}").Value;

        if (!string.IsNullOrEmpty(prefix1) && !string.IsNullOrEmpty(prefix2) && prefix1 == prefix2)
        {
            if (nums1.Any() && nums2.Any())
            {
                if (nums1.Intersect(nums2).Any())
                    return true;
            }
            else
            {
                return true;
            }
        }

        return false;
    }

    private IEnumerable<stock_master> GetAvailableStocks(sales_detail detail)
    {
        if (detail == null || detail.itemcode <= 0)
            return Enumerable.Empty<stock_master>();
            
        if (SelectedWarehouseCode == null || SelectedWarehouseCode <= 0)
            return Enumerable.Empty<stock_master>();

        var query = StockList.Where(s => s.warehousecode == SelectedWarehouseCode 
                                      && s.closingstock > 0 
                                      && !string.IsNullOrWhiteSpace(s.batchno) 
                                      && IsStockMatchForItem(detail, s));

        if (!string.IsNullOrEmpty(detail.batchno) && ActiveBatchSearchRow != null)
        {
            query = query.Where(s => s.batchno!.Contains(detail.batchno, StringComparison.OrdinalIgnoreCase));
        }
        
        return query.OrderBy(s => s.expirydate ?? DateTime.MaxValue).GroupBy(s => s.batchno).Select(g => g.First()).ToList();
    }

    private decimal GetItemUnitMrp(inventory_item_master? item)
    {
        if (item == null) return 0;
        decimal packSize = item.packsize > 0 ? item.packsize : 1;
        if (item.mrp > 0)
        {
            return Math.Round(item.mrp / packSize, 2);
        }
        if (item.salesrate > 0)
        {
            return Math.Round(item.salesrate / packSize, 2);
        }
        return 0;
    }

    private void UpdateItemBatchAndExpiryForStore(sales_detail detail, long warehouseCode)
    {
        if (detail == null) return;

        var matchedItem = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
        if (matchedItem != null)
        {
            detail.rate = GetItemUnitMrp(matchedItem);
            detail.uomcode = matchedItem.uomcode;
            detail.taxpercentage = matchedItem.gstpercentage;
        }

        if (warehouseCode <= 0)
        {
            detail.batchno = "";
            detail.expirydate = null;
            CalculateRow(detail);
            return;
        }

        var itemStocks = StockList
            .Where(s => s.warehousecode == warehouseCode 
                     && s.closingstock > 0 
                     && !string.IsNullOrWhiteSpace(s.batchno) 
                     && IsStockMatchForItem(detail, s))
            .ToList();

        if (!itemStocks.Any())
        {
            detail.batchno = "";
            detail.expirydate = null;
            if (detail.itemcode > 0)
            {
                var itemName = matchedItem?.itemname ?? $"Item {detail.itemcode}";
                ToastService.ShowWarning($"Stock is unavailable for '{itemName}' in the selected store.");
            }
            CalculateRow(detail);
            return;
        }

        stock_master? stock = null;
        if (!string.IsNullOrWhiteSpace(detail.batchno))
        {
            stock = itemStocks.FirstOrDefault(s => string.Equals(s.batchno, detail.batchno, StringComparison.OrdinalIgnoreCase));
        }

        if (stock == null)
        {
            // Prefer earliest expiring unexpired batch first, or fallback to earliest
            stock = itemStocks.Where(s => s.expirydate == null || s.expirydate.Value.Date >= DateTime.Today).OrderBy(s => s.expirydate).FirstOrDefault()
                 ?? itemStocks.OrderBy(s => s.expirydate ?? DateTime.MaxValue).FirstOrDefault();
        }

        if (stock != null)
        {
            detail.batchno = stock.batchno;
            detail.expirydate = stock.expirydate;
            detail.manufacturingdate = stock.manufacturingdate;
            ExpiryDateTexts.Remove(detail.GetHashCode());
            if (matchedItem != null)
            {
                detail.rate = GetItemUnitMrp(matchedItem);
            }
            else if (stock.mrpunit > 0)
            {
                detail.rate = stock.mrpunit;
            }
            if (detail.expirydate.HasValue && detail.expirydate.Value.Date < DateTime.Today)
            {
                var itemName = matchedItem?.itemname ?? "Item";
                var expStr = detail.expirydate.Value.ToString("MM/yy", System.Globalization.CultureInfo.InvariantCulture);
                ToastService.ShowError($"Medicine '{itemName}' batch '{stock.batchno}' is expired ({expStr}). Expired medicines cannot be billed.");
            }
        }
        CalculateRow(detail);
    }

