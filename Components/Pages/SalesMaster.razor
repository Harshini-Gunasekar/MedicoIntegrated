    private void OnItemChanged(sales_detail detail)
    {
        var item = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
        if (item != null) {
            detail.rate = GetItemUnitMrp(item);
            detail.uomcode = item.uomcode;
            detail.taxpercentage = 0;
            detail.taxamount = 0;
            
            bool isTab = IsTabletItem(detail.itemcode, item.itemname);
            if (!isTab)
            {
                detail.quantity = 1;
            }
            else if (detail.quantity <= 0)
            {
                detail.quantity = (decimal)Math.Max(1, (detail.days ?? 1));
            }

            // Suggest earliest expiring batch from stock for the selected store (or across stores if not set) and fill batch, expiry date & QTY
            UpdateItemBatchAndExpiryForStore(detail, SelectedWarehouseCode ?? 0);
        }
    }

    private void CalculateRow(sales_detail detail)
    {
        detail.amount = detail.quantity * detail.rate;
        detail.discountamount = (detail.amount * detail.discountpercentage) / 100;
        var afterDiscount = detail.amount - detail.discountamount;
        detail.taxpercentage = 0;
        detail.taxamount = 0;
        detail.totalamount = afterDiscount;
        CalculateTotals();
    }

    private decimal? GetMasterDiscountPercentage() => CurrentRequest.master.discountpercentage == 0 ? null : CurrentRequest.master.discountpercentage;

    private void SetMasterDiscountPercentage(decimal? val)
    {
        CurrentRequest.master.discountpercentage = val ?? 0;

        decimal gross = CurrentRequest.details.Where(x => x.itemcode > 0).Sum(d => d.amount);
        if (gross > 0 && val.HasValue && val.Value > 0)
        {
            CurrentRequest.master.discountamount = Math.Round((gross * val.Value) / 100, 2);
        }
        else
        {
            CurrentRequest.master.discountamount = 0;
        }

        CalculateTotals();
    }

    private decimal? GetMasterDiscount() => CurrentRequest.master.discountamount == 0 ? null : CurrentRequest.master.discountamount;

    private void SetMasterDiscount(decimal? val)
    {
        CurrentRequest.master.discountamount = val ?? 0;

        decimal gross = CurrentRequest.details.Where(x => x.itemcode > 0).Sum(d => d.amount);
        if (gross > 0 && val.HasValue && val.Value > 0)
        {
            CurrentRequest.master.discountpercentage = Math.Round((val.Value / gross) * 100, 2);
        }
        else
        {
            CurrentRequest.master.discountpercentage = 0;
        }

        CalculateTotals();
    }

    private void CalculateTotals()
    {
        CurrentRequest.master.grossamount = CurrentRequest.details.Sum(d => d.amount);
        CurrentRequest.master.taxamount = 0;

        if (CurrentRequest.master.discountpercentage > 0 && CurrentRequest.master.grossamount > 0)
        {
            CurrentRequest.master.discountamount = Math.Round((CurrentRequest.master.grossamount * CurrentRequest.master.discountpercentage) / 100, 2);
        }

        var itemsTotal = CurrentRequest.details.Sum(d => d.totalamount);
        var unroundedTotal = Math.Max(0, itemsTotal - CurrentRequest.master.discountamount);
        var integerPart = Math.Truncate(unroundedTotal);
        var fractionPart = unroundedTotal - integerPart;

        decimal roundedTotal;
        if (fractionPart >= 0.5m)
        {
            roundedTotal = integerPart + 1m;
        }
        else
        {
            roundedTotal = integerPart;
        }

        CurrentRequest.master.roundoff = roundedTotal - unroundedTotal;
        CurrentRequest.master.netamount = roundedTotal;
    }

    private void AddDetailRow()
    {
        EditableRows.Clear();
        var newRow = new sales_detail { 
            tenantcode = DefaultTenant,
            days = 1,
            prescribeddays = 1,
            no_of_days = 1,
            duration = "1",
            expirydate = null
        };
        CurrentRequest.details.Add(newRow);
        EditableRows.Add(newRow);
    }

    private void RemoveDetailRow(sales_detail detail)
    {
        ItemSearchTexts.Remove(detail);
        ExpiryDateTexts.Remove(detail.GetHashCode());
        _originalPrescriptionMap.Remove(detail);

        // Reset IsAdded flag in PendingPrescriptions if this detail was from a prescription
        var pendingItem = PendingPrescriptions.FirstOrDefault(p =>
            (detail.itemcode > 0 && p.MatchedItemCode.HasValue && p.MatchedItemCode.Value == detail.itemcode) ||
            (detail.queue_id != Guid.Empty && p.QueueId == detail.queue_id)
        );
        if (pendingItem != null)
        {
            pendingItem.IsAdded = false;
        }

        if (CurrentRequest.details != null && CurrentRequest.details.Count <= 1)
        {
            detail.itemcode = 0;
            detail.quantity = 0;
            detail.rate = 0;
            detail.discountpercentage = 0;
            detail.discountamount = 0;
            detail.taxpercentage = 0;
            detail.taxamount = 0;
            detail.amount = 0;
            detail.totalamount = 0;
            detail.batchno = "";
            detail.expirydate = null;
            detail.queue_id = Guid.Empty;
            if (!EditableRows.Contains(detail)) EditableRows.Add(detail);
        }
        else if (CurrentRequest.details != null)
        {
            CurrentRequest.details.Remove(detail);
            EditableRows.Remove(detail);
        }
        CalculateTotals();
    }

    private async Task SaveSales()
    {
        Console.WriteLine("[SaveSales] Invoked.");
        if (IsEdit && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit sales.");
            return;
        }
        if (!IsEdit && !hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add sales.");
            return;
        }
        CalculateTotals();

        if (SelectedWarehouseCode == null || SelectedWarehouseCode <= 0) {
            ToastService.ShowWarning("Please select Store");
            return;
        }

        if (SelectedSalesType == "OP Sales" || SelectedSalesType == "IP Sales" || SelectedSalesType == "IP / OP Sales") {
            if (!string.IsNullOrWhiteSpace(PatientNameSearchText)) CurrentRequest.master.patientname = PatientNameSearchText;
            if (!string.IsNullOrWhiteSpace(PatientIdSearchText)) CurrentRequest.master.patientid = PatientIdSearchText;
            if (!string.IsNullOrWhiteSpace(PatientMobileSearchText)) CurrentRequest.master.mobileno = PatientMobileSearchText;

            if (!string.IsNullOrWhiteSpace(CurrentRequest.master.patientname))
            {
                CurrentRequest.master.patientname = FormatPatientNameWithAgeGender(CurrentRequest.master.patientname, CurrentRequest.master.customercode);
                CurrentRequest.master.customername = CurrentRequest.master.patientname;
                PatientNameSearchText = CurrentRequest.master.patientname;
            }

            if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientname) && string.IsNullOrWhiteSpace(CurrentRequest.master.patientid)) {
                ToastService.ShowWarning($"Please select {(SelectedSalesType == "IP Sales" ? "an IP" : "an OP")} patient");
                return;
            }

            // Resolve customercode for OP/IP if not already assigned
            if (!CurrentRequest.master.customercode.HasValue || CurrentRequest.master.customercode.Value <= 0)
            {
                if (SelectedSalesType == "IP Sales")
                {
                    var ipMatch = IpRegistrationList.FirstOrDefault(i => !i.isdeleted && (
                        (!string.IsNullOrWhiteSpace(PatientIdSearchText) && (string.Equals(i.ip_no?.Trim(), PatientIdSearchText.Trim(), StringComparison.OrdinalIgnoreCase) || i.custid.ToString() == PatientIdSearchText.Trim())) ||
                        (!string.IsNullOrWhiteSpace(PatientMobileSearchText) && string.Equals(i.mobile?.Trim(), PatientMobileSearchText.Trim())) ||
                        (!string.IsNullOrWhiteSpace(PatientNameSearchText) && string.Equals(i.patient_name?.Trim(), PatientNameSearchText.Trim(), StringComparison.OrdinalIgnoreCase))
                    ));
                    if (ipMatch != null && ipMatch.custid > 0)
                    {
                        CurrentRequest.master.customercode = (long)ipMatch.custid;
                        if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientid)) CurrentRequest.master.patientid = ipMatch.ip_no ?? ipMatch.custid.ToString();
                    }
                }
                else
                {
                    var opMatch = OpRegistrationList.FirstOrDefault(o => !o.isdeleted && (
                        (!string.IsNullOrWhiteSpace(PatientIdSearchText) && (string.Equals(o.op_no?.Trim(), PatientIdSearchText.Trim(), StringComparison.OrdinalIgnoreCase) || o.custid.ToString() == PatientIdSearchText.Trim())) ||
                        (!string.IsNullOrWhiteSpace(PatientMobileSearchText) && string.Equals(o.mobile?.Trim(), PatientMobileSearchText.Trim())) ||
                        (!string.IsNullOrWhiteSpace(PatientNameSearchText) && string.Equals(o.patient_name?.Trim(), PatientNameSearchText.Trim(), StringComparison.OrdinalIgnoreCase))
                    ));
                    if (opMatch != null && opMatch.custid > 0)
                    {
                        CurrentRequest.master.customercode = (long)opMatch.custid;
                        if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientid)) CurrentRequest.master.patientid = opMatch.op_no ?? opMatch.custid.ToString();
                    }
                }
            }
        } else {
            if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientname)) {
                ToastService.ShowWarning("Please enter Patient Name");
                return;
            }
        }

        // Global Customer Resolution across all sales types if customercode is still null / 0:
        if (!CurrentRequest.master.customercode.HasValue || CurrentRequest.master.customercode.Value <= 0)
        {
            // 1. Check patientid if numeric custid
            if (!string.IsNullOrWhiteSpace(CurrentRequest.master.patientid) && long.TryParse(CurrentRequest.master.patientid.Trim(), out var parsedPid) && parsedPid > 0)
            {
                CurrentRequest.master.customercode = parsedPid;
            }

            // 2. Match by mobile in CustomerList / PatientPartitionList / OP / IP
            if ((!CurrentRequest.master.customercode.HasValue || CurrentRequest.master.customercode.Value <= 0) && !string.IsNullOrWhiteSpace(CurrentRequest.master.mobileno))
            {
                var cleanMob = CurrentRequest.master.mobileno.Trim();
                var custMatch = CustomerList.FirstOrDefault(c => !string.IsNullOrWhiteSpace(c.mobile) && c.mobile.Trim() == cleanMob && c.customercode > 0);
                if (custMatch != null)
                {
                    CurrentRequest.master.customercode = custMatch.customercode;
                    if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientid)) CurrentRequest.master.patientid = custMatch.customercode.ToString();
                }
                else
                {
                    var partMatch = PatientPartitionList.FirstOrDefault(p => (!string.IsNullOrWhiteSpace(p.mobile) && p.mobile.Trim() == cleanMob) || (!string.IsNullOrWhiteSpace(p.mobileno) && p.mobileno.Trim() == cleanMob));
                    if (partMatch != null && partMatch.custid.HasValue && partMatch.custid.Value > 0)
                    {
                        CurrentRequest.master.customercode = partMatch.custid.Value;
                        if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientid)) CurrentRequest.master.patientid = partMatch.custid.Value.ToString();
                    }
                    else
                    {
                        var opMatch = OpRegistrationList.FirstOrDefault(o => !string.IsNullOrWhiteSpace(o.mobile) && o.mobile.Trim() == cleanMob && o.custid > 0);
                        if (opMatch != null)
                        {
                            CurrentRequest.master.customercode = (long)opMatch.custid;
                            if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientid)) CurrentRequest.master.patientid = opMatch.custid.ToString();
                        }
                    }
                }
            }

            // 3. Match by name in CustomerList / PatientPartitionList / OP / IP
            if ((!CurrentRequest.master.customercode.HasValue || CurrentRequest.master.customercode.Value <= 0) && !string.IsNullOrWhiteSpace(CurrentRequest.master.patientname))
            {
                var cleanNm = CurrentRequest.master.patientname.Trim();
                var custMatch = CustomerList.FirstOrDefault(c => !string.IsNullOrWhiteSpace(c.customername) && string.Equals(c.customername.Trim(), cleanNm, StringComparison.OrdinalIgnoreCase) && c.customercode > 0);
                if (custMatch != null)
                {
                    CurrentRequest.master.customercode = custMatch.customercode;
                    if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientid)) CurrentRequest.master.patientid = custMatch.customercode.ToString();
                }
                else
                {
                    var partMatch = PatientPartitionList.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.name) && string.Equals(p.name.Trim(), cleanNm, StringComparison.OrdinalIgnoreCase));
                    if (partMatch != null && partMatch.custid.HasValue && partMatch.custid.Value > 0)
                    {
                        CurrentRequest.master.customercode = partMatch.custid.Value;
                        if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientid)) CurrentRequest.master.patientid = partMatch.custid.Value.ToString();
                    }
                    else
                    {
                        var opMatch = OpRegistrationList.FirstOrDefault(o => !string.IsNullOrWhiteSpace(o.patient_name) && string.Equals(o.patient_name.Trim(), cleanNm, StringComparison.OrdinalIgnoreCase) && o.custid > 0);
                        if (opMatch != null)
                        {
                            CurrentRequest.master.customercode = (long)opMatch.custid;
                            if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientid)) CurrentRequest.master.patientid = opMatch.custid.ToString();
                        }
                    }
                }
            }
        }

        CurrentRequest.master.customername = !string.IsNullOrWhiteSpace(CurrentRequest.master.patientname) ? CurrentRequest.master.patientname : CurrentRequest.master.customername;
        if (!string.IsNullOrWhiteSpace(CurrentRequest.master.patientname))
        {
            CurrentRequest.master.patientname = FormatPatientNameWithAgeGender(CurrentRequest.master.patientname, CurrentRequest.master.customercode);
            CurrentRequest.master.customername = CurrentRequest.master.patientname;
            PatientNameSearchText = CurrentRequest.master.patientname;
        }
        if (CurrentRequest.master.customercode.HasValue && CurrentRequest.master.customercode.Value > 0 && string.IsNullOrWhiteSpace(CurrentRequest.master.patientid))
        {
            CurrentRequest.master.patientid = CurrentRequest.master.customercode.Value.ToString();
        }

        // Filter out completely blank rows
        var activeDetails = CurrentRequest.details
            .Where(d => d.itemcode > 0 || !string.IsNullOrWhiteSpace(d.batchno) || d.quantity > 0 || d.days.HasValue)
            .ToList();

        if (!activeDetails.Any()) {
            ToastService.ShowWarning("Please add at least one Item");
            if (!CurrentRequest.details.Any()) AddDetailRow();
            return;
        }

        // Validate each item row for missing fields
        for (int i = 0; i < activeDetails.Count; i++)
        {
            var detail = activeDetails[i];
            var rowNum = i + 1;
            var itemName = ItemList.FirstOrDefault(it => it.itemcode == detail.itemcode)?.itemname;
            var itemLabel = !string.IsNullOrWhiteSpace(itemName) ? $"'{itemName}'" : $"Item in Row {rowNum}";

            if (detail.itemcode <= 0)
            {
                ToastService.ShowWarning($"Please select an Item for Row {rowNum}");
                return;
            }

            if (string.IsNullOrWhiteSpace(detail.batchno))
            {
                ToastService.ShowWarning($"Please enter Batch No for {itemLabel}");
                return;
            }

            if (!detail.days.HasValue || detail.days.Value <= 0)
            {
                ToastService.ShowWarning($"Please enter Days for {itemLabel}");
                return;
            }

            if (detail.quantity <= 0)
            {
                ToastService.ShowWarning($"Please enter Quantity for {itemLabel}");
                return;
            }

            if (detail.rate <= 0)
            {
                ToastService.ShowWarning($"Please enter Rate for {itemLabel}");
                return;
            }
        }

        CurrentRequest.details = activeDetails;

        // Check if any medicine in the bill is expired
        var expiredItems = CurrentRequest.details.Where(d => d.itemcode > 0 && d.expirydate.HasValue && d.expirydate.Value.Date < DateTime.Today).ToList();
        if (expiredItems.Any())
        {
            var firstExpired = expiredItems.First();
            var itemName = ItemList.FirstOrDefault(i => i.itemcode == firstExpired.itemcode)?.itemname ?? $"Item {firstExpired.itemcode}";
            var expStr = firstExpired.expirydate.Value.ToString("MM/yy", System.Globalization.CultureInfo.InvariantCulture);
            ToastService.ShowError($"Cannot save bill: '{itemName}' (Batch: {firstExpired.batchno}) is expired ({expStr}). Expired medicines cannot be billed.");
            return;
        }

        foreach (var detail in CurrentRequest.details.Where(d => d.itemcode > 0))
        {
            detail.warehousecode = SelectedWarehouseCode;
        }

        IsSaving = true;
        try {
            var client = CreateClient();
            
            // Ensure client base address has trailing slash
            var baseAddrStr = client.BaseAddress?.ToString() ?? Configuration["ApiBaseUrl"] ?? "";
            if (!string.IsNullOrEmpty(baseAddrStr))
            {
                if (!baseAddrStr.EndsWith("/")) baseAddrStr += "/";
                client.BaseAddress = new Uri(baseAddrStr);
            }

            CurrentRequest.master.tenantcode = DefaultTenant;
            
            // Branch resolution (bh_code)
            if (SelectedBhCode > 0)
            {
                CurrentRequest.master.bh_code = SelectedBhCode;
                var matchedBranch = BranchList.FirstOrDefault(b => b.bh_code == SelectedBhCode);
                if (matchedBranch != null)
                {
                    CurrentRequest.master.branchcode = !string.IsNullOrWhiteSpace(matchedBranch.short_name) ? matchedBranch.short_name : matchedBranch.name;
                }
            }
            else if (BranchList != null && BranchList.Any())
            {
                var defaultBranch = BranchList.FirstOrDefault(b => b.is_main_branch == true) ?? BranchList.First();
                SelectedBhCode = defaultBranch.bh_code;
                CurrentRequest.master.bh_code = SelectedBhCode;
                CurrentRequest.master.branchcode = !string.IsNullOrWhiteSpace(defaultBranch.short_name) ? defaultBranch.short_name : defaultBranch.name;
            }
            else
            {
                CurrentRequest.master.bh_code = 1;
                CurrentRequest.master.branchcode ??= "BLR001";
            }

            // Counter resolution (cntcode)
            if (SelectedCntCode > 0)
            {
                CurrentRequest.master.cntcode = SelectedCntCode;
            }
            else if (CounterList != null && CounterList.Any())
            {
                var filtered = GetFilteredCounters().ToList();
                SelectedCntCode = filtered.Any() ? filtered.First().cntcode : CounterList.First().cntcode;
                CurrentRequest.master.cntcode = SelectedCntCode;
            }
            else
            {
                CurrentRequest.master.cntcode = 1;
            }

            CurrentRequest.master.companycode ??= "CMP001";
            CurrentRequest.master.usercode = GetEffectiveUserCode();
            CurrentRequest.master.salescode = IsEdit ? CurrentRequest.master.salescode : 0;
            CurrentRequest.master.billdate = CurrentRequest.master.billdate == default ? DateTime.Now : CurrentRequest.master.billdate;
            CurrentRequest.master.createddate = CurrentRequest.master.createddate == default ? DateTime.Now : CurrentRequest.master.createddate;
            CurrentRequest.master.modifieddate = DateTime.Now;
            CurrentRequest.master.isactive = true;
            CurrentRequest.master.deleted = false;
            CurrentRequest.master.salestype = SelectedSalesType;
            CurrentRequest.master.warehousefield = WarehouseList.FirstOrDefault(w => w.warehousecode == SelectedWarehouseCode)?.warehousename ?? CurrentRequest.master.warehousefield;
            CurrentRequest.master.invoiceno = string.IsNullOrEmpty(CurrentRequest.master.invoiceno) ? CurrentRequest.master.billno : CurrentRequest.master.invoiceno;
            CurrentRequest.master.invoicedate ??= CurrentRequest.master.billdate;

            // Synchronize patient info for OP / IP Sales if searched via Typeahead
            if (SelectedSalesType == "OP Sales" || SelectedSalesType == "IP Sales" || SelectedSalesType == "IP / OP Sales")
            {
                if (!string.IsNullOrWhiteSpace(PatientIdSearchText)) CurrentRequest.master.patientid = PatientIdSearchText;
                if (!string.IsNullOrWhiteSpace(PatientNameSearchText)) CurrentRequest.master.patientname = PatientNameSearchText;
            }

            foreach (var detail in CurrentRequest.details)
            {
                if (detail.itemcode <= 0)
                {
                    var matchedStock = StockList.FirstOrDefault(s => s.warehousecode == SelectedWarehouseCode
                                                                  && IsStockMatchForItem(detail, s)
                                                                  && (string.IsNullOrWhiteSpace(detail.batchno) || string.Equals(s.batchno?.Trim(), detail.batchno?.Trim(), StringComparison.OrdinalIgnoreCase)));

                    if (matchedStock != null && matchedStock.itemcode > 0)
                    {
                        detail.itemcode = matchedStock.itemcode;
                    }
                }

                detail.warehousecode = SelectedWarehouseCode;
                detail.tenantcode = DefaultTenant;
                detail.salescode = CurrentRequest.master.salescode;
                detail.soldqty = detail.quantity; // Sync soldqty with quantity
                detail.uomcode ??= 0;
                detail.days = detail.days > 0 ? detail.days : 1;
                detail.prescribeddays = detail.days;
                detail.no_of_days = detail.days;
                detail.duration = detail.days.ToString();
                detail.morning_dose = !string.IsNullOrWhiteSpace(detail.morning_dose) ? detail.morning_dose : detail.morning;
                detail.afternoon_dose = !string.IsNullOrWhiteSpace(detail.afternoon_dose) ? detail.afternoon_dose : detail.afternoon;
                detail.evening_dose = !string.IsNullOrWhiteSpace(detail.evening_dose) ? detail.evening_dose : detail.evening;
                detail.night_dose = !string.IsNullOrWhiteSpace(detail.night_dose) ? detail.night_dose : detail.night;
                detail.morning = !string.IsNullOrWhiteSpace(detail.morning) ? detail.morning : detail.morning_dose;
                detail.afternoon = !string.IsNullOrWhiteSpace(detail.afternoon) ? detail.afternoon : detail.afternoon_dose;
                detail.evening = !string.IsNullOrWhiteSpace(detail.evening) ? detail.evening : detail.evening_dose;
                detail.night = !string.IsNullOrWhiteSpace(detail.night) ? detail.night : detail.night_dose;
                detail.taxpercentage = 0;
                detail.taxamount = 0;
                detail.bh_code = CurrentRequest.master.bh_code;
                detail.cntcode = CurrentRequest.master.cntcode;
            }

            var queueIds = CurrentRequest.details
                .Where(d => d.queue_id.HasValue && d.queue_id.Value != Guid.Empty)
                .Select(d => d.queue_id!.Value)
                .Distinct()
                .ToList();
            if (queueIds.Any())
            {
                CurrentRequest.queue_ids = queueIds;
            }

            CurrentRequest.master.prescribeddays = CurrentRequest.details.Where(d => d.days > 0).Select(d => d.days).DefaultIfEmpty(1).Max();
            CurrentRequest.master.converteddays ??= CurrentRequest.master.prescribeddays;
            CurrentRequest.master.days = CurrentRequest.master.prescribeddays;
            CurrentRequest.master.duration = CurrentRequest.master.prescribeddays.ToString();
            CurrentRequest.master.taxamount = 0;

            CurrentRequest.master.remarks ??= "";
            CurrentRequest.master.address ??= "";
            CurrentRequest.master.consultant ??= "";
            CurrentRequest.master.currencycode ??= "INR";

            try
            {
                var payloadJson = System.Text.Json.JsonSerializer.Serialize(CurrentRequest, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
                Console.WriteLine("==================== SALES MASTER " + (IsEdit ? "UPDATE" : "INSERT") + " PAYLOAD ====================");
                Console.WriteLine(payloadJson);
                Console.WriteLine("================================================================================");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SalesMaster] Error serializing payload for terminal log: {ex.Message}");
            }

            HttpResponseMessage? response = null;
            string responseBody = "";
            int statusCodeInt = 0;

            if (IsEdit)
            {
                var updateEndpoints = new List<string>
                {
                    "api/ItemMaster/updatesales",

                };

                bool updateSucceeded = false;
                foreach (var ep in updateEndpoints)
                {
                    try
                    {
                        var res = await client.PostAsJsonAsync(ep, CurrentRequest);
                        var body = await res.Content.ReadAsStringAsync();
                        if (res.IsSuccessStatusCode && !body.Contains("\"success\":false") && !body.Contains("\"status\":\"Failed\"") && !body.Contains("orderedqty"))
                        {
                            response = res;
                            responseBody = body;
                            statusCodeInt = (int)res.StatusCode;
                            updateSucceeded = true;
                            break;
                        }
                        else
                        {
                            Console.WriteLine($"[SalesMaster] Update endpoint '{ep}' returned {res.StatusCode}: {body}");
                            if (response == null)
                            {
                                response = res;
                                responseBody = body;
                                statusCodeInt = (int)res.StatusCode;
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[SalesMaster] Exception calling '{ep}': {ex.Message}");
                    }
                }

                // If updatesales endpoints fail (e.g. backend SQL error with "orderedqty"), fallback to insertsales
                if (!updateSucceeded)
                {
                    Console.WriteLine("[SalesMaster] updatesales endpoints failed. Attempting fallback to insertsales/upsert...");
                    try
                    {
                        var insertRes = await client.PostAsJsonAsync("api/ItemMaster/insertsales", CurrentRequest);
                        var insertBody = await insertRes.Content.ReadAsStringAsync();
                        if (insertRes.IsSuccessStatusCode && !insertBody.Contains("\"success\":false") && !insertBody.Contains("\"status\":\"Failed\""))
                        {
                            response = insertRes;
                            responseBody = insertBody;
                            statusCodeInt = (int)insertRes.StatusCode;
                            updateSucceeded = true;
                        }
                        else if (CurrentRequest.master.salescode > 0)
                        {
                            Console.WriteLine($"[SalesMaster] Direct insertsales fallback returned {insertRes.StatusCode}. Attempting delete prior salescode {CurrentRequest.master.salescode} then insert...");
                            try {
                                await client.GetAsync($"api/ItemMaster/deletesales?salescode={CurrentRequest.master.salescode}");
                                await client.DeleteAsync($"api/ItemMaster/deletesales?salescode={CurrentRequest.master.salescode}");
                            } catch {}

                            var reInsertRes = await client.PostAsJsonAsync("api/ItemMaster/insertsales", CurrentRequest);
                            var reInsertBody = await reInsertRes.Content.ReadAsStringAsync();
                            response = reInsertRes;
                            responseBody = reInsertBody;
                            statusCodeInt = (int)reInsertRes.StatusCode;
                        }
                        else
                        {
                            response = insertRes;
                            responseBody = insertBody;
                            statusCodeInt = (int)insertRes.StatusCode;
                        }
                    }
                    catch (Exception fallbackEx)
                    {
                        Console.WriteLine($"[SalesMaster] Fallback insertsales exception: {fallbackEx.Message}");
                    }
                }
            }
            else
            {
                response = await client.PostAsJsonAsync("api/ItemMaster/insertsales", CurrentRequest);
                statusCodeInt = (int)response.StatusCode;
                responseBody = await response.Content.ReadAsStringAsync();
            }

            if (response == null)
            {
                ToastService.ShowError("Failed to save sales: No response from server.");
                return;
            }

            Console.WriteLine($"[SalesMaster] Endpoint HTTP Response Status: {statusCodeInt} {response.StatusCode}");
            Console.WriteLine($"[SalesMaster] Raw Response Body: {responseBody}");

            if (response.IsSuccessStatusCode)
            {
                bool isInnerSuccess = true;
                string innerErrorMessage = "";

                if (!string.IsNullOrWhiteSpace(responseBody))
                {
                    try {
                        using var doc = JsonDocument.Parse(responseBody);
                        var root = doc.RootElement;
                        if (root.ValueKind == JsonValueKind.Object) {
                            if (root.TryGetProperty("success", out var succProp) && succProp.ValueKind == JsonValueKind.False) {
                                isInnerSuccess = false;
                            }
                            if (root.TryGetProperty("status", out var statProp)) {
                                if ((statProp.ValueKind == JsonValueKind.True || statProp.ValueKind == JsonValueKind.False) && !statProp.GetBoolean()) {
                                    isInnerSuccess = false;
                                }
                                else if (statProp.ValueKind == JsonValueKind.String) {
                                    var statStr = statProp.GetString() ?? "";
                                    if (string.Equals(statStr, "Failed", StringComparison.OrdinalIgnoreCase) ||
                                        string.Equals(statStr, "Error", StringComparison.OrdinalIgnoreCase)) {
                                        isInnerSuccess = false;
                                    }
                                }
                            }

                            if (root.TryGetProperty("message", out var msgProp) && msgProp.ValueKind == JsonValueKind.String) {
                                var msg = msgProp.GetString() ?? "";
                                if (!string.IsNullOrWhiteSpace(msg)) {
                                    if (msg.Contains("not found", StringComparison.OrdinalIgnoreCase) ||
                                        msg.Contains("insufficient", StringComparison.OrdinalIgnoreCase) ||
                                        msg.Contains("failed", StringComparison.OrdinalIgnoreCase) ||
                                        msg.Contains("error", StringComparison.OrdinalIgnoreCase) ||
                                        msg.Contains("invalid", StringComparison.OrdinalIgnoreCase) ||
                                        msg.Contains("required", StringComparison.OrdinalIgnoreCase) ||
                                        msg.Contains("not saved", StringComparison.OrdinalIgnoreCase) ||
                                        msg.Contains("cannot", StringComparison.OrdinalIgnoreCase) ||
                                        msg.Contains("unable", StringComparison.OrdinalIgnoreCase) ||
                                        msg.Contains("already exists", StringComparison.OrdinalIgnoreCase))
                                    {
                                        isInnerSuccess = false;
                                        innerErrorMessage = msg;
                                    }
                                    else if (!msg.Contains("success", StringComparison.OrdinalIgnoreCase) &&
                                             !msg.Contains("saved", StringComparison.OrdinalIgnoreCase) &&
                                             !msg.Contains("updated", StringComparison.OrdinalIgnoreCase) &&
                                             !msg.Contains("inserted", StringComparison.OrdinalIgnoreCase) &&
                                             !msg.Contains("created", StringComparison.OrdinalIgnoreCase) &&
                                             !msg.Contains("ok", StringComparison.OrdinalIgnoreCase))
                                    {
                                        isInnerSuccess = false;
                                        innerErrorMessage = msg;
                                    }
                                }
                            }

                            if (root.TryGetProperty("error", out var errProp) && errProp.ValueKind == JsonValueKind.String) {
                                var errStr = errProp.GetString() ?? "";
                                if (!string.IsNullOrWhiteSpace(errStr)) {
                                    isInnerSuccess = false;
                                    innerErrorMessage = errStr;
                                }
                            }
                        }
                    } catch { }
                }

                if (!isInnerSuccess)
                {
                    var msg = string.IsNullOrEmpty(innerErrorMessage) ? "Backend operation returned unsuccessful status." : innerErrorMessage;
                    Console.WriteLine($"[SalesMaster] API returned 200 OK but inner payload indicates failure: {msg}");
                    ShowFormattedBackendMessage(msg);
                    return;
                }

                // 1. Record billed items in memory & session cache
                long custId = CurrentRequest.master.customercode ?? 0;
                if (custId <= 0 && long.TryParse(CurrentRequest.master.patientid, out var parsedPid))
                {
                    custId = parsedPid;
                }
                var patientName = CurrentRequest.master.patientname ?? PatientNameSearchText ?? "";
                var patientId = CurrentRequest.master.patientid ?? PatientIdSearchText ?? "";
                var billDate = CurrentRequest.master.billdate != default ? CurrentRequest.master.billdate : DateTime.Today;

                var queueIdsToUpdate = new List<Guid>();
                var prDetIdsToUpdate = new List<Guid>();

                if (CurrentRequest.details != null)
                {
                    foreach (var detail in CurrentRequest.details.Where(d => d.itemcode > 0))
                    {
                        if (detail.queue_id.HasValue && detail.queue_id.Value != Guid.Empty)
                        {
                            BilledQueueIds.Add(detail.queue_id.Value);
                            queueIdsToUpdate.Add(detail.queue_id.Value);
                        }
                        if (detail.pr_det_id.HasValue && detail.pr_det_id.Value != Guid.Empty)
                        {
                            BilledPrDetIds.Add(detail.pr_det_id.Value);
                            prDetIdsToUpdate.Add(detail.pr_det_id.Value);
                        }

                        var itemName = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname ?? ItemSearchTexts.GetValueOrDefault(detail, "");
                        if (!string.IsNullOrWhiteSpace(itemName))
                        {
                            if (custId > 0)
                            {
                                BilledPatientItemKeys.Add(GetPatientItemKey(custId, itemName, billDate));
                                BilledPatientItemKeys.Add(GetPatientItemKey(custId, itemName, null));
                            }
                            if (!string.IsNullOrWhiteSpace(patientName))
                            {
                                BilledPatientItemKeys.Add(GetPatientItemKeyByName(patientName, itemName, billDate));
                                BilledPatientItemKeys.Add(GetPatientItemKeyByName(patientName, itemName, null));
                            }
                            if (!string.IsNullOrWhiteSpace(patientId))
                            {
                                var cleanDrugNorm = System.Text.RegularExpressions.Regex.Replace(itemName.Trim().ToUpperInvariant(), @"[^A-Z0-9]", "");
                                BilledPatientItemKeys.Add($"PID_{patientId.Trim().ToUpperInvariant()}_{cleanDrugNorm}");
                            }
                        }
                    }
                }

                AllSavedSalesRequests.Insert(0, new sales_request
                {
                    master = CurrentRequest.master,
                    details = CurrentRequest.details?.ToList() ?? new()
                });

                await SaveBilledPrescriptionsToSessionAsync();

                // 2. Update pharmacy queue status on backend
                if (queueIdsToUpdate.Any())
                {
                    var markBilledReq = new MarkBilledQueueRequest
                    {
                        queue_ids = queueIdsToUpdate,
                        salescode = CurrentRequest.master.salescode,
                        billno = CurrentRequest.master.billno
                    };
                    try { await client.PostAsJsonAsync("api/ItemMaster/pharmacy-queue/mark-billed", markBilledReq); } catch { }

                    foreach (var qId in queueIdsToUpdate)
                    {
                        var updateReq = new { queue_id = qId, status = "DISPENSED" };
                        try { await client.PostAsJsonAsync("api/ItemMaster/pharmacy-queue/update-status", updateReq); } catch { }
                        try { await client.PostAsJsonAsync("api/ItemMaster/pharmacy-queue/dispense", new { queue_id = qId }); } catch { }
                    }
                }

                // 3. Notify case sheet / prescription mark-billed if applicable
                if (prDetIdsToUpdate.Any())
                {
                    try {
                        await client.PostAsJsonAsync("api/CaseSheet/prescription/mark-billed", new { pr_det_ids = prDetIdsToUpdate, salescode = CurrentRequest.master.salescode, billno = CurrentRequest.master.billno });
                    } catch { }
                    try {
                        await client.PostAsJsonAsync("api/OpPrescription/mark-billed", new { pr_det_ids = prDetIdsToUpdate, salescode = CurrentRequest.master.salescode, billno = CurrentRequest.master.billno });
                    } catch { }
                }

                // 4. Remove all billed items from pending prescriptions in all tabs
                foreach (var tab in BillingTabs)
                {
                    if (tab.PendingPrescriptions != null && tab.PendingPrescriptions.Any())
                    {
                        tab.PendingPrescriptions.RemoveAll(p =>
                            (p.QueueId.HasValue && BilledQueueIds.Contains(p.QueueId.Value)) ||
                            (p.PrDetId.HasValue && BilledPrDetIds.Contains(p.PrDetId.Value)) ||
                            IsItemBilledForPatient(custId, patientId, patientName, p.MatchedItemCode ?? 0, p.DrugName, p.QueueId, p.PrDetId, p.Date)
                        );
                    }
                }
                PendingPrescriptions.RemoveAll(p =>
                    (p.QueueId.HasValue && BilledQueueIds.Contains(p.QueueId.Value)) ||
                    (p.PrDetId.HasValue && BilledPrDetIds.Contains(p.PrDetId.Value)) ||
                    IsItemBilledForPatient(custId, patientId, patientName, p.MatchedItemCode ?? 0, p.DrugName, p.QueueId, p.PrDetId, p.Date)
                );

                ToastService.ShowSuccess(IsEdit ? "Sales updated successfully" : "Sales saved successfully");

                var savedTab = BillingTabs.FirstOrDefault(t => t.TabId == ActiveTabId);
                if (savedTab != null)
                {
                    BillingTabs.Remove(savedTab);
                }

                if (BillingTabs.Any())
                {
                    var nextTab = BillingTabs.First();
                    LoadTabIntoForm(nextTab);
                    await SaveDraftTabsToSessionAsync();
                    ToastService.ShowInfo($"Switched to remaining draft bill: {nextTab.Title}");
                }
                else
                {
                    ShowModal = false;
                    await _sessionStorage.DeleteAsync(SessionDraftTabsKey);
                }

                CurrentPage = 1;
                await LoadSales();
            }
            else
            {
                string parsedErrMsg = ExtractErrorMessage(statusCodeInt, response.StatusCode.ToString(), responseBody);
                Console.WriteLine($"[SalesMaster] HTTP {statusCodeInt} ({response.StatusCode}) Error: {parsedErrMsg}");
                ShowFormattedBackendMessage(parsedErrMsg);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SalesMaster] Exception during SaveSales: {ex}");
            ToastService.ShowError($"Save Exception: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
        }
    }

    private string ExtractErrorMessage(int statusCode, string statusReason, string body)
    {
        if (string.IsNullOrWhiteSpace(body))
        {
            return $"{statusCode} {statusReason} (No response message)";
        }

        try
        {
            using var doc = JsonDocument.Parse(body);
            var root = doc.RootElement;
            if (root.ValueKind == JsonValueKind.Object)
            {
                // ASP.NET ModelState validation errors: {"errors":{"field":["error"]}}
                if (root.TryGetProperty("errors", out var errorsProp) && errorsProp.ValueKind == JsonValueKind.Object)
                {
                    var errList = new List<string>();
                    foreach (var prop in errorsProp.EnumerateObject())
                    {
                        if (prop.Value.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var item in prop.Value.EnumerateArray())
                            {
                                var errStr = item.GetString() ?? "";
                                if (errStr.Contains("days", StringComparison.OrdinalIgnoreCase) || prop.Name.Contains("days", StringComparison.OrdinalIgnoreCase))
                                {
                                    errList.Add("Please enter Days for all items");
                                }
                                else
                                {
                                    errList.Add($"{prop.Name}: {errStr}");
                                }
                            }
                        }
                        else
                        {
                            var errStr = prop.Value.ToString();
                            if (errStr.Contains("days", StringComparison.OrdinalIgnoreCase) || prop.Name.Contains("days", StringComparison.OrdinalIgnoreCase))
                            {
                                errList.Add("Please enter Days for all items");
                            }
                            else
                            {
                                errList.Add($"{prop.Name}: {errStr}");
                            }
                        }
                    }
                    if (errList.Any()) return string.Join(" | ", errList.Distinct());
                }

                if (root.TryGetProperty("title", out var titleProp) && titleProp.ValueKind == JsonValueKind.String)
                {
                    var title = titleProp.GetString();
                    if (root.TryGetProperty("detail", out var detailProp) && detailProp.ValueKind == JsonValueKind.String)
                    {
                        return $"{title} - {detailProp.GetString()}";
                    }
                    return title ?? $"{statusCode} {statusReason}";
                }

                if (root.TryGetProperty("message", out var msgProp) && msgProp.ValueKind == JsonValueKind.String)
                {
                    return msgProp.GetString() ?? $"{statusCode} {statusReason}";
                }

                if (root.TryGetProperty("error", out var errProp) && errProp.ValueKind == JsonValueKind.String)
                {
                    return errProp.GetString() ?? $"{statusCode} {statusReason}";
                }
            }
        }
        catch
        {
            if (body.Trim().StartsWith("<html", StringComparison.OrdinalIgnoreCase) || body.Trim().StartsWith("<!DOCTYPE", StringComparison.OrdinalIgnoreCase))
            {
                return $"HTML Error Page returned ({statusCode} {statusReason}).";
            }
        }

        return body.Length > 200 ? body.Substring(0, 200) + "..." : body;
    }

    private string FormatItemMessage(string rawMsg)
    {
        if (string.IsNullOrWhiteSpace(rawMsg)) return rawMsg;

        var formatted = System.Text.RegularExpressions.Regex.Replace(
            rawMsg,
            @"(?:Item|item|Itemcode|itemcode|ItemCode|Item Code|drugcode|Drug Code|item id|Item ID|medicine|Medicine)\s*(?::|-)?\s*(\d+)",
            m =>
            {
                if (long.TryParse(m.Groups[1].Value, out var code))
                {
                    var name = ItemList.FirstOrDefault(i => i.itemcode == code)?.itemname 
                               ?? CurrentRequest.details.FirstOrDefault(d => d.itemcode == code)?.itemname
                               ?? ItemSearchTexts.FirstOrDefault(kv => kv.Key.itemcode == code).Value;
                    if (!string.IsNullOrWhiteSpace(name))
                    {
                        return $"'{name}'";
                    }
                }
                return m.Value;
            }
        );

        return formatted;
    }

    private void ShowFormattedBackendMessage(string rawMsg)
    {
        if (string.IsNullOrWhiteSpace(rawMsg))
        {
            ToastService.ShowError("Backend operation returned unsuccessful status.");
            return;
        }

        string formatted = FormatItemMessage(rawMsg);

        bool isInsufficientStock = formatted.Contains("insufficient stock", StringComparison.OrdinalIgnoreCase) ||
                                   formatted.Contains("insufficient", StringComparison.OrdinalIgnoreCase) ||
                                   formatted.Contains("out of stock", StringComparison.OrdinalIgnoreCase) ||
                                   formatted.Contains("stock unavailable", StringComparison.OrdinalIgnoreCase) ||
                                   formatted.Contains("unavailable or insufficient", StringComparison.OrdinalIgnoreCase);

        if (isInsufficientStock)
        {
            // Show item name with warning alone, not an error with stock code!
            ToastService.ShowWarning(formatted);
        }
        else
        {
            ToastService.ShowError(formatted);
        }
    }

    private void ConfirmDelete(sales_master master)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete sales.");
            return;
        }
        PendingDelete = master;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteConfirmed()
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete sales.");
            return;
        }
        if (PendingDelete == null) return;
        ShowDeleteConfirm = false;
        
        try {
            var client = CreateClient();
            var salesCode = PendingDelete.salescode;

            var attempts = new Func<Task<HttpResponseMessage>>[]
            {
                () => client.GetAsync($"api/ItemMaster/deletesales?salescode={salesCode}"),
                () => client.DeleteAsync($"api/ItemMaster/deletesales?salescode={salesCode}"),
                () => client.DeleteAsync($"api/ItemMaster/deletesales/{salesCode}"),
                () => client.PostAsJsonAsync("api/ItemMaster/deletesales", new { salescode = salesCode, tenantcode = DefaultTenant }),
                () => client.PostAsync($"api/ItemMaster/deletesales?salescode={salesCode}", null)
            };

            bool success = false;
            foreach (var attempt in attempts)
            {
                try {
                    var response = await attempt();
                    if (response.IsSuccessStatusCode) {
                        success = true;
                        break;
                    }
                } catch {}
            }

            if (success) {
                ToastService.ShowSuccess("Sales deleted successfully");
                await LoadSales();
            } else {
                ToastService.ShowError("Delete failed");
            }
        } catch (Exception ex) {
            ToastService.ShowError($"Error deleting: {ex.Message}");
        } finally {
            PendingDelete = null;
        }
    }

    private static string? GetJsonStringSafe(JsonElement p)
    {
        if (p.ValueKind == JsonValueKind.String) return p.GetString();
        if (p.ValueKind == JsonValueKind.Number) return p.GetRawText();
        if (p.ValueKind == JsonValueKind.True) return "true";
        if (p.ValueKind == JsonValueKind.False) return "false";
        if (p.ValueKind == JsonValueKind.Null || p.ValueKind == JsonValueKind.Undefined) return null;
        return p.GetRawText();
    }

    private bool TenantMatches(string? itemTenant, string? defaultTenant)
    {
        if (string.IsNullOrWhiteSpace(defaultTenant)) return true;
        if (string.IsNullOrWhiteSpace(itemTenant)) return true;
        if (string.Equals(itemTenant.Trim(), defaultTenant.Trim(), StringComparison.OrdinalIgnoreCase)) return true;
        if (int.TryParse(itemTenant.Trim(), out int i1) && int.TryParse(defaultTenant.Trim(), out int i2) && i1 == i2) return true;
        return false;
    }

