@code {
    private List<sales_master> SalesList = new();
    private List<customer_master> CustomerList = new();
    private List<inventory_item_master> ItemList = new();
    private List<stock_master> StockList = new();
    private List<warehouse_master> WarehouseList = new();
    private List<PatientPartitionModel> PatientPartitionList = new();
    private sales_request CurrentRequest = new() { master = new(), details = new() };
    private sales_detail NewDetailItem = new();

    private string _selectedSalesType = "Counter Sales";
    private string SelectedSalesType
    {
        get => _selectedSalesType;
        set
        {
            if (_selectedSalesType != value)
            {
                _selectedSalesType = value;
                PatientIdSearchText = CurrentRequest.master.patientid ?? "";
                PatientNameSearchText = CurrentRequest.master.patientname ?? "";
            }
        }
    }
    private string PatientAddress { get; set; } = "";
    private string ConsultantName { get; set; } = "";
    private string StoreName { get; set; } = "";
    private string PatientName { get; set; } = "";

    private string _patientIdSearchText = "";
    private string PatientIdSearchText
    {
        get => _patientIdSearchText;
        set
        {
            if (_patientIdSearchText != value)
            {
                _patientIdSearchText = value;
                CurrentRequest.master.patientid = value;
            }
        }
    }

    private string _patientNameSearchText = "";
    private string PatientNameSearchText
    {
        get => _patientNameSearchText;
        set
        {
            if (_patientNameSearchText != value)
            {
                _patientNameSearchText = value;
                CurrentRequest.master.patientname = value;
            }
        }
    }
    private string ActivePatientSearchField { get; set; } = "";

    private long? _selectedWarehouseCode;
    private long? SelectedWarehouseCode
    {
        get => _selectedWarehouseCode;
        set
        {
            if (_selectedWarehouseCode != value)
            {
                _selectedWarehouseCode = value;
                CurrentRequest.master.warehousefield = WarehouseList.FirstOrDefault(w => w.warehousecode == value)?.warehousename;
                if (CurrentRequest.details != null)
                {
                    foreach (var d in CurrentRequest.details)
                    {
                        d.warehousecode = value;
                    }
                }
            }
        }
    }

    private async Task OnPartitionPatientChanged(ChangeEventArgs e)
    {
        var custIdStr = e.Value?.ToString() ?? "";
        var patient = PatientPartitionList.FirstOrDefault(p => p.custid?.ToString() == custIdStr);
        if (patient != null)
        {
            CurrentRequest.master.patientid = patient.custid?.ToString();
            CurrentRequest.master.patientname = patient.name;
            CurrentRequest.master.address = patient.city;
            CurrentRequest.master.consultant = patient.dcode?.ToString();
            if (long.TryParse(patient.custid?.ToString(), out var longId)) {
                CurrentRequest.master.customercode = longId;
                await LoadPrescriptions(longId);
            }
        }
        else
        {
            CurrentRequest.master.patientid = null;
            CurrentRequest.master.patientname = null;
            CurrentRequest.master.address = null;
            CurrentRequest.master.consultant = null;
            CurrentRequest.master.customercode = null;
        }
    }



    private async Task OnPatientSearchBlur()
    {
        await Task.Delay(200);
        ActivePatientSearchField = "";
        StateHasChanged();
    }

    private async Task SelectPatient(PatientPartitionModel patient)
    {
        CurrentRequest.master.patientid = patient.custid?.ToString();
        CurrentRequest.master.patientname = patient.name;
        CurrentRequest.master.address = patient.city;
        CurrentRequest.master.consultant = patient.dcode?.ToString();
        if (long.TryParse(patient.custid?.ToString(), out var longId)) {
            CurrentRequest.master.customercode = longId;
            await LoadPrescriptions(longId);
        }
        PatientIdSearchText = CurrentRequest.master.patientid ?? "";
        PatientNameSearchText = CurrentRequest.master.patientname ?? "";
        ActivePatientSearchField = "";
        StateHasChanged();
    }

    private async Task HandlePatientIdKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var firstMatch = PatientPartitionList
                .FirstOrDefault(p => p.custid != null && p.custid.Value.ToString().Contains(PatientIdSearchText, StringComparison.OrdinalIgnoreCase));
            if (firstMatch != null)
            {
                await SelectPatient(firstMatch);
            }
        }
    }

    private async Task HandlePatientNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var firstMatch = PatientPartitionList
                .FirstOrDefault(p => p.name != null && p.name.Contains(PatientNameSearchText, StringComparison.OrdinalIgnoreCase));
            if (firstMatch != null)
            {
                await SelectPatient(firstMatch);
            }
        }
    }

    private async Task LoadPrescriptionsManually()
    {
        long? targetId = null;
        if (CurrentRequest.master.customercode.HasValue) {
            targetId = CurrentRequest.master.customercode.Value;
        } else if (long.TryParse(PatientIdSearchText, out var parsedId)) {
            targetId = parsedId;
            var match = PatientPartitionList.FirstOrDefault(p => p.custid == parsedId);
            if (match != null) {
                await SelectPatient(match);
                return; // SelectPatient already calls LoadPrescriptions
            }
        }
        
        if (targetId.HasValue) {
            await LoadPrescriptions(targetId.Value);
        } else {
            ToastService.ShowWarning("Please enter or select a valid Patient ID first.");
        }
    }

    private async Task LoadPrescriptions(long custId)
    {
        try
        {
            var client = CreateClient();
            // The JSON from the user shows tenant_code = "0010", but DefaultTenant is "TEN1011". 
            // We must override it here for this specific call to get the data!
            client.DefaultRequestHeaders.Remove("tenantcode");
            client.DefaultRequestHeaders.Add("tenantcode", "0010");

            var responseString = await client.GetStringAsync($"api/ItemMaster/pharmacy-queue/by-custid?custid={custId}");
            if (string.IsNullOrWhiteSpace(responseString)) return;

            var options = new JsonSerializerOptions { 
                PropertyNameCaseInsensitive = true,
                NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
            };

            List<PharmacyPrescriptionQueueRow>? rows = null;
            try
            {
                using var doc = JsonDocument.Parse(responseString);
                var root = doc.RootElement;
                JsonElement dataElement = root;

                // Check if wrapped in {"data": ... }
                if (root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var dataProp))
                {
                    dataElement = dataProp;
                }

                if (dataElement.ValueKind == JsonValueKind.Array)
                {
                    if (dataElement.GetArrayLength() > 0)
                    {
                        var first = dataElement[0];
                        if (first.ValueKind == JsonValueKind.Object && first.TryGetProperty("items", out _))
                        {
                            var groups = JsonSerializer.Deserialize<List<PharmacyQueueGroup>>(dataElement.GetRawText(), options);
                            if (groups != null)
                            {
                                rows = groups.SelectMany(g => g.items ?? new List<PharmacyPrescriptionQueueRow>()).ToList();
                            }
                        }
                        else
                        {
                            rows = JsonSerializer.Deserialize<List<PharmacyPrescriptionQueueRow>>(dataElement.GetRawText(), options);
                        }
                    }
                    else
                    {
                        rows = new List<PharmacyPrescriptionQueueRow>();
                    }
                }
                else if (dataElement.ValueKind == JsonValueKind.Object)
                {
                    if (dataElement.TryGetProperty("items", out _))
                    {
                        var group = JsonSerializer.Deserialize<PharmacyQueueGroup>(dataElement.GetRawText(), options);
                        if (group != null && group.items != null)
                        {
                            rows = group.items;
                        }
                    }
                    else
                    {
                        var singleRow = JsonSerializer.Deserialize<PharmacyPrescriptionQueueRow>(dataElement.GetRawText(), options);
                        if (singleRow != null)
                        {
                            rows = new List<PharmacyPrescriptionQueueRow> { singleRow };
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error parsing prescription JSON: " + ex.Message);
            }

            if (rows != null)
            {
                var validRows = rows.Where(r => r.status != "DISPENSED" && r.status != "CANCELLED").ToList();

                if (validRows.Any())
                {
                    if (CurrentRequest.details.Count == 1 && CurrentRequest.details[0].itemcode == 0)
                    {
                        ItemSearchTexts.Remove(CurrentRequest.details[0]);
                        CurrentRequest.details.Clear();
                        EditableRows.Clear();
                    }

                    bool itemsAdded = false;
                    foreach (var item in validRows)
                    {
                        var detail = new sales_detail
                        {
                            tenantcode = DefaultTenant,
                            itemcode = item.matched_itemcode ?? 0,
                            quantity = item.qty ?? 0,
                            queue_id = item.queue_id
                        };
                        
                        if (detail.itemcode == 0 && !string.IsNullOrWhiteSpace(item.drug_name))
                        {
                            var localMatch = ItemList.FirstOrDefault(i => string.Equals(i.itemname, item.drug_name, StringComparison.OrdinalIgnoreCase));
                            if (localMatch != null)
                            {
                                detail.itemcode = localMatch.itemcode;
                            }
                        }

                        if (detail.itemcode > 0)
                        {
                            OnItemChanged(detail);
                        }

                        CurrentRequest.details.Add(detail);
                        EditableRows.Add(detail);
                        
                        ItemSearchTexts[detail] = !string.IsNullOrWhiteSpace(item.matched_itemname) ? item.matched_itemname : (item.drug_name ?? "");

                        itemsAdded = true;
                    }
                    
                    if (itemsAdded)
                    {
                        CalculateTotals();
                        StateHasChanged();
                        ToastService.ShowSuccess("Loaded prescriptions from pharmacy queue.");
                    }
                }
                else
                {
                    ToastService.ShowWarning($"API call successful, but it returned 0 pending prescriptions for this patient. Response length: {responseString.Length}");
                }
            }
            else
            {
                ToastService.ShowError($"Failed to parse API response. Raw JSON: {responseString.Substring(0, Math.Min(100, responseString.Length))}...");
                Console.WriteLine("API Response: " + responseString);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading prescriptions: {ex.Message}");
            Console.WriteLine($"Error loading prescriptions: {ex.Message}");
            StateHasChanged();
        }
    }

    private IEnumerable<inventory_item_master> GetAvailableItemsForRow(sales_detail detail)
    {
        if (SelectedWarehouseCode <= 0)
        {
            return Enumerable.Empty<inventory_item_master>();
        }
        var itemCodesInStock = StockList
            .Where(s => s.warehousecode == SelectedWarehouseCode && s.closingstock > 0)
            .Select(s => s.itemcode)
            .Distinct()
            .ToHashSet();
        return ItemList.Where(i => itemCodesInStock.Contains(i.itemcode));
    }

    private int? ActiveBatchSearchRow = null;

    private IEnumerable<stock_master> GetAvailableStocks(sales_detail detail)
    {
        if (SelectedWarehouseCode <= 0 || detail.itemcode <= 0)
            return Enumerable.Empty<stock_master>();
            
        var query = StockList
            .Where(s => s.warehousecode == SelectedWarehouseCode && s.itemcode == detail.itemcode && s.closingstock > 0 && !string.IsNullOrEmpty(s.batchno));
            
        if (!string.IsNullOrEmpty(detail.batchno) && ActiveBatchSearchRow != null)
        {
            query = query.Where(s => s.batchno!.Contains(detail.batchno, StringComparison.OrdinalIgnoreCase));
        }
        
        return query.GroupBy(s => s.batchno).Select(g => g.First()).ToList();
    }

    private void OnBatchInput(ChangeEventArgs e, sales_detail detail)
    {
        detail.batchno = e.Value?.ToString() ?? "";
        ActiveBatchSearchRow = CurrentRequest.details.IndexOf(detail);
        
        var stock = StockList.FirstOrDefault(s => s.warehousecode == SelectedWarehouseCode 
                                              && s.itemcode == detail.itemcode 
                                              && string.Equals(s.batchno, detail.batchno, StringComparison.OrdinalIgnoreCase));
        if (stock != null)
        {
            detail.expirydate = stock.expirydate;
            detail.manufacturingdate = stock.manufacturingdate;
            CalculateRow(detail);
        }
    }

    private async Task OnBatchBlur()
    {
        await Task.Delay(200);
        ActiveBatchSearchRow = null;
        StateHasChanged();
    }

    private void SelectBatchFromDropdown(sales_detail detail, stock_master stock)
    {
        detail.batchno = stock.batchno;
        detail.expirydate = stock.expirydate;
        detail.manufacturingdate = stock.manufacturingdate;
        ActiveBatchSearchRow = null;
        CalculateRow(detail);
        StateHasChanged();
    }

    // Typeahead: tracks the typed text per detail row (keyed by object hash)
    private Dictionary<sales_detail, string> ItemSearchTexts = new();
    private int? ActiveItemSearchRow = null;

    private void OnItemTypeaheadInput(ChangeEventArgs e, sales_detail detail)
    {
        var typed = e.Value?.ToString() ?? "";
        ItemSearchTexts[detail] = typed;
        ActiveItemSearchRow = CurrentRequest.details.IndexOf(detail);

        var availableItems = ItemList;
        var matched = availableItems.FirstOrDefault(i =>
            string.Equals(i.itemname, typed, StringComparison.OrdinalIgnoreCase));
        if (matched != null)
        {
            detail.itemcode = matched.itemcode;
            OnItemChanged(detail);
        }
        else
        {
            detail.itemcode = 0;
        }
    }

    private async Task OnSearchBlur()
    {
        await Task.Delay(200);
        ActiveItemSearchRow = null;
        StateHasChanged();
    }

    private void SelectItemFromDropdown(sales_detail detail, inventory_item_master item)
    {
        detail.itemcode = item.itemcode;
        ItemSearchTexts[detail] = item.itemname ?? "";
        OnItemChanged(detail);
        ActiveItemSearchRow = null;
        StateHasChanged();
    }

    // Field order in a row: 0=item, 1=batch, 2=expiry, 3=qty, 4=rate, 5=disc, 6=tax
    private readonly string[] _rowFieldPrefixes = { "item-input", "batch", "expiry", "qty", "rate", "disc", "tax" };

    private async Task HandleRowKeyDown(KeyboardEventArgs e, int rowIndex, int fieldIndex)
    {
        if (e.Key == "Enter" || e.Key == "Tab")
        {
            int nextField = fieldIndex + 1;
            int nextRow = rowIndex;
            if (nextField >= _rowFieldPrefixes.Length)
            {
                nextField = 0;
                nextRow = rowIndex + 1;
                // If next row doesn't exist, add one
                if (nextRow >= CurrentRequest.details.Count)
                    AddDetailRow();
            }
            var targetId = $"{_rowFieldPrefixes[nextField]}-{nextRow}";
            await JS.InvokeVoidAsync("focusElement", targetId);
        }
    }

    private HashSet<sales_detail> EditableRows = new();

    private bool IsRowEditable(sales_detail detail)
    {
        if (CurrentRequest.details != null && CurrentRequest.details.Count > 0 && CurrentRequest.details[0] == detail && detail.itemcode == 0)
        {
            return true;
        }
        return EditableRows.Contains(detail);
    }
    
