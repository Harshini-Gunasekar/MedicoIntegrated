    private async Task EditSales(sales_master master)
    {
        IsEdit = true;
        var ids = new List<string>();
        if (master.salescode > 0) ids.Add(master.salescode.ToString());
        if (!string.IsNullOrEmpty(master.billno)) ids.Add(master.billno);
        if (!string.IsNullOrEmpty(master.invoiceno)) ids.Add(master.invoiceno);
        
        ids = ids.Distinct().ToList();
 
        if (!ids.Any()) {
            ToastService.ShowWarning("Cannot edit: ID not found");
            return;
        }
 
        bool fetchSuccess = false;
        foreach (var id in ids) {
            var isNumeric = long.TryParse(id, out long numericId);
            var variations = new List<(string url, HttpMethod method, object? body)>();
            
            if (isNumeric) {
                variations.Add(($"api/ItemMaster/getsalesbycode?salescode={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"api/ItemMaster/getsalesbycode?salesCode={id}&tenantCode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"api/ItemMaster/getsalesbycode/{id}?tenantcode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"api/ItemMaster/getsales?salescode={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
            } else {
                variations.Add(($"api/ItemMaster/getsalesbycode?billno={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"api/ItemMaster/getsales?billno={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
            }
 
            foreach (var v in variations) {
                try {
                    var client = CreateClient();
                    HttpResponseMessage response;
                    if (v.method == HttpMethod.Get) {
                        response = await client.GetAsync(v.url);
                    } else {
                        response = await client.PostAsJsonAsync(v.url, v.body);
                    }
 
                    if (response.IsSuccessStatusCode) {
                        var responseString = await response.Content.ReadAsStringAsync();
                        var loaded = ParseRequestResponse(responseString);
                        if (loaded != null) {
                            CurrentRequest = loaded;
                            fetchSuccess = true;
                            break;
                        }
                    }
                } catch { }
            }
            if (fetchSuccess) break;
        }
 
        if (!fetchSuccess) {
            // Fallback load from the grid master
            CurrentRequest = new sales_request {
                master = new sales_master {
                    salescode = master.salescode,
                    billno = master.billno,
                    billdate = master.billdate,
                    invoiceno = master.invoiceno,
                    invoicedate = master.invoicedate,
                    customercode = master.customercode,
                    grossamount = master.grossamount,
                    discountamount = master.discountamount,
                    taxamount = master.taxamount,
                    netamount = master.netamount,
                    paymentmode = master.paymentmode,
                    paymentstatus = master.paymentstatus,
                    currencycode = master.currencycode,
                    isactive = master.isactive,
                    deleted = master.deleted,
                    remarks = master.remarks,
                    usercode = master.usercode,
                    tenantcode = master.tenantcode ?? DefaultTenant,
                    branchcode = master.branchcode ?? "BLR001",
                    companycode = master.companycode ?? "CMP001",
                    ordercode = master.ordercode,
                    salestype = master.salestype,
                    warehousefield = master.warehousefield,
                    patientid = master.patientid,
                    patientname = master.patientname,
                    address = master.address,
                    consultant = master.consultant
                },
                details = new List<sales_detail>()
            };
            ToastService.ShowSuccess("Loaded basic sale info.");
        }
 
        CurrentRequest.details ??= new List<sales_detail>();
 
        ItemSearchTexts.Clear();
        if (CurrentRequest.details != null)
        {
            foreach (var d in CurrentRequest.details)
            {
                var itemName = ItemList.FirstOrDefault(i => i.itemcode == d.itemcode)?.itemname ?? "";
                ItemSearchTexts[d] = itemName;
            }
        }
 
        SelectedSalesType = CurrentRequest.master.salestype ?? "Counter Sales";
        
        var tempWarehouseField = CurrentRequest.master.warehousefield;
        SelectedWarehouseCode = 0;
        if (CurrentRequest.details != null && CurrentRequest.details.Any()) {
            var wh = CurrentRequest.details.FirstOrDefault(d => d.warehousecode > 0)?.warehousecode;
            if (wh > 0) SelectedWarehouseCode = wh;
        }
        if ((SelectedWarehouseCode == null || SelectedWarehouseCode == 0) && !string.IsNullOrEmpty(tempWarehouseField)) {
            var wh = WarehouseList.FirstOrDefault(w => string.Equals(w.warehousename, tempWarehouseField, StringComparison.OrdinalIgnoreCase))?.warehousecode;
            if (wh > 0) SelectedWarehouseCode = wh;
        }
        
        AddDetailRow();
        NewDetailItem = new sales_detail { tenantcode = DefaultTenant };
        PatientAddress = CurrentRequest.master.address ?? "";
        ConsultantName = CurrentRequest.master.consultant ?? "";
        StoreName = CurrentRequest.master.warehousefield ?? "";
        PatientName = CurrentRequest.master.patientname ?? "";
        PatientIdSearchText = CurrentRequest.master.patientid ?? "";
        PatientNameSearchText = CurrentRequest.master.patientname ?? "";
        ActivePatientSearchField = "";
        ShowModal = true;
    }
 
