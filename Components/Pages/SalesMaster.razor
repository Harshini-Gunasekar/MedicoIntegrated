    private IEnumerable<sales_master> FilteredSales => 
        string.IsNullOrWhiteSpace(SearchQuery) 
            ? SalesList 
            : SalesList.Where(s => 
                (s.billno?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                s.salescode.ToString().Contains(SearchQuery) ||
                (s.patientid?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (s.patientname?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                CustomerList.Any(c => c.customercode == s.customercode && c.customername != null && c.customername.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<sales_master> PagedSales => 
        FilteredSales.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    private int TotalPages => (int)Math.Ceiling((double)FilteredSales.Count() / ItemsPerPage);

