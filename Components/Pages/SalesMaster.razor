    }
 
    private void OnItemChanged(sales_detail detail)
    {
        var item = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
        if (item != null) {
            detail.rate = GetItemUnitMrp(item);
            detail.uomcode = item.uomcode;
            detail.taxpercentage = item.gstpercentage;
            
            // Suggest earliest expiring batch from stock for the selected store (or across stores if not set) and fill batch, expiry date & QTY
            UpdateItemBatchAndExpiryForStore(detail, SelectedWarehouseCode ?? 0);
        }
    }

    private void CalculateRow(sales_detail detail)
    {
        _manualMasterDiscount = null;
        detail.amount = detail.quantity * detail.rate;
        detail.discountamount = (detail.amount * detail.discountpercentage) / 100;
        var afterDiscount = detail.amount - detail.discountamount;
        detail.taxamount = (afterDiscount * detail.taxpercentage) / 100;
        detail.totalamount = afterDiscount + detail.taxamount;
        CalculateTotals();
    }

    private decimal? _manualMasterDiscount = null;

    private decimal? GetMasterDiscount() => CurrentRequest.master.discountamount == 0 ? null : CurrentRequest.master.discountamount;

    private void SetMasterDiscount(decimal? val)
    {
        _manualMasterDiscount = val;
        CurrentRequest.master.discountamount = val ?? 0;

        decimal gross = CurrentRequest.details.Where(x => x.itemcode > 0).Sum(d => d.amount);
        if (gross > 0 && val.HasValue && val.Value > 0)
        {
            decimal overallPct = Math.Round((val.Value / gross) * 100, 2);
            foreach (var d in CurrentRequest.details.Where(x => x.itemcode > 0))
            {
                d.discountpercentage = overallPct;
                d.discountamount = Math.Round((d.amount * overallPct) / 100, 2);
                var afterDisc = d.amount - d.discountamount;
                d.taxamount = Math.Round((afterDisc * d.taxpercentage) / 100, 2);
                d.totalamount = afterDisc + d.taxamount;
            }
        }
        else if (val == null || val.Value == 0)
        {
            foreach (var d in CurrentRequest.details.Where(x => x.itemcode > 0))
            {
                d.discountpercentage = 0;
                d.discountamount = 0;
                var afterDisc = d.amount;
                d.taxamount = Math.Round((afterDisc * d.taxpercentage) / 100, 2);
                d.totalamount = afterDisc + d.taxamount;
            }
        }

        CalculateTotals();
    }

    private void CalculateTotals()
    {
        CurrentRequest.master.grossamount = CurrentRequest.details.Sum(d => d.amount);
        if (!_manualMasterDiscount.HasValue)
        {
            CurrentRequest.master.discountamount = CurrentRequest.details.Sum(d => d.discountamount);
        }
        CurrentRequest.master.taxamount = CurrentRequest.details.Sum(d => d.taxamount);
        var baseTotal = CurrentRequest.details.Sum(d => d.totalamount);
        CurrentRequest.master.netamount = Math.Max(0, baseTotal + CurrentRequest.master.roundoff);
    }

    private decimal? GetRoundOff() => CurrentRequest.master.roundoff == 0 ? null : CurrentRequest.master.roundoff;

    private void SetRoundOff(decimal? val)
    {
        CurrentRequest.master.roundoff = val ?? 0;
        CalculateTotals();
    }

    private void RoundOffUp()
    {
        var baseTotal = CurrentRequest.details.Sum(d => d.totalamount);
        var ceiling = Math.Ceiling(baseTotal);
        CurrentRequest.master.roundoff = Math.Round(ceiling - baseTotal, 2);
        CalculateTotals();
    }

    private void RoundOffDown()
    {
        var baseTotal = CurrentRequest.details.Sum(d => d.totalamount);
        var floor = Math.Floor(baseTotal);
        CurrentRequest.master.roundoff = Math.Round(floor - baseTotal, 2);
        CalculateTotals();
    }

    private void AddDetailRow()
    {
        EditableRows.Clear();
        var newRow = new sales_detail { 
            tenantcode = DefaultTenant,
            expirydate = null
        };
        CurrentRequest.details.Add(newRow);
        EditableRows.Add(newRow);
    }

    private void RemoveDetailRow(sales_detail detail)
    {
        ItemSearchTexts.Remove(detail);
        ExpiryDateTexts.Remove(detail.GetHashCode());
        _originalPrescriptionMap.Remove(detail);

        if (CurrentRequest.details != null && CurrentRequest.details.Count > 0 && CurrentRequest.details[0] == detail)
        {
            detail.itemcode = 0;
            detail.quantity = 0;
            detail.rate = 0;
            detail.discountpercentage = 0;
            detail.discountamount = 0;
            detail.taxpercentage = 0;
            detail.taxamount = 0;
            detail.amount = 0;
            detail.totalamount = 0;
            detail.batchno = "";
            detail.expirydate = null;
            EditableRows.Add(detail);
        }
        else if (CurrentRequest.details != null)
        {
            CurrentRequest.details.Remove(detail);
            EditableRows.Remove(detail);
        }
        CalculateTotals();
    }

    private async Task SaveSales()
    {
        Console.WriteLine("[SaveSales] Invoked.");
        if (IsEdit && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit sales.");
            return;
        }
        if (!IsEdit && !hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add sales.");
            return;
        }
        CalculateTotals();

        if (SelectedWarehouseCode == null || SelectedWarehouseCode <= 0) {
            ToastService.ShowWarning("Please select Store");
            return;
        }

        if (SelectedSalesType == "OP Sales" || SelectedSalesType == "IP Sales" || SelectedSalesType == "IP / OP Sales") {
            if (!string.IsNullOrWhiteSpace(PatientNameSearchText)) CurrentRequest.master.patientname = PatientNameSearchText;
            if (!string.IsNullOrWhiteSpace(PatientIdSearchText)) CurrentRequest.master.patientid = PatientIdSearchText;
            if (!string.IsNullOrWhiteSpace(PatientMobileSearchText)) CurrentRequest.master.mobileno = PatientMobileSearchText;

            if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientname) && string.IsNullOrWhiteSpace(CurrentRequest.master.patientid)) {
                ToastService.ShowWarning($"Please select {(SelectedSalesType == "IP Sales" ? "an IP" : "an OP")} patient");
                return;
            }
        } else {
            if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientname)) {
                ToastService.ShowWarning("Please enter Patient Name");
                return;
            }

            if (!CurrentRequest.master.customercode.HasValue || CurrentRequest.master.customercode.Value <= 0)
            {
                if (!string.IsNullOrWhiteSpace(CurrentRequest.master.mobileno))
                {
                    var cleanMob = CurrentRequest.master.mobileno.Trim();
                    var partMatch = PatientPartitionList.FirstOrDefault(p => (!string.IsNullOrWhiteSpace(p.mobile) && p.mobile.Trim() == cleanMob) || (!string.IsNullOrWhiteSpace(p.mobileno) && p.mobileno.Trim() == cleanMob))
                                   ?? OpRegistrationList.Select(o => new PatientPartitionModel { custid = (long)o.custid, mobile = o.mobile }).FirstOrDefault(o => !string.IsNullOrWhiteSpace(o.mobile) && o.mobile.Trim() == cleanMob);
                    if (partMatch != null && partMatch.custid.HasValue && partMatch.custid.Value > 0)
                    {
                        CurrentRequest.master.customercode = partMatch.custid.Value;
                        if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientid)) CurrentRequest.master.patientid = partMatch.custid.Value.ToString();
                    }
                }

                if ((!CurrentRequest.master.customercode.HasValue || CurrentRequest.master.customercode.Value <= 0) && !string.IsNullOrWhiteSpace(CurrentRequest.master.patientname))
                {
                    var cleanNm = CurrentRequest.master.patientname.Trim();
                    var partMatch = PatientPartitionList.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.name) && string.Equals(p.name.Trim(), cleanNm, StringComparison.OrdinalIgnoreCase))
                                   ?? OpRegistrationList.Select(o => new PatientPartitionModel { custid = (long)o.custid, name = o.patient_name }).FirstOrDefault(o => !string.IsNullOrWhiteSpace(o.name) && string.Equals(o.name.Trim(), cleanNm, StringComparison.OrdinalIgnoreCase));
                    if (partMatch != null && partMatch.custid.HasValue && partMatch.custid.Value > 0)
                    {
                        CurrentRequest.master.customercode = partMatch.custid.Value;
                        if (string.IsNullOrWhiteSpace(CurrentRequest.master.patientid)) CurrentRequest.master.patientid = partMatch.custid.Value.ToString();
                    }
                }
            }
        }

        // Filter out completely blank rows
        var activeDetails = CurrentRequest.details
            .Where(d => d.itemcode > 0 || !string.IsNullOrWhiteSpace(d.batchno) || d.quantity > 0 || d.days.HasValue)
            .ToList();

        if (!activeDetails.Any()) {
            ToastService.ShowWarning("Please add at least one Item");
            if (!CurrentRequest.details.Any()) AddDetailRow();
            return;
        }

        // Validate each item row for missing fields
        for (int i = 0; i < activeDetails.Count; i++)
        {
            var detail = activeDetails[i];
            var rowNum = i + 1;
            var itemName = ItemList.FirstOrDefault(it => it.itemcode == detail.itemcode)?.itemname;
            var itemLabel = !string.IsNullOrWhiteSpace(itemName) ? $"'{itemName}'" : $"Item in Row {rowNum}";

            if (detail.itemcode <= 0)
            {
                ToastService.ShowWarning($"Please select an Item for Row {rowNum}");
                return;
            }

            if (string.IsNullOrWhiteSpace(detail.batchno))
            {
                ToastService.ShowWarning($"Please enter Batch No for {itemLabel}");
                return;
            }

            if (!detail.expirydate.HasValue)
            {
                ToastService.ShowWarning($"Please enter Expiry Date for {itemLabel}");
                return;
            }

            if (!detail.days.HasValue || detail.days.Value <= 0)
            {
                ToastService.ShowWarning($"Please enter Days for {itemLabel}");
                return;
            }

            if (detail.quantity <= 0)
            {
                ToastService.ShowWarning($"Please enter Quantity for {itemLabel}");
                return;
            }

            if (detail.rate <= 0)
            {
                ToastService.ShowWarning($"Please enter Rate for {itemLabel}");
                return;
            }
        }

        CurrentRequest.details = activeDetails;

        // Check if any medicine in the bill is expired
        var expiredItems = CurrentRequest.details.Where(d => d.itemcode > 0 && d.expirydate.HasValue && d.expirydate.Value.Date < DateTime.Today).ToList();
        if (expiredItems.Any())
        {
            var firstExpired = expiredItems.First();
            var itemName = ItemList.FirstOrDefault(i => i.itemcode == firstExpired.itemcode)?.itemname ?? $"Item {firstExpired.itemcode}";
            var expStr = firstExpired.expirydate.Value.ToString("MM/yy", System.Globalization.CultureInfo.InvariantCulture);
            ToastService.ShowError($"Cannot save bill: '{itemName}' (Batch: {firstExpired.batchno}) is expired ({expStr}). Expired medicines cannot be billed.");
            return;
        }

        // Check stock for each item in selected warehouse
        foreach (var detail in CurrentRequest.details)
        {
            detail.warehousecode = SelectedWarehouseCode;
            var stockExists = StockList.Any(s => s.warehousecode == SelectedWarehouseCode
                                              && (s.itemcode == detail.itemcode || IsStockMatchForItem(detail, s)) 
                                              && (string.IsNullOrWhiteSpace(detail.batchno) || string.Equals(s.batchno?.Trim(), detail.batchno?.Trim(), StringComparison.OrdinalIgnoreCase))
                                              && s.closingstock >= detail.quantity);
            if (!stockExists && StockList.Any(s => s.warehousecode == SelectedWarehouseCode))
            {
                var itemName = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname ?? $"Code {detail.itemcode}";
                ToastService.ShowWarning($"Stock is unavailable or insufficient for '{itemName}' in the selected store.");
            }
        }

        IsSaving = true;
        try {
            var client = CreateClient();
            
            // Ensure client base address has trailing slash
            var baseAddrStr = client.BaseAddress?.ToString() ?? "http://medicoapi.iscansoft.com/";
            if (!baseAddrStr.EndsWith("/")) baseAddrStr += "/";
            client.BaseAddress = new Uri(baseAddrStr);

            CurrentRequest.master.tenantcode = DefaultTenant;
            CurrentRequest.master.branchcode ??= "BLR001";
            CurrentRequest.master.companycode ??= "CMP001";
            CurrentRequest.master.usercode ??= 101;
            CurrentRequest.master.salescode = IsEdit ? CurrentRequest.master.salescode : 0;
            CurrentRequest.master.billdate = CurrentRequest.master.billdate == default ? DateTime.Now : CurrentRequest.master.billdate;
            CurrentRequest.master.createddate = CurrentRequest.master.createddate == default ? DateTime.Now : CurrentRequest.master.createddate;
            CurrentRequest.master.modifieddate = DateTime.Now;
            CurrentRequest.master.isactive = true;
            CurrentRequest.master.deleted = false;
            CurrentRequest.master.salestype = SelectedSalesType;
            CurrentRequest.master.warehousefield = WarehouseList.FirstOrDefault(w => w.warehousecode == SelectedWarehouseCode)?.warehousename ?? CurrentRequest.master.warehousefield;
            CurrentRequest.master.invoiceno = string.IsNullOrEmpty(CurrentRequest.master.invoiceno) ? CurrentRequest.master.billno : CurrentRequest.master.invoiceno;
            CurrentRequest.master.invoicedate ??= CurrentRequest.master.billdate;

            // Synchronize patient info for OP / IP Sales if searched via Typeahead
            if (SelectedSalesType == "OP Sales" || SelectedSalesType == "IP Sales" || SelectedSalesType == "IP / OP Sales")
            {
                if (!string.IsNullOrWhiteSpace(PatientIdSearchText)) CurrentRequest.master.patientid = PatientIdSearchText;
                if (!string.IsNullOrWhiteSpace(PatientNameSearchText)) CurrentRequest.master.patientname = PatientNameSearchText;
            }

            foreach (var detail in CurrentRequest.details)
            {
                var matchedStock = StockList.FirstOrDefault(s => s.warehousecode == SelectedWarehouseCode
                                                              && (s.itemcode == detail.itemcode || IsStockMatchForItem(detail, s))
                                                              && (string.IsNullOrWhiteSpace(detail.batchno) || string.Equals(s.batchno?.Trim(), detail.batchno?.Trim(), StringComparison.OrdinalIgnoreCase)));

                if (matchedStock != null && matchedStock.itemcode > 0)
                {
                    detail.itemcode = matchedStock.itemcode;
                }

                detail.warehousecode = SelectedWarehouseCode;
                detail.tenantcode = DefaultTenant;
                detail.salescode = CurrentRequest.master.salescode;
                detail.soldqty = detail.quantity; // Sync soldqty with quantity
                detail.uomcode ??= 0;
                detail.days = detail.days.GetValueOrDefault(1);
                if (detail.days <= 0) detail.days = 1;
            }

            if (CurrentRequest.master.prescribeddays == null || CurrentRequest.master.prescribeddays <= 0)
            {
                CurrentRequest.master.prescribeddays = CurrentRequest.details.Where(d => d.days.HasValue && d.days.Value > 0).Select(d => d.days!.Value).DefaultIfEmpty(1).Max();
            }
            CurrentRequest.master.converteddays ??= CurrentRequest.master.prescribeddays;

            CurrentRequest.master.remarks ??= "";
            CurrentRequest.master.address ??= "";
            CurrentRequest.master.consultant ??= "";
            CurrentRequest.master.currencycode ??= "INR";

            try
            {
                var payloadJson = System.Text.Json.JsonSerializer.Serialize(CurrentRequest, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
                Console.WriteLine("==================== SALES MASTER " + (IsEdit ? "UPDATE" : "INSERT") + " PAYLOAD ====================");
                Console.WriteLine(payloadJson);
                Console.WriteLine("================================================================================");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SalesMaster] Error serializing payload for terminal log: {ex.Message}");
            }

            HttpResponseMessage? response = null;
            string responseBody = "";
            int statusCodeInt = 0;

            if (IsEdit)
            {
                var updateEndpoints = new List<string>
                {
                    "api/ItemMaster/updatesales",

                };

                bool updateSucceeded = false;
                foreach (var ep in updateEndpoints)
                {
                    try
                    {
                        var res = await client.PostAsJsonAsync(ep, CurrentRequest);
                        var body = await res.Content.ReadAsStringAsync();
                        if (res.IsSuccessStatusCode && !body.Contains("\"success\":false") && !body.Contains("\"status\":\"Failed\"") && !body.Contains("orderedqty"))
                        {
                            response = res;
                            responseBody = body;
                            statusCodeInt = (int)res.StatusCode;
                            updateSucceeded = true;
                            break;
                        }
                        else
                        {
                            Console.WriteLine($"[SalesMaster] Update endpoint '{ep}' returned {res.StatusCode}: {body}");
                            if (response == null)
                            {
                                response = res;
                                responseBody = body;
                                statusCodeInt = (int)res.StatusCode;
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[SalesMaster] Exception calling '{ep}': {ex.Message}");
                    }
                }

                // If updatesales endpoints fail (e.g. backend SQL error with "orderedqty"), fallback to insertsales
                if (!updateSucceeded)
                {
                    Console.WriteLine("[SalesMaster] updatesales endpoints failed. Attempting fallback to insertsales/upsert...");
                    try
                    {
                        var insertRes = await client.PostAsJsonAsync("api/ItemMaster/insertsales", CurrentRequest);
                        var insertBody = await insertRes.Content.ReadAsStringAsync();
                        if (insertRes.IsSuccessStatusCode && !insertBody.Contains("\"success\":false") && !insertBody.Contains("\"status\":\"Failed\""))
                        {
                            response = insertRes;
                            responseBody = insertBody;
                            statusCodeInt = (int)insertRes.StatusCode;
                            updateSucceeded = true;
                        }
                        else if (CurrentRequest.master.salescode > 0)
                        {
                            Console.WriteLine($"[SalesMaster] Direct insertsales fallback returned {insertRes.StatusCode}. Attempting delete prior salescode {CurrentRequest.master.salescode} then insert...");
                            try {
                                await client.GetAsync($"api/ItemMaster/deletesales?salescode={CurrentRequest.master.salescode}");
                                await client.DeleteAsync($"api/ItemMaster/deletesales?salescode={CurrentRequest.master.salescode}");
                            } catch {}

                            var reInsertRes = await client.PostAsJsonAsync("api/ItemMaster/insertsales", CurrentRequest);
                            var reInsertBody = await reInsertRes.Content.ReadAsStringAsync();
                            response = reInsertRes;
                            responseBody = reInsertBody;
                            statusCodeInt = (int)reInsertRes.StatusCode;
                        }
                        else
                        {
                            response = insertRes;
                            responseBody = insertBody;
                            statusCodeInt = (int)insertRes.StatusCode;
                        }
                    }
                    catch (Exception fallbackEx)
                    {
                        Console.WriteLine($"[SalesMaster] Fallback insertsales exception: {fallbackEx.Message}");
                    }
                }
            }
            else
            {
                response = await client.PostAsJsonAsync("api/ItemMaster/insertsales", CurrentRequest);
                statusCodeInt = (int)response.StatusCode;
                responseBody = await response.Content.ReadAsStringAsync();
            }

            if (response == null)
            {
                ToastService.ShowError("Failed to save sales: No response from server.");
                return;
            }

            Console.WriteLine($"[SalesMaster] Endpoint HTTP Response Status: {statusCodeInt} {response.StatusCode}");
            Console.WriteLine($"[SalesMaster] Raw Response Body: {responseBody}");

            if (response.IsSuccessStatusCode)
            {
                bool isInnerSuccess = true;
                string innerErrorMessage = "";

                if (!string.IsNullOrWhiteSpace(responseBody))
                {
                    try {
                        using var doc = JsonDocument.Parse(responseBody);
                        var root = doc.RootElement;
                        if (root.ValueKind == JsonValueKind.Object) {
                            if (root.TryGetProperty("success", out var succProp) && succProp.ValueKind == JsonValueKind.False) {
                                isInnerSuccess = false;
                            }
                            if (root.TryGetProperty("status", out var statProp)) {
                                if ((statProp.ValueKind == JsonValueKind.True || statProp.ValueKind == JsonValueKind.False) && !statProp.GetBoolean()) {
                                    isInnerSuccess = false;
                                }
                                else if (statProp.ValueKind == JsonValueKind.String) {
                                    var statStr = statProp.GetString() ?? "";
                                    if (string.Equals(statStr, "Failed", StringComparison.OrdinalIgnoreCase) ||
                                        string.Equals(statStr, "Error", StringComparison.OrdinalIgnoreCase)) {
                                        isInnerSuccess = false;
                                    }
                                }
                            }

                            if (root.TryGetProperty("message", out var msgProp) && msgProp.ValueKind == JsonValueKind.String) {
                                var msg = msgProp.GetString() ?? "";
                                if (!string.IsNullOrWhiteSpace(msg)) {
                                    if (msg.Contains("not found", StringComparison.OrdinalIgnoreCase) ||
                                        msg.Contains("insufficient", StringComparison.OrdinalIgnoreCase) ||
                                        msg.Contains("failed", StringComparison.OrdinalIgnoreCase) ||
                                        msg.Contains("error", StringComparison.OrdinalIgnoreCase) ||
                                        msg.Contains("invalid", StringComparison.OrdinalIgnoreCase))
                                    {
                                        isInnerSuccess = false;
                                        innerErrorMessage = msg;
                                    }
                                }
                            }

                            if (root.TryGetProperty("error", out var errProp) && errProp.ValueKind == JsonValueKind.String) {
                                var errStr = errProp.GetString() ?? "";
                                if (!string.IsNullOrWhiteSpace(errStr)) {
                                    isInnerSuccess = false;
                                    innerErrorMessage = errStr;
                                }
                            }
                        }
                    } catch { }
                }

                if (!isInnerSuccess)
                {
                    var msg = string.IsNullOrEmpty(innerErrorMessage) ? "Backend operation returned unsuccessful status." : innerErrorMessage;
                    Console.WriteLine($"[SalesMaster] API returned 200 OK but inner payload indicates failure: {msg}");
                    ToastService.ShowError(msg);
                    return;
                }

                // Update pharmacy queue status for billed items
                foreach (var detail in CurrentRequest.details.Where(d => d.queue_id.HasValue && d.queue_id.Value != Guid.Empty))
                {
                    var updateReq = new { queue_id = detail.queue_id.Value, status = "DISPENSED" };
                    try {
                        await client.PostAsJsonAsync("api/ItemMaster/pharmacy-queue/update-status", updateReq);
                    } catch { }
                }

                ToastService.ShowSuccess(IsEdit ? "Sales updated successfully" : "Sales saved successfully");
                ShowModal = false;
                CurrentPage = 1;
                await LoadSales();
            }
            else
            {
                string parsedErrMsg = ExtractErrorMessage(statusCodeInt, response.StatusCode.ToString(), responseBody);
                Console.WriteLine($"[SalesMaster] HTTP {statusCodeInt} ({response.StatusCode}) Error: {parsedErrMsg}");
                ToastService.ShowError($"HTTP {statusCodeInt} Error: {parsedErrMsg}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SalesMaster] Exception during SaveSales: {ex}");
            ToastService.ShowError($"Save Exception: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
        }
    }

    private string ExtractErrorMessage(int statusCode, string statusReason, string body)
    {
        if (string.IsNullOrWhiteSpace(body))
        {
            return $"{statusCode} {statusReason} (No response message)";
        }

        try
        {
            using var doc = JsonDocument.Parse(body);
            var root = doc.RootElement;
            if (root.ValueKind == JsonValueKind.Object)
            {
                // ASP.NET ModelState validation errors: {"errors":{"field":["error"]}}
                if (root.TryGetProperty("errors", out var errorsProp) && errorsProp.ValueKind == JsonValueKind.Object)
                {
                    var errList = new List<string>();
                    foreach (var prop in errorsProp.EnumerateObject())
                    {
                        if (prop.Value.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var item in prop.Value.EnumerateArray())
                            {
                                var errStr = item.GetString() ?? "";
                                if (errStr.Contains("days", StringComparison.OrdinalIgnoreCase) || prop.Name.Contains("days", StringComparison.OrdinalIgnoreCase))
                                {
                                    errList.Add("Please enter Days for all items");
                                }
                                else
                                {
                                    errList.Add($"{prop.Name}: {errStr}");
                                }
                            }
                        }
                        else
                        {
                            var errStr = prop.Value.ToString();
                            if (errStr.Contains("days", StringComparison.OrdinalIgnoreCase) || prop.Name.Contains("days", StringComparison.OrdinalIgnoreCase))
                            {
                                errList.Add("Please enter Days for all items");
                            }
                            else
                            {
                                errList.Add($"{prop.Name}: {errStr}");
                            }
                        }
                    }
                    if (errList.Any()) return string.Join(" | ", errList.Distinct());
                }

                if (root.TryGetProperty("title", out var titleProp) && titleProp.ValueKind == JsonValueKind.String)
                {
                    var title = titleProp.GetString();
                    if (root.TryGetProperty("detail", out var detailProp) && detailProp.ValueKind == JsonValueKind.String)
                    {
                        return $"{title} - {detailProp.GetString()}";
                    }
                    return title ?? $"{statusCode} {statusReason}";
                }

                if (root.TryGetProperty("message", out var msgProp) && msgProp.ValueKind == JsonValueKind.String)
                {
                    return msgProp.GetString() ?? $"{statusCode} {statusReason}";
                }

                if (root.TryGetProperty("error", out var errProp) && errProp.ValueKind == JsonValueKind.String)
                {
                    return errProp.GetString() ?? $"{statusCode} {statusReason}";
                }
            }
        }
        catch
        {
            if (body.Trim().StartsWith("<html", StringComparison.OrdinalIgnoreCase) || body.Trim().StartsWith("<!DOCTYPE", StringComparison.OrdinalIgnoreCase))
            {
                return $"HTML Error Page returned ({statusCode} {statusReason}).";
            }
        }

        return body.Length > 200 ? body.Substring(0, 200) + "..." : body;
    }

    private void ConfirmDelete(sales_master master)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete sales.");
            return;
        }
        PendingDelete = master;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteConfirmed()
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete sales.");
            return;
        }
        if (PendingDelete == null) return;
        ShowDeleteConfirm = false;
        
        try {
            var client = CreateClient();
            var salesCode = PendingDelete.salescode;

            var attempts = new Func<Task<HttpResponseMessage>>[]
            {
                () => client.GetAsync($"api/ItemMaster/deletesales?salescode={salesCode}"),
                () => client.DeleteAsync($"api/ItemMaster/deletesales?salescode={salesCode}"),
                () => client.DeleteAsync($"api/ItemMaster/deletesales/{salesCode}"),
                () => client.PostAsJsonAsync("api/ItemMaster/deletesales", new { salescode = salesCode, tenantcode = DefaultTenant }),
                () => client.PostAsync($"api/ItemMaster/deletesales?salescode={salesCode}", null)
            };

            bool success = false;
            foreach (var attempt in attempts)
            {
                try {
                    var response = await attempt();
                    if (response.IsSuccessStatusCode) {
                        success = true;
                        break;
                    }
                } catch {}
            }

            if (success) {
                ToastService.ShowSuccess("Sales deleted successfully");
                await LoadSales();
            } else {
                ToastService.ShowError("Delete failed");
            }
        } catch (Exception ex) {
            ToastService.ShowError($"Error deleting: {ex.Message}");
        } finally {
            PendingDelete = null;
        }
    }

    private static string? GetJsonStringSafe(JsonElement p)
    {
        if (p.ValueKind == JsonValueKind.String) return p.GetString();
        if (p.ValueKind == JsonValueKind.Number) return p.GetRawText();
        if (p.ValueKind == JsonValueKind.True) return "true";
        if (p.ValueKind == JsonValueKind.False) return "false";
        if (p.ValueKind == JsonValueKind.Null || p.ValueKind == JsonValueKind.Undefined) return null;
        return p.GetRawText();
    }

    private bool TenantMatches(string? itemTenant, string? defaultTenant)
    {
        if (string.IsNullOrWhiteSpace(defaultTenant)) return true;
        if (string.IsNullOrWhiteSpace(itemTenant)) return true;
        if (string.Equals(itemTenant.Trim(), defaultTenant.Trim(), StringComparison.OrdinalIgnoreCase)) return true;
        if (int.TryParse(itemTenant.Trim(), out int i1) && int.TryParse(defaultTenant.Trim(), out int i2) && i1 == i2) return true;
        return false;
    }

    private sales_master? ParseMaster(JsonElement el, JsonSerializerOptions options)
    {
        var target = el;
        if (el.TryGetProperty("master", out var mProp)) target = mProp;

        sales_master? m = null;
        try {
            m = JsonSerializer.Deserialize<sales_master>(target.GetRawText(), options);
        } catch { }

        m ??= new sales_master();

        if (m.salescode == 0) {
            foreach(var key in new[] { "salescode", "sales_code", "code", "id" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetInt64(out var valNum)) { m.salescode = valNum; break; }
                    else if (p.ValueKind == JsonValueKind.String && long.TryParse(p.GetString(), out var val)) { m.salescode = val; break; }
                }
            }
        }
        if (string.IsNullOrEmpty(m.billno)) {
            foreach(var key in new[] { "billno", "bill_no", "invoiceno", "invoice_no" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    m.billno = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.billno)) break;
                }
            }
        }
        if (m.billdate == default) {
            foreach(var key in new[] { "billdate", "bill_date", "createddate", "created_date" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.String && DateTime.TryParse(p.GetString(), out var dt)) {
                        m.billdate = dt;
                        break;
                    } else if (p.TryGetDateTime(out var dtVal)) {
                        m.billdate = dtVal;
                        break;
                    }
                }
            }
        }
        if (string.IsNullOrEmpty(m.patientname)) {
            foreach(var key in new[] { "patientname", "patient_name", "customername", "name" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    m.patientname = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.patientname)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.mobileno)) {
            foreach(var key in new[] { "mobileno", "mobile_no", "mobile", "phone", "phoneno", "contactno" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    m.mobileno = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.mobileno)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.patientid)) {
            foreach(var key in new[] { "patientid", "patient_id", "custid", "cust_id", "customer_id", "customerid", "customercode", "customer_code", "uhid", "patientcode" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    var pid = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(pid) && pid != "0") {
                        m.patientid = pid;
                        break;
                    }
                }
            }
        }
        if (!m.customercode.HasValue || m.customercode.Value == 0) {
            foreach(var key in new[] { "customercode", "customer_code", "custid", "cust_id", "customer_id", "customerid", "patientcode" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetInt64(out var cVal)) { m.customercode = cVal; break; }
                    else if (p.ValueKind == JsonValueKind.String && long.TryParse(p.GetString(), out var cStrVal)) { m.customercode = cStrVal; break; }
                }
            }
        }
        if (string.IsNullOrEmpty(m.salestype)) {
            foreach(var key in new[] { "salestype", "sales_type" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    m.salestype = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.salestype)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.warehousefield)) {
            foreach(var key in new[] { "warehousefield", "warehouse_field", "warehousename", "storename" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    m.warehousefield = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.warehousefield)) break;
                }
            }
        }
        if (m.netamount == 0) {
            foreach(var key in new[] { "netamount", "net_amount", "totalamount", "total" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetDecimal(out var dVal)) { m.netamount = dVal; break; }
                    else if (p.ValueKind == JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) { m.netamount = val; break; }
                }
            }
        }
        if (string.IsNullOrEmpty(m.paymentmode)) {
            foreach(var key in new[] { "paymentmode", "payment_mode", "paymode" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    m.paymentmode = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.paymentmode)) break;
                }
            }
        }
        if (m.roundoff == 0) {
            foreach(var key in new[] { "roundoff", "round_off", "roundOff", "salesroundoff" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetDecimal(out var valNum)) { m.roundoff = valNum; break; }
                    else if (p.ValueKind == JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) { m.roundoff = val; break; }
                }
            }
        }
        if (string.IsNullOrEmpty(m.paymentstatus)) {
            foreach(var key in new[] { "paymentstatus", "payment_status", "status" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    m.paymentstatus = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.paymentstatus)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.tenantcode)) {
            foreach(var key in new[] { "tenantcode", "tenant_code", "tenantCode", "tenant" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    m.tenantcode = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.tenantcode)) break;
                }
            }
        }
        return m;
    }

    private List<sales_master> ParseSalesListResponse(string json, out string? parseError)
    {
        parseError = null;
        if (string.IsNullOrWhiteSpace(json)) return new();
        var options = new JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };
        
        try {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            
            JsonElement arrayElement = default;
            bool foundArray = false;

            if (root.ValueKind == JsonValueKind.Array) {
                arrayElement = root;
                foundArray = true;
            } else if (root.ValueKind == JsonValueKind.Object) {
                if (root.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == JsonValueKind.Array) {
                    arrayElement = dataProp;
                    foundArray = true;
                } else {
                    foreach (var prop in root.EnumerateObject()) {
                        if (prop.Value.ValueKind == JsonValueKind.Array) {
                            arrayElement = prop.Value;
                            foundArray = true;
                            break;
                        }
                    }
                }
            }

            if (!foundArray) {
                if (root.ValueKind == JsonValueKind.Object) {
                    if (root.TryGetProperty("message", out var mProp)) {
                        parseError = $"Server message: {GetJsonStringSafe(mProp)}";
                    } else if (root.TryGetProperty("status", out var sProp) && sProp.GetString() != "Success") {
                        parseError = $"Server status: {GetJsonStringSafe(sProp)}";
                    }
                }
                return new();
            }

            var result = new List<sales_master>();
            foreach (var item in arrayElement.EnumerateArray()) {
                try {
                    var m = ParseMaster(item, options);
                    if (m != null) result.Add(m);
                } catch (Exception itemEx) {
                    Console.WriteLine($"[SalesMaster] Item parse error: {itemEx.Message}");
                }
            }
            return result.OrderByDescending(x => x.salescode > 0 ? x.salescode : x.billdate.Ticks).ToList();
        } catch (Exception ex) {
            Console.WriteLine("Parse Error: " + ex.Message);
            parseError = $"JSON Parse Error: {ex.Message}";
        }

        return new();
    }

    private sales_request? ParseRequestResponse(string json, long? targetSalesCode = null, string? targetBillNo = null)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        var options = new JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };
        
        try {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            
            // 1. Unwrap "data" if present
            if (root.ValueKind == JsonValueKind.Object && TryGetPropertyIgnoreCase(root, "data", out var dataProp)) {
                root = dataProp;
            }
            
            // 2. Handle array: Find the exact element matching target sales code or bill number
            if (root.ValueKind == JsonValueKind.Array) {
                JsonElement? matchedElement = null;
                
                foreach (var item in root.EnumerateArray()) {
                    sales_master? m = null;
                    if (item.ValueKind == JsonValueKind.Object) {
                        m = ParseMaster(item, options);
                    }
                    if (m != null) {
                        if (targetSalesCode.HasValue && targetSalesCode.Value > 0 && m.salescode == targetSalesCode.Value) {
                            matchedElement = item;
                            break;
                        }
                        if (!string.IsNullOrWhiteSpace(targetBillNo) && (
                            string.Equals(m.billno?.Trim(), targetBillNo.Trim(), StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(m.invoiceno?.Trim(), targetBillNo.Trim(), StringComparison.OrdinalIgnoreCase))) {
                            matchedElement = item;
                            break;
                        }
                    }
                }

                if (targetSalesCode.HasValue && targetSalesCode.Value > 0 || !string.IsNullOrWhiteSpace(targetBillNo)) {
                    if (matchedElement.HasValue) {
                        root = matchedElement.Value;
                    } else {
                        return null;
                    }
                } else if (root.GetArrayLength() > 0) {
                    root = root[0];
                } else {
                    return null;
                }
            }
            
            // 3. Deserialize root as sales_request
            if (root.ValueKind == JsonValueKind.Object) {
                if (TryGetPropertyIgnoreCase(root, "master", out var masterProp)) {
                    var req = new sales_request();
                    req.master = ParseMaster(masterProp, options) ?? new sales_master();
                    
                    if (TryGetPropertyIgnoreCase(root, "details", out var detailsProp) && detailsProp.ValueKind == JsonValueKind.Array) {
                        req.details = JsonSerializer.Deserialize<List<sales_detail>>(detailsProp.GetRawText(), options) ?? new();
                    } else {
                        req.details = new();
                    }
                    return req;
                }
                
                // Or maybe it's just a direct sales_master (without details)
                var directMaster = ParseMaster(root, options);
                if (directMaster != null && directMaster.salescode > 0) {
                    var req = new sales_request { master = directMaster, details = new() };
                    if (TryGetPropertyIgnoreCase(root, "details", out var detailsProp) && detailsProp.ValueKind == JsonValueKind.Array) {
                        req.details = JsonSerializer.Deserialize<List<sales_detail>>(detailsProp.GetRawText(), options) ?? new();
                    }
                    return req;
                }
            }
        } catch (Exception ex) {
            Console.WriteLine("ParseRequestResponse error: " + ex.Message);
        }

        try {
            var direct = JsonSerializer.Deserialize<sales_request>(json, options);
            if (direct != null && direct.master != null) {
                if (!targetSalesCode.HasValue || direct.master.salescode == targetSalesCode.Value) return direct;
            }
        } catch {}

        try {
            var wrapped = JsonSerializer.Deserialize<ServiceResponse<sales_request>>(json, options);
            if (wrapped?.data?.master != null) {
                if (!targetSalesCode.HasValue || wrapped.data.master.salescode == targetSalesCode.Value) return wrapped.data;
            }
        } catch {}

        try {
            var directMaster = JsonSerializer.Deserialize<sales_master>(json, options);
            if (directMaster != null && directMaster.salescode > 0)
            {
                if (!targetSalesCode.HasValue || directMaster.salescode == targetSalesCode.Value)
                    return new sales_request { master = directMaster, details = new() };
            }
        } catch {}

        return null;
    }

    private static bool TryGetPropertyIgnoreCase(JsonElement el, string name, out JsonElement prop)
    {
        prop = default;
        if (el.ValueKind != JsonValueKind.Object) return false;
        foreach (var p in el.EnumerateObject()) {
            if (string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase)) {
                prop = p.Value;
                return true;
            }
        }
        return false;
    }

    private long selectedReportWarehouseCode = 0;
    private DateTime selectedReportFromDate = DateTime.Now;
    private DateTime selectedReportToDate = DateTime.Now;
    private bool isPrinting = false;
    private bool isPrintingPdf = false;

    private async Task<string> FetchSalesReportBase64()
    {
        if (string.IsNullOrWhiteSpace(DefaultTenant))
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success ? tenantCodeResult.Value ?? "0010" : "0010";
        }

        if (string.IsNullOrWhiteSpace(AuthToken))
        {
            try
            {
                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                if (!tokenResult.Success || string.IsNullOrEmpty(tokenResult.Value))
                {
                    tokenResult = await _sessionStorage.GetAsync<string>("auth_token");
                }
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : (TenantState?.AuthToken ?? "");
            }
            catch {}
        }

        long code = selectedReportWarehouseCode;
        string fromDateStr = selectedReportFromDate.ToString("yyyy-MM-dd");
        string toDateStr = selectedReportToDate.ToString("yyyy-MM-dd");

        var candidateUrls = new List<string>
        {
            $"https://medicoapi.iscansoft.com/api/report/sales-report?warehousecode={code}&fromdate={fromDateStr}&todate={toDateStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}",
            $"api/report/sales-report?warehousecode={code}&fromdate={fromDateStr}&todate={toDateStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}",
            $"api/report/sales-report?warehousecode={code}&fromDate={fromDateStr}&toDate={toDateStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}",
            $"api/report/sales-report?warehousecode={code}&from_date={fromDateStr}&to_date={toDateStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}",
            $"https://medicoapi.iscansoft.com/api/Report/SalesReport?warehousecode={code}&fromdate={fromDateStr}&todate={toDateStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}"
        };

        var client = CreateClient();
        string lastError = "";

        foreach (var url in candidateUrls)
        {
            try
            {
                var req = new HttpRequestMessage(HttpMethod.Get, url);
                var effectiveToken = !string.IsNullOrEmpty(AuthToken) ? AuthToken : TenantState?.AuthToken;
                if (!string.IsNullOrEmpty(effectiveToken))
                {
                    req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
                }
                req.Headers.Add("tenantcode", DefaultTenant);
                req.Headers.Add("tenant_code", DefaultTenant);
                req.Headers.Add("tenant-code", DefaultTenant);

                var response = await client.SendAsync(req);

                if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
                {
                    var contentStr = await response.Content.ReadAsStringAsync();
                    contentStr = contentStr.Trim('"').Trim();

                    string base64Data = contentStr;
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(contentStr);
                        var root = doc.RootElement;
                        if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {
                            if (root.TryGetProperty("data", out var dProp)) base64Data = dProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("base64", out var bProp)) base64Data = bProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("file", out var fProp)) base64Data = fProp.GetString() ?? contentStr;
                        }
                        else if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                        {
                            base64Data = root.GetString() ?? contentStr;
                        }
                    }
                    catch { }

                    if (!string.IsNullOrWhiteSpace(base64Data) && base64Data.Length >= 50)
                    {
                        return base64Data;
                    }
                }
                else
                {
                    var errContent = await response.Content.ReadAsStringAsync();
                    lastError = $"HTTP {(int)response.StatusCode} ({response.ReasonPhrase}): {errContent}";
                }
            }
            catch (Exception ex)
            {
                lastError = ex.Message;
            }
        }

        throw new Exception(string.IsNullOrEmpty(lastError) ? "Backend report endpoint returned empty data." : lastError);
    }

