    private IEnumerable<sales_master> FilteredSales
    {
        get
        {
            var query = SalesList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(DefaultTenant))
            {
                query = query.Where(s => TenantMatches(s.tenantcode, DefaultTenant));
            }

            if (selectedReportWarehouseCode > 0)
            {
                var whName = WarehouseList.FirstOrDefault(w => w.warehousecode == selectedReportWarehouseCode)?.warehousename;
                if (!string.IsNullOrEmpty(whName))
                {
                    query = query.Where(s => string.Equals(s.warehousefield, whName, StringComparison.OrdinalIgnoreCase));
                }
            }

            if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                query = query.Where(s => 
                    (s.billno?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    s.salescode.ToString().Contains(SearchQuery) ||
                    (s.patientid?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (s.patientname?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (s.mobileno?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    GetDisplayCustomerId(s).Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                    CustomerList.Any(c => c.customercode == s.customercode && c.customername != null && c.customername.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));
            }

            return query;
        }
    }

    private string GetDisplayCustomerId(sales_master? s)
    {
        if (s == null) return "N/A";

        // 1. If customercode is set and > 0, return customercode (cust_id)
        if (s.customercode.HasValue && s.customercode.Value > 0)
        {
            return s.customercode.Value.ToString();
        }

        // 2. If patientid is numeric, return patientid (cust_id)
        if (!string.IsNullOrWhiteSpace(s.patientid) && long.TryParse(s.patientid.Trim(), out var numPid) && numPid > 0)
        {
            return numPid.ToString();
        }

        // 3. If patientid is OP / IP number (e.g. OPD/2026/09/0050, IPD/2026/09/0003), resolve custid from registrations
        if (!string.IsNullOrWhiteSpace(s.patientid))
        {
            var cleanPid = s.patientid.Trim();
            var opMatch = OpRegistrationList.FirstOrDefault(o => !string.IsNullOrWhiteSpace(o.op_no) && string.Equals(o.op_no.Trim(), cleanPid, StringComparison.OrdinalIgnoreCase) && o.custid > 0);
            if (opMatch != null) return opMatch.custid.ToString();

            var ipMatch = IpRegistrationList.FirstOrDefault(i => !string.IsNullOrWhiteSpace(i.ip_no) && string.Equals(i.ip_no.Trim(), cleanPid, StringComparison.OrdinalIgnoreCase) && i.custid > 0);
            if (ipMatch != null) return ipMatch.custid.ToString();
        }

        // 4. Resolve from OpRegistrationList / IpRegistrationList / PatientPartitionList by mobile
        if (!string.IsNullOrWhiteSpace(s.mobileno))
        {
            var cleanMob = s.mobileno.Trim();
            var opByMob = OpRegistrationList.FirstOrDefault(o => !string.IsNullOrWhiteSpace(o.mobile) && o.mobile.Trim() == cleanMob && o.custid > 0);
            if (opByMob != null) return opByMob.custid.ToString();

            var ipByMob = IpRegistrationList.FirstOrDefault(i => !string.IsNullOrWhiteSpace(i.mobile) && i.mobile.Trim() == cleanMob && i.custid > 0);
            if (ipByMob != null) return ipByMob.custid.ToString();

            var partByMob = PatientPartitionList.FirstOrDefault(p => (!string.IsNullOrWhiteSpace(p.mobile) && p.mobile.Trim() == cleanMob) || (!string.IsNullOrWhiteSpace(p.mobileno) && p.mobileno.Trim() == cleanMob));
            if (partByMob != null && partByMob.custid.HasValue && partByMob.custid.Value > 0) return partByMob.custid.Value.ToString();
        }

        // 5. Resolve from PatientPartitionList / OP / IP by patient name
        if (!string.IsNullOrWhiteSpace(s.patientname))
        {
            var cleanName = s.patientname.Trim();
            var partByName = PatientPartitionList.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.name) && string.Equals(p.name.Trim(), cleanName, StringComparison.OrdinalIgnoreCase));
            if (partByName != null && partByName.custid.HasValue && partByName.custid.Value > 0) return partByName.custid.Value.ToString();

            var opByName = OpRegistrationList.FirstOrDefault(o => !string.IsNullOrWhiteSpace(o.patient_name) && string.Equals(o.patient_name.Trim(), cleanName, StringComparison.OrdinalIgnoreCase) && o.custid > 0);
            if (opByName != null) return opByName.custid.ToString();

            var ipByName = IpRegistrationList.FirstOrDefault(i => !string.IsNullOrWhiteSpace(i.patient_name) && string.Equals(i.patient_name.Trim(), cleanName, StringComparison.OrdinalIgnoreCase) && i.custid > 0);
            if (ipByName != null) return ipByName.custid.ToString();

            var custByName = CustomerList.FirstOrDefault(c => !string.IsNullOrWhiteSpace(c.customername) && string.Equals(c.customername.Trim(), cleanName, StringComparison.OrdinalIgnoreCase) && c.customercode > 0);
            if (custByName != null) return custByName.customercode.ToString();
        }

        // 6. Fallback to patientid or N/A
        if (!string.IsNullOrWhiteSpace(s.patientid))
        {
            return s.patientid;
        }

        return "N/A";
    }

