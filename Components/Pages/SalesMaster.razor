                    labClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
                }
                var partResp = await labClient.GetStringAsync("api/Customer/partition?pagenumber=1&pagesize=1000");
                if (!string.IsNullOrWhiteSpace(partResp)) {
                    using var doc = JsonDocument.Parse(partResp);
                    var root = doc.RootElement;
                    JsonElement arrayEl = default;
                    if (root.ValueKind == JsonValueKind.Array) arrayEl = root;
                    else if (root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var dProp) && dProp.ValueKind == JsonValueKind.Array) arrayEl = dProp;

                    if (arrayEl.ValueKind == JsonValueKind.Array) {
                        foreach (var el in arrayEl.EnumerateArray()) {
                            long? cid = null;
                            if (el.TryGetProperty("custid", out var cProp)) {
                                if (cProp.ValueKind == JsonValueKind.Number && cProp.TryGetInt64(out var cNum)) cid = cNum;
                                else if (cProp.ValueKind == JsonValueKind.String && long.TryParse(cProp.GetString(), out var cStr)) cid = cStr;
                            } else if (el.TryGetProperty("customercode", out var ccProp)) {
                                if (ccProp.ValueKind == JsonValueKind.Number && ccProp.TryGetInt64(out var ccNum)) cid = ccNum;
                                else if (ccProp.ValueKind == JsonValueKind.String && long.TryParse(ccProp.GetString(), out var ccStr)) cid = ccStr;
                            }
                            string? name = el.TryGetProperty("name", out var nProp) ? nProp.GetString() : (el.TryGetProperty("customername", out var cnProp) ? cnProp.GetString() : null);
                            string? mob = el.TryGetProperty("mobile", out var mProp) ? mProp.GetString() : (el.TryGetProperty("mobileno", out var mnProp) ? mnProp.GetString() : null);
                            string? city = el.TryGetProperty("city", out var ctProp) ? ctProp.GetString() : null;
                            string? addr = el.TryGetProperty("address", out var aProp) ? aProp.GetString() : null;
                            string? gender = el.TryGetProperty("gender", out var gProp) ? gProp.GetString() : (el.TryGetProperty("sex", out var sProp) ? sProp.GetString() : null);
                            int? ageyears = null;
                            if (el.TryGetProperty("ageyears", out var ayProp)) {
                                if (ayProp.ValueKind == JsonValueKind.Number && ayProp.TryGetInt32(out var ayNum)) ageyears = ayNum;
                                else if (ayProp.ValueKind == JsonValueKind.String && int.TryParse(ayProp.GetString(), out var ayStr)) ageyears = ayStr;
                            } else if (el.TryGetProperty("age", out var aProp2)) {
                                if (aProp2.ValueKind == JsonValueKind.Number && aProp2.TryGetInt32(out var aNum)) ageyears = aNum;
                                else if (aProp2.ValueKind == JsonValueKind.String && int.TryParse(aProp2.GetString(), out var aStr)) ageyears = aStr;
                            }
                            int? agemonths = null;
                            if (el.TryGetProperty("agemonths", out var amProp)) {
                                if (amProp.ValueKind == JsonValueKind.Number && amProp.TryGetInt32(out var amNum)) agemonths = amNum;
                                else if (amProp.ValueKind == JsonValueKind.String && int.TryParse(amProp.GetString(), out var amStr)) agemonths = amStr;
                            }
                            int? agedays = null;
                            if (el.TryGetProperty("agedays", out var adProp)) {
                                if (adProp.ValueKind == JsonValueKind.Number && adProp.TryGetInt32(out var adNum)) agedays = adNum;
                                else if (adProp.ValueKind == JsonValueKind.String && int.TryParse(adProp.GetString(), out var adStr)) agedays = adStr;
                            }

                            if (cid.HasValue || !string.IsNullOrWhiteSpace(name)) {
                                list.Add(new PatientPartitionModel { custid = cid, name = name, mobile = mob, mobileno = mob, city = city, address = addr, gender = gender, ageyears = ageyears, agemonths = agemonths, agedays = agedays });
                            }
                        }
                    }
                }
            } catch (Exception ex) {
                Console.WriteLine($"Error loading patient partition from LabCareUrl: {ex.Message}");
            }

            // 2. Try DoctorApi partition
            try {
                var client = CreateClient();
                var partitionResp = await client.GetStringAsync("api/Customer/partition?pagenumber=1&pagesize=1000");
                if (!string.IsNullOrWhiteSpace(partitionResp)) {
                    using var doc = JsonDocument.Parse(partitionResp);
                    var root = doc.RootElement;
                    JsonElement arrayEl = default;
                    if (root.ValueKind == JsonValueKind.Array) arrayEl = root;
                    else if (root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var dProp) && dProp.ValueKind == JsonValueKind.Array) arrayEl = dProp;

                    if (arrayEl.ValueKind == JsonValueKind.Array) {
                        foreach (var el in arrayEl.EnumerateArray()) {
                            long? cid = null;
                            if (el.TryGetProperty("custid", out var cProp)) {
                                if (cProp.ValueKind == JsonValueKind.Number && cProp.TryGetInt64(out var cNum)) cid = cNum;
                                else if (cProp.ValueKind == JsonValueKind.String && long.TryParse(cProp.GetString(), out var cStr)) cid = cStr;
                            }
                            else if (el.TryGetProperty("customercode", out var ccProp)) {
                                if (ccProp.ValueKind == JsonValueKind.Number && ccProp.TryGetInt64(out var ccNum)) cid = ccNum;
                                else if (ccProp.ValueKind == JsonValueKind.String && long.TryParse(ccProp.GetString(), out var ccStr)) cid = ccStr;
                            }

                            string? name = el.TryGetProperty("name", out var nProp) ? nProp.GetString() : (el.TryGetProperty("customername", out var cnProp) ? cnProp.GetString() : null);
                            string? mob = el.TryGetProperty("mobile", out var mProp) ? mProp.GetString() : (el.TryGetProperty("mobileno", out var mnProp) ? mnProp.GetString() : null);
                            string? city = el.TryGetProperty("city", out var ctProp) ? ctProp.GetString() : null;
                            string? addr = el.TryGetProperty("address", out var aProp) ? aProp.GetString() : null;
                            string? gender = el.TryGetProperty("gender", out var gProp) ? gProp.GetString() : (el.TryGetProperty("sex", out var sProp) ? sProp.GetString() : null);
                            int? ageyears = null;
                            if (el.TryGetProperty("ageyears", out var ayProp)) {
                                if (ayProp.ValueKind == JsonValueKind.Number && ayProp.TryGetInt32(out var ayNum)) ageyears = ayNum;
                                else if (ayProp.ValueKind == JsonValueKind.String && int.TryParse(ayProp.GetString(), out var ayStr)) ageyears = ayStr;
                            } else if (el.TryGetProperty("age", out var aProp2)) {
                                if (aProp2.ValueKind == JsonValueKind.Number && aProp2.TryGetInt32(out var aNum)) ageyears = aNum;
                                else if (aProp2.ValueKind == JsonValueKind.String && int.TryParse(aProp2.GetString(), out var aStr)) ageyears = aStr;
                            }
                            int? agemonths = null;
                            if (el.TryGetProperty("agemonths", out var amProp)) {
                                if (amProp.ValueKind == JsonValueKind.Number && amProp.TryGetInt32(out var amNum)) agemonths = amNum;
                                else if (amProp.ValueKind == JsonValueKind.String && int.TryParse(amProp.GetString(), out var amStr)) agemonths = amStr;
                            }
                            int? agedays = null;
                            if (el.TryGetProperty("agedays", out var adProp)) {
                                if (adProp.ValueKind == JsonValueKind.Number && adProp.TryGetInt32(out var adNum)) agedays = adNum;
                                else if (adProp.ValueKind == JsonValueKind.String && int.TryParse(adProp.GetString(), out var adStr)) agedays = adStr;
                            }

                            if (cid.HasValue && !list.Any(x => x.custid == cid)) {
                                list.Add(new PatientPartitionModel { custid = cid, name = name, mobile = mob, mobileno = mob, city = city, address = addr, gender = gender, ageyears = ageyears, agemonths = agemonths, agedays = agedays });
                            }
                        }
                    }
                }
            } catch { }
        }

        // 3. Always merge from CustomerList (tenant customers from getcus)
        if (CustomerList != null && CustomerList.Any())
        {
            foreach (var c in CustomerList)
            {
                if (c.customercode > 0 && !list.Any(x => x.custid == c.customercode))
                {
                    list.Add(new PatientPartitionModel {
                        custid = c.customercode,
                        name = c.customername,
                        mobile = c.mobile,
                        mobileno = c.mobile,
                        city = c.city,
                        address = c.address,
                        gender = c.gender,
                        ageyears = c.ageyears,
                        agemonths = c.agemonths,
                        agedays = c.agedays
                    });
                }
            }
        }

        if (list.Any()) {
            PatientPartitionList = list;
        }
    }

