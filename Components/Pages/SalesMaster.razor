    private decimal GetOriginalPrescriptionBillAmount()
    {
        if (CurrentRequest?.details == null || !CurrentRequest.details.Any(d => d.itemcode > 0))
        {
            return CurrentRequest?.master?.netamount ?? 0;
        }

        int pDays = conversionPrescribedDays.HasValue && conversionPrescribedDays.Value > 0 ? conversionPrescribedDays.Value : (CurrentRequest.master.prescribeddays ?? 5);
        if (pDays <= 0) pDays = 5;

        decimal total = 0;
        foreach (var d in CurrentRequest.details.Where(d => d.itemcode > 0))
        {
            bool isTab = IsTabletItem(d.itemcode, ItemSearchTexts.GetValueOrDefault(d, ""));
            decimal qtyForPrescription = 1;
            if (!isTab)
            {
                qtyForPrescription = 1;
            }
            else
            {
                decimal origQty;
                int origDays;
                if (_originalPrescriptionMap.TryGetValue(d, out var mapped) && mapped.originalDays > 0)
                {
                    origQty = mapped.originalQty;
                    origDays = mapped.originalDays;
                }
                else
                {
                    origQty = d.quantity;
                    origDays = d.days.HasValue && d.days.Value > 0 ? d.days.Value : pDays;
                }

                if (origDays > 0 && origDays != pDays)
                {
                    decimal daily = origQty / (decimal)origDays;
                    qtyForPrescription = (decimal)Math.Max(1, (int)Math.Ceiling(daily * (decimal)pDays));
                }
                else
                {
                    qtyForPrescription = (decimal)Math.Max(1, (int)Math.Ceiling(origQty));
                }
            }

            decimal amt = qtyForPrescription * d.rate;
            decimal disc = (amt * d.discountpercentage) / 100;
            decimal afterDisc = amt - disc;
            total += afterDisc; // No tax added
        }
        return Math.Max(0, Math.Round(total + CurrentRequest.master.roundoff, 2));
    }

    private decimal GetPreviewConvertedBillAmount()
    {
        if (CurrentRequest?.details == null || !CurrentRequest.details.Any(d => d.itemcode > 0))
        {
            return 0;
        }

        if (!conversionTargetDays.HasValue || conversionTargetDays.Value <= 0)
        {
            return 0;
        }

        int cDays = conversionTargetDays.Value;
        int pDays = conversionPrescribedDays.HasValue && conversionPrescribedDays.Value > 0 ? conversionPrescribedDays.Value : (CurrentRequest.master.prescribeddays ?? 5);
        if (pDays <= 0) pDays = 5;

        decimal total = 0;
        foreach (var d in CurrentRequest.details.Where(d => d.itemcode > 0))
        {
            bool isTab = IsTabletItem(d.itemcode, ItemSearchTexts.GetValueOrDefault(d, ""));
            decimal newQty = 1;
            if (!isTab)
            {
                newQty = 1;
            }
            else
            {
                decimal origQty;
                int origDays;
                if (_originalPrescriptionMap.TryGetValue(d, out var mapped) && mapped.originalDays > 0)
                {
                    origQty = mapped.originalQty;
                    origDays = mapped.originalDays;
                }
                else
                {
                    origQty = d.quantity;
                    origDays = d.days.HasValue && d.days.Value > 0 ? d.days.Value : pDays;
                }

                decimal daily = origDays > 0 ? (origQty / (decimal)origDays) : origQty;
                newQty = (decimal)Math.Max(1, (int)Math.Ceiling(daily * (decimal)cDays));
            }

            decimal amt = newQty * d.rate;
            decimal disc = (amt * d.discountpercentage) / 100;
            decimal afterDisc = amt - disc;
            total += afterDisc; // No tax added
        }
        return Math.Max(0, Math.Round(total + CurrentRequest.master.roundoff, 2));
    }

    private void ExecuteConversion()
    {
        if (!conversionPrescribedDays.HasValue || conversionPrescribedDays.Value <= 0)
        {
            conversionError = "Please enter a valid number of prescribed days.";
            return;
        }

        if (!conversionTargetDays.HasValue || conversionTargetDays.Value <= 0)
        {
            conversionError = "Please enter a valid target number of days to convert.";
            return;
        }

        int pDays = conversionPrescribedDays.Value;
        int cDays = conversionTargetDays.Value;

        CurrentRequest.master.prescribeddays = pDays;
        CurrentRequest.master.converteddays = cDays;

        foreach (var detail in CurrentRequest.details.Where(d => d.itemcode > 0))
        {
            bool isTab = IsTabletItem(detail.itemcode, ItemSearchTexts.GetValueOrDefault(detail, ""));
            if (!isTab)
            {
                detail.quantity = 1;
                detail.days = cDays;
                detail.prescribeddays = pDays;
                detail.no_of_days = cDays;
                detail.duration = cDays.ToString();
                CalculateRow(detail);
                continue;
            }

            decimal origQty;
            int origDays;

            if (_originalPrescriptionMap.TryGetValue(detail, out var mapped) && mapped.originalDays > 0)
            {
                origQty = mapped.originalQty;
                origDays = mapped.originalDays;
            }
            else
            {
                origQty = detail.quantity;
                origDays = detail.days.HasValue && detail.days.Value > 0 ? detail.days.Value : pDays;
                _originalPrescriptionMap[detail] = (origQty, origDays);
            }

            // Daily quantity = Prescription Qty ÷ Prescription Days
            decimal dailyQty = origDays > 0 ? (origQty / (decimal)origDays) : origQty;
            // Converted Quantity = Daily Quantity × Converted Days (Integer, never decimal)
            decimal newQty = (decimal)Math.Max(1, (int)Math.Ceiling(dailyQty * (decimal)cDays));

            detail.days = cDays;
            detail.prescribeddays = pDays;
            detail.no_of_days = cDays;
            detail.duration = cDays.ToString();
            detail.quantity = newQty;
            CalculateRow(detail);
        }

        CalculateTotals();
        showConversionModal = false;
        ToastService.ShowSuccess($"Converted prescription from {pDays} days to {cDays} days successfully.");
        StateHasChanged();
    }

    private decimal? GetQty(sales_detail detail) => !IsEdit && detail.quantity == 0 ? null : detail.quantity;
    private void SetQty(sales_detail detail, decimal? value)
    {
        decimal val = value ?? 0;
        bool isTab = IsTabletItem(detail.itemcode, ItemSearchTexts.GetValueOrDefault(detail, ""));
        if (!isTab && val <= 0)
        {
            val = 1;
        }
        else if (isTab && val > 0)
        {
            val = (decimal)Math.Max(1, (int)Math.Ceiling(val));
        }
        detail.quantity = val;
        if (detail.days.HasValue && detail.days.Value > 0 && detail.quantity > 0)
        {
            _originalPrescriptionMap[detail] = (detail.quantity, detail.days.Value);
        }
