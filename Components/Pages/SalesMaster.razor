    private void OnDetailDaysInput(sales_detail detail, string? val)
    {
        int days = 1;
        if (int.TryParse(val, out var parsedDays) && parsedDays > 0)
        {
            days = parsedDays;
        }

        bool isTablet = IsTabletItem(detail.itemcode, ItemSearchTexts.GetValueOrDefault(detail, ""));
        if (!isTablet)
        {
            detail.quantity = 1;
            detail.days = days;
            detail.prescribeddays = days;
            detail.no_of_days = days;
            detail.duration = days.ToString();
            _originalPrescriptionMap[detail] = (1, days);
        }
        else
        {
            decimal dailyQty = 1;
            if (_originalPrescriptionMap.TryGetValue(detail, out var orig) && orig.originalDays > 0)
            {
                dailyQty = orig.originalQty / (decimal)orig.originalDays;
            }
            else if (detail.days.HasValue && detail.days.Value > 0 && detail.quantity > 0)
            {
                dailyQty = detail.quantity / (decimal)detail.days.Value;
                _originalPrescriptionMap[detail] = (detail.quantity, detail.days.Value);
            }
            else if (detail.quantity > 0)
            {
                dailyQty = detail.quantity / (decimal)days;
                _originalPrescriptionMap[detail] = (detail.quantity, days);
            }
            else
            {
                dailyQty = CalculateDailyDose(detail.morning, detail.afternoon, detail.evening, detail.night);
                if (dailyQty <= 0) dailyQty = 1;
            }

            decimal calculatedQty = dailyQty * (decimal)days;
            detail.quantity = (decimal)Math.Max(1, (int)Math.Ceiling(calculatedQty));
            detail.days = days;
            detail.prescribeddays = days;
            detail.no_of_days = days;
            detail.duration = days.ToString();
            if (!_originalPrescriptionMap.ContainsKey(detail))
            {
                _originalPrescriptionMap[detail] = (detail.quantity, days);
            }
        }
        CalculateRow(detail);
    }

