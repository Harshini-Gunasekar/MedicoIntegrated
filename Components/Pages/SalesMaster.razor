@page "/salesmaster"
@page "/sales"
@using Booking.Models
@using medico_backend.Model
@using Medico_Backend.Model
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Booking.Services.CaseSheetService CaseSheetService
@inject Booking.Services.AppointmentBookingService BookingService
@inject Booking.Services.IpRegistrationService IpService
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.LabSettingService LabSettingService
@inject Booking.Services.CounterMasterService CounterMasterService
@inject IConfiguration Configuration
@implements IDisposable


<style>
    @@keyframes blinker {
        50% { opacity: 0.3; }
    }
    .custom-typeahead-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1000;
        max-height: 200px;
        overflow-y: auto;
        background: white;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        margin-top: 2px;
    }
    .custom-typeahead-item {
        padding: 6px 10px;
        cursor: pointer;
        font-size: 0.75rem;
        text-align: left;
        color: #1e293b;
        transition: background-color 0.2s;
    }
    .custom-typeahead-item:hover {
        background-color: #f1f5f9;
        color: #02659e;
    }
</style>

<PageTitle>Billing</PageTitle>

<link rel="stylesheet" href="SalesMaster.css" />

<div class="items-page purchase-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                            <polyline points="10 9 9 9 8 9" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Pharmacy Billing</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total billing : @(SalesList.Count(s => TenantMatches(s.tenantcode, DefaultTenant)))
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <!-- Search Input -->
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by bill no or customer..." @oninput="OnSearchInput" />
                    </div>

                    <!-- View Toggle -->
                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    @if (hasCreateRight)
                    {
                        <button class="add-item-btn" @onclick="AddNewSales">
                            <i class="bi bi-plus-lg"></i>
                            <span class="ms-1">Pharmacy Billing</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Filters & Report Actions Row (Left Aligned Filters & Right Aligned Compact Action Buttons) -->
            <div class="sales-filters-toolbar d-flex justify-content-between align-items-center mb-4 gap-2 flex-wrap w-100" style="display: flex !important; justify-content: space-between !important; align-items: center !important; width: 100% !important; margin-top: 1.5rem !important; margin-bottom: 1.5rem !important;">
                <!-- Left Aligned Filters -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <!-- Store Filter -->
                    <div class="filter-group">
                        <span class="filter-label">
                            <i class="bi bi-building"></i> Store:
                        </span>
                        <select class="filter-select" @bind="selectedReportWarehouseCode" @bind:after="OnFilterChanged">
                            <option value="0">All Stores</option>
                            @foreach (var wh in WarehouseList)
                            {
                                <option value="@wh.warehousecode">@wh.warehousename</option>
                            }
                        </select>
                    </div>

                    <!-- From Date Filter -->
                    <div class="filter-group">
                        <span class="filter-label">
                            <i class="bi bi-calendar3"></i> From:
                        </span>
                        <input type="date" class="filter-input-date" @bind="selectedReportFromDate" />
                    </div>

                    <!-- To Date Filter -->
                    <div class="filter-group">
                        <span class="filter-label">
                            <i class="bi bi-calendar3"></i> To:
                        </span>
                        <input type="date" class="filter-input-date" @bind="selectedReportToDate" />
                    </div>
                </div>

                <!-- Right Aligned Compact Action Buttons -->
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <button class="btn-report-preview" @onclick="PreviewSalesReport" disabled="@isPrinting" title="Preview Sales Report">
                        @if (isPrinting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Loading...</span>
                        }
                        else
                        {
                            <i class="bi bi-printer me-1"></i> <span>Sales Report</span>
                        }
                    </button>

                    <button class="btn-report-download" @onclick="PrintSalesReportDirect" disabled="@isPrintingPdf" title="Print Sales Report">
                        @if (isPrintingPdf)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Printing...</span>
                        }
                        else
                        {
                            <i class="bi bi-printer me-1"></i> <span>Print Report</span>
                        }
                    </button>
                </div>
            </div>

            <div class="card items-main-card">
                @if (!string.IsNullOrEmpty(LoadErrorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center justify-content-between m-3 p-3 rounded-3 border-danger shadow-sm" role="alert" style="background: #fef2f2; border: 1px solid #f87171;">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger mt-1"></i>
                            <div>
                                <strong class="d-block text-danger font-monospace" style="font-size: 0.9rem;">API / Loading Error:</strong>
                                <span class="text-dark" style="font-size: 0.84rem; word-break: break-word;">@LoadErrorMessage</span>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-danger ms-3 px-3 py-1 fw-bold text-nowrap" @onclick="LoadSales">
                            <i class="bi bi-arrow-clockwise me-1"></i> Retry
                        </button>
                    </div>
                }

                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredSales.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-receipt fs-1 d-block mb-3"></i>
                        No sales found.
                        @if (!string.IsNullOrEmpty(LoadErrorMessage))
                        {
                            <div class="mt-2 text-danger small">
                                <i class="bi bi-exclamation-circle me-1"></i> Reason: @LoadErrorMessage
                            </div>
                        }
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive" style="max-height: calc(100vh - 270px) !important; overflow-y: auto !important; overflow-x: auto !important; position: relative !important;">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">S.NO</th>
                                    <th>BILL NO</th>
                                    <th>DATE</th>
                                    <th>CUSTOMER_ID</th>
                                    <th>CUSTOMER_NAME</th>
                                    <th>MOBILE NO</th>
                                    <th>NET AMOUNT</th>
                                    <th>PAYMENT MODE</th>
                                    <th>STATUS</th>
                                    <th style="width: 120px; text-align: center;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedSales.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td>@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td class="fw-bold text-primary">@FormatDisplayBillNo(row.value)</td>
                                        <td>@(row.value.billdate.ToString("yyyy-MM-dd"))</td>
                                        <td>@GetDisplayCustomerId(row.value)</td>
                                        <td>@FormatPatientNameWithAgeGender(string.IsNullOrWhiteSpace(row.value.patientname) ? (CustomerList.FirstOrDefault(c => c.customercode == row.value.customercode)?.customername ?? "N/A") : row.value.patientname, row.value.customercode)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.value.mobileno) ? "-" : row.value.mobileno)</td>
                                        <td class="fw-bold">₹@row.value.netamount.ToString("N2")</td>
                                        <td>@row.value.paymentmode</td>
                                        <td>
                                            <span class="badge @(row.value.paymentstatus == "Paid" ? "bg-success" : (row.value.paymentstatus == "Print Delivered" ? "bg-info text-white" : "bg-warning text-dark"))">
                                                @row.value.paymentstatus
                                            </span>
                                        </td>
                                        <td>
                                            <button class="action-btn btn-report" @onclick="() => PreviewPharmacyBillReport(row.value)" title="Billing Report" disabled="@(activeReportBillNo == (string.IsNullOrEmpty(row.value.billno) ? row.value.salescode.ToString() : row.value.billno))">
                                                @if (activeReportBillNo == (string.IsNullOrEmpty(row.value.billno) ? row.value.salescode.ToString() : row.value.billno))
                                                {
                                                    <span class="spinner-border spinner-border-sm" role="status" style="width: 12px; height: 12px; border-width: 2px;"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-file-earmark-text"></i>
                                                }
                                            </button>
                                            @if (hasEditRight)
                                            {
                                                <button class="action-btn btn-edit" @onclick="async () => await EditSales(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            }
                                            @if (hasDeleteRight)
                                            {
                                                <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var s in PagedSales)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span class="card-item-code">@FormatDisplayBillNo(s)</span>
                                    <div>
                                        <button class="action-btn btn-report" @onclick="() => PreviewPharmacyBillReport(s)" title="Billing Report" disabled="@(activeReportBillNo == (string.IsNullOrEmpty(s.billno) ? s.salescode.ToString() : s.billno))">
                                            @if (activeReportBillNo == (string.IsNullOrEmpty(s.billno) ? s.salescode.ToString() : s.billno))
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status" style="width: 12px; height: 12px; border-width: 2px;"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-file-earmark-text"></i>
                                            }
                                        </button>
                                        @if (hasEditRight)
                                        {
                                            <button class="action-btn btn-edit" @onclick="async () => await EditSales(s)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(s)" title="Delete"><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
                                </div>
                                <div class="item-card-body">
                                     <div class="detail-row"><span>Date</span><strong>@(s.billdate.ToString("yyyy-MM-dd"))</strong></div>
                                     <div class="detail-row"><span>Customer ID</span><strong>@GetDisplayCustomerId(s)</strong></div>
                                     <div class="detail-row"><span>Customer Name</span><strong>@FormatPatientNameWithAgeGender(string.IsNullOrWhiteSpace(s.patientname) ? (CustomerList.FirstOrDefault(c => c.customercode == s.customercode)?.customername ?? "N/A") : s.patientname, s.customercode)</strong></div>
                                     <div class="detail-row"><span>Net Amount</span><strong>₹@s.netamount.ToString("N2")</strong></div>
                                     <div class="detail-row"><span>Status</span><strong class="@(s.paymentstatus == "Paid" ? "text-success" : (s.paymentstatus == "Print Delivered" ? "text-info" : "text-warning"))">@s.paymentstatus</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="display-controls px-4 py-3 border-top">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredSales.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredSales.Count()))</strong> of <strong>@FilteredSales.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1" style="align-items: center;">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @foreach (var pageNum in GetVisiblePageNumbers())
                            {
                                var p = pageNum;
                                <button class="page-btn @(CurrentPage == p ? "active" : "")" @onclick="() => ChangePage(p)">
                                    @p
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 1250px; width: 95%;">
            <div class="modal-header-bar" style="padding: 12px 28px !important; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; background: #ffffff; border-radius: 16px 16px 0 0;">
                <div class="modal-header-left" style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                    <div>
                        <h3 class="modal-title" style="color: #1e293b !important; font-weight: 800; font-size: 1.15rem; letter-spacing: -0.2px; display: flex; align-items: center; gap: 8px; margin: 0;">
                            @(IsEdit ? "Edit Sales" : "Pharmacy Billing")
                        </h3>
                    </div>

                    @if (!IsEdit)
                    {
                        <!-- MULTI-BILL TABS (UP TO 3 TABS) -->
                        <div class="pharmacy-tabs-wrapper" style="display: inline-flex; align-items: center; gap: 6px; background: #f1f5f9; padding: 4px 6px; border-radius: 10px; border: 1px solid #cbd5e1;">
                            @foreach (var tab in BillingTabs)
                            {
                                var isActive = tab.TabId == ActiveTabId;
                                var billNo = !string.IsNullOrWhiteSpace(tab.Request?.master?.billno) ? tab.Request.master.billno : $"Bill {tab.TabId}";
                                var patName = !string.IsNullOrWhiteSpace(tab.Request?.master?.patientname) ? tab.Request.master.patientname : "";
                                var tabDisplay = !string.IsNullOrWhiteSpace(patName) ? patName : billNo;
                                if (tabDisplay.Length > 16) tabDisplay = tabDisplay.Substring(0, 15) + "…";

                                <div class="billing-tab-pill @(isActive ? "active" : "")"
                                     @onclick="() => SwitchTab(tab.TabId)"
                                     title="@billNo @(string.IsNullOrWhiteSpace(patName) ? "" : $"({patName})")"
                                     style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 7px; font-size: 0.78rem; font-weight: 700; cursor: pointer; transition: all 0.2s; @(isActive ? "background: #ffffff; color: #4338ca; box-shadow: 0 1px 4px rgba(67, 56, 202, 0.14); border: 1.5px solid #818cf8;" : "background: transparent; color: #64748b; border: 1.5px solid transparent;")">
                                    <i class="bi bi-receipt@(isActive ? "-cutoff" : "")" style="@(isActive ? "color: #4f46e5;" : "color: #94a3b8;")"></i>
                                    <span>@tabDisplay</span>
                                    @if (BillingTabs.Count > 1)
                                    {
                                        <button type="button" class="tab-close-btn" @onclick="() => CloseTab(tab.TabId)" @onclick:stopPropagation="true" title="Close Bill" style="background: none; border: none; padding: 0 1px; margin-left: 2px; color: #94a3b8; font-size: 0.85rem; line-height: 1; cursor: pointer; display: inline-flex; align-items: center;">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    }
                                </div>
                            }

                            @if (BillingTabs.Count < MaxBillingTabs)
                            {
                                <button type="button" class="btn-new-tab" @onclick="AddNewTab" title="Open New Bill Tab (Max 3 Allowed)" style="display: inline-flex; align-items: center; gap: 4px; background: #e0e7ff; color: #4338ca; border: 1px dashed #818cf8; padding: 4px 10px; border-radius: 7px; font-size: 0.76rem; font-weight: 700; cursor: pointer; transition: all 0.2s;">
                                    <i class="bi bi-plus-lg" style="font-size: 0.72rem;"></i>
                                    <span>New Bill (@(BillingTabs.Count)/3)</span>
                                </button>
                            }
                        </div>
                    }
                </div>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <!-- Branch Selection Button -->
                    <div class="branch-selector-container">
                        <button type="button" class="btn-branch-picker" @onclick="ToggleBranchDropdown" title="Select Branch">
                            <i class="bi bi-geo-alt-fill" style="color: #4f46e5; font-size: 0.78rem;"></i>
                            <span class="header-picker-name">@GetSelectedBranchName()</span>
                            <i class="bi bi-chevron-down header-picker-arrow @(isBranchDropdownOpen ? "open" : "")"></i>
                        </button>

                        @if (isBranchDropdownOpen)
                        {
                            <div class="branch-dropdown-menu">
                                <div class="picker-dropdown-header">
                                    <i class="bi bi-building"></i>
                                    <span>Select Branch</span>
                                </div>
                                <div style="max-height: 180px; overflow-y: auto;">
                                    @if (BranchList != null && BranchList.Any())
                                    {
                                        @foreach (var bh in BranchList)
                                        {
                                            var isSel = bh.bh_code == SelectedBhCode;
                                            <div class="branch-dropdown-item @(isSel ? "active" : "")" 
                                                 @onclick="() => SelectBranch(bh)">
                                                <div style="display: flex; align-items: center; gap: 6px; text-align: left; overflow: hidden;">
                                                    <i class="bi bi-geo-alt@(isSel ? "-fill" : "")" style="@(isSel ? "color: #4f46e5;" : "color: #94a3b8; font-size: 0.75rem;")"></i>
                                                    <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: @(isSel ? "700" : "500");">@bh.name</span>
                                                </div>
                                                @if (isSel)
                                                {
                                                    <i class="bi bi-check-lg" style="color: #4f46e5; font-size: 0.9rem; font-weight: 800; margin-left: 4px;"></i>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div style="padding: 8px; text-align: center; color: #94a3b8; font-size: 0.75rem;">
                                            No branches found
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Counter Selection Button -->
                    <div class="counter-selector-container">
                        <button type="button" class="btn-counter-picker" @onclick="ToggleCounterDropdown" title="Select Counter">
                            <i class="bi bi-display" style="color: #0284c7; font-size: 0.78rem;"></i>
                            <span class="header-picker-name">@GetSelectedCounterName()</span>
                            <i class="bi bi-chevron-down header-picker-arrow @(isCounterDropdownOpen ? "open" : "")"></i>
                        </button>

                        @if (isCounterDropdownOpen)
                        {
                            <div class="counter-dropdown-menu">
                                <div class="picker-dropdown-header">
                                    <i class="bi bi-display"></i>
                                    <span>Select Counter</span>
                                </div>
                                <div style="max-height: 180px; overflow-y: auto;">
                                    @if (GetFilteredCounters().Any())
                                    {
                                        @foreach (var c in GetFilteredCounters())
                                        {
                                            var isSel = c.cntcode == SelectedCntCode;
                                            <div class="counter-dropdown-item @(isSel ? "active" : "")" 
                                                 @onclick="() => SelectCounter(c)">
                                                <div style="display: flex; align-items: center; gap: 6px; text-align: left; overflow: hidden;">
                                                    <i class="bi bi-display@(isSel ? "-fill" : "")" style="@(isSel ? "color: #0284c7;" : "color: #94a3b8; font-size: 0.75rem;")"></i>
                                                    <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: @(isSel ? "700" : "500");">@c.name</span>
                                                </div>
                                                @if (isSel)
                                                {
                                                    <i class="bi bi-check-lg" style="color: #0284c7; font-size: 0.9rem; font-weight: 800; margin-left: 4px;"></i>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div style="padding: 8px; text-align: center; color: #94a3b8; font-size: 0.75rem;">
                                            No counters available
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <button class="btn-close-modal" title="Close and save to session" @onclick="CloseModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentRequest" OnValidSubmit="SaveSales" autocomplete="off">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 4px 0px 8px 0px;">
                        
                        <!-- Bill Information wrapper -->
                        <div class="purchase-bill-wrapper mb-2">
                            <!-- Billing fields -->
                            <div class="purchase-bill-fields" style="flex: 1; display: flex; flex-direction: column; gap: 8px;">
                                <!-- Row 1 -->
                                @if (SelectedSalesType == "OP Sales" || SelectedSalesType == "IP / OP Sales")
                                {
                                    <!-- Row 1 for OP Sales: Sales Type -> Name -> Mobile No -> OP No -->
                                    <div style="display: grid; grid-template-columns: 1.8fr 3.2fr 2.2fr 2.8fr; gap: 12px; align-items: end;">
                                        <!-- Sales Type -->
                                        <div class="field-group">
                                            <label class="field-label">Sales Type</label>
                                            <div style="position: relative;">
                                                <select class="form-control premium-input" @bind="SelectedSalesType" style="appearance: none !important; -webkit-appearance: none !important; -moz-appearance: none !important; padding-right: 24px; width: 100%;">
