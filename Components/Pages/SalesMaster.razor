    [JSInvokable]
    public async Task OnPdfModalPrintClicked()
    {
        if (_activePreviewSales != null)
        {
            await HandleBillPrintDeliveredAsync(_activePreviewSales);
        }
    }

    private async Task HandleBillPrintDeliveredAsync(sales_master sales)
    {
        if (sales == null) return;

        // Only update status if currently Paid
        if (!string.Equals(sales.paymentstatus?.Trim(), "Paid", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        try
        {
            // 1. Immediately update in-memory state so UI updates
            sales.paymentstatus = "Print Delivered";
            var existingInList = SalesList.FirstOrDefault(s => s.salescode == sales.salescode || (!string.IsNullOrEmpty(sales.billno) && s.billno == sales.billno));
            if (existingInList != null)
            {
                existingInList.paymentstatus = "Print Delivered";
            }
            StateHasChanged();

            // 2. Persist update to database via backend API
            var targetSalesCode = sales.salescode;
            var targetBillNo = sales.billno;

            sales_request? fullRequest = null;
            var client = CreateClient();

            var variations = new (HttpMethod method, string url, object? body)[]
            {
                (HttpMethod.Get, $"api/ItemMaster/getsales?salescode={targetSalesCode}", null),
                (HttpMethod.Get, $"api/ItemMaster/getsales/{targetSalesCode}", null),
                (HttpMethod.Post, "api/ItemMaster/getsalesbycode", new { salescode = targetSalesCode, tenantcode = DefaultTenant }),
                (HttpMethod.Get, $"api/ItemMaster/getsalesbybillno?billno={Uri.EscapeDataString(targetBillNo ?? "")}", null),
                (HttpMethod.Post, "api/ItemMaster/getsalesbybillno", new { billno = targetBillNo, tenantcode = DefaultTenant }),
                (HttpMethod.Get, "api/ItemMaster/getsales", null)
            };

            foreach (var v in variations)
            {
                try
                {
                    HttpResponseMessage resp;
                    if (v.method == HttpMethod.Get)
                        resp = await client.GetAsync(v.url);
                    else
                        resp = await client.PostAsJsonAsync(v.url, v.body);

                    if (resp.IsSuccessStatusCode)
                    {
                        var str = await resp.Content.ReadAsStringAsync();
                        var loaded = ParseRequestResponse(str, targetSalesCode, targetBillNo);
                        if (loaded != null && loaded.master != null && (
                            (targetSalesCode > 0 && loaded.master.salescode == targetSalesCode) ||
                            (!string.IsNullOrEmpty(targetBillNo) && (string.Equals(loaded.master.billno, targetBillNo, StringComparison.OrdinalIgnoreCase) || string.Equals(loaded.master.invoiceno, targetBillNo, StringComparison.OrdinalIgnoreCase)))))
                        {
                            fullRequest = loaded;
                            break;
                        }
                    }
                }
                catch { }
            }

            if (fullRequest == null)
            {
                fullRequest = new sales_request
                {
                    master = new sales_master
                    {
                        salescode = sales.salescode,
                        billno = sales.billno,
                        billdate = sales.billdate,
                        invoiceno = sales.invoiceno,
                        invoicedate = sales.invoicedate,
                        customercode = sales.customercode,
                        grossamount = sales.grossamount,
                        discountpercentage = sales.discountpercentage,
                        discountamount = sales.discountamount,
                        taxamount = sales.taxamount,
                        netamount = sales.netamount,
                        roundoff = sales.roundoff,
                        paymentmode = sales.paymentmode,
                        paymentstatus = "Print Delivered",
                        currencycode = sales.currencycode ?? "INR",
                        isactive = true,
                        deleted = false,
                        remarks = sales.remarks,
                        usercode = sales.usercode ?? GetEffectiveUserCode(),
                        tenantcode = sales.tenantcode ?? DefaultTenant,
                        branchcode = sales.branchcode ?? "BLR001",
                        companycode = sales.companycode ?? "CMP001",
                        ordercode = sales.ordercode,
                        cntcode = sales.cntcode ?? 0,
                        salestype = sales.salestype,
                        warehousefield = sales.warehousefield,
                        patientid = sales.patientid,
                        patientname = sales.patientname,
                        customername = sales.customername,
                        mobileno = sales.mobileno,
                        address = sales.address,
                        consultant = sales.consultant
                    },
                    details = new List<sales_detail>()
                };
            }
            else
            {
                fullRequest.master.paymentstatus = "Print Delivered";
                fullRequest.master.modifieddate = DateTime.Now;
            }

            var updateEndpoints = new[] { "api/ItemMaster/updatesales", "api/ItemMaster/insertsales" };
            bool saved = false;
            foreach (var ep in updateEndpoints)
            {
                try
                {
                    var res = await client.PostAsJsonAsync(ep, fullRequest);
                    var body = await res.Content.ReadAsStringAsync();
                    if (res.IsSuccessStatusCode && !body.Contains("\"success\":false") && !body.Contains("\"status\":\"Failed\"") && !body.Contains("orderedqty"))
                    {
                        saved = true;
                        break;
                    }
                }
                catch { }
            }

            if (saved)
            {
                ToastService.ShowSuccess($"Status changed to Print Delivered for Bill #{sales.billno ?? sales.salescode.ToString()}.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SalesMaster] Error updating bill status to Print Delivered: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task PreviewPharmacyBillReport(sales_master sales)
    {
        _activePreviewSales = sales;
        var rawBillNo = !string.IsNullOrWhiteSpace(sales.billno) ? sales.billno : sales.salescode.ToString();
        try
        {
            activeReportBillNo = rawBillNo;
            StateHasChanged();

            string base64Data = await FetchPharmacyBillReportBase64(rawBillNo);

            if (!string.IsNullOrWhiteSpace(base64Data) && (base64Data.StartsWith("data:application/pdf") || base64Data.Length > 100))
            {
                string cleanBillNo = rawBillNo.TrimStart('#');
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("openPdfPreviewModal", base64Data, $"Pharmacy Bill - {cleanBillNo}", _dotNetRef);
            }
            else
            {
                ToastService.ShowError("Unable to load PDF preview: Invalid report data returned.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading pharmacy bill report: {ex.Message}");
        }
        finally
        {
            activeReportBillNo = null;
            StateHasChanged();
        }
    }

