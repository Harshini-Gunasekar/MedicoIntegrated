    private sales_detail ParseSalesDetail(JsonElement target, JsonSerializerOptions options)
    {
        sales_detail? d = null;
        try {
            d = JsonSerializer.Deserialize<sales_detail>(target.GetRawText(), options);
        } catch { }

        d ??= new sales_detail();

        if (d.itemcode == 0) {
            foreach (var key in new[] { "itemcode", "item_code", "drug_code", "drugcode", "productcode", "itemid" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetInt64(out var code)) { d.itemcode = code; break; }
                    else if (p.ValueKind == JsonValueKind.String && long.TryParse(p.GetString(), out var parsedCode)) { d.itemcode = parsedCode; break; }
                }
            }
        }

        if (string.IsNullOrWhiteSpace(d.itemname)) {
            foreach (var key in new[] { "itemname", "item_name", "drug_name", "drugname", "productname", "medicine_name" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    d.itemname = GetJsonStringSafe(p);
                    if (!string.IsNullOrWhiteSpace(d.itemname)) break;
                }
            }
        }

        if (!d.days.HasValue || d.days.Value <= 0) {
            foreach (var key in new[] { "days", "no_of_days", "prescribeddays", "prescribed_days", "duration" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetInt32(out var daysVal) && daysVal > 0) { d.days = daysVal; break; }
                    else if (p.ValueKind == JsonValueKind.String) {
                        var parsedDays = ParseDaysFromDuration(null, p.GetString());
                        if (parsedDays.HasValue && parsedDays.Value > 0) { d.days = parsedDays.Value; break; }
                    }
                }
            }
        }

        if (d.quantity == 0) {
            foreach (var key in new[] { "quantity", "qty", "soldqty", "sold_qty" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetDecimal(out var qVal)) { d.quantity = qVal; break; }
                    else if (p.ValueKind == JsonValueKind.String && decimal.TryParse(p.GetString(), out var parsedQ)) { d.quantity = parsedQ; break; }
