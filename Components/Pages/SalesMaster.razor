                                                                            <span class="badge bg-light text-secondary ms-2" style="font-size: 0.68rem; font-weight: 600; border: 1px solid #e2e8f0;">@itemTypeName</span>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
