    private async Task SelectBranch(Booking.Models.BranchModel branch)
    {
        if (branch != null)
        {
            SelectedBhCode = branch.bh_code;
            SyncSelectedBranchToCurrentRequest();

            var currentTab = BillingTabs.FirstOrDefault(t => t.TabId == ActiveTabId);
            if (currentTab != null)
            {
                currentTab.SelectedBhCode = SelectedBhCode;
            }

            var availableCounters = GetFilteredCounters().ToList();
            if (availableCounters.Any())
            {
                if (!availableCounters.Any(c => c.cntcode == SelectedCntCode))
                {
                    SelectedCntCode = availableCounters.First().cntcode;
                    SyncSelectedCounterToCurrentRequest();
                    if (currentTab != null)
                    {
                        currentTab.SelectedCntCode = SelectedCntCode;
                    }
                }
            }
            else
            {
                SelectedCntCode = 0;
                SyncSelectedCounterToCurrentRequest();
                if (currentTab != null)
                {
                    currentTab.SelectedCntCode = 0;
                }
            }

            await SaveBranchAndCounterToSessionAsync();

            // When branch changes, re-evaluate batches for all detail items in the selected store
            if (CurrentRequest?.details != null)
            {
                foreach (var d in CurrentRequest.details.Where(d => d.itemcode > 0))
                {
                    d.batchno = ""; // Reset previous batch so newly selected branch/store batch is selected
                    d.expirydate = null;
                    UpdateItemBatchAndExpiryForStore(d, SelectedWarehouseCode ?? 0);
                }
            }
        }
        isBranchDropdownOpen = false;
        StateHasChanged();
    }

