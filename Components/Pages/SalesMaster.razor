                CounterList = new List<CounterMasterModel>
                {
                    new() { cntcode = 1, bhcode = SelectedBhCode > 0 ? SelectedBhCode : 1, name = "Main Counter" }
                };
            }

            // Try reading default cntcode from session storage
            try
            {
                var cntSession = await _sessionStorage.GetAsync<string>("cntcode");
                if (cntSession.Success && decimal.TryParse(cntSession.Value, out var sessionCnt) && sessionCnt > 0)
