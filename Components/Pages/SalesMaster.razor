    private async Task SaveBranchAndCounterToSessionAsync()
    {
        try
        {
            if (SelectedBhCode > 0)
            {
                await _sessionStorage.SetAsync(SessionBranchKey, SelectedBhCode);
                await _sessionStorage.SetAsync("bh_code", SelectedBhCode);
                await _sessionStorage.SetAsync("bhcode", SelectedBhCode.ToString());
            }
            if (SelectedCntCode > 0)
            {
                await _sessionStorage.SetAsync(SessionCounterKey, SelectedCntCode);
                await _sessionStorage.SetAsync("cntcode", SelectedCntCode.ToString());
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SalesMaster] Error saving branch & counter to session: {ex.Message}");
        }
    }

    private async Task LoadBranchAndCounterFromSessionAsync()
    {
        try
        {
            var bhRes = await _sessionStorage.GetAsync<int>(SessionBranchKey);
            if (bhRes.Success && bhRes.Value > 0)
            {
                if (BranchList != null && BranchList.Any(b => b.bh_code == bhRes.Value))
                {
                    SelectedBhCode = bhRes.Value;
                }
            }
            else
            {
                var altBh = await _sessionStorage.GetAsync<string>("bhcode");
                if (altBh.Success && int.TryParse(altBh.Value, out var parsedBh) && parsedBh > 0)
                {
                    if (BranchList != null && BranchList.Any(b => b.bh_code == parsedBh))
                    {
                        SelectedBhCode = parsedBh;
                    }
                }
            }

            if (SelectedBhCode > 0)
            {
                SyncSelectedBranchToCurrentRequest();
            }

            var cntRes = await _sessionStorage.GetAsync<decimal>(SessionCounterKey);
            if (cntRes.Success && cntRes.Value > 0)
            {
                var available = GetFilteredCounters().ToList();
                if (available.Any(c => c.cntcode == cntRes.Value))
                {
                    SelectedCntCode = cntRes.Value;
                }
                else if (available.Any())
                {
                    SelectedCntCode = available.First().cntcode;
                }
            }
            else
            {
                var altCnt = await _sessionStorage.GetAsync<string>("cntcode");
                if (altCnt.Success && decimal.TryParse(altCnt.Value, out var parsedCnt) && parsedCnt > 0)
                {
                    var available = GetFilteredCounters().ToList();
                    if (available.Any(c => c.cntcode == parsedCnt))
                    {
                        SelectedCntCode = parsedCnt;
                    }
                    else if (available.Any())
                    {
                        SelectedCntCode = available.First().cntcode;
                    }
                }
            }

            if (SelectedCntCode > 0)
            {
                SyncSelectedCounterToCurrentRequest();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SalesMaster] Error loading branch & counter from session: {ex.Message}");
        }
    }

    private string GetDetailDosageBadge(sales_detail? detail)
    {
        if (detail == null) return string.Empty;

        if (!string.IsNullOrWhiteSpace(detail.dosage))
        {
            return detail.dosage.Trim();
        }

        var parts = new List<string>();
        var m = !string.IsNullOrWhiteSpace(detail.morning_dose) ? detail.morning_dose : detail.morning;
        var a = !string.IsNullOrWhiteSpace(detail.afternoon_dose) ? detail.afternoon_dose : detail.afternoon;
        var e = !string.IsNullOrWhiteSpace(detail.evening_dose) ? detail.evening_dose : detail.evening;
        var n = !string.IsNullOrWhiteSpace(detail.night_dose) ? detail.night_dose : detail.night;

        if (!string.IsNullOrWhiteSpace(m) && m != "0") parts.Add($"M: {m}");
        if (!string.IsNullOrWhiteSpace(a) && a != "0") parts.Add($"A: {a}");
        if (!string.IsNullOrWhiteSpace(e) && e != "0") parts.Add($"E: {e}");
        if (!string.IsNullOrWhiteSpace(n) && n != "0") parts.Add($"N: {n}");

        if (parts.Any())
        {
            return string.Join(", ", parts);
        }

        if (detail.queue_id.HasValue && detail.queue_id.Value != Guid.Empty)
        {
            var match = PendingPrescriptions.FirstOrDefault(p => p.QueueId == detail.queue_id.Value);
            if (match != null && !string.IsNullOrWhiteSpace(match.Dosage))
            {
                return match.Dosage;
            }
        }
        if (detail.pr_det_id.HasValue && detail.pr_det_id.Value != Guid.Empty)
        {
            var match = PendingPrescriptions.FirstOrDefault(p => p.PrDetId == detail.pr_det_id.Value);
            if (match != null && !string.IsNullOrWhiteSpace(match.Dosage))
            {
                return match.Dosage;
            }
        }

        return string.Empty;
    }

