    private List<sales_master> SalesList = new();
    private List<customer_master> CustomerList = new();
    private List<inventory_item_master> ItemList = new();
    private List<category_master> CategoryList = new();
    private List<stock_master> StockList = new();
    private List<warehouse_master> WarehouseList = new();
    private List<PatientPartitionModel> PatientPartitionList = new();
    private sales_request CurrentRequest = new() { master = new(), details = new() };
    private sales_detail NewDetailItem = new();

    private List<OPRegistrationModel.OpRegistrationModel> OpRegistrationList = new();
    private List<IPRegistrationModel.IpRegistrationModel> IpRegistrationList = new();
    private List<DoctorMasterModel> DoctorList = new();

    public class PendingPrescriptionDisplayItem
