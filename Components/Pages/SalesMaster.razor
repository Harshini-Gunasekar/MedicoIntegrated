                                                        <option value="@w.warehousecode">@w.warehousename</option>
                                                    }
                                                </select>
                                                <i class="bi bi-chevron-down" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b; font-size: 0.8rem;"></i>
                                            </div>
                                        </div>
                                    </div>
