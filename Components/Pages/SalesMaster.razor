            string base64Data = await FetchSalesReportBase64();

            if (!string.IsNullOrWhiteSpace(base64Data) && (base64Data.StartsWith("data:application/pdf") || base64Data.Length > 100))
            {
                await JS.InvokeVoidAsync("openPdfPreviewModal", base64Data, "Sales Report");
            }
            else
            {
                ToastService.ShowError("Unable to load PDF preview: Invalid report data returned.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading sales report: {ex.Message}");
        }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

