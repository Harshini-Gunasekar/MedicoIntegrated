    private void SaveActiveFormToCurrentTab()
    {
        var currentTab = BillingTabs.FirstOrDefault(t => t.TabId == ActiveTabId);
        if (currentTab == null) return;

        currentTab.Request = CurrentRequest;
        currentTab.SelectedSalesType = SelectedSalesType;
        currentTab.SelectedWarehouseCode = SelectedWarehouseCode;
        currentTab.SelectedBhCode = SelectedBhCode;
        currentTab.SelectedCntCode = SelectedCntCode;
        currentTab.PatientIdSearchText = PatientIdSearchText;
        currentTab.PatientNameSearchText = PatientNameSearchText;
        currentTab.PatientMobileSearchText = PatientMobileSearchText;
        currentTab.IsEdit = IsEdit;
        currentTab.PendingPrescriptions = PendingPrescriptions.ToList();

        var patName = !string.IsNullOrWhiteSpace(CurrentRequest?.master?.patientname)
            ? CurrentRequest.master.patientname.Trim()
            : (!string.IsNullOrWhiteSpace(PatientNameSearchText) ? PatientNameSearchText.Trim() : "");

        if (!string.IsNullOrEmpty(patName))
        {
            currentTab.Title = patName.Length > 12 ? patName.Substring(0, 12) + "..." : patName;
        }
        else
        {
            currentTab.Title = $"Bill {currentTab.TabId}";
        }

        currentTab.ItemSearchTextsByIndex.Clear();
        currentTab.ExpiryDateTextsByIndex.Clear();
        if (CurrentRequest?.details != null)
        {
            for (int i = 0; i < CurrentRequest.details.Count; i++)
            {
                var d = CurrentRequest.details[i];
                if (ItemSearchTexts.TryGetValue(d, out var txt))
                {
                    currentTab.ItemSearchTextsByIndex[i] = txt;
                }
                if (ExpiryDateTexts.TryGetValue(d.GetHashCode(), out var expTxt))
                {
                    currentTab.ExpiryDateTextsByIndex[i] = expTxt;
                }
            }
        }
    }

    private void LoadTabIntoForm(PharmacyBillTab tab)
    {
        ActiveTabId = tab.TabId;
        CurrentRequest = tab.Request ?? new sales_request { master = new(), details = new() };
        _selectedSalesType = tab.SelectedSalesType ?? "Counter Sales";
        if (CurrentRequest.master != null)
        {
            CurrentRequest.master.salestype = _selectedSalesType;
        }
        _selectedWarehouseCode = tab.SelectedWarehouseCode;

        if (tab.SelectedBhCode.HasValue && tab.SelectedBhCode.Value > 0)
        {
            SelectedBhCode = tab.SelectedBhCode.Value;
        }
        else if (CurrentRequest?.master?.bh_code.HasValue == true && CurrentRequest.master.bh_code.Value > 0)
        {
            SelectedBhCode = CurrentRequest.master.bh_code.Value;
        }
        else if (BranchList != null && BranchList.Any())
        {
            var defaultBranch = BranchList.FirstOrDefault(b => b.is_main_branch == true) ?? BranchList.First();
            SelectedBhCode = defaultBranch.bh_code;
        }
        SyncSelectedBranchToCurrentRequest();

        if (tab.SelectedCntCode.HasValue && tab.SelectedCntCode.Value > 0)
        {
            SelectedCntCode = tab.SelectedCntCode.Value;
        }
        else if (CurrentRequest?.master?.cntcode.HasValue == true && CurrentRequest.master.cntcode.Value > 0)
        {
            SelectedCntCode = CurrentRequest.master.cntcode.Value;
        }
        else if (CounterList != null && CounterList.Any())
        {
            var available = GetFilteredCounters().ToList();
            SelectedCntCode = available.Any() ? available.First().cntcode : CounterList.First().cntcode;
        }
        SyncSelectedCounterToCurrentRequest();

        PatientIdSearchText = tab.PatientIdSearchText ?? "";
        PatientNameSearchText = tab.PatientNameSearchText ?? "";
        PatientMobileSearchText = tab.PatientMobileSearchText ?? "";
        ActivePatientSearchField = "";
        IsEdit = tab.IsEdit;
        PendingPrescriptions = tab.PendingPrescriptions?.ToList() ?? new();
        showUnbilledPrescriptionModal = false;

        _originalPrescriptionMap.Clear();
        showConversionModal = false;
        conversionPrescribedDays = null;
        conversionTargetDays = null;

        EditableRows.Clear();
        ItemSearchTexts.Clear();
        ExpiryDateTexts.Clear();

        if (CurrentRequest.details == null || !CurrentRequest.details.Any())
        {
            CurrentRequest.details = new List<sales_detail>();
            AddDetailRow();
        }
        else
        {
            for (int i = 0; i < CurrentRequest.details.Count; i++)
            {
                var d = CurrentRequest.details[i];
                EditableRows.Add(d);
                if (tab.ItemSearchTextsByIndex.TryGetValue(i, out var txt) && !string.IsNullOrEmpty(txt))
                {
                    ItemSearchTexts[d] = txt;
                }
                else if (d.itemcode > 0)
                {
                    var it = ItemList.FirstOrDefault(item => item.itemcode == d.itemcode);
                    if (it != null) ItemSearchTexts[d] = it.itemname ?? "";
                }

                if (tab.ExpiryDateTextsByIndex.TryGetValue(i, out var expTxt) && !string.IsNullOrEmpty(expTxt))
                {
                    ExpiryDateTexts[d.GetHashCode()] = expTxt;
                }
                else if (d.expirydate.HasValue)
                {
                    ExpiryDateTexts[d.GetHashCode()] = d.expirydate.Value.ToString("MM/yy", System.Globalization.CultureInfo.InvariantCulture);
                }
            }
        }

        CalculateTotals();
    }

    private PharmacyBillTab CreateNewBillingTab(int tabId)
