    // Field order in a row: 0=item, 1=batch, 2=expiry, 3=days, 4=qty, 5=rate, 6=disc, 7=tax
    private readonly string[] _rowFieldPrefixes = { "item-input", "batch", "expiry", "days", "qty", "rate", "disc", "tax" };

    private async Task HandleRowKeyDown(KeyboardEventArgs e, int rowIndex, int fieldIndex)
    {
        if (e.Key == "Enter" || e.Key == "Tab")
        {
            int nextField = fieldIndex + 1;
            int nextRow = rowIndex;
            if (nextField >= _rowFieldPrefixes.Length)
            {
                nextField = 0;
                nextRow = rowIndex + 1;
                // If next row doesn't exist, add one
                if (nextRow >= CurrentRequest.details.Count)
                {
                    AddDetailRow();
                    StateHasChanged();
                }
            }
            var targetId = $"{_rowFieldPrefixes[nextField]}-{nextRow}";
            try
            {
                await JS.InvokeVoidAsync("focusElement", targetId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[HandleRowKeyDown] Error focusing element '{targetId}': {ex.Message}");
            }
        }
    }

