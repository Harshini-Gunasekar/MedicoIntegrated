    private async Task LoadBranches()
    {
        try
        {
            var effectiveTenant = !string.IsNullOrEmpty(DefaultTenant) ? DefaultTenant : (TenantState?.TenantCode ?? "");
            var effectiveToken = !string.IsNullOrEmpty(AuthToken) ? AuthToken : TenantState?.AuthToken;

            // 1. Try LabCareUrl
            try
            {
                var labClient = ClientFactory.CreateClient("LabCareUrl");
                if (!string.IsNullOrEmpty(effectiveTenant))
                {
                    labClient.DefaultRequestHeaders.Remove("tenant_code");
                    labClient.DefaultRequestHeaders.Remove("tenantcode");
                    labClient.DefaultRequestHeaders.Add("tenant_code", effectiveTenant);
                    labClient.DefaultRequestHeaders.Add("tenantcode", effectiveTenant);
                }
                if (!string.IsNullOrEmpty(effectiveToken))
                {
                    labClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
                }
                var response = await labClient.GetAsync("api/Branch/get");
                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync();
                    if (!string.IsNullOrWhiteSpace(json))
                    {
                        var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json);
                        if (list != null && list.Any())
                        {
                            BranchList = list.Where(b => !b.deleted).ToList();
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SalesMaster] LabCareUrl Branch/get error: {ex.Message}");
            }

            // 2. If empty, try DoctorApi client
            if (BranchList == null || !BranchList.Any())
            {
                try
                {
                    var client = CreateClient();
                    var response = await client.GetAsync("api/Branch/get");
                    if (response.IsSuccessStatusCode)
                    {
                        var json = await response.Content.ReadAsStringAsync();
                        if (!string.IsNullOrWhiteSpace(json))
                        {
                            var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json);
                            if (list != null && list.Any())
                            {
                                BranchList = list.Where(b => !b.deleted).ToList();
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[SalesMaster] DoctorApi Branch/get error: {ex.Message}");
                }
            }

            // Filter by user's assigned branch rights for non-admins
            if (BranchList != null && BranchList.Any() && !IsAdminUser())
            {
                var allowed = GetAuthorizedBranchCodes();
                if (allowed.Any())
                {
                    BranchList = BranchList.Where(b => allowed.Contains(b.bh_code)).ToList();
                }
            }

            // Set default selected branch if not yet selected
            if (SelectedBhCode == 0 && BranchList != null && BranchList.Any())
            {
                var defaultBranch = BranchList.FirstOrDefault(b => b.is_main_branch == true) ?? BranchList.First();
                SelectedBhCode = defaultBranch.bh_code;
                SyncSelectedBranchToCurrentRequest();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SalesMaster] LoadBranches exception: {ex.Message}");
        }
    }

