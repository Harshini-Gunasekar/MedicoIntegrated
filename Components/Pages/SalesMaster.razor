        if (d.rate == 0) {
            foreach (var key in new[] { "rate", "unitrate", "mrp", "salesrate", "price" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetDecimal(out var rVal)) { d.rate = rVal; break; }
                    else if (p.ValueKind == JsonValueKind.String && decimal.TryParse(p.GetString(), out var parsedR)) { d.rate = parsedR; break; }
                }
            }
        }

        if (!d.queue_id.HasValue || d.queue_id.Value == Guid.Empty) {
            foreach (var key in new[] { "queue_id", "queueid", "queueId", "queue_guid" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.String && Guid.TryParse(p.GetString(), out var g)) { d.queue_id = g; break; }
                }
            }
        }

        if (!d.pr_det_id.HasValue || d.pr_det_id.Value == Guid.Empty) {
            foreach (var key in new[] { "pr_det_id", "prdetid", "prDetId", "pr_det_guid", "prescription_item_id" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.String && Guid.TryParse(p.GetString(), out var g)) { d.pr_det_id = g; break; }
                }
            }
        }

        if (!d.expirydate.HasValue) {
            foreach (var key in new[] { "expirydate", "expiry_date", "exp_date", "expiry" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.String && DateTime.TryParse(p.GetString(), out var dt)) {
                        d.expirydate = dt;
                        break;
                    }
                }
            }
        }

        if (string.IsNullOrWhiteSpace(d.morning_dose) && TryGetPropertyIgnoreCase(target, "morning_dose", out var md)) d.morning_dose = GetJsonStringSafe(md);
        if (string.IsNullOrWhiteSpace(d.afternoon_dose) && TryGetPropertyIgnoreCase(target, "afternoon_dose", out var ad)) d.afternoon_dose = GetJsonStringSafe(ad);
        if (string.IsNullOrWhiteSpace(d.evening_dose) && TryGetPropertyIgnoreCase(target, "evening_dose", out var ed)) d.evening_dose = GetJsonStringSafe(ed);
        if (string.IsNullOrWhiteSpace(d.night_dose) && TryGetPropertyIgnoreCase(target, "night_dose", out var nd)) d.night_dose = GetJsonStringSafe(nd);
        if (string.IsNullOrWhiteSpace(d.morning) && TryGetPropertyIgnoreCase(target, "morning", out var m)) d.morning = GetJsonStringSafe(m);
        if (string.IsNullOrWhiteSpace(d.afternoon) && TryGetPropertyIgnoreCase(target, "afternoon", out var a)) d.afternoon = GetJsonStringSafe(a);
        if (string.IsNullOrWhiteSpace(d.evening) && TryGetPropertyIgnoreCase(target, "evening", out var ev)) d.evening = GetJsonStringSafe(ev);
        if (string.IsNullOrWhiteSpace(d.night) && TryGetPropertyIgnoreCase(target, "night", out var n)) d.night = GetJsonStringSafe(n);
        if (string.IsNullOrWhiteSpace(d.dosage) && TryGetPropertyIgnoreCase(target, "dosage", out var dos)) d.dosage = GetJsonStringSafe(dos);

        if (!d.days.HasValue || d.days.Value <= 0) {
            d.days = 1;
        }
        d.prescribeddays = d.days;
        d.no_of_days = d.days;
        d.duration = d.days.ToString();
        d.taxpercentage = 0;
        d.taxamount = 0;

        return d;
    }

    private List<sales_master> ParseSalesListResponse(string json, out string? parseError)
    {
        parseError = null;
        if (string.IsNullOrWhiteSpace(json)) return new();
        var options = new JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };
        
        try {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            
            JsonElement arrayElement = default;
            bool foundArray = false;

            if (root.ValueKind == JsonValueKind.Array) {
                arrayElement = root;
                foundArray = true;
            } else if (root.ValueKind == JsonValueKind.Object) {
                if (root.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == JsonValueKind.Array) {
                    arrayElement = dataProp;
                    foundArray = true;
                } else {
                    foreach (var prop in root.EnumerateObject()) {
                        if (prop.Value.ValueKind == JsonValueKind.Array) {
                            arrayElement = prop.Value;
                            foundArray = true;
                            break;
                        }
                    }
                }
            }

            if (!foundArray) {
                if (root.ValueKind == JsonValueKind.Object) {
                    if (root.TryGetProperty("message", out var mProp)) {
                        parseError = $"Server message: {GetJsonStringSafe(mProp)}";
                    } else if (root.TryGetProperty("status", out var sProp) && sProp.GetString() != "Success") {
                        parseError = $"Server status: {GetJsonStringSafe(sProp)}";
                    }
                }
                return new();
            }

            var result = new List<sales_master>();
            var reqList = new List<sales_request>();
            foreach (var item in arrayElement.EnumerateArray()) {
                try {
                    var m = ParseMaster(item, options);
                    if (m != null)
                    {
                        result.Add(m);
                        var req = new sales_request { master = m, details = new() };
                        if (TryGetPropertyIgnoreCase(item, "details", out var dProp) || 
                            TryGetPropertyIgnoreCase(item, "detail", out dProp) || 
                            TryGetPropertyIgnoreCase(item, "salesdetail", out dProp) || 
                            TryGetPropertyIgnoreCase(item, "salesdetails", out dProp) || 
                            TryGetPropertyIgnoreCase(item, "items", out dProp))
                        {
                            if (dProp.ValueKind == JsonValueKind.Array)
                            {
                                foreach (var dEl in dProp.EnumerateArray())
                                {
                                    var det = ParseSalesDetail(dEl, options);
                                    if (det != null) req.details.Add(det);
                                }
                            }
                        }
                        reqList.Add(req);
                    }
                } catch (Exception itemEx) {
                    Console.WriteLine($"[SalesMaster] Item parse error: {itemEx.Message}");
                }
            }
            AllSavedSalesRequests = reqList;
            SyncBilledCacheFromSavedSales();
            return result.OrderByDescending(x => x.salescode > 0 ? x.salescode : x.billdate.Ticks).ToList();
        } catch (Exception ex) {
            Console.WriteLine("Parse Error: " + ex.Message);
            parseError = $"JSON Parse Error: {ex.Message}";
        }

        return new();
    }

    private sales_request? ParseRequestResponse(string json, long? targetSalesCode = null, string? targetBillNo = null)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        var options = new JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };
        
        try {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            
            // 1. Unwrap "data" if present
            if (root.ValueKind == JsonValueKind.Object && TryGetPropertyIgnoreCase(root, "data", out var dataProp)) {
                root = dataProp;
            }
            
            // 2. Handle array: Find the exact element matching target sales code or bill number
            if (root.ValueKind == JsonValueKind.Array) {
                JsonElement? matchedElement = null;
                
                foreach (var item in root.EnumerateArray()) {
                    sales_master? m = null;
                    if (item.ValueKind == JsonValueKind.Object) {
                        m = ParseMaster(item, options);
                    }
                    if (m != null) {
                        if (targetSalesCode.HasValue && targetSalesCode.Value > 0 && m.salescode == targetSalesCode.Value) {
                            matchedElement = item;
                            break;
                        }
                        if (!string.IsNullOrWhiteSpace(targetBillNo) && (
                            string.Equals(m.billno?.Trim(), targetBillNo.Trim(), StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(m.invoiceno?.Trim(), targetBillNo.Trim(), StringComparison.OrdinalIgnoreCase))) {
                            matchedElement = item;
                            break;
                        }
                    }
                }

                if (targetSalesCode.HasValue && targetSalesCode.Value > 0 || !string.IsNullOrWhiteSpace(targetBillNo)) {
                    if (matchedElement.HasValue) {
                        root = matchedElement.Value;
                    } else {
                        return null;
                    }
                } else if (root.GetArrayLength() > 0) {
                    root = root[0];
                } else {
                    return null;
                }
            }
            
            // 3. Deserialize root as sales_request
            if (root.ValueKind == JsonValueKind.Object) {
                if (TryGetPropertyIgnoreCase(root, "master", out var masterProp)) {
                    var req = new sales_request();
                    req.master = ParseMaster(masterProp, options) ?? new sales_master();
                    
                    if (TryGetPropertyIgnoreCase(root, "details", out var detailsProp) && detailsProp.ValueKind == JsonValueKind.Array) {
                        req.details = new List<sales_detail>();
                        foreach (var dEl in detailsProp.EnumerateArray()) {
                            req.details.Add(ParseSalesDetail(dEl, options));
                        }
                    } else {
                        req.details = new();
                    }
                    return req;
                }
                
                // Or maybe it's just a direct sales_master (without details)
                var directMaster = ParseMaster(root, options);
                if (directMaster != null && directMaster.salescode > 0) {
                    var req = new sales_request { master = directMaster, details = new() };
                    if (TryGetPropertyIgnoreCase(root, "details", out var detailsProp) && detailsProp.ValueKind == JsonValueKind.Array) {
                        req.details = new List<sales_detail>();
                        foreach (var dEl in detailsProp.EnumerateArray()) {
                            req.details.Add(ParseSalesDetail(dEl, options));
                        }
                    }
                    return req;
                }
            }
        } catch (Exception ex) {
            Console.WriteLine("ParseRequestResponse error: " + ex.Message);
        }

        try {
            var direct = JsonSerializer.Deserialize<sales_request>(json, options);
            if (direct != null && direct.master != null) {
                if (!targetSalesCode.HasValue || direct.master.salescode == targetSalesCode.Value) return direct;
            }
        } catch {}

        try {
            var wrapped = JsonSerializer.Deserialize<ServiceResponse<sales_request>>(json, options);
            if (wrapped?.data?.master != null) {
                if (!targetSalesCode.HasValue || wrapped.data.master.salescode == targetSalesCode.Value) return wrapped.data;
            }
        } catch {}

        try {
            var directMaster = JsonSerializer.Deserialize<sales_master>(json, options);
            if (directMaster != null && directMaster.salescode > 0)
            {
                if (!targetSalesCode.HasValue || directMaster.salescode == targetSalesCode.Value)
                    return new sales_request { master = directMaster, details = new() };
            }
        } catch {}

        return null;
    }

    private static bool TryGetPropertyIgnoreCase(JsonElement el, string name, out JsonElement prop)
    {
        prop = default;
        if (el.ValueKind != JsonValueKind.Object) return false;
        foreach (var p in el.EnumerateObject()) {
            if (string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase)) {
                prop = p.Value;
                return true;
            }
        }
        return false;
    }

    private long selectedReportWarehouseCode = 0;
    private DateTime selectedReportFromDate = DateTime.Now;
    private DateTime selectedReportToDate = DateTime.Now;
    private bool isPrinting = false;
    private bool isPrintingPdf = false;

    private async Task<string> FetchSalesReportBase64()
    {
        if (string.IsNullOrWhiteSpace(DefaultTenant))
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success ? tenantCodeResult.Value ?? "0010" : "0010";
        }

        if (string.IsNullOrWhiteSpace(AuthToken))
        {
            try
            {
                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                if (!tokenResult.Success || string.IsNullOrEmpty(tokenResult.Value))
                {
                    tokenResult = await _sessionStorage.GetAsync<string>("auth_token");
                }
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : (TenantState?.AuthToken ?? "");
            }
            catch {}
        }

        long code = selectedReportWarehouseCode;
        string fromDateStr = selectedReportFromDate.ToString("yyyy-MM-dd");
        string toDateStr = selectedReportToDate.ToString("yyyy-MM-dd");

        string? apiBase = Configuration["ApiBaseUrl"]?.TrimEnd('/');
        var candidateUrls = new List<string>();
        if (!string.IsNullOrEmpty(apiBase))
        {
            candidateUrls.Add($"{apiBase}/api/report/sales-report?warehousecode={code}&fromdate={fromDateStr}&todate={toDateStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
            candidateUrls.Add($"{apiBase}/api/Report/SalesReport?warehousecode={code}&fromdate={fromDateStr}&todate={toDateStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
        }
        candidateUrls.Add($"api/report/sales-report?warehousecode={code}&fromdate={fromDateStr}&todate={toDateStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
        candidateUrls.Add($"api/report/sales-report?warehousecode={code}&fromDate={fromDateStr}&toDate={toDateStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");
        candidateUrls.Add($"api/report/sales-report?warehousecode={code}&from_date={fromDateStr}&to_date={toDateStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}");

        var client = CreateClient();
        string lastError = "";

        foreach (var url in candidateUrls)
        {
            try
            {
                var req = new HttpRequestMessage(HttpMethod.Get, url);
                var effectiveToken = !string.IsNullOrEmpty(AuthToken) ? AuthToken : TenantState?.AuthToken;
                if (!string.IsNullOrEmpty(effectiveToken))
                {
                    req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
                }
                req.Headers.Add("tenantcode", DefaultTenant);
                req.Headers.Add("tenant_code", DefaultTenant);
                req.Headers.Add("tenant-code", DefaultTenant);

                var response = await client.SendAsync(req);

                if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
                {
                    var contentStr = await response.Content.ReadAsStringAsync();
                    contentStr = contentStr.Trim('"').Trim();

                    string base64Data = contentStr;
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(contentStr);
                        var root = doc.RootElement;
                        if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {
                            if (root.TryGetProperty("data", out var dProp)) base64Data = dProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("base64", out var bProp)) base64Data = bProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("file", out var fProp)) base64Data = fProp.GetString() ?? contentStr;
                        }
                        else if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                        {
                            base64Data = root.GetString() ?? contentStr;
                        }
                    }
                    catch { }

                    if (!string.IsNullOrWhiteSpace(base64Data) && base64Data.Length >= 50)
                    {
                        return base64Data;
                    }
                }
                else
                {
                    var errContent = await response.Content.ReadAsStringAsync();
                    lastError = $"HTTP {(int)response.StatusCode} ({response.ReasonPhrase}): {errContent}";
                }
            }
            catch (Exception ex)
            {
                lastError = ex.Message;
            }
        }

        throw new Exception(string.IsNullOrEmpty(lastError) ? "Backend report endpoint returned empty data." : lastError);
    }

