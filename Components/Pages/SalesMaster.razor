    private async Task SelectOpPatient(OPRegistrationModel.OpRegistrationModel op)
    {
        CurrentRequest.master.patientid = !string.IsNullOrWhiteSpace(op.op_no) ? op.op_no : op.custid.ToString();
        CurrentRequest.master.patientname = FormatPatientNameWithAgeGender(op.patient_name, (long)op.custid);
