            Console.WriteLine($"[SalesMaster] LoadCounters error: {ex.Message}");
            if (CounterList == null || !CounterList.Any())
            {
                CounterList = new List<CounterMasterModel>
                {
                    new() { cntcode = 1, bhcode = SelectedBhCode > 0 ? SelectedBhCode : 1, name = "Main Counter" }
                };
                SelectedCntCode = 1;
                SyncSelectedCounterToCurrentRequest();
            }
        }
    }

