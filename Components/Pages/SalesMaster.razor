                <button type="button" class="popup-btn popup-btn-delete" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<sales_master> SalesList = new();
    private List<customer_master> CustomerList = new();
    private List<inventory_item_master> ItemList = new();
    private List<stock_master> StockList = new();
    private List<warehouse_master> WarehouseList = new();
    private List<PatientPartitionModel> PatientPartitionList = new();
    private sales_request CurrentRequest = new() { master = new(), details = new() };
    private sales_detail NewDetailItem = new();

    private List<OPRegistrationModel.OpRegistrationModel> OpRegistrationList = new();
    private List<IPRegistrationModel.IpRegistrationModel> IpRegistrationList = new();
    private List<DoctorMasterModel> DoctorList = new();

    private class SalesTypeDraft
    {
        public string? PatientId { get; set; }
        public string? PatientName { get; set; }
        public string? MobileNo { get; set; }
        public string? Address { get; set; }
        public string? Consultant { get; set; }
        public long? CustomerCode { get; set; }
        public string PatientIdSearchText { get; set; } = "";
        public string PatientNameSearchText { get; set; } = "";
        public string PatientMobileSearchText { get; set; } = "";
        public long? SelectedWarehouseCode { get; set; }
        public List<sales_detail> Details { get; set; } = new();
        public Dictionary<sales_detail, string> ItemSearchTexts { get; set; } = new();
        public string? Remarks { get; set; }
        public string? PaymentMode { get; set; }
        public string? PaymentStatus { get; set; }
        public decimal RoundOff { get; set; }
    }

    private Dictionary<string, SalesTypeDraft> _salesTypeDrafts = new();

    private string _selectedSalesType = "Counter Sales";
    private string SelectedSalesType
    {
        get => _selectedSalesType;
        set
        {
            if (_selectedSalesType != value)
            {
                OnSalesTypeChanged(value);
            }
        }
    }

    private void OnSalesTypeChanged(string newType)
    {
        // 1. Save draft for previous sales type
        SaveCurrentDraft(_selectedSalesType);

        // 2. Switch to new sales type
        _selectedSalesType = newType;
        CurrentRequest.master.salestype = newType;

        // 3. Restore draft if previously visited, or initialize fresh blank state
        if (_salesTypeDrafts.TryGetValue(newType, out var draft))
        {
            RestoreDraft(draft);
        }
        else
        {
            ResetToFreshStateForSalesType(newType);
        }

        CalculateTotals();
        StateHasChanged();
    }

    private void SaveCurrentDraft(string type)
    {
        if (CurrentRequest?.master == null || string.IsNullOrWhiteSpace(type)) return;

        var draft = new SalesTypeDraft
        {
            PatientId = CurrentRequest.master.patientid,
            PatientName = CurrentRequest.master.patientname,
            MobileNo = CurrentRequest.master.mobileno,
            Address = CurrentRequest.master.address,
            Consultant = CurrentRequest.master.consultant,
            CustomerCode = CurrentRequest.master.customercode,
            PatientIdSearchText = PatientIdSearchText,
            PatientNameSearchText = PatientNameSearchText,
            PatientMobileSearchText = PatientMobileSearchText,
            SelectedWarehouseCode = SelectedWarehouseCode,
            Remarks = CurrentRequest.master.remarks,
            PaymentMode = CurrentRequest.master.paymentmode,
            PaymentStatus = CurrentRequest.master.paymentstatus,
            RoundOff = CurrentRequest.master.roundoff,
            Details = CurrentRequest.details?.Select(d => new sales_detail
            {
                salesdetailcode = d.salesdetailcode,
                salescode = d.salescode,
                itemcode = d.itemcode,
                quantity = d.quantity,
                freequantity = d.freequantity,
                uomcode = d.uomcode,
                rate = d.rate,
                discountpercentage = d.discountpercentage,
                discountamount = d.discountamount,
                taxpercentage = d.taxpercentage,
                taxamount = d.taxamount,
                amount = d.amount,
                totalamount = d.totalamount,
                batchno = d.batchno,
                manufacturingdate = d.manufacturingdate,
                expirydate = d.expirydate,
                soldqty = d.soldqty,
                tenantcode = d.tenantcode,
                warehousecode = d.warehousecode,
                queue_id = d.queue_id
            }).ToList() ?? new(),
            ItemSearchTexts = new Dictionary<sales_detail, string>()
        };

        if (CurrentRequest.details != null)
        {
            for (int i = 0; i < CurrentRequest.details.Count; i++)
            {
                var orig = CurrentRequest.details[i];
                if (i < draft.Details.Count && ItemSearchTexts.TryGetValue(orig, out var text))
                {
                    draft.ItemSearchTexts[draft.Details[i]] = text;
                }
            }
        }

        _salesTypeDrafts[type] = draft;
    }

    private void RestoreDraft(SalesTypeDraft draft)
    {
        CurrentRequest.master.patientid = draft.PatientId;
        CurrentRequest.master.patientname = draft.PatientName;
        CurrentRequest.master.mobileno = draft.MobileNo;
        CurrentRequest.master.address = draft.Address;
        CurrentRequest.master.consultant = draft.Consultant;
        CurrentRequest.master.customercode = draft.CustomerCode;
        CurrentRequest.master.remarks = draft.Remarks;
        CurrentRequest.master.roundoff = draft.RoundOff;
        if (!string.IsNullOrEmpty(draft.PaymentMode)) CurrentRequest.master.paymentmode = draft.PaymentMode;
        if (!string.IsNullOrEmpty(draft.PaymentStatus)) CurrentRequest.master.paymentstatus = draft.PaymentStatus;

        PatientIdSearchText = draft.PatientIdSearchText;
        PatientNameSearchText = draft.PatientNameSearchText;
        PatientMobileSearchText = draft.PatientMobileSearchText;
        ActivePatientSearchField = "";

        if (draft.SelectedWarehouseCode.HasValue && draft.SelectedWarehouseCode.Value > 0)
        {
            SelectedWarehouseCode = draft.SelectedWarehouseCode.Value;
        }

        CurrentRequest.details = draft.Details.Select(d => new sales_detail
        {
            salesdetailcode = d.salesdetailcode,
            salescode = d.salescode,
            itemcode = d.itemcode,
            quantity = d.quantity,
            freequantity = d.freequantity,
            uomcode = d.uomcode,
            rate = d.rate,
            discountpercentage = d.discountpercentage,
            discountamount = d.discountamount,
            taxpercentage = d.taxpercentage,
            taxamount = d.taxamount,
            amount = d.amount,
            totalamount = d.totalamount,
            batchno = d.batchno,
            manufacturingdate = d.manufacturingdate,
            expirydate = d.expirydate,
            soldqty = d.soldqty,
            tenantcode = d.tenantcode,
            warehousecode = d.warehousecode,
            queue_id = d.queue_id
        }).ToList();

        ItemSearchTexts.Clear();
        for (int i = 0; i < draft.Details.Count; i++)
        {
            var dDraft = draft.Details[i];
            if (i < CurrentRequest.details.Count)
            {
                var dNew = CurrentRequest.details[i];
                if (draft.ItemSearchTexts.TryGetValue(dDraft, out var text))
                {
                    ItemSearchTexts[dNew] = text;
                }
                else
                {
                    var item = ItemList.FirstOrDefault(item => item.itemcode == dNew.itemcode);
                    if (item != null) ItemSearchTexts[dNew] = item.itemname ?? "";
                }
            }
        }

        if (!CurrentRequest.details.Any())
        {
            AddDetailRow();
        }
    }

    private void ResetToFreshStateForSalesType(string type)
    {
        CurrentRequest.master.patientid = "";
        CurrentRequest.master.patientname = "";
        CurrentRequest.master.mobileno = "";
        CurrentRequest.master.address = "";
        CurrentRequest.master.consultant = "";
        CurrentRequest.master.customercode = null;
        PatientIdSearchText = "";
        PatientNameSearchText = "";
        PatientMobileSearchText = "";
        ActivePatientSearchField = "";

        CurrentRequest.details = new List<sales_detail>();
        ItemSearchTexts.Clear();
        AddDetailRow();
    }

    private string _patientIdSearchText = "";
    private string PatientIdSearchText
    {
        get => _patientIdSearchText;
        set
        {
            _patientIdSearchText = value;
            if (SelectedSalesType == "OP Sales" || SelectedSalesType == "IP Sales" || SelectedSalesType == "IP / OP Sales")
            {
                CurrentRequest.master.patientid = value;
            }
