    private string GetPatientItemKey(long custId, string? drugName, DateTime? date)
    {
        var cleanDrug = (drugName ?? "").Trim().ToUpperInvariant();
        var cleanDrugNorm = System.Text.RegularExpressions.Regex.Replace(cleanDrug, @"[^A-Z0-9]", "");
        var datePart = date.HasValue ? date.Value.ToString("yyyy-MM-dd") : "NODATE";
        return $"{custId}_{cleanDrugNorm}_{datePart}";
    }

    private string FormatPatientNameWithAgeGender(string? name, long? custId, string? gender = null, int? ageYears = null, int? ageMonths = null, int? ageDays = null)
    {
        var baseName = name?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(baseName))
        {
            return "";
        }

        // If already contains parentheses format e.g. "Name (25 Y / Male)", return as is
        if (baseName.Contains("(") && baseName.Contains(")"))
        {
            return baseName;
        }

        // If gender or age info not provided, look up from partition list or customer list
        if (custId.HasValue && custId.Value > 0)
        {
            var part = PatientPartitionList.FirstOrDefault(p => p.custid == custId.Value);
            if (part != null)
            {
                if (string.IsNullOrWhiteSpace(gender)) gender = part.gender;
                if (!ageYears.HasValue) ageYears = part.ageyears;
                if (!ageMonths.HasValue) ageMonths = part.agemonths;
                if (!ageDays.HasValue) ageDays = part.agedays;
            }

            var cust = CustomerList.FirstOrDefault(c => c.customercode == custId.Value);
            if (cust != null)
            {
                if (string.IsNullOrWhiteSpace(gender)) gender = cust.gender;
                if (!ageYears.HasValue) ageYears = cust.ageyears;
                if (!ageMonths.HasValue) ageMonths = cust.agemonths;
                if (!ageDays.HasValue) ageDays = cust.agedays;
            }
        }

        string ageStr = ageYears.HasValue && ageYears.Value > 0 
            ? $"{ageYears.Value} Y" 
            : (ageMonths.HasValue && ageMonths.Value > 0 ? $"{ageMonths.Value} M" : (ageDays.HasValue && ageDays.Value > 0 ? $"{ageDays.Value} D" : ""));
        string genderStr = !string.IsNullOrWhiteSpace(gender) ? gender.Trim() : "";

        if (!string.IsNullOrEmpty(ageStr) && !string.IsNullOrEmpty(genderStr))
            return $"{baseName} ({ageStr} / {genderStr})";
        if (!string.IsNullOrEmpty(ageStr))
            return $"{baseName} ({ageStr})";
        if (!string.IsNullOrEmpty(genderStr))
            return $"{baseName} ({genderStr})";

        return baseName;
    }

    private string GetPatientItemKeyByName(string? patientName, string? drugName, DateTime? date)
    {
        var basePat = (patientName ?? "").Split('(')[0].Trim();
        var cleanPat = System.Text.RegularExpressions.Regex.Replace(basePat.ToUpperInvariant(), @"[^A-Z0-9]", "");
        var cleanDrugNorm = System.Text.RegularExpressions.Regex.Replace((drugName ?? "").Trim().ToUpperInvariant(), @"[^A-Z0-9]", "");
        var datePart = date.HasValue ? date.Value.ToString("yyyy-MM-dd") : "NODATE";
        return $"NAME_{cleanPat}_{cleanDrugNorm}_{datePart}";
    }

    private void SyncBilledCacheFromSavedSales()
    {
        if (AllSavedSalesRequests == null || !AllSavedSalesRequests.Any()) return;
        foreach (var req in AllSavedSalesRequests)
        {
            if (req.details != null && req.details.Any())
            {
                var cId = req.master?.customercode ?? 0;
                var pName = req.master?.patientname ?? req.master?.customername ?? "";
                var pId = req.master?.patientid ?? "";
                var bDate = req.master?.billdate != default ? req.master.billdate : (DateTime?)null;

                foreach (var det in req.details)
                {
                    if (det.queue_id.HasValue && det.queue_id.Value != Guid.Empty)
                        BilledQueueIds.Add(det.queue_id.Value);
                    if (det.pr_det_id.HasValue && det.pr_det_id.Value != Guid.Empty)
                        BilledPrDetIds.Add(det.pr_det_id.Value);

                    var drug = !string.IsNullOrWhiteSpace(det.itemname) ? det.itemname : (det.itemcode > 0 ? ItemList.FirstOrDefault(i => i.itemcode == det.itemcode)?.itemname : "");
                    if (!string.IsNullOrWhiteSpace(drug))
                    {
                        if (cId > 0)
                        {
                            BilledPatientItemKeys.Add(GetPatientItemKey(cId, drug, bDate));
                            BilledPatientItemKeys.Add(GetPatientItemKey(cId, drug, null));
                        }
                        if (!string.IsNullOrWhiteSpace(pName))
                        {
                            BilledPatientItemKeys.Add(GetPatientItemKeyByName(pName, drug, bDate));
                            BilledPatientItemKeys.Add(GetPatientItemKeyByName(pName, drug, null));
                        }
                        if (!string.IsNullOrWhiteSpace(pId))
                        {
                            var cleanDrugNorm = System.Text.RegularExpressions.Regex.Replace(drug.Trim().ToUpperInvariant(), @"[^A-Z0-9]", "");
                            BilledPatientItemKeys.Add($"PID_{pId.Trim().ToUpperInvariant()}_{cleanDrugNorm}");
                        }
                    }
                }
            }
        }
    }

    private async Task HydratePatientSavedSalesAsync(long custId, string? patientId, string? patientName)
    {
        try
        {
            var matchedMasters = SalesList.Where(m =>
                (custId > 0 && m.customercode == custId) ||
                (!string.IsNullOrWhiteSpace(patientId) && string.Equals(m.patientid?.Trim(), patientId.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(patientName) && string.Equals(m.patientname?.Trim(), patientName.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(patientName) && string.Equals(m.customername?.Trim(), patientName.Trim(), StringComparison.OrdinalIgnoreCase))
            ).ToList();

            foreach (var master in matchedMasters)
            {
                var existingReq = AllSavedSalesRequests.FirstOrDefault(r => r.master != null && r.master.salescode > 0 && r.master.salescode == master.salescode);
                if (existingReq != null && existingReq.details != null && existingReq.details.Any())
                {
                    continue;
                }

                var client = CreateClient();
                var resp = await client.GetAsync($"api/ItemMaster/getsalesbycode?salescode={master.salescode}&tenantcode={DefaultTenant}");
                if (resp.IsSuccessStatusCode)
                {
                    var str = await resp.Content.ReadAsStringAsync();
                    var loaded = ParseRequestResponse(str, master.salescode, master.billno);
                    if (loaded != null && loaded.details != null && loaded.details.Any())
                    {
                        if (existingReq != null)
                        {
                            existingReq.details = loaded.details;
                        }
                        else
                        {
                            AllSavedSalesRequests.Add(loaded);
                        }
                    }
                }
            }
            SyncBilledCacheFromSavedSales();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SalesMaster] HydratePatientSavedSalesAsync notice: {ex.Message}");
        }
    }

    private bool IsItemBilledForPatient(long custId, string? patientId, string? patientName, long itemCode, string? drugName, Guid? queueId, Guid? prDetId, DateTime? date)
    {
        if (queueId.HasValue && queueId.Value != Guid.Empty && BilledQueueIds.Contains(queueId.Value)) return true;
        if (prDetId.HasValue && prDetId.Value != Guid.Empty && BilledPrDetIds.Contains(prDetId.Value)) return true;

        var cleanDrugNorm = !string.IsNullOrWhiteSpace(drugName) ? System.Text.RegularExpressions.Regex.Replace(drugName.Trim().ToUpperInvariant(), @"[^A-Z0-9]", "") : "";

        if (!string.IsNullOrWhiteSpace(cleanDrugNorm))
        {
            if (custId > 0)
            {
                if (BilledPatientItemKeys.Contains(GetPatientItemKey(custId, drugName, date))) return true;
                if (BilledPatientItemKeys.Contains(GetPatientItemKey(custId, drugName, null))) return true;
            }
            if (!string.IsNullOrWhiteSpace(patientName))
            {
                if (BilledPatientItemKeys.Contains(GetPatientItemKeyByName(patientName, drugName, date))) return true;
                if (BilledPatientItemKeys.Contains(GetPatientItemKeyByName(patientName, drugName, null))) return true;
            }
            if (!string.IsNullOrWhiteSpace(patientId))
            {
                if (BilledPatientItemKeys.Contains($"PID_{patientId.Trim().ToUpperInvariant()}_{cleanDrugNorm}")) return true;
            }
        }

        if (AllSavedSalesRequests != null && AllSavedSalesRequests.Any())
        {
            var patSales = AllSavedSalesRequests.Where(s =>
                s.master != null &&
                (
                    (custId > 0 && s.master.customercode == custId) ||
                    (!string.IsNullOrWhiteSpace(patientId) && string.Equals(s.master.patientid?.Trim(), patientId.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(patientName) && string.Equals(s.master.patientname?.Trim(), patientName.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(patientName) && string.Equals(s.master.customername?.Trim(), patientName.Trim(), StringComparison.OrdinalIgnoreCase))
                )
            ).ToList();

            foreach (var sale in patSales)
            {
                if (sale.details == null || !sale.details.Any()) continue;
                foreach (var d in sale.details)
                {
                    if (queueId.HasValue && queueId.Value != Guid.Empty && d.queue_id == queueId.Value) return true;
                    if (prDetId.HasValue && prDetId.Value != Guid.Empty && d.pr_det_id == prDetId.Value) return true;
                    if (itemCode > 0 && d.itemcode == itemCode) return true;

                    if (!string.IsNullOrWhiteSpace(cleanDrugNorm))
                    {
                        var saleDetName = !string.IsNullOrWhiteSpace(d.itemname) ? d.itemname : (d.itemcode > 0 ? ItemList.FirstOrDefault(i => i.itemcode == d.itemcode)?.itemname : "");
                        if (!string.IsNullOrWhiteSpace(saleDetName))
                        {
                            var saleDrugNorm = System.Text.RegularExpressions.Regex.Replace(saleDetName.Trim().ToUpperInvariant(), @"[^A-Z0-9]", "");
                            if (saleDrugNorm == cleanDrugNorm)
                            {
                                return true;
                            }
                        }
                    }
                }
            }
        }

        return false;
    }

    private bool IsQueueRowBilledOrDispensed(PharmacyPrescriptionQueueRow r, long custId)
    {
        if (r == null) return true;
        if (r.billed_status == true) return true;
        if (r.salescode.HasValue && r.salescode.Value > 0) return true;
        if (!string.IsNullOrWhiteSpace(r.billno)) return true;
        if (!string.IsNullOrWhiteSpace(r.status))
        {
            var s = r.status.Trim().ToUpperInvariant();
            if (s == "DISPENSED" || s == "BILLED" || s == "CANCELLED" || s == "PAID" || s == "COMPLETED" || s == "CLOSED" || s == "SERVED" || s == "DELIVERED")
            {
                return true;
            }
        }
        if (r.queue_id != Guid.Empty && BilledQueueIds.Contains(r.queue_id)) return true;
        if (r.pr_det_id.HasValue && r.pr_det_id.Value != Guid.Empty && BilledPrDetIds.Contains(r.pr_det_id.Value)) return true;

        string drugName = !string.IsNullOrWhiteSpace(r.matched_itemname) ? r.matched_itemname : (r.drug_name ?? "");
        long itemCode = r.matched_itemcode ?? 0;

        if (IsItemBilledForPatient(custId, CurrentRequest?.master?.patientid ?? PatientIdSearchText, CurrentRequest?.master?.patientname ?? PatientNameSearchText, itemCode, drugName, r.queue_id, r.pr_det_id, r.created_at))
        {
            return true;
        }

        return false;
    }

    private bool IsCaseSheetItemBilled(OpPrescriptionDetailModel item, long custId, DateTime? visitDate)
    {
        if (item == null) return true;
        if (item.is_billed == true) return true;
        if (item.isdeleted == true) return true;
        if (item.pr_det_id != Guid.Empty && BilledPrDetIds.Contains(item.pr_det_id)) return true;

        long itemCode = item.drug_code.HasValue ? (long)item.drug_code.Value : 0;
        if (IsItemBilledForPatient(custId, CurrentRequest?.master?.patientid ?? PatientIdSearchText, CurrentRequest?.master?.patientname ?? PatientNameSearchText, itemCode, item.drug_name, null, item.pr_det_id, visitDate ?? item.created_at))
        {
            return true;
        }

        return false;
    }

