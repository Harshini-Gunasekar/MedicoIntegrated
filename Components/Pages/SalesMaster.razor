                            </div>
                        </div>

                        <div class="form-section-header" style="margin-top: 0.5rem !important; padding-top: 0.2rem; margin-bottom: 4px; padding-bottom: 2px; border-bottom: 1px solid #f1f5f9;">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Billing Details</div>
                        </div>

                        <!-- Table showing item entry and details -->
                        <div class="purchase-items-table-wrapper table-responsive">
                            <table class="table align-middle mb-0" style="font-size: 0.85rem;">
                                <thead class="purchase-items-table-header">
                                    <tr>
                                        <th style="width: 30px; text-align: center;">S.NO</th>
                                        <th style="width: 140px;">ITEM</th>
                                        <th style="width: 85px; text-align: center;">BATCH NO</th>
                                        <th style="width: 95px; text-align: center;">EXPIRY DATE</th>
                                        <th style="text-align: center; width: 45px;">DAYS</th>
                                        <th style="text-align: center; width: 45px;">QTY</th>
                                        <th style="text-align: center; width: 55px;">RATE</th>
                                        <th style="text-align: center; width: 48px;">DISC %</th>
                                        <th style="text-align: center; width: 38px;">TAX %</th>
                                        <th style="text-align: center; width: 55px;">TAX AMT</th>
                                        <th style="text-align: center; width: 65px;">TOTAL</th>
                                        <th style="text-align: center; width: 45px;">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in CurrentRequest.details.Select((detail, index) => new { detail, index }))
                                    {
                                        var detail = row.detail;
                                        var index = row.index;
                                        var rowId = $"row-{index}";
                                        <tr>
                                            <td style="padding: 4px 8px; color: #64748b; text-align: center; font-weight: 600; width: 30px;">@(index + 1)</td>
                                            <td style="padding: 4px 8px; min-width: 140px; width: 140px; position: relative;">
                                                <input id="item-input-@index"
                                                       type="text"
                                                       class="purchase-item-select"
                                                       style="width: 100%;"
                                                       placeholder="Type to search item..."
                                                       autocomplete="off"
                                                       value="@(ItemSearchTexts.GetValueOrDefault(detail, ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname ?? (detail.itemcode > 0 ? $"Unknown Item (Code: {detail.itemcode})" : "")))"
                                                       @oninput="@(e => OnItemTypeaheadInput(e, detail))"
                                                       @onfocus="@(() => ActiveItemSearchRow = index)"
                                                       @onblur="OnSearchBlur"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 0))" />

                                                @if (ActiveItemSearchRow == index)
                                                {
                                                    var searchText = ItemSearchTexts.GetValueOrDefault(detail, "");
                                                    if (SelectedWarehouseCode == null || SelectedWarehouseCode <= 0)
                                                    {
                                                        <div class="custom-typeahead-dropdown" style="padding: 8px; text-align: center; color: #f59e0b; font-size: 0.75rem;">
                                                            Please select store first
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        var availableItems = GetAvailableItemsForRow(detail).ToList();
                                                        var filteredItems = availableItems
                                                            .Where(i => string.IsNullOrEmpty(searchText) || (i.itemname != null && i.itemname.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                                                            .ToList();

                                                        if (filteredItems.Any())
                                                        {
                                                            <div class="custom-typeahead-dropdown">
                                                                @foreach (var item in filteredItems)
                                                                {
                                                                    <div class="custom-typeahead-item" 
                                                                         @onmousedown="@(() => SelectItemFromDropdown(detail, item))">
                                                                        @item.itemname
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="custom-typeahead-dropdown" style="padding: 8px; text-align: center; color: #dc2626; font-size: 0.75rem;">
                                                                Stock is unavailable in selected store
                                                            </div>
                                                        }
                                                    }
                                                }
                                            </td>
                                            <td style="padding: 4px 8px; text-align: center; width: 85px; position: relative;">
                                                <input id="batch-@index" type="text" class="purchase-item-input text-center" 
                                                       value="@detail.batchno"
                                                       autocomplete="off"
                                                       @oninput="@(e => OnBatchInput(e, detail))"
                                                       @onfocus="@(() => { ActiveBatchSearchRow = index; })"
                                                       @onblur="@(() => OnBatchBlur(detail))"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 1))" />
                                                
                                                @if (ActiveBatchSearchRow == index)
                                                {
                                                    var availableStocks = GetAvailableStocks(detail);
                                                    if (availableStocks.Any())
                                                    {
                                                        <div class="custom-typeahead-dropdown" style="width: 230px; max-height: 180px; text-align: left; left: 0;">
                                                            @foreach (var stock in availableStocks)
                                                            {
                                                                bool isExpired = stock.expirydate.HasValue && stock.expirydate.Value.Date < DateTime.Today;
                                                                <div class="custom-typeahead-item @(isExpired ? "bg-light text-muted" : "")" 
                                                                     @onmousedown="@(() => SelectBatchFromDropdown(detail, stock))"
                                                                     style="@(isExpired ? "opacity: 0.85;" : "")">
                                                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                                                        <strong>@stock.batchno</strong>
                                                                        <div>
                                                                            @if (isExpired)
                                                                            {
                                                                                <span class="badge bg-danger" style="font-size: 0.62rem; padding: 2px 4px; margin-right: 4px;">Expired</span>
                                                                            }
                                                                            <span style="font-size:0.7rem; color:#02659e; font-weight: bold;">Qty: @stock.closingstock</span>
                                                                        </div>
                                                                    </div>
                                                                    <div style="font-size:0.7rem; color: @(isExpired ? "#dc2626" : "#64748b"); font-weight: @(isExpired ? "600" : "normal");">
                                                                        Exp: @(stock.expirydate.HasValue ? stock.expirydate.Value.ToString("MM/yy", System.Globalization.CultureInfo.InvariantCulture) : "N/A")
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else if (detail.itemcode <= 0)
                                                    {
                                                        <div class="custom-typeahead-dropdown" style="width: 220px; padding: 8px; text-align: center; color: #f59e0b; font-size: 0.75rem;">
                                                            Please select valid item
                                                        </div>
                                                    }
                                                    else if (SelectedWarehouseCode <= 0)
                                                    {
                                                        <div class="custom-typeahead-dropdown" style="width: 220px; padding: 8px; text-align: center; color: #f59e0b; font-size: 0.75rem;">
                                                            Please select store
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="custom-typeahead-dropdown" style="width: 200px; padding: 8px; text-align: center; color: #dc2626; font-size: 0.75rem;">
                                                            No stock available
                                                        </div>
                                                    }
                                                }
                                            </td>
                                            <td style="padding: 4px 8px; text-align: center; width: 95px;">
                                                <input id="expiry-@index" type="text" class="purchase-item-input text-center"
                                                       placeholder="MM/YY"
                                                       maxlength="5"
                                                       inputmode="numeric"
                                                       value="@GetExpiryDateDisplay(detail)"
                                                       @oninput="@(e => OnExpiryDateInput(detail, e.Value?.ToString()))"
                                                       @onchange="@(e => OnExpiryDateChange(detail, e.Value?.ToString()))"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 2))"
                                                       style="@(IsDetailExpired(detail) ? "border-color: #ef4444 !important; color: #dc2626 !important; background: #fef2f2 !important; font-weight: 700;" : "")" />
