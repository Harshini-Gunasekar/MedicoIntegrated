                                                    {
                                                        <div class="custom-typeahead-dropdown" style="padding: 8px; text-align: center; color: #f59e0b; font-size: 0.75rem;">
                                                            Please select store first
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        var availableItems = GetAvailableItemsForRow(detail).ToList();
                                                        var filteredItems = availableItems
                                                            .Where(i => string.IsNullOrEmpty(searchText) || (i.itemname != null && i.itemname.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                                                            .ToList();

                                                        if (filteredItems.Any())
                                                        {
                                                            <div class="custom-typeahead-dropdown">
                                                                @foreach (var item in filteredItems)
                                                                {
                                                                    var itemTypeName = GetItemTypeName(item);
                                                                    <div class="custom-typeahead-item" 
                                                                         @onmousedown="@(() => SelectItemFromDropdown(detail, item))"
                                                                         style="display: flex; justify-content: space-between; align-items: center;">
                                                                        <span>@item.itemname</span>
                                                                        @if (!string.IsNullOrWhiteSpace(itemTypeName) && itemTypeName != "PRESCRIPTION")
