@code {
    private List<sales_master> SalesList = new();
    private List<customer_master> CustomerList = new();
    private List<inventory_item_master> ItemList = new();
    private List<stock_master> StockList = new();
    private List<warehouse_master> WarehouseList = new();
    private List<PatientPartitionModel> PatientPartitionList = new();
    private sales_request CurrentRequest = new() { master = new(), details = new() };
    private sales_detail NewDetailItem = new();

    private string _selectedSalesType = "Counter Sales";
    private string SelectedSalesType
    {
        get => _selectedSalesType;
        set
        {
            if (_selectedSalesType != value)
            {
                _selectedSalesType = value;
                PatientIdSearchText = CurrentRequest.master.patientid ?? "";
                PatientNameSearchText = CurrentRequest.master.patientname ?? "";
            }
        }
    }
    private string PatientAddress { get; set; } = "";
    private string ConsultantName { get; set; } = "";
    private string StoreName { get; set; } = "";
    private string PatientName { get; set; } = "";

    private string _patientIdSearchText = "";
    private string PatientIdSearchText
    {
        get => _patientIdSearchText;
        set
        {
            if (_patientIdSearchText != value)
            {
                _patientIdSearchText = value;
                CurrentRequest.master.patientid = value;
            }
        }
    }

    private string _patientNameSearchText = "";
    private string PatientNameSearchText
    {
        get => _patientNameSearchText;
        set
        {
            if (_patientNameSearchText != value)
            {
                _patientNameSearchText = value;
                CurrentRequest.master.patientname = value;
            }
        }
    }
    private string ActivePatientSearchField { get; set; } = "";

    private long? _selectedWarehouseCode;
    private long? SelectedWarehouseCode
    {
        get => _selectedWarehouseCode;
        set
        {
            if (_selectedWarehouseCode != value)
            {
                _selectedWarehouseCode = value;
                CurrentRequest.master.warehousefield = WarehouseList.FirstOrDefault(w => w.warehousecode == value)?.warehousename;
                if (CurrentRequest.details != null)
                {
                    foreach (var d in CurrentRequest.details)
                    {
                        d.warehousecode = value;
                        if (d.itemcode > 0)
                        {
                            UpdateItemBatchAndExpiryForStore(d, value ?? 0);
                        }
                    }
                }
                StateHasChanged();
            }
        }
    }

    private async Task OnPartitionPatientChanged(ChangeEventArgs e)
    {
        var custIdStr = e.Value?.ToString() ?? "";
        var patient = PatientPartitionList.FirstOrDefault(p => p.custid?.ToString() == custIdStr);
        if (patient != null)
        {
            CurrentRequest.master.patientid = patient.custid?.ToString();
            CurrentRequest.master.patientname = patient.name;
            CurrentRequest.master.address = patient.city;
            CurrentRequest.master.consultant = patient.dcode?.ToString();
            if (long.TryParse(patient.custid?.ToString(), out var longId)) {
                CurrentRequest.master.customercode = longId;
                await LoadPrescriptions(longId);
            }
        }
        else
        {
            CurrentRequest.master.patientid = null;
            CurrentRequest.master.patientname = null;
            CurrentRequest.master.address = null;
            CurrentRequest.master.consultant = null;
            CurrentRequest.master.customercode = null;
        }
    }



    private async Task OnPatientSearchBlur()
    {
        await Task.Delay(200);
        ActivePatientSearchField = "";
        StateHasChanged();
    }

    private async Task SelectPatient(PatientPartitionModel patient)
    {
        CurrentRequest.master.patientid = patient.custid?.ToString();
        CurrentRequest.master.patientname = patient.name;
        CurrentRequest.master.address = patient.city;
        CurrentRequest.master.consultant = patient.dcode?.ToString();
        if (long.TryParse(patient.custid?.ToString(), out var longId)) {
            CurrentRequest.master.customercode = longId;
            await LoadPrescriptions(longId);
        }
        PatientIdSearchText = CurrentRequest.master.patientid ?? "";
        PatientNameSearchText = CurrentRequest.master.patientname ?? "";
        ActivePatientSearchField = "";
        StateHasChanged();
    }

    private async Task HandlePatientIdKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var firstMatch = PatientPartitionList
                .FirstOrDefault(p => p.custid != null && p.custid.Value.ToString().Contains(PatientIdSearchText, StringComparison.OrdinalIgnoreCase));
            if (firstMatch != null)
            {
                await SelectPatient(firstMatch);
            }
        }
    }

    private async Task HandlePatientNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var firstMatch = PatientPartitionList
                .FirstOrDefault(p => p.name != null && p.name.Contains(PatientNameSearchText, StringComparison.OrdinalIgnoreCase));
            if (firstMatch != null)
            {
                await SelectPatient(firstMatch);
            }
        }
    }

    private async Task LoadPrescriptionsManually()
    {
        long? targetId = null;
        if (CurrentRequest.master.customercode.HasValue) {
            targetId = CurrentRequest.master.customercode.Value;
        } else if (long.TryParse(PatientIdSearchText, out var parsedId)) {
            targetId = parsedId;
            var match = PatientPartitionList.FirstOrDefault(p => p.custid == parsedId);
            if (match != null) {
                await SelectPatient(match);
                return; // SelectPatient already calls LoadPrescriptions
            }
        }
        
        if (targetId.HasValue) {
            await LoadPrescriptions(targetId.Value);
        } else {
            ToastService.ShowWarning("Please enter or select a valid Patient ID first.");
        }
    }

    private async Task LoadPrescriptions(long custId)
    {
        try
        {
            List<PharmacyPrescriptionQueueRow>? rows = null;

            // 1. Try fetching from pharmacy queue with standard tenant headers
            try
            {
                var client = CreateClient();
                var responseString = await client.GetStringAsync($"api/ItemMaster/pharmacy-queue/by-custid?custid={custId}");
                if (!string.IsNullOrWhiteSpace(responseString))
                {
                    rows = ParsePharmacyQueueJson(responseString);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Pharmacy queue default tenant request exception: " + ex.Message);
            }

            // 2. If no valid queue rows found, retry pharmacy queue with tenantcode header "0010"
            if (rows == null || !rows.Any(r => r.status != "DISPENSED" && r.status != "CANCELLED"))
            {
                try
                {
                    var client = CreateClient();
                    client.DefaultRequestHeaders.Remove("tenantcode");
                    client.DefaultRequestHeaders.Add("tenantcode", "0010");
                    var responseString = await client.GetStringAsync($"api/ItemMaster/pharmacy-queue/by-custid?custid={custId}");
                    if (!string.IsNullOrWhiteSpace(responseString))
                    {
                        var parsed = ParsePharmacyQueueJson(responseString);
                        if (parsed != null && parsed.Any())
                        {
                            rows = parsed;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Pharmacy queue 0010 tenant request exception: " + ex.Message);
                }
            }

            var validRows = rows?.Where(r => r.status != "DISPENSED" && r.status != "CANCELLED").ToList();

            if (validRows != null && validRows.Any())
            {
                PopulateGridWithQueueRows(validRows);
                return;
            }

            // 3. Fallback: Query Case Sheet history for patient to retrieve saved prescribed medicines
            if (CaseSheetService != null)
            {
                var history = await CaseSheetService.GetPatientHistoryAsync((decimal)custId, 1, 20);
                if (history != null && history.Any())
                {
                    // Locate the latest visit with prescription items
                    var latestWithPrescription = history
                        .Where(h => h.prescription != null && h.prescription.items != null && h.prescription.items.Any(i => !string.IsNullOrWhiteSpace(i.drug_name)))
                        .OrderByDescending(h => h.visit_date ?? DateTime.MinValue)
                        .FirstOrDefault();

                    if (latestWithPrescription != null && latestWithPrescription.prescription?.items != null)
                    {
                        PopulateGridWithCaseSheetItems(latestWithPrescription.prescription.items);
                        return;
                    }
                }
            }

            ToastService.ShowWarning($"No pending prescriptions found for Patient ID: CUST-{custId}.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading prescriptions: {ex.Message}");
            Console.WriteLine($"Error loading prescriptions: {ex.Message}");
            StateHasChanged();
        }
    }

    private List<PharmacyPrescriptionQueueRow>? ParsePharmacyQueueJson(string responseString)
    {
        var options = new JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try
        {
            using var doc = JsonDocument.Parse(responseString);
            var root = doc.RootElement;
            JsonElement dataElement = root;

            if (root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var dataProp))
            {
                dataElement = dataProp;
            }

            if (dataElement.ValueKind == JsonValueKind.Array)
            {
                if (dataElement.GetArrayLength() > 0)
                {
                    var first = dataElement[0];
                    if (first.ValueKind == JsonValueKind.Object && first.TryGetProperty("items", out _))
                    {
                        var groups = JsonSerializer.Deserialize<List<PharmacyQueueGroup>>(dataElement.GetRawText(), options);
                        return groups?.SelectMany(g => g.items ?? new List<PharmacyPrescriptionQueueRow>()).ToList();
                    }
                    else
                    {
                        return JsonSerializer.Deserialize<List<PharmacyPrescriptionQueueRow>>(dataElement.GetRawText(), options);
                    }
                }
                return new List<PharmacyPrescriptionQueueRow>();
            }
            else if (dataElement.ValueKind == JsonValueKind.Object)
            {
                if (dataElement.TryGetProperty("items", out _))
                {
                    var group = JsonSerializer.Deserialize<PharmacyQueueGroup>(dataElement.GetRawText(), options);
                    return group?.items;
                }
                else
                {
                    var singleRow = JsonSerializer.Deserialize<PharmacyPrescriptionQueueRow>(dataElement.GetRawText(), options);
                    return singleRow != null ? new List<PharmacyPrescriptionQueueRow> { singleRow } : null;
                }
            }
