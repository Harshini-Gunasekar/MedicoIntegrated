    private async Task SwitchTab(int tabId)
    {
        if (tabId == ActiveTabId) return;

        SaveActiveFormToCurrentTab();
        await SaveDraftTabsToSessionAsync();

        var targetTab = BillingTabs.FirstOrDefault(t => t.TabId == tabId);
        if (targetTab != null)
        {
            LoadTabIntoForm(targetTab);
            StateHasChanged();
        }
    }

    private async Task AddNewTab()
    {
        if (BillingTabs.Count >= MaxBillingTabs)
        {
            ToastService.ShowWarning("Maximum of 3 billing tabs allowed simultaneously.");
            return;
        }

        SaveActiveFormToCurrentTab();

        var usedIds = BillingTabs.Select(t => t.TabId).ToHashSet();
        int nextId = 1;
        for (int i = 1; i <= MaxBillingTabs; i++)
        {
            if (!usedIds.Contains(i))
            {
                nextId = i;
                break;
            }
        }

        var newTab = CreateNewBillingTab(nextId);
        BillingTabs.Add(newTab);
        LoadTabIntoForm(newTab);

        await SaveDraftTabsToSessionAsync();
        StateHasChanged();
    }

    private async Task CloseTab(int tabId)
    {
        SaveActiveFormToCurrentTab();

        var tabToRemove = BillingTabs.FirstOrDefault(t => t.TabId == tabId);
        if (tabToRemove != null)
        {
            BillingTabs.Remove(tabToRemove);
        }

        if (!BillingTabs.Any())
        {
            ShowModal = false;
            await _sessionStorage.DeleteAsync(SessionDraftTabsKey);
        }
        else
        {
            if (ActiveTabId == tabId)
            {
                var nextActive = BillingTabs.Last();
                LoadTabIntoForm(nextActive);
            }
            await SaveDraftTabsToSessionAsync();
        }

        StateHasChanged();
    }

