        CurrentRequest.master.customercode = (long)op.custid;
        CurrentRequest.master.mobileno = op.mobile;
        
        var doc = DoctorList.FirstOrDefault(d => d.dcode == op.dcode);
        if (doc != null)
        {
            CurrentRequest.master.consultant = !string.IsNullOrWhiteSpace(doc.doctorfullname) ? doc.doctorfullname : doc.name;
        }
        else if (op.dcode > 0)
        {
            CurrentRequest.master.consultant = op.dcode.ToString();
        }

        var cust = PatientPartitionList.FirstOrDefault(p => p.custid == (long)op.custid);
        if (cust != null)
        {
            if (!string.IsNullOrWhiteSpace(cust.city))
            {
                CurrentRequest.master.address = cust.city;
            }
            if (string.IsNullOrWhiteSpace(CurrentRequest.master.mobileno) && !string.IsNullOrWhiteSpace(cust.mobile))
            {
                CurrentRequest.master.mobileno = cust.mobile;
            }
        }

        PatientIdSearchText = CurrentRequest.master.patientid ?? "";
        PatientNameSearchText = CurrentRequest.master.patientname ?? "";
        PatientMobileSearchText = CurrentRequest.master.mobileno ?? "";
        ActivePatientSearchField = "";

        if (op.custid > 0)
        {
            await LoadPrescriptions((long)op.custid);
        }
        StateHasChanged();
    }

