    private void OnDetailDaysInput(sales_detail detail, string? val)
    {
        if (int.TryParse(val, out var days) && days > 0)
        {
            if (_originalPrescriptionMap.TryGetValue(detail, out var orig) && orig.originalDays > 0)
            {
                var dailyQty = orig.originalQty / (decimal)orig.originalDays;
                detail.quantity = Math.Round(dailyQty * (decimal)days, 2);
            }
            else if (detail.days.HasValue && detail.days.Value > 0 && detail.quantity > 0)
            {
                var dailyQty = detail.quantity / (decimal)detail.days.Value;
                _originalPrescriptionMap[detail] = (detail.quantity, detail.days.Value);
                detail.quantity = Math.Round(dailyQty * (decimal)days, 2);
            }
            else if (detail.quantity > 0)
            {
                _originalPrescriptionMap[detail] = (detail.quantity, days);
            }
            else
            {
                // When days is entered and quantity is 0, default quantity = days * 1
                detail.quantity = (decimal)days * 1m;
                _originalPrescriptionMap[detail] = (detail.quantity, days);
            }
            detail.days = days;
            CalculateRow(detail);
        }
        else
        {
            detail.days = null;
        }
    }

