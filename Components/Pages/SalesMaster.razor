    private string? LoadErrorMessage = null;

    private async Task LoadSales()
    {
        IsLoading = true;
        LoadErrorMessage = null;
        StateHasChanged();

        try {
            var client = CreateClient();
            HttpResponseMessage response;
            try {
                response = await client.GetAsync("api/ItemMaster/getsales");
            } catch (HttpRequestException httpEx) {
                Console.WriteLine($"[SalesMaster] HTTP request exception: {httpEx.Message}");
                LoadErrorMessage = $"Connection Error: Unable to connect to API ({httpEx.Message})";
                ToastService.ShowError(LoadErrorMessage);
                SalesList = new();
                return;
            }

            if (response.IsSuccessStatusCode) {
                var responseContent = await response.Content.ReadAsStringAsync();
                if (!string.IsNullOrWhiteSpace(responseContent)) {
                    var masterList = ParseSalesListResponse(responseContent, out var parseErr);
                    SalesList = masterList ?? new();
                    if (!string.IsNullOrEmpty(parseErr)) {
                        LoadErrorMessage = parseErr;
                        Console.WriteLine($"[SalesMaster] Notice: {parseErr}");
                    }
                } else {
                    SalesList = new();
                }
            } else {
                var statusCode = (int)response.StatusCode;
                var errBody = await response.Content.ReadAsStringAsync();
                var parsedErr = ExtractErrorMessage(statusCode, response.StatusCode.ToString(), errBody);
                LoadErrorMessage = $"API Error (HTTP {statusCode}): {parsedErr}";
                Console.WriteLine($"[SalesMaster] LoadSales failed: {LoadErrorMessage}");
                ToastService.ShowError(LoadErrorMessage);
                SalesList = new();
            }
        } catch (Exception ex) {
            LoadErrorMessage = $"Unexpected Error: {ex.Message}";
            Console.WriteLine($"[SalesMaster] LoadSales exception: {ex}");
            ToastService.ShowError(LoadErrorMessage);
            SalesList = new();
        } finally {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCustomers()
    {
        try {
            var effectiveTenant = !string.IsNullOrWhiteSpace(DefaultTenant) ? DefaultTenant : (TenantState?.TenantCode ?? "");
            var effectiveToken = !string.IsNullOrEmpty(AuthToken) ? AuthToken : TenantState?.AuthToken;

            // 1. Try LabCareUrl api/customer/getcus
            try {
                var labClient = ClientFactory.CreateClient("LabCareUrl");
                if (!string.IsNullOrEmpty(effectiveTenant))
                {
                    labClient.DefaultRequestHeaders.Remove("tenant_code");
                    labClient.DefaultRequestHeaders.Remove("tenantcode");
                    labClient.DefaultRequestHeaders.Add("tenant_code", effectiveTenant);
                    labClient.DefaultRequestHeaders.Add("tenantcode", effectiveTenant);
                }
                if (!string.IsNullOrEmpty(effectiveToken))
                {
                    labClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
                }
                var response = await labClient.GetAsync("api/customer/getcus");
                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync();
                    if (!string.IsNullOrWhiteSpace(json))
                    {
                        var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<SharedComponents.Rcl.Models.CustomerModel>>(json);
                        if (list != null && list.Any())
                        {
                            CustomerList = list.Select(c => new customer_master {
                                customercode = (long)c.custid,
                                customername = c.name,
                                mobile = c.mobile,
                                address = !string.IsNullOrWhiteSpace(c.street) ? c.street : c.city,
                                city = c.city,
                                gender = c.gender,
                                ageyears = c.ageyears > 0 ? (int?)c.ageyears : null,
                                agemonths = c.agemonths > 0 ? (int?)c.agemonths : null,
                                agedays = c.agedays > 0 ? (int?)c.agedays : null
                            }).ToList();
                        }
                    }
                }
            } catch (Exception ex) {
                Console.WriteLine($"Error loading customers from LabCareUrl: {ex.Message}");
            }

            // 2. If CustomerList is still empty, try DoctorApi client
            if (CustomerList == null || !CustomerList.Any())
            {
                try {
                    var client = CreateClient();
                    var response = await client.GetAsync("api/customer/getcus");
                    if (response.IsSuccessStatusCode)
                    {
                        var json = await response.Content.ReadAsStringAsync();
                        if (!string.IsNullOrWhiteSpace(json))
                        {
                            var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<SharedComponents.Rcl.Models.CustomerModel>>(json);
                            if (list != null && list.Any())
                            {
                                CustomerList = list.Select(c => new customer_master {
                                    customercode = (long)c.custid,
                                    customername = c.name,
                                    mobile = c.mobile,
                                    address = !string.IsNullOrWhiteSpace(c.street) ? c.street : c.city,
                                    city = c.city,
                                    gender = c.gender,
                                    ageyears = c.ageyears > 0 ? (int?)c.ageyears : null,
                                    agemonths = c.agemonths > 0 ? (int?)c.agemonths : null,
                                    agedays = c.agedays > 0 ? (int?)c.agedays : null
                                }).ToList();
                            }
                        }
                    }
                } catch (Exception ex) {
                    Console.WriteLine($"Error loading customers from DoctorApi: {ex.Message}");
                }
            }
        } catch (Exception ex) {
            Console.WriteLine($"Error in LoadCustomers: {ex.Message}");
        }
        CustomerList ??= new();
    }

