    private IEnumerable<sales_master> PagedSales => 
        FilteredSales.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    private int TotalPages => (int)Math.Ceiling((double)FilteredSales.Count() / ItemsPerPage);

    private IEnumerable<int> GetVisiblePageNumbers()
    {
        int total = TotalPages;
        int current = CurrentPage;

        if (total <= 3)
        {
            return Enumerable.Range(1, Math.Max(1, total));
        }

        int start = current - 1;
        if (current <= 1)
        {
            start = 1;
        }
        else if (current >= total)
        {
            start = total - 2;
        }

        start = Math.Max(1, Math.Min(start, total - 2));
        return Enumerable.Range(start, 3);
    }

    private bool hasViewRight = true;
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
            if (string.IsNullOrWhiteSpace(DefaultTenant) && !string.IsNullOrWhiteSpace(TenantState?.TenantCode))
            {
                DefaultTenant = TenantState.TenantCode;
            }
            
            try
            {
                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                if (!tokenResult.Success || string.IsNullOrEmpty(tokenResult.Value))
                {
                    tokenResult = await _sessionStorage.GetAsync<string>("auth_token");
                }
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : (TenantState?.AuthToken ?? "");
            }
            catch {}
            
            try
            {
                bool isAdmin = false;
                try
                {
                    var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userResult.Success && userResult.Value != null)
                    {
                        isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                  userResult.Value.UserCode == 0 ||
                                  userResult.Value.UserCode == 1;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking user details: {ex.Message}");
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                    hasEditRight = true;
                    hasDeleteRight = true;
                }
                else
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var pageRight = rightsResult.Value.FirstOrDefault(r => 
                            r.ModuleName != null && 
                            r.ModuleName.Trim().Equals("Pharmacy_Billing", StringComparison.OrdinalIgnoreCase));
                        
                        if (pageRight != null)
                        {
                            hasViewRight = pageRight.ToView;
                            hasCreateRight = pageRight.ToAdd;
                            hasEditRight = pageRight.ToEdit;
                            hasDeleteRight = pageRight.ToDelete;
                        }
                        else
                        {
                            hasViewRight = true;
                            hasCreateRight = true;
                            hasEditRight = true;
                            hasDeleteRight = true;
                        }
                    }
                    else
                    {
                        hasViewRight = true;
                        hasCreateRight = true;
                        hasEditRight = true;
                        hasDeleteRight = true;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking Pharmacy_Billing rights: {ex.Message}");
                hasViewRight = false;
                hasCreateRight = false;
                hasEditRight = false;
                hasDeleteRight = false;
            }

            if (!hasViewRight)
            {
                ToastService.ShowError("You do not have permission to access Pharmacy Billing.");
                Nav.NavigateTo("/home");
                return;
            }

            await Task.WhenAll(LoadSales(), LoadCustomers(), LoadItems(), LoadStocks(), LoadWarehouses(), LoadPatientPartition(), LoadOpRegistrations(), LoadIpRegistrations(), LoadDoctors());
            StateHasChanged();
        }
    }

    private List<stock_master> ParseStockListResponse(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        var options = new JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };
        
        try {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            
            JsonElement arrayElement = default;
            bool found = false;
            if (root.ValueKind == JsonValueKind.Array) {
                arrayElement = root;
                found = true;
            } else if (root.ValueKind == JsonValueKind.Object) {
                if (root.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == JsonValueKind.Array) {
                    arrayElement = dataProp;
                    found = true;
                } else {
                    foreach (var prop in root.EnumerateObject()) {
                        if (prop.Value.ValueKind == JsonValueKind.Array) {
                            arrayElement = prop.Value;
                            found = true;
                            break;
                        }
                    }
                }
            }

            if (found && arrayElement.ValueKind == JsonValueKind.Array) {
                var list = JsonSerializer.Deserialize<List<stock_master>>(arrayElement.GetRawText(), options);
                return list ?? new();
            }
        } catch (Exception ex) {
            Console.WriteLine("ParseStockListResponse Error: " + ex.Message);
        }

        try {
            var direct = JsonSerializer.Deserialize<List<stock_master>>(json, options);
            if (direct != null) return direct;
        } catch {}

        return new();
    }

