                                                       value="@detail.days"
                                                       @oninput="@(e => OnDetailDaysInput(detail, e.Value?.ToString()))"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 3))" placeholder="0" />
                                            </td>
                                            <td style="padding: 4px 8px; text-align: center; width: 45px;">
                                                <input id="qty-@index" type="number" step="any" class="purchase-item-input text-center" @bind:get="GetQty(detail)" @bind:set="(val) => SetQty(detail, val)" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 4))" placeholder="0" />
                                            </td>
                                            <td style="padding: 4px 8px; text-align: center; width: 55px;">
                                                <input id="rate-@index" type="number" step="any" class="purchase-item-input text-end" @bind:get="GetRate(detail)" @bind:set="(val) => SetRate(detail, val)" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 5))" placeholder="0" />
                                            </td>
                                            <td style="padding: 4px 8px; text-align: center; width: 48px;">
                                                <input id="disc-@index" type="number" step="any" class="purchase-item-input text-center" @bind:get="GetDisc(detail)" @bind:set="(val) => SetDisc(detail, val)" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 6))" placeholder="0" />
                                            </td>
                                            <td style="padding: 4px 8px; text-align: center; width: 38px;">
                                                <input id="tax-@index" type="number" step="any" class="purchase-item-input text-center" @bind:get="GetTax(detail)" @bind:set="(val) => SetTax(detail, val)" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 7))" placeholder="0" />
                                            </td>
                                            <td style="padding: 4px 8px; text-align: center; width: 55px;">
                                                <span class="purchase-item-readonly text-end">₹@detail.taxamount.ToString("N2")</span>
                                            </td>
                                            <td style="padding: 4px 8px; text-align: center; width: 65px;">
                                                <span class="purchase-item-readonly text-end fw-bold" style="color: #02659e;">₹@detail.totalamount.ToString("N2")</span>
                                            </td>
                                            <td style="padding: 4px 8px; text-align: center; width: 45px;">
                                                <button type="button" class="btn btn-outline-danger btn-sm" style="border-radius: 6px; padding: 4px 8px; border: none; background: rgba(239, 68, 68, 0.08); color: #dc2626;" @onclick="() => RemoveDetailRow(detail)" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div style="padding: 4px 0; display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 8px;">
                            <!-- Left Corner: Total Items count -->
                            <span style="color: #475569; font-weight: 600; font-size: 0.82rem; white-space: nowrap; flex: 1; text-align: left;">
                                Total Items: <span style="color: #02659e; font-weight: 700;">@(CurrentRequest.details?.Count(d => d.itemcode > 0) ?? 0)</span>
                            </span>
                            
                            <!-- Center: Dotted Add Item Button -->
                            <div style="flex: 1; text-align: center;">
                                <button type="button" class="btn-dotted-add" @onclick="AddDetailRow" style="padding: 4px 20px; font-size: 0.82rem; border-radius: 16px;">
                                    <i class="bi bi-plus-circle-fill" style="font-size: 0.9rem;"></i> Add Item
                                </button>
                            </div>
                            
                            <!-- Right Corner: Conversion button + Computed Total -->
                            <div style="display: flex; align-items: center; justify-content: flex-end; gap: 10px; font-size: 0.83rem; flex: 1; text-align: right; white-space: nowrap;">
                                <button type="button" class="btn-conversion" @onclick="OpenConversionModal" title="Convert Prescribed Days">
                                    <i class="bi bi-arrow-repeat"></i>
                                    <span>Conversion</span>
                                </button>
                                <span style="color: #64748b; font-weight: 600;">Computed Items Total:</span>
                                <span style="font-weight: 800; font-size: 1.05rem; color: #02659e;">&#8377; @(CurrentRequest.master.netamount.ToString("N2"))</span>
                            </div>
                        </div>

                        <!-- Summary and Payment Card (Enhanced Spacious 1-Line Layout) -->
                        <div style="display: flex; width: 100%; margin-top: 8px;">
                            <div class="bill-card-premium" style="width: 100%; height: auto !important; padding: 12px 16px !important; background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%); border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);">
                                <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; align-items: end; width: 100%;">
                                    <!-- 1. Payment Mode -->
                                    <div class="field-group" style="text-align: left; width: 100%;">
                                        <label class="field-label" style="font-size: 0.68rem !important; font-weight: 700 !important; color: #64748b !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; display: block; margin-bottom: 4px; white-space: nowrap;">Payment Mode</label>
                                        <div style="position: relative; width: 100%;">
                                            <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.paymentmode" style="appearance: none !important; -webkit-appearance: none !important; -moz-appearance: none !important; padding-right: 24px; width: 100%; height: 34px !important; line-height: 34px !important; font-size: 0.82rem !important; padding: 0 10px !important; background: #ffffff !important; border: 1px solid #cbd5e1 !important; border-radius: 8px; font-weight: 600; color: #1e293b;">
                                                <option value="Cash">Cash</option>
                                                <option value="Card">Card</option>
                                                <option value="UPI">UPI</option>
                                                <option value="Credit">Credit</option>
                                            </InputSelect>
                                            <i class="bi bi-chevron-down" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b; font-size: 0.75rem;"></i>
                                        </div>
                                    </div>

                                    <!-- 2. Payment Status -->
                                    <div class="field-group" style="text-align: left; width: 100%;">
                                        <label class="field-label" style="font-size: 0.68rem !important; font-weight: 700 !important; color: #64748b !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; display: block; margin-bottom: 4px; white-space: nowrap;">Payment Status</label>
                                        <div style="position: relative; width: 100%;">
                                            <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.paymentstatus" style="appearance: none !important; -webkit-appearance: none !important; -moz-appearance: none !important; padding-right: 24px; width: 100%; height: 34px !important; line-height: 34px !important; font-size: 0.82rem !important; padding: 0 10px !important; background: #ffffff !important; border: 1px solid #cbd5e1 !important; border-radius: 8px; font-weight: 600; color: #1e293b;">
                                                <option value="Pending">Pending</option>
                                                <option value="Paid">Paid</option>
                                            </InputSelect>
                                            <i class="bi bi-chevron-down" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b; font-size: 0.75rem;"></i>
                                        </div>
                                    </div>

                                    <!-- 3. Tax Amt -->
                                    <div class="field-group" style="text-align: left; width: 100%;">
                                        <label class="field-label" style="font-size: 0.68rem !important; font-weight: 700 !important; color: #64748b !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; display: block; margin-bottom: 4px; white-space: nowrap;">Tax Amt</label>
                                        <input type="text" class="form-control premium-input text-start" value="₹@CurrentRequest.master.taxamount.ToString("N2")" readonly style="background: #f8fafc !important; border: 1px solid #cbd5e1 !important; height: 34px !important; font-size: 0.82rem !important; padding: 0 10px !important; font-weight: 600; color: #475569; width: 100%; border-radius: 8px;" />
                                    </div>

                                    <!-- 4. Dis Amt (Editable) -->
                                    <div class="field-group" style="text-align: left; width: 100%;">
                                        <label class="field-label" style="font-size: 0.68rem !important; font-weight: 700 !important; color: #64748b !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; display: block; margin-bottom: 4px; white-space: nowrap;">Dis Amt</label>
                                        <div style="position: relative; width: 100%;">
                                            <input type="number" step="any" min="0" class="form-control premium-input text-start"
                                                   @bind:get="GetMasterDiscount()"
                                                   @bind:set="SetMasterDiscount"
                                                   @bind:event="oninput"
                                                   placeholder="0.00"
                                                   style="background: #ffffff !important; border: 1px solid #cbd5e1 !important; height: 34px !important; font-size: 0.82rem !important; padding: 0 10px !important; font-weight: 600; color: #02659e; width: 100%; border-radius: 8px; appearance: textfield;" />
                                        </div>
                                    </div>

                                    <!-- 5. Round Off ( [-] [Input] [+] ) -->
                                    <div class="field-group" style="text-align: left; width: 100%;">
                                        <label class="field-label" style="font-size: 0.68rem !important; font-weight: 700 !important; color: #64748b !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; display: block; margin-bottom: 4px; white-space: nowrap;">Round Off</label>
                                        <div style="display: flex; align-items: center; gap: 4px; width: 100%;">
                                            <button class="btn btn-sm" type="button" @onclick="RoundOffDown" title="Round Down (-)"
                                                    style="display: flex; align-items: center; justify-content: center; width: 28px; height: 34px; border-radius: 6px; border: 1px solid #fecaca; background: #fef2f2; color: #dc2626; font-weight: 800; font-size: 1.1rem; padding: 0; cursor: pointer; flex-shrink: 0; transition: all 0.15s ease;">-</button>
                                            <input type="number" step="any" class="form-control text-center px-1"
                                                   @bind:get="GetRoundOff()"
                                                   @bind:set="SetRoundOff"
                                                   @bind:event="oninput"
                                                   placeholder="0.00"
                                                   style="width: 100%; flex: 1; height: 34px !important; font-size: 0.82rem !important; font-weight: 700; color: #02659e; border: 1px solid #cbd5e1 !important; border-radius: 6px; background: #ffffff !important; appearance: textfield;" />
                                            <button class="btn btn-sm" type="button" @onclick="RoundOffUp" title="Round Up (+)"
                                                    style="display: flex; align-items: center; justify-content: center; width: 28px; height: 34px; border-radius: 6px; border: 1px solid #bbf7d0; background: #f0fdf4; color: #16a34a; font-weight: 800; font-size: 1rem; padding: 0; cursor: pointer; flex-shrink: 0; transition: all 0.15s ease;">+</button>
                                        </div>
                                    </div>

                                    <!-- 6. Sales Amount -->
                                    <div class="field-group" style="text-align: left; width: 100%;">
                                        <label class="field-label" style="font-size: 0.68rem !important; font-weight: 700 !important; color: #e11d48 !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; display: block; margin-bottom: 4px; white-space: nowrap;">Sales Amount</label>
                                        <input type="text" class="form-control premium-input text-end" value="₹@CurrentRequest.master.netamount.ToString("N2")" readonly style="background: #fff1f2 !important; border: 1.5px solid #fda4af !important; font-weight: 800; color: #dc2626 !important; font-size: 0.95rem !important; height: 34px !important; padding: 0 10px !important; width: 100%; border-radius: 8px; box-shadow: 0 1px 3px rgba(225, 29, 72, 0.08);" />
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer-actions" style="display: flex; flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: center; padding: 14px 0px 6px 0px !important; gap: 12px;">
                        <!-- Left side: Remarks -->
                        <div class="remarks-section flex-grow-1" style="max-width: 500px; text-align: left; display: flex; align-items: center; gap: 10px;">
                            <label class="field-label" style="margin-bottom: 0; white-space: nowrap; color: #64748b; font-weight: 700; font-size: 0.75rem; text-transform: uppercase;">Remarks</label>
                            <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.remarks" placeholder="Enter remarks..." style="height: 36px; flex: 1;" />
                        </div>

                        <!-- Action Buttons on the right -->
                        <div style="display: flex; flex-direction: row; align-items: center; gap: 12px;">
                            <button type="button" class="btn-cancel-modal" @onclick="CloseModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.5rem 1.5rem; border-radius: 12px; font-weight: 700; min-width: 100px; transition: all 0.2s;">Cancel</button>
                            <button type="button" @onclick="SaveSales" class="btn-save-premium" disabled="@IsSaving" style="min-width: 150px; height: 48px; margin: 0; position: relative; top: 0;">
                                @if (IsSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                                }
                                <span>@(IsEdit ? "Update Bill" : "Save Bill")</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- MEDICINE DAYS CONVERSION MODAL POPUP -->
@if (showConversionModal)
{
    <div class="conversion-modal-overlay" @onclick:stopPropagation>
        <div class="conversion-modal-card">
            <!-- Modal Header -->
            <div class="conversion-modal-header">
                <div class="conversion-modal-title">
                    <i class="bi bi-arrow-repeat"></i>
                    <span>CONVERSION...</span>
                </div>
                <button type="button" class="conversion-modal-close" @onclick="CloseConversionModal" title="Close">&times;</button>
            </div>

            <!-- Modal Body -->
            <div class="conversion-modal-body">
                <div class="conversion-panel-box">
                    <!-- Row 1: Prescription Feed For -->
                    <div class="conversion-field-row">
                        <div class="conversion-label-col">
                            <span>Prescription Feed For</span>
                            <span class="colon">:</span>
                        </div>
                        <div class="conversion-value-col">
                            <input type="number" step="any" min="1" class="form-control conversion-input-feed"
                                   @bind="conversionPrescribedDays" @bind:event="oninput"
                                   @onkeydown="HandleConversionKeyDown" />
                        </div>
                    </div>

                    <!-- Row 2: Convert into Days (Focused / Active Highlighted) -->
                    <div class="conversion-field-row active-field-row">
                        <div class="conversion-label-col">
                            <span>Convert into Days</span>
                            <span class="colon">:</span>
                        </div>
                        <div class="conversion-value-col">
                            <input id="conversionTargetDaysInput" type="number" step="any" min="1" class="form-control conversion-input-target"
                                   @bind="conversionTargetDays" @bind:event="oninput"
                                   @onkeydown="HandleConversionKeyDown" />
                        </div>
                    </div>

                    <!-- Row 3: Required Bill Amount (Doctor Prescribed Days) -->
                    <div class="conversion-field-row">
                        <div class="conversion-label-col">
                            <span>Required Bill Amount</span>
                            <span class="colon">:</span>
                        </div>
                        <div class="conversion-value-col">
                            <div class="conversion-amount-box orig-amount">
                                <span class="amount-val">@GetOriginalPrescriptionBillAmount().ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Row 4: Convert in (Live Converted Bill Amount) -->
                    <div class="conversion-field-row converted-field-row">
                        <div class="conversion-label-col">
                            <span>Convert in</span>
                            <span class="colon">:</span>
                        </div>
                        <div class="conversion-value-col">
                            <div class="conversion-amount-box converted-amount">
                                <span class="amount-val">@GetPreviewConvertedBillAmount().ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(conversionError))
                {
                    <div class="conversion-error-alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @conversionError
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="conversion-modal-footer">
                <button type="button" class="btn btn-conversion-cancel" @onclick="CloseConversionModal">
                    Cancel
                </button>
                <button type="button" class="btn btn-conversion-submit" @onclick="ExecuteConversion">
                    <i class="bi bi-check2"></i> Convert
                </button>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeleteConfirm = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Sales</div>
            <div class="action-popup-body">Are you sure you want to delete this sales bill? This action cannot be undone.</div>
            <div class="action-popup-actions">
