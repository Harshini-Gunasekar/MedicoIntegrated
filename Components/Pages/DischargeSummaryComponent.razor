@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public Guid IpId { get; set; }
    [Parameter] public string IpNo { get; set; } = string.Empty;
    [Parameter] public string PatCode { get; set; } = string.Empty;
    [Parameter] public decimal CustId { get; set; } = 0;
    [Parameter] public int Dcode { get; set; } = 0;
    [Parameter] public string PatientName { get; set; } = string.Empty;
    [Parameter] public string DoctorName { get; set; } = string.Empty;
    [Parameter] public string BedNo { get; set; } = string.Empty;
    [Parameter] public DateTime? AdmitDate { get; set; }
    [Parameter] public DateTime? DischargeDate { get; set; }

    public class DischargeMedicineRow
    {
        public int sno { get; set; }
        public string medicine_name { get; set; } = string.Empty;
        public string dosage { get; set; } = "";
        public string frequency { get; set; } = "";
        public string days { get; set; } = "";
        public string timing { get; set; } = "";
    }

    public class BothCategoryPayload
    {
        public string note { get; set; } = string.Empty;
        public List<DischargeMedicineRow> medicines { get; set; } = new();
    }

    private bool isLoading = false;
    private bool isSaving = false;
    private bool isSaved = false;
    private bool isPrinting = false;
    private string savedMessage = "";
    private Guid _lastLoadedIpId = Guid.Empty;

    private string DisplayIpNo => !string.IsNullOrWhiteSpace(IpNo) ? IpNo : PatCode;
    private string DisplayPatCode => !string.IsNullOrWhiteSpace(PatCode) ? PatCode : (CustId > 0 ? CustId.ToString() : "-");
    private string DisplayPatientName => !string.IsNullOrWhiteSpace(PatientName) ? PatientName : (patSummaryRes?.PatientName ?? "");
    private string DisplayDoctorName => !string.IsNullOrWhiteSpace(DoctorName) ? DoctorName : (patSummaryRes?.DoctorName ?? "");
    private string DisplayAge => !string.IsNullOrWhiteSpace(patSummaryRes?.Age) && patSummaryRes.Age != "0 Y / 0 M / 0 D" ? patSummaryRes.Age : "";
    private string DisplayGender => !string.IsNullOrWhiteSpace(patSummaryRes?.Gender) ? patSummaryRes.Gender : "";
    private string DisplayAgeGender {
        get {
            var age = DisplayAge;
            var gender = DisplayGender;
            if (!string.IsNullOrWhiteSpace(age) && !string.IsNullOrWhiteSpace(gender)) return $"{age} / {gender}";
            if (!string.IsNullOrWhiteSpace(age)) return age;
            if (!string.IsNullOrWhiteSpace(gender)) return gender;
            return "-";
        }
    }

    private DateTime? dischargeDateInput;
    private string dischargeTypeInput = "NORMAL";

    private Guid? currentPdsId;
    private DischargeSummaryService.PatientDischargeSummaryResponse? patSummaryRes;

    private List<string> availableTemplateNames = new();
    private string selectedTemplateName = "";

    private List<DischargeSummaryService.DsCategoryDto> allCategories = new();
    private List<DischargeSummaryService.DsCategoryDto> categoryList = new();
    private DischargeSummaryService.DsCategoryDto? activeCategory;
    private Guid activeCategoryId = Guid.Empty;

    private Dictionary<Guid, string> categoryContents = new();
    private Dictionary<Guid, string> categoryTextNotes = new();
    private Dictionary<Guid, List<DischargeMedicineRow>> categoryMedicines = new();

    private string ActiveCategoryTextNote
    {
        get => activeCategory != null ? GetCategoryTextNote(activeCategory.category_id) : "";
        set
        {
            if (activeCategory != null)
            {
                categoryTextNotes[activeCategory.category_id] = value ?? "";
                RebuildCategoryContent(activeCategory.category_id);
            }
        }
    }

    private bool showAddCategoryModal = false;
    private string newCategoryName = "";
    private string newCategoryType = "TEXT";
    private string newTemplateDefaultAnswer = "";

    // Medicine Row Input State
    private string newMedName = "";
    private string newMedDosage = "";
    private string newMedFreq = "";
    private string newMedDays = "";
    private string newMedTiming = "";

    private bool showMedSuggestions = false;
    private List<string> filteredMedSuggestions = new();
    private List<string> masterSuggestionsList = new();
    private bool hasExportRight = false;
    private bool hasViewRight = true;
    private bool hasEditRight = true;

    private async Task PopulateMasterSuggestions()
    {
        try
        {
            var list = new List<string>();

            // 1. Preset clinical items & tests
            var presets = new List<string>
            {
                "Paracetamol 500mg", "Amoxicillin 250mg", "Pantocid 40mg", "Cetirizine 10mg",
                "Azithromycin 500mg", "Metformin 500mg", "Atorvastatin 10mg", "Amlodipine 5mg",
                "Telmisartan 40mg", "Ibuprofen 400mg", "Dolo 650mg", "Ranitidine 150mg",
                "Ciprofloxacin 500mg", "Omeprazole 20mg", "Multivitamin Tablet", "Cefixime 200mg",
                "Ceftriaxone 1g Injection", "NS 0.9% 500ml", "RL 500ml", "DNS 500ml",
                "Complete Blood Count (CBC)", "Serum Creatinine", "Blood Urea Nitrogen (BUN)",
                "Serum Electrolytes (Na, K, Cl)", "Liver Function Test (LFT)", "Lipid Profile",
                "Urine Routine & Microscopy", "Chest X-Ray PA View", "ECG 12-Lead",
                "Ultrasonography (USG) Abdomen & Pelvis", "CT Brain Plain", "HbA1c",
                "Thyroid Profile (T3, T4, TSH)", "Sputum Culture & Sensitivity", "Arterial Blood Gas (ABG)"
            };
            foreach (var p in presets)
            {
                if (!list.Contains(p, StringComparer.OrdinalIgnoreCase)) list.Add(p);
            }

            // 2. Fetch inventory items & medicines from ItemMaster
            try
            {
                var items = await CaseSheetService.GetAllItemsAsync();
                if (items != null)
                {
                    foreach (var i in items)
                    {
                        var name = !string.IsNullOrWhiteSpace(i.itemname) ? i.itemname.Trim() : (i.drugname ?? "");
                        if (!string.IsNullOrWhiteSpace(name) && !list.Contains(name, StringComparer.OrdinalIgnoreCase))
                        {
                            list.Add(name);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Item search load error: {ex.Message}");
            }

            // 3. Fetch lab & radiology tests from TestMaster
            try
            {
                var tests = await TestService.GetAllTestsAsync();
                if (tests != null)
                {
                    foreach (var t in tests)
                    {
                        if (!string.IsNullOrWhiteSpace(t.name) && !list.Contains(t.name.Trim(), StringComparer.OrdinalIgnoreCase))
                        {
                            list.Add(t.name.Trim());
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Test search load error: {ex.Message}");
            }

            masterSuggestionsList = list;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"PopulateMasterSuggestions error: {ex.Message}");
        }
    }

    private bool _lastVisible = false;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && (!_lastVisible || (IpId != Guid.Empty && IpId != _lastLoadedIpId)))
        {
            _lastVisible = true;
            _lastLoadedIpId = IpId;
            await LoadDischargeSummaryData();
        }
        else if (!Visible)
        {
            _lastVisible = false;
            _lastLoadedIpId = Guid.Empty;
        }
    }

    private async Task LoadDischargeSummaryData()
    {
        isLoading = true;
        isSaved = false;
        savedMessage = "";
        try
        {
            try
            {
                bool isAdmin = false;
                try
                {
                    var userResult = await sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userResult.Success && userResult.Value != null)
                    {
                        isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                  userResult.Value.UserCode == 0 ||
                                  userResult.Value.UserCode == 1;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking user details: {ex.Message}");
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasEditRight = true;
                    hasExportRight = true;
                }
                else
                {
                    var rightsResult = await sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var dischargeRight = rightsResult.Value.FirstOrDefault(r => 
                            r.ModuleName != null && 
                            (r.ModuleName.Trim().Equals("Discharge_Summery", StringComparison.OrdinalIgnoreCase) ||
                             r.ModuleName.Trim().Equals("Discharge_Summary", StringComparison.OrdinalIgnoreCase)));
                        
                        if (dischargeRight != null)
                        {
                            hasViewRight = dischargeRight.ToView;
                            hasEditRight = dischargeRight.ToEdit;
                        }
                        else
                        {
                            hasViewRight = false;
                            hasEditRight = false;
                        }

                        var printRight = rightsResult.Value.FirstOrDefault(r => 
                            r.ModuleName != null && 
                            (r.ModuleName.Trim().Equals("Print_DischargeSummery", StringComparison.OrdinalIgnoreCase) ||
                             r.ModuleName.Trim().Equals("Print_DischargeSummary", StringComparison.OrdinalIgnoreCase)));
                        
                        hasExportRight = printRight != null && printRight.ToExport;
                    }
                    else
                    {
                        hasViewRight = false;
                        hasEditRight = false;
                        hasExportRight = false;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error retrieving user rights: {ex.Message}");
                hasViewRight = false;
                hasEditRight = false;
                hasExportRight = false;
            }

            if (!hasViewRight)
            {
                ToastService.ShowError("You do not have permission to view discharge summaries.");
                await CloseModal();
                return;
            }

            await PopulateMasterSuggestions();
            await CleanDefaultDummyCategories();
            allCategories = await DsService.GetCategoriesAsync();

            var allPresets = await DsService.GetTemplatesAsync(null);
            availableTemplateNames = allPresets.Where(p => !string.IsNullOrWhiteSpace(p.template_name))
                                               .Select(p => p.template_name.Trim())
                                               .Distinct()
                                               .ToList();

            // Search by IpNo first, then PatCode, then CustId string
            var searchCode = !string.IsNullOrWhiteSpace(IpNo) ? IpNo
                           : (!string.IsNullOrWhiteSpace(PatCode) ? PatCode
                           : (CustId > 0 ? CustId.ToString() : ""));
            patSummaryRes = await DsService.GetPatientDischargeSummaryAsync(searchCode);

            categoryContents.Clear();
            categoryTextNotes.Clear();
            categoryMedicines.Clear();

            if (patSummaryRes != null && patSummaryRes.Master != null)
            {
                currentPdsId = patSummaryRes.Master.pds_id;
                dischargeDateInput = patSummaryRes.Master.discharge_date ?? DischargeDate ?? DateTime.Now;
                dischargeTypeInput = patSummaryRes.Master.discharge_type ?? "NORMAL";

                if (patSummaryRes.Details != null)
                {
                    foreach (var d in patSummaryRes.Details)
                    {
                        if (string.IsNullOrWhiteSpace(d.category_name)) continue;

                        // Canonical category resolution with fuzzy fallback
                        var targetCat = allCategories.FirstOrDefault(c => c.category_id == d.category_id)
                                     ?? allCategories.FirstOrDefault(c => c.category_name.Trim().Equals(d.category_name.Trim(), StringComparison.OrdinalIgnoreCase))
                                     ?? allCategories.FirstOrDefault(c => c.category_name.Trim().Contains(d.category_name.Trim(), StringComparison.OrdinalIgnoreCase) || d.category_name.Trim().Contains(c.category_name.Trim(), StringComparison.OrdinalIgnoreCase));

                        if (targetCat == null)
                        {
                            targetCat = new DischargeSummaryService.DsCategoryDto
                            {
                                category_id = d.category_id != Guid.Empty ? d.category_id : Guid.NewGuid(),
                                category_name = d.category_name.Trim(),
                                category_type = "TEXT",
                                sort_order = allCategories.Count + 1
                            };
                            allCategories.Add(targetCat);
                        }

                        ParseAndPopulateCategoryDetail(targetCat.category_id, d.category_content ?? "", targetCat.category_type);
                    }
                }
            }
            else
            {
                currentPdsId = null;
                dischargeDateInput = DischargeDate ?? DateTime.Now;
                dischargeTypeInput = "NORMAL";
            }

            if (availableTemplateNames.Any())
            {
                selectedTemplateName = availableTemplateNames.First();
                await ApplyTemplateFilter(selectedTemplateName);
            }
            else
            {
                categoryList = allCategories.ToList();
                if (categoryList.Any()) await SelectCategory(categoryList.First());
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading discharge summary: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ParseAndPopulateCategoryDetail(Guid catId, string rawContent, string catType)
    {
        categoryContents[catId] = rawContent;
        if (string.IsNullOrWhiteSpace(rawContent)) return;

        string trimmed = rawContent.Trim();

        // 1. Try Deserialize as BOTH payload
        if (trimmed.StartsWith("{") && trimmed.EndsWith("}"))
        {
            try
            {
                var both = Newtonsoft.Json.JsonConvert.DeserializeObject<BothCategoryPayload>(trimmed);
                if (both != null)
                {
                    if (!string.IsNullOrWhiteSpace(both.note))
                    {
                        categoryTextNotes[catId] = both.note;
                    }
                    if (both.medicines != null && both.medicines.Any())
                    {
                        categoryMedicines[catId] = both.medicines;
                    }
                    return;
                }
            }
            catch { }
        }

        // 2. Try Deserialize as List<DischargeMedicineRow>
        if (trimmed.StartsWith("[") && trimmed.EndsWith("]"))
        {
            try
            {
                var meds = Newtonsoft.Json.JsonConvert.DeserializeObject<List<DischargeMedicineRow>>(trimmed);
                if (meds != null && meds.Any())
                {
                    categoryMedicines[catId] = meds;
                    return;
                }
            }
            catch { }
        }

        // 3. Fallback as plain text note
        categoryTextNotes[catId] = rawContent;
    }

