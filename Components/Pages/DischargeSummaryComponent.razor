    private async Task SavePatientDischargeSummary()
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to save discharge summaries.");
            return;
        }

        try
        {
            isSaving = true;

            var details = new List<DischargeSummaryService.PdsCategoryContentDto>();
            
            // Rebuild content for all categories first
            foreach (var cat in allCategories)
            {
                RebuildCategoryContent(cat.category_id);
            }

            // Collect all categories with non-empty content
            int sortOrder = 1;
            foreach (var cat in allCategories)
            {
                if (categoryContents.TryGetValue(cat.category_id, out var content) && !string.IsNullOrWhiteSpace(content))
                {
                    details.Add(new DischargeSummaryService.PdsCategoryContentDto
                    {
                        category_id = cat.category_id,
                        category_name = cat.category_name,
                        category_content = content,
                        sort_order = sortOrder++
                    });
                }
            }

            var request = new DischargeSummaryService.SavePatientDischargeSummaryDto
            {
                pds_id = currentPdsId,
                patcode = !string.IsNullOrWhiteSpace(IpNo) ? IpNo : (!string.IsNullOrWhiteSpace(PatCode) ? PatCode : (CustId > 0 ? CustId.ToString() : "")),
                custid = (long)CustId,
                dcode = Dcode,
                patient_name = DisplayPatientName,
                doctor_name = DisplayDoctorName,
                discharge_date = dischargeDateInput ?? DateTime.Now,
                discharge_type = dischargeTypeInput,
                auth_user1 = DisplayPatientName,
                auth_user2 = "Signed & Received",
                auth_user3 = DisplayDoctorName,
                details = details
            };

            currentPdsId = await DsService.SavePatientDischargeSummaryAsync(request);
            isSaved = true;
            savedMessage = $"Saved successfully at {DateTime.Now:hh:mm:ss tt}";
            ToastService.ShowSuccess("Patient Discharge Summary saved successfully!");

            // Reload from DB to ensure state is 100% in sync
            await LoadDischargeSummaryData();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving summary: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task PrintDischargeSummaryPdf()
    {
        if (!hasExportRight)
        {
            ToastService.ShowError("You do not have permission to print discharge summaries.");
            return;
        }

        try
        {
            isPrinting = true;
            StateHasChanged();

            // Auto-save first so the PDF reflects latest data
            await SavePatientDischargeSummary();

            if (currentPdsId == null || currentPdsId == Guid.Empty)
            {
                ToastService.ShowError("Please save the summary first before printing.");
                return;
            }

            var base64 = await DsService.GetDischargeSummaryPdfBase64Async(currentPdsId.Value);
            if (!string.IsNullOrWhiteSpace(base64))
            {
                await JSRuntime.InvokeVoidAsync("openBase64Pdf", base64);
            }
            else
            {
                ToastService.ShowError("Could not generate PDF. Please ensure the data is saved and try again.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Print error: {ex.Message}");
        }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

