        }
    }

    private async Task ApplyTemplateFilter(string tName)
    {
        var allPresets = await DsService.GetTemplatesAsync(null);
        var tPresets = allPresets.Where(p => p.template_name != null && p.template_name.Trim().Equals(tName, StringComparison.OrdinalIgnoreCase)).ToList();

        var matchedCatIds = new HashSet<Guid>();

        foreach (var p in tPresets)
        {
            if (string.IsNullOrWhiteSpace(p.category_name)) continue;

            // Resolve canonical category from allCategories
            var targetCat = allCategories.FirstOrDefault(c => c.category_id == p.category_id)
                         ?? allCategories.FirstOrDefault(c => c.category_name.Trim().Equals(p.category_name.Trim(), StringComparison.OrdinalIgnoreCase))
                         ?? allCategories.FirstOrDefault(c => c.category_name.Trim().Contains(p.category_name.Trim(), StringComparison.OrdinalIgnoreCase) || p.category_name.Trim().Contains(c.category_name.Trim(), StringComparison.OrdinalIgnoreCase));

            if (targetCat == null)
            {
                targetCat = new DischargeSummaryService.DsCategoryDto
                {
                    category_id = p.category_id != Guid.Empty ? p.category_id : Guid.NewGuid(),
                    category_name = p.category_name.Trim(),
                    category_type = "TEXT",
                    sort_order = allCategories.Count + 1
                };
                allCategories.Add(targetCat);
            }

            matchedCatIds.Add(targetCat.category_id);

            // Auto-populate default answer preset ONLY if no saved content exists for that category
            if (!string.IsNullOrWhiteSpace(p.template_text))
            {
                bool alreadyHasSavedContent = IsCategoryFilled(targetCat.category_id);
                if (!alreadyHasSavedContent)
                {
                    categoryTextNotes[targetCat.category_id] = p.template_text;
                    RebuildCategoryContent(targetCat.category_id);
                }
            }
        }

        // Filter categoryList to include template categories OR any category that ALREADY has saved content for this patient
        categoryList = allCategories.Where(c => 
            matchedCatIds.Contains(c.category_id) || 
            IsCategoryFilled(c.category_id)
        ).ToList();

        if (!categoryList.Any())
        {
            categoryList = allCategories.ToList();
        }

        if (categoryList.Any())
        {
            if (activeCategory == null || !categoryList.Any(c => c.category_id == activeCategoryId))
            {
                await SelectCategory(categoryList.First());
            }
        }
    }

    private bool IsCategoryFilled(Guid catId)
    {
        if (categoryMedicines.TryGetValue(catId, out var meds) && meds != null && meds.Any())
            return true;
        if (categoryTextNotes.TryGetValue(catId, out var text) && !string.IsNullOrWhiteSpace(text))
            return true;
        if (categoryContents.TryGetValue(catId, out var content) && !string.IsNullOrWhiteSpace(content))
            return true;
        return false;
    }

    private async Task SelectCategory(DischargeSummaryService.DsCategoryDto cat)
    {
        activeCategory = cat;
        activeCategoryId = cat.category_id;
        showMedSuggestions = false;
        await Task.CompletedTask;
    }

    private string GetCategoryEffectiveType(DischargeSummaryService.DsCategoryDto cat)
    {
        if (categoryMedicines.TryGetValue(cat.category_id, out var meds) && meds != null && meds.Any())
        {
            if (categoryTextNotes.TryGetValue(cat.category_id, out var text) && !string.IsNullOrWhiteSpace(text))
                return "BOTH";
            return "MEDICINE";
        }

        if (!string.IsNullOrWhiteSpace(cat.category_type))
        {
            return cat.category_type;
        }

        return "TEXT";
    }

    private string GetActiveCategoryType()
    {
        if (activeCategory != null)
        {
            return GetCategoryEffectiveType(activeCategory);
        }
        return "TEXT";
    }

    private string GetCategoryTextNote(Guid catId)
    {
        if (categoryTextNotes.TryGetValue(catId, out var content))
        {
            return content;
        }
        return "";
    }

    private List<DischargeMedicineRow> GetCategoryMedicines(Guid catId)
    {
        if (!categoryMedicines.ContainsKey(catId))
        {
            categoryMedicines[catId] = new List<DischargeMedicineRow>();
        }
        return categoryMedicines[catId];
    }

    private void OnMedSearchKeyUp(KeyboardEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(newMedName))
        {
            showMedSuggestions = false;
            return;
        }
        var query = newMedName.Trim();
        var sourceList = masterSuggestionsList != null && masterSuggestionsList.Any() ? masterSuggestionsList : new List<string>();
        filteredMedSuggestions = sourceList.Where(m => m.Contains(query, StringComparison.OrdinalIgnoreCase)).Take(15).ToList();
        showMedSuggestions = filteredMedSuggestions.Any();
    }

    private void SelectMedSuggestion(string med)
    {
        newMedName = med;
        showMedSuggestions = false;
    }

    private void AddMedicineRow()
    {
        if (activeCategory == null) return;
        if (string.IsNullOrWhiteSpace(newMedName))
        {
            ToastService.ShowWarning("Please enter an item or medicine name.");
            return;
        }

        var list = GetCategoryMedicines(activeCategory.category_id);
        list.Add(new DischargeMedicineRow
        {
            sno = list.Count + 1,
            medicine_name = newMedName.Trim(),
            dosage = newMedDosage.Trim(),
            frequency = newMedFreq.Trim(),
            days = newMedDays.Trim(),
            timing = newMedTiming.Trim()
        });

        newMedName = "";
        newMedDosage = "";
        newMedFreq = "";
        newMedDays = "";
        newMedTiming = "";
        showMedSuggestions = false;
        RebuildCategoryContent(activeCategory.category_id);
    }

    private void RemoveMedicineRow(DischargeMedicineRow row)
    {
        if (activeCategory == null) return;
        var list = GetCategoryMedicines(activeCategory.category_id);
        list.Remove(row);
        for (int i = 0; i < list.Count; i++) list[i].sno = i + 1;
        RebuildCategoryContent(activeCategory.category_id);
    }

    private void RebuildCategoryContent(Guid catId)
    {
        var cat = allCategories.FirstOrDefault(c => c.category_id == catId);
        var type = cat?.category_type ?? "TEXT";

        var text = categoryTextNotes.TryGetValue(catId, out var val) ? val : "";
        var meds = GetCategoryMedicines(catId);

        bool hasMeds = meds != null && meds.Any();
        bool hasText = !string.IsNullOrWhiteSpace(text);

        if (type == "BOTH" || (hasMeds && hasText))
        {
            var obj = new BothCategoryPayload { note = text, medicines = meds ?? new List<DischargeMedicineRow>() };
            categoryContents[catId] = Newtonsoft.Json.JsonConvert.SerializeObject(obj);
        }
        else if (type == "MEDICINE" || hasMeds)
        {
            categoryContents[catId] = Newtonsoft.Json.JsonConvert.SerializeObject(meds);
        }
        else
        {
            categoryContents[catId] = text;
        }
    }

    private async Task SaveCurrentAsDefaultAnswer()
    {
        if (activeCategory == null) return;
        if (string.IsNullOrWhiteSpace(selectedTemplateName))
        {
            ToastService.ShowWarning("Please select a template name first.");
            return;
        }

        try
        {
            var note = GetCategoryTextNote(activeCategory.category_id);
            await DsService.SaveTemplateAsync(new DischargeSummaryService.DsTemplateDto
            {
                category_id = activeCategory.category_id,
                category_name = activeCategory.category_name,
                template_name = selectedTemplateName,
                template_text = note
            });

            ToastService.ShowSuccess($"Saved default answer for '{activeCategory.category_name}' in template '{selectedTemplateName}'!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving default answer: {ex.Message}");
        }
    }

