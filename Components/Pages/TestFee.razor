@page "/test-fee-master"
@rendermode InteractiveServer
@using Medico_Backend.Model
@using Booking.Services
@inject TestFeeService TestFeeService
@inject FeetypeService FeetypeService
@inject ToastService ToastService

<div class="cm-page">
    <!-- Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <h1 class="cm-title">Test Fee Master</h1>
            <span class="cm-subtitle">Pricing & Commission Config</span>
        </div>
        <div class="cm-header-right">
            <div class="cm-search-box">
                <i class="bi bi-search cm-search-icon"></i>
                <input type="text" class="cm-search-input" placeholder="Quick find..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            <button class="cm-btn-new" @onclick="OpenNewTestFeeModal">
                + New Test Fee Entry
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="cm-table-card">
        <table class="cm-table">
            <thead>
                <tr>
                    <th>TEST CODE</th>
                    <th>FEE TYPE</th>
                    <th>BASE AMOUNT</th>
                    <th>MARGIN TYPE</th>
                    <th>MARGIN AMT</th>
                    <th>FEE AMOUNT</th>
                    <th>CHARITY AMT</th>
                    <th>ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredTestFees.Any())
                {
                    @foreach (var item in FilteredTestFees)
                    {
                        <tr>
                            <td class="col-orderno">@item.tcode</td>
                            <td class="col-shortname">@GetFeeTypeName(item.ftcode)</td>
                            <td class="col-name">
                                <span class="counter-name-text">@item.amount.ToString("C2")</span>
                            </td>
                            <td class="col-shortname">@item.margintype</td>
                            <td class="col-commission">@(item.marginamount?.ToString("C2") ?? "$0.00")</td>
                            <td class="col-narration">@(item.feeamount?.ToString("C2") ?? "$0.00")</td>
                            <td class="col-commission">@(item.charityamount?.ToString("C2") ?? "$0.00")</td>
                            <td class="col-action">
                                <button class="cm-action-btn edit" title="Edit" @onclick="() => EditTestFee(item)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="cm-action-btn delete" title="Delete" @onclick="() => DeleteTestFee(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="cm-empty-row">
                            <i class="bi bi-display"></i>
                            <div>No test fees found</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showModal)
{
    <div class="cm-backdrop">
        <div class="cm-modal">
            <div class="cm-modal-header">
                <h2 class="cm-modal-title">@(isEditMode ? "Edit Test Fee Entry" : "New Test Fee Entry")</h2>
                <button class="cm-close-btn" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body">
                <!-- Row 1: Test Code, Fee Type, Base Amount -->
                <div class="cm-form-row three-cols">
                    <div class="cm-field-group">
                        <label class="cm-label">Test Code</label>
                        <input type="number" class="cm-input" placeholder="Ex: 101" @bind="currentTestFee.tcode" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Associated Fee Type</label>
                        <select class="cm-input cm-select" @bind="currentTestFee.ftcode">
                            <option value="">Select Fee Type</option>
                            @foreach (var ft in feeTypes)
                            {
                                <option value="@((decimal)ft.ftcode)">@ft.name</option>
                            }
                        </select>
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Base Amount ($)</label>
                        <input type="text" class="cm-input" placeholder="0" @bind="baseAmountString" />
                    </div>
                </div>

                <!-- Row 2: Margin Type, Margin Percentage, Margin Amount -->
                <div class="cm-form-row three-cols">
                    <div class="cm-field-group">
                        <label class="cm-label">Margin Type</label>
                        <input type="text" class="cm-input" placeholder="Ex: Percentage" @bind="currentTestFee.margintype" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Margin Percentage (%)</label>
                        <input type="number" step="0.1" class="cm-input" placeholder="10%" @bind="currentTestFee.marginpercentage" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Margin Amount ($)</label>
                        <input type="number" step="0.01" class="cm-input" placeholder="10.00" @bind="currentTestFee.marginamount" />
                    </div>
                </div>

                <!-- Row 3: Fee Per, Fee Amount, Charity Per -->
                <div class="cm-form-row three-cols">
                    <div class="cm-field-group">
                        <label class="cm-label">Fee Percentage (%)</label>
                        <input type="number" step="0.1" class="cm-input" placeholder="5%" @bind="currentTestFee.feeper" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Fee Amount ($)</label>
                        <input type="number" step="0.01" class="cm-input" placeholder="5.00" @bind="currentTestFee.feeamount" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Charity Percentage (%)</label>
                        <input type="number" step="0.1" class="cm-input" placeholder="2%" @bind="currentTestFee.charityper" />
                    </div>
                </div>

                <!-- Row 4: Charity Amount, Running Cost, Commission Type -->
                <div class="cm-form-row three-cols">
                    <div class="cm-field-group">
                        <label class="cm-label">Charity Amount ($)</label>
                        <input type="number" step="0.01" class="cm-input" placeholder="2.00" @bind="currentTestFee.charityamount" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Running Cost ($)</label>
                        <input type="number" step="0.01" class="cm-input" placeholder="15.00" @bind="currentTestFee.runningcost" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Commission Type</label>
                        <input type="text" class="cm-input" placeholder="Ex: Fixed" @bind="currentTestFee.commissiontype" />
                    </div>
                </div>
            </div>

            <div class="cm-modal-footer">
                @if (isEditMode)
                {
                    <button class="cm-btn-delete" @onclick="() => DeleteTestFee(currentTestFee)">Delete</button>
                }
                else
                {
                    <span></span>
                }
                <div class="cm-footer-right-buttons" style="display: flex; gap: 0.75rem; align-items: center;">
                    <button class="cm-btn-cancel" @onclick="CloseModal">Cancel</button>
                    <button class="cm-btn-save" @onclick="SaveTestFee">
                        <i class="bi bi-check2"></i> Save Test Fee
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TestFeeMasterModel> testFees = new();
    private List<FeeTypeMasterModel> feeTypes = new();
    private string searchQuery = "";
    private bool showModal = false;
    private bool isEditMode = false;
    private TestFeeMasterModel currentTestFee = new();

    private string baseAmountString
    {
        get => currentTestFee.amount == 0 ? "" : currentTestFee.amount.ToString();
        set => currentTestFee.amount = double.TryParse(value, out var v) ? v : 0;
    }

    private IEnumerable<TestFeeMasterModel> FilteredTestFees =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? testFees
            : testFees.Where(t => 
                t.tcode?.ToString().Contains(searchQuery, StringComparison.OrdinalIgnoreCase) == true ||
                GetFeeTypeName(t.ftcode).Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadFeeTypes();
        await LoadTestFees();
    }

    private async Task LoadFeeTypes()
    {
        try
        {
            var res = await FeetypeService.GetFeeTypesAsync();
            if (res != null)
            {
                feeTypes = res;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading fee types: {ex.Message}");
        }
    }

    private async Task LoadTestFees()
    {
        try
        {
            var res = await TestFeeService.GetTestFeesAsync();
            if (res != null)
            {
                testFees = res;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load test fees: {ex.Message}");
        }
    }

    private string GetFeeTypeName(decimal? ftcode)
    {
        if (ftcode == null) return "N/A";
        var ft = feeTypes.FirstOrDefault(x => x.ftcode == (int)ftcode);
        return ft?.name ?? $"ID: {ftcode}";
    }

    private void OpenNewTestFeeModal()
    {
        currentTestFee = new TestFeeMasterModel();
        isEditMode = false;
        showModal = true;
    }

    private void EditTestFee(TestFeeMasterModel testFee)
    {
        currentTestFee = new TestFeeMasterModel
        {
            tfcode = testFee.tfcode,
            tcode = testFee.tcode,
            ftcode = testFee.ftcode,
            margintype = testFee.margintype,
            marginpercentage = testFee.marginpercentage,
            marginamount = testFee.marginamount,
            amount = testFee.amount,
            feeper = testFee.feeper,
            feeamount = testFee.feeamount,
            charityper = testFee.charityper,
            charityamount = testFee.charityamount,
            runningcost = testFee.runningcost,
            commissiontype = testFee.commissiontype,
            tenant_code = testFee.tenant_code
        };
        isEditMode = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveTestFee()
    {
        try
        {
            bool success;
            if (isEditMode)
            {
                success = await TestFeeService.UpdateTestFeeAsync(currentTestFee);
            }
            else
            {
                currentTestFee.entereddate = DateTime.Now;
                currentTestFee.ibsdate = DateTime.Now;
                currentTestFee.tenant_code = "TEN1011";
                success = await TestFeeService.InsertTestFeeAsync(currentTestFee);
            }

            if (success)
            {
                ToastService.ShowSuccess("Test fee saved successfully.");
                showModal = false;
                await LoadTestFees();
            }
            else
            {
                ToastService.ShowError("Failed to save test fee.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task DeleteTestFee(TestFeeMasterModel testFee)
    {
        try
        {
            bool success = await TestFeeService.DeleteTestFeeAsync(testFee.tfcode);
            if (success)
            {
                ToastService.ShowSuccess("Test fee deleted successfully.");
                if (showModal) showModal = false;
                await LoadTestFees();
            }
            else
            {
                ToastService.ShowError("Failed to delete test fee.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }
}
