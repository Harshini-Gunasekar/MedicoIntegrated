            await LoadResults();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            try 
            {
                if (_isDisposed) return;

                // Robust UserCode and Token retrieval from session
                var claimResult = await sessionStorage.GetAsync<UserAuth>("claim");
                if (_isDisposed) return;
                if (claimResult.Success && claimResult.Value != null)
                {
                    userCode = claimResult.Value.usercode;
                    token = claimResult.Value.token;
                }

                var userDetailsResult = await sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                if (_isDisposed) return;
                if (userDetailsResult.Success && userDetailsResult.Value != null)
                {
                    tenantCode = userDetailsResult.Value.TenantCode ?? "";
                    if (userCode == 0) userCode = userDetailsResult.Value.UserCode ?? 0;
                    if (string.IsNullOrEmpty(token)) token = userDetailsResult.Value.AuthToken ?? "";
                    currentUserName = userDetailsResult.Value.UserName ?? "";

                    // Hydrate TenantSessionState for standardized API calling and auth
                    TenantState.SetSession(
                        tenantCode,
                        token,
                        userDetailsResult.Value.TenantName ?? "",
                        userCode,
                        userDetailsResult.Value.BranchCode,
                        userDetailsResult.Value.CounterCode
                    );
                }

                var rights = await sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                if (_isDisposed) return;
                if (rights.Success && rights.Value != null)
                {
                    var labRights = rights.Value.Where(x => x.Department?.Trim().Equals("Lab", StringComparison.OrdinalIgnoreCase) == true || 
                                                           x.ModuleName?.Trim().Equals("Lab", StringComparison.OrdinalIgnoreCase) == true).ToList();
                    
                    // 1. Check for specific granular module names if present
                    var entryRight = labRights.FirstOrDefault(x => x.ModuleName?.Trim().Equals("Result Entry", StringComparison.OrdinalIgnoreCase) == true);
                    var auth1Right = labRights.FirstOrDefault(x => x.ModuleName?.Trim().Equals("Authorize Lab Results", StringComparison.OrdinalIgnoreCase) == true);
                    var auth2Right = labRights.FirstOrDefault(x => x.ModuleName?.Trim().Equals("Authorize Lab Results 2", StringComparison.OrdinalIgnoreCase) == true);

                    // 2. Fall back to group level "Lab" module name rights if granular ones do not exist
                    var generalLabRight = labRights.FirstOrDefault(x => x.ModuleName?.Trim().Equals("Lab", StringComparison.OrdinalIgnoreCase) == true);

                    isentered = entryRight != null ? entryRight.ToAdd : (generalLabRight != null && generalLabRight.ToAdd);
                    isauthorized1 = auth1Right != null ? auth1Right.ToEdit : (generalLabRight != null && generalLabRight.ToEdit);
                    isauthorized2 = auth2Right != null ? auth2Right.ToDelete : (generalLabRight != null && generalLabRight.ToDelete);
                    
                    if (userCode == 0)
                    {
                        userCode = rights.Value.FirstOrDefault()?.UserCode ?? 0;
                    }
                }

                // Decoupled Role Supplement/Override Check
                if (userDetailsResult.Success && userDetailsResult.Value != null)
                {
                    var roleStr = userDetailsResult.Value.Role;
                    var uName = userDetailsResult.Value.UserName;
                    
                    if (uName?.Contains("Admin", StringComparison.OrdinalIgnoreCase) == true || 
                        roleStr?.Contains("Admin", StringComparison.OrdinalIgnoreCase) == true || 
                        userCode == 1 || userCode == 2 ||
                        string.Equals(roleStr, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(roleStr, "TenantAdmin", StringComparison.OrdinalIgnoreCase))
                    {
                        isentered = true;
                        isauthorized1 = true;
                        isauthorized2 = true;
                    }
                    else
                    {
                        var roleLower = roleStr?.Trim().ToLower();
                        if (roleLower == "0" || roleLower == "result entry" || roleLower == "result_entry" || roleLower == "result-entry")
                        {
                            isentered = true;
                        }
                        else if (roleLower == "1" || roleLower == "auth1" || roleLower == "auth 1" || roleLower == "auth_1" || roleLower == "auth-1" || roleLower == "authorizer")
                        {
                            isentered = true;
                            isauthorized1 = true;
                        }
                        else if (roleLower == "2" || roleLower == "auth2" || roleLower == "auth 2" || roleLower == "auth_2" || roleLower == "auth-2" || roleLower == "approval")
                        {
                            isentered = true;
                            isauthorized1 = true;
                            isauthorized2 = true;
                        }
                        else
                        {
                            isentered = true;
                            isauthorized1 = true;
                            isauthorized2 = true;
                        }
                    }
                }

                if (userCode == 0 && !string.IsNullOrEmpty(token))
                {
                    userCode = 1;
                    isentered = true; isauthorized1 = true; isauthorized2 = true;
                }
                
                isLoading = true;
                StateHasChanged();
                await Task.WhenAll(
                    LoadResults(),
                    UserMasterAsync()
                );
            }
            catch (OperationCanceledException) { /* Safe to ignore */ }
            catch (Exception ex) 
            { 
                /* Console.WriteLine($"Error in OnAfterRenderAsync: {ex.Message}") */;
            }

            await this.LoadResults();
            if (_isDisposed) return;
            isLoading = false;
            /* Console.WriteLine($"Delta Check Info: Request={RequestGuid}, custcode={CustCode}") */;
            UpdateUserNames();
            StateHasChanged();

            if (IsDetailedNormalValuesVisible)
            {
                try {
                    await JSRuntime.InvokeVoidAsync("initDraggablePopup", "rp-drag-header", "rp-drag-panel");
                } catch { }
            }
        }
    }
