    private async Task SelectRow(LabResultEntry row)
    {
        if (row == null) return;
        SelectedRowEntry = row;

        bool isRowUnentered = (string.IsNullOrWhiteSpace(row.enteredresult) || row.enteredresult.Trim() == "-") && !row.status && !row.isauthorized1 && !row.isauthorized2 && (row.resultenteredby == 0 || row.resultenteredby == null);
        if (isRowUnentered)
        {
            var mCfg = FindMatchingTestResultRow(row);
            if (mCfg != null)
            {
                ApplyMasterConfigToRow(row, mCfg, forceOverwrite: true);
            }
        }

        if (row.testresultid.HasValue && rowImageMap.TryGetValue(row.testresultid.Value, out var imgTuple))
        {
            reportImageFileName = imgTuple.fileName;
            reportImageBase64 = imgTuple.base64Data;
        }
        else if (!string.IsNullOrEmpty(row.image_path))
        {
            reportImageFileName = row.image_path;
            reportImageBase64 = "";
        }
        else
        {
            reportImageFileName = "";
            reportImageBase64 = "";
        }
        
        try 
        {
            // Update UI properties immediately with what we have
            SyncRowToUI(row);

            // Fetch fully populated details from the API
            var effectiveTenantCode = !string.IsNullOrEmpty(tenantCode) ? tenantCode : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");
            if (!row.testresultid.HasValue || row.testresultid.Value == Guid.Empty)
            {
                row.testresultid = Guid.NewGuid();
            }
            var url = $"api/LabResult/LoadTestResultDetails?testResultId={row.testresultid.Value}";
            var request = new HttpRequestMessage(HttpMethod.Get, url);
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            request.Headers.Add("tenant_code", effectiveTenantCode);

            var res = await ClientFactory.CreateClient("Medico").SendAsync(request, SafeToken);
            if (!res.IsSuccessStatusCode)
            {
                var fallbackUrl = $"labresult/LoadTestResultDetails?testresultid={row.testresultid}";
                var fallbackReq = new HttpRequestMessage(HttpMethod.Get, fallbackUrl);
                if (!string.IsNullOrEmpty(token))
                    fallbackReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                fallbackReq.Headers.Add("tenant_code", effectiveTenantCode);
                res = await ClientFactory.CreateClient("Medico").SendAsync(fallbackReq, SafeToken);
            }

            if (res.IsSuccessStatusCode)
            {
                var tt = await res.Content.ReadAsStringAsync();
                var detailedData = JsonConvert.DeserializeObject<TestResultDetailsModel>(tt);
                
                // Prioritize 'Properties' list if populated, otherwise map from 'LabProperties'
                LabResultEntry? detailedRow = null;
                
                if (detailedData?.properties?.Any() == true)
                {
                    var p = detailedData.properties.First();
                    detailedRow = new LabResultEntry
                    {
                        resultvaluetype = p.resultvaluetype,
                        normalvalue = p.normalvalue,
                        simplenv = p.simplenormalvalues ?? false,
                        printresultonly = p.printresultonly ?? false,
                        detailednv = p.detailednormalvalues ?? false,
                        showagedbased = p.showagedbased ?? false,
                        rtmcode = p.rtmcode ?? 0,
                        decimalvalue = p.decimalvalue ?? 0,
                        showalertonhigherlower = p.showalertonhigherlower ?? false,
                        footermessage = p.footermessage,
                        printconclusioninreport = p.printconclusioninreport ?? false,
                        conclusionforfixedtext = p.conclusionforfixedtext,
                        printnormalvaluesatbottom = p.printnormalvaluesatbottom ?? false,
                        printunitsinnormalvalues = p.printunitsinnormalvalues ?? false,
                        groupvaluesbysex = p.groupvaluesbysex ?? false,
                        groupvaluesbyspecialfield = p.groupvaluesbyspecialfield ?? false,
                        printconclusioninbottom = p.printconclusioninbottom ?? false,
                        conclusionforlower = p.conclusionforlower,
                        conclusionforhigher = p.conclusionforhigher,
                        isgraph = p.isgraph,
                        graphvalue = p.graphvalue,
                        defaultvalue = p.defaultvalue
                    };
                }
                
                if (detailedRow == null && detailedData?.labproperties?.Any() == true)
                {
                    var lp = detailedData.labproperties.First();
                    var masterP = detailedData?.properties?.FirstOrDefault();

                    detailedRow = new LabResultEntry
                    {
                        resultvaluetype = lp.resultvaluetype ?? masterP?.resultvaluetype,
                        normalvalue = lp.normalvalue ?? masterP?.normalvalue,
                        simplenv = lp.simplenormalvalues ?? masterP?.simplenormalvalues ?? false,
                        printresultonly = lp.printresultonly ?? masterP?.printresultonly ?? false,
                        detailednv = lp.detailednormalvalues ?? masterP?.detailednormalvalues ?? false,
                        showagedbased = lp.showagedbased ?? masterP?.showagedbased ?? false,
                        rtmcode = lp.rtmcode ?? masterP?.rtmcode ?? 0,
                        decimalvalue = lp.decimalvalue ?? masterP?.decimalvalue ?? 0,
                        showalertonhigherlower = lp.showalertonhigherlower ?? masterP?.showalertonhigherlower ?? false,
                        footermessage = !string.IsNullOrWhiteSpace(lp.footermessage) ? lp.footermessage : masterP?.footermessage,
                        printconclusioninreport = lp.printconclusioninreport ?? masterP?.printconclusioninreport ?? false,
                        conclusionforfixedtext = !string.IsNullOrWhiteSpace(lp.conclusionforfixedtext) ? lp.conclusionforfixedtext : masterP?.conclusionforfixedtext,
                        printnormalvaluesatbottom = lp.printnormalvaluesatbottom ?? masterP?.printnormalvaluesatbottom ?? false,
                        printunitsinnormalvalues = lp.printunitsinnormalvalues ?? masterP?.printunitsinnormalvalues ?? false,
                        groupvaluesbysex = lp.groupvaluesbysex ?? masterP?.groupvaluesbysex ?? false,
                        groupvaluesbyspecialfield = lp.groupvaluesbyspecialfield ?? masterP?.groupvaluesbyspecialfield ?? false,
                        printconclusioninbottom = lp.printconclusioninbottom ?? masterP?.printconclusioninbottom ?? false,
                        conclusionforlower = !string.IsNullOrWhiteSpace(lp.conclusionforlower) ? lp.conclusionforlower : masterP?.conclusionforlower,
                        conclusionforhigher = !string.IsNullOrWhiteSpace(lp.conclusionforhigher) ? lp.conclusionforhigher : masterP?.conclusionforhigher,
                        isgraph = lp.isgraph ?? masterP?.isgraph,
                        graphvalue = lp.graphvalue ?? masterP?.graphvalue,
                        defaultvalue = lp.defaultvalue ?? masterP?.defaultvalue
                    };
                }
                
                if (detailedRow != null)
                {
                    // Update our row reference with fetched details
                    row.resultvaluetype = detailedRow.resultvaluetype ?? row.resultvaluetype;
                    string rNameSel = (row.col2 ?? row.testname ?? "").ToLower();
                    long pCode = GetParentTCode(row);
                    bool isMulti = _testConfigs.TryGetValue(pCode, out var pCfg) && pCfg.ResultRows != null && pCfg.ResultRows.Count > 1;
                    if (!isMulti && string.Equals(row.resultvaluetype, "Title", StringComparison.OrdinalIgnoreCase) &&
                        (rNameSel.Contains("crp") || rNameSel.Contains("widal") || rNameSel.Contains("hiv") || rNameSel.Contains("hcv") || rNameSel.Contains("hbsag")))
                    {
                        if (_testConfigs.TryGetValue(pCode, out var tCfgCheck))
                        {
                            string tType = tCfgCheck.ResultRows?.FirstOrDefault()?.ResultProperties?.resultvaluetype ?? "";
                            if (!string.Equals(tType, "Title", StringComparison.OrdinalIgnoreCase))
                            {
                                row.resultvaluetype = "Numeric";
                                row.printresultonly = false;
                            }
                        }
                    }
                    if (!string.IsNullOrWhiteSpace(detailedRow.normalvalue) && detailedRow.normalvalue.Trim() != "-" && detailedRow.normalvalue.Trim() != "Normal 0" && detailedRow.normalvalue.Trim() != "0-0" && detailedRow.normalvalue.Trim() != "0 - 0" && detailedRow.normalvalue.Trim() != "0")
                    {
                        if (isRowUnentered)
                        {
                            if (string.IsNullOrWhiteSpace(row.normalvalue)) row.normalvalue = detailedRow.normalvalue;
                        }
                        else
                        {
                            row.normalvalue = detailedRow.normalvalue;
                        }
                    }
                    row.simplenv = detailedRow.simplenv;
                    row.printresultonly = detailedRow.printresultonly;
                    row.detailednv = detailedRow.detailednv;
                    row.calculatedformula = detailedRow.calculatedformula ?? row.calculatedformula;
                    row.fixedvalues = detailedRow.fixedvalues ?? row.fixedvalues;

                    row.unitname = detailedRow.unitname ?? row.unitname;
                    if (!string.IsNullOrWhiteSpace(row.unitname) && QualitativeValues.Contains(row.unitname.Trim()))
                    {
                        if (string.IsNullOrWhiteSpace(row.normalvalue) || row.normalvalue == "-" || row.normalvalue == "0-0" || row.normalvalue == "0 - 0" || row.normalvalue == "0" || row.normalvalue == "Normal 0")
                        {
                            row.normalvalue = "Negative";
                        }
                    }

                    row.machinename = detailedRow.machinename ?? row.machinename;
                    row.samplename = detailedRow.samplename ?? row.samplename;
                    
                    // Preserve fetched rtmcode if available, otherwise 0 (no method)
                    row.rtmcode = detailedRow.rtmcode > 0 ? detailedRow.rtmcode : (row.rtmcode > 0 ? row.rtmcode : 0);

                    // Sync advanced parameters with HTML stripped from conclusion and footer
                    row.decimalvalue = detailedRow.decimalvalue;
                    row.showalertonhigherlower = detailedRow.showalertonhigherlower;
                    
                    string masterFooter = (row.tcode > 0 && _testConfigs.TryGetValue(row.tcode, out var cfgFooterMaster) && !string.IsNullOrWhiteSpace(cfgFooterMaster.TestMaster?.footer)) ? cfgFooterMaster.TestMaster.footer : "";
                    string finalFooter = !string.IsNullOrWhiteSpace(detailedRow.footermessage) ? detailedRow.footermessage : masterFooter;
                    string finalConclusion = (!string.IsNullOrWhiteSpace(detailedRow.conclusionforfixedtext) && !Guid.TryParse(detailedRow.conclusionforfixedtext, out _)) ? detailedRow.conclusionforfixedtext : "";

                    if (!string.IsNullOrWhiteSpace(finalConclusion) && !string.IsNullOrWhiteSpace(finalFooter) && finalConclusion.Trim() == finalFooter.Trim())
                    {
                        finalConclusion = "";
                    }

                    row.footermessage = StripHtml(finalFooter);
                    row.conclusionforfixedtext = StripHtml(finalConclusion);
                    row.printconclusioninreport = detailedRow.printconclusioninreport || !string.IsNullOrWhiteSpace(row.footermessage) || !string.IsNullOrWhiteSpace(row.conclusionforfixedtext);
                    row.printnormalvaluesatbottom = detailedRow.printnormalvaluesatbottom;
                    row.printunitsinnormalvalues = detailedRow.printunitsinnormalvalues;
                    row.showagedbased = detailedRow.showagedbased;
                    row.printspecialfieldsatrightside = detailedRow.printspecialfieldsatrightside;
