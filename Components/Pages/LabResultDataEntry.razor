                                                                @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "result"))" style="flex: 1; @(it.estylecode == 1 ? "font-weight: bold;" : "")" disabled="@(!(isEditMode || IsRowEditable(it)))">
                                                            <option value=""></option>
                                                            @foreach (var opt in options)
                                                            {
                                                                <option value="@opt.Trim()">@opt.Trim()</option>
                                                            }
                                                        </select>
                                                    }
                                                    else if (it.resultvaluetype == "Fixed Type")
                                                    {
                                                        <select id="@($"txt-{rowIndex}-result")" class="re-t-input @GetResultBgClass(it) @(it.estylecode == 1 ? "font-bold" : "")"
                                                                value="@it.enteredresult"
                                                                @onchange="@(e => { it.enteredresult = e.Value?.ToString() ?? ""; _ = RunCalculations(); StateHasChanged(); })"
                                                                @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "result"))" style="flex: 1; @(it.estylecode == 1 ? "font-weight: bold;" : "")" disabled="@(!(isEditMode || IsRowEditable(it)))">
                                                            <option value=""></option>
                                                            <option value="Clear">Clear</option>
                                                            <option value="Cloudy">Cloudy</option>
                                                            <option value="Turbid">Turbid</option>
                                                            <option value="Slight Turbid">Slight Turbid</option>
                                                            <option value="Slightly Cloudy">Slightly Cloudy</option>
                                                            <option value="Yellow">Yellow</option>
                                                            <option value="Pale Yellow">Pale Yellow</option>
                                                            <option value="Positive">Positive</option>
                                                            <option value="Negative">Negative</option>
                                                            <option value="Reactive">Reactive</option>
                                                            <option value="Non-Reactive">Non-Reactive</option>
                                                        </select>
                                                    }
                                                    else
                                                    {
                                                        <input type="text" id="@($"txt-{rowIndex}-result")" @key="@it.testresultid"
                                                               class="re-t-input @GetResultBgClass(it) @(it.resultvaluetype == "Calculated Value" ? "re-input-calculated" : "") @(it.estylecode == 1 ? "font-bold" : "")" 
                                                               value="@it.enteredresult"
                                                               @oninput="@(e => OnResultInput(e, it))" autocomplete="off"
                                                               placeholder="Result" style="flex: 1; @(it.estylecode == 1 ? "font-weight: bold;" : "")"
                                                               @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "result"))" 
                                                               title="@(it.resultvaluetype == "Calculated Value" ? "Automatically calculated from formula" : "")" 
                                                               disabled="@(!(isEditMode || IsRowEditable(it)))" />
                                                    }
                                                    <label class="re-check-label" style="white-space: nowrap; font-size: 0.75rem; display: flex; align-items: center; gap: 4px; margin-left: 8px; cursor: pointer;">
                                                        <input type="checkbox" checked="@(it.estylecode == 1)" @onchange="@(e => { it.estylecode = ((bool)e.Value) ? 1 : 0; StateHasChanged(); })" style="cursor: pointer;" />
                                                        <span>Bold</span>
                                                    </label>
                                                </div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="re-edit-cell @GetResultBgClass(it)">
                                                @if (it.resultvaluetype == "Fixed Type" && !string.IsNullOrWhiteSpace(it.fixedvalues))
                                                {
                                                    var options = it.fixedvalues.Split(',', StringSplitOptions.RemoveEmptyEntries);
                                                    <select id="@($"txt-{rowIndex}-result")" class="re-t-input @GetResultBgClass(it)"
                                                            value="@it.enteredresult"
                                                            @onchange="@(e => { it.enteredresult = e.Value?.ToString() ?? ""; _ = RunCalculations(); StateHasChanged(); })"
                                                            @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "result"))" style="width: 100%;" disabled="@(!(isEditMode || IsRowEditable(it)))">
                                                        <option value=""></option>
                                                        @foreach (var opt in options)
                                                        {
                                                            <option value="@opt.Trim()">@opt.Trim()</option>
                                                        }
                                                    </select>
                                                }
                                                else if (it.resultvaluetype == "Fixed Type")
                                                {
                                                    <select id="@($"txt-{rowIndex}-result")" class="re-t-input @GetResultBgClass(it)"
                                                            value="@it.enteredresult"
                                                            @onchange="@(e => { it.enteredresult = e.Value?.ToString() ?? ""; _ = RunCalculations(); StateHasChanged(); })"
                                                            @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "result"))" style="width: 100%;" disabled="@(!(isEditMode || IsRowEditable(it)))">
                                                        <option value=""></option>
                                                        <option value="Clear">Clear</option>
                                                        <option value="Cloudy">Cloudy</option>
                                                        <option value="Turbid">Turbid</option>
                                                        <option value="Slight Turbid">Slight Turbid</option>
                                                        <option value="Slightly Cloudy">Slightly Cloudy</option>
                                                        <option value="Yellow">Yellow</option>
                                                        <option value="Pale Yellow">Pale Yellow</option>
                                                        <option value="Positive">Positive</option>
                                                        <option value="Negative">Negative</option>
                                                        <option value="Reactive">Reactive</option>
                                                        <option value="Non-Reactive">Non-Reactive</option>
                                                    </select>
                                                }
                                                else
                                                {
                                                    <input type="text" id="@($"txt-{rowIndex}-result")" @key="@it.testresultid"
                                                           class="re-t-input @GetResultBgClass(it) @(it.resultvaluetype == "Calculated Value" ? "re-input-calculated" : "")" 
                                                           value="@it.enteredresult"
                                                           @oninput="@(e => OnResultInput(e, it))" autocomplete="off"
                                                           placeholder="Result" style="width: 100%;"
                                                           @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "result"))" 
                                                           title="@(it.resultvaluetype == "Calculated Value" ? "Automatically calculated from formula" : "")" 
                                                           disabled="@(!(isEditMode || IsRowEditable(it)))" />
                                                }
                                            </td>
                                            <td class="re-edit-cell">
                                                <select id="@($"txt-{rowIndex}-unit")" class="re-t-input" value="@it.unitname"
                                                        @onchange="@(e => OnUnitChanged(e, it))"
                                                        @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "unit"))" disabled="@(!(isEditMode || IsRowEditable(it)))">
                                                    <option value=""></option>
                                                    @foreach (var u in uom)
                                                    {
                                                        <option value="@u.name">@u.name</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="re-edit-cell re-bg-yellow">
                                                 <input type="text" id="@($"txt-{rowIndex}-normal")" class="re-t-input" @bind="@it.normalvalue" autocomplete="off"
                                                        @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "normal"))" disabled="@(!(isEditMode || IsRowEditable(it)))" />
                                             </td>
                                         }
                                        <td class="re-edit-cell re-bg-yellow">
                                            <input type="text" id="@($"txt-{rowIndex}-machine")" class="re-t-input" @bind="@it.machinename" style="font-size: 0.75rem;" autocomplete="off"
                                                   @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "machine"))" disabled="@(!(isEditMode || IsRowEditable(it)))" />
                                        </td>
                                        <td class="re-edit-cell re-bg-yellow">
                                            <input type="text" id="@($"txt-{rowIndex}-sample")" class="re-t-input" @bind="@it.samplename" style="font-size: 0.75rem;" autocomplete="off"
                                                   @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "sample"))" disabled="@(!(isEditMode || IsRowEditable(it)))" />
                                        </td>
                                        <td class="re-col-center" style="width:80px; white-space: nowrap; padding: 4px 6px;">
                                            <div style="display: inline-flex; align-items: center; gap: 4px;">
                                                <label class="re-row-img-btn" title="@(string.IsNullOrEmpty(it.image_path) ? "Attach Image for this Test" : $"Attached Image: {it.image_path}")" @onclick:stopPropagation 
                                                       style="cursor: pointer; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; background: @(!string.IsNullOrEmpty(it.image_path) ? "#6366f1" : "#e0e7ff"); border: 1px solid @(!string.IsNullOrEmpty(it.image_path) ? "#4f46e5" : "#c7d2fe"); transition: all 0.2s ease;">
                                                    <InputFile OnChange="@(e => UploadRowImage(e, it))" style="display: none;" accept="image/*,.pdf" />
                                                    <i class="fas fa-image" style="font-size: 0.85rem; color: @(!string.IsNullOrEmpty(it.image_path) ? "#ffffff" : "#4338ca");"></i>
                                                </label>
                                                <button class="re-dot-btn" title="Row Details" @onclick="() => OpenRowDetail(it)" @onclick:stopPropagation style="width: 32px; height: 32px; border-radius: 8px;">&#8230;</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (IsDetailedNormalValuesVisible)
            {
                <!-- Right Panel (Normal Values for) -->
                <div class="re-panel-card re-right-panel" id="rp-drag-panel">
                <div class="re-rp-header" id="rp-drag-header">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-sliders-h"></i> Normal Values for
                    </div>
                    <button class="re-btn-close-popup" @onclick="ToggleDetailedNormalValues" title="Close Panel">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                @if (SelectedRowEntry == null)
                {
                    <div style="padding: 30px 20px; text-align: center; color: #64748b; font-size: 0.9rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; height: 300px;">
                        <i class="fas fa-info-circle" style="font-size: 2rem; color: #94a3b8;"></i>
                        <p style="margin: 0; font-weight: 500; line-height: 1.4;">Select a test row in the grid to view and edit normal values and settings.</p>
                    </div>
                }
                else
                {
                    <div class="re-rp-tabs">
                        <button class="re-rp-tab @(RightTab == "Settings" ? "active" : "")" @onclick="@(() => RightTab = "Settings")">
                            <i class="fas fa-cogs"></i> Settings
                        </button>
                        <button class="re-rp-tab @(RightTab == "Comments" ? "active" : "")" @onclick="@(() => RightTab = "Comments")">
                            <i class="fas fa-comment-dots"></i> Comments
                        </button>
                    </div>

                    @if (RightTab == "Settings")
                    {
                        <div class="re-rp-content">
                            <!-- Section: Result Type -->
                            <div class="re-form-grid">
                                <label class="re-label">Result Type</label>
                                <select class="re-select" @bind="SidebarResultType">
                                    <option value="Text">Text</option>
                                    <option value="Text & Number">Text &amp; Number</option>
                                    <option value="Number">Number</option>
                                    <option value="Fixed Type">Fixed Type</option>
                                    <option value="Calculated Value">Calculated Value</option>
                                    <option value="Title">Title</option>
                                    <option value="SubTitle">SubTitle</option>
                                </select>
                            </div>

                            <!-- Section: Value -->
                            <div class="re-form-grid">
                                <label class="re-label">Value</label>
                                <div class="re-row-flex">
                                    <input type="text" class="re-input re-focus-blue" @bind="ResultText" placeholder="..." style="flex: 1;" />
                                    <button class="re-btn-mini" @onclick="ToggleLabFixedValues" @onclick:preventDefault title="Options">...</button>
                                </div>
                            </div>

                            <!-- Section: Result -->
                            <div class="re-form-grid">
                                <label class="re-label">Result</label>
                                <select class="re-select" value="@FixedResultSelect" @onchange="OnFixedResultChanged">
                                    <option value=""></option>
                                    @if (!string.IsNullOrEmpty(SelectedRowEntry?.fixedvalues))
                                    {
                                        @foreach (var opt in SelectedRowEntry.fixedvalues.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <option value="@opt.Trim()">@opt.Trim()</option>
                                        }
                                    }
                                    else if (SelectedFixedType == "Appearance" || SelectedRowEntry?.testname?.ToLower().Contains("appearance") == true)
                                    {
                                        <option value="Clear">Clear</option>
                                        <option value="Cloudy">Cloudy</option>
                                        <option value="Turbid">Turbid</option>
                                        <option value="Slight Turbid">Slight Turbid</option>
                                        <option value="Slightly Cloudy">Slightly Cloudy</option>
                                    }
                                </select>
                            </div>

                            <!-- Section: Normal Value -->
                            <div class="re-form-grid">
                                <label class="re-label">Normal Value</label>
                                <select class="re-select" value="@FixedNormalValueSelect" @onchange="OnFixedNormalValueChanged">
                                    <option value=""></option>
                                    @if (!string.IsNullOrEmpty(SelectedRowEntry?.fixedvalues))
                                    {
                                        @foreach (var opt in SelectedRowEntry.fixedvalues.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <option value="@opt.Trim()">@opt.Trim()</option>
                                        }
                                    }
                                </select>
                            </div>

                            <!-- Section: Alert -->
                            <div class="re-form-grid">
                                <label class="re-label">Alert</label>
                                <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                    <div class="re-control">
                                        <label class="re-radio-label">
                                            <input type="radio" name="alertType" value="Normal" checked="@(AlertType == "Normal")" @onchange="@(() => AlertType = "Normal")" />
                                            Normal
                                        </label>
                                        <label class="re-radio-label">
                                            <input type="radio" name="alertType" value="High" checked="@(AlertType == "High")" @onchange="@(() => AlertType = "High")" />
                                            High
                                        </label>
                                        <label class="re-radio-label">
                                            <input type="radio" name="alertType" value="Low" checked="@(AlertType == "Low")" @onchange="@(() => AlertType = "Low")" />
                                            Low
                                        </label>
                                    </div>
                                    <label class="re-check-label">
                                        <input type="checkbox" @bind="PrintResultsOnly" />
                                        <span>Print Results Only</span>
                                    </label>
                                    <label class="re-check-label" style="margin-left: 12px;">
                                        <input type="checkbox" @bind="IsResultBold" />
                                        <span>Bold Result</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Section: Method -->
                            <div class="re-form-grid">
                                <label class="re-label">Method</label>
                                <select class="re-select" @bind="SelectedMethod">
                                    <option value=""></option>
                                    @foreach (var m in method)
                                    {
                                        <option value="@m.rtmcode">@m.name</option>
                                    }
                                </select>
                            </div>

                            <!-- Section: Per-Row Image Attachment -->
                            <div class="re-form-grid" style="margin-top: 14px; padding: 12px; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
                                <label class="re-label" style="font-weight: 700; color: #334155; display: block; margin-bottom: 6px;">Test Row Attachment / Image</label>
                                <div style="display: flex; align-items: center; gap: 10px; width: 100%;">
                                    <label class="re-btn-update" style="padding: 6px 12px; font-size: 0.8rem; cursor: pointer; margin: 0; display: inline-flex; align-items: center; gap: 6px;">
                                        <i class="fas fa-upload"></i> Choose Image for Row
                                        <InputFile OnChange="@(e => UploadRowImage(e, SelectedRowEntry))" style="display: none;" accept="image/*,.pdf" />
                                    </label>
                                    @if (!string.IsNullOrEmpty(SelectedRowEntry?.image_path))
                                    {
                                        <div style="display: flex; align-items: center; gap: 8px; background: #fff; padding: 4px 8px; border-radius: 6px; border: 1px solid #cbd5e1;">
                                            @if (SelectedRowEntry.testresultid.HasValue && rowImageMap.TryGetValue(SelectedRowEntry.testresultid.Value, out var rowImg) && !string.IsNullOrEmpty(rowImg.base64Data) && rowImg.base64Data.StartsWith("data:image/"))
                                            {
                                                <img src="@rowImg.base64Data" style="width: 28px; height: 28px; object-fit: cover; border-radius: 4px; border: 1px solid #cbd5e1;" />
                                            }
