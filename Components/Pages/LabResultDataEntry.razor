@page "/result-entry"
@page "/result-entry/{RequestGuid}"
@page "/lab-result-entry"
@page "/lab-result-entry/{RequestGuid}"
@page "/lab-result-data-entry"
@page "/lab-result-data-entry/{RequestGuid}"

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using SharedComponents.Rcl.Services
@using System.Text.Json.Serialization
@using Dapper.Contrib.Extensions
@using SharedComponents.Rcl.Models
@using UserDetailsModel = SharedComponents.Rcl.Models.UserDetailsModel;
@using LIMS_Backend.Model
@using LabCare.Models
@using medico_backend.Model
@using ResultEntryModel = medico_backend.Model.ResultEntryModel;
@using LabResultPropertiesModel = medico_backend.Model.LabResultPropertiesModel;
@using TestResultDetailsModel = medico_backend.Model.TestResultDetailsModel;
@using lab_result_master = medico_backend.Model.lab_result_master;
@using LabResultDetailsModel = medico_backend.Model.LabResultDetailsModel;
@using LabResultSaveRequest = medico_backend.Model.LabResultSaveRequest;
@using LabResultTextNormalValuesModel = medico_backend.Model.LabResultTextNormalValuesModel;
@using LabResultDetailedNormalValuesModel = medico_backend.Model.LabResultDetailedNormalValuesModel;
@using LabResultCalculatedFormulaModel = medico_backend.Model.LabResultCalculatedFormulaModel;
@using LabResultEntry = medico_backend.Model.LabResultEntry;
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@using NCalc
@using System.Text.RegularExpressions

@rendermode InteractiveServer

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory ClientFactory
@inject ProtectedLocalStorage sessionStorage
@inject TenantSessionState TenantState

@inject Booking.Services.ToastService Toast
@inject LabCare.Services.TestService TestSvc
@inject Booking.Services.UomMasterService UomSvc
@inject LabCare.Services.UserService UserSvc
@inject Booking.Services.RoleMasterService RoleService
@implements IDisposable



<PageTitle>Result Entry - LIMS</PageTitle>

<style>
    .re-row-selected {
        background-color: #f1f5f9 !important;
        border-left: 4px solid #6366f1 !important;
    }
    .re-row-selected td {
        background-color: #f1f5f9 !important;
    }
    .re-right-panel {
        width: 420px !important;
    }
    
</style>

<div class="re-container">
    <DnaLoader IsLoading="@isLoading" Message="Loading result entry console..." />
    <!-- User Signatures & Controls Top Header -->
    <!-- User Signatures & Controls Top Header -->
    <div class="re-header-section">
        <div class="re-top-left-group">
            <div class="re-top-avatar" title="Laboratory Result Console">
                <i class="fas fa-flask"></i>
            </div>
            
            <!-- Compact Auth Details Action Button (replaces 3 wide user blocks) -->
            <button type="button" class="re-top-auth-btn" @onclick="OpenAuthDetailsModal" title="Click to view detailed user authorization & audit history">
                <div class="re-auth-btn-icon">
                    <i class="fas fa-user-shield"></i>
                </div>
                <div class="re-auth-btn-content">
                    <div class="re-auth-btn-line1">
                        <span class="re-auth-btn-label">Auth Details</span>
                        @if (!string.IsNullOrWhiteSpace(auth2))
                        {
                            <span class="re-badge-auth2"><i class="fas fa-check-circle"></i> Approved</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(auth1))
                        {
                            <span class="re-badge-auth1"><i class="fas fa-check-circle"></i> Verified</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(ent1))
                        {
                            <span class="re-badge-entry"><i class="fas fa-pen"></i> Saved</span>
                        }
                        else
                        {
                            <span class="re-badge-pending">Pending</span>
                        }
                    </div>
                    <div class="re-auth-btn-line2">
                        <span>@(!string.IsNullOrWhiteSpace(auth2) ? $"Approved: {auth2}" : (!string.IsNullOrWhiteSpace(auth1) ? $"Verified: {auth1}" : (!string.IsNullOrWhiteSpace(ent1) ? $"Saved: {ent1}" : "No Authorizations")))</span>
                    </div>
                </div>
                <i class="fas fa-external-link-alt re-auth-btn-chevron"></i>
            </button>

            <!-- Patient Details Card (Marked in Red Area) -->
            <div class="re-top-patient-card" title="Patient: @(string.IsNullOrWhiteSpace(PatientName) ? "Not Specified" : PatientName)">
                <div class="re-patient-card-icon">
                    <i class="fas fa-user-injured"></i>
                </div>
                <div class="re-patient-card-content">
                    <div class="re-patient-card-line1">
                        <span class="re-patient-card-name" title="@PatientName">
                            @(!string.IsNullOrWhiteSpace(PatientName) ? PatientName : (!string.IsNullOrWhiteSpace(CustCode) ? $"PATIENT ({CustCode})" : "PATIENT DETAILS"))
                        </span>
                        @if (!string.IsNullOrWhiteSpace(PatientGender) || !string.IsNullOrWhiteSpace(PatientAge))
                        {
                            <span class="re-patient-demog-badge">
                                @(!string.IsNullOrWhiteSpace(PatientAge) ? $"{PatientAge}Y" : "")@(!string.IsNullOrWhiteSpace(PatientAge) && !string.IsNullOrWhiteSpace(PatientGender) ? " / " : "")@(!string.IsNullOrWhiteSpace(PatientGender) ? PatientGender : "")
                            </span>
                        }
                    </div>
                    <div class="re-patient-card-line2">
                        @if (!string.IsNullOrWhiteSpace(CustCode))
                        {
                            <span class="re-patient-sub-item"><i class="fas fa-id-card"></i> @CustCode</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(PatientDoctor))
                        {
                            <span class="re-patient-sub-item" title="Doctor: @PatientDoctor"><i class="fas fa-user-md"></i> @PatientDoctor</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <div class="re-header-right">
            <div class="re-top-datetime-card">
                <label class="re-dt-toggle" title="Toggle Date/Time editing">
                    <input type="checkbox" @bind="IsSampleDateEnabled" />
                    <i class="far fa-calendar-alt"></i>
                    <span>Date / Time</span>
                </label>
                <input type="date" class="re-top-input-date" @bind="SampleDate" disabled="@(!IsSampleDateEnabled)" />
                <div class="re-dt-divider"></div>
                <i class="far fa-clock re-clock-icon"></i>
                <input type="time" class="re-top-input-time" @bind="SampleTime" />
            </div>

            <div class="re-af-wrapper" @onclick:stopPropagation>
                <button type="button" class="re-top-pill-btn @(showAdvanceFilterDropdown ? "active" : "")" @onclick="ToggleAdvanceFilter">
                    <i class="fas fa-filter"></i>
                    <span>Advance Filter</span>
                    <i class="fas fa-chevron-down re-af-chevron @(showAdvanceFilterDropdown ? "up" : "")"></i>
                </button>
                @if (showAdvanceFilterDropdown)
                {
                    <div class="re-af-dropdown" @onclick:stopPropagation>
                        <div class="re-af-dropdown-header">
                            <span>Groups</span>
                        </div>
                        <div class="re-af-dropdown-body">
                            <div class="re-af-item @(SelectedGroupCode == 0 ? "selected" : "")" @onclick="() => SelectGroup(0)">
                                All Groups
                            </div>
                            @foreach (var g in groupList)
                            {
                                <div class="re-af-item @(SelectedGroupCode == g.gcode ? "selected" : "")" @onclick="() => SelectGroup(g.gcode)">
                                    @g.groupname
                                </div>
                            }
                        </div>
                    </div>
                    <div class="re-af-overlay" @onclick="CloseAdvanceFilter"></div>
                }
            </div>

            <div class="re-top-search-wrapper">
                <i class="fas fa-search re-top-search-icon"></i>
                <input type="text" class="re-top-search-input" placeholder="Filter tests..." @oninput="OnTestSearchInput" value="@testSearchText" />
                @if (!string.IsNullOrEmpty(testSearchText))
                {
                    <button class="re-clear-search" @onclick="ClearTestSearch" title="Clear filter">
                        <i class="fas fa-times"></i>
                    </button>
                }
            </div>

            @if (userCode == 1 || isentered || isauthorized1 || isauthorized2)
            {
                <button type="button" class="re-top-edit-btn @(isEditMode ? "active" : "")" @onclick="ToggleEditMode">
                    <i class="fas @(isEditMode ? "fa-lock-open" : "fa-lock")"></i>
                    <span>@(isEditMode ? "Edit Mode ON" : "Enable Edit")</span>
                </button>
            }
        </div>
    </div>

    <!-- Sample Info Row -->
    <div class="re-sample-card">
        <div class="re-sample-left">
            <span class="re-sample-label">Sample ID</span>
            <select class="re-sample-select" @bind="SampleIdPrefix" style="width: 65px;">
                <option value="AAM">AAM</option>
            </select>
            <select class="re-sample-select" @bind="SampleIdMiddle" style="width: 50px;">
                <option value=""></option>
            </select>
            <input type="text" class="re-sample-input" @bind="SampleIdSuffix" placeholder="Suffix..." style="width: 85px;" />
            @if (!string.IsNullOrEmpty(CustCode))
            {
                <div class="re-top-patient-badge" title="Patient ID">
                    <i class="fas fa-id-card"></i>
                    <span>PATIENT ID: @CustCode</span>
                </div>
            }
        </div>
        
        <div class="re-sample-right">
            <!-- Billed Tests Dropdown -->
            <div class="re-bt-wrapper" @onclick:stopPropagation>
                <button type="button" class="re-pill-btn-danger @(showBilledTestsDropdown ? "active" : "")" @onclick="ToggleBilledTests">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>Billed Tests</span>
                    <i class="fas fa-chevron-down re-bt-chevron @(showBilledTestsDropdown ? "up" : "")"></i>
                </button>
                @if (showBilledTestsDropdown)
                {
                    <div class="re-bt-dropdown" @onclick:stopPropagation>
                        <div class="re-bt-dropdown-header">
                            <span><i class="fas fa-vials"></i> Billed Tests</span>
                            <span class="re-bt-count">@billedTestSelections.Count tests</span>
                        </div>
                        <div class="re-bt-dropdown-body">
                            @if (!billedTestSelections.Any())
                            {
                                <div class="re-bt-empty"><i class="fas fa-inbox"></i> No tests loaded</div>
                            }
                            else
                            {
                                @foreach (var bt in billedTestSelections)
                                {
                                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px; padding: 2px 4px;">
                                        <label class="re-bt-item @(bt.IsSelected ? "selected" : "")" style="flex: 1; margin: 0;">
                                            <input type="checkbox" @bind="bt.IsSelected" />
                                            <span class="re-bt-item-name">@bt.testname</span>
                                        </label>
                                        <button type="button" title="Preview report for @bt.testname" @onclick="() => PrintReportExternal(bt.tcode.ToString())" 
                                                style="border: none; background: #e0f2fe; color: #0284c7; width: 22px; height: 22px; border-radius: 4px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 0.7rem; flex-shrink: 0;">
                                            <i class="fas fa-print"></i>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                        <div class="re-bt-dropdown-footer">
                            <button class="re-bt-apply-btn" @onclick="ApplyBilledTestFilter">Apply</button>
                            <button class="re-bt-reset-btn" @onclick="ResetBilledTestFilter">Reset</button>
                        </div>
                    </div>
                    <!-- Click-outside overlay -->
                    <div class="re-bt-overlay" @onclick="CloseBilledTests"></div>
                }
            </div>

            <button type="button" class="re-pill-btn-outline @(isDeltaLoading ? "loading" : "")" @onclick="FetchDeltaCheck" disabled="@isDeltaLoading" title="Compare with previous test values">
                <i class="fas @(isDeltaLoading ? "fa-spinner fa-spin" : "fa-chart-line")"></i> 
                <span>@(isDeltaLoading ? "Loading..." : "Delta Check")</span>
            </button>

            <button type="button" class="re-pill-btn-outline" @onclick="ReloadNewNormalValuesAsync" title="Reload default normal values">
                <i class="fas fa-sync-alt"></i>
                <span>New Normal Values</span>
            </button>
        </div>
    </div>

    @if (isFilteredByIncomingTest)
    {
        <div class="re-selected-test-banner">
            <div class="re-stb-left">
                <div class="re-stb-icon">
                    <i class="fas fa-flask"></i>
                </div>
                <div class="re-stb-title">SELECTED TEST VIEW</div>
                <div class="re-stb-divider"></div>
                <div class="re-stb-content">
                    <span class="re-stb-label">Showing results for:</span>
                    <span class="re-stb-testnames">@activeFilteredTestDisplay</span>
                </div>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <button type="button" class="re-stb-btn" style="background: #2563eb; color: #ffffff; border: 1px solid #1d4ed8;" @onclick="() => PrintReportExternal()" title="Preview this test report only">
                    <i class="fas fa-print"></i>
                    <span>Preview Test Report</span>
                </button>
                <button type="button" class="re-stb-btn" @onclick="ClearIncomingTestFilter" title="Show all tests">
                    <i class="fas fa-list-ul"></i>
                    <span>Show All Tests</span>
                </button>
            </div>
        </div>
    }

    <div class="re-main-content">
        <!-- Left Panel (Table) -->
        <div class="re-panel-card re-left-panel">


                <div class="re-table-wrapper">
                    <table class="re-data-table">
                        <thead>
                            <tr>
                                <th style="width: 220px;">DESCRIPTION</th>
                                @if (deltaResults != null && deltaResults.Any())
                                {
                                    <th style="width: 90px;" class="re-col-center">PREV. RESULT</th>
                                }
                                <th style="width: 120px;">RESULT</th>
                                <th style="width: 90px;">UNITS</th>
                                <th>NORMAL VALUES</th>
                                <th style="width: 95px;">MACHINE</th>
                                <th style="width: 100px;">SPECIMEN</th>
                                <th style="width: 65px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < lre.Count; i++)
                            {
                                var rowIndex = i;
                                var it = lre[i];
                                long groupTCode = GetParentTCode(it);
                                bool isParentHeader = (it.resultvaluetype == "Title" || it.resultvaluetype == "SubTitle")
                                                   || (it.col2?.Trim().Equals("NLR", StringComparison.OrdinalIgnoreCase) == true);
                                var isHeaderRow = isParentHeader;
                                var isTextPrintOnly = it.resultvaluetype == "Text" && it.printresultonly == true;
                                @if (isHeaderRow)
                                {
                                    var isSelectedRow = SelectedRowEntry?.testresultid == it.testresultid;
                                    var isSubTitle = it.resultvaluetype == "SubTitle" || (it.col2?.Trim().Equals("NLR", StringComparison.OrdinalIgnoreCase) == true);
                                    <tr class="re-row-header @(isSubTitle ? "re-row-subtitle" : "") @(isSelectedRow ? "re-row-selected" : "")" @onclick="() => SelectRow(it)">
                                        <td class="re-edit-cell" colspan="@(deltaResults != null && deltaResults.Any() ? 7 : 6)">
                                            <div class="re-header-row-content @(isSubTitle ? "sub" : "")">
                                                <span class="@(isSubTitle ? "re-header-icon-folder" : "re-header-icon-flask")">
                                                    <i class="@(isSubTitle ? "fas fa-folder-open" : "fas fa-flask")"></i>
                                                </span>
                                                <input type="text" id="@($"txt-{rowIndex}-col2")" class="re-header-title-input @(isSubTitle ? "sub" : "")" @bind="it.col2"
                                                       placeholder="@(it.testname ?? (isSubTitle ? "Sub-Section Title" : "Test Headline"))" autocomplete="off"
                                                       @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "col2"))" />
                                            </div>
                                        </td>
                                        <td class="re-col-center re-header-actions-cell">
                                             <div class="re-header-actions-bar">
                                                 <button type="button" class="re-row-print-btn" title="Preview Report for this Test" 
                                                         @onclick="() => PrintReportExternal(groupTCode.ToString())" @onclick:stopPropagation
                                                         style="border: 1px solid #bae6fd; background: #e0f2fe; color: #0284c7; width: 24px; height: 24px; border-radius: 5px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; transition: all 0.2s ease;">
                                                     <i class="fas fa-print"></i>
                                                 </button>
                                                 <label class="re-row-img-btn" title="@(string.IsNullOrEmpty(it.image_path) ? "Attach Image for this Test" : $"Attached Image: {it.image_path}")" @onclick:stopPropagation>
                                                     <InputFile OnChange="@(e => UploadRowImage(e, it))" style="display: none;" accept="image/*,.pdf" />
                                                     <i class="fas fa-image"></i>
                                                 </label>
                                                 <button class="re-dot-btn" title="Row Details" @onclick="() => OpenRowDetail(it)" @onclick:stopPropagation style="width: 24px; height: 24px; border-radius: 5px; font-size: 0.75rem;">&#8230;</button>
                                                 @if (userCode == 1 || isauthorized2)
                                                 {
                                                     <button class="re-link-btn" style="border:none; background:none; padding:2px 4px; cursor:pointer;" 
                                                             title="Delete Row" @onclick="() => DeleteSubRow(it)" @onclick:stopPropagation>
                                                         <i class="fas fa-trash-alt" style="color:#ef4444; font-size:0.8rem;"></i>
                                                     </button>
                                                 }
                                             </div>
                                         </td>
                                     </tr>
                                 }
                                 else if (isTextPrintOnly)
                                 {
                                     var isSelectedRow = SelectedRowEntry?.testresultid == it.testresultid;
                                    <tr class="re-data-row re-row-accent-@(rowIndex % 4) @(isSelectedRow ? "re-row-selected" : "")" @onclick="() => SelectRow(it)">
                                        <td class="re-edit-cell" colspan="@(deltaResults != null && deltaResults.Any() ? 7 : 6)">
                                            <div class="re-combined-cell">
                                                <span class="re-row-icon-pill re-pill-color-@(rowIndex % 4)">
                                                    <i class="fas fa-flask"></i>
                                                </span>
                                                <span class="re-combined-label">@it.col2</span>
                                                <div style="display: flex; align-items: center; gap: 8px; flex: 1;">
                                                     @if (it.resultvaluetype == "Fixed Type" && !string.IsNullOrWhiteSpace(it.fixedvalues))
                                                     {
                                                         var options = it.fixedvalues.Split(',', StringSplitOptions.RemoveEmptyEntries);
                                                         <select id="@($"txt-{rowIndex}-result")" class="re-t-input re-combined-result @GetResultBgClass(it) @(it.estylecode == 1 ? "font-bold" : "")"
                                                                 value="@it.enteredresult"
                                                                 @onchange="@(e => OnResultInput(e, it))"
                                                                 @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "result"))" style="flex: 1; @(it.estylecode == 1 ? "font-weight: bold;" : "")" disabled="@(!(isEditMode || IsRowEditable(it)))">
                                                             <option value=""></option>
                                                             @foreach (var opt in options)
                                                             {
                                                                 <option value="@opt.Trim()">@opt.Trim()</option>
                                                             }
                                                         </select>
                                                     }
                                                     else if (it.resultvaluetype == "Fixed Type")
                                                     {
                                                         <select id="@($"txt-{rowIndex}-result")" class="re-t-input re-combined-result @GetResultBgClass(it) @(it.estylecode == 1 ? "font-bold" : "")"
                                                                 value="@it.enteredresult"
                                                                 @onchange="@(e => OnResultInput(e, it))"
                                                                 @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "result"))" style="flex: 1; @(it.estylecode == 1 ? "font-weight: bold;" : "")" disabled="@(!(isEditMode || IsRowEditable(it)))">
                                                             <option value=""></option>
                                                             <option value="Clear">Clear</option>
                                                             <option value="Cloudy">Cloudy</option>
                                                             <option value="Turbid">Turbid</option>
                                                             <option value="Slight Turbid">Slight Turbid</option>
                                                             <option value="Slightly Cloudy">Slightly Cloudy</option>
                                                             <option value="Yellow">Yellow</option>
                                                             <option value="Pale Yellow">Pale Yellow</option>
                                                             <option value="Positive">Positive</option>
                                                             <option value="Negative">Negative</option>
                                                             <option value="Reactive">Reactive</option>
                                                             <option value="Non-Reactive">Non-Reactive</option>
                                                         </select>
                                                     }
                                                     else
                                                     {
                                                         <input type="text" id="@($"txt-{rowIndex}-result")" @key="@it.testresultid"
                                                                class="re-t-input re-combined-result @(it.resultvaluetype == "Calculated Value" ? "re-input-calculated" : "") @(it.estylecode == 1 ? "font-bold" : "")"
                                                                value="@it.enteredresult"
                                                                @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "result"))"
                                                                @oninput="@(e => OnResultInput(e, it))"
                                                                autocomplete="off"
                                                                placeholder="Result" style="flex: 1; @(it.estylecode == 1 ? "font-weight: bold;" : "")" 
                                                                title="@(it.resultvaluetype == "Calculated Value" ? "Automatically calculated from formula" : "")"
                                                                disabled="@(!(isEditMode || IsRowEditable(it)))" />
                                                     }
                                                <label class="re-check-label" style="white-space: nowrap; font-size: 0.75rem; display: flex; align-items: center; gap: 4px; margin-left: 8px; color: #166534; cursor: pointer;">
                                                    <input type="checkbox" checked="@(it.estylecode == 1)" @onchange="@(e => { it.estylecode = ((bool)e.Value) ? 1 : 0; StateHasChanged(); })" style="cursor: pointer;" />
                                                    <span>Bold</span>
                                                </label>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="re-col-center" style="width:65px; white-space: nowrap; padding: 2px 4px;">
                                             <div style="display: inline-flex; align-items: center; gap: 4px;">
                                                 <label class="re-row-img-btn" title="@(string.IsNullOrEmpty(it.image_path) ? "Attach Image for this Test" : $"Attached Image: {it.image_path}")" @onclick:stopPropagation>
                                                     <InputFile OnChange="@(e => UploadRowImage(e, it))" style="display: none;" accept="image/*,.pdf" />
                                                     <i class="fas fa-image"></i>
                                                 </label>
                                                 <button class="re-dot-btn" title="Row Details" @onclick="() => OpenRowDetail(it)" @onclick:stopPropagation style="width: 24px; height: 24px; border-radius: 5px; font-size: 0.75rem;">&#8230;</button>
                                                 @if (userCode == 1 || isauthorized2)
                                                 {
                                                     <button class="re-link-btn" style="border:none; background:none; padding:2px 4px; cursor:pointer;" 
                                                             title="Delete Row" @onclick="() => DeleteSubRow(it)" @onclick:stopPropagation>
                                                         <i class="fas fa-trash-alt" style="color:#ef4444; font-size:0.8rem;"></i>
                                                     </button>
                                                 }
                                             </div>
                                        </td>
                                    </tr>
                                 }
                                else
                                {
                                    var isSelectedRow = SelectedRowEntry?.testresultid == it.testresultid;
                                    <tr class="re-data-row re-row-accent-@(rowIndex % 4) @(isSelectedRow ? "re-row-selected" : "")" @onclick="() => SelectRow(it)">
                                        <td class="re-edit-cell" style="@(it.fromtcode > 0 ? "padding-left: 20px;" : "")">
                                            <div style="display:flex; flex-direction:column; gap:2px;">
                                                <div style="display:flex;align-items:center;gap:8px;">
                                                    <span class="re-row-icon-pill re-pill-color-@(rowIndex % 4)">
                                                        <i class="fas fa-flask"></i>
                                                    </span>
                                                    <input type="text" id="@($"txt-{rowIndex}-col2")" class="re-t-input re-t-desc" @bind="it.col2"
                                                           placeholder="@(it.testname ?? "Description")" autocomplete="off"
                                                           @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "col2"))" style="flex:1;" />
                                                </div>
                                                @if (it.testresultid.HasValue && rowImageMap.TryGetValue(it.testresultid.Value, out var rowImgData) && !string.IsNullOrEmpty(rowImgData.base64Data))
                                                {
                                                    <div style="display: flex; align-items: center; gap: 6px; margin-top: 2px; padding: 2px 6px; background: #e0e7ff; border-radius: 4px; width: fit-content; border: 1px solid #c7d2fe;">
