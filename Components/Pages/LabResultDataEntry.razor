                                                    <option value=""></option>
                                                    @if (!string.IsNullOrWhiteSpace(it.unitname) && (uom == null || !uom.Any(u => string.Equals(u.name?.Trim(), it.unitname.Trim(), StringComparison.OrdinalIgnoreCase))))
                                                    {
                                                        <option value="@it.unitname" selected>@it.unitname</option>
                                                    }
