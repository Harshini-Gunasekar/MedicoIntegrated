    private string FormatNormalValueFromDetailed(List<Lab_Result_DetailedNormalValues> detailedList)
    {
        if (detailedList == null || !detailedList.Any()) return "";

        var normalRows = detailedList
            .Where(x => string.IsNullOrEmpty(x.rangetype) || 
                        x.rangetype.Equals("Normal", StringComparison.OrdinalIgnoreCase) || 
                        x.rangetype.Equals("Between", StringComparison.OrdinalIgnoreCase) || 
                        x.rangetype.Equals("Range", StringComparison.OrdinalIgnoreCase) || 
                        x.rangetype.Equals("Upto", StringComparison.OrdinalIgnoreCase) || 
                        x.rangetype.Equals("Less than", StringComparison.OrdinalIgnoreCase) || 
                        x.rangetype == "<" || x.rangetype == "<=" ||
                        x.rangetype.Equals("More than", StringComparison.OrdinalIgnoreCase) || 
                        x.rangetype == ">" || x.rangetype == ">=" ||
                        x.rangetype.Equals("-", StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (!normalRows.Any())
        {
            normalRows = detailedList.ToList();
        }

        var parts = normalRows
            .Select(d =>
            {
                string label = "";
                if (!string.IsNullOrWhiteSpace(d.agerangetype) && 
                    !d.agerangetype.Equals("Normal", StringComparison.OrdinalIgnoreCase) && 
                    d.agerangetype != "-" &&
                    d.agerangetype.Replace(" ", "") != "0--" &&
                    d.agerangetype.Replace(" ", "") != "0-0")
                {
                    label = d.agerangetype;
                }
                else if (!string.IsNullOrWhiteSpace(d.sex) && 
                         !d.sex.Equals("Both", StringComparison.OrdinalIgnoreCase) && 
                         d.sex != "-")
                {
                    label = d.sex;
                }

                var prefix = string.IsNullOrEmpty(label) ? "" : $"{label}: ";
                string op = (d.rangetype ?? "").Trim();
                string rangeStr = "";

                if (op.Equals("Upto", StringComparison.OrdinalIgnoreCase) || op.Equals("Less than", StringComparison.OrdinalIgnoreCase) || op == "<" || op == "<=")
                {
                    rangeStr = $"< {(d.rangeto > 0 ? d.rangeto : d.rangefrom)}";
                }
                else if (op.Equals("More than", StringComparison.OrdinalIgnoreCase) || op == ">" || op == ">=")
                {
                    rangeStr = $"> {d.rangefrom}";
                }
                else if (d.rangefrom > 0 && d.rangeto > 0)
                {
                    rangeStr = d.rangefrom == d.rangeto ? $"{d.rangefrom}" : $"{d.rangefrom} - {d.rangeto}";
                }
                else if (d.rangefrom == 0 && d.rangeto > 0)
                {
                    rangeStr = $"< {d.rangeto}";
                }
                else if (d.rangefrom > 0 && d.rangeto == 0)
                {
                    rangeStr = $"{d.rangefrom}";
                }
                else
                {
                    rangeStr = "";
                }

                if (string.IsNullOrWhiteSpace(rangeStr)) return "";
                return $"{prefix}{rangeStr}";
            })
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct()
            .ToList();

        return string.Join(" | ", parts);
    }

