                                                        <input type="checkbox" checked="@(it.estylecode == 1)" @onchange="@(e => { it.estylecode = ((bool)e.Value) ? 1 : 0; StateHasChanged(); })" style="cursor: pointer;" />
                                                        <span>Bold</span>
                                                    </label>
                                                </div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="re-edit-cell @GetResultBgClass(it)">
                                                @if (it.resultvaluetype == "Fixed Type" && !string.IsNullOrWhiteSpace(it.fixedvalues))
                                                {
                                                    var options = it.fixedvalues.Split(',', StringSplitOptions.RemoveEmptyEntries);
                                                    <select id="@($"txt-{rowIndex}-result")" class="re-t-input @GetResultBgClass(it)"
                                                            value="@it.enteredresult"
                                                            @onchange="@(e => OnResultInput(e, it))"
                                                            @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "result"))" style="width: 100%;" disabled="@(!(isEditMode || IsRowEditable(it)))">
                                                        <option value=""></option>
                                                        @foreach (var opt in options)
                                                        {
                                                            <option value="@opt.Trim()">@opt.Trim()</option>
                                                        }
                                                    </select>
                                                }
                                                else if (it.resultvaluetype == "Fixed Type")
                                                {
                                                    <select id="@($"txt-{rowIndex}-result")" class="re-t-input @GetResultBgClass(it)"
                                                            value="@it.enteredresult"
                                                            @onchange="@(e => OnResultInput(e, it))"
                                                            @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "result"))" style="width: 100%;" disabled="@(!(isEditMode || IsRowEditable(it)))">
                                                        <option value=""></option>
                                                        <option value="Clear">Clear</option>
                                                        <option value="Cloudy">Cloudy</option>
                                                        <option value="Turbid">Turbid</option>
                                                        <option value="Slight Turbid">Slight Turbid</option>
                                                        <option value="Slightly Cloudy">Slightly Cloudy</option>
                                                        <option value="Yellow">Yellow</option>
                                                        <option value="Pale Yellow">Pale Yellow</option>
                                                        <option value="Positive">Positive</option>
                                                        <option value="Negative">Negative</option>
                                                        <option value="Reactive">Reactive</option>
                                                        <option value="Non-Reactive">Non-Reactive</option>
                                                    </select>
                                                }
                                                else
                                                {
                                                    <input type="text" id="@($"txt-{rowIndex}-result")" @key="@it.testresultid"
                                                           class="re-t-input @GetResultBgClass(it) @(it.resultvaluetype == "Calculated Value" ? "re-input-calculated" : "")" 
                                                           value="@it.enteredresult"
                                                           @oninput="@(e => OnResultInput(e, it))" autocomplete="off"
                                                           placeholder="Result" style="width: 100%;"
                                                           @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "result"))" 
