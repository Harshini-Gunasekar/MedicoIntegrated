                                row.textnormalvalues = matched.TextNormalValues.Select(x => new Lab_Result_TextNormalValues { trtid = x.trtid, testresultid = row.testresultid, sex = x.sex, normalvalue = x.normalvalue }).ToList();
                            }
                        }
                    }

                    var detailedFromApi = (detailedData?.labdetailedNormalvalues?.Any() == true) 
                        ? detailedData.labdetailedNormalvalues.Select(x => new Lab_Result_DetailedNormalValues { dnvid = x.trdnid, trdnid = x.trdnid, testresultid = x.testresultid, sno = x.sno ?? 0, agefrom = x.agefrom ?? 0, agefromtype = x.agefromtype, ageto = x.ageto ?? 0, agetotype = x.agetotype, agerangetype = x.agerangetype, sex = x.sex, rangetype = x.rangetype, rangefrom = x.rangefrom ?? 0, rangeto = x.rangeto ?? 0, specialconditioncode = Guid.TryParse(x.specialconditioncode?.ToString(), out var gApi) ? gApi : (Guid?)null }).ToList() 
                        : (detailedData?.detailedNormalvalues?.Select(x => new Lab_Result_DetailedNormalValues { dnvid = x.trdnid, trdnid = x.trdnid, testresultid = x.testresultid, sno = x.sno ?? 0, agefrom = x.agefrom ?? 0, agefromtype = x.agefromtype, ageto = x.ageto ?? 0, agetotype = x.agetotype, agerangetype = x.agerangetype, sex = x.sex, rangetype = x.rangetype, rangefrom = x.rangefrom ?? 0, rangeto = x.rangeto ?? 0, specialconditioncode = Guid.TryParse(x.specialconditioncode?.ToString(), out var gApi) ? gApi : (Guid?)null }).ToList() ?? new());
                    if (detailedFromApi.Any())
                    {
                        row.detailednormalvalues = detailedFromApi;
                    }
                    else if (row.detailednormalvalues == null || !row.detailednormalvalues.Any())
                    {
                        if (_testConfigs.TryGetValue(row.tcode, out var cfgD) && cfgD.ResultRows != null)
                        {
                            var matched = cfgD.ResultRows.FirstOrDefault(r => r.ResultMaster?.testresultid == row.testresultid);
                            if (matched?.DetailedNormalValues?.Any() == true)
                            {
                                row.detailednormalvalues = matched.DetailedNormalValues.Select(x => new Lab_Result_DetailedNormalValues
                                {
                                    dnvid = x.trdnid,
                                    trdnid = x.trdnid,
                                    testresultid = row.testresultid,
                                    sno = x.sno ?? 0,
                                    agefrom = x.agefrom ?? 0,
                                    agefromtype = x.agefromtype,
                                    ageto = x.ageto ?? 0,
                                    agetotype = x.agetotype,
                                    agerangetype = x.agerangetype,
                                    sex = x.sex,
                                    rangetype = x.rangetype,
                                    rangefrom = x.rangefrom ?? 0,
                                    rangeto = x.rangeto ?? 0,
                                    specialconditioncode = Guid.TryParse(x.specialconditioncode?.ToString(), out var gCfg) ? gCfg : (Guid?)null
                                }).ToList();
                            }
                        }
                    }

                    var formulasFromApi = (detailedData?.labcalculatedformulas?.Any() == true) 
                        ? detailedData.labcalculatedformulas.Select(x => new Lab_Result_CalculatedFormula { trcfid = x.trcfid, testresultid = x.testresultid, sex = x.sex, calculatedformula = x.calculatedformula }).ToList() 
                        : (detailedData?.calculatedformulas?.Select(x => new Lab_Result_CalculatedFormula { trcfid = x.trcfid, testresultid = x.testresultid, sex = x.sex, calculatedformula = x.calculatedformula }).ToList() ?? new());
                    if (formulasFromApi.Any())
                    {
                        row.calculatedformulas = formulasFromApi;
                    }
                    else if (row.calculatedformulas == null || !row.calculatedformulas.Any())
                    {
                        if (_testConfigs.TryGetValue(row.tcode, out var cfgF) && cfgF.ResultRows != null)
                        {
                            var matched = cfgF.ResultRows.FirstOrDefault(r => r.ResultMaster?.testresultid == row.testresultid);
                            if (matched?.CalculatedFormulas?.Any() == true)
                            {
                                row.calculatedformulas = matched.CalculatedFormulas.Select(x => new Lab_Result_CalculatedFormula { trcfid = x.trcfid, testresultid = row.testresultid, sex = x.sex, calculatedformula = x.calculatedformula }).ToList();
                            }
                        }
                    }
                    
                    // Force resetting local UI collections to pick up API fetched values
                    row.EditedTextNormalValues = null;
                    row.EditedDetailedNormalValues = null;
                    row.EditedCalculatedFormulas = null;
                    
                    // Re-sync UI state after fetch
                    SyncRowToUI(row);
                }
            }
        }
        catch (Exception)
        {
        }
        StateHasChanged();
    }

