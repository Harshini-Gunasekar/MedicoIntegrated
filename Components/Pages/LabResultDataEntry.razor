        // 2. Sync Calculated Formulas
        if (row.resultvaluetype == "Calculated Value")
        {
            if (row.EditedCalculatedFormulas == null) row.EditedCalculatedFormulas = new();
            
            // Prioritize existing database records. If empty, sync from current UI string.
            if (row.EditedCalculatedFormulas.Count == 0 && !string.IsNullOrWhiteSpace(row.calculatedformula))
            {
                row.EditedCalculatedFormulas.Add(new Lab_Result_CalculatedFormula 
                { 
                    trcfid = Guid.NewGuid(), 
