                StateHasChanged();
                await LoadResults();
                isLoading = false;
                StateHasChanged();
            }
            else if (_lastFilterTCode != FilterTCode || _lastFilterTestName != FilterTestName)
            {
                _lastFilterTCode = FilterTCode;
                _lastFilterTestName = FilterTestName;
                if (!string.IsNullOrWhiteSpace(FilterTCode) || !string.IsNullOrWhiteSpace(FilterTestName))
                {
                    ApplyIncomingTestFilter();
                }
                else
                {
                    ClearIncomingTestFilter();
                }
                ApplyUnifiedFilter();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            _isAfterRenderDone = true;
            _lastLoadedGuid = RequestGuid ?? "";
            try 
            {
                if (_isDisposed) return;

                // === PAGE ACCESS GATE: Result_Entry right ===
                var _pageUserResult = await sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                var _pageUser = (_pageUserResult.Success && _pageUserResult.Value != null) ? _pageUserResult.Value : null;
                bool _isPageAdmin = await UserPermissionHelper.IsAdminAsync(_pageUser, TenantState, sessionStorage);

                if (!_isPageAdmin)
                {
                    List<SharedComponents.Rcl.Models.User_Rights>? _pageRightsList = null;
                    try
                    {
                        var _pageRightsResult = await sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                        if (_pageRightsResult.Success && _pageRightsResult.Value != null)
                        {
                            _pageRightsList = _pageRightsResult.Value;
                        }
                    }
                    catch { }

                    if (_pageRightsList == null || _pageRightsList.Count == 0)
                    {
                        _pageRightsList = TenantState?.UserRightsList?.ToList();
                    }

                    var _r = await UserPermissionHelper.GetRightsAsync(_pageUser, TenantState, sessionStorage, _pageRightsList, "Result Entry", "Result_Entry", "Lab Result Entry");
                    if (await UserPermissionHelper.IsAdminAsync(null, TenantState, sessionStorage))
                    {
                        _isPageAdmin = true;
                    }

                    if (!RoleService.IsPermissionsLoaded)
                    {
                        try
                        {
                            var sessionPerms = await sessionStorage.GetAsync<List<Booking.Models.RolePermissionItem>>("UserRolePermissions");
                            if (sessionPerms.Success && sessionPerms.Value != null)
                            {
                                RoleService.SetUserPermissions(sessionPerms.Value);
                            }
                        }
                        catch { }
                    }

                    bool hasViewRole = RoleService.HasRoleId(537) || 
                                       RoleService.HasAction("Laboratory", "Result Entry", "View") || 
                                       RoleService.HasRight("Laboratory", "Result Entry") || 
                                       TenantState.HasActionRight("Laboratory", "Result Entry", "View") ||
                                       (TenantState.UserRightsList?.Any(r => r.ModuleName?.Contains("Result Entry") == true && r.ToView) == true);

                    if (!_isPageAdmin && !_r.View && !hasViewRole)
                    {
                        Toast.ShowError("You do not have permission to access Result Entry.");
                        NavigationManager.NavigateTo("/home");
                        return;
                    }
                }
                // === END PAGE ACCESS GATE ===


                var claimResult = await sessionStorage.GetAsync<UserAuth>("claim");
                if (_isDisposed) return;
                if (claimResult.Success && claimResult.Value != null)
                {
                    userCode = claimResult.Value.usercode;
                    token = claimResult.Value.token;
                }

                var userDetailsResult = await sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                if (_isDisposed) return;
                if (userDetailsResult.Success && userDetailsResult.Value != null)
                {
                    tenantCode = userDetailsResult.Value.TenantCode ?? "";
                    if (userCode == 0) userCode = userDetailsResult.Value.UserCode ?? 0;
                    if (string.IsNullOrEmpty(token)) token = userDetailsResult.Value.AuthToken ?? "";
                    currentUserName = userDetailsResult.Value.UserName ?? "";

                    // Hydrate TenantSessionState for standardized API calling and auth
                    TenantState.SetSession(
                        tenantCode,
                        token,
                        userDetailsResult.Value.TenantName ?? "",
                        userCode,
                        userDetailsResult.Value.BranchCode,
                        userDetailsResult.Value.CounterCode
                    );

                    if (userCode > 0)
                    {
                        try
                        {
                            await RoleService.LoadUserPermissionsAsync(userCode, tenantCode);
                        }
                        catch { }

                        try
                        {
                            var directIds = await RoleService.GetUserRolesAsync(userCode, tenantCode);
                            if (directIds != null && directIds.Any())
                            {
                                foreach (var rId in directIds)
                                {
                                    RoleService.GrantDirectRoleId(rId);
                                }
                            }
                        }
                        catch { }
                    }
                }

                // === RESOLVE USER RIGHTS (Save: 538, Verified: 539, Approved: 1053) ===
                _isAdminUser = _isPageAdmin || userCode == 1 || userCode == 2;
                if (!_isAdminUser && !string.IsNullOrEmpty(token))
                {
                    _isAdminUser = UserPermissionHelper.IsAdminRoleFromJwt(token);
                }
                if (!_isAdminUser && userDetailsResult.Success && userDetailsResult.Value != null)
                {
                    var rStr = userDetailsResult.Value.Role;
                    var uN = userDetailsResult.Value.UserName;
                    if (UserPermissionHelper.IsAdminRole(rStr) || 
                        UserPermissionHelper.IsAdminRole(uN) ||
                        uN?.Contains("Admin", StringComparison.OrdinalIgnoreCase) == true || 
                        rStr?.Contains("Admin", StringComparison.OrdinalIgnoreCase) == true || 
                        rStr?.Contains("Power", StringComparison.OrdinalIgnoreCase) == true ||
                        string.Equals(rStr, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(rStr, "TenantAdmin", StringComparison.OrdinalIgnoreCase))
                    {
                        _isAdminUser = true;
                    }
                }

                if (_isAdminUser)
                {
                    isentered = true;
                    isauthorized1 = true;
                    isauthorized2 = true;
                }
                else
                {
                    // 1. Check RoleMasterService permissions (Roles: 538 - Create/Save, 539 - Authorize 1/Verified, 1053 - Authorize 2/Approved)
                    bool roleCanSave = RoleService.HasRoleId(538) || 
                                       RoleService.HasAction("Laboratory", "Result Entry", "Create") || 
                                       RoleService.HasAction("Laboratory", "Result Entry", "Save") || 
                                       RoleService.HasAction("Laboratory", "Result Entry", "Add");

                    bool roleCanAuth1 = RoleService.HasRoleId(539) || 
                                        RoleService.HasAction("Laboratory", "Result Entry", "Authorize") || 
                                        RoleService.HasAction("Laboratory", "Result Entry", "Verified") || 
                                        RoleService.HasAction("Laboratory", "Result Entry", "Verify");

                    bool roleCanAuth2 = RoleService.HasRoleId(1053) || 
                                        RoleService.HasAction("Laboratory", "Result Entry", "Authorize 2") || 
                                        RoleService.HasAction("Laboratory", "Result Entry", "Approved") || 
                                        RoleService.HasAction("Laboratory", "Result Entry", "Approve");

                    if (RoleService.IsPermissionsLoaded && RoleService.HasAnyRole())
                    {
                        // Modern granular role permissions take precedence
                        isentered = roleCanSave;
                        isauthorized1 = roleCanAuth1;
                        isauthorized2 = roleCanAuth2;
                    }
                    else
                    {
                        // 2. Fallback to legacy UserRights list
                        var rights = await sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                        var userRightsList = (rights.Success && rights.Value != null) ? rights.Value : (TenantState?.UserRightsList?.ToList() ?? new List<SharedComponents.Rcl.Models.User_Rights>());
                        
                        var entryRight = userRightsList.FirstOrDefault(x => x.ModuleName?.Trim().Equals("Result Entry", StringComparison.OrdinalIgnoreCase) == true || x.ModuleName?.Trim().Equals("Result_Entry", StringComparison.OrdinalIgnoreCase) == true);
                        var auth1Right = userRightsList.FirstOrDefault(x => x.ModuleName?.Trim().Equals("Authorize Lab Results", StringComparison.OrdinalIgnoreCase) == true || x.ModuleName?.Trim().Equals("Authorize", StringComparison.OrdinalIgnoreCase) == true);
                        var auth2Right = userRightsList.FirstOrDefault(x => x.ModuleName?.Trim().Equals("Authorize Lab Results 2", StringComparison.OrdinalIgnoreCase) == true || x.ModuleName?.Trim().Equals("Authorize 2", StringComparison.OrdinalIgnoreCase) == true);

                        isentered = roleCanSave || (entryRight != null && entryRight.ToAdd);
                        isauthorized1 = roleCanAuth1 || (auth1Right != null && auth1Right.ToEdit);
                        isauthorized2 = roleCanAuth2 || (auth2Right != null && (auth2Right.ToDelete || auth2Right.ToEdit));
                    }

                    // 3. Support role level overrides (e.g. role "0" for Result Entry, "1" for Auth 1, "2" for Auth 2)
                    if (userDetailsResult.Success && userDetailsResult.Value != null)
                    {
                        var roleLower = userDetailsResult.Value.Role?.Trim().ToLower();
                        if (roleLower == "0" || roleLower == "result entry" || roleLower == "result_entry" || roleLower == "result-entry")
                        {
                            isentered = true;
                        }
                        else if (roleLower == "1" || roleLower == "auth1" || roleLower == "auth 1" || roleLower == "auth_1" || roleLower == "auth-1" || roleLower == "authorizer")
                        {
                            isentered = true;
                            isauthorized1 = true;
                        }
                        else if (roleLower == "2" || roleLower == "auth2" || roleLower == "auth 2" || roleLower == "auth_2" || roleLower == "auth-2" || roleLower == "approval")
                        {
                            isentered = true;
                            isauthorized1 = true;
                            isauthorized2 = true;
                        }
                    }
                }

                if (userCode == 0 && !string.IsNullOrEmpty(token))
                {
                    userCode = 1;
                    isentered = true; isauthorized1 = true; isauthorized2 = true;
                }
                
                isLoading = true;
                StateHasChanged();
                await Task.WhenAll(
                    LoadResults(),
                    UserMasterAsync()
                );
            }
            catch (OperationCanceledException) { /* Safe to ignore */ }
            catch (Exception ex) 
            { 
                /* Console.WriteLine($"Error in OnAfterRenderAsync: {ex.Message}") */;
            }

            if (_isDisposed) return;
            isLoading = false;
            UpdateUserNames();
            StateHasChanged();

            if (IsDetailedNormalValuesVisible)
            {
                try {
                    await JSRuntime.InvokeVoidAsync("initDraggablePopup", "rp-drag-header", "rp-drag-panel");
                } catch { }
            }
        }
    }
    private CancellationTokenSource _cts = new();
    private bool _isDisposed = false;

    public void Dispose()
    {
        _isDisposed = true;
        if (!_cts.IsCancellationRequested)
            _cts.Cancel();
        _cts.Dispose();
    }

    /// <summary>Safely gets the cancellation token. Returns CancellationToken.None if disposed.</summary>
    private CancellationToken SafeToken
    {
        get
        {
            try { return _isDisposed ? CancellationToken.None : _cts.Token; }
            catch (ObjectDisposedException) { return CancellationToken.None; }
        }
    }

