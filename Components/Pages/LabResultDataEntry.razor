    private string CleanBase64String(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        var s = raw.Trim();
        if (s.StartsWith("\"") && s.EndsWith("\""))
        {
            try { s = JsonConvert.DeserializeObject<string>(s) ?? s.Trim('"'); }
            catch { s = s.Trim('"'); }
        }
        if (s.StartsWith("{") && s.EndsWith("}"))
        {
            try
            {
                var jObj = Newtonsoft.Json.Linq.JObject.Parse(s);
                var token = jObj["data"] ?? jObj["result"] ?? jObj["pdf"] ?? jObj["report"] ?? jObj["file"] ?? jObj["base64"] ?? jObj["fileContents"] ?? jObj["filecontent"];
                if (token != null) s = token.ToString();
            }
            catch { }
        }
        if (s.StartsWith("data:application/pdf;base64,"))
        {
            s = s.Substring("data:application/pdf;base64,".Length);
        }
        return s.Trim();
    }

    private string _resolvedBilledGuid = "";
    private bool isBilledLocked = false;
    private string billedStatusMessage = "";

    private async Task<string> ResolveBilledRequestGuidAsync(bool forceRefresh = false)
    {
        if (!forceRefresh && !string.IsNullOrEmpty(_resolvedBilledGuid) && _resolvedBilledGuid != RequestGuid)
        {
            return _resolvedBilledGuid;
        }

        string targetGuid = RequestGuid ?? "";
        if (!forceRefresh && Guid.TryParse(targetGuid, out var parsedTarget) && parsedTarget != Guid.Empty)
        {
            _resolvedBilledGuid = targetGuid;
            return targetGuid;
        }

        string effectiveCustCode = !string.IsNullOrEmpty(CustCode) ? CustCode : (lre1?.FirstOrDefault(x => !string.IsNullOrEmpty(x.custcode))?.custcode ?? "");

        try
        {
            var searchPayloads = new List<object>();
            if (!string.IsNullOrEmpty(targetGuid))
            {
                searchPayloads.Add(new { page = 1, pagesize = 100, search = targetGuid });
            }
            if (!string.IsNullOrEmpty(effectiveCustCode))
            {
                searchPayloads.Add(new { page = 1, pagesize = 100, search = effectiveCustCode });
            }

            string targetEffectiveTenant = !string.IsNullOrEmpty(tenantCode) ? tenantCode : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");

            foreach (var pObj in searchPayloads)
            {
                try
                {
                    var req = new HttpRequestMessage(HttpMethod.Post, "api/HmsBilling/list-bills")
                    {
                        Content = new StringContent(JsonConvert.SerializeObject(pObj), System.Text.Encoding.UTF8, "application/json")
                    };
                    if (!string.IsNullOrEmpty(token)) req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                    if (!string.IsNullOrEmpty(targetEffectiveTenant)) req.Headers.Add("tenant_code", targetEffectiveTenant);

                    var res = await ClientFactory.CreateClient("Medico").SendAsync(req, SafeToken);
                    if (res.IsSuccessStatusCode)
                    {
                        var jsonStr = await res.Content.ReadAsStringAsync(SafeToken);
                        var listResp = JsonConvert.DeserializeObject<HmsBillListResponse>(jsonStr);
                        if (listResp?.data != null && listResp.data.Any())
                        {
                            var matchedBill = listResp.data.FirstOrDefault(b =>
                                (!string.IsNullOrEmpty(b.opvisitid) && b.opvisitid.Equals(targetGuid, StringComparison.OrdinalIgnoreCase)) ||
                                (!string.IsNullOrEmpty(b.requestguid) && b.requestguid.Equals(targetGuid, StringComparison.OrdinalIgnoreCase))
                            );

                            if (matchedBill == null && string.IsNullOrEmpty(targetGuid) && !string.IsNullOrEmpty(effectiveCustCode))
                            {
                                matchedBill = listResp.data.FirstOrDefault(b =>
                                    (b.custid.HasValue && b.custid.Value.ToString() == effectiveCustCode) ||
                                    (!string.IsNullOrEmpty(b.custcode) && b.custcode.Equals(effectiveCustCode, StringComparison.OrdinalIgnoreCase)) ||
                                    (!string.IsNullOrEmpty(b.requestguid) && b.requestguid.Contains(effectiveCustCode, StringComparison.OrdinalIgnoreCase))
                                );
                            }

                            if (matchedBill != null)
                            {
                                if (string.IsNullOrWhiteSpace(PatientName) && !string.IsNullOrWhiteSpace(matchedBill.patient_name))
                                    PatientName = matchedBill.patient_name.Trim();
                                if (string.IsNullOrWhiteSpace(PatientGender) && !string.IsNullOrWhiteSpace(matchedBill.gender))
                                    PatientGender = matchedBill.gender.Trim();
                                if (string.IsNullOrWhiteSpace(PatientAge) && !string.IsNullOrWhiteSpace(matchedBill.ageyears))
                                    PatientAge = matchedBill.ageyears.Trim();
                                if (string.IsNullOrWhiteSpace(PatientDoctor) && !string.IsNullOrWhiteSpace(matchedBill.doctor_name))
                                    PatientDoctor = matchedBill.doctor_name.Trim();
                                if (string.IsNullOrWhiteSpace(CustCode) && !string.IsNullOrWhiteSpace(matchedBill.custcode))
                                    CustCode = matchedBill.custcode.Trim();

                                if (!string.IsNullOrEmpty(matchedBill.requestguid))
                                {
                                    _resolvedBilledGuid = matchedBill.requestguid;
                                    isBilledLocked = false;
                                    billedStatusMessage = "";
                                    RequestGuid = _resolvedBilledGuid;
                                    Console.WriteLine($"[RESOLVE-GUID] Resolved billed requestguid from list-bills: {_resolvedBilledGuid}");
                                    return _resolvedBilledGuid;
                                }
                            }
                        }
                    }
                }
                catch (Exception pEx)
                {
                    Console.WriteLine($"[RESOLVE-GUID] list-bills query notice: {pEx.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RESOLVE-GUID] Error resolving billed requestguid: {ex.Message}");
        }

        return targetGuid;
    }

    private async Task LoadPatientDetailsAsync()
    {
        if (string.IsNullOrWhiteSpace(PatientName))
        {
            if (!string.IsNullOrWhiteSpace(PatientNameQuery)) PatientName = PatientNameQuery;
            else if (!string.IsNullOrWhiteSpace(PatientNameAlt)) PatientName = PatientNameAlt;
        }
        if (string.IsNullOrWhiteSpace(PatientGender) && !string.IsNullOrWhiteSpace(PatientSex))
        {
            PatientGender = PatientSex;
        }

        if (!string.IsNullOrWhiteSpace(PatientName) && !string.IsNullOrWhiteSpace(PatientGender) && !string.IsNullOrWhiteSpace(PatientAge))
        {
            return;
        }

        try
        {
            string targetGuid = RequestGuid ?? "";
            string effectiveCustCode = !string.IsNullOrEmpty(CustCode) ? CustCode : (lre1?.FirstOrDefault(x => !string.IsNullOrEmpty(x.custcode))?.custcode ?? "");
            string targetEffectiveTenant = !string.IsNullOrEmpty(tenantCode) ? tenantCode : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");

            if (!string.IsNullOrEmpty(targetGuid) || !string.IsNullOrEmpty(effectiveCustCode))
            {
                var searchPayloads = new List<object>();
                if (!string.IsNullOrEmpty(targetGuid))
                {
                    searchPayloads.Add(new { page = 1, pagesize = 20, search = targetGuid });
                }
                if (!string.IsNullOrEmpty(effectiveCustCode) && effectiveCustCode != targetGuid)
                {
                    searchPayloads.Add(new { page = 1, pagesize = 20, search = effectiveCustCode });
                }

                foreach (var pObj in searchPayloads)
                {
                    try
                    {
                        var req = new HttpRequestMessage(HttpMethod.Post, "api/HmsBilling/list-bills")
                        {
                            Content = new StringContent(JsonConvert.SerializeObject(pObj), System.Text.Encoding.UTF8, "application/json")
                        };
                        if (!string.IsNullOrEmpty(token)) req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                        if (!string.IsNullOrEmpty(targetEffectiveTenant)) req.Headers.Add("tenant_code", targetEffectiveTenant);

                        var res = await ClientFactory.CreateClient("Medico").SendAsync(req, SafeToken);
                        if (res.IsSuccessStatusCode)
                        {
                            var jsonStr = await res.Content.ReadAsStringAsync(SafeToken);
                            var listResp = JsonConvert.DeserializeObject<HmsBillListResponse>(jsonStr);
                            if (listResp?.data != null && listResp.data.Any())
                            {
                                var matchedBill = listResp.data.FirstOrDefault(b =>
                                    (!string.IsNullOrEmpty(b.opvisitid) && b.opvisitid.Equals(targetGuid, StringComparison.OrdinalIgnoreCase)) ||
                                    (!string.IsNullOrEmpty(b.requestguid) && b.requestguid.Equals(targetGuid, StringComparison.OrdinalIgnoreCase))
                                );

                                if (matchedBill == null && !string.IsNullOrEmpty(effectiveCustCode))
                                {
                                    matchedBill = listResp.data.FirstOrDefault(b =>
                                        (b.custid.HasValue && b.custid.Value.ToString() == effectiveCustCode) ||
                                        (!string.IsNullOrEmpty(b.custcode) && b.custcode.Equals(effectiveCustCode, StringComparison.OrdinalIgnoreCase)) ||
                                        (!string.IsNullOrEmpty(b.requestguid) && b.requestguid.Contains(effectiveCustCode, StringComparison.OrdinalIgnoreCase))
                                    );
                                }

                                if (matchedBill == null)
                                {
                                    matchedBill = listResp.data.First();
                                }

                                if (matchedBill != null)
                                {
                                    if (string.IsNullOrWhiteSpace(PatientName) && !string.IsNullOrWhiteSpace(matchedBill.patient_name))
                                        PatientName = matchedBill.patient_name.Trim();
                                    if (string.IsNullOrWhiteSpace(PatientGender) && !string.IsNullOrWhiteSpace(matchedBill.gender))
                                        PatientGender = matchedBill.gender.Trim();
                                    if (string.IsNullOrWhiteSpace(PatientAge) && !string.IsNullOrWhiteSpace(matchedBill.ageyears))
                                        PatientAge = matchedBill.ageyears.Trim();
                                    if (string.IsNullOrWhiteSpace(PatientDoctor) && !string.IsNullOrWhiteSpace(matchedBill.doctor_name))
                                        PatientDoctor = matchedBill.doctor_name.Trim();
                                    if (string.IsNullOrWhiteSpace(CustCode) && !string.IsNullOrWhiteSpace(matchedBill.custcode))
                                        CustCode = matchedBill.custcode.Trim();

                                    if (!string.IsNullOrWhiteSpace(PatientName))
                                    {
                                        await InvokeAsync(StateHasChanged);
                                        return;
                                    }
                                }
                            }
                        }
                    }
                    catch { }
                }
            }

            // CaseSheet fallback
            if (string.IsNullOrWhiteSpace(PatientName) && (!string.IsNullOrEmpty(effectiveCustCode) || !string.IsNullOrEmpty(targetGuid)))
            {
                var csCandidates = new List<string>();
                if (!string.IsNullOrEmpty(targetGuid)) csCandidates.Add($"api/CaseSheet/investigation?op_id={targetGuid}");
                if (!string.IsNullOrEmpty(effectiveCustCode))
                {
                    csCandidates.Add($"api/CaseSheet/investigation?custcode={effectiveCustCode}");
                    string digitsOnly = Regex.Replace(effectiveCustCode, @"[^\d]", "");
                    if (!string.IsNullOrEmpty(digitsOnly) && digitsOnly != effectiveCustCode)
                        csCandidates.Add($"api/CaseSheet/investigation?custcode=CUST-{digitsOnly}");
                }

                foreach (var ep in csCandidates.Distinct())
                {
                    try
                    {
                        var csReq = new HttpRequestMessage(HttpMethod.Get, ep);
                        if (!string.IsNullOrEmpty(token)) csReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                        if (!string.IsNullOrEmpty(targetEffectiveTenant)) csReq.Headers.Add("tenant_code", targetEffectiveTenant);

                        var csRes = await ClientFactory.CreateClient("Medico").SendAsync(csReq, SafeToken);
                        if (csRes.IsSuccessStatusCode)
                        {
                            var csJson = await csRes.Content.ReadAsStringAsync(SafeToken);
                            if (csJson.TrimStart().StartsWith("["))
                            {
                                var allHeaders = JsonConvert.DeserializeObject<List<CaseSheetInvestigationAllDto>>(csJson);
                                var matchedH = allHeaders?.FirstOrDefault(h => !string.IsNullOrWhiteSpace(h.patient_name));
                                if (matchedH != null && !string.IsNullOrWhiteSpace(matchedH.patient_name))
                                {
                                    PatientName = matchedH.patient_name.Trim();
                                    if (string.IsNullOrWhiteSpace(CustCode) && !string.IsNullOrWhiteSpace(matchedH.custcode))
                                        CustCode = matchedH.custcode;
                                    await InvokeAsync(StateHasChanged);
                                    return;
                                }
                            }
                        }
                    }
                    catch { }
                }
            }

            // Customer search fallback
            if (string.IsNullOrWhiteSpace(PatientName) && !string.IsNullOrEmpty(effectiveCustCode))
            {
                try
                {
                    string custSearchUrl = $"api/Customer/search?key={Uri.EscapeDataString(effectiveCustCode)}";
                    var cReq = new HttpRequestMessage(HttpMethod.Get, custSearchUrl);
                    if (!string.IsNullOrEmpty(token)) cReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                    if (!string.IsNullOrEmpty(targetEffectiveTenant)) cReq.Headers.Add("tenant_code", targetEffectiveTenant);

                    var cRes = await ClientFactory.CreateClient("Medico").SendAsync(cReq, SafeToken);
                    if (cRes.IsSuccessStatusCode)
                    {
                        var cJson = await cRes.Content.ReadAsStringAsync(SafeToken);
                        var custList = JsonConvert.DeserializeObject<List<CustomerModel>>(cJson);
                        var matchedCust = custList?.FirstOrDefault(c => !string.IsNullOrWhiteSpace(c.name));
                        if (matchedCust != null && !string.IsNullOrWhiteSpace(matchedCust.name))
                        {
                            PatientName = matchedCust.name.Trim();
                            if (string.IsNullOrWhiteSpace(PatientGender) && !string.IsNullOrWhiteSpace(matchedCust.gender))
                                PatientGender = matchedCust.gender.Trim();
                            await InvokeAsync(StateHasChanged);
                            return;
                        }
                    }
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadPatientDetails] Error: {ex.Message}");
        }
    }

    private async Task<string> FetchReportBase64(string? specificTcode = null)
    {
        if (string.IsNullOrEmpty(RequestGuid)) return "";

        bool isLetterHead = PrintOption == "LetterHead";

        int entId = lre1.FirstOrDefault(x => x.resultenteredby > 0)?.resultenteredby ?? userCode;
        int auth1Id = lre1.FirstOrDefault(x => x.resultauthorizedby > 0)?.resultauthorizedby ?? 0;
        int auth2Id = lre1.FirstOrDefault(x => x.resultauthorizedby2 > 0)?.resultauthorizedby2 ?? 0;

        var nameEnt = usermaster?.FirstOrDefault(x => x.usercode == entId)?.name ?? (entId == 1 ? "Admin" : (entId > 0 ? $"Staff ({entId})" : ""));
        var nameAuth1 = usermaster?.FirstOrDefault(x => x.usercode == auth1Id)?.name ?? (auth1Id == 1 ? "Admin" : (auth1Id > 0 ? $"Staff ({auth1Id})" : ""));
        var nameAuth2 = usermaster?.FirstOrDefault(x => x.usercode == auth2Id)?.name ?? (auth2Id == 1 ? "Admin" : (auth2Id > 0 ? $"Staff ({auth2Id})" : ""));

        var effectiveTenantCode = !string.IsNullOrEmpty(tenantCode) ? tenantCode : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");

        void AttachHeaders(HttpRequestMessage req)
        {
            if (!string.IsNullOrEmpty(token))
                req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            if (!string.IsNullOrEmpty(effectiveTenantCode))
                req.Headers.Add("tenant_code", effectiveTenantCode);
        }

        string billedRequestGuid = await ResolveBilledRequestGuidAsync();
        string activeGuid = !string.IsNullOrEmpty(billedRequestGuid) ? billedRequestGuid : RequestGuid;

        // Load latest entered test results via api/LabResult/LoadResultEntry?requestGuid={}
        try
        {
            string loadUrl = $"api/LabResult/LoadResultEntry?requestGuid={activeGuid}";
            var loadReq = new HttpRequestMessage(HttpMethod.Get, loadUrl);
            AttachHeaders(loadReq);
            var loadRes = await ClientFactory.CreateClient("Medico").SendAsync(loadReq);
            if (!loadRes.IsSuccessStatusCode)
            {
                var fbReq = new HttpRequestMessage(HttpMethod.Get, $"api/labresult/loadtestresultentry?requestguid={activeGuid}&custcode={CustCode}");
                AttachHeaders(fbReq);
                loadRes = await ClientFactory.CreateClient("Medico").SendAsync(fbReq);
            }
            if (loadRes.IsSuccessStatusCode)
            {
                var loadJson = await loadRes.Content.ReadAsStringAsync();
                var freshModel = JsonConvert.DeserializeObject<ResultEntryModel>(loadJson);
                if (freshModel?.results?.Any() == true)
                {
                    Console.WriteLine($"[FETCH-REPORT] Loaded updated test results via api/LabResult/LoadResultEntry for {activeGuid}");
                }
            }
        }
        catch (Exception loadEx)
        {
            Console.WriteLine($"[FETCH-REPORT] api/LabResult/LoadResultEntry fetch notice: {loadEx.Message}");
        }

        // Determine which tcode(s) to pass
        string selectedTcodes = "";
        if (!string.IsNullOrWhiteSpace(specificTcode))
        {
            selectedTcodes = specificTcode.Trim();
        }
        else if (billedTestSelections != null && billedTestSelections.Any())
        {
            var selItems = billedTestSelections.Where(b => b.IsSelected).ToList();
            if (selItems.Any() && (isFilteredByIncomingTest || selItems.Count < billedTestSelections.Count))
            {
                selectedTcodes = string.Join(",", selItems.Select(b => b.tcode));
            }
            else if (!string.IsNullOrEmpty(FilterTCode))
            {
                selectedTcodes = FilterTCode.Trim();
            }
        }
        else if (!string.IsNullOrEmpty(FilterTCode))
        {
            selectedTcodes = FilterTCode.Trim();
        }

        // Also check if lre is filtered to a subset of tests (e.g. through search or group)
        if (string.IsNullOrWhiteSpace(selectedTcodes) && lre != null && lre.Any() && lre1 != null && lre1.Any())
        {
            var visibleTCodes = lre.Where(x => x.tcode > 0).Select(x => x.tcode).Distinct().ToList();
            var allTCodes = lre1.Where(x => x.tcode > 0).Select(x => x.tcode).Distinct().ToList();
            if (visibleTCodes.Count > 0 && visibleTCodes.Count < allTCodes.Count)
            {
                selectedTcodes = string.Join(",", visibleTCodes);
            }
        }

        // Determine effective Guid strictly as valid requestguid
        string effectiveGuid = "";
        var rowWithGuid = lre1?.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.requestguid) && Guid.TryParse(x.requestguid, out var g) && g != Guid.Empty);
        if (rowWithGuid != null && !string.IsNullOrWhiteSpace(rowWithGuid.requestguid))
        {
            effectiveGuid = rowWithGuid.requestguid.Trim();
        }
        else if (!string.IsNullOrWhiteSpace(billedRequestGuid) && Guid.TryParse(billedRequestGuid, out var g2) && g2 != Guid.Empty)
        {
            effectiveGuid = billedRequestGuid.Trim();
        }
        else if (!string.IsNullOrWhiteSpace(activeGuid) && Guid.TryParse(activeGuid, out var g3) && g3 != Guid.Empty)
        {
            effectiveGuid = activeGuid.Trim();
        }
        else
        {
            effectiveGuid = RequestGuid?.Trim() ?? "";
        }

        // Collect all distinct valid GUIDs from data rows, page parameter, and resolved billed guid
        var validGuids = new List<Guid>();
        void TryAddGuid(string? gStr)
        {
            if (!string.IsNullOrWhiteSpace(gStr) && Guid.TryParse(gStr.Trim(), out var parsed) && parsed != Guid.Empty)
            {
                if (!validGuids.Contains(parsed))
                    validGuids.Add(parsed);
            }
        }

        if (lre1 != null)
        {
            foreach (var r in lre1)
            {
                TryAddGuid(r.requestguid);
            }
        }
        TryAddGuid(effectiveGuid);
        TryAddGuid(activeGuid);
        TryAddGuid(RequestGuid);
        TryAddGuid(billedRequestGuid);

        var parsedCodes = (selectedTcodes ?? "")
            .Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(s => int.TryParse(s, out _))
            .Select(int.Parse)
            .Distinct()
            .ToList();

        string tz = "";
        try { tz = TimeZoneInfo.Local.StandardName ?? ""; } catch { }
        string tzParam = !string.IsNullOrEmpty(tz) ? $"&timezone={Uri.EscapeDataString(tz)}" : "";
        string letterheadParam = $"isletterhead={(isLetterHead ? "true" : "false")}";

        // Candidate URLs strictly querying [HttpGet("labreport")] with requestguid, isletterhead, tcode, timezone
        var candidateUrls = new List<string>();

        // If we found valid Guids, build queries for each Guid
        if (validGuids.Any())
        {
            foreach (var g in validGuids)
            {
                string guidStr = g.ToString("D");

                if (parsedCodes.Any())
                {
                    string singleTcodeStr = string.Join(",", parsedCodes);

                    // 1. Primary endpoint with tcode parameter (exact match to LabResultSearch pattern)
                    candidateUrls.Add($"api/report/labreport?requestguid={guidStr}&{letterheadParam}&tcode={singleTcodeStr}");
                    candidateUrls.Add($"api/Report/LabReport?requestguid={guidStr}&{letterheadParam}&tcode={singleTcodeStr}");

                    // 2. With timezone
                    if (!string.IsNullOrEmpty(tzParam))
                    {
                        candidateUrls.Add($"api/report/labreport?requestguid={guidStr}&{letterheadParam}&tcode={singleTcodeStr}{tzParam}");
                        candidateUrls.Add($"api/Report/LabReport?requestguid={guidStr}&{letterheadParam}&tcode={singleTcodeStr}{tzParam}");
                    }

                    if (parsedCodes.Count > 1)
                    {
                        string listTcodesStr = string.Join("&", parsedCodes.Select(c => $"tcodes={c}"));
                        candidateUrls.Add($"api/report/labreport?requestguid={guidStr}&{letterheadParam}&{listTcodesStr}");
                    }
                }
                else if (!string.IsNullOrWhiteSpace(selectedTcodes))
                {
                    candidateUrls.Add($"api/report/labreport?requestguid={guidStr}&{letterheadParam}&tcode={Uri.EscapeDataString(selectedTcodes)}");
                    candidateUrls.Add($"api/Report/LabReport?requestguid={guidStr}&{letterheadParam}&tcode={Uri.EscapeDataString(selectedTcodes)}");
                    if (!string.IsNullOrEmpty(tzParam))
                    {
                        candidateUrls.Add($"api/report/labreport?requestguid={guidStr}&{letterheadParam}&tcode={Uri.EscapeDataString(selectedTcodes)}{tzParam}");
                        candidateUrls.Add($"api/Report/LabReport?requestguid={guidStr}&{letterheadParam}&tcode={Uri.EscapeDataString(selectedTcodes)}{tzParam}");
                    }
                }
                else
                {
                    // Full lab report (no tcode filter) ONLY when no test filter was selected
                    candidateUrls.Add($"api/report/labreport?requestguid={guidStr}&{letterheadParam}");
                    candidateUrls.Add($"api/Report/LabReport?requestguid={guidStr}&{letterheadParam}");
                    if (!string.IsNullOrEmpty(tzParam))
                    {
                        candidateUrls.Add($"api/report/labreport?requestguid={guidStr}&{letterheadParam}{tzParam}");
                        candidateUrls.Add($"api/Report/LabReport?requestguid={guidStr}&{letterheadParam}{tzParam}");
                    }
                }
            }
        }
        else if (!string.IsNullOrWhiteSpace(RequestGuid))
        {
            string raw = RequestGuid.Trim();
            if (parsedCodes.Any())
            {
                string singleTcodeStr = string.Join(",", parsedCodes);
                candidateUrls.Add($"api/report/labreport?requestguid={raw}&{letterheadParam}&tcode={singleTcodeStr}");
                candidateUrls.Add($"api/Report/LabReport?requestguid={raw}&{letterheadParam}&tcode={singleTcodeStr}");
            }
            else
            {
                candidateUrls.Add($"api/report/labreport?requestguid={raw}&{letterheadParam}");
                candidateUrls.Add($"api/Report/LabReport?requestguid={raw}&{letterheadParam}");
            }
        }

        // Helper to extract PDF Base64 from binary stream/file or json/base64 response
        async Task<string> TryGetPdfFromResponse(HttpResponseMessage resp)
        {
            if (!resp.IsSuccessStatusCode || resp.StatusCode == System.Net.HttpStatusCode.NoContent)
                return "";

            var mediaType = resp.Content.Headers.ContentType?.MediaType?.ToLowerInvariant() ?? "";
            if (mediaType.Contains("pdf") || mediaType.Contains("octet-stream"))
            {
                var bytes = await resp.Content.ReadAsByteArrayAsync();
                if (bytes != null && bytes.Length > 0)
                {
                    return Convert.ToBase64String(bytes);
                }
            }

            var raw = await resp.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(raw)) return "";

            if (raw.StartsWith("%PDF", StringComparison.OrdinalIgnoreCase))
            {
                var bytes = await resp.Content.ReadAsByteArrayAsync();
                if (bytes != null && bytes.Length > 0)
                {
                    return Convert.ToBase64String(bytes);
                }
            }

            // Check if JSON object has data / pdf / result field
            if (raw.TrimStart().StartsWith("{"))
            {
                try
                {
                    var jObj = Newtonsoft.Json.Linq.JObject.Parse(raw);
                    var possibleFields = new[] { "pdf", "data", "result", "base64", "report", "file", "pdfBase64", "content" };
                    foreach (var f in possibleFields)
                    {
                        var val = jObj[f]?.ToString();
                        if (!string.IsNullOrWhiteSpace(val) && val.Length >= 50)
                        {
                            return CleanBase64String(val);
                        }
                    }
                }
                catch { }
            }

            return CleanBase64String(raw);
        }

        // Strictly query [HttpGet("labreport")] endpoint
        foreach (var cUrl in candidateUrls)
        {
            try
            {
                var req = new HttpRequestMessage(HttpMethod.Get, cUrl);
                AttachHeaders(req);
                var res = await ClientFactory.CreateClient("Medico").SendAsync(req);
                if (res.IsSuccessStatusCode && res.StatusCode != System.Net.HttpStatusCode.NoContent)
                {
                    string cleaned = await TryGetPdfFromResponse(res);
                    if (!string.IsNullOrEmpty(cleaned) && cleaned.Length >= 50)
                    {
                        Console.WriteLine($"[FETCH-REPORT] Successfully received PDF from GET {cUrl} (Length: {cleaned.Length})");
                        return cleaned;
                    }
                }
                else
                {
                    Console.WriteLine($"[FETCH-REPORT] GET {cUrl} returned {(int)res.StatusCode} ({res.ReasonPhrase})");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[FETCH-REPORT] GET {cUrl} failed: {ex.Message}");
            }
        }

        // Culture Test Check
        bool hasCultureTest = lre1 != null && lre1.Any(x => 
            x.resulttype == "CU" || 
            x.resulttype == "L" || 
            (x.resultvaluetype != null && (x.resultvaluetype.Contains("Culture", StringComparison.OrdinalIgnoreCase) || x.resultvaluetype.Contains("Microbiology", StringComparison.OrdinalIgnoreCase))) ||
            (x.groupname != null && (x.groupname.Contains("Culture", StringComparison.OrdinalIgnoreCase) || x.groupname.Contains("Microbiology", StringComparison.OrdinalIgnoreCase))) ||
            (x.testname != null && (x.testname.Contains("Culture", StringComparison.OrdinalIgnoreCase) || x.testname.Contains("Microbiology", StringComparison.OrdinalIgnoreCase)))
        );

        if (hasCultureTest)
        {
            try
            {
                string cultureTcodeParam = !string.IsNullOrEmpty(selectedTcodes) ? $"&tcode={selectedTcodes}" : "";
                string urlCulture1 = $"api/report/culture-report?requestguid={effectiveGuid}&{letterheadParam}{cultureTcodeParam}{tzParam}";
                var reqC1 = new HttpRequestMessage(HttpMethod.Get, urlCulture1);
                AttachHeaders(reqC1);
                var resC1 = await ClientFactory.CreateClient("Medico").SendAsync(reqC1);
                string cleaned = await TryGetPdfFromResponse(resC1);
                if (!string.IsNullOrEmpty(cleaned) && cleaned.Length >= 50) return cleaned;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[FETCH-REPORT] Culture GET failed: {ex.Message}");
            }
        }

        return "";
    }

