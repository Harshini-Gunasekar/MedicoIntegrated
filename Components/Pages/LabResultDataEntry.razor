    private IEnumerable<LabResultEntry> FilteredAuditRows
    {
        get
        {
            if (lre1 == null) return Enumerable.Empty<LabResultEntry>();
            var rows = lre1.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(authModalSearchText))
            {
                string q = authModalSearchText.Trim();
                rows = rows.Where(r => 
                    (r.testname != null && r.testname.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (r.col2 != null && r.col2.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (r.enteredresult != null && r.enteredresult.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    ResolveUserName(r.resultenteredby).Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    ResolveUserName(r.resultauthorizedby).Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    ResolveUserName(r.resultauthorizedby2).Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (GetAuditItem(r).SavedByName != null && GetAuditItem(r).SavedByName!.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (GetAuditItem(r).VerifiedByName != null && GetAuditItem(r).VerifiedByName!.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (GetAuditItem(r).ApprovedByName != null && GetAuditItem(r).ApprovedByName!.Contains(q, StringComparison.OrdinalIgnoreCase))
                );
            }
            if (authModalFilterUser != "ALL")
            {
                rows = rows.Where(r => 
                    ResolveUserName(r.resultenteredby).Equals(authModalFilterUser, StringComparison.OrdinalIgnoreCase) ||
                    ResolveUserName(r.resultauthorizedby).Equals(authModalFilterUser, StringComparison.OrdinalIgnoreCase) ||
                    ResolveUserName(r.resultauthorizedby2).Equals(authModalFilterUser, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(GetAuditItem(r).SavedByName, authModalFilterUser, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(GetAuditItem(r).VerifiedByName, authModalFilterUser, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(GetAuditItem(r).ApprovedByName, authModalFilterUser, StringComparison.OrdinalIgnoreCase)
                );
            }
            return rows;
        }
    }

