    private int currentActionLevel
    {
        get
        {
            if (isEditMode) return 0;
            if (lre1 == null || !lre1.Any()) return 0;

            // Auth 2 complete -> Level 3 (Authorized)
            if (isAuth2Done) return 3;

            // Auth 1 complete -> Level 2 (Authorize 2)
            if (isAuth1Done) return 2;

            // Result Entry saved -> Level 1 (Authorize 1)
            bool isSaved = lre1.Any(x => (x.resultenteredby > 0 || x.status) && !string.IsNullOrWhiteSpace(x.enteredresult?.Trim()));
            if (isSaved) return 1;

            // Fresh unsaved entry -> Level 0 (Save)
            return 0;
        }
    }

