    /// <summary>
    /// Merges the units returned from the result-entry API with the full UOM master list
    /// from the UomMaster service. Result-entry units take precedence for matching ucodes;
    /// any additional master units are appended so the dropdown always shows all available units.
    /// </summary>
    private static IList<Booking.Models.UomMasterModel>? _cachedMasterUnits;
    private async Task<IList<Booking.Models.UomMasterModel>> LoadAndMergeUomAsync(
        IList<Booking.Models.UomMasterModel>? resultUnits)
    {
        var merged = new List<Booking.Models.UomMasterModel>(resultUnits ?? new List<Booking.Models.UomMasterModel>());
        var effectiveTenantCode = !string.IsNullOrEmpty(tenantCode) ? tenantCode : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");

        try
        {
            var client = ClientFactory.CreateClient("InventoryApi");
            if (!string.IsNullOrEmpty(effectiveTenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenantcode");
                client.DefaultRequestHeaders.Add("tenantcode", effectiveTenantCode);
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", effectiveTenantCode);
            }
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await client.GetStringAsync("ItemMaster/getalluom");
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var direct = System.Text.Json.JsonSerializer.Deserialize<List<Booking.Models.UomMasterModel>>(response, opts);
            if (direct != null && direct.Any())
            {
                foreach (var mu in direct.Where(x => !x.deleted))
                {
                    if (string.IsNullOrWhiteSpace(mu.name) && !string.IsNullOrWhiteSpace(mu.shortname)) mu.name = mu.shortname;
                    if (string.IsNullOrWhiteSpace(mu.shortname) && !string.IsNullOrWhiteSpace(mu.name)) mu.shortname = mu.name;

                    if (!merged.Any(m => m.ucode == mu.ucode || string.Equals(m.name?.Trim(), mu.name?.Trim(), StringComparison.OrdinalIgnoreCase)))
                    {
                        merged.Add(mu);
                    }
                }
            }
        }
        catch { }

        try
        {
            if (_cachedMasterUnits == null || !_cachedMasterUnits.Any())
            {
                _cachedMasterUnits = await UomSvc.GetUomMastersAsync();
            }
            var masterUnits = _cachedMasterUnits;
            if (masterUnits != null)
            {
                foreach (var mu in masterUnits.Where(x => !x.deleted))
                {
                    if (string.IsNullOrWhiteSpace(mu.name) && !string.IsNullOrWhiteSpace(mu.shortname)) mu.name = mu.shortname;
                    if (string.IsNullOrWhiteSpace(mu.shortname) && !string.IsNullOrWhiteSpace(mu.name)) mu.shortname = mu.name;

                    bool alreadyExists = merged.Any(m =>
                        m.ucode == mu.ucode ||
                        (m.name != null && mu.name != null &&
                         m.name.Trim().Equals(mu.name.Trim(), StringComparison.OrdinalIgnoreCase)));
                    if (!alreadyExists)
                        merged.Add(mu);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[UOM] Failed to load UOM master list: {ex.Message}");
        }

        // Standard clinical laboratory units seed
        var standardLabUnits = new[]
        {
            "MG/L", "mg/dl", "g/dl", "mmol/L", "µmol/L", "U/L", "IU/L", "IU/ml",
            "cells/cumm", "millions/cumm", "lakhs/cumm", "mm/hr", "%", "fl", "pg",
            "mEq/L", "ng/ml", "µg/dl", "pg/ml", "copies/ml", "index", "ratio", "mg/24hr", "g/24hr"
        };

        int maxUcode = merged.Any() ? (int)merged.Max(x => x.ucode) : 1000;
        foreach (var std in standardLabUnits)
        {
            if (!merged.Any(m => string.Equals(m.name?.Trim(), std, StringComparison.OrdinalIgnoreCase) || string.Equals(m.shortname?.Trim(), std, StringComparison.OrdinalIgnoreCase)))
            {
                maxUcode++;
                merged.Add(new Booking.Models.UomMasterModel
                {
                    ucode = maxUcode,
                    name = std,
                    shortname = std,
                    orderno = maxUcode
                });
            }
        }

        // Normalize
        return merged
            .Where(u => (!string.IsNullOrWhiteSpace(u.name) || !string.IsNullOrWhiteSpace(u.shortname)))
            .Select(u => {
                if (string.IsNullOrWhiteSpace(u.name)) u.name = u.shortname;
                if (string.IsNullOrWhiteSpace(u.shortname)) u.shortname = u.name;
                return u;
            })
            .OrderBy(u => u.orderno > 0 ? u.orderno : int.MaxValue)
            .ThenBy(u => u.name)
            .ToList();
    }


