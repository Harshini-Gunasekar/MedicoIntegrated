public class User_Master { 
    [Newtonsoft.Json.JsonProperty("user_code")]
    public int user_code_prop { set { if (usercode == 0) usercode = value; } }

    [Newtonsoft.Json.JsonProperty("usercode")]
    public int usercode { get; set; }

    [Newtonsoft.Json.JsonProperty("name")]
    public string name { get; set; } = "";

    [Newtonsoft.Json.JsonProperty("username")]
    public string username_prop { set { if (string.IsNullOrEmpty(name)) name = value; } }

    public string module { get; set; } = "";
    public string role { get; set; } = "";
}
public class UserMasterWrapper {
    [Newtonsoft.Json.JsonProperty("user")]
    public User_Master User { get; set; }
}

