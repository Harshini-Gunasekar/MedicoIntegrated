                        var c2 = new ByteArrayContent(imgBytes);
                        c2.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(mime);
                        formData.Add(c2, "image_file", filename);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[SAVE] Image conversion error: {ex.Message}");
                    }
                }

                var formRequest = new HttpRequestMessage(HttpMethod.Post, saveUrl)
                {
                    Content = formData
                };
                if (!string.IsNullOrEmpty(token))
                    formRequest.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                if (!string.IsNullOrEmpty(tenantCode))
                    formRequest.Headers.Add("tenant_code", tenantCode);

                res = await ClientFactory.CreateClient("Medico").SendAsync(formRequest, SafeToken);
                Console.WriteLine($"[SAVE] FormData Response: {(int)res.StatusCode} {res.StatusCode}");
            }
            string resBody = "";
            try
            {
                resBody = await res.Content.ReadAsStringAsync();
                Console.WriteLine($"[SAVE] Response Body: {resBody}");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SAVE] Failed to read response body: {ex.Message}");
            }

            string trimmedBody = resBody?.Trim().ToLower() ?? "";
            bool isBackendSuccess = res.IsSuccessStatusCode && 
                                    trimmedBody != "false" && 
                                    trimmedBody != "0" && 
                                    !trimmedBody.Contains("\"success\":false") && 
                                    !trimmedBody.Contains("\"status\":false") && 
                                    !trimmedBody.Contains("\"error\"");

            if (isBackendSuccess)
            {
                saveError = false;
                saveMessage = "âœ“ Results saved successfully!";
                Toast.ShowSuccess("Results saved successfully!");

                UpdateUserNames();
                await RunCalculations();
                StateHasChanged();
            }
            else
            {
                saveError = true;
                saveMessage = $"Save failed on backend: {res.StatusCode} - {resBody}";
                Toast.ShowError(saveMessage);
            }
        }
        catch (OperationCanceledException) { /* Console.WriteLine("[SAVE] Cancelled.") */; }
        catch (ObjectDisposedException) { /* Console.WriteLine("[SAVE] ObjectDisposed (safe to ignore).") */; }
        catch (Exception ex)
        {
            saveError = true;
            saveMessage = $"Error: {ex.Message}";
            Toast.ShowError(saveMessage);
            /* Console.WriteLine($"[SAVE] EXCEPTION: {ex.GetType().Name}: {ex.Message}") */;
            /* Console.WriteLine($"[SAVE] StackTrace: {ex.StackTrace?.Split('\n').FirstOrDefault()}") */;
        }
        finally
        {
            isSaving = false;
            currentSavingLevel = -1;
            StateHasChanged();

            // Auto-dismiss toast after 3 seconds
            _toastCts?.Cancel();
            _toastCts = new System.Threading.CancellationTokenSource();
            var token = _toastCts.Token;
            _ = Task.Delay(3000, token).ContinueWith(_ =>
            {
                if (!token.IsCancellationRequested)
                {
                    saveMessage = "";
                    InvokeAsync(StateHasChanged);
                }
            }, token);
        }
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/result-search");
    }

    /// <summary>Shows the current saveMessage as a toast, then auto-dismisses after 4 seconds.</summary>
    private void ShowToastThenClear()
    {
        _toastCts?.Cancel();
        _toastCts = new System.Threading.CancellationTokenSource();
        var tok = _toastCts.Token;
        _ = Task.Delay(4000, tok).ContinueWith(_ =>
        {
            if (!tok.IsCancellationRequested)
            {
                saveMessage = "";
                saveError = false;
                InvokeAsync(StateHasChanged);
            }
        }, tok);
    }

    private void TriggerSaveResults(int level)
    {
        if (level == 2)
        {
            var unauthorizedEscalated = lre1.Where(x => IsRowEscalated(x) && (x.resultauthorizedby2 <= 0 || !x.isauthorized2)).ToList();
            if (unauthorizedEscalated.Any())
            {
                int assignedCode = GetAssignedUserCode(unauthorizedEscalated.First().tcode);
                if (assignedCode <= 0 || userCode != assignedCode)
                {
                    pendingEscalatedRows = unauthorizedEscalated;
                    showEscalationAuthModal = true;
                    escalationUserCodeInput = "";
                    escalationModalError = "";
                    StateHasChanged();
                    return;
                }
            }
        }
        
        _ = SaveResults(level);
    }

    private async Task SubmitEscalationAuth()
    {
        if (!int.TryParse(escalationUserCodeInput, out int enteredCode) || enteredCode <= 0)
        {
            escalationModalError = "Please select a valid Pathologist/Doctor.";
            return;
        }

        User_Master? matchedUser = null;
        if (usermaster != null && usermaster.Any())
        {
            matchedUser = usermaster.FirstOrDefault(u => u.usercode == enteredCode);
        }

        if (matchedUser == null)
        {
            matchedUser = usermaster?.FirstOrDefault(u => u.usercode == enteredCode) ?? new User_Master { usercode = enteredCode, name = "User", role = "Admin" };
        }

        if (matchedUser == null)
        {
            escalationModalError = "User Code not found in the system.";
            return;
        }

        int assignedCode = GetAssignedUserCode(pendingEscalatedRows.First().tcode);
        
        var userRole = matchedUser.module ?? matchedUser.role?.ToString() ?? "";
        var roleLower = userRole.Trim().ToLower();
        bool hasAuth2Role = roleLower.Contains("admin") || 
                            roleLower == "2" || 
                            roleLower.Contains("auth2") || 
                            roleLower.Contains("auth 2") || 
                            roleLower.Contains("auth_2") || 
                            roleLower.Contains("auth-2") || 
                            roleLower == "approval" || 
                            enteredCode == 1;

        if (assignedCode > 0 && enteredCode != assignedCode)
        {
            escalationModalError = $"User '{matchedUser.name}' is not the assigned Pathologist/Doctor (User Code: {assignedCode}) for these escalated tests.";
            return;
        }
        else if (assignedCode <= 0 && !hasAuth2Role)
        {
            escalationModalError = $"User '{matchedUser.name}' does not have permission to perform Auth 2 (Level 2 Authorization).";
            return;
        }

        foreach (var row in pendingEscalatedRows)
        {
            row.resultauthorizedby2 = enteredCode;
            row.isauthorized2 = true;
        }

        showEscalationAuthModal = false;
        StateHasChanged();

        await SaveResults(2);
    }


