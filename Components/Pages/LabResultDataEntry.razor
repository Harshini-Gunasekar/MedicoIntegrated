                                                        <img src="@rowImgData.base64Data" style="max-height: 28px; max-width: 50px; object-fit: contain; border-radius: 3px; border: 1px solid #a5b4fc;" title="Attached Image Preview" />
                                                        <span style="font-size: 0.75rem; font-weight: 700; color: #3730a3; max-width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@it.image_path</span>
                                                        <button class="re-clear-search" style="border:none; background:none; color:#ef4444; padding:0 2px; cursor:pointer;" title="Remove Image" @onclick="@(() => RemoveRowImage(it))" @onclick:stopPropagation>
                                                            <i class="fas fa-times" style="font-size: 0.65rem;"></i>
                                                        </button>
