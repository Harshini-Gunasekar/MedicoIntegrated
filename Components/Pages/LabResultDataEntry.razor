    private string CleanBase64String(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        var s = raw.Trim();
        if (s.StartsWith("\"") && s.EndsWith("\""))
        {
            try { s = JsonConvert.DeserializeObject<string>(s) ?? s.Trim('"'); }
            catch { s = s.Trim('"'); }
        }
        if (s.StartsWith("{") && s.EndsWith("}"))
        {
            try
            {
                var jObj = Newtonsoft.Json.Linq.JObject.Parse(s);
                var token = jObj["data"] ?? jObj["result"] ?? jObj["pdf"] ?? jObj["report"] ?? jObj["file"];
                if (token != null) s = token.ToString();
            }
            catch { }
        }
        if (s.StartsWith("data:application/pdf;base64,"))
        {
            s = s.Substring("data:application/pdf;base64,".Length);
        }
        return s.Trim();
    }

    private async Task<string> FetchReportBase64()
    {
        if (string.IsNullOrEmpty(RequestGuid)) return "";

        bool isLetterHead = PrintOption == "LetterHead";

        // Strategy 1: Post via RoutineReportDto to Report/LabReport (Primary RDLC engine)
        try
        {
            int entId = lre1.FirstOrDefault(x => x.resultenteredby > 0)?.resultenteredby ?? userCode;
            int auth1Id = lre1.FirstOrDefault(x => x.resultauthorizedby > 0)?.resultauthorizedby ?? 0;
            int auth2Id = lre1.FirstOrDefault(x => x.resultauthorizedby2 > 0)?.resultauthorizedby2 ?? 0;

            var nameEnt = usermaster?.FirstOrDefault(x => x.usercode == entId)?.name ?? (entId == 1 ? "Admin" : (entId > 0 ? $"Staff ({entId})" : ""));
            var nameAuth1 = usermaster?.FirstOrDefault(x => x.usercode == auth1Id)?.name ?? (auth1Id == 1 ? "Admin" : (auth1Id > 0 ? $"Staff ({auth1Id})" : ""));
            var nameAuth2 = usermaster?.FirstOrDefault(x => x.usercode == auth2Id)?.name ?? (auth2Id == 1 ? "Admin" : (auth2Id > 0 ? $"Staff ({auth2Id})" : ""));

            var parameters = new
            {
                ClientID = tenantCode ?? "",
                DataSource = "DataSet3",
                ReportName = "LabReport.rdlc",
                RequestGUID = RequestGuid,
                TCode = "",
                IsAuthorized2Finished = isAuth2Finished,
                QueryString = $"SampleID={RequestGuid}",
                Parameters = new List<ReportParameterDto>
                {
                    new ReportParameterDto { Name = "RequestGUID", Values = new List<string> { RequestGuid } },
                    new ReportParameterDto { Name = "tcode", Values = new List<string> { "" } },
                    new ReportParameterDto { Name = "IsLetterHead", Values = new List<string> { isLetterHead ? "true" : "false" } },
                    new ReportParameterDto { Name = "EnteredBy", Values = new List<string> { nameEnt } },
                    new ReportParameterDto { Name = "AuthorizedBy1", Values = new List<string> { nameAuth1 } },
                    new ReportParameterDto { Name = "AuthorizedBy2", Values = new List<string> { nameAuth2 } }
                }
            };

            var client = ClientFactory.CreateClient("MedicoAPI");
            var resMsg = await client.PostAsJsonAsync("api/Report/LabReport", parameters);
            var postRes = await resMsg.Content.ReadAsStringAsync();
            string cleaned = CleanBase64String(postRes);
            if (!string.IsNullOrEmpty(cleaned) && cleaned.Length >= 50)
            {
                return cleaned;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FETCH-REPORT] Strategy 1 POST failed: {ex.Message}");
        }

        // Strategy 2: GET endpoint report/labreport?requestguid=...
        try
        {
            string endpoint = $"{""}report/labreport?requestguid={RequestGuid}&isletterhead={isLetterHead.ToString().ToLower()}";
            var request = new HttpRequestMessage(HttpMethod.Get, endpoint);

            var userResult = await sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
            if (userResult.Success && userResult.Value != null)
            {
                var user = userResult.Value;
                if (!string.IsNullOrEmpty(user.TenantCode))
                    request.Headers.Add("tenant_code", user.TenantCode);
                if (!string.IsNullOrEmpty(user.AuthToken))
                    request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", user.AuthToken);
            }

            var resp = await ClientFactory.CreateClient("Medico").SendAsync(request);
            if (resp.IsSuccessStatusCode)
            {
                var raw = await resp.Content.ReadAsStringAsync();
                string cleaned = CleanBase64String(raw);
                if (!string.IsNullOrEmpty(cleaned) && cleaned.Length >= 50)
                {
                    return cleaned;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FETCH-REPORT] Strategy 2 GET failed: {ex.Message}");
        }

        return "";
    }

    private async Task PrintReportViaApp()
    {
        if (string.IsNullOrEmpty(RequestGuid)) return;

        try
        {
            isPrintingViaApp = true;
            saveError = false;
            saveMessage = "";
            StateHasChanged();

            await EnsureSampleCollectionAndReceive();

            bool isAdminUser = userCode == 1 || (isentered && isauthorized1 && isauthorized2);
            int saveLevel = (isauthorized1 || isauthorized2 || isAdminUser) ? 1 : 0;
            await SaveResults(saveLevel);

            if (saveError)
            {
                Toast.ShowError(saveMessage);
                return;
            }

            string base64 = await FetchReportBase64();

            if (!string.IsNullOrEmpty(base64) && base64.Length >= 50)
            {
                await JSRuntime.InvokeVoidAsync("openBase64Pdf", base64);
            }
            else
            {
                saveError = true;
                saveMessage = "Print failed: Report generation returned empty data.";
                Toast.ShowError(saveMessage);
            }
        }
        catch (Exception ex)
        {
            saveError = true;
            saveMessage = $"Print error: {ex.Message}";
            Toast.ShowError(saveMessage);
        }
        finally
        {
            isPrintingViaApp = false;
            StateHasChanged();
        }
    }

