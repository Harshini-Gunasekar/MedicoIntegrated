                    // Prioritize lab-prefixed collections from API, fallback to master
                    var textFromApi = (detailedData?.labtextnormalvalues?.Any() == true) 
                        ? detailedData.labtextnormalvalues.Select(x => new Lab_Result_TextNormalValues { trtid = x.trtid, testresultid = x.testresultid, sex = x.sex, normalvalue = x.normalvalue }).ToList() 
                        : (detailedData?.textnormalvalues?.Select(x => new Lab_Result_TextNormalValues { trtid = x.trtid, testresultid = x.testresultid, sex = x.sex, normalvalue = x.normalvalue }).ToList() ?? new());
                    if (textFromApi.Any())
                    {
                        row.textnormalvalues = textFromApi;
                    }
                    else if (row.textnormalvalues == null || !row.textnormalvalues.Any())
                    {
                        if (_testConfigs.TryGetValue(row.tcode, out var cfgT) && cfgT.ResultRows != null)
