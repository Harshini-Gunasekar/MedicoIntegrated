    private void SyncRowToUI(LabResultEntry row)
    {
        // Normalize type names from database to match the select dropdown options
        var rawType = row.resultvaluetype?.Trim();
        if (string.IsNullOrEmpty(rawType))
        {
            rawType = "Text";
        }
        else if (rawType.Equals("FixedText", StringComparison.OrdinalIgnoreCase) || rawType.Equals("Fixed Value", StringComparison.OrdinalIgnoreCase) || rawType.Equals("FixedType", StringComparison.OrdinalIgnoreCase))
        {
            rawType = "Fixed Type";
        }
        else if (rawType.Equals("Calculated", StringComparison.OrdinalIgnoreCase) || rawType.Equals("CalculatedValue", StringComparison.OrdinalIgnoreCase))
        {
            rawType = "Calculated Value";
        }
        else if (rawType.Equals("Text and Number", StringComparison.OrdinalIgnoreCase) || rawType.Equals("TextAndNumber", StringComparison.OrdinalIgnoreCase))
        {
            rawType = "Text & Number";
        }
        
        row.resultvaluetype = rawType;
        resulttype = rawType;
        ResultText = row.enteredresult;
        AlertType = row.resulthigh ? "High" : (row.resultlow ? "Low" : "Normal");
        PrintResultsOnly = row.printresultonly;
        IsResultBold = row.estylecode == 1;
        SelectedUnit = row.unitname;
        NormalValueText = row.normalvalue;
        // Bind SelectedMethod to rtmcode, defaulting to 0 (nothing) if unspecified
        SelectedMethod = row.rtmcode > 0 ? row.rtmcode.ToString() : "0";
        DetailedNormalRange = row.detailednv;
        FixedResultSelect = row.enteredresult;
        decimalvalue = row.decimalvalue;
        ShowAlertLowerHigher = row.showalertonhigherlower;
        ReferenceValueText = row.normalvalue ?? "";
        IsAuthorizedRow = row.isauthorized1;
        FooterMessageText = StripHtml(row.footermessage ?? "");
        // Guard: if conclusionforfixedtext is a raw UUID (testresultid mistakenly stored as conclusion text), ignore it
        string rawConclusion = row.conclusionforfixedtext ?? "";
        bool conclusionIsUuid = Guid.TryParse(rawConclusion, out _);
        if (conclusionIsUuid) rawConclusion = "";

        ConclusionText = StripHtml(!string.IsNullOrEmpty(rawConclusion) ? rawConclusion : (!string.IsNullOrEmpty(row.conclusionforhigher) ? row.conclusionforhigher : (row.conclusionforlower ?? "")));

        printconclusioninreport = row.printconclusioninreport;

        if (string.IsNullOrWhiteSpace(ConclusionText) && string.IsNullOrWhiteSpace(FooterMessageText))
        {
            if (row.tcode > 0 && _testConfigs.TryGetValue(row.tcode, out var cfgMaster))
            {
                string masterTxt = cfgMaster.TestMaster?.footer ?? "";
                if (string.IsNullOrWhiteSpace(masterTxt) && cfgMaster.ResultRows != null && cfgMaster.ResultRows.Any())
                {
                    var matchedProp = cfgMaster.ResultRows.FirstOrDefault(r => r.ResultMaster?.testresultid == row.testresultid && !string.IsNullOrWhiteSpace(r.ResultProperties?.conclusionforfixedtext) && !Guid.TryParse(r.ResultProperties?.conclusionforfixedtext, out _))?.ResultProperties 
                                      ?? cfgMaster.ResultRows.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.ResultProperties?.conclusionforfixedtext) && !Guid.TryParse(r.ResultProperties?.conclusionforfixedtext, out _))?.ResultProperties
                                      ?? cfgMaster.ResultRows.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.ResultProperties?.footermessage))?.ResultProperties;
                    masterTxt = (!string.IsNullOrWhiteSpace(matchedProp?.conclusionforfixedtext) && !Guid.TryParse(matchedProp?.conclusionforfixedtext, out _)) ? matchedProp.conclusionforfixedtext : (matchedProp?.footermessage ?? "");

                }
                if (!string.IsNullOrWhiteSpace(masterTxt))
                {
                    ConclusionText = StripHtml(masterTxt);
                    row.conclusionforfixedtext = ConclusionText;
                    printconclusioninreport = true;
                    row.printconclusioninreport = true;
                }
            }
        }

        // Ensure edited collections are initialized with a copy of database values
        if (row.EditedTextNormalValues == null || !row.EditedTextNormalValues.Any())
        {
            row.EditedTextNormalValues = row.textnormalvalues?.Select(x => new Lab_Result_TextNormalValues { trtid = x.trtid, testresultid = x.testresultid, sex = x.sex, normalvalue = x.normalvalue }).ToList() ?? new();
        }
        if (row.EditedDetailedNormalValues == null || !row.EditedDetailedNormalValues.Any())
        {
            row.EditedDetailedNormalValues = row.detailednormalvalues?.Select(x => new Lab_Result_DetailedNormalValues { dnvid = x.dnvid, trdnid = x.trdnid ?? x.dnvid, testresultid = x.testresultid, sno = x.sno, agefrom = x.agefrom, agefromtype = x.agefromtype, ageto = x.ageto, agetotype = x.agetotype, agerangetype = x.agerangetype, sex = x.sex, rangetype = x.rangetype, rangefrom = x.rangefrom, rangeto = x.rangeto, specialconditioncode = x.specialconditioncode }).ToList() ?? new();
        }
        if (row.EditedCalculatedFormulas == null || !row.EditedCalculatedFormulas.Any())
        {
            row.EditedCalculatedFormulas = row.calculatedformulas?.Select(x => new Lab_Result_CalculatedFormula { trcfid = x.trcfid, testresultid = x.testresultid, sex = x.sex, calculatedformula = x.calculatedformula }).ToList() ?? new();
        }

        // Self-correct NormalValueText and ReferenceValueText from detailednormalvalues if present
        if (row.detailednormalvalues?.Any() == true)
        {
            var finalNormalValue = FormatNormalValueFromDetailed(row.detailednormalvalues);
            if (!string.IsNullOrEmpty(finalNormalValue))
            {
                row.normalvalue = finalNormalValue;
                NormalValueText = finalNormalValue;
                ReferenceValueText = finalNormalValue;
                FixedNormalValueSelect = finalNormalValue;
            }
        }

        // Populate modal signatures with robust current user fallback
        modalEnt = usermaster.FirstOrDefault(x => x.usercode == row.resultenteredby)?.name ?? 
                   (row.resultenteredby == 1 ? "Admin" : 
                   (row.resultenteredby == userCode && !string.IsNullOrEmpty(currentUserName) ? currentUserName : 
                   (row.resultenteredby > 0 ? $"Staff ({row.resultenteredby})" : "")));
        
        modalAuth1 = usermaster.FirstOrDefault(x => x.usercode == row.resultauthorizedby)?.name ?? 
                    (row.resultauthorizedby == 1 ? "Admin" : 
                    (row.resultauthorizedby == userCode && !string.IsNullOrEmpty(currentUserName) ? currentUserName : 
                    (row.resultauthorizedby > 0 ? $"Staff ({row.resultauthorizedby})" : "")));
        
        modalAuth2 = usermaster.FirstOrDefault(x => x.usercode == row.resultauthorizedby2)?.name ?? 
                    (row.resultauthorizedby2 == 1 ? "Admin" : 
                    (row.resultauthorizedby2 == userCode && !string.IsNullOrEmpty(currentUserName) ? currentUserName : 
                    (row.resultauthorizedby2 > 0 ? $"Staff ({row.resultauthorizedby2})" : "")));
    }

    private void UpdateNormalValueFromDetailedText()
    {
        if (SelectedRowEntry != null && SelectedRowEntry.EditedTextNormalValues != null)
        {
            var nvParts = SelectedRowEntry.EditedTextNormalValues
                .Where(x => !string.IsNullOrEmpty(x.normalvalue))
                .Select(x =>
                {
                    if (string.IsNullOrEmpty(x.sex)) return x.normalvalue!;
                    var sex = x.sex.Trim();
                    var label = (sex.Equals("M", StringComparison.OrdinalIgnoreCase) || sex.Equals("Male", StringComparison.OrdinalIgnoreCase)) ? "Males" :
                                (sex.Equals("F", StringComparison.OrdinalIgnoreCase) || sex.Equals("Female", StringComparison.OrdinalIgnoreCase)) ? "Females" :
                                sex.Equals("Both", StringComparison.OrdinalIgnoreCase) ? "" : sex;
                    return string.IsNullOrEmpty(label) ? x.normalvalue! : $"{label} : {x.normalvalue}";
                });
            SelectedRowEntry.normalvalue = string.Join(" | ", nvParts);
            StateHasChanged();
        }
    }

    private string newTextNormalValueSex = "Both";
    private string newTextNormalValueText = "";

    private void AddNewTextNormalValue()
    {
        if (SelectedRowEntry != null)
        {
            if (SelectedRowEntry.EditedTextNormalValues == null) SelectedRowEntry.EditedTextNormalValues = new();
            SelectedRowEntry.EditedTextNormalValues.Add(new Lab_Result_TextNormalValues
            {
                trtid = Guid.NewGuid(),
                testresultid = SelectedRowEntry.testresultid,
                sex = newTextNormalValueSex,
                normalvalue = newTextNormalValueText ?? ""
            });
            newTextNormalValueText = "";
            UpdateNormalValueFromDetailedText();
        }
    }

    private void CloseRowDetail()
    {
        if (SelectedRowEntry != null)
        {
            // Sync changes back to lre1 (master list) to ensure rtmcode and other changes are persisted
            var masterRow = lre1?.FirstOrDefault(x => x.testresultid == SelectedRowEntry.testresultid);
            if (masterRow != null)
            {
                // Sync rtmcode first
                masterRow.rtmcode = SelectedRowEntry.rtmcode;
                
                // Clean up method name from normalvalue so method string is not embedded into normalvalue
                if (SelectedRowEntry.normalvalue != null)
                {
                    string cleanedValue = SelectedRowEntry.normalvalue;
                    cleanedValue = System.Text.RegularExpressions.Regex.Replace(cleanedValue, @"\s*/\s*\([^)]*\)\s*$", "");
                    cleanedValue = System.Text.RegularExpressions.Regex.Replace(cleanedValue, @"^\([^)]*\)\s*", "");
                    if (cleanedValue.StartsWith("(") && cleanedValue.EndsWith(")")) cleanedValue = "";
                    masterRow.normalvalue = cleanedValue.Trim();
                }
                else
                {
                    masterRow.normalvalue = SelectedRowEntry.normalvalue;
                }
                
                // Sync other important fields back to the master list
                masterRow.unitname = SelectedRowEntry.unitname;
                masterRow.defaultunitscode = SelectedRowEntry.defaultunitscode;
                masterRow.calculatedformula = SelectedRowEntry.calculatedformula;
                masterRow.resultvaluetype = SelectedRowEntry.resultvaluetype;
                masterRow.footermessage = SelectedRowEntry.footermessage;
                masterRow.conclusionforfixedtext = SelectedRowEntry.conclusionforfixedtext;
                masterRow.conclusionforhigher = SelectedRowEntry.conclusionforhigher;
                masterRow.conclusionforlower = SelectedRowEntry.conclusionforlower;
                masterRow.printconclusioninreport = SelectedRowEntry.printconclusioninreport;
                masterRow.printconclusioninbottom = SelectedRowEntry.printconclusioninbottom;
                masterRow.textnormalvalues = SelectedRowEntry.textnormalvalues;
                masterRow.detailednormalvalues = SelectedRowEntry.detailednormalvalues;
                masterRow.calculatedformulas = SelectedRowEntry.calculatedformulas;
            }
        }
        SelectedRowEntry = null;
        isRowDetailOpen = false;
    }

