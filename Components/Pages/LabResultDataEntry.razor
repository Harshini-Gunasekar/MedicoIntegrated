                                            <button type="button" style="border: none; background: none; color: #ef4444; cursor: pointer; padding: 2px 4px;" title="Remove Row Image" @onclick="@(() => RemoveRowImage(SelectedRowEntry))">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Section: Reference Value -->
                            <div style="margin-top: 16px;">
                                <label class="re-label" style="display: block; margin-bottom: 8px;">Reference Value</label>
                                <textarea class="re-textarea" rows="3" @bind="ReferenceValueText" placeholder="Enter reference value..."></textarea>
                            </div>

                            <!-- Section: Age Based Reference Table -->
                            @if (DetailedNormalRange || (resulttype == "Number" || resulttype == "Calculated Value" || resulttype == "Text & Number"))
                            {
                                <div class="re-nv-table-container" style="margin-top: 16px;">
                                    <div class="re-nv-header" style="background: #f1f5f9; font-weight: 700; font-size: 0.85rem;">
                                        Age Based Reference
                                    </div>
                                    <div style="max-height: 250px; overflow-y: auto; border: 1px solid #e2e8f0; border-top: none;">
                                        <table class="re-nv-mini-table" style="border: none; table-layout: fixed;">
                                            <thead style="position: sticky; top: 0; background: #f8fafc; z-index: 1;">
                                                <tr>
                                                    <th style="width: 25px;"></th>
                                                    <th style="width: 60px;">From</th>
                                                    <th style="width: 60px;">To</th>
                                                    <th style="width: 70px;">sex</th>
                                                    <th style="width: 60px;">RangeF</th>
                                                    <th style="width: 60px;">RangeT</th>
                                                    <th style="width: 80px;">Condition</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (SelectedRowEntry?.EditedDetailedNormalValues != null)
                                                {
                                                    @foreach (var dnv in SelectedRowEntry.EditedDetailedNormalValues)
                                                    {
                                                         var isSelected = dnv.dnvid == SelectedDnvId;
                                                         var rowStyle = isSelected ? "background: #eff6ff; border-left: 3px solid #6366f1;" : "";
                                                         <tr class="re-nv-row" style="@rowStyle">
                                                             <td style="cursor: pointer;" @onclick="() => SetDetailedNormalValue(dnv)">
                                                                  <i class="fas fa-caret-right" style="font-size: 0.7rem; color: @(isSelected ? "#6366f1" : "#94a3b8");"></i>
                                                             </td>
                                                            <td><input type="number" class="re-grid-input" value="@dnv.agefrom" @oninput="@(e => { int.TryParse(e.Value?.ToString(), out var val); dnv.agefrom = val; })" @onclick:stopPropagation /></td>
                                                            <td><input type="number" class="re-grid-input" value="@dnv.ageto" @oninput="@(e => { int.TryParse(e.Value?.ToString(), out var val); dnv.ageto = val; })" @onclick:stopPropagation /></td>
                                                            <td>
                                                                <select class="re-grid-input" value="@dnv.sex" @onchange="@(e => { dnv.sex = e.Value?.ToString() ?? "Both"; })" @onclick:stopPropagation>
                                                                    <option value="Both">Both</option>
                                                                    <option value="Male">Male</option>
                                                                    <option value="Female">Female</option>
                                                                </select>
                                                            </td>
                                                            <td><input type="number" class="re-grid-input" value="@dnv.rangefrom" @oninput="@(e => { double.TryParse(e.Value?.ToString(), out var val); dnv.rangefrom = val; })" @onclick:stopPropagation /></td>
                                                            <td><input type="number" class="re-grid-input" value="@dnv.rangeto" @oninput="@(e => { double.TryParse(e.Value?.ToString(), out var val); dnv.rangeto = val; })" @onclick:stopPropagation /></td>
                                                            <td><input type="text" class="re-grid-input" value="@dnv.rangetype" @oninput="@(e => { dnv.rangetype = e.Value?.ToString(); })" @onclick:stopPropagation /></td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                        <button class="re-btn-add-nv" @onclick="AddNewDetailedRange">
                                            <i class="fas fa-plus"></i> Add New Range
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Panel Footer Buttons -->
                        <div class="re-panel-footer">
                            <button class="re-btn-outline" @onclick="() => IsDetailedNormalValuesVisible = false">Close</button>
                            <button class="re-btn-primary" @onclick="UpdateRowSettings">
                                <i class="fas fa-check"></i> Apply
                            </button>
                        </div>
                    }
                    else if (RightTab == "Comments")
                    {
                        <div class="re-rp-content">
                            <!-- Comments section -->
                            <div class="re-form-group">
                                <label class="re-label">Footer Message</label>
                                <SFRichTextEditor @bind-Value="FooterMessageText" Placeholder="Enter footer message..." />
                            </div>
                            <div class="re-form-group" style="margin-bottom: 4px;">
                                <label class="re-check-label">
                                    <input type="checkbox" @bind="printconclusioninreport" />
                                    Print Conclusion In Report
                                </label>
                            </div>
                            <div class="re-form-group">
                                <label class="re-label">Conclusion</label>
                                <SFRichTextEditor @bind-Value="ConclusionText" Placeholder="Enter conclusion..." />
                            </div>
                        </div>
                    }

                    <div class="re-rp-footer">
                        <span class="re-label" style="margin: 0; text-transform: none; font-size: 0.85rem;">Sample</span>
                        <select class="re-select" style="flex-grow: 1;" @bind="BottomSample">
                            <option value=""></option>
                        </select>
                        <button class="re-btn-update" @onclick="UpdateRowSettings">Update</button>
                    </div>
                }
                </div>
            }
    </div>
</div>
<!-- Save status Toast -->
@if (isSaving)
{
    <div class="re-saving-overlay">
        <span class="re-save-spinner" style="width:18px;height:18px;border-width:3px;"></span>
        <span>Saving results to server...</span>
    </div>
}
else if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="re-save-toast @(saveError ? "error" : "success")">
        <i class="fas @(saveError ? "fa-exclamation-circle" : "fa-check-circle")"></i>
        @saveMessage
    </div>
}

@if (showEscalationAuthModal)
{
    <div class="re-esc-modal-overlay">
        <div class="re-esc-modal-card">
            <div class="re-esc-modal-header">
                <i class="fas fa-exclamation-triangle" style="font-size: 1.4rem;"></i>
                <h3 class="re-esc-modal-title">Escalation Authorization Required</h3>
            </div>
            <div class="re-esc-modal-body">
                <p style="margin: 0 0 8px 0; font-weight: 600; color: #0f172a;">This report contains escalated tests:</p>
                <ul style="margin: 0 0 16px 0; padding-left: 20px; color: #475569; font-size: 0.85rem;">
                    @foreach (var row in pendingEscalatedRows)
                    {
                        <li><strong>@row.col2</strong> (Assigned Pathologist Code: @GetAssignedUserCode(row.tcode))</li>
                    }
                </ul>
                <p style="margin: 0;">Please select the Pathologist/Doctor to approve and authorize these Level 2 results:</p>
                <select class="re-esc-modal-input" @bind="escalationUserCodeInput">
                    <option value="">-- Select Pathologist/Doctor --</option>
                    @if (usermaster != null)
                    {
                        @foreach (var user in usermaster.Where(u => u.usercode > 0))
                        {
                            <option value="@user.usercode">@user.name (Code: @user.usercode)</option>
                        }
                    }
                </select>
                @if (!string.IsNullOrEmpty(escalationModalError))
                {
                    <div class="re-esc-modal-error">@escalationModalError</div>
                }
            </div>
            <div class="re-esc-modal-footer">
                <button class="re-btn-action" style="background: #f1f5f9; border: 1px solid #cbd5e1; color: #475569;" @onclick="() => showEscalationAuthModal = false">Cancel</button>
                <button class="re-btn-action re-btn-action-primary" style="background: #e11d48; border-color: #e11d48;" @onclick="SubmitEscalationAuth">Authorize & Save</button>
            </div>
        </div>
    </div>
}

<!-- Fixed Footer Bar -->
<div class="re-footer-bar re-footer-centered">
    <button class="re-btn-action" id="btn-clear-entry" @onclick="ClearEntry">
        <i class="fas fa-times-circle"></i> Clear
    </button>
    @if (lre1 != null && lre1.Any())
    {
        <!-- Save Button -->
        <button class="re-btn-action re-btn-action-primary @(isSaving && currentSavingLevel == 0 ? "re-btn-saving" : "")" id="btn-save-entry"
                @onclick="() => SaveResults(0)" 
                disabled="@(isSaving || isviewer)"
                title="Save Entered Results">
            @if (isSaving && currentSavingLevel == 0)
            {
                <span class="re-save-spinner"></span>
                <span>Saving...</span>
            }
            else
            {
                <i class="fas fa-save"></i>
                <span>Save</span>
            }
        </button>

        <!-- Authorize 1 Button -->
        <button class="re-btn-action re-btn-action-info @(isSaving && currentSavingLevel == 1 ? "re-btn-saving" : "")" id="btn-auth1-entry"
                @onclick="() => SaveResults(1)" 
                disabled="@(isSaving || isviewer)"
                title="Authorize Level 1 Results">
            @if (isSaving && currentSavingLevel == 1)
            {
                <span class="re-save-spinner"></span>
                <span>Authorizing...</span>
            }
            else
            {
                <i class="fas fa-check-double"></i>
                <span>Authorize 1</span>
            }
        </button>

        <!-- Authorize 2 Button -->
        <button class="re-btn-action re-btn-action-success @(isSaving && currentSavingLevel == 2 ? "re-btn-saving" : "")" id="btn-auth2-entry"
                @onclick="() => TriggerSaveResults(2)" 
                disabled="@(isSaving || isviewer)"
                title="Authorize Level 2 Results">
            @if (isSaving && currentSavingLevel == 2)
            {
                <span class="re-save-spinner"></span>
                <span>Authorizing...</span>
            }
            else
            {
                <i class="fas fa-shield-alt"></i>
                <span>Authorize 2</span>
            }
        </button>

        <!-- Letterhead Option -->
        <label class="re-check-label" style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 600; color: #475569; padding: 8px 14px; background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 8px; user-select: none; transition: all 0.2s;" title="Toggle Letterhead (true/false) for report preview and print">
            <input type="checkbox" checked="@IsLetterHeadEnabled" @onchange="@(e => IsLetterHeadEnabled = (bool)(e.Value ?? true))" style="cursor: pointer; width: 16px; height: 16px; accent-color: #6366f1;" />
            <span>Letterhead: <strong style="color: @(IsLetterHeadEnabled ? "#16a34a" : "#dc2626");">@(IsLetterHeadEnabled ? "True" : "False")</strong></span>
        </label>

        <!-- Proof Image Upload Button & Preview -->
        <div style="display: inline-flex; align-items: center; gap: 8px;">
            <label class="re-btn-action" style="background: #ffffff; color: #475569; border: 1.5px solid #cbd5e1; cursor: pointer; margin: 0; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; border-radius: 8px;" title="Attach proof image or report document">
                <i class="fas fa-paperclip" style="color: #6366f1;"></i>
                <span>@(string.IsNullOrEmpty(reportImageFileName) ? "Attach Image" : "Change Image")</span>
                <InputFile OnChange="UploadReportImage" accept="image/*,.pdf" style="display: none;" />
            </label>
            @if (!string.IsNullOrEmpty(reportImageBase64))
            {
                <div style="display: flex; align-items: center; gap: 6px; background: #f1f5f9; padding: 6px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 0.8rem; color: #1e293b;">
                    @if (reportImageBase64.StartsWith("data:image"))
                    {
                        <img src="@reportImageBase64" alt="Proof" style="width: 24px; height: 24px; object-fit: cover; border-radius: 4px;" />
                    }
                    else
                    {
                        <i class="fas fa-file-pdf" style="color: #ef4444; font-size: 1.1rem;"></i>
                    }
                    <span style="max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600;">@reportImageFileName</span>
                    <button type="button" @onclick="RemoveReportImage" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 2px 4px; font-size: 0.85rem;" title="Remove attached image">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            }
        </div>

        <!-- Preview Button -->
        <button class="re-btn-action" id="btn-preview-entry" 
                @onclick="PrintReportExternal"
                disabled="@(isSaving || string.IsNullOrEmpty(RequestGuid))"
                title="Preview Lab Report PDF">
            @if (isPrinting)
            {
                <span class="re-save-spinner"></span>
                <span>Previewing...</span>
            }
            else
            {
                <i class="fas fa-eye"></i>
                <span>Preview</span>
            }
        </button>

        <!-- Print Report Button -->
        <button class="re-btn-action" id="btn-print-entry" 
                style="background: #2563eb; color: white; border: none; font-weight: 700; box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);"
                @onclick="PrintReportViaApp"
                disabled="@(isSaving || isPrintingViaApp || string.IsNullOrEmpty(RequestGuid))"
                title="Print Lab Report PDF">
            @if (isPrintingViaApp)
            {
                <span class="re-save-spinner"></span>
                <span>Printing...</span>
            }
            else
            {
                <i class="fas fa-print"></i>
                <span>Print Report</span>
            }
        </button>

    }
</div>
@if (isviewer)
{
    <div class="re-modal-overlay show" style="display: flex; align-items: center; justify-center: center;">
        <div class="re-modal-panel" style="width: 80%; height: 80%; display: flex; flex-direction: column;">
            <div class="re-modal-header">
                <h3>Result Entry</h3>
                <button type="button" class="re-btn-icon" @onclick="CloseViewer"><i class="fas fa-times"></i></button>
            </div>
            <div class="re-modal-content" style="flex: 1; overflow: auto; padding: 20px;">
                @if (string.IsNullOrEmpty(reportstring))
                {
                    <div style="text-align:center;">Loading report...</div>
                }
                else
                {
                    <iframe src="data:application/pdf;base64,@reportstring" style="width: 100%; height: 80vh;" frameborder="0"></iframe>
                }
            </div>
        </div>
    </div>
}


@if (isRowDetailOpen && SelectedRowEntry != null)
{
    <div class="re-modal-overlay" @onclick="CloseRowDetail"></div>
    <div class="re-modal re-row-detail-modal" style="width: 700px; max-width: 95vw;">
        <div class="re-modal-titlebar">
            <span><i class="fas fa-info-circle" style="color:#6366f1;margin-right:6px;"></i>Row Details</span>
            <button type="button" @onclick="CloseRowDetail" title="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="re-modal-tabs" style="display: flex; background: #f1f5f9; border-bottom: 1px solid #e2e8f0; padding: 0 12px;">
            <button class="re-tab-btn @(activeModalTab == "Settings" ? "active" : "")" @onclick='() => activeModalTab = "Settings"' 
                    style="padding: 10px 16px; border: none; background: none; font-weight: 600; color: @(activeModalTab == "Settings" ? "#4f46e5" : "#64748b"); border-bottom: 2px solid @(activeModalTab == "Settings" ? "#4f46e5" : "transparent"); cursor: pointer;">
                Settings
            </button>
            @if (SelectedRowEntry.resultvaluetype != "Title" && SelectedRowEntry.resultvaluetype != "SubTitle")
            {
                <button class="re-tab-btn @(activeModalTab == "Comments" ? "active" : "")" @onclick='() => activeModalTab = "Comments"' 
                        style="padding: 10px 16px; border: none; background: none; font-weight: 600; color: @(activeModalTab == "Comments" ? "#4f46e5" : "#64748b"); border-bottom: 2px solid @(activeModalTab == "Comments" ? "#4f46e5" : "transparent"); cursor: pointer;">
                    Comments
                </button>
            }
        </div>

        <div class="re-modal-body re-row-detail-body" style="padding: 20px; max-height: 70vh; overflow-y: auto;">
            @if (activeModalTab == "Settings")
            {
                <div class="re-rd-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="re-rd-field" style="grid-column: span 2;">
                        <span class="re-label">Result Type</span>
                        <select class="re-select" @bind="PopupResultType">
                            <option value="Text">Text</option>
                            <option value="Text & Number">Text &amp; Number</option>
                            <option value="Fixed Type">Fixed Type</option>
                            <option value="Number">Number</option>
                            <option value="Calculated Value">Calculated Value</option>
                            <option value="Title">Title</option>
                            <option value="SubTitle">SubTitle</option>
                        </select>
                    </div>

                    @if (SelectedRowEntry.resultvaluetype != "Title" && SelectedRowEntry.resultvaluetype != "SubTitle")
                    {
                        @if (SelectedRowEntry.resultvaluetype == "Fixed Type")
                        {
                            <div class="re-rd-field">
                                <span class="re-label">Value</span>
                                <div style="display: flex; gap: 4px;">
                                    <input type="text" class="re-input" @bind="SelectedRowEntry.defaultvalue" />
                                    <button class="re-btn-outline" style="padding: 4px 8px;">...</button>
                                </div>
                            </div>
                            <div class="re-rd-field">
                                <span class="re-label">Result</span>
                                <select class="re-select" @bind="SelectedRowEntry.enteredresult">
                                    <option value=""></option>
                                    @if (!string.IsNullOrEmpty(SelectedRowEntry.fixedvalues))
                                    {
                                        @foreach (var opt in SelectedRowEntry.fixedvalues.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <option value="@opt.Trim()">@opt.Trim()</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="Clear">Clear</option>
                                        <option value="Cloudy">Cloudy</option>
                                        <option value="Turbid">Turbid</option>
                                        <option value="Slight Turbid">Slight Turbid</option>
                                        <option value="Slightly Cloudy">Slightly Cloudy</option>
                                        <option value="Yellow">Yellow</option>
                                        <option value="Pale Yellow">Pale Yellow</option>
                                        <option value="Positive">Positive</option>
                                        <option value="Negative">Negative</option>
                                        <option value="Reactive">Reactive</option>
                                        <option value="Non-Reactive">Non-Reactive</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="re-rd-field" style="grid-column: span 2;">
                                <span class="re-label">Result</span>
                                <textarea class="re-input" @bind="SelectedRowEntry.enteredresult" rows="3"></textarea>
                            </div>
                        }

                        <div class="re-rd-field" style="grid-column: span 2;">
                            <span class="re-label">Alert</span>
                            <div style="display: flex; gap: 16px; align-items: center;">
                                <label class="re-radio-label"><input type="radio" name="rd-alert" value="Normal" checked="@(SelectedRowEntry.resultnormal)" @onchange='() => SetAlert("Normal")' /> Normal</label>
                                <label class="re-radio-label"><input type="radio" name="rd-alert" value="High" checked="@(SelectedRowEntry.resulthigh)" @onchange='() => SetAlert("High")' /> High</label>
                                <label class="re-radio-label"><input type="radio" name="rd-alert" value="Low" checked="@(SelectedRowEntry.resultlow)" @onchange='() => SetAlert("Low")' /> Low</label>
                                <label class="re-check-label" style="margin-left: auto;">
                                    <input type="checkbox" @bind="SelectedRowEntry.printresultonly" />
                                    <span>Print Results Only</span>
                                </label>
                                <label class="re-check-label" style="margin-left: 16px;">
                                    <input type="checkbox" checked="@(SelectedRowEntry.estylecode == 1)" @onchange="@(e => { SelectedRowEntry.estylecode = ((bool)e.Value) ? 1 : 0; StateHasChanged(); })" />
                                    <span>Bold Result</span>
                                </label>
                            </div>
                        </div>

                        <div class="re-rd-field">
                            <span class="re-label">Units</span>
                            <select class="re-select" @bind="SelectedRowEntry.unitname">
                                <option value=""></option>
                                @foreach (var u in uom) { <option value="@u.name">@u.name</option> }
                            </select>
                        </div>
                        
                        <div class="re-rd-field" style="display: flex; gap: 12px; align-items: flex-end;">
                            <div style="flex: 1;">
                                <span class="re-label">Decimal</span>
                                <input type="number" class="re-input" @bind="SelectedRowEntry.decimalvalue" />
                            </div>
                            @if (SelectedRowEntry.resultvaluetype == "Number" || SelectedRowEntry.resultvaluetype == "Calculated Value")
                            {
                                <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 8px;">
                                    <label class="re-check-label"><input type="checkbox" @bind="SelectedRowEntry.isgraph" /> <span>Graph Value</span></label>
                                    <input type="number" class="re-input" style="width: 60px;" @bind="SelectedRowEntry.graphvalue" />
                                </div>
                            }
                        </div>

                        @if (SelectedRowEntry.resultvaluetype == "Calculated Value")
                        {
                            <div class="re-rd-field" style="grid-column: span 2;">
                                <span class="re-label">Calculation Formula (Edited)</span>
                                <div style="display: flex; flex-direction: column; gap: 8px;">
                                    @if (SelectedRowEntry.EditedCalculatedFormulas != null)
                                    {
                                        @foreach (var f in SelectedRowEntry.EditedCalculatedFormulas)
                                        {
                                            <div style="display: flex; gap: 8px; align-items: center;">
                                                <select class="re-select" style="width: 120px;" @bind="f.sex">
                                                    <option value="Both">Both</option>
                                                    <option value="Male">Male</option>
                                                    <option value="Female">Female</option>
                                                    <option value="Child">Child</option>
                                                </select>
                                                <input type="text" class="re-input" style="flex: 1;" @bind="f.calculatedformula" />
                                                <button class="re-btn-mini re-text-danger" @onclick="() => SelectedRowEntry.EditedCalculatedFormulas.Remove(f)"><i class="fas fa-trash"></i></button>
                                            </div>
                                        }
                                    }
                                    <div style="display: flex; gap: 8px; align-items: center;">
                                        <span style="font-size: 0.7rem; color: #64748b; width: 120px;">Global Formula:</span>
                                        <input type="text" class="re-input" style="flex: 1;" @bind="SelectedRowEntry.calculatedformula" />
                                        <button class="re-btn-mini re-text-primary" @onclick="AddNewCalculatedFormula"><i class="fas fa-plus"></i></button>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="re-rd-field" style="grid-column: span 2;">
                            <span class="re-label">Method</span>
                            <select class="re-select" @onchange="OnMethodChanged" value="@SelectedRowEntry.rtmcode.ToString()">
                                <option value="0"></option>
                                @foreach (var m in method) { <option value="@m.rtmcode">@m.name</option> }
                            </select>
                        </div>

                        @if (SelectedRowEntry.resultvaluetype == "Text" || SelectedRowEntry.resultvaluetype == "Text & Number")
                        {
                            <div class="re-rd-field" style="grid-column: span 2;">
                                <span class="re-label">Normal Value</span>
                                <textarea class="re-input" @bind="SelectedRowEntry.normalvalue" rows="2"></textarea>
                            </div>
                        }
                        else if (SelectedRowEntry.resultvaluetype == "Number" || SelectedRowEntry.resultvaluetype == "Calculated Value")
                        {
                            <div class="re-rd-field" style="grid-column: span 2;">
                                <span class="re-label">Normal Value</span>
                                <input type="text" class="re-input" @bind="SelectedRowEntry.normalvalue" />
                            </div>
                        }

                        @if (SelectedRowEntry.detailednv)
                        {
                            <div class="re-nv-table-container" style="grid-column: span 2; margin-top: 4px; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; background: #fff;">
                                <div style="background: #f8fafc; padding: 4px 10px; border-bottom: 1px solid #e2e8f0; font-size: 0.7rem; font-weight: 700; color: #475569;">
                                    Age Based Reference
                                </div>
                                <div style="max-height: 250px; overflow-y: auto;">
                                    <table class="re-nv-mini-table" style="width: 100%; border-collapse: collapse; font-size: 0.8rem; table-layout: fixed;">
                                        <thead style="background: #f1f5f9; position: sticky; top: 0; z-index: 1;">
                                            <tr>
                                                <th style="padding: 6px; width: 60px;">From</th>
                                                <th style="padding: 6px; width: 60px;">To</th>
                                                <th style="padding: 6px; width: 75px;">sex</th>
                                                <th style="padding: 6px; width: 65px;">RangeF</th>
                                                <th style="padding: 6px; width: 65px;">RangeT</th>
                                                <th style="padding: 6px; width: 85px;">Condition</th>
                                                <th style="padding: 6px; width: 40px; text-align: center;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (SelectedRowEntry.EditedDetailedNormalValues != null)
                                            {
                                                @foreach (var dnv in SelectedRowEntry.EditedDetailedNormalValues)
                                                {
                                                    bool isRowSelected = SelectedDnvId == dnv.dnvid;
                                                    <tr class="re-nv-row" @onclick="() => SetDetailedNormalValue(dnv)" style="cursor: pointer; border-bottom: 1px solid #f1f5f9; background-color: @(isRowSelected ? "#eff6ff" : "transparent");">
                                                        <td style="padding: 4px;">
                                                            <input type="number" class="re-grid-input" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 4px; padding: 2px 4px;" 
                                                                   value="@dnv.agefrom" 
                                                                   @oninput="@(e => { int.TryParse(e.Value?.ToString(), out var val); dnv.agefrom = val; SelectedDnvId = dnv.dnvid; UpdateNormalValueFromDetailedRange(dnv); })" 
                                                                   @onclick:stopPropagation />
                                                        </td>
                                                        <td style="padding: 4px;">
                                                            <input type="number" class="re-grid-input" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 4px; padding: 2px 4px;" 
                                                                   value="@dnv.ageto" 
                                                                   @oninput="@(e => { int.TryParse(e.Value?.ToString(), out var val); dnv.ageto = val; SelectedDnvId = dnv.dnvid; UpdateNormalValueFromDetailedRange(dnv); })" 
                                                                   @onclick:stopPropagation />
                                                        </td>
                                                        <td style="padding: 4px;">
                                                            <select class="re-select" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 4px; padding: 2px 2px; font-size: 0.75rem;" 
                                                                    value="@dnv.sex" 
                                                                    @onchange="@(e => { dnv.sex = e.Value?.ToString() ?? "Both"; SelectedDnvId = dnv.dnvid; UpdateNormalValueFromDetailedRange(dnv); })" 
                                                                    @onclick:stopPropagation>
                                                                <option value="Both">Both</option>
                                                                <option value="Male">Male</option>
                                                                <option value="Female">Female</option>
                                                                <option value="Child">Child</option>
                                                            </select>
                                                        </td>
                                                        <td style="padding: 4px;">
                                                            <input type="number" class="re-grid-input" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 4px; padding: 2px 4px;" 
