    private void ApplyRowDetail()
    {
        if (SelectedRowEntry != null)
        {
            // Ensure method rtmcode and unitname are resolved correctly
            if (SelectedRowEntry.unitname != null)
            {
                var matchedUom = uom?.FirstOrDefault(u => u.name == SelectedRowEntry.unitname);
                if (matchedUom != null)
                {
                    SelectedRowEntry.defaultunitscode = (int)matchedUom.ucode;
                }
            }

            // Sync collections
            SyncEditedCollections(SelectedRowEntry);
            SelectedRowEntry.detailednormalvalues = SelectedRowEntry.EditedDetailedNormalValues;
            SelectedRowEntry.textnormalvalues = SelectedRowEntry.EditedTextNormalValues;
            SelectedRowEntry.calculatedformulas = SelectedRowEntry.EditedCalculatedFormulas;

            // Sync to master collection lre / lre1
            var masterRow = lre1?.FirstOrDefault(x => x.testresultid == SelectedRowEntry.testresultid);
            if (masterRow != null)
            {
                masterRow.rtmcode = SelectedRowEntry.rtmcode;
                
                // Clean up and format normalvalue with method name if present
                string baseNormal = SelectedRowEntry.normalvalue ?? "";
                baseNormal = System.Text.RegularExpressions.Regex.Replace(baseNormal, @"\s*/\s*\([^)]*\)\s*$", "");
                baseNormal = System.Text.RegularExpressions.Regex.Replace(baseNormal, @"^\([^)]*\)\s*", "");
                if (baseNormal.StartsWith("(") && baseNormal.EndsWith(")")) baseNormal = "";
                baseNormal = baseNormal.Trim();

                var methodItem = method?.FirstOrDefault(x => x.rtmcode == SelectedRowEntry.rtmcode);
                if (methodItem != null && !string.IsNullOrEmpty(methodItem.name) && SelectedRowEntry.rtmcode > 0)
                {
                    masterRow.normalvalue = string.IsNullOrEmpty(baseNormal) ? $"({methodItem.name})" : $"{baseNormal} / ({methodItem.name})";
                }
                else
                {
                    masterRow.normalvalue = baseNormal;
                }

                masterRow.unitname = SelectedRowEntry.unitname;
                masterRow.defaultunitscode = SelectedRowEntry.defaultunitscode;
                masterRow.enteredresult = SelectedRowEntry.enteredresult;
                masterRow.resultvaluetype = SelectedRowEntry.resultvaluetype;
                masterRow.decimalvalue = SelectedRowEntry.decimalvalue;
                masterRow.footermessage = SelectedRowEntry.footermessage;
                masterRow.conclusionforfixedtext = SelectedRowEntry.conclusionforfixedtext;
                masterRow.conclusionforhigher = SelectedRowEntry.conclusionforhigher;
                masterRow.conclusionforlower = SelectedRowEntry.conclusionforlower;
                masterRow.printconclusioninreport = SelectedRowEntry.printconclusioninreport;
                masterRow.printconclusioninbottom = SelectedRowEntry.printconclusioninbottom;
                masterRow.textnormalvalues = SelectedRowEntry.textnormalvalues;
                masterRow.detailednormalvalues = SelectedRowEntry.detailednormalvalues;
                masterRow.calculatedformulas = SelectedRowEntry.calculatedformulas;
                masterRow.isauthorized1 = SelectedRowEntry.isauthorized1;
                masterRow.estylecode = SelectedRowEntry.estylecode;
            }

            // Keep sidebar state in sync if same row is selected
            SyncRowToUI(SelectedRowEntry);
            _ = RunCalculations();
        }
    }

