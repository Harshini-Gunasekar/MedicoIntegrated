    private async Task<string> MakeCompactBase64Image(string rawBase64)
    {
        if (string.IsNullOrEmpty(rawBase64) || !rawBase64.StartsWith("data:image/")) return rawBase64;
        try
        {
            string compact = await JSRuntime.InvokeAsync<string>("eval", @"
                (function(base64Str) {
                    return new Promise(function(resolve) {
                        var img = new Image();
                        img.src = base64Str;
                        img.onload = function() {
                            var maxW = 200, maxH = 120;
                            var w = img.width, h = img.height;
                            if (w > maxW || h > maxH) {
                                var ratio = Math.min(maxW / w, maxH / h);
                                w = Math.round(w * ratio);
                                h = Math.round(h * ratio);
                            }
                            var canvas = document.createElement('canvas');
                            canvas.width = w;
                            canvas.height = h;
                            var ctx = canvas.getContext('2d');
                            ctx.drawImage(img, 0, 0, w, h);
                            resolve(canvas.toDataURL('image/jpeg', 0.85));
                        };
                        img.onerror = function() { resolve(base64Str); };
                    });
                })('" + rawBase64.Replace("'", "\\'") + @"')
            ");
            return string.IsNullOrEmpty(compact) ? rawBase64 : compact;
        }
        catch
        {
            return rawBase64;
        }
    }

    private async Task UploadReportImage(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                reportImageFileName = file.Name;
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                byte[] bytes = ms.ToArray();
                string format = string.IsNullOrEmpty(file.ContentType) ? "image/jpeg" : file.ContentType;
                string rawBase64 = $"data:{format};base64,{Convert.ToBase64String(bytes)}";

                if (format.StartsWith("image/"))
                {
                    reportImageBase64 = await MakeCompactBase64Image(rawBase64);
                }
                else
                {
                    reportImageBase64 = rawBase64;
                }

                if (SelectedRowEntry != null)
                {
                    if (!SelectedRowEntry.testresultid.HasValue || SelectedRowEntry.testresultid.Value == Guid.Empty)
                    {
                        SelectedRowEntry.testresultid = Guid.NewGuid();
                    }
                    SelectedRowEntry.image_path = reportImageFileName;
                    rowImageMap[SelectedRowEntry.testresultid.Value] = (reportImageFileName, reportImageBase64);
                }

                Toast.ShowSuccess($"Image attached to '{SelectedRowEntry?.col2 ?? "selected row"}': {file.Name}");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Image upload failed: {ex.Message}");
        }
    }

    private void RemoveReportImage()
    {
        reportImageBase64 = "";
        reportImageFileName = "";
        if (SelectedRowEntry != null)
        {
            SelectedRowEntry.image_path = null;
            if (SelectedRowEntry.testresultid.HasValue)
            {
                rowImageMap.Remove(SelectedRowEntry.testresultid.Value);
            }
        }
        StateHasChanged();
    }

