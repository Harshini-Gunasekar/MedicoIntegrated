    private void UpdateRowSettings()
    {
        if (SelectedRowEntry == null) return;
        
        // Handle TN (Text & Number) logic specifically
        if (resulttype == "Text & Number" && SelectedRowEntry.resultvaluetype != "Text & Number")
        {
            // Ensure testresultid is properly managed when switching to TN
            // If it was a master record (empty GUID or placeholder), generate a new specific ID
            if (SelectedRowEntry.testresultid == null || SelectedRowEntry.testresultid == Guid.Empty)
            {
                SelectedRowEntry.testresultid = Guid.NewGuid();
            }
            // Trigger metadata sync for the new type
            SelectedRowEntry.detailednv = true; 
            DetailedNormalRange = true;
        }

        SelectedRowEntry.resultvaluetype = resulttype;
        SelectedRowEntry.enteredresult = ResultText;
        SelectedRowEntry.resulthigh = (AlertType == "High");
        SelectedRowEntry.resultlow = (AlertType == "Low");
        SelectedRowEntry.resultnormal = (AlertType == "Normal");
        SelectedRowEntry.printresultonly = PrintResultsOnly;
