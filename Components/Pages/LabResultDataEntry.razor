    private static List<User_Master>? _cachedUserMaster;
    private static string? _cachedTenantCodeForUsers;
    private async Task UserMasterAsync()
    {
        var effTenant = !string.IsNullOrEmpty(tenantCode) ? tenantCode : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");

        if (_cachedUserMaster != null && _cachedUserMaster.Any() && _cachedTenantCodeForUsers == effTenant)
        {
            usermaster = _cachedUserMaster;
            UpdateUserNames();
            return;
        }

        try
        {
            var rawList = await UserSvc.GetAllAsync(token, effTenant);
            if (rawList != null && rawList.Any())
            {
                var list = new List<User_Master>();
                foreach (var gu in rawList)
                {
                    if (gu?.user != null)
                    {
                        int ucode = gu.user.user_code > 0 ? gu.user.user_code : gu.user.usercode;
                        string uName = !string.IsNullOrWhiteSpace(gu.user.name) 
                            ? gu.user.name.Trim() 
                            : (!string.IsNullOrWhiteSpace(gu.user.short_name) ? gu.user.short_name.Trim() : "");
                        
                        if (ucode > 0 && !string.IsNullOrEmpty(uName))
                        {
                            list.Add(new User_Master
                            {
                                usercode = ucode,
                                name = uName,
                                role = gu.user.role ?? "",
                                module = ""
                            });
                        }
                    }
                }

                if (list.Any())
                {
                    if (!list.Any(x => x.usercode == 1))
                    {
                        list.Add(new User_Master { usercode = 1, name = "Admin", role = "Admin" });
                    }
                    if (userCode > 0 && !string.IsNullOrWhiteSpace(currentUserName) && !list.Any(x => x.usercode == userCode))
                    {
                        list.Add(new User_Master { usercode = userCode, name = currentUserName.Trim(), role = "User" });
                    }

                    _cachedUserMaster = list;
                    _cachedTenantCodeForUsers = effTenant;
                    usermaster = list;
                    UpdateUserNames();
                    StateHasChanged();
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[USERMASTER] User list load failed: {ex.Message}");
        }

        if (usermaster == null) usermaster = new List<User_Master>();
        if (!usermaster.Any(x => x.usercode == 1))
            usermaster.Add(new User_Master { usercode = 1, name = "Admin", role = "Admin" });
        if (userCode > 0 && !string.IsNullOrWhiteSpace(currentUserName) && !usermaster.Any(x => x.usercode == userCode))
            usermaster.Add(new User_Master { usercode = userCode, name = currentUserName.Trim(), role = "User" });
        UpdateUserNames();
        StateHasChanged();
    }

    private void EnsureUserLoaded(int code)
    {
        if (code <= 1 || code == userCode || _isDisposed) return;
        
        if (usermaster != null && usermaster.Any(x => x.usercode == code)) return;
        
        lock (_pendingUserLoads)
        {
            if (_pendingUserLoads.Contains(code)) return;
            _pendingUserLoads.Add(code);
        }

        _ = Task.Run(async () =>
        {
            try
            {
                var effTenant = !string.IsNullOrEmpty(tenantCode) ? tenantCode : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");
                var u = await UserSvc.GetUserMasterAsync(code, token, effTenant);
                
                await InvokeAsync(() =>
                {
                    if (_isDisposed) return;
                    if (usermaster == null) usermaster = new List<User_Master>();

                    if (u != null)
                    {
                        int ucode = u.user_code > 0 ? u.user_code : u.usercode;
                        string uName = !string.IsNullOrWhiteSpace(u.name) ? u.name.Trim() : (!string.IsNullOrWhiteSpace(u.short_name) ? u.short_name.Trim() : "");
                        if (ucode > 0 && !string.IsNullOrEmpty(uName))
                        {
                            var existing = usermaster.FirstOrDefault(x => x.usercode == ucode);
                            if (existing != null) usermaster.Remove(existing);
                            usermaster.Add(new User_Master { usercode = ucode, name = uName, role = u.role ?? "" });
                        }
                    }
                    
                    lock (_pendingUserLoads)
                    {
                        _pendingUserLoads.Remove(code);
                    }
                    UpdateUserNames();
                    StateHasChanged();
                });
            }
            catch
            {
                lock (_pendingUserLoads)
                {
                    _pendingUserLoads.Remove(code);
                }
                await InvokeAsync(() =>
                {
                    UpdateUserNames();
                    StateHasChanged();
                });
            }
        });
    }

    private void UpdateUserNames()
    {
        if (lre1 != null && lre1.Any())
        {
            // Aggregating IDs from all rows to find any recorded authorization
            entId = lre1.Where(x => x.resultenteredby > 0).Select(x => x.resultenteredby).FirstOrDefault();
            auth1Id = lre1.Where(x => x.resultauthorizedby > 0).Select(x => x.resultauthorizedby).FirstOrDefault();
            auth2Id = lre1.Where(x => x.resultauthorizedby2 > 0).Select(x => x.resultauthorizedby2).FirstOrDefault();
            
            // Try to find ANY non-zero ID if the aggregation failed
            if (entId == 0) entId = lre1.Max(x => x.resultenteredby);
            if (auth1Id == 0) auth1Id = lre1.Max(x => x.resultauthorizedby);
            if (auth2Id == 0) auth2Id = lre1.Max(x => x.resultauthorizedby2);

            // Boolean flag fallbacks if user ID was 0 but row was authorized/entered
            if (auth1Id == 0 && lre1.Any(x => x.isauthorized1))
            {
                auth1Id = userCode > 0 ? userCode : 1;
            }
            if (auth2Id == 0 && lre1.Any(x => x.isauthorized2))
            {
                auth2Id = userCode > 0 ? userCode : 1;
            }
            if (entId == 0 && lre1.Any(x => !string.IsNullOrEmpty(x.enteredresult)))
            {
                entId = userCode > 0 ? userCode : 1;
            }

            // Queue background resolution for missing user details (only for external users not matching active session)
            if (entId > 1 && entId != userCode) EnsureUserLoaded(entId);
            if (auth1Id > 1 && auth1Id != userCode) EnsureUserLoaded(auth1Id);
            if (auth2Id > 1 && auth2Id != userCode) EnsureUserLoaded(auth2Id);

            if (entId > 0)
                ent1 = ResolveUserName(entId);
            else if (!string.IsNullOrEmpty(currentUserName) && lre1.Any(x => !string.IsNullOrEmpty(x.enteredresult)))
                ent1 = currentUserName;
            
            if (auth1Id > 0)
                auth1 = ResolveUserName(auth1Id);
            else if (lre1.Any(x => x.isauthorized1) && !string.IsNullOrEmpty(currentUserName))
                auth1 = currentUserName;
            
            if (auth2Id > 0)
                auth2 = ResolveUserName(auth2Id);
            else if (lre1.Any(x => x.isauthorized2) && !string.IsNullOrEmpty(currentUserName))
                auth2 = currentUserName;
            
            bool hasEscalationRows = lre1.Any(x => IsRowEscalated(x));
            if (hasEscalationRows)
            {
                isAuth2Finished = lre1.Where(x => IsRowEscalated(x)).All(x => x.resultauthorizedby2 == GetAssignedUserCode(x.tcode));
            }
            else
            {
                isAuth2Finished = lre1.Any(x => x.isauthorized2 || x.resultauthorizedby2 > 0);
            }
            
            StateHasChanged();
        }
    }

    private string ResolveUserName(int code)
    {
        if (code <= 0) return "";
        if (code == 1) return "Admin";
        
        // 1. If matches current logged-in user
        if (code == userCode && !string.IsNullOrEmpty(currentUserName))
        {
            return currentUserName;
        }

        // 2. Try to find in usermaster list if available
        if (usermaster != null && usermaster.Any())
        {
            var u = usermaster.FirstOrDefault(x => x.usercode == code);
            if (u != null && !string.IsNullOrEmpty(u.name))
                return u.name;
        }

        // 3. Fallback: if entered by current user and authorizer code matches entered code
        if (!string.IsNullOrEmpty(currentUserName) && entId > 0 && (code == entId || (code > 0 && userCode == entId)))
        {
            return currentUserName;
        }

        // 4. If currentUserName exists and matches the row, prefer it over stuck "..."
        if (!string.IsNullOrEmpty(currentUserName) && (code == userCode || code == entId || code == auth1Id))
        {
            return currentUserName;
        }

        bool isPending = false;
        lock (_pendingUserLoads)
        {
            isPending = _pendingUserLoads.Contains(code);
        }

        return isPending ? "Loading..." : $"User ({code})";
    }

    private async Task LoadResults(bool forceRefreshMaster = false)
    {
        try
        {
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            if (string.IsNullOrEmpty(RequestGuid))
            {
                if (query.TryGetValue("requestGuid", out var qg) || query.TryGetValue("requestguid", out qg))
                {
                    RequestGuid = qg.ToString();
                }
            }
            if (string.IsNullOrEmpty(CustCode) && (query.TryGetValue("custcode", out var qc) || query.TryGetValue("custCode", out qc)))
            {
                CustCode = qc.ToString();
            }
            if (string.IsNullOrEmpty(PatientName))
            {
                if (query.TryGetValue("patientname", out var qpn) || query.TryGetValue("patient_name", out qpn) || query.TryGetValue("name", out qpn) || query.TryGetValue("pname", out qpn))
                {
                    PatientName = qpn.ToString();
                }
            }
            if (string.IsNullOrEmpty(PatientGender))
            {
                if (query.TryGetValue("gender", out var qgnd) || query.TryGetValue("sex", out qgnd))
                {
                    PatientGender = qgnd.ToString();
                }
            }
            if (string.IsNullOrEmpty(PatientAge) && query.TryGetValue("age", out var qa))
            {
                PatientAge = qa.ToString();
            }
            if (string.IsNullOrEmpty(PatientDoctor) && (query.TryGetValue("doctor", out var qdoc) || query.TryGetValue("doctor_name", out qdoc)))
            {
                PatientDoctor = qdoc.ToString();
            }
            if (string.IsNullOrEmpty(FilterTCode) && (query.TryGetValue("tcode", out var qt) || query.TryGetValue("tCode", out qt) || query.TryGetValue("tcodes", out qt)))
            {
                FilterTCode = qt.ToString();
            }
            if (string.IsNullOrEmpty(FilterTestName) && (query.TryGetValue("testname", out var qtn) || query.TryGetValue("testName", out qtn)))
            {
                FilterTestName = qtn.ToString();
            }
        }
        catch { }

        if (_isDisposed || string.IsNullOrEmpty(RequestGuid)) return;

        try
        {
        var ct = SafeToken;
        var effectiveTenantCode = !string.IsNullOrEmpty(tenantCode) ? tenantCode : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");
        
        string activeLoadGuid = RequestGuid;

        HttpResponseMessage res = new HttpResponseMessage(System.Net.HttpStatusCode.BadRequest);

        // Fast Path: Try direct primary endpoint first (matches backend api/LabResult/LoadResultEntry)
        try
        {
            var directUrl = $"api/LabResult/LoadResultEntry?requestGuid={RequestGuid}";
            var directReq = new HttpRequestMessage(HttpMethod.Get, directUrl);
            if (!string.IsNullOrEmpty(token))
                directReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            directReq.Headers.Add("tenant_code", effectiveTenantCode);

            res = await ClientFactory.CreateClient("Medico").SendAsync(directReq, ct);
        }
        catch { }

        // Fallback Path: Only if direct attempt failed, resolve billed requestguid or alternate endpoints
        if (!res.IsSuccessStatusCode)
        {
            string resolvedGuid = await ResolveBilledRequestGuidAsync();
            var loadUrls = new List<string>();
            if (!string.IsNullOrEmpty(resolvedGuid) && resolvedGuid != RequestGuid)
            {
                loadUrls.Add($"api/LabResult/LoadResultEntry?requestGuid={resolvedGuid}");
                loadUrls.Add($"api/labresult/loadtestresultentry?requestguid={resolvedGuid}&custcode={CustCode}");
            }
            loadUrls.Add($"api/LabResult/LoadResultEntry?requestGuid={RequestGuid}&custcode={CustCode}");
            loadUrls.Add($"api/labresult/loadtestresultentry?requestguid={RequestGuid}&custcode={CustCode}");
            loadUrls.Add($"labresult/loadresultentry?requestGuid={RequestGuid}&custcode={CustCode}&t={DateTime.Now.Ticks}");

            foreach (var lUrl in loadUrls)
            {
                var req = new HttpRequestMessage(HttpMethod.Get, lUrl);
                if (!string.IsNullOrEmpty(token))
                    req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                req.Headers.Add("tenant_code", effectiveTenantCode);

                res = await ClientFactory.CreateClient("Medico").SendAsync(req, ct);
                if (res.IsSuccessStatusCode) break;
            }
        }
        if (res.IsSuccessStatusCode)
        {
            var tt = await res.Content.ReadAsStringAsync(ct);
            /* Console.WriteLine($"LOADED DATA RAW: {tt.Substring(0, Math.Min(tt.Length, 500))}...") */; 

            re = JsonConvert.DeserializeObject<ResultEntryModel>(tt) ?? new();
            if (re.results?.Any() == true)
            {
                var firstRaw = JsonConvert.SerializeObject(re.results.First());
                /* Console.WriteLine($"DEBUG - First row JSON snapshot: {firstRaw}") */;
            }

            if (re.methods != null)
            {
                foreach (var m in re.methods)
                {
                    if (m.name != null)
                    {
                        m.name = m.name.Trim(' ', '(', ')');
                    }
                }
            }

            uom = await LoadAndMergeUomAsync(re.units);
            sample = re.samples ?? new List<Booking.Models.SampleMasterModel>();
            machine = re.machines ?? new List<Medico_Backend.Model.MachineMasterModel>();
            method = re.methods ?? new List<Booking.Models.ReportMethodModel>();
            // Skip secondary ReportMethod HTTP calls to keep strictly to 3 allowed endpoints

            var rawResults = re.results != null ? Newtonsoft.Json.JsonConvert.DeserializeObject<List<LabResultEntry>>(Newtonsoft.Json.JsonConvert.SerializeObject(re.results)) : new List<LabResultEntry>();
            
            // Ensure every row has a valid non-empty testresultid and requestguid
            foreach (var r in rawResults)
            {
                if (!r.testresultid.HasValue || r.testresultid.Value == Guid.Empty)
                {
                    r.testresultid = Guid.NewGuid();
                }
                if (string.IsNullOrEmpty(r.requestguid))
                {
                    r.requestguid = RequestGuid;
                }
            }

            lre1 = rawResults.GroupBy(x => x.testresultid!.Value).Select(g => g.First()).ToList();
            lre1 = SortLabResultEntries(lre1);

            if (lre1 == null || !lre1.Any())
            {
                try
                {
                    var csCandidates = new[]
                    {
                        $"api/CaseSheet/investigation?op_id={RequestGuid}",
                        $"api/CaseSheet/investigation?ip_id={RequestGuid}"
                    };

                    CaseSheetInvestigationDetailDto? csObj = null;

                    foreach (var endpoint in csCandidates)
                    {
                        var csReq = new HttpRequestMessage(HttpMethod.Get, endpoint);
                        if (!string.IsNullOrEmpty(token)) csReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                        csReq.Headers.Add("tenant_code", effectiveTenantCode);

                        var csRes = await ClientFactory.CreateClient("Medico").SendAsync(csReq, ct);
                        if (csRes.IsSuccessStatusCode)
                        {
                            var csJson = await csRes.Content.ReadAsStringAsync(ct);
                            var parsed = JsonConvert.DeserializeObject<CaseSheetInvestigationDetailDto>(csJson);
                            if (parsed?.tests != null && parsed.tests.Any())
                            {
                                csObj = parsed;
                                break;
                            }
                        }
                    }

                    if (csObj?.tests != null && csObj.tests.Any())
                    {
                        var caseSheetEntries = new List<LabResultEntry>();
                        int slnoCounter = 1;
                        foreach (var test in csObj.tests)
                        {
                            int tcodeVal = test.test_code ?? 0;
                            string tName = test.test_name ?? "Test";

                            var testMasterConfig = tcodeVal > 0 ? await TestSvc.GetTestResultAsync(tcodeVal) : null;
                            if (testMasterConfig?.TestMaster?.lockresult == true) continue;

                            if (testMasterConfig?.ResultRows != null && testMasterConfig.ResultRows.Any())
                            {
                                foreach (var subRow in testMasterConfig.ResultRows)
                                {
                                    var rm = subRow.ResultMaster;
                                    var rmProp = subRow.ResultProperties;
                                    Guid trId = rm?.testresultid ?? Guid.NewGuid();

                                    string nVal = "";
                                    if (rmProp?.fromnormalvalue != null && rmProp?.tonormalvalue != null)
                                    {
                                        nVal = $"{rmProp.fromnormalvalue}-{rmProp.tonormalvalue}";
                                    }

                                    string uName = "";
                                    if (rmProp?.defaultunitscode > 0 && uom != null && uom.Any())
                                    {
                                        uName = uom.FirstOrDefault(u => u.ucode == rmProp.defaultunitscode.Value)?.name ?? "";
                                    }

                                    caseSheetEntries.Add(new LabResultEntry
                                    {
                                        requestguid = RequestGuid,
                                        inv_det_id = test.inv_det_id,
                                        slno = slnoCounter++,
                                        tcode = tcodeVal,
                                        testname = tName,
                                        groupname = tName,
                                        col2 = rm?.col2 ?? tName,
                                        enteredresult = test.result_value ?? "",
                                        normalvalue = nVal,
                                        unitname = uName,
                                        defaultunitvalue = rmProp?.defaultvalue ?? "",
                                        resultvaluetype = rmProp?.resultvaluetype ?? "Text",
                                        testresultid = trId,
                                        status = test.result_status == "COMPLETED" || test.result_status == "FINISHED",
                                        isauthorized1 = false,
                                        isauthorized2 = false
                                    });
                                }
                            }
                            else
                            {
                                caseSheetEntries.Add(new LabResultEntry
                                {
                                    requestguid = RequestGuid,
                                    inv_det_id = test.inv_det_id,
                                    slno = slnoCounter++,
                                    tcode = tcodeVal,
                                    testname = tName,
                                    groupname = tName,
                                    col2 = tName,
                                    enteredresult = test.result_value ?? "",
                                    normalvalue = "",
                                    unitname = "",
                                    defaultunitvalue = "",
                                    resultvaluetype = "Text",
                                    testresultid = Guid.NewGuid(),
                                    status = test.result_status == "COMPLETED" || test.result_status == "FINISHED",
                                    isauthorized1 = false,
                                    isauthorized2 = false
                                });
                            }
                        }
                        lre1 = caseSheetEntries;
                    }
                }
                catch (Exception csEx)
                {
                    Console.WriteLine($"[LOAD-RESULTS] CaseSheet fallback error: {csEx.Message}");
                }
            }

// Pre-load test configurations (including sub-parameter fromtcodes) in parallel with static caching
            if (lre1 != null && lre1.Any())
            {
                var distinctTCodes = lre1.Select(x => (long)x.tcode)
                    .Concat(lre1.Where(x => x.fromtcode > 0).Select(x => (long)x.fromtcode))
                    .Concat(lre1.Select(x => GetParentTCode(x)))
                    .Concat((billedTestSelections ?? new()).Select(b => (long)b.tcode))
                    .Where(tc => tc > 0)
                    .Distinct()
                    .ToList();

                bool hasUnenteredRows = lre1.Any(r => 
                    r.resultvaluetype != "Title" && r.resultvaluetype != "SubTitle" &&
                    (string.IsNullOrWhiteSpace(r.enteredresult) || r.enteredresult.Trim() == "-") && 
                    !r.status && !r.isauthorized1 && !r.isauthorized2 && (r.resultenteredby == 0 || r.resultenteredby == null));

                if (forceRefreshMaster || hasUnenteredRows)
                {
                    foreach (var tc in distinctTCodes)
                    {
                        _staticTestConfigs.TryRemove($"{effectiveTenantCode}_{tc}", out _);
                    }
                }

                var missingTCodes = distinctTCodes.Where(tc => {
                    if (!_staticTestConfigs.TryGetValue($"{effectiveTenantCode}_{tc}", out var cached)) return true;
                    return (DateTime.UtcNow - cached.CachedAt).TotalSeconds > 20;
                }).ToList();

                if (missingTCodes.Any())
                {
                    var configTasks = missingTCodes.Select(async tc =>
                    {
                        try
                        {
                            var cfg = await TestSvc.GetTestResultAsync(tc);
                            return (tc, cfg);
                        }
                        catch { return (tc, (LabCare.Models.TestInsertDto?)null); }
                    });

                    var loadedConfigs = await Task.WhenAll(configTasks);
                    foreach (var tuple in loadedConfigs)
                    {
                        if (tuple.Item2 != null)
                        {
                            _staticTestConfigs[$"{effectiveTenantCode}_{tuple.Item1}"] = (tuple.Item2, DateTime.UtcNow);
                        }
                    }
                }

                foreach (var tc in distinctTCodes)
                {
                    if (_staticTestConfigs.TryGetValue($"{effectiveTenantCode}_{tc}", out var cfgTuple))
                    {
                        _testConfigs[tc] = cfgTuple.Dto;
                    }
                }
            }


            // Exclude locked tests (lockresult == true) from LabResultDataEntry
            var lockedTCodes = new HashSet<long>();
            foreach (var (tc, cfg) in _testConfigs)
            {
                if (cfg?.TestMaster?.lockresult == true)
                {
                    lockedTCodes.Add(tc);
                }
            }

            if (_cachedTenantCodeForTestMasters != effectiveTenantCode || _cachedLockedTcodes == null || !_cachedLockedTcodes.Any() || _cachedTestMastersByTCode == null || !_cachedTestMastersByTCode.Any())
            {
                try
                {
                    var client = ClientFactory.CreateClient("Medico");
                    var tReq = new HttpRequestMessage(HttpMethod.Get, "api/Test/get");
                    if (!string.IsNullOrEmpty(effectiveTenantCode)) tReq.Headers.Add("tenant_code", effectiveTenantCode);
                    if (!string.IsNullOrEmpty(token)) tReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                    var tRes = await client.SendAsync(tReq, ct);
                    if (tRes.IsSuccessStatusCode)
                    {
                        var tJson = await tRes.Content.ReadAsStringAsync(ct);
                        var tests = JsonConvert.DeserializeObject<List<Booking.Models.TestMasterModel>>(tJson);
                        if (tests != null)
                        {
                            _cachedTenantCodeForTestMasters = effectiveTenantCode;
                            _cachedLockedTcodes = tests.Where(t => t.lockresult).Select(t => (long)t.tcode).ToHashSet();
                            _cachedLockedTestNames = tests.Where(t => t.lockresult && !string.IsNullOrWhiteSpace(t.name))
                                                .Select(t => t.name!.Trim())
                                                .ToHashSet(StringComparer.OrdinalIgnoreCase);
                            _cachedTestMastersByTCode = tests.GroupBy(t => (long)t.tcode).ToDictionary(g => g.Key, g => g.First());
                            _cachedTestMastersByName = tests.Where(t => !string.IsNullOrWhiteSpace(t.name))
                                                .GroupBy(t => t.name!.Trim().ToLower())
                                                .ToDictionary(g => g.Key, g => g.First());
                        }
                    }
                }
                catch { }
            }
            if (_cachedLockedTcodes != null)
            {
                foreach (var tc in _cachedLockedTcodes) lockedTCodes.Add(tc);
            }

            if (lockedTCodes.Any() || (_cachedLockedTestNames != null && _cachedLockedTestNames.Any()))
            {
                lre1 = lre1.Where(row =>
                    !lockedTCodes.Contains(row.tcode) &&
                    (row.fromtcode <= 0 || !lockedTCodes.Contains((long)row.fromtcode)) &&
                    (_cachedLockedTestNames == null || string.IsNullOrWhiteSpace(row.testname) || !_cachedLockedTestNames.Contains(row.testname.Trim())) &&
                    (_cachedLockedTestNames == null || string.IsNullOrWhiteSpace(row.col2) || !_cachedLockedTestNames.Contains(row.col2.Trim()))
                ).ToList();
            }

            // 0. Respect Test Master configuration: if Test Master defines a test as Title (e.g. MALARIA CARD), keep as Title
            foreach (var testGrp in lre1.GroupBy(x => GetParentTCode(x)).ToList())
            {
                long tcode = testGrp.Key;
                if (_testConfigs.TryGetValue(tcode, out var cfg) && cfg.ResultRows?.Any() == true)
                {
                    var mFirst = cfg.ResultRows.First();
                    string mType = mFirst.ResultProperties?.resultvaluetype ?? "";
                    if (string.Equals(mType, "Title", StringComparison.OrdinalIgnoreCase) && (cfg.ResultRows.Count <= 1 || cfg.TestMaster?.lockresult != true))
                    {
                        foreach (var row in testGrp)
                        {
                            row.resultvaluetype = "Title";
                            row.printresultonly = true;
                            row.enteredresult = "";
                            row.unitname = "";
                            row.normalvalue = "";
                        }
                    }
                }
            }

            // 1. Standalone test with no parameters / prompt heading handling:
            // Tests like XRAY(CHEST) or MALARIA CARD whose resultvaluetype is Title should display as a prompt heading Title row
            var rowsByTest = lre1.GroupBy(x => GetParentTCode(x)).ToList();
            foreach (var testGrp in rowsByTest)
            {
                var paramRows = testGrp.Where(r => r.resultvaluetype != "Title" && r.resultvaluetype != "SubTitle" && !string.Equals(r.col2?.Trim(), "NLR", StringComparison.OrdinalIgnoreCase)).ToList();

                if (!paramRows.Any())
                {
                    var singleRow = testGrp.First();
                    singleRow.resultvaluetype = "Title";
                    singleRow.printresultonly = true;
                    singleRow.enteredresult = "";
                    singleRow.unitname = "";
                    singleRow.normalvalue = "";
                    singleRow.orderno = 0;
                    singleRow.slno = 0;
                }
            }

            // 2. Mark known inner sub-headlines (e.g. NLR) as SubTitle
            foreach (var row in lre1)
            {
                if (row.col2?.Trim().Equals("NLR", StringComparison.OrdinalIgnoreCase) == true)
                {
                    row.resultvaluetype = "SubTitle";
                }
            }

            // 3. Ensure each multi-parameter test group has EXACTLY ONE top Headline row, and single tests have NO separate Title row
            rowsByTest = lre1.GroupBy(x => GetParentTCode(x)).ToList();
            foreach (var testGrp in rowsByTest)
            {
                long tcode = testGrp.Key;
                bool isMultiParam = false;
                if (_testConfigs.TryGetValue(tcode, out var cfg) && cfg.ResultRows != null && cfg.ResultRows.Count > 1)
                {
                    isMultiParam = true;
                }
                else
                {
                    var distinctParams = testGrp
                        .Where(r => r.resultvaluetype != "Title" && r.resultvaluetype != "SubTitle" && !string.Equals(r.col2?.Trim(), "NLR", StringComparison.OrdinalIgnoreCase))
                        .Select(r => (r.col2 ?? r.testname ?? "").Trim().ToLowerInvariant())
                        .Distinct()
                        .ToList();
                    if (distinctParams.Count > 1) isMultiParam = true;
                }

                var paramRows = testGrp.Where(r => r.resultvaluetype != "Title" && r.resultvaluetype != "SubTitle" && !string.Equals(r.col2?.Trim(), "NLR", StringComparison.OrdinalIgnoreCase)).ToList();

                if (isMultiParam && paramRows.Count > 1)
                {
                    string headlineName = "";
                    if (_testConfigs.TryGetValue(testGrp.Key, out var tmCfg) && !string.IsNullOrWhiteSpace(tmCfg.TestMaster?.name))
                    {
                        headlineName = tmCfg.TestMaster.name.Trim();
                    }
                    if (string.IsNullOrWhiteSpace(headlineName) && billedTestSelections != null)
                    {
                        headlineName = billedTestSelections.FirstOrDefault(b => b.tcode == testGrp.Key)?.testname ?? "";
                    }
                    if (string.IsNullOrWhiteSpace(headlineName))
                    {
                        headlineName = testGrp.First().testname ?? "Test Group";
                    }

                    var titleRows = testGrp.Where(r => r.resultvaluetype == "Title").ToList();
                    LabResultEntry titleRow;

                    if (titleRows.Any())
                    {
                        titleRow = titleRows.First();
                        titleRow.resultvaluetype = "Title";
                        titleRow.printresultonly = true;
                        titleRow.enteredresult = "";
                        titleRow.unitname = "";
                        titleRow.normalvalue = "";
                        titleRow.testname = headlineName;
                        titleRow.col2 = headlineName;
                        titleRow.grouporder = testGrp.First().grouporder;
                        titleRow.groupname = testGrp.First().groupname;
                        titleRow.gcode = testGrp.First().gcode;
                        titleRow.orderno = 0;
                        titleRow.slno = 0;

                        // Deduplicate: Remove any extra duplicate Title rows
                        for (int i = 1; i < titleRows.Count; i++)
                        {
                            lre1.Remove(titleRows[i]);
                        }
                    }
                    else
                    {
                        titleRow = new LabResultEntry
                        {
                            testresultid = Guid.NewGuid(),
                            requestguid = RequestGuid,
                            tcode = (int)testGrp.Key,
                            fromtcode = 0,
                            testname = headlineName,
                            col2 = headlineName,
                            resultvaluetype = "Title",
                            printresultonly = true,
                            grouporder = testGrp.First().grouporder, // MUST match parameters!
                            groupname = testGrp.First().groupname,
                            gcode = testGrp.First().gcode,
                            slno = 0,
                            orderno = 0,
                            status = false
                        };
                        lre1.Insert(lre1.IndexOf(testGrp.First()), titleRow);
                    }
                }
                else if (!isMultiParam)
                {
                    // Single parameter test (e.g. CRP, MALARIA CARD):
                    var strayTitles = testGrp.Where(r => r.resultvaluetype == "Title").ToList();
                    if (paramRows.Any())
                    {
                        // Test has an editable parameter row (like CRP), so remove extra Title row
                        foreach (var st in strayTitles)
                        {
                            lre1.Remove(st);
                        }
                    }
                    else if (strayTitles.Any())
                    {
                        // Test Master configured this test as Title (like MALARIA CARD):
                        // Keep exactly ONE Title row, remove any duplicates!
                        var firstTitle = strayTitles.First();
                        firstTitle.resultvaluetype = "Title";
                        firstTitle.printresultonly = true;
                        firstTitle.enteredresult = "";
                        firstTitle.unitname = "";
                        firstTitle.normalvalue = "";
                        for (int i = 1; i < strayTitles.Count; i++)
                        {
                            lre1.Remove(strayTitles[i]);
                        }
                    }
                }
            }

            // 3b. Deduplicate single-parameter test rows and duplicate sub-parameters
            foreach (var testGrp in lre1.GroupBy(x => GetParentTCode(x)).ToList())
            {
                long tcode = testGrp.Key;
                bool isMultiParam = false;
                if (_testConfigs.TryGetValue(tcode, out var cfg) && cfg.ResultRows != null && cfg.ResultRows.Count > 1)
                {
                    isMultiParam = true;
                }
                else
                {
                    var distinctParams = testGrp
                        .Where(r => r.resultvaluetype != "Title" && r.resultvaluetype != "SubTitle" && !string.Equals(r.col2?.Trim(), "NLR", StringComparison.OrdinalIgnoreCase))
                        .Select(r => (r.col2 ?? r.testname ?? "").Trim().ToLowerInvariant())
                        .Distinct()
                        .ToList();
                    if (distinctParams.Count > 1) isMultiParam = true;
                }

                if (!isMultiParam && testGrp.Count() > 1)
                {
                    bool isMasterTitle = false;
                    if (_testConfigs.TryGetValue(tcode, out var cfgM) && cfgM.ResultRows?.Any() == true)
                    {
                        var mFirst = cfgM.ResultRows.First();
                        string mType = mFirst.ResultProperties?.resultvaluetype ?? "";
                        isMasterTitle = string.Equals(mType, "Title", StringComparison.OrdinalIgnoreCase);
                    }

                    var bestRow = isMasterTitle
                                ? (testGrp.FirstOrDefault(r => r.resultvaluetype == "Title") ?? testGrp.First())
                                : (testGrp.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.enteredresult) && r.enteredresult != "-")
                                ?? testGrp.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.normalvalue) && r.resultvaluetype != "Title")
                                ?? testGrp.FirstOrDefault(r => r.resultvaluetype != "Title")
                                ?? testGrp.First());

                    if (isMasterTitle)
                    {
                        bestRow.resultvaluetype = "Title";
                        bestRow.printresultonly = true;
                        bestRow.enteredresult = "";
                        bestRow.unitname = "";
                        bestRow.normalvalue = "";
                    }
                    else
                    {
                        bestRow.resultvaluetype = "Numeric";
                        bestRow.printresultonly = false;
                    }

                    var toRemove = testGrp.Where(r => r != bestRow).ToList();
                    foreach (var dup in toRemove)
                    {
                        lre1.Remove(dup);
                    }
                }
                else if (isMultiParam)
                {
                    var dupGroups = testGrp
                        .Where(r => r.resultvaluetype != "Title" && r.resultvaluetype != "SubTitle")
                        .GroupBy(r => (r.col2 ?? r.testname ?? "").Trim().ToLowerInvariant())
                        .Where(g => g.Count() > 1)
                        .ToList();

                    foreach (var dGrp in dupGroups)
                    {
                        var bestP = dGrp.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.enteredresult) && r.enteredresult != "-")
                                 ?? dGrp.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.normalvalue))
                                 ?? dGrp.First();
                        var toRemove = dGrp.Where(r => r != bestP).ToList();
                        foreach (var dup in toRemove)
                        {
                            lre1.Remove(dup);
                        }
                    }
                }
            }

            // 4. Clear result/unit/normalvalue for all Title and SubTitle headline rows
            foreach (var row in lre1)
            {
                if (row.resultvaluetype == "Title" || row.resultvaluetype == "SubTitle" || row.col2?.Trim().Equals("NLR", StringComparison.OrdinalIgnoreCase) == true)
                {
                    row.printresultonly = true;
                    row.enteredresult = "";
                    row.unitname = "";
                    row.normalvalue = "";
                }
            }

            // Sync normalvalue and unitname from template configs, test master, or reporting method
            foreach (var row in lre1)
            {
                // Clean up default hyphen if present so text box is empty and clean
                if (row.enteredresult == "-")
                {
                    row.enteredresult = "";
                }

                long targetTCode = row.fromtcode > 0 ? (long)row.fromtcode : row.tcode;
                long parentTCode = (long)row.tcode;
                long pBilledTCode = GetParentTCode(row);

                var cleanCol2 = (row.col2 ?? row.testname ?? "").Trim().ToLower();
                var mConfig = FindMatchingTestResultRow(row);

                bool isRowUnentered = (string.IsNullOrWhiteSpace(row.enteredresult) || row.enteredresult.Trim() == "-") && !row.status && !row.isauthorized1 && !row.isauthorized2 && (row.resultenteredby == 0 || row.resultenteredby == null);

                // Apply master config (units, normal values, properties)
                ApplyMasterConfigToRow(row, mConfig, forceOverwrite: (forceRefreshMaster || isRowUnentered));

                if (row.rtmcode == 0 && mConfig != null && mConfig.ResultProperties != null && mConfig.ResultProperties.rtmcode > 0)
                {
                    row.rtmcode = mConfig.ResultProperties.rtmcode ?? 0;
                }

                // If unitname is a qualitative value ("NEGATIVE", "POSITIVE", etc.), ensure normalvalue is set
                if (!string.IsNullOrWhiteSpace(row.unitname) && QualitativeValues.Contains(row.unitname.Trim()))
                {
                    if (string.IsNullOrWhiteSpace(row.normalvalue) || row.normalvalue == "-" || row.normalvalue == "0-0" || row.normalvalue == "0 - 0" || row.normalvalue == "0" || row.normalvalue == "Normal 0")
                    {
                        row.normalvalue = "Negative";
                    }
                }

                // Clean up wrongly assigned U/L on WBC count
                if (cleanCol2.Contains("wbc") || cleanCol2.Contains("leucocyte") || cleanCol2.Contains("white blood"))
                {
                    if (string.Equals(row.unitname?.Trim(), "u/l", StringComparison.OrdinalIgnoreCase))
                    {
                        row.unitname = null;
                    }
                }

                // 1. Normalize existing unitname with uom list
                if (!string.IsNullOrWhiteSpace(row.unitname) && uom != null)
                {
                    var matched = uom.FirstOrDefault(u => string.Equals(u.name?.Trim(), row.unitname.Trim(), StringComparison.OrdinalIgnoreCase));
                    if (matched != null)
                    {
                        row.unitname = matched.name ?? row.unitname;
                        row.defaultunitscode = (int)matched.ucode;
                    }
                    else
                    {
                        uom.Add(new Booking.Models.UomMasterModel { ucode = row.defaultunitscode, name = row.unitname.Trim() });
                    }
                }

                // 2. Resolve missing unitname from mConfig, TestMaster, or clinical standards
                if (string.IsNullOrWhiteSpace(row.unitname) && row.resultvaluetype != "Title" && row.resultvaluetype != "SubTitle")
                {
                    // Check candidate unit string on mConfig.ResultMaster.col3
                    if (!string.IsNullOrWhiteSpace(mConfig?.ResultMaster?.col3) && uom != null)
                    {
                        var cand = mConfig.ResultMaster.col3.Trim();
                        var matchedCand = uom.FirstOrDefault(u => string.Equals(u.name?.Trim(), cand, StringComparison.OrdinalIgnoreCase));
                        if (matchedCand != null)
                        {
                            row.unitname = matchedCand.name;
                            row.defaultunitscode = (int)matchedCand.ucode;
                        }
                    }

                    int resolvedUcode = row.defaultunitscode;
                    if (resolvedUcode <= 0 && mConfig?.ResultProperties?.defaultunitscode > 0)
                    {
                        resolvedUcode = mConfig.ResultProperties.defaultunitscode.Value;
                    }
                    if (resolvedUcode <= 0 && _cachedTestMastersByTCode != null && _cachedTestMastersByTCode.TryGetValue(targetTCode, out var tm1) && tm1.ucode.HasValue && tm1.ucode.Value > 0)
                    {
                        resolvedUcode = (int)tm1.ucode.Value;
                    }
                    if (resolvedUcode <= 0 && parentTCode != targetTCode && _cachedTestMastersByTCode != null && _cachedTestMastersByTCode.TryGetValue(parentTCode, out var tm2) && tm2.ucode.HasValue && tm2.ucode.Value > 0)
                    {
                        resolvedUcode = (int)tm2.ucode.Value;
                    }
                    if (resolvedUcode <= 0 && row.fromtcode > 0 && _cachedTestMastersByTCode != null && _cachedTestMastersByTCode.TryGetValue((long)row.fromtcode, out var tmFrom) && tmFrom.ucode.HasValue && tmFrom.ucode.Value > 0)
                    {
                        resolvedUcode = (int)tmFrom.ucode.Value;
                    }
                    if (resolvedUcode <= 0 && _cachedTestMastersByName != null && _cachedTestMastersByName.TryGetValue(cleanCol2, out var tm3) && tm3.ucode.HasValue && tm3.ucode.Value > 0)
                    {
                        resolvedUcode = (int)tm3.ucode.Value;
                    }
                    if (resolvedUcode <= 0 && !string.IsNullOrWhiteSpace(row.testname) && _cachedTestMastersByName != null && _cachedTestMastersByName.TryGetValue(row.testname.Trim().ToLower(), out var tm4) && tm4.ucode.HasValue && tm4.ucode.Value > 0)
                    {
                        resolvedUcode = (int)tm4.ucode.Value;
                    }
                    if (resolvedUcode <= 0 && _cachedTestMastersByName != null)
                    {
                        var partialMatch = _cachedTestMastersByName.FirstOrDefault(kv => kv.Key.Contains(cleanCol2) || cleanCol2.Contains(kv.Key));
                        if (partialMatch.Value != null && partialMatch.Value.ucode.HasValue && partialMatch.Value.ucode.Value > 0)
                        {
                            resolvedUcode = (int)partialMatch.Value.ucode.Value;
                        }
                    }
                    if (resolvedUcode <= 0 && _testConfigs.TryGetValue(targetTCode, out var tcfg) && tcfg.TestMaster != null && tcfg.TestMaster.ucode > 0)
                    {
                        resolvedUcode = (int)tcfg.TestMaster.ucode;
                    }
                    if (resolvedUcode <= 0 && parentTCode != targetTCode && _testConfigs.TryGetValue(parentTCode, out var pcfg) && pcfg.TestMaster != null && pcfg.TestMaster.ucode > 0)
                    {
                        resolvedUcode = (int)pcfg.TestMaster.ucode;
                    }

                    // Direct match by ucode in uom
                    if (string.IsNullOrWhiteSpace(row.unitname) && resolvedUcode > 0 && uom != null)
                    {
                        var matched = uom.FirstOrDefault(u => u.ucode == resolvedUcode);
                        if (matched != null && !string.IsNullOrWhiteSpace(matched.name))
                        {
                            row.defaultunitscode = resolvedUcode;
                            row.unitname = matched.name;
                        }
                    }

                    // Clinical standard laboratory unit heuristics (including full CBC / ESR parameters)
                    if (string.IsNullOrWhiteSpace(row.unitname) && uom != null)
                    {
                        var stdUnit = GetStandardLabUnit(row.col2 ?? row.testname ?? "");
                        if (!string.IsNullOrEmpty(stdUnit))
                        {
                            var matchedUom = uom.FirstOrDefault(u => string.Equals(u.name?.Trim(), stdUnit, StringComparison.OrdinalIgnoreCase))
                                          ?? uom.FirstOrDefault(u => string.Equals((u.name ?? "").Replace(" ", ""), stdUnit.Replace(" ", ""), StringComparison.OrdinalIgnoreCase));
                            if (matchedUom != null)
                            {
                                row.unitname = matchedUom.name;
                                row.defaultunitscode = (int)matchedUom.ucode;
                            }
                            else
                            {
                                row.unitname = stdUnit;
                                int newUcode = uom.Any() ? (int)uom.Max(x => x.ucode) + 1 : 1000;
                                uom.Add(new Booking.Models.UomMasterModel { ucode = newUcode, name = stdUnit });
                                row.defaultunitscode = newUcode;
                            }
                        }
                        else
                        {
                            var normName = cleanCol2;
                            if (normName.Contains("billirubin") || normName.Contains("bilirubin") || normName.Contains("urea") || 
                                normName.Contains("creatinine") || normName.Contains("uric") || normName.Contains("sugar") || 
                                normName.Contains("glucose") || normName.Contains("cholesterol") || normName.Contains("triglyceride") || 
                                normName.Contains("calcium") || normName.Contains("rbs") || normName.Contains("fbs") || normName.Contains("ppbs") ||
                                normName.Contains("bun"))
                            {
                                var mgdl = uom.FirstOrDefault(u => (u.name ?? "").Replace(" ", "").Equals("mg/dl", StringComparison.OrdinalIgnoreCase)) ?? uom.FirstOrDefault(u => u.ucode == 1);
                                if (mgdl != null)
                                {
                                    row.defaultunitscode = (int)mgdl.ucode;
                                    row.unitname = mgdl.name;
                                }
                            }
                            else if (normName.Contains("sgot") || normName.Contains("sgpt") || normName.Contains("ast") || 
                                     normName.Contains("alt") || normName.Contains("alp") || normName.Contains("phosphata") ||
                                     normName.Contains("ggt") || normName.Contains("amylase") || normName.Contains("lipase") ||
                                     normName.Contains("cpk") || normName.Contains("ldh"))
                            {
                                var ul = uom.FirstOrDefault(u => string.Equals((u.name ?? "").Trim(), "U/L", StringComparison.OrdinalIgnoreCase)) ?? uom.FirstOrDefault(u => u.ucode == 17);
                                if (ul != null)
                                {
                                    row.defaultunitscode = (int)ul.ucode;
                                    row.unitname = ul.name;
                                }
                            }
                            else if (normName.Contains("albumin") || normName.Contains("globulin") || normName.Contains("protein") || 
                                     normName.Contains("haemoglobin") || normName.Contains("hemoglobin") || normName.Equals("hb"))
                            {
                                var gdl = uom.FirstOrDefault(u => (u.name ?? "").Replace(" ", "").Equals("g/dl", StringComparison.OrdinalIgnoreCase)) ?? uom.FirstOrDefault(u => u.ucode == 7);
                                if (gdl != null)
                                {
                                    row.defaultunitscode = (int)gdl.ucode;
                                    row.unitname = gdl.name;
                                }
                            }
                            else if (normName.Contains("sodium") || normName.Contains("potassium") || normName.Contains("chloride") || normName.Contains("bicarbonate"))
                            {
                                var mmol = uom.FirstOrDefault(u => string.Equals((u.name ?? "").Trim(), "mmol/L", StringComparison.OrdinalIgnoreCase)) ?? uom.FirstOrDefault(u => u.ucode == 14);
                                if (mmol != null)
                                {
                                    row.defaultunitscode = (int)mmol.ucode;
                                    row.unitname = mmol.name;
                                }
                            }
                        }
                    }
                }

                // Guarantee unitname is present in uom for select dropdown
                if (!string.IsNullOrWhiteSpace(row.unitname) && uom != null)
                {
                    var existingUom = uom.FirstOrDefault(u => string.Equals(u.name?.Trim(), row.unitname.Trim(), StringComparison.OrdinalIgnoreCase));
                    if (existingUom != null)
                    {
                        row.unitname = existingUom.name ?? row.unitname;
                        if (row.defaultunitscode <= 0) row.defaultunitscode = (int)existingUom.ucode;
                    }
                    else
                    {
                        int newUcode = row.defaultunitscode > 0 ? row.defaultunitscode : (uom.Any() ? (int)uom.Max(x => x.ucode) + 1 : 1000);
                        uom.Add(new Booking.Models.UomMasterModel { ucode = newUcode, name = row.unitname.Trim() });
                    }
                }

                // Clean placeholder or empty normal values
                if (row.normalvalue != null)
                {
                    var trimmed = row.normalvalue.Trim();
                    if (trimmed == "-" || trimmed == "Normal 0" || trimmed == "0-0" || trimmed == "0 - 0" || trimmed == "()" || trimmed == "(-)" || trimmed == "0")
                    {
                        row.normalvalue = "";
                    }
                }

                // 3. Resolve normalvalue if empty
                if (string.IsNullOrWhiteSpace(row.normalvalue) && row.resultvaluetype != "Title" && row.resultvaluetype != "SubTitle")
                {
                    var masterNv = GetMasterNormalValueFromConfig(mConfig);
                    if (!string.IsNullOrWhiteSpace(masterNv))
                    {
                        row.normalvalue = masterNv;
                    }
                    else if (!string.IsNullOrWhiteSpace(row.defaultunitvalue) && row.defaultunitvalue != "-")
                    {
                        row.normalvalue = row.defaultunitvalue.Trim();
                    }
                    else if (!string.IsNullOrWhiteSpace(row.unitname) && QualitativeValues.Contains(row.unitname.Trim()))
                    {
                        row.normalvalue = "Negative";
                    }
                    else
                    {
                        string pName = (row.col2 ?? row.testname ?? "").ToLower();
                        if (pName.Contains("salmonella") || pName.Contains("dengue") || pName.Contains("malaria") || 
                            pName.Contains("ns-1") || pName.Contains("ns1") || pName.Contains("antigen") || 
                            pName.Contains("card") || pName.Contains("widal") || pName.Contains("hbsag") || 
                            pName.Contains("hcv") || pName.Contains("hiv") || pName.Contains("urobilinogen") || 
                            pName.Contains("bilirubin") || pName.Contains("bile"))
                        {
                            row.normalvalue = "Negative";
                        }
                    }
                }

                // If qualitative / card test and unitname is empty, default unitname to NEGATIVE
                if (string.IsNullOrWhiteSpace(row.unitname) && row.resultvaluetype != "Title" && row.resultvaluetype != "SubTitle")
                {
                    string pName = (row.col2 ?? row.testname ?? "").ToLower();
                    if (pName.Contains("salmonella") || pName.Contains("dengue") || pName.Contains("malaria") || 
                        pName.Contains("urobilinogen") || pName.Contains("bilirubin") || pName.Contains("bile"))
                    {
                        var neg = uom?.FirstOrDefault(u => string.Equals(u.name?.Trim(), "NEGATIVE", StringComparison.OrdinalIgnoreCase));
                        if (neg != null)
                        {
                            row.unitname = neg.name;
                            row.defaultunitscode = (int)neg.ucode;
                        }
                    }
                }

                // Map printresultonly, simplenv, and resultvaluetype from nested properties or _testConfigs
                if (row.labproperties?.Any() == true)
                {
                    var lp = row.labproperties.First();
                    row.printresultonly = lp.printresultonly ?? false;
                    row.simplenv = lp.simplenormalvalues ?? false;
                    if (string.IsNullOrEmpty(row.resultvaluetype))
                    {
                        row.resultvaluetype = lp.resultvaluetype;
                    }
                    if (string.IsNullOrWhiteSpace(row.footermessage) && !string.IsNullOrWhiteSpace(lp.footermessage))
                        row.footermessage = lp.footermessage;
                    if (string.IsNullOrWhiteSpace(row.conclusionforfixedtext) && !string.IsNullOrWhiteSpace(lp.conclusionforfixedtext) && !Guid.TryParse(lp.conclusionforfixedtext, out _))
                        row.conclusionforfixedtext = lp.conclusionforfixedtext;
                    if (string.IsNullOrWhiteSpace(row.conclusionforhigher) && !string.IsNullOrWhiteSpace(lp.conclusionforhigher))
                        row.conclusionforhigher = lp.conclusionforhigher;
                    if (string.IsNullOrWhiteSpace(row.conclusionforlower) && !string.IsNullOrWhiteSpace(lp.conclusionforlower))
                        row.conclusionforlower = lp.conclusionforlower;
                    if (lp.printconclusioninreport == true)
                        row.printconclusioninreport = true;
                    if (lp.printconclusioninbottom == true)
                        row.printconclusioninbottom = true;
                }
                else if (row.testproperties?.Any() == true)
                {
                    var p = row.testproperties.First();
                    row.printresultonly = p.printresultonly ?? false;
                    row.simplenv = p.simplenormalvalues ?? false;
                    if (string.IsNullOrEmpty(row.resultvaluetype))
                    {
                        row.resultvaluetype = p.resultvaluetype;
                    }
                    if (string.IsNullOrWhiteSpace(row.footermessage) && !string.IsNullOrWhiteSpace(p.footermessage))
                        row.footermessage = p.footermessage;
                    if (string.IsNullOrWhiteSpace(row.conclusionforfixedtext) && !string.IsNullOrWhiteSpace(p.conclusionforfixedtext) && !Guid.TryParse(p.conclusionforfixedtext, out _))
                        row.conclusionforfixedtext = p.conclusionforfixedtext;
                    if (string.IsNullOrWhiteSpace(row.conclusionforhigher) && !string.IsNullOrWhiteSpace(p.conclusionforhigher))
                        row.conclusionforhigher = p.conclusionforhigher;
                    if (string.IsNullOrWhiteSpace(row.conclusionforlower) && !string.IsNullOrWhiteSpace(p.conclusionforlower))
                        row.conclusionforlower = p.conclusionforlower;
                    if (p.printconclusioninreport == true)
                        row.printconclusioninreport = true;
                    if (p.printconclusioninbottom == true)
                        row.printconclusioninbottom = true;
                }
                else if (mConfig != null)
                {
                    if (mConfig.ResultProperties != null)
                    {
                        var mp = mConfig.ResultProperties;
                        row.printresultonly = mp.printresultonly ?? false;
                        row.simplenv = mp.simplenormalvalues ?? false;
                        if (string.IsNullOrEmpty(row.resultvaluetype))
                        {
                            row.resultvaluetype = mp.resultvaluetype;
                        }
                        if (string.IsNullOrWhiteSpace(row.footermessage) && !string.IsNullOrWhiteSpace(mp.footermessage))
                            row.footermessage = mp.footermessage;
                        if (string.IsNullOrWhiteSpace(row.conclusionforfixedtext) && !string.IsNullOrWhiteSpace(mp.conclusionforfixedtext) && !Guid.TryParse(mp.conclusionforfixedtext, out _))
                            row.conclusionforfixedtext = mp.conclusionforfixedtext;
                        if (string.IsNullOrWhiteSpace(row.conclusionforhigher) && !string.IsNullOrWhiteSpace(mp.conclusionforhigher))
                            row.conclusionforhigher = mp.conclusionforhigher;
                        if (string.IsNullOrWhiteSpace(row.conclusionforlower) && !string.IsNullOrWhiteSpace(mp.conclusionforlower))
                            row.conclusionforlower = mp.conclusionforlower;
                        if (mp.printconclusioninreport == true)
                            row.printconclusioninreport = true;
                        if (mp.printconclusioninbottom == true)
                            row.printconclusioninbottom = true;
                    }

                    if ((row.detailednormalvalues == null || !row.detailednormalvalues.Any()) && mConfig.DetailedNormalValues?.Any() == true)
                    {
                        row.detailednormalvalues = mConfig.DetailedNormalValues.Select(x => new Lab_Result_DetailedNormalValues
                        {
                            dnvid = x.trdnid,
                            trdnid = x.trdnid,
                            testresultid = row.testresultid,
                            sno = x.sno ?? 0,
                            agefrom = x.agefrom ?? 0,
                            agefromtype = x.agefromtype,
                            ageto = x.ageto ?? 0,
                            agetotype = x.agetotype,
                            agerangetype = x.agerangetype,
                            sex = x.sex,
                            rangetype = x.rangetype,
                            rangefrom = x.rangefrom ?? 0,
                            rangeto = x.rangeto ?? 0,
                            specialconditioncode = x.specialconditioncode
                        }).ToList();
                    }

                    if ((row.textnormalvalues == null || !row.textnormalvalues.Any()) && mConfig.TextNormalValues?.Any() == true)
                    {
                        row.textnormalvalues = mConfig.TextNormalValues.Select(x => new Lab_Result_TextNormalValues
                        {
                            trtid = x.trtid,
                            testresultid = row.testresultid,
                            sex = x.sex,
                            normalvalue = x.normalvalue
                        }).ToList();
                    }

                    if ((row.calculatedformulas == null || !row.calculatedformulas.Any()) && mConfig.CalculatedFormulas?.Any() == true)
                    {
                        row.calculatedformulas = mConfig.CalculatedFormulas.Select(x => new Lab_Result_CalculatedFormula
                        {
                            trcfid = x.trcfid,
                            testresultid = row.testresultid,
                            sex = x.sex,
                            calculatedformula = x.calculatedformula
                        }).ToList();
                    }
                }

                // Do not auto-assign default method if none is set (rtmcode 0 = no method)
                if (row.rtmcode < 0)
                {
                    row.rtmcode = 0;
                }

                if (row.normalvalue != null) row.normalvalue = row.normalvalue.Replace("Normal 0", "").Trim();
                
                // Populate col2 with testname if empty, but protect profile/group tests where testname holds the group/profile name
                if (string.IsNullOrEmpty(row.col2) && !string.IsNullOrEmpty(row.testname))
                {
                    bool isParentTestName = row.testname.Equals(row.groupname, StringComparison.OrdinalIgnoreCase) || 
                                            row.testname.Contains("Profile", StringComparison.OrdinalIgnoreCase) || 
                                            row.testname.Contains("Panel", StringComparison.OrdinalIgnoreCase) ||
                                            row.testname.Contains("Package", StringComparison.OrdinalIgnoreCase);
                    
                    if (!isParentTestName)
                    {
                        row.col2 = row.testname;
                    }
                }

                // Ensure DetailedNormalValues required fields are never null (backend [Required] validation)
                if (row.detailednormalvalues != null)
                {
                    foreach (var dnv in row.detailednormalvalues)
                    {
                        // Normalise "Yrs" â†’ "Years" for consistency
                        if (string.IsNullOrEmpty(dnv.agefromtype))  dnv.agefromtype  = "Years";
                        else if (dnv.agefromtype == "Yrs")          dnv.agefromtype  = "Years";
                        if (string.IsNullOrEmpty(dnv.agetotype))    dnv.agetotype    = "Years";
                        else if (dnv.agetotype == "Yrs")            dnv.agetotype    = "Years";
                        if (string.IsNullOrEmpty(dnv.agerangetype)) dnv.agerangetype = "Normal";
                        if (string.IsNullOrEmpty(dnv.sex))          dnv.sex          = "Both";
                        if (string.IsNullOrEmpty(dnv.rangetype))    dnv.rangetype    = "Normal";
                    }
                }
                
                var m = re.methods?.FirstOrDefault(x => x.rtmcode == row.rtmcode);
                string mName = m?.name ?? "";

                string cleanNV = row.normalvalue?.Trim(' ', '/', '(', ')') ?? "";
                bool isPlaceholder = string.IsNullOrWhiteSpace(cleanNV) || 
                                     cleanNV.StartsWith("(") ||
                                     cleanNV.Equals(mName, StringComparison.OrdinalIgnoreCase) || 
                                     cleanNV.Equals($"({mName})", StringComparison.OrdinalIgnoreCase) ||
                                     cleanNV.Contains("<0") ||
                                     cleanNV.Replace(" ", "") == "0-0" ||
                                     cleanNV.Contains("Normal 0");

                if (isPlaceholder)
                {
                    // â”€â”€ Build normalvalue from TextNormalValues â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
                    if (row.textnormalvalues?.Any(x => !string.IsNullOrEmpty(x.normalvalue)) == true)
                    {
                        var nvParts = row.textnormalvalues
                            .Where(x => !string.IsNullOrEmpty(x.normalvalue))
                            .Select(x =>
                            {
                                if (string.IsNullOrEmpty(x.sex)) return x.normalvalue!;
                                var sex = x.sex.Trim();
                                var label = sex.Equals("M", StringComparison.OrdinalIgnoreCase) ? "Males" :
                                            sex.Equals("F", StringComparison.OrdinalIgnoreCase) ? "Females" :
                                            sex.Equals("Both", StringComparison.OrdinalIgnoreCase) || sex == "-" ? "" : sex;
                                return string.IsNullOrEmpty(label) ? x.normalvalue! : $"{label} : {x.normalvalue}";
                            });
                        row.normalvalue = string.Join(" | ", nvParts);
                    }
                    // â”€â”€ Build normalvalue from DetailedNormalValues (range format) â”€â”€
                    else if (row.detailednormalvalues?.Any() == true)
                    {
                        var dParts = row.detailednormalvalues.Select(d =>
                        {
                            string r = d.rangetype == "Range" || string.IsNullOrEmpty(d.rangetype) || d.rangetype == "-"
                                ? $"{d.rangefrom} - {d.rangeto}"
                                : d.rangetype == "Upto" || d.rangetype == "Less than"
                                ? $"< {d.rangeto}"
                                : $"{d.rangetype} {d.rangefrom}";

                            string sexLbl = (d.sex == "Both" || d.sex == "-" || string.IsNullOrEmpty(d.sex)) ? "" : $"{d.sex}: ";
                            return $"{sexLbl}{r}".Trim();
                        }).Distinct();
                        row.normalvalue = string.Join(" | ", dParts);
                    }
                    // â”€â”€ Fallback to master template config (fromnormalvalue / tonormalvalue / normalvalue) â”€â”€
                    else if (mConfig != null)
                    {
                        if (mConfig.TextNormalValues?.Any(x => !string.IsNullOrEmpty(x.normalvalue)) == true)
                        {
                            var nvParts = mConfig.TextNormalValues
                                .Where(x => !string.IsNullOrEmpty(x.normalvalue))
                                .Select(x => x.normalvalue!);
                            row.normalvalue = string.Join(" | ", nvParts);
                        }
                        else if (mConfig.DetailedNormalValues?.Any() == true)
                        {
                            var dParts = mConfig.DetailedNormalValues.Select(d =>
                            {
                                string r = d.rangetype == "Range" || string.IsNullOrEmpty(d.rangetype) || d.rangetype == "-"
                                    ? $"{d.rangefrom} - {d.rangeto}"
                                    : d.rangetype == "Upto" || d.rangetype == "Less than"
                                    ? $"< {d.rangeto}"
                                    : $"{d.rangetype} {d.rangefrom}";

                                string sexLbl = (d.sex == "Both" || d.sex == "-" || string.IsNullOrEmpty(d.sex)) ? "" : $"{d.sex}: ";
                                return $"{sexLbl}{r}".Trim();
                            }).Distinct();
                            row.normalvalue = string.Join(" | ", dParts);
                        }
                        else if (mConfig.ResultProperties != null)
                        {
                            var rp = mConfig.ResultProperties;
                            if (!string.IsNullOrWhiteSpace(rp.normalvalue) && !rp.normalvalue.StartsWith("("))
                            {
                                row.normalvalue = rp.normalvalue;
                            }
                            else if (rp.fromnormalvalue.HasValue || rp.tonormalvalue.HasValue)
                            {
                                double fVal = rp.fromnormalvalue ?? 0;
                                double tVal = rp.tonormalvalue ?? 0;
                                string op = (rp.rangetype ?? "").Trim();

                                if (fVal > 0 || tVal > 0)
                                {
                                    if (op.Equals("Upto", StringComparison.OrdinalIgnoreCase))
                                        row.normalvalue = $"Upto {(tVal > 0 ? tVal : fVal)}";
                                    else if (op.Equals("Less than", StringComparison.OrdinalIgnoreCase) || op == "<")
                                        row.normalvalue = $"< {(tVal > 0 ? tVal : fVal)}";
                                    else if (op.Equals("More than", StringComparison.OrdinalIgnoreCase) || op == ">")
                                        row.normalvalue = $"> {fVal}";
                                    else
                                        row.normalvalue = (fVal == 0) ? $"0 - {tVal}" : $"{fVal} - {tVal}";
                                }
                            }
                        }
                    }
                }
                
                // Final cleanup: remove any leftover method parentheses or trailing slashes
                if (row.normalvalue != null) row.normalvalue = row.normalvalue.Trim(' ', '/');
            }

            // Final Title headline and single-parameter deduplication pass:
            foreach (var testGrp in lre1.GroupBy(x => GetParentTCode(x)).ToList())
            {
                long tcode = testGrp.Key;
                bool isMultiParam = false;
                if (_testConfigs.TryGetValue(tcode, out var cfg) && cfg.ResultRows != null && cfg.ResultRows.Count > 1)
                {
                    isMultiParam = true;
                }
                else
                {
                    var distinctParams = testGrp
                        .Where(r => r.resultvaluetype != "Title" && r.resultvaluetype != "SubTitle" && !string.Equals(r.col2?.Trim(), "NLR", StringComparison.OrdinalIgnoreCase))
                        .Select(r => (r.col2 ?? r.testname ?? "").Trim().ToLowerInvariant())
                        .Distinct()
                        .ToList();
                    if (distinctParams.Count > 1) isMultiParam = true;
                }

                if (!isMultiParam && testGrp.Count() > 1)
                {
                    bool isMasterTitle = false;
                    if (_testConfigs.TryGetValue(tcode, out var cfgM) && cfgM.ResultRows?.Any() == true)
                    {
                        var mFirst = cfgM.ResultRows.First();
                        string mType = mFirst.ResultProperties?.resultvaluetype ?? "";
                        isMasterTitle = string.Equals(mType, "Title", StringComparison.OrdinalIgnoreCase);
                    }

                    var bestRow = isMasterTitle
                                ? (testGrp.FirstOrDefault(r => r.resultvaluetype == "Title") ?? testGrp.First())
                                : (testGrp.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.enteredresult) && r.enteredresult != "-")
                                ?? testGrp.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.normalvalue) && r.resultvaluetype != "Title")
                                ?? testGrp.FirstOrDefault(r => r.resultvaluetype != "Title")
                                ?? testGrp.First());

                    if (isMasterTitle)
                    {
                        bestRow.resultvaluetype = "Title";
                        bestRow.printresultonly = true;
                        bestRow.enteredresult = "";
                        bestRow.unitname = "";
                        bestRow.normalvalue = "";
                    }
                    else
                    {
                        bestRow.resultvaluetype = "Numeric";
                        bestRow.printresultonly = false;
                    }

                    var toRemove = testGrp.Where(r => r != bestRow).ToList();
                    foreach (var dup in toRemove)
                    {
                        lre1.Remove(dup);
                    }
                }
                else
                {
                    var titles = testGrp.Where(r => r.resultvaluetype == "Title").ToList();
                    if (titles.Count > 1)
                    {
                        for (int i = 1; i < titles.Count; i++)
                        {
                            lre1.Remove(titles[i]);
                        }
                    }
                }
            }

            // â”€â”€ Test group conclusion & footer propagation: ONLY on the LAST row of each billed test group â”€â”€
            if (lre1 != null && lre1.Any())
            {
                lre1 = SortLabResultEntries(lre1);

                var testGroupsLoad = lre1.GroupBy(r => GetParentTCode(r));
                foreach (var group in testGroupsLoad)
                {
                    var groupList = group.ToList();
                    var lastRow = groupList.Last();

                    // Find parent test code for this billed test group
                    long mainTCode = groupList.FirstOrDefault(r => r.fromtcode > 0)?.fromtcode ?? (groupList.FirstOrDefault(r => r.fromtcode == 0) ?? groupList.First()).tcode;

                    // Fetch Test Master footer for the parent test
                    string testMasterFooter = (mainTCode > 0 && _testConfigs.TryGetValue(mainTCode, out var cfgGLoad)) ? (cfgGLoad.TestMaster?.footer ?? "") : "";

                    // Clear footer and conclusion on ALL non-last rows in the billed test group
                    for (int k = 0; k < groupList.Count - 1; k++)
                    {
                        groupList[k].footermessage = "";
                        groupList[k].conclusionforfixedtext = "";
                    }

                    // Gather existing footer or conclusion text across the entire group
                    string existingCustomFooter = groupList.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.footermessage))?.footermessage ?? "";
                    string existingCustomConclusion = groupList.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.conclusionforfixedtext) && !Guid.TryParse(r.conclusionforfixedtext, out _))?.conclusionforfixedtext ?? "";

                    // Resolve footer text for LAST row: prioritize custom entered footer/conclusion, otherwise test master footer
                    string resolvedText = !string.IsNullOrWhiteSpace(lastRow.footermessage)
                        ? lastRow.footermessage
                        : (!string.IsNullOrWhiteSpace(lastRow.conclusionforfixedtext) && !Guid.TryParse(lastRow.conclusionforfixedtext, out _)
                            ? lastRow.conclusionforfixedtext
                            : (!string.IsNullOrWhiteSpace(existingCustomFooter)
                                ? existingCustomFooter
                                : (!string.IsNullOrWhiteSpace(existingCustomConclusion)
                                    ? existingCustomConclusion
                                    : (!string.IsNullOrWhiteSpace(testMasterFooter) ? testMasterFooter : ""))));

                    if (!string.IsNullOrWhiteSpace(resolvedText))
                    {
                        string cleanedText = StripHtml(resolvedText);
                        lastRow.conclusionforfixedtext = cleanedText;
                        lastRow.footermessage = "";
                        lastRow.printconclusioninreport = true;
                    }
                    else
                    {
                        lastRow.footermessage = "";
                        lastRow.conclusionforfixedtext = "";
                    }
                }
            }

            // Build group list â€” distinct gcode + groupname from lre1
            groupList = lre1
                .Where(x => x.gcode > 0 && !string.IsNullOrWhiteSpace(x.groupname))
                .GroupBy(x => x.gcode)
                .Select(g => new GroupItem { gcode = g.Key, groupname = g.First().groupname! })
                .OrderBy(g => g.groupname)
                .ToList();

            // Build billed test list scoped to current group (default: All Groups)
            billedTestSelections = BuildBilledTestSelections(SelectedGroupCode);

            // Apply incoming query filter if specified
            if (!string.IsNullOrWhiteSpace(FilterTCode) || !string.IsNullOrWhiteSpace(FilterTestName))
            {
                ApplyIncomingTestFilter();
            }

            // Apply active filters to the newly loaded data
            ApplyUnifiedFilter();
            
            // Trigger calculations for any pre-filled data
            _ = RunCalculations();
            
            UpdateUserNames();
            LoadAuditHistory();
            if (lre1 != null)
            {
                foreach (var r in lre1)
                {
                    GetAuditItem(r);
                }
            }

            _ = Task.Run(async () =>
            {
                await LoadPatientDetailsAsync();
            });
        }
        else
        {
            var tt = await res.Content.ReadAsStringAsync(ct);
            /* Console.WriteLine($"LoadResults failed: {res.StatusCode} - {tt}") */;
            _ = Task.Run(async () =>
            {
                await LoadPatientDetailsAsync();
            });
        }
        StateHasChanged();
        } // end try
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception ex) { /* Console.WriteLine($"LoadResults Error: {ex.Message}") */; }
    }


    private List<DeltaResult>? deltaResults;
    private bool isDeltaLoading = false;
    private bool isDeltaModalOpen = false;

    private void CloseDeltaModal()
    {
        isDeltaModalOpen = false;
    }

    private string GetResultBgClass(LabResultEntry row)
    {
        if (string.IsNullOrWhiteSpace(row.enteredresult) || !double.TryParse(row.enteredresult, out double res))
        {
            row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
            return "";
        }

        string nv = row.normalvalue ?? "";
        // Define a dash pattern that covers hyphen, en-dash, and em-dash
        string dash = @"[\-\u2013\u2014]";

        // 1. Check for explicit "Borderline" ranges
        var borderMatch = Regex.Match(nv, @"(\d+\.?\d*)\s*" + dash + @"\s*(\d+\.?\d*)\s*[:\-]?\s*Borderline", RegexOptions.IgnoreCase);
        if (!borderMatch.Success) borderMatch = Regex.Match(nv, @"Borderline\s*[:\-]?\s*(\d+\.?\d*)\s*" + dash + @"\s*(\d+\.?\d*)", RegexOptions.IgnoreCase);
        
        if (borderMatch.Success)
        {
            if (double.TryParse(borderMatch.Groups[1].Value, out double bMin) && 
                double.TryParse(borderMatch.Groups[2].Value, out double bMax))
            {
                if (res >= bMin && res <= bMax)
                {
                    row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
                    return "re-bg-yellow";
                }
            }
        }

        // 2. Check for "Normal" or "Desirable" ranges
        var normalRangeMatch = Regex.Match(nv, @"(\d+\.?\d*)\s*" + dash + @"\s*(\d+\.?\d*)\s*[:\-]?\s*(Normal|Desirable)", RegexOptions.IgnoreCase);
        if (normalRangeMatch.Success)
        {
            if (double.TryParse(normalRangeMatch.Groups[1].Value, out double nMin) && 
                double.TryParse(normalRangeMatch.Groups[2].Value, out double nMax))
            {
                if (res >= nMin && res <= nMax)
                {
                    row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
                    return "re-bg-green";
                }
            }
        }
        else
        {
            normalRangeMatch = Regex.Match(nv, @"(Normal|Desirable)\s*[:\-]?\s*(\d+\.?\d*)\s*" + dash + @"\s*(\d+\.?\d*)", RegexOptions.IgnoreCase);
            if (normalRangeMatch.Success)
            {
                if (double.TryParse(normalRangeMatch.Groups[2].Value, out double nMin) && 
                    double.TryParse(normalRangeMatch.Groups[3].Value, out double nMax))
                {
                    if (res >= nMin && res <= nMax)
                    {
                        row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
                        return "re-bg-green";
                    }
                }
            }
        }

        // 3. Check for Normal/Desirable limits (< X or > X)
        var ltMatch = Regex.Match(nv, @"<\s*(\d+\.?\d*)");
        if (ltMatch.Success && double.TryParse(ltMatch.Groups[1].Value, out double ltLimit))
        {
            if (res < ltLimit)
            {
                row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
                return "re-bg-green";
            }
        }

        var gtMatch = Regex.Match(nv, @">\s*(\d+\.?\d*)");
        if (gtMatch.Success && double.TryParse(gtMatch.Groups[1].Value, out double gtLimit))
        {
            if (res > gtLimit)
            {
                row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
                return "re-bg-green";
            }
        }

        // 4. Fallback to generic min-max range check
        var genericMatch = Regex.Match(nv, @"(\d+\.?\d*)\s*" + dash + @"\s*(\d+\.?\d*)");
        if (genericMatch.Success)
        {
            if (double.TryParse(genericMatch.Groups[1].Value, out double fMin) && 
                double.TryParse(genericMatch.Groups[2].Value, out double fMax))
            {
                if (res > fMax) { row.resulthigh = true; row.resultlow = false; row.resultnormal = false; return "re-bg-red"; }
                if (res < fMin) { row.resulthigh = false; row.resultlow = true; row.resultnormal = false; return "re-bg-red"; }
                
                row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
                return "re-bg-green";
            }
        }

        // 5. Absolute High/Low detection based on any numbers in the string
        var numbers = Regex.Matches(nv, @"\d+\.?\d*").Cast<Match>()
            .Select(m => { double.TryParse(m.Value, out double d); return d; })
            .ToList();

        if (numbers.Any())
        {
            double absMax = numbers.Max();
            double absMin = numbers.Min();
            if (res > absMax) { row.resulthigh = true; row.resultlow = false; row.resultnormal = false; return "re-bg-red"; }
            if (res < absMin) { row.resulthigh = false; row.resultlow = true; row.resultnormal = false; return "re-bg-red"; }
        }

        row.resulthigh = false; row.resultlow = false; row.resultnormal = true;
        return "";
    }

    private async Task FetchDeltaCheck()
    {
        if (_isDisposed || string.IsNullOrEmpty(CustCode)) return;
        isDeltaModalOpen = true;
        isDeltaLoading = true;
        StateHasChanged();
        try
        {
            var url = $"api/LabResult/deltacheck?custcode={Uri.EscapeDataString(CustCode)}";
            var request = new HttpRequestMessage(HttpMethod.Get, url);
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            if (!string.IsNullOrEmpty(tenantCode))
                request.Headers.Add("tenant_code", tenantCode);

            var ct = SafeToken;
            var res = await ClientFactory.CreateClient("Medico").SendAsync(request, ct);
            if (!res.IsSuccessStatusCode)
            {
                var fallbackUrl = $"api/Request/deltacheck?custcode={Uri.EscapeDataString(CustCode)}";
                var fallbackReq = new HttpRequestMessage(HttpMethod.Get, fallbackUrl);
                if (!string.IsNullOrEmpty(token)) fallbackReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                if (!string.IsNullOrEmpty(tenantCode)) fallbackReq.Headers.Add("tenant_code", tenantCode);
                res = await ClientFactory.CreateClient("Medico").SendAsync(fallbackReq, ct);
            }

            if (res.IsSuccessStatusCode)
            {
                var content = await res.Content.ReadAsStringAsync(ct);
                try
                {
                    var nested = JsonConvert.DeserializeObject<List<List<CustomerResultDto>>>(content);
                    if (nested != null && nested.Any())
                    {
                        deltaResults = nested.SelectMany(x => x)
                            .Where(x => !string.IsNullOrEmpty(x.TestName))
                            .GroupBy(x => x.TestName.Trim(), StringComparer.OrdinalIgnoreCase)
                            .Select(g => new DeltaResult { TestName = g.Key, Result = g.First().Result })
                            .ToList();
                    }
                    else
                    {
                        deltaResults = JsonConvert.DeserializeObject<List<DeltaResult>>(content);
                    }
                }
                catch
                {
                    deltaResults = JsonConvert.DeserializeObject<List<DeltaResult>>(content);
                }
                
                // Calculate missing formula values for previous results
                if (deltaResults != null && deltaResults.Any())
                {
                    CalculatePreviousFormulas();
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Delta Check Error: {ex.Message}") */;
        }
        finally
        {
            isDeltaLoading = false;
            StateHasChanged();
        }
    }

    private void CalculatePreviousFormulas()
    {
        if (deltaResults == null || lre1 == null) return;

        try
        {
            // 1. Build a parameter dictionary from the historical data
            var histParams = new Dictionary<string, object>();
            foreach (var dr in deltaResults)
            {
                if (double.TryParse(dr.Result, out double val))
                {
                    var matchingRow = lre1.FirstOrDefault(x => (x.col2 ?? "").Trim().ToLower() == (dr.TestName ?? "").Trim().ToLower());
                    if (matchingRow != null)
                    {
                        histParams[matchingRow.tcode.ToString()] = val;
                        histParams[matchingRow.testresultid.ToString().ToLower()] = val;
                        string safeName = (matchingRow.col2 ?? "").Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "").Replace(".", "");
                        histParams[safeName] = val;
                    }
                }
            }

            // 2. Loop through our master list and calculate any formulas for the previous data
            foreach (var row in lre1)
            {
                if (row.resultvaluetype == "Calculated Value" && !string.IsNullOrEmpty(row.calculatedformula))
                {
                    // Check if this test already has a result in deltaResults
                    var existingDelta = deltaResults.FirstOrDefault(d => (d.TestName ?? "").Trim().ToLower() == (row.col2 ?? "").Trim().ToLower());
                    
                    // If it's empty or a GUID, try to calculate it
                    if (existingDelta == null || string.IsNullOrEmpty(existingDelta.Result) || Guid.TryParse(existingDelta.Result, out _))
                    {
                        try
                        {
                            var parts = row.calculatedformula.Split('|', StringSplitOptions.RemoveEmptyEntries);
                            var processedFormula = new System.Text.StringBuilder();
                            foreach (var p in parts)
                            {
                                string part = p.Trim();
                                if (Guid.TryParse(part, out _) || int.TryParse(part, out _))
                                    processedFormula.Append($"[{part}]");
                                else
                                    processedFormula.Append(part);
                            }

                            var expr = new Expression(processedFormula.ToString());
                            foreach (var kvp in histParams) { expr.Parameters[kvp.Key] = kvp.Value; }
                            var res = expr.Evaluate();
                            if (res != null)
                            {
                                string calcVal = res.ToString();
                                if (double.TryParse(calcVal, out double num))
                                    calcVal = Math.Round(num, 2).ToString();

                                if (existingDelta != null)
                                    existingDelta.Result = calcVal;
                                else
                                    deltaResults.Add(new DeltaResult { TestName = row.col2, Result = calcVal });
                            }
                        }
                        catch { }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error calculating previous formulas: {ex.Message}") */;
        }
    }

    private void ClearEntry()
    {
        // Reset all entered results in lre1
        foreach (var row in lre1)
        {
            row.enteredresult = string.Empty;
        }
        StateHasChanged();
    }

    // â”€â”€ DeleteSubRow â€” removes a sub-test row from the grid â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private void DeleteSubRow(LabResultEntry row)
    {
        if (row == null) return;
        lre1.Remove(row);
        lre.Remove(row);

        // Cleanup associated Delta Check entry if it exists
        if (deltaResults != null && !string.IsNullOrEmpty(row.col2))
        {
            var matchingDelta = deltaResults.FirstOrDefault(d => (d.TestName ?? "").Trim().ToLower() == row.col2.Trim().ToLower());
            if (matchingDelta != null)
            {
                deltaResults.Remove(matchingDelta);
            }
        }

        StateHasChanged();
    }


    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, (LabCare.Models.TestInsertDto Dto, DateTime CachedAt)> _staticTestConfigs = new();
    private static string? _cachedTenantCodeForTestMasters;
    private static HashSet<long>? _cachedLockedTcodes;
    private static HashSet<string>? _cachedLockedTestNames;
    private static Dictionary<long, Booking.Models.TestMasterModel>? _cachedTestMastersByTCode;
    private static Dictionary<string, Booking.Models.TestMasterModel>? _cachedTestMastersByName;
    private Dictionary<long, LabCare.Models.TestInsertDto> _testConfigs = new();

    private static readonly HashSet<string> QualitativeValues = new(StringComparer.OrdinalIgnoreCase)
    {
        "NEGATIVE", "POSITIVE", "REACTIVE", "NON-REACTIVE", "NON REACTIVE",
        "CLEAR", "CLOUDY", "TURBID", "SLIGHTLY CLOUDY", "SLIGHT TURBID",
        "NIL", "ABSENT", "PRESENT", "NORMAL", "NOT DETECTED", "DETECTED",
        "YELLOW", "PALE YELLOW", "STRAW", "AMBER", "TRACE", "MODERATE"
    };

    private static string NormalizeParamName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        return System.Text.RegularExpressions.Regex.Replace(name, @"[^a-zA-Z0-9]", "").ToLowerInvariant();
    }

    public static void InvalidateAllTestConfigs()
    {
        _staticTestConfigs.Clear();
        _cachedTenantCodeForTestMasters = null;
        _cachedLockedTcodes = null;
        _cachedLockedTestNames = null;
        _cachedTestMastersByTCode = null;
        _cachedTestMastersByName = null;
    }

    public static void InvalidateTestConfig(long tcode)
    {
        foreach (var key in _staticTestConfigs.Keys.Where(k => k.EndsWith($"_{tcode}")).ToList())
        {
            _staticTestConfigs.TryRemove(key, out _);
        }
        if (_cachedTestMastersByTCode != null)
        {
            _cachedTestMastersByTCode.Remove(tcode);
        }
    }

    private LabCare.Models.TestResultRowDto? FindMatchingTestResultRow(LabResultEntry? row)
    {
        if (row == null) return null;
        long targetTCode = row.fromtcode > 0 ? (long)row.fromtcode : row.tcode;
        long parentTCode = (long)row.tcode;
        long pBilledTCode = GetParentTCode(row);

        var cleanCol2 = (row.col2 ?? row.testname ?? "").Trim().ToLower();
        var normRowName = NormalizeParamName(row.col2 ?? row.testname);

        var configsToSearch = new List<LabCare.Models.TestInsertDto>();
        if (_testConfigs.TryGetValue(targetTCode, out var cfg1) && cfg1?.ResultRows?.Any() == true) configsToSearch.Add(cfg1);
        if (parentTCode != targetTCode && _testConfigs.TryGetValue(parentTCode, out var cfg2) && cfg2?.ResultRows?.Any() == true) configsToSearch.Add(cfg2);
        if (pBilledTCode > 0 && !configsToSearch.Any(c => c.TestMaster?.tcode == pBilledTCode) && _testConfigs.TryGetValue(pBilledTCode, out var cfgP) && cfgP?.ResultRows?.Any() == true) configsToSearch.Add(cfgP);
        foreach (var cfgExtra in _testConfigs.Values)
        {
            if (cfgExtra?.ResultRows?.Any() == true && !configsToSearch.Contains(cfgExtra))
                configsToSearch.Add(cfgExtra);
        }

        foreach (var cfg in configsToSearch)
        {
            // 1. Guid matches
            var mConfig = cfg.ResultRows.FirstOrDefault(r => row.fromtestresultid.HasValue && row.fromtestresultid.Value != Guid.Empty && r.ResultMaster?.testresultid == row.fromtestresultid)
                       ?? cfg.ResultRows.FirstOrDefault(r => row.testresultid.HasValue && row.testresultid.Value != Guid.Empty && r.ResultMaster?.testresultid == row.testresultid);

            // 2. Exact match on cellcontent or col2
            if (mConfig == null)
            {
                mConfig = cfg.ResultRows.FirstOrDefault(r => !string.IsNullOrEmpty(r.ResultMaster?.cellcontent) && r.ResultMaster.cellcontent.Trim().Equals(cleanCol2, StringComparison.OrdinalIgnoreCase))
                       ?? cfg.ResultRows.FirstOrDefault(r => !string.IsNullOrEmpty(r.ResultMaster?.col2) && r.ResultMaster.col2.Trim().Equals(cleanCol2, StringComparison.OrdinalIgnoreCase));
            }

            // 3. Normalized alphanumeric match (ignores spaces, hyphens, slashes, brackets)
            if (mConfig == null && !string.IsNullOrEmpty(normRowName))
            {
                mConfig = cfg.ResultRows.FirstOrDefault(r => {
                    var rNorm = NormalizeParamName(r.ResultMaster?.cellcontent ?? r.ResultMaster?.col2);
                    if (string.IsNullOrEmpty(rNorm)) return false;
                    return rNorm == normRowName || rNorm.Contains(normRowName) || normRowName.Contains(rNorm);
                });
            }

            // 4. Token / word substring match
            if (mConfig == null)
            {
                mConfig = cfg.ResultRows.FirstOrDefault(r => {
                    var rName = (r.ResultMaster?.cellcontent ?? r.ResultMaster?.col2 ?? "").Trim().ToLower();
                    if (string.IsNullOrEmpty(rName)) return false;
                    return rName == cleanCol2
                        || (cleanCol2.Length >= 3 && rName.Contains(cleanCol2))
                        || (rName.Length >= 3 && cleanCol2.Contains(rName));
                });
            }

            if (mConfig != null) return mConfig;
        }

        return null;
    }

    private string GetMasterNormalValueFromConfig(LabCare.Models.TestResultRowDto? mConfig)
    {
        if (mConfig == null) return "";

        // 1. Detailed Normal Values (if detailednormalvalues enabled or ranges present)
        if (mConfig.ResultProperties?.detailednormalvalues == true && mConfig.DetailedNormalValues?.Any() == true)
        {
            var mappedDnv = mConfig.DetailedNormalValues.Select(x => new Lab_Result_DetailedNormalValues
            {
                dnvid = x.trdnid,
                trdnid = x.trdnid,
                sno = x.sno ?? 0,
                agefrom = x.agefrom ?? 0,
                agefromtype = !string.IsNullOrEmpty(x.agefromtype) ? (x.agefromtype == "Yrs" ? "Years" : x.agefromtype) : "Years",
                ageto = x.ageto ?? 0,
                agetotype = !string.IsNullOrEmpty(x.agetotype) ? (x.agetotype == "Yrs" ? "Years" : x.agetotype) : "Years",
                agerangetype = !string.IsNullOrEmpty(x.agerangetype) ? x.agerangetype : "Normal",
                sex = !string.IsNullOrEmpty(x.sex) ? x.sex : "Both",
                rangetype = !string.IsNullOrEmpty(x.rangetype) ? x.rangetype : "Normal",
                rangefrom = x.rangefrom ?? 0,
                rangeto = x.rangeto ?? 0,
                specialconditioncode = x.specialconditioncode
            }).ToList();
            var dnvStr = FormatNormalValueFromDetailed(mappedDnv);
            if (!string.IsNullOrWhiteSpace(dnvStr)) return dnvStr;
        }

        // 2. Text Normal Values
        if (mConfig.TextNormalValues?.Any(x => !string.IsNullOrWhiteSpace(x.normalvalue)) == true)
        {
            var nvParts = mConfig.TextNormalValues
                .Where(x => !string.IsNullOrWhiteSpace(x.normalvalue))
                .Select(x =>
                {
                    if (string.IsNullOrWhiteSpace(x.sex) || x.sex == "Both" || x.sex == "-") return x.normalvalue!.Trim();
                    var sex = x.sex.Trim();
                    var label = (sex.Equals("M", StringComparison.OrdinalIgnoreCase) || sex.Equals("Male", StringComparison.OrdinalIgnoreCase)) ? "Males" :
                                (sex.Equals("F", StringComparison.OrdinalIgnoreCase) || sex.Equals("Female", StringComparison.OrdinalIgnoreCase)) ? "Females" : sex;
                    return $"{label} : {x.normalvalue.Trim()}";
                });
            var tnvStr = string.Join(" | ", nvParts);
            if (!string.IsNullOrWhiteSpace(tnvStr)) return tnvStr;
        }

        // 3. Simple Normal Value text from ResultProperties
        if (!string.IsNullOrWhiteSpace(mConfig.ResultProperties?.normalvalue) && !mConfig.ResultProperties.normalvalue.StartsWith("("))
        {
            var nv = mConfig.ResultProperties.normalvalue.Trim();
            if (nv != "-" && nv != "Normal 0" && nv != "0-0" && nv != "0 - 0" && nv != "()" && nv != "(-)" && nv != "0")
            {
                return nv;
            }
        }

        // 4. Check col3 if it holds qualitative value (e.g. "NEGATIVE", "CLEAR", "NON-REACTIVE")
        if (!string.IsNullOrWhiteSpace(mConfig.ResultMaster?.col3))
        {
            var c3 = mConfig.ResultMaster.col3.Trim();
            if (QualitativeValues.Contains(c3))
            {
                return c3;
            }
        }

        // 5. Check col4 from test_result_master (often reference range text in LIMS)
        if (!string.IsNullOrWhiteSpace(mConfig.ResultMaster?.col4))
        {
            var c4 = mConfig.ResultMaster.col4.Trim();
            if (c4 != "-" && c4 != "Normal 0" && c4 != "0-0" && c4 != "0 - 0" && c4 != "()" && c4 != "(-)" && c4 != "0")
            {
                return c4;
            }
        }

        // 6. Check defaultvalue if qualitative (e.g. "Negative", "Clear", "Nil")
        if (!string.IsNullOrWhiteSpace(mConfig.ResultProperties?.defaultvalue))
        {
            var dv = mConfig.ResultProperties.defaultvalue.Trim();
            if (QualitativeValues.Contains(dv))
            {
                return dv;
            }
        }

        // 7. Check normalfemale if female patient
        if (PatientGender?.StartsWith("F", StringComparison.OrdinalIgnoreCase) == true && !string.IsNullOrWhiteSpace(mConfig.ResultMaster?.normalfemale))
        {
            var nf = mConfig.ResultMaster.normalfemale.Trim();
            if (nf != "-" && nf != "Normal 0" && nf != "0-0" && nf != "0 - 0" && nf != "0")
            {
                return nf;
            }
        }

        // 8. Numeric Range (fromnormalvalue - tonormalvalue)
        if (mConfig.ResultProperties != null && (mConfig.ResultProperties.fromnormalvalue.HasValue || mConfig.ResultProperties.tonormalvalue.HasValue))
        {
            double fVal = mConfig.ResultProperties.fromnormalvalue ?? 0;
            double tVal = mConfig.ResultProperties.tonormalvalue ?? 0;
            string op = (mConfig.ResultProperties.rangetype ?? "").Trim();
            if (fVal > 0 || tVal > 0)
            {
                if (op.Equals("Upto", StringComparison.OrdinalIgnoreCase) || op.Equals("Less than", StringComparison.OrdinalIgnoreCase) || op == "<" || op == "<=")
                    return $"< {(tVal > 0 ? tVal : fVal)}";
                if (op.Equals("More than", StringComparison.OrdinalIgnoreCase) || op == ">" || op == ">=")
                    return $"> {fVal}";
                if (fVal > 0 && tVal > 0)
                    return $"{fVal} - {tVal}";
                if (fVal == 0 && tVal > 0)
                    return $"0 - {tVal}";
                if (fVal > 0 && tVal == 0)
                    return $"{fVal}";
            }
        }

        // 9. Detailed Normal Values fallback even if flag wasn't explicitly set
        if (mConfig.DetailedNormalValues?.Any() == true)
        {
            var mappedDnv = mConfig.DetailedNormalValues.Select(x => new Lab_Result_DetailedNormalValues
            {
                dnvid = x.trdnid,
                trdnid = x.trdnid,
                sno = x.sno ?? 0,
                agefrom = x.agefrom ?? 0,
                agefromtype = !string.IsNullOrEmpty(x.agefromtype) ? (x.agefromtype == "Yrs" ? "Years" : x.agefromtype) : "Years",
                ageto = x.ageto ?? 0,
                agetotype = !string.IsNullOrEmpty(x.agetotype) ? (x.agetotype == "Yrs" ? "Years" : x.agetotype) : "Years",
                agerangetype = !string.IsNullOrEmpty(x.agerangetype) ? x.agerangetype : "Normal",
                sex = !string.IsNullOrEmpty(x.sex) ? x.sex : "Both",
                rangetype = !string.IsNullOrEmpty(x.rangetype) ? x.rangetype : "Normal",
                rangefrom = x.rangefrom ?? 0,
                rangeto = x.rangeto ?? 0,
                specialconditioncode = x.specialconditioncode
            }).ToList();
            var dnvStr = FormatNormalValueFromDetailed(mappedDnv);
            if (!string.IsNullOrWhiteSpace(dnvStr)) return dnvStr;
        }

        // 10. Check if defaultunitscode resolves to a qualitative unit (e.g. "NEGATIVE")
        if (mConfig.ResultProperties?.defaultunitscode > 0 && uom != null)
        {
            var matchedUom = uom.FirstOrDefault(u => u.ucode == mConfig.ResultProperties.defaultunitscode);
            if (matchedUom != null && QualitativeValues.Contains(matchedUom.name?.Trim() ?? ""))
            {
                return "Negative";
            }
        }

        return "";
    }

    private void ApplyMasterConfigToRow(LabResultEntry? row, LabCare.Models.TestResultRowDto? mConfig, bool forceOverwrite = false)
    {
        if (row == null || mConfig == null) return;

        string masterType = mConfig.ResultProperties?.resultvaluetype ?? "";
        if (string.Equals(masterType, "Title", StringComparison.OrdinalIgnoreCase))
        {
            row.resultvaluetype = "Title";
            row.printresultonly = true;
            row.enteredresult = "";
            row.unitname = "";
            row.normalvalue = "";
            return;
        }

        bool isTitleOrSub = row.resultvaluetype == "Title" || row.resultvaluetype == "SubTitle";
        if (isTitleOrSub) return;

        bool isRowEntered = !string.IsNullOrWhiteSpace(row.enteredresult) && row.enteredresult.Trim() != "-";
        bool isRowSavedOrAuth = row.status || row.isauthorized1 || row.isauthorized2 || (row.resultenteredby > 0 && isRowEntered);
        bool shouldUpdate = forceOverwrite || (!isRowEntered && !isRowSavedOrAuth);

        // Clean stale placeholder normal values first
        if (row.normalvalue != null)
        {
            var trimmed = row.normalvalue.Trim();
            if (trimmed == "-" || trimmed == "Normal 0" || trimmed == "0-0" || trimmed == "0 - 0" || trimmed == "()" || trimmed == "(-)" || trimmed == "0")
            {
                row.normalvalue = "";
            }
        }

        var masterNv = GetMasterNormalValueFromConfig(mConfig);

        // 1. Normal Value
        if (shouldUpdate)
        {
            if (!string.IsNullOrWhiteSpace(masterNv))
            {
                row.normalvalue = masterNv;
            }
        }
        else if (string.IsNullOrWhiteSpace(row.normalvalue) && !string.IsNullOrWhiteSpace(masterNv))
        {
            row.normalvalue = masterNv;
        }

        // 2. Detailed Normal Values
        if (mConfig.DetailedNormalValues?.Any() == true)
        {
            if (shouldUpdate || row.detailednormalvalues == null || !row.detailednormalvalues.Any())
            {
                row.detailednormalvalues = mConfig.DetailedNormalValues.Select(x => new Lab_Result_DetailedNormalValues
                {
                    dnvid = x.trdnid,
                    trdnid = x.trdnid,
                    testresultid = row.testresultid,
                    sno = x.sno ?? 0,
                    agefrom = x.agefrom ?? 0,
                    agefromtype = !string.IsNullOrEmpty(x.agefromtype) ? (x.agefromtype == "Yrs" ? "Years" : x.agefromtype) : "Years",
                    ageto = x.ageto ?? 0,
                    agetotype = !string.IsNullOrEmpty(x.agetotype) ? (x.agetotype == "Yrs" ? "Years" : x.agetotype) : "Years",
                    agerangetype = !string.IsNullOrEmpty(x.agerangetype) ? x.agerangetype : "Normal",
                    sex = !string.IsNullOrEmpty(x.sex) ? x.sex : "Both",
                    rangetype = !string.IsNullOrEmpty(x.rangetype) ? x.rangetype : "Normal",
                    rangefrom = x.rangefrom ?? 0,
                    rangeto = x.rangeto ?? 0,
                    specialconditioncode = x.specialconditioncode
                }).ToList();
            }
        }

        // 3. Text Normal Values
        if (mConfig.TextNormalValues?.Any() == true)
        {
            if (shouldUpdate || row.textnormalvalues == null || !row.textnormalvalues.Any())
            {
                row.textnormalvalues = mConfig.TextNormalValues.Select(x => new Lab_Result_TextNormalValues
                {
                    trtid = x.trtid,
                    testresultid = row.testresultid,
                    sex = x.sex,
                    normalvalue = x.normalvalue
                }).ToList();
            }
        }

        // 4. Calculated Formulas
        if (mConfig.CalculatedFormulas?.Any() == true)
        {
            if (shouldUpdate || row.calculatedformulas == null || !row.calculatedformulas.Any())
            {
                row.calculatedformulas = mConfig.CalculatedFormulas.Select(x => new Lab_Result_CalculatedFormula
                {
                    trcfid = x.trcfid,
                    testresultid = row.testresultid,
                    sex = x.sex,
                    calculatedformula = x.calculatedformula
                }).ToList();
            }
        }

        // 5. Unit vs Qualitative Normal Value
        int resolvedUcode = mConfig.ResultProperties?.defaultunitscode ?? 0;
        string? resolvedUnitName = null;

        if (resolvedUcode > 0 && uom != null)
        {
            var matched = uom.FirstOrDefault(u => u.ucode == resolvedUcode);
            if (matched != null)
            {
                resolvedUnitName = !string.IsNullOrWhiteSpace(matched.name) ? matched.name : matched.shortname;
            }
        }

        if (string.IsNullOrWhiteSpace(resolvedUnitName) && !string.IsNullOrWhiteSpace(mConfig.ResultMaster?.col3))
        {
            var cand3 = mConfig.ResultMaster.col3.Trim();
            resolvedUnitName = cand3;
            var matchedUom = uom?.FirstOrDefault(u => string.Equals(u.name?.Trim(), cand3, StringComparison.OrdinalIgnoreCase) || string.Equals(u.shortname?.Trim(), cand3, StringComparison.OrdinalIgnoreCase));
            if (matchedUom != null)
            {
                resolvedUcode = (int)matchedUom.ucode;
                resolvedUnitName = matchedUom.name ?? cand3;
            }
            else if (uom != null)
            {
                int newUc = uom.Any() ? (int)uom.Max(x => x.ucode) + 1 : 1000;
                resolvedUcode = newUc;
                uom.Add(new Booking.Models.UomMasterModel { ucode = newUc, name = cand3, shortname = cand3 });
            }

            if (QualitativeValues.Contains(cand3) && (shouldUpdate || string.IsNullOrWhiteSpace(row.normalvalue)))
            {
                row.normalvalue = "Negative";
            }
        }

        if (string.IsNullOrWhiteSpace(resolvedUnitName))
        {
            var std = GetStandardLabUnit(row.col2 ?? row.testname ?? "");
            if (!string.IsNullOrWhiteSpace(std))
            {
                resolvedUnitName = std;
                var matchedUom = uom?.FirstOrDefault(u => string.Equals(u.name?.Trim(), std, StringComparison.OrdinalIgnoreCase) || string.Equals(u.shortname?.Trim(), std, StringComparison.OrdinalIgnoreCase));
                if (matchedUom != null)
                {
                    resolvedUcode = (int)matchedUom.ucode;
                    resolvedUnitName = matchedUom.name ?? std;
                }
                else if (uom != null)
                {
                    int newUc = uom.Any() ? (int)uom.Max(x => x.ucode) + 1 : 1000;
                    resolvedUcode = newUc;
                    uom.Add(new Booking.Models.UomMasterModel { ucode = newUc, name = std, shortname = std });
                }
            }
        }

        if (!string.IsNullOrWhiteSpace(resolvedUnitName))
        {
            if (shouldUpdate || string.IsNullOrWhiteSpace(row.unitname))
            {
                row.defaultunitscode = resolvedUcode;
                row.unitname = resolvedUnitName;
            }
        }

        // If normalvalue is still blank, and unitname or test is qualitative, default normalvalue to "Negative"
        if (string.IsNullOrWhiteSpace(row.normalvalue))
        {
            if (!string.IsNullOrWhiteSpace(row.unitname) && QualitativeValues.Contains(row.unitname.Trim()))
            {
                row.normalvalue = "Negative";
            }
            else
            {
                string pName = (row.col2 ?? row.testname ?? "").ToLower();
                if (pName.Contains("salmonella") || pName.Contains("dengue") || pName.Contains("malaria") || 
                    pName.Contains("ns-1") || pName.Contains("ns1") || pName.Contains("antigen") || 
                    pName.Contains("card") || pName.Contains("widal") || pName.Contains("hbsag") || 
                    pName.Contains("hcv") || pName.Contains("hiv") || pName.Contains("urobilinogen") || 
                    pName.Contains("bilirubin") || pName.Contains("bile"))
                {
                    row.normalvalue = "Negative";
                }
            }
        }

        // 6. Properties
        if (mConfig.ResultProperties != null)
        {
            var mp = mConfig.ResultProperties;
            if (shouldUpdate)
            {
                row.simplenv = mp.simplenormalvalues ?? false;
                row.detailednv = mp.detailednormalvalues ?? false;
                row.showagedbased = mp.showagedbased ?? false;
                row.showalertonhigherlower = mp.showalertonhigherlower ?? false;
                row.printresultonly = mp.printresultonly ?? false;
                row.printnormalvaluesatbottom = mp.printnormalvaluesatbottom ?? false;
                row.printunitsinnormalvalues = mp.printunitsinnormalvalues ?? false;
                row.decimalvalue = mp.decimalvalue ?? 0;
                if (!string.IsNullOrWhiteSpace(mp.resultvaluetype))
                {
                    string rName = (row.col2 ?? row.testname ?? "").ToLower();
                    row.resultvaluetype = mp.resultvaluetype;
                    if (string.Equals(row.resultvaluetype, "Title", StringComparison.OrdinalIgnoreCase))
                    {
                        row.printresultonly = true;
                        row.enteredresult = "";
                        row.unitname = "";
                        row.normalvalue = "";
                    }
                }
                if (!string.IsNullOrWhiteSpace(mp.defaultvalue)) row.defaultunitvalue = mp.defaultvalue;
                if (mp.rtmcode.HasValue && mp.rtmcode.Value > 0) row.rtmcode = mp.rtmcode.Value;
                if (!string.IsNullOrWhiteSpace(mp.footermessage)) row.footermessage = mp.footermessage;
                if (!string.IsNullOrWhiteSpace(mp.conclusionforfixedtext) && !Guid.TryParse(mp.conclusionforfixedtext, out _)) row.conclusionforfixedtext = mp.conclusionforfixedtext;
                if (!string.IsNullOrWhiteSpace(mp.conclusionforhigher)) row.conclusionforhigher = mp.conclusionforhigher;
                if (!string.IsNullOrWhiteSpace(mp.conclusionforlower)) row.conclusionforlower = mp.conclusionforlower;

                // Sync Specimen from Master
                if (mConfig.ResultProperties?.scode > 0 && (row.scode <= 0 || string.IsNullOrWhiteSpace(row.samplename)))
                {
                    row.scode = mConfig.ResultProperties.scode.Value;
                    var matchedSample = sample?.FirstOrDefault(s => s.scode == row.scode);
                    if (matchedSample != null) row.samplename = matchedSample.name ?? matchedSample.shortname;
                }
                else if (row.tcode > 0 && _testConfigs.TryGetValue(row.tcode, out var tcfgSample) && tcfgSample.TestMaster?.scode > 0 && (row.scode <= 0 || string.IsNullOrWhiteSpace(row.samplename)))
                {
                    row.scode = (int)tcfgSample.TestMaster.scode;
                    var matchedSample = sample?.FirstOrDefault(s => s.scode == row.scode);
                    if (matchedSample != null) row.samplename = matchedSample.name ?? matchedSample.shortname;
                }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(row.resultvaluetype) && !string.IsNullOrWhiteSpace(mp.resultvaluetype))
                {
                    string rName = (row.col2 ?? row.testname ?? "").ToLower();
                    row.resultvaluetype = mp.resultvaluetype;
                    if (string.Equals(row.resultvaluetype, "Title", StringComparison.OrdinalIgnoreCase))
                    {
                        row.printresultonly = true;
                        row.enteredresult = "";
                        row.unitname = "";
                        row.normalvalue = "";
                    }
                }

                if (mConfig.ResultProperties?.scode > 0 && (row.scode <= 0 || string.IsNullOrWhiteSpace(row.samplename)))
                {
                    row.scode = mConfig.ResultProperties.scode.Value;
                    var matchedSample = sample?.FirstOrDefault(s => s.scode == row.scode);
                    if (matchedSample != null) row.samplename = matchedSample.name ?? matchedSample.shortname;
                }
                else if (row.tcode > 0 && _testConfigs.TryGetValue(row.tcode, out var tcfgSample) && tcfgSample.TestMaster?.scode > 0 && (row.scode <= 0 || string.IsNullOrWhiteSpace(row.samplename)))
                {
                    row.scode = (int)tcfgSample.TestMaster.scode;
                    var matchedSample = sample?.FirstOrDefault(s => s.scode == row.scode);
                    if (matchedSample != null) row.samplename = matchedSample.name ?? matchedSample.shortname;
                }
                if (string.IsNullOrWhiteSpace(row.defaultunitvalue) && !string.IsNullOrWhiteSpace(mp.defaultvalue)) row.defaultunitvalue = mp.defaultvalue;
                if (row.rtmcode <= 0 && mp.rtmcode.HasValue && mp.rtmcode.Value > 0) row.rtmcode = mp.rtmcode.Value;
                if (string.IsNullOrWhiteSpace(row.footermessage) && !string.IsNullOrWhiteSpace(mp.footermessage)) row.footermessage = mp.footermessage;
                if (string.IsNullOrWhiteSpace(row.conclusionforfixedtext) && !string.IsNullOrWhiteSpace(mp.conclusionforfixedtext) && !Guid.TryParse(mp.conclusionforfixedtext, out _)) row.conclusionforfixedtext = mp.conclusionforfixedtext;
            }
        }
    }

    private async Task ReloadNewNormalValuesAsync()
    {
