<script>
    window.initDraggablePopup = function(headerId, panelId) {
        var header = document.getElementById(headerId);
        var panel = document.getElementById(panelId);
        if (!header || !panel || header.dataset.dragInitialized) return;
        
        header.dataset.dragInitialized = "true";
        var isDragging = false;
        var startX, startY, initialTop, initialRight;
        
        header.style.cursor = 'grab';
        
        header.onmousedown = function (e) {
            if(e.target.closest('button')) return;
            isDragging = true;
            header.style.cursor = 'grabbing';
            startX = e.clientX;
            startY = e.clientY;
            
            var style = window.getComputedStyle(panel);
            initialTop = parseInt(style.top, 10) || 10;
            initialRight = parseInt(style.right, 10) || 16;
            
            document.onmousemove = function(e2) {
                if(isDragging) {
                    var dx = e2.clientX - startX;
                    var dy = e2.clientY - startY;
                    panel.style.top = (initialTop + dy) + 'px';
                    panel.style.right = (initialRight - dx) + 'px';
                    e2.preventDefault();
                }
            };
            document.onmouseup = function() {
                isDragging = false;
                header.style.cursor = 'grab';
                document.onmousemove = null;
                document.onmouseup = null;
            };
        };
    };

    window.gridNavigation = {
        focusNext: function (nextId) {
            setTimeout(function() {
                var element = document.getElementById(nextId);
                if (element) {
                    element.focus();
                    if (element.tagName === 'INPUT' || element.tagName === 'TEXTAREA') {
                        element.select();
                    }
                }
            }, 10);
        }
    };

    // Prevent default horizontal tab navigation and enable vertical tab/enter skipping in the results grid
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Tab' || e.key === 'Enter') {
            var target = e.target;
            if (target && target.classList && target.classList.contains('re-t-input')) {
                var id = target.id;
                if (id && id.startsWith('txt-')) {
                    var parts = id.split('-');
                    if (parts.length >= 3) {
                        e.preventDefault();
                        var rowIndex = parseInt(parts[1], 10);
                        var colName = parts.slice(2).join('-');
                        
                        var isUp = (e.key === 'Tab' && e.shiftKey) || (e.key === 'Enter' && e.shiftKey);
                        var nextRowIndex = isUp ? rowIndex - 1 : rowIndex + 1;
                        var nextId = 'txt-' + nextRowIndex + '-' + colName;
                        
                        var nextElement = document.getElementById(nextId);
                        if (nextElement) {
                            nextElement.focus();
                            if (nextElement.tagName === 'INPUT' || nextElement.tagName === 'TEXTAREA') {
                                nextElement.select();
                            }
                        }
                    }
                }
            }
        }
    });
</script>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "requestGuid")]
    public string RequestGuid { get; set; } = "";

    [Parameter]
    [SupplyParameterFromQuery(Name = "custcode")]
    public string CustCode { get; set; } = "";

    [Parameter]
    [SupplyParameterFromQuery(Name = "patientname")]
    public string? PatientName { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "patient_name")]
    public string? PatientNameQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "name")]
    public string? PatientNameAlt { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "gender")]
    public string? PatientGender { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "sex")]
    public string? PatientSex { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "age")]
    public string? PatientAge { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "doctor")]
    public string? PatientDoctor { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "tcode")]
    public string? FilterTCode { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "testname")]
    public string? FilterTestName { get; set; }

    private bool isFilteredByIncomingTest = false;
    private string activeFilteredTestDisplay = "";

    private void ApplyIncomingTestFilter()
    {
        var targetCodes = (FilterTCode ?? "")
            .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => long.TryParse(s, out var v) ? v : 0L)
            .Where(v => v > 0)
            .ToHashSet();

        var targetNames = (FilterTestName ?? "")
            .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(Uri.UnescapeDataString)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (!targetCodes.Any() && !targetNames.Any())
        {
            isFilteredByIncomingTest = false;
            activeFilteredTestDisplay = "";
            return;
        }

        if (billedTestSelections != null && billedTestSelections.Any())
        {
            bool anyMatched = false;
            foreach (var b in billedTestSelections)
            {
                bool match = targetCodes.Contains(b.tcode) || targetNames.Contains(b.testname);
                b.IsSelected = match;
                if (match) anyMatched = true;
            }

            if (anyMatched)
            {
                isFilteredByIncomingTest = true;
                var matchedNames = billedTestSelections.Where(b => b.IsSelected).Select(b => b.testname);
                activeFilteredTestDisplay = string.Join(", ", matchedNames);
            }
            else
            {
                isFilteredByIncomingTest = true;
                activeFilteredTestDisplay = !string.IsNullOrEmpty(FilterTestName) ? FilterTestName : $"Test Code {FilterTCode}";
            }
        }
        else
        {
            isFilteredByIncomingTest = true;
            activeFilteredTestDisplay = !string.IsNullOrEmpty(FilterTestName) ? FilterTestName : $"Test Code {FilterTCode}";
        }
    }

    private void ClearIncomingTestFilter()
    {
        FilterTCode = null;
        FilterTestName = null;
        isFilteredByIncomingTest = false;
        activeFilteredTestDisplay = "";
        if (billedTestSelections != null)
        {
            foreach (var b in billedTestSelections) b.IsSelected = true;
        }
        ApplyUnifiedFilter();
    }

    // Top Bar properties
    private int SelectedGroupCode { get; set; } = 0;   // 0 = All Groups

    // Group list built from lre1
    public class GroupItem
    {
        public int gcode { get; set; }
        public string groupname { get; set; } = "";
    }
    private List<GroupItem> groupList = new();

    // Advance Filter properties
    private bool showAdvanceFilterDropdown = false;
    private string testSearchText = "";

    private void ToggleAdvanceFilter()
    {
        showAdvanceFilterDropdown = !showAdvanceFilterDropdown;
    }

    private void CloseAdvanceFilter()
    {
        showAdvanceFilterDropdown = false;
    }

    private void SelectGroup(int code)
    {
        SelectedGroupCode = code;
        showAdvanceFilterDropdown = false;
        // Rebuild billed test selections scoped to the current group
        billedTestSelections = BuildBilledTestSelections(SelectedGroupCode);
        ApplyUnifiedFilter();
    }

    private void OnTestSearchInput(ChangeEventArgs e)
    {
        testSearchText = e.Value?.ToString() ?? "";
        ApplyUnifiedFilter();
    }

    private void ClearTestSearch()
    {
        testSearchText = "";
        ApplyUnifiedFilter();
    }

    private string GetStandardLabUnit(string paramName)
    {
        if (string.IsNullOrWhiteSpace(paramName)) return "";
        var p = paramName.Trim().ToLowerInvariant();

        // 0. CRP / C-Reactive Protein / Hs-CRP
        if (p == "crp" || p.Contains("c-reactive") || p.Contains("c reactive") || p.StartsWith("crp ") || p.EndsWith(" crp") || p.Contains("hscrp") || p.Contains("hs-crp"))
            return "MG/L";

        // 1. Packed Cell Volume / Hematocrit
        if (p == "pcv" || p.Contains("packed cell") || p.Contains("hematocrit") || p.Contains("haematocrit") || p.StartsWith("pcv ") || p.EndsWith(" pcv"))
            return "%";

        // 2. Mean Corpuscular Volume
        if (p == "mcv" || p.Contains("mean corpuscular volume") || p.StartsWith("mcv ") || p.EndsWith(" mcv"))
            return "fl";

        // 3. Mean Corpuscular Hemoglobin (not MCHC)
        if ((p == "mch" || p.Contains("mean corpuscular hemoglobin") || p.Contains("mean corpuscular haemoglobin") || p.StartsWith("mch ") || p.EndsWith(" mch")) && !p.Contains("mchc") && !p.Contains("concentration"))
            return "pg";

        // 4. Mean Corpuscular Hemoglobin Concentration
        if (p == "mchc" || p.Contains("mchc") || p.Contains("concentration"))
            return "g/dl";

        // 5. ESR (Erythrocyte Sedimentation Rate)
        if (p.StartsWith("esr") || p.Contains("erythrocyte sedimentation") || p.Contains("westergren"))
            return "mm/hr";

        // 6. Differential counts
        if (p.Contains("neutrophil") || p.Contains("lymphocyte") || p.Contains("monocyte") || p.Contains("eosinophil") || p.Contains("basophil"))
            return "%";

        // 7. Platelet Count
        if (p.Contains("platelet"))
            return "lakhs/cumm";

        // 8. Total RBC Count
        if (p.Contains("rbc") || p.Contains("red blood cell"))
            return "millions/cumm";

        // 9. Total WBC Count
        if (p.Contains("wbc") || p.Contains("white blood cell") || p.Contains("leucocyte") || p.Contains("leukocyte"))
            return "cells/cumm";

        // 10. Haemoglobin
        if (p.Contains("haemoglobin") || p.Contains("hemoglobin") || p == "hb")
            return "g/dl";

        return "";
    }

    private long GetParentTCode(LabResultEntry? r)
    {
        if (r == null) return 0;
        if (billedTestSelections != null && billedTestSelections.Any())
        {
            if (billedTestSelections.Any(b => b.tcode == r.tcode))
                return r.tcode;
            if (r.fromtcode > 0 && billedTestSelections.Any(b => b.tcode == r.fromtcode))
                return r.fromtcode;
        }
        return r.fromtcode > 0 ? (long)r.fromtcode : (long)r.tcode;
    }

    private bool IsTextParameterRow(LabResultEntry? r)
    {
        if (r == null) return false;
        if (string.Equals(r.resulttype, "Text", StringComparison.OrdinalIgnoreCase) || 
            string.Equals(r.resulttype, "T", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(r.resulttype, "D", StringComparison.OrdinalIgnoreCase))
            return true;

        if (r.testname?.Contains("XRAY", StringComparison.OrdinalIgnoreCase) == true ||
            r.testname?.Contains("X-RAY", StringComparison.OrdinalIgnoreCase) == true ||
            r.col2?.Contains("XRAY", StringComparison.OrdinalIgnoreCase) == true ||
            r.col2?.Contains("X-RAY", StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (r.groupname?.Contains("RADIOLOGY", StringComparison.OrdinalIgnoreCase) == true ||
            r.groupname?.Contains("X-RAY", StringComparison.OrdinalIgnoreCase) == true ||
            r.groupname?.Contains("IMAGING", StringComparison.OrdinalIgnoreCase) == true)
            return true;

        return false;
    }

    private int GetTestBilledOrder(long parentTCode)
    {
        if (!string.IsNullOrEmpty(FilterTCode))
        {
            var codes = FilterTCode.Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(s => long.TryParse(s, out var v) ? v : 0L)
                .Where(v => v > 0)
                .ToList();
            int idx = codes.IndexOf(parentTCode);
            if (idx >= 0) return idx;
        }

        if (billedTestSelections != null && billedTestSelections.Any())
        {
            int idx = billedTestSelections.FindIndex(b => b.tcode == parentTCode);
            if (idx >= 0) return idx;
        }

        if (lre1 != null)
        {
            var distinct = lre1.Select(x => GetParentTCode(x)).Where(tc => tc > 0).Distinct().ToList();
            int idx = distinct.IndexOf(parentTCode);
            if (idx >= 0) return idx;
        }

        return 9999;
    }

    private List<LabResultEntry> SortLabResultEntries(IEnumerable<LabResultEntry>? list)
    {
        if (list == null) return new List<LabResultEntry>();
        var l = list.ToList();
        return l
            .OrderBy(x => x.grouporder > 0 ? x.grouporder : 9999)
            .ThenBy(x => GetTestBilledOrder(GetParentTCode(x)))
            .ThenBy(x => GetParentTCode(x))
            .ThenBy(x => {
                // Headline/Title row ALWAYS prompt (first): Priority 0
                if (x.resultvaluetype == "Title") return 0;
                // SubTitle (e.g. NLR) Priority 1
                if (x.resultvaluetype == "SubTitle" || string.Equals(x.col2?.Trim(), "NLR", StringComparison.OrdinalIgnoreCase)) return 1;
                // Child parameter rows: Priority 2 (appear directly under the headline)
                return 2;
            })
            .ThenBy(x => x.orderno > 0 ? x.orderno : 9999)
            .ThenBy(x => x.slno > 0 ? x.slno : 9999)
            .ToList();
    }

    private void ApplyUnifiedFilter()
    {
        // Start with the full list
        var scope = lre1.AsEnumerable();

        // 1. Filter by Group
        if (SelectedGroupCode != 0)
        {
            scope = scope.Where(x => x.gcode == SelectedGroupCode);
        }

        // 2. Filter by Test name (Test Search) - Starts with logic as requested
        if (!string.IsNullOrWhiteSpace(testSearchText))
        {
            scope = scope.Where(x => 
                (x.col2 != null && x.col2.Trim().StartsWith(testSearchText, StringComparison.OrdinalIgnoreCase)) || 
                (x.testname != null && x.testname.Trim().StartsWith(testSearchText, StringComparison.OrdinalIgnoreCase))
            );
        }

        // 3. Filter by Billed Test Selections
        if (billedTestSelections != null && billedTestSelections.Any())
        {
            var selectedItems = billedTestSelections.Where(b => b.IsSelected).ToList();
            var selectedCodes = selectedItems.Select(b => b.tcode).ToHashSet();

            if (selectedCodes.Any() && selectedCodes.Count < billedTestSelections.Count)
            {
                scope = scope.Where(x => selectedCodes.Contains(GetParentTCode(x)));
                isFilteredByIncomingTest = true;
                activeFilteredTestDisplay = string.Join(", ", selectedItems.Select(s => s.testname));
                FilterTCode = string.Join(",", selectedCodes);
            }
            else if (selectedCodes.Count == billedTestSelections.Count)
            {
                // All tests are selected
                if (isFilteredByIncomingTest && !string.IsNullOrWhiteSpace(FilterTCode))
                {
                    var targetCodes = FilterTCode.Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .Select(s => long.TryParse(s, out var v) ? v : 0L)
                        .Where(v => v > 0)
                        .ToHashSet();
                    if (targetCodes.Count < billedTestSelections.Count)
                    {
                        isFilteredByIncomingTest = false;
                        activeFilteredTestDisplay = "";
                        FilterTCode = null;
                    }
                }
            }
            else if (!selectedCodes.Any())
            {
                scope = Enumerable.Empty<LabResultEntry>();
                activeFilteredTestDisplay = "None";
            }
        }
        else if (isFilteredByIncomingTest && !string.IsNullOrEmpty(FilterTCode))
        {
            var targetCodes = FilterTCode.Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(s => long.TryParse(s, out var v) ? v : 0L)
                .Where(v => v > 0)
                .ToHashSet();
            if (targetCodes.Any())
            {
                scope = scope.Where(x => targetCodes.Contains(GetParentTCode(x)));
            }
        }

        lre = SortLabResultEntries(scope);
        StateHasChanged();
    }

    private void OnGroupChanged(ChangeEventArgs e)
    {
        SelectedGroupCode = int.TryParse(e.Value?.ToString(), out var code) ? code : 0;
        billedTestSelections = BuildBilledTestSelections(SelectedGroupCode);
        ApplyUnifiedFilter();
    }

    private void ApplyGroupFilter()
    {
        ApplyUnifiedFilter();
    }

    /// <summary>
    /// Returns distinct tcode+testname items from lre1, optionally scoped to a group.
    /// groupCode == 0 means all groups.
    /// </summary>
    private List<BilledTestItem> BuildBilledTestSelections(int groupCode)
    {
        var source = groupCode == 0
            ? lre1
            : lre1.Where(x => x.gcode == groupCode).ToList();

        return source
            .Where(x => GetParentTCode(x) > 0)
            .GroupBy(x => GetParentTCode(x))                          // deduplicate by parent tcode
            .Select(g => {
                string name = g.FirstOrDefault(x => x.resultvaluetype == "Title" && !IsTextParameterRow(x))?.testname
                           ?? g.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.testname))?.testname
                           ?? g.First().col2 ?? $"Test {g.Key}";
                return new BilledTestItem
                {
                    tcode = g.Key,
                    testname = name,
                    IsSelected = true
                };
            })
            .OrderBy(b => GetTestBilledOrder(b.tcode))
            .ToList();
    }

