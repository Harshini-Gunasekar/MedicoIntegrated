    private string FormatNormalValueFromDetailed(List<Lab_Result_DetailedNormalValues> detailedList)
    {
        if (detailedList == null || !detailedList.Any()) return "";

        var normalRows = detailedList
            .Where(x => string.IsNullOrEmpty(x.rangetype) || 
                        x.rangetype.Equals("Normal", StringComparison.OrdinalIgnoreCase) || 
                        x.rangetype.Equals("Between", StringComparison.OrdinalIgnoreCase) || 
                        x.rangetype.Equals("-", StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (!normalRows.Any())
        {
            normalRows = detailedList.ToList();
        }

        var parts = normalRows
            .Select(d =>
            {
                string label = "";
                if (!string.IsNullOrWhiteSpace(d.agerangetype) && 
                    !d.agerangetype.Equals("Normal", StringComparison.OrdinalIgnoreCase) && 
                    d.agerangetype != "-" &&
                    d.agerangetype.Replace(" ", "") != "0--" &&
                    d.agerangetype.Replace(" ", "") != "0-0")
                {
                    label = d.agerangetype;
                }
                else if (!string.IsNullOrWhiteSpace(d.sex) && 
                         !d.sex.Equals("Both", StringComparison.OrdinalIgnoreCase) && 
                         d.sex != "-")
                {
                    label = d.sex;
                }

                var prefix = string.IsNullOrEmpty(label) ? "" : $"{label}: ";
                var rangeStr = d.rangefrom == d.rangeto
                    ? $"{d.rangefrom}"
                    : $"{d.rangefrom} - {d.rangeto}";
                return $"{prefix}{rangeStr}";
            })
            .Distinct()
            .ToList();

        return string.Join(" | ", parts);
    }

    private void UpdateNormalValueFromDetailedRange(Lab_Result_DetailedNormalValues dnv)
    {
        if (dnv == null || SelectedRowEntry == null) return;
        
        if (dnv.dnvid == SelectedDnvId)
        {
            var fromStr = dnv.rangefrom == 0 ? "" : dnv.rangefrom.ToString();
            var toStr = dnv.rangeto == 0 ? "" : dnv.rangeto.ToString();
            NormalRangeInput1 = fromStr;
            NormalRangeInput2 = toStr;
        }

        // Build the primary normal value only from rows where condition (rangetype) is "Normal"
        if (SelectedRowEntry.EditedDetailedNormalValues?.Any() == true)
        {
            var finalNormalValue = FormatNormalValueFromDetailed(SelectedRowEntry.EditedDetailedNormalValues);
            NormalValueText = finalNormalValue;
            SelectedRowEntry.normalvalue = finalNormalValue;
            ReferenceValueText = finalNormalValue;
            FixedNormalValueSelect = finalNormalValue;
        }
        StateHasChanged();
    }

    private void SetDetailedNormalValue(Lab_Result_DetailedNormalValues dnv)
    {
        if (dnv == null || SelectedRowEntry == null) return;

        // Track which row is selected (for highlight)
        SelectedDnvId = dnv.dnvid;

        // Build a formatted normal value string from the selected range
        var fromStr = dnv.rangefrom == 0 ? "" : dnv.rangefrom.ToString();
        var toStr = dnv.rangeto == 0 ? "" : dnv.rangeto.ToString();
        var rangeStr = (!string.IsNullOrEmpty(fromStr) && !string.IsNullOrEmpty(toStr))
            ? $"{fromStr} - {toStr}"
            : fromStr + toStr;

        // Apply to the UI fields
        NormalRangeInput1 = fromStr;
        NormalRangeInput2 = toStr;
        NormalValueText = rangeStr;

        // Also write back to the model so it persists on Apply
        SelectedRowEntry.normalvalue = rangeStr;

        // Ensure the change is captured in the edited list
        SyncEditedCollections(SelectedRowEntry);

        // Highlight the selected row by marking it (optional visual feedback)
        FixedNormalValueSelect = rangeStr;

        StateHasChanged();
    }

