    private Dictionary<string, ResultAuditHistoryItem> _auditHistory = new(StringComparer.OrdinalIgnoreCase);

    private string GetAuditFilePath(string guid)
    {
        string safeGuid = string.Join("_", (guid ?? "").Split(Path.GetInvalidFileNameChars()));
        string dir = Path.Combine(AppContext.BaseDirectory, "App_Data", "LabAudits");
        if (!Directory.Exists(dir)) Directory.CreateDirectory(dir);
        return Path.Combine(dir, $"{safeGuid}.json");
    }

    private void LoadAuditHistory()
    {
        try
        {
            string targetGuid = !string.IsNullOrEmpty(_resolvedBilledGuid) ? _resolvedBilledGuid : RequestGuid;
            if (string.IsNullOrEmpty(targetGuid)) return;
            string path = GetAuditFilePath(targetGuid);
            if (File.Exists(path))
            {
                string json = File.ReadAllText(path);
                var items = JsonConvert.DeserializeObject<Dictionary<string, ResultAuditHistoryItem>>(json);
                if (items != null)
                {
                    _auditHistory = items;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AUDIT] LoadAuditHistory error: {ex.Message}");
        }
    }

    private void PersistAuditHistory()
    {
        try
        {
            string targetGuid = !string.IsNullOrEmpty(_resolvedBilledGuid) ? _resolvedBilledGuid : RequestGuid;
            if (string.IsNullOrEmpty(targetGuid) || _auditHistory == null || !_auditHistory.Any()) return;
            string path = GetAuditFilePath(targetGuid);
            string json = JsonConvert.SerializeObject(_auditHistory, Formatting.Indented);
            File.WriteAllText(path, json);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AUDIT] PersistAuditHistory error: {ex.Message}");
        }
    }

    private ResultAuditHistoryItem GetAuditItem(LabResultEntry row)
    {
        string key = (row.testresultid.HasValue && row.testresultid.Value != Guid.Empty)
            ? row.testresultid.Value.ToString()
            : row.tcode.ToString();

        if (!_auditHistory.TryGetValue(key, out var item))
        {
            item = new ResultAuditHistoryItem
            {
                TestResultId = key,
                TCode = row.tcode,
                TestName = row.col2 ?? row.testname ?? ""
            };

            string currVal = row.enteredresult ?? "";
            if (!string.IsNullOrWhiteSpace(currVal) || row.resultenteredby > 0)
            {
                item.SavedValue = currVal;
                item.SavedByCode = row.resultenteredby > 0 ? row.resultenteredby : (entId > 0 ? entId : userCode);
                item.SavedByName = ResolveUserName(item.SavedByCode);
                item.SavedDate = !string.IsNullOrEmpty(row.resultentereddate) ? row.resultentereddate : GetEntryDate();
            }

            if (row.isauthorized1 || row.resultauthorizedby > 0)
            {
                item.VerifiedValue = currVal;
                item.VerifiedByCode = row.resultauthorizedby > 0 ? row.resultauthorizedby : (auth1Id > 0 ? auth1Id : userCode);
                item.VerifiedByName = ResolveUserName(item.VerifiedByCode);
                item.VerifiedDate = !string.IsNullOrEmpty(row.firstauthorizedate) ? row.firstauthorizedate : GetAuth1Date();
            }

            if (row.isauthorized2 || row.resultauthorizedby2 > 0)
            {
                item.ApprovedValue = currVal;
                item.ApprovedByCode = row.resultauthorizedby2 > 0 ? row.resultauthorizedby2 : (auth2Id > 0 ? auth2Id : userCode);
                item.ApprovedByName = ResolveUserName(item.ApprovedByCode);
                item.ApprovedDate = !string.IsNullOrEmpty(row.secondauthorizedate) ? row.secondauthorizedate : GetAuth2Date();
            }

            _auditHistory[key] = item;
        }

        return item;
    }

