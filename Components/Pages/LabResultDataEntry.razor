    // â”€â”€ DeleteSubRow â€” removes a sub-test row from the grid â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private void DeleteSubRow(LabResultEntry row)
    {
        if (userCode != 1 && !isauthorized2)
        {
            return;
        }
        lre1.Remove(row);
        lre.Remove(row);

        // Cleanup associated Delta Check entry if it exists
        if (deltaResults != null && !string.IsNullOrEmpty(row.col2))
        {
            var matchingDelta = deltaResults.FirstOrDefault(d => (d.TestName ?? "").Trim().ToLower() == row.col2.Trim().ToLower());
            if (matchingDelta != null)
            {
                deltaResults.Remove(matchingDelta);
            }
        }

        StateHasChanged();
    }


    private Dictionary<long, TestInsertDto> _testConfigs = new();

    private bool IsRowEscalated(LabResultEntry row)
    {
        if (row.is_escalation == true) return true;
        if (_testConfigs.TryGetValue(row.tcode, out var config))
        {
            if (config.TestMaster.is_escalation == true) return true;
            if (config.ResultRows != null && config.ResultRows.Any(r => r.ResultMaster.testresultid == row.testresultid)) return true;
        }
        return false;
    }

    private int GetAssignedUserCode(long tcode)
    {
        if (_testConfigs.TryGetValue(tcode, out var config))
        {
            return config.TestMaster.usercode > 0 ? config.TestMaster.usercode : 0;
        }
        return 0;
    }

    private bool IsTestEscalated(long tcode)
    {
        if (_testConfigs.TryGetValue(tcode, out var config))
        {
            if (config.TestMaster.is_escalation == true) return true;
            if (config.ResultRows != null && config.ResultRows.Any(r => r.ResultMaster != null)) return true;
        }
        if (lre1 != null && lre1.Any(x => x.tcode == tcode && x.is_escalation == true)) return true;
        return false;
    }

    // Save state
    private bool isSaving = false;
    private bool isAuth2Finished = false;
    private string saveMessage = "";
    private bool saveError = false;
    private System.Threading.CancellationTokenSource? _toastCts;

    private async Task SaveResults(int level)
    {
        /* Console.WriteLine($"[SAVE] SaveResults ENTERED: level={level}, userCode={userCode}, isSaving={isSaving}, isviewer={isviewer}") */;

        if (isSaving) { /* Console.WriteLine("[SAVE] Blocked: already saving.") */; return; }

        // If userCode is 0, try to recover from session before blocking
        if (userCode == 0)
        {
            /* Console.WriteLine("[SAVE] userCode=0 â€” attempting session re-read...") */;
            try
            {
                var claimResult = await sessionStorage.GetAsync<UserAuth>("claim");
                if (claimResult.Success && claimResult.Value != null)
                {
                    userCode = claimResult.Value.usercode;
                    token = claimResult.Value.token;
                    /* Console.WriteLine($"[SAVE] Re-read from claim: userCode={userCode}") */;
                }
                if (userCode == 0)
                {
                    var ud = await sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                    if (ud.Success && ud.Value != null)
                    {
                        userCode = ud.Value.UserCode ?? 0;
                        if (string.IsNullOrEmpty(token)) token = ud.Value.AuthToken ?? "";
                        /* Console.WriteLine($"[SAVE] Re-read from UserDetails: userCode={userCode}") */;
                    }
                }
            }
            catch (Exception ex) { /* Console.WriteLine($"[SAVE] Session re-read error: {ex.Message}") */; }
        }

        if (userCode == 0)
        {
            userCode = TenantState.UserCode > 0 ? TenantState.UserCode : 1;
        }

        // Force admin rights if not yet applied
        if (!isentered && !isauthorized1 && !isauthorized2)
        {
            isentered = true; isauthorized1 = true; isauthorized2 = true;
            /* Console.WriteLine("[SAVE] Rights defaulted to full for this save attempt.") */;
        }

        isSaving = true;
        currentSavingLevel = level;
        saveMessage = "";
        /* Console.WriteLine($"[SAVE] SaveResults proceeding: level={level}, userCode={userCode}, isentered={isentered}, isauth1={isauthorized1}, isauth2={isauthorized2}, lre1.Count={lre1.Count}") */;
        StateHasChanged();

        try
        {
            try
            {
                await EnsureSampleCollectionAndReceive();
            }
            catch { }

            // Escalation Validation: If saving/authorizing at level 2 (Auth 2), check if any escalated row is being authorized by a non-assigned user.
            // Skip escalation restriction for users with full rights (admin, or all three flags set).
            bool isFullAdmin = userCode == 1 || (isentered && isauthorized1 && isauthorized2);
            if (level == 2 && !isFullAdmin)
            {
                foreach (var row in lre1)
                {
                    if (IsRowEscalated(row))
                    {
                        int assignedUser = GetAssignedUserCode(row.tcode);
                        int auth2User = row.resultauthorizedby2 > 0 ? row.resultauthorizedby2 : userCode;
                        
                        if (assignedUser > 0)
                        {
                            if (auth2User != assignedUser)
                            {
                                saveError = true;
                                saveMessage = $"âš ï¸ Escalation test '{row.testname}' can only be authorized (Auth 2) by the assigned Pathologist/Doctor (User Code: {assignedUser}).";
                                Toast.ShowError(saveMessage);
                                isSaving = false;
                                StateHasChanged();
                                return;
                            }
                        }
                        else
                        {
                            if (auth2User <= 0)
                            {
                                saveError = true;
                                saveMessage = $"âš ï¸ Escalation test '{row.testname}' requires Level 2 Authorization.";
                                Toast.ShowError(saveMessage);
                                isSaving = false;
                                StateHasChanged();
                                return;
                            }
                        }
                    }
                }
            }

            bool canProceed = false;

            // Admin / full-rights bypass: if user has all three rights, they can always save at any level
            bool isAdmin = userCode == 1 || (isentered && isauthorized1 && isauthorized2);

            // Sanitize and Apply Authorization to the FULL master list (lre1)
            foreach (var row in lre1)
            {
                // Sync GUIDs
                if (string.IsNullOrEmpty(row.requestguid)) row.requestguid = RequestGuid ?? "";
                
                // Result status Logic: true if entered, else false
                row.status = !string.IsNullOrWhiteSpace(row.enteredresult?.Trim());

                if (string.IsNullOrEmpty(row.defaultunitvalue)) row.defaultunitvalue = row.unitname ?? "";
                
                // 1. Clean up normalvalue â€” strip display-only method suffix before saving
                if (row.normalvalue != null)
                {
                    row.normalvalue = row.normalvalue.Replace("Normal 0", "").Trim();
                    // Remove "/ (MethodName)" suffix added by LoadResults for display only
                    row.normalvalue = System.Text.RegularExpressions.Regex.Replace(
                        row.normalvalue, @"\s*/\s*\([^)]+\)\s*$", "").Trim();

                    // Also remove standalone parenthesized method names or placeholders
                    if (row.normalvalue.StartsWith("(") && row.normalvalue.EndsWith(")"))
                    {
                        var potentialMethodName = row.normalvalue.Substring(1, row.normalvalue.Length - 2).Trim();
                        if (method.Any(m => string.Equals(m.name?.Trim(), potentialMethodName, StringComparison.OrdinalIgnoreCase)))
                        {
                            row.normalvalue = "";
                        }
                    }
                    if (method.Any(m => string.Equals(m.name?.Trim(), row.normalvalue?.Trim(), StringComparison.OrdinalIgnoreCase)))
                    {
                        row.normalvalue = "";
                    }

                    // Strip any formula placeholder segments that may have been appended to normal value
                    // e.g. "2 - 30 mg/dL, TG_PLACEHOLDER|/5" â†’ "2 - 30 mg/dL"
                    if (row.normalvalue.Contains("_PLACEHOLDER"))
                    {
                        // Remove everything after the last comma/semicolon that contains a PLACEHOLDER token
                        var nvParts = row.normalvalue.Split(new char[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries);
                        var cleanParts = nvParts.Where(p => !p.Contains("_PLACEHOLDER")).Select(p => p.Trim()).ToList();
                        row.normalvalue = string.Join(", ", cleanParts).Trim();
                    }
                }

                // 2. Sync rtmcode â€” but do NOT modify normalvalue with method name here (save context)
                var methodObj = method.FirstOrDefault(x => x.rtmcode == row.rtmcode);

                if (methodObj != null && !string.IsNullOrEmpty(methodObj.name))
                {
                    // method found â€” use for rtmcode assignment only, do not modify normalvalue
                }
                else if (row.rtmcode == 0)
                {
                    row.normalvalue = (row.normalvalue ?? "").Replace("/ ()", "").Trim();
                }

                
                if (!string.IsNullOrEmpty(row.unitname))
                {
                    var unit = uom.FirstOrDefault(x => x.name == row.unitname);
                    if (unit != null) row.defaultunitscode = (int)unit.ucode;
                }

                if (row.mccode == 0 && !string.IsNullOrEmpty(row.machinename))
                {
                    var m = machine.FirstOrDefault(x => x.name == row.machinename || x.shortname == row.machinename);
                    if (m != null) row.mccode = (int)m.mccode;
                }

                if (row.scode == 0 && !string.IsNullOrEmpty(row.samplename))
                {
                    var s = sample.FirstOrDefault(x => x.name == row.samplename || x.shortname == row.samplename);
                    if (s != null) row.scode = (int)s.scode;
                }

                // Do not force default rtmcode if user/master did not specify a method

                if (string.IsNullOrEmpty(row.machinename)) row.machinename = "Manual";
                
                row.enteredresult ??= "";
                if (string.IsNullOrEmpty(row.col2) && !string.IsNullOrEmpty(row.testname))
                {
                    row.col2 = row.testname;
                }
                row.col2 ??= "";
                row.resultvaluetype ??= "Text";

                bool isTitleOrSubTitle = string.Equals(row.resultvaluetype, "Title", StringComparison.OrdinalIgnoreCase) || 
                                         string.Equals(row.resultvaluetype, "SubTitle", StringComparison.OrdinalIgnoreCase) || 
                                         string.Equals(row.resultvaluetype, "H", StringComparison.OrdinalIgnoreCase) || 
                                         string.Equals(row.resultvaluetype, "S", StringComparison.OrdinalIgnoreCase) ||
                                         string.Equals(row.resulttype, "H", StringComparison.OrdinalIgnoreCase) ||
                                         string.Equals(row.resulttype, "S", StringComparison.OrdinalIgnoreCase);

                // Determine editability â€” admin bypass, per-row rights, or header rows
                bool rowEditable = isAdmin || IsRowEditable(row) || isTitleOrSubTitle;
                bool hasResult = !string.IsNullOrWhiteSpace(row.enteredresult?.Trim());
                
                /* Console.WriteLine($"[SAVE] Row tcode={row.tcode} col2='{row.col2}' rowEditable={rowEditable} hasResult={hasResult}") */;
                
                if (rowEditable)
                {
                    if (level == 2 && (isauthorized2 || isAdmin))
                    {
                        canProceed = true;
                        if (row.resultauthorizedby2 == 0) row.resultauthorizedby2 = userCode;
                        row.isauthorized2 = true;
                        row.status = hasResult || isTitleOrSubTitle;
                        if (row.resultauthorizedby == 0) row.resultauthorizedby = userCode;
                        row.isauthorized1 = true;
                        if (row.resultenteredby == 0 && (hasResult || isTitleOrSubTitle)) row.resultenteredby = userCode;
                    }
                    else if (level == 1 && (isauthorized1 || isAdmin))
                    {
                        canProceed = true;
                        row.resultauthorizedby = userCode;
                        row.isauthorized1 = true;
                        row.status = hasResult || isTitleOrSubTitle;
                        if (row.resultenteredby == 0 && (hasResult || isTitleOrSubTitle)) row.resultenteredby = userCode;
                    }
                    else if (level == 0 && (isentered || isAdmin))
                    {
                        canProceed = true;
                        if (hasResult || isTitleOrSubTitle)
                        {
                            if (row.resultenteredby == 0) row.resultenteredby = userCode;
                            row.status = true;
                        }
                        else
                        {
                            // If row is empty, ensure status is false to satisfy backend validation
                            row.status = false;
                        }

                        // Preserve existing authorization status if previously authorized
                        if (row.resultauthorizedby > 0) row.isauthorized1 = true;
                        if (row.resultauthorizedby2 > 0) row.isauthorized2 = true;
                    }
                }
            }

            /* Console.WriteLine($"[SAVE] canProceed={canProceed}") */;
            UpdateUserNames();
            StateHasChanged();

            if (!canProceed)
            {
                saveError = true;
                saveMessage = "Insufficient rights or record is locked.";
                Toast.ShowWarning(saveMessage);
                isSaving = false;
                StateHasChanged();
                return;
            }

            // Sanitize DetailedNormalValues required fields before sending to backend
            foreach (var row in lre1)
            {
                if (row.EditedDetailedNormalValues != null)
                {
                    foreach (var dnv in row.EditedDetailedNormalValues)
                    {
                        if (string.IsNullOrEmpty(dnv.agefromtype))  dnv.agefromtype  = "Years";
                        if (string.IsNullOrEmpty(dnv.agetotype))    dnv.agetotype    = "Years";
                        if (string.IsNullOrEmpty(dnv.agerangetype)) dnv.agerangetype = "Normal";
                        if (string.IsNullOrEmpty(dnv.sex))          dnv.sex          = "Both";
                        if (string.IsNullOrEmpty(dnv.rangetype))    dnv.rangetype    = "Normal";
                    }
                }
            }

            // Project to exact field names/casing the backend expects (derived from working LIMS payload).
            var emptyTextNV   = new List<Lab_Result_TextNormalValues>();
            var emptyDetailNV = new List<Lab_Result_DetailedNormalValues>();
            var emptyCF       = new List<Lab_Result_CalculatedFormula>();

            // Ensure status, resultenteredby, and raw UUID cleanup for all rows
            foreach (var row in lre1)
            {
                if (row.enteredresult == "-") row.enteredresult = "";
                if (!string.IsNullOrWhiteSpace(row.enteredresult))
                {
                    row.status = true;
                    if (row.resultenteredby == 0 || row.resultenteredby == null)
                    {
                        row.resultenteredby = userCode > 0 ? userCode : 1;
                    }
                }
                if (Guid.TryParse(row.conclusionforfixedtext, out _))
                    row.conclusionforfixedtext = null;
            }

            // Propagate group-level conclusions for RDLC report rendering (ONLY onto the last row of each billed test group)
            lre1 = lre1
                .OrderBy(x => x.grouporder > 0 ? x.grouporder : 9999)
                .ThenBy(x => x.testname ?? "")
                .ThenBy(x => x.orderno > 0 ? x.orderno : 9999)
                .ThenBy(x => x.slno > 0 ? x.slno : x.tcode)
                .ThenBy(x => x.fromtcode > 0 ? (long)x.fromtcode : (long)x.tcode)
                .ThenBy(x => x.fromtcode > 0 ? 1 : 0)
                .ToList();

            var tcodeGroups = lre1.GroupBy(r => !string.IsNullOrEmpty(r.testname) ? r.testname : (r.fromtcode > 0 ? r.fromtcode.ToString() : r.tcode.ToString()));
            foreach (var group in tcodeGroups)
            {
                var groupList = group.ToList();
                var lastRow = groupList.Last();

                // Find parent test code for this billed test group
                long mainTCode = groupList.FirstOrDefault(r => r.fromtcode > 0)?.fromtcode ?? (groupList.FirstOrDefault(r => r.fromtcode == 0) ?? groupList.First()).tcode;

                // Fetch Test Master footer for the parent test
                string testMasterFooter = (mainTCode > 0 && _testConfigs.TryGetValue(mainTCode, out var cfgG)) ? (cfgG.TestMaster?.footer ?? "") : "";

                // Clear footer and conclusion on ALL non-last rows in the billed test group
                for (int k = 0; k < groupList.Count - 1; k++)
                {
                    groupList[k].footermessage = "";
                    groupList[k].conclusionforfixedtext = "";
                }

                // Gather existing footer or conclusion text across the entire group
                string existingCustomFooter = groupList.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.footermessage))?.footermessage ?? "";
                string existingCustomConclusion = groupList.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.conclusionforfixedtext) && !Guid.TryParse(r.conclusionforfixedtext, out _))?.conclusionforfixedtext ?? "";

                // Resolve footer text for LAST row: prioritize custom entered footer/conclusion, otherwise test master footer
                string resolvedText = !string.IsNullOrWhiteSpace(lastRow.footermessage)
                    ? lastRow.footermessage
                    : (!string.IsNullOrWhiteSpace(lastRow.conclusionforfixedtext) && !Guid.TryParse(lastRow.conclusionforfixedtext, out _)
                        ? lastRow.conclusionforfixedtext
                        : (!string.IsNullOrWhiteSpace(existingCustomFooter)
                            ? existingCustomFooter
                            : (!string.IsNullOrWhiteSpace(existingCustomConclusion)
                                ? existingCustomConclusion
                                : (!string.IsNullOrWhiteSpace(testMasterFooter) ? testMasterFooter : ""))));

                if (!string.IsNullOrWhiteSpace(resolvedText))
                {
                    string cleanedText = StripHtml(resolvedText);
                    lastRow.conclusionforfixedtext = cleanedText;
                    lastRow.footermessage = "";
                    lastRow.printconclusioninreport = true;
                }
                else
                {
                    lastRow.footermessage = "";
                    lastRow.conclusionforfixedtext = "";
                }
            }


            var savePayload = lre1.Select(row =>
            {
                bool hasValidEditedDetailNV = row.EditedDetailedNormalValues != null && row.EditedDetailedNormalValues.Any(d => d.rangefrom > 0 || d.rangeto > 0);
                bool hasValidDetailNV = row.detailednormalvalues != null && row.detailednormalvalues.Any(d => d.rangefrom > 0 || d.rangeto > 0);
                bool isDetailedNVActive = hasValidEditedDetailNV || hasValidDetailNV;

                int userCodeVal = row.resultenteredby > 0 ? row.resultenteredby : (userCode > 0 ? userCode : 1);
                int auth1ByVal = row.resultauthorizedby > 0 ? row.resultauthorizedby : (row.isauthorized1 ? userCodeVal : 0);
                int auth2ByVal = row.resultauthorizedby2 > 0 ? row.resultauthorizedby2 : (row.isauthorized2 ? userCodeVal : 0);
                string nowIso = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ss");

                // Resolve conclusion & footer text as entered on the row
                string rowConclusionVal = (!string.IsNullOrWhiteSpace(row.conclusionforfixedtext) && !Guid.TryParse(row.conclusionforfixedtext, out _))
                    ? row.conclusionforfixedtext
                    : "";

                string rowFooterVal = !string.IsNullOrWhiteSpace(row.footermessage) ? row.footermessage : "";

                if (!string.IsNullOrWhiteSpace(rowConclusionVal) && !string.IsNullOrWhiteSpace(rowFooterVal) && rowConclusionVal.Trim() == rowFooterVal.Trim())
                {
                    rowFooterVal = "";
                }

                bool rowPrintConclusion = row.printconclusioninreport || !string.IsNullOrWhiteSpace(rowConclusionVal) || !string.IsNullOrWhiteSpace(rowFooterVal);

                return new
                {
                    // â”€â”€ All-Lowercase Properties matching backend LabResultEntry model â”€â”€
                    requestguid = row.requestguid ?? "",
                    slno = row.slno,
                    tcode = row.tcode,
                    testname = row.testname ?? "",
                    orderno = row.orderno,
                    grouporder = row.grouporder,
                    gcode = row.gcode,
                    groupname = row.groupname ?? "",
                    col2 = !string.IsNullOrWhiteSpace(row.col2) ? row.col2 : (row.testname ?? ""),
                    enteredresult = row.enteredresult ?? "",
                    resultvaluetype = row.resultvaluetype ?? "Text",
                    normalvalue = row.normalvalue ?? "",
                    testresultid = row.testresultid,
                    status = row.status || !string.IsNullOrWhiteSpace(row.enteredresult) || row.isauthorized1,
                    defaultvalueforfxtype = row.defaultvalueforfxtype?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                    fxtcode = row.fxtcode?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                    fromtcode = row.fromtcode,
                    fromtestresultid = row.fromtestresultid?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                    resultnormal = row.resultnormal,
                    resulthigh = row.resulthigh,
                    resultlow = row.resultlow,
                    resulttype = row.resulttype ?? "Result",
                    simplenv = row.simplenv || (row.EditedTextNormalValues != null && row.EditedTextNormalValues.Any()) || (row.textnormalvalues != null && row.textnormalvalues.Any()),
                    detailednv = isDetailedNVActive,
                    calculatedformula = row.calculatedformula ?? "",
                    defaultunitscode = row.defaultunitscode,
                    defaultunitvalue = row.defaultunitvalue ?? "",
                    unitname = row.unitname ?? "",
                    mccode = row.mccode > 0 ? row.mccode : 1,
                    machinename = row.mccode > 0 ? (row.machinename ?? "Manual") : "Manual",
                    scode = row.scode > 0 ? row.scode : 1,
                    samplename = row.samplename ?? "Serum",
                    rtmcode = row.rtmcode > 0 ? row.rtmcode : 0,
                    fixedvalues = row.fixedvalues ?? "",

                    resultenteredby = userCodeVal,
                    isauthorized1 = row.isauthorized1,
                    isauthorized2 = row.isauthorized2,
                    resultauthorizedby = auth1ByVal,
                    resultauthorizedby2 = auth2ByVal,
                    firstauthorizedate = row.isauthorized1 ? nowIso : null,
                    secondauthorizedate = row.isauthorized2 ? nowIso : null,
                    resultentereddate = nowIso,
                    estylecode = row.estylecode,

                    decimalvalue = row.decimalvalue,
                    isgraph = row.isgraph ?? false,
                    graphvalue = row.graphvalue ?? 0.0,
                    footermessage = rowFooterVal,
                    conclusionforhigher = row.conclusionforhigher ?? "",
                    conclusionforlower = row.conclusionforlower ?? "",
                    conclusionforfixedtext = rowConclusionVal,
                    showagedbased = row.showagedbased,
                    printconclusioninreport = rowPrintConclusion,
                    printfixedtextconclusioninreport = rowPrintConclusion,

                    printconclusioninbottom = row.printconclusioninbottom,
                    showalertonhigherlower = row.showalertonhigherlower,
                    printunitsinnormalvalues = row.printunitsinnormalvalues,
                    printnormalvaluesatbottom = row.printnormalvaluesatbottom,
                    printspecialfieldsatrightside = row.printspecialfieldsatrightside,
                    groupvaluesbysex = row.groupvaluesbysex,
                    groupvaluesbyspecialfield = row.groupvaluesbyspecialfield,
                    tenant_code = tenantCode ?? "",
                    image_path = row.image_path ?? "",

                    labproperties = new[]
                    {
                        new
                        {
                            trpid = Guid.NewGuid().ToString(),
                            testresultid = row.testresultid?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                            resultvaluetype = row.resultvaluetype ?? "Text",
                            defaultunitscode = row.defaultunitscode,
                            fxtcode = row.fxtcode?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                            defaultvalueforfxtype = row.defaultvalueforfxtype?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                            defaultvalue = row.defaultvalue ?? "",
                            simplenormalvalues = row.simplenv,
                            detailednormalvalues = isDetailedNVActive,
                            rangetype = "Normal",
                            fromnormalvalue = 0.0,
                            tonormalvalue = 0.0,
                            conclusionforfixedtext = rowConclusionVal,
                            conclusionforhigher = row.conclusionforhigher ?? "",
                            conclusionforlower = row.conclusionforlower ?? "",
                            showagedbased = row.showagedbased,
                            printconclusioninreport = rowPrintConclusion,
                            printfixedtextconclusioninreport = rowPrintConclusion,
                            printconclusioninbottom = row.printconclusioninbottom,
                            showalertonhigherlower = row.showalertonhigherlower,
                            printunitsinnormalvalues = row.printunitsinnormalvalues,
                            printnormalvaluesatbottom = row.printnormalvaluesatbottom,
                            printspecialfieldsatrightside = row.printspecialfieldsatrightside,
                            groupvaluesbysex = row.groupvaluesbysex,
                            groupvaluesbyspecialfield = row.groupvaluesbyspecialfield,
                            footermessage = rowFooterVal,
                            rtmcode = row.rtmcode > 0 ? row.rtmcode : 0,
                            resultnormal = row.resultnormal,
                            resulthigh = row.resulthigh,
                            resultlow = row.resultlow,
                            isgraph = row.isgraph ?? false,
                            graphvalue = row.graphvalue ?? 0.0,
                            decimalvalue = row.decimalvalue,
                            scode = row.scode > 0 ? row.scode : 1,
                            mccode = row.mccode > 0 ? row.mccode : 1,
                            performedcount = 1,
                            usedefault = true,
                            normalvalueforfxtype = "00000000-0000-0000-0000-000000000000",
                            normalvalue = row.normalvalue ?? "",
                            tenant_code = tenantCode ?? ""
                        }
                    },

                    lab_result_properties = new[]
                    {
                        new
                        {
                            trpid = Guid.NewGuid().ToString(),
                            testresultid = row.testresultid?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                            resultvaluetype = row.resultvaluetype ?? "Text",
                            defaultunitscode = row.defaultunitscode,
                            fxtcode = row.fxtcode?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                            defaultvalueforfxtype = row.defaultvalueforfxtype?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                            defaultvalue = row.defaultvalue ?? "",
                            simplenormalvalues = row.simplenv,
                            detailednormalvalues = isDetailedNVActive,
                            rangetype = "Normal",
                            fromnormalvalue = 0.0,
                            tonormalvalue = 0.0,
                            conclusionforfixedtext = rowConclusionVal,
                            conclusionforhigher = row.conclusionforhigher ?? "",
                            conclusionforlower = row.conclusionforlower ?? "",
                            showagedbased = row.showagedbased,
                            printconclusioninreport = rowPrintConclusion,
                            printfixedtextconclusioninreport = rowPrintConclusion,
                            printconclusioninbottom = row.printconclusioninbottom,
                            showalertonhigherlower = row.showalertonhigherlower,
                            printunitsinnormalvalues = row.printunitsinnormalvalues,
                            printnormalvaluesatbottom = row.printnormalvaluesatbottom,
                            printspecialfieldsatrightside = row.printspecialfieldsatrightside,
                            groupvaluesbysex = row.groupvaluesbysex,
                            groupvaluesbyspecialfield = row.groupvaluesbyspecialfield,
                            footermessage = rowFooterVal,
                            rtmcode = row.rtmcode > 0 ? row.rtmcode : 0,
                            resultnormal = row.resultnormal,
                            resulthigh = row.resulthigh,
                            resultlow = row.resultlow,
                            isgraph = row.isgraph ?? false,
                            graphvalue = row.graphvalue ?? 0.0,
                            decimalvalue = row.decimalvalue,
                            scode = row.scode > 0 ? row.scode : 1,
                            mccode = row.mccode > 0 ? row.mccode : 1,
                            performedcount = 1,
                            usedefault = true,
                            normalvalueforfxtype = "00000000-0000-0000-0000-000000000000",
                            normalvalue = row.normalvalue ?? "",
                            tenant_code = tenantCode ?? ""
                        }
                    },

                    textnormalvalues = ((row.EditedTextNormalValues != null && row.EditedTextNormalValues.Any()) ? row.EditedTextNormalValues : (row.textnormalvalues ?? emptyTextNV)).Select(tnv => new {
                        trtid = (tnv.trtid.HasValue && tnv.trtid.Value != Guid.Empty) ? tnv.trtid.Value.ToString() : Guid.NewGuid().ToString(),
                        testresultid = row.testresultid?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                        sex = tnv.sex ?? "-",
                        normalvalue = tnv.normalvalue ?? "",
                        tenant_code = tenantCode ?? "",
                        mccode = 1, performedcount = 1, scode = 1
                    }).ToList(),

                    detailednormalvalues = isDetailedNVActive ? ((hasValidEditedDetailNV ? row.EditedDetailedNormalValues! : row.detailednormalvalues!)).Select(dnv => new {
                        trdnid = (dnv.trdnid.HasValue && dnv.trdnid.Value != Guid.Empty) ? dnv.trdnid.Value.ToString() : (dnv.dnvid.HasValue && dnv.dnvid.Value != Guid.Empty ? dnv.dnvid.Value.ToString() : Guid.NewGuid().ToString()),
                        testresultid = row.testresultid?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                        sno = dnv.sno,
                        agefrom = dnv.agefrom, agefromtype = dnv.agefromtype ?? "-",
                        ageto = dnv.ageto, agetotype = dnv.agetotype ?? "-",
                        sex = dnv.sex ?? "Both",
                        rangetype = dnv.rangetype ?? "-", rangefrom = dnv.rangefrom, rangeto = dnv.rangeto,
                        specialconditioncode = (dnv.specialconditioncode != null && Guid.TryParse(dnv.specialconditioncode.ToString(), out var parsedSpec) && parsedSpec != Guid.Empty) ? parsedSpec.ToString() : "00000000-0000-0000-0000-000000000000",
                        agerangetype = dnv.agerangetype ?? "-",
                        tenant_code = tenantCode ?? "",
                        mccode = 1, performedcount = 1, scode = 1
                    }).ToList() : emptyDetailNV.Select(dnv => new {
                        trdnid = Guid.NewGuid().ToString(),
                        testresultid = "00000000-0000-0000-0000-000000000000",
                        sno = (int?)0, agefrom = (int?)0, agefromtype = "-", ageto = (int?)0, agetotype = "-", sex = "Both",
                        rangetype = "-", rangefrom = (double?)0.0, rangeto = (double?)0.0, specialconditioncode = "00000000-0000-0000-0000-000000000000",
                        agerangetype = "-", tenant_code = tenantCode ?? "", mccode = 1, performedcount = 1, scode = 1
                    }).Take(0).ToList(),

                    calculatedformulas = ((row.EditedCalculatedFormulas != null && row.EditedCalculatedFormulas.Any()) ? row.EditedCalculatedFormulas : (row.calculatedformulas ?? emptyCF)).Select(cf => new {
                        trcfid = (cf.trcfid.HasValue && cf.trcfid.Value != Guid.Empty) ? cf.trcfid.Value.ToString() : Guid.NewGuid().ToString(),
                        testresultid = row.testresultid?.ToString() ?? "00000000-0000-0000-0000-000000000000",
                        sex = cf.sex ?? "-",
                        calculatedformula = cf.calculatedformula ?? "",
                        tenant_code = tenantCode ?? "",
                        mccode = 1, performedcount = 1, scode = 1
                    }).ToList()
                };
            }).ToList();


            // Backend expects a bare JSON array: [{...}, ...]
            var json = JsonConvert.SerializeObject(savePayload);

            // â”€â”€ Auth field diagnostic (untruncated, per-row) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            Console.WriteLine($"--- SAVE RESULTS PAYLOAD AUTH FIELDS ---");
            foreach (var r in savePayload)
            {
                var authSnap = JsonConvert.SerializeObject(new {
                    slno = r.slno, tcode = r.tcode, col2 = r.col2,
                    isauthorized1 = r.isauthorized1, isauthorized2 = r.isauthorized2,
                    resultauthorizedby = r.resultauthorizedby, resultauthorizedby2 = r.resultauthorizedby2,
                    resultenteredby = r.resultenteredby, status = r.status
                });
                Console.WriteLine($"[AUTH-DIAG] {authSnap}");
            }
            Console.WriteLine($"--- END AUTH FIELDS ---");

            Console.WriteLine($"--- SAVE RESULTS PAYLOAD LOG ---");
            Console.WriteLine($"Rows: {savePayload.Count}");
