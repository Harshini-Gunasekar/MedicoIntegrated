        };

    private async Task HandleUnifiedAction()
    {
        if (isSaving || isviewer || isBilledLocked) return;

        int level = currentActionLevel;
        if (level == 3)
        {
            if (isEditMode || isauthorized2 || userCode == 1)
            {
                TriggerSaveResults(2);
            }
            else
            {
                Toast.Info("Results are already fully authorized. Click 'Enable Edit' to modify.");
            }
            return;
        }

        if (level == 2)
        {
            if (!isauthorized2 && userCode != 1)
            {
                Toast.ShowError("You do not have permission to Approve results (Level 2 / Approved right required).");
                return;
            }
            TriggerSaveResults(2);
        }
        else if (level == 1)
        {
            if (!isauthorized1 && userCode != 1)
            {
                Toast.ShowError("You do not have permission to Verify results (Level 1 / Verified right required).");
                return;
            }
            await SaveResults(1);
        }
        else
        {
            if (!isentered && userCode != 1)
            {
                Toast.ShowError("You do not have permission to Save results (Result Entry / Save right required).");
                return;
            }
            await SaveResults(0);
        }
    }

