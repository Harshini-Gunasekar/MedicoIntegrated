                string format = string.IsNullOrEmpty(file.ContentType) ? "image/jpeg" : file.ContentType;
                string rawBase64 = $"data:{format};base64,{Convert.ToBase64String(bytes)}";

                string compactBase64 = format.StartsWith("image/") ? await MakeCompactBase64Image(rawBase64) : rawBase64;

