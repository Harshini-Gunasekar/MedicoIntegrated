        StateHasChanged();
        try
        {
            InvalidateAllTestConfigs();
            await LoadResults(forceRefreshMaster: true);
            Toast.ShowSuccess("Latest normal values reloaded from Test Master.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to reload normal values: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }


