                                                            var isSelected = string.Equals(u.name?.Trim(), it.unitname?.Trim(), StringComparison.OrdinalIgnoreCase);
                                                            <option value="@u.name" selected="@isSelected">@u.name</option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                            <td class="re-edit-cell">
                                                 <input type="text" id="@($"txt-{rowIndex}-normal")" class="re-t-input" 
                                                        value="@it.normalvalue"
                                                        @oninput="@(e => { it.normalvalue = e.Value?.ToString() ?? ""; })"
                                                        @onchange="@(e => { it.normalvalue = e.Value?.ToString() ?? ""; StateHasChanged(); })"
                                                        autocomplete="off" placeholder="Normal range..."
                                                        @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "normal"))" disabled="@(!(isEditMode || IsRowEditable(it)))" />
                                             </td>
                                         }
                                        <td class="re-edit-cell">
                                            <input type="text" id="@($"txt-{rowIndex}-machine")" class="re-t-input" @bind="@it.machinename" placeholder="-" autocomplete="off"
