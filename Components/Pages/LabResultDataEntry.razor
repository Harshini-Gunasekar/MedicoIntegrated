                                        </td>
                                        <td class="re-edit-cell">
                                            <input type="text" id="@($"txt-{rowIndex}-sample")" class="re-t-input" @bind="@it.samplename" placeholder="Specimen..." autocomplete="off"
                                                   @onkeydown="@(e => HandleGridKeydown(e, rowIndex, "sample"))" disabled="@(!(isEditMode || IsRowEditable(it)))" />
                                        </td>
                                        <td class="re-col-center" style="width:75px; white-space: nowrap; padding: 2px 4px;">
                                            <div style="display: inline-flex; align-items: center; gap: 4px;">
