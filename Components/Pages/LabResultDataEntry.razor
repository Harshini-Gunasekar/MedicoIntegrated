    private void UpdateRowSettings()
    {
        if (SelectedRowEntry == null) return;
        
        // Handle TN (Text & Number) logic specifically
        if (resulttype == "Text & Number" && SelectedRowEntry.resultvaluetype != "Text & Number")
        {
            // Ensure testresultid is properly managed when switching to TN
            // If it was a master record (empty GUID or placeholder), generate a new specific ID
            if (SelectedRowEntry.testresultid == null || SelectedRowEntry.testresultid == Guid.Empty)
            {
                SelectedRowEntry.testresultid = Guid.NewGuid();
            }
            // Trigger metadata sync for the new type
            SelectedRowEntry.detailednv = true; 
            DetailedNormalRange = true;
        }

        SelectedRowEntry.resultvaluetype = resulttype;
        SelectedRowEntry.enteredresult = ResultText;
        SelectedRowEntry.resulthigh = (AlertType == "High");
        SelectedRowEntry.resultlow = (AlertType == "Low");
        SelectedRowEntry.resultnormal = (AlertType == "Normal");
        SelectedRowEntry.printresultonly = PrintResultsOnly;
        SelectedRowEntry.estylecode = IsResultBold ? 1 : 0;
        SelectedRowEntry.detailednv = DetailedNormalRange;
        SelectedRowEntry.showagedbased = DetailedNormalRange;
        SelectedRowEntry.unitname = SelectedUnit;
        SelectedRowEntry.normalvalue = NormalValueText;
        SelectedRowEntry.decimalvalue = decimalvalue;
        SelectedRowEntry.showalertonhigherlower = ShowAlertLowerHigher;
        SelectedRowEntry.normalvalue = ReferenceValueText;
        SelectedRowEntry.isauthorized1 = IsAuthorizedRow;
        SelectedRowEntry.footermessage = StripHtml(FooterMessageText);
        SelectedRowEntry.conclusionforfixedtext = StripHtml(ConclusionText);
        SelectedRowEntry.printconclusioninreport = printconclusioninreport;

        if (SelectedRowEntry.tcode > 0)
        {
            var groupRows = lre1.Where(r => r.tcode == SelectedRowEntry.tcode).ToList();
            foreach (var grpRow in groupRows)
            {
                grpRow.footermessage = SelectedRowEntry.footermessage;
                grpRow.conclusionforfixedtext = SelectedRowEntry.conclusionforfixedtext;
                grpRow.printconclusioninreport = SelectedRowEntry.printconclusioninreport;
            }
        }



        if (resulttype == "Fixed Type")
        {
            if (!string.IsNullOrEmpty(FixedResultSelect))
            {
                ResultText = FixedResultSelect;
                SelectedRowEntry.enteredresult = FixedResultSelect;
            }
            if (!string.IsNullOrEmpty(FixedNormalValueSelect))
            {
                NormalValueText = FixedNormalValueSelect;
                SelectedRowEntry.normalvalue = FixedNormalValueSelect;
            }
        }
        
        SelectedRowEntry.enteredresult = ResultText;
        SelectedRowEntry.normalvalue = NormalValueText;
        
        if (int.TryParse(SelectedMethod, out int rtmcode))
        {
            SelectedRowEntry.rtmcode = rtmcode;
        }

        // Synchronize 'Edited' lists to ensure backend persistence
        SyncEditedCollections(SelectedRowEntry);

        // Also synchronize local row collections so the main grid reflects changes instantly
        SelectedRowEntry.detailednormalvalues = SelectedRowEntry.EditedDetailedNormalValues;
        SelectedRowEntry.textnormalvalues = SelectedRowEntry.EditedTextNormalValues;
        SelectedRowEntry.calculatedformulas = SelectedRowEntry.EditedCalculatedFormulas;

        // Close panel after update
        IsDetailedNormalValuesVisible = false;
        _ = RunCalculations();
        StateHasChanged();
    }

    private void SyncEditedCollections(LabResultEntry row)
    {
        if (row == null) return;

        // 1. Sync Text Normal Values
        if (row.EditedTextNormalValues == null) row.EditedTextNormalValues = new();
        
        // Prioritize existing database records. If empty, sync from current UI string.
        if (row.EditedTextNormalValues.Count == 0 && !string.IsNullOrWhiteSpace(row.normalvalue))
        {
            row.EditedTextNormalValues.Add(new Lab_Result_TextNormalValues 
            { 
                trtid = Guid.NewGuid(), 
                testresultid = row.testresultid, 
                sex = "Both", 
                normalvalue = row.normalvalue 
