                        {
                            csCandidates.Add($"api/CaseSheet/investigation?op_id={_resolvedBilledGuid}");
                            csCandidates.Add($"api/CaseSheet/investigation?ip_id={_resolvedBilledGuid}");
                        }
                        if (!string.IsNullOrEmpty(rawCust))
                        {
                            csCandidates.Add($"api/CaseSheet/investigation?custcode={rawCust}");
                            if (!string.IsNullOrEmpty(numCust)) csCandidates.Add($"api/CaseSheet/investigation?custcode=CUST-{numCust}");
                        }
                        if (!string.IsNullOrEmpty(rowCust) && rowCust != rawCust)
                        {
                            csCandidates.Add($"api/CaseSheet/investigation?custcode={rowCust}");
                            if (!string.IsNullOrEmpty(numRowCust)) csCandidates.Add($"api/CaseSheet/investigation?custcode=CUST-{numRowCust}");
                        }

                        foreach (var ep in csCandidates.Distinct())
                        {
                            try
                            {
                                var csReq = new HttpRequestMessage(HttpMethod.Get, ep);
                                if (!string.IsNullOrEmpty(token)) csReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                                if (!string.IsNullOrEmpty(targetEffectiveTenant)) csReq.Headers.Add("tenant_code", targetEffectiveTenant);
                                
                                var csRes = await ClientFactory.CreateClient("Medico").SendAsync(csReq, SafeToken);
                                if (csRes.IsSuccessStatusCode)
                                {
                                    var csJson = await csRes.Content.ReadAsStringAsync(SafeToken);
                                    if (csJson.TrimStart().StartsWith("["))
                                    {
                                        var allHeaders = JsonConvert.DeserializeObject<List<CaseSheetInvestigationAllDto>>(csJson);
                                        if (allHeaders != null && allHeaders.Any())
                                        {
                                            var matchedHeaders = allHeaders.Where(h =>
                                                (!string.IsNullOrEmpty(h.op_id) && (h.op_id.Equals(RequestGuid, StringComparison.OrdinalIgnoreCase) || h.op_id.Equals(_resolvedBilledGuid, StringComparison.OrdinalIgnoreCase))) ||
                                                (!string.IsNullOrEmpty(h.custcode) && (h.custcode.Equals(rawCust, StringComparison.OrdinalIgnoreCase) || h.custcode.Equals(rowCust, StringComparison.OrdinalIgnoreCase) || (!string.IsNullOrEmpty(numCust) && h.custcode.Contains(numCust)))) ||
                                                (h.custid.HasValue && !string.IsNullOrEmpty(numCust) && h.custid.Value.ToString() == numCust)
                                            ).ToList();

                                            foreach (var mh in matchedHeaders)
                                            {
                                                string detailEp = !string.IsNullOrEmpty(mh.inv_id)
                                                    ? $"api/CaseSheet/investigation?inv_id={mh.inv_id}"
                                                    : (!string.IsNullOrEmpty(mh.op_id) ? $"api/CaseSheet/investigation?op_id={mh.op_id}" : "");
                                                
                                                if (string.IsNullOrEmpty(detailEp)) continue;

                                                var dReq = new HttpRequestMessage(HttpMethod.Get, detailEp);
                                                if (!string.IsNullOrEmpty(token)) dReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                                                if (!string.IsNullOrEmpty(targetEffectiveTenant)) dReq.Headers.Add("tenant_code", targetEffectiveTenant);

                                                var dRes = await ClientFactory.CreateClient("Medico").SendAsync(dReq, SafeToken);
                                                if (dRes.IsSuccessStatusCode)
                                                {
                                                    var dJson = await dRes.Content.ReadAsStringAsync(SafeToken);
                                                    var dObj = JsonConvert.DeserializeObject<CaseSheetInvestigationDetailDto>(dJson);
                                                    if (dObj?.tests != null)
                                                    {
                                                        foreach (var t in dObj.tests)
                                                        {
                                                            if (!string.IsNullOrEmpty(t.inv_det_id))
                                                            {
                                                                csAllTests.Add(t);
                                                                if (t.test_code.HasValue && t.test_code.Value > 0) csMap[t.test_code.Value] = t.inv_det_id;
                                                                if (!string.IsNullOrEmpty(t.test_name)) csNameMap[t.test_name.Trim()] = t.inv_det_id;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    else
                                    {
                                        var csObj = JsonConvert.DeserializeObject<CaseSheetInvestigationDetailDto>(csJson);
                                        if (csObj?.tests != null)
                                        {
                                            foreach (var t in csObj.tests)
                                            {
                                                if (!string.IsNullOrEmpty(t.inv_det_id))
                                                {
                                                    csAllTests.Add(t);
                                                    if (t.test_code.HasValue && t.test_code.Value > 0) csMap[t.test_code.Value] = t.inv_det_id;
                                                    if (!string.IsNullOrEmpty(t.test_name)) csNameMap[t.test_name.Trim()] = t.inv_det_id;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            catch { }
                        }
                    }
                    catch { }

                    var groups = lre1.GroupBy(x => {
                        if (!string.IsNullOrEmpty(x.inv_det_id)) return x.inv_det_id;
                        int parentTCode = x.fromtcode > 0 ? x.fromtcode : x.tcode;
                        if (csMap.TryGetValue(parentTCode, out var mappedInvDetId)) return mappedInvDetId;
                        if (csMap.TryGetValue(x.tcode, out var mappedTCodeInvDetId)) return mappedTCodeInvDetId;
                        string gName = x.groupname ?? x.testname ?? "";
                        if (!string.IsNullOrEmpty(gName) && csNameMap.TryGetValue(gName.Trim(), out var mappedNameInvDetId)) return mappedNameInvDetId;
                        return x.testresultid != Guid.Empty ? x.testresultid.ToString() : (parentTCode > 0 ? parentTCode.ToString() : Guid.NewGuid().ToString());
                    });

                    foreach (var grp in groups)
                    {
                        var entriesWithResult = grp.Where(x => !string.IsNullOrWhiteSpace(x.enteredresult)).ToList();
                        if (!entriesWithResult.Any()) continue;

                        string targetInvDetId = grp.FirstOrDefault(x => !string.IsNullOrEmpty(x.inv_det_id))?.inv_det_id;
                        if (string.IsNullOrEmpty(targetInvDetId) && Guid.TryParse(grp.Key, out _))
                        {
                            targetInvDetId = grp.Key;
                        }

                        if (string.IsNullOrEmpty(targetInvDetId) && csAllTests.Any())
                        {
                            var grpFirstName = grp.FirstOrDefault()?.groupname ?? grp.FirstOrDefault()?.testname ?? "";
                            var fuzzyMatch = csAllTests.FirstOrDefault(t =>
                                !string.IsNullOrEmpty(t.test_name) && !string.IsNullOrEmpty(grpFirstName) &&
                                (t.test_name.Contains(grpFirstName, StringComparison.OrdinalIgnoreCase) || grpFirstName.Contains(t.test_name, StringComparison.OrdinalIgnoreCase))
                            );
                            if (fuzzyMatch != null && !string.IsNullOrEmpty(fuzzyMatch.inv_det_id))
                            {
                                targetInvDetId = fuzzyMatch.inv_det_id;
                            }
                            else
                            {
                                targetInvDetId = csAllTests.FirstOrDefault()?.inv_det_id;
                            }
                        }

                        if (string.IsNullOrEmpty(targetInvDetId) || !Guid.TryParse(targetInvDetId, out _))
                        {
                            continue;
                        }

                        var parts = new List<string>();
                        foreach (var entry in entriesWithResult)
                        {
                            string val = entry.enteredresult?.Trim() ?? "";
                            string unit = entry.unitname?.Trim() ?? "";
                            string pName = !string.IsNullOrWhiteSpace(entry.col2) ? entry.col2.Trim() : (!string.IsNullOrWhiteSpace(entry.testname) ? entry.testname.Trim() : "");

                            if (grp.Count() > 1 || (!string.IsNullOrWhiteSpace(entry.col2) && entry.col2.Trim() != (grp.FirstOrDefault()?.testname?.Trim() ?? "")))
                            {
                                if (!string.IsNullOrEmpty(pName))
                                {
                                    parts.Add(!string.IsNullOrEmpty(unit) ? $"{pName}: {val} {unit}" : $"{pName}: {val}");
                                }
                                else
                                {
                                    parts.Add(!string.IsNullOrEmpty(unit) ? $"{val} {unit}" : val);
                                }
                            }
                            else
                            {
                                parts.Add(!string.IsNullOrEmpty(unit) ? $"{val} {unit}" : val);
                            }
                        }

                        string combinedResultValue = string.Join(", ", parts);
                        string notes = grp.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.footermessage))?.footermessage 
                                    ?? grp.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.conclusionforfixedtext))?.conclusionforfixedtext 
                                    ?? "";

                        var payload = new
                        {
                            inv_det_id = targetInvDetId,
                            result_value = combinedResultValue,
                            result_notes = notes,
                            result_status = "COMPLETED"
                        };

                        string targetEffectiveTenant = !string.IsNullOrEmpty(tenantCode) ? tenantCode : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");
                        var csResultReq = new HttpRequestMessage(HttpMethod.Post, "api/CaseSheet/investigation/result")
                        {
                            Content = new StringContent(JsonConvert.SerializeObject(payload), System.Text.Encoding.UTF8, "application/json")
                        };
                        if (!string.IsNullOrEmpty(token)) csResultReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                        if (!string.IsNullOrEmpty(targetEffectiveTenant)) csResultReq.Headers.Add("tenant_code", targetEffectiveTenant);
                        
                        var csResOut = await ClientFactory.CreateClient("Medico").SendAsync(csResultReq, SafeToken);
                        if (csResOut.IsSuccessStatusCode)
                        {
                            csSyncSuccess = true;
                            Console.WriteLine($"[SAVE] Successfully synced investigation result to CaseSheet for inv_det_id: {targetInvDetId}");
                        }
                    }
                }
            }
            catch (Exception csSyncEx)
            {
                Console.WriteLine($"[SAVE] CaseSheet result sync error: {csSyncEx.Message}");
            }

            if (isBackendSuccess || csSyncSuccess)
            {
                // Upload attached proof images via api/LabResult/saveresultimage if any images exist
                if (rowImageMap != null && rowImageMap.Any())
                {
                    try
                    {
                        var imgForm = new MultipartFormDataContent();
                        int fIdx = 0;
                        foreach (var kvp in rowImageMap)
                        {
                            var trId = kvp.Key;
                            var imgData = kvp.Value;
                            if (string.IsNullOrWhiteSpace(imgData.base64Data)) continue;

                            string rawB64 = imgData.base64Data.Contains(",") ? imgData.base64Data.Split(',')[1] : imgData.base64Data;
                            byte[] fileBytes = Convert.FromBase64String(rawB64);
                            var byteContent = new ByteArrayContent(fileBytes);
                            string mime = imgData.base64Data.StartsWith("data:application/pdf", StringComparison.OrdinalIgnoreCase) ? "application/pdf" : 
                                         (imgData.base64Data.StartsWith("data:image/png", StringComparison.OrdinalIgnoreCase) ? "image/png" : 
                                         (imgData.base64Data.StartsWith("data:image/gif", StringComparison.OrdinalIgnoreCase) ? "image/gif" : "image/jpeg"));
                            byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(mime);

                            imgForm.Add(new StringContent(trId.ToString()), $"[{fIdx}].testresultid");
                            imgForm.Add(byteContent, $"[{fIdx}].image_file", imgData.fileName);
                            fIdx++;
                        }

                        if (fIdx > 0)
                        {
                            var imgReq = new HttpRequestMessage(HttpMethod.Post, "api/LabResult/saveresultimage")
                            {
                                Content = imgForm
                            };
                            if (!string.IsNullOrEmpty(token)) imgReq.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                            if (!string.IsNullOrEmpty(tenantCode)) imgReq.Headers.Add("tenant_code", tenantCode);

                            var imgResp = await ClientFactory.CreateClient("Medico").SendAsync(imgReq, SafeToken);
                            Console.WriteLine($"[SAVE-IMAGE] saveresultimage status: {imgResp.StatusCode}");
                        }
                    }
                    catch (Exception imgEx)
                    {
                        Console.WriteLine($"[SAVE-IMAGE] Error uploading result images: {imgEx.Message}");
                    }
                }

                saveError = false;
                saveMessage = "✓ Results saved successfully!";
                Toast.ShowSuccess("Results saved successfully!");

                if (!string.IsNullOrEmpty(saveTargetGuid))
                {
                    RequestGuid = saveTargetGuid;
                    _resolvedBilledGuid = saveTargetGuid;
                }

                PersistAuditHistory();

                // Backup manually entered results before reload
                var enteredBackup = lre1.Where(x => !string.IsNullOrWhiteSpace(x.enteredresult))
                                         .ToDictionary(x => x.testresultid != Guid.Empty ? x.testresultid.ToString() : (x.tcode > 0 ? x.tcode.ToString() : x.col2 ?? ""), x => x.enteredresult!);

                // Reload latest saved data from backend DB using the billed requestguid
                await LoadResults();

                // Restore any backed up manual results if reload returned empty strings for them or if in edit mode
                if (enteredBackup.Any() && lre1 != null)
                {
                    foreach (var row in lre1)
                    {
                        string key = row.testresultid != Guid.Empty ? row.testresultid.ToString() : (row.tcode > 0 ? row.tcode.ToString() : row.col2 ?? "");
                        if (enteredBackup.TryGetValue(key, out var bVal) && !string.IsNullOrWhiteSpace(bVal))
                        {
                            if (string.IsNullOrWhiteSpace(row.enteredresult) || isEditMode)
                            {
                                row.enteredresult = bVal;
                                row.status = true;
                            }
                        }
                    }
                }

                UpdateUserNames();
                await RunCalculations();
                StateHasChanged();
            }
            else
            {
                saveError = true;
                saveMessage = $"Save failed on backend: {res.StatusCode} - {resBody}";
                Toast.ShowError(saveMessage);
                showPayloadModal = true;
            }
        }
        catch (OperationCanceledException) { /* Console.WriteLine("[SAVE] Cancelled.") */; }
        catch (ObjectDisposedException) { /* Console.WriteLine("[SAVE] ObjectDisposed (safe to ignore).") */; }
        catch (Exception ex)
        {
            saveError = true;
            saveMessage = $"Error: {ex.Message}";
            Toast.ShowError(saveMessage);
            /* Console.WriteLine($"[SAVE] EXCEPTION: {ex.GetType().Name}: {ex.Message}") */;
            /* Console.WriteLine($"[SAVE] StackTrace: {ex.StackTrace?.Split('\n').FirstOrDefault()}") */;
        }
        finally
        {
            isSaving = false;
            currentSavingLevel = -1;
            StateHasChanged();

            // Auto-dismiss toast after 3 seconds
            _toastCts?.Cancel();
            _toastCts = new System.Threading.CancellationTokenSource();
            var token = _toastCts.Token;
            _ = Task.Delay(3000, token).ContinueWith(_ =>
            {
                if (!token.IsCancellationRequested)
                {
                    saveMessage = "";
                    InvokeAsync(StateHasChanged);
                }
            }, token);
        }
    }

