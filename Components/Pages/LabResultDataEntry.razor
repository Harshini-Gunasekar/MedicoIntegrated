    private async Task OnResultInput(ChangeEventArgs e, LabResultEntry item)
    {
        string val = e.Value?.ToString() ?? "";
        item.enteredresult = val;
        
        bool hasResult = !string.IsNullOrWhiteSpace(val) && val != "-";
        item.status = hasResult;

        if (hasResult && (item.resultenteredby == 0 || item.resultenteredby == null))
        {
            item.resultenteredby = userCode > 0 ? userCode : 1;
        }

        if (item != null)
        {
            var audit = GetAuditItem(item);
            string author = !string.IsNullOrEmpty(currentUserName) ? currentUserName : ResolveUserName(userCode);
            string timeStr = DateTime.Now.ToString("dd/MM/yyyy hh:mm tt");
            if (isauthorized2)
            {
                audit.ApprovedValue = val;
                audit.ApprovedByName = author;
                audit.ApprovedDate = timeStr;
                string prev = !string.IsNullOrEmpty(audit.VerifiedValue) ? audit.VerifiedValue : audit.SavedValue;
                audit.IsApprovedModified = !string.IsNullOrEmpty(prev) && !string.Equals(prev.Trim(), val.Trim(), StringComparison.OrdinalIgnoreCase);
            }
            else if (isauthorized1)
            {
                audit.VerifiedValue = val;
                audit.VerifiedByName = author;
                audit.VerifiedDate = timeStr;
                audit.IsVerifiedModified = !string.IsNullOrEmpty(audit.SavedValue) && !string.Equals(audit.SavedValue.Trim(), val.Trim(), StringComparison.OrdinalIgnoreCase);
            }
            else
            {
                audit.SavedValue = val;
                audit.SavedByName = author;
                audit.SavedDate = timeStr;
            }
        }

        await RunCalculations();
        UpdateUserNames(); // Reflect name change in footer immediately
    }

