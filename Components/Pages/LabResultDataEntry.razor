    private bool IsRowEditable(LabResultEntry row)
    {
        if (row == null) return false;
        
        // Headers are never editable
        if (row.resultvaluetype == "Title" || row.resultvaluetype == "SubTitle") return false;

        // Level 2 Auth (auth 2) or Admin can ALWAYS edit at any time
        if (isauthorized2 || userCode == 1 || (isentered && isauthorized1 && isauthorized2)) return true;

        // If Edit Mode is explicitly enabled, allow row editing
        if (isEditMode) return true;

        // Escalation check
        if (IsRowEscalated(row))
        {
            int assignedUser = GetAssignedUserCode(row.tcode);
            if (userCode != assignedUser)
            {
                // If they only have level 2 auth rights and are not the assigned pathologist, they cannot edit/authorize.
                if (isauthorized2 && !isauthorized1 && !isentered) return false;
            }
        }

        // Level 1 Auth: Can edit if not yet Auth 2'd AND (not yet Auth 1'd OR I am the one who Auth 1'd it)
        if (isauthorized1) return row.resultauthorizedby2 == 0 && (row.resultauthorizedby == 0 || row.resultauthorizedby == userCode);
        
        // Result Entry: Can edit only if not authorized at all
        if (isentered) return row.resultauthorizedby == 0 && row.resultauthorizedby2 == 0;
        
        return false;
    }

    private bool IsRowAuthorized1Any() => lre1 != null && (isauthorized2 || userCode == 1 || lre1.Any(x => x.resultauthorizedby2 == 0 && (x.resultauthorizedby == 0 || x.resultauthorizedby == userCode)));
    private bool IsRowAuthorized2Any() => lre1 != null && (isauthorized2 || userCode == 1 || lre1.Any(x => x.resultauthorizedby2 == 0 || x.resultauthorizedby2 == userCode));
    private bool IsRowEditableAny() => lre1 != null && (isauthorized2 || userCode == 1 || lre1.Any(x => IsRowEditable(x)));

    private bool canSave => IsRowEditableAny();
