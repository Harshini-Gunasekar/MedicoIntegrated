@page "/ledgergroup"
@page "/ledgergroups"
@using Booking.Models
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.NotificationService NotificationService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject Booking.Services.ToastService ToastService

<div class="items-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                            <line x1="3" y1="9" x2="21" y2="9" />
                            <line x1="9" y1="21" x2="9" y2="9" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Accounting Group Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total groups : @LedgerGroupList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by name, shortname..." @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    @if (hasCreateRight)
                    {
                        <button class="add-item-btn" @onclick="AddNewGroup">
                            <i class="bi bi-plus-lg"></i>
                            <span class="ms-1">Add Group</span>
                        </button>
                    }
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredGroups.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        No ledger groups found. Create a new accounting group.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 70px; text-align: center;">S.NO</th>
                                    <th style="width: 100px; text-align: center;">CODE</th>
                                    <th style="width: 15%; text-align: center;">SHORT NAME</th>
                                    <th style="width: 30%; text-align: center;">GROUP NAME</th>
                                    <th style="width: 20%; text-align: center;">LEDGER TYPE</th>
                                    <th style="width: 120px; text-align: center;">STATUS</th>
                                    <th style="width: 100px; text-align: center;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedGroups.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td style="text-align: center; font-weight: 700; color: #3b82f6;">@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td style="text-align: center; font-weight: 700; color: #4f46e5;">#@row.value.ledgergroupcode</td>
                                        <td style="font-weight: 700; color: #0f172a; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.shortname) ? "N/A" : row.value.shortname)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@row.value.ledgergroupname</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@GetLedgerTypeName(row.value.ledgertypecode)</td>
                                        <td style="text-align: center;">
                                            @if (row.value.isactive) {
                                                <span style="color: #059669; font-weight: 700; font-size: 0.78rem; text-transform: uppercase;">Active</span>
                                            } else {
                                                <span style="color: #64748b; font-weight: 700; font-size: 0.78rem; text-transform: uppercase;">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            @if (hasEditRight)
                                            {
                                                <button class="action-btn btn-edit" @onclick="() => EditGroup(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            }
                                            @if (hasDeleteRight)
                                            {
                                                <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var group in PagedGroups)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span>#@group.ledgergroupcode - @group.ledgergroupname</span>
                                    <div>
                                        @if (hasEditRight)
                                        {
                                            <button class="action-btn btn-edit" @onclick="() => EditGroup(group)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(group)" title="Delete"><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Short Name</span><strong>@group.shortname</strong></div>
                                    <div class="detail-row"><span>Ledger Type</span><strong>@GetLedgerTypeName(group.ledgertypecode)</strong></div>
                                    <div class="detail-row"><span>Status</span><strong>@(group.isactive ? "Active" : "Inactive")</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredGroups.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredGroups.Count()))</strong> of <strong>@FilteredGroups.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 600px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #000000 !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Accounting Group" : "Add Accounting Group")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentItem" OnValidSubmit="Save" autocomplete="off">
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 8px 16px 8px 0px;">
                        
                        <div class="form-grid">
                            <div class="field-group col-4">
                                <label class="field-label required">Group Code</label>
                                <InputNumber class="form-control premium-input" @bind-Value="LedgerGroupCodeInput" placeholder="0" />
                            </div>
                            <div class="field-group col-8">
                                <label class="field-label required">Group Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.ledgergroupname" placeholder="E.g. Sundry Debtors" />
                            </div>
                            <div class="field-group col-6">
                                <label class="field-label required">Short Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.shortname" placeholder="E.g. SD" />
                            </div>
                            
                            <div class="field-group col-6">
                                <label class="field-label required">Ledger Type</label>
                                <InputSelect class="form-control premium-input" @bind-Value="MappedLedgerTypeCode">
                                    <option value="0">Select Type...</option>
                                    <option value="1">Asset</option>
                                    <option value="2">Liability</option>
                                    <option value="3">Expense</option>
                                    <option value="4">Income</option>
                                </InputSelect>
                            </div>

                            <div class="field-group col-8">
                                <label class="field-label">Description</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.description" placeholder="Description..." />
                            </div>

                            <div class="field-group col-4">
                                <label class="field-label">Is Active?</label>
                                <div class="premium-segmented-control-joined" style="max-width: 140px; height: 38px; border-radius: 8px;">
                                    <button type="button" class="segment-btn-joined btn-false @(CurrentItem.isactive ? "" : "active")" @onclick="() => CurrentItem.isactive = false" style="font-size: 0.85rem;">
                                        False
                                    </button>
                                    <button type="button" class="segment-btn-joined btn-true @(CurrentItem.isactive ? "active" : "")" @onclick="() => CurrentItem.isactive = true" style="font-size: 0.85rem;">
                                        True
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer-actions" style="display: flex; justify-content: flex-end; align-items: center; padding: 1.5rem 2rem; border-top: 1px solid #f1f5f9; background: #fff;">
                        <div class="footer-right" style="display: flex; gap: 1rem; align-items: center;">
                            <button type="button" class="btn-cancel-modal" @onclick="CloseModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.75rem 2rem; border-radius: 12px; font-weight: 700; min-width: 120px; transition: all 0.2s;">
                                Cancel
                            </button>
                            <button type="submit" class="btn-save-premium" disabled="@IsSaving" style="background: #1c9f5f; color: white; border: none; padding: 0.75rem 2.5rem; border-radius: 12px; font-weight: 700; display: flex; align-items: center; gap: 8px; min-width: 160px; box-shadow: 0 4px 12px rgba(28, 159, 95, 0.2); transition: all 0.2s;">
                                @if (IsSaving)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle" style="font-size: 1.2rem;"></i>
                                }
                                <span>@(IsEdit ? "Update Group" : "Save Group")</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation -->
@if (ShowDeletePopup)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeletePopup = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Ledger Group</div>
            <div class="action-popup-body">Are you sure you want to delete this accounting group?</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowDeletePopup = false">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" disabled="@IsDeleteProcessing" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<ledger_group_master> LedgerGroupList = new();
    private List<ledger_type_master> LedgerTypeList = new();
    
    private string SearchQuery = string.Empty;
    private bool IsLoading;
    private bool IsSaving;
    private bool ShowModal;
    private bool IsEdit;
    private bool ShowDeletePopup;
    private bool IsDeleteProcessing;
    private bool IsCardView = false;
    
    private ledger_group_master CurrentItem = new();
    private ledger_group_master? PendingDelete;

    private int MappedLedgerTypeCode
    {
        get
        {
            if (CurrentItem.ledgertypecode >= 1 && CurrentItem.ledgertypecode <= 4)
            {
                return CurrentItem.ledgertypecode;
            }
            var match = LedgerTypeList.FirstOrDefault(x => x.ledgertypecode == CurrentItem.ledgertypecode);
            if (match != null && match.naturetype >= 1 && match.naturetype <= 4)
            {
                return match.naturetype;
            }
            return 0;
        }
        set
        {
            var match = LedgerTypeList.FirstOrDefault(x => x.naturetype == value);
            if (match != null)
            {
                CurrentItem.ledgertypecode = match.ledgertypecode;
            }
            else
            {
                CurrentItem.ledgertypecode = value;
            }
        }
    }

    private int? LedgerGroupCodeInput
    {
        get => CurrentItem.ledgergroupcode == 0 && !IsEdit ? null : CurrentItem.ledgergroupcode;
        set => CurrentItem.ledgergroupcode = value ?? 0;
    }

    private string DefaultTenantCode = "";

    private void SetView(bool cardView)
    {
        IsCardView = cardView;
        CurrentPage = 1;
    }

    private string GetNatureTypeName(int natureType)
    {
        return natureType switch
        {
            1 => "Asset",
            2 => "Liability",
            3 => "Expense",
            4 => "Income",
            5 => "Duties & Taxes",
            _ => "Unknown"
        };
    }

    private string GetLedgerTypeName(int code)
    {
        var match = LedgerTypeList.FirstOrDefault(x => x.ledgertypecode == code);
        if (match != null)
        {
            return GetNatureTypeName(match.naturetype);
        }
        return GetNatureTypeName(code);
    }

    private IEnumerable<ledger_group_master> FilteredGroups =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? LedgerGroupList
            : LedgerGroupList.Where(l => 
                (l.ledgergroupname?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.shortname?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.ledgergroupcode.ToString().Contains(SearchQuery)));

    // Pagination
    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 12;
    private int TotalPages => (int)Math.Ceiling((double)FilteredGroups.Count() / ItemsPerPage);
    private IEnumerable<ledger_group_master> PagedGroups => FilteredGroups.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    private bool hasViewRight = true;
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
            
            try
            {
                bool isAdmin = false;
                try
                {
                    var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userResult.Success && userResult.Value != null)
                    {
                        isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                  userResult.Value.UserCode == 0 ||
                                  userResult.Value.UserCode == 1;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking user details: {ex.Message}");
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                    hasEditRight = true;
                    hasDeleteRight = true;
                }
                else
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var pageRight = rightsResult.Value.FirstOrDefault(r => 
                            r.ModuleName != null && 
                            r.ModuleName.Trim().Equals("Ledger_Group", StringComparison.OrdinalIgnoreCase));
                        
                        if (pageRight != null)
                        {
                            hasViewRight = pageRight.ToView;
                            hasCreateRight = pageRight.ToAdd;
                            hasEditRight = pageRight.ToEdit;
                            hasDeleteRight = pageRight.ToDelete;
                        }
                        else
                        {
                            hasViewRight = false;
                            hasCreateRight = false;
                            hasEditRight = false;
                            hasDeleteRight = false;
                        }
                    }
                    else
                    {
                        hasViewRight = false;
                        hasCreateRight = false;
                        hasEditRight = false;
                        hasDeleteRight = false;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking Ledger_Group rights: {ex.Message}");
                hasViewRight = false;
                hasCreateRight = false;
                hasEditRight = false;
                hasDeleteRight = false;
            }

            if (!hasViewRight)
            {
                ToastService.ShowError("You do not have permission to access Ledger Group.");
                Nav.NavigateTo("/home");
                return;
            }
            
            await Task.WhenAll(LoadGroups(), LoadTypes());
            StateHasChanged();
        }
    }

    private async Task LoadTypes()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getledgertype");
            
            try
            {
                var direct = System.Text.Json.JsonSerializer.Deserialize<List<ledger_type_master>>(response, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                LedgerTypeList = (direct ?? new List<ledger_type_master>()).Where(x => !x.deleted).ToList();
            }
            catch
            {
                var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<ledger_type_master>>>(response, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                LedgerTypeList = (wrapped?.data ?? new List<ledger_type_master>()).Where(x => !x.deleted).ToList();
            }
        }
        catch { }
    }

    private async Task LoadGroups()
    {
        IsLoading = true;
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getledgergroup");
            
            try
            {
                var direct = System.Text.Json.JsonSerializer.Deserialize<List<ledger_group_master>>(response, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                LedgerGroupList = (direct ?? new List<ledger_group_master>()).Where(x => !x.deleted).ToList();
            }
            catch
            {
                var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<ledger_group_master>>>(response, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                LedgerGroupList = (wrapped?.data ?? new List<ledger_group_master>()).Where(x => !x.deleted).ToList();
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error loading groups: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("InventoryApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenantCode);
        return client;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        CurrentPage = 1;
    }

    private void AddNewGroup()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add groups.");
            return;
        }
        CurrentItem = new ledger_group_master 
        { 
            tenantcode = DefaultTenantCode, 
            deleted = false, 
            isactive = true,
            createddate = DateTime.Now
        };
        IsEdit = false;
        ShowModal = true;
    }

    private void EditGroup(ledger_group_master group)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit groups.");
            return;
        }
        CurrentItem = new ledger_group_master 
        { 
            ledgergroupcode = group.ledgergroupcode,
            ledgergroupname = group.ledgergroupname,
            shortname = group.shortname,
            description = group.description,
            ledgertypecode = group.ledgertypecode,
            isactive = group.isactive,
            tenantcode = group.tenantcode ?? DefaultTenantCode,
            deleted = group.deleted,
            createddate = group.createddate
        };
        IsEdit = true;
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
        IsSaving = false;
    }

    private async Task Save()
    {
        if (IsEdit && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit groups.");
            return;
        }
        if (!IsEdit && !hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add groups.");
            return;
        }
        if (string.IsNullOrWhiteSpace(CurrentItem.ledgergroupname))
        {
            NotificationService.ShowNotification("Name is required", NotificationType.Warning);
            return;
        }
        if (CurrentItem.ledgertypecode <= 0)
        {
            NotificationService.ShowNotification("Nature Type is required", NotificationType.Warning);
            return;
        }

        IsSaving = true;
        try
        {
            var client = CreateClient();
            CurrentItem.tenantcode = DefaultTenantCode;
            CurrentItem.description ??= "";
            CurrentItem.shortname ??= "";

            HttpResponseMessage response;
            if (IsEdit)
            {
                response = await client.PostAsJsonAsync("ItemMaster/updateledgergroup", CurrentItem);
            }
            else
            {
                var payloadJson = System.Text.Json.JsonSerializer.Serialize(CurrentItem, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
                Console.WriteLine("--- Add Ledger Group Payload (JSON) ---");
                Console.WriteLine(payloadJson);
                Console.WriteLine("---------------------------------------");
                response = await client.PostAsJsonAsync("ItemMaster/insertledgergroup", CurrentItem);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification(IsEdit ? "Group updated successfully" : "Group added successfully", NotificationType.Success);
                ShowModal = false;
                await LoadGroups();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                NotificationService.ShowNotification($"Save failed: {err}", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error saving group: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(ledger_group_master group)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete groups.");
            return;
        }
        PendingDelete = group;
        ShowDeletePopup = true;
    }

    private async Task DeleteConfirmed()
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete groups.");
            return;
        }
        if (PendingDelete == null) return;

        IsDeleteProcessing = true;
        try
        {
            var client = CreateClient();
            var code = PendingDelete.ledgergroupcode;

            var attempts = new Func<Task<HttpResponseMessage>>[]
            {
                () => client.DeleteAsync($"ItemMaster/deleteledgergroup?ledgergroupcode={code}"),
                () => client.DeleteAsync($"ItemMaster/deleteledgergroup?ledgercode={code}"),
                () => client.GetAsync($"ItemMaster/deleteledgergroup?ledgergroupcode={code}"),
                () => client.GetAsync($"ItemMaster/deleteledgergroup?ledgercode={code}")
            };

            bool success = false;
            foreach (var attempt in attempts)
            {
                try {
                    var response = await attempt();
                    if (response.IsSuccessStatusCode) {
                        success = true;
                        break;
                    }
                } catch {}
            }

            if (success)
            {
                NotificationService.ShowNotification("Group deleted successfully", NotificationType.Success);
                ShowDeletePopup = false;
                await LoadGroups();
            }
            else
            {
                NotificationService.ShowNotification("Delete failed", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsDeleteProcessing = false;
            PendingDelete = null;
        }
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }
