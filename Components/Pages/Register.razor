                                        </button>
                                    </div>
                                }
                            </div>
                            <div class="form-group">
                                <label class="form-label">Alternate Mobile <span class="optional">(Optional)</span></label>
                                <InputText @bind-Value="RegData.alternate_mobile" type="tel" class="form-control" placeholder="Mobile number" />
                            </div>

                            <div class="form-group full-width">
                                <label class="form-label lbl-req">Address Line 1</label>
                                <InputText @bind-Value="RegData.address_line1"
