    // --- Email OTP Verification State & Logic ---
    private bool isEmailOtpSent = false;
    private bool isEmailOtpVerified = false;
    private bool isSendingEmailOtp = false;
    private bool isVerifyingEmailOtp = false;
    private string emailOtpCode = "";
    private string emailOtpError = "";
    private string emailOtpSuccessMessage = "";
    private int emailOtpCountdown = 0;
    private System.Threading.Timer? otpTimer;

    private async Task SendEmailOtp()
    {
        emailOtpError = "";
        emailOtpSuccessMessage = "";
        if (string.IsNullOrWhiteSpace(RegData.contact_email) || !RegData.contact_email.Contains("@"))
        {
            emailOtpError = "Please enter a valid email address first.";
            return;
        }

        try
        {
            isSendingEmailOtp = true;
            StateHasChanged();

            var emailParam = Uri.EscapeDataString(RegData.contact_email.Trim());
            var nameParam = Uri.EscapeDataString(RegData.tenant_name ?? "Partner");

            var response = await Http.PostAsync($"Tenant/send-email-otp?email={emailParam}&tenantName={nameParam}", null);
            var json = await response.Content.ReadAsStringAsync();
            
            if (response.IsSuccessStatusCode)
            {
                isEmailOtpSent = true;
                emailOtpSuccessMessage = $"Verification code sent to {RegData.contact_email}. Please check your inbox.";
                Toast.Success("Verification code sent to your email!");
                StartOtpCountdown();
            }
            else
            {
                try
                {
                    var obj = Newtonsoft.Json.Linq.JObject.Parse(json);
                    emailOtpError = obj["message"]?.ToString() ?? "Failed to send email OTP. Please check email address.";
                }
                catch
                {
                    emailOtpError = "Failed to send email OTP. Please check your email.";
                }
                Toast.Error(emailOtpError);
            }
        }
        catch (Exception ex)
        {
            emailOtpError = $"Error: {ex.Message}";
            Toast.Error(emailOtpError);
        }
        finally
        {
            isSendingEmailOtp = false;
            StateHasChanged();
        }
    }

    private void StartOtpCountdown()
    {
        emailOtpCountdown = 60;
        otpTimer?.Dispose();
        otpTimer = new System.Threading.Timer(_ =>
        {
            if (emailOtpCountdown > 0)
            {
                emailOtpCountdown--;
                InvokeAsync(StateHasChanged);
            }
            else
            {
                otpTimer?.Dispose();
            }
        }, null, 1000, 1000);
    }

    private async Task VerifyEmailOtp()
    {
        emailOtpError = "";
        if (string.IsNullOrWhiteSpace(emailOtpCode) || emailOtpCode.Trim().Length < 6)
        {
            emailOtpError = "Please enter the 6-digit verification code.";
            return;
        }

        try
        {
            isVerifyingEmailOtp = true;
            StateHasChanged();

            var emailParam = Uri.EscapeDataString(RegData.contact_email.Trim());
            var otpParam = Uri.EscapeDataString(emailOtpCode.Trim());

            var response = await Http.PostAsync($"Tenant/verify-email-otp?email={emailParam}&otp={otpParam}", null);
            var json = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                isEmailOtpVerified = true;
                isEmailOtpSent = false;
                emailOtpSuccessMessage = "Email address successfully confirmed! ✓";
                Toast.Success("Email verified successfully! ✓");
            }
            else
            {
                try
                {
                    var obj = Newtonsoft.Json.Linq.JObject.Parse(json);
                    emailOtpError = obj["message"]?.ToString() ?? "Invalid verification code. Please check and try again.";
                }
                catch
                {
                    emailOtpError = "Invalid verification code.";
                }
                Toast.Error(emailOtpError);
            }
        }
        catch (Exception ex)
        {
            emailOtpError = $"Error: {ex.Message}";
            Toast.Error(emailOtpError);
        }
        finally
        {
            isVerifyingEmailOtp = false;
            StateHasChanged();
        }
    }

    private void ResetEmailVerification()
    {
        isEmailOtpVerified = false;
        isEmailOtpSent = false;
        emailOtpCode = "";
        emailOtpError = "";
        emailOtpSuccessMessage = "";
        emailOtpCountdown = 0;
        otpTimer?.Dispose();
    }

