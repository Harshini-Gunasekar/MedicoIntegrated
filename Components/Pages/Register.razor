@page "/register"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer
@using System.Net.Http.Json
@using SharedComponents.Rcl.Models
@using System.Text.RegularExpressions
@using SharedComponents.Rcl.Components.Layout
@using SharedComponents.Rcl.Services
@layout SharedComponents.Rcl.Components.Layout.EmptyLayout
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Booking.Services.ToastService ToastService

<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet" />

<style>
    body {
        background: @(IsDarkMode ? "radial-gradient(circle at 50% 50%, #151030 0%, #07070d 70%, #030305 100%)" : "#f1f5f9") !important;
        background-attachment: fixed !important;
        background-color: @(IsDarkMode ? "#07070b" : "#f1f5f9") !important;
        margin: 0 !important;
        padding: 0 !important;
    }
</style>

@if (!RegSuccess)
{
<section class="register-container @(IsDarkMode ? "" : "light-theme")">
    <div class="register-card">
        <div class="card-header">
            <div class="header-main-row" style="display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
                <div>
                    <h2 class="page-title">Company Registration</h2>
                    <p class="page-subtitle" style="margin-bottom: 0;">Complete the form below to set up your Company profile.</p>
                </div>
                
                <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                    <!-- Manage Profile Button -->
                    <button type="button" class="theme-toggle-btn" @onclick="GoToEditProfile" title="Manage Existing Profile">
                        <span class="material-icons-outlined">account_circle</span>
                        <span>Manage Profile</span>
                    </button>

                    <!-- Premium Theme Selector Button -->
                    <button type="button" class="theme-toggle-btn" @onclick="ToggleTheme" title="Toggle Light/Dark Theme">
                        <span class="material-icons-outlined">@(IsDarkMode ? "light_mode" : "dark_mode")</span>
                        <span>@(IsDarkMode ? "Light Mode" : "Dark Mode")</span>
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(AlertMessage))
            {
                <div class="alert @(IsError ? "alert-error" : "alert-success")">
                    @AlertMessage
                </div>
            }
        </div>

        <EditForm EditContext="editContext">
            <DataAnnotationsValidator />

            <div class="card-body">
                <div class="registration-grid">
                    
                    <!-- Left Column: General Information -->
                    <div class="registration-column">
                        <div class="section-title">
                            <span class="material-icons-outlined">business</span>
                            <h3>1. General Information</h3>
                        </div>

                        <div class="form-grid">
                            <div class="form-group full-width">
                                <label class="form-label lbl-req">Company Name</label>
                                <InputText @bind-Value="RegData.tenant_name"
                                           class="@($"form-control {(IsFieldInvalid("tenant_name") ? "invalid" : "")}")"
                                           placeholder="e.g. Metro Diagnostic Center" />
                                <ValidationMessage For="@(() => RegData.tenant_name)" />
                            </div>
                            <div class="form-group full-width">
                                <label class="form-label lbl-req">Legal Name</label>
                                <InputText @bind-Value="RegData.legal_name"
                                           class="@($"form-control {(IsFieldInvalid("legal_name") ? "invalid" : "")}")"
                                           placeholder="As per registration" />
                                <ValidationMessage For="@(() => RegData.legal_name)" />
                            </div>
                            <div class="form-group full-width">
                                 <label class="form-label lbl-req">Company Type</label>
                                <div class="form-select-wrapper">
                                    <InputSelect @bind-Value="RegData.business_type"
                                                 class="@($"form-control {(IsFieldInvalid("business_type") ? "invalid" : "")}")">
                                        <option value="">Select Company Type</option>
                                        <option value="Hospital / Medical Center">Hospital / Medical Center</option>
                                        <option value="Outpatient Clinic">Outpatient Clinic</option>
                                        <option value="Diagnostic Laboratory">Diagnostic Laboratory</option>
                                        <option value="Medical Imaging Center">Medical Imaging Center</option>
                                        <option value="Diagnostic Center">Diagnostic Center</option>
                                
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="form-group full-width">
                                <label class="form-label lbl-req">Product Subscriptions <span class="optional">(Select multiple if needed)</span></label>
                                <div class="product-checkbox-grid">
                                    @if (Products == null || Products.Count == 0)
                                    {
                                        <div class="product-error-alert">
                                            <span>⚠️ Failed to load products. Please check connection.</span>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var prod in Products)
                                        {
                                            <div class="product-checkbox-card @(SelectedProductIds.Contains(prod.ProductId) ? "active" : "")" @onclick="() => ToggleProductSelection(prod.ProductId)">
                                                <div class="checkbox-custom">
                                                    @if (SelectedProductIds.Contains(prod.ProductId))
                                                    {
                                                        <span class="material-icons-round">check_box</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="material-icons-round">check_box_outline_blank</span>
                                                    }
                                                </div>
                                                <div class="product-info">
                                                    <span class="product-name">@prod.ProductName</span>
                                                    <span class="product-code">@prod.ProductId</span>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                                <ValidationMessage For="@(() => RegData.selected_product_id)" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">Registration Number <span class="optional">(Optional)</span></label>
                                <InputText @bind-Value="RegData.register_num" class="form-control" placeholder="Licensing ID" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">GST Number <span class="optional">(Optional)</span></label>
                                <InputText @bind-Value="RegData.gst_number" class="form-control" placeholder="GSTIN" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">PAN Number <span class="optional">(Optional)</span></label>
                                <InputText @bind-Value="RegData.pan_number" class="form-control" placeholder="PAN" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Website <span class="optional">(Optional)</span></label>
                                <InputText @bind-Value="RegData.website" class="form-control" placeholder="www.example.com" />
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Contact & Location Information -->
                    <div class="registration-column">
                        <div class="section-title">
                            <span class="material-icons-outlined">place</span>
                            <h3>2. Contact & Location Info</h3>
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label lbl-req">Contact Person Name</label>
                                <InputText @bind-Value="RegData.contact_person"
                                           class="@($"form-control {(IsFieldInvalid("contact_person") ? "invalid" : "")}")"
                                           placeholder="Full name" />
                                <ValidationMessage For="@(() => RegData.contact_person)" />
                            </div>
                            <div class="form-group">
                                <label class="form-label lbl-req">Email Address</label>
                                <InputText @bind-Value="RegData.contact_email"
                                           type="email"
                                           class="@($"form-control {(IsFieldInvalid("contact_email") ? "invalid" : "")}")"
                                           placeholder="name@organization.com" />
                                <ValidationMessage For="@(() => RegData.contact_email)" />
                            </div>
                            <div class="form-group">
                                <label class="form-label lbl-req">Contact Number</label>
                                <InputText @bind-Value="RegData.contact_number"
                                           type="tel"
                                           class="@($"form-control {(IsFieldInvalid("contact_number") ? "invalid" : "")}")"
                                           placeholder="10-digit mobile number"
                                           maxlength="10" />
                                <ValidationMessage For="@(() => RegData.contact_number)" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Alternate Mobile <span class="optional">(Optional)</span></label>
                                <InputText @bind-Value="RegData.alternate_mobile" type="tel" class="form-control" placeholder="Mobile number" />
                            </div>

                            <div class="form-group full-width">
                                <label class="form-label lbl-req">Address Line 1</label>
                                <InputText @bind-Value="RegData.address_line1"
                                           class="@($"form-control {(IsFieldInvalid("address_line1") ? "invalid" : "")}")"
                                           placeholder="Street address, building, suite" />
                                <ValidationMessage For="@(() => RegData.address_line1)" />
                            </div>
                            <div class="form-group full-width">
                                <label class="form-label">Address Line 2 <span class="optional">(Optional)</span></label>
                                <InputText @bind-Value="RegData.address_line2" class="form-control" placeholder="Locality, area, landmark" />
                            </div>

                            <div class="form-group">
                                <label class="form-label lbl-req">City</label>
                                <InputText @bind-Value="RegData.city"
                                           class="@($"form-control {(IsFieldInvalid("city") ? "invalid" : "")}")"
                                           placeholder="City" />
                                <ValidationMessage For="@(() => RegData.city)" />
                            </div>
                            <div class="form-group">
                                <label class="form-label lbl-req">State</label>
                                <InputText @bind-Value="RegData.state"
                                           class="@($"form-control {(IsFieldInvalid("state") ? "invalid" : "")}")"
                                           placeholder="State" />
                                <ValidationMessage For="@(() => RegData.state)" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Country</label>
                                <InputText @bind-Value="RegData.country" class="form-control" placeholder="Country" />
                            </div>
                            <div class="form-group">
                                <label class="form-label lbl-req">Pincode</label>
                                <InputText @bind-Value="RegData.pincode"
                                           class="@($"form-control {(IsFieldInvalid("pincode") ? "invalid" : "")}")"
                                           placeholder="Pincode" />
                                <ValidationMessage For="@(() => RegData.pincode)" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">Timezone</label>
                                <div class="form-select-wrapper">
                                    <InputSelect @bind-Value="RegData.time_zone" class="form-control">
                                        <option value="">Select Timezone</option>
                                        @foreach (var tz in TimezoneList)
                                        {
                                            <option value="@tz">@tz</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Currency</label>
                                <div class="form-select-wrapper">
                                    <InputSelect @bind-Value="RegData.currency" class="form-control">
                                        <option value="INR">INR (₹)</option>
                                        <option value="USD">USD ($)</option>
                                        <option value="EUR">EUR (€)</option>
                                        <option value="GBP">GBP (£)</option>
                                    </InputSelect>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer">
                <button type="button" class="btn btn-primary" @onclick="OpenPasswordModal">
                    <span>Proceed to Password Setup</span>
                    <span class="material-icons-outlined">vpn_key</span>
                </button>
            </div>

            <!-- Frosty Glass Password Creation Modal Popup -->
            @if (ShowPasswordModal)
            {
                <div class="modal-overlay">
                    <div class="modal-card">
                        <div class="modal-header">
                            <h3 class="modal-title">Create Password</h3>
                            <p class="modal-subtitle">Configure a strong security password for your account.</p>
                        </div>
                        <div class="modal-body">
                            @if (!string.IsNullOrEmpty(AlertMessage))
                            {
                                <div class="alert @(IsError ? "alert-error" : "alert-success")" style="margin-top: 0; margin-bottom: 0.5rem; width: 100%;">
                                    @AlertMessage
                                </div>
                            }
                            <div class="form-group password-group full-width">
                                <label class="form-label lbl-req">New Password</label>
                                <div class="input-icon-wrapper">
                                    <span class="material-icons-outlined input-icon-left">lock</span>
                                    <InputText @bind-Value="RegData.password_hash"
                                               @oninput="UpdatePassword"
                                               type="@(ShowPassword ? "text" : "password")"
                                               class="@($"form-control {(IsFieldInvalid("password_hash") ? "invalid" : "")}")"
                                               placeholder="••••••••" />
                                    <button type="button" class="input-icon-right" @onclick="() => ShowPassword = !ShowPassword">
                                        <span class="material-icons-outlined">@(ShowPassword ? "visibility_off" : "visibility")</span>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => RegData.password_hash)" />
                            </div>

                            <div class="form-group password-group full-width">
                                <label class="form-label lbl-req">Confirm Password</label>
                                <div class="input-icon-wrapper">
                                    <span class="material-icons-outlined input-icon-left">lock</span>
                                    <InputText @bind-Value="RegData.confirm_password"
                                               type="@(ShowConfirmPassword ? "text" : "password")"
                                               class="@($"form-control {(IsFieldInvalid("confirm_password") ? "invalid" : "")}")"
                                               placeholder="••••••••" />
                                    <button type="button" class="input-icon-right" @onclick="() => ShowConfirmPassword = !ShowConfirmPassword">
                                        <span class="material-icons-outlined">@(ShowConfirmPassword ? "visibility_off" : "visibility")</span>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => RegData.confirm_password)" />
                            </div>

                            <div class="security-reqs">
                                <h4>Security Requirements</h4>
                                <div class="req-grid">
                                    <div class="req-item @(HasMinLength ? "valid" : "")">
                                        <div class="req-icon"><span class="material-icons-round">check</span></div>
                                        <span>At least 8 characters</span>
                                    </div>
                                    <div class="req-item @(HasUpperLower ? "valid" : "")">
                                        <div class="req-icon"><span class="material-icons-round">check</span></div>
                                        <span>Uppercase &amp; Lowercase</span>
                                    </div>
                                    <div class="req-item @(HasNumber ? "valid" : "")">
                                        <div class="req-icon"><span class="material-icons-round">check</span></div>
                                        <span>At least one number</span>
                                    </div>
                                    <div class="req-item @(HasSpecialChar ? "valid" : "")">
                                        <div class="req-icon"><span class="material-icons-round">check</span></div>
                                        <span>One special character</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-text" @onclick="ClosePasswordModal">Cancel</button>
                            <button type="button" class="btn btn-primary" disabled="@IsLoading" @onclick="SubmitRegistration">
                                @(IsLoading ? "Registering..." : "Set Password & Complete")
                                @if (!IsLoading) { <span class="material-icons-outlined">done</span> }
                            </button>
                        </div>
                    </div>
                </div>
            }
        </EditForm>
    </div>

    <div class="bg-decorator">
        <span class="material-icons-round text-8xl">layers</span>
    </div>
</section>
}
else
{
    <div class="register-success-wrapper">
        <img src="https://cdni.iconscout.com/illustration/premium/thumb/successful-registration-4386001-3640243.png" alt="Registration Successful" class="success-illustration" />
        <h2 class="success-title">Registration Successful!</h2>
        <p class="success-subtitle">Redirecting to the login page...</p>
    </div>
}

