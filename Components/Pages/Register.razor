                            <div class="form-group full-width">
                                <label class="form-label">Address Line 2 <span class="optional">(Optional)</span></label>
                                <InputText @bind-Value="RegData.address_line2" class="form-control" placeholder="Locality, area, landmark" />
                            </div>

                            <div class="form-group">
                                <label class="form-label lbl-req">City</label>
                                <InputText @bind-Value="RegData.city"
                                           class="@($"form-control {(IsFieldInvalid("city") ? "invalid" : "")}")"
                                           placeholder="City" />
                                <ValidationMessage For="@(() => RegData.city)" />
                            </div>
                            <div class="form-group">
                                <label class="form-label lbl-req">State</label>
                                <InputText @bind-Value="RegData.state"
                                           class="@($"form-control {(IsFieldInvalid("state") ? "invalid" : "")}")"
                                           placeholder="State" />
                                <ValidationMessage For="@(() => RegData.state)" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Country</label>
                                <InputText @bind-Value="RegData.country" class="form-control" placeholder="Country" />
                            </div>
                            <div class="form-group">
                                <label class="form-label lbl-req">Pincode</label>
                                <InputText @bind-Value="RegData.pincode"
                                           class="@($"form-control {(IsFieldInvalid("pincode") ? "invalid" : "")}")"
                                           placeholder="Pincode" />
