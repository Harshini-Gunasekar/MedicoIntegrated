    protected override async Task OnInitializedAsync()
    {
        Http = HttpClientFactory.CreateClient("RidoUrl");
        Toast = new ToastWrapper(ToastService);

        editContext = new EditContext(RegData);
        messageStore = new ValidationMessageStore(editContext);
        try { RegData.time_zone = "Asia/Kolkata"; } catch { }

        try
        {
            var result = await Http.GetFromJsonAsync<List<ProductModel>>("Tenant/products");
            if (result != null && result.Count > 0)
            {
                Products = result;
            }
        }
        catch (Exception)
        {
            // Endpoint not available, fallback list will be loaded below
        }

        if (Products == null || Products.Count == 0)
        {
            Products = new List<ProductModel>
            {
                new ProductModel { ProductId = "CMS_APP", ProductName = "Case Management" },
                new ProductModel { ProductId = "LABCARE", ProductName = "LABCARE" },
                new ProductModel { ProductId = "LABCARE_APP", ProductName = "LABCARE APP" },
                new ProductModel { ProductId = "LIMES_APP", ProductName = "LIMES Diagnostics" },
                new ProductModel { ProductId = "RIDD_APP", ProductName = "Rido - Smart Rider System" }
            };
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Timezone defaults to Asia/Kolkata, no JS interop required
    }

    private bool IsLoading = false;
    private bool IsDarkMode = true; // Default theme is dark
    private string AlertMessage = "";
    private bool IsError = false;

    private void ToggleTheme()
    {
        IsDarkMode = !IsDarkMode;
    }

    private bool ShowPassword = false;
    private bool ShowConfirmPassword = false;

    // ── Password strength checkers ──
    private bool HasMinLength => !string.IsNullOrEmpty(RegData.password_hash) && RegData.password_hash.Length >= 8;
    private bool HasUpperLower => !string.IsNullOrEmpty(RegData.password_hash) && Regex.IsMatch(RegData.password_hash, "[a-z]") && Regex.IsMatch(RegData.password_hash, "[A-Z]");
    private bool HasNumber => !string.IsNullOrEmpty(RegData.password_hash) && Regex.IsMatch(RegData.password_hash, "[0-9]");
    private bool HasSpecialChar => !string.IsNullOrEmpty(RegData.password_hash) && Regex.IsMatch(RegData.password_hash, @"[\W_]");

    // ── Helper: check if a field has a validation error ──
    private bool IsFieldInvalid(string fieldName)
    {
        if (!_formSubmitAttempted) return false;
        var field = editContext.Field(fieldName);
        return editContext.GetValidationMessages(field).Any();
    }

    // ── Form field names for details validation ──
    private static readonly string[] DetailsFields = {
        "tenant_name", "legal_name", "business_type", "selected_product_id", "contact_person", 
        "contact_email", "contact_number", "address_line1", "city", "state", "pincode"
    };

    private static readonly string[] PasswordFields = {
        "password_hash", "confirm_password"
    };

    private bool ValidateStep(string[] fieldNames)
    {
        _formSubmitAttempted = true;
        bool isValid = true;
        foreach (var name in fieldNames)
        {
            var field = editContext.Field(name);
            editContext.NotifyFieldChanged(field);
            if (editContext.GetValidationMessages(field).Any())
                isValid = false;
        }
        StateHasChanged();
        return isValid;
    }

    private bool IsDetailsFormEmpty()
    {
        return string.IsNullOrWhiteSpace(RegData.tenant_name)
            && string.IsNullOrWhiteSpace(RegData.legal_name)
            && string.IsNullOrWhiteSpace(RegData.business_type)
            && string.IsNullOrWhiteSpace(RegData.selected_product_id)
            && string.IsNullOrWhiteSpace(RegData.contact_person)
            && string.IsNullOrWhiteSpace(RegData.contact_email)
            && string.IsNullOrWhiteSpace(RegData.contact_number)
            && string.IsNullOrWhiteSpace(RegData.address_line1)
            && string.IsNullOrWhiteSpace(RegData.city)
            && string.IsNullOrWhiteSpace(RegData.state)
            && string.IsNullOrWhiteSpace(RegData.pincode);
    }

    private void OpenPasswordModal()
    {
        if (IsDetailsFormEmpty())
        {
            Toast.Error("All required fields are empty. Please fill in the details form first.");
            _formSubmitAttempted = true;
            ValidateStep(DetailsFields);
            return;
        }

        if (SelectedProductIds.Count == 0)
        {
            _showProductValidationError = true;
            Toast.Warning("Please select at least one product subscription.");
            return;
        }
        else
        {
            _showProductValidationError = false;
        }

        if (!ValidateStep(DetailsFields))
        {
            Toast.Warning("Please correct all form errors before continuing.");
            return;
        }

        // Form details are completely valid, show modal
        ShowPasswordModal = true;
        AlertMessage = "";
        StateHasChanged();
    }

    private void ClosePasswordModal()
    {
        ShowPasswordModal = false;
        StateHasChanged();
    }

    private void UpdatePassword(ChangeEventArgs e)
    {
        RegData.password_hash = e.Value?.ToString() ?? "";
    }

    private void GenerateTenantCode()
    {
        RegData.tenant_code = "AUTO";
    }

    private async Task SubmitRegistration()
    {
        // 1. Re-validate form details
        if (!ValidateStep(DetailsFields))
        {
            ClosePasswordModal();
            Toast.Error("Details form has validation errors. Please review.");
            return;
        }

        // 2. Validate password fields
        if (!ValidateStep(PasswordFields))
        {
            Toast.Warning("Please specify and confirm your password.");
            return;
        }

        // 3. Password strength check
        if (!HasMinLength || !HasUpperLower || !HasNumber || !HasSpecialChar)
        {
            Toast.Error("Password does not meet the security requirements.");
            return;
        }

        if (string.IsNullOrEmpty(RegData.tenant_code))
            GenerateTenantCode();

        IsLoading = true;
        AlertMessage = "";
        IsError = false;

        try
        {
            var payload = new {
                tenant_code = RegData.tenant_code ?? "",
                tenant_name = RegData.tenant_name ?? "",
                contact_email = RegData.contact_email ?? "",
                contact_number = RegData.contact_number ?? "",
                legal_name = RegData.legal_name ?? "",
                contact_person = RegData.contact_person ?? "",
                alternate_mobile = RegData.alternate_mobile ?? "",
                website = RegData.website ?? "",
                gst_number = RegData.gst_number ?? "",
                pan_number = RegData.pan_number ?? "",
                address_line1 = RegData.address_line1 ?? "",
                address_line2 = RegData.address_line2 ?? "",
                city = RegData.city ?? "",
                state = RegData.state ?? "",
                country = RegData.country ?? "",
                pincode = RegData.pincode ?? "",
                time_zone = RegData.time_zone ?? "",
                currency = RegData.currency ?? "",
                business_type = RegData.business_type ?? "",
                register_num = RegData.register_num ?? "",
                password_hash = RegData.password_hash ?? "",
                selected_product_id = RegData.selected_product_id ?? ""
            };

            var response = await Http.PostAsJsonAsync("Tenant/insert", payload);
            var resultStr = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                if (resultStr.Contains("\"success\":false") || resultStr.Contains("\"status\":false"))
                {
                    Toast.Error("Registration failed: " + resultStr);
                    ShowMessage("Registration failed: " + resultStr, true);
                }
                else
                {
                    ShowPasswordModal = false;
                    RegSuccess = true;
                    Toast.Success("Account registered successfully! Redirecting to login...");
                    ShowMessage("Account registered successfully!", false);
                    StateHasChanged();
                    await Task.Delay(2500);
                    NavigationManager.NavigateTo("/login", forceLoad: true);
                }
            }
            else
            {
                var errorMsg = $"Registration failed ({response.StatusCode}).";
                if (!string.IsNullOrEmpty(resultStr))
                {
                    if (resultStr.Contains("Email already exists", StringComparison.OrdinalIgnoreCase))
                        errorMsg = "Email address is already registered.";
                    else if (resultStr.Contains("Phone already exists", StringComparison.OrdinalIgnoreCase) || resultStr.Contains("Number already exists", StringComparison.OrdinalIgnoreCase))
                        errorMsg = "Contact number is already registered.";
                    else
                        errorMsg += $" {resultStr}";
                }
                Toast.Error(errorMsg);
                ShowMessage(errorMsg, true);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Network error: {ex.Message}");
            ShowMessage($"Network error: {ex.Message}", true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ShowMessage(string msg, bool error)
    {
        AlertMessage = msg;
        IsError = error;
    }

    public class ToastWrapper
    {
        private readonly Booking.Services.ToastService _service;
        public ToastWrapper(Booking.Services.ToastService service) => _service = service;
        public void Success(string msg) => _service.ShowSuccess(msg);
        public void Error(string msg) => _service.ShowError(msg);
        public void Warning(string msg) => _service.ShowError(msg);
    }

    public class ProductModel
    {
        public string ProductId { get; set; } = string.Empty;
        public string ProductName { get; set; } = string.Empty;
    }
