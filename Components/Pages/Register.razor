    protected override async Task OnInitializedAsync()
    {
        var baseAddr = !string.IsNullOrWhiteSpace(_appSettings?.UniIdentityBaseUrl)
            ? _appSettings.UniIdentityBaseUrl
            : (!string.IsNullOrWhiteSpace(_appSettings?.BaseUrl)
                ? _appSettings.BaseUrl
                : (Configuration?["UniIdentityBaseUrl"] ?? Configuration?["AppSettings:BaseUrl"] ?? "http://localhost:5099/"));
        if (!baseAddr.EndsWith("/")) baseAddr += "/";

        try
        {
            var factory = ServiceProvider.GetService<IHttpClientFactory>();
            if (factory != null)
            {
                try { Http = factory.CreateClient("RidoUrl"); }
                catch { Http = factory.CreateClient(); }
            }
        }
        catch { }

        if (Http == null)
        {
            Http = new HttpClient { BaseAddress = new Uri(baseAddr) };
        }
        else if (Http.BaseAddress == null || !Http.BaseAddress.ToString().Contains("uniidentity", StringComparison.OrdinalIgnoreCase))
        {
            Http = new HttpClient { BaseAddress = new Uri(baseAddr) };
        }

        Toast = new ToastWrapper(ToastService);

        editContext = new EditContext(RegData);
        messageStore = new ValidationMessageStore(editContext);
        try { RegData.time_zone = "Asia/Kolkata"; } catch { }

        // Strictly show only these 3 products: LABCARE_APP, MEDICO_APP, RIDO_APP
        Products = new List<ProductModel>
        {
            new ProductModel { 
                ProductId = "LABCARE_APP", 
                ProductName = "LabCare Diagnostic Suite", 
                IconCss = "bi-clipboard2-pulse",
                Description = "Complete Pathology & Radiology Laboratory Information System with barcode sample tracking, analyzer interfacing, and smart WhatsApp reports."
            },
            new ProductModel { 
                ProductId = "MEDICO_APP", 
                ProductName = "Medico Clinical ERP", 
                IconCss = "bi-hospital",
                Description = "Integrated Hospital & Clinic ERP featuring OP/IP admission, electronic health records (EHR), OT scheduling, and Pharmacy billing."
            },
            new ProductModel { 
                ProductId = "RIDO_APP", 
                ProductName = "Rido Smart Rider", 
                IconCss = "bi-bicycle",
                Description = "Field Fleet & Sample Collection logistics with dynamic rider task allocation, live GPS routing, and instant turn-around times."
            }
        };

        try
        {
            var result = await Http.GetFromJsonAsync<List<ProductModel>>("Tenant/products");
            if (result != null && result.Count > 0)
            {
                var allowed = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "RIDO_APP", "MEDICO_APP", "LABCARE_APP" };
                var filtered = result.Where(p => allowed.Contains(p.ProductId)).ToList();
                if (filtered.Count > 0)
                {
                    foreach (var p in filtered)
                    {
                        if (p.ProductId.Contains("MEDICO", StringComparison.OrdinalIgnoreCase))
                        {
                            p.ProductName = "Medico Clinical ERP";
                            p.IconCss = "bi-hospital";
                            p.Description = "Integrated Hospital & Clinic ERP featuring OP/IP admission, EHR, and Pharmacy billing.";
                        }
                        else if (p.ProductId.Contains("LABCARE", StringComparison.OrdinalIgnoreCase))
                        {
                            p.ProductName = "LabCare Diagnostic Suite";
                            p.IconCss = "bi-clipboard2-pulse";
                            p.Description = "Complete Pathology & Radiology LIS with barcode sample tracking and smart WhatsApp reports.";
                        }
                        else if (p.ProductId.Contains("RIDO", StringComparison.OrdinalIgnoreCase))
                        {
                            p.ProductName = "Rido Smart Rider";
                            p.IconCss = "bi-bicycle";
                            p.Description = "Field Fleet & Sample Collection logistics with live GPS routing and instant turn-around times.";
                        }
                    }
                    Products = filtered;
                }
            }
        }
        catch (Exception)
        {
            // Standard 3 products initialized above
        }
    }

    private async Task CheckMobileAssociation()
    {
        MobileExistingError = "";
        if (string.IsNullOrWhiteSpace(RegData.contact_number) || RegData.contact_number.Trim().Length < 10)
            return;

        try
        {
            _checkingMobile = true;
            var num = RegData.contact_number.Trim();
            var response = await Http.GetAsync($"Tenant/check-association?mobile={Uri.EscapeDataString(num)}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var obj = Newtonsoft.Json.Linq.JObject.Parse(json);
                bool exists = (bool?)obj["mobileExists"] ?? false;
                if (exists)
                {
                    var prods = obj["mobileProducts"]?.ToObject<List<string>>() ?? new List<string>();
                    string prodStr = prods.Count > 0 ? string.Join(", ", prods) : "another product/account";
                    MobileExistingError = $"This mobile number is already associated with {prodStr}. If you need, you can edit your profile.";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Check Mobile Association Error] {ex.Message}");
        }
        finally
        {
            _checkingMobile = false;
            StateHasChanged();
        }
    }

    private async Task CheckEmailAssociation()
    {
        EmailExistingError = "";
        if (string.IsNullOrWhiteSpace(RegData.contact_email) || !RegData.contact_email.Contains("@"))
            return;

        try
        {
            _checkingEmail = true;
            var em = RegData.contact_email.Trim();
            var response = await Http.GetAsync($"Tenant/check-association?email={Uri.EscapeDataString(em)}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var obj = Newtonsoft.Json.Linq.JObject.Parse(json);
                bool exists = (bool?)obj["emailExists"] ?? false;
                if (exists)
