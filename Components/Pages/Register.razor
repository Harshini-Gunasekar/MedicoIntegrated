            </div>

            <div class="card-footer" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <button type="button" class="btn btn-text" @onclick="GoToLogin" style="display: flex; align-items: center; gap: 0.5rem; color: var(--text-muted, #64748b); text-decoration: none; background: transparent; border: none; cursor: pointer; font-size: 0.95rem;">
                    <span class="material-icons-outlined">arrow_back</span>
                    <span>Back to Sign In</span>
                </button>
                <button type="button" class="btn btn-primary" @onclick="OpenPasswordModal">
                    <span>Proceed to Password Setup</span>
                    <span class="material-icons-outlined">vpn_key</span>
                </button>
            </div>

            <!-- Frosty Glass Password Creation Modal Popup -->
            @if (ShowPasswordModal)
            {
                <div class="modal-overlay">
                    <div class="modal-card">
                        <div class="modal-header">
                            <h3 class="modal-title">Create Password</h3>
                            <p class="modal-subtitle">Configure a strong security password for your account.</p>
                        </div>
                        <div class="modal-body">
                            @if (!string.IsNullOrEmpty(AlertMessage))
                            {
                                <div class="alert @(IsError ? "alert-error" : "alert-success")" style="margin-top: 0; margin-bottom: 0.5rem; width: 100%;">
                                    @AlertMessage
                                </div>
                            }
                            <div class="form-group password-group full-width">
                                <label class="form-label lbl-req">New Password</label>
                                <div class="input-icon-wrapper">
                                    <span class="material-icons-outlined input-icon-left">lock</span>
                                    <InputText @bind-Value="RegData.password_hash"
                                               @oninput="UpdatePassword"
                                               type="@(ShowPassword ? "text" : "password")"
                                               class="@($"form-control {(IsFieldInvalid("password_hash") ? "invalid" : "")}")"
                                               placeholder="••••••••" />
                                    <button type="button" class="input-icon-right" @onclick="() => ShowPassword = !ShowPassword">
                                        <span class="material-icons-outlined">@(ShowPassword ? "visibility_off" : "visibility")</span>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => RegData.password_hash)" />
                            </div>

                            <div class="form-group password-group full-width">
                                <label class="form-label lbl-req">Confirm Password</label>
                                <div class="input-icon-wrapper">
                                    <span class="material-icons-outlined input-icon-left">lock</span>
                                    <InputText @bind-Value="RegData.confirm_password"
                                               type="@(ShowConfirmPassword ? "text" : "password")"
                                               class="@($"form-control {(IsFieldInvalid("confirm_password") ? "invalid" : "")}")"
                                               placeholder="••••••••" />
                                    <button type="button" class="input-icon-right" @onclick="() => ShowConfirmPassword = !ShowConfirmPassword">
                                        <span class="material-icons-outlined">@(ShowConfirmPassword ? "visibility_off" : "visibility")</span>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => RegData.confirm_password)" />
                            </div>

                            <div class="security-reqs">
                                <h4>Security Requirements</h4>
                                <div class="req-grid">
                                    <div class="req-item @(HasMinLength ? "valid" : "")">
                                        <div class="req-icon"><span class="material-icons-round">check</span></div>
                                        <span>At least 8 characters</span>
                                    </div>
                                    <div class="req-item @(HasUpperLower ? "valid" : "")">
                                        <div class="req-icon"><span class="material-icons-round">check</span></div>
                                        <span>Uppercase &amp; Lowercase</span>
                                    </div>
                                    <div class="req-item @(HasNumber ? "valid" : "")">
                                        <div class="req-icon"><span class="material-icons-round">check</span></div>
                                        <span>At least one number</span>
                                    </div>
                                    <div class="req-item @(HasSpecialChar ? "valid" : "")">
                                        <div class="req-icon"><span class="material-icons-round">check</span></div>
                                        <span>One special character</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-text" @onclick="ClosePasswordModal">Cancel</button>
                            <button type="button" class="btn btn-primary" disabled="@IsLoading" @onclick="SubmitRegistration">
                                @(IsLoading ? "Registering..." : "Set Password & Proceed to Payment")
                                @if (!IsLoading) { <span class="material-icons-outlined">payment</span> }
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Subscription Payment Modal Gate -->
            @if (ShowPaymentModal)
            {
                var pricing = CalculateRegPricing();
                <div class="modal-overlay">
                    <div class="modal-card" style="max-width: 520px;">
                        <div class="modal-header" style="background: linear-gradient(135deg, #10b981, #059669); color: #fff; padding: 20px 24px; border-radius: 12px 12px 0 0;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span class="material-icons-round" style="font-size: 28px;">verified_user</span>
                                <div>
                                    <h3 class="modal-title" style="color: #fff; margin: 0; font-size: 1.25rem;">Activate Subscription</h3>
                                    <p class="modal-subtitle" style="color: rgba(255,255,255,0.85); margin: 0; font-size: 0.8rem;">Facility Registered: <strong>@registeredTenantCode</strong>. Complete payment to activate.</p>
                                </div>
                            </div>
                        </div>
                        <div class="modal-body" style="padding: 24px;">
                            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; margin-bottom: 20px;">
                                <h4 style="font-size: 0.9rem; font-weight: 700; margin-bottom: 12px; color: #1e293b;">Selected Subscription Plans</h4>
                                @foreach (var item in pricing.items)
                                {
                                    <div style="display: flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 6px; color: #334155;">
                                        <span>@item.product_name:</span>
                                        <span style="font-weight: 600;">₹@item.total_amount.ToString("N2") <small style="color: #64748b;">(incl. GST)</small></span>
                                    </div>
                                }
                                <div style="border-top: 1.5px dashed #cbd5e1; margin-top: 12px; padding-top: 10px; display: flex; justify-content: space-between; font-size: 1.05rem; font-weight: 800; color: #047857;">
                                    <span>Total Payable:</span>
                                    <span>₹@pricing.totalAmount.ToString("N2")</span>
                                </div>
                            </div>

                            <div style="font-size: 0.82rem; color: #475569; line-height: 1.45; margin-bottom: 20px;">
                                <span class="material-icons-round" style="font-size: 16px; color: #10b981; vertical-align: middle;">check_circle</span>
                                Upon successful payment, your products will be activated immediately with full 30-day validity.
                            </div>

                            @if (!string.IsNullOrEmpty(AlertMessage))
                            {
                                <div class="alert @(IsError ? "alert-error" : "alert-success")" style="margin-bottom: 15px;">
                                    @AlertMessage
                                </div>
                            }

                            <div style="display: flex; gap: 12px; justify-content: flex-end; align-items: center;">
                                <button type="button" class="btn btn-text" @onclick="SkipOrClosePayment">Pay Later</button>
                                <button type="button" class="btn btn-primary" style="background: linear-gradient(135deg, #10b981, #059669); border: none; display: flex; align-items: center; gap: 8px;" disabled="@isPaymentProcessing" @onclick="LaunchRegistrationPayment">
                                    @(isPaymentProcessing ? "Processing..." : $"Pay ₹{pricing.totalAmount:N2} & Activate")
                                    @if (!isPaymentProcessing) { <span class="material-icons-outlined">lock</span> }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </EditForm>
    </div>

    <div class="bg-decorator">
        <span class="material-icons-round text-8xl">layers</span>
    </div>
</section>
}
else
{
    <div class="register-success-wrapper">
        <img src="https://cdni.iconscout.com/illustration/premium/thumb/successful-registration-4386001-3640243.png" alt="Registration Successful" class="success-illustration" />
        <h2 class="success-title">Registration Successful!</h2>
        <p class="success-subtitle">Redirecting to the login page...</p>
    </div>
}

