@code {
    private RegisterModel RegData = new RegisterModel();
    private EditContext editContext = default!;
    private ValidationMessageStore messageStore = default!;
    private bool RegSuccess = false;
    private bool _formSubmitAttempted = false;
    private bool ShowPasswordModal = false;

    private HttpClient Http = default!;
    private ToastWrapper Toast = default!;

    private HashSet<string> SelectedProductIds = new();
    private bool _showProductValidationError = false;
    private int RegExtraRiders = 0;
    private bool ShowPaymentModal = false;
    private string registeredTenantCode = "";
    private bool isPaymentProcessing = false;
    private DotNetObjectReference<Register>? dotNetHelper;

    private void UpdateRegRiders(int delta)
    {
        RegExtraRiders = Math.Max(0, Math.Min(100, RegExtraRiders + delta));
    }

    private string GetProductPriceDisplay(string productId)
    {
        string p = productId.ToUpper();
        if (p.Contains("MEDICO")) return "₹3,000 + ₹540 GST";
        if (p.Contains("LABCARE")) return "₹800 + ₹144 GST";
        if (p.Contains("RIDO")) return "₹2,000 + ₹360 GST (3 Riders)";
        return "Standard Monthly Plan";
    }

    private (decimal baseAmount, decimal taxAmount, decimal totalAmount, List<ProductPricingLineItemModel> items) CalculateRegPricing()
    {
        var items = new List<ProductPricingLineItemModel>();
        foreach (var pid in SelectedProductIds)
        {
            string p = pid.ToUpper();
            decimal b = p.Contains("MEDICO") ? 3000 : (p.Contains("LABCARE") ? 800 : (p.Contains("RIDO") ? 2000 : 1000));
            decimal t = Math.Round(b * 0.18m, 2);
            string name = p.Contains("MEDICO") ? "Medico Clinical ERP" : (p.Contains("LABCARE") ? "LabCare Diagnostic Suite" : "Rido Smart Rider App (3 Riders)");
            items.Add(new ProductPricingLineItemModel
            {
                product_id = p,
                product_name = name,
                base_amount = b,
                tax_amount = t,
                total_amount = b + t
            });
        }
        if (SelectedProductIds.Any(p => p.Contains("RIDO", StringComparison.OrdinalIgnoreCase)) && RegExtraRiders > 0)
        {
            decimal extraBase = RegExtraRiders * 400m;
            decimal extraTax = Math.Round(extraBase * 0.18m, 2);
            items.Add(new ProductPricingLineItemModel
            {
                product_id = "RIDO_EXTRA_RIDERS",
                product_name = $"Additional Riders ({RegExtraRiders} @ ₹400 + ₹72 GST)",
                base_amount = extraBase,
                tax_amount = extraTax,
                total_amount = extraBase + extraTax,
                quantity = RegExtraRiders
            });
        }

        decimal subTotal = items.Sum(i => i.base_amount);
        decimal totalTax = items.Sum(i => i.tax_amount);
        decimal grandTotal = items.Sum(i => i.total_amount);
        return (subTotal, totalTax, grandTotal, items);
    }

    private void ToggleProductSelection(string productId)
    {
        if (SelectedProductIds.Contains(productId))
        {
            SelectedProductIds.Remove(productId);
        }
        else
        {
            SelectedProductIds.Add(productId);
        }

        RegData.selected_product_id = SelectedProductIds.Count > 0 ? string.Join(",", SelectedProductIds) : string.Empty;

        if (editContext != null)
        {
            var field = editContext.Field(nameof(RegData.selected_product_id));
            editContext.NotifyFieldChanged(field);
        }

        _showProductValidationError = SelectedProductIds.Count == 0;
    }

    private List<string> TimezoneList = new List<string>
    {
        "Africa/Abidjan", "Africa/Accra", "Africa/Addis_Ababa", "Africa/Algiers",
        "Africa/Asmara", "Africa/Bamako", "Africa/Bangui", "Africa/Banjul",
