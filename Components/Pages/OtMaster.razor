@page "/ot-master"
@page "/ot-masters"
@rendermode InteractiveServer

@using medico_backend.Model
@using Booking.Services
@using Booking.Helpers
@inject OtService OtService
@inject ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card">
        <div class="header-left-group">
            <div class="header-icon-box">
                <i class="bi bi-door-open-fill"></i>
            </div>
            <div class="header-text-group">
                <div class="title-row">
                    <h2 class="lab-title-text m-0">Operation Theater Master</h2>
                    <span class="suite-count-badge">@theatersList.Count @(theatersList.Count == 1 ? "Suite" : "Suites")</span>
                </div>
                <div class="header-subtitle-row">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Operation Suites &amp; Theater Allocation Directory</span>
                </div>
            </div>
        </div>

        <div class="header-right-group">
            <div class="search-input-wrapper">
                <i class="bi bi-search search-icon"></i>
                <input type="text" 
                       placeholder="Search theaters, location, specialty..." 
                       @bind="SearchQuery" 
                       @bind:event="oninput" 
                       class="lc-search-input" />
                @if (!string.IsNullOrWhiteSpace(SearchQuery))
                {
                    <button type="button" class="search-clear-btn" @onclick="ClearSearch" title="Clear search">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>
            
            <button class="btn-new-entry" @onclick="NewEntry">
                <i class="bi bi-plus-lg"></i>
                <span>Add Operation Theater</span>
            </button>
        </div>
    </div>

    @* --- STATS MINI BAR --- *@
    <div class="stats-mini-bar">
        <div class="stat-mini-card @(selectedStatusFilter == "ALL" ? "active-filter" : "")" @onclick='() => SetStatusFilter("ALL")' role="button" title="View all theaters">
            <div class="stat-mini-icon stat-icon-primary">
                <i class="bi bi-door-closed-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-mini-value">@theatersList.Count</div>
                <div class="stat-mini-label">Total Theaters</div>
            </div>
            @if (selectedStatusFilter == "ALL")
            {
                <span class="filter-indicator-dot"></span>
            }
        </div>

        <div class="stat-mini-card @(selectedStatusFilter == "ACTIVE" ? "active-filter" : "")" @onclick='() => SetStatusFilter("ACTIVE")' role="button" title="Filter active theaters">
            <div class="stat-mini-icon stat-icon-success">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-mini-value">@theatersList.Count(t => t.is_active)</div>
                <div class="stat-mini-label">Active Theaters</div>
            </div>
            @if (selectedStatusFilter == "ACTIVE")
            {
                <span class="filter-indicator-dot"></span>
            }
        </div>

        <div class="stat-mini-card @(selectedStatusFilter == "INACTIVE" ? "active-filter" : "")" @onclick='() => SetStatusFilter("INACTIVE")' role="button" title="Filter inactive theaters">
            <div class="stat-mini-icon stat-icon-danger">
                <i class="bi bi-dash-circle-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-mini-value">@theatersList.Count(t => !t.is_active)</div>
                <div class="stat-mini-label">Inactive Theaters</div>
            </div>
            @if (selectedStatusFilter == "INACTIVE")
            {
                <span class="filter-indicator-dot"></span>
            }
        </div>

        <div class="stat-mini-card">
            <div class="stat-mini-icon stat-icon-warning">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="stat-content">
                <div class="stat-mini-value">@theatersList.Count(t => t.timing_from == null && t.timing_to == null)</div>
                <div class="stat-mini-label">24/7 Available Suites</div>
            </div>
        </div>
    </div>

    @* --- DIRECTORY LIST --- *@
    <div class="directory-section">
        <div class="directory-top-bar">
            <div class="d-flex align-items-center gap-2">
                <span class="directory-heading-text">Theaters Directory</span>
                <span class="badge-count">@FilteredList.Count() of @theatersList.Count</span>
            </div>
            <div class="filter-pill-group">
                <button type="button" class="filter-pill-btn @(selectedStatusFilter == "ALL" ? "active" : "")" @onclick='() => SetStatusFilter("ALL")'>All</button>
                <button type="button" class="filter-pill-btn @(selectedStatusFilter == "ACTIVE" ? "active" : "")" @onclick='() => SetStatusFilter("ACTIVE")'>Active</button>
                <button type="button" class="filter-pill-btn @(selectedStatusFilter == "INACTIVE" ? "active" : "")" @onclick='() => SetStatusFilter("INACTIVE")'>Inactive</button>
            </div>
        </div>

        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="min-width: 220px;">THEATER / SUITE</th>
                        <th style="min-width: 200px;">SPECIALTY FOCUS</th>
                        <th style="min-width: 200px;">LOCATION / WING</th>
                        <th style="min-width: 220px;">TIMINGS (24H IST)</th>
                        <th style="width: 130px;" class="text-center">STATUS</th>
                        <th class="text-center" style="width: 120px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6" class="text-center p-48 text-slate-400">
                                <div class="spinner-border text-indigo-600 mb-2" role="status"></div>
                                <div class="font-13 font-semibold text-slate-600">Loading operation theaters...</div>
                            </td>
                        </tr>
                    }
                    else if (FilteredList.Any())
                    {
                        @foreach (var item in FilteredList)
                        {
                            <tr class="lc-table-row">
                                <td>
                                    <div class="ot-cell-inline">
                                        <div class="ot-badge-icon @(item.is_active ? "active-suite" : "inactive-suite")">
                                            <i class="bi bi-door-open-fill"></i>
                                        </div>
                                        <div class="ot-cell-info">
                                            <span class="ot-name-title">@item.ot_name</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.specialty))
                                    {
                                        <span class="specialty-badge">
                                            <i class="bi bi-heart-pulse text-indigo-500"></i>
                                            @item.specialty
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 font-12 italic">General / Multi-Specialty</span>
                                    }
                                </td>
                                <td>
                                    <div class="location-cell">
                                        <i class="bi bi-geo-alt-fill text-slate-400"></i>
                                        <span>@(string.IsNullOrWhiteSpace(item.location) ? "Main Hospital Block" : item.location)</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="timing-pill font-mono">
                                        <i class="bi bi-clock-fill text-indigo-500"></i>
                                        @FormatTimings(item.timing_from, item.timing_to)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="ot-status-pill @(item.is_active ? "active" : "inactive")">
                                        <span class="status-dot"></span>
                                        @(item.is_active ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="action-btn-group">
                                        <button type="button" class="lc-circle-btn-32 edit-btn" @onclick="() => EditEntry(item)" title="Edit Theater Details">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button type="button" class="lc-circle-btn-32 delete-btn" @onclick="() => PromptDelete(item)" title="Deactivate Theater">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-state-cell">
                                <div class="empty-state-card">
                                    <div class="empty-icon-wrap">
                                        <i class="bi bi-door-closed"></i>
                                    </div>
                                    <h4 class="empty-title">No Operation Theaters Found</h4>
                                    <p class="empty-desc">
                                        @if (!string.IsNullOrWhiteSpace(SearchQuery))
                                        {
                                            <span>No theaters matched your search query "<strong>@SearchQuery</strong>".</span>
                                        }
                                        else
                                        {
                                            <span>No operation theaters are currently configured in the master directory.</span>
                                        }
                                    </p>
                                    <button class="btn-new-entry mt-2" @onclick="NewEntry">
                                        <i class="bi bi-plus-lg"></i> Add Operation Theater
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- MODAL FORM --- *@
@if (showForm)
{
    <div class="modal-overlay">
        <div class="modal-form-card" @onclick:stopPropagation>
            <div class="modal-header-bar">
                <div class="modal-title-wrap">
                    <div class="modal-title-icon">
                        <i class="bi bi-door-open-fill"></i>
                    </div>
                    <div class="modal-title-texts">
                        <h3 class="modal-title-heading">@(isEditMode ? "Edit Operation Theater" : "Add Operation Theater")</h3>
                        <span class="modal-title-sub">Configure suite specifications, 24-hour operational timings &amp; equipment</span>
                    </div>
                </div>
                <button type="button" class="modal-close-btn" @onclick="CloseForm" disabled="@isSaving" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            
            <div class="modal-body">
                <fieldset disabled="@isSaving" style="border: none; padding: 0; margin: 0; display: contents;">
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label class="form-label">
                                Theater Name / Suite <span class="required-star">*</span>
                            </label>
                            <input type="text" 
                                   class="lab-input @(isSubmitted && string.IsNullOrWhiteSpace(formName) ? "input-error" : "")" 
                                   @bind="formName" 
                                   placeholder="e.g. OT-1, Cardiac Suite A, Ortho OR" 
                                   required />
                            @if (isSubmitted && string.IsNullOrWhiteSpace(formName))
                            {
                                <span class="form-error-msg">
                                    <i class="bi bi-exclamation-circle-fill"></i> Theater name is required
                                </span>
                            }
                        </div>

                        <div class="form-group">
                            <label class="form-label">Specialty Focus</label>
                            <input type="text" 
                                   class="lab-input" 
                                   @bind="formSpecialty" 
                                   placeholder="e.g. General Surgery, Orthopedic, Neurosurgery, Cardiology" />
                        </div>
                    </div>

                    <div class="form-grid-2">
                        <div class="form-group">
                            <label class="form-label">Location / Floor / Wing</label>
                            <input type="text" 
                                   class="lab-input" 
                                   @bind="formLocation" 
                                   placeholder="e.g. 1st Floor, Surgical Block, Tower B" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Key Equipment Available</label>
                            <input type="text" 
                                   class="lab-input" 
                                   @bind="formEquipment" 
                                   placeholder="e.g. C-Arm, Anesthesia Workstation, Laparoscopy Tower" />
                        </div>
                    </div>

                    <div class="form-grid-2">
                        <div class="form-group">
                            <label class="form-label">
                                Operational Timing From <span class="label-hint">(24h IST)</span>
                            </label>
                            <input type="time" class="lab-input" @bind="formTimingFrom" step="60" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Operational Timing To <span class="label-hint">(24h IST)</span>
                            </label>
                            <input type="time" class="lab-input" @bind="formTimingTo" step="60" />
                        </div>
                    </div>

                    @if (isEditMode)
                    {
                        <div class="form-group-toggle">
                            <label class="toggle-switch-wrap">
                                <input type="checkbox" @bind="formIsActive" />
                                <span class="toggle-slider"></span>
                            </label>
                            <div class="toggle-texts">
                                <span class="toggle-title">Active for Operation Bookings</span>
                                <span class="toggle-sub">When active, this suite will appear in surgical scheduling and theater allocation</span>
                            </div>
                        </div>
                    }
                </fieldset>
            </div>
            
            <div class="modal-footer-bar">
                <button type="button" class="btn-secondary-outline" @onclick="CloseForm" disabled="@isSaving">Cancel</button>
                <button type="button" class="btn-save" @onclick="SaveEntry" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle"></i>
                        <span>@(isEditMode ? "Update Theater" : "Save Theater")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* --- DELETE / DEACTIVATE CONFIRMATION MODAL --- *@
@if (showDeleteConfirm && deleteTarget != null)
{
    <div class="modal-overlay">
        <div class="modal-form-card delete-confirm-card" @onclick:stopPropagation>
            <div class="delete-icon-wrap">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h3 class="delete-modal-title">Deactivate Operation Theater?</h3>
            <p class="delete-modal-msg">
                Are you sure you want to deactivate <strong class="text-slate-800">@deleteTarget.ot_name</strong>?
                This will prevent future surgery scheduling in this theater suite.
            </p>
            <div class="delete-modal-actions">
                <button type="button" class="btn-secondary-outline" @onclick="CancelDelete" disabled="@isSaving">Cancel</button>
                <button type="button" class="btn-danger-filled" @onclick="ExecuteDelete" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Deactivating...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash3-fill me-1"></i>
                        <span>Deactivate Theater</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<OtMasterModel> theatersList = new();
    private bool isLoading = true;
    private string SearchQuery = "";
    private string selectedStatusFilter = "ALL";
    private bool showForm = false;
    private bool isEditMode = false;
    private bool isSubmitted = false;
    private bool isSaving = false;

    private Guid selectedId = Guid.Empty;
    private string formName = "";
    private string formLocation = "";
    private string formSpecialty = "";
    private TimeOnly? formTimingFrom = null;
    private TimeOnly? formTimingTo = null;
    private string formEquipment = "";
    private bool formIsActive = true;

    private bool showDeleteConfirm = false;
    private OtMasterModel? deleteTarget = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            theatersList = await OtService.GetOtMastersAsync(activeOnly: false);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading theaters: {ex.Message}");
            theatersList = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<OtMasterModel> FilteredList
    {
        get
        {
            var query = theatersList.AsEnumerable();

            if (selectedStatusFilter == "ACTIVE")
            {
                query = query.Where(t => t.is_active);
            }
            else if (selectedStatusFilter == "INACTIVE")
            {
                query = query.Where(t => !t.is_active);
            }

            if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                query = query.Where(t => 
                    (t.ot_name != null && t.ot_name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (t.specialty != null && t.specialty.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (t.location != null && t.location.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (t.equipment != null && t.equipment.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));
            }

            return query;
        }
    }

    private void SetStatusFilter(string filter)
    {
        selectedStatusFilter = filter;
    }

    private void ClearSearch()
    {
        SearchQuery = "";
    }

    private void NewEntry()
    {
        selectedId = Guid.Empty;
        formName = "";
        formLocation = "";
        formSpecialty = "";
        formTimingFrom = null; // No default pre-filled value
        formTimingTo = null;   // No default pre-filled value
        formEquipment = "";
        formIsActive = true;
        isEditMode = false;
        isSubmitted = false;
        showForm = true;
    }

    private void EditEntry(OtMasterModel item)
    {
        selectedId = item.ot_id;
        formName = item.ot_name;
        formLocation = item.location ?? "";
        formSpecialty = item.specialty ?? "";
        formTimingFrom = item.timing_from; // Retain actual value (null if unset)
        formTimingTo = item.timing_to;     // Retain actual value (null if unset)
        formEquipment = item.equipment ?? "";
        formIsActive = item.is_active;
        isEditMode = true;
        isSubmitted = false;
        showForm = true;
    }

    private void AppendEquipment(string equipName)
    {
        if (string.IsNullOrWhiteSpace(formEquipment))
        {
            formEquipment = equipName;
        }
        else
        {
            var items = formEquipment.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            if (!items.Contains(equipName, StringComparer.OrdinalIgnoreCase))
            {
                items.Add(equipName);
                formEquipment = string.Join(", ", items);
            }
        }
    }

    private async Task SaveEntry()
    {
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(formName)) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            OtApiResponse res;
            if (isEditMode)
            {
                res = await OtService.UpdateOtMasterAsync(new UpdateOtMasterRequest
                {
                    ot_id = selectedId,
                    ot_name = formName.Trim(),
                    location = formLocation.Trim(),
                    specialty = formSpecialty.Trim(),
                    timing_from = formTimingFrom,
                    timing_to = formTimingTo,
                    equipment = formEquipment.Trim(),
                    is_active = formIsActive
                });
            }
            else
            {
                res = await OtService.AddOtMasterAsync(new AddOtMasterRequest
                {
                    ot_name = formName.Trim(),
                    location = formLocation.Trim(),
                    specialty = formSpecialty.Trim(),
                    timing_from = formTimingFrom,
                    timing_to = formTimingTo,
                    equipment = formEquipment.Trim(),
                    is_active = true
                });
            }

            if (res.IsSuccess)
            {
                ToastService.ShowSuccess(isEditMode ? "Theater updated successfully!" : "Theater added successfully!");
                showForm = false;
                await LoadData();
            }
            else
            {
                ToastService.ShowError(res.message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void CloseForm()
    {
        if (isSaving) return;
        showForm = false;
    }

    private void PromptDelete(OtMasterModel item)
    {
        deleteTarget = item;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        deleteTarget = null;
    }

    private async Task ExecuteDelete()
    {
        if (deleteTarget == null) return;
        isSaving = true;
        StateHasChanged();
        try
        {
            var res = await OtService.DeleteOtMasterAsync(deleteTarget.ot_id);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess("Theater deactivated successfully.");
                showDeleteConfirm = false;
                deleteTarget = null;
                await LoadData();
            }
            else
            {
                ToastService.ShowError(res.message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private string FormatTimings(TimeOnly? from, TimeOnly? to)
    {
        if (from == null && to == null) return "24 / 7 (All Day)";
        if (from == null && to != null) return $"Until {to.Value:HH\\:mm} IST";
        if (from != null && to == null) return $"From {from.Value:HH\\:mm} IST";
        
        // 24-hour format with explicit IST indicator
        var fromStr = from.Value.ToString("HH\\:mm");
        var toStr = to.Value.ToString("HH\\:mm");
        return $"{fromStr} - {toStr} IST";
    }
}
