@page "/bills"
@rendermode InteractiveServer
@inject Booking.Services.HmsBillingService HmsBillingService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@using Booking.Models
@inject Booking.Services.DoctorService DoctorService
@using Newtonsoft.Json
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject IHttpClientFactory ClientFactory
@using Booking.Helpers

<div class="bills-wrapper">
    <!-- Header -->
    <div class="lab-header-card flex-between">
        <div class="gap-16 display-flex align-center">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">receipt_long</span>
            </div>
            <div>
                <h2 class="m-0 lab-title-text">View Bills</h2>
                <div class="gap-8 flex-start mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Comprehensive billing management</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <!-- Filters Card -->
    <div class="filters-card">


        <div class="bills-filters-body">
            <!-- Column 1: Date Range -->
            <div class="filter-column-item">
                <div class="filter-column-title">
                    <span>Date Range</span>
                </div>
                <div class="date-range-input-wrapper">
                    <i class="bi bi-calendar3 date-icon"></i>
                    <input type="date" @bind="filter.fromdate" class="date-range-field" />
                    <span class="date-separator">-</span>
                    <div class="px-2" />
                    <i class="bi bi-calendar3 date-icon"></i>
                    <input type="date" @bind="filter.todate" class="date-range-field" />
                </div>
            </div>

            <!-- Column 2: Patient Search -->
            <div class="filter-column-item">
                <div class="filter-column-title">
                    <span>Patient Search</span>
                </div>
                <div class="search-input-box-wrapper">
                    <i class="bi bi-search search-box-icon"></i>
                    <input type="text" @bind="filter.search" placeholder="Name, ID or Mobile" class="form-control-search" />
                </div>
            </div>

            <!-- Column 3: Doctor Search -->
            <div class="filter-column-item">
                <div class="filter-column-title">
                    <span>Doctor Search</span>
                </div>
                <div class="search-input-box-wrapper">
                    <i class="bi bi-search search-box-icon"></i>
                    <input type="text" placeholder="Name or Specialty" class="form-control-search" />
                </div>
            </div>

            <!-- Column 4: Branch -->
            <div class="filter-column-item">
                <div class="filter-column-title">
                    <span>Branch</span>
                </div>
                <select class="form-select" value="@filter.bhcode" @onchange="OnBranchChanged">
                    <option value="">All Branches</option>
                    @foreach (var b in branches)
                    {
                        <option value="@b.bh_code">@b.name</option>
                    }
                </select>
            </div>

            <!-- Column 5: Report Type -->
            <div class="filter-column-item">
                <div class="filter-column-title">
                    <span>Report Type</span>
                </div>
                <div class="chips-container">
                    <button type="button" class="filter-chip @(showPending ? "active" : "")" @onclick="TogglePendingFilter">
                        @if (showPending)
                        {
                            <i class="bi bi-check-lg"></i>
                        }
                        <span>Pending</span>
                    </button>
                    <button type="button" class="filter-chip @(showSettled ? "active" : "")" @onclick="ToggleSettledFilter">
                        @if (showSettled)
                        {
                            <i class="bi bi-check-lg"></i>
                        }
                        <span>Settled</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="filter-actions-inline">
            <div class="filter-actions-left">
                @if (canPrintBill)
                {
                    <button class="btn btn-outline" @onclick='() => PrintStatementReport("getstatement")' disabled="@isPrintingReport">
                        @if (isPrintingReport)
                        {
                            <span class="spinner-border spinner-border-sm text-success" role="status" style="width: 14px; height: 14px; border-width: 2px;"></span>
                        }
                        else
                        {
                            <i class="bi bi-printer text-success"></i>
                        }
                        <span>Print List</span>
                    </button>
                }
                <button class="btn btn-outline" @onclick='() => PrintSummaryReport("getpaymodesummary")' disabled="@isPrintingReport">
                    <i class="bi bi-wallet2 text-primary"></i> Paymode Summary
                </button>
                <button class="btn btn-outline" @onclick='() => PrintStatementReport("getpaymodestatement")' disabled="@isPrintingReport">
                    <i class="bi bi-bank text-info"></i> Paymode Statement
                </button>
                <button class="btn btn-outline" @onclick="ToggleReportsModal" disabled="@isPrintingReport">
                    <i class="bi bi-file-earmark-bar-graph text-warning"></i> Reports & Statements
                </button>
            </div>
            <div class="filter-actions-right">
                <button class="btn btn-primary-action" @onclick="LoadBillsAsync" disabled="@isLoading">
                    <i class="bi bi-search"></i> Search
                </button>
                <button class="btn btn-refresh" @onclick="ResetFiltersAsync" disabled="@isLoading">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="bills-table">
                <thead>
                    <tr>
                        <th>S.NO</th>
                        <th>SAMPLE ID</th>
                        <th>DATE TIME</th>
                        <th>PATIENT NAME</th>
                        <th>MOBIL</th>
                        <th>REF.BY</th>
                        <th>DIS AMT</th>
                        <th>NETT</th>
                        <th>PAID</th>
                        <th>BALANCE</th>
                        <th>USER NAME</th>
                        <th class="text-center">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="12" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (billsList == null || !billsList.data.Any())
                    {
                        <tr>
                            <td colspan="12" class="text-center py-4 text-muted">
                                No bills found for the selected criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int sno = (filter.page - 1) * filter.pagesize + 1;
                        foreach (var bill in billsList.data)
                        {
                            <tr>
                                <td class="sno-cell">@(sno++)</td>
                                <td><span class="sample-id-badge">@bill.bill_no</span></td>
                                <td>@(DateTimeHelper.ConvertUtcToIst(bill.bill_date)?.ToString("dd-MMM-yyyy HH:mm") ?? "-")</td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <span class="avatar-circle">@(string.IsNullOrEmpty(bill.patient_name) ? "P" : bill.patient_name[0].ToString().ToUpper())</span>
                                        <span class="fw-bold text-slate-800">@bill.patient_name</span>
                                    </div>
                                </td>
                                <td>@bill.mobileno</td>
                                <td>
                                    <span class="fw-bold text-slate-800">@GetDoctorName(bill.dcode, bill.doctor_name)</span>
                                </td>
                                <td>₹@string.Format("{0:0.00}", bill.discount_amount ?? 0)</td>
                                <td>₹@string.Format("{0:0.00}", bill.net_amount ?? 0)</td>
                                <td class="@((bill.paid_amount ?? 0) > 0 ? "paid-amount fw-bold" : "paid-zero")">₹@string.Format("{0:0.00}", bill.paid_amount ?? 0)</td>
                                <td><span class="@((bill.balance_amount ?? 0) > 0 ? "balance-due fw-bold" : "balance-settled")">₹@string.Format("{0:0.00}", bill.balance_amount ?? 0)</span></td>
                                <td><span class="user-badge">System</span></td>
                                <td class="action-cell">
                                    <div class="actions-dropdown-container">
                                        <button type="button" class="btn-actions-dropdown" @onclick="() => ToggleRowDropdown(bill.requestguid)" @onclick:stopPropagation title="Actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        @if (activeDropdownGuid == bill.requestguid)
                                        {
                                            <div class="actions-dropdown-menu">
                                                <button type="button" class="dropdown-item" @onclick="() => RunAction(() => ViewBillDetails(bill.requestguid))">
                                                    <i class="bi bi-eye text-primary"></i>
                                                    <span>View Details</span>
                                                </button>
                                                @if (canPrintBill)
                                                {
                                                    <button type="button" class="dropdown-item" @onclick="() => RunAction(() => PrintBillAsync(bill.requestguid))" disabled="@(printingGuid == bill.requestguid)">
                                                        @if (printingGuid == bill.requestguid)
                                                        {
                                                            <span class="spinner-border spinner-border-sm text-success" role="status" style="width: 14px; height: 14px; border-width: 2px; margin-right: 0.5rem; display: inline-block;"></span>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-printer text-success"></i>
                                                        }
                                                        <span>Print Bill</span>
                                                    </button>
                                                }
                                                @if (TenantState.HasActionRight("Lab", "Print Lab Result", "Edit"))
                                                {
                                                    <button type="button" class="dropdown-item" @onclick="() => RunAction(() => EditBill(bill.requestguid))">
                                                        <i class="bi bi-pencil text-info"></i>
                                                        <span>Edit Bill</span>
                                                    </button>
                                                }
                                                @if (TenantState.HasActionRight("Lab", "Print Lab Result", "Delete"))
                                                {
                                                    <button type="button" class="dropdown-item" @onclick="() => RunAction(() => CancelBill(bill.requestguid))">
                                                        <i class="bi bi-x-circle text-danger"></i>
                                                        <span>Cancel Bill</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <div class="pagination-area">
            <div class="pagination-info">
                Showing @((filter.page - 1) * filter.pagesize + (billsList?.data.Count > 0 ? 1 : 0)) to @((filter.page - 1) * filter.pagesize + (billsList?.data.Count ?? 0)) of @(billsList?.total ?? 0) records
            </div>
            <div class="pagination-controls">
                <button class="page-btn" disabled="@(filter.page <= 1)" @onclick="PrevPage">
                    <i class="bi bi-chevron-left"></i>
                </button>
                @{
                    int totalPages = billsList != null ? (int)Math.Ceiling((double)billsList.total / filter.pagesize) : 1;
                    if (totalPages == 0) totalPages = 1;
                    
                    for (int i = 1; i <= totalPages; i++)
                    {
                        var pageNum = i;
                        if (pageNum == filter.page || (pageNum >= filter.page - 2 && pageNum <= filter.page + 2))
                        {
                            <button class="page-btn @(pageNum == filter.page ? "active" : "")" @onclick="() => GoToPage(pageNum)">
                                @pageNum
                            </button>
                        }
                    }
                }
                <button class="page-btn" disabled="@(filter.page >= totalPages)" @onclick="NextPage">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="summary-cards-container">
        <div class="summary-card net-card">
            <div class="summary-icon">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div class="summary-content">
                <div class="summary-label">TOTAL NET</div>
                <div class="summary-value">₹@string.Format("{0:N2}", TotalNet)</div>
            </div>
        </div>
        <div class="summary-card paid-card">
            <div class="summary-icon">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="summary-content">
                <div class="summary-label">TOTAL PAID</div>
                <div class="summary-value">₹@string.Format("{0:N2}", TotalPaid)</div>
            </div>
        </div>
        <div class="summary-card balance-card">
            <div class="summary-icon">
                <i class="bi bi-clipboard-data"></i>
            </div>
            <div class="summary-content">
                <div class="summary-label">TOTAL BALANCE</div>
                <div class="summary-value">₹@string.Format("{0:N2}", TotalBalance)</div>
            </div>
        </div>
        <div class="floating-chart-btn">
            <i class="bi bi-bar-chart-fill"></i>
        </div>
    </div>
</div>

<!-- Modal for Bill Details/Print -->
@if (showDetailsModal && selectedBill != null)
{
    <div class="modal-backdrop">
        <div class="modal-content-lg">
            <div class="modal-header">
                <h5 class="mb-0">Bill Details - @selectedBill.bill_no</h5>
                <button type="button" class="btn-close-custom" @onclick="CloseDetailsModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body print-area">
                <div class="receipt-header-card">
                    <div class="receipt-brand-logo">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                    <div class="receipt-brand-info">
                        <h3>MEDICO DIAGNOSTICS</h3>
                        <p class="receipt-brand-addr">123 Health Ave, Medical City | Ph: +91 9876543210</p>
                    </div>
                </div>

                <div class="receipt-meta-grid">
                    <div class="receipt-meta-column">
                        <div class="meta-row">
                            <span class="meta-label">Patient:</span>
                            <span class="meta-value text-highlight">@selectedBill.patient_name</span>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">Mobile:</span>
                            <span class="meta-value">@selectedBill.mobileno</span>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">Age/Gender:</span>
                            <span class="meta-value">@selectedBill.ageyears / @selectedBill.gender</span>
                        </div>
                    </div>
                    <div class="receipt-meta-column">
                        <div class="meta-row">
                            <span class="meta-label">Bill No:</span>
                            <span class="meta-value text-mono">@selectedBill.bill_no</span>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">Date:</span>
                            <span class="meta-value">@DateTimeHelper.ConvertUtcToIst(selectedBill.bill_date)?.ToString("dd-MMM-yyyy HH:mm")</span>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">Doctor:</span>
                            <span class="meta-value">@(string.IsNullOrEmpty(selectedBill.doctor_name) ? "Self" : selectedBill.doctor_name)</span>
                        </div>
                    </div>
                </div>
                
                <div class="receipt-table-wrapper">
                    <table class="receipt-table">
                        <thead>
                            <tr>
                                <th style="width: 60px; text-align: center;">S.No</th>
                                <th>Test Name</th>
                                <th style="text-align: right; width: 100px;">Rate</th>
                                <th style="text-align: right; width: 100px;">Discount</th>
                                <th style="text-align: right; width: 120px;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int lsno = 1; }
                            @foreach (var item in selectedBill.items)
                            {
                                <tr>
                                    <td style="text-align: center;">@(lsno++)</td>
                                    <td style="font-weight: 600;">@item.item_name</td>
                                    <td style="text-align: right;">₹@string.Format("{0:0.00}", item.unit_rate)</td>
                                    <td style="text-align: right; color: #b91c1c;">₹@string.Format("{0:0.00}", item.discount)</td>
                                    <td style="text-align: right; font-weight: 600;">₹@string.Format("{0:0.00}", item.final_amount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <div class="receipt-summary-section">
                    <div class="receipt-summary-card">
                        <div class="summary-item-row">
                            <span>Gross Amount</span>
                            <span>₹@string.Format("{0:0.00}", selectedBill.gross_amount)</span>
                        </div>
                        <div class="summary-item-row">
                            <span>Discount</span>
                            <span class="text-danger">- ₹@string.Format("{0:0.00}", selectedBill.discount_amount)</span>
                        </div>
                        <div class="summary-item-row highlight-row">
                            <span>Net Amount</span>
                            <span>₹@string.Format("{0:0.00}", selectedBill.net_amount)</span>
                        </div>
                        <div class="summary-item-row">
                            <span>Paid Amount</span>
                            <span class="text-success">₹@string.Format("{0:0.00}", selectedBill.paid_amount)</span>
                        </div>
                        <div class="summary-item-row balance-row">
                            <span>Balance Due</span>
                            <span class="@(selectedBill.balance_amount > 0 ? "due-highlight" : "settled-highlight")">₹@string.Format("{0:0.00}", selectedBill.balance_amount)</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-detail-close" @onclick="CloseDetailsModal">Close</button>
                @if (canPrintBill)
                {
                    <button type="button" class="btn-detail-print" @onclick="() => PrintBillAsync(selectedBill.requestguid)" disabled="@isPrintingBill">
                        @if (isPrintingBill)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Printing...</span>
                        }
                        else
                        {
                            <i class="bi bi-printer-fill"></i>
                            <span>Print Receipt</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Date-wise Reports & Statements Modal -->
@if (showReportsModal)
{
    <div class="modal-backdrop" @onclick="ToggleReportsModal">
        <div class="reports-modal-content" @onclick:stopPropagation>
            <div class="reports-modal-header">
                <div class="reports-modal-title-area">
                    <i class="bi bi-file-earmark-bar-graph-fill reports-header-icon"></i>
                    <div>
                        <h2 class="reports-modal-title">Date-wise Reports & Statements</h2>
                        <p class="reports-modal-subtitle">Generate and print date-wise summaries and statements</p>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" @onclick="ToggleReportsModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="reports-modal-body">
                @if (isPrintingReport)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Generating PDF...</span>
                        </div>
                        <p class="mt-2 text-muted">Generating PDF Report, please wait...</p>
                    </div>
                }
                else
                {
                    <div class="reports-grid">
                        <!-- Summaries Column -->
                        <div class="reports-column">
                            <h3 class="column-title">
                                <i class="bi bi-journal-text icon-summary"></i> Summaries (Date-wise)
                            </h3>
                            <div class="reports-list">
                                <button type="button" class="report-item-btn" @onclick='() => PrintSummaryReport("gettestsummary")'>
                                    <i class="bi bi-clipboard2-pulse icon-report text-primary"></i>
                                    <span>Test Summary</span>
                                </button>
                                <button type="button" class="report-item-btn" @onclick='() => PrintSummaryReport("getgroupsummary")'>
                                    <i class="bi bi-people icon-report text-primary"></i>
                                    <span>Group Summary</span>
                                </button>
                                <button type="button" class="report-item-btn" @onclick='() => PrintSummaryReport("getreferralsummary")'>
                                    <i class="bi bi-prescription2 icon-report text-primary"></i>
                                    <span>Referral Summary</span>
                                </button>
                                <button type="button" class="report-item-btn" @onclick='() => PrintSummaryReport("getsummary")'>
                                    <i class="bi bi-file-earmark-text icon-report text-primary"></i>
                                    <span>General Summary</span>
                                </button>
                                <button type="button" class="report-item-btn" @onclick='() => PrintSummaryReport("getdiscountsummary")'>
                                    <i class="bi bi-percent icon-report text-primary"></i>
                                    <span>Discount Summary</span>
                                </button>
                                <button type="button" class="report-item-btn" @onclick='() => PrintSummaryReport("getduesummary")'>
                                    <i class="bi bi-arrow-down-right-circle icon-report text-primary"></i>
                                    <span>Due Summary</span>
                                </button>
                                <button type="button" class="report-item-btn" @onclick='() => PrintSummaryReport("getpaymodesummary")'>
                                    <i class="bi bi-wallet2 icon-report text-primary"></i>
                                    <span>Paymode Summary</span>
                                </button>
                            </div>
                        </div>

                        <!-- Statements Column -->
                        <div class="reports-column">
                            <h3 class="column-title">
                                <i class="bi bi-file-earmark-spreadsheet icon-statement"></i> Statements
                            </h3>
                            <div class="reports-list">
                                <button type="button" class="report-item-btn" @onclick='() => PrintStatementReport("getteststatement")'>
                                    <i class="bi bi-clipboard-data icon-report text-success"></i>
                                    <span>Test Statement</span>
                                </button>
                                <button type="button" class="report-item-btn" @onclick='() => PrintStatementReport("getstatement")'>
                                    <i class="bi bi-list-ul icon-report text-success"></i>
                                    <span>General Statement</span>
                                </button>
                                <button type="button" class="report-item-btn" @onclick='() => PrintStatementReport("getgroupstatement")'>
                                    <i class="bi bi-grid-3x2-gap icon-report text-success"></i>
                                    <span>Group Statement</span>
                                </button>
                                <button type="button" class="report-item-btn" @onclick='() => PrintStatementReport("getduestatement")'>
                                    <i class="bi bi-cash-stack icon-report text-success"></i>
                                    <span>Due Statement</span>
                                </button>
                                <button type="button" class="report-item-btn" @onclick='() => PrintStatementReport("getdiscountstatement")'>
                                    <i class="bi bi-percent icon-report text-success"></i>
                                    <span>Discount Statement</span>
                                </button>
                                <button type="button" class="report-item-btn" @onclick='() => PrintStatementReport("getreferralstatement")'>
                                    <i class="bi bi-hospital icon-report text-success"></i>
                                    <span>Referral Statement</span>
                                </button>
                                <button type="button" class="report-item-btn" @onclick='() => PrintStatementReport("getpaymodestatement")'>
                                    <i class="bi bi-bank icon-report text-success"></i>
                                    <span>Paymode Statement</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="reports-modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="ToggleReportsModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private HmsBillFilterRequest filter = new HmsBillFilterRequest
    {
        page = 1,
        pagesize = 10,
        fromdate = DateTime.Today.AddDays(-30),
        todate = DateTime.Today
    };

    private HmsBillListResponse? billsList;
    private bool isLoading = false;
    private bool canPrintBill = true;

    // Totals logic
    private double totalNetAll = 0;
    private double totalPaidAll = 0;
    private double totalBalanceAll = 0;

    private double TotalNet => totalNetAll;
    private double TotalPaid => totalPaidAll;
    private double TotalBalance => totalBalanceAll;

    private bool showDetailsModal = false;
    private bool showReportsModal = false;
    private bool isPrintingReport = false;
    private string errorMessage = "";
    private bool isPrintingBill = false;
    private string? printingGuid = null;
    private HmsBillResponse? selectedBill;
    private List<Booking.Models.BranchModel> branches = new();
    private bool showPending = true;
    private bool showSettled = true;

    private string? activeDropdownGuid;

    private void ToggleRowDropdown(string? guid)
    {
        if (string.IsNullOrEmpty(guid)) return;
        if (activeDropdownGuid == guid)
        {
            activeDropdownGuid = null;
        }
        else
        {
            activeDropdownGuid = guid;
