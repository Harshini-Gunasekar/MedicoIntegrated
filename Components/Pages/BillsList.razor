    private void ToggleReportsModal()
    {
        showReportsModal = !showReportsModal;
    }

    private async Task PrintSummaryReport(string endpoint)
    {
        string fromStr = filter.fromdate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd");
        string toStr = filter.todate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd");
        string dateParamName = (endpoint.Contains("due") || endpoint.Contains("discount")) ? "fromddate" : "fromdate";
        string url = $"api/Report/{endpoint}?{dateParamName}={fromStr}&periodtype=Day&todate={toStr}";
        if (filter.bhcode.HasValue && filter.bhcode.Value > 0)
        {
            url += $"&bhcode={filter.bhcode.Value}";
        }
        if (filter.pendingonly.HasValue)
        {
            url += $"&pendingonly={filter.pendingonly.Value.ToString().ToLower()}";
        }
        await PrintReportBase64(url);
    }

    private async Task PrintStatementReport(string endpoint)
    {
        string fromStr = filter.fromdate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd");
        string toStr = filter.todate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd");
        string dateParamName = (endpoint.Contains("due") || endpoint.Contains("discount")) ? "fromddate" : "fromdate";
        string url = $"api/Report/{endpoint}?{dateParamName}={fromStr}&todate={toStr}";
        if (filter.bhcode.HasValue && filter.bhcode.Value > 0)
        {
            url += $"&bhcode={filter.bhcode.Value}";
        }
        if (filter.pendingonly.HasValue)
        {
            url += $"&pendingonly={filter.pendingonly.Value.ToString().ToLower()}";
        }
        await PrintReportBase64(url);
    }

    private async Task PrintReportBase64(string endpointWithParams)
    {
        try
        {
            isPrintingReport = true;
            StateHasChanged();

            // Client created using default client, which targets ApiBaseUrl and runs through TenantHeaderHandler
            var resp = await Http.GetAsync(endpointWithParams);
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                errorMessage = $"Print failed: {err}";
                await JS.InvokeVoidAsync("alert", errorMessage);
                return;
            }

            var raw = await resp.Content.ReadAsStringAsync();
            var base64 = raw.Trim().Trim('"');
            await JS.InvokeVoidAsync("openBase64Pdf", base64);
        }
        catch (Exception ex)
        {
            errorMessage = $"Print error: {ex.Message}";
            await JS.InvokeVoidAsync("alert", errorMessage);
        }
        finally
        {
            isPrintingReport = false;
            StateHasChanged();
        }
    }

    private async Task PrintBillAsync(string? guid)
    {
        if (string.IsNullOrEmpty(guid)) return;
        try
        {
            printingGuid = guid;
            isPrintingBill = true;
            StateHasChanged();

            // Call api/Report/getbill?isletterhead=true&requestguid={guid}
            string url = $"api/Report/getbill?isletterhead=true&requestguid={guid}";
            var resp = await Http.GetAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                var raw = await resp.Content.ReadAsStringAsync();
                var base64 = raw.Trim().Trim('"');
                await JS.InvokeVoidAsync("openBase64Pdf", base64);
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("alert", $"Print failed: {err}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Print error: {ex.Message}");
        }
        finally
        {
            printingGuid = null;
            isPrintingBill = false;
            StateHasChanged();
        }
    }
