@page "/bills"
@rendermode InteractiveServer
@inject Booking.Services.HmsBillingService HmsBillingService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@using Booking.Models
@inject Booking.Services.DoctorService DoctorService
@using Newtonsoft.Json
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject IHttpClientFactory ClientFactory

<div class="bills-wrapper">
    <!-- Header -->
    <div class="bills-header">
        <div class="header-title-area">
            <div class="header-icon-box">
                <i class="bi bi-receipt"></i>
            </div>
            <div class="header-text-container">
                <h1 class="header-title">View Bills</h1>
                <span class="header-subtitle">Comprehensive billing management</span>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="bills-filters">
        <div class="filter-group">
            <label>FROM DATE</label>
            <input type="date" @bind="filter.fromdate" class="form-control" />
        </div>
        <div class="filter-group">
            <label>TO DATE</label>
            <input type="date" @bind="filter.todate" class="form-control" />
        </div>
        <div class="filter-group">
            <label>BRANCH</label>
            <select class="form-select" value="@filter.bhcode" @onchange="OnBranchChanged">
                <option value="">All Branches</option>
                @foreach (var b in branches)
                {
                    <option value="@b.bh_code">@b.name</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <label>REPORT TYPE</label>
            <div class="checkbox-container">
                <label class="checkbox-label">
                    <input type="checkbox" checked="@showPending" @onchange="OnPendingToggled" />
                    Pending Bills
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" checked="@showSettled" @onchange="OnSettledToggled" />
                    Settled Bills
                </label>
            </div>
        </div>
        <div class="filter-group filter-group-large">
            <label>PATIENT SEARCH</label>
            <input type="text" @bind="filter.search" placeholder="Name, ID or Mobile" class="form-control" />
        </div>
        <div class="filter-group filter-group-large">
            <label>DOCTOR SEARCH</label>
            <input type="text" placeholder="Name or Specialty" class="form-control" />
        </div>
        <div class="filter-actions-inline">
            <button class="btn btn-outline" @onclick="LoadBillsAsync" disabled="@isLoading">
                <i class="bi bi-search"></i> Search
            </button>
            @if (canPrintBill)
            {
                <button class="btn btn-outline" @onclick='() => PrintStatementReport("getstatement")' disabled="@isPrintingReport">
                    @if (isPrintingReport)
                    {
                        <span class="spinner-border spinner-border-sm text-success" role="status" style="width: 14px; height: 14px; border-width: 2px;"></span>
                    }
                    else
                    {
                        <i class="bi bi-printer text-success"></i>
                    }
                    <span>Print List</span>
                </button>
            }
            <button class="btn btn-outline" @onclick='() => PrintSummaryReport("getpaymodesummary")' disabled="@isPrintingReport">
                <i class="bi bi-wallet2 text-primary"></i> Paymode Summary
            </button>
            <button class="btn btn-outline" @onclick='() => PrintStatementReport("getpaymodestatement")' disabled="@isPrintingReport">
                <i class="bi bi-bank text-info"></i> Paymode Statement
            </button>
            <button class="btn btn-outline" @onclick="ToggleReportsModal" disabled="@isPrintingReport">
                <i class="bi bi-file-earmark-bar-graph text-warning"></i> Reports & Statements
            </button>
            <button class="btn btn-outline" @onclick="ResetFiltersAsync" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise text-muted"></i> Refresh
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="bills-table">
                <thead>
                    <tr>
                        <th>S.NO</th>
                        <th>SAMPLE ID</th>
                        <th>DATE TIME</th>
                        <th>PATIENT NAME</th>
                        <th>MOBIL</th>
                        <th>REF.BY</th>
                        <th>DIS AMT</th>
                        <th>NETT</th>
                        <th>PAID</th>
                        <th>BALANCE</th>
                        <th>USER NAME</th>
                        <th class="text-center">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="12" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (billsList == null || !billsList.data.Any())
                    {
                        <tr>
                            <td colspan="12" class="text-center py-4 text-muted">
                                No bills found for the selected criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int sno = (filter.page - 1) * filter.pagesize + 1;
                        foreach (var bill in billsList.data)
                        {
                            <tr>
                                <td>@(sno++)</td>
                                <td class="fw-bold text-primary">@bill.bill_no</td>
                                <td>@(bill.bill_date?.ToString("dd-MMM-yyyy HH:mm") ?? "-")</td>
                                <td class="fw-bold">@bill.patient_name</td>
                                <td>@bill.mobileno</td>
                                <td>@GetDoctorName(bill.dcode, bill.doctor_name)</td>
                                <td>₹@string.Format("{0:0.00}", bill.discount_amount ?? 0)</td>
                                <td>₹@string.Format("{0:0.00}", bill.net_amount ?? 0)</td>
                                <td class="text-success fw-bold">₹@string.Format("{0:0.00}", bill.paid_amount ?? 0)</td>
                                <td class="text-danger fw-bold">₹@string.Format("{0:0.00}", bill.balance_amount ?? 0)</td>
                                <td>System</td>
                                <td class="action-cell">
                                    <button class="action-btn text-primary" @onclick="() => ViewBillDetails(bill.requestguid)" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    @if (canPrintBill)
                                    {
                                        <button class="action-btn text-success" @onclick="() => PrintBillAsync(bill.requestguid)" title="Print Bill" disabled="@(printingGuid == bill.requestguid)">
                                            @if (printingGuid == bill.requestguid)
                                            {
                                                <span class="spinner-border spinner-border-sm text-success" role="status" style="width: 14px; height: 14px; border-width: 2px;"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-printer"></i>
                                            }
                                        </button>
                                    }
                                    @if (TenantState.HasActionRight("Lab", "Print Lab Result", "Edit"))
                                    {
                                        <button class="action-btn text-primary" @onclick="() => EditBill(bill.requestguid)" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    }
                                    @if (TenantState.HasActionRight("Lab", "Print Lab Result", "Delete"))
                                    {
                                        <button class="action-btn text-danger" title="Delete" @onclick="() => CancelBill(bill.requestguid)">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <div class="pagination-area">
            <div class="pagination-info">
                Showing @((filter.page - 1) * filter.pagesize + (billsList?.data.Count > 0 ? 1 : 0)) to @((filter.page - 1) * filter.pagesize + (billsList?.data.Count ?? 0)) of @(billsList?.total ?? 0) records
            </div>
            <div class="pagination-controls">
                <button class="page-btn" disabled="@(filter.page <= 1)" @onclick="PrevPage">
                    <i class="bi bi-chevron-left"></i>
                </button>
                @{
                    int totalPages = billsList != null ? (int)Math.Ceiling((double)billsList.total / filter.pagesize) : 1;
                    if (totalPages == 0) totalPages = 1;
                    
                    for (int i = 1; i <= totalPages; i++)
                    {
                        var pageNum = i;
                        if (pageNum == filter.page || (pageNum >= filter.page - 2 && pageNum <= filter.page + 2))
                        {
                            <button class="page-btn @(pageNum == filter.page ? "active" : "")" @onclick="() => GoToPage(pageNum)">
                                @pageNum
                            </button>
                        }
                    }
                }
                <button class="page-btn" disabled="@(filter.page >= totalPages)" @onclick="NextPage">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="summary-cards-container">
        <div class="summary-card net-card">
            <div class="summary-icon">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div class="summary-content">
                <div class="summary-label">TOTAL NET</div>
                <div class="summary-value">₹@string.Format("{0:N2}", TotalNet)</div>
            </div>
        </div>
        <div class="summary-card paid-card">
            <div class="summary-icon">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="summary-content">
                <div class="summary-label">TOTAL PAID</div>
                <div class="summary-value">₹@string.Format("{0:N2}", TotalPaid)</div>
            </div>
        </div>
        <div class="summary-card balance-card">
            <div class="summary-icon">
                <i class="bi bi-clipboard-data"></i>
            </div>
            <div class="summary-content">
                <div class="summary-label">TOTAL BALANCE</div>
                <div class="summary-value">₹@string.Format("{0:N2}", TotalBalance)</div>
            </div>
        </div>
        <div class="floating-chart-btn">
            <i class="bi bi-bar-chart-fill"></i>
        </div>
    </div>
</div>

<!-- Modal for Bill Details/Print -->
@if (showDetailsModal && selectedBill != null)
{
    <div class="modal-backdrop">
        <div class="modal-content-lg">
            <div class="modal-header">
                <h5 class="mb-0">Bill Details - @selectedBill.bill_no</h5>
                <button type="button" class="btn-close-custom" @onclick="CloseDetailsModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body print-area">
                <div class="receipt-header text-center mb-4">
                    <h3>MEDICO DIAGNOSTICS</h3>
                    <p class="mb-0 text-muted">123 Health Ave, Medical City</p>
                    <p class="text-muted">Ph: +91 9876543210</p>
                </div>
                <div class="row mb-4">
                    <div class="col-6">
                        <p><strong>Patient:</strong> @selectedBill.patient_name</p>
                        <p><strong>Mobile:</strong> @selectedBill.mobileno</p>
                        <p><strong>Age/Gender:</strong> @selectedBill.ageyears / @selectedBill.gender</p>
                    </div>
                    <div class="col-6 text-end">
                        <p><strong>Bill No:</strong> @selectedBill.bill_no</p>
                        <p><strong>Date:</strong> @selectedBill.bill_date?.ToString("dd-MMM-yyyy HH:mm")</p>
                        <p><strong>Doctor:</strong> @(string.IsNullOrEmpty(selectedBill.doctor_name) ? "Self" : selectedBill.doctor_name)</p>
                    </div>
                </div>
                
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>S.No</th>
                            <th>Test Name</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Discount</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int lsno = 1; }
                        @foreach (var item in selectedBill.items)
                        {
                            <tr>
                                <td>@(lsno++)</td>
                                <td>@item.item_name</td>
                                <td class="text-end">₹@string.Format("{0:0.00}", item.unit_rate)</td>
                                <td class="text-end">₹@string.Format("{0:0.00}", item.discount)</td>
                                <td class="text-end">₹@string.Format("{0:0.00}", item.final_amount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                
                <div class="row mt-4">
                    <div class="col-6 offset-6">
                        <table class="table table-sm table-borderless text-end">
                            <tr>
                                <td><strong>Gross Amount:</strong></td>
                                <td>₹@string.Format("{0:0.00}", selectedBill.gross_amount)</td>
                            </tr>
                            <tr>
                                <td><strong>Discount:</strong></td>
                                <td>₹@string.Format("{0:0.00}", selectedBill.discount_amount)</td>
                            </tr>
                            <tr class="border-top">
                                <td><strong>Net Amount:</strong></td>
                                <td><strong>₹@string.Format("{0:0.00}", selectedBill.net_amount)</strong></td>
                            </tr>
                            <tr>
                                <td><strong>Paid Amount:</strong></td>
                                <td>₹@string.Format("{0:0.00}", selectedBill.paid_amount)</td>
                            </tr>
                            <tr>
                                <td><strong>Balance:</strong></td>
                                <td><strong>₹@string.Format("{0:0.00}", selectedBill.balance_amount)</strong></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseDetailsModal">Close</button>
                @if (canPrintBill)
                {
                    <button type="button" class="btn btn-primary" @onclick="() => PrintBillAsync(selectedBill.requestguid)" disabled="@isPrintingBill">
                        @if (isPrintingBill)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Printing...</span>
                        }
                        else
                        {
                            <i class="bi bi-printer"></i>
                            <span>Print Receipt</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Date-wise Reports & Statements Modal -->
@if (showReportsModal)
{
    <div class="modal-backdrop" @onclick="ToggleReportsModal">
        <div class="reports-modal-content" @onclick:stopPropagation>
            <div class="reports-modal-header">
                <div class="reports-modal-title-area">
                    <i class="bi bi-file-earmark-bar-graph-fill reports-header-icon"></i>
                    <div>
                        <h2 class="reports-modal-title">Date-wise Reports & Statements</h2>
                        <p class="reports-modal-subtitle">Generate and print date-wise summaries and statements</p>
                    </div>
                </div>
                <button type="button" class="btn-close-custom" @onclick="ToggleReportsModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="reports-modal-body">
                @if (isPrintingReport)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Generating PDF...</span>
                        </div>
                        <p class="mt-2 text-muted">Generating PDF Report, please wait...</p>
                    </div>
                }
                else
                {
                    <div class="reports-grid">
                        <!-- Summaries Column -->
                        <div class="reports-column">
                            <h3 class="column-title">
                                <i class="bi bi-journal-text icon-summary"></i> Summaries (Date-wise)
