    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadBranchesAsync();
            
            var bhCodeResult = await _sessionStorage.GetAsync<string>("bhcode");
            if (bhCodeResult.Success && !string.IsNullOrEmpty(bhCodeResult.Value) && int.TryParse(bhCodeResult.Value, out int savedBranchCode))
            {
                filter.bhcode = savedBranchCode;
            }
            
            await LoadBillsAsync();
            StateHasChanged();
        }
