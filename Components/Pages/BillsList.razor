@code {
    private HmsBillFilterRequest filter = new HmsBillFilterRequest
    {
        page = 1,
        pagesize = 10,
        fromdate = DateTime.Today.AddDays(-30),
        todate = DateTime.Today
    };

    private HmsBillListResponse? billsList;
    private bool isLoading = false;
    private bool canPrintBill = true;

    // Totals logic
    private double TotalNet => billsList?.data.Sum(b => b.net_amount ?? 0) ?? 0;
    private double TotalPaid => billsList?.data.Sum(b => b.paid_amount ?? 0) ?? 0;
    private double TotalBalance => billsList?.data.Sum(b => b.balance_amount ?? 0) ?? 0;

    private bool showDetailsModal = false;
    private bool showReportsModal = false;
    private bool isPrintingReport = false;
    private string errorMessage = "";
    private bool isPrintingBill = false;
    private string? printingGuid = null;
    private HmsBillResponse? selectedBill;
    private List<Booking.Models.BranchModel> branches = new();
    private bool showPending = true;
    private bool showSettled = true;

    private List<DoctorMasterModel> doctorsList = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUserPermissionsAsync();
        await LoadDoctorsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadBranchesAsync();
            
            var bhCodeResult = await _sessionStorage.GetAsync<string>("bhcode");
            if (bhCodeResult.Success && !string.IsNullOrEmpty(bhCodeResult.Value) && int.TryParse(bhCodeResult.Value, out int savedBranchCode))
            {
                filter.bhcode = savedBranchCode;
            }
            
            await LoadBillsAsync();
            StateHasChanged();
        }
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }

            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                branches = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branches = branches.Where(b => !b.deleted).ToList();

                await FilterBranchesByUserAccessAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }

    private async Task FilterBranchesByUserAccessAsync()
    {
        try
        {
            var isTenantAdminResult = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
            if (isTenantAdminResult.Success && isTenantAdminResult.Value == true)
            {
                return;
            }

            var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (userDetailsResult.Success && userDetailsResult.Value != null && userDetailsResult.Value.UserCode == 0)
            {
                return;
            }

            if (userDetailsResult.Success && userDetailsResult.Value?.Branches != null && userDetailsResult.Value.Branches.Any())
            {
                var allowedCodes = userDetailsResult.Value.Branches
                    .Select(b => b.bh_code != 0 ? b.bh_code : (b.bhcode ?? 0))
                    .Where(code => code > 0)
                    .ToHashSet();

                if (allowedCodes.Any())
                {
                    branches = branches.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                    return;
                }
            }

            var branchCodesResult = await _sessionStorage.GetAsync<List<int>>("UserBranchCodes");
            if (branchCodesResult.Success && branchCodesResult.Value != null && branchCodesResult.Value.Any())
            {
                var allowedCodes = branchCodesResult.Value.ToHashSet();
                branches = branches.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering branches by user access: {ex.Message}");
        }
    }

    private async Task OnBranchChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int bhcode))
        {
            filter.bhcode = bhcode;
        }
        else
        {
            filter.bhcode = null;
        }
        await LoadBillsAsync();
    }

    private async Task LoadDoctorsAsync()
    {
        try
        {
            doctorsList = await DoctorService.GetDoctorsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctors: {ex.Message}");
        }
    }

    private string GetDoctorName(int? dcode, string? fallbackName)
    {
        if (dcode.HasValue && dcode.Value > 0)
        {
            var doc = doctorsList.FirstOrDefault(d => d.dcode == dcode.Value);
            if (doc != null)
            {
                return doc.name ?? fallbackName ?? "Self";
            }
        }
        return string.IsNullOrEmpty(fallbackName) ? "Self" : fallbackName;
    }

    private async Task OnPendingToggled(ChangeEventArgs e)
    {
        showPending = (bool)(e.Value ?? false);
        UpdatePendingFilter();
        await LoadBillsAsync();
    }

    private async Task OnSettledToggled(ChangeEventArgs e)
    {
        showSettled = (bool)(e.Value ?? false);
        UpdatePendingFilter();
        await LoadBillsAsync();
    }

    private void UpdatePendingFilter()
    {
        if (showPending && !showSettled)
        {
            filter.pendingonly = true;
        }
        else if (!showPending && showSettled)
        {
            filter.pendingonly = false;
        }
        else
        {
            filter.pendingonly = null;
        }
    }

    private async Task LoadUserPermissionsAsync()
    {
        try
        {
            var userCode = TenantState.UserCode;
            if (userCode <= 0) return;

            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }

            var response = await client.GetAsync($"api/user/get?user_code={userCode}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var settings = new Newtonsoft.Json.JsonSerializerSettings 
                { 
                    NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore 
                };
                var userDetails = Newtonsoft.Json.JsonConvert.DeserializeObject<LIMS_Backend.Model.user_master>(json, settings);
                if (userDetails != null)
                {
                    canPrintBill = userDetails.print_bill ?? true;
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[BillsList] LoadUserPermissionsAsync error: {ex.Message}");
        }
    }

    private async Task LoadBillsAsync()
    {
        isLoading = true;
        StateHasChanged();
        
        billsList = await HmsBillingService.ListBillsAsync(filter);
        if (billsList?.data != null)
        {
            if (showPending && !showSettled)
            {
                billsList.data = billsList.data.Where(b => (b.balance_amount ?? 0) > 0).ToList();
            }
            else if (!showPending && showSettled)
            {
                billsList.data = billsList.data.Where(b => (b.balance_amount ?? 0) <= 0).ToList();
            }
            else if (!showPending && !showSettled)
            {
                billsList.data = new List<HmsBillSummary>();
            }
        }
        
        isLoading = false;
        StateHasChanged();
    }

    private async Task ResetFiltersAsync()
    {
        showPending = true;
        showSettled = true;
        
        int? activeBhCode = null;
        var bhCodeResult = await _sessionStorage.GetAsync<string>("bhcode");
        if (bhCodeResult.Success && !string.IsNullOrEmpty(bhCodeResult.Value) && int.TryParse(bhCodeResult.Value, out int savedBranchCode))
        {
            activeBhCode = savedBranchCode;
        }

        filter = new HmsBillFilterRequest
        {
            page = 1,
            pagesize = 10,
            fromdate = DateTime.Today.AddDays(-30),
            todate = DateTime.Today,
            pendingonly = null,
            bhcode = activeBhCode
        };
        await LoadBillsAsync();
    }

    private async Task GoToPage(int page)
    {
        filter.page = page;
        await LoadBillsAsync();
    }

    private async Task NextPage()
    {
        int totalPages = billsList != null ? (int)Math.Ceiling((double)billsList.total / filter.pagesize) : 1;
        if (filter.page < totalPages)
        {
            filter.page++;
            await LoadBillsAsync();
        }
    }

    private async Task PrevPage()
    {
        if (filter.page > 1)
        {
            filter.page--;
            await LoadBillsAsync();
        }
    }

    private async Task ViewBillDetails(string? guid)
    {
        if (string.IsNullOrEmpty(guid)) return;
        
        selectedBill = await HmsBillingService.GetBillByGuidAsync(guid);
        if (selectedBill != null)
        {
            showDetailsModal = true;
        }
