@page "/floors"
@page "/floor-master"
@rendermode InteractiveServer

@using Medico_Backend.Model
@using Booking.Services
@using Newtonsoft.Json
@using Booking.Models
@using Booking.Helpers
@inject FloorMasterService FloorService
@inject BlockMasterService BlockService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IHttpClientFactory ClientFactory
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">layers</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Floor Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Floor Configuration</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search floors..." @bind="SearchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            <div class="search-controls">
                @if (hasCreateRight)
                {
                    <button class="btn-new-entry" @onclick="NewFloor">+ Add New</button>
                }
            </div>
        </div>
    </div>

    @* --- directory list --- *@
    <div class="directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">ORDER NO</th>
                        <th style="width: 130px;">SHORT NAME</th>
                        <th>FLOOR NAME</th>
                        <th>DESCRIPTION</th>
                        <th>BRANCH</th>
                        <th>BLOCK</th>
                        <th style="width: 180px;">ENTERED DATE</th>
                        <th style="width: 180px;">MODIFIED DATE</th>
                        <th class="text-center" style="width: 120px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (floors != null && floors.Any())
                    {
                        @foreach (var f in FilteredFloorsBySearch)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"{f.orderno:00}")</span></td>
                                <td class="lc-color-slate-500 lc-font-mono lc-font-700 lc-font-13">@f.shortname</td>
                                <td class="font-bold text-slate-800">@f.name</td>
                                <td class="text-slate-600">@f.description</td>
                                <td><span class="lc-color-slate-600 font-bold">@(branches.FirstOrDefault(b => b.bh_code == f.branchcode)?.name ?? f.branchcode?.ToString() ?? "-")</span></td>
                                <td><span class="lc-color-slate-600 font-bold">@(blocksList.FirstOrDefault(b => b.blockcode == f.blockcode)?.name ?? f.blockcode?.ToString() ?? "-")</span></td>
                                <td class="text-slate-400 font-12">@(FormatToIst(f.entereddate))</td>
                                <td class="text-slate-400 font-12">@(FormatToIst(f.ibsdate))</td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px;">
                                        @if (hasEditRight)
                                        {
                                            <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => EditFloor(f)" title="Edit">
                                                <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                            </button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => PromptDelete(f.flrcode)" title="Delete">
                                                <span class="material-symbols-outlined font-18 text-slate-400">delete</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center p-48 text-slate-400 italic">No floor records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- FORM SECTION (Modal) --- *@
@if (showForm)
{
    <div class="modal-overlay">
        <div class="modal-form-card">
            <div class="modal-header-bar">
                <h3>@(isEditMode ? "Edit Floor" : "Floor Entry")</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-0 form-section">
                    <div class="mt-0">
                        @* Line 1: Floor Name, Short Name *@
                        <div style="display: grid; grid-template-columns: 3.5fr 1fr; gap: 1.25rem;">
                            <div class="form-group position-relative">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label style="margin-bottom: 0;">Floor name *</label>
                                    @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                    {
                                        <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                    }
                                </div>
                                <input type="text" class="lab-input" @bind="current.name" placeholder="e.g. First Floor" required />
                            </div>
                            <div class="form-group">
                                <label>Short Name</label>
                                <input type="text" class="lab-input" @bind="current.shortname" placeholder="e.g. FF" />
                            </div>
                        </div>

                        @* Line 2: Order no, Branch, Block *@
                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.25rem;">
                            <div class="form-group">
                                <label>Order no</label>
                                <input type="number" class="lab-input" @bind="current.orderno" />
                            </div>
                            <div class="form-group">
                                <label>Branch</label>
                                <select class="lab-input" @bind="current.branchcode">
                                    <option value="">-- Select Branch --</option>
                                    @foreach (var b in branches)
                                    {
                                        <option value="@b.bh_code">@b.name</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Block</label>
                                <select class="lab-input" @bind="current.blockcode">
                                    <option value="">-- Select Block --</option>
                                    @foreach (var blk in blocksList)
                                    {
                                        <option value="@blk.blockcode">@blk.name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        @* Line 3: Description *@
                        <div class="um-grid-row">
                            <div class="form-group">
                                <label>Description</label>
                                <input type="text" class="lab-input" @bind="current.description" placeholder="e.g. General inpatient and ward floor" />
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            
            <div class="modal-footer-bar">
                <button type="button"
                        class="btn-delete"
                        @onclick="() => PromptDelete(current.flrcode)"
                        disabled="@(current.flrcode == 0 || !hasDeleteRight)">
                    Delete
                </button>
                <button type="button" class="btn-save" @onclick="SaveFloor">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                    </svg>
                    Save Floor
                </button>
            </div>
        </div>
    </div>
}

@* --- DELETE CONFIRMATION MODAL --- *@
@if (showDeleteConfirm)
{
    <div class="modal-overlay">
        <div class="modal-form-card delete-confirm-card" style="max-width: 400px; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: white; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
            <div style="text-align: center; margin-bottom: 20px;">
                <p style="margin: 0; font-size: 15px; font-weight: 600; color: #1e293b;">Are you sure you want to delete the floor?</p>
            </div>
            <div style="display: flex; justify-content: center; gap: 12px; width: 100%;">
                <button type="button" class="btn-secondary-outline" @onclick="CancelDelete" style="flex: 1; max-width: 120px; border-radius: 6px;">Cancel</button>
                <button type="button" class="btn-danger-filled" @onclick="ExecuteDelete" style="flex: 1; max-width: 120px; border-radius: 6px;">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private string FormatToIst(DateTime? dt)
    {
        if (dt == null || dt == DateTime.MinValue) return "-";
        return dt.ToIndianTime()?.ToString("dd-MM-yyyy hh:mm tt") ?? "-";
    }

    private List<FloorMasterModel> floors = new();
    private FloorMasterModel current = new();
    private bool isEditMode = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";
    private bool showDeleteConfirm = false;
    private int deleteFlrCode = 0;
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    private IEnumerable<FloorMasterModel> FilteredFloors =>
        floors.Where(f => !f.deleted);

    private IEnumerable<FloorMasterModel> FilteredFloorsBySearch =>
        FilteredFloors.Where(f => 
            string.IsNullOrWhiteSpace(SearchQuery) || 
            (f.name != null && f.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (f.shortname != null && f.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (f.description != null && f.description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadFloors();
    }

    private async Task LoadFloors()
    {
        try
        {
            floors = await FloorService.GetFloorMastersAsync();
            blocksList = await BlockService.GetBlockMastersAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading floors: {ex.Message}");
        }
    }

    private void NewFloor()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add floors.");
            return;
        }
        current = new FloorMasterModel { 
            deleted = false,
            computercode = 1,
            usercode = 1,
            entereddate = DateTime.Now,
            ibsdate = DateTime.Now,
            orderno = floors.Count + 1,
            tenant_code = "TEN007",
            branchcode = null,
            blockcode = null
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private void EditFloor(FloorMasterModel f)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit floors.");
            return;
        }
        if (f == null) return;
        current = new FloorMasterModel
        {
            flrcode = f.flrcode,
            tenant_code = f.tenant_code,
            orderno = f.orderno,
            shortname = f.shortname,
            name = f.name,
            description = f.description,
            deleted = f.deleted,
            usercode = f.usercode,
            computercode = f.computercode,
            entereddate = f.entereddate,
            ibsdate = f.ibsdate,
            branchcode = f.branchcode,
            blockcode = f.blockcode
        };
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveFloor()
    {
        if (isEditMode && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit floors.");
            return;
        }
        if (!isEditMode && !hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add floors.");
            return;
        }
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(current.name))
        {
            ToastService.ShowError("Floor Name is required.");
            StateHasChanged();
            return;
        }

        try
        {
            current.tenant_code = "TEN007";
            current.computercode = 1;
            current.usercode = 1;
            current.ibsdate = DateTime.Now;

            bool success;
            if (isEditMode)
            {
                success = await FloorService.UpdateFloorMasterAsync(current);
            }
            else
            {
                current.entereddate = DateTime.Now;
                success = await FloorService.InsertFloorMasterAsync(current);
            }

            if (success)
            {
                await LoadFloors();
                ToastService.ShowSuccess(isEditMode ? "Floor updated successfully!" : "Floor added successfully!");
                if (isEditMode)
                {
                    showForm = false;
                }
                else
                {
                    NewFloor();
                }
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Save failed on backend.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving floor: {ex.Message}");
            StateHasChanged();
        }
    }

    private void PromptDelete(int flrcode)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete floors.");
            return;
        }
        if (flrcode == 0) return;
        deleteFlrCode = flrcode;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        deleteFlrCode = 0;
        showDeleteConfirm = false;
    }

    private async Task ExecuteDelete()
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete floors.");
            return;
        }
        if (deleteFlrCode == 0) return;
        try
        {
            bool success = await FloorService.DeleteFloorMasterAsync(deleteFlrCode);
            if (success)
            {
                await LoadFloors();
                ToastService.ShowSuccess("Floor deleted successfully!");
                if (current != null && current.flrcode == deleteFlrCode)
                {
                    showForm = false;
                }
                showDeleteConfirm = false;
                deleteFlrCode = 0;
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Delete failed on backend.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting: {ex.Message}");
            StateHasChanged();
        }
    }

    private void CloseForm()
    {
        current = new FloorMasterModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }

    private List<Booking.Models.BranchModel> branches = new();
    private List<BlockMasterModel> blocksList = new();
    private string TenantCode = "";
    private string AuthToken = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                await LoadBranchesAsync();

                try
                {
                    bool isAdmin = false;
                    try
                    {
                        var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                        if (userResult.Success && userResult.Value != null)
                        {
                            isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                      userResult.Value.UserCode == 0 ||
                                      userResult.Value.UserCode == 1;
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error checking user details: {ex.Message}");
                    }

                    if (isAdmin)
                    {
                        hasCreateRight = true;
                        hasEditRight = true;
                        hasDeleteRight = true;
                    }
                    else
                    {
                        var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                        if (rightsResult.Success && rightsResult.Value != null)
                        {
                            var pageRight = rightsResult.Value.FirstOrDefault(r => 
                                r.ModuleName != null && 
                                r.ModuleName.Trim().Equals("Floor_Master", StringComparison.OrdinalIgnoreCase));
                            
                            if (pageRight != null)
                            {
                                hasCreateRight = pageRight.ToAdd;
                                hasEditRight = pageRight.ToEdit;
                                hasDeleteRight = pageRight.ToDelete;
                            }
                            else
                            {
                                hasCreateRight = false;
                                hasEditRight = false;
                                hasDeleteRight = false;
                            }
                        }
                        else
                        {
                            hasCreateRight = false;
                            hasEditRight = false;
                            hasDeleteRight = false;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking Floor_Master rights: {ex.Message}");
                    hasCreateRight = false;
                    hasEditRight = false;
                    hasDeleteRight = false;
                }

                StateHasChanged();
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error loading session details: {ex.Message}");
            }
        }
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }

            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                branches = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branches = branches.Where(b => !b.deleted).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }
}
