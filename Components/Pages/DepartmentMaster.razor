@page "/department-master"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using System.Net.Http.Json
@using Medico_Backend.Model
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.ToastService ToastService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject ProtectedLocalStorage SessionStorage

<PageTitle>Department Master</PageTitle>

<div class="dm-page">
    <header class="dm-header">
        <div class="dm-heading">
            <h1>Department Master</h1>
            <span>Billing Configuration</span>
        </div>
        <div class="dm-header-actions">
            <label class="dm-search">
                <i class="bi bi-search"></i>
                <input type="search" placeholder="Quick find..." @bind="searchText" @bind:event="oninput" />
            </label>
            <button type="button" class="dm-button dm-button-primary" @onclick="OpenNewDepartment">
                + New Department Entry
            </button>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="dm-message"><span class="spinner-border spinner-border-sm"></span> Loading departments...</div>
    }
    else
    {
        <div class="dm-table-card">
            <table class="dm-table">
                <thead>
                    <tr>
                        <th>ORDER NO</th>
                        <th>SHORT NAME</th>
                        <th>DEPARTMENT NAME</th>
                        <th>DESCRIPTION</th>
                        <th>LAB</th>
                        <th>CHARGES</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredDepartments.Any())
                    {
                        @foreach (var department in FilteredDepartments)
                        {
                            <tr>
                                <td class="dm-order">@department.orderno</td>
                                <td>@department.shortname</td>
                                <td class="dm-name">
                                    <span class="dm-status-dot"></span>
                                    @department.name
                                </td>
                                <td class="dm-description">@department.description</td>
                                <td>@YesNo(department.islab)</td>
                                <td>@YesNo(department.ischarges)</td>
                                <td class="dm-actions">
                                    <button type="button" class="dm-action-button edit" title="Edit" @onclick="() => EditDepartment(department)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="dm-action-button delete" title="Delete" @onclick="() => RequestDeleteDepartment(department)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="dm-empty">No departments found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (showModal)
{
    <div class="dm-backdrop">
        <section class="dm-modal" role="dialog" aria-modal="true" aria-labelledby="dm-modal-title">
            <header class="dm-modal-header">
                <div>
                    <h2 id="dm-modal-title">@(isEditMode ? "Edit Department" : "New Department Entry")</h2>
                    <span>Configure department details</span>
                </div>
                <button type="button" class="dm-close" aria-label="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <div class="dm-modal-body">
                @if (isEditMode)
                {
                    <div class="dm-field">
                        <label>Department Code</label>
                        <input class="dm-input" value="@currentDepartment.dptcode" disabled />
                    </div>
                }
                <div class="dm-form-row">
                    <div class="dm-field">
                        <label>Department Name</label>
                        <input class="dm-input" maxlength="150" placeholder="Ex: Laboratory" @bind="currentDepartment.name" />
                    </div>
                    <div class="dm-field">
                        <label>Short Name</label>
                        <input class="dm-input" maxlength="50" placeholder="Ex: LAB" @bind="currentDepartment.shortname" />
                    </div>
                </div>
                <div class="dm-form-row">
                    <div class="dm-field">
                        <label>Display Order</label>
                        <input class="dm-input" type="number" @bind="currentDepartment.orderno" />
                    </div>
                    <div class="dm-field">
                        <label>Footer</label>
                        <input class="dm-input" placeholder="Reports valid with signature" @bind="currentDepartment.footer" />
                    </div>
                </div>
                <div class="dm-field">
                    <label>Description</label>
                    <textarea class="dm-input dm-textarea" rows="3" placeholder="Clinical laboratory services" @bind="currentDepartment.description"></textarea>
                </div>
                <fieldset class="dm-flags">
                    <legend>Department Settings</legend>
                    <label><input type="checkbox" @bind="IsScan" /> Scan</label>
                    <label><input type="checkbox" @bind="IsLab" /> Laboratory</label>
                    <label><input type="checkbox" @bind="IsCharges" /> Charges</label>
                    <label><input type="checkbox" @bind="IsInventory" /> Inventory</label>
                    <label><input type="checkbox" @bind="IsPackage" /> Package</label>
                    <label><input type="checkbox" @bind="IsTreatment" /> Treatment</label>
                </fieldset>
            </div>

            <footer class="dm-modal-footer">
                @if (isEditMode)
                {
                    <button type="button" class="dm-delete-text" @onclick="() => RequestDeleteDepartment(currentDepartment)">Delete</button>
                }
                <div class="dm-footer-actions">
                    <button type="button" class="dm-button dm-button-cancel" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="dm-button dm-button-primary" @onclick="SaveDepartment" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        <i class="bi bi-check2"></i> Save Department
                    </button>
                </div>
            </footer>
        </section>
    </div>
}

@if (showDeleteConfirmation)
{
    <div class="dm-backdrop dm-confirm-backdrop">
        <section class="dm-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="dm-confirm-title">
            <div class="dm-confirm-icon"><i class="bi bi-exclamation-triangle"></i></div>
            <h2 id="dm-confirm-title">Delete Department?</h2>
            <p>Are you sure you want to delete this department? This action can't be undone.</p>
            <footer class="dm-confirm-actions">
                <button type="button" class="dm-button dm-button-cancel" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="dm-button dm-button-delete" @onclick="ConfirmDeleteDepartment">Delete</button>
            </footer>
        </section>
    </div>
}

@code {
    private List<DepartmentMasterModel> departments = new();
    private DepartmentMasterModel currentDepartment = new();
    private string searchText = string.Empty;
    private string tenantCode = string.Empty;
    private bool isLoading;
    private bool isSaving;
    private bool showModal;
    private bool showDeleteConfirmation;
    private bool isEditMode;
    private bool initialized;
    private DepartmentMasterModel? pendingDelete;

    private bool IsScan { get => currentDepartment.isscan == true; set => currentDepartment.isscan = value; }
    private bool IsLab { get => currentDepartment.islab == true; set => currentDepartment.islab = value; }
    private bool IsCharges { get => currentDepartment.ischarges == true; set => currentDepartment.ischarges = value; }
    private bool IsInventory { get => currentDepartment.isinventory == true; set => currentDepartment.isinventory = value; }
    private bool IsPackage { get => currentDepartment.ispackage == true; set => currentDepartment.ispackage = value; }
    private bool IsTreatment { get => currentDepartment.istreatment == true; set => currentDepartment.istreatment = value; }

    private IEnumerable<DepartmentMasterModel> FilteredDepartments =>
        string.IsNullOrWhiteSpace(searchText)
            ? departments
            : departments.Where(department =>
                (department.name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (department.shortname?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                department.dptcode?.ToString(CultureInfo.InvariantCulture).Contains(searchText, StringComparison.OrdinalIgnoreCase) == true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || initialized)
        {
            return;
        }

        initialized = true;
        try
        {
            var storedTenant = await SessionStorage.GetAsync<string>("tenant_code");
            tenantCode = !string.IsNullOrWhiteSpace(TenantState.TenantCode)
                ? TenantState.TenantCode
                : storedTenant.Success ? storedTenant.Value ?? string.Empty : string.Empty;

            if (string.IsNullOrWhiteSpace(tenantCode))
            {
                throw new InvalidOperationException("Tenant code is unavailable; department requests cannot be sent.");
            }

            await LoadDepartments();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to initialize Department Master: {ex.Message}");
        }
    }

    private async Task LoadDepartments()
    {
        isLoading = true;
        try
        {
            using var request = CreateApiRequest(HttpMethod.Get, "api/DepartmentMaster/get");
            using var response = await ClientFactory.CreateClient("MedicoAPI").SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                throw new HttpRequestException($"Department request failed ({(int)response.StatusCode}): {error}");
            }

            var result = await response.Content.ReadFromJsonAsync<List<DepartmentMasterModel>>();
            departments = (result ?? new List<DepartmentMasterModel>())
                .Where(department => !department.deleted)
                .OrderBy(department => department.orderno)
                .ThenBy(department => department.name)
                .ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load departments: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenNewDepartment()
    {
        currentDepartment = new DepartmentMasterModel
        {
            orderno = departments.Count == 0 ? 1 : departments.Max(department => department.orderno) + 1,
            usercode = GetEffectiveUserCode(),
            computercode = GetEffectiveUserCode()
        };
        isEditMode = false;
        showModal = true;
    }

    private void EditDepartment(DepartmentMasterModel department)
    {
        currentDepartment = new DepartmentMasterModel
        {
            dptcode = department.dptcode,
            orderno = department.orderno,
            name = department.name,
            shortname = department.shortname,
            description = department.description,
            footer = department.footer,
            isscan = department.isscan,
            islab = department.islab,
            deleted = department.deleted,
            usercode = department.usercode,
            computercode = department.computercode,
            entereddate = department.entereddate,
            ibsdate = department.ibsdate,
            ischarges = department.ischarges,
            isinventory = department.isinventory,
            ispackage = department.ispackage,
            istreatment = department.istreatment
        };
        isEditMode = true;
        showModal = true;
    }

    private async Task SaveDepartment()
    {
        if (isSaving)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(currentDepartment.name))
        {
            ToastService.ShowError("Department name is required.");
            return;
        }
        if (isEditMode && currentDepartment.dptcode is null)
        {
            ToastService.ShowError("Department code is required to update a department.");
            return;
        }

        isSaving = true;
        try
        {
            var userCode = GetEffectiveUserCode();
            var name = currentDepartment.name.Trim();
            var shortName = currentDepartment.shortname?.Trim();
            object payload;

            if (isEditMode)
            {
                payload = new
                {
                    dptcode = currentDepartment.dptcode,
                    orderno = currentDepartment.orderno,
                    name,
                    shortname = shortName,
                    description = currentDepartment.description,
                    footer = currentDepartment.footer,
                    isscan = currentDepartment.isscan ?? false,
                    islab = currentDepartment.islab ?? false,
                    deleted = currentDepartment.deleted,
                    usercode = userCode,
                    computercode = userCode,
                    ischarges = currentDepartment.ischarges ?? false,
                    isinventory = currentDepartment.isinventory ?? false,
                    ispackage = currentDepartment.ispackage ?? false,
                    istreatment = currentDepartment.istreatment ?? false
                };
            }
            else
            {
                payload = new
                {
                    orderno = currentDepartment.orderno,
                    name,
                    shortname = shortName,
                    description = currentDepartment.description,
                    footer = currentDepartment.footer,
                    isscan = currentDepartment.isscan ?? false,
                    islab = currentDepartment.islab ?? false,
                    ischarges = currentDepartment.ischarges ?? false,
                    isinventory = currentDepartment.isinventory ?? false,
                    ispackage = currentDepartment.ispackage ?? false,
                    istreatment = currentDepartment.istreatment ?? false,
                    usercode = userCode,
                    computercode = userCode
                };
            }

            using var request = CreateApiRequest(
                HttpMethod.Post,
                isEditMode ? "api/DepartmentMaster/update" : "api/DepartmentMaster/insert",
                JsonContent.Create(payload, payload.GetType()));
            using var response = await ClientFactory.CreateClient("MedicoAPI").SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                throw new HttpRequestException($"Department save failed ({(int)response.StatusCode}): {error}");
            }

            ToastService.ShowSuccess(isEditMode ? "Department updated successfully." : "Department inserted successfully.");
            showModal = false;
            await LoadDepartments();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to save department: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteDepartment(DepartmentMasterModel department)
    {
        if (department.dptcode is null)
        {
            ToastService.ShowError("Department code is required to delete a department.");
            return;
        }

        try
        {
            var code = department.dptcode.Value.ToString(CultureInfo.InvariantCulture);
            using var request = CreateApiRequest(
                HttpMethod.Get,
                $"api/DepartmentMaster/delete?dptcode={Uri.EscapeDataString(code)}");
            using var response = await ClientFactory.CreateClient("MedicoAPI").SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                throw new HttpRequestException($"Department delete failed ({(int)response.StatusCode}): {error}");
            }

            ToastService.ShowSuccess("Department deleted successfully.");
            if (showModal)
            {
                showModal = false;
            }
            await LoadDepartments();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to delete department: {ex.Message}");
        }
    }

    private void RequestDeleteDepartment(DepartmentMasterModel department)
    {
        pendingDelete = department;
        showDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
        pendingDelete = null;
    }

    private async Task ConfirmDeleteDepartment()
    {
        if (pendingDelete is null)
        {
            return;
        }

        var department = pendingDelete;
        CancelDelete();
        await DeleteDepartment(department);
    }

    private HttpRequestMessage CreateApiRequest(HttpMethod method, string uri, HttpContent? content = null)
    {
        if (string.IsNullOrWhiteSpace(tenantCode))
        {
            throw new InvalidOperationException("Tenant code is unavailable.");
        }

        var request = new HttpRequestMessage(method, uri);
        request.Headers.TryAddWithoutValidation("tenant_code", tenantCode);
        request.Content = content;
        return request;
    }

    private int GetEffectiveUserCode()
    {
        if (TenantState.UserCode > 0) return TenantState.UserCode;
        if (TenantState.UserData?.UserCode is > 0) return TenantState.UserData.UserCode.Value;
        return 1;
    }

    private static string YesNo(bool? value) => value == true ? "Yes" : "No";

    private void CloseModal() => showModal = false;
}
