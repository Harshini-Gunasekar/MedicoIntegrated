    private string GetMimeType(string? fileName)
    {
        if (string.IsNullOrEmpty(fileName)) return "image/png";
        string ext = System.IO.Path.GetExtension(fileName).ToLower();
        return ext switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".webp" => "image/webp",
            ".gif" => "image/gif",
            _ => "image/png"
        };
    }

