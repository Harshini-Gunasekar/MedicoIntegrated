    private async Task LoadPrefixes()
    {
        try
        {
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}prefixes/getall");
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                try
                {
                    var list = new List<PrefixModel>();
                    var token = Newtonsoft.Json.Linq.JToken.Parse(content);
                    if (token is Newtonsoft.Json.Linq.JArray array)
                    {
                        foreach (var item in array)
                        {
                            if (item.Type == Newtonsoft.Json.Linq.JTokenType.Object)
                            {
                                var model = item.ToObject<PrefixModel>() ?? new();
                                // Better fallback: prioritize likely names and exclude tenant/code fields
                                if (string.IsNullOrEmpty(model.DisplayName))
                                {
                                    var likelyNames = new[] { "name", "prefix", "title", "text", "value" };
                                    var obj = (Newtonsoft.Json.Linq.JObject)item;
                                    foreach (var ln in likelyNames)
                                    {
                                        var p = obj.Property(ln, StringComparison.OrdinalIgnoreCase);
                                        if (p != null && p.Value.Type == Newtonsoft.Json.Linq.JTokenType.String)
                                        {
                                            model.name = p.Value.ToString();
                                            break;
                                        }
                                    }

                                    if (string.IsNullOrEmpty(model.DisplayName))
                                    {
                                        foreach (var prop in obj.Properties())
                                        {
                                            if (prop.Value.Type == Newtonsoft.Json.Linq.JTokenType.String &&
                                                !prop.Name.Contains("tenant", StringComparison.OrdinalIgnoreCase) &&
                                                !prop.Name.Contains("code", StringComparison.OrdinalIgnoreCase))
                                            {
                                                model.name = prop.Value.ToString();
                                                break;
                                            }
                                        }
                                    }
                                }
                                list.Add(model);
                            }
                            else if (item.Type == Newtonsoft.Json.Linq.JTokenType.String)
                            {
                                list.Add(new PrefixModel { name = item.ToString() });
                            }
                        }
                    }
                    prefixesList = list;
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Error parsing prefixes content: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading prefixes: {ex.Message}");
        }
    }

