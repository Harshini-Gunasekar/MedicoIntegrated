    private static string NormalizeMobileForComparison(string? m)
    {
        if (string.IsNullOrWhiteSpace(m)) return "";
        var digits = new string(m.Where(char.IsDigit).ToArray());
        if (digits.Length >= 10)
        {
            return digits.Substring(digits.Length - 10);
        }
        return digits;
    }

    private static string CleanNameForComparison(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        var s = name.Trim().ToLowerInvariant();
        string[] titles = { "mr.", "mr ", "mrs.", "mrs ", "ms.", "ms ", "dr.", "dr ", "master.", "master ", "baby.", "baby ", "selvi.", "selvi " };
        foreach (var t in titles)
        {
            if (s.StartsWith(t))
            {
                s = s.Substring(t.Length).Trim();
                break;
            }
        }
        return System.Text.RegularExpressions.Regex.Replace(s.Replace(".", " "), @"\s+", " ").Trim();
    }

    private static bool IsSamePatientName(string? n1, string? n2, string? init1 = null, string? init2 = null)
    {
        if (string.IsNullOrWhiteSpace(n1) || string.IsNullOrWhiteSpace(n2)) return false;
        var s1 = CleanNameForComparison(n1);
        var s2 = CleanNameForComparison(n2);
        if (string.IsNullOrEmpty(s1) || string.IsNullOrEmpty(s2)) return false;
        if (s1.Equals(s2, StringComparison.OrdinalIgnoreCase)) return true;

        var i1 = (init1 ?? "").Trim().ToLowerInvariant();
        var i2 = (init2 ?? "").Trim().ToLowerInvariant();

        if (!string.IsNullOrEmpty(i1) && CleanNameForComparison($"{i1} {s1}").Equals(s2, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(i2) && CleanNameForComparison($"{i2} {s2}").Equals(s1, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }

    private static bool IsDuplicatePatientRecord(CustomerModel c, CustomerModel cur)
    {
        if (c == null || cur == null) return false;
        if (c.custid > 0 && cur.custid > 0 && c.custid == cur.custid) return false;
        if (!string.IsNullOrEmpty(c.custcode) && !string.IsNullOrEmpty(cur.custcode) &&
            c.custcode.Equals(cur.custcode, StringComparison.OrdinalIgnoreCase)) return false;

        var m1 = NormalizeMobileForComparison(c.mobile);
        var m2 = NormalizeMobileForComparison(cur.mobile);
        if (string.IsNullOrEmpty(m1) || string.IsNullOrEmpty(m2) || m1.Length < 5 || m2.Length < 5)
            return false;
        if (m1.All(ch => ch == '0') || m2.All(ch => ch == '0'))
            return false;
        if (!m1.Equals(m2, StringComparison.OrdinalIgnoreCase))
            return false;

        // Both have same mobile, now check if name matches
        if (IsSamePatientName(c.name, cur.name, c.initial, cur.initial)) return true;
        if (IsSamePatientName(c.namewithinitials, cur.name, null, cur.initial)) return true;
        if (IsSamePatientName(c.name, cur.namewithinitials, c.initial, null)) return true;
        if (IsSamePatientName(c.namewithinitials, cur.namewithinitials)) return true;

        return false;
    }

    private async Task SaveCustomer()
    {
        if (isEditMode && !hasEditRight)
        {
            Toast.ShowError("Permission Denied: Role 389 (Edit Patient) required.");
            return;
        }
        if (!isEditMode && !hasCreateRight)
        {
            Toast.ShowError("Permission Denied: Role 388 (Create Patient) required.");
            return;
        }

        if (string.IsNullOrEmpty(TenantCode))
        {
            Toast.ShowError("Error: Tenant code is not loaded.");
            return;
        }

        if (string.IsNullOrWhiteSpace(current.initial))
        {
            Toast.ShowError("Please enter the mandatory field: Initial");
            return;
        }

        if (string.IsNullOrWhiteSpace(current.name))
        {
            Toast.ShowError("Please enter the mandatory field: Name");
            return;
        }

        if (current.ageyears < 0)
        {
            Toast.ShowError("Age (years) cannot be negative.");
            return;
        }

        if (!isEditMode && !string.IsNullOrWhiteSpace(current.mobile) && !string.IsNullOrWhiteSpace(current.name))
        {
            var trimmedMobile = current.mobile.Trim();
            var trimmedName = current.name.Trim();

            // 1. Check in local cache / loaded list
            var duplicate = allMyCustomers?.FirstOrDefault(c => IsDuplicatePatientRecord(c, current));

            if (duplicate == null && customers != null)
            {
                duplicate = customers.FirstOrDefault(c => IsDuplicatePatientRecord(c, current));
            }

            // 2. Query API search to verify across all records in database by mobile
            if (duplicate == null)
            {
                try
                {
                    using var verifyClient = CreateClient(true);
                    var digitsMobile = NormalizeMobileForComparison(trimmedMobile);
                    var searchKey = !string.IsNullOrEmpty(digitsMobile) ? digitsMobile : trimmedMobile;
                    var searchUrl = $"{BaseUrl}Customer/search?key={Uri.EscapeDataString(searchKey)}";
                    var searchRes = await verifyClient.GetAsync(searchUrl);
                    if (searchRes.IsSuccessStatusCode)
                    {
                        var json = await searchRes.Content.ReadAsStringAsync();
                        var searchList = JsonConvert.DeserializeObject<List<CustomerModel>>(json);
                        duplicate = searchList?.FirstOrDefault(c => IsDuplicatePatientRecord(c, current));
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[PatientMaster] Duplicate check search error: {ex.Message}");
                }
            }

            // 3. Fallback search by name if not found by mobile
            if (duplicate == null)
            {
                try
                {
                    using var verifyClient = CreateClient(true);
                    var searchUrl = $"{BaseUrl}Customer/search?key={Uri.EscapeDataString(trimmedName)}";
                    var searchRes = await verifyClient.GetAsync(searchUrl);
                    if (searchRes.IsSuccessStatusCode)
                    {
                        var json = await searchRes.Content.ReadAsStringAsync();
                        var searchList = JsonConvert.DeserializeObject<List<CustomerModel>>(json);
                        duplicate = searchList?.FirstOrDefault(c => IsDuplicatePatientRecord(c, current));
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[PatientMaster] Duplicate check search by name error: {ex.Message}");
                }
            }

            if (duplicate != null)
            {
                Toast.ShowWarning("Patient already registered with same name and mobile no");
                return;
            }
        }



        try
        {
            if (!string.IsNullOrWhiteSpace(current.initial))
            {
                current.initial = current.initial.Trim().ToUpper() + " ";
            }
            if (!string.IsNullOrWhiteSpace(current.name))
            {
                current.name = current.name.Trim();
            }
            if (!string.IsNullOrWhiteSpace(current.careofinitial))
            {
                current.careofinitial = current.careofinitial.Trim().ToUpper() + " ";
            }
            if (!string.IsNullOrWhiteSpace(current.careof))
            {
                current.careof = current.careof.Trim();
            }

            if (!string.IsNullOrWhiteSpace(current.nametitile))
            {
                current.namewithinitials = $"{current.nametitile}. {current.initial}{current.name}".Trim();
            }
            else
            {
                current.namewithinitials = $"{current.initial}{current.name}".Trim();
            }
            current.tenant_code = TenantCode;
            using var client = CreateClient(true);

            // 1. Create the Multipart Container
            using var content = new MultipartFormDataContent();

            // 2. Add all Text/Number fields from the model (flat and prefixed)
            foreach (var prop in current.GetType().GetProperties())
            {
                var value = prop.GetValue(current);

                // Skip image path fields (handled explicitly below)
                if (prop.Name == "customerimage") continue;

                if (value != null)
                {
                    string stringValue;
                    if (value is DateTime dt)
                    {
                        // Convert local time to UTC before saving to the database
                        var utcDt = dt.Kind == DateTimeKind.Utc ? dt : dt.ToUniversalTime();
                        stringValue = utcDt.ToString("yyyy-MM-ddTHH:mm:ss.fffZ");
                    }
                    else if (value is DateTimeOffset dto)
                    {
                        stringValue = dto.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ");
                    }
                    else
                    {
                        stringValue = value.ToString() ?? "";
                    }

                    // Add flat bindings
                    content.Add(new StringContent(stringValue), prop.Name);
                    
                    // Add CustomerModel. prefix
                    content.Add(new StringContent(stringValue), $"CustomerModel.{prop.Name}");

                    // Add Customer. prefix
                    content.Add(new StringContent(stringValue), $"Customer.{prop.Name}");
                }
            }
            
            // Add sendRegistrationSms parameter
            content.Add(new StringContent(sendRegistrationSms.ToString().ToLower()), "sendRegistrationSms");

            // 3. Add Image Files (If any are selected)
            if (selectedPhotoBytes != null && selectedPhotoBytes.Length > 0)
            {
                var fileContent1 = new ByteArrayContent(selectedPhotoBytes);
                fileContent1.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(GetMimeType(selectedPhotoName));
                content.Add(fileContent1, "customerImageFile", selectedPhotoName ?? "photo.png");

                var fileContent2 = new ByteArrayContent(selectedPhotoBytes);
                fileContent2.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(GetMimeType(selectedPhotoName));
                content.Add(fileContent2, "userImageFile", selectedPhotoName ?? "photo.png");
            }

            // Send alternative underscore/hyphen field variants for images if populated
            if (!string.IsNullOrEmpty(current.customerimage))
            {
                content.Add(new StringContent(current.customerimage), "customerimage");
                content.Add(new StringContent(current.customerimage), "customer_image");
                content.Add(new StringContent(current.customerimage), "userimage");
                content.Add(new StringContent(current.customerimage), "user_image");
                content.Add(new StringContent(current.customerimage), "CustomerModel.customerimage");
                content.Add(new StringContent(current.customerimage), "CustomerModel.customer_image");
                content.Add(new StringContent(current.customerimage), "Customer.customerimage");
                content.Add(new StringContent(current.customerimage), "Customer.customer_image");
            }


            // 4. Send the Request
            string endpoint = isEditMode ? "Customer/update" : "Customer/insert";
            var response = await client.PostAsync($"{BaseUrl}{endpoint}", content);
            var responseString = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"[PatientMaster Save/Update] Endpoint: {endpoint}, Response: {responseString}");

            if (response.IsSuccessStatusCode)
            {
                await LoadCustomers();
                showForm = false;
                selectedPhoto = null;
                selectedPhotoBytes = null;
                selectedPhotoName = null;
                previewPhotoBase64 = null;
                if (current != null)
                {
                    customerImagesBase64.Remove(current.custid);
                }
                Toast.ShowSuccess(isEditMode ? "Patient updated successfully!" : "Patient registered successfully!");
                StateHasChanged();
            }
            else
            {
                if (responseString.Contains("already exists", StringComparison.OrdinalIgnoreCase) ||
                    responseString.Contains("already registered", StringComparison.OrdinalIgnoreCase) ||
                    responseString.Contains("duplicate", StringComparison.OrdinalIgnoreCase) ||
                    responseString.Contains("unique constraint", StringComparison.OrdinalIgnoreCase))
                {
                    Toast.ShowWarning("Patient already registered with same name and mobile no");
                }
                else
                {
                    Toast.ShowError($"Save failed: {responseString}");
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error: {ex.Message}");
            StateHasChanged();
        }
    }

    private async Task SoftDeleteCustomer(long? customercode = null)
    {
        if (!hasDeleteRight)
        {
            Toast.ShowError("Permission Denied: Role 390 (Delete Patient) required.");
            return;
        }

        if (!customercode.HasValue && current != null)
        {
            customercode = current.custid;
        }
        if (!customercode.HasValue || customercode.Value == 0) return;

        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this customer?"))
        {
            try
            {
                using var client = CreateClient(true);
                // Endpoint changed from 'softdelete' to 'delete' and param from 'customercode' to 'custid'
                var url = $"{BaseUrl}Customer/delete?custid={customercode.Value}";
                var response = await client.GetAsync(url);
                response.EnsureSuccessStatusCode();
                await LoadCustomers();

                if (current != null && current.custid == customercode)
                {
                    showForm = false;
                }
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error deleting customer: {ex.Message}");
            }
        }
    }

