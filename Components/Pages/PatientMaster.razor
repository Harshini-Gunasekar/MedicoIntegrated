    private void NavigateToCustCode()
    {
        NavigationManager.NavigateTo("/customercustcodemaster");
    }
    private bool sendRegistrationSms = false;
    private List<CustomerModel> customers = new();
    private List<DoctorModel> doctors = new();
    private List<Booking.Models.BranchModel> branches = new();
    private List<AreaModel> areas = new();
    private List<CityModel> cities = new();
    private List<StateModel> states = new();
    private List<CountryModel> countries = new();
    private List<FeetypeModel> feeTypes = new();
    private List<PrefixModel> prefixesList = new()
    {
        new PrefixModel { name = "Mr." },
        new PrefixModel { name = "Mrs." },
        new PrefixModel { name = "Ms." },
        new PrefixModel { name = "Miss" },
        new PrefixModel { name = "Master" },
        new PrefixModel { name = "Dr." },
        new PrefixModel { name = "Baby" },
        new PrefixModel { name = "Baby of" },
        new PrefixModel { name = "Selvi" },
        new PrefixModel { name = "Selvan" },
        new PrefixModel { name = "Rev." },
        new PrefixModel { name = "Prof" },
        new PrefixModel { name = "Prof." },
        new PrefixModel { name = "Late" },
        new PrefixModel { name = "Sister" },
        new PrefixModel { name = "Swami" }
    };
    private IEnumerable<CustomerModel> FilteredCustomers =>
        displayActiveOnly ? customers.Where(c => c.deleted != true) : customers;

    private IEnumerable<CustomerModel> FilteredCustomersBySearch =>
        FilteredCustomers.Where(c =>
            string.IsNullOrWhiteSpace(SearchQuery) ||
            (c.name != null && c.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.namewithinitials != null && c.namewithinitials.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.mobile != null && c.mobile.Contains(SearchQuery)) ||
            (c.custcode != null && c.custcode.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.tenantcustcode != null && c.tenantcustcode.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.custid.ToString() == SearchQuery));


    private CustomerModel current = new();
    private List<CustomerModel> allMyCustomers = new();
    private string dobString
    {
        get => current?.dateofbirth?.ToString("yyyy-MM-dd") ?? "";
        set
        {
            if (DateTime.TryParseExact(value, "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var parsedDate))
            {
                current.dateofbirth = parsedDate;
                CalculateAge();
            }
            else if (string.IsNullOrWhiteSpace(value))
            {
                current.dateofbirth = null;
                CalculateAge();
            }
        }
    }
    private string BaseUrl => "api/";
    private bool isEditMode = false;
    private bool displayActiveOnly = true;
    private bool showForm = false;
    private bool showCustomerDropdown = false;
    private bool isLoadingData = false;
    
    private string _searchQuery = "";
    private string SearchQuery
    {
        get => _searchQuery;
        set
        {
            if (_searchQuery != value)
            {
                _searchQuery = value;
                CurrentPage = 1; // Reset to page 1 on search
            }
        }
    }

    private int CurrentPage = 1;
    private int PageSize = 10;
    private bool HasNextPage = true;

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";

    private string activeTab = "my"; // "my" is the default tab to view own tenant customers
    private bool showAllCustomersSetting = true;
    private int myCustomersCount = 0;
    private int allTenantsCount = 0;

    private bool hasViewRight = true;
    private bool hasCreateRight = false;
    private bool hasEditRight = false;
    private bool hasDeleteRight = false;

    private void EvaluateRights()
    {
        bool isAdmin = Booking.Helpers.UserPermissionHelper.IsAdmin(null, TenantState);
        if (isAdmin)
        {
            hasViewRight = true;
            hasCreateRight = true;
            hasEditRight = true;
            hasDeleteRight = true;
            return;
        }

        hasViewRight = RoleService.HasPermission(387) ||
                       RoleService.HasRight("OP Portal", "Patient Master") ||
                       TenantState.HasActionRight("OP Portal", "Patient Master", "View") ||
                       TenantState.HasActionRight("OP", "Patient Registration OP", "View") ||
                       TenantState.HasActionRight("OP", "Patient Master", "View");

        hasCreateRight = RoleService.HasPermission(388) ||
                         RoleService.HasAction("OP Portal", "Patient Master", "Create") ||
                         TenantState.HasActionRight("OP Portal", "Patient Master", "Create") ||
                         TenantState.HasActionRight("OP", "Patient Registration OP", "Create") ||
                         TenantState.HasActionRight("OP", "Patient Master", "Create");

        hasEditRight = RoleService.HasPermission(389) ||
                       RoleService.HasAction("OP Portal", "Patient Master", "Edit") ||
                       TenantState.HasActionRight("OP Portal", "Patient Master", "Edit") ||
                       TenantState.HasActionRight("OP", "Patient Registration OP", "Edit") ||
                       TenantState.HasActionRight("OP", "Patient Master", "Edit");

        hasDeleteRight = RoleService.HasPermission(390) ||
                         RoleService.HasAction("OP Portal", "Patient Master", "Delete") ||
                         TenantState.HasActionRight("OP Portal", "Patient Master", "Delete") ||
                         TenantState.HasActionRight("OP", "Patient Registration OP", "Delete") ||
                         TenantState.HasActionRight("OP", "Patient Master", "Delete");
    }

    protected override void OnInitialized()
    {
        TenantState.OnSessionChanged += HandleSessionChanged;
        RoleService.OnPermissionsChanged += HandlePermissionsChanged;
        EvaluateRights();
    }

    private void HandlePermissionsChanged()
    {
        InvokeAsync(async () =>
        {
            bool prevCanView = hasViewRight;
            EvaluateRights();
            if (prevCanView != hasViewRight && hasViewRight)
            {
                await LoadCounts();
                await LoadCustomers();
            }
            StateHasChanged();
        });
    }

    private void HandleSessionChanged()
    {
        InvokeAsync(async () =>
        {
            EvaluateRights();
            if (hasViewRight)
            {
                await LoadCounts();
                await LoadCustomers();
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TenantState.OnSessionChanged -= HandleSessionChanged;
        RoleService.OnPermissionsChanged -= HandlePermissionsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!RoleService.IsPermissionsLoaded && !Booking.Helpers.UserPermissionHelper.IsAdmin(null, TenantState))
            {
                try
                {
                    var sessionPerms = await _sessionStorage.GetAsync<List<Booking.Models.RolePermissionItem>>("UserRolePermissions");
                    if (sessionPerms.Success && sessionPerms.Value != null && sessionPerms.Value.Any())
                    {
                        RoleService.SetUserPermissions(sessionPerms.Value);
                    }
                    else if (TenantState.UserCode > 0)
                    {
                        await RoleService.LoadUserPermissionsAsync(TenantState.UserCode, TenantState.TenantCode);
                    }
                }
                catch
                {
                    if (TenantState.UserCode > 0)
                    {
                        await RoleService.LoadUserPermissionsAsync(TenantState.UserCode, TenantState.TenantCode);
                    }
                }
            }
            EvaluateRights();

            if (!hasViewRight)
            {
                StateHasChanged();
                return;
            }
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                Console.WriteLine($"[PatientMaster] Loaded session state: TenantCode='{TenantCode}', TokenLength={AuthToken?.Length ?? 0}");

                if (!string.IsNullOrEmpty(AuthToken))
                {

                    try
                    {
                        var setting = await LabSettingService.GetLabSettingAsync();
                        showAllCustomersSetting = setting?.show_all_customers ?? true;
                        if (showAllCustomersSetting)
                        {
                            activeTab = "all";
                        }
                        else
                        {
                            activeTab = "my";
                        }
                    }
                    catch { }

                    // Ensure the global state container is updated so HttpClient headers are injected
                    await LoadCounts();
                    await LoadCustomers();
                    await LoadDoctors();
                    await LoadBranches();
                    await LoadAreas();
                    await LoadCities();
                    await LoadStates();
                    await LoadCountries();
                    await LoadFeeTypes();
                    await LoadPrefixes();
                    StateHasChanged();
                }
                else
                {
                    Toast.ShowError("Access denied: Please log in again.");
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Session error: {ex.Message}");
                Console.Error.WriteLine($"Error getting tenant data: {ex.Message}");
                StateHasChanged();
            }
        }
    }

    private HttpClient CreateClient(bool isLabCare = false)
    {
        var clientName = isLabCare ? "LabCareUrl" : "DoctorApi";
        var client = ClientFactory.CreateClient(clientName);
        if (isLabCare)
        {
            if (!string.IsNullOrEmpty(TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }
        }
        return client;
    }

