            Console.Error.WriteLine($"Error loading cities: {ex.Message}");
        }
    }

    private async Task LoadStates()
    {
        if (string.IsNullOrEmpty(TenantCode)) return;
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}State/getall";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                states = await response.Content.ReadFromJsonAsync<List<StateModel>>() ?? new List<StateModel>();
            }
        }
        catch (Exception ex)
        {
