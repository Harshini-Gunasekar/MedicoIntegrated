    private class FileDownloadResponse
    {
        public string? fileName { get; set; }
        public string? base64 { get; set; }
    }

    private async Task LoadCustomerPhoto(long custId, string? fileName)
    {
        if (string.IsNullOrEmpty(fileName)) return;
        if (customerImagesBase64.ContainsKey(custId)) return;

        try
        {
            using var client = CreateClient(true);
            string key = fileName;
            if (!fileName.Contains("/"))
            {
                key = $"LabCare/{TenantCode}/customers/{custId}/{fileName}";
            }
            else if (!fileName.StartsWith("LabCare/", StringComparison.OrdinalIgnoreCase))
            {
                key = $"LabCare/{fileName}";
            }

            string url = $"{BaseUrl}files/download?key={Uri.EscapeDataString(key)}";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var jsonStr = await response.Content.ReadAsStringAsync();
                var downloadRes = JsonConvert.DeserializeObject<FileDownloadResponse>(jsonStr);
                if (downloadRes != null && !string.IsNullOrEmpty(downloadRes.base64))
                {
                    customerImagesBase64[custId] = downloadRes.base64;
                    StateHasChanged();
                    return;
                }
            }

            // Fallback without subfolders
            if (!fileName.Contains("/"))
            {
                string urlWithoutPrefix = $"{BaseUrl}files/download?key=LabCare/{TenantCode}/customers/{custId}/{fileName}";
                var response2 = await client.GetAsync(urlWithoutPrefix);
                if (response2.IsSuccessStatusCode)
                {
                    var jsonStr = await response2.Content.ReadAsStringAsync();
                    var downloadRes2 = JsonConvert.DeserializeObject<FileDownloadResponse>(jsonStr);
                    if (downloadRes2 != null && !string.IsNullOrEmpty(downloadRes2.base64))
                    {
                        customerImagesBase64[custId] = downloadRes2.base64;
                        StateHasChanged();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error downloading photo: {ex.Message}");
        }
    }

