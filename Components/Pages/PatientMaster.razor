@code {
    private List<CustomerModel> customers = new();
    private List<DoctorModel> doctors = new();
    private List<Booking.Models.BranchModel> branches = new();
    private List<AreaModel> areas = new();
    private List<CityModel> cities = new();
    private List<StateModel> states = new();
    private List<CountryModel> countries = new();
    private List<FeetypeModel> feeTypes = new();
    private List<PrefixModel> prefixesList = new();
    private IEnumerable<CustomerModel> FilteredCustomers =>
        displayActiveOnly ? customers.Where(c => c.deleted != true) : customers;

    private IEnumerable<CustomerModel> FilteredCustomersBySearch =>
        FilteredCustomers.Where(c =>
            string.IsNullOrWhiteSpace(SearchQuery) ||
            (c.name != null && c.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.mobile != null && c.mobile.Contains(SearchQuery)) ||
            (c.custcode != null && c.custcode.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.custid.ToString() == SearchQuery));


    private CustomerModel current = new();
    private string BaseUrl => "api/";
    private bool isEditMode = false;
    private bool displayActiveOnly = true;
    private bool showForm = false;
    private bool showCustomerDropdown = false;
    
    private string _searchQuery = "";
    private string SearchQuery
    {
        get => _searchQuery;
        set
        {
            if (_searchQuery != value)
            {
                _searchQuery = value;
                CurrentPage = 1; // Reset to page 1 on search
            }
        }
    }

    private int CurrentPage = 1;
    private int PageSize = 10;
    private bool HasNextPage = true;

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";

    protected override void OnInitialized()
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                Console.WriteLine($"[PatientMaster] Loaded session state: TenantCode='{TenantCode}', TokenLength={AuthToken?.Length ?? 0}");

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    // Ensure the global state container is updated so HttpClient headers are injected

                    await LoadCustomers();
                    await LoadDoctors();
                    await LoadBranches();
                    await LoadAreas();
                    await LoadCities();
                    await LoadStates();
                    await LoadCountries();
                    await LoadFeeTypes();
                    await LoadPrefixes();
                    StateHasChanged();
                }
                else
                {
                    Toast.ShowError("Access denied: Please log in again.");
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Session error: {ex.Message}");
                Console.Error.WriteLine($"Error getting tenant data: {ex.Message}");
                StateHasChanged();
            }
        }
    }

    private HttpClient CreateClient(bool isLabCare = false)
    {
        var clientName = isLabCare ? "LabCareUrl" : "DoctorApi";
        var client = ClientFactory.CreateClient(clientName);
        if (isLabCare)
        {
            if (!string.IsNullOrEmpty(TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }
        }
        return client;
    }

    private IBrowserFile? selectedPhoto;
    private byte[]? selectedPhotoBytes;
    private string? selectedPhotoName;
    private string? previewPhotoBase64;

    private Dictionary<long, string> customerImagesBase64 = new();

    private class FileDownloadResponse
    {
        public string? fileName { get; set; }
        public string? base64 { get; set; }
    }

    private async Task LoadCustomerPhoto(long custId, string? fileName)
    {
        if (string.IsNullOrEmpty(fileName)) return;
        if (customerImagesBase64.ContainsKey(custId)) return;

        try
        {
            using var client = CreateClient(true);
            string key = fileName;
            if (!fileName.Contains("/"))
            {
                key = $"LabCare/{TenantCode}/customers/{custId}/{fileName}";
            }
            else if (!fileName.StartsWith("LabCare/", StringComparison.OrdinalIgnoreCase))
            {
                key = $"LabCare/{fileName}";
            }

            string url = $"{BaseUrl}files/download?key={Uri.EscapeDataString(key)}";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var jsonStr = await response.Content.ReadAsStringAsync();
                var downloadRes = JsonConvert.DeserializeObject<FileDownloadResponse>(jsonStr);
                if (downloadRes != null && !string.IsNullOrEmpty(downloadRes.base64))
                {
                    customerImagesBase64[custId] = downloadRes.base64;
                    StateHasChanged();
                    return;
                }
            }

            // Fallback without subfolders
            if (!fileName.Contains("/"))
            {
                string urlWithoutPrefix = $"{BaseUrl}files/download?key=LabCare/{TenantCode}/customers/{custId}/{fileName}";
                var response2 = await client.GetAsync(urlWithoutPrefix);
                if (response2.IsSuccessStatusCode)
                {
                    var jsonStr = await response2.Content.ReadAsStringAsync();
                    var downloadRes2 = JsonConvert.DeserializeObject<FileDownloadResponse>(jsonStr);
                    if (downloadRes2 != null && !string.IsNullOrEmpty(downloadRes2.base64))
                    {
                        customerImagesBase64[custId] = downloadRes2.base64;
                        StateHasChanged();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error downloading photo: {ex.Message}");
        }
    }

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                selectedPhotoName = file.Name;
                current.customerimage = file.Name;

                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                selectedPhotoBytes = ms.ToArray();
                selectedPhoto = file;
                previewPhotoBase64 = Convert.ToBase64String(selectedPhotoBytes);
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error reading customer photo: {ex.Message}") */;
        }
        StateHasChanged();
    }

    private async Task LoadCustomers()
    {
        if (string.IsNullOrEmpty(TenantCode))
        {
            Toast.ShowError("Unauthorized access. Missing tenant context.");
            return;
        }
        try
        {
            using var client = CreateClient(true);
            // Using partition API as specified for better performance
            var url = $"{BaseUrl}Customer/partition?pagenumber={CurrentPage}&pagesize={PageSize}";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var list = await response.Content.ReadFromJsonAsync<List<CustomerModel>>() ?? new List<CustomerModel>();
                customers = list;
                HasNextPage = list.Count == PageSize;
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Toast.ShowError($"Error loading customers ({response.StatusCode}): {errorBody}");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error loading customers: {ex.Message}");
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteServerSearch();
        }
    }

    private async Task ExecuteServerSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery))
        {
            CurrentPage = 1;
            await LoadCustomers();
            return;
        }

        try
        {
            using var client = CreateClient(true);
            var response = await client.GetAsync($"{BaseUrl}Customer/search?key={Uri.EscapeDataString(SearchQuery)}");
            if (response.IsSuccessStatusCode)
            {
                customers = await response.Content.ReadFromJsonAsync<List<CustomerModel>>() ?? new List<CustomerModel>();
            }
            else
            {
                Console.Error.WriteLine("Search failed: " + await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error during search: {ex.Message}");
        }
    }


    private async Task LoadDoctors()
    {
        if (string.IsNullOrEmpty(TenantCode))
        {
            return;
        }
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}Doctor/get";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                doctors = await response.Content.ReadFromJsonAsync<List<DoctorModel>>() ?? new List<DoctorModel>();
            }
            else
            {
                Console.Error.WriteLine($"Error loading doctors: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading doctors: {ex.Message}");
        }
    }

    private async Task LoadBranches()
    {
        if (string.IsNullOrEmpty(TenantCode)) return;
