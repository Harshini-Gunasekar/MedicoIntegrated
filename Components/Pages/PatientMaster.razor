    private string FormatToIst(DateTime? dt)
    {
        if (dt == null || dt == DateTime.MinValue) return "-";
        return dt.ToIndianTime()?.ToString("dd-MM-yyyy hh:mm tt") ?? "-";
    }

    private string FormatAge(int? years, int? months, int? days)
    {
        if (years.HasValue && years.Value > 0) return $"{years.Value} Y";
        if (months.HasValue && months.Value > 0) return $"{months.Value} M";
        if (days.HasValue && days.Value > 0) return $"{days.Value} D";
        return "-";
    }

    private bool IsChild(int? years, int? months, int? days)
    {
        if (years.HasValue && years.Value > 0) return years.Value < 12;
        if ((months.HasValue && months.Value > 0) || (days.HasValue && days.Value > 0)) return true;
        return false;
    }

    private string GetGenderAvatarClass(string? gender, int? years, int? months, int? days)
    {
        if (IsChild(years, months, days)) return "child";
        if (string.Equals(gender?.Trim(), "Male", StringComparison.OrdinalIgnoreCase)) return "male";
        if (string.Equals(gender?.Trim(), "Female", StringComparison.OrdinalIgnoreCase)) return "female";
        return "default";
    }

