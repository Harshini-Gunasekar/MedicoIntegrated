    private async Task FillAreaDetails(int? areacode)
    {
        if (areacode == null || areacode == 0)
        {
            current.area = string.Empty;
            current.zipcode = string.Empty;
            current.city = string.Empty;
            current.state = string.Empty;
            current.country = string.Empty;
            StateHasChanged();
            return;
        }

        // Ensure reference lists are loaded before lookup
        if (cities == null || !cities.Any()) await LoadCities();
        if (states == null || !states.Any()) await LoadStates();
        if (countries == null || !countries.Any()) await LoadCountries();

        var selectedArea = areas?.FirstOrDefault(a => a.areacode == areacode.Value);
        if (selectedArea != null)
        {
            current.area = selectedArea.areaname;
            current.zipcode = selectedArea.areapincode;

            // Lookup city, state and country names from cached lists using codes on AreaModel
            // handle nullable codes safely
            var city = (selectedArea.citycode.HasValue)
                ? cities?.FirstOrDefault(c => c.citycode == selectedArea.citycode.Value)
                : null;
            current.city = city?.cityname ?? string.Empty;

            var state = (selectedArea.statecode.HasValue)
                ? states?.FirstOrDefault(s => s.statecode == selectedArea.statecode.Value)
                : null;
            current.state = state?.statename ?? string.Empty;

            var country = (selectedArea.countrycode.HasValue)
                ? countries?.FirstOrDefault(cn => cn.countrycode == selectedArea.countrycode.Value)
                : null;
            current.country = country?.countryname ?? string.Empty;
        }
        else
        {
            current.area = string.Empty;
            current.zipcode = string.Empty;
            current.city = string.Empty;
            current.state = string.Empty;
            current.country = string.Empty;
        }

        StateHasChanged();
    }

