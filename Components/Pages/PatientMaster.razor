    private async Task LoadCustomers()
    {
        if (!hasViewRight)
        {
            isLoadingData = false;
            return;
        }

        if (string.IsNullOrEmpty(TenantCode))
        {
            Toast.ShowError("Unauthorized access. Missing tenant context.");
            return;
        }
        isLoadingData = true;
        StateHasChanged();
        try
        {
            using var client = CreateClient(true);
            if (activeTab == "my")
            {
                if (allMyCustomers.Any() && CurrentPage > 1)
                {
                    customers = allMyCustomers.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
                    HasNextPage = allMyCustomers.Count > CurrentPage * PageSize;
                }
                else
                {
                    var response = await client.GetAsync($"{BaseUrl}customer/getcus");
                    var jsonStr = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"[PatientMaster Load] My Customers Response: {jsonStr}");
                    if (response.IsSuccessStatusCode)
                    {
                        var list = JsonConvert.DeserializeObject<List<CustomerModel>>(jsonStr) ?? new List<CustomerModel>();
                        allMyCustomers = list;
                        myCustomersCount = list.Count;
                        customers = allMyCustomers.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
                        HasNextPage = allMyCustomers.Count > CurrentPage * PageSize;
                    }
                    else
                    {
                        Toast.ShowError($"Error loading tenant customers ({response.StatusCode}): {jsonStr}");
                    }
                }
            }
            else
            {
                // Using partition API as specified for better performance
                var url = $"{BaseUrl}Customer/partition?pagenumber={CurrentPage}&pagesize={PageSize}";
                var response = await client.GetAsync(url);
                var jsonStr = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[PatientMaster Load] Partition Response: {jsonStr}");
                if (response.IsSuccessStatusCode)
                {
                    var list = JsonConvert.DeserializeObject<List<CustomerModel>>(jsonStr) ?? new List<CustomerModel>();
                    customers = list;
                    HasNextPage = list.Count == PageSize;
                }
                else
                {
                    Toast.ShowError($"Error loading customers ({response.StatusCode}): {jsonStr}");
                }
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error loading customers: {ex.Message}");
        }
        finally
        {
            isLoadingData = false;
            StateHasChanged();
        }
    }

