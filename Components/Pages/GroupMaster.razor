@page "/groups"
@page "/group-master"
@rendermode InteractiveServer

@using Booking.Models
@using Booking.Services
@using Booking.Helpers
@inject GroupMasterService GroupService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">list_alt</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Group Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Classification Inventory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search groups..." @bind="SearchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            <div class="search-controls">
                @if (TenantState.HasActionRight("Configuration", "General", "Create")) {
            <button class="btn-new-entry" @onclick="NewGroup">+ Add New</button>
            }
            </div>
        </div>
    </div>

    @* --- directory list --- *@
    <div class="directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">ORDER NO</th>
                        <th style="width: 130px;">SHORT NAME</th>
                        <th>GROUP NAME</th>
                        <th style="width: 100px;">DCODE</th>
                        <th style="width: 150px;">DEPT. CODE</th>
                        <th>STATUS / FLAGS</th>
                        <th style="width: 180px;">ENTERED DATE</th>
                        <th style="width: 180px;">MODIFIED DATE</th>
                        <th class="text-center" style="width: 120px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (groups != null && groups.Any())
                    {
                        @foreach (var g in FilteredGroupsBySearch)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"{g.orderno:00}")</span></td>
                                <td class="lc-color-slate-500 lc-font-mono lc-font-700 lc-font-13">@g.shortname</td>
                                <td class="font-bold text-slate-800">@g.name</td>
                                <td><span class="lc-color-slate-600 font-bold">@(g.dcode?.ToString("0") ?? "-")</span></td>
                                <td><span class="lc-color-slate-600 font-bold">@(g.departmentcode?.ToString("0") ?? "-")</span></td>
                                <td>
                                    <div class="display-flex flex-wrap gap-4" style="flex-wrap: wrap;">
                                        @if (g.islab == true) { <span class="flag-badge bg-lab">LAB</span> }
                                        @if (g.isscan == true) { <span class="flag-badge bg-scan">SCAN</span> }
                                        @if (g.ischarges == true) { <span class="flag-badge bg-charges">CHARGES</span> }
                                        @if (g.isinventory == true) { <span class="flag-badge bg-inventory">INVENTORY</span> }
                                        @if (g.ispackage == true) { <span class="flag-badge bg-package">PACKAGE</span> }
                                        @if (g.istreatment == true) { <span class="flag-badge bg-treatment">TREATMENT</span> }
                                    </div>
                                </td>
                                <td class="text-slate-400 font-12">@(FormatToIst(g.entereddate))</td>
                                <td class="text-slate-400 font-12">@(FormatToIst(g.ibsdate))</td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px;">
                                        @if (OnSelect.HasDelegate)
                                        {
                                            <button type="button" class="lc-btn lc-circle-btn-32" style="width: auto !important; padding: 0 10px !important; border-radius: 6px; font-size: 0.75rem; background: #4f46e5; color: #ffffff;" @onclick="() => OnSelect.InvokeAsync(g.gcode)" title="Select">Select</button>
                                        }
                                        @if (TenantState.HasActionRight("Configuration", "General", "Edit")) {
                                            <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => EditGroup(g)" title="Edit">
                                            <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                        </button>
                                        }
                                        @if (TenantState.HasActionRight("Configuration", "General", "Delete")) {
                                            <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => DeleteGroup(g.gcode)" title="Delete">
                                            <span class="material-symbols-outlined font-18 text-slate-400">delete</span>
                                        </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center p-48 text-slate-400 italic">No group records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- FORM SECTION (Modal) --- *@
@if (showForm)
{
    <div class="modal-overlay">
        <div class="modal-form-card">
            <div class="modal-header-bar">
                <h3>@(isEditMode ? "Edit Group" : "New Group Entry")</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-0 form-section">
                    <div class="mt-0">
                        @* Line 1: Group Name *@
                        <div class="um-grid-row">
                            <div class="form-group position-relative">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label style="margin-bottom: 0;">Group name *</label>
                                    @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                    {
                                        <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                    }
                                </div>
                                <input type="text" class="lab-input" @bind="current.name" placeholder="e.g. Biochemistry" required />
                            </div>
                        </div>

                        @* Line 2: Order no, Short Name, DCode, Dept. Code *@
                        <div class="um-grid-cols-4">
                            <div class="form-group">
                                <label>Order no</label>
                                <input type="number" class="lab-input" @bind="current.orderno" />
                            </div>
                            <div class="form-group">
                                <label>Short Name</label>
                                <input type="text" class="lab-input" @bind="current.shortname" placeholder="e.g. BIOCHEM" />
                            </div>
                            <div class="form-group">
                                <label>DCode</label>
                                <input type="number" class="lab-input" @bind="current.dcode" />
                            </div>
                            <div class="form-group">
                                <label>Dept. Code</label>
                                <input type="number" class="lab-input" @bind="current.departmentcode" />
                            </div>
                        </div>

                        @* Line 3: Description, Footer *@
                        <div class="um-grid-cols-2">
                            <div class="form-group">
                                <label>Description</label>
                                <input type="text" class="lab-input" @bind="current.description" placeholder="e.g. Biochemistry test group" />
                            </div>
                            <div class="form-group">
                                <label>Footer</label>
                                <input type="text" class="lab-input" @bind="current.footer" placeholder="e.g. End of biochemistry report" />
                            </div>
                        </div>

                        @* Line 4: Checkboxes Section *@
                        <div class="flags-card">
                            <div class="flags-header">
                                <span class="material-symbols-outlined flags-header-icon">settings</span>
                                <span>Group Settings & Flags</span>
                            </div>
                            <div class="flags-grid">
                                <label class="flag-item">
                                    <input type="checkbox" @bind="current.islab" />
                                    <span>Is Lab</span>
                                </label>
                                <label class="flag-item">
                                    <input type="checkbox" @bind="current.isscan" />
                                    <span>Is Scan</span>
                                </label>
                                <label class="flag-item">
                                    <input type="checkbox" @bind="current.ischarges" />
                                    <span>Is Charges</span>
                                </label>
                                <label class="flag-item">
                                    <input type="checkbox" @bind="current.isinventory" />
                                    <span>Is Inventory</span>
                                </label>
                                <label class="flag-item">
                                    <input type="checkbox" @bind="current.ispackage" />
                                    <span>Is Package</span>
                                </label>
                                <label class="flag-item">
                                    <input type="checkbox" @bind="current.istreatment" />
                                    <span>Is Treatment</span>
                                </label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            
            <div class="modal-footer-bar">
                <button type="button"
                        class="btn-delete"
                        @onclick="() => DeleteGroup(current.gcode)"
                        disabled="@(current.gcode == 0)">
                    Delete
                </button>
                <button type="button" class="btn-save" @onclick="SaveGroup">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                    </svg>
                    Save Group
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<decimal> OnSelect { get; set; }

    private string FormatToIst(DateTime? dt)
    {
        if (dt == null || dt == DateTime.MinValue) return "-";
        return dt.ToIndianTime()?.ToString("dd-MM-yyyy hh:mm tt") ?? "-";
    }

    private List<Booking.Models.GroupMasterModel> groups = new();
    private Booking.Models.GroupMasterModel current = new();
    private bool isEditMode = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";

    private IEnumerable<Booking.Models.GroupMasterModel> FilteredGroups =>
        groups.Where(g => !g.deleted);

    private IEnumerable<Booking.Models.GroupMasterModel> FilteredGroupsBySearch =>
        FilteredGroups.Where(g => 
            string.IsNullOrWhiteSpace(SearchQuery) || 
            (g.name != null && g.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (g.shortname != null && g.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (g.description != null && g.description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadGroups();
    }

    private async Task LoadGroups()
    {
        try
        {
            groups = await GroupService.GetGroupMastersAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading groups: {ex.Message}");
        }
    }

    private void NewGroup()
    {
        current = new Booking.Models.GroupMasterModel { 
            deleted = false,
            computercode = 1,
            usercode = 1,
            entereddate = DateTime.Now,
            ibsdate = DateTime.Now,
            orderno = groups.Count + 1,
            tenant_code = "TEN007",
            dcode = 1,
            departmentcode = 1,
            islab = true,
            isscan = false,
            ischarges = true,
            isinventory = false,
            ispackage = false,
            istreatment = false
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private void EditGroup(Booking.Models.GroupMasterModel g)
    {
        if (g == null) return;
        current = new Booking.Models.GroupMasterModel
        {
            gcode = g.gcode,
            tenant_code = g.tenant_code,
            dcode = g.dcode,
            orderno = g.orderno,
            shortname = g.shortname,
            name = g.name,
            description = g.description,
            footer = g.footer,
            departmentcode = g.departmentcode,
            isscan = g.isscan,
            islab = g.islab,
            deleted = g.deleted,
            usercode = g.usercode,
            computercode = g.computercode,
            entereddate = g.entereddate,
            ibsdate = g.ibsdate,
            ischarges = g.ischarges,
            isinventory = g.isinventory,
            ispackage = g.ispackage,
            istreatment = g.istreatment
        };
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveGroup()
    {
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(current.name))
        {
            ToastService.ShowError("Group Name is required.");
            StateHasChanged();
            return;
        }

        try
        {
            current.tenant_code = "TEN007";
            current.computercode = 1;
            current.usercode = 1;
            current.ibsdate = DateTime.Now;

            bool success;
            if (isEditMode)
            {
                success = await GroupService.UpdateGroupMasterAsync(current);
            }
            else
            {
                current.entereddate = DateTime.Now;
                success = await GroupService.InsertGroupMasterAsync(current);
            }

            if (success)
            {
                await LoadGroups();
                ToastService.ShowSuccess(isEditMode ? "Group updated successfully!" : "Group added successfully!");
                showForm = false;
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Save failed on backend.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving group: {ex.Message}");
            StateHasChanged();
        }
    }

    private async Task DeleteGroup(decimal gcode)
    {
        if (gcode == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this group?"))
        {
            try
            {
                bool success = await GroupService.DeleteGroupMasterAsync(gcode);
                if (success)
                {
                    await LoadGroups();
                    ToastService.ShowSuccess("Group deleted successfully!");
                    if (current != null && current.gcode == gcode)
                    {
                        showForm = false;
                    }
                    StateHasChanged();
                }
                else
                {
                    ToastService.ShowError("Delete failed on backend.");
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error deleting: {ex.Message}");
                StateHasChanged();
            }
        }
    }

    private void CloseForm()
    {
        current = new Booking.Models.GroupMasterModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }
}
