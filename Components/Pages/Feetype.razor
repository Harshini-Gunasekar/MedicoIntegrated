@page "/feetype-master"
@rendermode InteractiveServer
@using Medico_Backend.Model
@using Booking.Services
@inject FeetypeService FeeService
@inject ToastService ToastService

<div class="cm-page">
    <!-- Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <h1 class="cm-title">Fee Type Master</h1>
            <span class="cm-subtitle">Billing Configuration</span>
        </div>
        <div class="cm-header-right">
            <div class="cm-search-box">
                <i class="bi bi-search cm-search-icon"></i>
                <input type="text" class="cm-search-input" placeholder="Quick find..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            <button class="cm-btn-new" @onclick="OpenNewFeeTypeModal">
                + New Fee Type Entry
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="cm-table-card">
        <table class="cm-table">
            <thead>
                <tr>
                    <th>ORDER NO</th>
                    <th>SHORT NAME</th>
                    <th>FEE TYPE NAME</th>
                    <th>COMMISSION %</th>
                    <th>RATE TYPE</th>
                    <th>NARRATION</th>
                    <th>ENTERED DATE</th>
                    <th>MODIFIED DATE</th>
                    <th>ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredFeeTypes.Any())
                {
                    @foreach (var item in FilteredFeeTypes)
                    {
                        <tr>
                            <td class="col-orderno">@item.orderno</td>
                            <td class="col-shortname">@item.shortname</td>
                            <td class="col-name">
                                <span class="counter-name-text">@item.name</span>
                            </td>
                            <td class="col-commission">@(item.commissionpercentage?.ToString("F1") ?? "0.0")%</td>
                            <td class="col-ratetype">
                                <span class="rate-type-badge @GetRateTypeClass(item)">@GetRateTypeDisplayName(item)</span>
                            </td>
                            <td class="col-narration">@item.description</td>
                            <td class="col-date-entered">
                                <span class="date-line">@item.entereddate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.entereddate.ToString("tt") == "AM" ? "am" : "pm")">@item.entereddate.ToString("tt")</span>
                            </td>
                            <td class="col-date-modified">
                                <span class="date-line">@item.ibsdate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.ibsdate.ToString("tt") == "AM" ? "am" : "pm")">@item.ibsdate.ToString("tt")</span>
                            </td>
                            <td class="col-action">
                                <button class="cm-action-btn edit" title="Edit" @onclick="() => EditFeeType(item)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="cm-action-btn delete" title="Delete" @onclick="() => DeleteFeeType(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="cm-empty-row">
                            <i class="bi bi-display"></i>
                            <div>No fee types found</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showModal)
{
    <div class="cm-backdrop">
        <div class="cm-modal">
            <div class="cm-modal-header">
                <h2 class="cm-modal-title">@(isEditMode ? "Edit Fee Type Entry" : "New Fee Type Entry")</h2>
                <button class="cm-close-btn" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body">
                <!-- Fee Type Name - full width -->
                <div class="cm-field-group">
                    <label class="cm-label">Fee Type Name</label>
                    <input type="text" class="cm-input" placeholder="Ex: Consultation Fee" @bind="currentFeeType.name" />
                </div>

                <!-- Row: Display Order, Short Name, Commission Percentage -->
                <div class="cm-form-row three-cols">
                    <div class="cm-field-group">
                        <label class="cm-label">Display Order</label>
                        <input type="text" class="cm-input" placeholder="20" @bind="displayOrderString" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Short Name</label>
                        <input type="text" class="cm-input" placeholder="Ex: CONS" @bind="currentFeeType.shortname" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Commission Percentage (%)</label>
                        <input type="number" step="0.1" class="cm-input" placeholder="10.0" @bind="currentFeeType.commissionpercentage" />
                    </div>
                </div>

                <!-- Row: Rate Type & Description -->
                <div class="cm-form-row" style="grid-template-columns: 1fr 2fr;">
                    <div class="cm-field-group">
                        <label class="cm-label">Rate Type</label>
                        <select class="cm-input cm-select" @bind="selectedRateType">
                            <option value="Commission">Commission Rate</option>
                            <option value="Scheme">Scheme Rate</option>
                            <option value="Special">Special Rate</option>
                            <option value="IC">IC Rate</option>
                        </select>
                    </div>
                    <div class="cm-field-group desc-field">
                        <label class="cm-label">Description</label>
                        <input type="text" class="cm-input" placeholder="Specify any specific instructions..." @bind="currentFeeType.description" />
                    </div>
                </div>
            </div>

            <div class="cm-modal-footer">
                @if (isEditMode)
                {
                    <button class="cm-btn-delete" @onclick="() => DeleteFeeType(currentFeeType)">Delete</button>
                }
                else
                {
                    <span></span>
                }
                <div class="cm-footer-right-buttons" style="display: flex; gap: 0.75rem; align-items: center;">
                    <button class="cm-btn-cancel" @onclick="CloseModal">Cancel</button>
                    <button class="cm-btn-save" @onclick="SaveFeeType">
                        <i class="bi bi-check2"></i> Save Fee Type
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<FeeTypeMasterModel> feetypes = new();
    private string searchQuery = "";
    private bool showModal = false;
    private bool isEditMode = false;
    private FeeTypeMasterModel currentFeeType = new();
    private string selectedRateType = "Commission";

    private string displayOrderString
    {
        get => currentFeeType.orderno == 0 ? "" : currentFeeType.orderno.ToString();
        set => currentFeeType.orderno = int.TryParse(value, out var v) ? v : 0;
    }

    private IEnumerable<FeeTypeMasterModel> FilteredFeeTypes =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? feetypes
            : feetypes.Where(f => 
                (f.name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (f.shortname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadFeeTypes();
    }

    private async Task LoadFeeTypes()
    {
        try
        {
            var res = await FeeService.GetFeeTypesAsync();
            if (res != null)
            {
                feetypes = res.OrderBy(f => f.orderno).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load fee types: {ex.Message}");
        }
    }

    private void OpenNewFeeTypeModal()
    {
        currentFeeType = new FeeTypeMasterModel { orderno = 0 };
        selectedRateType = "Commission";
        isEditMode = false;
        showModal = true;
    }

    private void EditFeeType(FeeTypeMasterModel feetype)
    {
        currentFeeType = new FeeTypeMasterModel
        {
            ftcode = feetype.ftcode,
            name = feetype.name,
            shortname = feetype.shortname,
            orderno = feetype.orderno,
            description = feetype.description,
            commissionpercentage = feetype.commissionpercentage,
            tenant_code = feetype.tenant_code,
            iscommission = feetype.iscommission,
            isscheme = feetype.isscheme,
            isspecial = feetype.isspecial,
            isic = feetype.isic
        };

        if (feetype.iscommission == true)
            selectedRateType = "Commission";
        else if (feetype.isscheme == true)
            selectedRateType = "Scheme";
        else if (feetype.isspecial == true)
            selectedRateType = "Special";
        else if (feetype.isic == true)
            selectedRateType = "IC";
        else
            selectedRateType = "Commission";

        isEditMode = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveFeeType()
    {
        try
        {
            currentFeeType.iscommission = (selectedRateType == "Commission");
            currentFeeType.isscheme = (selectedRateType == "Scheme");
            currentFeeType.isspecial = (selectedRateType == "Special");
            currentFeeType.isic = (selectedRateType == "IC");

            bool success;
            if (isEditMode)
            {
                success = await FeeService.UpdateFeeTypeAsync(currentFeeType);
            }
            else
            {
                currentFeeType.entereddate = DateTime.Now;
                currentFeeType.ibsdate = DateTime.Now;
                currentFeeType.tenant_code = "TEN1011";
                success = await FeeService.InsertFeeTypeAsync(currentFeeType);
            }

            if (success)
            {
                ToastService.ShowSuccess("Fee type saved successfully.");
                showModal = false;
                await LoadFeeTypes();
            }
            else
            {
                ToastService.ShowError("Failed to save fee type.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private string GetRateTypeDisplayName(FeeTypeMasterModel feetype)
    {
        if (feetype.iscommission == true) return "Commission";
        if (feetype.isscheme == true) return "Scheme";
        if (feetype.isspecial == true) return "Special";
        if (feetype.isic == true) return "IC";
        return "None";
    }

    private string GetRateTypeClass(FeeTypeMasterModel feetype)
    {
        if (feetype.iscommission == true) return "commission";
        if (feetype.isscheme == true) return "scheme";
        if (feetype.isspecial == true) return "special";
        if (feetype.isic == true) return "ic";
        return "none";
    }

    private async Task DeleteFeeType(FeeTypeMasterModel feetype)
    {
        try
        {
            bool success = await FeeService.DeleteFeeTypeAsync(feetype.ftcode);
            if (success)
            {
                ToastService.ShowSuccess("Fee type deleted successfully.");
                if (showModal) showModal = false;
                await LoadFeeTypes();
            }
            else
            {
                ToastService.ShowError("Failed to delete fee type.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }
}
