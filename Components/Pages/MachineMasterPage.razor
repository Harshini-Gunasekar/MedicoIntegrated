@page "/machine-master"
@using LIMS_Backend.Model
@using Medico_Backend.Model
@using Newtonsoft.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject LabCare.Services.TestService TestSvc
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Booking.Services.ToastService Toast

<div class="referral-page lc-fadeInUp">
    <div class="lab-header-card flex-between">
        <div class="gap-16 display-flex align-center">
            <div class="p-2 bg-indigo-50 rounded-lg shadow-sm flex-center icon-box-container" style="background: #4f46e5 !important;">
                <span class="text-white material-symbols-outlined icon-lg">developer_board</span>
            </div>
            <div>
                <h2 class="m-0 lab-title-text">Machine Master</h2>
                <div class="gap-8 flex-start mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Analyzers & Device Interfaces</span>
                </div>
            </div>
        </div>
        <div class="gap-12 display-flex align-center">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search machines..." @bind="SearchQuery" @bind:event="oninput" class="search-input" />
            </div>
            @if (TenantState.HasActionRight("Configuration", "General", "Create"))
            {
                <div class="search-controls">
                    <button class="btn-new-entry" @onclick="NewMachine">+ Add New</button>
                </div>
            }
        </div>
    </div>

    @if (showForm)
    {
        <div class="modal-overlay">
            <div class="modal-form-card" style="max-width: 750px;">
                <div class="modal-header-bar" style="background: linear-gradient(135deg, #5c5cfc 0%, #4f46e5 100%) !important;">
                    <h3>@(isEditMode ? "Edit Machine / Analyzer" : "New Machine Entry")</h3>
                    <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                        </svg>
                    </button>
                </div>
                
                <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                    <div class="mb-0 form-section">
                        <div class="um-grid-row">
                            <div class="form-group position-relative">
                                <label>Machine / Analyzer Name <span class="text-danger">*</span></label>
                                <input type="text" class="lab-input" @bind="current.name" placeholder="E.g. Beckman Coulter Access 2" required />
                            </div>
                        </div>

                        <div class="um-grid-cols-3">
                            <div class="form-group">
                                <label>Short Name <span class="text-danger">*</span></label>
                                <input type="text" class="lab-input" @bind="current.shortname" placeholder="E.g. BC_ACC2" />
                            </div>
                            <div class="form-group">
                                <label>Order No <span class="text-danger">*</span></label>
                                <input type="number" class="lab-input" @bind="current.orderno" placeholder="1" />
                            </div>
                            <div class="form-group">
                                <label>Manufacturer</label>
                                <input type="text" class="lab-input" @bind="current.manufacturer" placeholder="E.g. Beckman Coulter" />
                            </div>
                        </div>

                        <div class="um-grid-cols-2 mt-3">
                            <div class="form-group">
                                <label>Model Number / Type</label>
                                <input type="text" class="lab-input" @bind="current.model" placeholder="E.g. Access 2" />
                            </div>
                            <div class="form-group">
                                <label>Description / Narration</label>
                                <input type="text" class="lab-input" @bind="current.description" placeholder="E.g. Immunoassay System" />
                            </div>
                        </div>

                        <hr style="border: 0; border-top: 1px solid #e2e8f0; margin: 24px 0 16px 0;" />

                        <div style="font-weight: 700; color: #4f46e5; margin-bottom: 12px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                            <span class="material-symbols-outlined">settings_ethernet</span> Connection & Communication Mode
                        </div>

                        <div class="um-grid-cols-3 mb-4">
                            <div class="form-group display-flex align-center gap-8 cursor-pointer config-card" @onclick="() => ToggleOption(1)">
                                <input type="checkbox" checked="@(current.optrs232 == true)" />
                                <span class="config-card-text">RS232 Serial</span>
                            </div>
                            <div class="form-group display-flex align-center gap-8 cursor-pointer config-card" @onclick="() => ToggleOption(2)">
                                <input type="checkbox" checked="@(current.opttcp == true)" />
                                <span class="config-card-text">TCP / IP Connection</span>
                            </div>
                            <div class="form-group display-flex align-center gap-8 cursor-pointer config-card" @onclick="() => ToggleOption(3)">
                                <input type="checkbox" checked="@(current.optlmport == true)" />
                                <span class="config-card-text">File Import / Folder Watch</span>
                            </div>
                        </div>

                        @if (current.opttcp == true)
                        {
                            <div class="um-grid-cols-2 mb-4 tcp-mode-container">
                                <div class="form-group display-flex align-center gap-8 cursor-pointer" @onclick="() => SetTcpMode(true)">
                                    <input type="radio" name="tcpMode" checked="@(current.opttcpclient == true)" />
                                    <span class="tcp-mode-text">TCP Client Mode</span>
                                </div>
                                <div class="form-group display-flex align-center gap-8 cursor-pointer" @onclick="() => SetTcpMode(false)">
                                    <input type="radio" name="tcpMode" checked="@(current.opttcpserver == true)" />
                                    <span class="tcp-mode-text">TCP Server Mode</span>
                                </div>
                            </div>
                        }

                        @if (current.optrs232 == true)
                        {
                            <div class="config-sub-card rs232-card">
                                <div class="config-sub-card-title rs232-title">
                                    <span class="material-symbols-outlined font-18">tune</span> RS232 Serial Port Configuration
                                </div>
                                <div class="um-grid-cols-3">
                                    <div class="form-group">
                                        <label>Port Name / Number</label>
                                        <input type="text" class="lab-input" @bind="current.portnumber" placeholder="COM1" />
                                    </div>
                                    <div class="form-group">
                                        <label>Baud Rate</label>
                                        <select class="lab-input" @bind="current.baudrate">
                                            <option value="">-- Select --</option>
                                            <option value="1200">1200</option>
                                            <option value="2400">2400</option>
                                            <option value="4800">4800</option>
                                            <option value="9600">9600</option>
                                            <option value="19200">19200</option>
                                            <option value="38400">38400</option>
                                            <option value="57600">57600</option>
                                            <option value="115200">115200</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>Parity</label>
                                        <select class="lab-input" @bind="current.parity">
                                            <option value="">-- Select --</option>
                                            <option value="None">None</option>
                                            <option value="Even">Even</option>
                                            <option value="Odd">Odd</option>
                                            <option value="Mark">Mark</option>
                                            <option value="Space">Space</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="um-grid-cols-2 mt-3">
                                    <div class="form-group">
                                        <label>Data Bits</label>
                                        <select class="lab-input" @bind="current.databits">
                                            <option value="">-- Select --</option>
                                            <option value="5">5</option>
                                            <option value="6">6</option>
                                            <option value="7">7</option>
                                            <option value="8">8</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>Stop Bits</label>
                                        <select class="lab-input" @bind="current.stopbits">
                                            <option value="">-- Select --</option>
                                            <option value="1">1</option>
                                            <option value="1.5">1.5</option>
                                            <option value="2">2</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (current.optlmport == true || current.opttcp == true)
                        {
                            <div class="config-sub-card dir-card">
                                <div class="config-sub-card-title dir-title">
                                    <span class="material-symbols-outlined font-18">folder_open</span> Directory Paths & Folder Watch Settings
                                </div>
                                <div class="form-group">
                                    <label>Input Directory Path (Results Folder)</label>
                                    <input type="text" class="lab-input" @bind="current.inputpath" placeholder="C:\LIMS\MachineData\Input\" />
                                </div>
                                <div class="form-group mt-3">
                                    <label>Output Directory Path (Worklist Query Folder)</label>
                                    <input type="text" class="lab-input" @bind="current.outputpath" placeholder="C:\LIMS\MachineData\Output\" />
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer-bar">
                    @if (TenantState.HasActionRight("Configuration", "General", "Delete"))
                    {
                        <button type="button" class="btn-delete" @onclick="() => SoftDeleteMachine(current.mccode)" disabled="@(current.mccode == 0)">
                            Delete
                        </button>
                    }
                    @if (isEditMode ? TenantState.HasActionRight("Configuration", "General", "Edit") : TenantState.HasActionRight("Configuration", "General", "Create"))
                    {
                        <button type="button" class="btn-save" @onclick="SaveMachine">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                                <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z" />
                            </svg>
                            Save Machine
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <div class="directory-section table-section">
        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th style="width: 64px;">ORDER NO</th>
                        <th style="width: 120px;">SHORT NAME</th>
                        <th>MACHINE / ANALYZER NAME</th>
                        <th>MANUFACTURER</th>
                        <th>MODEL</th>
                        <th style="width: 180px;">INTERFACE / PORT</th>
                        <th class="text-center" style="width: 128px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (machines != null && machines.Any())
                    {
                        @foreach (var m in FilteredMachinesBySearch)
                        {
                            <tr>
                                <td><span class="td-order-no">@($"{m.orderno:00}")</span></td>
                                <td style="color: #64748b; font-family: monospace; font-weight: 600;">@m.shortname</td>
                                <td><span class="td-name">@m.name</span></td>
                                <td><span class="td-narration">@m.manufacturer</span></td>
                                <td><span class="td-narration">@m.model</span></td>
                                <td>
                                    <div class="display-flex flex-col gap-2">
                                        @if (m.optrs232 == true)
                                        {
                                            <span class="badge badge-rs232">
                                                <span class="material-symbols-outlined" style="font-size: 12px;">cable</span> RS232: @m.portnumber
                                            </span>
                                        }
                                        @if (m.opttcp == true)
                                        {
                                            <span class="badge badge-tcp">
                                                <span class="material-symbols-outlined" style="font-size: 12px;">lan</span> TCP: @(m.opttcpclient == true ? "Client" : "Server")
                                            </span>
                                        }
                                        @if (m.optlmport == true)
                                        {
                                            <span class="badge badge-file">
                                                <span class="material-symbols-outlined" style="font-size: 12px;">folder_open</span> File Watcher
                                            </span>
                                        }
                                    </div>
                                </td>
                                 <td class="text-center">
                                      @if (OnSelect.HasDelegate)
                                      {
                                          <button type="button" class="btn-action btn-edit" style="width: auto !important; padding: 0 10px !important; border-radius: 6px; font-size: 0.75rem; background: #4f46e5; color: #ffffff;" @onclick="() => OnSelect.InvokeAsync(m.mccode)" title="Select">Select</button>
                                      }
                                     @if (TenantState.HasActionRight("Configuration", "General", "Edit"))
                                     {
                                         <button type="button" class="btn-action btn-edit" @onclick="() => EditMachine(m)" title="Edit">
                                             <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg>
                                         </button>
                                     }
                                     @if (TenantState.HasActionRight("Configuration", "General", "Delete"))
                                     {
                                         <button type="button" class="btn-action btn-delete-action" @onclick="() => SoftDeleteMachine(m.mccode)" title="Delete">
                                             <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                                 <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                                 <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                             </svg>
                                         </button>
                                     }
                                 </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="p-24 text-center td-narration">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<int> OnSelect { get; set; }

    private List<MachineMasterModel> machines = new();
    private MachineMasterModel current = new();
    private bool isEditMode = false;
    private bool displayActiveOnly = true;
    private bool showForm = false;
    private string SearchQuery = "";
    private string TenantCode = "";
    private string AuthToken = "";
 
    private IEnumerable<MachineMasterModel> FilteredMachines =>
        displayActiveOnly ? machines.Where(c => c.deleted != true) : machines;
 
    private IEnumerable<MachineMasterModel> FilteredMachinesBySearch =>
        FilteredMachines.Where(c =>
            string.IsNullOrWhiteSpace(SearchQuery) ||
            (c.name != null && c.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.shortname != null && c.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.manufacturer != null && c.manufacturer.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.model != null && c.model.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    if (!TenantState.IsAuthenticated)
                    {
                        TenantState.SetSession(TenantCode, AuthToken, "");
                    }
                    await LoadMachines();
                    StateHasChanged();
                }
                else
                {
                    Toast.Error("Access denied: Missing valid session. Please log in again.");
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Toast.Error($"Session error: {ex.Message}");
                StateHasChanged();
            }
        }
    }

    private async Task LoadMachines()
    {
        try
        {
            machines = await TestSvc.GetMachinesAsync();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error loading machines: {ex.Message}");
        }
    }

    private void NewMachine()
    {
        current = new MachineMasterModel
        {
            orderno = machines.Any() ? machines.Max(m => m.orderno) + 1 : 1,
            deleted = false,
            optrs232 = false,
            opttcp = false,
            optlmport = false
        };
        isEditMode = false;
        showForm = true;
    }

    private void EditMachine(MachineMasterModel machine)
    {
        current = new MachineMasterModel
        {
            mccode = machine.mccode,
            orderno = machine.orderno,
            shortname = machine.shortname,
            name = machine.name,
            description = machine.description,
            manufacturer = machine.manufacturer,
            model = machine.model,
            portnumber = machine.portnumber,
            baudrate = machine.baudrate,
            parity = machine.parity,
            stopbits = machine.stopbits,
            databits = machine.databits,
            deleted = machine.deleted,
            usercode = machine.usercode,
            computercode = machine.computercode,
            entereddate = machine.entereddate,
            ibsdate = machine.ibsdate,
            opttcp = machine.opttcp,
            optlmport = machine.optlmport,
            inputpath = machine.inputpath,
            outputpath = machine.outputpath,
            optrs232 = machine.optrs232,
            opttcpclient = machine.opttcpclient,
            opttcpserver = machine.opttcpserver,
            tenant_code = machine.tenant_code
        };
        isEditMode = true;
        showForm = true;
    }

    private void ToggleOption(int optionType)
    {
        if (optionType == 1)
        {
            current.optrs232 = !(current.optrs232 ?? false);
            if (current.optrs232 == true)
            {
                current.baudrate ??= 9600;
                current.parity ??= "None";
                current.databits ??= 8;
                current.stopbits ??= 1;
                current.portnumber ??= "COM1";
            }
        }
        else if (optionType == 2)
        {
            current.opttcp = !(current.opttcp ?? false);
            if (current.opttcp == true)
            {
                current.opttcpclient ??= true;
                current.opttcpserver = false;
            }
            else
            {
                current.opttcpclient = false;
                current.opttcpserver = false;
            }
        }
        else if (optionType == 3)
        {
            current.optlmport = !(current.optlmport ?? false);
        }
        StateHasChanged();
    }

    private void SetTcpMode(bool isClient)
    {
        current.opttcpclient = isClient;
        current.opttcpserver = !isClient;
        StateHasChanged();
    }

    private async Task SaveMachine()
    {
        if (string.IsNullOrWhiteSpace(current.name))
        {
            Toast.Error("Machine Name is required.");
            return;
        }
        if (string.IsNullOrWhiteSpace(current.shortname))
        {
            Toast.Error("Short Name is required.");
            return;
        }

        try
        {
            current.tenant_code = TenantCode;
            current.usercode = 1;
            current.computercode = 1;
            current.ibsdate = DateTime.Now;

            bool success;
            if (isEditMode)
            {
                success = await TestSvc.UpdateMachineAsync(current);
            }
            else
            {
                current.entereddate = DateTime.Now;
                success = await TestSvc.InsertMachineAsync(current);
            }

            if (success)
            {
                Toast.Success(isEditMode ? "Machine configuration updated successfully." : "New machine added successfully.");
                await LoadMachines();
                showForm = false;
                StateHasChanged();
            }
            else
            {
                Toast.Error("Failed to save the machine configuration. Please check the backend service logs.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error occurred while saving machine: {ex.Message}");
        }
    }

    private async Task SoftDeleteMachine(int mccode)
    {
        if (mccode == 0) return;

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this machine?");
        if (confirmed)
        {
            try
            {
                bool success = await TestSvc.SoftDeleteMachineAsync(mccode);
                if (success)
                {
                    Toast.Success("Machine successfully deleted.");
                    await LoadMachines();
                    showForm = false;
                    StateHasChanged();
                }
                else
                {
                    Toast.Error("Failed to delete the machine configuration.");
                }
            }
            catch (Exception ex)
            {
                Toast.Error($"Error deleting machine: {ex.Message}");
            }
        }
    }

    private void CloseForm()
    {
        showForm = false;
    }
}
