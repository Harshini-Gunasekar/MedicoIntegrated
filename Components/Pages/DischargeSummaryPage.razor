@page "/discharge-summary"
@using Booking.Services
@using medico_backend.Model
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IpRegistrationService IpService
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.BedMasterService BedMasterService
@inject Booking.Services.WardMasterService WardMasterService
@inject ToastService ToastService
@inject NavigationManager NavigationManager

<PageTitle>Discharge Summary Management</PageTitle>

<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
</div>

<div class="dashboard-container">

    @* MASTER HEADER CARD *@
    <div class="dashboard-header">
        <div class="dashboard-title">
            <h1>Inpatient Discharge Summaries</h1>
            <p>Select IP Patient to Create, Edit or Print Discharge Summary</p>
        </div>
        <div class="header-actions-group">
            <button type="button" class="btn-header-action secondary" @onclick='() => NavigationManager.NavigateTo("/summary-templates")'>
                <i class="bi bi-gear-fill me-1"></i> Summary Templates
            </button>
        </div>
    </div>

    @* SEARCH TOOLBAR BAR *@
    <div class="filters-card">
        <div class="filters-row">
            <div class="filter-group" style="max-width: 440px; flex-grow: 2;">
                <label>Search Patient</label>
                <div style="position: relative;">
                    <i class="bi bi-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #64748b; font-size: 0.88rem;"></i>
                    <input type="text" class="filter-control" style="padding-left: 2.2rem;"
                           placeholder="Search by Patient Name, IP No, Phone..." 
                           value="@searchQuery"
                           @oninput='(e) => searchQuery = e.Value?.ToString() ?? ""' />
                </div>
            </div>

            <div class="filter-group">
                <label>Status Filter</label>
                <select class="filter-control" @bind="statusFilter">
                    <option value="ALL">All Status</option>
                    <option value="ADMITTED">Admitted Patients</option>
                    <option value="DISCHARGED">Discharged Patients</option>
                </select>
            </div>

            <div class="filter-group" style="max-width: 150px; justify-content: flex-end; align-items: flex-end; display: flex; flex-grow: 1;">
                <span style="font-size: 0.85rem; font-weight: 800; color: #64748b; margin-bottom: 8px;">
                    Total: <span style="color: #0284c7; font-weight: 800;">@GetFilteredPatients().Count()</span>
                </span>
            </div>
        </div>
    </div>

    @* PATIENT TABLE *@
    <div class="table-card">
        <div class="table-responsive">
            <table class="medico-table">
                <thead>
                    <tr>
                        <th style="width: 150px;">IP NUMBER</th>
                        <th>PATIENT NAME</th>
                        <th>DOCTOR</th>
                        <th>ADMISSION DATE</th>
                        <th>STATUS</th>
                        <th class="text-center" style="width: 180px;">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6" class="text-center p-24">
                                <DnaLoader IsLoading="true" Overlay="false" Message="Loading Inpatients..." />
                            </td>
                        </tr>
                    }
                    else if (!GetFilteredPatients().Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center p-48 text-muted italic">
                                <i class="bi bi-person-exclamation me-1"></i> No IP Patients Found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in GetFilteredPatients())
                        {
                            var patName = !string.IsNullOrWhiteSpace(p.patient_name) ? p.patient_name : $"Cust #{p.custid}";
                            var docName = GetDoctorName(p.dcode);

                            <tr class="lc-table-row">
                                <td class="font-bold" style="color: #034f75;">
                                    @p.ip_no
                                </td>
                                <td class="font-bold text-slate-800">
                                    <div>@patName</div>
                                    @if (!string.IsNullOrWhiteSpace(p.mobile))
                                    {
                                        <div style="font-size: 0.75rem; color: #64748b; font-weight: normal; margin-top: 2px;">
                                            <i class="bi bi-telephone-fill text-muted me-1"></i> @p.mobile
                                        </div>
                                    }
                                </td>
                                <td>
                                    @docName
                                </td>
                                <td>
                                    @p.admitdate.ToString("dd MMM yyyy hh:mm tt")
                                </td>
                                <td>
                                    @if (p.ip_status == "ADMITTED")
                                    {
                                        <span class="status-badge admitted">
                                            Admitted
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge completed">
                                            Discharged
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn-header-action primary" style="height: 30px; padding: 0.2rem 0.75rem; font-size: 0.78rem;" @onclick="() => OpenDischargeSummary(p)">
                                        <i class="bi bi-file-earmark-medical me-1"></i> Discharge Summary
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@* DISCHARGE SUMMARY MODAL CONTAINER *@
<DischargeSummaryComponent 
    Visible="@showSummaryModal"
    VisibleChanged="@OnVisibleChanged"
    IpId="@selectedIpId" 
    IpNo="@selectedIpNo"
    PatCode="@selectedPatCode"
    CustId="@selectedCustId"
    Dcode="@selectedDcode"
    PatientName="@selectedPatientName" 
    DoctorName="@selectedDoctorName"
    AdmitDate="@selectedAdmitDate"
    DischargeDate="@selectedDischargeDate" />

@code {
    private bool isLoading = true;
    private string searchQuery = "";
    private string statusFilter = "ALL";
    private Guid hoveredRow = Guid.Empty;

    private List<IPRegistrationModel.IpRegistrationModel> patientsList = new();
    private List<DoctorMasterModel> doctorsList = new();

    private bool showSummaryModal = false;
    private Guid selectedIpId = Guid.Empty;
    private string selectedIpNo = "";
    private string selectedPatCode = "";
    private decimal selectedCustId = 0;
    private int selectedDcode = 0;
    private string selectedPatientName = "";
    private string selectedDoctorName = "";
    private DateTime? selectedAdmitDate = null;
    private DateTime? selectedDischargeDate = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            doctorsList = await DoctorService.GetDoctorsAsync() ?? new();
            patientsList = await IpService.GetIpRegistrationsAsync("") ?? new();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading IP registrations: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetDoctorName(int dcode)
    {
        var doc = doctorsList.FirstOrDefault(d => d.dcode == dcode);
        if (doc == null) return $"Dr. #{dcode}";
        return string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : $"Dr. {doc.name}";
    }

    private IEnumerable<IPRegistrationModel.IpRegistrationModel> GetFilteredPatients()
    {
        var result = patientsList.AsEnumerable();

        if (statusFilter != "ALL")
        {
            result = result.Where(p => string.Equals(p.ip_status, statusFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLower();
            result = result.Where(p => (p.patient_name != null && p.patient_name.ToLower().Contains(q))
                || (p.ip_no != null && p.ip_no.ToLower().Contains(q))
                || (p.mobile != null && p.mobile.ToLower().Contains(q)));
        }

        return result;
    }

    private void OpenDischargeSummary(IPRegistrationModel.IpRegistrationModel patient)
    {
        selectedIpId = patient.ip_id;
        selectedIpNo = patient.ip_no ?? "";
        selectedPatCode = patient.custid > 0 ? patient.custid.ToString() : "";
        selectedCustId = patient.custid;
        selectedDcode = patient.dcode;
        selectedPatientName = !string.IsNullOrWhiteSpace(patient.patient_name) ? patient.patient_name : $"Cust #{patient.custid}";
        selectedDoctorName = GetDoctorName(patient.dcode);
        selectedAdmitDate = patient.admitdate;
        selectedDischargeDate = null;
        showSummaryModal = true;
    }

    private void OnVisibleChanged(bool visible)
    {
        showSummaryModal = visible;
    }
}
