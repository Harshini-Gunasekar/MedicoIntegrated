@page "/discharge-summary"
@using Booking.Services
@using medico_backend.Model
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IpRegistrationService IpService
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.BedMasterService BedMasterService
@inject Booking.Services.WardMasterService WardMasterService
@inject ToastService ToastService
@inject NavigationManager NavigationManager

<PageTitle>Discharge Summary Management</PageTitle>

<div style="background: #f8fafc; min-height: 100vh; padding: 1.75rem 2rem; font-family: system-ui, -apple-system, sans-serif;">

    @* MASTER HEADER CARD *@
    <div style="background: #ffffff; border-radius: 16px; border: 1.5px solid #e2e8f0; padding: 1.25rem 1.75rem; box-shadow: 0 4px 16px rgba(0,0,0,0.03); margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; align-items: center; gap: 1.25rem;">
            <div style="background: #eff6ff; border: 1.5px solid #bfdbfe; width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center; color: #2563eb; font-size: 1.6rem; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);">
                <i class="bi bi-file-earmark-medical-fill" style="color: #2563eb;"></i>
            </div>
            <div>
                <h3 style="font-weight: 800; margin: 0; font-size: 1.35rem; color: #0f172a; letter-spacing: -0.01em;">Inpatient Discharge Summaries</h3>
                <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #22c55e; display: inline-block;"></span>
                    <span style="font-size: 0.82rem; color: #64748b; font-weight: 600;">Select IP Patient to Create, Edit or Print Discharge Summary</span>
                </div>
            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 12px;">
            <button type="button" style="background: #eff6ff; color: #2563eb; font-weight: 800; border: 1.5px solid #bfdbfe; border-radius: 10px; padding: 0.65rem 1.3rem; font-size: 0.88rem; display: flex; align-items: center; gap: 6px; cursor: pointer;" @onclick='() => NavigationManager.NavigateTo("/summary-templates")'>
                <i class="bi bi-gear-fill" style="color: #2563eb;"></i> Summary Templates
            </button>
        </div>
    </div>

    @* SEARCH TOOLBAR BAR *@
    <div style="background: #ffffff; border-radius: 14px; padding: 1rem 1.4rem; border: 1.5px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.02); margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div style="position: relative; flex: 1; max-width: 440px;">
            <i class="bi bi-search" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #2563eb; font-size: 0.95rem;"></i>
            <input type="text" style="width: 100%; box-sizing: border-box; padding: 0.6rem 1rem 0.6rem 2.5rem; border-radius: 10px; border: 1.5px solid #cbd5e1; font-size: 0.88rem; font-weight: 600; outline: none; background: #f8fafc; color: #0f172a;" 
                   placeholder="Search by Patient Name, IP No, Phone..." 
                   value="@searchQuery"
                   @oninput='(e) => searchQuery = e.Value?.ToString() ?? ""' />
        </div>

        <div style="display: flex; align-items: center; gap: 12px;">
            <select style="border-radius: 8px; border: 1.5px solid #cbd5e1; padding: 0.5rem 0.85rem; font-size: 0.85rem; font-weight: 700; color: #1e293b; background: #ffffff;" @bind="statusFilter">
                <option value="ALL">All Status</option>
                <option value="ADMITTED">Admitted Patients</option>
                <option value="DISCHARGED">Discharged Patients</option>
            </select>

            <span style="font-size: 0.85rem; font-weight: 800; color: #64748b;">
                Total IP Patients: <span style="color: #2563eb; font-weight: 800;">@GetFilteredPatients().Count()</span>
            </span>
        </div>
    </div>

    @* PATIENT TABLE *@
    <div style="background: #ffffff; border-radius: 16px; border: 1.5px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 14px rgba(0,0,0,0.02);">
        @if (isLoading)
        {
            <div style="padding: 5rem 2rem; text-align: center;">
                <div class="spinner-border text-primary" style="width: 3.5rem; height: 3.5rem;" role="status"></div>
                <h5 style="margin-top: 1.25rem; color: #1e293b; font-weight: 800;">Loading Inpatients...</h5>
            </div>
        }
        else if (!GetFilteredPatients().Any())
        {
            <div style="padding: 5rem 2rem; text-align: center;">
                <i class="bi bi-person-exclamation" style="font-size: 2.5rem; color: #94a3b8;"></i>
                <h5 style="margin-top: 1rem; color: #1e293b; font-weight: 800;">No IP Patients Found</h5>
                <p style="color: #64748b; font-size: 0.88rem;">No inpatients match your search query or filter.</p>
            </div>
        }
        else
        {
            <div style="overflow-x: auto;">
                <table class="table" style="margin: 0; width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border-bottom: 1.5px solid #e2e8f0; font-size: 0.78rem; font-weight: 800; color: #475569; text-transform: uppercase;">
                            <th style="padding: 0.85rem 1.25rem;">IP No</th>
                            <th style="padding: 0.85rem 1.25rem;">Patient Name</th>
                            <th style="padding: 0.85rem 1.25rem;">Doctor</th>
                            <th style="padding: 0.85rem 1.25rem;">Admission Date</th>
                            <th style="padding: 0.85rem 1.25rem; text-align: center;">Status</th>
                            <th style="padding: 0.85rem 1.25rem; text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in GetFilteredPatients())
                        {
                            var patName = !string.IsNullOrWhiteSpace(p.patient_name) ? p.patient_name : $"Cust #{p.custid}";
                            var docName = GetDoctorName(p.dcode);

                            <tr style="border-bottom: 1px solid #f1f5f9; font-size: 0.88rem; vertical-align: middle; transition: background 0.15s;" @onmouseenter='() => hoveredRow = p.ip_id' @onmouseleave='() => hoveredRow = Guid.Empty'>
                                <td style="padding: 0.85rem 1.25rem; font-weight: 800; color: #2563eb;">
                                    @p.ip_no
                                </td>
                                <td style="padding: 0.85rem 1.25rem;">
                                    <div style="font-weight: 800; color: #0f172a;">@patName</div>
                                    @if (!string.IsNullOrWhiteSpace(p.mobile))
                                    {
                                        <div style="font-size: 0.75rem; color: #64748b; margin-top: 2px; display: flex; align-items: center; gap: 4px;"><i class="bi bi-telephone-fill" style="color: #94a3b8;"></i> @p.mobile</div>
                                    }
                                </td>
                                <td style="padding: 0.85rem 1.25rem; font-weight: 700; color: #334155;">
                                    @docName
                                </td>
                                <td style="padding: 0.85rem 1.25rem; color: #475569; font-weight: 600;">
                                    @p.admitdate.ToString("dd MMM yyyy hh:mm tt")
                                </td>
                                <td style="padding: 0.85rem 1.25rem; text-align: center;">
                                    @if (p.ip_status == "ADMITTED")
                                    {
                                        <span style="background: #dcfce7; color: #15803d; font-weight: 800; font-size: 0.75rem; padding: 3px 10px; border-radius: 20px; border: 1px solid #bbf7d0; display: inline-flex; align-items: center; gap: 4px;">
                                            <i class="bi bi-circle-fill" style="font-size: 0.4rem;"></i> Admitted
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="background: #f0fdf4; color: #166534; font-weight: 800; font-size: 0.75rem; padding: 3px 10px; border-radius: 20px; border: 1px solid #86efac; display: inline-flex; align-items: center; gap: 4px;">
                                            <i class="bi bi-check-circle-fill" style="font-size: 0.7rem;"></i> Discharged
                                        </span>
                                    }
                                </td>
                                <td style="padding: 0.85rem 1.25rem; text-align: center;">
                                    <button type="button" style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; font-weight: 800; border: none; border-radius: 8px; padding: 0.45rem 1rem; font-size: 0.82rem; cursor: pointer; box-shadow: 0 3px 10px rgba(37, 99, 235, 0.25); display: inline-flex; align-items: center; gap: 6px;" @onclick="() => OpenDischargeSummary(p)">
                                        <i class="bi bi-file-earmark-medical-fill" style="color: #ffffff;"></i> Discharge Summary
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

@* DISCHARGE SUMMARY MODAL CONTAINER *@
<DischargeSummaryComponent 
    Visible="@showSummaryModal"
    VisibleChanged="@OnVisibleChanged"
    IpId="@selectedIpId" 
    IpNo="@selectedIpNo"
    PatCode="@selectedPatCode"
    CustId="@selectedCustId"
    Dcode="@selectedDcode"
    PatientName="@selectedPatientName" 
    DoctorName="@selectedDoctorName"
    AdmitDate="@selectedAdmitDate"
    DischargeDate="@selectedDischargeDate" />

@code {
    private bool isLoading = true;
    private string searchQuery = "";
    private string statusFilter = "ALL";
    private Guid hoveredRow = Guid.Empty;

    private List<IPRegistrationModel.IpRegistrationModel> patientsList = new();
    private List<DoctorMasterModel> doctorsList = new();

    private bool showSummaryModal = false;
    private Guid selectedIpId = Guid.Empty;
    private string selectedIpNo = "";
    private string selectedPatCode = "";
    private decimal selectedCustId = 0;
    private int selectedDcode = 0;
    private string selectedPatientName = "";
    private string selectedDoctorName = "";
    private DateTime? selectedAdmitDate = null;
    private DateTime? selectedDischargeDate = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            doctorsList = await DoctorService.GetDoctorsAsync() ?? new();
            patientsList = await IpService.GetIpRegistrationsAsync("") ?? new();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading IP registrations: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetDoctorName(int dcode)
    {
        var doc = doctorsList.FirstOrDefault(d => d.dcode == dcode);
        if (doc == null) return $"Dr. #{dcode}";
        return string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : $"Dr. {doc.name}";
    }

    private IEnumerable<IPRegistrationModel.IpRegistrationModel> GetFilteredPatients()
    {
        var result = patientsList.AsEnumerable();

        if (statusFilter != "ALL")
        {
            result = result.Where(p => string.Equals(p.ip_status, statusFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLower();
            result = result.Where(p => (p.patient_name != null && p.patient_name.ToLower().Contains(q))
                || (p.ip_no != null && p.ip_no.ToLower().Contains(q))
                || (p.mobile != null && p.mobile.ToLower().Contains(q)));
        }

        return result;
    }

    private void OpenDischargeSummary(IPRegistrationModel.IpRegistrationModel patient)
    {
        selectedIpId = patient.ip_id;
        selectedIpNo = patient.ip_no ?? "";
        selectedPatCode = patient.custid > 0 ? patient.custid.ToString() : "";
        selectedCustId = patient.custid;
        selectedDcode = patient.dcode;
        selectedPatientName = !string.IsNullOrWhiteSpace(patient.patient_name) ? patient.patient_name : $"Cust #{patient.custid}";
        selectedDoctorName = GetDoctorName(patient.dcode);
        selectedAdmitDate = patient.admitdate;
        selectedDischargeDate = null;
        showSummaryModal = true;
    }

    private void OnVisibleChanged(bool visible)
    {
        showSummaryModal = visible;
    }
}
