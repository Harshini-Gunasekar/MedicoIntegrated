@page "/report-methods"
@page "/reportmethodmaster"
@rendermode InteractiveServer

@using Booking.Models
@using Booking.Services
@inject ReportMethodService MethodService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">list_alt</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Method Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Classification Inventory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search methods..." @bind="SearchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewMethod">+ Add New</button>
            </div>
        </div>
    </div>

    @* --- directory list --- *@
    <div class="directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">ORDER NO</th>
                        <th style="width: 150px;">SHORT NAME</th>
                        <th>METHOD NAME</th>
                        <th style="width: 180px;">DURATION</th>
                        <th>DESCRIPTION</th>
                        <th style="width: 180px;">ENTERED DATE</th>
                        <th style="width: 180px;">MODIFIED DATE</th>
                        <th class="text-center" style="width: 120px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (methods != null && methods.Any())
                    {
                        @foreach (var m in FilteredMethodsBySearch)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"{m.orderno:00}")</span></td>
                                <td class="lc-color-slate-500 lc-font-mono lc-font-700 lc-font-13">@m.shortname</td>
                                <td class="font-bold text-slate-800">@m.name</td>
                                <td><span class="lc-color-slate-600">@($"{m.durationtime} {m.duration}")</span></td>
                                <td class="text-slate-500">@m.description</td>
                                <td class="text-slate-400 font-12">@(m.entereddate != default ? m.entereddate.ToString("dd-MM-yyyy hh:mm tt") : "")</td>
                                <td class="text-slate-400 font-12">@(m.ibsdate != default ? m.ibsdate.ToString("dd-MM-yyyy hh:mm tt") : "")</td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px;">
                                        <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => EditMethod(m)" title="Edit">
                                            <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                        </button>
                                        <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => DeleteMethod(m.rtmcode)" title="Delete">
                                            <span class="material-symbols-outlined font-18 text-slate-400">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center p-48 text-slate-400 italic">No report method records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- FORM SECTION (Modal) --- *@
@if (showForm)
{
    <div class="modal-overlay">
        <div class="modal-form-card">
            <div class="modal-header-bar">
                <h3>@(isEditMode ? "Edit Report Method" : "New Report Method Entry")</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-0 form-section">
                    <div class="mt-0">
                        @* Line 1: Method Name *@
                        <div class="um-grid-row">
                            <div class="form-group position-relative">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label style="margin-bottom: 0;">Method Name *</label>
                                    @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                    {
                                        <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                    }
                                </div>
                                <input type="text" class="lab-input" @bind="current.name" placeholder="e.g. Complete Blood Count" required />
                            </div>
                        </div>

                        @* Line 2: Order No, Short Name, Duration Time, Duration *@
                        <div class="um-grid-cols-4" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem;">
                            <div class="form-group">
                                <label>Order No</label>
                                <input type="number" class="lab-input" @bind="current.orderno" placeholder="e.g. 1" />
                            </div>
                            <div class="form-group">
                                <label>Short Name</label>
                                <input type="text" class="lab-input" @bind="current.shortname" placeholder="e.g. CBC" />
                            </div>
                            <div class="form-group">
                                <label>Duration Time</label>
                                <input type="number" class="lab-input" @bind="current.durationtime" placeholder="e.g. 24" />
                            </div>
                            <div class="form-group">
                                <label>Duration Unit</label>
                                <select class="lab-input" @bind="current.duration">
                                    <option value="Hours">Hours</option>
                                    <option value="Days">Days</option>
                                    <option value="Minutes">Minutes</option>
                                </select>
                            </div>
                        </div>

                        @* Line 3: Description *@
                        <div class="um-grid-row">
                            <div class="form-group">
                                <label>Description</label>
                                <input type="text" class="lab-input" @bind="current.description" placeholder="Standard blood count test method" />
                            </div>
                        </div>

                        @* Line 4: Footer *@
                        <div class="um-grid-row">
                            <div class="form-group">
                                <label>Footer</label>
                                <input type="text" class="lab-input" @bind="current.footer" placeholder="End of report" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer-bar">
                <button type="button"
                        class="btn-delete"
                        @onclick="() => DeleteMethod(current.rtmcode)"
                        disabled="@(current.rtmcode == 0)">
                    Delete
                </button>
                <button type="button" class="btn-save" @onclick="SaveMethod">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                    </svg>
                    Save Method
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Booking.Models.ReportMethodModel> methods = new();
    private Booking.Models.ReportMethodModel current = new();
    private bool isEditMode = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";

    private IEnumerable<Booking.Models.ReportMethodModel> FilteredMethods =>
        methods.Where(m => !m.deleted);

    private IEnumerable<Booking.Models.ReportMethodModel> FilteredMethodsBySearch =>
        FilteredMethods.Where(m => 
            string.IsNullOrWhiteSpace(SearchQuery) || 
            (m.name != null && m.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (m.shortname != null && m.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (m.description != null && m.description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadMethods();
    }

    private async Task LoadMethods()
    {
        try
        {
            methods = await MethodService.GetReportMethodsAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading methods: {ex.Message}");
        }
    }

    private void NewMethod()
    {
        current = new Booking.Models.ReportMethodModel { 
            deleted = false,
            computercode = 1,
            usercode = 1,
            entereddate = DateTime.Now,
            ibsdate = DateTime.Now,
            orderno = methods.Count + 1,
            tenant_code = "TEN007",
            duration = "Hours",
            durationtime = 24
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private void EditMethod(Booking.Models.ReportMethodModel m)
    {
        if (m == null) return;
        current = new Booking.Models.ReportMethodModel
        {
            rtmcode = m.rtmcode,
            tenant_code = m.tenant_code,
            orderno = m.orderno,
            shortname = m.shortname,
            name = m.name,
            durationtime = m.durationtime,
            duration = m.duration,
            description = m.description,
            footer = m.footer,
            deleted = m.deleted,
            usercode = m.usercode,
            computercode = m.computercode,
            entereddate = m.entereddate,
            ibsdate = m.ibsdate
        };
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveMethod()
    {
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(current.name))
        {
            ToastService.ShowError("Method Name is required.");
            StateHasChanged();
            return;
        }

        try
        {
            current.tenant_code = "TEN007";
            current.computercode = 1;
            current.usercode = 1;
            current.ibsdate = DateTime.Now;

            bool success;
            if (isEditMode)
            {
                success = await MethodService.UpdateReportMethodAsync(current);
            }
            else
            {
                current.entereddate = DateTime.Now;
                success = await MethodService.InsertReportMethodAsync(current);
            }

            if (success)
            {
                await LoadMethods();
                ToastService.ShowSuccess(isEditMode ? "Method updated successfully!" : "Method added successfully!");
                showForm = false;
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Save failed on backend.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving method: {ex.Message}");
            StateHasChanged();
        }
    }

    private async Task DeleteMethod(decimal rtmcode)
    {
        if (rtmcode == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this method?"))
        {
            try
            {
                bool success = await MethodService.DeleteReportMethodAsync(rtmcode);
                if (success)
                {
                    await LoadMethods();
                    ToastService.ShowSuccess("Method deleted successfully!");
                    if (current != null && current.rtmcode == rtmcode)
                    {
                        showForm = false;
                    }
                    StateHasChanged();
                }
                else
                {
                    ToastService.ShowError("Delete failed on backend.");
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error deleting: {ex.Message}");
                StateHasChanged();
            }
        }
    }

    private void CloseForm()
    {
        current = new Booking.Models.ReportMethodModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }
}
