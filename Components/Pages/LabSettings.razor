    private void OnCultureAuth1Selected(InputFileChangeEventArgs e) => cultureAuth1SigFile = e.File;
    private void OnCultureAuth2Selected(InputFileChangeEventArgs e) => cultureAuth2SigFile = e.File;
    private void OnCultureAuth3Selected(InputFileChangeEventArgs e) => cultureAuth3SigFile = e.File;

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();

                pendingLogoFile = (bytes, file.Name, file.ContentType);
                logoPreviewSrc = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error reading logo file: {ex.Message}");
        }
    }

    private void RemoveMainLogo()
    {
        pendingLogoFile = null;
        tenantReportModel.logo_url = null;
        logoPreviewSrc = null;
        StateHasChanged();
    }

    private async Task LoadSettings()
    {
        isLoading = true;
        try
        {
            try
            {
                var tcResult = await _sessionStorage.GetAsync<string>("tenant_code");
                if (tcResult.Success && !string.IsNullOrEmpty(tcResult.Value))
                {
                    tenantCode = tcResult.Value;
                }
            }
            catch { }

            setting = await LabSettingService.GetLabSettingAsync() ?? new LabSettingModel();
            await LoadTenantLogo();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading lab settings: {ex.Message}");
            ToastService.ShowError("Failed to load lab settings.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadTenantLogo()
    {
        try
        {
            var res = await MasterTenantService.GetTenantReportMethodAsync(tenantCode);
            if (res != null && res.id > 0)
            {
                tenantReportModel = res;
                isTenantReportEditMode = true;
                if (!string.IsNullOrEmpty(tenantReportModel.logo_url))
                {
                    await LoadLogoPreview(tenantReportModel.logo_url);
                }
                else
                {
                    logoPreviewSrc = null;
                }
            }
            else
            {
                tenantReportModel = new TenantReportMethodModel
                {
                    tenant_code = tenantCode,
                    paper_size = "A4",
                    orientation = "Portrait",
                    margin_top = 10,
                    margin_bottom = 10,
                    margin_left = 10,
                    margin_right = 10,
                    show_printed_datetime = true,
                    datetime_format = "dd/MM/yyyy HH:mm"
                };
                isTenantReportEditMode = false;
                logoPreviewSrc = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tenant logo: {ex.Message}");
        }
    }

    private async Task LoadLogoPreview(string key)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("DoctorApi");
            if (client.DefaultRequestHeaders.Contains("tenant_code"))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
            }
            client.DefaultRequestHeaders.Add("tenant_code", tenantCode);

            var response = await client.GetAsync($"api/files/download?key={Uri.EscapeDataString(key)}");
            if (response.IsSuccessStatusCode)
            {
                var jsonStr = await response.Content.ReadAsStringAsync();
                var downloadRes = Newtonsoft.Json.JsonConvert.DeserializeObject<FileDownloadResponse>(jsonStr);
                if (downloadRes != null && !string.IsNullOrEmpty(downloadRes.base64))
                {
                    logoPreviewSrc = $"data:image/png;base64,{downloadRes.base64}";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading logo preview: {ex.Message}");
        }
    }

