    /* iOS Switch */
    .ls-ios-switch {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
        flex-shrink: 0;
    }
    .ls-ios-switch input { opacity: 0; width: 0; height: 0; }
    .ls-ios-slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #cbd5e1;
        transition: .25s ease;
        border-radius: 24px;
    }
    .ls-ios-slider:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: .25s ease;
        border-radius: 50%;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }
    .ls-ios-switch input:checked + .ls-ios-slider { background-color: #2563eb; }
    .ls-ios-switch input:checked + .ls-ios-slider:before { transform: translateX(20px); }

