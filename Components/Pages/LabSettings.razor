@page "/lab-settings"
@using Booking.Models
@using Booking.Services
@using Medico_Backend.Model
@using Microsoft.AspNetCore.Components.Forms
@inject LabSettingService LabSettingService
@inject MasterTenantServices MasterTenantService
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@rendermode InteractiveServer

<div class="ls-viewport">
    <!-- Top Executive Header Banner -->
    <header class="ls-hero-card">
        <div class="ls-flex-row justify-content-between w-100">
            <!-- Icon, Title, and Subtitle in Clean Single Row Flex Group -->
            <div class="ls-flex-row">
                <div class="ls-hero-icon flex-shrink-0">
                    <i class="bi bi-sliders2-vertical"></i>
                </div>
                <div>
                    <h3 class="ls-hero-heading">Lab Settings & System Engine</h3>
                </div>
            </div>
            <div class="flex-shrink-0">
                <button type="button" class="ls-btn-save-hero" @onclick="SaveSettings" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Saving Changes...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle me-2 fs-5"></i>
                        <span>Save All Changes</span>
                    }
                </button>
            </div>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="ls-loading-state">
            <div class="ls-loading-spinner"></div>
            <h5 class="fw-bold text-dark mb-1">Loading Configuration Parameters</h5>
            <p class="text-secondary small mb-0">Synchronizing settings with diagnostic database...</p>
        </div>
    }
    else
    {
        <!-- Workspace Layout Grid -->
        <div class="ls-workspace-grid">
            <!-- Left Fixed Category Sidebar -->
            <aside class="ls-nav-sidebar">
                <div class="ls-nav-header">CONFIGURATION CATEGORIES</div>
                
                <div class="d-flex flex-column gap-2">
                    <button type="button" class="ls-category-btn @(activeTab == "general" ? "active" : "")" @onclick='() => activeTab = "general"'>
                        <div class="ls-cat-icon bg-indigo flex-shrink-0"><i class="bi bi-gear-wide-connected"></i></div>
                        <div class="ls-cat-text">
                            <span class="ls-cat-title">Workflow & General</span>
                            <span class="ls-cat-sub">Toggles, titles & disclaimers</span>
                        </div>
                        <i class="bi bi-chevron-right ls-cat-arrow"></i>
                    </button>

                    <button type="button" class="ls-category-btn @(activeTab == "print" ? "active" : "")" @onclick='() => activeTab = "print"'>
                        <div class="ls-cat-icon bg-cyan flex-shrink-0"><i class="bi bi-printer-fill"></i></div>
                        <div class="ls-cat-text">
                            <span class="ls-cat-title">Print & Bill Format</span>
                            <span class="ls-cat-sub">Paper size & header graphics</span>
                        </div>
                        <i class="bi bi-chevron-right ls-cat-arrow"></i>
                    </button>

                    <button type="button" class="ls-category-btn @(activeTab == "routine_auth" ? "active" : "")" @onclick='() => activeTab = "routine_auth"'>
                        <div class="ls-cat-icon bg-purple flex-shrink-0"><i class="bi bi-pen-fill"></i></div>
                        <div class="ls-cat-text">
                            <span class="ls-cat-title">Routine Signatures</span>
                            <span class="ls-cat-sub">Pathologist signees & uploads</span>
                        </div>
                        <i class="bi bi-chevron-right ls-cat-arrow"></i>
                    </button>

                    <button type="button" class="ls-category-btn @(activeTab == "culture_auth" ? "active" : "")" @onclick='() => activeTab = "culture_auth"'>
                        <div class="ls-cat-icon bg-rose flex-shrink-0"><i class="bi bi-virus"></i></div>
                        <div class="ls-cat-text">
                            <span class="ls-cat-title">Culture Signatures</span>
                            <span class="ls-cat-sub">Microbiology signees & uploads</span>
                        </div>
                        <i class="bi bi-chevron-right ls-cat-arrow"></i>
                    </button>

                    <button type="button" class="ls-category-btn @(activeTab == "main_logo" ? "active" : "")" @onclick='() => activeTab = "main_logo"'>
                        <div class="ls-cat-icon bg-blue flex-shrink-0"><i class="bi bi-image"></i></div>
                        <div class="ls-cat-text">
                            <span class="ls-cat-title">Main Logo</span>
                            <span class="ls-cat-sub">Organization & branding logo</span>
                        </div>
                        <i class="bi bi-chevron-right ls-cat-arrow"></i>
                    </button>

                    <button type="button" class="ls-category-btn @(activeTab == "margins" ? "active" : "")" @onclick='() => activeTab = "margins"'>
                        <div class="ls-cat-icon bg-emerald flex-shrink-0"><i class="bi bi-bounding-box-circles"></i></div>
                        <div class="ls-cat-text">
                            <span class="ls-cat-title">Margins & Spacing</span>
                            <span class="ls-cat-sub">Page margin metrics (mm)</span>
                        </div>
                        <i class="bi bi-chevron-right ls-cat-arrow"></i>
                    </button>
                </div>
            </aside>

            <!-- Right Scrollable Content Panel -->
            <main class="ls-details-panel">
                @if (activeTab == "general")
                {
                    <div class="ls-section-head">
                        <div class="ls-flex-row mb-1">
                            <div class="ls-section-badge bg-indigo-soft flex-shrink-0">
                                <i class="bi bi-toggle2-on"></i>
                            </div>
                            <h4 class="ls-section-main-title">Operational & Workflow Toggles</h4>
                        </div>
                    </div>

                    <div class="ls-grid-3">
                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Common Normal Values</div>
                                    <div class="ls-feature-desc">Use standard unified reference range across age & gender demographics.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.ls_common_normal_values">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Select Normal Values</div>
                                    <div class="ls-feature-desc">Dynamically prompt age/gender range selector during result entry.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.ls_select_normal_values">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Hide Signatures</div>
                                    <div class="ls-feature-desc">Do not render authorization signees in final report outputs.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.ls_hide_signature">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Authorize Results First</div>
                                    <div class="ls-feature-desc">Require doctor verification before enabling report printing.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.authorize_results">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Sample Collection Workflow</div>
                                    <div class="ls-feature-desc">Require barcode verification step before sample processing.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.sample_collection">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Direct Result Entry</div>
                                    <div class="ls-feature-desc">Allow entry without pending lab order billing requirement.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.direct_result">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Auto Pathology Sequence</div>
                                    <div class="ls-feature-desc">Automatically increment sequential pathology specimen lab numbers.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.pathology_no">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Multi-Branch Support</div>
                                    <div class="ls-feature-desc">Synchronize configuration across active organization branches.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.multi_branch">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Report QR Code</div>
                                    <div class="ls-feature-desc">Embed digital verification QR code on lab reports.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.report_qr">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Slot Required for Registration</div>
                                    <div class="ls-feature-desc">Mandate selecting a slot during patient registration instead of walk-in.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.is_slot_required">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Doctor OP Age-Wise Charge Split</div>
                                    <div class="ls-feature-desc">Split doctor's OP consultation fee by the patient's age slab.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.op_age_wise_split">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Show All Customers</div>
                                    <div class="ls-feature-desc">When enabled (true), show all customers across tenants. When disabled (false), show current tenant customers only.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.show_all_customers">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Critical Value Indication</div>
                                    <div class="ls-feature-desc">Enable critical value indication in lab test results.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.critical_value_indication">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Show Physical Bill Total in Purchase</div>
                                    <div class="ls-feature-desc">When enabled (true), displays the Physical Bill Totals card in Purchase Master. When disabled (false), displays Discount % / Discount Amount / Total Amount directly below items.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.show_physical_bill">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Payment Required for Online Registration</div>
                                    <div class="ls-feature-desc">When enabled (true), displays online payment charges in Doctor Master and mandates online payment during appointment booking.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.payment_required_online_reg">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Enable Combo OP Registration</div>
                                    <div class="ls-feature-desc">When enabled (true), allows bundling dressing or additional services onto a single OP visit / token registration.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.enable_combo_registration">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Auto Route to Billing After Registration</div>
                                    <div class="ls-feature-desc">When enabled (true), automatically redirects to the Billing Portal after a successful OP registration or walk-in.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.auto_route_billing_after_register">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="ls-section-head border-top pt-3 mt-2">
                        <div class="ls-flex-row mb-1">
                            <div class="ls-section-badge bg-purple-soft flex-shrink-0">
                                <i class="bi bi-card-heading"></i>
                            </div>
                            <h4 class="ls-section-main-title">Report Headings & Notes</h4>
                        </div>
                    </div>

                    <div class="ls-grid-3 mb-2">
                        <div>
                            <label class="ls-form-label">Diagnostic Report Main Title</label>
                            <input type="text" class="ls-form-input" @bind="setting.lab_report_name" placeholder="e.g. DIAGNOSTIC LABORATORY REPORT" />
                        </div>

                        <div>
                            <label class="ls-form-label">Cheque / Favoured Name</label>
                            <input type="text" class="ls-form-input" @bind="setting.cheque_name" placeholder="e.g. SRI MEDICO CLINIC LAB" />
                        </div>

                        <div>
                            <label class="ls-form-label">Report Top Header Disclaimer Note</label>
                            <input type="text" class="ls-form-input" @bind="setting.report_header" placeholder="Custom text printed at top of lab reports..." />
                        </div>
                    </div>

                    <div>
                        <label class="ls-form-label">Report Bottom Footer Disclaimer Note</label>
                        <input type="text" class="ls-form-input" @bind="setting.report_footer" placeholder="Custom disclaimer or notes printed at bottom of lab reports..." />
                    </div>
                }

                @if (activeTab == "print")
                {
                    <div class="ls-section-head">
                        <div class="ls-flex-row mb-1">
                            <div class="ls-section-badge bg-cyan-soft flex-shrink-0">
                                <i class="bi bi-printer-fill"></i>
                            </div>
                            <h4 class="ls-section-main-title">Paper Size & Print Formatting</h4>
                        </div>
                    </div>

                    <div class="ls-grid-2 mb-3">
                        <div>
                            <label class="ls-form-label">Paper Sheet Size</label>
                            <select class="ls-form-select" @bind="setting.bill_paper_size">
                                <option value="A4">A4 Standard Sheet (210 x 297 mm)</option>
                                <option value="A5">A5 Half Sheet (148 x 210 mm)</option>
                                <option value="Letter">Letter Size (8.5 x 11 in)</option>
                            </select>
                        </div>

                        <div>
                            <label class="ls-form-label">Print Orientation</label>
                            <select class="ls-form-select" @bind="setting.bill_orientation">
                                <option value="portrait">Portrait (Vertical)</option>
                                <option value="landscape">Landscape (Horizontal)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Header & Footer Image Upload Dropzones -->
                    <div class="ls-section-head border-top pt-3 mt-2">
                        <div class="ls-flex-row mb-1">
                            <div class="ls-section-badge bg-blue-soft flex-shrink-0">
                                <i class="bi bi-image-fill"></i>
                            </div>
                            <h4 class="ls-section-main-title">Header & Footer Image Uploads</h4>
                        </div>
                    </div>

                    <div class="ls-grid-2 mb-3">
                        <!-- Header Image Dropzone -->
                        <div class="ls-dropzone-wrapper">
                            <div class="ls-flex-row mb-2">
                                <div class="ls-dropzone-icon-box bg-indigo-soft flex-shrink-0">
                                    <i class="bi bi-image"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark fs-6">Report Header Image</div>
                                    <div class="text-secondary small">Recommended: 1200 x 200 px (PNG/JPG)</div>
                                </div>
                            </div>

                            <div class="ls-dropzone-area">
                                <i class="bi bi-cloud-arrow-up-fill text-primary display-6 mb-2"></i>
                                <div class="fw-bold text-dark mb-1">Click to Select Header Image</div>
                                <p class="text-secondary small mb-3">PNG, JPG or WebP up to 10MB</p>
                                
                                <div class="ls-file-input-wrapper">
                                    <button type="button" class="ls-btn-upload-action">
                                        <i class="bi bi-folder-fill me-2"></i>Browse File
                                    </button>
                                    <InputFile OnChange="@OnHeaderSelected" accept="image/*" />
                                </div>
                            </div>

                            @if (headerFile != null)
                            {
                                <div class="ls-status-pill success mt-3">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    <span>Selected File: <strong>@headerFile.Name</strong></span>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(setting.header_path))
                            {
                                <div class="ls-status-pill info mt-3">
                                    <i class="bi bi-file-earmark-image me-2"></i>
                                    <span>Stored S3 Key: <code>@setting.header_path</code></span>
                                </div>
                            }
                        </div>

                        <!-- Footer Image Dropzone -->
                        <div class="ls-dropzone-wrapper">
                            <div class="ls-flex-row mb-2">
                                <div class="ls-dropzone-icon-box bg-cyan-soft flex-shrink-0">
                                    <i class="bi bi-layout-split"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark fs-6">Report Footer Image</div>
                                    <div class="text-secondary small">Recommended: 1200 x 150 px (PNG/JPG)</div>
                                </div>
                            </div>

                            <div class="ls-dropzone-area">
                                <i class="bi bi-cloud-arrow-up-fill text-info display-6 mb-2"></i>
                                <div class="fw-bold text-dark mb-1">Click to Select Footer Image</div>
                                <p class="text-secondary small mb-3">PNG, JPG or WebP up to 10MB</p>
                                
                                <div class="ls-file-input-wrapper">
                                    <button type="button" class="ls-btn-upload-action cyan">
                                        <i class="bi bi-folder-fill me-2"></i>Browse File
                                    </button>
                                    <InputFile OnChange="@OnFooterSelected" accept="image/*" />
                                </div>
                            </div>

                            @if (footerFile != null)
                            {
                                <div class="ls-status-pill success mt-3">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    <span>Selected File: <strong>@footerFile.Name</strong></span>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(setting.footer_path))
                            {
                                <div class="ls-status-pill info mt-3">
                                    <i class="bi bi-file-earmark-image me-2"></i>
                                    <span>Stored S3 Key: <code>@setting.footer_path</code></span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Report Header & Footer Image Display Toggles -->
                    <div class="ls-section-head">
                        <div class="ls-flex-row mb-1">
                            <div class="ls-section-badge bg-cyan-soft flex-shrink-0">
                                <i class="bi bi-toggle2-on"></i>
                            </div>
                            <h4 class="ls-section-main-title">Report Image Display Toggles</h4>
                        </div>
                    </div>

                    <div class="ls-grid-3">
                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Discharge Summary Header & Footer Image</div>
                                    <div class="ls-feature-desc">Render header & footer graphic on Discharge Summary PDFs.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.show_dischargesummary_header_footer_image">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Routine Report Header & Footer Image</div>
                                    <div class="ls-feature-desc">Render header & footer graphic on Routine Lab Reports.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.show_report_header_footer_image">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Culture Report Header & Footer Image</div>
                                    <div class="ls-feature-desc">Render header & footer graphic on Culture & Sensitivity Reports.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.show_culture_header_footer_image">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Casesheet Header & Footer Image</div>
                                    <div class="ls-feature-desc">Render header & footer graphic on OP & IP Casesheets.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.show_casesheet_header_footer_image">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="ls-feature-title">Patient Bill Header & Footer Image</div>
                                    <div class="ls-feature-desc">Render header & footer graphic on Billing Receipts.</div>
                                </div>
                                <label class="ls-ios-switch">
                                    <input type="checkbox" @bind="setting.show_bill_header_footer_image">
                                    <span class="ls-ios-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="ls-feature-card">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
