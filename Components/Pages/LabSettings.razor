@code {
    private LabSettingModel setting = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string activeTab = "general";

    // In-memory Selected Files
    private IBrowserFile? headerFile;
    private IBrowserFile? footerFile;
    private IBrowserFile? auth1SigFile;
    private IBrowserFile? auth2SigFile;
    private IBrowserFile? auth3SigFile;
    private IBrowserFile? cultureAuth1SigFile;
    private IBrowserFile? cultureAuth2SigFile;
    private IBrowserFile? cultureAuth3SigFile;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private void OnHeaderSelected(InputFileChangeEventArgs e) => headerFile = e.File;
    private void OnFooterSelected(InputFileChangeEventArgs e) => footerFile = e.File;
    private void OnAuth1Selected(InputFileChangeEventArgs e) => auth1SigFile = e.File;
    private void OnAuth2Selected(InputFileChangeEventArgs e) => auth2SigFile = e.File;
    private void OnAuth3Selected(InputFileChangeEventArgs e) => auth3SigFile = e.File;
    private void OnCultureAuth1Selected(InputFileChangeEventArgs e) => cultureAuth1SigFile = e.File;
    private void OnCultureAuth2Selected(InputFileChangeEventArgs e) => cultureAuth2SigFile = e.File;
    private void OnCultureAuth3Selected(InputFileChangeEventArgs e) => cultureAuth3SigFile = e.File;

    private async Task LoadSettings()
    {
        isLoading = true;
        try
        {
            setting = await LabSettingService.GetLabSettingAsync() ?? new LabSettingModel();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading lab settings: {ex.Message}");
            ToastService.ShowError("Failed to load lab settings.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveSettings()
    {
        isSaving = true;
        try
        {
            var form = new MultipartFormDataContent();
            form.Add(new StringContent(setting.lsid.ToString()), "lsid");
            form.Add(new StringContent((setting.ls_common_normal_values ?? false).ToString()), "ls_common_normal_values");
            form.Add(new StringContent((setting.ls_select_normal_values ?? false).ToString()), "ls_select_normal_values");
            form.Add(new StringContent((setting.ls_hide_signature ?? false).ToString()), "ls_hide_signature");
            form.Add(new StringContent((setting.authorize_results ?? false).ToString()), "authorize_results");
            form.Add(new StringContent((setting.sample_collection ?? false).ToString()), "sample_collection");
            form.Add(new StringContent((setting.direct_result ?? false).ToString()), "direct_result");
            form.Add(new StringContent((setting.pathology_no ?? false).ToString()), "pathology_no");
            form.Add(new StringContent((setting.multi_branch ?? false).ToString()), "multi_branch");
            form.Add(new StringContent((setting.report_qr ?? true).ToString()), "report_qr");
            form.Add(new StringContent((setting.is_slot_required ?? true).ToString()), "is_slot_required");
            form.Add(new StringContent((setting.op_age_wise_split ?? false).ToString()), "op_age_wise_split");

            form.Add(new StringContent(setting.lab_report_name ?? ""), "lab_report_name");
            form.Add(new StringContent(setting.cheque_name ?? ""), "cheque_name");
            form.Add(new StringContent(setting.report_header ?? ""), "report_header");
            form.Add(new StringContent(setting.report_footer ?? ""), "report_footer");

            form.Add(new StringContent(setting.bill_paper_size ?? "A4"), "bill_paper_size");
            form.Add(new StringContent(setting.bill_orientation ?? "portrait"), "bill_orientation");
            form.Add(new StringContent((setting.bill_white_sheet ?? false).ToString()), "bill_white_sheet");
            form.Add(new StringContent((setting.bill_letter_pad ?? false).ToString()), "bill_letter_pad");
            form.Add(new StringContent((setting.print_branch_name_in_bill ?? false).ToString()), "print_branch_name_in_bill");
            form.Add(new StringContent((setting.print_barcode ?? false).ToString()), "print_barcode");

            form.Add(new StringContent((setting.show_report_header_footer_image ?? true).ToString()), "show_report_header_footer_image");
            form.Add(new StringContent((setting.show_bill_header_footer_image ?? true).ToString()), "show_bill_header_footer_image");
            form.Add(new StringContent((setting.show_culture_header_footer_image ?? true).ToString()), "show_culture_header_footer_image");
            form.Add(new StringContent((setting.show_op_casesheet_header_footer_image ?? true).ToString()), "show_op_casesheet_header_footer_image");
            form.Add(new StringContent((setting.show_ip_casesheet_header_footer_image ?? true).ToString()), "show_ip_casesheet_header_footer_image");
            form.Add(new StringContent((setting.show_dischargesummary_header_footer_image ?? true).ToString()), "show_dischargesummary_header_footer_image");

            form.Add(new StringContent((setting.auth1_show ?? true).ToString()), "auth1_show");
            form.Add(new StringContent(setting.auth1_name ?? ""), "auth1_name");
            form.Add(new StringContent(setting.auth1_designation ?? ""), "auth1_designation");

            form.Add(new StringContent((setting.auth2_show ?? true).ToString()), "auth2_show");
            form.Add(new StringContent(setting.auth2_name ?? ""), "auth2_name");
            form.Add(new StringContent(setting.auth2_designation ?? ""), "auth2_designation");

            form.Add(new StringContent((setting.auth3_show ?? true).ToString()), "auth3_show");
            form.Add(new StringContent(setting.auth3_name ?? ""), "auth3_name");
            form.Add(new StringContent(setting.auth3_designation ?? ""), "auth3_designation");

            form.Add(new StringContent((setting.culture_auth1_show ?? true).ToString()), "culture_auth1_show");
            form.Add(new StringContent(setting.culture_auth1_name ?? ""), "culture_auth1_name");
            form.Add(new StringContent(setting.culture_auth1_designation ?? ""), "culture_auth1_designation");

            form.Add(new StringContent((setting.culture_auth2_show ?? true).ToString()), "culture_auth2_show");
            form.Add(new StringContent(setting.culture_auth2_name ?? ""), "culture_auth2_name");
            form.Add(new StringContent(setting.culture_auth2_designation ?? ""), "culture_auth2_designation");

            form.Add(new StringContent((setting.culture_auth3_show ?? true).ToString()), "culture_auth3_show");
            form.Add(new StringContent(setting.culture_auth3_name ?? ""), "culture_auth3_name");
            form.Add(new StringContent(setting.culture_auth3_designation ?? ""), "culture_auth3_designation");

            form.Add(new StringContent((setting.use_labsetting_signatures ?? true).ToString()), "use_labsetting_signatures");
            form.Add(new StringContent((setting.use_labsetting_culture_signatures ?? true).ToString()), "use_labsetting_culture_signatures");

            form.Add(new StringContent((setting.iscan_margin_top ?? 0).ToString()), "iscan_margin_top");
            form.Add(new StringContent((setting.iscan_margin_bottom ?? 0).ToString()), "iscan_margin_bottom");
            form.Add(new StringContent((setting.iscan_margin_left ?? 0).ToString()), "iscan_margin_left");
            form.Add(new StringContent((setting.iscan_margin_right ?? 0).ToString()), "iscan_margin_right");

            form.Add(new StringContent((setting.culture_margin_top ?? 0).ToString()), "culture_margin_top");
            form.Add(new StringContent((setting.culture_margin_bottom ?? 0).ToString()), "culture_margin_bottom");
            form.Add(new StringContent((setting.culture_margin_left ?? 0).ToString()), "culture_margin_left");
            form.Add(new StringContent((setting.culture_margin_right ?? 0).ToString()), "culture_margin_right");

            // Attach Image Files matching backend parameter names
            await AddFileToForm(form, headerFile, "headerFile");
            await AddFileToForm(form, footerFile, "footerFile");
            await AddFileToForm(form, auth1SigFile, "auth1SignatureFile");
            await AddFileToForm(form, auth2SigFile, "auth2SignatureFile");
            await AddFileToForm(form, auth3SigFile, "auth3SignatureFile");
            await AddFileToForm(form, cultureAuth1SigFile, "cultureAuth1SignatureFile");
            await AddFileToForm(form, cultureAuth2SigFile, "cultureAuth2SignatureFile");
            await AddFileToForm(form, cultureAuth3SigFile, "cultureAuth3SignatureFile");

            var success = await LabSettingService.SaveLabSettingAsync(form, isUpdate: true);
            if (success)
            {
                ToastService.ShowSuccess("Lab settings and images updated successfully!");
                // Clear selected file inputs
                headerFile = footerFile = auth1SigFile = auth2SigFile = auth3SigFile = cultureAuth1SigFile = cultureAuth2SigFile = cultureAuth3SigFile = null;
                await LoadSettings();
            }
            else
            {
                ToastService.ShowError("Failed to save lab settings. Please try again.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving lab settings: {ex.Message}");
            ToastService.ShowError("An error occurred while saving lab settings.");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task AddFileToForm(MultipartFormDataContent form, IBrowserFile? file, string paramName)
    {
        if (file == null) return;
        try
        {
            var maxFileSize = 10 * 1024 * 1024; // 10MB
            var stream = file.OpenReadStream(maxAllowedSize: maxFileSize);
            var content = new StreamContent(stream);
            content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            form.Add(content, paramName, file.Name);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error attaching file {paramName}: {ex.Message}");
        }
    }
}
