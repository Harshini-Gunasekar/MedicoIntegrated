@page "/purchasereturn"
@page "/purchase-return"
@using Booking.Models
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<PageTitle>Purchase Return</PageTitle>

<link rel="stylesheet" href="PurchaseMaster.css" />

<style>
    /* Modal Overlay & Dialog Backdrop - Fixed on Top like Purchase Master */
    .modal-overlay {
        position: fixed !important;
        inset: 0 !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        background: rgba(8, 25, 40, 0.45) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 1.25rem !important;
        z-index: 9999 !important;
        overflow-y: auto !important;
        animation: modalFadeIn 0.25s ease-out forwards;
    }

    .modal-card {
        width: min(1350px, 96%) !important;
        max-width: 1350px !important;
        background: #ffffff !important;
        border-radius: 16px !important;
        box-shadow: 0 25px 60px rgba(3, 26, 46, 0.35) !important;
        overflow: hidden !important;
        display: flex !important;
        flex-direction: column !important;
        max-height: calc(100vh - 2.5rem) !important;
        animation: modalScaleIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        position: relative;
        z-index: 10000;
        margin: auto;
    }

    .modal-header-bar {
        background: #ffffff !important;
        color: #1e293b !important;
        padding: 18px 28px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        border-bottom: 1px solid #f1f5f9 !important;
    }

    .modal-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .modal-title {
        font-weight: 800 !important;
        font-size: 1.25rem !important;
        letter-spacing: -0.2px !important;
        margin: 0 !important;
        color: #1e293b !important;
    }

    .modal-inner {
        padding: 20px 28px !important;
        background: #ffffff !important;
        overflow-y: auto !important;
        flex: 1 !important;
        max-height: calc(100vh - 120px) !important;
    }

    .btn-close-modal {
        background: #f1f5f9 !important;
        border: none !important;
        width: 36px !important;
        height: 36px !important;
        border-radius: 10px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        color: #64748b !important;
        font-size: 1rem !important;
        cursor: pointer !important;
        transition: all 0.2s !important;
    }

    .btn-close-modal:hover {
        background: #fee2e2 !important;
        color: #ef4444 !important;
    }

    @@keyframes modalFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes modalScaleIn {
        from { transform: scale(0.95) translateY(12px); opacity: 0; }
        to { transform: scale(1) translateY(0); opacity: 1; }
    }

    /* Item Search Typeahead Dropdown (Scrollable Stock Master) */
    .custom-typeahead-dropdown {
        position: absolute;
        top: calc(100% + 2px);
        left: 0;
        z-index: 99999 !important;
        max-height: 260px;
        overflow-y: auto;
        background: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 8px !important;
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.2), 0 4px 10px rgba(0, 0, 0, 0.08) !important;
        width: 380px;
        min-width: 320px;
    }
    .custom-typeahead-item {
        padding: 8px 12px;
        cursor: pointer;
        font-size: 0.78rem;
        text-align: left;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9;
        transition: background-color 0.15s ease, color 0.15s ease;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .custom-typeahead-item:last-child {
        border-bottom: none;
    }
    .custom-typeahead-item:hover {
        background-color: #eef2ff !important;
        color: #4f46e5 !important;
    }

    .purchase-page .items-content {
        text-align: left !important;
        width: 100% !important;
    }

    /* Return Details Table inside Modal */
    .return-items-table-wrapper {
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        overflow: visible !important;
        background: #ffffff;
        margin-bottom: 8px;
    }
    .return-items-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.82rem;
        min-width: 980px;
    }
    .return-items-table thead {
        background: #4f46e5;
        color: #ffffff;
    }
    .return-items-table thead th {
        font-weight: 700;
        font-size: 0.72rem;
        color: #ffffff;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 11px 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        border-right: 1px solid rgba(255, 255, 255, 0.15);
    }
    .return-items-table thead th:last-child {
        border-right: none;
    }
    .return-items-table tbody td {
        border-bottom: 1px solid #e2e8f0;
        border-right: 1px solid #f1f5f9;
        padding: 5px 6px;
        vertical-align: middle;
        overflow: visible !important;
    }
    .return-items-table tbody td:last-child {
        border-right: none;
    }
</style>

<div class="items-page purchase-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">

            <!-- PREMIUM HEADER CARD (Exact Match to Purchase Master) -->
            <div class="premium-header-card mb-4">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                            <path d="M21 3v5h-5" />
                            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
                            <path d="M3 21v-5h5" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Purchase Return</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total returns : @PurchaseReturnLogs.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <!-- Search Input -->
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search return no, item, vendor..." @bind="SearchText" @bind:event="oninput" />
                    </div>

                    <!-- Date Filter -->
                    <div style="display: flex; align-items: center; gap: 4px;">
                        <input type="date" class="form-control" value="@(FilterLogDate?.ToString("yyyy-MM-dd"))" @onchange="OnLogDateFilterChanged" style="height: 38px; font-size: 0.8rem; border-radius: 20px; border: 1px solid #cbd5e1; width: 135px; padding: 0 10px; background: #fff;" />
                        @if (FilterLogDate.HasValue)
                        {
                            <button type="button" class="btn btn-sm" @onclick='() => { FilterLogDate = null; }' title="Clear Date" style="height: 38px; width: 30px; border: 1px solid #fca5a5; border-radius: 12px; background: #fef2f2; color: #dc2626; padding: 0;">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>

                    <!-- Store Filter Dropdown -->
                    <select class="form-control" @bind="FilterLogStore" style="height: 38px; border-radius: 20px; border: 1px solid #cbd5e1; font-size: 0.8rem; padding: 0 14px; background: #fff; color: #1e293b; width: 140px;">
                        <option value="0">All Stores</option>
                        @foreach (var w in WarehouseList)
                        {
                            <option value="@w.warehousecode">@w.warehousename</option>
                        }
                    </select>

                    <!-- View Toggle -->
                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    <!-- Refresh Button -->
                    <button type="button" class="btn btn-sm" @onclick="LoadPurchaseReturnLogs" disabled="@IsLoadingLogs" title="Refresh Logs" style="height: 38px; width: 38px; border-radius: 50%; border: 1px solid #cbd5e1; background: #ffffff; color: #4f46e5; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="bi bi-arrow-clockwise @(IsLoadingLogs ? "spin" : "")" style="font-size: 1rem;"></i>
                    </button>

                    <!-- Add Purchase Return Button -->
                    @if (hasCreateRight)
                    {
                        <button class="add-item-btn" @onclick="OpenNewReturnModal">
                            <i class="bi bi-plus-lg"></i>
                            <span class="ms-1">New Purchase Return</span>
                        </button>
                    }
                </div>
            </div>

            <!-- MAIN PURCHASES / RETURNS LOG CARD -->
            <div class="card items-main-card">
                @if (IsLoadingLogs)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status" style="width: 2rem; height: 2rem;"></div>
                        <p class="mt-2 text-muted" style="font-size: 0.82rem;">Loading return history...</p>
                    </div>
                }
                else if (!FilteredReturnLogs.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-box-arrow-left fs-1 d-block mb-3 text-secondary"></i>
                        <h6 style="font-weight: 700; color: #475569;">No Purchase Returns Found</h6>
                        <p class="text-muted mb-0" style="font-size: 0.78rem;">There are no return records matching the current filters.</p>
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 55px; text-align: center;">S.NO</th>
                                    <th style="width: 140px; text-align: left;">RETURN NO</th>
                                    <th style="width: 110px; text-align: center;">DATE</th>
                                    <th style="width: 140px; text-align: left;">STORE</th>
                                    <th style="width: 180px; text-align: left;">VENDOR</th>
                                    <th style="text-align: left;">ITEM NAME</th>
                                    <th style="width: 100px; text-align: center;">BATCH NO</th>
                                    <th style="width: 85px; text-align: center;">RETURN QTY</th>
                                    <th style="width: 75px; text-align: center;">PACK SIZE</th>
                                    <th style="width: 85px; text-align: center;">TOTAL QTY</th>
                                    <th style="width: 95px; text-align: right;">UNIT COST</th>
                                    <th style="width: 105px; text-align: right;">AMOUNT</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedReturnLogs.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td style="text-align: center; font-weight: 700; color: #3b82f6;">@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td style="text-align: left; font-weight: 700; color: #4f46e5;">
                                            #@(!string.IsNullOrEmpty(row.value.remarks) ? row.value.remarks : $"PR-{row.value.purchasereturncode}")
                                        </td>
                                        <td style="text-align: center; color: #475569; font-size: 0.78rem;">
                                            @(row.value.createddate != default ? row.value.createddate.ToString("yyyy-MM-dd") : "-")
                                        </td>
                                        <td style="text-align: left; color: #334155; font-weight: 600;">
                                            @(GetWarehouseName(row.value.warehousecode))
                                        </td>
                                        <td style="text-align: left; color: #1e293b; font-weight: 600;">
                                            @(GetVendorName(row.value.vendorcode))
                                        </td>
                                        <td style="text-align: left; color: #0f172a; font-weight: 600;">
                                            @(GetItemName(row.value.itemcode))
                                        </td>
                                        <td style="text-align: center;">
                                            <span class="badge" style="background: #f1f5f9; color: #334155; font-weight: 600; border: 1px solid #cbd5e1; font-size: 0.72rem;">
                                                @(string.IsNullOrEmpty(row.value.batchno) ? "-" : row.value.batchno)
                                            </span>
                                        </td>
                                        <td style="text-align: center; font-weight: 700; color: #0f172a;">@row.value.returnqty</td>
                                        <td style="text-align: center; color: #64748b;">@row.value.packsize</td>
                                        <td style="text-align: center; font-weight: 700; color: #4338ca;">@row.value.totalqty</td>
                                        <td style="text-align: right; color: #334155; font-weight: 600;">₹@row.value.rate.ToString("N2")</td>
                                        <td style="text-align: right; color: #dc2626; font-weight: 700; background: #fff5f5;">₹@row.value.amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var r in PagedReturnLogs)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span class="card-item-code">#@(!string.IsNullOrEmpty(r.remarks) ? r.remarks : $"PR-{r.purchasereturncode}")</span>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.72rem; font-weight: 700;">
                                        @(GetWarehouseName(r.warehousecode))
                                    </span>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Date</span><strong>@(r.createddate != default ? r.createddate.ToString("yyyy-MM-dd") : "-")</strong></div>
                                    <div class="detail-row"><span>Vendor</span><strong>@(GetVendorName(r.vendorcode))</strong></div>
                                    <div class="detail-row"><span>Item</span><strong>@(GetItemName(r.itemcode))</strong></div>
                                    <div class="detail-row"><span>Batch</span><strong>@(string.IsNullOrEmpty(r.batchno) ? "-" : r.batchno)</strong></div>
                                    <div class="detail-row"><span>Return Qty</span><strong>@r.returnqty (Total: @r.totalqty)</strong></div>
                                    <div class="detail-row"><span>Amount</span><strong style="color: #dc2626;">₹@r.amount.ToString("N2")</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Pagination Footer -->
                <div class="display-controls px-4 py-3 border-top" style="display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left;">
                        @if (FilteredReturnLogs.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredReturnLogs.Count))</strong> of <strong>@FilteredReturnLogs.Count</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1" style="align-items: center;">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @foreach (var pageNum in GetVisiblePageNumbers())
                            {
                                var pg = pageNum;
                                <button class="page-btn @(CurrentPage == pg ? "active" : "")" @onclick="() => ChangePage(pg)">
                                    @pg
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- POPUP MODAL FOR NEW PURCHASE RETURN -->
@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 1350px; width: 95%; max-height: 92vh; display: flex; flex-direction: column; overflow: hidden;">
            <!-- Modal Header Bar -->
            <div class="modal-header-bar" style="padding: 18px 28px !important; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f1f5f9; background: #ffffff;">
                <div class="modal-header-left" style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 38px; height: 38px; border-radius: 10px; background: #eef2ff; color: #4f46e5; display: flex; align-items: center; justify-content: center; font-size: 1.15rem; border: 1px solid rgba(79, 70, 229, 0.15);">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </div>
                    <div>
                        <h3 class="modal-title" style="font-weight: 800; font-size: 1.2rem; letter-spacing: -0.2px; margin: 0; color: #1e293b;">New Purchase Return</h3>
                        <span style="font-size: 0.74rem; color: #64748b; font-weight: 500;">Return multiple items to vendor and update inventory stock</span>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Modal Inner Body Area -->
            <div class="modal-inner" style="padding: 22px 28px; overflow-y: auto; flex: 1; max-height: calc(92vh - 80px);">
                <EditForm Model="CurrentReturnRequest" OnValidSubmit="SubmitReturn" autocomplete="off">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <!-- RETURN HEADER INFORMATION (4-Column Responsive Grid) -->
                    <div class="form-section-header" style="margin-top: 0; margin-bottom: 10px; padding-bottom: 2px; border-bottom: 1px solid #f1f5f9;">
                        <div class="form-section-title" style="font-size: 0.82rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Return Header Information</div>
                    </div>

                    <div class="form-grid mb-4" style="display: grid; grid-template-columns: 2.2fr 1.8fr 1.5fr 1.2fr; gap: 16px; width: 100%; box-sizing: border-box;">
                        <!-- 1. Vendor Selection -->
                        <div class="field-group" style="min-width: 0; gap: 4px;">
                            <label class="field-label required" style="font-size: 0.74rem; font-weight: 700; color: #374151; text-transform: uppercase;">Vendor *</label>
                            <div style="position: relative;">
                                <select class="form-control premium-input" @bind="CurrentReturnRequest.vendorcode" style="height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 0.82rem; width: 100%; padding-right: 28px;">
                                    <option value="0">-- Select Vendor --</option>
                                    @foreach (var v in VendorList)
                                    {
                                        <option value="@v.vendorCode">@v.vendorName</option>
                                    }
                                </select>
                                <i class="bi bi-chevron-down" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b; font-size: 0.8rem;"></i>
                            </div>
                        </div>

                        <!-- 2. Store Selection -->
                        <div class="field-group" style="min-width: 0; gap: 4px;">
                            <label class="field-label" style="font-size: 0.74rem; font-weight: 700; color: #374151; text-transform: uppercase;">Store</label>
                            <div style="position: relative;">
                                <select class="form-control premium-input" @bind="SelectedDefaultWarehouseCode" @bind:after="OnDefaultStoreChanged" style="height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 0.82rem; width: 100%; padding-right: 28px;">
                                    <option value="0">-- All Stores --</option>
                                    @foreach (var w in WarehouseList)
                                    {
                                        <option value="@w.warehousecode">@w.warehousename</option>
                                    }
                                </select>
                                <i class="bi bi-chevron-down" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b; font-size: 0.8rem;"></i>
                            </div>
                        </div>

                        <!-- 3. Return No / Ref -->
                        <div class="field-group" style="min-width: 0; gap: 4px;">
                            <label class="field-label" style="font-size: 0.74rem; font-weight: 700; color: #374151; text-transform: uppercase;">Return No / Ref</label>
                            <input type="text" class="form-control premium-input" @bind-value="ReturnReferenceNo" placeholder="PR-YYYYMMDD-XXXX" style="height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 0.82rem; font-weight: 700; color: #4f46e5;" />
                        </div>

                        <!-- 4. Return Date -->
                        <div class="field-group" style="min-width: 0; gap: 4px;">
                            <label class="field-label" style="font-size: 0.74rem; font-weight: 700; color: #374151; text-transform: uppercase;">Return Date</label>
                            <input type="date" class="form-control premium-input" value="@ReturnDate.ToString("yyyy-MM-dd")" @onchange="@(e => { if (DateTime.TryParse(e.Value?.ToString(), out var dt)) ReturnDate = dt; })" style="height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 0.82rem;" />
                        </div>
                    </div>

                    <!-- RETURN ITEM DETAILS SECTION -->
                    <div class="form-section-header" style="margin-top: 14px; margin-bottom: 8px; padding-bottom: 2px; border-bottom: 1px solid #f1f5f9;">
                        <div class="form-section-title" style="font-size: 0.82rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Return Item Details</div>
                    </div>

                    <!-- MULTI-ITEM RETURN TABLE GRID -->
                    <div class="return-items-table-wrapper">
                        <table class="return-items-table">
                            <thead>
                                <tr>
                                    <th style="width: 40px; text-align: center;">S.NO</th>
                                    <th style="min-width: 260px; text-align: left;">ITEM</th>
                                    <th style="width: 130px; text-align: center;">BATCH NO</th>
                                    <th style="width: 130px; text-align: left;">STORE</th>
                                    <th style="width: 75px; text-align: center;">PACK SIZE</th>
                                    <th style="width: 80px; text-align: center;">RETURN QTY</th>
                                    <th style="width: 80px; text-align: center;">TOTAL QTY</th>
                                    <th style="width: 90px; text-align: right;">UNIT COST</th>
                                    <th style="width: 85px; text-align: center;">STOCK QTY</th>
                                    <th style="width: 100px; text-align: right;">AMOUNT</th>
                                    <th style="width: 45px; text-align: center;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var itemRow in ReturnRows.Select((row, index) => new { row, index }))
                                {
                                    var r = itemRow.row;
                                    var idx = itemRow.index;
                                    var availableBatches = GetAvailableBatchesForItem(r.itemcode, r.warehousecode);

                                    <tr style="background: @(idx % 2 == 0 ? "#ffffff" : "#fbfcfe");">
                                        <!-- S.No -->
                                        <td style="text-align: center; font-weight: 700; color: #6366f1; width: 40px;">
                                            @(idx + 1)
                                        </td>

                                        <!-- Item Typeahead (Scrollable from Stock Master) -->
                                        <td style="position: relative; overflow: visible !important; min-width: 260px;">
                                            <div style="position: relative; width: 100%;">
                                                <input id="item-input-@idx"
                                                       type="text"
                                                       class="form-control"
                                                       style="width: 100%; height: 34px; font-size: 0.8rem; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0 8px; background: #fff;"
                                                       placeholder="Type to search stock item..."
                                                       autocomplete="off"
                                                       value="@(ItemSearchTexts.GetValueOrDefault(r, ItemList.FirstOrDefault(i => i.itemcode == r.itemcode)?.itemname ?? ""))"
                                                       @oninput="@(e => FilterItems(e, r))"
                                                       @onfocus="@(() => OnSearchFocus(r))"
                                                       @onclick="@(() => OnSearchFocus(r))"
                                                       @onblur="OnSearchBlur" />

                                                @if (ActiveSearchRow == r)
                                                {
                                                    var searchText = ItemSearchTexts.GetValueOrDefault(r, "");
                                                    var filteredStockItems = GetAvailableStockItems(r, searchText);

                                                    <div class="custom-typeahead-dropdown">
                                                        @if (filteredStockItems.Any())
                                                        {
                                                            @foreach (var stockItem in filteredStockItems)
                                                            {
                                                                <div class="custom-typeahead-item" 
                                                                     @onmousedown="@(() => SelectItemFromStockDropdown(r, stockItem.Item, stockItem.Stock))">
                                                                    <div style="text-align: left;">
                                                                        <div style="font-weight: 700; color: #1e293b; font-size: 0.82rem;">@stockItem.Item.itemname</div>
                                                                        <div style="font-size: 0.72rem; color: #64748b; margin-top: 2px;">
                                                                            @if (!string.IsNullOrEmpty(stockItem.Stock.batchno))
                                                                            {
                                                                                <span>Batch: <strong style="color: #4f46e5;">@stockItem.Stock.batchno</strong> | </span>
                                                                            }
                                                                            <span>Store: @(GetWarehouseName(stockItem.Stock.warehousecode > 0 ? stockItem.Stock.warehousecode : r.warehousecode))</span>
                                                                        </div>
                                                                    </div>
                                                                    <div style="text-align: right; flex-shrink: 0; margin-left: 10px;">
                                                                        <span class="badge" style="background: @(stockItem.Stock.closingstock > 0 ? "#e0e7ff" : "#f1f5f9"); color: @(stockItem.Stock.closingstock > 0 ? "#4338ca" : "#64748b"); font-size: 0.74rem; font-weight: 700;">
                                                                            Stock: @stockItem.Stock.closingstock
                                                                        </span>
                                                                        @if (stockItem.Stock.unitcost > 0)
                                                                        {
                                                                            <div style="font-size: 0.72rem; color: #059669; font-weight: 600; margin-top: 2px;">
                                                                                ₹@stockItem.Stock.unitcost.ToString("N2")
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div style="padding: 12px; text-align: center; color: #64748b; font-size: 0.78rem;">
                                                                No matching stock items found
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </td>

                                        <!-- Batch Dropdown -->
                                        <td style="text-align: center; width: 130px;">
                                            <select class="form-control" 
                                                    value="@r.batchno" 
                                                    @onchange="@(async (e) => await OnBatchChangedForRow(r, e.Value?.ToString() ?? ""))"
                                                    style="width: 100%; height: 34px; font-size: 0.75rem; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0 4px; background: #fff;">
                                                <option value="">-- Select Batch --</option>
                                                @foreach (var b in availableBatches)
                                                {
                                                    <option value="@b">@b</option>
                                                }
                                            </select>
                                        </td>

                                        <!-- Store / Warehouse Dropdown -->
                                        <td style="width: 130px;">
                                            <select class="form-control" 
                                                    value="@(r.warehousecode ?? 0)" 
                                                    @onchange="@(async (e) => await OnStoreChangedForRow(r, e.Value?.ToString()))"
                                                    style="width: 100%; height: 34px; font-size: 0.75rem; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0 4px; background: #fff;">
                                                <option value="0">-- Store --</option>
                                                @foreach (var w in WarehouseList)
                                                {
                                                    <option value="@w.warehousecode">@w.warehousename</option>
                                                }
                                            </select>
                                        </td>

                                        <!-- Pack Size -->
                                        <td style="text-align: center; width: 75px;">
                                            <input type="number" step="any" class="form-control text-center" 
                                                   value="@r.packsize" 
                                                   @oninput="@((e) => OnPackSizeInput(r, e))"
                                                   style="width: 100%; height: 34px; font-size: 0.78rem; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0 4px;" />
                                        </td>

                                        <!-- Return Qty -->
                                        <td style="text-align: center; width: 80px;">
                                            <input type="number" step="any" class="form-control text-center" 
                                                   value="@r.returnqty" 
                                                   @oninput="@((e) => OnReturnQtyInput(r, e))"
                                                   placeholder="0"
                                                   style="width: 100%; height: 34px; font-size: 0.78rem; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0 4px; color: #0f172a;" />
                                        </td>

                                        <!-- Total Qty -->
                                        <td style="text-align: center; font-weight: 700; color: #4338ca; font-size: 0.8rem; width: 80px;">
                                            @r.totalqty
                                        </td>

                                        <!-- Unit Cost / Rate -->
                                        <td style="text-align: right; font-weight: 600; color: #334155; font-size: 0.78rem; width: 90px;">
                                            ₹@r.rate.ToString("N2")
                                        </td>

                                        <!-- Available Stock Qty -->
                                        <td style="text-align: center; width: 85px;">
                                            <span class="badge" style="background: @(r.availablestock >= r.totalqty && r.availablestock > 0 ? "#f0fdf4" : "#fef2f2"); color: @(r.availablestock >= r.totalqty && r.availablestock > 0 ? "#16a34a" : "#dc2626"); border: 1px solid @(r.availablestock >= r.totalqty && r.availablestock > 0 ? "#bbf7d0" : "#fecaca"); font-size: 0.74rem; font-weight: 700; padding: 3px 6px; border-radius: 6px;">
                                                @r.availablestock
                                            </span>
                                        </td>

                                        <!-- Total Amount -->
                                        <td style="text-align: right; font-weight: 700; color: #dc2626; font-size: 0.82rem; background: #fff5f5; width: 100px;">
                                            ₹@r.amount.ToString("N2")
                                        </td>

                                        <!-- Action (Delete Row) -->
                                        <td style="text-align: center; width: 45px;">
                                            <button type="button" class="btn btn-outline-danger btn-sm" 
                                                    style="border-radius: 6px; padding: 3px 6px; border: none; background: rgba(239, 68, 68, 0.08); color: #dc2626;" 
                                                    @onclick="() => RemoveRow(r)" title="Delete Row">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Sub-bar: Total Items count & Add Item button -->
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 4px 4px; width: 100%;">
                        <div style="color: #475569; font-weight: 600; font-size: 0.82rem; display: flex; align-items: center; gap: 6px;">
                            <span>Total Return Items:</span>
                            <span style="background: #e0e7ff; color: #4338ca; font-weight: 800; font-size: 0.82rem; padding: 2px 10px; border-radius: 6px; border: 1px solid #c7d2fe;">
                                @(ReturnRows.Count(r => r.itemcode > 0))
                            </span>
                        </div>
                        
                        <div>
                            <button type="button" class="btn-dotted-add" @onclick="AddRow" style="padding: 5px 22px; font-size: 0.82rem; border-radius: 16px; border: 2px dashed #4f46e5; color: #4f46e5; background: #f8fafc; font-weight: 700; cursor: pointer;">
                                <i class="bi bi-plus-circle-fill" style="font-size: 0.88rem; margin-right: 4px;"></i> Add Item
                            </button>
                        </div>
                    </div>

                    <!-- Clean Bottom Totals Bar -->
                    <div style="display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 16px; margin-top: 14px; margin-bottom: 6px; padding: 10px 18px; background: #f8fafc; border-radius: 10px; border: 1px solid #e2e8f0;">
                        <div style="display: inline-flex; align-items: center; gap: 8px;">
                            <span style="color: #64748b; font-weight: 700; font-size: 0.8rem; text-transform: uppercase;">Total Active Rows:</span>
                            <span style="font-weight: 800; font-size: 0.95rem; color: #1e293b;">@ReturnRows.Count(r => r.itemcode > 0)</span>
                        </div>

                        <div style="display: inline-flex; align-items: center; gap: 8px;">
                            <span style="color: #64748b; font-weight: 700; font-size: 0.8rem; text-transform: uppercase;">Total Return Quantity:</span>
                            <span style="font-weight: 800; font-size: 1rem; color: #4338ca;">@TotalReturnQty</span>
                        </div>

                        <div style="display: inline-flex; align-items: center; gap: 8px;">
                            <span style="color: #64748b; font-weight: 700; font-size: 0.8rem; text-transform: uppercase;">Net Return Amount:</span>
                            <span style="font-weight: 800; font-size: 1.15rem; color: #dc2626;">₹@TotalReturnAmount.ToString("N2")</span>
                        </div>
                    </div>

                    <!-- Modal Footer Buttons -->
                    <div style="display: flex; justify-content: flex-end; align-items: center; gap: 12px; margin-top: 16px; padding-top: 12px; border-top: 1px solid #f1f5f9;">
                        <button type="button" class="btn-cancel-modal" @onclick="CloseModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.55rem 1.6rem; border-radius: 10px; font-weight: 700; min-width: 100px; transition: all 0.2s;">
                            Cancel
                        </button>
                        <button type="submit" class="btn-save-premium" disabled="@IsSaving" style="min-width: 180px; height: 42px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; border-radius: 10px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; font-weight: 600; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25); transition: all 0.2s; cursor: pointer;">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" style="width: 1rem; height: 1rem;"></span>
                                <span>Saving Return...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                                <span>Save Return</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private string DefaultTenant = "";
    private long CurrentUserCode = 1;

    private List<inventory_item_master> ItemList = new();
    private List<stock_master> StockList = new();
    private List<warehouse_master> WarehouseList = new();
    private List<vendor_master> VendorList = new();
    private List<purchase_return_master> PurchaseReturnLogs = new();

    // Multi-Item Row Model for UI Form
    public class ReturnItemRow
    {
        public long purchasedetailcode { get; set; }
        public long purchasecode { get; set; }
        public long itemcode { get; set; }
        public string batchno { get; set; } = "";
        public long? warehousecode { get; set; }
        public decimal packsize { get; set; } = 1;
        public decimal returnqty { get; set; } = 0;
        public decimal totalqty => returnqty * (packsize > 0 ? packsize : 1);
        public decimal rate { get; set; } = 0;
        public decimal amount => totalqty * rate;
        public decimal availablestock { get; set; } = 0;
    }

    // Helper Model for Stock Typeahead Items
    public class StockItemDropdownModel
    {
        public inventory_item_master Item { get; set; } = new();
        public stock_master Stock { get; set; } = new();
    }

    private purchase_return_request CurrentReturnRequest = new();
    private List<ReturnItemRow> ReturnRows = new();
    private string ReturnReferenceNo = "";
    private DateTime ReturnDate = DateTime.Now;
    private long SelectedDefaultWarehouseCode = 0;

    private bool ShowModal = false;
    private bool IsCardView = false;
    private bool IsSaving = false;
    private bool IsLoadingLogs = false;
    private string SearchText = "";
    private DateTime? FilterLogDate;
    private long FilterLogStore = 0;

    private int CurrentPage = 1;
    private int ItemsPerPage = 10;

    private bool hasViewRight = true;
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    // Typeahead search tracking per row
    private ReturnItemRow? ActiveSearchRow = null;
    private Dictionary<ReturnItemRow, string> ItemSearchTexts = new();
    private CancellationTokenSource? _searchBlurCts;

    private decimal TotalReturnQty => ReturnRows.Where(r => r.itemcode > 0).Sum(r => r.totalqty);
    private decimal TotalReturnAmount => ReturnRows.Where(r => r.itemcode > 0).Sum(r => r.amount);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
            
            try
            {
                bool isAdmin = false;
                try
                {
                    var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userResult.Success && userResult.Value != null)
                    {
                        CurrentUserCode = userResult.Value.UserCode.HasValue && userResult.Value.UserCode.Value > 0 ? (long)userResult.Value.UserCode.Value : 1;
                        isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                  userResult.Value.UserCode == 0 ||
                                  userResult.Value.UserCode == 1;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking user details: {ex.Message}");
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                    hasEditRight = true;
                    hasDeleteRight = true;
                }
                else
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var pageRight = rightsResult.Value.FirstOrDefault(r => 
                            r.ModuleName != null && 
                            r.ModuleName.Trim().Equals("Purchase_Return", StringComparison.OrdinalIgnoreCase));
                        
                        if (pageRight != null)
                        {
                            hasViewRight = pageRight.ToView;
                            hasCreateRight = pageRight.ToAdd;
                            hasEditRight = pageRight.ToEdit;
                            hasDeleteRight = pageRight.ToDelete;
                        }
                        else
                        {
                            hasViewRight = false;
                            hasCreateRight = false;
                        }
                    }
                    else
                    {
                        hasViewRight = false;
                        hasCreateRight = false;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking Purchase_Return rights: {ex.Message}");
                hasViewRight = false;
                hasCreateRight = false;
            }

            if (!hasViewRight)
            {
                ToastService.ShowError("You do not have permission to access Purchase Return.");
                Nav.NavigateTo("/home");
                return;
            }

            await Task.WhenAll(LoadItems(), LoadStocks(), LoadWarehouses(), LoadVendors(), LoadPurchaseReturnLogs());
            ResetForm();
            StateHasChanged();
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
        return client;
    }

    private void SetView(bool isCard)
    {
        IsCardView = isCard;
    }

    private void OpenNewReturnModal()
    {
        ResetForm();
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
        ActiveSearchRow = null;
    }

    private void ResetForm()
    {
        CurrentReturnRequest = new purchase_return_request
        {
            vendorcode = 0,
            usercode = CurrentUserCode,
            tenantcode = DefaultTenant,
            remarks = "Damaged batch return"
        };
        ReturnReferenceNo = "PR-" + DateTime.Now.ToString("yyyyMMdd") + "-" + new Random().Next(1000, 9999);
        ReturnDate = DateTime.Now;
        SelectedDefaultWarehouseCode = WarehouseList.FirstOrDefault(w => !w.isdeleted)?.warehousecode ?? 0;

        ReturnRows = new List<ReturnItemRow>
        {
            new ReturnItemRow
            {
                warehousecode = SelectedDefaultWarehouseCode > 0 ? SelectedDefaultWarehouseCode : WarehouseList.FirstOrDefault()?.warehousecode,
                packsize = 1,
                returnqty = 0,
                rate = 0
            }
        };

        ItemSearchTexts.Clear();
        ActiveSearchRow = null;
    }

    private void OnDefaultStoreChanged()
    {
        if (SelectedDefaultWarehouseCode > 0)
        {
            foreach (var r in ReturnRows)
            {
                if (r.warehousecode == null || r.warehousecode <= 0)
                {
                    r.warehousecode = SelectedDefaultWarehouseCode;
                }
            }
        }
    }

    private void AddRow()
    {
        ReturnRows.Add(new ReturnItemRow
        {
            warehousecode = SelectedDefaultWarehouseCode > 0 ? SelectedDefaultWarehouseCode : WarehouseList.FirstOrDefault()?.warehousecode,
            packsize = 1,
            returnqty = 0,
            rate = 0
        });
    }

    private void RemoveRow(ReturnItemRow row)
    {
        if (ReturnRows.Count > 1)
        {
            ReturnRows.Remove(row);
            ItemSearchTexts.Remove(row);
        }
        else
        {
            // Reset single row
            row.itemcode = 0;
            row.batchno = "";
            row.returnqty = 0;
            row.packsize = 1;
            row.rate = 0;
            row.availablestock = 0;
            ItemSearchTexts.Remove(row);
        }
    }

    private void OnSearchFocus(ReturnItemRow row)
    {
        _searchBlurCts?.Cancel();
        ActiveSearchRow = row;
    }

    private void FilterItems(ChangeEventArgs e, ReturnItemRow row)
    {
        _searchBlurCts?.Cancel();
        var text = e.Value?.ToString() ?? "";
        ItemSearchTexts[row] = text;
        ActiveSearchRow = row;

        var matched = ItemList.FirstOrDefault(i => string.Equals(i.itemname, text, StringComparison.OrdinalIgnoreCase));
        if (matched != null)
        {
            row.itemcode = matched.itemcode;
            _ = OnItemChanged(row);
        }
        else
        {
            row.itemcode = 0;
            row.batchno = "";
            row.rate = 0;
            row.availablestock = 0;
        }
    }

    private async Task OnSearchBlur()
    {
        _searchBlurCts?.Cancel();
        _searchBlurCts = new CancellationTokenSource();
        var token = _searchBlurCts.Token;
        try
        {
            await Task.Delay(250, token);
            if (!token.IsCancellationRequested)
            {
                ActiveSearchRow = null;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    // Get stock items scrollable from stock master (same as in Pharmacy Billing)
    private List<StockItemDropdownModel> GetAvailableStockItems(ReturnItemRow row, string search)
    {
        var term = search?.Trim() ?? "";
        var result = new List<StockItemDropdownModel>();
        long effectiveStore = row.warehousecode ?? SelectedDefaultWarehouseCode;

        // 1. Gather all stock items matching the query or all if empty
        var stockMatches = StockList.AsEnumerable();
        if (effectiveStore > 0)
        {
            var storeSpecific = stockMatches.Where(s => s.warehousecode == effectiveStore).ToList();
            if (storeSpecific.Any())
            {
                stockMatches = storeSpecific;
            }
        }

        var itemMap = ItemList.ToDictionary(i => (long)i.itemcode, i => i);

        // Filter stock items with closing stock
        foreach (var st in stockMatches.Where(s => s.closingstock > 0))
        {
            itemMap.TryGetValue(st.itemcode, out var itemMaster);
            var itemName = itemMaster?.itemname ?? $"Item #{st.itemcode}";
            
            if (string.IsNullOrWhiteSpace(term) || 
                itemName.Contains(term, StringComparison.OrdinalIgnoreCase) || 
                (!string.IsNullOrEmpty(st.batchno) && st.batchno.Contains(term, StringComparison.OrdinalIgnoreCase)))
            {
                result.Add(new StockItemDropdownModel
                {
                    Item = itemMaster ?? new inventory_item_master { itemcode = (int)st.itemcode, itemname = itemName },
                    Stock = st
                });
            }
        }

        // Also if user searches an item in ItemList that might have 0 stock or not in StockList
        var matchedItems = ItemList
            .Where(i => string.IsNullOrWhiteSpace(term) || (i.itemname != null && i.itemname.Contains(term, StringComparison.OrdinalIgnoreCase)))
            .ToList();

        foreach (var item in matchedItems)
        {
            if (!result.Any(r => r.Item.itemcode == item.itemcode))
            {
                var st = StockList.FirstOrDefault(s => s.itemcode == item.itemcode && (effectiveStore <= 0 || s.warehousecode == effectiveStore))
                      ?? new stock_master
                      {
                          itemcode = item.itemcode,
                          closingstock = 0,
                          batchno = "",
                          unitcost = item.purchaserate > 0 ? item.purchaserate : (item.salesrate > 0 ? item.salesrate : 0),
                          warehousecode = effectiveStore > 0 ? effectiveStore : 0
                      };

                result.Add(new StockItemDropdownModel { Item = item, Stock = st });
            }
        }

        return result.Take(40).ToList();
    }

    private async Task SelectItemFromStockDropdown(ReturnItemRow row, inventory_item_master item, stock_master stock)
    {
        _searchBlurCts?.Cancel();
        row.itemcode = item.itemcode;
        ItemSearchTexts[row] = item.itemname ?? "";
        row.batchno = stock.batchno ?? "";
        if (stock.warehousecode.HasValue && stock.warehousecode.Value > 0)
        {
            row.warehousecode = stock.warehousecode.Value;
        }
        else if (SelectedDefaultWarehouseCode > 0)
        {
            row.warehousecode = SelectedDefaultWarehouseCode;
        }
        row.rate = stock.unitcost;
        row.availablestock = stock.closingstock;
        ActiveSearchRow = null;

        await LookupBatch(row);
        StateHasChanged();
    }

    private async Task OnItemChanged(ReturnItemRow row)
    {
        if (row.warehousecode == null || row.warehousecode <= 0)
        {
            row.warehousecode = SelectedDefaultWarehouseCode > 0 ? SelectedDefaultWarehouseCode : WarehouseList.FirstOrDefault()?.warehousecode;
        }

        var batches = GetAvailableBatchesForItem(row.itemcode, row.warehousecode).ToList();
        if (batches.Count == 1)
        {
            row.batchno = batches.First();
            await LookupBatch(row);
        }
        else
        {
            row.batchno = "";
            row.rate = 0;
            row.availablestock = 0;
        }
    }

    private IEnumerable<string> GetAvailableBatchesForItem(long itemcode, long? warehousecode)
    {
        if (itemcode <= 0) return Enumerable.Empty<string>();

        var query = StockList.Where(s => s.itemcode == itemcode && s.closingstock > 0 && !string.IsNullOrEmpty(s.batchno));
        if (warehousecode.HasValue && warehousecode.Value > 0)
        {
            var storeFiltered = query.Where(s => s.warehousecode == warehousecode.Value).Select(s => s.batchno!).Distinct().ToList();
            if (storeFiltered.Any()) return storeFiltered;
        }

        return query.Select(s => s.batchno!).Distinct();
    }

    private async Task OnBatchChangedForRow(ReturnItemRow row, string batch)
    {
        row.batchno = batch;
        if (!string.IsNullOrEmpty(batch))
        {
            await LookupBatch(row);
        }
        else
        {
            row.rate = 0;
            row.availablestock = 0;
        }
    }

    private async Task OnStoreChangedForRow(ReturnItemRow row, string? storeVal)
    {
        if (long.TryParse(storeVal, out var wCode))
        {
            row.warehousecode = wCode;
            if (!string.IsNullOrEmpty(row.batchno))
            {
                await LookupBatch(row);
            }
        }
    }

    private void OnReturnQtyInput(ReturnItemRow row, ChangeEventArgs e)
    {
