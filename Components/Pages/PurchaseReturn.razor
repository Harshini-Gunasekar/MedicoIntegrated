    private async Task LoadStocks()
    {
        try {
            var client = CreateClient();
            var urls = new[] {
                "api/ItemMaster/getallstocks",
                $"api/ItemMaster/getallstocks?tenantcode={DefaultTenant}",
                "ItemMaster/getallstocks",
                "Stock/getallstocks"
            };
            string? response = null;
            foreach (var url in urls) {
                try {
                    response = await client.GetStringAsync(url);
                    if (!string.IsNullOrWhiteSpace(response)) break;
                } catch { }
            }
            if (!string.IsNullOrWhiteSpace(response)) {
                StockList = ParseStockListResponse(response);
            }

            if (!StockList.Any())
            {
                try {
                    var retryClient = CreateClient();
                    retryClient.DefaultRequestHeaders.Remove("tenantcode");
                    retryClient.DefaultRequestHeaders.Add("tenantcode", "0010");
                    var retryResp = await retryClient.GetStringAsync("api/ItemMaster/getallstocks");
                    if (!string.IsNullOrWhiteSpace(retryResp)) {
                        var retryList = ParseStockListResponse(retryResp);
                        if (retryList.Any()) {
                            StockList = retryList;
                        }
                    }
                } catch { }
            }
        } catch { }
        StockList ??= new();
    }

