@page "/purchasereturn"
@page "/purchase-return"
@using Booking.Models
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<PageTitle>Purchase Return</PageTitle>



<style>
    /* Scoped layout fixes for Return Pages */
    .purchase-page .items-content {
        text-align: left !important;
        width: 100% !important;
    }
    
    /* Log Card & Toolbar */
    .return-log-card {
        background: #ffffff !important;
        border-radius: 16px !important;
        border: 1px solid #e2e8f0 !important;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03) !important;
        text-align: left !important;
        width: 100% !important;
        box-sizing: border-box !important;
    }
    .return-log-card .card-body {
        padding: 24px 28px !important;
    }
    .return-log-toolbar {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        gap: 16px !important;
        margin-bottom: 20px !important;
        padding-bottom: 16px !important;
        border-bottom: 1px solid #f1f5f9 !important;
        width: 100% !important;
        box-sizing: border-box !important;
        text-align: left !important;
    }
    .return-log-title-area {
        display: inline-flex !important;
        align-items: center !important;
        flex-direction: row !important;
        gap: 12px !important;
        flex-shrink: 0 !important;
    }
    .return-log-icon {
        width: 40px !important;
        height: 40px !important;
        border-radius: 12px !important;
        background: #eef2ff !important;
        color: #4f46e5 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-size: 1.15rem !important;
        border: 1px solid rgba(79, 70, 229, 0.15) !important;
        flex-shrink: 0 !important;
    }
    .return-log-heading-wrap {
        display: flex !important;
        flex-direction: column !important;
        text-align: left !important;
    }
    .return-log-title-row {
        display: inline-flex !important;
        align-items: center !important;
        gap: 10px !important;
    }
    .return-log-heading-wrap h4 {
        font-size: 1.05rem !important;
        font-weight: 700 !important;
        color: #1e293b !important;
        margin: 0 !important;
        line-height: 1.2 !important;
    }
    .return-log-heading-wrap span.subtext {
        font-size: 0.72rem !important;
        color: #64748b !important;
        font-weight: 500 !important;
        margin-top: 2px !important;
    }
    .return-log-count-badge {
        background: #e0e7ff !important;
        color: #4338ca !important;
        font-size: 0.74rem !important;
        padding: 4px 10px !important;
        border-radius: 20px !important;
        font-weight: 700 !important;
        display: inline-flex !important;
        align-items: center !important;
        border: 1px solid #c7d2fe !important;
        white-space: nowrap !important;
    }
    .return-log-controls {
        display: inline-flex !important;
        align-items: center !important;
        flex-direction: row !important;
        gap: 10px !important;
        flex-wrap: wrap !important;
    }
    .return-search-wrapper {
        position: relative !important;
        width: 250px !important;
        display: inline-flex !important;
        align-items: center !important;
    }
    .return-search-input {
        height: 36px !important;
        font-size: 0.8rem !important;
        padding-left: 32px !important;
        padding-right: 28px !important;
        border-radius: 8px !important;
        border: 1px solid #cbd5e1 !important;
        background: #f8fafc !important;
        width: 100% !important;
        color: #1e293b !important;
        outline: none !important;
        box-sizing: border-box !important;
    }
    .return-search-input:focus {
        border-color: #4f46e5 !important;
        background: #ffffff !important;
        box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.12) !important;
    }
    .return-search-icon {
        position: absolute !important;
        left: 10px !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        color: #94a3b8 !important;
        font-size: 0.82rem !important;
        pointer-events: none !important;
    }
    .return-search-clear {
        position: absolute !important;
        right: 9px !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        color: #94a3b8 !important;
        font-size: 0.82rem !important;
        cursor: pointer !important;
    }
    .return-search-clear:hover {
        color: #ef4444 !important;
    }
    .return-date-box {
        display: inline-flex !important;
        align-items: center !important;
        gap: 4px !important;
    }
    .return-date-input {
        height: 36px !important;
        font-size: 0.8rem !important;
        border-radius: 8px !important;
        border: 1px solid #cbd5e1 !important;
        background: #f8fafc !important;
        padding: 0 8px !important;
        width: 135px !important;
        color: #1e293b !important;
        box-sizing: border-box !important;
    }
    .return-date-clear-btn {
        height: 36px !important;
        width: 30px !important;
        padding: 0 !important;
        border: 1px solid #fca5a5 !important;
        border-radius: 8px !important;
        background: #fef2f2 !important;
        color: #dc2626 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: pointer !important;
    }
    .return-store-select {
        height: 36px !important;
        font-size: 0.8rem !important;
        border-radius: 8px !important;
        border: 1px solid #cbd5e1 !important;
        background: #f8fafc !important;
        padding: 0 10px !important;
        width: 155px !important;
        color: #1e293b !important;
        box-sizing: border-box !important;
    }
    .return-refresh-btn {
        height: 36px !important;
        padding: 0 14px !important;
        border-radius: 8px !important;
        border: 1px solid #c7d2fe !important;
        background: #eef2ff !important;
        color: #4338ca !important;
        font-weight: 600 !important;
        font-size: 0.8rem !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        cursor: pointer !important;
        transition: all 0.2s ease !important;
        white-space: nowrap !important;
    }
    .return-refresh-btn:hover {
        background: #4f46e5 !important;
        color: #ffffff !important;
        border-color: #4f46e5 !important;
    }
    .return-table-container {
        border-radius: 12px !important;
        border: 1px solid #e2e8f0 !important;
        max-height: 480px !important;
        overflow-y: auto !important;
        overflow-x: auto !important;
        background: #ffffff !important;
        width: 100% !important;
        position: relative !important;
    }
    .return-custom-table {
        width: 100% !important;
        margin-bottom: 0 !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
        font-size: 0.8rem !important;
        text-align: left !important;
    }
    .return-custom-table thead th {
        position: sticky !important;
        top: 0 !important;
        z-index: 10 !important;
        background: #f8fafc !important;
        color: #475569 !important;
        font-size: 0.72rem !important;
        font-weight: 800 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.5px !important;
        padding: 12px 10px !important;
        border-bottom: 2px solid #e2e8f0 !important;
        white-space: nowrap !important;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04) !important;
    }
    .return-custom-table tbody td {
        padding: 11px 10px !important;
        border-bottom: 1px solid #f1f5f9 !important;
        vertical-align: middle !important;
        color: #334155 !important;
    }
    .return-custom-table tbody tr:hover {
        background-color: #f8fafc !important;
    }
    .return-log-footer {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        gap: 12px !important;
        margin-top: 18px !important;
        padding-top: 14px !important;
        border-top: 1px solid #f1f5f9 !important;
        width: 100% !important;
        box-sizing: border-box !important;
        text-align: left !important;
    }
    .return-footer-left {
        display: inline-flex !important;
        align-items: center !important;
        flex-direction: row !important;
        gap: 12px !important;
    }
    .return-pagination-pill-btn {
        height: 32px !important;
        padding: 0 12px !important;
        font-size: 0.75rem !important;
        font-weight: 600 !important;
        border-radius: 8px !important;
        border: 1px solid #cbd5e1 !important;
        background: #ffffff !important;
        color: #475569 !important;
        cursor: pointer !important;
        transition: all 0.15s ease !important;
    }
    .return-pagination-pill-btn:hover {
        background: #f1f5f9 !important;
        color: #0f172a !important;
        border-color: #94a3b8 !important;
    }
    .return-record-counter {
        font-size: 0.76rem !important;
        color: #64748b !important;
        font-weight: 500 !important;
    }
    .return-footer-right {
        display: inline-flex !important;
        align-items: center !important;
        flex-direction: row !important;
        gap: 8px !important;
    }
    .return-nav-btn {
        height: 32px !important;
        width: 32px !important;
        padding: 0 !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 6px !important;
        background: #ffffff !important;
        color: #334155 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: pointer !important;
        transition: all 0.15s ease !important;
    }
    .return-nav-btn:disabled {
        opacity: 0.35 !important;
        cursor: not-allowed !important;
    }
    .return-nav-btn:not(:disabled):hover {
        background: #f1f5f9 !important;
        border-color: #94a3b8 !important;
    }
    .return-page-indicator {
        font-size: 0.78rem !important;
        font-weight: 600 !important;
        color: #1e293b !important;
        padding: 0 6px !important;
    }
</style>

<div class="items-page purchase-page pt-4 pb-3" style="min-height: auto !important;">
    <div class="items-shell px-3">
        <div class="items-content" style="text-align: left !important;">
            <div class="premium-header-card mb-4">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="23 4 23 10 17 10" />
                            <polyline points="1 20 1 14 7 14" />
                            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">New Purchase Return</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Create a return record and update stock
                        </div>
                    </div>
                </div>
            </div>

            <div class="card items-main-card mb-4" style="background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 4px 18px rgba(0, 0, 0, 0.02); text-align: left;">
                <div class="card-body" style="padding: 28px;">
                    <EditForm Model="CurrentReturn" autocomplete="off">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <!-- Initial Search Fields: Item, Batch No, Return No, Return Date -->
                        <div class="form-grid mb-4" style="display: grid; grid-template-columns: 2fr 1.2fr 1.5fr 1.2fr; gap: 16px; width: 100%; box-sizing: border-box;">
                            <!-- Item selection -->
                            <div class="field-group" style="min-width: 0; gap: 6px;">
                                <label class="field-label" style="font-size: 0.78rem; font-weight: 700; margin-bottom: 0; display: block; text-align: left; text-transform: uppercase; letter-spacing: 0.05em;">Item</label>
                                <div style="position: relative;">
                                    <select class="form-control premium-input" @onchange="OnItemSelectChanged" style="appearance: none !important; -webkit-appearance: none !important; -moz-appearance: none !important; padding: 6px 12px; padding-right: 28px; width: 100%; font-size: 0.84rem; height: 40px; border-radius: 10px; border: 1px solid #cbd5e1; box-sizing: border-box;">
                                        <option value="0">-- Select Item --</option>
                                        @foreach (var item in GetAvailableItems())
                                        {
                                            <option value="@item.itemcode" selected="@(CurrentReturn.itemcode == item.itemcode)">@item.itemname</option>
                                        }
                                    </select>
                                    <i class="bi bi-chevron-down" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b; font-size: 0.85rem;"></i>
                                </div>
                            </div>

                            <!-- Batch No selection -->
                            <div class="field-group" style="min-width: 0; gap: 6px;">
                                <label class="field-label" style="font-size: 0.78rem; font-weight: 700; margin-bottom: 0; display: block; text-align: left; text-transform: uppercase; letter-spacing: 0.05em;">Batch No</label>
                                <div style="position: relative;">
                                    <select class="form-control premium-input" @onchange="OnBatchChanged" style="appearance: none !important; -webkit-appearance: none !important; -moz-appearance: none !important; padding: 6px 12px; padding-right: 28px; width: 100%; font-size: 0.84rem; height: 40px; border-radius: 10px; border: 1px solid #cbd5e1; box-sizing: border-box;">
                                        <option value="">-- Select Batch --</option>
                                        @foreach (var batch in GetAvailableBatches())
                                        {
                                            <option value="@batch" selected="@(CurrentReturn.batchno == batch)">@batch</option>
                                        }
                                    </select>
                                    <i class="bi bi-chevron-down" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b; font-size: 0.85rem;"></i>
                                </div>
                            </div>

                            <!-- Return No -->
                            <div class="field-group" style="min-width: 0; gap: 6px;">
                                <label class="field-label" style="font-size: 0.78rem; font-weight: 700; margin-bottom: 0; display: block; text-align: left; text-transform: uppercase; letter-spacing: 0.05em;">Return No</label>
                                <input type="text" class="form-control premium-input" @bind-value="CurrentReturn.remarks" placeholder="Enter Return No" style="padding: 6px 12px; width: 100%; font-size: 0.84rem; height: 40px; border-radius: 10px; border: 1px solid #cbd5e1; box-sizing: border-box;" />
                            </div>

                            <!-- Return Date -->
                            <div class="field-group" style="min-width: 0; gap: 6px;">
                                <label class="field-label" style="font-size: 0.78rem; font-weight: 700; margin-bottom: 0; display: block; text-align: left; text-transform: uppercase; letter-spacing: 0.05em;">Return Date</label>
                                <input type="date" class="form-control premium-input" value="@CurrentReturn.createddate.ToString("yyyy-MM-dd")" @onchange="@(e => { if (DateTime.TryParse(e.Value?.ToString(), out var dt)) CurrentReturn.createddate = dt; })" style="padding: 6px 12px; width: 100%; font-size: 0.84rem; height: 40px; border-radius: 10px; border: 1px solid #cbd5e1; box-sizing: border-box;" />
                            </div>
                        </div>

                        <div class="table-responsive animate-fade-in mt-3" style="border-radius: 12px; overflow-x: hidden; border: 1px solid #e2e8f0;">
                            <table class="table table-hover align-middle mb-0 items-table w-100" style="font-size: 0.8rem; border-collapse: separate; border-spacing: 0;">
                                <thead>
                                    <tr style="background: #ffffff; border-bottom: 2px solid #eef2f6;">
                                        <th style="width: 45px; text-align: center; padding: 12px 4px; font-weight: 700; color: #8a99ad; text-transform: uppercase; font-size: 0.74rem; letter-spacing: 0.8px;">S.No</th>
                                        <th style="width: 15%; text-align: left; padding: 12px 6px; font-weight: 700; color: #8a99ad; text-transform: uppercase; font-size: 0.74rem; letter-spacing: 0.8px;">STORE</th>
                                        <th style="width: 25%; text-align: left; padding: 12px 6px; font-weight: 700; color: #8a99ad; text-transform: uppercase; font-size: 0.74rem; letter-spacing: 0.8px;">VENDOR</th>
                                        <th style="width: 10%; text-align: center; padding: 12px 6px; font-weight: 700; color: #8a99ad; text-transform: uppercase; font-size: 0.74rem; letter-spacing: 0.8px;">UNIT COST</th>
                                        <th style="width: 9%; text-align: center; padding: 12px 4px; font-weight: 700; color: #8a99ad; text-transform: uppercase; font-size: 0.74rem; letter-spacing: 0.8px;">PACK SIZE</th>
                                        <th style="width: 10%; text-align: center; padding: 12px 4px; font-weight: 700; color: #8a99ad; text-transform: uppercase; font-size: 0.74rem; letter-spacing: 0.8px;">RETURN QTY</th>
                                        <th style="width: 8.5%; text-align: center; padding: 12px 4px; font-weight: 700; color: #8a99ad; text-transform: uppercase; font-size: 0.74rem; letter-spacing: 0.8px;">TOTAL QTY</th>
                                        <th style="width: 8.5%; text-align: center; padding: 12px 4px; font-weight: 700; color: #8a99ad; text-transform: uppercase; font-size: 0.74rem; letter-spacing: 0.8px;">STOCK QTY</th>
                                        <th style="width: 11%; text-align: right; padding: 12px 6px; font-weight: 700; color: #8a99ad; text-transform: uppercase; font-size: 0.74rem; letter-spacing: 0.8px;">AMOUNT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="border-bottom: 1px solid #eef2f6; background-color: #ffffff;">
                                        <td style="text-align: center; font-weight: 700; color: #3b82f6; padding: 12px 4px;">
                                            1
                                        </td>
                                        <td style="padding: 12px 6px; text-align: left;">
                                            <span style="font-weight: 600; font-size: 0.8rem; color: @(CurrentReturn.warehousecode > 0 ? "#1e293b" : "#94a3b8");">
                                                @(WarehouseList.FirstOrDefault(w => w.warehousecode == CurrentReturn.warehousecode)?.warehousename 
                                                  ?? (CurrentReturn.warehousecode > 0 ? $"Store {CurrentReturn.warehousecode}" : ""))
                                            </span>
                                        </td>
                                        <td style="padding: 12px 6px; text-align: left; white-space: normal; word-break: break-word;">
                                            <span style="font-weight: 600; font-size: 0.8rem; color: @(!string.IsNullOrEmpty(SelectedVendorName) ? "#1e293b" : "#94a3b8");">
                                                @(string.IsNullOrEmpty(SelectedVendorName) ? "" : SelectedVendorName)
                                            </span>
                                        </td>
                                        <td style="text-align: center; font-weight: 600; padding: 12px 6px; font-size: 0.8rem; color: #334155;">
                                            ₹@CurrentReturn.rate.ToString("N2")
                                        </td>
                                        <td style="padding: 12px 4px; text-align: center;">
                                            <input type="number" class="form-control premium-input text-center" value="@CurrentReturn.packsize" @oninput="OnPackSizeInput" style="border: 1px solid #cbd5e1; font-size: 0.8rem; padding: 4px 6px; height: 34px; width: 75px; margin: 0 auto; border-radius: 8px;" />
                                        </td>
                                        <td style="padding: 12px 4px; text-align: center;">
                                            <input type="number" class="form-control premium-input text-center" value="@CurrentReturn.returnqty" @oninput="OnReturnQtyInput" style="border: 1px solid #cbd5e1; font-size: 0.8rem; padding: 4px 6px; height: 34px; width: 85px; margin: 0 auto; border-radius: 8px;" />
                                        </td>
                                        <td style="text-align: center; font-weight: 600; padding: 12px 4px; font-size: 0.8rem; color: #1e293b;">
                                            @CurrentReturn.totalqty
                                        </td>
                                        <td style="text-align: center; font-weight: 600; color: #475569; padding: 12px 4px; font-size: 0.8rem;">
                                            @AvailableQtyInStock
                                        </td>
                                        <td style="text-align: right; font-weight: 700; color: #dc2626; padding: 12px 6px; font-size: 0.82rem; background-color: #fef2f2; border-left: 1px solid #fee2e2;">
                                            ₹@CurrentReturn.amount.ToString("N2")
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Buttons aligned to the right -->
                        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 30px; margin-bottom: 5px;">
                            <button type="button" class="btn-cancel-modal" @onclick="ResetForm" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.5rem 1.5rem; border-radius: 12px; font-weight: 700; min-width: 100px; transition: all 0.2s;">Cancel</button>
                            @if (hasCreateRight)
                            {
                                <button type="button" class="btn-save-premium" @onclick="SubmitReturn" disabled="@IsSaving" style="min-width: 180px; height: 42px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; border-radius: 10px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; font-weight: 600; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2); transition: all 0.2s; cursor: pointer;">
                                    @if (IsSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" style="width: 1rem; height: 1rem;"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                                    }
                                    <span>Save Return</span>
                                </button>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>

            <!-- PURCHASE RETURN LOG / HISTORY TABLE -->
            <div class="card return-log-card mb-4">
                <div class="card-body">
                    <!-- Log Header & Toolbar -->
                    <div class="return-log-toolbar">
                        <div class="return-log-title-area">
                            <div class="return-log-icon">
                                <i class="bi bi-clock-history"></i>
                            </div>
                            <div class="return-log-heading-wrap">
                                <div class="return-log-title-row">
                                    <h4>Purchase Return Log</h4>
                                    <span class="return-log-count-badge">
                                        Total: @FilteredReturnLogs.Count
                                    </span>
                                </div>
                                <span class="subtext">History of all recorded purchase returns & stock deductions</span>
                            </div>
                        </div>

                        <!-- Right Actions: Search, Date, Store, Refresh -->
                        <div class="return-log-controls">
                            <!-- Search -->
                            <div class="return-search-wrapper">
                                <input type="text" class="return-search-input" placeholder="Search Return No, Item, Batch, Vendor..." @bind="FilterLogSearch" @bind:event="oninput" />
                                <i class="bi bi-search return-search-icon"></i>
                                @if (!string.IsNullOrEmpty(FilterLogSearch))
                                {
                                    <i class="bi bi-x-circle-fill return-search-clear" @onclick='() => FilterLogSearch = ""'></i>
                                }
                            </div>

                            <!-- Date Filter -->
                            <div class="return-date-box">
                                <input type="date" class="return-date-input" value="@(FilterLogDate?.ToString("yyyy-MM-dd"))" @onchange="OnLogDateFilterChanged" />
                                @if (FilterLogDate.HasValue)
                                {
                                    <button type="button" class="return-date-clear-btn" @onclick='() => { FilterLogDate = null; }' title="Clear Date">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>

                            <!-- Store Filter -->
                            <select class="return-store-select" @bind="FilterLogStore">
                                <option value="0">All Stores</option>
                                @foreach (var w in WarehouseList)
                                {
                                    <option value="@w.warehousecode">@w.warehousename</option>
                                }
                            </select>

                            <!-- Refresh button -->
                            <button type="button" class="return-refresh-btn" @onclick="LoadPurchaseReturnLogs" disabled="@LoadingLogs">
                                <i class="bi bi-arrow-clockwise @(LoadingLogs ? "spin" : "")"></i>
                                <span>Refresh</span>
                            </button>
                        </div>
                    </div>

                    <!-- Table content -->
                    @if (LoadingLogs)
                    {
                        <div class="text-center py-5" style="text-align: center !important;">
                            <div class="spinner-border text-primary" role="status" style="width: 2rem; height: 2rem;"></div>
                            <p class="mt-2 text-muted" style="font-size: 0.82rem;">Loading purchase return history...</p>
                        </div>
                    }
                    else if (!FilteredReturnLogs.Any())
                    {
                        <div class="text-center py-5" style="background: #f8fafc; border-radius: 12px; border: 1px dashed #cbd5e1; text-align: center !important;">
                            <i class="bi bi-box-arrow-left" style="font-size: 2.2rem; color: #94a3b8;"></i>
                            <h5 class="mt-2" style="font-size: 0.95rem; font-weight: 700; color: #475569;">No Purchase Returns Found</h5>
                            <p class="text-muted mb-0" style="font-size: 0.78rem;">There are no return records matching the selected filters.</p>
                        </div>
                    }
                    else
                    {
                        var displayLogs = EnableLogPagination 
                            ? FilteredReturnLogs.Skip((LogCurrentPage - 1) * LogPageSize).Take(LogPageSize).ToList()
                            : FilteredReturnLogs;

                        <div class="return-table-container">
                            <table class="return-custom-table">
                                <thead>
                                    <tr>
                                        <th style="width: 45px; text-align: center;">S.No</th>
                                        <th style="text-align: left;">Return No</th>
                                        <th style="text-align: center;">Date</th>
                                        <th style="text-align: left;">Store</th>
                                        <th style="text-align: left;">Vendor</th>
                                        <th style="text-align: left;">Item Name</th>
                                        <th style="text-align: center;">Batch No</th>
                                        <th style="text-align: center;">Return Qty</th>
                                        <th style="text-align: center;">Pack Size</th>
                                        <th style="text-align: center;">Total Qty</th>
                                        <th style="text-align: right;">Unit Cost</th>
                                        <th style="text-align: right;">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int sIdx = (LogCurrentPage - 1) * LogPageSize + 1; }
                                    @foreach (var log in displayLogs)
                                    {
                                        <tr>
                                            <td style="text-align: center; font-weight: 700; color: #6366f1;">@(sIdx++)</td>
                                            <td style="text-align: left; font-weight: 700; color: #0f172a;">
                                                @(!string.IsNullOrEmpty(log.remarks) ? log.remarks : $"PR-{log.purchasereturncode}")
                                            </td>
                                            <td style="text-align: center; color: #475569; font-size: 0.78rem;">
                                                @(log.createddate != default ? log.createddate.ToString("dd-MM-yyyy") : "-")
                                            </td>
                                            <td style="text-align: left; color: #334155; font-weight: 600;">
                                                @(GetWarehouseName(log.warehousecode))
                                            </td>
                                            <td style="text-align: left; color: #1e293b; font-weight: 600;">
                                                @(GetVendorName(log.vendorcode))
                                            </td>
                                            <td style="text-align: left; color: #0f172a; font-weight: 600;">
                                                @(GetItemName(log.itemcode))
                                            </td>
                                            <td style="text-align: center;">
                                                <span class="badge" style="background: #f1f5f9; color: #334155; font-weight: 600; border: 1px solid #cbd5e1; font-size: 0.72rem;">@(string.IsNullOrEmpty(log.batchno) ? "-" : log.batchno)</span>
                                            </td>
                                            <td style="text-align: center; color: #0f172a; font-weight: 700;">@log.returnqty</td>
                                            <td style="text-align: center; color: #64748b;">@log.packsize</td>
                                            <td style="text-align: center; color: #4338ca; font-weight: 700;">@log.totalqty</td>
                                            <td style="text-align: right; color: #334155; font-weight: 600;">₹@log.rate.ToString("N2")</td>
                                            <td style="text-align: right; color: #dc2626; font-weight: 700; background: #fef2f2;">₹@log.amount.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Footer -->
                        <div class="return-log-footer">
                            <div class="return-footer-left">
                                <button type="button" class="return-pagination-pill-btn" @onclick='() => EnableLogPagination = !EnableLogPagination'>
                                    @(EnableLogPagination ? "Show All" : "Paginate (10/Page)")
                                </button>
                                <span class="return-record-counter">
                                    Showing @(displayLogs.Count) of @(FilteredReturnLogs.Count) records
                                </span>
                            </div>

                            @if (EnableLogPagination && FilteredReturnLogs.Count > LogPageSize)
                            {
                                int totalPages = (int)Math.Ceiling((double)FilteredReturnLogs.Count / LogPageSize);
                                <div class="return-footer-right">
                                    <button type="button" class="return-nav-btn" disabled="@(LogCurrentPage <= 1)" @onclick="() => LogCurrentPage--">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>
                                    <span class="return-page-indicator">
                                        Page @LogCurrentPage of @totalPages
                                    </span>
                                    <button type="button" class="return-nav-btn" disabled="@(LogCurrentPage >= totalPages)" @onclick="() => LogCurrentPage++">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string DefaultTenant = "";

    private List<inventory_item_master> ItemList = new();
    private List<stock_master> StockList = new();
    private List<warehouse_master> WarehouseList = new();
    private List<vendor_master> VendorList = new();

    private purchase_return_master CurrentReturn = new();

    private bool IsSaving = false;
    private bool ShowDetails = false;
    private string RawLookupJson = "";

    private string SelectedItemName { get; set; } = "";
    private bool hasViewRight = true;
    private bool hasCreateRight = true;
    private string SelectedVendorName { get; set; } = "";
    private decimal AvailableQtyInStock { get; set; } = 0;

    private long? _selectedWarehouseCode;
    private long? SelectedWarehouseCode
    {
        get => _selectedWarehouseCode;
        set
        {
            if (_selectedWarehouseCode != value)
            {
                _selectedWarehouseCode = value;
                CurrentReturn.warehousecode = value;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
            
            try
            {
                bool isAdmin = false;
                try
                {
                    var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userResult.Success && userResult.Value != null)
                    {
                        isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                  userResult.Value.UserCode == 0 ||
                                  userResult.Value.UserCode == 1;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking user details: {ex.Message}");
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                }
                else
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var pageRight = rightsResult.Value.FirstOrDefault(r => 
                            r.ModuleName != null && 
                            r.ModuleName.Trim().Equals("Purchase_Return", StringComparison.OrdinalIgnoreCase));
                        
                        if (pageRight != null)
                        {
                            hasViewRight = pageRight.ToView;
                            hasCreateRight = pageRight.ToAdd;
                        }
                        else
                        {
                            hasViewRight = false;
                            hasCreateRight = false;
                        }
                    }
                    else
                    {
                        hasViewRight = false;
                        hasCreateRight = false;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking Purchase_Return rights: {ex.Message}");
                hasViewRight = false;
                hasCreateRight = false;
            }

            if (!hasViewRight)
            {
                ToastService.ShowError("You do not have permission to access Purchase Return.");
                Nav.NavigateTo("/home");
                return;
            }

            ResetForm();
            await Task.WhenAll(LoadItems(), LoadStocks(), LoadWarehouses(), LoadVendors(), LoadPurchaseReturnLogs());
            StateHasChanged();
        }
    }

    private void ResetForm()
    {
        CurrentReturn = new purchase_return_master
        {
            tenantcode = DefaultTenant,
            packsize = 1,
            returnqty = 0,
            rate = 0,
            totalqty = 0,
            amount = 0,
            createddate = DateTime.Now,
            remarks = "PR-" + DateTime.Now.ToString("yyyyMMdd") + "-" + new Random().Next(1000, 9999)
        };
        _selectedWarehouseCode = 0;
        SelectedItemName = "";
        SelectedVendorName = "";
        AvailableQtyInStock = 0;
        ShowDetails = false;
        RawLookupJson = "";
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
        return client;
    }

    private string GetItemName(long itemCode)
    {
        if (itemCode <= 0) return "-";
        return ItemList.FirstOrDefault(i => i.itemcode == itemCode)?.itemname ?? $"Item #{itemCode}";
    }

    private string GetVendorName(long vendorCode)
    {
        if (vendorCode <= 0) return "-";
        return VendorList.FirstOrDefault(v => v.vendorCode == vendorCode)?.vendorName ?? $"Vendor #{vendorCode}";
    }

    private string GetWarehouseName(long? warehouseCode)
    {
        if (!warehouseCode.HasValue || warehouseCode.Value <= 0) return "-";
        return WarehouseList.FirstOrDefault(w => w.warehousecode == warehouseCode.Value)?.warehousename ?? $"Store #{warehouseCode.Value}";
    }

    private List<purchase_return_master> PurchaseReturnLogs = new();
    private bool LoadingLogs = false;
    private string FilterLogSearch = "";
    private DateTime? FilterLogDate;
    private long FilterLogStore = 0;
    private int LogCurrentPage = 1;
    private int LogPageSize = 10;
    private bool EnableLogPagination = true;

    private void OnLogDateFilterChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            FilterLogDate = dt;
        }
        else
        {
            FilterLogDate = null;
        }
        LogCurrentPage = 1;
    }

    private List<purchase_return_master> FilteredReturnLogs
    {
        get
        {
            var q = PurchaseReturnLogs.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(FilterLogSearch))
            {
                var s = FilterLogSearch.Trim().ToLower();
                q = q.Where(x =>
                    (!string.IsNullOrEmpty(x.remarks) && x.remarks.ToLower().Contains(s)) ||
                    (!string.IsNullOrEmpty(x.batchno) && x.batchno.ToLower().Contains(s)) ||
                    GetItemName(x.itemcode).ToLower().Contains(s) ||
                    GetVendorName(x.vendorcode).ToLower().Contains(s) ||
                    GetWarehouseName(x.warehousecode).ToLower().Contains(s) ||
                    x.purchasereturncode.ToString().Contains(s)
                );
            }
            if (FilterLogDate.HasValue)
            {
                var d = FilterLogDate.Value.Date;
                q = q.Where(x => x.createddate.Date == d);
            }
            if (FilterLogStore > 0)
            {
                q = q.Where(x => x.warehousecode == FilterLogStore);
            }
            return q.ToList();
        }
    }

    private async Task LoadPurchaseReturnLogs()
    {
        LoadingLogs = true;
        try
        {
            var client = CreateClient();
            var urls = new[]
            {
                $"api/ItemMaster/getallpurchasereturn?tenantcode={DefaultTenant}",
                "api/ItemMaster/getallpurchasereturn",
                "ItemMaster/getallpurchasereturn",
                $"api/ItemMaster/getallpurchasereturns?tenantcode={DefaultTenant}",
                "api/ItemMaster/getallpurchasereturns"
            };

            string? response = null;
            foreach (var url in urls)
            {
                try
                {
                    response = await client.GetStringAsync(url);
                    if (!string.IsNullOrWhiteSpace(response)) break;
                }
                catch { }
            }

            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true,
                    NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                };

                List<purchase_return_master>? list = null;
                try
                {
                    list = JsonSerializer.Deserialize<List<purchase_return_master>>(response, options);
                }
                catch { }

                if (list == null || !list.Any())
                {
                    try
                    {
                        var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<purchase_return_master>>>(response, options);
                        list = wrapped?.data;
                    }
                    catch { }
                }

                if (list == null || !list.Any())
                {
                    try
                    {
                        using var doc = JsonDocument.Parse(response);
                        var root = doc.RootElement;
                        if (root.ValueKind == JsonValueKind.Object)
                        {
                            if (root.TryGetProperty("data", out var dataArr)) root = dataArr;
                            else if (root.TryGetProperty("value", out var valArr)) root = valArr;
                        }
                        if (root.ValueKind == JsonValueKind.Array)
                        {
                            var parsedList = new List<purchase_return_master>();
                            foreach (var el in root.EnumerateArray())
                            {
                                var item = new purchase_return_master();
                                if (el.TryGetProperty("purchasereturncode", out var prc) || el.TryGetProperty("purchase_return_code", out prc) || el.TryGetProperty("returncode", out prc) || el.TryGetProperty("id", out prc))
                                    if (prc.ValueKind == JsonValueKind.Number) item.purchasereturncode = prc.GetInt64();
                                    else if (prc.ValueKind == JsonValueKind.String && long.TryParse(prc.GetString(), out var v)) item.purchasereturncode = v;

                                if (el.TryGetProperty("purchasedetailcode", out var pdc) || el.TryGetProperty("purchase_detail_code", out pdc))
                                    if (pdc.ValueKind == JsonValueKind.Number) item.purchasedetailcode = pdc.GetInt64();

                                if (el.TryGetProperty("purchasecode", out var pc) || el.TryGetProperty("purchase_code", out pc))
                                    if (pc.ValueKind == JsonValueKind.Number) item.purchasecode = pc.GetInt64();

                                if (el.TryGetProperty("itemcode", out var ic) || el.TryGetProperty("item_code", out ic))
                                    if (ic.ValueKind == JsonValueKind.Number) item.itemcode = ic.GetInt64();

                                if (el.TryGetProperty("vendorcode", out var vc) || el.TryGetProperty("vendor_code", out vc))
                                    if (vc.ValueKind == JsonValueKind.Number) item.vendorcode = vc.GetInt64();

                                if (el.TryGetProperty("itemname", out var iname) || el.TryGetProperty("item_name", out iname))
                                    item.itemname = iname.GetString();

                                if (el.TryGetProperty("vendorname", out var vname) || el.TryGetProperty("vendor_name", out vname))
                                    item.vendorname = vname.GetString();

                                if (el.TryGetProperty("warehousename", out var wname) || el.TryGetProperty("warehouse_name", out wname))
                                    item.warehousename = wname.GetString();

                                if (el.TryGetProperty("batchno", out var bn) || el.TryGetProperty("batch_no", out bn))
                                    item.batchno = bn.GetString();

                                if (el.TryGetProperty("returnqty", out var rq) || el.TryGetProperty("return_qty", out rq) || el.TryGetProperty("qty", out rq))
                                    if (rq.ValueKind == JsonValueKind.Number) item.returnqty = rq.GetDecimal();
                                    else if (rq.ValueKind == JsonValueKind.String && decimal.TryParse(rq.GetString(), out var v)) item.returnqty = v;

                                if (el.TryGetProperty("packsize", out var ps) || el.TryGetProperty("pack_size", out ps))
                                    if (ps.ValueKind == JsonValueKind.Number) item.packsize = ps.GetDecimal();
                                    else if (ps.ValueKind == JsonValueKind.String && decimal.TryParse(ps.GetString(), out var v)) item.packsize = v;

                                if (el.TryGetProperty("totalqty", out var tq) || el.TryGetProperty("total_qty", out tq))
                                    if (tq.ValueKind == JsonValueKind.Number) item.totalqty = tq.GetDecimal();
                                    else if (tq.ValueKind == JsonValueKind.String && decimal.TryParse(tq.GetString(), out var v)) item.totalqty = v;

                                if (el.TryGetProperty("rate", out var r) || el.TryGetProperty("unitcost", out r) || el.TryGetProperty("unit_cost", out r))
                                    if (r.ValueKind == JsonValueKind.Number) item.rate = r.GetDecimal();
                                    else if (r.ValueKind == JsonValueKind.String && decimal.TryParse(r.GetString(), out var v)) item.rate = v;

                                if (el.TryGetProperty("amount", out var am) || el.TryGetProperty("totalamount", out am) || el.TryGetProperty("total_amount", out am))
                                    if (am.ValueKind == JsonValueKind.Number) item.amount = am.GetDecimal();
                                    else if (am.ValueKind == JsonValueKind.String && decimal.TryParse(am.GetString(), out var v)) item.amount = v;

                                if (el.TryGetProperty("warehousecode", out var wc) || el.TryGetProperty("warehouse_code", out wc) || el.TryGetProperty("storecode", out wc))
                                    if (wc.ValueKind == JsonValueKind.Number) item.warehousecode = wc.GetInt64();

                                if (el.TryGetProperty("remarks", out var rem) || el.TryGetProperty("returnno", out rem) || el.TryGetProperty("return_no", out rem))
                                    item.remarks = rem.GetString();

                                if (el.TryGetProperty("createddate", out var cd) || el.TryGetProperty("created_date", out cd) || el.TryGetProperty("returndate", out cd) || el.TryGetProperty("return_date", out cd))
                                    if (cd.ValueKind == JsonValueKind.String && DateTime.TryParse(cd.GetString(), out var dt)) item.createddate = dt;

                                if (el.TryGetProperty("isactive", out var ia) || el.TryGetProperty("is_active", out ia))
                                    item.isactive = ia.ValueKind == JsonValueKind.True;

                                if (el.TryGetProperty("deleted", out var del))
                                    item.deleted = del.ValueKind == JsonValueKind.True;

                                if (!item.deleted)
                                {
                                    parsedList.Add(item);
                                }
                            }
                            list = parsedList;
                        }
                    }
                    catch { }
                }

                if (list != null)
                {
                    PurchaseReturnLogs = list.Where(x => !x.deleted)
                        .OrderByDescending(x => x.createddate != default ? x.createddate : DateTime.MinValue)
                        .ThenByDescending(x => x.purchasereturncode)
                        .ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadPurchaseReturnLogs] Error: {ex.Message}");
        }
        finally
        {
            LoadingLogs = false;
        }
    }

    private async Task LoadItems()
    {
        try {
            var client = CreateClient();
            var urls = new[] { "api/ItemMaster/getallitems", "api/ItemMaster/getallitem", "Item/getallitems" };
            string? response = null;
            foreach (var url in urls) {
                try {
                    response = await client.GetStringAsync(url);
                    if (!string.IsNullOrWhiteSpace(response)) break;
                } catch { }
            }
            if (string.IsNullOrWhiteSpace(response)) return;
            var options = new JsonSerializerOptions { 
                PropertyNameCaseInsensitive = true,
                NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
            };
            try {
                ItemList = JsonSerializer.Deserialize<List<inventory_item_master>>(response, options) ?? new();
            } catch {
                var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<inventory_item_master>>>(response, options);
                ItemList = wrapped?.data ?? new();
            }
        } catch { }
    }

    private async Task LoadStocks()
    {
        try {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallstocks");
            if (!string.IsNullOrWhiteSpace(response)) {
                var options = new JsonSerializerOptions { 
                    PropertyNameCaseInsensitive = true,
                    NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                };
                try {
                    StockList = JsonSerializer.Deserialize<List<stock_master>>(response, options) ?? new();
                } catch {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<stock_master>>>(response, options);
                    StockList = wrapped?.data ?? new();
                }
            }
        } catch { }
    }

    private async Task LoadWarehouses()
    {
        try {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallwarehouse");
            if (!string.IsNullOrWhiteSpace(response)) {
                var options = new JsonSerializerOptions { 
                    PropertyNameCaseInsensitive = true,
                    NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                };
                try {
                    WarehouseList = JsonSerializer.Deserialize<List<warehouse_master>>(response, options) ?? new();
                } catch {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<warehouse_master>>>(response, options);
                    WarehouseList = wrapped?.data ?? new();
                }
            }
        } catch { }
    }

    private async Task LoadVendors()
    {
        try {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallvendors");
            if (!string.IsNullOrWhiteSpace(response)) {
                var options = new JsonSerializerOptions { 
                    PropertyNameCaseInsensitive = true,
                    NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                };
                try {
                    VendorList = JsonSerializer.Deserialize<List<vendor_master>>(response, options) ?? new();
                } catch {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<vendor_master>>>(response, options);
                    VendorList = wrapped?.data ?? new();
                }
            }
        } catch { }
    }

    private IEnumerable<inventory_item_master> GetAvailableItems()
    {
        var itemCodesInStock = StockList
            .Where(s => s.closingstock > 0 && !string.IsNullOrEmpty(s.batchno))
            .Select(s => s.itemcode)
            .ToHashSet();
        return ItemList.Where(i => itemCodesInStock.Contains(i.itemcode));
    }

    private void OnItemSelectChanged(ChangeEventArgs e)
    {
        ShowDetails = false;
        if (long.TryParse(e.Value?.ToString(), out var code) && code > 0)
        {
            CurrentReturn.itemcode = code;
            SelectedItemName = ItemList.FirstOrDefault(i => i.itemcode == code)?.itemname ?? "";
            CurrentReturn.batchno = "";
            CurrentReturn.rate = 0;
            CurrentReturn.returnqty = 0;
            CurrentReturn.totalqty = 0;
            CurrentReturn.amount = 0;
            SelectedVendorName = "";
            AvailableQtyInStock = 0;
        }
        else
        {
            CurrentReturn.itemcode = 0;
            SelectedItemName = "";
            CurrentReturn.batchno = "";
            CurrentReturn.rate = 0;
            CurrentReturn.returnqty = 0;
            CurrentReturn.totalqty = 0;
            CurrentReturn.amount = 0;
            SelectedVendorName = "";
            AvailableQtyInStock = 0;
        }
    }

    private IEnumerable<string> GetAvailableBatches()
    {
        if (CurrentReturn.itemcode <= 0) return Enumerable.Empty<string>();
        return StockList
            .Where(s => s.itemcode == CurrentReturn.itemcode && s.closingstock > 0 && !string.IsNullOrEmpty(s.batchno))
            .Select(s => s.batchno!)
            .Distinct();
    }

    private async Task OnBatchChanged(ChangeEventArgs e)
    {
        var selectedBatch = e.Value?.ToString() ?? "";
        CurrentReturn.batchno = selectedBatch;
        
        if (string.IsNullOrEmpty(selectedBatch)) 
        {
            ShowDetails = false;
            return;
        }

        // Try lookup from API
        try {
            var client = CreateClient();
            var responseStr = await client.GetStringAsync($"api/ItemMaster/getpurchasereturnlookup?itemcode={CurrentReturn.itemcode}&batchno={selectedBatch}");
            RawLookupJson = responseStr;
            if (!string.IsNullOrWhiteSpace(responseStr))
            {
                var options = new JsonSerializerOptions { 
                    PropertyNameCaseInsensitive = true,
                    NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                };
                purchase_return_lookup_result? lookupResult = null;
                
                try {
                    // 1. Try wrapped array: ServiceResponse<List<purchase_return_lookup_result>>
                    var wrappedList = JsonSerializer.Deserialize<ServiceResponse<List<purchase_return_lookup_result>>>(responseStr, options);
                    lookupResult = wrappedList?.data?.FirstOrDefault();
                } catch {
                    try {
                        // 2. Try direct array: List<purchase_return_lookup_result>
                        var directList = JsonSerializer.Deserialize<List<purchase_return_lookup_result>>(responseStr, options);
                        lookupResult = directList?.FirstOrDefault();
                    } catch {
                        try {
                            // 3. Try wrapped single object: ServiceResponse<purchase_return_lookup_result>
                            var wrappedObj = JsonSerializer.Deserialize<ServiceResponse<purchase_return_lookup_result>>(responseStr, options);
                            lookupResult = wrappedObj?.data;
                        } catch {
                            // 4. Try direct single object: purchase_return_lookup_result
                            lookupResult = JsonSerializer.Deserialize<purchase_return_lookup_result>(responseStr, options);
                        }
                    }
                }

                if (lookupResult != null)
                {
                    CurrentReturn.purchasedetailcode = lookupResult.purchasedetailcode;
                    CurrentReturn.purchasecode = lookupResult.purchasecode;
                    CurrentReturn.vendorcode = lookupResult.vendorcode;
                    CurrentReturn.packsize = lookupResult.packsize > 0 ? lookupResult.packsize : 1;
                    SelectedVendorName = lookupResult.vendorname ?? VendorList.FirstOrDefault(v => v.vendorCode == lookupResult.vendorcode)?.vendorName ?? $"Vendor {lookupResult.vendorcode}";
                    
                    if (lookupResult.warehousecode > 0)
                    {
                        _selectedWarehouseCode = lookupResult.warehousecode;
                        CurrentReturn.warehousecode = lookupResult.warehousecode;
                    }

                    // Stock matching for available stock & unitcost from api/ItemMaster/getallstocks
                    var stockMatch = StockList.FirstOrDefault(s => s.itemcode == CurrentReturn.itemcode 
                                                                && s.batchno == selectedBatch 
                                                                && (CurrentReturn.warehousecode == null || CurrentReturn.warehousecode <= 0 || s.warehousecode == CurrentReturn.warehousecode))
                                  ?? StockList.FirstOrDefault(s => s.itemcode == CurrentReturn.itemcode && s.batchno == selectedBatch);

                    // Set unit cost from getallstocks endpoint (unitcost: 50.00)
                    if (stockMatch != null && stockMatch.unitcost > 0)
                    {
                        CurrentReturn.rate = stockMatch.unitcost;
                    }
                    else if (lookupResult.rate > 0 && CurrentReturn.packsize > 0)
                    {
                        CurrentReturn.rate = lookupResult.rate / CurrentReturn.packsize;
                    }
                    else
                    {
                        CurrentReturn.rate = lookupResult.rate;
                    }
                    
                    if (lookupResult.availableqty > 0)
                    {
                        AvailableQtyInStock = lookupResult.availableqty;
                    }
                    else
                    {
                        AvailableQtyInStock = stockMatch?.closingstock ?? 0;
                    }

                    RecalculateTotals();
                    ShowDetails = true;
                    return;
                }
            }
        } catch { }

        // Fallback if lookupResult is null
        var fallbackStock = StockList.FirstOrDefault(s => s.itemcode == CurrentReturn.itemcode && s.batchno == selectedBatch);
        if (fallbackStock != null)
        {
            CurrentReturn.rate = fallbackStock.unitcost;
            if (fallbackStock.warehousecode > 0)
            {
                _selectedWarehouseCode = fallbackStock.warehousecode;
                CurrentReturn.warehousecode = fallbackStock.warehousecode;
            }
            AvailableQtyInStock = fallbackStock.closingstock;
            RecalculateTotals();
            ShowDetails = true;
        }
        else
        {
            ShowDetails = false;
        }
    }

    private void RecalculateTotals()
    {
        if (CurrentReturn.packsize <= 0) CurrentReturn.packsize = 1;
        CurrentReturn.totalqty = CurrentReturn.returnqty * CurrentReturn.packsize;
        CurrentReturn.amount = CurrentReturn.totalqty * CurrentReturn.rate;
    }

    private void OnReturnQtyInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var qty))
        {
            CurrentReturn.returnqty = qty;
        }
        else
        {
            CurrentReturn.returnqty = 0;
        }
        RecalculateTotals();
    }

    private void OnPackSizeInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var size))
        {
            CurrentReturn.packsize = size;
        }
        else
        {
            CurrentReturn.packsize = 1;
        }
        RecalculateTotals();
    }

    private async Task SubmitReturn()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add purchase returns.");
            return;
        }
        RecalculateTotals();

        if (CurrentReturn.warehousecode == null || CurrentReturn.warehousecode <= 0)
        {
            ToastService.ShowWarning("Warehouse is missing from lookup.");
            return;
        }

        if (CurrentReturn.itemcode <= 0)
        {
            ToastService.ShowWarning("Please select a valid item");
            return;
        }

        if (string.IsNullOrEmpty(CurrentReturn.batchno))
        {
            ToastService.ShowWarning("Please select a batch no");
            return;
        }

        if (string.IsNullOrWhiteSpace(CurrentReturn.remarks))
        {
            ToastService.ShowWarning("Please enter Return No");
            return;
        }

        if (CurrentReturn.returnqty <= 0)
        {
            ToastService.ShowWarning("Return quantity must be greater than 0");
            return;
        }

        // Validate physical stock quantity locally
        var stock = StockList.FirstOrDefault(s => s.warehousecode == CurrentReturn.warehousecode 
                                              && s.itemcode == CurrentReturn.itemcode 
                                              && s.batchno == CurrentReturn.batchno);
        if (stock == null || stock.closingstock < CurrentReturn.totalqty)
        {
            ToastService.ShowError("Insufficient stock available in this store for return.");
            return;
        }

        IsSaving = true;
        try {
            var client = CreateClient();
            CurrentReturn.tenantcode = DefaultTenant;
            CurrentReturn.isactive = true;
            CurrentReturn.usercode = 101;

            var returnResponse = await client.PostAsJsonAsync("api/ItemMaster/insertpurchasereturn", CurrentReturn);
            if (returnResponse.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Purchase return registered successfully.");
                ResetForm();
                await Task.WhenAll(LoadStocks(), LoadPurchaseReturnLogs());
            }
            else
            {
                var err = await returnResponse.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to save return: {err}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
        }
    }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }
}
