    private List<PatientConsolidatedSoldItem> GetConsolidatedPatientSoldItems()
    {
        if (PatientSoldItems == null || !PatientSoldItems.Any()) return new();

        return PatientSoldItems
            .GroupBy(i => i.itemcode > 0 ? $"CODE_{i.itemcode}" : $"NAME_{i.itemname?.Trim().ToLower()}")
            .Select(g =>
            {
                var first = g.First();
                var latest = g.OrderByDescending(x => x.billdate ?? DateTime.MinValue).ThenByDescending(x => x.salescode).First();
                var distinctBatches = g.Where(x => !string.IsNullOrWhiteSpace(x.batchno)).Select(x => x.batchno!.Trim()).Distinct().ToList();
                var distinctBills = g.Where(x => !string.IsNullOrWhiteSpace(x.billno)).Select(x => x.billno!.Trim()).Distinct().ToList();
                var totalSold = g.Sum(x => x.soldqty);
                var totalReturned = g.Sum(x => x.returnedqty);

                var resolvedItemCode = g.FirstOrDefault(x => x.itemcode > 0)?.itemcode ?? first.itemcode;
                var resolvedItemName = !string.IsNullOrWhiteSpace(first.itemname) 
                    ? first.itemname 
                    : (resolvedItemCode > 0 ? GetItemName(resolvedItemCode) : "Medicine");

                return new PatientConsolidatedSoldItem
                {
                    itemcode = resolvedItemCode,
                    itemname = resolvedItemName,
                    totalsoldqty = totalSold,
                    totalreturnedqty = totalReturned,
                    latestrate = latest.rate > 0 ? latest.rate : g.FirstOrDefault(x => x.rate > 0)?.rate ?? 0,
                    packsize = latest.packsize > 0 ? latest.packsize : 1,
                    defaultwarehousecode = latest.warehousecode > 0 ? latest.warehousecode : g.FirstOrDefault(x => x.warehousecode > 0)?.warehousecode,
                    defaultwarehousename = latest.warehousename ?? g.FirstOrDefault(x => !string.IsNullOrEmpty(x.warehousename))?.warehousename,
                    batches = distinctBatches,
                    billnos = distinctBills,
                    details = g.ToList()
                };
            })
            .OrderBy(x => x.itemname)
            .ToList();
    }

    // Filter items ONLY from the selected patient's purchased items list (Consolidated by item)
    private List<PatientConsolidatedSoldItem> GetFilteredPatientSoldItems(string search)
    {
        var consolidated = GetConsolidatedPatientSoldItems();
        var term = search?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(term))
        {
            return consolidated.Take(40).ToList();
        }

        return consolidated.Where(i =>
            (!string.IsNullOrEmpty(i.itemname) && i.itemname.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            i.batches.Any(b => b.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            i.billnos.Any(b => b.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            i.itemcode.ToString().Contains(term)
        ).Take(40).ToList();
    }

    private async Task SelectConsolidatedSoldItem(ReturnItemRow row, PatientConsolidatedSoldItem item)
    {
        _searchBlurCts?.Cancel();
        row.itemcode = item.itemcode;
        row.itemname = item.itemname;
        ItemSearchTexts[row] = item.itemname ?? "";

        // Pick the most recent batch or first with available qty
        var detailWithStock = item.details.OrderByDescending(x => x.billdate ?? DateTime.MinValue).FirstOrDefault(x => x.availableqty > 0) ?? item.details.FirstOrDefault();
        
        if (detailWithStock != null)
        {
            row.batchno = detailWithStock.batchno ?? (item.batches.FirstOrDefault() ?? "");
            row.salesdetailcode = detailWithStock.salesdetailcode;
            row.salescode = detailWithStock.salescode;
            row.warehousecode = detailWithStock.warehousecode > 0 ? detailWithStock.warehousecode : (SelectedDefaultWarehouseCode > 0 ? SelectedDefaultWarehouseCode : WarehouseList.FirstOrDefault()?.warehousecode);
            row.rate = detailWithStock.rate > 0 ? detailWithStock.rate : item.latestrate;
            row.packsize = detailWithStock.packsize > 0 ? detailWithStock.packsize : item.packsize;
            
            // Calculate available stock for this specific batch
            var batchDetails = item.details.Where(x => string.Equals(x.batchno?.Trim(), row.batchno?.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
            row.availablestock = batchDetails.Any() ? batchDetails.Sum(x => x.availableqty) : item.totalavailableqty;
            row.returnqty = row.availablestock > 0 ? 1 : 0;
            if (row.itemcode <= 0 && detailWithStock.itemcode > 0) row.itemcode = detailWithStock.itemcode;
        }
        else
        {
            row.batchno = item.batches.FirstOrDefault() ?? "";
            row.rate = item.latestrate;
            row.packsize = item.packsize;
            row.availablestock = item.totalavailableqty;
            row.returnqty = item.totalavailableqty > 0 ? 1 : 0;
            row.warehousecode = item.defaultwarehousecode > 0 ? item.defaultwarehousecode : (SelectedDefaultWarehouseCode > 0 ? SelectedDefaultWarehouseCode : WarehouseList.FirstOrDefault()?.warehousecode);
        }

        row.customercode = SelectedCustomerCode;
        row.patientid = SelectedPatientId;
        row.patientname = SelectedPatientName;
        ActiveSearchRow = null;
        StateHasChanged();

        var rowIndex = ReturnRows.IndexOf(row);
        if (rowIndex >= 0)
        {
            var targetId = !string.IsNullOrEmpty(row.batchno) ? $"returnqty-{rowIndex}" : $"batch-{rowIndex}";
            try
            {
                await JS.InvokeVoidAsync("focusElement", targetId);
            }
            catch { }
        }
    }

    private IEnumerable<string> GetAvailableBatchesForPatientItem(ReturnItemRow row)
    {
        if (row == null) return Enumerable.Empty<string>();
        return PatientSoldItems
            .Where(s => (row.itemcode > 0 && s.itemcode == row.itemcode) || (!string.IsNullOrEmpty(row.itemname) && string.Equals(s.itemname?.Trim(), row.itemname.Trim(), StringComparison.OrdinalIgnoreCase)))
            .Where(s => !string.IsNullOrWhiteSpace(s.batchno))
            .Select(s => s.batchno!.Trim())
            .Distinct();
    }

    private void OnBatchChangedForPatientRow(ReturnItemRow row, string batch)
    {
        row.batchno = batch;
        if (row.itemcode <= 0 && string.IsNullOrEmpty(row.itemname)) return;

        var matchDetails = PatientSoldItems.Where(s => 
            ((row.itemcode > 0 && s.itemcode == row.itemcode) || (!string.IsNullOrEmpty(row.itemname) && string.Equals(s.itemname?.Trim(), row.itemname.Trim(), StringComparison.OrdinalIgnoreCase))) &&
            string.Equals(s.batchno?.Trim(), batch?.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

        if (matchDetails.Any())
        {
            var primaryMatch = matchDetails.OrderByDescending(x => x.billdate ?? DateTime.MinValue).ThenByDescending(x => x.availableqty > 0 ? 1 : 0).First();
            row.salesdetailcode = primaryMatch.salesdetailcode;
            row.salescode = primaryMatch.salescode;
            row.rate = primaryMatch.rate;
            row.availablestock = matchDetails.Sum(x => x.availableqty);
            if (primaryMatch.warehousecode > 0) row.warehousecode = primaryMatch.warehousecode;
            if (primaryMatch.packsize > 0) row.packsize = primaryMatch.packsize;
            if (row.itemcode <= 0 && primaryMatch.itemcode > 0) row.itemcode = primaryMatch.itemcode;
        }
        else
        {
            row.availablestock = PatientSoldItems.Where(s => 
                (row.itemcode > 0 && s.itemcode == row.itemcode) || (!string.IsNullOrEmpty(row.itemname) && string.Equals(s.itemname?.Trim(), row.itemname.Trim(), StringComparison.OrdinalIgnoreCase))).Sum(s => s.availableqty);
        }
    }

