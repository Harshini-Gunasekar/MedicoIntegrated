    // Load only items purchased/sold to this specific patient
    private async Task LoadSoldItemsForPatient(PatientSelectItem patient)
    {
        IsLoadingPatientItems = true;
        PatientSoldItems.Clear();
        ReturnRows = new List<ReturnItemRow>
        {
            new ReturnItemRow
            {
                warehousecode = SelectedDefaultWarehouseCode > 0 ? SelectedDefaultWarehouseCode : WarehouseList.FirstOrDefault()?.warehousecode,
                packsize = 1,
                returnqty = 0,
                rate = 0
            }
        };
        ItemSearchTexts.Clear();
        StateHasChanged();

        try
        {
            var matchingSales = FindMatchingSalesForPatient(patient);

            // If no matching sales found in memory, refresh sales list from server
            if (!matchingSales.Any())
            {
                await RefreshAllSalesFromServerAsync();
                matchingSales = FindMatchingSalesForPatient(patient);
            }

            var soldList = new List<PatientSoldItem>();

            foreach (var sale in matchingSales)
            {
                var details = await FetchDetailsForSaleAsync(sale);
                if (details != null && details.Any())
                {
                    foreach (var d in details)
                    {
                        if (d.itemcode <= 0 && string.IsNullOrWhiteSpace(d.itemname)) continue;

                        decimal soldQty = d.soldqty > 0 ? d.soldqty : (d.quantity > 0 ? d.quantity : 0);
                        
                        // Calculate already returned quantity for this salesdetailcode
                        decimal alreadyReturned = SalesReturnLogs
                            .Where(l => (d.salesdetailcode > 0 && l.salesdetailcode == d.salesdetailcode) ||
                                        (d.salescode > 0 && l.salescode == d.salescode && ((d.itemcode > 0 && l.itemcode == d.itemcode) || (!string.IsNullOrEmpty(d.itemname) && string.Equals(l.itemname, d.itemname, StringComparison.OrdinalIgnoreCase))) && l.batchno == d.batchno))
                            .Sum(l => l.totalqty > 0 ? l.totalqty : l.returnqty);

                        decimal avail = Math.Max(0, soldQty - alreadyReturned);

                        var resolvedItemName = !string.IsNullOrWhiteSpace(d.itemname) 
                            ? d.itemname 
                            : (d.itemcode > 0 ? GetItemName(d.itemcode) : "Medicine");

                        soldList.Add(new PatientSoldItem
                        {
                            salesdetailcode = d.salesdetailcode,
                            salescode = d.salescode > 0 ? d.salescode : sale.salescode,
                            billno = sale.billno,
                            billdate = sale.billdate != default ? sale.billdate : (DateTime?)null,
                            itemcode = d.itemcode,
                            itemname = resolvedItemName,
                            batchno = d.batchno ?? "",
                            soldqty = soldQty,
                            returnedqty = alreadyReturned,
                            rate = d.rate > 0 ? d.rate : (soldQty > 0 && d.amount > 0 ? d.amount / soldQty : 0),
                            packsize = d.packsize > 0 ? d.packsize : 1,
                            warehousecode = d.warehousecode > 0 ? d.warehousecode : (sale.warehousefield != null ? WarehouseList.FirstOrDefault(w => string.Equals(w.warehousename, sale.warehousefield, StringComparison.OrdinalIgnoreCase))?.warehousecode : null),
                            warehousename = GetWarehouseName(d.warehousecode > 0 ? d.warehousecode : (sale.warehousefield != null ? WarehouseList.FirstOrDefault(w => string.Equals(w.warehousename, sale.warehousefield, StringComparison.OrdinalIgnoreCase))?.warehousecode : null))
                        });
                    }
                }
            }

            PatientSoldItems = soldList;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadSoldItemsForPatient] Error: {ex.Message}");
        }
        finally
        {
            IsLoadingPatientItems = false;
            StateHasChanged();
        }
    }

    private List<sales_master> FindMatchingSalesForPatient(PatientSelectItem patient)
    {
        var pName = (patient.patientname ?? "").Trim();
        var pId = (patient.patientid ?? "").Trim();
        var pMob = (patient.mobileno ?? "").Trim();
        var pCustCode = patient.customercode;

        return AllSalesList.Where(s =>
        {
            if (s.deleted) return false;

            // 1. Exact match by customercode
            if (pCustCode > 0)
            {
                if (s.customercode.HasValue && s.customercode.Value == pCustCode) return true;
                if (!string.IsNullOrWhiteSpace(s.patientid))
                {
                    var sPid = s.patientid.Trim();
                    if (sPid == pCustCode.ToString() || sPid == $"CUST-{pCustCode}" || sPid == $"OP-{pCustCode}" || sPid == $"IP-{pCustCode}") return true;
                }
            }

            // 2. Exact match by non-empty Patient ID / OP / IP Number
            if (!string.IsNullOrWhiteSpace(pId) && !string.IsNullOrWhiteSpace(s.patientid))
            {
                var cleanSPid = s.patientid.Trim().TrimStart('#').Replace("OPD/", "").Replace("OP/", "").Replace("IPD/", "").Replace("IP/", "").Replace("CUST-", "").Trim();
                var cleanPId = pId.TrimStart('#').Replace("OPD/", "").Replace("OP/", "").Replace("IPD/", "").Replace("IP/", "").Replace("CUST-", "").Trim();
                
                if (cleanSPid.Length >= 2 && cleanPId.Length >= 2 && string.Equals(cleanSPid, cleanPId, StringComparison.OrdinalIgnoreCase))
                {
                    return true;
                }
            }

            // 3. Exact match by Patient Name (case-insensitive)
            if (!string.IsNullOrWhiteSpace(pName) && pName.Length >= 2)
            {
                var genericNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "counter sales", "walk in", "walk-in", "cash customer", "general", "patient", "guest", "customer", "self" };
                
                var normPName = pName.Trim();
                if (!genericNames.Contains(normPName))
                {
                    // Check s.patientname
                    if (!string.IsNullOrWhiteSpace(s.patientname))
                    {
                        var normSName = s.patientname.Trim();
                        if (!genericNames.Contains(normSName) && string.Equals(normSName, normPName, StringComparison.OrdinalIgnoreCase))
                        {
                            // Ensure no conflicting positive customercodes
                            if (pCustCode <= 0 || !s.customercode.HasValue || s.customercode.Value <= 0 || s.customercode.Value == pCustCode)
                            {
                                return true;
                            }
                        }
                    }

                    // Check s.customername
                    if (!string.IsNullOrWhiteSpace(s.customername))
                    {
                        var normSCust = s.customername.Trim();
                        if (!genericNames.Contains(normSCust) && string.Equals(normSCust, normPName, StringComparison.OrdinalIgnoreCase))
                        {
                            // Ensure no conflicting positive customercodes
                            if (pCustCode <= 0 || !s.customercode.HasValue || s.customercode.Value <= 0 || s.customercode.Value == pCustCode)
                            {
                                return true;
                            }
                        }
                    }
                }
            }

            // 4. Exact match by 10-digit mobile number
            if (!string.IsNullOrWhiteSpace(pMob) && !string.IsNullOrWhiteSpace(s.mobileno))
            {
                var cleanPMob = new string(pMob.Where(char.IsDigit).ToArray());
                var cleanSMob = new string(s.mobileno.Where(char.IsDigit).ToArray());
                if (cleanPMob.Length >= 10 && cleanSMob.Length >= 10 && cleanPMob == cleanSMob)
                {
                    var dummyMobiles = new HashSet<string> { "0000000000", "1234567890", "9999999999", "1111111111" };
                    if (!dummyMobiles.Contains(cleanPMob))
                    {
                        if (pCustCode <= 0 || !s.customercode.HasValue || s.customercode.Value <= 0 || s.customercode.Value == pCustCode)
                        {
                            return true;
                        }
                    }
                }
            }

            return false;
        }).ToList();
    }

    private async Task<List<sales_detail>> FetchDetailsForSaleAsync(sales_master sale)
    {
        if (sale.salescode <= 0 && string.IsNullOrWhiteSpace(sale.billno)) return new();

        var cleanBillNo = (sale.billno ?? "").TrimStart('#').Trim();
        var rawBillNo = (sale.billno ?? "").Trim();

        if (sale.salescode > 0 && _salesDetailsCache.TryGetValue(sale.salescode, out var cached) && cached != null && cached.Any())
        {
            return cached;
        }

        if (!string.IsNullOrEmpty(cleanBillNo) && _salesDetailsCacheByBill.TryGetValue(cleanBillNo, out var cachedByBill) && cachedByBill != null && cachedByBill.Any())
        {
            return cachedByBill;
        }

        if (!string.IsNullOrEmpty(rawBillNo) && _salesDetailsCacheByBill.TryGetValue(rawBillNo, out var cachedByRawBill) && cachedByRawBill != null && cachedByRawBill.Any())
        {
            return cachedByRawBill;
        }

        var client = CreateClient();
        var urls = new List<string>();

        if (sale.salescode > 0)
        {
            urls.Add($"api/ItemMaster/getsalesbycode?salescode={sale.salescode}&tenantcode={DefaultTenant}");
            urls.Add($"api/ItemMaster/getsalesbycode?salesCode={sale.salescode}&tenantCode={DefaultTenant}");
            urls.Add($"api/ItemMaster/getsalesbycode/{sale.salescode}?tenantcode={DefaultTenant}");
            urls.Add($"api/ItemMaster/getsalesbycode/{sale.salescode}");
            urls.Add($"api/ItemMaster/getsalesbycode?salescode={sale.salescode}");
            urls.Add($"api/ItemMaster/getsales?salescode={sale.salescode}&tenantcode={DefaultTenant}");
            urls.Add($"api/ItemMaster/getsales?salescode={sale.salescode}");
        }

        if (!string.IsNullOrEmpty(cleanBillNo))
        {
            urls.Add($"api/ItemMaster/getsalesbycode?billno={Uri.EscapeDataString(cleanBillNo)}&tenantcode={DefaultTenant}");
            urls.Add($"api/ItemMaster/getsalesbycode?billno={Uri.EscapeDataString(cleanBillNo)}");
            urls.Add($"api/ItemMaster/getsalesbycode?billNo={Uri.EscapeDataString(cleanBillNo)}&tenantcode={DefaultTenant}");
            urls.Add($"api/ItemMaster/getsalesbycode?billNo={Uri.EscapeDataString(cleanBillNo)}");
            urls.Add($"api/ItemMaster/getsales?billno={Uri.EscapeDataString(cleanBillNo)}&tenantcode={DefaultTenant}");
            urls.Add($"api/ItemMaster/getsales?billno={Uri.EscapeDataString(cleanBillNo)}");
        }

        if (!string.IsNullOrEmpty(rawBillNo) && rawBillNo != cleanBillNo)
        {
            urls.Add($"api/ItemMaster/getsalesbycode?billno={Uri.EscapeDataString(rawBillNo)}&tenantcode={DefaultTenant}");
            urls.Add($"api/ItemMaster/getsalesbycode?billno={Uri.EscapeDataString(rawBillNo)}");
            urls.Add($"api/ItemMaster/getsales?billno={Uri.EscapeDataString(rawBillNo)}&tenantcode={DefaultTenant}");
            urls.Add($"api/ItemMaster/getsales?billno={Uri.EscapeDataString(rawBillNo)}");
        }

        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true, NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString };

        foreach (var url in urls)
        {
            try
            {
                var response = await client.GetStringAsync(url);
                if (!string.IsNullOrWhiteSpace(response))
                {
                    var parsedDetails = ParseSalesDetailsForSale(response, sale, options);
                    if (parsedDetails != null && parsedDetails.Any())
                    {
                        if (sale.salescode > 0) _salesDetailsCache[sale.salescode] = parsedDetails;
                        if (!string.IsNullOrEmpty(cleanBillNo)) _salesDetailsCacheByBill[cleanBillNo] = parsedDetails;
                        if (!string.IsNullOrEmpty(rawBillNo)) _salesDetailsCacheByBill[rawBillNo] = parsedDetails;
                        return parsedDetails;
                    }
                }
            }
            catch { }
        }

        return new();
    }

