    private IEnumerable<PatientSelectItem> GetFilteredPatients()
    {
        if (string.IsNullOrWhiteSpace(PatientSearchInputText))
        {
            return PatientList.OrderByDescending(p => p.salescount).Take(40);
        }

        var term = PatientSearchInputText.Trim().ToLower();
        return PatientList.Where(p =>
            (!string.IsNullOrEmpty(p.patientname) && p.patientname.ToLower().Contains(term)) ||
            (!string.IsNullOrEmpty(p.patientid) && p.patientid.ToLower().Contains(term)) ||
            (!string.IsNullOrEmpty(p.mobileno) && p.mobileno.Contains(term)) ||
            p.customercode.ToString().Contains(term)
        ).OrderByDescending(p => p.patientname != null && p.patientname.ToLower().StartsWith(term))
         .ThenByDescending(p => p.salescount)
         .Take(40);
    }

