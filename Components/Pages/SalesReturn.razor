    private async Task LoadPatientsAndSales()
    {
        try {
            var client = CreateClient();
            var patientsDict = new Dictionary<string, PatientSelectItem>(StringComparer.OrdinalIgnoreCase);

            // 1. Fetch OP Registrations (matches Pharmacy Billing OP list)
            try {
                var opRaw = await BookingService.GetAllOpRegistrationsAsync();
                if (opRaw != null) {
                    foreach (var op in opRaw.Where(x => !x.isdeleted)) {
                        if (string.IsNullOrWhiteSpace(op.patient_name) && op.custid <= 0) continue;
                        var key = op.custid > 0 ? $"C_{(long)op.custid}" : (op.patient_name ?? $"OP_{op.op_no}");
                        if (!patientsDict.ContainsKey(key)) {
                            patientsDict[key] = new PatientSelectItem {
                                customercode = (long)op.custid,
                                patientid = !string.IsNullOrEmpty(op.op_no) ? op.op_no : (op.custid > 0 ? $"OP-{(long)op.custid}" : null),
                                patientname = op.patient_name,
                                mobileno = op.mobile
                            };
                        }
                    }
                }
            } catch (Exception ex) {
                Console.WriteLine($"[LoadPatientsAndSales] OP load notice: {ex.Message}");
            }

            // 2. Fetch IP Registrations (matches Pharmacy Billing IP list)
            try {
                var active = await IpService.GetIpRegistrationsAsync("ADMITTED");
                var discharged = await IpService.GetIpRegistrationsAsync("DISCHARGED");
                var ipCombined = (active ?? new()).Concat(discharged ?? new()).ToList();
                foreach (var ip in ipCombined.Where(x => !x.isdeleted)) {
                    if (string.IsNullOrWhiteSpace(ip.patient_name) && ip.custid <= 0) continue;
                    var key = ip.custid > 0 ? $"C_{(long)ip.custid}" : (ip.patient_name ?? $"IP_{ip.ip_no}");
                    if (!patientsDict.ContainsKey(key)) {
                        patientsDict[key] = new PatientSelectItem {
                            customercode = (long)ip.custid,
                            patientid = !string.IsNullOrEmpty(ip.ip_no) ? ip.ip_no : (ip.custid > 0 ? $"IP-{(long)ip.custid}" : null),
                            patientname = ip.patient_name,
                            mobileno = ip.mobile
                        };
                    }
                }
            } catch (Exception ex) {
                Console.WriteLine($"[LoadPatientsAndSales] IP load notice: {ex.Message}");
            }

            // 3. Fetch Labcare Partition Patients with tenant_code 0004
            try {
                using var directClient = new HttpClient();
                directClient.DefaultRequestHeaders.Add("tenant_code", "0004");
                var partResp = await directClient.GetStringAsync("http://labcareapi.iscansoft.com/api/Customer/partition?pagenumber=1&pagesize=1000");
                if (!string.IsNullOrWhiteSpace(partResp)) {
                    using var doc = JsonDocument.Parse(partResp);
                    var root = doc.RootElement;
                    if (root.ValueKind == JsonValueKind.Array) {
                        foreach (var el in root.EnumerateArray()) {
                            long cCode = 0;
                            if (el.TryGetProperty("custid", out var cid) && cid.ValueKind == JsonValueKind.Number) cCode = cid.GetInt64();
                            string? cName = null;
                            if (el.TryGetProperty("name", out var nm)) cName = nm.GetString();
                            string? mob = null;
                            if (el.TryGetProperty("mobile", out var mProp)) mob = mProp.GetString();
                            else if (el.TryGetProperty("mobileno", out var mnProp)) mob = mnProp.GetString();
                            string? city = null;
                            if (el.TryGetProperty("city", out var ctProp)) city = ctProp.GetString();

                            if (cCode > 0 || !string.IsNullOrWhiteSpace(cName)) {
                                var key = cCode > 0 ? $"C_{cCode}" : (cName ?? "");
                                if (!patientsDict.TryGetValue(key, out var p)) {
                                    patientsDict[key] = new PatientSelectItem {
                                        customercode = cCode,
                                        patientid = cCode > 0 ? $"CUST-{cCode}" : null,
                                        patientname = cName ?? $"Patient #{cCode}",
                                        mobileno = mob,
                                        city = city
                                    };
                                } else {
                                    if (string.IsNullOrEmpty(p.mobileno) && !string.IsNullOrEmpty(mob)) p.mobileno = mob;
                                    if (string.IsNullOrEmpty(p.city) && !string.IsNullOrEmpty(city)) p.city = city;
                                }
                            }
                        }
                    }
                }
            } catch { }

            // 4. Fetch DoctorApi Partition Customers
            try {
                var partitionResp = await client.GetStringAsync("api/Customer/partition?pagenumber=1&pagesize=1000");
                if (!string.IsNullOrWhiteSpace(partitionResp)) {
                    using var doc = JsonDocument.Parse(partitionResp);
                    var root = doc.RootElement;
                    if (root.ValueKind == JsonValueKind.Array) {
                        foreach (var el in root.EnumerateArray()) {
                            long cCode = 0;
                            if (el.TryGetProperty("custid", out var cid) && cid.ValueKind == JsonValueKind.Number) cCode = cid.GetInt64();
                            else if (el.TryGetProperty("customercode", out var ccode) && ccode.ValueKind == JsonValueKind.Number) cCode = ccode.GetInt64();

                            string? cName = null;
                            if (el.TryGetProperty("name", out var nm)) cName = nm.GetString();
                            else if (el.TryGetProperty("customername", out var cnm)) cName = cnm.GetString();

                            string? pid = null;
                            if (el.TryGetProperty("patientid", out var pProp)) pid = pProp.GetString();
                            else if (el.TryGetProperty("custcode", out var ccProp)) pid = ccProp.GetString();

                            string? mob = null;
                            if (el.TryGetProperty("mobile", out var mProp)) mob = mProp.GetString();
                            else if (el.TryGetProperty("mobileno", out var mnProp)) mob = mnProp.GetString();

                            string? city = null;
                            if (el.TryGetProperty("city", out var ctProp)) city = ctProp.GetString();

                            if (cCode > 0 || !string.IsNullOrWhiteSpace(cName)) {
                                var key = cCode > 0 ? $"C_{cCode}" : (cName ?? "");
                                if (!patientsDict.TryGetValue(key, out var p)) {
                                    patientsDict[key] = new PatientSelectItem {
                                        customercode = cCode,
                                        patientid = pid ?? (cCode > 0 ? $"CUST-{cCode}" : null),
                                        patientname = cName ?? $"Patient #{cCode}",
                                        mobileno = mob,
                                        city = city
                                    };
                                }
                            }
                        }
                    }
                }
            } catch { }

            // 5. Fetch All Sales to identify all patients who have purchased items
            try {
                await RefreshAllSalesFromServerAsync();

                foreach (var s in AllSalesList) {
                    var key = s.customercode.HasValue && s.customercode.Value > 0 ? $"C_{s.customercode.Value}" : (!string.IsNullOrEmpty(s.patientname) ? s.patientname : (!string.IsNullOrEmpty(s.patientid) ? s.patientid : $"S_{s.salescode}"));
                    
                    if (!patientsDict.TryGetValue(key, out var pItem)) {
                        pItem = new PatientSelectItem {
                            customercode = s.customercode ?? 0,
                            patientid = s.patientid,
                            patientname = !string.IsNullOrEmpty(s.patientname) ? s.patientname : (!string.IsNullOrEmpty(s.customername) ? s.customername : (s.customercode > 0 ? $"Customer #{s.customercode}" : $"Patient #{s.salescode}")),
                            mobileno = s.mobileno,
                            city = s.address
                        };
                        patientsDict[key] = pItem;
                    }
                    pItem.salescount++;
                    if (string.IsNullOrEmpty(pItem.patientid) && !string.IsNullOrEmpty(s.patientid)) pItem.patientid = s.patientid;
                    if (string.IsNullOrEmpty(pItem.mobileno) && !string.IsNullOrEmpty(s.mobileno)) pItem.mobileno = s.mobileno;
                }
            } catch { }

            PatientList = patientsDict.Values
                .OrderByDescending(p => p.salescount)
                .ThenBy(p => p.patientname)
                .ToList();

            CustomerList = PatientList.Select(p => new customer_master {
                customercode = p.customercode,
                customername = p.patientname
            }).ToList();

        } catch (Exception ex) {
            Console.WriteLine($"[LoadPatientsAndSales] Error: {ex.Message}");
        }
    }

    private async Task RefreshAllSalesFromServerAsync()
    {
        try
        {
            var client = CreateClient();
            var urls = new[]
            {
                "api/ItemMaster/getsales",
                $"api/ItemMaster/getsales?tenantcode={DefaultTenant}",
                "ItemMaster/getsales"
            };

            foreach (var url in urls)
            {
                try
                {
                    var salesResp = await client.GetStringAsync(url);
                    if (!string.IsNullOrWhiteSpace(salesResp))
                    {
                        var parsed = ParseSalesListResponse(salesResp, out _);
                        if (parsed != null && parsed.Any())
                        {
                            AllSalesList = parsed.Where(s => !s.deleted).OrderByDescending(s => s.salescode).ToList();
                            break;
                        }
                    }
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RefreshAllSalesFromServerAsync] Error: {ex.Message}");
        }
    }

    private static bool TryGetPropertyIgnoreCase(JsonElement el, string name, out JsonElement prop)
    {
        prop = default;
        if (el.ValueKind != JsonValueKind.Object) return false;
        foreach (var p in el.EnumerateObject()) {
            if (string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase)) {
                prop = p.Value;
                return true;
            }
        }
        return false;
    }

    private static string? GetJsonStringSafe(JsonElement p)
    {
        if (p.ValueKind == JsonValueKind.String) return p.GetString();
        if (p.ValueKind == JsonValueKind.Number) return p.GetRawText();
        if (p.ValueKind == JsonValueKind.True) return "true";
        if (p.ValueKind == JsonValueKind.False) return "false";
        if (p.ValueKind == JsonValueKind.Null || p.ValueKind == JsonValueKind.Undefined) return null;
        return p.GetRawText();
    }

    private sales_master? ParseMaster(JsonElement el, JsonSerializerOptions options)
    {
        var target = el;
        if (el.TryGetProperty("master", out var mProp)) target = mProp;

        sales_master? m = null;
        try {
            m = JsonSerializer.Deserialize<sales_master>(target.GetRawText(), options);
        } catch { }

        m ??= new sales_master();

        if (m.salescode == 0) {
            foreach(var key in new[] { "salescode", "sales_code", "code", "id" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) || TryGetPropertyIgnoreCase(el, key, out p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetInt64(out var valNum)) { m.salescode = valNum; break; }
                    else if (p.ValueKind == JsonValueKind.String && long.TryParse(p.GetString(), out var val)) { m.salescode = val; break; }
                }
            }
        }
        if (string.IsNullOrEmpty(m.billno)) {
            foreach(var key in new[] { "billno", "bill_no", "invoiceno", "invoice_no" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) || TryGetPropertyIgnoreCase(el, key, out p)) {
                    m.billno = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.billno)) break;
                }
            }
        }
        if (m.billdate == default) {
            foreach(var key in new[] { "billdate", "bill_date", "createddate", "created_date" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) || TryGetPropertyIgnoreCase(el, key, out p)) {
                    if (p.ValueKind == JsonValueKind.String && DateTime.TryParse(p.GetString(), out var dt)) {
                        m.billdate = dt;
                        break;
                    } else if (p.TryGetDateTime(out var dtVal)) {
                        m.billdate = dtVal;
                        break;
                    }
                }
            }
        }
        if (string.IsNullOrEmpty(m.patientname)) {
            foreach(var key in new[] { "patientname", "patient_name", "customername", "name" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) || TryGetPropertyIgnoreCase(el, key, out p)) {
                    m.patientname = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.patientname)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.customername)) {
            foreach(var key in new[] { "customername", "customer_name", "patientname", "patient_name" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) || TryGetPropertyIgnoreCase(el, key, out p)) {
                    m.customername = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.customername)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.mobileno)) {
            foreach(var key in new[] { "mobileno", "mobile_no", "mobile", "phone", "phoneno", "contactno" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) || TryGetPropertyIgnoreCase(el, key, out p)) {
                    m.mobileno = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.mobileno)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.patientid)) {
            foreach(var key in new[] { "patientid", "patient_id", "customercode", "customer_code", "op_no", "ip_no" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) || TryGetPropertyIgnoreCase(el, key, out p)) {
                    var pid = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(pid) && pid != "0") {
                        m.patientid = pid;
                        break;
                    }
                }
            }
        }
        if (!m.customercode.HasValue || m.customercode.Value == 0) {
            foreach(var key in new[] { "customercode", "customer_code", "custid", "cust_id" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) || TryGetPropertyIgnoreCase(el, key, out p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetInt64(out var cVal)) { m.customercode = cVal; break; }
                    else if (p.ValueKind == JsonValueKind.String && long.TryParse(p.GetString(), out var cStrVal)) { m.customercode = cStrVal; break; }
                }
            }
        }
        if (string.IsNullOrEmpty(m.salestype)) {
            foreach(var key in new[] { "salestype", "sales_type" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) || TryGetPropertyIgnoreCase(el, key, out p)) {
                    m.salestype = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.salestype)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.warehousefield)) {
            foreach(var key in new[] { "warehousefield", "warehouse_field", "warehousename", "storename" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) || TryGetPropertyIgnoreCase(el, key, out p)) {
                    m.warehousefield = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.warehousefield)) break;
                }
            }
        }
        if (m.netamount == 0) {
            foreach(var key in new[] { "netamount", "net_amount", "totalamount", "total" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) || TryGetPropertyIgnoreCase(el, key, out p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetDecimal(out var dVal)) { m.netamount = dVal; break; }
                    else if (p.ValueKind == JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) { m.netamount = val; break; }
                }
            }
        }
        if (string.IsNullOrEmpty(m.paymentmode)) {
            foreach(var key in new[] { "paymentmode", "payment_mode", "paymode" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) || TryGetPropertyIgnoreCase(el, key, out p)) {
                    m.paymentmode = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.paymentmode)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.tenantcode)) {
            foreach(var key in new[] { "tenantcode", "tenant_code", "tenantCode", "tenant" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) || TryGetPropertyIgnoreCase(el, key, out p)) {
                    m.tenantcode = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.tenantcode)) break;
                }
            }
        }

        // Cache any inline details if present on el or target
        JsonElement detailsArrayProp = default;
        bool hasDetails = false;
        foreach (var detailKey in new[] { "details", "detail", "salesdetail", "salesdetails", "sales_detail", "sales_details", "items", "itemlist" })
        {
            if ((TryGetPropertyIgnoreCase(el, detailKey, out detailsArrayProp) || TryGetPropertyIgnoreCase(target, detailKey, out detailsArrayProp)) && detailsArrayProp.ValueKind == JsonValueKind.Array)
            {
                hasDetails = true;
                break;
            }
        }

        if (hasDetails && detailsArrayProp.ValueKind == JsonValueKind.Array)
        {
            var parsed = new List<sales_detail>();
            foreach (var dEl in detailsArrayProp.EnumerateArray())
            {
                var dItem = ParseSalesDetailItem(dEl, options);
                if (dItem != null && (dItem.itemcode > 0 || !string.IsNullOrEmpty(dItem.itemname)))
                {
                    if (dItem.salescode <= 0 && m.salescode > 0) dItem.salescode = m.salescode;
                    parsed.Add(dItem);
                }
            }

            if (parsed.Any())
            {
                if (m.salescode > 0) _salesDetailsCache[m.salescode] = parsed;
                var rawB = (m.billno ?? "").Trim();
                var cleanB = (m.billno ?? "").TrimStart('#').Trim();
                if (!string.IsNullOrEmpty(cleanB)) _salesDetailsCacheByBill[cleanB] = parsed;
                if (!string.IsNullOrEmpty(rawB)) _salesDetailsCacheByBill[rawB] = parsed;
            }
        }

        return m;
    }

    private List<sales_master> ParseSalesListResponse(string json, out string? parseError)
    {
        parseError = null;
        if (string.IsNullOrWhiteSpace(json)) return new();
        var options = new JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };
        
        try {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            
            JsonElement arrayElement = default;
            bool foundArray = false;

            if (root.ValueKind == JsonValueKind.Array) {
                arrayElement = root;
                foundArray = true;
            } else if (root.ValueKind == JsonValueKind.Object) {
                if (root.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == JsonValueKind.Array) {
                    arrayElement = dataProp;
                    foundArray = true;
                } else {
                    foreach (var prop in root.EnumerateObject()) {
                        if (prop.Value.ValueKind == JsonValueKind.Array) {
                            arrayElement = prop.Value;
                            foundArray = true;
                            break;
                        }
                    }
                }
            }

            if (!foundArray) {
                return new();
            }

            var result = new List<sales_master>();
            foreach (var item in arrayElement.EnumerateArray()) {
                try {
                    var m = ParseMaster(item, options);
                    if (m != null) result.Add(m);
                } catch { }
            }
            return result.OrderByDescending(x => x.salescode > 0 ? x.salescode : x.billdate.Ticks).ToList();
        } catch (Exception ex) {
            Console.WriteLine("Parse Error: " + ex.Message);
            parseError = $"JSON Parse Error: {ex.Message}";
        }

        return new();
    }

    private List<sales_detail> ParseSalesDetailsForSale(string json, sales_master sale, JsonSerializerOptions options)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.ValueKind == JsonValueKind.Object && TryGetPropertyIgnoreCase(root, "data", out var dataProp))
            {
                root = dataProp;
            }

            // If root is an Array of multiple sales, find the specific sale element for this bill/salescode
            if (root.ValueKind == JsonValueKind.Array && root.GetArrayLength() > 0)
            {
                var cleanTargetBill = (sale.billno ?? "").TrimStart('#').Trim();
                var rawTargetBill = (sale.billno ?? "").Trim();
                JsonElement? matchedSaleEl = null;

                foreach (var el in root.EnumerateArray())
                {
                    if (el.ValueKind == JsonValueKind.Object)
                    {
                        string? bNo = null;
                        long sCode = 0;
                        if (TryGetPropertyIgnoreCase(el, "billno", out var bp) || TryGetPropertyIgnoreCase(el, "bill_no", out bp) || TryGetPropertyIgnoreCase(el, "invoiceno", out bp)) bNo = GetJsonStringSafe(bp);
                        if (TryGetPropertyIgnoreCase(el, "salescode", out var scp) || TryGetPropertyIgnoreCase(el, "sales_code", out scp))
                        {
                            if (scp.ValueKind == JsonValueKind.Number) sCode = scp.GetInt64();
                            else if (scp.ValueKind == JsonValueKind.String && long.TryParse(scp.GetString(), out var scVal)) sCode = scVal;
                        }

                        if (el.TryGetProperty("master", out var mObj) && mObj.ValueKind == JsonValueKind.Object)
                        {
                            if (TryGetPropertyIgnoreCase(mObj, "billno", out var mbp) || TryGetPropertyIgnoreCase(mObj, "bill_no", out mbp) || TryGetPropertyIgnoreCase(mObj, "invoiceno", out mbp)) bNo = GetJsonStringSafe(mbp);
                            if (TryGetPropertyIgnoreCase(mObj, "salescode", out var mscp) || TryGetPropertyIgnoreCase(mObj, "sales_code", out mscp))
                            {
                                if (mscp.ValueKind == JsonValueKind.Number) sCode = mscp.GetInt64();
                                else if (mscp.ValueKind == JsonValueKind.String && long.TryParse(mscp.GetString(), out var mscVal)) sCode = mscVal;
                            }
                        }

                        var cleanItemBill = (bNo ?? "").TrimStart('#').Trim();
                        var rawItemBill = (bNo ?? "").Trim();
                        if ((!string.IsNullOrEmpty(cleanTargetBill) && string.Equals(cleanItemBill, cleanTargetBill, StringComparison.OrdinalIgnoreCase)) ||
                            (!string.IsNullOrEmpty(rawTargetBill) && string.Equals(rawItemBill, rawTargetBill, StringComparison.OrdinalIgnoreCase)) ||
                            (sale.salescode > 0 && sCode == sale.salescode))
                        {
                            matchedSaleEl = el;
                            break;
                        }
                    }
                }

                if (matchedSaleEl.HasValue)
                {
                    root = matchedSaleEl.Value;
                }
                else
                {
                    var firstEl = root[0];
                    if (firstEl.ValueKind == JsonValueKind.Object && (TryGetPropertyIgnoreCase(firstEl, "itemcode", out _) || TryGetPropertyIgnoreCase(firstEl, "itemname", out _) || TryGetPropertyIgnoreCase(firstEl, "item_name", out _)))
                    {
                        // root is directly the list of sales_detail
                    }
                    else
                    {
                        // If none matched, check if firstEl has details and root length is 1
                        foreach (var dKey in new[] { "details", "detail", "salesdetail", "salesdetails", "sales_detail", "sales_details", "items" })
                        {
                            if (firstEl.ValueKind == JsonValueKind.Object && TryGetPropertyIgnoreCase(firstEl, dKey, out var dArr) && dArr.ValueKind == JsonValueKind.Array)
                            {
                                if (root.GetArrayLength() == 1)
                                {
                                    root = dArr;
                                }
                                break;
                            }
                        }
                    }
                }
            }

            if (root.ValueKind == JsonValueKind.Object)
            {
                foreach (var dKey in new[] { "details", "detail", "salesdetail", "salesdetails", "sales_detail", "sales_details", "items", "itemlist", "data" })
                {
                    if (TryGetPropertyIgnoreCase(root, dKey, out var detailsProp) && detailsProp.ValueKind == JsonValueKind.Array)
                    {
                        root = detailsProp;
                        break;
                    }
                }
            }

            if (root.ValueKind == JsonValueKind.Array)
            {
                var list = new List<sales_detail>();
                foreach (var el in root.EnumerateArray())
                {
                    var d = ParseSalesDetailItem(el, options);
                    if (d != null && (d.itemcode > 0 || !string.IsNullOrEmpty(d.itemname)))
                    {
                        if (d.salescode <= 0 && sale.salescode > 0) d.salescode = sale.salescode;
                        list.Add(d);
                    }
                }
                return list;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ParseSalesDetailsForSale] Error: {ex.Message}");
        }

        return new();
    }

    private sales_detail ParseSalesDetailItem(JsonElement el, JsonSerializerOptions options)
    {
        var d = new sales_detail();
        try {
            d = JsonSerializer.Deserialize<sales_detail>(el.GetRawText(), options) ?? new sales_detail();
        } catch { }

        if (string.IsNullOrEmpty(d.itemname)) {
            foreach (var key in new[] { "itemname", "item_name", "productname", "product_name", "item", "name", "medicine_name", "item_title", "description" }) {
                if (TryGetPropertyIgnoreCase(el, key, out var p)) {
                    d.itemname = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(d.itemname)) break;
                }
            }
        }

        if (d.salesdetailcode == 0) {
            foreach (var key in new[] { "salesdetailcode", "sales_detail_code", "detailcode", "id" }) {
                if (TryGetPropertyIgnoreCase(el, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetInt64(out var v)) { d.salesdetailcode = v; break; }
                    else if (p.ValueKind == JsonValueKind.String && long.TryParse(p.GetString(), out var v2)) { d.salesdetailcode = v2; break; }
                }
            }
        }

        if (d.salescode == 0) {
            foreach (var key in new[] { "salescode", "sales_code", "sale_code" }) {
                if (TryGetPropertyIgnoreCase(el, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetInt64(out var v)) { d.salescode = v; break; }
                    else if (p.ValueKind == JsonValueKind.String && long.TryParse(p.GetString(), out var v2)) { d.salescode = v2; break; }
                }
            }
        }

        if (d.itemcode == 0) {
            foreach (var key in new[] { "itemcode", "item_code", "itemid", "item_id", "productcode", "product_code" }) {
                if (TryGetPropertyIgnoreCase(el, key, out var p)) {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetInt64(out var v)) { d.itemcode = v; break; }
                    else if (p.ValueKind == JsonValueKind.String && long.TryParse(p.GetString(), out var v2)) { d.itemcode = v2; break; }
                }
            }
        }

        if (d.itemcode == 0 && !string.IsNullOrEmpty(d.itemname)) {
            var matchItem = ItemList.FirstOrDefault(i => string.Equals(i.itemname, d.itemname, StringComparison.OrdinalIgnoreCase));
            if (matchItem != null) {
                d.itemcode = matchItem.itemcode;
            }
        }

        if (string.IsNullOrEmpty(d.itemname) && d.itemcode > 0) {
            d.itemname = GetItemName(d.itemcode);
        }

        if (string.IsNullOrEmpty(d.batchno)) {
            foreach (var key in new[] { "batchno", "batch_no", "batch", "batchNumber", "batch_num" }) {
                if (TryGetPropertyIgnoreCase(el, key, out var p)) {
                    d.batchno = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(d.batchno)) break;
                }
            }
        }

        if (d.soldqty == 0 && d.quantity == 0) {
