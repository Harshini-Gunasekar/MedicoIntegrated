    private async Task SearchPatientsOnline(string term, CancellationToken token)
    {
        try
        {
            var client = CreateClient();
            var searchUrls = new[]
            {
                $"api/Customer/search?key={Uri.EscapeDataString(term)}",
                $"Customer/search?key={Uri.EscapeDataString(term)}",
                $"api/Customer/partition?search={Uri.EscapeDataString(term)}&pagenumber=1&pagesize=50"
            };

            bool addedNew = false;
            foreach (var url in searchUrls)
            {
                try
                {
                    var resp = await client.GetAsync(url, token);
                    if (resp.IsSuccessStatusCode)
                    {
                        var content = await resp.Content.ReadAsStringAsync(token);
                        if (!string.IsNullOrWhiteSpace(content))
                        {
                            using var doc = JsonDocument.Parse(content);
                            var root = doc.RootElement;
                            if (root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var dProp)) root = dProp;
                            if (root.ValueKind == JsonValueKind.Array)
                            {
                                foreach (var el in root.EnumerateArray())
                                {
                                    long cCode = 0;
                                    if (el.TryGetProperty("custid", out var cid) && cid.ValueKind == JsonValueKind.Number) cCode = cid.GetInt64();
                                    else if (el.TryGetProperty("customercode", out var ccode) && ccode.ValueKind == JsonValueKind.Number) cCode = ccode.GetInt64();

                                    string? cName = null;
                                    if (el.TryGetProperty("name", out var nm)) cName = nm.GetString();
                                    else if (el.TryGetProperty("customername", out var cnm)) cName = cnm.GetString();
                                    else if (el.TryGetProperty("patient_name", out var pnm)) cName = pnm.GetString();

                                    string? pid = null;
                                    if (el.TryGetProperty("patientid", out var pProp)) pid = pProp.GetString();
                                    else if (el.TryGetProperty("custcode", out var ccProp)) pid = ccProp.GetString();
                                    else if (el.TryGetProperty("op_no", out var opProp)) pid = opProp.GetString();

                                    string? mob = null;
                                    if (el.TryGetProperty("mobile", out var mProp)) mob = mProp.GetString();
                                    else if (el.TryGetProperty("mobileno", out var mnProp)) mob = mnProp.GetString();

                                    string? city = null;
                                    if (el.TryGetProperty("city", out var ctProp)) city = ctProp.GetString();

                                    if (cCode > 0 || !string.IsNullOrWhiteSpace(cName))
                                    {
                                        if (!PatientList.Any(p => (cCode > 0 && p.customercode == cCode) || (!string.IsNullOrEmpty(cName) && string.Equals(p.patientname, cName, StringComparison.OrdinalIgnoreCase))))
                                        {
                                            PatientList.Add(new PatientSelectItem
                                            {
                                                customercode = cCode,
                                                patientid = pid,
                                                patientname = cName ?? $"Patient #{cCode}",
                                                mobileno = mob,
                                                city = city,
                                                salescount = AllSalesList.Count(s => (cCode > 0 && s.customercode == cCode) || (!string.IsNullOrEmpty(cName) && string.Equals(s.patientname, cName, StringComparison.OrdinalIgnoreCase)))
                                            });
                                            addedNew = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                catch { }
            }

            if (addedNew)
            {
                StateHasChanged();
            }
        }
        catch { }
    }

