    private async Task SubmitReturn()
    {
        if (!hasCreateRight && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to add or edit sales returns.");
            return;
        }

        if (SelectedCustomerCode == null && string.IsNullOrEmpty(SelectedPatientName))
        {
            ToastService.ShowWarning("Please select a Customer / Patient first.");
            return;
        }

        var validRows = ReturnRows.Where(r => r.itemcode > 0 && r.returnqty > 0).ToList();
        if (!validRows.Any())
        {
            ToastService.ShowWarning("Please enter return quantity for at least one item.");
            return;
        }

        // Validate each row for return quantity vs sold quantity
        foreach (var r in validRows)
        {
            var itemName = !string.IsNullOrEmpty(r.itemname) ? r.itemname : GetItemName(r.itemcode);
            if (string.IsNullOrWhiteSpace(r.batchno))
            {
                ToastService.ShowWarning($"Please select a batch no for item: {itemName}");
                return;
            }

            if (r.warehousecode == null || r.warehousecode <= 0)
            {
                ToastService.ShowWarning($"Store is missing for item: {itemName}");
                return;
            }

            if (r.returnqty > r.availablestock && r.availablestock > 0)
            {
                ToastService.ShowError($"Return quantity ({r.returnqty}) exceeds available sold quantity ({r.availablestock}) for {itemName}.");
                return;
            }
        }

        IsSaving = true;
        try
        {
            var client = CreateClient();
            var submissionRequest = new sales_return_request
            {
                customercode = SelectedCustomerCode > 0 ? SelectedCustomerCode : validRows.FirstOrDefault(r => r.customercode > 0)?.customercode,
                usercode = CurrentUserCode > 0 ? CurrentUserCode : 1,
                tenantcode = DefaultTenant,
                remarks = !string.IsNullOrWhiteSpace(HeaderRemarks) ? HeaderRemarks : ReturnReferenceNo,
                items = validRows.Select(r => new sales_return_item_request
                {
                    salesdetailcode = r.salesdetailcode,
                    salescode = r.salescode,
                    itemcode = r.itemcode,
                    batchno = r.batchno,
                    returnqty = r.returnqty,
                    packsize = r.packsize > 0 ? r.packsize : 1,
                    warehousecode = r.warehousecode > 0 ? r.warehousecode : SelectedDefaultWarehouseCode,
                    remarks = !string.IsNullOrWhiteSpace(r.remarks) ? r.remarks : (!string.IsNullOrWhiteSpace(HeaderRemarks) ? HeaderRemarks : ReturnReferenceNo)
                }).ToList()
            };

            var returnResponse = await client.PostAsJsonAsync("api/ItemMaster/insertsalesreturn", submissionRequest);
            if (returnResponse.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Sales return registered successfully.");
                ShowModal = false;
                ResetForm();
                await Task.WhenAll(LoadStocks(), LoadSalesReturnLogs(), LoadPatientsAndSales());
            }
            else
            {
                var err = await returnResponse.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to save sales return: {err}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
        }
    }

