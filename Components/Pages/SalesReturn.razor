    private readonly string[] _returnRowFieldPrefixes = { "item-input", "batch", "store", "packsize", "returnqty" };

    private async Task HandleRowKeyDown(KeyboardEventArgs e, int rowIndex, int fieldIndex)
    {
        if (e.Key == "Enter")
        {
            int nextField = fieldIndex + 1;
            int nextRow = rowIndex;
            if (nextField >= _returnRowFieldPrefixes.Length)
            {
                nextField = 0;
                nextRow = rowIndex + 1;
                // If next row doesn't exist, add one
                if (nextRow >= ReturnRows.Count)
                {
                    await AddRow();
                    return;
                }
            }
            var targetId = $"{_returnRowFieldPrefixes[nextField]}-{nextRow}";
            try
            {
                await JS.InvokeVoidAsync("focusElement", targetId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[HandleRowKeyDown] Error focusing element '{targetId}': {ex.Message}");
            }
        }
    }

