@page "/warehousemaster"
@page "/warehouses"
@using Booking.Models
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.NotificationService NotificationService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<div class="items-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                            <polyline points="9 22 9 12 15 12 15 22" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Store Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total stores : @WarehouseList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by name, code or location..." @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    <button class="add-item-btn" @onclick="AddNewWarehouse">
                        <i class="bi bi-plus-lg"></i>
                        <span class="ms-1">Add Store</span>
                    </button>
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredWarehouses.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        No stores found. Create a new store.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 70px; text-align: center;">S.NO</th>
                                    <th style="width: 100px; text-align: center;">CODE</th>
                                    <th style="width: 22%; text-align: center;">STORE NAME</th>
                                    <th style="width: 14%; text-align: center;">SHORT NAME</th>
                                    <th style="width: 18%; text-align: center;">LOCATION</th>
                                    <th style="width: 26%; text-align: center;">DESCRIPTION</th>
                                    <th style="width: 120px; text-align: center;">STATUS</th>
                                    <th style="width: 100px; text-align: center;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedWarehouses.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td style="text-align: center; font-weight: 700; color: #3b82f6;">@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td style="text-align: center; font-weight: 700; color: #4f46e5;">#@row.value.warehousecode</td>
                                        <td style="font-weight: 700; color: #0f172a; text-align: center;">@row.value.warehousename</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.shortname) ? "N/A" : row.value.shortname)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.location) ? "N/A" : row.value.location)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.description) ? "N/A" : row.value.description)</td>
                                        <td style="text-align: center;">
                                            @if (row.value.isactive)
                                            {
                                                <span style="color: #059669; font-weight: 700; font-size: 0.78rem; text-transform: uppercase;">Active</span>
                                            }
                                            else
                                            {
                                                <span style="color: #64748b; font-weight: 700; font-size: 0.78rem; text-transform: uppercase;">Inactive</span>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            <button class="action-btn btn-edit" @onclick="() => EditWarehouse(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var warehouse in PagedWarehouses)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span>#@warehouse.warehousecode - @warehouse.warehousename</span>
                                    <div>
                                        <button class="action-btn btn-edit" @onclick="() => EditWarehouse(warehouse)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(warehouse)" title="Delete"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Short Name</span><strong>@warehouse.shortname</strong></div>
                                    <div class="detail-row"><span>Location</span><strong>@warehouse.location</strong></div>
                                    <div class="detail-row"><span>Description</span><strong>@warehouse.description</strong></div>
                                    <div class="detail-row"><span>Order No</span><strong>@warehouse.orderno</strong></div>
                                    <div class="detail-row"><span>Purchase Allow</span><strong>@(warehouse.purchaseallow ? "Yes" : "No")</strong></div>
                                    <div class="detail-row"><span>Sales Allow</span><strong>@(warehouse.salesallow ? "Yes" : "No")</strong></div>
                                    <div class="detail-row"><span>Status</span><strong>@(warehouse.isactive ? "Active" : "Inactive")</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredWarehouses.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredWarehouses.Count()))</strong> of <strong>@FilteredWarehouses.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 800px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #000000 !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Store" : "Add Store")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentItem" OnValidSubmit="Save" autocomplete="off">
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 16px 16px 8px 0px;">
                        <div class="form-grid">
                            <div class="field-group col-6">
                                <label class="field-label required">Store Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.warehousename" placeholder="E.g. Main Distribution Store" />
                            </div>
                            
                            <div class="field-group col-3">
                                <label class="field-label">Short Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.shortname" placeholder="E.g. MDS" />
                            </div>

                            <div class="field-group col-3">
                                <label class="field-label">Order No</label>
                                <InputNumber class="form-control premium-input" @bind-Value="OrderNoInput" placeholder="0" />
                            </div>

                            <div class="field-group col-6" style="margin-top: 10px;">
                                <label class="field-label">Location</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.location" placeholder="E.g. Building A, Floor 2" />
                            </div>

                            <div class="field-group col-6" style="margin-top: 10px;">
                                <label class="field-label">Description</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.description" placeholder="Optional notes about the store..." />
                            </div>

                            <div class="field-group col-3" style="margin-top: 10px;">
                                <label class="field-label">Is Active?</label>
                                <div class="premium-segmented-control-joined" style="max-width: 130px; height: 32px; border-radius: 6px;">
                                    <button type="button" class="segment-btn-joined btn-false @(CurrentItem.isactive ? "" : "active")" @onclick="() => CurrentItem.isactive = false" style="font-size: 0.8rem;">
                                        False
                                    </button>
                                    <button type="button" class="segment-btn-joined btn-true @(CurrentItem.isactive ? "active" : "")" @onclick="() => CurrentItem.isactive = true" style="font-size: 0.8rem;">
                                        True
                                    </button>
                                </div>
                            </div>

                            <div class="field-group col-3 d-flex align-items-center" style="margin-top: 44px; height: 32px;">
                                <div class="form-check ms-1 d-flex align-items-center" style="margin-bottom: 0;">
                                    <InputCheckbox class="form-check-input" @bind-Value="CurrentItem.purchaseallow" id="purchaseAllowCheckbox" style="transform: scale(1.3); margin-right: 8px; margin-top: 0;" />
                                    <label class="form-check-label fw-bold mb-0" for="purchaseAllowCheckbox" style="font-size: 0.85rem; color: #334155; cursor: pointer; line-height: 1;">Purchase Allow</label>
                                </div>
                            </div>

                            <div class="field-group col-3 d-flex align-items-center" style="margin-top: 44px; height: 32px;">
                                <div class="form-check ms-1 d-flex align-items-center" style="margin-bottom: 0;">
                                    <InputCheckbox class="form-check-input" @bind-Value="CurrentItem.salesallow" id="salesAllowCheckbox" style="transform: scale(1.3); margin-right: 8px; margin-top: 0;" />
                                    <label class="form-check-label fw-bold mb-0" for="salesAllowCheckbox" style="font-size: 0.85rem; color: #334155; cursor: pointer; line-height: 1;">Sales Allow</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-actions" style="display: flex; justify-content: flex-end; align-items: center; padding: 1.5rem 2rem; border-top: 1px solid #f1f5f9; background: #fff;">
                        <div class="footer-right" style="display: flex; gap: 1rem; align-items: center;">
                            <button type="button" class="btn-cancel-modal" @onclick="CloseModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.75rem 2rem; border-radius: 12px; font-weight: 700; min-width: 120px; transition: all 0.2s;">
                                Cancel
                            </button>
                            <button type="submit" class="btn-save-premium" disabled="@IsSaving" style="background: #1c9f5f; color: white; border: none; padding: 0.75rem 2.5rem; border-radius: 12px; font-weight: 700; display: flex; align-items: center; gap: 8px; min-width: 160px; box-shadow: 0 4px 12px rgba(28, 159, 95, 0.2); transition: all 0.2s;">
                                @if (IsSaving)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle" style="font-size: 1.2rem;"></i>
                                }
                                <span>@(IsEdit ? "Update Store" : "Save Store")</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Popup -->
@if (ShowDeletePopup)
{
    <div class="action-popup-overlay" @onclick="CancelDelete">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Store</div>
            <div class="action-popup-body">Are you sure you want to delete this store? This action cannot be undone.</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" disabled="@IsDeleteProcessing" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<warehouse_master> WarehouseList = new();
    private string SearchQuery = string.Empty;
    private bool IsLoading;
    private bool IsSaving;
    private bool ShowModal;
    private bool IsEdit;
    private bool ShowDeletePopup;
    private bool IsDeleteProcessing;
    private bool IsCardView = false;
    private string DefaultTenantCode = "";

    private warehouse_master CurrentItem = new();
    private warehouse_master? PendingDelete;

    private int? OrderNoInput
    {
        get => !IsEdit && CurrentItem.orderno == WarehouseList.Count + 1 ? null : CurrentItem.orderno;
        set => CurrentItem.orderno = value ?? (WarehouseList.Count + 1);
    }

    private void SetView(bool cardView)
    {
        IsCardView = cardView;
        CurrentPage = 1;
    }

    private IEnumerable<warehouse_master> FilteredWarehouses =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? WarehouseList
            : WarehouseList.Where(w =>
                (w.warehousename?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (w.shortname?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (w.location?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                w.warehousecode.ToString().Contains(SearchQuery, StringComparison.OrdinalIgnoreCase));

    // Pagination
    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 12;
    private int TotalPages => (int)Math.Ceiling((double)FilteredWarehouses.Count() / ItemsPerPage);
    private IEnumerable<warehouse_master> PagedWarehouses => FilteredWarehouses.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
            
            await LoadWarehouses();
            StateHasChanged();
        }
    }

    private HttpClient CreateTenantClient()
    {
        var client = ClientFactory.CreateClient("InventoryApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenantCode);
        return client;
    }

    private async Task LoadWarehouses()
    {
        IsLoading = true;
        try
        {
            var client = CreateTenantClient();
            var responseString = await client.GetStringAsync("ItemMaster/getallwarehouse");
            
            try
            {
                var direct = System.Text.Json.JsonSerializer.Deserialize<List<warehouse_master>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                WarehouseList = (direct ?? new List<warehouse_master>()).Where(w => !w.isdeleted).OrderBy(w => w.orderno).ToList();
            }
            catch
            {
                var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<warehouse_master>>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                WarehouseList = (wrapped?.data ?? new List<warehouse_master>()).Where(w => !w.isdeleted).OrderBy(w => w.orderno).ToList();
            }
        }
        catch (Exception ex)
        {
            WarehouseList = new List<warehouse_master>();
            NotificationService.ShowNotification($"Failed to load stores: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        CurrentPage = 1;
    }

    private void AddNewWarehouse()
    {
        CurrentItem = new warehouse_master
        {
            tenantcode = 1011,
            isdeleted = false,
            isactive = true,
            createddate = DateTime.Now,
            orderno = WarehouseList.Count + 1,
            purchaseallow = false,
            salesallow = false
        };
        IsEdit = false;
        ShowModal = true;
    }

    private void EditWarehouse(warehouse_master warehouse)
    {
        CurrentItem = new warehouse_master
        {
            warehousecode = warehouse.warehousecode,
            warehousename = warehouse.warehousename,
            shortname = warehouse.shortname,
            location = warehouse.location,
            description = warehouse.description,
            orderno = warehouse.orderno,
            isactive = warehouse.isactive,
            tenantcode = warehouse.tenantcode,
            isdeleted = warehouse.isdeleted,
            createddate = warehouse.createddate,
            purchaseallow = warehouse.purchaseallow,
            salesallow = warehouse.salesallow
        };
        IsEdit = true;
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
        IsSaving = false;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(CurrentItem.warehousename))
        {
            NotificationService.ShowNotification("Store Name is required", NotificationType.Warning);
            return;
        }

        IsSaving = true;
        try
        {
            var client = CreateTenantClient();
            CurrentItem.tenantcode = 1011;
            CurrentItem.shortname ??= "";
            CurrentItem.location ??= "";
            CurrentItem.description ??= "";

            HttpResponseMessage response;
            if (IsEdit)
            {
                var payload = new
                {
                    warehousecode = CurrentItem.warehousecode,
                    orderno = CurrentItem.orderno,
                    warehousename = CurrentItem.warehousename,
                    shortname = CurrentItem.shortname,
                    description = CurrentItem.description,
                    location = CurrentItem.location,
                    tenantcode = CurrentItem.tenantcode,
                    isactive = CurrentItem.isactive,
                    isdeleted = CurrentItem.isdeleted,
                    createddate = CurrentItem.createddate,
                    purchaseallow = CurrentItem.purchaseallow,
                    salesallow = CurrentItem.salesallow
                };
                response = await client.PostAsJsonAsync("ItemMaster/upsertwarehouse", payload);
            }
            else
            {
                var payload = new
                {
                    orderno = CurrentItem.orderno,
                    warehousename = CurrentItem.warehousename,
                    shortname = CurrentItem.shortname,
                    description = CurrentItem.description,
                    location = CurrentItem.location,
                    tenantcode = CurrentItem.tenantcode,
                    isactive = CurrentItem.isactive,
                    isdeleted = CurrentItem.isdeleted,
                    createddate = CurrentItem.createddate,
                    purchaseallow = CurrentItem.purchaseallow,
                    salesallow = CurrentItem.salesallow
                };
                response = await client.PostAsJsonAsync("ItemMaster/upsertwarehouse", payload);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification(IsEdit ? "Store updated successfully" : "Store added successfully", NotificationType.Success);
                ShowModal = false;
                await LoadWarehouses();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                NotificationService.ShowNotification($"Save failed: {err}", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error saving store: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(warehouse_master warehouse)
    {
        PendingDelete = warehouse;
        ShowDeletePopup = true;
    }

    private void CancelDelete()
    {
        ShowDeletePopup = false;
        IsDeleteProcessing = false;
        PendingDelete = null;
    }

    private async Task DeleteConfirmed()
    {
        if (PendingDelete == null) return;

        IsDeleteProcessing = true;
        try
        {
            var client = CreateTenantClient();
            var code = PendingDelete.warehousecode;

            var attempts = new Func<Task<HttpResponseMessage>>[]
            {
                () => client.DeleteAsync($"ItemMaster/deletewarehouse?warehousecode={code}"),
                () => client.GetAsync($"ItemMaster/deletewarehouse?warehousecode={code}"),
                () => client.PostAsync($"ItemMaster/deletewarehouse?warehousecode={code}", null)
            };

            bool success = false;
            foreach (var attempt in attempts)
            {
                try
                {
                    var response = await attempt();
                    if (response.IsSuccessStatusCode)
                    {
                        success = true;
                        break;
                    }
                }
                catch { }
            }

            if (success)
            {
                NotificationService.ShowNotification("Store deleted successfully", NotificationType.Success);
                await LoadWarehouses();
            }
            else
            {
                NotificationService.ShowNotification("Delete failed", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error deleting: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            CancelDelete();
        }
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }
}
