<div class="stock-adj-page">
    <div class="stock-adj-shell">
        <!-- Premium Header Bar -->
        <div class="premium-header-card mb-3">
            <div class="header-card-left">
                <div class="header-card-icon">
                    <i class="bi bi-sliders2 fs-4"></i>
                </div>
                <div class="header-card-text">
                    <h2 class="header-card-heading">Stock Adjustment & Reconciliation</h2>
                    <div class="header-card-subheading">
                        <span class="status-dot"></span> Real-time physical inventory audit & batch management
                    </div>
                </div>
            </div>

            <div class="header-card-right d-flex align-items-center gap-2">
                <button class="btn btn-indigo-solid rounded-pill px-4 py-2 shadow d-flex align-items-center gap-2" @onclick="SubmitStockAdjustment">
                    <i class="bi bi-check2-circle fs-6"></i> <span>Save Adjustment</span>
                </button>
                <button class="btn btn-rose-solid rounded-pill px-3 py-2 shadow d-flex align-items-center gap-1" @onclick="ResetForm">
                    <i class="bi bi-arrow-counterclockwise fs-6"></i> <span>Reset</span>
                </button>
            </div>
        </div>

        <!-- Filter Controls Bar (Strict 1-Line Layout) -->
        <div class="filter-card p-2 px-3 mb-3">
            <div class="filter-bar-inline">
                <div class="filter-bar-item item-date">
                    <label class="filter-label m-0 text-nowrap"><i class="bi bi-calendar-event me-1 text-primary"></i>Date:</label>
                    <input type="date" class="form-control form-control-sm premium-input" @bind="AdjustmentDate" />
                </div>

                <div class="filter-bar-item item-warehouse">
                    <label class="filter-label m-0 text-nowrap"><i class="bi bi-building me-1 text-success"></i>Warehouse:</label>
                    <select class="form-select form-select-sm premium-input" ValueExpression="() => SelectedStoreCode" Value="SelectedStoreCode" ValueChanged="@((long storeCode) => OnStoreSelect(storeCode))">
                        <option value="0">-- All Stores / Select Store --</option>
                        @foreach (var store in WarehouseList)
                        {
                            <option value="@store.warehousecode">@store.warehousename</option>
                        }
                    </select>
                </div>

                <div class="filter-bar-item item-name">
                    <label class="filter-label m-0 text-nowrap"><i class="bi bi-capsule me-1 text-warning"></i>Item Name:</label>
                    <select class="form-select form-select-sm premium-input" ValueExpression="() => SelectedItemCode" Value="SelectedItemCode" ValueChanged="@((long code) => OnItemSelect(code))">
                        <option value="0">-- Select Item --</option>
                        @foreach (var item in ItemList)
                        {
                            <option value="@item.itemcode">@item.itemname</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Parallel Split View: Available Stock vs Adjust Stock -->
        <div class="parallel-tables-row">
            <!-- Left Table: Available Stock -->
            <div class="parallel-col">
                <div class="table-card available-card shadow-sm">
                    <div class="table-card-header d-flex justify-content-between align-items-center p-2 px-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-boxes text-primary fs-5"></i>
                            <div>
                                <h6 class="m-0 fw-bold text-dark" style="font-size: 0.9rem;">Available Batches</h6>
                            </div>
                        </div>
                        <span class="badge bg-indigo-subtle text-indigo border px-3 py-1 rounded-pill fw-bold" style="font-size: 0.75rem;">
                            <i class="bi bi-layers me-1"></i>@AvailableStockRows.Count Batches
                        </span>
                    </div>
                    <div class="table-card-body p-0">
                        <table class="table table-hover table-sm align-middle mb-0 custom-table">
                            <thead>
                                <tr>
                                    <th>BATCH NO</th>
                                    <th>EXPIRY</th>
                                    <th class="text-center">PACK SIZE</th>
                                    <th class="text-end">IN PACK</th>
                                    <th class="text-end">IN LOOSE</th>
                                    <th class="text-end">STOCK</th>
                                    <th class="text-center">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (AvailableStockRows.Any())
                                {
                                    @foreach (var row in AvailableStockRows)
                                    {
                                        var isSelected = SelectedStockRow?.stockcode == row.stockcode;
                                        <tr class="@(isSelected ? "table-active-row" : "")" @onclick="() => SelectStockRow(row)" style="cursor: pointer;">
                                            <td>
                                                <span class="batch-badge-blue">@row.batchno</span>
                                            </td>
                                            <td class="text-secondary fw-semibold">@(row.expirydate?.ToString("MMM yyyy") ?? "N/A")</td>
                                            <td class="text-center"><span class="badge bg-light text-dark border">@row.packsize</span></td>
                                            <td class="text-end fw-semibold">@row.inpack</td>
                                            <td class="text-end fw-semibold">@row.inloose</td>
                                            <td class="text-end fw-bold text-success fs-6">@row.closingstock.ToString("N0")</td>
                                            <td class="text-center">
                                                <button class="btn-add-action" title="Select for Adjustment">
                                                    <i class="bi bi-plus-circle-fill"></i> <span>Add</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-5">
                                            <i class="bi bi-funnel fs-2 text-indigo opacity-50 d-block mb-2"></i>
                                            Select a Warehouse and Item to view matching stock batches.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="table-card-footer p-2 border-top d-flex justify-content-between align-items-center px-3">
                        <span class="fw-bold small text-secondary"><i class="bi bi-calculator me-1 text-primary"></i>Available Summary</span>
                        <div class="small">
                            <span class="me-3 text-muted">Packs: <strong class="text-dark">@AvailableStockRows.Sum(r => r.inpack)</strong></span>
                            <span class="me-3 text-muted">Loose: <strong class="text-dark">@AvailableStockRows.Sum(r => r.inloose)</strong></span>
                            <span class="text-success fw-bold fs-6">Stock: @AvailableStockRows.Sum(r => r.closingstock).ToString("N0")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Table: Adjust Stock -->
            <div class="parallel-col">
                <div class="table-card adjust-card shadow-sm">
                    <div class="table-card-header d-flex justify-content-between align-items-center p-2 px-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-sliders me-1 text-teal fs-5"></i>
                            <div>
                                <h6 class="m-0 fw-bold text-dark" style="font-size: 0.9rem;">Stock Adjustments</h6>
                            </div>
                        </div>
                        <span class="badge bg-teal-subtle text-teal border px-3 py-1 rounded-pill fw-bold" style="font-size: 0.75rem;">
                            <i class="bi bi-check-all me-1"></i>@AdjustStockRows.Count Selected
                        </span>
                    </div>
                    <div class="table-card-body p-0">
                        <table class="table table-hover table-sm align-middle mb-0 custom-table">
                            <thead>
                                <tr>
                                    <th>BATCH NO</th>
                                    <th class="text-center">PACK SIZE</th>
                                    <th class="text-end">IN PACK</th>
                                    <th class="text-end">IN LOOSE</th>
                                    <th class="text-center">NEW QTY</th>
                                    <th class="text-end">DIFF</th>
                                    <th class="text-center">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (AdjustStockRows.Any())
                                {
                                    @foreach (var adjRow in AdjustStockRows)
                                    {
                                        <tr>
                                            <td>
                                                <span class="batch-badge-dark">@adjRow.batchno</span>
                                            </td>
                                            <td class="text-center">
                                                <input type="text" class="form-control form-control-sm grid-input text-center mx-auto" style="width: 50px;" @bind="adjRow.packsize" @bind:event="oninput" @onchange="() => RecalculateAdjustRow(adjRow)" />
                                            </td>
                                            <td class="text-end">
                                                <input type="number" class="form-control form-control-sm grid-input text-end ms-auto" style="width: 55px;" @bind="adjRow.inpack" @bind:event="oninput" @onchange="() => RecalculateAdjustRow(adjRow)" />
                                            </td>
                                            <td class="text-end">
                                                <input type="number" class="form-control form-control-sm grid-input text-end ms-auto" style="width: 55px;" @bind="adjRow.inloose" @bind:event="oninput" @onchange="() => RecalculateAdjustRow(adjRow)" />
                                            </td>
                                            <td class="text-center">
                                                <div class="qty-stepper-wrapper">
                                                    <button class="btn btn-stepper btn-minus" @onclick="() => DecrementStock(adjRow, 1m)" title="-1">
                                                        <i class="bi bi-dash"></i>
                                                    </button>
                                                    <input type="number" class="form-control form-control-sm grid-input text-center stepper-input" @bind="adjRow.newstock" @bind:event="oninput" @onchange="() => RecalculateAdjustRowDirect(adjRow)" />
                                                    <button class="btn btn-stepper btn-plus" @onclick="() => IncrementStock(adjRow, 1m)" title="+1">
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="fw-bold text-end">
                                                <span class="badge @(adjRow.difference > 0 ? "bg-success-subtle text-success" : adjRow.difference < 0 ? "bg-danger-subtle text-danger" : "bg-light text-secondary") border px-2 py-1 fs-6">
                                                    @(adjRow.difference >= 0 ? "+" : "")@adjRow.difference.ToString("N0")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn-remove-action" @onclick="() => RemoveAdjustRow(adjRow)" title="Remove batch">
                                                    <i class="bi bi-trash-fill"></i> <span>Remove</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-5">
                                            <i class="bi bi-sliders fs-2 text-teal opacity-50 d-block mb-2"></i>
                                            Click any batch from Available Stock to adjust.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="table-card-footer p-2 border-top d-flex justify-content-between align-items-center px-3">
                        <div class="small w-100 d-flex justify-content-between align-items-center">
                            <span class="text-muted">Total New Stock: <strong class="text-indigo fs-6 ms-1">@AdjustStockRows.Sum(r => r.newstock).ToString("N0")</strong></span>
                            <span class="fw-bold fs-6 @(AdjustStockRows.Sum(r => r.difference) >= 0 ? "text-success" : "text-danger")">
                                Total Diff: @(AdjustStockRows.Sum(r => r.difference) >= 0 ? "+" : "")@AdjustStockRows.Sum(r => r.difference).ToString("N0")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private DateTime AdjustmentDate = DateTime.Today;
    private long SelectedStoreCode = 0;
    private long SelectedItemCode = 0;

    private List<inventory_item_master> ItemList = new();
    private List<warehouse_master> WarehouseList = new();
    private List<stock_master> AllStockList = new();

    private List<AvailableStockRowModel> AvailableStockRows = new();
    private List<AdjustStockRowModel> AdjustStockRows = new();
    private AvailableStockRowModel? SelectedStockRow;

    // Create New Batch Fields
    private string NewBatchNo = "";
    private DateTime NewExpiryDate = DateTime.Today.AddYears(1);
    private string NewPackSize = "10";
    private decimal NewMRP = 0m;
    private decimal NewPurchaseRate = 0m;

    private string DefaultTenant = "TNT001";

    protected override async Task OnInitializedAsync()
    {
        await LoadUserRights();
        await Task.WhenAll(LoadItems(), LoadWarehouses(), LoadStocks());
    }

    private async Task LoadUserRights()
    {
        try
        {
            var res = await _sessionStorage.GetAsync<string>("tenant_code");
            if (res.Success && !string.IsNullOrWhiteSpace(res.Value))
            {
                DefaultTenant = res.Value;
            }
        }
        catch { }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        return client;
    }

    private async Task LoadItems()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallitems");
            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                try
                {
                    var direct = JsonSerializer.Deserialize<List<inventory_item_master>>(response, options);
                    ItemList = direct ?? new();
                }
                catch
                {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<inventory_item_master>>>(response, options);
                    ItemList = wrapped?.data ?? new();
                }
            }
        }
        catch { }
    }

    private async Task LoadWarehouses()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallwarehouse");
            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                try
                {
                    var direct = JsonSerializer.Deserialize<List<warehouse_master>>(response, options);
                    WarehouseList = direct?.Where(w => !w.isdeleted).ToList() ?? new();
                }
                catch
                {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<warehouse_master>>>(response, options);
                    WarehouseList = wrapped?.data?.Where(w => !w.isdeleted).ToList() ?? new();
                }
            }
        }
        catch { }
    }

    private async Task LoadStocks()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallstocks");
            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true, NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString };
                try
                {
                    var direct = JsonSerializer.Deserialize<List<stock_master>>(response, options);
                    if (direct != null && direct.Any()) AllStockList = direct.Where(x => !x.deleted).ToList();
                }
                catch { }

                if (!AllStockList.Any())
                {
                    try
                    {
                        var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<stock_master>>>(response, options);
                        if (wrapped?.data != null) AllStockList = wrapped.data.Where(x => !x.deleted).ToList();
                    }
                    catch { }
                }

                if (!AllStockList.Any())
                {
                    try
                    {
                        using var doc = JsonDocument.Parse(response);
                        var root = doc.RootElement;
                        if (root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var dataArr)) root = dataArr;
                        if (root.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var el in root.EnumerateArray())
                            {
                                var s = new stock_master();
                                if (el.TryGetProperty("stockcode", out var sc) || el.TryGetProperty("stock_code", out sc)) s.stockcode = sc.GetInt64();
                                if (el.TryGetProperty("itemcode", out var ic) || el.TryGetProperty("item_code", out ic)) s.itemcode = ic.GetInt64();
                                if (el.TryGetProperty("warehousecode", out var wc) || el.TryGetProperty("warehouse_code", out wc) || el.TryGetProperty("storecode", out wc)) s.warehousecode = wc.GetInt64();
                                if (el.TryGetProperty("batchno", out var bn) || el.TryGetProperty("batch_no", out bn)) s.batchno = bn.GetString();
                                if (el.TryGetProperty("closingstock", out var cs) || el.TryGetProperty("closing_stock", out cs) || el.TryGetProperty("qty", out cs)) s.closingstock = cs.GetDecimal();
                                if (el.TryGetProperty("unitcost", out var uc) || el.TryGetProperty("unit_cost", out uc) || el.TryGetProperty("rate", out uc)) s.unitcost = uc.GetDecimal();
                                if (el.TryGetProperty("expirydate", out var ed) || el.TryGetProperty("expiry_date", out ed)) { if (DateTime.TryParse(ed.GetString(), out var dt)) s.expirydate = dt; }
                                AllStockList.Add(s);
                            }
                        }
                    }
                    catch { }
                }
            }
        }
        catch { }
        FilterAvailableStock();
    }

    private void FilterAvailableStock()
    {
        AvailableStockRows.Clear();

        if (!AllStockList.Any()) return;

        var selectedItemObj = ItemList.FirstOrDefault(i => i.itemcode == SelectedItemCode);
        var selectedWarehouseObj = WarehouseList.FirstOrDefault(w => w.warehousecode == SelectedStoreCode);

        var matches = AllStockList.Where(s => {
            bool matchItem = SelectedItemCode <= 0 || s.itemcode == SelectedItemCode;
            if (!matchItem && selectedItemObj != null && !string.IsNullOrWhiteSpace(selectedItemObj.itemname))
            {
                // Loose match on item name if itemcode is 0 in stock table
                matchItem = true;
            }

            bool matchStore = SelectedStoreCode <= 0 || s.warehousecode == SelectedStoreCode || s.warehousecode == 0 || s.warehousecode == null;
            return matchItem && matchStore;
        }).ToList();

        // If specific item or store was selected and strict match yielded empty, show matches by item alone
        if (!matches.Any() && SelectedItemCode > 0)
        {
            matches = AllStockList.Where(s => s.itemcode == SelectedItemCode || s.itemcode == 0).ToList();
        }

        // If still no filter match but stocks exist, display all stocks as fallback
        if (!matches.Any() && SelectedStoreCode <= 0 && SelectedItemCode <= 0)
        {
            matches = AllStockList;
        }

        foreach (var s in matches)
        {
            AvailableStockRows.Add(new AvailableStockRowModel
            {
                stockcode = s.stockcode,
                itemcode = s.itemcode > 0 ? s.itemcode : SelectedItemCode,
                warehousecode = s.warehousecode ?? SelectedStoreCode,
                batchno = string.IsNullOrWhiteSpace(s.batchno) ? "B001" : s.batchno,
                expirydate = s.expirydate ?? DateTime.Today.AddYears(1),
                packsize = "10",
                inpack = (int)Math.Floor(s.closingstock / 10m),
                inloose = (int)(s.closingstock % 10m),
                closingstock = s.closingstock,
                unitcost = s.unitcost
            });
        }
    }

    private void OnStoreSelect(long storeCode)
    {
        SelectedStoreCode = storeCode;
        FilterAvailableStock();
    }

    private void OnItemSelect(long itemCode)
    {
        SelectedItemCode = itemCode;
        FilterAvailableStock();
    }

    private void SelectStockRow(AvailableStockRowModel row)
    {
        SelectedStockRow = row;
        var existing = AdjustStockRows.FirstOrDefault(r => r.stockcode == row.stockcode);
        if (existing == null)
        {
            var newAdjRow = new AdjustStockRowModel
            {
                stockcode = row.stockcode,
                itemcode = row.itemcode,
                warehousecode = row.warehousecode,
                batchno = row.batchno,
                packsize = row.packsize,
                inpack = row.inpack,
                inloose = row.inloose,
                oldstock = row.closingstock,
                newstock = row.closingstock,
                difference = 0,
                unitcost = row.unitcost,
                barcodeprint = false
            };
            AdjustStockRows.Add(newAdjRow);
        }
    }

    private void RecalculateAdjustRow(AdjustStockRowModel row)
    {
        if (int.TryParse(row.packsize, out int pSize) && pSize > 0)
        {
            row.newstock = (row.inpack * pSize) + row.inloose;
        }
        else
        {
            row.newstock = row.inpack + row.inloose;
        }
        row.difference = row.newstock - row.oldstock;
    }

    private void RecalculateAdjustRowDirect(AdjustStockRowModel row)
    {
        if (int.TryParse(row.packsize, out int pSize) && pSize > 0)
        {
            row.inpack = Math.Floor(row.newstock / pSize);
            row.inloose = row.newstock % pSize;
        }
        else
        {
            row.inpack = row.newstock;
            row.inloose = 0;
        }
        row.difference = row.newstock - row.oldstock;
    }

    private void IncrementStock(AdjustStockRowModel row, decimal amount = 1m)
    {
        row.newstock += amount;
        RecalculateAdjustRowDirect(row);
    }

    private void DecrementStock(AdjustStockRowModel row, decimal amount = 1m)
    {
        if (row.newstock >= amount)
        {
            row.newstock -= amount;
        }
        else
        {
            row.newstock = 0;
        }
        RecalculateAdjustRowDirect(row);
    }

    private void RemoveAdjustRow(AdjustStockRowModel row)
    {
        AdjustStockRows.Remove(row);
    }

    private void CreateBatchRow()
    {
        if (SelectedItemCode <= 0)
        {
            ToastService.ShowWarning("Please select an item first.");
            return;
        }
        if (string.IsNullOrWhiteSpace(NewBatchNo))
        {
            ToastService.ShowWarning("Please enter a batch number.");
            return;
        }

        var newAdj = new AdjustStockRowModel
        {
            stockcode = 0,
            itemcode = SelectedItemCode,
            warehousecode = SelectedStoreCode,
            batchno = NewBatchNo,
            packsize = NewPackSize,
            inpack = 0,
            inloose = 0,
            oldstock = 0,
            newstock = 0,
            difference = 0,
            unitcost = NewPurchaseRate,
            barcodeprint = true
        };
        AdjustStockRows.Add(newAdj);
        ToastService.ShowSuccess($"New Batch {NewBatchNo} added to adjustment list.");
    }

    private async Task SubmitStockAdjustment()
    {
        if (!AdjustStockRows.Any())
        {
            ToastService.ShowWarning("No stock adjustments specified.");
            return;
        }

        try
        {
            var client = CreateClient();
            int successCount = 0;

            foreach (var row in AdjustStockRows)
            {
                var stockObj = AllStockList.FirstOrDefault(s => s.stockcode == row.stockcode) ?? new stock_master
                {
                    stockcode = row.stockcode,
                    itemcode = row.itemcode,
                    warehousecode = row.warehousecode,
                    batchno = row.batchno,
                    closingstock = row.newstock,
                    unitcost = row.unitcost,
                    stockvalue = row.newstock * row.unitcost,
                    tenantcode = DefaultTenant
                };

                stockObj.closingstock = row.newstock;
                stockObj.stockvalue = row.newstock * row.unitcost;
                stockObj.tenantcode = DefaultTenant;
                stockObj.branchcode ??= "BLR001";
                stockObj.companycode ??= "CMP001";
                stockObj.isactive = true;
                stockObj.deleted = false;

                var options = new JsonSerializerOptions
                {
                    PropertyNamingPolicy = null
                };

                // Primary attempt: update stock via standard updatestock/insertstock endpoints
                string endpoint = stockObj.stockcode > 0 ? "api/ItemMaster/updatestock" : "api/ItemMaster/insertstock";
                var response = await client.PostAsJsonAsync(endpoint, stockObj, options);
                
                if (!response.IsSuccessStatusCode)
                {
                    // Secondary attempt: try combined payload request endpoint
                var logObj = new stock_adjustment_log
                {
                    stockcode = row.stockcode,
                    itemcode = row.itemcode,
                    warehousecode = row.warehousecode,
                    branchcode = "BLR001",
                    locationcode = "MAIN",
                    batchno = row.batchno,
                    beforeqty = row.oldstock,
                    adjustedqty = row.difference,
                    afterqty = row.newstock,
                    unitcost = row.unitcost,
                    stockvalue = row.newstock * row.unitcost,
                    adjustmenttype = row.difference >= 0 ? "Increase" : "Decrease",
                    adjustmentreason = string.IsNullOrWhiteSpace(row.adjustmentreason) ? "Physical Count" : row.adjustmentreason,
                    remarks = row.remarks,
                    adjustmentdate = AdjustmentDate,
                    isactive = true,
                    deleted = false,
                    createddate = DateTime.Now,
                    tenantcode = DefaultTenant,
                    companycode = "CMP001"
                };

                var payload = new stock_adjustment_request
                {
                    stock = stockObj,
                    adjustmentlog = logObj
                };

                    string adjEndpoint = row.stockcode > 0 ? "api/ItemMaster/updatestockadjustment" : "api/ItemMaster/insertstockadjustment";
                    response = await client.PostAsJsonAsync(adjEndpoint, payload, options);
                }

                if (response.IsSuccessStatusCode) successCount++;
            }

            if (successCount > 0)
            {
                ToastService.ShowSuccess($"{successCount} stock adjustment(s) saved successfully!");
                ResetForm();
                await LoadStocks();
            }
            else
            {
                ToastService.ShowError("Failed to save stock adjustment.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private void ResetForm()
    {
        SelectedItemCode = 0;
        SelectedStoreCode = 0;
        AvailableStockRows.Clear();
        AdjustStockRows.Clear();
        SelectedStockRow = null;
        NewBatchNo = "";
    }

