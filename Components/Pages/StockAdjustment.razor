<div class="stock-adj-main-wrapper">
    <!-- Top Header Card -->
    <div class="premium-header-card">
        <div class="header-card-left">
            <div class="header-card-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="21" x2="4" y2="14"></line>
                    <line x1="4" y1="10" x2="4" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12" y2="3"></line>
                    <line x1="20" y1="21" x2="20" y2="16"></line>
                    <line x1="20" y1="12" x2="20" y2="3"></line>
                    <line x1="1" y1="14" x2="7" y2="14"></line>
                    <line x1="9" y1="8" x2="15" y2="8"></line>
                    <line x1="17" y1="16" x2="23" y2="16"></line>
                </svg>
            </div>
            <div class="header-card-text">
                <h2 class="header-card-heading">Stock Adjustment & Reconciliation</h2>
                <div class="header-card-subheading">
                    <span class="status-dot"></span> Real-time physical inventory audit & batch management
                </div>
            </div>
        </div>

        <div class="header-card-right d-flex align-items-center gap-2">
            <button type="button" class="btn-header-log" @onclick="OpenAdjustmentLogModal" title="View Stock Adjustment History Logs">
                <i class="bi bi-clock-history"></i>
                <span>Adjustment Log</span>
                @if (AdjustmentLogsList.Any())
                {
                    <span class="badge-log-count">@AdjustmentLogsList.Count</span>
                }
            </button>
        </div>
    </div>

    <!-- Filter Controls Bar -->
    <div class="filter-card-main">
        <div class="filter-grid-layout">
            <!-- Date -->
            <div class="filter-field-group">
                <label class="filter-field-label">Date</label>
                <input type="date" class="form-control premium-adj-input" @bind="AdjustmentDate" />
            </div>

            <!-- Warehouse -->
            <div class="filter-field-group">
                <label class="filter-field-label">Warehouse / Store</label>
                <div style="position: relative;">
                    <select class="form-control premium-adj-input" ValueExpression="() => SelectedStoreCode" Value="SelectedStoreCode" ValueChanged="@((long storeCode) => OnStoreSelect(storeCode))" style="appearance: none !important; padding-right: 28px;">
                        <option value="0">-- All Stores / Select Store --</option>
                        @foreach (var store in WarehouseList)
                        {
                            <option value="@store.warehousecode">@store.warehousename</option>
                        }
                    </select>
                    <i class="bi bi-chevron-down" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b; font-size: 0.85rem;"></i>
                </div>
            </div>

            <!-- Item Search -->
            <div class="filter-field-group">
                <label class="filter-field-label">Item Name</label>
                <div class="search-input-field-wrap">
                    <input type="text" class="form-control premium-adj-input"
                           placeholder="Type to search item..."
                           value="@itemSearchText"
                           @oninput="OnItemSearchInput"
                           @onfocus="() => showItemDropdown = true"
                           @onblur="OnItemSearchBlur" />
                    <i class="bi bi-search item-field-search-icon"></i>
                    @if (showItemDropdown)
                    {
                        var filtered = ItemList
                            .Where(i => string.IsNullOrEmpty(itemSearchText) || (i.itemname != null && i.itemname.Contains(itemSearchText, StringComparison.OrdinalIgnoreCase)))
                            .ToList();
                        if (filtered.Any())
                        {
                            <div class="custom-typeahead-dropdown">
                                @foreach (var item in filtered)
                                {
                                    <div class="custom-typeahead-item" @onmousedown="() => SelectItem(item)">
                                        @item.itemname
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Parallel Tables: Available Stock vs Adjust Stock -->
    <div class="parallel-tables-row">
        <!-- Left Table: Available Batches -->
        <div class="table-card">
            <div class="table-card-header">
                <h6>Available Batches</h6>
                <span class="badge-pill">
                    @AvailableStockRows.Count Batches
                </span>
            </div>
            <div class="table-card-body">
                <table class="custom-adj-table">
                    <thead>
                        <tr>
                            <th style="text-align: left;">Item Name</th>
                            <th style="text-align: center;">Batch No</th>
                            <th style="text-align: center;">Expiry</th>
                            <th style="text-align: center;">Pack Size</th>
                            <th style="text-align: right;">Stock</th>
                            <th style="text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (AvailableStockRows.Any())
                        {
                            @foreach (var row in AvailableStockRows)
                            {
                                var isSelected = SelectedStockRow?.stockcode == row.stockcode;
                                <tr class="@(isSelected ? "table-active-row" : "")" @onclick="() => SelectStockRow(row)" style="cursor: pointer;">
                                    <td style="font-weight: 600; color: #0f172a;">
                                        @(ItemList.FirstOrDefault(i => i.itemcode == row.itemcode)?.itemname ?? $"Item {row.itemcode}")
                                    </td>
                                    <td style="text-align: center;">
                                        <span class="batch-badge">@row.batchno</span>
                                    </td>
                                    <td style="text-align: center; color: #64748b; font-size: 0.78rem;">
                                        @(row.expirydate?.ToString("MMM yyyy") ?? "N/A")
                                    </td>
                                    <td style="text-align: center; color: #475569;">@row.packsize</td>
                                    <td style="text-align: right; font-weight: 700; color: #059669;">@row.closingstock.ToString("N0")</td>
                                    <td style="text-align: center;">
                                        <button type="button" class="btn-add-action" title="Select for Adjustment">
                                            <i class="bi bi-plus-circle-fill"></i> <span>Add</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5" style="text-align: center !important;">
                                    <i class="bi bi-box-seam" style="font-size: 2rem; color: #cbd5e1; display: block; margin-bottom: 8px;"></i>
                                    Select a Warehouse or Item to view matching stock batches.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="table-card-footer">
                <span style="font-weight: 600; color: #64748b;">Available Summary</span>
                <div>
                    <span style="color: #059669; font-weight: 700;">Total Stock: @AvailableStockRows.Sum(r => r.closingstock).ToString("N0")</span>
                </div>
            </div>
        </div>

        <!-- Right Column: Stock Adjustments & Action Buttons -->
        <div class="right-adj-column" style="display: flex; flex-direction: column; gap: 12px; min-width: 0;">
            <div class="table-card">
                <div class="table-card-header">
                    <h6>Stock Adjustments</h6>
                    <span class="badge-pill">
                        @AdjustStockRows.Count Selected
                    </span>
                </div>
                <div class="table-card-body">
                    <table class="custom-adj-table">
                        <thead>
                            <tr>
                                <th style="text-align: left;">Item Name</th>
                                <th style="text-align: center;">Batch No</th>
                                <th style="text-align: center;">Pack Size</th>
                                <th style="text-align: center;">New Qty</th>
                                <th style="text-align: right;">Diff</th>
                                <th style="text-align: center; min-width: 110px;">Reason</th>
                                <th style="text-align: center;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (AdjustStockRows.Any())
                            {
                                @foreach (var adjRow in AdjustStockRows)
                                {
                                    <tr>
                                        <td style="font-weight: 600; color: #0f172a;">
                                            @(ItemList.FirstOrDefault(i => i.itemcode == adjRow.itemcode)?.itemname ?? $"Item {adjRow.itemcode}")
                                        </td>
                                        <td style="text-align: center;">
                                            <span class="batch-badge">@adjRow.batchno</span>
                                        </td>
                                        <td style="text-align: center;">
                                            <input type="text" class="form-control text-center mx-auto" style="width: 45px; height: 28px; font-size: 0.78rem; border-radius: 6px; border: 1px solid #cbd5e1; padding: 2px;" @bind="adjRow.packsize" @bind:event="oninput" @onchange="() => RecalculateAdjustRow(adjRow)" />
                                        </td>
                                        <td style="text-align: center;">
                                            <div class="qty-stepper-wrapper">
                                                <button type="button" class="btn-stepper btn-minus" @onclick="() => DecrementStock(adjRow, 1)" title="-1">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <input type="number" step="1" min="0" class="stepper-input" @bind="adjRow.newstock" @bind:event="oninput" @onchange="() => RecalculateAdjustRowDirect(adjRow)" />
                                                <button type="button" class="btn-stepper btn-plus" @onclick="() => IncrementStock(adjRow, 1)" title="+1">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td style="text-align: right; font-weight: 700;">
                                            <span class="badge" style="background: @(adjRow.difference > 0 ? "#dcfce7" : adjRow.difference < 0 ? "#fee2e2" : "#f1f5f9"); color: @(adjRow.difference > 0 ? "#15803d" : adjRow.difference < 0 ? "#b91c1c" : "#475569"); font-size: 0.75rem; border-radius: 6px; padding: 3px 6px;">
                                                @(adjRow.difference >= 0 ? "+" : "")@adjRow.difference.ToString("N0")
                                            </span>
                                        </td>
                                        <td style="text-align: center;">
                                            <select class="form-select form-select-sm" @bind="adjRow.adjustmentreason" style="font-size: 0.74rem; height: 30px; border-radius: 6px; border: 1px solid #cbd5e1; padding: 2px 6px;">
                                                <option value="Physical Count">Physical Count</option>
                                                <option value="Damage">Damage</option>
                                                <option value="Expiry">Expiry</option>
                                                <option value="Theft">Theft</option>
                                                <option value="Correction">Correction</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </td>
                                        <td style="text-align: center;">
                                            <button type="button" class="btn-remove-action" @onclick="() => RemoveAdjustRow(adjRow)" title="Remove batch">
                                                <i class="bi bi-trash-fill"></i> <span>Remove</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-5" style="text-align: center !important;">
                                        <i class="bi bi-sliders" style="font-size: 2rem; color: #cbd5e1; display: block; margin-bottom: 8px;"></i>
                                        Click "+ Add" on any batch from Available Stock to adjust.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="table-card-footer">
                    <span style="color: #64748b;">Total New Stock: <strong style="color: #4338ca; margin-left: 4px;">@AdjustStockRows.Sum(r => r.newstock).ToString("N0")</strong></span>
                    <span style="font-weight: 700; color: @(AdjustStockRows.Sum(r => r.difference) >= 0 ? "#059669" : "#dc2626");">
                        Total Diff: @(AdjustStockRows.Sum(r => r.difference) >= 0 ? "+" : "")@AdjustStockRows.Sum(r => r.difference).ToString("N0")
                    </span>
                </div>
            </div>

            <!-- Action Buttons exactly below Stock Adjustments table -->
            @if (AdjustStockRows.Any())
            {
                <div style="display: flex; justify-content: flex-end; align-items: center; gap: 12px; margin-top: 6px; width: 100%;">
                    <button type="button" class="btn-cancel-modal" @onclick="ResetForm" style="background: #ffffff; color: #334155; border: 1.5px solid #cbd5e1; padding: 0.55rem 1.6rem; border-radius: 10px; font-weight: 700; font-size: 0.85rem; transition: all 0.2s; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
                        Reset
                    </button>
                    <button type="button" class="btn-save-premium" @onclick="SubmitStockAdjustment" disabled="@IsSaving" style="min-width: 180px; height: 42px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; border-radius: 10px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; font-weight: 700; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3); transition: all 0.2s; cursor: pointer;">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" style="width: 1rem; height: 1rem;"></span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                        }
                        <span>Save Adjustment</span>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Stock Adjustment Log Modal -->
@if (showAdjustmentLogModal)
{
    <div class="log-modal-backdrop" @onclick="CloseAdjustmentLogModal"></div>
    <div class="log-modal-dialog animate-fade-in">
        <!-- Modal Header -->
        <div class="log-modal-header">
            <div class="header-card-left">
                <div class="header-card-icon" style="width: 40px; height: 40px;">
                    <i class="bi bi-clock-history" style="font-size: 1.15rem;"></i>
                </div>
                <div class="header-card-text">
                    <div class="return-log-title-row">
                        <h4 style="font-size: 1.05rem; font-weight: 700; color: #1e293b; margin: 0; line-height: 1.2;">Stock Adjustment Logs</h4>
                        <span class="return-log-count-badge">Total: @GetFilteredLogs().Count</span>
                    </div>
                    <span class="subtext" style="font-size: 0.72rem; color: #64748b; font-weight: 500; margin-top: 2px;">Audit trail of all physical stock adjustments</span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="button" class="return-refresh-btn" @onclick="LoadAdjustmentLogs" disabled="@loadingAdjustmentLogs">
                    <i class="bi bi-arrow-clockwise @(loadingAdjustmentLogs ? "spin" : "")"></i>
                    <span>Refresh</span>
                </button>
                <button type="button" class="btn-close ms-2" @onclick="CloseAdjustmentLogModal" aria-label="Close"></button>
            </div>
        </div>

        <!-- Filter Bar inside Modal -->
        <div style="padding: 12px 24px; border-bottom: 1px solid #f1f5f9; background: #ffffff; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <div class="return-search-wrapper" style="width: 320px;">
                <input type="text" class="return-search-input" placeholder="Search by Item, Batch, Reason, Log #..." @bind="logSearchQuery" @bind:event="oninput" />
                <i class="bi bi-search return-search-icon"></i>
                @if (!string.IsNullOrEmpty(logSearchQuery))
                {
                    <i class="bi bi-x-circle-fill return-search-clear" @onclick='() => logSearchQuery = ""'></i>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <label style="font-size: 0.76rem; font-weight: 700; color: #475569; margin: 0; text-transform: uppercase;">Type:</label>
                <select class="form-select form-select-sm" style="height: 36px; font-size: 0.8rem; border-radius: 8px; border: 1px solid #cbd5e1; width: 140px;" @bind="logTypeFilter">
                    <option value="ALL">All Types</option>
                    <option value="Increase">Increase (+)</option>
                    <option value="Decrease">Decrease (-)</option>
                </select>
            </div>
        </div>

        <!-- Modal Body Table -->
        <div class="log-modal-body">
            @if (loadingAdjustmentLogs)
            {
                <div class="text-center py-5 text-muted" style="text-align: center !important;">
                    <div class="spinner-border text-primary" role="status" style="width: 2rem; height: 2rem;"></div>
                    <p class="mt-2 text-muted" style="font-size: 0.82rem;">Loading adjustment logs...</p>
                </div>
            }
            else if (!GetFilteredLogs().Any())
            {
                <div class="text-center py-5" style="background: #f8fafc; border-radius: 12px; border: 1px dashed #cbd5e1; margin: 20px; text-align: center !important;">
                    <i class="bi bi-inbox" style="font-size: 2.2rem; color: #94a3b8;"></i>
                    <h5 class="mt-2" style="font-size: 0.95rem; font-weight: 700; color: #475569;">No Stock Adjustment Logs Found</h5>
                    <p class="text-muted mb-0" style="font-size: 0.78rem;">There are no adjustment records matching the selected filters.</p>
                </div>
            }
            else
            {
                <table class="custom-adj-table">
                    <thead>
                        <tr>
                            <th style="width: 55px; text-align: center;">LOG #</th>
                            <th style="text-align: center;">DATE</th>
                            <th style="text-align: left;">ITEM NAME</th>
                            <th style="text-align: left;">WAREHOUSE</th>
                            <th style="text-align: center;">BATCH NO</th>
                            <th style="text-align: right;">BEFORE</th>
                            <th style="text-align: center;">ADJUSTED</th>
                            <th style="text-align: right;">AFTER</th>
                            <th style="text-align: center;">TYPE</th>
                            <th style="text-align: left;">REASON</th>
                            <th style="text-align: center;">ADJUSTED BY</th>
                            <th style="text-align: center;">ACTION</th>
