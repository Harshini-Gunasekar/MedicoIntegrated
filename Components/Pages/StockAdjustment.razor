                            var itemName = ItemList.FirstOrDefault(i => i.itemcode == log.itemcode)?.itemname ?? $"Item #{log.itemcode}";
                            var whName = WarehouseList.FirstOrDefault(w => w.warehousecode == log.warehousecode)?.warehousename ?? (log.warehousecode > 0 ? $"Store #{log.warehousecode}" : "All Stores");
                            var isIncrease = log.adjustmenttype.Equals("Increase", StringComparison.OrdinalIgnoreCase) || (log.adjustedqty > 0 && log.afterqty > log.beforeqty);
                            <tr>
                                <td style="text-align: center; font-weight: 700; color: #6366f1;">
                                    #@log.adjustmentlogcode
                                </td>
                                <td style="text-align: center; color: #475569; font-size: 0.78rem;">
                                    @(log.adjustmentdate != default ? log.adjustmentdate.ToString("dd-MM-yyyy") : log.createddate != default ? log.createddate.ToString("dd-MM-yyyy") : "-")
                                </td>
                                <td style="font-weight: 600; color: #0f172a;">@itemName</td>
                                <td style="color: #334155; font-weight: 600;">@whName</td>
                                <td style="text-align: center;">
                                    <span class="batch-badge">@(string.IsNullOrWhiteSpace(log.batchno) ? "-" : log.batchno)</span>
                                </td>
                                <td style="text-align: right; color: #475569;">@log.beforeqty.ToString("N0")</td>
                                <td style="text-align: center; font-weight: 700;">
                                    <span class="badge" style="background: @(isIncrease ? "#dcfce7" : "#fee2e2"); color: @(isIncrease ? "#15803d" : "#b91c1c"); font-size: 0.75rem; border-radius: 6px; padding: 3px 6px;">
                                        @(isIncrease ? "+" : "-")@Math.Abs(log.adjustedqty).ToString("N0")
                                    </span>
                                </td>
                                <td style="text-align: right; font-weight: 700; color: #4338ca;">@log.afterqty.ToString("N0")</td>
                                <td style="text-align: center;">
                                    <span class="badge" style="background: @(isIncrease ? "#10b981" : "#ef4444"); color: #ffffff; border-radius: 20px; font-size: 0.7rem; padding: 3px 8px; font-weight: 600;">
                                        @log.adjustmenttype
                                    </span>
                                </td>
                                <td>
                                    <span style="font-size: 0.78rem; color: #475569;">@(string.IsNullOrWhiteSpace(log.adjustmentreason) ? "Physical Count" : log.adjustmentreason)</span>
                                </td>
                                <td style="text-align: center; font-size: 0.78rem; color: #64748b;">
                                    User #@(log.adjustedby ?? 1)
                                </td>
                                <td style="text-align: center;">
                                    <button type="button" class="btn btn-sm" @onclick="() => EditAdjustmentLog(log)" title="Load this adjustment record for modification" style="border: 1px solid #c7d2fe; background: #eef2ff; color: #4338ca; border-radius: 6px; padding: 2px 8px; font-size: 0.75rem; font-weight: 600;">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Modal Footer -->
        <div class="log-modal-footer">
            <div style="font-size: 0.76rem; color: #64748b; font-weight: 500;">
                Showing <strong>@GetFilteredLogs().Count</strong> of <strong>@AdjustmentLogsList.Count</strong> adjustment logs
            </div>
            <button type="button" class="btn-cancel-modal" @onclick="CloseAdjustmentLogModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.4rem 1.2rem; border-radius: 10px; font-weight: 700; cursor: pointer;">
                Close
            </button>
        </div>
    </div>
}

@code {
    private DateTime AdjustmentDate = DateTime.Today;
    private long SelectedStoreCode = 0;
    private long SelectedItemCode = 0;
    private string itemSearchText = "";
    private bool showItemDropdown = false;
    private bool IsSaving = false;

    private List<inventory_item_master> ItemList = new();
    private List<warehouse_master> WarehouseList = new();
    private List<stock_master> AllStockList = new();

    private List<AvailableStockRowModel> AvailableStockRows = new();
    private List<AdjustStockRowModel> AdjustStockRows = new();
    private AvailableStockRowModel? SelectedStockRow;

    private string DefaultTenant = "";
    private long loggedInUserCode = 7;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

            try
            {
                var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null && userResult.Value.UserCode.HasValue && userResult.Value.UserCode.Value > 0)
                {
                    loggedInUserCode = userResult.Value.UserCode.Value;
                }
                else
                {
                    var intRes = await _sessionStorage.GetAsync<int>("usercode");
                    if (intRes.Success && intRes.Value > 0)
                    {
                        loggedInUserCode = intRes.Value;
                    }
                }
            }
            catch { }

            await Task.WhenAll(LoadItems(), LoadWarehouses(), LoadStocks(), LoadAdjustmentLogs());
            StateHasChanged();
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
        return client;
    }

    private void OnItemSearchInput(ChangeEventArgs e)
    {
        itemSearchText = e.Value?.ToString() ?? "";
        showItemDropdown = true;
        if (string.IsNullOrWhiteSpace(itemSearchText))
        {
            SelectedItemCode = 0;
        }
        else
        {
            var matched = ItemList.FirstOrDefault(i => string.Equals(i.itemname, itemSearchText, StringComparison.OrdinalIgnoreCase));
            if (matched != null)
            {
                SelectedItemCode = matched.itemcode;
            }
            else
            {
                SelectedItemCode = 0;
            }
        }
        FilterAvailableStock();
    }

    private void SelectItem(inventory_item_master item)
    {
        SelectedItemCode = item.itemcode;
        itemSearchText = item.itemname ?? "";
        showItemDropdown = false;
        FilterAvailableStock();
    }

    private async Task OnItemSearchBlur()
    {
        await Task.Delay(200);
        showItemDropdown = false;
        if (SelectedItemCode > 0)
        {
            var item = ItemList.FirstOrDefault(i => i.itemcode == SelectedItemCode);
            if (item != null)
            {
                itemSearchText = item.itemname ?? "";
            }
        }
        else
        {
            itemSearchText = "";
        }
        StateHasChanged();
    }

    private async Task LoadItems()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallitems");
            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                try
                {
                    var direct = JsonSerializer.Deserialize<List<inventory_item_master>>(response, options);
                    ItemList = direct ?? new();
                }
                catch
                {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<inventory_item_master>>>(response, options);
                    ItemList = wrapped?.data ?? new();
                }
            }
        }
        catch { }
    }

    private async Task LoadWarehouses()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallwarehouse");
            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                try
                {
                    var direct = JsonSerializer.Deserialize<List<warehouse_master>>(response, options);
                    WarehouseList = direct?.Where(w => !w.isdeleted).ToList() ?? new();
                }
                catch
                {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<warehouse_master>>>(response, options);
                    WarehouseList = wrapped?.data?.Where(w => !w.isdeleted).ToList() ?? new();
                }
            }
        }
        catch { }
    }

    private async Task LoadStocks()
    {
        try
        {
            var client = CreateClient();
            var urls = new[]
            {
                $"api/ItemMaster/getallstocks?tenantcode={DefaultTenant}",
                "api/ItemMaster/getallstocks",
                "ItemMaster/getallstocks"
            };

            string? response = null;
            foreach (var url in urls)
            {
                try
                {
                    response = await client.GetStringAsync(url);
                    if (!string.IsNullOrWhiteSpace(response)) break;
                }
                catch { }
            }

            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true, NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString };
                List<stock_master>? loaded = null;
                try
                {
                    loaded = JsonSerializer.Deserialize<List<stock_master>>(response, options);
                }
                catch { }

                if (loaded == null || !loaded.Any())
                {
                    try
                    {
                        var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<stock_master>>>(response, options);
                        loaded = wrapped?.data;
                    }
                    catch { }
                }

                if (loaded == null || !loaded.Any())
                {
                    try
                    {
                        using var doc = JsonDocument.Parse(response);
                        var root = doc.RootElement;
                        if (root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var dataArr)) root = dataArr;
                        if (root.ValueKind == JsonValueKind.Array)
                        {
                            var list = new List<stock_master>();
                            foreach (var el in root.EnumerateArray())
                            {
                                var s = new stock_master();
                                if (el.TryGetProperty("stockcode", out var sc) || el.TryGetProperty("stock_code", out sc)) s.stockcode = sc.GetInt64();
                                if (el.TryGetProperty("itemcode", out var ic) || el.TryGetProperty("item_code", out ic)) s.itemcode = ic.GetInt64();
                                if (el.TryGetProperty("warehousecode", out var wc) || el.TryGetProperty("warehouse_code", out wc) || el.TryGetProperty("storecode", out wc)) s.warehousecode = wc.GetInt64();
                                if (el.TryGetProperty("batchno", out var bn) || el.TryGetProperty("batch_no", out bn)) s.batchno = bn.GetString();
                                if (el.TryGetProperty("closingstock", out var cs) || el.TryGetProperty("closing_stock", out cs) || el.TryGetProperty("qty", out cs)) s.closingstock = cs.GetDecimal();
                                if (el.TryGetProperty("unitcost", out var uc) || el.TryGetProperty("unit_cost", out uc) || el.TryGetProperty("rate", out uc)) s.unitcost = uc.GetDecimal();
                                if (el.TryGetProperty("expirydate", out var ed) || el.TryGetProperty("expiry_date", out ed)) { if (DateTime.TryParse(ed.GetString(), out var dt)) s.expirydate = dt; }
                                list.Add(s);
                            }
                            loaded = list;
                        }
                    }
                    catch { }
                }

                if (loaded != null)
                {
                    AllStockList = loaded.Where(x => !x.deleted).ToList();
                }
            }
        }
        catch { }
        finally
        {
            FilterAvailableStock();
            StateHasChanged();
        }
    }

    private void FilterAvailableStock()
    {
        AvailableStockRows.Clear();

        if (!AllStockList.Any()) return;

        var matchingItemCodes = new HashSet<long>();
        if (SelectedItemCode > 0)
        {
            matchingItemCodes.Add(SelectedItemCode);
        }
        else if (!string.IsNullOrWhiteSpace(itemSearchText))
        {
            var matchedItems = ItemList.Where(i => i.itemname != null && i.itemname.Contains(itemSearchText, StringComparison.OrdinalIgnoreCase));
            foreach (var item in matchedItems)
            {
                matchingItemCodes.Add(item.itemcode);
            }
        }

        var matches = AllStockList.Where(s => {
            bool matchItem = true;
            if (SelectedItemCode > 0 || !string.IsNullOrWhiteSpace(itemSearchText))
            {
                matchItem = matchingItemCodes.Contains(s.itemcode);
            }

            bool matchStore = SelectedStoreCode <= 0 || s.warehousecode == SelectedStoreCode || s.warehousecode == 0 || s.warehousecode == null;
            return matchItem && matchStore;
        }).ToList();

        if (!matches.Any() && (SelectedItemCode > 0 || !string.IsNullOrWhiteSpace(itemSearchText)))
        {
            matches = AllStockList.Where(s => matchingItemCodes.Contains(s.itemcode) || s.itemcode == 0).ToList();
        }

        if (!matches.Any() && SelectedStoreCode <= 0 && SelectedItemCode <= 0 && string.IsNullOrWhiteSpace(itemSearchText))
        {
            matches = AllStockList;
        }

        foreach (var s in matches)
        {
            var wholeClosing = (long)Math.Round(s.closingstock);
            AvailableStockRows.Add(new AvailableStockRowModel
            {
                stockcode = s.stockcode,
                itemcode = s.itemcode > 0 ? s.itemcode : (SelectedItemCode > 0 ? SelectedItemCode : s.itemcode),
                warehousecode = s.warehousecode ?? SelectedStoreCode,
                batchno = string.IsNullOrWhiteSpace(s.batchno) ? "B001" : s.batchno,
                expirydate = s.expirydate ?? DateTime.Today.AddYears(1),
                packsize = "10",
                inpack = wholeClosing / 10,
                inloose = wholeClosing % 10,
                closingstock = wholeClosing,
                unitcost = s.unitcost
            });
        }
    }

    private void OnStoreSelect(long storeCode)
    {
        SelectedStoreCode = storeCode;
        FilterAvailableStock();
    }

    private void SelectStockRow(AvailableStockRowModel row)
    {
        SelectedStockRow = row;
        var existing = AdjustStockRows.FirstOrDefault(r => r.stockcode == row.stockcode);
        if (existing == null)
        {
            var newAdjRow = new AdjustStockRowModel
            {
                stockcode = row.stockcode,
                itemcode = row.itemcode,
                warehousecode = row.warehousecode,
                batchno = row.batchno,
                packsize = row.packsize,
                inpack = row.inpack,
                inloose = row.inloose,
                oldstock = row.closingstock,
                newstock = row.closingstock,
                difference = 0,
                unitcost = row.unitcost,
                barcodeprint = false
            };
            AdjustStockRows.Add(newAdjRow);
        }
    }

    private void RecalculateAdjustRow(AdjustStockRowModel row)
    {
        if (long.TryParse(row.packsize, out long pSize) && pSize > 0)
        {
            row.inpack = row.newstock / pSize;
            row.inloose = row.newstock % pSize;
        }
        else
        {
            row.inpack = row.newstock;
            row.inloose = 0;
        }
        row.difference = row.newstock - row.oldstock;
    }

    private void RecalculateAdjustRowDirect(AdjustStockRowModel row)
    {
        if (long.TryParse(row.packsize, out long pSize) && pSize > 0)
        {
            row.inpack = row.newstock / pSize;
            row.inloose = row.newstock % pSize;
        }
        else
        {
            row.inpack = row.newstock;
            row.inloose = 0;
        }
        row.difference = row.newstock - row.oldstock;
    }

    private void IncrementStock(AdjustStockRowModel row, long amount = 1)
    {
        row.newstock += amount;
        RecalculateAdjustRowDirect(row);
    }

    private void DecrementStock(AdjustStockRowModel row, long amount = 1)
    {
        if (row.newstock >= amount)
        {
            row.newstock -= amount;
        }
        else
        {
            row.newstock = 0;
        }
        RecalculateAdjustRowDirect(row);
    }

    private void RemoveAdjustRow(AdjustStockRowModel row)
    {
        AdjustStockRows.Remove(row);
    }

    private async Task SubmitStockAdjustment()
    {
        if (!AdjustStockRows.Any())
        {
            ToastService.ShowWarning("No stock adjustments specified.");
            return;
        }

        IsSaving = true;
        try
        {
            var client = CreateClient();
            int successCount = 0;
            var options = new JsonSerializerOptions
            {
                PropertyNamingPolicy = null
            };

            foreach (var row in AdjustStockRows)
            {
                var adjQty = Math.Abs(row.difference);
                var adjType = row.difference >= 0 ? "Increase" : "Decrease";
                var adjReason = !string.IsNullOrWhiteSpace(row.adjustmentreason) 
                    ? row.adjustmentreason 
                    : (row.difference >= 0 ? "Physical Count" : "Damage");

                var payload = new stock_adjustment_upsert_payload
                {
                    stock = new stock_adjustment_stock_ref
                    {
                        stockcode = row.stockcode
                    },
                    adjustmentlog = new stock_adjustment_log
                    {
                        adjustmentlogcode = row.adjustmentlogcode,
                        itemcode = row.itemcode,
                        warehousecode = row.warehousecode ?? SelectedStoreCode,
                        batchno = row.batchno,
                        beforeqty = row.oldstock,
                        adjustedqty = adjQty,
                        afterqty = row.newstock,
                        adjustmenttype = adjType,
                        adjustmentreason = adjReason,
                        adjustedby = loggedInUserCode > 0 ? loggedInUserCode : 7,
                        stockcode = row.stockcode,
                        unitcost = row.unitcost,
                        stockvalue = row.newstock * row.unitcost,
                        adjustmentdate = AdjustmentDate,
                        tenantcode = DefaultTenant,
                        isactive = true,
                        deleted = false
                    }
                };

                var response = await client.PostAsJsonAsync("api/ItemMaster/upsertstockadjustment", payload, options);
                if (response.IsSuccessStatusCode)
                {
                    successCount++;
                }
            }

            if (successCount > 0)
            {
                ToastService.ShowSuccess($"{successCount} stock adjustment(s) saved successfully!");
                ResetForm();
                await Task.WhenAll(LoadStocks(), LoadAdjustmentLogs());
            }
            else
            {
                ToastService.ShowError("Failed to save stock adjustment.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
        }
    }

    private List<stock_adjustment_log> AdjustmentLogsList = new();
    private bool showAdjustmentLogModal = false;
    private bool loadingAdjustmentLogs = false;
    private string logSearchQuery = "";
    private string logTypeFilter = "ALL";

    private async Task OpenAdjustmentLogModal()
    {
        showAdjustmentLogModal = true;
        await LoadAdjustmentLogs();
    }

    private void CloseAdjustmentLogModal()
    {
        showAdjustmentLogModal = false;
    }

    private async Task LoadAdjustmentLogs()
    {
        loadingAdjustmentLogs = true;
        try
        {
            var client = CreateClient();
            var urls = new[]
            {
                $"api/ItemMaster/getallstockadjustment?tenantcode={DefaultTenant}",
                "api/ItemMaster/getallstockadjustment",
                "ItemMaster/getallstockadjustment"
            };

            string? response = null;
            foreach (var url in urls)
            {
                try
                {
                    response = await client.GetStringAsync(url);
                    if (!string.IsNullOrWhiteSpace(response)) break;
                }
                catch { }
            }

            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true, NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString };
                List<stock_adjustment_log>? loaded = null;
                try
                {
                    loaded = JsonSerializer.Deserialize<List<stock_adjustment_log>>(response, options);
                }
                catch { }

                if (loaded == null || !loaded.Any())
                {
                    try
                    {
                        var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<stock_adjustment_log>>>(response, options);
                        loaded = wrapped?.data;
                    }
                    catch { }
                }

                if (loaded == null || !loaded.Any())
                {
                    try
                    {
                        using var doc = JsonDocument.Parse(response);
                        var root = doc.RootElement;
                        if (root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var dataArr)) root = dataArr;
                        if (root.ValueKind == JsonValueKind.Array)
                        {
                            var list = new List<stock_adjustment_log>();
                            foreach (var el in root.EnumerateArray())
                            {
                                var log = new stock_adjustment_log();
                                if (el.TryGetProperty("adjustmentlogcode", out var alc) || el.TryGetProperty("adjustment_log_code", out alc) || el.TryGetProperty("logcode", out alc)) log.adjustmentlogcode = alc.GetInt64();
                                if (el.TryGetProperty("stockcode", out var sc) || el.TryGetProperty("stock_code", out sc)) log.stockcode = sc.GetInt64();
                                if (el.TryGetProperty("itemcode", out var ic) || el.TryGetProperty("item_code", out ic)) log.itemcode = ic.GetInt64();
                                if (el.TryGetProperty("warehousecode", out var wc) || el.TryGetProperty("warehouse_code", out wc) || el.TryGetProperty("storecode", out wc)) log.warehousecode = wc.GetInt64();
                                if (el.TryGetProperty("batchno", out var bn) || el.TryGetProperty("batch_no", out bn)) log.batchno = bn.GetString();
                                if (el.TryGetProperty("beforeqty", out var bq) || el.TryGetProperty("before_qty", out bq)) log.beforeqty = bq.GetDecimal();
                                if (el.TryGetProperty("adjustedqty", out var aq) || el.TryGetProperty("adjusted_qty", out aq)) log.adjustedqty = aq.GetDecimal();
                                if (el.TryGetProperty("afterqty", out var afq) || el.TryGetProperty("after_qty", out afq)) log.afterqty = afq.GetDecimal();
                                if (el.TryGetProperty("adjustmenttype", out var at) || el.TryGetProperty("adjustment_type", out at)) log.adjustmenttype = at.GetString() ?? "";
                                if (el.TryGetProperty("adjustmentreason", out var ar) || el.TryGetProperty("adjustment_reason", out ar) || el.TryGetProperty("reason", out ar)) log.adjustmentreason = ar.GetString() ?? "";
                                if (el.TryGetProperty("adjustedby", out var ab) || el.TryGetProperty("adjusted_by", out ab)) log.adjustedby = ab.GetInt64();
                                if (el.TryGetProperty("remarks", out var rem)) log.remarks = rem.GetString();
                                if (el.TryGetProperty("adjustmentdate", out var ad) || el.TryGetProperty("adjustment_date", out ad)) { if (DateTime.TryParse(ad.GetString(), out var dt)) log.adjustmentdate = dt; }
                                if (el.TryGetProperty("createddate", out var cd) || el.TryGetProperty("created_date", out cd)) { if (DateTime.TryParse(cd.GetString(), out var cdt)) log.createddate = cdt; }
                                list.Add(log);
                            }
                            loaded = list;
                        }
                    }
                    catch { }
                }

                if (loaded != null)
                {
                    AdjustmentLogsList = loaded.Where(x => !x.deleted).OrderByDescending(x => x.adjustmentlogcode > 0 ? x.adjustmentlogcode : 0).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadAdjustmentLogs] Error: {ex.Message}");
        }
        finally
        {
            loadingAdjustmentLogs = false;
            StateHasChanged();
        }
    }

    private List<stock_adjustment_log> GetFilteredLogs()
    {
        var list = AdjustmentLogsList.AsEnumerable();

        if (logTypeFilter != "ALL")
        {
            list = list.Where(l => l.adjustmenttype.Equals(logTypeFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(logSearchQuery))
        {
            var q = logSearchQuery.Trim().ToLower();
            list = list.Where(l =>
                l.adjustmentlogcode.ToString().Contains(q) ||
                (l.batchno != null && l.batchno.ToLower().Contains(q)) ||
                (l.adjustmentreason != null && l.adjustmentreason.ToLower().Contains(q)) ||
                (l.remarks != null && l.remarks.ToLower().Contains(q)) ||
                (ItemList.FirstOrDefault(i => i.itemcode == l.itemcode)?.itemname?.ToLower().Contains(q) ?? false) ||
                (WarehouseList.FirstOrDefault(w => w.warehousecode == l.warehousecode)?.warehousename?.ToLower().Contains(q) ?? false)
            );
        }

        return list.ToList();
    }

    private void EditAdjustmentLog(stock_adjustment_log log)
    {
        var existing = AdjustStockRows.FirstOrDefault(r => r.stockcode == log.stockcode && r.stockcode > 0);
        if (existing != null)
        {
            existing.adjustmentlogcode = log.adjustmentlogcode;
            existing.adjustmentreason = log.adjustmentreason;
            existing.newstock = (long)Math.Round(log.afterqty);
            RecalculateAdjustRowDirect(existing);
        }
        else
        {
            var newAdj = new AdjustStockRowModel
            {
                adjustmentlogcode = log.adjustmentlogcode,
                stockcode = log.stockcode,
                itemcode = log.itemcode,
                warehousecode = log.warehousecode,
                batchno = log.batchno ?? "",
                packsize = "10",
                oldstock = (long)Math.Round(log.beforeqty),
                newstock = (long)Math.Round(log.afterqty),
                difference = (long)Math.Round(log.adjustmenttype.Equals("Decrease", StringComparison.OrdinalIgnoreCase) ? -log.adjustedqty : log.adjustedqty),
                unitcost = log.unitcost,
                adjustmentreason = string.IsNullOrWhiteSpace(log.adjustmentreason) ? "Physical Count" : log.adjustmentreason,
                remarks = log.remarks
            };
            AdjustStockRows.Add(newAdj);
        }
        showAdjustmentLogModal = false;
        ToastService.ShowInfo($"Loaded Adjustment Log #{log.adjustmentlogcode} for batch '{log.batchno}'.");
    }

    private void ResetForm()
    {
        SelectedItemCode = 0;
        itemSearchText = "";
        SelectedStoreCode = 0;
        AvailableStockRows.Clear();
        AdjustStockRows.Clear();
        SelectedStockRow = null;
        FilterAvailableStock();
        StateHasChanged();
    }

