@page "/stockadjustment"
@page "/stock-adjustment"
@using Booking.Models
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<PageTitle>Stock Adjustment</PageTitle>

<link rel="stylesheet" href="Components/Pages/StockAdjustment.razor.css" />

<style>
    /* Scoped High-Contrast Style Overrides */
    .btn-indigo-solid {
        background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%) !important;
        background-color: #4f46e5 !important;
        color: #ffffff !important;
        border: 1px solid #3730a3 !important;
        font-weight: 700 !important;
        font-size: 0.82rem !important;
        padding: 0.5rem 1.4rem !important;
        border-radius: 50px !important;
        box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35) !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        letter-spacing: 0.3px !important;
    }

    .btn-indigo-solid i, .btn-indigo-solid span {
        color: #ffffff !important;
    }

    .btn-indigo-solid:hover {
        background: linear-gradient(135deg, #4338ca 0%, #312e81 100%) !important;
        box-shadow: 0 6px 20px rgba(79, 70, 229, 0.5) !important;
        transform: translateY(-2px) scale(1.02);
    }

    .btn-rose-solid {
        background: #ffffff !important;
        color: #e11d48 !important;
        border: 1.5px solid #fecdd3 !important;
        font-weight: 700 !important;
        font-size: 0.82rem !important;
        padding: 0.5rem 1.2rem !important;
        border-radius: 50px !important;
        box-shadow: 0 2px 8px rgba(225, 29, 72, 0.1) !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        letter-spacing: 0.3px !important;
    }

    .btn-rose-solid i, .btn-rose-solid span {
        color: #e11d48 !important;
    }

    .btn-rose-solid:hover {
        background: #fff1f2 !important;
        color: #be123c !important;
        border-color: #fda4af !important;
        box-shadow: 0 4px 14px rgba(225, 29, 72, 0.2) !important;
        transform: translateY(-2px);
    }

    .btn-add-action {
        background-color: #4f46e5 !important;
        color: #ffffff !important;
        border: 1px solid #3730a3 !important;
        font-weight: 700 !important;
        font-size: 0.75rem !important;
        padding: 4px 12px !important;
        border-radius: 50px !important;
        box-shadow: 0 3px 8px rgba(79, 70, 229, 0.3) !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 4px !important;
        cursor: pointer !important;
    }

    .btn-add-action i, .btn-add-action span {
        color: #ffffff !important;
    }

    .btn-add-action:hover {
        background-color: #3730a3 !important;
        color: #ffffff !important;
        transform: translateY(-1px);
    }

    .btn-remove-action {
        background-color: #fee2e2 !important;
        color: #dc2626 !important;
        border: 1px solid #fca5a5 !important;
        font-weight: 700 !important;
        font-size: 0.75rem !important;
        padding: 4px 10px !important;
        border-radius: 50px !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 4px !important;
        cursor: pointer !important;
    }

    .btn-remove-action i, .btn-remove-action span {
        color: #dc2626 !important;
    }

    .btn-remove-action:hover {
        background-color: #ef4444 !important;
        color: #ffffff !important;
        border-color: #dc2626 !important;
    }

    .btn-remove-action:hover i, .btn-remove-action:hover span {
        color: #ffffff !important;
    }

    .filter-bar-inline {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 1.25rem !important;
        flex-wrap: nowrap !important;
        width: 100% !important;
    }

    .filter-bar-item {
        display: flex !important;
        align-items: center !important;
        gap: 0.5rem !important;
        white-space: nowrap !important;
    }

    .filter-bar-item.item-date {
        flex: 0 0 220px !important;
    }

    .filter-bar-item.item-warehouse {
        flex: 1 1 320px !important;
    }

    .filter-bar-item.item-name {
        flex: 1 1 380px !important;
    }

    .header-card-icon {
        background-color: #eef2ff !important;
        border: 1px solid #c7d2fe !important;
        color: #4f46e5 !important;
    }

    .header-card-icon i {
        color: #4f46e5 !important;
    }
    .custom-typeahead-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1000;
        max-height: 250px;
        overflow-y: auto;
        background: white;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        margin-top: 2px;
    }
    .custom-typeahead-item {
        padding: 8px 12px;
        cursor: pointer;
        font-size: 0.8rem;
        text-align: left;
        color: #1e293b;
        transition: background-color 0.2s;
        white-space: normal;
    }
    .custom-typeahead-item:hover {
        background-color: #f1f5f9;
        color: #02659e;
    }
</style>

<div class="stock-adj-page">
    <div class="stock-adj-shell">
        <!-- Premium Header Bar -->
        <div class="premium-header-card mb-3">
            <div class="header-card-left">
                <div class="header-card-icon">
                    <i class="bi bi-sliders2 fs-4"></i>
                </div>
                <div class="header-card-text">
                    <h2 class="header-card-heading">Stock Adjustment & Reconciliation</h2>
                    <div class="header-card-subheading">
                        <span class="status-dot"></span> Real-time physical inventory audit & batch management
                    </div>
                </div>
            </div>

            <div class="header-card-right d-flex align-items-center gap-2">
                <button type="button" class="btn-header-log" @onclick="OpenAdjustmentLogModal" title="View Stock Adjustment History Logs">
                    <i class="bi bi-clock-history"></i>
                    <span>Adjustment Log</span>
                    @if (AdjustmentLogsList.Any())
                    {
                        <span class="badge-log-count">@AdjustmentLogsList.Count</span>
                    }
                </button>
                <button class="btn btn-indigo-solid rounded-pill px-4 py-2 shadow d-flex align-items-center gap-2" @onclick="SubmitStockAdjustment">
                    <i class="bi bi-check2-circle fs-6"></i> <span>Save Adjustment</span>
                </button>
                <button class="btn btn-rose-solid rounded-pill px-3 py-2 shadow d-flex align-items-center gap-1" @onclick="ResetForm">
                    <i class="bi bi-arrow-counterclockwise fs-6"></i> <span>Reset</span>
                </button>
            </div>
        </div>

        <!-- Filter Controls Bar (Strict 1-Line Layout) -->
        <div class="filter-card p-2 px-3 mb-3">
            <div class="filter-bar-inline">
                <div class="filter-bar-item item-date">
                    <label class="filter-label m-0 text-nowrap"><i class="bi bi-calendar-event me-1 text-primary"></i>Date:</label>
                    <input type="date" class="form-control form-control-sm premium-input" @bind="AdjustmentDate" />
                </div>

                <div class="filter-bar-item item-warehouse">
                    <label class="filter-label m-0 text-nowrap"><i class="bi bi-building me-1 text-success"></i>Warehouse:</label>
                    <select class="form-select form-select-sm premium-input" ValueExpression="() => SelectedStoreCode" Value="SelectedStoreCode" ValueChanged="@((long storeCode) => OnStoreSelect(storeCode))">
                        <option value="0">-- All Stores / Select Store --</option>
                        @foreach (var store in WarehouseList)
                        {
                            <option value="@store.warehousecode">@store.warehousename</option>
                        }
                    </select>
                </div>

                <div class="filter-bar-item item-name position-relative">
                    <label class="filter-label m-0 text-nowrap"><i class="bi bi-capsule me-1 text-warning"></i>Item Name:</label>
                    <div class="position-relative w-100">
                        <input type="text" class="form-control form-control-sm premium-input"
                               placeholder="Type to search item..."
                               value="@itemSearchText"
                               @oninput="OnItemSearchInput"
                               @onfocus="() => showItemDropdown = true"
                               @onblur="OnItemSearchBlur" />
                        @if (showItemDropdown)
                        {
                            var filtered = ItemList
                                .Where(i => string.IsNullOrEmpty(itemSearchText) || (i.itemname != null && i.itemname.Contains(itemSearchText, StringComparison.OrdinalIgnoreCase)))
                                .ToList();
                            if (filtered.Any())
                            {
                                <div class="custom-typeahead-dropdown">
                                    @foreach (var item in filtered)
                                    {
                                        <div class="custom-typeahead-item" 
                                             @onmousedown="() => SelectItem(item)">
                                            @item.itemname
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Parallel Split View: Available Stock vs Adjust Stock -->
        <div class="parallel-tables-row">
            <!-- Left Table: Available Stock -->
            <div class="parallel-col">
                <div class="table-card available-card shadow-sm">
                    <div class="table-card-header d-flex justify-content-between align-items-center p-2 px-3">
                        <div class="d-flex align-items-center gap-2">
                            <div>
                                <h6 class="m-0 fw-bold" style="font-size: 0.9rem;">Available Batches</h6>
                            </div>
                        </div>
                        <span class="badge bg-indigo-subtle text-indigo border px-3 py-1 rounded-pill fw-bold" style="font-size: 0.75rem;">
                            <i class="bi bi-layers me-1"></i>@AvailableStockRows.Count Batches
                        </span>
                    </div>
                    <div class="table-card-body p-0">
                        <table class="table table-hover table-sm align-middle mb-0 custom-table">
                            <thead>
                                <tr>
                                    <th>ITEM NAME</th>
                                    <th>BATCH NO</th>
                                    <th>EXPIRY</th>
                                    <th class="text-center">PACK SIZE</th>
                                    <th class="text-end">STOCK</th>
                                    <th class="text-center">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (AvailableStockRows.Any())
                                {
                                    @foreach (var row in AvailableStockRows)
                                    {
                                        var isSelected = SelectedStockRow?.stockcode == row.stockcode;
                                        <tr class="@(isSelected ? "table-active-row" : "")" @onclick="() => SelectStockRow(row)" style="cursor: pointer;">
                                            <td class="fw-bold">
                                                @(ItemList.FirstOrDefault(i => i.itemcode == row.itemcode)?.itemname ?? $"Item {row.itemcode}")
                                            </td>
                                            <td>
                                                <span class="batch-badge-blue">@row.batchno</span>
                                            </td>
                                            <td class="text-secondary fw-semibold">@(row.expirydate?.ToString("MMM yyyy") ?? "N/A")</td>
                                            <td class="text-center"><span class="badge bg-light text-dark border">@row.packsize</span></td>
                                            <td class="text-end fw-bold text-success fs-6">@row.closingstock.ToString("N0")</td>
                                            <td class="text-center">
                                                <button class="btn-add-action" title="Select for Adjustment">
                                                    <i class="bi bi-plus-circle-fill"></i> <span>Add</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-5">
                                            <i class="bi bi-funnel fs-2 text-indigo opacity-50 d-block mb-2"></i>
                                            Select a Warehouse and Item to view matching stock batches.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="table-card-footer p-2 border-top d-flex justify-content-between align-items-center px-3">
                        <span class="fw-bold small text-secondary"><i class="bi bi-calculator me-1 text-primary"></i>Available Summary</span>
                        <div class="small">
                            <span class="text-success fw-bold fs-6">Stock: @AvailableStockRows.Sum(r => r.closingstock).ToString("N0")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Table: Adjust Stock -->
            <div class="parallel-col">
                <div class="table-card adjust-card shadow-sm">
                    <div class="table-card-header d-flex justify-content-between align-items-center p-2 px-3">
                        <div class="d-flex align-items-center gap-2">
                            <div>
                                <h6 class="m-0 fw-bold" style="font-size: 0.9rem;">Stock Adjustments</h6>
                            </div>
                        </div>
                        <span class="badge bg-teal-subtle text-teal border px-3 py-1 rounded-pill fw-bold" style="font-size: 0.75rem;">
                            <i class="bi bi-check-all me-1"></i>@AdjustStockRows.Count Selected
                        </span>
                    </div>
                    <div class="table-card-body p-0">
                        <table class="table table-hover table-sm align-middle mb-0 custom-table">
                            <thead>
                                <tr>
                                    <th>ITEM NAME</th>
                                    <th>BATCH NO</th>
                                    <th class="text-center">PACK SIZE</th>
                                    <th class="text-center">NEW QTY</th>
                                    <th class="text-end">DIFF</th>
                                    <th class="text-center" style="min-width: 120px;">REASON</th>
                                    <th class="text-center">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (AdjustStockRows.Any())
                                {
                                    @foreach (var adjRow in AdjustStockRows)
                                    {
                                        <tr>
                                            <td class="fw-bold">
                                                @(ItemList.FirstOrDefault(i => i.itemcode == adjRow.itemcode)?.itemname ?? $"Item {adjRow.itemcode}")
                                            </td>
                                            <td>
                                                <span class="batch-badge-dark">@adjRow.batchno</span>
                                            </td>
                                            <td class="text-center">
                                                <input type="text" class="form-control form-control-sm grid-input text-center mx-auto" style="width: 50px;" @bind="adjRow.packsize" @bind:event="oninput" @onchange="() => RecalculateAdjustRow(adjRow)" />
                                            </td>
                                            <td class="text-center">
                                                <div class="qty-stepper-wrapper">
                                                    <button type="button" class="btn btn-stepper btn-minus" @onclick="() => DecrementStock(adjRow, 1)" title="-1">
                                                        <i class="bi bi-dash"></i>
                                                    </button>
                                                    <input type="number" step="1" min="0" class="form-control form-control-sm grid-input text-center stepper-input" @bind="adjRow.newstock" @bind:event="oninput" @onchange="() => RecalculateAdjustRowDirect(adjRow)" />
                                                    <button type="button" class="btn btn-stepper btn-plus" @onclick="() => IncrementStock(adjRow, 1)" title="+1">
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="fw-bold text-end">
                                                <span class="badge @(adjRow.difference > 0 ? "bg-success-subtle text-success" : adjRow.difference < 0 ? "bg-danger-subtle text-danger" : "bg-light text-secondary") border px-2 py-1 fs-6">
                                                    @(adjRow.difference >= 0 ? "+" : "")@adjRow.difference.ToString("N0")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <select class="form-select form-select-sm grid-input" @bind="adjRow.adjustmentreason" style="font-size: 0.75rem; padding: 2px 6px;">
                                                    <option value="Physical Count">Physical Count</option>
                                                    <option value="Damage">Damage</option>
                                                    <option value="Expiry">Expiry</option>
                                                    <option value="Theft">Theft</option>
                                                    <option value="Correction">Correction</option>
                                                    <option value="Other">Other</option>
                                                </select>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn-remove-action" @onclick="() => RemoveAdjustRow(adjRow)" title="Remove batch">
                                                    <i class="bi bi-trash-fill"></i> <span>Remove</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-5">
                                            <i class="bi bi-sliders fs-2 text-teal opacity-50 d-block mb-2"></i>
                                            Click any batch from Available Stock to adjust.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="table-card-footer p-2 border-top d-flex justify-content-between align-items-center px-3">
                        <div class="small w-100 d-flex justify-content-between align-items-center">
                            <span class="text-muted">Total New Stock: <strong class="text-indigo fs-6 ms-1">@AdjustStockRows.Sum(r => r.newstock).ToString("N0")</strong></span>
                            <span class="fw-bold fs-6 @(AdjustStockRows.Sum(r => r.difference) >= 0 ? "text-success" : "text-danger")">
                                Total Diff: @(AdjustStockRows.Sum(r => r.difference) >= 0 ? "+" : "")@AdjustStockRows.Sum(r => r.difference).ToString("N0")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stock Adjustment Log Modal -->
@if (showAdjustmentLogModal)
{
    <div class="log-modal-backdrop" @onclick="CloseAdjustmentLogModal"></div>
    <div class="log-modal-dialog">
        <!-- Modal Header -->
        <div class="log-modal-header">
            <div class="d-flex align-items-center gap-2">
                <div class="header-card-icon" style="width: 36px; height: 36px;">
                    <i class="bi bi-journal-text text-indigo fs-5"></i>
                </div>
                <div>
                    <h5 class="m-0 fw-bold text-indigo" style="font-size: 1.05rem;">Stock Adjustment Logs</h5>
                    <span class="text-secondary small fw-semibold">Audit trail of all physical stock adjustments</span>
                </div>
                <span class="badge bg-indigo-subtle text-indigo border px-2 py-1 rounded-pill ms-2 fw-bold" style="font-size: 0.75rem;">
                    @GetFilteredLogs().Count Records
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill d-flex align-items-center gap-1" @onclick="LoadAdjustmentLogs" disabled="@loadingAdjustmentLogs">
                    @if (loadingAdjustmentLogs)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-clockwise"></i>
                    }
                    <span>Refresh</span>
                </button>
                <button type="button" class="btn-close" @onclick="CloseAdjustmentLogModal" aria-label="Close"></button>
            </div>
        </div>

        <!-- Filter Bar inside Modal -->
        <div class="p-2 px-3 border-bottom bg-light d-flex align-items-center gap-2 flex-wrap justify-content-between">
            <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 450px;">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control" placeholder="Search by Item, Batch, Reason, Log #..." @bind="logSearchQuery" @bind:event="oninput" />
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="small fw-bold text-secondary mb-0 text-nowrap">Type:</label>
                <select class="form-select form-select-sm" style="width: 130px;" @bind="logTypeFilter">
                    <option value="ALL">All Types</option>
                    <option value="Increase">Increase (+)</option>
                    <option value="Decrease">Decrease (-)</option>
                </select>
            </div>
        </div>

        <!-- Modal Body Table -->
        <div class="log-modal-body p-0">
            @if (loadingAdjustmentLogs)
            {
                <div class="text-center py-5 text-muted">
                    <span class="spinner-border text-indigo mb-2" role="status"></span>
                    <div>Loading adjustment logs...</div>
                </div>
            }
            else if (!GetFilteredLogs().Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 text-secondary opacity-50 d-block mb-2"></i>
                    <div>No stock adjustment logs found.</div>
                </div>
            }
            else
            {
                <table class="table table-hover table-sm align-middle mb-0 custom-table">
                    <thead>
                        <tr>
                            <th class="text-center">LOG #</th>
                            <th>DATE</th>
                            <th>ITEM NAME</th>
                            <th>WAREHOUSE</th>
                            <th>BATCH NO</th>
                            <th class="text-end">BEFORE</th>
                            <th class="text-center">ADJUSTED</th>
                            <th class="text-end">AFTER</th>
                            <th class="text-center">TYPE</th>
                            <th>REASON</th>
                            <th class="text-center">ADJUSTED BY</th>
                            <th class="text-center">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in GetFilteredLogs())
                        {
                            var itemName = ItemList.FirstOrDefault(i => i.itemcode == log.itemcode)?.itemname ?? $"Item #{log.itemcode}";
                            var whName = WarehouseList.FirstOrDefault(w => w.warehousecode == log.warehousecode)?.warehousename ?? (log.warehousecode > 0 ? $"Store #{log.warehousecode}" : "All Stores");
                            var isIncrease = log.adjustmenttype.Equals("Increase", StringComparison.OrdinalIgnoreCase) || (log.adjustedqty > 0 && log.afterqty > log.beforeqty);
                            <tr>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border fw-bold">#@log.adjustmentlogcode</span>
                                </td>
                                <td class="text-nowrap small fw-semibold text-secondary">
                                    @(log.adjustmentdate != default ? log.adjustmentdate.ToString("dd-MMM-yyyy") : log.createddate != default ? log.createddate.ToString("dd-MMM-yyyy") : "-")
                                </td>
                                <td class="fw-bold">@itemName</td>
                                <td class="small text-muted">@whName</td>
                                <td>
                                    <span class="batch-badge-dark">@(string.IsNullOrWhiteSpace(log.batchno) ? "-" : log.batchno)</span>
                                </td>
                                <td class="text-end fw-semibold">@log.beforeqty.ToString("N0")</td>
                                <td class="text-center">
                                    <span class="badge @(isIncrease ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger") fw-bold px-2 py-1">
                                        @(isIncrease ? "+" : "-")@Math.Abs(log.adjustedqty).ToString("N0")
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-indigo">@log.afterqty.ToString("N0")</td>
                                <td class="text-center">
                                    <span class="badge @(isIncrease ? "bg-success" : "bg-danger") text-white rounded-pill px-2" style="font-size: 0.68rem;">
                                        @log.adjustmenttype
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border">@(string.IsNullOrWhiteSpace(log.adjustmentreason) ? "Physical Count" : log.adjustmentreason)</span>
                                </td>
                                <td class="text-center small text-muted">
                                    User #@(log.adjustedby ?? 1)
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" @onclick="() => EditAdjustmentLog(log)" title="Load this adjustment record for modification" style="font-size: 0.72rem;">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Modal Footer -->
        <div class="log-modal-footer">
            <div class="small text-muted">
                Showing <strong>@GetFilteredLogs().Count</strong> of <strong>@AdjustmentLogsList.Count</strong> adjustment logs
            </div>
            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" @onclick="CloseAdjustmentLogModal">Close</button>
        </div>
    </div>
}

@code {
    private DateTime AdjustmentDate = DateTime.Today;
    private long SelectedStoreCode = 0;
    private long SelectedItemCode = 0;
    private string itemSearchText = "";
    private bool showItemDropdown = false;

    private List<inventory_item_master> ItemList = new();
    private List<warehouse_master> WarehouseList = new();
    private List<stock_master> AllStockList = new();

    private List<AvailableStockRowModel> AvailableStockRows = new();
    private List<AdjustStockRowModel> AdjustStockRows = new();
    private AvailableStockRowModel? SelectedStockRow;

    private void OnItemSearchInput(ChangeEventArgs e)
    {
        itemSearchText = e.Value?.ToString() ?? "";
        showItemDropdown = true;
        if (string.IsNullOrWhiteSpace(itemSearchText))
        {
            SelectedItemCode = 0;
        }
        else
        {
            var matched = ItemList.FirstOrDefault(i => string.Equals(i.itemname, itemSearchText, StringComparison.OrdinalIgnoreCase));
            if (matched != null)
            {
                SelectedItemCode = matched.itemcode;
            }
            else
            {
                SelectedItemCode = 0;
            }
        }
        FilterAvailableStock();
    }

    private void SelectItem(inventory_item_master item)
    {
        SelectedItemCode = item.itemcode;
        itemSearchText = item.itemname ?? "";
        showItemDropdown = false;
        FilterAvailableStock();
    }

    private async Task OnItemSearchBlur()
    {
        await Task.Delay(200);
        showItemDropdown = false;
        if (SelectedItemCode > 0)
        {
            var item = ItemList.FirstOrDefault(i => i.itemcode == SelectedItemCode);
            if (item != null)
            {
                itemSearchText = item.itemname ?? "";
            }
        }
        else
        {
            itemSearchText = "";
        }
        StateHasChanged();
    }

    // Create New Batch Fields
    private string NewBatchNo = "";
    private DateTime NewExpiryDate = DateTime.Today.AddYears(1);
    private string NewPackSize = "10";
    private decimal NewMRP = 0m;
    private decimal NewPurchaseRate = 0m;

    private string DefaultTenant = "TNT001";
    private long loggedInUserCode = 7;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserRights();
        await Task.WhenAll(LoadItems(), LoadWarehouses(), LoadStocks(), LoadAdjustmentLogs());
    }

    private async Task LoadUserRights()
    {
        try
        {
            var res = await _sessionStorage.GetAsync<string>("tenant_code");
            if (res.Success && !string.IsNullOrWhiteSpace(res.Value))
            {
                DefaultTenant = res.Value;
            }

            var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (userResult.Success && userResult.Value != null && userResult.Value.UserCode.HasValue && userResult.Value.UserCode.Value > 0)
            {
                loggedInUserCode = userResult.Value.UserCode.Value;
            }
            else
            {
                var intRes = await _sessionStorage.GetAsync<int>("usercode");
                if (intRes.Success && intRes.Value > 0)
                {
                    loggedInUserCode = intRes.Value;
                }
            }
        }
        catch { }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        return client;
    }

    private async Task LoadItems()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallitems");
            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                try
                {
                    var direct = JsonSerializer.Deserialize<List<inventory_item_master>>(response, options);
                    ItemList = direct ?? new();
                }
                catch
                {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<inventory_item_master>>>(response, options);
                    ItemList = wrapped?.data ?? new();
                }
            }
        }
        catch { }
    }

    private async Task LoadWarehouses()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallwarehouse");
            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                try
                {
                    var direct = JsonSerializer.Deserialize<List<warehouse_master>>(response, options);
                    WarehouseList = direct?.Where(w => !w.isdeleted).ToList() ?? new();
                }
                catch
                {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<warehouse_master>>>(response, options);
                    WarehouseList = wrapped?.data?.Where(w => !w.isdeleted).ToList() ?? new();
                }
            }
        }
        catch { }
    }

    private async Task LoadStocks()
    {
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallstocks");
            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true, NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString };
                try
                {
                    var direct = JsonSerializer.Deserialize<List<stock_master>>(response, options);
                    if (direct != null && direct.Any()) AllStockList = direct.Where(x => !x.deleted).ToList();
                }
                catch { }

                if (!AllStockList.Any())
                {
                    try
                    {
                        var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<stock_master>>>(response, options);
                        if (wrapped?.data != null) AllStockList = wrapped.data.Where(x => !x.deleted).ToList();
                    }
                    catch { }
                }

                if (!AllStockList.Any())
                {
                    try
                    {
                        using var doc = JsonDocument.Parse(response);
                        var root = doc.RootElement;
                        if (root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var dataArr)) root = dataArr;
                        if (root.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var el in root.EnumerateArray())
                            {
                                var s = new stock_master();
                                if (el.TryGetProperty("stockcode", out var sc) || el.TryGetProperty("stock_code", out sc)) s.stockcode = sc.GetInt64();
                                if (el.TryGetProperty("itemcode", out var ic) || el.TryGetProperty("item_code", out ic)) s.itemcode = ic.GetInt64();
                                if (el.TryGetProperty("warehousecode", out var wc) || el.TryGetProperty("warehouse_code", out wc) || el.TryGetProperty("storecode", out wc)) s.warehousecode = wc.GetInt64();
                                if (el.TryGetProperty("batchno", out var bn) || el.TryGetProperty("batch_no", out bn)) s.batchno = bn.GetString();
                                if (el.TryGetProperty("closingstock", out var cs) || el.TryGetProperty("closing_stock", out cs) || el.TryGetProperty("qty", out cs)) s.closingstock = cs.GetDecimal();
                                if (el.TryGetProperty("unitcost", out var uc) || el.TryGetProperty("unit_cost", out uc) || el.TryGetProperty("rate", out uc)) s.unitcost = uc.GetDecimal();
                                if (el.TryGetProperty("expirydate", out var ed) || el.TryGetProperty("expiry_date", out ed)) { if (DateTime.TryParse(ed.GetString(), out var dt)) s.expirydate = dt; }
                                AllStockList.Add(s);
                            }
                        }
                    }
                    catch { }
                }
            }
        }
        catch { }
        FilterAvailableStock();
    }

    private void FilterAvailableStock()
    {
        AvailableStockRows.Clear();

        if (!AllStockList.Any()) return;

        var selectedItemObj = ItemList.FirstOrDefault(i => i.itemcode == SelectedItemCode);
        var selectedWarehouseObj = WarehouseList.FirstOrDefault(w => w.warehousecode == SelectedStoreCode);

        // Find matching item codes based on SelectedItemCode or itemSearchText
        var matchingItemCodes = new HashSet<long>();
        if (SelectedItemCode > 0)
        {
            matchingItemCodes.Add(SelectedItemCode);
        }
        else if (!string.IsNullOrWhiteSpace(itemSearchText))
        {
            var matchedItems = ItemList.Where(i => i.itemname != null && i.itemname.Contains(itemSearchText, StringComparison.OrdinalIgnoreCase));
            foreach (var item in matchedItems)
            {
                matchingItemCodes.Add(item.itemcode);
            }
        }

        var matches = AllStockList.Where(s => {
            bool matchItem = true;
            if (SelectedItemCode > 0 || !string.IsNullOrWhiteSpace(itemSearchText))
            {
                matchItem = matchingItemCodes.Contains(s.itemcode);
                if (!matchItem && selectedItemObj != null && !string.IsNullOrWhiteSpace(selectedItemObj.itemname))
                {
                    // Loose match on item name if itemcode is 0 in stock table
                    matchItem = true;
                }
            }

            bool matchStore = SelectedStoreCode <= 0 || s.warehousecode == SelectedStoreCode || s.warehousecode == 0 || s.warehousecode == null;
            return matchItem && matchStore;
        }).ToList();

        // If specific item or store was selected and strict match yielded empty, show matches by item alone
        if (!matches.Any() && (SelectedItemCode > 0 || !string.IsNullOrWhiteSpace(itemSearchText)))
        {
            matches = AllStockList.Where(s => matchingItemCodes.Contains(s.itemcode) || s.itemcode == 0).ToList();
        }

        // If still no filter match but stocks exist, display all stocks as fallback
        if (!matches.Any() && SelectedStoreCode <= 0 && SelectedItemCode <= 0 && string.IsNullOrWhiteSpace(itemSearchText))
        {
            matches = AllStockList;
        }

        foreach (var s in matches)
        {
            var wholeClosing = (long)Math.Round(s.closingstock);
            AvailableStockRows.Add(new AvailableStockRowModel
            {
                stockcode = s.stockcode,
                itemcode = s.itemcode > 0 ? s.itemcode : (SelectedItemCode > 0 ? SelectedItemCode : s.itemcode),
                warehousecode = s.warehousecode ?? SelectedStoreCode,
                batchno = string.IsNullOrWhiteSpace(s.batchno) ? "B001" : s.batchno,
                expirydate = s.expirydate ?? DateTime.Today.AddYears(1),
                packsize = "10",
                inpack = wholeClosing / 10,
                inloose = wholeClosing % 10,
                closingstock = wholeClosing,
                unitcost = s.unitcost
            });
        }
    }

    private void OnStoreSelect(long storeCode)
