@page "/stockadjustment"
@page "/stock-adjustment"
@using Booking.Models
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<PageTitle>Stock Adjustment</PageTitle>

<link rel="stylesheet" href="Components/Pages/StockAdjustment.razor.css" />

<style>
