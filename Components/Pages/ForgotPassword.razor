@page "/forgot-password"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Http.Json
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@inject IHttpClientFactory HttpClientFactory
@inject LabCare.Services.UserService UserService
@inject NavigationManager NavigationManager
@inject Booking.Services.ToastService Toast
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<div class="login-page-container">
    <div class="login-card">
        <div class="login-header">
            <h2 class="brand-title">Medico <span class="brand-highlight">Portal</span></h2>
            @if (!otpSent)
            {
                <h3 class="page-title">Forgot your password?</h3>
            }
            else
            {
                <h3 class="page-title">Reset Password</h3>
            }
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success" role="alert">
                <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <div class="alert-content">@successMessage</div>
            </div>
        }

        @if (!otpSent)
        {
            <p class="instruction-text">
                Enter your email address and we'll send you an OTP code to reset your password.
            </p>

            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input type="email" class="form-control custom-input" @bind="email" placeholder="name@example.com" />
            </div>

            <button class="btn btn-continue" @onclick="HandleSendOtp" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                Send OTP
            </button>

            <div class="login-footer-links">
                <span class="remember-text">Remember your password? <a href="@SignInLink" class="staff-login-link d-inline">Sign In</a></span>
            </div>
        }
        else
        {
            <p class="instruction-text">
                Enter the OTP code sent to your email and choose your new password.
            </p>

            <div class="form-group">
                <label class="form-label">OTP Code</label>
                <input type="text" class="form-control custom-input" @bind="otpCode" placeholder="Enter OTP code" />
            </div>

            <div class="form-group">
                <label class="form-label">New Password</label>
                <div class="password-input-wrapper">
                    <input type="@passwordInputType" class="form-control custom-input" @bind="newPassword" placeholder="New Password" />
                    <button type="button" class="btn-eye" @onclick="TogglePasswordVisibility">
                        @if (showPassword)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye-off"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                        }
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Confirm Password</label>
                <div class="password-input-wrapper">
                    <input type="@passwordInputType" class="form-control custom-input" @bind="confirmPassword" placeholder="Confirm Password" />
                </div>
            </div>

            <button class="btn btn-continue" @onclick="HandleResetPassword" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                Save
            </button>

            <div class="login-footer-links">
                <a href="@SignInLink" class="staff-login-link">Back to Sign In</a>
            </div>
        }
    </div>
    
    <div class="page-footer">
        <span>© LabCare</span>
        <a href="#">Contact</a>
        <a href="#">Privacy & terms</a>
    </div>
    <Booking.Components.Shared.ToastContainer />
</div>

@code {
    [SupplyParameterFromQuery]
    public string? role { get; set; }

    private string email = "";
    private string otpCode = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string resetToken = "";

    private bool otpSent = false;
    private bool isLoading = false;
    private bool showPassword = false;
    private string? errorMessage;
    private string? successMessage;

    private string passwordInputType => showPassword ? "text" : "password";

    private string SignInLink => (role == "staff") ? "/user-login" : "/login";

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleSendOtp()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Please enter your email address.";
            Toast.ShowError(errorMessage);
            return;
        }

        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("LabCareUrl");
            var payload = new { email = email };
            
            var response = await client.PostAsJsonAsync("api/Tenant/forgotpassword", payload);
            var responseContent = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var json = JObject.Parse(responseContent);
                resetToken = json["token"]?.ToString() ?? json["Token"]?.ToString() ?? "";
                
                successMessage = "OTP sent successfully to your email address.";
                otpSent = true;
                Toast.ShowSuccess("OTP sent successfully!");
            }
            else
            {
                errorMessage = responseContent;
                if (string.IsNullOrWhiteSpace(errorMessage))
                {
                    errorMessage = $"Request failed with status code: {response.StatusCode}";
                }
                Toast.ShowError(errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            Toast.ShowError(errorMessage);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleResetPassword()
    {
        if (string.IsNullOrWhiteSpace(otpCode))
        {
            errorMessage = "Please enter the OTP code.";
            Toast.ShowError(errorMessage);
            return;
        }

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Please enter a new password.";
            Toast.ShowError(errorMessage);
            return;
        }

        if (newPassword != confirmPassword)
        {
            errorMessage = "New password and confirm password do not match.";
            Toast.ShowError(errorMessage);
            return;
        }

        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("LabCareUrl");
            var payload = new 
            { 
                otp = otpCode, 
                token = resetToken, 
                newPassword = newPassword 
            };

            var response = await client.PostAsJsonAsync("api/Tenant/resetpassword", payload);
            var responseContent = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Password reset successfully! Logging you in...");
                await AutoLogin();
            }
            else
            {
                errorMessage = responseContent;
                if (string.IsNullOrWhiteSpace(errorMessage))
                {
                    errorMessage = $"Password reset failed. Status: {response.StatusCode}";
                }
                Toast.ShowError(errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            Toast.ShowError(errorMessage);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AutoLogin()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("LabCareUrl");

            if (role == "staff")
            {
                var payload = new LIMS_Backend.Model.LoginDto 
                {
                    input = email,
                    password = newPassword
                };

                var response = await UserService.LoginAsync(payload);

                if (response.IsSuccessStatusCode)
                {
                    var responseContent = await response.Content.ReadAsStringAsync();
                    var json = JObject.Parse(responseContent);
                    string? token = json["token"]?.ToString() ?? json["Token"]?.ToString();
                    
                    var userDetailsJson = json["userdetails"] ?? json["UserDetails"] ?? json["user"] ?? json["User"];
                    string? name = userDetailsJson?["name"]?.ToString() ?? "Staff Member";
                    
                    string? tenantCode = userDetailsJson?["tenant_code"]?.ToString() 
                        ?? userDetailsJson?["tenantCode"]?.ToString() 
                        ?? userDetailsJson?["tenant_id"]?.ToString();

                    if (!string.IsNullOrEmpty(token))
                    {
                        await _sessionStorage.SetAsync("authToken", token);
                        await _sessionStorage.SetAsync("tenant_code", tenantCode ?? "");
                        
                        TenantState.SetSession(tenantCode ?? "", token, name);
                        
                        Toast.ShowSuccess($"Staff login successful!");
                        await Task.Delay(1000);
                        NavigationManager.NavigateTo("/patientmaster");
                    }
                    else
                    {
                        NavigationManager.NavigateTo("/user-login");
                    }
                }
                else
                {
                    NavigationManager.NavigateTo("/user-login");
                }
            }
            else
            {
                var payload = new 
                {
                    email = email,
                    password = newPassword
                };

                var response = await client.PostAsJsonAsync("api/Tenant/login", payload);

                if (response.IsSuccessStatusCode)
                {
                    var responseContent = await response.Content.ReadAsStringAsync();
                    var json = JObject.Parse(responseContent);
                    string? token = json["token"]?.ToString() ?? json["Token"]?.ToString();
                    
                    string? tenantCodeVal = json["tenant_Code"]?.ToString() ?? json["tenant_code"]?.ToString();
                    string? tenantNameVal = json["tenant_Name"]?.ToString() ?? json["tenant_name"]?.ToString();

                    if (!string.IsNullOrEmpty(token))
                    {
                        await _sessionStorage.SetAsync("authToken", token);
                        await _sessionStorage.SetAsync("tenant_code", tenantCodeVal ?? "");
                        await _sessionStorage.SetAsync("tenant_name", tenantNameVal ?? "");
                        
                        Toast.ShowSuccess($"Admin login successful!");
                        await Task.Delay(1000);
                        NavigationManager.NavigateTo("/patientmaster");
                    }
                    else
                    {
                        NavigationManager.NavigateTo("/login");
                    }
                }
                else
                {
                    NavigationManager.NavigateTo("/login");
                }
            }
        }
        catch
        {
            NavigationManager.NavigateTo(SignInLink);
        }
    }
}
