    private void SelectKnowsSpecialist()
    {
        directWalkinSelectedDcode = 0;
        directWalkinDutyDcode = 0;
        OnDirectWalkinDoctorChanged();
    }

    private void SelectAssignDutyDoctor()
    {
        directWalkinSelectedDcode = -1;
        directWalkinDutyDcode = 0;
        OnDirectWalkinDoctorChanged();
    }

    private void CloseDirectWalkinModal()
    {
        showDirectWalkinModal = false;
    }

    private async Task OnDirectWalkinDoctorChanged()
    {
        selectedDirectWalkinSlot = null;
        directWalkinRequest.slot_detail_id = null;
        directWalkinSlots.Clear();

        int targetDcode = 0;
        if (directWalkinSelectedDcode == -1)
        {
            targetDcode = directWalkinDutyDcode;
        }
        else
        {
            targetDcode = directWalkinSelectedDcode;
        }

        if (targetDcode > 0)
        {
            loadingDirectWalkinSlots = true;
            try
            {
                directWalkinSlots = await BookingService.GetAvailableSlotsAsync(targetDcode, DateOnly.FromDateTime(directWalkinDate));
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Failed to load slots: {ex.Message}");
            }
            finally
            {
                loadingDirectWalkinSlots = false;
            }
        }
    }

    private void SelectDirectWalkinSlot(AvailableSlotModel slot)
    {
        selectedDirectWalkinSlot = slot;
        directWalkinRequest.slot_detail_id = slot.slot_detail_id;
    }

    private async Task SubmitDirectWalkinAsync()
    {
        if (directWalkinRequest.custid <= 0)
        {
            ToastService.ShowError("Please enter a valid Patient ID.");
            return;
        }

        if (walkinRegType == "DRESSING")
        {
            if (directWalkinSelectedDcode <= 0)
            {
                ToastService.ShowError("Please select a Doctor Specialist for dressing.");
                return;
            }
        }
        else
        {
            if (directWalkinSelectedDcode == 0)
            {
                ToastService.ShowError("Please select a Doctor Specialist or choose 'Patient doesn't know'.");
                return;
            }

            if (directWalkinSelectedDcode == -1)
            {
                if (directWalkinDutyDcode <= 0)
                {
                    ToastService.ShowError("Please select a Duty Doctor.");
                    return;
                }
                directWalkinRequest.dcode = null;
                directWalkinRequest.duty_dcode = directWalkinDutyDcode;
            }
            else
            {
                directWalkinRequest.dcode = directWalkinSelectedDcode;
                directWalkinRequest.duty_dcode = null;
            }
        }

        if (labSetting.is_slot_required != false)
        {
            if (selectedDirectWalkinSlot == null)
            {
                ToastService.ShowError("Please select an available time slot.");
                return;
            }
            directWalkinRequest.slot_detail_id = selectedDirectWalkinSlot.slot_detail_id;
        }
        else
        {
            directWalkinRequest.slot_detail_id = selectedDirectWalkinSlot?.slot_detail_id;
        }

        saving = true;
        try
        {
            string result;
            if (walkinRegType == "DRESSING")
            {
                var dressingRequest = new OPRegistrationModel.DressingRegistrationRequest
                {
                    custid = directWalkinRequest.custid,
                    dcode = directWalkinSelectedDcode,
                    department_code = directWalkinRequest.department_code,
                    slot_detail_id = directWalkinRequest.slot_detail_id,
                    notes = directWalkinRequest.notes
                };

                string jsonPayload = System.Text.Json.JsonSerializer.Serialize(dressingRequest, new System.Text.Json.JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull });
                Console.WriteLine("================ DRESSING REGISTRATION PAYLOAD ================");
                Console.WriteLine(jsonPayload);
                Console.WriteLine("====================================================================");

                result = await BookingService.DressingRegistrationAsync(dressingRequest);
            }
            else
            {
                string jsonPayload = System.Text.Json.JsonSerializer.Serialize(directWalkinRequest, new System.Text.Json.JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull });
                Console.WriteLine("================ DIRECT WALK-IN REGISTRATION PAYLOAD ================");
                Console.WriteLine(jsonPayload);
                Console.WriteLine("====================================================================");

                result = await BookingService.DirectWalkinAsync(directWalkinRequest);
            }

            if (result != null && result.StartsWith("Success"))
            {
                ToastService.ShowSuccess($"{(walkinRegType == "DRESSING" ? "Dressing" : "Direct Walk-in")} registered successfully!");
                CloseDirectWalkinModal();
                await LoadDataAsync();
            }
            else
            {
                ToastService.ShowError($"Failed to register: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Direct walk-in error: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

