@code {
    private bool loading = true;
    private bool saving = false;
    private bool showStatsPopover = false;
    private int currentPage = 1;
    private int pageSize = 10;

    private List<AppointmentBookingModel> allBookings = new();
    private Dictionary<Guid, OPRegistrationModel.OpRegistrationModel> opRegistrations = new();
    private List<DoctorMasterModel> doctors = new();
    private List<SharedComponents.Rcl.Models.CustomerModel> allCustomers = new();

    private System.Collections.Concurrent.ConcurrentDictionary<Guid, List<UnbilledChargeSummary>> visitUnbilledCharges = new();
    private bool showUnpaidModal = false;
    private List<UnbilledChargeSummary> unpaidChargesList = new();
    private string unpaidPatientName = "";

    // Filter states
    private DateTime? filterDate = DateTime.UtcNow.ToIndianTime().Date;
    private string filterStatus = "ALL";
    private int filterDoctor = 0;
    private string filterType = "ALL";
    private string filterSlot = "ALL";
    private string filterSearch = string.Empty;

    private List<(string Value, string Text)> GetDistinctSlots()
    {
        var query = allBookings.AsEnumerable();
        if (filterDate.HasValue)
        {
            var filterDateOnly = DateOnly.FromDateTime(filterDate.Value);
            query = query.Where(b => b.appointment_date == filterDateOnly);
        }
        if (filterDoctor > 0)
        {
            query = query.Where(b => b.dcode == filterDoctor);
        }
        return query
            .Where(b => b.slot_start_time != default(TimeOnly) || b.slot_end_time != default(TimeOnly))
            .Select(b => new { 
                Value = $"{b.slot_start_time:HH\\:mm\\:ss}_{b.slot_end_time:HH\\:mm\\:ss}",
                Text = $"{b.slot_start_time.ToString("hh:mm tt")} - {b.slot_end_time.ToString("hh:mm tt")}",
                StartTime = b.slot_start_time
            })
            .Distinct()
            .OrderBy(s => s.StartTime)
            .Select(s => (s.Value, s.Text))
            .ToList();
    }

    // Filtered bookings list to show in UI
    private List<AppointmentBookingModel> filteredBookings = new();

    // Direct Walk-in Modal State
    private bool showDirectWalkinModal = false;
    private string walkinRegType = "OP";
    private OPRegistrationModel.DirectWalkinRequest directWalkinRequest = new();
    private List<AvailableSlotModel> directWalkinSlots = new();
    private AvailableSlotModel? selectedDirectWalkinSlot = null;

    private void SetWalkinRegType(string type)
    {
        walkinRegType = type;
        if (type == "DRESSING")
        {
            if (directWalkinSelectedDcode == -1)
            {
                directWalkinSelectedDcode = 0;
                OnDirectWalkinDoctorChanged();
            }
        }
    }
    private bool loadingDirectWalkinSlots = false;
    private int directWalkinSelectedDcode = 0;
    private int directWalkinDutyDcode = 0;
    private DateTime directWalkinDate = DateTime.UtcNow.ToIndianTime().Date;
    private LabSettingModel labSetting = new();

    private string patientSearchQuery = "";
    private bool showPatientDropdown = false;
    private List<SharedComponents.Rcl.Models.CustomerModel> searchedPatients = new();

    private async Task OnPatientSearchKeyUp(KeyboardEventArgs e)
    {
        Console.WriteLine($"[OutPatientVisiting] OnPatientSearchKeyUp query: '{patientSearchQuery}'");
        if (string.IsNullOrWhiteSpace(patientSearchQuery))
        {
            searchedPatients.Clear();
            showPatientDropdown = false;
            directWalkinRequest.custid = 0;
            return;
        }

        try
        {
            using var client = ClientFactory.CreateClient("LabCareUrl");
            Console.WriteLine($"[OutPatientVisiting] TenantCode: '{TenantState.TenantCode}', AuthToken length: {TenantState.AuthToken?.Length ?? 0}");

            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }

            var requestUrl = $"api/Customer/search?key={Uri.EscapeDataString(patientSearchQuery)}";
            Console.WriteLine($"[OutPatientVisiting] Fetching URL: {requestUrl}");

            var response = await client.GetAsync(requestUrl);
            var rawJson = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"[OutPatientVisiting] Response Code: {response.StatusCode}, Content: {rawJson}");

            if (response.IsSuccessStatusCode)
            {
                var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<SharedComponents.Rcl.Models.CustomerModel>>(rawJson) ?? new();
                searchedPatients = list.Take(10).ToList();
                showPatientDropdown = searchedPatients.Count > 0;
                Console.WriteLine($"[OutPatientVisiting] Found {searchedPatients.Count} patients");
            }
            else
            {
                searchedPatients.Clear();
                showPatientDropdown = false;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error searching patients in OutPatientVisiting: {ex.Message}");
            searchedPatients.Clear();
            showPatientDropdown = false;
        }
    }

    private void SelectCustomerPatient(SharedComponents.Rcl.Models.CustomerModel pat)
    {
        directWalkinRequest.custid = pat.custid;
        patientSearchQuery = $"{pat.name} (CUST-{pat.custid})";
        showPatientDropdown = false;
    }

    private void ClearFilters()
    {
        filterDate = DateTime.UtcNow.ToIndianTime().Date;
        filterDoctor = 0;
        filterStatus = "ALL";
        filterType = "ALL";
        filterSlot = "ALL";
        filterSearch = string.Empty;
        ApplyFilters();
    }

    // Modals state
    private bool showRegisterModal = false;
    private AppointmentBookingModel? selectedBooking;
    private OPRegistrationModel.OpRegistrationModel newOpRequest = new();

    private bool showVitalsModal = false;
    private bool isEditingVitals = false;
    private OPRegistrationModel.OpRegistrationModel? currentOp;
    private OPRegistrationModel.PatientVitalsModel vitalsRequest = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            labSetting = await LabSettingService.GetLabSettingAsync() ?? new LabSettingModel();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading lab setting: {ex.Message}");
        }
        await LoadDoctorsAsync();
        await LoadDataAsync();
    }

    private async Task LoadDoctorsAsync()
    {
        try
        {
            var raw = await DoctorService.GetDoctorsAsync();
            doctors = raw.Where(d => !d.deleted).OrderBy(d => string.IsNullOrWhiteSpace(d.name) ? d.doctorfullname : d.name).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctors: {ex.Message}");
        }
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        try
        {
            // Fetch ONLY OP registrations from api/OpRegistration/all
            var regs = await BookingService.GetAllOpRegistrationsAsync();
            opRegistrations = new Dictionary<Guid, OPRegistrationModel.OpRegistrationModel>();
            allBookings = new List<AppointmentBookingModel>();

            foreach (var r in regs.Where(x => !x.isdeleted))
            {
                var item = new AppointmentBookingModel
                {
                    booking_id = r.op_id,
                    booking_no = r.op_no,
                    custid = r.custid,
                    dcode = r.dcode,
                    slot_detail_id = r.slot_detail_id ?? Guid.Empty,
                    appointment_date = r.visit_date,
                    slot_start_time = r.slot_start_time.ToIndianTime() ?? default(TimeOnly),
                    slot_end_time = r.slot_end_time.ToIndianTime() ?? default(TimeOnly),
                    token_no = r.token_no ?? 0,
                    booking_status = r.visit_status,
                    booking_type = r.reg_type,
                    notes = r.notes,
                    isdeleted = r.isdeleted,
                    created_at = r.created_at,
                    updated_at = r.updated_at,
                    patient_name = r.patient_name,
                    isvip = r.isvip,
                    is_vip = r.is_vip,
                    viprole = r.viprole,
                    is_dressing = r.is_dressing,
                    refer_to_ip = r.refer_to_ip
                };

                allBookings.Add(item);
                opRegistrations[r.op_id] = r;
            }

            ApplyFilters();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading data: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyFilters()
    {
        var query = allBookings.AsQueryable();

        // 1. Date Filter
        if (filterDate.HasValue)
        {
            var dateOnly = DateOnly.FromDateTime(filterDate.Value);
            query = query.Where(b => b.appointment_date == dateOnly);
        }

        // 2. Doctor Filter
        if (filterDoctor > 0)
        {
            query = query.Where(b => b.dcode == filterDoctor);
        }

        // 3. Search Filter (by Booking No, Patient ID or Doctor ID)
        if (!string.IsNullOrWhiteSpace(filterSearch))
        {
            var searchLower = filterSearch.Trim().ToLower();
            query = query.Where(b => 
                (b.booking_no != null && b.booking_no.ToLower().Contains(searchLower)) ||
                (b.patient_name != null && b.patient_name.ToLower().Contains(searchLower)) ||
                ("cust-" + b.custid).ToLower().Contains(searchLower) ||
                b.custid.ToString().Contains(searchLower) ||
                ("doc-" + b.dcode).ToLower().Contains(searchLower) ||
                b.dcode.ToString().Contains(searchLower)
            );
        }

        var list = query.OrderBy(b => b.slot_start_time).ToList();

        // 4. Status Filter
        if (filterStatus != "ALL")
        {
            if (filterStatus == "UNREGISTERED")
            {
                list = list.Where(b => !opRegistrations.ContainsKey(b.booking_id)).ToList();
            }
            else
            {
                list = list.Where(b => 
                    opRegistrations.ContainsKey(b.booking_id) && 
                    opRegistrations[b.booking_id].visit_status.Equals(filterStatus, StringComparison.OrdinalIgnoreCase)
                ).ToList();
            }
        }

        // 5. Booking Type Filter
        if (filterType != "ALL")
        {
            if (filterType == "ONLINE")
            {
                list = list.Where(b => b.booking_type == "ONLINE" && !(b.notes != null && b.notes.StartsWith("[WALKIN]"))).ToList();
            }
            else if (filterType == "WALKIN")
            {
                list = list.Where(b => b.booking_type == "WALKIN" || (b.notes != null && b.notes.StartsWith("[WALKIN]"))).ToList();
            }
        }

        // 6. Time Slot Filter
        if (!string.IsNullOrWhiteSpace(filterSlot) && filterSlot != "ALL")
        {
            var parts = filterSlot.Split('_');
            if (parts.Length == 2 && TimeOnly.TryParse(parts[0], out var sStart) && TimeOnly.TryParse(parts[1], out var sEnd))
            {
                list = list.Where(b => b.slot_start_time == sStart && b.slot_end_time == sEnd).ToList();
            }
        }

        filteredBookings = list;
        currentPage = 1;
    }

    private void OpenRegisterModal(AppointmentBookingModel booking)
    {
        selectedBooking = booking;
        
        string regType = (booking.booking_type == "WALKIN" || (booking.booking_type == "ONLINE" && booking.notes != null && booking.notes.StartsWith("[WALKIN]"))) ? "WALKIN" : "ONLINE";
        
        newOpRequest = new OPRegistrationModel.OpRegistrationModel
        {
            booking_id = booking.booking_id,
            booking_no = booking.booking_no,
            slot_detail_id = booking.slot_detail_id,
            custid = booking.custid,
            dcode = booking.dcode,
            department_code = 3,
            visit_type = "NEWVISIT",
            reg_type = regType,
            notes = "Patient arrived",
            visit_date = DateOnly.FromDateTime(DateTime.UtcNow.ToIndianTime())
        };
        showRegisterModal = true;
    }

    private void CloseRegisterModal()
    {
        showRegisterModal = false;
        selectedBooking = null;
    }

    private async Task SubmitRegistrationAsync()
    {
        if (selectedBooking == null) return;
        
        saving = true;
        try
        {
            var jsonOptions = new System.Text.Json.JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull };
            var jsonPayload = System.Text.Json.JsonSerializer.Serialize(newOpRequest, jsonOptions);
            Console.WriteLine("=================== OP REGISTRATION SUBMIT PAYLOAD ===================");
            Console.WriteLine(jsonPayload);
            Console.WriteLine("========================================================================");

            var result = await BookingService.RegisterOpAsync(newOpRequest);
            if (result != null && result.StartsWith("Success"))
            {
                ToastService.ShowSuccess("Outpatient registered successfully!");
                CloseRegisterModal();
                await LoadDataAsync();
            }
            else
            {
                ToastService.ShowError($"Failed to register outpatient: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Registration error: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private bool allNormalToggle = false;

    private void CalculateBMI()
    {
        if (vitalsRequest.height_cm > 0 && vitalsRequest.weight_kg > 0)
        {
            var heightInMeters = vitalsRequest.height_cm.Value / 100m;
            vitalsRequest.bmi = Math.Round(vitalsRequest.weight_kg.Value / (heightInMeters * heightInMeters), 2);
        }
        else
        {
            vitalsRequest.bmi = null;
        }
    }

    private void ToggleAllNormal()
    {
        if (allNormalToggle)
        {
            vitalsRequest.pedal_oedema = "Absent";
            vitalsRequest.jvp = "Not Raised";
            vitalsRequest.cvs = "S1S2 Normal";
            vitalsRequest.rs = "B/L Clear";
            vitalsRequest.cns = "Conscious, Oriented";
            vitalsRequest.abdomen = "Soft, Non-tender";
        }
        else
        {
            vitalsRequest.pedal_oedema = "";
            vitalsRequest.jvp = "";
            vitalsRequest.cvs = "";
            vitalsRequest.rs = "";
            vitalsRequest.cns = "";
            vitalsRequest.abdomen = "";
        }
    }

    private async Task OpenVitalsModal(OPRegistrationModel.OpRegistrationModel opData)
    {
        currentOp = opData;
        
        var existingVitals = await BookingService.GetOpVitalsAsync(opData.op_id);
        
        if (existingVitals != null && existingVitals.Any())
        {
            vitalsRequest = existingVitals.OrderByDescending(v => v.created_at).First();
            isEditingVitals = true;
        }
        else
        {
            vitalsRequest = new OPRegistrationModel.PatientVitalsModel
            {
                op_id = opData.op_id,
                op_no = opData.op_no,
                custid = opData.custid,
                dcode = opData.dcode
            };
            isEditingVitals = false;
        }
        
        showVitalsModal = true;
    }

    private void CloseVitalsModal()
    {
        showVitalsModal = false;
        currentOp = null;
    }

    private async Task SubmitVitalsAsync()
    {
        saving = true;
        try
        {
            bool success;
            if (isEditingVitals)
            {
                success = await BookingService.UpdateOpVitalsAsync(vitalsRequest);
            }
            else
            {
                success = await BookingService.SaveOpVitalsAsync(vitalsRequest);
            }

            if (success)
            {
                ToastService.ShowSuccess("Vitals saved successfully!");
                CloseVitalsModal();
                await LoadDataAsync();
            }
            else
            {
                ToastService.ShowError("Failed to save vitals.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Vitals saving error: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task UpdateStatusAsync(OPRegistrationModel.OpRegistrationModel opData, string? newStatus)
    {
        if (string.IsNullOrEmpty(newStatus)) return;
        
        var success = await BookingService.UpdateOpStatusAsync(opData.op_id, newStatus);
        if (success)
        {
            opData.visit_status = newStatus;
            ToastService.ShowSuccess($"Status updated to {newStatus}");
            await LoadDataAsync();
        }
        else
        {
            ToastService.ShowError("Failed to update status.");
            StateHasChanged();
        }
    }

    private string GetDoctorName(int dcode)
    {
        var doc = doctors.FirstOrDefault(d => d.dcode == dcode);
        if (doc != null)
        {
            var name = string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name;
            if (!string.IsNullOrWhiteSpace(name))
            {
                return name.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? name : $"Dr. {name}";
            }
        }
        return $"Doctor #{dcode}";
    }

