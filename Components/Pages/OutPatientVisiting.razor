                                <input type="text" class="filter-control" @bind="vitalsRequest.pedal_oedema" />
                            </div>
                        </div>
                        <div class="clinical-row">
                            <label>JVP</label>
                            <div class="clinical-input">
                                <input type="text" class="filter-control" @bind="vitalsRequest.jvp" />
