@if (showUnpaidModal)
{
    <div class="modal-backdrop" @onclick="CloseUnpaidModal"></div>
    <div class="glass-modal" style="max-width: 800px; width: 95%;">
        <div class="modal-header">
             <div class="d-flex align-items-center gap-2">
                 <i class="bi bi-receipt-cutoff text-primary" style="font-size: 1.2rem;"></i>
                 <h3 style="margin: 0;">Unpaid / Unbilled Charges Details</h3>
             </div>
             <button class="close-btn" @onclick="CloseUnpaidModal">×</button>
        </div>
        <div class="modal-body" style="max-height: 60vh; overflow-y: auto;">
             <div class="d-flex justify-content-between align-items-center mb-3">
                 <div>Patient Name: <strong class="text-dark">@unpaidPatientName</strong></div>
                 <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1" style="font-size:0.75rem; font-weight:700;">
                     @unpaidChargesList.Count Pending Charges
                 </span>
             </div>
             <div class="table-responsive">
                 <table class="medico-table">
                     <thead>
                         <tr>
                             <th>Entry Type</th>
                             <th>Charge Name</th>
                             <th>Date</th>
                             <th class="text-end">Qty</th>
                             <th class="text-end">Rate (₹)</th>
                             <th class="text-end">Disc (₹)</th>
                             <th class="text-end">Amount (₹)</th>
                             <th class="text-center" style="width: 90px;">Action</th>
                         </tr>
                     </thead>
                     <tbody>
                         @foreach (var uc in unpaidChargesList)
                         {
                             var isEditing = editingUnpaidId == uc.unbilledid;
                             <tr class="@(isEditing ? "bg-primary-subtle" : "")">
                                 <td class="font-bold">
                                     <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size:0.72rem; font-weight:700;">
                                         @(uc.entrytype ?? "CHARGE")
                                     </span>
                                 </td>
                                 <td>
                                     <strong style="color: #0f172a;">@(string.IsNullOrWhiteSpace(uc.item_name) ? (uc.entrytype ?? "Charge") : uc.item_name)</strong>
                                     @if (!string.IsNullOrEmpty(uc.unbilledid))
                                     {
                                         <span style="display: block; font-size: 0.65rem; color: #94a3b8; font-family: monospace;">Ref: @(uc.unbilledid.Length > 8 ? uc.unbilledid.Substring(0, 8) + "..." : uc.unbilledid)</span>
                                     }
                                 </td>
                                 <td style="font-size:0.75rem; color: #64748b;">@uc.chargedate?.ToIndianTime().ToString("dd-MM-yyyy hh:mm tt")</td>
                                 
                                 @if (isEditing)
                                 {
                                     <td class="text-end">
                                         <input type="number" min="1" step="1" class="form-control form-control-sm text-end" style="width: 65px; display: inline-block; height: 28px; padding: 0.15rem 0.35rem;"
                                                @bind="editUnpaidRequest.quantity" @bind:after="RecalculateEditUnpaidAmount" />
                                     </td>
                                     <td class="text-end">
                                         <input type="number" min="0" step="0.01" class="form-control form-control-sm text-end font-monospace" style="width: 80px; display: inline-block; height: 28px; padding: 0.15rem 0.35rem;"
                                                @bind="editUnpaidRequest.rate" @bind:after="RecalculateEditUnpaidAmount" />
                                     </td>
                                     <td class="text-end">
                                         <input type="number" min="0" step="0.01" class="form-control form-control-sm text-end font-monospace" style="width: 75px; display: inline-block; height: 28px; padding: 0.15rem 0.35rem;"
                                                @bind="editUnpaidRequest.discount" @bind:after="RecalculateEditUnpaidAmount" />
                                     </td>
                                     <td class="text-end font-monospace" style="font-weight: 700; color: #0284c7;">
                                         ₹ @((editUnpaidRequest.amount ?? 0).ToString("N2"))
                                     </td>
                                     <td class="text-center">
                                         <div class="d-flex justify-content-center gap-1">
                                             <button class="btn btn-sm btn-success px-2 py-0" style="font-size: 0.72rem; height: 26px;"
                                                     disabled="@savingUnpaidUpdate" @onclick="SaveUnpaidChargeUpdateAsync" title="Save">
                                                 @if (savingUnpaidUpdate)
                                                 {
                                                     <span class="spinner-border spinner-border-sm" role="status"></span>
                                                 }
                                                 else
                                                 {
                                                     <i class="bi bi-check-lg"></i>
                                                 }
                                             </button>
                                             <button class="btn btn-sm btn-outline-secondary px-2 py-0" style="font-size: 0.72rem; height: 26px;"
                                                     disabled="@savingUnpaidUpdate" @onclick="CancelEditUnpaid" title="Cancel">
                                                 <i class="bi bi-x-lg"></i>
                                             </button>
                                         </div>
                                     </td>
                                 }
                                 else
                                 {
                                     <td class="text-end font-monospace">@uc.quantity</td>
                                     <td class="text-end font-monospace">₹ @(uc.rate?.ToString("N2") ?? "-")</td>
                                     <td class="text-end font-monospace text-muted">₹ @(uc.discount?.ToString("N2") ?? "0.00")</td>
                                     <td class="text-end font-monospace" style="font-weight: 700; color: #b91c1c;">₹ @(uc.amount?.ToString("N2") ?? "-")</td>
                                     <td class="text-center">
                                         @if (uc.billedstatus != true && !string.IsNullOrEmpty(uc.unbilledid))
                                         {
                                             <button type="button" class="btn btn-sm btn-outline-primary px-2 py-0" style="font-size:0.72rem; font-weight:600; height: 26px;" @onclick="() => StartEditUnpaid(uc)">
                                                 <i class="bi bi-pencil-square me-1"></i>Edit
                                             </button>
                                         }
                                         else
                                         {
                                             <span class="text-muted small">-</span>
                                         }
                                     </td>
                                 }
                             </tr>
                         }
                     </tbody>
                     <tfoot>
                         <tr style="font-weight: 700; background: #f8fafc; border-top: 2px solid #cbd5e1;">
                             <td colspan="6" class="text-end text-uppercase" style="font-size: 0.75rem; color: #475569;">Total Unpaid Amount:</td>
                             <td class="text-end font-monospace" style="color: #b91c1c; font-size: 0.95rem;">
                                 ₹ @unpaidChargesList.Sum(c => c.amount ?? 0).ToString("N2")
                             </td>
                             <td></td>
                         </tr>
                     </tfoot>
                 </table>
             </div>
        </div>
        <div class="modal-footer">
             <button class="btn-modal cancel" @onclick="CloseUnpaidModal">Close</button>
        </div>
    </div>
}

@if (showVitalsModal && currentOp != null)
