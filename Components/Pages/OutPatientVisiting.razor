                                {
                                    var isSelected = selectedDirectWalkinSlot?.slot_detail_id == slot.slot_detail_id;
                                    var availWalkin = slot.max_walkin > 0 ? Math.Max(0, slot.max_walkin - slot.walkin_count) : Math.Max(0, slot.remaining_seats);
                                    var isFull = availWalkin <= 0;
