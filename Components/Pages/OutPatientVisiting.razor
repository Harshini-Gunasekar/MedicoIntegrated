                    </summary>
                    <pre class="bg-dark text-light p-2 rounded mt-2 small" style="max-height: 200px; overflow-y: auto; font-family: monospace; font-size: 0.8rem; text-align: left;">@System.Text.Json.JsonSerializer.Serialize(new {
    booking_id = newOpRequest.booking_id,
