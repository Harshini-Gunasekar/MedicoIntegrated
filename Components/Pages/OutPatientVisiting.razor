                </button>
            </div>
        </div>
    </div>
}



@if (showDirectWalkinModal)
{
    <div class="modal-backdrop" @onclick="CloseDirectWalkinModal"></div>
    <div class="glass-modal walkin-modal" style="@(labSetting.is_slot_required == false ? "max-width: 500px !important;" : "")">
        <div class="modal-header">
            <h3>Direct Walk-in OP Registration</h3>
            <button class="close-btn" @onclick="CloseDirectWalkinModal">×</button>
        </div>
        <div class="modal-body @(labSetting.is_slot_required == false ? "" : "modal-grid-2")" style="@(labSetting.is_slot_required == false ? "padding: 1.5rem;" : "")">
            <!-- Left: Form inputs -->
            <div class="modal-form-left">
                <div class="form-group" style="position: relative;">
                    <label class="walkin-label-bold">Search Patient MobileNo</label>
                    <div class="autocomplete-search-wrapper">
                        <input type="text" class="walkin-input" placeholder="Search Patient MobileNo..."
                               value="@patientSearchQuery" @oninput="OnPatientSearchInput" @onkeydown="OnPatientSearchKeyDown" style="width: 100%;" />
                        @if (showPatientDropdown && searchedPatients.Count > 0)
                        {
                            <div class="autocomplete-dropdown">
                                @for (int i = 0; i < searchedPatients.Count; i++)
                                {
                                    var patIdx = i;
                                    var pat = searchedPatients[i];
                                    <div class="autocomplete-item @(patIdx == activePatientIndex ? "active-focused" : "")" 
                                         @onclick="() => SelectCustomerPatient(pat)"
                                         @onmouseover="() => activePatientIndex = patIdx">
                                        <div>
                                            <span style="font-weight: 600; color: #0f172a;">@pat.name (CUST-@pat.custid)</span>
                                            <div style="font-size: 0.8em; color: #64748b;">
                                                📞 @pat.mobile
                                            </div>
                                        </div>
                                        <span class="autocomplete-code">@pat.custcode</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label class="walkin-label-bold">REGISTRATION TYPE</label>
                    <div class="radio-toggle-group">
                        <button type="button" class="radio-toggle-btn @(walkinRegType == "OP" ? "active" : "")" @onclick='() => SetWalkinRegType("OP")'>
                            <i class="bi bi-person-badge-fill"></i> OP Consultation
                        </button>
                        <button type="button" class="radio-toggle-btn @(walkinRegType == "DRESSING" ? "active" : "")" @onclick='() => SetWalkinRegType("DRESSING")'>
                            <i class="bi bi-bandaid-fill"></i> Dressing
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="walkin-label-bold">DOCTOR SPECIALIST SELECTION</label>
                    @if (walkinRegType == "DRESSING")
                    {
                        <div class="doctor-selector-wrapper">
                            <button type="button" class="doctor-selector-button @(showDressingDoctorDropdown ? "active" : "")" @onclick="() => showDressingDoctorDropdown = !showDressingDoctorDropdown">
                                <span>
                                    @if (directWalkinSelectedDcode > 0)
                                    {
                                        @($"Dr. {(doctors.FirstOrDefault(d => d.dcode == directWalkinSelectedDcode)?.name ?? "Selected")}")
                                    }
                                    else
                                    {
                                        <span style="color: #94a3b8;">-- Select Specialist Doctor --</span>
                                    }
                                </span>
                                <i class="bi bi-chevron-down dropdown-icon"></i>
                            </button>
                            @if (showDressingDoctorDropdown)
                            {
                                <div class="doctor-selector-dropdown">
                                    @foreach (var doc in doctors)
                                    {
                                        var avail = doctorAvailableSlotsMap.ContainsKey(doc.dcode) ? doctorAvailableSlotsMap[doc.dcode] : -1;
                                        var rawName = string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname ?? "Specialist" : doc.name;
                                        var docName = rawName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? rawName : $"Dr. {rawName}";
                                        var isSelected = directWalkinSelectedDcode == doc.dcode;
                                        var hasSlots = labSetting.is_slot_required != false ? avail > 0 : true;

                                        <div class="doctor-option-item @(isSelected ? "selected" : "")" 
                                             @onclick="async () => { directWalkinSelectedDcode = doc.dcode; showDressingDoctorDropdown = false; await OnDirectWalkinDoctorChanged(); }">
                                            <div class="doctor-availability-indicator @(hasSlots ? "available" : "unavailable")">
                                                @if (hasSlots)
                                                {
                                                    <i class="bi bi-check-circle"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-x-circle"></i>
                                                }
                                            </div>
                                            <div class="doctor-option-content">
                                                <div class="doctor-option-name">@docName</div>
                                                <div class="doctor-option-slots">
                                                    @if (labSetting.is_slot_required != false)
                                                    {
                                                        @if (avail > 0)
                                                        {
                                                            <span>@avail Available Slots</span>
                                                        }
                                                        else
                                                        {
                                                            <span style="color: #ef4444; font-weight: 600;">No Slots Available</span>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="radio-toggle-group">
                            <button type="button" class="radio-toggle-btn @(directWalkinSelectedDcode != -1 ? "active" : "")" @onclick="SelectKnowsSpecialist">
                                <i class="bi bi-person-check-fill"></i> Knows Specialist
                            </button>
                            <button type="button" class="radio-toggle-btn @(directWalkinSelectedDcode == -1 ? "active" : "")" @onclick="SelectAssignDutyDoctor">
                                <i class="bi bi-person-plus-fill"></i> Assign Duty Doctor
                            </button>
                        </div>
                        
                        @if (directWalkinSelectedDcode != -1)
                        {
                            <div class="doctor-selector-wrapper">
                                <button type="button" class="doctor-selector-button @(showSpecialistDoctorDropdown ? "active" : "")" @onclick="() => showSpecialistDoctorDropdown = !showSpecialistDoctorDropdown">
                                    <span>
                                        @if (directWalkinSelectedDcode > 0)
                                        {
                                            @($"Dr. {(doctors.FirstOrDefault(d => d.dcode == directWalkinSelectedDcode)?.name ?? "Selected")}")
                                        }
                                        else
                                        {
                                            <span style="color: #94a3b8;">-- Select Specialist Doctor --</span>
                                        }
                                    </span>
                                    <i class="bi bi-chevron-down dropdown-icon"></i>
                                </button>
                                @if (showSpecialistDoctorDropdown)
                                {
                                    <div class="doctor-selector-dropdown">
