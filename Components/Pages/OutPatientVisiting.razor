    // --- Consolidated Bill Preview & Reporting ---
    private bool isPrintingBill = false;

    private async Task<string> FetchConsolidatedBillBase64(Guid opId)
    {
        string tenant = !string.IsNullOrWhiteSpace(TenantState?.TenantCode) ? TenantState.TenantCode : "0010";
        string token = !string.IsNullOrWhiteSpace(TenantState?.AuthToken) ? TenantState.AuthToken : "";

        if (string.IsNullOrWhiteSpace(token))
        {
            try
            {
                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                if (!tokenResult.Success || string.IsNullOrEmpty(tokenResult.Value))
                {
                    tokenResult = await _sessionStorage.GetAsync<string>("auth_token");
                }
                if (tokenResult.Success && !string.IsNullOrEmpty(tokenResult.Value))
                {
                    token = tokenResult.Value;
                }
            }
            catch { }
        }

        if (string.IsNullOrWhiteSpace(tenant) || tenant == "0010")
        {
            try
            {
                var tenantResult = await _sessionStorage.GetAsync<string>("tenant_code");
                if (!tenantResult.Success || string.IsNullOrEmpty(tenantResult.Value))
                {
                    tenantResult = await _sessionStorage.GetAsync<string>("tenantcode");
                }
                if (tenantResult.Success && !string.IsNullOrEmpty(tenantResult.Value))
                {
                    tenant = tenantResult.Value;
                }
            }
            catch { }
        }

        string opIdStr = opId.ToString();
        var candidateUrls = new List<string>
        {
            $"https://medicoapi.iscansoft.com/api/report/getconsolidatedbill?op_id={opIdStr}&isletterhead=true&tenantcode={tenant}&tenant_code={tenant}",
            $"https://medicoapi.iscansoft.com/api/report/getconsolidatedbill?op_id={opIdStr}",
            $"https://medicoapi.iscansoft.com/api/report/getconsolidatedbill?requestguid={opIdStr}&isletterhead=true&tenantcode={tenant}&tenant_code={tenant}",
            $"api/report/getconsolidatedbill?op_id={opIdStr}&isletterhead=true&tenantcode={tenant}&tenant_code={tenant}",
            $"api/report/getconsolidatedbill?op_id={opIdStr}",
            $"api/Report/getconsolidatedbill?op_id={opIdStr}&isletterhead=true&tenantcode={tenant}&tenant_code={tenant}",
            $"api/Report/GetConsolidatedBill?op_id={opIdStr}&isletterhead=true&tenantcode={tenant}&tenant_code={tenant}"
        };

        var client = ClientFactory.CreateClient("LabCareUrl");
        string lastError = "";

        foreach (var url in candidateUrls)
        {
            try
            {
                var req = new HttpRequestMessage(HttpMethod.Get, url);
                if (!string.IsNullOrEmpty(token))
                {
                    req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                }
                req.Headers.Add("tenantcode", tenant);
                req.Headers.Add("tenant_code", tenant);
                req.Headers.Add("tenant-code", tenant);

                var response = await client.SendAsync(req);

                if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
                {
                    var contentStr = await response.Content.ReadAsStringAsync();
                    contentStr = contentStr.Trim('"').Trim();

                    string base64Data = contentStr;
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(contentStr);
                        var root = doc.RootElement;
                        if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {
                            if (root.TryGetProperty("data", out var dProp)) base64Data = dProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("base64", out var bProp)) base64Data = bProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("file", out var fProp)) base64Data = fProp.GetString() ?? contentStr;
                        }
                        else if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                        {
                            base64Data = root.GetString() ?? contentStr;
                        }
                    }
                    catch { }

                    if (!string.IsNullOrWhiteSpace(base64Data) && base64Data.Length >= 50)
                    {
                        return base64Data;
                    }
                }
                else
                {
                    var errContent = await response.Content.ReadAsStringAsync();
                    lastError = $"HTTP {(int)response.StatusCode} ({response.ReasonPhrase}): {errContent}";
                }
            }
            catch (Exception ex)
            {
                lastError = ex.Message;
            }
        }

        throw new Exception(string.IsNullOrEmpty(lastError) ? "Backend report endpoint returned empty data." : lastError);
    }

    private async Task PreviewConsolidatedBill(OPRegistrationModel.OpRegistrationModel opData)
    {
        if (opData == null || opData.op_id == Guid.Empty)
        {
            ToastService.ShowWarning("Invalid Outpatient visit record.");
            return;
        }

        try
        {
            isPrintingBill = true;
            StateHasChanged();

            string base64Data = await FetchConsolidatedBillBase64(opData.op_id);

            if (!string.IsNullOrWhiteSpace(base64Data) && (base64Data.StartsWith("data:application/pdf") || base64Data.Length > 100))
            {
                string billTitle = string.IsNullOrWhiteSpace(opData.op_no) ? "Consolidated Bill" : $"Consolidated Bill - {opData.op_no}";
                await JSRuntime.InvokeVoidAsync("openPdfPreviewModal", base64Data, billTitle);
            }
            else
            {
                ToastService.ShowError("Unable to load PDF preview: Invalid report data returned.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading consolidated bill: {ex.Message}");
        }
        finally
        {
            isPrintingBill = false;
            StateHasChanged();
        }
    }

