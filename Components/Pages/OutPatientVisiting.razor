    private bool showPatientDropdown = false;
    private List<SharedComponents.Rcl.Models.CustomerModel> searchedPatients = new();
    private System.Threading.CancellationTokenSource? _patientSearchCts;

    private int activePatientIndex = -1;

    private async Task OnPatientSearchInput(ChangeEventArgs e)
    {
        patientSearchQuery = e.Value?.ToString() ?? "";
        activePatientIndex = -1;

        _patientSearchCts?.Cancel();
        _patientSearchCts = new System.Threading.CancellationTokenSource();
        var token = _patientSearchCts.Token;

        if (string.IsNullOrWhiteSpace(patientSearchQuery))
        {
            searchedPatients.Clear();
            showPatientDropdown = false;
            activePatientIndex = -1;
            if (directWalkinRequest != null) directWalkinRequest.custid = 0;
            StateHasChanged();
            return;
        }

        try
        {
            await Task.Delay(250, token);

            using var client = ClientFactory.CreateClient("LabCareUrl");

            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }

            var requestUrl = $"api/Customer/search?key={Uri.EscapeDataString(patientSearchQuery)}";
            var response = await client.GetAsync(requestUrl, token);

            if (token.IsCancellationRequested) return;

            if (response.IsSuccessStatusCode)
            {
                var rawJson = await response.Content.ReadAsStringAsync(token);
                if (token.IsCancellationRequested) return;

                var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<SharedComponents.Rcl.Models.CustomerModel>>(rawJson) ?? new();
                
                var currentSetting = await LabSettingService.GetLabSettingAsync();
                bool showAll = currentSetting?.show_all_customers ?? true;
                if (!showAll)
                {
                    list = list.Where(pat => string.IsNullOrEmpty(pat.tenant_code) || string.Equals(pat.tenant_code, TenantState.TenantCode, StringComparison.OrdinalIgnoreCase)).ToList();
                }

                searchedPatients = list.Take(10).ToList();
                showPatientDropdown = searchedPatients.Count > 0;
                activePatientIndex = -1;
            }
            else
            {
                searchedPatients.Clear();
                showPatientDropdown = false;
                activePatientIndex = -1;
            }
        }
        catch (OperationCanceledException)
        {
            // Task cancelled due to newer input - ignore
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error searching patients in OutPatientVisiting: {ex.Message}");
            searchedPatients.Clear();
            showPatientDropdown = false;
            activePatientIndex = -1;
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void OnPatientSearchKeyDown(KeyboardEventArgs e)
    {
        if (!showPatientDropdown || searchedPatients.Count == 0) return;

        if (e.Key == "ArrowDown")
        {
            if (activePatientIndex < searchedPatients.Count - 1)
            {
                activePatientIndex++;
            }
            else
            {
                activePatientIndex = 0;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            if (activePatientIndex > 0)
            {
                activePatientIndex--;
            }
            else
            {
                activePatientIndex = searchedPatients.Count - 1;
            }
        }
        else if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            if (activePatientIndex >= 0 && activePatientIndex < searchedPatients.Count)
            {
                SelectCustomerPatient(searchedPatients[activePatientIndex]);
                activePatientIndex = -1;
            }
        }
        else if (e.Key == "Escape")
        {
            showPatientDropdown = false;
            activePatientIndex = -1;
        }
    }

