@page "/booking/outpatient"
@using Booking.Models
@using Booking.Services
@using Booking.Helpers
@using medico_backend.Model

@inject AppointmentBookingService BookingService
@inject HmsBillingService HmsBillingService
@inject DoctorService DoctorService
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject IHttpClientFactory ClientFactory
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject LabSettingService LabSettingService
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@using Microsoft.JSInterop

<PageTitle>Outpatient Visiting</PageTitle>

<style>
    .ip-referred-badge {
        background-color: #16a34a !important;
        color: #ffffff !important;
        font-weight: 700;
        font-size: 0.72rem;
        padding: 3px 8px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        box-shadow: 0 0 6px rgba(22, 163, 74, 0.3);
        user-select: none;
    }
</style>

<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
</div>

<div class="dashboard-container">
    <DnaLoader IsLoading="@(loading || isPrintingBill || isDownloadingBillPdf)" Message="@(isPrintingBill ? "Generating Consolidated Bill..." : (isDownloadingBillPdf ? "Downloading Consolidated Bill..." : "Loading Outpatients..."))" />
    <!-- Header -->
    <div class="dashboard-header">
        <div class="dashboard-title">
            <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                <h1 style="margin-bottom: 0;">Outpatient Visiting Dashboard</h1>
                <span class="kutty-user-badge" title="Total users/patients matching current filters">
                    <i class="bi bi-people-fill"></i> @filteredBookings.Count @(filteredBookings.Count == 1 ? "User" : "Users")
                </span>
            </div>
            <p style="margin-top: 0.25rem;">Manage today's outpatient registrations, update consultation queue status, and log vitals.</p>
        </div>
        <div style="display: flex; gap: 0.5rem; align-items: center; position: relative;">
            <button class="btn-header-action secondary" @onclick="() => showStatsPopover = !showStatsPopover" style="background: #ffffff; color: #475569; border: 1px solid #cbd5e1; font-weight: 700; height: 38px;">
                <i class="bi bi-bar-chart-fill" style="color: #0284c7;"></i>
                <span>@(showStatsPopover ? "Hide Stats" : "Show Stats")</span>
            </button>
            <button class="btn-header-action secondary" @onclick="LoadDataAsync" disabled="@loading" style="height: 38px;">
                @if (loading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                }
                <i class="bi bi-arrow-clockwise"></i> Refresh Queue
            </button>
            <button class="btn-header-action" @onclick="OpenDirectWalkinModal" style="height: 38px;">
                <i class="bi bi-plus-circle"></i> Direct Walk-in
            </button>

            @if (showStatsPopover)
            {
                <div class="stats-popup-card">
                    <div class="stats-popup-header">
                        <span>DASHBOARD SUMMARY STATS</span>
                        <button type="button" class="close-btn" @onclick="() => showStatsPopover = false">&times;</button>
                    </div>
                    <div class="stats-popup-list">
                        <div class="stat-popup-item blue">
                            <i class="bi bi-calendar3"></i>
                            <span class="label">Total Scheduled</span>
                            <span class="num">@filteredBookings.Count</span>
                        </div>
                        <div class="stat-popup-item orange">
                            <i class="bi bi-hourglass-split"></i>
                            <span class="label">Pending</span>
                            <span class="num">@filteredBookings.Count(b => opRegistrations.ContainsKey(b.booking_id) && opRegistrations[b.booking_id].visit_status == "WAITING")</span>
                        </div>
                        <div class="stat-popup-item green">
                            <i class="bi bi-check2-all"></i>
                            <span class="label">Confirmed/Served</span>
                            <span class="num">@filteredBookings.Count(b => opRegistrations.ContainsKey(b.booking_id) && (opRegistrations[b.booking_id].visit_status == "COMPLETED" || opRegistrations[b.booking_id].visit_status == "VISITED" || opRegistrations[b.booking_id].visit_status == "CONFIRMED"))</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (loading && allBookings.Count == 0)
    {
        <div style="text-align: center; padding: 4rem; color: #026aa7;">
            <div class="spinner-border" role="status" style="width: 3rem; height: 3rem; margin-bottom: 1rem;"></div>
            <p style="font-weight: 600;">Updating visiting logs...</p>
        </div>
    }
    else
    {

        <!-- FILTERS CARD -->
        <div class="filters-card">
            <div class="filters-row">
                <div class="filter-group">
                    <label>Filter Date</label>
                    <input type="date" class="filter-control" @bind="filterDate" @bind:after="ApplyFilters" />
                </div>
                <div class="filter-group">
                    <label>Doctor Specialist</label>
                    <select class="filter-control" @bind="filterDoctor" @bind:after="ApplyFilters">
                        <option value="0">All Specialists</option>
                        @foreach (var doc in doctors)
                        {
                            <option value="@doc.dcode">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname ?? "Specialist" : doc.name)</option>
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <label>Status</label>
                    <select class="filter-control" @bind="filterStatus" @bind:after="ApplyFilters">
                        <option value="ALL">All Statuses</option>
                        <option value="UNREGISTERED">Unregistered</option>
                        <option value="WAITING">Waiting</option>
                        <option value="IN_CONSULTATION">In Consultation</option>
                        <option value="COMPLETED">Completed</option>
                        <option value="CANCELLED">Cancelled</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Booking Type</label>
                    <select class="filter-control" @bind="filterType" @bind:after="ApplyFilters">
                        <option value="ALL">All Types</option>
                        <option value="ONLINE">ONLINE</option>
                        <option value="WALKIN">WALKIN</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Time Slot</label>
                    <select class="filter-control" @bind="filterSlot" @bind:after="ApplyFilters">
                        <option value="ALL">All Slots</option>
                        @foreach (var slot in GetDistinctSlots())
                        {
                            <option value="@slot.Value">@slot.Text</option>
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <label>Search Patient / Doctor</label>
                    <input type="text" class="filter-control" @bind="filterSearch" @bind:event="oninput" @bind:after="ApplyFilters" placeholder="e.g. CUST-1001, 2026..." />
                </div>
                <div style="display:flex; gap:0.5rem; align-self: flex-end;">
                    <button class="btn-header-action secondary" style="height:38px; padding:0 1rem;" @onclick="ClearFilters">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </button>
                </div>
            </div>
        </div>

        <div class="table-card">
            <div class="table-bar-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-lines-fill" style="color: #026aa7; font-size: 1.1rem;"></i>
                    <span style="font-weight: 700; color: #1e293b; font-size: 0.95rem;">Outpatient Queue</span>
                    <span class="kutty-user-badge alt" title="Total users listed in table">
                        <i class="bi bi-person-check-fill me-1"></i> @filteredBookings.Count @(filteredBookings.Count == 1 ? "User" : "Users")
                    </span>
                </div>
                @if (filteredBookings.Any())
                {
                    <span style="font-size: 0.8rem; color: #64748b; font-weight: 600;">
                        Page @currentPage of @((int)Math.Ceiling((double)filteredBookings.Count / pageSize))
                    </span>
                }
            </div>
            @if (filteredBookings.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <h4>No Appointments Found</h4>
                    <p>There are no appointments scheduled matching the selected filters.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="medico-table">
                        <thead>
                            <tr>
                                <th>Token No</th>
                                <th>Patient Name</th>
                                <th>OP No</th>
                                <th>Reg Type</th>
                                @if (labSetting.is_slot_required != false)
                                {
                                    <th>Time</th>
                                }
                                <th>Doctor</th>
                                <th>Status</th>
                                <th>Bill & Paid Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var pagedBookings = filteredBookings.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
                            }
                            @foreach (var booking in pagedBookings)
                            {
                                var isRegistered = opRegistrations.ContainsKey(booking.booking_id);
                                var opData = isRegistered ? opRegistrations[booking.booking_id] : null;

                                var isVip = booking.isvip == true || booking.is_vip == true || (isRegistered && opData != null && (opData.isvip == true || opData.is_vip == true));
                                var isIpReferred = booking.refer_to_ip == true || (isRegistered && opData != null && opData.refer_to_ip == true);

                                var displayType = booking.booking_type ?? "ONLINE";
                                if (booking.booking_type == "ONLINE" && booking.notes != null && booking.notes.StartsWith("[WALKIN]"))
                                {
                                    displayType = "WALKIN";
                                }

                                var rowClasses = new List<string>();
                                if (isVip) rowClasses.Add("vip-row");
                                if (isIpReferred) rowClasses.Add("ip-referred-row");
                                var rowClassStr = string.Join(" ", rowClasses);

                                <tr class="@rowClassStr">
                                    <td>
                                        @if (opData != null && !string.IsNullOrWhiteSpace(opData.token_no))
                                        {
                                            <span class="badge-op">@opData.token_no</span>
                                        }
                                        else if (booking.token_no > 0)
                                        {
                                            <span class="badge-op">@booking.token_no</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="margin-left: 14px; font-weight: 700;">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span style="font-weight: 700; color: #334155;">@(string.IsNullOrWhiteSpace(booking.patient_name) ? $"CUST-{booking.custid}" : booking.patient_name)</span>
                                        @if (booking.isvip == true || booking.is_vip == true)
                                        {
                                            <span class="vip-badge" style="background: #fffbeb; border: 1px solid #fde68a; color: #d97706; padding: 2px 6px; border-radius: 4px; font-weight: 700; font-size: 0.7rem; margin-left: 8px; display: inline-flex; align-items: center; gap: 2px;" title="VIP Patient">VIP</span>
                                        }
                                        @if (booking.refer_to_ip == true || (isRegistered && opData != null && opData.refer_to_ip == true))
                                        {
                                            <span class="ip-referred-badge ms-2" title="Referred to In-Patient">
                                                <i class="bi bi-hospital"></i> IP Referred
                                            </span>
                                        }
                                    </td>
                                    <td><span class="fw-bold text-primary">@(isRegistered && opData != null ? opData.op_no : "-")</span></td>
                                   
                                    <td>
                                        <span class="badge-type @displayType.ToLower()">@displayType</span>
                                    </td>
                                    @if (labSetting.is_slot_required != false)
                                    {
                                        <td>
                                            @if (booking.slot_start_time == default(TimeOnly) && booking.slot_end_time == default(TimeOnly))
                                            {
                                                <span class="text-muted" style="margin-left: 14px; font-weight: 700;">-</span>
                                            }
                                            else
                                            {
                                                 <div class="time-badge">@booking.slot_start_time.ToString("hh:mm tt") - @booking.slot_end_time.ToString("hh:mm tt")</div>
                                            }
                                        </td>
                                    }
                                    <td style="font-weight: 700; color: #334155;">
                                        @(isRegistered && opData != null && !string.IsNullOrWhiteSpace(opData.doctor_name) 
                                             ? opData.doctor_name 
                                             : $"Dr. {GetDoctorName(booking.dcode)}")
                                     </td>
                                     <td>
                                          @if (isRegistered && opData != null)
                                          {
                                              <select class="status-select @opData.visit_status.ToLower()" 
                                                      value="@opData.visit_status" 
                                                      @onchange="(e) => OnStatusSelectChanged(opData, e.Value?.ToString())">
                                                  <option value="WAITING">Waiting</option>
                                                  <option value="IN_CONSULTATION">In Consultation</option>
                                                  <option value="COMPLETED">Completed</option>
                                                  <option value="CANCELLED">Cancelled</option>
                                              </select>
                                          }
                                          else
                                          {
                                              <span class="status-badge pending">UNREGISTERED</span>
                                          }
                                      </td>
                                      <td>
                                          @if (isRegistered && opData != null)
                                          {
                                              <div class="bill-paid-status-container d-flex justify-content-between align-items-center w-100" style="display: flex !important; justify-content: space-between !important; align-items: center !important; width: 100% !important; min-width: 170px;">
                                                  @* --- BILLED / UNBILLED BADGE (LEFT) --- *@
                                                  <div class="status-left">
                                                      @if (opData.unbilled_status != true)
                                                      {
                                                          <span class="status-badge-pill unbilled" title="Unbilled Status">
                                                              <i class="bi bi-file-earmark-text-fill"></i> Unbilled
                                                          </span>
                                                      }
                                                      else
                                                      {
                                                          <span class="status-badge-pill billed" title="Billed Status">
                                                              <i class="bi bi-file-earmark-check-fill"></i> Billed
                                                          </span>
                                                      }
                                                  </div>

                                                  @* --- PAID / UNPAID BADGE (RIGHT) --- *@
                                                  <div class="status-right">
                                                      @if (opData.is_dressing)
                                                      {
                                                          <span class="btn-bill-status paid" style="background: #e0f2fe; color: #0369a1; border-color: #bae6fd;">
                                                              <i class="bi bi-bandaid-fill"></i> Dressing
                                                          </span>
                                                      }
                                                      else if (opData.paid_status == true)
                                                      {
                                                          <span class="btn-bill-status paid">
                                                              <i class="bi bi-check-circle-fill"></i> Paid
                                                          </span>
                                                      }
                                                      else if (opData.paid_status == false)
                                                      {
                                                          <span class="btn-bill-status unpaid">
                                                              <i class="bi bi-exclamation-circle-fill"></i> Unpaid
                                                          </span>
                                                      }
                                                      else
                                                      {
                                                          var opId = opData.op_id;
                                                          var patName = string.IsNullOrWhiteSpace(booking.patient_name) ? $"CUST-{booking.custid}" : booking.patient_name;
                                                          if (visitUnbilledCharges.TryGetValue(opId, out var charges))
                                                          {
                                                              var unpaidConsultation = charges.Where(c => c.billedstatus != true && (c.entrytype == null || c.entrytype.Equals("CONSULTATION", StringComparison.OrdinalIgnoreCase))).ToList();
                                                              var unpaid = charges.Where(c => c.billedstatus != true).ToList();
                                                              if (unpaidConsultation.Count == 0)
                                                              {
                                                                  <span class="btn-bill-status paid"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                                              }
                                                              else
                                                              {
                                                                  <button type="button" @onclick="() => ShowUnpaidDetails(unpaid, patName)" class="btn-bill-status unpaid">
                                                                      <i class="bi bi-exclamation-circle-fill"></i> Unpaid
                                                                  </button>
                                                              }
                                                          }
                                                          else
                                                          {
                                                              <span class="btn-bill-status unpaid"><i class="bi bi-exclamation-circle-fill"></i> Unpaid</span>
                                                          }
                                                      }
                                                  </div>
                                              </div>
                                          }
                                          else
                                          {
                                              if (booking.is_dressing)
                                              {
                                                  <span class="btn-bill-status paid" style="background: #e0f2fe; color: #0369a1; border-color: #bae6fd;"><i class="bi bi-bandaid-fill"></i> Dressing</span>
                                              }
                                              else
                                              {
                                                  <span class="text-muted">-</span>
                                              }
                                          }
                                      </td>
                                     <td style="text-align: center; position: relative;">
                                         <div class="actions-dropdown-container">
                                             @if (isRegistered && opData != null)
                                             {
                                                 <button type="button" 
                                                         class="btn-action-dots @(activeDropdownBookingId == booking.booking_id ? "active" : "")" 
                                                         @onclick="() => ToggleDropdown(booking.booking_id)" 
                                                         @onclick:stopPropagation 
                                                         title="Actions">
                                                     <i class="bi bi-three-dots-vertical"></i>
                                                 </button>

                                                 @if (activeDropdownBookingId == booking.booking_id)
                                                 {
                                                     <div class="actions-dropdown-menu" @onclick:stopPropagation>
                                                         <button type="button" class="action-icon-btn preview-bill" title="Preview Consolidated Bill" @onclick="() => { PreviewConsolidatedBill(opData); ToggleDropdown(booking.booking_id); }">
                                                             <i class="bi bi-printer-fill"></i>
                                                         </button>
                                                         <button type="button" class="action-icon-btn download-bill" title="Download Consolidated Bill PDF" @onclick="() => { DownloadConsolidatedBillPdf(opData); ToggleDropdown(booking.booking_id); }">
                                                             <i class="bi bi-file-earmark-pdf-fill"></i>
                                                         </button>
                                                         <button type="button" class="action-icon-btn vitals" title="Patient Vitals" @onclick="() => { OpenVitalsModal(opData); ToggleDropdown(booking.booking_id); }">
                                                             <i class="bi bi-heart-pulse-fill"></i>
                                                         </button>
                                                         <button type="button" class="action-icon-btn billing" title="Billing" @onclick="() => { NavigateToBilling(opData); ToggleDropdown(booking.booking_id); }">
                                                             <i class="bi bi-receipt-cutoff"></i>
                                                         </button>
                                                         <button type="button" class="action-icon-btn cancel" title="Cancel OP" @onclick="() => { OpenCancelOpModal(opData); ToggleDropdown(booking.booking_id); }">
                                                             <i class="bi bi-trash-fill"></i>
                                                         </button>
                                                     </div>
                                                 }
                                             }
                                             else
                                             {
                                                 <span class="text-muted">-</span>
                                             }
                                         </div>
                                     </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (filteredBookings.Any())
                {
                    var totalItems = filteredBookings.Count;
                    var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
                    if (totalPages > 1)
                    {
                        <div class="pagination-footer">
                            <div class="pagination-info">
                                Showing <span class="pagination-info-highlight">@(((currentPage - 1) * pageSize) + 1)</span> to <span class="pagination-info-highlight">@(Math.Min(currentPage * pageSize, totalItems))</span> of <span class="pagination-info-highlight">@totalItems</span> entries
                            </div>
                            <div class="pagination-btns">
                                <button class="page-btn" disabled="@(currentPage == 1)" @onclick="() => currentPage = 1" title="First Page">&laquo;</button>
                                <button class="page-btn" disabled="@(currentPage == 1)" @onclick="() => currentPage--" title="Previous Page">&lsaquo;</button>

                                @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                                {
                                    var pageNum = p;
                                    <button class="page-btn @(currentPage == pageNum ? "active" : "")" @onclick="() => currentPage = pageNum">@pageNum</button>
                                }

                                <button class="page-btn" disabled="@(currentPage == totalPages)" @onclick="() => currentPage++" title="Next Page">&rsaquo;</button>
                                <button class="page-btn" disabled="@(currentPage == totalPages)" @onclick="() => currentPage = totalPages" title="Last Page">&raquo;</button>
                            </div>
                        </div>
                    }
                }
            }
            @if (activeDropdownBookingId != null)
            {
                <div class="dropdown-backdrop" @onclick="CloseDropdown"></div>
            }
        </div>
    }
</div>

@if (showCancelOpModal && cancelOpData != null)
{
    <div class="modal-backdrop" @onclick="CloseCancelOpModal"></div>
    <div class="cancel-modal-wrapper">
        <div class="cancel-card">
            <!-- Modal Header -->
            <div class="cancel-card-header">
                <div class="cancel-header-left">
                    <div class="cancel-icon-bubble">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                    </div>
                    <div class="cancel-header-titles">
                        <h3>Cancel Outpatient Visit</h3>
                        <p>Confirm cancellation of patient OP registration</p>
                    </div>
                </div>
                <button type="button" class="cancel-close-btn" @onclick="CloseCancelOpModal" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="cancel-card-body">
                <!-- Patient & Visit Summary Box -->
                <div class="cancel-patient-summary">
                    <div class="patient-summary-main">
                        <div class="patient-avatar-badge">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="patient-name-block">
                            <span class="patient-name-text">@(string.IsNullOrWhiteSpace(cancelOpData.patient_name) ? $"CUST-{cancelOpData.custid}" : cancelOpData.patient_name)</span>
                            <span class="patient-sub-info">Patient ID: #@cancelOpData.custid</span>
                        </div>
                        @if (!string.IsNullOrEmpty(cancelOpData.token_no) && cancelOpData.token_no != "0")
                        {
                            <div class="token-pill-badge" title="Token Number">
                                <span class="token-pill-label">TOKEN</span>
                                <span class="token-pill-val">#@cancelOpData.token_no</span>
                            </div>
                        }
                    </div>

                    <div class="patient-summary-grid">
                        <div class="summary-chip">
                            <span class="summary-chip-label">OP NUMBER</span>
                            <span class="summary-chip-value op-no">@(string.IsNullOrWhiteSpace(cancelOpData.op_no) ? "-" : cancelOpData.op_no)</span>
                        </div>
                        <div class="summary-chip">
                            <span class="summary-chip-label">DOCTOR</span>
                            <span class="summary-chip-value">@(string.IsNullOrWhiteSpace(cancelOpData.doctor_name) ? $"Dr. {GetDoctorName(cancelOpData.dcode)}" : cancelOpData.doctor_name)</span>
                        </div>
                        <div class="summary-chip">
                            <span class="summary-chip-label">VISIT DATE</span>
                            <span class="summary-chip-value">@cancelOpData.visit_date.ToString("dd-MMM-yyyy")</span>
                        </div>
                    </div>

                    <div class="cancel-warning-banner">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>This visit will be marked as cancelled and removed from the active consultation queue.</span>
                    </div>
                </div>

                <!-- Cancellation Reason Input -->
                <div class="cancel-reason-section">
                    <div class="reason-section-header">
                        <label class="reason-label">
                            Reason for Cancellation <span class="required-star">*</span>
                        </label>
                        <span class="reason-hint">Select a quick reason or type below</span>
                    </div>

                    <!-- Quick Reason Chips -->
                    <div class="quick-reasons-row">
                        <button type="button" class="quick-reason-chip @(cancelReason == "Patient requested cancellation" ? "selected" : "")" @onclick='() => SetCancelReason("Patient requested cancellation")'>
                            Patient Request
                        </button>
                        <button type="button" class="quick-reason-chip @(cancelReason == "Doctor unavailable" ? "selected" : "")" @onclick='() => SetCancelReason("Doctor unavailable")'>
                            Doctor Unavailable
                        </button>
                        <button type="button" class="quick-reason-chip @(cancelReason == "Patient did not show up" ? "selected" : "")" @onclick='() => SetCancelReason("Patient did not show up")'>
                            No-Show
                        </button>
                        <button type="button" class="quick-reason-chip @(cancelReason == "Duplicate registration" ? "selected" : "")" @onclick='() => SetCancelReason("Duplicate registration")'>
                            Duplicate Entry
                        </button>
                        <button type="button" class="quick-reason-chip @(cancelReason == "Rescheduled to another date" ? "selected" : "")" @onclick='() => SetCancelReason("Rescheduled to another date")'>
                            Rescheduled
                        </button>
                    </div>

                    <div class="reason-textarea-container">
                        <textarea class="cancel-reason-textarea" @bind="cancelReason" rows="3" placeholder="Provide detailed cancellation reason..."></textarea>
                    </div>
                </div>

                <!-- API Payload Details (collapsible) -->
                <div class="cancel-payload-wrapper">
                    <details class="payload-details">
                        <summary class="payload-summary">
                            <i class="bi bi-code-slash"></i> View API Request Details
                        </summary>
                        <pre class="payload-code-block">@System.Text.Json.JsonSerializer.Serialize(new {
    op_id = cancelOpData.op_id,
    cancel_reason = cancelReason
}, new System.Text.Json.JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull })</pre>
                    </details>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="cancel-card-footer">
                <button type="button" class="btn-cancel-modal keep-btn" @onclick="CloseCancelOpModal">
                    <i class="bi bi-arrow-left"></i> Keep Visit
                </button>
                <button type="button" class="btn-cancel-modal confirm-btn" @onclick="SubmitCancelOpAsync" disabled="@saving">
                    @if (saving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Cancelling...</span>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill"></i>
                        <span>Confirm Cancellation</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (showRegisterModal && selectedBooking != null)
{
    <div class="modal-backdrop" @onclick="CloseRegisterModal"></div>
    <div class="glass-modal">
        <div class="modal-header">
            <h3>Register Outpatient</h3>
