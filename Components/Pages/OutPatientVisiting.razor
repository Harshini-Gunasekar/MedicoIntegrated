    private string GetDoctorName(int dcode)
    {
        var doc = doctors.FirstOrDefault(d => d.dcode == dcode);
        if (doc != null)
        {
            var name = string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name;
            if (!string.IsNullOrWhiteSpace(name))
            {
                return name.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? name : $"Dr. {name}";
            }
        }
        return $"Doctor #{dcode}";
    }

    private Dictionary<int, int> doctorAvailableSlotsMap = new();

    private async Task LoadDoctorSlotsStatusAsync()
    {
        doctorAvailableSlotsMap.Clear();
        if (doctors == null || !doctors.Any()) return;

        var dateOnly = DateOnly.FromDateTime(directWalkinDate);
        var tasks = doctors.Select(async doc =>
        {
            try
            {
                var slots = await BookingService.GetAvailableSlotsAsync(doc.dcode, dateOnly);
                if (slots == null || !slots.Any()) return (dcode: doc.dcode, count: 0);

                var totalAvail = slots.Sum(s => 
                    s.remaining_walkin > 0 ? s.remaining_walkin : 
                    (s.max_walkin > 0 ? Math.Max(0, s.max_walkin - s.walkin_count) : 
                    Math.Max(0, s.remaining_seats > 0 ? s.remaining_seats : (s.max_patients - s.patient_count)))
                );
                return (dcode: doc.dcode, count: totalAvail);
            }
            catch
            {
                return (dcode: doc.dcode, count: 0);
            }
        });

        var results = await Task.WhenAll(tasks);
        foreach (var r in results)
        {
            doctorAvailableSlotsMap[r.dcode] = r.count;
        }
        StateHasChanged();
    }

