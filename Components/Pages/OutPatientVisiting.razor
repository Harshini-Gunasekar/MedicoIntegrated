    private void StartEditUnpaid(UnbilledChargeSummary uc)
    {
        editingUnpaidId = uc.unbilledid ?? "";
        editUnpaidRequest = new UpdateUnbilledChargeRequest
        {
            unbilledid = uc.unbilledid ?? "",
            quantity = uc.quantity ?? 1,
            rate = uc.rate ?? 0,
            amount = uc.amount ?? 0,
            discount = uc.discount ?? 0,
            charityamount = uc.charityamount ?? 0
        };
        RecalculateEditUnpaidAmount();
    }

    private void CancelEditUnpaid()
    {
        editingUnpaidId = "";
        editUnpaidRequest = new();
    }

    private void RecalculateEditUnpaidAmount()
    {
        var qty = editUnpaidRequest.quantity ?? 1;
        var rate = editUnpaidRequest.rate ?? 0;
        var discount = editUnpaidRequest.discount ?? 0;
        var charity = editUnpaidRequest.charityamount ?? 0;
        editUnpaidRequest.amount = Math.Max(0, (qty * rate) - discount - charity);
    }

    private async Task SaveUnpaidChargeUpdateAsync()
    {
        if (string.IsNullOrWhiteSpace(editUnpaidRequest.unbilledid)) return;

        savingUnpaidUpdate = true;
        StateHasChanged();

        RecalculateEditUnpaidAmount();

        var payloadJson = System.Text.Json.JsonSerializer.Serialize(editUnpaidRequest, new System.Text.Json.JsonSerializerOptions 
        { 
            DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull,
            WriteIndented = true 
        });

        Console.WriteLine("=================================================");
        Console.WriteLine("[Doctor Patient List / Outpatient Visiting] Updating Record Payload:");
        Console.WriteLine(payloadJson);
        Console.WriteLine("=================================================");

        var success = await HmsBillingService.UpdateUnbilledChargeAsync(editUnpaidRequest);
        savingUnpaidUpdate = false;

        if (success)
        {
            ToastService.ShowSuccess("Charge updated successfully.");
            
            // Update in-memory item
            var existing = unpaidChargesList.FirstOrDefault(u => u.unbilledid == editUnpaidRequest.unbilledid);
            if (existing != null)
            {
                existing.quantity = editUnpaidRequest.quantity;
                existing.rate = editUnpaidRequest.rate;
                existing.discount = editUnpaidRequest.discount;
                existing.charityamount = editUnpaidRequest.charityamount;
                existing.amount = editUnpaidRequest.amount;
            }

            // Also update visitUnbilledCharges dictionary so the UI reflects immediately
            foreach (var kvp in visitUnbilledCharges)
            {
                var match = kvp.Value.FirstOrDefault(u => u.unbilledid == editUnpaidRequest.unbilledid);
                if (match != null)
                {
                    match.quantity = editUnpaidRequest.quantity;
                    match.rate = editUnpaidRequest.rate;
                    match.discount = editUnpaidRequest.discount;
                    match.charityamount = editUnpaidRequest.charityamount;
                    match.amount = editUnpaidRequest.amount;
                }
            }

            editingUnpaidId = "";
            editUnpaidRequest = new();
            await LoadDataAsync();
        }
        else
        {
            ToastService.ShowError("Failed to update charge.");
        }
        StateHasChanged();
    }

