    private async Task SubmitRegistrationAsync()
    {
        if (selectedBooking == null) return;
        
        saving = true;
        try
        {
            var jsonOptions = new System.Text.Json.JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull };
            var jsonPayload = System.Text.Json.JsonSerializer.Serialize(newOpRequest, jsonOptions);
