                        <div class="clinical-row">
                            <label>Abdomen</label>
                            <div class="clinical-input">
                                <input type="text" class="filter-control" @bind="vitalsRequest.abdomen" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
       
        
        <div class="modal-footer" style="justify-content: space-between; align-items: center;">
            <div class="d-flex align-items-center" style="gap: 0.5rem;">
                <label style="font-weight: 700; color: #475569; margin: 0; font-size: 0.75rem; text-transform: uppercase;">Entered By:</label>
