@page "/booking/outpatient"
@using Booking.Models
@using Booking.Services
@inject AppointmentBookingService BookingService
@inject DoctorService DoctorService
@inject ToastService ToastService
@inject NavigationManager NavigationManager

<PageTitle>Outpatient Visiting</PageTitle>

<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
</div>

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <div class="dashboard-title">
            <h1>Outpatient Visiting Dashboard</h1>
            <p>Manage today's outpatient registrations, update consultation queue status, and log vitals.</p>
        </div>
        <div>
            <button class="btn-header-action" @onclick="LoadDataAsync" disabled="@loading">
                @if (loading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                }
                <i class="bi bi-arrow-clockwise"></i> Refresh List
            </button>
        </div>
    </div>

    @if (loading && allBookings.Count == 0)
    {
        <div style="text-align: center; padding: 4rem; color: #026aa7;">
            <div class="spinner-border" role="status" style="width: 3rem; height: 3rem; margin-bottom: 1rem;"></div>
            <p style="font-weight: 600;">Updating visiting logs...</p>
        </div>
    }
    else
    {
        <!-- Stats Cards Grid -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="bi bi-calendar3"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@filteredBookings.Count</span>
                    <span class="stat-label">Total Scheduled</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@filteredBookings.Count(b => opRegistrations.ContainsKey(b.booking_id))</span>
                    <span class="stat-label">Registered OP</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@filteredBookings.Count(b => opRegistrations.ContainsKey(b.booking_id) && opRegistrations[b.booking_id].visit_status == "WAITING")</span>
                    <span class="stat-label">Waiting In Queue</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon purple">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@filteredBookings.Count(b => opRegistrations.ContainsKey(b.booking_id) && opRegistrations[b.booking_id].visit_status == "COMPLETED")</span>
                    <span class="stat-label">Completed Visits</span>
                </div>
            </div>
        </div>

        <!-- FILTERS CARD -->
        <div class="filters-card">
            <div class="filters-row">
                <div class="filter-group">
                    <label>Filter Date</label>
                    <input type="date" class="filter-control" @bind="filterDate" @bind:after="ApplyFilters" />
                </div>
                <div class="filter-group">
                    <label>Doctor Specialist</label>
                    <select class="filter-control" @bind="filterDoctor" @bind:after="ApplyFilters">
                        <option value="0">All Specialists</option>
                        @foreach (var doc in doctors)
                        {
                            <option value="@doc.dcode">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname ?? "Specialist" : doc.name)</option>
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <label>Status</label>
                    <select class="filter-control" @bind="filterStatus" @bind:after="ApplyFilters">
                        <option value="ALL">All Statuses</option>
                        <option value="UNREGISTERED">Unregistered</option>
                        <option value="WAITING">Waiting</option>
                        <option value="IN_CONSULTATION">In Consultation</option>
                        <option value="COMPLETED">Completed</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Booking Type</label>
                    <select class="filter-control" @bind="filterType" @bind:after="ApplyFilters">
                        <option value="ALL">All Types</option>
                        <option value="ONLINE">ONLINE</option>
                        <option value="WALKIN">WALKIN</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Search Patient / Doctor</label>
                    <input type="text" class="filter-control" @bind="filterSearch" @bind:event="oninput" @bind:after="ApplyFilters" placeholder="e.g. CUST-1001, 2026..." />
                </div>
                <div style="display:flex; gap:0.5rem; align-self: flex-end;">
                    <button class="btn-header-action secondary" style="height:38px; padding:0 1rem;" @onclick="ClearFilters">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </button>
                </div>
            </div>
        </div>

        <div class="table-card">
            @if (filteredBookings.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <h4>No Appointments Found</h4>
                    <p>There are no appointments scheduled matching the selected filters.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="medico-table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Booking No</th>
                                <th>OP No</th>
                                <th>Token No</th>
                                <th>Reg Type</th>
                                <th>Patient ID</th>
                                <th>Doctor</th>
                                <th>Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in filteredBookings)
                            {
                                var isRegistered = opRegistrations.ContainsKey(booking.booking_id);
                                var opData = isRegistered ? opRegistrations[booking.booking_id] : null;

                                var displayType = booking.booking_type;
                                if (booking.booking_type == "ONLINE" && booking.notes != null && booking.notes.StartsWith("[WALKIN]"))
                                {
                                    displayType = "WALKIN";
                                }

                                <tr>
                                    <td>
                                        <div class="time-badge">@booking.slot_start_time.ToString("HH:mm")</div>
                                    </td>
                                    <td style="font-weight: 800; color: #026aa7;">#@booking.booking_no</td>
                                    <td><span class="fw-bold text-primary">@(isRegistered && opData != null ? opData.op_no : "-")</span></td>
                                    <td><span class="badge-op">@(booking.token_no > 0 ? booking.token_no.ToString() : "-")</span></td>
                                    <td>
                                        <span class="badge-type @displayType.ToLower()">@displayType</span>
                                    </td>
                                    <td><span style="font-family: monospace; font-weight: 700;">CUST-@booking.custid</span></td>
                                    <td style="font-weight: 700; color: #334155;">Dr. @GetDoctorName(booking.dcode)</td>
                                    <td>
                                        @if (isRegistered && opData != null)
                                        {
                                            <select class="status-select @opData.visit_status.ToLower()" 
                                                    value="@opData.visit_status" 
                                                    @onchange="(e) => UpdateStatusAsync(opData, e.Value?.ToString())">
                                                <option value="WAITING">Waiting</option>
                                                <option value="IN_CONSULTATION">In Consultation</option>
                                                <option value="COMPLETED">Completed</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <span class="status-badge pending">UNREGISTERED</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group-actions" style="justify-content: center;">
                                            @if (!isRegistered)
                                            {
                                                <button class="btn-action register" @onclick="() => OpenRegisterModal(booking)" title="Register Patient OP">
                                                    <i class="bi bi-person-plus-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn-action vitals" @onclick="() => OpenVitalsModal(opData!)" title="Patient Vitals">
                                                    <i class="bi bi-heart-pulse-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@if (showRegisterModal && selectedBooking != null)
{
    <div class="modal-backdrop" @onclick="CloseRegisterModal"></div>
    <div class="glass-modal">
        <div class="modal-header">
            <h3>Register Outpatient</h3>
            <button class="close-btn" @onclick="CloseRegisterModal">×</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Booking No</label>
                <input type="text" class="filter-control" value="@selectedBooking.booking_no" disabled />
            </div>
            <div class="form-group">
                <label>Visit Type</label>
                <select class="filter-control" @bind="newOpRequest.visit_type">
                    <option value="NEWVISIT">New Visit</option>
                    <option value="FOLLOWUP">Follow-up</option>
                </select>
            </div>
            <div class="form-group">
                <label>Notes</label>
                <textarea class="filter-control" @bind="newOpRequest.notes" placeholder="Enter arrival notes..."></textarea>
            </div>
            <div class="form-group mt-3">
                <details class="payload-details">
                    <summary class="text-muted small fw-bold" style="cursor:pointer; outline:none; user-select:none;">
                        <i class="bi bi-code-slash"></i> View JSON Payload Preview
                    </summary>
                    <pre class="bg-dark text-light p-2 rounded mt-2 small" style="max-height: 200px; overflow-y: auto; font-family: monospace; font-size: 0.8rem; text-align: left;">@System.Text.Json.JsonSerializer.Serialize(new {
    booking_id = newOpRequest.booking_id,
    booking_no = newOpRequest.booking_no,
    slot_detail_id = newOpRequest.slot_detail_id,
    custid = newOpRequest.custid,
    dcode = newOpRequest.dcode,
    department_code = newOpRequest.department_code,
    visit_type = newOpRequest.visit_type,
    reg_type = newOpRequest.reg_type,
    notes = newOpRequest.notes
}, new System.Text.Json.JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull })</pre>
                </details>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-modal cancel" @onclick="CloseRegisterModal">Cancel</button>
            <button class="btn-modal confirm" @onclick="SubmitRegistrationAsync" disabled="@saving">
                @if (saving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                Register
            </button>
        </div>
    </div>
}

@if (showVitalsModal && currentOp != null)
{
    <div class="modal-backdrop" @onclick="CloseVitalsModal"></div>
    <div class="glass-modal large-modal">
        <div class="modal-header">
            <h3>Patient Vitals</h3>
            <span class="badge-op">@currentOp.op_no</span>
            <button class="close-btn" @onclick="CloseVitalsModal">×</button>
        </div>
        <div class="modal-body">
            <div class="vitals-grid">
                <div class="form-group">
                    <label>Height (cm)</label>
                    <input type="number" class="filter-control" @bind="vitalsRequest.height_cm" />
                </div>
                <div class="form-group">
                    <label>Weight (kg)</label>
                    <input type="number" class="filter-control" @bind="vitalsRequest.weight_kg" />
                </div>
                <div class="form-group">
                    <label>Temperature (°F)</label>
                    <input type="number" class="filter-control" @bind="vitalsRequest.temperature_f" />
                </div>
                <div class="form-group">
                    <label>Pulse Rate</label>
                    <input type="number" class="filter-control" @bind="vitalsRequest.pulse_rate" />
                </div>
                <div class="form-group">
                    <label>BP Systolic</label>
                    <input type="number" class="filter-control" @bind="vitalsRequest.bp_systolic" />
                </div>
                <div class="form-group">
                    <label>BP Diastolic</label>
                    <input type="number" class="filter-control" @bind="vitalsRequest.bp_diastolic" />
                </div>
                <div class="form-group">
                    <label>SpO2 (%)</label>
                    <input type="number" class="filter-control" @bind="vitalsRequest.spo2" />
                </div>
                <div class="form-group">
                    <label>Sugar Level</label>
                    <input type="number" class="filter-control" @bind="vitalsRequest.sugar_level" />
                </div>
                <div class="form-group">
                    <label>Pain Scale (1-10)</label>
                    <input type="number" class="filter-control" @bind="vitalsRequest.pain_scale" min="1" max="10" />
                </div>
            </div>
            <div class="form-group mt-3">
                <label>Allergy Notes</label>
                <textarea class="filter-control" @bind="vitalsRequest.allergy_notes" rows="2"></textarea>
            </div>
            <div class="form-group">
                <label>Entered By</label>
                <input type="text" class="filter-control" @bind="vitalsRequest.entered_by" placeholder="Nurse name" />
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-modal cancel" @onclick="CloseVitalsModal">Cancel</button>
            <button class="btn-modal confirm" @onclick="SubmitVitalsAsync" disabled="@saving">
                @if (saving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                Save Vitals
            </button>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private bool saving = false;

    private List<AppointmentBookingModel> allBookings = new();
    private Dictionary<Guid, OPRegistrationModel.OpRegistrationModel> opRegistrations = new();
    private List<DoctorMasterModel> doctors = new();

    // Filter states
    private DateTime? filterDate = DateTime.Today;
    private string filterStatus = "ALL";
    private int filterDoctor = 0;
    private string filterType = "ALL";
    private string filterSearch = string.Empty;

    // Filtered bookings list to show in UI
    private List<AppointmentBookingModel> filteredBookings = new();

    private void ClearFilters()
    {
        filterDate = DateTime.Today;
        filterDoctor = 0;
        filterStatus = "ALL";
        filterType = "ALL";
        filterSearch = string.Empty;
        ApplyFilters();
    }

    // Modals state
    private bool showRegisterModal = false;
    private AppointmentBookingModel? selectedBooking;
    private OPRegistrationModel.OpRegistrationModel newOpRequest = new();

    private bool showVitalsModal = false;
    private OPRegistrationModel.OpRegistrationModel? currentOp;
    private OPRegistrationModel.PatientVitalsModel vitalsRequest = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctorsAsync();
        await LoadDataAsync();
    }

    private async Task LoadDoctorsAsync()
    {
        try
        {
            var raw = await DoctorService.GetDoctorsAsync();
            doctors = raw.Where(d => !d.deleted).OrderBy(d => string.IsNullOrWhiteSpace(d.name) ? d.doctorfullname : d.name).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctors: {ex.Message}");
        }
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        try
        {
            // 1. Fetch bookings
            var bookings = await BookingService.GetAllBookingsAsync();
            allBookings = bookings.Where(b => !b.isdeleted).ToList();
            
            // 2. Fetch OP registrations from the backend API
            var regs = await BookingService.GetAllOpRegistrationsAsync();
            opRegistrations = new Dictionary<Guid, OPRegistrationModel.OpRegistrationModel>();
            
            foreach (var r in regs)
            {
                if (r.booking_id.HasValue && r.booking_id.Value != Guid.Empty)
                {
                    opRegistrations[r.booking_id.Value] = r;
                }
                else if (r.slot_detail_id.HasValue && r.slot_detail_id.Value != Guid.Empty)
                {
                    // Fallback matching by slot_detail_id and custid
                    var match = allBookings.FirstOrDefault(b => b.slot_detail_id == r.slot_detail_id.Value && b.custid == r.custid);
                    if (match != null)
                    {
                        opRegistrations[match.booking_id] = r;
                    }
                }
            }

            ApplyFilters();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading data: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyFilters()
    {
        var query = allBookings.AsQueryable();

        // 1. Date Filter
        if (filterDate.HasValue)
        {
            var dateOnly = DateOnly.FromDateTime(filterDate.Value);
            query = query.Where(b => b.appointment_date == dateOnly);
        }

        // 2. Doctor Filter
        if (filterDoctor > 0)
        {
            query = query.Where(b => b.dcode == filterDoctor);
        }

        // 3. Search Filter (by Booking No, Patient ID or Doctor ID)
        if (!string.IsNullOrWhiteSpace(filterSearch))
        {
            var searchLower = filterSearch.Trim().ToLower();
            query = query.Where(b => 
                (b.booking_no != null && b.booking_no.ToLower().Contains(searchLower)) ||
                ("cust-" + b.custid).ToLower().Contains(searchLower) ||
                b.custid.ToString().Contains(searchLower) ||
                ("doc-" + b.dcode).ToLower().Contains(searchLower) ||
                b.dcode.ToString().Contains(searchLower)
            );
        }

        var list = query.OrderBy(b => b.slot_start_time).ToList();

        // 4. Status Filter
        if (filterStatus != "ALL")
        {
            if (filterStatus == "UNREGISTERED")
            {
                list = list.Where(b => !opRegistrations.ContainsKey(b.booking_id)).ToList();
            }
            else
            {
                list = list.Where(b => 
                    opRegistrations.ContainsKey(b.booking_id) && 
                    opRegistrations[b.booking_id].visit_status.Equals(filterStatus, StringComparison.OrdinalIgnoreCase)
                ).ToList();
            }
        }

        // 5. Booking Type Filter
        if (filterType != "ALL")
        {
            if (filterType == "ONLINE")
            {
                list = list.Where(b => b.booking_type == "ONLINE" && !(b.notes != null && b.notes.StartsWith("[WALKIN]"))).ToList();
            }
            else if (filterType == "WALKIN")
            {
                list = list.Where(b => b.booking_type == "WALKIN" || (b.notes != null && b.notes.StartsWith("[WALKIN]"))).ToList();
            }
        }

        filteredBookings = list;
    }

    private void OpenRegisterModal(AppointmentBookingModel booking)
    {
        selectedBooking = booking;
        
        string regType = (booking.booking_type == "WALKIN" || (booking.booking_type == "ONLINE" && booking.notes != null && booking.notes.StartsWith("[WALKIN]"))) ? "WALKIN" : "ONLINE";
        
        newOpRequest = new OPRegistrationModel.OpRegistrationModel
        {
            booking_id = regType == "ONLINE" ? booking.booking_id : null,
            booking_no = regType == "ONLINE" ? booking.booking_no : null,
            slot_detail_id = regType == "WALKIN" ? booking.slot_detail_id : null,
            custid = booking.custid,
            dcode = booking.dcode,
            department_code = 3,
            visit_type = "NEWVISIT",
            reg_type = regType,
            notes = "Patient arrived",
            visit_date = DateOnly.FromDateTime(DateTime.Today)
        };
        showRegisterModal = true;
    }

    private void CloseRegisterModal()
    {
        showRegisterModal = false;
        selectedBooking = null;
    }

    private async Task SubmitRegistrationAsync()
    {
        if (selectedBooking == null) return;
        
        saving = true;
        try
        {
            var result = await BookingService.RegisterOpAsync(newOpRequest);
            if (result != null && result.StartsWith("Success"))
            {
                ToastService.ShowSuccess("Outpatient registered successfully!");
                CloseRegisterModal();
                await LoadDataAsync();
            }
            else
            {
                ToastService.ShowError($"Failed to register outpatient: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Registration error: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private void OpenVitalsModal(OPRegistrationModel.OpRegistrationModel opData)
    {
        currentOp = opData;
        vitalsRequest = new OPRegistrationModel.PatientVitalsModel
        {
            op_id = opData.op_id,
            op_no = opData.op_no,
            custid = opData.custid,
            dcode = opData.dcode
        };
        showVitalsModal = true;
    }

    private void CloseVitalsModal()
    {
        showVitalsModal = false;
        currentOp = null;
    }

    private async Task SubmitVitalsAsync()
    {
        saving = true;
        try
        {
            var success = await BookingService.SaveOpVitalsAsync(vitalsRequest);
            if (success)
            {
                ToastService.ShowSuccess("Vitals saved successfully!");
                CloseVitalsModal();
                await LoadDataAsync();
            }
            else
            {
                ToastService.ShowError("Failed to save vitals.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Vitals saving error: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task UpdateStatusAsync(OPRegistrationModel.OpRegistrationModel opData, string? newStatus)
    {
        if (string.IsNullOrEmpty(newStatus)) return;
        
        var success = await BookingService.UpdateOpStatusAsync(opData.op_id, newStatus);
        if (success)
        {
            opData.visit_status = newStatus;
            ToastService.ShowSuccess($"Status updated to {newStatus}");
            await LoadDataAsync();
        }
        else
        {
            ToastService.ShowError("Failed to update status.");
            StateHasChanged();
        }
    }

    private string GetDoctorName(int dcode)
    {
        var doc = doctors.FirstOrDefault(d => d.dcode == dcode);
        if (doc != null)
        {
            return string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname ?? $"DOC-{dcode}" : doc.name;
        }
        return $"DOC-{dcode}";
    }
}
