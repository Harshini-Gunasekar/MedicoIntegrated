    private async Task LoadDoctorPhoto(int dcode, string? fileName, string? doctorTenantCode)
    {
        if (string.IsNullOrEmpty(fileName)) return;
        if (doctorImagesBase64.ContainsKey(dcode)) return;

        try
        {
            string key = fileName;
            if (!fileName.Contains("/"))
            {
                string tc = string.IsNullOrEmpty(doctorTenantCode) ? TenantCode : doctorTenantCode;
                if (string.IsNullOrEmpty(tc)) tc = "TEN1011";
                key = $"medico/{tc}/doctors/{dcode}/{fileName}";
            }

            var base64 = await DoctorService.DownloadFileAsBase64Async(key);
            if (!string.IsNullOrEmpty(base64))
            {
                doctorImagesBase64[dcode] = base64;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error downloading photo for doctor {dcode}: {ex.Message}");
        }
    }

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                selectedPhotoName = file.Name;
                currentDoctor.doctorimage = file.Name;

                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                selectedPhotoBytes = ms.ToArray();
                selectedPhoto = file;
                previewPhotoBase64 = Convert.ToBase64String(selectedPhotoBytes);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error reading doctor image: {ex.Message}");
        }
        StateHasChanged();
    }

    private void RemovePhoto()
    {
        ResetPhotoState();
        currentDoctor.doctorimage = null;
        if (currentDoctor.dcode != 0)
        {
            doctorImagesBase64.Remove(currentDoctor.dcode);
        }
        StateHasChanged();
    }

    private void ResetPhotoState()
    {
        selectedPhoto = null;
        selectedPhotoBytes = null;
        selectedPhotoName = null;
        previewPhotoBase64 = null;
    }

