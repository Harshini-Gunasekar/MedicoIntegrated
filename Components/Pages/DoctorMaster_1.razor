    private async Task DeleteDoctor(string dcode) { 
        int.TryParse(dcode, out int dc);
        if (dc > 0)
        {
            try
            {
                var profile = await DoctorProfileService.GetProfileAsync(dc);
                if (profile != null && profile.pcode > 0)
                {
                    await DoctorProfileService.DeleteProfileAsync(profile.pcode);
                }
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error deleting associated doctor profile: {ex.Message}");
            }
        }

        if (await DoctorService.DeleteDoctorAsync(dcode)) { 
            if (dc > 0)
            {
                doctorImagesBase64.Remove(dc);
            }
            await LoadDoctors(); 
            ToastService.ShowSuccess("Doctor deleted successfully!");
            showForm = false;
            ResetPhotoState();
        } else {
            ToastService.ShowError("Error deleting doctor.");
        }
    }

    private string GetInitials(DoctorMasterModel doctor)
    {
        string? name = string.IsNullOrWhiteSpace(doctor.name) ? doctor.doctorfullname : doctor.name;
        if (string.IsNullOrEmpty(name)) return "?";
        return name[0].ToString().ToUpper();
    }
