                    <InputFile OnChange="OnProfileBannerSelected" accept=".jpg,.jpeg,.png,.webp" class="form-control" style="background: #f8fafc; padding: 0.5rem;" />
                    @if (!string.IsNullOrEmpty(currentProfile.banner_image))
