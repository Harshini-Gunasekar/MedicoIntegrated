                    <label style="font-size: 0.8rem; font-weight: 600; color: #64748b;">Experience (Years)</label>
                    <input type="number" step="0.1" class="form-control" @bind="currentProfile.experience_years" style="background: #f8fafc; padding: 0.7rem 1rem;" />
                </div>
