                        <div style="font-size: 0.75rem; color: #10b981; margin-top: 2px;">Current image: @currentProfile.banner_image</div>
                    }
                </div>
                <div style="display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 0.4rem;">
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.8rem; font-weight: 600; color: #64748b;">
                        <input type="checkbox" @bind="currentProfile.is_published" style="width: 16px; height: 16px; accent-color: #4f46e5;" />
                        Is Published
                    </label>
                </div>
            </div>
        </div>
        <div class="modal-footer" style="padding: 1.25rem 1.75rem; border-top: 1px solid #f1f5f9; display: flex; justify-content: flex-end; gap: 1rem;">
            @if(currentProfile.pcode > 0)
            {
                <button type="button" class="btn-delete" style="margin-right: auto;" @onclick="DeleteDoctorProfile">Delete Profile</button>
            }
            <button type="button" class="btn-delete-text" style="font-size: 0.9rem; font-weight: 600; padding: 0.5rem 1rem;" @onclick="CloseProfileModal">Cancel</button>
            <button type="button" class="btn-save-new" style="padding: 0.6rem 1.5rem; min-width: 100px; font-size: 0.9rem; font-weight: 600; border-radius: 8px;" @onclick="SaveDoctorProfile">
                Save Profile
            </button>
        </div>
    </div>
}

