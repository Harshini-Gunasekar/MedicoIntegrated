@page "/doctors"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Booking.Models
@using Medico_Backend.Model
@inject DoctorService DoctorService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject Booking.Services.ToastService ToastService
@inject Booking.Services.DoctorSpecialtyMasterService DoctorSpecialtyMasterService
@inject Booking.Services.FeetypeService FeetypeService
@inject Booking.Services.CountryMasterService CountryMasterService
@inject Booking.Services.StateMasterService StateMasterService
@inject Booking.Services.CityMasterService CityMasterService
@inject Booking.Services.AreaMasterService AreaMasterService
@inject Booking.Services.ReimbursementCompanyMasterService ReimbursementService
@inject Booking.Services.DoctorProfileService DoctorProfileService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@implements IDisposable


@if (showForm)
{
    <div class="modal-overlay" @onclick="CancelEdit">
        <div class="modal-form-card" @onclick:stopPropagation>
            <div class="modal-header-bar">
                <h3>@(currentDoctor.dcode != 0 ? "Edit Doctor" : "New Doctor Entry")</h3>
                <button type="button" class="modal-close-btn" @onclick="CancelEdit" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>

            <EditForm Model="currentDoctor" OnSubmit="HandleSubmit" class="modal-form-container">
            <DataAnnotationsValidator />

            <div class="modal-body">
                <!-- GENERAL INFORMATION -->
                <div class="form-section">
                    <h4 class="section-title">
                        <span class="section-icon"><i class="bi bi-person-fill"></i></span>
                        GENERAL INFORMATION
                    </h4>
                    <div style="display: flex; gap: 2rem; align-items: flex-start; margin-bottom: 1rem;">
                        <!-- Doctor Image Upload (Left Side) -->
                        <div style="width: 140px; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; flex-shrink: 0;">
                            <label style="font-size: 0.8rem; font-weight: 600; color: #64748b; align-self: flex-start;">Doctor Photo</label>
                            <div class="image-upload-container @(selectedPhotoBytes != null || !string.IsNullOrEmpty(currentDoctor.doctorimage) ? "has-image" : "")" 
                                 style="width: 120px; height: 120px; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative;">
                                
                                @if (!string.IsNullOrEmpty(previewPhotoBase64))
                                {
                                    <img src="data:image/jpeg;base64,@previewPhotoBase64" class="image-upload-preview" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else if (!string.IsNullOrEmpty(currentDoctor.doctorimage))
                                {
                                    _ = LoadDoctorPhoto(currentDoctor.dcode, currentDoctor.doctorimage, currentDoctor.tenant_code);
                                    if (doctorImagesBase64.TryGetValue(currentDoctor.dcode, out var base64Str))
                                    {
                                        <img src="data:image/jpeg;base64,@base64Str" class="image-upload-preview" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="image-upload-placeholder">
                                            <i class="bi bi-person-bounding-box" style="font-size: 2rem; color: #cbd5e1;"></i>
                                            <span class="image-upload-label" style="font-size: 0.7rem;">Loading...</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="image-upload-placeholder">
                                        <i class="bi bi-camera-fill" style="font-size: 2rem; color: #94a3b8;"></i>
                                        <span class="image-upload-label" style="font-size: 0.7rem; text-align: center; line-height: 1.1;">Upload Photo</span>
                                    </div>
                                }
                                <InputFile OnChange="OnPhotoSelected" accept=".jpg,.jpeg,.png,.webp" class="image-upload-input" style="position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer;" />
                            </div>
                            @if (selectedPhotoBytes != null || !string.IsNullOrEmpty(currentDoctor.doctorimage))
                            {
                                <button type="button" class="btn-delete-text" style="font-size: 0.75rem; padding: 2px 8px; color: #ef4444; border: none; background: transparent; cursor: pointer;" @onclick="RemovePhoto">Remove</button>
                            }
                        </div>

                        <!-- Fields (Right Side) -->
                        <div class="form-grid" style="flex: 1;">
                            <div class="form-col">
                                <label>Prefix</label>
                                <InputSelect @bind-Value="currentDoctor.nametitle" class="form-control">
                                    <option value="Dr">Dr</option>
                                    <option value="Mr">Mr</option>
                                    <option value="Ms">Ms</option>
                                    <option value="Miss">Miss</option>
                                    <option value="Ms">Ms</option>
                                    <option value="Master">Master</option>
                                    <option value="Baby">Baby</option>
                                    <option value="Prof">Prof</option>
                                </InputSelect>
                            </div>
                            <div class="form-col span-3">
                                <label>First Name <span style="color: #ef4444;">*</span></label>
                                <InputText @bind-Value="currentDoctor.name" class="form-control" placeholder="e.g. Sarah" />
                                <ValidationMessage For="@(() => currentDoctor.name)" style="color: #ef4444; font-size: 0.75rem; margin-top: 0.25rem;" />
                            </div>
                            <div class="form-col span-1">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <label style="margin-bottom: 0;">Specialty *</label>
                                    <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick="OpenSpecialtyModal">
                                        <i class="bi bi-plus-circle-fill"></i> Add New
                                    </button>
                                </div>
                                <InputSelect @bind-Value="currentDoctor.spcode" class="form-control" TValue="int?">
                                    <option value="0">Select Specialty</option>
                                    @foreach (var sp in specialties)
                                    {
                                        <option value="@sp.spcode">@sp.name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="form-col span-2">
                                <label>Qualification</label>
                                <InputText @bind-Value="currentDoctor.qualification" class="form-control" placeholder="e.g. MBBS, MD, FRCP" />
                            </div>
                            <div class="form-col span-1">
                                <label>Type</label>
                                <InputText @bind-Value="currentDoctor.entrytype" class="form-control" placeholder="Type" />
                            </div>
                            <div class="form-col span-1">
                                <label>Portal Password</label>
                                <InputText @bind-Value="currentDoctor.onlinepassword" class="form-control" type="password" placeholder="••••••" />
                            </div>
                            <div class="form-col span-1">
                                <label>OP Charge</label>
                                <InputNumber @bind-Value="currentDoctor.opcharge" class="form-control" placeholder="0.00" />
                            </div>
                            <div class="form-col">
                                <label>Regular Status</label>
                                <div class="pay-type-toggle">
                                    <button type="button" class="toggle-btn @(currentDoctor.isregular == true ? "active" : "")" @onclick="() => SetRegularStatus(true)">Regular</button>
                                    <button type="button" class="toggle-btn @(currentDoctor.isregular != true ? "active" : "")" @onclick="() => SetRegularStatus(false)">Not Regular</button>
                                </div>
                            </div>
                            @if (currentDoctor.isregular != true)
                            {
                                <div class="form-col span-1">
                                    <label>Off Hours Fee</label>
                                    <InputNumber @bind-Value="currentDoctor.offhoursconsultationfee" class="form-control" placeholder="0.00" />
                                </div>
                            }
                            <div class="form-col" style="justify-content: center; align-items: flex-start; height: 100%; padding-top: 1.5rem;">
                                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.8rem; font-weight: 600; color: #64748b;">
                                    <input type="checkbox" @bind="currentDoctor.isreferral" style="width: 16px; height: 16px; accent-color: #4f46e5;" />
                                    Is Referral
                                </label>
                            </div>
                            <div class="form-col" style="justify-content: center; align-items: flex-start; height: 100%; padding-top: 1.5rem;">
                                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.8rem; font-weight: 600; color: #64748b;">
                                    <input type="checkbox" @bind="currentDoctor.isconsultant" style="width: 16px; height: 16px; accent-color: #4f46e5;" />
                                    Is Consultant
                                </label>
                            </div>
                            <div class="form-col" style="justify-content: center; align-items: flex-start; height: 100%; padding-top: 1.5rem;">
                                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.8rem; font-weight: 600; color: #64748b;">
                                    <input type="checkbox" @bind="currentDoctor.showmobile" style="width: 16px; height: 16px; accent-color: #4f46e5;" />
                                    Show Mobile No.
                                </label>
                            </div>
                            <div class="form-col span-4">
                                <label>Reference</label>
                                <InputText @bind-Value="currentDoctor.reference" class="form-control" placeholder="Hospital or clinic name" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BILLING & ACCOUNTS -->
                <div class="form-section">
                    <h4 class="section-title">
                        <span class="section-icon"><i class="bi bi-credit-card-2-back-fill"></i></span>
                        BILLING & ACCOUNTS
                    </h4>
                    <div class="form-grid">
                        <div class="form-col">
                            <label>Pay Type *</label>
                            <div class="pay-type-toggle">
                                <button type="button" class="toggle-btn @(currentDoctor.entrytype == "CASH" || string.IsNullOrEmpty(currentDoctor.entrytype) ? "active" : "")" @onclick='() => SelectPayType("CASH")'>Cash</button>
                                <button type="button" class="toggle-btn @(currentDoctor.entrytype == "CREDIT" ? "active" : "")" @onclick='() => SelectPayType("CREDIT")'>Credit</button>
                            </div>
                        </div>
                        <div class="form-col">
                            <label>Monthly A/C *</label>
                            <InputText @bind-Value="currentDoctor.accountsmobileno" class="form-control" placeholder="Corporate Account" />
                        </div>
                        <div class="form-col">
                            <label>Credit Days *</label>
                            <InputText @bind-Value="currentDoctor.phonestdcode" class="form-control" placeholder="0" />
                        </div>
                        <div class="form-col">
                            <label>Credit Limit *</label>
                            <InputText @bind-Value="currentDoctor.faxstdcode" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="form-col span-2">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <label style="margin-bottom: 0;">Scheme Rate *</label>
                                <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick='() => OpenFeetypeModal("Scheme")'>
                                    <i class="bi bi-plus-circle-fill"></i> Add New
                                </button>
                            </div>
                            <InputSelect @bind-Value="currentDoctor.procode" class="form-control" TValue="int?">
                                <option value="0">Standard Flat</option>
                                @foreach (var ft in schemeFeeTypes)
                                {
                                    <option value="@ft.ftcode">@ft.name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-col span-2">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <label style="margin-bottom: 0;">Commission *</label>
                                <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick='() => OpenFeetypeModal("Commission")'>
                                    <i class="bi bi-plus-circle-fill"></i> Add New
                                </button>
                            </div>
                            <InputSelect @bind-Value="currentDoctor.ftcode" class="form-control" TValue="int?">
                                <option value="0">Standard Flat</option>
                                @foreach (var ft in commissionFeeTypes)
                                {
                                    <option value="@ft.ftcode">@ft.name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-col span-2">
                            <label>Reimbursement Company</label>
                            <InputSelect @bind-Value="currentDoctor.ricode" class="form-control" TValue="int?">
                                <option value="0">Select Reimbursement Company</option>
                                @foreach (var rc in reimbursementCompanies)
                                {
                                    <option value="@((int)rc.ricode)">@rc.name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <!-- COMMUNICATION & SMS -->
                <div class="form-section">
                    <h4 class="section-title">
                        <span class="section-icon"><i class="bi bi-chat-dots-fill"></i></span>
                        COMMUNICATION
                    </h4>
                    <div class="form-grid">
                        <div class="form-col">
                            <label>Mobile Number *</label>
                            <InputText @bind-Value="currentDoctor.mobile" class="form-control" placeholder="+1 (555) 000-0000" />
                        </div>
                        <div class="form-col">
                            <label>Accounts Number *</label>
                            <InputText @bind-Value="currentDoctor.accountsmobileno" class="form-control" placeholder="91+ 6387363910" />
                        </div>
                        <div class="form-col">
                            <label>Co-Ordinator Number *</label>
                            <InputText @bind-Value="currentDoctor.contactperson" class="form-control" placeholder="91+ 6387363910" />
                        </div>
                        <div class="form-col">
                            <label>Result Number *</label>
                            <InputText @bind-Value="currentDoctor.resultmobileno" class="form-control" placeholder="91+ 6387363910" />
                        </div>
                        <div class="form-col">
                            <label>Phone Number</label>
                            <InputText @bind-Value="currentDoctor.phone" class="form-control" placeholder="+1 (555) 000-0000" />
                        </div>
                        <div class="form-col">
                            <label>Fax Number</label>
                            <InputText @bind-Value="currentDoctor.fax" class="form-control" placeholder="91+ 6387363910" />
                        </div>
                        <div class="form-col">
                            <label>Email Address *</label>
                            <InputText @bind-Value="currentDoctor.email" class="form-control" placeholder="doctor.name@hospital.com" />
                        </div>
                        <div class="form-col">
                            <label>Website</label>
                            <InputText @bind-Value="currentDoctor.website" class="form-control" placeholder="doctor.name@hospital.com" />
                        </div>
                        <div class="form-col">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <label style="margin-bottom: 0;">Country</label>
                                <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick="OpenCountryModal">
                                    <i class="bi bi-plus-circle-fill"></i> Add New
                                </button>
                            </div>
                            <InputSelect @bind-Value="currentDoctor.country" class="form-control">
                                <option value="">Select Country</option>
                                @foreach (var c in countriesList)
                                {
                                    <option value="@c.countryname">@c.countryname</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-col">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <label style="margin-bottom: 0;">State</label>
                                <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick="OpenStateModal">
                                    <i class="bi bi-plus-circle-fill"></i> Add New
                                </button>
                            </div>
                            <InputSelect @bind-Value="currentDoctor.state" class="form-control">
                                <option value="">Select State</option>
                                @foreach (var s in statesList)
                                {
                                    <option value="@s.statename">@s.statename</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-col">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <label style="margin-bottom: 0;">City</label>
                                <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick="OpenCityModal">
                                    <i class="bi bi-plus-circle-fill"></i> Add New
                                </button>
                            </div>
                            <InputSelect @bind-Value="currentDoctor.city" class="form-control">
                                <option value="">Select City</option>
                                @foreach (var ct in citiesList)
                                {
                                    <option value="@ct.cityname">@ct.cityname</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-col">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <label style="margin-bottom: 0;">Area</label>
                                <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick="OpenAreaModal">
                                    <i class="bi bi-plus-circle-fill"></i> Add New
                                </button>
                            </div>
                            <InputSelect @bind-Value="currentDoctor.area" class="form-control">
                                <option value="">Select Area</option>
                                @foreach (var a in areasList)
                                {
                                    <option value="@a.areaname">@a.areaname</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-col">
                            <label>Zip</label>
                            <InputText @bind-Value="currentDoctor.zipcode" class="form-control" placeholder="100101" />
                        </div>
                        <div class="form-col span-2">
                            <label>Full residential address</label>
                            <InputTextArea @bind-Value="currentDoctor.address" class="form-control" rows="1" placeholder="17/19, kuppipalyam road" />
                        </div>
                        <div class="form-col">
                            <label>Send results Via</label>
                            <InputSelect @bind-Value="currentDoctor.sendresults" class="form-control" TValue="bool?">
                                <option value="true">Email</option>
                                <option value="false">SMS</option>
                                <option value="true">Whatsapp</option>
                            </InputSelect>
                        </div>
                    </div>
                </div>

            </div>

            <!-- FOOTER WITH ACTIONS -->
            <div class="modal-footer-bar">
                @if (currentDoctor.dcode != 0)
                {
                    <button type="button" class="btn-delete" @onclick="() => DeleteDoctor(currentDoctor.dcode.ToString())">Delete</button>
                }
                <button type="submit" class="btn-save">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right:8px;">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                    </svg>
                    <span>Save Doctor</span>
                </button>
            </div>
        </EditForm>
    </div>
</div>
}


    <!-- Header Card -->
    <div class="lab-header-card flex-between">
        <div class="gap-16 display-flex align-center">
            <div class="p-2 bg-indigo-50 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="text-indigo-600 material-symbols-outlined icon-lg">stethoscope</span>
            </div>
            <div>
                <h2 class="m-0 lab-title-text">Doctor Master</h2>
                <div class="gap-8 flex-start mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Medical Professionals & Referrals</span>
                </div>
            </div>
        </div>
        <div class="gap-12 display-flex align-center">
            <div class="relative-positioned">
                <input type="text" placeholder="Search doctors, code, mobile..." @bind="searchQuery" @bind:event="oninput" class="lc-search-input-field-custom" />
            </div>
            <div class="search-controls">
                @if (TenantState.HasActionRight("Configuration", "General", "Create")) { <button class="btn-new-entry" @onclick="CreateNew">+ Add New</button> }
            </div>
        </div>
    </div>

    <!-- Directory Section / Data Table -->
    <div class="directory-section">
        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">REF CODE</th>
                        <th>DOCTOR DETAILS</th>
                        <th>PHONE</th>
                        <th>REFERENCE</th>
                        <th>AREA</th>
                        <th>ADDRESS</th>
                        <th class="text-center" style="width: 120px;">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctor in FilteredDoctors)
                    {
                        <tr>
                            <td class="td-order-no">@doctor.doctorcode</td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 1rem;">
                                    <div class="avatar" style="width: 36px; height: 36px; border-radius: 50%; overflow: hidden; background: #ecfeff; color: #0891b2; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem;">
                                        @if (!string.IsNullOrEmpty(doctor.doctorimage))
                                        {
                                            _ = LoadDoctorPhoto(doctor.dcode, doctor.doctorimage, doctor.tenant_code);
                                            if (doctorImagesBase64.TryGetValue(doctor.dcode, out var base64Str))
                                            {
                                                <img src="data:image/jpeg;base64,@base64Str" style="width: 100%; height: 100%; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <span style="font-size: 0.8rem; color: #94a3b8;"><i class="bi bi-arrow-repeat spin"></i></span>
                                            }
                                        }
                                        else
                                        {
                                            @GetInitials(doctor)
                                        }
                                    </div>
                                    <div style="display: flex; flex-direction: column;">
                                        <div class="td-name" style="display: flex; align-items: center; gap: 0.5rem;">
                                            @(string.IsNullOrWhiteSpace(doctor.name) ? doctor.doctorfullname : doctor.name)
                                            @if (doctor.isregular == true)
                                            {
                                                <span style="font-size: 0.65rem; background: #ecfdf5; color: #10b981; padding: 2px 6px; border-radius: 4px; font-weight: 700; border: 1px solid #a7f3d0;">Regular</span>
                                            }
                                        </div>
                                        @if (doctor.normalconsultationfee > 0 || doctor.offhoursconsultationfee > 0)
                                        {
                                            <div style="font-size: 0.7rem; color: #0f172a; font-weight: 600; margin-top: 2px;">
                                                Fee: ₹@(doctor.normalconsultationfee ?? 0) @(doctor.offhoursconsultationfee > 0 ? $" / ₹{doctor.offhoursconsultationfee} (Offhours)" : "")
                                            </div>
                                        }
                                        @if (doctor.spcode > 0)
                                        {
                                            <div style="font-size: 0.75rem; color: #64748b; font-weight: 500;">
                                                @(specialties.FirstOrDefault(s => s.spcode == doctor.spcode)?.name ?? $"Specialty Code: {doctor.spcode}")
                                            </div>
                                        }
                                        @if (doctor.ricode > 0)
                                        {
                                            <div style="font-size: 0.72rem; color: #004c7a; font-weight: 600; margin-top: 2px;">
                                                🏢 @(reimbursementCompanies.FirstOrDefault(r => (int)r.ricode == doctor.ricode)?.name ?? $"Reimbursement: {doctor.ricode}")
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>@doctor.mobile</td>
                            <td>@doctor.reference</td>
                            <td>@doctor.area</td>
                            <td>@doctor.address</td>
                            <td class="text-center">
