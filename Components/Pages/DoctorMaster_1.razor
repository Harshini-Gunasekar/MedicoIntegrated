                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.8rem; font-weight: 600; color: #64748b;">Patients Treated</label>
                    <input type="number" class="form-control" @bind="currentProfile.patients_treated" style="background: #f8fafc; padding: 0.7rem 1rem;" />
