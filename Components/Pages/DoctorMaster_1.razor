@if (showSlabsModal)
{
    <div class="modal-backdrop" style="z-index: 1100;" @onclick="CloseSlabsModal"></div>
    <div class="doctor-modal" style="z-index: 1101; width: 650px; height: auto; max-height: 90vh; top: 50%; left: 50%; transform: translate(-50%, -50%); border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15); display: flex; flex-direction: column;">
        <div class="modal-header" style="padding: 1.25rem 1.75rem; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 1.1rem; font-weight: 700; color: #1e293b; margin: 0;">Manage OP Charge Slabs - Dr. @(string.IsNullOrWhiteSpace(currentDoctor.name) ? currentDoctor.doctorfullname ?? "" : currentDoctor.name)</h3>
            <button class="close-btn" style="font-size: 1.2rem; padding: 0.25rem; color: #94a3b8; background: transparent; border: none; cursor: pointer;" @onclick="CloseSlabsModal">×</button>
        </div>
        <div class="modal-body" style="padding: 1.5rem 1.75rem; overflow-y: auto; flex: 1;">
            
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem;">
                <h4 style="margin-top: 0; font-size: 0.9rem; font-weight: 700; color: #334155; margin-bottom: 0.75rem;">Add New Slab</h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr 1.2fr auto; gap: 0.75rem; align-items: flex-end;">
                    <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                        <label style="font-size: 0.75rem; font-weight: 600; color: #64748b;">Min Age</label>
                        <input type="number" class="cm-input" @bind="newSlab.min_age" style="background: #ffffff; padding: 0.5rem;" min="0" />
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                        <label style="font-size: 0.75rem; font-weight: 600; color: #64748b;">Max Age</label>
                        <input type="number" class="cm-input" @bind="newSlab.max_age" style="background: #ffffff; padding: 0.5rem;" min="0" />
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                        <label style="font-size: 0.75rem; font-weight: 600; color: #64748b;">OP Charge (₹)</label>
                        <input type="number" class="cm-input" @bind="newSlab.opcharge" style="background: #ffffff; padding: 0.5rem;" min="0" placeholder="0.00" />
                    </div>
                    <button type="button" class="btn-save-new" style="padding: 0.55rem 1rem; font-size: 0.85rem; font-weight: 600; border-radius: 6px;" @onclick="AddSlabToTempList">Add Slab</button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table" style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                    <thead>
                        <tr style="border-bottom: 2px solid #e2e8f0; text-align: left; background: #f1f5f9;">
                            <th style="padding: 0.75rem 1rem; color: #475569; font-weight: 600;">Min Age</th>
                            <th style="padding: 0.75rem 1rem; color: #475569; font-weight: 600;">Max Age</th>
                            <th style="padding: 0.75rem 1rem; color: #475569; font-weight: 600;">OP Charge (₹)</th>
                            <th style="padding: 0.75rem 1rem; color: #475569; font-weight: 600; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (tempSlabs.Count == 0)
                        {
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 2rem; color: #94a3b8;">No age slabs configured yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var slab in tempSlabs.Where(s => !s.deleted))
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td style="padding: 0.75rem 1rem; color: #334155;">
                                        <input type="number" class="cm-input" @bind="slab.min_age" style="background: #ffffff; padding: 0.35rem; width: 80px;" min="0" />
                                    </td>
                                    <td style="padding: 0.75rem 1rem; color: #334155;">
                                        <input type="number" class="cm-input" @bind="slab.max_age" style="background: #ffffff; padding: 0.35rem; width: 80px;" min="0" />
                                    </td>
                                    <td style="padding: 0.75rem 1rem; color: #334155;">
                                        <input type="number" class="cm-input" @bind="slab.opcharge" style="background: #ffffff; padding: 0.35rem; width: 100px;" min="0" placeholder="0.00" />
                                    </td>
                                    <td style="padding: 0.75rem 1rem; text-align: center;">
                                        <button type="button" class="btn-delete-text" style="color: #ef4444; border: none; background: transparent; cursor: pointer; padding: 0;" @onclick="() => RemoveSlabFromTempList(slab)">
                                            <i class="bi bi-trash-fill" style="font-size: 1.1rem;"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

