@page "/doctors"
@rendermode InteractiveServer
@using Booking.Models
@inject DoctorService DoctorService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject Booking.Services.ToastService ToastService
@inject Booking.Services.DoctorSpecialtyMasterService DoctorSpecialtyMasterService


@if (showForm)
{
    <div class="modal-backdrop" @onclick="CancelEdit"></div>
    <div class="doctor-modal">
        <div class="modal-header">
            <h3>New Doctor Entry</h3>
            <button class="close-btn" @onclick="CancelEdit">×</button>
        </div>

        <EditForm Model="currentDoctor" OnSubmit="HandleSubmit" class="modal-form-container">
            <DataAnnotationsValidator />

            <div class="modal-body">
                <!-- GENERAL INFORMATION -->
                <div class="section-container">
                    <div class="section-header">
                        <div class="section-icon purple"><i class="bi bi-person-fill"></i></div>
                        <span>GENERAL INFORMATION</span>
                    </div>
                    <div style="display: flex; gap: 2rem; align-items: flex-start; margin-bottom: 1rem;">
                        <!-- Doctor Image Upload (Left Side) -->
                        <div style="width: 140px; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; flex-shrink: 0;">
                            <label style="font-size: 0.8rem; font-weight: 600; color: #64748b; align-self: flex-start;">Doctor Photo</label>
                            <div class="image-upload-container @(selectedPhotoBytes != null || !string.IsNullOrEmpty(currentDoctor.doctorimage) ? "has-image" : "")" 
                                 style="width: 120px; height: 120px; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative;">
                                
                                @if (!string.IsNullOrEmpty(previewPhotoBase64))
                                {
                                    <img src="data:image/jpeg;base64,@previewPhotoBase64" class="image-upload-preview" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else if (!string.IsNullOrEmpty(currentDoctor.doctorimage))
                                {
                                    _ = LoadDoctorPhoto(currentDoctor.dcode, currentDoctor.doctorimage, currentDoctor.tenant_code);
                                    if (doctorImagesBase64.TryGetValue(currentDoctor.dcode, out var base64Str))
                                    {
                                        <img src="data:image/jpeg;base64,@base64Str" class="image-upload-preview" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="image-upload-placeholder">
                                            <i class="bi bi-person-bounding-box" style="font-size: 2rem; color: #cbd5e1;"></i>
                                            <span class="image-upload-label" style="font-size: 0.7rem;">Loading...</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="image-upload-placeholder">
                                        <i class="bi bi-camera-fill" style="font-size: 2rem; color: #94a3b8;"></i>
                                        <span class="image-upload-label" style="font-size: 0.7rem; text-align: center; line-height: 1.1;">Upload Photo</span>
                                    </div>
                                }
                                <InputFile OnChange="OnPhotoSelected" accept=".jpg,.jpeg,.png,.webp" class="image-upload-input" style="position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer;" />
                            </div>
                            @if (selectedPhotoBytes != null || !string.IsNullOrEmpty(currentDoctor.doctorimage))
                            {
                                <button type="button" class="btn-delete-text" style="font-size: 0.75rem; padding: 2px 8px; color: #ef4444; border: none; background: transparent; cursor: pointer;" @onclick="RemovePhoto">Remove</button>
                            }
                        </div>

                        <!-- Fields (Right Side) -->
                        <div class="form-grid" style="flex: 1;">
                            <div class="form-col">
                                <label>Prefix</label>
                                <InputSelect @bind-Value="currentDoctor.nametitle" class="form-control">
                                    <option value="Dr">Dr</option>
                                    <option value="Mr">Mr</option>
                                    <option value="Ms">Ms</option>
                                    <option value="Miss">Miss</option>
                                    <option value="Ms">Ms</option>
                                    <option value="Master">Master</option>
                                    <option value="Baby">Baby</option>
                                    <option value="Prof">Prof</option>
                                </InputSelect>
                            </div>
                            <div class="form-col span-3">
                                <label>First Name <span style="color: #ef4444;">*</span></label>
                                <InputText @bind-Value="currentDoctor.name" class="form-control" placeholder="e.g. Sarah" />
                                <ValidationMessage For="@(() => currentDoctor.name)" style="color: #ef4444; font-size: 0.75rem; margin-top: 0.25rem;" />
                            </div>
                            <div class="form-col span-1">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <label style="margin-bottom: 0;">Specialty *</label>
                                    <button type="button" style="background: transparent; border: none; color: #004b71; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick="OpenSpecialtyModal">
                                        <i class="bi bi-plus-circle-fill"></i> Add New
                                    </button>
                                </div>
                                <InputSelect @bind-Value="currentDoctor.spcode" class="form-control" TValue="int?">
                                    <option value="0">Select Specialty</option>
                                    @foreach (var sp in specialties)
                                    {
                                        <option value="@sp.spcode">@sp.name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="form-col span-2">
                                <label>Qualification</label>
                                <InputText @bind-Value="currentDoctor.qualification" class="form-control" placeholder="e.g. MBBS, MD, FRCP" />
                            </div>
                            <div class="form-col span-1">
                                <label>Type</label>
                                <InputText @bind-Value="currentDoctor.entrytype" class="form-control" placeholder="Type" />
                            </div>
                            <div class="form-col span-1">
                                <label>Portal Password</label>
                                <InputText @bind-Value="currentDoctor.onlinepassword" class="form-control" type="password" placeholder="••••••" />
                            </div>
                            <div class="form-col span-1">
                                <label>OP Charge</label>
                                <InputNumber @bind-Value="currentDoctor.opcharge" class="form-control" placeholder="0.00" />
                            </div>
                            <div class="form-col" style="justify-content: center; align-items: flex-start; height: 100%; padding-top: 1.5rem;">
                                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.8rem; font-weight: 600; color: #64748b;">
                                    <input type="checkbox" @bind="currentDoctor.isreferral" style="width: 16px; height: 16px; accent-color: #004b71;" />
                                    Is Referral
                                </label>
                            </div>
                            <div class="form-col" style="justify-content: center; align-items: flex-start; height: 100%; padding-top: 1.5rem;">
                                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.8rem; font-weight: 600; color: #64748b;">
                                    <input type="checkbox" @bind="currentDoctor.isconsultant" style="width: 16px; height: 16px; accent-color: #004b71;" />
                                    Is Consultant
                                </label>
                            </div>
                            <div class="form-col span-4">
                                <label>Reference</label>
                                <InputText @bind-Value="currentDoctor.reference" class="form-control" placeholder="Hospital or clinic name" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BILLING & ACCOUNTS -->
                <div class="section-container">
                    <div class="section-header">
                        <div class="section-icon indigo"><i class="bi bi-credit-card-2-back-fill"></i></div>
                        <span>BILLING & ACCOUNTS</span>
                    </div>
                    <div class="form-grid">
                        <div class="form-col">
                            <label>Pay Type *</label>
                            <div class="pay-type-toggle">
                                <button type="button" class="toggle-btn active">Cash</button>
                                <button type="button" class="toggle-btn">Credit</button>
                            </div>
                        </div>
                        <div class="form-col">
                            <label>Monthly A/C *</label>
                            <InputText @bind-Value="currentDoctor.accountsmobileno" class="form-control" placeholder="Corporate Account" />
                        </div>
                        <div class="form-col">
                            <label>Credit Days *</label>
                            <InputText @bind-Value="currentDoctor.phonestdcode" class="form-control" placeholder="0" />
                        </div>
                        <div class="form-col">
                            <label>Credit Limit *</label>
                            <InputText @bind-Value="currentDoctor.faxstdcode" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="form-col span-2">
                            <label>Scheme Rate *</label>
                            <InputSelect @bind-Value="currentDoctor.procode" class="form-control" TValue="int?">
                                <option value="0">Standard Flat</option>
                            </InputSelect>
                        </div>
                        <div class="form-col span-2">
                            <label>Commission *</label>
                            <InputSelect @bind-Value="currentDoctor.ftcode" class="form-control" TValue="int?">
                                <option value="0">Standard Flat</option>
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <!-- COMMUNICATION & SMS -->
                <div class="section-container">
                    <div class="section-header">
                        <div class="section-icon blue"><i class="bi bi-chat-dots-fill"></i></div>
                        <span>COMMUNICATION</span>
                    </div>
                    <div class="form-grid">
                        <div class="form-col">
                            <label>Mobile Number *</label>
                            <InputText @bind-Value="currentDoctor.mobile" class="form-control" placeholder="+1 (555) 000-0000" />
                        </div>
                        <div class="form-col">
                            <label>Accounts Number *</label>
                            <InputText @bind-Value="currentDoctor.accountsmobileno" class="form-control" placeholder="91+ 6387363910" />
                        </div>
                        <div class="form-col">
                            <label>Co-Ordinator Number *</label>
                            <InputText @bind-Value="currentDoctor.contactperson" class="form-control" placeholder="91+ 6387363910" />
                        </div>
                        <div class="form-col">
                            <label>Result Number *</label>
                            <InputText @bind-Value="currentDoctor.resultmobileno" class="form-control" placeholder="91+ 6387363910" />
                        </div>
                        <div class="form-col">
                            <label>Phone Number</label>
                            <InputText @bind-Value="currentDoctor.phone" class="form-control" placeholder="+1 (555) 000-0000" />
                        </div>
                        <div class="form-col">
                            <label>Fax Number</label>
                            <InputText @bind-Value="currentDoctor.fax" class="form-control" placeholder="91+ 6387363910" />
                        </div>
                        <div class="form-col">
                            <label>Email Address *</label>
                            <InputText @bind-Value="currentDoctor.email" class="form-control" placeholder="doctor.name@hospital.com" />
                        </div>
                        <div class="form-col">
                            <label>Website</label>
                            <InputText @bind-Value="currentDoctor.website" class="form-control" placeholder="doctor.name@hospital.com" />
                        </div>
                        <div class="form-col">
                            <label>Country</label>
                            <InputSelect @bind-Value="currentDoctor.country" class="form-control">
                                <option value="India">India</option>
                            </InputSelect>
                        </div>
                        <div class="form-col">
                            <label>State</label>
                            <InputSelect @bind-Value="currentDoctor.state" class="form-control">
                                <option value="">Select State</option>
                            </InputSelect>
                        </div>
                        <div class="form-col">
                            <label>City</label>
                            <InputSelect @bind-Value="currentDoctor.city" class="form-control">
                                <option value="">Select City</option>
                            </InputSelect>
                        </div>
                        <div class="form-col">
                            <label>Area</label>
                            <InputSelect @bind-Value="currentDoctor.area" class="form-control">
                                <option value="">Select Area</option>
                            </InputSelect>
                        </div>
                        <div class="form-col">
                            <label>Zip</label>
                            <InputText @bind-Value="currentDoctor.zipcode" class="form-control" placeholder="100101" />
                        </div>
                        <div class="form-col span-2">
                            <label>Full residential address</label>
                            <InputTextArea @bind-Value="currentDoctor.address" class="form-control" rows="1" placeholder="17/19, kuppipalyam road" />
                        </div>
                        <div class="form-col">
                            <label>Send results Via</label>
                            <InputSelect @bind-Value="currentDoctor.sendresults" class="form-control" TValue="bool?">
                                <option value="true">Email</option>
                                <option value="false">SMS</option>
                                <option value="true">Whatsapp</option>
                            </InputSelect>
                        </div>
                    </div>
                </div>

            </div>

            <!-- FOOTER WITH ACTIONS -->
            <div class="modal-footer">
                @if (currentDoctor.dcode != 0)
                {
                    <button type="button" class="btn-delete-text" @onclick="() => DeleteDoctor(currentDoctor.dcode.ToString())">Delete</button>
                }
                <button type="submit" class="btn-save-new">
                    <i class="bi bi-check-lg"></i> Save
                </button>
            </div>
        </EditForm>
    </div>
}

<div class="page-title" style="font-size: 2rem; font-weight: 800; color: #004b71; margin: 0.5rem 0 1rem 1rem;">Doctors Master</div>

<div class="filter-card">
    <div class="filter-left">
        <div class="search-input-wrapper">
            <input type="text" placeholder="Search doctors, code, mobile" class="search-input" @bind="searchQuery" @bind:event="oninput" />
        </div>
        <button class="btn-search-action">
            <i class="bi bi-search"></i> Search
        </button>
    </div>
    
    <button class="btn-new-doctor" @onclick="CreateNew">
        <i class="bi bi-plus-lg"></i> New Doctor
    </button>
</div>

<div class="table-container" style="background: white; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.05); margin: 0 1rem 2rem 1rem;">
<div class="table-responsive">
    <table class="sharp-table" style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="background: #004c7a; color: white;">
                <th style="width: 80px; padding: 1.2rem; font-weight: 800; text-align: left;">REF CODE</th>
                <th style="padding: 1.2rem; font-weight: 800; text-align: left;">DOCTOR DETAILS</th>
                <th style="padding: 1.2rem; font-weight: 800; text-align: left;">PHONE</th>
                <th style="padding: 1.2rem; font-weight: 800; text-align: left;">REFERENCE</th>
                <th style="padding: 1.2rem; font-weight: 800; text-align: left;">AREA</th>
                <th style="padding: 1.2rem; font-weight: 800; text-align: left;">ADDRESS</th>
                <th style="text-align: right; padding: 1.2rem; font-weight: 800;">ACTION</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doctor in FilteredDoctors)
            {
                <tr style="border-bottom: 1px solid #edf2f7;">
                    <td style="color: #087cb2ff; font-weight: 700; padding: 1.2rem;">@doctor.doctorcode</td>
                    <td style="padding: 1.2rem;">
                        <div style="display: flex; align-items: center; gap: 1rem;">
                            <div class="avatar" style="width: 36px; height: 36px; border-radius: 50%; overflow: hidden; background: #ecfeff; color: #0891b2; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem;">
                                @if (!string.IsNullOrEmpty(doctor.doctorimage))
                                {
                                    _ = LoadDoctorPhoto(doctor.dcode, doctor.doctorimage, doctor.tenant_code);
                                    if (doctorImagesBase64.TryGetValue(doctor.dcode, out var base64Str))
                                    {
                                        <img src="data:image/jpeg;base64,@base64Str" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span style="font-size: 0.8rem; color: #94a3b8;"><i class="bi bi-arrow-repeat spin"></i></span>
                                    }
                                }
                                else
                                {
                                    @GetInitials(doctor)
                                }
                            </div>
                            <div style="display: flex; flex-direction: column;">
                                <div style="font-weight: 700; color: #101828;">@(string.IsNullOrWhiteSpace(doctor.name) ? doctor.doctorfullname : doctor.name)</div>
                                @if (doctor.spcode > 0)
                                {
                                    <div style="font-size: 0.75rem; color: #64748b; font-weight: 500;">
                                        @(specialties.FirstOrDefault(s => s.spcode == doctor.spcode)?.name ?? $"Specialty Code: {doctor.spcode}")
                                    </div>
                                }
                            </div>
                        </div>
                    </td>
                    <td style="padding: 1.2rem;">@doctor.mobile</td>
                    <td style="padding: 1.2rem;">@doctor.reference</td>
                    <td style="padding: 1.2rem;">@doctor.area</td>
                    <td style="padding: 1.2rem;">@doctor.address</td>
                    <td style="padding: 1.2rem;">
                        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                            <button class="btn-action" style="width: 32px; height: 32px; border-radius: 6px; border: 1px solid #e2e8f0; background: white; color: #64748b; cursor: pointer;" @onclick="() => EditDoctor(doctor)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn-action" style="width: 32px; height: 32px; border-radius: 6px; border: 1px solid #e2e8f0; background: white; color: #64748b; cursor: pointer;" @onclick="() => DeleteDoctor(doctor.dcode.ToString())">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>

@if (showSpecialtyModal)
{
    <div class="modal-backdrop" style="z-index: 1100;" @onclick="CloseSpecialtyModal"></div>
    <div class="doctor-modal" style="z-index: 1101; width: 500px; height: auto; max-height: 80vh; top: 50%; left: 50%; transform: translate(-50%, -50%); border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15);">
        <div class="modal-header" style="padding: 1.25rem 1.75rem; border-bottom: 1px solid #f1f5f9;">
            <h3 style="font-size: 1.1rem; font-weight: 700; color: #1e293b; margin: 0;">New Doctor Specialty Entry</h3>
            <button class="close-btn" style="font-size: 1.2rem; padding: 0.25rem; color: #94a3b8;" @onclick="CloseSpecialtyModal">×</button>
        </div>
        <div class="modal-body" style="padding: 1.5rem 1.75rem; overflow-y: auto; flex: 1;">
            <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.8rem; font-weight: 600; color: #64748b;">Doctor Specialty Name *</label>
                    <input type="text" class="form-control" @bind="newSpecialty.name" placeholder="e.g. Cardiology, Pediatrics" style="background: #f8fafc; padding: 0.7rem 1rem;" />
                    @if (isSpecialtySubmitted && string.IsNullOrWhiteSpace(newSpecialty.name))
                    {
                        <span style="color: #ef4444; font-size: 0.75rem; font-weight: 500;">This field is required</span>
                    }
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.8rem; font-weight: 600; color: #64748b;">Order No</label>
                    <input type="number" class="form-control" @bind="newSpecialty.orderno" style="background: #f8fafc; padding: 0.7rem 1rem;" />
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.8rem; font-weight: 600; color: #64748b;">Short Name</label>
                    <input type="text" class="form-control" @bind="newSpecialty.shortname" placeholder="e.g. CARDIO" style="background: #f8fafc; padding: 0.7rem 1rem;" />
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.8rem; font-weight: 600; color: #64748b;">Description</label>
                    <input type="text" class="form-control" @bind="newSpecialty.description" placeholder="Narration" style="background: #f8fafc; padding: 0.7rem 1rem;" />
                </div>
            </div>
        </div>
        <div class="modal-footer" style="padding: 1.25rem 1.75rem; border-top: 1px solid #f1f5f9; display: flex; justify-content: flex-end; gap: 1rem;">
            <button type="button" class="btn-delete-text" style="font-size: 0.9rem; font-weight: 600; padding: 0.5rem 1rem;" @onclick="CloseSpecialtyModal">Cancel</button>
            <button type="button" class="btn-save-new" style="padding: 0.6rem 1.5rem; min-width: 100px; font-size: 0.9rem; font-weight: 600; border-radius: 8px;" @onclick="SaveNewSpecialty">
                Save Specialty
            </button>
        </div>
    </div>
}

@code {
    private List<DoctorMasterModel> doctors = new();
    private string searchQuery = "";
    private DoctorMasterModel currentDoctor = new();
    private bool showForm = false;

    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedPhoto;
    private byte[]? selectedPhotoBytes;
    private string? selectedPhotoName;
    private string? previewPhotoBase64;
    private Dictionary<int, string> doctorImagesBase64 = new();

    private string TenantCode = "";
    private string AuthToken = "";

    private List<Booking.Models.DoctorSpecialtyMasterModel> specialties = new();
    private bool showSpecialtyModal = false;
    private Booking.Models.DoctorSpecialtyMasterModel newSpecialty = new();
    private bool isSpecialtySubmitted = false;

    private IEnumerable<DoctorMasterModel> FilteredDoctors => 
        string.IsNullOrWhiteSpace(searchQuery) 
        ? doctors 
        : doctors.Where(d => 
            (d.name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) || 
            (d.doctorcode?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (d.mobile?.Contains(searchQuery) ?? false)
        );

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctors();
        await LoadSpecialties();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error loading tenant details from session: {ex.Message}");
            }
        }
    }

    private async Task LoadDoctors() => doctors = await DoctorService.GetDoctorsAsync();

    private async Task LoadSpecialties()
    {
        try
        {
            specialties = await DoctorSpecialtyMasterService.GetDoctorSpecialtiesAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading specialties: {ex.Message}");
        }
    }

    private void OpenSpecialtyModal()
    {
        newSpecialty = new Booking.Models.DoctorSpecialtyMasterModel
        {
            deleted = false,
            computercode = 1,
            usercode = 1,
            entereddate = DateTime.Now,
            ibsdate = DateTime.Now,
            orderno = specialties.Count + 1,
            tenant_code = string.IsNullOrEmpty(TenantCode) ? "TEN007" : TenantCode
        };
        showSpecialtyModal = true;
        isSpecialtySubmitted = false;
    }

    private void CloseSpecialtyModal()
    {
        showSpecialtyModal = false;
    }

    private async Task SaveNewSpecialty()
    {
        isSpecialtySubmitted = true;
        if (string.IsNullOrWhiteSpace(newSpecialty.name))
        {
            ToastService.ShowError("Doctor Specialty Name is required.");
            return;
        }

        try
        {
            newSpecialty.tenant_code = string.IsNullOrEmpty(TenantCode) ? "TEN007" : TenantCode;
            newSpecialty.computercode = 1;
            newSpecialty.usercode = 1;
            newSpecialty.ibsdate = DateTime.Now;
            newSpecialty.entereddate = DateTime.Now;

            bool success = await DoctorSpecialtyMasterService.InsertDoctorSpecialtyAsync(newSpecialty);
            if (success)
            {
                await LoadSpecialties();
                
                // Find the newly added specialty in the reloaded list to set currentDoctor's spcode
                var added = specialties.FirstOrDefault(s => s.name?.Equals(newSpecialty.name, StringComparison.OrdinalIgnoreCase) ?? false);
                if (added != null)
                {
                    currentDoctor.spcode = added.spcode;
                }

                ToastService.ShowSuccess("Doctor Specialty added successfully!");
                showSpecialtyModal = false;
            }
            else
            {
                ToastService.ShowError("Failed to save doctor specialty.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving doctor specialty: {ex.Message}");
        }
    }

    private async Task LoadDoctorPhoto(int dcode, string? fileName, string? doctorTenantCode)
    {
        if (string.IsNullOrEmpty(fileName)) return;
        if (doctorImagesBase64.ContainsKey(dcode)) return;

        try
        {
            string key = fileName;
            if (!fileName.Contains("/"))
            {
                string tc = string.IsNullOrEmpty(doctorTenantCode) ? TenantCode : doctorTenantCode;
                if (string.IsNullOrEmpty(tc)) tc = "TEN1011";
                key = $"medico/{tc}/doctors/{dcode}/{fileName}";
            }

            var base64 = await DoctorService.DownloadFileAsBase64Async(key);
            if (!string.IsNullOrEmpty(base64))
            {
                doctorImagesBase64[dcode] = base64;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error downloading photo for doctor {dcode}: {ex.Message}");
        }
    }

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                selectedPhotoName = file.Name;
                currentDoctor.doctorimage = file.Name;

                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                selectedPhotoBytes = ms.ToArray();
                selectedPhoto = file;
                previewPhotoBase64 = Convert.ToBase64String(selectedPhotoBytes);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error reading doctor image: {ex.Message}");
        }
        StateHasChanged();
    }

    private void RemovePhoto()
    {
        ResetPhotoState();
        currentDoctor.doctorimage = null;
        if (currentDoctor.dcode != 0)
        {
            doctorImagesBase64.Remove(currentDoctor.dcode);
        }
        StateHasChanged();
    }

    private void ResetPhotoState()
    {
        selectedPhoto = null;
        selectedPhotoBytes = null;
        selectedPhotoName = null;
        previewPhotoBase64 = null;
    }

    private void CreateNew() 
    { 
        ResetPhotoState();
        currentDoctor = new DoctorMasterModel 
        { 
            orderno = 1, 
            nametitle = "Dr", 
            country = "India",
            tenant_code = TenantCode,
            isreferral = true,
            isconsultant = false
        }; 
        showForm = true; 
    }

    private void EditDoctor(DoctorMasterModel doctor) 
    { 
        ResetPhotoState();
        currentDoctor = doctor; 
        showForm = true; 
    }

    private async Task HandleSubmit(EditContext editContext) {
        if (string.IsNullOrWhiteSpace(currentDoctor.name)) {
            ToastService.ShowError("First Name is mandatory! Please enter the doctor's name.");
            return;
        }

        if (editContext.Validate()) {
            await SaveDoctor();
        } else {
            ToastService.ShowError("Please correct the errors in the form.");
        }
    }

    private async Task SaveDoctor() { 
        currentDoctor.tenant_code = string.IsNullOrEmpty(currentDoctor.tenant_code) ? TenantCode : currentDoctor.tenant_code;
        bool success = currentDoctor.dcode > 0 
            ? await DoctorService.UpdateDoctorAsync(currentDoctor, selectedPhotoBytes, selectedPhotoName) 
            : await DoctorService.InsertDoctorAsync(currentDoctor, selectedPhotoBytes, selectedPhotoName);
        
        if (success) { 
            showForm = false; 
            await LoadDoctors(); 
            ToastService.ShowSuccess("Doctor saved successfully!"); 
            ResetPhotoState();
        } else {
            ToastService.ShowError("Failed to save doctor details.");
        }
    }

    private void CancelEdit() 
    {
        ResetPhotoState();
        showForm = false;
    }

    private async Task DeleteDoctor(string dcode) { 
        if (await DoctorService.DeleteDoctorAsync(dcode)) { 
            if (int.TryParse(dcode, out int dc))
            {
                doctorImagesBase64.Remove(dc);
            }
            await LoadDoctors(); 
            ToastService.ShowSuccess("Doctor deleted successfully!");
            showForm = false;
            ResetPhotoState();
        } else {
            ToastService.ShowError("Error deleting doctor.");
        }
    }

    private string GetInitials(DoctorMasterModel doctor)
    {
        string? name = string.IsNullOrWhiteSpace(doctor.name) ? doctor.doctorfullname : doctor.name;
        if (string.IsNullOrEmpty(name)) return "?";
        return name[0].ToString().ToUpper();
    }
}
