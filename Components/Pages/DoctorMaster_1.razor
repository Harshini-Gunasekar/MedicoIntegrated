                    <input type="text" class="form-control" @bind="currentProfile.education_details" style="background: #f8fafc; padding: 0.7rem 1rem;" />
                </div>
                <div style="grid-column: span 2; display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.8rem; font-weight: 600; color: #64748b;">Operations Performed</label>
                    <input type="text" class="form-control" @bind="currentProfile.operations_performed" style="background: #f8fafc; padding: 0.7rem 1rem;" />
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.8rem; font-weight: 600; color: #64748b;">Achievements</label>
                    <input type="text" class="form-control" @bind="currentProfile.achievements" style="background: #f8fafc; padding: 0.7rem 1rem;" />
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.8rem; font-weight: 600; color: #64748b;">Memberships</label>
                    <input type="text" class="form-control" @bind="currentProfile.memberships" style="background: #f8fafc; padding: 0.7rem 1rem;" />
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.8rem; font-weight: 600; color: #64748b;">Publications</label>
                    <input type="text" class="form-control" @bind="currentProfile.publications" style="background: #f8fafc; padding: 0.7rem 1rem;" />
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.8rem; font-weight: 600; color: #64748b;">Languages Known</label>
                    <input type="text" class="form-control" @bind="currentProfile.languages_known" style="background: #f8fafc; padding: 0.7rem 1rem;" />
                </div>
                <div style="grid-column: span 2; display: flex; flex-direction: column; gap: 0.4rem;">
                    <label style="font-size: 0.8rem; font-weight: 600; color: #64748b;">Profile Video URL</label>
                    <input type="text" class="form-control" @bind="currentProfile.profile_video_url" style="background: #f8fafc; padding: 0.7rem 1rem;" />
