            <button class="close-btn" style="font-size: 1.2rem; padding: 0.25rem; color: #94a3b8;" @onclick="CloseProfileModal">×</button>
        </div>
        <div class="modal-body" style="padding: 1.5rem 1.75rem; overflow-y: auto; flex: 1;">
