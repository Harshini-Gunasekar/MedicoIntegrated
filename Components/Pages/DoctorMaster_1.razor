@code {
    private bool showProfileModal = false;
    private DoctorProfileModel currentProfile = new();
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? profileBannerFile;
    private string profileDoctorName = "";

    private async Task OpenProfileModal(DoctorMasterModel doctor)
    {
        profileDoctorName = string.IsNullOrWhiteSpace(doctor.name) ? doctor.doctorfullname ?? "" : doctor.name;
        var profile = await DoctorProfileService.GetProfileAsync(doctor.dcode);
        if (profile != null && profile.pcode > 0)
        {
            currentProfile = profile;
        }
        else
        {
            currentProfile = new DoctorProfileModel
            {
                dcode = doctor.dcode,
                tenant_code = TenantCode
            };
        }
        profileBannerFile = null;
        showProfileModal = true;
    }

    private void CloseProfileModal()
    {
        showProfileModal = false;
        profileBannerFile = null;
    }

    private void OnProfileBannerSelected(InputFileChangeEventArgs e)
    {
        profileBannerFile = e.File;
    }

    private async Task SaveDoctorProfile()
    {
        currentProfile.tenant_code = string.IsNullOrEmpty(currentProfile.tenant_code) ? TenantCode : currentProfile.tenant_code;
        bool success;
        
        if (currentProfile.pcode > 0)
        {
            success = await DoctorProfileService.UpdateProfileAsync(currentProfile, profileBannerFile);
        }
        else
        {
            success = await DoctorProfileService.InsertProfileAsync(currentProfile, profileBannerFile);
        }

        if (success)
        {
            ToastService.ShowSuccess("Doctor profile saved successfully!");
            CloseProfileModal();
        }
        else
        {
            ToastService.ShowError("Failed to save doctor profile.");
        }
    }

    private async Task DeleteDoctorProfile()
    {
        if (currentProfile.pcode > 0)
        {
            if (await DoctorProfileService.DeleteProfileAsync(currentProfile.pcode))
            {
                ToastService.ShowSuccess("Doctor profile deleted successfully!");
                CloseProfileModal();
            }
            else
            {
                ToastService.ShowError("Error deleting doctor profile.");
            }
        }
    }

    private bool isLoading = false;
    private List<DoctorMasterModel> doctors = new();
    private string searchQuery = "";
    private DoctorMasterModel currentDoctor = new();
    private bool showForm = false;

    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedPhoto;
    private byte[]? selectedPhotoBytes;
    private string? selectedPhotoName;
    private string? previewPhotoBase64;
    private Dictionary<int, string> doctorImagesBase64 = new();

    private string TenantCode = "";
    private string AuthToken = "";

    private List<Booking.Models.DoctorSpecialtyMasterModel> specialties = new();
    private bool showSpecialtyModal = false;
    private Booking.Models.DoctorSpecialtyMasterModel newSpecialty = new();
    private bool isSpecialtySubmitted = false;

    private List<FeeTypeMasterModel> allFeeTypes = new();
    private List<FeeTypeMasterModel> schemeFeeTypes = new();
    private List<FeeTypeMasterModel> commissionFeeTypes = new();

    private List<CountryMasterModel> countriesList = new();
    private List<StateMasterModel> statesList = new();
    private List<CityMasterModel> citiesList = new();
    private List<AreaMasterModel> areasList = new();
    private List<ReimbursementCompanyMasterModel> reimbursementCompanies = new();
    private List<DoctorGroupMasterModel> doctorGroups = new();
    private bool showGroupModal = false;
    private DoctorGroupMasterModel newDoctorGroup = new();
    private bool isGroupSubmitted = false;

    private IEnumerable<DoctorMasterModel> FilteredDoctors => 
        string.IsNullOrWhiteSpace(searchQuery) 
        ? doctors 
        : doctors.Where(d => 
            (d.name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) || 
            (d.doctorcode?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (d.mobile?.Contains(searchQuery) ?? false)
        );

    protected override async Task OnInitializedAsync()
    {
        TenantState.OnSessionChanged += OnSessionChangedHandler;
        if (!string.IsNullOrEmpty(TenantState.TenantCode))
        {
            await InitLoad();
        }
    }

    private async Task InitLoad()
    {
        await LoadDoctors();
        await LoadSpecialties();
        await LoadDoctorGroups();
        await LoadFeeTypes();
        await LoadAddressMasters();
        await LoadReimbursementCompanies();
    }

    private async Task LoadDoctorGroups()
    {
        try
        {
            doctorGroups = await DoctorGroupMasterService.GetDoctorGroupsAsync() ?? new();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading doctor groups: {ex.Message}");
        }
    }

    private async void OnSessionChangedHandler()
    {
        await InvokeAsync(async () =>
        {
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                await InitLoad();
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        TenantState.OnSessionChanged -= OnSessionChangedHandler;
    }

    private async Task LoadReimbursementCompanies()
    {
        try
        {
            reimbursementCompanies = await ReimbursementService.GetReimbursementCompaniesAsync() ?? new();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading reimbursement companies: {ex.Message}");
        }
    }

    private async Task LoadFeeTypes()
    {
        try
        {
            var res = await FeetypeService.GetFeeTypesAsync();
            if (res != null)
            {
                allFeeTypes = res;
                schemeFeeTypes = res.Where(f => f.isscheme == true).ToList();
                commissionFeeTypes = res.Where(f => f.iscommission == true).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading fee types: {ex.Message}");
        }
    }

    private async Task LoadAddressMasters()
    {
        try
        {
            countriesList = await CountryMasterService.GetCountriesAsync();
            statesList = await StateMasterService.GetStatesAsync();
            citiesList = await CityMasterService.GetCitiesAsync();
            areasList = await AreaMasterService.GetAreasAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading address masters: {ex.Message}");
        }
    }

    private bool showFeetypeModal = false;
    private FeeTypeMasterModel newFeetype = new();
    private string newFeetypeRateType = "Scheme";

    private bool showReimbursementModal = false;
    private ReimbursementCompanyMasterModel newReimbursementCompany = new();
    private bool isReimbursementSubmitted = false;

    private bool showCountryModal = false;
    private CountryMasterModel newCountry = new();

    private bool showStateModal = false;
    private StateMasterModel newState = new();

    private bool showCityModal = false;
    private CityMasterModel newCity = new();

    private bool showAreaModal = false;
    private AreaMasterModel newArea = new();
    private int selectedAreaCityCode = 0;

    private void OpenFeetypeModal(string rateType)
    {
        newFeetypeRateType = rateType;
        newFeetype = new FeeTypeMasterModel
        {
            deleted = false,
            computercode = 1,
            usercode = 1,
            entereddate = DateTime.Now,
            ibsdate = DateTime.Now,
            orderno = allFeeTypes.Count + 1,
            tenant_code = string.IsNullOrEmpty(TenantCode) ? "TEN1011" : TenantCode
        };
        showFeetypeModal = true;
    }

    private void CloseFeetypeModal() => showFeetypeModal = false;

    private async Task SaveNewFeetype()
    {
        if (string.IsNullOrWhiteSpace(newFeetype.name))
        {
            ToastService.ShowError("Fee Type Name is required.");
            return;
        }

        try
        {
            newFeetype.tenant_code = string.IsNullOrEmpty(TenantCode) ? "TEN1011" : TenantCode;
