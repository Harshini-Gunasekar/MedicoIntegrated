    private bool showSlabsModal = false;
    private List<OpChargeSlabModel> tempSlabs = new();
    private List<int> deletedSlabIds = new();
    private OpChargeSlabModel newSlab = new();

    private async Task OpenSlabsModal()
    {
        if (currentDoctor == null) return;
        
        newSlab = new OpChargeSlabModel
        {
            dcode = currentDoctor.dcode,
            min_age = 0,
            max_age = 0,
            opcharge = 0
        };
        
        if (currentDoctor.dcode == 0)
        {
            // For a new doctor, do not clear tempSlabs in case they reopened the modal
            showSlabsModal = true;
            return;
        }

        deletedSlabIds.Clear();
        isLoading = true;
        try
        {
            var dbSlabs = await OpChargeSlabService.GetSlabsByDoctorAsync(currentDoctor.dcode);
            tempSlabs = dbSlabs ?? new List<OpChargeSlabModel>();
            showSlabsModal = true;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load slabs: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CloseSlabsModal()
    {
        showSlabsModal = false;
    }

    private void AddSlabToTempList()
    {
        if (newSlab.max_age < newSlab.min_age)
        {
            ToastService.ShowError("Max Age cannot be less than Min Age.");
            return;
        }
        
        var added = new OpChargeSlabModel
        {
            dcode = currentDoctor.dcode,
            min_age = newSlab.min_age,
            max_age = newSlab.max_age,
            opcharge = newSlab.opcharge,
            deleted = false
        };
        
        tempSlabs.Add(added);
        
        newSlab = new OpChargeSlabModel
        {
            dcode = currentDoctor.dcode,
            min_age = 0,
            max_age = 0,
            opcharge = 0
        };
    }

    private void RemoveSlabFromTempList(OpChargeSlabModel slab)
    {
        if (slab.slabid > 0)
        {
            deletedSlabIds.Add(slab.slabid);
        }
        tempSlabs.Remove(slab);
    }

    private async Task SaveSlabsAsync()
    {
        if (currentDoctor == null) return;

        if (currentDoctor.dcode == 0)
        {
            ToastService.ShowSuccess("OP charge slabs configured in memory. They will be saved when the doctor is saved.");
            CloseSlabsModal();
            return;
        }

        isLoading = true;
        try
        {
            foreach (var id in deletedSlabIds)
            {
                await OpChargeSlabService.DeleteSlabAsync(id);
            }
            deletedSlabIds.Clear();

            var newItems = new List<OpChargeSlabModel>();
            var updatedItems = new List<OpChargeSlabModel>();

            foreach (var item in tempSlabs)
            {
                if (item.slabid == 0)
                {
                    item.tenant_code = TenantState.TenantCode;
                    newItems.Add(item);
                }
                else
                {
                    updatedItems.Add(item);
                }
            }

            bool success = true;

            if (newItems.Count > 0)
            {
                var addRes = await OpChargeSlabService.AddSlabsAsync(newItems);
                if (!addRes) success = false;
            }

            if (updatedItems.Count > 0)
            {
                var updateRes = await OpChargeSlabService.UpdateSlabsAsync(updatedItems);
                if (!updateRes) success = false;
            }

            if (success)
            {
                ToastService.ShowSuccess("OP charge slabs saved successfully!");
                CloseSlabsModal();
            }
            else
            {
                ToastService.ShowError("Some slabs failed to save.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving slabs: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

