    private async Task HandleSubmit(EditContext editContext) {
        // Run validation first to display inline validation error messages
        bool isValid = editContext.Validate();

        var missingFields = new List<string>();
        if (string.IsNullOrWhiteSpace(currentDoctor.name)) missingFields.Add("First Name");
        if (currentDoctor.spcode == null || currentDoctor.spcode == 0) missingFields.Add("Specialty");
        if (string.IsNullOrWhiteSpace(currentDoctor.qualification)) missingFields.Add("Qualification");
        if (string.IsNullOrWhiteSpace(currentDoctor.mobile)) missingFields.Add("Mobile Number");
        if (string.IsNullOrWhiteSpace(currentDoctor.email)) missingFields.Add("Email Address");

        if (missingFields.Count > 0) {
            ToastService.ShowError($"Please fill required mandatory fields: {string.Join(", ", missingFields)}");
            return;
        }

        if (isValid) {
            await SaveDoctor();
        } else {
            ToastService.ShowError("Please correct the errors in the form.");
        }
    }

    private async Task SaveDoctor() { 
        currentDoctor.tenant_code = string.IsNullOrEmpty(currentDoctor.tenant_code) ? TenantCode : currentDoctor.tenant_code;
        
        // Capture doctor details before showForm is set to false
        bool isConsultant = currentDoctor.isconsultant == true;
        string docName = currentDoctor.name ?? "";
        string docTitle = currentDoctor.nametitle ?? "Dr";
        string docShortName = currentDoctor.shortname ?? docName;
        string docPass = currentDoctor.onlinepassword ?? "";
        string docEmail = currentDoctor.email ?? "";
        string docMobile = currentDoctor.mobile ?? currentDoctor.phone ?? "";
        int existingDcode = currentDoctor.dcode;
        string tenantCodeToUse = currentDoctor.tenant_code;

        bool success = currentDoctor.dcode > 0 
            ? await DoctorService.UpdateDoctorAsync(currentDoctor, selectedPhotoBytes, selectedPhotoName) 
            : await DoctorService.InsertDoctorAsync(currentDoctor, selectedPhotoBytes, selectedPhotoName);
        
        if (success) { 
            await LoadDoctors(); 

            // Save in-memory slabs if it was a new doctor
            if (existingDcode == 0 && tempSlabs.Count > 0)
            {
                try
                {
                    var savedDoc = doctors.FirstOrDefault(d => d.name?.Equals(docName, StringComparison.OrdinalIgnoreCase) ?? false);
                    if (savedDoc != null)
                    {
                        foreach (var slab in tempSlabs)
                        {
                            slab.dcode = savedDoc.dcode;
                            slab.tenant_code = TenantState.TenantCode;
                        }
                        await OpChargeSlabService.AddSlabsAsync(tempSlabs);
                    }
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Error saving slabs for new doctor: {ex.Message}");
                }
            }

            showForm = false; 
            ToastService.ShowSuccess("Doctor saved successfully!"); 
            ResetPhotoState();
            tempSlabs.Clear();
            deletedSlabIds.Clear();

            if (isConsultant)
            {
                try
                {
                    int dcode = existingDcode;
                    if (dcode == 0 && doctors != null)
                    {
                        var savedDoc = doctors.FirstOrDefault(d => d.name?.Equals(docName, StringComparison.OrdinalIgnoreCase) ?? false);
                        if (savedDoc != null) dcode = savedDoc.dcode;
                    }

                    var allUsers = await UserService.GetAllAsync();
                    string fullName = $"{docTitle} {docName}".Trim();
                    
                    var existingUser = allUsers.FirstOrDefault(u => 
                        u?.user != null && (
                            (dcode > 0 && u.user.consultant_dcode == dcode) ||
                            (!string.IsNullOrEmpty(docName) && u.user.name?.Equals(fullName, StringComparison.OrdinalIgnoreCase) == true)
                        )
                    );

                    string password = !string.IsNullOrWhiteSpace(docPass) ? docPass : "123456";
                    string shortName = !string.IsNullOrWhiteSpace(docShortName) ? docShortName : docName;
                    if (string.IsNullOrWhiteSpace(shortName)) shortName = $"Doc{dcode}";

                    string email = !string.IsNullOrWhiteSpace(docEmail) ? docEmail : $"{shortName.Replace(" ", "").ToLower()}@hospital.com";
                    if (!email.Contains('@')) email += "@hospital.com";

                    string mobile = !string.IsNullOrWhiteSpace(docMobile) ? docMobile : "9999999999";
                    string tenant = string.IsNullOrEmpty(tenantCodeToUse) ? TenantCode : tenantCodeToUse;
                    int bhCode = TenantState.BranchCode > 0 ? TenantState.BranchCode.Value : 1;

                    var branchList = new List<UserBranchMaster>
                    {
                        new UserBranchMaster
                        {
                            bhcode = bhCode,
                            tenant_code = tenant,
                            deleted = false
                        }
                    };

                    if (existingUser?.user != null)
                    {
                        var u = existingUser.user;
                        u.is_consultant = true;
                        if (dcode > 0) u.consultant_dcode = dcode;
                        u.name = fullName;
                        u.short_name = shortName;
                        u.password = password;
                        u.email = email;
                        u.mobile = mobile;
                        u.tenant_code = tenant;

                        var updateRes = await UserService.UpdateAsync(u, branchList);
                        if (updateRes.IsSuccessStatusCode)
                        {
                            ToastService.ShowSuccess($"User login updated in User Master for Consultant: {shortName}");
                        }
                        else
                        {
                            var errStr = await updateRes.Content.ReadAsStringAsync();
                            Console.WriteLine($"[Consultant Sync] Update failed: {errStr}");
                        }
                    }
                    else
                    {
                        var newUser = new user_master
                        {
                            user_code = 0, // NEW USER MUST BE 0
                            name = fullName,
                            short_name = shortName,
                            description = $"Consultant Doctor - {fullName}",
                            password = password,
                            email = email,
                            mobile = mobile,
                            role = "0",
                            is_consultant = true,
                            consultant_dcode = dcode > 0 ? dcode : null,
                            tenant_code = tenant,
                            all_branch = true,
                            bh_code = bhCode,
                            euser_code = 1,
                            computer_code = 1,
                            entered_date = DateTime.Now,
                            ibs_date = DateTime.Now
                        };

                        var res = await UserService.RegisterAsync(newUser, branchList);
                        if (res.IsSuccessStatusCode)
                        {
                            ToastService.ShowSuccess($"User login created in User Master for Consultant (Username: {shortName}, Password: {password})");
                        }
                        else
                        {
                            var errStr = await res.Content.ReadAsStringAsync();
                            Console.WriteLine($"[Consultant Sync] Register failed: {errStr}");
                            ToastService.ShowError($"Could not create User Master login: {errStr}");
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Error creating user master entry for consultant doctor: {ex.Message}");
                    ToastService.ShowError($"Error creating consultant login: {ex.Message}");
                }
            }
        } else {
            ToastService.ShowError("Failed to save doctor details.");
        }
    }

