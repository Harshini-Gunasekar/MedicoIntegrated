@page "/doctors"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Booking.Models
@using Medico_Backend.Model
@inject DoctorService DoctorService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject Booking.Services.ToastService ToastService
@inject Booking.Services.DoctorSpecialtyMasterService DoctorSpecialtyMasterService
@inject Booking.Services.DoctorGroupMasterService DoctorGroupMasterService
@inject Booking.Services.FeetypeService FeetypeService
@inject Booking.Services.CountryMasterService CountryMasterService
@inject Booking.Services.StateMasterService StateMasterService
@inject Booking.Services.CityMasterService CityMasterService
@inject Booking.Services.AreaMasterService AreaMasterService
@inject Booking.Services.ReimbursementCompanyMasterService ReimbursementService
@inject Booking.Services.DoctorProfileService DoctorProfileService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@implements IDisposable


<div class="referral-page lc-fadeInUp">
    <DnaLoader IsLoading="@isLoading" Message="Loading Doctors..." />

@if (showForm)
{
    <div class="modal-overlay" @onclick="CancelEdit">
        <div class="modal-form-card" style="width: 98%; max-width: 1700px; max-height: 95vh; height: 93vh; display: flex; flex-direction: column; overflow: hidden;" @onclick:stopPropagation>
            <div class="modal-header-bar" style="flex-shrink: 0; padding: 12px 28px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div class="modal-header-icon">
                        <span class="material-symbols-outlined">stethoscope</span>
                    </div>
                    <div>
                        <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: #1e293b;">@(currentDoctor.dcode != 0 ? "Edit Doctor Profile" : "New Doctor Entry")</h3>
                        <span class="modal-subtitle">@(currentDoctor.dcode != 0 ? $"Updating profile for {currentDoctor.nametitle} {currentDoctor.name}" : "Enter primary details, medical qualifications, location, and photo")</span>
                    </div>
                </div>
                <button type="button" class="modal-close-btn" @onclick="CancelEdit" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>

            <EditForm Model="currentDoctor" OnSubmit="HandleSubmit" class="modal-form-container" style="display: flex; flex-direction: column; flex: 1 1 auto; overflow: hidden; min-height: 0;">
            <DataAnnotationsValidator />

            <div class="modal-body" style="flex: 1 1 auto; overflow-y: auto; max-height: calc(93vh - 110px); min-height: 0; padding: 16px 28px;">
                <!-- TWO-COLUMN FORM LAYOUT -->
                <div class="form-grid-layout" style="margin: 0; padding: 0;">
                        
                        <!-- COLUMN 1: PRIMARY & MEDICAL QUALIFICATIONS -->
                        <div class="form-column">
                            <h4 class="form-section-title">
                                <span class="material-symbols-outlined">person</span> Primary Details & Qualifications
                            </h4>
                            <div class="cm-container">
                                <!-- Prefix & First Name -->
                                <div class="cm-field cm-col-2">
                                    <label class="cm-label-top">Prefix</label>
                                    <select @bind="currentDoctor.nametitle" class="cm-input">
                                        <option value="Dr">Dr</option>
                                        <option value="Mr">Mr</option>
                                        <option value="Ms">Ms</option>
                                        <option value="Miss">Miss</option>
                                        <option value="Master">Master</option>
                                        <option value="Baby">Baby</option>
                                        <option value="Prof">Prof</option>
                                    </select>
                                </div>
                                <div class="cm-field cm-col-10">
                                    <label class="cm-label-top">First Name <span style="color: #ef4444;">*</span></label>
                                    <input type="text" @bind="currentDoctor.name" class="cm-input" placeholder="e.g. Sarah" />
                                    <ValidationMessage For="@(() => currentDoctor.name)" style="color: #ef4444; font-size: 0.75rem; margin-top: 0.25rem;" />
                                </div>

                                <!-- Specialty & Qualification -->
                                <div class="cm-field cm-col-6">
                                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <label class="cm-label-top" style="margin-bottom: 0;">Specialty <span style="color: #ef4444;">*</span></label>
                                        <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick="OpenSpecialtyModal">
                                            <i class="bi bi-plus-circle-fill"></i> Add New
                                        </button>
                                    </div>
                                    <select @bind="currentDoctor.spcode" class="cm-input">
                                        <option value="0">Select Specialty</option>
                                        @foreach (var sp in specialties)
                                        {
                                            <option value="@sp.spcode">@sp.name</option>
                                        }
                                    </select>
                                </div>
                                <div class="cm-field cm-col-6">
                                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <label class="cm-label-top" style="margin-bottom: 0;">Doctor Group</label>
                                        <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick="OpenGroupModal">
                                            <i class="bi bi-plus-circle-fill"></i> Add New
                                        </button>
                                    </div>
                                    <select @bind="currentDoctor.group_id" class="cm-input">
                                        <option value="">Select Doctor Group</option>
                                        @foreach (var grp in doctorGroups)
                                        {
                                            <option value="@grp.group_id">@grp.group_name</option>
                                        }
                                    </select>
                                </div>
                                <div class="cm-field cm-col-6">
                                    <label class="cm-label-top">Qualification</label>
                                    <input type="text" @bind="currentDoctor.qualification" class="cm-input" placeholder="e.g. MBBS, MD, FRCP" />
                                </div>

                                <!-- OP Charge & Portal Password -->
                                <div class="cm-field cm-col-6">
                                    <label class="cm-label-top">OP Charge</label>
                                    <input type="number" @bind="currentDoctor.opcharge" class="cm-input" placeholder="0.00" />
                                </div>
                                <div class="cm-field cm-col-6">
                                    <label class="cm-label-top">Portal Password</label>
                                    <input type="password" @bind="currentDoctor.onlinepassword" class="cm-input" placeholder="••••••" />
                                </div>

                                <!-- Regular Status & Off Hours Fee -->
                                <div class="cm-field @(currentDoctor.isregular == true ? "cm-col-12" : "cm-col-6")">
                                    <label class="cm-label-top">Regular Status</label>
                                    <div class="pay-type-toggle">
                                        <button type="button" class="toggle-btn @(currentDoctor.isregular == true ? "active" : "")" @onclick="() => SetRegularStatus(true)">Regular</button>
                                        <button type="button" class="toggle-btn @(currentDoctor.isregular != true ? "active" : "")" @onclick="() => SetRegularStatus(false)">Not Regular</button>
                                    </div>
                                </div>
                                @if (currentDoctor.isregular != true)
                                {
                                    <div class="cm-field cm-col-6">
                                        <label class="cm-label-top">Off Hours Fee</label>
                                        <input type="number" @bind="currentDoctor.offhoursconsultationfee" class="cm-input" placeholder="0.00" />
                                    </div>
                                }

                                <!-- Status Flags Card -->
                                <div class="cm-field cm-col-12">
                                    <label class="cm-label-top">Role & Display Options</label>
                                    <div class="role-options-card">
                                        <label class="role-option-pill @(currentDoctor.isreferral == true ? "selected" : "")">
                                            <input type="checkbox" @bind="currentDoctor.isreferral" style="accent-color: #4f46e5;" />
                                            <span>Is Referral</span>
                                        </label>
                                        <label class="role-option-pill @(currentDoctor.isconsultant == true ? "selected" : "")">
                                            <input type="checkbox" @bind="currentDoctor.isconsultant" style="accent-color: #4f46e5;" />
                                            <span>Is Consultant</span>
                                        </label>
                                        <label class="role-option-pill @(currentDoctor.showmobile == true ? "selected" : "")">
                                            <input type="checkbox" @bind="currentDoctor.showmobile" style="accent-color: #4f46e5;" />
                                            <span>Show Mobile</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <h4 class="form-section-title" style="margin-top: 1.5rem;">
                                <span class="material-symbols-outlined">contact_phone</span> Contact Information
                            </h4>
                            <div class="cm-container">
                                <div class="cm-field cm-col-6">
                                    <label class="cm-label-top">Mobile Number <span style="color: #ef4444;">*</span></label>
                                    <input type="text" @bind="currentDoctor.mobile" class="cm-input" placeholder="+1 (555) 000-0000" />
                                </div>
                                <div class="cm-field cm-col-6">
                                    <label class="cm-label-top">Phone Number</label>
                                    <input type="text" @bind="currentDoctor.phone" class="cm-input" placeholder="+1 (555) 000-0000" />
                                </div>
                                <div class="cm-field cm-col-6">
                                    <label class="cm-label-top">Co-Ordinator Number</label>
                                    <input type="text" @bind="currentDoctor.contactperson" class="cm-input" placeholder="91+ 6387363910" />
                                </div>
                                <div class="cm-field cm-col-6">
                                    <label class="cm-label-top">Email Address <span style="color: #ef4444;">*</span></label>
                                    <input type="email" @bind="currentDoctor.email" class="cm-input" placeholder="doctor.name@hospital.com" />
                                </div>
                                <div class="cm-field cm-col-6">
                                    <label class="cm-label-top">Website</label>
                                    <input type="text" @bind="currentDoctor.website" class="cm-input" placeholder="doctor.name@hospital.com" />
                                </div>
                                <div class="cm-field cm-col-6">
                                    <label class="cm-label-top">Reference / Clinic</label>
                                    <input type="text" @bind="currentDoctor.reference" class="cm-input" placeholder="Hospital or clinic name" />
                                </div>
                            </div>
                        </div>

                        <!-- COLUMN 2: BILLING & LOCATION -->
                        <div class="form-column">
                            <h4 class="form-section-title">
                                <span class="material-symbols-outlined">payments</span> Billing & Compensation Settings
                            </h4>
                            <div class="cm-container">
                                <!-- Pay Type & Send Results Via -->
                                <div class="cm-field cm-col-6">
                                    <label class="cm-label-top">Pay Type <span style="color: #ef4444;">*</span></label>
                                    <div class="pay-type-toggle">
                                        <button type="button" class="toggle-btn @(currentDoctor.entrytype == "CASH" || string.IsNullOrEmpty(currentDoctor.entrytype) ? "active" : "")" @onclick='() => SelectPayType("CASH")'>Cash</button>
                                        <button type="button" class="toggle-btn @(currentDoctor.entrytype == "CREDIT" ? "active" : "")" @onclick='() => SelectPayType("CREDIT")'>Credit</button>
                                    </div>
                                </div>
                                <div class="cm-field cm-col-6">
                                    <label class="cm-label-top">Send Results Via</label>
                                    <select @bind="currentDoctor.sendresults" class="cm-input">
                                        <option value="true">Email</option>
                                        <option value="false">SMS</option>
                                        <option value="true">Whatsapp</option>
                                    </select>
                                </div>

                                <!-- Credit Days & Credit Limit -->
                                <div class="cm-field cm-col-6">
                                    <label class="cm-label-top">Credit Days</label>
                                    <input type="text" @bind="currentDoctor.phonestdcode" class="cm-input" placeholder="0" />
                                </div>
                                <div class="cm-field cm-col-6">
                                    <label class="cm-label-top">Credit Limit</label>
                                    <input type="text" @bind="currentDoctor.faxstdcode" class="cm-input" placeholder="0.00" />
                                </div>

                                <!-- Scheme Rate & Commission -->
                                <div class="cm-field cm-col-6">
                                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <label class="cm-label-top" style="margin-bottom: 0;">Scheme Rate</label>
                                        <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick='() => OpenFeetypeModal("Scheme")'>
                                            <i class="bi bi-plus-circle-fill"></i> Add New
                                        </button>
                                    </div>
                                    <select @bind="currentDoctor.procode" class="cm-input">
                                        <option value="0">Standard Flat</option>
                                        @foreach (var ft in schemeFeeTypes)
                                        {
                                            <option value="@ft.ftcode">@ft.name</option>
                                        }
                                    </select>
                                </div>
                                <div class="cm-field cm-col-6">
                                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <label class="cm-label-top" style="margin-bottom: 0;">Commission <span style="color: #ef4444;">*</span></label>
                                        <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick='() => OpenFeetypeModal("Commission")'>
                                            <i class="bi bi-plus-circle-fill"></i> Add New
                                        </button>
                                    </div>
                                    <select @bind="currentDoctor.ftcode" class="cm-input">
                                        <option value="0">Standard Flat</option>
                                        @foreach (var ft in commissionFeeTypes)
                                        {
                                            <option value="@ft.ftcode">@ft.name</option>
                                        }
                                    </select>
                                </div>

                                <!-- Reimbursement Company -->
                                <div class="cm-field cm-col-12">
                                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <label class="cm-label-top" style="margin-bottom: 0;">Reimbursement Company</label>
                                        <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick="OpenReimbursementModal">
                                            <i class="bi bi-plus-circle-fill"></i> Add New
                                        </button>
                                    </div>
                                    <select @bind="currentDoctor.ricode" class="cm-input">
                                        <option value="0">Select Reimbursement Company</option>
                                        @foreach (var rc in reimbursementCompanies)
                                        {
                                            <option value="@((int)rc.ricode)">@rc.name</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <h4 class="form-section-title" style="margin-top: 1.5rem;">
                                <span class="material-symbols-outlined">location_on</span> Location & Address
                            </h4>
                            <div class="cm-container">
                                <!-- Location Fields (Country, State, City, Area, Zip, Address) -->
                                <div class="cm-field cm-col-6">
                                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <label class="cm-label-top" style="margin-bottom: 0;">Country</label>
                                        <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick="OpenCountryModal">
                                            <i class="bi bi-plus-circle-fill"></i> Add New
                                        </button>
                                    </div>
                                    <select @bind="currentDoctor.country" class="cm-input">
                                        <option value="">Select Country</option>
                                        @foreach (var c in countriesList)
                                        {
                                            <option value="@c.countryname">@c.countryname</option>
                                        }
                                    </select>
                                </div>
                                <div class="cm-field cm-col-6">
                                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <label class="cm-label-top" style="margin-bottom: 0;">State</label>
                                        <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick="OpenStateModal">
                                            <i class="bi bi-plus-circle-fill"></i> Add New
                                        </button>
                                    </div>
                                    <select @bind="currentDoctor.state" class="cm-input">
                                        <option value="">Select State</option>
                                        @foreach (var s in statesList)
                                        {
                                            <option value="@s.statename">@s.statename</option>
                                        }
                                    </select>
                                </div>

                                <div class="cm-field cm-col-6">
                                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <label class="cm-label-top" style="margin-bottom: 0;">City</label>
                                        <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick="OpenCityModal">
                                            <i class="bi bi-plus-circle-fill"></i> Add New
                                        </button>
                                    </div>
                                    <select @bind="currentDoctor.city" class="cm-input">
                                        <option value="">Select City</option>
                                        @foreach (var ct in citiesList)
                                        {
                                            <option value="@ct.cityname">@ct.cityname</option>
                                        }
                                    </select>
                                </div>
                                <div class="cm-field cm-col-6">
                                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <label class="cm-label-top" style="margin-bottom: 0;">Area</label>
                                        <button type="button" style="background: transparent; border: none; color: #4f46e5; cursor: pointer; font-size: 0.75rem; font-weight: 600; padding: 0; display: flex; align-items: center; gap: 4px;" @onclick="OpenAreaModal">
                                            <i class="bi bi-plus-circle-fill"></i> Add New
                                        </button>
                                    </div>
                                    <select @bind="currentDoctor.area" class="cm-input">
                                        <option value="">Select Area</option>
                                        @foreach (var a in areasList)
                                        {
                                            <option value="@a.areaname">@a.areaname</option>
                                        }
                                    </select>
                                </div>

                                <div class="cm-field cm-col-4">
                                    <label class="cm-label-top">Zip</label>
                                    <input type="text" @bind="currentDoctor.zipcode" class="cm-input" placeholder="100101" />
                                </div>
                                <div class="cm-field cm-col-8">
                                    <label class="cm-label-top">Full residential address</label>
                                    <textarea @bind="currentDoctor.address" class="cm-input" rows="1" placeholder="17/19, kuppipalyam road"></textarea>
                                </div>

                                <!-- Doctor Photo Upload (Positioned below Zip & Address) -->
                                <div class="cm-field cm-col-12" style="margin-top: 0.5rem;">
                                    <label class="cm-label-top">Doctor Photo</label>
                                    <div style="display: flex; align-items: center; gap: 8px; width: 100%;">
                                        <label for="doctorPhoto" class="cm-file-upload @(selectedPhotoBytes != null || !string.IsNullOrEmpty(currentDoctor.doctorimage) ? "selected" : "")" style="flex: 1; margin: 0; padding: 6px 12px; cursor: pointer; display: flex; align-items: center; gap: 6px; border: 1px dashed #cbd5e1; border-radius: 8px; background: #f8fafc;">
                                            <span class="material-symbols-outlined" style="font-size: 18px; color: #4f46e5;">cloud_upload</span>
                                            <span>@(selectedPhotoBytes != null ? "Photo Selected" : (string.IsNullOrEmpty(currentDoctor.doctorimage) ? "Select Doctor Photo (.jpg, .png, .webp)" : "Photo Selected"))</span>
                                        </label>
                                        <InputFile id="doctorPhoto" OnChange="OnPhotoSelected" accept=".jpg,.jpeg,.png,.webp" hidden />
                                        @if (!string.IsNullOrEmpty(previewPhotoBase64))
                                        {
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                <img src="data:image/jpeg;base64,@previewPhotoBase64" alt="Photo Preview" style="height: 34px; width: 48px; border-radius: 6px; border: 1px solid #cbd5e1; object-fit: cover;" />
                                                <button type="button" style="background: transparent; border: none; color: #ef4444; font-size: 1.1rem; cursor: pointer; padding: 0 4px; font-weight: bold;" @onclick="RemovePhoto">×</button>
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(currentDoctor.doctorimage))
                                        {
                                            _ = LoadDoctorPhoto(currentDoctor.dcode, currentDoctor.doctorimage, currentDoctor.tenant_code);
                                            if (doctorImagesBase64.TryGetValue(currentDoctor.dcode, out var base64Str))
                                            {
                                                <div style="display: flex; align-items: center; gap: 6px;">
                                                    <img src="data:image/jpeg;base64,@base64Str" alt="Photo" style="height: 34px; width: 48px; border-radius: 6px; border: 1px solid #cbd5e1; object-fit: cover;" />
                                                    <button type="button" style="background: transparent; border: none; color: #ef4444; font-size: 1.1rem; cursor: pointer; padding: 0 4px; font-weight: bold;" @onclick="RemovePhoto">×</button>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>

            <!-- FOOTER WITH ACTIONS -->
            <div class="modal-footer-bar" style="flex-shrink: 0; background: #fafbfc; border-top: 1px solid #e5e7eb; padding: 14px 24px; display: flex; justify-content: flex-end; gap: 12px;">
                @if (currentDoctor.dcode != 0)
                {
                    <button type="button" class="btn-delete" style="margin-right: auto;" @onclick="() => DeleteDoctor(currentDoctor.dcode.ToString())">Delete Doctor</button>
                }
                <button type="button" class="btn-cancel" @onclick="CancelEdit">Cancel</button>
                <button type="submit" class="btn-save">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right:8px;">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                    </svg>
                    <span>Save Doctor</span>
                </button>
            </div>
        </EditForm>
    </div>
</div>
}


    <!-- Header Card -->
    <div class="lab-header-card flex-between">
        <div class="gap-16 display-flex align-center">
            <div class="p-2 bg-indigo-50 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="text-indigo-600 material-symbols-outlined icon-lg">stethoscope</span>
            </div>
            <div>
                <h2 class="m-0 lab-title-text">Doctor Master</h2>
                <div class="gap-8 flex-start mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Medical Professionals & Referrals</span>
                </div>
            </div>
        </div>
        <div class="gap-12 display-flex align-center">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search doctors, code, mobile..." @bind="searchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            <div class="search-controls">
                @if (TenantState.HasActionRight("Configuration", "General", "Create")) { <button class="btn-new-entry" @onclick="CreateNew">+ Add New</button> }
            </div>
        </div>
    </div>

    <!-- Directory Section / Data Table -->
    <div class="directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">S.No</th>
                        <th>DOCTOR DETAILS</th>
                        <th style="width: 140px;">SPECIALTY</th>
                        <th style="width: 150px;">DOCTOR GROUP</th>
                        <th style="width: 130px;">PHONE</th>
                        <th style="width: 120px;">FEE</th>
                        <th style="width: 160px;">REFERENCE</th>
                        <th style="width: 180px;">ADDRESS</th>
                        <th class="text-center" style="width: 110px;">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="9" class="text-center p-24">
                                <DnaLoader IsLoading="true" Overlay="false" Message="Loading Doctors..." />
                            </td>
                        </tr>
                    }
                    else if (FilteredDoctors != null && FilteredDoctors.Any())
                    {
                        int sno = 1;
                        @foreach (var doctor in FilteredDoctors)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@(sno++)</span></td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <div class="avatar" style="width: 36px; height: 36px; border-radius: 50%; overflow: hidden; background: #ecfeff; color: #0891b2; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem; flex-shrink: 0;">
                                            @if (!string.IsNullOrEmpty(doctor.doctorimage))
                                            {
                                                _ = LoadDoctorPhoto(doctor.dcode, doctor.doctorimage, doctor.tenant_code);
                                                if (doctorImagesBase64.TryGetValue(doctor.dcode, out var base64Str))
                                                {
                                                    <img src="data:image/jpeg;base64,@base64Str" style="width: 100%; height: 100%; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <span style="font-size: 0.8rem; color: #94a3b8;"><i class="bi bi-arrow-repeat spin"></i></span>
                                                }
                                            }
                                            else
                                            {
                                                @GetInitials(doctor)
                                            }
                                        </div>
                                        <div style="display: flex; flex-direction: column;">
                                            <div class="td-name" style="display: flex; align-items: center; gap: 0.4rem; font-weight: 700; color: #1e293b; font-size: 13px;">
                                                <span>@(string.IsNullOrWhiteSpace(doctor.name) ? doctor.doctorfullname : doctor.name)</span>
                                                @if (!string.IsNullOrWhiteSpace(doctor.qualification))
                                                {
                                                    <span style="font-size: 0.72rem; color: #64748b; font-weight: 500;">(@doctor.qualification)</span>
                                                }
                                            </div>
                                            <div style="display: flex; align-items: center; gap: 6px; margin-top: 2px;">
                                                @if (doctor.isregular == true)
                                                {
                                                    <span style="font-size: 0.72rem; color: #10b981; font-weight: 600;">Regular</span>
                                                }
                                                @if (doctor.isreferral == true)
                                                {
                                                    <span style="font-size: 0.72rem; color: #2563eb; font-weight: 600;">Referral</span>
                                                }
                                                @if (doctor.isconsultant == true)
                                                {
                                                    <span style="font-size: 0.72rem; color: #d97706; font-weight: 600;">Consultant</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (doctor.spcode > 0)
                                    {
                                        var spName = specialties.FirstOrDefault(s => s.spcode == doctor.spcode)?.name;
                                        if (!string.IsNullOrEmpty(spName))
                                        {
                                            <span style="font-weight: 600; color: #334155; font-size: 0.85rem;">@spName</span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400">-</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">-</span>
                                    }
                                </td>
                                <td>
                                    @if (doctor.group_id.HasValue && doctor.group_id.Value > 0)
                                    {
                                        var grpName = doctorGroups.FirstOrDefault(g => g.group_id == doctor.group_id.Value)?.group_name;
                                        if (!string.IsNullOrEmpty(grpName))
                                        {
                                            <span style="font-weight: 600; color: #334155; font-size: 0.85rem;">@grpName</span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400">-</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(doctor.mobile) || !string.IsNullOrWhiteSpace(doctor.phone))
                                    {
                                        <span class="lc-font-mono font-bold text-slate-800">@(string.IsNullOrWhiteSpace(doctor.mobile) ? doctor.phone : doctor.mobile)</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">-</span>
                                    }
                                </td>
                                <td>
                                    @if (doctor.normalconsultationfee > 0 || doctor.offhoursconsultationfee > 0)
                                    {
                                        <div style="font-size: 0.8rem; color: #0f172a; font-weight: 600;">
                                            ₹@(doctor.normalconsultationfee ?? 0)
                                            @if (doctor.offhoursconsultationfee > 0)
                                            {
                                                <span style="font-size: 0.72rem; color: #64748b; font-weight: 500; display: block;">Offhours: ₹@doctor.offhoursconsultationfee</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(doctor.reference))
                                    {
                                        <span class="font-bold text-slate-800" style="font-size: 0.85rem;">@doctor.reference</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(doctor.address))
                                    {
                                        <span class="text-slate-600" style="font-size: 0.85rem;">@doctor.address</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                     <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px;">
                                         @if (TenantState.HasActionRight("Configuration", "General", "Edit"))
                                         {
                                             <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => EditDoctor(doctor)" title="Edit">
                                                 <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                             </button>
                                             <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => OpenProfileModal(doctor)" title="Profile" style="color: #4f46e5;">
                                                 <span class="material-symbols-outlined font-18 text-slate-400">account_circle</span>
                                             </button>
                                         }
                                         @if (TenantState.HasActionRight("Configuration", "General", "Delete"))
                                         {
                                             <button type="button" class="lc-btn lc-circle-btn-32" @onclick='() => DeleteDoctor(doctor.dcode.ToString())' title="Delete" style="color: #ef4444;">
                                                 <span class="material-symbols-outlined font-18 text-slate-400">delete</span>
                                             </button>
                                         }
                                     </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center p-24">
                                <div class="empty-state-subtle">
                                    <span class="empty-state-dot"></span>
                                    No records found
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


