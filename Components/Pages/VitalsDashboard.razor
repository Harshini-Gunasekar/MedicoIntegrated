            if (ScanTotalCount > 0) { totalPct += ScanCompletionRate; count++; }
            if (EcgTotalCount > 0) { totalPct += EcgCompletionRate; count++; }
            if (count == 0) return 0.0;
            return Math.Round(totalPct / count, 1);
        }
