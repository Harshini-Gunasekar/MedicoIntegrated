    private async void HandleLiveVitalsUpdated(List<MedicoAi.Models.VitalsItem> vitals)
    {
        lastUpdatedTime = DateTime.Now.ToString("hh:mm:ss tt");

        if (vitals != null && vitals.Any())
        {
            var todayList = vitals.Where(v => v != null && v.IsTodayToken()).ToList();

            foreach (var v in todayList)
            {
                string key = v.vitalentryid?.ToString() ?? v.token_no ?? v.id ?? "";
                if (string.IsNullOrEmpty(key)) continue;

                // Detect NEW token generated live via SignalR
                if (!knownTokenKeys.Contains(key))
                {
                    knownTokenKeys.Add(key);

                    if (!isInitialSignalRFetch)
                    {
                        AddToastNotification(new ToastAlertItem
                        {
                            Title = "New Token Generated",
                            PatientName = string.IsNullOrEmpty(v.patient_name) ? "Patient" : v.patient_name,
                            TokenNo = string.IsNullOrEmpty(v.token_no) ? $"00{v.vitalentryid}" : v.token_no,
                            DoctorName = string.IsNullOrEmpty(v.doctor_name) ? "Doctor" : v.doctor_name,
                            TestName = string.IsNullOrEmpty(v.in1) ? "General" : v.in1,
                            Type = "new_token",
                            VitalItem = v
                        });
                    }
                }
            }
            isInitialSignalRFetch = false;
        }

        CheckLongWaitPatients();
        await InvokeAsync(StateHasChanged);
        await RenderChartsAsync();
    }

    private void CheckLongWaitPatients()
    {
        acknowledged20MinTokenIds ??= new();
        acknowledged30MinTokenIds ??= new();
        longWaitVitals ??= new();

        var rawVitals = VitalsSignalR.LatestVitals;
        if (rawVitals != null && rawVitals.Any())
        {
            var todayList = rawVitals.Where(v => v != null && v.IsTodayToken()).ToList();
            var newAlerts = new List<MedicoAi.Models.VitalsItem>();

            foreach (var v in todayList)
            {
                if (v == null) continue;

                // FIX: EXCLUDE COMPLETED PATIENTS FROM WAIT ALERTS
                bool isCompleted = string.Equals(v.status, "completed", StringComparison.OrdinalIgnoreCase) || 
                                   string.Equals(v.in1_status, "completed", StringComparison.OrdinalIgnoreCase);
                if (isCompleted) continue;

                bool isWaiting = string.Equals(v.status, "waiting", StringComparison.OrdinalIgnoreCase) || 
                                 string.Equals(v.in1_status, "waiting_for_test", StringComparison.OrdinalIgnoreCase) ||
                                 string.Equals(v.status, "in_progress", StringComparison.OrdinalIgnoreCase);
                if (!isWaiting) continue;

                double waitMins = v.GetWaitTimeMinutes();
                string key = v.vitalentryid?.ToString() ?? v.token_no ?? v.id ?? "";
                if (string.IsNullOrEmpty(key)) continue;

                // Check 30-minute threshold first
                if (waitMins >= 30.0)
                {
                    if (!acknowledged30MinTokenIds.Contains(key))
                    {
                        newAlerts.Add(v);
                        AddToastNotification(new ToastAlertItem
                        {
                            Title = "Critical 30+ Min Wait Alert",
                            Message = v.CalculateWaitTime(),
                            PatientName = string.IsNullOrEmpty(v.patient_name) ? "Patient" : v.patient_name,
                            TokenNo = string.IsNullOrEmpty(v.token_no) ? $"00{v.vitalentryid}" : v.token_no,
                            DoctorName = string.IsNullOrEmpty(v.doctor_name) ? "Doctor" : v.doctor_name,
                            TestName = string.IsNullOrEmpty(v.in1) ? "Test" : v.in1,
                            Type = "wait_30m",
                            VitalItem = v
                        });
                        acknowledged30MinTokenIds.Add(key);
                    }
                }
                // Check 20-minute threshold
                else if (waitMins >= 20.0)
                {
                    if (!acknowledged20MinTokenIds.Contains(key))
                    {
                        newAlerts.Add(v);
                        AddToastNotification(new ToastAlertItem
                        {
                            Title = "Patient 20+ Min Wait Alert",
                            Message = v.CalculateWaitTime(),
                            PatientName = string.IsNullOrEmpty(v.patient_name) ? "Patient" : v.patient_name,
                            TokenNo = string.IsNullOrEmpty(v.token_no) ? $"00{v.vitalentryid}" : v.token_no,
                            DoctorName = string.IsNullOrEmpty(v.doctor_name) ? "Doctor" : v.doctor_name,
                            TestName = string.IsNullOrEmpty(v.in1) ? "Test" : v.in1,
                            Type = "wait_20m",
                            VitalItem = v
                        });
                        acknowledged20MinTokenIds.Add(key);
                    }
                }
            }

            if (newAlerts.Any())
            {
                longWaitVitals = newAlerts;
            }
        }
    }

