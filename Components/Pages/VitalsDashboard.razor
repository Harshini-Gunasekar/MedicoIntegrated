    private async Task RenderChartsAsync()
    {
        try
        {
            var todayList = SelectedDeptVitals;

            // 1. Doctor-Wise Diagnostic Orders (All Doctors across TodayVitals)
            var allDocGroup = TodayVitals.Where(v => !string.IsNullOrEmpty(v.doctor_name))
                .GroupBy(v => v.doctor_name!.Trim())
                .Select(g => new { Name = g.Key, Count = (double)g.Count() })
                .OrderByDescending(x => x.Count)
                .ToList();

            var docNames = allDocGroup.Any() ? allDocGroup.Select(d => d.Name).ToArray() : new[] { "Duty Doctor" };
            var docCounts = allDocGroup.Any() ? allDocGroup.Select(d => d.Count).ToArray() : new[] { 0.0 };

            // 2. Doctor-Wise Lab vs Scan vs ECG Breakdown
            var topDocs = allDocGroup.Select(d => d.Name).Take(6).ToList();
            if (!topDocs.Any()) topDocs = new List<string> { "Duty Doctor" };

            var labCountsPerDoc = new List<double>();
            var scanCountsPerDoc = new List<double>();
            var ecgCountsPerDoc = new List<double>();

            foreach (var doc in topDocs)
            {
                var docTokens = TodayVitals.Where(v => string.Equals(v.doctor_name?.Trim(), doc, StringComparison.OrdinalIgnoreCase)).ToList();
                labCountsPerDoc.Add(docTokens.Count(IsLabItem));
                scanCountsPerDoc.Add(docTokens.Count(IsScanItem));
                ecgCountsPerDoc.Add(docTokens.Count(IsEcgItem));
            }

            // 3. Hourly Patient Inflow (from Selected Dept Tokens or Today's overall list)
            var inflowList = todayList.Any() ? todayList : TodayVitals;
            var hourLabels = new[] { "08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00" };
            var hourCounts = new double[hourLabels.Length];
            for (int i = 0; i < hourLabels.Length; i++)
            {
                int hr = 8 + i;
                hourCounts[i] = inflowList.Count(v => GetVitalsHour(v) == hr);
            }

            int maxIdx = 0;
            double maxVal = 0;
            for (int i = 0; i < hourCounts.Length; i++)
            {
                if (hourCounts[i] > maxVal)
                {
                    maxVal = hourCounts[i];
                    maxIdx = i;
                }
            }
            peakInflowTime = maxVal > 0 ? $"Peak {hourLabels[maxIdx]}" : "Peak 10:00 AM";

            // Render ALL 6 Charts dynamically matching real API endpoint vitals data
            await JSRuntime.InvokeVoidAsync("dashboardCharts.initHorizontalBarChart", "doctorWiseBarChart", docNames, docCounts);
            await JSRuntime.InvokeVoidAsync("dashboardCharts.initVerticalBarChart", "cardiacOrderBarChart", topDocs.ToArray(), labCountsPerDoc.ToArray(), scanCountsPerDoc.ToArray(), ecgCountsPerDoc.ToArray());
            await JSRuntime.InvokeVoidAsync("dashboardCharts.initHourlyPeakLineChart", "hourlyInflowLineChart", hourLabels, hourCounts);
            await JSRuntime.InvokeVoidAsync("dashboardCharts.initSemiGaugeChart", "cardiologyStatusGaugeChart", LabCompletionRate, ScanCompletionRate, EcgCompletionRate);
            await JSRuntime.InvokeVoidAsync("dashboardCharts.initDurationDonutChart", "recordingDurationDonutChart", LabAvgDuration, ScanAvgDuration, EcgAvgDuration);
            
            if (selectedDepartmentTab == "OVERALL")
            {
                await JSRuntime.InvokeVoidAsync("dashboardCharts.initFullDonutChart", "ecgStatusDonutChart", TodayCompletedCount, TodayInProgressCount, TodayWaitingCount);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("dashboardCharts.initFullDonutChart", "ecgStatusDonutChart", SelectedDeptCompletedCount, SelectedDeptInProgressCount, SelectedDeptWaitingCount);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing dashboard charts: {ex.Message}");
        }
    }

