    private static bool IsTokenCompleted(MedicoAi.Models.VitalsItem v)
    {
        if (v == null) return false;

        static bool CheckStr(string? s)
        {
            if (string.IsNullOrWhiteSpace(s)) return false;
            var clean = s.Trim().ToLowerInvariant();
            return clean == "completed" ||
                   clean == "consulted" ||
                   clean == "finished" ||
                   clean == "verified" ||
                   clean.Contains("report received") ||
                   clean.Contains("report_received") ||
                   clean.Contains("reportreceived") ||
                   clean.Contains("received");
        }

        return CheckStr(v.status) ||
               CheckStr(v.in1_status) ||
               CheckStr(v.in2_status) ||
               CheckStr(v.in3_status) ||
               CheckStr(v.in4_status) ||
               CheckStr(v.in5_status);
    }

