    private (string TimeRange, int PatientCount) CalculatePeakDiagnosticHour()
    {
        var vitals = TodayVitals;
        if (!vitals.Any()) return ("No Tokens", 0);

        var hourGroups = vitals
            .Select(v => GetVitalsHour(v))
            .Where(h => h >= 0 && h <= 23)
            .GroupBy(h => h)
            .Select(g => new { Hour = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Hour)
            .ToList();

        if (!hourGroups.Any()) return ("No Tokens", 0);

        var top = hourGroups.First();
        int startHr = top.Hour;
        int endHr = (startHr + 1) % 24;
        DateTime dtStart = DateTime.Today.AddHours(startHr);
        DateTime dtEnd = DateTime.Today.AddHours(endHr);

        return ($"{dtStart:hh:00 tt} - {dtEnd:hh:00 tt}", top.Count);
    }

    private string TodayPeakHour => CalculatePeakDiagnosticHour().TimeRange;
    private int TodayPeakHourCount => CalculatePeakDiagnosticHour().PatientCount;

