@code {
    public class ToastAlertItem
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Title { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public string PatientName { get; set; } = string.Empty;
        public string TokenNo { get; set; } = string.Empty;
        public string DoctorName { get; set; } = string.Empty;
        public string TestName { get; set; } = string.Empty;
        public string Type { get; set; } = "info"; // new_token, wait_20m, wait_30m
        public DateTime CreatedAt { get; set; } = DateTime.Now;
        public MedicoAi.Models.VitalsItem? VitalItem { get; set; }
    }

    private bool isAiThinking = false;
    private bool showAiModal = false;
    private bool showAiModeMenu = false;
    private bool showWaitAlertModal = false;

    private void ToggleAiModeMenu()
    {
        showAiModeMenu = !showAiModeMenu;
    }

    private void OpenAiModalWithMode(string mode)
    {
        aiInteractionMode = mode;
        showAiModal = true;
        showAiModeMenu = false;
    }
    private int totalTokens = 1;
    private string lastUpdatedTime = DateTime.Now.ToString("h:mm tt");
    private string userPromptInput = string.Empty;

    private List<ChatMessage> chatMessages = new();
    private MedicoAi.Models.DashboardFullResponse dashboardData = new();
    private List<OgQueueItem> rawQueueItems = new();
    private List<MedicoAi.Models.VitalsItem> longWaitVitals = new();
    private List<ToastAlertItem> toastNotifications = new();
    private HashSet<string> knownTokenKeys = new();
    private bool isInitialSignalRFetch = true;

    private string selectedDepartmentTab = "ECG";
    private System.Threading.Timer? _tabAutoRotateTimer;
    private System.Threading.Timer? _autoAlertTimer;
    private readonly CancellationTokenSource _cts = new();

    private HashSet<string> acknowledged20MinTokenIds = new();
    private HashSet<string> acknowledged30MinTokenIds = new();

    private void AddToastNotification(ToastAlertItem toast)
    {
        toastNotifications.Insert(0, toast);
        if (toastNotifications.Count > 10)
        {
            toastNotifications.RemoveAt(toastNotifications.Count - 1);
        }

        // Play notification audio alert chime
        _ = Task.Run(async () =>
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("playAlertSound", toast.Type);
            }
            catch { }
        });

        _ = Task.Run(async () =>
        {
            await Task.Delay(8000);
            await InvokeAsync(() =>
            {
                toastNotifications.RemoveAll(t => t.Id == toast.Id);
                StateHasChanged();
            });
        });
    }

    private string peakInflowTime = "Peak 10:00 AM";

    private int GetVitalsHour(MedicoAi.Models.VitalsItem v)
    {
        if (!string.IsNullOrEmpty(v.arrival_time))
        {
            if (DateTime.TryParse(v.arrival_time, out var dtArr))
                return dtArr.Hour;
        }
        if (!string.IsNullOrEmpty(v.created_at))
        {
            if (DateTimeOffset.TryParse(v.created_at, out var dtoCreated))
                return dtoCreated.LocalDateTime.Hour;
        }
        if (!string.IsNullOrEmpty(v.entered_date))
        {
            if (DateTimeOffset.TryParse(v.entered_date, out var dtoEntered))
                return dtoEntered.LocalDateTime.Hour;
        }
        return -1;
    }

    private void DismissToast(string id)
    {
        toastNotifications.RemoveAll(t => t.Id == id);
        StateHasChanged();
    }

    private List<MedicoAi.Models.VitalsItem> TodayVitals =>
        VitalsSignalR.LatestVitals?.Where(v => v != null && v.IsTodayToken()).ToList() ?? new List<MedicoAi.Models.VitalsItem>();

    private bool IsLabItem(MedicoAi.Models.VitalsItem v)
    {
        var combined = $"{v.in1} {v.in2} {v.in3} {v.in4} {v.in5} {v.test_name}".ToLowerInvariant();
        return combined.Contains("lab") || combined.Contains("blood") || combined.Contains("urine") || combined.Contains("pathology") || combined.Contains("bio");
    }

    private bool IsScanItem(MedicoAi.Models.VitalsItem v)
    {
        var combined = $" {v.in1} {v.in2} {v.in3} {v.in4} {v.in5} {v.test_name} ".ToLowerInvariant();
        if (combined.Contains("scan") || combined.Contains("xray") || combined.Contains("x-ray") || combined.Contains("mri") || combined.Contains("usg") || combined.Contains("ultrasound") || combined.Contains("radiology"))
            return true;

        if (combined.Contains(" ct ") || combined.Contains("ct-scan") || combined.Contains("ct scan") || combined.Contains("ct_scan"))
            return true;

        return false;
    }

    private bool IsEcgItem(MedicoAi.Models.VitalsItem v)
    {
        var combined = $"{v.in1} {v.in2} {v.in3} {v.in4} {v.in5} {v.test_name}".ToLowerInvariant();
        if (combined.Contains("ecg") || combined.Contains("echo") || combined.Contains("tmt") || combined.Contains("cardiac") || combined.Contains("cardio") || combined.Contains("heart") || combined.Contains("vitals"))
            return true;

        // Fallback: If token has investigation status (in1_status, in2_status...) and is neither LAB nor SCAN
        if (!IsLabItem(v) && !IsScanItem(v))
        {
            bool hasInvestigation = !string.IsNullOrEmpty(v.in1_status) || !string.IsNullOrEmpty(v.in2_status) || !string.IsNullOrEmpty(v.in3_status);
            if (hasInvestigation && !string.Equals(v.in1, "DOCTOR", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }
        return false;
    }

    public class DoctorAvgTimeInfo
    {
        public string DoctorName { get; set; } = string.Empty;
        public double AvgMins { get; set; }
        public int TokenCount { get; set; }
    }

    private List<DoctorAvgTimeInfo> DoctorAvgTimes
    {
        get
        {
            var vitals = TodayVitals;
            if (!vitals.Any()) return new List<DoctorAvgTimeInfo>();

            return vitals
                .Where(v => !string.IsNullOrEmpty(v.doctor_name))
                .GroupBy(v => NormalizeDocName(v.doctor_name))
                .Select(g => new DoctorAvgTimeInfo
                {
                    DoctorName = g.Key,
                    AvgMins = Math.Round(g.Average(v => v.GetWaitTimeMinutes()), 1),
                    TokenCount = g.Count()
                })
                .OrderBy(x => x.AvgMins)
                .ToList();
        }
    }

    public class DoctorStatusInfo
    {
        public string DoctorName { get; set; } = string.Empty;
        public int CompletedCount { get; set; }
        public int PendingCount { get; set; }
        public int TotalCount { get; set; }
    }

    private List<DoctorStatusInfo> DoctorStatusBreakdown
    {
        get
        {
            var vitals = SelectedDeptVitals;
            if (!vitals.Any()) return new List<DoctorStatusInfo>();

            return vitals
                .Where(v => !string.IsNullOrEmpty(v.doctor_name))
                .GroupBy(v => NormalizeDocName(v.doctor_name))
                .Select(g => new DoctorStatusInfo
                {
                    DoctorName = g.Key,
                    CompletedCount = g.Count(v => IsReportReceivedVital(v) || IsTokenCompleted(v)),
                    PendingCount = g.Count(v => !IsReportReceivedVital(v) && !IsTokenCompleted(v)),
                    TotalCount = g.Count()
                })
                .OrderByDescending(x => x.TotalCount)
                .ToList();
        }
    }

