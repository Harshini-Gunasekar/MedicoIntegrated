            _ = Task.Run(async () =>
            {
                for (int i = 5; i > 0; i--)
                {
                    await InvokeAsync(() => { voiceAutoSendCountdown = i; StateHasChanged(); });
                    await Task.Delay(1000);
                }
                await InvokeAsync(async () =>
                {
                    voiceAutoSendCountdown = 0;
                    if (!string.IsNullOrWhiteSpace(speechTranscript))
                        await SubmitVoiceQuery();
                    StateHasChanged();
                });
            });
        }
    }

    private async Task SubmitVoiceQuery()
    {
        if (string.IsNullOrWhiteSpace(speechTranscript)) return;
        
        userPromptInput = speechTranscript;
        await SubmitAiQuery();

        if (chatMessages.Any())
        {
            var lastMsg = chatMessages.LastOrDefault(m => m.Sender != "User");
            if (lastMsg != null)
            {
                lastAiVoiceResponse = lastMsg.Text;
                await SpeakText(lastMsg.Text);
            }
        }
    }

    private async Task SpeakText(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        await JSRuntime.InvokeVoidAsync("MedicoSpeech.speakText", text, selectedVoiceLang);
    }

    private async Task PresetQuery(string query)
    {
        userPromptInput = query;
        await SubmitAiQuery();
    }

    private async Task SubmitAiQuery()
    {
        if (string.IsNullOrWhiteSpace(userPromptInput) || isAiThinking) return;

        var prompt = userPromptInput.Trim();
        userPromptInput = string.Empty;

        chatMessages.Add(new ChatMessage { Sender = "User", Text = prompt });
        isAiThinking = true;
        StateHasChanged();

        var aiAnswer = await AiService.AskAiAsync(prompt, Session.DoctorName);

        isAiThinking = false;
        chatMessages.Add(new ChatMessage { Sender = "Medico AI", Text = aiAnswer });
        StateHasChanged();

        // If in voice mode, automatically read out response
        if (aiInteractionMode == "voice")
        {
            lastAiVoiceResponse = aiAnswer;
            await SpeakText(aiAnswer);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitAiQuery();
        }
    }

    private string FormattedMessageText(string rawText)
    {
        if (string.IsNullOrEmpty(rawText)) return string.Empty;
        var formatted = System.Web.HttpUtility.HtmlEncode(rawText);
        formatted = formatted.Replace("\n", "<br />");
        formatted = System.Text.RegularExpressions.Regex.Replace(formatted, @"\*\*(.*?)\*\*", "<strong>$1</strong>");
        return formatted;
    }

    public void Dispose()
    {
        dotNetHelper?.Dispose();
        VitalsSignalR.OnVitalsUpdated -= HandleLiveVitalsUpdated;
        VitalsSignalR.StopLiveStream();
        _autoAlertTimer?.Dispose();
        _tabAutoRotateTimer?.Dispose();
        _cts.Cancel();
    }
}
