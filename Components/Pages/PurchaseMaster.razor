    private List<PurchaseMasterModel> ParseMasterListResponse(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        var options = new System.Text.Json.JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };
        
        try {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            
            JsonElement arrayElement;
            if (root.ValueKind == System.Text.Json.JsonValueKind.Array) {
                arrayElement = root;
            } else if (root.ValueKind == System.Text.Json.JsonValueKind.Object) {
                if (root.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == System.Text.Json.JsonValueKind.Array) {
                    arrayElement = dataProp;
                } else {
                    // Search for any property that is an array
                    bool found = false;
                    arrayElement = default;
                    foreach (var prop in root.EnumerateObject()) {
                        if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.Array) {
                            arrayElement = prop.Value;
                            found = true;
                            break;
                        }
                    }
                    if (!found) return new();
                }
            } else return new();

            var result = new List<PurchaseMasterModel>();
            foreach (var item in arrayElement.EnumerateArray()) {
                var m = MapFuzzyMaster(item, options);
                if (m != null) result.Add(m);
            }
            return result.OrderByDescending(x => x.billdate).ToList();
        } catch (Exception ex) {
            Console.WriteLine("Parse Error: " + ex.Message);
        }
 
        return new();
    }

    private static bool TryGetPropertyIgnoreCase(System.Text.Json.JsonElement el, string name, out System.Text.Json.JsonElement prop)
    {
        prop = default;
        if (el.ValueKind != System.Text.Json.JsonValueKind.Object) return false;
        foreach (var p in el.EnumerateObject()) {
            if (string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase)) {
                prop = p.Value;
                return true;
            }
        }
        return false;
    }

    private PurchaseMasterModel? MapFuzzyMaster(System.Text.Json.JsonElement el, System.Text.Json.JsonSerializerOptions options)
    {
        // 1. Try to unwrap "master" if it exists
        var target = el;
        if (TryGetPropertyIgnoreCase(el, "master", out var mProp)) target = mProp;

        var m = System.Text.Json.JsonSerializer.Deserialize<PurchaseMasterModel>(target.GetRawText(), options);
        if (m == null) return null;

        // 2. Fuzzy map ID (billno)
        if (string.IsNullOrEmpty(m.billno)) {
            foreach(var key in new[] { "billno", "purchasecode", "code", "id", "prmbillno", "purchase_code", "bill_no" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    var val = p.ValueKind == System.Text.Json.JsonValueKind.Number ? p.ToString() : p.GetString();
                    if (!string.IsNullOrEmpty(val)) {
                        m.billno = val;
                        break;
                    }
                }
            }
        }

        // 3. Fuzzy map Date
        if (m.billdate == default(DateTime)) {
            foreach(var key in new[] { "billdate", "date", "purchasedate", "prmbilldate" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) && p.TryGetDateTime(out var d)) {
                    m.billdate = d;
                    break;
                }
            }
        }

        // 4. Fuzzy map Amount (netamount)
        if (m.netamount == 0) {
            foreach(var key in new[] { "netamount", "total", "totalamount", "prmnetamount" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.netamount = p.GetDecimal();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) {
                        m.netamount = val;
                        break;
                    }
                }
            }
        }

        // 5. Fuzzy map Round Off (roundoff)
        if (m.roundoff == 0) {
            foreach(var key in new[] { "roundoff", "prmroundoff", "round_off" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.roundoff = p.GetDecimal();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) {
                        m.roundoff = val;
                        break;
                    }
                }
            }
        }

        // 6. Fuzzy map Gross Amount (grossamount)
        if (m.grossamount == 0) {
            foreach(var key in new[] { "grossamount", "prmgrossamount", "gross_amount" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.grossamount = p.GetDecimal();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) {
                        m.grossamount = val;
                        break;
                    }
                }
            }
        }

        // 7. Fuzzy map Discount Amount (discountamount)
        if (m.discountamount == 0) {
            foreach(var key in new[] { "discountamount", "prmdiscountamount", "discount_amount" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.discountamount = p.GetDecimal();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) {
                        m.discountamount = val;
                        break;
                    }
                }
            }
        }

        // 8. Fuzzy map Tax Amount (taxamount)
        if (m.taxamount == 0) {
            foreach(var key in new[] { "taxamount", "prmtaxamount", "tax_amount" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.taxamount = p.GetDecimal();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) {
                        m.taxamount = val;
                        break;
                    }
                }
            }
        }

        // 9. Fuzzy map Vendor Code (vendorcode)
        if (m.vendorcode == null || m.vendorcode == 0) {
            foreach(var key in new[] { "vendorcode", "prmvendorcode", "vendor_code" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.vendorcode = p.GetInt32();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && int.TryParse(p.GetString(), out var val)) {
                        m.vendorcode = val;
                        break;
                    }
                }
            }
        }

        // 11. Fuzzy map Purchase Code (purchasecode)
        if (m.purchasecode == 0) {
            foreach(var key in new[] { "purchasecode", "prmpurchasecode", "purchase_code", "id" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.purchasecode = p.GetInt64();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && long.TryParse(p.GetString(), out var val)) {
                        m.purchasecode = val;
                        break;
                    }
                }
            }
        }

        // 12. Fuzzy map Payment Mode (paymentmode)
        if (string.IsNullOrEmpty(m.paymentmode)) {
            foreach(var key in new[] { "paymentmode", "prmpaymentmode", "payment_mode" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    m.paymentmode = p.GetString();
                    break;
                }
            }
        }

        // 13. Fuzzy map Payment Status (paymentstatus)
        if (string.IsNullOrEmpty(m.paymentstatus)) {
            foreach(var key in new[] { "paymentstatus", "prmpaymentstatus", "payment_status" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    m.paymentstatus = p.GetString();
                    break;
                }
            }
        }

        return m;
    }

