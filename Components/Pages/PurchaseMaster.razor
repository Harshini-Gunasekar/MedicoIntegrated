    {
        var key = detail.GetHashCode();
        if (ExpiryDateTexts.TryGetValue(key, out var text))
        {
            return text;
        }
        return detail.expirydate.HasValue ? detail.expirydate.Value.ToString("MM/yy") : string.Empty;
    }

    private void OnExpiryDateInput(PurchaseDetailModel detail, string? val)
    {
        var key = detail.GetHashCode();
        if (string.IsNullOrEmpty(val))
        {
            ExpiryDateTexts[key] = string.Empty;
            detail.expirydate = null;
            return;
        }

        string formatted = FormatExpiryInput(val);
        ExpiryDateTexts[key] = formatted;

        // Parse into detail.expirydate when full MM/YY is provided
        if (formatted.Length == 5 && formatted.Contains('/'))
        {
            var parts = formatted.Split('/');
            if (parts.Length == 2 && int.TryParse(parts[0], out int month) && int.TryParse(parts[1], out int yy))
            {
                if (month >= 1 && month <= 12)
                {
                    int year = 2000 + yy;
                    int days = DateTime.DaysInMonth(year, month);
                    var parsedDate = new DateTime(year, month, days);
                    detail.expirydate = parsedDate;
                    if (parsedDate.Date < DateTime.Today)
                    {
                        var itemName = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname 
                            ?? (ItemSearchTexts.TryGetValue(key, out var tName) && !string.IsNullOrWhiteSpace(tName) ? tName : "Item");
                        ToastService.ShowError($"Medicine '{itemName}' entered expiry date ({formatted}) is expired. Expired medicines cannot be purchased.");
                    }
                    StateHasChanged();
                    return;
                }
            }
        }
        detail.expirydate = null;
        StateHasChanged();
    }

    private string FormatExpiryInput(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;

        var clean = raw.Trim();
        
        // Handle full year YYYY-MM or MM/YYYY
        if (clean.Contains('-'))
        {
            var dashParts = clean.Split('-');
            if (dashParts.Length >= 2 && dashParts[0].Length == 4) // YYYY-MM
            {
                if (int.TryParse(dashParts[0], out int y4) && int.TryParse(dashParts[1], out int m2))
                {
                    return $"{m2:D2}/{y4 % 100:D2}";
                }
            }
        }

        // If user typed single digit month followed by slash (e.g., "3/" or "3/28")
        if (clean.Contains('/'))
        {
            var slashParts = clean.Split('/');
            if (slashParts.Length >= 1 && slashParts[0].Length == 1 && int.TryParse(slashParts[0], out int singleM) && singleM >= 1 && singleM <= 9)
            {
                clean = "0" + slashParts[0] + (slashParts.Length > 1 ? "/" + slashParts[1] : "/");
            }
        }

        var digitsOnly = new string(clean.Where(char.IsDigit).ToArray());
        if (digitsOnly.Length == 0) return string.Empty;

        // If 6 digits like 042026 (MMYYYY)
        if (digitsOnly.Length == 6)
        {
            var mm6 = digitsOnly.Substring(0, 2);
            var yy6 = digitsOnly.Substring(4, 2);
            return mm6 + "/" + yy6;
        }

        if (digitsOnly.Length > 4)
        {
            digitsOnly = digitsOnly.Substring(0, 4);
        }

        // If first digit is 2-9, auto prepend 0 (e.g. '3' -> '03')
        if (digitsOnly.Length == 1 && digitsOnly[0] > '1')
        {
            digitsOnly = "0" + digitsOnly;
        }

        if (digitsOnly.Length <= 2)
        {
            if (digitsOnly.Length == 2)
            {
                if (int.TryParse(digitsOnly, out int m))
                {
                    if (m > 12) digitsOnly = "12";
                    else if (m == 0) digitsOnly = "01";
                }
                return digitsOnly + "/";
            }
            return digitsOnly;
        }
        else
        {
            var mm = digitsOnly.Substring(0, 2);
            if (int.TryParse(mm, out int m))
            {
                if (m > 12) mm = "12";
                else if (m == 0) mm = "01";
            }
            var yy = digitsOnly.Substring(2);
            return mm + "/" + yy;
        }
    }

    private void OnExpiryDateChange(PurchaseDetailModel detail, string? val)
    {
        OnExpiryDateInput(detail, val);
        if (detail.expirydate.HasValue && detail.expirydate.Value.Date < DateTime.Today)
        {
            var key = detail.GetHashCode();
            var itemName = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname 
                ?? (ItemSearchTexts.TryGetValue(key, out var tName) && !string.IsNullOrWhiteSpace(tName) ? tName : "Item");
            var expStr = detail.expirydate.Value.ToString("MM/yy", System.Globalization.CultureInfo.InvariantCulture);
            ToastService.ShowError($"Medicine '{itemName}' entered expiry date ({expStr}) is expired. Expired medicines cannot be purchased.");
            StateHasChanged();
        }
    }
    
    private string DefaultTenant = "";

    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 12;

    private IEnumerable<PurchaseMasterModel> FilteredPurchases => 
        string.IsNullOrWhiteSpace(SearchQuery) 
            ? PurchaseList 
            : PurchaseList.Where(p => 
                (p.billno?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.purchasecode.ToString().Contains(SearchQuery)) ||
                (VendorList.FirstOrDefault(v => v.vendorCode == p.vendorcode)?.vendorName?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<PurchaseMasterModel> PagedPurchases => 
        FilteredPurchases.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    private int TotalPages => (int)Math.Ceiling((double)FilteredPurchases.Count() / ItemsPerPage);

    private IEnumerable<int> GetVisiblePageNumbers()
    {
        int total = TotalPages;
        int current = CurrentPage;

        if (total <= 3)
        {
            return Enumerable.Range(1, Math.Max(1, total));
        }

        int start = current - 1;
        if (current <= 1)
        {
            start = 1;
        }
        else if (current >= total)
        {
            start = total - 2;
        }

        start = Math.Max(1, Math.Min(start, total - 2));
        return Enumerable.Range(start, 3);
    }

    private bool hasViewRight = true;
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
            
            try
            {
                bool isAdmin = false;
                try
                {
                    var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userResult.Success && userResult.Value != null)
                    {
                        isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                  userResult.Value.UserCode == 0 ||
                                  userResult.Value.UserCode == 1;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking user details: {ex.Message}");
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                    hasEditRight = true;
                    hasDeleteRight = true;
                }
                else
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var pageRight = rightsResult.Value.FirstOrDefault(r => 
                            r.ModuleName != null && 
                            r.ModuleName.Trim().Equals("Purchase_Purchase", StringComparison.OrdinalIgnoreCase));
                        
                        if (pageRight != null)
                        {
                            hasViewRight = pageRight.ToView;
                            hasCreateRight = pageRight.ToAdd;
                            hasEditRight = pageRight.ToEdit;
                            hasDeleteRight = pageRight.ToDelete;
                        }
                        else
                        {
                            hasViewRight = false;
                            hasCreateRight = false;
                            hasEditRight = false;
                            hasDeleteRight = false;
                        }
                    }
                    else
                    {
                        hasViewRight = false;
                        hasCreateRight = false;
                        hasEditRight = false;
                        hasDeleteRight = false;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking Purchase_Purchase rights: {ex.Message}");
                hasViewRight = false;
                hasCreateRight = false;
                hasEditRight = false;
                hasDeleteRight = false;
            }

            if (!hasViewRight)
            {
                ToastService.ShowError("You do not have permission to access Purchase Purchase.");
                Nav.NavigateTo("/home");
                return;
            }

            await Task.WhenAll(
                LoadPurchases(), 
                LoadVendors(), 
                LoadItems(), 
                LoadWarehouses(), 
                LoadManufacturers(), 
                LoadLabSetting(),
                LoadParentCategories(),
                LoadCategories(),
                LoadUoms(),
                LoadLedgerGroups(),
                LoadLedgerTypes()
            );
            StateHasChanged();
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        // Ensure the header is present and correctly cased if necessary, 
        // though lowercase 'tenantcode' is common in this project's existing code.
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        return client;
    }

    private List<PurchaseRequest> FullPurchaseRequests = new();

    private async Task LoadPurchases()
    {
        IsLoading = true;
        try {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallpurchases");
            
            if (!string.IsNullOrWhiteSpace(response)) {
                var fullList = ParseFullRequestList(response);
                if (fullList != null) {
                    FullPurchaseRequests = fullList;
                } else {
                    try {
                        using var doc = System.Text.Json.JsonDocument.Parse(response);
                        var root = doc.RootElement;
                        if (root.ValueKind == System.Text.Json.JsonValueKind.Object && TryGetPropertyIgnoreCase(root, "data", out var d)) root = d;
                        if (root.ValueKind == System.Text.Json.JsonValueKind.Array) {
                            var list = new List<PurchaseRequest>();
                            foreach (var item in root.EnumerateArray()) {
                                var req = ParseRequestResponse(item.GetRawText());
                                if (req != null) list.Add(req);
                            }
                            FullPurchaseRequests = list;
                        }
                    } catch { }
                }

                var masterList = ParseMasterListResponse(response);
                PurchaseList = masterList ?? new();
            }
        } catch (Exception ex) {
            ToastService.ShowError($"Load Error: {ex.Message}");
        } finally {
            IsLoading = false;
        }
    }

    private List<PurchaseRequest>? ParseFullRequestList(string json)
    {
        var options = new System.Text.Json.JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };
        try {
            var direct = System.Text.Json.JsonSerializer.Deserialize<List<PurchaseRequest>>(json, options);
            if (direct != null && direct.Any() && direct[0].master != null) return direct;
        } catch { }
        try {
            var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<PurchaseRequest>>>(json, options);
            if (wrapped?.data != null && wrapped.data.Any()) return wrapped.data;
        } catch { }
        return null;
    }

    private List<PurchaseMasterModel> ParseMasterListResponse(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        var options = new System.Text.Json.JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };
        
        try {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            
            JsonElement arrayElement;
            if (root.ValueKind == System.Text.Json.JsonValueKind.Array) {
                arrayElement = root;
            } else if (root.ValueKind == System.Text.Json.JsonValueKind.Object) {
                if (root.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == System.Text.Json.JsonValueKind.Array) {
                    arrayElement = dataProp;
                } else {
                    // Search for any property that is an array
                    bool found = false;
                    arrayElement = default;
                    foreach (var prop in root.EnumerateObject()) {
                        if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.Array) {
                            arrayElement = prop.Value;
                            found = true;
                            break;
                        }
                    }
                    if (!found) return new();
                }
            } else return new();

            var result = new List<PurchaseMasterModel>();
            foreach (var item in arrayElement.EnumerateArray()) {
                var m = MapFuzzyMaster(item, options);
                if (m != null) result.Add(m);
            }
            return result.OrderByDescending(x => x.billdate).ToList();
        } catch (Exception ex) {
            Console.WriteLine("Parse Error: " + ex.Message);
        }
 
        return new();
    }

    private static bool TryGetPropertyIgnoreCase(System.Text.Json.JsonElement el, string name, out System.Text.Json.JsonElement prop)
    {
        prop = default;
        if (el.ValueKind != System.Text.Json.JsonValueKind.Object) return false;
        foreach (var p in el.EnumerateObject()) {
            if (string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase)) {
                prop = p.Value;
                return true;
            }
        }
        return false;
    }

    private PurchaseMasterModel? MapFuzzyMaster(System.Text.Json.JsonElement el, System.Text.Json.JsonSerializerOptions options)
    {
        // 1. Try to unwrap "master" if it exists
        var target = el;
        if (TryGetPropertyIgnoreCase(el, "master", out var mProp)) target = mProp;

        var m = System.Text.Json.JsonSerializer.Deserialize<PurchaseMasterModel>(target.GetRawText(), options);
        if (m == null) return null;

        // 2. Fuzzy map ID (billno)
        if (string.IsNullOrEmpty(m.billno)) {
            foreach(var key in new[] { "billno", "purchasecode", "code", "id", "prmbillno", "purchase_code", "bill_no" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    var val = p.ValueKind == System.Text.Json.JsonValueKind.Number ? p.ToString() : p.GetString();
                    if (!string.IsNullOrEmpty(val)) {
                        m.billno = val;
                        break;
                    }
                }
            }
        }

        // 3. Fuzzy map Date
        if (m.billdate == default(DateTime)) {
            foreach(var key in new[] { "billdate", "date", "purchasedate", "prmbilldate" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p) && p.TryGetDateTime(out var d)) {
                    m.billdate = d;
                    break;
                }
            }
        }

        // 4. Fuzzy map Amount (netamount)
        if (m.netamount == 0) {
            foreach(var key in new[] { "netamount", "total", "totalamount", "prmnetamount" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.netamount = p.GetDecimal();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) {
                        m.netamount = val;
                        break;
                    }
                }
            }
        }

        // 5. Fuzzy map Round Off (roundoff)
        if (m.roundoff == 0) {
            foreach(var key in new[] { "roundoff", "prmroundoff", "round_off" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.roundoff = p.GetDecimal();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) {
                        m.roundoff = val;
                        break;
                    }
                }
            }
        }

        // Fuzzy map Overall Discount (overalldiscount)
        if (m.overalldiscount == 0) {
            foreach(var key in new[] { "overalldiscount", "prmoveralldiscount", "overall_discount", "discountpercent", "discount_percentage" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.overalldiscount = p.GetDecimal();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) {
                        m.overalldiscount = val;
                        break;
                    }
                }
            }
        }

        // 6. Fuzzy map Gross Amount (grossamount)
        if (m.grossamount == 0) {
            foreach(var key in new[] { "grossamount", "prmgrossamount", "gross_amount" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.grossamount = p.GetDecimal();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) {
                        m.grossamount = val;
                        break;
                    }
                }
            }
        }

        // 7. Fuzzy map Discount Amount (discountamount)
        if (m.discountamount == 0) {
            foreach(var key in new[] { "discountamount", "prmdiscountamount", "discount_amount" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.discountamount = p.GetDecimal();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) {
                        m.discountamount = val;
                        break;
                    }
                }
            }
        }

        // 8. Fuzzy map Tax Amount (taxamount)
        if (m.taxamount == 0) {
            foreach(var key in new[] { "taxamount", "prmtaxamount", "tax_amount" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.taxamount = p.GetDecimal();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) {
                        m.taxamount = val;
                        break;
                    }
                }
            }
        }

        // 9. Fuzzy map Vendor Code (vendorcode)
        if (m.vendorcode == null || m.vendorcode == 0) {
            foreach(var key in new[] { "vendorcode", "prmvendorcode", "vendor_code" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.vendorcode = p.GetInt32();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && int.TryParse(p.GetString(), out var val)) {
                        m.vendorcode = val;
                        break;
                    }
                }
            }
        }

        // 11. Fuzzy map Purchase Code (purchasecode)
        if (m.purchasecode == 0) {
            foreach(var key in new[] { "purchasecode", "prmpurchasecode", "purchase_code", "id" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number) {
                        m.purchasecode = p.GetInt64();
                        break;
                    } else if (p.ValueKind == System.Text.Json.JsonValueKind.String && long.TryParse(p.GetString(), out var val)) {
                        m.purchasecode = val;
                        break;
                    }
                }
            }
        }

        // 12. Fuzzy map Payment Mode (paymentmode)
        if (string.IsNullOrEmpty(m.paymentmode)) {
            foreach(var key in new[] { "paymentmode", "prmpaymentmode", "payment_mode" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    m.paymentmode = p.GetString();
                    break;
                }
            }
        }

        // 13. Fuzzy map Payment Status (paymentstatus)
        if (string.IsNullOrEmpty(m.paymentstatus)) {
            foreach(var key in new[] { "paymentstatus", "prmpaymentstatus", "payment_status" }) {
                if (TryGetPropertyIgnoreCase(target, key, out var p)) {
                    m.paymentstatus = p.GetString();
                    break;
                }
            }
        }

        return m;
    }

