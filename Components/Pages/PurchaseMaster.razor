    private void AddNewPurchase()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add purchases.");
            return;
        }
        IsEdit = false;
        
        // Calculate GRN / bill number based on total number of bills for the respective tenant (Format: #YYYYXXXX)
        int currentYear = DateTime.Now.Year;
        string yearPrefix = $"#{currentYear}";
        
        var tenantPurchases = PurchaseList
            .Where(p => string.Equals(p.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase))
            .ToList();

        long tenantSeq = tenantPurchases.Count + 1;

        // Ensure no duplicate if billno with the same prefix exists
        var yearTenantPurchases = tenantPurchases
            .Where(p => !string.IsNullOrWhiteSpace(p.billno) && p.billno.StartsWith(yearPrefix, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (yearTenantPurchases.Any())
        {
            long maxSeq = 0;
            foreach (var p in yearTenantPurchases)
            {
                var numPart = p.billno.Substring(yearPrefix.Length);
                if (long.TryParse(numPart, out var parsed))
                {
                    if (parsed > maxSeq) maxSeq = parsed;
                }
            }
            if (maxSeq >= tenantSeq) tenantSeq = maxSeq + 1;
        }

        string nextGrnNo = $"{yearPrefix}{tenantSeq:D4}";

        CurrentRequest = new PurchaseRequest { 
            master = new PurchaseMasterModel { 
                billno = nextGrnNo,
                tenantcode = DefaultTenant, 
                billdate = DateTime.Now.Date,
                paymentmode = "Cash",
                paymentstatus = "Pending",
                usercode = null,
                branchcode = "BLR001",
                companycode = "CMP001"
            },
            details = new List<PurchaseDetailModel>()
        };
        // Reset manual bill totals
        ManualGross = 0;
        ManualDiscount = 0;
        ManualTax = 0;
        ManualNetAmount = 0;
        EditableRows.Clear();
        ItemSearchTexts.Clear();
        MfrSearchTexts.Clear();
        NewDetailItem = new PurchaseDetailModel { tenantcode = DefaultTenant };
        AddDetailRow();
        ShowModal = true;
    }

    private async Task EditPurchase(PurchaseMasterModel master)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit purchases.");
            return;
        }
        IsEdit = true;
        // Try multiple ID variations for the fetch
        var ids = new List<string?>();
        if (master.purchasecode > 0) ids.Add(master.purchasecode.ToString());
        if (!string.IsNullOrEmpty(master.billno)) ids.Add(master.billno);
        if (!string.IsNullOrEmpty(master.invoiceno)) ids.Add(master.invoiceno);
        
        // Remove duplicates and nulls
        ids = ids.Where(x => !string.IsNullOrEmpty(x)).Distinct().ToList();

        if (!ids.Any()) {
            ToastService.ShowWarning("Cannot edit: ID not found");
            return;
        }
        bool fetchSuccess = false;
        var attemptLogs = new List<string>();

        foreach (var id in ids) {
            var isNumeric = long.TryParse(id, out long numericId);
            var variations = new List<(string url, HttpMethod method, object? body)>();
            
            if (isNumeric) {
                variations.Add(($"api/ItemMaster/getpurchasebycode?purchasecode={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"api/ItemMaster/getpurchasebycode?purchaseCode={id}&tenantCode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"api/ItemMaster/getpurchasebycode/{id}?tenantcode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"api/ItemMaster/getpurchasebyid?purchasecode={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"api/ItemMaster/getpurchasebycode", HttpMethod.Post, new { purchasecode = numericId, tenantcode = DefaultTenant }));
                variations.Add(($"api/ItemMaster/getpurchase?purchasecode={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"Purchase/getpurchasebycode?purchasecode={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"api/ItemMaster/getpurchasebycode?purchasecode={id}", HttpMethod.Get, null));
                variations.Add(($"api/ItemMaster/getpurchasebycode/{id}", HttpMethod.Get, null));
            } else {
                variations.Add(($"api/ItemMaster/getpurchasebycode?billno={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"api/ItemMaster/getpurchasebycode?billNo={id}&tenantCode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"api/ItemMaster/getpurchasebycode", HttpMethod.Post, new { billno = id, tenantcode = DefaultTenant }));
                variations.Add(($"api/ItemMaster/getpurchase?billno={id}&tenantcode={DefaultTenant}", HttpMethod.Get, null));
                variations.Add(($"api/ItemMaster/getpurchasebycode?billno={id}", HttpMethod.Get, null));
            }

            foreach (var v in variations) {
                try {
                    var client = CreateClient();
                    HttpResponseMessage response;
                    if (v.method == HttpMethod.Get) {
                        response = await client.GetAsync(v.url);
                    } else {
                        response = await client.PostAsJsonAsync(v.url, v.body);
                    }

                    var statusInfo = $"URL: {v.url} ({v.method}) -> Status: {(int)response.StatusCode}";
                    attemptLogs.Add(statusInfo);
                    Console.WriteLine($"[EditPurchase Diagnostic] {statusInfo}");

                    if (response.IsSuccessStatusCode) {
                        var responseString = await response.Content.ReadAsStringAsync();
                        Console.WriteLine($"[EditPurchase Diagnostic] URL: {v.url} -> Raw JSON response: {responseString}");
                        var loaded = ParseRequestResponse(responseString);
                        if (loaded != null) {
                            CurrentRequest = loaded;
                            // Dates are now DateTime?, no string normalization needed
                            fetchSuccess = true;
                            break;
                        } else {
                            attemptLogs.Add($"  -> Succeeded but ParseRequestResponse returned null. JSON length: {responseString.Length}");
                        }
                    } else {
                        var errorBody = await response.Content.ReadAsStringAsync();
                        attemptLogs.Add($"  -> Failed Status: {(int)response.StatusCode}. Error: {errorBody}");
                        if (response.StatusCode == System.Net.HttpStatusCode.BadRequest || response.StatusCode == System.Net.HttpStatusCode.InternalServerError) {
                            Console.WriteLine($"[EditPurchase Diagnostic] Endpoint returned error {(int)response.StatusCode}. Breaking early to prevent redundant HTTP requests and terminal spam.");
                            break;
                        }
                    }
                } catch (Exception ex) {
                    attemptLogs.Add($"URL: {v.url} Exception: {ex.Message}");
                    Console.WriteLine($"[EditPurchase Diagnostic] Error for {v.url}: {ex}");
                }
            }
            if (fetchSuccess) break;
        }

        if (!fetchSuccess) {
            Console.WriteLine("[EditPurchase Diagnostic] All variations failed to load purchase details!");
            foreach (var log in attemptLogs) {
                Console.WriteLine($"  {log}");
            }
            var cached = FullPurchaseRequests.FirstOrDefault(f => f.master?.purchasecode == master.purchasecode);
            CurrentRequest = new PurchaseRequest {
                master = new PurchaseMasterModel {
                    purchasecode = master.purchasecode,
                    billno = master.billno,
                    billdate = master.billdate,
                    invoiceno = master.invoiceno,
                    invoicedate = master.invoicedate,
                    vendorcode = master.vendorcode,
                    grossamount = master.grossamount,
                    discountamount = master.discountamount,
                    taxamount = master.taxamount,
                    netamount = master.netamount,
                    roundoff = master.roundoff,
                    grncode = master.grncode,
                    transportationcharges = master.transportationcharges,
                    paymentmode = master.paymentmode,
                    paymentstatus = master.paymentstatus,
                    currencycode = master.currencycode,
                    isactive = master.isactive,
                    deleted = master.deleted,
                    remarks = master.remarks,
                    usercode = master.usercode,
                    tenantcode = master.tenantcode ?? DefaultTenant,
                    branchcode = master.branchcode ?? "BLR001",
                    companycode = master.companycode ?? "CMP001"
                },
                details = cached?.details != null 
                    ? cached.details.Select(d => new PurchaseDetailModel {
                        purchasedetailcode = d.purchasedetailcode,
                        purchasecode = d.purchasecode,
                        itemcode = d.itemcode,
                        quantity = d.quantity,
                        freequantity = d.freequantity,
                        uomcode = d.uomcode,
                        rate = d.rate,
                        discountpercentage = d.discountpercentage,
                        discountamount = d.discountamount,
                        taxpercentage = d.taxpercentage,
                        taxamount = d.taxamount,
                        amount = d.amount,
                        totalamount = d.totalamount,
                        batchno = d.batchno,
                        manufacturingdate = d.manufacturingdate,
                        expirydate = d.expirydate,
                        orderedqty = d.orderedqty,
                        receivedqty = d.receivedqty,
                        rejectedqty = d.rejectedqty,
                        warehousecode = d.warehousecode,
                        packaging = d.packaging,
                        manufacturercode = d.manufacturercode,
                        packsize = d.packsize,
                        packg = d.packg,
                        mrp = d.mrp,
                        tenantcode = d.tenantcode ?? DefaultTenant
                    }).ToList()
                    : new List<PurchaseDetailModel>()
            };
            // Dates are now DateTime?, no string normalization needed
            Console.WriteLine($"[Purchase Master] Fallback loaded basic record info for code: {master.purchasecode}");
            ToastService.ShowSuccess("Loaded purchase record details successfully.");
        }

        CurrentRequest.details ??= new List<PurchaseDetailModel>();

        if (CurrentRequest.master != null && CurrentRequest.details.Any()) {
            var whCode = CurrentRequest.details.FirstOrDefault(d => d.warehousecode > 0)?.warehousecode;
            if (whCode > 0) {
                SelectedWarehouseCode = whCode;
            }
        }

        // Populate physical bill totals for the frontend fields on edit load
        ManualGross = CurrentRequest.master.grossamount;
        ManualDiscount = CurrentRequest.master.discountamount;
        ManualTax = CurrentRequest.master.taxamount;
        ManualNetAmount = CurrentRequest.master.netamount;

        // Populate item and MFR search texts dictionary for typeahead inputs and sync packsize/packg
        ItemSearchTexts.Clear();
        MfrSearchTexts.Clear();
        if (CurrentRequest.details != null)
        {
            foreach (var d in CurrentRequest.details)
            {
                var key = d.GetHashCode();
                var itemName = ItemList.FirstOrDefault(i => i.itemcode == d.itemcode)?.itemname ?? "";
                ItemSearchTexts[key] = itemName;
                var mfrName = ManufacturerList.FirstOrDefault(m => m.manufacturercode == d.manufacturercode)?.manufacturername ?? "";
                MfrSearchTexts[key] = mfrName;
                
                // Ensure packsize, packg, and mrp are synchronized when loading for Edit
                if (d.packsize <= 0 && d.packg > 0) d.packsize = (int)d.packg;
                if (d.packg <= 0 && d.packsize > 0) d.packg = d.packsize;
                
                var matchedItem = ItemList.FirstOrDefault(i => i.itemcode == d.itemcode);
                if (matchedItem != null)
                {
                    if (d.packsize <= 0 && d.packg <= 0)
                    {
                        d.packsize = (int)matchedItem.packsize;
                        d.packg = matchedItem.packsize;
                    }
                    if (d.mrp <= 0 && matchedItem.mrp > 0)
                    {
                        d.mrp = matchedItem.mrp;
                    }
                }
            }
        }

        AddDetailRow();
        NewDetailItem = new PurchaseDetailModel { tenantcode = DefaultTenant };

        ShowModal = true;
    }

    private PurchaseRequest? ParseRequestResponse(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        var options = new System.Text.Json.JsonSerializerOptions { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };
        
        // 1. Try parsing using fuzzy fallback (JSON unwrapping) first to ensure custom/DB naming conventions map correctly
        try {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            
            // Unwrap "data" if present
            if (root.ValueKind == System.Text.Json.JsonValueKind.Object && TryGetPropertyIgnoreCase(root, "data", out var d)) root = d;
            
            // Handle array
            if (root.ValueKind == System.Text.Json.JsonValueKind.Array && root.GetArrayLength() > 0) root = root[0];

            var master = MapFuzzyMaster(root, options);
            if (master != null) {
                var req = new PurchaseRequest { master = master };
                
                // Map details fuzzy (check both root level and inside nested master property)
                System.Text.Json.JsonElement detailsProp;
                bool hasDetails = TryGetPropertyIgnoreCase(root, "details", out detailsProp);
                if (!hasDetails && TryGetPropertyIgnoreCase(root, "master", out var masterProp)) {
                    hasDetails = TryGetPropertyIgnoreCase(masterProp, "details", out detailsProp);
                }
                
                if (hasDetails && detailsProp.ValueKind == System.Text.Json.JsonValueKind.Array) {
                    req.details = System.Text.Json.JsonSerializer.Deserialize<List<PurchaseDetailModel>>(detailsProp.GetRawText(), options) ?? new();
                }
                return req;
            }
        } catch (Exception ex) {
            Console.WriteLine($"ParseRequestResponse fuzzy attempt error: {ex}");
        }

        // 2. Try parsing as ServiceResponse<List<PurchaseRequest>> (wrapped list)
        try {
            var wrappedList = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<PurchaseRequest>>>(json, options);
            if (wrappedList?.data != null && wrappedList.data.Any()) {
                var direct = wrappedList.data.First();
                if (direct?.master != null) {
                    direct.details ??= new List<PurchaseDetailModel>();
                    return direct;
                }
            }
        } catch { }

        // 3. Try parsing as List<PurchaseRequest> (direct list)
        try {
            var directList = System.Text.Json.JsonSerializer.Deserialize<List<PurchaseRequest>>(json, options);
            if (directList != null && directList.Any()) {
                var direct = directList.First();
                if (direct?.master != null) {
                    direct.details ??= new List<PurchaseDetailModel>();
                    return direct;
                }
            }
        } catch { }

        // 4. Try parsing as ServiceResponse<PurchaseRequest> (wrapped single item)
        try {
            var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<PurchaseRequest>>(json, options);
            if (wrapped?.data != null && wrapped.data.master != null) {
                var direct = wrapped.data;
                direct.details ??= new List<PurchaseDetailModel>();
                return direct;
            }
        } catch { }

        // 5. Try parsing as PurchaseRequest directly
        try {
            var direct = System.Text.Json.JsonSerializer.Deserialize<PurchaseRequest>(json, options);
            if (direct?.master != null && (direct.master.purchasecode > 0 || !string.IsNullOrEmpty(direct.master.billno))) {
                direct.details ??= new List<PurchaseDetailModel>();
                return direct;
            }
        } catch { }

        return null;
    }

