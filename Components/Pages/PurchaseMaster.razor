    private async Task OpenQuickAddItemModal()
    {
        CurrentNewItem = new item_master { 
            tenantcode = DefaultTenant, 
            isactive = true, 
            packsize = 1, 
            schedule = "", 
            isnarcoticdrug = false 
        };
        
        if (!ParentCategoryList.Any() || !CategoryList.Any() || !UomList.Any() || !LedgerGroupList.Any() || !LedgerTypeList.Any())
        {
            await Task.WhenAll(
                LoadParentCategories(),
