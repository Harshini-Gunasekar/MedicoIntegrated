@page "/purchasemaster"
@page "/purchase"
@using Booking.Models
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<style>
    @@keyframes blinker {
        50% { opacity: 0.3; }
    }
    .custom-typeahead-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1000;
        max-height: 200px;
        overflow-y: auto;
        background: white;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        margin-top: 2px;
    }
    .custom-typeahead-item {
        padding: 6px 10px;
        cursor: pointer;
        font-size: 0.75rem;
        text-align: left;
        color: #1e293b;
        transition: background-color 0.2s;
    }
    .custom-typeahead-item:hover {
        background-color: #f1f5f9;
        color: #02659e;
    }
</style>

<PageTitle>Purchase Master</PageTitle>

<link rel="stylesheet" href="PurchaseMaster.css" />

<div class="items-page purchase-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                            <polyline points="10 9 9 9 8 9" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Purchase Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total purchases : @PurchaseList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by bill no or vendor..." @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    @if (hasCreateRight)
                    {
                        <button class="add-item-btn" @onclick="AddNewPurchase">
                            <i class="bi bi-plus-lg"></i>
                            <span class="ms-1">New Purchase</span>
                        </button>
                    }
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredPurchases.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-receipt fs-1 d-block mb-3"></i>
                        No purchases found.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 65px; text-align: center;">S.NO</th>
                                    <th style="width: 110px; text-align: center;">BILL NO</th>
                                    <th style="width: 120px; text-align: center;">INVOICE NO</th>
                                    <th style="width: 110px; text-align: center;">DATE</th>
                                    <th style="width: 25%; text-align: center;">VENDOR</th>
                                    <th style="width: 14%; text-align: center;">NET AMOUNT</th>
                                    <th style="width: 14%; text-align: center;">PAYMENT MODE</th>
                                    <th style="width: 100px; text-align: center;">STATUS</th>
                                    <th style="width: 100px; text-align: center;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedPurchases.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td style="text-align: center; font-weight: 700; color: #3b82f6;">@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td style="text-align: center; font-weight: 700; color: #4f46e5;">#@(string.IsNullOrEmpty(row.value.billno) ? row.value.purchasecode.ToString() : row.value.billno)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.invoiceno) ? "N/A" : row.value.invoiceno)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(row.value.billdate.ToString("yyyy-MM-dd"))</td>
                                        <td style="color: #0f172a; font-weight: 600; text-align: center;">@(VendorList.FirstOrDefault(v => v.vendorCode == row.value.vendorcode)?.vendorName ?? (row.value.vendorcode > 0 ? row.value.vendorcode.ToString() : "N/A"))</td>
                                        <td style="font-weight: 700; color: #0f172a; text-align: center;">₹@row.value.netamount.ToString("N2")</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@row.value.paymentmode</td>
                                        <td style="text-align: center;">
                                            <span style="color: @(row.value.paymentstatus == "Paid" ? "#059669" : "#d97706"); font-weight: 700; font-size: 0.78rem; text-transform: uppercase;">
                                                @row.value.paymentstatus
                                            </span>
                                        </td>
                                        <td style="text-align: center;">
                                            @if (hasEditRight)
                                            {
                                                <button class="action-btn btn-edit" @onclick="async () => await EditPurchase(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            }
                                            @if (hasDeleteRight)
                                            {
                                                <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var p in PagedPurchases)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span class="card-item-code">#@(string.IsNullOrEmpty(p.billno) ? p.purchasecode.ToString() : p.billno)</span>
                                    <div>
                                        @if (hasEditRight)
                                        {
                                            <button class="action-btn btn-edit" @onclick="async () => await EditPurchase(p)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(p)" title="Delete"><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
                                </div>
                                <div class="item-card-body">
                                     <div class="detail-row"><span>Invoice No</span><strong>@(string.IsNullOrWhiteSpace(p.invoiceno) ? "N/A" : p.invoiceno)</strong></div>
                                     <div class="detail-row"><span>Date</span><strong>@(p.billdate.ToString("yyyy-MM-dd"))</strong></div>
                                    <div class="detail-row"><span>Vendor</span><strong>@(VendorList.FirstOrDefault(v => v.vendorCode == p.vendorcode)?.vendorName ?? p.vendorcode?.ToString())</strong></div>
                                    <div class="detail-row"><span>Net Amount</span><strong>₹@p.netamount.ToString("N2")</strong></div>
                                    <div class="detail-row"><span>Status</span><strong>@p.paymentstatus</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredPurchases.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredPurchases.Count()))</strong> of <strong>@FilteredPurchases.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1" style="align-items: center;">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @foreach (var pageNum in GetVisiblePageNumbers())
                            {
                                var p = pageNum;
                                <button class="page-btn @(CurrentPage == p ? "active" : "")" @onclick="() => ChangePage(p)">
                                    @p
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 1350px; width: 95%;">
            <div class="modal-header-bar" style="padding: 20px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #1e293b !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Purchase" : "New Purchase")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner" style="padding: 1.25rem 1rem 1.25rem;">
                <EditForm Model="CurrentRequest" OnValidSubmit="SavePurchase" autocomplete="off">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 18px 12px 18px 0px;">
                        
                        <!-- Bill Information main wrapper divided into Left (fields) and Right (card) -->
                        <div class="purchase-bill-wrapper mb-4">
                            <!-- Left Section: Reduced flex width for entering billing fields -->
                            <div class="purchase-bill-fields" style="flex: 1.1;">
                                <div class="form-section-header" style="margin-top: 0; margin-bottom: 8px; padding-bottom: 2px; border-bottom: 1px solid #f1f5f9;">
                                    <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Bill Information</div>
                                </div>
                                <!-- Row 1: Vendor (col-6), GRN No (col-3), Invoice No (col-3) -->
                                <div class="form-grid" style="margin-bottom: 0;">
                                    <div class="field-group col-6">
                                        <label class="field-label required">Vendor</label>
                                        <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.vendorcode">
                                            <option value="0">-- Select Vendor --</option>
                                            @if (CurrentRequest.master.vendorcode > 0 && !VendorList.Any(v => v.vendorCode == CurrentRequest.master.vendorcode))
                                            {
                                                <option value="@CurrentRequest.master.vendorcode">Unknown Vendor (Code: @CurrentRequest.master.vendorcode)</option>
                                            }
                                            @foreach (var v in VendorList)
                                            {
                                                <option value="@v.vendorCode">@v.vendorName</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="field-group col-3">
                                        <label class="field-label">Bill No</label>
                                        <input type="text" class="form-control premium-input" value="@(string.IsNullOrEmpty(CurrentRequest.master.billno) ? (CurrentRequest.master.purchasecode > 0 ? CurrentRequest.master.purchasecode.ToString() : "#20260001") : CurrentRequest.master.billno)" disabled style="background-color: #f8fafc; font-weight: 700; color: #4f46e5;" />
                                    </div>
                                    <div class="field-group col-3">
                                        <label class="field-label">Invoice No</label>
                                        <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.invoiceno" autocomplete="off" />
                                    </div>
                                </div>

                                <!-- Row 2: Entered Date, Invoice Date, Payment Mode, Payment Status, Warehouse (span 4, span 4, span 4, span 6, span 6 of 24) -->
                                <div class="form-grid" style="margin-bottom: 0; grid-template-columns: repeat(24, 1fr);">
                                    <div class="field-group" style="grid-column: span 4;">
                                        <label class="field-label">Entered Date</label>
                                        <InputDate class="form-control premium-input" @bind-Value="CurrentRequest.master.billdate" />
                                    </div>
                                    <div class="field-group" style="grid-column: span 4;">
                                        <label class="field-label">Invoice Date</label>
                                        <InputDate class="form-control premium-input" @bind-Value="CurrentRequest.master.invoicedate" />
                                    </div>
                                    <div class="field-group" style="grid-column: span 4;">
                                        <label class="field-label">Payment Mode</label>
                                        <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.paymentmode">
                                            <option value="Cash">Cash</option>
                                            <option value="Bank">Bank</option>
                                            <option value="Credit">Credit</option>
                                        </InputSelect>
                                    </div>
                                    <div class="field-group" style="grid-column: span 6;">
                                        <label class="field-label">Payment Status</label>
                                        <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.paymentstatus">
                                            <option value="Pending">Pending</option>
                                            <option value="Paid">Paid</option>
                                            <option value="Partial">Partial</option>
                                        </InputSelect>
                                    </div>
                                    <div class="field-group" style="grid-column: span 6;">
                                        <label class="field-label">Store</label>
                                        <InputSelect class="form-control premium-input" @bind-Value="SelectedWarehouseCode">
                                            <option value="0">-- Select Store --</option>
                                            @foreach (var w in WarehouseList)
                                            {
                                                <option value="@w.warehousecode">@w.warehousename</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Section: Increased physical bill total width -->
                            <div class="purchase-bill-summary" style="flex: 0.9; max-width: 380px;">
                                <div class="bill-card-premium">
                                    <div class="bill-card-header-premium">
                                        Physical Bill Totals
                                    </div>
                                    
                                    <div style="display: flex; flex-direction: column; gap: 4px; flex-grow: 1; justify-content: center;">
                                        <!-- Gross Amount Row -->
                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                            <span style="font-size: 0.72rem; color: #475569; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Gross Amount</span>
                                            <input type="number" step="any" class="compact-summary-input input-premium-gross" @bind:get="GetManualGross()" @bind:set="SetManualGross" @bind:event="oninput" @onkeyup="CalculateManualNet" placeholder="0" style="width: 125px; height: 23px; font-size: 0.75rem; padding: 0 6px; text-align: right; box-sizing: border-box; border-radius: 6px;" />
                                        </div>

                                        <!-- Discount Row -->
                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                            <span style="font-size: 0.72rem; color: #475569; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Discount</span>
                                            <input type="number" step="any" class="compact-summary-input input-premium-discount" @bind:get="GetManualDiscount()" @bind:set="SetManualDiscount" @bind:event="oninput" @onkeyup="CalculateManualNet" placeholder="0" style="width: 125px; height: 23px; font-size: 0.75rem; padding: 0 6px; text-align: right; box-sizing: border-box; border-radius: 6px;" />
                                        </div>

                                        <!-- Tax Amount Row -->
                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                            <span style="font-size: 0.72rem; color: #475569; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Tax Amount</span>
                                            <input type="number" step="any" class="compact-summary-input input-premium-tax" @bind:get="GetManualTax()" @bind:set="SetManualTax" @bind:event="oninput" @onkeyup="CalculateManualNet" placeholder="0" style="width: 125px; height: 23px; font-size: 0.75rem; padding: 0 6px; text-align: right; box-sizing: border-box; border-radius: 6px;" />
                                        </div>
                                    </div>
                                    
                                    <div class="net-payable-wrapper-premium" style="margin-top: 2px; padding-top: 3px; border-top: 1.5px dashed rgba(99, 102, 241, 0.25); display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <span class="net-payable-label-premium" style="font-size: 0.75rem; font-weight: 800; color: #1e293b; text-transform: uppercase; letter-spacing: 0.5px;">Net Payable</span>
                                        <span class="net-payable-value-premium blink-payable-value" style="font-size: 1.12rem; font-weight: 800; color: #4f46e5; text-shadow: 0 1px 2px rgba(79, 70, 229, 0.1);">₹ @ManualNetAmount.ToString("N2")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-section-header" style="margin-top: 2.8rem !important; padding-top: 0.4rem; border-top: 1px solid #f1f5f9; margin-bottom: 8px; padding-bottom: 2px; border-bottom: 1px solid #f1f5f9;">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Purchase Details</div>
                        </div>

                        <!-- Table showing item entry and added rows -->
                        <div class="purchase-items-table-wrapper table-responsive">
                            <table class="table align-middle mb-0" style="font-size: 0.85rem;">
                                <thead class="purchase-items-table-header">
                                    <tr>
                                        <th style="width: 30px; text-align: center;">S.NO</th>
                                        <th style="width: 140px;">ITEM</th>
                                        <th style="width: 80px; text-align: center;">HSN CODE</th>
                                        <th style="width: 75px; text-align: center;">MFR</th>
                                        <th style="width: 65px; text-align: center;">BATCH NO</th>
                                        <th style="width: 95px; text-align: center;">EXPIRY DATE</th>
                                        <th style="text-align: center; width: 45px;">QTY</th>
                                        <th style="width: 70px; text-align: center;">PACK SIZE</th>
                                        <th style="text-align: center; width: 55px;">RATE</th>
                                        <th style="text-align: center; width: 55px;">M.R.P</th>
                                        <th style="text-align: center; width: 48px;">DISC %</th>
                                        <th style="text-align: center; width: 38px;">TAX %</th>
                                        <th style="text-align: center; width: 55px;">TAX AMT</th>
                                        <th style="text-align: center; width: 65px;">TOTAL</th>
                                        <th style="text-align: center; width: 45px;">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in CurrentRequest.details.Select((detail, index) => new { detail, index }))
                                    {
                                        var detail = row.detail;
                                        var index = row.index;
                                        var rowId = $"row-{index}";
                                        var searchKey = detail.GetHashCode();
                                        <tr>
                                            <td style="padding: 0; color: #64748b; text-align: center; font-weight: 600; width: 30px; line-height: 34px;">@(index + 1)</td>
                                            <td style="padding: 0; min-width: 140px; width: 140px; position: relative;">
                                                <input id="item-input-@index"
                                                       type="text"
                                                       class="purchase-item-select"
                                                       style="width: 100%;"
                                                       placeholder="Type to search item..."
                                                       autocomplete="off"
                                                       value="@(ItemSearchTexts.GetValueOrDefault(searchKey, ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname ?? ""))"
                                                       @oninput="@(e => FilterItems(e, detail, searchKey))"
                                                       @onfocus="@(() => ActiveItemSearchRow = index)"
                                                       @onblur="OnSearchBlur"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 0))" />

                                                @if (ActiveItemSearchRow == index)
                                                {
                                                    var searchText = ItemSearchTexts.GetValueOrDefault(searchKey, "");
                                                    var filteredItems = ItemList
                                                        .Where(i => string.IsNullOrEmpty(searchText) || (i.itemname != null && i.itemname.StartsWith(searchText, StringComparison.OrdinalIgnoreCase)))
                                                        .ToList();

                                                    if (filteredItems.Any())
                                                    {
                                                        <div class="custom-typeahead-dropdown">
                                                            @foreach (var item in filteredItems)
                                                            {
                                                                <div class="custom-typeahead-item" 
                                                                     @onmousedown="@(() => SelectItemFromDropdown(detail, item, searchKey))">
                                                                    @item.itemname
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 80px;">
                                                <span class="purchase-item-readonly text-center" style="display: block; line-height: 34px;">
                                                    @(ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.hsnCode.ToString() ?? "-")
                                                </span>
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 75px; position: relative;">
                                                <input id="mfr-@index"
                                                       type="text"
                                                       class="purchase-item-input"
                                                       style="width: 100%; height: 34px; font-size: 0.65rem; min-width: 0 !important;"
                                                       placeholder="Type MFR..."
                                                       autocomplete="off"
                                                       value="@(MfrSearchTexts.GetValueOrDefault(searchKey, ManufacturerList.FirstOrDefault(m => m.manufacturercode == detail.manufacturercode)?.manufacturername ?? ""))"
                                                       @oninput="@(e => FilterMfrs(e, detail, searchKey))"
                                                       @onfocus="@(() => ActiveMfrSearchRow = index)"
                                                       @onblur="OnMfrBlur"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 1))" />

                                                @if (ActiveMfrSearchRow == index)
                                                {
                                                    var searchText = MfrSearchTexts.GetValueOrDefault(searchKey, "");
                                                    var filteredMfrs = ManufacturerList
                                                        .Where(m => string.IsNullOrEmpty(searchText) || (m.manufacturername != null && m.manufacturername.StartsWith(searchText, StringComparison.OrdinalIgnoreCase)))
                                                        .ToList();

                                                    if (filteredMfrs.Any())
                                                    {
                                                        <div class="custom-typeahead-dropdown">
                                                            @foreach (var m in filteredMfrs)
                                                            {
                                                                <div class="custom-typeahead-item" 
                                                                     style="font-size: 0.65rem;"
                                                                     @onmousedown="@(() => SelectMfrFromDropdown(detail, m, searchKey))">
                                                                    @m.manufacturername
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 65px;">
                                                <input id="batch-@index" type="text" class="purchase-item-input text-center" @bind="detail.batchno"
                                                       autocomplete="off"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 2))" />
                                            </td>
