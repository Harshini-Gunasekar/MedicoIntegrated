                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 3))" />
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 45px;">
                                                <input id="qty-@index" type="number" step="any" class="purchase-item-input text-center" @bind:get="GetQty(detail)" @bind:set="(val) => SetQty(detail, val)" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 4))" placeholder="0" />
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 70px;">
                                                <input id="packg-@index" type="number" step="any" class="purchase-item-input text-center" @bind:get="GetPacksize(detail)" @bind:set="(val) => SetPacksize(detail, val)" @bind:event="oninput"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 5))" placeholder="0" />
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 55px;">
                                                <input id="rate-@index" type="number" step="any" class="purchase-item-input text-end" @bind:get="GetRate(detail)" @bind:set="(val) => SetRate(detail, val)" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 6))" placeholder="0" />
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 55px;">
                                                <input id="mrp-@index" type="number" step="any" class="purchase-item-input text-end" @bind:get="GetMrp(detail)" @bind:set="(val) => SetMrp(detail, val)" @bind:event="oninput"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 7))" placeholder="0" />
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 48px;">
                                                <input id="disc-@index" type="number" step="any" class="purchase-item-input text-center" @bind:get="GetDisc(detail)" @bind:set="(val) => SetDisc(detail, val)" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 8))" placeholder="0" />
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 38px;">
                                                <input id="tax-@index" type="number" step="any" class="purchase-item-input text-center" @bind:get="GetTax(detail)" @bind:set="(val) => SetTax(detail, val)" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)"
                                                       @onkeydown="@(e => HandleRowKeyDown(e, index, 9))" placeholder="0" />
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 55px;">
                                                <span class="purchase-item-readonly text-end">₹@detail.taxamount.ToString("N2")</span>
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 65px;">
                                                <span class="purchase-item-readonly text-end fw-bold" style="color: #0f678f;">₹@detail.totalamount.ToString("N2")</span>
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 45px; vertical-align: middle;">
                                                <button type="button" class="btn btn-outline-danger btn-sm" style="border-radius: 6px; padding: 4px 8px; border: none; background: rgba(239, 68, 68, 0.08); color: #dc2626; margin: 0 auto; display: block;" @onclick="() => RemoveDetailRow(detail)" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div style="padding: 8px 0; display: flex; justify-content: space-between; align-items: center; width: 100%;">
                            <!-- Left Corner: Total Items count -->
                            <span style="color: #475569; font-weight: 600; font-size: 0.82rem; white-space: nowrap; flex: 1; text-align: left;">
                                Total Items: <span style="color: #0f678f; font-weight: 700;">@(CurrentRequest.details?.Count(d => d.itemcode > 0) ?? 0)</span>
                            </span>
                            
                            <!-- Center: Dotted Add Item Button -->
                            <div style="flex: 1; text-align: center;">
                                <button type="button" class="btn-dotted-add" @onclick="AddDetailRow" style="padding: 5px 22px; font-size: 0.82rem; border-radius: 16px;">
                                    <i class="bi bi-plus-circle-fill" style="font-size: 0.9rem;"></i> Add Item
                                </button>
                            </div>
                            
                            <!-- Right Corner: Computed Total -->
                            <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px; font-size: 0.83rem; flex: 1; text-align: right; white-space: nowrap;">
                                <span style="color: #64748b; font-weight: 600;">Computed Items Total:</span>
                                <span style="font-weight: 800; font-size: 1.05rem; color: #0f678f;">&#8377; @CurrentRequest.master.netamount.ToString("N2")</span>
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer-actions" style="display: flex; flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; padding-top: 24px; padding-bottom: 16px;">
                        <!-- Round Off Section on the left -->
                        <div class="roundoff-section">
                            <div style="display: flex; flex-direction: column; gap: 4px; align-items: flex-start;">
                                <span style="font-size: 0.75rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Round Off</span>
                                <div style="display: flex; align-items: center; gap: 4px; background: #ffffff; padding: 4px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                                    <input type="number" step="any" class="form-control text-end px-2" @bind:get="CurrentRequest.master.roundoff" @bind:set="SetRoundOff" @bind:event="oninput" @onkeyup="CalculateTotals" placeholder="0.00" style="width: 85px; height: 32px; font-size: 0.9rem; font-weight: 700; color: #0f678f; border: 1px solid #cbd5e1; border-radius: 6px; box-shadow: inset 0 1px 2px rgba(0,0,0,0.03); background: #f8fafc; appearance: textfield; animation: blinker 1.5s linear infinite;" />
                                    <button class="btn btn-sm" type="button" @onclick="RoundOffUp" title="Round Up (+)" style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 6px; border: none; background: rgba(22, 163, 74, 0.1); color: #16a34a; font-weight: 800; font-size: 1.1rem; padding: 0; cursor: pointer;">+</button>
                                    <button class="btn btn-sm" type="button" @onclick="RoundOffDown" title="Round Down (-)" style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 6px; border: none; background: rgba(220, 38, 38, 0.1); color: #dc2626; font-weight: 800; font-size: 1.2rem; padding: 0; cursor: pointer;">-</button>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons on the right -->
                        <div style="display: flex; flex-direction: row; align-items: center; gap: 12px;">
                            <button type="button" class="btn-cancel-modal" @onclick="CloseModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.5rem 1.5rem; border-radius: 12px; font-weight: 700; min-width: 100px; transition: all 0.2s;">Cancel</button>
                            <button type="submit" class="btn-save-premium" disabled="@IsSaving" style="min-width: 150px; height: 48px; margin: 0; position: relative; top: 0;">
                                @if (IsSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                                }
                                <span>@(IsEdit ? "Update Bill" : "Save Bill")</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeleteConfirm = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Purchase</div>
            <div class="action-popup-body">Are you sure you want to delete this purchase bill? This action cannot be undone.</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowDeleteConfirm = false">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@if (ShowBillMatchPopup)
{
    <div class="action-popup-overlay" @onclick="() => ShowBillMatchPopup = false">
        <div class="action-popup-card" @onclick:stopPropagation="true" style="max-width: 440px;">
            <div class="action-popup-header" style="@(IsBillMatched ? "background: linear-gradient(135deg,#10b981,#059669);" : "background: linear-gradient(135deg,#ef4444,#dc2626);") color: #ffffff;">
                <i class="bi @(IsBillMatched ? "bi-check-circle-fill" : "bi-x-circle-fill")" style="margin-right: 8px; font-size: 1.1rem;"></i>
                @(IsBillMatched ? "Bill Matched" : "Bill Mismatched")
            </div>
            <div class="action-popup-body" style="text-align: center; padding: 24px 20px 12px;">
                <div style="font-size: 2.8rem; margin-bottom: 10px; color: @(IsBillMatched ? "#10b981" : "#ef4444");">
                    <i class="bi @(IsBillMatched ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i>
                </div>
                @if (IsBillMatched)
                {
                    <p style="margin: 0; font-size: 0.92rem; color: #1e293b;">
                        Physical bill amount <strong>&#8377; @ManualNetAmount.ToString("N2")</strong> matches the computed items total
                        <strong>&#8377; @CurrentRequest.master.netamount.ToString("N2")</strong>.
                        Proceed to save?
                    </p>
                }
                else
                {
                    <p style="margin: 0; font-size: 0.92rem; color: #1e293b;">
                        Physical bill amount <strong>&#8377; @ManualNetAmount.ToString("N2")</strong> does <strong>NOT</strong> match
                        the computed items total <strong>&#8377; @CurrentRequest.master.netamount.ToString("N2")</strong>.
                        Please review your entries before saving.
                    </p>
                }
            </div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowBillMatchPopup = false">
                    @(IsBillMatched ? "Cancel" : "Go Back & Fix")
                </button>
                @if (IsBillMatched)
                {
                    <button type="button" class="popup-btn" style="background: linear-gradient(135deg,#10b981,#059669); color:#fff; border:none;" @onclick="ProceedSaveAfterMatch">
                        <i class="bi bi-check2-circle me-1"></i> Proceed &amp; Save
                    </button>
                }
            </div>
        </div>
    </div>
}


@code {
    private List<PurchaseMasterModel> PurchaseList = new();
    private List<vendor_master> VendorList = new();
    private List<inventory_item_master> ItemList = new();
    private List<warehouse_master> WarehouseList = new();
    private List<manufacturer_master> ManufacturerList = new();
    private PurchaseRequest CurrentRequest = new();
    private PurchaseDetailModel NewDetailItem = new() { tenantcode = "" };
    private long? SelectedWarehouseCode { get; set; }

    // Typeahead: tracks the typed text per detail row (keyed by object hash)
    private Dictionary<int, string> ItemSearchTexts = new();
    private Dictionary<int, string> MfrSearchTexts = new();

    private int ActiveItemSearchRow = -1;
    private int ActiveMfrSearchRow = -1;

    private void FilterItems(ChangeEventArgs e, PurchaseDetailModel detail, int searchKey)
    {
        var text = e.Value?.ToString() ?? "";
        ItemSearchTexts[searchKey] = text;
        
        var matched = ItemList.FirstOrDefault(i => string.Equals(i.itemname, text, StringComparison.OrdinalIgnoreCase));
        if (matched != null)
        {
            detail.itemcode = matched.itemcode;
            OnItemChanged(detail);
        }
        else
        {
            detail.itemcode = 0;
        }
    }

    private void SelectItemFromDropdown(PurchaseDetailModel detail, inventory_item_master item, int searchKey)
    {
        detail.itemcode = item.itemcode;
        ItemSearchTexts[searchKey] = item.itemname;
        OnItemChanged(detail);
        ActiveItemSearchRow = -1;
    }

    private async Task OnSearchBlur()
    {
        await Task.Delay(200);
        ActiveItemSearchRow = -1;
        StateHasChanged();
    }

    private void FilterMfrs(ChangeEventArgs e, PurchaseDetailModel detail, int searchKey)
    {
        var text = e.Value?.ToString() ?? "";
        MfrSearchTexts[searchKey] = text;
        
        var matched = ManufacturerList.FirstOrDefault(m => string.Equals(m.manufacturername, text, StringComparison.OrdinalIgnoreCase))
                   ?? ManufacturerList.FirstOrDefault(m => m.manufacturername != null && m.manufacturername.StartsWith(text, StringComparison.OrdinalIgnoreCase));
        if (matched != null)
        {
            detail.manufacturercode = matched.manufacturercode;
        }
        else
        {
            detail.manufacturercode = 0;
        }
    }

    private void SelectMfrFromDropdown(PurchaseDetailModel detail, manufacturer_master m, int searchKey)
    {
        detail.manufacturercode = m.manufacturercode;
        MfrSearchTexts[searchKey] = m.manufacturername ?? "";
        ActiveMfrSearchRow = -1;
    }

    private async Task OnMfrBlur()
    {
        await Task.Delay(200);
        ActiveMfrSearchRow = -1;
        StateHasChanged();
    }

    private void OnSelectItemChanged(PurchaseDetailModel detail, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var code))
        {
            detail.itemcode = code;
            OnItemChanged(detail);
        }
    }

    private void OnSelectMfrChanged(PurchaseDetailModel detail, ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var code))
        {
            detail.manufacturercode = code;
        }
    }

    private void OnItemTypeaheadInput(ChangeEventArgs e, PurchaseDetailModel detail, int searchKey)
    {
        var typed = e.Value?.ToString() ?? "";
        ItemSearchTexts[searchKey] = typed;
        // Try to find an exact match in the item list
        var matched = ItemList.FirstOrDefault(i =>
            string.Equals(i.itemname, typed, StringComparison.OrdinalIgnoreCase));
        if (matched != null)
        {
            detail.itemcode = matched.itemcode;
            OnItemChanged(detail);
        }
        else
        {
            detail.itemcode = 0;
        }
    }

    private void OnMfrTypeaheadInput(ChangeEventArgs e, PurchaseDetailModel detail, int searchKey)
    {
        var typed = e.Value?.ToString() ?? "";
        MfrSearchTexts[searchKey] = typed;
        // Try to find a match in the ItemList for manufacturer
        var matched = ItemList.FirstOrDefault(i =>
            !string.IsNullOrEmpty(i.manufacturer) &&
            string.Equals(i.manufacturer, typed, StringComparison.OrdinalIgnoreCase));
        if (matched != null)
        {
            detail.manufacturercode = matched.manufacturercode;
        }
        else
        {
            detail.manufacturercode = 0;
        }
    }

    // Field order in a row: 0=item, 1=mfr, 2=batch, 3=expiry, 4=qty, 5=packg, 6=rate, 7=mrp, 8=disc, 9=tax
    private readonly string[] _rowFieldPrefixes = { "item-input", "mfr", "batch", "expiry", "qty", "packg", "rate", "mrp", "disc", "tax" };

    private async Task HandleRowKeyDown(KeyboardEventArgs e, int rowIndex, int fieldIndex)
    {
        if (e.Key == "Enter" || e.Key == "Tab")
        {
            int nextField = fieldIndex + 1;
            int nextRow = rowIndex;
            if (nextField >= _rowFieldPrefixes.Length)
            {
                nextField = 0;
                nextRow = rowIndex + 1;
                // If next row doesn't exist, add one
                if (nextRow >= CurrentRequest.details.Count)
                    AddDetailRow();
            }
            var targetId = $"{_rowFieldPrefixes[nextField]}-{nextRow}";
            await JS.InvokeVoidAsync("focusElement", targetId);
        }
    }

    private HashSet<PurchaseDetailModel> EditableRows = new();

    private bool IsRowEditable(PurchaseDetailModel detail)
    {
        // First row is always editable by default if it's empty, or if explicitly in EditableRows
        if (CurrentRequest.details != null && CurrentRequest.details.Count > 0 && CurrentRequest.details[0] == detail && detail.itemcode == 0)
        {
            return true;
        }
        return EditableRows.Contains(detail);
    }
    
    private string SearchQuery = "";
    private bool IsLoading = true;
    private bool IsSaving = false;
    private bool ShowModal = false;
    private bool IsEdit = false;
    private bool IsCardView = false;
    private bool ShowDeleteConfirm = false;
    private bool ShowBillMatchPopup = false;
    private bool IsBillMatched = false;
    private PurchaseMasterModel? PendingDelete;
    
    private decimal ManualGross = 0;
    private decimal ManualDiscount = 0;
    private decimal ManualTax = 0;
    private decimal ManualNetAmount = 0;

    private decimal? GetManualGross() => !IsEdit && ManualGross == 0 ? null : ManualGross;
    private void SetManualGross(decimal? value) => ManualGross = value ?? 0;

    private decimal? GetManualDiscount() => !IsEdit && ManualDiscount == 0 ? null : ManualDiscount;
    private void SetManualDiscount(decimal? value) => ManualDiscount = value ?? 0;

    private decimal? GetManualTax() => !IsEdit && ManualTax == 0 ? null : ManualTax;
    private void SetManualTax(decimal? value) => ManualTax = value ?? 0;

    private decimal? GetQty(PurchaseDetailModel detail) => !IsEdit && detail.quantity == 0 ? null : detail.quantity;
    private void SetQty(PurchaseDetailModel detail, decimal? value) => detail.quantity = value ?? 0;

    private int? GetPacksize(PurchaseDetailModel detail) => !IsEdit && detail.packsize == 0 ? null : detail.packsize;
    private void SetPacksize(PurchaseDetailModel detail, int? value)
    {
        detail.packsize = value ?? 0;
        detail.packg = detail.packsize;
    }

    private decimal? GetRate(PurchaseDetailModel detail) => !IsEdit && detail.rate == 0 ? null : detail.rate;
    private void SetRate(PurchaseDetailModel detail, decimal? value) => detail.rate = value ?? 0;

    private decimal? GetMrp(PurchaseDetailModel detail)
    {
        if (detail.mrp > 0) return detail.mrp;
        if (detail.itemcode > 0)
        {
            var matched = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
            if (matched != null && matched.mrp > 0) return matched.mrp;
        }
        return !IsEdit ? null : detail.mrp;
    }
    private void SetMrp(PurchaseDetailModel detail, decimal? value) => detail.mrp = value ?? 0;

    private decimal? GetDisc(PurchaseDetailModel detail) => !IsEdit && detail.discountpercentage == 0 ? null : detail.discountpercentage;
    private void SetDisc(PurchaseDetailModel detail, decimal? value) => detail.discountpercentage = value ?? 0;

    private decimal? GetTax(PurchaseDetailModel detail) => !IsEdit && detail.taxpercentage == 0 ? null : detail.taxpercentage;
    private void SetTax(PurchaseDetailModel detail, decimal? value) => detail.taxpercentage = value ?? 0;
    
    private string DefaultTenant = "";

    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 12;

    private IEnumerable<PurchaseMasterModel> FilteredPurchases => 
        string.IsNullOrWhiteSpace(SearchQuery) 
            ? PurchaseList 
            : PurchaseList.Where(p => 
                (p.billno?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.purchasecode.ToString().Contains(SearchQuery)) ||
                (VendorList.FirstOrDefault(v => v.vendorCode == p.vendorcode)?.vendorName?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<PurchaseMasterModel> PagedPurchases => 
        FilteredPurchases.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    private int TotalPages => (int)Math.Ceiling((double)FilteredPurchases.Count() / ItemsPerPage);

    private IEnumerable<int> GetVisiblePageNumbers()
    {
        int total = TotalPages;
        int current = CurrentPage;

        if (total <= 3)
        {
            return Enumerable.Range(1, Math.Max(1, total));
        }

        int start = current - 1;
        if (current <= 1)
        {
            start = 1;
        }
        else if (current >= total)
        {
            start = total - 2;
        }

        start = Math.Max(1, Math.Min(start, total - 2));
        return Enumerable.Range(start, 3);
    }

    private bool hasViewRight = true;
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
            
            try
            {
                bool isAdmin = false;
                try
                {
                    var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userResult.Success && userResult.Value != null)
                    {
                        isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                  userResult.Value.UserCode == 0 ||
                                  userResult.Value.UserCode == 1;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking user details: {ex.Message}");
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                    hasEditRight = true;
                    hasDeleteRight = true;
                }
                else
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var pageRight = rightsResult.Value.FirstOrDefault(r => 
                            r.ModuleName != null && 
                            r.ModuleName.Trim().Equals("Purchase_Purchase", StringComparison.OrdinalIgnoreCase));
                        
                        if (pageRight != null)
                        {
                            hasViewRight = pageRight.ToView;
                            hasCreateRight = pageRight.ToAdd;
                            hasEditRight = pageRight.ToEdit;
                            hasDeleteRight = pageRight.ToDelete;
                        }
                        else
                        {
                            hasViewRight = false;
                            hasCreateRight = false;
                            hasEditRight = false;
                            hasDeleteRight = false;
                        }
                    }
                    else
                    {
                        hasViewRight = false;
                        hasCreateRight = false;
                        hasEditRight = false;
                        hasDeleteRight = false;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking Purchase_Purchase rights: {ex.Message}");
                hasViewRight = false;
                hasCreateRight = false;
                hasEditRight = false;
                hasDeleteRight = false;
            }

            if (!hasViewRight)
            {
                ToastService.ShowError("You do not have permission to access Purchase Purchase.");
                Nav.NavigateTo("/home");
                return;
            }

            await Task.WhenAll(LoadPurchases(), LoadVendors(), LoadItems(), LoadWarehouses(), LoadManufacturers());
            StateHasChanged();
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        // Ensure the header is present and correctly cased if necessary, 
        // though lowercase 'tenantcode' is common in this project's existing code.
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        return client;
    }

    private List<PurchaseRequest> FullPurchaseRequests = new();

    private async Task LoadPurchases()
    {
        IsLoading = true;
        try {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallpurchases");
            
            if (!string.IsNullOrWhiteSpace(response)) {
                var fullList = ParseFullRequestList(response);
                if (fullList != null) {
                    FullPurchaseRequests = fullList;
                } else {
                    try {
                        using var doc = System.Text.Json.JsonDocument.Parse(response);
                        var root = doc.RootElement;
                        if (root.ValueKind == System.Text.Json.JsonValueKind.Object && TryGetPropertyIgnoreCase(root, "data", out var d)) root = d;
                        if (root.ValueKind == System.Text.Json.JsonValueKind.Array) {
                            var list = new List<PurchaseRequest>();
                            foreach (var item in root.EnumerateArray()) {
                                var req = ParseRequestResponse(item.GetRawText());
                                if (req != null) list.Add(req);
                            }
                            FullPurchaseRequests = list;
                        }
                    } catch { }
                }

                var masterList = ParseMasterListResponse(response);
                PurchaseList = masterList ?? new();
            }
        } catch (Exception ex) {
            ToastService.ShowError($"Load Error: {ex.Message}");
        } finally {
            IsLoading = false;
        }
    }

