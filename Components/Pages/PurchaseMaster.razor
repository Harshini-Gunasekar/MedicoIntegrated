    }

    private async Task SaveQuickItem()
    {
        if (!IsQuickMedicineSelected)
        {
            CurrentNewItem.schedule = "";
            CurrentNewItem.isnarcoticdrug = false;
            CurrentNewItem.drugname = "";
        }

        var errors = new List<string>();
        if (string.IsNullOrWhiteSpace(CurrentNewItem.itemname)) errors.Add("Item Name");
        if (CurrentNewItem.categorycode <= 0) errors.Add("Category");
        if (CurrentNewItem.purchaserate <= 0) errors.Add("Purchase Rate");

        if (errors.Any())
        {
            ToastService.ShowWarning($"Please provide valid: {string.Join(", ", errors)}");
            return;
        }

        IsQuickItemSaving = true;
        try
        {
            var client = CreateClient();
            CurrentNewItem.tenantcode = DefaultTenant;
            CurrentNewItem.isactive = true;

            CurrentNewItem.shortname ??= "";
            CurrentNewItem.description ??= "";
            CurrentNewItem.itemtype ??= "";
            CurrentNewItem.manufacturer ??= "";
            CurrentNewItem.drugname ??= "";
            CurrentNewItem.packaging ??= "";
            CurrentNewItem.schedule ??= "";
            if (CurrentNewItem.ledgergroupcode == 0)
            {
                CurrentNewItem.ledgergroupcode = CurrentNewItem.taxcode;
            }
            
            var saveGroup = LedgerGroupList.FirstOrDefault(g => g.ledgergroupcode == CurrentNewItem.ledgergroupcode);
            if (saveGroup != null)
            {
                var type = LedgerTypeList.FirstOrDefault(t => t.ledgertypecode == saveGroup.ledgertypecode);
                CurrentNewItem.naturetype = type != null ? type.naturetype : saveGroup.ledgertypecode;
            }
            CurrentNewItem.isexpiry = CurrentNewItem.expiryrequired;
            if (!CurrentNewItem.expiryrequired)
            {
                CurrentNewItem.expiryalertdays = 0;
            }

            var urls = new List<string> { "ItemMaster/insertitem", "api/ItemMaster/insertitem" };
            HttpResponseMessage? response = null;
            foreach (var targetUrl in urls)
            {
                try {
                    response = await client.PostAsJsonAsync(targetUrl, CurrentNewItem);
                    if (response.IsSuccessStatusCode) break;
                } catch { }
            }

            if (response != null && response.IsSuccessStatusCode)
            {
                var createdName = CurrentNewItem.itemname;
                CloseQuickAddItemModal();
                await LoadItems();

                // Find the newly created item in the refreshed ItemList
                var newlyAdded = ItemList.FirstOrDefault(i => string.Equals(i.itemname, createdName, StringComparison.OrdinalIgnoreCase))
                              ?? ItemList.OrderByDescending(i => i.itemcode).FirstOrDefault();

                if (newlyAdded != null)
                {
                    // Find first empty detail row or create a new row
                    var targetRow = CurrentRequest.details.FirstOrDefault(d => d.itemcode == 0);
                    if (targetRow == null)
                    {
                        targetRow = new PurchaseDetailModel { 
                            tenantcode = DefaultTenant,
                            expirydate = null
                        };
                        CurrentRequest.details.Add(targetRow);
                        EditableRows.Add(targetRow);
                    }

                    targetRow.itemcode = newlyAdded.itemcode;
                    targetRow.rate = newlyAdded.purchaserate;
                    targetRow.mrp = newlyAdded.mrp;
                    targetRow.packsize = (int)newlyAdded.packsize;
                    targetRow.packg = newlyAdded.packsize;
                    targetRow.uomcode = (int)newlyAdded.uomcode;
                    targetRow.taxpercentage = newlyAdded.gstpercentage;
                    targetRow.manufacturercode = newlyAdded.manufacturercode;
                    targetRow.packaging = newlyAdded.packaging;
                    targetRow.quantity = 1;

                    var searchKey = targetRow.GetHashCode();
                    ItemSearchTexts[searchKey] = newlyAdded.itemname ?? "";
                    MfrSearchTexts[searchKey] = ManufacturerList.FirstOrDefault(m => m.manufacturercode == newlyAdded.manufacturercode)?.manufacturername ?? newlyAdded.manufacturer ?? "";

                    CalculateRow(targetRow);
                    ToastService.ShowSuccess($"Item '{newlyAdded.itemname}' created and added to purchase details.");
                }
                else
                {
                    ToastService.ShowSuccess("Item added successfully.");
                }
            }
            else
            {
                var error = response != null ? await response.Content.ReadAsStringAsync() : "Failed to connect to server";
                ToastService.ShowError($"Save item failed: {error}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving item: {ex.Message}");
        }
        finally
        {
            IsQuickItemSaving = false;
        }
    }

