                        <div class="form-grid" style="margin-bottom: 12px; row-gap: 12px;">
                            <div class="field-group col-2">
                                <label class="field-label">HSN Code</label>
                                <InputNumber class="form-control premium-input" @bind-Value="QuickHsnCodeInput" placeholder="0" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Accounting Group</label>
                                <InputSelect class="form-control premium-input" @bind-Value="SelectedQuickAccountingGroup">
                                    <option value="0">-- Select Group --</option>
                                    @foreach (var group in LedgerGroupList)
                                    {
                                        <option value="@group.ledgergroupcode">@group.ledgergroupname</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="field-group col-2">
                                 <label class="field-label">Nature Type</label>
                                 <div class="form-control premium-input bg-light text-muted d-flex align-items-center" style="height: 34px !important; padding-top: 0 !important; padding-bottom: 0 !important;">
                                     @(string.IsNullOrEmpty(GetQuickNatureTypeName()) ? "\u00A0" : GetQuickNatureTypeName())
                                 </div>
                             </div>
                            <div class="field-group col-1">
                                <label class="field-label">GST %</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentNewItem.gstpercentage">
                                    <option value="">-- Select GST(%) --</option>
                                    @foreach (var pct in LedgerTypeList.Where(x => x.isgstapplicable).Select(x => (int)(x.sgstpercentage + x.cgstpercentage)).Distinct().OrderBy(x => x))
                                    {
                                        <option value="@pct">GST @($"{pct}%")</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Min Stock</label>
                                <InputNumber class="form-control premium-input" @bind-Value="QuickMinStockInput" placeholder="0" />
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Reorder Level</label>
                                <InputNumber class="form-control premium-input" @bind-Value="QuickReorderLevelInput" placeholder="0" />
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Is Expiry?</label>
                                <div class="premium-segmented-control-joined">
                                    <button type="button" class="segment-btn-joined btn-false @(CurrentNewItem.expiryrequired ? "" : "active")" @onclick="() => CurrentNewItem.expiryrequired = false">
                                        False
                                    </button>
                                    <button type="button" class="segment-btn-joined btn-true @(CurrentNewItem.expiryrequired ? "active" : "")" @onclick="() => CurrentNewItem.expiryrequired = true">
                                        True
                                    </button>
                                </div>
                            </div>
                            <div class="field-group col-2">
                                @if (CurrentNewItem.expiryrequired)
                                {
                                    <label class="field-label">No of Days</label>
                                    <InputNumber class="form-control premium-input" @bind-Value="QuickExpiryAlertDaysInput" placeholder="0" />
                                }
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-actions" style="display: flex; justify-content: flex-end; align-items: center; padding: 10px 24px; border-top: 1px solid #f1f5f9; background: #fff;">
                        <div class="footer-right" style="display: flex; gap: 0.75rem; align-items: center;">
                            <button type="button" class="btn-cancel-modal" @onclick="CloseQuickAddItemModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.5rem 1.5rem; border-radius: 12px; font-weight: 700; min-width: 100px; transition: all 0.2s;">
                                Cancel
                            </button>
                            <button type="submit" class="btn-save-premium" disabled="@IsQuickItemSaving" style="background: #1c9f5f; color: white; border: none; padding: 0.5rem 1.75rem; border-radius: 12px; font-weight: 700; display: flex; align-items: center; gap: 8px; min-width: 140px; box-shadow: 0 4px 12px rgba(28, 159, 95, 0.2); transition: all 0.2s;">
                                @if (IsQuickItemSaving)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle" style="font-size: 1.2rem;"></i>
                                }
                                <span>Save Item</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


