    private void CalculateManualNet()
    {
        ManualNetAmount = ManualGross - ManualDiscount + ManualTax;
    }

    private void OnItemChanged(PurchaseDetailModel detail)
    {
        var item = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
        if (item != null) {
            detail.rate = item.purchaserate;
            detail.mrp = item.mrp;
            detail.packsize = (int)item.packsize;
            detail.packg = item.packsize;
            detail.uomcode = (int)item.uomcode;
            detail.taxpercentage = item.gstpercentage;
            detail.expirydate = null;
            detail.packaging = item.packaging;
            detail.manufacturercode = item.manufacturercode;

            // Sync MFR typeahead text
            var searchKey = detail.GetHashCode();
            ExpiryDateTexts.Remove(searchKey);
            MfrSearchTexts[searchKey] = ManufacturerList.FirstOrDefault(m => m.manufacturercode == item.manufacturercode)?.manufacturername ?? "";

            CalculateRow(detail);
        }
    }

    private void CalculateRow(PurchaseDetailModel detail)
    {
        var item = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
        if (item != null && detail.quantity > 0)
        {
            detail.packaging = (detail.quantity * item.packsize).ToString("0.##");
        }

        detail.amount = detail.quantity * detail.rate;
        detail.discountamount = (detail.amount * detail.discountpercentage) / 100;
        var afterDiscount = detail.amount - detail.discountamount;
        detail.taxamount = (afterDiscount * detail.taxpercentage) / 100;
        detail.totalamount = afterDiscount + detail.taxamount;
        CalculateTotals();
    }

    private void CalculateTotals()
    {
        CurrentRequest.master.grossamount = CurrentRequest.details.Sum(d => d.amount);
        var itemsDisc = CurrentRequest.details.Sum(d => d.discountamount);
        var baseTotal = CurrentRequest.details.Sum(d => d.totalamount);

        if (!ShowPhysicalBill && CurrentRequest.master.overalldiscount > 0)
        {
            var overallDisc = Math.Round((baseTotal * CurrentRequest.master.overalldiscount) / 100m, 2);
            CurrentRequest.master.discountamount = itemsDisc + overallDisc;
            CurrentRequest.master.taxamount = CurrentRequest.details.Sum(d => d.taxamount);
            CurrentRequest.master.netamount = Math.Max(0, baseTotal - overallDisc + CurrentRequest.master.roundoff);
            CurrentRequest.master.totalamount = CurrentRequest.master.netamount;
        }
        else
        {
            CurrentRequest.master.discountamount = itemsDisc;
            CurrentRequest.master.taxamount = CurrentRequest.details.Sum(d => d.taxamount);
            CurrentRequest.master.netamount = Math.Max(0, baseTotal + CurrentRequest.master.roundoff);
            CurrentRequest.master.totalamount = CurrentRequest.master.netamount;
        }
    }

    private decimal? GetRoundOff() => CurrentRequest.master.roundoff == 0 ? null : CurrentRequest.master.roundoff;

    private void SetRoundOff(decimal? val)
    {
        CurrentRequest.master.roundoff = val ?? 0;
        CalculateTotals();
    }

    private void RoundOffUp()
    {
        var baseTotal = CurrentRequest.details.Sum(d => d.totalamount);
        var overallDisc = (!ShowPhysicalBill && CurrentRequest.master.overalldiscount > 0)
            ? Math.Round((baseTotal * CurrentRequest.master.overalldiscount) / 100m, 2)
            : 0m;
        var netBeforeRound = baseTotal - overallDisc;
        var ceiling = Math.Ceiling(netBeforeRound);
        CurrentRequest.master.roundoff = Math.Round(ceiling - netBeforeRound, 2);
        CalculateTotals();
    }

    private void RoundOffDown()
    {
        var baseTotal = CurrentRequest.details.Sum(d => d.totalamount);
        var overallDisc = (!ShowPhysicalBill && CurrentRequest.master.overalldiscount > 0)
            ? Math.Round((baseTotal * CurrentRequest.master.overalldiscount) / 100m, 2)
            : 0m;
        var netBeforeRound = baseTotal - overallDisc;
        var floor = Math.Floor(netBeforeRound);
        CurrentRequest.master.roundoff = Math.Round(floor - netBeforeRound, 2);
        CalculateTotals();
    }

    private async Task SavePurchase()
    {
        if (IsEdit && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit purchases.");
            return;
        }
        if (!IsEdit && !hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add purchases.");
            return;
        }
        CalculateTotals();

        if ((CurrentRequest.master.vendorcode ?? 0) <= 0) {
            ToastService.ShowWarning("Please select a vendor");
            return;
        }
        CurrentRequest.details = CurrentRequest.details.Where(d => (d.itemcode > 0) && (d.quantity > 0)).ToList();
        if (!CurrentRequest.details.Any()) {
            ToastService.ShowWarning("Please add at least one valid item with quantity");
            if (!CurrentRequest.details.Any()) AddDetailRow();
            return;
        }

        var expiredItems = CurrentRequest.details.Where(d => d.itemcode > 0 && d.expirydate.HasValue && d.expirydate.Value.Date < DateTime.Today).ToList();
        if (expiredItems.Any())
        {
            var firstExpired = expiredItems.First();
            var itemName = ItemList.FirstOrDefault(i => i.itemcode == firstExpired.itemcode)?.itemname ?? $"Item {firstExpired.itemcode}";
            var expStr = firstExpired.expirydate.Value.ToString("MM/yy", System.Globalization.CultureInfo.InvariantCulture);
            ToastService.ShowError($"Cannot save purchase: '{itemName}' (Batch: {firstExpired.batchno}) is expired ({expStr}). Expired medicines cannot be purchased.");
            return;
        }

        if (ShowPhysicalBill)
        {
            // Show Bill Matched / Bill Mismatched popup
            IsBillMatched = Math.Round(ManualNetAmount, 2) == Math.Round(CurrentRequest.master.netamount, 2);
            ShowBillMatchPopup = true;
        }
        else
        {
            // Direct save when physical bill is disabled
            await ProceedSaveAfterMatch();
        }
    }

    private async Task ProceedSaveAfterMatch()
    {
        ShowBillMatchPopup = false;
        IsSaving = true;
        try {
            var client = CreateClient();
            // 1. Data Sanitization
            CurrentRequest.master.tenantcode = DefaultTenant;
            CurrentRequest.master.branchcode ??= "BLR001";
            CurrentRequest.master.companycode ??= "CMP001";
            CurrentRequest.master.usercode ??= 101;

            // Ensure dates have a value
            if (CurrentRequest.master.billdate == default(DateTime)) CurrentRequest.master.billdate = DateTime.Now.Date;
            if (!CurrentRequest.master.invoicedate.HasValue) CurrentRequest.master.invoicedate = DateTime.Now.Date;

            foreach (var d in CurrentRequest.details) {
                d.tenantcode = DefaultTenant;
                d.warehousecode = SelectedWarehouseCode ?? 0;
                d.receivedqty = d.quantity;
                d.orderedqty = d.quantity;
                if (!d.manufacturingdate.HasValue) d.manufacturingdate = DateTime.Now.Date;
                if (!d.expirydate.HasValue) d.expirydate = DateTime.Now.Date.AddYears(1);

                // Ensure packsize, packg, and manufacturercode are populated from item master or typeahead text if missing
                var searchKey = d.GetHashCode();
                if (MfrSearchTexts.TryGetValue(searchKey, out var typedMfr) && !string.IsNullOrWhiteSpace(typedMfr))
                {
                    var matchedMfr = ManufacturerList.FirstOrDefault(m => string.Equals(m.manufacturername, typedMfr, StringComparison.OrdinalIgnoreCase))
                               ?? ManufacturerList.FirstOrDefault(m => m.manufacturername != null && m.manufacturername.StartsWith(typedMfr, StringComparison.OrdinalIgnoreCase));
                    if (matchedMfr != null) d.manufacturercode = matchedMfr.manufacturercode;
                }

                var matchedItem = ItemList.FirstOrDefault(i => i.itemcode == d.itemcode);
                if (matchedItem != null)
                {
                    if (d.packsize <= 0) d.packsize = (int)matchedItem.packsize;
                    if (d.packg <= 0) d.packg = matchedItem.packsize;
                    if (d.manufacturercode <= 0 && matchedItem.manufacturercode > 0) d.manufacturercode = matchedItem.manufacturercode;
                    if (d.mrp <= 0 && matchedItem.mrp > 0) d.mrp = matchedItem.mrp;
                }
            }

            // 2. Prepare JSON Payload
            if (CurrentRequest.master.purchasecode > 0) {
                foreach(var d in CurrentRequest.details) d.purchasecode = CurrentRequest.master.purchasecode;
            }

            var options = new System.Text.Json.JsonSerializerOptions {
                DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull,
                PropertyNamingPolicy = null
            };

            var json = System.Text.Json.JsonSerializer.Serialize(CurrentRequest, options);
            Console.WriteLine("=================== PURCHASE PAYLOAD ===================");
            Console.WriteLine(json);
            Console.WriteLine("=========================================================");
            await JS.InvokeVoidAsync("console.log", "Sending JSON Payload:", json);

            var url = IsEdit ? "api/ItemMaster/updatepurchase" : "api/ItemMaster/insertpurchase";
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

            var response = await client.PostAsync(url, content);

            if (response.IsSuccessStatusCode) {
                ToastService.ShowSuccess(IsEdit ? "Purchase updated" : "Purchase recorded");
                // Reset manual bill total inputs for next use
                ManualGross = 0;
                ManualDiscount = 0;
                ManualTax = 0;
                ManualNetAmount = 0;
                EditableRows.Clear();
                ShowModal = false;
                await LoadPurchases();
            } else {
                var errorBody = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Save Failed (400): {errorBody}");
                await JS.InvokeVoidAsync("console.error", "Update/Insert Failed:", errorBody);
            }
        } catch (Exception ex) {
            ToastService.ShowError($"Error: {ex.Message}");
        } finally {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(PurchaseMasterModel p)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete purchases.");
            return;
        }
        PendingDelete = p;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteConfirmed()
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete purchases.");
            return;
        }
        if (PendingDelete == null) return;
        IsLoading = true;
        try {
            var code = (PendingDelete.purchasecode > 0) ? PendingDelete.purchasecode.ToString() : PendingDelete.billno;
            var success = await DeletePurchase(code);
            if (success) {
                ToastService.ShowSuccess("Purchase deleted");
                await LoadPurchases();
            } else {
                // Final Fallback: Soft Delete via Update
                var softSuccess = await SoftDeleteViaUpdate(PendingDelete.billno ?? "");
                if (softSuccess) {
                    ToastService.ShowSuccess("Purchase deactivated (Soft-Delete)");
                    await LoadPurchases();
                } else {
                    ToastService.ShowError("Delete failed. Please verify API mapping.");
                }
            }
        } catch (Exception ex) {
            ToastService.ShowError($"Error: {ex.Message}");
        } finally {
            ShowDeleteConfirm = false;
            PendingDelete = null;
            IsLoading = false;
        }
    }

    private async Task<bool> DeletePurchase(string? code)
    {
        if (string.IsNullOrEmpty(code)) return false;
        var client = CreateClient();
        var isNumeric = long.TryParse(code, out _);

        var urls = new List<string>();
        if (isNumeric) {
            urls.Add($"api/ItemMaster/deletepurchase?purchasecode={code}");
            urls.Add($"Purchase/deletepurchase?purchasecode={code}");
            urls.Add($"api/ItemMaster/deletepurchase?purchasecode={code}&tenantcode={DefaultTenant}");
        } else {
            urls.Add($"api/ItemMaster/deletepurchase?billno={code}");
            urls.Add($"Purchase/deletepurchase?billno={code}");
            urls.Add($"api/ItemMaster/deletepurchase?billno={code}&tenantcode={DefaultTenant}");
            urls.Add($"api/ItemMaster/deletepurchase?purchasecode={code}"); // Last resort
        }

        foreach (var url in urls) {
            try {
                var response = await client.GetAsync(url);
                if (response.IsSuccessStatusCode) return true;
                
                // Try DELETE method as fallback
                var delResponse = await client.DeleteAsync(url);
                if (delResponse.IsSuccessStatusCode) return true;
            } catch { }
        }
        return false;
    }

    private async Task<bool> SoftDeleteViaUpdate(string billNo)
    {
        try {
            var client = CreateClient();
            string responseText = "";
            
            // 1. Check if we already have it in memory
            var cached = FullPurchaseRequests.FirstOrDefault(f => f.master?.billno == billNo);
            if (cached != null && cached.master != null) {
                cached.master.deleted = true;
                cached.master.isactive = false;
                cached.master.tenantcode = DefaultTenant;
                if (cached.details != null) {
                    foreach(var d in cached.details) d.tenantcode = DefaultTenant;
                }
                var updateResponse = await client.PostAsJsonAsync($"api/ItemMaster/updatepurchase?purchasecode={billNo}&tenantcode={DefaultTenant}", cached);
                if (updateResponse.IsSuccessStatusCode) return true;
            }

            // 2. If not cached, fall back to discovery fetch
            var fetchUrls = new List<string> {
                $"api/ItemMaster/getpurchasebycode?purchasecode={billNo}&tenantcode={DefaultTenant}",
                $"api/ItemMaster/getpurchasebycode?purchaseCode={billNo}&tenantCode={DefaultTenant}",
                $"api/ItemMaster/getpurchasebycode/{billNo}?tenantcode={DefaultTenant}",
                $"api/ItemMaster/getpurchasebycode?billno={billNo}&tenantcode={DefaultTenant}",
                $"api/ItemMaster/getpurchasebycode?billNo={billNo}&tenantCode={DefaultTenant}",
                $"api/ItemMaster/getpurchasebycode?code={billNo}&tenantcode={DefaultTenant}",
                $"Purchase/getpurchasebycode?purchasecode={billNo}&tenantcode={DefaultTenant}",
                $"Purchase/getpurchasebycode/{billNo}?tenantcode={DefaultTenant}",
                $"api/ItemMaster/getpurchasebyid?purchasecode={billNo}&tenantcode={DefaultTenant}",
                $"api/ItemMaster/getpurchasebybillno?billno={billNo}&tenantcode={DefaultTenant}",
                $"api/ItemMaster/getpurchase?purchasecode={billNo}&tenantcode={DefaultTenant}",
                $"api/ItemMaster/getpurchasebycode?purchasecode={billNo}",
                $"api/ItemMaster/getpurchasebycode?billno={billNo}"
            };


            foreach (var url in fetchUrls) {
                try {
                    responseText = await client.GetStringAsync(url);
                    var request = ParseRequestResponse(responseText);
                    if (request != null && request.master != null) {
                        request.master.deleted = true;
                        request.master.isactive = false;
                        request.master.tenantcode = DefaultTenant;
                        
                        if (request.details != null) {
                            foreach(var d in request.details) d.tenantcode = DefaultTenant;
                        }

                        // Try multiple update variations for soft delete too
                        var updateUrl = $"api/ItemMaster/updatepurchase?purchasecode={billNo}&tenantcode={DefaultTenant}";
                        var updateResponse = await client.PostAsJsonAsync(updateUrl, request);
                        if (!updateResponse.IsSuccessStatusCode) {
                            // Fallback to simple URL
                            updateResponse = await client.PostAsJsonAsync("api/ItemMaster/updatepurchase", request);
                        }
                        
                        if (updateResponse.IsSuccessStatusCode) return true;
                    }
                } catch { }
            }
            return false;
        } catch {
            return false;
        }
    }

    private async Task<HttpResponseMessage> SendRequest(HttpClient client, HttpMethod method, string url, object content, JsonSerializerOptions options)
    {
        if (method == HttpMethod.Post) return await client.PostAsJsonAsync(url, content, options);
        if (method == HttpMethod.Put) return await client.PutAsJsonAsync(url, content, options);
        return await client.PostAsJsonAsync(url, content, options);
    }

    private static string FormatDateOnly(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        
        // Remove trailing time part if it is standard T00:00:00
        var cleanValue = value.Trim();
        if (cleanValue.Contains('T')) {
            cleanValue = cleanValue.Split('T')[0];
        } else if (cleanValue.Contains(' ')) {
            cleanValue = cleanValue.Split(' ')[0];
        }

        // Try standard invariant parsing first (e.g. M/d/yyyy works here)
        if (DateTime.TryParse(cleanValue, System.Globalization.CultureInfo.InvariantCulture, out var parsedInv))
            return parsedInv.ToString("yyyy-MM-dd");

        // Try standard local parsing
        if (DateTime.TryParse(cleanValue, out var parsed)) 
            return parsed.ToString("yyyy-MM-dd");

        // Explicit format patterns matching common ones
        var formats = new[] { 
            "M/d/yyyy", "MM/dd/yyyy", "d/M/yyyy", "dd/MM/yyyy", 
            "yyyy-MM-dd", "yyyy/MM/dd", "d.M.yyyy", "dd.MM.yyyy",
            "M-d-yyyy", "MM-dd-yyyy", "d-M-yyyy", "dd-MM-yyyy"
        };
        if (DateTime.TryParseExact(cleanValue, formats, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsedExact))
        {
            return parsedExact.ToString("yyyy-MM-dd");
        }

        return cleanValue;
    }

    private static string? NormalizeDateForInput(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return value;
        return FormatDateOnly(value);
    }

