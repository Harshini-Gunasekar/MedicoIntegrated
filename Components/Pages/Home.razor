@page "/home"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Newtonsoft.Json
@using SharedComponents.Rcl.Models
@using SharedComponents.Rcl.Services
@inject TenantSessionState TenantState
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.ToastService ToastService
@inject Booking.Services.RoleMasterService RoleService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Welcome - Medico Portal</PageTitle>

<div class="welcome-dashboard-container">
    @if (isLoading)
    {
        <div class="welcome-loading-state">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted fw-semibold" style="font-size: 0.85rem;">Loading session details...</p>
        </div>
    }
    else
    {
        <!-- ════════ HERO WELCOME CARD ════════ -->
        <div class="welcome-hero-card">
            <!-- Glassmorphism ambient gradient background bubbles -->
            <div class="hero-bg-orb orb-1"></div>
            <div class="hero-bg-orb orb-2"></div>

            <div class="welcome-hero-top">
                <div class="greeting-badge">
                    <i class="bi bi-sun-fill greeting-icon"></i>
                    <span>@GetGreeting()</span>
                </div>
                <div class="time-badge">
                    <i class="bi bi-calendar3 me-1"></i>
                    <span>@currentDateTime.ToString("dddd, dd MMMM yyyy")</span>
                </div>
            </div>

            <div class="welcome-hero-main">
                <!-- HOSPITAL & USER IDENTITY BLOCK -->
                <div class="identity-grid">
                    <!-- 1. HOSPITAL NAME CARD -->
                    <div class="hospital-identity-box">
                        <div class="identity-icon-wrap hospital-icon">
                            <i class="bi bi-hospital-fill"></i>
                        </div>
                        <div class="identity-details">
                            <span class="identity-sub-label">HOSPITAL / FACILITY NAME</span>
                            <h1 class="hospital-title-text">
                                @GetResolvedHospitalName()
                            </h1>
                            <div class="identity-tags">
                                <span class="badge-tag tenant-tag">
                                    <i class="bi bi-shield-check me-1"></i>
                                    Tenant Code: @(string.IsNullOrWhiteSpace(tenantCode) ? "MEDICO" : tenantCode)
                                </span>
                                @if (branchCode.HasValue && branchCode.Value > 0)
                                {
                                    <span class="badge-tag branch-tag">
                                        <i class="bi bi-building me-1"></i>
                                        Branch #@branchCode.Value
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="identity-divider"></div>

                    <!-- 2. LOGGED-IN USER CARD -->
                    <div class="user-identity-box">
                        <div class="user-avatar-wrap">
                            <div class="user-avatar-circle">
                                @GetUserInitials()
                            </div>
                            <span class="user-online-pulse" title="Active Session"></span>
                        </div>
                        <div class="identity-details">
                            <span class="identity-sub-label">LOGGED-IN USER</span>
                            <h2 class="user-name-text">
                                @GetResolvedUserName()
                            </h2>
                            @if (!string.IsNullOrWhiteSpace(GetResolvedUserRole()))
                            {
                                <div class="identity-tags">
                                    <span class="badge-tag role-tag">
                                        <i class="bi bi-person-badge-fill me-1"></i>
                                        @GetResolvedUserRole()
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ════════ QUICK NAVIGATION PORTAL CARDS ════════ -->
        <div class="portal-section-header">
            <div class="portal-title-wrap">
                <i class="bi bi-grid-3x3-gap-fill text-primary"></i>
                <h3 class="portal-section-title">Operational Portal Workspaces</h3>
            </div>
            <span class="portal-section-sub">Quick single-click access to active hospital departments</span>
        </div>

        @if (HasAnyPortalModule())
        {
            <div class="portal-cards-grid">
                <!-- 1. OP PORTAL -->
                @if (HasMainModule("OP Portal"))
                {
                    <div class="portal-card" @onclick='() => NavigateTo("/op-dashboard")'>
                        <div class="portal-card-top">
                            <div class="portal-icon-box op">
                                <i class="bi bi-heart-pulse-fill"></i>
                            </div>
                            <span class="portal-badge op">OP PORTAL</span>
                        </div>
                        <h4 class="portal-card-title">Outpatient Department</h4>
                        <p class="portal-card-desc">Patient check-in, outpatient queue management, customer history, and slot schedules.</p>
                        <div class="portal-actions-row" @onclick:stopPropagation="true">
                            @if (HasRight("OP Portal", "Patient Check-in"))
                            {
                                <a href="/booking/reception" class="btn-portal-action"><i class="bi bi-people-fill me-1"></i>Check-In</a>
                            }
                            @if (HasRight("OP Portal", "Outpatient Visiting"))
                            {
                                <a href="/booking/outpatient" class="btn-portal-action"><i class="bi bi-hospital me-1"></i>Visits</a>
                            }
                            @if (HasRight("OP Portal", "Patient Master"))
                            {
                                <a href="/patientmaster" class="btn-portal-action"><i class="bi bi-person-circle me-1"></i>Patients</a>
                            }
                        </div>
                    </div>
                }

                <!-- 2. IP PORTAL -->
                @if (HasMainModule("IP Portal"))
                {
                    <div class="portal-card" @onclick='() => NavigateTo("/ip-dashboard")'>
                        <div class="portal-card-top">
                            <div class="portal-icon-box ip">
                                <i class="bi bi-hospital-fill"></i>
                            </div>
                            <span class="portal-badge ip">IP PORTAL</span>
                        </div>
                        <h4 class="portal-card-title">Inpatient Department</h4>
                        <p class="portal-card-desc">Inpatient admissions, available bed monitoring, bed transfers, and nursing documentation.</p>
                        <div class="portal-actions-row" @onclick:stopPropagation="true">
                            @if (HasRight("IP Portal", "IP Registration"))
                            {
                                <a href="/booking/ip-registration" class="btn-portal-action"><i class="bi bi-box-arrow-in-right me-1"></i>Admission</a>
                            }
                            @if (HasRight("IP Portal", "Available Beds"))
                            {
                                <a href="/booking/available-beds" class="btn-portal-action"><i class="bi bi-door-open me-1"></i>Beds</a>
                            }
                            @if (HasRight("IP Portal", "Nurse Notes"))
                            {
                                <a href="/ip/nurse-notes" class="btn-portal-action"><i class="bi bi-clipboard2-pulse me-1"></i>Nurse Notes</a>
                            }
                        </div>
                    </div>
                }

                <!-- 3. BILLING PORTAL -->
                @if (HasMainModule("Billing Portal"))
                {
                    <div class="portal-card" @onclick='() => NavigateTo("/billing")'>
                        <div class="portal-card-top">
                            <div class="portal-icon-box billing">
                                <i class="bi bi-credit-card-2-front-fill"></i>
                            </div>
                            <span class="portal-badge billing">BILLING PORTAL</span>
                        </div>
                        <h4 class="portal-card-title">Cash &amp; Invoicing</h4>
                        <p class="portal-card-desc">Counter sales, bill invoice generation, due collections, and counter shift balances.</p>
                        <div class="portal-actions-row" @onclick:stopPropagation="true">
                            @if (HasRight("Billing Portal", "Billing Portal"))
                            {
                                <a href="/billing" class="btn-portal-action"><i class="bi bi-receipt me-1"></i>Billing</a>
                            }
                            @if (HasRight("Billing Portal", "Bill List"))
                            {
                                <a href="/bills" class="btn-portal-action"><i class="bi bi-file-earmark-text me-1"></i>Bills List</a>
                            }
                            @if (HasRight("Billing Portal", "Counter Shift"))
                            {
                                <a href="/counter-shift" class="btn-portal-action"><i class="bi bi-clock-history me-1"></i>Shift</a>
                            }
                        </div>
                    </div>
                }

                <!-- 4. LABORATORY -->
                @if (HasMainModule("Laboratory"))
                {
                    <div class="portal-card" @onclick='() => NavigateTo("/lab-result-search")'>
                        <div class="portal-card-top">
                            <div class="portal-icon-box lab">
                                <i class="bi bi-flask-fill"></i>
                            </div>
                            <span class="portal-badge lab">LABORATORY</span>
                        </div>
                        <h4 class="portal-card-title">Diagnostics &amp; Lab</h4>
                        <p class="portal-card-desc">Pathology test entry, result search, report approvals, and machine integration setup.</p>
                        <div class="portal-actions-row" @onclick:stopPropagation="true">
                            @if (HasRight("Laboratory", "Result Entry"))
                            {
                                <a href="/result-entry" class="btn-portal-action"><i class="bi bi-file-earmark-medical me-1"></i>Result Entry</a>
                            }
                            @if (HasRight("Laboratory", "Result Search"))
                            {
                                <a href="/lab-result-search" class="btn-portal-action"><i class="bi bi-search me-1"></i>Search</a>
                            }
                            @if (HasRight("Laboratory", "Test Master"))
                            {
                                <a href="/test-master" class="btn-portal-action"><i class="bi bi-gear-wide-connected me-1"></i>Tests</a>
                            }
                        </div>
                    </div>
                }

                <!-- 5. PHARMACY & INVENTORY -->
                @if (HasMainModule("Pharmacy") || HasMainModule("Inventory"))
                {
                    <div class="portal-card" @onclick='() => NavigateTo("/salesmaster")'>
                        <div class="portal-card-top">
                            <div class="portal-icon-box pharmacy">
                                <i class="bi bi-capsule-pill-fill"></i>
                            </div>
                            <span class="portal-badge pharmacy">PHARMACY</span>
                        </div>
                        <h4 class="portal-card-title">Pharmacy &amp; Stock</h4>
                        <p class="portal-card-desc">Medicine counter sales, returns, purchase orders, indent approvals, and stock control.</p>
                        <div class="portal-actions-row" @onclick:stopPropagation="true">
                            @if (HasRight("Pharmacy", "Pharmacy Billing"))
                            {
                                <a href="/salesmaster" class="btn-portal-action"><i class="bi bi-cart-check me-1"></i>Sales</a>
                            }
                            @if (HasRight("Inventory", "Stock"))
                            {
                                <a href="/stock" class="btn-portal-action"><i class="bi bi-boxes me-1"></i>Stock</a>
                            }
                            @if (HasRight("Inventory", "Purchase"))
                            {
                                <a href="/purchasemaster" class="btn-portal-action"><i class="bi bi-bag-plus me-1"></i>Purchase</a>
                            }
                        </div>
                    </div>
                }

                <!-- 6. ADMIN & SECURITY -->
                @if (IsAdmin() || HasMainModule("Admin Portal"))
                {
                    <div class="portal-card" @onclick='() => NavigateTo("/UserRights")'>
                        <div class="portal-card-top">
                            <div class="portal-icon-box admin">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <span class="portal-badge admin">ADMINISTRATION</span>
                        </div>
                        <h4 class="portal-card-title">User &amp; Rights Master</h4>
                        <p class="portal-card-desc">Configure user accounts, granular security permissions, role assignments, and branch masters.</p>
                        <div class="portal-actions-row" @onclick:stopPropagation="true">
                            @if (HasRight("Admin Portal", "User Rights"))
                            {
                                <a href="/UserRights" class="btn-portal-action"><i class="bi bi-shield-check me-1"></i>User Rights</a>
                            }
                            @if (HasRight("Admin Portal", "User Master"))
                            {
                                <a href="/user-master" class="btn-portal-action"><i class="bi bi-person-lock me-1"></i>User Master</a>
                            }
                            @if (HasRight("Admin Portal", "Branch Master"))
                            {
                                <a href="/branchmaster" class="btn-portal-action"><i class="bi bi-building me-1"></i>Branches</a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-permissions-card text-center p-4 my-3" style="background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.12); border-radius: 12px;">
                <i class="bi bi-shield-lock text-warning" style="font-size: 2.2rem;"></i>
                <h5 class="mt-2 text-white" style="font-weight: 600;">No Operational Modules Assigned</h5>
                <p class="text-muted mb-0" style="font-size: 0.875rem;">Your account currently has no module rights assigned for Tenant <strong>@(string.IsNullOrEmpty(tenantCode) ? "0012" : tenantCode)</strong>. Please contact your administrator to configure your role permissions in Role Master.</p>
            </div>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private string hospitalName = "";
    private string userName = "";
    private string userRole = "";
    private string tenantCode = "";
    private int? branchCode;
    private DateTime currentDateTime = DateTime.Now;
    private bool _isAdminSession = false;

    protected override void OnInitialized()
    {
        TenantState.OnSessionChanged += HandleSessionChanged;
        RoleService.OnPermissionsChanged += HandlePermissionsChanged;
        SyncFromTenantState();
        if (TenantState.IsAuthenticated && (IsAdmin() || RoleService.IsPermissionsLoaded))
        {
            isLoading = false;
        }
    }

    private void SyncFromTenantState()
    {
        if (!string.IsNullOrEmpty(TenantState.TenantName))
        {
            hospitalName = TenantState.TenantName;
        }
        if (TenantState.UserData != null)
        {
            if (!string.IsNullOrEmpty(TenantState.UserData.UserName))
                userName = TenantState.UserData.UserName;
            if (!string.IsNullOrEmpty(TenantState.UserData.Role))
            {
                userRole = TenantState.UserData.Role;
                if (IsAdminRole(userRole))
                    _isAdminSession = true;
            }
        }
        if (!string.IsNullOrEmpty(TenantState.TenantCode))
        {
            tenantCode = TenantState.TenantCode;
        }
        if (TenantState.BranchCode.HasValue)
        {
            branchCode = TenantState.BranchCode;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await LoadSessionDetailsAsync();
            }
            catch { }
            finally
            {
                isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
            _ = CheckActiveShiftAsync();
        }
    }

    private async Task LoadSessionDetailsAsync()
    {
        try
        {
            // 1. Try reading from TenantState first
            SyncFromTenantState();

            // 2. Fast single-pass localStorage session read (0ms instant)
            try
            {
                var localSessionJson = await JSRuntime.InvokeAsync<string>("medicoSessionHelper.getSession");
                if (!string.IsNullOrWhiteSpace(localSessionJson))
                {
                    var jObj = Newtonsoft.Json.Linq.JObject.Parse(localSessionJson);
                    var uName = jObj["user_name"]?.ToString() ?? jObj["login_input"]?.ToString() ?? "";
                    if (!string.IsNullOrWhiteSpace(uName)) userName = uName.Trim();

                    var uRole = jObj["user_role"]?.ToString() ?? "";
                    if (!string.IsNullOrWhiteSpace(uRole)) userRole = uRole.Trim();

                    var tCode = jObj["tenant_code"]?.ToString() ?? "";
                    if (!string.IsNullOrWhiteSpace(tCode)) tenantCode = tCode.Trim();

                    var tName = jObj["tenant_name"]?.ToString() ?? "";
                    if (!string.IsNullOrWhiteSpace(tName) && !string.Equals(tName.Trim(), userName, StringComparison.OrdinalIgnoreCase))
                        hospitalName = tName.Trim();

                    if (!branchCode.HasValue) branchCode = jObj["bhcode"]?.ToObject<int?>();

                    var isAdm = jObj["isAdmin"]?.ToObject<bool>() == true;
                    if (isAdm)
                    {
                        _isAdminSession = true;
                        if (string.IsNullOrEmpty(userRole))
                            userRole = "Administrator";
                    }

                    // IMMEDIATELY render UI to remove any visible lag
                    isLoading = false;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { }

            if (!_isAdminSession)
            {
                try
                {
                    var itaRes = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
                    if (itaRes.Success && itaRes.Value) _isAdminSession = true;
                }
                catch { }
            }

            // 3. Fallbacks from ProtectedSessionStorage if empty
            if (string.IsNullOrEmpty(hospitalName))
            {
                var hRes = await _sessionStorage.GetAsync<string>("tenant_name");
                if (hRes.Success && !string.IsNullOrEmpty(hRes.Value))
                    hospitalName = hRes.Value.Trim();
            }

            if (string.IsNullOrEmpty(userName) || string.IsNullOrEmpty(userRole))
            {
                var uRes = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                if (uRes.Success && uRes.Value != null)
                {
                    if (string.IsNullOrEmpty(userName) && !string.IsNullOrEmpty(uRes.Value.UserName))
                        userName = uRes.Value.UserName.Trim();
                    if (string.IsNullOrEmpty(userRole) && !string.IsNullOrEmpty(uRes.Value.Role))
                        userRole = uRes.Value.Role.Trim();
                    if (string.IsNullOrEmpty(hospitalName) && !string.IsNullOrEmpty(uRes.Value.TenantName))
                        hospitalName = uRes.Value.TenantName.Trim();
                }
            }

            if (string.IsNullOrEmpty(userName))
            {
                var unRes = await _sessionStorage.GetAsync<string>("user_name");
                if (unRes.Success && !string.IsNullOrEmpty(unRes.Value))
                    userName = unRes.Value.Trim();
            }

            if (string.IsNullOrEmpty(userRole))
            {
                var urRes = await _sessionStorage.GetAsync<string>("user_role");
                if (urRes.Success && !string.IsNullOrEmpty(urRes.Value))
                    userRole = urRes.Value.Trim();
            }

            if (string.IsNullOrEmpty(tenantCode))
            {
                var tRes = await _sessionStorage.GetAsync<string>("tenant_code");
                if (tRes.Success && !string.IsNullOrEmpty(tRes.Value))
                    tenantCode = tRes.Value.Trim();
            }

            if (!branchCode.HasValue)
            {
                try
                {
                    var bStrRes = await _sessionStorage.GetAsync<string>("bhcode");
                    if (bStrRes.Success && int.TryParse(bStrRes.Value, out int bVal) && bVal > 0)
                    {
                        branchCode = bVal;
                    }
                    else
                    {
                        var bRes = await _sessionStorage.GetAsync<int>("bhcode");
                        if (bRes.Success && bRes.Value > 0)
                            branchCode = bRes.Value;
                    }
                }
                catch { }
            }

            // 4. Ensure hospitalName is NOT the logged-in user's name
            if (string.IsNullOrWhiteSpace(hospitalName) || string.Equals(hospitalName.Trim(), userName?.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                hospitalName = "";

                // A. Check user's assigned branches in session
                if (TenantState.UserData?.Branches != null && TenantState.UserData.Branches.Any())
                {
                    var matched = (branchCode.HasValue && branchCode.Value > 0)
                        ? TenantState.UserData.Branches.FirstOrDefault(b => b.bh_code == branchCode.Value)
                        : TenantState.UserData.Branches.FirstOrDefault(b => b.bh_code != 21 && (string.IsNullOrWhiteSpace(b.name) || !b.name.Contains("sample", StringComparison.OrdinalIgnoreCase)));

                    if (matched != null && !string.IsNullOrWhiteSpace(matched.name) && !string.Equals(matched.name.Trim(), userName?.Trim(), StringComparison.OrdinalIgnoreCase))
                    {
                        hospitalName = matched.name.Trim();
                    }
                }

                if (string.IsNullOrEmpty(hospitalName))
                {
                    var ubRes = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.BranchModel>>("UserBranches");
                    if (ubRes.Success && ubRes.Value != null && ubRes.Value.Any())
                    {
                        var matched = (branchCode.HasValue && branchCode.Value > 0)
                            ? ubRes.Value.FirstOrDefault(b => b.bh_code == branchCode.Value)
                            : ubRes.Value.FirstOrDefault(b => b.bh_code != 21 && b.bh_code != 39 && (string.IsNullOrWhiteSpace(b.name) || !b.name.Contains("sample", StringComparison.OrdinalIgnoreCase)));

                        if (matched != null && !string.IsNullOrWhiteSpace(matched.name) && !string.Equals(matched.name.Trim(), userName?.Trim(), StringComparison.OrdinalIgnoreCase))
                        {
                            hospitalName = matched.name.Trim();
                        }
                    }
                }
            }

            // 5. Admin role catalog initialization if needed
            if (IsAdmin() && !RoleService.IsPermissionsLoaded)
            {
                RoleService.SetUserPermissions(RoleCatalogDefaults.GetDefaultPermissions());
            }

            // 6. Synchronize with TenantState if empty so other components stay in sync
            if (!string.IsNullOrEmpty(userName) && (TenantState.UserData == null || string.IsNullOrWhiteSpace(TenantState.UserData.UserName)))
            {
                var ud = TenantState.UserData ?? new UserDetailsModel();
                ud.UserName = userName;
                ud.Role = string.IsNullOrEmpty(userRole) ? (IsAdmin() ? "Administrator" : (ud.Role ?? "User")) : userRole;
                ud.TenantCode = string.IsNullOrEmpty(tenantCode) ? (ud.TenantCode ?? "") : tenantCode;
                ud.TenantName = GetResolvedHospitalName();
                ud.BranchCode = branchCode;
                var currentRights = (TenantState.UserRightsList != null && TenantState.UserRightsList.Any()) 
                    ? TenantState.UserRightsList.ToList() 
                    : null;
                if (currentRights == null || !currentRights.Any())
                {
                    try
                    {
                        var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                        if (rightsResult.Success && rightsResult.Value != null && rightsResult.Value.Any())
                            currentRights = rightsResult.Value;
                    }
                    catch { }
                }
                TenantState.SetSession(ud.TenantCode, TenantState.AuthToken ?? "", ud.TenantName, ud.UserCode ?? (IsAdmin() ? 0 : 0), branchCode, ud.CounterCode, ud, currentRights ?? new List<SharedComponents.Rcl.Models.User_Rights>());
            }

            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { return; }
        catch (Microsoft.JSInterop.JSDisconnectedException) { return; }
        catch (Exception ex)
        {
            Console.WriteLine($"[HomeWelcome] Error loading session: {ex.Message}");
        }
    }

    private string GetResolvedUserName()
    {
        if (!string.IsNullOrWhiteSpace(userName)) return userName;
        if (!string.IsNullOrWhiteSpace(TenantState.UserData?.UserName)) return TenantState.UserData.UserName;
        return "";
    }

    private string GetResolvedUserRole()
    {
        if (!string.IsNullOrWhiteSpace(userRole) && !int.TryParse(userRole, out _)) return userRole;
        if (!string.IsNullOrWhiteSpace(TenantState.UserData?.Role) && !int.TryParse(TenantState.UserData.Role, out _)) return TenantState.UserData.Role;
        if (IsAdmin()) return "Administrator";
        return "";
    }

    private string GetResolvedHospitalName()
    {
        if (!string.IsNullOrWhiteSpace(hospitalName) && !string.Equals(hospitalName.Trim(), userName?.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            return hospitalName.Trim();
        }
        if (!string.IsNullOrWhiteSpace(TenantState.TenantName) && !string.Equals(TenantState.TenantName.Trim(), userName?.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            return TenantState.TenantName.Trim();
        }
        if (!string.IsNullOrWhiteSpace(TenantState.UserData?.TenantName) && !string.Equals(TenantState.UserData.TenantName.Trim(), userName?.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            return TenantState.UserData.TenantName.Trim();
        }
        if (!string.IsNullOrWhiteSpace(tenantCode) && !string.Equals(tenantCode, "MEDICO", StringComparison.OrdinalIgnoreCase))
        {
            return $"{tenantCode} Healthcare Facility";
        }
        return "Medico Healthcare Hospital";
    }

    private async void HandleSessionChanged()
    {
        SyncFromTenantState();
        if (IsAdmin() && !RoleService.IsPermissionsLoaded)
        {
            RoleService.SetUserPermissions(RoleCatalogDefaults.GetDefaultPermissions());
        }
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void HandlePermissionsChanged()
    {
        if (IsAdmin() && !RoleService.IsPermissionsLoaded)
        {
            RoleService.SetUserPermissions(RoleCatalogDefaults.GetDefaultPermissions());
        }
        isLoading = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url);
    }

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "Good Morning";
        if (hour < 17) return "Good Afternoon";
        return "Good Evening";
    }

    private string GetUserInitials()
    {
        var name = GetResolvedUserName();
        if (string.IsNullOrWhiteSpace(name) || name == "Authorized User")
        {
            var role = GetResolvedUserRole();
            return !string.IsNullOrWhiteSpace(role) && role.Length >= 2 ? role.Substring(0, 2).ToUpper() : "U";
        }
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();
    }

    private async Task CheckActiveShiftAsync()
    {
        try
        {
            var openCounters = await HmsBillingService.GetOpenCountersAsync();
            if (openCounters == null || !openCounters.Any())
            {
                ToastService.ShowWarning("No active shifts open. Please open the shift.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Home] Error checking active shifts: {ex.Message}");
        }
    }

    private static bool IsAdminRole(string? role)
    {
        if (string.IsNullOrWhiteSpace(role)) return false;
        var r = role.Trim();
        return string.Equals(r, "Administrator", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Super Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "SuperAdmin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Power User", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "PowerUser", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Tenant", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Tenant Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "TenantAdmin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Client Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "ClientAdmin", StringComparison.OrdinalIgnoreCase) ||
               r.Contains("Admin", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsAdminRoleFromJwt(string? token)
    {
        if (string.IsNullOrEmpty(token)) return false;
        try
        {
            var segments = token.Split('.');
            if (segments.Length < 2) return false;
            var payload = segments[1];
            switch (payload.Length % 4)
            {
                case 2: payload += "=="; break;
                case 3: payload += "="; break;
            }
            var jsonBytes = Convert.FromBase64String(payload);
            var claims = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
            if (claims == null) return false;
            
            if (claims.TryGetValue("IsAdmin", out var isAdmVal) && 
                (string.Equals(isAdmVal?.ToString(), "true", StringComparison.OrdinalIgnoreCase) || 
                 string.Equals(isAdmVal?.ToString(), "True", StringComparison.OrdinalIgnoreCase)))
                return true;

            if (claims.TryGetValue("power_user", out var puVal) && 
                (string.Equals(puVal?.ToString(), "true", StringComparison.OrdinalIgnoreCase) || 
                 string.Equals(puVal?.ToString(), "True", StringComparison.OrdinalIgnoreCase)))
                return true;

            object? rVal = null;
            if (!claims.TryGetValue("role", out rVal) &&
                !claims.TryGetValue("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out rVal))
                return false;
            return IsAdminRole(rVal?.ToString());
        }
        catch { return false; }
    }

    private bool IsAdmin()
    {
        if (_isAdminSession) return true;

        var role = userRole;
        if (string.IsNullOrEmpty(role)) role = TenantState.UserData?.Role;
        if (!string.IsNullOrEmpty(role) && IsAdminRole(role))
        {
            _isAdminSession = true;
            return true;
        }

        var uName = userName;
        if (string.IsNullOrEmpty(uName)) uName = TenantState.UserData?.UserName;
        if (string.Equals(uName, "admin", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(uName, "administrator", StringComparison.OrdinalIgnoreCase))
        {
            _isAdminSession = true;
            return true;
        }

        var token = TenantState.AuthToken ?? TenantState.UserData?.AuthToken;
        if (IsAdminRoleFromJwt(token))
        {
            _isAdminSession = true;
            return true;
        }

        return false;
    }

    private bool HasMainModule(string module) => IsAdmin() || RoleService.HasMainModule(module);
    private bool HasRight(string mainModule, string subModule) => IsAdmin() || RoleService.HasRight(mainModule, subModule);

    private bool HasAnyPortalModule()
    {
        return IsAdmin() ||
               HasMainModule("OP Portal") ||
               HasMainModule("IP Portal") ||
               HasMainModule("Billing Portal") ||
               HasMainModule("Laboratory") ||
               HasMainModule("Pharmacy") ||
               HasMainModule("Inventory") ||
               HasMainModule("Doctor Portal") ||
               HasMainModule("Admin Portal");
    }

