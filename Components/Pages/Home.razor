@page "/home"
@rendermode InteractiveServer

<div class="dashboard-container">
    <!-- WELCOME BANNER -->
    <div class="welcome-section">
        <div class="welcome-text">
            <h1>Welcome back, Admin</h1>
            <p>Here's what's happening in your Medico Portal today. You have 8 pending reports to review.</p>
        </div>
    </div>

    <!-- STATS OVERVIEW -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-info">
                <span class="value">1,284</span>
                <span class="label">Total Patients</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">
                <i class="bi bi-calendar-check-fill"></i>
            </div>
            <div class="stat-info">
                <span class="value">156</span>
                <span class="label">Today's Bookings</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon purple">
                <i class="bi bi-person-badge-fill"></i>
            </div>
            <div class="stat-info">
                <span class="value">24</span>
                <span class="label">Active Doctors</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="bi bi-exclamation-circle-fill"></i>
            </div>
            <div class="stat-info">
                <span class="value">08</span>
                <span class="label">Pending Reports</span>
            </div>
        </div>
    </div>

    <!-- MAIN DASHBOARD CONTENT -->
    <div class="dashboard-grid">
        <!-- RECENT ACTIVITY -->
        <div class="content-card">
            <div class="card-header">
                <h3>Recent Activity</h3>
                <a href="#" class="view-all">View History</a>
            </div>
            <div class="activity-list">
                <div class="activity-item">
                    <div class="activity-dot new"></div>
                    <div class="activity-details">
                        <span class="title">New doctor registered: Dr. Sarah Johnson</span>
                        <span class="time">10 minutes ago</span>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot"></div>
                    <div class="activity-details">
                        <span class="title">Appointment slot booked by Patient ID #4291</span>
                        <span class="time">25 minutes ago</span>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot"></div>
                    <div class="activity-details">
                        <span class="title">Slot Master updated for Cardiology Dept.</span>
                        <span class="time">1 hour ago</span>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot"></div>
                    <div class="activity-details">
                        <span class="title">Monthly revenue report generated</span>
                        <span class="time">3 hours ago</span>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-dot"></div>
                    <div class="activity-details">
                        <span class="title">System maintenance completed successfully</span>
                        <span class="time">Yesterday</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- QUICK ACTIONS -->
        <div class="content-card">
            <div class="card-header">
                <h3>Quick Actions</h3>
            </div>
            <div class="action-grid">
                <a href="/doctors" class="action-btn">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>Manage Doctors</span>
                </a>
                <a href="/slots" class="action-btn">
                    <i class="bi bi-calendar-plus-fill"></i>
                    <span>Manage Slots</span>
                </a>
                <a href="#" class="action-btn">
                    <i class="bi bi-file-earmark-medical-fill"></i>
                    <span>View Reports</span>
                </a>
                <a href="#" class="action-btn">
                    <i class="bi bi-gear-wide-connected"></i>
                    <span>Portal Settings</span>
                </a>
            </div>
        </div>
    </div>
</div>
