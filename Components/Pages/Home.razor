    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "Good Morning";
        if (hour < 17) return "Good Afternoon";
        return "Good Evening";
    }

    private string GetUserInitials()
    {
        var name = GetResolvedUserName();
        if (string.IsNullOrWhiteSpace(name) || name == "Authorized User")
        {
            var role = GetResolvedUserRole();
            return !string.IsNullOrWhiteSpace(role) && role.Length >= 2 ? role.Substring(0, 2).ToUpper() : "U";
        }
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();
    }

    // Shift Open Prompt Modal state for Home page
    private bool showHomeOpenShiftModal = false;
    private bool isOpeningShiftFromHome = false;
    private int homePromptBhCode = 1;
    private int homePromptCntCode = 1;
    private List<Booking.Models.BranchModel> homeBranchesList = new();
    private List<CounterMasterModel> homeCountersList = new();
    private List<CounterMasterModel> homePromptFilteredCounters = new();

    private bool IsSampleBranch(string? name, string? shortName, int code)
    {
        if (code <= 0) return true;
        if (string.IsNullOrWhiteSpace(name) && homeBranchesList != null && homeBranchesList.Any())
        {
            var match = homeBranchesList.FirstOrDefault(b => b.bh_code == code);
            if (match != null)
            {
                name = match.name;
                if (string.IsNullOrWhiteSpace(shortName)) shortName = match.short_name;
            }
        }
        if (string.IsNullOrWhiteSpace(name) && TenantState?.UserData?.Branches != null)
        {
            var match = TenantState.UserData.Branches.FirstOrDefault(b => (b.bh_code != 0 ? b.bh_code : (b.bhcode ?? 0)) == code);
            if (match != null)
            {
                name = match.name;
                if (string.IsNullOrWhiteSpace(shortName)) shortName = match.short_name;
            }
        }
        if (!string.IsNullOrWhiteSpace(name))
        {
            var n = name.Trim();
            if (n.Contains("sample", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(n, "dummy", StringComparison.OrdinalIgnoreCase)) return true;
        }
        if (!string.IsNullOrWhiteSpace(shortName))
        {
            var s = shortName.Trim();
            if (s.Contains("sample", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(s, "dummy", StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    private async Task<List<Booking.Models.BranchModel>> GetEffectiveOperatingBranchesAsync()
    {
        var branches = new List<Booking.Models.BranchModel>();

        if (homeBranchesList != null && homeBranchesList.Any())
        {
            branches = homeBranchesList.ToList();
        }
        else if (TenantState.UserData?.Branches != null && TenantState.UserData.Branches.Any())
        {
            foreach (var ub in TenantState.UserData.Branches)
            {
                branches.Add(new Booking.Models.BranchModel
                {
                    bh_code = ub.bh_code != 0 ? ub.bh_code : (ub.bhcode ?? 0),
                    name = ub.name,
                    short_name = ub.short_name
                });
            }
        }
        else
        {
            try
            {
                var uBranchesRes = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.BranchModel>>("UserBranches");
                if (uBranchesRes.Success && uBranchesRes.Value != null && uBranchesRes.Value.Any())
                {
                    foreach (var ub in uBranchesRes.Value)
                    {
                        branches.Add(new Booking.Models.BranchModel
                        {
                            bh_code = ub.bh_code != 0 ? ub.bh_code : (ub.bhcode ?? 0),
                            name = ub.name,
                            short_name = ub.short_name
                        });
                    }
                }
            }
            catch { }
        }

        if (!branches.Any())
        {
            await LoadBranchesAndCountersForHomeModalAsync();
            branches = homeBranchesList?.ToList() ?? new();
        }

        return branches.Where(b => !IsSampleBranch(b.name, b.short_name, b.bh_code)).ToList();
    }

    private IEnumerable<Booking.Models.BranchModel> GetHomeModalOrderedBranches()
    {
        if (homeBranchesList == null) return Enumerable.Empty<Booking.Models.BranchModel>();
        return homeBranchesList
            .Where(b => !IsSampleBranch(b.name, b.short_name, b.bh_code))
            .OrderByDescending(b => b.name != null && b.name.Contains("main", StringComparison.OrdinalIgnoreCase))
            .ThenBy(b => b.bh_code);
    }

    private IEnumerable<CounterMasterModel> GetHomeModalOrderedCounters()
    {
        if (homePromptFilteredCounters == null) return Enumerable.Empty<CounterMasterModel>();
        return homePromptFilteredCounters
            .Where(c => c.name == null || !c.name.Contains("sample", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(c => c.name != null && c.name.Contains("main", StringComparison.OrdinalIgnoreCase))
            .ThenBy(c => c.cntcode);
    }

    private void OnHomePromptBranchChanged()
    {
        UpdateHomePromptFilteredCounters();
    }

    private void UpdateHomePromptFilteredCounters()
    {
        if (homeCountersList != null && homeCountersList.Any())
        {
            homePromptFilteredCounters = homeCountersList
                .Where(c => c.bhcode == homePromptBhCode || c.bhcode == 0 || c.bhcode == null || homePromptBhCode == 0)
                .ToList();
            if (!homePromptFilteredCounters.Any())
            {
                homePromptFilteredCounters = homeCountersList.ToList();
            }
        }
        else
        {
            homePromptFilteredCounters = new List<CounterMasterModel>
            {
                new() { cntcode = 1, bhcode = homePromptBhCode, name = "Main Counter" }
            };
        }

        var sorted = GetHomeModalOrderedCounters().ToList();
        if (sorted.Any())
        {
            if (!sorted.Any(c => (int)c.cntcode == homePromptCntCode))
            {
                homePromptCntCode = (int)sorted.First().cntcode;
            }
        }
        else
        {
            homePromptCntCode = 1;
        }
        StateHasChanged();
    }

    private async Task CheckActiveShiftAsync()
    {
        try
        {
            var nonSampleBranches = await GetEffectiveOperatingBranchesAsync();

            // REQUIREMENT 1: When only one branch is there other than sample branch,
            // existing logic is working correctly, don't change anything in this.
            if (nonSampleBranches.Count <= 1)
            {
                var openCounters = await HmsBillingService.GetOpenCountersAsync(returnAllUnclosed: true, tenantCode: TenantState?.TenantCode);
                var activeShifts = openCounters?.Where(s => s.todate == null && s.cntcode.HasValue && s.cntcode.Value > 0).ToList() ?? new List<CounterTimingDto>();

                // If any shift is open for today, no popup on home page
                if (activeShifts.Any())
                {
                    return;
                }

                // No active shifts open for today: show popup modal on home page!
                await LoadBranchesAndCountersForHomeModalAsync();
                showHomeOpenShiftModal = true;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // REQUIREMENT 2: When more than one branch (other than sample branch) are there for a tenant login:
            // Need this popup ONLY after selecting the branch, NOT before that.
            bool isBranchConfirmed = false;
            try
            {
                var confRes = await _sessionStorage.GetAsync<bool>("session_branch_confirmed");
                isBranchConfirmed = confRes.Success && confRes.Value;
            }
            catch { }

            if (!isBranchConfirmed)
            {
                try
                {
                    var localSessionJson = await JSRuntime.InvokeAsync<string>("medicoSessionHelper.getSession");
                    if (!string.IsNullOrWhiteSpace(localSessionJson))
                    {
                        var jObj = Newtonsoft.Json.Linq.JObject.Parse(localSessionJson);
                        isBranchConfirmed = jObj["session_branch_confirmed"]?.ToObject<bool>() == true;
                    }
                }
                catch { }
            }

            int? selectedBhCode = (isBranchConfirmed && TenantState.BranchCode.HasValue && TenantState.BranchCode.Value > 0)
                ? TenantState.BranchCode.Value
                : (isBranchConfirmed && branchCode.HasValue && branchCode.Value > 0 ? branchCode.Value : null);

            // If the branch has NOT been confirmed/selected yet, do NOT show popup before that!
            if (!isBranchConfirmed || !selectedBhCode.HasValue || selectedBhCode.Value <= 0 || IsSampleBranch(null, null, selectedBhCode.Value))
            {
                return;
            }

            // For the selected branch: if any of the counter shift is open then no issue (no popup).
            // When no counter shift is open after selecting the branch, show the popup to open the counter shift.
            var allCounters = await HmsBillingService.GetOpenCountersAsync(returnAllUnclosed: true, tenantCode: TenantState?.TenantCode);
            var activeBranchShifts = allCounters?.Where(s => s.todate == null && s.cntcode.HasValue && s.cntcode.Value > 0).ToList() ?? new List<CounterTimingDto>();

            await LoadBranchesAndCountersForHomeModalAsync(selectedBhCode.Value);

            bool isShiftOpenForBranch = activeBranchShifts.Any(s =>
                (s.bhcode.HasValue && s.bhcode.Value == selectedBhCode.Value) ||
                (!s.bhcode.HasValue && selectedBhCode.Value == 1) ||
                (homeCountersList.Any(c => c.cntcode == s.cntcode && c.bhcode == selectedBhCode.Value))
            );

            if (isShiftOpenForBranch)
            {
                // Any counter shift is open for the selected branch -> no issue
                showHomeOpenShiftModal = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // No counter shift is open for the selected branch -> show popup!
            homePromptBhCode = selectedBhCode.Value;
            UpdateHomePromptFilteredCounters();
            var sorted = GetHomeModalOrderedCounters().ToList();
            if (sorted.Any())
            {
                homePromptCntCode = (int)sorted.First().cntcode;
            }

            showHomeOpenShiftModal = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Home] Error checking active shifts: {ex.Message}");
        }
    }

    private async Task LoadBranchesAndCountersForHomeModalAsync(int? preferredBhCode = null)
    {
        try
        {
            homeBranchesList.Clear();
            if (TenantState.UserData?.Branches != null && TenantState.UserData.Branches.Any())
            {
                foreach (var ub in TenantState.UserData.Branches)
                {
                    homeBranchesList.Add(new Booking.Models.BranchModel
                    {
                        bh_code = ub.bh_code != 0 ? ub.bh_code : (ub.bhcode ?? 0),
                        name = ub.name,
                        short_name = ub.short_name
                    });
                }
            }

            if (!homeBranchesList.Any())
            {
                try
                {
                    var uBranchesRes = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.BranchModel>>("UserBranches");
                    if (uBranchesRes.Success && uBranchesRes.Value != null && uBranchesRes.Value.Any())
                    {
                        foreach (var ub in uBranchesRes.Value)
                        {
                            homeBranchesList.Add(new Booking.Models.BranchModel
                            {
                                bh_code = ub.bh_code != 0 ? ub.bh_code : (ub.bhcode ?? 0),
                                name = ub.name,
                                short_name = ub.short_name
                            });
                        }
                    }
                }
                catch { }
            }

            if (!homeBranchesList.Any())
            {
                try
                {
                    var bClient = HttpClientFactory.CreateClient("LabCareUrl");
                    var effTenant = !string.IsNullOrWhiteSpace(TenantState.TenantCode) ? TenantState.TenantCode : tenantCode;
                    if (!string.IsNullOrEmpty(effTenant))
                    {
                        bClient.DefaultRequestHeaders.Remove("tenant_code");
                        bClient.DefaultRequestHeaders.Add("tenant_code", effTenant);
                    }
                    if (!string.IsNullOrWhiteSpace(TenantState.AuthToken))
                    {
                        bClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
                    }
                    var bRes = await bClient.GetAsync("api/Branch/get");
                    if (bRes.IsSuccessStatusCode)
                    {
                        var bJson = await bRes.Content.ReadAsStringAsync();
                        var dbBranches = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(bJson);
                        if (dbBranches != null && dbBranches.Any())
                        {
                            homeBranchesList = dbBranches.Where(b => !b.deleted).ToList();
                        }
                    }
                }
                catch { }
            }

            if (!homeBranchesList.Any())
            {
                homeBranchesList.Add(new Booking.Models.BranchModel { bh_code = 1, name = "Main Branch" });
            }

            // Load counters
            try
            {
                var counters = await CounterMasterService.GetCountersAsync();
                homeCountersList = counters?.Where(c => !c.deleted).ToList() ?? new();
            }
            catch
            {
                homeCountersList = new();
            }

            if (!homeCountersList.Any())
            {
                homeCountersList.Add(new CounterMasterModel { cntcode = 1, bhcode = 1, name = "Main Counter" });
            }

            // Determine default branch and counter to choose
            int? assignedBhCode = preferredBhCode;
            int? assignedCntCode = null;

            if (!assignedBhCode.HasValue || assignedBhCode.Value <= 0)
            {
                try
                {
                    var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userDetailsResult.Success && userDetailsResult.Value != null)
                    {
                        if (userDetailsResult.Value.BranchCode.HasValue && userDetailsResult.Value.BranchCode.Value > 0)
                            assignedBhCode = userDetailsResult.Value.BranchCode.Value;
                        if (userDetailsResult.Value.CounterCode.HasValue && userDetailsResult.Value.CounterCode.Value > 0)
                            assignedCntCode = userDetailsResult.Value.CounterCode.Value;
                    }
                }
                catch { }

                if ((!assignedBhCode.HasValue || assignedBhCode.Value <= 0) && TenantState?.BranchCode.HasValue == true && TenantState.BranchCode.Value > 0)
                {
                    assignedBhCode = TenantState.BranchCode.Value;
                }
                if ((!assignedCntCode.HasValue || assignedCntCode.Value <= 0) && TenantState?.CounterCode.HasValue == true && TenantState.CounterCode.Value > 0)
                {
                    assignedCntCode = TenantState.CounterCode.Value;
                }

                int uCode = TenantState?.UserCode ?? userCode;
                if (uCode > 0 && UserService != null && (!assignedBhCode.HasValue || !assignedCntCode.HasValue))
                {
                    try
                    {
                        var uMaster = await UserService.GetUserMasterAsync(uCode, TenantState?.AuthToken, TenantState?.TenantCode ?? tenantCode);
                        if (uMaster != null)
                        {
                            if (!assignedBhCode.HasValue && uMaster.bh_code.HasValue && uMaster.bh_code.Value > 0)
                                assignedBhCode = uMaster.bh_code.Value;
                            if (!assignedCntCode.HasValue && uMaster.cnt_code.HasValue && uMaster.cnt_code.Value > 0)
                                assignedCntCode = (int)uMaster.cnt_code.Value;
                        }
                    }
                    catch { }
                }
            }

            // Check if assigned branch is non-sample
            bool assignedIsSample = false;
            if (assignedBhCode.HasValue && assignedBhCode.Value > 0)
            {
                var assignedBranchObj = homeBranchesList.FirstOrDefault(b => b.bh_code == assignedBhCode.Value);
                if (assignedBranchObj != null && IsSampleBranch(assignedBranchObj.name, assignedBranchObj.short_name, assignedBranchObj.bh_code))
                {
                    assignedIsSample = true;
                }
            }

            int resolvedBhCode = 1;
            if (assignedBhCode.HasValue && assignedBhCode.Value > 0 && !assignedIsSample && homeBranchesList.Any(b => b.bh_code == assignedBhCode.Value))
            {
                resolvedBhCode = assignedBhCode.Value;
            }
            else
            {
                var nonSampleBranch = homeBranchesList.FirstOrDefault(b => !IsSampleBranch(b.name, b.short_name, b.bh_code) && b.name != null && b.name.Contains("main", StringComparison.OrdinalIgnoreCase))
                                     ?? homeBranchesList.FirstOrDefault(b => !IsSampleBranch(b.name, b.short_name, b.bh_code) && b.bh_code == 1)
                                     ?? homeBranchesList.FirstOrDefault(b => !IsSampleBranch(b.name, b.short_name, b.bh_code))
                                     ?? homeBranchesList.First();
                resolvedBhCode = nonSampleBranch.bh_code;
            }

            homePromptBhCode = resolvedBhCode;
            UpdateHomePromptFilteredCounters();

            // Prioritize counter
            int resolvedCntCode = 1;
            if (assignedCntCode.HasValue && assignedCntCode.Value > 0 && !assignedIsSample && homePromptFilteredCounters.Any(c => (int)c.cntcode == assignedCntCode.Value))
            {
                resolvedCntCode = assignedCntCode.Value;
            }
            else
            {
                var mainCounter = homePromptFilteredCounters.FirstOrDefault(c => c.name != null && c.name.Contains("main", StringComparison.OrdinalIgnoreCase) && !c.name.Contains("sample", StringComparison.OrdinalIgnoreCase))
                                  ?? homePromptFilteredCounters.FirstOrDefault(c => c.cntcode == 1 && (c.name == null || !c.name.Contains("sample", StringComparison.OrdinalIgnoreCase)))
                                  ?? homePromptFilteredCounters.FirstOrDefault(c => c.name == null || !c.name.Contains("sample", StringComparison.OrdinalIgnoreCase))
                                  ?? homePromptFilteredCounters.FirstOrDefault();
                if (mainCounter != null)
                {
                    resolvedCntCode = (int)mainCounter.cntcode;
                }
            }

            homePromptCntCode = resolvedCntCode;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Home] Error loading branches and counters: {ex.Message}");
        }
    }

    private void CancelHomeOpenShiftModal()
    {
        showHomeOpenShiftModal = false;
    }

    private async Task ConfirmOpenShiftFromHomeAsync()
    {
        if (homePromptBhCode <= 0 || homePromptCntCode <= 0)
        {
            homePromptBhCode = 1;
            homePromptCntCode = 1;
        }

        isOpeningShiftFromHome = true;
        StateHasChanged();

        try
        {
            var openReq = new Booking.Models.OpenShiftRequest
            {
                bhcode = homePromptBhCode,
                cntcode = homePromptCntCode,
                counterdate = DateTime.Today
            };

            var rawResponse = await HmsBillingService.OpenShiftAsync(openReq);

            bool isSuccess = false;
            string displayMsg = "Shift opened successfully.";

            if (!string.IsNullOrEmpty(rawResponse) && !rawResponse.StartsWith("Error|"))
            {
                if (rawResponse.Trim().StartsWith("{") && rawResponse.Trim().EndsWith("}"))
                {
                    try
                    {
                        var jsonObj = Newtonsoft.Json.Linq.JObject.Parse(rawResponse);
                        if (jsonObj["message"] != null)
                        {
                            var msg = jsonObj["message"].ToString();
                            if (msg.Contains("success", StringComparison.OrdinalIgnoreCase) ||
                                msg.Contains("safely shut down", StringComparison.OrdinalIgnoreCase) ||
                                msg.Contains("ok", StringComparison.OrdinalIgnoreCase))
                            {
                                isSuccess = true;
                                displayMsg = msg;
                            }
                            else
                            {
                                isSuccess = false;
                                displayMsg = msg;
                            }
                        }
                        else if (jsonObj["cnttid"] != null || jsonObj["shiftsno"] != null)
                        {
                            isSuccess = true;
                        }
                    }
                    catch
                    {
                        isSuccess = true;
                    }
                }
                else
                {
                    isSuccess = true;
                }
            }
            else if (!string.IsNullOrEmpty(rawResponse) && rawResponse.StartsWith("Error|"))
            {
                isSuccess = false;
                displayMsg = rawResponse.Replace("Error|", "");
            }

            if (isSuccess)
            {
                var cntName = homePromptFilteredCounters.FirstOrDefault(c => (int)c.cntcode == homePromptCntCode)?.name ?? $"Counter {homePromptCntCode}";
                ToastService.ShowSuccess($"Shift for counter '{cntName}' opened successfully!");

                try
                {
                    await _sessionStorage.SetAsync("bhcode", homePromptBhCode.ToString());
                    await _sessionStorage.SetAsync("cntcode", homePromptCntCode.ToString());
                    await _sessionStorage.SetAsync("session_counter_manually_switched", true);
                    TenantState.SetSession(
                        TenantState.TenantCode,
                        TenantState.AuthToken,
                        TenantState.TenantName,
                        TenantState.UserCode,
                        homePromptBhCode,
                        homePromptCntCode,
                        TenantState.UserData,
                        TenantState.UserRightsList?.ToList() ?? new List<SharedComponents.Rcl.Models.User_Rights>());
                }
                catch { }

                showHomeOpenShiftModal = false;
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError($"Failed to open shift: {displayMsg}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error opening shift: {ex.Message}");
        }
        finally
        {
            isOpeningShiftFromHome = false;
            StateHasChanged();
        }
    }

    private static bool IsAdminRole(string? role)
    {
        if (string.IsNullOrWhiteSpace(role)) return false;
        var r = role.Trim();
        return string.Equals(r, "Administrator", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Super Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "SuperAdmin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Power User", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "PowerUser", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Tenant", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Tenant Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "TenantAdmin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Client Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "ClientAdmin", StringComparison.OrdinalIgnoreCase) ||
               r.Contains("Admin", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsAdminRoleFromJwt(string? token)
    {
        if (string.IsNullOrEmpty(token)) return false;
        try
        {
            var segments = token.Split('.');
            if (segments.Length < 2) return false;
            var payload = segments[1];
            switch (payload.Length % 4)
            {
                case 2: payload += "=="; break;
                case 3: payload += "="; break;
            }
            var jsonBytes = Convert.FromBase64String(payload);
            var claims = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
            if (claims == null) return false;
            
            if (claims.TryGetValue("IsAdmin", out var isAdmVal) && 
                (string.Equals(isAdmVal?.ToString(), "true", StringComparison.OrdinalIgnoreCase) || 
                 string.Equals(isAdmVal?.ToString(), "True", StringComparison.OrdinalIgnoreCase)))
                return true;

            if (claims.TryGetValue("power_user", out var puVal) && 
                (string.Equals(puVal?.ToString(), "true", StringComparison.OrdinalIgnoreCase) || 
                 string.Equals(puVal?.ToString(), "True", StringComparison.OrdinalIgnoreCase)))
                return true;

            object? rVal = null;
            if (!claims.TryGetValue("role", out rVal) &&
                !claims.TryGetValue("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out rVal))
                return false;
            return IsAdminRole(rVal?.ToString());
        }
        catch { return false; }
    }

    private bool IsAdmin()
    {
        if (_isAdminSession) return true;

        var role = userRole;
        if (string.IsNullOrEmpty(role)) role = TenantState.UserData?.Role;
        if (!string.IsNullOrEmpty(role) && IsAdminRole(role))
        {
            _isAdminSession = true;
            return true;
        }

        var uName = userName;
        if (string.IsNullOrEmpty(uName)) uName = TenantState.UserData?.UserName;
        if (string.Equals(uName, "admin", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(uName, "administrator", StringComparison.OrdinalIgnoreCase))
        {
            _isAdminSession = true;
            return true;
        }

        var token = TenantState.AuthToken ?? TenantState.UserData?.AuthToken;
        if (IsAdminRoleFromJwt(token))
        {
            _isAdminSession = true;
            return true;
        }

        return false;
    }

    private bool HasMainModule(string module) => IsAdmin() || RoleService.HasMainModule(module);

    public void Dispose()
    {
        TenantState.OnSessionChanged -= HandleSessionChanged;
        RoleService.OnPermissionsChanged -= HandlePermissionsChanged;
    }
