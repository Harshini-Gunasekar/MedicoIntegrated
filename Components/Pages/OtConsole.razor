    .preview-patient-banner {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 0.75rem 1rem;
    }

    .preview-pat-name {
        font-size: 13.5px;
        font-weight: 800;
        color: #0f172a;
    }

    .preview-pat-sub {
        font-size: 11.5px;
        color: #64748b;
        font-weight: 600;
        display: flex;
        gap: 0.4rem;
        margin-top: 0.15rem;
    }

    .preview-progress-wrap {
        padding: 0.65rem 1rem;
        background: #ffffff;
        border-bottom: 1px solid #f1f5f9;
    }

    .preview-progress-label {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        font-weight: 750;
        color: #475569;
        margin-bottom: 0.3rem;
    }

    .preview-progress-bar-bg {
        width: 100%;
        height: 6px;
        background: #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
    }

    .preview-progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #4f46e5, #10b981);
        border-radius: 10px;
        transition: width 0.3s ease;
    }

    .preview-scroll-content {
        padding: 0.75rem 1rem;
        max-height: calc(100vh - 360px);
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .preview-block {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 0.6rem 0.8rem;
    }

    .preview-block-title {
        font-size: 11px;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 0.35rem;
        padding-bottom: 0.25rem;
        border-bottom: 1px dashed #e2e8f0;
    }

    .preview-team-pills {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-top: 0.25rem;
    }

    .preview-team-pill {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 0.2rem 0.5rem;
        font-size: 11.5px;
        display: flex;
        justify-content: space-between;
    }

    .pill-role { font-weight: 750; color: #4f46e5; }
    .pill-name { font-weight: 600; color: #334155; }

    /* ═══════════════════════════════════════════════════════════════
       8. STICKY BOTTOM ACTION TOOLBAR
       ═══════════════════════════════════════════════════════════════ */
    .ot-bottom-action-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-top: 1.5px solid #cbd5e1;
        padding: 0.65rem 1.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 1000;
        box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.05);
    }

    .bar-left-group {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .bar-right-group {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .btn-nav-step {
        background: #ffffff;
        border: 1.5px solid #c7d2fe;
        color: #4338ca;
        border-radius: 8px;
        padding: 0.45rem 0.9rem;
        font-size: 12.5px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
