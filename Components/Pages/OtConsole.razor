                                                                    <span style="font-size: 0.72rem; color: #64748b; font-weight: 600; flex-shrink: 0;">min</span>
                                                                </div>
                                                            </td>
                                                            <td style="text-align: center; white-space: nowrap;">
                                                                <span class="badge" style="background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-weight: 700; padding: 4px 12px; border-radius: 9999px; font-size: 0.72rem; letter-spacing: 0.3px; display: inline-block;">SCHEDULED</span>
                                                            </td>
