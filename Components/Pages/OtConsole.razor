@page "/ot-console"
@page "/ot-console/{RequestId:guid}"
@page "/ot-dashboard"
@page "/ot-surgery"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using medico_backend.Model
@using Medico_Backend.Model
@using Booking.Services
@using Booking.Models
@using Booking.Helpers
@using Newtonsoft.Json
@inject OtService OtService
@inject DoctorService DoctorService
@inject NurseMasterService NurseService
@inject LabSettingService LabSettingService
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.CaseSheetService CaseSheetService
@inject Booking.Services.IpRegistrationService IpService
@inject Booking.Services.WardMasterService WardService
@inject Booking.Services.BedMasterService BedService
@inject Booking.Services.RoomTypeMasterService RoomTypeService
@inject Booking.Services.UomMasterService UomMasterService
@inject Booking.Services.HmsDueCollectionService DueCollectionService
@inject Booking.Services.CounterMasterService CounterService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject IJSRuntime JSRuntime

<PageTitle>OT Console — Operation Theater Clinical Console</PageTitle>

<!-- Background blobs & animation (Doctor Patient List Style) -->
<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
</div>

<div class="dashboard-container" @onclick="HandlePageClick">
    <!-- =========================================================================    <!-- 1. DASHBOARD HEADER (DOCTOR PATIENT LIST STYLE)                           -->
    <!-- ========================================================================= -->
    <div class="dashboard-header" style="margin-top: 10px; margin-bottom: 8px;">
        <div class="dashboard-title">
            @if (mainTab == "CASES")
            {
                <h1 style="font-size: 1.15rem; font-weight: 800; margin: 0;">Operation Theater Clinical Console</h1>
            }
            else
            {
                <h1 style="font-size: 1.15rem; font-weight: 800; margin: 0;">Inpatient Admissions Dashboard</h1>
            }
        </div>

        <div style="display: flex; gap: 8px; align-items: center; position: relative;">
            <!-- Add Surgery Request Button -->
            <button type="button" class="btn-header-primary" @onclick="OpenAddRequestModal" title="Create New Surgery Request">
                <i class="bi bi-plus-lg"></i>
                <span>Add Request</span>
            </button>

            <!-- Refresh Queue Button -->
            <button type="button" class="btn-header-action" @onclick="RefreshQueueAsync" disabled="@isLoadingRequests">
                @if (isLoadingRequests)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise"></i>
                }
                <span>Refresh Queue</span>
            </button>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 2. NAVIGATION TABS (DOCTOR PATIENT LIST STYLE)                            -->
    <!-- ========================================================================= -->
    <div class="medico-tabs">
        <button type="button" class="tab-btn @(mainTab == "CASES" ? "active" : "")" @onclick='() => SetMainTab("CASES")'>
            <i class="bi bi-person-lines-fill"></i> Surgery Cases
        </button>
        <button type="button" class="tab-btn @(mainTab == "IP_REFERRALS" ? "active" : "")" @onclick='() => SetMainTab("IP_REFERRALS")'>
            <i class="bi bi-hospital"></i> Inpatient (IP) Referrals
        </button>
    </div>

    <!-- ========================================================================= -->
    <!-- 3. TOOLBAR FILTERS CARD (DOCTOR PATIENT LIST STYLE)                       -->
    <!-- ========================================================================= -->
    <div class="filter-card">
        <div class="filter-flex">
            <!-- Filter Date -->
            <div class="filter-group filter-date-col">
                <label class="filter-label">FILTER DATE</label>
                <input type="date" class="form-control filter-input" @bind="filterDate" @bind:after="OnFilterChanged" />
            </div>

            <!-- Doctor Specialist -->
            <div class="filter-group filter-doc-col">
                <label class="filter-label">SURGEON / DOCTOR</label>
                <select class="form-select filter-select" @bind="filterDoctorDcode" @bind:after="OnFilterChanged">
                    <option value="0">All Surgeons</option>
                    @foreach (var doc in doctorsList)
                    {
                        <option value="@doc.dcode">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</option>
                    }
                </select>
            </div>

            @if (mainTab == "CASES")
            {
                <!-- Status Filter -->
                <div class="filter-group filter-status-col">
                    <label class="filter-label">STATUS</label>
                    <select class="form-select filter-select" @bind="filterStatus" @bind:after="OnFilterChanged">
                        <option value="ALL">All Statuses</option>
                        <option value="REQUESTED">Requested</option>
                        <option value="SCHEDULED">Scheduled</option>
                        <option value="IN_PROGRESS">In Progress</option>
                        <option value="COMPLETED">Completed</option>
                        <option value="CANCELLED">Cancelled</option>
                    </select>
                </div>

                <!-- Priority Filter -->
                <div class="filter-group filter-priority-col">
                    <label class="filter-label">PRIORITY</label>
                    <select class="form-select filter-select" @bind="filterPriority" @bind:after="OnFilterChanged">
                        <option value="ALL">All Priorities</option>
                        <option value="ELECTIVE">Elective</option>
                        <option value="URGENT">Urgent</option>
                        <option value="EMERGENCY">Emergency</option>
                    </select>
                </div>

                <!-- Theater Suite Filter -->
                <div class="filter-group filter-slot-col">
                    <label class="filter-label">THEATER SUITE</label>
                    <select class="form-select filter-select" @bind="filterOtSuite" @bind:after="OnFilterChanged">
                        <option value="@Guid.Empty">All Theaters</option>
                        @foreach (var ot in otTheaters)
                        {
                            <option value="@ot.ot_id">@ot.ot_name</option>
                        }
                    </select>
                </div>
            }

            <!-- Pagination Toggle -->
            <div class="filter-group filter-pagination-col">
                <label class="filter-label">PAGINATION</label>
                <select class="form-select filter-select" @bind="paginationOption" @bind:after="OnPaginationToggle">
                    <option value="YES">Yes</option>
                    <option value="NO">No</option>
                </select>
            </div>

            <!-- Search Patient / Doctor / Procedure -->
            <div class="filter-group filter-search-col">
                <label class="filter-label">SEARCH PATIENT / SURGEON / PROCEDURE</label>
                <div class="search-input-group">
                    <input type="text" class="form-control filter-input" placeholder="Type to search..." @bind="tableSearch" @bind:event="oninput" @bind:after="OnFilterChanged" />
                    @if (!string.IsNullOrEmpty(tableSearch))
                    {
                        <button type="button" class="btn-clear-search" @onclick="ClearTableSearch" title="Clear search">&times;</button>
                    }
                </div>
            </div>

            <!-- Reset Filters -->
            <div class="filter-action-group">
                <button type="button" class="btn-reset" @onclick="ResetFilters" title="Reset all filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 4. MAIN DATA TABLE CARD (DOCTOR PATIENT LIST STYLE)                       -->
    <!-- ========================================================================= -->
    <div class="table-card">
        <div class="table-responsive">
            @if (mainTab == "CASES")
            {
                var filtered = GetFilteredRequests();
                var pagedItems = enablePagination
                    ? filtered.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList()
                    : filtered;

                <table class="medico-table">
                    <thead>
                        <tr>
                            <th style="width: 150px;">CASE / ID</th>
                            <th style="width: 180px;">PATIENT NAME</th>
                            <th>PROCEDURE</th>
                            <th>ATTENDING SURGEON</th>
                            <th>THEATER &amp; SLOT</th>
                            <th style="width: 120px;">PRIORITY</th>
                            <th style="width: 140px;">STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoadingRequests)
                        {
                            <tr>
                                <td colspan="7" class="text-center p-48">
                                    <div class="spinner-border text-primary me-2" style="width: 1.5rem; height: 1.5rem;" role="status"></div>
                                    <span class="text-slate-500 font-semibold">Loading surgery cases...</span>
                                </td>
                            </tr>
                        }
                        else if (pagedItems.Any())
                        {
                            @foreach (var r in pagedItems)
                            {
                                var patName = GetPatientName(r.custid);
                                var doc = GetDoctor(r.dcode);
                                var docName = FormatDoctorDisplayName(r.dcode);
                                var sched = allSchedules.FirstOrDefault(s => s.request_id == r.request_id);
                                var ipNo = GetIpNumber(r.ip_id, r.custid);

                                <tr class="lc-table-row" @ondblclick="() => OpenCaseWorkspace(r)" style="cursor: pointer;" title="Double-click to open surgical clinical Case Sheet workspace">
                                    <!-- Case / Cust ID -->
                                    <td class="font-bold font-mono" style="color: #034f75;">
                                        <div>@r.custid.ToString("0")</div>
                                        @if (!string.IsNullOrWhiteSpace(ipNo))
                                        {
                                            <div class="font-semibold text-slate-700 font-mono" style="font-size: 0.78rem; margin-top: 2px;">@ipNo</div>
                                        }
                                    </td>

                                    <!-- Patient Name -->
                                    <td>
                                        <span class="patient-primary-name font-bold text-slate-800">@patName</span>
                                    </td>

                                    <!-- Procedure Name -->
                                    <td>
                                        <span class="proc-name-text text-slate-800 font-semibold">@r.procedure_name</span>
                                    </td>

                                    <!-- Attending Surgeon -->
                                    <td>
                                        <div class="doc-info-col">
                                            <div class="doc-name-text font-bold text-slate-800">@docName</div>
                                            @if (doc != null && !string.IsNullOrWhiteSpace(doc.qualification))
                                            {
                                                <div class="doc-qual-text text-slate-500" style="font-size: 0.72rem; margin-top: 2px;">@doc.qualification</div>
                                            }
                                        </div>
                                    </td>

                                    <!-- Theater & Slot -->
                                    <td>
                                        @if (sched != null)
                                        {
                                            <div class="slot-info-col">
                                                <span class="slot-theater-text font-bold text-slate-800">@GetTheaterName(sched.ot_id)</span>
                                                <span class="ms-3 slot-time-text text-slate-600">@sched.scheduled_date.ToString("dd-MMM-yyyy") @sched.scheduled_time.ToString("hh\\:mm tt")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 italic font-11">Not Scheduled</span>
                                        }
                                    </td>

                                    <!-- Priority -->
                                    <td>
                                        <span class="badge @GetPriorityBadgeClass(r.priority) font-11">
                                            @r.priority
                                        </span>
                                    </td>

                                    <!-- Status -->
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(r.status) font-11">
                                            @r.status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center p-48 text-slate-400 italic">No surgery cases found matching your criteria.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                var filteredIp = GetFilteredIpReferrals();
                var pagedIp = enablePagination
                    ? filteredIp.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList()
                    : filteredIp;

                <table class="medico-table">
                    <thead>
                        <tr>
                            <th style="width: 140px;">IP NUMBER</th>
                            <th style="width: 180px;">PATIENT NAME</th>
                            <th>REFERRING DOCTOR</th>
                            <th>WARD / BED</th>
                            <th>ADMIT DATE</th>
                            <th>CLINICAL INDICATION &amp; DIAGNOSIS</th>
                            <th style="width: 140px;">OT STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoadingIpReferrals)
                        {
                            <tr>
                                <td colspan="7" class="text-center p-48">
                                    <div class="spinner-border text-rose-500 me-2" style="width: 1.5rem; height: 1.5rem;" role="status"></div>
                                    <span class="text-slate-500 font-semibold">Loading IP referrals...</span>
                                </td>
                            </tr>
                        }
                        else if (pagedIp.Any())
                        {
                            @foreach (var ipRef in pagedIp)
                            {
                                var refDoc = GetDoctor(ipRef.dcode);
                                var refDocName = FormatDoctorDisplayName(ipRef.dcode, ipRef.doctor_name);

                                <tr class="lc-table-row" @ondblclick="() => HandleIpReferralAction(ipRef)" style="cursor: pointer;" title="Double-click to create or open surgery request">
                                    <!-- IP Number -->
                                    <td class="font-bold text-rose-800 font-mono">
                                        @ipRef.ip_no
                                    </td>

                                    <!-- Patient Name -->
                                    <td>
                                        <span class="patient-primary-name text-rose-950 font-bold">@ipRef.patient_name</span>
                                    </td>

                                    <!-- Referring Doctor -->
                                    <td>
                                        <div class="doc-info-col">
                                            <div class="doc-name-text font-bold text-slate-800">@refDocName</div>
                                            @if (refDoc != null && !string.IsNullOrWhiteSpace(refDoc.qualification))
                                            {
                                                <div class="doc-qual-text text-slate-500" style="font-size: 0.72rem; margin-top: 2px;">@refDoc.qualification</div>
                                            }
                                        </div>
                                    </td>

                                    <!-- Ward / Bed -->
                                    <td class="font-12 text-slate-700">
                                        @GetWardBedDisplay(ipRef.ward_name, ipRef.bed_no)
                                    </td>

                                    <!-- Admit Date -->
                                    <td class="font-12 text-slate-700">
                                        @ipRef.admitdate.ToString("dd-MMM-yyyy")
                                    </td>

                                    <!-- Indication & Diagnosis -->
                                    <td>
                                        <div class="indication-cell-col">
                                            <span class="font-bold text-slate-800 font-12">
                                                <i class="bi bi-clipboard-pulse text-rose-500 me-1"></i>
                                                @(string.IsNullOrWhiteSpace(ipRef.diagnosis) ? (ipRef.chief_complaint ?? "Referred to OT for surgery") : ipRef.diagnosis)
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(ipRef.advise))
                                            {
                                                <span class="text-slate-500 font-11 d-block mt-0.5" title="@ipRef.advise">
                                                    @ipRef.advise
                                                </span>
                                            }
                                        </div>
                                    </td>

                                    <!-- OT Status -->
                                    <td>
                                        @if (ipRef.has_surgery_request)
                                        {
                                            <span class="badge bg-emerald-100 text-emerald-800 border border-emerald-300 font-11">
                                                <i class="bi bi-check-circle-fill me-1"></i>OT: @(ipRef.surgery_status ?? "REQUESTED")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-rose-100 text-rose-800 border border-rose-300 font-11">
                                                Pending OT Request
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center p-48 text-slate-400 italic">No Inpatient Casesheet referrals found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }        
        </div>

        <!-- ========================================================================= -->
        <!-- 5. PAGINATION FOOTER (DOCTOR PATIENT LIST STYLE)                          -->
        <!-- ========================================================================= -->
        @{
            var currentTotal = mainTab == "CASES" ? GetFilteredRequests().Count : GetFilteredIpReferrals().Count;
        }
        @if (currentTotal > 0)
        {
            if (enablePagination)
            {
                var totalPages = Math.Max(1, (int)Math.Ceiling((double)currentTotal / pageSize));
                <div class="pagination-footer">
                    <div class="pagination-info">
                        Showing <span class="pagination-info-highlight">@(((currentPage - 1) * pageSize) + 1)</span> to <span class="pagination-info-highlight">@(Math.Min(currentPage * pageSize, currentTotal))</span> of <span class="pagination-info-highlight">@currentTotal</span> entries
                    </div>
                    @if (totalPages > 1)
                    {
                        <div class="pagination-btns">
                            <button type="button" class="page-btn" disabled="@(currentPage <= 1)" @onclick="() => currentPage--" title="Previous Page">&lsaquo;</button>

                            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                            {
                                var pageNum = p;
                                <button type="button" class="page-btn @(currentPage == pageNum ? "active" : "")" @onclick="() => currentPage = pageNum">@pageNum</button>
                            }

                            <button type="button" class="page-btn" disabled="@(currentPage >= totalPages)" @onclick="() => currentPage++" title="Next Page">&rsaquo;</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="pagination-footer" style="justify-content: flex-end;">
                    <div class="pagination-info">
                        Showing all <span class="pagination-info-highlight">@currentTotal</span> entries
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- 6. LARGE CLINICAL WORKSPACE POPUP MODAL (CASESHEET UI ARCHITECTURE)       -->
<!-- ========================================================================= -->
@if (showWorkspaceModal && selectedRequest != null)
{
    var curPatName = GetPatientName(selectedRequest.custid);
    var curDocName = GetDoctorName(selectedRequest.dcode);
    var matchedIp = ipOtReferrals.FirstOrDefault(r => r.ip_id == selectedRequest.ip_id || r.custid == selectedRequest.custid);

    <div class="casesheet-backdrop" @onclick="CloseCaseWorkspace">
        <div class="casesheet-modal" @onclick:stopPropagation>
            <!-- CaseSheet Modal Header -->
            <div class="casesheet-header">
                <div class="header-patient-info">
                    <div class="patient-avatar">
                        @GetInitials(curPatName)
                    </div>
                    <div class="patient-meta">
                        <div class="patient-title">
                            <span>@(string.IsNullOrWhiteSpace(curPatName) ? "Patient" : curPatName)</span>
                            <span class="patient-cust-badge">CUST-@selectedRequest.custid.ToString("0")</span>
                            <span class="status-badge draft">@selectedRequest.status</span>
                            <span class="badge @GetPriorityBadgeClass(selectedRequest.priority) font-11">@selectedRequest.priority</span>
                            @if (matchedIp != null || selectedRequest.ip_id.HasValue)
                            {
                                <span class="badge bg-rose-100 text-rose-700 border border-rose-200 font-11 font-bold ms-1" style="border-radius: 9999px; padding: 3px 10px;">
                                    OT Referred
                                </span>
                            }
                        </div>
                        <div class="patient-sub">
                            <span class="patient-sub-item"><strong>Procedure:</strong> @selectedRequest.procedure_name</span>
                            <span class="patient-sub-divider">|</span>
                            <span class="patient-sub-item"><strong>Attending Surgeon:</strong> @curDocName</span>
                            <span class="patient-sub-divider">|</span>
                            <span class="patient-sub-item"><strong>Theater Slot:</strong> @(activeSchedule != null ? $"{GetTheaterName(activeSchedule.ot_id)} • {activeSchedule.scheduled_date:dd-MMM-yyyy} ({activeSchedule.scheduled_time:hh\\:mm tt})" : "Not Scheduled")</span>
                        </div>
                    </div>
                </div>

                <div class="header-actions">
                    <button type="button" class="btn btn-sm btn-light font-bold" @onclick="OpenStatusModal" style="border-radius: 8px; font-size: 0.78rem; display: flex; align-items: center; gap: 4px; padding: 0.4rem 0.75rem;">
                        <i class="bi bi-arrow-repeat text-primary"></i>
                        <span>Status: @selectedRequest.status</span>
                    </button>
                    <button type="button" class="btn-close-modal" @onclick="CloseCaseWorkspace" title="Close Workspace">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- CaseSheet Tabs Strip -->
            <div class="casesheet-tabs-container">
                <button type="button" class="casesheet-tab-btn @(activeTab == "OT_REQUEST" ? "active" : "")" @onclick='() => SetTab("OT_REQUEST")'>
                    <i class="bi bi-file-earmark-medical tab-icon"></i>
                    <span>Clinical Request</span>
                    <span class="tab-check-tick" title="Surgery Request Details"><i class="bi bi-check-circle-fill"></i></span>
                </button>

                <button type="button" class="casesheet-tab-btn @(activeTab == "TEAM_MEMBERS" ? "active" : "")" @onclick='() => SetTab("TEAM_MEMBERS")'>
                    <i class="bi bi-people tab-icon"></i>
                    <span>Team Members</span>
                    @if (activeTeamMembers.Any())
                    {
                        <span class="tab-check-tick" title="@activeTeamMembers.Count Allocated Members"><i class="bi bi-check-circle-fill"></i></span>
                    }
                </button>

                <button type="button" class="casesheet-tab-btn @(activeTab == "ANAESTHESIA" ? "active" : "")" @onclick='() => SetTab("ANAESTHESIA")'>
                    <i class="bi bi-lungs tab-icon"></i>
                    <span>Anaesthesia</span>
                    @if (activeAnesthesia != null)
                    {
                        <span class="tab-check-tick" title="Anesthesia Record Logged"><i class="bi bi-check-circle-fill"></i></span>
                    }
                </button>

                <button type="button" class="casesheet-tab-btn @(activeTab == "SURGERY_INTRAOP" ? "active" : "")" @onclick='() => SetTab("SURGERY_INTRAOP")'>
                    <i class="bi bi-heart-pulse tab-icon"></i>
                    <span>Surgery (Intra OP)</span>
                    @if (activeIntraOp != null)
                    {
                        <span class="tab-check-tick" title="Intra-OP Record Saved"><i class="bi bi-check-circle-fill"></i></span>
                    }
                </button>

                <button type="button" class="casesheet-tab-btn @(activeTab == "STERILIZATION" ? "active" : "")" @onclick='() => SetTab("STERILIZATION")'>
                    <i class="bi bi-shield-check tab-icon"></i>
                    <span>Sterilisation</span>
                    @if (activeSterilizations.Any())
                    {
                        <span class="tab-check-tick" title="@activeSterilizations.Count Sterilization Records"><i class="bi bi-check-circle-fill"></i></span>
                    }
                </button>

                <button type="button" class="casesheet-tab-btn @(activeTab == "STAFF_NOTES" ? "active" : "")" @onclick='() => SetTab("STAFF_NOTES")'>
                    <i class="bi bi-journal-medical tab-icon"></i>
                    <span>Staff Notes</span>
                    @if (activeStaffNotes.Any())
                    {
                        <span class="tab-check-tick" title="@activeStaffNotes.Count Staff Notes"><i class="bi bi-check-circle-fill"></i></span>
                    }
                </button>

                <button type="button" class="casesheet-tab-btn @(activeTab == "PATIENT_ADVANCE" ? "active" : "")" @onclick='() => SetTab("PATIENT_ADVANCE")'>
                    <i class="bi bi-wallet2 tab-icon"></i>
                    <span>Patient Advance</span>
                    @if (advanceSummary != null && GetAdvanceAvailableBalance() > 0)
                    {
                        <span class="tab-check-tick" title="Advance Available: ₹@GetAdvanceAvailableBalance().ToString("N2")"><i class="bi bi-check-circle-fill"></i></span>
                    }
                </button>
            </div>

            <!-- CaseSheet Modal Body (Full Width Content - No Side Preview Column) -->
            <div class="casesheet-body">
                <div class="workspace-full-width">
                    @if (isLoadingEpisode)
                    {
                        <div class="loading-state-box p-5 text-center">
                            <div class="spinner-border text-primary" style="width: 2.75rem; height: 2.75rem;" role="status"></div>
                            <div class="text-slate-700 font-bold mt-3" style="font-size: 13px;">Loading surgical episode records...</div>
                        </div>
                    }
                    else
                    {
                        @* ═══════════════════════════════════════════════════════════════════ *@
                        @* TAB 1: OT REQUEST & EMBEDDED SCHEDULE                              *@
                        @* ═══════════════════════════════════════════════════════════════════ *@
                        @if (activeTab == "OT_REQUEST")
                        {
                            var matchedIpForReq = ipOtReferrals.FirstOrDefault(r => r.ip_id == selectedRequest.ip_id || r.custid == selectedRequest.custid);
                            var patName = GetPatientName(selectedRequest.custid);
                            var patAge = GetPatientAge(selectedRequest.custid);
                            var patMobile = GetPatientMobile(selectedRequest.custid);
                            var docObj = doctorsList.FirstOrDefault(d => d.dcode == selectedRequest.dcode);
                            var docName = GetDoctorName(selectedRequest.dcode);

                            <div class="tab-section-flow">
                                <!-- Enhanced Section Header -->
                                <div class="clinical-section-header mb-3">
                                    <div class="clinical-section-title">
                                        <div class="section-icon-badge">
                                            <i class="bi bi-file-earmark-medical-fill"></i>
                                        </div>
