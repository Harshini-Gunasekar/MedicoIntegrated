    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        var list = FilteredRequests.ToList();
        if (e.Key == "ArrowDown")
        {
            if (list.Count > 0)
                highlightedCaseIndex = (highlightedCaseIndex + 1) % list.Count;
        }
        else if (e.Key == "ArrowUp")
        {
            if (list.Count > 0)
                highlightedCaseIndex = (highlightedCaseIndex - 1 + list.Count) % list.Count;
        }
        else if (e.Key == "Enter")
        {
            if (list.Count > 0 && highlightedCaseIndex >= 0 && highlightedCaseIndex < list.Count)
            {
                _ = SelectCaseFromDropdown(list[highlightedCaseIndex]);
            }
        }
        else if (e.Key == "Escape")
        {
            isCaseDropdownOpen = false;
        }
    }

    private IEnumerable<OtSurgeryRequestListModel> FilteredRequests
    {
        get
        {
            var baseList = allRequests.AsEnumerable();
            if (caseModalTab == "ACTIVE")
            {
                baseList = baseList.Where(r => r.status != "COMPLETED" && r.status != "CANCELLED");
            }

            if (string.IsNullOrWhiteSpace(searchQuery))
                return baseList;

            var q = searchQuery.Trim().ToLowerInvariant();
            return baseList.Where(r =>
                (r.procedure_name?.ToLowerInvariant().Contains(q) ?? false) ||
                (r.patient_name?.ToLowerInvariant().Contains(q) ?? false) ||
                r.custid.ToString().Contains(q) ||
                (GetDoctorName(r.dcode).ToLowerInvariant().Contains(q)) ||
                (r.status?.ToLowerInvariant().Contains(q) ?? false));
        }
    }

    private IEnumerable<IpOtReferralModel> FilteredIpReferrals
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery))
                return ipOtReferrals;

            var q = searchQuery.Trim().ToLowerInvariant();
            return ipOtReferrals.Where(r =>
                (r.patient_name?.ToLowerInvariant().Contains(q) ?? false) ||
                (r.ip_no?.ToLowerInvariant().Contains(q) ?? false) ||
                r.custid.ToString().Contains(q) ||
                (r.doctor_name?.ToLowerInvariant().Contains(q) ?? false) ||
                (r.diagnosis?.ToLowerInvariant().Contains(q) ?? false) ||
                (r.chief_complaint?.ToLowerInvariant().Contains(q) ?? false));
        }
    }

