    private IEnumerable<stock_master> GetAvailableStocksForConsumable()
    {
        var query = StockList.Where(s => s.closingstock > 0 && !string.IsNullOrWhiteSpace(s.batchno));
        if (cSelectedItemCode > 0)
        {
            query = query.Where(s => s.itemcode == cSelectedItemCode);
        }
        else if (!string.IsNullOrWhiteSpace(cItemName))
        {
            var matchedItem = ItemList.FirstOrDefault(i => i.itemname != null && string.Equals(i.itemname.Trim(), cItemName.Trim(), StringComparison.OrdinalIgnoreCase));
            if (matchedItem != null)
            {
                query = query.Where(s => s.itemcode == matchedItem.itemcode);
            }
        }

        if (!string.IsNullOrWhiteSpace(cBatchNo))
        {
            query = query.Where(s => s.batchno != null && s.batchno.Contains(cBatchNo, StringComparison.OrdinalIgnoreCase));
        }

        return query.OrderBy(s => s.expirydate ?? DateTime.MaxValue)
                    .GroupBy(s => s.batchno)
                    .Select(g => g.First())
                    .Take(10)
                    .ToList();
    }

    private string GetUomName(int uomCode)
    {
        if (uomCode <= 0 || UomList == null) return "";
        var u = UomList.FirstOrDefault(x => x.ucode == uomCode);
        if (u != null)
        {
            return !string.IsNullOrWhiteSpace(u.shortname) ? u.shortname : (u.name ?? "");
        }
        return "";
    }

    private decimal GetItemUnitMrp(item_master? item)
    {
        if (item == null) return 0;
        decimal packSize = item.packsize > 0 ? item.packsize : 1;
        if (item.mrp > 0)
        {
            return Math.Round(item.mrp / packSize, 2);
        }
        if (item.salesrate > 0)
        {
            return Math.Round(item.salesrate / packSize, 2);
        }
        return 0;
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Remove("tenant-code");
        var effectiveTenant = !string.IsNullOrEmpty(TenantCode) ? TenantCode : (TenantState?.TenantCode ?? "0010");
        if (!string.IsNullOrEmpty(effectiveTenant))
        {
            client.DefaultRequestHeaders.Add("tenantcode", effectiveTenant);
            client.DefaultRequestHeaders.Add("tenant_code", effectiveTenant);
            client.DefaultRequestHeaders.Add("tenant-code", effectiveTenant);
        }
        var effectiveToken = !string.IsNullOrEmpty(AuthToken) ? AuthToken : TenantState?.AuthToken;
        if (!string.IsNullOrEmpty(effectiveToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
        }
        return client;
    }

    private async Task LoadItemsAsync()
    {
        try
        {
            var effectiveTenant = !string.IsNullOrEmpty(TenantCode) ? TenantCode : (TenantState?.TenantCode ?? "");
            
            // 1. Try CaseSheetService
            var items = await CaseSheetService.GetAllItemsAsync(effectiveTenant);
            if (items != null && items.Any())
            {
                ItemList = items.Where(x => !x.deleted).OrderBy(x => x.itemname).ToList();
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OTConsole] CaseSheetService items error: {ex.Message}");
        }

        // 2. Direct relative endpoints via DoctorApi
        try
        {
            var client = CreateClient();
            var endpoints = new[] { "api/ItemMaster/getallitems", "ItemMaster/getallitems", "api/ItemMaster/getallitem" };
            foreach (var ep in endpoints)
            {
                try
                {
                    var response = await client.GetStringAsync(ep);
                    if (!string.IsNullOrWhiteSpace(response))
                    {
                        var list = ParseItemListResponse(response);
                        if (list.Any())
                        {
                            ItemList = list;
                            return;
                        }
                    }
                }
                catch { }
            }
        }
        catch { }

        // 3. Direct absolute HTTP client fallback
        try
        {
            using var directClient = new HttpClient();
            var effectiveTenant = !string.IsNullOrEmpty(TenantCode) ? TenantCode : (TenantState?.TenantCode ?? "0010");
            directClient.DefaultRequestHeaders.Add("tenantcode", effectiveTenant);
            directClient.DefaultRequestHeaders.Add("tenant_code", effectiveTenant);
            var resp = await directClient.GetStringAsync("http://medicoapi.iscansoft.com/api/ItemMaster/getallitems");
            if (!string.IsNullOrWhiteSpace(resp))
            {
                var list = ParseItemListResponse(resp);
                if (list.Any())
                {
                    ItemList = list;
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OTConsole] Direct items fetch error: {ex.Message}");
        }

        ItemList ??= new();
    }

    private List<item_master> ParseItemListResponse(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        var options = new System.Text.Json.JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            System.Text.Json.JsonElement arrayElement = default;
            bool found = false;
            if (root.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                arrayElement = root;
                found = true;
            }
            else if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                if (root.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    arrayElement = dataProp;
                    found = true;
                }
                else
                {
                    foreach (var prop in root.EnumerateObject())
                    {
                        if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.Array)
                        {
                            arrayElement = prop.Value;
                            found = true;
                            break;
                        }
                    }
                }
            }

            if (found && arrayElement.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                var list = System.Text.Json.JsonSerializer.Deserialize<List<item_master>>(arrayElement.GetRawText(), options);
                return list?.Where(x => !x.deleted).OrderBy(x => x.itemname).ToList() ?? new();
            }
        }
        catch { }

        try
        {
            var direct = System.Text.Json.JsonSerializer.Deserialize<List<item_master>>(json, options);
            if (direct != null && direct.Any()) return direct.Where(x => !x.deleted).OrderBy(x => x.itemname).ToList();
        }
        catch { }

        return new();
    }

