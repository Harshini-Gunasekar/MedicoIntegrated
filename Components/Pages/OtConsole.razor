            "SCRUB_NURSE" => "bg-emerald-50 text-emerald-700 border border-emerald-200",
            _ => "bg-light text-dark border"
        };
    }

    private void OpenCasesModal() => showCasesModal = true;
    private void ClearSearch() => searchQuery = "";
    private void HandlePageClick() => isCaseDropdownOpen = false;

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        var count = FilteredRequests.Count();
        if (count == 0) return;

        if (e.Key == "ArrowDown")
        {
            highlightedCaseIndex = (highlightedCaseIndex + 1) % count;
            isCaseDropdownOpen = true;
        }
        else if (e.Key == "ArrowUp")
        {
            highlightedCaseIndex = (highlightedCaseIndex - 1 + count) % count;
            isCaseDropdownOpen = true;
        }
        else if (e.Key == "Enter")
        {
            var match = FilteredRequests.ElementAtOrDefault(highlightedCaseIndex);
            if (match != null)
            {
                SelectCaseFromDropdown(match);
            }
        }
    }
