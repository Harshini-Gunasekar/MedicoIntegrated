                                                        }
                                                        else if (string.Equals(selectedRequest.priority, "URGENT", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge" style="background: #fffbeb; color: #b45309; border: 1px solid #fde68a; font-weight: 700; padding: 4px 12px; border-radius: 9999px; font-size: 0.72rem; letter-spacing: 0.3px;">URGENT</span>
                                                        }
                                                        else
