                <div>
                    <h3 class="m-0 font-bold text-slate-900" style="font-size: 1.15rem;">@(activeOpNote != null ? "Edit Surgical Operation Note" : "Add Surgical Operation Note")</h3>
                    <div class="text-slate-600 font-12 font-medium mt-1">Patient: <strong class="text-slate-800">@GetPatientName(selectedRequest.custid)</strong> (@selectedRequest.procedure_name)</div>
                </div>
                <button type="button" class="preop-close-btn" @onclick="() => showAddOpNoteModal = false" title="Close dialog">&times;</button>
            </div>
            <div class="modal-body preop-modal-body">
                <!-- Row 1: Operating Surgeon & Procedure Performed -->
                <div class="preop-form-grid-2col mb-3">
                    <div class="preop-form-field">
                        <label class="nt-form-label">OPERATING SURGEON <span class="text-danger">*</span></label>
                        <select class="nt-select-control" @bind="opNoteSurgeonCode">
                            <option value="">-- Select Surgeon --</option>
                            @foreach (var d in doctorsList)
                            {
                                <option value="@d.dcode">Dr. @(string.IsNullOrWhiteSpace(d.name) ? d.doctorfullname : d.name) (@(string.IsNullOrWhiteSpace(d.qualification) ? (d.description ?? "Doctor") : d.qualification))</option>
                            }
                        </select>
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">PROCEDURE PERFORMED <span class="text-danger">*</span></label>
                        <input type="text" class="nt-input-control consent-input-text" @bind="opNoteProcedure" placeholder="e.g. Laparoscopic Appendectomy" />
                    </div>
                </div>

                <!-- Row 2: Pre-Op Diagnosis & Post-Op Diagnosis -->
                <div class="preop-form-grid-2col mb-3">
                    <div class="preop-form-field">
                        <label class="nt-form-label">PRE-OPERATIVE DIAGNOSIS</label>
                        <input type="text" class="nt-input-control consent-input-text" @bind="opNoteDiagPre" placeholder="e.g. Acute Appendicitis" />
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">POST-OPERATIVE DIAGNOSIS</label>
                        <input type="text" class="nt-input-control consent-input-text" @bind="opNoteDiagPost" placeholder="e.g. Gangrenous Appendicitis" />
                    </div>
                </div>

                <!-- Row 3: Detailed Operative Findings & Surgical Steps -->
                <div class="preop-form-field mb-3">
                    <label class="nt-form-label">DETAILED OPERATIVE FINDINGS &amp; SURGICAL STEPS</label>
                    <textarea rows="3" class="nt-input-control" @bind="opNoteFindings" placeholder="Detailed surgical procedure steps, findings, anatomy, closure..."></textarea>
                </div>

                <!-- Row 4: Blood Loss & Complications -->
                <div class="preop-form-grid-2col mb-3">
                    <div class="preop-form-field">
                        <label class="nt-form-label">ESTIMATED BLOOD LOSS (ML)</label>
                        <input type="number" class="nt-input-control consent-input-text" @bind="opNoteBloodLoss" placeholder="e.g. 30" />
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">COMPLICATIONS ENCOUNTERED</label>
                        <input type="text" class="nt-input-control consent-input-text" @bind="opNoteComplications" placeholder="e.g. None" />
                    </div>
                </div>

                <!-- Row 5: Specimen / Biopsy -->
                <div class="preop-form-field mb-3">
                    <label class="d-flex align-items-center gap-2 mb-1.5" style="cursor: pointer;">
                        <input type="checkbox" @bind="opNoteSpecimenSent" class="form-check-input mt-0" />
                        <span class="font-12 font-bold text-slate-800">Specimen / Tissue Sent for Histopathology</span>
                    </label>
                    @if (opNoteSpecimenSent)
                    {
                        <input type="text" class="nt-input-control consent-input-text mt-1" @bind="opNoteSpecimenDetails" placeholder="Specimen details, container label, biopsy tests requested" />
                    }
                </div>

                <!-- Row 6: Post-Op Instructions -->
                <div class="preop-form-field mb-0">
                    <label class="nt-form-label">POST-OP INSTRUCTIONS &amp; DISCHARGE PLAN</label>
                    <textarea rows="2" class="nt-input-control" @bind="opNoteInstructions" placeholder="e.g. IV antibiotics x 3 days, drain output monitoring, mobilization"></textarea>
                </div>
            </div>
            <div class="modal-footer-bar preop-modal-footer">
                <button type="button" class="preop-btn-cancel" @onclick="() => showAddOpNoteModal = false">Cancel</button>
                <button type="button" class="preop-btn-save" @onclick="SaveOpNoteAsync">
                    <i class="bi bi-check2"></i> Save Operation Note
                </button>
            </div>
        </div>
    </div>
}

