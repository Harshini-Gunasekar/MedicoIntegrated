        border-color: #ef4444;
    }

    /* ═══════════════════════════════════════════════════════════════
       7. RIGHT LIVE SURGERY DOSSIER (NURSE NOTES THEMED)
       ═══════════════════════════════════════════════════════════════ */
    .ot-live-preview-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
