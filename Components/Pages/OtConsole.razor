@* --- 4. ADD CONSUMABLE MODAL --- *@
@if (showAddConsumableModal && selectedRequest != null)
{
    <div class="modal-overlay">
        <div class="modal-form-card preop-modal-dialog" style="max-width: 680px !important; overflow: visible !important;" @onclick:stopPropagation>
            <div class="modal-header-bar preop-modal-header">
                <div>
                    <h3 class="m-0 font-bold text-slate-900" style="font-size: 1.15rem;">Add OT Consumable Item</h3>
                    <div class="text-slate-600 font-12 font-medium mt-1">Patient: <strong class="text-slate-800">@GetPatientName(selectedRequest.custid)</strong> (@selectedRequest.procedure_name)</div>
                </div>
                <button type="button" class="preop-close-btn" @onclick="() => showAddConsumableModal = false" title="Close">&times;</button>
            </div>
            <div class="modal-body preop-modal-body" style="overflow: visible !important;">
                <!-- Row 1: Item Name (Full Width Typeahead) -->
                <div class="preop-form-field mb-3" style="position: relative;">
                    <label class="nt-form-label">ITEM NAME <span class="text-danger">*</span></label>
                    <input type="text" class="nt-input-control consent-input-text" 
                           @bind="cItemName" 
                           @bind:event="oninput" 
                           @onfocus="OnConsItemFocus" 
                           @onblur="OnConsItemSearchBlur" 
                           placeholder="Type to search item name..." 
                           autocomplete="off" 
                           required />
                    @if (isConsItemDropdownOpen)
                    {
                        var term = cItemName?.Trim() ?? "";
                        var filteredItems = ItemList
                            .Where(i => string.IsNullOrEmpty(term) 
                                || (!string.IsNullOrEmpty(i.itemname) && i.itemname.Contains(term, StringComparison.OrdinalIgnoreCase))
                                || (!string.IsNullOrEmpty(i.shortname) && i.shortname.Contains(term, StringComparison.OrdinalIgnoreCase))
                                || (!string.IsNullOrEmpty(i.drugname) && i.drugname.Contains(term, StringComparison.OrdinalIgnoreCase))
                                || i.itemcode.ToString().Contains(term))
                            .Take(25)
                            .ToList();

                        if (filteredItems.Any())
                        {
                            <div class="ot-typeahead-dropdown">
                                @foreach (var item in filteredItems)
                                {
                                    <div class="ot-typeahead-item" @onmousedown="() => SelectConsumableItem(item)">
                                        <div style="font-weight: 700; color: #1e293b; font-size: 0.88rem;">@item.itemname</div>
                                        <div style="font-size: 0.75rem; color: #64748b; display: flex; justify-content: space-between; margin-top: 2px;">
                                            <span>@(!string.IsNullOrWhiteSpace(item.shortname) ? item.shortname : (!string.IsNullOrWhiteSpace(item.drugname) ? item.drugname : $"Item #{item.itemcode}"))</span>
                                            <span style="color: #4f46e5; font-weight: 700;">₹@(GetItemUnitMrp(item).ToString("N2"))</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(term))
                        {
                            <div class="ot-typeahead-dropdown" style="padding: 10px; text-align: center; color: #64748b; font-size: 0.78rem;">
                                No matching items found
                            </div>
                        }
                    }
                </div>

                <!-- Row 2: Batch No & Unit of Measure -->
                <div class="preop-form-grid-2col mb-3">
                    <div class="preop-form-field" style="position: relative;">
                        <label class="nt-form-label">BATCH NO / LOT</label>
                        <input type="text" class="nt-input-control consent-input-text" 
                               @bind="cBatchNo" 
                               @bind:event="oninput" 
                               @onfocus="OnConsBatchFocus" 
                               @onblur="OnConsBatchSearchBlur" 
                               placeholder="Search or enter batch no..." 
                               autocomplete="off" />
                        @if (isConsBatchDropdownOpen)
                        {
                            var availableStocks = GetAvailableStocksForConsumable();
                            if (availableStocks.Any())
                            {
                                <div class="ot-typeahead-dropdown" style="max-height: 180px;">
                                    @foreach (var stock in availableStocks)
                                    {
                                        <div class="ot-typeahead-item" @onmousedown="() => SelectConsumableBatch(stock)">
                                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                                <strong style="font-size: 0.84rem; color: #1e293b;">@stock.batchno</strong>
                                                <span style="font-size: 0.72rem; color: #0284c7; font-weight: 700;">Qty: @stock.closingstock</span>
                                            </div>
                                            <div style="font-size: 0.72rem; color: #64748b; display: flex; justify-content: space-between; margin-top: 2px;">
                                                <span>Exp: @(stock.expirydate?.ToString("dd-MM-yyyy") ?? "N/A")</span>
                                                @if (stock.mrpunit > 0)
                                                {
                                                    <span style="color: #4f46e5; font-weight: 600;">₹@stock.mrpunit.ToString("N2")</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (cSelectedItemCode > 0)
                            {
                                <div class="ot-typeahead-dropdown" style="padding: 10px; text-align: center; color: #94a3b8; font-size: 0.78rem;">
                                    No stock batches found (custom batch allowed)
                                </div>
                            }
                        }
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">UNIT OF MEASURE</label>
                        <input type="text" class="nt-input-control consent-input-text" @bind="cUnit" placeholder="e.g. PCS / BOX / VIAL / SET" />
                    </div>
                </div>

                <!-- Row 3: Quantity, Rate & Total Amount -->
                <div class="preop-form-grid-3col mb-3">
                    <div class="preop-form-field">
                        <label class="nt-form-label">QUANTITY <span class="text-danger">*</span></label>
                        <input type="number" min="1" step="any" class="nt-input-control consent-input-text" @bind="cQuantity" placeholder="Enter Qty" />
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">RATE (₹) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" class="nt-input-control consent-input-text" @bind="cRate" placeholder="0.00" />
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">TOTAL AMOUNT (₹)</label>
                        <input type="text" class="nt-input-control consent-input-text font-bold text-indigo-600" value="₹@(((cRate ?? 0) * (cQuantity ?? 0)).ToString("N2"))" readonly style="background-color: #f8fafc;" />
                    </div>
                </div>

                <!-- Row 4: Remarks -->
                <div class="preop-form-field mb-0">
                    <label class="nt-form-label">REMARKS / CLINICAL NOTES</label>
                    <input type="text" class="nt-input-control consent-input-text" @bind="cRemarks" placeholder="e.g. Used for stump closure / tissue dissection" />
                </div>
            </div>
            <div class="modal-footer-bar preop-modal-footer">
                <button type="button" class="preop-btn-cancel" @onclick="() => showAddConsumableModal = false">Cancel</button>
                <button type="button" class="preop-btn-save" @onclick="SaveConsumableAsync">
                    <i class="bi bi-check2"></i> Add to Unbilled Charges
                </button>
            </div>
        </div>
    </div>
}

