                                                        }
                                                    </td>
                                                    <td>
                                                        <div style="font-size: 0.82rem; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 5px;">
                                                            <i class="bi bi-stopwatch text-indigo-600"></i>
                                                            <span>@(selectedRequest.expected_duration_minutes ?? 60) mins</span>
                                                        </div>
                                                        <div class="text-slate-500 font-semibold" style="font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.3px; margin-top: 2px;">
                                                            @(selectedRequest.anesthesia_type ?? "GENERAL ANESTHESIA (GA)")
