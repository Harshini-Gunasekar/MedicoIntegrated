    private async Task UpdateTeamMemberRoleAsync()
    {
        if (editingTeamMember == null || selectedRequest == null) return;

        try
        {
            var oldTeamId = editingTeamMember.team_id;
            var oldDocCode = editingTeamMember.dcode;
            var oldStaffName = editingTeamMember.staff_name;
            var oldStaffCode = editingTeamMember.staff_code;
            var newRole = assignTeamRole;

            // Remove old record
            await OtService.RemoveTeamMemberAsync(oldTeamId);

            // Re-add with updated role
            var req = new AddOtTeamMemberRequest
            {
                request_id = selectedRequest.request_id,
                role = newRole,
                dcode = oldDocCode,
                staff_name = oldStaffName,
                staff_code = oldStaffCode
            };

            var res = await OtService.AddTeamMemberAsync(req);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess($"Updated role for {GetCleanStaffName(oldStaffName)} to {FormatRoleName(newRole)}.");
                activeTeamMembers = await OtService.GetTeamByRequestAsync(selectedRequest.request_id);
                editingTeamMember = null;
            }
            else
            {
                ToastService.ShowError(res.message);
