                                                                <option value="SCRUB_NURSE">Scrub Nurse</option>
                                                                <option value="CIRCULATING_NURSE">Circulating / Floor Nurse</option>
                                                                <option value="RECOVERY_NURSE">PACU / Recovery Nurse</option>
                                                                <option value="OT_TECHNICIAN">OT Technician</option>
                                                                <option value="ANESTHESIA_TECH">Anesthesia Tech</option>
                                                                <option value="SUPPORT_STAFF">Support Staff</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center gap-1">
                                                    <button type="button" class="btn btn-sm btn-primary font-11 py-1 px-3 fw-bold" @onclick="UpdateTeamMemberRoleAsync">Update</button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary font-11 py-1 px-2" @onclick="CancelEditingTeamMember">Cancel</button>
                                                </div>
                                            </div>
                                        }

                                        <div class="assign-card-body">
                                            <!-- Source Segmented Tabs directly at top -->
                                            <div class="assign-tabs-container">
                                                <div class="assign-tabs-strip">
                                                    <button type="button" class="assign-tab-btn @(assignTeamSourceTab == "DOCTOR" ? "active" : "")" @onclick='() => SetAssignTeamSourceTab("DOCTOR")'>
                                                        <i class="bi bi-person-badge"></i>
                                                        <span>Doctors &amp; Surgeons</span>
                                                        <span class="assign-tab-badge">@doctorsList.Count</span>
                                                    </button>
                                                    <button type="button" class="assign-tab-btn @(assignTeamSourceTab == "NURSE" ? "active" : "")" @onclick='() => SetAssignTeamSourceTab("NURSE")'>
                                                        <i class="bi bi-heart-pulse"></i>
                                                        <span>Nursing Staff</span>
                                                        <span class="assign-tab-badge">@nursesList.Count</span>
                                                    </button>
                                                    <button type="button" class="assign-tab-btn @(assignTeamSourceTab == "MANUAL" ? "active" : "")" @onclick='() => SetAssignTeamSourceTab("MANUAL")'>
                                                        <i class="bi bi-person-plus"></i>
                                                        <span>Others</span>
                                                    </button>
                                                </div>

                                                <div class="assign-tab-content">
                                                    @if (assignTeamSourceTab == "DOCTOR")
                                                    {
                                                        <div class="picker-search-wrap mb-2">
                                                            <i class="bi bi-search"></i>
                                                            <input type="text" class="picker-search-input" placeholder="Search doctors by name or qualification..." @bind="assignDocSearch" @bind:event="oninput" />
                                                            @if (!string.IsNullOrWhiteSpace(assignDocSearch))
                                                            {
                                                                <button type="button" class="picker-search-clear" @onclick='() => assignDocSearch = ""'>&times;</button>
                                                            }
                                                        </div>

                                                        <div class="picker-list-box">
                                                            @foreach (var doc in FilteredDoctorsForAssign)
                                                            {
                                                                var docFullName = string.IsNullOrWhiteSpace(doc.name) ? (doc.doctorfullname ?? "Doctor") : doc.name;
                                                                var spec = string.IsNullOrWhiteSpace(doc.qualification) ? doc.description : doc.qualification;
                                                                var assignedMember = GetAssignedMemberForDoctor(doc.dcode, docFullName);
                                                                var isAssigned = assignedMember != null;
                                                                var isSelected = pendingTeamAllocations.Any(p => p.DCode == doc.dcode || p.StaffName == $"Dr. {docFullName}" || p.StaffName == docFullName);
                                                                var docImg = GetDoctorImageSrc(doc);
                                                                var docInitial = GetDoctorInitial(doc, docFullName);
                                                                var isEditingThis = editingTeamMember != null && assignedMember != null && editingTeamMember.team_id == assignedMember.team_id;

                                                                <div class="picker-item @(isSelected ? "selected" : "") @(isAssigned ? "already-assigned" : "") @(isEditingThis ? "editing-highlight" : "")"
                                                                     @onclick="() => { if (isAssigned) StartEditingTeamMember(assignedMember); else ToggleDoctorForAssign(doc.dcode, docFullName); }">
                                                                    <div class="picker-checkbox">
                                                                        @if (isAssigned)
                                                                        {
                                                                            <i class="bi bi-check-circle-fill text-success font-14" title="Already Allocated"></i>
                                                                        }
                                                                        else
                                                                        {
                                                                            <input type="checkbox" checked="@isSelected" @onclick:stopPropagation @onchange="() => ToggleDoctorForAssign(doc.dcode, docFullName)" />
                                                                        }
                                                                    </div>
                                                                    <div class="staff-avatar-circle avatar-indigo">
                                                                        @if (!string.IsNullOrEmpty(docImg))
                                                                        {
                                                                            <img src="@docImg" alt="@docFullName" class="staff-avatar-img" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@docInitial</span>
                                                                        }
                                                                    </div>
                                                                    <div class="picker-item-details">
                                                                        <span class="picker-item-name font-bold">Dr. @docFullName</span>
                                                                        @if (!string.IsNullOrWhiteSpace(spec))
                                                                        {
                                                                            <span class="picker-item-sub font-11 text-slate-500">@spec</span>
                                                                        }
                                                                    </div>
                                                                    @if (isEditingThis)
                                                                    {
                                                                        <span class="badge bg-warning text-dark font-10">Editing</span>
                                                                    }
                                                                    else if (isAssigned)
                                                                    {
                                                                        <div class="d-flex align-items-center gap-1">
                                                                            <span class="badge bg-emerald-100 text-emerald-800 font-10">✓ @GetCleanRoleDisplay(assignedMember)</span>
                                                                            <button type="button" class="btn-item-quick-edit" @onclick:stopPropagation @onclick="() => StartEditingTeamMember(assignedMember)" title="Edit Role">
                                                                                <i class="bi bi-pencil-fill"></i>
                                                                            </button>
                                                                        </div>
                                                                    }
                                                                    else if (isSelected)
                                                                    {
                                                                        <span class="badge bg-indigo-100 text-indigo-700 font-10">Selected</span>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else if (assignTeamSourceTab == "NURSE")
                                                    {
                                                        <div class="picker-search-wrap mb-2">
                                                            <i class="bi bi-search"></i>
                                                            <input type="text" class="picker-search-input" placeholder="Search nurses by name..." @bind="assignNurseSearch" @bind:event="oninput" />
                                                            @if (!string.IsNullOrWhiteSpace(assignNurseSearch))
                                                            {
                                                                <button type="button" class="picker-search-clear" @onclick='() => assignNurseSearch = ""'>&times;</button>
                                                            }
                                                        </div>

                                                        <div class="picker-list-box">
                                                            @foreach (var n in FilteredNursesForAssign)
                                                            {
                                                                var nName = string.IsNullOrWhiteSpace(n.nursename) ? (n.shortname ?? "Nurse") : n.nursename;
                                                                var assignedMember = GetAssignedMemberForNurse(nName);
                                                                var isAssigned = assignedMember != null;
                                                                var isSelected = pendingTeamAllocations.Any(p => p.StaffName == nName);
                                                                var isEditingThis = editingTeamMember != null && assignedMember != null && editingTeamMember.team_id == assignedMember.team_id;

                                                                <div class="picker-item @(isSelected ? "selected" : "") @(isAssigned ? "already-assigned" : "") @(isEditingThis ? "editing-highlight" : "")"
                                                                     @onclick='() => { if (isAssigned) StartEditingTeamMember(assignedMember); else ToggleNurseForAssign(nName, ""); }'>
                                                                    <div class="picker-checkbox">
                                                                        @if (isAssigned)
                                                                        {
                                                                            <i class="bi bi-check-circle-fill text-success font-14" title="Already Allocated"></i>
                                                                        }
                                                                        else
                                                                        {
                                                                            <input type="checkbox" checked="@isSelected" @onclick:stopPropagation @onchange='() => ToggleNurseForAssign(nName, "")' />
                                                                        }
                                                                    </div>
                                                                    <div class="staff-avatar-circle avatar-emerald">
                                                                        @GetInitials(nName)
                                                                    </div>
                                                                    <div class="picker-item-details">
                                                                        <span class="picker-item-name font-bold">@nName</span>
                                                                    </div>
                                                                    @if (isEditingThis)
                                                                    {
                                                                        <span class="badge bg-warning text-dark font-10">Editing</span>
                                                                    }
                                                                    else if (isAssigned)
                                                                    {
                                                                        <div class="d-flex align-items-center gap-1">
                                                                            <span class="badge bg-emerald-100 text-emerald-800 font-10">✓ @GetCleanRoleDisplay(assignedMember)</span>
                                                                            <button type="button" class="btn-item-quick-edit" @onclick:stopPropagation @onclick="() => StartEditingTeamMember(assignedMember)" title="Edit Role">
                                                                                <i class="bi bi-pencil-fill"></i>
                                                                            </button>
                                                                        </div>
                                                                    }
                                                                    else if (isSelected)
                                                                    {
                                                                        <span class="badge bg-emerald-100 text-emerald-700 font-10">Selected</span>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="form-field-unit mt-2">
                                                            <label class="assign-role-label mb-1">Staff / Clinician Name <span class="text-danger">*</span></label>
                                                            <div class="manual-input-group">
                                                                <i class="bi bi-person-fill manual-input-icon"></i>
                                                                <input type="text"
                                                                       class="manual-name-input"
                                                                       @bind="assignManualStaffName"
                                                                       @bind:event="oninput"
                                                                       placeholder="e.g. Technician Raman / Support Staff"
                                                                       @onkeydown="@(e => { if (e.Key == "Enter") AddManualPendingStaff(); })" />
                                                                <button type="button"
                                                                       class="btn-add-to-team"
                                                                       @onclick="AddManualPendingStaff"
                                                                       disabled="@string.IsNullOrWhiteSpace(assignManualStaffName)">
                                                                    <i class="bi bi-plus-circle-fill me-1"></i>
                                                                    <span>Add</span>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Selected Team Members Pending Tray -->
                                            @if (pendingTeamAllocations.Any())
                                            {
                                                <div class="pending-roster-tray">
                                                    <div class="pending-tray-header">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="pending-tray-icon"><i class="bi bi-people-fill text-indigo-600"></i></span>
                                                            <span class="pending-tray-title">Selected to Allocate:</span>
                                                            <span class="pending-tray-count-badge">@pendingTeamAllocations.Count</span>
                                                        </div>
                                                        <button type="button" class="btn-clear-all-link" @onclick="() => pendingTeamAllocations.Clear()" title="Clear all selected members">
                                                            <i class="bi bi-trash3 me-1"></i>Clear All
                                                        </button>
                                                    </div>
                                                    <div class="pending-chips-wrap">
                                                        @foreach (var p in pendingTeamAllocations)
                                                        {
                                                            <div class="pending-member-chip @(p.Type == "NURSE" ? "pending-chip-nurse" : "")">
                                                                <span class="pending-chip-role">@(p.Type == "NURSE" ? "Nurse" : FormatRoleName(p.Role))</span>
                                                                <span class="pending-chip-name">@p.StaffName</span>
                                                                <button type="button" class="btn-chip-remove" @onclick="() => pendingTeamAllocations.Remove(p)" title="Remove member">&times;</button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Footer Bar -->
                                        <div class="assign-card-footer">
                                            <button type="button" class="btn-modal-cancel" @onclick="() => pendingTeamAllocations.Clear()" disabled="@(!pendingTeamAllocations.Any())">Clear</button>
                                            <button type="button" class="btn-assign-primary" @onclick="SaveAssignMembersAsync" disabled="@(!pendingTeamAllocations.Any())">
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                <span>Allocate @(pendingTeamAllocations.Count > 0 ? $"({pendingTeamAllocations.Count}) " : "")to Surgery Case</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- ========================================================================= -->
                                <!-- 2. RIGHT PANEL: ALLOCATED TEAM MEMBERS DETAILS TABLE                      -->
                                <!-- ========================================================================= -->
                                <div class="team-split-col team-split-right">
                                    <div class="team-view-section">
                                        <!-- Header Card -->
                                        <div class="team-roster-header-card">
                                            <div class="roster-header-main">
                                                <div class="roster-icon-box">
                                                    <i class="bi bi-people-fill"></i>
                                                </div>
                                                <div class="roster-title-col">
                                                    <div class="roster-title-row">
                                                        <h4 class="roster-title-text">OT Team Members</h4>
                                                        <span class="roster-count-badge">@activeTeamMembers.Count @(activeTeamMembers.Count == 1 ? "Staff Allocated" : "Staffs Allocated")</span>
                                                    </div>
                                                    <div class="roster-sub-meta">
                                                        <span class="meta-patient-name"><i class="bi bi-person-fill text-indigo-500 me-1"></i>@(string.IsNullOrWhiteSpace(curPatName) ? "Patient" : curPatName)</span>
                                                        <span class="meta-separator">•</span>
                                                        <span class="meta-procedure-name"><i class="bi bi-activity text-indigo-500 me-1"></i>@selectedRequest.procedure_name</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Filter Pill Strip -->
                                        <div class="roster-filter-strip">
                                            <button type="button" class="roster-filter-btn @(selectedTeamRoleFilter == null ? "active" : "")" @onclick='() => selectedTeamRoleFilter = null'>
                                                <span>ALL STAFF</span>
                                                <span class="r-filter-count">(@GetTeamCountByRole(null))</span>
                                            </button>
                                            <button type="button" class="roster-filter-btn @(selectedTeamRoleFilter == "SURGEON" ? "active" : "")" @onclick='() => selectedTeamRoleFilter = "SURGEON"'>
                                                <span>SURGEONS</span>
                                                <span class="r-filter-count">(@GetTeamCountByRole("SURGEON"))</span>
                                            </button>
                                            <button type="button" class="roster-filter-btn @(selectedTeamRoleFilter == "ANESTHETIST" ? "active" : "")" @onclick='() => selectedTeamRoleFilter = "ANESTHETIST"'>
                                                <span>ANESTHETISTS</span>
                                                <span class="r-filter-count">(@GetTeamCountByRole("ANESTHETIST"))</span>
                                            </button>
                                            <button type="button" class="roster-filter-btn @(selectedTeamRoleFilter == "NURSE" ? "active" : "")" @onclick='() => selectedTeamRoleFilter = "NURSE"'>
                                                <span>NURSES</span>
                                                <span class="r-filter-count">(@GetTeamCountByRole("NURSE"))</span>
                                            </button>
                                        </div>

                                        <!-- Table Card -->
                                        <div class="roster-table-card">
                                            @if (!FilteredAllocatedTeamMembers.Any())
                                            {
                                                <div class="roster-empty-box">
                                                    <div class="roster-empty-icon">
                                                        <i class="bi bi-people"></i>
                                                    </div>
                                                    <h5 class="roster-empty-title">No Members Allocated Yet</h5>
                                                    <p class="roster-empty-desc">No team members found for this filter. Use the left panel to assign doctors, anesthetists, and nurses to this case.</p>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="table-responsive roster-table-scroll-wrap">
                                                    <table class="table modern-roster-table align-middle mb-0">
                                                        <colgroup>
                                                            <col style="width: 36%;" />
                                                            <col style="width: 28%;" />
                                                            <col style="width: 22%;" />
                                                            <col style="width: 14%;" />
                                                        </colgroup>
                                                        <thead>
                                                            <tr>
                                                                <th class="col-staff-name">STAFF NAME</th>
                                                                <th class="col-qualification">QUALIFICATION</th>
                                                                <th class="col-role">ROLE</th>
                                                                <th class="col-action text-end pe-3">ACTION</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var tm in FilteredAllocatedTeamMembers)
                                                            {
                                                                var cleanName = GetCleanStaffName(tm.staff_name);
                                                                var qual = GetStaffQualification(tm);
                                                                var roleDisplay = GetCleanRoleDisplay(tm);
                                                                var isBeingEdited = editingTeamMember != null && editingTeamMember.team_id == tm.team_id;

                                                                <tr class="roster-table-row @(isBeingEdited ? "row-being-edited" : "")">
                                                                    <!-- 1. Staff Name + Avatar -->
                                                                    <td class="col-staff-name">
                                                                        <div class="staff-cell-inline">
                                                                            @if (IsNurseMember(tm))
                                                                            {
                                                                                <div class="staff-avatar-circle avatar-emerald">
                                                                                    @GetInitials(cleanName)
                                                                                </div>
                                                                            }
                                                                            else
                                                                            {
                                                                                var docModel = GetDoctorForMember(tm);
                                                                                var docImg = GetDoctorImageSrc(docModel);
                                                                                var docInitial = GetDoctorInitial(docModel, cleanName);

                                                                                <div class="staff-avatar-circle avatar-indigo @(IsAnesthetistMember(tm) ? "avatar-purple-circle" : "")">
                                                                                    @if (!string.IsNullOrEmpty(docImg))
                                                                                    {
                                                                                        <img src="@docImg" alt="@cleanName" class="staff-avatar-img" />
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span>@docInitial</span>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                            <div class="staff-name-box">
                                                                                <span class="staff-name-text">@cleanName</span>
                                                                            </div>
                                                                        </div>
                                                                    </td>

                                                                    <!-- 2. Qualification -->
                                                                    <td class="col-qualification">
                                                                        <span class="qualification-text" title="@qual">@qual</span>
                                                                    </td>

                                                                    <!-- 3. Role Pill Tag -->
                                                                    <td class="col-role">
                                                                        <span class="role-pill-tag @GetRolePillClass(tm)">@roleDisplay</span>
                                                                    </td>

                                                                    <!-- 4. Actions: Edit + Delete -->
                                                                    <td class="col-action text-end pe-3">
                                                                        <div class="d-flex align-items-center justify-content-end gap-1">
                                                                            <button type="button" class="btn-ghost-action btn-ghost-edit" @onclick="() => StartEditingTeamMember(tm)" title="Edit Role">
                                                                                <i class="bi bi-pencil"></i>
                                                                            </button>
                                                                            <button type="button" class="btn-ghost-action btn-ghost-delete" @onclick="() => DeleteTeamMemberAsync(tm.team_id)" title="Remove Member from Case">
                                                                                <i class="bi bi-trash3"></i>
                                                                            </button>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @* ═══════════════════════════════════════════════════════════════════ *@
                        @* TAB 4: ANAESTHESIA                                              *@
                        @* ═══════════════════════════════════════════════════════════════════ *@
                        else if (activeTab == "ANAESTHESIA")
                        {
                            <div class="tab-section-flow">
                                <!-- Section Header matching Schedule Table UI -->
                                <div class="clinical-section-header mb-3">
                                    <div class="clinical-section-title">
                                        <div class="section-icon-badge" style="background: #f3e8ff; color: #7e22ce;">
                                            <i class="bi bi-lungs-fill"></i>
                                        </div>
                                        <div>
                                            <h4 class="section-main-heading">3. Pre-Anesthesia Assessment &amp; Intra-OP Plan</h4>
                                            <span class="section-sub-heading">Technique selection, ASA physical status grading, airway score, drugs &amp; PACU recovery plan</span>
                                        </div>
                                        <span class="table-pill-count ms-2" style="background: #f1f5f9; color: #475569; font-weight: 700; font-size: 0.75rem; padding: 4px 10px; border-radius: 9999px; border: 1px solid #e2e8f0;">
                                            @(activeAnesthesias.Count > 0 ? $"{activeAnesthesias.Count} Recorded Plan{(activeAnesthesias.Count == 1 ? "" : "s")}" : "0 Records")
                                        </span>
                                    </div>
                                </div>

                                <div class="directory-section mb-4">
                                    <div class="lc-table-container">
                                        <table class="ot-schedule-table">
                                            <thead>
                                                <tr>
                                                    <th style="width: 50px; text-align: center;">S.NO</th>
                                                    <th style="width: 210px;">TECHNIQUE / TYPE</th>
                                                    <th style="width: 110px; text-align: center;">ASA GRADE</th>
                                                    <th style="width: 200px;">ANESTHESIOLOGIST</th>
                                                    <th style="width: 160px;">AIRWAY / EVALUATION</th>
                                                    <th style="width: 220px;">DRUGS & IV FLUIDS</th>
                                                    <th>COMPLICATIONS / PACU NOTES</th>
                                                    <th style="width: 75px; text-align: center;">ACTIONS</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (activeAnesthesias.Any())
                                                {
                                                    int anesIndex = 1;
                                                    @foreach (var plan in activeAnesthesias)
                                                    {
                                                        var currentPlan = plan;
                                                        var anDocName = currentPlan.anesthetist_dcode.HasValue ? GetDoctorName(currentPlan.anesthetist_dcode.Value) : "Attending Anesthetist";
                                                        var isThisRowEditing = isAddingAnesthesiaInline && isEditingExistingAnesthesia && editingAnesthesiaId == currentPlan.anesthesia_id;

                                                        @if (isThisRowEditing)
                                                        {
                                                            <tr class="table-inline-edit-row">
                                                                <td style="text-align: center;">
                                                                    <span style="background: #f3e8ff; color: #7e22ce; font-weight: 800; font-size: 0.78rem; width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; border: 1px solid #e9d5ff;">@anesIndex</span>
                                                                </td>
                                                                <td>
                                                                    <select class="form-select form-select-sm" style="border-radius: 6px; border-color: #cbd5e1; font-size: 0.82rem; height: 34px; font-weight: 600; color: #1e293b; width: 100%; box-shadow: none;" @bind="anesType">
                                                                        <option value="GENERAL ANESTHESIA (GA)">General Anesthesia (GA)</option>
                                                                        <option value="SPINAL ANESTHESIA (SA)">Spinal Anesthesia (SA)</option>
                                                                        <option value="EPIDURAL ANESTHESIA">Epidural Anesthesia</option>
                                                                        <option value="LOCAL ANESTHESIA (LA)">Local Anesthesia (LA)</option>
                                                                        <option value="SEDATION / MAC">Monitored Care (MAC)</option>
                                                                        <option value="REGIONAL NERVE BLOCK">Regional Nerve Block</option>
                                                                    </select>
                                                                </td>
                                                                <td style="text-align: center;">
                                                                    <select class="form-select form-select-sm" style="border-radius: 6px; border-color: #cbd5e1; font-size: 0.82rem; height: 34px; font-weight: 700; color: #1e293b; width: 100%; text-align: center; box-shadow: none;" @bind="anesAsaGrade">
                                                                        <option value="ASA I">ASA I</option>
                                                                        <option value="ASA II">ASA II</option>
                                                                        <option value="ASA III">ASA III</option>
                                                                        <option value="ASA IV">ASA IV</option>
                                                                        <option value="ASA V">ASA V</option>
                                                                        <option value="ASA E">ASA E</option>
                                                                    </select>
                                                                </td>
                                                                <td>
                                                                    <select class="form-select form-select-sm" style="border-radius: 6px; border-color: #cbd5e1; font-size: 0.82rem; height: 34px; font-weight: 600; color: #1e293b; width: 100%; box-shadow: none;" @bind="anesDocCode">
                                                                        <option value="0">-- Select Anesthetist --</option>
                                                                        @foreach (var doc in doctorsList)
                                                                        {
                                                                            <option value="@doc.dcode">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</option>
                                                                        }
                                                                    </select>
                                                                </td>
                                                                <td>
                                                                    <input type="text" class="form-control form-control-sm" style="border-radius: 6px; border-color: #cbd5e1; font-size: 0.82rem; height: 34px; width: 100%; box-shadow: none;" placeholder="e.g. Mallampati I, Normal" @bind="anesAirway" />
                                                                </td>
                                                                <td>
                                                                    <input type="text" class="form-control form-control-sm" style="border-radius: 6px; border-color: #cbd5e1; font-size: 0.82rem; height: 34px; width: 100%; box-shadow: none;" placeholder="Drugs &amp; IV fluids given..." @bind="anesDrugs" />
                                                                </td>
                                                                <td>
