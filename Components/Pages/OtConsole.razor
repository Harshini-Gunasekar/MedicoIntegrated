            staffCode = "DOCTOR";
        }
        else
        {
            if (string.IsNullOrWhiteSpace(teamStaffName))
            {
                ToastService.ShowWarning("Please enter the staff member's name.");
                return;
            }
            finalName = teamStaffName.Trim();
            staffCode = !string.IsNullOrWhiteSpace(teamStaffCode) ? teamStaffCode.Trim() : teamRole;
        }

        try
        {
            var req = new AddOtTeamMemberRequest
            {
                request_id = selectedRequest.request_id,
                role = teamRole,
                dcode = docCode,
                staff_name = finalName,
                staff_code = staffCode
