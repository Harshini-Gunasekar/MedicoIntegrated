    private decimal GetTotalStaffConsumptionAmount()
    {
        return activeConsumables.Sum(c => (c.quantity * (c.rate ?? 0)));
    }

    private string GetPatientName(decimal custid)
    {
        var match = allRequests.FirstOrDefault(r => r.custid == custid);
        if (match != null && !string.IsNullOrWhiteSpace(match.patient_name)) return match.patient_name;
        return $"Patient #{custid.ToString("0")}";
    }

    private string GetDoctorName(int dcode)
    {
        var match = doctorsList.FirstOrDefault(d => d.dcode == dcode);
        if (match != null) return string.IsNullOrWhiteSpace(match.name) ? (match.doctorfullname ?? "Surgeon") : match.name;
        var rMatch = allRequests.FirstOrDefault(r => r.dcode == dcode);
        if (rMatch != null && !string.IsNullOrWhiteSpace(rMatch.doctor_name)) return rMatch.doctor_name;
        return "Specialist";
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "OT";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return $"{parts[0][0]}{parts[parts.Length - 1][0]}".ToUpper();
    }

    private string GetStatusBadgeClass(string? status)
    {
        return (status ?? "").ToUpper() switch
        {
            "COMPLETED" => "bg-success text-white",
            "IN_PROGRESS" => "bg-primary text-white",
            "SCHEDULED" => "bg-info text-dark",
            "CANCELLED" => "bg-danger text-white",
            _ => "bg-warning text-dark"
        };
    }

    private string GetPriorityBadgeClass(string? priority)
    {
        return (priority ?? "").ToUpper() switch
        {
            "EMERGENCY" => "bg-danger text-white font-bold",
            "URGENT" => "bg-warning text-dark font-bold",
            _ => "bg-light text-dark border"
        };
    }

    private string GetFitnessBadgeClass(string? fitness)
    {
        return (fitness ?? "").ToUpper() switch
        {
            "FIT" => "bg-success text-white",
            "HIGH_RISK" => "bg-danger text-white",
