                                                                    <span class="badge" style="background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; font-weight: 700; padding: 4px 12px; border-radius: 9999px; font-size: 0.72rem; letter-spacing: 0.3px;">CANCELLED</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge" style="background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-weight: 700; padding: 4px 12px; border-radius: 9999px; font-size: 0.72rem; letter-spacing: 0.3px;">@(string.IsNullOrWhiteSpace(activeSchedule.status) ? "SCHEDULED" : activeSchedule.status.ToUpperInvariant())</span>
