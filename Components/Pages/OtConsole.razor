                                        @if (activeIntraOp != null)
                                        {
                                            <span class="table-pill-count ms-1">1 Record</span>
                                        }
                                    </div>
                                    <button type="button" class="btn-indigo-action btn-sm" @onclick="OpenAddIntraOpModal">
                                        <i class="bi bi-plus-lg me-1"></i> Add Record
                                    </button>
                                </div>

                                <div class="lc-table-container">
                                    <table class="lc-table">
                                        <thead>
                                            <tr>
                                                <th style="min-width: 170px;">PROCEDURE PERFORMED</th>
                                                <th style="min-width: 150px;">PRE-OP DIAGNOSIS</th>
                                                <th style="min-width: 150px;">POST-OP DIAGNOSIS</th>
                                                <th style="min-width: 170px;">INTRA-OP FINDINGS</th>
                                                <th style="min-width: 130px;">EST. BLOOD LOSS</th>
                                                <th style="min-width: 150px;">COMPLICATIONS &amp; REMARKS</th>
                                                <th class="text-end pe-3" style="min-width: 90px;">ACTIONS</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (activeIntraOp != null)
                                            {
                                                <tr class="lc-table-row">
                                                    <td>
                                                        <span class="font-12 font-bold text-slate-800">
                                                            @(string.IsNullOrWhiteSpace(activeIntraOp.procedure_performed) ? (selectedRequest?.procedure_name ?? "-") : activeIntraOp.procedure_performed)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="font-12 text-slate-700" style="max-width: 160px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@activeIntraOp.diagnosis_pre">
                                                            @(string.IsNullOrWhiteSpace(activeIntraOp.diagnosis_pre) ? "-" : activeIntraOp.diagnosis_pre)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-indigo-50 text-indigo-700 border border-indigo-200 font-11 font-semibold" style="max-width: 160px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@activeIntraOp.diagnosis_post">
                                                            @(string.IsNullOrWhiteSpace(activeIntraOp.diagnosis_post) ? "-" : activeIntraOp.diagnosis_post)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="font-12 text-slate-600" style="max-width: 180px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@activeIntraOp.findings">
                                                            @(string.IsNullOrWhiteSpace(activeIntraOp.findings) ? "-" : activeIntraOp.findings)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (activeIntraOp.blood_loss_ml.HasValue)
                                                        {
                                                            <span class="badge @(activeIntraOp.blood_loss_ml > 200 ? "bg-amber-100 text-amber-800 border border-amber-300" : "bg-slate-100 text-slate-700") font-11 font-bold">
                                                                @activeIntraOp.blood_loss_ml mL
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="font-12 text-slate-400">-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="font-12 text-slate-700" style="max-width: 160px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@(!string.IsNullOrWhiteSpace(activeIntraOp.complications) ? activeIntraOp.complications : activeIntraOp.remarks)">
                                                            @if (!string.IsNullOrWhiteSpace(activeIntraOp.complications) && activeIntraOp.complications != "None")
                                                            {
                                                                <span class="text-danger font-semibold">@activeIntraOp.complications</span>
                                                            }
                                                            else if (!string.IsNullOrWhiteSpace(activeIntraOp.remarks))
                                                            {
                                                                <span>@activeIntraOp.remarks</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-slate-400">None / Nil</span>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td class="text-end pe-3">
                                                        <div class="d-inline-flex gap-1.5">
                                                            <button type="button" class="btn-action-round btn-action-view" @onclick="OpenViewIntraOpModal" title="View Intra-Op Details">
                                                                <i class="bi bi-eye"></i>
                                                            </button>
                                                            <button type="button" class="btn-action-round btn-action-edit" @onclick="OpenAddIntraOpModal" title="Edit Intra-Op Record">
                                                                <i class="bi bi-pencil-square"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="7" class="text-center p-4 text-slate-400 italic">
                                                        <i class="bi bi-heart-pulse fs-3 d-block mb-1 text-slate-300"></i>
                                                        No intra-operative surgery record added yet. Click <strong>'+ Add Record'</strong> to record surgery details.
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                        else if (surgerySubTab == "CONSUMABLES")
                        {
                            <div class="directory-section">
                                <div class="table-card-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-box-seam text-indigo-600 fs-6"></i>
                                        <span class="table-card-heading">OT Consumables Used</span>
                                        <span class="table-pill-count ms-1">@activeConsumables.Count @(activeConsumables.Count == 1 ? "Item" : "Items")</span>
                                    </div>
                                    <button type="button" class="btn-indigo-action btn-sm" @onclick="OpenAddConsumableModal">+ Add Consumable</button>
                                </div>

                                <div class="lc-table-container">
                                    <table class="lc-table">
                                        <thead>
                                            <tr>
                                                <th>ITEM NAME</th>
                                                <th>BATCH NO</th>
                                                <th class="text-center">QTY</th>
                                                <th class="text-end">RATE</th>
                                                <th class="text-end">AMOUNT</th>
                                                <th class="text-center">BILLED STATUS</th>
                                                <th class="text-center" style="width: 80px;">ACTION</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (activeConsumables.Any())
                                            {
                                                @foreach (var cons in activeConsumables)
                                                {
                                                    <tr class="lc-table-row">
                                                        <td class="font-bold text-slate-800">@cons.item_name</td>
                                                        <td class="font-mono font-11 text-slate-600">@(string.IsNullOrWhiteSpace(cons.batch_no) ? "-" : cons.batch_no)</td>
                                                        <td class="text-center font-bold">@cons.quantity @(cons.unit ?? "PCS")</td>
                                                        <td class="text-end font-mono">₹@(cons.rate?.ToString("N2") ?? "0.00")</td>
                                                        <td class="text-end font-mono font-bold text-indigo-600">₹@(cons.amount?.ToString("N2") ?? (cons.rate * cons.quantity)?.ToString("N2") ?? "0.00")</td>
                                                        <td class="text-center">
                                                            <span class="badge @(cons.is_billed ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                                                @(cons.is_billed ? "Billed" : "Unbilled")
                                                            </span>
                                                        </td>
                                                        <td class="text-center">
                                                            <button type="button" class="btn-action-icon btn-action-delete" @onclick="() => DeleteConsumable(cons.consumable_id)" title="Remove item">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="7" class="text-center p-3 text-slate-400 italic">No consumables added for this case.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                        else if (surgerySubTab == "IMPLANTS")
                        {
                            <div class="directory-section">
                                <div class="table-card-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-shield-plus text-purple fs-6"></i>
                                        <span class="table-card-heading">Surgical Implants &amp; Prostheses</span>
                                        <span class="table-pill-count ms-1">@activeImplants.Count @(activeImplants.Count == 1 ? "Item" : "Items")</span>
                                    </div>
                                    <button type="button" class="btn-indigo-action btn-sm btn-purple-action" @onclick="OpenAddImplantModal">+ Add Implant</button>
                                </div>

                                <div class="lc-table-container">
                                    <table class="lc-table">
                                        <thead>
                                            <tr>
                                                <th>IMPLANT NAME</th>
                                                <th>MANUFACTURER / SERIAL</th>
                                                <th>BATCH NO</th>
                                                <th class="text-center">QTY</th>
                                                <th class="text-end">RATE</th>
                                                <th class="text-end">AMOUNT</th>
                                                <th class="text-center">BILLED STATUS</th>
                                                <th class="text-center" style="width: 80px;">ACTION</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (activeImplants.Any())
                                            {
                                                @foreach (var imp in activeImplants)
                                                {
                                                    <tr class="lc-table-row">
                                                        <td class="font-bold text-slate-800">@imp.item_name</td>
                                                        <td class="text-slate-600 font-12">@(imp.manufacturer ?? "-") / <span class="font-mono">@(imp.serial_no ?? "-")</span></td>
                                                        <td class="font-mono font-11 text-slate-600">@(imp.batch_no ?? "-")</td>
                                                        <td class="text-center font-bold">@imp.quantity</td>
                                                        <td class="text-end font-mono">₹@(imp.rate?.ToString("N2") ?? "0.00")</td>
                                                        <td class="text-end font-mono font-bold text-indigo-600">₹@(imp.amount?.ToString("N2") ?? (imp.rate * imp.quantity)?.ToString("N2") ?? "0.00")</td>
                                                        <td class="text-center">
                                                            <span class="badge @(imp.is_billed ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                                                @(imp.is_billed ? "Billed" : "Unbilled")
                                                            </span>
                                                        </td>
                                                        <td class="text-center">
                                                            <button type="button" class="btn-action-icon btn-action-delete" @onclick="() => DeleteImplant(imp.implant_id)" title="Remove implant">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="8" class="text-center p-3 text-slate-400 italic">No implants recorded for this case.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════ *@
                @* TAB: STERILIZATION (CSSD & INSTRUMENTS LOG)                     *@
                @* ═══════════════════════════════════════════════════════════════ *@
                else if (activeTab == "STERILIZATION")
                {
                    <div class="tab-section-flow">
                        <div class="directory-section">
                            <div class="table-card-header">
                                <span class="table-card-heading">CSSD &amp; Instrument Sterilization Log</span>
                                <button type="button" class="btn-indigo-action btn-sm" @onclick="OpenAddSterilizationModal">
                                    <i class="bi bi-plus-lg me-1"></i> Add Sterile Instrument Set
                                </button>
                            </div>

                            <!-- Mini KPI Summary Bar -->
                            <div class="ster-kpi-bar px-3 pt-3 pb-3">
                                <div class="ster-kpi-grid">
                                    <div class="ster-kpi-chip">
                                        <span class="ster-kpi-label">Total Instrument Sets</span>
                                        <span class="ster-kpi-val text-indigo-600 font-bold">@activeSterilizations.Count</span>
                                    </div>
                                    <div class="ster-kpi-chip">
                                        <span class="ster-kpi-label">Sterile Verified</span>
                                        <span class="ster-kpi-val text-success font-bold">@activeSterilizations.Count(s => s.status == "STERILE")</span>
                                    </div>
                                    <div class="ster-kpi-chip">
                                        <span class="ster-kpi-label">In Processing / CSSD</span>
                                        <span class="ster-kpi-val text-warning font-bold">@activeSterilizations.Count(s => s.status == "IN_PROCESS")</span>
                                    </div>
                                    <div class="ster-kpi-chip">
                                        <span class="ster-kpi-label">Expired / Flagged</span>
                                        <span class="ster-kpi-val text-danger font-bold">@activeSterilizations.Count(s => s.status == "EXPIRED" || s.status == "CONTAMINATED")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="lc-table-container p-3">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th>INSTRUMENT SET</th>
                                            <th>METHOD</th>
                                            <th>CYCLE NUMBER</th>
                                            <th>STERILIZED BY</th>
                                            <th>STERILIZED ON</th>
                                            <th>EXPIRY DATE</th>
                                            <th>STATUS</th>
                                            <th class="text-center" style="width: 70px;">ACTION</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (activeSterilizations.Any())
                                        {
                                            @foreach (var s in activeSterilizations)
                                            {
                                                var isExpired = s.expiry_date.HasValue && s.expiry_date.Value < DateTime.Today;
                                                <tr class="lc-table-row">
                                                    <td>
                                                        <div class="font-bold text-slate-800 font-13">@s.instrument_set</div>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-indigo-subtle text-indigo-700 font-11 font-semibold border border-indigo-200">
                                                            @(s.sterilization_method ?? "AUTOCLAVE")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="font-mono font-12 fw-semibold text-slate-700 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
                                                            @(s.cycle_number ?? "-")
                                                        </span>
                                                    </td>
                                                    <td class="text-slate-700 font-12 font-medium">
                                                        @(string.IsNullOrWhiteSpace(s.sterilized_by) ? "-" : s.sterilized_by)
                                                    </td>
                                                    <td class="text-slate-600 font-12">
                                                        @s.sterilization_date.ToString("dd-MMM-yyyy")
                                                    </td>
                                                    <td>
                                                        @if (s.expiry_date.HasValue)
                                                        {
                                                            <div class="d-flex align-items-center gap-1.5">
                                                                <span class="font-12 font-semibold @(isExpired ? "text-danger" : "text-slate-700")">
                                                                    @s.expiry_date.Value.ToString("dd-MMM-yyyy")
                                                                </span>
                                                                @if (isExpired)
                                                                {
                                                                    <span class="badge bg-danger-subtle text-danger font-10">Expired</span>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-slate-400 font-12">-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge @GetSterilizationStatusBadgeClass(s.status) font-11 font-semibold">
                                                            @s.status
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn-action-del-enhanced" @onclick="() => DeleteSterilizationAsync(s.sterilization_id)" title="Remove sterilization entry">
                                                            <i class="bi bi-trash3"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="8" class="text-center p-4">
                                                    <div class="empty-ster-box text-center py-3">
                                                        <i class="bi bi-shield-x text-slate-300 fs-1 d-block mb-2"></i>
                                                        <div class="font-bold text-slate-700 fs-6">No Sterilization Records Logged</div>
                                                        <div class="text-slate-500 font-12 mb-3">Add instrument sets, autoclave cycle numbers, and expiry logs for this surgical procedure.</div>
                                                        <button type="button" class="btn-indigo-action btn-sm" @onclick="OpenAddSterilizationModal">
                                                            <i class="bi bi-plus-lg me-1"></i> Add First Instrument Set
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════ *@
                @* TAB 4: PACU / RECOVERY                                         *@
                @* ═══════════════════════════════════════════════════════════════ *@
                else if (activeTab == "RECOVERY")
                {
                    <div class="tab-section-flow">
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-hospital text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Post-Anesthesia Care Unit (PACU) / Recovery</span>
                                    @if (activeRecovery != null)
                                    {
                                        <span class="table-pill-count ms-1">1 Record</span>
                                    }
                                </div>
                                <button type="button" class="btn-indigo-action btn-sm" @onclick="OpenAddRecoveryModal">
                                    <i class="bi bi-plus-lg me-1"></i> Add Record
                                </button>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="min-width: 140px;">RECOVERY STATUS</th>
                                            <th style="min-width: 110px;">PAIN SCORE</th>
                                            <th style="min-width: 150px;">TRANSFERRED TO</th>
                                            <th style="min-width: 170px;">VITALS SUMMARY</th>
                                            <th style="min-width: 160px;">OXYGEN SUPPORT</th>
                                            <th style="min-width: 160px;">CLINICAL REMARKS</th>
                                            <th class="text-end pe-3" style="min-width: 90px;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (activeRecovery != null)
                                        {
                                            <tr class="lc-table-row">
                                                <td>
                                                    <span class="badge @GetRecoveryStatusBadgeClass(activeRecovery.recovery_status) font-11 font-semibold">
                                                        @(string.IsNullOrWhiteSpace(activeRecovery.recovery_status) ? "IN_RECOVERY" : activeRecovery.recovery_status)
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (activeRecovery.pain_score.HasValue)
                                                    {
                                                        <span class="badge @(activeRecovery.pain_score > 6 ? "bg-danger-subtle text-danger border border-danger-subtle" : (activeRecovery.pain_score > 3 ? "bg-warning-subtle text-warning border border-warning-subtle" : "bg-success-subtle text-success border border-success-subtle")) font-11 font-bold">
                                                            @activeRecovery.pain_score / 10
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-slate-400 font-12">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="font-12 font-semibold text-slate-700">
                                                        @(string.IsNullOrWhiteSpace(activeRecovery.transferred_to) ? "-" : activeRecovery.transferred_to)
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="font-12 text-slate-600" style="max-width: 180px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@activeRecovery.vitals_summary">
                                                        @(string.IsNullOrWhiteSpace(activeRecovery.vitals_summary) ? "-" : activeRecovery.vitals_summary)
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="font-12 text-slate-600" style="max-width: 160px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@activeRecovery.oxygen_support">
                                                        @(string.IsNullOrWhiteSpace(activeRecovery.oxygen_support) ? "-" : activeRecovery.oxygen_support)
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="font-12 text-slate-600" style="max-width: 160px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@activeRecovery.remarks">
                                                        @(string.IsNullOrWhiteSpace(activeRecovery.remarks) ? "-" : activeRecovery.remarks)
                                                    </span>
                                                </td>
                                                <td class="text-end pe-3">
                                                    <div class="d-inline-flex gap-1.5">
                                                        <button type="button" class="btn-action-round btn-action-view" @onclick="OpenViewRecoveryModal" title="View Recovery Details">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <button type="button" class="btn-action-round btn-action-edit" @onclick="OpenAddRecoveryModal" title="Edit Recovery Record">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center p-4 text-slate-400 italic">
                                                    <i class="bi bi-hospital fs-3 d-block mb-1 text-slate-300"></i>
                                                    No PACU / recovery record added yet. Click <strong>'+ Add Record'</strong> to record recovery details.
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════ *@
                @* TAB 5: POST-OP ORDERS                                          *@
                @* ═══════════════════════════════════════════════════════════════ *@
                else if (activeTab == "ORDERS")
                {
                    <div class="tab-section-flow">
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-card-checklist text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Post-Operative Orders</span>
                                    <span class="table-pill-count ms-1">@activeOrders.Count @(activeOrders.Count == 1 ? "Order" : "Orders")</span>
                                </div>
                                <button type="button" class="btn-indigo-action btn-sm" @onclick="OpenAddOrderModal">
                                    <i class="bi bi-plus-lg me-1"></i> Add Post-Op Order
                                </button>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th>ORDER TYPE</th>
                                            <th>ORDER DIRECTIVE</th>
                                            <th>SPECIAL INSTRUCTIONS</th>
                                            <th>STATUS</th>
                                            <th>ORDERED DATE</th>
                                            <th class="text-center" style="width: 120px;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (activeOrders.Any())
                                        {
                                            @foreach (var ord in activeOrders)
                                            {
                                                <tr class="lc-table-row">
                                                    <td><span class="badge bg-indigo-subtle text-indigo font-bold">@ord.order_type</span></td>
                                                    <td class="font-bold text-slate-800">@ord.order_text</td>
                                                    <td class="text-slate-600 font-12">@(ord.instructions ?? "-")</td>
                                                    <td>
                                                        <span class="badge @(ord.status == "COMPLETED" ? "bg-success-subtle text-success border border-success" : "bg-warning-subtle text-warning border border-warning")">
                                                            @ord.status
                                                        </span>
                                                    </td>
                                                    <td class="font-11 text-slate-500">@ord.order_date.ToString("dd-MM-yyyy hh:mm tt")</td>
                                                    <td class="text-center">
                                                        <div class="action-buttons-flex">
                                                            @if (ord.status != "COMPLETED")
                                                            {
                                                                <button type="button" class="btn-action-icon btn-action-done" @onclick='() => UpdateOrderStatus(ord.order_id, "COMPLETED")' title="Mark Completed">
                                                                    <i class="bi bi-check-lg"></i>
                                                                </button>
                                                            }
                                                            <button type="button" class="btn-action-icon btn-action-delete" @onclick="() => DeletePostOpOrder(ord.order_id)" title="Delete Order">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center p-4 text-slate-400 italic">No post-op orders recorded yet.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════ *@
                @* TAB 6: OPERATION NOTE                                          *@
                @* ═══════════════════════════════════════════════════════════════ *@
                else if (activeTab == "OPNOTE")
                {
                    <div class="tab-section-flow">
                        <div class="directory-section">
                            <div class="table-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-journal-medical text-indigo-600 fs-6"></i>
                                    <span class="table-card-heading">Formal Surgical Operation Note</span>
                                    @if (activeOpNote != null)
                                    {
                                        <span class="table-pill-count ms-1">1 Record</span>
                                    }
                                </div>
                                <button type="button" class="btn-indigo-action btn-sm" @onclick="OpenAddOpNoteModal">
                                    <i class="bi bi-plus-lg me-1"></i> @(activeOpNote != null ? "Edit Record" : "Add Record")
                                </button>
                            </div>

                            <div class="lc-table-container">
                                <table class="lc-table">
                                    <thead>
                                        <tr>
                                            <th style="min-width: 170px;">OPERATING SURGEON</th>
                                            <th style="min-width: 160px;">PROCEDURE PERFORMED</th>
                                            <th style="min-width: 150px;">PRE-OP DIAGNOSIS</th>
                                            <th style="min-width: 150px;">POST-OP DIAGNOSIS</th>
                                            <th style="min-width: 110px;">BLOOD LOSS</th>
                                            <th style="min-width: 150px;">COMPLICATIONS</th>
                                            <th class="text-end pe-3" style="min-width: 90px;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (activeOpNote != null)
                                        {
                                            var surgeonName = activeOpNote.surgeon_dcode.HasValue ? GetDoctorName(activeOpNote.surgeon_dcode.Value) : (selectedRequest.dcode > 0 ? GetDoctorName(selectedRequest.dcode) : "Operating Surgeon");
                                            <tr class="lc-table-row">
                                                <td>
                                                    <div class="d-flex align-items-center gap-1.5 font-12 font-semibold text-slate-800">
                                                        <i class="bi bi-person-badge text-indigo-600"></i>
                                                        <span>Dr. @surgeonName</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="font-12 font-bold text-indigo-700">
                                                        @(string.IsNullOrWhiteSpace(activeOpNote.procedure_performed) ? selectedRequest.procedure_name : activeOpNote.procedure_performed)
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="font-12 text-slate-700" style="max-width: 160px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@activeOpNote.pre_op_diagnosis">
                                                        @(string.IsNullOrWhiteSpace(activeOpNote.pre_op_diagnosis) ? (selectedRequest.diagnosis ?? "-") : activeOpNote.pre_op_diagnosis)
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="font-12 text-slate-700" style="max-width: 160px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@activeOpNote.post_op_diagnosis">
                                                        @(string.IsNullOrWhiteSpace(activeOpNote.post_op_diagnosis) ? "-" : activeOpNote.post_op_diagnosis)
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (activeOpNote.blood_loss_ml.HasValue)
                                                    {
                                                        <span class="badge @(activeOpNote.blood_loss_ml > 200 ? "bg-amber-100 text-amber-800 border border-amber-300" : "bg-slate-100 text-slate-700") font-11 font-bold">
                                                            @activeOpNote.blood_loss_ml mL
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-slate-400 font-12">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="font-12 text-slate-600" style="max-width: 150px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@activeOpNote.complications">
                                                        @(string.IsNullOrWhiteSpace(activeOpNote.complications) ? "None" : activeOpNote.complications)
                                                    </span>
                                                </td>
                                                <td class="text-end pe-3">
                                                    <div class="d-inline-flex gap-1.5">
                                                        <button type="button" class="btn-action-round btn-action-view" @onclick="OpenViewOpNoteModal" title="View Operation Note Details">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <button type="button" class="btn-action-round btn-action-edit" @onclick="OpenAddOpNoteModal" title="Edit Operation Note">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center p-4 text-slate-400 italic">
                                                    <i class="bi bi-journal-medical fs-3 d-block mb-1 text-slate-300"></i>
                                                    No formal surgical operation note recorded yet. Click <strong>'+ Add Record'</strong> to document operative details.
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- 4. MODAL DIALOGS                                                          -->
<!-- ========================================================================= -->

@* --- 0. SURGERY CASES DIRECTORY MODAL --- *@
@if (showCasesModal)
{
    <div class="modal-overlay" @onclick="() => showCasesModal = false">
        <div class="modal-form-card" style="max-width: 850px;" @onclick:stopPropagation>
            <div class="modal-header-bar">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-folder2-open text-indigo-600 fs-5"></i>
                    <h3>Surgery Cases Directory</h3>
                    <span class="table-pill-count ms-2">@FilteredRequests.Count() Cases</span>
                </div>
                <button type="button" class="modal-close-btn" @onclick="() => showCasesModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <!-- Status Filter Pills -->
                <div class="sched-filter-group mb-3">
                    <button type="button" class="sched-filter-pill @(statusFilter == null ? "active-all" : "")" @onclick='() => SetStatusFilter(null)'>
                        <span>All Cases</span>
                        <span class="sched-filter-badge">@allRequests.Count</span>
                    </button>
                    <button type="button" class="sched-filter-pill @(statusFilter == "REQUESTED" ? "active-pending" : "")" @onclick='() => SetStatusFilter("REQUESTED")'>
                        <span>Requested</span>
                        <span class="sched-filter-badge">@allRequests.Count(r => r.status == "REQUESTED")</span>
                    </button>
                    <button type="button" class="sched-filter-pill @(statusFilter == "SCHEDULED" ? "active-all" : "")" @onclick='() => SetStatusFilter("SCHEDULED")'>
                        <span>Scheduled</span>
                        <span class="sched-filter-badge">@allRequests.Count(r => r.status == "SCHEDULED")</span>
                    </button>
                    <button type="button" class="sched-filter-pill @(statusFilter == "IN_PROGRESS" ? "active-all" : "")" @onclick='() => SetStatusFilter("IN_PROGRESS")'>
                        <span>In Surgery</span>
                        <span class="sched-filter-badge">@allRequests.Count(r => r.status == "IN_PROGRESS")</span>
                    </button>
                    <button type="button" class="sched-filter-pill @(statusFilter == "COMPLETED" ? "active-completed" : "")" @onclick='() => SetStatusFilter("COMPLETED")'>
                        <span>Completed</span>
                        <span class="sched-filter-badge">@allRequests.Count(r => r.status == "COMPLETED")</span>
                    </button>
                </div>

                <!-- Cases List Table -->
                <div class="lc-table-container" style="max-height: 420px;">
                    <table class="lc-table">
                        <thead>
                            <tr>
                                <th>PATIENT</th>
                                <th>PROCEDURE</th>
                                <th>SURGEON</th>
                                <th>PRIORITY</th>
                                <th>STATUS</th>
                                <th class="text-end">FEE</th>
                                <th class="text-center" style="width: 100px;">SELECT</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FilteredRequests.Any())
                            {
                                @foreach (var req in FilteredRequests)
                                {
                                    var isSelected = selectedRequest?.request_id == req.request_id;
                                    var patName = GetPatientName(req.custid);
                                    var docName = GetDoctorName(req.dcode);
                                    <tr class="lc-table-row @(isSelected ? "selected-case-row" : "")">
                                        <td>
                                            <div class="font-bold text-slate-800">@patName</div>
                                            <div class="font-mono font-11 text-slate-500">#@req.custid.ToString("0")</div>
                                        </td>
                                        <td>
                                            <div class="font-bold text-indigo-600">@req.procedure_name</div>
                                            <div class="font-11 text-slate-500">@(req.expected_duration_minutes ?? 60)m | @(req.anesthesia_type ?? "GA")</div>
                                        </td>
                                        <td class="text-slate-700 font-12">Dr. @docName</td>
                                        <td><span class="badge @GetPriorityBadgeClass(req.priority)">@req.priority</span></td>
                                        <td><span class="badge @GetStatusBadgeClass(req.status)">@req.status</span></td>
                                        <td class="text-end font-mono font-bold text-slate-800">₹@(req.procedure_fee?.ToString("N2") ?? "0.00")</td>
                                        <td class="text-center">
                                            <button type="button" class="btn-indigo-action btn-sm" @onclick="() => SelectCaseFromModal(req)">
                                                @(isSelected ? "Active" : "Select")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center p-4 text-slate-400 italic">No surgery cases matching the criteria.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer-bar">
                <button type="button" class="btn-secondary-outline" @onclick="() => showCasesModal = false">Close</button>
            </div>
        </div>
    </div>
}

@* --- 1. SCHEDULE OT SLOT MODAL --- *@
@if (showScheduleModal && selectedRequest != null)
{
    <div class="modal-overlay">
        <div class="modal-form-card preop-modal-dialog" style="max-width: 600px !important;" @onclick:stopPropagation>
            <div class="modal-header-bar preop-modal-header">
                <div>
                    <h3 class="m-0 font-bold text-slate-900" style="font-size: 1.15rem;">Schedule OT Slot</h3>
                    <div class="text-slate-600 font-12 font-medium mt-1">
                        Case: <strong class="text-slate-800">#@selectedRequest.custid.ToString("0")</strong> • @selectedRequest.procedure_name
                    </div>
                </div>
                <button type="button" class="preop-close-btn" @onclick="() => showScheduleModal = false" title="Close dialog">&times;</button>
            </div>
            <div class="modal-body preop-modal-body">
                <div class="preop-form-field mb-3">
                    <label class="nt-form-label">Select Operation Theater Suite <span class="text-danger">*</span></label>
                    <select class="nt-select-control" @bind="schedOtId">
                        <option value="@Guid.Empty">-- Select OT Theater Suite --</option>
                        @foreach (var ot in otTheaters)
                        {
                            <option value="@ot.ot_id">@ot.ot_name (@(ot.specialty ?? "GENERAL")) - @(ot.location ?? "Main Floor")</option>
                        }
                    </select>
                </div>

                <div class="preop-form-field mb-3">
                    <label class="nt-form-label">Scheduled Date <span class="text-danger">*</span></label>
                    <input type="date" class="nt-input-control consent-input-text" @bind="schedDate" />
                </div>

                <div class="preop-form-grid-2col">
                    <div class="preop-form-field">
                        <label class="nt-form-label">Start Time <span class="text-danger">*</span></label>
                        <input type="time" class="nt-input-control consent-input-text" @bind="schedTime" step="60" />
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">Estimated End Time <span class="text-danger">*</span></label>
                        <input type="time" class="nt-input-control consent-input-text" @bind="schedEndTime" step="60" />
                    </div>
                </div>

                <div class="preop-form-field">
                    <label class="nt-form-label">Scheduling Notes</label>
                    <input type="text" class="nt-input-control consent-input-text" @bind="schedNotes" placeholder="e.g. First case of the day, laparoscopy tower booked" />
                </div>
            </div>
            <div class="modal-footer-bar preop-modal-footer">
                <button type="button" class="preop-btn-cancel" @onclick="() => showScheduleModal = false">Cancel</button>
                <button type="button" class="preop-btn-save" @onclick="SaveScheduleAsync">
                    <i class="bi bi-calendar-check"></i> Confirm Slot Booking
                </button>
            </div>
        </div>
    </div>
}

@* --- 2. ADD TEAM MEMBER MODAL --- *@
@if (showAddTeamModal && selectedRequest != null)
{
    <div class="modal-overlay">
        <div class="modal-form-card team-modal-dialog" style="max-width: 620px;" @onclick:stopPropagation>
            <div class="modal-header-bar team-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="team-header-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <h3 class="team-modal-title">Add Surgical Team Members</h3>
                        <p class="team-modal-subtitle">Assign surgeons, anesthetists, nurses, or OT staff to this case</p>
                    </div>
                </div>
                <button type="button" class="team-close-btn" @onclick="() => showAddTeamModal = false" title="Close dialog">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Segmented Mode Control -->
            <div class="team-tabs-container">
                <div class="team-modal-tabs">
                    <button type="button" class="team-modal-tab @(teamSourceMode == "DOCTORS" ? "active" : "")" @onclick='() => teamSourceMode = "DOCTORS"'>
                        <i class="bi bi-person-badge"></i>
                        <span>Doctor Masters</span>
                        <span class="team-tab-badge">@doctorsList.Count</span>
                    </button>
                    <button type="button" class="team-modal-tab @(teamSourceMode == "NURSES" ? "active" : "")" @onclick='() => teamSourceMode = "NURSES"'>
                        <i class="bi bi-heart-pulse"></i>
                        <span>Nurse Masters</span>
                        <span class="team-tab-badge">@nursesList.Count</span>
                    </button>
                    <button type="button" class="team-modal-tab @(teamSourceMode == "CUSTOM" ? "active" : "")" @onclick='() => teamSourceMode = "CUSTOM"'>
                        <i class="bi bi-person-plus"></i>
                        <span>Custom Staff</span>
                    </button>
                </div>
            </div>

            <div class="modal-body pt-1 pb-3 px-4">
                @if (teamSourceMode == "DOCTORS")
                {
                    <div class="team-field-group mb-3">
                        <label class="team-field-label">
                            <i class="bi bi-shield-check text-indigo-600 me-1"></i>
                            Role in Surgery for Selected Doctor(s) <span class="text-danger">*</span>
                        </label>
                        <select class="form-select team-select-control" @bind="teamRole">
                            <option value="SURGEON">SURGEON (Primary)</option>
                            <option value="ASSISTANT_SURGEON">ASSISTANT SURGEON</option>
                            <option value="ANESTHETIST">ANESTHETIST</option>
                            <option value="CO_SURGEON">CO-SURGEON</option>
                            <option value="CONSULTANT">CONSULTANT / SPECIALIST</option>
                            <option value="PAEDIATRICIAN">PAEDIATRICIAN</option>
                        </select>
                    </div>

                    <div class="team-field-group mb-2">
                        <label class="team-field-label">
                            <i class="bi bi-search text-indigo-600 me-1"></i>
                            Search &amp; Select Doctors <span class="text-danger">*</span>
                        </label>
                        <div class="team-search-wrap">
                            <i class="bi bi-search team-search-icon"></i>
                            <input type="text" class="team-search-input" placeholder="Search doctor by name, qualification, or code..." @bind="teamDoctorSearch" @bind:event="oninput" />
                            @if (!string.IsNullOrWhiteSpace(teamDoctorSearch))
                            {
                                <button type="button" class="team-search-clear" @onclick='() => teamDoctorSearch = ""' title="Clear search">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="team-selection-toolbar">
                        <div class="team-selection-count">
                            <span class="team-count-badge">@selectedDoctorCodes.Count</span>
                            <span>of <strong>@FilteredDoctorsForTeam.Count()</strong> doctors selected</span>
                        </div>
                        <div class="team-selection-actions">
                            <button type="button" class="team-action-btn" @onclick="SelectAllDoctorsForTeam" title="Select all filtered doctors">
                                <i class="bi bi-check-all"></i> Select All
                            </button>
                            <button type="button" class="team-action-btn clear-btn" @onclick="ClearSelectedDoctorsForTeam" disabled="@(selectedDoctorCodes.Count == 0)" title="Clear selection">
                                <i class="bi bi-x"></i> Clear
                            </button>
                        </div>
                    </div>

                    <div class="team-master-list-box">
                        @if (FilteredDoctorsForTeam.Any())
                        {
                            @foreach (var doc in FilteredDoctorsForTeam)
                            {
                                var isChecked = selectedDoctorCodes.Contains(doc.dcode);
                                var docDisplayName = string.IsNullOrWhiteSpace(doc.name) ? (doc.doctorfullname ?? $"Doctor #{doc.dcode}") : doc.name;
                                var qualificationText = string.IsNullOrWhiteSpace(doc.qualification) ? (doc.description ?? "Doctor") : doc.qualification;
                                <label class="team-master-item @(isChecked ? "selected-item" : "")">
                                    <div class="team-checkbox-wrap">
                                        <input type="checkbox" class="team-custom-checkbox" checked="@isChecked" @onchange="e => ToggleDoctorSelection(doc.dcode, e.Value)" />
                                    </div>
                                    <div class="team-master-avatar doc-avatar">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <div class="team-master-info">
                                        <div class="team-master-name-row">
                                            <span class="team-master-name">Dr. @docDisplayName</span>
                                        </div>
                                        <div class="team-master-meta-row">
                                            <span class="team-meta-spec">@qualificationText</span>
                                            <span class="team-meta-divider">•</span>
                                            <span class="team-code-pill">DOC#@doc.dcode</span>
                                        </div>
                                    </div>
                                    @if (isChecked)
                                    {
                                        <div class="team-item-check-indicator">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </div>
                                    }
                                </label>
                            }
                        }
                        else
                        {
                            <div class="team-empty-state">
                                <div class="team-empty-icon"><i class="bi bi-person-x"></i></div>
                                <h6>No doctors found</h6>
                                <p>No doctors match the search filter "@teamDoctorSearch"</p>
                                @if (!string.IsNullOrWhiteSpace(teamDoctorSearch))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary mt-1" @onclick='() => teamDoctorSearch = ""'>Reset Search</button>
                                }
                            </div>
                        }
                    </div>
                }
                else if (teamSourceMode == "NURSES")
                {
                    <div class="team-field-group mb-3">
                        <label class="team-field-label">
                            <i class="bi bi-shield-check text-indigo-600 me-1"></i>
                            Role in Surgery for Selected Nurse(s) <span class="text-danger">*</span>
                        </label>
                        <select class="form-select team-select-control" @bind="teamNurseRole">
                            <option value="SCRUB_NURSE">SCRUB NURSE</option>
                            <option value="CIRCULATING_NURSE">CIRCULATING NURSE</option>
                            <option value="OT_NURSE">OT NURSE</option>
                            <option value="RECOVERY_NURSE">RECOVERY / PACU NURSE</option>
                            <option value="ANESTHESIA_NURSE">ANESTHESIA NURSE</option>
                            <option value="ASSISTANT_NURSE">ASSISTANT NURSE</option>
                        </select>
                    </div>

                    <div class="team-field-group mb-2">
                        <label class="team-field-label">
                            <i class="bi bi-search text-indigo-600 me-1"></i>
                            Search &amp; Select Nurses <span class="text-danger">*</span>
                        </label>
                        <div class="team-search-wrap">
                            <i class="bi bi-search team-search-icon"></i>
                            <input type="text" class="team-search-input" placeholder="Search nurse by name, code, or short name..." @bind="teamNurseSearch" @bind:event="oninput" />
                            @if (!string.IsNullOrWhiteSpace(teamNurseSearch))
                            {
                                <button type="button" class="team-search-clear" @onclick='() => teamNurseSearch = ""' title="Clear search">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="team-selection-toolbar">
                        <div class="team-selection-count">
                            <span class="team-count-badge nurse-badge">@selectedNurseCodes.Count</span>
                            <span>of <strong>@FilteredNursesForTeam.Count()</strong> nurses selected</span>
                        </div>
                        <div class="team-selection-actions">
                            <button type="button" class="team-action-btn" @onclick="SelectAllNursesForTeam" title="Select all filtered nurses">
                                <i class="bi bi-check-all"></i> Select All
                            </button>
                            <button type="button" class="team-action-btn clear-btn" @onclick="ClearSelectedNursesForTeam" disabled="@(selectedNurseCodes.Count == 0)" title="Clear selection">
                                <i class="bi bi-x"></i> Clear
                            </button>
                        </div>
                    </div>

                    <div class="team-master-list-box">
                        @if (FilteredNursesForTeam.Any())
                        {
                            @foreach (var nurse in FilteredNursesForTeam)
                            {
                                var isChecked = selectedNurseCodes.Contains(nurse.ncode);
                                var nurseDisplayName = string.IsNullOrWhiteSpace(nurse.nursename) ? (nurse.shortname ?? $"Nurse #{nurse.ncode}") : nurse.nursename;
                                var designationText = string.IsNullOrWhiteSpace(nurse.shortname) ? "Nursing Staff" : nurse.shortname;
                                <label class="team-master-item nurse-item @(isChecked ? "selected-item" : "")">
                                    <div class="team-checkbox-wrap">
                                        <input type="checkbox" class="team-custom-checkbox" checked="@isChecked" @onchange="e => ToggleNurseSelection(nurse.ncode, e.Value)" />
                                    </div>
                                    <div class="team-master-avatar nurse-avatar">
                                        <i class="bi bi-heart-pulse-fill"></i>
                                    </div>
                                    <div class="team-master-info">
                                        <div class="team-master-name-row">
                                            <span class="team-master-name">@nurseDisplayName</span>
                                        </div>
                                        <div class="team-master-meta-row">
                                            <span class="team-meta-spec">@designationText</span>
                                            <span class="team-meta-divider">•</span>
                                            <span class="team-code-pill">NURSE#@nurse.ncode</span>
                                        </div>
                                    </div>
                                    @if (isChecked)
                                    {
                                        <div class="team-item-check-indicator nurse-check">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </div>
                                    }
                                </label>
                            }
                        }
                        else
