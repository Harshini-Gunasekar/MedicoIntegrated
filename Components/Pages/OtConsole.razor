    }

    private string? GetIpNumber(Guid? ipId, decimal custid)
    {
        if (ipId.HasValue && ipId.Value != Guid.Empty)
        {
            var match = activeIpRegistrations.FirstOrDefault(x => x.ip_id == ipId.Value);
            if (match != null && !string.IsNullOrWhiteSpace(match.ip_no)) return match.ip_no;
        }
        var matchByCust = activeIpRegistrations.FirstOrDefault(x => x.custid == custid);
        if (matchByCust != null && !string.IsNullOrWhiteSpace(matchByCust.ip_no)) return matchByCust.ip_no;

        var matchedRef = ipOtReferrals.FirstOrDefault(x => (ipId.HasValue && x.ip_id == ipId.Value) || x.custid == custid);
        if (matchedRef != null && !string.IsNullOrWhiteSpace(matchedRef.ip_no)) return matchedRef.ip_no;

        return null;
    }

