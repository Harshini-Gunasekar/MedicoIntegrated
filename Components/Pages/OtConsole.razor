                                                        </div>
                                                    </td>
                                                    <td style="text-align: center;">
                                                        @if (string.Equals(selectedRequest.status, "SCHEDULED", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge" style="background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-weight: 700; padding: 4px 12px; border-radius: 9999px; font-size: 0.72rem; letter-spacing: 0.3px;">SCHEDULED</span>
                                                        }
                                                        else if (string.Equals(selectedRequest.status, "COMPLETED", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge" style="background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; font-weight: 700; padding: 4px 12px; border-radius: 9999px; font-size: 0.72rem; letter-spacing: 0.3px;">COMPLETED</span>
                                                        }
                                                        else if (string.Equals(selectedRequest.status, "CANCELLED", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge" style="background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; font-weight: 700; padding: 4px 12px; border-radius: 9999px; font-size: 0.72rem; letter-spacing: 0.3px;">CANCELLED</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge" style="background: #fffbeb; color: #b45309; border: 1px solid #fde68a; font-weight: 700; padding: 4px 12px; border-radius: 9999px; font-size: 0.72rem; letter-spacing: 0.3px;">@(string.IsNullOrWhiteSpace(selectedRequest.status) ? "REQUESTED" : selectedRequest.status.ToUpperInvariant())</span>
                                                        }
                                                    </td>
                                                    <td style="text-align: center;">
                                                        <button type="button" class="lc-circle-btn-32" @onclick="OpenEditRequestModal" title="Edit Surgery Request" style="margin: 0 auto; width: 32px; height: 32px; border-radius: 8px; border: 1px solid #cbd5e1; background: #ffffff; color: #0284c7; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;">
                                                            <i class="bi bi-pencil-square" style="font-size: 0.9rem;"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

