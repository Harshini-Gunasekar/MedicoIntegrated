    private async Task CreateAndAddChecklistMasterAsync()
    {
        if (selectedRequest == null) return;
        if (string.IsNullOrWhiteSpace(newChecklistLabel))
        {
            ToastService.ShowWarning("Please enter a checklist item description.");
            return;
        }

        try
        {
            // 1. Add template to Master
            var masterReq = new AddOtChecklistMasterRequest
            {
                item_label = newChecklistLabel.Trim(),
                category = newChecklistCategory,
                is_active = true
            };
            var masterRes = await OtService.AddChecklistMasterAsync(masterReq);

            // 2. Refresh master list to fetch generated master id
            checklistMasters = await OtService.GetChecklistMastersAsync(true) ?? new();
            var matchedMaster = checklistMasters.FirstOrDefault(m => string.Equals(m.item_label?.Trim(), newChecklistLabel.Trim(), StringComparison.OrdinalIgnoreCase))
                                ?? checklistMasters.LastOrDefault();

            if (matchedMaster != null)
            {
                // 3. Save into current request checklist items
                var itemReq = new SaveOtChecklistItemRequest
                {
                    request_id = selectedRequest.request_id,
                    item_master_id = matchedMaster.item_master_id,
                    is_checked = newChecklistInitialChecked,
                    checked_by = string.IsNullOrWhiteSpace(newChecklistCheckedBy) ? chkCheckedBy : newChecklistCheckedBy,
                    remarks = newChecklistRemarks
                };
                await OtService.SaveChecklistItemAsync(itemReq);

                // 4. Reload custom checklist items for this case
                activeCustomChecklistItems = await OtService.GetChecklistItemsByRequestAsync(selectedRequest.request_id) ?? new();
                ToastService.ShowSuccess("Checklist item created and added to checklist!");
                showAddChecklistItemModal = false;
            }
            else
            {
                ToastService.ShowSuccess("Master item created.");
                showAddChecklistItemModal = false;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error adding checklist item: {ex.Message}");
        }
    }

