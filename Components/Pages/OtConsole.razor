    private string GetAdvanceTransactionType(HmsAdvanceLedgerRow row)
    {
        if (advanceResolvedTransactionTypes.TryGetValue(row, out var resolvedType))
        {
            return resolvedType;
        }

        var rawType = (row.transaction_type ?? "").ToUpper().Trim();

        return rawType switch
        {
            "DEPOSIT"  => "DEPOSIT",
            "REFUND"   => "REFUNDED",
            "REFUNDED" => "REFUNDED",
            "USED"     => "USED",
            "USE"      => "USED",
            _          => string.IsNullOrEmpty(rawType) ? "DEPOSIT" : rawType
        };
    }

    private double GetAdvanceTotalDeposited()
    {
        if (advanceSummary?.ledger != null && advanceSummary.ledger.Count > 0)
        {
            return advanceSummary.ledger
                .Where(r => GetAdvanceTransactionType(r) == "DEPOSIT")
                .Sum(r => r.receiptamount);
        }
        return advanceSummary?.total_advance_deposited ?? 0;
    }

    private double GetAdvanceTotalUsed()
    {
        if (advanceSummary?.ledger != null && advanceSummary.ledger.Count > 0)
        {
            return advanceSummary.ledger
                .Where(r => GetAdvanceTransactionType(r) == "USED")
                .Sum(r => r.receiptamount);
        }
        return advanceSummary?.total_advance_used ?? 0;
    }

    private double GetAdvanceTotalRefunded()
    {
        if (advanceSummary?.ledger != null && advanceSummary.ledger.Count > 0)
        {
            return advanceSummary.ledger
                .Where(r => GetAdvanceTransactionType(r) == "REFUNDED")
                .Sum(r => r.receiptamount);
        }
        return advanceSummary?.total_advance_refunded ?? 0;
    }

    private double GetAdvanceAvailableBalance()
    {
        return Math.Max(0, GetAdvanceTotalDeposited() - GetAdvanceTotalUsed() - GetAdvanceTotalRefunded());
    }

    private string FormatIstDateTime(DateTime dt)
    {
        DateTime utc = dt.Kind == DateTimeKind.Utc ? dt : DateTime.SpecifyKind(dt, DateTimeKind.Utc);
        try
        {
            TimeZoneInfo istZone = TimeZoneInfo.FindSystemTimeZoneById("India Standard Time");
            return TimeZoneInfo.ConvertTimeFromUtc(utc, istZone).ToString("dd-MMM-yyyy hh:mm tt");
        }
        catch
        {
            try
            {
                TimeZoneInfo istZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata");
                return TimeZoneInfo.ConvertTimeFromUtc(utc, istZone).ToString("dd-MMM-yyyy hh:mm tt");
            }
            catch
            {
                return utc.AddHours(5).AddMinutes(30).ToString("dd-MMM-yyyy hh:mm tt");
            }
        }
    }

