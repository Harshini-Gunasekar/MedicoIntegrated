                                                                <input type="number" class="form-control form-control-sm" style="width: 55px; min-width: 50px; text-align: center; border-radius: 6px; border-color: #cbd5e1; font-size: 0.82rem; height: 34px; font-weight: 700; padding: 2px; box-shadow: none;" @bind="opBloodLoss" />
                                                                <span style="font-size: 0.72rem; color: #64748b; font-weight: 600; flex-shrink: 0;">ml</span>
