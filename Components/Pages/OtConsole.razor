    protected override async Task OnParametersSetAsync()
    {
        if (RequestId.HasValue && RequestId.Value != Guid.Empty && allRequests != null && allRequests.Any())
        {
            if (selectedRequest == null || selectedRequest.request_id != RequestId.Value)
            {
                var matched = allRequests.FirstOrDefault(r => r.request_id == RequestId.Value);
                if (matched != null)
                {
                    await SelectCase(matched);
                    StateHasChanged();
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                await LoadDoctorsAsync();
                await LoadNursesAsync();
                await LoadTheatersAsync();
                await LoadRequestsAsync();
                await LoadItemsAsync();
                await LoadStocksAsync();
                await LoadUomsAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading console initial data: {ex.Message}");
            }
        }
    }

    private void HandlePageClick()
    {
        isCaseDropdownOpen = false;
    }

    private void ClearSearch()
    {
        searchQuery = "";
        isCaseDropdownOpen = false;
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            isCaseDropdownOpen = false;
        }
    }

    private void OpenCasesModal()
    {
        showCasesModal = true;
        isCaseDropdownOpen = false;
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "OT";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0].Length >= 2 ? parts[0].Substring(0, 2).ToUpper() : parts[0].ToUpper();
        return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();
    }

    private async Task LoadDoctorsAsync()
    {
        try
        {
            doctorsList = await DoctorService.GetDoctorsAsync() ?? new();
        }
        catch { doctorsList = new(); }
    }

    private async Task LoadNursesAsync()
    {
        try
        {
            nursesList = await NurseMasterService.GetNurseMastersAsync() ?? new();
        }
        catch { nursesList = new(); }
    }

    private string GetPatientName(decimal custId)
    {
        var req = (allRequests ?? new()).FirstOrDefault(r => r.custid == custId);
        if (req != null && !string.IsNullOrWhiteSpace(req.patient_name))
        {
            return req.patient_name.Trim();
        }
        return $"Patient #{custId:0}";
    }

    private string GetCurrentUserName()
    {
        if (!string.IsNullOrWhiteSpace(TenantState?.UserData?.UserName))
        {
            return TenantState.UserData.UserName.Trim();
        }
        return "Staff";
    }

    private string GetDoctorName(int dcode)
    {
        var req = (allRequests ?? new()).FirstOrDefault(r => r.dcode == dcode);
        if (req != null && !string.IsNullOrWhiteSpace(req.doctor_name))
        {
            return req.doctor_name.Trim();
        }
        var doc = (doctorsList ?? new()).FirstOrDefault(d => d.dcode == dcode);
        if (doc != null)
        {
            return string.IsNullOrWhiteSpace(doc.name) ? (doc.doctorfullname ?? dcode.ToString()) : doc.name;
        }
        return dcode.ToString();
    }

    private async Task LoadTheatersAsync()
    {
        try
        {
            otTheaters = await OtService.GetOtMastersAsync(activeOnly: false) ?? new();
        }
        catch { otTheaters = new(); }
    }

    private async Task LoadRequestsAsync()
    {
        isLoadingRequests = true;
        try
        {
            allRequests = await OtService.GetSurgeryRequestsAsync() ?? new();
            if (RequestId.HasValue && RequestId.Value != Guid.Empty)
            {
                var matched = allRequests.FirstOrDefault(r => r.request_id == RequestId.Value);
                if (matched != null)
                {
                    await SelectCase(matched);
                }
                else if (allRequests.Any())
                {
                    await SelectCase(allRequests.First());
                }
            }
            else if (selectedRequest != null)
            {
                var refreshed = allRequests.FirstOrDefault(r => r.request_id == selectedRequest.request_id);
                if (refreshed != null) selectedRequest = refreshed;
            }
            else if (allRequests.Any())
            {
                await SelectCase(allRequests.First());
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading requests: {ex.Message}");
            allRequests = new();
        }
        finally
        {
            isLoadingRequests = false;
        }
    }

    private IEnumerable<OtSurgeryRequestListModel> FilteredRequests =>
        allRequests.Where(r => {
            if (statusFilter != null && r.status != statusFilter) return false;
            if (string.IsNullOrWhiteSpace(searchQuery)) return true;
            var q = searchQuery.Trim();
            var pat = !string.IsNullOrWhiteSpace(r.patient_name) ? r.patient_name : GetPatientName(r.custid);
            var doc = !string.IsNullOrWhiteSpace(r.doctor_name) ? r.doctor_name : GetDoctorName(r.dcode);

            return r.custid.ToString().Contains(q) ||
                   r.dcode.ToString().Contains(q) ||
                   pat.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                   doc.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                   (r.procedure_name != null && r.procedure_name.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                   (r.diagnosis != null && r.diagnosis.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                   (r.mobile != null && r.mobile.Contains(q, StringComparison.OrdinalIgnoreCase));
        });

    private void SetStatusFilter(string? status)
    {
        statusFilter = status;
    }

    private async Task SelectCase(OtSurgeryRequestListModel req)
    {
        selectedRequest = req;
        await LoadCaseDataAsync(req.request_id);
    }

    private async Task SelectCaseFromDropdown(OtSurgeryRequestListModel req)
    {
        isCaseDropdownOpen = false;
        searchQuery = "";
        await SelectCase(req);
    }

    private async Task SelectCaseFromModal(OtSurgeryRequestListModel req)
    {
        showCasesModal = false;
        await SelectCase(req);
    }

    private async Task SetTab(string tab)
    {
        activeTab = tab;
        if (tab == "SUMMARY" && selectedRequest != null)
        {
