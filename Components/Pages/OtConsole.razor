                                                                    <span style="color: #94a3b8; font-weight: 700; font-size: 0.85rem; flex-shrink: 0;">-</span>
                                                                    <input type="time" class="form-control form-control-sm" style="width: 102px; min-width: 95px; height: 34px; border-radius: 6px; border-color: #cbd5e1; font-size: 0.8rem; font-family: monospace; font-weight: 600; padding: 2px 4px; text-align: center; box-shadow: none;" @bind="schedEndTime" />
                                                                </div>
                                                            </td>
                                                            <td style="text-align: center; white-space: nowrap;">
