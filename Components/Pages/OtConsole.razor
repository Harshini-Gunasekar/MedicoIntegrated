                    <div class="team-field-group mb-3">
                        <label class="team-field-label">
                            <i class="bi bi-person text-indigo-600 me-1"></i>
                            Staff / Member Name <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="team-input-control" @bind="teamStaffName" placeholder="e.g. Technician Rajesh" required />
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6 team-field-group">
                            <label class="team-field-label">
                                <i class="bi bi-card-heading text-indigo-600 me-1"></i>
