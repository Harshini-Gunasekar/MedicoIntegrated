    #region Helper CSS Formatters

    private string GetSterilizationStatusBadgeClass(string? status)
    {
        return (status?.ToUpperInvariant()) switch
        {
            "STERILE" => "bg-success-subtle text-success border border-success-subtle",
            "IN_PROCESS" => "bg-warning-subtle text-warning border border-warning-subtle",
            "EXPIRED" => "bg-danger-subtle text-danger border border-danger-subtle",
            "CONTAMINATED" => "bg-danger text-white",
            _ => "bg-secondary-subtle text-secondary"
        };
    }

    private string GetRecoveryStatusBadgeClass(string? status)
    {
        return (status?.ToUpperInvariant()) switch
        {
            "STABLE" => "bg-success-subtle text-success border border-success-subtle",
            "IN_RECOVERY" => "bg-primary-subtle text-primary border border-primary-subtle",
            "TRANSFERRED" => "bg-purple-subtle text-purple border border-purple-subtle",
            "DISCHARGED" => "bg-teal-subtle text-teal-800 border border-teal-subtle",
            _ => "bg-secondary-subtle text-secondary"
        };
    }

    private string GetPriorityBadgeClass(string? priority)
    {
        return priority switch
        {
            "EMERGENCY" => "bg-danger text-white",
            "URGENT" => "bg-warning text-dark",
            _ => "bg-primary-subtle text-primary"
        };
    }

    private string GetStatusBadgeClass(string? status)
    {
        return status switch
        {
            "REQUESTED" => "bg-warning-subtle text-warning border border-warning",
            "SCHEDULED" => "bg-info-subtle text-info border border-info",
            "IN_PROGRESS" => "bg-purple-subtle text-purple border border-purple",
            "COMPLETED" => "bg-success-subtle text-success border border-success",
            "CANCELLED" => "bg-danger-subtle text-danger border border-danger",
            _ => "bg-secondary-subtle text-secondary"
        };
    }

    private string GetFitnessBadgeClass(string? fitness)
    {
        return fitness switch
        {
            "FIT" => "bg-success-subtle text-success",
            "FIT_WITH_RESTRICTIONS" => "bg-warning-subtle text-warning",
            "NOT_FIT" => "bg-danger-subtle text-danger",
            _ => "bg-secondary-subtle text-secondary"
        };
    }

