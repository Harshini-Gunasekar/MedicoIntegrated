                                                                </div>
                                                                <button type="button" @onclick="StartAddNewIntraOpInline"
                                                                        style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: linear-gradient(135deg, #059669 0%, #034f75 100%); color: #ffffff; font-weight: 700; font-size: 0.82rem; padding: 7px 24px; border-radius: 9999px; border: none; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25); cursor: pointer; transition: all 0.2s ease;">
                                                                    <i class="bi bi-heart-pulse-fill" style="font-size: 0.95rem;"></i>
                                                                    <span>Log Intra-OP Surgery Record</span>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                @if (!isAddingIntraOpInline && activeIntraOps.Any())
                                {
                                    <div style="display: flex; justify-content: center; align-items: center; width: 100%; padding-top: 32px; padding-bottom: 24px; text-align: center;">
                                        <button type="button" class="btn-card-edit-action" @onclick="StartAddNewIntraOpInline" style="padding: 0.5rem 1.4rem; font-size: 0.84rem; gap: 0.5rem;">
                                            <i class="bi bi-plus-circle me-1" style="font-size: 0.95rem;"></i> Add Intra-OP Record
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        @* ═══════════════════════════════════════════════════════════════════ *@
                        @* TAB 6: STERIALISATION                                           *@
                        @* ═══════════════════════════════════════════════════════════════════ *@
                        else if (activeTab == "STERILIZATION")
                        {
                            <div class="tab-section-flow">
                                <!-- Section Header matching Schedule Table UI -->
                                <div class="clinical-section-header mb-3">
                                    <div class="clinical-section-title">
                                        <div class="section-icon-badge" style="background: #ecfeff; color: #0891b2;">
                                            <i class="bi bi-shield-check-fill"></i>
                                        </div>
                                        <div>
                                            <h4 class="section-main-heading">5. Sterilization &amp; CSSD Autoclaving Records</h4>
                                            <span class="section-sub-heading">Autoclave batching, method, cycle verification, sterility status &amp; expiry tracking</span>
                                        </div>
                                        <span class="table-pill-count ms-2" style="background: #f1f5f9; color: #475569; font-weight: 700; font-size: 0.75rem; padding: 4px 10px; border-radius: 9999px; border: 1px solid #e2e8f0;">
                                            @activeSterilizations.Count @(activeSterilizations.Count == 1 ? "Sterile Set" : "Sterile Sets")
                                        </span>
                                    </div>
                                </div>

                                <div class="directory-section mb-4">
                                    <div class="lc-table-container">
                                        <table class="ot-schedule-table">
                                            <thead>
                                                <tr>
                                                    <th style="width: 50px; text-align: center;">S.NO</th>
                                                    <th style="width: 200px;">INSTRUMENT SET</th>
                                                    <th style="width: 170px;">METHOD</th>
                                                    <th style="width: 140px;">CYCLE NO</th>
                                                    <th style="width: 160px;">STERILIZED BY</th>
                                                    <th style="width: 140px;">EXPIRY DATE</th>
                                                    <th style="width: 130px; text-align: center;">STATUS</th>
                                                    <th>REMARKS</th>
                                                    <th style="width: 75px; text-align: center;">ACTIONS</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (activeSterilizations.Any())
                                                {
                                                    int sNo = 1;
                                                    @foreach (var s in activeSterilizations)
