    private async Task SaveConsumableAsync()
    {
        if (selectedRequest == null) return;
        if (string.IsNullOrWhiteSpace(cItemName))
        {
            ToastService.ShowWarning("Please enter or select item name.");
            return;
        }
        if (!cQuantity.HasValue || cQuantity.Value <= 0)
        {
            ToastService.ShowWarning("Please enter a valid quantity.");
            return;
        }

        try
        {
            var consReq = new AddOtConsumableRequest
            {
                request_id = selectedRequest.request_id,
                item_name = cItemName.Trim(),
                item_code = cSelectedItemCode > 0 ? cSelectedItemCode.ToString() : cItemCode.Trim(),
                batch_no = cBatchNo.Trim(),
                quantity = cQuantity.Value,
                unit = cUnit.Trim(),
                rate = cRate,
                amount = (cRate ?? 0) * cQuantity.Value,
                remarks = cRemarks
            };

