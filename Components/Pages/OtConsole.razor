    private async Task FinalizeSurgeryAsync()
    {
        if (selectedRequest == null) return;
        isSavingTab = true;
        StateHasChanged();
        try
        {
            selectedRequest.status = "COMPLETED";
            await OtService.UpdateSurgeryStatusAsync(new UpdateSurgeryStatusRequest
            {
                request_id = selectedRequest.request_id,
                status = "COMPLETED"
