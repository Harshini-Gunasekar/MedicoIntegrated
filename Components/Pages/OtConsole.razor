    private string GetStaffQualification(OtTeamMemberModel tm)
    {
        if (tm == null) return "—";
        if (tm.dcode.HasValue && tm.dcode.Value > 0)
        {
            var doc = doctorsList.FirstOrDefault(d => d.dcode == tm.dcode.Value);
            if (doc != null && !string.IsNullOrWhiteSpace(doc.qualification))
                return doc.qualification;
        }
        var cleanName = (tm.staff_name ?? "").Replace("Dr.", "").Replace("Dr ", "").Trim();
        var docByName = doctorsList.FirstOrDefault(d =>
            (!string.IsNullOrWhiteSpace(d.name) && (d.name.Equals(cleanName, StringComparison.OrdinalIgnoreCase) || cleanName.Contains(d.name, StringComparison.OrdinalIgnoreCase))) ||
            (!string.IsNullOrWhiteSpace(d.doctorfullname) && (d.doctorfullname.Equals(cleanName, StringComparison.OrdinalIgnoreCase) || cleanName.Contains(d.doctorfullname, StringComparison.OrdinalIgnoreCase))));
        if (docByName != null && !string.IsNullOrWhiteSpace(docByName.qualification))
            return docByName.qualification;

        if ((tm.role ?? "").Contains("NURSE", StringComparison.OrdinalIgnoreCase))
            return "B.Sc Nursing (OT Certified)";
        if ((tm.role ?? "").Contains("ANESTHESIOLOGIST", StringComparison.OrdinalIgnoreCase))
            return "MBBS, MD (Anesthesiology)";
        if ((tm.role ?? "").Contains("TECHNICIAN", StringComparison.OrdinalIgnoreCase))
            return "Diploma in OT Technology";
        return "Clinical Specialist";
    }

