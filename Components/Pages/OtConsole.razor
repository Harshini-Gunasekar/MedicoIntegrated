                                                            <td style="text-align: center;">
                                                                <button type="button" class="lc-circle-btn-32" @onclick="StartAddScheduleInline" title="Reschedule / Edit Slot" style="margin: 0 auto; width: 32px; height: 32px; border-radius: 8px; border: 1px solid #cbd5e1; background: #ffffff; color: #0284c7; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;">
                                                                    <i class="bi bi-pencil-square" style="font-size: 0.9rem;"></i>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                    else
