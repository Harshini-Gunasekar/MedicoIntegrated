                        Patient: <strong class="text-slate-800">@GetPatientName(selectedRequest.custid)</strong> (@selectedRequest.procedure_name)
                    </div>
                </div>
                <button type="button" class="preop-close-btn" @onclick="() => showAddSterilizationModal = false" title="Close dialog">&times;</button>
            </div>
            <div class="modal-body preop-modal-body">
                <div class="preop-form-field mb-3">
                    <label class="nt-form-label">INSTRUMENT SET NAME <span class="text-danger">*</span></label>
                    <input type="text" class="nt-input-control consent-input-text" @bind="sterInstrumentSet" placeholder="e.g. Laparoscopy Set A / Major Laparotomy Tray" required />
                </div>

                <div class="preop-form-grid-2col mb-3">
                    <div class="preop-form-field">
                        <label class="nt-form-label">STERILIZATION METHOD <span class="text-danger">*</span></label>
                        <select class="nt-select-control" @bind="sterMethod">
                            <option value="">-- Select Sterilization Method --</option>
                            <option value="AUTOCLAVE">AUTOCLAVE (Steam 134°C)</option>
                            <option value="ETO">ETO (Ethylene Oxide)</option>
                            <option value="PLASMA">PLASMA / STERRAD (H2O2)</option>
                            <option value="DRY_HEAT">DRY HEAT</option>
                            <option value="CHEMICAL">CHEMICAL / COLD</option>
                        </select>
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">CYCLE / BATCH NUMBER <span class="text-danger">*</span></label>
                        <input type="text" class="nt-input-control consent-input-text font-mono" @bind="sterCycleNumber" placeholder="e.g. CYC-2026-0912" />
                    </div>
                </div>

                <div class="preop-form-grid-2col mb-3">
                    <div class="preop-form-field">
                        <label class="nt-form-label">STERILIZED BY (CSSD TECHNICIAN) <span class="text-danger">*</span></label>
                        <input type="text" class="nt-input-control consent-input-text" @bind="sterSterilizedBy" placeholder="e.g. CSSD - Ramesh" />
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">EXPIRY DATE <span class="text-danger">*</span></label>
                        <input type="date" class="nt-input-control consent-input-text" @bind="sterExpiryDate" />
                    </div>
                </div>

                <div class="preop-form-field mb-3">
                    <label class="nt-form-label">STERILITY STATUS <span class="text-danger">*</span></label>
                    <select class="nt-select-control" @bind="sterStatus">
                        <option value="">-- Select Sterility Status --</option>
                        <option value="STERILE">STERILE (Verified &amp; Ready)</option>
                        <option value="IN_PROCESS">IN_PROCESS (In CSSD Cycle)</option>
                        <option value="EXPIRED">EXPIRED</option>
                        <option value="CONTAMINATED">CONTAMINATED / REJECTED</option>
                    </select>
                </div>

                <div class="preop-form-field mb-0">
                    <label class="nt-form-label">REMARKS / CYCLE PARAMETERS</label>
                    <input type="text" class="nt-input-control consent-input-text" @bind="sterRemarks" placeholder="e.g. Standard 134°C cycle, 20 mins, chemical indicator OK" />
                </div>
            </div>
            <div class="modal-footer-bar preop-modal-footer">
                <button type="button" class="preop-btn-cancel" @onclick="() => showAddSterilizationModal = false">Cancel</button>
                <button type="button" class="preop-btn-save" @onclick="SaveSterilizationAsync">
                    <i class="bi bi-check2"></i> Save Sterilization Record
                </button>
            </div>
        </div>
    </div>
}

@* --- 9. ADD CUSTOM CHECKLIST ITEM MODAL --- *@
@if (showAddChecklistItemModal && selectedRequest != null)
{
    <div class="modal-overlay">
        <div class="modal-form-card checklist-modal-dialog" @onclick:stopPropagation>
            <div class="modal-header-bar checklist-modal-header">
                <div>
                    <h3 class="m-0 font-bold text-slate-900" style="font-size: 1.15rem;">Add WHO Checklist Item</h3>
                    <div class="text-slate-600 font-12 font-medium mt-1">Append custom verification item to surgery checklist • Case: <strong class="text-slate-800">@selectedRequest.procedure_name</strong></div>
                </div>
                <button type="button" class="preop-close-btn" @onclick="() => showAddChecklistItemModal = false" title="Close">&times;</button>
            </div>
            
            <!-- Mode Switch Tabs -->
            <div class="checklist-tabs-container">
                <div class="checklist-modal-tabs">
                    <button type="button" class="checklist-modal-tab @(checklistAddMode == "NEW" ? "active" : "")" @onclick='() => checklistAddMode = "NEW"'>
                        <i class="bi bi-plus-circle"></i>
                        <span>Create New Item</span>
                    </button>
                    <button type="button" class="checklist-modal-tab @(checklistAddMode == "LIBRARY" ? "active" : "")" @onclick='() => checklistAddMode = "LIBRARY"'>
                        <i class="bi bi-collection"></i>
                        <span>Pick from Library</span>
                        <span class="checklist-tab-badge">@((checklistMasters ?? new()).Count(m => !(activeCustomChecklistItems ?? new()).Any(a => a.item_master_id == m.item_master_id)))</span>
                    </button>
                </div>
            </div>

            <div class="modal-body checklist-modal-body">
                @if (checklistAddMode == "NEW")
                {
                    <div class="preop-form-field mb-3">
                        <label class="nt-form-label">Checklist Item Description <span class="text-danger">*</span></label>
                        <input type="text" class="nt-input-control consent-input-text" @bind="newChecklistLabel" placeholder="e.g. COVID rapid test done / Pre-op ECG verified / Blood cross-matched" />
                    </div>

                    <div class="preop-form-grid-2col">
                        <div class="preop-form-field">
                            <label class="nt-form-label">Category <span class="text-danger">*</span></label>
                            <select class="nt-select-control" @bind="newChecklistCategory">
                                <option value="INFECTION_CONTROL">INFECTION CONTROL</option>
                                <option value="SURGICAL_SAFETY">SURGICAL SAFETY</option>
                                <option value="LAB_INVESTIGATION">LAB INVESTIGATION</option>
                                <option value="EQUIPMENT_CHECK">EQUIPMENT CHECK</option>
                                <option value="MEDICATION">MEDICATION</option>
                                <option value="ANESTHESIA_CHECK">ANESTHESIA CHECK</option>
                                <option value="GENERAL">GENERAL PRE-OP</option>
                            </select>
                        </div>
                        <div class="preop-form-field">
                            <label class="nt-form-label">Checked By</label>
                            <input type="text" class="nt-input-control consent-input-text" @bind="newChecklistCheckedBy" placeholder="Staff Name" />
                        </div>
                    </div>

                    <div class="preop-form-grid-2col">
                        <div class="preop-form-field">
                            <label class="nt-form-label">Initial Remarks / Findings</label>
                            <input type="text" class="nt-input-control consent-input-text" @bind="newChecklistRemarks" placeholder="e.g. Negative / Verified / Completed" />
                        </div>
                        <div class="preop-form-field">
                            <label class="nt-form-label">Verification Status</label>
                            <label class="consent-status-toggle-card @(newChecklistInitialChecked ? "status-signed" : "status-pending")">
                                <input type="checkbox" class="form-check-input consent-checkbox" @bind="newChecklistInitialChecked" />
                                <div class="consent-toggle-info">
                                    @if (newChecklistInitialChecked)
                                    {
                                        <i class="bi bi-check-circle-fill text-emerald-600"></i>
                                        <span class="text-emerald-800 font-bold">Verified Immediately</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-clock-history text-slate-500"></i>
                                        <span class="text-slate-700 font-bold">Mark as Pending</span>
                                    }
                                </div>
                            </label>
                        </div>
                    </div>
                }
                else
                {
                    var availableMasters = (checklistMasters ?? new()).Where(m => !(activeCustomChecklistItems ?? new()).Any(a => a.item_master_id == m.item_master_id)).ToList();
                    @if (availableMasters.Any())
                    {
                        <div class="text-slate-600 font-12 mb-2 font-semibold">Select template from Checklist Master library:</div>
                        <div class="d-flex flex-column gap-2" style="max-height: 280px; overflow-y: auto;">
                            @foreach (var m in availableMasters)
                            {
                                <div class="checklist-lib-item @(selectedMasterIdToAdd == m.item_master_id ? "selected" : "")"
                                     @onclick="() => selectedMasterIdToAdd = m.item_master_id">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="chk-item-icon">
                                            <i class="bi bi-check2-square text-indigo-600"></i>
                                        </div>
                                        <div>
                                            <div class="font-13 font-bold text-slate-800">@m.item_label</div>
                                            <div class="font-11 text-slate-500 mt-0.5">Category: <span class="badge bg-slate-100 text-slate-700 border font-10">@(string.IsNullOrWhiteSpace(m.category) ? "GENERAL" : m.category.Replace("_", " "))</span></div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm @(selectedMasterIdToAdd == m.item_master_id ? "btn-indigo-action" : "btn-secondary-outline") py-1 px-3 font-11">
                                        @(selectedMasterIdToAdd == m.item_master_id ? "Selected" : "Select")
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-slate-400 font-12 italic border rounded-2 bg-slate-50">
                            <i class="bi bi-check2-all fs-4 d-block text-slate-300 mb-1"></i>
                            All template items from the Master library have already been added to this case.
                        </div>
                    }
                }
            </div>

            <div class="modal-footer-bar">
                <button type="button" class="btn-secondary-outline" @onclick="() => showAddChecklistItemModal = false">Cancel</button>
                @if (checklistAddMode == "NEW")
                {
                    <button type="button" class="btn-indigo-action" @onclick="CreateAndAddChecklistMasterAsync">
                        <i class="bi bi-plus-circle me-1"></i> Save &amp; Add Item
                    </button>
                }
                else
                {
                    <button type="button" class="btn-indigo-action" @onclick="AddSelectedMasterChecklistItemAsync" disabled="@(selectedMasterIdToAdd == Guid.Empty)">
                        <i class="bi bi-plus-circle me-1"></i> Add Selected to Checklist
                    </button>
                }
            </div>
        </div>
    </div>
}

@* --- 10. ADD / EDIT PRE-OP ASSESSMENT MODAL --- *@
@if (showAddPreOpModal && selectedRequest != null)
{
    <div class="modal-overlay">
        <div class="modal-form-card preop-modal-dialog">
            <div class="modal-header-bar preop-modal-header">
                <div>
                    <h3 class="m-0 font-bold text-slate-900" style="font-size: 1.15rem;">@(activePreOp != null ? "Edit Pre-Operative Assessment & Fitness" : "Add Pre-Operative Assessment & Fitness")</h3>
                    <div class="text-slate-600 font-12 font-medium mt-1">Patient: <strong class="text-slate-800">@GetPatientName(selectedRequest.custid)</strong> (@selectedRequest.procedure_name)</div>
                </div>
                <button type="button" class="preop-close-btn" @onclick="() => showAddPreOpModal = false" title="Close">&times;</button>
            </div>
            <div class="modal-body preop-modal-body">
                <!-- Fitness Status & Assessed By Doctor in single line -->
                <div class="preop-form-grid-2col">
                    <div class="preop-form-field">
                        <label class="nt-form-label">Fitness Clearance Status <span class="text-danger">*</span></label>
                        <select class="nt-select-control" @bind="preOpFitness">
                            <option value="">-- Select Status --</option>
                            <option value="FIT">FIT</option>
                            <option value="PENDING">PENDING</option>
                            <option value="FIT_WITH_RESTRICTIONS">FIT WITH RESTRICTIONS</option>
                            <option value="NOT_FIT">NOT FIT</option>
                        </select>
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">Assessed By Doctor</label>
                        <select class="nt-select-control" @bind="preOpDoctorCode">
                            <option value="">-- Select Doctor --</option>
                            @foreach (var d in doctorsList)
                            {
                                <option value="@d.dcode">Dr. @(string.IsNullOrWhiteSpace(d.name) ? d.doctorfullname : d.name) (@(string.IsNullOrWhiteSpace(d.qualification) ? (d.description ?? "Doctor") : d.qualification))</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Medical History & Allergies in single line -->
                <div class="preop-form-grid-2col">
                    <div class="preop-form-field">
                        <label class="nt-form-label">Medical History / Co-morbidities</label>
                        <textarea rows="2" class="nt-input-control" @bind="preOpHistory" placeholder="e.g. Hypertension, Type 2 Diabetes, Asthma..."></textarea>
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">Allergies</label>
                        <textarea rows="2" class="nt-input-control" @bind="preOpAllergies" placeholder="e.g. Penicillin, Latex, NSAIDs..."></textarea>
                    </div>
                </div>

                <!-- Investigations & Vitals in single line -->
                <div class="preop-form-grid-2col">
                    <div class="preop-form-field">
                        <label class="nt-form-label">Investigations Summary</label>
                        <textarea rows="2" class="nt-input-control" @bind="preOpInvestigations" placeholder="e.g. CBC, RFT, LFT, ECG, Chest X-Ray findings..."></textarea>
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">Vitals Summary</label>
                        <textarea rows="2" class="nt-input-control" @bind="preOpVitals" placeholder="e.g. BP 120/80, PR 76, SpO2 99%, Temp 98.4F..."></textarea>
                    </div>
                </div>

                <!-- Anesthesia Clearance full width -->
                <div class="preop-form-field">
                    <label class="nt-form-label">Anesthesia Clearance &amp; Clinical Notes</label>
                    <textarea rows="2" class="nt-input-control" @bind="preOpClearanceNotes" placeholder="e.g. Cleared for GA with endotracheal intubation by anesthesia team."></textarea>
                </div>
            </div>
            <div class="modal-footer-bar preop-modal-footer">
                <button type="button" class="preop-btn-cancel" @onclick="() => showAddPreOpModal = false">Cancel</button>
                <button type="button" class="preop-btn-save" @onclick="SavePreOpFromModalAsync">
                    <i class="bi bi-check2"></i> Save Assessment
                </button>
            </div>
        </div>
    </div>
}

@* --- 11. VIEW PRE-OP ASSESSMENT DETAILS POPUP --- *@
@if (showViewPreOpModal && activePreOp != null && selectedRequest != null)
{
    var curPatName = GetPatientName(selectedRequest.custid);
    var docName = activePreOp.assessed_by_dcode.HasValue ? GetDoctorName(activePreOp.assessed_by_dcode.Value) : "Attending Doctor";

    <div class="modal-overlay">
        <div class="modal-form-card preop-modal-dialog" style="max-width: 680px !important;">
            <div class="modal-header-bar preop-modal-header">
                <div>
                    <h3 class="m-0 font-bold text-slate-900 fs-6">Pre-Operative Assessment &amp; Fitness Details</h3>
                    <div class="text-slate-500 font-12 font-medium mt-0.5">
                        Patient: <strong class="text-slate-800">@curPatName</strong> (#@selectedRequest.custid.ToString("0")) • <span class="text-indigo-600 font-semibold">@selectedRequest.procedure_name</span>
                    </div>
                </div>
                <button type="button" class="preop-close-btn" @onclick="() => showViewPreOpModal = false" title="Close">&times;</button>
            </div>
            <div class="modal-body preop-modal-body p-3">
                <!-- Top Clearance & Doctor Banner -->
                <div class="preop-hero-banner mb-3">
                    <div class="preop-hero-item">
                        <span class="preop-hero-label">FITNESS CLEARANCE</span>
                        <div class="preop-hero-status">
                            @if (activePreOp.fitness_status == "FIT")
                            {
                                <i class="bi bi-check-circle-fill text-emerald-600 fs-5"></i>
                                <span class="text-emerald-800 font-bold">FIT FOR SURGERY</span>
                            }
                            else if (activePreOp.fitness_status == "NOT_FIT")
                            {
                                <i class="bi bi-x-circle-fill text-rose-600 fs-5"></i>
                                <span class="text-rose-800 font-bold">NOT FIT</span>
                            }
                            else if (activePreOp.fitness_status == "FIT_WITH_RESTRICTIONS")
                            {
                                <i class="bi bi-exclamation-triangle-fill text-amber-600 fs-5"></i>
                                <span class="text-amber-800 font-bold">FIT WITH RESTRICTIONS</span>
                            }
                            else
                            {
                                <i class="bi bi-clock-history text-slate-500 fs-5"></i>
                                <span class="text-slate-700 font-bold">PENDING CLEARANCE</span>
                            }
                        </div>
                    </div>
                    <div class="preop-hero-divider"></div>
                    <div class="preop-hero-item">
                        <span class="preop-hero-label">ASSESSED BY DOCTOR</span>
                        <div class="preop-hero-doctor">
                            <i class="bi bi-person-badge text-indigo-600 fs-4"></i>
                            <div>
                                <div class="font-bold text-slate-800">Dr. @docName</div>
                                <div class="text-slate-400 font-11">@activePreOp.assessment_date.ToString("dd-MMM-yyyy hh:mm tt")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cohesive Clinical Breakdown Panel -->
                <div class="preop-clinical-panel">
                    <!-- Medical History -->
                    <div class="preop-clinical-row">
                        <div class="preop-clinical-meta">
                            <i class="bi bi-heart-pulse text-rose-500 fs-6"></i>
                            <span class="preop-clinical-label">Medical History / Co-morbidities</span>
                        </div>
                        <div class="preop-clinical-value">
                            @(string.IsNullOrWhiteSpace(activePreOp.medical_history) ? "None reported." : activePreOp.medical_history)
                        </div>
                    </div>

                    <!-- Known Allergies -->
                    <div class="preop-clinical-row">
                        <div class="preop-clinical-meta">
                            <i class="bi bi-shield-exclamation text-amber-500 fs-6"></i>
                            <span class="preop-clinical-label">Known Allergies</span>
                        </div>
                        <div class="preop-clinical-value">
                            @if (!string.IsNullOrWhiteSpace(activePreOp.allergies) && !activePreOp.allergies.Equals("None", StringComparison.OrdinalIgnoreCase) && !activePreOp.allergies.Equals("No", StringComparison.OrdinalIgnoreCase) && !activePreOp.allergies.Equals("No known allergies", StringComparison.OrdinalIgnoreCase) && !activePreOp.allergies.Equals("No known drug allergies", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-amber-50 text-amber-800 border border-amber-200 font-12 px-2 py-0.5">
                                    <i class="bi bi-exclamation-triangle-fill text-amber-600 me-1"></i>@activePreOp.allergies
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-emerald-50 text-emerald-700 border border-emerald-200 font-12 px-2 py-0.5">
                                    <i class="bi bi-check-circle me-1"></i>No Known Drug Allergies
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Investigations -->
                    <div class="preop-clinical-row">
                        <div class="preop-clinical-meta">
                            <i class="bi bi-file-earmark-medical text-sky-500 fs-6"></i>
                            <span class="preop-clinical-label">Investigations Summary</span>
                        </div>
                        <div class="preop-clinical-value">
                            @(string.IsNullOrWhiteSpace(activePreOp.investigations_summary) ? "No investigations recorded." : activePreOp.investigations_summary)
                        </div>
                    </div>

                    <!-- Baseline Vitals -->
                    <div class="preop-clinical-row">
                        <div class="preop-clinical-meta">
                            <i class="bi bi-activity text-emerald-500 fs-6"></i>
                            <span class="preop-clinical-label">Baseline Vitals</span>
                        </div>
                        <div class="preop-clinical-value font-semibold text-slate-800">
                            @(string.IsNullOrWhiteSpace(activePreOp.vitals_summary) ? "No baseline vitals recorded." : activePreOp.vitals_summary)
                        </div>
                    </div>

                    <!-- Anesthesia Clearance Notes -->
                    @if (!string.IsNullOrWhiteSpace(activePreOp.clearance_notes))
                    {
                        <div class="preop-clinical-row">
                            <div class="preop-clinical-meta">
                                <i class="bi bi-journal-check text-indigo-500 fs-6"></i>
                                <span class="preop-clinical-label">Anesthesia Clearance Notes</span>
                            </div>
                            <div class="preop-clinical-value">
                                @activePreOp.clearance_notes
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer-bar preop-modal-footer">
                <button type="button" class="preop-btn-cancel" @onclick="() => showViewPreOpModal = false">Close</button>
                <button type="button" class="preop-btn-save" @onclick="OpenEditPreOpFromView">
                    <i class="bi bi-pencil-square"></i> Edit Assessment
                </button>
            </div>
        </div>
    </div>
}

@* --- 12. ADD / EDIT ANESTHESIA RECORD MODAL --- *@
@if (showAddAnesthesiaModal && selectedRequest != null)
{
    <div class="modal-overlay">
        <div class="modal-form-card preop-modal-dialog" @onclick:stopPropagation>
            <div class="modal-header-bar preop-modal-header">
                <div>
                    <h3 class="m-0 font-bold text-slate-900" style="font-size: 1.15rem;">@(activeAnesthesia != null ? "Edit Anesthesia Record & PAC" : "Add Anesthesia Record & PAC")</h3>
                    <div class="text-slate-600 font-12 font-medium mt-1">Patient: <strong class="text-slate-800">@GetPatientName(selectedRequest.custid)</strong> (@selectedRequest.procedure_name)</div>
                </div>
                <button type="button" class="preop-close-btn" @onclick="() => showAddAnesthesiaModal = false" title="Close">&times;</button>
            </div>
            <div class="modal-body preop-modal-body">
                <!-- Anesthesia Type & ASA Grade in single line -->
                <div class="preop-form-grid-2col">
                    <div class="preop-form-field">
                        <label class="nt-form-label">Anesthesia Type <span class="text-danger">*</span></label>
                        <select class="nt-select-control" @bind="anesType">
                            <option value="GENERAL">GENERAL</option>
                            <option value="SPINAL">SPINAL</option>
                            <option value="EPIDURAL">EPIDURAL</option>
                            <option value="REGIONAL BLOCK">REGIONAL BLOCK</option>
                            <option value="MAC / SEDATION">MAC / SEDATION</option>
                            <option value="LOCAL">LOCAL</option>
                        </select>
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">ASA Grade <span class="text-danger">*</span></label>
                        <select class="nt-select-control" @bind="anesAsaGrade">
                            <option value="ASA I">ASA I</option>
                            <option value="ASA II">ASA II</option>
                            <option value="ASA III">ASA III</option>
                            <option value="ASA IV">ASA IV</option>
                            <option value="ASA V">ASA V</option>
                            <option value="ASA E">ASA E (Emergency)</option>
                        </select>
                    </div>
                </div>

                <!-- Anesthetist Doctor & Airway in single line -->
                <div class="preop-form-grid-2col">
                    <div class="preop-form-field">
                        <label class="nt-form-label">Anesthetist Doctor</label>
                        <select class="nt-select-control" @bind="anesDoctorCode">
                            <option value="">-- Select Anesthetist --</option>
                            @foreach (var d in doctorsList)
                            {
                                <option value="@d.dcode">Dr. @(string.IsNullOrWhiteSpace(d.name) ? d.doctorfullname : d.name) (@(string.IsNullOrWhiteSpace(d.qualification) ? (d.description ?? "Doctor") : d.qualification))</option>
                            }
                        </select>
                    </div>
                    <div class="preop-form-field">
                        <label class="nt-form-label">Airway Assessment &amp; Intubation Notes</label>
                        <input type="text" class="nt-input-control consent-input-text" @bind="anesAirway" placeholder="e.g. Mallampati Class I, Cormack-Lehane Grade 1, ETT #7.5" />
                    </div>
                </div>

                <!-- Drugs & IV Fluids in single line -->
