    private async Task LoadAdvanceBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }
            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var all = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                advanceBranchesList = all.Where(b => !b.deleted).ToList();

                try
                {
                    var isTenantAdmin = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
                    if (isTenantAdmin.Success && isTenantAdmin.Value) { /* see all */ }
                    else
                    {
                        var branchCodes = await _sessionStorage.GetAsync<List<int>>("UserBranchCodes");
                        if (branchCodes.Success && branchCodes.Value != null && branchCodes.Value.Any())
                        {
                            var allowed = branchCodes.Value.ToHashSet();
                            var filtered = advanceBranchesList.Where(b => allowed.Contains(b.bh_code)).ToList();
                            if (filtered.Any()) advanceBranchesList = filtered;
                        }
                    }
                }
                catch { }

                if (string.IsNullOrEmpty(advanceSelectedBranchCode) && advanceBranchesList.Any())
                {
                    advanceSelectedBranchCode = advanceBranchesList.First().bh_code.ToString();
                }
                ApplyAdvanceCounterFilter();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadAdvanceBranchesAsync] Error: {ex.Message}");
        }
    }

    private async Task LoadAdvanceCountersAsync()
    {
        try
        {
            var res = await CounterService.GetCountersAsync();
            if (res != null)
            {
                advanceAllCounters = res.OrderBy(c => c.orderno).ToList();
                ApplyAdvanceCounterFilter();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadAdvanceCountersAsync] Error: {ex.Message}");
        }
    }

    private void ApplyAdvanceCounterFilter()
    {
        if (int.TryParse(advanceSelectedBranchCode, out var bCode) && bCode > 0)
        {
            advanceFilteredCountersList = advanceAllCounters.Where(c => c.bhcode == bCode && !c.deleted).ToList();
        }
        else
        {
            advanceFilteredCountersList = advanceAllCounters.Where(c => !c.deleted).ToList();
        }
    }

    private void OnAdvanceBranchChanged()
    {
        ApplyAdvanceCounterFilter();
        if (!string.IsNullOrEmpty(advanceSelectedCounterCode) &&
            !advanceFilteredCountersList.Any(c => c.cntcode.ToString() == advanceSelectedCounterCode))
        {
            advanceSelectedCounterCode = "";
        }
        StateHasChanged();
    }

    private async Task LoadPatientAdvanceAsync(decimal? custId)
    {
        if (custId == null || custId.Value <= 0)
        {
            advanceSummary = null;
            return;
        }

        loadingAdvance = true;
        StateHasChanged();
        try
        {
            var summary = await DueCollectionService.GetPatientAdvanceSummaryAsync(custId.Value);
            if (summary != null)
            {
                advanceSummary = summary;
                if (string.IsNullOrWhiteSpace(advanceSummary.patient_name) && selectedRequest != null)
                {
                    advanceSummary.patient_name = selectedRequest.patient_name;
                }
                advanceResolvedTransactionTypes.Clear();
                advanceResolvedCustomerNames.Clear();
            }
            else
            {
                InitializeEmptyAdvanceSummary();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadPatientAdvanceAsync] Error: {ex.Message}");
            InitializeEmptyAdvanceSummary();
        }
        finally
        {
            loadingAdvance = false;
            StateHasChanged();
        }
    }

    private void InitializeEmptyAdvanceSummary()
    {
        if (selectedRequest != null)
        {
            advanceSummary = new HmsPatientAdvanceSummary
            {
                custid = selectedRequest.custid,
                patient_name = selectedRequest.patient_name ?? GetPatientName(selectedRequest.custid),
                total_advance_deposited = 0,
                total_advance_used = 0,
                total_advance_refunded = 0,
                available_balance = 0,
                ledger = new List<HmsAdvanceLedgerRow>()
            };
        }
        advanceResolvedTransactionTypes.Clear();
        advanceResolvedCustomerNames.Clear();
        StateHasChanged();
    }

    private async Task DepositAdvanceAsync()
    {
        if (advanceSummary == null || depositAmount <= 0) return;
        actionRunning = true;
        StateHasChanged();

        try
        {
            var userCode = TenantState.UserCode != 0 ? TenantState.UserCode : 10;
            var req = new HmsAdvanceDepositRequest
            {
                custid = advanceSummary.custid > 0 ? advanceSummary.custid : (selectedRequest?.custid ?? 0),
                patient_name = !string.IsNullOrWhiteSpace(advanceSummary.patient_name) ? advanceSummary.patient_name : selectedRequest?.patient_name,
                amount = depositAmount,
                collection_type = depositPayMode,
                remarks = depositRemarks,
                usercode = userCode,
                cntcode = AdvanceCounterCodeVal,
                enteredbhcode = AdvanceBranchCodeVal
            };

            var res = await DueCollectionService.DepositAdvanceAsync(req);
            if (res != null)
            {
                ToastService.ShowSuccess($"Deposited ₹{depositAmount:N2} advance successfully.");
                depositAmount = 0;
                depositRemarks = string.Empty;
                await LoadPatientAdvanceAsync(selectedRequest?.custid);
            }
            else
            {
                ToastService.ShowError("Failed to deposit advance.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Deposit failed: {ex.Message}");
        }
        finally
        {
            actionRunning = false;
            StateHasChanged();
        }
    }

    private async Task RefundAdvanceAsync()
    {
        if (advanceSummary == null || refundAmount <= 0) return;
        actionRunning = true;
        StateHasChanged();

        try
        {
            var userCode = TenantState.UserCode != 0 ? TenantState.UserCode : 10;
