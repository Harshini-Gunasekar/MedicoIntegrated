    private async Task RefreshBillingStatusAsync(Guid requestId)
    {
        try
        {
            if (selectedRequest == null) return;

            // Fetch unbilled charges from HmsBillingService
            List<UnbilledChargeSummary> allUnbilled = new();
            try
            {
                allUnbilled = await HmsBillingService.GetAllUnbilledChargesAsync() ?? new();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[OtConsole.RefreshBillingStatusAsync] GetAllUnbilledCharges error: {ex.Message}");
            }

            List<UnbilledChargeSummary> visitUnbilled = new();
            try
            {
                visitUnbilled = await HmsBillingService.GetUnbilledChargesByVisitAsync(null, null) ?? new();
            }
            catch { }

            var combinedUnbilled = new List<UnbilledChargeSummary>();
            if (allUnbilled != null) combinedUnbilled.AddRange(allUnbilled);
            if (visitUnbilled != null) combinedUnbilled.AddRange(visitUnbilled);

            // Deduplicate
            var distinctUnbilled = combinedUnbilled
                .GroupBy(u => !string.IsNullOrEmpty(u.unbilledid) ? u.unbilledid.Trim().ToLowerInvariant() : (!string.IsNullOrEmpty(u.entryid) ? u.entryid.Trim().ToLowerInvariant() : Guid.NewGuid().ToString()))
                .Select(g => g.First())
                .ToList();

            var reqIdStr = requestId.ToString();
            var consumableIds = activeConsumables.Select(c => c.consumable_id.ToString()).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var implantIds = activeImplants.Select(i => i.implant_id.ToString()).ToHashSet(StringComparer.OrdinalIgnoreCase);

            // Find any charge matching this surgery case that is UNBILLED (pending)
            var pendingCharges = distinctUnbilled.Where(uc =>
            {
                // If billedstatus is explicitly true, it is already billed
                if (uc.billedstatus == true) return false;

                // Match procedure
                if (!string.IsNullOrEmpty(uc.entryid) && string.Equals(uc.entryid.Trim(), reqIdStr, StringComparison.OrdinalIgnoreCase))
                    return true;

                if (string.Equals(uc.entrytype, "OT_PROCEDURE", StringComparison.OrdinalIgnoreCase) && uc.custid.HasValue && uc.custid.Value == selectedRequest.custid)
                    return true;

                // Match consumables
                if (!string.IsNullOrEmpty(uc.entryid) && consumableIds.Contains(uc.entryid.Trim()))
                    return true;

                // Match implants
                if (!string.IsNullOrEmpty(uc.entryid) && implantIds.Contains(uc.entryid.Trim()))
                    return true;

                return false;
            }).ToList();

            if (episodeSummary == null)
            {
                episodeSummary = new OtSummaryModel();
            }

            int totalExpectedCharges = (selectedRequest.procedure_fee > 0 ? 1 : 0) + activeConsumables.Count + activeImplants.Count;
            episodeSummary.total_charge_count = totalExpectedCharges;
            episodeSummary.pending_charge_count = pendingCharges.Count;

            // If there are no pending unbilled charges, this surgical episode is fully billed!
            episodeSummary.is_fully_billed = (pendingCharges.Count == 0);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OtConsole.RefreshBillingStatusAsync] Error: {ex.Message}");
        }
    }

