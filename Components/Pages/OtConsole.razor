    #region Lifecycle & Initialization

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (RequestId.HasValue && RequestId.Value != Guid.Empty)
        {
            var match = allRequests.FirstOrDefault(r => r.request_id == RequestId.Value);
            if (match != null && (selectedRequest == null || selectedRequest.request_id != match.request_id))
            {
                await SelectSurgeryCaseAsync(match);
            }
        }
    }

    private async Task LoadInitialDataAsync()
    {
        isLoadingRequests = true;
        try
        {
            var tReq = OtService.GetSurgeryRequestsAsync();
            var tDoc = DoctorService.GetDoctorsAsync();
            var tNurse = NurseService.GetNurseMastersAsync();
            var tOt = OtService.GetOtMastersAsync();
            var tSched = OtService.GetScheduleCalendarAsync();
            var tWard = WardService.GetWardMastersAsync();
            var tBed = BedService.GetBedMastersAsync();
            var tRmt = RoomTypeService.GetRoomTypeMastersAsync();
            var tIpReg = IpService.GetIpRegistrationsAsync("ADMITTED");

            await Task.WhenAll(tReq, tDoc, tNurse, tOt, tSched, tWard, tBed, tRmt, tIpReg);

            allRequests = (await tReq) ?? new();
            doctorsList = (await tDoc) ?? new();
            nursesList = (await tNurse) ?? new();
            otTheaters = (await tOt) ?? new();
            allSchedules = (await tSched) ?? new();
            wardsList = (await tWard) ?? new();
            bedsList = (await tBed) ?? new();
            roomTypes = (await tRmt) ?? new();
            activeIpRegistrations = (await tIpReg) ?? new();

            // Load doctor photos asynchronously in background
            foreach (var doc in doctorsList.Where(d => !string.IsNullOrWhiteSpace(d.doctorimage)))
            {
                _ = LoadDoctorPhotoAsync(doc.dcode, doc.doctorimage, doc.tenant_code);
            }

            if (RequestId.HasValue && RequestId.Value != Guid.Empty)
            {
                selectedRequest = allRequests.FirstOrDefault(r => r.request_id == RequestId.Value);
            }

            if (selectedRequest == null && allRequests.Any())
            {
                selectedRequest = allRequests.FirstOrDefault(r => r.status == "IN_PROGRESS" || r.status == "SCHEDULED") ?? allRequests.First();
            }

            if (selectedRequest != null)
            {
                await LoadCaseEpisodeDataAsync(selectedRequest.request_id);
            }

            // Load IP Casesheet Referrals in background
            _ = LoadIpReferralsAsync();

            // Load Fee Categories and Customers in background
            _ = LoadFeeSplitMastersAsync();
            _ = LoadCustomersAsync();

            // Load Inventory Items, Stocks, and UOMs in background
            _ = LoadInventoryItemsAsync();
            _ = LoadStocksAsync();
            _ = LoadUomsAsync();

            // Load Patient Advance branches & counters in background
            _ = LoadAdvanceBranchesAsync();
            _ = LoadAdvanceCountersAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading OT data: {ex.Message}");
        }
        finally
        {
            isLoadingRequests = false;
            StateHasChanged();
        }
    }

    private async Task LoadIpReferralsAsync()
    {
        isLoadingIpReferrals = true;
        try
        {
            var ipList = activeIpRegistrations.Any() ? activeIpRegistrations : (await IpService.GetIpRegistrationsAsync("ADMITTED") ?? new());
            if (!ipList.Any())
            {
                ipList = await IpService.GetActiveAdmissionsAsync() ?? new();
            }

            var tasks = ipList.Select(async ip =>
            {
                try
                {
                    var cs = await CaseSheetService.GetCaseSheetByVisitAsync(null, ip.ip_id);
                    if (cs != null && cs.referred_to_operation)
                    {
                        var refDcode = cs.dcode > 0 ? cs.dcode : (ip.dcode > 0 ? ip.dcode : (ip.referring_dcode ?? 0));
                        var docName = FormatDoctorDisplayName(refDcode);
                        var diagText = "";
                        if (cs.diagnosis_list != null && cs.diagnosis_list.Any())
                        {
                            diagText = string.Join(", ", cs.diagnosis_list
                                .Select(d => !string.IsNullOrWhiteSpace(d.diagnosis_text) ? d.diagnosis_text : d.icd_description)
                                .Where(s => !string.IsNullOrWhiteSpace(s)));
                        }
                        if (string.IsNullOrWhiteSpace(diagText))
                        {
                            diagText = cs.chief_complaint ?? cs.symptoms ?? ip.admission_reason ?? "Referred to OT";
                        }

                        var matchedReq = allRequests.FirstOrDefault(r => (r.ip_id == ip.ip_id || r.custid == ip.custid) && r.status != "CANCELLED");

                        var matchedBed = bedsList.FirstOrDefault(b => b.bedcode == ip.bedcode);
                        var matchedWard = wardsList.FirstOrDefault(w => w.wrdcode == (ip.wrdcode ?? matchedBed?.wrdcode));
                        var matchedRoomType = roomTypes.FirstOrDefault(r => r.rmtcode == (ip.rmtcode ?? matchedBed?.rmtcode));

                        var resolvedWard = matchedWard?.name ?? matchedWard?.shortname ?? matchedRoomType?.name ?? (!string.IsNullOrWhiteSpace(ip.admission_type) ? ip.admission_type : "General");
                        var resolvedBed = matchedBed?.bedname ?? matchedBed?.shortname ?? (ip.bedcode.HasValue && ip.bedcode.Value > 0 ? ip.bedcode.Value.ToString() : "ΓÇö");

                        return new IpOtReferralModel
                        {
                            ip_id = ip.ip_id,
                            custid = ip.custid,
                            ip_no = ip.ip_no,
                            patient_name = !string.IsNullOrWhiteSpace(ip.patient_name) ? ip.patient_name : GetPatientName(ip.custid),
                            dcode = refDcode,
                            doctor_name = docName,
                            ward_name = resolvedWard,
                            bed_no = resolvedBed,
                            admitdate = ip.admitdate,
                            admission_reason = ip.admission_reason,
                            chief_complaint = cs.chief_complaint,
                            symptoms = cs.symptoms,
                            examination = cs.examination,
                            advise = cs.advise,
                            diagnosis = diagText,
                            notes = cs.notes,
                            has_surgery_request = matchedReq != null,
                            request_id = matchedReq?.request_id,
                            surgery_status = matchedReq?.status
                        };
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[LoadIpReferralsAsync] IP {ip.ip_id} error: {ex.Message}");
                }
                return null;
            });

            var results = await Task.WhenAll(tasks);
            ipOtReferrals = results.Where(r => r != null).Select(r => r!).OrderByDescending(r => r.admitdate).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadIpReferralsAsync] Overall error: {ex.Message}");
        }
        finally
        {
            isLoadingIpReferrals = false;
            StateHasChanged();
        }
    }

    private async Task LoadCaseEpisodeDataAsync(Guid requestId)
    {
        isLoadingEpisode = true;
        StateHasChanged();
        try
        {
            var tSched = OtService.GetScheduleByRequestAsync(requestId);
            var tTeam = OtService.GetTeamByRequestAsync(requestId);
            var tAnes = OtService.GetAnesthesiaByRequestAsync(requestId);
            var tIntra = OtService.GetIntraOpByRequestAsync(requestId);
            var tSter = OtService.GetSterilizationsByRequestAsync(requestId);
            var tStaff = OtService.GetStaffNotesByRequestAsync(requestId);

            await Task.WhenAll(tSched, tTeam, tAnes, tIntra, tSter, tStaff);

            activeSchedule = await tSched;
            activeTeamMembers = (await tTeam) ?? new();
            var loadedAnes = await tAnes;
            activeAnesthesias = loadedAnes != null ? new List<OtAnesthesiaModel> { loadedAnes } : new List<OtAnesthesiaModel>();
            var loadedIntra = await tIntra;
            activeIntraOps = loadedIntra != null ? new List<OtIntraOpModel> { loadedIntra } : new List<OtIntraOpModel>();
            activeSterilizations = (await tSter) ?? new();
            activeStaffNotes = (await tStaff) ?? new();
            isAssignMode = !activeTeamMembers.Any();

            if (selectedRequest != null)
            {
                _ = LoadPatientAdvanceAsync(selectedRequest.custid);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadCaseEpisodeDataAsync] Error: {ex.Message}");
        }
        finally
        {
            isLoadingEpisode = false;
            StateHasChanged();
        }
    }

