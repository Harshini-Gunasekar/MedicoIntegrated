</style>

<div class="ot-page-wrapper lc-fadeInUp" @onclick="HandlePageClick">
    <!-- ========================================================================= -->
    <!-- 1. HEADER CONSOLE (NURSE NOTES THEMED)                                    -->
    <!-- ========================================================================= -->
    <div class="lab-header-card mb-2">
        <div class="header-left-wrap">
            <div class="header-icon-box">
                <i class="bi bi-heart-pulse"></i>
            </div>
            <div class="header-title-group">
                <h2 class="lab-title-text m-0">OT Clinical Console</h2>
                <div class="header-status-indicator">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Operation Theater Flow &amp; Surgical Workspace</span>
                </div>
            </div>
        </div>

        <div class="header-right-wrap">
            <!-- All Surgery Cases Button -->
            <button type="button" class="btn-ip-patients-nav" @onclick="OpenCasesModal" title="View all surgery cases directory">
                <i class="bi bi-folder2-open nav-btn-icon"></i>
                <span>All Cases</span>
                <span class="ip-count-badge">@allRequests.Count</span>
            </button>

            <!-- Case Search Autocomplete Pill Box -->
            <div class="patient-search-relative" @onclick:stopPropagation>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#6366f1" viewBox="0 0 16 16" class="search-icon-svg">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text"
                       placeholder="Search patient, doctor, procedure..."
                       class="lc-rounded-pill-input"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onfocus="() => { isCaseDropdownOpen = true; highlightedCaseIndex = 0; }"
                       @onkeydown="HandleSearchKeyDown" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button type="button" class="btn-search-clear" @onclick="ClearSearch" title="Clear">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }

                @if (isCaseDropdownOpen)
                {
                    <div class="patient-search-popover shadow-lg">
                        <div class="popover-header">
                            <span class="popover-title-text"><i class="bi bi-folder-check me-1.5 text-indigo-600"></i>Surgery Cases Directory</span>
                            <span class="popover-counter-badge">@FilteredRequests.Count()</span>
                        </div>
                        <div class="popover-list">
                            @if (isLoadingRequests)
                            {
                                <div class="p-4 text-center text-muted">
                                    <span class="spinner-border spinner-border-sm text-indigo-600 me-2"></span>
                                    <span class="fs-7">Loading cases...</span>
                                </div>
                            }
                            else if (!FilteredRequests.Any())
                            {
                                <div class="p-4 text-center text-muted">
                                    <i class="bi bi-folder-x fs-3 text-secondary d-block mb-1"></i>
                                    <span class="fs-7">No matching surgery cases found.</span>
                                </div>
                            }
                            else
                            {
                                var reqList = FilteredRequests.ToList();
                                @for (int rIdx = 0; rIdx < reqList.Count; rIdx++)
                                {
                                    var req = reqList[rIdx];
                                    var isCurrent = selectedRequest?.request_id == req.request_id;
                                    var isHigh = rIdx == highlightedCaseIndex;
                                    var patName = GetPatientName(req.custid);
                                    var docName = GetDoctorName(req.dcode);
                                    <div class="popover-patient-item @(isCurrent ? "active-pat" : "") @(isHigh ? "highlighted-pat" : "")"
                                         @onclick="() => SelectCaseFromDropdown(req)"
                                         @onmouseenter="() => highlightedCaseIndex = rIdx">
                                        <div class="popover-avatar">@GetInitials(patName)</div>
                                        <div class="popover-details">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="popover-pat-name">@patName</span>
                                                <span class="popover-ip-badge">#@req.custid.ToString("0")</span>
                                            </div>
                                            <div class="popover-sub-meta">
                                                <span><i class="bi bi-heart-pulse me-1 text-indigo-500"></i>@req.procedure_name</span>
                                                <span class="ms-2"><i class="bi bi-person-badge me-1 text-slate-400"></i>Dr. @docName</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- New Surgery Request Action -->
            <button type="button" class="btn-indigo-action" @onclick="CreateNewSurgeryRequestPrompt" title="Create New Surgery Request">
                <i class="bi bi-plus-circle-fill"></i>
                <span>New Request</span>
            </button>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 2. PATIENT DETAILS BANNER (NURSE NOTES TILED STATS)                       -->
    <!-- ========================================================================= -->
    @if (selectedRequest != null)
    {
        <div class="patient-banner-card mb-2">
            <div class="banner-left-wrap">
                <div class="pat-avatar-indigo">
                    @GetInitials(GetPatientName(selectedRequest.custid))
                </div>
                <div class="pat-text-wrap">
                    <div class="pat-header-row">
                        <span class="pat-name-heading">@GetPatientName(selectedRequest.custid)</span>
                        <div class="pat-header-badges">
                            <span class="badge-ip-indigo"><i class="bi bi-hash"></i>CUST-@selectedRequest.custid.ToString("0")</span>
                            <span class="badge-status-admitted">
                                <span class="admitted-dot"></span>
                                @selectedRequest.status
                            </span>
                            <span class="badge @GetPriorityBadgeClass(selectedRequest.priority)" style="font-size: 11px; padding: 2.5px 8px;">@selectedRequest.priority</span>
                        </div>
                    </div>

                    <div class="pat-meta-row">
                        <div class="pat-meta-tile">
                            <div class="tile-icon-box tile-icon-age">
                                <i class="bi bi-person"></i>
                            </div>
                            <div class="meta-item">
                                <span class="meta-lbl">Surgery Type</span>
                                <span class="meta-val">@(selectedRequest.surgery_type ?? "MAJOR SURGERY")</span>
                            </div>
                        </div>

                        <div class="pat-meta-tile">
                            <div class="tile-icon-box tile-icon-proc">
                                <i class="bi bi-heart-pulse-fill"></i>
                            </div>
                            <div class="meta-item">
                                <span class="meta-lbl">Proposed Procedure</span>
                                <span class="meta-val val-highlight">@selectedRequest.procedure_name</span>
                            </div>
                        </div>

                        <div class="pat-meta-tile">
                            <div class="tile-icon-box tile-icon-doc">
                                <i class="bi bi-person-badge-fill"></i>
                            </div>
                            <div class="meta-item">
                                <span class="meta-lbl">Attending Surgeon</span>
                                <span class="meta-val">Dr. @GetDoctorName(selectedRequest.dcode)</span>
                            </div>
                        </div>

                        <div class="pat-meta-tile">
                            <div class="tile-icon-box tile-icon-ot">
                                <i class="bi bi-calendar3"></i>
                            </div>
                            <div class="meta-item">
                                <span class="meta-lbl">Theater &amp; Schedule</span>
                                <span class="meta-val">@(activeSchedule != null ? $"{activeSchedule.scheduled_date:dd-MMM-yyyy} ({activeSchedule.scheduled_time:hh\\:mm})" : "Not Scheduled")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="banner-right-wrap">
                <button type="button" class="btn-op-casesheet" @onclick="OpenCasesModal" title="Open directory of all cases">
                    <i class="bi bi-folder2-open"></i>
                    <span>Browse Cases</span>
                </button>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- 3. WORKSPACE CARD & TABS (NURSE NOTES TAB STRIP)                          -->
    <!-- ========================================================================= -->
    <div class="nurse-workspace-card">
        <!-- Tab Navigation Strip -->
        <div class="workspace-tabs-strip">
            <button type="button" class="nt-tab-btn @(activeTab == "REQUEST" ? "active" : "")" @onclick='() => SetTab("REQUEST")'>
                <i class="bi bi-file-earmark-plus"></i>
                <span>1. OT Request</span>
                @if (selectedRequest != null)
                {
                    <span class="tab-badge-pill">@selectedRequest.priority</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "SCHEDULE" ? "active" : "")" @onclick='() => SetTab("SCHEDULE")'>
                <i class="bi bi-calendar2-check"></i>
                <span>2. Schedule</span>
                @if (activeSchedule != null)
                {
                    <span class="tab-badge-pill">Booked</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "TEAM" ? "active" : "")" @onclick='() => SetTab("TEAM")'>
                <i class="bi bi-people"></i>
                <span>3. Team Members</span>
                @if (activeTeam.Any())
                {
                    <span class="tab-badge-pill">@activeTeam.Count</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "ANESTHESIA" ? "active" : "")" @onclick='() => SetTab("ANESTHESIA")'>
                <i class="bi bi-shield-check"></i>
                <span>4. Anaesthesia</span>
                @if (activePreOp != null)
                {
                    <span class="tab-badge-pill">@activePreOp.fitness_status</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "SURGERY" ? "active" : "")" @onclick='() => SetTab("SURGERY")'>
                <i class="bi bi-heart-pulse"></i>
                <span>5. Surgery (Intra-OP)</span>
                @if (activeIntraOp != null)
                {
                    <span class="tab-badge-pill">Recorded</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "STAFFNOTES" ? "active" : "")" @onclick='() => SetTab("STAFFNOTES")'>
                <i class="bi bi-journal-medical"></i>
                <span>6. Staff Notes</span>
                @if (activeConsumables.Any() || staffNotesList.Any())
                {
                    <span class="tab-badge-pill">@(activeConsumables.Count + staffNotesList.Count)</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "STERILIZATION" ? "active" : "")" @onclick='() => SetTab("STERILIZATION")'>
                <i class="bi bi-shield-shaded"></i>
                <span>7. Sterilisation</span>
                @if (activeSterilizations.Any())
                {
                    <span class="tab-badge-pill">@activeSterilizations.Count</span>
                }
            </button>
        </div>

        <!-- 2-Column Split Workspace Body -->
        <div class="workspace-body-wrap">
            <div class="ot-workspace-grid">
                @if (selectedRequest == null)
                {
                    <div class="p-5 text-center bg-white rounded-3 border flex-1">
                        <i class="bi bi-hospital text-indigo-600" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 font-bold text-slate-800">No Surgical Case Selected</h4>
                        <p class="text-slate-500 font-12" style="max-width: 420px; margin: 0.5rem auto 1.5rem auto;">
                            Select an active surgery case from the search bar above or browse the complete surgical directory to load all 7 OT stages.
                        </p>
                        <button type="button" class="btn-indigo-action" @onclick="OpenCasesModal">
                            <i class="bi bi-folder2-open me-1"></i> Browse Surgery Cases
                        </button>
                    </div>
                }
                else if (isLoadingEpisode)
                {
                    <div class="p-5 text-center bg-white rounded-3 border flex-1">
                        <span class="spinner-border text-indigo-600" style="width: 2.5rem; height: 2.5rem;"></span>
                        <h5 class="mt-3 font-bold text-slate-800">Loading OT Surgical Episode...</h5>
                        <p class="text-slate-500 font-12">Retrieving schedules, surgical team, anesthesia assessment, and intra-operative logs.</p>
                    </div>
                }
                else
                {
                    <!-- LEFT COLUMN: ACTIVE STAGE FORM -->
                    <div class="ot-form-pane">
                        @* ═══════════════════════════════════════════════════════════════ *@
                        @* 1. OT REQUEST TAB                                              *@
                        @* ═══════════════════════════════════════════════════════════════ *@
                        @if (activeTab == "REQUEST")
                        {
                            <div class="entry-card-box">
                                <div class="entry-card-header-inline">
                                    <span class="entry-title-text">
                                        <i class="bi bi-file-earmark-plus text-indigo-600 fs-6"></i>
                                        1. Surgery Request &amp; Clinical Indication
                                    </span>
                                    <span class="badge @GetStatusBadgeClass(selectedRequest.status)">@selectedRequest.status</span>
                                </div>

                                <div class="form-grid-3">
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Procedure Name <span class="text-danger">*</span></label>
                                        <input type="text" class="nt-input-control" placeholder="e.g. Laparoscopic Appendectomy"
                                               @bind="selectedRequest.procedure_name" @bind:event="oninput" disabled="@(selectedRequest.status == "CANCELLED")" />
                                        <div class="suggestion-chips">
                                            <button type="button" class="chip-btn" @onclick='() => selectedRequest.procedure_name = "Laparoscopic Appendectomy"'>Appendectomy</button>
                                            <button type="button" class="chip-btn" @onclick='() => selectedRequest.procedure_name = "Laparoscopic Cholecystectomy"'>Cholecystectomy</button>
                                            <button type="button" class="chip-btn" @onclick='() => selectedRequest.procedure_name = "Hernioplasty (Inguinal)"'>Hernioplasty</button>
                                            <button type="button" class="chip-btn" @onclick='() => selectedRequest.procedure_name = "Total Knee Replacement (TKR)"'>TKR</button>
                                        </div>
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Procedure Code</label>
                                        <input type="text" class="nt-input-control" placeholder="e.g. SURG-012"
                                               @bind="selectedRequest.procedure_code" @bind:event="oninput" disabled="@(selectedRequest.status == "CANCELLED")" />
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Surgery Category</label>
                                        <select class="nt-select-control" @bind="selectedRequest.surgery_type" disabled="@(selectedRequest.status == "CANCELLED")">
                                            <option value="MAJOR">MAJOR SURGERY</option>
                                            <option value="MINOR">MINOR SURGERY</option>
                                            <option value="DAYCARE">DAYCARE SURGERY</option>
                                            <option value="EMERGENCY">EMERGENCY PROCEDURE</option>
                                            <option value="LAPAROSCOPIC">LAPAROSCOPIC</option>
                                            <option value="ROBOTIC">ROBOTIC SURGERY</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-grid-3 mt-3">
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Attending / Primary Surgeon <span class="text-danger">*</span></label>
                                        <select class="nt-select-control" @bind="selectedRequest.dcode" disabled="@(selectedRequest.status == "CANCELLED")">
                                            <option value="0">-- Select Surgeon --</option>
                                            @foreach (var doc in doctorsList)
                                            {
                                                <option value="@doc.dcode">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Priority / Urgency</label>
                                        <select class="nt-select-control" @bind="selectedRequest.priority" disabled="@(selectedRequest.status == "CANCELLED")">
                                            <option value="ELECTIVE">ELECTIVE (Planned)</option>
                                            <option value="URGENT">URGENT (&lt; 24 hrs)</option>
                                            <option value="EMERGENCY">EMERGENCY (Stat)</option>
                                        </select>
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Expected Duration (Minutes)</label>
                                        <input type="number" class="nt-input-control" placeholder="e.g. 120"
                                               @bind="selectedRequest.expected_duration_minutes" disabled="@(selectedRequest.status == "CANCELLED")" />
                                    </div>
                                </div>

                                <div class="form-grid-2 mt-3">
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Planned Anesthesia Type</label>
                                        <select class="nt-select-control" @bind="selectedRequest.anesthesia_type" disabled="@(selectedRequest.status == "CANCELLED")">
                                            <option value="GENERAL">GENERAL ANESTHESIA (GA)</option>
                                            <option value="SPINAL">SPINAL ANESTHESIA (SA)</option>
                                            <option value="EPIDURAL">EPIDURAL ANESTHESIA (EA)</option>
                                            <option value="REGIONAL">REGIONAL NERVE BLOCK</option>
                                            <option value="LOCAL">LOCAL ANESTHESIA (LA)</option>
                                            <option value="MAC">MONITORED ANESTHESIA CARE (MAC/Sedation)</option>
                                        </select>
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Procedure Base Fee (₹)</label>
                                        <input type="number" step="0.01" class="nt-input-control" placeholder="0.00"
                                               @bind="selectedRequest.procedure_fee" disabled="@(selectedRequest.status == "CANCELLED")" />
                                    </div>
                                </div>

                                <div class="form-field-unit mt-3">
                                    <label class="nt-form-label">Pre-Operative Clinical Diagnosis &amp; Indication</label>
                                    <textarea class="nt-input-control" rows="2" placeholder="Enter clinical diagnosis and surgical indication..."
                                              @bind="selectedRequest.diagnosis" disabled="@(selectedRequest.status == "CANCELLED")"></textarea>
                                </div>

                                <div class="form-field-unit mt-3">
                                    <label class="nt-form-label">Special OT Requirements / Surgical Instructions</label>
                                    <textarea class="nt-input-control" rows="2" placeholder="e.g. Blood reserve (2 units PRBC), C-Arm required, Laparoscopy tower, special positioning..."
                                              @bind="selectedRequest.notes" disabled="@(selectedRequest.status == "CANCELLED")"></textarea>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                    <button type="button" class="btn btn-outline-primary btn-sm font-bold" @onclick="SaveCurrentSurgeryRequestAsync" disabled="@isSavingTab">
                                        <i class="bi bi-check2-circle me-1"></i> Save Request Details
                                    </button>
                                    <button type="button" class="btn btn-primary btn-sm font-bold" @onclick='() => SetTab("SCHEDULE")'>
                                        <span>Proceed to Schedule</span> <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        }

                        @* ═══════════════════════════════════════════════════════════════ *@
                        @* 2. SCHEDULE TAB                                                *@
                        @* ═══════════════════════════════════════════════════════════════ *@
                        else if (activeTab == "SCHEDULE")
                        {
                            <div class="entry-card-box">
                                <div class="entry-card-header-inline">
                                    <span class="entry-title-text">
                                        <i class="bi bi-calendar2-check text-indigo-600 fs-6"></i>
                                        2. Operation Theater Suite &amp; Slot Schedule
                                    </span>
                                    <span class="badge @(activeSchedule != null ? "bg-success" : "bg-warning text-dark")">
                                        @(activeSchedule != null ? activeSchedule.status : "UNSCHEDULED")
                                    </span>
                                </div>

                                <!-- Visual Theater Suite Cards -->
                                <div class="form-field-unit mb-3">
                                    <label class="nt-form-label">Select Theater Suite <span class="text-danger">*</span></label>
                                    <div class="interactive-card-grid">
                                        @foreach (var ot in otTheaters)
                                        {
                                            var isSel = schedOtId == ot.ot_id;
                                            <div class="interactive-card @(isSel ? "active" : "")" @onclick="() => schedOtId = ot.ot_id">
                                                <i class="bi bi-hospital fs-5 mb-1 @(isSel ? "text-white" : "text-indigo-600")"></i>
                                                <span class="card-title">@ot.ot_name</span>
                                                <span class="card-sub">@(!string.IsNullOrWhiteSpace(ot.specialty) ? ot.specialty : "General OT")</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="form-grid-3 mt-3">
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Surgery Date <span class="text-danger">*</span></label>
                                        <input type="date" class="nt-input-control"
                                               value="@schedDate.ToString("yyyy-MM-dd")"
                                               @onchange="e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) schedDate = d; }" />
                                        <div class="suggestion-chips">
                                            <button type="button" class="chip-btn @(schedDate == DateOnly.FromDateTime(DateTime.Today) ? "active" : "")" @onclick="() => schedDate = DateOnly.FromDateTime(DateTime.Today)">Today</button>
                                            <button type="button" class="chip-btn @(schedDate == DateOnly.FromDateTime(DateTime.Today.AddDays(1)) ? "active" : "")" @onclick="() => schedDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1))">Tomorrow</button>
                                            <button type="button" class="chip-btn @(schedDate == DateOnly.FromDateTime(DateTime.Today.AddDays(2)) ? "active" : "")" @onclick="() => schedDate = DateOnly.FromDateTime(DateTime.Today.AddDays(2))">+2 Days</button>
                                        </div>
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Scheduled Start Time <span class="text-danger">*</span></label>
                                        <input type="time" class="nt-input-control"
                                               value="@schedTime.ToString("HH:mm")"
                                               @onchange="e => { if (TimeOnly.TryParse(e.Value?.ToString(), out var t)) { schedTime = t; schedEndTime = t.AddMinutes(selectedRequest?.expected_duration_minutes ?? 90); } }" />
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Estimated End Time</label>
                                        <input type="time" class="nt-input-control"
                                               value="@schedEndTime.ToString("HH:mm")"
                                               @onchange="e => { if (TimeOnly.TryParse(e.Value?.ToString(), out var t)) schedEndTime = t; }" />
                                    </div>
                                </div>

                                <div class="form-grid-2 mt-3">
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Booking Status</label>
                                        <select class="nt-select-control" @bind="activeScheduleStatus">
                                            <option value="BOOKED">BOOKED (Confirmed)</option>
                                            <option value="SCHEDULED">SCHEDULED</option>
                                            <option value="IN_PROGRESS">IN PROGRESS (In OT Now)</option>
                                            <option value="COMPLETED">COMPLETED</option>
                                            <option value="CANCELLED">CANCELLED</option>
                                        </select>
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Calculated Duration</label>
                                        <div class="nt-input-control d-flex align-items-center bg-light font-bold text-indigo-700">
                                            <i class="bi bi-stopwatch me-1.5"></i>
                                            @((schedEndTime - schedTime).TotalMinutes > 0 ? $"{(schedEndTime - schedTime).TotalMinutes} Minutes ({Math.Round((schedEndTime - schedTime).TotalHours, 1)} hrs)" : "Calculated upon timing")
                                        </div>
                                    </div>
                                </div>

                                <div class="form-field-unit mt-3">
                                    <label class="nt-form-label">Theater Scheduling &amp; Preparation Notes</label>
                                    <textarea class="nt-input-control" rows="2" placeholder="e.g. Cleared by PAC, 1st case on morning list, fasting confirmed from 10 PM..."
                                              @bind="schedNotes"></textarea>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                    <button type="button" class="btn btn-outline-secondary btn-sm font-bold" @onclick='() => SetTab("REQUEST")'>
                                        <i class="bi bi-arrow-left me-1"></i> Back to Request
                                    </button>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-outline-primary btn-sm font-bold" @onclick="SaveScheduleAsync" disabled="@isSavingTab">
                                            <i class="bi bi-check2-circle me-1"></i> Save Schedule
                                        </button>
                                        <button type="button" class="btn btn-primary btn-sm font-bold" @onclick='() => SetTab("TEAM")'>
                                            <span>Proceed to Team Members</span> <i class="bi bi-arrow-right ms-1"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        @* ═══════════════════════════════════════════════════════════════ *@
                        @* 3. TEAM MEMBERS TAB                                            *@
                        @* ═══════════════════════════════════════════════════════════════ *@
                        else if (activeTab == "TEAM")
                        {
                            <div class="entry-card-box">
                                <div class="entry-card-header-inline">
                                    <span class="entry-title-text">
                                        <i class="bi bi-people text-indigo-600 fs-6"></i>
                                        3. Surgical Team &amp; Clinical Staff Roster
                                    </span>
                                    <span class="badge bg-indigo-50 text-indigo-700 border border-indigo-200 font-bold">@activeTeam.Count Staff Allocated</span>
                                </div>

                                <!-- Add Staff Inline -->
                                <div class="p-3 bg-slate-50 rounded-3 border mb-3">
                                    <span class="nt-form-label d-block mb-2 text-primary font-bold">
                                        <i class="bi bi-person-plus-fill me-1"></i> Allocate Staff Member
                                    </span>
                                    <div class="form-grid-3">
                                        <div class="form-field-unit">
                                            <label class="nt-form-label">Role in Surgery</label>
                                            <select class="nt-select-control" @bind="teamRole">
                                                <option value="SURGEON">Chief / Operating Surgeon</option>
                                                <option value="ASST_SURGEON">Assistant Surgeon</option>
                                                <option value="ANESTHETIST">Chief Anesthetist</option>
                                                <option value="ASST_ANESTHETIST">Assistant Anesthetist</option>
                                                <option value="SCRUB_NURSE">Scrub Nurse</option>
                                                <option value="CIRCULATING_NURSE">Circulating Nurse</option>
                                                <option value="OT_TECHNICIAN">OT Technician</option>
                                                <option value="RECOVERY_NURSE">Recovery / PACU Nurse</option>
                                            </select>
                                        </div>
                                        <div class="form-field-unit">
                                            <label class="nt-form-label">Staff / Doctor Name</label>
                                            <input type="text" class="nt-input-control" placeholder="Enter staff or doctor name..."
                                                   @bind="teamStaffName" />
                                            <div class="suggestion-chips">
                                                @foreach (var d in doctorsList.Take(3))
                                                {
                                                    <button type="button" class="chip-btn" @onclick="() => { teamStaffName = d.name; teamStaffCode = d.dcode.ToString(); }">
                                                        Dr. @d.name
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                        <div class="form-field-unit d-flex justify-content-end align-items-end">
                                            <button type="button" class="btn btn-primary btn-sm font-bold w-100 py-2" @onclick="AddTeamMemberAsync">
                                                <i class="bi bi-plus-lg me-1"></i> Add to Team
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Team Table -->
                                <div class="ot-table-wrap">
                                    <table class="ot-data-table">
                                        <thead>
                                            <tr>
                                                <th>Staff Member</th>
                                                <th>Role in Case</th>
                                                <th>Staff ID</th>
                                                <th style="text-align: center;">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!activeTeam.Any())
                                            {
                                                <tr>
                                                    <td colspan="4" class="text-center py-4 text-muted">
                                                        <i class="bi bi-people d-block fs-4 mb-1 text-slate-300"></i>
                                                        <span>No surgical team members allocated yet.</span>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var member in activeTeam)
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="popover-avatar" style="width: 26px; height: 26px; font-size: 10px;">
                                                                    @GetInitials(member.staff_name)
                                                                </div>
                                                                <span class="font-bold text-slate-800">@member.staff_name</span>
                                                            </div>
                                                        </td>
                                                        <td><span class="badge @GetRoleBadgeClass(member.role)">@member.role</span></td>
                                                        <td class="font-mono text-muted">@(string.IsNullOrWhiteSpace(member.staff_code) ? "—" : member.staff_code)</td>
                                                        <td style="text-align: center;">
                                                            <button type="button" class="btn-trash-mini" title="Remove" @onclick="() => RemoveTeamMemberAsync(member)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                    <button type="button" class="btn btn-outline-secondary btn-sm font-bold" @onclick='() => SetTab("SCHEDULE")'>
                                        <i class="bi bi-arrow-left me-1"></i> Back to Schedule
                                    </button>
                                    <button type="button" class="btn btn-primary btn-sm font-bold" @onclick='() => SetTab("ANESTHESIA")'>
                                        <span>Proceed to Anaesthesia &amp; PAC</span> <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        }

                        @* ═══════════════════════════════════════════════════════════════ *@
                        @* 4. ANESTHESIA & PAC TAB                                        *@
                        @* ═══════════════════════════════════════════════════════════════ *@
                        else if (activeTab == "ANESTHESIA")
                        {
                            <div class="entry-card-box">
                                <div class="entry-card-header-inline">
                                    <span class="entry-title-text">
                                        <i class="bi bi-shield-check text-indigo-600 fs-6"></i>
                                        4. Pre-Anesthetic Assessment (PAC) &amp; Anesthesia Record
                                    </span>
                                    <span class="badge @GetFitnessBadgeClass(preOpFitness)">FITNESS: @preOpFitness</span>
                                </div>

                                <!-- ASA Physical Status Grade Cards -->
                                <div class="form-field-unit mb-3">
                                    <label class="nt-form-label">ASA Physical Status Classification <span class="text-danger">*</span></label>
                                    <div class="interactive-card-grid">
                                        <div class="interactive-card @(anesAsaGrade == "ASA I" ? "active" : "")" @onclick='() => anesAsaGrade = "ASA I"'>
                                            <span class="card-title">ASA I</span>
                                            <span class="card-sub">Normal Healthy</span>
                                        </div>
                                        <div class="interactive-card @(anesAsaGrade == "ASA II" ? "active" : "")" @onclick='() => anesAsaGrade = "ASA II"'>
                                            <span class="card-title">ASA II</span>
                                            <span class="card-sub">Mild Systemic</span>
                                        </div>
                                        <div class="interactive-card @(anesAsaGrade == "ASA III" ? "active" : "")" @onclick='() => anesAsaGrade = "ASA III"'>
                                            <span class="card-title">ASA III</span>
                                            <span class="card-sub">Severe Systemic</span>
                                        </div>
                                        <div class="interactive-card @(anesAsaGrade == "ASA IV" ? "active" : "")" @onclick='() => anesAsaGrade = "ASA IV"'>
                                            <span class="card-title">ASA IV</span>
                                            <span class="card-sub">Life-Threatening</span>
                                        </div>
                                        <div class="interactive-card @(anesAsaGrade == "ASA V" ? "active" : "")" @onclick='() => anesAsaGrade = "ASA V"'>
                                            <span class="card-title">ASA V</span>
                                            <span class="card-sub">Moribund</span>
                                        </div>
                                        <div class="interactive-card @(anesAsaGrade == "ASA E" ? "active" : "")" @onclick='() => anesAsaGrade = "ASA E"'>
                                            <span class="card-title">ASA E</span>
                                            <span class="card-sub">Emergency</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-grid-3 mt-3">
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">PAC Fitness Clearance Status</label>
                                        <select class="nt-select-control" @bind="preOpFitness">
                                            <option value="FIT">FIT / CLEARED FOR SURGERY</option>
                                            <option value="CONDITIONAL">CONDITIONAL CLEARANCE</option>
                                            <option value="HIGH_RISK">HIGH RISK CLEARANCE</option>
                                            <option value="PENDING">PAC EVALUATION PENDING</option>
                                            <option value="UNFIT">NOT FIT / SURGERY DEFERRED</option>
                                        </select>
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Mallampati Airway Score</label>
                                        <select class="nt-select-control" @bind="anesAirway">
                                            <option value="Class I">Class I (Complete visualization)</option>
                                            <option value="Class II">Class II (Soft palate &amp; uvula visible)</option>
                                            <option value="Class III">Class III (Soft palate &amp; base of uvula)</option>
                                            <option value="Class IV">Class IV (Hard palate only visible)</option>
                                        </select>
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Anesthesia Technique</label>
                                        <select class="nt-select-control" @bind="anesType">
                                            <option value="GENERAL">General Anesthesia (GA)</option>
                                            <option value="SPINAL">Spinal Anesthesia (Subarachnoid)</option>
                                            <option value="EPIDURAL">Epidural Anesthesia</option>
                                            <option value="REGIONAL">Regional Nerve Block</option>
                                            <option value="LOCAL">Local Infiltration</option>
                                            <option value="MAC">Monitored Anesthesia Care (MAC)</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-grid-2 mt-3">
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Pre-Operative Vitals Summary</label>
                                        <input type="text" class="nt-input-control" placeholder="e.g. BP: 120/80 mmHg, HR: 74 bpm, SpO2: 99%, RR: 16/min"
                                               @bind="preOpVitals" />
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label text-danger font-bold">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Known Drug Allergies
                                        </label>
                                        <input type="text" class="nt-input-control border-danger text-danger font-bold"
                                               placeholder="e.g. Penicillin, NSAIDs, Latex, Propofol or No Known Drug Allergies"
                                               @bind="preOpAllergies" />
                                    </div>
                                </div>

                                <div class="form-grid-2 mt-3">
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Induction Agents &amp; Anesthetic Drugs</label>
                                        <textarea class="nt-input-control" rows="2" placeholder="e.g. Inj. Propofol 150mg, Inj. Fentanyl 100mcg, Inj. Atracurium 35mg..."
                                                  @bind="anesDrugs"></textarea>
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Fluids &amp; Blood Products Administered</label>
                                        <textarea class="nt-input-control" rows="2" placeholder="e.g. Ringer Lactate 1000ml, Normal Saline 500ml, 1 unit PRBC..."
                                                  @bind="anesFluids"></textarea>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                    <button type="button" class="btn btn-outline-secondary btn-sm font-bold" @onclick='() => SetTab("TEAM")'>
                                        <i class="bi bi-arrow-left me-1"></i> Back to Team
                                    </button>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-outline-primary btn-sm font-bold" @onclick="SaveAnesthesiaAsync" disabled="@isSavingTab">
                                            <i class="bi bi-check2-circle me-1"></i> Save Anaesthesia
                                        </button>
                                        <button type="button" class="btn btn-primary btn-sm font-bold" @onclick='() => SetTab("SURGERY")'>
                                            <span>Proceed to Surgery Record</span> <i class="bi bi-arrow-right ms-1"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        @* ═══════════════════════════════════════════════════════════════ *@
                        @* 5. SURGERY / INTRA-OP & WHO CHECKLIST TAB                       *@
                        @* ═══════════════════════════════════════════════════════════════ *@
                        else if (activeTab == "SURGERY")
                        {
                            <div class="entry-card-box">
                                <div class="entry-card-header-inline">
                                    <span class="entry-title-text">
                                        <i class="bi bi-heart-pulse text-indigo-600 fs-6"></i>
                                        5. Intra-Operative Surgical Record &amp; WHO Safety Checklist
                                    </span>
                                    <span class="badge bg-purple-50 text-purple-700 border border-purple-200 font-bold">
                                        WHO Checklist
                                    </span>
                                </div>

                                <!-- WHO Surgical Safety Checklist -->
                                <div class="checklist-section-box">
                                    <div class="checklist-section-header">
                                        <span class="checklist-section-title">
                                            <i class="bi bi-check-circle-fill text-emerald-600"></i>
                                            WHO SURGICAL SAFETY CHECKLIST (SIGN IN, TIME OUT, SIGN OUT)
                                        </span>
                                        <button type="button" class="btn-check-all" @onclick="() => { chkPatientConfirmed = chkSiteMarked = chkConsentConfirmed = chkInvestigationsConfirmed = chkInstrumentsConfirmed = chkAntibioticGiven = true; }">
                                            <i class="bi bi-check-all me-1"></i> Check All
                                        </button>
                                    </div>

                                    <div class="checklist-grid">
                                        <div class="checklist-item @(chkPatientConfirmed ? "checked" : "")" @onclick="() => chkPatientConfirmed = !chkPatientConfirmed">
                                            <input type="checkbox" class="checklist-checkbox" @bind="chkPatientConfirmed" @onclick:stopPropagation />
                                            <span>1. Patient Identity, Site &amp; Procedure Confirmed</span>
                                        </div>
                                        <div class="checklist-item @(chkSiteMarked ? "checked" : "")" @onclick="() => chkSiteMarked = !chkSiteMarked">
                                            <input type="checkbox" class="checklist-checkbox" @bind="chkSiteMarked" @onclick:stopPropagation />
                                            <span>2. Surgical Site Marked by Surgeon</span>
                                        </div>
                                        <div class="checklist-item @(chkConsentConfirmed ? "checked" : "")" @onclick="() => chkConsentConfirmed = !chkConsentConfirmed">
                                            <input type="checkbox" class="checklist-checkbox" @bind="chkConsentConfirmed" @onclick:stopPropagation />
                                            <span>3. Informed Consent Verified</span>
                                        </div>
                                        <div class="checklist-item @(chkInvestigationsConfirmed ? "checked" : "")" @onclick="() => chkInvestigationsConfirmed = !chkInvestigationsConfirmed">
                                            <input type="checkbox" class="checklist-checkbox" @bind="chkInvestigationsConfirmed" @onclick:stopPropagation />
                                            <span>4. Diagnostic Imaging Displayed</span>
                                        </div>
                                        <div class="checklist-item @(chkInstrumentsConfirmed ? "checked" : "")" @onclick="() => chkInstrumentsConfirmed = !chkInstrumentsConfirmed">
                                            <input type="checkbox" class="checklist-checkbox" @bind="chkInstrumentsConfirmed" @onclick:stopPropagation />
                                            <span>5. Sterility of Trays Confirmed</span>
                                        </div>
                                        <div class="checklist-item @(chkAntibioticGiven ? "checked" : "")" @onclick="() => chkAntibioticGiven = !chkAntibioticGiven">
                                            <input type="checkbox" class="checklist-checkbox" @bind="chkAntibioticGiven" @onclick:stopPropagation />
                                            <span>6. Antibiotic Prophylaxis Administered</span>
                                        </div>
                                        <div class="checklist-item @(chkBloodArranged ? "checked" : "")" @onclick="() => chkBloodArranged = !chkBloodArranged">
                                            <input type="checkbox" class="checklist-checkbox" @bind="chkBloodArranged" @onclick:stopPropagation />
                                            <span>7. Blood Reserve Ready</span>
                                        </div>
                                        <div class="checklist-item @(chkImplantsConfirmed ? "checked" : "")" @onclick="() => chkImplantsConfirmed = !chkImplantsConfirmed">
                                            <input type="checkbox" class="checklist-checkbox" @bind="chkImplantsConfirmed" @onclick:stopPropagation />
                                            <span>8. Implants &amp; Prostheses Verified</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-grid-3 mt-3">
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Procedure Performed <span class="text-danger">*</span></label>
                                        <input type="text" class="nt-input-control" placeholder="e.g. Laparoscopic Appendectomy"
                                               @bind="intraProcedure" />
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Pre-Operative Diagnosis</label>
                                        <input type="text" class="nt-input-control" placeholder="e.g. Acute Appendicitis"
                                               @bind="intraDiagPre" />
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Post-Operative Diagnosis</label>
                                        <input type="text" class="nt-input-control" placeholder="e.g. Gangrenous Appendicitis"
                                               @bind="intraDiagPost" />
                                    </div>
                                </div>

                                <div class="form-grid-2 mt-3">
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Intra-Operative Clinical Findings</label>
                                        <textarea class="nt-input-control" rows="2" placeholder="Describe anatomical findings, tissue status, dissection details..."
                                                  @bind="intraFindings"></textarea>
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Operative Notes &amp; Closure Remarks</label>
                                        <textarea class="nt-input-control" rows="2" placeholder="Suture technique, closure layers, drain inserted, dressing..."
                                                  @bind="intraRemarks"></textarea>
                                    </div>
                                </div>

                                <div class="form-grid-3 mt-3">
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Estimated Blood Loss (mL)</label>
                                        <input type="number" class="nt-input-control" placeholder="50"
                                               @bind="intraBloodLoss" />
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Specimen for Biopsy</label>
                                        <select class="nt-select-control">
                                            <option value="YES">YES — Histopathology (HPE)</option>
                                            <option value="FROZEN">YES — Frozen Section</option>
                                            <option value="NO">NO Specimen</option>
                                        </select>
                                    </div>
                                    <div class="form-field-unit">
                                        <label class="nt-form-label">Sponge &amp; Needle Counts</label>
                                        <select class="nt-select-control text-success font-bold">
                                            <option value="CORRECT">VERIFIED CORRECT</option>
                                            <option value="INCORRECT">DISCREPANCY (Recounted)</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                    <button type="button" class="btn btn-outline-secondary btn-sm font-bold" @onclick='() => SetTab("ANESTHESIA")'>
                                        <i class="bi bi-arrow-left me-1"></i> Back to Anaesthesia
                                    </button>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-outline-primary btn-sm font-bold" @onclick="SaveIntraOpAsync" disabled="@isSavingTab">
                                            <i class="bi bi-check2-circle me-1"></i> Save Surgery Record
                                        </button>
                                        <button type="button" class="btn btn-primary btn-sm font-bold" @onclick='() => SetTab("STAFFNOTES")'>
                                            <span>Proceed to Staff Notes</span> <i class="bi bi-arrow-right ms-1"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        @* ═══════════════════════════════════════════════════════════════ *@
                        @* 6. STAFF NOTES & CONSUMABLES TAB                               *@
                        @* ═══════════════════════════════════════════════════════════════ *@
                        else if (activeTab == "STAFFNOTES")
                        {
                            <div class="entry-card-box">
                                <div class="entry-card-header-inline">
                                    <span class="entry-title-text">
                                        <i class="bi bi-journal-medical text-indigo-600 fs-6"></i>
                                        6. OT Staff Notes &amp; Consumable Medicines Log
                                    </span>
                                    <span class="badge bg-indigo-50 text-indigo-700 border border-indigo-200 font-bold">
                                        Total: ₹@GetTotalStaffConsumptionAmount().ToString("N2")
                                    </span>
                                </div>

                                <!-- Add Consumable Item Inline -->
                                <div class="p-3 bg-slate-50 rounded-3 border mb-3">
                                    <span class="nt-form-label d-block mb-2 text-primary font-bold">
                                        <i class="bi bi-cart-plus-fill me-1"></i> Log Consumable / Medicine Usage
                                    </span>
                                    <div class="form-grid-4">
                                        <div class="form-field-unit">
                                            <label class="nt-form-label">Category</label>
                                            <select class="nt-select-control" @bind="cItemType">
                                                <option value="MEDICINE">Medicine / Anesthetic</option>
                                                <option value="SUTURE">Suture / Blade</option>
                                                <option value="DISPOSABLE">Surgical Disposable</option>
                                                <option value="FLUID">IV Fluid</option>
                                                <option value="IMPLANT">Implant / Prosthesis</option>
                                            </select>
                                        </div>
                                        <div class="form-field-unit">
                                            <label class="nt-form-label">Item Name <span class="text-danger">*</span></label>
                                            <input type="text" class="nt-input-control" placeholder="e.g. Vicryl 2-0 / Propofol"
                                                   @bind="cItemName" />
                                        </div>
                                        <div class="form-field-unit">
                                            <label class="nt-form-label">Qty &amp; Unit</label>
                                            <div class="d-flex gap-1">
                                                <input type="number" class="nt-input-control" style="width: 60px;" placeholder="1" @bind="cQuantity" />
                                                <select class="nt-select-control" style="flex: 1;" @bind="cUnit">
                                                    <option value="PCS">PCS</option>
                                                    <option value="VIAL">VIAL</option>
                                                    <option value="AMP">AMP</option>
                                                    <option value="BTL">BTL</option>
                                                    <option value="PKT">PKT</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-field-unit">
                                            <label class="nt-form-label">Unit Rate (₹)</label>
                                            <div class="d-flex gap-1">
                                                <input type="number" step="0.01" class="nt-input-control" placeholder="0.00" @bind="cRate" />
                                                <button type="button" class="btn btn-primary btn-sm font-bold px-3" @onclick="AddConsumableItemAsync" title="Add">
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Consumables Table -->
                                <div class="ot-table-wrap">
                                    <table class="ot-data-table">
                                        <thead>
                                            <tr>
                                                <th>Category</th>
                                                <th>Item Name</th>
                                                <th style="text-align: center;">Qty</th>
                                                <th style="text-align: right;">Unit Price (₹)</th>
                                                <th style="text-align: right;">Total Amount (₹)</th>
                                                <th style="text-align: center;">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!activeConsumables.Any())
                                            {
                                                <tr>
                                                    <td colspan="6" class="text-center py-4 text-muted">
                                                        <i class="bi bi-bag-plus d-block fs-4 mb-1 text-slate-300"></i>
                                                        <span>No consumables logged yet.</span>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var item in activeConsumables)
                                                {
                                                    <tr>
                                                        <td><span class="badge bg-light text-dark border">@(item.remarks ?? "CONSUMABLE")</span></td>
                                                        <td class="font-bold text-slate-800">@item.item_name</td>
                                                        <td style="text-align: center;">@item.quantity @item.unit</td>
                                                        <td style="text-align: right;" class="font-mono">₹@((item.rate ?? 0).ToString("N2"))</td>
                                                        <td style="text-align: right;" class="font-mono font-bold text-emerald-700">₹@((item.quantity * (item.rate ?? 0)).ToString("N2"))</td>
                                                        <td style="text-align: center;">
                                                            <button type="button" class="btn-trash-mini" title="Remove" @onclick="() => RemoveConsumableItemAsync(item)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="form-field-unit mt-3">
                                    <label class="nt-form-label">Nursing Recovery &amp; PACU Transfer Notes</label>
                                    <textarea class="nt-input-control" rows="2" placeholder="e.g. Extubated smoothly on table, conscious and oriented, transferred to Recovery Room at 11:15 AM..."
                                              @bind="staffGeneralNotes"></textarea>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                    <button type="button" class="btn btn-outline-secondary btn-sm font-bold" @onclick='() => SetTab("SURGERY")'>
                                        <i class="bi bi-arrow-left me-1"></i> Back to Surgery
                                    </button>
                                    <button type="button" class="btn btn-primary btn-sm font-bold" @onclick='() => SetTab("STERILIZATION")'>
                                        <span>Proceed to Sterilisation</span> <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        }

                        @* ═══════════════════════════════════════════════════════════════ *@
                        @* 7. STERILISATION & CSSD TAB                                    *@
                        @* ═══════════════════════════════════════════════════════════════ *@
                        else if (activeTab == "STERILIZATION")
                        {
                            <div class="entry-card-box">
                                <div class="entry-card-header-inline">
                                    <span class="entry-title-text">
                                        <i class="bi bi-shield-shaded text-indigo-600 fs-6"></i>
                                        7. CSSD &amp; Instrument Sterilisation Tracking
                                    </span>
                                    <span class="badge bg-emerald-50 text-emerald-700 border border-emerald-200 font-bold">
                                        @activeSterilizations.Count Sterile Sets Verified
                                    </span>
                                </div>

                                <!-- Add Sterilization Set Inline -->
                                <div class="p-3 bg-slate-50 rounded-3 border mb-3">
                                    <span class="nt-form-label d-block mb-2 text-primary font-bold">
                                        <i class="bi bi-shield-plus me-1"></i> Verify Instrument Set Sterility
                                    </span>
                                    <div class="form-grid-4">
                                        <div class="form-field-unit">
                                            <label class="nt-form-label">Instrument Set / Tray <span class="text-danger">*</span></label>
                                            <input type="text" class="nt-input-control" placeholder="e.g. Major Laparotomy Set"
                                                   @bind="sterInstrumentSet" />
                                        </div>
                                        <div class="form-field-unit">
                                            <label class="nt-form-label">Sterilisation Method</label>
                                            <select class="nt-select-control" @bind="sterMethod">
                                                <option value="AUTOCLAVE">Steam Autoclave (134°C)</option>
                                                <option value="ETO">Ethylene Oxide (ETO)</option>
                                                <option value="PLASMA">Hydrogen Peroxide Plasma</option>
                                                <option value="FLASH">Flash Autoclave</option>
                                            </select>
                                        </div>
                                        <div class="form-field-unit">
                                            <label class="nt-form-label">Cycle / Machine No</label>
                                            <input type="text" class="nt-input-control" placeholder="e.g. CYC-2026-088"
                                                   @bind="sterCycleNumber" />
                                        </div>
                                        <div class="form-field-unit">
                                            <label class="nt-form-label">CSSD Technician / Nurse</label>
                                            <div class="d-flex gap-1">
                                                <input type="text" class="nt-input-control" placeholder="Staff Name" @bind="sterSterilizedBy" />
                                                <button type="button" class="btn btn-primary btn-sm font-bold px-3" @onclick="AddSterilizationRecordAsync" title="Log">
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sterilisation Table -->
                                <div class="ot-table-wrap">
                                    <table class="ot-data-table">
                                        <thead>
                                            <tr>
                                                <th>Instrument Set / Tray</th>
                                                <th>Method</th>
                                                <th>Cycle No</th>
                                                <th>CSSD Sign-Off</th>
                                                <th>Sterility Status</th>
                                                <th style="text-align: center;">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!activeSterilizations.Any())
                                            {
                                                <tr>
                                                    <td colspan="6" class="text-center py-4 text-muted">
                                                        <i class="bi bi-shield-x d-block fs-4 mb-1 text-slate-300"></i>
                                                        <span>No sterilization sets logged for this surgical case.</span>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var st in activeSterilizations)
                                                {
                                                    <tr>
                                                        <td class="font-bold text-slate-800">
                                                            <i class="bi bi-box-seam me-1 text-indigo-600"></i>@st.instrument_set
                                                        </td>
                                                        <td><span class="badge bg-light text-dark border">@st.sterilization_method</span></td>
                                                        <td class="font-mono">@st.cycle_number</td>
                                                        <td>@(string.IsNullOrWhiteSpace(st.sterilized_by) ? "CSSD Staff" : st.sterilized_by)</td>
                                                        <td>
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle font-bold">
                                                                <i class="bi bi-check-circle-fill me-1"></i>STERILE (VERIFIED)
                                                            </span>
                                                        </td>
                                                        <td style="text-align: center;">
                                                            <button type="button" class="btn-trash-mini" title="Remove" @onclick="() => RemoveSterilizationRecordAsync(st)">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                    <button type="button" class="btn btn-outline-secondary btn-sm font-bold" @onclick='() => SetTab("STAFFNOTES")'>
                                        <i class="bi bi-arrow-left me-1"></i> Back to Staff Notes
                                    </button>
                                    <button type="button" class="btn-finalize-surgery" @onclick="FinalizeSurgeryAsync" disabled="@isSavingTab">
                                        <i class="bi bi-check2-all me-1"></i> Finalize Surgery Case
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- RIGHT COLUMN: LIVE SURGERY DOSSIER SUMMARY CARD -->
                    <div class="ot-preview-pane">
                        <div class="ot-live-preview-card">
                            <div class="preview-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-journal-medical text-sky-300 fs-6"></i>
                                    <span class="preview-title">LIVE SURGERY DOSSIER</span>
                                </div>
                                <span class="badge-live-pulse"><span class="pulse-dot"></span>ACTIVE</span>
                            </div>

                            <!-- Patient Info Banner -->
                            <div class="preview-patient-banner">
                                <div class="preview-pat-name">@GetPatientName(selectedRequest.custid)</div>
                                <div class="preview-pat-sub">
                                    <span>MRN #@selectedRequest.custid.ToString("0")</span>
                                    <span>•</span>
                                    <span>@(activeSchedule != null ? activeSchedule.scheduled_date.ToString("dd-MMM-yyyy") : DateTime.Today.ToString("dd-MMM-yyyy"))</span>
                                </div>
                            </div>

                            <!-- Progress Bar -->
                            <div class="preview-progress-wrap">
                                <div class="preview-progress-label">
                                    <span>Overall OT Flow Completion</span>
                                    <span class="font-bold text-primary">@CalculateOverallProgress()%</span>
                                </div>
                                <div class="preview-progress-bar-bg">
                                    <div class="preview-progress-bar-fill" style="width: @CalculateOverallProgress()%;"></div>
                                </div>
                            </div>

                            <!-- Scrollable Summary Blocks -->
                            <div class="preview-scroll-content">
                                <!-- Block 1: Procedure & Urgency -->
                                <div class="preview-block">
                                    <div class="preview-block-title">
                                        <i class="bi bi-heart-pulse-fill text-indigo-600"></i>
                                        <span>Procedure &amp; Urgency</span>
                                    </div>
                                    <div class="font-bold text-slate-800 font-12">@selectedRequest.procedure_name</div>
                                    <div class="d-flex gap-2 align-items-center mt-1">
                                        <span class="badge @GetPriorityBadgeClass(selectedRequest.priority)">@selectedRequest.priority</span>
                                        <span class="badge bg-light text-dark border">@(selectedRequest.surgery_type ?? "MAJOR")</span>
                                        <span class="text-slate-600 font-11 font-semibold">Dr. @GetDoctorName(selectedRequest.dcode)</span>
                                    </div>
                                    @if (selectedRequest.procedure_fee.HasValue && selectedRequest.procedure_fee.Value > 0)
                                    {
                                        <div class="mt-1 font-11 text-emerald-700 font-mono font-bold">
                                            Base Fee: ₹@selectedRequest.procedure_fee.Value.ToString("N2")
                                        </div>
                                    }
                                </div>

                                <!-- Block 2: Theater & Timings -->
                                <div class="preview-block">
                                    <div class="preview-block-title">
                                        <i class="bi bi-calendar2-check-fill text-indigo-600"></i>
                                        <span>OT Theater &amp; Timings</span>
                                    </div>
                                    @if (activeSchedule != null)
                                    {
                                        var theaterName = otTheaters.FirstOrDefault(t => t.ot_id == activeSchedule.ot_id)?.ot_name ?? "OT Suite";
                                        <div class="font-bold text-indigo-700 font-12">@theaterName</div>
                                        <div class="text-slate-700 font-11 mt-1 font-mono">
                                            @activeSchedule.scheduled_date.ToString("dd-MMM-yyyy") (@activeSchedule.scheduled_time.ToString("hh\\:mm tt") - @activeSchedule.estimated_end_time.ToString("hh\\:mm tt"))
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted font-11 italic">Not scheduled yet.</span>
                                    }
                                </div>

                                <!-- Block 3: Pre-Op Fitness & Anesthesia -->
                                <div class="preview-block">
                                    <div class="preview-block-title">
                                        <i class="bi bi-shield-check-fill text-emerald-600"></i>
                                        <span>Anaesthesia &amp; PAC Fitness</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @GetFitnessBadgeClass(preOpFitness)">FITNESS: @preOpFitness</span>
                                        <span class="badge bg-indigo-50 text-indigo-700 border border-indigo-200">@anesAsaGrade</span>
                                    </div>
                                    <div class="text-slate-700 font-11 mt-1">
                                        <strong>Type:</strong> @anesType | <strong>Airway:</strong> @anesAirway
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(preOpAllergies))
                                    {
                                        <div class="text-danger font-11 font-bold mt-1">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Allergies: @preOpAllergies
                                        </div>
                                    }
                                </div>

                                <!-- Block 4: Surgical Team -->
                                <div class="preview-block">
                                    <div class="preview-block-title">
                                        <i class="bi bi-people-fill text-sky-600"></i>
                                        <span>Surgical Team Assigned (@activeTeam.Count)</span>
                                    </div>
                                    @if (!activeTeam.Any())
                                    {
                                        <span class="text-muted font-11 italic">No team members assigned.</span>
                                    }
                                    else
                                    {
                                        <div class="preview-team-pills">
                                            @foreach (var m in activeTeam)
                                            {
                                                <div class="preview-team-pill">
                                                    <span class="pill-role">@m.role:</span>
                                                    <span class="pill-name">@m.staff_name</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <!-- Block 5: WHO Checklist & Intra-Op -->
                                <div class="preview-block">
                                    <div class="preview-block-title">
                                        <i class="bi bi-check2-circle text-purple-600"></i>
                                        <span>WHO Checklist &amp; Intra-OP</span>
                                    </div>
                                    @{
                                        int checks = (chkPatientConfirmed ? 1 : 0) + (chkSiteMarked ? 1 : 0) + (chkConsentConfirmed ? 1 : 0) +
                                                     (chkInvestigationsConfirmed ? 1 : 0) + (chkInstrumentsConfirmed ? 1 : 0) + (chkAntibioticGiven ? 1 : 0) +
                                                     (chkBloodArranged ? 1 : 0) + (chkImplantsConfirmed ? 1 : 0);
                                    }
                                    <div class="font-11 text-slate-700">
                                        <strong>Safety Checklist:</strong> <span class="font-bold @(checks == 8 ? "text-success" : "text-primary")">@checks / 8 Verified</span>
                                    </div>
                                    <div class="text-slate-600 font-11 mt-1">
                                        <strong>Blood Loss:</strong> @(intraBloodLoss ?? 50) mL
                                    </div>
                                </div>

                                <!-- Block 6: Consumables & Sterility -->
                                <div class="preview-block">
                                    <div class="preview-block-title">
                                        <i class="bi bi-shield-shaded text-teal-600"></i>
                                        <span>Consumables &amp; Sterility</span>
                                    </div>
                                    <div class="font-11 text-slate-700">
                                        <strong>Items Logged:</strong> @activeConsumables.Count (₹@GetTotalStaffConsumptionAmount().ToString("N2"))
                                    </div>
                                    <div class="font-11 text-slate-700 mt-1">
                                        <strong>CSSD Trays:</strong> @(activeSterilizations.Any() ? $"{activeSterilizations.Count} Sterile Sets Verified" : "No Sets Logged")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- 4. STICKY BOTTOM ACTION TOOLBAR                                           -->
<!-- ========================================================================= -->
@if (selectedRequest != null)
{
    <div class="ot-bottom-action-bar">
        <div class="bar-left-group">
            <button type="button" class="btn-nav-step" @onclick="GoPreviousStage" disabled="@(activeTab == "REQUEST")">
                <i class="bi bi-chevron-left"></i> Previous Stage
            </button>
            <button type="button" class="btn-nav-step" @onclick="GoNextStage" disabled="@(activeTab == "STERILIZATION")">
                Next Stage <i class="bi bi-chevron-right"></i>
            </button>
        </div>

        <div class="bar-right-group">
            <button type="button" class="btn btn-outline-secondary btn-sm font-bold" @onclick="PrintOtRecordAsync" title="Print Surgical Record">
                <i class="bi bi-printer me-1"></i> Print Summary
            </button>
            <button type="button" class="btn-save-stage" @onclick="SaveActiveStageAsync" disabled="@isSavingTab">
                @if (isSavingTab)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i>
                    <span>Save Active Stage</span>
                }
            </button>
            <button type="button" class="btn-save-all" @onclick="SaveAllOtDataAsync" disabled="@isSavingTab">
                <i class="bi bi-floppy-fill"></i> Save Entire Case
            </button>
            <button type="button" class="btn-finalize-surgery" @onclick="FinalizeSurgeryAsync" disabled="@isSavingTab">
                <i class="bi bi-check2-all"></i> Finalize Surgery
            </button>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- 5. ALL SURGERY CASES DIRECTORY MODAL                                      -->
<!-- ========================================================================= -->
@if (showCasesModal)
{
    <div class="ot-modal-backdrop" @onclick="() => showCasesModal = false">
        <div class="ot-modal-dialog" @onclick:stopPropagation>
            <div class="ot-modal-header">
                <h5 class="ot-modal-title">
                    <i class="bi bi-folder2-open me-2 text-indigo-600"></i>All Surgery Cases Directory
                </h5>
                <button type="button" class="btn-close" @onclick="() => showCasesModal = false"></button>
            </div>
            <div class="ot-modal-body">
                <div class="mb-3">
                    <input type="text" class="nt-input-control" placeholder="Search by patient name, UHID, surgeon, procedure..."
                           @bind="casesModalSearch" @bind:event="oninput" />
                </div>
                <div class="ot-table-wrap">
                    <table class="ot-data-table">
                        <thead>
                            <tr>
                                <th>Patient Name</th>
                                <th>Procedure</th>
                                <th>Surgeon</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th style="text-align: center;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var modalList = allRequests.Where(r => string.IsNullOrWhiteSpace(casesModalSearch) ||
                                                                       (r.patient_name != null && r.patient_name.Contains(casesModalSearch, StringComparison.OrdinalIgnoreCase)) ||
                                                                       (r.procedure_name != null && r.procedure_name.Contains(casesModalSearch, StringComparison.OrdinalIgnoreCase)) ||
                                                                       r.custid.ToString().Contains(casesModalSearch) ||
                                                                       (r.doctor_name != null && r.doctor_name.Contains(casesModalSearch, StringComparison.OrdinalIgnoreCase))).ToList();
                            }
                            @if (!modalList.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No surgery cases found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var c in modalList)
                                {
                                    <tr>
                                        <td>
                                            <span class="font-bold text-slate-800">@GetPatientName(c.custid)</span>
                                            <span class="font-10 text-muted font-mono d-block">#@c.custid.ToString("0")</span>
                                        </td>
                                        <td class="text-indigo-600 font-bold">@c.procedure_name</td>
                                        <td>Dr. @GetDoctorName(c.dcode)</td>
                                        <td><span class="badge @GetPriorityBadgeClass(c.priority)">@c.priority</span></td>
                                        <td><span class="badge @GetStatusBadgeClass(c.status)">@c.status</span></td>
                                        <td style="text-align: center;">
                                            <button type="button" class="btn btn-sm btn-primary px-3 py-1 font-bold" @onclick="() => { SelectCaseFromDropdown(c); showCasesModal = false; }">
                                                Open Case
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? RequestId { get; set; }

    private List<OtSurgeryRequestListModel> allRequests = new();
    private List<OtMasterModel> otTheaters = new();
    private List<DoctorMasterModel> doctorsList = new();
    private bool isLoadingRequests = true;
    private string searchQuery = "";
    private OtSurgeryRequestListModel? selectedRequest = null;
    private bool isLoadingEpisode = false;
    private bool isSavingTab = false;

    // Tabs state
    private string activeTab = "REQUEST";

    // Modals
    private bool showCasesModal = false;
    private string casesModalSearch = "";
    private bool isCaseDropdownOpen = false;
    private int highlightedCaseIndex = 0;

    // Active Episode Caches
    private OtScheduleModel? activeSchedule = null;
    private List<OtTeamMemberModel> activeTeam = new();
    private OtPreOpAssessmentModel? activePreOp = null;
    private OtAnesthesiaModel? activeAnesthesia = null;
    private OtIntraOpModel? activeIntraOp = null;
    private List<OtConsumableModel> activeConsumables = new();
    private List<OtStaffNoteModel> staffNotesList = new();
    private List<OtSterilizationModel> activeSterilizations = new();

    // Tab 2: Schedule Bindings
    private Guid schedOtId = Guid.Empty;
    private DateOnly schedDate = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly schedTime = new TimeOnly(9, 0);
    private TimeOnly schedEndTime = new TimeOnly(10, 30);
    private string schedNotes = "";
    private string activeScheduleStatus = "BOOKED";

    // Tab 3: Team Bindings
    private string teamRole = "SURGEON";
    private string teamStaffName = "";
    private string teamStaffCode = "";

    // Tab 4: Anesthesia Bindings
    private string preOpFitness = "FIT";
    private string anesAsaGrade = "ASA I";
    private string anesAirway = "Class I";
    private string anesType = "GENERAL";
    private int? anesDoctorCode = null;
    private string preOpVitals = "";
    private string preOpAllergies = "No Known Drug Allergies";
    private string anesDrugs = "";
    private string anesFluids = "";

    // Tab 5: Intra-Op & WHO Checklist Bindings
    private bool chkPatientConfirmed = true;
    private bool chkSiteMarked = true;
    private bool chkConsentConfirmed = true;
    private bool chkInvestigationsConfirmed = true;
    private bool chkInstrumentsConfirmed = true;
    private bool chkAntibioticGiven = true;
    private bool chkBloodArranged = false;
    private bool chkImplantsConfirmed = false;
    private string intraProcedure = "";
    private string intraDiagPre = "";
    private string intraDiagPost = "";
    private string intraFindings = "";
    private int? intraBloodLoss = 50;
    private string intraRemarks = "";

    // Tab 6: Staff Notes & Consumables
    private string cItemType = "MEDICINE";
    private string cItemName = "";
    private decimal? cQuantity = 1;
    private string cUnit = "PCS";
    private decimal? cRate = 0;
    private string staffGeneralNotes = "";

    // Tab 7: Sterilization
    private string sterInstrumentSet = "";
    private string sterMethod = "AUTOCLAVE";
    private string sterCycleNumber = "";
    private string sterSterilizedBy = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadMasterDataAsync();
        await LoadAllRequestsAsync();

        if (RequestId.HasValue && RequestId.Value != Guid.Empty)
        {
            var match = allRequests.FirstOrDefault(r => r.request_id == RequestId.Value);
            if (match != null)
            {
                await SelectCaseFromDropdown(match);
            }
        }
        else if (allRequests.Any())
        {
            await SelectCaseFromDropdown(allRequests.First());
        }
    }

    private async Task LoadMasterDataAsync()
    {
        try
        {
            otTheaters = await OtService.GetOtMastersAsync(true);
            doctorsList = await DoctorService.GetDoctorsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading master data: {ex.Message}");
        }
    }

    private async Task LoadAllRequestsAsync()
    {
        isLoadingRequests = true;
        try
        {
            allRequests = await OtService.GetSurgeryRequestsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading surgery requests: {ex.Message}");
        }
        finally
        {
            isLoadingRequests = false;
        }
    }

    private IEnumerable<OtSurgeryRequestListModel> FilteredRequests =>
        allRequests.Where(r => string.IsNullOrWhiteSpace(searchQuery) ||
                               (r.patient_name != null && r.patient_name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                               (r.procedure_name != null && r.procedure_name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                               r.custid.ToString().Contains(searchQuery) ||
                               (r.doctor_name != null && r.doctor_name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)));

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private void GoPreviousStage()
    {
        var stages = new[] { "REQUEST", "SCHEDULE", "TEAM", "ANESTHESIA", "SURGERY", "STAFFNOTES", "STERILIZATION" };
        var idx = Array.IndexOf(stages, activeTab);
        if (idx > 0) activeTab = stages[idx - 1];
    }

    private void GoNextStage()
    {
        var stages = new[] { "REQUEST", "SCHEDULE", "TEAM", "ANESTHESIA", "SURGERY", "STAFFNOTES", "STERILIZATION" };
        var idx = Array.IndexOf(stages, activeTab);
        if (idx >= 0 && idx < stages.Length - 1) activeTab = stages[idx + 1];
    }

    private int CalculateOverallProgress()
    {
        if (selectedRequest == null) return 0;
        int completed = 1; // Request exists
        if (activeSchedule != null) completed++;
        if (activeTeam.Any()) completed++;
        if (activePreOp != null || !string.IsNullOrWhiteSpace(preOpVitals)) completed++;
        if (activeIntraOp != null || !string.IsNullOrWhiteSpace(intraFindings)) completed++;
        if (activeConsumables.Any()) completed++;
        if (activeSterilizations.Any()) completed++;
        return (int)Math.Round((completed / 7.0) * 100);
    }

    private async Task SelectCaseFromDropdown(OtSurgeryRequestListModel req)
    {
        selectedRequest = req;
        isCaseDropdownOpen = false;
        searchQuery = "";
        await LoadSelectedEpisodeDataAsync();
    }

    private async Task LoadSelectedEpisodeDataAsync()
    {
        if (selectedRequest == null) return;
        isLoadingEpisode = true;
        StateHasChanged();

        try
        {
            var reqId = selectedRequest.request_id;
            
            // Load Schedule
            activeSchedule = await OtService.GetScheduleByRequestAsync(reqId);
            if (activeSchedule != null)
            {
                schedOtId = activeSchedule.ot_id;
                schedDate = activeSchedule.scheduled_date;
                schedTime = activeSchedule.scheduled_time;
                schedEndTime = activeSchedule.estimated_end_time;
                schedNotes = activeSchedule.notes ?? "";
                activeScheduleStatus = activeSchedule.status;
            }
            else
            {
                schedOtId = otTheaters.FirstOrDefault()?.ot_id ?? Guid.Empty;
                schedDate = DateOnly.FromDateTime(DateTime.Today);
                schedTime = new TimeOnly(9, 0);
                schedEndTime = new TimeOnly(10, 30);
                schedNotes = "";
                activeScheduleStatus = "BOOKED";
            }

            // Load Team
            activeTeam = await OtService.GetTeamByRequestAsync(reqId);

            // Load Pre-Op Assessment
            activePreOp = await OtService.GetPreOpByRequestAsync(reqId);
            if (activePreOp != null)
            {
                preOpFitness = activePreOp.fitness_status;
                preOpVitals = activePreOp.vitals_summary ?? "";
                preOpAllergies = activePreOp.allergies ?? "No Known Drug Allergies";
            }

            // Load Anesthesia
            activeAnesthesia = await OtService.GetAnesthesiaByRequestAsync(reqId);
            if (activeAnesthesia != null)
            {
                anesAsaGrade = activeAnesthesia.asa_grade ?? "ASA I";
                anesAirway = activeAnesthesia.airway_assessment ?? "Class I";
                anesType = activeAnesthesia.anesthesia_type ?? "GENERAL";
                anesDoctorCode = activeAnesthesia.anesthetist_dcode;
                anesDrugs = activeAnesthesia.drugs_used ?? "";
                anesFluids = activeAnesthesia.fluids_given ?? "";
            }

            // Load Intra-Op
            activeIntraOp = await OtService.GetIntraOpByRequestAsync(reqId);
            if (activeIntraOp != null)
            {
                intraProcedure = activeIntraOp.procedure_performed ?? selectedRequest.procedure_name;
                intraDiagPre = activeIntraOp.diagnosis_pre ?? selectedRequest.diagnosis ?? "";
                intraDiagPost = activeIntraOp.diagnosis_post ?? "";
                intraFindings = activeIntraOp.findings ?? "";
                intraBloodLoss = activeIntraOp.blood_loss_ml ?? 50;
                intraRemarks = activeIntraOp.remarks ?? "";
            }
            else
            {
                intraProcedure = selectedRequest.procedure_name;
                intraDiagPre = selectedRequest.diagnosis ?? "";
            }

            // Load Consumables & Staff Notes
            activeConsumables = await OtService.GetConsumablesByRequestAsync(reqId);
            staffNotesList = await OtService.GetStaffNotesByRequestAsync(reqId);

            // Load Sterilization
            activeSterilizations = await OtService.GetSterilizationsByRequestAsync(reqId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading episode data: {ex.Message}");
        }
        finally
        {
            isLoadingEpisode = false;
            StateHasChanged();
        }
    }

    private async Task SaveActiveStageAsync()
    {
        switch (activeTab)
        {
            case "REQUEST":
                await SaveCurrentSurgeryRequestAsync();
                break;
            case "SCHEDULE":
                await SaveScheduleAsync();
                break;
            case "TEAM":
                ToastService.ShowSuccess("Team allocations verified.");
                break;
            case "ANESTHESIA":
                await SaveAnesthesiaAsync();
                break;
            case "SURGERY":
                await SaveIntraOpAsync();
                break;
            case "STAFFNOTES":
                ToastService.ShowSuccess("Staff notes and consumables updated.");
                break;
            case "STERILIZATION":
                ToastService.ShowSuccess("Sterilization logs updated.");
                break;
        }
    }

    private async Task SaveCurrentSurgeryRequestAsync()
    {
        if (selectedRequest == null) return;
        isSavingTab = true;
        StateHasChanged();
        try
        {
            var updateReq = new UpdateSurgeryRequestRequest
            {
                request_id = selectedRequest.request_id,
                procedure_name = selectedRequest.procedure_name,
                procedure_code = selectedRequest.procedure_code,
                surgery_type = selectedRequest.surgery_type,
                priority = selectedRequest.priority,
                expected_duration_minutes = selectedRequest.expected_duration_minutes,
                anesthesia_type = selectedRequest.anesthesia_type,
                diagnosis = selectedRequest.diagnosis,
                notes = selectedRequest.notes
            };
            var res = await OtService.UpdateSurgeryRequestAsync(updateReq);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess("Surgery request details saved successfully!");
            }
            else
            {
                ToastService.ShowError($"Failed to save: {res.message}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isSavingTab = false;
            StateHasChanged();
        }
    }

    private async Task SaveScheduleAsync()
    {
        if (selectedRequest == null) return;
        if (schedOtId == Guid.Empty)
        {
            ToastService.ShowError("Please select an Operation Theater suite.");
            return;
        }

        isSavingTab = true;
        StateHasChanged();
        try
        {
            if (activeSchedule != null && activeSchedule.schedule_id != Guid.Empty)
            {
                var updateReq = new UpdateOtScheduleRequest
                {
                    schedule_id = activeSchedule.schedule_id,
                    ot_id = schedOtId,
                    scheduled_date = schedDate,
                    scheduled_time = schedTime,
                    estimated_end_time = schedEndTime,
                    status = activeScheduleStatus,
                    notes = schedNotes
                };
                var res = await OtService.UpdateScheduleAsync(updateReq);
                if (res.IsSuccess)
                {
                    ToastService.ShowSuccess("OT Schedule updated successfully!");
                    activeSchedule.ot_id = schedOtId;
                    activeSchedule.scheduled_date = schedDate;
                    activeSchedule.scheduled_time = schedTime;
                    activeSchedule.estimated_end_time = schedEndTime;
                    activeSchedule.status = activeScheduleStatus;
                }
                else
                {
                    ToastService.ShowError($"Schedule failed: {res.message}");
                }
            }
            else
            {
                var addReq = new AddOtScheduleRequest
                {
                    request_id = selectedRequest.request_id,
                    ot_id = schedOtId,
                    custid = selectedRequest.custid,
                    scheduled_date = schedDate,
                    scheduled_time = schedTime,
                    estimated_end_time = schedEndTime,
                    notes = schedNotes
                };
                var res = await OtService.AddScheduleAsync(addReq);
                if (res.IsSuccess)
                {
                    ToastService.ShowSuccess("OT Schedule booked successfully!");
                    await LoadSelectedEpisodeDataAsync();
                }
                else
                {
                    ToastService.ShowError($"Failed to book slot: {res.message}");
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isSavingTab = false;
            StateHasChanged();
        }
    }

    private async Task AddTeamMemberAsync()
    {
        if (selectedRequest == null) return;
        if (string.IsNullOrWhiteSpace(teamStaffName))
        {
            ToastService.ShowError("Please enter staff or doctor name.");
            return;
        }

        try
        {
            var req = new AddOtTeamMemberRequest
            {
                request_id = selectedRequest.request_id,
                role = teamRole,
                staff_name = teamStaffName,
                staff_code = teamStaffCode
            };
            var res = await OtService.AddTeamMemberAsync(req);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess($"Added {teamStaffName} ({teamRole}) to surgical team!");
                teamStaffName = "";
                teamStaffCode = "";
                activeTeam = await OtService.GetTeamByRequestAsync(selectedRequest.request_id);
            }
            else
            {
                ToastService.ShowError(res.message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task RemoveTeamMemberAsync(OtTeamMemberModel member)
    {
        try
        {
            var res = await OtService.RemoveTeamMemberAsync(member.team_id);
            if (res.IsSuccess)
            {
                activeTeam.Remove(member);
                ToastService.ShowSuccess("Team member removed.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task SaveAnesthesiaAsync()
    {
        if (selectedRequest == null) return;
        isSavingTab = true;
        StateHasChanged();
        try
        {
            // Save Pre-Op Assessment
            if (activePreOp != null && activePreOp.preop_id != Guid.Empty)
            {
                var updatePreOp = new UpdatePreOpAssessmentRequest
                {
                    preop_id = activePreOp.preop_id,
                    fitness_status = preOpFitness,
                    vitals_summary = preOpVitals,
                    allergies = preOpAllergies,
                    clearance_notes = anesFluids
                };
                await OtService.UpdatePreOpAsync(updatePreOp);
            }
            else
            {
                var preOpReq = new AddPreOpAssessmentRequest
                {
                    request_id = selectedRequest.request_id,
                    custid = selectedRequest.custid,
                    fitness_status = preOpFitness,
                    vitals_summary = preOpVitals,
                    allergies = preOpAllergies,
                    clearance_notes = anesFluids
                };
                await OtService.AddPreOpAsync(preOpReq);
            }

            // Save Anesthesia
            var anesReq = new SaveOtAnesthesiaRequest
            {
                request_id = selectedRequest.request_id,
                custid = selectedRequest.custid,
                anesthesia_type = anesType,
                asa_grade = anesAsaGrade,
                airway_assessment = anesAirway,
                anesthetist_dcode = anesDoctorCode,
                drugs_used = anesDrugs,
                fluids_given = anesFluids
            };
            var res = await OtService.SaveAnesthesiaAsync(anesReq);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess("Anaesthesia record saved successfully!");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving anesthesia: {ex.Message}");
        }
        finally
        {
            isSavingTab = false;
            StateHasChanged();
        }
    }

    private async Task SaveIntraOpAsync()
    {
        if (selectedRequest == null) return;
        isSavingTab = true;
        StateHasChanged();
        try
        {
            // Save Checklist
            var chkReq = new SaveOtChecklistRequest
            {
                request_id = selectedRequest.request_id,
                patient_confirmed = chkPatientConfirmed,
                site_marked = chkSiteMarked,
                consent_confirmed = chkConsentConfirmed,
                investigations_confirmed = chkInvestigationsConfirmed,
                instruments_confirmed = chkInstrumentsConfirmed,
                antibiotic_given = chkAntibioticGiven,
                blood_arranged = chkBloodArranged,
                implants_confirmed = chkImplantsConfirmed
            };
            await OtService.SaveChecklistAsync(chkReq);

            // Save Intra-Op
            var intraReq = new SaveOtIntraOpRequest
            {
                request_id = selectedRequest.request_id,
                custid = selectedRequest.custid,
                procedure_performed = intraProcedure,
                diagnosis_pre = intraDiagPre,
                diagnosis_post = intraDiagPost,
                findings = intraFindings,
                blood_loss_ml = intraBloodLoss,
                remarks = intraRemarks
            };
            var res = await OtService.SaveIntraOpAsync(intraReq);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess("Intra-operative record & safety checklist saved!");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving intra-op: {ex.Message}");
        }
        finally
        {
            isSavingTab = false;
            StateHasChanged();
        }
    }

    private async Task AddConsumableItemAsync()
    {
        if (selectedRequest == null) return;
        if (string.IsNullOrWhiteSpace(cItemName))
        {
            ToastService.ShowError("Please enter item name.");
            return;
        }

        try
        {
            var req = new AddOtConsumableRequest
            {
                request_id = selectedRequest.request_id,
                item_name = cItemName,
                quantity = cQuantity ?? 1,
                unit = cUnit,
                rate = cRate ?? 0,
                amount = (cQuantity ?? 1) * (cRate ?? 0),
                remarks = cItemType
            };
            var res = await OtService.AddConsumableAsync(req);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess($"Added {cItemName} to consumption list.");
                cItemName = "";
                cQuantity = 1;
                cRate = 0;
                activeConsumables = await OtService.GetConsumablesByRequestAsync(selectedRequest.request_id);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

