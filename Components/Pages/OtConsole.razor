    #region Helper Formatters

    private DoctorMasterModel? GetDoctor(int dcode)
    {
        if (dcode <= 0) return null;
        return doctorsList.FirstOrDefault(d => d.dcode == dcode);
    }

    private string FormatDoctorDisplayName(int dcode, string? fallbackName = null)
    {
        var doc = GetDoctor(dcode);
        var rawName = doc != null
            ? (!string.IsNullOrWhiteSpace(doc.name) ? doc.name.Trim() : (doc.doctorfullname?.Trim() ?? ""))
            : (fallbackName?.Trim() ?? "");

        if (string.IsNullOrWhiteSpace(rawName))
            return dcode > 0 ? $"Doctor #{dcode}" : "Doctor";

        if (rawName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ||
            rawName.StartsWith("Dr ", StringComparison.OrdinalIgnoreCase) ||
            rawName.StartsWith("Doctor", StringComparison.OrdinalIgnoreCase))
        {
            return rawName;
        }

        return $"Dr. {rawName}";
    }

    private string GetDoctorSingleInitial(int dcode, string? fallbackName = null)
    {
        var doc = GetDoctor(dcode);
        var rawName = doc != null
            ? (!string.IsNullOrWhiteSpace(doc.name) ? doc.name.Trim() : (doc.doctorfullname?.Trim() ?? ""))
            : (fallbackName?.Trim() ?? "");

        if (string.IsNullOrWhiteSpace(rawName)) return "D";

        var clean = rawName;
        if (clean.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase)) clean = clean.Substring(3).Trim();
        else if (clean.StartsWith("Dr ", StringComparison.OrdinalIgnoreCase)) clean = clean.Substring(3).Trim();
        else if (clean.StartsWith("Doctor", StringComparison.OrdinalIgnoreCase)) clean = clean.Substring(6).Trim();

        if (string.IsNullOrWhiteSpace(clean)) return "D";
        return char.ToUpper(clean[0]).ToString();
    }

    private string GetWardBedDisplay(string? wardName, string? bedNo)
    {
        var w = !string.IsNullOrWhiteSpace(wardName) ? wardName.Trim() : "General";
        if (string.IsNullOrWhiteSpace(bedNo) || bedNo == "—" || bedNo == "-")
        {
            return w;
        }

        var b = bedNo.Trim();
        if (b.StartsWith("Bed", StringComparison.OrdinalIgnoreCase))
        {
            return $"{w} - {b}";
        }
        return $"{w} - Bed {b}";
    }

    private async Task LoadDoctorPhotoAsync(int dcode, string? fileName, string? doctorTenantCode)
    {
        if (string.IsNullOrEmpty(fileName) || dcode <= 0) return;
        if (doctorImagesBase64.ContainsKey(dcode)) return;

        doctorImagesBase64[dcode] = "";

        try
        {
            string key = fileName;
            if (!fileName.Contains("/"))
            {
                string tc = string.IsNullOrEmpty(doctorTenantCode) ? TenantState?.TenantCode ?? "0010" : doctorTenantCode;
                if (string.IsNullOrEmpty(tc)) tc = "0010";
                key = $"medico/{tc}/doctors/{dcode}/{fileName}";
            }

            var base64 = await DoctorService.DownloadFileAsBase64Async(key);
            if (!string.IsNullOrEmpty(base64))
            {
                doctorImagesBase64[dcode] = base64;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadDoctorPhotoAsync] Error loading photo for dcode {dcode}: {ex.Message}");
        }
    }

    private string GetPatientName(decimal custid)
    {
        var match = allRequests.FirstOrDefault(r => r.custid == custid);
        if (match != null && !string.IsNullOrWhiteSpace(match.patient_name))
            return match.patient_name;
        return $"Patient #{custid:0}";
    }

    private string GetDoctorName(int dcode)
    {
        return FormatDoctorDisplayName(dcode);
    }

    private string GetTheaterName(Guid otId)
    {
        var ot = otTheaters.FirstOrDefault(t => t.ot_id == otId);
        return ot?.ot_name ?? "OT Suite";
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "OT";
        var clean = name.Replace("Dr.", "").Replace("Dr ", "").Trim();
        var parts = clean.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "OT";
        if (parts.Length == 1)
            return parts[0].Length >= 2 ? parts[0].Substring(0, 2).ToUpper() : parts[0].ToUpper();
        return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();
    }

