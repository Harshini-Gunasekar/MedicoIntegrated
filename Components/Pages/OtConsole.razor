    .interactive-card:hover:not(.active) {
        background: #f1f5f9;
        border-color: #cbd5e1;
        transform: translateY(-1px);
    }

    .interactive-card.active {
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%) !important;
