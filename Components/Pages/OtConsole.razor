    private void SelectConsumableItem(item_master item)
    {
        if (item == null) return;
        cSelectedItemCode = item.itemcode;
        cItemName = item.itemname ?? "";
        cItemCode = !string.IsNullOrWhiteSpace(item.shortname) ? item.shortname : item.itemcode.ToString();
        
        // Unit from ItemMaster / UomMaster
        var resolvedUom = GetUomName(item.uomcode);
        cUnit = !string.IsNullOrWhiteSpace(resolvedUom) ? resolvedUom : "PCS";

        // Rate from ItemMaster mrp / salesrate
        cRate = GetItemUnitMrp(item);

        // Check if there are available batches in stock for this item
        var matchingStocks = StockList
            .Where(s => s.itemcode == item.itemcode && s.closingstock > 0 && !string.IsNullOrWhiteSpace(s.batchno))
            .OrderBy(s => s.expirydate ?? DateTime.MaxValue)
            .ToList();

        if (matchingStocks.Any())
        {
            var firstStock = matchingStocks.First();
            cBatchNo = firstStock.batchno ?? "";
            if (firstStock.mrpunit > 0 && (cRate == null || cRate <= 0))
            {
                cRate = firstStock.mrpunit;
            }
        }
        else
        {
            cBatchNo = "";
        }

        isConsItemDropdownOpen = false;
        StateHasChanged();
    }

    private void SelectConsumableBatch(stock_master stock)
    {
        if (stock == null) return;
        cBatchNo = stock.batchno ?? "";
        if (stock.mrpunit > 0)
        {
            cRate = stock.mrpunit;
        }
        else if (stock.unitcost > 0 && (cRate == null || cRate <= 0))
        {
            cRate = stock.unitcost;
        }

        if (cSelectedItemCode <= 0 && stock.itemcode > 0)
        {
            var matchedItem = ItemList.FirstOrDefault(i => i.itemcode == stock.itemcode);
            if (matchedItem != null)
            {
                cSelectedItemCode = matchedItem.itemcode;
                cItemName = matchedItem.itemname ?? "";
                cItemCode = !string.IsNullOrWhiteSpace(matchedItem.shortname) ? matchedItem.shortname : matchedItem.itemcode.ToString();
                var resolvedUom = GetUomName(matchedItem.uomcode);
                if (!string.IsNullOrWhiteSpace(resolvedUom)) cUnit = resolvedUom;
            }
        }

        isConsBatchDropdownOpen = false;
        StateHasChanged();
    }

