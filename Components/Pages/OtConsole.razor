                                                                <button type="button" class="btn" @onclick="SaveIntraOpRecordAsync" title="Save Intra-OP Record"
                                                                        style="width: 30px; height: 30px; min-width: 30px; border-radius: 6px; background: #10b981; color: #ffffff; border: none; display: inline-flex; align-items: center; justify-content: center; padding: 0; box-shadow: 0 2px 4px rgba(16, 185, 129, 0.25); cursor: pointer; flex-shrink: 0; transition: all 0.15s;">
