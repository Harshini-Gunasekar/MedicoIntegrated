                {
                    <button type="button" class="team-btn-primary" @onclick="SaveTeamMemberAsync">
                        <i class="bi bi-plus-circle-fill me-1.5"></i>
                        <span>Add Member</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

