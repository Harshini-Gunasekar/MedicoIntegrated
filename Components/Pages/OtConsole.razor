    private async Task SaveImplantAsync()
    {
        if (selectedRequest == null) return;
        if (string.IsNullOrWhiteSpace(impItemName))
        {
            ToastService.ShowWarning("Please enter implant name.");
            return;
        }
        if (!impQuantity.HasValue || impQuantity.Value <= 0)
        {
            ToastService.ShowWarning("Please enter a valid quantity.");
            return;
        }

        try
        {
            var impReq = new AddOtImplantRequest
            {
                request_id = selectedRequest.request_id,
                custid = selectedRequest.custid,
                item_name = impItemName.Trim(),
                manufacturer = impManufacturer.Trim(),
                serial_no = impSerialNo.Trim(),
                batch_no = impBatchNo.Trim(),
                quantity = impQuantity.Value,
                rate = impRate,
                amount = (impRate ?? 0) * impQuantity.Value,
                remarks = impRemarks
            };

            var res = await OtService.AddImplantAsync(impReq);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess("Implant added & queued into Unbilled Charges!");
                showAddImplantModal = false;
                await LoadCaseDataAsync(selectedRequest.request_id);
            }
            else
            {
                ToastService.ShowError(res.message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error adding implant: {ex.Message}");
        }
    }

