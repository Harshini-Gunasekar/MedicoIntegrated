        if (selectedRequest == null) return;
        if (schedOtId == Guid.Empty)
        {
            ToastService.ShowWarning("Please select an Operation Theater Suite.");
            return;
        }

        try
        {
            if (activeSchedule != null && activeSchedule.schedule_id != Guid.Empty)
            {
                var req = new UpdateOtScheduleRequest
                {
                    schedule_id = activeSchedule.schedule_id,
                    ot_id = schedOtId,
                    scheduled_date = schedDate,
                    scheduled_time = schedTime,
                    estimated_end_time = schedEndTime,
                    status = activeSchedule.status,
                    notes = schedNotes
                };
                var res = await OtService.UpdateScheduleAsync(req);
                if (res.IsSuccess)
                {
                    ToastService.ShowSuccess("Operation Theater slot updated successfully!");
                    showScheduleModal = false;
                    await LoadRequestsAsync();
                    await LoadCaseDataAsync(selectedRequest.request_id);
                }
                else
                {
                    ToastService.ShowError(res.message);
                }
            }
            else
            {
                var req = new AddOtScheduleRequest
                {
                    request_id = selectedRequest.request_id,
                    ot_id = schedOtId,
                    custid = selectedRequest.custid,
                    scheduled_date = schedDate,
                    scheduled_time = schedTime,
                    estimated_end_time = schedEndTime,
                    notes = schedNotes
                };
                var res = await OtService.AddScheduleAsync(req);
                if (res.IsSuccess)
                {
                    ToastService.ShowSuccess("Operation Theater slot scheduled successfully!");
                    showScheduleModal = false;
                    await LoadRequestsAsync();
                    await LoadCaseDataAsync(selectedRequest.request_id);
                }
                else
                {
                    ToastService.ShowError(res.message);
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Scheduling error: {ex.Message}");
        }
    }

