@page "/ot-console"
@page "/ot-console/{RequestId:guid}"
@page "/ot-dashboard"
@page "/ot-surgery"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using medico_backend.Model
@using Medico_Backend.Model
@using Booking.Services
@using Booking.Models
@using Booking.Helpers
@using Newtonsoft.Json
@inject OtService OtService
@inject DoctorService DoctorService
@inject LabSettingService LabSettingService
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.NurseMasterService NurseMasterService
@inject Booking.Services.CaseSheetService CaseSheetService
@inject Booking.Services.UomMasterService UomMasterService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject IJSRuntime JSRuntime

<PageTitle>OT Console — Operation Theater Clinical Console</PageTitle>

<div class="referral-page lc-fadeInUp" @onclick="HandlePageClick">
    <!-- ========================================================================= -->
    <!-- 1. HEADER CONSOLE (NURSE NOTES THEMED)                                    -->
    <!-- ========================================================================= -->
    <div class="lab-header-card mb-3">
        <div class="header-left-wrap">
            <div class="header-icon-box">
                <i class="bi bi-hospital fs-4"></i>
            </div>
            <div class="header-title-group">
                <h2 class="lab-title-text m-0">Operation Theater Clinical Console</h2>
                <div class="header-status-indicator">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Surgical Episodes, OT Scheduling &amp; Clinical Records</span>
                </div>
            </div>
        </div>

        <div class="header-right-wrap">
            <!-- Surgery Cases Button -->
            <button type="button" class="btn-ip-patients-nav" @onclick="OpenCasesModal" title="View all surgery cases list">
                <i class="bi bi-folder2-open nav-btn-icon"></i>
                <span>Surgery Cases</span>
                <span class="ip-count-badge">@allRequests.Count</span>
            </button>

            <!-- Case Search Autocomplete Pill Box -->
            <div class="patient-search-relative" @onclick:stopPropagation>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#6366f1" viewBox="0 0 16 16" class="search-icon-svg">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text"
                       placeholder="Search patient / doctor / procedure / #ID..."
                       class="lc-rounded-pill-input"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onfocus="() => { isCaseDropdownOpen = true; highlightedCaseIndex = 0; }"
                       @onkeydown="HandleSearchKeyDown" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button type="button" class="btn-search-clear" @onclick="ClearSearch" title="Clear">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }

                @if (isCaseDropdownOpen)
                {
                    <div class="patient-search-popover shadow-lg">
                        <div class="popover-header">
                            <span class="popover-title-text"><i class="bi bi-person-check-fill me-1 text-indigo-600"></i>Surgery Cases</span>
                            <span class="popover-counter-badge">@FilteredRequests.Count()</span>
                        </div>
                        <div class="popover-list">
                            @if (isLoadingRequests)
                            {
                                <div class="p-4 text-center text-muted">
                                    <span class="spinner-border spinner-border-sm text-indigo-600 me-2"></span>
                                    <span class="fs-7">Loading surgery cases...</span>
                                </div>
                            }
                            else if (!FilteredRequests.Any())
                            {
                                <div class="p-4 text-center text-muted">
                                    <i class="bi bi-folder-x fs-3 text-secondary d-block mb-1"></i>
                                    <span class="fs-7">No matching surgery cases found.</span>
                                </div>
                            }
                            else
                            {
                                var reqList = FilteredRequests.ToList();
                                @for (int rIdx = 0; rIdx < reqList.Count; rIdx++)
                                {
                                    var req = reqList[rIdx];
                                    var isCurrent = selectedRequest?.request_id == req.request_id;
                                    var isHigh = rIdx == highlightedCaseIndex;
                                    var patName = GetPatientName(req.custid);
                                    var docName = GetDoctorName(req.dcode);
                                    <div class="popover-patient-item @(isCurrent ? "active-pat" : "") @(isHigh ? "highlighted-pat" : "")"
                                         @onclick="() => SelectCaseFromDropdown(req)"
                                         @onmouseenter="() => highlightedCaseIndex = rIdx">
                                        <div class="popover-avatar">@GetInitials(patName)</div>
                                        <div class="popover-details">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="popover-pat-name">@patName</span>
                                                <span class="popover-ip-badge">#@req.custid.ToString("0")</span>
                                            </div>
                                            <div class="popover-sub-meta">
                                                <span><i class="bi bi-heart-pulse me-1 text-indigo-500"></i>@req.procedure_name</span>
                                                <span class="ms-2"><i class="bi bi-person-badge me-1 text-slate-400"></i>Dr. @docName</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-1 mt-1">
                                                <span class="badge @GetPriorityBadgeClass(req.priority) font-10">@req.priority</span>
                                                <span class="badge @GetStatusBadgeClass(req.status) font-10">@req.status</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 2. SELECTED SURGERY CASE BANNER                                           -->
    <!-- ========================================================================= -->
    @if (selectedRequest != null)
    {
        var curPatName = GetPatientName(selectedRequest.custid);
        var curDocName = GetDoctorName(selectedRequest.dcode);

        <div class="patient-banner-card mb-3">
            <div class="banner-left-wrap">
                <div class="pat-avatar-indigo">
                    @GetInitials(curPatName)
                </div>
                <div class="pat-text-wrap">
                    <div class="pat-header-row">
                        <span class="pat-name-heading">@selectedRequest.procedure_name</span>
                        <div class="pat-header-badges">
                            <span class="badge-ip-indigo"><i class="bi bi-hash"></i>@selectedRequest.custid.ToString("0")</span>
                        </div>
                    </div>

                    <div class="pat-meta-row">
                        <div class="pat-meta-tile">
                            <div class="tile-icon-box tile-icon-age">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <div class="meta-item">
                                <span class="meta-lbl">Patient Name</span>
                                <span class="meta-val">@curPatName</span>
                            </div>
                        </div>

                        <div class="pat-meta-tile">
                            <div class="tile-icon-box tile-icon-doc">
                                <i class="bi bi-person-badge-fill"></i>
                            </div>
                            <div class="meta-item">
                                <span class="meta-lbl">Attending Surgeon</span>
                                <span class="meta-val">Dr. @curDocName</span>
                            </div>
                        </div>

                        <div class="pat-meta-tile">
                            <div class="tile-icon-box tile-icon-ward">
                                <i class="bi bi-calendar3"></i>
                            </div>
                            <div class="meta-item">
                                <span class="meta-lbl">Theater &amp; Slot</span>
                                <span class="meta-val val-ward-highlight">
                                    @(activeSchedule != null ? $"{activeSchedule.scheduled_date:dd-MMM-yyyy} ({activeSchedule.scheduled_time:hh\\:mm})" : "Not Scheduled")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="banner-right-wrap">
                <button type="button" class="btn-secondary-outline btn-sm" @onclick="OpenStatusModal" title="Update status">
                    <i class="bi bi-arrow-repeat me-1"></i>
                    <span>Status</span>
                </button>
                <button type="button" class="btn-cancel-req btn-sm" @onclick="PromptCancelRequest" title="Cancel case">
                    <i class="bi bi-x-circle me-1"></i>
                    <span>Cancel</span>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="patient-empty-banner mb-2" @onclick="OpenCasesModal">
            <div class="empty-banner-icon">
                <i class="bi bi-hospital"></i>
            </div>
            <div class="empty-banner-text">
                <span class="empty-banner-main">No Surgery Case Selected</span>
                <span class="empty-banner-sub">Click here or use the search bar above to select a surgical case</span>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- 3. WORKSPACE CARD & HORIZONTAL TABS                                       -->
    <!-- ========================================================================= -->
    <div class="nurse-workspace-card">
        <!-- Horizontal Tabs Strip -->
        <div class="workspace-tabs-strip">
            <button type="button" class="nt-tab-btn @(activeTab == "PREOP" ? "active" : "")" @onclick='() => SetTab("PREOP")'>
                <i class="bi bi-clipboard2-check tab-icon"></i>
                <span>Pre-OP</span>
                @if (activePreOp != null)
                {
                    <span class="tab-badge-pill">@activePreOp.fitness_status</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "SURGERY" ? "active" : "")" @onclick='() => SetTab("SURGERY")'>
                <i class="bi bi-heart-pulse tab-icon"></i>
                <span>Surgery</span>
                @if (activeIntraOp != null)
                {
                    <span class="tab-badge-pill tab-badge-purple">In-Op</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "STERILIZATION" ? "active" : "")" @onclick='() => SetTab("STERILIZATION")'>
                <i class="bi bi-shield-check tab-icon"></i>
                <span>Sterilization</span>
                @if (activeSterilizations.Any())
                {
                    <span class="tab-badge-pill">@activeSterilizations.Count</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "RECOVERY" ? "active" : "")" @onclick='() => SetTab("RECOVERY")'>
                <i class="bi bi-hospital tab-icon"></i>
                <span>PACU / Recovery</span>
                @if (activeRecovery != null)
                {
                    <span class="tab-badge-pill">@activeRecovery.recovery_status</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "ORDERS" ? "active" : "")" @onclick='() => SetTab("ORDERS")'>
                <i class="bi bi-card-checklist tab-icon"></i>
                <span>Post-Op Orders</span>
                @if (activeOrders.Any())
                {
                    <span class="tab-badge-pill">@activeOrders.Count</span>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "OPNOTE" ? "active" : "")" @onclick='() => SetTab("OPNOTE")'>
                <i class="bi bi-journal-medical tab-icon"></i>
                <span>Operation Note</span>
                @if (activeOpNote != null)
                {
                    <i class="bi bi-check-circle-fill text-success fs-7"></i>
                }
            </button>

            <button type="button" class="nt-tab-btn @(activeTab == "SUMMARY" ? "active" : "")" @onclick='() => SetTab("SUMMARY")'>
                <i class="bi bi-file-earmark-text tab-icon"></i>
                <span>OT Summary</span>
            </button>
        </div>

        <!-- Tab Body Container -->
        <div class="workspace-body-wrap">
            @if (selectedRequest == null)
            {
                <div class="empty-state-box">
                    <div class="empty-state-icon">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <h3 class="font-bold text-slate-800 fs-5 mb-1">No Surgery Case Selected</h3>
                    <p class="text-slate-600 fs-7 mb-3" style="max-width: 440px; margin: 0 auto 1.25rem auto;">
                        Please search and select a surgery case to view and record surgical clinical episode records.
                    </p>
                    <button type="button" class="btn-indigo-action" @onclick="OpenCasesModal">
                        <i class="bi bi-search me-1"></i> Browse Surgery Cases
                    </button>
                </div>
            }
            else if (isLoadingEpisode)
            {
                <div class="loading-state-box">
                    <div class="spinner-border text-indigo-600" style="width: 2.75rem; height: 2.75rem;" role="status"></div>
                    <span class="text-slate-700 font-bold mt-3" style="font-size: 13px;">Loading surgical episode records...</span>
                </div>
            }
            else
            {
                @* ═══════════════════════════════════════════════════════════════ *@
                @* TAB 1: SUMMARY & BILLING                                        *@
                @* ═══════════════════════════════════════════════════════════════ *@
                @* TAB 1: OT SUMMARY & CLINICAL DOSSIER PREVIEW                    *@
                @* ═══════════════════════════════════════════════════════════════ *@
                @if (activeTab == "SUMMARY")
                {
                    <div class="tab-section-flow">
                        <div class="ot-summary-scroll-card">
                            
                            <!-- Casesheet-style Document Header -->
                            <div class="ot-cs-header">
                                <div class="ot-cs-patient-info">
                                    <div class="ot-cs-avatar">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <div class="ot-cs-meta">
                                        <div class="ot-cs-title">
                                            <span class="ot-cs-patient-name">@GetPatientName(selectedRequest.custid)</span>
                                            <span class="badge @GetStatusBadgeClass(selectedRequest.status)">@selectedRequest.status</span>
                                        </div>
                                        <div class="ot-cs-sub">
                                            <span><i class="bi bi-heart-pulse text-indigo-500 me-1"></i><strong>@selectedRequest.procedure_name</strong> (@(selectedRequest.procedure_code ?? "SURG"))</span>
                                            <span class="ot-cs-dot">•</span>
                                            <span><i class="bi bi-person-badge text-sky-500 me-1"></i>Dr. @GetDoctorName(selectedRequest.dcode)</span>
                                            <span class="ot-cs-dot">•</span>
                                            <span><i class="bi bi-hospital text-purple-500 me-1"></i>@(otTheaters.FirstOrDefault(t => t.ot_id == activeSchedule?.ot_id)?.ot_name ?? "OT Suite")</span>
                                            <span class="ot-cs-dot">•</span>
                                            <span><i class="bi bi-calendar-event text-emerald-500 me-1"></i>@(activeSchedule != null ? $"{activeSchedule.scheduled_date:dd-MMM-yyyy} {activeSchedule.scheduled_time:hh\\:mm tt}" : "Not Scheduled")</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="ot-cs-header-status">
                                    <span class="badge @(episodeSummary?.is_fully_billed == true ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-warning-emphasis border border-warning-subtle") px-3 py-1.5 fw-bold font-12 d-inline-flex align-items-center gap-1.5">
                                        <i class="bi @(episodeSummary?.is_fully_billed == true ? "bi-check-circle-fill" : "bi-clock-history")"></i>
                                        @(episodeSummary?.is_fully_billed == true ? "Fully Billed" : "Pending in Unbilled")
                                    </span>
                                </div>
                            </div>

                            <!-- Casesheet-style Demographics Summary Strip -->
                            <div class="ot-cs-summary-strip mb-3">
                                <div class="ot-cs-strip-item">
                                    <span class="ot-cs-strip-label"><i class="bi bi-card-heading text-indigo-600"></i> Patient ID</span>
                                    <span class="ot-cs-strip-val font-mono">#@selectedRequest.custid.ToString("0")</span>
                                </div>
                                <div class="ot-cs-strip-item">
                                    <span class="ot-cs-strip-label"><i class="bi bi-person-fill text-indigo-600"></i> Patient Name</span>
                                    <span class="ot-cs-strip-val font-bold">@GetPatientName(selectedRequest.custid)</span>
                                </div>
                                <div class="ot-cs-strip-item">
                                    <span class="ot-cs-strip-label"><i class="bi bi-person-badge text-indigo-600"></i> Attending Surgeon</span>
                                    <span class="ot-cs-strip-val">Dr. @GetDoctorName(selectedRequest.dcode)</span>
                                </div>
                                <div class="ot-cs-strip-item">
                                    <span class="ot-cs-strip-label"><i class="bi bi-hospital text-indigo-600"></i> OT Suite</span>
                                    <span class="ot-cs-strip-val font-semibold">@(otTheaters.FirstOrDefault(t => t.ot_id == activeSchedule?.ot_id)?.ot_name ?? "OT Suite")</span>
                                </div>
                                <div class="ot-cs-strip-item">
                                    <span class="ot-cs-strip-label"><i class="bi bi-calendar-event text-emerald-600"></i> Surgery Schedule</span>
                                    <span class="ot-cs-strip-val font-semibold">@(activeSchedule != null ? $"{activeSchedule.scheduled_date:dd-MMM-yyyy} ({activeSchedule.scheduled_time:hh\\:mm tt})" : "Not Scheduled")</span>
                                </div>
                                <div class="ot-cs-strip-item">
                                    <span class="ot-cs-strip-label"><i class="bi bi-activity text-purple-600"></i> Case Status</span>
                                    <span class="ot-cs-strip-val">
                                        <span class="badge @GetStatusBadgeClass(selectedRequest.status) font-11">@selectedRequest.status</span>
                                    </span>
                                </div>
                            </div>

                            <!-- Pre-Op Vitals & Baseline Metric Banner (Casesheet Style) -->
                            @if (activePreOp != null)
                            {
                                <div class="ot-cs-vitals-banner mb-3">
                                    <div class="ot-cs-vitals-header">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-activity text-indigo-600 fs-5"></i>
                                            <span class="ot-cs-vitals-title">Pre-Operative Vitals &amp; Baseline Metrics</span>
                                        </div>
                                        <span class="badge @GetFitnessBadgeClass(activePreOp.fitness_status) font-11 fw-bold">FITNESS: @activePreOp.fitness_status</span>
                                    </div>
                                    <div class="ot-cs-vitals-chips mt-2">
                                        @if (!string.IsNullOrWhiteSpace(activePreOp.vitals_summary))
                                        {
                                            <div class="ot-cs-vital-badge">
                                                <i class="bi bi-heart-pulse-fill text-rose-500 me-1"></i>
                                                <span><strong>Vitals:</strong> @activePreOp.vitals_summary</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(activePreOp.investigations_summary))
                                        {
                                            <div class="ot-cs-vital-badge">
                                                <i class="bi bi-flask-fill text-sky-600 me-1"></i>
                                                <span><strong>Investigations:</strong> @activePreOp.investigations_summary</span>
                                            </div>
                                        }
                                        <div class="ot-cs-vital-badge">
                                            <i class="bi bi-shield-check text-emerald-600 me-1"></i>
                                            <span><strong>Clearance:</strong> @activePreOp.fitness_status</span>
                                        </div>
                                        <div class="ot-cs-vital-badge">
                                            <i class="bi bi-person-check-fill text-indigo-600 me-1"></i>
                                            <span><strong>Assessed By:</strong> Dr. @(activePreOp.assessed_by_dcode.HasValue ? GetDoctorName(activePreOp.assessed_by_dcode.Value) : "Attending Doctor")</span>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(activePreOp.allergies) && !activePreOp.allergies.Contains("No", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="ot-cs-allergy-alert mt-2">
                                            <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>
                                            <strong>Allergies / Risk Alerts:</strong> @activePreOp.allergies
                                        </div>
                                    }
                                </div>
                            }

                            <!-- 2-Part Side-by-Side Split Body -->
                            <div class="ot-summary-split-grid">
                                
                                <!-- PART 1: LEFT COLUMN (Clinical, Assessment, Operation Note, WHO Checklist) -->
                                <div class="ot-summary-col">

                                    <!-- SECTION 1: SURGICAL PROCEDURE & DIAGNOSIS -->
                                    <div class="ot-doc-section">
                                        <div class="ot-doc-section-header">
                                            <div class="ot-doc-section-title">
                                                <i class="bi bi-heart-pulse-fill text-indigo-600"></i>
                                                <span>1. Surgical Procedure &amp; Clinical Diagnosis</span>
                                            </div>
                                        </div>
                                        <div class="ot-doc-section-content">
                                            <div class="ot-doc-kv-grid mb-3">
                                                <div class="ot-doc-kv-item">
                                                    <span class="ot-doc-kv-label">Procedure Name:</span>
                                                    <span class="ot-doc-kv-val font-bold text-indigo-700">@selectedRequest.procedure_name</span>
                                                </div>
                                                <div class="ot-doc-kv-item">
                                                    <span class="ot-doc-kv-label">Procedure Code:</span>
                                                    <span class="ot-doc-kv-val font-mono">@(selectedRequest.procedure_code ?? "-")</span>
                                                </div>
                                                <div class="ot-doc-kv-item">
                                                    <span class="ot-doc-kv-label">Surgery Classification:</span>
                                                    <span class="ot-doc-kv-val badge bg-indigo-subtle text-indigo-700">@(selectedRequest.surgery_type ?? "MAJOR")</span>
                                                </div>
                                                <div class="ot-doc-kv-item">
                                                    <span class="ot-doc-kv-label">Anesthesia Type:</span>
                                                    <span class="ot-doc-kv-val">@(activeAnesthesia?.anesthesia_type ?? selectedRequest.anesthesia_type ?? "GENERAL")</span>
                                                </div>
                                                <div class="ot-doc-kv-item">
                                                    <span class="ot-doc-kv-label">Estimated Duration:</span>
                                                    <span class="ot-doc-kv-val">@(selectedRequest.expected_duration_minutes ?? 60) Minutes</span>
                                                </div>
                                                <div class="ot-doc-kv-item">
                                                    <span class="ot-doc-kv-label">Procedure Base Fee:</span>
                                                    <span class="ot-doc-kv-val font-bold font-mono text-emerald-700">₹@(selectedRequest.procedure_fee?.ToString("N2") ?? "0.00")</span>
                                                </div>
                                            </div>
                                            <div class="ot-doc-kv-grid">
                                                <div class="ot-doc-kv-item" style="grid-column: span 2;">
                                                    <span class="ot-doc-kv-label">Pre-Operative Diagnosis:</span>
                                                    <span class="ot-doc-kv-val font-semibold">@(activeOpNote?.pre_op_diagnosis ?? activeIntraOp?.diagnosis_pre ?? selectedRequest.diagnosis ?? "Not Documented")</span>
                                                </div>
                                                <div class="ot-doc-kv-item" style="grid-column: span 2;">
                                                    <span class="ot-doc-kv-label">Post-Operative Diagnosis:</span>
                                                    <span class="ot-doc-kv-val font-semibold">@(activeOpNote?.post_op_diagnosis ?? activeIntraOp?.diagnosis_post ?? "Not Documented")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- SECTION 2: PRE-OPERATIVE ASSESSMENT & FITNESS CLEARANCE -->
                                    <div class="ot-doc-section">
                                        <div class="ot-doc-section-header">
                                            <div class="ot-doc-section-title">
                                                <i class="bi bi-clipboard2-check-fill text-indigo-600"></i>
                                                <span>2. Pre-Operative Assessment &amp; Clearance</span>
                                            </div>
                                            @if (activePreOp != null)
                                            {
                                                <span class="badge @GetFitnessBadgeClass(activePreOp.fitness_status) font-11 font-bold">@activePreOp.fitness_status</span>
                                            }
                                        </div>
                                        <div class="ot-doc-section-content">
                                            @if (activePreOp != null)
                                            {
                                                var docName = activePreOp.assessed_by_dcode.HasValue ? GetDoctorName(activePreOp.assessed_by_dcode.Value) : "Attending Doctor";
                                                <div class="ot-doc-kv-grid mb-3">
                                                    <div class="ot-doc-kv-item">
                                                        <span class="ot-doc-kv-label">Assessment Date:</span>
                                                        <span class="ot-doc-kv-val font-semibold">@activePreOp.assessment_date.ToString("dd-MMM-yyyy hh:mm tt")</span>
                                                    </div>
                                                    <div class="ot-doc-kv-item">
                                                        <span class="ot-doc-kv-label">Assessed By:</span>
                                                        <span class="ot-doc-kv-val">Dr. @docName</span>
                                                    </div>
                                                    <div class="ot-doc-kv-item">
                                                        <span class="ot-doc-kv-label">Fitness Status:</span>
                                                        <span class="ot-doc-kv-val badge @GetFitnessBadgeClass(activePreOp.fitness_status)">@activePreOp.fitness_status</span>
                                                    </div>
                                                    <div class="ot-doc-kv-item">
                                                        <span class="ot-doc-kv-label">Known Allergies:</span>
                                                        <span class="ot-doc-kv-val badge @(string.IsNullOrWhiteSpace(activePreOp.allergies) || activePreOp.allergies.Contains("No", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-amber-50 text-amber-800 border border-amber-200") font-11">
                                                            @(string.IsNullOrWhiteSpace(activePreOp.allergies) ? "No Known Drug Allergies" : activePreOp.allergies)
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="ot-doc-narrative-box mb-2">
                                                    <div class="ot-doc-narrative-title"><i class="bi bi-heart-pulse text-rose-500"></i> Medical History / Co-morbidities</div>
                                                    <div class="ot-doc-narrative-text">@(string.IsNullOrWhiteSpace(activePreOp.medical_history) ? "None documented." : activePreOp.medical_history)</div>
                                                </div>
                                                <div class="ot-doc-narrative-box mb-2">
                                                    <div class="ot-doc-narrative-title"><i class="bi bi-activity text-sky-500"></i> Baseline Vitals &amp; Investigations</div>
                                                    <div class="ot-doc-narrative-text">
                                                        <strong>Vitals:</strong> @(string.IsNullOrWhiteSpace(activePreOp.vitals_summary) ? "None documented" : activePreOp.vitals_summary)
                                                        <br />
                                                        <strong>Investigations:</strong> @(string.IsNullOrWhiteSpace(activePreOp.investigations_summary) ? "None documented" : activePreOp.investigations_summary)
                                                    </div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(activePreOp.clearance_notes))
                                                {
                                                    <div class="ot-doc-narrative-box">
                                                        <div class="ot-doc-narrative-title"><i class="bi bi-journal-check text-indigo-500"></i> Anesthesia Clearance Notes</div>
                                                        <div class="ot-doc-narrative-text">@activePreOp.clearance_notes</div>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="ot-doc-empty-hint">
                                                    <i class="bi bi-clipboard-x text-slate-400 me-1"></i> Pre-operative assessment has not been recorded yet.
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- SECTION 3: INTRA-OPERATIVE SURGERY RECORD & OPERATION NOTE -->
                                    <div class="ot-doc-section">
                                        <div class="ot-doc-section-header">
                                            <div class="ot-doc-section-title">
                                                <i class="bi bi-journal-medical text-indigo-600"></i>
                                                <span>3. Intra-Operative Findings &amp; Operation Note</span>
                                            </div>
                                            @if (activeOpNote != null || activeIntraOp != null)
                                            {
                                                <span class="badge bg-emerald-50 text-emerald-700 border border-emerald-200 font-11"><i class="bi bi-check-circle-fill me-1"></i>Recorded</span>
                                            }
                                        </div>
                                        <div class="ot-doc-section-content">
                                            @if (activeOpNote != null || activeIntraOp != null)
                                            {
                                                var surgeonName = activeOpNote?.surgeon_dcode.HasValue == true ? GetDoctorName(activeOpNote.surgeon_dcode.Value) : (selectedRequest.dcode > 0 ? GetDoctorName(selectedRequest.dcode) : "Operating Surgeon");
                                                var bloodLoss = activeOpNote?.blood_loss_ml ?? activeIntraOp?.blood_loss_ml;
                                                var findings = !string.IsNullOrWhiteSpace(activeOpNote?.findings) ? activeOpNote.findings : activeIntraOp?.findings;
                                                var complications = !string.IsNullOrWhiteSpace(activeOpNote?.complications) ? activeOpNote.complications : activeIntraOp?.complications;
                                                var instructions = activeOpNote?.instructions;

                                                <div class="ot-doc-kv-grid mb-3">
                                                    <div class="ot-doc-kv-item">
                                                        <span class="ot-doc-kv-label">Operating Surgeon:</span>
                                                        <span class="ot-doc-kv-val font-bold">Dr. @surgeonName</span>
                                                    </div>
                                                    <div class="ot-doc-kv-item">
                                                        <span class="ot-doc-kv-label">Estimated Blood Loss:</span>
                                                        <span class="ot-doc-kv-val badge @(bloodLoss > 200 ? "bg-amber-100 text-amber-800" : "bg-slate-100 text-slate-700") font-11 font-bold">
                                                            @(bloodLoss.HasValue ? $"{bloodLoss} mL" : "Minimal / Not documented")
                                                        </span>
                                                    </div>
                                                    <div class="ot-doc-kv-item">
                                                        <span class="ot-doc-kv-label">Complications:</span>
                                                        <span class="ot-doc-kv-val font-semibold text-slate-800">@(string.IsNullOrWhiteSpace(complications) ? "None" : complications)</span>
                                                    </div>
                                                    <div class="ot-doc-kv-item">
                                                        <span class="ot-doc-kv-label">Specimen / Biopsy:</span>
                                                        <span class="ot-doc-kv-val">
                                                            @if (activeOpNote?.specimen_sent == true)
                                                            {
                                                                <span class="badge bg-purple-50 text-purple-800 border border-purple-200 font-11">
                                                                    <i class="bi bi-check-circle-fill text-purple-600 me-1"></i>Sent: @(string.IsNullOrWhiteSpace(activeOpNote.specimen_details) ? "Tissue Specimen" : activeOpNote.specimen_details)
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-slate-100 text-slate-600 font-11">No Specimen Sent</span>
                                                            }
                                                        </span>
                                                    </div>
                                                </div>

                                                <div class="ot-doc-narrative-box mb-2">
                                                    <div class="ot-doc-narrative-title"><i class="bi bi-body-text text-indigo-600"></i> Operative Findings &amp; Surgical Technique</div>
                                                    <div class="ot-doc-narrative-text font-mono-subtle">
                                                        @(string.IsNullOrWhiteSpace(findings) ? "Standard surgical procedure completed." : findings)
                                                    </div>
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(instructions))
                                                {
                                                    <div class="ot-doc-narrative-box">
                                                        <div class="ot-doc-narrative-title"><i class="bi bi-journal-text text-emerald-600"></i> Surgical Post-Op Plan &amp; Directives</div>
                                                        <div class="ot-doc-narrative-text">@instructions</div>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="ot-doc-empty-hint">
                                                    <i class="bi bi-journal-x text-slate-400 me-1"></i> Surgical operation note and intra-operative record not documented yet.
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- SECTION 4: WHO SURGICAL SAFETY CHECKLIST & CONSENTS -->
                                    <div class="ot-doc-section">
                                        <div class="ot-doc-section-header">
                                            <div class="ot-doc-section-title">
                                                <i class="bi bi-shield-check text-indigo-600"></i>
                                                <span>4. WHO Surgical Safety Checklist &amp; Consents</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-indigo-subtle text-indigo-700 font-11">@activeConsents.Count Consents Signed</span>
                                                <span class="badge @(activeChecklist != null ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-warning border border-warning-subtle") font-11">
                                                    @(activeChecklist != null ? "Checklist Completed" : "Checklist Incomplete")
                                                </span>
                                            </div>
                                        </div>
                                        <div class="ot-doc-section-content">
                                            @if (activeChecklist != null)
                                            {
                                                <div class="ot-doc-checklist-grid mb-3">
                                                    <div class="ot-doc-chk-item @(activeChecklist.patient_confirmed ? "chk-pass" : "chk-fail")">
                                                        <i class="bi @(activeChecklist.patient_confirmed ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                                                        <span>Patient Confirmed</span>
                                                    </div>
                                                    <div class="ot-doc-chk-item @(activeChecklist.procedure_confirmed ? "chk-pass" : "chk-fail")">
                                                        <i class="bi @(activeChecklist.procedure_confirmed ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                                                        <span>Procedure Confirmed</span>
                                                    </div>
                                                    <div class="ot-doc-chk-item @(activeChecklist.site_marked ? "chk-pass" : "chk-fail")">
                                                        <i class="bi @(activeChecklist.site_marked ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                                                        <span>Site Marked</span>
                                                    </div>
                                                    <div class="ot-doc-chk-item @(activeChecklist.consent_confirmed ? "chk-pass" : "chk-fail")">
                                                        <i class="bi @(activeChecklist.consent_confirmed ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                                                        <span>Informed Consent</span>
                                                    </div>
                                                    <div class="ot-doc-chk-item @(activeChecklist.investigations_confirmed ? "chk-pass" : "chk-fail")">
                                                        <i class="bi @(activeChecklist.investigations_confirmed ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                                                        <span>Pre-Op Labs</span>
                                                    </div>
                                                    <div class="ot-doc-chk-item @(activeChecklist.blood_arranged ? "chk-pass" : "chk-neutral")">
                                                        <i class="bi @(activeChecklist.blood_arranged ? "bi-check-circle-fill text-success" : "bi-dash-circle text-slate-400")"></i>
                                                        <span>Blood Products</span>
                                                    </div>
                                                    <div class="ot-doc-chk-item @(activeChecklist.instruments_confirmed ? "chk-pass" : "chk-fail")">
                                                        <i class="bi @(activeChecklist.instruments_confirmed ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                                                        <span>Sterile Trays</span>
                                                    </div>
                                                    <div class="ot-doc-chk-item @(activeChecklist.antibiotic_given ? "chk-pass" : "chk-neutral")">
                                                        <i class="bi @(activeChecklist.antibiotic_given ? "bi-check-circle-fill text-success" : "bi-dash-circle text-slate-400")"></i>
                                                        <span>Antibiotics</span>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ot-doc-empty-hint mb-3">
                                                    <i class="bi bi-shield-slash text-slate-400 me-1"></i> WHO checklist has not been submitted yet.
                                                </div>
                                            }

                                            <!-- Signed Consents List -->
                                            @if (activeConsents.Any())
                                            {
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var c in activeConsents)
                                                    {
                                                        <div class="ot-doc-consent-pill">
                                                            <i class="bi bi-pen-fill text-indigo-600"></i>
                                                            <span class="font-bold text-slate-800">@c.consent_type Consent</span>
                                                            <span class="text-slate-500 font-11">(Signed by @(string.IsNullOrWhiteSpace(c.consent_by) ? "Patient" : c.consent_by))</span>
                                                            <span class="badge bg-success-subtle text-success font-10">VERIFIED</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                </div>

                                <!-- PART 2: RIGHT COLUMN (Team, Sterilization, Consumables & PACU Orders) -->
                                <div class="ot-summary-col">

                                    <!-- SECTION 5: SURGICAL & OT TEAM -->
                                    <div class="ot-doc-section">
                                        <div class="ot-doc-section-header">
                                            <div class="ot-doc-section-title">
                                                <i class="bi bi-people-fill text-indigo-600"></i>
                                                <span>5. Surgical &amp; Anesthesia Team</span>
                                            </div>
                                            <span class="ot-doc-section-count">@activeTeam.Count Members Logged</span>
                                        </div>
                                        <div class="ot-doc-section-content">
                                            @if (activeTeam.Any())
                                            {
                                                <div class="lc-table-container">
                                                    <table class="lc-table">
                                                        <thead>
                                                            <tr>
                                                                <th style="min-width: 180px;">PRACTITIONER NAME</th>
                                                                <th style="min-width: 140px;">ROLE IN THEATER</th>
                                                                <th style="min-width: 110px;">STAFF CODE</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var tm in activeTeam)
                                                            {
                                                                var dName = tm.dcode.HasValue ? GetDoctorName(tm.dcode.Value) : tm.staff_name;
                                                                <tr class="lc-table-row">
                                                                    <td>
                                                                        <div class="d-flex align-items-center gap-1.5 font-12 font-semibold text-slate-800">
                                                                            <i class="bi @(tm.dcode.HasValue ? "bi-person-badge text-indigo-600" : "bi-person text-slate-500")"></i>
                                                                            <span>@(tm.dcode.HasValue ? $"Dr. {dName}" : tm.staff_name)</span>
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        <span class="badge bg-indigo-subtle text-indigo-700 font-11 font-bold">@tm.role</span>
                                                                    </td>
                                                                    <td class="font-mono font-12 text-slate-600">
                                                                        @(tm.dcode.HasValue ? $"DOC-{tm.dcode}" : (string.IsNullOrWhiteSpace(tm.staff_code) ? "-" : tm.staff_code))
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ot-doc-empty-hint">
                                                    <i class="bi bi-people text-slate-400 me-1"></i> No surgical team members recorded.
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- SECTION 6: CSSD & STERILIZATION LOG -->
                                    <div class="ot-doc-section">
                                        <div class="ot-doc-section-header">
                                            <div class="ot-doc-section-title">
                                                <i class="bi bi-shield-shaded text-indigo-600"></i>
                                                <span>6. CSSD &amp; Instrument Sterilization Log</span>
                                            </div>
                                            <span class="ot-doc-section-count">@activeSterilizations.Count Sets Logged</span>
                                        </div>
                                        <div class="ot-doc-section-content">
                                            @if (activeSterilizations.Any())
                                            {
                                                <div class="lc-table-container">
                                                    <table class="lc-table">
                                                        <thead>
                                                            <tr>
                                                                <th style="min-width: 140px;">INSTRUMENT SET</th>
                                                                <th style="min-width: 110px;">METHOD</th>
                                                                <th style="min-width: 110px;">CYCLE #</th>
                                                                <th style="min-width: 100px;">EXPIRY</th>
                                                                <th style="min-width: 100px;">STATUS</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var st in activeSterilizations)
                                                            {
                                                                <tr class="lc-table-row">
                                                                    <td class="font-bold text-slate-800 font-12">@st.instrument_set</td>
                                                                    <td><span class="badge bg-slate-100 text-slate-700 font-10">@(st.sterilization_method ?? "AUTOCLAVE")</span></td>
                                                                    <td class="font-mono font-11 text-slate-600">@(st.cycle_number ?? "-")</td>
                                                                    <td class="font-11 text-slate-600">@(st.expiry_date.HasValue ? st.expiry_date.Value.ToString("dd-MMM-yyyy") : "-")</td>
                                                                    <td><span class="badge @GetSterilizationStatusBadgeClass(st.status) font-10 font-bold">@st.status</span></td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ot-doc-empty-hint">
                                                    <i class="bi bi-shield-x text-slate-400 me-1"></i> No CSSD sterilization sets recorded.
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- SECTION 7: MATERIALS, CONSUMABLES & IMPLANTS CHARGED -->
                                    <div class="ot-doc-section">
                                        <div class="ot-doc-section-header">
                                            <div class="ot-doc-section-title">
                                                <i class="bi bi-box-seam-fill text-indigo-600"></i>
                                                <span>7. Charged Materials, Consumables &amp; Implants</span>
                                            </div>
                                            <span class="ot-doc-section-count">@(activeConsumables.Count + activeImplants.Count) Items Recorded</span>
                                        </div>
                                        <div class="ot-doc-section-content">
                                            @if (activeConsumables.Any() || activeImplants.Any())
                                            {
                                                <div class="lc-table-container mb-2">
                                                    <table class="lc-table">
                                                        <thead>
                                                            <tr>
                                                                <th style="min-width: 160px;">ITEM NAME</th>
                                                                <th style="min-width: 90px;">CATEGORY</th>
                                                                <th style="min-width: 70px;" class="text-center">QTY</th>
                                                                <th style="min-width: 90px;" class="text-end">RATE (₹)</th>
                                                                <th style="min-width: 95px;" class="text-end">AMOUNT (₹)</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var imp in activeImplants)
                                                            {
                                                                <tr class="lc-table-row">
                                                                    <td>
                                                                        <div class="font-bold text-purple-900 font-12">@imp.item_name</div>
                                                                        <div class="font-10 text-slate-500 font-mono">@(imp.serial_no ?? imp.batch_no ?? "")</div>
                                                                    </td>
                                                                    <td><span class="badge bg-purple-subtle text-purple font-10 font-bold">IMPLANT</span></td>
                                                                    <td class="text-center font-bold text-slate-800 font-12">@imp.quantity.ToString("0")</td>
                                                                    <td class="text-end font-mono font-11">₹@(imp.rate?.ToString("N2") ?? "0.00")</td>
                                                                    <td class="text-end font-mono font-bold text-slate-900 font-12">₹@(imp.amount?.ToString("N2") ?? ((imp.rate ?? 0) * imp.quantity).ToString("N2"))</td>
                                                                </tr>
                                                            }
                                                            @foreach (var con in activeConsumables)
                                                            {
                                                                <tr class="lc-table-row">
                                                                    <td class="font-semibold text-slate-800 font-12">@con.item_name</td>
                                                                    <td><span class="badge bg-slate-100 text-slate-700 font-10">CONSUMABLE</span></td>
                                                                    <td class="text-center font-semibold text-slate-800 font-12">@con.quantity @con.unit</td>
                                                                    <td class="text-end font-mono text-slate-700 font-11">₹@(con.rate?.ToString("N2") ?? "0.00")</td>
                                                                    <td class="text-end font-mono font-bold text-slate-900 font-12">₹@(con.amount?.ToString("N2") ?? ((con.rate ?? 0) * con.quantity).ToString("N2"))</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>

                                                <!-- Billing Total Breakdown -->
                                                var totalItemsCost = activeImplants.Sum(i => i.amount ?? (i.rate ?? 0) * i.quantity) + activeConsumables.Sum(c => c.amount ?? (c.rate ?? 0) * c.quantity);
                                                var grandTotal = (selectedRequest.procedure_fee ?? 0) + totalItemsCost;

                                                <div class="ot-doc-total-strip">
                                                    <div class="ot-doc-total-col">
                                                        <span class="ot-doc-total-sublabel">Procedure Fee:</span>
                                                        <span class="ot-doc-total-subval">₹@(selectedRequest.procedure_fee?.ToString("N2") ?? "0.00")</span>
                                                    </div>
                                                    <div class="ot-doc-total-sep">+</div>
                                                    <div class="ot-doc-total-col">
                                                        <span class="ot-doc-total-sublabel">Materials:</span>
                                                        <span class="ot-doc-total-subval">₹@totalItemsCost.ToString("N2")</span>
                                                    </div>
                                                    <div class="ot-doc-total-sep">=</div>
                                                    <div class="ot-doc-total-col highlight">
                                                        <span class="ot-doc-total-sublabel">Total OT Amount:</span>
                                                        <span class="ot-doc-total-mainval font-mono">₹@grandTotal.ToString("N2")</span>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ot-doc-empty-hint">
                                                    <i class="bi bi-box text-slate-400 me-1"></i> No consumables or implants charged for this case.
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- SECTION 8: PACU & POST-OPERATIVE RECOVERY -->
                                    <div class="ot-doc-section">
                                        <div class="ot-doc-section-header">
                                            <div class="ot-doc-section-title">
                                                <i class="bi bi-hospital-fill text-indigo-600"></i>
                                                <span>8. PACU &amp; Post-Operative Recovery Status</span>
                                            </div>
                                            @if (activeRecovery != null)
                                            {
                                                <span class="badge @GetRecoveryStatusBadgeClass(activeRecovery.recovery_status) font-11 font-bold">@activeRecovery.recovery_status</span>
                                            }
                                        </div>
                                        <div class="ot-doc-section-content">
                                            @if (activeRecovery != null)
                                            {
                                                <div class="ot-doc-kv-grid mb-3">
                                                    <div class="ot-doc-kv-item">
                                                        <span class="ot-doc-kv-label">Recovery Status:</span>
                                                        <span class="ot-doc-kv-val badge @GetRecoveryStatusBadgeClass(activeRecovery.recovery_status) font-11">@activeRecovery.recovery_status</span>
                                                    </div>
                                                    <div class="ot-doc-kv-item">
                                                        <span class="ot-doc-kv-label">Pain Score:</span>
                                                        <span class="ot-doc-kv-val">
                                                            @if (activeRecovery.pain_score.HasValue)
                                                            {
                                                                <span class="badge @(activeRecovery.pain_score > 6 ? "bg-danger-subtle text-danger" : (activeRecovery.pain_score > 3 ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success")) font-11 font-bold">
                                                                    @activeRecovery.pain_score / 10
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-slate-400">-</span>
                                                            }
                                                        </span>
                                                    </div>
                                                    <div class="ot-doc-kv-item">
                                                        <span class="ot-doc-kv-label">Transferred To:</span>
                                                        <span class="ot-doc-kv-val font-semibold text-slate-800">@(string.IsNullOrWhiteSpace(activeRecovery.transferred_to) ? "-" : activeRecovery.transferred_to)</span>
                                                    </div>
                                                    <div class="ot-doc-kv-item">
                                                        <span class="ot-doc-kv-label">Oxygen Support:</span>
                                                        <span class="ot-doc-kv-val">@(string.IsNullOrWhiteSpace(activeRecovery.oxygen_support) ? "Room Air / None" : activeRecovery.oxygen_support)</span>
                                                    </div>
                                                </div>

                                                <div class="ot-doc-narrative-box mb-2">
                                                    <div class="ot-doc-narrative-title"><i class="bi bi-heart-pulse text-rose-500"></i> PACU Vitals Summary</div>
                                                    <div class="ot-doc-narrative-text">@(string.IsNullOrWhiteSpace(activeRecovery.vitals_summary) ? "Vitals stable." : activeRecovery.vitals_summary)</div>
                                                </div>

                                                <div class="ot-doc-narrative-box">
                                                    <div class="ot-doc-narrative-title"><i class="bi bi-clipboard-check text-emerald-500"></i> Recovery Notes</div>
                                                    <div class="ot-doc-narrative-text">@(string.IsNullOrWhiteSpace(activeRecovery.remarks) ? "Smooth recovery and transfer to ward." : activeRecovery.remarks)</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ot-doc-empty-hint">
