    .checklist-item:hover {
        background: #f0fdf4;
        border-color: #86efac;
    }

    .checklist-item.checked {
        background: #f0fdf4;
        border-color: #4ade80;
        color: #15803d;
    }

    .checklist-checkbox {
        width: 16px;
        height: 16px;
        accent-color: #10b981;
        cursor: pointer;
    }

    /* ═══════════════════════════════════════════════════════════════
       6. TABLES (NURSE NOTES STYLED DATA TABLES)
       ═══════════════════════════════════════════════════════════════ */
    .ot-table-wrap {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
        margin-top: 0.75rem;
        background: #ffffff;
    }

    .ot-data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12.5px;
