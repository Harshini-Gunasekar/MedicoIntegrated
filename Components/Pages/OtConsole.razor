                                                                    @activeSchedule.scheduled_date.ToString("dddd")
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="fw-bold text-slate-800 font-mono" style="font-size: 0.85rem; display: flex; align-items: center; gap: 5px; white-space: nowrap;">
                                                                    <i class="bi bi-clock text-indigo-600"></i>
                                                                    <span>@activeSchedule.scheduled_time.ToString("hh\\:mm tt") - @activeSchedule.estimated_end_time.ToString("hh\\:mm tt")</span>
                                                                </div>
                                                            </td>
                                                            <td style="text-align: center;">
                                                                <div style="font-size: 0.82rem; font-weight: 700; color: #1e293b; display: flex; align-items: center; justify-content: center; gap: 5px; white-space: nowrap;">
                                                                    <i class="bi bi-stopwatch text-indigo-600"></i>
                                                                    <span>@(selectedRequest.expected_duration_minutes ?? 60) mins</span>
                                                                </div>
                                                            </td>
