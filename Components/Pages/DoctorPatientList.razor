    private async Task LoadTodayBookingsAsync()
    {
        loading = true;
        try
        {
            var dateOnly = DateOnly.FromDateTime(selectedDate);
            
            // 1. Fetch all registrations from the backend API
            var regs = await BookingService.GetAllOpRegistrationsAsync();
            
            // 2. Filter registrations for the selected date and non-deleted
            var filteredRegs = regs
                .Where(r => r.visit_date == dateOnly && !r.isdeleted)
                .ToList();

            // 3. Filter by selected doctor if one is chosen
            if (selectedDoctorDcode.HasValue && selectedDoctorDcode.Value != 0)
            {
                var docCode = selectedDoctorDcode.Value;
                filteredRegs = filteredRegs
                    .Where(r => r.dcode == docCode || r.duty_dcode == docCode || r.transferred_to_dcode == docCode)
                    .ToList();
            }

            // 4. Fetch general bookings to match slots/times/types
            var generalBookings = await BookingService.GetBookingsByDateAsync(dateOnly) ?? new();
            var bookingMap = generalBookings
                .Where(gb => gb.booking_id != Guid.Empty)
                .GroupBy(gb => gb.booking_id)
                .ToDictionary(g => g.Key, g => g.First());

            // 5. Pre-fetch slots for walk-in registrations (similar to OutPatientVisiting.razor)
            var walkinRegsToFetch = filteredRegs
                .Where(r => (!r.booking_id.HasValue || r.booking_id.Value == Guid.Empty) && r.slot_detail_id.HasValue)
                .GroupBy(r => new { r.dcode })
                .ToList();

            var slotCache = new Dictionary<Guid, AvailableSlotModel>();
            foreach (var group in walkinRegsToFetch)
            {
                try
                {
                    var slots = await BookingService.GetAvailableSlotsAsync(group.Key.dcode, dateOnly);
                    foreach (var s in slots)
                    {
                        slotCache[s.slot_detail_id] = s;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error pre-fetching slots for doctor {group.Key.dcode}: {ex.Message}");
                }
            }

            // 6. Map registrations to DoctorBookingListModel
            todayBookings = new List<DoctorBookingListModel>();
            foreach (var r in filteredRegs)
            {
                var slotStartTime = default(TimeOnly);
                var slotEndTime = default(TimeOnly);
                var bookingType = r.reg_type;

                if (r.booking_id.HasValue && r.booking_id.Value != Guid.Empty && bookingMap.TryGetValue(r.booking_id.Value, out var matchB))
                {
                    slotStartTime = matchB.slot_start_time;
                    slotEndTime = matchB.slot_end_time;
                    if (!string.IsNullOrEmpty(matchB.booking_type))
                    {
                        bookingType = matchB.booking_type;
                    }
                }
                else if (r.slot_detail_id.HasValue && slotCache.TryGetValue(r.slot_detail_id.Value, out var slotInfo))
                {
                    slotStartTime = slotInfo.slot_start_time;
                    slotEndTime = slotInfo.slot_end_time;
                }

                var model = new DoctorBookingListModel
                {
                    booking_id = (r.booking_id.HasValue && r.booking_id.Value != Guid.Empty) ? r.booking_id.Value : r.op_id,
                    booking_no = (r.booking_id.HasValue && r.booking_id.Value != Guid.Empty) ? r.booking_no : r.op_no,
                    custid = r.custid,
                    dcode = r.dcode,
                    appointment_date = r.visit_date,
                    slot_start_time = slotStartTime,
                    slot_end_time = slotEndTime,
                    token_no = r.token_no ?? 0,
                    booking_status = r.visit_status,
                    booking_type = bookingType,
                    reg_type = !string.IsNullOrWhiteSpace(r.reg_type) ? r.reg_type : (bookingType ?? "WALKIN"),
                    notes = r.notes,
                    patient_name = r.patient_name,
                    isvip = r.isvip ?? r.is_vip ?? false,
                    viprole = r.viprole
                };

                todayBookings.Add(model);
            }

            // Sort by start time then token number
            todayBookings = todayBookings.OrderBy(b => b.slot_start_time).ThenBy(b => b.token_no).ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to fetch doctor bookings: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private List<DoctorBookingListModel> GetFilteredBookings()
    {
        var result = todayBookings;

        // Apply Search
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            result = result.Where(b => 
                (b.patient_name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (b.booking_no?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (b.reg_type?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (b.booking_type?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                b.custid.ToString().Contains(searchQuery)
            ).ToList();
        }

        // Apply Status Filter
        if (statusFilter != "ALL")
        {
            result = result.Where(b => b.booking_status?.Equals(statusFilter, StringComparison.OrdinalIgnoreCase) ?? false).ToList();
        }

        // Apply Booking Type Filter
        if (bookingTypeFilter != "ALL")
        {
            if (bookingTypeFilter.Equals("ONLINE", StringComparison.OrdinalIgnoreCase))
            {
                result = result.Where(b => 
                    (b.reg_type?.Equals("ONLINE", StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.reg_type?.Equals("APP", StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.booking_type?.Equals("ONLINE", StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.booking_type?.Equals("APP", StringComparison.OrdinalIgnoreCase) ?? false)
                ).ToList();
            }
            else if (bookingTypeFilter.Equals("WALKIN", StringComparison.OrdinalIgnoreCase))
            {
                result = result.Where(b => 
                    !(b.reg_type?.Equals("ONLINE", StringComparison.OrdinalIgnoreCase) ?? false) &&
                    !(b.reg_type?.Equals("APP", StringComparison.OrdinalIgnoreCase) ?? false) &&
                    !(b.booking_type?.Equals("ONLINE", StringComparison.OrdinalIgnoreCase) ?? false) &&
                    !(b.booking_type?.Equals("APP", StringComparison.OrdinalIgnoreCase) ?? false)
                ).ToList();
            }
            else
            {
                result = result.Where(b => (b.reg_type?.Equals(bookingTypeFilter, StringComparison.OrdinalIgnoreCase) ?? false) || (b.booking_type?.Equals(bookingTypeFilter, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
            }
        }

        return result;
    }

