    private string selectedPatientSearchName = "";
    private bool showPatientDropdown = false;
    private int activeDropdownIndex = 0;
    private List<SharedComponents.Rcl.Models.CustomerModel> filteredPatientsForDropdown = new();

    private void OnPatientSearchInput(ChangeEventArgs e)
    {
        selectedPatientSearchName = e.Value?.ToString() ?? "";
        UpdateFilteredPatients();
        showPatientDropdown = true;
        activeDropdownIndex = 0;
    }

    private void UpdateFilteredPatients()
    {
        if (string.IsNullOrWhiteSpace(selectedPatientSearchName))
        {
            filteredPatientsForDropdown = customersList.Take(50).ToList();
        }
        else
        {
            filteredPatientsForDropdown = customersList
                .Where(c => (c.name != null && c.name.Contains(selectedPatientSearchName, StringComparison.OrdinalIgnoreCase)) ||
                            (c.namewithinitials != null && c.namewithinitials.Contains(selectedPatientSearchName, StringComparison.OrdinalIgnoreCase)) ||
                            (c.custcode != null && c.custcode.Contains(selectedPatientSearchName, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    private void ShowPatientDropdown()
    {
        UpdateFilteredPatients();
        showPatientDropdown = true;
    }

