@page "/booking/doctor"
@using Booking.Models
@using Booking.Services
@using Booking.Helpers
@using System.Net.Http.Json
@using SharedComponents.Rcl.Models
@using Medico_Backend.Model
@using medico_backend.Model
@using Newtonsoft.Json
@inject AppointmentBookingService BookingService
@inject DoctorService DoctorService
@inject DoctorCurrentStatusService StatusService
@inject DoctorSpecialtyMasterService SpecialtyService
@inject ToastService ToastService
@inject CaseSheetService CaseSheetService
@inject IHttpClientFactory ClientFactory
@inject IpRegistrationService IpService
@inject FloorMasterService FloorService
@inject RoomTypeMasterService RoomTypeService
@inject WardMasterService WardService
@inject BedMasterService BedService
@inject BlockMasterService BlockService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<PageTitle>Doctor Patient List</PageTitle>

<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
</div>

<div class="dashboard-container">
    <DnaLoader IsLoading="@loading" Message="Loading Patients..." />
    <!-- Header -->
    <div class="dashboard-header" style="margin-top: 10px; margin-bottom: 8px;">
        <div class="dashboard-title">
            @if (activeTab == "OP")
            {
                <h1 style="font-size: 1.15rem; font-weight: 800; color: #034f75; margin: 0;">Doctor's Patient List</h1>
            }
            else
            {
                <h1 style="font-size: 1.15rem; font-weight: 800; color: #034f75; margin: 0;">Inpatient Admissions Dashboard</h1>
            }
        </div>
        <div style="display: flex; gap: 8px; align-items: center; position: relative;">
            <button class="btn-header-action" @onclick="() => showStatsPopover = !showStatsPopover" style="background: #ffffff; color: #475569; border: 1px solid #d0d5dd; font-weight: 600; padding: 0.5rem 1rem; border-radius: 8px; display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05); height: 38px;">
                <i class="bi bi-bar-chart-fill" style="color: #0284c7;"></i>
                <span>@(showStatsPopover ? "Hide Stats" : "Show Stats")</span>
            </button>
            <button class="btn-header-action" @onclick="RefreshActiveTabQueue" disabled="@loading">
                @if (loading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                }
                <i class="bi bi-arrow-clockwise"></i> Refresh Queue
            </button>

            @if (showStatsPopover)
            {
                <div class="stats-popup-card">
                    <div class="stats-popup-header">
                        <span>Dashboard Summary Stats</span>
                        <button type="button" class="close-btn" @onclick="() => showStatsPopover = false">&times;</button>
                    </div>
                    <div class="stats-popup-list">
                        @if (activeTab == "OP")
                        {
                            <div class="stat-popup-item blue">
                                <i class="bi bi-calendar3"></i>
                                <span class="label">Total Scheduled</span>
                                <span class="num">@GetFilteredBookings().Count</span>
                            </div>
                            <div class="stat-popup-item orange">
                                <i class="bi bi-hourglass-split"></i>
                                <span class="label">Pending</span>
                                <span class="num">@GetFilteredBookings().Count(b => b.booking_status?.ToUpper() == "BOOKED")</span>
                            </div>
                            <div class="stat-popup-item green">
                                <i class="bi bi-check2-all"></i>
                                <span class="label">Confirmed/Served</span>
                                <span class="num">@GetFilteredBookings().Count(b => b.booking_status?.ToUpper() == "CONFIRMED" || b.booking_status?.ToUpper() == "COMPLETED" || b.booking_status?.ToUpper() == "VISITED")</span>
                            </div>
                        }
                        else
                        {
                            <div class="stat-popup-item blue">
                                <i class="bi bi-person-fill-check"></i>
                                <span class="label">Currently Admitted</span>
                                <span class="num">@admissionsList.Count(a => a.ip_status == "ADMITTED")</span>
                            </div>
                            <div class="stat-popup-item green">
                                <i class="bi bi-wallet2"></i>
                                <span class="label">Insurance Cases</span>
                                <span class="num">@admissionsList.Count(a => a.isinsurancepatient)</span>
                            </div>
                            <div class="stat-popup-item orange">
                                <i class="bi bi-shield-exclamation"></i>
                                <span class="label">Emergency Cases</span>
                                <span class="num">@admissionsList.Count(a => a.admission_type == "EMERGENCY")</span>
                            </div>
                            <div class="stat-popup-item purple">
                                <i class="bi bi-person-dash"></i>
                                <span class="label">Discharged (Total)</span>
                                <span class="num">@admissionsList.Count(a => a.ip_status == "DISCHARGED")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="medico-tabs">
        <button class="tab-btn @(activeTab == "OP" ? "active" : "")" @onclick='() => SetActiveTab("OP")'>
            <i class="bi bi-person-lines-fill"></i> Outpatient (OP) Queue
        </button>
        <button class="tab-btn @(activeTab == "IP" ? "active" : "")" @onclick='() => SetActiveTab("IP")'>
            <i class="bi bi-hospital"></i> Inpatient (IP) Admissions
        </button>
    </div>

    @if (activeTab == "OP")
    {
        @if (loading && todayBookings.Count == 0)
        {
            <div class="loading-state">
                <div class="spinner-border" role="status"></div>
                <p>Loading patient list...</p>
            </div>
        }
        else
        {
        <!-- Toolbar Filters -->
        <div class="filter-card">
            <div class="filter-flex">
                <div class="filter-group filter-date-col">
                    <label class="filter-label">FILTER DATE</label>
                    <input type="date" class="form-control filter-input" @bind="selectedDate" @bind:after="OnDateChanged" />
                </div>

                <div class="filter-group">
                    <label class="filter-label">DOCTOR SPECIALIST</label>
                    <select class="form-select filter-select" @bind="selectedDoctorDcode" @bind:after="OnDoctorChanged">
                        <option value="">All Specialists</option>
                        @foreach (var doc in doctors)
                        {
                            <option value="@doc.dcode">@(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</option>
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">STATUS</label>
                    <select class="form-select filter-select" @bind="statusFilter">
                        <option value="ALL">All Statuses</option>
                        <option value="BOOKED">Booked</option>
                        <option value="CONFIRMED">Confirmed</option>
                        <option value="COMPLETED">Completed</option>
                        <option value="CANCELLED">Cancelled</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">REG TYPE</label>
                    <select class="form-select filter-select" @bind="bookingTypeFilter">
                        <option value="ALL">All Types</option>
                        <option value="ONLINE">Online</option>
                        <option value="WALKIN">Walk-in</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">TIME SLOT</label>
                    <select class="form-select filter-select" @bind="slotFilter">
                        <option value="ALL">All Slots</option>
                        @foreach (var slot in GetDistinctSlots())
                        {
                            <option value="@slot.Value">@slot.Text</option>
                        }
                    </select>
                </div>
                
                <div class="filter-group filter-search-col">
                    <label class="filter-label">SEARCH PATIENT / DOCTOR</label>
                    <input type="text" class="form-control filter-input" placeholder="e.g. CUST-1001, 2026..." @bind="searchQuery" @bind:event="oninput" />
                </div>

                <div class="filter-action-group">
                    <button class="btn-reset" @onclick="ResetFilters">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </button>
                </div>
            </div>
        </div>

        <!-- Patients List/Table Card -->
        <div class="table-card">
            @if (GetFilteredBookings().Any())
            {
                <div class="table-responsive">
                    <table class="medico-table">
                        <thead>
                            <tr>
                                <th style="width: 90px;">Token</th>
                                <th style="width: 200px;">Patient Name</th>
                                <th style="width: 130px;">Patient ID</th>
                                <th style="width: 120px;">Reg Type</th>
                                <th style="width: 180px;">Time Range</th>
                                <!-- <th>Booking Ref</th> -->
                                <th>Notes</th>
                                <th style="width: 140px;">Status</th>
                                <th style="width: 110px; text-align: center;">VIP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var filteredOpList = GetFilteredBookings();
                                var pagedOpList = filteredOpList.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
                            }
                            @foreach (var b in pagedOpList)
                            {
                                <tr class="@(b.isvip == true ? "vip-row" : "")" @ondblclick="() => OpenCaseSheetForBooking(b)" style="cursor: pointer;" title="Double-click to open clinical Case Sheet">
                                    <td>
                                        <div class="badge-op-container">
                                            <span class="badge-op">@b.token_no</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (hasCaseSheetViewRight)
                                        {
                                            <div class="patient-name-container" style="cursor: pointer;" @onclick="() => OpenCaseSheetForBooking(b)" title="Open Clinical Case Sheet">
                                                <span class="patient-name text-primary text-decoration-underline-hover">@(string.IsNullOrWhiteSpace(b.patient_name) ? "Walk-in Patient" : b.patient_name)</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="patient-name-container" style="cursor: not-allowed;" title="You do not have permission to view Case Sheets">
                                                <span class="patient-name text-slate-500">@(string.IsNullOrWhiteSpace(b.patient_name) ? "Walk-in Patient" : b.patient_name)</span>
                                            </div>
                                        }
                                        @{
                                            var bVipRole = (b.isvip == true)
                                                ? (!string.IsNullOrWhiteSpace(b.viprole) ? b.viprole : GetPatientVipRole(b.custid))
                                                : string.Empty;
                                        }
                                        @if (b.isvip == true)
                                        {
                                            <div style="margin-top: 3px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap;">
                                                <span style="background: #fffbeb; border: 1px solid #fde68a; color: #d97706; padding: 1px 6px; border-radius: 4px; font-weight: 700; font-size: 0.68rem; display: inline-flex; align-items: center; gap: 2px;" title="VIP Patient">⭐ VIP</span>
                                                @if (!string.IsNullOrWhiteSpace(bVipRole))
                                                {
                                                    <span style="font-size: 0.67rem; color: #b45309; font-weight: 600; background: #fef3c7; border: 1px solid #fde68a; border-radius: 3px; padding: 1px 5px; max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: inline-block;" title="@bVipRole">@bVipRole</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="patient-id-badge">ID: @b.custid</span>
                                    </td>
                                    <td>
                                        @{
                                            string displayRegType = !string.IsNullOrWhiteSpace(b.reg_type) 
                                                ? b.reg_type 
                                                : (!string.IsNullOrWhiteSpace(b.booking_type) ? b.booking_type : "WALKIN");

                                            bool isOnline = displayRegType.Equals("ONLINE", StringComparison.OrdinalIgnoreCase) 
                                                         || displayRegType.Equals("APP", StringComparison.OrdinalIgnoreCase)
                                                         || displayRegType.Equals("WEB", StringComparison.OrdinalIgnoreCase);
                                        }
                                        @if (isOnline)
                                        {
                                            <span style="background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-weight: 700; padding: 4px 10px; border-radius: 6px; font-size: 0.76rem; display: inline-flex; align-items: center; gap: 5px;">
                                                <i class="bi bi-globe"></i> Online
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; font-weight: 700; padding: 4px 10px; border-radius: 6px; font-size: 0.76rem; display: inline-flex; align-items: center; gap: 5px;">
                                                <i class="bi bi-person-walking"></i> Walk-in
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (b.slot_start_time == default(TimeOnly) && b.slot_end_time == default(TimeOnly))
                                        {
                                            <span class="text-muted" style="margin-left: 14px; font-weight: 700;">-</span>
                                        }
                                        else
                                        {
                                            <span class="time-badge">
                                                <i class="bi bi-clock"></i>
                                                @FormatTime(b.slot_start_time) - @FormatTime(b.slot_end_time)
                                            </span>
                                        }
                                    </td>
                                    <!-- <td>
                                        <div class="booking-ref-block">
                                            <span class="booking-no">@(string.IsNullOrWhiteSpace(b.booking_no) ? "N/A" : b.booking_no)</span>
                                            <span class="booking-type-label @b.booking_type?.ToLower()">@b.booking_type</span>
                                        </div>
                                    </td> -->
                                    <td>
                                        <span class="notes-text" title="@b.notes">
                                            @(string.IsNullOrWhiteSpace(b.notes) ? "-" : b.notes)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="status-pill @b.booking_status?.ToLower()">
                                            @b.booking_status
                                        </span>
                                    </td>
                                    <td class="@(b.isvip == true ? "vip-highlighted" : "")" style="text-align: center; vertical-align: middle; padding: 0.75rem 1.2rem;">
                                        <div style="display: flex; flex-direction: column; gap: 0.35rem; justify-content: center; align-items: center;">
                                            @if (b.isvip == true)
                                            {
                                                <button type="button" title="Edit VIP: @b.viprole" @onclick="() => OpenVipModal(b)" style="background: #fffbeb; border: 1px solid #fde68a; color: #d97706; padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 4px; transition: all 0.2s;">
                                                    VIP
                                                </button>
                                                @if (!string.IsNullOrWhiteSpace(b.viprole))
                                                {
                                                    <span style="font-size: 0.7rem; color: #b45309; font-weight: 600; text-align: center; max-width: 110px; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@b.viprole">@b.viprole</span>
                                                }
                                            }
                                            else
                                            {
                                                <button type="button" title="Mark as VIP" @onclick="() => OpenVipModal(b)" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #64748b; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 4px; transition: all 0.2s;">
                                                    Mark VIP
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (filteredOpList.Any())
                {
                    var totalItems = filteredOpList.Count;
                    var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
                    if (totalPages > 1)
                    {
                        <div class="pagination-footer">
                            <div class="pagination-info">
                                Showing <span class="pagination-info-highlight">@(((currentPage - 1) * pageSize) + 1)</span> to <span class="pagination-info-highlight">@(Math.Min(currentPage * pageSize, totalItems))</span> of <span class="pagination-info-highlight">@totalItems</span> entries
                            </div>
                            <div class="pagination-btns">
                                <button class="page-btn" disabled="@(currentPage == 1)" @onclick="() => currentPage = 1" title="First Page">&laquo;</button>
                                <button class="page-btn" disabled="@(currentPage == 1)" @onclick="() => currentPage--" title="Previous Page">&lsaquo;</button>

                                @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                                {
                                    var pageNum = p;
                                    <button class="page-btn @(currentPage == pageNum ? "active" : "")" @onclick="() => currentPage = pageNum">@pageNum</button>
                                }

                                <button class="page-btn" disabled="@(currentPage == totalPages)" @onclick="() => currentPage++" title="Next Page">&rsaquo;</button>
                                <button class="page-btn" disabled="@(currentPage == totalPages)" @onclick="() => currentPage = totalPages" title="Last Page">&raquo;</button>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-people-fill empty-icon"></i>
                    <h3>No Patients Found</h3>
                    <p>No patient bookings match the selected criteria for this date.</p>
                </div>
            }
        </div>
    }
}
else if (activeTab == "IP")
{
    @* --- FILTERS --- *@
    <div class="filters-card">
        <div class="filters-row">
            <div class="filter-group">
                <label>Admission Status</label>
                <select class="filter-control" @bind="filterStatus" @bind:after="ApplyFilters">
                    <option value="ALL">All Statuses</option>
                    <option value="ADMITTED">Admitted</option>
                    <option value="DISCHARGED">Discharged</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Doctor Specialist</label>
                <select class="filter-control" @bind="filterDoctor" @bind:after="ApplyFilters">
                    <option value="0">All Doctors</option>
                    @foreach (var doc in doctors)
                    {
                        <option value="@doc.dcode">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname ?? "Specialist" : doc.name)</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Search Patient</label>
                <input type="text" class="filter-control" @bind="filterSearch" @bind:event="oninput" @bind:after="ApplyFilters" placeholder="Search by name/IP no..." />
            </div>
            <div class="filter-group">
                <label>From Date</label>
                <input type="date" class="filter-control" @bind="filterFromDate" @bind:after="ApplyFilters" />
            </div>
            <div class="filter-group">
                <label>To Date</label>
                <input type="date" class="filter-control" @bind="filterToDate" @bind:after="ApplyFilters" />
            </div>
        </div>
    </div>

    @* --- TABLE --- *@
    <div class="table-card">
        <div class="table-responsive">
            <table class="medico-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">IP NUMBER</th>
                        <th style="width: 250px;">PATIENT NAME</th>
                        <th>MOBILE NO</th>
                        <th style="width: 180px;">DOCTOR</th>
                        <th>BED LOCATION</th>
                        @if (filterStatus == "DISCHARGED")
                        {
                            <th style="width: 150px;">DISCHARGE DATE</th>
                        }
                        else
                        {
                            <th style="width: 150px;">ADMIT DATE</th>
                        }
                        <th>ADMISSION TYPE</th>
                        <th>INSURANCE</th>
                        <th>STATUS</th>
                        <th class="text-center" style="width: 90px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (filteredList != null && filteredList.Any())
                    {
                        var currentPageItems = filteredList.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
                        @for (int rowIndex = 0; rowIndex < currentPageItems.Count; rowIndex++)
                        {
                            var a = currentPageItems[rowIndex];
                            var isFirstRow = rowIndex == 0;
                            <tr class="lc-table-row @(a.isvip == true || a.is_vip == true ? "vip-row" : "")" @ondblclick="() => OpenCaseSheetForIp(a)" style="cursor: pointer;" title="Double-click to open clinical Case Sheet">
                                <td class="font-bold" style="color: #034f75;">@a.ip_no</td>
                                <td class="font-bold text-slate-800">
                                     @(string.IsNullOrWhiteSpace(a.patient_name) ? a.custid.ToString() : a.patient_name)
                                     @{
                                         var aVipRole = (a.isvip == true || a.is_vip == true)
                                             ? (!string.IsNullOrWhiteSpace(a.viprole) ? a.viprole : GetPatientVipRole(a.custid))
                                             : string.Empty;
                                     }
                                     @if (a.isvip == true || a.is_vip == true)
                                     {
                                         <span class="vip-badge" style="background: #fffbeb; border: 1px solid #fde68a; color: #d97706; padding: 2px 6px; border-radius: 4px; font-weight: 700; font-size: 0.7rem; margin-left: 8px; display: inline-flex; align-items: center; gap: 2px;" title="VIP Patient">⭐ VIP</span>
                                         @if (!string.IsNullOrWhiteSpace(aVipRole))
                                         {
                                             <span style="font-size: 0.68rem; color: #b45309; font-weight: 600; margin-left: 4px; background: #fef3c7; border: 1px solid #fde68a; border-radius: 3px; padding: 1px 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px; display: inline-block; vertical-align: middle;" title="@aVipRole">@aVipRole</span>
                                         }
                                     }
                                </td>
                                <td>@(a.mobile ?? customersList.FirstOrDefault(c => c.custid == a.custid)?.mobile ?? "-")</td>
                                <td>Dr. @(doctors.FirstOrDefault(d => d.dcode == a.dcode)?.name ?? a.dcode.ToString())</td>
                                <td>
                                    @{
                                        var bed = bedsList.FirstOrDefault(b => b.bedcode == a.bedcode);
                                        var displayFloor = floorsList.FirstOrDefault(f => f.flrcode == (a.flrcode ?? bed?.flrcode))?.name 
                                                           ?? (a.flrcode ?? bed?.flrcode)?.ToString() ?? "-";
                                        var displayRoomType = roomTypes.FirstOrDefault(r => r.rmtcode == (a.rmtcode ?? bed?.rmtcode))?.name 
                                                              ?? (a.rmtcode ?? bed?.rmtcode)?.ToString() ?? "-";
                                        var displayWard = wardsList.FirstOrDefault(w => w.wrdcode == (a.wrdcode ?? bed?.wrdcode))?.name 
                                                          ?? (a.wrdcode ?? bed?.wrdcode)?.ToString() ?? "-";
                                        var displayBed = bed?.bedname ?? a.bedcode?.ToString() ?? "-";
                                    }
                                    <div style="position: relative; display: inline-block;">
                                        <a href="javascript:void(0)" @onclick="() => ShowBedDetailsPopover(a, displayFloor, displayRoomType, displayBed)" style="text-decoration: underline; color: #026aa7; font-weight: bold; cursor: pointer;">@displayBed</a>
                                        
                                        @if (showBedPopover && selectedBedPatient?.ip_id == a.ip_id)
                                        {
                                            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); border: 1px solid #cbd5e1; background: #ffffff; padding: 8px; border-radius: 6px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06); font-size: 0.72rem; z-index: 1000; width: 190px; text-align: left; line-height: 1.3; color: #334155;">
                                                <button type="button" @onclick="CloseBedPopover" style="position: absolute; right: 6px; top: 3px; border: none; background: none; font-size: 1rem; cursor: pointer; color: #ef4444; font-weight: bold; padding: 0; line-height: 1;">&times;</button>
                                                <div style="font-weight: bold; margin-bottom: 4px; color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 2px; font-size: 0.75rem; padding-right: 15px;">Bed Allocation</div>
                                                <div><strong>Bed No:</strong> @displayBed</div>
                                                <div><strong>Room Type:</strong> @displayRoomType</div>
                                                <div><strong>Ward:</strong> @displayWard</div>
                                                <div><strong>Floor:</strong> @displayFloor</div>
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td class="text-slate-700">
                                    @if (a.ip_status == "DISCHARGED")
                                    {
                                        @(a.dischargedate?.ToString("dd-MM-yyyy hh:mm tt") ?? "-")
                                    }
                                    else
                                    {
                                        @a.admitdate.ToString("dd-MM-yyyy hh:mm tt")
                                    }
                                </td>
                                <td>
                                    <span class="badge-type @(a.admission_type == "EMERGENCY" ? "walkin" : "online")">
                                        @a.admission_type
                                    </span>
                                </td>
                                <td>
                                    @if (a.isinsurancepatient)
                                    {
                                        <div style="position: relative; display: inline-block;">
                                            <a href="javascript:void(0)" @onclick="() => OpenInsuranceCard(a)" style="text-decoration: underline; color: #026aa7; cursor: pointer; font-weight: 600; font-size: 0.8rem;">Insurance details</a>
                                            
                                            @if (showInsuranceModal && selectedInsurancePatient?.ip_id == a.ip_id)
                                            {
                                                <div style="position: absolute; top: @(isFirstRow ? "calc(100% + 1px)" : "50%"); left: 50%; transform: @(isFirstRow ? "translateX(-50%)" : "translate(-50%, -50%)"); border: 1px solid #cbd5e1; background: #ffffff; padding: 8px; border-radius: 6px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06); font-size: 0.72rem; z-index: 1000; width: 190px; text-align: left; line-height: 1.3; color: #334155;">
                                                    <button type="button" @onclick="CloseInsuranceCard" style="position: absolute; right: 6px; top: 3px; border: none; background: none; font-size: 1rem; cursor: pointer; color: #ef4444; font-weight: bold; padding: 0; line-height: 1;">&times;</button>
                                                    <div style="font-weight: bold; margin-bottom: 4px; color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 2px; font-size: 0.75rem; padding-right: 15px;">Insurance Info</div>
                                                    <div><strong>Co:</strong> @a.insurance_company</div>
                                                    <div><strong>Policy:</strong> @a.policyno</div>
                                                    <div><strong>Auth:</strong> @a.authorizationno</div>
                                                    <div><strong>TPA:</strong> @a.tpa_name</div>
                                                    <div><strong>Appr:</strong> @(a.insurance_approved_amount?.ToString("N0") ?? "0")</div>
                                                    <div><strong>Status:</strong> @a.insurance_status</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400" style="font-size: 0.8rem;">No</span>
                                    }
                                </td>
                                <td>
                                    @if (a.ip_status == "ADMITTED")
                                    {
                                        <select disabled="@(!hasEditRight)" @key="@(a.ip_id.ToString() + selectResetKey)" class="status-select admitted" value="@a.ip_status" @onchange="(e) => OnStatusChange(a, e)">
                                            <option value="ADMITTED">Admitted</option>
                                            <option value="DISCHARGED">Discharged</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="status-badge completed">
                                            Discharged
                                        </span>
                                    }
                                </td>
                                <td class="text-center" style="position: relative; overflow: visible;">
                                    <div class="actions-dropdown-container">
                                        <button type="button" class="btn-action-dots" @onclick="() => ToggleDropdown(a.ip_id)" @onclick:stopPropagation>
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        
                                        @if (activeDropdownIpId == a.ip_id)
                                        {
                                            <div class="actions-dropdown-menu" @onclick:stopPropagation>
                                                @if (a.ip_status == "ADMITTED")
                                                {
                                                    @if (hasEditRight)
                                                    {
                                                        <button type="button" class="action-item-btn update" @onclick="() => { OpenUpdateModal(a); ToggleDropdown(a.ip_id); }">
                                                            <i class="bi bi-pencil-fill"></i>
                                                            <span>Edit Admission</span>
                                                        </button>
                                                    }
                                                    @if (hasCaseSheetViewRight)
                                                    {
                                                        <button type="button" class="action-item-btn casesheet" @onclick="() => { OpenCaseSheetForIp(a); ToggleDropdown(a.ip_id); }">
                                                            <i class="bi bi-journal-medical"></i>
                                                            <span>Case Sheet</span>
                                                        </button>
                                                    }
                                                    @if (hasDischargeViewRight)
                                                    {
                                                        <button type="button" class="action-item-btn discharge" @onclick="() => { OpenDischargeSummaryForIp(a); ToggleDropdown(a.ip_id); }">
                                                            <i class="bi bi-file-earmark-text-fill"></i>
                                                            <span>Discharge Summary</span>
                                                        </button>
                                                    }
                                                    @if (hasDeleteRight)
                                                    {
                                                        <button type="button" class="action-item-btn cancel" @onclick="() => { OpenCancelModal(a); ToggleDropdown(a.ip_id); }">
                                                            <i class="bi bi-trash-fill"></i>
                                                            <span>Cancel Admission</span>
                                                        </button>
                                                    }
                                                }
                                                else
                                                {
                                                    @if (hasDischargeViewRight)
                                                    {
                                                        <button type="button" class="action-item-btn discharge" @onclick="() => { OpenDischargeSummaryForIp(a); ToggleDropdown(a.ip_id); }">
                                                            <i class="bi bi-file-earmark-text-fill"></i>
                                                            <span>Discharge Summary</span>
                                                        </button>
                                                    }
                                                    <button type="button" class="action-item-btn disabled" disabled>
                                                        <i class="bi bi-pencil-fill"></i>
                                                        <span>Edit Admission (Disabled)</span>
                                                    </button>
                                                    <button type="button" class="action-item-btn disabled" disabled>
                                                        <i class="bi bi-trash-fill"></i>
                                                        <span>Cancel (Disabled)</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(filterStatus == "DISCHARGED" ? 9 : 10)" class="text-center p-48 text-slate-400 italic">No IP records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* --- PAGINATION --- *@
        @if (filteredList != null && filteredList.Any())
        {
            var totalItems = filteredList.Count;
            var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
            if (totalPages > 1)
            {
                <div class="pagination-footer">
                    <div class="pagination-info">
                        Showing <span class="pagination-info-highlight">@(((currentPage - 1) * pageSize) + 1)</span> to <span class="pagination-info-highlight">@(Math.Min(currentPage * pageSize, totalItems))</span> of <span class="pagination-info-highlight">@totalItems</span> entries
                    </div>
                    <div class="pagination-btns">
                        <button class="page-btn" disabled="@(currentPage == 1)" @onclick="() => currentPage = 1" title="First Page">&laquo;</button>
                        <button class="page-btn" disabled="@(currentPage == 1)" @onclick="() => currentPage--" title="Previous Page">&lsaquo;</button>

                        @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                        {
                            var pageNum = p;
                            <button class="page-btn @(currentPage == pageNum ? "active" : "")" @onclick="() => currentPage = pageNum">@pageNum</button>
                        }

                        <button class="page-btn" disabled="@(currentPage == totalPages)" @onclick="() => currentPage++" title="Next Page">&rsaquo;</button>
                        <button class="page-btn" disabled="@(currentPage == totalPages)" @onclick="() => currentPage = totalPages" title="Last Page">&raquo;</button>
                    </div>
                </div>
            }
        }
    </div>
}
</div>

<!-- Case Sheet Workspace Modal -->
<CaseSheetComponent @bind-Visible="showCaseSheetModal"
                    OpId="selectedOpId"
                    IpId="selectedIpId"
                    OpNo="@selectedOpNo"
                    IpNo="@selectedIpNo"
                    CustId="selectedCustId"
                    Dcode="selectedDcode"
                    PatientName="@selectedPatientName"
                    VisitDate="selectedVisitDate"
                    OpStatus="@selectedOpStatus"
                    OnSaved="RefreshActiveTabQueue" />

<!-- Discharge Summary Workspace Modal for IP -->
<DischargeSummaryComponent @bind-Visible="showDischargeSummaryModal"
                           IpId="selectedDsIpId"
                           IpNo="@selectedDsIpNo"
                           PatCode="@selectedDsPatCode"
                           CustId="selectedDsCustId"
                           Dcode="selectedDsDcode"
                           PatientName="@selectedDsPatientName"
                           DoctorName="@selectedDsDoctorName"
                           BedNo="@selectedDsBedNo"
                           AdmitDate="selectedDsAdmitDate"
                           DischargeDate="selectedDsDischargeDate" />

@* --- ADMIT PATIENT MODAL --- *@
@if (showAdmitModal)
{
    <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 1050;" @onclick="CloseAdmitModal"></div>
    <div class="glass-modal large-modal-custom" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; border-radius: 14px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); z-index: 1060; width: 850px; max-width: 95%; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #e2e8f0; padding: 0;">
        <div class="modal-header" style="background: #004c7a; color: white; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0;">
            <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700;">New Inpatient Admission</h3>
            <button class="close-btn" @onclick="CloseAdmitModal" style="background: transparent; border: none; color: white; font-size: 1.5rem; cursor: pointer; line-height: 1; padding: 0;">&times;</button>
        </div>
        <div class="modal-body" style="padding: 1.5rem; max-height: 70vh; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem;">
            @* Row 1: Patient, Doctor, Type, Reason *@
            <div class="um-grid-cols-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
                <div class="form-group" style="position: relative; display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Select Patient *</label>
                    <div style="position: relative;">
                        <input type="text" class="filter-control" placeholder="-- Choose Patient --" 
                               value="@selectedPatientSearchName" 
                               @oninput="OnPatientSearchInput" 
                               @focus="ShowPatientDropdown" 
                               @onblur="HidePatientDropdownWithDelay" 
                               @onkeydown="OnPatientSearchKeyDown" 
                               style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                        
                        @if (showPatientDropdown)
                        {
                            <div style="position: absolute; top: 100%; left: 0; right: 0; z-index: 1070; max-height: 200px; overflow-y: auto; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); margin-top: 2px;">
                                @if (filteredPatientsForDropdown.Any())
                                {
                                    @for (int idx = 0; idx < filteredPatientsForDropdown.Count; idx++)
                                    {
                                        var pIndex = idx;
                                        var p = filteredPatientsForDropdown[idx];
                                        <div @onmousedown="() => SelectPatientFromDropdown(p)" 
                                             style="padding: 8px 12px; cursor: pointer; font-size: 0.8rem; color: #1e293b; background-color: @(idx == activeDropdownIndex ? "#f1f5f9" : "transparent");">
                                            @p.custcode @(string.IsNullOrEmpty(p.namewithinitials) ? p.name : p.namewithinitials)
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div style="padding: 8px 12px; font-size: 0.8rem; color: #64748b; font-style: italic;">No patients found</div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Assigned Doctor *</label>
                    <select class="filter-control" @bind="admitRequest.dcode" @bind:after="PrintPayload" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem;">
                        <option value="0">-- Choose Doctor --</option>
                        @foreach (var d in doctors)
                        {
                            <option value="@d.dcode">Dr. @(string.IsNullOrWhiteSpace(d.name) ? d.doctorfullname ?? "Specialist" : d.name)</option>
                        }
                    </select>
                </div>
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Admission Type</label>
                    <select class="filter-control" @bind="admitRequest.admission_type" @bind:after="PrintPayload" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem;">
                        <option value="PLANNED">PLANNED</option>
                        <option value="EMERGENCY">EMERGENCY</option>
                        <option value="REFERRAL">REFERRAL</option>
                    </select>
                </div>
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Admission Reason</label>
                    <input type="text" class="filter-control" @bind="admitRequest.admission_reason" @bind:event="oninput" @bind:after="PrintPayload" placeholder="e.g. Appendectomy" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                </div>
            </div>

            @* Row 2: Expected Discharge Date & Guardian Info *@
            <div class="um-grid-cols-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Expected Discharge Date</label>
                    <input type="date" class="filter-control" @bind="admitRequest.expected_dischargedate" @bind:after="PrintPayload" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                </div>
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Guardian Name</label>
                    <input type="text" class="filter-control" @bind="admitRequest.guardian_name" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Name" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                </div>
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Relation</label>
                    <input type="text" class="filter-control" @bind="admitRequest.guardian_relation" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Relation" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                </div>
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Contact No</label>
                    <input type="text" class="filter-control" @bind="admitRequest.guardian_contact" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Contact" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                </div>
            </div>

            @* Row 3: Notes & Is Insurance Patient *@
            <div class="um-grid-cols-4" style="display: grid; grid-template-columns: 3fr 1fr; gap: 1rem;">
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Admission Notes</label>
                    <input type="text" class="filter-control" @bind="admitRequest.notes" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Notes" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                </div>
                <div class="form-group" style="display: flex; flex-direction: row; align-items: center; gap: 8px; margin-top: 20px;">
                    <input type="checkbox" id="isinsurance" @bind="admitRequest.isinsurancepatient" @bind:after="PrintPayload" style="width: 16px; height: 16px; cursor: pointer;" />
                    <label for="isinsurance" style="margin-bottom: 0; cursor: pointer; text-transform: none; font-size: 0.8rem; font-weight: 700; color: #475569;">Is Insurance Patient</label>
                </div>
            </div>

            @if (admitRequest.isinsurancepatient)
            {
                @* Row 4: Insurance details (Insurance, Policy No, Auth No, TPA) *@
                <div class="um-grid-cols-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Insurance Company</label>
                        <input type="text" class="filter-control" @bind="admitRequest.insurance_company" @bind:event="oninput" @bind:after="PrintPayload" placeholder="e.g. Star Health" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                    </div>
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Policy No</label>
                        <input type="text" class="filter-control" @bind="admitRequest.policyno" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Policy No" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                    </div>
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Authorization No</label>
                        <input type="text" class="filter-control" @bind="admitRequest.authorizationno" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Auth No" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                    </div>
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">TPA Name</label>
                        <input type="text" class="filter-control" @bind="admitRequest.tpa_name" @bind:event="oninput" @bind:after="PrintPayload" placeholder="TPA" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                    </div>
                </div>
                
                @* Row 5: Approved Amount *@
                <div class="um-grid-cols-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Approved Amount</label>
                        <input type="number" step="any" class="filter-control" @bind="admitRequest.insurance_approved_amount" @bind:event="oninput" @bind:after="PrintPayload" placeholder="0.00" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                    </div>
                </div>
            }

        </div>
        <div class="modal-footer" style="background: #f8fafc; padding: 1rem 1.5rem; display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid #edf2f7;">
            <button class="btn-modal cancel" @onclick="CloseAdmitModal" style="background: white; border: 1px solid #cbd5e1; color: #64748b; padding: 0.55rem 1.25rem; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer;">Cancel</button>
            <button class="btn-modal confirm" @onclick="GoToBedAllocation" style="background: #0284c7; border: none; color: white; padding: 0.55rem 1.25rem; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer;">Bed Allocation</button>
        </div>
    </div>
}

@* --- DISCHARGE MODAL --- *@
@if (showDischargeModal)
{
    <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 1050;" @onclick="CloseDischargeModal"></div>
    <div class="glass-modal" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; border-radius: 14px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); z-index: 1060; width: 480px; max-width: 90%; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #e2e8f0; padding: 0;">
        <div class="modal-header" style="background: #004c7a; color: white; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0;">
            <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700;">Discharge Patient</h3>
            <button class="close-btn" @onclick="CloseDischargeModal" style="background: transparent; border: none; color: white; font-size: 1.5rem; cursor: pointer; line-height: 1; padding: 0;">&times;</button>
        </div>
        <div class="modal-body" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Discharge Type *</label>
                <select class="filter-control" @bind="dischargeRequest.discharge_type" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem;">
                    <option value="NORMAL">NORMAL</option>
                    <option value="DAMA">DAMA (Discharge Against Medical Advice)</option>
                    <option value="LAMA">LAMA (Left Against Medical Advice)</option>
                    <option value="DEATH">DEATH</option>
                    <option value="REFERRED">REFERRED</option>
                </select>
            </div>
            <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Discharge Summary / Comments</label>
                <textarea class="filter-control" style="width: 100%; height: 100px; resize: none; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" @bind="dischargeRequest.discharge_summary" placeholder="Provide summary of patient status, medication instructions, follow-up advice..."></textarea>
            </div>
        </div>
        <div class="modal-footer" style="background: #f8fafc; padding: 1rem 1.5rem; display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid #edf2f7;">
            <button class="btn-modal cancel" @onclick="CloseDischargeModal" style="background: white; border: 1px solid #cbd5e1; color: #64748b; padding: 0.55rem 1.25rem; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer;">Cancel</button>
            <button class="btn-modal confirm" @onclick="ExecuteDischarge" style="background: #0284c7; border: none; color: white; padding: 0.55rem 1.25rem; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer;">Confirm Discharge</button>
        </div>
    </div>
}

@* --- UPDATE IP REGISTRATION MODAL --- *@
@if (showUpdateModal)
{
    <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 1050;" @onclick="CloseUpdateModal"></div>
    <div class="glass-modal large-modal-custom" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; border-radius: 14px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); z-index: 1060; width: 850px; max-width: 95%; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #e2e8f0; padding: 0;">
        <div class="modal-header" style="background: #004c7a; color: white; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0;">
            <h3>Update Inpatient Admission</h3>
            <button class="close-btn" @onclick="CloseUpdateModal" style="background: transparent; border: none; color: white; font-size: 1.5rem; cursor: pointer; line-height: 1; padding: 0;">&times;</button>
        </div>
        <div class="modal-body" style="padding: 1.5rem; max-height: 70vh; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem;">
            @* Row 1: Doctor, Referring Doctor, Department, Reason *@
            <div class="um-grid-cols-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Patient Name</label>
                    <input type="text" class="filter-control" value="@selectedUpdatePatientName" readonly style="background-color: #f1f5f9; cursor: not-allowed; font-weight: bold; width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                </div>
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Assigned Doctor</label>
                    <select class="filter-control" @bind="updateRequest.dcode" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem;">
                        <option value="">-- Choose Doctor --</option>
                        @foreach (var d in doctors)
                        {
                            <option value="@d.dcode">Dr. @d.name</option>
                        }
                    </select>
                </div>
                <div class="form-group" style="grid-column: span 2; display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Admission Reason</label>
                    <input type="text" class="filter-control" @bind="updateRequest.admission_reason" placeholder="e.g. Appendectomy" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                </div>
            </div>

            @* Row 2: Expected Discharge Date, Guardian Name, Relation, Contact *@
            <div class="um-grid-cols-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Expected Discharge Date</label>
                    <input type="date" class="filter-control" @bind="updateRequest.expected_dischargedate" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                </div>
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Guardian Name</label>
                    <input type="text" class="filter-control" @bind="updateRequest.guardian_name" placeholder="Name" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                </div>
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Relation</label>
                    <input type="text" class="filter-control" @bind="updateRequest.guardian_relation" placeholder="Relation" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                </div>
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Contact No</label>
                    <input type="text" class="filter-control" @bind="updateRequest.guardian_contact" placeholder="Contact" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                </div>
            </div>

            @* Row 3: Notes & Insurance Patient Checkbox *@
            <div class="um-grid-cols-4" style="display: grid; grid-template-columns: 3fr 1fr; gap: 1rem;">
                <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Notes</label>
                    <input type="text" class="filter-control" @bind="updateRequest.notes" placeholder="Notes" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                </div>
                <div class="form-group" style="display: flex; flex-direction: row; align-items: center; gap: 8px; margin-top: 20px;">
                    <input type="checkbox" id="update_isinsurance" @bind="updateRequest.isinsurancepatient" style="width: 16px; height: 16px; cursor: pointer;" />
                    <label for="update_isinsurance" style="margin-bottom: 0; cursor: pointer; text-transform: none; font-size: 0.8rem; font-weight: 700; color: #475569;">Is Insurance Patient</label>
                </div>
            </div>

            @if (updateRequest.isinsurancepatient == true)
            {
                @* Row 4: Insurance details *@
                <div class="um-grid-cols-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Insurance Company</label>
                        <input type="text" class="filter-control" @bind="updateRequest.insurance_company" placeholder="e.g. Star Health" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                    </div>
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Policy No</label>
                        <input type="text" class="filter-control" @bind="updateRequest.policyno" placeholder="Policy No" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                    </div>
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Authorization No</label>
                        <input type="text" class="filter-control" @bind="updateRequest.authorizationno" placeholder="Auth No" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                    </div>
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">TPA Name</label>
                        <input type="text" class="filter-control" @bind="updateRequest.tpa_name" placeholder="TPA" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                    </div>
                </div>
                
                @* Row 5: Approved Amount *@
                <div class="um-grid-cols-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Approved Amount</label>
                        <input type="number" step="any" class="filter-control" @bind="updateRequest.insurance_approved_amount" placeholder="0.00" style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" />
                    </div>
                </div>
            }

        </div>
        <div class="modal-footer" style="background: #f8fafc; padding: 1rem 1.5rem; display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid #edf2f7;">
            <button class="btn-modal cancel" @onclick="CloseUpdateModal" style="background: white; border: 1px solid #cbd5e1; color: #64748b; padding: 0.55rem 1.25rem; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer;">Cancel</button>
            <button class="btn-modal confirm" @onclick="ExecuteUpdate" style="background: #0284c7; border: none; color: white; padding: 0.55rem 1.25rem; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer;">Save Changes</button>
        </div>
    </div>
}

@* --- CANCEL ADMISSION MODAL --- *@
@if (showCancelModal)
