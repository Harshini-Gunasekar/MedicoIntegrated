@page "/booking/doctor"
@using Booking.Models
@using Booking.Services
@using Booking.Helpers
@using System.Net.Http.Json
@using SharedComponents.Rcl.Models
@inject AppointmentBookingService BookingService
@inject DoctorService DoctorService
@inject DoctorCurrentStatusService StatusService
@inject DoctorSpecialtyMasterService SpecialtyService
@inject ToastService ToastService
@inject CaseSheetService CaseSheetService
@inject IHttpClientFactory ClientFactory
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<PageTitle>Doctor Patient List</PageTitle>

<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
</div>

<div class="dashboard-container">
    <DnaLoader IsLoading="@loading" Message="Loading Patients..." />
    <!-- Header -->
    <div class="dashboard-header">
        <div class="dashboard-title">
            <h1>Doctor's Patient List</h1>
            <p>View your scheduled patients, tokens, and appointment statuses for selected date.</p>
        </div>
        <div>
            <button class="btn-header-action" @onclick="LoadTodayBookingsAsync" disabled="@loading">
                @if (loading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                }
                <i class="bi bi-arrow-clockwise"></i> Refresh Queue
            </button>
        </div>
    </div>

    @if (loading && todayBookings.Count == 0)
    {
        <div class="loading-state">
            <div class="spinner-border" role="status"></div>
            <p>Loading patient list...</p>
        </div>
    }
    else
    {
        <!-- Stats Row -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="bi bi-calendar3"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@GetFilteredBookings().Count</span>
                    <span class="stat-label">Total Scheduled</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@GetFilteredBookings().Count(b => b.booking_status?.ToUpper() == "BOOKED")</span>
                    <span class="stat-label">Pending</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green">
                    <i class="bi bi-check2-all"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@GetFilteredBookings().Count(b => b.booking_status?.ToUpper() == "CONFIRMED" || b.booking_status?.ToUpper() == "COMPLETED" || b.booking_status?.ToUpper() == "VISITED")</span>
                    <span class="stat-label">Confirmed/Served</span>
                </div>
            </div>
        </div>

        <!-- Toolbar Filters -->
        <div class="filter-card">
            <div class="filter-flex">
                <div class="filter-group filter-date-col">
                    <label class="filter-label">FILTER DATE</label>
                    <input type="date" class="form-control filter-input" @bind="selectedDate" @bind:after="OnDateChanged" />
                </div>

                <div class="filter-group">
                    <label class="filter-label">DOCTOR SPECIALIST</label>
                    <select class="form-select filter-select" @bind="selectedDoctorDcode" @bind:after="OnDoctorChanged">
                        <option value="">All Specialists</option>
                        @foreach (var doc in doctors)
                        {
                            <option value="@doc.dcode">@(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</option>
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">STATUS</label>
                    <select class="form-select filter-select" @bind="statusFilter">
                        <option value="ALL">All Statuses</option>
                        <option value="BOOKED">Booked</option>
                        <option value="CONFIRMED">Confirmed</option>
                        <option value="COMPLETED">Completed</option>
                        <option value="CANCELLED">Cancelled</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">REG TYPE</label>
                    <select class="form-select filter-select" @bind="bookingTypeFilter">
                        <option value="ALL">All Types</option>
                        <option value="ONLINE">Online</option>
                        <option value="WALKIN">Walk-in</option>
                    </select>
                </div>

                
                
                <div class="filter-group filter-search-col">
                    <label class="filter-label">SEARCH PATIENT / DOCTOR</label>
                    <input type="text" class="form-control filter-input" placeholder="e.g. CUST-1001, 2026..." @bind="searchQuery" @bind:event="oninput" />
                </div>

                <div class="filter-action-group">
                    <button class="btn-reset" @onclick="ResetFilters">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </button>
                </div>
            </div>
        </div>

        <!-- Patients List/Table Card -->
        <div class="table-card">
            @if (GetFilteredBookings().Any())
            {
                <div class="table-responsive">
                    <table class="medico-table">
                        <thead>
                            <tr>
                                <th style="width: 90px;">Token</th>
                                <th style="width: 200px;">Patient Name</th>
                                <th style="width: 130px;">Patient ID</th>
                                <th style="width: 120px;">Reg Type</th>
                                <th style="width: 180px;">Time Range</th>
                                <!-- <th>Booking Ref</th> -->
                                <th>Notes</th>
                                <th style="width: 140px;">Status</th>
                                <th style="width: 110px; text-align: center;">VIP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in GetFilteredBookings())
                            {
                                <tr class="@(b.isvip == true ? "vip-row" : "")">
                                    <td>
                                        <div class="badge-op-container">
                                            <span class="badge-op">@b.token_no</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="patient-name-container" style="cursor: pointer;" @onclick="() => OpenCaseSheetForBooking(b)" title="Open Clinical Case Sheet">

                                            <span class="patient-name text-primary text-decoration-underline-hover">@(string.IsNullOrWhiteSpace(b.patient_name) ? "Walk-in Patient" : b.patient_name)</span>

                                        </div>
                                    </td>
                                    <td>
                                        <span class="patient-id-badge">ID: @b.custid</span>
                                    </td>
                                    <td>
                                        @{
                                            string displayRegType = !string.IsNullOrWhiteSpace(b.reg_type) 
                                                ? b.reg_type 
                                                : (!string.IsNullOrWhiteSpace(b.booking_type) ? b.booking_type : "WALKIN");

                                            bool isOnline = displayRegType.Equals("ONLINE", StringComparison.OrdinalIgnoreCase) 
                                                         || displayRegType.Equals("APP", StringComparison.OrdinalIgnoreCase)
                                                         || displayRegType.Equals("WEB", StringComparison.OrdinalIgnoreCase);
                                        }
                                        @if (isOnline)
                                        {
                                            <span style="background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-weight: 700; padding: 4px 10px; border-radius: 6px; font-size: 0.76rem; display: inline-flex; align-items: center; gap: 5px;">
                                                <i class="bi bi-globe"></i> Online
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; font-weight: 700; padding: 4px 10px; border-radius: 6px; font-size: 0.76rem; display: inline-flex; align-items: center; gap: 5px;">
                                                <i class="bi bi-person-walking"></i> Walk-in
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (b.slot_start_time == default(TimeOnly) && b.slot_end_time == default(TimeOnly))
                                        {
                                            <span class="text-muted" style="margin-left: 14px; font-weight: 700;">-</span>
                                        }
                                        else
                                        {
                                            <span class="time-badge">
                                                <i class="bi bi-clock"></i>
                                                @FormatTime(b.slot_start_time) - @FormatTime(b.slot_end_time)
                                            </span>
                                        }
                                    </td>
                                    <!-- <td>
                                        <div class="booking-ref-block">
                                            <span class="booking-no">@(string.IsNullOrWhiteSpace(b.booking_no) ? "N/A" : b.booking_no)</span>
                                            <span class="booking-type-label @b.booking_type?.ToLower()">@b.booking_type</span>
                                        </div>
                                    </td> -->
                                    <td>
                                        <span class="notes-text" title="@b.notes">
                                            @(string.IsNullOrWhiteSpace(b.notes) ? "-" : b.notes)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="status-pill @b.booking_status?.ToLower()">
                                            @b.booking_status
                                        </span>
                                    </td>
                                    <td class="@(b.isvip == true ? "vip-highlighted" : "")" style="text-align: center; vertical-align: middle; padding: 0.75rem 1.2rem;">
                                        <div style="display: flex; flex-direction: column; gap: 0.35rem; justify-content: center; align-items: center;">
                                            @if (b.isvip == true)
                                            {
                                                <button type="button" title="Edit VIP: @b.viprole" @onclick="() => OpenVipModal(b)" style="background: #fffbeb; border: 1px solid #fde68a; color: #d97706; padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 4px; transition: all 0.2s;">
                                                    VIP
                                                </button>
                                                @if (!string.IsNullOrWhiteSpace(b.viprole))
                                                {
                                                    <span style="font-size: 0.7rem; color: #b45309; font-weight: 600; text-align: center; max-width: 110px; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@b.viprole">@b.viprole</span>
                                                }
                                            }
                                            else
                                            {
                                                <button type="button" title="Mark as VIP" @onclick="() => OpenVipModal(b)" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #64748b; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 4px; transition: all 0.2s;">
                                                    Mark VIP
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-people-fill empty-icon"></i>
                    <h3>No Patients Found</h3>
                    <p>No patient bookings match the selected criteria for this date.</p>
                </div>
            }
        </div>
    }
</div>

<!-- Case Sheet Workspace Modal -->
<CaseSheetComponent @bind-Visible="showCaseSheetModal"
                    OpId="selectedOpId"
                    OpNo="@selectedOpNo"
                    CustId="selectedCustId"
                    Dcode="selectedDcode"
                    PatientName="@selectedPatientName"
                    VisitDate="selectedVisitDate"
                    OpStatus="@selectedOpStatus"
                    OnSaved="LoadTodayBookingsAsync" />

@if (showVipModal)
{
    <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 1050;" @onclick="CloseVipModal"></div>
    <div class="vip-modal-container" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); z-index: 1060; width: 400px; max-width: 90%; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #e2e8f0;">
        <div style="background: #004c7a; color: white; padding: 1.2rem; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                Set VIP Status
            </h3>
            <button type="button" @onclick="CloseVipModal" style="background: transparent; border: none; color: white; font-size: 1.5rem; cursor: pointer; line-height: 1; padding: 0;">&times;</button>
        </div>
        <div style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            <div style="font-size: 0.9rem; color: #334155; font-weight: 500;">
                Patient Name: <strong style="color: #0f172a;">@vipPatientName</strong> (ID: @vipCustId)
            </div>
            
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                <label style="font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase;">VIP Role / Description</label>
                <input type="text" class="form-control" @bind="vipRoleText" placeholder="e.g. govt job, friend of MD" style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.6rem 0.8rem; font-size: 0.9rem; width: 100%; box-sizing: border-box;" />
            </div>
        </div>
        <div style="background: #f8fafc; padding: 1rem 1.5rem; display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid #edf2f7;">
            <button type="button" @onclick="CloseVipModal" style="background: white; border: 1px solid #cbd5e1; color: #64748b; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; font-size: 0.85rem; cursor: pointer;">Cancel</button>
            <button type="button" @onclick="SaveVipStatus" disabled="@isVipSaving" style="background: #d97706; border: none; color: white; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                @if (isVipSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin: 0;"></span>
                }
                Save VIP Status
            </button>
        </div>
    </div>
}

<!-- Doctor Status Update Popup Modal -->
@if (showDoctorStatusModal)
{
    <div class="doc-status-modal-backdrop" @onclick="CloseDoctorStatusModal"></div>
    <div class="doc-status-popup-modal" @onclick:stopPropagation>
        <div class="doc-status-popup-header">
            <div class="doc-status-popup-title">
                <i class="bi bi-pencil-square"></i>
                <span>Update Doctor Status</span>
            </div>
            <button type="button" class="doc-status-close-btn" @onclick="CloseDoctorStatusModal" title="Close">&times;</button>
        </div>

        <div class="doc-status-popup-body">
            <!-- Searchable Doctor Select Input -->
            <div class="doc-status-form-group">
                <label class="doc-status-label">SEARCH / SELECT DOCTOR <span class="text-danger">*</span></label>
                <div class="doc-status-search-wrapper">
                    <i class="bi bi-search doc-status-search-icon"></i>
                    <input type="text"
                           class="doc-status-search-input @(isStatusDocDropdownOpen ? "dropdown-open" : "")"
                           placeholder="Type doctor name or specialty..."
                           value="@statusDocSearchQuery"
                           @oninput="OnStatusDocSearchInput"
                           @onfocus="() => isStatusDocDropdownOpen = true"
                           @onblur="OnStatusDocSearchBlur" />

                    @if (statusModalDcode > 0 || !string.IsNullOrEmpty(statusDocSearchQuery))
                    {
                        <button type="button" class="doc-status-clear-btn" @onclick="ClearStatusModalDoctor" title="Clear selection">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                    else
                    {
                        <i class="bi bi-chevron-down doc-status-arrow-icon"></i>
                    }

                    @if (isStatusDocDropdownOpen)
                    {
                        <div class="doc-status-dropdown-list" @mousedown:preventDefault>
                            @{
                                var matchDocs = GetMatchingDoctorsForStatusModal();
                            }
                            @if (!matchDocs.Any())
                            {
                                <div class="doc-status-empty-dropdown">
                                    <i class="bi bi-person-x"></i> No doctor found matching "@statusDocSearchQuery"
                                </div>
                            }
                            else
                            {
                                @foreach (var doc in matchDocs)
                                {
                                    var stObj = modalStatusMap.GetValueOrDefault(doc.dcode);
                                    var stKey = NormalizeDoctorStatus(stObj?.status);
                                    var isSelected = doc.dcode == statusModalDcode;

                                    <div class="doc-status-dropdown-item @(isSelected ? "selected" : "")"
                                         @onclick="() => SelectDoctorForStatusModal(doc.dcode)">
                                        <div class="doc-status-item-avatar">
                                            @if (!string.IsNullOrEmpty(doc.doctorimage))
                                            {
                                                <img src="@doc.doctorimage" alt="@doc.name" />
                                            }
                                            else
                                            {
                                                <span>@GetDocInitials(doc.name ?? doc.doctorfullname)</span>
                                            }
                                        </div>
                                        <div class="doc-status-item-details">
                                            <div class="doc-status-item-name">@(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</div>
                                            <div class="doc-status-item-spec">@GetDoctorSpecialtyName(doc.spcode)</div>
                                        </div>
                                        <div class="doc-status-item-tag @GetDoctorStatusCssClass(stKey)">
                                            @GetDoctorStatusLabel(stKey)
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            @if (statusModalDcode > 0)
            {
                var activeDoc = doctors.FirstOrDefault(d => d.dcode == statusModalDcode);
                var currentStatusObj = modalStatusMap.GetValueOrDefault(statusModalDcode);
                var normalizedCurrent = NormalizeDoctorStatus(currentStatusObj?.status);

                <!-- Selected Doctor Card Preview -->
                <div class="doc-status-active-preview">
                    <div class="doc-status-doctor-avatar">
                        @if (!string.IsNullOrEmpty(activeDoc?.doctorimage))
                        {
                            <img src="@activeDoc.doctorimage" alt="@activeDoc.name" />
                        }
                        else
                        {
                            <span>@GetDocInitials(activeDoc?.name ?? activeDoc?.doctorfullname)</span>
                        }
                    </div>
                    <div class="doc-status-preview-info">
                        <h4>@(string.IsNullOrWhiteSpace(activeDoc?.name) ? activeDoc?.doctorfullname : activeDoc?.name)</h4>
                        <span class="doc-status-spec-title">@GetDoctorSpecialtyName(activeDoc?.spcode)</span>
                        <div class="doc-status-current-tag @GetDoctorStatusCssClass(normalizedCurrent)">
                            <i class="@GetDoctorStatusIcon(normalizedCurrent)"></i>
                            @GetDoctorStatusLabel(normalizedCurrent)
                        </div>
                    </div>
                </div>

                <!-- Status Selection Options Grid -->
                <div class="doc-status-form-group">
                    <label class="doc-status-label">SELECT AVAILABILITY STATUS</label>
                    <div class="doc-status-options-grid">
                        <button type="button" class="doc-status-option-btn @(statusModalEditStatus == "IN_OPD" ? "active in-opd" : "")"
                                @onclick='() => statusModalEditStatus = "IN_OPD"'>
                            <i class="bi bi-door-open-fill"></i>
                            <span>In OPD</span>
                        </button>

                        <button type="button" class="doc-status-option-btn @(statusModalEditStatus == "ON_DUTY" ? "active on-duty" : "")"
                                @onclick='() => statusModalEditStatus = "ON_DUTY"'>
                            <i class="bi bi-check-circle-fill"></i>
                            <span>On Duty</span>
                        </button>

                        <button type="button" class="doc-status-option-btn @(statusModalEditStatus == "BREAK" ? "active break" : "")"
                                @onclick='() => statusModalEditStatus = "BREAK"'>
                            <i class="bi bi-cup-hot-fill"></i>
                            <span>On Break</span>
                        </button>

                        <button type="button" class="doc-status-option-btn @(statusModalEditStatus == "BUSY" ? "active busy" : "")"
                                @onclick='() => statusModalEditStatus = "BUSY"'>
                            <i class="bi bi-heart-pulse-fill"></i>
                            <span>Busy / Surgery</span>
                        </button>

                        <button type="button" class="doc-status-option-btn @(statusModalEditStatus == "ON_LEAVE" ? "active leave" : "")"
                                @onclick='() => statusModalEditStatus = "ON_LEAVE"'>
                            <i class="bi bi-airplane-fill"></i>
                            <span>On Leave</span>
                        </button>

                        <button type="button" class="doc-status-option-btn @(statusModalEditStatus == "OFF_DUTY" ? "active off-duty" : "")"
                                @onclick='() => statusModalEditStatus = "OFF_DUTY"'>
                            <i class="bi bi-power"></i>
                            <span>Off Duty</span>
                        </button>
                    </div>
                </div>

                <!-- Expected Return Time -->
                <div class="doc-status-form-group">
                    <label class="doc-status-label">EXPECTED RETURN TIME (OPTIONAL)</label>
                    <div class="doc-status-chips">
                        <button type="button" class="doc-status-chip-btn" @onclick='() => AddModalReturnMinutes(15)'>+15m</button>
                        <button type="button" class="doc-status-chip-btn" @onclick='() => AddModalReturnMinutes(30)'>+30m</button>
                        <button type="button" class="doc-status-chip-btn" @onclick='() => AddModalReturnMinutes(60)'>+1 hour</button>
                        <button type="button" class="doc-status-chip-btn" @onclick='() => AddModalReturnMinutes(120)'>+2 hours</button>
                        <button type="button" class="doc-status-chip-btn clear" @onclick='() => statusModalExpectedReturnTime = null'>Clear</button>
                    </div>
                    <input type="datetime-local" class="doc-status-input" @bind="statusModalExpectedReturnTime" />
                </div>

                <!-- Remarks / Location Notes -->
                <div class="doc-status-form-group">
                    <label class="doc-status-label">REMARKS / LOCATION NOTE</label>
                    <input type="text" class="doc-status-input" placeholder="e.g. Available in OPD Room 3, Emergency OT..."
                           @bind="statusModalRemarks" />
                </div>
            }
            else
            {
                <div class="doc-status-empty-placeholder">
                    <i class="bi bi-search"></i>
                    <p>Search and select a doctor to view and update status details.</p>
                </div>
            }
        </div>

        <div class="doc-status-popup-footer">
            <button type="button" class="doc-status-btn-cancel" @onclick="CloseDoctorStatusModal">Cancel</button>
            @if (statusModalDcode > 0)
            {
                <button type="button" class="doc-status-btn-save" @onclick="SaveDoctorStatusFromModal" disabled="@isStatusModalSaving">
                    @if (isStatusModalSaving)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-send-check-fill"></i>
                        <span>Save & Publish Status</span>
                    }
                </button>
            }
        </div>
    </div>
}

<!-- Floating Quick Access Button for Doctor Status Popup -->
@if (!showCaseSheetModal)
{
    <div class="doctor-status-fab-container">
        <button type="button" class="doctor-status-fab" @onclick="OpenDoctorStatusModal" title="Quick Access: Update Doctor Availability Status">
            <div class="fab-icon-pulse">
                <i class="bi bi-person-badge-fill"></i>
            </div>
            <span class="fab-label">Doctor Status</span>
        </button>
    </div>
}

@code {
    private string TenantCode = "";
    private string AuthToken = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";
                
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error loading session in DoctorPatientList: {ex.Message}");
            }
        }
    }

    private List<DoctorMasterModel> doctors = new();
    private List<DoctorBookingListModel> todayBookings = new();
    private int? selectedDoctorDcode = null; // Defaulting to all specialists
    private DateTime selectedDate = DateTime.UtcNow.ToIndianTime().Date; // Defaulting to current date
    private string searchQuery = string.Empty;
    private string statusFilter = "ALL";
    private string bookingTypeFilter = "ALL";
    private bool loading = false;

    // Case Sheet modal state fields
    private bool showCaseSheetModal = false;
    private Guid selectedOpId = Guid.Empty;
    private string selectedOpNo = string.Empty;
    private decimal selectedCustId = 0;
    private int selectedDcode = 0;
    private string selectedPatientName = string.Empty;
    private DateTime? selectedVisitDate = null;
    private string selectedOpStatus = "WAITING";

    // VIP modal fields
    private bool showVipModal = false;
    private decimal vipCustId = 0;
    private string vipRoleText = string.Empty;
    private string vipPatientName = string.Empty;
    private bool isVipSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctorsAsync();
        await LoadTodayBookingsAsync();
