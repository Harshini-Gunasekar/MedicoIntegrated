    private async Task SaveVipStatus()
    {
        if (string.IsNullOrWhiteSpace(vipRoleText))
        {
            ToastService.ShowError("Please enter a VIP Role (e.g. 'govt job').");
            return;
        }

        isVipSaving = true;
        try
        {
            using var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }

            var payload = new 
            { 
                custid = (long)vipCustId, 
                viprole = vipRoleText 
            };
            
            var response = await client.PostAsJsonAsync("api/Customer/mark-as-vip", payload);
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess($"Successfully marked {vipPatientName} as VIP.");
                showVipModal = false;
                await LoadTodayBookingsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to save VIP status: {error}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving VIP status: {ex.Message}");
        }
        finally
        {
            isVipSaving = false;
        }
    }

    // Doctor Status Modal State Fields & Methods
    private bool showDoctorStatusModal = false;
    private bool isStatusModalSaving = false;
    private long statusModalDcode = 0;
    private string statusDocSearchQuery = string.Empty;
    private bool isStatusDocDropdownOpen = false;
    private string statusModalEditStatus = "IN_OPD";
    private string? statusModalRemarks = string.Empty;
    private DateTime? statusModalExpectedReturnTime = null;
    private Dictionary<long, DoctorCurrentStatusModel> modalStatusMap = new();
    private Dictionary<int, string> doctorSpecialtiesMap = new();

    private async Task OpenDoctorStatusModal()
    {
        showDoctorStatusModal = true;
        try
        {
            var specs = await SpecialtyService.GetDoctorSpecialtiesAsync();
            doctorSpecialtiesMap = specs.ToDictionary(s => s.spcode, s => s.name ?? "General");

            var statuses = await StatusService.GetAllStatusesAsync();
            modalStatusMap = statuses.GroupBy(s => s.dcode).ToDictionary(
                g => g.Key,
                g => g.OrderByDescending(s => s.updated_at != default ? s.updated_at : s.created_at).First()
            );

            if (selectedDoctorDcode.HasValue && selectedDoctorDcode.Value > 0)
            {
                SelectDoctorForStatusModal(selectedDoctorDcode.Value);
            }
            else if (doctors.Any())
            {
                SelectDoctorForStatusModal(doctors.First().dcode);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DoctorStatusModal] Init error: {ex.Message}");
        }
    }

    private void CloseDoctorStatusModal()
    {
        showDoctorStatusModal = false;
        isStatusDocDropdownOpen = false;
    }

    private void OnStatusDocSearchInput(ChangeEventArgs e)
    {
        statusDocSearchQuery = e.Value?.ToString() ?? string.Empty;
        isStatusDocDropdownOpen = true;
    }

    private async Task OnStatusDocSearchBlur()
    {
        await Task.Delay(200);
        isStatusDocDropdownOpen = false;
    }

    private List<DoctorMasterModel> GetMatchingDoctorsForStatusModal()
    {
        if (string.IsNullOrWhiteSpace(statusDocSearchQuery)) return doctors;
        var q = statusDocSearchQuery.Trim().ToLower();
        return doctors.Where(d =>
            (d.name != null && d.name.ToLower().Contains(q)) ||
            (d.doctorfullname != null && d.doctorfullname.ToLower().Contains(q)) ||
            (GetDoctorSpecialtyName(d.spcode).ToLower().Contains(q))
        ).ToList();
    }

    private void SelectDoctorForStatusModal(long dcode)
    {
        statusModalDcode = dcode;
        var doc = doctors.FirstOrDefault(d => d.dcode == dcode);
        if (doc != null)
        {
            var name = string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name;
            statusDocSearchQuery = $"{name} ({GetDoctorSpecialtyName(doc.spcode)})";
        }
        isStatusDocDropdownOpen = false;

        if (modalStatusMap.TryGetValue(dcode, out var existingStatus))
        {
            statusModalEditStatus = NormalizeDoctorStatus(existingStatus.status);
            statusModalRemarks = existingStatus.remarks ?? "";
            statusModalExpectedReturnTime = existingStatus.expected_return_time;
        }
        else
        {
            statusModalEditStatus = "IN_OPD";
            statusModalRemarks = "";
            statusModalExpectedReturnTime = null;
        }
    }

    private void ClearStatusModalDoctor()
    {
        statusModalDcode = 0;
        statusDocSearchQuery = string.Empty;
        isStatusDocDropdownOpen = true;
    }

    private void AddModalReturnMinutes(int minutes)
    {
        var baseTime = statusModalExpectedReturnTime ?? DateTime.Now;
        if (baseTime < DateTime.Now) baseTime = DateTime.Now;
        statusModalExpectedReturnTime = baseTime.AddMinutes(minutes);
    }

    private async Task SaveDoctorStatusFromModal()
    {
        if (statusModalDcode <= 0)
        {
            ToastService.ShowWarning("Please select a doctor.");
            return;
        }

        isStatusModalSaving = true;
        try
        {
            var normStatus = NormalizeDoctorStatus(statusModalEditStatus);
            var model = new DoctorCurrentStatusModel
            {
                dcode = statusModalDcode,
                status = normStatus,
                remarks = statusModalRemarks,
                expected_return_time = statusModalExpectedReturnTime,
                tenant_code = TenantCode,
                updated_at = DateTime.Now
            };

            modalStatusMap[statusModalDcode] = model;

            var success = await StatusService.SetStatusAsync(model);
            if (success)
            {
                var docObj = doctors.FirstOrDefault(d => d.dcode == statusModalDcode);
                var docName = string.IsNullOrWhiteSpace(docObj?.name) ? docObj?.doctorfullname ?? "Doctor" : docObj.name;
                ToastService.ShowSuccess($"Status set to '{GetDoctorStatusLabel(normStatus)}' for {docName}");
                showDoctorStatusModal = false;
            }
            else
            {
                ToastService.ShowError("Failed to update status on server.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error updating status: {ex.Message}");
        }
        finally
        {
            isStatusModalSaving = false;
        }
    }

    private string NormalizeDoctorStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "OFF_DUTY";
        var s = status.Trim().ToUpperInvariant().Replace(" ", "_").Replace("-", "_");

        if (s.Contains("OPD")) return "IN_OPD";
        if (s.Contains("BREAK")) return "BREAK";
        if (s.Contains("BUSY") || s.Contains("SURGERY") || s.Contains("OT")) return "BUSY";
        if (s.Contains("LEAVE")) return "ON_LEAVE";
        if (s.Contains("DUTY") && !s.Contains("OFF")) return "ON_DUTY";
        if (s.Contains("OFF")) return "OFF_DUTY";

        return s;
    }

    private string GetDoctorSpecialtyName(int? spcode)
    {
        if (!spcode.HasValue) return "General";
        return doctorSpecialtiesMap.TryGetValue(spcode.Value, out var name) ? name : "General";
    }

    private string GetDoctorStatusLabel(string? status) => NormalizeDoctorStatus(status) switch
    {
        "IN_OPD" => "In OPD",
        "ON_DUTY" => "On Duty",
        "BREAK" => "On Break",
        "BUSY" => "Busy / Surgery",
        "ON_LEAVE" => "On Leave",
        "OFF_DUTY" => "Off Duty",
        _ => "Off Duty"
    };

    private string GetDoctorStatusCssClass(string? status) => NormalizeDoctorStatus(status) switch
    {
        "IN_OPD" => "badge-in-opd",
        "ON_DUTY" => "badge-on-duty",
        "BREAK" => "badge-break",
        "BUSY" => "badge-busy",
        "ON_LEAVE" => "badge-leave",
        "OFF_DUTY" => "badge-off-duty",
        _ => "badge-off-duty"
    };

    private string GetDoctorStatusIcon(string? status) => NormalizeDoctorStatus(status) switch
    {
        "IN_OPD" => "bi bi-door-open-fill",
        "ON_DUTY" => "bi bi-check-circle-fill",
        "BREAK" => "bi bi-cup-hot-fill",
        "BUSY" => "bi bi-heart-pulse-fill",
        "ON_LEAVE" => "bi bi-airplane-fill",
        "OFF_DUTY" => "bi bi-power",
        _ => "bi bi-power"
    };

    private string GetDocInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "DR";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }
