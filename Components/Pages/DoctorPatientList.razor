    <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 1050;" @onclick="CloseCancelModal"></div>
    <div class="glass-modal" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; border-radius: 14px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); z-index: 1060; width: 480px; max-width: 90%; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #e2e8f0; padding: 0;">
        <div class="modal-header" style="background: #004c7a; color: white; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0;">
            <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700;">Cancel Admission</h3>
            <button class="close-btn" @onclick="CloseCancelModal" style="background: transparent; border: none; color: white; font-size: 1.5rem; cursor: pointer; line-height: 1; padding: 0;">&times;</button>
        </div>
        <div class="modal-body" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            <div class="form-group" style="display: flex; flex-direction: column; gap: 0.35rem;">
                <label style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase;">Cancellation Reason *</label>
                <textarea class="filter-control" style="width: 100%; height: 100px; resize: none; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 0.8rem; box-sizing: border-box;" @bind="cancelRequest.reason" placeholder="Provide cancellation reason..."></textarea>
            </div>
        </div>
        <div class="modal-footer" style="background: #f8fafc; padding: 1rem 1.5rem; display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid #edf2f7;">
            <button class="btn-modal cancel" @onclick="CloseCancelModal" style="background: white; border: 1px solid #cbd5e1; color: #64748b; padding: 0.55rem 1.25rem; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer;">Close</button>
            <button class="btn-modal confirm" style="background-color: #ef4444; border: none; color: #ffffff; padding: 0.55rem 1.25rem; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer;" @onclick="ExecuteCancel">Cancel Admission</button>
        </div>
    </div>
}

@if (showVipModal)
{
    <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 1050;" @onclick="CloseVipModal"></div>
    <div class="vip-modal-container" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); z-index: 1060; width: 400px; max-width: 90%; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #e2e8f0;">
        <div style="background: #004c7a; color: white; padding: 1.2rem; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                Set VIP Status
            </h3>
            <button type="button" @onclick="CloseVipModal" style="background: transparent; border: none; color: white; font-size: 1.5rem; cursor: pointer; line-height: 1; padding: 0;">&times;</button>
