    private async Task LoadCustomersAsync()
    {
        try
        {
            using var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }

            var response = await client.GetAsync("api/Customer/partition?pagenumber=1&pagesize=1000");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                customersList = JsonConvert.DeserializeObject<List<SharedComponents.Rcl.Models.CustomerModel>>(json) ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
        }
    }

    private async Task LoadIpDataAsync()
    {
        loading = true;
        try
        {
            // Load IP dropdown lists
            floorsList = await FloorService.GetFloorMastersAsync();
            roomTypes = await RoomTypeService.GetRoomTypeMastersAsync();
            wardsList = await WardService.GetWardMastersAsync();
            bedsList = await BedService.GetBedMastersAsync();
            blocksList = await BlockService.GetBlockMastersAsync();

            // Load IP Admissions
            var active = await IpService.GetIpRegistrationsAsync("ADMITTED");
            var discharged = await IpService.GetIpRegistrationsAsync("DISCHARGED");
            var sortedDischarged = discharged.OrderByDescending(d => d.dischargedate).ToList();
            admissionsList = active.Concat(sortedDischarged).ToList();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading IP admissions: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyFilters()
    {
        currentPage = 1;
        filteredList = admissionsList;

        if (filterStatus != "ALL")
        {
            filteredList = filteredList.Where(a => a.ip_status == filterStatus).ToList();
        }

        if (filterDoctor > 0)
        {
            filteredList = filteredList.Where(a => a.dcode == filterDoctor).ToList();
        }

        if (filterFromDate.HasValue)
        {
            filteredList = filteredList.Where(a => 
                (a.ip_status == "DISCHARGED" && a.dischargedate.HasValue ? a.dischargedate.Value.Date : a.admitdate.Date) >= filterFromDate.Value.Date
            ).ToList();
        }

        if (filterToDate.HasValue)
        {
            filteredList = filteredList.Where(a => 
                (a.ip_status == "DISCHARGED" && a.dischargedate.HasValue ? a.dischargedate.Value.Date : a.admitdate.Date) <= filterToDate.Value.Date
            ).ToList();
        }

        if (!string.IsNullOrWhiteSpace(filterSearch))
        {
            filteredList = filteredList.Where(a => 
                (a.ip_no != null && a.ip_no.Contains(filterSearch, StringComparison.OrdinalIgnoreCase)) ||
                (a.patient_name != null && a.patient_name.Contains(filterSearch, StringComparison.OrdinalIgnoreCase)) ||
                (a.mobile != null && a.mobile.Contains(filterSearch, StringComparison.OrdinalIgnoreCase)) ||
                (customersList.FirstOrDefault(c => c.custid == a.custid)?.mobile?.Contains(filterSearch, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }
    }

