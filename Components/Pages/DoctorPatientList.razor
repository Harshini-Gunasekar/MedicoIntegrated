<!-- Doctor Status Update Popup Modal -->
@if (showDoctorStatusModal)
{
    <div class="doc-status-modal-backdrop" @onclick="CloseDoctorStatusModal"></div>
    <div class="doc-status-popup-modal" @onclick:stopPropagation>
        <div class="doc-status-popup-header">
            <div class="doc-status-popup-title">
                <i class="bi bi-pencil-square"></i>
                <span>Update Doctor Status</span>
            </div>
            <button type="button" class="doc-status-close-btn" @onclick="CloseDoctorStatusModal" title="Close">&times;</button>
        </div>

        <div class="doc-status-popup-body">
            <!-- Searchable Doctor Select Input -->
            <div class="doc-status-form-group">
                <label class="doc-status-label">SEARCH / SELECT DOCTOR <span class="text-danger">*</span></label>
                <div class="doc-status-search-wrapper">
                    <i class="bi bi-search doc-status-search-icon"></i>
                    <input type="text"
                           class="doc-status-search-input @(isStatusDocDropdownOpen ? "dropdown-open" : "")"
                           placeholder="Type doctor name or specialty..."
                           value="@statusDocSearchQuery"
                           @oninput="OnStatusDocSearchInput"
                           @onfocus="() => isStatusDocDropdownOpen = true"
                           @onblur="OnStatusDocSearchBlur" />

                    @if (statusModalDcode > 0 || !string.IsNullOrEmpty(statusDocSearchQuery))
                    {
                        <button type="button" class="doc-status-clear-btn" @onclick="ClearStatusModalDoctor" title="Clear selection">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                    else
                    {
                        <i class="bi bi-chevron-down doc-status-arrow-icon"></i>
                    }

                    @if (isStatusDocDropdownOpen)
                    {
                        <div class="doc-status-dropdown-list" @mousedown:preventDefault>
                            @{
                                var matchDocs = GetMatchingDoctorsForStatusModal();
                            }
                            @if (!matchDocs.Any())
                            {
                                <div class="doc-status-empty-dropdown">
                                    <i class="bi bi-person-x"></i> No doctor found matching "@statusDocSearchQuery"
                                </div>
                            }
                            else
                            {
                                @foreach (var doc in matchDocs)
                                {
                                    var stObj = modalStatusMap.GetValueOrDefault(doc.dcode);
                                    var stKey = NormalizeDoctorStatus(stObj?.status);
                                    var isSelected = doc.dcode == statusModalDcode;

                                    <div class="doc-status-dropdown-item @(isSelected ? "selected" : "")"
                                         @onclick="() => SelectDoctorForStatusModal(doc.dcode)">
                                        <div class="doc-status-item-avatar">
                                            @if (!string.IsNullOrEmpty(doc.doctorimage))
                                            {
                                                <img src="@doc.doctorimage" alt="@doc.name" />
                                            }
                                            else
                                            {
                                                <span>@GetDocInitials(doc.name ?? doc.doctorfullname)</span>
                                            }
                                        </div>
                                        <div class="doc-status-item-details">
                                            <div class="doc-status-item-name">@(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</div>
                                            <div class="doc-status-item-spec">@GetDoctorSpecialtyName(doc.spcode)</div>
                                        </div>
                                        <div class="doc-status-item-tag @GetDoctorStatusCssClass(stKey)">
                                            @GetDoctorStatusLabel(stKey)
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            @if (statusModalDcode > 0)
            {
                var activeDoc = doctors.FirstOrDefault(d => d.dcode == statusModalDcode);
                var currentStatusObj = modalStatusMap.GetValueOrDefault(statusModalDcode);
                var normalizedCurrent = NormalizeDoctorStatus(currentStatusObj?.status);

                <!-- Selected Doctor Card Preview -->
                <div class="doc-status-active-preview">
                    <div class="doc-status-doctor-avatar">
                        @if (!string.IsNullOrEmpty(activeDoc?.doctorimage))
                        {
                            <img src="@activeDoc.doctorimage" alt="@activeDoc.name" />
                        }
                        else
                        {
                            <span>@GetDocInitials(activeDoc?.name ?? activeDoc?.doctorfullname)</span>
                        }
                    </div>
                    <div class="doc-status-preview-info">
                        <h4>@(string.IsNullOrWhiteSpace(activeDoc?.name) ? activeDoc?.doctorfullname : activeDoc?.name)</h4>
                        <span class="doc-status-spec-title">@GetDoctorSpecialtyName(activeDoc?.spcode)</span>
                        <div class="doc-status-current-tag @GetDoctorStatusCssClass(normalizedCurrent)">
                            <i class="@GetDoctorStatusIcon(normalizedCurrent)"></i>
                            @GetDoctorStatusLabel(normalizedCurrent)
                        </div>
                    </div>
                </div>

                <!-- Status Selection Options Grid -->
                <div class="doc-status-form-group">
                    <label class="doc-status-label">SELECT AVAILABILITY STATUS</label>
                    <div class="doc-status-options-grid">
                        <button type="button" class="doc-status-option-btn @(statusModalEditStatus == "IN_OPD" ? "active in-opd" : "")"
                                @onclick='() => statusModalEditStatus = "IN_OPD"'>
                            <i class="bi bi-door-open-fill"></i>
                            <span>In OPD</span>
                        </button>

                        <button type="button" class="doc-status-option-btn @(statusModalEditStatus == "ON_DUTY" ? "active on-duty" : "")"
                                @onclick='() => statusModalEditStatus = "ON_DUTY"'>
                            <i class="bi bi-check-circle-fill"></i>
                            <span>On Duty</span>
                        </button>

                        <button type="button" class="doc-status-option-btn @(statusModalEditStatus == "BREAK" ? "active break" : "")"
                                @onclick='() => statusModalEditStatus = "BREAK"'>
                            <i class="bi bi-cup-hot-fill"></i>
                            <span>On Break</span>
                        </button>

                        <button type="button" class="doc-status-option-btn @(statusModalEditStatus == "BUSY" ? "active busy" : "")"
                                @onclick='() => statusModalEditStatus = "BUSY"'>
                            <i class="bi bi-heart-pulse-fill"></i>
                            <span>Busy / Surgery</span>
                        </button>

                        <button type="button" class="doc-status-option-btn @(statusModalEditStatus == "ON_LEAVE" ? "active leave" : "")"
                                @onclick='() => statusModalEditStatus = "ON_LEAVE"'>
                            <i class="bi bi-airplane-fill"></i>
                            <span>On Leave</span>
                        </button>

                        <button type="button" class="doc-status-option-btn @(statusModalEditStatus == "OFF_DUTY" ? "active off-duty" : "")"
                                @onclick='() => statusModalEditStatus = "OFF_DUTY"'>
                            <i class="bi bi-power"></i>
                            <span>Off Duty</span>
                        </button>
                    </div>
                </div>

                <!-- Expected Return Time -->
                <div class="doc-status-form-group">
                    <label class="doc-status-label">EXPECTED RETURN TIME (OPTIONAL)</label>
                    <div class="doc-status-chips">
                        <button type="button" class="doc-status-chip-btn" @onclick='() => AddModalReturnMinutes(15)'>+15m</button>
                        <button type="button" class="doc-status-chip-btn" @onclick='() => AddModalReturnMinutes(30)'>+30m</button>
                        <button type="button" class="doc-status-chip-btn" @onclick='() => AddModalReturnMinutes(60)'>+1 hour</button>
                        <button type="button" class="doc-status-chip-btn" @onclick='() => AddModalReturnMinutes(120)'>+2 hours</button>
                        <button type="button" class="doc-status-chip-btn clear" @onclick='() => statusModalExpectedReturnTime = null'>Clear</button>
                    </div>
                    <input type="datetime-local" class="doc-status-input" @bind="statusModalExpectedReturnTime" />
                </div>

                <!-- Remarks / Location Notes -->
                <div class="doc-status-form-group">
                    <label class="doc-status-label">REMARKS / LOCATION NOTE</label>
                    <input type="text" class="doc-status-input" placeholder="e.g. Available in OPD Room 3, Emergency OT..."
                           @bind="statusModalRemarks" />
                </div>
            }
            else
            {
                <div class="doc-status-empty-placeholder">
                    <i class="bi bi-search"></i>
                    <p>Search and select a doctor to view and update status details.</p>
                </div>
            }
        </div>

        <div class="doc-status-popup-footer">
            <button type="button" class="doc-status-btn-cancel" @onclick="CloseDoctorStatusModal">Cancel</button>
            @if (statusModalDcode > 0)
            {
                <button type="button" class="doc-status-btn-save" @onclick="SaveDoctorStatusFromModal" disabled="@isStatusModalSaving">
                    @if (isStatusModalSaving)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-send-check-fill"></i>
                        <span>Save & Publish Status</span>
                    }
                </button>
            }
        </div>
    </div>
}

