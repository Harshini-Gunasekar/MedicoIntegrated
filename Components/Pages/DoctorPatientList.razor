            <button type="button" @onclick="SaveVipStatus" disabled="@isVipSaving" style="background: #d97706; border: none; color: white; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 6px;">
