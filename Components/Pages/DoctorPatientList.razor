        if (admitRequest.custid <= 0)
        {
            ToastService.ShowError("Please select a patient.");
            return;
        }
        if (admitRequest.dcode <= 0)
        {
            ToastService.ShowError("Please select a doctor.");
            return;
        }
        if (admitRequest.bedcode <= 0)
        {
            ToastService.ShowError("Please allocate a bed.");
            return;
        }

        try
        {
            bool success = await IpService.AdmitPatientAsync(admitRequest);
            if (success)
            {
                ToastService.ShowSuccess("Patient admitted successfully!");
                showAdmitModal = false;
                await LoadIpDataAsync();
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Failed to admit patient.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error admitting patient: {ex.Message}");
        }
    }

