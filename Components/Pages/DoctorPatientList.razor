@page "/booking/doctor"
@using Booking.Models
@using Booking.Services
@using System.Net.Http.Json
@inject AppointmentBookingService BookingService
@inject DoctorService DoctorService
@inject ToastService ToastService
@inject CaseSheetService CaseSheetService
@inject IHttpClientFactory ClientFactory
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<PageTitle>Doctor Patient List</PageTitle>

<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
</div>

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <div class="dashboard-title">
            <h1>Doctor's Patient List</h1>
            <p>View your scheduled patients, tokens, and appointment statuses for selected date.</p>
        </div>
        <div>
            <button class="btn-header-action" @onclick="LoadTodayBookingsAsync" disabled="@loading">
                @if (loading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                }
                <i class="bi bi-arrow-clockwise"></i> Refresh Queue
            </button>
        </div>
    </div>

    @if (loading && todayBookings.Count == 0)
    {
        <div class="loading-state">
            <div class="spinner-border" role="status"></div>
            <p>Loading patient list...</p>
        </div>
    }
    else
    {
        <!-- Stats Row -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="bi bi-calendar3"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@GetFilteredBookings().Count</span>
                    <span class="stat-label">Total Scheduled</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@GetFilteredBookings().Count(b => b.booking_status?.ToUpper() == "BOOKED")</span>
                    <span class="stat-label">Pending</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green">
                    <i class="bi bi-check2-all"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@GetFilteredBookings().Count(b => b.booking_status?.ToUpper() == "CONFIRMED" || b.booking_status?.ToUpper() == "COMPLETED" || b.booking_status?.ToUpper() == "VISITED")</span>
                    <span class="stat-label">Confirmed/Served</span>
                </div>
            </div>
        </div>

        <!-- Toolbar Filters -->
        <div class="filter-card">
            <div class="filter-flex">
                <div class="filter-group filter-date-col">
                    <label class="filter-label">FILTER DATE</label>
                    <input type="date" class="form-control filter-input" @bind="selectedDate" @bind:after="OnDateChanged" />
                </div>

                <div class="filter-group">
                    <label class="filter-label">DOCTOR SPECIALIST</label>
                    <select class="form-select filter-select" @bind="selectedDoctorDcode" @bind:after="OnDoctorChanged">
                        <option value="">All Specialists</option>
                        @foreach (var doc in doctors)
                        {
                            <option value="@doc.dcode">@(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</option>
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">STATUS</label>
                    <select class="form-select filter-select" @bind="statusFilter">
                        <option value="ALL">All Statuses</option>
                        <option value="BOOKED">Booked</option>
                        <option value="CONFIRMED">Confirmed</option>
                        <option value="COMPLETED">Completed</option>
                        <option value="CANCELLED">Cancelled</option>
                    </select>
                </div>

                
                
                <div class="filter-group filter-search-col">
                    <label class="filter-label">SEARCH PATIENT / DOCTOR</label>
                    <input type="text" class="form-control filter-input" placeholder="e.g. CUST-1001, 2026..." @bind="searchQuery" @bind:event="oninput" />
                </div>

                <div class="filter-action-group">
                    <button class="btn-reset" @onclick="ResetFilters">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </button>
                </div>
            </div>
        </div>

        <!-- Patients List/Table Card -->
        <div class="table-card">
            @if (GetFilteredBookings().Any())
            {
                <div class="table-responsive">
                    <table class="medico-table">
                        <thead>
                            <tr>
                                <th style="width: 100px;">Token</th>
                                <th style="width: 220px;">Patient Name</th>
                                <th style="width: 140px;">Patient ID</th>
                                <th style="width: 200px;">Time Range</th>
                                <!-- <th>Booking Ref</th> -->
                                <th>Notes</th>
                                <th style="width: 150px;">Status</th>
                                <th style="width: 120px; text-align: center;">VIP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in GetFilteredBookings())
                            {
                                <tr>
                                    <td>
                                        <div class="badge-op-container">
                                            <span class="badge-op">@b.token_no</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="patient-name-container" style="cursor: pointer;" @onclick="() => OpenCaseSheetForBooking(b)" title="Open Clinical Case Sheet">
                                            <i class="bi bi-person-fill patient-icon text-primary"></i>
                                            <span class="patient-name text-primary text-decoration-underline-hover">@(string.IsNullOrWhiteSpace(b.patient_name) ? "Walk-in Patient" : b.patient_name)</span>
                                            @if (b.isvip == true)
                                            {
                                                <span style="font-size: 0.65rem; background: #fffbeb; color: #d97706; padding: 2px 6px; border-radius: 4px; font-weight: 700; border: 1px solid #fde68a; margin-left: 0.5rem;" title="@b.viprole">👑 VIP</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="patient-id-badge">ID: @b.custid</span>
                                    </td>
                                    <td>
                                        <span class="time-badge">
                                            <i class="bi bi-clock"></i>
                                            @FormatTime(b.slot_start_time) - @FormatTime(b.slot_end_time)
                                        </span>
                                    </td>
                                    <!-- <td>
                                        <div class="booking-ref-block">
                                            <span class="booking-no">@(string.IsNullOrWhiteSpace(b.booking_no) ? "N/A" : b.booking_no)</span>
                                            <span class="booking-type-label @b.booking_type?.ToLower()">@b.booking_type</span>
                                        </div>
                                    </td> -->
                                    <td>
                                        <span class="notes-text" title="@b.notes">
                                            @(string.IsNullOrWhiteSpace(b.notes) ? "-" : b.notes)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="status-pill @b.booking_status?.ToLower()">
                                            @b.booking_status
                                        </span>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle; padding: 0.75rem 1.2rem;">
                                        <div style="display: flex; gap: 0.5rem; justify-content: center; align-items: center;">
                                            @if (b.isvip == true)
                                            {
                                                <button type="button" title="Edit VIP: @b.viprole" @onclick="() => OpenVipModal(b)" style="background: #fffbeb; border: 1px solid #fde68a; color: #d97706; padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 4px; transition: all 0.2s;">
                                                    👑 VIP
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" title="Mark as VIP" @onclick="() => OpenVipModal(b)" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #64748b; padding: 4px 10px; border-radius: 6px; font-weight: 600; font-size: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 4px; transition: all 0.2s;">
                                                    ☆ Mark VIP
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-people-fill empty-icon"></i>
                    <h3>No Patients Found</h3>
                    <p>No patient bookings match the selected criteria for this date.</p>
                </div>
            }
        </div>
    }
</div>

<!-- Case Sheet Workspace Modal -->
<CaseSheetComponent @bind-Visible="showCaseSheetModal"
                    OpId="selectedOpId"
                    OpNo="@selectedOpNo"
                    CustId="selectedCustId"
                    Dcode="selectedDcode"
                    PatientName="@selectedPatientName"
                    VisitDate="selectedVisitDate"
                    OpStatus="@selectedOpStatus"
                    OnSaved="LoadTodayBookingsAsync" />

@if (showVipModal)
{
    <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 1050;" @onclick="CloseVipModal"></div>
    <div class="vip-modal-container" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); z-index: 1060; width: 400px; max-width: 90%; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #e2e8f0;">
        <div style="background: #004c7a; color: white; padding: 1.2rem; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                👑 Set VIP Status
            </h3>
            <button type="button" @onclick="CloseVipModal" style="background: transparent; border: none; color: white; font-size: 1.5rem; cursor: pointer; line-height: 1; padding: 0;">&times;</button>
        </div>
        <div style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            <div style="font-size: 0.9rem; color: #334155; font-weight: 500;">
                Patient Name: <strong style="color: #0f172a;">@vipPatientName</strong> (ID: @vipCustId)
            </div>
            
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                <label style="font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase;">VIP Role / Description</label>
                <input type="text" class="form-control" @bind="vipRoleText" placeholder="e.g. govt job, friend of MD" style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.6rem 0.8rem; font-size: 0.9rem; width: 100%; box-sizing: border-box;" />
            </div>
        </div>
        <div style="background: #f8fafc; padding: 1rem 1.5rem; display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid #edf2f7;">
            <button type="button" @onclick="CloseVipModal" style="background: white; border: 1px solid #cbd5e1; color: #64748b; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; font-size: 0.85rem; cursor: pointer;">Cancel</button>
            <button type="button" @onclick="SaveVipStatus" disabled="@isVipSaving" style="background: #d97706; border: none; color: white; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                @if (isVipSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin: 0;"></span>
                }
                Save VIP Status
            </button>
        </div>
    </div>
}

@code {
    private string TenantCode = "";
    private string AuthToken = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";
                
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error loading session in DoctorPatientList: {ex.Message}");
            }
        }
    }

    private List<DoctorMasterModel> doctors = new();
    private List<DoctorBookingListModel> todayBookings = new();
    private int? selectedDoctorDcode = null; // Defaulting to all specialists
    private DateTime selectedDate = DateTime.Today; // Defaulting to current date
    private string searchQuery = string.Empty;
    private string statusFilter = "ALL";
    private string bookingTypeFilter = "ALL";
    private bool loading = false;

    // Case Sheet modal state fields
    private bool showCaseSheetModal = false;
    private Guid selectedOpId = Guid.Empty;
    private string selectedOpNo = string.Empty;
    private decimal selectedCustId = 0;
    private int selectedDcode = 0;
    private string selectedPatientName = string.Empty;
    private DateTime? selectedVisitDate = null;
    private string selectedOpStatus = "WAITING";

    // VIP modal fields
    private bool showVipModal = false;
    private decimal vipCustId = 0;
    private string vipRoleText = string.Empty;
    private string vipPatientName = string.Empty;
    private bool isVipSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctorsAsync();
        await LoadTodayBookingsAsync();
    }

    private async Task OpenCaseSheetForBooking(DoctorBookingListModel booking)
    {
        try
        {
            var regs = await BookingService.GetAllOpRegistrationsAsync();
            var match = regs.FirstOrDefault(r => r.booking_id == booking.booking_id || (r.custid == booking.custid && r.visit_date == DateOnly.FromDateTime(selectedDate)));

            if (match == null)
            {
                // Fallback search by custid and date
                match = regs.FirstOrDefault(r => r.custid == booking.custid && r.visit_date == booking.appointment_date);
            }

            if (match == null)
            {
                ToastService.ShowError($"Patient '{booking.patient_name ?? "Walk-in"}' is not registered as an Outpatient for this visit. Please register the patient at reception first.");
                return;
            }

            selectedOpId = match.op_id;
            selectedOpNo = match.op_no;
            selectedCustId = match.custid;
            selectedDcode = match.dcode;
            selectedPatientName = booking.patient_name ?? "Walk-in Patient";
            selectedVisitDate = selectedDate;
            selectedOpStatus = match.visit_status;

            showCaseSheetModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to open Case Sheet: {ex.Message}");
        }
    }

    private async Task LoadDoctorsAsync()
    {
        try
        {
            doctors = await DoctorService.GetDoctorsAsync();
            if (selectedDoctorDcode.HasValue && !doctors.Any(d => d.dcode == selectedDoctorDcode.Value))
            {
                // Fallback to first doctor if 18 doesn't exist
                if (doctors.Any())
                {
                    selectedDoctorDcode = doctors.First().dcode;
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load doctors: {ex.Message}");
        }
    }

    private async Task OnDoctorChanged()
    {
        await LoadTodayBookingsAsync();
    }

    private async Task OnDateChanged()
    {
        await LoadTodayBookingsAsync();
    }

    private async Task ResetFilters()
    {
        selectedDoctorDcode = null;
        selectedDate = DateTime.Today;
        statusFilter = "ALL";
        bookingTypeFilter = "ALL";
        searchQuery = string.Empty;
        await LoadTodayBookingsAsync();
    }

    private async Task LoadTodayBookingsAsync()
    {
        loading = true;
        try
        {
            var dateOnly = DateOnly.FromDateTime(selectedDate);
            var generalBookingsTask = BookingService.GetBookingsByDateAsync(dateOnly);

            if (selectedDoctorDcode.HasValue && selectedDoctorDcode.Value != 0)
            {
                var bookingsTask = BookingService.GetDoctorBookingsAsync(selectedDoctorDcode.Value, dateOnly);
                await Task.WhenAll(bookingsTask, generalBookingsTask);
                todayBookings = bookingsTask.Result ?? new();
            }
            else
            {
                var bookingsTasks = doctors
                    .Select(doc => BookingService.GetDoctorBookingsAsync(doc.dcode, dateOnly))
                    .ToList();

                await Task.WhenAll(bookingsTasks.Cast<Task>().Append(generalBookingsTask));

                todayBookings = bookingsTasks
                    .SelectMany(t => t.Result ?? new List<DoctorBookingListModel>())
                    .ToList();
            }

            var generalBookings = generalBookingsTask.Result ?? new();

            if (todayBookings.Any() && generalBookings.Any())
            {
                var generalBookingsDict = generalBookings
                    .Where(gb => gb.booking_id != Guid.Empty)
                    .GroupBy(gb => gb.booking_id)
                    .ToDictionary(g => g.Key, g => g.First());

                foreach (var b in todayBookings)
                {
                    if (generalBookingsDict.TryGetValue(b.booking_id, out var matchingBooking))
                    {
                        b.slot_start_time = matchingBooking.slot_start_time;
                        b.slot_end_time = matchingBooking.slot_end_time;
                        b.booking_type = matchingBooking.booking_type;
                    }
                }
            }

            // Sort by start time then token number
            todayBookings = todayBookings.OrderBy(b => b.slot_start_time).ThenBy(b => b.token_no).ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to fetch doctor bookings: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private List<DoctorBookingListModel> GetFilteredBookings()
    {
        var result = todayBookings;

        // Apply Search
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            result = result.Where(b => 
                (b.patient_name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (b.booking_no?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                b.custid.ToString().Contains(searchQuery)
            ).ToList();
        }

        // Apply Status Filter
        if (statusFilter != "ALL")
        {
            result = result.Where(b => b.booking_status?.Equals(statusFilter, StringComparison.OrdinalIgnoreCase) ?? false).ToList();
        }

        // Apply Booking Type Filter
        if (bookingTypeFilter != "ALL")
        {
            result = result.Where(b => b.booking_type?.Equals(bookingTypeFilter, StringComparison.OrdinalIgnoreCase) ?? false).ToList();
        }

        return result;
    }

    private string FormatTime(TimeOnly time)
    {
        return time.ToString("hh:mm tt");
    }

    private void OpenVipModal(DoctorBookingListModel booking)
    {
        vipCustId = booking.custid;
        vipPatientName = booking.patient_name ?? "Walk-in Patient";
        vipRoleText = booking.viprole ?? string.Empty;
        showVipModal = true;
        StateHasChanged();
    }

    private void CloseVipModal()
    {
        showVipModal = false;
        vipRoleText = string.Empty;
    }

    private async Task SaveVipStatus()
    {
        if (string.IsNullOrWhiteSpace(vipRoleText))
        {
            ToastService.ShowError("Please enter a VIP Role (e.g. 'govt job').");
            return;
        }

        isVipSaving = true;
        try
        {
            using var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }

            var payload = new 
            { 
                custid = (long)vipCustId, 
                viprole = vipRoleText 
            };
            
            var response = await client.PostAsJsonAsync("api/Customer/mark-as-vip", payload);
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess($"Successfully marked {vipPatientName} as VIP.");
                showVipModal = false;
                await LoadTodayBookingsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to save VIP status: {error}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving VIP status: {ex.Message}");
        }
        finally
        {
            isVipSaving = false;
        }
    }
}
