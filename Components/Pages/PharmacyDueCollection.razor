    // --- PATIENT AUTOCOMPLETE SEARCH ---
    private async Task OnPatientSearchInput(ChangeEventArgs e)
    {
        patientSearchQuery = e.Value?.ToString() ?? "";
        activePatientIndex = -1;

        _patientSearchCts?.Cancel();
        _patientSearchCts = new System.Threading.CancellationTokenSource();
        var token = _patientSearchCts.Token;

        if (string.IsNullOrWhiteSpace(patientSearchQuery))
        {
            searchedPatients.Clear();
            showPatientDropdown = false;
            return;
        }

        try
        {
            await Task.Delay(250, token);
            isSearchingPatients = true;
            await InvokeAsync(StateHasChanged);

            string effectiveTenant = TenantState?.TenantCode ?? "";
            string effectiveToken = TenantState?.AuthToken ?? "";

            if (string.IsNullOrEmpty(effectiveTenant))
            {
                try
                {
                    var tRes = await _sessionStorage.GetAsync<string>("tenant_code");
                    if (tRes.Success && !string.IsNullOrEmpty(tRes.Value)) effectiveTenant = tRes.Value;
                }
                catch { }
            }

            if (string.IsNullOrEmpty(effectiveToken))
            {
                try
                {
                    var tokRes = await _sessionStorage.GetAsync<string>("authToken");
                    if (tokRes.Success && !string.IsNullOrEmpty(tokRes.Value)) effectiveToken = tokRes.Value;
                }
                catch { }
            }

            var resultsList = new List<Booking.Models.CustomerWithOpModel>();
            var settings = new Newtonsoft.Json.JsonSerializerSettings { NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore };

            // 1. Query LabCareUrl: api/Customer/search?key={query}
            try
            {
                var labClient = ClientFactory.CreateClient("LabCareUrl");
                if (!string.IsNullOrEmpty(effectiveTenant))
                {
                    labClient.DefaultRequestHeaders.Remove("tenant_code");
                    labClient.DefaultRequestHeaders.Remove("tenantcode");
                    labClient.DefaultRequestHeaders.Remove("tenant-code");
                    labClient.DefaultRequestHeaders.Add("tenant_code", effectiveTenant);
                    labClient.DefaultRequestHeaders.Add("tenantcode", effectiveTenant);
                    labClient.DefaultRequestHeaders.Add("tenant-code", effectiveTenant);
                }
                if (!string.IsNullOrEmpty(effectiveToken))
                {
                    labClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
                }

                var response = await labClient.GetAsync($"api/Customer/search?key={Uri.EscapeDataString(patientSearchQuery)}", token);
                if (response.IsSuccessStatusCode)
                {
                    var rawJson = await response.Content.ReadAsStringAsync(token);
                    var jToken = Newtonsoft.Json.Linq.JToken.Parse(rawJson);
                    List<Booking.Models.CustomerWithOpModel>? list = null;
                    if (jToken is Newtonsoft.Json.Linq.JObject obj && obj["value"] != null)
                    {
                        list = obj["value"].ToObject<List<Booking.Models.CustomerWithOpModel>>(Newtonsoft.Json.JsonSerializer.Create(settings));
                    }
                    else
                    {
                        list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.CustomerWithOpModel>>(rawJson, settings);
                    }
                    if (list != null && list.Count > 0)
                    {
                        resultsList.AddRange(list);
                    }
                }
            }
            catch (OperationCanceledException) { throw; }
            catch (Exception ex)
            {
                Console.WriteLine($"[PharmacyDueCollection] LabCare customer search error: {ex.Message}");
            }

            // 2. Query DoctorApi: api/OpRegistration/customers-with-op?key={query}
            try
            {
                var docClient = ClientFactory.CreateClient("DoctorApi");
                if (!string.IsNullOrEmpty(effectiveTenant))
                {
                    docClient.DefaultRequestHeaders.Remove("tenant_code");
                    docClient.DefaultRequestHeaders.Remove("tenantcode");
                    docClient.DefaultRequestHeaders.Remove("tenant-code");
                    docClient.DefaultRequestHeaders.Add("tenant_code", effectiveTenant);
                    docClient.DefaultRequestHeaders.Add("tenantcode", effectiveTenant);
                    docClient.DefaultRequestHeaders.Add("tenant-code", effectiveTenant);
                }
                if (!string.IsNullOrEmpty(effectiveToken))
                {
                    docClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
                }

                var docResp = await docClient.GetAsync($"api/OpRegistration/customers-with-op?key={Uri.EscapeDataString(patientSearchQuery)}", token);
                if (docResp.IsSuccessStatusCode)
                {
                    var rawJson = await docResp.Content.ReadAsStringAsync(token);
                    var jToken = Newtonsoft.Json.Linq.JToken.Parse(rawJson);
                    List<Booking.Models.CustomerWithOpModel>? list = null;
                    if (jToken is Newtonsoft.Json.Linq.JObject obj && obj["value"] != null)
                    {
                        list = obj["value"].ToObject<List<Booking.Models.CustomerWithOpModel>>(Newtonsoft.Json.JsonSerializer.Create(settings));
                    }
                    else
                    {
                        list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.CustomerWithOpModel>>(rawJson, settings);
                    }
                    if (list != null && list.Count > 0)
                    {
                        foreach (var item in list)
                        {
                            if (!resultsList.Any(r => r.custid == item.custid))
                            {
                                resultsList.Add(item);
                            }
                        }
                    }
                }
            }
            catch (OperationCanceledException) { throw; }
            catch (Exception ex)
            {
                Console.WriteLine($"[PharmacyDueCollection] DoctorApi customers-with-op error: {ex.Message}");
            }

            if (token.IsCancellationRequested) return;

            // Client-side filtering & matching to ensure all typed fields match
            var lowerQuery = patientSearchQuery.Trim().ToLowerInvariant();
            var filtered = resultsList.Where(p =>
                (!string.IsNullOrEmpty(p.name) && p.name.ToLowerInvariant().Contains(lowerQuery)) ||
                (!string.IsNullOrEmpty(p.namewithinitials) && p.namewithinitials.ToLowerInvariant().Contains(lowerQuery)) ||
                (!string.IsNullOrEmpty(p.mobile) && p.mobile.Contains(lowerQuery)) ||
                (!string.IsNullOrEmpty(p.phone) && p.phone.Contains(lowerQuery)) ||
                (!string.IsNullOrEmpty(p.op_no) && p.op_no.ToLowerInvariant().Contains(lowerQuery)) ||
                p.custid.ToString().Contains(lowerQuery) ||
                (!string.IsNullOrEmpty(p.custcode) && p.custcode.ToLowerInvariant().Contains(lowerQuery))
            ).ToList();

            var finalMatches = filtered.Any() ? filtered : resultsList;

            // Deduplicate by custid/custcode and display up to 100 matching patients
            searchedPatients = finalMatches
                .GroupBy(p => p.custid > 0 ? p.custid.ToString() : (p.custcode ?? Guid.NewGuid().ToString()))
                .Select(g => g.First())
                .Take(100)
                .ToList();

            showPatientDropdown = true;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"[PharmacyDueCollection] Patient search error: {ex.Message}");
            searchedPatients.Clear();
            showPatientDropdown = false;
        }
        finally
        {
            isSearchingPatients = false;
            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void OnPatientSearchKeyDown(KeyboardEventArgs e)
    {
        if (!showPatientDropdown || searchedPatients.Count == 0) return;

        if (e.Key == "ArrowDown")
        {
            activePatientIndex = (activePatientIndex < searchedPatients.Count - 1) ? activePatientIndex + 1 : 0;
        }
        else if (e.Key == "ArrowUp")
        {
            activePatientIndex = (activePatientIndex > 0) ? activePatientIndex - 1 : searchedPatients.Count - 1;
        }
        else if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            if (activePatientIndex >= 0 && activePatientIndex < searchedPatients.Count)
            {
                _ = SelectCustomerPatient(searchedPatients[activePatientIndex]);
            }
        }
        else if (e.Key == "Escape")
        {
            showPatientDropdown = false;
        }
    }

    private async Task SelectCustomerPatient(Booking.Models.CustomerWithOpModel pat)
    {
        selectedPatient = pat;
        showPatientDropdown = false;
        activePatientIndex = -1;

        // Use exact custid or custcode so ItemMaster/getpendingdues matches DB
        patientIdFilter = pat.custid > 0 ? pat.custid.ToString() : (pat.custcode ?? "");
        mobileNoFilter = !string.IsNullOrWhiteSpace(pat.mobile) ? pat.mobile : (pat.phone ?? "");

        var displayName = !string.IsNullOrWhiteSpace(pat.namewithinitials)
            ? pat.namewithinitials
            : (!string.IsNullOrWhiteSpace(pat.name) ? pat.name : $"Patient {pat.custid}");

        patientSearchQuery = $"{displayName} (CUST-{pat.custid})";

        await SearchPendingDues();
    }

    // --- SEARCH PENDING DUES (Endpoint 1) ---
    private async Task SearchPendingDues()
    {
        if (string.IsNullOrWhiteSpace(patientIdFilter) && string.IsNullOrWhiteSpace(mobileNoFilter))
        {
            ToastService.ShowError("Please enter a Patient ID or Mobile Number to search dues.");
            return;
        }

        loadingBills = true;
        selectedBills.Clear();
        collectedAmounts.Clear();
        billRemarks.Clear();
        totalAmountToAllocate = null;
        StateHasChanged();

        try
        {
            var (success, message, bills) = await DueService.GetPendingDuesAsync(patientIdFilter, mobileNoFilter);
            if (success)
            {
                pendingBills = bills ?? new();

                // Pre-populate remarks dictionary safely for all pending bills to prevent KeyNotFoundException
                foreach (var b in pendingBills)
                {
                    billRemarks[b.salescode] = "Part payment";
                }

                // If selectedPatient is not set yet, construct it from returned bill details so patient is always viewed
                if (selectedPatient == null && pendingBills.Any())
                {
                    var firstBill = pendingBills.First();
                    selectedPatient = new Booking.Models.CustomerWithOpModel
                    {
                        name = firstBill.patientname,
                        namewithinitials = firstBill.patientname,
                        custid = long.TryParse(firstBill.patientid, out var cid) ? cid : 0,
                        custcode = firstBill.patientid,
                        mobile = firstBill.mobileno
                    };
                    if (string.IsNullOrWhiteSpace(patientSearchQuery))
                    {
                        patientSearchQuery = $"{firstBill.patientname} ({firstBill.patientid})";
                    }
                }

                if (pendingBills.Count == 0)
                {
                    ToastService.ShowInfo("No pending due bills found for this patient.");
                }
                else
                {
                    ToastService.ShowSuccess($"Found {pendingBills.Count} pending due bill(s).");
                }
            }
            else
            {
                pendingBills.Clear();
                ToastService.ShowError(message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error retrieving pending dues: {ex.Message}");
        }
        finally
        {
            loadingBills = false;
            StateHasChanged();
        }
    }

