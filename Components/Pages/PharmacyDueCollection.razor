    // --- SELECTION & AUTO ALLOCATE ---
    private bool IsAllSelected()
    {
        return FilteredPendingBills.Count > 0 && FilteredPendingBills.All(b => selectedBills.ContainsKey(b.salescode));
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked)
        {
            foreach (var b in FilteredPendingBills)
            {
                selectedBills[b.salescode] = b;
                if (!collectedAmounts.ContainsKey(b.salescode) || collectedAmounts[b.salescode] <= 0)
                {
                    collectedAmounts[b.salescode] = b.remainingamount;
                }
                if (!billRemarks.ContainsKey(b.salescode))
                {
                    billRemarks[b.salescode] = "Part payment";
                }
            }
        }
        else
        {
            selectedBills.Clear();
            collectedAmounts.Clear();
            billRemarks.Clear();
        }
        StateHasChanged();
    }

    private void ToggleSelectBill(PharmacyPendingDueBill bill)
    {
        if (selectedBills.ContainsKey(bill.salescode))
        {
            selectedBills.Remove(bill.salescode);
            collectedAmounts.Remove(bill.salescode);
            billRemarks.Remove(bill.salescode);
        }
        else
        {
            selectedBills[bill.salescode] = bill;
            collectedAmounts[bill.salescode] = bill.remainingamount;
            if (!billRemarks.ContainsKey(bill.salescode))
            {
                billRemarks[bill.salescode] = "Part payment";
            }
        }
        StateHasChanged();
    }

    private void EnsureBillSelected(PharmacyPendingDueBill bill)
    {
        if (!selectedBills.ContainsKey(bill.salescode))
        {
            selectedBills[bill.salescode] = bill;
            if (!collectedAmounts.ContainsKey(bill.salescode))
            {
                collectedAmounts[bill.salescode] = bill.remainingamount;
            }
            if (!billRemarks.ContainsKey(bill.salescode))
            {
                billRemarks[bill.salescode] = "Part payment";
            }
            StateHasChanged();
        }
    }

    private void OnCollectedAmountInput(PharmacyPendingDueBill bill, ChangeEventArgs e)
    {
        EnsureBillSelected(bill);
        var str = e.Value?.ToString() ?? "0";
        if (decimal.TryParse(str, out var val))
        {
            if (val > bill.remainingamount)
            {
                val = bill.remainingamount;
                ToastService.ShowWarning($"Collected amount cannot exceed balance of ₹ {bill.remainingamount:N2}");
            }
            else if (val < 0)
            {
                val = 0;
            }
            collectedAmounts[bill.salescode] = val;
        }
        else
        {
            collectedAmounts[bill.salescode] = 0;
        }
        StateHasChanged();
    }

    /// <summary>
    /// Greedily distributes the entered amount across all visible pending bills.
    /// Exactly mirrors the Auto select behavior of Due Collection in Billing Portal!
    /// </summary>
    private void AutoAllocateAmount()
    {
        if (totalAmountToAllocate == null || totalAmountToAllocate <= 0)
        {
            ToastService.ShowError("Please enter an amount greater than zero before using Auto Select.");
            return;
        }

        if (pendingBills.Count == 0)
        {
            ToastService.ShowError("No pending bills loaded.");
            return;
        }

        selectedBills.Clear();
        collectedAmounts.Clear();
        billRemarks.Clear();

        decimal remainingCash = totalAmountToAllocate.Value;

        foreach (var bill in pendingBills)
        {
            if (remainingCash <= 0) break;

            decimal due = bill.remainingamount;
            if (due <= 0) continue;

            decimal allocate = Math.Min(remainingCash, due);
            remainingCash -= allocate;

            selectedBills[bill.salescode] = bill;
            collectedAmounts[bill.salescode] = allocate;
            billRemarks[bill.salescode] = allocate == due ? "Full payment" : "Part payment";
        }

        ToastService.ShowSuccess($"Allocated ₹ {totalAmountToAllocate:N2} across {selectedBills.Count} bill(s).");
        StateHasChanged();
    }

    // --- SAVE DUE COLLECTION (Endpoint 2) ---
    private async Task SaveDueCollection()
    {
        if (selectedBills.Count == 0)
        {
            ToastService.ShowError("Please select at least one bill to collect due.");
            return;
        }

        var billsToSave = selectedBills.Values.Where(b => collectedAmounts.GetValueOrDefault(b.salescode, 0) > 0).ToList();
        if (billsToSave.Count == 0)
        {
            ToastService.ShowError("Collected amount must be greater than zero for selected bills.");
            return;
        }

        // Validate collected amounts do not exceed balances
        foreach (var bill in billsToSave)
        {
            var amt = collectedAmounts.GetValueOrDefault(bill.salescode, 0);
            if (amt > bill.remainingamount)
            {
                ToastService.ShowError($"Collected amount ({amt:N2}) is more than the balance ({bill.remainingamount:N2}) for bill {bill.billno}.");
                return;
            }
        }

        if (string.IsNullOrWhiteSpace(payMode))
        {
            ToastService.ShowError("Please select a payment mode.");
            return;
        }

        saving = true;
        StateHasChanged();

        try
        {
            var firstBill = billsToSave.First();
            int? parsedUserCode = TenantState.UserCode > 0 ? TenantState.UserCode : 5;
            int? parsedBranchCode = int.TryParse(selectedBranch, out var bh) ? bh : 1;
            int? parsedCounterCode = int.TryParse(selectedCounter, out var cnt) ? cnt : (TenantState.CounterCode.HasValue ? TenantState.CounterCode.Value : 2);

            var req = new PharmacyDueCollectionInsertRequest
            {
                master = new PharmacyDueCollectionMasterRequest
                {
                    requestdate = requestDate.Date.Add(DateTime.Now.TimeOfDay),
                    patientid = !string.IsNullOrWhiteSpace(firstBill.patientid) ? firstBill.patientid : patientIdFilter,
                    patientname = firstBill.patientname,
                    mobileno = !string.IsNullOrWhiteSpace(firstBill.mobileno) ? firstBill.mobileno : mobileNoFilter,
                    address = null,
                    custid = null,
                    paymentmode = payMode,
                    chequeno = payMode == "CHEQUE" ? chequeNo : null,
                    accountno = payMode == "CHEQUE" ? accountNo : null,
                    referenceno = (payMode != "CASH" && payMode != "CHEQUE") ? referenceNo : null,
                    remarks = "Part payment",
                    usercode = parsedUserCode,
                    branchcode = parsedBranchCode?.ToString() ?? "1",
                    companycode = "1",
                    bh_code = parsedBranchCode,
                    cntcode = parsedCounterCode,
                    cnttid = Guid.NewGuid().ToString()
                },
                details = billsToSave.Select(b => new PharmacyDueCollectionDetailRequest
                {
                    salescode = b.salescode,
                    collectedamount = collectedAmounts.GetValueOrDefault(b.salescode, 0),
                    remarks = billRemarks.GetValueOrDefault(b.salescode, "Part payment")
                }).ToList()
            };

            var res = await DueService.InsertDueCollectionAsync(req);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess(res.Message ?? "Due collection saved successfully");

                // Generate View Model for receipt
                lastCreatedReceipt = new CreatedReceiptReceiptViewModel
                {
                    DueCollectionCode = res.DueCollectionCode ?? 0,
                    RequestNo = $"DUE{DateTime.Now.Year}{(res.DueCollectionCode.HasValue ? res.DueCollectionCode.Value.ToString("D4") : "0001")}",
                    RequestDate = req.master.requestdate,
                    PatientId = req.master.patientid ?? "",
                    PatientName = req.master.patientname ?? "",
                    MobileNo = req.master.mobileno ?? "",
                    PaymentMode = req.master.paymentmode ?? "CASH",
                    ReferenceNo = req.master.referenceno ?? req.master.chequeno,
                    TotalCollectedAmount = billsToSave.Sum(b => collectedAmounts.GetValueOrDefault(b.salescode, 0)),
                    TotalRemainingAmount = Math.Max(0, billsToSave.Sum(b => b.remainingamount - collectedAmounts.GetValueOrDefault(b.salescode, 0))),
                    SettledBills = billsToSave.Select(b => new SettledBillItemViewModel
                    {
                        BillNo = b.billno ?? "",
                        DueAmount = b.remainingamount,
                        CollectedAmount = collectedAmounts.GetValueOrDefault(b.salescode, 0),
                        RemainingAmount = Math.Max(0, b.remainingamount - collectedAmounts.GetValueOrDefault(b.salescode, 0))
                    }).ToList()
                };

                showSuccessModal = true;

                // Reload pending dues to show updated balances
                await SearchPendingDues();
            }
            else
            {
                ToastService.ShowError(res.Message ?? "Failed to save due collection.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving due collection: {ex.Message}");
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }

    // --- HISTORY TAB (Endpoint 5, 6, 4) ---
    private async Task LoadDueCollectionHistory()
    {
        loadingHistory = true;
        StateHasChanged();

        try
        {
            var (success, message, data) = await DueService.GetAllDueCollectionsAsync();
            if (success)
            {
                allHistoryList = data ?? new();
            }
            else
            {
                ToastService.ShowError(message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading history: {ex.Message}");
        }
        finally
        {
            loadingHistory = false;
            StateHasChanged();
        }
    }

    private void OnHistoryPresetChanged(ChangeEventArgs e)
    {
        historyPreset = e.Value?.ToString() ?? "All";
        var today = DateTime.Today;

        switch (historyPreset)
        {
            case "Today":
                historyFromDate = today;
                historyToDate = today;
                break;
            case "Yesterday":
                historyFromDate = today.AddDays(-1);
                historyToDate = today.AddDays(-1);
                break;
            case "This Week":
                var diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
                historyFromDate = today.AddDays(-1 * diff);
                historyToDate = today;
                break;
            case "This Month":
                historyFromDate = new DateTime(today.Year, today.Month, 1);
                historyToDate = today;
                break;
            case "All":
            default:
                historyFromDate = null;
                historyToDate = null;
                break;
        }
    }

    private void ResetHistoryFilters()
    {
        historyPreset = "All";
        historyFromDate = null;
        historyToDate = null;
        historyPayMode = "";
        historySearchQuery = "";
    }

    private async Task OpenDetailsModal(PharmacyDueCollectionRecord rec)
    {
        if (rec.master != null && (rec.details == null || rec.details.Count == 0))
        {
            // Call getduecollectionbycode to get full bill details
            var full = await DueService.GetDueCollectionByCodeAsync(rec.master.duecollectioncode);
            selectedRecordForDetails = full ?? rec;
        }
        else
        {
            selectedRecordForDetails = rec;
        }
        showDetailsModal = true;
    }

    private void PromptDeleteCollection(PharmacyDueCollectionRecord rec)
    {
        recordToDelete = rec;
        showDeleteModal = true;
    }

    private async Task ExecuteDeleteCollection()
    {
        if (recordToDelete?.master == null) return;

        deleting = true;
        StateHasChanged();

        try
        {
            var code = recordToDelete.master.duecollectioncode;
            var res = await DueService.DeleteDueCollectionAsync(code);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess(res.Message ?? "Due collection deleted successfully (bill balance restored).");
                showDeleteModal = false;
                recordToDelete = null;

                // Reload history and pending dues
                await LoadDueCollectionHistory();
                if (pendingBills.Count > 0)
                {
                    await SearchPendingDues();
                }
            }
            else
            {
                ToastService.ShowError(res.Message ?? "Failed to delete due collection.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting collection: {ex.Message}");
        }
        finally
        {
            deleting = false;
            StateHasChanged();
        }
    }

    private void PrintHistoryReceipt(PharmacyDueCollectionRecord rec)
    {
        if (rec.master == null) return;
        var m = rec.master;

        lastCreatedReceipt = new CreatedReceiptReceiptViewModel
        {
            DueCollectionCode = m.duecollectioncode,
            RequestNo = m.requestno ?? $"DUE{m.duecollectioncode}",
            RequestDate = m.requestdate ?? DateTime.Now,
            PatientId = m.patientid ?? "",
            PatientName = m.patientname ?? "",
            MobileNo = m.mobileno ?? "",
            PaymentMode = m.paymentmode ?? "CASH",
            ReferenceNo = m.referenceno ?? m.chequeno,
            TotalCollectedAmount = m.totalcollectedamount,
            TotalRemainingAmount = m.totalremainingamount,
            SettledBills = (rec.details ?? new List<PharmacyDueCollectionDetailData>()).Select(d => new SettledBillItemViewModel
            {
                BillNo = d.billno ?? "",
                DueAmount = d.dueamount,
                CollectedAmount = d.collectedamount,
                RemainingAmount = d.remainingamount
            }).ToList()
        };

        showSuccessModal = true;
    }

