@code {
    // Active Tab: "collect" or "history"
    private string activeTab = "collect";

    // Header Summary Calculations
    private decimal TotalBalanceLoaded => pendingBills.Sum(b => b.remainingamount);
    private decimal TotalCollectedEntered => selectedBills.Keys.Sum(salesCode => collectedAmounts.GetValueOrDefault(salesCode, 0));
    private decimal TotalRemainingAfterCollection => Math.Max(0, TotalBalanceLoaded - TotalCollectedEntered);

    private decimal HeaderTotalBalance => activeTab == "history"
        ? FilteredHistoryList.Sum(h => (h.master?.totaldueamount > 0 ? h.master.totaldueamount : (h.master?.totalcollectedamount ?? 0) + (h.master?.totalremainingamount ?? 0)))
        : TotalBalanceLoaded;

    private int HeaderBillCount => activeTab == "history"
        ? FilteredHistoryList.Count
        : pendingBills.Count;

    private decimal HeaderCollectedAmount => activeTab == "history"
        ? FilteredHistoryList.Sum(h => h.master?.totalcollectedamount ?? 0)
        : (TotalCollectedEntered > 0 ? TotalCollectedEntered : (allHistoryList.Count > 0 && pendingBills.Count == 0 ? allHistoryList.Sum(h => h.master?.totalcollectedamount ?? 0) : TotalCollectedEntered));

    private decimal HeaderRemainingBalance => activeTab == "history"
        ? FilteredHistoryList.Sum(h => h.master?.totalremainingamount ?? 0)
        : TotalRemainingAfterCollection;

    // Filter controls for Tab 1
    private bool showCollectFilter = true;
    private string patientSearchQuery = string.Empty;
    private string patientIdFilter = string.Empty;
    private string mobileNoFilter = string.Empty;
    private string selectedBranch = "";
    private string selectedCounter = "";
    private DateTime requestDate = DateTime.Today;
    private string payMode = "CASH";
    private string? chequeNo;
    private string? accountNo;
    private string? referenceNo;
    private decimal? totalAmountToAllocate;
    private string tableSearchQuery = string.Empty;

    // Selected patient & Autocomplete search states
    private Booking.Models.CustomerWithOpModel? selectedPatient;
    private List<Booking.Models.CustomerWithOpModel> searchedPatients = new();
    private bool showPatientDropdown = false;
    private int activePatientIndex = -1;
    private bool isSearchingPatients = false;
    private System.Threading.CancellationTokenSource? _patientSearchCts;

    // Master lists
    private List<Booking.Models.BranchModel> branchesList = new();
    private List<Medico_Backend.Model.CounterMasterModel> allCounters = new();
    private List<Medico_Backend.Model.CounterMasterModel> filteredCountersList = new();
    private List<Booking.Models.PaymodeMasterModel> paymodesList = new();

    // Data lists
    private List<PharmacyPendingDueBill> pendingBills = new();
    private Dictionary<long, PharmacyPendingDueBill> selectedBills = new();
    private Dictionary<long, decimal> collectedAmounts = new();
    private Dictionary<long, string> billRemarks = new();

    // Loading & saving flags
    private bool loadingBills = false;
    private bool saving = false;

    // Success receipt tracking
    private bool showSuccessModal = false;
    private CreatedReceiptReceiptViewModel? lastCreatedReceipt;

    // History Tab State
    private List<PharmacyDueCollectionRecord> allHistoryList = new();
    private bool loadingHistory = false;
    private DateTime? historyFromDate;
    private DateTime? historyToDate;
    private string historyPreset = "All";
    private string historyPayMode = "";
    private string historySearchQuery = string.Empty;

    // Details & Delete Modal State
    private bool showDetailsModal = false;
    private PharmacyDueCollectionRecord? selectedRecordForDetails;
    private bool showDeleteModal = false;
    private PharmacyDueCollectionRecord? recordToDelete;
    private bool deleting = false;

    // Filtered lists
    private List<PharmacyPendingDueBill> FilteredPendingBills
    {
        get
        {
            if (string.IsNullOrWhiteSpace(tableSearchQuery)) return pendingBills;
            var q = tableSearchQuery.Trim().ToLowerInvariant();
            return pendingBills.Where(b =>
                (b.billno != null && b.billno.ToLowerInvariant().Contains(q)) ||
                (b.patientid != null && b.patientid.ToLowerInvariant().Contains(q)) ||
                (b.patientname != null && b.patientname.ToLowerInvariant().Contains(q)) ||
                (b.mobileno != null && b.mobileno.Contains(q)) ||
                (b.paymentstatus != null && b.paymentstatus.ToLowerInvariant().Contains(q))
            ).ToList();
        }
    }

    private List<PharmacyDueCollectionRecord> FilteredHistoryList
    {
        get
        {
            var list = allHistoryList.AsEnumerable();

            if (historyFromDate.HasValue)
            {
                list = list.Where(r => r.master?.requestdate?.Date >= historyFromDate.Value.Date);
            }
            if (historyToDate.HasValue)
            {
                list = list.Where(r => r.master?.requestdate?.Date <= historyToDate.Value.Date);
            }
            if (!string.IsNullOrWhiteSpace(historyPayMode))
            {
                list = list.Where(r => string.Equals(r.master?.paymentmode, historyPayMode, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(historySearchQuery))
            {
                var q = historySearchQuery.Trim().ToLowerInvariant();
                list = list.Where(r =>
                    (r.master?.requestno != null && r.master.requestno.ToLowerInvariant().Contains(q)) ||
                    (r.master?.patientid != null && r.master.patientid.ToLowerInvariant().Contains(q)) ||
                    (r.master?.patientname != null && r.master.patientname.ToLowerInvariant().Contains(q)) ||
                    (r.master?.mobileno != null && r.master.mobileno.Contains(q)) ||
                    (r.details != null && r.details.Any(d => d.billno != null && d.billno.ToLowerInvariant().Contains(q)))
                );
            }

            return list.OrderByDescending(r => r.master?.requestdate ?? r.master?.createddate ?? DateTime.MinValue).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Set default date range for history (defaults to past 30 days)
        historyFromDate = DateTime.Today.AddDays(-30);
        historyToDate = DateTime.Today;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var bhCodeResult = await _sessionStorage.GetAsync<string>("bhcode");
                if (bhCodeResult.Success && !string.IsNullOrEmpty(bhCodeResult.Value))
                {
                    selectedBranch = bhCodeResult.Value;
                }

                var cntCodeResult = await _sessionStorage.GetAsync<string>("cntcode");
                if (cntCodeResult.Success && !string.IsNullOrEmpty(cntCodeResult.Value))
                {
                    selectedCounter = cntCodeResult.Value;
                }
            }
            catch { }

            await LoadCountersAsync();
            await LoadBranchesAsync();
            await LoadPaymodesAsync();
            await LoadDueCollectionHistory();

            StateHasChanged();
        }
    }

    private void ToggleCollectFilter()
    {
        showCollectFilter = !showCollectFilter;
    }

    private async Task SetActiveTab(string tab)
    {
        activeTab = tab;
        if (tab == "history" && allHistoryList.Count == 0)
        {
            await LoadDueCollectionHistory();
        }
        StateHasChanged();
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            // 1. Session storage cache from MainLayout / UserLogin ("UserBranches")
            try
            {
                var ubRes = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.BranchModel>>("UserBranches");
                if (ubRes.Success && ubRes.Value != null && ubRes.Value.Any())
                {
                    branchesList = ubRes.Value
                        .Where(b => b.bh_code > 0)
                        .Select(b => new Booking.Models.BranchModel
                        {
                            bh_code = b.bh_code,
                            name = !string.IsNullOrWhiteSpace(b.name) ? b.name.Trim() : $"Branch #{b.bh_code}",
                            is_main_branch = b.is_main_branch,
                            deleted = b.deleted
                        })
                        .Where(b => !b.deleted)
                        .GroupBy(b => b.bh_code)
                        .Select(g => g.First())
                        .ToList();
                }
            }
            catch { }

            // 2. Check UserDetails in session storage
            if (branchesList == null || !branchesList.Any())
            {
                try
                {
                    var udRes = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (udRes.Success && udRes.Value?.Branches != null && udRes.Value.Branches.Any())
                    {
                        branchesList = udRes.Value.Branches
                            .Where(b => (b.bh_code > 0 || (b.bhcode.HasValue && b.bhcode.Value > 0)))
                            .Select(b => new Booking.Models.BranchModel
                            {
                                bh_code = b.bh_code > 0 ? b.bh_code : b.bhcode!.Value,
                                name = !string.IsNullOrWhiteSpace(b.name) ? b.name.Trim() : $"Branch #{b.bh_code}"
                            })
                            .GroupBy(b => b.bh_code)
                            .Select(g => g.First())
                            .ToList();
                    }
                }
                catch { }
            }

            // 3. If still empty, fetch from API with Authorization & tenantcode
            if (branchesList == null || !branchesList.Any())
            {
                string effectiveTenant = TenantState?.TenantCode ?? "";
                string effectiveToken = TenantState?.AuthToken ?? "";

                if (string.IsNullOrEmpty(effectiveTenant))
                {
                    try
                    {
                        var tRes = await _sessionStorage.GetAsync<string>("tenant_code");
                        if (tRes.Success && !string.IsNullOrEmpty(tRes.Value)) effectiveTenant = tRes.Value;
                    }
                    catch { }
                }

                if (string.IsNullOrEmpty(effectiveToken))
                {
                    try
                    {
                        var tokRes = await _sessionStorage.GetAsync<string>("authToken");
                        if (tokRes.Success && !string.IsNullOrEmpty(tokRes.Value)) effectiveToken = tokRes.Value;
                    }
                    catch { }
                }

                if (string.IsNullOrEmpty(effectiveTenant) || string.IsNullOrEmpty(effectiveToken))
                {
                    try
                    {
                        var localSessionJson = await JS.InvokeAsync<string>("medicoSessionHelper.getSession");
                        if (!string.IsNullOrWhiteSpace(localSessionJson))
                        {
                            var jObj = Newtonsoft.Json.Linq.JObject.Parse(localSessionJson);
                            if (string.IsNullOrEmpty(effectiveTenant)) effectiveTenant = jObj["tenant_code"]?.ToString() ?? "";
                            if (string.IsNullOrEmpty(effectiveToken)) effectiveToken = jObj["authToken"]?.ToString() ?? "";
                        }
                    }
                    catch { }
                }

                string[] clientNames = new[] { "LabCareUrl", "DoctorApi" };
                foreach (var cName in clientNames)
                {
                    try
                    {
                        var client = ClientFactory.CreateClient(cName);
                        if (!string.IsNullOrEmpty(effectiveTenant))
                        {
                            client.DefaultRequestHeaders.Remove("tenant_code");
                            client.DefaultRequestHeaders.Remove("tenantcode");
                            client.DefaultRequestHeaders.Remove("tenant-code");
                            client.DefaultRequestHeaders.Add("tenant_code", effectiveTenant);
                            client.DefaultRequestHeaders.Add("tenantcode", effectiveTenant);
                            client.DefaultRequestHeaders.Add("tenant-code", effectiveTenant);
                        }
                        if (!string.IsNullOrEmpty(effectiveToken))
                        {
                            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
                        }

                        var response = await client.GetAsync("api/Branch/get");
                        if (response.IsSuccessStatusCode)
                        {
                            var json = await response.Content.ReadAsStringAsync();
                            var list = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                            list = list.Where(b => !b.deleted).ToList();
                            if (list.Any())
                            {
                                branchesList = list;
                                break;
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[PharmacyDueCollection] Error loading branches from {cName}: {ex.Message}");
                    }
                }
            }

            // 4. Fallback from allCounters if branches list is still empty
            if ((branchesList == null || !branchesList.Any()) && allCounters != null && allCounters.Any())
            {
                branchesList = allCounters
                    .Where(c => c.bhcode.HasValue && c.bhcode.Value > 0)
                    .Select(c => (int)c.bhcode!.Value)
                    .Distinct()
                    .Select(bh => new Booking.Models.BranchModel
                    {
                        bh_code = bh,
                        name = bh == 1 ? "Main Branch" : $"Branch {bh}"
                    })
                    .ToList();
            }

            // 5. Filter by user access rights for non-admins
            await FilterBranchesByUserAccessAsync();

            // 6. Auto-select branch if not already set or invalid
            if (string.IsNullOrEmpty(selectedBranch) || !branchesList.Any(b => b.bh_code.ToString() == selectedBranch))
            {
                if (TenantState?.BranchCode.HasValue == true && branchesList.Any(b => b.bh_code == TenantState.BranchCode.Value))
                {
                    selectedBranch = TenantState.BranchCode.Value.ToString();
                }
                else if (branchesList.Any(b => b.name != null && b.name.Contains("main", StringComparison.OrdinalIgnoreCase)))
                {
                    selectedBranch = branchesList.First(b => b.name != null && b.name.Contains("main", StringComparison.OrdinalIgnoreCase)).bh_code.ToString();
                }
                else if (branchesList.Any())
                {
                    selectedBranch = branchesList.First().bh_code.ToString();
                }
            }

            ApplyCounterFilter();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PharmacyDueCollection] Error loading branches: {ex.Message}");
        }
    }

    private async Task FilterBranchesByUserAccessAsync()
    {
        try
        {
            var isTenantAdminResult = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
            if (isTenantAdminResult.Success && isTenantAdminResult.Value == true)
            {
                return;
            }

            var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (userDetailsResult.Success && userDetailsResult.Value != null)
            {
                var ud = userDetailsResult.Value;
                if (ud.UserCode == 0 || ud.UserCode == 1 ||
                    string.Equals(ud.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(ud.Role, "Admin", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(ud.Role, "Owner", StringComparison.OrdinalIgnoreCase))
                {
                    return; // Admins/Owners see all branches
                }

                if (ud.Branches != null && ud.Branches.Any())
                {
                    var allowedCodes = ud.Branches
                        .Select(b => b.bh_code != 0 ? b.bh_code : (b.bhcode ?? 0))
                        .Where(code => code > 0)
                        .ToHashSet();

                    if (allowedCodes.Any())
                    {
                        var filtered = branchesList.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                        if (filtered.Any())
                        {
                            branchesList = filtered;
                            return;
                        }
                    }
                }
            }

            var branchCodesResult = await _sessionStorage.GetAsync<List<int>>("UserBranchCodes");
            if (branchCodesResult.Success && branchCodesResult.Value != null && branchCodesResult.Value.Any())
            {
                var allowedCodes = branchCodesResult.Value.ToHashSet();
                var filtered = branchesList.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                if (filtered.Any())
                {
                    branchesList = filtered;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PharmacyDueCollection] Error filtering branches: {ex.Message}");
        }
    }

