@page "/pharmacy-due-collection"
@rendermode InteractiveServer
@using Booking.Models
@using medico_backend.Model
@using Medico_Backend.Model
@using Newtonsoft.Json
@inject Booking.Services.PharmacyDueCollectionService DueService
@inject Booking.Services.CounterMasterService CounterService
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.PaymodeMasterService PaymodeService
@inject Booking.Services.ToastService ToastService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Booking.Services.LabSettingService LabSettingService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage _sessionStorage
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.RoleMasterService RoleService
@implements IDisposable

<div class="due-collection-wrapper">
    <!-- Top Header Card -->
    <div class="due-header-card">
        <div class="header-left-section" style="display: flex; align-items: center; gap: 1.25rem;">
            <div class="header-icon-container">
                <i class="bi bi-wallet2"></i>
            </div>
            <div class="header-text-container">
                <h1>Pharmacy Due Collection</h1>
                <p><span class="header-status-dot"></span> PHARMACY PAYMENT MANAGEMENT</p>
            </div>
        </div>

        <div class="header-right-section">
            <div class="header-summary-cards">
                <div class="header-summary-card balance">
                    <span class="header-summary-label">TOTAL BALANCE</span>
                    <span class="header-summary-value text-balance">₹ @HeaderTotalBalance.ToString("N2")</span>
                </div>
                <div class="header-summary-card count">
                    <span class="header-summary-label">@(activeTab == "history" ? "HISTORY COUNT" : "BILL COUNT")</span>
                    <span class="header-summary-value text-count">@HeaderBillCount</span>
                </div>
                <div class="header-summary-card collected">
                    <span class="header-summary-label">COLLECTED AMT</span>
                    <span class="header-summary-value text-collected">₹ @HeaderCollectedAmount.ToString("N2")</span>
                </div>
                <div class="header-summary-card remaining">
                    <span class="header-summary-label">REMAINING BAL</span>
                    <span class="header-summary-value text-remaining">₹ @HeaderRemainingBalance.ToString("N2")</span>
                </div>
            </div>

            <button class="btn-history-filter-trigger @(showCollectFilter ? "active" : "")" @onclick="ToggleCollectFilter">
                <i class="bi bi-funnel"></i> Filter
            </button>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="due-tabs">
        <button class="tab-btn @(activeTab == "collect" ? "active" : "")" @onclick='() => SetActiveTab("collect")'>
            <i class="bi bi-cash-coin"></i> Collect Dues
        </button>
        <button class="tab-btn @(activeTab == "history" ? "active" : "")" @onclick='() => SetActiveTab("history")'>
            <i class="bi bi-clock-history"></i> Collection History
        </button>
    </div>

    <!-- TAB 1: COLLECT DUES -->
    @if (activeTab == "collect")
    {
        <div class="collect-tab-layout">
            <!-- Advanced Filter Card -->
            @if (showCollectFilter)
            {
                <div class="advanced-filter-card">
                    <div class="filter-boxes-grid">
                        <!-- First Row: PATIENT SEARCH, PATIENT ID, MOBILE NO, BRANCH, COUNTER -->
                        <div style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap; width: 100%;">
                            <!-- Patient Autocomplete Search -->
                            <div class="form-group-filter" style="flex: 2; min-width: 260px; position: relative;">
                                <label>PATIENT SEARCH</label>
                                <div class="autocomplete-search-wrapper">
                                    <div style="position: relative; display: flex; align-items: center;">
                                        <input type="text" class="filter-input" placeholder="Type Patient Name, Mobile, or ID..."
                                               value="@patientSearchQuery" @oninput="OnPatientSearchInput" @onkeydown="OnPatientSearchKeyDown" style="width: 100%; padding-right: 28px;" />
                                        @if (isSearchingPatients)
                                        {
                                            <span class="spinner-border spinner-border-sm" style="position: absolute; right: 8px; width: 14px; height: 14px; color: #4f46e5;" role="status"></span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(patientSearchQuery))
                                        {
                                            <button type="button" @onclick="ClearPatientSearch" style="position: absolute; right: 8px; background: none; border: none; color: #94a3b8; cursor: pointer; padding: 0; line-height: 1;" title="Clear search">
                                                <i class="bi bi-x-circle-fill"></i>
                                            </button>
                                        }
                                    </div>
                                    @if (showPatientDropdown)
                                    {
                                        <div class="autocomplete-dropdown">
                                            <div class="autocomplete-header">
                                                <span>MATCHING PATIENTS (@searchedPatients.Count)</span>
                                                <button type="button" class="btn-close-dropdown" @onclick="() => showPatientDropdown = false">&times;</button>
                                            </div>
                                            @if (searchedPatients.Count == 0)
                                            {
                                                <div style="padding: 0.85rem 1rem; color: #64748b; font-size: 0.82rem; text-align: center;">
                                                    No patients found matching "<strong>@patientSearchQuery</strong>"
                                                </div>
                                            }
                                            else
                                            {
                                                @for (int i = 0; i < searchedPatients.Count; i++)
                                                {
                                                    var patIdx = i;
                                                    var pat = searchedPatients[i];
                                                    var displayName = !string.IsNullOrWhiteSpace(pat.namewithinitials)
                                                        ? pat.namewithinitials
                                                        : (!string.IsNullOrWhiteSpace(pat.name) ? pat.name : $"Patient {pat.custid}");

                                                    <div class="autocomplete-item @(patIdx == activePatientIndex ? "active-focused" : "")"
                                                         @onclick="() => SelectCustomerPatient(pat)"
                                                         @onmouseover="() => activePatientIndex = patIdx">
                                                        <div style="flex: 1; min-width: 0;">
                                                            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                                                <span style="font-weight: 700; color: #0f172a; font-size: 0.88rem;">@displayName</span>
                                                                <span class="autocomplete-code">CUST-@pat.custid</span>
                                                                @if (!string.IsNullOrWhiteSpace(pat.op_no))
                                                                {
                                                                    <span class="autocomplete-op-code">OP: @pat.op_no</span>
                                                                }
                                                            </div>
                                                            <div style="font-size: 0.78rem; color: #64748b; margin-top: 2px; display: flex; gap: 0.6rem; flex-wrap: wrap;">
                                                                <span>📞 @(string.IsNullOrWhiteSpace(pat.mobile) ? (string.IsNullOrWhiteSpace(pat.phone) ? "No Mobile" : pat.phone) : pat.mobile)</span>
                                                                @if (pat.ageyears > 0 || !string.IsNullOrWhiteSpace(pat.gender))
                                                                {
                                                                    <span>| 👤 @pat.gender @(pat.ageyears > 0 ? $"({pat.ageyears} Yrs)" : "")</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(pat.area) || !string.IsNullOrWhiteSpace(pat.city))
                                                                {
                                                                    <span>| 📍 @pat.area@(string.IsNullOrWhiteSpace(pat.city) ? "" : $", {pat.city}")</span>
                                                                }
                                                            </div>
                                                        </div>
                                                        <div style="font-size: 0.75rem; color: #4f46e5; font-weight: 700; display: flex; align-items: center; gap: 4px; padding-left: 8px;">
                                                            <span>Select</span> <i class="bi bi-chevron-right"></i>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Direct Patient ID -->
                            <div class="form-group-filter" style="flex: 1; min-width: 120px;">
                                <label>PATIENT ID</label>
                                <input type="text" class="filter-input" placeholder="e.g. P1001" @bind="patientIdFilter" style="width: 100%;" />
                            </div>

                            <!-- Direct Mobile No -->
                            <div class="form-group-filter" style="flex: 1; min-width: 130px;">
                                <label>MOBILE NO</label>
                                <input type="text" class="filter-input" placeholder="e.g. 9876543210" @bind="mobileNoFilter" style="width: 100%;" />
                            </div>

                            <!-- Branch -->
                            <div class="form-group-filter" style="flex: 1; min-width: 150px;">
                                <label>BRANCH</label>
                                <select class="filter-select" @bind="selectedBranch" @bind:after="OnBranchChanged" style="width: 100%;">
                                    <option value="">Select Branch</option>
                                    @if (branchesList != null && branchesList.Count > 0)
                                    {
                                        @foreach (var b in branchesList)
                                        {
                                            <option value="@b.bh_code.ToString()">@b.name</option>
                                        }
                                    }
                                </select>
                            </div>

                            <!-- Counter -->
                            <div class="form-group-filter" style="flex: 1; min-width: 150px;">
                                <label>COUNTER</label>
                                <select class="filter-select" @bind="selectedCounter" style="width: 100%;">
                                    <option value="">Select Counter</option>
                                    @if (filteredCountersList != null && filteredCountersList.Count > 0)
                                    {
                                        @foreach (var c in filteredCountersList)
                                        {
                                            <option value="@c.cntcode.ToString()">@c.name</option>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var c in allCounters)
                                        {
                                            <option value="@c.cntcode.ToString()">@c.name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Second Row: DATE, PAYMODE, CHEQUE / REF, AMOUNT + AUTO SELECT, SEARCH / RESET -->
                        <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; width: 100%; margin-top: 0.25rem;">
                            <div style="display: flex; gap: 0.85rem; align-items: flex-end; flex-wrap: wrap;">
                                <!-- Collection Date -->
                                <div class="form-group-filter" style="width: 140px;">
                                    <label>COLLECTION DATE</label>
                                    <input type="date" class="filter-input" @bind="requestDate" style="width: 100%;" />
                                </div>

                                <!-- Pay Mode -->
                                <div class="form-group-filter" style="width: 130px;">
                                    <label>PAY MODE</label>
                                    <select class="filter-select" @bind="payMode" style="width: 100%;">
                                        <option value="CASH">CASH</option>
                                        <option value="UPI">UPI</option>
                                        <option value="CARD">CARD</option>
                                        <option value="GPAY">GPAY</option>
                                        <option value="CHEQUE">CHEQUE</option>
                                        @if (paymodesList != null && paymodesList.Count > 0)
                                        {
                                            @foreach (var pm in paymodesList.Where(p => !new[] { "CASH", "CARD", "UPI", "GPAY", "CHEQUE" }.Contains(p.shortname?.ToUpperInvariant() ?? "")))
                                            {
                                                <option value="@(pm.shortname?.ToUpperInvariant() ?? pm.name)">@(pm.name ?? pm.shortname)</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <!-- Cheque fields -->
                                @if (payMode == "CHEQUE")
                                {
                                    <div class="form-group-filter" style="width: 130px;">
                                        <label>CHEQUE NO</label>
                                        <input type="text" class="filter-input" placeholder="e.g. 004512" @bind="chequeNo" style="width: 100%;" />
                                    </div>
                                    <div class="form-group-filter" style="width: 160px;">
                                        <label>ACCOUNT NO / BANK</label>
                                        <input type="text" class="filter-input" placeholder="e.g. 50100123456789" @bind="accountNo" style="width: 100%;" />
                                    </div>
                                }
                                else if (payMode != "CASH")
                                {
                                    <div class="form-group-filter" style="width: 180px;">
                                        <label>TXN / REF NO</label>
                                        <input type="text" class="filter-input" placeholder="e.g. UPI4829301847" @bind="referenceNo" style="width: 100%;" />
                                    </div>
                                }

                                <!-- Amount + Auto Select button -->
                                <div class="form-group-filter" style="width: 220px;">
                                    <label>AMOUNT</label>
                                    <div style="display: flex; align-items: center; gap: 0.4rem;">
                                        <input type="number" step="any" min="0" class="filter-input" placeholder="0.00"
                                               @bind="totalAmountToAllocate" @bind:event="oninput" style="flex: 1;" />
                                        <button type="button" class="btn-link" @onclick="AutoAllocateAmount"
                                                disabled="@(totalAmountToAllocate == null || totalAmountToAllocate <= 0 || pendingBills.Count == 0)"
                                                title="Auto distribute amount greedily across pending bills">
                                            Auto select
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Filter Actions -->
                            <div style="display: flex; gap: 0.75rem; align-items: flex-end;">
                                <button class="btn-reset-filters" @onclick="ResetFilters">
                                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                                </button>
                                <button class="btn-search-blue" @onclick="SearchPendingDues" disabled="@loadingBills">
                                    @if (loadingBills)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-search"></i>
                                    }
                                    Search Dues
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Selected Patient Information Card -->
            @if (selectedPatient != null || pendingBills.Any())
            {
                var displayName = selectedPatient != null
                    ? (!string.IsNullOrWhiteSpace(selectedPatient.namewithinitials) ? selectedPatient.namewithinitials : (!string.IsNullOrWhiteSpace(selectedPatient.name) ? selectedPatient.name : "Patient"))
                    : (pendingBills.FirstOrDefault()?.patientname ?? "Patient");
                var dispId = selectedPatient != null
                    ? (selectedPatient.custid > 0 ? selectedPatient.custid.ToString() : (selectedPatient.custcode ?? patientIdFilter))
                    : (pendingBills.FirstOrDefault()?.patientid ?? patientIdFilter);
                var dispMobile = selectedPatient != null
                    ? (!string.IsNullOrWhiteSpace(selectedPatient.mobile) ? selectedPatient.mobile : (selectedPatient.phone ?? mobileNoFilter))
                    : (pendingBills.FirstOrDefault()?.mobileno ?? mobileNoFilter);
                var dispOp = selectedPatient?.op_no;
                var dispArea = selectedPatient?.area;
                var dispGender = selectedPatient?.gender;
                var dispAge = selectedPatient != null && selectedPatient.ageyears > 0 ? $"{selectedPatient.ageyears} Yrs" : null;

                <div class="selected-patient-card">
                    <div class="patient-card-left">
                        <div class="patient-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="patient-info">
                            <div class="patient-name-row">
                                <span class="patient-name">@displayName</span>
                                @if (!string.IsNullOrWhiteSpace(dispId))
                                {
                                    <span class="patient-id-badge">ID: @dispId</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(dispOp))
                                {
                                    <span class="patient-op-badge">OP: @dispOp</span>
                                }
                            </div>
                            <div class="patient-meta-row">
                                @if (!string.IsNullOrWhiteSpace(dispMobile))
                                {
                                    <span><i class="bi bi-telephone"></i> @dispMobile</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(dispGender) || !string.IsNullOrWhiteSpace(dispAge))
                                {
                                    <span><i class="bi bi-person"></i> @dispGender @(dispAge != null ? $", {dispAge}" : "")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(dispArea))
                                {
                                    <span><i class="bi bi-geo-alt"></i> @dispArea</span>
                                }
                                <span class="bills-found-tag"><i class="bi bi-receipt"></i> @pendingBills.Count Pending Bill(s)</span>
                            </div>
                        </div>
                    </div>
                    <div class="patient-card-right">
                        <button type="button" class="btn-clear-patient" @onclick="ClearSelectedPatient" title="Clear Patient Selection">
                            <i class="bi bi-x-circle"></i> Clear Selection
                        </button>
                    </div>
                </div>
            }

            <!-- Controls Card -->
            <div class="controls-card">
                <div class="controls-left">
                    <span style="font-size: 0.85rem; font-weight: 700; color: #475569;">
                        Selected: <strong style="color: #4f46e5;">@selectedBills.Count</strong> of <strong>@pendingBills.Count</strong> bills
                        | Total Collection: <strong style="color: #4f46e5;">₹ @TotalCollectedEntered.ToString("N2")</strong>
                    </span>
                </div>

                <div class="controls-right">
                    <div class="search-input-wrapper">
                        <i class="bi bi-search"></i>
                        <input type="text" class="control-input" placeholder="Filter bills or patient..." @bind="tableSearchQuery" @bind:event="oninput" />
                        @if (!string.IsNullOrEmpty(tableSearchQuery))
                        {
                            <button class="clear-search-btn" @onclick="() => tableSearchQuery = string.Empty">×</button>
                        }
                    </div>

                    <button class="btn-save" @onclick="SaveDueCollection" disabled="@(selectedBills.Count == 0 || TotalCollectedEntered <= 0 || saving)">
                        @if (saving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle"></i>
                            <span>Save Collection</span>
                        }
                    </button>
                </div>
            </div>

            <!-- Bills Table -->
            <div class="table-container shadow-sm mt-2">
                <table class="due-table">
                    <thead>
                        <tr>
                            <th class="col-check">
                                <input type="checkbox" checked="@IsAllSelected()" @onchange="ToggleSelectAll" disabled="@(FilteredPendingBills.Count == 0)" title="Select all bills" />
                            </th>
                            <th>BILL NO</th>
                            <th>DATE / TIME</th>
                            <th>PATIENT ID</th>
                            <th>CUSTOMER NAME</th>
                            <th>MOBILE</th>
                            <th class="text-end">BILL AMOUNT</th>
                            <th class="text-end">PAID AMOUNT</th>
                            <th class="text-end">REMAINING DUE</th>
                            <th class="text-center" style="width: 140px;">COLLECTED (₹)</th>
                            <th style="min-width: 140px;">REMARKS</th>
                            <th class="text-center">STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (loadingBills)
                        {
                            <tr>
                                <td colspan="12" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <div class="mt-2 text-muted font-bold">Loading pending pharmacy dues...</div>
                                </td>
                            </tr>
                        }
                        else if (pendingBills.Count == 0)
                        {
                            <tr>
                                <td colspan="12" class="text-center py-5 text-muted">
                                    <i class="bi bi-receipt font-xxl" style="font-size: 2.2rem; color: #cbd5e1; display: block; margin-bottom: 0.5rem;"></i>
                                    <div style="font-weight: 700; color: #475569;">No pending dues loaded.</div>
                                    <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 0.25rem;">
                                        Enter a Patient ID (e.g. P1001) or Mobile Number, or use the Patient Search autocomplete above.
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (FilteredPendingBills.Count == 0)
                        {
                            <tr>
                                <td colspan="12" class="text-center py-4 text-muted">
                                    No pending bills match your filter query "<strong>@tableSearchQuery</strong>".
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var bill in FilteredPendingBills)
                            {
                                var isSelected = selectedBills.ContainsKey(bill.salescode);
                                var enteredAmt = collectedAmounts.GetValueOrDefault(bill.salescode, 0);

                                <tr class="@(isSelected ? "row-selected" : "")">
                                    <td class="col-check">
                                        <input type="checkbox" checked="@isSelected" @onchange="() => ToggleSelectBill(bill)" />
                                    </td>
                                    <td>
                                        <span style="font-weight: 800; color: #4f46e5; font-family: monospace;">@bill.billno</span>
                                    </td>
                                    <td class="text-muted" style="font-size: 0.8rem;">
                                        @(bill.billdate?.ToString("dd-MMM-yyyy HH:mm") ?? "-")
                                    </td>
                                    <td style="font-weight: 700; font-family: monospace;">
                                        @bill.patientid
                                    </td>
                                    <td style="font-weight: 700; color: #0f172a;">
                                        @bill.patientname
                                    </td>
                                    <td class="text-muted">
                                        @bill.mobileno
                                    </td>
                                    <td class="text-end" style="font-weight: 700;">
                                        ₹ @bill.billamount.ToString("N2")
                                    </td>
                                    <td class="text-end text-muted">
                                        ₹ @bill.paidamount.ToString("N2")
                                    </td>
                                    <td class="text-end" style="font-weight: 800; color: #dc2626;">
                                        ₹ @bill.remainingamount.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        <input id="@($"collected_{bill.salescode}")"
                                               type="number" step="any" min="0" max="@bill.remainingamount"
                                               class="row-input text-end"
                                               value="@GetCollectedAmountString(bill.salescode)"
                                               @oninput="(e) => OnCollectedAmountInput(bill, e)"
                                               @onclick="() => EnsureBillSelected(bill)"
                                               placeholder="0.00" />
                                    </td>
                                    <td>
                                        <input type="text" class="filter-input" style="height: 32px; font-size: 0.8rem; width: 100%;"
                                               placeholder="Remarks..."
                                               value="@GetBillRemarks(bill.salescode)"
                                               @oninput="(e) => SetBillRemarks(bill, e.Value?.ToString())"
                                               @onclick="() => EnsureBillSelected(bill)" />
                                    </td>
                                    <td class="text-center">
                                        <span class="badge-status @(bill.paymentstatus?.ToLowerInvariant() == "paid" ? "paid" : (bill.paymentstatus?.ToLowerInvariant() == "partial" ? "partial" : "due"))">
                                            @bill.paymentstatus
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- TAB 2: COLLECTION HISTORY -->
    @if (activeTab == "history")
    {
        <div class="history-tab-layout">
            <!-- History Filter Card -->
            <div class="hist-filter-card">
                <div class="hist-filter-row">
                    <div class="form-group-filter" style="width: 140px;">
                        <label>FROM DATE</label>
                        <input type="date" class="filter-input" @bind="historyFromDate" />
                    </div>
                    <div class="form-group-filter" style="width: 140px;">
                        <label>TO DATE</label>
                        <input type="date" class="filter-input" @bind="historyToDate" />
                    </div>
                    <div class="form-group-filter" style="width: 130px;">
                        <label>PRESET</label>
                        <select class="filter-select" value="@historyPreset" @onchange="OnHistoryPresetChanged">
                            <option value="All">All Time</option>
                            <option value="Today">Today</option>
                            <option value="Yesterday">Yesterday</option>
                            <option value="This Week">This Week</option>
                            <option value="This Month">This Month</option>
                        </select>
                    </div>
                    <div class="form-group-filter" style="width: 130px;">
                        <label>PAY MODE</label>
                        <select class="filter-select" @bind="historyPayMode">
                            <option value="">All Modes</option>
                            <option value="CASH">CASH</option>
                            <option value="UPI">UPI</option>
                            <option value="CARD">CARD</option>
                            <option value="CHEQUE">CHEQUE</option>
                        </select>
                    </div>
                    <div class="form-group-filter" style="flex: 1; min-width: 200px;">
                        <label>SEARCH HISTORY</label>
                        <input type="text" class="filter-input" placeholder="Search Request No, Patient, Mobile, Bill No..." @bind="historySearchQuery" @bind:event="oninput" />
                    </div>
                    <div style="display: flex; gap: 0.5rem; align-items: flex-end;">
                        <button class="btn-hist-action search" @onclick="LoadDueCollectionHistory" disabled="@loadingHistory">
                            @if (loadingHistory)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="bi bi-search"></i>
                            }
                            Search
                        </button>
                        <button class="btn-hist-action reset" @onclick="ResetHistoryFilters">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset
                        </button>
                    </div>
                </div>
            </div>

            <!-- History Summary Stats -->
            <div style="display: flex; gap: 1rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
                <div class="header-summary-card count" style="flex: 1; background: #ffffff; padding: 0.75rem 1rem;">
                    <span class="header-summary-label">COLLECTIONS COUNT</span>
                    <span class="header-summary-value text-count" style="font-size: 1.25rem;">@FilteredHistoryList.Count</span>
                </div>
                <div class="header-summary-card collected" style="flex: 1; background: #ffffff; padding: 0.75rem 1rem;">
                    <span class="header-summary-label">TOTAL AMOUNT COLLECTED</span>
                    <span class="header-summary-value text-collected" style="font-size: 1.25rem;">₹ @FilteredHistoryList.Sum(h => h.master?.totalcollectedamount ?? 0).ToString("N2")</span>
                </div>
                <div class="header-summary-card remaining" style="flex: 1; background: #ffffff; padding: 0.75rem 1rem;">
                    <span class="header-summary-label">TOTAL REMAINING</span>
                    <span class="header-summary-value text-remaining" style="font-size: 1.25rem;">₹ @FilteredHistoryList.Sum(h => h.master?.totalremainingamount ?? 0).ToString("N2")</span>
                </div>
            </div>

            <!-- History Table -->
            <div class="table-container shadow-sm">
                <table class="due-table">
                    <thead>
                        <tr>
                            <th>REQUEST NO</th>
                            <th>DATE / TIME</th>
                            <th>PATIENT ID</th>
                            <th>PATIENT NAME</th>
                            <th>MOBILE</th>
                            <th class="text-center">BILLS</th>
                            <th class="text-end">TOTAL DUE</th>
                            <th class="text-end">COLLECTED</th>
                            <th class="text-end">REMAINING</th>
                            <th class="text-center">PAY MODE</th>
                            <th class="text-center">STATUS</th>
                            <th class="text-center" style="width: 140px;">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (loadingHistory)
                        {
                            <tr>
                                <td colspan="12" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <div class="mt-2 text-muted font-bold">Loading past pharmacy due collections...</div>
                                </td>
                            </tr>
                        }
                        else if (FilteredHistoryList.Count == 0)
                        {
                            <tr>
                                <td colspan="12" class="text-center py-5 text-muted">
                                    <i class="bi bi-clock-history font-xxl" style="font-size: 2.2rem; color: #cbd5e1; display: block; margin-bottom: 0.5rem;"></i>
                                    <div style="font-weight: 700; color: #475569;">No collection history found.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var rec in FilteredHistoryList)
                            {
                                var m = rec.master;
                                if (m == null) continue;

                                <tr>
                                    <td>
                                        <strong style="color: #4f46e5; font-family: monospace;">@m.requestno</strong>
                                    </td>
                                    <td class="text-muted" style="font-size: 0.8rem;">
                                        @(m.requestdate?.ToString("dd-MMM-yyyy HH:mm") ?? "-")
                                    </td>
                                    <td style="font-weight: 700; font-family: monospace;">
                                        @m.patientid
                                    </td>
                                    <td style="font-weight: 700; color: #0f172a;">
                                        @m.patientname
                                    </td>
                                    <td class="text-muted">
                                        @m.mobileno
                                    </td>
                                    <td class="text-center font-bold">
                                        @(m.totalbills > 0 ? m.totalbills : (rec.details?.Count ?? 0))
                                    </td>
                                    <td class="text-end" style="font-weight: 700;">
                                        ₹ @m.totaldueamount.ToString("N2")
                                    </td>
                                    <td class="text-end" style="font-weight: 800; color: #10b981;">
                                        ₹ @m.totalcollectedamount.ToString("N2")
                                    </td>
                                    <td class="text-end" style="font-weight: 700; color: #dc2626;">
                                        ₹ @m.totalremainingamount.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">
                                            @m.paymentmode
                                            @if (!string.IsNullOrEmpty(m.referenceno))
                                            {
                                                <small style="display: block; font-size: 0.68rem; color: #64748b;">@m.referenceno</small>
                                            }
                                            @if (!string.IsNullOrEmpty(m.chequeno))
                                            {
                                                <small style="display: block; font-size: 0.68rem; color: #64748b;">Chq: @m.chequeno</small>
                                            }
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge-status completed">
                                            @(string.IsNullOrWhiteSpace(m.status) ? "COMPLETED" : m.status)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div style="display: inline-flex; gap: 0.35rem;">
                                            <button class="btn btn-sm btn-outline-primary" style="padding: 2px 7px; font-size: 0.75rem;"
                                                    @onclick="() => OpenDetailsModal(rec)" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-primary" style="padding: 2px 7px; font-size: 0.75rem;"
                                                    @onclick="() => PrintHistoryReceipt(rec)" title="Print Receipt">
                                                <i class="bi bi-printer"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" style="padding: 2px 7px; font-size: 0.75rem;"
                                                    @onclick="() => PromptDeleteCollection(rec)" title="Delete Collection (Restores Balance)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

