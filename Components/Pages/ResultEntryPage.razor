@page "/result-entry"
@page "/result-entry/{requestguid}"
@using Booking.Models
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject Booking.Services.LabResultService ResultService
@inject NavigationManager Navigation
@inject Booking.Services.ToastService Toast

<PageTitle>Result Entry - Laboratory Workspace</PageTitle>

<div style="padding: 16px 20px 80px; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: #f8fafc; min-height: 100vh;">

    <!-- Header Section -->
    <div style="background: linear-gradient(135deg, #1e293b, #334155); border-radius: 16px; padding: 20px 24px; color: white; display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);">
        <div>
            <div style="font-size: 0.75rem; color: #818cf8; font-weight: 700; text-transform: uppercase; margin-bottom: 4px;">Laboratory Workspace</div>
            <h2 style="margin: 0; font-size: 1.25rem; font-weight: 800; letter-spacing: -0.02em;">Test Result Entry</h2>
        </div>
        <div style="display: flex; gap: 12px;">
            <button style="background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.2); padding: 8px 16px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; cursor: pointer;" @onclick="GoBack">
                Back to Search
            </button>
            <button style="background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; border: none; padding: 8px 20px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; cursor: pointer; box-shadow: 0 4px 12px rgba(37,99,235,0.3);" @onclick="SaveResults" disabled="@isSaving">
                @(isSaving ? "Saving..." : "Save & Authorize")
            </button>
        </div>
    </div>

    <!-- Request Details Bar -->
    @if (!string.IsNullOrEmpty(requestguid))
    {
        <div style="background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; padding: 12px 20px; margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem;">
            <div>
                <span style="color: #64748b; font-weight: 600;">Request ID:</span>
                <span style="font-weight: 800; color: #0f172a; margin-left: 6px;">@requestguid</span>
            </div>
            <div>
                <span style="color: #64748b; font-weight: 600;">Entry Date:</span>
                <span style="font-weight: 700; color: #1e293b; margin-left: 6px;">@DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")</span>
            </div>
        </div>
    }

    <!-- Result Entry Form Grid -->
    <div style="background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);">
        @if (isLoading)
        {
            <div style="padding: 40px; text-align: center; color: #64748b; font-weight: 600;">Loading test properties & parameters...</div>
        }
        else if (entryModel == null || !entryModel.results.Any())
        {
            <div style="padding: 40px; text-align: center; color: #94a3b8; font-weight: 600;">
                No result parameters found for this request ID. Please check the request selection.
            </div>
        }
        else
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; text-transform: uppercase; font-size: 0.7rem; font-weight: 800;">
                            <th style="padding: 12px 16px; width: 40px;">#</th>
                            <th style="padding: 12px 16px; width: 250px;">Test Name</th>
                            <th style="padding: 12px 16px; width: 200px;">Group / Category</th>
                            <th style="padding: 12px 16px; width: 200px;">Result Value</th>
                            <th style="padding: 12px 16px; width: 120px;">Unit</th>
                            <th style="padding: 12px 16px; width: 180px;">Normal Reference</th>
                            <th style="padding: 12px 16px;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < entryModel.results.Count; i++)
                        {
                            var index = i;
                            var item = entryModel.results[index];
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 12px 16px; font-weight: 700; color: #64748b;">@(index + 1)</td>
                                <td style="padding: 12px 16px; font-weight: 800; color: #0f172a;">@item.testname</td>
                                <td style="padding: 12px 16px; color: #6366f1; font-weight: 600;">@item.groupname</td>
                                <td style="padding: 12px 16px;">
                                    <input type="text" class="result-input" @bind="item.enteredresult" placeholder="Enter value..." style="width: 100%; padding: 8px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-weight: 700; font-size: 0.9rem; color: #0f172a;" />
                                </td>
                                <td style="padding: 12px 16px; color: #475569; font-weight: 600;">
                                    @(string.IsNullOrEmpty(item.unitname) ? (string.IsNullOrEmpty(item.defaultunitvalue) ? "-" : item.defaultunitvalue) : item.unitname)
                                </td>
                                <td style="padding: 12px 16px; color: #64748b; font-size: 0.8rem; font-weight: 600;">
                                    @(string.IsNullOrEmpty(item.normalvalue) ? "As Specified" : item.normalvalue)
                                </td>
                                <td style="padding: 12px 16px;">
                                    @if (!string.IsNullOrEmpty(item.enteredresult))
                                    {
                                        <span style="background: #d1fae5; color: #047857; padding: 4px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 700;">Entered</span>
                                    }
                                    else
                                    {
                                        <span style="background: #f1f5f9; color: #64748b; padding: 4px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 700;">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .result-input:focus {
        border-color: #2563eb !important;
        box-shadow: 0 0 0 3px rgba(37,99,235,0.12) !important;
        outline: none;
    }
</style>

@code {
    [Parameter] public string? requestguid { get; set; }

    private ResultEntryModel? entryModel;
    private bool isLoading = false;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(requestguid))
        {
            await LoadTestEntry();
        }
    }

    private async Task LoadTestEntry()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            entryModel = await ResultService.LoadTestResultEntryAsync(requestguid!);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error loading test entry: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveResults()
    {
        if (entryModel == null || !entryModel.results.Any()) return;

        try
        {
            isSaving = true;
            StateHasChanged();

            var saveRequest = new LabResultSaveRequest
            {
                lab_result_master = new lab_result_master
                {
                    requestguid = Guid.TryParse(requestguid, out var g) ? g : null,
                    resultdatetime = DateTime.Now,
                    approvalstatus = true
                }
            };

            foreach (var r in entryModel.results)
            {
                saveRequest.lab_result_details.Add(new LabResultDetailsModel
                {
                    tcode = r.tcode,
                    enteredresult = r.enteredresult,
                    resultguid = Guid.TryParse(requestguid, out var reqG) ? reqG : null,
                    testresultid = r.testresultid
                });
            }

            var success = await ResultService.SaveResultEntryAsync(saveRequest);
            if (success)
            {
                Toast.ShowSuccess("Test results saved successfully!");
                Navigation.NavigateTo("/result-search");
            }
            else
            {
                Toast.ShowError("Failed to save test results. Please try again.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error saving results: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/result-search");
    }
}
