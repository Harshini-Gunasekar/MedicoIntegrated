    private void OnTestSearchInputChanged(ChangeEventArgs e)
    {
        testNameSearch = e.Value?.ToString() ?? "";
        testSearchResults.Clear();
        
        ApplyFilters();

        testSearchDebounceTokenSource?.Cancel();
        testSearchDebounceTokenSource = new CancellationTokenSource();

        if (string.IsNullOrWhiteSpace(testNameSearch))
        {
            StateHasChanged();
            return;
        }

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(300, testSearchDebounceTokenSource.Token);
                await SearchTests();
            }
            catch (TaskCanceledException) { }
        });
    }

    private async Task SearchTests()
    {
        if (string.IsNullOrWhiteSpace(testNameSearch))
        {
            testSearchResults.Clear();
            StateHasChanged();
            return;
        }

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, 
                $"api/Test/get?testname={Uri.EscapeDataString(testNameSearch)}");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var res = await ClientFactory.CreateClient("Medico").SendAsync(request);
            if (res.IsSuccessStatusCode)
            {
                var content = await res.Content.ReadAsStringAsync();
                testSearchResults = JsonConvert.DeserializeObject<List<Test_Master>>(content) ?? new();
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error searching tests: {ex.Message}") */;
            testSearchResults.Clear();
        }
        StateHasChanged();
    }

