            // Index bills
            var billsByGuid = new Dictionary<string, HmsBillSummary>(StringComparer.OrdinalIgnoreCase);
            var billsByBillNo = new Dictionary<string, HmsBillSummary>(StringComparer.OrdinalIgnoreCase);
            var billsByOpVisit = new Dictionary<string, HmsBillSummary>(StringComparer.OrdinalIgnoreCase);
            var billsByMobile = new Dictionary<string, HmsBillSummary>(StringComparer.OrdinalIgnoreCase);

