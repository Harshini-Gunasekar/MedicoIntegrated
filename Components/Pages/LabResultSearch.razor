    private CancellationTokenSource? _globalSearchCts;
    private CancellationTokenSource? _searchResultsCts;

    private async Task OnGlobalSearchInput(ChangeEventArgs e)
    {
        globalSearch = e.Value?.ToString() ?? "";
        _globalSearchCts?.Cancel();
        _globalSearchCts = new CancellationTokenSource();
        var token = _globalSearchCts.Token;

        try
        {
            await Task.Delay(250, token);
            if (!token.IsCancellationRequested)
            {
                ApplyFilters();
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    private async Task SearchResults()
    {
        _searchResultsCts?.Cancel();
        _searchResultsCts = new CancellationTokenSource();
        var token = _searchResultsCts.Token;

        try
        {
            isLoading = true;
            isPatientModalOpen = false;
            selectedRowIndex = -1;
            selectedTestDetails.Clear();
            StateHasChanged();

            string userAuthToken = this.token ?? "";
            string userTenantCode = !string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010";

            try {
                var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null)
                {
                    var user = userResult.Value;
                    if (!string.IsNullOrEmpty(user.TenantCode)) userTenantCode = user.TenantCode;
                    if (!string.IsNullOrEmpty(user.AuthToken))
                    {
                        userAuthToken = user.AuthToken;
                        this.token = user.AuthToken;
                    }
                }
            } catch {}

            var medicoClient = ClientFactory.CreateClient("Medico");

            var vrsUrl = $"api/labresult/viewresultsearch?fromdate={fromDate.ToString("yyyy-MM-dd")}&todate={toDate.ToString("yyyy-MM-dd")}";
            var vrsReq = new HttpRequestMessage(HttpMethod.Get, vrsUrl);
            if (!string.IsNullOrEmpty(userTenantCode)) vrsReq.Headers.Add("tenant_code", userTenantCode);
            if (!string.IsNullOrEmpty(userAuthToken)) vrsReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", userAuthToken);
            if (branchID > 0) vrsReq.Headers.Add("bhcode", branchID.ToString());

            var testReq = new HttpRequestMessage(HttpMethod.Get, "api/Test/get");
            if (!string.IsNullOrEmpty(userTenantCode)) testReq.Headers.Add("tenant_code", userTenantCode);
            if (!string.IsNullOrEmpty(userAuthToken)) testReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", userAuthToken);

            var groupReq = new HttpRequestMessage(HttpMethod.Get, "api/GroupMaster/get");
            if (!string.IsNullOrEmpty(userTenantCode)) groupReq.Headers.Add("tenant_code", userTenantCode);
            if (!string.IsNullOrEmpty(userAuthToken)) groupReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", userAuthToken);

            var vrsTask = medicoClient.SendAsync(vrsReq, token);
            var testTask = medicoClient.SendAsync(testReq, token);
            var groupTask = medicoClient.SendAsync(groupReq, token);

            await Task.WhenAll(vrsTask, testTask, groupTask);

            var lockedTcodes = new HashSet<long>();
            try
            {
                var testRes = await testTask;
                if (testRes.IsSuccessStatusCode)
                {
                    var testJson = await testRes.Content.ReadAsStringAsync(token);
                    var tests = JsonConvert.DeserializeObject<List<Booking.Models.TestMasterModel>>(testJson);
                    if (tests != null)
                    {
                        lockedTcodes = tests.Where(t => t.lockresult)
                                            .Select(t => (long)t.tcode)
                                            .ToHashSet();
                    }
                }
            }
            catch {}

            var treatmentGcodes = new HashSet<long>();
            try
            {
                var groupRes = await groupTask;
                if (groupRes.IsSuccessStatusCode)
                {
                    var groupJson = await groupRes.Content.ReadAsStringAsync(token);
                    var groups = JsonConvert.DeserializeObject<List<Booking.Models.GroupMasterModel>>(groupJson);
                    if (groups != null)
                    {
                        treatmentGcodes = groups.Where(g => g.istreatment == true)
                                                .Select(g => (long)g.gcode)
                                                .ToHashSet();
                    }
                }
            }
            catch {}

            var vrsRes = await vrsTask;
            if (vrsRes.IsSuccessStatusCode && !token.IsCancellationRequested)
            {
                var vrsJson = await vrsRes.Content.ReadAsStringAsync(token);
                var vrsList = JsonConvert.DeserializeObject<List<ViewResultSearch>>(vrsJson);
                if (vrsList != null)
                {
                    var filteredVrsList = vrsList.Where(item => {
                        if (!string.IsNullOrWhiteSpace(item.tcode))
                        {
                            var clean = item.tcode.Replace("T-", "").Trim();
                            if (long.TryParse(clean, out long tc) && lockedTcodes.Contains(tc))
                                return false;
                        }
                        if (item.gcode.HasValue && treatmentGcodes.Contains((long)item.gcode.Value))
                            return false;
                        return true;
                    }).ToList();

                    int sno = 1;
                    foreach (var item in filteredVrsList)
                    {
                        item.requestsno = sno++;
                    }
                    allResults = filteredVrsList;
                }
                else
                {
                    allResults = new List<ViewResultSearch>();
                }
            }
            else
            {
                allResults = new List<ViewResultSearch>();
            }

            ApplyFilters();
            if (filteredResults.Any())
            {
                SelectRow(0, filteredResults[0]);
            }
            await InvokeAsync(StateHasChanged);
            
            // Hydrate result details in background if necessary
            _ = HydrateResultsWithEntryDataAsync(allResults);
        }
        catch (TaskCanceledException) { }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading lab result search: {ex.Message}");
            allResults = new List<ViewResultSearch>();
            ApplyFilters();
        }
        finally
        {
            if (token == _searchResultsCts?.Token)
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private void ApplyFilters()
    {
        var filtered = allResults.AsEnumerable();

        // Note: gcode restriction removed from worklist view.
        // All billed records are visible in Result Search for navigation.
        // Dept-based access control only applies inside Result Entry when entering results.

        // Filter by date range
        filtered = filtered.Where(x => x.requestdatetime.Date >= fromDate.Date && x.requestdatetime.Date <= toDate.Date);

        // Filter by doctor
        if (selectedDoctorCode != 0)
        {
            filtered = filtered.Where(x => x.dcode == selectedDoctorCode);
        }

        if (branchID != 0)
        {
            filtered = filtered.Where(x => x.enteredbhcode == branchID);
        }

        if (!string.IsNullOrWhiteSpace(globalSearch))
        {
            var searchLower = globalSearch.ToLower();
            filtered = filtered.Where(x => 
                (x.name ?? "").ToLower().Contains(searchLower) ||
                (x.custcode ?? "").ToLower().Contains(searchLower) ||
                (x.requestsno.ToString()).Contains(searchLower) ||
                (x.billnoprint ?? "").ToLower().Contains(searchLower) ||
                (x.mobile ?? "").Contains(searchLower) ||
                (x.testshortname ?? "").ToLower().Contains(searchLower) ||
                (x.testname ?? "").ToLower().Contains(searchLower)
            );
        }

        if (mainDept == "Lab")
            filtered = filtered.Where(x => x.isscan != true); // Show everything except explicit Scans in Lab dept
        else if (mainDept == "Scan")
            filtered = filtered.Where(x => x.isscan == true);

        if (reportType == "Lab")
            filtered = filtered.Where(x => x.isculture != true && x.isscan != true); // More permissive Lab view
        else if (reportType == "Culture")
            filtered = filtered.Where(x => x.isculture == true);
        else if (reportType == "Scan")
            filtered = filtered.Where(x => x.isscan == true);

        if (!string.IsNullOrEmpty(sidFrom) && int.TryParse(sidFrom, out int sFrom))
            filtered = filtered.Where(x => x.requestsno >= sFrom);
        if (!string.IsNullOrEmpty(sidTo) && int.TryParse(sidTo, out int sTo))
            filtered = filtered.Where(x => x.requestsno <= sTo);

        if (!string.IsNullOrWhiteSpace(patientSearch))
            filtered = filtered.Where(x => (x.name ?? "").ToLower().Contains(patientSearch.ToLower()));

        if (!string.IsNullOrWhiteSpace(mobileSearch))
            filtered = filtered.Where(x => (x.mobile ?? "").Contains(mobileSearch));

        if (!string.IsNullOrWhiteSpace(pathologyNo))
            filtered = filtered.Where(x => (x.billnoprint ?? "").Contains(pathologyNo));

        if (!string.IsNullOrWhiteSpace(testNameSearch))
        {
            var tSearch = testNameSearch.ToLower().TrimEnd('.');
            filtered = filtered.Where(x => 
                (x.testshortname ?? "").ToLower().Contains(tSearch) || 
                (x.testname ?? "").ToLower().Contains(tSearch)
            );
        }

        if (resultStatus == "Finished")
            filtered = filtered.Where(x => IsRecordFinished(x));
        else if (resultStatus == "Pending")
            filtered = filtered.Where(x => !IsRecordFinished(x));

        // Filter by payment status (balance <= 0 or unbilled check)
        if (paymentStatus == "Paid")
            filtered = filtered.Where(x => IsRecordBilled(x));
        else if (paymentStatus == "Unpaid")
            filtered = filtered.Where(x => !IsRecordBilled(x));

        filteredResults = filtered
            .OrderByDescending(x => x.is_emergency == true)
            .ThenByDescending(x => x.requestdatetime)
            .ThenByDescending(x => x.requestsno)
            .ToList();
    }

    private bool IsRecordPending(ViewResultSearch item)
    {
        return !IsRecordFinished(item);
    }

    private bool IsRecordBilled(ViewResultSearch item)
    {
        if (item == null) return false;
        if (item.billstatus == 1 || item.is_billed == true) return true;

        string key1 = item.requestguid.ToString();
        string key2 = item.opvisitid ?? "";
        string key3 = item.custcode ?? "";

        if (!string.IsNullOrEmpty(key1) && unbilledStatusDict.TryGetValue(key1, out bool st1)) return st1;
        if (!string.IsNullOrEmpty(key2) && unbilledStatusDict.TryGetValue(key2, out bool st2)) return st2;
        if (!string.IsNullOrEmpty(key3) && unbilledStatusDict.TryGetValue(key3, out bool st3)) return st3;

        return item.balance <= 0;
    }

    private bool IsRecordFinished(ViewResultSearch item)
    {
        if (item == null) return false;
        if (item.resultstatus == true || 
               item.isauthorized1 == true || 
               item.isauthorized2 == true || 
               item.requestresultstatus == true || 
               item.isentered == true || 
               (item.enteredresultcount.HasValue && item.enteredresultcount.Value > 0) ||
               item.status == 1 ||
               (item.status.HasValue && item.status.Value > 0))
        {
            return true;
        }

        if (item.requestguid != Guid.Empty && hydrationFinishedCache.TryGetValue(item.requestguid.ToString(), out bool f1) && f1) return true;
        if (!string.IsNullOrEmpty(item.opvisitid) && hydrationFinishedCache.TryGetValue(item.opvisitid, out bool f2) && f2) return true;
        if (!string.IsNullOrEmpty(item.custcode) && hydrationFinishedCache.TryGetValue(item.custcode, out bool f3) && f3) return true;

        return false;
    }

    private string GetRecordStatus(ViewResultSearch item)
    {
        bool pending = IsRecordPending(item);
        if (pending) return "Pending";
        return "Finished";
    }

    private string GetFormattedPatientName(ViewResultSearch item)
    {
        if (item == null) return "Unknown Patient";
        string rawName = item.name ?? "";

        // If rawName contains age/sex suffix e.g. "MANIKANDAN-44 Yrs/M" or "SANDHYA-/F"
        int dashIdx = rawName.LastIndexOf('-');
        if (dashIdx > 0)
        {
            string nameOnly = rawName.Substring(0, dashIdx).Trim();
            if (!string.IsNullOrWhiteSpace(nameOnly))
                return nameOnly;
        }

        if (!string.IsNullOrWhiteSpace(rawName) && !rawName.StartsWith("-"))
            return rawName.Trim();

        if (!string.IsNullOrWhiteSpace(item.custcode))
            return item.custcode;

        return $"Case #{item.requestsno}";
    }

    private string GetFormattedPatientMeta(ViewResultSearch item)
    {
        if (item == null) return "";
        string rawName = item.name ?? "";
        string parsedAge = item.age ?? "";
        string parsedSex = item.sex ?? "";

        // Extract age and sex embedded in rawName e.g. "MANIKANDAN-44 Yrs/M" or "SANDHYA-/F"
        int dashIdx = rawName.LastIndexOf('-');
        if (dashIdx >= 0 && dashIdx < rawName.Length - 1)
        {
            string suffix = rawName.Substring(dashIdx + 1).Trim();
            var parts = suffix.Split('/');
            if (parts.Length > 0 && (string.IsNullOrWhiteSpace(parsedAge) || parsedAge == "0"))
            {
                string agePart = parts[0].Replace("Yrs", "").Replace("Yr", "").Replace("Y", "").Trim();
                if (!string.IsNullOrWhiteSpace(agePart))
                    parsedAge = agePart;
            }
            if (parts.Length > 1 && string.IsNullOrWhiteSpace(parsedSex))
            {
                parsedSex = parts[1].Trim();
            }
        }

        string ageStr = (!string.IsNullOrWhiteSpace(parsedAge) && parsedAge != "0") ? $"{parsedAge} Y" : "";
        string sexStr = (parsedSex == "M" || parsedSex == "Male") ? "MALE" : ((parsedSex == "F" || parsedSex == "Female") ? "FEMALE" : parsedSex);

        if (!string.IsNullOrEmpty(ageStr) && !string.IsNullOrEmpty(sexStr))
            return $"{ageStr} / {sexStr}";
        if (!string.IsNullOrEmpty(ageStr))
            return ageStr;
        if (!string.IsNullOrEmpty(sexStr))
            return sexStr;

        return "";
    }


