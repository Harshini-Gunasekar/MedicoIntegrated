                                if (!string.IsNullOrWhiteSpace(cs.ip_id) && !csByGuid.ContainsKey(cs.ip_id.Trim()))
                                    csByGuid[cs.ip_id.Trim()] = cs;
                                if (!string.IsNullOrWhiteSpace(cs.mobile) && !csByMobile.ContainsKey(cs.mobile.Trim()))
                                    csByMobile[cs.mobile.Trim()] = cs;
                            }
                        }
                    }
                }
                catch { }
            }

            // Hydrate each item
            foreach (var item in results)
            {
                string rGuid = item.requestguid.HasValue ? item.requestguid.Value.ToString() : "";
                string opVis = item.opvisitid ?? "";
                string billNo = item.billnoprint ?? "";
                string mob = item.mobile ?? "";

                HmsBillSummary? matchedBill = null;
                if (!string.IsNullOrEmpty(rGuid) && billsByGuid.TryGetValue(rGuid, out var b1)) matchedBill = b1;
                else if (!string.IsNullOrEmpty(opVis) && billsByOpVisit.TryGetValue(opVis, out var b2)) matchedBill = b2;
                else if (!string.IsNullOrEmpty(billNo) && billsByBillNo.TryGetValue(billNo, out var b3)) matchedBill = b3;
                else if (!string.IsNullOrEmpty(mob) && billsByMobile.TryGetValue(mob, out var b4)) matchedBill = b4;

                if (matchedBill != null)
                {
                    if (!string.IsNullOrWhiteSpace(matchedBill.patient_name) && (string.IsNullOrWhiteSpace(item.name) || item.name.Trim().StartsWith("-")))
                    {
                        item.name = matchedBill.patient_name.Trim();
                    }
                    if (string.IsNullOrWhiteSpace(item.custcode))
                    {
                        if (matchedBill.custid.HasValue && matchedBill.custid.Value > 0)
                            item.custcode = $"CUST-{matchedBill.custid.Value}";
                        else if (!string.IsNullOrWhiteSpace(matchedBill.opvisitid))
                            item.custcode = matchedBill.opvisitid.Trim();
                    }
                    if (string.IsNullOrWhiteSpace(item.mobile) && !string.IsNullOrWhiteSpace(matchedBill.mobileno))
                    {
                        item.mobile = matchedBill.mobileno.Trim();
                    }
                    if (string.IsNullOrWhiteSpace(item.sex) && !string.IsNullOrWhiteSpace(matchedBill.gender))
                    {
                        item.sex = matchedBill.gender.Trim();
                    }
                    if (string.IsNullOrWhiteSpace(item.age) && !string.IsNullOrWhiteSpace(matchedBill.ageyears))
                    {
                        item.age = matchedBill.ageyears.Trim();
                    }
                    if (string.IsNullOrWhiteSpace(item.billnoprint) && !string.IsNullOrWhiteSpace(matchedBill.bill_no))
                    {
                        item.billnoprint = matchedBill.bill_no.Trim();
                    }
                    if (string.IsNullOrWhiteSpace(item.doctorfullname) && !string.IsNullOrWhiteSpace(matchedBill.doctor_name))
                    {
                        item.doctorfullname = matchedBill.doctor_name.Trim();
                        if (string.IsNullOrWhiteSpace(item.doctor)) item.doctor = matchedBill.doctor_name.Trim();
                    }
                }

                // Check OP Registrations fallback
                if (string.IsNullOrWhiteSpace(item.name) || item.name.Trim().StartsWith("-"))
                {
                    OPRegistrationModel.OpRegistrationModel? matchedOp = null;
                    if (!string.IsNullOrEmpty(rGuid) && (opsByOpId.TryGetValue(rGuid, out var op1) || opsByBookingId.TryGetValue(rGuid, out op1))) matchedOp = op1;
                    else if (!string.IsNullOrEmpty(opVis) && opsByOpNo.TryGetValue(opVis, out var op2)) matchedOp = op2;
                    else if (!string.IsNullOrEmpty(mob) && opsByMobile.TryGetValue(mob, out var op3)) matchedOp = op3;

                    if (matchedOp != null && !string.IsNullOrWhiteSpace(matchedOp.patient_name))
                    {
                        item.name = matchedOp.patient_name.Trim();
                        if (string.IsNullOrWhiteSpace(item.custcode))
                            item.custcode = matchedOp.op_no ?? (matchedOp.custid > 0 ? $"CUST-{matchedOp.custid}" : "");
                        if (string.IsNullOrWhiteSpace(item.mobile) && !string.IsNullOrWhiteSpace(matchedOp.mobile))
                            item.mobile = matchedOp.mobile.Trim();
                        if (string.IsNullOrWhiteSpace(item.doctorfullname) && !string.IsNullOrWhiteSpace(matchedOp.doctor_name))
                        {
                            item.doctorfullname = matchedOp.doctor_name.Trim();
                            if (string.IsNullOrWhiteSpace(item.doctor)) item.doctor = matchedOp.doctor_name.Trim();
                        }
                    }
                }

                // Check CaseSheet fallback
                if (string.IsNullOrWhiteSpace(item.name) || item.name.Trim().StartsWith("-"))
                {
                    CaseSheetInvestigationAllDto? matchedCs = null;
                    if (!string.IsNullOrEmpty(rGuid) && csByGuid.TryGetValue(rGuid, out var cs1)) matchedCs = cs1;
                    else if (!string.IsNullOrEmpty(mob) && csByMobile.TryGetValue(mob, out var cs2)) matchedCs = cs2;

                    if (matchedCs != null && !string.IsNullOrWhiteSpace(matchedCs.patient_name))
                    {
                        item.name = matchedCs.patient_name.Trim();
                        if (string.IsNullOrWhiteSpace(item.custcode))
                            item.custcode = matchedCs.custcode ?? (!string.IsNullOrEmpty(matchedCs.op_id) ? matchedCs.op_id : "");
                        if (string.IsNullOrWhiteSpace(item.mobile) && !string.IsNullOrWhiteSpace(matchedCs.mobile))
                            item.mobile = matchedCs.mobile.Trim();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[HydrateResultsWithPatientDataAsync] Notice: {ex.Message}");
        }
    }


