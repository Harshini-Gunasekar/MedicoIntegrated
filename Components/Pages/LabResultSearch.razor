    private async Task LoadBranchesAsync()
    {
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/Branch/get");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            // Add tenant_code header
            try {
                var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null && !string.IsNullOrEmpty(userResult.Value.TenantCode))
                    request.Headers.Add("tenant_code", userResult.Value.TenantCode);
            } catch {}

            var res = await ClientFactory.CreateClient("LabCareUrl").SendAsync(request);
            if (res.IsSuccessStatusCode)
            {
                var list = await res.Content.ReadFromJsonAsync<List<Branch_Master>>() ?? new();
                if (list.Any())
                {
                    var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                    var authorizedCodes = GetAuthorizedBranchCodes(userResult.Success ? userResult.Value : null);
                    if (authorizedCodes.Count > 0)
                    {
                        branches = list.Where(b => authorizedCodes.Contains(b.bhcode)).ToList();
                    }
                    else
                    {
                        branches = list;
                    }
                    
                    if (!branches.Any(b => b.bhcode == 0))
                        branches.Insert(0, new Branch_Master { bhcode = 0, name = "All Branches" });
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading branches: {ex.Message}") */;
        }
    }

