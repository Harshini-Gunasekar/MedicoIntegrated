    private static bool IsTokenEntered(Newtonsoft.Json.Linq.JToken? t)
    {
        if (t == null) return false;

        if (t is Newtonsoft.Json.Linq.JObject jobj)
        {
            foreach (var prop in jobj.Properties())
            {
                string name = prop.Name.ToLower();
                string val = prop.Value?.ToString()?.Trim() ?? "";

                if (name == "isauthorized1" || name == "isauthorized2" || name == "isauthorized" || 
                    name == "approvalstatus" || name == "isentered" || name == "resultstatus")
                {
                    var str = val.ToLower();
                    if (str == "true" || str == "1" || str == "completed" || str == "finished" || str == "authorized" || str == "saved" || str == "entered" || str == "approved")
                        return true;
                }

                if (name == "enteredresult" || name == "entered_result" || name == "result_value" || name == "resultvalue")
                {
                    if (!string.IsNullOrWhiteSpace(val) && val != "-")
                        return true;
                }

                if (name == "resultenteredby" || name == "resultauthorizedby" || name == "resultauthorizedby2")
                {
                    if (int.TryParse(val, out int numVal) && numVal > 0)
                        return true;
                }

                if (prop.Value is Newtonsoft.Json.Linq.JArray childArr)
                {
                    if (childArr.Any(child => IsTokenEntered(child)))
                        return true;
                }
                else if (prop.Value is Newtonsoft.Json.Linq.JObject childObj)
                {
                    if (IsTokenEntered(childObj))
                        return true;
                }
            }
        }
        else if (t is Newtonsoft.Json.Linq.JArray jarr)
        {
            return jarr.Any(child => IsTokenEntered(child));
        }

        return false;
    }

    private async Task LoadUnbilledStatusAsync()
    {
        var targetList = (filteredResults != null && filteredResults.Any()) ? filteredResults : allResults;
        if (targetList == null || !targetList.Any()) return;

        try
        {
            var unpaidKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            bool unbilledFetched = false;

            // 1. Fetch all unbilled charges across system
            try
            {
                var unbilledList = await HmsBillingService.GetAllUnbilledChargesAsync();
                if (unbilledList != null)
                {
                    unbilledFetched = true;
                    foreach (var charge in unbilledList)
                    {
                        if (charge.billedstatus != true)
                        {
                            if (!string.IsNullOrWhiteSpace(charge.opvisitid))
                                unpaidKeys.Add(charge.opvisitid);

                            if (charge.custid.HasValue && charge.custid.Value > 0)
                                unpaidKeys.Add(charge.custid.Value.ToString());

                            if (!string.IsNullOrWhiteSpace(charge.entryid))
                                unpaidKeys.Add(charge.entryid);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error fetching all unbilled charges: {ex.Message}");
            }

            // 2. Fallback query by-visit only if global unbilled query failed
            if (!unbilledFetched)
            {
                var distinctOpVisitIds = targetList
                    .SelectMany(x => new[] { x.opvisitid, x.requestguid != Guid.Empty ? x.requestguid.ToString() : null })
                    .Where(id => !string.IsNullOrWhiteSpace(id) && Guid.TryParse(id, out _))
                    .Distinct()
                    .ToList();

                if (distinctOpVisitIds.Any())
                {
                    var tasks = distinctOpVisitIds.Select(async visitId =>
                    {
                        try
                        {
                            var charges = await HmsBillingService.GetUnbilledChargesByVisitAsync(opvisitid: visitId);
                            if (charges != null && charges.Any(c => c.billedstatus != true))
                            {
                                lock (unpaidKeys)
                                {
                                    unpaidKeys.Add(visitId!);
                                }
                            }
                        }
                        catch { }
                    });

                    await Task.WhenAll(tasks);
                }
            }

            // 3. Populate unbilledStatusDict (key maps to false if UNPAID, true if PAID)
            unbilledStatusDict.Clear();
            foreach (var key in unpaidKeys)
            {
                unbilledStatusDict[key] = false; // false = UNPAID
            }

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private void AttachHeaders(HttpRequestMessage request)
    {
        if (request == null) return;
        try
        {
