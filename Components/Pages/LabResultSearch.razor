@page "/lab-result-search"
@using System.Text.Json.Serialization
@using Dapper.Contrib.Extensions
@using SharedComponents.Rcl.Models
@using UserDetailsModel = SharedComponents.Rcl.Models.UserDetailsModel;
@using LIMS_Backend.Model
@using ResultEntryModel = medico_backend.Model.ResultEntryModel;
@rendermode @(new InteractiveServerRenderMode(prerender:false))

@using LabCare.Models
@using Booking.Models
@using Newtonsoft.Json
@using System.Net.Http.Headers
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject ProtectedSessionStorage _sessionStorage
@inject Booking.Services.ToastService Toast
@inject TenantSessionState TenantState
@inject Booking.Services.HmsBillingService HmsBillingService

<PageTitle>Result Search - LIMS</PageTitle>

<style>
    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }
    :global(.main-content):has(.re-container) {
        padding: 0.5rem 0.75rem !important;
        min-height: auto !important;
        height: calc(100vh - 56px) !important;
        overflow: hidden !important;
    }

    .re-container {
        padding: 8px 12px 10px;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #1e293b;
        background: #f8fafc;
        height: 100%;
        max-height: calc(100vh - 56px);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 8px;
        overflow: hidden;
    }

    .re-header-section {
        background: linear-gradient(135deg, #1e293b, #334155);
        border-radius: 20px;
        padding: 20px 24px;
        border: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
        color: white;
    }

    .re-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
    }

    .re-breadcrumb i {
        color: #6366f1;
    }

    .re-header-main {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .re-patient-info {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .re-avatar {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: #fff;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
        box-shadow: 0 4px 10px rgba(99, 102, 241, 0.2);
    }

    .re-patient-name {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--lc-secondary);
        margin: 0;
    }

    .re-patient-meta {
        font-size: 0.8rem;
        color: #64748b;
        margin: 0;
    }

    .re-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    .re-card-header {
        padding: 12px 18px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        background: #fafbff;
    }

    .re-card-title {
        font-size: 0.85rem;
        font-weight: 750;
        color: #1e293b;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .re-grid-search {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 16px;
        align-items: flex-end;
    }

    .re-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .re-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .re-label {
        font-size: 0.62rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-bottom: 1px;
    }

    .re-input, .re-select {
        height: 30px;
        padding: 0 10px;
        border-radius: 8px;
        border: 1.5px solid #e2e8f0;
        font-size: 0.78rem;
        color: #1e293b;
        background: #fff;
        transition: all 0.2s ease;
        outline: none;
        width: 100%;
    }

    .re-input:focus, .re-select:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        background: #fff;
    }

    .re-pill-group {
        display: flex;
        gap: 2px;
        background: #f1f5f9;
        padding: 2px;
        border-radius: 6px;
        width: fit-content;
    }

    .re-pill {
        padding: 3px 10px;
        border-radius: 6px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #64748b;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
    }

    .re-pill.active {
        background: #fff;
        color: #4f46e5;
        box-shadow: 0 2px 4px -1px rgba(99, 102, 241, 0.1);
        border-color: #e2e8f0;
    }

    .re-pill:hover:not(.active) {
        color: #475569;
        background: #e2e8f0;
    }

    .re-pill input { display: none; }

    .re-btn-primary {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: #fff !important;
        border: none;
        height: 30px;
        padding: 0 16px;
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        box-shadow: 0 4px 10px -2px rgba(99, 102, 241, 0.3);
        transition: all 0.2s ease;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .re-btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 12px -2px rgba(99, 102, 241, 0.4);
        filter: brightness(1.05);
    }

    .re-btn-primary:active {
        transform: translateY(0);
    }

    .re-btn-secondary {
        background: #fff;
        color: #64748b;
        border: 1.5px solid #e2e8f0;
        height: 30px;
        padding: 0 14px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }

    .re-btn-secondary:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
    }

    .re-table-container {
        width: 100%;
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: auto;
    }

    .re-table {
        width: 100%;
        border-collapse: collapse;
    }

    .re-table th {
        padding: 6px 12px;
        text-align: left;
        font-size: 0.72rem;
        font-weight: 800;
        color: white !important;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: linear-gradient(135deg, #1e293b, #334155) !important;
        border: none;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .re-table td {
        padding: 5px 12px;
        font-size: 0.8rem;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
        font-weight: 500;
        transition: all 0.2s;
        vertical-align: middle;
    }

    .re-table tbody tr {
        height: 30px;
        transition: all 0.2s;
    }

    .re-table tbody tr:hover {
        background-color: #f8fafc;
        transform: scale(1.002);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
        z-index: 10;
        position: relative;
    }

    .re-row-selected {
        background: #eff6ff !important;
    }

    .re-badge {
        display: inline-flex;
        align-items: center;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
    }

    .re-badge-warning { background: #fef3c7; color: #b45309; }
    .re-badge-success { background: #dcfce7; color: #15803d; }
    .re-badge-info { background: #e0e7ff; color: #4338ca; }

    .re-content-layout {
        display: flex;
        gap: 12px;
        align-items: stretch;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }

    .re-main-panel {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }

    .re-side-panel {
        width: 320px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        max-height: 100%;
        overflow-y: auto;
        gap: 8px;
        position: static;
    }

    .re-empty-state {
        padding: 60px;
        text-align: center;
        color: #94a3b8;
    }

    .re-empty-icon {
        font-size: 3.5rem;
        margin-bottom: 16px;
        opacity: 0.15;
    }

    .re-search-input-wrap { position: relative; }

    .re-search-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        z-index: 100;
        max-height: 250px;
        overflow-y: auto;
    }

    .re-dropdown-item {
        padding: 10px 14px;
        cursor: pointer;
        border-bottom: 1px solid #f1f5f9;
        transition: background 0.2s;
    }

    .re-dropdown-item:hover { background: #f8fafc; }

    .re-item-primary { font-weight: 700; color: #1e293b; font-size: 0.85rem; }
    .re-item-secondary { font-size: 0.75rem; color: #64748b; }

    .re-filter-row {
        display: flex;
        gap: 32px;
        align-items: center;
        flex-wrap: wrap;
    }

    .re-select-minimal {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 4px 32px 4px 12px;
        font-size: 0.85rem;
        font-weight: 700;
        color: #4f46e5;
        cursor: pointer;
        outline: none;
        transition: all 0.2s;
        appearance: none;
        background-image: url("data:image/svg+xml,%3Csvg xmlns='ClientFactory.CreateClient("Medico")://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='%236366f1'%3E%3Cpath stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'%3E%3C/path%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 8px center;
        background-size: 16px;
        min-width: 140px;
        text-transform: uppercase;
    }

    .re-select-minimal:hover {
        border-color: #6366f1;
        background-color: #fff;
    }

    .re-action-group {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .re-entry-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f1f5f9;
        padding: 4px 8px;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
    }

    .re-entry-badge i {
        color: #6366f1;
        font-size: 0.9rem;
    }

    .re-table th {
        padding: 14px 16px;
        background: #f8fafc;
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 2px solid #f1f5f9;
    }

    .re-table td {
        padding: 14px 16px;
        vertical-align: middle;
    }

    .re-table tr:hover {
        background-color: #fcfdfe;
    }

    .re-patient-details h1 {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--lc-secondary);
        margin: 0;
    }

    .re-patient-meta {
        font-size: 0.85rem;
        color: #64748b;
        margin: 2px 0 0;
    }

    .re-grid-search .re-label {
        margin-bottom: 4px;
    }

    .re-btn-primary {
        font-size: 0.9rem;
        letter-spacing: 0.01em;
    }

    .re-badge {
        padding: 4px 12px;
        font-size: 0.7rem;
        letter-spacing: 0.02em;
    }

    .flex { display: flex; }
    .gap-2 { gap: 8px; }
    .flex-1 { flex: 1; }
    .w-full { width: 100%; }
    .mt-3 { margin-top: 12px; }
    .ml-auto { margin-left: auto; }
    .font-bold { font-weight: 700; }
    .font-semibold { font-weight: 600; }
    .font-medium { font-weight: 500; }
    .text-indigo-600 { color: #4f46e5; }

    /* Dark Mode Overrides for LabResultSearch */
    :host-context([data-theme="dark"]) .re-container,
    [data-theme="dark"] .re-container {
        background: #0b0f19 !important;
        color: #f8fafc !important;
    }

    :host-context([data-theme="dark"]) .re-card,
    [data-theme="dark"] .re-card {
        background: #1e293b !important;
        border-color: #334155 !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4) !important;
    }

    :host-context([data-theme="dark"]) .re-card-header,
    [data-theme="dark"] .re-card-header {
        background: #1e293b !important;
        border-bottom-color: #334155 !important;
    }

    :host-context([data-theme="dark"]) .re-card-title,
    :host-context([data-theme="dark"]) .re-card-header h2,
    :host-context([data-theme="dark"]) .re-card-header h3,
    :host-context([data-theme="dark"]) .re-dropdown-item .re-item-primary,
    :host-context([data-theme="dark"]) .re-table td div,
    [data-theme="dark"] .re-card-title,
    [data-theme="dark"] .re-card-header h2,
    [data-theme="dark"] .re-card-header h3,
    [data-theme="dark"] .re-dropdown-item .re-item-primary,
    [data-theme="dark"] .re-table td div {
        color: #f8fafc !important;
    }

    :host-context([data-theme="dark"]) .re-input,
    :host-context([data-theme="dark"]) .re-select,
    :host-context([data-theme="dark"]) .re-search-dropdown,
    [data-theme="dark"] .re-input,
    [data-theme="dark"] .re-select,
    [data-theme="dark"] .re-search-dropdown {
        background: #0f172a !important;
        border-color: #334155 !important;
        color: #f8fafc !important;
    }

    :host-context([data-theme="dark"]) .re-pill-group,
    [data-theme="dark"] .re-pill-group {
        background: #0f172a !important;
        border: 1px solid #334155 !important;
    }

    :host-context([data-theme="dark"]) .re-pill,
    [data-theme="dark"] .re-pill {
        color: #94a3b8 !important;
    }

    :host-context([data-theme="dark"]) .re-pill.active,
    [data-theme="dark"] .re-pill.active {
        background: #4f46e5 !important;
        color: #ffffff !important;
        border-color: #4f46e5 !important;
    }

    :host-context([data-theme="dark"]) .re-pill:hover:not(.active),
    [data-theme="dark"] .re-pill:hover:not(.active) {
        background: #1e293b !important;
        color: #f8fafc !important;
    }

    :host-context([data-theme="dark"]) .re-btn-secondary,
    [data-theme="dark"] .re-btn-secondary {
        background: #0f172a !important;
        border-color: #334155 !important;
        color: #cbd5e1 !important;
    }

    :host-context([data-theme="dark"]) .re-table-container,
    [data-theme="dark"] .re-table-container {
        background: #1e293b !important;
    }

    :host-context([data-theme="dark"]) .re-table th,
    [data-theme="dark"] .re-table th {
        background: #0f172a !important;
        color: #38bdf8 !important;
    }

    :host-context([data-theme="dark"]) .re-table td,
    [data-theme="dark"] .re-table td {
        background: #1e293b !important;
        color: #cbd5e1 !important;
        border-bottom-color: #334155 !important;
    }

    :host-context([data-theme="dark"]) .re-table tbody tr:hover td,
    [data-theme="dark"] .re-table tbody tr:hover td {
        background: #0f172a !important;
    }

    :host-context([data-theme="dark"]) .re-row-selected td,
    [data-theme="dark"] .re-row-selected td {
        background: #1e1b4b !important;
        color: #f8fafc !important;
    }

    /* Status & Billing Badges */
    .re-status-badge, .re-bill-badge {
        font-size: 0.65rem;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 6px;
        text-transform: uppercase;
        display: inline-block;
        letter-spacing: 0.03em;
        transition: all 0.2s ease;
        text-align: center;
        white-space: nowrap;
    }

    .re-status-badge.pending {
        background: #fef3c7;
        color: #d97706;
        border: 1.5px solid #fcd34d;
    }

    .re-status-badge.finished {
        background: #f0fdf4;
        color: #16a34a;
        border: 1.5px solid #86efac;
    }

    .re-bill-badge.paid {
        background: #f0fdf4;
        color: #16a34a;
        border: 1.5px solid #86efac;
    }

    .re-bill-badge.unpaid {
        background: #fef2f2;
        color: #dc2626;
        border: 1.5px solid #fca5a5;
    }

    :host-context([data-theme="dark"]) .re-status-badge.pending,
    [data-theme="dark"] .re-status-badge.pending {
        background: rgba(245, 158, 11, 0.2) !important;
        color: #fbbf24 !important;
        border-color: #b45309 !important;
    }

    :host-context([data-theme="dark"]) .re-status-badge.finished,
    [data-theme="dark"] .re-status-badge.finished {
        background: rgba(16, 185, 129, 0.2) !important;
        color: #34d399 !important;
        border-color: #047857 !important;
    }

    :host-context([data-theme="dark"]) .re-bill-badge.paid,
    [data-theme="dark"] .re-bill-badge.paid {
        background: rgba(16, 185, 129, 0.2) !important;
        color: #34d399 !important;
        border-color: #047857 !important;
    }

    :host-context([data-theme="dark"]) .re-bill-badge.unpaid,
    [data-theme="dark"] .re-bill-badge.unpaid {
        background: rgba(239, 68, 68, 0.2) !important;
        color: #f87171 !important;
        border-color: #b91c1c !important;
    }

    /* Top Bar Component Styles */
    .re-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, #4f46e5, #3b82f6);
        border-radius: 14px;
        padding: 8px 18px;
        box-shadow: 0 6px 15px -3px rgba(59, 130, 246, 0.3);
        border: none;
        margin-bottom: 0;
        color: white;
        flex-shrink: 0;
    }

    .re-top-pill {
        position: relative;
        display: flex;
        align-items: center;
        border: 1.5px solid rgba(255, 255, 255, 0.25);
        border-radius: 20px;
        padding: 6px 16px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        font-size: 0.85rem;
        font-weight: 700;
        color: white;
    }

    .re-date-pill {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1.5px solid rgba(255, 255, 255, 0.25);
        border-radius: 20px;
        padding: 4px 6px 4px 18px;
        background: rgba(255, 255, 255, 0.15);
        font-size: 0.85rem;
        font-weight: 700;
        color: white;
    }

    .re-top-search-btn {
        border: none;
        background: white;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #4f46e5;
        margin-left: 8px;
        transition: all 0.2s;
    }

    /* Dark Mode Top Bar Overrides */
    :host-context([data-theme="dark"]) .re-top-bar,
    [data-theme="dark"] .re-top-bar {
        background: #1e293b !important;
        border: 1px solid #334155 !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4) !important;
        color: #f8fafc !important;
    }

    :host-context([data-theme="dark"]) .re-top-pill,
    :host-context([data-theme="dark"]) .re-date-pill,
    [data-theme="dark"] .re-top-pill,
    [data-theme="dark"] .re-date-pill {
        background: #0f172a !important;
        border-color: #334155 !important;
        color: #f8fafc !important;
    }

    :host-context([data-theme="dark"]) .re-clean-select,
    [data-theme="dark"] .re-clean-select {
        color: #f8fafc !important;
    }

    :host-context([data-theme="dark"]) .re-clean-select option,
    [data-theme="dark"] .re-clean-select option {
        background: #0f172a !important;
        color: #f8fafc !important;
    }

    :host-context([data-theme="dark"]) .re-top-bar input[type="date"],
    [data-theme="dark"] .re-top-bar input[type="date"] {
        color: #f8fafc !important;
        color-scheme: dark !important;
    }

    :host-context([data-theme="dark"]) .re-top-search-btn,
    [data-theme="dark"] .re-top-search-btn {
        background: #4f46e5 !important;
        color: #ffffff !important;
    }

    /* Centered Patient Details Modal Popup */
    .re-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        animation: reFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .re-modal-card {
        background: #ffffff;
        border-radius: 16px;
        width: 100%;
        max-width: 680px;
        max-height: 88vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        animation: reScaleUp 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .re-modal-header {
        padding: 14px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
    }

    .re-modal-close-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.15s ease;
    }

    .re-modal-close-btn:hover {
        background: #fee2e2;
        color: #ef4444;
        border-color: #fecaca;
    }

    .re-modal-body {
        padding: 16px 20px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 14px;
        flex: 1;
        min-height: 0;
    }

    @@keyframes reFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes reScaleUp {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }

    :host-context([data-theme="dark"]) .re-modal-card,
    [data-theme="dark"] .re-modal-card {
        background: #1e293b !important;
        border: 1px solid #334155 !important;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6) !important;
    }

    :host-context([data-theme="dark"]) .re-modal-header,
    [data-theme="dark"] .re-modal-header {
        background: #0f172a !important;
        border-bottom-color: #334155 !important;
    }

    :host-context([data-theme="dark"]) .re-modal-close-btn,
    [data-theme="dark"] .re-modal-close-btn {
        background: #1e293b !important;
        border-color: #334155 !important;
        color: #cbd5e1 !important;
    }

    :host-context([data-theme="dark"]) .re-modal-close-btn:hover,
    [data-theme="dark"] .re-modal-close-btn:hover {
        background: #7f1d1d !important;
        color: #f87171 !important;
        border-color: #991b1b !important;
    }
</style>

<div class="re-container">
    <DnaLoader IsLoading="@isLoading" Message="Searching worklist records..." />
    <!-- New Top Bar (Figma Style) -->
    <div class="re-top-bar">
        <div style="display: flex; gap: 16px; align-items: center;">
            <!-- Branch Selector -->
            <div class="re-top-pill">
                <i class="fas fa-map-marker-alt" style="margin-right: 8px; opacity: 0.8;"></i>
                <select class="re-clean-select" @bind="branchID" @bind:after="SearchResults" style="border: none; outline: none; background: transparent; font-weight: 700; color: inherit; font-size: 0.85rem; appearance: none; padding-right: 20px; cursor: pointer; min-width: 200px;">
                    @foreach (var b in branches)
                    {
                        <option value="@b.EffectiveBhcode">@b.name</option>
                    }
                </select>
                <i class="fas fa-chevron-down" style="position: absolute; right: 16px; font-size: 0.7rem; pointer-events: none; opacity: 0.7;"></i>
            </div>

            <!-- Filter Toggle -->
            <button class="re-top-pill" style="cursor: pointer; gap: 8px;" @onclick="ToggleFilter">
                <i class="fas fa-sliders-h" style="opacity: 0.8;"></i> Filter
            </button>
        </div>

        <!-- Date Range -->
        <div class="re-date-pill">
            <i class="far fa-calendar-alt"></i>
            <input type="date" @bind="fromDate" @bind:format="yyyy-MM-dd" style="border: none; outline: none; font-weight: 700; color: inherit; background: transparent; width: 110px;" />
            <span style="opacity: 0.5;">&rarr;</span>
            <i class="far fa-calendar-alt"></i>
            <input type="date" @bind="toDate" @bind:format="yyyy-MM-dd" style="border: none; outline: none; font-weight: 700; color: inherit; background: transparent; width: 110px;" />
            <button @onclick="SearchResults" class="re-top-search-btn">
                @if (isLoading)
                {
                    <i class="fas fa-circle-notch fa-spin"></i>
                }
                else
                {
                    <i class="fas fa-search"></i>
                }
            </button>
        </div>
    </div>

    <!-- Collapsible Advanced Filters -->
    @if (isFilterOpen)
    {
        <div class="re-card" style="margin-bottom: 0; flex-shrink: 0; animation: slideDown 0.2s ease-out;">
            <div class="re-card-body" style="padding: 12px 18px;">
                <div class="re-grid-3">
                    <div class="re-field" style="grid-column: span 3;">
                        <span class="re-label">Search Types</span>

                        <!-- Row 1: Dept / Type / Result Status / Payment — all on one line, wraps gracefully -->
                        <div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 8px;">

                            <div class="re-pill-group">
                                <span class="re-label" style="margin-right: 6px; align-self: center; white-space: nowrap;">Dept:</span>
                                <span class="re-pill @(mainDept == "Lab" ? "active" : "")" style="cursor: pointer;" @onclick='() => { mainDept = "Lab"; ApplyFilters(); }'>Lab</span>
                                <span class="re-pill @(mainDept == "Scan" ? "active" : "")" style="cursor: pointer;" @onclick='() => { mainDept = "Scan"; ApplyFilters(); }'>Scan</span>
                            </div>

                            <div style="width: 1px; height: 24px; background: #e2e8f0; align-self: center;"></div>

                            <div class="re-pill-group">
                                <span class="re-label" style="margin-right: 6px; align-self: center; white-space: nowrap;">Type:</span>
                                <span class="re-pill @(reportType == "Lab" ? "active" : "")" style="cursor: pointer;" @onclick='() => { reportType = "Lab"; ApplyFilters(); }'>Lab</span>
                                <span class="re-pill @(reportType == "Culture" ? "active" : "")" style="cursor: pointer;" @onclick='() => { reportType = "Culture"; ApplyFilters(); }'>Culture</span>
                                <span class="re-pill @(reportType == "Scan" ? "active" : "")" style="cursor: pointer;" @onclick='() => { reportType = "Scan"; ApplyFilters(); }'>Scan</span>
                            </div>

                            <div style="width: 1px; height: 24px; background: #e2e8f0; align-self: center;"></div>

                            <div class="re-pill-group">
                                <span class="re-label" style="margin-right: 6px; align-self: center; white-space: nowrap;">Status:</span>
                                <span class="re-pill @(resultStatus == "All" ? "active" : "")" style="cursor: pointer;" @onclick='() => { resultStatus = "All"; ApplyFilters(); }'>All</span>
                                <span class="re-pill @(resultStatus == "Pending" ? "active" : "")" style="cursor: pointer;" @onclick='() => { resultStatus = "Pending"; ApplyFilters(); }'>Pending</span>
                                <span class="re-pill @(resultStatus == "Finished" ? "active" : "")" style="cursor: pointer;" @onclick='() => { resultStatus = "Finished"; ApplyFilters(); }'>Finished</span>
                            </div>

                            <div style="width: 1px; height: 24px; background: #e2e8f0; align-self: center;"></div>

                            <div class="re-pill-group">
                                <span class="re-label" style="margin-right: 6px; align-self: center; white-space: nowrap;">Payment:</span>
                                <span class="re-pill @(paymentStatus == "All" ? "active" : "")" style="cursor: pointer;" @onclick='() => { paymentStatus = "All"; ApplyFilters(); }'>All</span>
                                <span class="re-pill @(paymentStatus == "Paid" ? "active" : "")" style="cursor: pointer;" @onclick='() => { paymentStatus = "Paid"; ApplyFilters(); }'>
                                    <i class="fas fa-check-circle" style="font-size: 0.65rem; margin-right: 3px;"></i>Paid
                                </span>
                                <span class="re-pill @(paymentStatus == "Unpaid" ? "active" : "")" style="cursor: pointer;" @onclick='() => { paymentStatus = "Unpaid"; ApplyFilters(); }'>
                                    <i class="fas fa-times-circle" style="font-size: 0.65rem; margin-right: 3px;"></i>Unpaid
                                </span>
                            </div>

                        </div>
                    </div>

                    <div class="re-field">
                        <span class="re-label">Case No (SID) Range</span>
                        <div class="flex gap-2">
                            <input type="text" class="re-input flex-1" placeholder="Start" @bind="sidFrom" />
                            <input type="text" class="re-input flex-1" placeholder="End" @bind="sidTo" />
                        </div>
                    </div>
                    <div class="re-field">
                        <span class="re-label">Pathology No</span>
                        <input type="text" class="re-input" placeholder="Path No" @bind="pathologyNo" />
                    </div>
                    <div class="re-field">
                        <span class="re-label">Patient Name</span>
                        <input type="text" class="re-input" placeholder="Search by name..." @bind="patientSearch" />
                    </div>
                    <div class="re-field">
                        <span class="re-label">Mobile Number</span>
                        <input type="text" class="re-input" placeholder="Search by mobile..." @bind="mobileSearch" />
                    </div>
                    <div class="re-field">
                        <span class="re-label">Test Name</span>
                        <div class="re-search-input-wrap">
                            <input type="text" class="re-input" placeholder="Enter test name..." @bind="testNameSearch" @oninput="OnTestSearchInputChanged" autocomplete="off" />
                            @if (testSearchResults.Any())
                            {
                                <div class="re-search-dropdown">
                                    @foreach (var t in testSearchResults)
                                    {
                                        <div class="re-search-item" @onclick="() => SelectTest(t)">
                                            <span class="re-item-name">@t.name</span>
                                            <span class="re-item-code">#@t.tcode</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="re-field">
                        <span class="re-label">Referred By</span>
                        <select class="re-select" @bind="selectedDoctorCode">
                            <option value="0">All Doctors</option>
                            @foreach (var d in doctors)
                            {
                                <option value="@d.dcode">@d.name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="re-filter-actions mt-4 flex justify-end" style="gap: 12px;">
                    <button class="re-btn-secondary" style="border: 1px solid #e2e8f0; padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 0.85rem;" @onclick="ClearFilters">
                        <i class="fas fa-undo mr-1"></i> Reset Filters
                    </button>
                    <button class="re-btn-primary" style="background: #4f46e5; color: white; padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 0.85rem; border: none;" @onclick="SearchResults">
                        <i class="fas fa-search mr-1"></i> Apply Filters
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Results Area -->
    <div class="re-content-layout">
        <div class="re-main-panel">
            <div class="re-card" style="border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.03); display: flex; flex-direction: column; height: 100%; overflow: hidden; border-radius: 12px;">
                <div class="re-card-header" style="border-bottom: none; padding: 6px 16px 4px; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <h2 style="margin: 0; font-size: 0.95rem; font-weight: 800; display: flex; align-items: center; gap: 8px; letter-spacing: 0.05em;">
                            <i class="fas fa-list-ul" style="color: #4f46e5;"></i> RESULT WORKLIST
                        </h2>
                        <span style="font-size: 0.72rem; font-weight: 800; padding: 3px 8px; border-radius: 10px; letter-spacing: 0.05em; margin-left: 4px;" class="re-badge-records">RECORDS: @filteredResults.Count</span>
                        <span style="font-size: 0.72rem; font-weight: 800; color: #d97706; background: #fef3c7; padding: 3px 8px; border-radius: 10px; letter-spacing: 0.05em;">@filteredResults.Count(x => IsRecordPending(x)) PENDING</span>
                    </div>
                    
                    <div style="position: relative;">
                        <i class="fas fa-search" style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.85rem;"></i>
                        <input type="text" placeholder="Search by patient, case no..." value="@globalSearch" @oninput="OnGlobalSearchInput" class="re-input" style="border: 1.5px solid #e2e8f0; border-radius: 20px; padding: 6px 14px 6px 36px; width: 260px; font-size: 0.85rem; outline: none; font-weight: 600; transition: border-color 0.2s;" />
                    </div>
                </div>

                <div class="re-table-container" style="flex: 1; min-height: 0; overflow-y: auto; overflow-x: auto; border-radius: 0 0 12px 12px;">
                    <table class="re-table" style="border-top: 1px solid #1e293b; width: 100%;">
                        <thead style="position: sticky; top: 0; z-index: 10;">
                            <tr>
                                <th>S.NO</th>
                                <th>CASE NO</th>
                                <th>DATE/TIME</th>
                                <th>REG</th>
                                <th>PATIENT NAME</th>
                                <th>REFERRED BY</th>
                                <th style="text-align: center;">STATUS</th>
                                <th style="text-align: center;">BILLING STATUS</th>
                                <th>PATH. NO</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (filteredResults.Any())
                            {
                                @for (int i = 0; i < filteredResults.Count; i++)
                                {
                                    var item = filteredResults[i];
                                    var idx = i;
                                    var isSelected = selectedRowIndex == idx;
                                    <tr class="@(isSelected ? "re-row-selected" : "")" style="cursor: pointer; @(isSelected ? "background: #f8fafc;" : "")" @onclick="@(() => OpenPatientModal(idx, item))" @ondblclick="@(() => NavigateToEntry(item))">
                                        <td style="color: #64748b; font-weight: 700;">@(idx + 1 < 10 ? $"0{idx+1}" : $"{idx+1}")</td>
                                        <td class="font-bold" style="color: #4f46e5; font-size: 0.9rem;">@item.requestsno</td>
                                        <td style="color: #64748b; font-weight: 600; font-size: 0.8rem;">@item.requestdatetime.ToString("dd-MMM-yyyy HH:mm")</td>
                                        <td class="font-semibold" style="color: #64748b; font-size: 0.85rem;">@item.custcode</td>
                                        <td>
                                            <div style="font-size: 0.95rem; font-weight: 800; color: #1e293b;">@GetFormattedPatientName(item)</div>
                                            @{
                                                var metaStr = GetFormattedPatientMeta(item);
                                            }
                                            <div style="font-size: 0.72rem; font-weight: 700; color: #64748b; margin-top: 3px; display: flex; align-items: center; gap: 8px;">
                                                @if (!string.IsNullOrEmpty(metaStr))
                                                {
                                                    <span>@metaStr</span>
                                                }
                                                @if (item.is_emergency == true)
                                                {
                                                    <span style="color: #ef4444; display: flex; align-items: center; gap: 4px; font-weight: bold; background: #fee2e2; padding: 2px 8px; border-radius: 4px; animation: pulse 1.5s infinite;">
                                                        <span style="width: 6px; height: 6px; background: #ef4444; border-radius: 50%;"></span>
                                                        EMERGENCY
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td style="color: #475569; font-weight: 600; font-size: 0.85rem;">@item.doctor</td>
                                        <td style="text-align: center;">
                                            @{
                                                var isPending = !IsRecordFinished(item);
                                            }
                                            <span class="re-status-badge @(isPending ? "pending" : "finished")">
                                                @(isPending ? "IN PROGRESS" : "FINISHED")
                                            </span>
                                        </td>
                                        <td style="text-align: center;">
                                            @{
                                                bool isBilled = IsRecordBilled(item);
                                            }
                                            <span class="re-bill-badge @(isBilled ? "paid" : "unpaid")">
                                                @(isBilled ? "PAID" : "UNPAID")
                                            </span>
                                        </td>
                                        <td style="color: #cbd5e1; font-weight: 600; font-size: 0.75rem;">@(string.IsNullOrEmpty(item.billnoprint) ? "PATH-2026-000" : item.billnoprint)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="re-empty-state">
                                        <div class="re-empty-icon"><i class="fas fa-flask"></i></div>
                                        <p>@(isLoading ? "Searching..." : "No results found. Adjust filters and try again.")</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@if (isPatientModalOpen && selectedRowIndex >= 0 && selectedRowIndex < filteredResults.Count)
{
    var currentItem = filteredResults[selectedRowIndex];
    <div class="re-modal-overlay" @onclick="ClosePatientModal">
        <div class="re-modal-card" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="re-modal-header">
                <div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="background: rgba(99, 102, 241, 0.1); color: #4f46e5; font-size: 0.75rem; font-weight: 800; padding: 2px 8px; border-radius: 6px;">CASE #@currentItem.requestsno</span>
                        <span class="re-status-badge @(!IsRecordFinished(currentItem) ? "pending" : "finished")">
                            @(!IsRecordFinished(currentItem) ? "IN PROGRESS" : "FINISHED")
                        </span>
                        <span class="re-bill-badge @(IsRecordBilled(currentItem) ? "paid" : "unpaid")">
                            @(IsRecordBilled(currentItem) ? "PAID" : "UNPAID")
                        </span>
                    </div>
                    <h3 style="margin: 4px 0 0 0; font-size: 1.1rem; font-weight: 800; color: #1e293b;">
                        @GetFormattedPatientName(currentItem)
                    </h3>
                    <div style="font-size: 0.78rem; color: #64748b; margin-top: 2px;">
                        @GetFormattedPatientMeta(currentItem) &bull; Ref by: <strong>@(string.IsNullOrWhiteSpace(currentItem.doctor) ? "Self" : currentItem.doctor)</strong>
                    </div>
                </div>
                <button class="re-modal-close-btn" @onclick="ClosePatientModal" title="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="re-modal-body">
                <div class="re-card" style="border: none; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
                    <div class="re-card-header" style="border-bottom: none; padding: 10px 14px 6px;">
                        <h3 class="re-card-title" style="margin: 0; font-size: 0.9rem; font-weight: 800; display: flex; align-items: center; gap: 8px; letter-spacing: 0.05em;">
                            <i class="fas fa-list-check" style="color: #4f46e5;"></i> ORDERED TESTS
                        </h3>
                    </div>
                    <div class="re-table-container" style="max-height: 220px; padding: 0 10px 10px;">
                        <table class="re-table re-table-sm" style="border: 1px solid #f1f5f9; border-radius: 8px; overflow: hidden; border-collapse: separate; border-spacing: 0; width: 100%;">
                            <thead>
                                <tr>
                                    <th style="width: 40px;">SEL</th>
                                    <th>TEST NAME</th>
                                    <th style="text-align: right;">STATUS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (isLoadingTests)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center p-4">
                                            <span class="re-spinner re-spinner-indigo"></span>
                                        </td>
                                    </tr>
                                }
                                else if (selectedTestDetails.Any())
                                {
                                    @foreach (var test in selectedTestDetails)
                                    {
                                        <tr>
                                            <td><input type="checkbox" @bind="test.isselected" /></td>
                                            <td class="font-medium">
                                                @test.testname
                                                @if (test.is_escalation == true)
                                                {
                                                    <span style="background-color: #fee2e2; color: #dc2626; padding: 2px 6px; border-radius: 4px; font-size: 0.65rem; font-weight: bold; margin-left: 8px; display: inline-flex; align-items: center; gap: 4px; border: 1px solid #fecaca;">
                                                        <i class="fas fa-exclamation-triangle" style="font-size: 0.65rem;"></i> ESCALATION
                                                    </span>
                                                }
                                            </td>
                                            <td style="text-align: right;">
                                                <span class="re-badge @(test.ispending ? "re-badge-warning" : "re-badge-success")">
                                                    @(test.ispending ? "Pending" : "Done")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center p-4 text-muted italic">No tests found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px; padding: 4px 10px 10px;">
                        <button class="re-btn-primary" style="background: #059669; flex: 1; min-width: 200px; font-size: 0.75rem; height: 32px; padding: 0 10px; border-radius: 6px; box-shadow: none; text-transform: uppercase; font-weight: 800; letter-spacing: 0.03em; border: none; color: white; cursor: pointer;">
                            PRINT BARCODE FOR SELECTED SAMPLES
                        </button>
                        <button class="re-btn-primary" style="flex: 1; min-width: 180px; font-size: 0.75rem; height: 32px; padding: 0 10px; border-radius: 6px; text-transform: uppercase; font-weight: 800; letter-spacing: 0.03em;" @onclick="@(() => NavigateToEntry(currentItem))">
                            <i class="fas fa-edit"></i> Open Result Entry
                        </button>
                        <div style="display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 12px; margin-top: 4px;">
                            <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: 0.78rem; font-weight: 700; color: #475569;" title="Toggle Letterhead (true/false) for report preview">
                                <input type="checkbox" @bind="isLetterhead" style="cursor: pointer; width: 15px; height: 15px; accent-color: #4f46e5;" />
                                <span>Letterhead: <strong style="color: @(isLetterhead ? "#16a34a" : "#dc2626");">@(isLetterhead ? "True" : "False")</strong></span>
                            </label>
                            @if (currentItem.isculture == true)
                            {
                                <button class="re-btn-primary" style="background: #8b5cf6; font-size: 0.75rem; height: 32px; padding: 0 16px; border-radius: 6px; box-shadow: none; text-transform: uppercase; font-weight: 800; letter-spacing: 0.03em; border: none; color: white; cursor: pointer;" @onclick="@(() => PreviewReportBase64($"report/culture-report?requestguid={currentItem.requestguid}&isletterhead={isLetterhead.ToString().ToLower()}"))" disabled="@isLoading">
                                    <i class="fas fa-eye"></i> Preview Culture Report
                                </button>
                            }
                            else
                            {
                                <button class="re-btn-primary" style="background: #4f46e5; font-size: 0.75rem; height: 32px; padding: 0 16px; border-radius: 6px; box-shadow: none; text-transform: uppercase; font-weight: 800; letter-spacing: 0.03em; border: none; color: white; cursor: pointer;" @onclick="@(() => PreviewReportBase64($"report/labreport?requestguid={currentItem.requestguid}&isletterhead={isLetterhead.ToString().ToLower()}"))" disabled="@isLoading">
                                    <i class="fas fa-eye"></i> Preview Lab Report
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <!-- Patient status flow tracker -->
                @if (isLoadingFlow)
                {
                    <div class="re-card" style="border: none; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); padding: 12px; text-align: center;">
