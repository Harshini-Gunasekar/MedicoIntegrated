    .re-pill-billing.re-billing-unpaid,
    .re-pill-billing.bill-unpaid {
        background: #fee2e2 !important;
        color: #b91c1c !important;
        border: none !important;
        border-radius: 9999px !important;
    }

    .re-pill-billing.re-billing-unpaid .re-billing-dot,
    .re-pill-billing.bill-unpaid .re-billing-dot {
        width: 5px !important;
        height: 5px !important;
        border-radius: 50% !important;
