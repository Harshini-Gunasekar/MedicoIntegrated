    private void SelectRow(int index, ViewResultSearch item)
    {
        if (item == null) return;
        selectedRowIndex = index;
        selectedTestDetails.Clear();
        isLoadingTests = true;
        StateHasChanged();

        try
        {
            // Collect all matching rows for this bill/request from allResults
            var testsForRequest = allResults
                .Where(x => (x.requestguid.HasValue && x.requestguid.Value != Guid.Empty && item.requestguid.HasValue && x.requestguid.Value == item.requestguid.Value) || 
                            (x.requestsno == item.requestsno && x.custcode == item.custcode))
                .ToList();

            if (!testsForRequest.Any())
            {
                testsForRequest.Add(item);
            }

            var seenNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var r in testsForRequest)
            {
                // Tests may be stored as comma-separated or semicolon-separated strings
                string combinedNames = !string.IsNullOrWhiteSpace(r.testname) ? r.testname : (r.groupname ?? "");
                var names = combinedNames
                    .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Where(s => !string.IsNullOrWhiteSpace(s))
                    .ToList();

                if (!names.Any() && !string.IsNullOrWhiteSpace(combinedNames))
                {
                    names.Add(combinedNames.Trim());
                }

                foreach (var tName in names)
                {
                    if (seenNames.Add(tName))
                    {
                        bool isCulture = tName.Contains("CULTURE", StringComparison.OrdinalIgnoreCase) || 
                                         (r.isculture == true) || 
                                         (r.groupname?.Contains("CULTURE", StringComparison.OrdinalIgnoreCase) == true);

                        bool isPending = r.resultstatus != true && r.isauthorized1 != true && r.isauthorized2 != true;

                        long tcodeVal = 0;
                        if (!string.IsNullOrWhiteSpace(r.tcode))
                        {
                            var cleanStr = r.tcode.Replace("T-", "").Trim();
                            long.TryParse(cleanStr, out tcodeVal);
                        }

                        // Exclude locked tests (lockresult == true) from checklist
                        if (tcodeVal > 0 && _cachedLockedTcodes?.Contains(tcodeVal) == true) continue;
                        if (_cachedLockedTestNames != null && _cachedLockedTestNames.Contains(tName)) continue;

                        selectedTestDetails.Add(new TestDetailItem
                        {
                            tcode = tcodeVal,
                            testname = tName,
                            gcode = r.gcode ?? 0,
                            groupname = r.groupname ?? "",
                            ispending = isPending,
                            isselected = true,
                            isculture = isCulture,
                            is_escalation = false
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading test details locally: {ex.Message}") */;
        }
        finally
        {
            isLoadingTests = false;
            StateHasChanged();
        }

        _ = LoadPatientStatusFlow(item);
    }

    private async Task LoadPatientStatusFlow(ViewResultSearch item)
    {
        if (item == null) return;
        Guid requestGuid = item.requestguid ?? Guid.Empty;
        if (requestGuid == Guid.Empty) return;

        isLoadingFlow = true;
        patientStatusFlow = null;
        StateHasChanged();
        try
        {
            string userToken = token;
            string effectiveTenant = "";
            try {
                var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null)
                {
                    if (string.IsNullOrEmpty(userToken)) userToken = userResult.Value.AuthToken ?? "";
                    if (!string.IsNullOrEmpty(userResult.Value.TenantCode)) effectiveTenant = userResult.Value.TenantCode;
                }
            } catch {}

            var client = ClientFactory.CreateClient("Medico");

            // 1. Fetch real PatientStatus workflow timeline (Billed, Collected, Received, Result, Authorized)
            try
            {
                var flowReq = new HttpRequestMessage(HttpMethod.Get, $"api/LabSampleCollection/loadpatientstatus?requestguid={requestGuid}");
                if (!string.IsNullOrEmpty(userToken)) flowReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", userToken);
                if (!string.IsNullOrEmpty(effectiveTenant)) flowReq.Headers.Add("tenant_code", effectiveTenant);

                var flowResp = await client.SendAsync(flowReq);
                if (flowResp.IsSuccessStatusCode)
                {
                    var flowJson = await flowResp.Content.ReadAsStringAsync();
                    patientStatusFlow = JsonConvert.DeserializeObject<PatientStatusDto>(flowJson);
                }
            }
            catch { }

            // 2. Fetch ResultEntryModel to enrich individual tests with exact tcode, gcode, groupname, and result status
            try
            {
                var entryReq = new HttpRequestMessage(HttpMethod.Get, $"api/LabResult/LoadResultEntry?requestguid={requestGuid}");
                if (!string.IsNullOrEmpty(userToken)) entryReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", userToken);
                if (!string.IsNullOrEmpty(effectiveTenant)) entryReq.Headers.Add("tenant_code", effectiveTenant);

                var entryResp = await client.SendAsync(entryReq);
                if (entryResp.IsSuccessStatusCode)
                {
                    var entryJson = await entryResp.Content.ReadAsStringAsync();
                    var entryModel = JsonConvert.DeserializeObject<ResultEntryModel>(entryJson);

                    if (entryModel?.results != null && entryModel.results.Any())
                    {
                        var groupedTests = entryModel.results
                            .Where(r => r.tcode > 0 && !string.IsNullOrWhiteSpace(r.testname))
                            .GroupBy(r => r.tcode)
                            .ToList();

                        if (groupedTests.Any())
                        {
                            var previousSelections = selectedTestDetails.ToDictionary(x => x.testname.Trim(), x => x.isselected, StringComparer.OrdinalIgnoreCase);

                            selectedTestDetails.Clear();
                            foreach (var grp in groupedTests)
                            {
                                var first = grp.First();
                                if (_cachedLockedTcodes?.Contains(first.tcode) == true) continue;
                                if (_cachedLockedTestNames != null && !string.IsNullOrWhiteSpace(first.testname) && _cachedLockedTestNames.Contains(first.testname.Trim())) continue;

                                string tName = first.testname?.Trim() ?? "";
                                bool isPending = grp.Any(r => r.status != true && !r.isauthorized1 && !r.isauthorized2);
                                bool isCulture = tName.Contains("CULTURE", StringComparison.OrdinalIgnoreCase) || 
                                                 (first.groupname?.Contains("CULTURE", StringComparison.OrdinalIgnoreCase) == true);
                                bool isSel = true;
                                if (previousSelections.TryGetValue(tName, out var prevSel))
                                {
                                    isSel = prevSel;
                                }

                                selectedTestDetails.Add(new TestDetailItem
                                {
                                    tcode = first.tcode,
                                    testname = tName,
                                    gcode = first.gcode,
                                    groupname = first.groupname ?? "",
                                    ispending = isPending,
                                    isselected = isSel,
                                    isculture = isCulture,
                                    is_escalation = false
                                });
                            }
                        }
                    }
                }
            }
            catch { }

            // 3. Fallback: Populate ordered test details from loaded patient status flow if still empty
            if (!selectedTestDetails.Any() && patientStatusFlow?.Tests != null && patientStatusFlow.Tests.Any())
            {
                foreach (var t in patientStatusFlow.Tests)
                {
                    if (t.Tcode.HasValue && _cachedLockedTcodes?.Contains((long)t.Tcode.Value) == true) continue;
                    if (_cachedLockedTestNames != null && !string.IsNullOrWhiteSpace(t.TestName) && _cachedLockedTestNames.Contains(t.TestName.Trim())) continue;

                    string tName = t.TestName ?? "Unknown Test";
                    bool isPending = t.Result?.ResultStatus != true;
                    bool isCulture = tName.Contains("CULTURE", StringComparison.OrdinalIgnoreCase) || 
                                     (t.GroupName?.Contains("CULTURE", StringComparison.OrdinalIgnoreCase) == true);

                    selectedTestDetails.Add(new TestDetailItem
                    {
                        tcode = t.Tcode ?? 0,
                        testname = tName,
                        gcode = t.Gcode ?? 0,
                        groupname = t.GroupName ?? "",
                        ispending = isPending,
                        isselected = true,
                        isculture = isCulture,
                        is_escalation = false
                    });
                }
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading patient status flow: {ex.Message}"); */
        }
        finally
        {
            isLoadingFlow = false;
            StateHasChanged();
        }
    }

