                        opsByOpId[op.op_id.ToString()] = op;
                    if (op.booking_id.HasValue && op.booking_id.Value != Guid.Empty && !opsByBookingId.ContainsKey(op.booking_id.Value.ToString()))
                        opsByBookingId[op.booking_id.Value.ToString()] = op;
                    if (!string.IsNullOrWhiteSpace(op.op_no) && !opsByOpNo.ContainsKey(op.op_no.Trim()))
                        opsByOpNo[op.op_no.Trim()] = op;
                    if (!string.IsNullOrWhiteSpace(op.mobile) && !opsByMobile.ContainsKey(op.mobile.Trim()))
                        opsByMobile[op.mobile.Trim()] = op;
                }
            }

            // Index CaseSheet investigations
            var csByGuid = new Dictionary<string, CaseSheetInvestigationAllDto>(StringComparer.OrdinalIgnoreCase);
            var csByMobile = new Dictionary<string, CaseSheetInvestigationAllDto>(StringComparer.OrdinalIgnoreCase);

            if (csTask != null && csTask.IsCompletedSuccessfully)
            {
                try
                {
                    var csRes = await csTask;
