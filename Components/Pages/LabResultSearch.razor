    {
        testNameSearch = test.name;
        testSearchResults.Clear();
        ApplyFilters();
        StateHasChanged();
    }

    private void ToggleFilter() => isFilterOpen = !isFilterOpen;

    private async Task NavigateToEntry(ViewResultSearch item)
    {
        await SaveFilterStateAsync();

        string targetGuid = item.requestguid != Guid.Empty ? item.requestguid.ToString() : "";
        string custCode = item.custcode ?? "";
        string activeGuid = targetGuid;

        try
        {
            var searchPayload = new { page = 1, pagesize = 100, search = !string.IsNullOrEmpty(custCode) ? custCode : targetGuid };
            var listReq = new HttpRequestMessage(HttpMethod.Post, "api/HmsBilling/list-bills")
            {
                Content = new StringContent(JsonConvert.SerializeObject(searchPayload), System.Text.Encoding.UTF8, "application/json")
            };
            var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
            if (userResult.Success && userResult.Value != null)
            {
                if (!string.IsNullOrEmpty(userResult.Value.TenantCode)) listReq.Headers.Add("tenant_code", userResult.Value.TenantCode);
                if (!string.IsNullOrEmpty(userResult.Value.AuthToken)) listReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", userResult.Value.AuthToken);
            }
            var listRes = await ClientFactory.CreateClient("Medico").SendAsync(listReq);
            if (listRes.IsSuccessStatusCode)
            {
                var listJson = await listRes.Content.ReadAsStringAsync();
                var listResp = JsonConvert.DeserializeObject<HmsBillListResponse>(listJson);
                if (listResp?.data != null && listResp.data.Any())
                {
                    var matched = listResp.data.FirstOrDefault(b =>
                        (!string.IsNullOrEmpty(b.opvisitid) && b.opvisitid.Equals(targetGuid, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(b.requestguid) && b.requestguid.Equals(targetGuid, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(b.custcode) && b.custcode.Equals(custCode, StringComparison.OrdinalIgnoreCase)) ||
                        (b.custid.HasValue && b.custid.Value.ToString() == custCode)
                    );
                    if (matched != null && !string.IsNullOrEmpty(matched.requestguid))
                    {
                        activeGuid = matched.requestguid;
                    }
                }
            }
        }
        catch { }

        if (reportType == "Culture")
        {
            NavigationManager.NavigateTo($"/culture-result-entry?requestGuid={activeGuid}&custcode={custCode}");
        }
        else
        {
            NavigationManager.NavigateTo($"/result-entry?requestGuid={activeGuid}&custcode={custCode}");
        }
    }

    private string CleanBase64String(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        var s = raw.Trim();
        if (s.StartsWith("\"") && s.EndsWith("\""))
        {
            try { s = JsonConvert.DeserializeObject<string>(s) ?? s.Trim('"'); }
            catch { s = s.Trim('"'); }
        }
        if (s.StartsWith("{") && s.EndsWith("}"))
        {
            try
            {
                var jObj = Newtonsoft.Json.Linq.JObject.Parse(s);
                var token = jObj["data"] ?? jObj["result"] ?? jObj["pdf"] ?? jObj["report"] ?? jObj["file"];
                if (token != null) s = token.ToString();
            }
            catch { }
        }
        if (s.StartsWith("data:application/pdf;base64,"))
        {
            s = s.Substring("data:application/pdf;base64,".Length);
        }
        return s.Trim();
    }

    private async Task PreviewReportBase64(string endpointWithParams)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            string userToken = "";
            string effectiveTenantCode = "0010";

            var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
            if (userResult.Success && userResult.Value != null)
            {
                var user = userResult.Value;
                if (!string.IsNullOrEmpty(user.TenantCode)) effectiveTenantCode = user.TenantCode;
                if (!string.IsNullOrEmpty(user.AuthToken)) userToken = user.AuthToken;
            }

            void AttachHeaders(HttpRequestMessage req)
            {
                if (!string.IsNullOrEmpty(userToken))
                    req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", userToken);
                if (!string.IsNullOrEmpty(effectiveTenantCode))
                    req.Headers.Add("tenant_code", effectiveTenantCode);
            }

            // Extract target row item if available
            string targetGuid = "";
            string targetCustCode = "";
            if (selectedRowIndex >= 0 && selectedRowIndex < filteredResults.Count)
            {
                var selectedItem = filteredResults[selectedRowIndex];
                targetGuid = selectedItem.requestguid != null ? selectedItem.requestguid.ToString() : "";
                targetCustCode = selectedItem.custcode ?? "";
            }

            // Resolve billed requestguid via list-bills FIRST
            string billedGuid = "";
            if (!string.IsNullOrEmpty(targetCustCode) || !string.IsNullOrEmpty(targetGuid))
            {
                try
                {
                    var searchPayloads = new List<object>();
                    if (!string.IsNullOrEmpty(targetCustCode))
                        searchPayloads.Add(new { page = 1, pagesize = 100, search = targetCustCode });
                    if (!string.IsNullOrEmpty(targetGuid))
                        searchPayloads.Add(new { page = 1, pagesize = 100, search = targetGuid });

                    foreach (var pObj in searchPayloads)
                    {
                        var listReq = new HttpRequestMessage(HttpMethod.Post, "api/HmsBilling/list-bills")
                        {
                            Content = new StringContent(JsonConvert.SerializeObject(pObj), System.Text.Encoding.UTF8, "application/json")
                        };
                        AttachHeaders(listReq);
                        var listRes = await ClientFactory.CreateClient("Medico").SendAsync(listReq);
                        if (listRes.IsSuccessStatusCode)
                        {
                            var listJson = await listRes.Content.ReadAsStringAsync();
                            var listResp = JsonConvert.DeserializeObject<HmsBillListResponse>(listJson);
                            if (listResp?.data != null && listResp.data.Any())
                            {
                                var matched = listResp.data.FirstOrDefault(b =>
                                    (!string.IsNullOrEmpty(b.opvisitid) && b.opvisitid.Equals(targetGuid, StringComparison.OrdinalIgnoreCase)) ||
                                    (!string.IsNullOrEmpty(b.requestguid) && b.requestguid.Equals(targetGuid, StringComparison.OrdinalIgnoreCase)) ||
                                    (!string.IsNullOrEmpty(b.custcode) && b.custcode.Equals(targetCustCode, StringComparison.OrdinalIgnoreCase))
                                );
                                if (matched != null && !string.IsNullOrEmpty(matched.requestguid))
                                {
                                    billedGuid = matched.requestguid;
                                    break;
                                }
                            }
                        }
                    }
                }
                catch { }
            }

            string activeGuid = !string.IsNullOrEmpty(billedGuid) ? billedGuid : targetGuid;

            // Trigger pre-fetch of loadtestresultentry to hydrate backend report dataset
            if (!string.IsNullOrEmpty(activeGuid))
            {
                try
                {
                    var preReq = new HttpRequestMessage(HttpMethod.Get, $"api/labresult/loadtestresultentry?requestguid={activeGuid}&custcode={targetCustCode}");
                    AttachHeaders(preReq);
                    await ClientFactory.CreateClient("Medico").SendAsync(preReq);
                }
                catch { }
            }

            var candidateUrls = new List<string>();

            string cleanEp = !string.IsNullOrEmpty(endpointWithParams) 
                ? (endpointWithParams.StartsWith("api/", StringComparison.OrdinalIgnoreCase) ? endpointWithParams : $"api/{endpointWithParams}") 
                : "";

            if (!string.IsNullOrEmpty(cleanEp))
            {
                candidateUrls.Add(cleanEp);
            }

            if (!string.IsNullOrEmpty(activeGuid))
            {
                bool isLetterheadVal = isLetterhead;
                candidateUrls.Add($"api/report/labreport?requestguid={activeGuid}&isletterhead={isLetterheadVal.ToString().ToLower()}");
                candidateUrls.Add($"api/Report/LabReport?requestguid={activeGuid}&isletterhead={isLetterheadVal.ToString().ToLower()}");
                candidateUrls.Add($"api/report/culture-report?requestguid={activeGuid}&isletterhead={isLetterheadVal.ToString().ToLower()}");
                candidateUrls.Add($"api/report/labreport?op_id={activeGuid}&isletterhead={isLetterheadVal.ToString().ToLower()}");
                candidateUrls.Add($"api/report/getopcasesheet?op_id={activeGuid}&isletterhead={isLetterheadVal.ToString().ToLower()}");
            }

            string base64Result = "";
            foreach (var cUrl in candidateUrls)
            {
                try
                {
                    var req = new HttpRequestMessage(HttpMethod.Get, cUrl);
                    AttachHeaders(req);
                    var resp = await ClientFactory.CreateClient("Medico").SendAsync(req);
                    if (resp.IsSuccessStatusCode && resp.StatusCode != System.Net.HttpStatusCode.NoContent)
                    {
                        var raw = await resp.Content.ReadAsStringAsync();
                        string cleaned = CleanBase64String(raw);
                        if (!string.IsNullOrEmpty(cleaned) && cleaned.Length >= 50)
                        {
                            base64Result = cleaned;
                            break;
                        }
                    }
                }
                catch { }
            }

            if (string.IsNullOrEmpty(base64Result) && !string.IsNullOrEmpty(activeGuid))
            {
                try
                {
                    var reportPayload = new
                    {
                        ClientID = effectiveTenantCode,
                        DataSource = "DataSet3",
                        ReportName = "LabReport.rdlc",
                        RequestGUID = activeGuid,
                        TCode = "",
                        IsAuthorized2Finished = false,
                        QueryString = $"SampleID={activeGuid}",
                        Parameters = new List<object>
                        {
                            new { Name = "RequestGUID", Values = new List<string> { activeGuid } },
                            new { Name = "tcode", Values = new List<string> { "" } },
                            new { Name = "IsLetterHead", Values = new List<string> { isLetterhead ? "true" : "false" } }
                        }
                    };
                    var postReq = new HttpRequestMessage(HttpMethod.Post, "api/report/labreport")
                    {
                        Content = new StringContent(JsonConvert.SerializeObject(reportPayload), System.Text.Encoding.UTF8, "application/json")
                    };
                    AttachHeaders(postReq);
                    var postRes = await ClientFactory.CreateClient("Medico").SendAsync(postReq);
                    if (postRes.IsSuccessStatusCode && postRes.StatusCode != System.Net.HttpStatusCode.NoContent)
                    {
                        var raw = await postRes.Content.ReadAsStringAsync();
                        string cleaned = CleanBase64String(raw);
                        if (!string.IsNullOrEmpty(cleaned) && cleaned.Length >= 50)
                        {
                            base64Result = cleaned;
                        }
                    }
                }
                catch { }
            }

            if (!string.IsNullOrEmpty(base64Result) && base64Result.Length >= 50)
            {
                await JSRuntime.InvokeVoidAsync("openPdfPreviewModal", base64Result, "Lab Report Preview");
            }
            else
            {
                Toast.ShowError("Preview failed: Report generation returned empty data.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Preview error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadUserPermissionsAsync(int userCode)
    {
        try
        {
            // 1. Fetch custom department master mappings
            var deptMasterRequest = new HttpRequestMessage(HttpMethod.Get, $"api/DepartmentMaster/get");
            if (!string.IsNullOrEmpty(token))
                deptMasterRequest.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var deptMasterRes = await ClientFactory.CreateClient("Medico").SendAsync(deptMasterRequest);
            List<DepartmentMasterModel> customDepts = new();
            if (deptMasterRes.IsSuccessStatusCode)
            {
                var deptMasterContent = await deptMasterRes.Content.ReadAsStringAsync();
                customDepts = JsonConvert.DeserializeObject<List<DepartmentMasterModel>>(deptMasterContent) ?? new();
            }

            // 2. Fetch current user detail wrapper (contains departments and roles)
            var usersRequest = new HttpRequestMessage(HttpMethod.Get, $"api/User/get?user_code={userCode}");
            if (!string.IsNullOrEmpty(token))
                usersRequest.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var usersRes = await ClientFactory.CreateClient("Medico").SendAsync(usersRequest);
            List<int> userDeptCodes = new();
            List<long> userGroupCodes = new();
            bool isSuperAdmin = false;
            if (usersRes.IsSuccessStatusCode)
            {
                var content = await usersRes.Content.ReadAsStringAsync();
                var currentUser = JsonConvert.DeserializeObject<GetUser>(content);
                
                // SuperAdmin = UserCode 0 (tenant owner) OR role stored as numeric string "0"
                isSuperAdmin = userCode == 0 ||
                               (currentUser?.user?.role?.ToString() == "0");

                if (!isSuperAdmin && currentUser != null && currentUser.department != null)
                {
                    foreach (var d in currentUser.department)
                    {
                        if (d.gcode.HasValue && d.gcode.Value > 0)
                        {
                            userGroupCodes.Add((long)d.gcode.Value);
                        }
                    }
                }
            }
            else
            {
                // Fallback check based on local session storage details if endpoint fails
                var uDetailsResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                if (uDetailsResult.Success && uDetailsResult.Value != null)
                {
                    isSuperAdmin = userCode == 0 || 
                                   (uDetailsResult.Value.Role == "0" || uDetailsResult.Value.Role == "Administrator");
                }
            }

            // 3. Fetch direct user group authorizations
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/userrights/authget?usercode={userCode}");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var res = await ClientFactory.CreateClient("Medico").SendAsync(request);
            var directGroupCodes = new List<long>();
            if (res.IsSuccessStatusCode)
            {
                var jsonStr = await res.Content.ReadAsStringAsync();
                var rights = JsonConvert.DeserializeObject<List<UserRightModel>>(jsonStr) ?? new();
                directGroupCodes = rights.Select(r => r.gcode).ToList();
            }

            // 4. Fetch all groups (needed to map group to department)
            var groupReq = new HttpRequestMessage(HttpMethod.Get, $"api/GroupMaster/get");
            if (!string.IsNullOrEmpty(token))
                groupReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var groupRes = await ClientFactory.CreateClient("Medico").SendAsync(groupReq);
            if (groupRes.IsSuccessStatusCode)
            {
                groupsList = await groupRes.Content.ReadFromJsonAsync<List<GroupModel>>() ?? new();
            }

            if (isSuperAdmin)
            {
                // Super admin: no gcode restriction â€” sees everything
                authorizedGroupCodes = new List<long>();
                allowedDeptCodes = new List<int>();
            }
            else
            {
                var resolvedGroupCodes = new HashSet<long>();
                
                // Priority 1: groups derived from mapped departments/groups
                if (userGroupCodes.Any())
                {
                    foreach (var g in userGroupCodes)
                    {
                        resolvedGroupCodes.Add(g);
                    }

                    var deptsGcodes = customDepts
                        .Where(d => userGroupCodes.Contains(d.dcode))
                        .SelectMany(d => d.gcode ?? new List<int>())
                        .Select(g => (long)g);
                    
                    foreach (var g in deptsGcodes)
                        resolvedGroupCodes.Add(g);
                }

                // Priority 2: direct group rights from userrights table (always merged in)
                foreach (var g in directGroupCodes)
                    resolvedGroupCodes.Add(g);

                authorizedGroupCodes = resolvedGroupCodes.ToList();
                allowedDeptCodes = userDeptCodes;
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading user permissions: {ex.Message}") */;
        }

        ApplyFilters();
        StateHasChanged();
    }

    private List<int> GetAuthorizedBranchCodes(UserDetailsModel? userDetails)
    {
        var list = new List<int>();
        if (userDetails == null) return list;
        
        if (userDetails.UserCode == 1 || string.Equals(userDetails.Role, "Administrator", StringComparison.OrdinalIgnoreCase))
        {
            return list;
        }
        
        if (userDetails.UserDetails != null && !string.IsNullOrEmpty(userDetails.UserDetails.ToString()))
        {
            try
            {
                var jObj = Newtonsoft.Json.Linq.JObject.Parse(userDetails.UserDetails.ToString());
                var branchesToken = jObj["branches"] ?? jObj["Branches"];
                if (branchesToken is Newtonsoft.Json.Linq.JArray jArr)
                {
                    foreach (var item in jArr)
                    {
                        int? bhcodeVal = item["bhcode"]?.ToObject<int?>() ?? item["bhCode"]?.ToObject<int?>();
                        if (bhcodeVal.HasValue && bhcodeVal.Value > 0)
                        {
                            list.Add(bhcodeVal.Value);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[DEBUG] Error parsing user details branches JSON: {ex.Message}");
            }
        }
        
        if (list.Count == 0 && userDetails.BranchCode.HasValue && userDetails.BranchCode.Value > 0)
        {
            list.Add(userDetails.BranchCode.Value);
        }
        
        return list;
    }

