                if (!string.IsNullOrEmpty(custCode) && billMap.TryGetValue(custCode, out var bGuid2)) candidateGuids.Add(bGuid2);
                if (!string.IsNullOrEmpty(rawGuid)) candidateGuids.Add(rawGuid);
                if (!string.IsNullOrEmpty(opVisit)) candidateGuids.Add(opVisit);

                candidateGuids = candidateGuids.Where(g => !string.IsNullOrWhiteSpace(g)).Distinct().ToList();

                var candidateUrls = new List<string>();
                foreach (var gId in candidateGuids)
                {
                    if (!string.IsNullOrEmpty(custCode))
                    {
                        candidateUrls.Add($"api/labresult/loadtestresultentry?requestguid={gId}&custcode={custCode}");
                        candidateUrls.Add($"api/LabResult/LoadResultEntry?requestguid={gId}&custcode={custCode}");
                    }
                    candidateUrls.Add($"api/labresult/loadtestresultentry?requestguid={gId}");
                    candidateUrls.Add($"api/LabResult/LoadResultEntry?requestguid={gId}");
                }
                if (!string.IsNullOrEmpty(opVisit))
                {
                    candidateUrls.Add($"api/CaseSheet/investigation?op_id={opVisit}");
                }
                if (!string.IsNullOrEmpty(pathNo))
                {
                    candidateUrls.Add($"api/labresult/loadtestresultentry?requestguid={pathNo}");
                    candidateUrls.Add($"api/LabResult/LoadResultEntry?requestguid={pathNo}");
                    candidateUrls.Add($"api/CaseSheet/investigation?inv_code={pathNo}");
                }

                foreach (var cUrl in candidateUrls)
                {
                    try
                    {
                        var req = new HttpRequestMessage(HttpMethod.Get, cUrl);
                        AttachHeaders(req);
                        var res = await client.SendAsync(req);
                        if (res.IsSuccessStatusCode && res.StatusCode != System.Net.HttpStatusCode.NoContent)
                        {
                            var jsonStr = await res.Content.ReadAsStringAsync();
                            if (!string.IsNullOrWhiteSpace(jsonStr))
                            {
                                bool isEnteredInDb = false;

                                try
                                {
                                    var tokenObj = Newtonsoft.Json.Linq.JToken.Parse(jsonStr);
                                    if (tokenObj is Newtonsoft.Json.Linq.JObject jObj)
                                    {
                                        if (IsTokenEntered(jObj))
                                        {
                                            isEnteredInDb = true;
                                        }

                                        if (!isEnteredInDb)
                                        {
                                            foreach (var prop in jObj.Properties())
                                            {
                                                if (prop.Value is Newtonsoft.Json.Linq.JArray arr && arr.Any())
                                                {
                                                    if (arr.Any(r => IsTokenEntered(r)))
                                                    {
                                                        isEnteredInDb = true;
                                                        break;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    else if (tokenObj is Newtonsoft.Json.Linq.JArray jArr && jArr.Any())
                                    {
                                        isEnteredInDb = jArr.Any(r => IsTokenEntered(r));
                                    }
                                }
                                catch { }

                                if (isEnteredInDb)
                                {
                                    item.resultstatus = true;
                                    item.isauthorized1 = true;
                                    item.isauthorized2 = true;
                                    item.requestresultstatus = true;
                                    item.isentered = true;
                                    item.hasresults = true;
                                    item.status = 1;
                                    item.enteredresultcount = (item.enteredresultcount ?? 0) + 1;

                                    if (!string.IsNullOrEmpty(rawGuid)) hydrationFinishedCache[rawGuid] = true;
                                    if (!string.IsNullOrEmpty(opVisit)) hydrationFinishedCache[opVisit] = true;
                                    if (!string.IsNullOrEmpty(custCode)) hydrationFinishedCache[custCode] = true;
                                    if (!string.IsNullOrEmpty(pathNo)) hydrationFinishedCache[pathNo] = true;

                                    updatedAny = true;
                                    break;
                                }
                            }
                        }
                    }
                    catch { }
                }
            }
            catch { }
            finally
            {
                semaphore.Release();
            }
        });

        await Task.WhenAll(tasks);

        if (updatedAny)
        {
            ApplyFilters();
            await InvokeAsync(StateHasChanged);
        }
    }

