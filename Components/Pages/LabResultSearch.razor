    private int GetPaymentStatusCount(string status)
    {
        if (allResults == null || !allResults.Any()) return 0;
        
        var query = allResults.AsEnumerable();
        query = query.Where(x => x.requestdatetime.ToIndianTime().Date >= fromDate.Date && x.requestdatetime.ToIndianTime().Date <= toDate.Date);
        if (selectedDoctorCode != 0) query = query.Where(x => x.dcode == selectedDoctorCode);
        if (branchID != 0) query = query.Where(x => x.enteredbhcode == branchID);
        else if (userAuthorizedBranchCodes.Count > 0) query = query.Where(x => x.enteredbhcode.HasValue && userAuthorizedBranchCodes.Contains(x.enteredbhcode.Value));
        if (mainDept == "Lab") query = query.Where(x => x.islab == true || (x.islab == null && x.isscan != true));
        else if (mainDept == "Scan") query = query.Where(x => x.isscan == true);
        else if (mainDept == "Culture") query = query.Where(x => x.isculture == true);

        if (reportType == "Lab") query = query.Where(x => x.islab == true || (x.islab == null && x.isscan != true));
        else if (reportType == "Culture") query = query.Where(x => x.isculture == true);
        else if (reportType == "Scan") query = query.Where(x => x.isscan == true);

        if (status == "Paid")
            return query.Count(x => IsRecordBilled(x));
        else if (status == "Unpaid")
            return query.Count(x => !IsRecordBilled(x));
        return query.Count();
    }

