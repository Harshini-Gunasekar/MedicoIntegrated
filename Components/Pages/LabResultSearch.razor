            }

            // Index OP Registrations
            var opsByOpId = new Dictionary<string, OPRegistrationModel.OpRegistrationModel>(StringComparer.OrdinalIgnoreCase);
            var opsByBookingId = new Dictionary<string, OPRegistrationModel.OpRegistrationModel>(StringComparer.OrdinalIgnoreCase);
            var opsByOpNo = new Dictionary<string, OPRegistrationModel.OpRegistrationModel>(StringComparer.OrdinalIgnoreCase);
            var opsByMobile = new Dictionary<string, OPRegistrationModel.OpRegistrationModel>(StringComparer.OrdinalIgnoreCase);

            if (opsTask?.IsCompletedSuccessfully == true && opsTask.Result != null)
            {
                foreach (var op in opsTask.Result)
