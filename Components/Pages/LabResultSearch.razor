                        }
                    }
                }
            }
        }
        catch { }


        // 2. Parallel hydration for pending items using SemaphoreSlim
        using var semaphore = new System.Threading.SemaphoreSlim(12);
        var tasks = pendingItems.Select(async item =>
        {
            await semaphore.WaitAsync();
            try
            {
                string rawGuid = item.requestguid != Guid.Empty ? item.requestguid.ToString() : "";
                string custCode = item.custcode ?? "";
                string opVisit = item.opvisitid ?? "";
