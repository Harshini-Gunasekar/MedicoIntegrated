        var client = ClientFactory.CreateClient("Medico");
        bool updatedAny = false;

        var pendingItems = results.Where(r => !IsRecordFinished(r)).ToList();
        if (!pendingItems.Any()) return;

        // 1. Single batch fetch of bills with large pagesize to map visit IDs / cust codes to billed requestguids
        var billMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        try
        {
            var searchPayload = new { page = 1, pagesize = 1000, search = "" };
            var listReq = new HttpRequestMessage(HttpMethod.Post, "api/HmsBilling/list-bills")
            {
                Content = new StringContent(JsonConvert.SerializeObject(searchPayload), System.Text.Encoding.UTF8, "application/json")
            };
            AttachHeaders(listReq);
            var listRes = await client.SendAsync(listReq);
            if (listRes.IsSuccessStatusCode)
            {
                var listJson = await listRes.Content.ReadAsStringAsync();
                var listResp = JsonConvert.DeserializeObject<HmsBillListResponse>(listJson);
                if (listResp?.data != null)
                {
                    foreach (var b in listResp.data)
                    {
                        if (!string.IsNullOrEmpty(b.requestguid))
                        {
                            if (!string.IsNullOrEmpty(b.opvisitid)) billMap[b.opvisitid] = b.requestguid;
                            if (!string.IsNullOrEmpty(b.custcode)) billMap[b.custcode] = b.requestguid;
                            if (b.custid.HasValue) billMap[b.custid.Value.ToString()] = b.requestguid;
                        }
                    }
                }
            }
        }
        catch { }


        // 2. Parallel hydration for pending items using SemaphoreSlim
        using var semaphore = new System.Threading.SemaphoreSlim(12);
        var tasks = pendingItems.Select(async item =>
        {
            await semaphore.WaitAsync();
            try
            {
                string rawGuid = item.requestguid != Guid.Empty ? item.requestguid.ToString() : "";
                string custCode = item.custcode ?? "";
                string opVisit = item.opvisitid ?? "";
                string pathNo = item.billnoprint ?? "";

                var candidateGuids = new List<string>();
                if (!string.IsNullOrEmpty(pathNo)) candidateGuids.Add(pathNo);
                if (!string.IsNullOrEmpty(opVisit) && billMap.TryGetValue(opVisit, out var bGuid1)) candidateGuids.Add(bGuid1);
                if (!string.IsNullOrEmpty(custCode) && billMap.TryGetValue(custCode, out var bGuid2)) candidateGuids.Add(bGuid2);
                if (!string.IsNullOrEmpty(rawGuid)) candidateGuids.Add(rawGuid);
                if (!string.IsNullOrEmpty(opVisit)) candidateGuids.Add(opVisit);

                candidateGuids = candidateGuids.Where(g => !string.IsNullOrWhiteSpace(g)).Distinct().ToList();

                var candidateUrls = new List<string>();
                foreach (var gId in candidateGuids)
                {
                    if (!string.IsNullOrEmpty(custCode))
                    {
                        candidateUrls.Add($"api/labresult/loadtestresultentry?requestguid={gId}&custcode={custCode}");
                        candidateUrls.Add($"api/LabResult/LoadResultEntry?requestguid={gId}&custcode={custCode}");
                    }
                    candidateUrls.Add($"api/labresult/loadtestresultentry?requestguid={gId}");
