            if (!string.IsNullOrEmpty(userAuthToken))
            {
                if (request.Headers.Contains("Authorization")) request.Headers.Remove("Authorization");
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", userAuthToken);
            }
            if (branchID > 0)
            {
                if (request.Headers.Contains("bhcode")) request.Headers.Remove("bhcode");
                request.Headers.Add("bhcode", branchID.ToString());
            }

            var res = await ClientFactory.CreateClient("Medico").SendAsync(request, token);
            if (res.IsSuccessStatusCode && !token.IsCancellationRequested)
            {
                var content = await res.Content.ReadAsStringAsync(token);
                var investigations = JsonConvert.DeserializeObject<List<CaseSheetInvestigationAllDto>>(content);

                if (investigations != null && investigations.Any() && !token.IsCancellationRequested)
                {
                    var newResultsList = new List<ViewResultSearch>();

                    // Single batch fetch of bills with large pagesize to map visit IDs / cust codes to billed requestguids
                    var billMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                    try
                    {
                        var searchPayload = new { page = 1, pagesize = 1000, search = "" };
                        var listReq = new HttpRequestMessage(HttpMethod.Post, "api/HmsBilling/list-bills")
                        {
                            Content = new StringContent(JsonConvert.SerializeObject(searchPayload), System.Text.Encoding.UTF8, "application/json")
                        };
                        if (!string.IsNullOrEmpty(userTenantCode)) listReq.Headers.Add("tenant_code", userTenantCode);
                        if (!string.IsNullOrEmpty(userAuthToken)) listReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", userAuthToken);
                        if (branchID > 0) listReq.Headers.Add("bhcode", branchID.ToString());

                        var listRes = await ClientFactory.CreateClient("Medico").SendAsync(listReq, token);
                        if (listRes.IsSuccessStatusCode)
                        {
                            var listJson = await listRes.Content.ReadAsStringAsync(token);
                            var listResp = JsonConvert.DeserializeObject<HmsBillListResponse>(listJson);
                            if (listResp?.data != null)
                            {
                                foreach (var b in listResp.data)
                                {
                                    if (!string.IsNullOrEmpty(b.requestguid))
                                    {
                                        if (!string.IsNullOrEmpty(b.opvisitid)) billMap[b.opvisitid] = b.requestguid;
                                        if (!string.IsNullOrEmpty(b.custcode)) billMap[b.custcode] = b.requestguid;
                                        if (b.custid.HasValue) billMap[b.custid.Value.ToString()] = b.requestguid;
                                    }
                                }
                            }
                        }
                    }
                    catch { }

                    // Fetch individual test names & verify DB result entry status in parallel
                    using var detailSemaphore = new System.Threading.SemaphoreSlim(20);
                    var detailTasks = investigations.Select(async invHeader =>
                    {
                        await detailSemaphore.WaitAsync();
                        try
                        {
                            string opId = invHeader.op_id ?? "";
                            string ipId = invHeader.ip_id ?? "";
                            string custCodeStr = !string.IsNullOrEmpty(invHeader.custcode) ? invHeader.custcode : (invHeader.custid?.ToString() ?? "");
                            string invCodeStr = invHeader.inv_code ?? "";

                            string mappedBGuid = "";
                            if (!string.IsNullOrEmpty(opId) && billMap.TryGetValue(opId, out var bg1)) mappedBGuid = bg1;
                            else if (!string.IsNullOrEmpty(custCodeStr) && billMap.TryGetValue(custCodeStr, out var bg2)) mappedBGuid = bg2;

                            List<CaseSheetTestDto>? tests = null;
                            if (!string.IsNullOrEmpty(opId) || !string.IsNullOrEmpty(ipId))
                            {
                                string queryParam = !string.IsNullOrEmpty(opId) ? $"op_id={Uri.EscapeDataString(opId)}" : $"ip_id={Uri.EscapeDataString(ipId)}";
                                var detailReq = new HttpRequestMessage(HttpMethod.Get, $"api/CaseSheet/investigation?{queryParam}");
                                if (!string.IsNullOrEmpty(userTenantCode)) detailReq.Headers.Add("tenant_code", userTenantCode);
                                if (!string.IsNullOrEmpty(userAuthToken)) detailReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", userAuthToken);
                                if (branchID > 0) detailReq.Headers.Add("bhcode", branchID.ToString());

                                try {
                                    var detailRes = await ClientFactory.CreateClient("Medico").SendAsync(detailReq, token);
                                    if (detailRes.IsSuccessStatusCode)
                                    {
                                        var detailContent = await detailRes.Content.ReadAsStringAsync(token);
                                        var detailObj = JsonConvert.DeserializeObject<CaseSheetInvestigationDetailDto>(detailContent);
                                        tests = detailObj?.tests;
                                    }
                                } catch {}
                            }

                            bool isEntryDoneInDb = false;
                            if ((!string.IsNullOrEmpty(opId) && hydrationFinishedCache.TryGetValue(opId, out bool hc1) && hc1) ||
                                (!string.IsNullOrEmpty(mappedBGuid) && hydrationFinishedCache.TryGetValue(mappedBGuid, out bool hc2) && hc2))
                            {
                                isEntryDoneInDb = true;
                            }

                            if (!isEntryDoneInDb)
                            {
                                var checkGuids = new List<string>();
                                if (!string.IsNullOrEmpty(mappedBGuid)) checkGuids.Add(mappedBGuid);
                                if (!string.IsNullOrEmpty(opId)) checkGuids.Add(opId);
                                if (!string.IsNullOrEmpty(invCodeStr)) checkGuids.Add(invCodeStr);

                                foreach (var gId in checkGuids.Distinct())
                                {
                                    try {
                                        string lUrl = !string.IsNullOrEmpty(custCodeStr) 
                                            ? $"api/labresult/loadtestresultentry?requestguid={Uri.EscapeDataString(gId)}&custcode={Uri.EscapeDataString(custCodeStr)}"
                                            : $"api/labresult/loadtestresultentry?requestguid={Uri.EscapeDataString(gId)}";
                                        
                                        var lReq = new HttpRequestMessage(HttpMethod.Get, lUrl);
                                        if (!string.IsNullOrEmpty(userTenantCode)) lReq.Headers.Add("tenant_code", userTenantCode);
                                        if (!string.IsNullOrEmpty(userAuthToken)) lReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", userAuthToken);
                                        if (branchID > 0) lReq.Headers.Add("bhcode", branchID.ToString());

                                        var lRes = await ClientFactory.CreateClient("Medico").SendAsync(lReq);
                                        if (lRes.IsSuccessStatusCode && lRes.StatusCode != System.Net.HttpStatusCode.NoContent)
                                        {
                                            var lJson = await lRes.Content.ReadAsStringAsync();
                                            if (!string.IsNullOrWhiteSpace(lJson))
                                            {
                                                var tokenObj = Newtonsoft.Json.Linq.JToken.Parse(lJson);
                                                if (IsTokenEntered(tokenObj))
                                                {
                                                    isEntryDoneInDb = true;
                                                    if (!string.IsNullOrEmpty(opId)) hydrationFinishedCache[opId] = true;
                                                    if (!string.IsNullOrEmpty(mappedBGuid)) hydrationFinishedCache[mappedBGuid] = true;
                                                    break;
                                                }
                                            }
                                        }
                                    } catch {}
                                }
                            }

                            return (Header: invHeader, Tests: tests, IsEntryDone: isEntryDoneInDb);
                        }
                        finally
                        {
                            detailSemaphore.Release();
                        }
                    });

                    var detailedResults = await Task.WhenAll(detailTasks);

                    int snoCounter = 1;
                    foreach (var item in detailedResults)
                    {
                        var invHeader = item.Header;
                        var tests = item.Tests;
                        bool isEntryDoneInDb = item.IsEntryDone;

                        Guid reqGuid = Guid.Empty;
                        if (!string.IsNullOrEmpty(invHeader.op_id) && Guid.TryParse(invHeader.op_id, out var parsedOp))
                        {
                            reqGuid = parsedOp;
                        }
                        else if (!string.IsNullOrEmpty(invHeader.ip_id) && Guid.TryParse(invHeader.ip_id, out var parsedIp))
                        {
                            reqGuid = parsedIp;
                        }
                        else if (!string.IsNullOrEmpty(invHeader.inv_id) && Guid.TryParse(invHeader.inv_id, out var parsedInv))
                        {
                            reqGuid = parsedInv;
                        }
                        string pCustCode = !string.IsNullOrEmpty(invHeader.custcode) ? invHeader.custcode : (invHeader.custid?.ToString() ?? "");
                        string pName = invHeader.patient_name ?? "";
                        string pMobile = invHeader.mobile ?? "";
                        string dName = invHeader.name ?? "";
                        int dCode = invHeader.dcode ?? 0;
                        DateTimeOffset reqDate = invHeader.inv_date ?? DateTimeOffset.Now;
                        int currSno = snoCounter++;

                        static bool IsFinishedStatus(string? statusStr)
                        {
                            if (string.IsNullOrWhiteSpace(statusStr)) return false;
                            var s = statusStr.Trim().ToUpper();
                            return s == "COMPLETED" || s == "FINISHED" || s == "ENTERED" || s == "SAVED" || 
                                   s == "AUTHORIZED" || s == "AUTHORISED" || s == "APPROVED" || s == "DONE" || 
                                   s == "SUCCESS" || s == "1" || s == "TRUE";
                        }

                        bool isCacheDone = isEntryDoneInDb ||
                                           (reqGuid != Guid.Empty && hydrationFinishedCache.TryGetValue(reqGuid.ToString(), out bool c1) && c1) ||
                                           (!string.IsNullOrEmpty(invHeader.op_id) && hydrationFinishedCache.TryGetValue(invHeader.op_id, out bool c2) && c2);

                        if (tests != null && tests.Any())
                        {
                            foreach (var test in tests)
                            {
                                bool hasVal = !string.IsNullOrWhiteSpace(test.result_value) && test.result_value != "-";
                                bool hasDate = test.result_date.HasValue && test.result_date.Value != default;
                                bool isFin = isCacheDone ||
                                             IsFinishedStatus(test.result_status) || 
                                             IsFinishedStatus(invHeader.report_status) || 
                                             IsFinishedStatus(invHeader.sheet_status) || 
                                             hasVal || hasDate;



                                var vrs = new ViewResultSearch
                                {
                                    requestsno = currSno,
                                    requestguid = reqGuid,
                                    custcode = pCustCode,
                                    opvisitid = invHeader.op_id,
                                    name = pName,
                                    mobile = pMobile,
                                    dcode = dCode,
                                    doctor = dName,
                                    doctorfullname = dName,
                                    testname = test.test_name,
                                    tcode = test.test_code?.ToString(),
                                    requestdatetime = reqDate,
                                    billnoprint = invHeader.inv_code,
                                    resultstatus = isFin,
                                    requestresultstatus = (IsFinishedStatus(invHeader.report_status) || IsFinishedStatus(invHeader.sheet_status) || isFin),
                                    status = isFin ? 1 : 0,
                                    hasresults = isFin,
                                    isentered = isFin,
                                    enteredresultcount = isFin ? 1 : 0
                                };
                                newResultsList.Add(vrs);
                            }
                        }
                        else
                        {
                            bool isHeaderDone = isCacheDone || IsFinishedStatus(invHeader.report_status) || IsFinishedStatus(invHeader.sheet_status);


                            var vrs = new ViewResultSearch
                            {
                                requestsno = currSno,
                                requestguid = reqGuid,
                                custcode = pCustCode,
                                opvisitid = invHeader.op_id,
                                name = pName,
                                mobile = pMobile,
                                dcode = dCode,
                                doctor = dName,
                                doctorfullname = dName,
                                testname = "Investigation Request",
                                requestdatetime = reqDate,
                                billnoprint = invHeader.inv_code,
                                resultstatus = isHeaderDone,
                                requestresultstatus = isHeaderDone,
                                status = isHeaderDone ? 1 : 0,
                                hasresults = isHeaderDone,
                                isentered = isHeaderDone,
                                enteredresultcount = isHeaderDone ? 1 : 0
                            };
                            newResultsList.Add(vrs);
                        }
                    }

                    allResults = newResultsList;
                    await LoadUnbilledStatusAsync();
                    ApplyFilters();
                    await InvokeAsync(StateHasChanged);
                    _ = HydrateResultsWithEntryDataAsync(allResults);
                }
                else if (!token.IsCancellationRequested)
                {
                    allResults = new();
                    filteredResults = new();
                }
            }
        }
        catch (TaskCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching results via CaseSheet API: {ex.Message}");
        }
        finally
        {
            if (token == _searchResultsCts?.Token)
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private void ApplyFilters()
    {
        var filtered = allResults.AsEnumerable();

        // Note: gcode restriction removed from worklist view.
        // All billed records are visible in Result Search for navigation.
        // Dept-based access control only applies inside Result Entry when entering results.

        if (branchID != 0)
        {
            filtered = filtered.Where(x => x.enteredbhcode == branchID || x.enteredbhcode == 0 || x.enteredbhcode == null);
        }

        if (!string.IsNullOrWhiteSpace(globalSearch))
        {
            var searchLower = globalSearch.ToLower();
            filtered = filtered.Where(x => 
                (x.name ?? "").ToLower().Contains(searchLower) ||
                (x.custcode ?? "").ToLower().Contains(searchLower) ||
                (x.requestsno.ToString()).Contains(searchLower) ||
                (x.billnoprint ?? "").ToLower().Contains(searchLower) ||
                (x.mobile ?? "").Contains(searchLower) ||
                (x.testshortname ?? "").ToLower().Contains(searchLower) ||
                (x.testname ?? "").ToLower().Contains(searchLower)
            );
        }

        if (mainDept == "Lab")
            filtered = filtered.Where(x => x.isscan != true); // Show everything except explicit Scans in Lab dept
        else if (mainDept == "Scan")
            filtered = filtered.Where(x => x.isscan == true);

        if (reportType == "Lab")
            filtered = filtered.Where(x => x.isculture != true && x.isscan != true); // More permissive Lab view
        else if (reportType == "Culture")
            filtered = filtered.Where(x => x.isculture == true);
        else if (reportType == "Scan")
            filtered = filtered.Where(x => x.isscan == true);

        if (!string.IsNullOrEmpty(sidFrom) && int.TryParse(sidFrom, out int sFrom))
            filtered = filtered.Where(x => x.requestsno >= sFrom);
        if (!string.IsNullOrEmpty(sidTo) && int.TryParse(sidTo, out int sTo))
            filtered = filtered.Where(x => x.requestsno <= sTo);

        if (!string.IsNullOrWhiteSpace(patientSearch))
            filtered = filtered.Where(x => (x.name ?? "").ToLower().Contains(patientSearch.ToLower()));

        if (!string.IsNullOrWhiteSpace(mobileSearch))
            filtered = filtered.Where(x => (x.mobile ?? "").Contains(mobileSearch));

        if (!string.IsNullOrWhiteSpace(pathologyNo))
            filtered = filtered.Where(x => (x.billnoprint ?? "").Contains(pathologyNo));

        if (!string.IsNullOrWhiteSpace(testNameSearch))
        {
            var tSearch = testNameSearch.ToLower().TrimEnd('.');
            filtered = filtered.Where(x => 
                (x.testshortname ?? "").ToLower().Contains(tSearch) || 
                (x.testname ?? "").ToLower().Contains(tSearch)
            );
        }

        if (resultStatus == "Finished")
            filtered = filtered.Where(x => IsRecordFinished(x));
        else if (resultStatus == "Pending")
            filtered = filtered.Where(x => !IsRecordFinished(x));

        filteredResults = filtered
            .OrderByDescending(x => x.is_emergency == true)
            .ThenByDescending(x => x.requestdatetime)
            .ThenByDescending(x => x.requestsno)
            .ToList();
    }

    private bool IsRecordPending(ViewResultSearch item)
    {
        return !IsRecordFinished(item);
    }

    private bool IsRecordFinished(ViewResultSearch item)
    {
        if (item == null) return false;
        if (item.resultstatus == true || 
               item.isauthorized1 == true || 
               item.isauthorized2 == true || 
               item.requestresultstatus == true || 
               item.isentered == true || 
               (item.enteredresultcount.HasValue && item.enteredresultcount.Value > 0) ||
               item.status == 1 ||
               (item.status.HasValue && item.status.Value > 0))
        {
            return true;
        }

        if (item.requestguid != Guid.Empty && hydrationFinishedCache.TryGetValue(item.requestguid.ToString(), out bool f1) && f1) return true;
        if (!string.IsNullOrEmpty(item.opvisitid) && hydrationFinishedCache.TryGetValue(item.opvisitid, out bool f2) && f2) return true;
        if (!string.IsNullOrEmpty(item.custcode) && hydrationFinishedCache.TryGetValue(item.custcode, out bool f3) && f3) return true;

        return false;
    }

    private string GetRecordStatus(ViewResultSearch item)
    {
        bool pending = IsRecordPending(item);
        if (pending) return "Pending";
        return "Finished";
    }

    private string GetFormattedPatientName(ViewResultSearch item)
    {
        if (item == null) return "Unknown Patient";
        string rawName = item.name ?? "";

        // If rawName contains age/sex suffix e.g. "MANIKANDAN-44 Yrs/M" or "SANDHYA-/F"
        int dashIdx = rawName.LastIndexOf('-');
        if (dashIdx > 0)
        {
            string nameOnly = rawName.Substring(0, dashIdx).Trim();
            if (!string.IsNullOrWhiteSpace(nameOnly))
                return nameOnly;
        }

        if (!string.IsNullOrWhiteSpace(rawName) && !rawName.StartsWith("-"))
            return rawName.Trim();

        if (!string.IsNullOrWhiteSpace(item.custcode))
            return item.custcode;

        return $"Case #{item.requestsno}";
    }

    private string GetFormattedPatientMeta(ViewResultSearch item)
    {
        if (item == null) return "";
        string rawName = item.name ?? "";
        string parsedAge = item.age ?? "";
        string parsedSex = item.sex ?? "";

        // Extract age and sex embedded in rawName e.g. "MANIKANDAN-44 Yrs/M" or "SANDHYA-/F"
        int dashIdx = rawName.LastIndexOf('-');
        if (dashIdx >= 0 && dashIdx < rawName.Length - 1)
        {
            string suffix = rawName.Substring(dashIdx + 1).Trim();
            var parts = suffix.Split('/');
            if (parts.Length > 0 && (string.IsNullOrWhiteSpace(parsedAge) || parsedAge == "0"))
            {
                string agePart = parts[0].Replace("Yrs", "").Replace("Yr", "").Replace("Y", "").Trim();
                if (!string.IsNullOrWhiteSpace(agePart))
                    parsedAge = agePart;
            }
            if (parts.Length > 1 && string.IsNullOrWhiteSpace(parsedSex))
            {
                parsedSex = parts[1].Trim();
            }
        }

        string ageStr = (!string.IsNullOrWhiteSpace(parsedAge) && parsedAge != "0") ? $"{parsedAge} Y" : "";
        string sexStr = (parsedSex == "M" || parsedSex == "Male") ? "MALE" : ((parsedSex == "F" || parsedSex == "Female") ? "FEMALE" : parsedSex);

        if (!string.IsNullOrEmpty(ageStr) && !string.IsNullOrEmpty(sexStr))
            return $"{ageStr} / {sexStr}";
        if (!string.IsNullOrEmpty(ageStr))
            return ageStr;
        if (!string.IsNullOrEmpty(sexStr))
            return sexStr;

        return "";
    }


    private bool isLoadingTests = false;

    private void SelectRow(int index, ViewResultSearch item)
    {
        selectedRowIndex = index;
        selectedTestDetails.Clear();
        isLoadingTests = true;
        StateHasChanged();

        try
        {
            /* Console.WriteLine($"[SelectRow] Getting tests for SNo={item.requestsno}, GUID={item.requestguid}, CustCode={item.custcode} from local viewresultsearch list") */;

            // Filter local allResults list to find all rows matching this request
            var testsForRequest = allResults
                .Where(x => (x.requestguid != Guid.Empty && x.requestguid == item.requestguid) || 
                            (x.requestsno == item.requestsno && x.custcode == item.custcode))
                .Where(x => !string.IsNullOrEmpty(x.testname))
                .ToList();

            /* Console.WriteLine($"[SelectRow] Found {testsForRequest.Count} matching test rows locally") */;

            // Group by testname to display distinct tests
            var groupedTests = testsForRequest.GroupBy(x => x.testname);

            foreach (var g in groupedTests)
            {
                selectedTestDetails.Add(new TestDetailItem
                {
                    testname = g.Key ?? "Unknown Test",
                    ispending = g.Any(x => x.resultstatus != true && x.isauthorized1 != true && x.isauthorized2 != true),
                    isselected = true,
                    is_escalation = false
                });
            }
            /* Console.WriteLine($"[SelectRow] Grouped into {selectedTestDetails.Count} test items") */;
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading test details locally: {ex.Message}") */;
        }
        finally
        {
            isLoadingTests = false;
            StateHasChanged();
        }

        _ = LoadPatientStatusFlow(item.requestguid);
    }

    private async Task LoadPatientStatusFlow(Guid requestGuid)
    {
        if (requestGuid == Guid.Empty) return;
        isLoadingFlow = true;
        patientStatusFlow = null;
        StateHasChanged();
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/LabResult/LoadResultEntry?requestguid={requestGuid}");
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            try {
                var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null && !string.IsNullOrEmpty(userResult.Value.TenantCode))
                    request.Headers.Add("tenant_code", userResult.Value.TenantCode);
            } catch {}

            var response = await ClientFactory.CreateClient("Medico").SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                patientStatusFlow = JsonConvert.DeserializeObject<PatientStatusDto>(content);
            }
        }
        catch (Exception ex)
        {
            /* Console.WriteLine($"Error loading patient status flow: {ex.Message}"); */
        }
        finally
        {
            isLoadingFlow = false;
            StateHasChanged();
        }
    }

