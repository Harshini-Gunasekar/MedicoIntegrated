    private bool hasCreateRight = false;
    private bool hasEditRight = false;
    private bool hasDeleteRight = false;
    private bool hasViewRight = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                SharedComponents.Rcl.Models.UserDetailsModel? user = null;
                var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null)
                {
                    user = userResult.Value;
                    token = user.AuthToken ?? "";
                    branchID = (TenantState.BranchCode > 0) ? TenantState.BranchCode.Value : (user.BranchCode ?? 0);
                    userCodeValue = user.UserCode ?? 0;
                }

                bool isAdmin = await UserPermissionHelper.IsAdminAsync(user, TenantState, _sessionStorage);

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                    hasEditRight = true;
                    hasDeleteRight = true;
                }
                else
                {
                    List<User_Rights>? rightsList = null;
                    try
                    {
                        var rightsResult = await _sessionStorage.GetAsync<List<User_Rights>>("UserRights");
                        if (rightsResult.Success && rightsResult.Value != null)
                        {
                            rightsList = rightsResult.Value;
                        }
                    }
                    catch { }

                    if (rightsList == null || rightsList.Count == 0)
                    {
                        rightsList = TenantState?.UserRightsList?.ToList();
                    }

                    var r = await UserPermissionHelper.GetRightsAsync(user, TenantState, _sessionStorage, rightsList, "Result Search", "Result_Search", "Lab Result Search");
                    hasViewRight = r.View;
                    hasCreateRight = r.Add;
                    hasEditRight = r.Edit;
                    hasDeleteRight = r.Delete;

                    if (!RoleService.IsPermissionsLoaded)
                    {
                        try
                        {
                            var sessionPerms = await _sessionStorage.GetAsync<List<Booking.Models.RolePermissionItem>>("UserRolePermissions");
                            if (sessionPerms.Success && sessionPerms.Value != null)
                            {
                                RoleService.SetUserPermissions(sessionPerms.Value);
                            }
                        }
                        catch { }
                    }

                    if (RoleService.HasRoleId(535) || RoleService.HasAction("Laboratory", "Result Search", "View") || RoleService.HasRight("Laboratory", "Result Search") || TenantState.HasActionRight("Laboratory", "Result Search", "View") || (TenantState.UserRightsList?.Any(r => r.ModuleName?.Contains("Result Search") == true && r.ToView) == true))
                    {
                        hasViewRight = true;
                    }
                    if (RoleService.HasRoleId(536) || RoleService.HasAction("Laboratory", "Result Search", "Print Report") || RoleService.HasAction("Laboratory", "Result Search", "Print"))
                    {
                        hasViewRight = true;
                    }

                    if (await UserPermissionHelper.IsAdminAsync(null, TenantState, _sessionStorage))
                    {
                        hasViewRight = true;
                        hasCreateRight = true;
                        hasEditRight = true;
                        hasDeleteRight = true;
                    }

                    if (!hasViewRight && !(await UserPermissionHelper.IsAdminAsync(null, TenantState, _sessionStorage)))
                    {
                        Toast.ShowError("You do not have permission to access Result Search.");
                        NavigationManager.NavigateTo("/home");
                        return;
                    }
                }

                await LoadBranchesAsync();
                await LoadDoctorsAsync();

                // Restore filter state if user navigated back from result entry
                await RestoreFilterStateAsync();
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task RestoreFilterStateAsync()
    {
        try
        {
            var saved = await _sessionStorage.GetAsync<FilterState>(FilterStateKey);
            if (saved.Success && saved.Value != null)
            {
                var s = saved.Value;
                fromDate = s.fromdate;
                toDate = s.todate;
                sidFrom = s.sidfrom;
                sidTo = s.sidto;
                mainDept = s.maindept;
                patientSearch = s.patientsearch;
                mobileSearch = s.mobilesearch;
                selectedDepartment = s.selecteddepartment;
                testNameSearch = s.testname;
                reportType = s.reporttype;
                referredBySearch = s.referredbysearch;
                pathologyNo = s.pathologyno;
                resultStatus = s.resultstatus;
                paymentStatus = s.paymentstatus ?? "Paid";
                showAllTestInEntry = s.showalltestinentry;
                showTAT = s.showtat;
                globalSearch = s.globalsearch;
                isFilterOpen = s.isfilteropen;

                if (TenantState.BranchCode > 0)
                    branchID = TenantState.BranchCode.Value;
                else if (branches.Any(b => b.bhcode == s.branchid))
                    branchID = s.branchid;

                if (s.hasresults)
                    await SearchResults();

                await _sessionStorage.DeleteAsync(FilterStateKey);
            }
            else
            {
                // Default view: Search for current month's results automatically if no filters are stored
                fromDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
                toDate = DateTime.Now;
                resultStatus = "All";
                paymentStatus = "Paid";
                isFilterOpen = true;
                await SearchResults();
            }
        }
        catch (Exception ex) 
        {
            /* Console.WriteLine($"Error restoring filter state: {ex.Message}") */;
        }
    }

