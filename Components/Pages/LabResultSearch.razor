    private bool hasCreateRight = false;
    private bool hasEditRight = false;
    private bool hasDeleteRight = false;
    private bool hasViewRight = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                bool isAdmin = false;
                var userResult = await _sessionStorage.GetAsync<UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null)
                {
                    var user = userResult.Value;
                    isAdmin = string.Equals(user.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                              user.UserCode == 0 || user.UserCode == 1;
                    token = user.AuthToken ?? "";
                    branchID = (TenantState.BranchCode > 0) ? TenantState.BranchCode.Value : (user.BranchCode ?? 0);
                    userCodeValue = user.UserCode ?? 0;
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                    hasEditRight = true;
                    hasDeleteRight = true;
                }
                else
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var pageRight = rightsResult.Value.FirstOrDefault(r =>
                            r.ModuleName != null && r.ModuleName.Trim().Equals("Result_Search", StringComparison.OrdinalIgnoreCase));
                        if (pageRight != null)
                        {
                            hasViewRight = pageRight.ToView;
                            hasCreateRight = pageRight.ToAdd;
                            hasEditRight = pageRight.ToEdit;
                            hasDeleteRight = pageRight.ToDelete;
                        }
                        else { hasViewRight = false; hasCreateRight = false; hasEditRight = false; hasDeleteRight = false; }
                    }
                    else { hasViewRight = false; hasCreateRight = false; hasEditRight = false; hasDeleteRight = false; }

                    if (!hasViewRight)
                    {
                        Toast.ShowError("You do not have permission to access Result Search.");
                        NavigationManager.NavigateTo("/home");
                        return;
                    }
                }

                await LoadBranchesAsync();
                await LoadDoctorsAsync();

                // Restore filter state if user navigated back from result entry
                await RestoreFilterStateAsync();
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task RestoreFilterStateAsync()
    {
        try
        {
            var saved = await _sessionStorage.GetAsync<FilterState>(FilterStateKey);
            if (saved.Success && saved.Value != null)
            {
                var s = saved.Value;
                fromDate = s.fromdate;
                toDate = s.todate;
                sidFrom = s.sidfrom;
                sidTo = s.sidto;
                mainDept = s.maindept;
                patientSearch = s.patientsearch;
                mobileSearch = s.mobilesearch;
                selectedDepartment = s.selecteddepartment;
                testNameSearch = s.testname;
                reportType = s.reporttype;
                referredBySearch = s.referredbysearch;
                pathologyNo = s.pathologyno;
                resultStatus = s.resultstatus;
                paymentStatus = s.paymentstatus ?? "All";
                showAllTestInEntry = s.showalltestinentry;
                showTAT = s.showtat;
                globalSearch = s.globalsearch;
                isFilterOpen = s.isfilteropen;

                if (TenantState.BranchCode > 0)
                    branchID = TenantState.BranchCode.Value;
                else if (branches.Any(b => b.bhcode == s.branchid))
                    branchID = s.branchid;

                if (s.hasresults)
                    await SearchResults();

                await _sessionStorage.DeleteAsync(FilterStateKey);
            }
            else
            {
                // Default view: Search for current month's results automatically if no filters are stored
                fromDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
                toDate = DateTime.Now;
                resultStatus = "All";
                await SearchResults();
            }
        }
        catch (Exception ex) 
