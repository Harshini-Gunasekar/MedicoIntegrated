        color: #15803d;
        border: 1px solid #bbf7d0;
    }
    .re-status-badge.finished .re-badge-dot {
        background: #10b981;
        box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
    }

    .re-bill-badge.paid {
