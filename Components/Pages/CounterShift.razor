@page "/counter-shift"
@rendermode InteractiveServer
@using Newtonsoft.Json
@using Booking.Models
@using Medico_Backend.Model
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.ToastService ToastService
@inject IHttpClientFactory ClientFactory
@inject ProtectedSessionStorage _sessionStorage
@inject Booking.Services.CounterMasterService CounterService
@inject IJSRuntime JSRuntime
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject NavigationManager Nav

<div class="cm-page">
    <!-- Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <h1 class="cm-title">Counter Shift Management</h1>
            <span class="cm-subtitle">Open or close billing counter shifts</span>
        </div>
        <div class="cm-header-right">
            <div class="cm-search-box">
                <i class="bi bi-search cm-search-icon"></i>
                <input type="text" class="cm-search-input" placeholder="Quick find..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            @if (hasCreateRight)
            {
                <button class="cm-btn-new" @onclick="OpenOpenModal">
                    + Open New Shift
                </button>
            }
        </div>
    </div>

    <!-- Table Card -->
    <div class="cm-table-card">
        <table class="cm-table">
            <thead>
                <tr>
                    <th style="width: 25%">BRANCH</th>
                    <th style="width: 25%">COUNTER NAME</th>
                    <th style="width: 15%">SHIFT NO</th>
                    <th style="width: 15%">COUNTER DATE</th>
                    <th style="width: 15%">OPENED AT</th>
                    <th style="width: 5%; text-align: center;">ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoadingOpenCounters && !openCounters.Any())
                {
                    <tr>
                        <td colspan="6" class="cm-empty-row">
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <div>Loading active shifts...</div>
                        </td>
                    </tr>
                }
                else if (!FilteredShifts.Any())
                {
                    <tr>
                        <td colspan="6" class="cm-empty-row">
                            <i class="bi bi-info-circle"></i>
                            <div>No active / open counter shifts found</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var shift in FilteredShifts)
                    {
                        var branchName = branches.FirstOrDefault(b => b.bh_code == shift.bhcode)?.name ?? $"Branch {shift.bhcode}";
                        var counterName = counters.FirstOrDefault(c => c.cntcode == shift.cntcode)?.name ?? $"Counter {shift.cntcode}";
                        <tr>
                            <td>
                                <span class="branch-badge">@branchName</span>
                            </td>
                            <td>
                                <strong>@counterName</strong>
                            </td>
                            <td>
                                <span class="shift-no-badge">Shift @shift.shiftsno</span>
                            </td>
                            <td class="col-date">
                                @(shift.counterdate?.ToString("dd-MMM-yyyy") ?? "N/A")
                            </td>
                            <td class="col-date">
                                @(shift.fromdate?.ToString("dd-MMM-yyyy hh:mm tt") ?? "N/A")
                            </td>
                            <td style="text-align: center;">
                                @if (hasDeleteRight) { <button class="cm-action-btn delete" title="Close Shift" @onclick="() => CloseShiftInPlace(shift)" disabled="@isClosingInPlace">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (showOpenModal)
{
    <div class="cm-backdrop">
        <div class="cm-modal" style="max-width: 500px;">
            <div class="cm-modal-header">
                <h2 class="cm-modal-title">Open New Counter Shift</h2>
                <button class="cm-close-btn" @onclick="CloseOpenModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body">
                <div class="cm-field-group">
                    <label class="cm-label">Associated Branch</label>
                    <select class="cm-input cm-select" @bind="openRequest.bhcode" @bind:after="OnBranchChanged">
                        @if (branches.Any())
                        {
                            @foreach (var b in branches)
                            {
                                <option value="@b.bh_code">@b.name (@b.bh_code)</option>
                            }
                        }
                        else
                        {
                            <option value="0">Loading branches...</option>
                        }
                    </select>
                </div>

                <div class="cm-field-group">
                    <label class="cm-label">Counter Name</label>
                    <select class="cm-input cm-select" @bind="openRequest.cntcode">
                        @if (filteredCounters.Any())
                        {
                            @foreach (var c in filteredCounters)
                            {
                                <option value="@((int)c.cntcode)">@c.name (@((int)c.cntcode))</option>
                            }
                        }
                        else
                        {
                            <option value="0">No counters available</option>
                        }
                    </select>
                </div>

                <div class="cm-field-group">
                    <label class="cm-label">Counter Date</label>
                    <input type="date" class="cm-input" @bind="openRequestDate" />
                </div>
            </div>

            <div class="cm-modal-footer">
                <div style="flex-grow: 1;"></div>
                <button class="cm-btn-cancel" style="margin-right: 1rem;" @onclick="CloseOpenModal">Cancel</button>
                <button class="cm-btn-save" @onclick="OpenShift" disabled="@isOpening">
                    @if (isOpening)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    Open Shift
                </button>
            </div>
        </div>
    </div>
}

@code {
    private Booking.Models.OpenShiftRequest openRequest = new Booking.Models.OpenShiftRequest
    {
        bhcode = 0,
        cntcode = 0,
        counterdate = DateTime.Today
    };
    
    private DateOnly openRequestDate = DateOnly.FromDateTime(DateTime.Today);

    private Booking.Models.CloseShiftRequest closeRequest = new Booking.Models.CloseShiftRequest
    {
        usercode = 10
    };

    private bool isOpening = false;
    private bool isLoadingOpenCounters = false;
    private bool isClosingInPlace = false;
    private bool showOpenModal = false;
    private string searchQuery = "";

    private List<Booking.Models.BranchModel> branches = new();
    private List<CounterMasterModel> counters = new();
    private List<CounterMasterModel> filteredCounters = new();
    private List<Booking.Models.CounterTimingDto> openCounters = new();
    private string TenantCode = "";
    private string AuthToken = "";
    private bool hasViewRight = true;
    private bool hasCreateRight = false;
    private bool hasDeleteRight = false;

    private List<Booking.Models.CounterTimingDto> FilteredShifts => openCounters.Where(shift => 
        (!branches.Any() || branches.Any(b => b.bh_code == shift.bhcode)) &&
        (string.IsNullOrEmpty(searchQuery) ||
         (branches.FirstOrDefault(b => b.bh_code == shift.bhcode)?.name ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
         (counters.FirstOrDefault(c => c.cntcode == shift.cntcode)?.name ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
         (shift.shiftsno?.ToString() ?? "").Contains(searchQuery))
    ).ToList();

    private void OpenOpenModal()
    {
        showOpenModal = true;
    }

    private void CloseOpenModal()
    {
        showOpenModal = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                bool isAdmin = false;
                try
                {
                    var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userResult.Success && userResult.Value != null)
                    {
                        isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                  userResult.Value.UserCode == 0 ||
                                  userResult.Value.UserCode == 1;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking user details: {ex.Message}");
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                    hasDeleteRight = true;
                }
                else
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var pageRight = rightsResult.Value.FirstOrDefault(r => 
                            r.ModuleName != null && 
                            r.ModuleName.Trim().Equals("Counter_Shift", StringComparison.OrdinalIgnoreCase));
                        
                        if (pageRight != null)
                        {
                            hasViewRight = pageRight.ToView;
                            hasCreateRight = true;
                            hasDeleteRight = true;
                        }
                        else
                        {
                            hasViewRight = false;
                            hasCreateRight = false;
                            hasDeleteRight = false;
                        }
                    }
                    else
                    {
                        hasViewRight = false;
                        hasCreateRight = false;
                        hasDeleteRight = false;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking Counter_Shift rights: {ex.Message}");
                hasViewRight = false;
                hasCreateRight = false;
                hasDeleteRight = false;
            }

            if (!hasViewRight)
            {
                ToastService.ShowError("You do not have permission to access Counter Shift.");
                Nav.NavigateTo("/home");
                return;
            }

            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                Console.WriteLine($"[CounterShift] TenantCode={TenantCode}, AuthToken length={AuthToken?.Length ?? 0}");
                await LoadBranchesAsync();
                await LoadCountersAsync();
                await LoadOpenCountersAsync();
                
                Console.WriteLine($"[CounterShift] Loaded {branches.Count} branches");
                Console.WriteLine($"[CounterShift] Loaded {counters.Count} counters");

                // Initialize default selections
                if (branches.Any())
                {
                    openRequest.bhcode = branches.First().bh_code;
                    UpdateFilteredCounters();
                }
                
                StateHasChanged();
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error initializing shift data: {ex.Message}");
            }
        }
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }

            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                branches = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branches = branches.Where(b => !b.deleted).ToList();
                await FilterBranchesByUserAccessAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to load branches: {err}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading branches: {ex.Message}");
        }
    }

    private async Task FilterBranchesByUserAccessAsync()
    {
        try
        {
            var isTenantAdminResult = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
            if (isTenantAdminResult.Success && isTenantAdminResult.Value == true)
            {
                return;
            }

            var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (userDetailsResult.Success && userDetailsResult.Value != null)
            {
                var ud = userDetailsResult.Value;
                if (ud.UserCode == 0 || ud.UserCode == 1 ||
                    string.Equals(ud.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(ud.Role, "Admin", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(ud.Role, "Owner", StringComparison.OrdinalIgnoreCase))
                {
                    return; // Admins/Owners see all branches
                }

                if (ud.Branches != null && ud.Branches.Any())
                {
                    var allowedCodes = ud.Branches
                        .Select(b => b.bh_code != 0 ? b.bh_code : (b.bhcode ?? 0))
                        .Where(code => code > 0)
                        .ToHashSet();

                    if (allowedCodes.Any())
                    {
                        var filtered = branches.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                        if (filtered.Any())
                        {
                            branches = filtered;
                            return;
                        }
                    }
                }
            }

            var branchCodesResult = await _sessionStorage.GetAsync<List<int>>("UserBranchCodes");
            if (branchCodesResult.Success && branchCodesResult.Value != null && branchCodesResult.Value.Any())
            {
                var allowedCodes = branchCodesResult.Value.ToHashSet();
                var filtered = branches.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                if (filtered.Any())
                {
                    branches = filtered;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering branches by user access: {ex.Message}");
        }
    }

    private async Task LoadCountersAsync()
    {
        try
        {
            counters = await CounterService.GetCountersAsync();
            counters = counters.Where(c => !c.deleted).ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading counters: {ex.Message}");
        }
    }

    private void OnBranchChanged()
    {
        UpdateFilteredCounters();
    }

    private void UpdateFilteredCounters()
    {
        filteredCounters = counters.Where(c => c.bhcode == openRequest.bhcode).ToList();
        if (filteredCounters.Any())
        {
            if (!filteredCounters.Any(c => (int)c.cntcode == openRequest.cntcode))
            {
                openRequest.cntcode = (int)filteredCounters.First().cntcode;
            }
        }
        else
        {
            openRequest.cntcode = 0;
        }
    }

    private async Task OpenShift()
    {
        if (openRequest.bhcode == 0 || openRequest.cntcode == 0)
        {
            ToastService.ShowError("Please select a valid Branch and Counter.");
            return;
        }

        isOpening = true;
        try
        {
            openRequest.counterdate = openRequestDate.ToDateTime(TimeOnly.MinValue);
            var result = await HmsBillingService.OpenShiftAsync(openRequest);
            var parseResult = ParseApiResponse(result, "Shift opened successfully.");
            if (parseResult.Success)
            {
                ToastService.ShowSuccess(parseResult.Message);
                showOpenModal = false;
                await LoadOpenCountersAsync();
            }
            else
            {
                ToastService.ShowError($"Failed to open shift: {parseResult.Message}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isOpening = false;
        }
    }

    private async Task LoadOpenCountersAsync()
    {
        isLoadingOpenCounters = true;
        StateHasChanged();
        try
        {
            openCounters = await HmsBillingService.GetOpenCountersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading open counters: {ex.Message}");
        }
        finally
        {
            isLoadingOpenCounters = false;
            StateHasChanged();
        }
    }

    private async Task CloseShiftInPlace(Booking.Models.CounterTimingDto item)
    {
        var counterName = counters.FirstOrDefault(c => c.cntcode == item.cntcode)?.name ?? $"Counter {item.cntcode}";
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to close the shift for counter '{counterName}'?");
        if (!confirmed) return;

        isClosingInPlace = true;
        StateHasChanged();
        try
        {
            var req = new Booking.Models.CloseShiftRequest
            {
                cnttid = item.cnttid.ToString(),
                usercode = closeRequest.usercode
            };
            var result = await HmsBillingService.CloseShiftAsync(req);
            var parseResult = ParseApiResponse(result, $"Shift for {counterName} closed successfully.");
            if (parseResult.Success)
            {
                ToastService.ShowSuccess(parseResult.Message);
                await LoadOpenCountersAsync();
            }
            else
            {
                ToastService.ShowError($"Failed to close shift: {parseResult.Message}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isClosingInPlace = false;
            StateHasChanged();
        }
    }

    private (bool Success, string Message) ParseApiResponse(string result, string defaultSuccessMessage)
    {
        if (string.IsNullOrEmpty(result))
        {
            return (false, "Empty response from server.");
        }

        if (result.Contains("Error", StringComparison.OrdinalIgnoreCase))
        {
            return (false, result);
        }

        if (result.Trim().StartsWith("{") && result.Trim().EndsWith("}"))
        {
            try
            {
                var jsonObj = Newtonsoft.Json.Linq.JObject.Parse(result);
                if (jsonObj["message"] != null)
                {
                    var msg = jsonObj["message"].ToString();
                    if (msg.Contains("safely shut down", StringComparison.OrdinalIgnoreCase) ||
                        msg.Contains("success", StringComparison.OrdinalIgnoreCase) ||
                        msg.Contains("ok", StringComparison.OrdinalIgnoreCase))
                    {
                        return (true, msg);
                    }
                    else
                    {
                        return (false, msg);
                    }
                }
                else if (jsonObj["cnttid"] != null || jsonObj["shiftsno"] != null)
                {
                    return (true, defaultSuccessMessage);
                }
                else if (jsonObj["errors"] != null)
                {
                    var errs = jsonObj["errors"];
                    var errorList = new List<string>();
                    foreach (var prop in errs.Children<Newtonsoft.Json.Linq.JProperty>())
                    {
                        foreach (var errVal in prop.Value)
                        {
                            errorList.Add(errVal.ToString());
                        }
                    }
                    return (false, string.Join("; ", errorList));
                }
                else
                {
                    return (false, result);
                }
            }
            catch
            {
                return (false, result);
            }
        }

        return (true, result);
    }
}
