@page "/counter-shift"
@rendermode InteractiveServer
@using Newtonsoft.Json
@using Booking.Models
@using Medico_Backend.Model
@using Booking.Helpers
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.ToastService ToastService
@inject IHttpClientFactory ClientFactory
@inject ProtectedLocalStorage _sessionStorage
@inject Booking.Services.CounterMasterService CounterService
@inject IJSRuntime JSRuntime
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Booking.Services.LabSettingService LabSettingService
@inject NavigationManager Nav
@inject Booking.Services.RoleMasterService RoleService
@implements IDisposable

<div class="cm-page">
    @if (!hasViewRight)
    {
        <!-- Access Denied Header Card -->
        <div class="cm-header-card">
            <div class="cm-header-left">
                <div class="cm-header-brand">
                    <div class="cm-header-icon-box" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                        <i class="bi bi-shield-x"></i>
                    </div>
                    <div class="cm-header-text">
                        <h1 class="cm-title">Counter Shift Management</h1>
                        <span class="cm-subtitle" style="color: #ef4444; font-weight: 600;"><span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #ef4444; margin-right: 4px;"></span> ACCESS RESTRICTED</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="alert alert-danger d-flex align-items-center mt-3 p-4 shadow-sm" style="border-radius: 8px;">
            <i class="bi bi-shield-lock-fill me-3 fs-1 text-danger"></i>
            <div>
                <h5 class="alert-heading mb-1 font-bold">Permission Denied</h5>
                <p class="mb-0 text-muted">You do not have permission to view Counter Shift Management. Please contact your system administrator to assign Role 509 (Billing Portal &gt; Counter Shift &gt; View).</p>
            </div>
        </div>
    }
    else
    {
    <!-- Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <div class="cm-header-brand">
                <div class="cm-header-icon-box">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="cm-header-text">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h1 class="cm-title">Counter Shift Management</h1>
                        <span class="cm-live-pill">
                            <span class="cm-pulse-dot"></span> LIVE SESSIONS
                        </span>
                    </div>
                    <span class="cm-subtitle">Open, monitor, and manage active billing counter workstations</span>
                </div>
            </div>
        </div>
        <div class="cm-header-right">
            <button class="cm-btn-secondary" @onclick="() => LoadOpenCountersAsync(false)" title="Refresh active shifts list" disabled="@isLoadingOpenCounters">
                <i class="bi bi-arrow-clockwise @(isLoadingOpenCounters ? "cm-spin" : "")"></i>
                <span>Refresh</span>
            </button>
            @if (hasCreateRight)
            {
                <button class="cm-btn-new" @onclick="OpenOpenModal">
                    <i class="bi bi-plus-lg"></i>
                    <span>Open New Shift</span>
                </button>
            }
            else
            {
                <button class="cm-btn-new" disabled style="opacity: 0.6; cursor: not-allowed; background: #94a3b8;" title="Permission denied: Role 510 (Billing Portal > Counter Shift > Create) is required to open counter shifts.">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Open New Shift</span>
                </button>
            }
        </div>
    </div>

    <!-- KPI Stats Grid -->
    <div class="cm-stats-grid">
        <div class="cm-stat-card">
            <div class="cm-stat-icon-box cm-icon-indigo">
                <i class="bi bi-layers-half"></i>
            </div>
            <div class="cm-stat-content">
                <span class="cm-stat-label">Active Shifts</span>
                <div class="cm-stat-value">@ActiveShiftsCount</div>
                <span class="cm-stat-tag success">
                    <span class="cm-tag-dot pulse"></span> Live Cashier Sessions
                </span>
            </div>
        </div>
        <div class="cm-stat-card">
            <div class="cm-stat-icon-box cm-icon-emerald">
                <i class="bi bi-building-check"></i>
            </div>
            <div class="cm-stat-content">
                <span class="cm-stat-label">Operating Branches</span>
                <div class="cm-stat-value">@OperatingBranchesCount</div>
                <span class="cm-stat-tag neutral">
                    @branches.Count Total Assigned
                </span>
            </div>
        </div>
        <div class="cm-stat-card">
            <div class="cm-stat-icon-box cm-icon-cyan">
                <i class="bi bi-pc-display-horizontal"></i>
            </div>
            <div class="cm-stat-content">
                <span class="cm-stat-label">Active Workstations</span>
                <div class="cm-stat-value">@ActiveCountersCount</div>
                <span class="cm-stat-tag info">
                    Counter Terminals
                </span>
            </div>
        </div>
        <div class="cm-stat-card">
            <div class="cm-stat-icon-box cm-icon-purple">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="cm-stat-content">
                <span class="cm-stat-label">Shift Closure Policy</span>
                <div class="cm-stat-value cm-stat-value-sm">
                    @(string.Equals(cachedLabSetting?.shift_timing_mode, "FIXED", StringComparison.OrdinalIgnoreCase) ? "Fixed Schedule" : "Midnight Auto")
                </div>
                <span class="cm-stat-tag policy">
                    @(string.Equals(cachedLabSetting?.shift_timing_mode, "FIXED", StringComparison.OrdinalIgnoreCase) ? (cachedLabSetting?.shift_end_time ?? "Scheduled") : "12:00 AM Reset")
                </span>
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="cm-toolbar-card">
        <div class="cm-toolbar-left">
            <div class="cm-search-box">
                <i class="bi bi-search cm-search-icon"></i>
                <input type="text" class="cm-search-input" placeholder="Search branch, counter name or shift #..." @bind="searchQuery" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button type="button" class="cm-clear-btn" @onclick="() => searchQuery = string.Empty" title="Clear search">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>

            <div class="cm-filter-dropdown-wrap">
                <i class="bi bi-building cm-dropdown-icon"></i>
                <select class="cm-filter-select" @bind="selectedBranchFilter">
                    <option value="0">All Branches</option>
                    @foreach (var b in branches)
                    {
                        <option value="@b.bh_code">@b.name</option>
                    }
                </select>
            </div>

            <div class="cm-filter-dropdown-wrap">
                <i class="bi bi-sliders cm-dropdown-icon"></i>
                <select class="cm-filter-select" @bind="selectedModeFilter">
                    <option value="">All Shift Policies</option>
                    <option value="VARIABLE">Variable (Midnight)</option>
                    <option value="FIXED">Fixed Schedule</option>
                </select>
            </div>

            @if (!string.IsNullOrEmpty(searchQuery) || selectedBranchFilter != 0 || !string.IsNullOrEmpty(selectedModeFilter))
            {
                <button type="button" class="cm-btn-reset-filters" @onclick="ClearFilters" title="Clear all filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset</span>
                </button>
            }
        </div>

        <div class="cm-toolbar-right">
            <span class="cm-results-count">
                Showing <strong>@FilteredShifts.Count</strong> of <strong>@ActiveShiftsCount</strong> active shifts
            </span>
        </div>
    </div>

    <!-- Table Card -->
    <div class="cm-table-card">
        <div class="cm-table-responsive">
            <table class="cm-table">
                <thead>
                    <tr>
                        <th style="width: 44px; text-align: center;">#</th>
                        <th style="width: 20%;">OPERATING BRANCH</th>
                        <th style="width: 20%;">COUNTER WORKSTATION</th>
                        <th style="width: 12%;">SHIFT NO</th>
                        <th style="width: 12%;">COUNTER DATE</th>
                        <th style="width: 15%;">OPENED AT (IST)</th>
                        <th style="width: 15%;">SHIFT POLICY</th>
                        <th style="width: 12%; text-align: center;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoadingOpenCounters && !openCounters.Any())
                    {
                        <tr>
                            <td colspan="8" class="cm-empty-row">
                                <div class="cm-loading-wrap">
                                    <span class="spinner-border spinner-border-sm text-primary mb-2" role="status" aria-hidden="true"></span>
                                    <div class="fw-semibold text-secondary">Loading active counter sessions...</div>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (!FilteredShifts.Any())
                    {
                        <tr>
                            <td colspan="8" class="cm-empty-row">
                                <div class="cm-empty-container">
                                    <div class="cm-empty-icon">
                                        <i class="bi bi-inbox"></i>
                                    </div>
                                    <h4 class="cm-empty-title">No Active Counter Shifts Found</h4>
                                    <p class="cm-empty-desc">
                                        @if (!string.IsNullOrEmpty(searchQuery) || selectedBranchFilter != 0 || !string.IsNullOrEmpty(selectedModeFilter))
                                        {
                                            <span>No shifts match the current search or filters. Try resetting the filters.</span>
                                        }
                                        else
                                        {
                                            <span>There are currently no active counter sessions open across your assigned branches.</span>
                                        }
                                    </p>
                                    <div class="d-flex align-items-center justify-content-center gap-2 mt-2">
                                        @if (!string.IsNullOrEmpty(searchQuery) || selectedBranchFilter != 0 || !string.IsNullOrEmpty(selectedModeFilter))
                                        {
                                            <button class="cm-btn-secondary btn-sm" @onclick="ClearFilters">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                                            </button>
                                        }
                                        @if (hasCreateRight)
                                        {
                                            <button class="cm-btn-new btn-sm" @onclick="OpenOpenModal">
                                                <i class="bi bi-plus-lg me-1"></i> Open New Shift
                                            </button>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (int i = 0; i < FilteredShifts.Count; i++)
                        {
                            var shift = FilteredShifts[i];
                            int rowNum = i + 1;
                            var branchName = GetBranchName(shift.bhcode);
                            var counterName = GetCounterName(shift.cntcode);
                            bool isFixed = string.Equals(cachedLabSetting?.shift_timing_mode, "FIXED", StringComparison.OrdinalIgnoreCase)
                                           || string.Equals(shift.shift_mode, "FIXED", StringComparison.OrdinalIgnoreCase);

                            <tr>
                                <td style="text-align: center; color: #94a3b8; font-weight: 600;">@rowNum</td>
                                <td>
                                    <span class="branch-badge">
                                        <i class="bi bi-building me-1"></i>@branchName
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="cm-pulse-indicator" title="Live workstation"></div>
                                        <i class="bi bi-display text-muted"></i>
                                        <strong style="color: #0f172a;">@counterName</strong>
                                    </div>
                                </td>
                                <td>
                                    <span class="shift-no-badge">Shift #@shift.shiftsno</span>
                                </td>
                                <td class="col-date">
                                    <i class="bi bi-calendar3 me-1 text-muted"></i>@(shift.counterdate.ToIndianTime()?.ToString("dd-MM-yyyy") ?? "N/A")
                                </td>
                                <td class="col-date">
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold" style="color: #1e293b;">
                                            <i class="bi bi-clock-history me-1 text-primary"></i>@(shift.fromdate.ToIndianTime()?.ToString("hh:mm tt") ?? "N/A")
                                        </span>
                                        <span style="font-size: 0.72rem; color: #64748b; margin-top: 1px;">
                                            @(shift.fromdate.ToIndianTime()?.ToString("dd MMM yyyy") ?? "")
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @if (isFixed)
                                    {
                                        <span class="shift-timing-badge fixed" title="Fixed schedule shift closes automatically">
                                            <i class="bi bi-clock-fill me-1"></i>Fixed (@GetFormattedPlannedTime(shift))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="shift-timing-badge variable" title="Auto closes at midnight or manually by cashier">
                                            <i class="bi bi-moon-stars-fill me-1"></i>Midnight (12:00 AM)
                                        </span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @if (isFixed)
                                    {
                                        <span class="cm-badge-auto-close" title="Fixed timing shifts close automatically at the scheduled time or 12:00 AM midnight.">
                                            <i class="bi bi-robot me-1"></i> Auto
                                        </span>
                                    }
                                    else if (hasDeleteRight)
                                    {
                                        <button class="cm-btn-end-shift" @onclick="() => CloseShiftInPlace(shift)" title="End this counter shift">
                                            <i class="bi bi-stop-circle-fill me-1"></i>
                                            <span>End Shift</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="cm-badge-locked" title="Permission required: Role 511 (Delete)">
                                            <i class="bi bi-shield-lock-fill me-1"></i> Locked
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    }
</div>

@if (showCloseConfirmModal && pendingShiftToClose != null && hasDeleteRight)
{
    var branchName = GetBranchName(pendingShiftToClose.bhcode);
    var counterName = GetCounterName(pendingShiftToClose.cntcode);
    var openedTime = pendingShiftToClose.fromdate.ToIndianTime()?.ToString("dd-MM-yyyy hh:mm tt") ?? "N/A";

    <div class="cm-backdrop" style="z-index: 12000; backdrop-filter: blur(4px);" @onclick="CancelCloseModal">
        <div class="cm-modal cm-modal-elevated" style="max-width: 480px; z-index: 12001; position: relative; overflow: hidden;" @onclick:stopPropagation="true">
            <div class="cm-modal-top-accent cm-accent-danger"></div>
            
            <div class="cm-modal-header" style="border-bottom: 1px solid #f1f5f9; padding: 1.5rem 1.6rem 1rem 1.6rem;">
                <div class="d-flex align-items-center gap-3">
                    <div class="cm-modal-icon-badge cm-badge-danger">
                        <i class="bi bi-door-closed-fill"></i>
                    </div>
                    <div>
                        <h2 class="cm-modal-title" style="font-size: 1.2rem; font-weight: 800; color: #0f172a; margin: 0;">Confirm End Shift</h2>
                        <span style="font-size: 0.78rem; color: #64748b; font-weight: 500;">Terminate active billing counter session</span>
                    </div>
                </div>
                <button class="cm-close-btn" @onclick="CancelCloseModal" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body" style="padding: 1.4rem 1.6rem; display: flex; flex-direction: column; gap: 1rem;">
                <div class="cm-modal-summary-card">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-display text-danger fs-5"></i>
                            <strong style="font-size: 1rem; color: #0f172a;">@counterName</strong>
                        </div>
                        <span class="cm-shift-badge">Shift #@pendingShiftToClose.shiftsno</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between text-secondary" style="font-size: 0.8rem;">
                        <span class="d-inline-flex align-items-center gap-1">
                            <i class="bi bi-building text-muted"></i> @branchName
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <i class="bi bi-clock text-muted"></i> @openedTime
                        </span>
                    </div>
                </div>

                <div class="cm-modal-notice-banner">
                    <i class="bi bi-shield-exclamation fs-5 flex-shrink-0 text-danger"></i>
                    <div style="line-height: 1.45; font-size: 0.82rem;">
                        <strong class="d-block text-danger mb-1">Notice</strong>
                        Closing this shift will finalize all active billing transactions for this counter session.
                    </div>
                </div>
            </div>

            <div class="cm-modal-footer" style="padding: 1rem 1.6rem 1.4rem; border-top: 1px solid #f1f5f9; display: flex; justify-content: flex-end; gap: 0.75rem;">
                <button type="button" class="cm-btn-cancel" @onclick="CancelCloseModal">Cancel</button>
                <button type="button" class="cm-btn-danger-confirm" @onclick="ConfirmCloseShiftAsync" disabled="@isClosingInPlace">
                    @if (isClosingInPlace)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Closing Shift...</span>
                    }
                    else
                    {
                        <i class="bi bi-stop-circle-fill me-1"></i>
                        <span>Confirm End Shift</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (showOpenModal && hasCreateRight)
{
    <div class="cm-backdrop" style="z-index: 12000; backdrop-filter: blur(4px);" @onclick="CloseOpenModal">
        <div class="cm-modal cm-modal-elevated" style="max-width: 520px; z-index: 12001; position: relative; overflow: hidden;" @onclick:stopPropagation="true">
            <div class="cm-modal-top-accent cm-accent-primary"></div>
            
            <div class="cm-modal-header" style="border-bottom: 1px solid #f1f5f9; padding: 1.5rem 1.6rem 1rem 1.6rem;">
                <div class="d-flex align-items-center gap-3">
                    <div class="cm-modal-icon-badge cm-badge-primary">
                        <i class="bi bi-door-open-fill"></i>
                    </div>
                    <div>
                        <h2 class="cm-modal-title" style="font-size: 1.2rem; font-weight: 800; color: #0f172a; margin: 0;">Open New Counter Shift</h2>
                        <span style="font-size: 0.78rem; color: #64748b; font-weight: 500;">Start a new billing cashier session</span>
                    </div>
                </div>
                <button class="cm-close-btn" @onclick="CloseOpenModal" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body" style="padding: 1.4rem 1.6rem; display: flex; flex-direction: column; gap: 1.1rem;">
                <div class="cm-field-group">
                    <label class="cm-label"><i class="bi bi-building me-1 text-primary"></i> Operating Branch</label>
                    <select class="cm-input cm-select fw-semibold" @bind="openRequest.bhcode" @bind:after="OnBranchChanged">
                        @if (branches.Any())
                        {
                            @foreach (var b in branches)
                            {
                                <option value="@b.bh_code">@b.name (@b.bh_code)</option>
                            }
                        }
                        else
                        {
                            <option value="0">Loading branches...</option>
                        }
                    </select>
                </div>

                <div class="cm-field-group">
                    <label class="cm-label"><i class="bi bi-display me-1 text-primary"></i> Counter Workstation</label>
                    <select class="cm-input cm-select fw-semibold" @bind="openRequest.cntcode">
                        @if (filteredCounters.Any())
                        {
                            @foreach (var c in filteredCounters)
                            {
                                <option value="@((int)c.cntcode)">@c.name (@((int)c.cntcode))</option>
                            }
                        }
                        else
                        {
                            <option value="0">No counters available</option>
                        }
                    </select>
                </div>

                <div class="cm-field-group">
                    <label class="cm-label"><i class="bi bi-calendar3 me-1 text-primary"></i> Counter Date</label>
                    <input type="date" class="cm-input fw-semibold" @bind="openRequestDate" />
                </div>

                <div class="cm-modal-policy-card">
                    <i class="bi bi-shield-check fs-5 text-success flex-shrink-0"></i>
                    <div style="font-size: 0.82rem; line-height: 1.4; color: #166534;">
                        <strong class="d-block mb-1">Automatic Shift Policy</strong>
                        Counter shifts auto-close every night at <strong>12:00 AM Midnight</strong> (or scheduled fixed time).
                    </div>
                </div>
            </div>

            <div class="cm-modal-footer" style="padding: 1rem 1.6rem 1.4rem; border-top: 1px solid #f1f5f9; display: flex; justify-content: flex-end; gap: 0.75rem;">
                <button type="button" class="cm-btn-cancel" @onclick="CloseOpenModal">Cancel</button>
                <button type="button" class="cm-btn-save" @onclick="OpenShift" disabled="@isOpening">
                    @if (isOpening)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Opening Shift...</span>
                    }
                    else
                    {
                        <i class="bi bi-plus-circle-fill me-1"></i>
                        <span>Open Shift</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private Booking.Models.OpenShiftRequest openRequest = new Booking.Models.OpenShiftRequest
    {
        bhcode = 0,
        cntcode = 0,
        counterdate = DateTime.UtcNow.ToIndianTime().Date
    };
    
    private DateOnly openRequestDate = DateOnly.FromDateTime(DateTime.UtcNow.ToIndianTime().Date);

    private Booking.Models.CloseShiftRequest closeRequest = new Booking.Models.CloseShiftRequest
    {
        usercode = 10
    };

    private bool isOpening = false;
    private bool isLoadingOpenCounters = false;
    private bool isClosingInPlace = false;
    private bool showOpenModal = false;
    private string searchQuery = "";
    private int selectedBranchFilter = 0;
    private string selectedModeFilter = "";

    private List<Booking.Models.BranchModel> allBranches = new();
    private List<Booking.Models.BranchModel> branches = new();
    private List<CounterMasterModel> counters = new();
    private List<CounterMasterModel> filteredCounters = new();
    private List<Booking.Models.CounterTimingDto> openCounters = new();
    private LabSettingModel? cachedLabSetting = null;
    private string TenantCode = "";
    private string AuthToken = "";
    private bool hasViewRight = true;
    private bool hasCreateRight = false;
    private bool hasDeleteRight = false;

    private int ActiveShiftsCount => openCounters.Count(s => s.todate == null);
    private int OperatingBranchesCount => openCounters.Where(s => s.todate == null).Select(s => s.bhcode).Distinct().Count();
    private int ActiveCountersCount => openCounters.Where(s => s.todate == null).Select(s => s.cntcode).Distinct().Count();

    private void ClearFilters()
    {
        searchQuery = "";
        selectedBranchFilter = 0;
        selectedModeFilter = "";
    }

    private string GetBranchName(int? bhcode)
    {
        if (!bhcode.HasValue || bhcode.Value == 0) return "Main Branch";
        return allBranches.FirstOrDefault(b => b.bh_code == bhcode.Value)?.name 
               ?? branches.FirstOrDefault(b => b.bh_code == bhcode.Value)?.name 
               ?? $"Branch {bhcode.Value}";
    }

    private string GetCounterName(int? cntcode)
    {
        if (!cntcode.HasValue || cntcode.Value == 0) return "Counter";
        return counters.FirstOrDefault(c => c.cntcode == cntcode.Value)?.name ?? $"Counter {cntcode.Value}";
    }

    private List<Booking.Models.CounterTimingDto> FilteredShifts => openCounters.Where(shift => 
        shift.todate == null && 
        (selectedBranchFilter == 0 || shift.bhcode == selectedBranchFilter) &&
        (string.IsNullOrEmpty(selectedModeFilter) || string.Equals(shift.shift_mode, selectedModeFilter, StringComparison.OrdinalIgnoreCase)) &&
        (
            string.IsNullOrEmpty(searchQuery) ||
            (allBranches.FirstOrDefault(b => b.bh_code == shift.bhcode)?.name ?? branches.FirstOrDefault(b => b.bh_code == shift.bhcode)?.name ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            (counters.FirstOrDefault(c => c.cntcode == shift.cntcode)?.name ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            (shift.shiftsno?.ToString() ?? "").Contains(searchQuery)
        )
    ).ToList();

    private void OpenOpenModal()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("Permission denied: Role 510 (Billing Portal > Counter Shift > Create) is required to open counter shifts.");
            return;
        }
        openRequestDate = DateOnly.FromDateTime(DateTime.UtcNow.ToIndianTime().Date);
        showOpenModal = true;
    }

    private void CloseOpenModal()
    {
        showOpenModal = false;
    }

    private void EvaluateRights()
    {
        bool isAdmin = Booking.Helpers.UserPermissionHelper.IsAdmin(null, TenantState);
        if (isAdmin)
        {
            hasViewRight = true;
            hasCreateRight = true;
            hasDeleteRight = true;
            return;
        }

        hasViewRight = RoleService.HasPermission(509) ||
                       RoleService.HasRight("Billing Portal", "Counter Shift") ||
                       TenantState.HasActionRight("Billing Portal", "Counter Shift", "View") ||
                       TenantState.HasActionRight("Billing", "Counter Shift", "View");

        hasCreateRight = RoleService.HasPermission(510) ||
                         RoleService.HasAction("Billing Portal", "Counter Shift", "Create") ||
                         TenantState.HasActionRight("Billing Portal", "Counter Shift", "Create") ||
                         TenantState.HasActionRight("Billing", "Counter Shift", "Create");

        hasDeleteRight = RoleService.HasPermission(511) ||
                         RoleService.HasAction("Billing Portal", "Counter Shift", "Delete") ||
                         TenantState.HasActionRight("Billing Portal", "Counter Shift", "Delete") ||
                         TenantState.HasActionRight("Billing", "Counter Shift", "Delete");
    }

    protected override void OnInitialized()
    {
        RoleService.OnPermissionsChanged += HandlePermissionsChanged;
        EvaluateRights();
    }

    private void HandlePermissionsChanged()
    {
        InvokeAsync(async () =>
        {
            bool prevCanView = hasViewRight;
            EvaluateRights();
            if (prevCanView != hasViewRight && hasViewRight)
            {
                await Task.WhenAll(LoadBranchesAsync(), LoadCountersAsync());
                await LoadOpenCountersAsync(showWarningIfEmpty: false);
            }
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!RoleService.IsPermissionsLoaded && !Booking.Helpers.UserPermissionHelper.IsAdmin(null, TenantState))
            {
                try
                {
                    var sessionPerms = await _sessionStorage.GetAsync<List<RolePermissionItem>>("UserRolePermissions");
                    if (sessionPerms.Success && sessionPerms.Value != null && sessionPerms.Value.Any())
                    {
                        RoleService.SetUserPermissions(sessionPerms.Value);
                    }
                    else if (TenantState.UserCode > 0)
                    {
                        await RoleService.LoadUserPermissionsAsync(TenantState.UserCode, TenantState.TenantCode);
                    }
                }
                catch
                {
                    if (TenantState.UserCode > 0)
                    {
                        await RoleService.LoadUserPermissionsAsync(TenantState.UserCode, TenantState.TenantCode);
                    }
                }
            }

            EvaluateRights();

            if (!hasViewRight)
            {
                StateHasChanged();
                return;
            }

            try
            {
                TenantCode = !string.IsNullOrWhiteSpace(TenantState.TenantCode) ? TenantState.TenantCode : "";
                AuthToken = !string.IsNullOrWhiteSpace(TenantState.AuthToken) ? TenantState.AuthToken : "";

                if (string.IsNullOrEmpty(TenantCode))
                {
                    try
                    {
                        var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                        TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
                    }
                    catch { }
                }

                if (string.IsNullOrEmpty(AuthToken))
                {
                    try
                    {
                        var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                        AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";
                    }
                    catch { }
                }

                Console.WriteLine($"[CounterShift] TenantCode={TenantCode}, AuthToken length={AuthToken?.Length ?? 0}");
                await Task.WhenAll(LoadBranchesAsync(), LoadCountersAsync());
                await LoadOpenCountersAsync(showWarningIfEmpty: false);
                
                Console.WriteLine($"[CounterShift] Loaded {branches.Count} branches");
                Console.WriteLine($"[CounterShift] Loaded {counters.Count} counters");

                // Initialize default selections
                if (branches.Any())
                {
                    openRequest.bhcode = branches.First().bh_code;
                    UpdateFilteredCounters();
                }
                
                StartAutoRefreshTimer();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error initializing shift data: {ex.Message}");
            }
        }
    }

    private System.Threading.Timer? _refreshTimer;
    private bool isDisposed = false;

    private void StartAutoRefreshTimer()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            if (isDisposed || _isFetchingOpenCounters) return;
            try
            {
                await InvokeAsync(async () =>
                {
                    if (isDisposed || _isFetchingOpenCounters) return;
                    await LoadOpenCountersAsync(showWarningIfEmpty: false);
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    public void Dispose()
    {
        isDisposed = true;
        _refreshTimer?.Dispose();
        RoleService.OnPermissionsChanged -= HandlePermissionsChanged;
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }

            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                allBranches = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                allBranches = allBranches.Where(b => !b.deleted).ToList();
                branches = new List<Booking.Models.BranchModel>(allBranches);
                await FilterBranchesByUserAccessAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to load branches: {err}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading branches: {ex.Message}");
        }
    }

    private async Task FilterBranchesByUserAccessAsync()
    {
        try
        {
            var isTenantAdminResult = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
            if (isTenantAdminResult.Success && isTenantAdminResult.Value == true)
            {
                return;
            }

            var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (userDetailsResult.Success && userDetailsResult.Value != null)
            {
                var ud = userDetailsResult.Value;
                if (ud.UserCode == 0 || ud.UserCode == 1 ||
                    string.Equals(ud.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(ud.Role, "Admin", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(ud.Role, "Owner", StringComparison.OrdinalIgnoreCase))
                {
                    return; // Admins/Owners see all branches
                }

                if (ud.Branches != null && ud.Branches.Any())
                {
                    var allowedCodes = ud.Branches
                        .Select(b => b.bh_code != 0 ? b.bh_code : (b.bhcode ?? 0))
                        .Where(code => code > 0)
                        .ToHashSet();

                    if (allowedCodes.Any())
                    {
                        var filtered = branches.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                        if (filtered.Any())
                        {
                            branches = filtered;
                            return;
                        }
                    }
                }
            }

            var branchCodesResult = await _sessionStorage.GetAsync<List<int>>("UserBranchCodes");
            if (branchCodesResult.Success && branchCodesResult.Value != null && branchCodesResult.Value.Any())
            {
                var allowedCodes = branchCodesResult.Value.ToHashSet();
                var filtered = branches.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                if (filtered.Any())
                {
                    branches = filtered;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering branches by user access: {ex.Message}");
        }
    }

    private async Task LoadCountersAsync()
    {
        try
        {
            counters = await CounterService.GetCountersAsync();
            counters = counters.Where(c => !c.deleted).ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading counters: {ex.Message}");
        }
    }

    private void OnBranchChanged()
    {
        UpdateFilteredCounters();
    }

    private void UpdateFilteredCounters()
    {
        filteredCounters = counters.Where(c => c.bhcode == openRequest.bhcode).ToList();
        if (filteredCounters.Any())
        {
            if (!filteredCounters.Any(c => (int)c.cntcode == openRequest.cntcode))
            {
                openRequest.cntcode = (int)filteredCounters.First().cntcode;
            }
        }
        else
        {
            openRequest.cntcode = 0;
        }
    }

    private async Task OpenShift()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("Permission denied: Role 510 (Billing Portal > Counter Shift > Create) is required to open counter shifts.");
            return;
        }

        if (openRequest.bhcode == 0 || openRequest.cntcode == 0)
        {
            ToastService.ShowError("Please select a valid Branch and Counter.");
            return;
        }

        isOpening = true;
        try
        {
            openRequest.counterdate = openRequestDate.ToDateTime(TimeOnly.MinValue);
            openRequest.planned_to = null;
            openRequest.shift_mode = null;

            var result = await HmsBillingService.OpenShiftAsync(openRequest);
            var parseResult = ParseApiResponse(result, "Shift opened successfully.");
            if (parseResult.Success)
            {
                ToastService.ShowSuccess(parseResult.Message);
                showOpenModal = false;
                await LoadOpenCountersAsync();
            }
            else
            {
                ToastService.ShowError($"Failed to open shift: {parseResult.Message}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isOpening = false;
        }
    }

    private bool _isFetchingOpenCounters = false;

    private async Task LoadOpenCountersAsync(bool showWarningIfEmpty = false)
    {
        if (_isFetchingOpenCounters) return;
        _isFetchingOpenCounters = true;
        try
        {
            if (!openCounters.Any())
            {
                isLoadingOpenCounters = true;
                StateHasChanged();
            }

            var settingsTask = LabSettingService.GetLabSettingAsync();
            var countersTask = HmsBillingService.GetOpenCountersAsync(returnAllUnclosed: true, tenantCode: TenantCode);
            await Task.WhenAll(settingsTask, countersTask);

            cachedLabSetting = await settingsTask;
            openCounters = (await countersTask) ?? new();
            if (showWarningIfEmpty && !openCounters.Any())
            {
                ToastService.ShowWarning("No active shifts open. Please open the shift.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading open counters: {ex.Message}");
        }
        finally
        {
            isLoadingOpenCounters = false;
            _isFetchingOpenCounters = false;
            StateHasChanged();
        }
    }

    private bool showCloseConfirmModal = false;
    private Booking.Models.CounterTimingDto? pendingShiftToClose = null;

    private void CloseShiftInPlace(Booking.Models.CounterTimingDto item)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("Permission denied: Role 511 (Billing Portal > Counter Shift > Delete) is required to close counter shifts.");
            return;
        }

        bool isFixed = string.Equals(cachedLabSetting?.shift_timing_mode, "FIXED", StringComparison.OrdinalIgnoreCase)
                       || string.Equals(item.shift_mode, "FIXED", StringComparison.OrdinalIgnoreCase);

        if (isFixed)
        {
            ToastService.ShowWarning("The fixed timing shift cannot be closed manually. It will close automatically at the configured time or at midnight (12:00 AM).");
            return;
        }

        pendingShiftToClose = item;
        showCloseConfirmModal = true;
    }

    private void CancelCloseModal()
    {
        showCloseConfirmModal = false;
        pendingShiftToClose = null;
    }

    private async Task ConfirmCloseShiftAsync()
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("Permission denied: Role 511 (Billing Portal > Counter Shift > Delete) is required to close counter shifts.");
            return;
        }

        if (pendingShiftToClose == null) return;
        var item = pendingShiftToClose;
        var counterName = counters.FirstOrDefault(c => c.cntcode == item.cntcode)?.name ?? $"Counter {item.cntcode}";

        bool isFixed = string.Equals(cachedLabSetting?.shift_timing_mode, "FIXED", StringComparison.OrdinalIgnoreCase)
                       || string.Equals(item.shift_mode, "FIXED", StringComparison.OrdinalIgnoreCase);

        if (isFixed)
        {
            ToastService.ShowWarning("The fixed timing shift cannot be closed manually. It will close automatically at the configured time or at midnight (12:00 AM).");
            showCloseConfirmModal = false;
            pendingShiftToClose = null;
            return;
        }

        isClosingInPlace = true;
        StateHasChanged();
        try
        {
            var req = new Booking.Models.CloseShiftRequest
            {
                cnttid = item.cnttid.ToString(),
                usercode = closeRequest.usercode,
                close_type = cachedLabSetting?.shift_timing_mode ?? item.shift_mode ?? "VARIABLE"
            };
            var result = await HmsBillingService.CloseShiftAsync(req);
            var parseResult = ParseApiResponse(result, $"Shift for {counterName} closed successfully.");
            if (parseResult.Success)
            {
                ToastService.ShowSuccess($"{parseResult.Message}");
                await LoadOpenCountersAsync();
                showCloseConfirmModal = false;
                pendingShiftToClose = null;
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError($"Failed to close shift: {parseResult.Message}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isClosingInPlace = false;
            showCloseConfirmModal = false;
            pendingShiftToClose = null;
            StateHasChanged();
        }
    }

    private async Task PerformLogoutAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("medicoSessionHelper.clearSession");
        }
        catch { }
        try
        {
            await JSRuntime.InvokeVoidAsync("medicoTabs.clearTabs");
        }
        catch { }
        var keysToDelete = new[]
        {
            "authToken", "auth_token", "tenant_code", "tenant_name",
            "UserDetails", "UserRights", "UserRolePermissions",
            "bhcode", "session_branch_confirmed", "UserBranches", "UserBranchCodes",
            "user_name", "login_input", "user_role", "user_description",
            "user_code", "IsTenantAdmin", "cntcode"
        };
        foreach (var key in keysToDelete)
        {
            try { await _sessionStorage.DeleteAsync(key); } catch { }
        }
        TenantState.Clear();
        Nav.NavigateTo("/user-login", forceLoad: true);
    }

    private (bool Success, string Message) ParseApiResponse(string result, string defaultSuccessMessage)
    {
        if (string.IsNullOrEmpty(result))
        {
            return (false, "Empty response from server.");
        }

        if (result.Contains("Error", StringComparison.OrdinalIgnoreCase))
        {
            return (false, result);
        }

        if (result.Trim().StartsWith("{") && result.Trim().EndsWith("}"))
        {
            try
            {
                var jsonObj = Newtonsoft.Json.Linq.JObject.Parse(result);
                if (jsonObj["message"] != null)
                {
                    var msg = jsonObj["message"].ToString();
                    if (msg.Contains("safely shut down", StringComparison.OrdinalIgnoreCase) ||
                        msg.Contains("success", StringComparison.OrdinalIgnoreCase) ||
                        msg.Contains("ok", StringComparison.OrdinalIgnoreCase))
                    {
                        return (true, msg);
                    }
                    else
                    {
                        return (false, msg);
                    }
                }
                else if (jsonObj["cnttid"] != null || jsonObj["shiftsno"] != null)
                {
                    return (true, defaultSuccessMessage);
                }
                else if (jsonObj["errors"] != null)
                {
                    var errs = jsonObj["errors"];
                    var errorList = new List<string>();
                    foreach (var prop in errs.Children<Newtonsoft.Json.Linq.JProperty>())
                    {
                        foreach (var errVal in prop.Value)
                        {
                            errorList.Add(errVal.ToString());
                        }
                    }
                    return (false, string.Join("; ", errorList));
                }
                else
                {
                    return (false, result);
                }
            }
            catch
            {
                return (false, result);
            }
        }

        return (true, result);
    }

    private string GetFormattedPlannedTime(Booking.Models.CounterTimingDto shift)
    {
        if (shift.planned_to.HasValue)
        {
            var p = shift.planned_to.Value;
            return p.ToIndianTime().ToString("hh:mm tt");
        }
        if (!string.IsNullOrWhiteSpace(cachedLabSetting?.shift_end_time))
        {
            if (HmsBillingService.TryParseShiftEndTime(cachedLabSetting.shift_end_time, out var timeSpan))
            {
                var shiftFrom = (shift.fromdate ?? shift.counterdate ?? DateTime.UtcNow).ToIndianTime();
                var fixedEndTime = shiftFrom.Date.Add(timeSpan);
                if (shiftFrom < fixedEndTime)
                {
                    return fixedEndTime.ToString("hh:mm tt");
                }
                return "12:00 AM";
            }
        }
        return "12:00 AM";
    }
