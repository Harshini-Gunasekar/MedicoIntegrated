@page "/counter-shift"
@rendermode InteractiveServer
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.ToastService ToastService

<div class="shift-wrapper">
    <!-- Header -->
    <div class="shift-header">
        <div class="header-left">
            <div class="header-icon-box">
                <i class="bi bi-grid-fill"></i>
            </div>
            <div class="header-text-container">
                <h1 class="header-title">Counter Shift Management</h1>
                <span class="header-subtitle">Open or close a billing counter shift</span>
            </div>
        </div>
        <div class="header-right">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search areas..." />
            </div>
            <button class="btn-add-new">+ Add New</button>
        </div>
    </div>

    <div class="shift-grid">
        <!-- Open Shift Card -->
        <div class="shift-card card-open">
            <div class="shift-card-header open-header">
                <h2><i class="bi bi-box-arrow-in-up"></i> OPEN SHIFT</h2>
            </div>
            <div class="shift-card-body">
                <div class="shift-form-group">
                    <label>BRANCH CODE</label>
                    <select class="shift-input" @bind="openRequest.bhcode">
                        <option value="1">Erode Center (1)</option>
                        <option value="2">Main Branch (2)</option>
                        <option value="3">Salem Clinic (3)</option>
                    </select>
                </div>

                <div class="shift-form-group">
                    <label>COUNTER CODE</label>
                    <select class="shift-input" @bind="openRequest.cntcode">
                        <option value="1">Billing Counter 1 (1)</option>
                        <option value="2">Sample Counter (2)</option>
                        <option value="3">Billing Counter 2 (3)</option>
                    </select>
                </div>

                <div class="shift-form-group">
                    <label>COUNTER DATE</label>
                    <input type="date" class="shift-input" @bind="openRequestDate" />
                </div>
            </div>
            <div class="shift-card-footer">
                <button class="btn-outline-open" @onclick="OpenShift" disabled="@isOpening">
                    @if (isOpening)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="margin-right:8px;"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle"></i>
                    }
                    OPEN SHIFT
                </button>
            </div>
        </div>

        <!-- Close Shift Card -->
        <div class="shift-card card-close">
            <div class="shift-card-header close-header">
                <h2><i class="bi bi-x-circle"></i> CLOSE SHIFT</h2>
            </div>
            <div class="shift-card-body">
                <div class="shift-form-group">
                    <label>COUNTER TRANSACTION ID</label>
                    <input type="text" class="shift-input" placeholder="e.g. e1b12c6b-446e..." @bind="closeRequest.cnttid" />
                </div>

                <div class="shift-form-group">
                    <label>USER CODE</label>
                    <input type="number" class="shift-input" placeholder="e.g. 10" @bind="closeRequest.usercode" />
                </div>
            </div>
            <div class="shift-card-footer">
                <button class="btn-outline-close" @onclick="CloseShift" disabled="@isClosing">
                    @if (isClosing)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="margin-right:8px;"></span>
                    }
                    else
                    {
                        <i class="bi bi-x-circle"></i>
                    }
                    CLOSE SHIFT
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private Booking.Models.OpenShiftRequest openRequest = new Booking.Models.OpenShiftRequest
    {
        bhcode = 1,
        cntcode = 2,
        counterdate = DateTime.Today
    };
    
    private DateOnly openRequestDate = DateOnly.FromDateTime(DateTime.Today);

    private Booking.Models.CloseShiftRequest closeRequest = new Booking.Models.CloseShiftRequest
    {
        usercode = 10
    };

    private bool isOpening = false;
    private bool isClosing = false;

    private async Task OpenShift()
    {
        isOpening = true;
        try
        {
            openRequest.counterdate = openRequestDate.ToDateTime(TimeOnly.MinValue);
            var result = await HmsBillingService.OpenShiftAsync(openRequest);
            if (!string.IsNullOrEmpty(result) && !result.Contains("Error", StringComparison.OrdinalIgnoreCase))
            {
                ToastService.ShowSuccess("Shift opened successfully.");
            }
            else
            {
                ToastService.ShowError($"Failed to open shift: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isOpening = false;
        }
    }

    private async Task CloseShift()
    {
        if (string.IsNullOrWhiteSpace(closeRequest.cnttid))
        {
            ToastService.ShowError("Please enter a valid Counter Transaction ID.");
            return;
        }

        isClosing = true;
        try
        {
            var result = await HmsBillingService.CloseShiftAsync(closeRequest);
            if (!string.IsNullOrEmpty(result) && !result.Contains("Error", StringComparison.OrdinalIgnoreCase))
            {
                ToastService.ShowSuccess("Shift closed successfully.");
                closeRequest.cnttid = string.Empty; // clear on success
            }
            else
            {
                ToastService.ShowError($"Failed to close shift: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isClosing = false;
        }
    }
}
