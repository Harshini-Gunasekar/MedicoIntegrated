@code {
    private Booking.Models.BranchModel CurrentBranch = new Booking.Models.BranchModel();
    private bool showStateModal = false;
    private string newStateName = "";
    private string newStateShortName = "";
    private int? newStateOrderNo;
    private List<Booking.Models.BranchModel> Branches = new List<Booking.Models.BranchModel>();
    private List<CityModel> cities = new();
    private List<StateModel> states = new();
    private List<AreaModel> areas = new();
    private List<CountryModel> countries = new();
    private List<FeetypeModel> feeTypes = new();

    private string SearchQuery = "";
    private bool IsLoading = false;
    private string AlertMessage = "";
    private bool IsError = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private bool isEditMode = false;

    private string BaseUrl => "api/";
    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";

    protected override void OnInitialized()
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                Console.WriteLine($"[BranchMaster] Loaded session state: TenantCode='{TenantCode}', TokenLength={AuthToken?.Length ?? 0}");

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    IsLoading = true;
                    StateHasChanged();

                    // Load branches from LabCareUrl, lookups from DoctorApi
                    await Task.WhenAll(
                        LoadBranches(), 
                        LoadCities(), 
                        LoadStates(), 
                        LoadAreas(), 
                        LoadCountries(), 
                        LoadFeeTypes()
                    );
                }
                else
                {
                    Toast.ShowError("Access denied: Please log in again.");
                    NavigationManager.NavigateTo("/");
                }
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Session loading error: {ex.Message}");
                Console.Error.WriteLine($"Error getting tenant data: {ex.Message}");
            }
            finally
            {
                IsLoading = false;
                StateHasChanged();
            }
        }
    }

    private IEnumerable<Booking.Models.BranchModel> FilteredBranches =>
        Branches.Where(b =>
            (string.IsNullOrWhiteSpace(SearchQuery) ||
             (b.name != null && b.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
             (b.short_name != null && b.short_name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))));

    private HttpClient CreateClient(bool isLabCare = false)
    {
        var clientName = isLabCare ? "LabCareUrl" : "DoctorApi";
        var client = ClientFactory.CreateClient(clientName);
        
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        
        return client;
    }

    private async Task LoadBranches()
    {
        try
        {
            using var client = CreateClient(true);
            var response = await client.GetAsync($"{BaseUrl}Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                //Console.WriteLine($"[BranchMaster] Get Branches Payload:\n{json}");
                Branches = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new List<Booking.Models.BranchModel>();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Toast.ShowError($"Failed to load branches ({response.StatusCode}): {errorBody}");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading branches: {ex.Message}");
            Toast.ShowError($"Error loading branches: {ex.Message}");
        }
    }

    private async Task LoadCities()
    {
        try
        {
            using var client = CreateClient();
            cities = await client.GetFromJsonAsync<List<CityModel>>($"{BaseUrl}CityMaster/get") ?? new();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading cities: {ex.Message}");
        }
    }

    private async Task LoadStates()
    {
        try
        {
            using var client = CreateClient();
            states = await client.GetFromJsonAsync<List<StateModel>>($"{BaseUrl}StateMaster/get") ?? new();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading states: {ex.Message}");
        }
    }

    private async Task LoadAreas()
    {
        try
        {
            using var client = CreateClient();
            areas = await client.GetFromJsonAsync<List<AreaModel>>($"{BaseUrl}AreaMaster/get") ?? new();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading areas: {ex.Message}");
        }
    }

    private async Task LoadCountries()
    {
        try
        {
            using var client = CreateClient();
            countries = await client.GetFromJsonAsync<List<CountryModel>>($"{BaseUrl}CountryMaster/get") ?? new();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading countries: {ex.Message}");
        }
    }

    private async Task LoadFeeTypes()
    {
        try
        {
            using var client = CreateClient();
            feeTypes = await client.GetFromJsonAsync<List<FeetypeModel>>($"{BaseUrl}FeeTypeMaster/get") ?? new();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading feetypes: {ex.Message}");
        }
    }

    private void NewBranch()
    {
        CurrentBranch = new Booking.Models.BranchModel
        {
            deleted = false,
            is_main_branch = false,
            is_branch = true,
            is_collection_centre = false,
            order_no = Branches.Any() ? Branches.Max(b => b.order_no) + 1 : 1
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
        AlertMessage = "";
    }

    private void EditBranch(Booking.Models.BranchModel branch)
    {
        if (branch == null) return;
        // Deep copy
        var json = JsonConvert.SerializeObject(branch);
        CurrentBranch = JsonConvert.DeserializeObject<Booking.Models.BranchModel>(json) ?? new Booking.Models.BranchModel();
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
        AlertMessage = "";
    }

    private void CloseForm()
    {
        CurrentBranch = new Booking.Models.BranchModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
        AlertMessage = "";
    }

    private async Task SaveBranch()
    {
        isSubmitted = true;
        if (string.IsNullOrEmpty(TenantCode))
        {
            Toast.ShowError("Error: Tenant code is not loaded. Please refresh.");
            return;
        }

        if (string.IsNullOrWhiteSpace(CurrentBranch.name))
        {
            Toast.ShowError("Branch Name is required.");
            return;
        }

        if (string.IsNullOrWhiteSpace(CurrentBranch.short_name))
        {
            Toast.ShowError("Short Name is required.");
            return;
        }

        // Duplicate check
        if (Branches.Any(b => b.name?.Trim().Equals(CurrentBranch.name?.Trim(), StringComparison.OrdinalIgnoreCase) == true && b.bh_code != CurrentBranch.bh_code))
        {
            Toast.ShowError($"A branch with name '{CurrentBranch.name}' already exists.");
            return;
        }
        if (Branches.Any(b => b.short_name?.Trim().Equals(CurrentBranch.short_name?.Trim(), StringComparison.OrdinalIgnoreCase) == true && b.bh_code != CurrentBranch.bh_code))
        {
            Toast.ShowError($"A branch with short name '{CurrentBranch.short_name}' already exists.");
            return;
        }

        IsLoading = true;
        StateHasChanged();

        try
        {
            CurrentBranch.tenant_code = TenantCode;
            CurrentBranch.user_code = 1;
            CurrentBranch.computer_code = 1;
            CurrentBranch.entered_date = DateTime.Now;
            CurrentBranch.ibs_date = DateTime.Now;

            // Log JSON payload to the terminal
            var jsonPayload = JsonConvert.SerializeObject(CurrentBranch, Formatting.Indented);
            Console.WriteLine($"[BranchMaster] {(isEditMode ? "Updating" : "Inserting")} Branch. Payload:\n{jsonPayload}");

            using var client = CreateClient(true);
            HttpResponseMessage response;
            if (!isEditMode)
                response = await client.PostAsJsonAsync($"{BaseUrl}Branch/insert", CurrentBranch);
            else
                response = await client.PostAsJsonAsync($"{BaseUrl}Branch/update", CurrentBranch);

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(isEditMode ? "Branch updated successfully!" : "Branch created successfully!");
                CloseForm();
                await LoadBranches();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Toast.ShowError($"Save failed ({response.StatusCode}): {errorBody}");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Network error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleDelete(int bh_code)
    {
        if (bh_code == 0) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this branch?");
        if (!confirmed) return;

        IsLoading = true;
        StateHasChanged();

        try
        {
            using var client = CreateClient(true);
            var response = await client.GetAsync($"{BaseUrl}Branch/softdelete?bhcode={bh_code}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Branch deleted successfully.");
                await LoadBranches();
                if (CurrentBranch.bh_code == bh_code) showForm = false;
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Toast.ShowError($"Failed to delete ({response.StatusCode}): {errorBody}");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Delete error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void SetBranchType(string type)
    {
        CurrentBranch.is_main_branch = (type == "Main");
        CurrentBranch.is_branch = (type == "Branch");
        CurrentBranch.is_collection_centre = (type == "CC");
    }

    private void OnAreaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int areacodeVal))
        {
            CurrentBranch.area_code = areacodeVal;
            var area = areas.FirstOrDefault(a => a.areacode == areacodeVal);
            if (area != null)
            {
                CurrentBranch.pincode = area.areapincode;
                
                if (area.citycode.HasValue)
                {
                    var city = cities.FirstOrDefault(c => c.citycode == area.citycode.Value);
                    if (city != null) CurrentBranch.city = city.cityname;
                }
                
                if (area.statecode.HasValue)
                {
                    var stateObj = states.FirstOrDefault(s => s.statecode == area.statecode.Value);
                    if (stateObj != null) CurrentBranch.state = stateObj.statename;
                }

                if (area.countrycode.HasValue)
                {
                    var countryObj = countries.FirstOrDefault(c => c.countrycode == area.countrycode.Value);
                    if (countryObj != null) CurrentBranch.country = countryObj.countryname;
                }
            }
        }
    }

    private void OnPincodeChanged(ChangeEventArgs e)
    {
        string? selectedPincode = e.Value?.ToString();
        CurrentBranch.pincode = selectedPincode;
        
        if (!string.IsNullOrEmpty(selectedPincode))
        {
            var area = areas.FirstOrDefault(a => a.areapincode == selectedPincode);
            if (area != null)
            {
                CurrentBranch.area_code = area.areacode;
                
                if (area.citycode.HasValue)
                {
                    var city = cities.FirstOrDefault(c => c.citycode == area.citycode.Value);
                    if (city != null)
                    {
                        CurrentBranch.city = city.cityname;
                    }
                }
                
                if (area.statecode.HasValue)
                {
                    var stateObj = states.FirstOrDefault(s => s.statecode == area.statecode.Value);
                    if (stateObj != null)
                    {
                        CurrentBranch.state = stateObj.statename;
                    }
                }

                if (area.countrycode.HasValue)
                {
                    var countryObj = countries.FirstOrDefault(c => c.countrycode == area.countrycode.Value);
                    if (countryObj != null)
                    {
                        CurrentBranch.country = countryObj.countryname;
                    }
                }
            }
        }
    }

