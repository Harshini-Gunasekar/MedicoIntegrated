    private bool showAreaModal = false;
    private string newAreaName = "";
    private string newAreaShortName = "";
    private int? newAreaOrderNo;
    private string newAreaPincode = "";
    private string newAreaCityCode = "";
    private double? newAreaHomeCollectionCharge = 0;

    private void OpenQuickAreaModal()
    {
        newAreaName = "";
        newAreaShortName = "";
        newAreaOrderNo = null;
        newAreaPincode = "";
        newAreaCityCode = "";
        newAreaHomeCollectionCharge = 0;
        showAreaModal = true;
    }

    private async Task SaveQuickArea()
    {
        if (string.IsNullOrWhiteSpace(newAreaName))
        {
            Toast.ShowError("Area Name is required.");
            return;
        }
        try
        {
            int? parsedCityCode = null;
            if (int.TryParse(newAreaCityCode, out int cc))
            {
                parsedCityCode = cc;
            }

            var area = new AreaModel
            {
                areaname = newAreaName,
                shortname = newAreaShortName,
                orderno = newAreaOrderNo ?? 0,
                areapincode = newAreaPincode,
                citycode = parsedCityCode,
                homecollectioncharge = newAreaHomeCollectionCharge ?? 0,
                tenant_code = TenantCode,
                entereddate = DateTime.Now,
                ibsdate = DateTime.Now
            };

            if (parsedCityCode.HasValue)
            {
                var cityObj = cities.FirstOrDefault(c => c.citycode == parsedCityCode.Value);
                if (cityObj != null)
                {
                    area.statecode = cityObj.statecode;
                    area.countrycode = cityObj.countrycode;
                }
            }

            using var client = CreateClient();
            var response = await client.PostAsJsonAsync($"{BaseUrl}AreaMaster/insert", area);
            if (response.IsSuccessStatusCode)
            {
                showAreaModal = false;
                await LoadAreas();
                var savedArea = areas.FirstOrDefault(a => a.areaname?.Trim().Equals(newAreaName.Trim(), StringComparison.OrdinalIgnoreCase) == true);
                if (savedArea != null)
                {
                    CurrentBranch.area_code = savedArea.areacode;
                    CurrentBranch.pincode = savedArea.areapincode;
                    
                    if (savedArea.citycode.HasValue)
                    {
                        var city = cities.FirstOrDefault(c => c.citycode == savedArea.citycode.Value);
                        if (city != null) CurrentBranch.city = city.cityname;
                    }
                    
                    if (savedArea.statecode.HasValue)
                    {
                        var stateObj = states.FirstOrDefault(s => s.statecode == savedArea.statecode.Value);
                        if (stateObj != null) CurrentBranch.state = stateObj.statename;
                    }
                    
                    if (savedArea.countrycode.HasValue)
                    {
                        var countryObj = countries.FirstOrDefault(c => c.countrycode == savedArea.countrycode.Value);
                        if (countryObj != null) CurrentBranch.country = countryObj.countryname;
                    }
                }
                Toast.ShowSuccess("Area added successfully!");
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Toast.ShowError($"Failed to save area: {err}");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error: {ex.Message}");
        }
    }

