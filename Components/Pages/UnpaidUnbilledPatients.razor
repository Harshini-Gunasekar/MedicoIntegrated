    private async Task LoadDataAsync()
    {
        loading = true;
        StateHasChanged();

        try
        {
            // 1. Fetch OP Registrations
            var regsTask = BookingService.GetAllOpRegistrationsAsync();

            // 2. Fetch IP Registrations (Admitted and Discharged / All)
            var ipAdmittedTask = IpRegistrationService.GetIpRegistrationsAsync("ADMITTED");
            var ipDischargedTask = IpRegistrationService.GetIpRegistrationsAsync("DISCHARGED");

            // 3. Fetch All Unbilled Charges
            var unbilledTask = HmsBillingService.GetAllUnbilledChargesAsync();

            // 4. Fetch HMS Bills list
            var billsTask = HmsBillingService.ListBillsAsync(new HmsBillFilterRequest
            {
                fromdate = fromDate.Date,
                todate = toDate.Date.AddDays(1).AddSeconds(-1),
                pagesize = 1000
            });

            await Task.WhenAll(regsTask, ipAdmittedTask, ipDischargedTask, unbilledTask, billsTask);

            var opRegistrations = (await regsTask) ?? new();
            var ipAdmitted = (await ipAdmittedTask) ?? new();
            var ipDischarged = (await ipDischargedTask) ?? new();
            var allUnbilledCharges = (await unbilledTask) ?? new();
            var billsResponse = await billsTask;
            var bills = billsResponse?.data ?? new();

            // Combine and deduplicate IP registrations
            var ipRegistrations = ipAdmitted
                .Concat(ipDischarged)
                .GroupBy(x => x.ip_id)
                .Select(g => g.First())
                .ToList();

            // Group unbilled charges by opvisitid, ip_id, and custid (Only unbilled charges where billedstatus != true)
            var unbilledByOp = new Dictionary<string, List<UnbilledChargeSummary>>(StringComparer.OrdinalIgnoreCase);
            var unbilledByIp = new Dictionary<Guid, List<UnbilledChargeSummary>>();
            var unbilledByCust = new Dictionary<decimal, List<UnbilledChargeSummary>>();
            foreach (var charge in allUnbilledCharges)
            {
                // Exclude any charge where billedstatus is true
                if (charge.billedstatus == true) continue;

                if (charge.ip_id.HasValue && charge.ip_id.Value != Guid.Empty)
                {
                    if (!unbilledByIp.ContainsKey(charge.ip_id.Value))
                    {
                        unbilledByIp[charge.ip_id.Value] = new List<UnbilledChargeSummary>();
                    }
                    unbilledByIp[charge.ip_id.Value].Add(charge);
                }

                if (!string.IsNullOrEmpty(charge.opvisitid))
                {
                    var key = charge.opvisitid.Trim();
                    if (!unbilledByOp.ContainsKey(key))
                    {
                        unbilledByOp[key] = new List<UnbilledChargeSummary>();
                    }
                    unbilledByOp[key].Add(charge);
                }

                if (charge.custid.HasValue && charge.custid.Value > 0)
                {
                    var cid = charge.custid.Value;
                    if (!unbilledByCust.ContainsKey(cid))
                    {
                        unbilledByCust[cid] = new List<UnbilledChargeSummary>();
                    }
                    unbilledByCust[cid].Add(charge);
                }
            }

            // Index bills by opvisitid, ip_id, and custid
            var billsByOpVisitId = new Dictionary<string, HmsBillSummary>(StringComparer.OrdinalIgnoreCase);
            var billsByIpId = new Dictionary<Guid, HmsBillSummary>();
            var billsByCustId = new Dictionary<decimal, HmsBillSummary>();
            foreach (var b in bills)
            {
                if (b.ip_id.HasValue && b.ip_id.Value != Guid.Empty)
                {
                    billsByIpId[b.ip_id.Value] = b;
                }
                if (!string.IsNullOrWhiteSpace(b.opvisitid))
                {
                    billsByOpVisitId[b.opvisitid.Trim()] = b;
                }
                if (b.custid.HasValue && b.custid.Value > 0)
                {
                    billsByCustId[b.custid.Value] = b;
                }
            }

            var aggregated = new List<UnpaidUnbilledPatientItem>();

            // 1. Process OP Registrations
            foreach (var op in opRegistrations)
            {
                var opIdStr = op.op_id.ToString();
                var opNoStr = !string.IsNullOrWhiteSpace(op.op_no) ? op.op_no.Trim() : "";

                // Find matching bill by OP No, OP Guid, or CustId
                HmsBillSummary? bill = null;
                if (!string.IsNullOrEmpty(opNoStr) && billsByOpVisitId.TryGetValue(opNoStr, out var b1))
                {
                    bill = b1;
                }
                else if (!string.IsNullOrEmpty(opIdStr) && billsByOpVisitId.TryGetValue(opIdStr, out var b2))
                {
                    bill = b2;
                }
                else if (op.custid > 0 && billsByCustId.TryGetValue(op.custid, out var b3) && b3.ip_id == null)
                {
                    bill = b3;
                }

                bool isBilledOp = (bill != null) || string.Equals(op.billed_status, "BILLED", StringComparison.OrdinalIgnoreCase);
                bool hasUnpaidBill = bill != null && (bill.balance_amount ?? 0) > 0;

                // Find matching unbilled charges by OP Guid, OP No, or CustId
                var matchedCharges = new List<UnbilledChargeSummary>();
                if (!string.IsNullOrEmpty(opIdStr) && unbilledByOp.TryGetValue(opIdStr, out var c1))
                {
                    matchedCharges.AddRange(c1);
                }
                if (!string.IsNullOrEmpty(opNoStr) && unbilledByOp.TryGetValue(opNoStr, out var c2))
                {
                    foreach (var ch in c2)
                    {
                        if (!matchedCharges.Any(x => !string.IsNullOrEmpty(x.unbilledid) && string.Equals(x.unbilledid, ch.unbilledid, StringComparison.OrdinalIgnoreCase)))
                            matchedCharges.Add(ch);
                    }
                }

                // If already billed, ignore any leftover initial consultation / zero amount charges
                if (isBilledOp)
                {
                    matchedCharges = matchedCharges.Where(c => c.billedstatus != true && (c.amount ?? 0) > 0).ToList();
                }
                else
                {
                    matchedCharges = matchedCharges.Where(c => c.billedstatus != true).ToList();
                }

                bool hasUnbilledCharges = matchedCharges.Any();

                // An item is unbilled if it has active unbilled charges (billedstatus != true) OR the OP registration hasn't been billed yet
                bool isUnbilled = isBilledOp ? hasUnbilledCharges : (hasUnbilledCharges || op.unbilled_status != true);
                bool isUnpaid = isBilledOp ? hasUnpaidBill : (op.paid_status != true);

                // If the OP was already billed (bill exists or billed_status is BILLED) and has NO unbilled charges and NO unpaid balance, DO NOT DISPLAY!
                if (isBilledOp && !hasUnbilledCharges && !hasUnpaidBill)
                {
                    continue;
                }

                // Only include if either unbilled OR unpaid
                if (isUnbilled || isUnpaid)
                {
                    var item = new UnpaidUnbilledPatientItem
                    {
                        OpId = op.op_id,
                        BookingId = op.op_id,
                        TokenNo = op.token_no ?? "",
                        OpNo = op.op_no ?? "",
                        CustId = op.custid,
                        PatientName = !string.IsNullOrWhiteSpace(op.patient_name) ? op.patient_name : $"CUST-{op.custid}",
                        Mobile = op.mobile ?? "",
                        Dcode = op.dcode,
                        DoctorName = !string.IsNullOrWhiteSpace(op.doctor_name) ? op.doctor_name : GetDoctorName(op.dcode),
                        VisitDate = op.visit_date,
                        RegType = op.reg_type ?? "OP",
                        VisitStatus = op.visit_status ?? "",
                        IsVip = op.isvip == true || op.is_vip == true,
                        IsIpReferred = op.refer_to_ip == true,
                        IsIpAdmission = false,
                        IsDressing = op.is_dressing,
                        IsUnbilled = isUnbilled,
                        IsUnpaid = isUnpaid,
                        UnbilledCharges = matchedCharges,
                        HasBill = bill != null,
                        BillNo = bill?.bill_no,
                        BillNetAmount = (decimal)(bill?.net_amount ?? 0),
                        BillPaidAmount = (decimal)(bill?.paid_amount ?? 0),
                        BillBalanceAmount = (decimal)(bill?.balance_amount ?? 0),
                        RequestGuid = bill?.requestguid,
                        CntCode = bill?.cntcode,
                        EnteredBhCode = bill?.enteredbhcode,
                        BillSummary = bill
                    };

                    aggregated.Add(item);
                }
            }

            // 2. Process IP Registrations
            foreach (var ip in ipRegistrations)
            {
                var ipIdStr = ip.ip_id.ToString();
                var ipNoStr = !string.IsNullOrWhiteSpace(ip.ip_no) ? ip.ip_no.Trim() : "";

                // Find matching bill by IP ID, IP No, or CustId with matching ip_id
                HmsBillSummary? bill = null;
                if (billsByIpId.TryGetValue(ip.ip_id, out var bIp))
                {
                    bill = bIp;
                }
                else if (!string.IsNullOrEmpty(ipNoStr) && billsByOpVisitId.TryGetValue(ipNoStr, out var bNo))
                {
                    bill = bNo;
                }
                else if (!string.IsNullOrEmpty(ipIdStr) && billsByOpVisitId.TryGetValue(ipIdStr, out var bId))
                {
                    bill = bId;
                }
                else if (ip.custid > 0 && billsByCustId.TryGetValue(ip.custid, out var bCust) && bCust.ip_id == ip.ip_id)
                {
                    bill = bCust;
                }

                bool isBilledIp = (bill != null);
                bool hasUnpaidBill = bill != null && (bill.balance_amount ?? 0) > 0;

                // Match unbilled charges by IP ID, IP No, IP Guid string, or CustId (for IP charges)
                var matchedCharges = new List<UnbilledChargeSummary>();
                if (unbilledByIp.TryGetValue(ip.ip_id, out var cIp))
                {
                    matchedCharges.AddRange(cIp);
                }
                if (!string.IsNullOrEmpty(ipNoStr) && unbilledByOp.TryGetValue(ipNoStr, out var cNo))
                {
                    foreach (var ch in cNo)
                    {
                        if (!matchedCharges.Any(x => !string.IsNullOrEmpty(x.unbilledid) && string.Equals(x.unbilledid, ch.unbilledid, StringComparison.OrdinalIgnoreCase)))
                            matchedCharges.Add(ch);
                    }
                }
                if (!string.IsNullOrEmpty(ipIdStr) && unbilledByOp.TryGetValue(ipIdStr, out var cId))
                {
                    foreach (var ch in cId)
                    {
                        if (!matchedCharges.Any(x => !string.IsNullOrEmpty(x.unbilledid) && string.Equals(x.unbilledid, ch.unbilledid, StringComparison.OrdinalIgnoreCase)))
                            matchedCharges.Add(ch);
                    }
                }
                if (ip.custid > 0 && unbilledByCust.TryGetValue(ip.custid, out var cCust))
                {
                    foreach (var ch in cCust.Where(c => c.ip_id == ip.ip_id))
                    {
                        if (!matchedCharges.Any(x => !string.IsNullOrEmpty(x.unbilledid) && string.Equals(x.unbilledid, ch.unbilledid, StringComparison.OrdinalIgnoreCase)))
                            matchedCharges.Add(ch);
                    }
                }

                if (isBilledIp)
                {
                    matchedCharges = matchedCharges.Where(c => c.billedstatus != true && (c.amount ?? 0) > 0).ToList();
                }
                else
                {
                    matchedCharges = matchedCharges.Where(c => c.billedstatus != true).ToList();
                }

                bool hasUnbilledCharges = matchedCharges.Any();

                // An IP registration is unbilled if no final bill has been generated OR active unbilled charges exist
                bool isUnbilled = !isBilledIp || hasUnbilledCharges;
                bool isUnpaid = isBilledIp ? hasUnpaidBill : true;

                // If the IP registration was already billed and has NO unbilled charges and NO unpaid balance, DO NOT DISPLAY!
                if (isBilledIp && !hasUnbilledCharges && !hasUnpaidBill)
                {
                    continue;
                }

                if (isUnbilled || isUnpaid)
                {
                    var item = new UnpaidUnbilledPatientItem
                    {
                        IpId = ip.ip_id,
                        OpId = ip.op_id ?? Guid.Empty,
                        BookingId = ip.booking_id ?? Guid.Empty,
                        TokenNo = "-",
                        OpNo = !string.IsNullOrWhiteSpace(ip.ip_no) ? ip.ip_no : "-",
                        IpNo = ip.ip_no ?? "",
                        CustId = ip.custid,
                        PatientName = !string.IsNullOrWhiteSpace(ip.patient_name) ? ip.patient_name : $"CUST-{ip.custid}",
                        Mobile = ip.mobile ?? "",
                        Dcode = ip.dcode,
                        DoctorName = GetDoctorName(ip.dcode),
                        VisitDate = DateOnly.FromDateTime(ip.admitdate),
                        RegType = "IP",
                        VisitStatus = ip.ip_status ?? "ADMITTED",
                        IsVip = ip.isvip == true || ip.is_vip == true,
                        IsIpReferred = false,
                        IsIpAdmission = true,
                        IsDressing = false,
                        IsUnbilled = isUnbilled,
                        IsUnpaid = isUnpaid,
                        UnbilledCharges = matchedCharges,
                        HasBill = bill != null,
                        BillNo = bill?.bill_no,
                        BillNetAmount = (decimal)(bill?.net_amount ?? 0),
                        BillPaidAmount = (decimal)(bill?.paid_amount ?? 0),
                        BillBalanceAmount = (decimal)(bill?.balance_amount ?? 0),
                        RequestGuid = bill?.requestguid,
                        CntCode = bill?.cntcode,
                        EnteredBhCode = bill?.enteredbhcode,
                        BillSummary = bill
                    };

                    aggregated.Add(item);
                }
            }

            allItems = aggregated;
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in LoadDataAsync: {ex.Message}");
            ToastService.ShowError($"Failed to load unpaid and unbilled data: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private string GetDoctorName(int dcode)
    {
        var doc = doctors.FirstOrDefault(d => d.dcode == dcode);
        return doc != null ? $"Dr. {doc.name}" : $"Doctor #{dcode}";
    }

    private void ApplyFilters()
    {
        var query = allItems.AsQueryable();

        // 1. Date Range Filter
        var fromDateOnly = DateOnly.FromDateTime(fromDate);
        var toDateOnly = DateOnly.FromDateTime(toDate);
        query = query.Where(x => (x.VisitDate >= fromDateOnly && x.VisitDate <= toDateOnly) || (x.IsIpAdmission && string.Equals(x.VisitStatus, "ADMITTED", StringComparison.OrdinalIgnoreCase)));

        // 2. Doctor Filter
        if (selectedDoctorCode > 0)
        {
            query = query.Where(x => x.Dcode == selectedDoctorCode);
        }

        // 3. Category Filter
        if (selectedCategory == "UNBILLED")
        {
            query = query.Where(x => x.IsUnbilled);
        }
        else if (selectedCategory == "UNPAID")
        {
            query = query.Where(x => x.IsUnpaid);
        }

        // 4. Patient Type Filter (ALL, OP, IP)
        if (selectedPatientType == "OP")
        {
            query = query.Where(x => !x.IsIpAdmission);
        }
        else if (selectedPatientType == "IP")
        {
            query = query.Where(x => x.IsIpAdmission);
        }

        // 5. Search Filter
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var s = searchQuery.Trim().ToLower();
            query = query.Where(x =>
                x.PatientName.ToLower().Contains(s) ||
                x.OpNo.ToLower().Contains(s) ||
                (!string.IsNullOrEmpty(x.IpNo) && x.IpNo.ToLower().Contains(s)) ||
                x.CustId.ToString().Contains(s) ||
                ("cust-" + x.CustId).ToLower().Contains(s) ||
                x.Mobile.ToLower().Contains(s) ||
                (x.BillNo != null && x.BillNo.ToLower().Contains(s)) ||
                x.DoctorName.ToLower().Contains(s) ||
                x.TokenNo.Contains(s) ||
                x.RegType.ToLower().Contains(s)
            );
        }

        var list = query.ToList();
        filteredItems = list
            .OrderByDescending(x => x.VisitDate)
            .ThenByDescending(x => int.TryParse(x.TokenNo, out int t) ? t : 0)
            .ToList();

        currentPage = 1;
    }

