    private async Task HandleRowDoubleClick(UnpaidUnbilledPatientItem item)
    {
        if (ResolvedMode == "UNPAID" || (item.HasBill && item.IsUnpaid))
        {
            await OpenPayment(item);
        }
        else
        {
            await OpenBilling(item);
        }
    }

    private async Task OpenBilling(UnpaidUnbilledPatientItem item)
    {
        if (IsModal)
        {
            if (OnPatientSelected.HasDelegate)
            {
                await OnPatientSelected.InvokeAsync(item);
            }
            if (OnClose.HasDelegate)
            {
                await OnClose.InvokeAsync();
            }
        }
        else
        {
            if (item.IpId.HasValue && item.IpId.Value != Guid.Empty)
            {
                NavigationManager.NavigateTo($"/billing/{item.IpId.Value}");
            }
            else if (item.OpId != Guid.Empty)
            {
                NavigationManager.NavigateTo($"/billing/{item.OpId}");
            }
            else if (!string.IsNullOrEmpty(item.OpNo) && item.OpNo != "-")
            {
                NavigationManager.NavigateTo($"/billing/{item.OpNo}");
            }
            else
            {
                NavigationManager.NavigateTo($"/billing/{item.CustId}");
            }
        }
    }

    private async Task OpenPayment(UnpaidUnbilledPatientItem item)
    {
        HmsBillSummary? bill = item.BillSummary;
        if (bill == null && !string.IsNullOrEmpty(item.BillNo))
        {
            try
            {
                var billsResp = await HmsBillingService.ListBillsAsync(new HmsBillFilterRequest { search = item.BillNo, pagesize = 5 });
                bill = billsResp?.data?.FirstOrDefault(b => b.bill_no == item.BillNo || (item.IpId.HasValue && b.ip_id == item.IpId.Value) || b.opvisitid == item.OpId.ToString() || (!string.IsNullOrEmpty(item.OpNo) && b.opvisitid == item.OpNo));
            }
            catch { }
        }

        if (bill == null)
        {
            bill = new HmsBillSummary
            {
                bill_no = item.BillNo,
                patient_name = item.PatientName,
                custid = item.CustId,
                doctor_name = item.DoctorName,
                net_amount = (double)item.BillNetAmount,
                paid_amount = (double)item.BillPaidAmount,
                balance_amount = (double)item.OutstandingAmount,
                ip_id = item.IpId,
                opvisitid = item.IpId.HasValue ? (item.IpNo ?? item.OpNo) : item.OpId.ToString(),
                requestguid = item.RequestGuid ?? (item.IpId.HasValue ? item.IpId.Value.ToString() : item.OpId.ToString()),
                cntcode = item.CntCode ?? 1,
                enteredbhcode = item.EnteredBhCode ?? (TenantState.BranchCode > 0 ? TenantState.BranchCode.Value : 1)
            };
        }

        selectedBillForPayment = bill;
        var dueAmt = bill.balance_amount ?? (double)item.OutstandingAmount;

        decimal? defaultPmc1 = null;
        decimal? defaultPmc2 = null;
        decimal? defaultPmc3 = null;

        if (paymodes != null && paymodes.Count > 0)
        {
            var cashPm = paymodes.FirstOrDefault(p => string.Equals(p.shortname, "CASH", StringComparison.OrdinalIgnoreCase));
            defaultPmc1 = cashPm != null ? cashPm.pmcode : paymodes[0].pmcode;

            var cardPm = paymodes.FirstOrDefault(p => string.Equals(p.shortname, "CARD", StringComparison.OrdinalIgnoreCase));
            if (cardPm != null) defaultPmc2 = cardPm.pmcode;

            var upiPm = paymodes.FirstOrDefault(p => string.Equals(p.shortname, "UPI", StringComparison.OrdinalIgnoreCase) || string.Equals(p.shortname, "GPAY", StringComparison.OrdinalIgnoreCase));
            if (upiPm != null) defaultPmc3 = upiPm.pmcode;
        }

        paymentRequest = new HmsPaymentRequest
        {
            requestguid = bill.requestguid,
            amount = 0,
            collection_type = "CASH",
            cntcode = bill.cntcode ?? (counters.FirstOrDefault()?.cntcode != null ? (int)counters.First().cntcode : 1),
            enteredbhcode = bill.enteredbhcode ?? (TenantState.BranchCode > 0 ? TenantState.BranchCode.Value : 1),
            usercode = TenantState.UserCode > 0 ? TenantState.UserCode : 101,
            computercode = 1,
            reference_no = "",
            bank_name = "",
            pmc1 = defaultPmc1,
            pmc1_amount = null,
            pmc2 = defaultPmc2,
            pmc2_amount = null,
            pmc3 = defaultPmc3,
            pmc3_amount = null
        };

        showPaymode2 = false;
        showPaymode3 = false;
        showPaymentModal = true;

        if (item.CustId > 0)
        {
            await CheckPatientAdvanceAsync(item.CustId);
        }
    }

