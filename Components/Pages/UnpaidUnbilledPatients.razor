    {
        fromDate = DateTime.UtcNow.ToIndianTime().Date;
        toDate = DateTime.UtcNow.ToIndianTime().Date;
        selectedDoctorCode = 0;
        selectedPatientType = "ALL";
        if (ResolvedMode == "UNBILLED") selectedCategory = "UNBILLED";
        else if (ResolvedMode == "UNPAID") selectedCategory = "UNPAID";
        else selectedCategory = "ALL";
        searchQuery = string.Empty;
        ApplyFilters();
    }

