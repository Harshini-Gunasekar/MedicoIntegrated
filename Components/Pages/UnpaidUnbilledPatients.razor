@page "/billing/unpaid-unbilled"
@page "/billing/unbilled-patients"
@page "/billing/unbilled"
@page "/billing/unpaid-patients"
@page "/billing/unpaid"
@rendermode InteractiveServer
@using Booking.Models
@using Booking.Services
@using Booking.Helpers
@using medico_backend.Model
@using Medico_Backend.Model
@using Newtonsoft.Json
@inject HmsBillingService HmsBillingService
@inject AppointmentBookingService BookingService
@inject Booking.Services.IpRegistrationService IpRegistrationService
@inject DoctorService DoctorService
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.CounterMasterService CounterMasterService
@inject Booking.Services.PaymodeMasterService PaymodeMasterService
@inject Booking.Services.HmsDueCollectionService DueCollectionService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

@if (!IsModal)
{
    <PageTitle>@PageTitleText</PageTitle>
}

<div class="@(IsModal ? "unpaid-modal-backdrop" : "unpaid-standalone-wrapper")" @onclick="HandleBackdropClick">
    <div class="@(IsModal ? "unpaid-modal-dialog" : "unpaid-page-wrapper")" @onclick:stopPropagation="IsModal">
        <div class="@(IsModal ? "unpaid-modal-body-scroll" : "unpaid-page-content-wrapper")">
            <!-- Header Section -->
            <div class="page-header-card">
                <div class="header-title-group">
                    <div class="header-icon-box">
                        <i class="@HeaderIconClass"></i>
                    </div>
                    <div>
                        <h2 class="header-title">@HeaderTitleText</h2>
                        <div class="header-subtitle">
                            <span class="status-pulse-dot"></span>
                            <span>@HeaderSubtitleText</span>
                        </div>
                    </div>
                </div>

                <!-- Top Metrics Cards & Close Button on Same Row -->
                <div class="header-metrics-row">
                    @if (ResolvedMode == "UNBILLED")
                    {
                        <div class="metric-card total-card">
                            <div class="metric-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">TOTAL UNBILLED</span>
                                <span class="metric-val">@filteredItems.Count</span>
                            </div>
                        </div>

                        <div class="metric-card unbilled-card">
                            <div class="metric-icon">
                                <i class="bi bi-file-earmark-medical-fill"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">WITH CHARGES</span>
                                <span class="metric-val">@filteredItems.Count(x => x.UnbilledCharges.Any())</span>
                            </div>
                        </div>

                        <div class="metric-card ip-card">
                            <div class="metric-icon">
                                <i class="bi bi-hospital"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">IP ADMISSIONS</span>
                                <span class="metric-val">@filteredItems.Count(x => x.IsIpAdmission)</span>
                            </div>
                        </div>

                        <div class="metric-card unpaid-card">
                            <div class="metric-icon">
                                <i class="bi bi-person-walking"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">OP VISITS</span>
                                <span class="metric-val">@filteredItems.Count(x => !x.IsIpAdmission)</span>
                            </div>
                        </div>

                        <div class="metric-card amount-card">
                            <div class="metric-icon">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">TOTAL UNBILLED VALUE</span>
                                <span class="metric-val">₹@string.Format("{0:N2}", TotalOutstandingAmount)</span>
                            </div>
                        </div>
                    }
                    else if (ResolvedMode == "UNPAID")
                    {
                        <div class="metric-card total-card">
                            <div class="metric-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">TOTAL UNPAID</span>
                                <span class="metric-val">@filteredItems.Count</span>
                            </div>
                        </div>

                        <div class="metric-card unbilled-card">
                            <div class="metric-icon">
                                <i class="bi bi-file-earmark-text-fill"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">UNPAID BILLS</span>
                                <span class="metric-val">@filteredItems.Count(x => x.HasBill)</span>
                            </div>
                        </div>

                        <div class="metric-card ip-card">
                            <div class="metric-icon">
                                <i class="bi bi-hospital"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">IP CASES</span>
                                <span class="metric-val">@filteredItems.Count(x => x.IsIpAdmission)</span>
                            </div>
                        </div>

                        <div class="metric-card unpaid-card">
                            <div class="metric-icon">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">PARTIAL DUE</span>
                                <span class="metric-val">@filteredItems.Count(x => x.BillPaidAmount > 0)</span>
                            </div>
                        </div>

                        <div class="metric-card amount-card">
                            <div class="metric-icon">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">TOTAL OUTSTANDING</span>
                                <span class="metric-val">₹@string.Format("{0:N2}", TotalOutstandingAmount)</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="metric-card total-card">
                            <div class="metric-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">TOTAL PENDING</span>
                                <span class="metric-val">@filteredItems.Count</span>
                            </div>
                        </div>

                        <div class="metric-card unbilled-card">
                            <div class="metric-icon">
                                <i class="bi bi-file-earmark-text-fill"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">UNBILLED CASES</span>
                                <span class="metric-val">@filteredItems.Count(x => x.IsUnbilled)</span>
                            </div>
                        </div>

                        <div class="metric-card ip-card">
                            <div class="metric-icon">
                                <i class="bi bi-hospital"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">IP CASES</span>
                                <span class="metric-val">@filteredItems.Count(x => x.IsIpAdmission)</span>
                            </div>
                        </div>

                        <div class="metric-card unpaid-card">
                            <div class="metric-icon">
                                <i class="bi bi-exclamation-octagon-fill"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">UNPAID BILLS</span>
                                <span class="metric-val">@filteredItems.Count(x => x.IsUnpaid)</span>
                            </div>
                        </div>

                        <div class="metric-card amount-card">
                            <div class="metric-icon">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <div class="metric-content">
                                <span class="metric-label">TOTAL OUTSTANDING</span>
                                <span class="metric-val">₹@string.Format("{0:N2}", TotalOutstandingAmount)</span>
                            </div>
                        </div>
                    }

                    @if (IsModal)
                    {
                        <button type="button" class="btn-close-modal-custom" @onclick="CloseModal" title="Close Pop-up">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
            </div>

    <!-- Filters Card -->
    <div class="filters-card">
        <div class="filters-grid @(ResolvedMode != "ALL" ? "filters-grid-compact" : "")">
            <!-- Date Filter (From Date) -->
            <div class="filter-group">
                <label class="filter-label">FROM DATE</label>
                <div class="input-with-icon">
                    <i class="bi bi-calendar-event"></i>
                    <input type="date" class="form-control filter-control" value="@fromDate.ToString("yyyy-MM-dd")" @onchange="OnFromDateChanged" />
                </div>
            </div>

            <!-- Date Filter (To Date) -->
            <div class="filter-group">
                <label class="filter-label">TO DATE</label>
                <div class="input-with-icon">
                    <i class="bi bi-calendar-event"></i>
                    <input type="date" class="form-control filter-control" value="@toDate.ToString("yyyy-MM-dd")" @onchange="OnToDateChanged" />
                </div>
            </div>

            <!-- Patient Type Filter (All, OP, IP) -->
            <div class="filter-group">
                <label class="filter-label">PATIENT TYPE</label>
                <div class="input-with-icon">
                    <i class="bi bi-hospital"></i>
                    <select class="form-select filter-control" value="@selectedPatientType" @onchange="OnPatientTypeChanged">
                        <option value="ALL">All Types (OP & IP)</option>
                        <option value="OP">OP Visits Only</option>
                        <option value="IP">IP Admissions Only</option>
                    </select>
                </div>
            </div>

            <!-- Doctor Filter -->
            <div class="filter-group">
                <label class="filter-label">DOCTOR</label>
                <div class="input-with-icon">
                    <i class="bi bi-person-badge"></i>
                    <select class="form-select filter-control" value="@selectedDoctorCode" @onchange="OnDoctorChanged">
                        <option value="0">All Doctors</option>
                        @foreach (var doc in doctors)
                        {
                            <option value="@doc.dcode">@(string.IsNullOrWhiteSpace(doc.name) ? $"Doctor #{doc.dcode}" : $"Dr. {doc.name}")</option>
                        }
                    </select>
                </div>
            </div>

            @if (ResolvedMode == "ALL")
            {
                <!-- Status Filter Type (All, Unbilled Only, Unpaid Only) -->
                <div class="filter-group">
                    <label class="filter-label">STATUS CATEGORY</label>
                    <div class="input-with-icon">
                        <i class="bi bi-funnel"></i>
                        <select class="form-select filter-control" value="@selectedCategory" @onchange="OnCategoryChanged">
                            <option value="ALL">All (Unbilled & Unpaid)</option>
                            <option value="UNBILLED">Unbilled Only</option>
                            <option value="UNPAID">Unpaid / Due Only</option>
                        </select>
                    </div>
                </div>
            }

            <!-- Search Bar -->
            <div class="filter-group filter-search-group">
                <label class="filter-label">SEARCH PATIENT / OP / IP / BILL</label>
                <div class="input-with-icon">
                    <i class="bi bi-search"></i>
                    <input type="text" class="form-control filter-control" placeholder="Search by Name, OP No, IP No, Cust ID, Mobile..." value="@searchQuery" @oninput="OnSearchInput" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button type="button" class="btn-clear-search" @onclick="ClearSearch" title="Clear search">&times;</button>
                    }
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="filter-actions-group">
                <button type="button" class="btn-filter-action btn-refresh" @onclick="LoadDataAsync" title="Reload data">
                    <i class="bi bi-arrow-clockwise @(loading ? "spin" : "")"></i> Refresh
                </button>
                <button type="button" class="btn-filter-action btn-reset" @onclick="ResetFilters" title="Reset all filters">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </button>
            </div>
        </div>

        <!-- Quick Filter Chips -->
        <div class="quick-chips-row">
            <div class="chips-left">
                <button type="button" class="quick-chip @(isTodayFilter ? "active" : "")" @onclick="SetTodayFilter">
                    <i class="bi bi-calendar-check me-1"></i> Today
                </button>
                <button type="button" class="quick-chip @(isYesterdayFilter ? "active" : "")" @onclick="SetYesterdayFilter">
                    <i class="bi bi-calendar-minus me-1"></i> Yesterday
                </button>
                <button type="button" class="quick-chip @(isLast7DaysFilter ? "active" : "")" @onclick="SetLast7DaysFilter">
                    <i class="bi bi-calendar-week me-1"></i> Last 7 Days
                </button>
                <button type="button" class="quick-chip @(isThisMonthFilter ? "active" : "")" @onclick="SetThisMonthFilter">
                    <i class="bi bi-calendar-month me-1"></i> This Month
                </button>
                <span class="mx-1 text-muted">|</span>
                <button type="button" class="quick-chip @(selectedPatientType == "ALL" ? "active" : "")" @onclick='() => SetPatientTypeQuick("ALL")'>
                    <i class="bi bi-grid me-1"></i> All
                </button>
                <button type="button" class="quick-chip @(selectedPatientType == "OP" ? "active" : "")" @onclick='() => SetPatientTypeQuick("OP")'>
                    <i class="bi bi-person me-1"></i> OP Only
                </button>
                <button type="button" class="quick-chip @(selectedPatientType == "IP" ? "active" : "")" @onclick='() => SetPatientTypeQuick("IP")'>
                    <i class="bi bi-hospital me-1"></i> IP Only
                </button>
            </div>
            <div class="chips-right">
                <span class="active-count-badge">
                    <i class="bi bi-card-checklist me-1"></i> Showing <strong>@filteredItems.Count</strong> entries
                </span>
            </div>
        </div>
    </div>

    <!-- Main Content Table Card -->
    <div class="data-table-card">
        <!-- Table Header Bar -->
        <div class="table-bar-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-list-columns-reverse text-primary" style="font-size: 1.05rem;"></i>
                <span class="table-bar-title">@TableTitleText</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <!-- Pagination Toggle Button -->
                <button type="button" 
                        class="btn-pagination-toggle @(!enablePagination ? "show-all-active" : "")" 
                        @onclick="TogglePagination"
                        title="@(enablePagination ? "Click to disable pagination and show all data" : "Click to enable pagination (10 per page)")">
                    <i class="bi @(!enablePagination ? "bi-list-stars" : "bi-files")"></i>
                    <span>@(!enablePagination ? "Show All (All Data)" : "Pagination (10/Page)")</span>
                    <span class="badge @(!enablePagination ? "bg-secondary" : "bg-primary")">@(!enablePagination ? "OFF" : "ON")</span>
                </button>

                @if (enablePagination && filteredItems.Any())
                {
                    <span style="font-size: 0.78rem; color: #64748b; font-weight: 600;">
                        Page @currentPage of @((int)Math.Ceiling((double)filteredItems.Count / pageSize))
                    </span>
                }
            </div>
        </div>

        @if (loading)
        {
            <div class="table-loading-container">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted fw-semibold">Loading unbilled and unpaid patient records...</p>
            </div>
        }
        else if (!filteredItems.Any())
        {
            <div class="empty-state-box">
                <div class="empty-icon-circle">
                    <i class="bi bi-check2-all text-success"></i>
                </div>
                <h4>No Pending Records Found</h4>
                <p>All patient visits and bills for the selected filter criteria are fully billed and settled.</p>
                <button type="button" class="btn btn-sm btn-outline-primary mt-2" @onclick="ResetFilters">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                </button>
            </div>
        }
        else
        {
            var displayList = enablePagination 
                ? filteredItems.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList() 
                : filteredItems;

            <div class="table-responsive" style="overflow-x: hidden !important;">
                <table class="medico-table">
                    <thead>
                        <tr>
                            <th style="width: 75px;">Token</th>
                            <th>Patient Details</th>
                            <th>OP / IP Number</th>
                            <th>Visit / Admit Date</th>
                            <th>Doctor</th>
                            <th>Reg Type</th>
                            <th>Unbilled Items</th>
                            <th>Bill & Paid Status</th>
                            <th style="text-align: right;">Outstanding (₹)</th>
                            @if (!IsModal && ResolvedMode != "UNPAID")
                            {
                                <th style="text-align: center; width: 140px;">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in displayList)
                        {
                            <tr @ondblclick="() => HandleRowDoubleClick(item)" style="cursor: pointer;" title="@(IsModal ? $"Double-click to load {item.PatientName} for billing" : (ResolvedMode == "UNPAID" ? $"Double-click to open Cash Counter Payment for {item.PatientName}" : $"Double-click to open Billing for {item.PatientName}"))">
                                <!-- Token No -->
                                <td>
                                    @if (item.IsIpAdmission)
                                    {
                                        <span class="badge" style="font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; background: #f3e8ff; color: #7e22ce; border: 1px solid #d8b4fe; font-weight: 700;">IP</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(item.TokenNo) && item.TokenNo != "0" && item.TokenNo != "-")
                                    {
                                        <span class="badge-op">@item.TokenNo</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="margin-left: 10px; font-weight: 700;">-</span>
                                    }
                                </td>

                                <!-- Patient Details -->
                                <td>
                                    <div class="patient-name-block">
                                        <span class="pat-name">@item.PatientName</span>
                                        @if (item.IsVip)
                                        {
                                            <span class="vip-badge">VIP</span>
                                        }
                                        @if (item.IsIpAdmission)
                                        {
                                            <span class="badge-type ip" style="font-size: 0.65rem; padding: 2px 6px;">IP</span>
                                        }
                                        else if (item.IsIpReferred)
                                        {
                                            <span class="ip-referred-badge">IP Referred</span>
                                        }
                                    </div>
                                    <div class="patient-sub-block">
                                        @if (!string.IsNullOrWhiteSpace(item.Mobile))
                                        {
                                            <span class="text-muted"><i class="bi bi-telephone me-1"></i>@item.Mobile</span>
                                        }
                                        <span class="text-muted ms-1" style="font-size: 0.72rem; font-weight: 600;">#@item.CustId</span>
                                    </div>
                                </td>

                                <!-- OP / IP No -->
                                <td>
                                    @if (item.IsIpAdmission)
                                    {
                                        <span class="fw-bold" style="color: #7e22ce;" title="In-Patient Registration Number">
                                            <i class="bi bi-hospital me-1"></i>@(string.IsNullOrWhiteSpace(item.IpNo) ? item.OpNo : item.IpNo)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-primary">@(string.IsNullOrWhiteSpace(item.OpNo) ? "-" : item.OpNo)</span>
                                    }
                                </td>

                                <!-- Visit / Admit Date -->
                                <td>
                                    <span class="fw-semibold">@item.VisitDate.ToString("dd-MMM-yyyy")</span>
                                </td>

                                <!-- Doctor -->
                                <td>
                                    <span class="fw-bold" style="color: #026aa7;">
                                        @(string.IsNullOrWhiteSpace(item.DoctorName) ? $"Doctor #{item.Dcode}" : item.DoctorName)
                                    </span>
                                </td>

                                <!-- Reg Type -->
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge-type @item.RegType.ToLower()">@item.RegType</span>
                                        @if (item.IsIpAdmission && !string.IsNullOrWhiteSpace(item.VisitStatus))
                                        {
                                            <span class="badge bg-light text-secondary border" style="font-size: 0.65rem; padding: 3px 6px; font-weight: 600;">@item.VisitStatus</span>
                                        }
                                    </div>
                                </td>

                                <!-- Unbilled Items Breakdown -->
                                <td>
                                    @if (item.UnbilledCharges.Any())
                                    {
                                        <button type="button" class="btn-unbilled-chip" @onclick:stopPropagation="true" @onclick="() => OpenChargesModal(item)" title="Click to view @item.UnbilledCharges.Count unbilled charges breakdown">
                                            <i class="bi bi-file-earmark-medical me-1"></i>
                                            <span>@item.UnbilledCharges.Count item(s)</span>
                                            <strong class="ms-1">₹@string.Format("{0:N0}", item.TotalUnbilledAmount)</strong>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.75rem;">No unbilled items</span>
                                    }
                                </td>

                                <!-- Bill & Paid Status -->
                                <td>
                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                        @if (item.IsUnbilled)
                                        {
                                            <span class="status-badge-pill unbilled" title="Bill has not been generated">
                                                <i class="bi bi-file-earmark-text-fill"></i> Unbilled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge-pill billed" title="Bill generated: @item.BillNo">
                                                <i class="bi bi-file-earmark-check-fill"></i> Billed
                                            </span>
                                        }

                                        @if (item.IsUnpaid)
                                        {
                                            <span class="btn-bill-status unpaid" title="Payment pending">
                                                <i class="bi bi-exclamation-circle-fill"></i> Unpaid
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="btn-bill-status paid" title="Paid in full">
                                                <i class="bi bi-check-circle-fill"></i> Paid
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Outstanding Amount -->
                                <td style="text-align: right;">
                                    <span class="outstanding-val @(item.OutstandingAmount > 0 ? "due" : "zero")">
                                        ₹@string.Format("{0:N2}", item.OutstandingAmount)
                                    </span>
                                </td>

                                @if (!IsModal && ResolvedMode != "UNPAID")
                                {
                                    <!-- Actions -->
                                    <td style="text-align: center;">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            @if (item.IsUnbilled)
                                            {
                                                <button type="button" class="btn-action-primary" @onclick="() => OpenBilling(item)" title="Generate Bill for this patient">
                                                    <i class="bi bi-credit-card me-1"></i> Bill
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn-action-pay" @onclick="() => OpenPayment(item)" title="Collect Cash / Counter Payment">
                                                    <i class="bi bi-wallet2 me-1"></i> Pay
                                                </button>
                                            }

                                            @if (item.UnbilledCharges.Any())
                                            {
                                                <button type="button" class="btn-action-secondary" @onclick="() => OpenChargesModal(item)" title="View Charges Breakdown">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (enablePagination && filteredItems.Any())
            {
                var totalItems = filteredItems.Count;
                var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
                if (totalPages > 1)
                {
                    <div class="pagination-footer">
                        <div class="pagination-info">
                            Showing <span class="pagination-info-highlight">@(((currentPage - 1) * pageSize) + 1)</span> to <span class="pagination-info-highlight">@(Math.Min(currentPage * pageSize, totalItems))</span> of <span class="pagination-info-highlight">@totalItems</span> entries
                        </div>
                        <div class="pagination-btns">
                            <button class="page-btn" disabled="@(currentPage == 1)" @onclick="() => currentPage = 1" title="First Page">&laquo;</button>
                            <button class="page-btn" disabled="@(currentPage == 1)" @onclick="() => currentPage--" title="Previous Page">&lsaquo;</button>

                            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                            {
                                var pageNum = p;
                                <button class="page-btn @(currentPage == pageNum ? "active" : "")" @onclick="() => currentPage = pageNum">@pageNum</button>
                            }

                            <button class="page-btn" disabled="@(currentPage == totalPages)" @onclick="() => currentPage++" title="Next Page">&rsaquo;</button>
                            <button class="page-btn" disabled="@(currentPage == totalPages)" @onclick="() => currentPage = totalPages" title="Last Page">&raquo;</button>
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>
</div>
</div>

<!-- Unbilled Charges Modal Dialog -->
@if (showChargesModal && selectedModalPatient != null)
{
    <div class="modal-backdrop" @onclick="CloseChargesModal"></div>
    <div class="glass-modal charges-details-modal">
        <div class="modal-header">
            <div class="d-flex align-items-center gap-3">
                <div class="modal-token-pill">
                    <span class="label">TOKEN</span>
                    <span class="val">#@(string.IsNullOrWhiteSpace(selectedModalPatient.TokenNo) ? "-" : selectedModalPatient.TokenNo)</span>
                </div>
                <div>
                    <h3 class="modal-patient-title">@selectedModalPatient.PatientName</h3>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span class="text-muted" style="font-size: 0.78rem;">Patient ID: <strong>#@selectedModalPatient.CustId</strong></span>
                        <span class="text-muted" style="font-size: 0.78rem;">@(selectedModalPatient.IsIpAdmission ? "IP No:" : "OP No:") <strong class="@(selectedModalPatient.IsIpAdmission ? "text-purple fw-bold" : "text-primary")">@(string.IsNullOrWhiteSpace(selectedModalPatient.OpNo) ? "-" : selectedModalPatient.OpNo)</strong></span>
                        <span class="text-muted" style="font-size: 0.78rem;">Doctor: <strong>@selectedModalPatient.DoctorName</strong></span>
                    </div>
                </div>
            </div>
            <button type="button" class="btn-close-modal-custom" @onclick="CloseChargesModal" title="Close Pop-up">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="modal-body" style="padding: 1.25rem;">
            <div class="charges-summary-bar">
                <span><i class="bi bi-info-circle me-1"></i> These service charges are pending and will be automatically imported into the billing invoice.</span>
                <span class="fw-bold text-primary">Total: ₹@string.Format("{0:N2}", selectedModalPatient.TotalUnbilledAmount)</span>
            </div>

            <div class="table-responsive mt-3" style="border: 1px solid #e2e8f0; border-radius: 8px; max-height: 350px;">
                <table class="table table-sm table-hover mb-0" style="font-size: 0.8rem;">
                    <thead style="background: #026aa7; color: #ffffff;">
                        <tr>
                            <th style="padding: 6px 10px;">Item / Service Name</th>
                            <th style="padding: 6px 10px;">Entry Type</th>
                            <th style="padding: 6px 10px; text-align: center;">Qty</th>
                            <th style="padding: 6px 10px; text-align: right;">Rate (₹)</th>
                            <th style="padding: 6px 10px; text-align: right;">Discount (₹)</th>
                            <th style="padding: 6px 10px; text-align: right;">Amount (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var charge in selectedModalPatient.UnbilledCharges)
                        {
                            var displayName = !string.IsNullOrWhiteSpace(charge.particulars) 
                                ? charge.particulars 
                                : (!string.IsNullOrWhiteSpace(charge.item_name) ? charge.item_name : (charge.entrytype ?? "Consultation Fee"));

                            <tr>
                                <td style="padding: 6px 10px; font-weight: 700; color: #1e293b;">@displayName</td>
                                <td style="padding: 6px 10px;">
                                    <span class="badge bg-light text-dark border">@(charge.entrytype ?? "GENERAL")</span>
                                </td>
                                <td style="padding: 6px 10px; text-align: center;">@(charge.quantity ?? 1)</td>
                                <td style="padding: 6px 10px; text-align: right;">₹@string.Format("{0:N2}", charge.rate ?? 0)</td>
                                <td style="padding: 6px 10px; text-align: right; color: #dc2626;">₹@string.Format("{0:N2}", charge.discount ?? 0)</td>
                                <td style="padding: 6px 10px; text-align: right; font-weight: 700; color: #026aa7;">₹@string.Format("{0:N2}", charge.amount ?? 0)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center;">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseChargesModal">
                Close
            </button>
            @if (selectedModalPatient.IsUnbilled)
            {
                <button type="button" class="btn btn-sm btn-primary fw-bold" @onclick="() => OpenBilling(selectedModalPatient)">
                    <i class="bi bi-credit-card me-1"></i> Proceed to Billing
                </button>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-success fw-bold" @onclick="() => OpenPayment(selectedModalPatient)">
                    <i class="bi bi-wallet2 me-1"></i> Proceed to Payment
                </button>
            }
        </div>
    </div>
}

<!-- Cash Counter Payment Modal -->
@if (showPaymentModal && selectedBillForPayment != null)
{
    var dueAmt = selectedBillForPayment.balance_amount ?? 0;
    var netAmt = selectedBillForPayment.net_amount ?? 0;
    var paidAmt = selectedBillForPayment.paid_amount ?? 0;

    <div class="modal-backdrop" @onclick="ClosePaymentModal"></div>
    <div class="payment-modal animated-modal">
        <div class="modal-header-gradient">
            <div class="modal-header-left">
                <div class="modal-header-icon">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <h3 class="modal-title-text">Cash Counter Payment</h3>
                    <p class="modal-subtitle-text">Process bill settlement and paymode allocations</p>
                </div>
            </div>
            <button class="modal-close-icon-btn" @onclick="ClosePaymentModal" title="Close Modal">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="modal-body-custom">
            <!-- Hero Summary Header Card -->
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 1.25rem 1.75rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; width: 100%;">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; letter-spacing: 0.05em; text-transform: uppercase;">BILL NO:</span>
                    <span style="font-size: 0.85rem; font-weight: 700; color: #4f46e5; background: #e0e7ff; padding: 0.25rem 0.75rem; border-radius: 8px; font-family: monospace; border: 1px solid #c7d2fe;">@selectedBillForPayment.bill_no</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; letter-spacing: 0.05em; text-transform: uppercase;">PATIENT NAME:</span>
                    <span style="font-size: 1.05rem; font-weight: 800; color: #0f172a;">@selectedBillForPayment.patient_name</span>
                </div>
            </div>

            <EditForm Model="@paymentRequest" OnValidSubmit="SubmitPaymentAsync" class="payment-form">
                <!-- Form Fields 2-Column Grid -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 1.5rem; margin-bottom: 1.5rem;">
                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.75rem; font-weight: 700; color: #475569; letter-spacing: 0.03em; display: flex; align-items: center; gap: 0.25rem;">
                            <i class="bi bi-pc-display text-slate-500"></i> COUNTER CODE<span style="color: #ef4444;">*</span>
                        </label>
                        <select class="form-select" style="height: 42px; border-radius: 12px; border: 1px solid #cbd5e1; font-weight: 700; color: #0f172a; text-align: center; text-align-last: center; padding: 0.375rem 0.75rem;" @bind="paymentRequest.cntcode" required>
                            <option value="">Select Counter</option>
                            @foreach (var c in counters)
                            {
                                <option value="@((int)c.cntcode)">@c.name</option>
                            }
                        </select>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.75rem; font-weight: 700; color: #475569; letter-spacing: 0.03em; display: flex; align-items: center; gap: 0.25rem;">
                            <i class="bi bi-building text-slate-500"></i> COUNTER BRANCH<span style="color: #ef4444;">*</span>
                        </label>
                        <select class="form-select" style="height: 42px; border-radius: 12px; border: 1px solid #cbd5e1; font-weight: 700; color: #0f172a; text-align: center; text-align-last: center; padding: 0.375rem 0.75rem;" @bind="paymentRequest.enteredbhcode" required>
                            <option value="">Select Branch</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.bh_code">@b.name</option>
                            }
                        </select>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.75rem; font-weight: 700; color: #475569; letter-spacing: 0.03em; display: flex; align-items: center; gap: 0.25rem;">
                            <i class="bi bi-hash text-slate-500"></i> REFERENCE NO / TXN ID
                        </label>
                        <input type="text" class="form-control" style="height: 42px; border-radius: 12px; border: 1px solid #cbd5e1; font-weight: 700; color: #0f172a; text-align: center; padding: 0.375rem 0.75rem;" @bind="paymentRequest.reference_no" placeholder="e.g. APRV-88421" />
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.75rem; font-weight: 700; color: #475569; letter-spacing: 0.03em; display: flex; align-items: center; gap: 0.25rem;">
                            <i class="bi bi-bank text-slate-500"></i> BANK NAME
                        </label>
                        <input type="text" class="form-control" style="height: 42px; border-radius: 12px; border: 1px solid #cbd5e1; font-weight: 700; color: #0f172a; text-align: center; padding: 0.375rem 0.75rem;" @bind="paymentRequest.bank_name" placeholder="e.g. HDFC Bank" />
                    </div>
                </div>

                <!-- Net Payable Row -->
                <div style="padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; margin-top: 0.5rem;">
                    <span style="font-weight: 700; color: #1e293b; font-size: 0.95rem; text-transform: uppercase;">NET PAYABLE</span>
                    <span style="font-weight: 800; color: #6366f1; font-size: 1.25rem;">₹ @dueAmt.ToString("F2")</span>
                </div>

                @if (patientAdvanceAvailable > 0)
                {
                    var remainingAdvance = Math.Max(0, patientAdvanceAvailable - (paymentRequest.amount));
                    <div style="margin: 0.75rem 0 0.5rem; background: #ecfdf5; border: 1.5px dashed #34d399; border-radius: 10px; padding: 0.6rem 0.85rem; display: flex; flex-direction: column; gap: 0.3rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 0.72rem; font-weight: 700; color: #047857; text-transform: uppercase;">
                                <i class="bi bi-wallet2 me-1"></i> Patient Advance Available
                            </span>
                            <span style="font-weight: 800; color: #047857; font-size: 0.88rem;">₹ @patientAdvanceAvailable.ToString("N2")</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed #a7f3d0; padding-top: 0.25rem;">
                            <span style="font-size: 0.72rem; font-weight: 800; color: #065f46; text-transform: uppercase;">
                                Remaining Advance Balance
                            </span>
                            <span style="font-weight: 800; color: #065f46; font-size: 0.95rem;">₹ @remainingAdvance.ToString("N2")</span>
                        </div>
                    </div>
                }

                <!-- Payment Box (Dynamic Paymodes Dropdowns) -->
                <div style="margin: 1rem 0; background: #f8faff; border-radius: 12px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
                    <!-- Paymode Option 1 -->
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                        <select class="form-select" style="flex: 1; height: 34px; font-size: 0.8rem; font-weight: 600; padding: 2px 8px; border: 1px solid #cbd5e1; border-radius: 8px;" @bind="paymentRequest.pmc1" @bind:after="RecalculatePaymentTotals">
                            <option value="">Select Paymode 1</option>
                            @foreach (var pm in paymodes)
                            {
                                <option value="@pm.pmcode">@pm.name</option>
                            }
                        </select>
                        <input type="number" step="any" style="width: 110px; text-align: right; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.3rem 0.5rem; height: 34px; font-weight: 700; color: #0f172a; box-shadow: 0 1px 2px rgba(0,0,0,0.05);" @bind="paymentRequest.pmc1_amount" @bind:event="oninput" @bind:after="RecalculatePaymentTotals" placeholder="0.00" />
                        <button type="button" style="border: none; background: #fef2f2; color: #ef4444; border-radius: 50%; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.85rem;" @onclick="ClearPaymode1" title="Clear Paymode 1">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                    <!-- Paymode Option 2 -->
                    @if (showPaymode2)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                            <select class="form-select" style="flex: 1; height: 34px; font-size: 0.8rem; font-weight: 600; padding: 2px 8px; border: 1px solid #cbd5e1; border-radius: 8px;" @bind="paymentRequest.pmc2" @bind:after="RecalculatePaymentTotals">
                                <option value="">Select Paymode 2</option>
                                @foreach (var pm in paymodes)
                                {
                                    <option value="@pm.pmcode">@pm.name</option>
                                }
                            </select>
                            <input type="number" step="any" style="width: 110px; text-align: right; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.3rem 0.5rem; height: 34px; font-weight: 700; color: #0f172a; box-shadow: 0 1px 2px rgba(0,0,0,0.05);" @bind="paymentRequest.pmc2_amount" @bind:event="oninput" @bind:after="RecalculatePaymentTotals" placeholder="0.00" />
                            <button type="button" style="border: none; background: #fef2f2; color: #ef4444; border-radius: 50%; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.85rem;" @onclick="ClearPaymode2" title="Clear Paymode 2">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    }

                    <!-- Paymode Option 3 -->
                    @if (showPaymode3)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                            <select class="form-select" style="flex: 1; height: 34px; font-size: 0.8rem; font-weight: 600; padding: 2px 8px; border: 1px solid #cbd5e1; border-radius: 8px;" @bind="paymentRequest.pmc3" @bind:after="RecalculatePaymentTotals">
                                <option value="">Select Paymode 3</option>
                                @foreach (var pm in paymodes)
                                {
                                    <option value="@pm.pmcode">@pm.name</option>
                                }
                            </select>
                            <input type="number" step="any" style="width: 110px; text-align: right; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.3rem 0.5rem; height: 34px; font-weight: 700; color: #0f172a; box-shadow: 0 1px 2px rgba(0,0,0,0.05);" @bind="paymentRequest.pmc3_amount" @bind:event="oninput" @bind:after="RecalculatePaymentTotals" placeholder="0.00" />
                            <button type="button" style="border: none; background: #fef2f2; color: #ef4444; border-radius: 50%; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.85rem;" @onclick="ClearPaymode3" title="Clear Paymode 3">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    }

                    @if (!showPaymode2 || !showPaymode3)
                    {
                        <div style="display: flex; justify-content: center; width: 100%;">
                            <button type="button" style="background: #e0e7ff; color: #4f46e5; border: none; border-radius: 8px; padding: 0.35rem 0.75rem; font-size: 0.75rem; font-weight: 700; display: flex; align-items: center; gap: 0.25rem; cursor: pointer; margin-top: 0.25rem;" @onclick="AddPaymode">
                                <i class="bi bi-plus-lg"></i> Add Paymode
                            </button>
                        </div>
                    }
                </div>

                <!-- Balance Due Row -->
                <div style="padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e2e8f0;">
                    @if (paymentRequest.amount > dueAmt)
                    {
                        <span style="font-weight: 700; color: #ef4444; font-size: 0.85rem; text-transform: uppercase;">RETURN BALANCE</span>
                        <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.15rem;">
                            <span style="font-weight: 800; color: #ef4444; font-size: 1.15rem;">₹ @((paymentRequest.amount - dueAmt).ToString("F2"))</span>
                            <span style="font-size: 0.6rem; font-weight: 700; color: #ef4444; background: #fee2e2; padding: 0.1rem 0.3rem; border-radius: 4px; text-transform: uppercase;">Change Owed</span>
                        </div>
                    }
                    else
                    {
                        <span style="font-weight: 700; color: #475569; font-size: 0.85rem; text-transform: uppercase;">BALANCE DUE</span>
                        @if (dueAmt - paymentRequest.amount <= 0)
                        {
                            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.15rem;">
                                <span style="font-weight: 800; color: #10b981; font-size: 1.15rem;">₹ 0.00</span>
                                <span style="font-size: 0.6rem; font-weight: 700; color: #10b981; background: #e6f4ea; padding: 0.1rem 0.3rem; border-radius: 4px; text-transform: uppercase;">Fully Settled</span>
                            </div>
                        }
                        else
                        {
                            <span style="font-weight: 800; color: #f97316; font-size: 1.15rem;">₹ @((dueAmt - paymentRequest.amount).ToString("F2"))</span>
                        }
                    }
                </div>

                <!-- Total Amount Paid Box -->
                <div style="background: #4f46e5; padding: 0.75rem 1rem; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <span style="font-weight: 700; color: #ffffff; font-size: 0.9rem; text-transform: uppercase;">TOTAL AMOUNT PAID</span>
                    <span style="font-weight: 800; color: #ffffff; font-size: 1.25rem;">₹ @paymentRequest.amount.ToString("F2")</span>
                </div>

                <!-- Actions -->
                <div class="modal-footer-actions">
                    <button type="button" class="btn-modal-cancel" @onclick="ClosePaymentModal" disabled="@paymentSaving">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </button>
                    <button type="submit" class="btn-modal-submit" disabled="@(paymentSaving || paymentRequest.amount <= 0)">
                        @if (paymentSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span> Processing...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle-fill me-1"></i>
                            <span>Confirm & Add Payment</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public string? Mode { get; set; } // "UNBILLED", "UNPAID", "ALL"
    [Parameter] public bool IsModal { get; set; } = false;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<UnpaidUnbilledPatientItem> OnPatientSelected { get; set; }

    private string ResolvedMode
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Mode))
            {
                return Mode.Trim().ToUpperInvariant();
            }

            var uri = NavigationManager.Uri.ToLowerInvariant();
            if (uri.Contains("unbilled-patients") || uri.EndsWith("/unbilled"))
            {
                return "UNBILLED";
            }
            if (uri.Contains("unpaid-patients") || uri.EndsWith("/unpaid") || uri.Contains("unpaid-bills"))
            {
                return "UNPAID";
            }

            return "ALL";
        }
    }

    private string PageTitleText => ResolvedMode == "UNBILLED" 
        ? "Unbilled Patients - Medico Billing" 
        : (ResolvedMode == "UNPAID" ? "Unpaid Patients & Due Bills - Medico Billing" : "Unpaid & Unbilled Patients - Medico Billing");

    private string HeaderTitleText => ResolvedMode == "UNBILLED" 
        ? "Unbilled Patients" 
        : (ResolvedMode == "UNPAID" ? "Unpaid Patients & Due Bills" : "Unpaid & Unbilled Patients");

    private string HeaderSubtitleText => ResolvedMode == "UNBILLED" 
        ? "Real-time tracking of unbilled OP visits, IP admissions, and pending service charges" 
        : (ResolvedMode == "UNPAID" ? "Real-time tracking of pending bill settlements and patient due collections" : "Real-time tracking of unbilled OP/IP visits and pending bill collections");

    private string HeaderIconClass => ResolvedMode == "UNBILLED" 
        ? "bi bi-file-earmark-medical" 
        : (ResolvedMode == "UNPAID" ? "bi bi-exclamation-octagon" : "bi bi-clock-history");

    private string TableTitleText => ResolvedMode == "UNBILLED" 
        ? "Unbilled Patient Register" 
        : (ResolvedMode == "UNPAID" ? "Unpaid Patient & Due Bills Register" : "Unbilled & Unpaid Patient Register");

    private async Task CloseModal()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleBackdropClick()
    {
        if (IsModal)
        {
            await CloseModal();
        }
    }

    private bool loading = true;
    private bool enablePagination = false;
    private int currentPage = 1;
    private int pageSize = 10;

    // Filters
    private DateTime fromDate = DateTime.UtcNow.ToIndianTime().Date;
    private DateTime toDate = DateTime.UtcNow.ToIndianTime().Date;
    private int selectedDoctorCode = 0;
    private string selectedCategory = "ALL"; // ALL, UNBILLED, UNPAID
    private string selectedPatientType = "ALL"; // ALL, OP, IP
    private string searchQuery = string.Empty;

    private List<DoctorMasterModel> doctors = new();
    private List<UnpaidUnbilledPatientItem> allItems = new();
    private List<UnpaidUnbilledPatientItem> filteredItems = new();

    // Modal state
    private bool showChargesModal = false;
    private UnpaidUnbilledPatientItem? selectedModalPatient = null;

    // Cash Counter Payment Modal state
    private bool showPaymentModal = false;
    private HmsBillSummary? selectedBillForPayment = null;
    private HmsPaymentRequest paymentRequest = new();
    private bool paymentSaving = false;
    private bool showPaymode2 = false;
    private bool showPaymode3 = false;
    private double patientAdvanceAvailable = 0;
    private HmsPatientAdvanceSummary? patientAdvanceSummary;
    private List<Booking.Models.BranchModel> branches = new();
    private List<CounterMasterModel> counters = new();
    private List<PaymodeMasterModel> paymodes = new();

    private decimal TotalOutstandingAmount => filteredItems.Sum(x => x.OutstandingAmount);

    private bool isTodayFilter => fromDate == DateTime.UtcNow.ToIndianTime().Date && toDate == DateTime.UtcNow.ToIndianTime().Date;
    private bool isYesterdayFilter => fromDate == DateTime.UtcNow.ToIndianTime().Date.AddDays(-1) && toDate == DateTime.UtcNow.ToIndianTime().Date.AddDays(-1);
    private bool isLast7DaysFilter => fromDate == DateTime.UtcNow.ToIndianTime().Date.AddDays(-6) && toDate == DateTime.UtcNow.ToIndianTime().Date;
    private bool isThisMonthFilter => fromDate == new DateTime(DateTime.UtcNow.ToIndianTime().Year, DateTime.UtcNow.ToIndianTime().Month, 1) && toDate == DateTime.UtcNow.ToIndianTime().Date;

    protected override async Task OnInitializedAsync()
    {
        SyncCategoryWithMode();
        await Task.WhenAll(
            LoadDoctorsAsync(),
            LoadBranchesAsync(),
            LoadCountersAsync(),
            LoadPaymodesAsync()
        );
        await LoadDataAsync();
    }

    protected override void OnParametersSet()
    {
        SyncCategoryWithMode();
        ApplyFilters();
    }

    private void SyncCategoryWithMode()
    {
        if (ResolvedMode == "UNBILLED")
        {
            selectedCategory = "UNBILLED";
