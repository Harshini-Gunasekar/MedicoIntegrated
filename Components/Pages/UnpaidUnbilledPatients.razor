    public class UnpaidUnbilledPatientItem
    {
        public Guid OpId { get; set; }
        public Guid? IpId { get; set; }
        public Guid BookingId { get; set; }
        public string TokenNo { get; set; } = "";
        public string OpNo { get; set; } = "";
        public string? IpNo { get; set; } = "";
        public decimal CustId { get; set; }
        public string PatientName { get; set; } = "";
        public string Mobile { get; set; } = "";
        public int Dcode { get; set; }
        public string DoctorName { get; set; } = "";
        public DateOnly VisitDate { get; set; }
        public string RegType { get; set; } = "OP";
        public string VisitStatus { get; set; } = "";
        public bool IsVip { get; set; }
        public bool IsIpReferred { get; set; }
        public bool IsIpAdmission { get; set; }
        public bool IsDressing { get; set; }

        public bool IsUnbilled { get; set; }
        public List<UnbilledChargeSummary> UnbilledCharges { get; set; } = new();
        public decimal TotalUnbilledAmount => (decimal)UnbilledCharges.Sum(c => c.amount ?? 0);

        public bool HasBill { get; set; }
        public string? BillNo { get; set; }
        public decimal BillNetAmount { get; set; }
        public decimal BillPaidAmount { get; set; }
        public decimal BillBalanceAmount { get; set; }
        public bool IsUnpaid { get; set; }

        public string? RequestGuid { get; set; }
        public int? CntCode { get; set; }
        public int? EnteredBhCode { get; set; }
        public HmsBillSummary? BillSummary { get; set; }

        public decimal OutstandingAmount
        {
            get
            {
                if (HasBill && BillBalanceAmount > 0) return BillBalanceAmount;
                if (IsUnbilled && TotalUnbilledAmount > 0) return TotalUnbilledAmount;
                return 0;
            }
        }
    }
}
