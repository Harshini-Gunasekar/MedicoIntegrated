@page "/booking/ip-registration"
@rendermode InteractiveServer

@using Medico_Backend.Model
@using medico_backend.Model
@using Booking.Services
@using Newtonsoft.Json
@using Booking.Models
@inject IpRegistrationService IpService
@inject DoctorService DoctorService
@inject FloorMasterService FloorService
@inject RoomTypeMasterService RoomTypeService
@inject WardMasterService WardService
@inject BedMasterService BedService
@inject BlockMasterService BlockService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IHttpClientFactory ClientFactory
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<PageTitle>Inpatient Registration</PageTitle>

<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
</div>

<div class="dashboard-container">
    @* --- HEADER --- *@
    <div class="dashboard-header">
        <div class="dashboard-title">
            <h1>Inpatient Admissions Dashboard</h1>
            <p>Admit new patients, manage bed allocations, record insurance info, and perform patient discharges.</p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
            <button class="btn-header-action secondary" @onclick="OpenAdmitModal">
                <i class="bi bi-plus-circle"></i> Admit Patient
            </button>
            <button class="btn-header-action" @onclick="LoadDataAsync" disabled="@loading">
                @if (loading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" style="margin-right:6px;"></span>
                }
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    @* --- STATS --- *@
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-person-fill-check"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value">@admissionsList.Count(a => a.ip_status == "ADMITTED")</span>
                <span class="stat-label">Currently Admitted</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">
                <i class="bi bi-wallet2"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value">@admissionsList.Count(a => a.isinsurancepatient)</span>
                <span class="stat-label">Insurance Cases</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value">@admissionsList.Count(a => a.admission_type == "EMERGENCY")</span>
                <span class="stat-label">Emergency Cases</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon purple">
                <i class="bi bi-person-dash"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value">@admissionsList.Count(a => a.ip_status == "DISCHARGED")</span>
                <span class="stat-label">Discharged (Total)</span>
            </div>
        </div>
    </div>

    @* --- FILTERS --- *@
    <div class="filters-card">
        <div class="filters-row">
            <div class="filter-group">
                <label>Admission Status</label>
                <select class="filter-control" @bind="filterStatus" @bind:after="ApplyFilters">
                    <option value="ALL">All Statuses</option>
                    <option value="ADMITTED">Admitted</option>
                    <option value="DISCHARGED">Discharged</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Doctor Specialist</label>
                <select class="filter-control" @bind="filterDoctor" @bind:after="ApplyFilters">
                    <option value="0">All Doctors</option>
                    @foreach (var doc in doctorsList)
                    {
                        <option value="@doc.dcode">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname ?? "Specialist" : doc.name)</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Search Patient</label>
                <input type="text" class="filter-control" @bind="filterSearch" @bind:event="oninput" @bind:after="ApplyFilters" placeholder="Search by name/IP no..." />
            </div>
        </div>
    </div>

    @* --- TABLE --- *@
    <div class="table-card">
        <div class="table-responsive">
            <table class="medico-table">
                <thead>
                    <tr>
                        <th style="width: 140px;">IP NUMBER</th>
                        <th>PATIENT NAME</th>
                        <th>DOCTOR</th>
                        <th>BED LOCATION</th>
                        @if (filterStatus == "DISCHARGED")
                        {
                            <th style="width: 150px;">DISCHARGE DATE</th>
                        }
                        else
                        {
                            <th style="width: 150px;">ADMIT DATE</th>
                        }
                        <th>ADMISSION TYPE</th>
                        <th>INSURANCE</th>
                        <th>STATUS</th>
                        <th class="text-center" style="width: 220px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (filteredList != null && filteredList.Any())
                    {
                        var currentPageItems = filteredList.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
                        @for (int rowIndex = 0; rowIndex < currentPageItems.Count; rowIndex++)
                        {
                            var a = currentPageItems[rowIndex];
                            var isFirstRow = rowIndex == 0;
                              <tr class="lc-table-row @(a.isvip == true || a.is_vip == true ? "vip-row" : "")">
                                <td class="font-bold" style="color: #034f75;">@a.ip_no</td>
                                <td class="font-bold text-slate-800">
                                     @(string.IsNullOrWhiteSpace(a.patient_name) ? a.custid.ToString() : a.patient_name)
                                     @if (a.isvip == true || a.is_vip == true)
                                     {
                                         <span class="vip-badge" style="background: #fffbeb; border: 1px solid #fde68a; color: #d97706; padding: 2px 6px; border-radius: 4px; font-weight: 700; font-size: 0.7rem; margin-left: 8px; display: inline-flex; align-items: center; gap: 2px;" title="VIP Patient">VIP</span>
                                     }
                                </td>
                                <td>Dr. @(doctorsList.FirstOrDefault(d => d.dcode == a.dcode)?.name ?? a.dcode.ToString())</td>
                                <td>
                                    @{
                                        var bed = bedsList.FirstOrDefault(b => b.bedcode == a.bedcode);
                                        var displayFloor = floorsList.FirstOrDefault(f => f.flrcode == (a.flrcode ?? bed?.flrcode))?.name 
                                                           ?? (a.flrcode ?? bed?.flrcode)?.ToString() ?? "-";
                                        var displayRoomType = roomTypes.FirstOrDefault(r => r.rmtcode == (a.rmtcode ?? bed?.rmtcode))?.name 
                                                              ?? (a.rmtcode ?? bed?.rmtcode)?.ToString() ?? "-";
                                        var displayWard = wardsList.FirstOrDefault(w => w.wrdcode == (a.wrdcode ?? bed?.wrdcode))?.name 
                                                          ?? (a.wrdcode ?? bed?.wrdcode)?.ToString() ?? "-";
                                        var displayBed = bed?.bedname ?? a.bedcode?.ToString() ?? "-";
                                    }
                                    <div style="position: relative; display: inline-block;">
                                        <a href="javascript:void(0)" @onclick="() => ShowBedDetailsPopover(a, displayFloor, displayRoomType, displayBed)" style="text-decoration: underline; color: #026aa7; font-weight: bold; cursor: pointer;">@displayBed</a>
                                        
                                        @if (showBedPopover && selectedBedPatient?.ip_id == a.ip_id)
                                        {
                                            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); border: 1px solid #cbd5e1; background: #ffffff; padding: 8px; border-radius: 6px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06); font-size: 0.72rem; z-index: 1000; width: 190px; text-align: left; line-height: 1.3; color: #334155;">
                                                <button type="button" @onclick="CloseBedPopover" style="position: absolute; right: 6px; top: 3px; border: none; background: none; font-size: 1rem; cursor: pointer; color: #ef4444; font-weight: bold; padding: 0; line-height: 1;">&times;</button>
                                                <div style="font-weight: bold; margin-bottom: 4px; color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 2px; font-size: 0.75rem; padding-right: 15px;">Bed Allocation</div>
                                                <div><strong>Bed No:</strong> @displayBed</div>
                                                <div><strong>Room Type:</strong> @displayRoomType</div>
                                                <div><strong>Ward:</strong> @displayWard</div>
                                                <div><strong>Floor:</strong> @displayFloor</div>
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td class="text-slate-700">
                                    @if (a.ip_status == "DISCHARGED")
                                    {
                                        @(a.dischargedate?.ToString("dd-MM-yyyy hh:mm tt") ?? "-")
                                    }
                                    else
                                    {
                                        @a.admitdate.ToString("dd-MM-yyyy hh:mm tt")
                                    }
                                    </td>
                                <td>
                                    <span class="badge-type @(a.admission_type == "EMERGENCY" ? "walkin" : "online")">
                                        @a.admission_type
                                    </span>
                                </td>
                                <td>
                                    @if (a.isinsurancepatient)
                                    {
                                        <div style="position: relative; display: inline-block;">
                                            <a href="javascript:void(0)" @onclick="() => OpenInsuranceCard(a)" style="text-decoration: underline; color: #026aa7; cursor: pointer; font-weight: 600; font-size: 0.8rem;">Insurance details</a>
                                            
                                            @if (showInsuranceModal && selectedInsurancePatient?.ip_id == a.ip_id)
                                            {
                                                <div style="position: absolute; top: @(isFirstRow ? "calc(100% + 1px)" : "50%"); left: 50%; transform: @(isFirstRow ? "translateX(-50%)" : "translate(-50%, -50%)"); border: 1px solid #cbd5e1; background: #ffffff; padding: 8px; border-radius: 6px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06); font-size: 0.72rem; z-index: 1000; width: 190px; text-align: left; line-height: 1.3; color: #334155;">
                                                    <button type="button" @onclick="CloseInsuranceCard" style="position: absolute; right: 6px; top: 3px; border: none; background: none; font-size: 1rem; cursor: pointer; color: #ef4444; font-weight: bold; padding: 0; line-height: 1;">&times;</button>
                                                    <div style="font-weight: bold; margin-bottom: 4px; color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 2px; font-size: 0.75rem; padding-right: 15px;">Insurance Info</div>
                                                    <div><strong>Co:</strong> @a.insurance_company</div>
                                                    <div><strong>Policy:</strong> @a.policyno</div>
                                                    <div><strong>Auth:</strong> @a.authorizationno</div>
                                                    <div><strong>TPA:</strong> @a.tpa_name</div>
                                                    <div><strong>Appr:</strong> @(a.insurance_approved_amount?.ToString("N0") ?? "0")</div>
                                                    <div><strong>Status:</strong> @a.insurance_status</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400" style="font-size: 0.8rem;">No</span>
                                    }
                                </td>
                                <td>
                                    @if (a.ip_status == "ADMITTED")
                                    {
                                        <select @key="@(a.ip_id.ToString() + selectResetKey)" class="filter-control" style="padding: 0.25rem 0.5rem; font-size: 0.85rem; width: auto; min-width: 120px;" value="@a.ip_status" @onchange="(e) => OnStatusChange(a, e)">
                                            <option value="ADMITTED">ADMITTED</option>
                                            <option value="DISCHARGED">DISCHARGED</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="status-badge @(a.ip_status == "ADMITTED" ? "waiting" : "completed")">
                                            @a.ip_status
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (a.ip_status == "ADMITTED")
                                    {
                                        <div style="display: flex; gap: 0.25rem; justify-content: center; flex-wrap: nowrap;">
                                            <button class="btn-modal confirm" style="padding: 0.35rem 0.5rem; font-size: 0.75rem; border-radius: 6px; background-color: #3b82f6;" @onclick="() => OpenUpdateModal(a)">
                                                Update
                                            </button>
                                            <button class="btn-modal confirm" style="padding: 0.35rem 0.5rem; font-size: 0.75rem; border-radius: 6px; background-color: #4f46e5; color: #ffffff; white-space: nowrap;" @onclick="() => OpenCaseSheetForIp(a)">
                                                Case Sheet
                                            </button>
                                            <button class="btn-modal confirm" style="padding: 0.35rem 0.5rem; font-size: 0.75rem; border-radius: 6px; background-color: #059669; color: #ffffff; white-space: nowrap;" @onclick="() => OpenDischargeSummaryForIp(a)">
                                                Discharge Summary
                                            </button>
                                            <button class="btn-modal cancel" style="padding: 0.35rem 0.5rem; font-size: 0.75rem; border-radius: 6px; background-color: #ef4444; color: #ffffff;" @onclick="() => OpenCancelModal(a)">
                                                Cancel
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="display: flex; gap: 0.25rem; justify-content: center; flex-wrap: nowrap;">
                                            <button class="btn-modal confirm" style="padding: 0.35rem 0.5rem; font-size: 0.75rem; border-radius: 6px; background-color: #059669; color: #ffffff; white-space: nowrap;" @onclick="() => OpenDischargeSummaryForIp(a)">
                                                Discharge Summary
                                            </button>
                                            <button class="btn-modal confirm" style="padding: 0.35rem 0.5rem; font-size: 0.75rem; border-radius: 6px; background-color: #93c5fd; border: none; color: #ffffff; cursor: not-allowed;" disabled>
                                                Update
                                            </button>
                                            <button class="btn-modal cancel" style="padding: 0.35rem 0.5rem; font-size: 0.75rem; border-radius: 6px; background-color: #fca5a5; border: none; color: #ffffff; cursor: not-allowed;" disabled>
                                                Cancel
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(filterStatus == "DISCHARGED" ? 8 : 9)" class="text-center p-48 text-slate-400 italic">No IP records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* --- PAGINATION --- *@
        @if (filteredList != null && filteredList.Count > 10)
        {
            var totalItems = filteredList.Count;
            var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
            <div class="pagination-container" style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; padding: 0.5rem 1rem; background: rgba(255, 255, 255, 0.7); border-radius: 12px; border: 1px solid #eaecf0;">
                <div style="font-size: 0.8rem; color: #64748b;">
                    Showing <strong>@(((currentPage - 1) * pageSize) + 1)</strong> to <strong>@(Math.Min(currentPage * pageSize, totalItems))</strong> of <strong>@totalItems</strong> entries
                </div>
                <div style="display: flex; gap: 0.5rem;">
                    <button class="btn-page" style="padding: 0.35rem 0.75rem; border-radius: 6px; border: 1px solid #cbd5e1; background: #ffffff; cursor: @(currentPage > 1 ? "pointer" : "not-allowed"); font-size: 0.8rem;" disabled="@(currentPage == 1)" @onclick="() => { currentPage--; }">«</button>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        var pageNumber = p;
                        <button class="btn-page @(currentPage == pageNumber ? "active" : "")" style="padding: 0.35rem 0.75rem; border-radius: 6px; border: 1px solid @(currentPage == pageNumber ? "#026aa7" : "#cbd5e1"); background: @(currentPage == pageNumber ? "#026aa7" : "#ffffff"); color: @(currentPage == pageNumber ? "#ffffff" : "#475569"); cursor: pointer; font-size: 0.8rem; font-weight: bold;" @onclick="() => { currentPage = pageNumber; }">@pageNumber</button>
                    }
                    <button class="btn-page" style="padding: 0.35rem 0.75rem; border-radius: 6px; border: 1px solid #cbd5e1; background: #ffffff; cursor: @(currentPage < totalPages ? "pointer" : "not-allowed"); font-size: 0.8rem;" disabled="@(currentPage == totalPages)" @onclick="() => { currentPage++; }">»</button>
                </div>
            </div>
        }
    </div>
</div>

@* --- ADMIT PATIENT MODAL --- *@
@if (showAdmitModal)
{
    <div class="modal-backdrop"></div>
    <div class="glass-modal large-modal-custom">
        <div class="modal-header">
            <h3>New Inpatient Admission</h3>
            <button class="close-btn" @onclick="CloseAdmitModal">&times;</button>
        </div>
        <div class="modal-body">
            @* Row 1: Patient, Doctor, Type, Reason *@
            <div class="um-grid-cols-4">
                <div class="form-group" style="position: relative;">
                    <label>Select Patient *</label>
                    <div style="position: relative;">
                        <input type="text" class="filter-control" placeholder="-- Choose Patient --" 
                               value="@selectedPatientSearchName" 
                               @oninput="OnPatientSearchInput" 
                               @focus="ShowPatientDropdown" 
                               @onblur="HidePatientDropdownWithDelay" 
                               @onkeydown="OnPatientSearchKeyDown" />
                        
                        @if (showPatientDropdown)
                        {
                            <div style="position: absolute; top: 100%; left: 0; right: 0; z-index: 1050; max-height: 200px; overflow-y: auto; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); margin-top: 2px;">
                                @if (filteredPatientsForDropdown.Any())
                                {
                                    @for (int idx = 0; idx < filteredPatientsForDropdown.Count; idx++)
                                    {
                                        var pIndex = idx;
                                        var p = filteredPatientsForDropdown[idx];
                                        <div @onmousedown="() => SelectPatientFromDropdown(p)" 
                                             style="padding: 6px 12px; cursor: pointer; font-size: 0.8rem; color: #1e293b; background-color: @(idx == activeDropdownIndex ? "#f1f5f9" : "transparent");">
                                            @p.custcode @(string.IsNullOrEmpty(p.namewithinitials) ? p.name : p.namewithinitials)
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div style="padding: 8px 12px; font-size: 0.8rem; color: #64748b; font-style: italic;">No patients found</div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="form-group">
                    <label>Assigned Doctor *</label>
                    <select class="filter-control" @bind="admitRequest.dcode" @bind:after="PrintPayload">
                        <option value="0">-- Choose Doctor --</option>
                        @foreach (var d in doctorsList)
                        {
                            <option value="@d.dcode">Dr. @d.name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Admission Type</label>
                    <select class="filter-control" @bind="admitRequest.admission_type" @bind:after="PrintPayload">
                        <option value="PLANNED">PLANNED</option>
                        <option value="EMERGENCY">EMERGENCY</option>
                        <option value="REFERRAL">REFERRAL</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Admission Reason</label>
                    <input type="text" class="filter-control" @bind="admitRequest.admission_reason" @bind:event="oninput" @bind:after="PrintPayload" placeholder="e.g. Appendectomy" />
                </div>
            </div>

            @* Row 2: Expected Discharge Date & Guardian Info *@
            <div class="um-grid-cols-4">
                <div class="form-group">
                    <label>Expected Discharge Date</label>
                    <input type="date" class="filter-control" @bind="admitRequest.expected_dischargedate" @bind:after="PrintPayload" />
                </div>
                <div class="form-group">
                    <label>Guardian Name</label>
                    <input type="text" class="filter-control" @bind="admitRequest.guardian_name" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Name" />
                </div>
                <div class="form-group">
                    <label>Relation</label>
                    <input type="text" class="filter-control" @bind="admitRequest.guardian_relation" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Relation" />
                </div>
                <div class="form-group">
                    <label>Contact No</label>
                    <input type="text" class="filter-control" @bind="admitRequest.guardian_contact" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Contact" />
                </div>
            </div>

            @* Row 3: Notes & Is Insurance Patient *@
            <div class="um-grid-cols-4">
                <div class="form-group" style="grid-column: span 3;">
                    <label>Admission Notes</label>
                    <input type="text" class="filter-control" @bind="admitRequest.notes" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Notes" />
                </div>
                <div class="form-group" style="flex-direction: row; align-items: center; gap: 8px; margin-top: 28px;">
                    <input type="checkbox" id="isinsurance" @bind="admitRequest.isinsurancepatient" @bind:after="PrintPayload" style="width: 16px; height: 16px; cursor: pointer;" />
                    <label for="isinsurance" style="margin-bottom: 0; cursor: pointer; text-transform: none;">Is Insurance Patient</label>
                </div>
            </div>

            @if (admitRequest.isinsurancepatient)
            {
                @* Row 4: Insurance details (Insurance, Policy No, Auth No, TPA) *@
                <div class="um-grid-cols-4">
                    <div class="form-group">
                        <label>Insurance Company</label>
                        <input type="text" class="filter-control" @bind="admitRequest.insurance_company" @bind:event="oninput" @bind:after="PrintPayload" placeholder="e.g. Star Health" />
                    </div>
                    <div class="form-group">
                        <label>Policy No</label>
                        <input type="text" class="filter-control" @bind="admitRequest.policyno" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Policy No" />
                    </div>
                    <div class="form-group">
                        <label>Authorization No</label>
                        <input type="text" class="filter-control" @bind="admitRequest.authorizationno" @bind:event="oninput" @bind:after="PrintPayload" placeholder="Auth No" />
                    </div>
                    <div class="form-group">
                        <label>TPA Name</label>
                        <input type="text" class="filter-control" @bind="admitRequest.tpa_name" @bind:event="oninput" @bind:after="PrintPayload" placeholder="TPA" />
                    </div>
                </div>
                
                @* Row 5: Approved Amount *@
                <div class="um-grid-cols-4">
                    <div class="form-group">
                        <label>Approved Amount</label>
                        <input type="number" step="any" class="filter-control" @bind="admitRequest.insurance_approved_amount" @bind:event="oninput" @bind:after="PrintPayload" placeholder="0.00" />
                    </div>
                </div>
            }

        </div>
        <div class="modal-footer">
            <button class="btn-modal cancel" @onclick="CloseAdmitModal">Cancel</button>
            <button class="btn-modal confirm" @onclick="GoToBedAllocation">Bed Allocation</button>
        </div>
    </div>
}

@* --- DISCHARGE MODAL --- *@
@if (showDischargeModal)
{
    <div class="modal-backdrop"></div>
    <div class="glass-modal" style="max-width: 480px;">
        <div class="modal-header">
            <h3>Discharge Patient</h3>
            <button class="close-btn" @onclick="CloseDischargeModal">&times;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Discharge Type *</label>
                <select class="filter-control" @bind="dischargeRequest.discharge_type">
                    <option value="NORMAL">NORMAL</option>
                    <option value="DAMA">DAMA (Discharge Against Medical Advice)</option>
                    <option value="LAMA">LAMA (Left Against Medical Advice)</option>
                    <option value="DEATH">DEATH</option>
                    <option value="REFERRED">REFERRED</option>
                </select>
            </div>
            <div class="form-group">
                <label>Discharge Summary / Comments</label>
                <textarea class="filter-control" style="height: 100px; resize: none;" @bind="dischargeRequest.discharge_summary" placeholder="Provide summary of patient status, medication instructions, follow-up advice..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-modal cancel" @onclick="CloseDischargeModal">Cancel</button>
            <button class="btn-modal confirm" @onclick="ExecuteDischarge">Confirm Discharge</button>
        </div>
    </div>
}



@* --- UPDATE IP REGISTRATION MODAL --- *@
@if (showUpdateModal)
{
    <div class="modal-backdrop"></div>
    <div class="glass-modal large-modal-custom">
        <div class="modal-header">
            <h3>Update Inpatient Admission</h3>
            <button class="close-btn" @onclick="CloseUpdateModal">&times;</button>
        </div>
        <div class="modal-body">
            @* Row 1: Doctor, Referring Doctor, Department, Reason *@
            <div class="um-grid-cols-4">
                <div class="form-group">
                    <label>Patient Name</label>
                    <input type="text" class="filter-control" value="@selectedUpdatePatientName" readonly style="background-color: #f1f5f9; cursor: not-allowed; font-weight: bold;" />
                </div>
                <div class="form-group">
                    <label>Assigned Doctor</label>
                    <select class="filter-control" @bind="updateRequest.dcode">
                        <option value="">-- Choose Doctor --</option>
                        @foreach (var d in doctorsList)
                        {
                            <option value="@d.dcode">Dr. @d.name</option>
                        }
                    </select>
                </div>
                <div class="form-group" style="grid-column: span 2;">
                    <label>Admission Reason</label>
                    <input type="text" class="filter-control" @bind="updateRequest.admission_reason" placeholder="e.g. Appendectomy" />
                </div>
            </div>

            @* Row 2: Expected Discharge Date, Guardian Name, Relation, Contact *@
            <div class="um-grid-cols-4">
                <div class="form-group">
                    <label>Expected Discharge Date</label>
                    <input type="date" class="filter-control" @bind="updateRequest.expected_dischargedate" />
                </div>
                <div class="form-group">
                    <label>Guardian Name</label>
                    <input type="text" class="filter-control" @bind="updateRequest.guardian_name" placeholder="Name" />
                </div>
                <div class="form-group">
                    <label>Relation</label>
                    <input type="text" class="filter-control" @bind="updateRequest.guardian_relation" placeholder="Relation" />
                </div>
                <div class="form-group">
                    <label>Contact No</label>
                    <input type="text" class="filter-control" @bind="updateRequest.guardian_contact" placeholder="Contact" />
                </div>
            </div>

            @* Row 3: Notes & Insurance Patient Checkbox *@
            <div class="um-grid-cols-4">
                <div class="form-group" style="grid-column: span 3;">
                    <label>Notes</label>
                    <input type="text" class="filter-control" @bind="updateRequest.notes" placeholder="Notes" />
                </div>
                <div class="form-group" style="flex-direction: row; align-items: center; gap: 8px; margin-top: 28px;">
                    <input type="checkbox" id="update_isinsurance" @bind="updateRequest.isinsurancepatient" style="width: 16px; height: 16px; cursor: pointer;" />
                    <label for="update_isinsurance" style="margin-bottom: 0; cursor: pointer; text-transform: none;">Is Insurance Patient</label>
                </div>
            </div>

            @if (updateRequest.isinsurancepatient == true)
            {
                @* Row 4: Insurance details *@
                <div class="um-grid-cols-4">
                    <div class="form-group">
                        <label>Insurance Company</label>
                        <input type="text" class="filter-control" @bind="updateRequest.insurance_company" placeholder="e.g. Star Health" />
                    </div>
                    <div class="form-group">
                        <label>Policy No</label>
                        <input type="text" class="filter-control" @bind="updateRequest.policyno" placeholder="Policy No" />
                    </div>
                    <div class="form-group">
                        <label>Authorization No</label>
                        <input type="text" class="filter-control" @bind="updateRequest.authorizationno" placeholder="Auth No" />
                    </div>
                    <div class="form-group">
                        <label>TPA Name</label>
                        <input type="text" class="filter-control" @bind="updateRequest.tpa_name" placeholder="TPA" />
                    </div>
                </div>
                
                @* Row 5: Approved Amount *@
                <div class="um-grid-cols-4">
                    <div class="form-group">
                        <label>Approved Amount</label>
                        <input type="number" step="any" class="filter-control" @bind="updateRequest.insurance_approved_amount" placeholder="0.00" />
                    </div>
                </div>
            }

        </div>
        <div class="modal-footer">
            <button class="btn-modal cancel" @onclick="CloseUpdateModal">Cancel</button>
            <button class="btn-modal confirm" @onclick="ExecuteUpdate">Save Changes</button>
        </div>
    </div>
}

@* --- CANCEL ADMISSION MODAL --- *@
@if (showCancelModal)
{
    <div class="modal-backdrop"></div>
    <div class="glass-modal" style="max-width: 480px;">
        <div class="modal-header">
            <h3>Cancel Admission</h3>
            <button class="close-btn" @onclick="CloseCancelModal">&times;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Cancellation Reason *</label>
                <textarea class="filter-control" style="height: 100px; resize: none;" @bind="cancelRequest.reason" placeholder="Provide cancellation reason..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-modal cancel" @onclick="CloseCancelModal">Close</button>
            <button class="btn-modal confirm" style="background-color: #ef4444; border: none; color: #ffffff;" @onclick="ExecuteCancel">Cancel Admission</button>
        </div>
    </div>
}

<!-- Case Sheet Workspace Modal for IP -->
<CaseSheetComponent @bind-Visible="showCaseSheetModal"
                    OpId="selectedOpId"
                    IpId="selectedIpId"
                    OpNo="@selectedOpNo"
                    IpNo="@selectedIpNo"
                    CustId="selectedCustId"
                    Dcode="selectedDcode"
                    PatientName="@selectedPatientName"
                    VisitDate="selectedVisitDate"
                    OpStatus="ADMITTED"
                    OnSaved="LoadDataAsync" />

<!-- Discharge Summary Workspace Modal for IP -->
<DischargeSummaryComponent @bind-Visible="showDischargeSummaryModal"
                           IpId="selectedDsIpId"
                           IpNo="@selectedDsIpNo"
                           PatCode="@selectedDsPatCode"
                           CustId="selectedDsCustId"
                           Dcode="selectedDsDcode"
                           PatientName="@selectedDsPatientName"
                           DoctorName="@selectedDsDoctorName"
                           BedNo="@selectedDsBedNo"
                           AdmitDate="selectedDsAdmitDate"
                           DischargeDate="selectedDsDischargeDate" />

@code {
    private bool showCaseSheetModal = false;
    private Guid selectedIpId = Guid.Empty;
    private string selectedIpNo = "";
    private Guid selectedOpId = Guid.Empty;
    private string selectedOpNo = "";
    private decimal selectedCustId = 0;
    private int selectedDcode = 0;
    private string selectedPatientName = "";
    private DateTime? selectedVisitDate;

    private void OpenCaseSheetForIp(IPRegistrationModel.IpRegistrationModel admission)
    {
        selectedIpId = admission.ip_id;
        selectedIpNo = admission.ip_no;
        selectedOpId = admission.op_id ?? Guid.Empty;
        selectedOpNo = "";
        selectedCustId = admission.custid;
        selectedDcode = admission.dcode;
        selectedPatientName = string.IsNullOrWhiteSpace(admission.patient_name) ? admission.custid.ToString() : admission.patient_name;
        selectedVisitDate = admission.admitdate;
        showCaseSheetModal = true;
    }

    private bool showDischargeSummaryModal = false;
    private Guid selectedDsIpId = Guid.Empty;
    private string selectedDsIpNo = "";
    private string selectedDsPatCode = "";
    private decimal selectedDsCustId = 0;
    private int selectedDsDcode = 0;
    private string selectedDsPatientName = "";
    private string selectedDsDoctorName = "";
    private string selectedDsBedNo = "";
    private DateTime? selectedDsAdmitDate;
    private DateTime? selectedDsDischargeDate;

    private void OpenDischargeSummaryForIp(IPRegistrationModel.IpRegistrationModel admission)
    {
        selectedDsIpId = admission.ip_id;
        selectedDsIpNo = admission.ip_no;
        selectedDsPatCode = !string.IsNullOrWhiteSpace(admission.ip_no) ? admission.ip_no : admission.custid.ToString();
        selectedDsCustId = admission.custid;
        selectedDsDcode = admission.dcode;
        selectedDsPatientName = string.IsNullOrWhiteSpace(admission.patient_name) ? admission.custid.ToString() : admission.patient_name;
        selectedDsDoctorName = doctorsList.FirstOrDefault(d => d.dcode == admission.dcode)?.name ?? admission.dcode.ToString();
        var bed = bedsList.FirstOrDefault(b => b.bedcode == admission.bedcode);
        selectedDsBedNo = bed?.bedname ?? admission.bedcode?.ToString() ?? "";
        selectedDsAdmitDate = admission.admitdate;
        selectedDsDischargeDate = admission.dischargedate ?? DateTime.Now;
        showDischargeSummaryModal = true;
    }
    private int currentPage = 1;
    private int pageSize = 10;

    private IPRegistrationModel.IpRegistrationModel? selectedBedPatient;
    private bool showBedPopover = false;

    private void ShowBedDetailsPopover(IPRegistrationModel.IpRegistrationModel admission, string floor, string ward, string bedName)
    {
        selectedBedPatient = admission;
        showBedPopover = true;
    }

    private void CloseBedPopover()
    {
        selectedBedPatient = null;
        showBedPopover = false;
    }

    private List<IPRegistrationModel.IpRegistrationModel> admissionsList = new();
    private List<IPRegistrationModel.IpRegistrationModel> filteredList = new();

    private List<DoctorMasterModel> doctorsList = new();
    private List<FloorMasterModel> floorsList = new();
    private List<RoomTypeMasterModel> roomTypes = new();
    private List<WardMasterModel> wardsList = new();
    private List<BedMasterModel> bedsList = new();
    private List<BlockMasterModel> blocksList = new();
    private List<SharedComponents.Rcl.Models.CustomerModel> customersList = new();

    private bool loading = false;
    private string filterStatus = "ALL";
    private int filterDoctor = 0;
    private string filterSearch = "";

    private bool showAdmitModal = false;
    private bool showDischargeModal = false;

    private IPRegistrationModel.CreateIpRegistrationRequest admitRequest = new();
    private IPRegistrationModel.DischargeRequest dischargeRequest = new();

    private string TenantCode = "";
    private string AuthToken = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                await LoadCustomersAsync();
                await LoadDataAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error loading session details: {ex.Message}");
            }
        }
    }

    private async Task LoadCustomersAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }

            var response = await client.GetAsync("api/Customer/partition?pagenumber=1&pagesize=1000");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                customersList = JsonConvert.DeserializeObject<List<SharedComponents.Rcl.Models.CustomerModel>>(json) ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
        }
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        try
        {
            // Load dropdown lists
            doctorsList = await DoctorService.GetDoctorsAsync();
            floorsList = await FloorService.GetFloorMastersAsync();
            roomTypes = await RoomTypeService.GetRoomTypeMastersAsync();
            wardsList = await WardService.GetWardMastersAsync();
            bedsList = await BedService.GetBedMastersAsync();
            blocksList = await BlockService.GetBlockMastersAsync();

            // Load Admissions
            var active = await IpService.GetIpRegistrationsAsync("ADMITTED");
            var discharged = await IpService.GetIpRegistrationsAsync("DISCHARGED");
            var sortedDischarged = discharged.OrderByDescending(d => d.dischargedate).ToList();
            admissionsList = active.Concat(sortedDischarged).ToList();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading dashboard data: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyFilters()
    {
        currentPage = 1;
        filteredList = admissionsList;

        if (filterStatus != "ALL")
        {
            filteredList = filteredList.Where(a => a.ip_status == filterStatus).ToList();
        }

        if (filterDoctor > 0)
        {
            filteredList = filteredList.Where(a => a.dcode == filterDoctor).ToList();
        }

        if (!string.IsNullOrWhiteSpace(filterSearch))
        {
            filteredList = filteredList.Where(a => 
                (a.ip_no != null && a.ip_no.Contains(filterSearch, StringComparison.OrdinalIgnoreCase)) ||
                (a.patient_name != null && a.patient_name.Contains(filterSearch, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
    }

    private void PrintPayload()
    {
        try
        {
            var payloadJson = Newtonsoft.Json.JsonConvert.SerializeObject(admitRequest, Newtonsoft.Json.Formatting.Indented);
            Console.WriteLine("--- CreateIpRegistrationRequest Current Payload JSON ---");
            Console.WriteLine(payloadJson);
            Console.WriteLine("---------------------------------------------------------");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error serializing admission payload: {ex.Message}");
        }
    }

    private void OpenAdmitModal()
    {
        selectedPatientSearchName = "";
        admitRequest = new IPRegistrationModel.CreateIpRegistrationRequest
        {
            admission_type = "PLANNED",
            admitdate = DateTime.Now,
            branchcode = 101,
            blockcode = blocksList.FirstOrDefault()?.blockcode,
            flrcode = floorsList.FirstOrDefault()?.flrcode,
            wrdcode = wardsList.FirstOrDefault()?.wrdcode,
            rmtcode = roomTypes.FirstOrDefault()?.rmtcode,
            bedcode = 0,
            isinsurancepatient = false
        };
        showAdmitModal = true;
    }

    private void CloseAdmitModal()
    {
        showAdmitModal = false;
    }

    private async Task GoToBedAllocation()
    {
        if (admitRequest.custid <= 0)
        {
            ToastService.ShowError("Please select a patient.");
            return;
        }
        if (admitRequest.dcode <= 0)
        {
            ToastService.ShowError("Please select a doctor.");
            return;
        }

        try
        {
            await _sessionStorage.SetAsync("DraftAdmission", admitRequest);
            Navigation.NavigateTo("/booking/available-beds");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error transferring draft admission details: {ex.Message}");
        }
    }

    private async Task ExecuteAdmit()
    {
        if (admitRequest.custid <= 0)
        {
            ToastService.ShowError("Please select a patient.");
            return;
        }
        if (admitRequest.dcode <= 0)
        {
            ToastService.ShowError("Please select a doctor.");
            return;
        }
        if (admitRequest.bedcode <= 0)
        {
            ToastService.ShowError("Please allocate a bed.");
            return;
        }

        try
        {
            var payloadJson = Newtonsoft.Json.JsonConvert.SerializeObject(admitRequest, Newtonsoft.Json.Formatting.Indented);
            Console.WriteLine("--- SENDING IP REGISTRATION PAYLOAD TO BACKEND DATABASE ---");
            Console.WriteLine(payloadJson);
            Console.WriteLine("-----------------------------------------------------------");
            try
            {
                await JSRuntime.InvokeVoidAsync("console.log", "Sending IP Registration Payload to Backend Database:", payloadJson);
            }
            catch { }

            bool success = await IpService.AdmitPatientAsync(admitRequest);
            if (success)
            {
                ToastService.ShowSuccess("Patient admitted successfully!");
                showAdmitModal = false;
                await LoadDataAsync();
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Failed to admit patient.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error admitting patient: {ex.Message}");
        }
    }

    private void OpenDischargeModal(IPRegistrationModel.IpRegistrationModel admission)
    {
        dischargeRequest = new IPRegistrationModel.DischargeRequest
        {
            ip_id = admission.ip_id,
            discharge_type = "NORMAL",
            discharge_summary = ""
        };
        showDischargeModal = true;
    }

    private void CloseDischargeModal()
    {
        showDischargeModal = false;
        selectResetKey++;
        StateHasChanged();
    }

    private async Task ExecuteDischarge()
    {
        if (string.IsNullOrWhiteSpace(dischargeRequest.discharge_type))
        {
            ToastService.ShowError("Please select a discharge type.");
            return;
        }

        try
        {
            var (success, message) = await IpService.DischargePatientAsync(dischargeRequest);
            if (success)
            {
                ToastService.ShowSuccess(message);
                showDischargeModal = false;
                await LoadDataAsync();
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError(message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error discharging patient: {ex.Message}");
        }
    }

    private bool showUpdateModal = false;
    private bool showCancelModal = false;
    private int selectResetKey = 0;
    private string selectedUpdatePatientName = "";
    private IPRegistrationModel.UpdateIpRegistrationRequest updateRequest = new();
    private IPRegistrationModel.CancelAdmissionRequest cancelRequest = new();

    private void OpenUpdateModal(IPRegistrationModel.IpRegistrationModel admission)
    {
        selectedUpdatePatientName = !string.IsNullOrWhiteSpace(admission.patient_name) ? admission.patient_name : admission.custid.ToString();

        updateRequest = new IPRegistrationModel.UpdateIpRegistrationRequest
        {
            ip_id = admission.ip_id,
            dcode = admission.dcode,
            referring_dcode = admission.referring_dcode,
            department_code = admission.department_code,
            admission_reason = admission.admission_reason,
            expected_dischargedate = admission.expected_dischargedate,
            isinsurancepatient = admission.isinsurancepatient,
            insurance_company = admission.insurance_company,
            policyno = admission.policyno,
            authorizationno = admission.authorizationno,
            tpa_name = admission.tpa_name,
            insurance_approved_amount = admission.insurance_approved_amount,
            insurance_status = admission.insurance_status,
            guardian_name = admission.guardian_name,
            guardian_relation = admission.guardian_relation,
            guardian_contact = admission.guardian_contact,
            notes = admission.notes
        };
        showUpdateModal = true;
    }

    private void CloseUpdateModal()
    {
        showUpdateModal = false;
    }

    private async Task ExecuteUpdate()
    {
        try
        {
            var originalAdmission = admissionsList.FirstOrDefault(a => a.ip_id == updateRequest.ip_id);
            decimal? custid = originalAdmission?.custid;
            bool success = await IpService.UpdateIpRegistrationAsync(updateRequest, custid);
            if (success)
            {
                ToastService.ShowSuccess("IP Registration updated successfully!");
                showUpdateModal = false;
                await LoadDataAsync();
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Failed to update IP Registration.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error updating registration: {ex.Message}");
        }
    }

    private void OpenCancelModal(IPRegistrationModel.IpRegistrationModel admission)
    {
        cancelRequest = new IPRegistrationModel.CancelAdmissionRequest
        {
            ip_id = admission.ip_id,
            reason = ""
        };
        showCancelModal = true;
    }

    private void CloseCancelModal()
    {
        showCancelModal = false;
    }

    private async Task ExecuteCancel()
    {
        if (string.IsNullOrWhiteSpace(cancelRequest.reason))
        {
            ToastService.ShowError("Please provide a reason for cancellation.");
            return;
        }

        try
        {
            bool success = await IpService.CancelAdmissionAsync(cancelRequest);
            if (success)
            {
                ToastService.ShowSuccess("Admission cancelled successfully!");
                showCancelModal = false;
                await LoadDataAsync();
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Failed to cancel admission.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error cancelling admission: {ex.Message}");
        }
    }

    private void OnStatusChange(IPRegistrationModel.IpRegistrationModel admission, ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (val == "DISCHARGED")
        {
            OpenDischargeModal(admission);
        }
    }

    private IPRegistrationModel.IpRegistrationModel? selectedInsurancePatient;
    private bool showInsuranceModal = false;

    private void OpenInsuranceCard(IPRegistrationModel.IpRegistrationModel patient)
    {
        selectedInsurancePatient = patient;
        showInsuranceModal = true;
    }

    private void CloseInsuranceCard()
    {
        selectedInsurancePatient = null;
        showInsuranceModal = false;
    }

    private string selectedPatientSearchName = "";
    private bool showPatientDropdown = false;
    private int activeDropdownIndex = 0;
    private List<SharedComponents.Rcl.Models.CustomerModel> filteredPatientsForDropdown = new();

    private void OnPatientSearchInput(ChangeEventArgs e)
    {
        selectedPatientSearchName = e.Value?.ToString() ?? "";
        UpdateFilteredPatients();
        showPatientDropdown = true;
        activeDropdownIndex = 0;
    }

    private void UpdateFilteredPatients()
    {
        if (string.IsNullOrWhiteSpace(selectedPatientSearchName))
        {
            filteredPatientsForDropdown = customersList.Take(50).ToList();
        }
        else
        {
            filteredPatientsForDropdown = customersList
                .Where(c => (c.name != null && c.name.Contains(selectedPatientSearchName, StringComparison.OrdinalIgnoreCase)) ||
                            (c.namewithinitials != null && c.namewithinitials.Contains(selectedPatientSearchName, StringComparison.OrdinalIgnoreCase)) ||
                            (c.custcode != null && c.custcode.Contains(selectedPatientSearchName, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    private void ShowPatientDropdown()
    {
        UpdateFilteredPatients();
        showPatientDropdown = true;
    }

    private async Task HidePatientDropdownWithDelay()
    {
        await Task.Delay(250);
        showPatientDropdown = false;
    }

    private void SelectPatientFromDropdown(SharedComponents.Rcl.Models.CustomerModel p)
    {
        admitRequest.custid = p.custid;
        selectedPatientSearchName = $"{p.custcode} {(string.IsNullOrEmpty(p.namewithinitials) ? p.name : p.namewithinitials)}";
        showPatientDropdown = false;
        StateHasChanged();
        PrintPayload();
    }

    private void OnPatientSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown")
        {
            if (filteredPatientsForDropdown.Any())
            {
                activeDropdownIndex = (activeDropdownIndex + 1) % filteredPatientsForDropdown.Count;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            if (filteredPatientsForDropdown.Any())
            {
                activeDropdownIndex = (activeDropdownIndex - 1 + filteredPatientsForDropdown.Count) % filteredPatientsForDropdown.Count;
            }
        }
        else if (e.Key == "Enter")
        {
            if (filteredPatientsForDropdown.Any() && activeDropdownIndex >= 0 && activeDropdownIndex < filteredPatientsForDropdown.Count)
            {
                SelectPatientFromDropdown(filteredPatientsForDropdown[activeDropdownIndex]);
            }
        }
    }
}
