    private async Task LoadNurseNotesDataAsync()
    {
        loadingNurseNotes = true;
        StateHasChanged();
        try
        {
            await LoadCurrentUserNameAsync();
            var tenant = await GetCurrentTenantCodeAsync();
            
            // Resolve effective IP ID
            resolvedNurseIpId = (IpId.HasValue && IpId.Value != Guid.Empty) ? IpId.Value : null;
            if (!resolvedNurseIpId.HasValue && CustId > 0)
            {
                try
                {
                    var ips = await IpRegistrationService.GetIpRegistrationsAsync("ALL");
                    var match = ips.FirstOrDefault(a => a.custid == CustId && a.ip_status == "ADMITTED")
                                ?? ips.Where(a => a.custid == CustId).OrderByDescending(a => a.admitdate).FirstOrDefault();
                    if (match != null)
                    {
                        resolvedNurseIpId = match.ip_id;
                    }
                }
                catch { }
            }

            if (resolvedNurseIpId.HasValue)
            {
                var ip = resolvedNurseIpId.Value;
                var summary = await NurseNotesService.GetSummaryAsync(ip, tenant);
                if (summary != null && (summary.temperature.Any() || summary.input_output.Any() || summary.service.Any() || summary.medicine.Any() || summary.other.Any() || summary.visiting_doctor.Any() || summary.schedule.Any() || (summary.diabetic?.Any() ?? false)))
                {
                    nurseTempList = summary.temperature ?? new();
                    nurseIoList = summary.input_output ?? new();
                    nurseServiceList = summary.service ?? new();
                    nurseMedicineList = summary.medicine ?? new();
                    nurseOtherList = summary.other ?? new();
                    nurseVisitingDoctorList = summary.visiting_doctor ?? new();
                    nurseScheduleList = summary.schedule ?? new();
                    nurseDiabeticList = summary.diabetic ?? new();
                }
                else
                {
                    nurseTempList = await NurseNotesService.GetTemperaturesAsync(ip, tenant);
                    nurseIoList = await NurseNotesService.GetInputOutputsAsync(ip, tenant);
                    nurseServiceList = await NurseNotesService.GetServicesAsync(ip, tenant);
                    nurseMedicineList = await NurseNotesService.GetMedicinesAsync(ip, tenant);
                    nurseOtherList = await NurseNotesService.GetOthersAsync(ip, tenant);
                    nurseVisitingDoctorList = await NurseNotesService.GetVisitingDoctorsAsync(ip, tenant);
                    nurseScheduleList = await NurseNotesService.GetSchedulesAsync(ip, tenant);
                    nurseDiabeticList = await NurseNotesService.GetDiabeticsAsync(ip, tenant);
                }

                if (!nurseDiabeticList.Any())
                {
                    try
                    {
                        nurseDiabeticList = await NurseNotesService.GetDiabeticsAsync(ip, tenant);
                    }
                    catch { }
                }
                nurseVitalsList = await AppointmentBookingService.GetOpVitalsAsync(null, ip);
