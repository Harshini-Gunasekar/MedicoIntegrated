    private async Task DeletePrescriptionMasterAsync()
    {
        if (currentRequest.prescription != null && !string.IsNullOrEmpty(currentRequest.prescription.pr_code))
        {
            var confirm = await JSRuntimeConfirm("Are you sure you want to delete this entire prescription? This will clear the prescription code and delete detail lines from pharmacy registry.");
            if (confirm)
            {
                savingData = true;
                var deleted = await CaseSheetService.DeletePrescriptionAsync(currentRequest.prescription.pr_code);
                savingData = false;

                if (deleted)
                {
                    ToastService.ShowSuccess("Prescription deleted successfully.");
                    currentRequest.prescription = new CaseSheetPrescriptionRequest();
                    prescriptionRemarks = new CaseSheetPrescriptionRequest();
                }
                else
                {
                    ToastService.ShowError("Failed to delete prescription.");
                }
            }
        }
    }

