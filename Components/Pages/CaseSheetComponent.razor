            bool isNewVisit = (currentKey != lastLoadedVisitKey) || !wasVisible;
            wasVisible = true;

            if (isNewVisit)
            {
                lastLoadedVisitKey = currentKey;
                loadingData = true;
                ResetWorkspaceState();
                StateHasChanged();
                await LoadClinicalWorkspaceAsync();
            }
            else
            {
                _ = LoadPatientPharmacySalesAsync();
            }
        }
        else
        {
            if (wasVisible)
            {
                wasVisible = false;
                lastLoadedVisitKey = "";
                loadingData = true;
                ResetWorkspaceState();
            }
        }
    }

