    // ─────────────────────────────────────────────────────────────
    // LABORATORY REPORT PREVIEW & RESULT VERIFICATION
    // ─────────────────────────────────────────────────────────────
    private string cachedLabReportBase64 = "";
    private List<medico_backend.Model.LabResultEntry> loadedLabResultEntries = new();

    private string GetLabParameterName(medico_backend.Model.LabResultEntry? item)
    {
        if (item == null) return "Result";
        if (!string.IsNullOrWhiteSpace(item.col2)) return item.col2.Trim().TrimEnd(':');
        if (!string.IsNullOrWhiteSpace(item.testname)) return item.testname.Trim().TrimEnd(':');
        return "Result";
    }

    private List<medico_backend.Model.LabResultEntry> GetMatchingLabResults(CaseSheetInvestigationItem test)
    {
        if (loadedLabResultEntries == null || !loadedLabResultEntries.Any() || test == null) return new();

        string tName = test.test_name?.Trim() ?? "";
        long tCode = test.test_code ?? 0;
        var subParts = tName.Split(new[] { ',', '/', '&' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        return loadedLabResultEntries.Where(r =>
        {
            if (tCode > 0 && r.tcode == tCode) return true;
            if (!string.IsNullOrWhiteSpace(r.testname) && string.Equals(r.testname.Trim(), tName, StringComparison.OrdinalIgnoreCase)) return true;
            if (!string.IsNullOrWhiteSpace(r.groupname) && string.Equals(r.groupname.Trim(), tName, StringComparison.OrdinalIgnoreCase)) return true;
            if (!string.IsNullOrWhiteSpace(tName) && !string.IsNullOrWhiteSpace(r.testname) && (r.testname.IndexOf(tName, StringComparison.OrdinalIgnoreCase) >= 0 || tName.IndexOf(r.testname.Trim(), StringComparison.OrdinalIgnoreCase) >= 0)) return true;
            if (!string.IsNullOrWhiteSpace(tName) && !string.IsNullOrWhiteSpace(r.groupname) && (r.groupname.IndexOf(tName, StringComparison.OrdinalIgnoreCase) >= 0 || tName.IndexOf(r.groupname.Trim(), StringComparison.OrdinalIgnoreCase) >= 0)) return true;

            // Compound test name matching (e.g. CBC,ESR)
            foreach (var part in subParts)
            {
                if (part.Length < 2) continue;
                if (!string.IsNullOrWhiteSpace(r.testname) && (string.Equals(r.testname.Trim(), part, StringComparison.OrdinalIgnoreCase) || r.testname.IndexOf(part, StringComparison.OrdinalIgnoreCase) >= 0)) return true;
                if (!string.IsNullOrWhiteSpace(r.groupname) && (string.Equals(r.groupname.Trim(), part, StringComparison.OrdinalIgnoreCase) || r.groupname.IndexOf(part, StringComparison.OrdinalIgnoreCase) >= 0)) return true;
            }

            return false;
        }).ToList();
    }

    private async Task<string> TryExtractPdfBase64Async(HttpResponseMessage resp)
    {
        if (!resp.IsSuccessStatusCode || resp.StatusCode == System.Net.HttpStatusCode.NoContent)
            return "";

        var mediaType = resp.Content.Headers.ContentType?.MediaType?.ToLowerInvariant() ?? "";
        if (mediaType.Contains("pdf") || mediaType.Contains("octet-stream"))
        {
            var bytes = await resp.Content.ReadAsByteArrayAsync();
            if (bytes != null && bytes.Length > 0)
            {
                return Convert.ToBase64String(bytes);
            }
        }

        var bytesRaw = await resp.Content.ReadAsByteArrayAsync();
        if (bytesRaw != null && bytesRaw.Length >= 4 &&
            bytesRaw[0] == 0x25 && bytesRaw[1] == 0x50 && bytesRaw[2] == 0x44 && bytesRaw[3] == 0x46) // %PDF
        {
            return Convert.ToBase64String(bytesRaw);
        }

        var raw = System.Text.Encoding.UTF8.GetString(bytesRaw ?? Array.Empty<byte>());
        if (string.IsNullOrWhiteSpace(raw)) return "";

        if (raw.TrimStart().StartsWith("{"))
        {
            try
            {
                var jObj = Newtonsoft.Json.Linq.JObject.Parse(raw);
                var possibleFields = new[] { "pdf", "data", "result", "base64", "report", "file", "pdfBase64", "content", "fileContents", "filecontent" };
                foreach (var f in possibleFields)
                {
                    var val = jObj[f]?.ToString();
                    if (!string.IsNullOrWhiteSpace(val) && val.Length >= 50)
                    {
                        return CleanBase64String(val);
                    }
                }
            }
            catch { }
        }

        return CleanBase64String(raw);
    }

    private async Task CheckLabResultsEnteredAsync()
    {
        if (checkingLabResults) return;
        try
        {
            checkingLabResults = true;
            hasLabResultsEntered = false;
            labReportRequestGuid = "";
            cachedLabReportBase64 = "";
            loadedLabResultEntries.Clear();

            var custStr = CustId > 0 ? CustId.ToString() : "";
            var patName = (PatientName ?? "").Trim();
            var visitDt = VisitDate ?? DateTime.Today;
            var fromDate = visitDt.AddYears(-2).ToString("yyyy-MM-dd");
            var toDate = visitDt.AddMonths(3).ToString("yyyy-MM-dd");

            string sessionTenant = await GetCurrentTenantCodeAsync();
            string effectiveTenant = !string.IsNullOrEmpty(sessionTenant) ? sessionTenant : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");

            string userAuthToken = !string.IsNullOrEmpty(TenantState?.AuthToken) ? TenantState.AuthToken : "";
            if (string.IsNullOrEmpty(userAuthToken))
            {
                try
                {
                    var claimRes = await _sessionStorage.GetAsync<string>("claim");
                    if (claimRes.Success && claimRes.Value != null && !string.IsNullOrEmpty(claimRes.Value))
                    {
                        userAuthToken = claimRes.Value;
                    }
                }
                catch { }
            }
            if (string.IsNullOrEmpty(userAuthToken))
            {
                try
                {
                    var ud = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (ud.Success && ud.Value != null && !string.IsNullOrEmpty(ud.Value.AuthToken))
                    {
                        userAuthToken = ud.Value.AuthToken;
                    }
                }
                catch { }
            }

            var medicoClient = ClientFactory.CreateClient("Medico");

            void AttachHeaders(HttpRequestMessage req)
            {
                if (!string.IsNullOrEmpty(userAuthToken))
                    req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", userAuthToken);
                if (!string.IsNullOrEmpty(effectiveTenant))
                    req.Headers.Add("tenant_code", effectiveTenant);
            }

            var candidateGuids = new List<string>();
            var finishedLabGuidsFromVrs = new List<string>();

            // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            // 1. PRIMARY: Query api/labresult/viewresultsearch (LIMS Lab Result Search)
            //    Finds actual laboratory requests and prioritizes completed / finished tests
            // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            try
            {
                var vrsUrls = new List<string>
                {
                    $"api/labresult/viewresultsearch?dcode=0&fromdate={fromDate}&todate={toDate}",
                    $"api/labresult/viewresultsearch?fromdate={fromDate}&todate={toDate}"
                };
                if (Dcode > 0)
                {
                    vrsUrls.Insert(0, $"api/labresult/viewresultsearch?dcode={Dcode}&fromdate={fromDate}&todate={toDate}");
                }

                foreach (var vrsUrl in vrsUrls)
                {
                    try
                    {
                        var vrsReq = new HttpRequestMessage(HttpMethod.Get, vrsUrl);
                        AttachHeaders(vrsReq);

                        var vrsRes = await medicoClient.SendAsync(vrsReq);
                        if (vrsRes.IsSuccessStatusCode)
                        {
                            var vrsJson = await vrsRes.Content.ReadAsStringAsync();
                            var vrsList = JsonConvert.DeserializeObject<List<medico_backend.Model.ViewResultSearch>>(vrsJson);
                            if (vrsList != null && vrsList.Any())
                            {
                                var matchingCustomerRecords = vrsList.Where(item => {
                                    if (string.IsNullOrWhiteSpace(item.requestguid)) return false;

                                    if (!string.IsNullOrEmpty(custStr) && !string.IsNullOrWhiteSpace(item.custcode))
                                    {
                                        var cleanCode = item.custcode.Replace("CUST-", "", StringComparison.OrdinalIgnoreCase).Trim();
                                        if (string.Equals(cleanCode, custStr, StringComparison.OrdinalIgnoreCase) ||
                                            string.Equals(item.custcode, custStr, StringComparison.OrdinalIgnoreCase) ||
                                            item.custcode.Contains(custStr, StringComparison.OrdinalIgnoreCase))
                                            return true;
                                    }

                                    if (!string.IsNullOrWhiteSpace(OpNo))
                                    {
                                        if (string.Equals(item.hospitalpatientid, OpNo, StringComparison.OrdinalIgnoreCase) ||
                                            string.Equals(item.hospitalid, OpNo, StringComparison.OrdinalIgnoreCase) ||
                                            string.Equals(item.billnoprint, OpNo, StringComparison.OrdinalIgnoreCase) ||
                                            string.Equals(item.custcode, OpNo, StringComparison.OrdinalIgnoreCase) ||
                                            (!string.IsNullOrWhiteSpace(item.custcode) && item.custcode.Contains(OpNo, StringComparison.OrdinalIgnoreCase)) ||
                                            (!string.IsNullOrWhiteSpace(item.hospitalpatientid) && item.hospitalpatientid.Contains(OpNo, StringComparison.OrdinalIgnoreCase)))
                                            return true;
                                    }

                                    if (!string.IsNullOrWhiteSpace(patName) && !string.IsNullOrWhiteSpace(item.name))
                                    {
                                        var itemPatName = item.name.Trim();
                                        if (string.Equals(itemPatName, patName, StringComparison.OrdinalIgnoreCase) ||
                                            itemPatName.IndexOf(patName, StringComparison.OrdinalIgnoreCase) >= 0 ||
                                            patName.IndexOf(itemPatName, StringComparison.OrdinalIgnoreCase) >= 0)
                                            return true;
                                    }

                                    return false;
                                }).ToList();

                                if (matchingCustomerRecords.Any())
                                {
                                    bool IsItemFinished(medico_backend.Model.ViewResultSearch it) =>
                                        it.resultstatus == true ||
                                        it.isauthorized1 == true ||
                                        it.isauthorized2 == true ||
                                        it.requestresultstatus == true ||
                                        it.isinvestigationauthorized1 == true ||
                                        it.isinvestigationauthorized2 == true ||
                                        it.isprinted == true ||
                                        it.isinvestigationprinted1 == true;

                                    var grouped = matchingCustomerRecords
                                        .Where(x => !string.IsNullOrWhiteSpace(x.requestguid) && Guid.TryParse(x.requestguid.Trim(), out var parsed) && parsed != Guid.Empty)
                                        .GroupBy(x => x.requestguid!.Trim(), StringComparer.OrdinalIgnoreCase)
                                        .Select(g => new
                                        {
                                            Guid = g.Key,
                                            IsFinished = g.Any(IsItemFinished),
                                            MaxDate = g.Max(x => x.requestdatetime),
                                            DaysDiff = Math.Abs((g.Max(x => x.requestdatetime).Date - visitDt.Date).TotalDays)
                                        })
                                        .OrderByDescending(g => g.IsFinished)
                                        .ThenByDescending(g => g.DaysDiff <= 3)
                                        .ThenByDescending(g => g.MaxDate)
                                        .ToList();

                                    foreach (var grp in grouped)
                                    {
                                        if (grp.IsFinished && !finishedLabGuidsFromVrs.Contains(grp.Guid))
                                        {
                                            finishedLabGuidsFromVrs.Add(grp.Guid);
                                        }
                                        if (!candidateGuids.Contains(grp.Guid))
                                        {
                                            candidateGuids.Add(grp.Guid);
                                        }
                                    }

                                    if (finishedLabGuidsFromVrs.Any()) break;
                                }
                            }
                        }
                    }
                    catch { }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[CheckLabResultsEntered] ViewResultSearch notice: {ex.Message}");
            }

            // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            // 2. Billing search: Query bills via POST api/HmsBilling/list-bills
            // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            try
            {
                var billingSearchPayloads = new List<object>();

                if (!string.IsNullOrWhiteSpace(patName))
                {
                    billingSearchPayloads.Add(new { page = 1, pagesize = 100, search = patName });
                    billingSearchPayloads.Add(new { page = 1, pagesize = 100, search = patName, fromdate = fromDate, todate = toDate });
                }
                if (!string.IsNullOrWhiteSpace(OpNo))
                {
                    billingSearchPayloads.Add(new { page = 1, pagesize = 100, search = OpNo });
                    billingSearchPayloads.Add(new { page = 1, pagesize = 100, search = OpNo, fromdate = fromDate, todate = toDate });
                }
                if (!string.IsNullOrWhiteSpace(custStr))
                {
                    billingSearchPayloads.Add(new { page = 1, pagesize = 100, search = custStr });
                    billingSearchPayloads.Add(new { page = 1, pagesize = 100, search = $"CUST-{custStr}" });
                }
                if (CustId > 0)
                {
                    billingSearchPayloads.Add(new { page = 1, pagesize = 100, custid = CustId, fromdate = fromDate, todate = toDate });
                    billingSearchPayloads.Add(new { page = 1, pagesize = 100, custid = CustId });
                }

                foreach (var pObj in billingSearchPayloads)
                {
                    try
                    {
                        var listReq = new HttpRequestMessage(HttpMethod.Post, "api/HmsBilling/list-bills")
                        {
                            Content = new StringContent(JsonConvert.SerializeObject(pObj), System.Text.Encoding.UTF8, "application/json")
                        };
                        AttachHeaders(listReq);
                        var listRes = await medicoClient.SendAsync(listReq);
                        if (listRes.IsSuccessStatusCode)
                        {
                            var listJson = await listRes.Content.ReadAsStringAsync();
                            var listResp = JsonConvert.DeserializeObject<HmsBillListResponse>(listJson);
                            if (listResp?.data != null && listResp.data.Any())
                            {
                                var matchedBills = listResp.data.Where(b =>
                                    !string.IsNullOrWhiteSpace(b.requestguid) && (
                                        (!string.IsNullOrWhiteSpace(patName) && !string.IsNullOrWhiteSpace(b.patient_name) && (
                                            string.Equals(b.patient_name.Trim(), patName, StringComparison.OrdinalIgnoreCase) ||
                                            b.patient_name.IndexOf(patName, StringComparison.OrdinalIgnoreCase) >= 0 ||
                                            patName.IndexOf(b.patient_name.Trim(), StringComparison.OrdinalIgnoreCase) >= 0
                                        )) ||
                                        (!string.IsNullOrWhiteSpace(OpNo) && (
                                            string.Equals(b.opvisitid, OpNo, StringComparison.OrdinalIgnoreCase) ||
                                            string.Equals(b.custcode, OpNo, StringComparison.OrdinalIgnoreCase) ||
                                            string.Equals(b.op_no, OpNo, StringComparison.OrdinalIgnoreCase) ||
                                            string.Equals(b.opno, OpNo, StringComparison.OrdinalIgnoreCase) ||
                                            (!string.IsNullOrWhiteSpace(b.opvisitid) && b.opvisitid.Contains(OpNo, StringComparison.OrdinalIgnoreCase))
                                        )) ||
                                        (CustId > 0 && b.custid.HasValue && b.custid.Value == CustId) ||
                                        (!string.IsNullOrWhiteSpace(custStr) && (
                                            (b.custid.HasValue && b.custid.Value.ToString() == custStr) ||
                                            (!string.IsNullOrWhiteSpace(b.custcode) && (
                                                string.Equals(b.custcode, custStr, StringComparison.OrdinalIgnoreCase) ||
                                                b.custcode.Contains(custStr, StringComparison.OrdinalIgnoreCase)
                                            ))
                                        ))
                                    )
                                )
                                .OrderByDescending(b => b.bill_date.HasValue && visitDt != default && Math.Abs((b.bill_date.Value - visitDt).TotalDays) <= 3)
                                .ThenByDescending(b => b.bill_date)
                                .ToList();

                                foreach (var mb in matchedBills)
                                {
                                    var g = mb.requestguid!.Trim();
                                    if (!candidateGuids.Contains(g))
                                    {
                                        candidateGuids.Add(g);
                                    }
                                }
                            }
                        }
                    }
                    catch { }
                }

                // Also check direct visit bill if available
                if (OpId != Guid.Empty)
                {
                    try
                    {
                        var directBill = await HmsBillingService.GetBillAsync(OpId);
                        if (directBill != null && !string.IsNullOrWhiteSpace(directBill.requestguid))
                        {
                            var g = directBill.requestguid.Trim();
                            if (!candidateGuids.Contains(g))
                            {
                                candidateGuids.Add(g);
                            }
                        }
                    }
                    catch { }
                }

                // Fallback: Direct Investigation Master Guid if present
                if (currentRequest.investigation != null && !string.IsNullOrWhiteSpace(currentRequest.investigation.inv_id))
                {
                    if (Guid.TryParse(currentRequest.investigation.inv_id.Trim(), out var parsedInv) && parsedInv != Guid.Empty)
                    {
                        if (!candidateGuids.Contains(currentRequest.investigation.inv_id.Trim()))
                        {
                            candidateGuids.Add(currentRequest.investigation.inv_id.Trim());
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[CheckLabResultsEntered] Billing search notice: {ex.Message}");
            }

            // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            // 3. VERIFICATION: Validate candidate GUIDs via api/LabResult/LoadResultEntry
            //    Strictly ensure ONLY finished/completed laboratory results are selected!
            // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            foreach (var labGuid in candidateGuids)
            {
                try
                {
                    var testUrls = new List<string>
                    {
                        $"api/LabResult/LoadResultEntry?requestguid={labGuid}",
                        $"api/LabResult/LoadResultEntry?requestGuid={labGuid}",
                        $"api/labresult/loadtestresultentry?requestguid={labGuid}&custcode={Uri.EscapeDataString(OpNo ?? "")}",
                        $"api/labresult/loadtestresultentry?requestguid={labGuid}&custcode={custStr}",
                        $"api/labresult/loadtestresultentry?requestguid={labGuid}"
                    };

                    foreach (var loadUrl in testUrls)
                    {
                        try
                        {
                            var loadReq = new HttpRequestMessage(HttpMethod.Get, loadUrl);
                            AttachHeaders(loadReq);

                            var loadRes = await medicoClient.SendAsync(loadReq);
                            if (loadRes.IsSuccessStatusCode)
                            {
                                var loadJson = await loadRes.Content.ReadAsStringAsync();
                                var freshModel = JsonConvert.DeserializeObject<medico_backend.Model.ResultEntryModel>(loadJson);
                                if (freshModel?.results != null && freshModel.results.Any())
                                {
                                    // Verify that actual lab test results have been entered/completed
                                    bool hasCompletedResults = freshModel.results.Any(r =>
                                        r.status == true ||
                                        r.isauthorized1 == true ||
                                        r.isauthorized2 == true ||
                                        (!string.IsNullOrWhiteSpace(r.enteredresult) && r.enteredresult.Trim() != "-" && r.enteredresult.Trim() != "â€”") ||
                                        (r.resultenteredby > 0 && !string.IsNullOrWhiteSpace(r.enteredresult))
                                    );

                                    if (hasCompletedResults)
                                    {
                                        loadedLabResultEntries = freshModel.results.ToList();
                                        hasLabResultsEntered = true;
                                        labReportRequestGuid = labGuid;
                                        Console.WriteLine($"[CheckLabResultsEntered] Verified {loadedLabResultEntries.Count} finished lab results for GUID {labGuid}");
                                        break;
                                    }
                                }
                            }
                        }
                        catch { }
                    }

                    if (hasLabResultsEntered && !string.IsNullOrEmpty(labReportRequestGuid))
                    {
                        break;
                    }
                }
                catch { }
            }

            // Fallback: If LoadResultEntry was unable to load results (e.g. format difference),
            // but viewresultsearch explicitly confirmed a finished lab request for this patient, select that finished lab GUID
            if (!hasLabResultsEntered && finishedLabGuidsFromVrs.Any())
            {
                var topFinishedGuid = finishedLabGuidsFromVrs.First();
                labReportRequestGuid = topFinishedGuid;
                hasLabResultsEntered = true;
                Console.WriteLine($"[CheckLabResultsEntered] Selected finished lab request GUID from viewresultsearch: {topFinishedGuid}");
            }

            // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            // 4. Pre-probe PDF report endpoint using the verified finished lab requestguid:
            //    /api/report/labreport?requestguid={}&isletterhead=true
            // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            if (hasLabResultsEntered && !string.IsNullOrEmpty(labReportRequestGuid))
            {
                try
                {
                    var probeUrls = new List<string>
                    {
                        $"api/report/labreport?requestguid={labReportRequestGuid}&isletterhead=true",
                        $"api/Report/LabReport?requestguid={labReportRequestGuid}&isletterhead=true",
                        $"api/report/culture-report?requestguid={labReportRequestGuid}&isletterhead=true",
                        $"api/Report/culture-report?requestguid={labReportRequestGuid}&isletterhead=true"
                    };

                    foreach (var probeUrl in probeUrls)
                    {
                        var probeReq = new HttpRequestMessage(HttpMethod.Get, probeUrl);
                        AttachHeaders(probeReq);
                        var probeRes = await medicoClient.SendAsync(probeReq);

                        if (probeRes.IsSuccessStatusCode && probeRes.StatusCode != System.Net.HttpStatusCode.NoContent)
                        {
                            string cleaned = await TryExtractPdfBase64Async(probeRes);
                            if (!string.IsNullOrEmpty(cleaned) && cleaned.Length >= 50)
                            {
                                cachedLabReportBase64 = cleaned;
                                break;
                            }
                        }
                    }
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CheckLabResultsEntered] Error: {ex.Message}");
        }
        finally
        {
            checkingLabResults = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string CleanBase64String(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        var s = raw.Trim();
        if (s.StartsWith("\"") && s.EndsWith("\""))
        {
            try { s = JsonConvert.DeserializeObject<string>(s) ?? s.Trim('"'); }
            catch { s = s.Trim('"'); }
        }
        if (s.StartsWith("{") && s.EndsWith("}"))
        {
            try
            {
                var jObj = Newtonsoft.Json.Linq.JObject.Parse(s);
                var token = jObj["data"] ?? jObj["result"] ?? jObj["pdf"] ?? jObj["report"] ?? jObj["file"] ?? jObj["base64"] ?? jObj["fileContents"] ?? jObj["filecontent"];
                if (token != null) s = token.ToString();
            }
            catch { }
        }
        if (s.StartsWith("data:application/pdf;base64,"))
        {
            s = s.Substring("data:application/pdf;base64,".Length);
        }
        return s.Trim();
    }

    private async Task PreviewLabReportAsync(string? requestGuid = null)
    {
        var activeGuid = !string.IsNullOrWhiteSpace(requestGuid) ? requestGuid : labReportRequestGuid;
        if (string.IsNullOrWhiteSpace(activeGuid) || !hasLabResultsEntered)
        {
            await CheckLabResultsEnteredAsync();
            activeGuid = labReportRequestGuid;
        }

        if (string.IsNullOrWhiteSpace(activeGuid) || !hasLabResultsEntered)
        {
            ToastService.ShowWarning("No finished laboratory results found for this patient.");
            return;
        }
        try
        {
            loadingLabReportPreview = true;
            StateHasChanged();

            // If we already have the base64 cached from CheckLabResultsEnteredAsync, open it immediately
            if (!string.IsNullOrEmpty(cachedLabReportBase64) && (activeGuid == labReportRequestGuid || string.IsNullOrEmpty(requestGuid)))
            {
                string cachedTitle = $"Lab Report - {(string.IsNullOrWhiteSpace(PatientName) ? "Patient" : PatientName)}";
                await JSRuntime.InvokeVoidAsync("openPdfPreviewModal", cachedLabReportBase64, cachedTitle);
                ToastService.ShowSuccess("Laboratory report loaded successfully.");
                return;
            }

            string sessionTenant = await GetCurrentTenantCodeAsync();
            string effectiveTenant = !string.IsNullOrEmpty(sessionTenant) ? sessionTenant : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");

            string userAuthToken = !string.IsNullOrEmpty(TenantState?.AuthToken) ? TenantState.AuthToken : "";
            if (string.IsNullOrEmpty(userAuthToken))
            {
                try
                {
                    var claimRes = await _sessionStorage.GetAsync<string>("claim");
                    if (claimRes.Success && claimRes.Value != null && !string.IsNullOrEmpty(claimRes.Value))
                    {
                        userAuthToken = claimRes.Value;
                    }
                }
                catch { }
            }
            if (string.IsNullOrEmpty(userAuthToken))
            {
                try
                {
                    var ud = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (ud.Success && ud.Value != null && !string.IsNullOrEmpty(ud.Value.AuthToken))
                    {
                        userAuthToken = ud.Value.AuthToken;
                    }
                }
                catch { }
            }

            void AttachHeaders(HttpRequestMessage req)
            {
                if (!string.IsNullOrEmpty(userAuthToken))
                    req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", userAuthToken);
                if (!string.IsNullOrEmpty(effectiveTenant))
                    req.Headers.Add("tenant_code", effectiveTenant);
            }

            string tz = "";
            try { tz = TimeZoneInfo.Local.StandardName ?? ""; } catch { }
            string tzParam = !string.IsNullOrEmpty(tz) ? $"&timezone={Uri.EscapeDataString(tz)}" : "";

            string base64Result = "";
            var client = ClientFactory.CreateClient("Medico");

            // Candidate URLs strictly querying labreport endpoint with requestguid (same as in labresultentry page)
            var candidateUrls = new List<string>
            {
                $"api/report/labreport?requestguid={activeGuid}&isletterhead=true",
                $"api/Report/LabReport?requestguid={activeGuid}&isletterhead=true",
                $"api/report/culture-report?requestguid={activeGuid}&isletterhead=true",
                $"api/Report/culture-report?requestguid={activeGuid}&isletterhead=true",
                $"api/report/labreport?requestguid={activeGuid}&isletterhead=false",
                $"api/Report/LabReport?requestguid={activeGuid}&isletterhead=false"
            };
            if (!string.IsNullOrEmpty(tzParam))
            {
                candidateUrls.Add($"api/report/labreport?requestguid={activeGuid}&isletterhead=true{tzParam}");
                candidateUrls.Add($"api/Report/LabReport?requestguid={activeGuid}&isletterhead=true{tzParam}");
            }

            var baseApi = Configuration["ApiBaseUrl"]?.TrimEnd('/') ?? "";
            if (!string.IsNullOrEmpty(baseApi))
            {
                candidateUrls.Add($"{baseApi}/api/report/labreport?requestguid={activeGuid}&isletterhead=true");
                candidateUrls.Add($"{baseApi}/api/report/culture-report?requestguid={activeGuid}&isletterhead=true");
            }

            foreach (var url in candidateUrls)
            {
                try
                {
                    var req = new HttpRequestMessage(HttpMethod.Get, url);
                    AttachHeaders(req);
                    var resp = await client.SendAsync(req);
                    if (resp.IsSuccessStatusCode && resp.StatusCode != System.Net.HttpStatusCode.NoContent)
                    {
                        string cleaned = await TryExtractPdfBase64Async(resp);
                        if (!string.IsNullOrEmpty(cleaned) && cleaned.Length >= 50)
                        {
                            base64Result = cleaned;
                            break;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[PreviewLabReport] Candidate URL '{url}' failed: {ex.Message}");
                }
            }

            // RDLC POST Fallback with the lab result entry requestguid
            if (string.IsNullOrEmpty(base64Result))
            {
                try
                {
                    var reportPayload = new
                    {
                        ClientID = effectiveTenant,
                        DataSource = "DataSet3",
                        ReportName = "LabReport.rdlc",
                        RequestGUID = activeGuid,
                        TCode = "",
                        IsAuthorized2Finished = false,
                        QueryString = $"SampleID={activeGuid}",
                        Parameters = new List<object>
                        {
                            new { Name = "RequestGUID", Values = new List<string> { activeGuid } },
                            new { Name = "tcode", Values = new List<string> { "" } },
                            new { Name = "IsLetterHead", Values = new List<string> { "true" } }
                        }
                    };
                    var postReq = new HttpRequestMessage(HttpMethod.Post, "api/report/labreport")
                    {
                        Content = new StringContent(JsonConvert.SerializeObject(reportPayload), System.Text.Encoding.UTF8, "application/json")
                    };
                    AttachHeaders(postReq);
                    var postRes = await client.SendAsync(postReq);
                    if (postRes.IsSuccessStatusCode && postRes.StatusCode != System.Net.HttpStatusCode.NoContent)
                    {
                        string cleaned = await TryExtractPdfBase64Async(postRes);
                        if (!string.IsNullOrEmpty(cleaned) && cleaned.Length >= 50)
                        {
                            base64Result = cleaned;
                        }
                    }
                }
                catch { }
            }

            if (!string.IsNullOrEmpty(base64Result))
            {
                cachedLabReportBase64 = base64Result;
                string docTitle = $"Lab Report - {(string.IsNullOrWhiteSpace(PatientName) ? "Patient" : PatientName)}";
                await JSRuntime.InvokeVoidAsync("openPdfPreviewModal", base64Result, docTitle);
                ToastService.ShowSuccess("Laboratory report loaded successfully.");
            }
            else
            {
                ToastService.ShowError("Laboratory report is not yet generated or returned empty data.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error previewing lab report: {ex.Message}");
        }
        finally
        {
            loadingLabReportPreview = false;
            StateHasChanged();
        }
    }

