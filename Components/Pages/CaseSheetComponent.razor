    private decimal GetSalesDetailAmount(sales_detail d)
    {
        if (d == null) return 0;
        if (d.totalamount > 0) return d.totalamount;
        if (d.amount > 0) return d.amount;
        var qty = d.quantity > 0 ? d.quantity : d.soldqty;
        if (qty > 0 && d.rate > 0) return qty * d.rate;
        return 0;
    }

    private static bool TryGetJsonPropIgnoreCase(System.Text.Json.JsonElement el, string name, out System.Text.Json.JsonElement prop)
    {
        prop = default;
        if (el.ValueKind != System.Text.Json.JsonValueKind.Object) return false;
        foreach (var p in el.EnumerateObject())
        {
            if (string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase))
            {
                prop = p.Value;
                return true;
            }
        }
        return false;
    }

    private static string? GetJsonStringSafe(System.Text.Json.JsonElement p)
    {
        if (p.ValueKind == System.Text.Json.JsonValueKind.String) return p.GetString();
        if (p.ValueKind == System.Text.Json.JsonValueKind.Number) return p.GetRawText();
        if (p.ValueKind == System.Text.Json.JsonValueKind.True) return "true";
        if (p.ValueKind == System.Text.Json.JsonValueKind.False) return "false";
        if (p.ValueKind == System.Text.Json.JsonValueKind.Null || p.ValueKind == System.Text.Json.JsonValueKind.Undefined) return null;
        return p.GetRawText();
    }

    private sales_master? ParseSingleSalesMaster(System.Text.Json.JsonElement el, System.Text.Json.JsonSerializerOptions options)
    {
        var target = el;
        if (el.TryGetProperty("master", out var mProp)) target = mProp;
        else if (TryGetJsonPropIgnoreCase(el, "master", out var mProp2)) target = mProp2;

        sales_master? m = null;
        try
        {
            m = System.Text.Json.JsonSerializer.Deserialize<sales_master>(target.GetRawText(), options);
        }
        catch { }

        m ??= new sales_master();

        if (m.salescode == 0)
        {
            foreach (var key in new[] { "salescode", "sales_code", "code", "id" })
            {
                if (TryGetJsonPropIgnoreCase(target, key, out var p))
                {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number && p.TryGetInt64(out var val)) { m.salescode = val; break; }
                    else if (p.ValueKind == System.Text.Json.JsonValueKind.String && long.TryParse(p.GetString(), out var sVal)) { m.salescode = sVal; break; }
                }
            }
        }
        if (string.IsNullOrEmpty(m.billno))
        {
            foreach (var key in new[] { "billno", "bill_no", "invoiceno", "invoice_no" })
            {
                if (TryGetJsonPropIgnoreCase(target, key, out var p))
                {
                    m.billno = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.billno)) break;
                }
            }
        }
        if (m.billdate == default)
        {
            foreach (var key in new[] { "billdate", "bill_date", "createddate", "created_date" })
            {
                if (TryGetJsonPropIgnoreCase(target, key, out var p))
                {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.String && DateTime.TryParse(p.GetString(), out var dt))
                    {
                        m.billdate = dt;
                        break;
                    }
                    else if (p.TryGetDateTime(out var dtVal))
                    {
                        m.billdate = dtVal;
                        break;
                    }
                }
            }
        }
        if (string.IsNullOrEmpty(m.patientname))
        {
            foreach (var key in new[] { "patientname", "patient_name", "customername", "name" })
            {
                if (TryGetJsonPropIgnoreCase(target, key, out var p))
                {
                    m.patientname = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.patientname)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.patientid))
        {
            foreach (var key in new[] { "patientid", "patient_id", "customercode", "customer_code" })
            {
                if (TryGetJsonPropIgnoreCase(target, key, out var p))
                {
                    var pid = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(pid) && pid != "0")
                    {
                        m.patientid = pid;
                        break;
                    }
                }
            }
        }
        if (!m.customercode.HasValue || m.customercode.Value == 0)
        {
            foreach (var key in new[] { "customercode", "customer_code", "custid", "cust_id", "patientid", "patient_id" })
            {
                if (TryGetJsonPropIgnoreCase(target, key, out var p))
                {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number && p.TryGetInt64(out var cVal)) { m.customercode = cVal; break; }
                    else if (p.ValueKind == System.Text.Json.JsonValueKind.String)
                    {
                        var str = p.GetString()?.Replace("CUST-", "", StringComparison.OrdinalIgnoreCase).Trim();
                        if (long.TryParse(str, out var parsedCust)) { m.customercode = parsedCust; break; }
                    }
                }
            }
        }
        if (string.IsNullOrEmpty(m.paymentstatus))
        {
            foreach (var key in new[] { "paymentstatus", "payment_status", "status", "pay_status" })
            {
                if (TryGetJsonPropIgnoreCase(target, key, out var p))
                {
                    m.paymentstatus = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.paymentstatus)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.paymentmode))
        {
            foreach (var key in new[] { "paymentmode", "payment_mode", "mode" })
            {
                if (TryGetJsonPropIgnoreCase(target, key, out var p))
                {
                    m.paymentmode = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.paymentmode)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.remarks))
        {
            foreach (var key in new[] { "remarks", "remark", "notes" })
            {
                if (TryGetJsonPropIgnoreCase(target, key, out var p))
                {
                    m.remarks = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.remarks)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.invoiceno))
        {
            foreach (var key in new[] { "invoiceno", "invoice_no" })
            {
                if (TryGetJsonPropIgnoreCase(target, key, out var p))
                {
                    m.invoiceno = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.invoiceno)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.tenantcode))
        {
            foreach (var key in new[] { "tenantcode", "tenant_code", "tenantCode", "tenant" })
            {
                if (TryGetJsonPropIgnoreCase(target, key, out var p))
                {
                    m.tenantcode = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.tenantcode)) break;
                }
            }
        }

        return m;
    }

    private sales_detail? ParseSingleSalesDetail(System.Text.Json.JsonElement el, System.Text.Json.JsonSerializerOptions options)
    {
        sales_detail? d = null;
        try
        {
            d = System.Text.Json.JsonSerializer.Deserialize<sales_detail>(el.GetRawText(), options);
        }
        catch { }

        d ??= new sales_detail();

        if (d.itemcode == 0)
        {
            foreach (var key in new[] { "itemcode", "item_code", "itemid", "item_id", "code" })
            {
                if (TryGetJsonPropIgnoreCase(el, key, out var p))
                {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number && p.TryGetInt64(out var v)) { d.itemcode = v; break; }
                    else if (p.ValueKind == System.Text.Json.JsonValueKind.String && long.TryParse(p.GetString(), out var sv)) { d.itemcode = sv; break; }
                }
            }
        }

        if (string.IsNullOrWhiteSpace(d.itemname))
        {
            foreach (var key in new[] { "itemname", "item_name", "drugname", "drug_name", "name", "description" })
            {
                if (TryGetJsonPropIgnoreCase(el, key, out var p))
                {
                    d.itemname = GetJsonStringSafe(p);
                    if (!string.IsNullOrWhiteSpace(d.itemname)) break;
                }
            }
        }

        if (d.quantity == 0)
        {
            foreach (var key in new[] { "quantity", "qty", "soldqty", "sold_qty", "orderedqty", "ordered_qty" })
            {
                if (TryGetJsonPropIgnoreCase(el, key, out var p))
                {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number && p.TryGetDecimal(out var v)) { d.quantity = v; break; }
                    else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var sv)) { d.quantity = sv; break; }
                }
            }
        }

        if (d.soldqty == 0)
        {
            d.soldqty = d.quantity;
        }

        if (!d.days.HasValue || d.days.Value == 0)
        {
            foreach (var key in new[] { "days", "prescribeddays", "prescribed_days", "duration" })
            {
                if (TryGetJsonPropIgnoreCase(el, key, out var p))
                {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number && p.TryGetInt32(out var dv)) { d.days = dv; break; }
                    else if (p.ValueKind == System.Text.Json.JsonValueKind.String && int.TryParse(p.GetString(), out var sdv)) { d.days = sdv; break; }
                }
            }
        }

        if (d.rate == 0)
        {
            foreach (var key in new[] { "rate", "price", "unitprice", "unit_price", "mrp" })
            {
                if (TryGetJsonPropIgnoreCase(el, key, out var p))
                {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number && p.TryGetDecimal(out var v)) { d.rate = v; break; }
                    else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var sv)) { d.rate = sv; break; }
                }
            }
        }

        if (d.amount == 0)
        {
            foreach (var key in new[] { "amount", "grossamount", "gross_amount" })
            {
                if (TryGetJsonPropIgnoreCase(el, key, out var p))
                {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number && p.TryGetDecimal(out var v)) { d.amount = v; break; }
                    else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var sv)) { d.amount = sv; break; }
                }
            }
        }

        if (d.totalamount == 0)
        {
            foreach (var key in new[] { "totalamount", "total_amount", "netamount", "net_amount", "amount" })
            {
                if (TryGetJsonPropIgnoreCase(el, key, out var p))
                {
                    if (p.ValueKind == System.Text.Json.JsonValueKind.Number && p.TryGetDecimal(out var v)) { d.totalamount = v; break; }
                    else if (p.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(p.GetString(), out var sv)) { d.totalamount = sv; break; }
                }
            }
        }

        if (string.IsNullOrEmpty(d.batchno))
        {
            foreach (var key in new[] { "batchno", "batch_no", "batch" })
            {
                if (TryGetJsonPropIgnoreCase(el, key, out var p))
                {
                    d.batchno = p.GetString();
                    if (!string.IsNullOrEmpty(d.batchno)) break;
                }
            }
        }

        // If itemname is empty, look up in allItems
        if (string.IsNullOrWhiteSpace(d.itemname) && d.itemcode > 0 && allItems != null && allItems.Any())
        {
            var match = allItems.FirstOrDefault(x => x.itemcode == (int)d.itemcode);
            if (match != null)
            {
                d.itemname = !string.IsNullOrWhiteSpace(match.drugname) ? match.drugname : match.itemname;
            }
        }

        return d;
    }

    private sales_request? ParseSingleSalesRequest(System.Text.Json.JsonElement el, System.Text.Json.JsonSerializerOptions options)
    {
        var targetMaster = el;
        if (el.TryGetProperty("master", out var mProp)) targetMaster = mProp;
        else if (TryGetJsonPropIgnoreCase(el, "master", out var mProp2)) targetMaster = mProp2;

        var master = ParseSingleSalesMaster(targetMaster, options);
        if (master == null || (master.salescode <= 0 && string.IsNullOrWhiteSpace(master.billno)))
        {
            master = ParseSingleSalesMaster(el, options);
        }
        if (master == null) return null;

        var req = new sales_request { master = master, details = new() };

        System.Text.Json.JsonElement detailsProp = default;
        bool hasDetails = false;
        foreach (var key in new[] { "details", "detail", "salesdetail", "salesdetails", "sales_detail", "sales_details", "items", "itemlist" })
        {
            if (TryGetJsonPropIgnoreCase(el, key, out detailsProp) && detailsProp.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                hasDetails = true;
                break;
            }
        }

        if (hasDetails && detailsProp.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            foreach (var dEl in detailsProp.EnumerateArray())
            {
                var det = ParseSingleSalesDetail(dEl, options);
                if (det != null && (det.itemcode > 0 || !string.IsNullOrWhiteSpace(det.itemname) || det.quantity > 0 || det.amount > 0 || det.totalamount > 0))
                {
                    req.details.Add(det);
                }
            }
        }

        return req;
    }

    private List<sales_request> ParseSalesRequestListJson(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        var options = new System.Text.Json.JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;

            System.Text.Json.JsonElement arrayElement;
            if (root.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                arrayElement = root;
            }
            else if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                if (root.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    arrayElement = dataProp;
                }
                else
                {
                    bool found = false;
                    arrayElement = default;
                    foreach (var prop in root.EnumerateObject())
                    {
                        if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.Array)
                        {
                            arrayElement = prop.Value;
                            found = true;
                            break;
                        }
                    }
                    if (!found)
                    {
                        var singleReq = ParseSingleSalesRequest(root, options);
                        return singleReq != null ? new List<sales_request> { singleReq } : new();
                    }
                }
            }
            else return new();

            var list = new List<sales_request>();
            foreach (var item in arrayElement.EnumerateArray())
            {
                var parsed = ParseSingleSalesRequest(item, options);
                if (parsed != null && parsed.master != null) list.Add(parsed);
            }
            return list;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ParseSalesRequestListJson] Error: {ex.Message}");
        }
        return new();
    }

    private async Task HydrateSalesDetailsAsync(sales_request req, string effectiveTenant, string userAuthToken)
    {
        if (req == null || req.master == null) return;
        if (req.details != null && req.details.Any()) return;

        var salesId = req.master.salescode > 0 ? req.master.salescode.ToString() : req.master.billno;
        if (string.IsNullOrEmpty(salesId)) return;

        var tCodes = new List<string> { effectiveTenant, "0010", "0004", "" }.Distinct().ToList();

        foreach (var tCode in tCodes)
        {
            var variations = new List<string>();
            string tParam = !string.IsNullOrEmpty(tCode) ? $"tenantcode={tCode}&tenant_code={tCode}" : "";

            if (req.master.salescode > 0)
            {
                variations.Add($"api/ItemMaster/getsalesbycode?salescode={req.master.salescode}" + (!string.IsNullOrEmpty(tParam) ? $"&{tParam}" : ""));
                variations.Add($"api/ItemMaster/getsalesbycode?salesCode={req.master.salescode}" + (!string.IsNullOrEmpty(tParam) ? $"&{tParam}" : ""));
                variations.Add($"api/ItemMaster/getsalesbycode/{req.master.salescode}" + (!string.IsNullOrEmpty(tParam) ? $"?{tParam}" : ""));
            }
            if (!string.IsNullOrEmpty(req.master.billno))
            {
                variations.Add($"api/ItemMaster/getsalesbycode?billno={Uri.EscapeDataString(req.master.billno)}" + (!string.IsNullOrEmpty(tParam) ? $"&{tParam}" : ""));
            }

            foreach (var url in variations)
            {
                try
                {
                    var client = ClientFactory.CreateClient("DoctorApi");
                    if (!string.IsNullOrEmpty(tCode))
                    {
                        client.DefaultRequestHeaders.Remove("tenantcode");
                        client.DefaultRequestHeaders.Remove("tenant_code");
                        client.DefaultRequestHeaders.Remove("tenant-code");
                        client.DefaultRequestHeaders.Add("tenantcode", tCode);
                        client.DefaultRequestHeaders.Add("tenant_code", tCode);
                        client.DefaultRequestHeaders.Add("tenant-code", tCode);
                    }
                    if (!string.IsNullOrEmpty(userAuthToken))
                    {
                        client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", userAuthToken);
                    }

                    var response = await client.GetAsync(url);
                    if (response.IsSuccessStatusCode)
                    {
                        var json = await response.Content.ReadAsStringAsync();
                        var parsedList = ParseSalesRequestListJson(json);
                        var loaded = parsedList.FirstOrDefault(x => (req.master.salescode > 0 && x.master?.salescode == req.master.salescode) || (x.details != null && x.details.Any()))
                                     ?? parsedList.FirstOrDefault();
                        if (loaded != null && loaded.details != null && loaded.details.Any())
                        {
                            req.details = loaded.details;
                            foreach (var d in req.details)
                            {
                                if (string.IsNullOrWhiteSpace(d.itemname) && d.itemcode > 0 && allItems.Any())
                                {
                                    var match = allItems.FirstOrDefault(x => x.itemcode == (int)d.itemcode);
                                    if (match != null) d.itemname = !string.IsNullOrWhiteSpace(match.drugname) ? match.drugname : match.itemname;
                                }
                            }
                            return;
                        }
                    }
                }
                catch { }
            }
        }
    }

    private bool IsSaleMatchingPatient(sales_master s, string custStr, string patName, string opNoStr, string ipNoStr, string prCode)
    {
        if (s == null || s.deleted) return false;

        // 1. OP No match (highest specificity across patientid, remarks, invoiceno, billno, ordercode)
        if (!string.IsNullOrEmpty(opNoStr))
        {
            if (!string.IsNullOrWhiteSpace(s.patientid) && (string.Equals(s.patientid.Trim(), opNoStr, StringComparison.OrdinalIgnoreCase) || s.patientid.Contains(opNoStr, StringComparison.OrdinalIgnoreCase)))
                return true;
            if (!string.IsNullOrWhiteSpace(s.remarks) && s.remarks.Contains(opNoStr, StringComparison.OrdinalIgnoreCase))
                return true;
            if (!string.IsNullOrWhiteSpace(s.invoiceno) && s.invoiceno.Contains(opNoStr, StringComparison.OrdinalIgnoreCase))
                return true;
            if (!string.IsNullOrWhiteSpace(s.billno) && s.billno.Contains(opNoStr, StringComparison.OrdinalIgnoreCase))
                return true;
            if (s.ordercode.HasValue && s.ordercode.Value.ToString().Contains(opNoStr, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        // 2. Prescription PR code match
        if (!string.IsNullOrEmpty(prCode))
        {
            if (!string.IsNullOrWhiteSpace(s.remarks) && s.remarks.Contains(prCode, StringComparison.OrdinalIgnoreCase)) return true;
            if (!string.IsNullOrWhiteSpace(s.invoiceno) && s.invoiceno.Contains(prCode, StringComparison.OrdinalIgnoreCase)) return true;
            if (!string.IsNullOrWhiteSpace(s.billno) && s.billno.Contains(prCode, StringComparison.OrdinalIgnoreCase)) return true;
            if (s.ordercode.HasValue && s.ordercode.Value.ToString().Contains(prCode, StringComparison.OrdinalIgnoreCase)) return true;
        }

        // 3. IP No match
        if (!string.IsNullOrEmpty(ipNoStr))
        {
            if (!string.IsNullOrWhiteSpace(s.patientid) && (string.Equals(s.patientid.Trim(), ipNoStr, StringComparison.OrdinalIgnoreCase) || s.patientid.Contains(ipNoStr, StringComparison.OrdinalIgnoreCase)))
                return true;
            if (!string.IsNullOrWhiteSpace(s.remarks) && s.remarks.Contains(ipNoStr, StringComparison.OrdinalIgnoreCase))
                return true;
            if (!string.IsNullOrWhiteSpace(s.invoiceno) && s.invoiceno.Contains(ipNoStr, StringComparison.OrdinalIgnoreCase))
                return true;
            if (!string.IsNullOrWhiteSpace(s.billno) && s.billno.Contains(ipNoStr, StringComparison.OrdinalIgnoreCase))
                return true;
            if (s.ordercode.HasValue && s.ordercode.Value.ToString().Contains(ipNoStr, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        // 4. CustId / customercode / patientid
        if (!string.IsNullOrEmpty(custStr))
        {
            if (s.customercode.HasValue && s.customercode.Value.ToString() == custStr) return true;
            if (!string.IsNullOrWhiteSpace(s.patientid))
            {
                var cleanPid = s.patientid.Replace("CUST-", "", StringComparison.OrdinalIgnoreCase).Trim();
                if (cleanPid.Equals(custStr, StringComparison.OrdinalIgnoreCase) ||
                    cleanPid.Contains(custStr, StringComparison.OrdinalIgnoreCase) ||
                    s.patientid.Contains(custStr, StringComparison.OrdinalIgnoreCase))
                    return true;
            }
        }

        // 5. Patient name
        if (!string.IsNullOrWhiteSpace(patName) && (!string.IsNullOrWhiteSpace(s.patientname) || !string.IsNullOrWhiteSpace(s.customername)))
        {
            var sName = (!string.IsNullOrWhiteSpace(s.patientname) ? s.patientname : s.customername)?.Trim() ?? "";
            if (string.Equals(sName, patName, StringComparison.OrdinalIgnoreCase) ||
                sName.IndexOf(patName, StringComparison.OrdinalIgnoreCase) >= 0 ||
                patName.IndexOf(sName, StringComparison.OrdinalIgnoreCase) >= 0)
            {
                return true;
            }
        }

        return false;
    }

    private void PartitionPharmacySales()
    {
        if (patientAllPharmacySales == null || !patientAllPharmacySales.Any())
        {
            currentVisitPharmacySales = new();
            if (selectedPastVisitCaseSheet != null) pastVisitPharmacySales = new();
            hasPaidPharmacyBill = false;
            pharmacyBillNo = "";
            pharmacySalesCode = 0;
            return;
        }

        var prCode = currentRequest.prescription?.pr_code?.Trim() ?? "";
        var opNoStr = (OpNo ?? "").Trim();
        var ipNoStr = (IpNo ?? "").Trim();
        var patName = (PatientName ?? "").Trim();
        var custStr = CustId > 0 ? CustId.ToString() : "";
        var visitDate = (VisitDate?.Date ?? DateTime.Today.Date);
        var currentPrescItems = currentRequest.prescription?.items?
            .Where(i => !string.IsNullOrWhiteSpace(i.drug_name))
            .ToList() ?? new();

        // Current visit sales: match strictly against current PR code, OP No, IP No, or current visit date with prescribed drugs
        currentVisitPharmacySales = patientAllPharmacySales.Where(s =>
        {
            if (s.master == null) return false;

            // 1. Direct match on PR code
            if (!string.IsNullOrEmpty(prCode))
            {
                if (!string.IsNullOrWhiteSpace(s.master.remarks) && s.master.remarks.Contains(prCode, StringComparison.OrdinalIgnoreCase)) return true;
                if (!string.IsNullOrWhiteSpace(s.master.invoiceno) && s.master.invoiceno.Contains(prCode, StringComparison.OrdinalIgnoreCase)) return true;
                if (!string.IsNullOrWhiteSpace(s.master.billno) && s.master.billno.Contains(prCode, StringComparison.OrdinalIgnoreCase)) return true;
            }

            // 2. Direct match on OP No with visit date match
            if (!string.IsNullOrEmpty(opNoStr))
            {
                bool opMatched = (!string.IsNullOrWhiteSpace(s.master.patientid) && string.Equals(s.master.patientid.Trim(), opNoStr, StringComparison.OrdinalIgnoreCase))
                              || (!string.IsNullOrWhiteSpace(s.master.remarks) && s.master.remarks.Contains(opNoStr, StringComparison.OrdinalIgnoreCase))
                              || (!string.IsNullOrWhiteSpace(s.master.invoiceno) && s.master.invoiceno.Contains(opNoStr, StringComparison.OrdinalIgnoreCase))
                              || (!string.IsNullOrWhiteSpace(s.master.billno) && s.master.billno.Contains(opNoStr, StringComparison.OrdinalIgnoreCase));
                
                if (opMatched && s.master.billdate.Date == visitDate) return true;
            }

            // 3. Direct match on IP No with visit date match
            if (!string.IsNullOrEmpty(ipNoStr))
            {
                bool ipMatched = (!string.IsNullOrWhiteSpace(s.master.patientid) && string.Equals(s.master.patientid.Trim(), ipNoStr, StringComparison.OrdinalIgnoreCase))
                              || (!string.IsNullOrWhiteSpace(s.master.remarks) && s.master.remarks.Contains(ipNoStr, StringComparison.OrdinalIgnoreCase))
                              || (!string.IsNullOrWhiteSpace(s.master.invoiceno) && s.master.invoiceno.Contains(ipNoStr, StringComparison.OrdinalIgnoreCase))
                              || (!string.IsNullOrWhiteSpace(s.master.billno) && s.master.billno.Contains(ipNoStr, StringComparison.OrdinalIgnoreCase));
                
                if (ipMatched && s.master.billdate.Date == visitDate) return true;
            }

            // 4. Prescribed items matching detail line items on the current visit date
            if (s.master.billdate.Date == visitDate && currentPrescItems.Any() && s.details != null && s.details.Any())
            {
                var hasMatchingDrug = s.details.Any(d => currentPrescItems.Any(p =>
                    (p.drug_code.HasValue && p.drug_code.Value > 0 && d.itemcode == (long)p.drug_code.Value) ||
                    (!string.IsNullOrWhiteSpace(d.itemname) && !string.IsNullOrWhiteSpace(p.drug_name) &&
                     (string.Equals(d.itemname.Trim(), p.drug_name.Trim(), StringComparison.OrdinalIgnoreCase) ||
                      d.itemname.Contains(p.drug_name.Trim(), StringComparison.OrdinalIgnoreCase) ||
                      p.drug_name.Contains(d.itemname.Trim(), StringComparison.OrdinalIgnoreCase)))
                ));
                if (hasMatchingDrug) return true;
            }

            return false;
        })
        .OrderByDescending(s => s.master?.billdate)
        .ThenByDescending(s => s.master?.salescode)
        .ToList();

        // Update paid status & bill identifier for Preview Bill Report button
        var activeBilled = currentVisitPharmacySales.FirstOrDefault(s => s.master != null && (!string.IsNullOrWhiteSpace(s.master.billno) || s.master.salescode > 0));
        if (activeBilled == null && selectedPastVisitCaseSheet != null && pastVisitPharmacySales != null)
        {
            activeBilled = pastVisitPharmacySales.FirstOrDefault(s => s.master != null && (!string.IsNullOrWhiteSpace(s.master.billno) || s.master.salescode > 0));
        }

        if (activeBilled != null && activeBilled.master != null)
        {
            hasPaidPharmacyBill = true;
            pharmacyBillNo = !string.IsNullOrWhiteSpace(activeBilled.master.billno) ? activeBilled.master.billno : activeBilled.master.salescode.ToString();
            pharmacySalesCode = activeBilled.master.salescode;
        }
        else
        {
            hasPaidPharmacyBill = false;
            pharmacyBillNo = "";
            pharmacySalesCode = 0;
        }

        // Update past visit sales if currently viewing a past visit
        if (selectedPastVisitCaseSheet != null)
        {
            pastVisitPharmacySales = FilterPastVisitPharmacySales(selectedPastVisitCaseSheet);
        }
    }

    private List<sales_request> FilterPastVisitPharmacySales(CaseSheetViewModel? pastVisit)
    {
        if (pastVisit == null || patientAllPharmacySales == null || !patientAllPharmacySales.Any())
            return new();

        var pvDate = pastVisit.visit_date?.Date;
        var pvOp = (pastVisit.op_id ?? "").Trim();
        var pvIp = (pastVisit.ip_id ?? "").Trim();
        var pvPr = pastVisit.prescription?.pr_code?.Trim() ?? "";
        var pvPrescItems = pastVisit.prescription?.items?
            .Where(i => !string.IsNullOrWhiteSpace(i.drug_name))
            .ToList() ?? new();

        var list = patientAllPharmacySales.Where(s =>
        {
            if (s.master == null) return false;

            // 1. Direct PR code match
            if (!string.IsNullOrEmpty(pvPr))
            {
                if (!string.IsNullOrWhiteSpace(s.master.remarks) && s.master.remarks.Contains(pvPr, StringComparison.OrdinalIgnoreCase)) return true;
                if (!string.IsNullOrWhiteSpace(s.master.invoiceno) && s.master.invoiceno.Contains(pvPr, StringComparison.OrdinalIgnoreCase)) return true;
                if (!string.IsNullOrWhiteSpace(s.master.billno) && s.master.billno.Contains(pvPr, StringComparison.OrdinalIgnoreCase)) return true;
            }

            // 2. OP / IP identifier match
            if (!string.IsNullOrEmpty(pvOp))
            {
                if (!string.IsNullOrWhiteSpace(s.master.patientid) && (string.Equals(s.master.patientid.Trim(), pvOp, StringComparison.OrdinalIgnoreCase) || s.master.patientid.Contains(pvOp, StringComparison.OrdinalIgnoreCase)))
                    return true;
                if (!string.IsNullOrWhiteSpace(s.master.remarks) && s.master.remarks.Contains(pvOp, StringComparison.OrdinalIgnoreCase))
                    return true;
                if (!string.IsNullOrWhiteSpace(s.master.invoiceno) && s.master.invoiceno.Contains(pvOp, StringComparison.OrdinalIgnoreCase))
                    return true;
                if (!string.IsNullOrWhiteSpace(s.master.billno) && s.master.billno.Contains(pvOp, StringComparison.OrdinalIgnoreCase))
                    return true;
            }

            if (!string.IsNullOrEmpty(pvIp))
            {
                if (!string.IsNullOrWhiteSpace(s.master.patientid) && (string.Equals(s.master.patientid.Trim(), pvIp, StringComparison.OrdinalIgnoreCase) || s.master.patientid.Contains(pvIp, StringComparison.OrdinalIgnoreCase)))
                    return true;
                if (!string.IsNullOrWhiteSpace(s.master.remarks) && s.master.remarks.Contains(pvIp, StringComparison.OrdinalIgnoreCase))
                    return true;
                if (!string.IsNullOrWhiteSpace(s.master.invoiceno) && s.master.invoiceno.Contains(pvIp, StringComparison.OrdinalIgnoreCase))
                    return true;
                if (!string.IsNullOrWhiteSpace(s.master.billno) && s.master.billno.Contains(pvIp, StringComparison.OrdinalIgnoreCase))
                    return true;
            }

            // 3. Exact visit date match
            if (pvDate.HasValue && s.master.billdate.Date == pvDate.Value)
            {
                return true;
            }

            // 4. Prescribed items matching detail line items on or near visit date
            if (pvPrescItems.Any() && s.details != null && s.details.Any())
            {
                var hasMatchingDrug = s.details.Any(d => pvPrescItems.Any(p =>
                    (p.drug_code.HasValue && p.drug_code.Value > 0 && d.itemcode == (long)p.drug_code.Value) ||
                    (!string.IsNullOrWhiteSpace(d.itemname) && !string.IsNullOrWhiteSpace(p.drug_name) &&
                     (string.Equals(d.itemname.Trim(), p.drug_name.Trim(), StringComparison.OrdinalIgnoreCase) ||
                      d.itemname.Contains(p.drug_name.Trim(), StringComparison.OrdinalIgnoreCase) ||
                      p.drug_name.Contains(d.itemname.Trim(), StringComparison.OrdinalIgnoreCase)))
                ));

                if (hasMatchingDrug)
                {
                    if (pvDate.HasValue && Math.Abs((s.master.billdate.Date - pvDate.Value).TotalDays) <= 7)
                    {
                        return true;
                    }
                    if (!pvDate.HasValue) return true;
                }
            }

            return false;
        })
        .OrderByDescending(s => s.master?.billdate)
        .ThenByDescending(s => s.master?.salescode)
        .ToList();

        // If no sales matched with strict filters, but pastVisit has prescription items and there is a sale containing those medicines:
        if (!list.Any() && pvPrescItems.Any())
        {
            var fallback = patientAllPharmacySales.Where(s =>
                s.details != null && s.details.Any(d => pvPrescItems.Any(p =>
                    (!string.IsNullOrWhiteSpace(d.itemname) && !string.IsNullOrWhiteSpace(p.drug_name) &&
                     (string.Equals(d.itemname.Trim(), p.drug_name.Trim(), StringComparison.OrdinalIgnoreCase) ||
                      d.itemname.Contains(p.drug_name.Trim(), StringComparison.OrdinalIgnoreCase) ||
                      p.drug_name.Contains(d.itemname.Trim(), StringComparison.OrdinalIgnoreCase)))
                ))
            ).ToList();
            if (fallback.Any()) list = fallback;
        }

        // If still no sales and this is the only past visit and only 1 sale exists, match it to past visit
        if (!list.Any() && patientAllPharmacySales.Count == 1)
        {
            list = new List<sales_request>(patientAllPharmacySales);
        }

        return list;
    }

    private List<sales_request> GetPharmacySalesForHistory(CaseSheetViewModel hist)
    {
        return FilterPastVisitPharmacySales(hist);
    }

    private async Task LoadPatientPharmacySalesAsync()
    {
        if (checkingPharmacyBill) return;
        try
        {
            checkingPharmacyBill = true;
            hasPaidPharmacyBill = false;
            pharmacyBillNo = "";
            pharmacySalesCode = 0;
            cachedPharmacyReportBase64 = "";

            var custStr = CustId > 0 ? CustId.ToString() : "";
            var patName = (PatientName ?? "").Trim();
            var opNoStr = (OpNo ?? "").Trim();
            var ipNoStr = (IpNo ?? "").Trim();
            var prCode = currentRequest.prescription?.pr_code?.Trim() ?? "";

            if (string.IsNullOrEmpty(custStr) && string.IsNullOrEmpty(patName) && string.IsNullOrEmpty(opNoStr) && string.IsNullOrEmpty(ipNoStr) && string.IsNullOrEmpty(prCode))
            {
                patientAllPharmacySales = new();
                currentVisitPharmacySales = new();
                pastVisitPharmacySales = new();
                return;
            }

            string sessionTenant = await GetCurrentTenantCodeAsync();
            string effectiveTenant = !string.IsNullOrEmpty(sessionTenant) ? sessionTenant : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");
            string userAuthToken = !string.IsNullOrEmpty(TenantState?.AuthToken) ? TenantState.AuthToken : "";

            var tenantCodesToTry = new List<string> { effectiveTenant, "0010", "0004", "" }.Distinct().ToList();

            List<sales_request> allFetchedRequests = new();

            foreach (var tCode in tenantCodesToTry)
            {
                try
                {
                    var client = ClientFactory.CreateClient("DoctorApi");
                    client.DefaultRequestHeaders.Remove("tenantcode");
                    client.DefaultRequestHeaders.Remove("tenant_code");
                    client.DefaultRequestHeaders.Remove("tenant-code");
                    if (!string.IsNullOrEmpty(tCode))
                    {
                        client.DefaultRequestHeaders.Add("tenantcode", tCode);
                        client.DefaultRequestHeaders.Add("tenant_code", tCode);
                        client.DefaultRequestHeaders.Add("tenant-code", tCode);
                    }
                    if (!string.IsNullOrEmpty(userAuthToken))
                    {
                        client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", userAuthToken);
                    }

                    var responseStr = await client.GetStringAsync("api/ItemMaster/getsales");
                    if (!string.IsNullOrWhiteSpace(responseStr))
                    {
                        var parsedList = ParseSalesRequestListJson(responseStr);
                        if (parsedList.Any())
                        {
                            foreach (var item in parsedList)
                            {
                                if (item.master != null && !allFetchedRequests.Any(s => s.master != null && s.master.salescode > 0 && s.master.salescode == item.master.salescode))
                                {
                                    allFetchedRequests.Add(item);
                                }
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[LoadPatientPharmacySales] getsales ({tCode}) notice: {ex.Message}");
                }
            }

            // Filter for matching patient using OP No, Name, Cust ID, or PR code
            var matchedSales = allFetchedRequests.Where(r => r.master != null && IsSaleMatchingPatient(r.master, custStr, patName, opNoStr, ipNoStr, prCode)).ToList();

            // Hydrate line items if details is empty
            foreach (var req in matchedSales)
            {
                if (req.details == null || !req.details.Any())
                {
                    await HydrateSalesDetailsAsync(req, effectiveTenant, userAuthToken);
                }
                else
                {
                    // Ensure item names are resolved
                    foreach (var d in req.details)
                    {
                        if (string.IsNullOrWhiteSpace(d.itemname) && d.itemcode > 0 && allItems.Any())
                        {
                            var match = allItems.FirstOrDefault(x => x.itemcode == (int)d.itemcode);
                            if (match != null) d.itemname = !string.IsNullOrWhiteSpace(match.drugname) ? match.drugname : match.itemname;
                        }
                    }
                }
            }

            patientAllPharmacySales = matchedSales.OrderByDescending(s => s.master?.billdate).ThenByDescending(s => s.master?.salescode).ToList();

            PartitionPharmacySales();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadPatientPharmacySales] Error: {ex.Message}");
        }
        finally
        {
            checkingPharmacyBill = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task CheckPharmacyBillStatusAsync() => LoadPatientPharmacySalesAsync();

    private async Task PreviewPharmacyBillReportAsync(string? rawBillNo = null)
    {
        try
        {
            loadingPharmacyReportPreview = true;
            StateHasChanged();

            var custStr = CustId > 0 ? CustId.ToString() : "";
            var patName = (PatientName ?? "").Trim();
            var opNoStr = (OpNo ?? "").Trim();
            var ipNoStr = (IpNo ?? "").Trim();
            var prCode = currentRequest.prescription?.pr_code?.Trim() ?? "";

            string sessionTenant = await GetCurrentTenantCodeAsync();
            string effectiveTenant = !string.IsNullOrEmpty(sessionTenant) ? sessionTenant : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");
            string userAuthToken = !string.IsNullOrEmpty(TenantState?.AuthToken) ? TenantState.AuthToken : "";

            // 1. If pharmacyBillNo is missing or not pre-loaded, dynamically fetch sales using same endpoint as Sales Master
            if (string.IsNullOrWhiteSpace(rawBillNo) && string.IsNullOrWhiteSpace(pharmacyBillNo))
            {
                await LoadPatientPharmacySalesAsync();
            }

            // 2. Identify candidate bill identifiers
            var billIds = new List<string>();
            if (!string.IsNullOrWhiteSpace(rawBillNo)) billIds.Add(rawBillNo.TrimStart('#').Trim());
            if (!string.IsNullOrWhiteSpace(pharmacyBillNo)) billIds.Add(pharmacyBillNo.TrimStart('#').Trim());
            if (pharmacySalesCode > 0) billIds.Add(pharmacySalesCode.ToString());

            // Check any matched sales in patientAllPharmacySales / currentVisitPharmacySales
            if (currentVisitPharmacySales != null)
            {
                foreach (var s in currentVisitPharmacySales)
                {
                    if (s.master != null)
                    {
                        if (!string.IsNullOrWhiteSpace(s.master.billno)) billIds.Add(s.master.billno.TrimStart('#').Trim());
                        if (s.master.salescode > 0) billIds.Add(s.master.salescode.ToString());
                        if (!string.IsNullOrWhiteSpace(s.master.invoiceno)) billIds.Add(s.master.invoiceno.TrimStart('#').Trim());
                        if (s.master.ordercode.HasValue) billIds.Add(s.master.ordercode.Value.ToString());
                    }
                }
            }
            if (patientAllPharmacySales != null)
            {
                foreach (var s in patientAllPharmacySales)
                {
                    if (s.master != null)
                    {
                        if (!string.IsNullOrWhiteSpace(s.master.billno)) billIds.Add(s.master.billno.TrimStart('#').Trim());
                        if (s.master.salescode > 0) billIds.Add(s.master.salescode.ToString());
                    }
                }
            }
            if (!string.IsNullOrEmpty(opNoStr)) billIds.Add(opNoStr);

            billIds = billIds.Where(b => !string.IsNullOrWhiteSpace(b)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();

            if (!billIds.Any())
            {
                ToastService.ShowError("No pharmacy bill found for this patient / OP No.");
                return;
            }

            // 3. If cached report is available, open it directly
            if (!string.IsNullOrEmpty(cachedPharmacyReportBase64))
            {
                string cachedTitle = $"Pharmacy Bill - {(billIds.FirstOrDefault() ?? "Report")} ({(string.IsNullOrWhiteSpace(patName) ? "Patient" : patName)})";
                await JSRuntime.InvokeVoidAsync("openPdfPreviewModal", cachedPharmacyReportBase64, cachedTitle);
                ToastService.ShowSuccess("Pharmacy bill report loaded successfully.");
                return;
            }

            // 4. Build candidate endpoint URLs for all bill identifiers (same logic as Sales Master)
            string? apiBase = Configuration["ApiBaseUrl"]?.TrimEnd('/');
            var candidateUrls = new List<string>();

            foreach (var bId in billIds)
            {
                var cleanId = bId.TrimStart('#').Trim();
                var escapedId = Uri.EscapeDataString(cleanId);

                var idVariants = new List<string> { cleanId };
                if (escapedId != cleanId) idVariants.Add(escapedId);

                foreach (var id in idVariants)
                {
                    if (!string.IsNullOrEmpty(apiBase))
                    {
                        candidateUrls.Add($"{apiBase}/api/report/getpharmacybill?billNo={id}&orientation=landscape&tenantcode={effectiveTenant}&tenant_code={effectiveTenant}");
                        candidateUrls.Add($"{apiBase}/api/report/getpharmacybill?billNo={id}&orientation=landscape");
                        candidateUrls.Add($"{apiBase}/api/Report/getpharmacybill?billNo={id}&orientation=landscape&tenantcode={effectiveTenant}&tenant_code={effectiveTenant}");
                        candidateUrls.Add($"{apiBase}/api/Report/GetPharmacyBill?billNo={id}&orientation=landscape");
                        candidateUrls.Add($"{apiBase}/api/report/getpharmacybill?billno={id}&orientation=landscape");
                        candidateUrls.Add($"{apiBase}/api/report/getpharmacybill?billNo={id}&orientation=portrait");
                        candidateUrls.Add($"{apiBase}/api/report/getpharmacybill?billNo={id}");
                    }
                    candidateUrls.Add($"api/report/getpharmacybill?billNo={id}&orientation=landscape&tenantcode={effectiveTenant}&tenant_code={effectiveTenant}");
                    candidateUrls.Add($"api/report/getpharmacybill?billNo={id}&orientation=landscape");
                    candidateUrls.Add($"api/Report/getpharmacybill?billNo={id}&orientation=landscape&tenantcode={effectiveTenant}&tenant_code={effectiveTenant}");
                    candidateUrls.Add($"api/Report/GetPharmacyBill?billNo={id}&orientation=landscape");
                    candidateUrls.Add($"api/report/getpharmacybill?billno={id}&orientation=landscape");
                    candidateUrls.Add($"api/report/getpharmacybill?billNo={id}&orientation=portrait");
                    candidateUrls.Add($"api/report/getpharmacybill?billNo={id}");
                }
            }

            var client = ClientFactory.CreateClient("DoctorApi");
            string lastError = "";

            foreach (var url in candidateUrls)
            {
                try
                {
                    var req = new HttpRequestMessage(HttpMethod.Get, url);
                    if (!string.IsNullOrEmpty(userAuthToken))
                    {
                        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", userAuthToken);
                    }
                    req.Headers.Add("tenantcode", effectiveTenant);
                    req.Headers.Add("tenant_code", effectiveTenant);
                    req.Headers.Add("tenant-code", effectiveTenant);

                    var response = await client.SendAsync(req);
                    if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
                    {
                        var contentStr = await response.Content.ReadAsStringAsync();
                        contentStr = contentStr.Trim('"').Trim();

                        string base64Data = contentStr;
                        try
                        {
                            using var doc = System.Text.Json.JsonDocument.Parse(contentStr);
                            var root = doc.RootElement;
                            if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                            {
                                foreach (var propName in new[] { "data", "base64", "file", "report", "result", "pdf", "pdfData", "pdfBase64", "Data", "Base64", "File", "Report", "Result", "Pdf" })
                                {
                                    if (root.TryGetProperty(propName, out var p) && p.ValueKind == System.Text.Json.JsonValueKind.String)
                                    {
                                        var val = p.GetString();
                                        if (!string.IsNullOrWhiteSpace(val))
                                        {
                                            base64Data = val;
                                            break;
                                        }
                                    }
                                }
                            }
                            else if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                            {
                                base64Data = root.GetString() ?? contentStr;
                            }
                        }
                        catch { }

                        if (base64Data.StartsWith("data:application/pdf;base64,", StringComparison.OrdinalIgnoreCase))
                        {
                            base64Data = base64Data.Substring("data:application/pdf;base64,".Length);
                        }

                        base64Data = base64Data.Trim().Replace(" ", "").Replace("\r", "").Replace("\n", "");

                        if (!string.IsNullOrWhiteSpace(base64Data) && base64Data.Length >= 50)
                        {
                            cachedPharmacyReportBase64 = base64Data;
                            var displayBill = billIds.FirstOrDefault() ?? "Bill";
                            string modalTitle = $"Pharmacy Bill - {displayBill} ({(string.IsNullOrWhiteSpace(patName) ? "Patient" : patName)})";
                            await JSRuntime.InvokeVoidAsync("openPdfPreviewModal", base64Data, modalTitle);
                            ToastService.ShowSuccess("Pharmacy bill report loaded successfully.");
                            return;
                        }
                    }
                    else
                    {
                        var errContent = await response.Content.ReadAsStringAsync();
                        lastError = $"HTTP {(int)response.StatusCode} ({response.ReasonPhrase}): {errContent}";
                    }
                }
                catch (Exception ex)
                {
                    lastError = ex.Message;
                }
            }

            ToastService.ShowError($"Unable to load pharmacy bill preview: {(string.IsNullOrEmpty(lastError) ? "Report data not available from server" : lastError)}");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading pharmacy bill report: {ex.Message}");
        }
        finally
        {
            loadingPharmacyReportPreview = false;
            StateHasChanged();
        }
    }

    private async Task PreviewPrescriptionReportAsync(string? targetPrId = null)
    {
        if (loadingPrescriptionReportPreview) return;
        try
        {
            loadingPrescriptionReportPreview = true;
            previewingPrId = targetPrId;
            StateHasChanged();

            // 1. Identify pr_id from parameter, activePrescription, or currentRequest, or prescriptionsList
            string? prId = !string.IsNullOrWhiteSpace(targetPrId) ? targetPrId : activePrescription?.pr_id;

            // If current prescription is unsaved or new, but has items, auto-save first so pr_id exists in DB
            if (string.IsNullOrEmpty(prId) || !isEditingPrescription)
            {
                if (currentRequest.prescription?.items != null && currentRequest.prescription.items.Any(i => !string.IsNullOrWhiteSpace(i.drug_name)))
                {
                    await SubmitTabPrescriptionAsync();
                    prId = activePrescription?.pr_id;
                }
            }

            if (string.IsNullOrEmpty(prId))
            {
                prId = currentRequest.prescription?.pr_id ?? currentRequest.prescription?.pr_code ?? prescriptionsList.LastOrDefault(p => !string.IsNullOrEmpty(p.pr_id))?.pr_id;
            }

            if (string.IsNullOrEmpty(prId))
            {
                ToastService.ShowWarning("Please select or save a prescription first before previewing.");
                return;
            }

            var patName = (PatientName ?? "").Trim();
            string modalTitle = $"Case Sheet Prescription - {(string.IsNullOrWhiteSpace(patName) ? "Report" : patName)}";

            // 2. If cached report is available for this prescription, open it directly
            string cacheKey = prId.Trim().ToLowerInvariant();
            if (cachedPrescriptionReports.TryGetValue(cacheKey, out var cachedData) && !string.IsNullOrEmpty(cachedData))
            {
                await JSRuntime.InvokeVoidAsync("openPdfPreviewModal", cachedData, modalTitle);
                ToastService.ShowSuccess("Prescription report loaded successfully.");
                return;
            }

            // 3. Resolve ApiBaseUrl from appsettings.json
            string? apiBase = Configuration["ApiBaseUrl"]?.TrimEnd('/');
            if (string.IsNullOrEmpty(apiBase))
            {
                apiBase = Configuration["ApiSettings:MedicoApiUrl"]?.TrimEnd('/');
            }

            string sessionTenant = await GetCurrentTenantCodeAsync();
            string effectiveTenant = !string.IsNullOrEmpty(sessionTenant) ? sessionTenant : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");
            string userAuthToken = !string.IsNullOrEmpty(TenantState?.AuthToken) ? TenantState.AuthToken : "";

            var candidateUrls = new List<string>();
            var cleanPrId = Uri.EscapeDataString(prId.Trim());

            // Build candidate endpoint URLs as instructed:
            // api/report/getdoctorprescription?pr_id={pr_id}&format=pdf
            if (!string.IsNullOrEmpty(apiBase))
            {
                candidateUrls.Add($"{apiBase}/api/report/getdoctorprescription?pr_id={cleanPrId}&format=pdf");
                candidateUrls.Add($"{apiBase}/api/report/getdoctorprescription?pr_code={cleanPrId}&format=pdf");
                candidateUrls.Add($"{apiBase}/api/report/getdoctorprescription?pr_id={cleanPrId}&format=pdf&tenantcode={effectiveTenant}&tenant_code={effectiveTenant}");
                candidateUrls.Add($"{apiBase}/api/Report/getdoctorprescription?pr_id={cleanPrId}&format=pdf");
                candidateUrls.Add($"{apiBase}/api/Report/GetDoctorPrescription?pr_id={cleanPrId}&format=pdf");
            }
            candidateUrls.Add($"api/report/getdoctorprescription?pr_id={cleanPrId}&format=pdf");
            candidateUrls.Add($"api/report/getdoctorprescription?pr_code={cleanPrId}&format=pdf");
            candidateUrls.Add($"api/report/getdoctorprescription?pr_id={cleanPrId}&format=pdf&tenantcode={effectiveTenant}&tenant_code={effectiveTenant}");
            candidateUrls.Add($"api/Report/getdoctorprescription?pr_id={cleanPrId}&format=pdf");
            candidateUrls.Add($"api/Report/GetDoctorPrescription?pr_id={cleanPrId}&format=pdf");

            var client = ClientFactory.CreateClient("DoctorApi");
            string lastError = "";

            foreach (var url in candidateUrls)
            {
                try
                {
                    var req = new HttpRequestMessage(HttpMethod.Get, url);
                    if (!string.IsNullOrEmpty(userAuthToken))
                    {
                        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", userAuthToken);
                    }
                    if (!string.IsNullOrEmpty(effectiveTenant))
                    {
                        req.Headers.Add("tenantcode", effectiveTenant);
                        req.Headers.Add("tenant_code", effectiveTenant);
                        req.Headers.Add("tenant-code", effectiveTenant);
                    }

                    var response = await client.SendAsync(req);
                    if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
                    {
                        string base64Data = "";
                        var contentType = response.Content.Headers.ContentType?.MediaType ?? "";

                        if (contentType.Contains("pdf", StringComparison.OrdinalIgnoreCase) || contentType.Contains("octet-stream", StringComparison.OrdinalIgnoreCase))
                        {
                            var bytes = await response.Content.ReadAsByteArrayAsync();
                            if (bytes != null && bytes.Length > 0)
                            {
                                if (bytes.Length > 4 && bytes[0] == 0x25 && bytes[1] == 0x50 && bytes[2] == 0x44 && bytes[3] == 0x46)
                                {
                                    base64Data = Convert.ToBase64String(bytes);
                                }
                                else
                                {
                                    var text = System.Text.Encoding.UTF8.GetString(bytes).Trim().Trim('"');
                                    base64Data = text;
                                }
                            }
                        }

                        if (string.IsNullOrEmpty(base64Data))
                        {
                            var contentStr = await response.Content.ReadAsStringAsync();
                            contentStr = contentStr.Trim('"').Trim();

                            base64Data = contentStr;
                            try
                            {
                                using var doc = System.Text.Json.JsonDocument.Parse(contentStr);
                                var root = doc.RootElement;
                                if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                                {
                                    foreach (var propName in new[] { "data", "base64", "file", "report", "result", "pdf", "pdfData", "pdfBase64", "Data", "Base64", "File", "Report", "Result", "Pdf" })
                                    {
                                        if (root.TryGetProperty(propName, out var p) && p.ValueKind == System.Text.Json.JsonValueKind.String)
                                        {
                                            var val = p.GetString();
                                            if (!string.IsNullOrWhiteSpace(val))
                                            {
                                                base64Data = val;
                                                break;
                                            }
                                        }
                                    }
                                }
                                else if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                                {
                                    base64Data = root.GetString() ?? contentStr;
                                }
                            }
                            catch { }
                        }

                        if (base64Data.StartsWith("data:application/pdf;base64,", StringComparison.OrdinalIgnoreCase))
                        {
                            base64Data = base64Data.Substring("data:application/pdf;base64,".Length);
                        }

                        base64Data = base64Data.Trim().Replace(" ", "").Replace("\r", "").Replace("\n", "");

                        if (!string.IsNullOrWhiteSpace(base64Data) && base64Data.Length >= 50)
                        {
                            cachedPrescriptionReports[cacheKey] = base64Data;
                            cachedPrescriptionReportBase64 = base64Data;
                            await JSRuntime.InvokeVoidAsync("openPdfPreviewModal", base64Data, modalTitle);
                            ToastService.ShowSuccess("Prescription report loaded successfully.");
                            return;
                        }
                    }
                    else
                    {
                        var errContent = await response.Content.ReadAsStringAsync();
                        lastError = $"HTTP {(int)response.StatusCode} ({response.ReasonPhrase}): {errContent}";
                    }
                }
                catch (Exception ex)
                {
                    lastError = ex.Message;
                }
            }

            ToastService.ShowError($"Unable to load prescription report: {(string.IsNullOrEmpty(lastError) ? "Report data not available from server" : lastError)}");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading prescription report: {ex.Message}");
        }
        finally
        {
            loadingPrescriptionReportPreview = false;
            previewingPrId = null;
            StateHasChanged();
        }
    }
}


