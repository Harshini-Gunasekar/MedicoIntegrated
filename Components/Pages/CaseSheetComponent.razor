    // --- Save Actions ---
    private void PrepareRequest()
    {
        // Bind remark caches into currentRequest
        if (currentRequest.prescription != null)
        {
            if (string.IsNullOrEmpty(currentRequest.prescription.pr_id))
            {
                currentRequest.prescription.pr_id = activePrescription?.pr_id;
            }
            currentRequest.prescription.topremarks = prescriptionRemarks.topremarks;
            currentRequest.prescription.bottonremarks = prescriptionRemarks.bottonremarks;

            if (currentRequest.prescription.items != null)
            {
                currentRequest.prescription.items = currentRequest.prescription.items
                    .Where(i => !string.IsNullOrWhiteSpace(i.drug_name))
                    .ToList();

                for (int i = 0; i < currentRequest.prescription.items.Count; i++)
                {
                    var item = currentRequest.prescription.items[i];
                    item.sno = i + 1;
                    if (!item.rate.HasValue || item.rate.Value == 0)
                    {
                        item.rate = GetItemUnitPrice(item);
                    }
                }
            }
        }

        if (activePrescription != null && currentRequest.prescription?.items != null)
        {
            activePrescription.topremarks = currentRequest.prescription.topremarks;
            activePrescription.bottonremarks = currentRequest.prescription.bottonremarks;
            activePrescription.items = currentRequest.prescription.items.Select(it => new OpPrescriptionDetailModel
            {
                sno = it.sno,
                drug_name = it.drug_name,
                drug_code = it.drug_code,
                generic_name = it.generic_name,
                drug_category = it.drug_category,
                morning = it.morning,
                afternoon = it.afternoon,
                evening = it.evening,
                night = it.night,
                morning_dose = it.morning_dose,
                afternoon_dose = it.afternoon_dose,
                evening_dose = it.evening_dose,
                night_dose = it.night_dose,
                dose_unit = it.dose_unit,
                before_food = it.before_food,
                after_food = it.after_food,
                days = it.days,
                qty = it.qty,
                rate = it.rate,
                mrp = it.mrp,
                notes = it.notes
            }).ToList();
        }

        if (prescriptionsList != null && prescriptionsList.Any())
        {
            currentRequest.prescription_list = prescriptionsList.Select(p => new CaseSheetPrescriptionRequest
            {
                pr_id = p.pr_id,
                pr_code = p.pr_code,
                topremarks = p.topremarks,
                bottonremarks = p.bottonremarks,
                items = p.items != null ? p.items.Where(i => !string.IsNullOrWhiteSpace(i.drug_name)).Select((it, idx) => new CaseSheetPrescriptionItem
                {
                    sno = idx + 1,
                    drug_name = it.drug_name,
                    drug_code = it.drug_code,
                    generic_name = it.generic_name,
                    drug_category = it.drug_category,
                    morning = it.morning,
                    afternoon = it.afternoon,
                    evening = it.evening,
                    night = it.night,
                    morning_dose = it.morning_dose,
                    afternoon_dose = it.afternoon_dose,
                    evening_dose = it.evening_dose,
                    night_dose = it.night_dose,
                    dose_unit = it.dose_unit,
                    before_food = it.before_food,
                    after_food = it.after_food,
                    days = it.days,
                    qty = it.qty,
                    rate = it.rate,
                    mrp = it.mrp,
                    notes = it.notes
                }).ToList() : new List<CaseSheetPrescriptionItem>()
            }).ToList();
        }

        if (currentRequest.diagnosis_list != null)
        {
            currentRequest.diagnosis_list = currentRequest.diagnosis_list
                .Where(d => !string.IsNullOrWhiteSpace(d.icd_code))
                .ToList();

            for (int i = 0; i < currentRequest.diagnosis_list.Count; i++)
            {
                currentRequest.diagnosis_list[i].sno = i + 1;
            }
        }

        if (currentRequest.investigation != null)
        {
            currentRequest.investigation.notes = investigationNotes;
            currentRequest.investigation.is_urgent = investigationMasterUrgent;

            if (currentRequest.investigation.tests != null)
            {
                currentRequest.investigation.tests = currentRequest.investigation.tests
                    .Where(t => !string.IsNullOrWhiteSpace(t.test_name))
                    .ToList();

                for (int i = 0; i < currentRequest.investigation.tests.Count; i++)
                {
                    var test = currentRequest.investigation.tests[i];
                    test.sno = i + 1;

                    if (test.quantity <= 0) test.quantity = 1;
                    test.amount = (test.rate ?? 0) * test.quantity;
                }
            }
        }
    }

    private bool HasVitalsData(OPRegistrationModel.PatientVitalsModel? v)
    {
        if (v == null) return false;
        return (v.height_cm.HasValue && v.height_cm > 0) || 
               (v.weight_kg.HasValue && v.weight_kg > 0) ||
               (v.bp_systolic.HasValue && v.bp_systolic > 0) ||
               (v.bp_diastolic.HasValue && v.bp_diastolic > 0) ||
               (v.pulse_rate.HasValue && v.pulse_rate > 0) ||
               (v.temperature_f.HasValue && v.temperature_f > 0) ||
               (v.spo2.HasValue && v.spo2 > 0) ||
               (v.sugar_level.HasValue && v.sugar_level > 0) ||
               (v.pain_scale.HasValue && v.pain_scale > 0) ||
               (v.respiratory_rate.HasValue && v.respiratory_rate > 0) ||
               (v.hba1c.HasValue && v.hba1c > 0) ||
               (v.waist_cm.HasValue && v.waist_cm > 0) ||
               (v.hip_cm.HasValue && v.hip_cm > 0) ||
               (v.head_circumference_cm.HasValue && v.head_circumference_cm > 0) ||
               !string.IsNullOrWhiteSpace(v.allergy_notes) ||
               !string.IsNullOrWhiteSpace(v.pedal_oedema) ||
               !string.IsNullOrWhiteSpace(v.jvp) ||
               !string.IsNullOrWhiteSpace(v.cvs) ||
               !string.IsNullOrWhiteSpace(v.rs) ||
               !string.IsNullOrWhiteSpace(v.cns) ||
               !string.IsNullOrWhiteSpace(v.abdomen) ||
               !string.IsNullOrWhiteSpace(v.cardiac_monitor) ||
               !string.IsNullOrWhiteSpace(v.cd_echo) ||
               !string.IsNullOrWhiteSpace(v.blood_chemistry) ||
               !string.IsNullOrWhiteSpace(v.ecg_notes);
    }

    private async Task<bool> SaveDraftAsyncInternal()
    {
        PrepareRequest();
        currentRequest.sheet_status = "DRAFT";

        savingData = true;
        StateHasChanged();

        if (activeVitals != null && !isReadOnly && (isEditingVitals || HasVitalsData(activeVitals)))
        {
            try
            {
                if (isEditingVitals)
                {
                    await AppointmentBookingService.UpdateOpVitalsAsync(activeVitals);
                }
                else
                {
                    await AppointmentBookingService.SaveOpVitalsAsync(activeVitals);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error auto-saving vitals: {ex.Message}");
            }
        }

        // Ensure visit registration context is correctly passed (OP vs IP)
        if (OpId != Guid.Empty)
        {
            currentRequest.op_id = OpId.ToString();
            if (!IpId.HasValue || IpId.Value == Guid.Empty)
            {
                currentRequest.ip_id = null;
            }
        }
        else if (IpId.HasValue && IpId.Value != Guid.Empty)
        {
            currentRequest.ip_id = IpId.Value.ToString();
            if (string.IsNullOrEmpty(currentRequest.op_id))
            {
                currentRequest.op_id = null;
            }
        }

        // If prescription items were completely cleared but an existing prescription pr_code exists, delete it from backend database
        if (currentRequest.prescription != null && 
            (currentRequest.prescription.items == null || !currentRequest.prescription.items.Any(i => !string.IsNullOrWhiteSpace(i.drug_name))) &&
            !string.IsNullOrEmpty(currentRequest.prescription.pr_code))
        {
            var prCodeToDelete = currentRequest.prescription.pr_code;
            try
            {
                await CaseSheetService.DeletePrescriptionAsync(
                    prCodeToDelete, 
                    OpId != Guid.Empty ? OpId : null, 
                    IpId.HasValue && IpId.Value != Guid.Empty ? IpId.Value : null
                );
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SaveDraftAsyncInternal] Error deleting empty prescription {prCodeToDelete}: {ex.Message}");
            }
            currentRequest.prescription.pr_code = null;
            if (rawLoadedSheet != null)
            {
                rawLoadedSheet.prescription = null;
            }
            hasPaidPharmacyBill = false;
            pharmacyBillNo = "";
            pharmacySalesCode = 0;
        }

        // If prescription has no items and no remarks, nullify it in payload so backend does not retain/recreate empty prescription
        if (currentRequest.prescription != null && 
            (currentRequest.prescription.items == null || !currentRequest.prescription.items.Any(i => !string.IsNullOrWhiteSpace(i.drug_name))) &&
            string.IsNullOrWhiteSpace(currentRequest.prescription.topremarks) && 
            string.IsNullOrWhiteSpace(currentRequest.prescription.bottonremarks))
        {
            currentRequest.prescription = null;
        }

        // If investigation tests were completely cleared but an existing inv_id exists, delete it from backend database
        if (currentRequest.investigation != null &&
            (currentRequest.investigation.tests == null || !currentRequest.investigation.tests.Any(t => !string.IsNullOrWhiteSpace(t.test_name))) &&
            !string.IsNullOrEmpty(currentRequest.investigation.inv_id) &&
            Guid.TryParse(currentRequest.investigation.inv_id, out var invGuidToDelete))
        {
            try
            {
                await CaseSheetService.DeleteInvestigationAsync(invGuidToDelete);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SaveDraftAsyncInternal] Error deleting empty investigation {invGuidToDelete}: {ex.Message}");
            }
            currentRequest.investigation.inv_id = null;
            if (rawLoadedSheet != null)
            {
                rawLoadedSheet.investigation = null;
            }
        }

        if (currentRequest.investigation != null &&
            (currentRequest.investigation.tests == null || !currentRequest.investigation.tests.Any(t => !string.IsNullOrWhiteSpace(t.test_name))) &&
            string.IsNullOrWhiteSpace(currentRequest.investigation.notes))
        {
            currentRequest.investigation = null;
        }

        var response = await CaseSheetService.SaveCaseSheetAsync(currentRequest);

        if (response.StartsWith("Error"))
        {
            savingData = false;
            ToastService.ShowError(response);
            return false;
        }

        // 2nd reload: fetch the final state from DB with results populated
        var finalReload = await CaseSheetService.GetCaseSheetByVisitAsync(OpId, IpId);
        rawLoadedSheet = finalReload;
        if (finalReload != null)
        {
            LoadFromViewModel(finalReload);
        }
        else
        {
            if (currentRequest.prescription == null)
            {
                currentRequest.prescription = new CaseSheetPrescriptionRequest();
            }
            if (currentRequest.investigation == null)
            {
                currentRequest.investigation = new CaseSheetInvestigationRequest();
            }
        }

        try
        {
            vitalsList = await AppointmentBookingService.GetOpVitalsAsync(OpId);
            if (vitalsList != null && vitalsList.Any())
            {
                activeVitals = vitalsList.OrderByDescending(v => v.created_at).First();
                isEditingVitals = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reloading vitals list: {ex.Message}");
        }

        var targetOpId = OpId != Guid.Empty ? OpId : (Guid.TryParse(currentRequest.op_id, out var g1) ? g1 : (Guid.TryParse(rawLoadedSheet?.op_id, out var g2) ? g2 : Guid.Empty));
        if (targetOpId != Guid.Empty)
        {
            try
            {
                await AppointmentBookingService.UpdateOpStatusAsync(targetOpId, "IN_CONSULTATION");
                var allOps = await AppointmentBookingService.GetAllOpRegistrationsAsync();
                var matchOp = allOps.FirstOrDefault(x => x.op_id == targetOpId);
                if (matchOp != null && matchOp.booking_id.HasValue && matchOp.booking_id.Value != Guid.Empty)
                {
                    await AppointmentBookingService.UpdateStatusAsync(matchOp.booking_id.Value, "IN_CONSULTATION");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error updating status to IN_CONSULTATION: {ex.Message}");
            }
        }

        savingData = false;
        _ = LoadUnbilledChargesAsync();
        ToastService.ShowSuccess("Draft case sheet saved successfully.");
        await OnSaved.InvokeAsync();
        return true;
    }

