    private async Task SubmitTabPrescriptionAsync()
    {
        if (currentRequest.prescription == null || 
            currentRequest.prescription.items == null || 
            !currentRequest.prescription.items.Any(i => !string.IsNullOrWhiteSpace(i.drug_name)))
        {
            ToastService.ShowWarning("Please enter at least one medicine before saving prescription.");
            return;
        }

        savingPrescription = true;
        try
        {
            PrepareRequest();
            currentRequest.sheet_status = "DRAFT";

            var response = await CaseSheetService.SaveCaseSheetAsync(currentRequest);
            if (response.StartsWith("Error"))
            {
                ToastService.ShowError(response);
                return;
            }

            var finalReload = await CaseSheetService.GetCaseSheetByVisitAsync(OpId, IpId);
            rawLoadedSheet = finalReload;
            if (finalReload != null && finalReload.prescription != null && 
                (!string.IsNullOrEmpty(finalReload.prescription.pr_code) || 
                 (finalReload.prescription.items != null && finalReload.prescription.items.Any(i => !string.IsNullOrWhiteSpace(i.drug_name)))))
            {
                var savedVm = finalReload.prescription;
                var existingIdx = prescriptionsList.FindIndex(p => 
                    (!string.IsNullOrEmpty(p.pr_code) && p.pr_code == savedVm.pr_code) ||
                    (!string.IsNullOrEmpty(p.pr_id) && p.pr_id == savedVm.pr_id));
                if (existingIdx >= 0)
                {
                    prescriptionsList[existingIdx] = savedVm;
                }
                else
                {
                    prescriptionsList.Add(savedVm);
                }
                SelectPrescriptionEntry(savedVm);
            }

            ToastService.ShowSuccess("Prescription saved successfully!");
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving prescription: {ex.Message}");
        }
        finally
        {
            savingPrescription = false;
        }
    }

