    {
        item.test_name = res.name ?? "";
        item.test_code = (int)res.tcode;
        item.rate = (decimal)res.amount;
        item.quantity = item.quantity > 0 ? item.quantity : 1;
        item.amount = (decimal)res.amount * item.quantity;

        inlineTestSearchResults.Clear();
        activeInlineTestSno = 0;
    }

    private void CalculateTestAmount(CaseSheetInvestigationItem test)
    {
        if (test.quantity <= 0) test.quantity = 1;
        test.amount = (test.rate ?? 0) * test.quantity;
    }

