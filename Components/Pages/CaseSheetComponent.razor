    private item_master? GetItemMaster(CaseSheetPrescriptionItem? item)
    {
        if (item == null) return null;
        if (item.drug_code.HasValue && item.drug_code.Value > 0)
        {
            long codeLong = (long)item.drug_code.Value;
            var master = allItems.FirstOrDefault(x => x.itemcode == codeLong);
            if (master != null) return master;
        }
        if (!string.IsNullOrWhiteSpace(item.drug_name))
        {
            var clean = item.drug_name.Trim();
            var master = allItems.FirstOrDefault(x => !x.deleted && (
                (!string.IsNullOrWhiteSpace(x.drugname) && x.drugname.Trim().Equals(clean, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.itemname) && x.itemname.Trim().Equals(clean, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.shortname) && x.shortname.Trim().Equals(clean, StringComparison.OrdinalIgnoreCase))));
            if (master != null) return master;

            master = allItems.FirstOrDefault(x => !x.deleted && (
                (!string.IsNullOrWhiteSpace(x.drugname) && x.drugname.Trim().StartsWith(clean, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.itemname) && x.itemname.Trim().StartsWith(clean, StringComparison.OrdinalIgnoreCase))));
            if (master != null) return master;

            if (clean.Length >= 3)
            {
                master = allItems.FirstOrDefault(x => !x.deleted && (
                    (!string.IsNullOrWhiteSpace(x.drugname) && (x.drugname.Contains(clean, StringComparison.OrdinalIgnoreCase) || clean.Contains(x.drugname.Trim(), StringComparison.OrdinalIgnoreCase))) ||
                    (!string.IsNullOrWhiteSpace(x.itemname) && (x.itemname.Contains(clean, StringComparison.OrdinalIgnoreCase) || clean.Contains(x.itemname.Trim(), StringComparison.OrdinalIgnoreCase)))));
                if (master != null) return master;
            }
        }
        return null;
    }

    private decimal ParseDosageValue(string? val, string? fallbackFlag = null)
    {
        if (!string.IsNullOrWhiteSpace(val))
        {
            string v = val.Trim();
            if (v == "1/2" || v == "½") return 0.5m;
            if (v == "1/4" || v == "¼") return 0.25m;
            if (v == "3/4" || v == "¾") return 0.75m;
            if (v == "1 1/2" || v == "1.5") return 1.5m;
            if (decimal.TryParse(v, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
            {
                return parsed;
            }
        }
        if (fallbackFlag == "1") return 1m;
        return 0m;
    }

    private void CalculateItemDrugQty(CaseSheetPrescriptionItem item)
    {
        if (item == null) return;

        if (IsTabletOrCapsuleItem(item))
        {
            // If the category is Tablet or Capsule:
            // Calculate quantity based on dosage: (Morning + Afternoon + Evening + Night) * Days
            decimal dailyCount = 0;
            dailyCount += ParseDosageValue(item.morning_dose, item.morning);
            dailyCount += ParseDosageValue(item.afternoon_dose, item.afternoon);
            dailyCount += ParseDosageValue(item.evening_dose, item.evening);
            dailyCount += ParseDosageValue(item.night_dose, item.night);

            if (dailyCount > 0)
            {
                var days = (item.days.HasValue && item.days.Value > 0) ? item.days.Value : 1;
                item.qty = Math.Ceiling(dailyCount * days);
            }
            else if (!item.qty.HasValue || item.qty.Value <= 0)
            {
                item.qty = 1;
            }
        }
        else
        {
            // When category is NOT tablet or capsule (e.g. Syrup, Injection, Ointment, Drops):
            // Default qty to 1 (or keep user entered qty) without multiplying by dosage or days
            if (!item.qty.HasValue || item.qty.Value <= 0)
            {
                item.qty = 1;
            }
        }
    }

    private void ToggleItemDosage(CaseSheetPrescriptionItem item, string period)
    {
        if (period == "morning")
        {
            bool isOn = item.morning == "1" || (decimal.TryParse(item.morning_dose, out var v) && v > 0);
            item.morning = isOn ? "0" : "1";
            item.morning_dose = isOn ? "0" : "1";
        }
        else if (period == "afternoon")
        {
            bool isOn = item.afternoon == "1" || (decimal.TryParse(item.afternoon_dose, out var v) && v > 0);
            item.afternoon = isOn ? "0" : "1";
            item.afternoon_dose = isOn ? "0" : "1";
        }
        else if (period == "evening")
        {
            bool isOn = item.evening == "1" || (decimal.TryParse(item.evening_dose, out var v) && v > 0);
            item.evening = isOn ? "0" : "1";
            item.evening_dose = isOn ? "0" : "1";
        }
        else if (period == "night")
        {
            bool isOn = item.night == "1" || (decimal.TryParse(item.night_dose, out var v) && v > 0);
            item.night = isOn ? "0" : "1";
            item.night_dose = isOn ? "0" : "1";
        }

        CalculateItemDrugQty(item);
    }

