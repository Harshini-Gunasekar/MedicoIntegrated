@using Booking.Models
@using Booking.Services
@inject CaseSheetService CaseSheetService
@inject AppointmentBookingService AppointmentBookingService
@inject ToastService ToastService

@if (Visible)
{
    <div class="casesheet-backdrop" @onclick="CloseModal">
        <div class="casesheet-modal" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div class="casesheet-header">
                <div class="header-patient-info">
                    <div class="patient-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="patient-meta">
                        <h2 class="patient-title">
                            @(string.IsNullOrWhiteSpace(PatientName) ? "Walk-in Patient" : PatientName)
                            <span class="patient-id-badge">CUST-@CustId</span>
                            @if (!string.IsNullOrEmpty(currentRequest.sheet_id))
                            {
                                <span class="status-badge @(currentRequest.sheet_status?.ToLower())">
                                    @currentRequest.sheet_status
                                </span>
                            }
                            else
                            {
                                <span class="status-badge draft">NEW CASE SHEET</span>
                            }
                        </h2>
                        <span class="patient-sub">
                            Visit Date: @(VisitDate?.ToString("dd-MMM-yyyy") ?? DateTime.Today.ToString("dd-MMM-yyyy"))
                            @if (!string.IsNullOrEmpty(OpNo))
                            {
                                <span> | OP No: @OpNo</span>
                            }
                        </span>
                    </div>
                </div>

                <div class="header-actions">
                    <button class="btn-close-modal" @onclick="CloseModal">×</button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="casesheet-body">
                @if (loadingData)
                {
                    <div style="flex: 1; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                        <span class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem; margin-bottom: 1rem;"></span>
                        <h4 style="color: var(--primary-color); font-weight: 700;">Loading Clinical Workspace...</h4>
                    </div>
                }
                else
                {
                    <!-- Workspace Left (Clinical Entries) -->
                    <div class="workspace-left">
                        <!-- Tab Navigation -->
                        <div class="tabs-container">
                            <button class="tab-btn @(activeTab == "notes" ? "active" : "")" @onclick='() => SetTab("notes")'>
                                <i class="bi bi-file-earmark-medical"></i> Clinical Notes
                            </button>
                            <button class="tab-btn @(activeTab == "symptoms" ? "active" : "")" @onclick='() => SetTab("symptoms")'>
                                <i class="bi bi-activity"></i> Symptoms
                            </button>
                            <button class="tab-btn @(activeTab == "diagnosis" ? "active" : "")" @onclick='() => SetTab("diagnosis")'>
                                <i class="bi bi-clipboard2-pulse"></i> Diagnosis (ICD-10)
                            </button>
                            <button class="tab-btn @(activeTab == "prescription" ? "active" : "")" @onclick='() => SetTab("prescription")'>
                                <i class="bi bi-capsule"></i> Prescription
                            </button>
                            <button class="tab-btn @(activeTab == "investigation" ? "active" : "")" @onclick='() => SetTab("investigation")'>
                                <i class="bi bi-flask"></i> Investigations
                            </button>
                            <button class="tab-btn @(activeTab == "history" ? "active" : "")" @onclick='() => SetTab("history")'>
                                <i class="bi bi-clock-history"></i> Patient History
                            </button>
                        </div>

                        <!-- Tab Content Areas -->
                        <div class="tab-content">
                            @if (activeTab == "notes")
                            {
                                <div class="notes-tab-form">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Chief Complaint</label>
                                        <textarea class="form-control-textarea" placeholder="Enter patient's primary complaint..." 
                                                  @bind="currentRequest.chief_complaint" disabled="@isReadOnly"></textarea>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="form-label">Symptoms (Free text / Legacy support)</label>
                                        <textarea class="form-control-textarea" placeholder="Enter symptom details..." 
                                                  @bind="currentRequest.symptoms" disabled="@isReadOnly"></textarea>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="form-label">Clinical Examination Details</label>
                                        <textarea class="form-control-textarea" placeholder="Write physical exam findings..." 
                                                  @bind="currentRequest.examination" disabled="@isReadOnly"></textarea>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="form-label">Advise / Recommendations</label>
                                        <textarea class="form-control-textarea" placeholder="Add doctor advise..." 
                                                  @bind="currentRequest.advise" disabled="@isReadOnly"></textarea>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="form-label">General Clinical Notes</label>
                                        <textarea class="form-control-textarea" placeholder="Add any additional notes..." 
                                                  @bind="currentRequest.notes" disabled="@isReadOnly"></textarea>
                                    </div>

                                    <hr style="margin: 1.5rem 0; border: 0; border-top: 1px dashed #cbd5e1;" />

                                    <h4 style="color: var(--primary-color); font-weight: 800; font-size: 0.95rem; text-transform: uppercase; margin-bottom: 1rem;">
                                        Follow Up Visit
                                    </h4>
                                    <div class="form-grid-2">
                                        <div class="form-group">
                                            <label class="form-label">Follow-up Date</label>
                                            <input type="date" class="form-control-input" @bind="currentRequest.followup_date" disabled="@isReadOnly" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Follow-up Notes</label>
                                            <input type="text" class="form-control-input" placeholder="e.g., Review lab reports" 
                                                   @bind="currentRequest.followup_notes" disabled="@isReadOnly" />
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (activeTab == "symptoms")
                            {
                                <div class="symptoms-tab-form">
                                    @if (!isReadOnly)
                                    {
                                        <div class="form-grid-3">
                                            <div class="form-group">
                                                <label class="form-label">Symptom Text</label>
                                                <input type="text" class="form-control-input" placeholder="e.g., Fever, headache" @bind="newSymptom.symptom_text" />
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Duration</label>
                                                <input type="text" class="form-control-input" placeholder="e.g., 3 days, 1 week" @bind="newSymptom.duration" />
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Severity</label>
                                                <select class="form-control-select" @bind="newSymptom.severity">
                                                    <option value="MILD">Mild</option>
                                                    <option value="MODERATE">Moderate</option>
                                                    <option value="SEVERE">Severe</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group mb-3">
                                            <label class="form-label">Notes</label>
                                            <div style="display:flex; gap:0.75rem;">
                                                <input type="text" class="form-control-input" style="flex:1;" placeholder="Add notes for this symptom..." @bind="newSymptom.notes" />
                                                <button class="btn-add-item" @onclick="AddSymptomItem">
                                                    <i class="bi bi-plus"></i> Add Symptom
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    <!-- Structured Symptoms List -->
                                    <div class="structured-table-card">
                                        <table class="structured-table">
                                            <thead>
                                                <tr>
                                                    <th style="width: 60px;">S.No</th>
                                                    <th>Symptom</th>
                                                    <th>Duration</th>
                                                    <th>Severity</th>
                                                    <th>Notes</th>
                                                    @if (!isReadOnly)
                                                    {
                                                        <th style="width: 60px; text-align: center;">Action</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (currentRequest.symptom_list.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="@(isReadOnly ? 5 : 6)" style="text-align: center; color: #94a3b8; padding: 2rem;">
                                                            No structured symptoms added yet.
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var sym in currentRequest.symptom_list)
                                                    {
                                                        <tr>
                                                            <td>@sym.sno</td>
                                                            <td style="font-weight: 700;">@sym.symptom_text</td>
                                                            <td>@sym.duration</td>
                                                            <td>
                                                                <span class="severity-pill @sym.severity?.ToLower()">@sym.severity</span>
                                                            </td>
                                                            <td>@sym.notes</td>
                                                            @if (!isReadOnly)
                                                            {
                                                                <td style="text-align: center;">
                                                                    <button class="btn-remove-item" @onclick="() => RemoveSymptomItem(sym)">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                            else if (activeTab == "diagnosis")
                            {
                                <div class="diagnosis-tab-form">
                                    @if (!isReadOnly)
                                    {
                                        <div class="form-grid-2">
                                            <div class="form-group autocomplete-wrapper">
                                                <label class="form-label">Search ICD-10 Code / Description</label>
                                                <input type="text" class="form-control-input" placeholder="Type to search ICD... (e.g. fever)"
                                                       @bind="icdQuery" @bind:event="oninput" @onkeyup="HandleIcdKeyUp" />
                                                @if (icdSearchResults.Count > 0)
                                                {
                                                    <div class="autocomplete-dropdown">
                                                        @foreach (var res in icdSearchResults)
                                                        {
                                                            <div class="autocomplete-item" @onclick="() => SelectIcdCode(res)">
                                                                <span class="autocomplete-code">@res.icd_code</span>
                                                                <span>@res.icd_description</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Diagnosis Description (Custom Text)</label>
                                                <input type="text" class="form-control-input" placeholder="Enter customized description..." @bind="newDiagnosis.diagnosis_text" />
                                            </div>
                                        </div>

                                        <div class="form-grid-4">
                                            <div class="form-group">
                                                <label class="form-label">Diagnosis Type</label>
                                                <select class="form-control-select" @bind="newDiagnosis.diagnosis_type">
                                                    <option value="PRIMARY">Primary</option>
                                                    <option value="SECONDARY">Secondary</option>
                                                    <option value="COMORBIDITY">Comorbidity</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Condition Type</label>
                                                <select class="form-control-select" @bind="newDiagnosis.condition_type">
                                                    <option value="ACUTE">Acute</option>
                                                    <option value="CHRONIC">Chronic</option>
                                                    <option value="FOLLOWUP">Follow Up</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Severity</label>
                                                <select class="form-control-select" @bind="newDiagnosis.severity">
                                                    <option value="MILD">Mild</option>
                                                    <option value="MODERATE">Moderate</option>
                                                    <option value="SEVERE">Severe</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Status</label>
                                                <div style="display:flex; gap:0.5rem;">
                                                    <select class="form-control-select" style="flex:1;" @bind="newDiagnosis.status">
                                                        <option value="ACTIVE">Active</option>
                                                        <option value="RESOLVED">Resolved</option>
                                                        <option value="ONGOING">Ongoing</option>
                                                    </select>
                                                    <button class="btn-add-item" @onclick="AddDiagnosisItem">
                                                        <i class="bi bi-plus"></i> Add
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Structured Diagnosis List -->
                                    <div class="structured-table-card">
                                        <table class="structured-table">
                                            <thead>
                                                <tr>
                                                    <th style="width: 60px;">S.No</th>
                                                    <th>ICD Code</th>
                                                    <th>ICD Description</th>
                                                    <th>Custom Text</th>
                                                    <th>Type</th>
                                                    <th>Condition</th>
                                                    <th>Severity</th>
                                                    <th>Status</th>
                                                    @if (!isReadOnly)
                                                    {
                                                        <th style="width: 60px; text-align: center;">Action</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (currentRequest.diagnosis_list.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="@(isReadOnly ? 8 : 9)" style="text-align: center; color: #94a3b8; padding: 2rem;">
                                                            No structured diagnoses added yet. Search ICD-10 codes above to add.
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var diag in currentRequest.diagnosis_list)
                                                    {
                                                        <tr>
                                                            <td>@diag.sno</td>
                                                            <td><strong style="color: var(--secondary-color);">@diag.icd_code</strong></td>
                                                            <td>@diag.icd_description</td>
                                                            <td>@diag.diagnosis_text</td>
                                                            <td><span class="badge bg-light text-dark font-weight-bold" style="font-size: 0.72rem;">@diag.diagnosis_type</span></td>
                                                            <td>@diag.condition_type</td>
                                                            <td>
                                                                <span class="severity-pill @diag.severity?.ToLower()">@diag.severity</span>
                                                            </td>
                                                            <td>
                                                                <span class="badge bg-success" style="font-size: 0.72rem;">@diag.status</span>
                                                            </td>
                                                            @if (!isReadOnly)
                                                            {
                                                                <td style="text-align: center;">
                                                                    <button class="btn-remove-item" @onclick="() => RemoveDiagnosisItem(diag)">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                            else if (activeTab == "prescription")
                            {
                                <div class="prescription-tab-form">
                                    @if (!isReadOnly)
                                    {
                                        <div class="form-grid-3">
                                            <div class="form-group">
                                                <label class="form-label">Drug Name</label>
                                                <input type="text" class="form-control-input" placeholder="e.g. Paracetamol 500mg" @bind="newPrescriptionItem.drug_name" />
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Generic Name (Optional)</label>
                                                <input type="text" class="form-control-input" placeholder="e.g. Acetaminophen" @bind="newPrescriptionItem.generic_name" />
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Category</label>
                                                <input type="text" class="form-control-input" placeholder="e.g. Analgesic, Antibiotic" @bind="newPrescriptionItem.drug_category" />
                                            </div>
                                        </div>

                                        <div class="form-grid-3">
                                            <div class="form-group">
                                                <label class="form-label">Dosage Frequency (Morning - Noon - Evening - Night)</label>
                                                <div class="dosage-grid">
                                                    <input type="text" class="dosage-input" placeholder="M" @bind="newPrescriptionItem.morning" title="Morning dosage" />
                                                    <input type="text" class="dosage-input" placeholder="A" @bind="newPrescriptionItem.afternoon" title="Afternoon dosage" />
                                                    <input type="text" class="dosage-input" placeholder="E" @bind="newPrescriptionItem.evening" title="Evening dosage" />
                                                    <input type="text" class="dosage-input" placeholder="N" @bind="newPrescriptionItem.night" title="Night dosage" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Food Timing</label>
                                                <div class="food-toggle-group">
                                                    <label class="food-checkbox-label">
                                                        <input type="checkbox" @bind="newPrescriptionItem.before_food" /> Before Food
                                                    </label>
                                                    <label class="food-checkbox-label">
                                                        <input type="checkbox" @bind="newPrescriptionItem.after_food" /> After Food
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Route</label>
                                                <select class="form-control-select" @bind="newPrescriptionItem.route">
                                                    <option value="ORAL">Oral</option>
                                                    <option value="IV">IV</option>
                                                    <option value="IM">IM</option>
                                                    <option value="TOPICAL">Topical</option>
                                                    <option value="INHALATION">Inhalation</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="form-grid-3">
                                            <div class="form-group">
                                                <label class="form-label">Duration (Days)</label>
                                                <input type="number" class="form-control-input" @bind="newPrescriptionItem.days" @bind:after="CalculateDrugQty" />
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Quantity</label>
                                                <input type="number" class="form-control-input" @bind="newPrescriptionItem.qty" />
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Linked Diagnosis</label>
                                                <select class="form-control-select" @bind="newPrescriptionItem.diag_id">
                                                    <option value="">-- None --</option>
                                                    @foreach (var diag in currentRequest.diagnosis_list)
                                                    {
                                                        <option value="@diag.icd_code">[@diag.icd_code] @diag.icd_description</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label class="form-label">Notes / Instructions</label>
                                            <div style="display: flex; gap: 0.75rem;">
                                                <input type="text" class="form-control-input" style="flex:1;" placeholder="Add special administration instructions..." @bind="newPrescriptionItem.notes" />
                                                <button class="btn-add-item" @onclick="AddPrescriptionItem">
                                                    <i class="bi bi-plus"></i> Add Rx Item
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    <!-- Prescription Master Details (Remarks) -->
                                    <div class="form-grid-2 mb-3">
                                        <div class="form-group">
                                            <label class="form-label">Top Remarks (Dispensing Instructions)</label>
                                            <input type="text" class="form-control-input" placeholder="e.g. Take all medicines after food" 
                                                   @bind="prescriptionRemarks.topremarks" disabled="@isReadOnly" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Bottom Remarks</label>
                                            <input type="text" class="form-control-input" placeholder="e.g. Review after 5 days if no improvement" 
                                                   @bind="prescriptionRemarks.bottonremarks" disabled="@isReadOnly" />
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(currentRequest.prescription?.pr_code))
                                    {
                                        <div style="background:#e0f2fe; padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid #bae6fd; font-size: 0.85rem; color:#0369a1; font-weight:700; margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
                                            <span>Active Prescription Reference: @currentRequest.prescription.pr_code</span>
                                            @if (!isReadOnly)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" style="font-weight:700; border-radius:6px; font-size:0.75rem;" @onclick="DeletePrescriptionMasterAsync">
                                                    <i class="bi bi-trash"></i> Delete Prescription
                                                </button>
                                            }
                                        </div>
                                    }

                                    <!-- Prescription Details Table -->
                                    <div class="structured-table-card">
                                        <table class="structured-table">
                                            <thead>
                                                <tr>
                                                    <th style="width: 50px;">S.No</th>
                                                    <th>Drug Name</th>
                                                    <th>Generic Name</th>
                                                    <th>Dosage</th>
                                                    <th>Timing</th>
                                                    <th>Route</th>
                                                    <th>Days</th>
                                                    <th>Qty</th>
                                                    <th>Linked Diagnosis</th>
                                                    <th>Instructions</th>
                                                    @if (!isReadOnly)
                                                    {
                                                        <th style="width: 50px; text-align: center;">Action</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (currentRequest.prescription == null || currentRequest.prescription.items.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="@(isReadOnly ? 10 : 11)" style="text-align: center; color: #94a3b8; padding: 2rem;">
                                                            No medications prescribed in this session.
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var item in currentRequest.prescription.items)
                                                    {
                                                        <tr>
                                                            <td>@item.sno</td>
                                                            <td style="font-weight: 700; color:#0f172a;">@item.drug_name</td>
                                                            <td>@item.generic_name</td>
                                                            <td>
                                                                <span class="badge bg-light text-dark fw-bold">@item.morning - @item.afternoon - @item.evening - @item.night</span>
                                                            </td>
                                                            <td>
                                                                @if (item.before_food) { <span class="badge bg-warning text-dark me-1">AC (Before)</span> }
                                                                @if (item.after_food) { <span class="badge bg-info text-dark">PC (After)</span> }
                                                            </td>
                                                            <td>@item.route</td>
                                                            <td style="font-weight:600;">@item.days Days</td>
                                                            <td style="font-weight:800; color:var(--primary-color);">@item.qty</td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(item.diag_id))
                                                                {
                                                                    <span class="badge bg-light text-primary border" title="@item.diag_id">@item.diag_id</span>
                                                                }
                                                                else
                                                                {
                                                                    <span>-</span>
                                                                }
                                                            </td>
                                                            <td>@item.notes</td>
                                                            @if (!isReadOnly)
                                                            {
                                                                <td style="text-align: center;">
                                                                    <button class="btn-remove-item" @onclick="() => RemovePrescriptionItem(item)">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                            else if (activeTab == "investigation")
                            {
                                <div class="investigations-tab-form">
                                    @if (!isReadOnly)
                                    {
                                        <div class="form-grid-3">
                                            <div class="form-group">
                                                <label class="form-label">Test Name</label>
                                                <input type="text" class="form-control-input" placeholder="e.g. Complete Blood Count (CBC)" @bind="newInvestigationItem.test_name" />
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Category</label>
                                                <input type="text" class="form-control-input" placeholder="e.g. Haematology, Biochemistry" @bind="newInvestigationItem.test_category" />
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Linked Diagnosis</label>
                                                <select class="form-control-select" @bind="newInvestigationItem.diag_id">
                                                    <option value="">-- None --</option>
                                                    @foreach (var diag in currentRequest.diagnosis_list)
                                                    {
                                                        <option value="@diag.icd_code">[@diag.icd_code] @diag.icd_description</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        <div class="form-group mb-3">
                                            <div style="display:flex; justify-content: space-between; align-items: center; gap: 1rem;">
                                                <label class="food-checkbox-label">
                                                    <input type="checkbox" @bind="investigationMasterUrgent" /> 🚨 Mark Investigation Ordered as URGENT
                                                </label>
                                                <button class="btn-add-item" @onclick="AddInvestigationItem">
                                                    <i class="bi bi-plus"></i> Add Test Order
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    <!-- Investigation Master Details -->
                                    <div class="form-group mb-3">
                                        <label class="form-label">Investigation Notes / Preparatory Instructions</label>
                                        <input type="text" class="form-control-input" placeholder="e.g. Fasting required for blood sugar test" 
                                               @bind="investigationNotes" disabled="@isReadOnly" />
                                    </div>

                                    @if (currentRequest.investigation != null && !string.IsNullOrEmpty(currentRequest.investigation.inv_id))
                                    {
                                        <div style="background:#e0f2fe; padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid #bae6fd; font-size: 0.85rem; color:#0369a1; font-weight:700; margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
                                            <span>Active Investigation ID: @currentRequest.investigation.inv_id (Urgent: @(currentRequest.investigation.is_urgent ? "YES" : "NO"))</span>
                                            @if (!isReadOnly)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" style="font-weight:700; border-radius:6px; font-size:0.75rem;" @onclick="DeleteInvestigationMasterAsync">
                                                    <i class="bi bi-trash"></i> Delete Investigation
                                                </button>
                                            }
                                        </div>
                                    }

                                    <!-- Investigation List and Result Entry -->
                                    <div class="structured-table-card">
                                        <table class="structured-table">
                                            <thead>
                                                <tr>
                                                    <th style="width: 50px;">S.No</th>
                                                    <th>Test Name</th>
                                                    <th>Category</th>
                                                    <th>Linked Diagnosis</th>
                                                    <th>Status</th>
                                                    <th>Results & Notes</th>
                                                    @if (!isReadOnly)
                                                    {
                                                        <th style="width: 50px; text-align: center;">Action</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (currentRequest.investigation == null || currentRequest.investigation.tests.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="@(isReadOnly ? 6 : 7)" style="text-align: center; color: #94a3b8; padding: 2rem;">
                                                            No laboratory or diagnostic tests ordered.
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var test in currentRequest.investigation.tests)
                                                    {
                                                        var savedDetail = GetSavedInvestigationDetail(test.sno);
                                                        <tr>
                                                            <td>@test.sno</td>
                                                            <td style="font-weight: 700; color:#0f172a;">@test.test_name</td>
                                                            <td>@test.test_category</td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(test.diag_id))
                                                                {
                                                                    <span class="badge bg-light text-primary border">@test.diag_id</span>
                                                                }
                                                                else
                                                                {
                                                                    <span>-</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (savedDetail != null)
                                                                {
                                                                    <span class="badge @(savedDetail.result_status == "COMPLETED" ? "bg-success" : "bg-warning text-dark")">
                                                                        @savedDetail.result_status
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-secondary">ORDERED</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (savedDetail != null)
                                                                {
                                                                    @if (savedDetail.result_status == "COMPLETED")
                                                                    {
                                                                        <div style="font-size: 0.8rem;">
                                                                            <strong>Value:</strong> @savedDetail.result_value <br />
                                                                            <strong>Notes:</strong> @savedDetail.result_notes <br />
                                                                            <span class="text-muted" style="font-size:0.7rem;">Date: @savedDetail.result_date?.ToString("dd-MMM-yyyy")</span>
                                                                        </div>
                                                                    }
                                                                    else if (!isReadOnly)
                                                                    {
                                                                        <!-- Entry box to input test results -->
                                                                        <div class="result-input-box">
                                                                            <input type="text" class="form-control-input" style="height:28px; font-size:0.75rem; padding: 0.2rem 0.5rem;"
                                                                                   placeholder="Result value..." @bind="resultValueCache[savedDetail.inv_det_id.ToString()]" />
                                                                            <input type="text" class="form-control-input" style="height:28px; font-size:0.75rem; padding: 0.2rem 0.5rem;"
                                                                                   placeholder="Result notes..." @bind="resultNotesCache[savedDetail.inv_det_id.ToString()]" />
                                                                            <button class="btn-save-result" @onclick="() => SaveTestResultAsync(savedDetail.inv_det_id)">
                                                                                Submit Result
                                                                            </button>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted">No results entered</span>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted small">Save draft to enable result tracking</span>
                                                                }
                                                            </td>
                                                            @if (!isReadOnly)
                                                            {
                                                                <td style="text-align: center;">
                                                                    <button class="btn-remove-item" @onclick="() => RemoveInvestigationItem(test)">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                            else if (activeTab == "history")
                            {
                                <div class="patient-history-tab">
                                    @if (loadingHistory)
                                    {
                                        <div style="text-align: center; padding: 2rem;">
                                            <span class="spinner-border text-primary" role="status"></span>
                                            <p class="text-muted mt-2">Fetching patient visit logs...</p>
                                        </div>
                                    }
                                    else if (patientHistory.Count == 0)
                                    {
                                        <div style="text-align: center; padding: 3rem; color: #94a3b8;">
                                            <i class="bi bi-clock-history" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;"></i>
                                            <h5>No Medical History Found</h5>
                                            <p>This appears to be the patient's first recorded visit in this clinic.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="history-timeline">
                                            @foreach (var hist in patientHistory)
                                            {
                                                <div class="history-card">
                                                    <div class="history-header">
                                                        <span class="history-date">Visit Date: @hist.visit_date?.ToString("dd-MMM-yyyy")</span>
                                                        <span class="history-doc">Consulted Code: @hist.dcode</span>
                                                    </div>

                                                    @if (!string.IsNullOrEmpty(hist.chief_complaint))
                                                    {
                                                        <div class="history-block">
                                                            <div class="history-block-label">Chief Complaint</div>
                                                            <div class="history-block-content">@hist.chief_complaint</div>
                                                        </div>
                                                    }

                                                    @if (hist.diagnosis_list.Count > 0)
                                                    {
                                                        <div class="history-block">
                                                            <div class="history-block-label">Diagnosis</div>
                                                            <div class="history-block-content">
                                                                <ul style="margin: 0; padding-left: 1.2rem;">
                                                                    @foreach (var diag in hist.diagnosis_list)
                                                                    {
                                                                        <li>
                                                                            <strong>@diag.icd_code</strong> - @diag.icd_description
                                                                            @if (!string.IsNullOrEmpty(diag.diagnosis_text)) { <span> (@diag.diagnosis_text)</span> }
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    }

                                                    @if (hist.prescription != null && hist.prescription.items.Count > 0)
                                                    {
                                                        <div class="history-block">
                                                            <div class="history-block-label">Prescribed Medicines</div>
                                                            <div class="history-block-content">
                                                                @string.Join(", ", hist.prescription.items.Select(i => $"{i.drug_name} ({i.morning}-{i.afternoon}-{i.evening}-{i.night}) for {i.days}d"))
                                                            </div>
                                                        </div>
                                                    }

                                                    @if (hist.investigation != null && hist.investigation.tests.Count > 0)
                                                    {
                                                        <div class="history-block">
                                                            <div class="history-block-label">Investigations Ordered</div>
                                                            <div class="history-block-content">
                                                                @string.Join(", ", hist.investigation.tests.Select(t => t.test_name))
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <!-- History Pagination -->
                                        <div class="history-pagination">
                                            <button class="btn-pagination" @onclick="PrevHistoryPage" disabled="@(historyPage <= 1)">
                                                <i class="bi bi-chevron-left"></i>
                                            </button>
                                            <span class="pagination-info">Page @historyPage</span>
                                            <button class="btn-pagination" @onclick="NextHistoryPage" disabled="@(patientHistory.Count < historyPageSize)">
                                                <i class="bi bi-chevron-right"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Workspace Right (Vitals Sidebar) -->
                    <div class="workspace-right">
                        <!-- Patient Basic Demographics/Details -->
                        <div class="vitals-side-card" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-color: #bbf7d0;">
                            <div class="vitals-card-title" style="color: #166534; border-color: #bbf7d0; margin-bottom: 0.5rem; padding-bottom: 0.4rem;">
                                <i class="bi bi-shield-check"></i> Consult Info
                            </div>
                            <div style="font-size: 0.85rem; font-weight: 700; color: #166534; line-height: 1.5;">
                                <div>Doctor Code: <strong>@Dcode</strong></div>
                                <div>OP Status: <span class="badge bg-success" style="font-size: 0.7rem;">@OpStatus</span></div>
                                @if (isConsulted || isReadOnly)
                                {
                                    <div style="margin-top: 0.25rem; color:#15803d; font-size:0.75rem;">
                                        <i class="bi bi-check-circle-fill"></i> Consultation Completed
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Vitals Card -->
                        <div class="vitals-side-card">
                            <div class="vitals-card-title">
                                <i class="bi bi-heart-pulse"></i> Patient Vitals
                            </div>

                            @if (loadingVitals)
                            {
                                <div style="text-align: center; padding: 1rem;">
                                    <span class="spinner-border spinner-border-sm text-primary"></span>
                                </div>
                            }
                            else if (vitalsList.Count == 0)
                            {
                                <div style="color: #94a3b8; text-align: center; font-size: 0.8rem; padding: 1rem 0;">
                                    No vitals recorded for today's visit.
                                </div>
                            }
                            else
                            {
                                var vit = vitalsList.First();
                                <div class="vitals-badge-grid">
                                    <div class="vital-item">
                                        <span class="vital-name">Height</span>
                                        <span class="vital-value">@(vit.height_cm?.ToString("0") ?? "-") cm</span>
                                    </div>
                                    <div class="vital-item">
                                        <span class="vital-name">Weight</span>
                                        <span class="vital-value">@(vit.weight_kg?.ToString("0.0") ?? "-") kg</span>
                                    </div>
                                    <div class="vital-item">
                                        <span class="vital-name">BMI</span>
                                        <span class="vital-value">@(vit.bmi?.ToString("0.0") ?? "-")</span>
                                    </div>
                                    <div class="vital-item">
                                        <span class="vital-name">Temp</span>
                                        <span class="vital-value">@(vit.temperature_f?.ToString("0.0") ?? "-") °F</span>
                                    </div>
                                    <div class="vital-item" style="grid-column: span 2;">
                                        <span class="vital-name">Blood Pressure</span>
                                        <span class="vital-value">
                                            @if (vit.bp_systolic.HasValue || vit.bp_diastolic.HasValue)
                                            {
                                                <span>@(vit.bp_systolic?.ToString() ?? "-") / @(vit.bp_diastolic?.ToString() ?? "-") mmHg</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </span>
                                    </div>
                                    <div class="vital-item">
                                        <span class="vital-name">Pulse Rate</span>
                                        <span class="vital-value">@(vit.pulse_rate?.ToString() ?? "-") BPM</span>
                                    </div>
                                    <div class="vital-item">
                                        <span class="vital-name">SpO2</span>
                                        <span class="vital-value">@(vit.spo2?.ToString("0") ?? "-") %</span>
                                    </div>
                                    <div class="vital-item">
                                        <span class="vital-name">Sugar Level</span>
                                        <span class="vital-value">@(vit.sugar_level?.ToString("0") ?? "-") mg/dL</span>
                                    </div>
                                    <div class="vital-item">
                                        <span class="vital-name">Pain Scale</span>
                                        <span class="vital-value @(vit.pain_scale > 5 ? "alert-vital" : "")">
                                            @(vit.pain_scale?.ToString() ?? "-") / 10
                                        </span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(vit.allergy_notes))
                                {
                                    <div style="margin-top: 1rem; border-top: 1px solid #f1f5f9; padding-top: 0.75rem;">
                                        <span class="vital-name" style="color:var(--danger-color); font-weight:800;">Allergies / Chief Complaint</span>
                                        <p style="margin: 0.25rem 0 0 0; font-size: 0.82rem; font-weight: 700; color: #334155; line-height: 1.4;">
                                            @vit.allergy_notes
                                        </p>
                                    </div>
                                }
                            }
                        </div>

                        <!-- System ICD Shortcuts -->
                        <div class="vitals-side-card">
                            <div class="vitals-card-title">
                                <i class="bi bi-lightbulb"></i> Clinical Info
                            </div>
                            <p style="font-size: 0.78rem; color: #64748b; line-height: 1.4; margin: 0;">
                                Double check ICD-10 codings before finalizing the case sheet. Finalizing locks the record and submits prescriptions to pharmacy and lab orders to diagnostics.
                            </p>
                        </div>
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="casesheet-footer">
                <div class="footer-left">
                    @if (isReadOnly)
                    {
                        <span style="color:var(--success-color); font-weight:700;">
                            <i class="bi bi-lock-fill"></i> Read-only: Finalized Case Sheet
                        </span>
                    }
                    else if (savingData)
                    {
                        <span>Saving records...</span>
                    }
                </div>
                <div class="footer-right">
                    <button class="btn-footer btn-close" @onclick="CloseModal">Close</button>
                    @if (!isReadOnly)
                    {
                        <button class="btn-footer btn-draft" @onclick="SaveDraftAsync" disabled="@savingData">
                            @if (savingData) { <span class="spinner-border spinner-border-sm"></span> }
                            Save Draft
                        </button>
                        <button class="btn-footer btn-finalize" @onclick="FinalizeCaseSheetAsync" disabled="@savingData">
                            @if (savingData) { <span class="spinner-border spinner-border-sm"></span> }
                            <i class="bi bi-check-all"></i> Finalize Case Sheet
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public Guid OpId { get; set; }
    [Parameter] public string OpNo { get; set; } = string.Empty;
    [Parameter] public decimal CustId { get; set; }
    [Parameter] public int Dcode { get; set; }
    [Parameter] public string PatientName { get; set; } = string.Empty;
    [Parameter] public DateTime? VisitDate { get; set; }
    [Parameter] public string OpStatus { get; set; } = "WAITING";
    [Parameter] public EventCallback OnSaved { get; set; }

    private string activeTab = "notes";
    private bool loadingData = false;
    private bool savingData = false;
    private bool isConsulted = false;
    private bool isReadOnly => currentRequest.sheet_status == "FINAL";

    // Data forms
    private SaveCaseSheetRequest currentRequest = new();
    
    // Items being added
    private CaseSheetSymptomItem newSymptom = new() { severity = "MILD" };
    private CaseSheetDiagnosisItem newDiagnosis = new() { diagnosis_type = "PRIMARY", condition_type = "ACUTE", severity = "MODERATE", status = "ACTIVE" };
    private CaseSheetPrescriptionItem newPrescriptionItem = new() { morning = "1", afternoon = "0", evening = "0", night = "0", route = "ORAL", before_food = false, after_food = true, days = 5, qty = 5 };
    private CaseSheetInvestigationItem newInvestigationItem = new() { quantity = 1 };

    // Remarks & master fields caching
    private CaseSheetPrescriptionRequest prescriptionRemarks = new();
    private string investigationNotes = string.Empty;
    private bool investigationMasterUrgent = false;

    // ICD search
    private string icdQuery = string.Empty;
    private List<IcdSearchResult> icdSearchResults = new();

    // Vitals
    private bool loadingVitals = false;
    private List<OPRegistrationModel.PatientVitalsModel> vitalsList = new();

    // Lab Results Caching
    private Dictionary<string, string> resultValueCache = new();
    private Dictionary<string, string> resultNotesCache = new();
    private CaseSheetViewModel? rawLoadedSheet = null; // Stored to look up inv_det_id by sno

    // History
    private bool loadingHistory = false;
    private List<CaseSheetViewModel> patientHistory = new();
    private int historyPage = 1;
    private int historyPageSize = 5;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && OpId != Guid.Empty && currentRequest.op_id != OpId.ToString())
        {
            await LoadClinicalWorkspaceAsync();
        }
    }

    private void SetTab(string tabName)
    {
        activeTab = tabName;
        if (tabName == "history" && patientHistory.Count == 0)
        {
            _ = LoadPatientHistoryAsync();
        }
    }

    private async Task LoadClinicalWorkspaceAsync()
    {
        loadingData = true;
        activeTab = "notes";
        
        icdQuery = string.Empty;
        icdSearchResults.Clear();
        
        resultValueCache.Clear();
        resultNotesCache.Clear();

        try
        {
            // Reset request object
            currentRequest = new SaveCaseSheetRequest
            {
                op_id = OpId.ToString(),
                custid = CustId,
                dcode = Dcode,
                sheet_status = "DRAFT"
            };
            isConsulted = false;

            prescriptionRemarks = new();
            investigationNotes = string.Empty;
            investigationMasterUrgent = false;

            // 1. Load existing case sheet (if any)
            var existingSheet = await CaseSheetService.GetCaseSheetByVisitAsync(OpId);
            rawLoadedSheet = existingSheet;
            if (existingSheet != null && !string.IsNullOrEmpty(existingSheet.sheet_id))
            {
                LoadFromViewModel(existingSheet);
                
                // Initialize remarks caches
                if (existingSheet.prescription != null)
                {
                    prescriptionRemarks.topremarks = existingSheet.prescription.topremarks;
                    prescriptionRemarks.bottonremarks = existingSheet.prescription.bottonremarks;
                    prescriptionRemarks.pr_code = existingSheet.prescription.pr_code;
                }
                if (existingSheet.investigation != null)
                {
                    investigationNotes = existingSheet.investigation.notes;
                    investigationMasterUrgent = existingSheet.investigation.is_urgent;
                }
            }

            // 2. Load Patient Vitals
            loadingVitals = true;
            StateHasChanged();
            vitalsList = await AppointmentBookingService.GetOpVitalsAsync(OpId);
            loadingVitals = false;

            // 3. Clear History cache so it reloads if clicked
            patientHistory.Clear();
            historyPage = 1;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading clinical details: {ex.Message}");
        }
        finally
        {
            loadingData = false;
        }
    }

    private void LoadFromViewModel(CaseSheetViewModel vm)
    {
        currentRequest.sheet_id = vm.sheet_id;
        isConsulted = vm.is_consulted;
        currentRequest.chief_complaint = vm.chief_complaint;
        currentRequest.symptoms = vm.symptoms;
        currentRequest.examination = vm.examination;
        currentRequest.advise = vm.advise;
        currentRequest.notes = vm.notes;
        currentRequest.followup_date = vm.followup_date;
        currentRequest.followup_notes = vm.followup_notes;
        currentRequest.sheet_status = vm.sheet_status ?? "DRAFT";

        currentRequest.symptom_list = vm.symptom_list.Select(s => new CaseSheetSymptomItem
        {
            sno = s.sno,
            symptom_text = s.symptom_text ?? "",
            duration = s.duration,
            severity = s.severity,
            notes = s.notes
        }).ToList();

        currentRequest.diagnosis_list = vm.diagnosis_list.Select(d => new CaseSheetDiagnosisItem
        {
            sno = d.sno,
            icd_code = d.icd_code,
            icd_description = d.icd_description,
            diagnosis_text = d.diagnosis_text,
            diagnosis_type = d.diagnosis_type,
            condition_type = d.condition_type,
            severity = d.severity,
            status = d.status ?? "ACTIVE"
        }).ToList();

        if (vm.prescription != null)
        {
            currentRequest.prescription = new CaseSheetPrescriptionRequest
            {
                pr_code = vm.prescription.pr_code,
                topremarks = vm.prescription.topremarks,
                bottonremarks = vm.prescription.bottonremarks,
                items = vm.prescription.items.Select(i => new CaseSheetPrescriptionItem
                {
                    sno = i.sno,
                    diag_id = i.diag_id?.ToString(),
                    drug_name = i.drug_name ?? "",
                    drug_code = i.drug_code,
                    generic_name = i.generic_name,
                    drug_category = i.drug_category,
                    morning = i.morning ?? "0",
                    afternoon = i.afternoon ?? "0",
                    evening = i.evening ?? "0",
                    night = i.night ?? "0",
                    before_food = i.before_food,
                    after_food = i.after_food,
                    days = i.days,
                    qty = i.qty,
                    route = i.route,
                    rate = i.rate,
                    mrp = i.mrp,
                    notes = i.notes
                }).ToList()
            };
        }
        else
        {
            currentRequest.prescription = new CaseSheetPrescriptionRequest();
        }

        if (vm.investigation != null)
        {
            currentRequest.investigation = new CaseSheetInvestigationRequest
            {
                inv_id = vm.investigation.inv_id,
                notes = vm.investigation.notes,
                is_urgent = vm.investigation.is_urgent,
                tests = vm.investigation.tests.Select(t => new CaseSheetInvestigationItem
                {
                    sno = t.sno,
                    diag_id = t.diag_id?.ToString(),
                    test_name = t.test_name ?? "",
                    test_code = t.test_code,
                    test_category = t.test_category,
                    quantity = t.quantity,
                    rate = t.rate,
                    amount = t.amount
                }).ToList()
            };
        }
        else
        {
            currentRequest.investigation = new CaseSheetInvestigationRequest();
        }
    }

    // --- Structured Symptoms List ---
    private void AddSymptomItem()
    {
        if (string.IsNullOrWhiteSpace(newSymptom.symptom_text))
        {
            ToastService.ShowError("Please enter symptom text.");
            return;
        }

        newSymptom.sno = currentRequest.symptom_list.Count + 1;
        currentRequest.symptom_list.Add(newSymptom);
        
        // Reset item form
        newSymptom = new CaseSheetSymptomItem { severity = "MILD" };
    }

    private void RemoveSymptomItem(CaseSheetSymptomItem item)
    {
        currentRequest.symptom_list.Remove(item);
        // Re-sno
        for (int i = 0; i < currentRequest.symptom_list.Count; i++)
        {
            currentRequest.symptom_list[i].sno = i + 1;
        }
    }

    // --- Structured Diagnosis List ---
    private async Task OnIcdSearchInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? string.Empty;
        icdQuery = val;
        if (val.Length >= 2)
        {
            icdSearchResults = await CaseSheetService.SearchIcd10Async(val, 5);
        }
        else
        {
            icdSearchResults.Clear();
        }
    }

    private void HandleIcdKeyUp(KeyboardEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(icdQuery))
        {
            icdSearchResults.Clear();
        }
    }

    private void SelectIcdCode(IcdSearchResult res)
    {
        newDiagnosis.icd_code = res.icd_code;
        newDiagnosis.icd_description = res.icd_description;
        newDiagnosis.diagnosis_text = res.icd_description; // default custom text to description
        
        icdSearchResults.Clear();
        icdQuery = $"{res.icd_code} - {res.icd_description}";
    }

    private void AddDiagnosisItem()
    {
        if (string.IsNullOrWhiteSpace(newDiagnosis.icd_code))
        {
            ToastService.ShowError("Please search and select an ICD-10 code first.");
            return;
        }

        newDiagnosis.sno = currentRequest.diagnosis_list.Count + 1;
        currentRequest.diagnosis_list.Add(newDiagnosis);

        // Reset
        newDiagnosis = new CaseSheetDiagnosisItem { diagnosis_type = "PRIMARY", condition_type = "ACUTE", severity = "MODERATE", status = "ACTIVE" };
        icdQuery = string.Empty;
    }

    private void RemoveDiagnosisItem(CaseSheetDiagnosisItem item)
    {
        currentRequest.diagnosis_list.Remove(item);
        for (int i = 0; i < currentRequest.diagnosis_list.Count; i++)
        {
            currentRequest.diagnosis_list[i].sno = i + 1;
        }
    }

    // --- Prescription List ---
    private void CalculateDrugQty()
    {
        if (newPrescriptionItem.days.HasValue)
        {
            decimal dailyCount = 0;
            if (decimal.TryParse(newPrescriptionItem.morning, out decimal m)) dailyCount += m;
            if (decimal.TryParse(newPrescriptionItem.afternoon, out decimal a)) dailyCount += a;
            if (decimal.TryParse(newPrescriptionItem.evening, out decimal e)) dailyCount += e;
            if (decimal.TryParse(newPrescriptionItem.night, out decimal n)) dailyCount += n;

            if (dailyCount > 0)
            {
                newPrescriptionItem.qty = dailyCount * newPrescriptionItem.days.Value;
            }
        }
    }

    private void AddPrescriptionItem()
    {
        if (string.IsNullOrWhiteSpace(newPrescriptionItem.drug_name))
        {
            ToastService.ShowError("Please enter drug name.");
            return;
