    private string GetFoodTiming(CaseSheetPrescriptionItem item)
    {
        if (item.before_food) return "BEFORE";
        if (item.after_food) return "AFTER";
        return "";
    }

    private void SetFoodTiming(CaseSheetPrescriptionItem item, string value)
    {
        if (value == "BEFORE")
        {
            item.before_food = true;
            item.after_food = false;
        }
        else if (value == "AFTER")
        {
            item.before_food = false;
            item.after_food = true;
        }
        else
        {
            item.before_food = false;
            item.after_food = false;
        }
    }

    private void CalculateItemDrugQty(CaseSheetPrescriptionItem item)
    {
        if (item.days.HasValue)
        {
            decimal dailyCount = 0;
            if (decimal.TryParse(item.morning, out decimal m)) dailyCount += m;
            if (decimal.TryParse(item.afternoon, out decimal a)) dailyCount += a;
            if (decimal.TryParse(item.evening, out decimal e)) dailyCount += e;
            if (decimal.TryParse(item.night, out decimal n)) dailyCount += n;

            if (dailyCount > 0)
            {
                item.qty = dailyCount * item.days.Value;
            }
        }
    }

    private void ToggleItemDosage(CaseSheetPrescriptionItem item, string period)
    {
        if (period == "morning")
            item.morning = (item.morning == "1") ? "0" : "1";
        else if (period == "afternoon")
            item.afternoon = (item.afternoon == "1") ? "0" : "1";
        else if (period == "evening")
            item.evening = (item.evening == "1") ? "0" : "1";
        else if (period == "night")
            item.night = (item.night == "1") ? "0" : "1";

        CalculateItemDrugQty(item);
    }

