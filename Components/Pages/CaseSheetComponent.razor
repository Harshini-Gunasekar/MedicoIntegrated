    }

    // --- Unbilled Charges & Observation Management ---
    private async Task LoadUnbilledChargesAsync()
    {
        if (OpId != Guid.Empty || (IpId.HasValue && IpId.Value != Guid.Empty) || CustId > 0)
        {
            loadingUnbilled = true;
            StateHasChanged();
            try
            {
                if (allTestMasters.Count == 0)
                {
                    try
                    {
                        var tests = await LabCareTestService.GetAllTestsAsync();
                        allTestMasters = tests.Where(t => !string.IsNullOrWhiteSpace(t.name)).ToList();
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error loading test masters: {ex.Message}");
                    }
                }

                var opParam = OpId != Guid.Empty ? OpId.ToString() : null;
                
                // 1. Fetch visit-specific unbilled charges
                var visitCharges = await HmsBillingService.GetUnbilledChargesByVisitAsync(opParam, IpId) ?? new();

                // 2. Fetch all unbilled charges for this patient (by CustId or OP/IP visit) to ensure full patient unbilled charges are displayed
                List<UnbilledChargeSummary> patientAllCharges = new();
                try
                {
                    var allCharges = await HmsBillingService.GetAllUnbilledChargesAsync(opParam, IpId?.ToString()) ?? new();
                    if (allCharges.Any())
                    {
                        patientAllCharges = allCharges.Where(c => 
                            (CustId > 0 && c.custid.HasValue && c.custid.Value == CustId) ||
                            (!string.IsNullOrEmpty(opParam) && string.Equals(c.opvisitid, opParam, StringComparison.OrdinalIgnoreCase)) ||
                            (!string.IsNullOrEmpty(OpNo) && string.Equals(c.opvisitid, OpNo, StringComparison.OrdinalIgnoreCase)) ||
                            (IpId.HasValue && c.ip_id.HasValue && c.ip_id.Value == IpId.Value)
                        ).ToList();
                    }
                }
                catch { }

                // Combine visit charges and patient-wide charges, deduplicating by unbilled key
                var combined = new List<UnbilledChargeSummary>(visitCharges);
                foreach (var charge in patientAllCharges)
                {
                    var chargeKey = GetUnbilledKey(charge);
                    if (!combined.Any(c => GetUnbilledKey(c) == chargeKey))
                    {
                        combined.Add(charge);
                    }
                }

                unbilledChargesList = combined.Where(u => u.billedstatus != true).ToList();

                // Synchronize updated unbilled charge rates into investigation tests in case sheet
                if (unbilledChargesList != null && currentRequest.investigation?.tests != null)
                {
                    foreach (var test in currentRequest.investigation.tests)
                    {
                        var match = unbilledChargesList.FirstOrDefault(u => 
                            (test.test_code.HasValue && u.tcode.HasValue && test.test_code.Value == u.tcode.Value) ||
                            (!string.IsNullOrWhiteSpace(test.test_name) && !string.IsNullOrWhiteSpace(u.item_name) && test.test_name.Equals(u.item_name, StringComparison.OrdinalIgnoreCase)));
                        if (match != null && match.rate.HasValue)
                        {
                            test.rate = (decimal)match.rate.Value;
                            if (match.quantity.HasValue && match.quantity.Value > 0) test.quantity = (decimal)match.quantity.Value;
                            test.amount = match.amount.HasValue ? (decimal)match.amount.Value : ((test.rate ?? 0) * test.quantity);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading unbilled charges: {ex.Message}");
            }
            finally
            {
                loadingUnbilled = false;
                StateHasChanged();
            }
        }
    }

    private List<UnbilledChargeSummary> GetPatientUnbilledCharges()
