    private bool IsMedicineAlreadyAdded(OpPrescriptionDetailModel m)
    {
        if (currentRequest.prescription?.items == null || currentRequest.prescription.items.Count == 0)
            return false;

        return currentRequest.prescription.items.Any(existing =>
            (!string.IsNullOrWhiteSpace(existing.drug_name) &&
             !string.IsNullOrWhiteSpace(m.drug_name) &&
             existing.drug_name.Trim().Equals(m.drug_name.Trim(), StringComparison.OrdinalIgnoreCase)) ||
            (existing.drug_code.HasValue && existing.drug_code > 0 &&
             m.drug_code.HasValue && m.drug_code > 0 &&
             existing.drug_code.Value == m.drug_code.Value)
        );
    }

    private void AddMedicineToPrescription(OpPrescriptionDetailModel med)
    {
        if (med == null || string.IsNullOrWhiteSpace(med.drug_name)) return;
        if (IsMedicineAlreadyAdded(med))
        {
            ToastService.ShowWarning($"{med.drug_name} is already in the prescription.");
            return;
        }

        if (currentRequest.prescription == null)
        {
            currentRequest.prescription = new CaseSheetPrescriptionRequest();
        }
        if (currentRequest.prescription.items == null)
        {
            currentRequest.prescription.items = new List<CaseSheetPrescriptionItem>();
        }

        if (currentRequest.prescription.items.Count == 1 && string.IsNullOrWhiteSpace(currentRequest.prescription.items[0].drug_name))
        {
            currentRequest.prescription.items.Clear();
        }

        string? resolvedUnit = GetItemUomMeasureByCodeOrName(med.drug_code, med.drug_name);
        if (string.IsNullOrWhiteSpace(resolvedUnit))
        {
            resolvedUnit = med.dose_unit;
        }

        var newItem = new CaseSheetPrescriptionItem
        {
            sno = currentRequest.prescription.items.Count + 1,
            diag_id = med.diag_id?.ToString(),
            drug_name = med.drug_name ?? "",
            drug_code = med.drug_code,
            generic_name = med.generic_name,
            drug_category = med.drug_category,
            morning = med.morning ?? "0",
            afternoon = med.afternoon ?? "0",
            evening = med.evening ?? "0",
            night = med.night ?? "0",
            morning_dose = med.morning_dose ?? med.morning ?? "0",
            afternoon_dose = med.afternoon_dose ?? med.afternoon ?? "0",
            evening_dose = med.evening_dose ?? med.evening ?? "0",
            night_dose = med.night_dose ?? med.night ?? "0",
            dose_unit = resolvedUnit ?? "",
            before_food = med.before_food,
            after_food = med.after_food,
            days = med.days,
            qty = med.qty,
            route = med.route,
            rate = med.rate,
            mrp = med.mrp,
            notes = med.notes
        };

        if (!newItem.rate.HasValue || newItem.rate.Value <= 0)
        {
            var unitPrice = GetItemUnitPrice(newItem);
            if (unitPrice > 0)
            {
                newItem.rate = unitPrice;
            }
        }

        CalculateItemDrugQty(newItem);
        currentRequest.prescription.items.Add(newItem);

        for (int i = 0; i < currentRequest.prescription.items.Count; i++)
        {
            currentRequest.prescription.items[i].sno = i + 1;
        }

        if (activePrescription != null)
        {
            activePrescription.items = currentRequest.prescription.items.Select(it => new OpPrescriptionDetailModel
            {
                sno = it.sno,
                drug_name = it.drug_name,
                drug_code = it.drug_code,
                generic_name = it.generic_name,
                drug_category = it.drug_category,
                morning = it.morning,
                afternoon = it.afternoon,
                evening = it.evening,
                night = it.night,
                morning_dose = it.morning_dose,
                afternoon_dose = it.afternoon_dose,
                evening_dose = it.evening_dose,
                night_dose = it.night_dose,
                dose_unit = it.dose_unit,
                before_food = it.before_food,
                after_food = it.after_food,
                days = it.days,
                qty = it.qty,
                rate = it.rate,
                mrp = it.mrp,
                notes = it.notes
            }).ToList();
        }

        ToastService.ShowSuccess($"Added {newItem.drug_name} to prescription.");
        StateHasChanged();
    }

    private void AddAllLastVisitMedicines()
    {
        var allMeds = GetAllLastVisitMedicines();
        var toAdd = allMeds.Where(m => !IsMedicineAlreadyAdded(m)).ToList();
        if (toAdd.Count == 0)
        {
            ToastService.ShowInfo("All medicines from last visit are already added.");
            return;
        }

        foreach (var med in toAdd)
        {
            AddMedicineToPrescription(med);
        }

        ToastService.ShowSuccess($"Added {toAdd.Count} medicine(s) to prescription.");
    }

    private string FormatDosage(OpPrescriptionDetailModel m)
    {
        var mVal = !string.IsNullOrWhiteSpace(m.morning_dose) && m.morning_dose != "0" ? m.morning_dose : (m.morning == "1" ? "1" : "0");
        var aVal = !string.IsNullOrWhiteSpace(m.afternoon_dose) && m.afternoon_dose != "0" ? m.afternoon_dose : (m.afternoon == "1" ? "1" : "0");
        var eVal = !string.IsNullOrWhiteSpace(m.evening_dose) && m.evening_dose != "0" ? m.evening_dose : (m.evening == "1" ? "1" : "0");
        var nVal = !string.IsNullOrWhiteSpace(m.night_dose) && m.night_dose != "0" ? m.night_dose : (m.night == "1" ? "1" : "0");
        return $"{mVal} - {aVal} - {eVal} - {nVal}";
    }

    private decimal GetLastVisitItemUnitPrice(OpPrescriptionDetailModel m)
    {
        if (m.mrp.HasValue && m.mrp.Value > 0)
        {
            return m.mrp.Value;
        }
        if (m.drug_code.HasValue && m.drug_code.Value > 0)
        {
            var master = allItems.FirstOrDefault(x => x.itemcode == (int)m.drug_code.Value);
            if (master != null)
            {
                var calculated = CalculateItemUnitCost(master);
                if (calculated > 0) return calculated;
            }
        }
        else if (!string.IsNullOrWhiteSpace(m.drug_name))
        {
            var master = allItems.FirstOrDefault(x => 
                (x.drugname != null && x.drugname.Equals(m.drug_name, StringComparison.OrdinalIgnoreCase)) ||
                (x.itemname != null && x.itemname.Equals(m.drug_name, StringComparison.OrdinalIgnoreCase)));
            if (master != null)
            {
                var calculated = CalculateItemUnitCost(master);
                if (calculated > 0) return calculated;
            }
        }
        if (m.rate.HasValue && m.rate.Value > 0)
        {
            return m.rate.Value;
        }
        return 0;
    }

    private decimal GetLastVisitItemTotalPrice(OpPrescriptionDetailModel m)
    {
        decimal unitPrice = GetLastVisitItemUnitPrice(m);
        decimal qty = (m.qty.HasValue && m.qty.Value > 0) ? m.qty.Value : 1m;
        return unitPrice * qty;
    }

