    private bool IsPreviewEmpty()
    {
        if (selectedPastVisitCaseSheet != null) return false;
        if (currentRequest == null) return true;
        
        if (!string.IsNullOrWhiteSpace(currentRequest.chief_complaint)) return false;
        if (!string.IsNullOrWhiteSpace(currentRequest.symptoms)) return false;
        if (!string.IsNullOrWhiteSpace(currentRequest.examination)) return false;
        if (!string.IsNullOrWhiteSpace(currentRequest.advise)) return false;
        if (!string.IsNullOrWhiteSpace(currentRequest.notes)) return false;
        if (!string.IsNullOrWhiteSpace(currentRequest.followup_notes)) return false;
        if (currentRequest.followup_date.HasValue) return false;

        if (currentRequest.symptom_list != null && currentRequest.symptom_list.Any()) return false;
        if (currentRequest.diagnosis_list != null && currentRequest.diagnosis_list.Any()) return false;
        if (currentRequest.prescription != null && currentRequest.prescription.items != null && currentRequest.prescription.items.Any()) return false;
        if (currentRequest.investigation != null && currentRequest.investigation.tests != null && currentRequest.investigation.tests.Any()) return false;

        if (activeVitals != null)
        {
            if (activeVitals.height_cm.HasValue && activeVitals.height_cm.Value > 0) return false;
            if (activeVitals.weight_kg.HasValue && activeVitals.weight_kg.Value > 0) return false;
            if (activeVitals.bp_systolic.HasValue && activeVitals.bp_systolic.Value > 0) return false;
            if (activeVitals.bp_diastolic.HasValue && activeVitals.bp_diastolic.Value > 0) return false;
            if (activeVitals.pulse_rate.HasValue && activeVitals.pulse_rate.Value > 0) return false;
            if (activeVitals.temperature_f.HasValue && activeVitals.temperature_f.Value > 0) return false;
            if (activeVitals.spo2.HasValue && activeVitals.spo2.Value > 0) return false;
            if (activeVitals.sugar_level.HasValue && activeVitals.sugar_level.Value > 0) return false;
            if (activeVitals.pain_scale.HasValue && activeVitals.pain_scale.Value > 0) return false;
            if (activeVitals.respiratory_rate.HasValue && activeVitals.respiratory_rate.Value > 0) return false;
            if (activeVitals.hba1c.HasValue && activeVitals.hba1c.Value > 0) return false;
            if (activeVitals.waist_cm.HasValue && activeVitals.waist_cm.Value > 0) return false;
            if (activeVitals.hip_cm.HasValue && activeVitals.hip_cm.Value > 0) return false;
            if (activeVitals.head_circumference_cm.HasValue && activeVitals.head_circumference_cm.Value > 0) return false;
            if (!string.IsNullOrWhiteSpace(activeVitals.allergy_notes)) return false;
        }

        return true;
    }

    private string GetSeverityClass(string severity)
    {
        return severity switch
        {
            "SEVERE" => "bg-danger text-white",
            "MODERATE" => "bg-warning text-dark",
            _ => "bg-success text-white"
        };
    }

    // --- Close & Modal Utilities ---
    private async Task CloseModal()
    {
        if (!isReadOnly && (currentRequest.chief_complaint != null || currentRequest.symptom_list.Count > 0 || currentRequest.diagnosis_list.Count > 0))
        {
            // Prompt for unsaved draft check
            var confirm = await ShowConfirmAsync(
                "You may have unsaved changes. Are you sure you want to close the Case Sheet workspace?",
                title: "Unsaved Changes",
                okText: "Yes, Close",
                okClass: "btn-warning",
                icon: "bi-exclamation-triangle-fill text-warning"
            );
            if (!confirm) return;
        }

        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    [Inject] private Microsoft.JSInterop.IJSRuntime JSRuntime { get; set; } = default!;
    [Inject] private SharedComponents.Rcl.Services.TenantSessionState TenantState { get; set; } = default!;
    [Inject] private IHttpClientFactory ClientFactory { get; set; } = default!;

    private bool printingCaseSheet = false;
    private bool hasViewRight = true;
    private bool hasPrintRight = true;

    private async Task PrintCaseSheetAsync()
    {
        if (!hasPrintRight)
        {
            ToastService.ShowError("You do not have permission to print Case Sheets.");
            return;
        }

        if (string.IsNullOrEmpty(currentRequest.sheet_id))
        {
            // Auto save draft first to obtain a sheet_id from backend
            var autoSaved = await SaveDraftAsyncInternal();
            if (!autoSaved || string.IsNullOrEmpty(currentRequest.sheet_id))
            {
                ToastService.ShowError("Please enter clinical details and save draft before printing.");
                return;
            }
        }
        try
        {
            printingCaseSheet = true;
            StateHasChanged();

            string url = $"https://medicoapi.iscansoft.com/api/report/getopcasesheet?sheet_id={currentRequest.sheet_id}&isletterhead=true";
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                url += $"&tenant_code={TenantState.TenantCode}";
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                url += $"&token={TenantState.AuthToken}";
                url += $"&auth_token={TenantState.AuthToken}";
            }

            using var client = ClientFactory.CreateClient("DoctorApi");
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }

            var resp = await client.GetAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                var raw = await resp.Content.ReadAsStringAsync();
                var base64 = raw.Trim().Trim('"');
                await JSRuntime.InvokeVoidAsync("openBase64Pdf", base64);
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to fetch Case Sheet PDF: {err}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Print error: {ex.Message}");
        }
        finally
        {
            printingCaseSheet = false;
            StateHasChanged();
        }
    }

    private bool showConfirmModal = false;
    private string confirmModalTitle = "Confirmation";
    private string confirmModalMessage = "";
    private string confirmModalIcon = "bi-shield-lock-fill text-warning";
    private string confirmModalOkText = "Confirm";
    private string confirmModalOkClass = "btn-primary-finalize";
    private System.Threading.Tasks.TaskCompletionSource<bool>? confirmTaskSource;

    private System.Threading.Tasks.Task<bool> ShowConfirmAsync(
        string message,
        string title = "Confirmation",
        string okText = "Confirm",
        string okClass = "btn-primary-finalize",
        string icon = "bi-exclamation-triangle-fill text-warning")
    {
        confirmModalTitle = title;
        confirmModalMessage = message;
        confirmModalOkText = okText;
        confirmModalOkClass = okClass;
        confirmModalIcon = icon;
        showConfirmModal = true;

        confirmTaskSource = new System.Threading.Tasks.TaskCompletionSource<bool>();
        StateHasChanged();
        return confirmTaskSource.Task;
    }

    private void OnConfirmResponse(bool result)
    {
        showConfirmModal = false;
        confirmTaskSource?.TrySetResult(result);
        StateHasChanged();
    }

    private async Task<bool> JSRuntimeConfirm(string message)
    {
        return await ShowConfirmAsync(
            message,
            title: "Confirm Action",
            okText: "Yes, Proceed",
            okClass: "btn-primary-finalize",
            icon: "bi-question-circle-fill text-primary"
        );
    }
