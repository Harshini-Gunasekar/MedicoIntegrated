    private void CalculateItemDrugQty(CaseSheetPrescriptionItem item)
    {
        if (item.days.HasValue)
        {
            decimal dailyCount = 0;
            if (decimal.TryParse(item.morning, out decimal m)) dailyCount += m;
            if (decimal.TryParse(item.afternoon, out decimal a)) dailyCount += a;
            if (decimal.TryParse(item.evening, out decimal e)) dailyCount += e;
            if (decimal.TryParse(item.night, out decimal n)) dailyCount += n;

            if (dailyCount > 0)
            {
                item.qty = dailyCount * item.days.Value;
            }
        }
    }

