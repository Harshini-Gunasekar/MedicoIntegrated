    }

    // --- Save Actions ---
    private void PrepareRequest()
    {
        // Bind remark caches into currentRequest
        if (currentRequest.prescription != null)
        {
            currentRequest.prescription.topremarks = prescriptionRemarks.topremarks;
            currentRequest.prescription.bottonremarks = prescriptionRemarks.bottonremarks;
        }

        if (currentRequest.investigation != null)
        {
            currentRequest.investigation.notes = investigationNotes;
            currentRequest.investigation.is_urgent = investigationMasterUrgent;
        }
    }

    private async Task<bool> SaveDraftAsyncInternal()
    {
        PrepareRequest();
        currentRequest.sheet_status = "DRAFT";

        savingData = true;
        StateHasChanged();
        var response = await CaseSheetService.SaveCaseSheetAsync(currentRequest);
        savingData = false;

        if (response.StartsWith("Error"))
        {
            ToastService.ShowError(response);
            return false;
        }

        // Successfully saved. Re-fetch to populate IDs.
        var reloaded = await CaseSheetService.GetCaseSheetByVisitAsync(OpId);
        rawLoadedSheet = reloaded;
        if (reloaded != null)
        {
            LoadFromViewModel(reloaded);
        }
        
        ToastService.ShowSuccess("Draft case sheet saved successfully.");
        await OnSaved.InvokeAsync();
        return true;
    }

    private async Task SaveDraftAsync()
    {
        await SaveDraftAsyncInternal();
    }

    private async Task FinalizeCaseSheetAsync()
    {
        var confirm = await JSRuntimeConfirm("Are you sure you want to Finalize this Case Sheet? Once finalized, the clinical record is LOCKED and cannot be edited. It will also dispense prescriptions to pharmacy and lab orders to diagnostics.");
        if (!confirm) return;

        // 1. First save as draft to ensure everything is written
        var draftSuccess = await SaveDraftAsyncInternal();
        if (!draftSuccess) return;

        // 2. Call Finalize API
        if (string.IsNullOrEmpty(currentRequest.sheet_id))
        {
            ToastService.ShowError("Could not finalize. Sheet ID not generated yet.");
            return;
        }

        savingData = true;
        var finalizeReq = new FinalizeCaseSheetRequest
        {
            sheet_id = currentRequest.sheet_id,
            is_consulted = true
        };

        var ok = await CaseSheetService.FinalizeCaseSheetAsync(finalizeReq);
        savingData = false;

        if (ok)
        {
            ToastService.ShowSuccess("Case sheet finalized and locked.");
            
            // Reload
            var reloaded = await CaseSheetService.GetCaseSheetByVisitAsync(OpId);
            rawLoadedSheet = reloaded;
            if (reloaded != null)
            {
                LoadFromViewModel(reloaded);
            }

            // Also update the registration's visit status locally/refresh the list
            await AppointmentBookingService.UpdateOpStatusAsync(OpId, "COMPLETED");

            await OnSaved.InvokeAsync();
        }
        else
        {
            ToastService.ShowError("Failed to finalize case sheet.");
        }
    }

    // --- Close & Modal Utilities ---
    private async Task CloseModal()
    {
        if (!isReadOnly && (currentRequest.chief_complaint != null || currentRequest.symptom_list.Count > 0 || currentRequest.diagnosis_list.Count > 0))
        {
            // Prompt for unsaved draft check
            var confirm = await JSRuntimeConfirm("You may have unsaved changes. Are you sure you want to close the Case Sheet workspace?");
            if (!confirm) return;
        }

        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    [Inject] private Microsoft.JSInterop.IJSRuntime JSRuntime { get; set; } = default!;

    private async Task<bool> JSRuntimeConfirm(string message)
    {
        try
        {
            return await JSRuntime.InvokeAsync<bool>("confirm", message);
        }
        catch
        {
            return true; // fallback if JS is not available/prerendering
        }
    }
