    private async Task DeletePrescriptionMasterAsync()
    {
        if (currentRequest.prescription != null && !string.IsNullOrEmpty(currentRequest.prescription.pr_code))
        {
            var confirm = await ShowConfirmAsync(
                "Are you sure you want to delete this entire prescription? This will clear the prescription code and delete detail lines from pharmacy registry.",
                title: "Delete Prescription",
                okText: "Yes, Delete",
                okClass: "btn-danger",
                icon: "bi-trash-fill text-danger"
            );
            if (confirm)
            {
                savingData = true;
                var prCodeToDelete = currentRequest.prescription.pr_code;
                var deleted = await CaseSheetService.DeletePrescriptionAsync(
                    prCodeToDelete, 
                    OpId != Guid.Empty ? OpId : null, 
                    IpId.HasValue && IpId.Value != Guid.Empty ? IpId.Value : null
                );

                if (deleted)
                {
                    if (activePrescription != null)
                    {
                        prescriptionsList.Remove(activePrescription);
                    }
                    if (prescriptionsList.Any())
                    {
                        SelectPrescriptionEntry(prescriptionsList.Last());
                    }
                    else
                    {
                        AddNewPrescriptionEntry();
                    }
                    if (rawLoadedSheet != null)
                    {
                        rawLoadedSheet.prescription = null;
                    }
                    hasPaidPharmacyBill = false;
                    pharmacyBillNo = "";
                    pharmacySalesCode = 0;

                    // Automatically save draft to synchronize case sheet record
                    await SaveDraftAsyncInternal();
                    savingData = false;
                    ToastService.ShowSuccess("Prescription deleted successfully.");
                    StateHasChanged();
                }
                else
                {
                    savingData = false;
                    ToastService.ShowError("Failed to delete prescription.");
                }
            }
        }
        else if (currentRequest.prescription != null)
        {
            if (activePrescription != null)
            {
                prescriptionsList.Remove(activePrescription);
            }
            if (prescriptionsList.Any())
            {
                SelectPrescriptionEntry(prescriptionsList.Last());
            }
            else
            {
                AddNewPrescriptionEntry();
            }
            if (rawLoadedSheet != null)
            {
                rawLoadedSheet.prescription = null;
            }
            hasPaidPharmacyBill = false;
            pharmacyBillNo = "";
            pharmacySalesCode = 0;
            ToastService.ShowSuccess("Prescription cleared successfully.");
            StateHasChanged();
        }
    }

