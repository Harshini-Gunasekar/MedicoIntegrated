    [Parameter] public string IpNo { get; set; } = string.Empty;
    [Parameter] public decimal CustId { get; set; }
    [Parameter] public int Dcode { get; set; }
    [Parameter] public string PatientName { get; set; } = string.Empty;
    [Parameter] public DateTime? VisitDate { get; set; }
    [Parameter] public string OpStatus { get; set; } = "WAITING";
    [Parameter] public string? InitialTab { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string activeTab = "notes";
    private bool loadingData = false;
    private bool savingData = false;
    private bool isConsulted = false;
    private bool isReadOnly => currentRequest.sheet_status == "FINAL";
    private bool IsIpPatient => (IpId.HasValue && IpId.Value != Guid.Empty) || !string.IsNullOrWhiteSpace(IpNo) || OpStatus == "ADMITTED" || OpStatus == "DISCHARGED";

    // Data forms
    private SaveCaseSheetRequest currentRequest = new();

    private void OnVisitingDoctorCheckboxChanged(ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        currentRequest.referred_to_visiting_doctor = isChecked;
        if (!isChecked)
        {
            currentRequest.visiting_doctor_name = null;
            isVisitingDoctorDropdownOpen = false;
        }
    }

    // Consultant Doctors for Visiting Doctor Autocomplete
    private List<DoctorMasterModel> consultantDoctorsList = new();
    private List<Booking.Models.DoctorSpecialtyMasterModel> doctorSpecialtiesList = new();
    private Dictionary<int, string> doctorSpecialtiesMap = new();
    private bool isVisitingDoctorDropdownOpen = false;
    private int highlightedVisitingDocIndex = -1;

    private void OnVisitingDoctorInput(ChangeEventArgs e)
    {
        currentRequest.visiting_doctor_name = e.Value?.ToString() ?? "";
        isVisitingDoctorDropdownOpen = !string.IsNullOrWhiteSpace(currentRequest.visiting_doctor_name);
        highlightedVisitingDocIndex = 0;
    }

    private void OnVisitingDoctorFocus()
    {
        if (!string.IsNullOrWhiteSpace(currentRequest.visiting_doctor_name))
        {
            isVisitingDoctorDropdownOpen = true;
            highlightedVisitingDocIndex = 0;
        }
    }

    private void OnVisitingDoctorKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown")
        {
            var count = GetFilteredConsultantDoctors().Count();
            if (count > 0)
            {
                highlightedVisitingDocIndex = (highlightedVisitingDocIndex + 1) % count;
                isVisitingDoctorDropdownOpen = true;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            var count = GetFilteredConsultantDoctors().Count();
            if (count > 0)
            {
                highlightedVisitingDocIndex = (highlightedVisitingDocIndex - 1 + count) % count;
                isVisitingDoctorDropdownOpen = true;
            }
        }
        else if (e.Key == "Enter" && isVisitingDoctorDropdownOpen)
        {
            var items = GetFilteredConsultantDoctors().ToList();
            if (items.Any() && highlightedVisitingDocIndex >= 0 && highlightedVisitingDocIndex < items.Count)
            {
                SelectVisitingDoctor(items[highlightedVisitingDocIndex]);
            }
        }
        else if (e.Key == "Escape")
        {
            isVisitingDoctorDropdownOpen = false;
        }
    }

    private void SelectVisitingDoctor(DoctorMasterModel doc)
    {
        var docName = string.IsNullOrWhiteSpace(doc.name) ? (doc.doctorfullname ?? "Doctor") : doc.name;
        var formattedName = docName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? docName : $"Dr. {docName}";
        currentRequest.visiting_doctor_name = formattedName;
        isVisitingDoctorDropdownOpen = false;
        StateHasChanged();
    }

    private IEnumerable<DoctorMasterModel> GetFilteredConsultantDoctors()
    {
        var list = consultantDoctorsList.Where(d => d.isconsultant == true && !d.deleted);
        var query = (currentRequest.visiting_doctor_name ?? "").Trim();
        if (!string.IsNullOrWhiteSpace(query))
        {
            var q = query.ToLower();
            list = list.Where(d =>
                (!string.IsNullOrWhiteSpace(d.name) && d.name.ToLower().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(d.doctorfullname) && d.doctorfullname.ToLower().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(d.shortname) && d.shortname.ToLower().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(d.qualification) && d.qualification.ToLower().Contains(q))
            );
        }
        return list;
    }

    private string GetDoctorSpecialty(DoctorMasterModel? doc)
    {
        if (doc == null || !doc.spcode.HasValue || doc.spcode.Value <= 0) return "";
        if (doctorSpecialtiesMap.TryGetValue(doc.spcode.Value, out var specName))
        {
            return specName;
        }
        var spec = doctorSpecialtiesList.FirstOrDefault(s => s.spcode == doc.spcode.Value);
        return spec?.name?.Trim() ?? "";
    }

    // Items being added
