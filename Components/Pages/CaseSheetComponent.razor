    private string GetUnbilledChargeDisplayName(UnbilledChargeSummary uc)
    {
        string displayItemName = uc.item_name;
        if (string.IsNullOrWhiteSpace(displayItemName))
        {
            if (uc.tcode.HasValue && uc.tcode.Value > 0)
            {
                var match = allTestMasters.FirstOrDefault(t => t.tcode == uc.tcode.Value);
                if (match != null && !string.IsNullOrWhiteSpace(match.name))
                {
                    return match.name;
                }
            }
            if (string.Equals(uc.entrytype, "CONSULTATION", StringComparison.OrdinalIgnoreCase))
                return "Consultation Charge";
            if (string.Equals(uc.entrytype, "ROOMRENT", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(uc.entrytype, "ROOM RENT", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(uc.entrytype, "ROOM_RENT", StringComparison.OrdinalIgnoreCase))
                return "Room Rent Charge";
            return "General Charge";
        }
        return displayItemName;
    }

    private string GetUnbilledTypeBadgeClass(string? entryType)
    {
        if (string.IsNullOrWhiteSpace(entryType)) return "badge-def";
        var t = entryType.Trim().ToUpperInvariant();
        if (t.Contains("INV")) return "badge-inv";
        if (t.Contains("OBS")) return "badge-obs";
        if (t.Contains("CON")) return "badge-con";
        if (t.Contains("ROOM")) return "badge-room";
        return "badge-def";
    }

    private string GetUnbilledKey(UnbilledChargeSummary uc)
    {
        if (!string.IsNullOrWhiteSpace(uc.unbilledid)) return uc.unbilledid;
        if (!string.IsNullOrWhiteSpace(uc.entryid)) return uc.entryid;
        return $"{uc.entrytype}_{uc.tcode}_{uc.chargedate?.Ticks}";
    }

    private void StartEditUnbilledCharge(UnbilledChargeSummary uc)
    {
        editingUnbilledId = GetUnbilledKey(uc);
        var effectiveId = !string.IsNullOrWhiteSpace(uc.unbilledid) ? uc.unbilledid : (uc.entryid ?? "");
        currentEditUnbilled = new UpdateUnbilledChargeRequest
        {
            unbilledid = effectiveId,
            quantity = uc.quantity ?? 1,
            rate = uc.rate ?? 0,
            amount = uc.amount ?? 0,
            discount = uc.discount ?? 0,
            charityamount = uc.charityamount ?? 0,
            tenant_code = currentTenantCode
        };
        CalculateEditUnbilledAmount();
        StateHasChanged();
    }

    private void CancelEditUnbilledCharge()
    {
        editingUnbilledId = "";
        currentEditUnbilled = new();
        StateHasChanged();
    }

    private void CalculateEditUnbilledAmount()
    {
        var qty = currentEditUnbilled.quantity ?? 1;
        var rate = currentEditUnbilled.rate ?? 0;
        var discount = currentEditUnbilled.discount ?? 0;
        var charity = currentEditUnbilled.charityamount ?? 0;
        currentEditUnbilled.amount = Math.Max(0, (qty * rate) - discount - charity);
    }

    private async Task SaveUnbilledChargeUpdateAsync()
    {
        if (string.IsNullOrWhiteSpace(currentEditUnbilled.unbilledid)) return;

        savingUnbilledCharge = true;
        StateHasChanged();

        CalculateEditUnbilledAmount();
        if (string.IsNullOrEmpty(currentEditUnbilled.tenant_code))
        {
            currentEditUnbilled.tenant_code = await GetCurrentTenantCodeAsync();
        }

        var payloadJson = System.Text.Json.JsonSerializer.Serialize(currentEditUnbilled, new System.Text.Json.JsonSerializerOptions 
        { 
            DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull,
            WriteIndented = true 
        });

        Console.WriteLine("=================================================");
        Console.WriteLine("[CaseSheetComponent] Updating Unbilled Charge Payload:");
        Console.WriteLine(payloadJson);
        Console.WriteLine("=================================================");

        var success = await HmsBillingService.UpdateUnbilledChargeAsync(currentEditUnbilled);
        savingUnbilledCharge = false;

        if (success)
        {
            ToastService.ShowSuccess("Unbilled charge updated successfully.");
            
            // Sync updated rate into currentRequest.investigation.tests
            var targetUnbilled = unbilledChargesList.FirstOrDefault(u => u.unbilledid == currentEditUnbilled.unbilledid);
            if (currentRequest.investigation?.tests != null)
            {
                var matchingTest = currentRequest.investigation.tests.FirstOrDefault(t => 
                    (targetUnbilled != null && t.test_code.HasValue && targetUnbilled.tcode.HasValue && t.test_code.Value == targetUnbilled.tcode.Value) ||
                    (targetUnbilled != null && !string.IsNullOrWhiteSpace(t.test_name) && !string.IsNullOrWhiteSpace(targetUnbilled.item_name) && t.test_name.Equals(targetUnbilled.item_name, StringComparison.OrdinalIgnoreCase)));
                
                if (matchingTest != null)
                {
                    if (currentEditUnbilled.rate.HasValue) matchingTest.rate = (decimal)currentEditUnbilled.rate.Value;
                    if (currentEditUnbilled.quantity.HasValue && currentEditUnbilled.quantity.Value > 0) matchingTest.quantity = (decimal)currentEditUnbilled.quantity.Value;
                    matchingTest.amount = (decimal)(currentEditUnbilled.amount ?? ((currentEditUnbilled.rate ?? 0) * (currentEditUnbilled.quantity ?? 1)));
                }
            }

            editingUnbilledId = "";
            currentEditUnbilled = new();
            await LoadUnbilledChargesAsync();
        }
        else
        {
            ToastService.ShowError("Failed to update unbilled charge.");
        }
        StateHasChanged();
    }

    private bool showDiscardConfirmModal = false;
    private UnbilledChargeSummary? chargeToDiscard = null;
    private bool isDiscardingCharge = false;

    private void PromptDiscardUnbilledCharge(UnbilledChargeSummary uc)
    {
        if (uc == null || string.IsNullOrWhiteSpace(uc.unbilledid)) return;
        chargeToDiscard = uc;
        showDiscardConfirmModal = true;
    }

    private void CancelDiscardChargeModal()
    {
        if (isDiscardingCharge) return;
        showDiscardConfirmModal = false;
        chargeToDiscard = null;
    }

    private async Task ConfirmDiscardUnbilledChargeAsync()
    {
        if (chargeToDiscard == null || string.IsNullOrWhiteSpace(chargeToDiscard.unbilledid))
        {
            CancelDiscardChargeModal();
            return;
        }

        var uc = chargeToDiscard;
        try
        {
            isDiscardingCharge = true;
            StateHasChanged();

            var result = await HmsBillingService.DiscardUnbilledChargeAsync(uc.unbilledid);
            if (result != null && result.discarded > 0)
            {
                ToastService.ShowSuccess("Unbilled charge discarded successfully.");
                showDiscardConfirmModal = false;
                chargeToDiscard = null;
                await LoadUnbilledChargesAsync();
            }
            else if (result != null && result.skipped != null && result.skipped.Count > 0)
            {
                var reason = result.skipped[0].reason;
                ToastService.ShowWarning($"Could not discard: {reason}");
            }
            else
            {
                ToastService.ShowError("Failed to discard unbilled charge.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error discarding charge: {ex.Message}");
        }
        finally
        {
            isDiscardingCharge = false;
            StateHasChanged();
        }
    }

