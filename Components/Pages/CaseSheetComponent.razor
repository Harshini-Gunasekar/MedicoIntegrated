@using Booking.Models
@using Booking.Services
@using Booking.Helpers
@using LabCare.Services
@using LabCare.Models
@using medico_backend.Model
@using Medico_Backend.Model
@inject CaseSheetService CaseSheetService
@inject AppointmentBookingService AppointmentBookingService
@inject ToastService ToastService
@inject LabCare.Services.TestService LabCareTestService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<style>
    .dosage-btn {
        width: 100%;
        text-align: center;
        background: #ffffff;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        padding: 0.5rem 0.2rem;
        font-size: 0.85rem;
        font-weight: 700;
        color: #64748b;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .dosage-btn:hover:not(.active) {
        background: #f1f5f9;
        color: #1e293b;
        border-color: #cbd5e1;
    }
    .dosage-btn.active {
        background: #0284c7 !important;
        color: #ffffff !important;
        border-color: #0284c7 !important;
        box-shadow: 0 4px 10px rgba(2, 132, 199, 0.2);
    }
</style>

@if (Visible)
{
    <div class="casesheet-backdrop" @onclick="CloseModal">
        <div class="casesheet-modal" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div class="casesheet-header">
                <div class="header-patient-info">
                    <div class="patient-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="patient-meta">
                        <h2 class="patient-title">
                            @(string.IsNullOrWhiteSpace(PatientName) ? "Walk-in Patient" : PatientName)
                            <span class="patient-id-badge">CUST-@CustId</span>
                            @if (!string.IsNullOrEmpty(currentRequest.sheet_id))
                            {
                                <span class="status-badge @(currentRequest.sheet_status?.ToLower())">
                                    @currentRequest.sheet_status
                                </span>
                            }
                            else
                            {
                                <span class="status-badge draft">NEW CASE SHEET</span>
                            }
                        </h2>
                        <span class="patient-sub">
                            Visit Date: @(VisitDate?.ToString("dd-MMM-yyyy") ?? DateTime.Today.ToString("dd-MMM-yyyy"))
                            @if (!string.IsNullOrEmpty(OpNo))
                            {
                                <span> | OP No: @OpNo</span>
                            }
                        </span>
                    </div>
                </div>

                <div class="header-actions">
                    <button class="btn-close-modal" @onclick="CloseModal">×</button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="casesheet-body">
                @if (loadingData)
                {
                    <div style="flex: 1; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                        <span class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem; margin-bottom: 1rem;"></span>
                        <h4 style="color: var(--primary-color); font-weight: 700;">Loading Clinical Workspace...</h4>
                    </div>
                }
                else
                {
                    <!-- Workspace Left (Clinical Entries) -->
                    <div class="workspace-left">
                        <!-- Tab Navigation -->
                        <div class="tabs-container">
                            <button class="tab-btn @(activeTab == "notes" ? "active" : "")" @onclick='() => SetTab("notes")'>
                                <i class="bi bi-file-earmark-medical"></i> Clinical Notes
                            </button>
                            <button class="tab-btn @(activeTab == "vitals" ? "active" : "")" @onclick='() => SetTab("vitals")'>
                                <i class="bi bi-heart-pulse"></i> Vitals
                            </button>
                            <button class="tab-btn @(activeTab == "symptoms" ? "active" : "")" @onclick='() => SetTab("symptoms")'>
                                <i class="bi bi-activity"></i> Symptoms
                            </button>
                            <button class="tab-btn @(activeTab == "diagnosis" ? "active" : "")" @onclick='() => SetTab("diagnosis")'>
                                <i class="bi bi-clipboard2-pulse"></i> Diagnosis (ICD-10)
                            </button>
                            <button class="tab-btn @(activeTab == "prescription" ? "active" : "")" @onclick='() => SetTab("prescription")'>
                                <i class="bi bi-capsule"></i> Prescription
                            </button>
                            <button class="tab-btn @(activeTab == "investigation" ? "active" : "")" @onclick='() => SetTab("investigation")'>
                                <i class="bi bi-flask"></i> Investigations
                            </button>
                            <button class="tab-btn @(activeTab == "history" ? "active" : "")" @onclick='() => SetTab("history")'>
                                <i class="bi bi-clock-history"></i> Patient History
                            </button>
                        </div>

                        <!-- Tab Content Areas -->
                        <div class="tab-content">
                            @if (activeTab == "notes")
                            {
                                <div class="notes-tab-form">
                                    <div class="form-grid-2">
                                        <div class="form-group">
                                            <label class="form-label">Chief Complaint</label>
                                            <textarea class="form-control-textarea" placeholder="Enter patient's primary complaint..." 
                                                      @bind="currentRequest.chief_complaint" @bind:event="oninput" disabled="@isReadOnly"></textarea>
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Symptoms (Free text / Legacy support)</label>
                                            <textarea class="form-control-textarea" placeholder="Enter symptom details..." 
                                                      @bind="currentRequest.symptoms" @bind:event="oninput" disabled="@isReadOnly"></textarea>
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Clinical Examination Details</label>
                                            <textarea class="form-control-textarea" placeholder="Write physical exam findings..." 
                                                      @bind="currentRequest.examination" @bind:event="oninput" disabled="@isReadOnly"></textarea>
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Advise / Recommendations</label>
                                            <textarea class="form-control-textarea" placeholder="Add doctor advise..." 
                                                      @bind="currentRequest.advise" @bind:event="oninput" disabled="@isReadOnly"></textarea>
                                        </div>
                                        <div class="form-group full-width">
                                            <label class="form-label">General Clinical Notes</label>
                                            <textarea class="form-control-textarea" placeholder="Add any additional notes..." 
                                                      @bind="currentRequest.notes" @bind:event="oninput" disabled="@isReadOnly"></textarea>
                                        </div>
                                    </div>

                                    <hr style="margin: 1.5rem 0; border: 0; border-top: 1px dashed #cbd5e1;" />

                                    <h4 style="color: var(--primary-color); font-weight: 800; font-size: 0.95rem; text-transform: uppercase; margin-bottom: 1rem;">
                                        Follow Up Visit
                                    </h4>
                                    <div class="form-grid-3">
                                        <div class="form-group">
                                            <label class="form-label">Follow-up Date</label>
                                            <input type="date" class="form-control-input" @bind="currentRequest.followup_date" disabled="@isReadOnly" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Follow-up Notes</label>
                                            <input type="text" class="form-control-input" placeholder="e.g., Review lab reports" 
                                                   @bind="currentRequest.followup_notes" @bind:event="oninput" disabled="@isReadOnly" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Referred to IP</label>
                                            <div style="display: flex; align-items: center; gap: 0.6rem; height: 38px; padding: 0 0.75rem; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                                                <input type="checkbox" id="chkReferToIp" class="form-check-input" style="width: 1.15rem; height: 1.15rem; cursor: pointer; margin: 0;"
                                                       @bind="currentRequest.refer_to_ip" disabled="@isReadOnly" />
                                                <label for="chkReferToIp" style="font-size: 0.83rem; font-weight: 700; color: #(currentRequest.refer_to_ip ? "0369a1" : "475569"); cursor: pointer; margin: 0; user-select: none;">
                                                    @(currentRequest.refer_to_ip ? "Yes (Referred to IPD)" : "No")
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (activeTab == "vitals")
                            {
                                <div class="vitals-tab-form">
                                    

                                    @if (loadingVitals)
                                    {
                                        <div style="text-align: center; padding: 2rem;">
                                            <span class="spinner-border text-primary"></span>
                                        </div>
                                    }
                                    else if (activeVitals == null)
                                    {
                                        <div style="color: #94a3b8; text-align: center; font-size: 0.9rem; padding: 2rem 0;">
                                            Initializing vitals data...
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="vitals-redesign-container">
                                            <!-- Section 1: Basic Vitals -->
                                            <div class="vitals-tab-section">
                                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem;">
                                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                                        <h5 class="vitals-section-title" style="margin: 0;">Basic Vitals</h5>
                                                        @if (vitalsList != null && vitalsList.Any())
                                                        {
                                                            <span class="badge" style="background: #e2e8f0; color: #334155; font-size: 0.75rem; font-weight: 700; border-radius: 6px; padding: 0.25rem 0.5rem;">
                                                                @vitalsList.Count Recorded
                                                            </span>
                                                        }
                                                    </div>
                                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                                        @if (!isReadOnly)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-primary" style="font-size: 0.78rem; font-weight: 700; border-radius: 6px; padding: 0.35rem 0.85rem; display: flex; align-items: center; gap: 0.35rem; background: #0284c7; border: none; box-shadow: 0 1px 2px rgba(0,0,0,0.1);" @onclick="AddNewVitalsEntry">
                                                                <i class="bi bi-plus-circle-fill"></i> Add New Vitals
                                                            </button>
                                                        }
                                                    </div>
                                                </div>

                                                @if (vitalsList != null && vitalsList.Count > 0)
                                                {
                                                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid #e2e8f0; align-items: center;">
                                                        <span style="font-size: 0.72rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-right: 0.25rem; display: flex; align-items: center; gap: 0.25rem;">
                                                            <i class="bi bi-clock-history"></i> Select Entry:
                                                        </span>
                                                        @for (int i = 0; i < vitalsList.Count; i++)
                                                        {
                                                            var vItem = vitalsList[i];
                                                            int entryIndex = i + 1;
                                                            bool isSelected = (activeVitals == vItem);
                                                            string timeStr = (vItem.created_at != default) ? (DateTimeHelper.ConvertUtcToIst(vItem.created_at)?.ToString("hh:mm tt") ?? "") : $"Entry #{entryIndex}";
                                                            <button type="button" 
                                                                    class="btn btn-sm @(isSelected ? "btn-dark" : "btn-outline-secondary")" 
                                                                    style="font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.65rem; border-radius: 6px; display: flex; align-items: center; gap: 0.35rem;"
                                                                    @onclick="() => SelectVitalsEntry(vItem)">
                                                                <span>Entry #@entryIndex (@timeStr)</span>
                                                                @if (vItem.bp_systolic.HasValue && vItem.bp_diastolic.HasValue)
                                                                {
                                                                    <span style="opacity: 0.85; font-size: 0.7rem; background: rgba(255,255,255,0.2); padding: 0.1rem 0.3rem; border-radius: 4px;">BP:@vItem.bp_systolic/@vItem.bp_diastolic</span>
                                                                }
                                                            </button>
                                                        }
                                                        @if (isEditingVitals == false)
                                                        {
                                                            <span class="badge bg-success" style="font-size: 0.72rem; padding: 0.35rem 0.65rem; font-weight: 700; display: flex; align-items: center; gap: 0.25rem;">
                                                                <i class="bi bi-pencil-fill"></i> New Entry (Unsaved)
                                                            </span>
                                                        }
                                                    </div>
                                                }

                                                <div class="vitals-grid-4-cols">
                                                    <div class="form-group">
                                                        <label>Height</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.height_cm" @bind:after="CalculateBMI" placeholder="-" disabled="@isReadOnly" />
                                                            <span class="vital-unit">cm</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Weight</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.weight_kg" @bind:after="CalculateBMI" placeholder="-" disabled="@isReadOnly" />
                                                            <span class="vital-unit">kg</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>BMI</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input readonly-input" @bind="activeVitals.bmi" placeholder="-" readonly />
                                                            <span class="vital-unit">bmi</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Temp</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.temperature_f" placeholder="-" disabled="@isReadOnly" />
                                                            <span class="vital-unit">°F</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>BP Systolic</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.bp_systolic" placeholder="-" disabled="@isReadOnly" />
                                                            <span class="vital-unit">mmHg</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>BP Diastolic</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.bp_diastolic" placeholder="-" disabled="@isReadOnly" />
                                                            <span class="vital-unit">mmHg</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Pulse</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.pulse_rate" placeholder="-" disabled="@isReadOnly" />
                                                            <span class="vital-unit">bpm</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>SpO2</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.spo2" placeholder="-" disabled="@isReadOnly" />
                                                            <span class="vital-unit">%</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Sugar Level</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.sugar_level" placeholder="-" disabled="@isReadOnly" />
                                                            <span class="vital-unit">mg/dL</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Pain Scale</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.pain_scale" min="0" max="10" placeholder="0-10" disabled="@isReadOnly" />
                                                            <span class="vital-unit">/10</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Resp Rate</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.respiratory_rate" placeholder="-" disabled="@isReadOnly" />
                                                            <span class="vital-unit">rpm</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>HbA1c</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.hba1c" placeholder="-" disabled="@isReadOnly" />
                                                            <span class="vital-unit">%</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Waist</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.waist_cm" placeholder="-" disabled="@isReadOnly" />
                                                            <span class="vital-unit">cm</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Hip</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.hip_cm" placeholder="-" disabled="@isReadOnly" />
                                                            <span class="vital-unit">cm</span>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Head Circ</label>
                                                        <div class="vital-input-wrapper">
                                                            <input type="number" class="form-control-input" @bind="activeVitals.head_circumference_cm" placeholder="-" disabled="@isReadOnly" />
                                                            <span class="vital-unit">cm</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="form-group vitals-allergy-group">
                                                    <label>Allergy Notes / Chief Complaint</label>
                                                    <textarea class="form-control-textarea" @bind="activeVitals.allergy_notes" @bind:event="oninput" rows="2" placeholder="Enter detailed clinical notes, allergies or Chief Complaint here..." disabled="@isReadOnly"></textarea>
                                                </div>
                                            </div>

                                            <!-- Section 2: Clinical Exam -->
                                            <div class="vitals-tab-section">
                                                    <div class="vitals-section-header-flex" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                                                        <h5 class="vitals-section-title" style="margin: 0;">Clinical Exam</h5>
                                                        @if (!isReadOnly)
                                                        {
                                                            <div class="toggle-wrapper">
                                                                <span class="toggle-label" style="font-size: 0.68rem; font-weight: 700; color: #64748b;">MARK ALL NORMAL</span>
                                                                <label class="switch">
                                                                    <input type="checkbox" @bind="allNormalToggle" @bind:after="ToggleAllNormal">
                                                                    <span class="slider round"></span>
                                                                </label>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="vitals-grid-3-cols">
                                                        <div class="form-group">
                                                            <label>Pedal Oedema</label>
                                                            <input type="text" class="form-control-input" @bind="activeVitals.pedal_oedema" placeholder="-" disabled="@isReadOnly" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>JVP</label>
                                                            <input type="text" class="form-control-input" @bind="activeVitals.jvp" placeholder="-" disabled="@isReadOnly" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>CVS</label>
                                                            <input type="text" class="form-control-input" @bind="activeVitals.cvs" placeholder="-" disabled="@isReadOnly" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>RS</label>
                                                            <input type="text" class="form-control-input" @bind="activeVitals.rs" placeholder="-" disabled="@isReadOnly" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>CNS</label>
                                                            <input type="text" class="form-control-input" @bind="activeVitals.cns" placeholder="-" disabled="@isReadOnly" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Abdomen</label>
                                                            <input type="text" class="form-control-input" @bind="activeVitals.abdomen" placeholder="-" disabled="@isReadOnly" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Section 3: Investigations & History -->
                                                <div class="vitals-tab-section">
                                                    <h5 class="vitals-section-title">Investigations & History</h5>
                                                    <div class="vitals-grid-3-cols">
                                                        <div class="form-group">
                                                            <label>Cardiac Monitor</label>
                                                            <input type="text" class="form-control-input" @bind="activeVitals.cardiac_monitor" placeholder="-" disabled="@isReadOnly" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>CD Echo</label>
                                                            <input type="text" class="form-control-input" @bind="activeVitals.cd_echo" placeholder="-" disabled="@isReadOnly" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Blood Chemistry</label>
                                                            <input type="text" class="form-control-input" @bind="activeVitals.blood_chemistry" placeholder="-" disabled="@isReadOnly" />
                                                        </div>
                                                        <div class="form-group" style="grid-column: span 3;">
                                                            <label>ECG Notes</label>
                                                            <input type="text" class="form-control-input" @bind="activeVitals.ecg_notes" placeholder="Enter ECG description..." disabled="@isReadOnly" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        <div class="vitals-tab-footer" style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed #e2e8f0;">
                                            <div class="d-flex align-items-center" style="gap: 0.5rem;">
                                                <label style="font-weight: 700; color: #475569; margin: 0; font-size: 0.75rem; text-transform: uppercase;">Pass The DoctorName</label>
                                                <!-- <input type="text" class="form-control-input" @bind="activeVitals.entered_by" placeholder="Nurse / Doctor name" style="max-width: 200px;" disabled="@isReadOnly" /> -->
                                            </div>
                                            <div>
                                                @if (!isReadOnly)
                                                {
                                                    <button class="btn-add-item" style="height: 38px; padding: 0 1.5rem;" @onclick="SubmitTabVitalsAsync" disabled="@savingVitals">
                                                        @if (savingVitals)
                                                        {
                                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                                            <span>Saving...</span>
                                                        }
                                                        else
                                                        {
                                                            <span><i class="bi bi-save"></i> Save Vitals</span>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (activeTab == "symptoms")
                            {
                                <div class="symptoms-tab-form">
                                    @if (!isReadOnly)
                                    {
                                        <div class="symptoms-row-layout" style="display: flex; gap: 0.75rem; align-items: flex-end; margin-bottom: 1.25rem; width: 100%;">
                                            <div class="form-group" style="flex: 2;">
                                                <label class="form-label">Symptom Text</label>
                                                <input type="text" class="form-control-input" placeholder="e.g., Fever, headache" @bind="newSymptom.symptom_text" />
                                            </div>
                                            <div class="form-group" style="flex: 1.2;">
                                                <label class="form-label">Duration</label>
                                                <input type="text" class="form-control-input" placeholder="e.g., 3 days, 1 week" @bind="newSymptom.duration" />
                                            </div>
                                            <div class="form-group" style="flex: 1.2;">
                                                <label class="form-label">Severity</label>
                                                <select class="form-control-select" @bind="newSymptom.severity">
                                                    <option value="MILD">Mild</option>
                                                    <option value="MODERATE">Moderate</option>
                                                    <option value="SEVERE">Severe</option>
                                                </select>
                                            </div>
                                            <div class="form-group" style="flex: 3.5;">
                                                <label class="form-label">Notes</label>
                                                <input type="text" class="form-control-input" placeholder="Add notes for this symptom..." @bind="newSymptom.notes" />
                                            </div>
                                            <button class="btn-add-item" @onclick="AddSymptomItem" style="margin-bottom: 0; flex-shrink: 0;">
                                                <i class="bi bi-plus"></i> Add Symptom
                                            </button>
                                        </div>
                                    }

                                    <!-- Structured Symptoms List -->
                                    <div class="structured-table-card">
                                        <table class="structured-table">
                                            <thead>
                                                <tr>
                                                    <th style="width: 60px;">S.No</th>
                                                    <th>Symptom</th>
                                                    <th>Duration</th>
                                                    <th>Severity</th>
                                                    <th>Notes</th>
                                                    @if (!isReadOnly)
                                                    {
                                                        <th style="width: 60px; text-align: center;">Action</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (currentRequest.symptom_list.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="@(isReadOnly ? 5 : 6)" style="text-align: center; color: #94a3b8; padding: 2rem;">
                                                            No structured symptoms added yet.
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var sym in currentRequest.symptom_list)
                                                    {
                                                        <tr>
                                                            <td>@sym.sno</td>
                                                            <td style="font-weight: 700;">@sym.symptom_text</td>
                                                            <td>@sym.duration</td>
                                                            <td>
                                                                <span class="severity-pill @sym.severity?.ToLower()">@sym.severity</span>
                                                            </td>
                                                            <td>@sym.notes</td>
                                                            @if (!isReadOnly)
                                                            {
                                                                <td style="text-align: center;">
                                                                    <button class="btn-remove-item" @onclick="() => RemoveSymptomItem(sym)">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                            else if (activeTab == "diagnosis")
                            {
                                <div class="diagnosis-tab-form">
                                    <!-- Structured Diagnosis List -->
                                    <div class="structured-table-card overflow-visible">
                                        <table class="structured-table">
                                            <thead>
                                                <tr>
                                                    <th class="col-diag-sno">S.No</th>
                                                    <th class="col-diag-code">Diagnosis (ICD-10)</th>
                                                    <th class="col-diag-custom">Custom Text</th>
                                                    <th class="col-diag-type">Type</th>
                                                    <th class="col-diag-cond">Condition</th>
                                                    <th class="col-diag-sev">Severity</th>
                                                    <th class="col-diag-status">Status</th>
                                                    @if (!isReadOnly)
                                                    {
                                                        <th class="col-diag-act">Action</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (currentRequest.diagnosis_list.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="@(isReadOnly ? 8 : 9)" style="text-align: center; color: #94a3b8; padding: 2rem;">
                                                            No structured diagnoses added yet. Click '+ Add Diagnosis' below to add.
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var diag in currentRequest.diagnosis_list)
                                                    {
                                                        <tr>
                                                            <td class="col-diag-sno">@diag.sno</td>
                                                            @if (!isReadOnly)
                                                            {
                                                                <td class="col-diag-code">
                                                                    <input type="text" class="form-control-input table-input" placeholder="Search ICD-10..."
                                                                           value="@(!string.IsNullOrEmpty(diag.icd_code) ? $"{diag.icd_code} - {diag.icd_description}" : diag.icd_description)"
                                                                           @oninput="@(e => SearchIcdInline(diag, e.Value?.ToString() ?? ""))" />
                                                                    @if (activeInlineDiagSno == diag.sno && inlineIcdSearchResults.Count > 0)
                                                                    {
                                                                        <div class="inline-dropdown">
                                                                            @foreach (var res in inlineIcdSearchResults)
                                                                            {
                                                                                <div class="autocomplete-item" @onclick="() => SelectInlineIcdCode(diag, res)">
                                                                                    <span class="autocomplete-code">@res.icd_code</span>
                                                                                    <span>@res.icd_description</span>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </td>
                                                                <td class="col-diag-custom">
                                                                    <input type="text" class="form-control-input table-input" placeholder="Custom text..." @bind="diag.diagnosis_text" />
                                                                </td>
                                                                <td class="col-diag-type">
                                                                    <select class="form-control-select table-input" @bind="diag.diagnosis_type">
                                                                        <option value="PRIMARY">Primary</option>
                                                                        <option value="SECONDARY">Secondary</option>
                                                                        <option value="COMORBIDITY">Comorbidity</option>
                                                                    </select>
                                                                </td>
                                                                <td class="col-diag-cond">
                                                                    <select class="form-control-select table-input" @bind="diag.condition_type">
                                                                        <option value="ACUTE">Acute</option>
                                                                        <option value="CHRONIC">Chronic</option>
                                                                        <option value="FOLLOWUP">Follow Up</option>
                                                                    </select>
                                                                </td>
                                                                <td class="col-diag-sev">
                                                                    <select class="form-control-select table-input" @bind="diag.severity">
                                                                        <option value="MILD">Mild</option>
                                                                        <option value="MODERATE">Moderate</option>
                                                                        <option value="SEVERE">Severe</option>
                                                                    </select>
                                                                </td>
                                                                <td class="col-diag-status">
                                                                    <select class="form-control-select table-input" @bind="diag.status">
                                                                        <option value="ACTIVE">Active</option>
                                                                        <option value="RESOLVED">Resolved</option>
                                                                        <option value="ONGOING">Ongoing</option>
                                                                    </select>
                                                                </td>
                                                                <td class="col-diag-act">
                                                                    <button class="btn-remove-item" @onclick="() => RemoveDiagnosisItem(diag)" title="Remove item" style="margin: 0 auto;">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td class="col-diag-code">
                                                                    <div style="font-weight: 500; color: var(--secondary-color);">@diag.icd_code</div>
                                                                    <div style="font-size: 0.75rem; color: #475569;">@diag.icd_description</div>
                                                                </td>
                                                                <td class="col-diag-custom">@diag.diagnosis_text</td>
                                                                <td class="col-diag-type"><span class="badge bg-light text-dark font-weight-bold" style="font-size: 0.72rem;">@diag.diagnosis_type</span></td>
                                                                <td class="col-diag-cond">@diag.condition_type</td>
                                                                <td class="col-diag-sev">
                                                                    <span class="severity-pill @diag.severity?.ToLower()">@diag.severity</span>
                                                                </td>
                                                                <td class="col-diag-status">
                                                                    <span class="badge bg-success" style="font-size: 0.72rem;">@diag.status</span>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                                @if (!isReadOnly)
                                                {
                                                    <tr>
                                                        <td colspan="9" style="text-align: center; padding: 0.75rem; border-bottom: none;">
                                                            <button type="button" class="btn-add-medicine-dashed" @onclick="AddNewDiagnosisRow">
                                                                <i class="bi bi-plus-circle-fill"></i> Add Diagnosis
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                            else if (activeTab == "prescription")
                            {
                                <div class="prescription-tab-form">
                                    <!-- Prescription Master Details (Remarks) -->
                                    <div class="form-grid-2 mb-3">
                                        <div class="form-group">
                                            <label class="form-label">Top Remarks (Dispensing Instructions)</label>
                                            <input type="text" class="form-control-input" placeholder="e.g. Take all medicines after food" 
                                                   @bind="prescriptionRemarks.topremarks" disabled="@isReadOnly" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Bottom Remarks</label>
                                            <input type="text" class="form-control-input" placeholder="e.g. Review after 5 days if no improvement" 
                                                   @bind="prescriptionRemarks.bottonremarks" disabled="@isReadOnly" />
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(currentRequest.prescription?.pr_code))
                                    {
                                        <div style="background:#e0f2fe; padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid #bae6fd; font-size: 0.85rem; color:#0369a1; font-weight:700; margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
                                            <span>Active Prescription Reference: @currentRequest.prescription.pr_code</span>
                                            @if (!isReadOnly)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" style="font-weight:700; border-radius:6px; font-size:0.75rem;" @onclick="DeletePrescriptionMasterAsync">
                                                    <i class="bi bi-trash"></i> Delete Prescription
                                                </button>
                                            }
                                        </div>
                                    }

                                    <!-- Prescription Details Table -->
                                    <div class="structured-table-card overflow-visible">
                                        <table class="structured-table">
                                            <thead>
                                                <tr>
                                                    <th class="col-sno">S.No</th>
                                                    <th class="col-drug">Drug Name</th>
                                                    <th class="col-generic">Generic Name</th>
                                                    <th class="col-dosage">Dosage</th>
                                                    <th class="col-timing">Timing</th>
                                                   
                                                    <th class="col-days">Days</th>
                                                    <th class="col-qty">Qty</th>
                                                    
                                                    <th class="col-instructions">Instructions</th>
                                                    @if (!isReadOnly)
                                                    {
                                                        <th class="col-action">Action</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (currentRequest.prescription == null || currentRequest.prescription.items.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="@(isReadOnly ? 8 : 9)" style="text-align: center; color: #94a3b8; padding: 2rem;">
                                                            No medications prescribed in this session. Click '+ Add Medicine' below to prescribe.
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var item in currentRequest.prescription.items)
                                                    {
                                                        <tr>
                                                            <td class="col-sno">@item.sno</td>
                                                            @if (!isReadOnly)
                                                            {
                                                                <td class="col-drug">
                                                                    <input type="text" class="form-control-input table-input" placeholder="e.g. Paracetamol 500mg"
                                                                           value="@item.drug_name"
                                                                           @oninput="@(e => SearchDrugInline(item, e.Value?.ToString() ?? ""))" />
                                                                    @if (activeInlineDrugSno == item.sno && inlineDrugSearchResults.Count > 0)
                                                                    {
                                                                        <div class="inline-dropdown">
                                                                            @foreach (var res in inlineDrugSearchResults)
                                                                            {
                                                                                <div class="autocomplete-item" @onclick="() => SelectInlineDrugCode(item, res)">
                                                                                    <span class="autocomplete-code">@res.itemcode</span>
                                                                                    <span>@(string.IsNullOrWhiteSpace(res.drugname) ? res.itemname : res.drugname)</span>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </td>
                                                                <td class="col-generic">
                                                                    <input type="text" class="form-control-input table-input" placeholder="e.g. Acetaminophen" @bind="item.generic_name" />
                                                                </td>
                                                                <td class="col-dosage">
                                                                    <div class="dosage-grid-inline">
                                                                        <button type="button" class="dosage-btn-sm @(item.morning == "1" ? "active" : "")" @onclick='() => ToggleItemDosage(item, "morning")' title="Morning">M</button>
                                                                        <button type="button" class="dosage-btn-sm @(item.afternoon == "1" ? "active" : "")" @onclick='() => ToggleItemDosage(item, "afternoon")' title="Afternoon">A</button>
                                                                        <button type="button" class="dosage-btn-sm @(item.evening == "1" ? "active" : "")" @onclick='() => ToggleItemDosage(item, "evening")' title="Evening">E</button>
                                                                        <button type="button" class="dosage-btn-sm @(item.night == "1" ? "active" : "")" @onclick='() => ToggleItemDosage(item, "night")' title="Night">N</button>
                                                                    </div>
                                                                </td>
                                                                <td class="col-timing">
                                                                    <select class="form-control-select table-input" value="@GetFoodTiming(item)" @onchange="@(e => { SetFoodTiming(item, e.Value?.ToString() ?? ""); CalculateItemDrugQty(item); })">
                                                                        <option value="">-- None --</option>
                                                                        <option value="BEFORE">Before Food (AC)</option>
                                                                        <option value="AFTER">After Food (PC)</option>
                                                                    </select>
                                                                </td>
                                                                
                                                                <td class="col-days">
                                                                    <input type="number" class="form-control-input table-input" placeholder="Days" @bind="item.days" @bind:after="() => CalculateItemDrugQty(item)" />
                                                                </td>
                                                                <td class="col-qty">
                                                                    <input type="number" class="form-control-input table-input" placeholder="Qty" @bind="item.qty" />
                                                                </td>
                                                                
                                                                <td class="col-instructions">
                                                                    <input type="text" class="form-control-input table-input" placeholder="Instructions" @bind="item.notes" />
                                                                </td>
                                                                <td class="col-action">
                                                                    <button class="btn-remove-item" @onclick="() => RemovePrescriptionItem(item)" title="Remove item" style="margin: 0 auto;">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td class="col-drug" style="font-weight: 700; color:#0f172a;">@item.drug_name</td>
                                                                <td class="col-generic">@item.generic_name</td>
                                                                <td class="col-dosage">
                                                                    <span class="badge bg-light text-dark fw-bold">@item.morning - @item.afternoon - @item.evening - @item.night</span>
                                                                </td>
                                                                <td class="col-timing">
                                                                    @if (item.before_food) { <span class="badge bg-warning text-dark me-1">AC (Before)</span> }
                                                                    @if (item.after_food) { <span class="badge bg-info text-dark">PC (After)</span> }
                                                                </td>
                                                               
                                                                <td class="col-days" style="font-weight:600;">@item.days Days</td>
                                                                <td class="col-qty" style="font-weight:800; color:var(--primary-color);">@item.qty</td>
                                                                <td class="col-instructions">@item.notes</td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                                @if (!isReadOnly)
                                                {
                                                    <tr>
                                                        <td colspan="9" style="text-align: center; padding: 0.75rem; border-bottom: none; background-color: #f8fafc;">
                                                            <button type="button" class="btn-add-medicine-dashed" @onclick="AddNewPrescriptionRow">
                                                                <i class="bi bi-plus-circle-fill"></i> Add Medicine
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                            else if (activeTab == "investigation")
                            {
                                <div class="investigations-tab-form">

                                    <!-- Investigation Master Details -->
                                    

                                    @if (currentRequest.investigation != null && !string.IsNullOrEmpty(currentRequest.investigation.inv_id))
                                    {
                                        <div style="background:#e0f2fe; padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid #bae6fd; font-size: 0.85rem; color:#0369a1; font-weight:700; margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
                                            <span>Active Investigation ID: @currentRequest.investigation.inv_id (Urgent: @(currentRequest.investigation.is_urgent ? "YES" : "NO"))</span>
                                            @if (!isReadOnly)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" style="font-weight:700; border-radius:6px; font-size:0.75rem;" @onclick="DeleteInvestigationMasterAsync">
                                                    <i class="bi bi-trash"></i> Delete Investigation
                                                </button>
                                            }
                                        </div>
                                    }

                                    <!-- Investigation List and Result Entry -->
                                    <div class="structured-table-card overflow-visible">
                                        <table class="structured-table">
                                            <thead>
                                                <tr>
                                                    <th class="col-inv-sno">S.No</th>
                                                    <th class="col-inv-name">Test Name</th>
                                                    <th class="col-inv-ref">Ref ID</th>
                                                    <th class="col-inv-status">Status</th>
                                                    <th class="col-inv-results">Results & Notes</th>
                                                    @if (!isReadOnly)
                                                    {
                                                        <th class="col-inv-act">Action</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (currentRequest.investigation == null || currentRequest.investigation.tests.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="@(isReadOnly ? 5 : 6)" style="text-align: center; color: #94a3b8; padding: 2rem;">
                                                            No laboratory or diagnostic tests ordered. Click '+ Add Test Order' below to add.
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var test in currentRequest.investigation.tests)
                                                    {
                                                        var savedDetail = GetSavedInvestigationDetail(test.sno);
                                                        <tr>
                                                            <td class="col-inv-sno">@test.sno</td>
                                                            <td class="col-inv-name">
                                                                @if (!isReadOnly && string.IsNullOrEmpty(test.diag_id) && savedDetail == null)
                                                                {
                                                                    <input type="text" class="form-control-input table-input" placeholder="Test Name (e.g. CBC)"
                                                                           value="@test.test_name"
                                                                           @oninput="@(e => SearchTestInline(test, e.Value?.ToString() ?? ""))" />
                                                                    @if (activeInlineTestSno == test.sno && inlineTestSearchResults.Count > 0)
                                                                    {
                                                                        <div class="inline-dropdown">
                                                                            @foreach (var res in inlineTestSearchResults)
                                                                            {
                                                                                <div class="autocomplete-item" @onclick="() => SelectInlineTestCode(test, res)">
                                                                                    <span class="autocomplete-code">T-@res.tcode</span>
                                                                                    <span>@res.name</span>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <span style="font-weight: 700; color:#0f172a;">@test.test_name</span>
                                                                }
                                                            </td>
                                                            
                                                            <td class="col-inv-ref">
                                                                @if (!string.IsNullOrEmpty(test.diag_id))
                                                                {
                                                                    <span class="badge bg-light text-primary border">@test.diag_id</span>
                                                                }
                                                                else
                                                                {
                                                                    <span>-</span>
                                                                }
                                                            </td>
                                                            <td class="col-inv-status">
                                                                @if (savedDetail != null)
                                                                {
                                                                    <span class="badge @(savedDetail.result_status == "COMPLETED" ? "bg-success" : "bg-warning text-dark")">
                                                                        @savedDetail.result_status
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-secondary">ORDERED</span>
                                                                }
                                                            </td>
                                                            <td class="col-inv-results">
                                                                @if (savedDetail != null)
                                                                {
                                                                    @if (savedDetail.result_status == "COMPLETED")
                                                                    {
                                                                        <div style="font-size: 0.8rem;">
                                                                            <strong>Value:</strong> @savedDetail.result_value <br />
                                                                            <strong>Notes:</strong> @savedDetail.result_notes <br />
                                                                            <span class="text-muted" style="font-size:0.7rem;">Date: @savedDetail.result_date?.ToString("dd-MMM-yyyy")</span>
                                                                        </div>
                                                                    }
                                                                    else if (!isReadOnly)
                                                                    {
                                                                        <div class="result-input-box">
                                                                            <input type="text" class="form-control-input" style="height:28px; font-size:0.75rem; padding: 0.2rem 0.5rem;"
                                                                                   placeholder="Result value..." @bind="savedDetail.result_value" />
                                                                            <input type="text" class="form-control-input" style="height:28px; font-size:0.75rem; padding: 0.2rem 0.5rem;"
                                                                                   placeholder="Result notes..." @bind="savedDetail.result_notes" />
                                                                            <button class="btn-save-result" @onclick="() => SaveTestResultAsync(savedDetail)">
                                                                                Submit Result
                                                                            </button>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted">No results entered</span>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted small">Save draft to enable result tracking</span>
                                                                }
                                                            </td>
                                                            @if (!isReadOnly)
                                                            {
                                                                <td class="col-inv-act">
                                                                    <button class="btn-remove-item" @onclick="() => RemoveInvestigationItem(test)" style="margin: 0 auto;">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                                @if (!isReadOnly)
                                                {
                                                    <tr>
                                                        <td colspan="6" style="text-align: center; padding: 0.75rem; border-bottom: none; background-color: #f8fafc;">
                                                            <button type="button" class="btn-add-medicine-dashed" @onclick="AddNewInvestigationRow">
                                                                <i class="bi bi-plus-circle-fill"></i> Add Test Order
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        @if (!isReadOnly)
                                        {
                                            <div style="padding: 0.75rem 1rem; background: #f8fafc; border-top: 1px solid #cbd5e1; display: flex; justify-content: flex-end;">
                                                <label class="food-checkbox-label" style="margin: 0; font-size: 0.8rem; font-weight: 600; color: #475569; display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer;">
                                                    <input type="checkbox" @bind="investigationMasterUrgent" style="cursor: pointer;" /> Mark Investigation Ordered as URGENT
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else if (activeTab == "history")
                            {
                                <div class="patient-history-tab">
                                    @if (loadingHistory)
                                    {
                                        <div style="text-align: center; padding: 2rem;">
                                            <span class="spinner-border text-primary" role="status"></span>
                                            <p class="text-muted mt-2">Fetching patient visit logs...</p>
                                        </div>
                                    }
                                    else if (patientHistory.Count == 0)
                                    {
                                        <div style="text-align: center; padding: 3rem; color: #94a3b8;">
                                            <i class="bi bi-clock-history" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;"></i>
                                            <h5>No Medical History Found</h5>
                                            <p>This appears to be the patient's first recorded visit in this clinic.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="history-timeline">
                                            @foreach (var hist in patientHistory)
                                            {
                                                <div class="history-card">
                                                    <div class="history-header">
                                                        <span class="history-date">Visit Date: @hist.visit_date?.ToString("dd-MMM-yyyy")</span>
                                                        <span class="history-doc">Consulted Code: @hist.dcode</span>
                                                    </div>

                                                    @if (!string.IsNullOrEmpty(hist.chief_complaint))
                                                    {
                                                        <div class="history-block">
                                                            <div class="history-block-label">Chief Complaint</div>
                                                            <div class="history-block-content">@hist.chief_complaint</div>
                                                        </div>
                                                    }

                                                    @if (hist.diagnosis_list.Count > 0)
                                                    {
                                                        <div class="history-block">
                                                            <div class="history-block-label">Diagnosis</div>
                                                            <div class="history-block-content">
                                                                <ul style="margin: 0; padding-left: 1.2rem;">
                                                                    @foreach (var diag in hist.diagnosis_list)
                                                                    {
                                                                        <li>
                                                                            <strong>@diag.icd_code</strong> - @diag.icd_description
                                                                            @if (!string.IsNullOrEmpty(diag.diagnosis_text)) { <span> (@diag.diagnosis_text)</span> }
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    }

                                                    @if (hist.prescription != null && hist.prescription.items.Count > 0)
                                                    {
                                                        <div class="history-block">
                                                            <div class="history-block-label">Prescribed Medicines</div>
                                                            <div class="history-block-content">
                                                                @string.Join(", ", hist.prescription.items.Select(i => $"{i.drug_name} ({i.morning}-{i.afternoon}-{i.evening}-{i.night}) for {i.days}d"))
                                                            </div>
                                                        </div>
                                                    }

                                                    @if (hist.investigation != null && hist.investigation.tests.Count > 0)
                                                    {
                                                        <div class="history-block">
                                                            <div class="history-block-label">Investigations Ordered</div>
                                                            <div class="history-block-content">
                                                                @string.Join(", ", hist.investigation.tests.Select(t => t.test_name))
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <!-- History Pagination -->
                                        <div class="history-pagination">
                                            <button class="btn-pagination" @onclick="PrevHistoryPage" disabled="@(historyPage <= 1)">
                                                <i class="bi bi-chevron-left"></i>
                                            </button>
                                            <span class="pagination-info">Page @historyPage</span>
                                            <button class="btn-pagination" @onclick="NextHistoryPage" disabled="@(patientHistory.Count < historyPageSize)">
                                                <i class="bi bi-chevron-right"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Workspace Right (Vitals Sidebar) -->
                    <div class="workspace-right">


                        <!-- Live Preview Card -->
                        <div class="preview-card">
                            <div class="vitals-card-title" style="display: flex; justify-content: space-between; align-items: center;">
                                <span><i class="bi bi-file-earmark-medical text-primary"></i> Case Sheet Preview</span>
                                @if (selectedPastVisitCaseSheet != null)
                                {
                                    <span class="preview-badge-history" style="background: #fef3c7; color: #b45309; border: 1px solid #fef3c7; font-size: 0.65rem; font-weight: 700; padding: 0.15rem 0.4rem; border-radius: 4px; text-transform: uppercase;">Past Visit</span>
                                }
                                else
                                {
                                    <span class="preview-badge-live">Live</span>
                                }
                            </div>
                            
                            <div class="preview-content-scroll">
                                @if (selectedPastVisitCaseSheet != null)
                                {
                                    <div class="preview-content-wrapper" style="display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.8rem; color: #334155;">
                                        <!-- Warning banner indicating past visit -->
                                        <div style="background: #fffbeb; border: 1px solid #fef3c7; color: #b45309; padding: 0.5rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; display: flex; justify-content: space-between; align-items: center;">
                                            <span>Viewing past visit from @(selectedPastVisitCaseSheet.visit_date?.ToString("dd-MMM-yyyy") ?? "")</span>
                                            <button style="border: none; background: none; color: #b45309; text-decoration: underline; cursor: pointer; font-size: 0.7rem;" @onclick="RestoreActiveVisitCaseSheet">Show Live</button>
                                        </div>

                                        <!-- Patient / Date Info -->
                                        <div style="font-size: 0.72rem; color: #64748b; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; display: flex; justify-content: space-between;">
                                            <span>Patient: <strong>@PatientName</strong></span>
                                            <span>Date: <strong>@(selectedPastVisitCaseSheet.visit_date?.ToString("dd-MMM-yyyy") ?? "")</strong></span>
                                        </div>

                                        <!-- Vitals Summary -->
                                        @if (selectedPastVisitVitals != null && (
                                            (selectedPastVisitVitals.height_cm.HasValue && selectedPastVisitVitals.height_cm > 0) || 
                                            (selectedPastVisitVitals.weight_kg.HasValue && selectedPastVisitVitals.weight_kg > 0) ||
                                            (selectedPastVisitVitals.bp_systolic.HasValue && selectedPastVisitVitals.bp_systolic > 0) ||
                                            (selectedPastVisitVitals.bp_diastolic.HasValue && selectedPastVisitVitals.bp_diastolic > 0) ||
                                            (selectedPastVisitVitals.pulse_rate.HasValue && selectedPastVisitVitals.pulse_rate > 0) ||
                                            (selectedPastVisitVitals.temperature_f.HasValue && selectedPastVisitVitals.temperature_f > 0) ||
                                            (selectedPastVisitVitals.spo2.HasValue && selectedPastVisitVitals.spo2 > 0) ||
                                            (selectedPastVisitVitals.sugar_level.HasValue && selectedPastVisitVitals.sugar_level > 0) ||
                                            (selectedPastVisitVitals.pain_scale.HasValue && selectedPastVisitVitals.pain_scale > 0) ||
                                            (selectedPastVisitVitals.respiratory_rate.HasValue && selectedPastVisitVitals.respiratory_rate > 0) ||
                                            (selectedPastVisitVitals.hba1c.HasValue && selectedPastVisitVitals.hba1c > 0) ||
                                            (selectedPastVisitVitals.waist_cm.HasValue && selectedPastVisitVitals.waist_cm > 0) ||
                                            (selectedPastVisitVitals.hip_cm.HasValue && selectedPastVisitVitals.hip_cm > 0) ||
                                            (selectedPastVisitVitals.head_circumference_cm.HasValue && selectedPastVisitVitals.head_circumference_cm > 0) ||
                                            !string.IsNullOrWhiteSpace(selectedPastVisitVitals.allergy_notes)
                                        ))
                                        {
                                            <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem;">
                                                <div style="font-weight: 800; color: #b45309; font-size: 0.7rem; text-transform: uppercase; margin-bottom: 0.25rem;">Patient Vitals</div>
                                                <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; font-size: 0.75rem;">
                                                    @if (selectedPastVisitVitals.height_cm.HasValue && selectedPastVisitVitals.height_cm > 0) { <span class="preview-vital-badge">Ht: @selectedPastVisitVitals.height_cm CM</span> }
                                                    @if (selectedPastVisitVitals.weight_kg.HasValue && selectedPastVisitVitals.weight_kg > 0) { <span class="preview-vital-badge">Wt: @selectedPastVisitVitals.weight_kg KG</span> }
                                                    @if (selectedPastVisitVitals.bmi.HasValue && selectedPastVisitVitals.bmi > 0) { <span class="preview-vital-badge">BMI: @selectedPastVisitVitals.bmi</span> }
                                                    @if (selectedPastVisitVitals.temperature_f.HasValue && selectedPastVisitVitals.temperature_f > 0) { <span class="preview-vital-badge">Temp: @selectedPastVisitVitals.temperature_f °F</span> }
                                                    @if (selectedPastVisitVitals.bp_systolic.HasValue && selectedPastVisitVitals.bp_systolic > 0 && selectedPastVisitVitals.bp_diastolic.HasValue && selectedPastVisitVitals.bp_diastolic > 0) { <span class="preview-vital-badge">BP: @selectedPastVisitVitals.bp_systolic/@selectedPastVisitVitals.bp_diastolic mmHg</span> }
                                                    @if (selectedPastVisitVitals.pulse_rate.HasValue && selectedPastVisitVitals.pulse_rate > 0) { <span class="preview-vital-badge">Pulse: @selectedPastVisitVitals.pulse_rate bpm</span> }
                                                    @if (selectedPastVisitVitals.spo2.HasValue && selectedPastVisitVitals.spo2 > 0) { <span class="preview-vital-badge">SpO2: @selectedPastVisitVitals.spo2 %</span> }
                                                    @if (selectedPastVisitVitals.sugar_level.HasValue && selectedPastVisitVitals.sugar_level > 0) { <span class="preview-vital-badge">Sugar: @selectedPastVisitVitals.sugar_level mg/dL</span> }
                                                    @if (selectedPastVisitVitals.pain_scale.HasValue && selectedPastVisitVitals.pain_scale > 0) { <span class="preview-vital-badge">Pain: @selectedPastVisitVitals.pain_scale/10</span> }
                                                    @if (selectedPastVisitVitals.respiratory_rate.HasValue && selectedPastVisitVitals.respiratory_rate > 0) { <span class="preview-vital-badge">Resp: @selectedPastVisitVitals.respiratory_rate rpm</span> }
                                                    @if (selectedPastVisitVitals.hba1c.HasValue && selectedPastVisitVitals.hba1c > 0) { <span class="preview-vital-badge">HbA1c: @selectedPastVisitVitals.hba1c %</span> }
                                                    @if (selectedPastVisitVitals.waist_cm.HasValue && selectedPastVisitVitals.waist_cm > 0) { <span class="preview-vital-badge">Waist: @selectedPastVisitVitals.waist_cm CM</span> }
                                                    @if (selectedPastVisitVitals.hip_cm.HasValue && selectedPastVisitVitals.hip_cm > 0) { <span class="preview-vital-badge">Hip: @selectedPastVisitVitals.hip_cm CM</span> }
                                                    @if (selectedPastVisitVitals.head_circumference_cm.HasValue && selectedPastVisitVitals.head_circumference_cm > 0) { <span class="preview-vital-badge">Head: @selectedPastVisitVitals.head_circumference_cm CM</span> }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(selectedPastVisitVitals.allergy_notes))
                                                {
                                                    <div style="margin-top: 0.35rem; font-size: 0.72rem; color: #dc2626; font-weight: 600;">
                                                        <strong>Allergies / Complaints:</strong> @selectedPastVisitVitals.allergy_notes
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <!-- Chief Complaint & Notes -->
                                        @if (!string.IsNullOrWhiteSpace(selectedPastVisitCaseSheet.chief_complaint) || 
                                             !string.IsNullOrWhiteSpace(selectedPastVisitCaseSheet.symptoms) || 
                                             !string.IsNullOrWhiteSpace(selectedPastVisitCaseSheet.examination) || 
                                             !string.IsNullOrWhiteSpace(selectedPastVisitCaseSheet.notes))
                                        {
                                            <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem; display: flex; flex-direction: column; gap: 0.3rem;">
                                                <div style="font-weight: 800; color: #b45309; font-size: 0.7rem; text-transform: uppercase;">Clinical Notes</div>
                                                @if (!string.IsNullOrWhiteSpace(selectedPastVisitCaseSheet.chief_complaint))
                                                {
                                                    <div style="font-size: 0.75rem;"><strong>Chief Complaint:</strong> @selectedPastVisitCaseSheet.chief_complaint</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(selectedPastVisitCaseSheet.symptoms))
                                                {
                                                    <div style="font-size: 0.75rem;"><strong>Symptoms (Notes):</strong> @selectedPastVisitCaseSheet.symptoms</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(selectedPastVisitCaseSheet.examination))
                                                {
                                                    <div style="font-size: 0.75rem;"><strong>Examination:</strong> @selectedPastVisitCaseSheet.examination</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(selectedPastVisitCaseSheet.notes))
                                                {
                                                    <div style="font-size: 0.75rem;"><strong>General Notes:</strong> @selectedPastVisitCaseSheet.notes</div>
                                                }
                                            </div>
                                        }

                                        <!-- Symptoms List -->
                                        @if (selectedPastVisitCaseSheet.symptom_list != null && selectedPastVisitCaseSheet.symptom_list.Any())
                                        {
                                            <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem;">
                                                <div style="font-weight: 800; color: #b45309; font-size: 0.7rem; text-transform: uppercase; margin-bottom: 0.25rem;">Structured Symptoms</div>
                                                <ul style="margin: 0; padding-left: 1.1rem; font-size: 0.75rem; line-height: 1.4;">
                                                    @foreach (var sym in selectedPastVisitCaseSheet.symptom_list)
                                                    {
                                                        <li>
                                                            <strong>@sym.symptom_text</strong> 
                                                            @if (!string.IsNullOrWhiteSpace(sym.duration)) { <span>(@sym.duration)</span> }
                                                            @if (!string.IsNullOrWhiteSpace(sym.notes)) { <span style="display: block; font-size: 0.7rem; color: #64748b;">Notes: @sym.notes</span> }
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }

                                        <!-- Diagnosis -->
                                        @if (selectedPastVisitCaseSheet.diagnosis_list != null && selectedPastVisitCaseSheet.diagnosis_list.Any())
                                        {
                                            <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem;">
                                                <div style="font-weight: 800; color: #b45309; font-size: 0.7rem; text-transform: uppercase; margin-bottom: 0.25rem;">Diagnosis</div>
                                                <ul style="margin: 0; padding-left: 1.1rem; font-size: 0.75rem; list-style-type: square; line-height: 1.4;">
                                                    @foreach (var diag in selectedPastVisitCaseSheet.diagnosis_list)
                                                    {
                                                        <li>
                                                            @if (!string.IsNullOrWhiteSpace(diag.icd_code))
                                                            {
                                                                <span style="font-family: monospace; color: #0369a1; font-weight: bold; background: #e0f2fe; padding: 0.05rem 0.25rem; border-radius: 4px;">@diag.icd_code</span>
                                                            }
                                                            <span> @(diag.icd_description ?? diag.diagnosis_text)</span>
                                                            @if (!string.IsNullOrWhiteSpace(diag.diagnosis_type)) { <span style="font-size: 0.65rem; color: #64748b; font-weight: 700; margin-left: 0.25rem;">[@diag.diagnosis_type]</span> }
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }

                                        <!-- Prescription -->
                                        @if (selectedPastVisitCaseSheet.prescription != null && selectedPastVisitCaseSheet.prescription.items != null && selectedPastVisitCaseSheet.prescription.items.Any())
                                        {
                                            <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem;">
                                                <div style="font-weight: 800; color: #b45309; font-size: 0.7rem; text-transform: uppercase; margin-bottom: 0.25rem;">Prescribed Medicines</div>
                                                <table style="width: 100%; font-size: 0.75rem; border-collapse: collapse;">
                                                    <thead>
                                                        <tr style="border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.65rem; text-align: left;">
                                                            <th style="padding: 0.2rem 0;">Drug</th>
                                                            <th style="padding: 0.2rem 0; text-align: center;">Frequency</th>
                                                            <th style="padding: 0.2rem 0; text-align: center;">Duration</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in selectedPastVisitCaseSheet.prescription.items)
                                                        {
                                                            <tr style="border-bottom: 1px dashed #f1f5f9;">
                                                                <td style="padding: 0.25rem 0;">
                                                                    <strong>@item.drug_name</strong>
                                                                    @if (!string.IsNullOrWhiteSpace(item.notes)) { <span style="display: block; font-size: 0.65rem; color: #64748b;">@item.notes</span> }
                                                                </td>
                                                                <td style="padding: 0.25rem 0; text-align: center; font-family: monospace;">
                                                                    @item.morning-@item.afternoon-@item.evening-@item.night 
                                                                    <span style="display: block; font-size: 0.62rem; color: #94a3b8;">(@(item.before_food ? "Before Food" : "After Food"))</span>
                                                                </td>
                                                                <td style="padding: 0.25rem 0; text-align: center;">@item.days Days</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }

                                        <!-- Investigation tests -->
                                        @if (selectedPastVisitCaseSheet.investigation != null && selectedPastVisitCaseSheet.investigation.tests != null && selectedPastVisitCaseSheet.investigation.tests.Any())
                                        {
                                            <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem;">
                                                <div style="font-weight: 800; color: #b45309; font-size: 0.7rem; text-transform: uppercase; margin-bottom: 0.25rem;">Investigations</div>
                                                <ul style="margin: 0; padding-left: 1.1rem; font-size: 0.75rem; list-style-type: circle; line-height: 1.4;">
                                                    @foreach (var test in selectedPastVisitCaseSheet.investigation.tests)
                                                    {
                                                        <li>
                                                            <strong>@test.test_name</strong> 
                                                            @if (test.quantity > 1) { <span style="color: #64748b;">(Qty: @test.quantity)</span> }
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }

                                        <!-- Doctor Advise & Follow-up Notes -->
                                        @if (!string.IsNullOrWhiteSpace(selectedPastVisitCaseSheet.advise) || 
                                             !string.IsNullOrWhiteSpace(selectedPastVisitCaseSheet.followup_notes) || 
                                             selectedPastVisitCaseSheet.followup_date.HasValue)
                                        {
                                            <div style="padding-top: 0.25rem; display: flex; flex-direction: column; gap: 0.25rem;">
                                                @if (!string.IsNullOrWhiteSpace(selectedPastVisitCaseSheet.advise))
                                                {
                                                    <div style="font-size: 0.75rem;"><strong>Advise:</strong> @selectedPastVisitCaseSheet.advise</div>
                                                }
                                                @if (selectedPastVisitCaseSheet.followup_date.HasValue || !string.IsNullOrWhiteSpace(selectedPastVisitCaseSheet.followup_notes))
                                                {
                                                    <div style="font-size: 0.75rem; background: #fffbeb; border: 1px solid #fef3c7; border-radius: 6px; padding: 0.35rem; color: #b45309; font-weight: 600;">
                                                        <i class="bi bi-calendar-event"></i> Follow-up: 
                                                        @if (selectedPastVisitCaseSheet.followup_date.HasValue) { <span>@selectedPastVisitCaseSheet.followup_date.Value.ToString("dd-MMM-yyyy")</span> }
                                                        @if (!string.IsNullOrWhiteSpace(selectedPastVisitCaseSheet.followup_notes)) { <span> - @selectedPastVisitCaseSheet.followup_notes</span> }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else if (IsPreviewEmpty())
                                {
                                    <div class="preview-empty-state">
                                        <i class="bi bi-pencil-square" style="font-size: 1.5rem; display: block; margin-bottom: 0.5rem; opacity: 0.5;"></i>
                                        Start entering clinical details to generate the live preview...
                                    </div>
                                }
                                else
                                {
                                    <div class="preview-content-wrapper" style="display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.8rem; color: #334155;">
                                    <!-- Patient / Date Info -->
                                    <div style="font-size: 0.72rem; color: #64748b; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; display: flex; justify-content: space-between;">
                                        <span>Patient: <strong>@PatientName</strong></span>
                                        <span>Date: <strong>@(VisitDate?.ToString("dd-MMM-yyyy") ?? DateTime.Today.ToString("dd-MMM-yyyy"))</strong></span>
                                    </div>

                                    <!-- Vitals Summary -->
                                    @if ((vitalsList != null && vitalsList.Any(v => HasAnyVitalsData(v))) || HasAnyVitalsData(activeVitals))
                                    {
                                        var displayList = new List<OPRegistrationModel.PatientVitalsModel>();
                                        if (vitalsList != null && vitalsList.Any())
                                        {
                                            displayList.AddRange(vitalsList.Where(v => HasAnyVitalsData(v)));
                                        }
                                        if (activeVitals != null && !displayList.Contains(activeVitals) && HasAnyVitalsData(activeVitals))
                                        {
                                            displayList.Add(activeVitals);
                                        }

                                        <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem;">
                                            <div style="font-weight: 800; color: #0284c7; font-size: 0.7rem; text-transform: uppercase; margin-bottom: 0.35rem;">
                                                Patient Vitals @(displayList.Count > 1 ? $"({displayList.Count} Recordings)" : "")
                                            </div>
                                            @foreach (var vItem in displayList)
                                            {
                                                <div style="margin-bottom: 0.4rem; padding: 0.35rem 0.5rem; background: #f8fafc; border-radius: 6px; border-left: 3px solid #0284c7;">
                                                    @if (vItem.created_at != default && displayList.Count > 1)
                                                    {
                                                        <div style="font-size: 0.68rem; font-weight: 700; color: #64748b; margin-bottom: 0.15rem;">@DateTimeHelper.ConvertUtcToIst(vItem.created_at)?.ToString("dd-MMM hh:mm tt")</div>
                                                    }
                                                    <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; font-size: 0.75rem;">
                                                        @if (vItem.height_cm.HasValue && vItem.height_cm > 0) { <span class="preview-vital-badge">Ht: @vItem.height_cm CM</span> }
                                                        @if (vItem.weight_kg.HasValue && vItem.weight_kg > 0) { <span class="preview-vital-badge">Wt: @vItem.weight_kg KG</span> }
                                                        @if (vItem.bmi.HasValue && vItem.bmi > 0) { <span class="preview-vital-badge">BMI: @vItem.bmi</span> }
                                                        @if (vItem.temperature_f.HasValue && vItem.temperature_f > 0) { <span class="preview-vital-badge">Temp: @vItem.temperature_f °F</span> }
                                                        @if (vItem.bp_systolic.HasValue && vItem.bp_systolic > 0 && vItem.bp_diastolic.HasValue && vItem.bp_diastolic > 0) { <span class="preview-vital-badge">BP: @vItem.bp_systolic/@vItem.bp_diastolic mmHg</span> }
                                                        @if (vItem.pulse_rate.HasValue && vItem.pulse_rate > 0) { <span class="preview-vital-badge">Pulse: @vItem.pulse_rate bpm</span> }
                                                        @if (vItem.spo2.HasValue && vItem.spo2 > 0) { <span class="preview-vital-badge">SpO2: @vItem.spo2 %</span> }
                                                        @if (vItem.sugar_level.HasValue && vItem.sugar_level > 0) { <span class="preview-vital-badge">Sugar: @vItem.sugar_level mg/dL</span> }
                                                        @if (vItem.pain_scale.HasValue && vItem.pain_scale > 0) { <span class="preview-vital-badge">Pain: @vItem.pain_scale/10</span> }
                                                        @if (vItem.respiratory_rate.HasValue && vItem.respiratory_rate > 0) { <span class="preview-vital-badge">Resp: @vItem.respiratory_rate rpm</span> }
                                                        @if (vItem.hba1c.HasValue && vItem.hba1c > 0) { <span class="preview-vital-badge">HbA1c: @vItem.hba1c %</span> }
                                                        @if (vItem.waist_cm.HasValue && vItem.waist_cm > 0) { <span class="preview-vital-badge">Waist: @vItem.waist_cm CM</span> }
                                                        @if (vItem.hip_cm.HasValue && vItem.hip_cm > 0) { <span class="preview-vital-badge">Hip: @vItem.hip_cm CM</span> }
                                                        @if (vItem.head_circumference_cm.HasValue && vItem.head_circumference_cm > 0) { <span class="preview-vital-badge">Head: @vItem.head_circumference_cm CM</span> }
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(vItem.allergy_notes))
                                                    {
                                                        <div style="margin-top: 0.25rem; font-size: 0.72rem; color: #dc2626; font-weight: 600;">
                                                            <strong>Allergies / Complaints:</strong> @vItem.allergy_notes
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- Chief Complaint & Notes -->
                                    @if (!string.IsNullOrWhiteSpace(currentRequest.chief_complaint) || 
                                         !string.IsNullOrWhiteSpace(currentRequest.symptoms) || 
                                         !string.IsNullOrWhiteSpace(currentRequest.examination) || 
                                         !string.IsNullOrWhiteSpace(currentRequest.notes))
                                    {
                                        <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem; display: flex; flex-direction: column; gap: 0.3rem;">
                                            <div style="font-weight: 800; color: #0284c7; font-size: 0.7rem; text-transform: uppercase;">Clinical Notes</div>
                                            @if (!string.IsNullOrWhiteSpace(currentRequest.chief_complaint))
                                            {
                                                <div style="font-size: 0.75rem;"><strong>Chief Complaint:</strong> @currentRequest.chief_complaint</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(currentRequest.symptoms))
                                            {
                                                <div style="font-size: 0.75rem;"><strong>Symptoms (Notes):</strong> @currentRequest.symptoms</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(currentRequest.examination))
                                            {
                                                <div style="font-size: 0.75rem;"><strong>Examination:</strong> @currentRequest.examination</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(currentRequest.notes))
                                            {
                                                <div style="font-size: 0.75rem;"><strong>General Notes:</strong> @currentRequest.notes</div>
                                            }
                                        </div>
                                    }

                                    <!-- Symptoms List -->
                                    @if (currentRequest.symptom_list != null && currentRequest.symptom_list.Any())
                                    {
                                        <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem;">
                                            <div style="font-weight: 800; color: #0284c7; font-size: 0.7rem; text-transform: uppercase; margin-bottom: 0.25rem;">Structured Symptoms</div>
                                            <ul style="margin: 0; padding-left: 1.1rem; font-size: 0.75rem; line-height: 1.4;">
                                                @foreach (var sym in currentRequest.symptom_list)
                                                {
                                                    <li>
                                                        <strong>@sym.symptom_text</strong> 
                                                        @if (!string.IsNullOrWhiteSpace(sym.duration)) { <span>(@sym.duration)</span> }
                                                        @if (!string.IsNullOrWhiteSpace(sym.severity)) { <span class="badge @GetSeverityClass(sym.severity)" style="font-size: 0.6rem; padding: 0.1rem 0.3rem; margin-left: 0.25rem;">@sym.severity</span> }
                                                        @if (!string.IsNullOrWhiteSpace(sym.notes)) { <span style="display: block; font-size: 0.7rem; color: #64748b;">Notes: @sym.notes</span> }
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    <!-- Diagnosis -->
                                    @if (currentRequest.diagnosis_list != null && currentRequest.diagnosis_list.Any())
                                    {
                                        <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem;">
                                            <div style="font-weight: 800; color: #0284c7; font-size: 0.7rem; text-transform: uppercase; margin-bottom: 0.25rem;">Diagnosis</div>
                                            <ul style="margin: 0; padding-left: 1.1rem; font-size: 0.75rem; list-style-type: square; line-height: 1.4;">
                                                @foreach (var diag in currentRequest.diagnosis_list)
                                                {
                                                    <li>
                                                        @if (!string.IsNullOrWhiteSpace(diag.icd_code))
                                                        {
                                                            <span style="font-family: monospace; color: #0369a1; font-weight: bold; background: #e0f2fe; padding: 0.05rem 0.25rem; border-radius: 4px;">@diag.icd_code</span>
                                                        }
                                                        <span> @(diag.icd_description ?? diag.diagnosis_text)</span>
                                                        @if (!string.IsNullOrWhiteSpace(diag.diagnosis_type)) { <span style="font-size: 0.65rem; color: #64748b; font-weight: 700; margin-left: 0.25rem;">[@diag.diagnosis_type]</span> }
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    <!-- Prescription -->
                                    @if (currentRequest.prescription != null && currentRequest.prescription.items != null && currentRequest.prescription.items.Any())
                                    {
                                        <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem;">
                                            <div style="font-weight: 800; color: #0284c7; font-size: 0.7rem; text-transform: uppercase; margin-bottom: 0.25rem;">Prescribed Medicines</div>
                                            <table style="width: 100%; font-size: 0.75rem; border-collapse: collapse;">
                                                <thead>
                                                    <tr style="border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.65rem; text-align: left;">
                                                        <th style="padding: 0.2rem 0;">Drug</th>
                                                        <th style="padding: 0.2rem 0; text-align: center;">Frequency</th>
                                                        <th style="padding: 0.2rem 0; text-align: center;">Duration</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in currentRequest.prescription.items)
                                                    {
                                                        <tr style="border-bottom: 1px dashed #f1f5f9;">
                                                            <td style="padding: 0.25rem 0;">
                                                                <strong>@item.drug_name</strong>
                                                                @if (!string.IsNullOrWhiteSpace(item.notes)) { <span style="display: block; font-size: 0.65rem; color: #64748b;">@item.notes</span> }
                                                            </td>
                                                            <td style="padding: 0.25rem 0; text-align: center; font-family: monospace;">
                                                                @item.morning-@item.afternoon-@item.evening-@item.night 
                                                                <span style="display: block; font-size: 0.62rem; color: #94a3b8;">(@(item.before_food ? "Before Food" : "After Food"))</span>
                                                            </td>
                                                            <td style="padding: 0.25rem 0; text-align: center;">@item.days Days</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    <!-- Investigation tests -->
                                    @if (currentRequest.investigation != null && currentRequest.investigation.tests != null && currentRequest.investigation.tests.Any())
                                    {
                                        <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem;">
                                            <div style="font-weight: 800; color: #0284c7; font-size: 0.7rem; text-transform: uppercase; margin-bottom: 0.25rem;">Investigations</div>
                                            <ul style="margin: 0; padding-left: 1.1rem; font-size: 0.75rem; list-style-type: circle; line-height: 1.4;">
                                                @foreach (var test in currentRequest.investigation.tests)
                                                {
                                                    <li>
                                                        <strong>@test.test_name</strong> 
                                                        @if (test.quantity > 1) { <span style="color: #64748b;">(Qty: @test.quantity)</span> }
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    <!-- Doctor Advise & Follow-up Notes -->
                                    @if (!string.IsNullOrWhiteSpace(currentRequest.advise) || 
                                         !string.IsNullOrWhiteSpace(currentRequest.followup_notes) || 
                                         currentRequest.followup_date.HasValue)
                                    {
                                        <div style="padding-top: 0.25rem; display: flex; flex-direction: column; gap: 0.25rem;">
                                            @if (!string.IsNullOrWhiteSpace(currentRequest.advise))
                                            {
                                                <div style="font-size: 0.75rem;"><strong>Advise:</strong> @currentRequest.advise</div>
                                            }
                                            @if (currentRequest.followup_date.HasValue || !string.IsNullOrWhiteSpace(currentRequest.followup_notes))
                                            {
                                                <div style="font-size: 0.75rem; background: #fffbeb; border: 1px solid #fef3c7; border-radius: 6px; padding: 0.35rem; color: #b45309; font-weight: 600;">
                                                    <i class="bi bi-calendar-event"></i> Follow-up: 
                                                    @if (currentRequest.followup_date.HasValue) { <span>@currentRequest.followup_date.Value.ToString("dd-MMM-yyyy")</span> }
                                                    @if (!string.IsNullOrWhiteSpace(currentRequest.followup_notes)) { <span> - @currentRequest.followup_notes</span> }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            </div>
                        </div>




                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="casesheet-footer">
                <div class="footer-left" style="display: flex; align-items: center; gap: 1.5rem;">
                    @if (isReadOnly)
                    {
                        <span style="color:var(--success-color); font-weight:700;">
                            <i class="bi bi-lock-fill"></i> Read-only: Finalized Case Sheet
                        </span>
                    }
                    else if (savingData)
                    {
                        <span>Saving records...</span>
                    }

                    <div class="past-visits-footer-selector">
                        <span class="past-visits-label"><i class="bi bi-clock-history"></i> Past Visits:</span>
                        @if (loadingPast3Visits)
                        {
                            <span class="spinner-border spinner-border-sm text-secondary" style="width: 0.75rem; height: 0.75rem;"></span>
                        }
                        else if (past3Visits == null || !past3Visits.Any())
                        {
                            <span style="font-size: 0.72rem; color: #94a3b8; font-style: italic;">No past visits</span>
                        }
                        else
                        {
                            @foreach (var visit in past3Visits)
                            {
                                var isSelected = selectedPastVisitCaseSheet != null && 
                                                 ((!string.IsNullOrEmpty(visit.op_id) && visit.op_id == selectedPastVisitCaseSheet.op_id) || 
                                                  (visit.ip_id.HasValue && visit.ip_id == selectedPastVisitCaseSheet.ip_id));
                                <button class="past-visit-pill-btn @(isSelected ? "active" : "")" 
                                        @onclick="() => TogglePastVisitCaseSheet(visit)"
                                        title="Click to view case sheet from @(visit.visit_date?.ToString("dd-MMM-yyyy") ?? "this visit")">
                                    <i class="bi bi-calendar3"></i> @(visit.visit_date?.ToString("dd-MMM-yyyy") ?? "Visit")
                                </button>
                            }
                        }
                    </div>
                </div>
                <div class="footer-right">
                    <button class="btn-footer btn-close" @onclick="CloseModal">Close</button>
                    @if (hasPrintRight)
                    {
                        <button class="btn-footer btn-print" @onclick="PrintCaseSheetAsync" disabled="@printingCaseSheet" style="background: linear-gradient(135deg, #10b981, #059669); color: white; display: flex; align-items: center; gap: 0.35rem;">
                            @if (printingCaseSheet)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Printing...</span>
                            }
                            else
                            {
                                <i class="bi bi-printer"></i>
                                <span>Print Case Sheet</span>
                            }
                        </button>
                    }
                    @if (!isReadOnly)
                    {
                        <button class="btn-footer btn-draft" @onclick="SaveDraftAsync" disabled="@savingData">
                            @if (savingData) { <span class="spinner-border spinner-border-sm"></span> }
                            Save Draft
                        </button>
                        <button class="btn-footer btn-finalize" @onclick="FinalizeCaseSheetAsync" disabled="@savingData">
                            @if (savingData) { <span class="spinner-border spinner-border-sm"></span> }
                            <i class="bi bi-check-all"></i> Finalize Case Sheet
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (showVitalsHistoryModal)
{
    <div class="modal-backdrop fade show" style="background: rgba(15,23,42,0.6); backdrop-filter: blur(4px); z-index: 2000;"></div>
    <div class="modal fade show" tabindex="-1" style="display: block; z-index: 2005;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content" style="border-radius: 14px; border: none; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);">
                <div class="modal-header" style="background: #0f172a; color: #ffffff; border-top-left-radius: 14px; border-top-right-radius: 14px; padding: 1rem 1.5rem;">
                    <h5 class="modal-title" style="font-weight: 700; font-size: 1.1rem; display: flex; align-items: center; gap: 0.5rem;">
                        <i class="bi bi-clock-history text-info"></i> All Recorded Vitals History
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseVitalsHistoryModal"></button>
                </div>
                <div class="modal-body" style="padding: 1.5rem; background: #f8fafc;">
                    @if (vitalsList == null || !vitalsList.Any())
                    {
                        <div class="text-center text-muted py-4">No recorded vitals found for this patient.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered bg-white" style="font-size: 0.82rem; border-radius: 8px; overflow: hidden;">
                                <thead style="background: #0284c7; color: white; font-weight: 700;">
                                    <tr>
                                        <th>#</th>
                                        <th>Date & Time</th>
                                        <th>BP (mmHg)</th>
                                        <th>Pulse</th>
                                        <th>Temp (°F)</th>
                                        <th>SpO2 (%)</th>
                                        <th>Ht / Wt / BMI</th>
                                        <th>Sugar / HbA1c</th>
                                        <th>Resp / Pain</th>
                                        <th>Clinical Exam</th>
                                        <th>Allergies & Notes</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < vitalsList.Count; i++)
                                    {
                                        var v = vitalsList[i];
                                        int idx = i + 1;
                                        bool isCurr = (activeVitals == v);
                                        <tr style="@(isCurr ? "background: #eff6ff; font-weight: 600;" : "")">
                                            <td><strong>#@idx</strong></td>
                                            <td>@(v.created_at != default ? (DateTimeHelper.ConvertUtcToIst(v.created_at)?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-") : "-")</td>
                                            <td>
                                                @if (v.bp_systolic.HasValue && v.bp_diastolic.HasValue)
                                                {
                                                    <span class="badge bg-primary">@v.bp_systolic / @v.bp_diastolic</span>
                                                }
                                                else { <span>-</span> }
                                            </td>
                                            <td>@(v.pulse_rate.HasValue ? $"{v.pulse_rate} bpm" : "-")</td>
                                            <td>@(v.temperature_f.HasValue ? $"{v.temperature_f} °F" : "-")</td>
                                            <td>@(v.spo2.HasValue ? $"{v.spo2} %" : "-")</td>
                                            <td>
                                                <div>Ht: @(v.height_cm.HasValue ? $"{v.height_cm} cm" : "-")</div>
                                                <div>Wt: @(v.weight_kg.HasValue ? $"{v.weight_kg} kg" : "-")</div>
                                                <div>BMI: @(v.bmi.HasValue ? $"{v.bmi}" : "-")</div>
                                            </td>
                                            <td>
                                                <div>Sugar: @(v.sugar_level.HasValue ? $"{v.sugar_level} mg/dL" : "-")</div>
                                                <div>HbA1c: @(v.hba1c.HasValue ? $"{v.hba1c} %" : "-")</div>
                                            </td>
                                            <td>
                                                <div>Resp: @(v.respiratory_rate.HasValue ? $"{v.respiratory_rate} rpm" : "-")</div>
                                                <div>Pain: @(v.pain_scale.HasValue ? $"{v.pain_scale}/10" : "-")</div>
                                            </td>
                                            <td style="max-width: 180px; font-size: 0.78rem;">
                                                @if (!string.IsNullOrEmpty(v.cvs)) { <div><strong>CVS:</strong> @v.cvs</div> }
                                                @if (!string.IsNullOrEmpty(v.rs)) { <div><strong>RS:</strong> @v.rs</div> }
                                                @if (!string.IsNullOrEmpty(v.cns)) { <div><strong>CNS:</strong> @v.cns</div> }
                                                @if (!string.IsNullOrEmpty(v.pedal_oedema)) { <div><strong>Oedema:</strong> @v.pedal_oedema</div> }
                                            </td>
                                            <td style="max-width: 150px; font-size: 0.78rem; color: #dc2626;">
                                                @v.allergy_notes
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-dark" style="font-size: 0.72rem; font-weight: 700;" @onclick="() => { SelectVitalsEntry(v); CloseVitalsHistoryModal(); }">
                                                    <i class="bi bi-eye-fill"></i> Select Entry
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer" style="background: #f1f5f9; padding: 0.75rem 1.5rem;">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseVitalsHistoryModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

