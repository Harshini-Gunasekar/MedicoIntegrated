            else
            {
                if (OpId != Guid.Empty)
                {
                    nurseVitalsList = await AppointmentBookingService.GetOpVitalsAsync(OpId, null);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CaseSheet] Error loading nurse notes: {ex.Message}");
        }
        finally
        {
            loadingNurseNotes = false;
            StateHasChanged();
        }
    }

