    private async Task LoadClinicalWorkspaceAsync()
    {
        loadingData = true;
        activeTab = !string.IsNullOrWhiteSpace(InitialTab) ? InitialTab : "notes";
        
        inlineIcdSearchResults.Clear();
        activeInlineDiagSno = 0;
        ResetWorkspaceState();
        StateHasChanged();

        try
        {
            bool isAdmin = UserPermissionHelper.IsAdmin(null, TenantState);
            try
            {
                var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null)
                {
                    isAdmin = UserPermissionHelper.IsAdmin(userResult.Value, TenantState);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking user details: {ex.Message}");
            }

            if (isAdmin)
            {
                hasViewRight = true;
                hasPrintRight = true;
            }
            else
            {
                var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                if (rightsResult.Success && rightsResult.Value != null)
                {
                    var casesheetRight = rightsResult.Value.FirstOrDefault(r => 
                        r.ModuleName != null && 
                        (r.ModuleName.Trim().Equals("View_CaseSheet", StringComparison.OrdinalIgnoreCase) ||
                         r.ModuleName.Trim().Equals("CaseSheet", StringComparison.OrdinalIgnoreCase) ||
                         r.ModuleName.Trim().Equals("OPD Consultation", StringComparison.OrdinalIgnoreCase) ||
                         r.ModuleName.Trim().Equals("OutPatientVisiting", StringComparison.OrdinalIgnoreCase)));
                    
                    hasViewRight = casesheetRight != null ? (casesheetRight.ToView || casesheetRight.ToAdd || casesheetRight.ToEdit) : true;

                    var printRight = rightsResult.Value.FirstOrDefault(r => 
                        r.ModuleName != null && 
                        (r.ModuleName.Trim().Equals("Print_CaseSheet", StringComparison.OrdinalIgnoreCase) ||
                         r.ModuleName.Trim().Equals("CaseSheet", StringComparison.OrdinalIgnoreCase) ||
                         r.ModuleName.Trim().Equals("OPD Consultation", StringComparison.OrdinalIgnoreCase) ||
                         r.ModuleName.Trim().Equals("OutPatientVisiting", StringComparison.OrdinalIgnoreCase)));

                    hasPrintRight = printRight != null ? (printRight.ToExport || printRight.ToView || printRight.ToAdd || printRight.ToEdit) : true;
                }
                else
                {
                    hasViewRight = true;
                    hasPrintRight = true;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error retrieving user rights: {ex.Message}");
            hasViewRight = false;
            hasPrintRight = false;
        }

        if (!hasViewRight)
        {
            ToastService.ShowError("You do not have permission to view Case Sheets.");
            await CloseModal();
            return;
        }

        try
        {
            _ = LoadCurrentUserNameAsync();
            // Reset request object
            activeTab = !string.IsNullOrWhiteSpace(InitialTab) ? InitialTab : "notes";
            currentRequest = new SaveCaseSheetRequest
            {
                op_id = OpId != Guid.Empty ? OpId.ToString() : null,
                ip_id = (IpId.HasValue && IpId.Value != Guid.Empty) ? IpId.Value.ToString() : null,
                custid = CustId,
                dcode = Dcode,
                sheet_status = "DRAFT",
                referred_to_visiting_doctor = false,
                referred_to_operation = false,
                visiting_doctor_list = new()
            };
            tempVisitingDocName = "";
            tempVisitingDocDcode = null;
            tempVisitingDocNotes = "";
            isConsulted = false;

            prescriptionRemarks = new();
            investigationNotes = string.Empty;
            investigationMasterUrgent = false;

            selectedHistoryOpId = null;
            selectedPastVisitCaseSheet = null;
            // Pre-load reference master data in parallel if needed
            var masterTasks = new List<Task>();
            if (allIcdItems.Count == 0)
            {
                masterTasks.Add(Task.Run(async () => {
                    try { allIcdItems = await CaseSheetService.GetAllIcd10Async(); } catch { }
                }));
            }
            if (allTestMasters.Count == 0)
            {
                masterTasks.Add(Task.Run(async () => {
                    try { allTestMasters = await LabCareTestService.GetAllTestsAsync(); } catch { }
                }));
            }
            if (consultantDoctorsList.Count == 0)
            {
                masterTasks.Add(Task.Run(async () => {
                    try
                    {
                        var rawDocs = await DoctorService.GetDoctorsAsync();
                        consultantDoctorsList = (rawDocs ?? new List<DoctorMasterModel>())
                            .Where(d => d.isconsultant == true && !d.deleted)
                            .ToList();

                        var specs = await SpecialtyService.GetDoctorSpecialtiesAsync();
                        doctorSpecialtiesList = specs ?? new();
                        doctorSpecialtiesMap = doctorSpecialtiesList
                            .Where(s => s.spcode > 0 && !string.IsNullOrWhiteSpace(s.name))
                            .GroupBy(s => s.spcode)
                            .ToDictionary(g => g.Key, g => g.First().name.Trim());
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[CaseSheetComponent] Error loading consultant doctors: {ex.Message}");
                    }
                }));
            }
            if (allItems.Count == 0 || allStocks.Count == 0 || allUoms.Count == 0 || allCategories.Count == 0 || allParentCategories.Count == 0)
            {
                masterTasks.Add(Task.Run(async () => {
                    try
                    {
                        var tenant = await GetCurrentTenantCodeAsync();
                        var itemTask = allItems.Count == 0 ? CaseSheetService.GetAllItemsAsync(tenant) : Task.FromResult(allItems);
                        var stockTask = allStocks.Count == 0 ? CaseSheetService.GetAllStocksAsync(tenant) : Task.FromResult(allStocks);
                        var catTask = allCategories.Count == 0 ? CaseSheetService.GetAllCategoriesAsync(tenant) : Task.FromResult(allCategories);
                        var pcatTask = allParentCategories.Count == 0 ? CaseSheetService.GetAllParentCategoriesAsync(tenant) : Task.FromResult(allParentCategories);
                        
                        await Task.WhenAll(itemTask, stockTask, catTask, pcatTask);
                        allItems = await itemTask;
                        allStocks = await stockTask;
                        allCategories = await catTask;
                        allParentCategories = await pcatTask;

                        if (allUoms.Count == 0)
                        {
                            try
                            {
                                var uoms = await CaseSheetService.GetAllUomsAsync(tenant);
                                if (uoms.Count > 0) allUoms = uoms;
                                else allUoms = await UomMasterService.GetUomMastersAsync() ?? new();
                            }
                            catch { }
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error loading items in workspace: {ex.Message}");
                    }
                }));
            }
            if (masterTasks.Count > 0)
            {
                await Task.WhenAll(masterTasks);
            }

            // 1. Load existing case sheet (if any)
            try
            {
                var existingSheet = await CaseSheetService.GetCaseSheetByVisitAsync(OpId, IpId);
                rawLoadedSheet = existingSheet;
                if (existingSheet != null && !string.IsNullOrEmpty(existingSheet.sheet_id))
                {
                    LoadFromViewModel(existingSheet);

                    if (currentRequest?.prescription?.items != null && currentRequest.prescription.items.Count > 0)
                    {
                        foreach (var pItem in currentRequest.prescription.items)
                        {
                            var uom = GetItemUomMeasureByCodeOrName(pItem.drug_code, pItem.drug_name);
                            if (!string.IsNullOrWhiteSpace(uom))
                            {
                                pItem.dose_unit = uom;
                            }
                        }
                    }
                    
                    // Initialize remarks caches
                    if (existingSheet.prescription != null)
                    {
                        prescriptionRemarks.topremarks = existingSheet.prescription.topremarks;
                        prescriptionRemarks.bottonremarks = existingSheet.prescription.bottonremarks;
                        prescriptionRemarks.pr_code = existingSheet.prescription.pr_code;
                    }
                    if (existingSheet.investigation != null)
                    {
                        investigationNotes = existingSheet.investigation.notes;
                        investigationMasterUrgent = existingSheet.investigation.is_urgent;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[LoadClinicalDetails] Error loading existing sheet: {ex.Message}");
            }

            // 2. Load Patient Vitals
            loadingVitals = true;
            StateHasChanged();
            try
            {
                vitalsList = await AppointmentBookingService.GetOpVitalsAsync(OpId != Guid.Empty ? OpId : null, IpId);
                if (vitalsList != null && vitalsList.Any())
                {
                    activeVitals = vitalsList.OrderByDescending(v => v.created_at).First();
                    // Ensure ip_id and ip_no are set if they are not already
                    if (IpId.HasValue && IpId.Value != Guid.Empty && activeVitals.ip_id == null)
                    {
                        activeVitals.ip_id = IpId;
                    }
                    if (!string.IsNullOrEmpty(IpNo) && string.IsNullOrEmpty(activeVitals.ip_no))
                    {
                        activeVitals.ip_no = IpNo;
                    }
                    isEditingVitals = true;
                }
                else
                {
                    activeVitals = new OPRegistrationModel.PatientVitalsModel
                    {
                        op_id = OpId != Guid.Empty ? OpId : null,
                        op_no = !string.IsNullOrEmpty(OpNo) ? OpNo : null,
                        ip_id = IpId != Guid.Empty ? IpId : null,
                        ip_no = !string.IsNullOrEmpty(IpNo) ? IpNo : null,
                        custid = CustId,
                        dcode = Dcode,
                        pedal_oedema = "",
                        jvp = "",
                        cvs = "",
                        rs = "",
                        cns = "",
                        abdomen = ""
                    };
                    isEditingVitals = false;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[LoadClinicalDetails] Error loading vitals: {ex.Message}");
            }
            finally
            {
                allNormalToggle = false;
                loadingVitals = false;
            }

            // 3. Clear History cache so it reloads if clicked
            patientHistory.Clear();
            historyPage = 1;

            // 4. Load past 3 visits list for bottom-left preview switcher
            if (!isViewingHistory)
            {
                loadingPast3Visits = true;
                StateHasChanged();
                try
                {
                    var history = await CaseSheetService.GetPatientHistoryAsync(CustId, 1, 5); // get first 5
                    if (history != null)
                    {
                        past3Visits = history
                            .Where(h => h.op_id != OpId.ToString())
                            .Take(3)
                            .ToList();

                        var currentVisitHist = history.Where(h => (OpId != Guid.Empty && h.op_id == OpId.ToString()) || (IpId.HasValue && IpId.Value != Guid.Empty && h.ip_id == IpId.Value.ToString())).ToList();
                        foreach (var h in currentVisitHist)
                        {
                            if (h.prescription != null && (!string.IsNullOrEmpty(h.prescription.pr_code) || (h.prescription.items != null && h.prescription.items.Any())))
                            {
                                if (!prescriptionsList.Any(p => (!string.IsNullOrEmpty(p.pr_code) && p.pr_code == h.prescription.pr_code) || (!string.IsNullOrEmpty(p.pr_id) && p.pr_id == h.prescription.pr_id)))
                                {
                                    prescriptionsList.Add(h.prescription);
                                }
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading past 3 visits: {ex.Message}");
                }
                finally
                {
                    loadingPast3Visits = false;
                }
            }

            if (prescriptionsList.Count == 0)
            {
                try
                {
                    var allPrescriptions = await CaseSheetService.GetAllPrescriptionsByVisitAsync(OpId != Guid.Empty ? OpId : null, IpId);
                    if (allPrescriptions != null && allPrescriptions.Any())
                    {
                        foreach (var p in allPrescriptions)
                        {
                            if (!prescriptionsList.Any(existing => (!string.IsNullOrEmpty(existing.pr_code) && existing.pr_code == p.pr_code) || (!string.IsNullOrEmpty(existing.pr_id) && existing.pr_id == p.pr_id)))
                            {
                                prescriptionsList.Add(p);
                            }
                        }
                        if (activePrescription == null && prescriptionsList.Any())
                        {
                            SelectPrescriptionEntry(prescriptionsList.First());
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[LoadClinicalDetails] Error fetching extra prescription: {ex.Message}");
                }
            }

            // 5. Load unbilled charges for this visit (Investigations, Observations, Consultation, etc.)
            try { _ = LoadUnbilledChargesAsync(); } catch { }

            // 6. Check if Laboratory Result Entry has recorded results for this patient / visit
            try { _ = CheckLabResultsEnteredAsync(); } catch { }

            // 7. Check if Paid Pharmacy Bill and Pharmacy Sales exist for this patient
            try { _ = LoadPatientPharmacySalesAsync(); } catch { }

            // 8. Load Bedside Nurse Notes (IP Patients only)
            if (IsIpPatient)
            {
                try { _ = LoadNurseNotesDataAsync(); } catch { }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CaseSheetComponent] Error loading clinical details: {ex.Message}");
        }
        finally
        {
            loadingData = false;
            StateHasChanged();
        }
    }

    private void LoadFromViewModel(CaseSheetViewModel vm)
    {
        currentRequest.sheet_id = vm.sheet_id;
        isConsulted = vm.is_consulted;
        currentRequest.chief_complaint = vm.chief_complaint;
        currentRequest.symptoms = vm.symptoms;
        currentRequest.examination = vm.examination;
        currentRequest.advise = vm.advise;
        currentRequest.notes = vm.notes;
        currentRequest.followup_date = vm.followup_date;
        currentRequest.followup_notes = vm.followup_notes;
        currentRequest.refer_to_ip = vm.refer_to_ip;
        currentRequest.referred_to_visiting_doctor = vm.referred_to_visiting_doctor;
        currentRequest.referred_to_operation = vm.referred_to_operation;
        currentRequest.visiting_doctor_list = vm.visiting_doctor_list?.Select((vd, index) => new VisitingDoctorItem
        {
            sno = index + 1,
            doctor_name = vd.doctor_name,
            dcode = vd.dcode,
            notes = vd.notes
        }).ToList() ?? new();
        currentRequest.sheet_status = vm.sheet_status ?? "DRAFT";

        currentRequest.symptom_list = vm.symptom_list.Select((s, index) => new CaseSheetSymptomItem
        {
            sno = index + 1,
            symptom_text = s.symptom_text ?? "",
            duration = s.duration,
            severity = s.severity,
            notes = s.notes
        }).ToList();

        currentRequest.diagnosis_list = vm.diagnosis_list.Select((d, index) => new CaseSheetDiagnosisItem
        {
            sno = index + 1,
            icd_code = d.icd_code,
            icd_description = d.icd_description,
            diagnosis_text = d.diagnosis_text,
            diagnosis_type = d.diagnosis_type,
            condition_type = d.condition_type,
            severity = d.severity,
            status = d.status ?? "ACTIVE"
        }).ToList();

        if (vm.prescription != null && vm.prescription.items != null && vm.prescription.items.Any(i => !string.IsNullOrWhiteSpace(i.drug_name)))
        {
            prescriptionRemarks.topremarks = vm.prescription.topremarks;
            prescriptionRemarks.bottonremarks = vm.prescription.bottonremarks;
            prescriptionRemarks.pr_code = vm.prescription.pr_code;
            currentRequest.prescription = new CaseSheetPrescriptionRequest
            {
                pr_code = vm.prescription.pr_code,
                topremarks = vm.prescription.topremarks,
                bottonremarks = vm.prescription.bottonremarks,
                items = vm.prescription.items.Where(i => !string.IsNullOrWhiteSpace(i.drug_name)).Select((i, index) => {
                    string? resolvedUnit = GetItemUomMeasureByCodeOrName(i.drug_code, i.drug_name);
                    if (string.IsNullOrWhiteSpace(resolvedUnit))
                    {
                        resolvedUnit = i.dose_unit;
                    }
                    return new CaseSheetPrescriptionItem
                    {
                        sno = index + 1,
                        diag_id = i.diag_id?.ToString(),
                        drug_name = i.drug_name ?? "",
                        drug_code = i.drug_code,
                        generic_name = i.generic_name,
                       
                        morning = i.morning ?? "0",
                        afternoon = i.afternoon ?? "0",
                        evening = i.evening ?? "0",
                        night = i.night ?? "0",
                        morning_dose = i.morning_dose ?? i.morning ?? "0",
                        afternoon_dose = i.afternoon_dose ?? i.afternoon ?? "0",
                        evening_dose = i.evening_dose ?? i.evening ?? "0",
                        night_dose = i.night_dose ?? i.night ?? "0",
                        dose_unit = resolvedUnit ?? "",
                        before_food = i.before_food,
                        after_food = i.after_food,
                        days = i.days,
                        qty = i.qty,
                        
                        rate = i.rate,
                        mrp = i.mrp,
                        notes = i.notes
                    };
                }).ToList()
            };

            var existingIdx = prescriptionsList.FindIndex(p => 
                (!string.IsNullOrEmpty(p.pr_code) && p.pr_code == vm.prescription.pr_code) ||
                (!string.IsNullOrEmpty(p.pr_id) && p.pr_id == vm.prescription.pr_id));
            if (existingIdx >= 0)
            {
                prescriptionsList[existingIdx] = vm.prescription;
            }
            else
            {
                prescriptionsList.Add(vm.prescription);
            }
            activePrescription = vm.prescription;
            isEditingPrescription = true;
        }
        else
        {
            currentRequest.prescription = new CaseSheetPrescriptionRequest();
            prescriptionRemarks = new CaseSheetPrescriptionRequest();
            activePrescription = null;
            isEditingPrescription = false;
        }

        if (vm.prescription_list != null && vm.prescription_list.Any())
        {
            foreach (var p in vm.prescription_list)
            {
                var existingIdx = prescriptionsList.FindIndex(existing => 
                    (!string.IsNullOrEmpty(existing.pr_code) && existing.pr_code == p.pr_code) ||
                    (!string.IsNullOrEmpty(existing.pr_id) && existing.pr_id == p.pr_id));
                if (existingIdx >= 0)
                {
                    prescriptionsList[existingIdx] = p;
                }
                else
                {
                    prescriptionsList.Add(p);
                }
            }
            if (activePrescription == null && prescriptionsList.Any())
            {
                SelectPrescriptionEntry(prescriptionsList.Last());
            }
        }

        if (vm.investigation != null)
        {
            // Assign sequential sno to source investigation tests so lookups by sno work
            for (int i = 0; i < vm.investigation.tests.Count; i++)
            {
                vm.investigation.tests[i].sno = i + 1;
            }

            currentRequest.investigation = new CaseSheetInvestigationRequest
            {
                inv_id = vm.investigation.inv_id,
                notes = vm.investigation.notes,
                is_urgent = vm.investigation.is_urgent,
                tests = vm.investigation.tests.Select((t, index) => new CaseSheetInvestigationItem
                {
                    sno = index + 1,
                    diag_id = t.diag_id?.ToString(),
                    test_name = t.test_name ?? "",
                    test_code = t.test_code,
                    test_category = t.test_category,
                    quantity = t.quantity > 0 ? t.quantity : 1,
                    rate = t.rate ?? 0,
                    amount = t.amount ?? ((t.rate ?? 0) * (t.quantity > 0 ? t.quantity : 1))
                }).ToList()
            };
        }
        else
        {
            currentRequest.investigation = new CaseSheetInvestigationRequest();
        }
    }

