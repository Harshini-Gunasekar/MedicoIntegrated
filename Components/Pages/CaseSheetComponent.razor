            currentRequest.prescription = new CaseSheetPrescriptionRequest();
        }

        newPrescriptionItem.sno = currentRequest.prescription.items.Count + 1;
        currentRequest.prescription.items.Add(newPrescriptionItem);

        // Reset
        newPrescriptionItem = new CaseSheetPrescriptionItem { morning = "1", afternoon = "0", evening = "0", night = "0", route = "ORAL", before_food = false, after_food = true, days = 5, qty = 5 };
    }

    private void RemovePrescriptionItem(CaseSheetPrescriptionItem item)
    {
