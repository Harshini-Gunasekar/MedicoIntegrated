    private OPRegistrationModel.PatientVitalsModel? selectedPastVisitVitals = null;
    private bool isViewingHistory => selectedPastVisitCaseSheet != null;
    private DateTime? historicalVisitDate => selectedPastVisitCaseSheet?.visit_date;

    // Lab Report Preview & Result Entry Tracking
    private bool hasLabResultsEntered = false;
    private string labReportRequestGuid = "";
