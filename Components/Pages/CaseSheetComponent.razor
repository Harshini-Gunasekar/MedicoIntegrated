    private void OnVisitingDoctorFocus()
    {
        if (!string.IsNullOrWhiteSpace(tempVisitingDocName))
        {
            isVisitingDoctorDropdownOpen = true;
            highlightedVisitingDocIndex = 0;
        }
    }

    private void OnVisitingDoctorKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown")
        {
            var count = GetFilteredConsultantDoctors().Count();
            if (count > 0)
            {
                highlightedVisitingDocIndex = (highlightedVisitingDocIndex + 1) % count;
                isVisitingDoctorDropdownOpen = true;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            var count = GetFilteredConsultantDoctors().Count();
            if (count > 0)
            {
                highlightedVisitingDocIndex = (highlightedVisitingDocIndex - 1 + count) % count;
                isVisitingDoctorDropdownOpen = true;
            }
        }
        else if (e.Key == "Enter" && isVisitingDoctorDropdownOpen)
        {
            var items = GetFilteredConsultantDoctors().ToList();
            if (items.Any() && highlightedVisitingDocIndex >= 0 && highlightedVisitingDocIndex < items.Count)
            {
                SelectVisitingDoctor(items[highlightedVisitingDocIndex]);
            }
            else if (!string.IsNullOrWhiteSpace(tempVisitingDocName))
            {
                AddVisitingDoctorToList();
            }
        }
        else if (e.Key == "Escape")
        {
            isVisitingDoctorDropdownOpen = false;
        }
    }

    private void SelectVisitingDoctor(DoctorMasterModel doc)
    {
        var docName = string.IsNullOrWhiteSpace(doc.name) ? (doc.doctorfullname ?? "Doctor") : doc.name;
        var formattedName = docName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? docName : $"Dr. {docName}";
        tempVisitingDocName = formattedName;
        tempVisitingDocDcode = doc.dcode;
        isVisitingDoctorDropdownOpen = false;
        StateHasChanged();
    }

    private void AddVisitingDoctorToList()
    {
        if (string.IsNullOrWhiteSpace(tempVisitingDocName))
        {
            ToastService.ShowWarning("Please enter or select a visiting doctor name.");
            return;
        }

        var docName = tempVisitingDocName.Trim();
        if (!docName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase))
        {
            docName = $"Dr. {docName}";
        }

        if (currentRequest.visiting_doctor_list.Any(d => string.Equals(d.doctor_name, docName, StringComparison.OrdinalIgnoreCase)))
        {
            ToastService.ShowWarning($"{docName} is already in the visiting doctor list.");
            return;
        }

        int nextSno = currentRequest.visiting_doctor_list.Count + 1;
        currentRequest.visiting_doctor_list.Add(new VisitingDoctorItem
        {
            sno = nextSno,
            doctor_name = docName,
            dcode = tempVisitingDocDcode,
            notes = string.IsNullOrWhiteSpace(tempVisitingDocNotes) ? null : tempVisitingDocNotes.Trim()
        });

        tempVisitingDocName = "";
        tempVisitingDocDcode = null;
        tempVisitingDocNotes = "";
        isVisitingDoctorDropdownOpen = false;
        StateHasChanged();
    }

    private void RemoveVisitingDoctorFromList(VisitingDoctorItem item)
    {
        currentRequest.visiting_doctor_list.Remove(item);
        for (int i = 0; i < currentRequest.visiting_doctor_list.Count; i++)
        {
            currentRequest.visiting_doctor_list[i].sno = i + 1;
        }
        StateHasChanged();
    }

    private string GetDoctorDetailsDisplay(int? dcode, string docName)
    {
        DoctorMasterModel? doc = null;
        if (dcode.HasValue && dcode.Value > 0)
        {
            doc = consultantDoctorsList.FirstOrDefault(d => d.dcode == dcode.Value);
        }
        if (doc == null && !string.IsNullOrWhiteSpace(docName))
        {
            var clean = docName.Replace("Dr.", "", StringComparison.OrdinalIgnoreCase).Trim();
            doc = consultantDoctorsList.FirstOrDefault(d =>
                (!string.IsNullOrWhiteSpace(d.name) && d.name.Trim().Equals(clean, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(d.doctorfullname) && d.doctorfullname.Trim().Equals(docName.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(d.name) && docName.Contains(d.name.Trim(), StringComparison.OrdinalIgnoreCase))
            );
        }

        if (doc != null)
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(doc.qualification)) parts.Add(doc.qualification.Trim());
            var spec = GetDoctorSpecialty(doc);
            if (!string.IsNullOrWhiteSpace(spec)) parts.Add(spec.Trim());
            return string.Join(" • ", parts);
        }
        return "";
    }

    private IEnumerable<DoctorMasterModel> GetFilteredConsultantDoctors()
    {
        var list = consultantDoctorsList.Where(d => d.isconsultant == true && !d.deleted);
        var query = (tempVisitingDocName ?? "").Trim();
        if (!string.IsNullOrWhiteSpace(query))
        {
            var q = query.ToLower();
            list = list.Where(d =>
                (!string.IsNullOrWhiteSpace(d.name) && d.name.ToLower().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(d.doctorfullname) && d.doctorfullname.ToLower().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(d.shortname) && d.shortname.ToLower().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(d.qualification) && d.qualification.ToLower().Contains(q))
            );
        }
        return list;
    }

    private string GetDoctorSpecialty(DoctorMasterModel? doc)
    {
        if (doc == null || !doc.spcode.HasValue || doc.spcode.Value <= 0) return "";
        if (doctorSpecialtiesMap.TryGetValue(doc.spcode.Value, out var specName))
        {
            return specName;
        }
        var spec = doctorSpecialtiesList.FirstOrDefault(s => s.spcode == doc.spcode.Value);
        return spec?.name?.Trim() ?? "";
    }

