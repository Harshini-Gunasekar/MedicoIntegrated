    private async Task<bool> SaveDraftAsyncInternal()
    {
        PrepareRequest();
        currentRequest.sheet_status = "DRAFT";

        savingData = true;
        StateHasChanged();

        if (activeVitals != null && !isReadOnly && (isEditingVitals || HasVitalsData(activeVitals)))
        {
            try
            {
                if (isEditingVitals)
                {
                    await AppointmentBookingService.UpdateOpVitalsAsync(activeVitals);
                }
                else
                {
                    await AppointmentBookingService.SaveOpVitalsAsync(activeVitals);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error auto-saving vitals: {ex.Message}");
            }
        }

        // Ensure visit registration context is correctly passed (OP vs IP)
        if (OpId != Guid.Empty)
        {
            currentRequest.op_id = OpId.ToString();
            if (!IpId.HasValue || IpId.Value == Guid.Empty)
            {
                currentRequest.ip_id = null;
            }
        }
        else if (IpId.HasValue && IpId.Value != Guid.Empty)
        {
            currentRequest.ip_id = IpId.Value.ToString();
            if (string.IsNullOrEmpty(currentRequest.op_id))
            {
                currentRequest.op_id = null;
            }
        }

        var response = await CaseSheetService.SaveCaseSheetAsync(currentRequest);

        if (response.StartsWith("Error"))
        {
            savingData = false;
            ToastService.ShowError(response);
            return false;
        }

        // 2nd reload: fetch the final state from DB with results populated
        var finalReload = await CaseSheetService.GetCaseSheetByVisitAsync(OpId, IpId);
        rawLoadedSheet = finalReload;
        if (finalReload != null)
        {
            LoadFromViewModel(finalReload);
        }

        try
        {
            vitalsList = await AppointmentBookingService.GetOpVitalsAsync(OpId);
            if (vitalsList != null && vitalsList.Any())
            {
                activeVitals = vitalsList.OrderByDescending(v => v.created_at).First();
                isEditingVitals = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reloading vitals list: {ex.Message}");
        }

        if (OpId != Guid.Empty)
        {
            try
            {
                await AppointmentBookingService.UpdateOpStatusAsync(OpId, "IN CONSULTATION");
            }
            catch { }
        }

        savingData = false;
        _ = LoadUnbilledChargesAsync();
        ToastService.ShowSuccess("Draft case sheet saved successfully.");
        await OnSaved.InvokeAsync();
        return true;
    }

    private async Task SaveDraftAsync()
    {
        await SaveDraftAsyncInternal();
    }

    private async Task FinalizeCaseSheetAsync()
    {
        var confirm = await ShowConfirmAsync(
            "Are you sure you want to Finalize this Case Sheet? Once finalized, the clinical record is LOCKED and cannot be edited. It will also dispense prescriptions to pharmacy and lab orders to diagnostics.",
            title: "Finalize Case Sheet",
            okText: "Yes, Finalize",
            okClass: "btn-primary-finalize",
            icon: "bi-shield-lock-fill"
        );
        if (!confirm) return;

        // 1. First save as draft to ensure everything is written
        var draftSuccess = await SaveDraftAsyncInternal();
        if (!draftSuccess) return;

        // 2. Call Finalize API
        if (string.IsNullOrEmpty(currentRequest.sheet_id))
        {
            ToastService.ShowError("Could not finalize. Sheet ID not generated yet.");
            return;
        }

        savingData = true;
        var finalizeReq = new FinalizeCaseSheetRequest
        {
            sheet_id = currentRequest.sheet_id,
            is_consulted = true
        };

        var ok = await CaseSheetService.FinalizeCaseSheetAsync(finalizeReq);
        savingData = false;

        if (ok)
        {
            ToastService.ShowSuccess("Case sheet finalized and locked.");
            
            // Reload
            var reloaded = await CaseSheetService.GetCaseSheetByVisitAsync(OpId, IpId);
            rawLoadedSheet = reloaded;
            if (reloaded != null)
            {
                LoadFromViewModel(reloaded);
            }

            // Also update the registration's visit status locally/refresh the list
            var targetOpId = OpId != Guid.Empty ? OpId : (Guid.TryParse(currentRequest.op_id, out var g1) ? g1 : (Guid.TryParse(rawLoadedSheet?.op_id, out var g2) ? g2 : Guid.Empty));
            if (targetOpId != Guid.Empty)
            {
                await AppointmentBookingService.UpdateOpStatusAsync(targetOpId, "COMPLETED");
                try
                {
                    var allOps = await AppointmentBookingService.GetAllOpRegistrationsAsync();
                    var matchOp = allOps.FirstOrDefault(x => x.op_id == targetOpId);
                    if (matchOp != null && matchOp.booking_id.HasValue && matchOp.booking_id.Value != Guid.Empty)
                    {
                        await AppointmentBookingService.UpdateStatusAsync(matchOp.booking_id.Value, "COMPLETED");
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error updating booking status: {ex.Message}");
                }
            }

            await OnSaved.InvokeAsync();
        }
        else
        {
            ToastService.ShowError("Failed to finalize case sheet.");
        }
    }

