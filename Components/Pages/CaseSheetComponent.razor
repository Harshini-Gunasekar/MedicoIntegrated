    private async Task SearchIcdInline(CaseSheetDiagnosisItem diag, string query)
    {
        activeInlineDiagSno = diag.sno;
        diag.icd_description = query; // bind user input temporarily to description for display
        diag.icd_code = ""; // clear code until a proper selection is made
        
        if (allIcdItems.Count == 0)
        {
            try
            {
                allIcdItems = await CaseSheetService.GetAllIcd10Async();
            }
            catch { }
        }

        if (!string.IsNullOrWhiteSpace(query))
        {
            var lowerQuery = query.Trim().ToLower();
            inlineIcdSearchResults = allIcdItems
                .Where(x => (x.icd_code != null && x.icd_code.ToLower().Contains(lowerQuery)) ||
                            (x.icd_description != null && x.icd_description.ToLower().Contains(lowerQuery)))
                .Take(15)
                .Select(x => new IcdSearchResult { icd_code = x.icd_code, icd_description = x.icd_description })
                .ToList();
        }
        else
        {
            inlineIcdSearchResults.Clear();
        }
