        diag.icd_description = res.icd_description;
        if (string.IsNullOrWhiteSpace(diag.diagnosis_text))
        {
            diag.diagnosis_text = res.icd_description;
        }

        inlineIcdSearchResults.Clear();
        activeInlineDiagSno = 0;
    }

    private async Task EnsureItemsAndUomsLoadedAsync()
    {
        if (allItems.Count == 0 || allStocks.Count == 0 || allUoms.Count == 0 || allCategories.Count == 0 || allParentCategories.Count == 0)
        {
            try
            {
                var tenant = await GetCurrentTenantCodeAsync();
                if (allItems.Count == 0)
                {
                    allItems = await CaseSheetService.GetAllItemsAsync(tenant);
                }
                if (allStocks.Count == 0)
                {
                    allStocks = await CaseSheetService.GetAllStocksAsync(tenant);
                }
                if (allUoms.Count == 0)
                {
                    try
                    {
                        var uoms = await CaseSheetService.GetAllUomsAsync(tenant);
                        if (uoms.Count > 0) allUoms = uoms;
                        else allUoms = await UomMasterService.GetUomMastersAsync() ?? new();
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[CaseSheetComponent] Error loading UOM masters: {ex.Message}");
                    }
                }
                if (allCategories.Count == 0)
                {
                    try
                    {
                        allCategories = await CaseSheetService.GetAllCategoriesAsync(tenant);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[CaseSheetComponent] Error loading category masters: {ex.Message}");
                    }
                }
                if (allParentCategories.Count == 0)
                {
                    try
                    {
                        allParentCategories = await CaseSheetService.GetAllParentCategoriesAsync(tenant);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[CaseSheetComponent] Error loading parent category masters: {ex.Message}");
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading items in workspace: {ex.Message}");
            }
        }

        if (currentRequest?.prescription?.items != null && currentRequest.prescription.items.Count > 0)
        {
            foreach (var pItem in currentRequest.prescription.items)
            {
                if (string.IsNullOrWhiteSpace(pItem.dose_unit))
                {
                    var uom = GetItemUomMeasureByCodeOrName(pItem.drug_code, pItem.drug_name);
                    if (!string.IsNullOrWhiteSpace(uom))
                    {
                        pItem.dose_unit = uom;
                    }
                }
            }
        }
    }

    private async Task SearchDrugInline(CaseSheetPrescriptionItem item, string query)
    {
        activeInlineDrugSno = item.sno;
        item.drug_name = query; // bind user input temporarily to drug_name
        
        if (string.IsNullOrWhiteSpace(query) || query.Trim().Length < 1)
        {
            inlineDrugSearchResults.Clear();
            item.drug_code = null;
            item.batchno = null;
            return;
        }

        await EnsureItemsAndUomsLoadedAsync();

        var lowerQuery = query.Trim().ToLower();
        inlineDrugSearchResults = allItems
            .Where(x => !x.deleted &&
                        ((x.itemname != null && x.itemname.ToLower().Contains(lowerQuery)) ||
                         (x.drugname != null && x.drugname.ToLower().Contains(lowerQuery)) ||
                         (x.shortname != null && x.shortname.ToLower().Contains(lowerQuery)) ||
                         (x.description != null && x.description.ToLower().Contains(lowerQuery))))
            .Take(25)
            .ToList();

        // Auto-resolve item details and unit from matched item master
        ResolveItemDetails(item);
    }

    private void ResolveItemDetails(CaseSheetPrescriptionItem item, bool forceUom = false)
    {
        if (item == null) return;
        
        item_master? master = null;

        // 1. If drug_code is present, look up master
        if (item.drug_code.HasValue && item.drug_code.Value > 0)
        {
            long codeLong = (long)item.drug_code.Value;
            master = allItems.FirstOrDefault(x => x.itemcode == codeLong);
        }
        
        // 2. Look up master by typed drug_name if not found
        if (master == null && !string.IsNullOrWhiteSpace(item.drug_name))
        {
            var clean = item.drug_name.Trim();

            // First: Exact match on drugname, itemname, or shortname
            master = allItems.FirstOrDefault(x => !x.deleted && (
                (!string.IsNullOrWhiteSpace(x.drugname) && x.drugname.Trim().Equals(clean, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.itemname) && x.itemname.Trim().Equals(clean, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.shortname) && x.shortname.Trim().Equals(clean, StringComparison.OrdinalIgnoreCase))));
            
            // Second: Starts-with match
            if (master == null)
            {
                master = allItems.FirstOrDefault(x => !x.deleted && (
                    (!string.IsNullOrWhiteSpace(x.drugname) && x.drugname.Trim().StartsWith(clean, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(x.itemname) && x.itemname.Trim().StartsWith(clean, StringComparison.OrdinalIgnoreCase))));
            }

            // Third: Contains match (e.g. "Paracetamol" in "Paracetamol 500mg" or "Cough syrup" in "Cough Syrup 100ml")
            if (master == null && clean.Length >= 3)
            {
                master = allItems.FirstOrDefault(x => !x.deleted && (
                    (!string.IsNullOrWhiteSpace(x.drugname) && (x.drugname.Contains(clean, StringComparison.OrdinalIgnoreCase) || clean.Contains(x.drugname.Trim(), StringComparison.OrdinalIgnoreCase))) ||
                    (!string.IsNullOrWhiteSpace(x.itemname) && (x.itemname.Contains(clean, StringComparison.OrdinalIgnoreCase) || clean.Contains(x.itemname.Trim(), StringComparison.OrdinalIgnoreCase)))));
            }
        }

        if (master != null)
        {
            item.drug_code = master.itemcode;
            if (string.IsNullOrWhiteSpace(item.generic_name) && !string.IsNullOrWhiteSpace(master.description))
            {
                item.generic_name = master.description;
            }
            if (!item.mrp.HasValue || item.mrp.Value == 0)
            {
                var unitMrp = CalculateItemUnitCost(master);
                item.mrp = unitMrp > 0 ? unitMrp : master.mrp;
            }
            if (!item.rate.HasValue || item.rate.Value == 0)
            {
                item.rate = item.mrp;
            }
            
            // Always update dose_unit from itemmaster / category / uomcode if found
            var uomMeasure = GetItemUomMeasure(master);
            if (!string.IsNullOrWhiteSpace(uomMeasure))
            {
                item.dose_unit = uomMeasure;
            }

            if (IsTabletOrCapsuleMaster(master, item))
            {
                CalculateItemDrugQty(item);
            }
            else
            {
                if (!item.qty.HasValue || item.qty.Value <= 0)
                {
                    item.qty = 1;
                }
            }
        }
        else if (forceUom && string.IsNullOrWhiteSpace(item.dose_unit))
        {
            var fallbackUom = GetItemUomMeasureByCodeOrName(item.drug_code, item.drug_name);
            if (!string.IsNullOrWhiteSpace(fallbackUom))
            {
                item.dose_unit = fallbackUom;
            }
        }
    }

    private async Task OnDrugInputBlur(CaseSheetPrescriptionItem item)
    {
        ResolveItemDetails(item, forceUom: true);
        await Task.Delay(250);
        if (activeInlineDrugSno == item.sno)
        {
            activeInlineDrugSno = 0;
            inlineDrugSearchResults.Clear();
            StateHasChanged();
        }
    }

    private category_master? GetItemCategory(item_master? item)
    {
        if (item == null) return null;
        if (allCategories != null && allCategories.Count > 0)
        {
            if (item.subcategorycode > 0)
            {
                var cat = allCategories.FirstOrDefault(c => c.categorycode == item.subcategorycode);
                if (cat != null) return cat;
            }
            if (item.categorycode > 0)
            {
                var cat = allCategories.FirstOrDefault(c => c.categorycode == item.categorycode);
                if (cat != null) return cat;
            }
        }
        return null;
    }

    private parent_category_master? GetItemParentCategory(item_master? item)
    {
        if (item == null) return null;
        if (allParentCategories != null && allParentCategories.Count > 0)
        {
            if (item.categorycode > 0)
            {
                var pcat = allParentCategories.FirstOrDefault(p => p.parentcategorycode == item.categorycode);
                if (pcat != null) return pcat;
            }
            if (item.subcategorycode > 0)
            {
                var pcat = allParentCategories.FirstOrDefault(p => p.parentcategorycode == item.subcategorycode);
                if (pcat != null) return pcat;
            }
        }
        return null;
    }

    private bool IsNonTabletLiquidOrTopical(string? text, item_master? master = null)
    {
        string[] nonTabletKeywords = new[] { 
            "syrup", "syp", "suspension", "susp", "drop", "drops", "ointment", "oint", 
            "cream", "crm", "gel", "lotion", "lot", "spray", "inhaler", "respule", "respules",
            "injection", "inj", "iv", "infusion", "solution", "sol", "wash", "mouthwash",
            "powder", "pwd", "oil", "shampoo", "soap", "paste", "sachet", "enema", "granules",
            "device", "strips", "bandage", "cotton"
        };

        string n = (text ?? "").Trim().ToLowerInvariant();
        string type = (master?.itemtype ?? "").Trim().ToLowerInvariant();
        
        foreach (var kw in nonTabletKeywords)
        {
            if (n.Contains(kw) || type.Contains(kw))
            {
                return true;
            }
        }
        return false;
    }

    private bool IsTabletCategoryName(string? categoryName, string? shortName = null)
    {
        if (!string.IsNullOrWhiteSpace(categoryName))
        {
            var name = categoryName.Trim().ToLowerInvariant();
            if (name == "tablet" || name == "tablets" || name == "tab" || name == "tabs" || name == "tab." || name == "tabs." ||
                name.Contains("tablet") || name.StartsWith("tab ") || name.EndsWith(" tab") || name.Contains(" tab ") ||
                name.Contains("tab/") || name.Contains("/tab") || name.Contains("tab-") || name.Contains("-tab"))
            {
                return true;
            }
        }
        if (!string.IsNullOrWhiteSpace(shortName))
        {
            var sn = shortName.Trim().ToLowerInvariant();
            if (sn == "tab" || sn == "tabs" || sn == "tab." || sn == "tablet" || sn == "tablets")
            {
                return true;
            }
        }
        return false;
    }

    private bool IsCapsuleCategoryName(string? categoryName, string? shortName = null)
    {
        if (!string.IsNullOrWhiteSpace(categoryName))
        {
            var name = categoryName.Trim().ToLowerInvariant();
            if (name == "capsule" || name == "capsules" || name == "cap" || name == "caps" || name == "cap." || name == "caps." ||
                name.Contains("capsule") || name.StartsWith("cap ") || name.EndsWith(" cap") || name.Contains(" cap ") ||
                name.Contains("cap/") || name.Contains("/cap") || name.Contains("cap-") || name.Contains("-cap"))
            {
                return true;
            }
        }
        if (!string.IsNullOrWhiteSpace(shortName))
        {
            var sn = shortName.Trim().ToLowerInvariant();
            if (sn == "cap" || sn == "caps" || sn == "cap." || sn == "capsule" || sn == "capsules")
            {
                return true;
            }
        }
        return false;
    }

    private bool IsTabletCategory(category_master? cat)
    {
        if (cat == null) return false;
        return IsTabletCategoryName(cat.categoryname, cat.shortname);
    }

    private bool IsCapsuleCategory(category_master? cat)
    {
        if (cat == null) return false;
        return IsCapsuleCategoryName(cat.categoryname, cat.shortname);
    }

    private bool IsTabletParentCategory(parent_category_master? cat)
    {
        if (cat == null) return false;
        return IsTabletCategoryName(cat.parentcategoryname, cat.shortname);
    }

    private bool IsCapsuleParentCategory(parent_category_master? cat)
    {
        if (cat == null) return false;
        return IsCapsuleCategoryName(cat.parentcategoryname, cat.shortname);
    }

    private bool IsDrugNameTabletOrCapsule(string drugName)
    {
        if (string.IsNullOrWhiteSpace(drugName)) return false;
        string name = drugName.Trim().ToLowerInvariant();

        if (name.Contains("tablet") || name.Contains("capsule")) return true;

        if (System.Text.RegularExpressions.Regex.IsMatch(name, @"\b(tab|tabs|cap|caps)\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase) ||
            System.Text.RegularExpressions.Regex.IsMatch(name, @"\d+\s*(tab|tabs|cap|caps)\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
        {
            return true;
        }

        return false;
    }

    private bool IsTabletOrCapsuleMaster(item_master? master, CaseSheetPrescriptionItem? item = null)
    {
        // 1. Check subcategory from allCategories (Item Type)
        if (master != null && master.subcategorycode > 0 && allCategories != null && allCategories.Count > 0)
        {
            var cat = allCategories.FirstOrDefault(c => c.categorycode == master.subcategorycode);
            if (cat != null)
            {
                if (IsTabletCategory(cat) || IsCapsuleCategory(cat)) return true;
                if (!string.IsNullOrWhiteSpace(cat.categoryname) && IsNonTabletLiquidOrTopical(cat.categoryname, master)) return false;
            }
        }

        // 2. Check category from allCategories or allParentCategories
        if (master != null && master.categorycode > 0)
        {
            if (allCategories != null && allCategories.Count > 0)
            {
                var cat = allCategories.FirstOrDefault(c => c.categorycode == master.categorycode);
                if (cat != null)
                {
                    if (IsTabletCategory(cat) || IsCapsuleCategory(cat)) return true;
                    if (!string.IsNullOrWhiteSpace(cat.categoryname) && IsNonTabletLiquidOrTopical(cat.categoryname, master)) return false;
                }
            }

            if (allParentCategories != null && allParentCategories.Count > 0)
            {
                var pcat = allParentCategories.FirstOrDefault(p => p.parentcategorycode == master.categorycode);
                if (pcat != null)
                {
                    if (IsTabletParentCategory(pcat) || IsCapsuleParentCategory(pcat)) return true;
                    if (!string.IsNullOrWhiteSpace(pcat.parentcategoryname) && IsNonTabletLiquidOrTopical(pcat.parentcategoryname, master)) return false;
                }
            }
        }

        // 3. Check master.itemtype
        if (master != null && !string.IsNullOrWhiteSpace(master.itemtype))
        {
            if (IsTabletCategoryName(master.itemtype) || IsCapsuleCategoryName(master.itemtype)) return true;
            if (IsNonTabletLiquidOrTopical(master.itemtype, master)) return false;
        }

        // 4. Check master.uom / uomshortname / packaging / dose_unit
        if (master != null)
        {
            if (IsTabletCategoryName(master.uom) || IsTabletCategoryName(master.uomshortname) || IsTabletCategoryName(master.packaging) ||
                IsCapsuleCategoryName(master.uom) || IsCapsuleCategoryName(master.uomshortname) || IsCapsuleCategoryName(master.packaging))
            {
                return true;
            }
        }

        if (item != null && !string.IsNullOrWhiteSpace(item.dose_unit))
        {
            if (IsTabletCategoryName(item.dose_unit) || IsCapsuleCategoryName(item.dose_unit))
                return true;
        }

        // 5. Check drug name / item name (e.g. DYTOR 20TAB 15'S)
        string drugName = item?.drug_name ?? master?.drugname ?? master?.itemname ?? "";
        if (!string.IsNullOrWhiteSpace(drugName))
        {
            if (IsNonTabletLiquidOrTopical(drugName, master)) return false;

            if (IsDrugNameTabletOrCapsule(drugName)) return true;
        }

        return false;
    }

    private bool IsTabletOrCapsuleItem(CaseSheetPrescriptionItem? item)
    {
        if (item == null) return false;
        var master = GetItemMaster(item);
        return IsTabletOrCapsuleMaster(master, item);
    }

    private string GetItemUomMeasure(item_master? item)
    {
        if (item == null) return "";

        // 1. PRIMARY: Match category from /api/ItemMaster/getcategory
        var cat = GetItemCategory(item);
        if (cat != null)
        {
            if (IsTabletCategory(cat))
            {
                return !string.IsNullOrWhiteSpace(cat.shortname) ? cat.shortname.Trim() : "TAB";
            }
            if (IsCapsuleCategory(cat))
            {
                return !string.IsNullOrWhiteSpace(cat.shortname) ? cat.shortname.Trim() : "CAP";
            }
        }

        var pcat = GetItemParentCategory(item);
        if (pcat != null)
        {
            if (IsTabletParentCategory(pcat))
            {
                return !string.IsNullOrWhiteSpace(pcat.shortname) ? pcat.shortname.Trim() : "TAB";
            }
            if (IsCapsuleParentCategory(pcat))
            {
                return !string.IsNullOrWhiteSpace(pcat.shortname) ? pcat.shortname.Trim() : "CAP";
            }
        }

        // 2. Lookup by uomcode in allUoms (from /api/ItemMaster/getalluom, e.g. ucode 59 -> "ml")
        if (item.uomcode > 0 && allUoms != null && allUoms.Count > 0)
        {
            var uom = allUoms.FirstOrDefault(u => 
                u.ucode == item.uomcode || 
                (long)u.ucode == (long)item.uomcode || 
                (int)u.ucode == item.uomcode ||
                u.uomcode == item.uomcode ||
                u.unitcode == item.uomcode ||
                (long)u.uomcode == (long)item.uomcode);
            if (uom != null)
            {
                if (!string.IsNullOrWhiteSpace(uom.shortname))
                    return uom.shortname.Trim();
                if (!string.IsNullOrWhiteSpace(uom.name))
                    return uom.name.Trim();
            }
        }

        // 3. If category has a shortname (e.g. SYR, INJ, etc.)
        if (cat != null && !string.IsNullOrWhiteSpace(cat.shortname))
        {
            return cat.shortname.Trim();
        }

        // 4. Direct textual unit if present on item_master
        if (!string.IsNullOrWhiteSpace(item.uomshortname)) return item.uomshortname.Trim();
        if (!string.IsNullOrWhiteSpace(item.uom)) return item.uom.Trim();
        if (!string.IsNullOrWhiteSpace(item.unit)) return item.unit.Trim();
        if (!string.IsNullOrWhiteSpace(item.uomname)) return item.uomname.Trim();

        // 5. Match packaging against allUoms
        if (!string.IsNullOrWhiteSpace(item.packaging))
        {
            var cleanPack = item.packaging.Trim();
            if (allUoms != null && allUoms.Count > 0)
            {
                var uom = allUoms.FirstOrDefault(u => 
                    (!string.IsNullOrWhiteSpace(u.shortname) && u.shortname.Trim().Equals(cleanPack, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(u.name) && u.name.Trim().Equals(cleanPack, StringComparison.OrdinalIgnoreCase)));
                if (uom != null)
                {
                    return !string.IsNullOrWhiteSpace(uom.shortname) ? uom.shortname.Trim() : (uom.name?.Trim() ?? "");
                }
            }
            return cleanPack;
        }

        // 6. Fallback for common uomcode 59 -> "ml"
        if (item.uomcode == 59)
        {
            return "ml";
        }

        return "";
    }

    private string GetItemUomMeasureByCodeOrName(decimal? itemCode, string? drugName)
    {
        if (itemCode.HasValue && itemCode.Value > 0)
        {
            long codeLong = (long)itemCode.Value;
            var master = allItems.FirstOrDefault(x => x.itemcode == codeLong);
            if (master != null)
            {
                var measure = GetItemUomMeasure(master);
                if (!string.IsNullOrWhiteSpace(measure)) return measure;
            }
        }
        if (!string.IsNullOrWhiteSpace(drugName))
        {
            var clean = drugName.Trim();
            var master = allItems.FirstOrDefault(x => !x.deleted && (
                (!string.IsNullOrWhiteSpace(x.drugname) && x.drugname.Trim().Equals(clean, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.itemname) && x.itemname.Trim().Equals(clean, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.shortname) && x.shortname.Trim().Equals(clean, StringComparison.OrdinalIgnoreCase))));
            if (master == null)
            {
                master = allItems.FirstOrDefault(x => !x.deleted && (
                    (!string.IsNullOrWhiteSpace(x.drugname) && x.drugname.Trim().StartsWith(clean, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(x.itemname) && x.itemname.Trim().StartsWith(clean, StringComparison.OrdinalIgnoreCase))));
            }
            if (master == null && clean.Length >= 3)
            {
                master = allItems.FirstOrDefault(x => !x.deleted && (
                    (!string.IsNullOrWhiteSpace(x.drugname) && (x.drugname.Contains(clean, StringComparison.OrdinalIgnoreCase) || clean.Contains(x.drugname.Trim(), StringComparison.OrdinalIgnoreCase))) ||
                    (!string.IsNullOrWhiteSpace(x.itemname) && (x.itemname.Contains(clean, StringComparison.OrdinalIgnoreCase) || clean.Contains(x.itemname.Trim(), StringComparison.OrdinalIgnoreCase)))));
            }
            if (master != null)
            {
                var measure = GetItemUomMeasure(master);
                if (!string.IsNullOrWhiteSpace(measure)) return measure;
            }
        }
        return "";
    }

    private decimal CalculateItemUnitCost(item_master? item)
    {
        if (item == null) return 0;
        if (item.mrp > 0)
        {
            decimal packSize = item.packsize > 0 ? item.packsize : 1;
            return Math.Round(item.mrp / packSize, 2);
        }
        if (item.salesrate > 0)
        {
            decimal packSize = item.packsize > 0 ? item.packsize : 1;
            return Math.Round(item.salesrate / packSize, 2);
        }
        if (item.purchaserate > 0)
        {
            decimal packSize = item.packsize > 0 ? item.packsize : 1;
            return Math.Round(item.purchaserate / packSize, 2);
        }
        return 0;
    }

    private void SelectInlineDrugCode(CaseSheetPrescriptionItem item, item_master res, string? batchNo = null, decimal? batchMrp = null, decimal? batchPurRate = null)
    {
        decimal mrpPrice = (batchMrp.HasValue && batchMrp.Value > 0)
            ? batchMrp.Value
            : CalculateItemUnitCost(res);
        item.drug_name = !string.IsNullOrWhiteSpace(res.drugname) ? res.drugname : res.itemname;
        item.drug_code = res.itemcode;
        item.generic_name = res.description; 
        item.mrp = mrpPrice;
        item.rate = mrpPrice;
        if (!string.IsNullOrWhiteSpace(batchNo) && batchNo != "-")
        {
            item.batchno = batchNo;
            item.batch_no = batchNo;
        }
        else
        {
            item.batchno = null;
            item.batch_no = null;
        }
        
        var catObj = GetItemCategory(res);
        if (catObj != null && !string.IsNullOrWhiteSpace(catObj.categoryname))
        {
            item.drug_category = catObj.categoryname;
        }

        var uomMeasure = GetItemUomMeasure(res);
        if (!string.IsNullOrWhiteSpace(uomMeasure))
        {
            item.dose_unit = uomMeasure;
        }

        if (IsTabletOrCapsuleMaster(res, item))
        {
            CalculateItemDrugQty(item);
        }
        else
        {
            item.qty = 1;
        }

        inlineDrugSearchResults.Clear();
        activeInlineDrugSno = 0;
    }

    private decimal GetItemAvailableStock(decimal? itemCode, string? drugName = null, string? batchNo = null)
    {
        if (itemCode.HasValue && itemCode.Value > 0)
        {
            long codeLong = (long)itemCode.Value;
            if (allStocks.Count > 0)
            {
                var matchingStocks = allStocks.Where(s => s.itemcode == codeLong && !s.deleted);
                if (!string.IsNullOrWhiteSpace(batchNo) && batchNo != "-")
                {
                    matchingStocks = matchingStocks.Where(s => string.Equals(s.batchno?.Trim(), batchNo.Trim(), StringComparison.OrdinalIgnoreCase));
                }
                var list = matchingStocks.ToList();
                if (list.Count > 0)
                {
                    return list.Sum(s => s.closingstock);
                }
            }

            var master = allItems.FirstOrDefault(x => x.itemcode == codeLong);
            if (master != null)
            {
                return master.currentstock;
            }
        }
        else if (!string.IsNullOrWhiteSpace(drugName))
        {
            var master = allItems.FirstOrDefault(x => 
                (x.drugname != null && x.drugname.Equals(drugName, StringComparison.OrdinalIgnoreCase)) ||
                (x.itemname != null && x.itemname.Equals(drugName, StringComparison.OrdinalIgnoreCase)));
            if (master != null)
            {
                if (allStocks.Count > 0)
                {
                    var matchingStocks = allStocks.Where(s => s.itemcode == master.itemcode && !s.deleted);
                    if (!string.IsNullOrWhiteSpace(batchNo) && batchNo != "-")
                    {
                        matchingStocks = matchingStocks.Where(s => string.Equals(s.batchno?.Trim(), batchNo.Trim(), StringComparison.OrdinalIgnoreCase));
                    }
                    var list = matchingStocks.ToList();
                    if (list.Count > 0)
                    {
                        return list.Sum(s => s.closingstock);
                    }
                }
                return master.currentstock;
            }
        }
        return 0;
    }

    private decimal GetItemUnitPrice(CaseSheetPrescriptionItem item)
    {
        if (item == null) return 0;

        // 1. If item.mrp is already set and > 0, return MRP price
        if (item.mrp.HasValue && item.mrp.Value > 0)
        {
            return item.mrp.Value;
        }

        // Resolve item master by drug_code or drug_name
        item_master? master = null;
        if (item.drug_code.HasValue && item.drug_code.Value > 0)
        {
            master = allItems?.FirstOrDefault(x => x.itemcode == (int)item.drug_code.Value);
        }
        if (master == null && !string.IsNullOrWhiteSpace(item.drug_name))
        {
            master = allItems?.FirstOrDefault(x => 
                (x.drugname != null && x.drugname.Equals(item.drug_name, StringComparison.OrdinalIgnoreCase)) ||
                (x.itemname != null && x.itemname.Equals(item.drug_name, StringComparison.OrdinalIgnoreCase)));
        }

        long targetItemCode = (item.drug_code.HasValue && item.drug_code.Value > 0)
            ? (long)item.drug_code.Value
            : (master != null ? master.itemcode : 0);

        // 2. If batch is specified, lookup batch stock for mrpunit
        if (targetItemCode > 0 && !string.IsNullOrWhiteSpace(item.batchno) && item.batchno != "-" && allStocks != null && allStocks.Count > 0)
        {
            var matchingStock = allStocks.FirstOrDefault(s =>
                !s.deleted &&
                s.itemcode == targetItemCode &&
                string.Equals(s.batchno?.Trim(), item.batchno.Trim(), StringComparison.OrdinalIgnoreCase));

            if (matchingStock != null && matchingStock.mrpunit > 0)
            {
                item.mrp = matchingStock.mrpunit;
                return matchingStock.mrpunit;
            }
        }

        // 3. From item master get unit MRP price
        if (master != null)
        {
            var calculated = CalculateItemUnitCost(master);
            if (calculated > 0)
            {
                item.mrp = calculated;
                return calculated;
            }
        }

        // 4. Any stock batch for this itemcode that has mrpunit > 0
        if (targetItemCode > 0 && allStocks != null && allStocks.Count > 0)
        {
            var anyStock = allStocks.FirstOrDefault(s => s.itemcode == targetItemCode && !s.deleted && s.mrpunit > 0);
            if (anyStock != null && anyStock.mrpunit > 0)
            {
                item.mrp = anyStock.mrpunit;
                return anyStock.mrpunit;
            }
        }

        // 5. Fallback to rate if available
        if (item.rate.HasValue && item.rate.Value > 0)
        {
            return item.rate.Value;
        }

        return 0;
    }

    private decimal GetItemTotalAmount(CaseSheetPrescriptionItem item)
    {
        decimal qty = item.qty ?? 0;
        decimal unitPrice = GetItemUnitPrice(item);
        return qty * unitPrice;
    }

    public class LivePreviewPrescriptionGroup
    {
        public int Index { get; set; }
        public string Title { get; set; } = "";
        public string? PrCode { get; set; }
        public string? PrId { get; set; }
        public string? TimeStr { get; set; }
        public string? TopRemarks { get; set; }
        public string? BottomRemarks { get; set; }
        public bool IsActiveEditing { get; set; }
        public List<CaseSheetPrescriptionItem> Items { get; set; } = new();
    }

    private List<LivePreviewPrescriptionGroup> GetLivePreviewPrescriptionGroups()
    {
        var groups = new List<LivePreviewPrescriptionGroup>();

        if (prescriptionsList != null && prescriptionsList.Count > 0)
        {
            for (int i = 0; i < prescriptionsList.Count; i++)
            {
                var p = prescriptionsList[i];
                int entryIndex = i + 1;
                string codeLabel = !string.IsNullOrEmpty(p.pr_code) ? p.pr_code : $"Prescription #{entryIndex}";
                string timeStr = (p.pr_date.HasValue && p.pr_date.Value != default)
                    ? (DateTimeHelper.ConvertUtcToIst(p.pr_date.Value)?.ToString("hh:mm tt") ?? "")
                    : "";

                bool isActive = (activePrescription == p && isEditingPrescription);

                var grp = new LivePreviewPrescriptionGroup
                {
                    Index = entryIndex,
                    Title = $"Rx #{entryIndex} ({codeLabel}{(string.IsNullOrEmpty(timeStr) ? "" : $" - {timeStr}")})",
                    PrCode = p.pr_code,
                    PrId = p.pr_id,
                    TimeStr = timeStr,
                    IsActiveEditing = isActive
                };

                if (isActive && currentRequest.prescription?.items != null)
                {
                    grp.Items = currentRequest.prescription.items
                        .Where(it => !string.IsNullOrWhiteSpace(it.drug_name))
                        .ToList();
                    grp.TopRemarks = prescriptionRemarks.topremarks;
                    grp.BottomRemarks = prescriptionRemarks.bottonremarks;
                }
                else
                {
                    grp.Items = p.items != null ? p.items
                        .Where(it => !string.IsNullOrWhiteSpace(it.drug_name))
                        .Select((it, idx) => new CaseSheetPrescriptionItem
                        {
                            sno = idx + 1,
                            drug_name = it.drug_name ?? "",
                            drug_code = it.drug_code,
                            generic_name = it.generic_name,
                            morning = it.morning,
                            afternoon = it.afternoon,
                            evening = it.evening,
                            night = it.night,
                            morning_dose = it.morning_dose,
                            afternoon_dose = it.afternoon_dose,
                            evening_dose = it.evening_dose,
                            night_dose = it.night_dose,
                            dose_unit = it.dose_unit,
                            before_food = it.before_food,
                            after_food = it.after_food,
                            days = it.days,
                            duration = it.duration,
                            qty = it.qty,
                            rate = it.rate,
                            mrp = it.mrp,
                            notes = it.notes
                        }).ToList() : new List<CaseSheetPrescriptionItem>();
                    grp.TopRemarks = p.topremarks;
                    grp.BottomRemarks = p.bottonremarks;
                }

                if (grp.Items.Any())
                {
                    groups.Add(grp);
                }
            }

            if (!isEditingPrescription && currentRequest.prescription?.items != null)
            {
                var newItems = currentRequest.prescription.items
                    .Where(it => !string.IsNullOrWhiteSpace(it.drug_name))
                    .ToList();
                if (newItems.Any())
                {
                    groups.Add(new LivePreviewPrescriptionGroup
                    {
                        Index = prescriptionsList.Count + 1,
                        Title = $"Rx #{prescriptionsList.Count + 1} (New - Unsaved)",
                        PrCode = null,
                        PrId = activePrescription?.pr_id,
                        IsActiveEditing = true,
                        Items = newItems,
                        TopRemarks = prescriptionRemarks.topremarks,
                        BottomRemarks = prescriptionRemarks.bottonremarks
                    });
                }
            }
        }
        else if (currentRequest.prescription?.items != null)
        {
            var singleItems = currentRequest.prescription.items
                .Where(it => !string.IsNullOrWhiteSpace(it.drug_name))
                .ToList();
            if (singleItems.Any())
            {
                groups.Add(new LivePreviewPrescriptionGroup
                {
                    Index = 1,
                    Title = !string.IsNullOrEmpty(currentRequest.prescription.pr_code)
                        ? $"Rx #1 ({currentRequest.prescription.pr_code})"
                        : "Rx #1",
                    PrCode = currentRequest.prescription.pr_code,
                    PrId = currentRequest.prescription.pr_id,
                    IsActiveEditing = true,
                    Items = singleItems,
                    TopRemarks = prescriptionRemarks.topremarks,
                    BottomRemarks = prescriptionRemarks.bottonremarks
                });
            }
        }

        return groups;
    }

    private decimal GetActivePrescriptionTotalAmount()
    {
        if (currentRequest.prescription?.items == null || currentRequest.prescription.items.Count == 0)
            return 0;

        return currentRequest.prescription.items.Sum(i => GetItemTotalAmount(i));
    }

    private decimal GetTotalPrescriptionAmount()
    {
        var groups = GetLivePreviewPrescriptionGroups();
        if (groups != null && groups.Any())
        {
            return groups.SelectMany(g => g.Items).Sum(i => GetItemTotalAmount(i));
        }

        return GetActivePrescriptionTotalAmount();
    }

    private decimal GetPastVisitPrescriptionAmount(CaseSheetViewModel? pastVisit)
    {
        if (pastVisit == null) return 0;
        if (pastVisit.prescription_list != null && pastVisit.prescription_list.Any())
        {
            return pastVisit.prescription_list
                .Where(p => p.items != null)
                .SelectMany(p => p.items)
                .Sum(i => {
                    decimal qty = i.qty ?? 0;
                    decimal price = ((i.mrp.HasValue && i.mrp.Value > 0) ? i.mrp.Value : 
                                    ((i.rate.HasValue && i.rate.Value > 0) ? i.rate.Value : 0));
                    return qty * price;
                });
        }
        if (pastVisit.prescription?.items == null || pastVisit.prescription.items.Count == 0)
            return 0;

        return pastVisit.prescription.items.Sum(i => {
            decimal qty = i.qty ?? 0;
            decimal price = ((i.mrp.HasValue && i.mrp.Value > 0) ? i.mrp.Value : 
                            ((i.rate.HasValue && i.rate.Value > 0) ? i.rate.Value : 0));
            return qty * price;
        });
    }

    private async Task SearchTestInline(CaseSheetInvestigationItem item, string query)
    {
        activeInlineTestSno = item.sno;
        item.test_name = query; // bind user input temporarily to test_name
        
        if (allTestMasters.Count == 0)
        {
            try
            {
                var tests = await LabCareTestService.GetAllTestsAsync();
                allTestMasters = tests.Where(t => !string.IsNullOrWhiteSpace(t.name)).ToList();
            }
            catch { }
        }

        if (!string.IsNullOrWhiteSpace(query))
        {
            var lowerQuery = query.Trim().ToLower();
            inlineTestSearchResults = allTestMasters
                .Where(x => x.name != null && x.name.ToLower().Contains(lowerQuery))
                .Take(15)
                .ToList();
        }
        else
        {
            inlineTestSearchResults.Clear();
        }
    }

