    private OpInvestigationDetailModel? GetSavedInvestigationDetail(int sno)
    {
        if (rawLoadedSheet != null && rawLoadedSheet.investigation != null)
        {
            return rawLoadedSheet.investigation.tests.FirstOrDefault(t => t.sno == sno);
        }
        return null;
    }

    private async Task SaveTestResultAsync(Guid invDetId)
    {
        var key = invDetId.ToString();
        resultValueCache.TryGetValue(key, out var val);
        resultNotesCache.TryGetValue(key, out var notes);

        if (string.IsNullOrWhiteSpace(val))
        {
            ToastService.ShowError("Please fill in the result value.");
            return;
        }

        savingData = true;
        var req = new UpdateInvestigationResultRequest
        {
            inv_det_id = key,
            result_value = val,
            result_notes = notes,
            result_status = "COMPLETED"
        };

        var result = await CaseSheetService.UpdateInvestigationResultAsync(req);
        savingData = false;

        if (result)
        {
            ToastService.ShowSuccess("Lab result saved successfully.");
            // Reload the case sheet to display updated test results
            var existingSheet = await CaseSheetService.GetCaseSheetByVisitAsync(OpId);
            rawLoadedSheet = existingSheet;
            if (existingSheet != null)
            {
                LoadFromViewModel(existingSheet);
            }
            StateHasChanged();
        }
        else
        {
            ToastService.ShowError("Failed to update test result.");
        }
    }

    // --- Patient History Pagination ---
    private async Task LoadPatientHistoryAsync()
    {
        loadingHistory = true;
        StateHasChanged();
        patientHistory = await CaseSheetService.GetPatientHistoryAsync(CustId, historyPage, historyPageSize);
        loadingHistory = false;
        StateHasChanged();
