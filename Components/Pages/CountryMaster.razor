@page "/country-master"
@rendermode InteractiveServer
@using Medico_Backend.Model
@using Booking.Services
@inject CountryMasterService CountryService
@inject ToastService ToastService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@implements IDisposable

<div class="cm-page">
    <!-- Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <h1 class="cm-title">Country Master</h1>
            <span class="cm-subtitle">Location Configuration</span>
        </div>
        <div class="cm-header-right">
            <div class="cm-search-box">
                <i class="bi bi-search cm-search-icon"></i>
                <input type="text" class="cm-search-input" placeholder="Quick find..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            @if (TenantState.HasActionRight("Configuration", "General", "Create")) { <button class="cm-btn-new" @onclick="OpenNewCountryModal">
                + New Country Entry
            </button> }
        </div>
    </div>

    <!-- Table -->
    <div class="cm-table-card">
        <table class="cm-table">
            <thead>
                <tr>
                    <th>ORDER NO</th>
                    <th>SHORT NAME</th>
                    <th>COUNTRY NAME</th>
                    <th>DESCRIPTION</th>
                    <th>ENTERED DATE</th>
                    <th>MODIFIED DATE</th>
                    <th>ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredCountries.Any())
                {
                    @foreach (var (item, index) in PaginatedCountries.Select((c, i) => (c, i)))
                    {
                        <tr>
                            <td class="col-orderno">@(((currentPage - 1) * pageSize) + index + 1)</td>
                            <td class="col-shortname">@item.shortname</td>
                            <td class="col-name">
                                <span class="counter-name-text">@item.countryname</span>
                            </td>
                            <td class="col-narration">@item.description</td>
                            <td class="col-date-entered">
                                <span class="date-line">@item.entereddate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.entereddate.ToString("tt") == "AM" ? "am" : "pm")">@item.entereddate.ToString("tt")</span>
                            </td>
                            <td class="col-date-modified">
                                <span class="date-line">@item.ibsdate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.ibsdate.ToString("tt") == "AM" ? "am" : "pm")">@item.ibsdate.ToString("tt")</span>
                            </td>
                            <td class="col-action">
                                @if (TenantState.HasActionRight("Configuration", "General", "Edit")) {
                                <button class="cm-action-btn edit" title="Edit" @onclick="() => EditCountry(item)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                }
                                @if (TenantState.HasActionRight("Configuration", "General", "Delete")) {
                                <button class="cm-action-btn delete" title="Delete" @onclick="() => DeleteCountry(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="cm-empty-row">
                            <i class="bi bi-display"></i>
                            <div>No countries found</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (FilteredCountries.Any())
        {
            <div class="cm-table-footer">
                <div class="cm-pagination-info">
                    Showing <strong>@(((currentPage - 1) * pageSize) + 1)</strong> to <strong>@(Math.Min(currentPage * pageSize, FilteredCountries.Count()))</strong> of <strong>@FilteredCountries.Count()</strong> entries
                </div>
                @if (TotalPages > 1)
                {
                    <div class="cm-pagination-controls">
                        <button type="button" class="cm-pg-btn" disabled="@(currentPage <= 1)" @onclick="() => ChangePage(currentPage - 1)">
                            &lsaquo; Previous
                        </button>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNum = i;
                            <button type="button" class="cm-pg-btn @(currentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                @pageNum
                            </button>
                        }
                        <button type="button" class="cm-pg-btn" disabled="@(currentPage >= TotalPages)" @onclick="() => ChangePage(currentPage + 1)">
                            Next &rsaquo;
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (showModal)
{
    <div class="cm-backdrop">
        <div class="cm-modal">
            <div class="cm-modal-header">
                <h2 class="cm-modal-title">@(isEditMode ? "Edit Country Entry" : "New Country Entry")</h2>
                <button class="cm-close-btn" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body">
                <!-- Row 1: Country Name, Short Name -->
                <div class="cm-form-row two-cols">
                    <div class="cm-field-group" style="position: relative;">
                        <label class="cm-label">Country Name <span style="color: #ef4444;">*</span></label>
                        <input @ref="countryNameInput"
                               type="text" 
                               class="cm-input" 
                               placeholder="Ex: India" 
                               value="@currentCountry.countryname" 
                               @oninput="OnCountryNameInput"
                               @onfocus="() => showCountryDropdown = true"
                               @onblur="OnCountryNameBlur"
                               @onkeydown="OnCountryNameKeyDown" />

                        @if (showCountryDropdown && CountrySuggestions.Any())
                        {
                            <div class="cm-autocomplete-dropdown">
                                @foreach (var item in CountrySuggestions)
                                {
                                    <div class="cm-dropdown-item" @onmousedown="() => SelectCountry(item)">
                                        <span class="cm-dropdown-title">@item.countryname</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Short Name</label>
                        <input @ref="shortNameInput"
                               type="text" 
                               class="cm-input" 
                               placeholder="Ex: IND" 
                               @bind="currentCountry.shortname" 
                               @bind:event="oninput"
                               @onkeydown="OnShortNameKeyDown" />
                    </div>
                </div>

                <!-- Row 2: Description -->
                <div class="cm-form-row full-width">
                    <div class="cm-field-group">
                        <label class="cm-label">Country Description</label>
                        <input @ref="descInput"
                               type="text" 
                               class="cm-input" 
                               placeholder="Specify any specific instructions..." 
                               @bind="currentCountry.description" 
                               @bind:event="oninput"
                               @onkeydown="OnDescKeyDown" />
                    </div>
                </div>
            </div>

            <div class="cm-modal-footer">
                @if (isEditMode)
                {
                    <button class="cm-btn-delete" @onclick="() => DeleteCountry(currentCountry)">Delete</button>
                }
                else
                {
                    <span></span>
                }
                <div class="cm-footer-right-buttons" style="display: flex; gap: 0.75rem; align-items: center;">
                    <button class="cm-btn-cancel" @onclick="CloseModal">Cancel</button>
                    <button class="cm-btn-save" @onclick="SaveCountry">
                        <i class="bi bi-check2"></i> Save Country
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CountryMasterModel> countries = new();
    private int currentPage = 1;
    private int pageSize = 10;

    private int TotalPages => (int)Math.Ceiling((double)FilteredCountries.Count() / pageSize);

    private IEnumerable<CountryMasterModel> PaginatedCountries =>
        FilteredCountries.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= Math.Max(1, TotalPages))
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private string _searchQuery = "";
    private string searchQuery
    {
        get => _searchQuery;
        set
        {
            if (_searchQuery != value)
            {
                _searchQuery = value;
                currentPage = 1;
            }
        }
    }

    private IEnumerable<CountryMasterModel> FilteredCountries =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? countries
            : countries.Where(c => 
                (c.countryname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.shortname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
    private bool showModal = false;
    private bool isEditMode = false;
    private CountryMasterModel currentCountry = new();
    private bool showCountryDropdown = false;

    private IEnumerable<CountryMasterModel> CountrySuggestions =>
        string.IsNullOrWhiteSpace(currentCountry.countryname)
            ? Enumerable.Empty<CountryMasterModel>()
            : countries.Where(c => c.countryname != null && c.countryname.Contains(currentCountry.countryname, StringComparison.OrdinalIgnoreCase)).Take(8);

    private void OnCountryNameInput(ChangeEventArgs e)
    {
        string typed = e.Value?.ToString() ?? "";
        currentCountry.countryname = typed;
        showCountryDropdown = true;

        if (string.IsNullOrWhiteSpace(typed))
        {
            isEditMode = false;
            currentCountry.countrycode = 0;
            return;
        }

        var match = countries.FirstOrDefault(c => string.Equals(c.countryname, typed, StringComparison.OrdinalIgnoreCase));
        if (match != null)
        {
            EditCountry(match);
        }
    }

    private void SelectCountry(CountryMasterModel item)
    {
        EditCountry(item);
        showCountryDropdown = false;
    }

    private async Task OnCountryNameBlur()
    {
        await Task.Delay(250);
        showCountryDropdown = false;
    }

    protected override async Task OnInitializedAsync()
    {
        TenantState.OnSessionChanged += HandleSessionChanged;
        await LoadCountries();
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadCountries();
            StateHasChanged();
        });
    }

    private async Task LoadCountries()
    {
        try
        {
            var res = await CountryService.GetCountriesAsync();
            if (res != null)
            {
                var tenant = TenantState.TenantCode;
                var list = res.Where(c => string.IsNullOrEmpty(tenant) || string.IsNullOrEmpty(c.tenant_code) || string.Equals(c.tenant_code, tenant, StringComparison.OrdinalIgnoreCase)).ToList();

                // Order by entered date (in the order they are entered), fallback to countrycode
                countries = list.OrderBy(c => c.entereddate == default ? DateTime.MinValue : c.entereddate).ThenBy(c => c.countrycode).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load countries: {ex.Message}");
        }
    }

    private ElementReference countryNameInput;
    private ElementReference shortNameInput;
    private ElementReference descInput;
    private bool shouldFocusFirstInput = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusFirstInput)
        {
            shouldFocusFirstInput = false;
            try
            {
                await Task.Delay(50);
                await countryNameInput.FocusAsync();
            }
            catch { }
        }
    }

    private async Task OnCountryNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            showCountryDropdown = false;
            await shortNameInput.FocusAsync();
        }
    }

    private async Task OnShortNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await descInput.FocusAsync();
        }
    }

    private async Task OnDescKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveCountry();
        }
    }

    private void OpenNewCountryModal()
    {
        int nextOrderNo = countries.Count + 1;

        currentCountry = new CountryMasterModel 
        { 
            orderno = nextOrderNo,
            tenant_code = !string.IsNullOrEmpty(TenantState.TenantCode) ? TenantState.TenantCode : ""
        };
        isEditMode = false;
        showModal = true;
        shouldFocusFirstInput = true;
    }

    private void EditCountry(CountryMasterModel country)
    {
        currentCountry = new CountryMasterModel
        {
            countrycode = country.countrycode,
            tenant_code = country.tenant_code,
            orderno = country.orderno,
            shortname = country.shortname,
            countryname = country.countryname,
            description = country.description,
            entereddate = country.entereddate,
            ibsdate = country.ibsdate
        };
        isEditMode = true;
        showModal = true;
        shouldFocusFirstInput = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveCountry()
    {
        if (string.IsNullOrWhiteSpace(currentCountry.countryname))
        {
            ToastService.ShowWarning("Please enter a valid Country Name.");
            return;
        }

        try
        {
            bool success;
            if (isEditMode)
            {
                currentCountry.ibsdate = DateTime.Now;
                success = await CountryService.UpdateCountryAsync(currentCountry);
            }
            else
            {
                currentCountry.entereddate = DateTime.Now;
                currentCountry.ibsdate = DateTime.Now;
                currentCountry.tenant_code = !string.IsNullOrEmpty(TenantState.TenantCode) ? TenantState.TenantCode : (currentCountry.tenant_code ?? "");
                
                // Auto-generate order no based on total count of records in this tenant (+1)
                currentCountry.orderno = countries.Count + 1;

                success = await CountryService.InsertCountryAsync(currentCountry);
            }

            if (success)
            {
                ToastService.ShowSuccess("Country saved successfully.");
                showModal = false;
                await LoadCountries();
            }
            else
            {
                ToastService.ShowError("Failed to save country.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task DeleteCountry(CountryMasterModel country)
    {
        try
        {
            bool success = await CountryService.DeleteCountryAsync(country.countrycode);
            if (success)
            {
                ToastService.ShowSuccess("Country deleted successfully.");
                if (showModal) showModal = false;
                await LoadCountries();
            }
            else
            {
                ToastService.ShowError("Failed to delete country.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    public void Dispose()
    {
        TenantState.OnSessionChanged -= HandleSessionChanged;
    }
}
