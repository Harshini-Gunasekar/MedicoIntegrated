@page "/country-master"
@rendermode InteractiveServer
@using Medico_Backend.Model
@using Booking.Services
@inject CountryMasterService CountryService
@inject ToastService ToastService

<div class="cm-page">
    <!-- Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <h1 class="cm-title">Country Master</h1>
            <span class="cm-subtitle">Location Configuration</span>
        </div>
        <div class="cm-header-right">
            <div class="cm-search-box">
                <i class="bi bi-search cm-search-icon"></i>
                <input type="text" class="cm-search-input" placeholder="Quick find..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            <button class="cm-btn-new" @onclick="OpenNewCountryModal">
                + New Country Entry
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="cm-table-card">
        <table class="cm-table">
            <thead>
                <tr>
                    <th>ORDER NO</th>
                    <th>SHORT NAME</th>
                    <th>COUNTRY NAME</th>
                    <th>DESCRIPTION</th>
                    <th>ENTERED DATE</th>
                    <th>MODIFIED DATE</th>
                    <th>ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredCountries.Any())
                {
                    @foreach (var item in FilteredCountries)
                    {
                        <tr>
                            <td class="col-orderno">@item.orderno</td>
                            <td class="col-shortname">@item.shortname</td>
                            <td class="col-name">
                                <span class="counter-name-text">@item.countryname</span>
                            </td>
                            <td class="col-narration">@item.description</td>
                            <td class="col-date-entered">
                                <span class="date-line">@item.entereddate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.entereddate.ToString("tt") == "AM" ? "am" : "pm")">@item.entereddate.ToString("tt")</span>
                            </td>
                            <td class="col-date-modified">
                                <span class="date-line">@item.ibsdate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.ibsdate.ToString("tt") == "AM" ? "am" : "pm")">@item.ibsdate.ToString("tt")</span>
                            </td>
                            <td class="col-action">
                                <button class="cm-action-btn edit" title="Edit" @onclick="() => EditCountry(item)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="cm-action-btn delete" title="Delete" @onclick="() => DeleteCountry(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="cm-empty-row">
                            <i class="bi bi-display"></i>
                            <div>No countries found</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showModal)
{
    <div class="cm-backdrop">
        <div class="cm-modal">
            <div class="cm-modal-header">
                <h2 class="cm-modal-title">@(isEditMode ? "Edit Country Entry" : "New Country Entry")</h2>
                <button class="cm-close-btn" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body">
                <!-- Row 1: Country Name, Display Order -->
                <div class="cm-form-row two-cols-wide-narrow">
                    <div class="cm-field-group">
                        <label class="cm-label">Country Name</label>
                        <input type="text" class="cm-input" placeholder="Ex: India" @bind="currentCountry.countryname" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Display Order</label>
                        <input type="text" class="cm-input" placeholder="20" @bind="displayOrderString" />
                    </div>
                </div>

                <!-- Row 2: Short Name, Description -->
                <div class="cm-form-row two-cols-narrow-wide">
                    <div class="cm-field-group">
                        <label class="cm-label">Short Name</label>
                        <input type="text" class="cm-input" placeholder="Ex: IND" @bind="currentCountry.shortname" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Country Description</label>
                        <input type="text" class="cm-input" placeholder="Specify any specific instructions..." @bind="currentCountry.description" />
                    </div>
                </div>
            </div>

            <div class="cm-modal-footer">
                @if (isEditMode)
                {
                    <button class="cm-btn-delete" @onclick="() => DeleteCountry(currentCountry)">Delete</button>
                }
                else
                {
                    <span></span>
                }
                <div class="cm-footer-right-buttons" style="display: flex; gap: 0.75rem; align-items: center;">
                    <button class="cm-btn-cancel" @onclick="CloseModal">Cancel</button>
                    <button class="cm-btn-save" @onclick="SaveCountry">
                        <i class="bi bi-check2"></i> Save Country
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CountryMasterModel> countries = new();
    private string searchQuery = "";
    private bool showModal = false;
    private bool isEditMode = false;
    private CountryMasterModel currentCountry = new();

    private string displayOrderString
    {
        get => currentCountry.orderno == 0 ? "" : currentCountry.orderno.ToString();
        set => currentCountry.orderno = int.TryParse(value, out var v) ? v : 0;
    }

    private IEnumerable<CountryMasterModel> FilteredCountries =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? countries
            : countries.Where(c => 
                (c.countryname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.shortname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadCountries();
    }

    private async Task LoadCountries()
    {
        try
        {
            var res = await CountryService.GetCountriesAsync();
            if (res != null)
            {
                countries = res.Where(c => !string.IsNullOrEmpty(c.tenant_code)).OrderBy(c => c.orderno).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load countries: {ex.Message}");
        }
    }

    private void OpenNewCountryModal()
    {
        currentCountry = new CountryMasterModel { orderno = 0 };
        isEditMode = false;
        showModal = true;
    }

    private void EditCountry(CountryMasterModel country)
    {
        currentCountry = new CountryMasterModel
        {
            countrycode = country.countrycode,
            tenant_code = country.tenant_code,
            orderno = country.orderno,
            shortname = country.shortname,
            countryname = country.countryname,
            description = country.description
        };
        isEditMode = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveCountry()
    {
        try
        {
            bool success;
            if (isEditMode)
            {
                success = await CountryService.UpdateCountryAsync(currentCountry);
            }
            else
            {
                currentCountry.entereddate = DateTime.Now;
                currentCountry.ibsdate = DateTime.Now;
                currentCountry.tenant_code = "TEN1011";
                success = await CountryService.InsertCountryAsync(currentCountry);
            }

            if (success)
            {
                ToastService.ShowSuccess("Country saved successfully.");
                showModal = false;
                await LoadCountries();
            }
            else
            {
                ToastService.ShowError("Failed to save country.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task DeleteCountry(CountryMasterModel country)
    {
        try
        {
            bool success = await CountryService.DeleteCountryAsync(country.countrycode);
            if (success)
            {
                ToastService.ShowSuccess("Country deleted successfully.");
                if (showModal) showModal = false;
                await LoadCountries();
            }
            else
            {
                ToastService.ShowError("Failed to delete country.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }
}
