@page "/indentrequest"
@page "/indent-request"
@using Booking.Models
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject NavigationManager NavigationManager

<style>
    @@keyframes blinker {
        50% { opacity: 0.3; }
    }
    .custom-typeahead-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1000;
        max-height: 200px;
        overflow-y: auto;
        background: white;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        margin-top: 2px;
    }
    .custom-typeahead-item {
        padding: 6px 10px;
        cursor: pointer;
        font-size: 0.75rem;
        text-align: left;
        color: #1e293b;
        transition: background-color 0.2s;
    }
    .custom-typeahead-item:hover {
        background-color: #f1f5f9;
        color: #02659e;
    }
</style>

<div class="items-page indent-page pt-0 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Indent Request</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total indents : @IndentList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by Indent No or Dept" @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    @if (hasCreateRight)
                    {
                        <button class="add-item-btn ms-2" @onclick="AddNewIndent">
                            <i class="bi bi-plus-lg"></i>
                            <span class="ms-1">New Indent</span>
                        </button>
                    }
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredIndents.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-file-earmark-text fs-1 d-block mb-3"></i>
                        No stock indents found. Click "New Indent" to create a stock request.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">S.NO</th>
                                    <th>INDENT CODE</th>
                                    <th>INDENT NO</th>
                                    <th>INDENT DATE</th>
                                    <th>STORE</th>
                                    <th>STATUS</th>
                                    <th style="width: 100px;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedIndents.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td>@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td class="fw-bold text-primary">#@row.value.indentcode</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.value.indentno) ? "N/A" : row.value.indentno)</td>
                                        <td>@row.value.indentdate.ToString("yyyy-MM-dd")</td>
                                        <td>@GetStoreName(row.value.departmentcode)</td>
                                        <td>
                                            <span class="@GetStatusBadgeClass(row.value.approvalstatus)">
                                                @(string.IsNullOrWhiteSpace(row.value.approvalstatus) ? "PENDING" : row.value.approvalstatus)
                                            </span>
                                        </td>
                                        <td>
                                            @if (hasEditRight)
                                            {
                                                <button class="action-btn btn-edit" @onclick="async () => await EditIndent(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            }
                                            @if (hasDeleteRight)
                                            {
                                                <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var indent in PagedIndents)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span class="card-item-code">#@indent.indentcode</span>
                                    <div>
                                        @if (hasEditRight)
                                        {
                                            <button class="action-btn btn-edit" @onclick="async () => await EditIndent(indent)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(indent)" title="Delete"><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Indent No</span><strong>@(string.IsNullOrWhiteSpace(indent.indentno) ? "N/A" : indent.indentno)</strong></div>
                                    <div class="detail-row"><span>Indent Date</span><strong>@indent.indentdate.ToString("yyyy-MM-dd")</strong></div>
                                    <div class="detail-row"><span>Store</span><strong>@GetStoreName(indent.departmentcode)</strong></div>
                                    <div class="detail-row"><span>Status</span><strong class="@GetStatusBadgeClass(indent.approvalstatus)">@(string.IsNullOrWhiteSpace(indent.approvalstatus) ? "PENDING" : indent.approvalstatus)</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                
                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredIndents.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredIndents.Count()))</strong> of <strong>@FilteredIndents.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 800px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #1e293b !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Indent Request" : "Add Indent Request")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentRequest" OnValidSubmit="SaveIndent" autocomplete="off">
                    <DataAnnotationsValidator />
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 0 10px 20px 0;">
                        
                        <!-- Section 1: Indent Master Information -->
                        <div class="form-section-header">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Requisition Details</div>
                        </div>

                        <div class="form-grid">
                            <div class="field-group col-4">
                                <label class="field-label">Indent Number</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.indentno" placeholder="Auto-generated if empty" />
                            </div>
                            <div class="field-group col-4">
                                <label class="field-label required">Indent Date</label>
                                <InputDate class="form-control premium-input" @bind-Value="CurrentRequest.master.indentdate" />
                                <ValidationMessage For="() => CurrentRequest.master.indentdate" class="text-danger small" />
                            </div>
                            <div class="field-group col-4">
                                <label class="field-label">Store</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.departmentcode">
                                    <option value="">-- Select Store --</option>
                                    @foreach (var warehouse in WarehouseList)
                                    {
                                        <option value="@((long?)warehouse.warehousecode)">@warehouse.warehousename</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="field-group col-12">
                                <label class="field-label">Remarks</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.remarks" placeholder="Requisition reasons, notes, or explanations..." />
                            </div>
                        </div>

                        <!-- Section 2: Indent Detail Row items -->
                        <div class="form-section-header mt-4">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Requested Items</div>
                        </div>

                        <div class="purchase-items-table-wrapper table-responsive mt-3">
                            <table class="table align-middle mb-0" style="font-size: 0.85rem;">
                                <thead class="purchase-items-table-header">
                                    <tr>
                                        <th style="width: 50px; text-align: center;">S.NO</th>
                                        <th>ITEM SELECTION</th>
                                        <th style="width: 150px; text-align: center;">REQUESTED QTY</th>
                                        <th style="width: 80px; text-align: center;">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in CurrentRequest.details.Select((detail, index) => new { detail, index }))
                                    {
                                        var detail = row.detail;
                                        var index = row.index;
                                        <tr>
                                            <td style="padding: 0; color: #64748b; text-align: center; font-weight: 600; width: 50px; line-height: 34px;">@(index + 1)</td>
                                            <td style="padding: 0; position: relative;">
                                                @{ var searchKey = detail.GetHashCode(); }
                                                <input id="item-input-@index"
                                                       type="text"
                                                       class="purchase-item-select"
                                                       style="width: 100%; border: none; background: transparent; padding: 6px 12px; font-size: 0.85rem;"
                                                       placeholder="Type to search item..."
                                                       autocomplete="off"
                                                       value="@(ItemSearchTexts.GetValueOrDefault(searchKey, ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname ?? ""))"
                                                       @oninput="@(e => OnItemTypeaheadInput(e, detail, searchKey))"
                                                       @onfocus="@(() => ActiveItemSearchRow = index)"
                                                       @onblur="OnSearchBlur" />

                                                @if (ActiveItemSearchRow == index)
                                                {
                                                    var searchText = ItemSearchTexts.GetValueOrDefault(searchKey, "");
                                                    var filteredItems = ItemList
                                                        .Where(i => string.IsNullOrEmpty(searchText) || (i.itemname != null && i.itemname.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                                                        .ToList();

                                                    if (filteredItems.Any())
                                                    {
                                                        <div class="custom-typeahead-dropdown">
                                                            @foreach (var item in filteredItems)
                                                            {
                                                                <div class="custom-typeahead-item" 
                                                                     @onmousedown="@(() => SelectItemFromDropdown(detail, item, searchKey))">
                                                                    @item.itemname
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 150px;">
                                                <input type="number" class="purchase-item-input text-center" @bind="detail.requestedqty" />
                                            </td>
                                            <td style="padding: 0; text-align: center; width: 80px; vertical-align: middle;">
                                                @if (CurrentRequest.details.Count > 1)
                                                {
                                                    <button type="button" class="btn btn-outline-danger btn-sm" style="border-radius: 6px; padding: 4px 8px; border: none; background: rgba(239, 68, 68, 0.08); color: #dc2626; margin: 0 auto; display: block;" @onclick="() => RemoveDetailRow(detail)" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div style="padding: 12px 0; display: flex; justify-content: center; align-items: center; width: 100%;">
                            <button type="button" class="btn-dotted-add" @onclick="AddDetailRow" style="padding: 5px 22px; font-size: 0.82rem; border-radius: 16px;">
                                <i class="bi bi-plus-circle-fill" style="font-size: 0.9rem; margin-right: 4px;"></i> Add Item
                            </button>
                        </div>
                    </div>

                    <div class="modal-footer-actions" style="display: flex; justify-content: flex-end; gap: 16px; padding: 24px 32px; border-top: 1px solid #f0f0f0;">
                        <button type="button" class="btn-cancel-modal" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn-save-premium" disabled="@IsSaving" style="min-width: 150px; height: 48px; background: #1c9f5f; color: white;">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                            }
                            <span>@(IsEdit ? "Update Indent" : "Save Indent")</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeleteConfirm = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Indent Request</div>
            <div class="action-popup-body">Are you sure you want to delete this stock indent? This action cannot be undone.</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowDeleteConfirm = false">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<indent_master> IndentList = new();
    private List<inventory_item_master> ItemList = new();
    private List<warehouse_master> WarehouseList = new();
    private indent_request CurrentRequest = new();
    
    private string SearchQuery = "";
    private bool IsLoading = true;
    private bool IsSaving = false;
    private bool ShowModal = false;
    private bool IsEdit = false;
    private bool IsCardView = false;
    private bool ShowDeleteConfirm = false;
    private indent_master? PendingDelete;
    
    private string DefaultTenant = "";
    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 12;

    private IEnumerable<indent_master> FilteredIndents => 
        string.IsNullOrWhiteSpace(SearchQuery) 
            ? IndentList 
            : IndentList.Where(i => 
                (i.indentno?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (i.departmentcode?.ToString().Contains(SearchQuery) ?? false) ||
                (i.indentcode.ToString().Contains(SearchQuery)) ||
                (i.approvalstatus?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<indent_master> PagedIndents => 
        FilteredIndents.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    private int TotalPages => (int)Math.Ceiling((double)FilteredIndents.Count() / ItemsPerPage);

    private bool hasViewRight = true;
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
            
            try
            {
                bool isAdmin = false;
                try
                {
                    var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userResult.Success && userResult.Value != null)
                    {
                        isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                  userResult.Value.UserCode == 0 ||
                                  userResult.Value.UserCode == 1;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking user details: {ex.Message}");
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                    hasEditRight = true;
                    hasDeleteRight = true;
                }
                else
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var pageRight = rightsResult.Value.FirstOrDefault(r => 
                            r.ModuleName != null && 
                            r.ModuleName.Trim().Equals("Indent_Request", StringComparison.OrdinalIgnoreCase));
                        
                        if (pageRight != null)
                        {
                            hasViewRight = pageRight.ToView;
                            hasCreateRight = pageRight.ToAdd;
                            hasEditRight = pageRight.ToEdit;
                            hasDeleteRight = pageRight.ToDelete;
                        }
                        else
                        {
                            hasViewRight = false;
                            hasCreateRight = false;
                            hasEditRight = false;
                            hasDeleteRight = false;
                        }
                    }
                    else
                    {
                        hasViewRight = false;
                        hasCreateRight = false;
                        hasEditRight = false;
                        hasDeleteRight = false;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking Indent_Request rights: {ex.Message}");
                hasViewRight = false;
                hasCreateRight = false;
                hasEditRight = false;
                hasDeleteRight = false;
            }

            if (!hasViewRight)
            {
                ToastService.ShowError("You do not have permission to access Indent Request.");
                NavigationManager.NavigateTo("/home");
                return;
            }

            await Task.WhenAll(LoadIndents(), LoadItems(), LoadWarehouses());
            StateHasChanged();
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        return client;
    }

    private async Task LoadIndents()
    {
        IsLoading = true;
        try 
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallindents");
            
            if (!string.IsNullOrWhiteSpace(response)) 
            {
                var directList = ParseIndentsList(response);
                IndentList = directList ?? new();
            }
        } 
        catch (Exception ex) 
        {
            ToastService.ShowError($"Load Error: {ex.Message}");
        } 
        finally 
        {
            IsLoading = false;
        }
    }

    private List<indent_master>? ParseIndentsList(string json)
    {
        var options = new JsonSerializerOptions 
        { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try 
        {
            var wrappedReq = JsonSerializer.Deserialize<ServiceResponse<List<indent_request>>>(json, options);
            if (wrappedReq?.data != null && wrappedReq.data.Any()) 
            {
                var masters = wrappedReq.data
                    .Select(x => x.master)
                    .Where(x => x != null && x.indentcode > 0 && !x.deleted)
                    .ToList();
                if (masters.Any()) return masters;
            }
        } 
        catch { }

        try 
        {
            var directReq = JsonSerializer.Deserialize<List<indent_request>>(json, options);
            if (directReq != null && directReq.Any()) 
            {
                var masters = directReq
                    .Select(x => x.master)
                    .Where(x => x != null && x.indentcode > 0 && !x.deleted)
                    .ToList();
                if (masters.Any()) return masters;
            }
        } 
        catch { }

        try 
        {
            var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<indent_master>>>(json, options);
            if (wrapped?.data != null && wrapped.data.Any()) 
            {
                var valid = wrapped.data.Where(x => x.indentcode > 0 && !x.deleted).ToList();
                if (valid.Any()) return valid;
            }
        } 
        catch { }

        try 
        {
            var direct = JsonSerializer.Deserialize<List<indent_master>>(json, options);
            if (direct != null && direct.Any()) 
            {
                var valid = direct.Where(x => x.indentcode > 0 && !x.deleted).ToList();
                if (valid.Any()) return valid;
            }
        } 
        catch { }

        return null;
    }

    private async Task LoadItems()
    {
        try 
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallitems");
            if (string.IsNullOrWhiteSpace(response)) return;

            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            try 
            {
                var direct = JsonSerializer.Deserialize<List<inventory_item_master>>(response, options);
                ItemList = direct ?? new();
            } 
            catch 
            {
                var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<inventory_item_master>>>(response, options);
                ItemList = wrapped?.data ?? new();
            }
        } 
        catch { }
    }

    private async Task LoadWarehouses()
    {
        try 
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallwarehouse");
            if (string.IsNullOrWhiteSpace(response)) return;

            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            try 
            {
                var direct = JsonSerializer.Deserialize<List<warehouse_master>>(response, options);
                WarehouseList = (direct ?? new()).Where(w => !w.isdeleted && w.isactive).OrderBy(w => w.orderno).ToList();
            } 
            catch 
            {
                var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<warehouse_master>>>(response, options);
                WarehouseList = (wrapped?.data ?? new()).Where(w => !w.isdeleted && w.isactive).OrderBy(w => w.orderno).ToList();
            }
        } 
        catch { }
    }

    private void AddNewIndent()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add indents.");
            return;
        }
        IsEdit = false;
        ItemSearchTexts.Clear();
        CurrentRequest = new indent_request 
        { 
            master = new indent_master 
            { 
                tenantcode = DefaultTenant, 
                indentdate = DateTime.Now,
                approvalstatus = "PENDING",
                branchcode = "BLR001",
                isactive = true,
                deleted = false
            },
            details = new List<indent_detail>()
        };
        AddDetailRow();
        ShowModal = true;
    }

    private async Task EditIndent(indent_master master)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit indents.");
            return;
        }
        IsEdit = true;
        IsLoading = true;
        try 
        {
            var client = CreateClient();
            var url = $"api/ItemMaster/getindentbycode?indentcode={master.indentcode}&tenantcode={DefaultTenant}";
            var responseString = await client.GetStringAsync(url);
            
            var loaded = ParseIndentRequest(responseString);
            if (loaded != null) 
            {
                CurrentRequest = loaded;
                CurrentRequest.master.tenantcode = DefaultTenant;
                
                ItemSearchTexts.Clear();
                foreach (var detail in CurrentRequest.details)
                {
                    var searchKey = detail.GetHashCode();
                    var item = ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode);
                    if (item != null)
                    {
                        ItemSearchTexts[searchKey] = item.itemname ?? "";
                    }
                }
            }
            else 
            {
                CurrentRequest = new indent_request 
                {
                    master = master,
                    details = new List<indent_detail>()
                };
                AddDetailRow();
                ToastService.ShowWarning("Details not retrieved. Loading basic data only.");
            }
            ShowModal = true;
        } 
        catch (Exception ex) 
        {
            ToastService.ShowError($"Edit Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private indent_request? ParseIndentRequest(string json)
    {
        var options = new JsonSerializerOptions 
        { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try 
        {
            var wrappedList = JsonSerializer.Deserialize<ServiceResponse<List<indent_request>>>(json, options);
            if (wrappedList?.data != null && wrappedList.data.Any()) 
            {
                return wrappedList.data.First();
            }
        } 
        catch { }

        try 
        {
            var directList = JsonSerializer.Deserialize<List<indent_request>>(json, options);
            if (directList != null && directList.Any()) 
            {
                return directList.First();
            }
        } 
        catch { }

        try 
        {
            var wrapped = JsonSerializer.Deserialize<ServiceResponse<indent_request>>(json, options);
            if (wrapped?.data != null && wrapped.data.master != null) return wrapped.data;
        } 
        catch { }

        try 
        {
            var direct = JsonSerializer.Deserialize<indent_request>(json, options);
            if (direct != null && direct.master != null) return direct;
        } 
        catch { }

        return null;
    }

    private Dictionary<int, string> ItemSearchTexts = new();
    private int? ActiveItemSearchRow = null;

    private void OnItemTypeaheadInput(ChangeEventArgs e, indent_detail detail, int searchKey)
    {
        var typed = e.Value?.ToString() ?? "";
        ItemSearchTexts[searchKey] = typed;
        ActiveItemSearchRow = CurrentRequest.details.IndexOf(detail);

        var matched = ItemList.FirstOrDefault(i =>
            string.Equals(i.itemname, typed, StringComparison.OrdinalIgnoreCase));
        if (matched != null)
        {
            detail.itemcode = matched.itemcode;
        }
        else
        {
            detail.itemcode = 0;
        }
    }

    private async Task OnSearchBlur()
    {
        await Task.Delay(200);
        ActiveItemSearchRow = null;
        StateHasChanged();
    }

    private void SelectItemFromDropdown(indent_detail detail, inventory_item_master item, int searchKey)
    {
        detail.itemcode = item.itemcode;
        ItemSearchTexts[searchKey] = item.itemname ?? "";
        ActiveItemSearchRow = null;
        StateHasChanged();
    }

    private void AddDetailRow()
    {
        CurrentRequest.details.Add(new indent_detail ());
    }

    private void RemoveDetailRow(indent_detail detail)
    {
        var searchKey = detail.GetHashCode();
        ItemSearchTexts.Remove(searchKey);
        CurrentRequest.details.Remove(detail);
    }

    private async Task SaveIndent()
    {
        if (IsEdit && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit indents.");
            return;
        }
        if (!IsEdit && !hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add indents.");
            return;
        }
        CurrentRequest.details = CurrentRequest.details.Where(d => d.itemcode > 0 && d.requestedqty > 0).ToList();
        if (!CurrentRequest.details.Any()) 
        {
            ToastService.ShowWarning("Please add at least one line item with quantity");
            AddDetailRow();
            return;
        }

        IsSaving = true;
        try 
        {
            var client = CreateClient();
            
            CurrentRequest.master.tenantcode = DefaultTenant;
            CurrentRequest.master.branchcode ??= "BLR001";
            CurrentRequest.master.isactive = true;
            CurrentRequest.master.deleted = false;

            var url = IsEdit ? "api/ItemMaster/updateindent" : "api/ItemMaster/insertindent";
            
            var options = new JsonSerializerOptions 
            {
                PropertyNamingPolicy = null 
            };
            
            var response = await client.PostAsJsonAsync(url, CurrentRequest, options);

            if (response.IsSuccessStatusCode) 
            {
                ToastService.ShowSuccess(IsEdit ? "Indent request updated successfully" : "Indent request recorded successfully");
                ShowModal = false;
                await LoadIndents();
            } 
            else 
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Save Failed: {errorBody}");
            }
        } 
        catch (Exception ex) 
        {
            ToastService.ShowError($"Save Error: {ex.Message}");
        } 
        finally 
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(indent_master master)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete indents.");
            return;
        }
        PendingDelete = master;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteConfirmed()
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete indents.");
            return;
        }
        if (PendingDelete == null) return;
        IsLoading = true;
        try 
        {
            var client = CreateClient();
            var url = $"api/ItemMaster/deleteindent?indentcode={PendingDelete.indentcode}";
            var response = await client.GetAsync(url);
            
            if (!response.IsSuccessStatusCode)
            {
                response = await client.DeleteAsync(url);
            }
            
            if (response.IsSuccessStatusCode) 
            {
                ToastService.ShowSuccess("Indent request deleted successfully");
                await LoadIndents();
            } 
            else 
            {
                var softDeleteSuccess = await SoftDeleteViaUpdate(PendingDelete);
                if (softDeleteSuccess)
                {
                    ToastService.ShowSuccess("Indent request soft-deleted");
                    await LoadIndents();
                }
                else
                {
                    ToastService.ShowError("Delete failed. Verify API endpoint status.");
                }
            }
        } 
        catch (Exception ex) 
        {
            ToastService.ShowError($"Delete Error: {ex.Message}");
        } 
        finally 
        {
            ShowDeleteConfirm = false;
            PendingDelete = null;
            IsLoading = false;
        }
    }

    private async Task<bool> SoftDeleteViaUpdate(indent_master entry)
    {
        try
        {
            var client = CreateClient();
            var detailUrl = $"api/ItemMaster/getindentbycode?indentcode={entry.indentcode}";
            var detailsResponse = await client.GetStringAsync(detailUrl);
            var req = ParseIndentRequest(detailsResponse);
            
            if (req != null)
            {
                req.master.deleted = true;
                req.master.isactive = false;
                req.master.tenantcode = DefaultTenant;
                
                var updateResponse = await client.PostAsJsonAsync("api/ItemMaster/updateindent", req);
                return updateResponse.IsSuccessStatusCode;
            }
        }
        catch { }
        return false;
    }

    private string GetStoreName(long? code)
    {
        if (code == null) return "N/A";
        var store = WarehouseList.FirstOrDefault(w => w.warehousecode == code);
        return store?.warehousename ?? $"Store #{code}";
    }

    private string GetStatusBadgeClass(string? status)
    {
        return (status?.ToUpperInvariant()) switch
        {
            "APPROVED" => "badge bg-success-subtle text-success border border-success",
            "REJECTED" => "badge bg-danger-subtle text-danger border border-danger",
            _ => "badge bg-warning-subtle text-warning border border-warning"
        };
    }

