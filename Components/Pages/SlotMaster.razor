@code {
    private List<DoctorAppointmentSlotMasterModel> slots = new();
    private List<DoctorMasterModel> doctors = new();
    private List<DoctorAppointmentSlotTypeModel> slotTypes = new();
    private List<AppointmentBookingModel> allBookings = new();
    private int currentDcode = 0;
    private bool showForm = false;
    private bool isNew = true;
    private bool isBulkEdit = false;
    private bool showCalendar = false;
    private string viewMode = "WEEK"; // Default to WEEK as requested
    private int selectedDoctorFilter = 0;
    private bool showLegend = false;
    private string legendViewMode = "details"; // "details" or "emoji"
    private int testCounter = 0;

    private bool showSlotDetailsModal = false;
    private DoctorAppointmentSlotMasterModel? selectedDetailSlot = null;
    private DateTime selectedDetailDate = DateTime.Today;

    private void OpenSlotDetailsModal(DoctorAppointmentSlotMasterModel slot, DateTime date)
    {
        selectedDetailSlot = slot;
        selectedDetailDate = date;
        showSlotDetailsModal = true;
    }

    private void CloseSlotDetailsModal()
    {
        showSlotDetailsModal = false;
        selectedDetailSlot = null;
    }

    private int GetBookedCountForSlot(DoctorAppointmentSlotMasterModel slot, DateTime date)
    {
        if (slot == null) return 0;
        var dOnly = DateOnly.FromDateTime(date);
        return allBookings.Count(b => b.dcode == slot.dcode 
            && b.appointment_date == dOnly 
            && b.slot_master_id == slot.slot_master_id 
            && (b.booking_status == null || !b.booking_status.Equals("CANCELLED", StringComparison.OrdinalIgnoreCase))
            && !b.isdeleted);
    }

    private int GetOnlineBookedForSlot(DoctorAppointmentSlotMasterModel slot, DateTime date)
    {
        if (slot == null) return 0;
        var dOnly = DateOnly.FromDateTime(date);
        return allBookings.Count(b => b.dcode == slot.dcode 
            && b.appointment_date == dOnly 
            && b.slot_master_id == slot.slot_master_id 
            && (b.booking_type == null || b.booking_type.Equals("ONLINE", StringComparison.OrdinalIgnoreCase))
            && (b.booking_status == null || !b.booking_status.Equals("CANCELLED", StringComparison.OrdinalIgnoreCase))
            && !b.isdeleted);
    }

    private int GetWalkinBookedForSlot(DoctorAppointmentSlotMasterModel slot, DateTime date)
    {
        if (slot == null) return 0;
        var dOnly = DateOnly.FromDateTime(date);
        return allBookings.Count(b => b.dcode == slot.dcode 
            && b.appointment_date == dOnly 
            && b.slot_master_id == slot.slot_master_id 
            && b.booking_type != null && (b.booking_type.Equals("WALKIN", StringComparison.OrdinalIgnoreCase) || b.booking_type.Equals("WALK-IN", StringComparison.OrdinalIgnoreCase))
            && (b.booking_status == null || !b.booking_status.Equals("CANCELLED", StringComparison.OrdinalIgnoreCase))
            && !b.isdeleted);
    }

    private int GetRemainingCountForSlot(DoctorAppointmentSlotMasterModel slot, DateTime date)
    {
        if (slot == null) return 0;
        int totalCapacity = slot.max_patients > 0 ? slot.max_patients : (slot.max_online + slot.max_walkin);
        int booked = GetBookedCountForSlot(slot, date);
        return Math.Max(0, totalCapacity - booked);
    }

    private void SetLegendViewMode(string mode) => legendViewMode = mode;
    private void ToggleLegend() => showLegend = !showLegend;

    // Multi-Slot Logic
    private class SlotEntry {
        public Guid? SlotMasterId { get; set; }
        public long SlotTypeId { get; set; }
        public DateTime StartTime { get; set; } = DateTime.Today.AddHours(9);
        public DateTime EndTime { get; set; } = DateTime.Today.AddHours(10);
        public TimeOnly? OriginalStartTime { get; set; }
        public TimeOnly? OriginalEndTime { get; set; }
        public int AvgTime { get; set; } = 0;
        public int TotalPatients { get; set; } = 0;
        public int Walkin { get; set; } = 0;
        public int Online { get; set; } = 0;
        public string TypeOfSlot { get; set; } = "";
        public int Duration => (int)(EndTime - StartTime).TotalMinutes;
        
        // Additional properties requested by the user
        public int Slotnum { get; set; }
        public DateTime? CreatedAt { get; set; }
        public bool IsCancel { get; set; }
        public string? CancelReason { get; set; }
    }
    private List<SlotEntry> tempSlots = new();

    // Calendar logic
    private List<DateTime> selectedDates = new();
    private DateTime currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private int daysInMonth => DateTime.DaysInMonth(currentMonth.Year, currentMonth.Month);
    private int firstDayOffset => (int)new DateTime(currentMonth.Year, currentMonth.Month, 1).DayOfWeek;

    private DateTime viewDate = DateTime.Today;
    
    private void PrevView() {
        if (viewMode == "WEEK") viewDate = viewDate.AddDays(-7);
        else viewDate = viewDate.AddDays(-1);
    }
    
    private void NextView() {
        if (viewMode == "WEEK") viewDate = viewDate.AddDays(7);
        else viewDate = viewDate.AddDays(1);
    }

    private void SetViewMode(string mode) {
        viewMode = mode;
        StateHasChanged();
    }

    private string GetViewRangeText() {
        if (viewMode == "DAY") return viewDate.ToString("MMMM dd, yyyy");
        var end = viewDate.AddDays(6);
        if (viewDate.Month == end.Month) 
            return $"{viewDate.ToString("MMMM dd")} - {end.Day}, {end.Year}";
        return $"{viewDate.ToString("MMMM dd")} - {end.ToString("MMMM dd")}, {end.Year}";
    }


    protected override async Task OnInitializedAsync() => await LoadData();
    private void ToggleCalendar() => showCalendar = !showCalendar;

    private async Task LoadData() {
        doctors = (await DoctorService.GetDoctorsAsync()).OrderBy(d => string.IsNullOrWhiteSpace(d.name) ? d.doctorfullname : d.name).ToList();
        slotTypes = await SlotTypeService.GetSlotTypesAsync();
        slots = await SlotService.GetSlotsAsync();
        try { allBookings = await AppointmentService.GetAllBookingsAsync(); } catch { allBookings = new(); }
        TranslateSlotsToIndianTime(slots);
        SyncSlotTypeIds(slots);
    }

    private void TranslateSlotsToIndianTime(List<DoctorAppointmentSlotMasterModel> slotList) {
        foreach (var s in slotList) {
            s.slot_start_time = s.slot_start_time.ToIndianTime();
            s.slot_end_time = s.slot_end_time.ToIndianTime();
        }
    }

    private void SyncSlotTypeIds(List<DoctorAppointmentSlotMasterModel> slotList) {
        foreach (var s in slotList) {
            if (s.slot_type_id == 0 && !string.IsNullOrWhiteSpace(s.typeofslot)) {
                var matchingType = slotTypes.FirstOrDefault(t => 
                    t.name?.Trim().Equals(s.typeofslot.Trim(), StringComparison.OrdinalIgnoreCase) == true);
                if (matchingType != null) s.slot_type_id = matchingType.slot_type_id;
            }
        }
    }

    private string GetDoctorName(int dcode) {
        var doc = doctors.FirstOrDefault(d => d.dcode == dcode);
        if (doc == null) return "Unknown Doctor";
        return string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname ?? "Unknown Doctor" : doc.name;
    }

    private void CreateNew() {
        currentDcode = 0;
        selectedDates.Clear();
        selectedDates.Add(DateTime.Today);
        tempSlots.Clear();
        tempSlots.Add(new SlotEntry { 
            SlotTypeId = 0,
            TypeOfSlot = ""
        });
        isNew = true;
        showForm = true;
    }

    private bool IsSlotPast(DoctorAppointmentSlotMasterModel slot, DateTime date)
    {
        var slotStart = date.Date.Add(slot.slot_start_time.ToTimeSpan());
        return slotStart < DateTime.Now;
    }


    private async Task AddSlotTab() {
        var lastSlot = tempSlots.LastOrDefault();
        var newSlot = new SlotEntry { 
            SlotTypeId = 0,
            TypeOfSlot = ""
        };
        
        if (lastSlot != null) {
            newSlot.StartTime = lastSlot.EndTime;
            newSlot.EndTime = lastSlot.EndTime.AddHours(1);
        }

        var currentStart = TimeOnly.FromDateTime(newSlot.StartTime);
        var currentEnd = TimeOnly.FromDateTime(newSlot.EndTime);

        await JSRuntime.InvokeVoidAsync("console.log", "--- Checking Conflict for New Slot ---", new { 
            Start = currentStart.ToString(), 
            End = currentEnd.ToString(),
            Doctor = currentDcode,
            DatesCount = selectedDates.Count
        });

        // 1. Check against other slots ALREADY in the form
        foreach (var s in tempSlots) {
            var otherStart = TimeOnly.FromDateTime(s.StartTime);
            var otherEnd = TimeOnly.FromDateTime(s.EndTime);
            if (currentStart < otherEnd && currentEnd > otherStart) {
                ShowToast($"Local Conflict: Overlaps with Slot #{tempSlots.IndexOf(s) + 1} ({otherStart:hh:mm tt})");
                return; // Stop here and don't add the slot
            }
        }

        // 2. Check against database slots
        if (currentDcode > 0) {
            foreach (var date in selectedDates) {
                var dateOnly = DateOnly.FromDateTime(date);
                var currentDay = date.DayOfWeek.ToString().ToUpper();
                
                var conflicts = slots.Where(s => s.dcode == currentDcode && 
                                           (s.slot_date == dateOnly || (s.slot_date == null && s.day_of_week == currentDay)) && 
                                           !s.isdeleted).ToList();

                var dbConflict = conflicts.FirstOrDefault(s => (currentStart < s.slot_end_time && currentEnd > s.slot_start_time));
                
                if (dbConflict != null) {
                    ShowToast($"Existing Conflict: A slot already exists on {dateOnly:dd/MM/yyyy} ({dbConflict.slot_start_time:hh:mm tt} - {dbConflict.slot_end_time:hh:mm tt}).");
                    return; // Stop here and don't add the slot
                }
            }
        }
        
        tempSlots.Add(newSlot);
    }

    private async Task DeleteSlotFromTempList(int index) {
        try {
            var slot = tempSlots[index];
            if (slot.SlotMasterId.HasValue && slot.SlotMasterId.Value != Guid.Empty) {
                bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this already existing slot?");
                if (!confirmed) return;

                if (await SlotService.DeleteSlotAsync(slot.SlotMasterId.Value)) {
                    tempSlots.RemoveAt(index);
                    await LoadData();
                    ToastService.ShowSuccess("Slot deleted successfully.");
                } else {
                    ToastService.ShowError("Failed to delete slot.");
                }
            } else {
                tempSlots.RemoveAt(index);
            }
        } catch (Exception ex) {
            ToastService.ShowError($"Error deleting slot: {ex.Message}");
        }
    }

    private void ShowToast(string message, string type = "error")
    {
        if (type == "error") ToastService.ShowError(message);
        else ToastService.ShowSuccess(message);
    }

    private void CalculatePatients(SlotEntry slot)
    {
        if (!IsVisitingSlot(slot))
        {
            slot.TotalPatients = 0;
            slot.Walkin = 0;
            slot.Online = 0;
            return;
        }

        if (slot.AvgTime > 0)
        {
            slot.TotalPatients = slot.Duration / slot.AvgTime;
            if (slot.Walkin > slot.TotalPatients)
            {
                slot.Walkin = slot.TotalPatients;
            }
            slot.Online = slot.TotalPatients - slot.Walkin;
        }
    }

    private void CalculateOnlineSlots(SlotEntry slot)
    {
        CalculatePatients(slot);
    }

    private void OnWalkinChanged(SlotEntry slot)
    {
        if (!IsVisitingSlot(slot)) return;
        if (slot.Walkin > slot.TotalPatients)
        {
            slot.Walkin = slot.TotalPatients;
        }
        else if (slot.Walkin < 0)
        {
            slot.Walkin = 0;
        }
        slot.Online = slot.TotalPatients - slot.Walkin;
        StateHasChanged();
    }

    private void OnOnlineChanged(SlotEntry slot)
    {
        if (!IsVisitingSlot(slot)) return;
        if (slot.Online > slot.TotalPatients)
        {
            slot.Online = slot.TotalPatients;
        }
        else if (slot.Online < 0)
        {
            slot.Online = 0;
        }
        slot.Walkin = slot.TotalPatients - slot.Online;
        StateHasChanged();
    }

    private async Task<bool> ValidateAllTempSlots(bool showToast = false)
    {
        bool allValid = true;
        foreach (var slot in tempSlots)
        {
            if (!await ValidateTimeSlots(slot, showToast))
            {
                allValid = false;
            }
        }
        return allValid;
    }

    private async Task OnTimeChanged(SlotEntry slot, bool isStartTime)
    {
        CalculateOnlineSlots(slot);
        await ValidateAllTempSlots();
        StateHasChanged();
    }

    private void OnAvgTimeChanged(SlotEntry slot)
    {
        CalculateOnlineSlots(slot);
        StateHasChanged();
    }

    private async Task<bool> ValidateTimeSlots(SlotEntry currentSlot, bool showToast = false)
    {
        if (currentSlot.SlotTypeId <= 0)
        {
            if (showToast) ShowToast($"Please select a Slot Type for Slot #{tempSlots.IndexOf(currentSlot) + 1}.");
            return false;
        }

        var currentStart = TimeOnly.FromDateTime(currentSlot.StartTime);
        var currentEnd = TimeOnly.FromDateTime(currentSlot.EndTime);
        
        if (currentEnd <= currentStart)
        {
            if (showToast) ShowToast("Invalid Time: End time must be after start time.");
            return false;
        }

        // Check if slot end time has already passed (for today or past selected dates)
        var now = DateTime.Now;
        var today = DateOnly.FromDateTime(now.Date);
        var nowTime = TimeOnly.FromDateTime(now);

        foreach (var date in selectedDates)
        {
            var dateOnly = DateOnly.FromDateTime(date);
            if (dateOnly < today || (dateOnly == today && currentEnd <= nowTime))
            {
                if (showToast) ShowToast($"Invalid Time: Slot #{tempSlots.IndexOf(currentSlot) + 1} end time ({currentEnd:hh:mm tt}) has already passed.");
                return false;
            }
        }

        // 1. Check against other slots in the current list
        foreach (var other in tempSlots.Where(s => s != currentSlot))
        {
            var otherStart = TimeOnly.FromDateTime(other.StartTime);
            var otherEnd = TimeOnly.FromDateTime(other.EndTime);

            if (currentStart < otherEnd && currentEnd > otherStart)
            {
                if (showToast) ShowToast($"Conflict: This slot overlaps with Slot #{tempSlots.IndexOf(other) + 1} ({otherStart:hh:mm tt} - {otherEnd:hh:mm tt})");
                return false;
            }
        }

        // 2. Check against existing slots for the selected doctor and dates
        if (currentDcode > 0)
        {
            // Only check for DB conflicts if creating a new slot or if times actually changed
            bool timeChanged = isNew || 
                               currentSlot.SlotMasterId == null ||
                               currentSlot.OriginalStartTime == null || 
                               currentSlot.OriginalEndTime == null || 
                               currentStart != currentSlot.OriginalStartTime.Value || 
                               currentEnd != currentSlot.OriginalEndTime.Value;

            if (timeChanged)
            {
                foreach (var date in selectedDates)
                {
                    var dateOnly = DateOnly.FromDateTime(date);
                    var currentDay = date.DayOfWeek.ToString().ToUpper();
                    
                    var potentialConflicts = slots.Where(s => s.dcode == currentDcode && 
                                                   (s.slot_date == dateOnly || s.day_of_week == currentDay) && 
                                                   s.slot_master_id != currentSlot.SlotMasterId &&
                                                   !s.isdeleted).ToList();
                    
                    foreach (var dbSlot in potentialConflicts)
                    {
                        bool overlaps = (currentStart < dbSlot.slot_end_time && currentEnd > dbSlot.slot_start_time);
                        if (overlaps)
                        {
                            if (showToast) ShowToast($"Existing Conflict: A slot already exists on {dateOnly:dd/MM/yyyy} for this time range ({dbSlot.slot_start_time:hh:mm tt} - {dbSlot.slot_end_time:hh:mm tt})");
                            return false;
                        }
                    }
                }
            }
        }
        return true;
    }

    private void UpdateDuration() { StateHasChanged(); }

    private void EditSlot(DoctorAppointmentSlotMasterModel slot) {
        if (slot.slot_date.HasValue && IsSlotPast(slot, slot.slot_date.Value.ToDateTime(TimeOnly.MinValue))) {
            ShowToast("Cannot edit a slot prior to the current time.", "error");
            return;
        }
        
        currentDcode = slot.dcode;
        selectedDates.Clear();
        if (slot.slot_date.HasValue) selectedDates.Add(slot.slot_date.Value.ToDateTime(TimeOnly.MinValue));
        
        tempSlots.Clear();
        // Fallback: If slot_type_id is 0 but typeofslot string exists, try to find the matching ID from slotTypes
        if (slot.slot_type_id == 0 && !string.IsNullOrWhiteSpace(slot.typeofslot)) {
            var matchingType = slotTypes.FirstOrDefault(t => 
                t.name?.Trim().Equals(slot.typeofslot.Trim(), StringComparison.OrdinalIgnoreCase) == true);
            if (matchingType != null) slot.slot_type_id = matchingType.slot_type_id;
        }

        var entry = new SlotEntry {
            SlotMasterId = slot.slot_master_id,
            SlotTypeId = slot.slot_type_id,
            StartTime = DateTime.Today.Add(slot.slot_start_time.ToTimeSpan()),
            EndTime = DateTime.Today.Add(slot.slot_end_time.ToTimeSpan()),
            OriginalStartTime = slot.slot_start_time,
            OriginalEndTime = slot.slot_end_time,
            AvgTime = slot.avgtime ?? 0,
            TotalPatients = slot.max_patients,
            Walkin = slot.max_walkin,
            Online = slot.max_online,
            TypeOfSlot = slot.typeofslot?.Trim() ?? "",
            Slotnum = slot.slotnum,
            CreatedAt = slot.created_at,
            IsCancel = slot.is_cancel,
            CancelReason = slot.cancel_reason
        };
        tempSlots.Add(entry);
        OnSlotTypeSync(entry);
        
        Console.WriteLine($"EDITING SLOT: ID={slot.slot_master_id}, TypeID={slot.slot_type_id}, TypeName={slot.typeofslot}");
        
        isNew = false;
        showForm = true;
    }

    private async Task SaveAllSlots() {
        try {
            if (currentDcode == 0) {
                ShowToast("Please select a doctor.");
                return;
            }
            if (!selectedDates.Any()) {
                ShowToast("Please select at least one date.");
                return;
            }

            // Perform full validation WITH toasts before saving
            if (!await ValidateAllTempSlots(showToast: true)) {
                return;
            }

            var slotsToSave = new List<object>();
            
            foreach (var date in selectedDates) {
                foreach (var s in tempSlots) {
                    if (isNew) {
                        slotsToSave.Add(new {
                            slot_master_id = Guid.NewGuid().ToString(),
                            slotnum = tempSlots.IndexOf(s) + 1,
                            dcode = currentDcode,
                            slot_type_id = s.SlotTypeId,
                            avgtime = s.AvgTime,
                            day_of_week = date.DayOfWeek.ToString(),
                            slot_start_time = TimeOnly.FromDateTime(s.StartTime).ToUtcFromIndianTime().ToString("HH:mm:ss"),
                            slot_end_time = TimeOnly.FromDateTime(s.EndTime).ToUtcFromIndianTime().ToString("HH:mm:ss"),
                            typeofslot = s.TypeOfSlot,
                            max_patients = s.TotalPatients,
                            max_walkin = s.Walkin,
                            max_online = s.Online,
                            slot_date = date.ToString("yyyy-MM-dd"),
                            is_active = true,
                            isdeleted = false,
                            created_at = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ss.ffffff"),
                            updated_at = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ss.ffffff"),
                            is_cancel = false,
                            cancel_reason = (string)null
                        });
                    } else {
                        slotsToSave.Add(new {
                            slot_master_id = s.SlotMasterId?.ToString(),
                            slotnum = s.Slotnum > 0 ? s.Slotnum : tempSlots.IndexOf(s) + 1,
                            dcode = currentDcode,
                            slot_type_id = s.SlotTypeId,
                            avgtime = s.AvgTime,
                            day_of_week = date.DayOfWeek.ToString(),
                            slot_start_time = TimeOnly.FromDateTime(s.StartTime).ToUtcFromIndianTime().ToString("HH:mm:ss"),
                            slot_end_time = TimeOnly.FromDateTime(s.EndTime).ToUtcFromIndianTime().ToString("HH:mm:ss"),
                            typeofslot = s.TypeOfSlot,
                            max_patients = s.TotalPatients,
                            max_walkin = s.Walkin,
                            max_online = s.Online,
                            slot_date = date.ToString("yyyy-MM-dd"),
                            is_active = true,
                            isdeleted = false,
                            created_at = s.CreatedAt?.ToString("yyyy-MM-ddTHH:mm:ss.ffffff") ?? DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ss.ffffff"),
                            updated_at = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ss.ffffff"),
                            is_cancel = s.IsCancel,
                            cancel_reason = s.CancelReason
                        });
                    }
                }
            }
            
            var json = System.Text.Json.JsonSerializer.Serialize(slotsToSave, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            await JSRuntime.InvokeVoidAsync("console.log", "FINAL SLOTS TO SAVE:", slotsToSave);
            await JSRuntime.InvokeVoidAsync("console.log", $"SAVING SLOTS - Mode: {(isNew ? "INSERT" : "UPDATE")}", slotsToSave);
            
            Console.WriteLine("*************************************************");
            Console.WriteLine($"SAVING SLOTS - Mode: {(isNew ? "INSERT" : "UPDATE")}");
            Console.WriteLine(json);
            Console.WriteLine("*************************************************");

            if (isNew) {
                var result = await SlotService.InsertSlotAsync(slotsToSave);
                
                // Check for skipped slots (overlaps) and show as errors
                if (result.skipped != null && result.skipped.Any()) {
                    foreach (var msg in result.skipped) {
                        ToastService.ShowError(msg);
                    }
                }

                // If we inserted at least one or if there were no failures, close form
                if (result.inserted != null && result.inserted.Any()) {
                    showForm = false;
                    await LoadData();
                    ToastService.ShowSuccess($"Successfully added {result.inserted.Count} slots.");
                }
            } else {
                bool success = await SlotService.UpdateSlotAsync(slotsToSave);
                if (success) {
                    showForm = false;
                    isBulkEdit = false;
                    await LoadData();
                    ToastService.ShowSuccess("Slot(s) updated successfully.");
                } else {
                    ToastService.ShowError("Failed to update slot(s).");
                }
            }
        } catch (Exception ex) {
            await JSRuntime.InvokeVoidAsync("console.error", "EXCEPTION IN SAVE SLOT:", ex.ToString());
            ToastService.ShowError($"Error in SaveAllSlots: {ex.Message}");
        }
    }

    private async void OnQuickSelectChange(ChangeEventArgs e) {
        int days = int.Parse(e.Value?.ToString() ?? "0");
        if (days >= 2) {
            selectedDates.Clear();
            for (int i = 0; i < days; i++) {
                selectedDates.Add(DateTime.Today.AddDays(i));
            }
            await ValidateAllTempSlots();
        }
    }

    private async void ToggleDate(DateTime date) {
        if (date < DateTime.Today) return;
        if (selectedDates.Any(d => d.Date == date.Date)) selectedDates.RemoveAll(d => d.Date == date.Date);
        else selectedDates.Add(date);
        await ValidateAllTempSlots();
    }

    private void PrevMonth() => currentMonth = currentMonth.AddMonths(-1);
    private void NextMonth() => currentMonth = currentMonth.AddMonths(1);
    private void CancelEdit() {
        showForm = false;
        isBulkEdit = false;
    }
    
    private void BulkEditSlotsForDate(DateTime date) {
        if (selectedDoctorFilter <= 0) return;
        
        var dateOnly = DateOnly.FromDateTime(date);
        var slotsToEdit = slots
            .Where(s => s.dcode == selectedDoctorFilter && 
                       (s.slot_date == dateOnly || (s.slot_date == null && s.day_of_week == date.DayOfWeek.ToString().ToUpper())) && 
                       !s.isdeleted)
            .OrderBy(s => s.slot_start_time)
            .ToList();
            
        if (!slotsToEdit.Any()) return;
        
        currentDcode = selectedDoctorFilter;
        selectedDates.Clear();
        selectedDates.Add(date);
        
        tempSlots.Clear();
        foreach (var slot in slotsToEdit) {
            tempSlots.Add(new SlotEntry {
                SlotMasterId = slot.slot_master_id,
                SlotTypeId = slot.slot_type_id,
                StartTime = DateTime.Today.Add(slot.slot_start_time.ToTimeSpan()),
                EndTime = DateTime.Today.Add(slot.slot_end_time.ToTimeSpan()),
                OriginalStartTime = slot.slot_start_time,
                OriginalEndTime = slot.slot_end_time,
                AvgTime = slot.avgtime ?? 0,
                TotalPatients = slot.max_patients,
                Walkin = slot.max_walkin,
                Online = slot.max_online,
                TypeOfSlot = slot.typeofslot?.Trim() ?? "",
                Slotnum = slot.slotnum,
                CreatedAt = slot.created_at,
                IsCancel = slot.is_cancel,
                CancelReason = slot.cancel_reason
            });
        }
        
        foreach (var entry in tempSlots) {
            OnSlotTypeSync(entry);
        }
        
        isNew = false;
        isBulkEdit = true;
        showForm = true;
        StateHasChanged();
    }
    private async Task DeleteSlotFromVertical(Guid? id)
    {
        if (id.HasValue && id.Value != Guid.Empty)
        {
            await DeleteSlot(id.Value);
            CancelEdit();
        }
    }
    private async Task DeleteSlot(Guid id) {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this already existing slot?");
        if (confirmed) {
            if (await SlotService.DeleteSlotAsync(id)) {
                await LoadData();
                ToastService.ShowSuccess("Slot deleted successfully.");
            } else {
                ToastService.ShowError("Failed to delete slot.");
            }
        }
    }
    private void OnSlotTypeSync(SlotEntry slot) {
        var type = slotTypes.FirstOrDefault(t => t.slot_type_id == slot.SlotTypeId);
        slot.TypeOfSlot = type?.name ?? "patient";
        if (type == null || !type.is_visiting)
        {
            slot.AvgTime = 0;
            slot.Walkin = 0;
            slot.Online = 0;
            slot.TotalPatients = 0;
        }
    }

    private bool IsVisitingSlot(SlotEntry slot)
    {
        if (slot == null || slot.SlotTypeId <= 0) return false;
        var type = slotTypes.FirstOrDefault(t => t.slot_type_id == slot.SlotTypeId);
        return type != null && type.is_visiting;
    }

    private async Task OnSlotTypeSelected(SlotEntry slot, ChangeEventArgs e) {
        if (long.TryParse(e.Value?.ToString(), out long id)) {
            slot.SlotTypeId = id;
            var type = slotTypes.FirstOrDefault(t => t.slot_type_id == id);
            slot.TypeOfSlot = type?.name ?? "patient";
            await JSRuntime.InvokeVoidAsync("console.log", "Slot Type Selected:", new { Id = id, Name = slot.TypeOfSlot });
        }
    }

    private string GetSlotColor(long slotTypeId) {
        var type = slotTypes.FirstOrDefault(t => t.slot_type_id == slotTypeId);
        if (type == null || string.IsNullOrWhiteSpace(type.colorcode)) return "#cbd5e1"; // Default gray
        return type.colorcode;
    }

    private string GetSlotEmoji(long slotTypeId) {
        var type = slotTypes.FirstOrDefault(t => t.slot_type_id == slotTypeId);
        if (type == null || string.IsNullOrWhiteSpace(type.emoji)) return "";
        return type.emoji;
    }

    private async Task FilterByDoctor(ChangeEventArgs e) {
        selectedDoctorFilter = int.Parse(e.Value?.ToString() ?? "0");
        if (selectedDoctorFilter == 0) slots = await SlotService.GetSlotsAsync();
        else slots = await SlotService.GetSlotsByDoctorAsync(selectedDoctorFilter);
        TranslateSlotsToIndianTime(slots);
        SyncSlotTypeIds(slots);
        StateHasChanged();
    }
