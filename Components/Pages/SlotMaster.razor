@page "/slots"
@inject SlotService SlotService
@inject DoctorService DoctorService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject Booking.Services.ToastService ToastService
@inject DoctorAppointmentSlotTypeService SlotTypeService

@if (showForm)
{
    <div class="modal-backdrop" @onclick="CancelEdit"></div>
    <div class="doctor-modal glass-card doctor-modal-responsive">
        <div class="modal-header">
            <h3 style="font-weight: 800; color: #026aa7;">New Slot Entry</h3>
            <button class="close-btn" @onclick="CancelEdit">×</button>
        </div>

        <div class="modal-body modal-body-responsive">
            <!-- TOP BAR: DOCTOR & QUICK SELECT -->
            <div class="form-row">
                <div class="form-col doctor-select-col">
                    <label style="font-weight: 800; color: #026aa7; font-size: 0.9rem;">Doctor Name</label>
                    <InputSelect @bind-Value="currentDcode" @bind:after="ValidateAllTempSlots" class="form-control" style="height: 40px; font-weight: 500; color: #2c3441;">
                        <option value="0">Select Doctor</option>
                        @foreach (var doc in doctors) { <option value="@doc.dcode">@doc.doctorfullname</option> }
                    </InputSelect>
                </div>
                <div class="form-col quick-select-col">
                    <label style="font-weight: 800; color: #026aa7; font-size: 0.9rem;">Quick Select</label>
                    <select class="form-control" style="height: 40px; font-weight: 500; color: #2c3441;" @onchange="OnQuickSelectChange">
                        <option value="0">Select Days</option>
                        <option value="2">Next 2 Days</option>
                        <option value="3">Next 3 Days</option>
                        <option value="7">Next 7 Days</option>
                    </select>
                </div>
                <div class="form-col">
                    <label style="font-weight: 800; color: #026aa7; font-size: 0.9rem;">Selected Dates Summary</label>
                    <div class="form-control" style="min-height: 40px; background: #f8fafc; font-size: 0.8rem; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; display: flex; align-items: center; font-weight: 500; color: #2c3441;">
                        <i class="bi bi-calendar-check" style="margin-right: 8px; color: #026aa7;"></i>
                        @(selectedDates.Any() ? string.Join(", ", selectedDates.OrderBy(d => d).Select(d => d.ToString("dd/MM (ddd)"))) : "No dates selected")
                    </div>
                </div>
            </div>

            <!-- MAIN SPLIT VIEW -->
            <div class="modal-split-view">
                <!-- LEFT: CALENDAR -->
                <div class="calendar-sidebar">
                    <div class="calendar-inline">
                        <div class="calendar-header">
                            <div class="month-year-title">@currentMonth.ToString("MMMM yyyy")</div>
                            <div class="header-nav">
                                <button type="button" class="nav-btn" @onclick="PrevMonth"><i class="bi bi-chevron-up"></i></button>
                                <button type="button" class="nav-btn" @onclick="NextMonth"><i class="bi bi-chevron-down"></i></button>
                            </div>
                        </div>
                        <div class="calendar-grid">
                            <div class="day-label">Su</div><div class="day-label">Mo</div><div class="day-label">Tu</div><div class="day-label">We</div><div class="day-label">Th</div><div class="day-label">Fr</div><div class="day-label">Sa</div>
                            @for (int i = 0; i < firstDayOffset; i++) { <div class="calendar-day disabled"></div> }
                            @for (int day = 1; day <= daysInMonth; day++)
                            {
                                var date = new DateTime(currentMonth.Year, currentMonth.Month, day);
                                var isDisabled = date < DateTime.Today;
                                var isSelected = selectedDates.Any(d => d.Date == date.Date);
                                var isToday = date.Date == DateTime.Today;
                                <div class="calendar-day @(isDisabled ? "disabled" : "") @(isSelected ? "selected" : "") @(isToday ? "today" : "")" @onclick="() => ToggleDate(date)">@day</div>
                            }
                        </div>
                        <div class="calendar-footer">
                            <button type="button" class="footer-btn" @onclick="() => selectedDates.Clear()">Clear All</button>
                            <span style="font-size: 0.75rem; font-weight: 700; color: #64748b;">@selectedDates.Count selected</span>
                        </div>
                    </div>
                </div>

                <!-- RIGHT: SLOT TABLE -->
                <div class="slot-list-container">
                    <!-- Unified Horizontal Scroll Container -->
                    <div class="unified-scroll-container">
                        <div class="slot-grid-container">
                            <!-- Header -->
                            <div class="slot-header">
                                <div>Slot</div>
                                <div>Start time</div>
                                <div>End time</div>
                                <div class="text-center dur-col">Dur</div>
                                <div>Slot Type</div>
                                <div class="text-center patient-col">Patients</div>
                                <div class="text-center walkin-col">Walkin</div>
                                <div class="text-center online-col">Online</div>
                                <div class="text-center action-col">Action</div>
                            </div>

                            <!-- Body (Vertical Scroll Only) -->
                            <!-- Body (Vertical Scroll Only) -->
                            <div class="slot-body-container">
                                @for (int i = 0; i < tempSlots.Count; i++)
                                {
                                    int index = i;
                                    var slot = tempSlots[index];
                                    <div class="slot-row">
                                        <div class="mobile-label">SLOT</div>
                                        <div class="slot-num">@(index + 1)</div>

                                        <div class="mobile-label">START TIME</div>
                                        <div class="start-time-col"><input type="time" @bind="slot.StartTime" @bind:after="() => OnTimeChanged(slot)" class="compact-input" /></div>

                                        <div class="mobile-label">END TIME</div>
                                        <div class="end-time-col"><input type="time" @bind="slot.EndTime" @bind:after="() => OnTimeChanged(slot)" class="compact-input" /></div>

                                        <div class="mobile-label">DURATION</div>
                                        <div class="dur-col"><input type="text" value="@slot.Duration" class="compact-input text-center" readonly /></div>

                                        <div class="mobile-label">SLOT TYPE</div>
                                        <div class="slot-type-col">
                                            <InputSelect @bind-Value="slot.SlotTypeId" class="compact-input">
                                                <option value="0">Select Type</option>
                                                @foreach (var type in slotTypes) { <option value="@type.slot_type_id">@type.name</option> }
                                            </InputSelect>
                                        </div>

                                        <div class="mobile-label">PATIENTS</div>
                                        <div class="patient-col"><input type="number" @bind="slot.TotalPatients" class="compact-input text-center" /></div>

                                        <div class="mobile-label">WALK-IN</div>
                                        <div class="walkin-col"><input type="number" @bind="slot.Walkin" class="compact-input text-center" /></div>

                                        <div class="mobile-label">ONLINE</div>
                                        <div class="online-col"><input type="number" @bind="slot.Online" class="compact-input text-center" /></div>

                                        <div class="mobile-label">ACTION</div>
                                        <div class="action-col" style="display: flex; justify-content: center;">
                                            @if (tempSlots.Count > 1)
                                            {
                                                <button type="button" class="btn-remove-slot" @onclick="() => RemoveSlot(index)" title="Remove Slot">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="no-actions-placeholder"></span>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (tempSlots.Count == 0)
                                {
                                    <div class="empty-slots-msg" style="padding: 2rem; text-align: center; color: #64748b; font-style: italic; grid-column: 1 / -1;">
                                        No slots added. Click "Add Another Slot" to start.
                                    </div>
                                }
                                <div class="add-slot-container" style="padding: 0.5rem; display: flex; justify-content: center; grid-column: 1 / -1;">
                                    <button type="button" class="btn-add-slot-new" @onclick="AddSlotTab" style="width: auto; padding: 0.6rem 2.5rem; margin: 0;">
                                        <i class="bi bi-plus-circle-fill"></i> Add Another Slot
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <div style="flex: 1;"></div>
            <button type="button" class="btn-save" style="background: #026aa7;" @onclick="SaveAllSlots">
                Save
            </button>
        </div>
    </div>
}

<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
    <div class="floating-blob blob-3"></div>
    <div class="pattern-overlay"></div>
</div>

<div style="max-width: 1200px; margin: 0rem auto 0 auto; padding: 0 0.5rem;">
    <h1 style="color: #004b71; font-weight: 800; font-size: 1.75rem; margin-bottom: 0.5rem;">Slot Booking</h1>
</div>

<div class="calendar-top-bar">
    <!-- LEFT CORNER: DATE SELECTION & VIEW TOGGLES -->
    <div class="top-bar-left">
        <div class="calendar-navigation">
            <button class="nav-arrow" @onclick="PrevView"><i class="bi bi-chevron-left"></i></button>
            <h2 class="current-range">@GetViewRangeText()</h2>
            <button class="nav-arrow" @onclick="NextView"><i class="bi bi-chevron-right"></i></button>
        </div>

        <div class="view-toggles">
            <button class="toggle-btn @(viewMode == "DAY" ? "active" : "")" @onclick='() => SetViewMode("DAY")'>DAY</button>
            <button class="toggle-btn @(viewMode == "WEEK" ? "active" : "")" @onclick='() => SetViewMode("WEEK")'>WEEK</button>
        </div>
    </div>

    <!-- RIGHT CORNER: DOCTOR SELECTION & NEW SLOT BUTTON -->
    <div class="top-bar-right">
        <div class="doctor-filter-wrapper" style="position: relative;">
            <i class="bi bi-person-fill" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.9rem;"></i>
            <select class="unified-doctor-select" @onchange="FilterByDoctor" style="padding-left: 30px;">
                <option value="0">All Doctors</option>
                @foreach (var doc in doctors) { <option value="@doc.dcode">@doc.doctorfullname</option> }
            </select>
        </div>

        <button class="btn-add-unified" @onclick="CreateNew">
            <i class="bi bi-plus-lg"></i>
            <span>New Slot</span>
        </button>
    </div>
</div>

<div class="calendar-main-container" style="margin-top: 0; padding-top: 0.5rem;">

    <div class="calendar-grid-wrapper @(viewMode.ToLower())">
        @if (viewMode == "WEEK")
        {
            <div class="grid-header">
                @for (int i = 0; i < 7; i++)
                {
                    var date = viewDate.AddDays(i);
                    <div class="header-cell">
                        <span class="day-name">@date.ToString("ddd").ToUpper()</span>
                        <span class="day-num">@date.Day</span>
                    </div>
                }
            </div>
            <div class="grid-body">
                @if (selectedDoctorFilter == 0)
                {
                    // Get all doctors who have slots in this week to create rows
                    var doctorsInWeek = slots
                        .Where(s => {
                            for (int i = 0; i < 7; i++) {
                                var d = viewDate.AddDays(i);
                                var doOnly = DateOnly.FromDateTime(d);
                                if (s.slot_date == doOnly || (s.slot_date == null && s.day_of_week == d.DayOfWeek.ToString().ToUpper())) return true;
                            }
                            return false;
                        })
                        .Select(s => s.dcode)
                        .Distinct()
                        .OrderBy(d => GetDoctorName(d))
                        .ToList();

                    @foreach (var docId in doctorsInWeek)
                    {
                        <div class="week-doctor-divider-row">
                            <i class="bi bi-person-fill"></i>
                            <span>@GetDoctorName(docId)</span>
                        </div>
                        @for (int i = 0; i < 7; i++)
                        {
                            var currentDate = viewDate.AddDays(i);
                            var dateOnly = DateOnly.FromDateTime(currentDate);
                            var docDaySlots = slots
                                .Where(s => s.dcode == docId)
                                .Where(s => s.slot_date == dateOnly || (s.slot_date == null && s.day_of_week == currentDate.DayOfWeek.ToString().ToUpper()))
                                .OrderBy(s => s.slot_start_time)
                                .ToList();

                            <div class="grid-column @(currentDate.Date == DateTime.Today ? "today" : "")">
                                @foreach (var slot in docDaySlots)
                                {
                                    <div class="slot-card">
                                        <div class="slot-card-header">
                                            <span class="slot-title">Slot @(docDaySlots.IndexOf(slot) + 1)</span>
                                            <div class="slot-actions">
                                                <button class="v2-action-btn edit" @onclick="() => EditSlot(slot)" title="View"><i class="bi bi-eye-fill"></i></button>
                                                <button class="v2-action-btn delete" @onclick="() => DeleteSlot(slot.slot_master_id)" title="Delete"><i class="bi bi-trash3-fill"></i></button>
                                            </div>
                                        </div>
                                        <div class="slot-card-time">
                                            <span>@slot.slot_start_time.ToString("h:mm tt") - @slot.slot_end_time.ToString("h:mm tt")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                }
                else
                {
                    @for (int i = 0; i < 7; i++)
                    {
                        var currentDate = viewDate.AddDays(i);
                        var dateOnly = DateOnly.FromDateTime(currentDate);
                        var filteredSlots = slots
                            .Where(s => s.dcode == selectedDoctorFilter)
                            .Where(s => s.slot_date == dateOnly || (s.slot_date == null && s.day_of_week == currentDate.DayOfWeek.ToString().ToUpper()))
                            .OrderBy(s => s.slot_start_time)
                            .ToList();

                        <div class="grid-column @(currentDate.Date == DateTime.Today ? "today" : "")">
                            @foreach (var slot in filteredSlots)
                            {
                                <div class="slot-card">
                                    <div class="slot-card-header">
                                        <span class="slot-title">Slot @(filteredSlots.IndexOf(slot) + 1)</span>
                                        <div class="slot-actions">
                                            <button class="v2-action-btn edit" @onclick="() => EditSlot(slot)" title="View"><i class="bi bi-eye-fill"></i></button>
                                            <button class="v2-action-btn delete" @onclick="() => DeleteSlot(slot.slot_master_id)" title="Delete"><i class="bi bi-trash3-fill"></i></button>
                                            </div>
                                    </div>
                                    <div class="slot-card-time">
                                        <span>@slot.slot_start_time.ToString("h:mm tt") - @slot.slot_end_time.ToString("h:mm tt")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <!-- DAY VIEW -->
            <div class="day-view-container">
                @{
                    var dateOnly = DateOnly.FromDateTime(viewDate);
                    var daySlots = slots
                        .Where(s => (selectedDoctorFilter == 0 || s.dcode == selectedDoctorFilter))
                        .Where(s => s.slot_date == dateOnly || (s.slot_date == null && s.day_of_week == viewDate.DayOfWeek.ToString().ToUpper()))
                        .OrderBy(s => s.slot_start_time)
                        .ToList();
                }
                <div class="day-view-date-card">
                    <div class="date-badge">
                        <span class="month-label">@viewDate.ToString("MMM").ToUpper()</span>
                        <span class="day-label-num">@viewDate.Day</span>
                    </div>
                    <div class="date-details">
                        <h2 class="day-full-name">@viewDate.ToString("dddd")</h2>
                        <p class="full-date-text">@viewDate.ToString("MMMM dd, yyyy")</p>
                    </div>
                    <div style="flex: 1;"></div>
                    <div class="day-stats">
                        
                        <div class="date-badge">
                            <div class="stat-value">@daySlots.Count</div>
                            <div class="stat-label">Total Slots</div>
                        </div>
                    </div>
                </div>

                <div class="day-slots-grid">
                    @if (selectedDoctorFilter == 0)
                    {
                        @foreach (var doctorGroup in daySlots.GroupBy(s => s.dcode).OrderBy(g => GetDoctorName(g.Key)))
                        {
                            var groupList = doctorGroup.OrderBy(s => s.slot_start_time).ToList();
                            <div class="doctor-group-header">
                                <i class="bi bi-person-fill"></i>
                                <span>@GetDoctorName(doctorGroup.Key).ToUpper()</span>
                                <span class="doctor-slot-count">@doctorGroup.Count() Slots</span>
                            </div>
                            @foreach (var slot in groupList)
                            {
                                <div class="slot-card-v2">
                                    <div class="slot-v2-header">
                                        <span class="slot-v2-number">SLOT @(groupList.IndexOf(slot) + 1)</span>
                                        <div class="slot-v2-actions">
                                            <button class="v2-action-btn edit" @onclick="() => EditSlot(slot)" title="View"><i class="bi bi-eye-fill"></i></button>
                                            <button class="v2-action-btn delete" @onclick="() => DeleteSlot(slot.slot_master_id)" title="Delete"><i class="bi bi-trash3-fill"></i></button>
                                        </div>
                                    </div>
                                    <div class="slot-v2-time">
                                        <div class="time-block">
                                            <span class="time-label">START</span>
                                            <span class="time-value">@slot.slot_start_time.ToString("h:mm tt")</span>
                                        </div>
                                        <div class="time-block text-end">
                                            <span class="time-label">END</span>
                                            <span class="time-value">@slot.slot_end_time.ToString("h:mm tt")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        @foreach (var slot in daySlots)
                        {
                            <div class="slot-card-v2">
                                <div class="slot-v2-header">
                                    <span class="slot-v2-number">SLOT @(daySlots.IndexOf(slot) + 1)</span>
                                    <div class="slot-v2-actions">
                                        <button class="v2-action-btn edit" @onclick="() => EditSlot(slot)" title="View"><i class="bi bi-eye-fill"></i></button>
                                        <button class="v2-action-btn delete" @onclick="() => DeleteSlot(slot.slot_master_id)" title="Delete"><i class="bi bi-trash3-fill"></i></button>
                                    </div>
                                </div>
                                <div class="slot-v2-time">
                                    <div class="time-block">
                                        <span class="time-label">START</span>
                                        <span class="time-value">@slot.slot_start_time.ToString("h:mm tt")</span>
                                    </div>
                                    <div class="time-block text-end">
                                        <span class="time-label">END</span>
                                        <span class="time-value">@slot.slot_end_time.ToString("h:mm tt")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    @if (!daySlots.Any())
                    {
                        <div class="empty-state-simple">
                            <i class="bi bi-calendar-x"></i>
                            <p>No slots scheduled for this day</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>


@code {
    private List<DoctorAppointmentSlotMasterModel> slots = new();
    private List<DoctorMasterModel> doctors = new();
    private List<DoctorAppointmentSlotTypeModel> slotTypes = new();
    private int currentDcode = 0;
    private bool showForm = false;
    private bool isNew = true;
    private bool showCalendar = false;
    private string viewMode = "WEEK"; // "DAY" or "WEEK"
    private int selectedDoctorFilter = 0;

    // Multi-Slot Logic
    private class SlotEntry {
        public Guid? SlotMasterId { get; set; }
        public long SlotTypeId { get; set; }
        public DateTime StartTime { get; set; } = DateTime.Today.AddHours(9);
        public DateTime EndTime { get; set; } = DateTime.Today.AddHours(10);
        public int TotalPatients { get; set; } = 10;
        public int Walkin { get; set; } = 5;
        public int Online { get; set; } = 5;
        public int Duration => (int)(EndTime - StartTime).TotalMinutes;
    }
    private List<SlotEntry> tempSlots = new();

    // Calendar logic
    private List<DateTime> selectedDates = new();
    private DateTime currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private int daysInMonth => DateTime.DaysInMonth(currentMonth.Year, currentMonth.Month);
    private int firstDayOffset => (int)new DateTime(currentMonth.Year, currentMonth.Month, 1).DayOfWeek;

    private DateTime viewDate = DateTime.Today;
    
    private void PrevView() {
        if (viewMode == "WEEK") viewDate = viewDate.AddDays(-7);
        else viewDate = viewDate.AddDays(-1);
    }
    
    private void NextView() {
        if (viewMode == "WEEK") viewDate = viewDate.AddDays(7);
        else viewDate = viewDate.AddDays(1);
    }

    private void SetViewMode(string mode) {
        viewMode = mode;
        StateHasChanged();
    }

    private string GetViewRangeText() {
        if (viewMode == "DAY") return viewDate.ToString("MMMM dd, yyyy");
        var end = viewDate.AddDays(6);
        if (viewDate.Month == end.Month) 
            return $"{viewDate.ToString("MMMM dd")} - {end.Day}, {end.Year}";
        return $"{viewDate.ToString("MMMM dd")} - {end.ToString("MMMM dd")}, {end.Year}";
    }


    protected override async Task OnInitializedAsync() => await LoadData();
    private void ToggleCalendar() => showCalendar = !showCalendar;

    private async Task LoadData() {
        doctors = (await DoctorService.GetDoctorsAsync()).OrderBy(d => d.doctorfullname).ToList();
        slotTypes = await SlotTypeService.GetSlotTypesAsync();
        slots = await SlotService.GetSlotsAsync();
    }

    private string GetDoctorName(int dcode) => doctors.FirstOrDefault(d => d.dcode == dcode)?.doctorfullname ?? "Unknown Doctor";

    private void CreateNew() {
        currentDcode = 0;
        selectedDates.Clear();
        selectedDates.Add(DateTime.Today);
        tempSlots.Clear();
        var defaultType = slotTypes.FirstOrDefault(t => t.name?.Contains("Patient", StringComparison.OrdinalIgnoreCase) == true) ?? slotTypes.FirstOrDefault();
        tempSlots.Add(new SlotEntry { SlotTypeId = defaultType?.slot_type_id ?? 0 });
        isNew = true;
        showForm = true;
    }

    private async Task AddSlotTab() {
        var defaultType = slotTypes.FirstOrDefault(t => t.name?.Contains("Patient", StringComparison.OrdinalIgnoreCase) == true) ?? slotTypes.FirstOrDefault();
        var lastSlot = tempSlots.LastOrDefault();
        var newSlot = new SlotEntry { SlotTypeId = defaultType?.slot_type_id ?? 0 };
        
        if (lastSlot != null) {
            newSlot.StartTime = lastSlot.EndTime.AddMinutes(1);
            newSlot.EndTime = lastSlot.EndTime.AddHours(1);
            newSlot.SlotTypeId = lastSlot.SlotTypeId;
            newSlot.TotalPatients = lastSlot.TotalPatients;
            newSlot.Walkin = lastSlot.Walkin;
            newSlot.Online = lastSlot.Online;
        }

        var currentStart = TimeOnly.FromDateTime(newSlot.StartTime);
        var currentEnd = TimeOnly.FromDateTime(newSlot.EndTime);

        await JSRuntime.InvokeVoidAsync("console.log", "--- Checking Conflict for New Slot ---", new { 
            Start = currentStart.ToString(), 
            End = currentEnd.ToString(),
            Doctor = currentDcode,
            DatesCount = selectedDates.Count
        });

        // 1. Check against other slots ALREADY in the form
        foreach (var s in tempSlots) {
            var otherStart = TimeOnly.FromDateTime(s.StartTime);
            var otherEnd = TimeOnly.FromDateTime(s.EndTime);
            if (currentStart < otherEnd && currentEnd > otherStart) {
                ShowToast($"Local Conflict: Overlaps with Slot #{tempSlots.IndexOf(s) + 1} ({otherStart:hh:mm tt})");
                return; // Stop here and don't add the slot
            }
        }

        // 2. Check against database slots
        if (currentDcode > 0) {
            foreach (var date in selectedDates) {
                var dateOnly = DateOnly.FromDateTime(date);
                var currentDay = date.DayOfWeek.ToString().ToUpper();
                
                var conflicts = slots.Where(s => s.dcode == currentDcode && 
                                           (s.slot_date == dateOnly || (s.slot_date == null && s.day_of_week == currentDay)) && 
                                           !s.isdeleted).ToList();

                var dbConflict = conflicts.FirstOrDefault(s => (currentStart < s.slot_end_time && currentEnd > s.slot_start_time));
                
                if (dbConflict != null) {
                    ShowToast($"Existing Conflict: A slot already exists on {dateOnly:dd/MM/yyyy} ({dbConflict.slot_start_time:hh:mm tt} - {dbConflict.slot_end_time:hh:mm tt}).");
                    return; // Stop here and don't add the slot
                }
            }
        }
        
        tempSlots.Add(newSlot);
    }

    private void RemoveSlot(int index) {
        tempSlots.RemoveAt(index);
    }

    private void ShowToast(string message, string type = "error")
    {
        if (type == "error") ToastService.ShowError(message);
        else ToastService.ShowSuccess(message);
    }

    private async Task<bool> ValidateAllTempSlots(bool showToast = false)
    {
        bool allValid = true;
        foreach (var slot in tempSlots)
        {
            if (!await ValidateTimeSlots(slot, showToast))
            {
                allValid = false;
            }
        }
        return allValid;
    }

    private async Task OnTimeChanged(SlotEntry slot)
    {
        await ValidateTimeSlots(slot);
        StateHasChanged();
    }

    private async Task<bool> ValidateTimeSlots(SlotEntry currentSlot, bool showToast = false)
    {
        var currentStart = TimeOnly.FromDateTime(currentSlot.StartTime);
        var currentEnd = TimeOnly.FromDateTime(currentSlot.EndTime);
        
        if (currentEnd <= currentStart)
        {
            if (showToast) ShowToast("Invalid Time: End time must be after start time.");
            return false;
        }

        // 1. Check against other slots in the current list
        foreach (var other in tempSlots.Where(s => s != currentSlot))
        {
            var otherStart = TimeOnly.FromDateTime(other.StartTime);
            var otherEnd = TimeOnly.FromDateTime(other.EndTime);

            if (currentStart < otherEnd && currentEnd > otherStart)
            {
                if (showToast) ShowToast($"Conflict: This slot overlaps with Slot #{tempSlots.IndexOf(other) + 1} ({otherStart:hh:mm tt} - {otherEnd:hh:mm tt})");
                return false;
            }
        }

        // 2. Check against existing slots for the selected doctor and dates
        if (currentDcode > 0)
        {
            foreach (var date in selectedDates)
            {
                var dateOnly = DateOnly.FromDateTime(date);
                var currentDay = date.DayOfWeek.ToString().ToUpper();
                
                var potentialConflicts = slots.Where(s => s.dcode == currentDcode && 
                                               (s.slot_date == dateOnly || s.day_of_week == currentDay) && 
                                               s.slot_master_id != currentSlot.SlotMasterId &&
                                               !s.isdeleted).ToList();
                
                foreach (var dbSlot in potentialConflicts)
                {
                    bool overlaps = (currentStart < dbSlot.slot_end_time && currentEnd > dbSlot.slot_start_time);
                    if (overlaps)
                    {
                        if (showToast) ShowToast($"Existing Conflict: A slot already exists on {dateOnly:dd/MM/yyyy} for this time range ({dbSlot.slot_start_time:hh:mm tt} - {dbSlot.slot_end_time:hh:mm tt})");
                        return false;
                    }
                }
            }
        }
        return true;
    }

    private void UpdateDuration() { StateHasChanged(); }

    private void EditSlot(DoctorAppointmentSlotMasterModel slot) {
        currentDcode = slot.dcode;
        selectedDates.Clear();
        if (slot.slot_date.HasValue) selectedDates.Add(slot.slot_date.Value.ToDateTime(TimeOnly.MinValue));
        
        tempSlots.Clear();
        tempSlots.Add(new SlotEntry {
            SlotMasterId = slot.slot_master_id,
            SlotTypeId = slot.slot_type_id,
            StartTime = DateTime.Today.Add(slot.slot_start_time.ToTimeSpan()),
            EndTime = DateTime.Today.Add(slot.slot_end_time.ToTimeSpan()),
            TotalPatients = slot.max_patients,
            Walkin = slot.max_walkin,
            Online = slot.max_online
        });
        
        isNew = false;
        showForm = true;
    }



    private async Task SaveAllSlots() {
        if (currentDcode == 0) {
            ShowToast("Please select a doctor.");
            return;
        }
        if (!selectedDates.Any()) {
            ShowToast("Please select at least one date.");
            return;
        }

        // Perform full validation WITH toasts before saving
        if (!await ValidateAllTempSlots(showToast: true)) {
            return;
        }

        var slotsToSave = new List<object>();
        
        foreach (var date in selectedDates) {
            foreach (var s in tempSlots) {
                if (isNew) {
                    slotsToSave.Add(new {
                        dcode = currentDcode,
                        slot_type_id = s.SlotTypeId,
                        day_of_week = date.DayOfWeek.ToString().ToUpper(),
                        slot_start_time = TimeOnly.FromDateTime(s.StartTime).ToString("HH:mm:ss"),
                        slot_end_time = TimeOnly.FromDateTime(s.EndTime).ToString("HH:mm:ss"),
                        max_patients = s.TotalPatients,
                        max_walkin = s.Walkin,
                        max_online = s.Online,
                        slot_date = date.ToString("yyyy-MM-dd"),
                        is_active = true,
                        isdeleted = false
                    });
                } else {
                    slotsToSave.Add(new {
                        slot_master_id = s.SlotMasterId,
                        dcode = currentDcode,
                        slot_type_id = s.SlotTypeId,
                        day_of_week = date.DayOfWeek.ToString().ToUpper(),
                        slot_start_time = TimeOnly.FromDateTime(s.StartTime).ToString("HH:mm:ss"),
                        slot_end_time = TimeOnly.FromDateTime(s.EndTime).ToString("HH:mm:ss"),
                        max_patients = s.TotalPatients,
                        max_walkin = s.Walkin,
                        max_online = s.Online,
                        slot_date = date.ToString("yyyy-MM-dd"),
                        is_active = true,
                        isdeleted = false
                    });
                }
            }
        }
        
        var json = System.Text.Json.JsonSerializer.Serialize(slotsToSave, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        await JSRuntime.InvokeVoidAsync("console.log", $"SAVING SLOTS - Mode: {(isNew ? "INSERT" : "UPDATE")}", slotsToSave);
        
        Console.WriteLine("*************************************************");
        Console.WriteLine($"SAVING SLOTS - Mode: {(isNew ? "INSERT" : "UPDATE")}");
        Console.WriteLine(json);
        Console.WriteLine("*************************************************");

        if (isNew) {
            var result = await SlotService.InsertSlotAsync(slotsToSave);
            
            // Check for skipped slots (overlaps) and show as errors
            if (result.skipped != null && result.skipped.Any()) {
                foreach (var msg in result.skipped) {
                    ToastService.ShowError(msg);
                }
            }

            // If we inserted at least one or if there were no failures, close form
            if (result.inserted != null && result.inserted.Any()) {
                showForm = false;
                await LoadData();
                ToastService.ShowSuccess($"Successfully added {result.inserted.Count} slots.");
            }
        } else {
            bool success = await SlotService.UpdateSlotAsync(slotsToSave.FirstOrDefault());
            if (success) {
                showForm = false;
                await LoadData();
                ToastService.ShowSuccess("Slot updated successfully.");
            }
        }
    }

    private async void OnQuickSelectChange(ChangeEventArgs e) {
        int days = int.Parse(e.Value?.ToString() ?? "0");
        if (days >= 2) {
            selectedDates.Clear();
            for (int i = 0; i < days; i++) {
                selectedDates.Add(DateTime.Today.AddDays(i));
            }
            await ValidateAllTempSlots();
        }
    }

    private async void ToggleDate(DateTime date) {
        if (date < DateTime.Today) return;
        if (selectedDates.Any(d => d.Date == date.Date)) selectedDates.RemoveAll(d => d.Date == date.Date);
        else selectedDates.Add(date);
        await ValidateAllTempSlots();
    }

    private void PrevMonth() => currentMonth = currentMonth.AddMonths(-1);
    private void NextMonth() => currentMonth = currentMonth.AddMonths(1);
    private void CancelEdit() => showForm = false;
    private async Task DeleteSlot(Guid id) { if (await SlotService.DeleteSlotAsync(id)) await LoadData(); }
    private async Task FilterByDoctor(ChangeEventArgs e) {
        selectedDoctorFilter = int.Parse(e.Value?.ToString() ?? "0");
        if (selectedDoctorFilter == 0) slots = await SlotService.GetSlotsAsync();
        else slots = await SlotService.GetSlotsByDoctorAsync(selectedDoctorFilter);
        StateHasChanged();
    }
