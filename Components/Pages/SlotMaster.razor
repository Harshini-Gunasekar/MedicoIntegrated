@page "/slots"
@inject SlotService SlotService
@inject DoctorService DoctorService
@inject NavigationManager Navigation
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject IJSRuntime JSRuntime
@inject Booking.Services.ToastService ToastService
@inject DoctorAppointmentSlotTypeService SlotTypeService
@inject AppointmentBookingService AppointmentService
@using Booking.Helpers

@if (showForm)
{
    <div class="modal-backdrop" @onclick="CancelEdit"></div>
    
    @if (!isNew && !isBulkEdit)
    {
        <!-- Separate Screen for Updating a Slot (Vertical 2-Column Card Layout) -->
        <div class="update-slot-modal glass-card">
            <div class="update-modal-header">
                <h3>Update Slot Details</h3>
                <button class="close-btn" @onclick="CancelEdit">×</button>
            </div>
            <div class="update-modal-body">
                @if (tempSlots.Any())
                {
                    var slot = tempSlots[0];
                    
                    <!-- Top Left Slot Preview Chip (from sketch) -->
                    <div class="slot-preview-chip">
                        <div class="chip-title">Slot @(tempSlots.IndexOf(slot) + 1)</div>
                        <div class="chip-time">
                            @TimeOnly.FromDateTime(slot.StartTime).ToString("hh:mm tt") - 
                            @TimeOnly.FromDateTime(slot.EndTime).ToString("hh:mm tt")
                        </div>
                    </div>

                    <!-- Two-column vertical table style -->
                    <div class="vertical-slot-card">
                        <!-- SLOT -->
                        <div class="vertical-slot-row">
                            <div class="vertical-label-cell">SLOT</div>
                            <div class="vertical-value-cell slot-number-text">@(tempSlots.IndexOf(slot) + 1)</div>
                        </div>

                        <!-- START TIME -->
                        <div class="vertical-slot-row">
                            <div class="vertical-label-cell">START TIME</div>
                            <div class="vertical-value-cell">
                                <div class="time-input-wrapper">
                                    <input type="time" @bind="slot.StartTime" @bind:after="() => OnTimeChanged(slot, isStartTime: true)" class="vertical-input" />
                                </div>
                            </div>
                        </div>

                        <!-- END TIME -->
                        <div class="vertical-slot-row">
                            <div class="vertical-label-cell">END TIME</div>
                            <div class="vertical-value-cell">
                                <div class="time-input-wrapper">
                                    <input type="time" @bind="slot.EndTime" @bind:after="() => OnTimeChanged(slot, isStartTime: false)" class="vertical-input" />
                                </div>
                            </div>
                        </div>

                        <!-- DURATION -->
                        <div class="vertical-slot-row">
                            <div class="vertical-label-cell">DURATION</div>
                            <div class="vertical-value-cell">
                                <input type="text" value="@slot.Duration" class="vertical-input readonly-input" readonly />
                            </div>
                        </div>

                        <!-- SLOT TYPE -->
                        <div class="vertical-slot-row">
                            <div class="vertical-label-cell">SLOT TYPE</div>
                            <div class="vertical-value-cell">
                                <select class="vertical-input" @bind="slot.SlotTypeId" @bind:after="() => OnSlotTypeSync(slot)">
                                    <option value="0">Select Type</option>
                                    @foreach (var type in slotTypes)
                                    {
                                        <option value="@type.slot_type_id">@type.name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- AVG TIME -->
                        <div class="vertical-slot-row">
                            <div class="vertical-label-cell">AVG TIME</div>
                            <div class="vertical-value-cell">
                                <input type="number" @bind="slot.AvgTime" @bind:after="() => OnAvgTimeChanged(slot)" class="vertical-input" disabled="@(!IsVisitingSlot(slot))" />
                            </div>
                        </div>

                        <!-- WALK-IN -->
                        <div class="vertical-slot-row">
                            <div class="vertical-label-cell">WALK-IN</div>
                            <div class="vertical-value-cell">
                                <input type="number" @bind="slot.Walkin" @bind:after="() => OnWalkinChanged(slot)" class="vertical-input" disabled="@(!IsVisitingSlot(slot))" />
                            </div>
                        </div>

                        <!-- ONLINE -->
                        <div class="vertical-slot-row">
                            <div class="vertical-label-cell">ONLINE</div>
                            <div class="vertical-value-cell">
                                <input type="number" @bind="slot.Online" @bind:after="() => OnOnlineChanged(slot)" class="vertical-input" disabled="@(!IsVisitingSlot(slot))" />
                            </div>
                        </div>

                        <!-- PATIENTS -->
                        <div class="vertical-slot-row">
                            <div class="vertical-label-cell">PATIENTS</div>
                            <div class="vertical-value-cell">
                                <input type="number" @bind="slot.TotalPatients" class="vertical-input readonly-input" readonly disabled="@(!IsVisitingSlot(slot))" />
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="update-footer">
                <button type="button" class="btn-cancel-update" @onclick="CancelEdit">Cancel</button>
                @if (tempSlots.Any())
                {
                    <button type="button" class="btn-delete-vertical" @onclick="() => DeleteSlotFromVertical(tempSlots[0].SlotMasterId)">Delete</button>
                }
                <button type="button" class="btn-save" style="background: #026aa7;" @onclick="SaveAllSlots">
                    Update
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Original New Slot Entry screen (Create Mode) / Bulk Edit Mode -->
        <div class="doctor-modal glass-card doctor-modal-responsive" style="@(isBulkEdit ? "width: 1050px;" : "")">
            <div class="modal-header">
                <h3 style="font-weight: 800; color: #026aa7;">@(isBulkEdit ? $"Bulk Edit Slots - {selectedDates.FirstOrDefault().ToString("dd/MM/yyyy")} ({GetDoctorName(currentDcode)})" : "New Slot Entry")</h3>
                <button class="close-btn" @onclick="CancelEdit">×</button>
            </div>

            <div class="modal-body modal-body-responsive">
                @if (!isBulkEdit)
                {
                    <!-- TOP BAR: DOCTOR & QUICK SELECT -->
                    <div class="form-row">
                    <div class="form-col doctor-select-col">
                        <label style="font-weight: 800; color: #026aa7; font-size: 0.9rem;">Doctor Name</label>
                        <InputSelect @bind-Value="currentDcode" @bind:after="ValidateAllTempSlots" class="form-control" style="height: 44px; font-weight: 500; color: #2c3441;">
                            <option value="0">Select Doctor</option>
                            @foreach (var doc in doctors) { <option value="@doc.dcode">@(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</option> }
                        </InputSelect>
                    </div>
                    <div class="form-col quick-select-col">
                        <label style="font-weight: 800; color: #026aa7; font-size: 0.9rem;">Quick Select</label>
                        <select class="form-control" style="height: 44px; font-weight: 500; color: #2c3441;" @onchange="OnQuickSelectChange">
                            <option value="0">Select Days</option>
                            <option value="2">Next 2 Days</option>
                            <option value="3">Next 3 Days</option>
                            <option value="7">Next 7 Days</option>
                        </select>
                    </div>
                    <div class="form-col">
                        <label style="font-weight: 800; color: #026aa7; font-size: 0.9rem;">Selected Dates Summary</label>
                        <div class="form-control" style="min-height: 44px; background: #f8fafc; font-size: 0.8rem; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; display: flex; align-items: center; font-weight: 500; color: #2c3441;">
                            <i class="bi bi-calendar-check" style="margin-right: 8px; color: #026aa7;"></i>
                            @(selectedDates.Any() ? string.Join(", ", selectedDates.OrderBy(d => d).Select(d => d.ToString("dd/MM (ddd)"))) : "No dates selected")
                        </div>
                    </div>
                </div>
                }

                <!-- MAIN SPLIT VIEW -->
                <div class="modal-split-view">
                    @if (!isBulkEdit)
                    {
                        <!-- LEFT: CALENDAR -->
                        <div class="calendar-sidebar">
                        <div class="calendar-inline">
                            <div class="calendar-header">
                                <div class="month-year-title">@currentMonth.ToString("MMMM yyyy")</div>
                                <div class="header-nav">
                                    <button type="button" class="nav-btn" @onclick="PrevMonth"><i class="bi bi-chevron-up"></i></button>
                                    <button type="button" class="nav-btn" @onclick="NextMonth"><i class="bi bi-chevron-down"></i></button>
                                </div>
                            </div>
                            <div class="calendar-grid">
                                <div class="day-label">Su</div><div class="day-label">Mo</div><div class="day-label">Tu</div><div class="day-label">We</div><div class="day-label">Th</div><div class="day-label">Fr</div><div class="day-label">Sa</div>
                                @for (int i = 0; i < firstDayOffset; i++) { <div class="calendar-day disabled"></div> }
                                @for (int day = 1; day <= daysInMonth; day++)
                                {
                                    var date = new DateTime(currentMonth.Year, currentMonth.Month, day);
                                    var isDisabled = date < DateTime.Today;
                                    var isSelected = selectedDates.Any(d => d.Date == date.Date);
                                    var isToday = date.Date == DateTime.Today;
                                    <div class="calendar-day @(isDisabled ? "disabled" : "") @(isSelected ? "selected" : "") @(isToday ? "today" : "")" @onclick="() => ToggleDate(date)">@day</div>
                                }
                            </div>
                            <div class="calendar-footer">
                                <button type="button" class="footer-btn" @onclick="() => selectedDates.Clear()">Clear All</button>
                                <span style="font-size: 0.75rem; font-weight: 700; color: #64748b;">@selectedDates.Count selected</span>
                            </div>
                        </div>
                    </div>
                    }

                    <!-- RIGHT: SLOT TABLE -->
                    <div class="slot-list-container" style="@(isBulkEdit ? "flex: 1; width: 100%;" : "")">
                        <!-- Unified Horizontal Scroll Container -->
                        <div class="unified-scroll-container">
                            <div class="slot-grid-container" style="@(isBulkEdit ? "min-width: 845px;" : "")">
                                <!-- Header -->
                                <div class="slot-header">
                                    <div>Slot</div>
                                    <div>Start time</div>
                                    <div>End time</div>
                                    <div class="text-center dur-col">Dur</div>
                                    <div>Slot Type</div>
                                    <div class="text-center avgtime-col">Avg Time</div>
                                    <div class="text-center walkin-col">Walkin</div>
                                    <div class="text-center online-col">Online</div>    
                                    <div class="text-center patient-col">Patients</div>
                                    <div class="text-center action-col">Action</div>
                                </div>

                                <!-- Body (Vertical Scroll Only) -->
                                <div class="slot-body-container">
                                    @for (int i = 0; i < tempSlots.Count; i++)
                                    {
                                        int index = i;
                                        var slot = tempSlots[index];
                                        <div class="slot-row">
                                            <div class="mobile-label">SLOT</div>
                                            <div class="slot-num">@(index + 1)</div>

                                            <div class="mobile-label">START TIME</div>
                                            <div class="start-time-col"><input type="time" @bind="slot.StartTime" @bind:after="() => OnTimeChanged(slot, isStartTime: true)" class="compact-input" /></div>

                                            <div class="mobile-label">END TIME</div>
                                            <div class="end-time-col"><input type="time" @bind="slot.EndTime" @bind:after="() => OnTimeChanged(slot, isStartTime: false)" class="compact-input" /></div>

                                            <div class="mobile-label">DURATION</div>
                                            <div class="dur-col"><input type="text" value="@slot.Duration" class="compact-input text-center" readonly /></div>

                                            <div class="mobile-label">SLOT TYPE</div>
                                            <div class="slot-type-col">
                                                <select class="compact-input" @bind="slot.SlotTypeId" @bind:after="() => OnSlotTypeSync(slot)">
                                                    <option value="0">Select Type</option>
                                                    @foreach (var type in slotTypes) { 
                                                        <option value="@type.slot_type_id">@type.name</option> 
                                                    }
                                                </select>
                                            </div>

                                            <div class="mobile-label">AVG TIME</div>
                                            <div class="avgtime-col"><input type="number" @bind="slot.AvgTime" @bind:after="() => OnAvgTimeChanged(slot)" class="compact-input text-center" disabled="@(!IsVisitingSlot(slot))" /></div>
                                            
                                            <div class="mobile-label">WALK-IN</div>
                                            <div class="walkin-col"><input type="number" @bind="slot.Walkin" @bind:after="() => OnWalkinChanged(slot)" class="compact-input text-center" disabled="@(!IsVisitingSlot(slot))" /></div>

                                            <div class="mobile-label">ONLINE</div>
                                            <div class="online-col"><input type="number" @bind="slot.Online" @bind:after="() => OnOnlineChanged(slot)" class="compact-input text-center" disabled="@(!IsVisitingSlot(slot))" /></div>

                                            <div class="mobile-label">PATIENTS</div>
                                            <div class="patient-col"><input type="number" @bind="slot.TotalPatients" class="compact-input text-center" readonly disabled="@(!IsVisitingSlot(slot))" /></div>

                                            <div class="mobile-label">ACTION</div>
                                            <div class="action-col" style="display: flex; justify-content: center; align-items: center; min-height: 44px;">
                                                @if (isBulkEdit || tempSlots.Count > 1)
                                                {
                                                    <button type="button" class="btn-remove-slot" @onclick="() => DeleteSlotFromTempList(index)" title="Remove Slot">
                                                        <i class="bi bi-trash3"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="no-actions-placeholder"></span>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (tempSlots.Count == 0)
                                    {
                                        <div class="empty-slots-msg" style="padding: 2rem; text-align: center; color: #64748b; font-style: italic; grid-column: 1 / -1;">
                                            No slots added. Click "Add Another Slot" to start.
                                        </div>
                                    }
                                    @if (!isBulkEdit)
                                    {
                                        <div class="add-slot-container" style="width: 100%; display: flex; justify-content: center; padding: 1.5rem 0;">
                                            <button type="button" class="btn-add-slot-new" @onclick="AddSlotTab" style="width: auto; padding: 0.75rem 3rem; background: #f0f9ff; color: #026aa7; border: 2px dashed #026aa7; border-radius: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 0.75rem; transition: all 0.2s;">
                                                <i class="bi bi-plus-circle-fill"></i> Add Another Slot
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div style="flex: 1;"></div>
                <button type="button" class="btn-save" style="background: #026aa7;" @onclick="SaveAllSlots">
                    Save
                </button>
            </div>
        </div>
    }
}

<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
    <div class="floating-blob blob-3"></div>
    <div class="pattern-overlay"></div>
</div>

<div style="max-width: 1200px; margin: 0rem auto 0 auto; padding: 0 0.5rem;">
    <h1 style="color: #004b71; font-weight: 800; font-size: 1.75rem; margin-bottom: 0.5rem;">Slot Booking</h1>
</div>

<div class="calendar-top-bar">
    <!-- LEFT CORNER: DATE SELECTION & VIEW TOGGLES -->
    <div class="top-bar-left">
        <div class="calendar-navigation">
            <button class="nav-arrow" @onclick="PrevView"><i class="bi bi-chevron-left"></i></button>
            <h2 class="current-range">@GetViewRangeText()</h2>
            <button class="nav-arrow" @onclick="NextView"><i class="bi bi-chevron-right"></i></button>
        </div>

        <div class="view-toggles">
            <button class="toggle-btn @(viewMode == "DAY" ? "active" : "")" @onclick='() => SetViewMode("DAY")'>DAY</button>
            <button class="toggle-btn @(viewMode == "WEEK" ? "active" : "")" @onclick='() => SetViewMode("WEEK")'>WEEK</button>
        </div>
    </div>

    <!-- RIGHT CORNER: DOCTOR SELECTION & NEW SLOT BUTTON -->
    <div class="top-bar-right">
        <div class="doctor-filter-wrapper" style="position: relative;">
            <i class="bi bi-person-fill" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.9rem;"></i>
            <select class="unified-doctor-select" @onchange="FilterByDoctor" style="padding-left: 30px;">
                <option value="0">All Doctors</option>
                @foreach (var doc in doctors) { <option value="@doc.dcode">@(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</option> }
            </select>
        </div>

        @if (TenantState.HasActionRight("Configuration", "General", "Create")) { <button class="btn-add-unified" @onclick="CreateNew">
            <i class="bi bi-plus-lg"></i>
            <span>New Slot</span>
        </button> }
    </div>
</div>

<div class="calendar-main-container" style="margin-top: 0; padding-top: 0.5rem;">

    <div class="calendar-grid-wrapper @(viewMode.ToLower())">
        @if (viewMode == "WEEK")
        {
            <div class="grid-header">
                @for (int i = 0; i < 7; i++)
                {
                    var date = viewDate.AddDays(i);
                    var isToday = date.Date == DateTime.Today;
                    <div class="header-cell @(isToday ? "today" : "")" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;">
                        <div class="date-header-row">
                            <span class="day-num">@date.Day</span>
                            <span class="day-name">@date.ToString("ddd").ToUpper()</span>
                        </div>
                        @if (selectedDoctorFilter > 0)
                        {
                            var dateOnly = DateOnly.FromDateTime(date);
                            var hasSlots = slots.Any(s => s.dcode == selectedDoctorFilter && 
                                                         (s.slot_date == dateOnly || (s.slot_date == null && s.day_of_week == date.DayOfWeek.ToString().ToUpper())) && 
                                                         !s.isdeleted);
                            @if (hasSlots)
                            {
                                @if (TenantState.HasActionRight("Configuration", "General", "Edit")) { <button class="bulk-edit-header-btn" @onclick="() => BulkEditSlotsForDate(date)" @onclick:stopPropagation="true">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </button> }
                            }
                        }
                    </div>
                }
            </div>
            <div class="grid-body">
                @if (selectedDoctorFilter == 0)
                {
                    // Get all doctors who have slots in this week to create rows
                    var doctorsInWeek = slots
                        .Where(s => {
                            for (int i = 0; i < 7; i++) {
                                var d = viewDate.AddDays(i);
                                var doOnly = DateOnly.FromDateTime(d);
                                if (s.slot_date == doOnly || (s.slot_date == null && s.day_of_week == d.DayOfWeek.ToString().ToUpper())) return true;
                            }
                            return false;
                        })
                        .Select(s => s.dcode)
                        .Distinct()
                        .OrderBy(d => GetDoctorName(d))
                        .ToList();

                    @foreach (var docId in doctorsInWeek)
                    {
                        <div class="week-doctor-divider-row">
                            <i class="bi bi-person-fill"></i>
                            <span>@GetDoctorName(docId)</span>
                        </div>
                        @for (int i = 0; i < 7; i++)
                        {
                            var currentDate = viewDate.AddDays(i);
                            var dateOnly = DateOnly.FromDateTime(currentDate);
                            var docDaySlots = slots
                                .Where(s => s.dcode == docId)
                                .Where(s => s.slot_date == dateOnly || (s.slot_date == null && s.day_of_week == currentDate.DayOfWeek.ToString().ToUpper()))
                                .OrderBy(s => s.slot_start_time)
                                .ToList();

                            <div class="grid-column @(currentDate.Date == DateTime.Today ? "today" : "")">
                                @foreach (var slot in docDaySlots)
                                {
                                    <div class="slot-card" @onclick="() => OpenSlotDetailsModal(slot, currentDate)" title="Click to view slot booking details">
                                        @if (!string.IsNullOrEmpty(GetSlotEmoji(slot.slot_type_id)))
                                        {
                                            <span class="slot-emoji">@GetSlotEmoji(slot.slot_type_id)</span>
                                        }
                                        <div class="slot-card-header">
                                            <span class="slot-title">Slot @(docDaySlots.IndexOf(slot) + 1)</span>
                                            <div class="slot-actions" @onclick:stopPropagation="true">
                                                @if (TenantState.HasActionRight("Configuration", "General", "Edit")) { <button class="v2-action-btn edit" disabled="@IsSlotPast(slot, currentDate)" @onclick="() => EditSlot(slot)" @onclick:stopPropagation="true" title="Edit"><i class="bi bi-pencil-fill"></i></button> }
                                                @if (TenantState.HasActionRight("Configuration", "General", "Delete")) { <button class="v2-action-btn delete" disabled="@IsSlotPast(slot, currentDate)" @onclick="() => DeleteSlot(slot.slot_master_id)" @onclick:stopPropagation="true" title="Delete"><i class="bi bi-trash3-fill"></i></button> }
                                            </div>
                                        </div>
                                        <div class="slot-card-time">
                                            <div class="slot-type-dot" style="background-color: @GetSlotColor(slot.slot_type_id);"></div>
                                            <span>@slot.slot_start_time.ToString("h:mm tt") - @slot.slot_end_time.ToString("h:mm tt")</span> 
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="week-doctor-divider-row">
                        <i class="bi bi-person-fill"></i>
                        <span>@GetDoctorName(selectedDoctorFilter)</span>
                    </div>
                    @for (int i = 0; i < 7; i++)
                    {
                        var currentDate = viewDate.AddDays(i);
                        var dateOnly = DateOnly.FromDateTime(currentDate);
                        var filteredSlots = slots
                            .Where(s => s.dcode == selectedDoctorFilter)
                            .Where(s => s.slot_date == dateOnly || (s.slot_date == null && s.day_of_week == currentDate.DayOfWeek.ToString().ToUpper()))
                            .OrderBy(s => s.slot_start_time)
                            .ToList();

                        <div class="grid-column @(currentDate.Date == DateTime.Today ? "today" : "")">
                            @foreach (var slot in filteredSlots)
                            {
                                <div class="slot-card" @onclick="() => OpenSlotDetailsModal(slot, currentDate)" title="Click to view slot booking details">
                                    @if (!string.IsNullOrEmpty(GetSlotEmoji(slot.slot_type_id)))
                                    {
                                        <span class="slot-emoji">@GetSlotEmoji(slot.slot_type_id)</span>
                                    }
                                    <div class="slot-card-header">
                                        <div class="slot-type-dot" style="background-color: @GetSlotColor(slot.slot_type_id);"></div>
                                        <span class="slot-title">Slot @(filteredSlots.IndexOf(slot) + 1)</span>
                                        <div class="slot-actions" @onclick:stopPropagation="true">
                                            @if (TenantState.HasActionRight("Configuration", "General", "Edit")) { <button class="v2-action-btn edit" disabled="@IsSlotPast(slot, currentDate)" @onclick="() => EditSlot(slot)" @onclick:stopPropagation="true" title="Edit"><i class="bi bi-pencil-fill"></i></button> }
                                            @if (TenantState.HasActionRight("Configuration", "General", "Delete")) { <button class="v2-action-btn delete" disabled="@IsSlotPast(slot, currentDate)" @onclick="() => DeleteSlot(slot.slot_master_id)" @onclick:stopPropagation="true" title="Delete"><i class="bi bi-trash3-fill"></i></button> }
                                        </div>
                                    </div>
                                    <div class="slot-card-time">
                                        <span>@slot.slot_start_time.ToString("h:mm tt") - @slot.slot_end_time.ToString("h:mm tt")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <!-- DAY VIEW -->
            <div class="day-view-container">
                @{
                    var dateOnly = DateOnly.FromDateTime(viewDate);
                    var daySlots = slots
                        .Where(s => (selectedDoctorFilter == 0 || s.dcode == selectedDoctorFilter))
                        .Where(s => s.slot_date == dateOnly || (s.slot_date == null && s.day_of_week == viewDate.DayOfWeek.ToString().ToUpper()))
                        .OrderBy(s => s.slot_start_time)
                        .ToList();
                }
                <div class="day-view-date-card" style="display: flex; align-items: center; gap: 1.5rem;">
                    <div class="date-badge">
                        <span class="month-label">@viewDate.ToString("MMM").ToUpper()</span>
                        <span class="day-label-num">@viewDate.Day</span>
                    </div>
                    <div class="date-details">
                        <h2 class="day-full-name">@viewDate.ToString("dddd")</h2>
                        <p class="full-date-text">@viewDate.ToString("MMMM dd, yyyy")</p>
                    </div>
                    @if (selectedDoctorFilter > 0)
                    {
                        var hasSlots = slots.Any(s => s.dcode == selectedDoctorFilter && 
