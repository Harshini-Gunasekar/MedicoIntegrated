@page "/settings"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Medico_Backend.Model
@using Newtonsoft.Json.Linq
@inject Booking.Services.MasterTenantServices TenantService
@inject Booking.Services.ToastService Toast
@inject IHttpClientFactory HttpClientFactory
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<div class="settings-container">
    <div class="settings-card">
        <div class="settings-header">
            <div class="header-icon">
                <i class="bi bi-gear-fill"></i>
            </div>
            <div>
                <h2 class="settings-title">Report Settings</h2>
                <p class="settings-subtitle">Configure report formats, layouts, margins, and branding parameters.</p>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-state">
                <span class="spinner-border" role="status"></span>
                <span>Loading report settings...</span>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mb-4">@errorMessage</div>
            }

            <div class="settings-grid-layout">
                <!-- SECTION 1: Branding & Images -->
                <div class="settings-form-section">
                    <h3 class="section-title"><i class="bi bi-image"></i> Branding & Images</h3>
                    
                    <!-- Main Logo Upload -->
                    <div class="settings-subsection">
                        <label class="form-label">Main Logo</label>
                        <div class="file-uploader-container">
                            <div class="file-uploader-dropzone">
                                @if (imagePreviews.TryGetValue("logo", out var logoSrc))
                                {
                                    <img src="@logoSrc" class="file-uploader-preview" alt="Logo Preview" />
                                    <div class="file-uploader-overlay">
                                        <i class="bi bi-arrow-repeat"></i>
                                        <span>Change Logo</span>
                                    </div>
                                    <button type="button" class="btn-remove-image-overlay" @onclick:stopPropagation="true" @onclick="@(() => RemoveImage("logo"))" title="Remove Logo">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                }
                                else
                                {
                                    <i class="bi bi-cloud-arrow-up"></i>
                                    <span>Upload Logo</span>
                                }
                                <InputFile OnChange="@(e => OnFileSelected(e, "logo"))" accept=".jpg,.jpeg,.png,.webp" class="file-input-hidden" />
                            </div>
                        </div>
                    </div>

                    <!-- Letterhead Upload -->
                    <div class="settings-subsection">
                        <div class="form-checkbox-row">
                            <input type="checkbox" class="custom-checkbox" @bind="model.isletterhead" id="chkLetterhead" />
                            <div class="checkbox-label-group">
                                <label class="checkbox-title" for="chkLetterhead">Enable Letterhead Image</label>
                                <span class="checkbox-description">Display a custom header image at the top of report pages.</span>
                            </div>
                        </div>
                        @if (model.isletterhead)
                        {
                            <div class="conditional-fields animation-fade mt-3">
                                <label class="form-label">Letterhead Image</label>
                                <div class="file-uploader-container">
                                    <div class="file-uploader-dropzone" style="height: 120px;">
                                        @if (imagePreviews.TryGetValue("letterhead", out var lhSrc))
                                        {
                                            <img src="@lhSrc" class="file-uploader-preview" alt="Letterhead Preview" />
                                            <div class="file-uploader-overlay">
                                                <i class="bi bi-arrow-repeat"></i>
                                                <span>Change Letterhead</span>
                                            </div>
                                            <button type="button" class="btn-remove-image-overlay" @onclick:stopPropagation="true" @onclick="@(() => RemoveImage("letterhead"))" title="Remove Letterhead">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <i class="bi bi-cloud-arrow-up"></i>
                                            <span>Upload Letterhead</span>
                                        }
                                        <InputFile OnChange="@(e => OnFileSelected(e, "letterhead"))" accept=".jpg,.jpeg,.png,.webp" class="file-input-hidden" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Bottom Banner Upload -->
                    <div class="settings-subsection">
                        <div class="form-checkbox-row">
                            <input type="checkbox" class="custom-checkbox" @bind="model.isletterbottom" id="chkLetterBottom" />
                            <div class="checkbox-label-group">
                                <label class="checkbox-title" for="chkLetterBottom">Enable Bottom Banner</label>
                                <span class="checkbox-description">Display a bottom layout banner/footer image.</span>
                            </div>
                        </div>
                        @if (model.isletterbottom)
                        {
                            <div class="conditional-fields animation-fade mt-3">
                                <label class="form-label">Bottom Banner Image</label>
                                <div class="file-uploader-container">
                                    <div class="file-uploader-dropzone" style="height: 120px;">
                                        @if (imagePreviews.TryGetValue("bottom", out var bottomSrc))
                                        {
                                            <img src="@bottomSrc" class="file-uploader-preview" alt="Bottom Banner Preview" />
                                            <div class="file-uploader-overlay">
                                                <i class="bi bi-arrow-repeat"></i>
                                                <span>Change Bottom Banner</span>
                                            </div>
                                            <button type="button" class="btn-remove-image-overlay" @onclick:stopPropagation="true" @onclick="@(() => RemoveImage("bottom"))" title="Remove Bottom Banner">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <i class="bi bi-cloud-arrow-up"></i>
                                            <span>Upload Bottom Banner</span>
                                        }
                                        <InputFile OnChange="@(e => OnFileSelected(e, "bottom"))" accept=".jpg,.jpeg,.png,.webp" class="file-input-hidden" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Watermark Upload -->
                    <div class="settings-subsection">
                        <div class="form-checkbox-row">
                            <input type="checkbox" class="custom-checkbox" @bind="model.iswatermark" id="chkWatermark" />
                            <div class="checkbox-label-group">
                                <label class="checkbox-title" for="chkWatermark">Enable Watermark</label>
                                <span class="checkbox-description">Render a semi-transparent watermark in the background.</span>
                            </div>
                        </div>
                        @if (model.iswatermark)
                        {
                            <div class="conditional-fields animation-fade mt-3">
                                <label class="form-label">Watermark Image</label>
                                <div class="file-uploader-container">
                                    <div class="file-uploader-dropzone">
                                        @if (imagePreviews.TryGetValue("watermark", out var wmSrc))
                                        {
                                            <img src="@wmSrc" class="file-uploader-preview" style="opacity: 0.4;" alt="Watermark Preview" />
                                            <div class="file-uploader-overlay">
                                                <i class="bi bi-arrow-repeat"></i>
                                                <span>Change Watermark</span>
                                            </div>
                                            <button type="button" class="btn-remove-image-overlay" @onclick:stopPropagation="true" @onclick="@(() => RemoveImage("watermark"))" title="Remove Watermark">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <i class="bi bi-cloud-arrow-up"></i>
                                            <span>Upload Watermark</span>
                                        }
                                        <InputFile OnChange="@(e => OnFileSelected(e, "watermark"))" accept=".jpg,.jpeg,.png,.webp" class="file-input-hidden" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Signature Upload -->
                    <div class="settings-subsection">
                        <div class="form-checkbox-row">
                            <input type="checkbox" class="custom-checkbox" @bind="model.issignature" id="chkSignature" />
                            <div class="checkbox-label-group">
                                <label class="checkbox-title" for="chkSignature">Enable Authorized Signature</label>
                                <span class="checkbox-description">Embed scanned doctor or authority signature on final reports.</span>
                            </div>
                        </div>
                        @if (model.issignature)
                        {
                            <div class="conditional-fields animation-fade mt-3">
                                <div class="form-group mb-3">
                                    <label class="form-label">Signature Label / Text</label>
                                    <input type="text" class="form-control custom-input" @bind="model.signature_label" placeholder="e.g. Dr. John Doe (Pathologist)" />
                                </div>
                                <label class="form-label">Signature Image</label>
                                <div class="file-uploader-container">
                                    <div class="file-uploader-dropzone">
                                        @if (imagePreviews.TryGetValue("signature", out var sigSrc))
                                        {
                                            <img src="@sigSrc" class="file-uploader-preview" alt="Signature Preview" />
                                            <div class="file-uploader-overlay">
                                                <i class="bi bi-arrow-repeat"></i>
                                                <span>Change Signature</span>
                                            </div>
                                            <button type="button" class="btn-remove-image-overlay" @onclick:stopPropagation="true" @onclick="@(() => RemoveImage("signature"))" title="Remove Signature">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <i class="bi bi-cloud-arrow-up"></i>
                                            <span>Upload Signature</span>
                                        }
                                        <InputFile OnChange="@(e => OnFileSelected(e, "signature"))" accept=".jpg,.jpeg,.png,.webp" class="file-input-hidden" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- SECTION 2: Report Layout & Typography -->
                <div class="settings-form-section">
                    <h3 class="section-title"><i class="bi bi-file-earmark-text"></i> Layout & Typography</h3>
                    
                    <!-- Typography Group -->
                    <div class="settings-subsection">
                        <h4 class="sub-section-title">Typography & Headers</h4>
                        <div class="grid-2-cols">
                            <div class="form-group">
                                <label class="form-label">Report Title</label>
                                <input type="text" class="form-control custom-input" @bind="model.report_title" placeholder="e.g. Laboratory Report" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Font Family</label>
                                <select class="form-control custom-input" @bind="model.report_font">
                                    <option value="Arial">Arial</option>
                                    <option value="Times New Roman">Times New Roman</option>
                                    <option value="Segoe UI">Segoe UI</option>
                                    <option value="Calibri">Calibri</option>
                                    <option value="Courier New">Courier New</option>
                                </select>
                            </div>
                        </div>
                        <div class="grid-2-cols mt-3">
                            <div class="form-group">
                                <label class="form-label">Font Size (px)</label>
                                <input type="number" class="form-control custom-input" @bind="model.report_font_size" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Primary Color</label>
                                <div class="color-picker-wrapper">
                                    <input type="color" class="color-picker" @bind="model.report_color" />
                                    <input type="text" class="form-control custom-input style-text" @bind="model.report_color" placeholder="#000000" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Paper Config -->
                    <div class="settings-subsection">
                        <h4 class="sub-section-title">Paper Settings</h4>
                        <div class="grid-2-cols">
                            <div class="form-group">
                                <label class="form-label">Paper Size</label>
                                <select class="form-control custom-input" @bind="model.paper_size">
                                    <option value="A4">A4</option>
                                    <option value="Letter">Letter</option>
                                    <option value="Legal">Legal</option>
                                    <option value="A3">A3</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Orientation</label>
                                <select class="form-control custom-input" @bind="model.orientation">
                                    <option value="Portrait">Portrait</option>
                                    <option value="Landscape">Landscape</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Margins Config -->
                    <div class="settings-subsection">
                        <h4 class="sub-section-title">Margins (mm)</h4>
                        <div class="grid-4-cols">
                            <div class="form-group">
                                <label class="form-label">Top</label>
                                <input type="number" class="form-control custom-input" @bind="model.margin_top" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Bottom</label>
                                <input type="number" class="form-control custom-input" @bind="model.margin_bottom" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Left</label>
                                <input type="number" class="form-control custom-input" @bind="model.margin_left" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Right</label>
                                <input type="number" class="form-control custom-input" @bind="model.margin_right" />
                            </div>
                        </div>
                    </div>

                    <!-- Barcode / QR -->
                    <div class="settings-subsection">
                        <h4 class="sub-section-title">Verification & Tracking</h4>
                        <div class="grid-2-cols">
                            <div class="form-checkbox-card">
                                <input type="checkbox" class="custom-checkbox" @bind="model.isbarcode" id="chkBarcode" />
                                <div class="checkbox-label-group">
                                    <label class="checkbox-title" for="chkBarcode">Include Barcode</label>
                                    <span class="checkbox-description">Render sample barcode.</span>
                                </div>
                            </div>
                            <div class="form-checkbox-card">
                                <input type="checkbox" class="custom-checkbox" @bind="model.isqrcode" id="chkQrcode" />
                                <div class="checkbox-label-group">
                                    <label class="checkbox-title" for="chkQrcode">Include QR Code</label>
                                    <span class="checkbox-description">Render verification link.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Date & Time & Branch -->
                    <div class="settings-subsection">
                        <h4 class="sub-section-title">Scope & Additional Data</h4>
                        <div class="form-checkbox-row mb-3">
                            <input type="checkbox" class="custom-checkbox" @bind="model.all_branch" id="chkAllBranch" />
                            <div class="checkbox-label-group">
                                <label class="checkbox-title" for="chkAllBranch">Apply to All Branches</label>
                                <span class="checkbox-description">Propagate settings to all subordinate locations.</span>
                            </div>
                        </div>

                        <div class="form-checkbox-row">
                            <input type="checkbox" class="custom-checkbox" @bind="showPrintedDateTime" id="chkPrintedDateTime" />
                            <div class="checkbox-label-group">
                                <label class="checkbox-title" for="chkPrintedDateTime">Show Printed Date & Time</label>
                                <span class="checkbox-description">Include date of print in footnotes.</span>
                            </div>
                        </div>

                        @if (showPrintedDateTime)
                        {
                            <div class="conditional-fields animation-fade mt-3">
                                <div class="form-group mb-0">
                                    <label class="form-label">Format Specifier</label>
                                    <input type="text" class="form-control custom-input" @bind="model.datetime_format" placeholder="dd/MM/yyyy HH:mm" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Form Controls -->
            <div class="form-actions-row">
                @if (isEditMode)
                {
                    <button class="btn btn-danger-custom me-auto" @onclick="HandleDeleteSettings" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-trash3-fill"></i> Delete Settings
                    </button>
                }
                <button class="btn btn-save-custom" @onclick="HandleSaveSettings" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check-circle-fill"></i> Save Configuration
                </button>
            </div>
        }
    </div>
</div>

@code {
    private TenantReportMethodModel model = new TenantReportMethodModel();
    private Dictionary<string, string> imagePreviews = new Dictionary<string, string>();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isEditMode = false;
    private string? errorMessage;
    private string tenantCode = "TEN1011";

    private bool showPrintedDateTime
    {
        get => model.show_printed_datetime ?? false;
        set => model.show_printed_datetime = value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadTenantCode();
            await LoadTenantReportSettings();
        }
    }

    private async Task LoadTenantCode()
    {
        try
        {
            var tcResult = await _sessionStorage.GetAsync<string>("tenant_code");
            if (tcResult.Success && !string.IsNullOrEmpty(tcResult.Value))
            {
                tenantCode = tcResult.Value;
            }
        }
        catch
        {
            // fallback
        }
    }

    private async Task LoadTenantReportSettings()
    {
        isLoading = true;
        errorMessage = null;
        imagePreviews.Clear();
        StateHasChanged();

        try
        {
            var settingsModel = await TenantService.GetTenantReportMethodAsync(tenantCode);
            if (settingsModel != null && settingsModel.id > 0)
            {
                model = settingsModel;
                isEditMode = true;

                // Load image previews
                await LoadImagePreview(model.logo_url, "logo");
                await LoadImagePreview(model.letterhead_url, "letterhead");
                await LoadImagePreview(model.bottom_url, "bottom");
                await LoadImagePreview(model.watermark_url, "watermark");
                await LoadImagePreview(model.signature_url, "signature");
            }
            else
            {
                InitializeNewModel();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load settings: {ex.Message}";
            InitializeNewModel();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void InitializeNewModel()
    {
        model = new TenantReportMethodModel
        {
            tenant_code = tenantCode,
            isletterhead = false,
            isletterbottom = false,
            all_branch = true,
            iswatermark = false,
            report_font = "Arial",
            report_font_size = 12,
            report_color = "#000000",
            paper_size = "A4",
            orientation = "Portrait",
            margin_top = 10,
            margin_bottom = 10,
            margin_left = 10,
            margin_right = 10,
            issignature = false,
            isheadertext = false,
            isfootertext = false,
            isbarcode = false,
            isqrcode = false,
            show_printed_datetime = true,
            datetime_format = "dd/MM/yyyy HH:mm"
        };
        isEditMode = false;
        imagePreviews.Clear();
    }

    private async Task LoadImagePreview(string? key, string fieldName)
    {
        if (string.IsNullOrEmpty(key)) return;
        try
        {
            var client = HttpClientFactory.CreateClient("DoctorApi");
            if (client.DefaultRequestHeaders.Contains("tenant_code"))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
            }
            client.DefaultRequestHeaders.Add("tenant_code", tenantCode);

            var response = await client.GetAsync($"api/files/download?key={Uri.EscapeDataString(key)}");
            if (response.IsSuccessStatusCode)
            {
                var jsonStr = await response.Content.ReadAsStringAsync();
                var downloadRes = Newtonsoft.Json.JsonConvert.DeserializeObject<FileDownloadResponse>(jsonStr);
                if (downloadRes != null && !string.IsNullOrEmpty(downloadRes.base64))
                {
                    imagePreviews[fieldName] = $"data:image/png;base64,{downloadRes.base64}";
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error downloading preview for {fieldName}: {ex.Message}");
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e, string fieldName)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                // 1. Immediately read file locally and update the preview for instantaneous real-time rendering!
                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5); // 5MB limit
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();
                imagePreviews[fieldName] = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
                StateHasChanged();

                // 2. Upload file in the background
                var client = HttpClientFactory.CreateClient("DoctorApi");
                if (client.DefaultRequestHeaders.Contains("tenant_code"))
                {
                    client.DefaultRequestHeaders.Remove("tenant_code");
                }
                client.DefaultRequestHeaders.Add("tenant_code", tenantCode);

                using var content = new MultipartFormDataContent();
                var fileContent = new ByteArrayContent(bytes);
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                content.Add(fileContent, "file", file.Name);

                var entityId = model.id > 0 ? model.id : 1;
                var uploadUrl = $"api/files/upload?prefix={tenantCode}&entityType=tenant-settings&entityId={entityId}";
                
                var response = await client.PostAsync(uploadUrl, content);
                if (response.IsSuccessStatusCode)
                {
                    var responseStr = await response.Content.ReadAsStringAsync();
                    var json = JObject.Parse(responseStr);
                    var key = json["key"]?.ToString();
                    if (!string.IsNullOrEmpty(key))
                    {
                        if (fieldName == "logo") model.logo_url = key;
                        else if (fieldName == "letterhead") model.letterhead_url = key;
                        else if (fieldName == "bottom") model.bottom_url = key;
                        else if (fieldName == "watermark") model.watermark_url = key;
                        else if (fieldName == "signature") model.signature_url = key;

                        Toast.ShowSuccess($"{fieldName} uploaded successfully!");
                    }
                }
                else
                {
                    var err = await response.Content.ReadAsStringAsync();
                    Toast.ShowError($"Upload failed: {err}");
                }
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error uploading file: {ex.Message}");
        }
    }

    private void RemoveImage(string fieldName)
    {
        if (fieldName == "logo") model.logo_url = null;
        else if (fieldName == "letterhead") model.letterhead_url = null;
        else if (fieldName == "bottom") model.bottom_url = null;
        else if (fieldName == "watermark") model.watermark_url = null;
        else if (fieldName == "signature") model.signature_url = null;

        imagePreviews.Remove(fieldName);
        StateHasChanged();
    }

    private async Task HandleSaveSettings()
    {
        isSaving = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            model.tenant_code = tenantCode;
            model.updated_at = DateTime.UtcNow;

            bool success;
            if (isEditMode)
            {
                success = await TenantService.UpdateTenantReportMethodAsync(model, tenantCode);
            }
            else
            {
                model.created_at = DateTime.UtcNow;
                success = await TenantService.InsertTenantReportMethodAsync(model, tenantCode);
            }

            if (success)
            {
                Toast.ShowSuccess("Settings saved successfully!");
                await LoadTenantReportSettings();
            }
            else
            {
                errorMessage = "Failed to save settings to the server.";
                Toast.ShowError("Failed to save settings.");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            Toast.ShowError("An error occurred while saving.");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task HandleDeleteSettings()
    {
        if (model.id <= 0) return;

        isSaving = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            bool success = await TenantService.DeleteTenantReportMethodAsync(model.id, tenantCode);

            if (success)
            {
                Toast.ShowSuccess("Settings reset/deleted successfully.");
                InitializeNewModel();
                StateHasChanged();
            }
            else
            {
                errorMessage = "Failed to delete settings from the server.";
                Toast.ShowError("Failed to delete settings.");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            Toast.ShowError("An error occurred during deletion.");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private class FileDownloadResponse
    {
        public string? fileName { get; set; }
        public string? base64 { get; set; }
    }
}
