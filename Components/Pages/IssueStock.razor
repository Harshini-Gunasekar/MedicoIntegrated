                                    <td style="text-align: right !important; padding: 6px 8px !important; color: #4f46e5 !important; font-size: 0.88rem !important; border-right: 1px solid #cbd5e1 !important;">@activeSlipItems.Sum(x => x.transferqty).ToString("N0")</td>
                                    <td style="border-right: 1px solid #cbd5e1 !important;"></td>
