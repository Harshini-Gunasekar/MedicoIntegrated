        {
            detail.itemcode = 0;
            detail.availableqty = 0;
            detail.unitcost = 0;
            detail.stockvalue = 0;
        }
        StateHasChanged();
    }

    private void SelectItemFromDropdown(stock_transfer_detail detail, item_master item, int searchKey)
    {
        detail.itemcode = item.itemcode;
        detail.uomcode = item.uomcode > 0 ? item.uomcode : (UomList.FirstOrDefault()?.ucode ?? 1);
        detail.tenantcode = DefaultTenant;
        ItemSearchTexts[searchKey] = item.itemname ?? "";

        var batches = GetBatchesForItem(item.itemcode, CurrentTransfer.master.fromwarehousecode);
        if (batches.Any())
        {
            // FIFO: First purchased / oldest batch with positive closing stock
            var selectedStock = batches.FirstOrDefault(b => b.closingstock > 0) ?? batches.First();
            detail.batchno = selectedStock.batchno;
            detail.manufacturingdate = selectedStock.manufacturingdate;
            detail.expirydate = selectedStock.expirydate;
            detail.availableqty = selectedStock.closingstock;
            detail.unitcost = selectedStock.unitcost > 0 ? selectedStock.unitcost : (item.purchaserate > 0 ? item.purchaserate : 0);
        }
        else
        {
            detail.batchno = "";
            detail.manufacturingdate = null;
            detail.expirydate = null;
            detail.availableqty = GetAvailableStockForItem(item.itemcode, CurrentTransfer.master.fromwarehousecode);
            detail.unitcost = item.purchaserate > 0 ? item.purchaserate : 0;
        }

        detail.requestedqty = 0;
        detail.approvedqty = 0;
        detail.transferqty = 0;
        detail.stockvalue = 0;

        ActiveItemSearchRow = null;
        StateHasChanged();
    }

    private void OnReqQtyChanged(stock_transfer_detail detail)
    {
        if (detail.approvedqty <= 0 || detail.approvedqty == detail.requestedqty)
        {
            detail.approvedqty = detail.requestedqty;
        }
        if (detail.transferqty <= 0)
        {
            detail.transferqty = detail.approvedqty > 0 ? detail.approvedqty : detail.requestedqty;
        }
        CalculateRowStockValue(detail);
        StateHasChanged();
    }

    private void OnApprQtyChanged(stock_transfer_detail detail)
    {
        if (detail.transferqty <= 0 || detail.transferqty == detail.approvedqty)
        {
            detail.transferqty = detail.approvedqty;
        }
        CalculateRowStockValue(detail);
        StateHasChanged();
    }

    private async Task HandleIssueQtyKeyDown(KeyboardEventArgs e, stock_transfer_detail detail, int index)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            CalculateRowStockValue(detail);
            int nextIndex = index + 1;
            if (nextIndex >= CurrentTransfer.details.Count)
            {
                AddDetailRow();
            }
            StateHasChanged();
            await Task.Yield();
            try
            {
                await JS.InvokeVoidAsync("eval", $"setTimeout(function() {{ var el = document.getElementById('item-input-{nextIndex}'); if (el) {{ el.focus(); }} }}, 60);");
            }
            catch { }
        }
    }

    private void OnBatchSelectChanged(stock_transfer_detail detail, string? selectedBatch)
    {
        detail.batchno = selectedBatch ?? "";
        if (string.IsNullOrWhiteSpace(detail.batchno))
        {
            detail.availableqty = GetAvailableStockForItem(detail.itemcode, CurrentTransfer.master.fromwarehousecode);
            return;
        }

        var batches = GetBatchesForItem(detail.itemcode, CurrentTransfer.master.fromwarehousecode);
        var stock = batches.FirstOrDefault(b => string.Equals(b.batchno, detail.batchno, StringComparison.OrdinalIgnoreCase));
        if (stock != null)
        {
            detail.expirydate = stock.expirydate;
            detail.manufacturingdate = stock.manufacturingdate;
            detail.availableqty = stock.closingstock;
            if (stock.unitcost > 0) detail.unitcost = stock.unitcost;
            detail.stockvalue = detail.transferqty * detail.unitcost;
        }
        StateHasChanged();
    }

    private async Task OnSearchBlur()
    {
        await Task.Delay(250);
        ActiveItemSearchRow = null;
        StateHasChanged();
    }

    private async Task<bool> SendActionRequest(string endpoint, stock_transfer_action_request payload)
    {
        try
        {
            var client = CreateClient();
            var resp = await client.PostAsJsonAsync(endpoint, payload);
            if (resp.IsSuccessStatusCode) return true;
        }
        catch { }

        try
        {
            using var directClient = new HttpClient();
            if (!string.IsNullOrEmpty(DefaultTenant))
            {
                directClient.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
                directClient.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
            }
            string url = $"http://medicoapi.iscansoft.com/{endpoint.TrimStart('/')}";
            if (!string.IsNullOrEmpty(DefaultTenant))
            {
                url += (url.Contains("?") ? "&" : "?") + $"tenantcode={DefaultTenant}";
            }
            var resp = await directClient.PostAsJsonAsync(url, payload);
            if (resp.IsSuccessStatusCode) return true;
        }
        catch { }

        return false;
    }

    private async Task<(bool success, long transfercode, string message)> SendInsertTransferRequest(stock_transfer_request payload)
    {
        try
        {
            var client = CreateClient();
            var resp = await client.PostAsJsonAsync("api/ItemMaster/insertstocktransfer", payload);
            var content = await resp.Content.ReadAsStringAsync();
            if (resp.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(content);
                long newCode = 0;
                if (doc.RootElement.TryGetProperty("transfercode", out var codeProp))
                {
                    newCode = codeProp.GetInt64();
                }
                else if (doc.RootElement.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == JsonValueKind.Object && dataProp.TryGetProperty("transfercode", out var dataCodeProp))
                {
                    newCode = dataCodeProp.GetInt64();
                }
                return (true, newCode, "");
            }
            return (false, 0, content);
        }
        catch { }

        try
        {
            using var directClient = new HttpClient();
            if (!string.IsNullOrEmpty(DefaultTenant))
            {
                directClient.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
                directClient.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
            }
            string url = $"http://medicoapi.iscansoft.com/api/ItemMaster/insertstocktransfer";
            if (!string.IsNullOrEmpty(DefaultTenant))
            {
                url += $"?tenantcode={DefaultTenant}";
            }
            var resp = await directClient.PostAsJsonAsync(url, payload);
            var content = await resp.Content.ReadAsStringAsync();
            if (resp.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(content);
                long newCode = 0;
                if (doc.RootElement.TryGetProperty("transfercode", out var codeProp))
                {
                    newCode = codeProp.GetInt64();
                }
                else if (doc.RootElement.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == JsonValueKind.Object && dataProp.TryGetProperty("transfercode", out var dataCodeProp))
                {
                    newCode = dataCodeProp.GetInt64();
                }
                return (true, newCode, "");
            }
            return (false, 0, content);
        }
        catch (Exception ex)
        {
            return (false, 0, ex.Message);
        }
    }

    private async Task SaveAndPreviewTransfer()
    {
        if (!ValidateTransfer()) return;

        IsSaving = true;
        try
        {
            CurrentTransfer.master.status = "DRAFT";
            CurrentTransfer.master.tenantcode = DefaultTenant;
            var validItems = CurrentTransfer.details.Where(d => d.itemcode > 0 && d.transferqty > 0).ToList();
            var payload = new stock_transfer_request
            {
                master = CurrentTransfer.master,
                details = validItems
            };

            var insertRes = await SendInsertTransferRequest(payload);
            if (insertRes.success)
            {
                if (insertRes.transfercode > 0)
                {
                    CurrentTransfer.master.transfercode = insertRes.transfercode;
                    foreach (var d in validItems)
                    {
                        d.transfercode = insertRes.transfercode;
                    }
                }
                ToastService.ShowSuccess($"Transfer {FormatTransferNo(CurrentTransfer.master.transferno)} saved successfully!");
            }
            else
            {
                ToastService.ShowWarning($"Transfer saved locally. {insertRes.message}");
            }

            SaveToLocalLists(CurrentTransfer.master, validItems);
            SelectedSlipTransfer = CurrentTransfer.master;
            ShowModal = false;
            ShowSlipModal = true;
            await LoadTransfers();
        }
        finally
        {
            IsSaving = false;
        }
    }

    private bool ValidateTransfer()
    {
        if (CurrentTransfer.master.fromwarehousecode == null || CurrentTransfer.master.fromwarehousecode == 0)
        {
            ToastService.ShowWarning("Please select the issuing From Warehouse.");
            return false;
        }
        if (CurrentTransfer.master.towarehousecode == null || CurrentTransfer.master.towarehousecode == 0)
        {
            ToastService.ShowWarning("Please select the destination To Warehouse.");
            return false;
        }
        if (CurrentTransfer.master.fromwarehousecode == CurrentTransfer.master.towarehousecode)
        {
            ToastService.ShowWarning("Source and Destination warehouses cannot be the same.");
            return false;
        }

        var validItems = CurrentTransfer.details.Where(d => d.itemcode > 0 && d.transferqty > 0).ToList();
        if (!validItems.Any())
        {
            ToastService.ShowWarning("Please add at least one valid item with Issue Quantity.");
            return false;
        }

        return true;
    }

    private void SaveToLocalLists(stock_transfer_master header, List<stock_transfer_detail> details)
    {
        var existingIdx = TransferList.FindIndex(t => t.transfercode == header.transfercode);
        if (existingIdx >= 0)
        {
            TransferList[existingIdx] = header;
        }
        else
        {
            TransferList.Insert(0, header);
        }
        TransferDetailsMap[header.transfercode] = new List<stock_transfer_detail>(details);
    }

    private void EditDraft(stock_transfer_master header)
    {
        IsEdit = true;
        CurrentTransfer.master = header;
        CurrentTransfer.details = TransferDetailsMap.GetValueOrDefault(header.transfercode, new List<stock_transfer_detail>());
        if (!CurrentTransfer.details.Any())
        {
            AddDetailRow();
        }
        ItemSearchTexts.Clear();
        foreach (var d in CurrentTransfer.details)
        {
            ItemSearchTexts[d.GetHashCode()] = GetItemName(d.itemcode);
        }
        selectedIndentCode = header.indentcode ?? 0;
        ShowModal = true;
    }

    private bool ShowDispatchConfirm = false;
    private stock_transfer_master? TransferToDispatch = null;

    private string FormatTransferNo(string? no)
    {
        if (string.IsNullOrWhiteSpace(no)) return "";
        return no.Trim().TrimStart('#');
    }

    private void PromptDispatch(stock_transfer_master header)
    {
        TransferToDispatch = header;
        ShowDispatchConfirm = true;
        StateHasChanged();
    }

    private async Task PerformDispatchConfirmed()
    {
        ShowDispatchConfirm = false;
        if (TransferToDispatch != null)
        {
            await ExecuteDispatchTransfer(TransferToDispatch);
            TransferToDispatch = null;
        }
    }

    private async Task ExecuteDispatchTransfer(stock_transfer_master header)
    {
        if (header == null) return;

        header.status = "IN_TRANSIT";

        // Deduct stock in StockList for fromwarehousecode
        var details = GetTransferSlipDetails(header);
        foreach (var item in details.Where(d => d.itemcode > 0 && d.transferqty > 0))
        {
            var matchStock = StockList.FirstOrDefault(s => s.itemcode == item.itemcode && s.warehousecode == header.fromwarehousecode && (string.IsNullOrEmpty(item.batchno) || string.Equals(s.batchno, item.batchno, StringComparison.OrdinalIgnoreCase)));
            if (matchStock != null)
            {
                matchStock.closingstock = Math.Max(0, matchStock.closingstock - item.transferqty);
            }
            else
            {
                var anyStoreStock = StockList.FirstOrDefault(s => s.itemcode == item.itemcode && s.warehousecode == header.fromwarehousecode);
                if (anyStoreStock != null)
                {
                    anyStoreStock.closingstock = Math.Max(0, anyStoreStock.closingstock - item.transferqty);
                }
            }
        }

        // Try send dispatch API request
        try
        {
            await SendActionRequest("api/ItemMaster/dispatchstocktransfer", new stock_transfer_action_request
            {
                transfercode = header.transfercode,
                usercode = 101,
                remarks = "Dispatched from store"
            });
        }
        catch { }

        // Update in TransferList
        var inList = TransferList.FirstOrDefault(t => t.transfercode == header.transfercode);
        if (inList != null)
        {
            inList.status = "IN_TRANSIT";
        }

        var storeName = GetStoreName(header.fromwarehousecode);
        var trfNo = FormatTransferNo(header.transferno);
        ToastService.ShowSuccess($"Transfer #{trfNo} Dispatched successfully! Stock deducted from {storeName}.");

        StateHasChanged();
    }

    private void ViewTransferSlip(stock_transfer_master header)
    {
        if (header == null) return;
        SelectedSlipTransfer = header;

        if (header.details != null && header.details.Any() && !TransferDetailsMap.ContainsKey(header.transfercode))
        {
            TransferDetailsMap[header.transfercode] = header.details;
        }

        ShowSlipModal = true;
        StateHasChanged();
    }

    private List<stock_transfer_detail> GetTransferSlipDetails(stock_transfer_master? header)
    {
        if (header == null) return new();
        if (TransferDetailsMap.TryGetValue(header.transfercode, out var mapList) && mapList != null && mapList.Any())
        {
            return mapList;
        }
        if (header.details != null && header.details.Any())
        {
            return header.details;
        }
        return new();
    }

    private async Task PrintSlip()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private string GetStoreName(long? warehousecode)
    {
        if (!warehousecode.HasValue || warehousecode == 0) return "Not Specified";
        var w = WarehouseList.FirstOrDefault(x => x.warehousecode == warehousecode);
        return w?.warehousename ?? $"Store #{warehousecode}";
    }

    private string GetItemName(long itemcode)
    {
        var itm = ItemList.FirstOrDefault(x => x.itemcode == itemcode);
        return itm?.itemname ?? (itemcode > 0 ? $"Item #{itemcode}" : "");
    }

    private int GetItemCount(long transfercode)
    {
        if (TransferDetailsMap.TryGetValue(transfercode, out var list) && list.Any()) return list.Count;
        var trf = TransferList.FirstOrDefault(t => t.transfercode == transfercode);
        return trf?.details?.Count ?? 0;
    }

    private decimal GetTransferTotalQty(long transfercode)
    {
        if (TransferDetailsMap.TryGetValue(transfercode, out var list) && list.Any()) return list.Sum(d => d.transferqty);
        var trf = TransferList.FirstOrDefault(t => t.transfercode == transfercode);
        return trf?.details?.Sum(d => d.transferqty) ?? 0;
    }

    private decimal GetTransferTotalValue(long transfercode)
    {
        if (TransferDetailsMap.TryGetValue(transfercode, out var list) && list.Any()) return list.Sum(d => d.stockvalue);
        var trf = TransferList.FirstOrDefault(t => t.transfercode == transfercode);
        return trf?.details?.Sum(d => d.stockvalue) ?? 0;
    }

