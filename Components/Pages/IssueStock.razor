    private decimal GetAvailableStockForItem(long itemcode, long? warehousecode)
    {
        if (itemcode <= 0) return 0;
        
        var matches = StockList
            .Where(s => s.itemcode == itemcode 
                     && !s.deleted
                     && (string.IsNullOrEmpty(DefaultTenant) || string.IsNullOrEmpty(s.tenantcode) || string.Equals(s.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase)));

        if (warehousecode.HasValue && warehousecode.Value > 0)
        {
            var storeMatches = matches.Where(s => s.warehousecode == warehousecode.Value).ToList();
            if (storeMatches.Any())
            {
                return storeMatches.Sum(s => s.closingstock);
            }
        }

        return matches.Sum(s => s.closingstock);
    }

    private List<stock_master> GetBatchesForItem(long itemcode, long? warehousecode)
    {
        if (itemcode <= 0) return new();

        var matches = StockList
            .Where(s => s.itemcode == itemcode 
                     && !string.IsNullOrWhiteSpace(s.batchno)
                     && !s.deleted
                     && (string.IsNullOrEmpty(DefaultTenant) || string.IsNullOrEmpty(s.tenantcode) || string.Equals(s.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase)))
            .ToList();

        if (warehousecode.HasValue && warehousecode.Value > 0)
        {
            var storeMatches = matches.Where(s => s.warehousecode == warehousecode.Value).ToList();
            if (storeMatches.Any())
            {
                return storeMatches
                    .OrderByDescending(s => s.closingstock > 0)
                    .ThenByDescending(s => s.closingstock)
                    .ThenBy(s => s.expirydate)
                    .GroupBy(s => s.batchno)
                    .Select(g => g.First())
                    .ToList();
            }
        }

        return matches
            .OrderByDescending(s => s.closingstock > 0)
            .ThenByDescending(s => s.closingstock)
            .ThenBy(s => s.expirydate)
            .GroupBy(s => s.batchno)
            .Select(g => g.First())
            .ToList();
    }

