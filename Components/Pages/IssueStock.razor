        try
        {
            CurrentTransfer.master.status = "DRAFT";
            CurrentTransfer.master.tenantcode = DefaultTenant;
            var validItems = CurrentTransfer.details.Where(d => d.itemcode > 0 && d.transferqty > 0).ToList();
            var payload = new stock_transfer_request
            {
                master = CurrentTransfer.master,
                details = validItems
            };

            var insertRes = await SendInsertTransferRequest(payload);
            if (insertRes.success)
            {
                if (insertRes.transfercode > 0)
                {
                    CurrentTransfer.master.transfercode = insertRes.transfercode;
                    foreach (var d in validItems)
                    {
                        d.transfercode = insertRes.transfercode;
                    }
                }
                ToastService.ShowSuccess($"Transfer #{CurrentTransfer.master.transferno} saved successfully!");
            }
            else
            {
                ToastService.ShowWarning($"Transfer saved locally. {insertRes.message}");
            }

            SaveToLocalLists(CurrentTransfer.master, validItems);
            SelectedSlipTransfer = CurrentTransfer.master;
            ShowSlipModal = true;
            await LoadTransfers();
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task SaveAsDraft() => await SaveAndPreviewTransfer();

    private async Task DispatchTransferFromModal(stock_transfer_master trf)
    {
        if (trf == null) return;
        IsDispatchingModal = true;
        try
        {
            var actionPayload = new stock_transfer_action_request
            {
                transfercode = trf.transfercode,
                usercode = 101,
                remarks = string.IsNullOrWhiteSpace(trf.remarks) ? "Store Outward Dispatched" : trf.remarks
            };

            bool success = await SendActionRequest("api/ItemMaster/dispatchstocktransfer", actionPayload);
            if (success)
            {
                trf.status = "IN_TRANSIT";
                ToastService.ShowSuccess($"Transfer #{trf.transferno} Dispatched successfully! Stock deducted from {GetStoreName(trf.fromwarehousecode)}.");
                await LoadTransfers();
                ResetForm();
            }
            else
            {
                ToastService.ShowError($"Failed to dispatch transfer #{trf.transferno}. Please check backend service.");
            }
        }
        finally
        {
            IsDispatchingModal = false;
        }
    }

    private async Task DispatchTransferDirectly(stock_transfer_master trf)
