    private decimal GetAvailableStockForItem(long itemcode, long? warehousecode)
    {
        if (itemcode <= 0) return 0;
        
        var matches = StockList.Where(s => s.itemcode == itemcode && !s.deleted);

        if (warehousecode.HasValue && warehousecode.Value > 0)
        {
            var storeMatches = matches.Where(s => s.warehousecode == warehousecode.Value).ToList();
            if (storeMatches.Any())
            {
                return storeMatches.Sum(s => s.closingstock);
            }
            return 0;
        }

        return matches.Sum(s => s.closingstock);
    }

    private IEnumerable<item_master> GetAvailableItemsForStore(string query)
    {
        var q = query?.Trim() ?? "";
        var fromWh = CurrentTransfer.master.fromwarehousecode;

        var matches = ItemList.Where(i => 
            string.IsNullOrEmpty(q) || 
            (i.itemname != null && i.itemname.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
            (i.shortname != null && i.shortname.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
            i.itemcode.ToString().Contains(q)
        );

        return matches
            .OrderByDescending(i => GetAvailableStockForItem(i.itemcode, fromWh) > 0)
            .ThenByDescending(i => GetAvailableStockForItem(i.itemcode, fromWh))
            .ThenBy(i => i.itemname);
    }

    private List<stock_master> GetBatchesForItem(long itemcode, long? warehousecode)
    {
        if (itemcode <= 0) return new();

        var matches = StockList
            .Where(s => s.itemcode == itemcode && !string.IsNullOrWhiteSpace(s.batchno) && !s.deleted)
            .ToList();

        if (warehousecode.HasValue && warehousecode.Value > 0)
        {
            matches = matches.Where(s => s.warehousecode == warehousecode.Value).ToList();
        }

        // FIFO: Priority to positive stock, sorted by earliest createddate (first purchased/entered), manufacturingdate, expirydate, and stockcode
        return matches
            .OrderByDescending(s => s.closingstock > 0)
            .ThenBy(s => s.createddate != default ? s.createddate : DateTime.MaxValue)
            .ThenBy(s => s.manufacturingdate.HasValue ? s.manufacturingdate.Value : DateTime.MaxValue)
            .ThenBy(s => s.expirydate.HasValue ? s.expirydate.Value : DateTime.MaxValue)
            .ThenBy(s => s.stockcode)
            .GroupBy(s => s.batchno)
            .Select(g => g.First())
            .ToList();
    }

