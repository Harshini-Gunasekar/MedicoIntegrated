                </div>

            </div>

            <!-- Optional Modal Footer for Draft Transfers (Dispatch Action) -->
            @if (SelectedSlipTransfer.status == "DRAFT" || SelectedSlipTransfer.status == "PENDING")
            {
                <div style="padding: 12px 20px !important; border-top: 1px solid #e2e8f0 !important; background: #f8fafc !important; display: flex !important; justify-content: flex-end !important; align-items: center !important;">
                    <button type="button" class="btn-dispatch-vibrant btn-sm px-4" @onclick="() => DispatchTransferFromModal(SelectedSlipTransfer)" disabled="@IsDispatchingModal" style="min-width: 140px !important; height: 34px !important; font-size: 0.8rem !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; gap: 6px !important;">
                        @if (IsDispatchingModal)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Dispatching...</span>
                        }
                        else
                        {
                            <i class="bi bi-send-check-fill"></i>
                            <span>Dispatch Transfer</span>
                        }
                    </button>
                </div>
            }

        </div>
    </div>
}

