@code {
    private string DefaultTenant = "TNT001";
    private bool IsSaving = false;
    private bool IsDispatchingModal = false;
    private bool ShowSlipModal = false;
    private bool ShowHistoryModal = false;
    private string SearchText = "";
    private string HistorySearchText = "";
    private long selectedIndentCode = 0;

    // Typeahead tracking
    private Dictionary<int, string> ItemSearchTexts = new();
    private int? ActiveItemSearchRow = null;

    // Data Collections
    private List<stock_transfer_master> TransferList = new();
    private Dictionary<long, List<stock_transfer_detail>> TransferDetailsMap = new();
    private List<warehouse_master> WarehouseList = new();
    private List<item_master> ItemList = new();
    private List<stock_master> StockList = new();
    private List<uom_master> UomList = new();
    private List<indent_master> ApprovedIndents = new();
    private List<indent_request> RawIndentRequests = new();

    // Active Model
    private stock_transfer_request CurrentTransfer = new();
    private stock_transfer_master? SelectedSlipTransfer;

    private long GetTransferSortKey(stock_transfer_master t)
    {
        if (t == null) return 0;
        if (!string.IsNullOrWhiteSpace(t.transferno))
        {
            var digits = new string(t.transferno.Where(char.IsDigit).ToArray());
            if (long.TryParse(digits, out var num) && num > 0) return num;
        }
        return t.transfercode;
    }

    private List<stock_transfer_master> FilteredTransfers => TransferList
        .Where(t => string.IsNullOrWhiteSpace(SearchText) ||
                    (t.transferno != null && t.transferno.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
                    (t.remarks != null && t.remarks.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
                    GetStoreName(t.fromwarehousecode).Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                    GetStoreName(t.towarehousecode).Contains(SearchText, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(t => GetTransferSortKey(t))
        .ThenByDescending(t => t.transferdate)
        .ThenByDescending(t => t.transfercode)
        .ToList();

    private bool MatchesIssueHistorySearch(stock_transfer_master t, string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return true;
        var q = query.Trim();

        if (t.transferno != null && t.transferno.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (t.transfercode.ToString().Contains(q)) return true;
        if (t.remarks != null && t.remarks.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (GetStoreName(t.fromwarehousecode).Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (GetStoreName(t.towarehousecode).Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (t.indentcode.HasValue && ($"IND-{t.indentcode}".Contains(q, StringComparison.OrdinalIgnoreCase) || t.indentcode.ToString().Contains(q))) return true;

        var cleanQ = new string(q.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
        if (!string.IsNullOrEmpty(cleanQ))
        {
            var cleanTrf = new string((t.transferno ?? "").Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
            if (cleanTrf.Contains(cleanQ)) return true;

            var digitsQ = new string(q.Where(char.IsDigit).ToArray());
            if (!string.IsNullOrEmpty(digitsQ) && long.TryParse(digitsQ, out var numQ) && numQ > 0)
            {
                if (t.transfercode == numQ) return true;
                if (t.indentcode.HasValue && t.indentcode.Value == numQ) return true;
                var trfDigits = new string((t.transferno ?? "").Where(char.IsDigit).ToArray());
                if (trfDigits.Contains(digitsQ) || (long.TryParse(trfDigits, out var tn) && tn == numQ)) return true;
            }
        }
        return false;
    }

    private List<stock_transfer_master> HistoryFilteredTransfers => TransferList
        .Where(t => MatchesIssueHistorySearch(t, HistorySearchText))
        .OrderByDescending(t => GetTransferSortKey(t))
        .ThenByDescending(t => t.transferdate)
        .ThenByDescending(t => t.transfercode)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var res = await _sessionStorage.GetAsync<string>("tenant_code");
            if (res.Success && !string.IsNullOrWhiteSpace(res.Value))
            {
                DefaultTenant = res.Value;
            }
        }
        catch { }

        await Task.WhenAll(LoadWarehouses(), LoadStocks(), LoadItems(), LoadUoms(), LoadApprovedIndents(), LoadTransfers());
        InitNewTransfer();
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Remove("tenant-code");
        if (!string.IsNullOrEmpty(DefaultTenant))
        {
            client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant-code", DefaultTenant);
        }
        return client;
    }

    private void InitNewTransfer()
    {
        ItemSearchTexts.Clear();
        ActiveItemSearchRow = null;
        selectedIndentCode = 0;

        CurrentTransfer = new stock_transfer_request
        {
            master = new stock_transfer_master
            {
                transfercode = (TransferList.Any() ? TransferList.Max(t => t.transfercode) + 1 : 1001),
                transferno = $"ST-{(TransferList.Count + 1):D5}",
                transferdate = DateTime.Today,
                transfertype = "Standard",
                reason = "Stock Requirement",
                status = "DRAFT",
                fromwarehousecode = WarehouseList.FirstOrDefault()?.warehousecode ?? 1,
                towarehousecode = WarehouseList.Skip(1).FirstOrDefault()?.warehousecode ?? 2,
                createdby = 101,
                createddate = DateTime.Now,
                tenantcode = DefaultTenant
            },
            details = new List<stock_transfer_detail>()
        };

        AddDetailRow();
    }

    private void ResetForm()
    {
        InitNewTransfer();
        ToastService.ShowInfo("Issue form reset. Ready for new outward transfer.");
    }

    private async Task LoadWarehouses()
    {
        try
        {
            var client = CreateClient();
            var res = await client.GetStringAsync("api/ItemMaster/getallwarehouse");
            if (!string.IsNullOrWhiteSpace(res))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                try
                {
                    var direct = JsonSerializer.Deserialize<List<warehouse_master>>(res, options);
                    WarehouseList = (direct ?? new()).Where(w => !w.isdeleted && w.isactive).OrderBy(w => w.orderno).ToList();
                }
                catch
                {
                    var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<warehouse_master>>>(res, options);
                    WarehouseList = (wrapped?.data ?? new()).Where(w => !w.isdeleted && w.isactive).OrderBy(w => w.orderno).ToList();
                }
            }
        }
        catch { }

        if (!WarehouseList.Any())
        {
            WarehouseList = new List<warehouse_master>
            {
                new warehouse_master { warehousecode = 1, warehousename = "Main Pharmacy Store", isactive = true },
                new warehouse_master { warehousecode = 2, warehousename = "Ward Store", isactive = true },
                new warehouse_master { warehousecode = 3, warehousename = "ICU Emergency Store", isactive = true },
                new warehouse_master { warehousecode = 4, warehousename = "OT Surgery Store", isactive = true }
            };
        }
    }

    private async Task LoadStocks()
    {
        try
        {
            var client = CreateClient();
            string response = "";
            try
            {
                response = await client.GetStringAsync($"api/ItemMaster/getallstocks?tenantcode={DefaultTenant}");
            }
            catch
            {
                try
                {
                    response = await client.GetStringAsync("api/ItemMaster/getallstocks");
                }
                catch
                {
                    using var directClient = new HttpClient();
                    directClient.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
                    response = await directClient.GetStringAsync($"http://medicoapi.iscansoft.com/api/ItemMaster/getallstocks?tenantcode={DefaultTenant}");
                }
            }

            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions 
                { 
                    PropertyNameCaseInsensitive = true, 
                    NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString 
                };

                List<stock_master>? parsed = null;
                try
                {
                    parsed = JsonSerializer.Deserialize<List<stock_master>>(response, options);
                }
                catch { }

                if (parsed == null || !parsed.Any())
                {
                    try
                    {
                        var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<stock_master>>>(response, options);
                        parsed = wrapped?.data;
                    }
                    catch { }
                }

                if (parsed != null && parsed.Any())
                {
                    StockList = parsed
                        .Where(s => !s.deleted && (string.IsNullOrEmpty(DefaultTenant) || string.IsNullOrEmpty(s.tenantcode) || string.Equals(s.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase)))
                        .ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stocks: {ex.Message}");
        }
    }

    private async Task LoadItems()
    {
        try
        {
            var client = CreateClient();
            string response = "";
            try
            {
                response = await client.GetStringAsync($"api/ItemMaster/getallitems?tenantcode={DefaultTenant}");
            }
            catch
            {
                try
                {
                    response = await client.GetStringAsync("api/ItemMaster/getallitems");
                }
                catch
                {
                    using var directClient = new HttpClient();
                    directClient.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
                    response = await directClient.GetStringAsync($"http://medicoapi.iscansoft.com/api/ItemMaster/getallitems?tenantcode={DefaultTenant}");
                }
            }

            if (!string.IsNullOrWhiteSpace(response))
