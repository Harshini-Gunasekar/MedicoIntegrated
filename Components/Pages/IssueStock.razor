    private void CalculateRowStockValue(stock_transfer_detail detail)
    {
        detail.stockvalue = detail.transferqty * detail.unitcost;
    }

    private void OnSourceStoreChanged()
    {
        if (CurrentTransfer.master.fromwarehousecode == CurrentTransfer.master.towarehousecode)
        {
            var other = WarehouseList.FirstOrDefault(w => w.warehousecode != CurrentTransfer.master.fromwarehousecode);
            if (other != null)
            {
                CurrentTransfer.master.towarehousecode = other.warehousecode;
            }
        }

        foreach (var detail in CurrentTransfer.details.Where(d => d.itemcode > 0))
        {
            var batches = GetBatchesForItem(detail.itemcode, CurrentTransfer.master.fromwarehousecode);
            if (batches.Any())
            {
                var match = batches.FirstOrDefault(b => string.Equals(b.batchno, detail.batchno, StringComparison.OrdinalIgnoreCase))
                            ?? batches.FirstOrDefault(b => b.closingstock > 0)
                            ?? batches.First();

                detail.batchno = match.batchno;
                detail.availableqty = match.closingstock;
                if (match.unitcost > 0) detail.unitcost = match.unitcost;
                detail.expirydate = match.expirydate;
                detail.manufacturingdate = match.manufacturingdate;
            }
            else
            {
                detail.availableqty = GetAvailableStockForItem(detail.itemcode, CurrentTransfer.master.fromwarehousecode);
            }
            detail.stockvalue = detail.transferqty * detail.unitcost;
        }
    }

    private void OnReferenceIndentChanged()
    {
        if (selectedIndentCode > 0)
        {
            CurrentTransfer.master.indentcode = selectedIndentCode;
            FetchIndentItems();
        }
    }

    private void FetchIndentItems()
    {
        if (selectedIndentCode <= 0 && (!CurrentTransfer.master.indentcode.HasValue || CurrentTransfer.master.indentcode <= 0))
        {
            ToastService.ShowWarning("Please select a Reference Indent.");
            return;
        }

        var indentCodeToUse = selectedIndentCode > 0 ? selectedIndentCode : CurrentTransfer.master.indentcode.Value;
        var matchedReq = RawIndentRequests.FirstOrDefault(r => r.master?.indentcode == indentCodeToUse);

        if (matchedReq?.details != null && matchedReq.details.Any())
        {
            CurrentTransfer.details.Clear();
            ItemSearchTexts.Clear();

            int seq = 1;
            foreach (var d in matchedReq.details)
            {
                var itm = ItemList.FirstOrDefault(i => i.itemcode == d.itemcode);
                var row = new stock_transfer_detail
                {
                    transferdetailcode = seq++,
                    transfercode = CurrentTransfer.master.transfercode,
                    itemcode = d.itemcode,
                    requestedqty = d.requestedqty > 0 ? d.requestedqty : (d.approvedqty > 0 ? d.approvedqty : 1),
                    approvedqty = d.approvedqty > 0 ? d.approvedqty : (d.requestedqty > 0 ? d.requestedqty : 1),
                    transferqty = d.approvedqty > 0 ? d.approvedqty : (d.requestedqty > 0 ? d.requestedqty : 1),
                    tenantcode = DefaultTenant
                };

                if (itm != null)
                {
                    SelectItemFromDropdown(row, itm, row.GetHashCode());
                    row.requestedqty = d.requestedqty > 0 ? d.requestedqty : (d.approvedqty > 0 ? d.approvedqty : 1);
                    row.approvedqty = d.approvedqty > 0 ? d.approvedqty : (d.requestedqty > 0 ? d.requestedqty : 1);
                    row.transferqty = d.approvedqty > 0 ? d.approvedqty : (d.requestedqty > 0 ? d.requestedqty : 1);
                    CalculateRowStockValue(row);
                }
                CurrentTransfer.details.Add(row);
            }

            var indentNo = matchedReq.master?.indentno ?? $"IND-#{indentCodeToUse}";
            ToastService.ShowSuccess($"Loaded {matchedReq.details.Count} item(s) from Reference Indent {indentNo}");
        }
        else
        {
            var matchedMaster = ApprovedIndents.FirstOrDefault(i => i.indentcode == indentCodeToUse);
            var indentNo = matchedMaster?.indentno ?? $"IND-#{indentCodeToUse}";
            ToastService.ShowInfo($"Selected Reference Indent {indentNo}");
        }
    }

