                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                            <polyline points="10 9 9 9 8 9" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Issue Stock (Store Outward Transfer)</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> TOTAL ISSUES : @TransferList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by TRF no, store, indent..." @bind="SearchText" @bind:event="oninput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    <button class="add-item-btn" @onclick="AddNewIssue">
                        <i class="bi bi-plus-lg"></i>
                        <span class="ms-1">New Issue</span>
                    </button>
                </div>
            </div>

            <!-- Main Listing Card matching Purchase Master -->
            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredTransfers.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-box-arrow-up-right fs-1 d-block mb-3 text-indigo"></i>
                        No stock issue transfers found.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 60px; text-align: center;">S.NO</th>
                                    <th style="width: 135px; text-align: center;">TRANSFER NO</th>
                                    <th style="width: 130px; text-align: center; white-space: nowrap;">DATE</th>
                                    <th style="width: 20%; text-align: center;">FROM STORE</th>
                                    <th style="width: 20%; text-align: center;">TO STORE</th>
                                    <th style="width: 75px; text-align: center;">ITEMS</th>
                                    <th style="width: 95px; text-align: center;">TOTAL QTY</th>
                                    <th style="width: 125px; text-align: center;">TOTAL VALUE</th>
                                    <th style="width: 110px; text-align: center;">STATUS</th>
                                    <th style="width: 145px; text-align: center;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedTransfers.Select((value, index) => new { value, index }))
                                {
                                    var trf = row.value;
                                    <tr>
                                        <td style="text-align: center; font-weight: 700; color: #3b82f6;">@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td style="text-align: center; font-weight: 700; color: #4f46e5;">@FormatTransferNo(trf.transferno)</td>
                                        <td style="font-weight: 500; text-align: center; white-space: nowrap;">@trf.transferdate.ToString("yyyy-MM-dd")</td>
                                        <td style="font-weight: 600; text-align: center;">@GetStoreName(trf.fromwarehousecode)</td>
                                        <td style="font-weight: 600; text-align: center;">@GetStoreName(trf.towarehousecode)</td>
                                        <td style="font-weight: 700; text-align: center;">@GetItemCount(trf.transfercode)</td>
                                        <td style="font-weight: 700; text-align: center;">@GetTransferTotalQty(trf.transfercode).ToString("N0")</td>
                                        <td style="font-weight: 700; text-align: center; color: #4f46e5;">₹@GetTransferTotalValue(trf.transfercode).ToString("N2")</td>
                                        <td style="text-align: center;">
                                            <span style="color: @(trf.status == "RECEIVED" || trf.status == "COMPLETED" ? "#059669" : (trf.status == "IN_TRANSIT" ? "#0284c7" : "#d97706")); font-weight: 700; font-size: 0.78rem; text-transform: uppercase;">
                                                @trf.status
                                            </span>
                                        </td>
                                        <td style="text-align: center; white-space: nowrap;">
                                            <button class="action-btn btn-view" @onclick="() => ViewTransferSlip(trf)" title="View Slip"><i class="bi bi-eye"></i></button>
                                            @if (trf.status == "DRAFT" || trf.status == "PENDING")
                                            {
                                                <button class="action-btn btn-dispatch" @onclick="() => PromptDispatch(trf)" title="Dispatch Transfer"><i class="bi bi-send-fill"></i></button>
                                                <button class="action-btn btn-edit" @onclick="() => EditDraft(trf)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            }
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(trf)" title="Delete"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var trf in PagedTransfers)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span class="card-item-code">@FormatTransferNo(trf.transferno)</span>
                                    <div>
                                        <button class="action-btn btn-view" @onclick="() => ViewTransferSlip(trf)" title="View Slip"><i class="bi bi-eye"></i></button>
                                        @if (trf.status == "DRAFT" || trf.status == "PENDING")
                                        {
                                            <button class="action-btn btn-dispatch" @onclick="() => PromptDispatch(trf)" title="Dispatch Transfer"><i class="bi bi-send-fill"></i></button>
                                            <button class="action-btn btn-edit" @onclick="() => EditDraft(trf)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        }
                                        <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(trf)" title="Delete"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Date</span><strong>@trf.transferdate.ToString("yyyy-MM-dd")</strong></div>
                                    <div class="detail-row"><span>From Store</span><strong>@GetStoreName(trf.fromwarehousecode)</strong></div>
                                    <div class="detail-row"><span>To Store</span><strong>@GetStoreName(trf.towarehousecode)</strong></div>
                                    <div class="detail-row"><span>Total Qty</span><strong>@GetTransferTotalQty(trf.transfercode).ToString("N0")</strong></div>
                                    <div class="detail-row"><span>Total Value</span><strong style="color: #4f46e5;">₹@GetTransferTotalValue(trf.transfercode).ToString("N2")</strong></div>
                                    <div class="detail-row"><span>Status</span><strong style="color: @(trf.status == "RECEIVED" || trf.status == "COMPLETED" ? "#059669" : (trf.status == "IN_TRANSIT" ? "#0284c7" : "#d97706"));">@trf.status</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Pagination Footer matching Purchase Master -->
                <div class="display-controls px-4 py-3 border-top" style="display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredTransfers.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredTransfers.Count()))</strong> of <strong>@FilteredTransfers.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1" style="align-items: center;">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @foreach (var pageNum in GetVisiblePageNumbers())
                            {
                                var p = pageNum;
                                <button class="page-btn @(CurrentPage == p ? "active" : "")" @onclick="() => ChangePage(p)">
                                    @p
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- NEW / EDIT ISSUE MODAL POPUP (Compact & Neatly Aligned Matching Purchase Master) -->
@if (ShowModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            
            <!-- Modal Header (Matching Purchase Master with Add New Item button) -->
            <div class="modal-header-bar">
                <div class="modal-header-left">
                    <h3 class="modal-title">
                        @(IsEdit ? "Edit Issue Transfer" : "New Issue (Stock Transfer)")
                    </h3>
                </div>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Modal Inner Form -->
            <div class="modal-inner">
                <EditForm Model="CurrentTransfer" OnValidSubmit="SaveAndPreviewTransfer" autocomplete="off" onkeydown="if(event.key==='Enter' && event.target.tagName==='INPUT' && event.target.type!=='submit'){event.preventDefault();}">
                    <DataAnnotationsValidator />
                    <div class="modal-scroll-area">
                        
                        <!-- Section 1: Transfer Information Header -->
                        <div class="form-section-header">
                            <div class="form-section-title">Transfer Information</div>
                        </div>

                        <!-- Row 1: From Store (3.5fr), To Store (3.5fr), Reference Indent (3.2fr), Transfer Date (1.8fr reduced) -->
                        <div class="form-grid-row-1">
                            <div class="field-group">
                                <label class="field-label required">From Store (Source)</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentTransfer.master.fromwarehousecode" @bind-Value:after="OnSourceStoreChanged">
                                    <option value="0">-- Select Source Store --</option>
                                    @foreach (var w in WarehouseList)
                                    {
                                        <option value="@w.warehousecode">@w.warehousename</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="field-group">
                                <label class="field-label required">To Store (Destination)</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentTransfer.master.towarehousecode">
                                    <option value="0">-- Select Destination Store --</option>
                                    @foreach (var w in WarehouseList)
                                    {
                                        <option value="@w.warehousecode" disabled="@(w.warehousecode == CurrentTransfer.master.fromwarehousecode)">
                                            @w.warehousename @(w.warehousecode == CurrentTransfer.master.fromwarehousecode ? "(Source)" : "")
                                        </option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="field-group">
                                <label class="field-label">Reference Indent (Requisition)</label>
                                <div style="display: flex; gap: 4px;">
                                    <select class="form-control premium-input" @bind="selectedIndentCode" @bind:after="OnReferenceIndentChanged" style="flex: 1;">
                                        <option value="0">-- Direct Issue (No Indent) --</option>
                                        @foreach (var ind in AvailableApprovedIndents)
                                        {
                                            <option value="@ind.indentcode">
                                                @(string.IsNullOrWhiteSpace(ind.indentno) ? $"IND-#{ind.indentcode}" : ind.indentno)
                                            </option>
                                        }
                                    </select>
                                    @if (selectedIndentCode > 0)
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm px-2 py-0" @onclick="FetchIndentItems" title="Pull Items from Indent" style="height: 30px; border-radius: 6px;">
                                            <i class="bi bi-download"></i>
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Transfer Date (Width Reduced by Half) -->
                            <div class="field-group">
                                <label class="field-label required">Transfer Date</label>
                                <InputDate class="form-control premium-input" @bind-Value="CurrentTransfer.master.transferdate" />
                            </div>
                        </div>

                        <!-- Row 2: Transfer Type (3.2fr), Reason (3.2fr), Transfer No (2.4fr), Remarks (3.2fr reduced) -->
                        <div class="form-grid-row-2">
                            <div class="field-group">
                                <label class="field-label">Transfer Type</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentTransfer.master.transfertype">
                                    <option value="Standard">Standard</option>
                                    <option value="Surplus">Surplus</option>
                                    <option value="Emergency">Emergency</option>
                                    <option value="Direct Store Outward">Direct Store Outward</option>
                                    <option value="Department Replenishment">Dept Replenish</option>
                                </InputSelect>
                            </div>

                            <div class="field-group">
                                <label class="field-label">Reason</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentTransfer.master.reason">
                                    <option value="Stock Requirement">Stock Requirement</option>
                                    <option value="Department Replenishment">Dept Replenish</option>
                                    <option value="Emergency Patient Requirement">Emergency</option>
                                    <option value="Routine Reorder">Routine Reorder</option>
                                    <option value="Surplus Rebalance">Surplus Rebalance</option>
                                </InputSelect>
                            </div>

                            <div class="field-group">
                                <label class="field-label">Transfer No</label>
                                <input type="text" class="form-control premium-input" value="@FormatTransferNo(string.IsNullOrEmpty(CurrentTransfer.master.transferno) ? $"TRF-{(TransferList.Count + 1):D5}" : CurrentTransfer.master.transferno)" disabled style="background-color: #f8fafc; font-weight: 700; color: #4f46e5;" />
                            </div>

                            <!-- Remarks Field (Width Reduced by Half) -->
                            <div class="field-group">
                                <label class="field-label">Remarks / Outward Notes</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentTransfer.master.remarks" placeholder="Special handling notes..." />
                            </div>
                        </div>

                        <!-- Section 2: Transfer Details Header -->
                        <div class="form-section-header" style="margin-top: 6px; margin-bottom: 8px;">
                            <div class="form-section-title">Transfer Details</div>
                        </div>

                        <!-- Items Table matching Purchase Master -->
                        <div class="purchase-items-table-wrapper table-responsive" style="width: 100%;">
                            <table class="table align-middle mb-0" style="font-size: 0.84rem; width: 100%; table-layout: fixed; border-collapse: collapse;">
                                <thead class="purchase-items-table-header">
                                    <tr>
                                        <th style="width: 4%; text-align: center;">S.NO</th>
                                        <th style="width: 23%; text-align: left;">ITEM</th>
                                        <th style="width: 12%; text-align: center;">BATCH NO</th>
                                        <th style="width: 9%; text-align: center;">AVAIL QTY</th>
                                        <th style="width: 8%; text-align: center;">REQ QTY</th>
                                        <th style="width: 8%; text-align: center;">APPR QTY</th>
                                        <th style="width: 8%; text-align: center;">ISSUE QTY</th>
                                        <th style="width: 10%; text-align: center;">UNIT COST</th>
                                        <th style="width: 11%; text-align: center;">STOCK VALUE</th>
                                        <th style="width: 7%; text-align: center;">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in CurrentTransfer.details.Select((detail, index) => new { detail, index }))
                                    {
                                        var detail = row.detail;
                                        var index = row.index;
                                        var searchKey = detail.GetHashCode();
                                        <tr>
                                            <td class="purchase-items-table-cell text-center" style="color: #64748b; font-weight: 600; line-height: 32px;">@(index + 1)</td>
                                            
                                            <!-- Item Typeahead Dropdown -->
                                            <td class="purchase-items-table-cell" style="position: relative;">
                                                <input id="@($"item-input-{index}")"
                                                       type="text"
                                                       class="purchase-item-select"
                                                       style="width: 100%; height: 32px;"
                                                       placeholder="Type to search item..."
                                                       autocomplete="off"
                                                       value="@(ItemSearchTexts.GetValueOrDefault(searchKey, GetItemName(detail.itemcode)))"
                                                       @oninput="@(e => OnItemTypeaheadInput(e, detail, searchKey))"
                                                       @onfocus="@(() => ActiveItemSearchRow = index)"
                                                       @onclick="@(() => ActiveItemSearchRow = index)"
                                                       @onblur="OnSearchBlur" />

                                                @if (ActiveItemSearchRow == index)
                                                {
                                                    var searchText = ItemSearchTexts.GetValueOrDefault(searchKey, "");
                                                    var storeItems = GetAvailableItemsForStore(searchText).ToList();

                                                    @if (storeItems.Any())
                                                    {
                                                        <div class="custom-typeahead-dropdown">
                                                            @foreach (var item in storeItems)
                                                            {
                                                                var avail = GetAvailableStockForItem(item.itemcode, CurrentTransfer.master.fromwarehousecode);
                                                                <div class="custom-typeahead-item" 
                                                                     @onmousedown="@(() => SelectItemFromDropdown(detail, item, searchKey))">
                                                                    <span style="font-weight: 600; color: #1e293b; font-size: 0.76rem;">@item.itemname</span>
                                                                    <span style="font-size: 0.74rem; font-weight: 700; color: @(avail > 0 ? "#16a34a" : "#dc2626"); margin-left: 12px;">Avai:@avail.ToString("N0")</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </td>

                                            <!-- Batch Selector (Shows ONLY Batch No) -->
                                            <td class="purchase-items-table-cell text-center">
                                                @{
                                                    var batches = GetBatchesForItem(detail.itemcode, CurrentTransfer.master.fromwarehousecode);
                                                }
                                                @if (batches.Any())
                                                {
                                                    <select class="purchase-item-select text-center" style="height: 32px; width: 100%;" value="@detail.batchno" @onchange="@(e => OnBatchSelectChanged(detail, e.Value?.ToString()))">
                                                        <option value="">-- Batch --</option>
                                                        @foreach (var b in batches)
                                                        {
                                                            <option value="@b.batchno">@b.batchno</option>
                                                        }
                                                    </select>
                                                }
                                                else
                                                {
                                                    <input type="text" class="purchase-item-input text-center" style="height: 32px; width: 100%;" @bind="detail.batchno" placeholder="Batch No" />
                                                }
                                            </td>

                                            <!-- Avail Qty -->
                                            <td class="purchase-items-table-cell text-center">
                                                <span class="purchase-item-readonly text-center" style="display: block; line-height: 32px; height: 32px; font-weight: 700; color: #0273b2; width: 100%;">
                                                    @(detail.availableqty > 0 ? detail.availableqty.ToString("N0") : "0")
                                                </span>
                                            </td>

                                            <!-- Req Qty (placeholder 0) -->
                                            <td class="purchase-items-table-cell text-center">
                                                <input id="@($"req-{index}")" 
                                                       type="number" 
                                                       step="any" 
                                                       min="0" 
                                                       class="purchase-item-input text-center" 
                                                       style="height: 32px; width: 100%;"
                                                       @bind:get="detail.requestedqty == 0 ? (decimal?)null : detail.requestedqty" 
                                                       @bind:set="(val) => { detail.requestedqty = val ?? 0; OnReqQtyChanged(detail); }" 
                                                       @bind:event="oninput" 
                                                       placeholder="0" />
                                            </td>

                                            <!-- Appr Qty (placeholder 0) -->
                                            <td class="purchase-items-table-cell text-center">
                                                <input id="@($"appr-{index}")" 
                                                       type="number" 
                                                       step="any" 
                                                       min="0" 
                                                       class="purchase-item-input text-center" 
                                                       style="height: 32px; width: 100%;"
                                                       @bind:get="detail.approvedqty == 0 ? (decimal?)null : detail.approvedqty" 
                                                       @bind:set="(val) => { detail.approvedqty = val ?? 0; OnApprQtyChanged(detail); }" 
                                                       @bind:event="oninput" 
                                                       placeholder="0" />
                                            </td>

                                            <!-- Issue Qty (placeholder 0, Enter moves to next row) -->
                                            <td class="purchase-items-table-cell text-center">
                                                <input id="@($"issue-qty-input-{index}")" 
                                                       type="number" 
                                                       step="any" 
                                                       min="0" 
                                                       class="purchase-item-input text-center fw-bold" 
                                                       style="height: 32px; color: #0273b2; width: 100%;"
                                                       @bind:get="detail.transferqty == 0 ? (decimal?)null : detail.transferqty" 
                                                       @bind:set="(val) => { detail.transferqty = val ?? 0; CalculateRowStockValue(detail); }" 
                                                       @bind:event="oninput" 
                                                       @onkeydown="@(e => HandleIssueQtyKeyDown(e, detail, index))" 
                                                       placeholder="0" />
                                            </td>

                                            <!-- Unit Cost -->
                                            <td class="purchase-items-table-cell text-center">
                                                <span class="purchase-item-readonly text-end" style="display: block; line-height: 32px; height: 32px; width: 100%;">
                                                    ₹@detail.unitcost.ToString("N2")
                                                </span>
                                            </td>

                                            <!-- Stock Value -->
                                            <td class="purchase-items-table-cell text-center">
                                                <span class="purchase-item-readonly text-end fw-bold" style="display: block; line-height: 32px; height: 32px; color: #0f678f; width: 100%;">
                                                    ₹@detail.stockvalue.ToString("N2")
                                                </span>
                                            </td>

                                            <!-- Delete Row Button -->
                                            <td class="purchase-items-table-cell text-center" style="vertical-align: middle;">
                                                <button type="button" class="btn btn-outline-danger btn-sm" style="border-radius: 6px; padding: 0; border: none; background: rgba(239, 68, 68, 0.08); color: #dc2626; margin: 0 auto; display: flex; align-items: center; justify-content: center; height: 28px; width: 28px;" @onclick="() => RemoveDetailRow(detail)" title="Delete">
                                                    <i class="bi bi-trash" style="font-size: 0.88rem;"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Sub-bar: Total Items count and Add Item button matching Purchase Master -->
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 4px 4px; width: 100%;">
                            <div style="color: #475569; font-weight: 600; font-size: 0.84rem; display: flex; align-items: center; gap: 6px;">
                                <span>Total Items:</span>
                                <span style="background: #e0f2fe; color: #0284c7; font-weight: 800; font-size: 0.85rem; padding: 2px 10px; border-radius: 6px; border: 1px solid #bae6fd;">
                                    @(CurrentTransfer.details?.Count(d => d.itemcode > 0) ?? 0)
                                </span>
                            </div>
                            
                            <div>
                                <button type="button" class="btn-dotted-add" @onclick="AddDetailRow" style="padding: 5px 22px; font-size: 0.82rem; border-radius: 16px;">
                                    <i class="bi bi-plus-circle-fill" style="font-size: 0.9rem; margin-right: 4px;"></i> Add Item
                                </button>
                            </div>
                        </div>

                        <!-- Right Aligned Outward Stock Value Box (Compact / outline near text only) -->
                        <div style="display: flex; justify-content: flex-end; margin-top: 6px;">
