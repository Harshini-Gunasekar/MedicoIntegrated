@code {
    private string DefaultTenant = "TNT001";
    private bool IsLoading = false;
    private bool IsSaving = false;
    private bool IsCardView = false;
    private bool ShowModal = false;
    private bool IsEdit = false;
    private bool ShowDeleteConfirm = false;
    private bool ShowSlipModal = false;
    private string SearchText = "";
    private long selectedIndentCode = 0;

    // Pagination
    private int CurrentPage = 1;
    private int ItemsPerPage = 12;

    // Typeahead tracking
    private Dictionary<int, string> ItemSearchTexts = new();
    private int? ActiveItemSearchRow = null;

    // Data Collections
    private List<stock_transfer_master> TransferList = new();
    private Dictionary<long, List<stock_transfer_detail>> TransferDetailsMap = new();
    private List<warehouse_master> WarehouseList = new();
    private List<item_master> ItemList = new();
    private List<stock_master> StockList = new();
    private List<uom_master> UomList = new();
    private List<indent_master> AllIndentsList = new();
    private List<indent_master> ApprovedIndents = new();
    private List<indent_request> RawIndentRequests = new();

    // Active Models
    private stock_transfer_request CurrentTransfer = new();
    private stock_transfer_master? SelectedSlipTransfer;
    private stock_transfer_master? TransferToDelete;

    private long GetTransferSortKey(stock_transfer_master t)
    {
        if (t == null) return 0;
        if (!string.IsNullOrWhiteSpace(t.transferno))
        {
            var digits = new string(t.transferno.Where(char.IsDigit).ToArray());
            if (long.TryParse(digits, out var num) && num > 0) return num;
        }
        return t.transfercode;
    }

    private IEnumerable<indent_master> AvailableApprovedIndents =>
        ApprovedIndents.Where(ind =>
        {
            // 1. Must be Approved
            if (!string.Equals(ind.approvalstatus, "APPROVED", StringComparison.OrdinalIgnoreCase))
                return false;

            if (ind.deleted)
                return false;

            // Keep currently selected indent visible in dropdown while editing
            if (selectedIndentCode > 0 && ind.indentcode == selectedIndentCode)
                return true;

            // 2. Exclude if stock transfer was already received / completed for this indent
            bool isAlreadyReceived = TransferList.Any(t =>
                t.indentcode.HasValue && t.indentcode.Value == ind.indentcode &&
                !string.Equals(t.status, "CANCELLED", StringComparison.OrdinalIgnoreCase) &&
                !string.Equals(t.status, "REJECTED", StringComparison.OrdinalIgnoreCase) &&
                (
                    string.Equals(t.status, "RECEIVED", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(t.status, "COMPLETED", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(t.status, "CLOSED", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(t.status, "ACCEPTED", StringComparison.OrdinalIgnoreCase) ||
                    (TransferDetailsMap.TryGetValue(t.transfercode, out var dets) && dets != null && dets.Any(d => d.receivedqty > 0))
                )
            );

            return !isAlreadyReceived;
        });

    private string GetIndentDisplay(long? indentCode, bool showDashForNone = true)
    {
        if (!indentCode.HasValue || indentCode.Value <= 0)
        {
            return showDashForNone ? "-" : "Direct Issue (No Indent)";
        }

        var indent = AllIndentsList.FirstOrDefault(i => i.indentcode == indentCode.Value)
                     ?? ApprovedIndents.FirstOrDefault(i => i.indentcode == indentCode.Value);

        if (indent != null && !string.IsNullOrWhiteSpace(indent.indentno))
        {
            return indent.indentno;
        }

        var req = RawIndentRequests.FirstOrDefault(r => r.master?.indentcode == indentCode.Value);
        if (req?.master != null && !string.IsNullOrWhiteSpace(req.master.indentno))
        {
            return req.master.indentno;
        }

        return $"IND-#{indentCode.Value}";
    }

    private List<stock_transfer_master> FilteredTransfers => TransferList
        .Where(t => string.IsNullOrWhiteSpace(SearchText) ||
                    (t.transferno != null && t.transferno.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
                    (t.remarks != null && t.remarks.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
                    GetStoreName(t.fromwarehousecode).Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                    GetStoreName(t.towarehousecode).Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                    GetIndentDisplay(t.indentcode).Contains(SearchText, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(t => GetTransferSortKey(t))
        .ThenByDescending(t => t.transferdate)
        .ThenByDescending(t => t.transfercode)
        .ToList();

    private int TotalPages => (int)Math.Ceiling((double)FilteredTransfers.Count / ItemsPerPage);

    private List<stock_transfer_master> PagedTransfers => FilteredTransfers
        .Skip((CurrentPage - 1) * ItemsPerPage)
        .Take(ItemsPerPage)
        .ToList();

    private void SetView(bool isCard)
    {
        IsCardView = isCard;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private List<int> GetVisiblePageNumbers()
    {
        var list = new List<int>();
        int total = TotalPages;
        if (total <= 5)
        {
            for (int i = 1; i <= total; i++) list.Add(i);
        }
        else
        {
            int start = Math.Max(1, CurrentPage - 2);
            int end = Math.Min(total, CurrentPage + 2);
            if (start > 1) list.Add(1);
            for (int i = start; i <= end; i++)
            {
                if (!list.Contains(i)) list.Add(i);
            }
            if (end < total && !list.Contains(total)) list.Add(total);
        }
        return list;
    }

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            var res = await _sessionStorage.GetAsync<string>("tenant_code");
            if (res.Success && !string.IsNullOrWhiteSpace(res.Value))
            {
                DefaultTenant = res.Value;
            }
            else
            {
                var res2 = await _sessionStorage.GetAsync<string>("TenantCode");
                if (res2.Success && !string.IsNullOrWhiteSpace(res2.Value))
                {
                    DefaultTenant = res2.Value;
                }
            }
        }
        catch { }

        if (string.IsNullOrWhiteSpace(DefaultTenant) || DefaultTenant == "TNT001")
        {
            DefaultTenant = "0010";
        }

        await Task.WhenAll(LoadWarehouses(), LoadStocks(), LoadItems(), LoadUoms(), LoadApprovedIndents(), LoadTransfers());
        InitNewTransfer();
        IsLoading = false;
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Remove("tenant-code");
        if (!string.IsNullOrEmpty(DefaultTenant))
        {
            client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant-code", DefaultTenant);
        }
        return client;
    }

    private void AddNewIssue()
    {
        IsEdit = false;
        InitNewTransfer();
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
    }

    private void ConfirmDelete(stock_transfer_master trf)
    {
        TransferToDelete = trf;
        ShowDeleteConfirm = true;
    }

    private void PerformDelete()
    {
        if (TransferToDelete != null)
        {
            TransferList.Remove(TransferToDelete);
            TransferDetailsMap.Remove(TransferToDelete.transfercode);
            ToastService.ShowSuccess($"Transfer #{TransferToDelete.transferno} deleted.");
            TransferToDelete = null;
            ShowDeleteConfirm = false;
        }
    }

    private void InitNewTransfer()
    {
        ItemSearchTexts.Clear();
        ActiveItemSearchRow = null;
        selectedIndentCode = 0;

        CurrentTransfer = new stock_transfer_request
        {
            master = new stock_transfer_master
            {
                transfercode = (TransferList.Any() ? TransferList.Max(t => t.transfercode) + 1 : 1001),
                transferno = $"TRF-{(TransferList.Count + 1):D5}",
                transferdate = DateTime.Today,
                transfertype = "Standard",
                reason = "Stock Requirement",
                status = "DRAFT",
                fromwarehousecode = 0,
                towarehousecode = 0,
                remarks = "",
                createdby = 101,
                createddate = DateTime.Now,
                tenantcode = DefaultTenant
            },
            details = new List<stock_transfer_detail>()
        };

        AddDetailRow();
    }

    private List<warehouse_master> ParseWarehouseList(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true, NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString };
        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
