@page "/due-collection-history"
@rendermode InteractiveServer
@using medico_backend.Model
@using Medico_Backend.Model
@using Booking.Models
@inject HmsDueCollectionService DueCollectionService
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.CounterMasterService CounterService
@inject Booking.Services.PaymodeMasterService PaymodeService
@inject Booking.Services.ReimbursementCompanyMasterService CompanyService
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IHttpClientFactory ClientFactory
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<div class="due-collection-wrapper">
    @if (!IsEmbedded)
    {
        <!-- Top Header Card -->
        <div class="due-header-card">
            <div class="header-left-section">
                <div class="header-icon-container">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="header-text-container">
                    <h1>Due Collection History</h1>
                    <p><span class="header-status-dot"></span> VIEW AND MANAGE PAST COLLECTIONS</p>
                </div>
            </div>
            <button class="btn-history-filter-trigger @(showHistoryFilter ? "active" : "")" @onclick="ToggleHistoryFilter">
                <i class="bi bi-funnel"></i> Filter
            </button>
        </div>
    }

    @if (showHistoryFilter)
    {
        <div class="hist-filter-card">
            <div class="hist-filter-body">
                <!-- Row 1: FROM / TO / PERIOD PRESET / BRANCH -->
                <div class="hist-filter-row-4">
                    <div class="hist-fg">
                        <label>FROM</label>
                        <input type="date" class="hist-input" @bind="histFilter.fromdate" />
                    </div>
                    <div class="hist-fg">
                        <label>TO</label>
                        <input type="date" class="hist-input" @bind="histFilter.todate" />
                    </div>
                    <div class="hist-fg">
                        <label>PERIOD PRESET</label>
                        <select class="hist-select" value="@selectedPeriodPreset" @onchange='(e) => OnPeriodPresetChanged(e.Value?.ToString() ?? "Today")'>
                            <option value="Today">Today</option>
                            <option value="Yesterday">Yesterday</option>
                            <option value="This Week">This Week</option>
                            <option value="This Month">This Month</option>
                            <option value="Last Month">Last Month</option>
                            <option value="Custom">Custom</option>
                        </select>
                    </div>
                    <div class="hist-fg">
                        <label>BRANCH</label>
                        <select class="hist-select" @bind="histFilter.bhcode">
                            <option value="">Select Branch</option>
                            @foreach (var b in branchesList)
                            {
                                <option value="@b.bh_code">@b.name</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Row 2: COUNTER / PAYMODE / CUSTOMER / SEARCH -->
                <div class="hist-filter-row-4">
                    <div class="hist-fg">
                        <label>COUNTER</label>
                        <select class="hist-select" @bind="histFilter.cntcode">
                            <option value="">Select Counter</option>
                            @foreach (var c in FilteredCounters)
                            {
                                <option value="@((int)c.cntcode)">@c.name</option>
                            }
                        </select>
                    </div>
                    <div class="hist-fg">
                        <label>PAYMODE</label>
                        <select class="hist-select" @bind="histFilter.collection_type">
                            <option value="">All Paymodes</option>
                            <option value="CASH">CASH</option>
                            <option value="CARD">CARD</option>
                            <option value="UPI">UPI</option>
                            <option value="CHEQUE">CHEQUE</option>
                            @foreach (var pm in paymodesList.Where(p => !string.IsNullOrEmpty(p.shortname) && !new[] { "CASH", "CARD", "UPI", "CHEQUE" }.Contains(p.shortname.ToUpper())))
                            {
                                <option value="@pm.shortname">@pm.name</option>
                            }
                        </select>
                    </div>
                    <div class="hist-fg">
                        <label>CUSTOMER</label>
                        <div class="autocomplete-search-wrapper">
                            <input type="text" class="hist-input" placeholder="Search ID, Name, Mobile..."
                                   value="@patientSearchQuery" @oninput="OnPatientSearchInput" @onkeydown="OnPatientSearchKeyDown" style="width: 100%;" />
                            @if (showPatientDropdown && searchedPatients.Count > 0)
                            {
                                <div class="autocomplete-dropdown">
                                    @for (int i = 0; i < searchedPatients.Count; i++)
                                    {
                                        var patIdx = i;
                                        var pat = searchedPatients[i];
                                        <div class="autocomplete-item @(patIdx == activePatientIndex ? "active-focused" : "")" 
                                             @onclick="() => SelectCustomerPatient(pat)"
                                             @onmouseover="() => activePatientIndex = patIdx">
                                            <div>
                                                <span style="font-weight: 600; color: #0f172a;">@pat.name (CUST-@pat.custid)</span>
                                                <div style="font-size: 0.8em; color: #64748b;">
                                                    📞 @pat.mobile | 📍 @(string.IsNullOrEmpty(pat.area) ? "No Area" : pat.area), @pat.city
                                                </div>
                                            </div>
                                            <span class="autocomplete-code">@pat.custcode</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="hist-fg">
                        <label>SEARCH</label>
                        <input type="text" class="hist-input" placeholder="Search bill, doctor, text..."
                               @bind="histFilter.search" />
                    </div>
                </div>

                <!-- Action buttons -->
                <div class="hist-filter-actions">
                    <button class="btn-hist-search" @onclick="SearchHistory">
                        <i class="bi bi-search"></i> Search
                    </button>
                    <button class="btn-hist-reset" @onclick="ResetHistoryFilter" style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0.5rem 1rem; font-weight: 600; cursor: pointer;">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </button>
                    <button class="btn-hist-print" @onclick="PrintHistory">
                        <i class="bi bi-printer-fill"></i> Print
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Results Table -->
    <div class="table-container shadow-sm mt-3">
        <table class="due-table hist-report-table">
            <thead>
                <tr>
                    <th>RECEIPT DATE</th>
                    <th>RECEIPT NO</th>
                    <th>PATIENT ID</th>
                    <th>CUSTOMER</th>
                    <th>DOCTOR</th>
                    <th>BILL NO</th>
                    <th class="text-end">RECEIVED</th>
                    <th class="text-center">PAYMODE</th>
                    <th class="text-center">PRINT</th>
                    <th class="text-center">DELETE</th>
                </tr>
            </thead>
            <tbody>
                @if (loadingHistory)
                {
                    <tr>
                        <td colspan="10" class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <div class="mt-2 text-muted">Loading collection history...</div>
                        </td>
                    </tr>
                }
                else if (historyReportRows.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="bi bi-receipt-cutoff font-xxl"></i>
                            <div class="mt-2">No records found. Use the filter above to search.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var row in historyReportRows)
                    {
                        <tr>
                            <td class="font-sm text-muted">@(row.receiptdate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                            <td class="font-mono font-bold text-primary">@row.receipt_no</td>
                            <td class="font-mono font-sm text-muted">@(row.custid?.ToString() ?? "-")</td>
                            <td class="font-bold">@(string.IsNullOrWhiteSpace(row.patient_name) ? "-" : row.patient_name)</td>
                            <td class="text-muted font-sm">@(string.IsNullOrWhiteSpace(row.doctor_name) ? "-" : row.doctor_name)</td>
                            <td class="font-mono font-sm">@(string.IsNullOrWhiteSpace(row.bill_no) ? "-" : row.bill_no)</td>
                            <td class="text-end font-bold text-success">
                                @((row.amount ?? 0).ToString("N2"))
                            </td>
                            <td class="text-center">
                                @{
                                    string displayPaymode = string.IsNullOrWhiteSpace(row.collection_type) ? "DUE" : row.collection_type;
                                }
                                <span class="badge-paymode @(displayPaymode.ToLower())">
                                    @displayPaymode
                                </span>
                            </td>
                            <td class="text-center" style="white-space: nowrap;">
                                <button class="btn-hist-action blue" title="Print Patient Receipt" @onclick="() => PrintPatientReceipt(row)">
                                    <i class="bi bi-person-badge"></i>
                                </button>
                                <button class="btn-hist-action green" title="Print Referral Receipt" @onclick="() => PrintReferralReceipt(row)" style="margin-left: 4px;">
                                    <i class="bi bi-person-lines-fill"></i>
                                </button>
                            </td>
                            <td class="text-center">
                                <button class="btn-hist-action red" title="Cancel / Delete" @onclick="() => PromptCancelFromHistory(row)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- History Bottom Grid (Pagination + Grand Total Collected Card) -->
    <div class="history-bottom-container mt-3">
        <!-- Left: Pagination -->
        <div class="history-pagination-left">
            @if (histTotalCount > 0)
            {
                <span class="pagination-info">Showing @(Math.Min((histCurrentPage - 1) * histPageSize + 1, histTotalCount)) to @(Math.Min(histCurrentPage * histPageSize, histTotalCount)) of @histTotalCount records</span>
            }
            @if (histTotalCount > histPageSize)
            {
                <div class="pagination-buttons ms-3">
                    <button class="pag-btn" disabled="@(histCurrentPage == 1)" @onclick="() => ChangeHistPage(histCurrentPage - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    @for (int i = 1; i <= HistTotalPages; i++)
                    {
                        var pn = i;
                        <button class="pag-btn @(histCurrentPage == pn ? "active" : "")" @onclick="() => ChangeHistPage(pn)">@pn</button>
                    }
                    <button class="pag-btn" disabled="@(histCurrentPage == HistTotalPages || HistTotalPages == 0)" @onclick="() => ChangeHistPage(histCurrentPage + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            }
        </div>

        <!-- Right: Collected Amt Card -->
        <div class="collected-amt-card-right">
            <div class="collected-amt-icon-bg">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div class="collected-amt-info">
                <span class="collected-amt-label">COLLECTED AMT</span>
                <span class="collected-amt-val">₹ @grandTotalCollected.ToString("N2")</span>
            </div>
        </div>
    </div>
</div>

<!-- Modal Cancellation dialog -->
@if (showCancelModal && receiptToCancel != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-card-custom shadow-lg">
            <div class="modal-header-custom">
                <h3>Cancel Due Collection Receipt</h3>
                <button class="close-btn" @onclick="CloseCancelModal">&times;</button>
            </div>
            <div class="modal-body-custom">
                <p>Are you sure you want to cancel the collection receipt <strong class="text-primary">@receiptToCancel.receipt_no</strong>?</p>
                <div class="mt-3">
                    <label class="font-bold font-sm">Reason for Cancellation</label>
                    <textarea class="control-textarea mt-1" placeholder="Enter reason..." @bind="cancelReason"></textarea>
                </div>
            </div>
            <div class="modal-footer-custom">
                <button class="btn btn-secondary-custom" @onclick="CloseCancelModal">Close</button>
                <button class="btn btn-danger-custom" @onclick="SubmitCancelReceipt" disabled="@(string.IsNullOrWhiteSpace(cancelReason) || cancelling)">
                    @if (cancelling)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    }
                    Cancel Receipt
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsEmbedded { get; set; } = false;

    private bool showHistoryFilter = false;
    private HmsPaidHistoryFilterRequest histFilter = new();
    private List<HmsPaidHistoryRow> historyReportRows = new();
    private int histCurrentPage = 1;
    private int histPageSize = 20;
    private int histTotalCount = 0;
    private double grandTotalCollected = 0;
    private int HistTotalPages => (int)Math.Ceiling((double)histTotalCount / histPageSize);
    
    // Cancel-from-history
    private bool showCancelModal = false;
    private HmsPaidHistoryRow? receiptToCancel;
    private int cancelUserCode = 10;
    private string cancelReason = string.Empty;
    private bool cancelling = false;
    private bool loadingHistory = false;

    private string selectedPeriodPreset = "Today";
    private List<DoctorMasterModel> doctorsList = new();
    private List<Booking.Models.BranchModel> branchesList = new();
    private List<CounterMasterModel> countersList = new();
    private List<PaymodeMasterModel> paymodesList = new();

    private IEnumerable<CounterMasterModel> FilteredCounters =>
        histFilter.bhcode.HasValue && histFilter.bhcode.Value > 0
            ? countersList.Where(c => c.bhcode == histFilter.bhcode.Value || c.bhcode == 0 || c.bhcode == null)
            : countersList;

    private string patientSearchQuery = string.Empty;
    private List<Booking.Models.CustomerWithOpModel> searchedPatients = new();
    private bool showPatientDropdown = false;
    private int activePatientIndex = -1;
    private System.Threading.CancellationTokenSource? _patientSearchCts;

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;
        histFilter.fromdate = today;
        histFilter.todate = today;
        histFilter.receipt_type = "DUE";
        histFilter.page = 1;
        histFilter.pagesize = 20;
        selectedPeriodPreset = "Today";

        await RunHistoryFilter();
    }

    public bool IsFilterOpen => showHistoryFilter;

    public void ToggleHistoryFilter()
    {
        showHistoryFilter = !showHistoryFilter;
        StateHasChanged();
    }

    private async Task SearchHistory()
    {
        histCurrentPage = 1;
        await RunHistoryFilter();
    }

    private async Task ChangeHistPage(int page)
    {
        if (page < 1 || page > HistTotalPages) return;
        histCurrentPage = page;
        await RunHistoryFilter();
    }

    private async Task RunHistoryFilter()
    {
        loadingHistory = true;
        StateHasChanged();

        try
        {
            var req = new HmsPaidHistoryFilterRequest
            {
                bhcode = histFilter.bhcode > 0 ? histFilter.bhcode : null,
                cntcode = histFilter.cntcode > 0 ? histFilter.cntcode : null,
                custid = histFilter.custid > 0 ? histFilter.custid : null,
                fromdate = histFilter.fromdate,
                todate = histFilter.todate,
                receipt_type = "DUE", // strictly DUE alone
                collection_type = string.IsNullOrWhiteSpace(histFilter.collection_type) || histFilter.collection_type == "ALL" ? null : histFilter.collection_type,
                search = string.IsNullOrWhiteSpace(histFilter.search) ? null : histFilter.search.Trim(),
                page = histCurrentPage,
                pagesize = histPageSize
            };

            var res = await DueCollectionService.GetPaidHistoryAsync(req);
            if (res != null && res.success)
            {
                historyReportRows = res.data ?? new();
                histTotalCount = res.totalCount;
                if (res.summary != null)
                {
                    grandTotalCollected = res.summary.total_due_collected > 0
                        ? res.summary.total_due_collected
                        : (res.summary.net_collected > 0 ? res.summary.net_collected : historyReportRows.Sum(r => r.amount ?? 0));
                }
                else
                {
                    grandTotalCollected = historyReportRows.Sum(r => r.amount ?? 0);
                }
            }
            else
            {
                historyReportRows = new();
                histTotalCount = 0;
                grandTotalCollected = 0;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load collection history: {ex.Message}");
        }
        finally
        {
            loadingHistory = false;
            StateHasChanged();
        }
    }

    private async Task ResetHistoryFilter()
    {
        var today = DateTime.Today;
        histFilter = new HmsPaidHistoryFilterRequest
        {
            fromdate = today,
            todate = today,
            receipt_type = "DUE",
            page = 1,
            pagesize = 20
        };
        selectedPeriodPreset = "Today";
        patientSearchQuery = "";
        searchedPatients.Clear();
        showPatientDropdown = false;
        histCurrentPage = 1;
        await RunHistoryFilter();
    }

    private void PrintHistory()
    {
        ToastService.ShowSuccess("Print triggered — implement PDF/print export here.");
    }

    private async Task FetchAndPrintReceipt(string url)
    {
        try
        {
            Console.WriteLine($"[PrintReceipt] Requesting URL: {url}");
            
            using var client = ClientFactory.CreateClient("DoctorApi");
            
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
                Console.WriteLine($"[PrintReceipt] Header - tenant_code: {TenantState.TenantCode}");
            }
            
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }

            var resp = await client.GetAsync(url);
            Console.WriteLine($"[PrintReceipt] Response Status: {resp.StatusCode} ({(int)resp.StatusCode})");
            
            if (resp.IsSuccessStatusCode)
            {
                var bytes = await resp.Content.ReadAsByteArrayAsync();
                if (bytes == null || bytes.Length == 0)
                {
                    Console.WriteLine("[PrintReceipt] Error: Response body is empty");
                    ToastService.ShowError("Received empty response from print API.");
                    return;
                }

                string base64;
                if (bytes.Length >= 5 && bytes[0] == 0x25 && bytes[1] == 0x50 && bytes[2] == 0x44 && bytes[3] == 0x46 && bytes[4] == 0x2D)
                {
                    base64 = Convert.ToBase64String(bytes);
                }
                else
                {
                    var raw = System.Text.Encoding.UTF8.GetString(bytes);
                    base64 = raw.Trim().Trim('"').Trim();
                }

                await JS.InvokeVoidAsync("openBase64Pdf", base64);
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                Console.WriteLine($"[PrintReceipt] Error: Fetch failed. Response content: {err}");
                ToastService.ShowError($"Failed to fetch receipt: {err}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PrintReceipt] Exception occurred: {ex}");
            ToastService.ShowError($"Print error: {ex.Message}");
        }
    }

    private async Task PrintPatientReceipt(HmsPaidHistoryRow row)
    {
        if (string.IsNullOrEmpty(row.receiptguid))
        {
            ToastService.ShowError("Receipt GUID is missing.");
            return;
        }
        string url = $"api/report/getpatientreceipt?isletterhead=true&receiptguid={row.receiptguid}";
        if (!string.IsNullOrEmpty(TenantState.TenantCode))
        {
            url += $"&tenant_code={TenantState.TenantCode}";
        }
        await FetchAndPrintReceipt(url);
    }

    private async Task PrintReferralReceipt(HmsPaidHistoryRow row)
    {
        if (string.IsNullOrEmpty(row.receiptguid))
        {
            ToastService.ShowError("Receipt GUID is missing.");
            return;
        }
        string url = $"api/report/getreferralreceipt?isletterhead=true&receiptguid={row.receiptguid}";
        if (!string.IsNullOrEmpty(TenantState.TenantCode))
        {
            url += $"&tenant_code={TenantState.TenantCode}";
        }
        await FetchAndPrintReceipt(url);
    }

    private void PromptCancelFromHistory(HmsPaidHistoryRow row)
    {
        receiptToCancel = row;
        cancelReason   = string.Empty;
        cancelUserCode = 10;
        showCancelModal = true;
    }

    private void CloseCancelModal()
    {
        showCancelModal = false;
        receiptToCancel = null;
    }

    private async Task SubmitCancelReceipt()
    {
        if (receiptToCancel == null || string.IsNullOrWhiteSpace(receiptToCancel.receiptguid)) return;
        cancelling = true;
        StateHasChanged();

        try
        {
            var result = await DueCollectionService.CancelReceiptAsync(receiptToCancel.receiptguid, cancelUserCode, cancelReason);
            if (result.Contains("success", StringComparison.OrdinalIgnoreCase) || result.Contains("cancelled", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(result))
            {
                ToastService.ShowSuccess($"Receipt {receiptToCancel.receipt_no} has been cancelled.");
                showCancelModal = false;
                await RunHistoryFilter();
            }
            else
            {
                ToastService.ShowError($"Cancellation response: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to cancel receipt: {ex.Message}");
        }
        finally
        {
            cancelling = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadBranchesAsync();
            await LoadCountersAsync();
            await LoadPaymodesAsync();
            await LoadDoctorsAsync();
            StateHasChanged();
        }
    }

    private void OnPeriodPresetChanged(string val)
    {
        selectedPeriodPreset = val;
        var today = DateTime.Today;
        if (val == "Today")
        {
            histFilter.fromdate = today;
            histFilter.todate = today;
        }
        else if (val == "Yesterday")
        {
            histFilter.fromdate = today.AddDays(-1);
            histFilter.todate = today.AddDays(-1);
        }
        else if (val == "This Week")
        {
            int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
            histFilter.fromdate = today.AddDays(-1 * diff);
            histFilter.todate = today;
        }
        else if (val == "This Month")
        {
            histFilter.fromdate = new DateTime(today.Year, today.Month, 1);
            histFilter.todate = today;
        }
        else if (val == "Last Month")
        {
            var lastMonth = today.AddMonths(-1);
            histFilter.fromdate = new DateTime(lastMonth.Year, lastMonth.Month, 1);
            histFilter.todate = new DateTime(lastMonth.Year, lastMonth.Month, DateTime.DaysInMonth(lastMonth.Year, lastMonth.Month));
        }
        StateHasChanged();
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = CreateClient(true);
            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                branchesList = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branchesList = branchesList.Where(b => !b.deleted).ToList();

                await FilterBranchesByUserAccessAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }

    private async Task LoadCountersAsync()
    {
        try
        {
            countersList = await CounterService.GetCountersAsync() ?? new();
            countersList = countersList.Where(c => !c.deleted).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading counters: {ex.Message}");
        }
    }

    private async Task LoadPaymodesAsync()
    {
        try
        {
            paymodesList = await PaymodeService.GetPaymodeMastersAsync() ?? new();
            paymodesList = paymodesList.Where(p => !p.deleted).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading paymodes: {ex.Message}");
        }
    }

    private async Task FilterBranchesByUserAccessAsync()
    {
        try
        {
            var isTenantAdminResult = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
            if (isTenantAdminResult.Success && isTenantAdminResult.Value == true)
            {
                return;
            }

            var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            if (userDetailsResult.Success && userDetailsResult.Value != null)
            {
                var ud = userDetailsResult.Value;
                if (ud.UserCode == 0 || ud.UserCode == 1 ||
                    string.Equals(ud.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(ud.Role, "Admin", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(ud.Role, "Owner", StringComparison.OrdinalIgnoreCase))
                {
                    return;
                }

                if (ud.Branches != null && ud.Branches.Any())
                {
                    var allowedCodes = ud.Branches
                        .Select(b => b.bh_code != 0 ? b.bh_code : (b.bhcode ?? 0))
                        .Where(code => code > 0)
                        .ToHashSet();

                    if (allowedCodes.Any())
                    {
                        var filtered = branchesList.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                        if (filtered.Any())
                        {
                            branchesList = filtered;
                            return;
                        }
                    }
                }
            }

            var branchCodesResult = await _sessionStorage.GetAsync<List<int>>("UserBranchCodes");
            if (branchCodesResult.Success && branchCodesResult.Value != null && branchCodesResult.Value.Any())
            {
                var allowedCodes = branchCodesResult.Value.ToHashSet();
                var filtered = branchesList.Where(b => allowedCodes.Contains(b.bh_code)).ToList();
                if (filtered.Any())
                {
                    branchesList = filtered;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering branches by user access: {ex.Message}");
        }
    }

    private async Task LoadDoctorsAsync()
    {
        try
        {
            doctorsList = await DoctorService.GetDoctorsAsync();
            doctorsList = doctorsList.Where(d => !d.deleted).OrderBy(d => d.name).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading doctors: {ex.Message}");
        }
    }

    private HttpClient CreateClient(bool isLabCare = false)
    {
        var clientName = isLabCare ? "LabCareUrl" : "DoctorApi";
        var client = ClientFactory.CreateClient(clientName);
        if (!string.IsNullOrEmpty(TenantState.TenantCode))
        {
            client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
        }
        if (!string.IsNullOrEmpty(TenantState.AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
        }
        return client;
    }

    private async Task OnPatientSearchInput(ChangeEventArgs e)
    {
        patientSearchQuery = e.Value?.ToString() ?? "";
        activePatientIndex = -1;

        _patientSearchCts?.Cancel();
        _patientSearchCts = new System.Threading.CancellationTokenSource();
        var token = _patientSearchCts.Token;

        if (string.IsNullOrWhiteSpace(patientSearchQuery))
        {
            searchedPatients.Clear();
            showPatientDropdown = false;
            activePatientIndex = -1;
            histFilter.custid = null;
            await RunHistoryFilter();
            StateHasChanged();
            return;
        }

        try
        {
            await Task.Delay(250, token);

            using var client = CreateClient(false);
            var response = await client.GetAsync($"api/OpRegistration/customers-with-op?key={Uri.EscapeDataString(patientSearchQuery)}", token);

            if (token.IsCancellationRequested) return;

            if (response.IsSuccessStatusCode)
            {
                var rawJson = await response.Content.ReadAsStringAsync(token);
                if (token.IsCancellationRequested) return;

                var settings = new Newtonsoft.Json.JsonSerializerSettings 
                { 
                    NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore 
                };
                var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.CustomerWithOpModel>>(rawJson, settings) ?? new();
                searchedPatients = list.Take(10).ToList();
                showPatientDropdown = searchedPatients.Count > 0;
                activePatientIndex = -1;
            }
            else
            {
                searchedPatients.Clear();
                showPatientDropdown = false;
                activePatientIndex = -1;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error searching patients: {ex.Message}");
            searchedPatients.Clear();
            showPatientDropdown = false;
            activePatientIndex = -1;
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void OnPatientSearchKeyDown(KeyboardEventArgs e)
    {
        if (!showPatientDropdown || searchedPatients.Count == 0) return;

        if (e.Key == "ArrowDown")
        {
            if (activePatientIndex < searchedPatients.Count - 1)
            {
                activePatientIndex++;
            }
            else
            {
                activePatientIndex = 0;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            if (activePatientIndex > 0)
            {
                activePatientIndex--;
            }
            else
            {
                activePatientIndex = searchedPatients.Count - 1;
            }
        }
        else if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            if (activePatientIndex >= 0 && activePatientIndex < searchedPatients.Count)
            {
                _ = SelectCustomerPatient(searchedPatients[activePatientIndex]);
                activePatientIndex = -1;
            }
        }
        else if (e.Key == "Escape")
        {
            showPatientDropdown = false;
            activePatientIndex = -1;
        }
    }

    private async Task SelectCustomerPatient(Booking.Models.CustomerWithOpModel pat)
    {
        histFilter.custid = pat.custid;
        patientSearchQuery = $"{pat.name} (CUST-{pat.custid})";
        showPatientDropdown = false;
        activePatientIndex = -1;
        await RunHistoryFilter();
    }
}
