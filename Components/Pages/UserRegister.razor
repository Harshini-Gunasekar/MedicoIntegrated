@page "/user-register"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using LIMS_Backend.Model
@using LabCare.Services
@using System.Net.Http.Json
@using System.Linq

@inject UserService UserService
@inject NavigationManager NavigationManager
@inject Booking.Services.ToastService Toast

<div class="register-page-container">
    <div class="register-card">
        <div class="register-header">
            <h2 class="brand-title">Medico <span class="brand-highlight">Portal</span></h2>
            <h3 class="page-title">Staff Registration</h3>
        </div>



        <div class="registration-form-grid">
            <!-- Tenant Code -->
            <div class="form-group">
                <label class="form-label">Tenant Code <span class="text-danger">*</span></label>
                <input type="text" class="custom-input" @bind="user.tenant_code" placeholder="e.g. LAB01" />
                @if (showValidation && string.IsNullOrWhiteSpace(user.tenant_code))
                {
                    <span class="validation-error">Tenant Code is required</span>
                }
            </div>

            <!-- Description -->
            <div class="form-group">
                <label class="form-label">Description <span class="text-danger">*</span></label>
                <input type="text" class="custom-input" @bind="user.description" placeholder="e.g. Marketing employ" />
                @if (showValidation && string.IsNullOrWhiteSpace(user.description))
                {
                    <span class="validation-error">Description is required</span>
                }
            </div>

            <!-- Full Name -->
            <div class="form-group">
                <label class="form-label">Full Name <span class="text-danger">*</span></label>
                <input type="text" class="custom-input" @bind="user.name" placeholder="e.g. Alice Johnson" />
                @if (showValidation && string.IsNullOrWhiteSpace(user.name))
                {
                    <span class="validation-error">Full Name is required</span>
                }
            </div>

            <!-- Short Name -->
            <div class="form-group">
                <label class="form-label">Short Name <span class="text-danger">*</span></label>
                <input type="text" class="custom-input" @bind="user.short_name" placeholder="e.g. ALC" maxlength="10" />
                @if (showValidation && string.IsNullOrWhiteSpace(user.short_name))
                {
                    <span class="validation-error">Short Name is required</span>
                }
            </div>

            <!-- Mobile -->
            <div class="form-group">
                <label class="form-label">Mobile <span class="text-danger">*</span></label>
                <input type="tel" class="custom-input" @bind="user.mobile" placeholder="10-digit number" maxlength="15" />
                @if (showValidation)
                {
                    if (string.IsNullOrWhiteSpace(user.mobile))
                    {
                        <span class="validation-error">Mobile number is required</span>
                    }
                    else if (!IsValidMobile(user.mobile))
                    {
                        <span class="validation-error">Must be a 10-digit number</span>
                    }
                }
            </div>

            <!-- Email -->
            <div class="form-group">
                <label class="form-label">Email <span class="text-danger">*</span></label>
                <input type="email" class="custom-input" @bind="user.email" placeholder="user@lab.com" />
                @if (showValidation)
                {
                    if (string.IsNullOrWhiteSpace(user.email))
                    {
                        <span class="validation-error">Email is required</span>
                    }
                    else if (!IsValidEmail(user.email))
                    {
                        <span class="validation-error">Enter a valid email address</span>
                    }
                }
            </div>

            <!-- Address (Full Width) -->
            <div class="form-group full-width">
                <label class="form-label">Address</label>
                <input type="text" class="custom-input" @bind="user.address" placeholder="Office address" />
            </div>

            <!-- Password (Full Width) -->
            <div class="form-group full-width">
                <label class="form-label">Password <span class="text-danger">*</span></label>
                <div class="password-input-wrapper">
                    <input type="@passwordInputType" class="custom-input" @bind="user.password" placeholder="Min 6 characters" />
                    <button type="button" class="btn-eye" @onclick="TogglePasswordVisibility">
                        @if (showPassword)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye-off"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                        }
                    </button>
                </div>
                @if (showValidation)
                {
                    if (string.IsNullOrWhiteSpace(user.password))
                    {
                        <span class="validation-error">Password is required</span>
                    }
                    else if (user.password.Length < 6)
                    {
                        <span class="validation-error">Password must be at least 6 characters</span>
                    }
                }
            </div>
        </div>

        <button class="btn-register" @onclick="HandleRegister" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true" style="width: 1rem; height: 1rem; border: 0.15em solid currentColor; border-right-color: transparent; border-radius: 50%; display: inline-block; animation: spinner-border .75s linear infinite; margin-right: 8px;"></span>
            }
            Register
        </button>

        <div class="register-footer-links">
            <p class="login-link-text">Already have a staff account? <a href="/user-login" class="login-link">Login here</a></p>
        </div>
    </div>

    <div class="page-footer">
        <span>© LabCare</span>
        <a href="#">Contact</a>
        <a href="#">Privacy & terms</a>
    </div>
</div>

<style>
    @@keyframes spinner-border {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private user_master user = new user_master
    {
        user_code = 1,
        deleted = false
    };

    private string? errorMessage;
    private bool isLoading;
    private bool showValidation;
    private bool showPassword;
    private string passwordInputType => showPassword ? "text" : "password";

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }

    private bool IsValidMobile(string mobile)
    {
        if (string.IsNullOrWhiteSpace(mobile)) return false;
        // Check if digits only and exactly 10 characters
        return mobile.Length == 10 && mobile.All(char.IsDigit);
    }

    private async Task HandleRegister()
    {
        showValidation = true;
        errorMessage = null;

        // Perform validation checks
        if (string.IsNullOrWhiteSpace(user.tenant_code) ||
            string.IsNullOrWhiteSpace(user.name) ||
            string.IsNullOrWhiteSpace(user.short_name) ||
            string.IsNullOrWhiteSpace(user.mobile) || !IsValidMobile(user.mobile) ||
            string.IsNullOrWhiteSpace(user.email) || !IsValidEmail(user.email) ||
            string.IsNullOrWhiteSpace(user.description) ||
            string.IsNullOrWhiteSpace(user.password) || user.password.Length < 6)
        {
            Toast.ShowError("Please fill in all required fields correctly.");
            return;
        }

        isLoading = true;

        try
        {
            // Sync current and permanent addresses as in UserMaster.razor
            user.permanent_address = user.address;
            user.current_address = user.address;

            // Submit register request to /api/user/register via the UserService
            var response = await UserService.RegisterAsync(user, isAnonymousRegister: true);

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Staff registered successfully!");
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/user-login");
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[UserRegister] Error response: {content}");
                errorMessage = string.IsNullOrEmpty(content) 
                    ? $"Registration failed (Status code: {response.StatusCode})." 
                    : content;
                Toast.ShowError(errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred during registration: {ex.Message}";
            Toast.ShowError(errorMessage);
            Console.Error.WriteLine($"[UserRegister] Exception: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
