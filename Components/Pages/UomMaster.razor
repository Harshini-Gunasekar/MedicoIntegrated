@page "/uoms"
@page "/uom-master"
@page "/unit-master"
@rendermode InteractiveServer

@using Booking.Models
@using Booking.Services
@inject UomMasterService UomService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">list_alt</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Unit Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Classification Inventory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search units..." @bind="SearchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewUnit">+ Add New</button>
            </div>
        </div>
    </div>

    @* --- directory list --- *@
    <div class="directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">ORDER NO</th>
                        <th style="width: 150px;">SHORT NAME</th>
                        <th>UNIT NAME</th>
                        <th style="width: 150px;">DECIMAL PLACES</th>
                        <th style="width: 120px;">PACK SIZE</th>
                        <th>DESCRIPTION</th>
                        <th style="width: 180px;">ENTERED DATE</th>
                        <th style="width: 180px;">MODIFIED DATE</th>
                        <th class="text-center" style="width: 120px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (units != null && units.Any())
                    {
                        @foreach (var u in FilteredUnitsBySearch)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"{u.orderno:00}")</span></td>
                                <td class="lc-color-slate-500 lc-font-mono lc-font-700 lc-font-13">@u.shortname</td>
                                <td class="font-bold text-slate-800">@u.name</td>
                                <td><span class="lc-color-slate-600">@(u.decimalplaces?.ToString() ?? "0")</span></td>
                                <td><span class="lc-color-slate-600">@(u.packsize?.ToString() ?? "1")</span></td>
                                <td class="text-slate-500">@u.description</td>
                                <td class="text-slate-400 font-12">@(u.entereddate != default ? u.entereddate.ToString("dd-MM-yyyy hh:mm tt") : "")</td>
                                <td class="text-slate-400 font-12">@(u.ibsdate != default ? u.ibsdate.ToString("dd-MM-yyyy hh:mm tt") : "")</td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px;">
                                        <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => EditUnit(u)" title="Edit">
                                            <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                        </button>
                                        <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => DeleteUnit(u.ucode)" title="Delete">
                                            <span class="material-symbols-outlined font-18 text-slate-400">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center p-48 text-slate-400 italic">No unit records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- FORM SECTION (Modal) --- *@
@if (showForm)
{
    <div class="modal-overlay">
        <div class="modal-form-card">
            <div class="modal-header-bar">
                <h3>@(isEditMode ? "Edit Unit" : "New Unit Entry")</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-0 form-section">
                    <div class="mt-0">
                        @* Line 1: Unit Name *@
                        <div class="um-grid-row">
                            <div class="form-group position-relative">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label style="margin-bottom: 0;">Unit name *</label>
                                    @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                    {
                                        <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                    }
                                </div>
                                <input type="text" class="lab-input" @bind="current.name" placeholder="E.g. Mg/dl" required />
                            </div>
                        </div>

                        @* Line 2: Order no, Short Name, Decimal Places *@
                        <div class="um-grid-cols-3">
                            <div class="form-group">
                                <label>Order no</label>
                                <input type="number" class="lab-input" @bind="current.orderno" />
                            </div>
                            <div class="form-group">
                                <label>Short Name</label>
                                <input type="text" class="lab-input" @bind="current.shortname" />
                            </div>
                            <div class="form-group">
                                <label>Decimal Places</label>
                                <input type="number" class="lab-input" @bind="current.decimalplaces" />
                            </div>
                        </div>

                        @* Line 3: Pack Size, Narration / Description *@
                        <div class="um-grid-cols-2">
                            <div class="form-group">
                                <label>Pack Size</label>
                                <input type="number" class="lab-input" @bind="current.packsize" />
                            </div>
                            <div class="form-group">
                                <label>Narration / Description</label>
                                <input type="text" class="lab-input" @bind="current.description" placeholder="Optional notes..." />
                            </div>
                        </div>

                        @* Line 4: Special Symbols Keyboard Helper Panel *@
                        <div class="symbols-card">
                            <div class="symbols-header">
                                <span class="material-symbols-outlined symbols-header-icon">keyboard</span>
                                <span>Special Symbols</span>
                                <span class="symbols-subtitle">(Click to insert into Unit Name)</span>
                            </div>
                            <div class="symbols-grid">
                                <div class="symbols-row">
                                    @foreach (var sym in row1Symbols)
                                    {
                                        <button type="button" class="symbol-btn" @onclick="() => AppendSymbol(sym)">@sym</button>
                                    }
                                </div>
                                <div style="margin-top: 4px;" class="symbols-row">
                                    @foreach (var sym in row2Symbols)
                                    {
                                        <button type="button" class="symbol-btn" @onclick="() => AppendSymbol(sym)">@sym</button>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            
            <div class="modal-footer-bar">
                <button type="button"
                        class="btn-delete"
                        @onclick="() => DeleteUnit(current.ucode)"
                        disabled="@(current.ucode == 0)">
                    Delete
                </button>
                <button type="button" class="btn-save" @onclick="SaveUnit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                    </svg>
                    Save Unit
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Booking.Models.UomMasterModel> units = new();
    private Booking.Models.UomMasterModel current = new();
    private bool isEditMode = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";

    private readonly string[] row1Symbols = { "μ", "α", "β", "γ", "±", "°C", "⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹", "₀", "₁", "₂" };
    private readonly string[] row2Symbols = { "₃", "₄", "₅", "₆", "₇", "₈", "₉", "⁺", "⁻", "⁻¹" };

    private IEnumerable<Booking.Models.UomMasterModel> FilteredUnits =>
        units.Where(u => !u.deleted);

    private IEnumerable<Booking.Models.UomMasterModel> FilteredUnitsBySearch =>
        FilteredUnits.Where(u => 
            string.IsNullOrWhiteSpace(SearchQuery) || 
            (u.name != null && u.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (u.shortname != null && u.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (u.description != null && u.description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadUnits();
    }

    private async Task LoadUnits()
    {
        try
        {
            units = await UomService.GetUomMastersAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading units: {ex.Message}");
        }
    }

    private void NewUnit()
    {
        current = new Booking.Models.UomMasterModel { 
            deleted = false,
            computercode = 1,
            usercode = 1,
            entereddate = DateTime.Now,
            ibsdate = DateTime.Now,
            orderno = units.Count + 1,
            tenant_code = "TEN007",
            decimalplaces = 0,
            packsize = 1
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private void EditUnit(Booking.Models.UomMasterModel u)
    {
        if (u == null) return;
        current = new Booking.Models.UomMasterModel
        {
            ucode = u.ucode,
            tenant_code = u.tenant_code,
            orderno = u.orderno,
            shortname = u.shortname,
            name = u.name,
            decimalplaces = u.decimalplaces,
            description = u.description,
            deleted = u.deleted,
            usercode = u.usercode,
            computercode = u.computercode,
            entereddate = u.entereddate,
            ibsdate = u.ibsdate,
            packsize = u.packsize
        };
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private void AppendSymbol(string symbol)
    {
        if (current.name == null)
        {
            current.name = "";
        }
        current.name += symbol;
        StateHasChanged();
    }

    private async Task SaveUnit()
    {
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(current.name))
        {
            ToastService.ShowError("Unit Name is required.");
            StateHasChanged();
            return;
        }

        try
        {
            current.tenant_code = "TEN007";
            current.computercode = 1;
            current.usercode = 1;
            current.ibsdate = DateTime.Now;

            bool success;
            if (isEditMode)
            {
                success = await UomService.UpdateUomMasterAsync(current);
            }
            else
            {
                current.entereddate = DateTime.Now;
                success = await UomService.InsertUomMasterAsync(current);
            }

            if (success)
            {
                await LoadUnits();
                ToastService.ShowSuccess(isEditMode ? "Unit updated successfully!" : "Unit added successfully!");
                showForm = false;
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Save failed on backend.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving unit: {ex.Message}");
            StateHasChanged();
        }
    }

    private async Task DeleteUnit(decimal ucode)
    {
        if (ucode == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this unit?"))
        {
            try
            {
                bool success = await UomService.DeleteUomMasterAsync(ucode);
                if (success)
                {
                    await LoadUnits();
                    ToastService.ShowSuccess("Unit deleted successfully!");
                    if (current != null && current.ucode == ucode)
                    {
                        showForm = false;
                    }
                    StateHasChanged();
                }
                else
                {
                    ToastService.ShowError("Delete failed on backend.");
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error deleting: {ex.Message}");
                StateHasChanged();
            }
        }
    }

    private void CloseForm()
    {
        current = new Booking.Models.UomMasterModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }
}
