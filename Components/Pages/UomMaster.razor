@page "/uommaster"
@page "/units"
@page "/unitmaster"
@using Booking.Models
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.NotificationService NotificationService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject Booking.Services.ToastService ToastService
<div class="items-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 20H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2z" />
                            <path d="M6 4v4" />
                            <path d="M10 4v8" />
                            <path d="M14 4v4" />
                            <path d="M18 4v4" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Unit Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total units : @UomsList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by unit name or short name..." @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    @if (hasCreateRight)
                    {
                        <button class="add-item-btn" @onclick="AddNewUom">
                            <i class="bi bi-plus-lg"></i>
                            <span class="ms-1">Add Unit</span>
                        </button>
                    }
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredUoms.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        No units found. Create a new unit of measure.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 100px; text-align: center;">ORDER NO</th>
                                    <th style="width: 120px; text-align: center;">SHORT NAME</th>
                                    <th style="width: 20%; text-align: center;">UNIT NAME</th>
                                    <th style="width: 28%; text-align: center;">NARRATION</th>
                                    <th style="width: 18%; text-align: center;">ENTERED DATE</th>
                                    <th style="width: 18%; text-align: center;">MODIFIED DATE</th>
                                    <th style="width: 100px; text-align: center;">ACTIONS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var uom in PagedUoms)
                                {
                                    <tr>
                                        <td style="text-align: center; font-weight: 700; color: #3b82f6;">@uom.orderno.ToString("D2")</td>
                                        <td style="text-align: center; font-weight: 700; color: #0f172a;">@uom.shortname</td>
                                        <td style="text-align: center; font-weight: 700; color: #0f172a;">@uom.name</td>
                                        <td style="text-align: center; color: #475569; font-weight: 500;">@(string.IsNullOrWhiteSpace(uom.description) ? "N/A" : uom.description)</td>
                                        <td style="text-align: center; color: #475569; font-weight: 500; font-size: 0.78rem;">@(uom.entereddate?.ToString("MM-dd-yyyy hh:mm tt") ?? "-")</td>
                                        <td style="text-align: center; color: #475569; font-weight: 500; font-size: 0.78rem;">@(uom.ibsdate?.ToString("MM-dd-yyyy hh:mm tt") ?? "-")</td>
                                        <td style="text-align: center;">
                                            @if (OnSelect.HasDelegate)
                                            {
                                                <button class="action-btn btn-edit" style="width: auto !important; padding: 0 12px !important; display: inline-flex; align-items: center; gap: 4px;" @onclick="() => OnSelect.InvokeAsync(uom.ucode)" title="Select"><i class="bi bi-check2-circle"></i> Select</button>
                                            }
                                            @if (hasEditRight)
                                            {
                                                <button class="action-btn btn-edit" @onclick="() => EditUom(uom)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            }
                                            @if (hasDeleteRight)
                                            {
                                                <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(uom)" title="Delete"><i class="bi bi-trash"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var uom in PagedUoms)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span>#@uom.orderno.ToString("D2") - @uom.name</span>
                                    <div>
                                        @if (OnSelect.HasDelegate)
                                        {
                                            <button class="action-btn btn-edit" style="width: auto !important; padding: 0 12px !important; display: inline-flex; align-items: center; gap: 4px;" @onclick="() => OnSelect.InvokeAsync(uom.ucode)" title="Select"><i class="bi bi-check2-circle"></i> Select</button>
                                        }
                                        @if (hasEditRight)
                                        {
                                            <button class="action-btn btn-edit" @onclick="() => EditUom(uom)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(uom)" title="Delete"><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Short Name</span><strong>@uom.shortname</strong></div>
                                    <div class="detail-row"><span>Narration</span><strong>@uom.description</strong></div>
                                    <div class="detail-row"><span>Decimal Places</span><strong>@uom.decimalplaces</strong></div>
                                    <div class="detail-row"><span>Pack Size</span><strong>@uom.packsize</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredUoms.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * PageSize) + 1)</strong> to <strong>@(Math.Min(CurrentPage * PageSize, FilteredUoms.Count()))</strong> of <strong>@FilteredUoms.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
@if (ShowUomModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 800px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #1e293b !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEditMode ? "Edit Unit" : "Add Unit")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseUomModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentUom" OnValidSubmit="SaveUom" autocomplete="off">
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 0 10px 20px 0;">
                        <div class="form-section-header">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Unit Information</div>
                        </div>

                        <div class="form-grid" style="display: flex; flex-direction: column; gap: 16px;">
                            <!-- Line 1: Unit Name, Short Name, Order No -->
                            <div style="display: flex; align-items: flex-start; gap: 16px; width: 100%;">
                                <div class="field-group" style="flex: 1.8;">
                                    <label class="field-label">Unit Name *</label>
                                    <InputText class="form-control premium-input" @bind-Value="CurrentUom.name" @onfocus='() => activeField = "name"' placeholder="E.g. Milligram" />
                                </div>
                                <div class="field-group" style="flex: 1.2;">
                                    <label class="field-label">Short Name</label>
                                    <InputText class="form-control premium-input" @bind-Value="CurrentUom.shortname" @onfocus='() => activeField = "shortname"' placeholder="e.g. mg" />
                                </div>
                                <div class="field-group" style="flex: 1;">
                                    <label class="field-label">Order No</label>
                                    <InputNumber class="form-control premium-input" @bind-Value="OrderNoInput" placeholder="0" />
                                </div>
                            </div>

                            <!-- Line 2: Decimal Places, Pack Size, Description -->
                            <div style="display: flex; align-items: flex-start; gap: 16px; width: 100%;">
                                <div class="field-group" style="flex: 1;">
                                    <label class="field-label">Decimal Places</label>
                                    <InputNumber class="form-control premium-input" @bind-Value="CurrentUom.decimalplaces" />
                                </div>
                                <div class="field-group" style="flex: 1;">
                                    <label class="field-label">Pack Size</label>
                                    <InputNumber class="form-control premium-input" @bind-Value="PackSizeInput" placeholder="1" />
                                </div>
                                <div class="field-group" style="flex: 2;">
                                    <label class="field-label">Description</label>
                                    <InputText class="form-control premium-input" @bind-Value="CurrentUom.description" placeholder="Optional notes..." />
                                </div>
                            </div>

                            <!-- Line 3: Special Symbols -->
                            <div class="uom-symbols-section" style="border: 1px dashed #cbd5e1; padding: 14px; border-radius: 12px; background-color: #f8fafc; margin-top: 4px;">
                                <div class="symbols-header" style="margin-bottom: 10px; display: flex; align-items: center;">
                                    <i class="bi bi-keyboard" style="margin-right: 10px; font-size: 1.1rem; color: #4f46e5;"></i>
                                    <span style="font-weight: 700; color: #334155; font-size: 0.85rem;">Special Symbols</span>
                                    <span class="symbols-hint" style="margin-left: 8px; font-size: 0.75rem; color: #64748b;">(Click to insert into @(activeField == "shortname" ? "Short Name" : "Unit Name"))</span>
                                </div>
                                <div class="symbols-grid">
                                    @foreach (var symbol in SpecialSymbols)
                                    {
                                        <button type="button" class="symbol-btn" @onclick="() => InsertSymbol(symbol)">@symbol</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-actions">
                        <button type="button" class="btn-cancel-modal" @onclick="CloseUomModal">Cancel</button>
                        <button type="submit" class="btn-save-premium" disabled="@IsSaving">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                            }
                            <span>@(IsEditMode ? "Update Unit" : "Save Unit")</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation -->
@if (ShowDeletePopup)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeletePopup = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Unit</div>
            <div class="action-popup-body">Are you sure you want to delete this unit?</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowDeletePopup = false">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}


@code {
    /// <summary>When set, renders a Select button on each row so the component can be embedded inside TestMaster (or any picker modal).</summary>
    [Parameter] public EventCallback<decimal> OnSelect { get; set; }

    private List<uom_master> UomsList = new();
    private string SearchQuery = string.Empty;
    private bool IsLoading;
    private bool IsSaving;
    private bool ShowUomModal;
    private bool IsEditMode;
    private bool ShowDeletePopup;
    private bool IsCardView = false;
    private uom_master CurrentUom = new();

    private int? OrderNoInput
    {
        get => !IsEditMode && CurrentUom.orderno == UomsList.Count + 1 ? null : CurrentUom.orderno;
        set => CurrentUom.orderno = value ?? (UomsList.Count + 1);
    }

    private int? PackSizeInput
    {
        get => !IsEditMode && CurrentUom.packsize == 1 ? null : CurrentUom.packsize;
        set => CurrentUom.packsize = value ?? 1;
    }
    private uom_master? PendingDeleteUom;
    private string activeField = "name";

    private string DefaultTenantCode = "";

    private void SetView(bool cardView)
    {
        IsCardView = cardView;
        CurrentPage = 1;
    }

    private string[] SpecialSymbols = new[] {
        // Row 1: Common Scientific & Greek Symbols
        "μ", "α", "β", "γ", "±", "°C", "℧", "÷", "×",
        // Row 2: Superscripts
        "⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹", "⁺", "⁻", "⁼", "⁽", "⁾", "⁻¹",
        // Row 3: Subscripts
        "₀", "₁", "₂", "₃", "₄", "₅", "₆", "₇", "₈", "₉", "₊", "₋", "₌", "₍", "₎", "ₓ", "ᵢ"
    };

    private IEnumerable<uom_master> FilteredUoms =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? UomsList
            : UomsList.Where(u => 
                (u.name?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.shortname?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    // Pagination
    private int CurrentPage = 1;
    private int PageSize => IsCardView ? 6 : 12;
    private int TotalPages => (int)Math.Ceiling((double)FilteredUoms.Count() / PageSize);
    private IEnumerable<uom_master> PagedUoms => FilteredUoms.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private bool hasViewRight = true;
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
            
            try
            {
                bool isAdmin = false;
                try
                {
                    var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userResult.Success && userResult.Value != null)
                    {
                        isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                  userResult.Value.UserCode == 0 ||
                                  userResult.Value.UserCode == 1;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking user details: {ex.Message}");
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                    hasEditRight = true;
                    hasDeleteRight = true;
                }
                else
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var pageRight = rightsResult.Value.FirstOrDefault(r => 
                            r.ModuleName != null && 
                            r.ModuleName.Trim().Equals("Unit_Master", StringComparison.OrdinalIgnoreCase));
                        
                        if (pageRight != null)
                        {
                            hasViewRight = pageRight.ToView;
                            hasCreateRight = pageRight.ToAdd;
                            hasEditRight = pageRight.ToEdit;
                            hasDeleteRight = pageRight.ToDelete;
                        }
                        else
                        {
                            hasViewRight = false;
                            hasCreateRight = false;
                            hasEditRight = false;
                            hasDeleteRight = false;
                        }
                    }
                    else
                    {
                        hasViewRight = false;
                        hasCreateRight = false;
                        hasEditRight = false;
                        hasDeleteRight = false;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking Unit_Master rights: {ex.Message}");
                hasViewRight = false;
                hasCreateRight = false;
                hasEditRight = false;
                hasDeleteRight = false;
            }

            if (!hasViewRight)
            {
                ToastService.ShowError("You do not have permission to access Unit Master.");
                Nav.NavigateTo("/home");
                return;
            }
            
            await LoadUoms();
            StateHasChanged();
        }
    }

    private async Task LoadUoms()
    {
        IsLoading = true;
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getalluom");
            
            try
            {
                var direct = System.Text.Json.JsonSerializer.Deserialize<List<uom_master>>(response, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                UomsList = (direct ?? new List<uom_master>()).Where(x => x.deleted != true).OrderBy(x => x.orderno).ToList();
            }
            catch
            {
                var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<uom_master>>>(response, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                UomsList = (wrapped?.data ?? new List<uom_master>()).Where(x => x.deleted != true).OrderBy(x => x.orderno).ToList();
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error loading units: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("InventoryApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenantCode);
        return client;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        CurrentPage = 1;
    }

    private void AddNewUom()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add units.");
            return;
        }
        CurrentUom = new uom_master { tenant_code = DefaultTenantCode, deleted = false, packsize = 1, orderno = UomsList.Count + 1 };
        IsEditMode = false;
        ShowUomModal = true;
    }

    private void EditUom(uom_master uom)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit units.");
            return;
        }
        CurrentUom = new uom_master 
        { 
            ucode = uom.ucode,
            name = uom.name,
            shortname = uom.shortname,
            orderno = uom.orderno,
            description = uom.description,
            packsize = uom.packsize,
            decimalplaces = uom.decimalplaces,
            tenant_code = uom.tenant_code ?? DefaultTenantCode,
            deleted = uom.deleted
        };
        IsEditMode = true;
        ShowUomModal = true;
    }

    private void CloseUomModal()
    {
        ShowUomModal = false;
        IsSaving = false;
    }

    private void InsertSymbol(string symbol)
    {
        if (activeField == "shortname")
        {
            CurrentUom.shortname = (CurrentUom.shortname ?? "") + symbol;
        }
        else
        {
            CurrentUom.name = (CurrentUom.name ?? "") + symbol;
        }
    }

    private async Task SaveUom()
    {
        if (IsEditMode && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit units.");
            return;
        }
        if (!IsEditMode && !hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add units.");
            return;
        }
        if (string.IsNullOrWhiteSpace(CurrentUom.name))
        {
            NotificationService.ShowNotification("Unit Name is required", NotificationType.Warning);
            return;
        }

        IsSaving = true;
        try
        {
            var client = CreateClient();
            CurrentUom.tenant_code = DefaultTenantCode;
            
            HttpResponseMessage response;
            if (IsEditMode)
            {
                response = await client.PostAsJsonAsync("ItemMaster/updateuom", CurrentUom);
            }
            else
            {
                response = await client.PostAsJsonAsync("ItemMaster/insertuom", CurrentUom);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification(IsEditMode ? "Unit updated successfully" : "Unit added successfully", NotificationType.Success);
                ShowUomModal = false;
                await LoadUoms();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                NotificationService.ShowNotification($"Save failed: {err}", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error saving unit: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(uom_master uom)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete units.");
            return;
        }
        PendingDeleteUom = uom;
        ShowDeletePopup = true;
    }

    private async Task DeleteConfirmed()
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete units.");
            return;
        }
        if (PendingDeleteUom == null) return;

        try
        {
            var client = CreateClient();
            
            // Try multiple delete approaches
            var attempts = new Func<Task<HttpResponseMessage>>[]
            {
                () => client.GetAsync($"ItemMaster/deleteuom?ucode={PendingDeleteUom.ucode}"),
                () => client.DeleteAsync($"ItemMaster/deleteuom?ucode={PendingDeleteUom.ucode}"),
                () => client.PostAsJsonAsync("ItemMaster/deleteuom", new { ucode = PendingDeleteUom.ucode, tenant_code = DefaultTenantCode })
            };

            bool success = false;
            foreach(var attempt in attempts)
            {
                try {
                    var response = await attempt();
                    if (response.IsSuccessStatusCode) {
                        success = true;
                        break;
                    }
                } catch {}
            }

            if (success)
            {
                NotificationService.ShowNotification("Unit deleted successfully", NotificationType.Success);
                ShowDeletePopup = false;
                ShowUomModal = false;
                await LoadUoms();
            }
            else
            {
                NotificationService.ShowNotification("Delete failed", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error: {ex.Message}", NotificationType.Error);
        }
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }
}





