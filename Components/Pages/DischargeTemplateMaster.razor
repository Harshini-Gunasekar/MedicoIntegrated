@page "/summary-templates"
@using Booking.Services
@using medico_backend.Model
@using SharedComponents.Rcl.Components
@inject DischargeSummaryService DsService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject NavigationManager NavigationManager

<div class="referral-page lc-fadeInUp">
    
    @* STYLED MASTER HEADER CARD *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">clinical_notes</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Discharge Template Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Template Directory & Column Configurations</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search templates..." @bind="searchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            <div class="search-controls">
                @if (hasCreateRight)
                {
                    <button class="btn-new-entry" @onclick="OpenCreateTemplateModal">+ Add Template</button>
                }
            </div>
        </div>
    </div>

    @* MAIN TEMPLATES LIST *@
    <div class="directory-section">
        <div class="total-templates-indicator">
            Total Templates: <span class="text-indigo-600 font-bold">@GetFilteredTemplates().Count()</span>
        </div>
        
        @if (isLoading)
        {
            <div style="padding: 5rem 2rem; text-align: center;">
                <DnaLoader IsLoading="true" Overlay="false" Message="Loading Templates..." />
            </div>
        }
        else if (!GetFilteredTemplates().Any())
        {
            <div style="padding: 5rem 2rem; text-align: center;">
                <div style="background: #eff6ff; border: 1.5px solid #bfdbfe; width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem auto;">
                    <i class="bi bi-file-earmark-plus-fill" style="font-size: 2.2rem; color: #4f46e5;"></i>
                </div>
                <h4 style="font-weight: 800; color: #1e293b; margin-bottom: 0.5rem;">No Templates Found</h4>
                <p style="color: #64748b; font-size: 0.9rem; max-width: 480px; margin: 0 auto 1.5rem auto;">
                    Create your first Discharge Summary Template and add custom column headers with input types (Text / Input Grid) and default answers!
                </p>
                @if (hasCreateRight)
                {
                    <button type="button" class="btn-new-entry" @onclick="OpenCreateTemplateModal">+ Create First Template</button>
                }
            </div>
        }
        else
        {
            <div class="template-list-container">
                @foreach (var t in GetFilteredTemplates())
                {
                    <div class="template-card">
                        @* Left Side: Template Info & Column Pills *@
                        <div style="flex: 1; min-width: 320px; display: flex; align-items: center; gap: 1.25rem;">
                            <div class="template-avatar">
                                <i class="bi bi-journal-medical"></i>
                            </div>

                            <div style="display: flex; flex-direction: column; gap: 4px; flex: 1;">
                                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                    <h5 class="template-title">@t.TemplateName</h5>
                                    <span class="template-badge-count">
                                        @t.Columns.Count Column Header@(t.Columns.Count == 1 ? "" : "s")
                                    </span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(t.Description))
                                {
                                    <p class="template-desc">@t.Description</p>
                                }

                                @* Configured Column Header Tags inline *@
                                <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px;">
                                    @foreach (var col in t.Columns)
                                    {
                                        var badgeClass = col.InputType == "MEDICINE" ? "col-tag-medicine" : (col.InputType == "BOTH" ? "col-tag-both" : "col-tag-text");
                                        var typeLabel = col.InputType == "MEDICINE" ? "Input Grid" : (col.InputType == "BOTH" ? "Text + Input" : "Text");
                                        var typeIcon = col.InputType == "MEDICINE" ? "bi-capsule" : (col.InputType == "BOTH" ? "bi-layers-half" : "bi-file-text");

                                        <span class="col-tag @badgeClass">
                                            <i class="bi @typeIcon"></i> @col.ColumnHeaderName
                                            <span style="opacity: 0.75; font-size: 0.68rem; font-weight: 800;">(@typeLabel)</span>
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px; flex-shrink: 0;">
                            @if (hasEditRight)
                            {
                                <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => OpenEditTemplateModal(t)" title="Edit">
                                    <span class="material-symbols-outlined font-18 text-indigo-600">edit</span>
                                </button>
                            }
                            @if (hasDeleteRight)
                            {
                                <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => DeleteTemplateGroup(t)" title="Delete">
                                    <span class="material-symbols-outlined font-18 text-red-500">delete</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* --- COMPACT HIGH-DENSITY TEMPLATE BUILDER MODAL --- *@
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-form-card" style="max-width: 880px;" @onclick:stopPropagation>
            
            @* Modal Header Bar *@
            <div class="modal-header-bar">
                <h3>@(editingTemplateId.HasValue ? "Edit Discharge Summary Template" : "Create Discharge Summary Template")</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseModal" title="Close Dialog">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>

            @* Body *@
            <div class="modal-body">
                <div style="display: flex; flex-direction: column; gap: 1.1rem;">
                    
                    @* Template Compact Header Info Bar *@
                    <div style="background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; padding: 1rem; display: grid; grid-template-columns: 1.2fr 1fr; gap: 1rem; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="font-size: 0.72rem; font-weight: 700; color: #1e293b; margin-bottom: 3px; display: flex; align-items: center; gap: 6px;">
                                <i class="bi bi-journal-bookmark-fill" style="color: #4f46e5; font-size: 0.9rem;"></i> Template Name *
                            </label>
                            <input type="text" class="lab-input" style="font-weight: 700;"
                                   placeholder="e.g. Cholecystitis Standard Template / General Surgery" 
                                   @bind="editingModel.TemplateName" />
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="font-size: 0.72rem; font-weight: 700; color: #1e293b; margin-bottom: 3px; display: flex; align-items: center; gap: 6px;">
                                <i class="bi bi-text-paragraph" style="color: #6366f1; font-size: 0.9rem;"></i> Template Description (Optional)
                            </label>
                            <input type="text" class="lab-input"
                                   placeholder="e.g. Standard layout for cholecystitis cases" 
                                   @bind="editingModel.Description" />
                        </div>
                    </div>

                    @* Column Headers Section *@
                    <div style="background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; padding: 1rem; display: flex; flex-direction: column; gap: 0.85rem; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
                        
                        @* Section Title & Button *@
                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1.5px solid #f1f5f9; padding-bottom: 0.6rem;">
                            <div>
                                <span style="font-weight: 800; color: #1e293b; font-size: 0.88rem; display: flex; align-items: center; gap: 6px;">
                                    <i class="bi bi-layout-three-columns" style="color: #4f46e5; font-size: 0.95rem;"></i> Column Headers & Input Types (@editingModel.Columns.Count)
                                </span>
                                <span style="font-size: 0.75rem; color: #64748b;">Add column headers with input type (Text / Input Grid) and default answer</span>
                            </div>

                            <button type="button" class="btn-save" style="font-size: 0.8rem; padding: 6px 14px;" @onclick="AddColumnRow">
                                <i class="bi bi-plus-circle-fill" style="color: #ffffff; font-size: 0.85rem;"></i> Add Column Header
                            </button>
                        </div>

                        @if (!editingModel.Columns.Any())
                        {
                            <div style="text-align: center; padding: 2rem 0; color: #94a3b8;">
                                <i class="bi bi-plus-circle" style="font-size: 2rem; color: #4f46e5; display: block; margin-bottom: 0.4rem;"></i>
                                <div style="font-weight: 700; font-size: 0.88rem; color: #64748b;">No Column Headers Added Yet</div>
                                <p style="font-size: 0.78rem; margin-top: 2px; max-width: 340px; margin-left: auto; margin-right: auto; color: #94a3b8;">
                                    Click 'Add Column Header' to add custom column headers for this template.
                                </p>
                                <button type="button" class="btn-save" style="display: inline-flex;" @onclick="AddColumnRow">
                                    <i class="bi bi-plus-circle-fill" style="color: #ffffff;"></i> Add Column Header
                                </button>
                            </div>
                        }
                        else
                        {
                            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                                @{ int colIdx = 1; }
                                @foreach (var col in editingModel.Columns)
                                {
                                    <div style="background: #ffffff; border: 1px solid #cbd5e1; border-left: 4px solid #4f46e5; border-radius: 12px; padding: 0.75rem 1rem; display: flex; flex-direction: column; gap: 0.6rem; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
                                        
                                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.4rem;">
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                <span style="background: #eef2ff; color: #4f46e5; border-radius: 6px; padding: 1px 7px; font-size: 0.7rem; font-weight: 800; border: 1px solid #e0e7ff;">
                                                    Column Header #@(colIdx++)
                                                </span>
                                                <span style="color: #64748b; font-weight: 600; font-size: 0.75rem;">Header Configuration</span>
                                            </div>

                                            <button type="button" style="background: #fff1f2; color: #be123c; border: 1px solid #fecdd3; border-radius: 6px; font-size: 0.72rem; font-weight: 800; padding: 2px 8px; display: flex; align-items: center; gap: 4px; cursor: pointer;" @onclick="() => RemoveColumnRow(col)" title="Remove Column">
                                                <i class="bi bi-trash3-fill" style="color: #ef4444;"></i> Remove Column
                                            </button>
                                        </div>

                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;">
                                            <div class="form-group" style="margin-bottom: 0;">
                                                <label style="font-size: 0.72rem; font-weight: 700; color: #1e293b; margin-bottom: 3px; display: flex; align-items: center; gap: 6px;">
                                                    <i class="bi bi-fonts" style="color: #4f46e5; font-size: 0.85rem;"></i> Column Header Name *
                                                </label>
                                                <input type="text" class="lab-input" style="font-weight: 700;" 
                                                       placeholder="e.g. Doctor Description / Medications" 
                                                       @bind="col.ColumnHeaderName" />
                                            </div>
                                            <div class="form-group" style="margin-bottom: 0;">
                                                <label style="font-size: 0.72rem; font-weight: 700; color: #1e293b; margin-bottom: 3px; display: flex; align-items: center; gap: 6px;">
                                                    <i class="bi bi-ui-checks-grid" style="color: #6366f1; font-size: 0.85rem;"></i> Input Data Type *
                                                </label>
                                                <select class="lab-input" @bind="col.InputType">
                                                    <option value="TEXT">Free Text Answer</option>
                                                    <option value="MEDICINE">Input Grid (Prescription Search)</option>
                                                    <option value="BOTH">Both (Input Grid + Text Notes)</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="form-group" style="margin-bottom: 0;">
                                            <label style="font-size: 0.72rem; font-weight: 700; color: #475569; margin-bottom: 3px; display: flex; align-items: center; gap: 6px;">
                                                <i class="bi bi-chat-left-quote-fill" style="color: #10b981; font-size: 0.85rem;"></i> Default Answer Content (Optional)
                                            </label>
                                            <textarea class="lab-input" style="min-height: 48px; resize: vertical;" 
                                                      rows="2" 
                                                      placeholder="Type default answer content to pre-fill when this template is selected..." 
                                                      @bind="col.DefaultAnswer">
                                            </textarea>
                                        </div>

                                    </div>
                                }
                            </div>
                        }
                    </div>

                </div>
            </div>

            @* Modal Footer *@
            <div class="modal-footer-bar">
                <button type="button" class="btn-secondary-outline" @onclick="CloseModal">Cancel</button>
                <button type="button" class="btn-save" @onclick="SaveCompleteTemplate">Save Template & Columns</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string searchQuery = "";

    public class SummaryTemplateViewModel
    {
        public Guid TemplateId { get; set; } = Guid.NewGuid();
        public string TemplateName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public List<SummaryTemplateColumnModel> Columns { get; set; } = new();
    }

    public class SummaryTemplateColumnModel
    {
        public Guid CategoryId { get; set; } = Guid.NewGuid();
        public string ColumnHeaderName { get; set; } = string.Empty;
        public string InputType { get; set; } = "TEXT";
        public string DefaultAnswer { get; set; } = string.Empty;
    }

    private List<SummaryTemplateViewModel> templateGroups = new();

    private bool showModal = false;
    private Guid? editingTemplateId;
    private SummaryTemplateViewModel editingModel = new();
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    protected override async Task OnInitializedAsync()
    {
        await CleanDefaultDummyCategories();
        await LoadTemplatesData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
                try
                {
                    bool isAdmin = false;
                    try
                    {
                        var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                        if (userResult.Success && userResult.Value != null)
                        {
                            isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                      userResult.Value.UserCode == 0 ||
                                      userResult.Value.UserCode == 1;
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error checking user details: {ex.Message}");
                    }

                    if (isAdmin)
                    {
                        hasCreateRight = true;
                        hasEditRight = true;
                        hasDeleteRight = true;
                    }
                    else
                    {
                        var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                        if (rightsResult.Success && rightsResult.Value != null)
                        {
                            var pageRight = rightsResult.Value.FirstOrDefault(r => 
                                r.ModuleName != null && 
                                r.ModuleName.Trim().Equals("Summery_Templates", StringComparison.OrdinalIgnoreCase));
                            
                            if (pageRight != null)
                            {
                                hasCreateRight = pageRight.ToAdd;
                                hasEditRight = pageRight.ToEdit;
                                hasDeleteRight = pageRight.ToDelete;
                            }
                            else
                            {
                                hasCreateRight = false;
                                hasEditRight = false;
                                hasDeleteRight = false;
                            }
                        }
                        else
                        {
                            hasCreateRight = false;
                            hasEditRight = false;
                            hasDeleteRight = false;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking Summery_Templates rights: {ex.Message}");
                    hasCreateRight = false;
                    hasEditRight = false;
                    hasDeleteRight = false;
                }

            StateHasChanged();
        }
    }

    private async Task CleanDefaultDummyCategories()
    {
        try
        {
            var categories = await DsService.GetCategoriesAsync();
            var dummyNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            {
                "ADMISSION & ADMINISTRATION",
                "DOCTOR CONSULTATION & DIAGNOSIS",
                "ALLERGIES & DRUG SENSITIVITIES",
                "PHYSICAL & SYSTEMIC EXAMINATION",
                "INVESTIGATIONS & LAB RESULTS",
                "TREATMENT GIVEN & OPERATIVE NOTES",
                "ADVICE ON DISCHARGE",
                "FOLLOW UP PLAN",
                "CHIEF COMPLAINTS",
                "HISTORY OF PRESENT ILLNESS",
                "PHYSICAL EXAMINATION",
                "FOLLOW UP"
            };

            foreach (var cat in categories)
            {
                if (dummyNames.Contains(cat.category_name.Trim()))
                {
                    await DsService.DeleteCategoryAsync(cat.category_id);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Cleanup error: {ex.Message}");
        }
    }

    private async Task LoadTemplatesData()
    {
        isLoading = true;
        try
        {
            var categories = await DsService.GetCategoriesAsync();
            var presets = await DsService.GetTemplatesAsync(null);

            templateGroups.Clear();

            var presetGroups = presets.Where(p => !string.IsNullOrWhiteSpace(p.template_name))
                                      .GroupBy(p => p.template_name.Trim())
                                      .ToList();

            foreach (var g in presetGroups)
            {
                var vm = new SummaryTemplateViewModel
                {
                    TemplateId = g.First().template_id,
                    TemplateName = g.Key,
                    Description = $"Template with {g.Count()} column header(s)"
                };

                foreach (var item in g)
                {
                    var cat = categories.FirstOrDefault(c => c.category_id == item.category_id)
                           ?? categories.FirstOrDefault(c => c.category_name != null && c.category_name.Trim().Equals(item.category_name.Trim(), StringComparison.OrdinalIgnoreCase));

                    vm.Columns.Add(new SummaryTemplateColumnModel
                    {
                        CategoryId = cat?.category_id ?? item.category_id,
                        ColumnHeaderName = item.category_name,
                        InputType = cat?.category_type ?? "TEXT",
                        DefaultAnswer = item.template_text ?? ""
                    });
                }

                templateGroups.Add(vm);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading templates: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<SummaryTemplateViewModel> GetFilteredTemplates()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return templateGroups;
        var q = searchQuery.Trim().ToLower();
        return templateGroups.Where(t => t.TemplateName.ToLower().Contains(q) 
            || (t.Description != null && t.Description.ToLower().Contains(q))
            || t.Columns.Any(s => s.ColumnHeaderName.ToLower().Contains(q)));
    }

    private void OpenCreateTemplateModal()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add templates.");
            return;
        }
        editingTemplateId = null;
        editingModel = new SummaryTemplateViewModel
        {
            TemplateName = "",
            Description = "",
            Columns = new List<SummaryTemplateColumnModel>()
        };
        AddColumnRow();
        showModal = true;
    }

    private void OpenEditTemplateModal(SummaryTemplateViewModel vm)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit templates.");
            return;
        }
        editingTemplateId = vm.TemplateId;
        editingModel = new SummaryTemplateViewModel
        {
            TemplateId = vm.TemplateId,
            TemplateName = vm.TemplateName,
            Description = vm.Description,
            Columns = vm.Columns.Select(s => new SummaryTemplateColumnModel
            {
                CategoryId = s.CategoryId,
                ColumnHeaderName = s.ColumnHeaderName,
                InputType = s.InputType,
                DefaultAnswer = s.DefaultAnswer
            }).ToList()
        };
        showModal = true;
    }

    private void AddColumnRow()
    {
        editingModel.Columns.Add(new SummaryTemplateColumnModel
        {
            ColumnHeaderName = "",
            InputType = "TEXT",
            DefaultAnswer = ""
        });
    }

    private void RemoveColumnRow(SummaryTemplateColumnModel col)
    {
        editingModel.Columns.Remove(col);
    }

    private async Task SaveCompleteTemplate()
    {
        if (editingTemplateId.HasValue && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit templates.");
            return;
        }
        if (!editingTemplateId.HasValue && !hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add templates.");
            return;
        }
        if (string.IsNullOrWhiteSpace(editingModel.TemplateName))
        {
            ToastService.ShowWarning("Please enter a template name.");
            return;
        }

        if (!editingModel.Columns.Any(s => !string.IsNullOrWhiteSpace(s.ColumnHeaderName)))
        {
            ToastService.ShowWarning("Please add at least one column header.");
            return;
        }

        try
        {
            int sortOrder = 1;
            foreach (var col in editingModel.Columns.Where(s => !string.IsNullOrWhiteSpace(s.ColumnHeaderName)))
            {
                var catId = await DsService.SaveCategoryAsync(new DischargeSummaryService.DsCategoryDto
                {
                    category_id = col.CategoryId != Guid.Empty ? col.CategoryId : Guid.Empty,
                    category_name = col.ColumnHeaderName.Trim(),
                    category_type = col.InputType,
                    sort_order = sortOrder++
                });

                if (catId.HasValue)
                {
                    await DsService.SaveTemplateAsync(new DischargeSummaryService.DsTemplateDto
                    {
                        category_id = catId.Value,
                        category_name = col.ColumnHeaderName.Trim(),
                        template_name = editingModel.TemplateName.Trim(),
                        template_text = col.DefaultAnswer?.Trim() ?? ""
                    });
                }
            }

            ToastService.ShowSuccess($"Saved Template '{editingModel.TemplateName}' with {editingModel.Columns.Count} column headers!");
            showModal = false;
            await LoadTemplatesData();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Save error: {ex.Message}");
        }
    }

    private async Task DeleteTemplateGroup(SummaryTemplateViewModel vm)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete templates.");
            return;
        }
        try
        {
            foreach (var col in vm.Columns)
            {
                await DsService.DeleteCategoryAsync(col.CategoryId);
            }

            var presets = await DsService.GetTemplatesAsync(null);
            var matching = presets.Where(p => p.template_name != null && p.template_name.Trim().Equals(vm.TemplateName.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
            foreach (var m in matching)
            {
                await DsService.DeleteTemplateAsync(m.template_id);
            }

            ToastService.ShowSuccess($"Deleted Template '{vm.TemplateName}'");
            await LoadTemplatesData();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Delete error: {ex.Message}");
        }
    }

    private void CloseModal()
    {
        showModal = false;
    }
}
