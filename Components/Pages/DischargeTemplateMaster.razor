@page "/summary-templates"
@using Booking.Services
@using medico_backend.Model
@inject DischargeSummaryService DsService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject NavigationManager NavigationManager

<div style="background: #f8fafc; min-height: 100vh; padding: 1.75rem 2rem; font-family: system-ui, -apple-system, sans-serif;">
    
    @* STYLED MASTER HEADER CARD *@
    <div style="background: #ffffff; border-radius: 16px; border: 1.5px solid #e2e8f0; padding: 1.25rem 1.75rem; box-shadow: 0 4px 16px rgba(0,0,0,0.03); margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; align-items: center; gap: 1.25rem;">
            <div style="background: #eff6ff; border: 1.5px solid #bfdbfe; width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center; color: #2563eb; font-size: 1.6rem; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);">
                <i class="bi bi-journal-medical" style="color: #2563eb;"></i>
            </div>
            <div>
                <h3 style="font-weight: 800; margin: 0; font-size: 1.35rem; color: #0f172a; letter-spacing: -0.01em;">Discharge Summary Template Master</h3>
                <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #22c55e; display: inline-block;"></span>
                    <span style="font-size: 0.82rem; color: #64748b; font-weight: 600;">Template Directory & Column Header Configurations</span>
                </div>
            </div>
        </div>

        @if (hasCreateRight)
        {
            <div style="display: flex; align-items: center; gap: 12px;">
                <button type="button" style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; font-weight: 800; border: none; border-radius: 10px; padding: 0.65rem 1.4rem; font-size: 0.88rem; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3); display: flex; align-items: center; gap: 6px; cursor: pointer;" @onclick="OpenCreateTemplateModal">
                    <i class="bi bi-plus-circle-fill" style="font-size: 0.95rem; color: #ffffff;"></i> Create New Template
                </button>
            </div>
        }
    </div>

    @* SEARCH TOOLBAR BAR *@
    <div style="background: #ffffff; border-radius: 14px; padding: 1rem 1.4rem; border: 1.5px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.02); margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div style="position: relative; flex: 1; max-width: 440px;">
            <i class="bi bi-search" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #2563eb; font-size: 0.95rem;"></i>
            <input type="text" style="width: 100%; box-sizing: border-box; padding: 0.6rem 1rem 0.6rem 2.5rem; border-radius: 10px; border: 1.5px solid #cbd5e1; font-size: 0.88rem; font-weight: 600; outline: none; background: #f8fafc; color: #0f172a;" 
                   placeholder="Search templates or column headers..." 
                   value="@searchQuery"
                   @oninput='(e) => searchQuery = e.Value?.ToString() ?? ""' />
        </div>

        <div style="font-size: 0.85rem; font-weight: 800; color: #64748b;">
            Total Templates: <span style="color: #2563eb; font-weight: 800;">@GetFilteredTemplates().Count()</span>
        </div>
    </div>

    @* MAIN TEMPLATES LIST *@
    @if (isLoading)
    {
        <div style="background: #ffffff; border-radius: 18px; border: 1.5px solid #e2e8f0; padding: 5rem 2rem; text-align: center;">
            <div class="spinner-border text-primary" style="width: 3.5rem; height: 3.5rem;" role="status"></div>
            <h5 style="margin-top: 1.25rem; color: #1e293b; font-weight: 800;">Loading Templates...</h5>
            <p style="color: #64748b; font-size: 0.88rem;">Fetching template configurations and column headers</p>
        </div>
    }
    else if (!GetFilteredTemplates().Any())
    {
        <div style="background: #ffffff; border-radius: 18px; border: 1.5px solid #e2e8f0; padding: 5rem 2rem; text-align: center; box-shadow: 0 4px 16px rgba(0,0,0,0.02);">
            <div style="background: #eff6ff; border: 1.5px solid #bfdbfe; width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem auto;">
                <i class="bi bi-file-earmark-plus-fill" style="font-size: 2.2rem; color: #2563eb;"></i>
            </div>
            <h4 style="font-weight: 800; color: #0f172a; margin-bottom: 0.5rem;">No Templates Found</h4>
            <p style="color: #64748b; font-size: 0.9rem; max-width: 480px; margin: 0 auto 1.5rem auto;">
                Create your first Discharge Summary Template and add custom column headers with input types (Text / Input Grid) and default answers!
            </p>
            @if (hasCreateRight)
            {
                <button type="button" style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; font-weight: 800; border: none; border-radius: 10px; padding: 0.7rem 1.6rem; font-size: 0.88rem; cursor: pointer; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3); display: inline-flex; align-items: center; gap: 6px;" @onclick="OpenCreateTemplateModal">
                    <i class="bi bi-plus-circle-fill" style="font-size: 0.95rem; color: #ffffff;"></i> Create First Template
                </button>
            }
        </div>
    }
    else
    {
        @* SINGLE ROW TEMPLATES LIST *@
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            @foreach (var t in GetFilteredTemplates())
            {
                <div style="background: #ffffff; border-radius: 16px; border: 1.5px solid #e2e8f0; padding: 1.25rem 1.5rem; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.02); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                    
                    @* Left Side: Template Info & Column Pills *@
                    <div style="flex: 1; min-width: 320px; display: flex; align-items: center; gap: 1.25rem;">
                        <div style="background: #eff6ff; border: 1.5px solid #bfdbfe; width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; color: #2563eb; font-size: 1.4rem; flex-shrink: 0; box-shadow: 0 4px 10px rgba(37, 99, 235, 0.12);">
                            <i class="bi bi-journal-medical" style="color: #2563eb;"></i>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 4px; flex: 1;">
                            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                <h5 style="font-weight: 800; color: #0f172a; margin: 0; font-size: 1.1rem; letter-spacing: -0.01em;">@t.TemplateName</h5>
                                <span style="background: #f1f5f9; color: #475569; font-weight: 800; font-size: 0.72rem; padding: 2px 9px; border-radius: 20px; border: 1px solid #cbd5e1;">
                                    @t.Columns.Count Column Header@(t.Columns.Count == 1 ? "" : "s")
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(t.Description))
                            {
                                <p style="font-size: 0.82rem; color: #64748b; margin: 0; font-weight: 500;">@t.Description</p>
                            }

                            @* Configured Column Header Tags inline *@
                            <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px;">
                                @foreach (var col in t.Columns)
                                {
                                    var badgeClass = col.InputType == "MEDICINE" ? "background: #fff1f2; color: #be123c; border: 1px solid #fecdd3;" : (col.InputType == "BOTH" ? "background: #fef3c7; color: #b45309; border: 1px solid #fde68a;" : "background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;");
                                    var typeLabel = col.InputType == "MEDICINE" ? "Input Grid" : (col.InputType == "BOTH" ? "Text + Input" : "Text");
                                    var typeIcon = col.InputType == "MEDICINE" ? "bi-capsule text-danger" : (col.InputType == "BOTH" ? "bi-layers-half text-warning" : "bi-file-text text-primary");

                                    <span style="font-size: 0.75rem; font-weight: 700; padding: 3px 9px; border-radius: 8px; display: inline-flex; align-items: center; gap: 5px; @badgeClass">
                                        <i class="bi @typeIcon"></i> @col.ColumnHeaderName
                                        <span style="opacity: 0.75; font-size: 0.68rem; font-weight: 800;">(@typeLabel)</span>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                        @if (hasEditRight)
                        {
                            <button type="button" style="background: #eff6ff; color: #2563eb; font-weight: 800; border: 1.5px solid #bfdbfe; border-radius: 10px; padding: 0.5rem 1.1rem; font-size: 0.82rem; display: flex; align-items: center; gap: 6px; cursor: pointer;" @onclick="() => OpenEditTemplateModal(t)">
                                <i class="bi bi-pencil-square" style="color: #2563eb;"></i> Edit Columns
                            </button>
                        }
                        @if (hasDeleteRight)
                        {
                            <button type="button" style="background: #fff1f2; color: #e11d48; font-weight: 800; border: 1.5px solid #fecdd3; border-radius: 10px; padding: 0.5rem 1.1rem; font-size: 0.82rem; display: flex; align-items: center; gap: 6px; cursor: pointer;" @onclick="() => DeleteTemplateGroup(t)">
                                <i class="bi bi-trash3-fill" style="color: #e11d48;"></i> Delete
                            </button>
                        }
                    </div>

                </div>
            }
        </div>
    }
</div>

@* --- COMPACT HIGH-DENSITY TEMPLATE BUILDER MODAL --- *@
@if (showModal)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(8px); z-index: 100050; display: flex; align-items: center; justify-content: center; padding: 1rem;" @onclick="CloseModal">
        <div style="background: #ffffff; border-radius: 20px; width: 95vw; max-width: 880px; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4); border: 1px solid rgba(226, 232, 240, 0.8); overflow: hidden;" @onclick:stopPropagation>
            
            @* Modal Header Bar *@
            <div style="padding: 1rem 1.5rem; background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; border-bottom: 1px solid rgba(255,255,255,0.1);">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="background: #eff6ff; border: 1px solid #bfdbfe; width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #2563eb; font-size: 1.2rem; box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2);">
                        <i class="bi bi-journal-plus" style="color: #2563eb;"></i>
                    </div>
                    <div>
                        <h5 style="font-weight: 800; margin: 0; color: #ffffff; font-size: 1.1rem; letter-spacing: -0.01em;">
                            @(editingTemplateId.HasValue ? "Edit Discharge Summary Template" : "Create Discharge Summary Template")
                        </h5>
                        <span style="font-size: 0.75rem; color: #c7d2fe; font-weight: 500;">Define template name, column headers, input types, and default answers</span>
                    </div>
                </div>
                <button type="button" style="background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.25); color: #ffffff; width: 34px; height: 34px; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer;" @onclick="CloseModal" title="Close Dialog">
                    <i class="bi bi-x-lg" style="font-size: 1rem; font-weight: 800; color: #ffffff;"></i>
                </button>
            </div>

            @* Body *@
            <div style="padding: 1.25rem 1.5rem; overflow-y: auto; flex: 1; display: flex; flex-direction: column; gap: 1.1rem; background: #f8fafc;">
                
                @* Template Compact Header Info Bar *@
                <div style="background: #ffffff; border-radius: 12px; border: 1.5px solid #e2e8f0; padding: 0.85rem 1.1rem; display: grid; grid-template-columns: 1.2fr 1fr; gap: 1rem; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
                    <div>
                        <label style="font-size: 0.72rem; font-weight: 700; color: #1e293b; margin-bottom: 3px; display: flex; align-items: center; gap: 6px;">
                            <i class="bi bi-journal-bookmark-fill" style="color: #2563eb; font-size: 0.9rem;"></i> Template Name *
                        </label>
                        <input type="text" style="width: 100%; box-sizing: border-box; font-weight: 700; border-radius: 8px; border: 1.5px solid #cbd5e1; padding: 0.45rem 0.75rem; font-size: 0.88rem; color: #0f172a; outline: none; background: #ffffff;" 
                               placeholder="e.g. Cholecystitis Standard Template / General Surgery" 
                               @bind="editingModel.TemplateName" />
                    </div>
                    <div>
                        <label style="font-size: 0.72rem; font-weight: 700; color: #1e293b; margin-bottom: 3px; display: flex; align-items: center; gap: 6px;">
                            <i class="bi bi-text-paragraph" style="color: #06b6d4; font-size: 0.9rem;"></i> Template Description (Optional)
                        </label>
                        <input type="text" style="width: 100%; box-sizing: border-box; font-weight: 500; border-radius: 8px; border: 1.5px solid #cbd5e1; padding: 0.45rem 0.75rem; font-size: 0.82rem; color: #334155; outline: none; background: #ffffff;" 
                               placeholder="e.g. Standard layout for cholecystitis cases" 
                               @bind="editingModel.Description" />
                    </div>
                </div>

                @* Column Headers Section *@
                <div style="background: #ffffff; border-radius: 12px; border: 1.5px solid #e2e8f0; padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.85rem; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
                    
                    @* Section Title & Button *@
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1.5px solid #f1f5f9; padding-bottom: 0.6rem;">
                        <div>
                            <span style="font-weight: 800; color: #0f172a; font-size: 0.88rem; display: flex; align-items: center; gap: 6px;">
                                <i class="bi bi-layout-three-columns" style="color: #6366f1; font-size: 0.95rem;"></i> Column Headers & Input Types (@editingModel.Columns.Count)
                            </span>
                            <span style="font-size: 0.75rem; color: #64748b;">Add column headers with input type (Text / Input Grid) and default answer</span>
                        </div>

                        <button type="button" style="font-weight: 800; border-radius: 8px; font-size: 0.8rem; padding: 6px 14px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; border: none; box-shadow: 0 3px 10px rgba(37, 99, 235, 0.3); display: flex; align-items: center; gap: 6px; cursor: pointer;" @onclick="AddColumnRow">
                            <i class="bi bi-plus-circle-fill" style="font-weight: 800; color: #ffffff; font-size: 0.85rem;"></i>
                            <span style="color: #ffffff; font-weight: 800;">Add Column Header</span>
                        </button>
                    </div>

                    @if (!editingModel.Columns.Any())
                    {
                        <div style="text-align: center; padding: 2rem 0; color: #94a3b8;">
                            <i class="bi bi-plus-circle" style="font-size: 2rem; color: #2563eb; display: block; margin-bottom: 0.4rem;"></i>
                            <div style="font-weight: 700; font-size: 0.88rem; color: #64748b;">No Column Headers Added Yet</div>
                            <p style="font-size: 0.78rem; margin-top: 2px; max-width: 340px; margin-left: auto; margin-right: auto;">
                                Click 'Add Column Header' to add custom column headers for this template.
                            </p>
                            <button type="button" style="font-weight: 800; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; border-radius: 8px; padding: 6px 14px; border: none; cursor: pointer;" @onclick="AddColumnRow">
                                <i class="bi bi-plus-circle-fill me-1" style="color: #ffffff;"></i> Add Column Header
                            </button>
                        </div>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                            @{ int colIdx = 1; }
                            @foreach (var col in editingModel.Columns)
                            {
                                <div style="background: #ffffff; border: 1.5px solid #cbd5e1; border-left: 4px solid #2563eb; border-radius: 12px; padding: 0.75rem 1rem; display: flex; flex-direction: column; gap: 0.6rem; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
                                    
                                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.4rem;">
                                        <div style="display: flex; align-items: center; gap: 6px;">
                                            <span style="background: #eff6ff; color: #1d4ed8; border-radius: 6px; padding: 1px 7px; font-size: 0.7rem; font-weight: 800; border: 1px solid #bfdbfe;">
                                                Column Header #@(colIdx++)
                                            </span>
                                            <span style="color: #64748b; font-weight: 600; font-size: 0.75rem;">Header Configuration</span>
                                        </div>

                                        <button type="button" style="background: #fff1f2; color: #be123c; border: 1px solid #fecdd3; border-radius: 6px; font-size: 0.72rem; font-weight: 800; padding: 2px 8px; display: flex; align-items: center; gap: 4px; cursor: pointer;" @onclick="() => RemoveColumnRow(col)" title="Remove Column">
                                            <i class="bi bi-trash3-fill" style="color: #ef4444;"></i> Remove Column
                                        </button>
                                    </div>

                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;">
                                        <div>
                                            <label style="font-size: 0.72rem; font-weight: 700; color: #1e293b; margin-bottom: 3px; display: flex; align-items: center; gap: 6px;">
                                                <i class="bi bi-fonts" style="color: #2563eb; font-size: 0.85rem;"></i> Column Header Name *
                                            </label>
                                            <input type="text" style="width: 100%; box-sizing: border-box; font-weight: 700; border-radius: 8px; border: 1.5px solid #cbd5e1; padding: 0.45rem 0.75rem; font-size: 0.85rem; color: #0f172a; outline: none; background: #ffffff;" 
                                                   placeholder="e.g. Doctor Description / Medications" 
                                                   @bind="col.ColumnHeaderName" />
                                        </div>
                                        <div>
                                            <label style="font-size: 0.72rem; font-weight: 700; color: #1e293b; margin-bottom: 3px; display: flex; align-items: center; gap: 6px;">
                                                <i class="bi bi-ui-checks-grid" style="color: #8b5cf6; font-size: 0.85rem;"></i> Input Data Type *
                                            </label>
                                            <select style="width: 100%; font-weight: 700; border-radius: 8px; border: 1.5px solid #cbd5e1; padding: 0.45rem 0.75rem; font-size: 0.82rem; color: #0f172a; outline: none; background: #ffffff;" @bind="col.InputType">
                                                <option value="TEXT">Free Text Answer</option>
                                                <option value="MEDICINE">Input Grid (Prescription Search)</option>
                                                <option value="BOTH">Both (Input Grid + Text Notes)</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div>
                                        <label style="font-size: 0.72rem; font-weight: 700; color: #475569; margin-bottom: 3px; display: flex; align-items: center; gap: 6px;">
                                            <i class="bi bi-chat-left-quote-fill" style="color: #10b981; font-size: 0.85rem;"></i> Default Answer Content (Optional)
                                        </label>
                                        <textarea style="width: 100%; box-sizing: border-box; font-size: 0.82rem; line-height: 1.4; border-radius: 8px; border: 1.5px solid #cbd5e1; padding: 0.5rem 0.75rem; font-weight: 500; color: #1e293b; outline: none; background: #ffffff; min-height: 48px; resize: vertical;" 
                                                  rows="2" 
                                                  placeholder="Type default answer content to pre-fill when this template is selected..." 
                                                  @bind="col.DefaultAnswer">
                                        </textarea>
                                    </div>

                                </div>
                            }
                        </div>
                    }
                </div>

            </div>

            @* Modal Footer *@
            <div style="padding: 0.85rem 1.5rem; border-top: 1px solid #e2e8f0; display: flex; justify-content: flex-end; gap: 10px; background: #ffffff; flex-shrink: 0;">
                <button type="button" style="background: #f1f5f9; color: #475569; border: 1.5px solid #cbd5e1; border-radius: 10px; font-weight: 700; padding: 0.5rem 1.4rem; font-size: 0.85rem; cursor: pointer;" @onclick="CloseModal">Cancel</button>
                <button type="button" style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; border: none; border-radius: 10px; font-weight: 800; padding: 0.5rem 1.75rem; font-size: 0.88rem; cursor: pointer; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);" @onclick="SaveCompleteTemplate">Save Template & Columns</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string searchQuery = "";

    public class SummaryTemplateViewModel
    {
        public Guid TemplateId { get; set; } = Guid.NewGuid();
        public string TemplateName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public List<SummaryTemplateColumnModel> Columns { get; set; } = new();
    }

    public class SummaryTemplateColumnModel
    {
        public Guid CategoryId { get; set; } = Guid.NewGuid();
        public string ColumnHeaderName { get; set; } = string.Empty;
        public string InputType { get; set; } = "TEXT";
        public string DefaultAnswer { get; set; } = string.Empty;
    }

    private List<SummaryTemplateViewModel> templateGroups = new();

    private bool showModal = false;
    private Guid? editingTemplateId;
    private SummaryTemplateViewModel editingModel = new();
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    protected override async Task OnInitializedAsync()
    {
        await CleanDefaultDummyCategories();
        await LoadTemplatesData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
                try
                {
                    bool isAdmin = false;
                    try
                    {
                        var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                        if (userResult.Success && userResult.Value != null)
                        {
                            isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                      userResult.Value.UserCode == 0 ||
                                      userResult.Value.UserCode == 1;
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error checking user details: {ex.Message}");
                    }

                    if (isAdmin)
                    {
                        hasCreateRight = true;
                        hasEditRight = true;
                        hasDeleteRight = true;
                    }
                    else
                    {
                        var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                        if (rightsResult.Success && rightsResult.Value != null)
                        {
                            var pageRight = rightsResult.Value.FirstOrDefault(r => 
                                r.ModuleName != null && 
                                r.ModuleName.Trim().Equals("Summery_Templates", StringComparison.OrdinalIgnoreCase));
                            
                            if (pageRight != null)
                            {
                                hasCreateRight = pageRight.ToAdd;
                                hasEditRight = pageRight.ToEdit;
                                hasDeleteRight = pageRight.ToDelete;
                            }
                            else
                            {
                                hasCreateRight = false;
                                hasEditRight = false;
                                hasDeleteRight = false;
                            }
                        }
                        else
                        {
                            hasCreateRight = false;
                            hasEditRight = false;
                            hasDeleteRight = false;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking Summery_Templates rights: {ex.Message}");
                    hasCreateRight = false;
                    hasEditRight = false;
                    hasDeleteRight = false;
                }

            StateHasChanged();
        }
    }

    private async Task CleanDefaultDummyCategories()
    {
        try
        {
            var categories = await DsService.GetCategoriesAsync();
            var dummyNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            {
                "ADMISSION & ADMINISTRATION",
                "DOCTOR CONSULTATION & DIAGNOSIS",
                "ALLERGIES & DRUG SENSITIVITIES",
                "PHYSICAL & SYSTEMIC EXAMINATION",
                "INVESTIGATIONS & LAB RESULTS",
                "TREATMENT GIVEN & OPERATIVE NOTES",
                "ADVICE ON DISCHARGE",
                "FOLLOW UP PLAN",
                "CHIEF COMPLAINTS",
                "HISTORY OF PRESENT ILLNESS",
                "PHYSICAL EXAMINATION",
                "FOLLOW UP"
            };

            foreach (var cat in categories)
            {
                if (dummyNames.Contains(cat.category_name.Trim()))
                {
                    await DsService.DeleteCategoryAsync(cat.category_id);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Cleanup error: {ex.Message}");
        }
    }

    private async Task LoadTemplatesData()
    {
        isLoading = true;
        try
        {
            var categories = await DsService.GetCategoriesAsync();
            var presets = await DsService.GetTemplatesAsync(null);

            templateGroups.Clear();

            var presetGroups = presets.Where(p => !string.IsNullOrWhiteSpace(p.template_name))
                                      .GroupBy(p => p.template_name.Trim())
                                      .ToList();

            foreach (var g in presetGroups)
            {
                var vm = new SummaryTemplateViewModel
                {
                    TemplateId = g.First().template_id,
                    TemplateName = g.Key,
                    Description = $"Template with {g.Count()} column header(s)"
                };

                foreach (var item in g)
                {
                    var cat = categories.FirstOrDefault(c => c.category_id == item.category_id)
                           ?? categories.FirstOrDefault(c => c.category_name != null && c.category_name.Trim().Equals(item.category_name.Trim(), StringComparison.OrdinalIgnoreCase));

                    vm.Columns.Add(new SummaryTemplateColumnModel
                    {
                        CategoryId = cat?.category_id ?? item.category_id,
                        ColumnHeaderName = item.category_name,
                        InputType = cat?.category_type ?? "TEXT",
                        DefaultAnswer = item.template_text ?? ""
                    });
                }

                templateGroups.Add(vm);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading templates: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<SummaryTemplateViewModel> GetFilteredTemplates()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return templateGroups;
        var q = searchQuery.Trim().ToLower();
        return templateGroups.Where(t => t.TemplateName.ToLower().Contains(q) 
            || (t.Description != null && t.Description.ToLower().Contains(q))
            || t.Columns.Any(s => s.ColumnHeaderName.ToLower().Contains(q)));
    }

    private void OpenCreateTemplateModal()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add templates.");
            return;
        }
        editingTemplateId = null;
        editingModel = new SummaryTemplateViewModel
        {
            TemplateName = "",
            Description = "",
            Columns = new List<SummaryTemplateColumnModel>()
        };
        AddColumnRow();
        showModal = true;
    }

    private void OpenEditTemplateModal(SummaryTemplateViewModel vm)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit templates.");
            return;
        }
        editingTemplateId = vm.TemplateId;
        editingModel = new SummaryTemplateViewModel
        {
            TemplateId = vm.TemplateId,
            TemplateName = vm.TemplateName,
            Description = vm.Description,
            Columns = vm.Columns.Select(s => new SummaryTemplateColumnModel
            {
                CategoryId = s.CategoryId,
                ColumnHeaderName = s.ColumnHeaderName,
                InputType = s.InputType,
                DefaultAnswer = s.DefaultAnswer
            }).ToList()
        };
        showModal = true;
    }

    private void AddColumnRow()
    {
        editingModel.Columns.Add(new SummaryTemplateColumnModel
        {
            ColumnHeaderName = "",
            InputType = "TEXT",
            DefaultAnswer = ""
        });
    }

    private void RemoveColumnRow(SummaryTemplateColumnModel col)
    {
        editingModel.Columns.Remove(col);
    }

    private async Task SaveCompleteTemplate()
    {
        if (editingTemplateId.HasValue && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit templates.");
            return;
        }
        if (!editingTemplateId.HasValue && !hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add templates.");
            return;
        }
        if (string.IsNullOrWhiteSpace(editingModel.TemplateName))
        {
            ToastService.ShowWarning("Please enter a template name.");
            return;
        }

        if (!editingModel.Columns.Any(s => !string.IsNullOrWhiteSpace(s.ColumnHeaderName)))
        {
            ToastService.ShowWarning("Please add at least one column header.");
            return;
        }

        try
        {
            int sortOrder = 1;
            foreach (var col in editingModel.Columns.Where(s => !string.IsNullOrWhiteSpace(s.ColumnHeaderName)))
            {
                var catId = await DsService.SaveCategoryAsync(new DischargeSummaryService.DsCategoryDto
                {
                    category_id = col.CategoryId != Guid.Empty ? col.CategoryId : Guid.Empty,
                    category_name = col.ColumnHeaderName.Trim(),
                    category_type = col.InputType,
                    sort_order = sortOrder++
                });

                if (catId.HasValue)
                {
                    await DsService.SaveTemplateAsync(new DischargeSummaryService.DsTemplateDto
                    {
                        category_id = catId.Value,
                        category_name = col.ColumnHeaderName.Trim(),
                        template_name = editingModel.TemplateName.Trim(),
                        template_text = col.DefaultAnswer?.Trim() ?? ""
                    });
                }
            }

            ToastService.ShowSuccess($"Saved Template '{editingModel.TemplateName}' with {editingModel.Columns.Count} column headers!");
            showModal = false;
            await LoadTemplatesData();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Save error: {ex.Message}");
        }
    }

    private async Task DeleteTemplateGroup(SummaryTemplateViewModel vm)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete templates.");
            return;
        }
        try
        {
            foreach (var col in vm.Columns)
            {
                await DsService.DeleteCategoryAsync(col.CategoryId);
            }

            var presets = await DsService.GetTemplatesAsync(null);
            var matching = presets.Where(p => p.template_name != null && p.template_name.Trim().Equals(vm.TemplateName.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
            foreach (var m in matching)
            {
                await DsService.DeleteTemplateAsync(m.template_id);
            }

            ToastService.ShowSuccess($"Deleted Template '{vm.TemplateName}'");
            await LoadTemplatesData();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Delete error: {ex.Message}");
        }
    }

    private void CloseModal()
    {
        showModal = false;
    }
}
