@page "/paymode-master"
@page "/paymodes"
@rendermode InteractiveServer

@using Booking.Models
@using Booking.Services
@using Booking.Helpers
@inject PaymodeMasterService PaymodeService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">payments</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Payment Mode Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Payment Options & Methods</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search paymodes..." @bind="SearchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            <div class="search-controls">
                @if (hasCreateRight)
                {
                    <button class="btn-new-entry" @onclick="NewPaymode">+ Add New</button>
                }
            </div>
        </div>
    </div>

    @* --- directory list --- *@
    <div class="directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">ORDER NO</th>
                        <th style="width: 130px;">SHORT NAME</th>
                        <th>NAME</th>
                        <th style="width: 150px;">DURATION TIME</th>
                        <th style="width: 150px;">DURATION</th>
                        <th>DESCRIPTION</th>
                        <th style="width: 180px;">ENTERED DATE</th>
                        <th class="text-center" style="width: 120px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (paymodes != null && paymodes.Any())
                    {
                        @foreach (var p in FilteredPaymodesBySearch)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"{p.orderno:00}")</span></td>
                                <td class="lc-color-slate-500 lc-font-mono lc-font-700 lc-font-13">@p.shortname</td>
                                <td class="font-bold text-slate-800">@p.name</td>
                                <td><span class="lc-color-slate-600 font-bold">@p.durationtime</span></td>
                                <td><span class="lc-color-slate-600 font-bold">@(p.duration ?? "-")</span></td>
                                <td class="lc-color-slate-500">@(p.description ?? "-")</td>
                                <td class="text-slate-400 font-12">@(p.entereddate != default ? (DateTimeHelper.ConvertUtcToIst(p.entereddate)?.ToString("dd-MM-yyyy hh:mm tt") ?? "") : "")</td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px;">
                                        @if (hasEditRight)
                                        {
                                            <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => EditPaymode(p)" title="Edit">
                                                <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                            </button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => DeletePaymode(p.pmcode)" title="Delete">
                                                <span class="material-symbols-outlined font-18 text-slate-400">delete</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center p-48 text-slate-400 italic">No payment mode records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- FORM SECTION (Modal) --- *@
@if (showForm)
{
    <div class="modal-overlay">
        <div class="modal-form-card">
            <div class="modal-header-bar">
                <h3>@(isEditMode ? "Edit Payment Mode" : "New Payment Mode Entry")</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-0 form-section">
                    <div class="mt-0">
                        @* Line 1: Name *@
                        <div class="um-grid-row">
                            <div class="form-group position-relative">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label style="margin-bottom: 0;">Name *</label>
                                    @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                    {
                                        <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                    }
                                </div>
                                <input type="text" class="lab-input" @bind="current.name" placeholder="e.g. Cash" required />
                            </div>
                        </div>

                        @* Line 2: Order no, Short Name, Duration Time, Duration *@
                        <div class="um-grid-cols-4">
                            <div class="form-group">
                                <label>Order no</label>
                                <input type="number" class="lab-input" @bind="current.orderno" />
                            </div>
                            <div class="form-group">
                                <label>Short Name</label>
                                <input type="text" class="lab-input" @bind="current.shortname" placeholder="e.g. CASH" />
                            </div>
                            <div class="form-group">
                                <label>Duration Time</label>
                                <input type="number" class="lab-input" @bind="current.durationtime" />
                            </div>
                            <div class="form-group">
                                <label>Duration</label>
                                <input type="text" class="lab-input" @bind="current.duration" placeholder="e.g. Immediate" />
                            </div>
                        </div>

                        @* Line 3: Description, Footer *@
                        <div class="um-grid-cols-2">
                            <div class="form-group">
                                <label>Description</label>
                                <input type="text" class="lab-input" @bind="current.description" placeholder="e.g. Cash payment" />
                            </div>
                            <div class="form-group">
                                <label>Footer</label>
                                <input type="text" class="lab-input" @bind="current.footer" placeholder="e.g. Paid in cash" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer-bar">
                <button type="button"
                        class="btn-delete"
                        @onclick="() => DeletePaymode(current.pmcode)"
                        disabled="@(current.pmcode == 0)">
                    Delete
                </button>
                <button type="button" class="btn-save" @onclick="SavePaymode">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                    </svg>
                    Save Paymode
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Booking.Models.PaymodeMasterModel> paymodes = new();
    private Booking.Models.PaymodeMasterModel current = new();
    private bool isEditMode = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";

    private IEnumerable<Booking.Models.PaymodeMasterModel> FilteredPaymodes =>
        paymodes.Where(p => !p.deleted);

    private IEnumerable<Booking.Models.PaymodeMasterModel> FilteredPaymodesBySearch =>
        FilteredPaymodes.Where(p => 
            string.IsNullOrWhiteSpace(SearchQuery) || 
            (p.name != null && p.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (p.shortname != null && p.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (p.description != null && p.description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    private bool hasCreateRight = false;
    private bool hasEditRight = false;
    private bool hasDeleteRight = false;
    private bool hasViewRight = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            bool isAdmin = false;
            try
            {
                var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null)
                    isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                              userResult.Value.UserCode == 0 || userResult.Value.UserCode == 1;
            }
            catch { }

            if (isAdmin)
            {
                hasViewRight = true;
                hasCreateRight = true;
                hasEditRight = true;
                hasDeleteRight = true;
            }
            else
            {
                var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                if (rightsResult.Success && rightsResult.Value != null)
                {
                    var pageRight = rightsResult.Value.FirstOrDefault(r =>
                        r.ModuleName != null && r.ModuleName.Trim().Equals("Paymode_Master", StringComparison.OrdinalIgnoreCase));
                    if (pageRight != null)
                    {
                        hasViewRight = pageRight.ToView;
                        hasCreateRight = pageRight.ToAdd;
                        hasEditRight = pageRight.ToEdit;
                        hasDeleteRight = pageRight.ToDelete;
                    }
                    else { hasViewRight = false; hasCreateRight = false; hasEditRight = false; hasDeleteRight = false; }
                }
                else { hasViewRight = false; hasCreateRight = false; hasEditRight = false; hasDeleteRight = false; }

                if (!hasViewRight)
                {
                    ToastService.ShowError("You do not have permission to access Paymode Master.");
                    Navigation.NavigateTo("/home");
                    return;
                }
            }
        }
        catch { }

        await LoadPaymodes();
    }

    private async Task LoadPaymodes()
    {
        try
        {
            paymodes = await PaymodeService.GetPaymodeMastersAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading paymodes: {ex.Message}");
        }
    }

    private void NewPaymode()
    {
        if (!hasCreateRight) { ToastService.ShowError("You do not have permission to create payment modes."); return; }
        current = new Booking.Models.PaymodeMasterModel { 
            deleted = false,
            computercode = 1,
            usercode = 1,
            entereddate = DateTime.Now,
            ibsdate = DateTime.Now,
            orderno = paymodes.Count + 1,
            tenant_code = "TEN007",
            durationtime = 0,
            duration = "Immediate"
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private void EditPaymode(Booking.Models.PaymodeMasterModel p)
    {
        if (!hasEditRight) { ToastService.ShowError("You do not have permission to edit payment modes."); return; }
        if (p == null) return;
        current = new Booking.Models.PaymodeMasterModel
        {
            pmcode = p.pmcode,
            tenant_code = p.tenant_code,
            orderno = p.orderno,
            shortname = p.shortname,
            name = p.name,
            durationtime = p.durationtime,
            duration = p.duration,
            description = p.description,
            footer = p.footer,
            deleted = p.deleted,
            usercode = p.usercode,
            computercode = p.computercode,
            entereddate = p.entereddate,
            ibsdate = p.ibsdate
        };
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SavePaymode()
    {
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(current.name))
        {
            ToastService.ShowError("Name is required.");
            StateHasChanged();
            return;
        }

        try
        {
            current.tenant_code = "TEN007";
            current.computercode = 1;
            current.usercode = 1;
            current.ibsdate = DateTime.Now;

            bool success;
            if (isEditMode)
            {
                success = await PaymodeService.UpdatePaymodeMasterAsync(current);
            }
            else
            {
                current.entereddate = DateTime.Now;
                success = await PaymodeService.InsertPaymodeMasterAsync(current);
            }

            if (success)
            {
                await LoadPaymodes();
                ToastService.ShowSuccess(isEditMode ? "Payment Mode updated successfully!" : "Payment Mode added successfully!");
                showForm = false;
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Save failed on backend.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving payment mode: {ex.Message}");
            StateHasChanged();
        }
    }

    private async Task DeletePaymode(decimal pmcode)
    {
        if (!hasDeleteRight) { ToastService.ShowError("You do not have permission to delete payment modes."); return; }
        if (pmcode == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this payment mode?"))
        {
            try
            {
                bool success = await PaymodeService.DeletePaymodeMasterAsync(pmcode);
                if (success)
                {
                    await LoadPaymodes();
                    ToastService.ShowSuccess("Payment Mode deleted successfully!");
                    if (current != null && current.pmcode == pmcode)
                    {
                        showForm = false;
                    }
                    StateHasChanged();
                }
                else
                {
                    ToastService.ShowError("Delete failed on backend.");
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error deleting: {ex.Message}");
                StateHasChanged();
            }
        }
    }

    private void CloseForm()
    {
        current = new Booking.Models.PaymodeMasterModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }
}
