@page "/manufacturermaster"
@page "/manufacturers"
@using Booking.Models
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.NotificationService NotificationService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<div class="items-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="10" width="20" height="12" rx="2" />
                            <path d="M6 10V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v6" />
                            <path d="M6 14h4v4H6z" />
                            <path d="M14 14h4v4h-4z" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Manufacturer Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total manufacturers : @ManufacturerList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by name, code, contact..." @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    <button class="add-item-btn" @onclick="AddNewManufacturer">
                        <i class="bi bi-plus-lg"></i>
                        <span class="ms-1">Add Manufacturer</span>
                    </button>
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredManufacturers.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        No manufacturers found. Create a new manufacturer.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 70px; text-align: center;">S.NO</th>
                                    <th style="width: 100px; text-align: center;">CODE</th>
                                    <th style="width: 22%; text-align: center;">MANUFACTURER NAME</th>
                                    <th style="width: 12%; text-align: center;">SHORT NAME</th>
                                    <th style="width: 16%; text-align: center;">CONTACT PERSON</th>
                                    <th style="width: 14%; text-align: center;">PHONE NO</th>
                                    <th style="width: 18%; text-align: center;">EMAIL</th>
                                    <th style="width: 120px; text-align: center;">STATUS</th>
                                    <th style="width: 100px; text-align: center;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedManufacturers.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td style="text-align: center; font-weight: 700; color: #3b82f6;">@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td style="text-align: center; font-weight: 700; color: #4f46e5;">#@row.value.manufacturercode</td>
                                        <td style="font-weight: 700; color: #0f172a; text-align: center;">@row.value.manufacturername</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.shortname) ? "N/A" : row.value.shortname)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.contactperson) ? "N/A" : row.value.contactperson)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.phoneno) ? "N/A" : row.value.phoneno)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.email) ? "N/A" : row.value.email)</td>
                                        <td style="text-align: center;">
                                            @if (row.value.isactive)
                                            {
                                                <span style="color: #059669; font-weight: 700; font-size: 0.78rem; text-transform: uppercase;">Active</span>
                                            }
                                            else
                                            {
                                                <span style="color: #64748b; font-weight: 700; font-size: 0.78rem; text-transform: uppercase;">Inactive</span>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            <button class="action-btn btn-edit" @onclick="() => EditManufacturer(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var manufacturer in PagedManufacturers)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span>#@manufacturer.manufacturercode - @manufacturer.manufacturername</span>
                                    <div>
                                        <button class="action-btn btn-edit" @onclick="() => EditManufacturer(manufacturer)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(manufacturer)" title="Delete"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Short Name</span><strong>@manufacturer.shortname</strong></div>
                                    <div class="detail-row"><span>Contact</span><strong>@manufacturer.contactperson</strong></div>
                                    <div class="detail-row"><span>Phone</span><strong>@manufacturer.phoneno</strong></div>
                                    <div class="detail-row"><span>Email</span><strong>@manufacturer.email</strong></div>
                                    <div class="detail-row"><span>GST No</span><strong>@manufacturer.gstno</strong></div>
                                    <div class="detail-row"><span>Address</span><strong>@manufacturer.address</strong></div>
                                    <div class="detail-row"><span>Status</span><strong>@(manufacturer.isactive ? "Active" : "Inactive")</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredManufacturers.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredManufacturers.Count()))</strong> of <strong>@FilteredManufacturers.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 800px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #000000 !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Manufacturer" : "Add Manufacturer")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentItem" OnValidSubmit="Save" autocomplete="off">
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 16px 16px 8px 0px;">
                        <div class="form-grid">
                            <div class="field-group col-6">
                                <label class="field-label required">Manufacturer Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.manufacturername" placeholder="E.g. Acme Pharma Ltd" />
                            </div>
                            
                            <div class="field-group col-2">
                                <label class="field-label">Short Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.shortname" placeholder="E.g. ACME" />
                            </div>

                            <div class="field-group col-4">
                                <label class="field-label">GST No</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.gstno" placeholder="E.g. 29GGGGG1314R1Z5" />
                            </div>

                            <div class="field-group col-5" style="margin-top: 10px;">
                                <label class="field-label">Contact Person</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.contactperson" placeholder="E.g. John Doe" />
                            </div>

                            <div class="field-group col-3" style="margin-top: 10px;">
                                <label class="field-label">Phone No</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.phoneno" placeholder="E.g. +1234567890" />
                            </div>

                            <div class="field-group col-4" style="margin-top: 10px;">
                                <label class="field-label">Email</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.email" placeholder="E.g. contact@acme.com" />
                            </div>

                            <div class="field-group col-5" style="margin-top: 10px;">
                                <label class="field-label">Address</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.address" placeholder="E.g. 123 Main St, Industrial Area" />
                            </div>

                            <div class="field-group col-5" style="margin-top: 10px;">
                                <label class="field-label">Description</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.description" placeholder="Optional notes about the manufacturer..." />
                            </div>

                            <div class="field-group col-2" style="margin-top: 10px;">
                                <label class="field-label">Is Active?</label>
                                <div class="premium-segmented-control-joined" style="max-width: 130px; height: 32px; border-radius: 6px;">
                                    <button type="button" class="segment-btn-joined btn-false @(CurrentItem.isactive ? "" : "active")" @onclick="() => CurrentItem.isactive = false" style="font-size: 0.8rem;">
                                        False
                                    </button>
                                    <button type="button" class="segment-btn-joined btn-true @(CurrentItem.isactive ? "active" : "")" @onclick="() => CurrentItem.isactive = true" style="font-size: 0.8rem;">
                                        True
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-actions" style="display: flex; justify-content: flex-end; align-items: center; padding: 1.5rem 2rem; border-top: 1px solid #f1f5f9; background: #fff;">
                        <div class="footer-right" style="display: flex; gap: 1rem; align-items: center;">
                            <button type="button" class="btn-cancel-modal" @onclick="CloseModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.75rem 2rem; border-radius: 12px; font-weight: 700; min-width: 120px; transition: all 0.2s;">
                                Cancel
                            </button>
                            <button type="submit" class="btn-save-premium" disabled="@IsSaving" style="background: #1c9f5f; color: white; border: none; padding: 0.75rem 2.5rem; border-radius: 12px; font-weight: 700; display: flex; align-items: center; gap: 8px; min-width: 160px; box-shadow: 0 4px 12px rgba(28, 159, 95, 0.2); transition: all 0.2s;">
                                @if (IsSaving)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle" style="font-size: 1.2rem;"></i>
                                }
                                <span>@(IsEdit ? "Update Manufacturer" : "Save Manufacturer")</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Popup -->
@if (ShowDeletePopup)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeletePopup = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Manufacturer</div>
            <div class="action-popup-body">Are you sure you want to delete this manufacturer? This action cannot be undone.</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowDeletePopup = false">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" disabled="@IsDeleteProcessing" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<manufacturer_master> ManufacturerList = new();
    private string SearchQuery = string.Empty;
    private bool IsLoading;
    private bool IsSaving;
    private bool ShowModal;
    private bool IsEdit;
    private bool ShowDeletePopup;
    private bool IsDeleteProcessing;
    private bool IsCardView = false;
    private string DefaultTenantCode = "";

    private manufacturer_master CurrentItem = new();
    private manufacturer_master? PendingDelete;

    private void SetView(bool cardView)
    {
        IsCardView = cardView;
        CurrentPage = 1;
    }

    private IEnumerable<manufacturer_master> FilteredManufacturers =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? ManufacturerList
            : ManufacturerList.Where(m =>
                (m.manufacturername?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (m.shortname?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (m.contactperson?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (m.email?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                m.manufacturercode.ToString().Contains(SearchQuery, StringComparison.OrdinalIgnoreCase));

    // Pagination
    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 12;
    private int TotalPages => (int)Math.Ceiling((double)FilteredManufacturers.Count() / ItemsPerPage);
    private IEnumerable<manufacturer_master> PagedManufacturers => FilteredManufacturers.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
            
            await LoadManufacturers();
            StateHasChanged();
        }
    }

    private HttpClient CreateTenantClient()
    {
        var client = ClientFactory.CreateClient("InventoryApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenantCode);
        return client;
    }

    private async Task LoadManufacturers()
    {
        IsLoading = true;
        try
        {
            var client = CreateTenantClient();
            var responseString = await client.GetStringAsync("ItemMaster/getlistmanufacturer");
            
            try
            {
                var direct = System.Text.Json.JsonSerializer.Deserialize<List<manufacturer_master>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ManufacturerList = (direct ?? new List<manufacturer_master>()).Where(m => !m.deleted).OrderBy(m => m.manufacturername).ToList();
            }
            catch
            {
                var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<manufacturer_master>>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ManufacturerList = (wrapped?.data ?? new List<manufacturer_master>()).Where(m => !m.deleted).OrderBy(m => m.manufacturername).ToList();
            }
        }
        catch (Exception ex)
        {
            ManufacturerList = new List<manufacturer_master>();
            NotificationService.ShowNotification($"Failed to load manufacturers: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        CurrentPage = 1;
    }

    private void AddNewManufacturer()
    {
        CurrentItem = new manufacturer_master
        {
            tenantcode = DefaultTenantCode,
            deleted = false,
            isactive = true,
            createddate = DateTime.Now,
            usercode = 1
        };
        IsEdit = false;
        ShowModal = true;
    }

    private void EditManufacturer(manufacturer_master manufacturer)
    {
        CurrentItem = new manufacturer_master
        {
            manufacturercode = manufacturer.manufacturercode,
            manufacturername = manufacturer.manufacturername,
            shortname = manufacturer.shortname,
            description = manufacturer.description,
            contactperson = manufacturer.contactperson,
            phoneno = manufacturer.phoneno,
            email = manufacturer.email,
            address = manufacturer.address,
            gstno = manufacturer.gstno,
            isactive = manufacturer.isactive,
            deleted = manufacturer.deleted,
            createddate = manufacturer.createddate,
            usercode = manufacturer.usercode,
            tenantcode = manufacturer.tenantcode
        };
        IsEdit = true;
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
        IsSaving = false;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(CurrentItem.manufacturername))
        {
            NotificationService.ShowNotification("Manufacturer Name is required", NotificationType.Warning);
            return;
        }

        IsSaving = true;
        try
        {
            var client = CreateTenantClient();
            CurrentItem.tenantcode = DefaultTenantCode;
            CurrentItem.shortname ??= "";
            CurrentItem.description ??= "";
            CurrentItem.contactperson ??= "";
            CurrentItem.phoneno ??= "";
            CurrentItem.email ??= "";
            CurrentItem.address ??= "";
            CurrentItem.gstno ??= "";

            HttpResponseMessage response;
            if (IsEdit)
            {
                var payload = new
                {
                    manufacturercode = CurrentItem.manufacturercode,
                    manufacturername = CurrentItem.manufacturername,
                    shortname = CurrentItem.shortname,
                    description = CurrentItem.description,
                    contactperson = CurrentItem.contactperson,
                    phoneno = CurrentItem.phoneno,
                    email = CurrentItem.email,
                    address = CurrentItem.address,
                    gstno = CurrentItem.gstno,
                    isactive = CurrentItem.isactive,
                    deleted = CurrentItem.deleted,
                    createddate = CurrentItem.createddate,
                    usercode = CurrentItem.usercode,
                    tenantcode = CurrentItem.tenantcode
                };
                response = await client.PostAsJsonAsync("ItemMaster/upsertmanufacturer", payload);
            }
            else
            {
                var payload = new
                {
                    manufacturername = CurrentItem.manufacturername,
                    shortname = CurrentItem.shortname,
                    description = CurrentItem.description,
                    contactperson = CurrentItem.contactperson,
                    phoneno = CurrentItem.phoneno,
                    email = CurrentItem.email,
                    address = CurrentItem.address,
                    gstno = CurrentItem.gstno,
                    isactive = CurrentItem.isactive,
                    deleted = CurrentItem.deleted,
                    createddate = CurrentItem.createddate,
                    usercode = CurrentItem.usercode,
                    tenantcode = CurrentItem.tenantcode
                };
                response = await client.PostAsJsonAsync("ItemMaster/upsertmanufacturer", payload);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification(IsEdit ? "Manufacturer updated successfully" : "Manufacturer added successfully", NotificationType.Success);
                ShowModal = false;
                await LoadManufacturers();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                NotificationService.ShowNotification($"Save failed: {err}", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error saving manufacturer: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(manufacturer_master manufacturer)
    {
        PendingDelete = manufacturer;
        ShowDeletePopup = true;
    }

    private async Task DeleteConfirmed()
    {
        if (PendingDelete == null) return;

        IsDeleteProcessing = true;
        try
        {
            var client = CreateTenantClient();
            var code = PendingDelete.manufacturercode;

            var attempts = new Func<Task<HttpResponseMessage>>[]
            {
                () => client.DeleteAsync($"ItemMaster/deletemanufacturer?manufacturercode={code}"),
                () => client.GetAsync($"ItemMaster/deletemanufacturer?manufacturercode={code}"),
                () => client.PostAsync($"ItemMaster/deletemanufacturer?manufacturercode={code}", null)
            };

            bool success = false;
            foreach (var attempt in attempts)
            {
                try
                {
                    var response = await attempt();
                    if (response.IsSuccessStatusCode)
                    {
                        success = true;
                        break;
                    }
                }
                catch { }
            }

            if (success)
            {
                NotificationService.ShowNotification("Manufacturer deleted successfully", NotificationType.Success);
                ShowDeletePopup = false;
                await LoadManufacturers();
            }
            else
            {
                NotificationService.ShowNotification("Delete failed", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error deleting: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsDeleteProcessing = false;
            PendingDelete = null;
        }
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }
}
