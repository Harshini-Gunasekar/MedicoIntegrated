@page "/slot-types"
@rendermode InteractiveServer
@using Booking.Models
@inject DoctorAppointmentSlotTypeService SlotTypeService
@inject NavigationManager Navigation
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

@if (showForm)
{
    <div class="modal-backdrop" @onclick="CancelEdit"></div>
    <div class="doctor-modal glass-card">
        <div class="modal-header">
            <h3 style="font-weight: 800; color: #026aa7;">@(currentSlotType.slot_type_id == 0 ? "New Slot Type" : "Edit Slot Type")</h3>
            <button class="close-btn" @onclick="CancelEdit">×</button>
        </div>

        <EditForm Model="currentSlotType" OnValidSubmit="SaveSlotType" class="modal-form-container">
            <DataAnnotationsValidator />

            <div class="modal-body">
                <!-- CONFIGURATION SECTION -->
                <div class="section-container">
                    <div class="form-grid">
                        <!-- Line 1: Name (Full Width) -->
                        <div class="form-col span-4">
                            <label style="font-weight: 700; color: #475569;">Name <span style="color: #ef4444;">*</span></label>
                            <InputText @bind-Value="currentSlotType.name" class="form-control" placeholder="e.g. Online Consultation" />
                            <ValidationMessage For="@(() => currentSlotType.name)" style="color: #ef4444; font-size: 0.75rem; margin-top: 0.25rem;" />
                        </div>
                        
                        <!-- Line 2: Short Name and Color Code (Evenly split) -->
                        <div class="form-col span-2">
                            <label style="font-weight: 700; color: #475569;">Short Name <span style="color: #ef4444;">*</span></label>
                            <InputText @bind-Value="currentSlotType.shortname" class="form-control" placeholder="e.g. ONLINE" />
                            <ValidationMessage For="@(() => currentSlotType.shortname)" style="color: #ef4444; font-size: 0.75rem; margin-top: 0.25rem;" />
                        </div>
                        <div class="form-col span-2">
                            <label style="font-weight: 700; color: #475569;">Color Category</label>
                            <div style="position: relative;">
                                <InputText @bind-Value="currentSlotType.colorcode" class="form-control" style="padding-left: 2.5rem;" placeholder="#2196F3" />
                                <input type="color" @bind="currentSlotType.colorcode" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); width: 22px; height: 22px; border: 1px solid #e2e8f0; border-radius: 4px; padding: 0; background: none; cursor: pointer;" />
                            </div>
                        </div>

                        <!-- Line 3: Is Visiting and Emoji (Evenly split) -->
                        <div class="form-col span-2">
                            <label style="font-weight: 700; color: #475569; display: block; margin-bottom: 0.5rem;">Slot Behavior</label>
                            <div style="display: flex; align-items: center; gap: 0.75rem; height: 44px;">
                                <InputCheckbox @bind-Value="currentSlotType.is_visiting" id="is_visiting" style="width: 20px; height: 20px; cursor: pointer; accent-color: #026aa7;" />
                                <label for="is_visiting" style="font-weight: 600; color: #475569; cursor: pointer; font-size: 0.9rem; text-transform: none;">Is Visiting Slot?</label>
                            </div>
                        </div>
                        <div class="form-col span-2">
                            <label style="font-weight: 700; color: #475569;">Emoji Indicator</label>
                            <InputText @bind-Value="currentSlotType.emoji" class="form-control" placeholder="e.g. 🩺" />
                        </div>

                        <!-- Line 3: Description (Full Width) -->
                        <div class="form-col span-4">
                            <label style="font-weight: 700; color: #475569;">Description</label>
                            <InputTextArea @bind-Value="currentSlotType.description" class="form-control" rows="3" placeholder="Briefly describe when to use this slot type..." style="resize: none;" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                @if (currentSlotType.slot_type_id != 0)
                {
                    <button type="button" class="btn-delete-text" @onclick="() => DeleteSlotType(currentSlotType.slot_type_id)" style="color: #ef4444; background: none; border: none; font-weight: 700; cursor: pointer; padding: 0.5rem 1rem;">
                        <i class="bi bi-trash3-fill"></i> Delete Type
                    </button>
                }
                <div style="flex: 1;"></div>
                <button type="submit" class="btn-save-new" style="background: #026aa7; color: white; padding: 0.75rem 2.5rem; border-radius: 12px; border: none; font-weight: 800; display: flex; align-items: center; gap: 0.5rem; cursor: pointer; transition: all 0.2s;">
                    <i class="bi bi-check-lg"></i> Save Changes
                </button>
            </div>
        </EditForm>
    </div>
}

<div class="page-title">Appointment Slot Types</div>

<div class="filter-card">
    <div class="filter-left">
        <div class="search-input-wrapper">
            <input type="text" placeholder="Search by name or short name" class="search-input" @bind="searchQuery" @bind:event="oninput" />
        </div>
    </div>
    
    @if (TenantState.HasActionRight("Configuration", "General", "Create")) { <button class="btn-new-action" @onclick="CreateNew">
        <i class="bi bi-plus-lg"></i> New Slot Type
    </button> }
</div>

<div class="table-container">
    <div class="table-responsive">
        <table class="sharp-table">
            <thead>
                <tr>
                    <th>NAME</th>
                    <th>SHORT NAME</th>
                    <th>COLOR</th>
                    <th>VISITING</th>
                    <th>DESCRIPTION</th>
                    <th class="text-right">ACTION</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var type in FilteredSlotTypes)
                {
                    <tr>
                        <td>
                            <div class="type-name-cell">
                                @if (!string.IsNullOrWhiteSpace(type.emoji))
                                {
                                    <span style="font-size: 1.15rem; margin-right: 0.25rem;">@type.emoji</span>
                                }
                                @type.name
                            </div>
                        </td>
                        <td>
                            <span class="badge-shortname">@type.shortname</span>
                        </td>
                        <td>
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <div class="color-indicator" style="background-color: @type.colorcode"></div>
                                <code>@type.colorcode</code>
                            </div>
                        </td>
                        <td>
                            @if (type.is_visiting)
                            {
                                <span class="visiting-yes-badge">Yes</span>
                            }
                            else
                            {
                                <span class="visiting-no-badge">No</span>
                            }
                        </td>
                        <td class="description-cell">@type.description</td>
                        <td>
                            <div class="action-buttons">
                                @if (TenantState.HasActionRight("Configuration", "General", "Edit")) { <button class="btn-action edit" @onclick="() => EditSlotType(type)">
                                    <i class="bi bi-pencil"></i>
                                </button> }
                                @if (TenantState.HasActionRight("Configuration", "General", "Delete")) { <button class="btn-action delete" @onclick="() => DeleteSlotType(type.slot_type_id)">
                                    <i class="bi bi-trash"></i>
                                </button> }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
 
    <!-- Mobile Card View -->
    <div class="mobile-cards">
        @foreach (var type in FilteredSlotTypes)
        {
            <div class="mobile-card">
                <div class="card-header">
                    <div class="color-indicator" style="background-color: @type.colorcode"></div>
                    @if (!string.IsNullOrWhiteSpace(type.emoji))
                    {
                        <span style="font-size: 1.15rem; margin-right: 0.25rem;">@type.emoji</span>
                    }
                    <div class="card-title">@type.name</div>
                    <span class="badge-shortname">@type.shortname</span>
                    @if (type.is_visiting)
                    {
                        <span class="badge-visiting" style="margin-left: 8px;">Visiting</span>
                    }
                </div>
                <div class="card-body">
                    <p>@type.description</p>
                    <div class="card-meta">Color: @type.colorcode</div>
                </div>
                <div class="card-actions">
                    <button class="btn-mobile-action edit" @onclick="() => EditSlotType(type)">
                        <i class="bi bi-pencil"></i> Edit
                    </button>
                    <button class="btn-mobile-action delete" @onclick="() => DeleteSlotType(type.slot_type_id)">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
            </div>
        }
    </div>
    <!-- Pagination Bar -->
    @if (totalPages > 1)
    {
        <div class="pagination-container">
            <div class="pagination-info">
                Showing <strong>@(((ActivePage - 1) * pageSize) + 1)</strong> to <strong>@(Math.Min(ActivePage * pageSize, FilteredSlotTypesCount))</strong> of <strong>@FilteredSlotTypesCount</strong> entries
            </div>
            <div class="pagination-controls">
                <button type="button" class="btn-page nav" disabled="@(ActivePage == 1)" @onclick="PrevPage">
                    <i class="bi bi-chevron-left"></i> Previous
                </button>
                @for (int p = 1; p <= totalPages; p++)
                {
                    int pageNum = p;
                    <button type="button" class="btn-page num @(ActivePage == pageNum ? "active" : "")" @onclick="() => SetPage(pageNum)">
                        @pageNum
                    </button>
                }
                <button type="button" class="btn-page nav" disabled="@(ActivePage == totalPages)" @onclick="NextPage">
                    Next <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private List<DoctorAppointmentSlotTypeModel> slotTypes = new();
    private string searchQuery = "";
    private DoctorAppointmentSlotTypeModel currentSlotType = new();
    private bool showForm = false;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => (int)Math.Ceiling((double)FilteredSlotTypesCount / pageSize);
    private int FilteredSlotTypesCount => FilteredSlotTypesBase.Count();
    
    private int ActivePage 
    {
        get 
        {
            int maxPage = Math.Max(1, totalPages);
            if (currentPage > maxPage) currentPage = maxPage;
            return currentPage;
        }
    }

    private IEnumerable<DoctorAppointmentSlotTypeModel> FilteredSlotTypesBase => 
        string.IsNullOrWhiteSpace(searchQuery) 
        ? slotTypes 
        : slotTypes.Where(t => 
            (t.name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) || 
            (t.shortname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
        );

    private IEnumerable<DoctorAppointmentSlotTypeModel> FilteredSlotTypes => 
        FilteredSlotTypesBase.Skip((ActivePage - 1) * pageSize).Take(pageSize);

    private void SetPage(int page) { 
        if (page >= 1 && page <= totalPages) currentPage = page; 
    }
    private void PrevPage() => SetPage(currentPage - 1);
    private void NextPage() => SetPage(currentPage + 1);

    protected override async Task OnInitializedAsync() => await LoadSlotTypes();
    private async Task LoadSlotTypes() => slotTypes = await SlotTypeService.GetSlotTypesAsync();
    
    private void CreateNew() { 
        currentSlotType = new DoctorAppointmentSlotTypeModel { 
            colorcode = "#2196F3",
            tenant_code = "TEN1011"
        }; 
        showForm = true; 
    }

    private void EditSlotType(DoctorAppointmentSlotTypeModel type) { 
        currentSlotType = type; 
        showForm = true; 
    }

    private async Task SaveSlotType() { 
        bool success = currentSlotType.slot_type_id > 0 
            ? await SlotTypeService.UpdateSlotTypeAsync(currentSlotType) 
            : await SlotTypeService.InsertSlotTypeAsync(currentSlotType);
        
        if (success) { 
            showForm = false; 
            await LoadSlotTypes(); 
        }
    }

    private void CancelEdit() => showForm = false;

    private async Task DeleteSlotType(long id) { 
        if (await SlotTypeService.DeleteSlotTypeAsync(id)) 
            await LoadSlotTypes(); 
    }
}
