@page "/vendormaster"
@page "/vendors"
@using Booking.Models
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.NotificationService NotificationService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject Booking.Services.ToastService ToastService

<div class="items-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Vendor Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total vendors : @VendorsList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by vendor code or name..." @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    @if (hasCreateRight)
                    {
                        <button class="add-item-btn" @onclick="AddNewVendor">
                            <i class="bi bi-plus-lg"></i>
                            <span class="ms-1">Add Vendor</span>
                        </button>
                    }
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredVendors.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        No vendors found. Adjust filters or create a new vendor.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 65px; text-align: center;">S.NO</th>
                                    <th style="width: 100px; text-align: center;">VENDOR CODE</th>
                                    <th style="width: 22%; text-align: center;">VENDOR NAME</th>
                                    <th style="width: 13%; text-align: center;">CONTACT</th>
                                    <th style="width: 12%; text-align: center;">PHONE</th>
                                    <th style="width: 16%; text-align: center;">GST NO</th>
                                    <th style="width: 11%; text-align: center;">REG NO</th>
                                    <th style="width: 14%; text-align: center;">BANK NAME</th>
                                    <th style="width: 100px; text-align: center;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedVendors.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td style="text-align: center; font-weight: 700; color: #3b82f6;">@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td style="text-align: center; font-weight: 700; color: #4f46e5;">#@row.value.vendorCode</td>
                                        <td style="font-weight: 700; color: #0f172a; text-align: center;">@row.value.vendorName</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.contactPerson) ? "N/A" : row.value.contactPerson)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.phoneNumber) ? "N/A" : row.value.phoneNumber)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.gstNumber) ? "N/A" : row.value.gstNumber)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.registrationNumber) ? "N/A" : row.value.registrationNumber)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.bankName) ? "N/A" : row.value.bankName)</td>
                                        <td>
                                            @if (hasEditRight)
                                            {
                                                <button class="action-btn btn-edit" @onclick="async () => await EditVendor(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            }
                                            @if (hasDeleteRight)
                                            {
                                                <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var v in PagedVendors)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span>#@v.vendorCode - @v.vendorName</span>
                                    <div>
                                        @if (hasEditRight)
                                        {
                                            <button class="action-btn btn-edit" @onclick="async () => await EditVendor(v)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(v)" title="Delete"><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Contact</span><strong>@v.contactPerson</strong></div>
                                    <div class="detail-row"><span>Phone</span><strong>@v.phoneNumber</strong></div>
                                    <div class="detail-row"><span>GST NO</span><strong>@v.gstNumber</strong></div>
                                    <div class="detail-row"><span>Reg No</span><strong>@v.registrationNumber</strong></div>
                                    <div class="detail-row"><span>Bank</span><strong>@v.bankName</strong></div>
                                    <div class="detail-row"><span>Account</span><strong>@v.accountNumber</strong></div>
                                    <div class="detail-row"><span>IFSC</span><strong>@v.ifscCode</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredVendors.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredVendors.Count()))</strong> of <strong>@FilteredVendors.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>


@if (ShowVendorModal)
{
    <div class="modal-overlay">
        <div class="modal-card vendor-master-modal-card" @onclick:stopPropagation="true" style="max-width: 950px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #000000 !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsModalEdit ? "Edit Vendor" : "Add Vendor")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseVendorModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentVendor" OnValidSubmit="SaveVendorFromModal" autocomplete="off">
                    <div class="modal-scroll-area vendor-master-modal-scroll-area purchase-bill-fields" style="overflow-x: hidden; padding: 8px 12px 12px 0px;">
                        <!-- Section 1: General Information -->
                        <div class="form-section-header" style="margin-bottom: 10px; margin-top: 4px; padding-bottom: 4px; border-bottom: 1px solid #f1f5f9;">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">General Information</div>
                        </div>

                        <div class="form-grid" style="margin-bottom: 12px; row-gap: 12px;">
                            <div class="field-group col-2">
                                <label class="field-label">Short Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.shortName" placeholder="e.g. ABC" />
                            </div>
                            <div class="field-group col-4">
                                <label class="field-label">Vendor Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.vendorName" placeholder="e.g. ABC Global Suppliers" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Vendor Type</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.vendorType" placeholder="e.g. Supplier" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Contact Person</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.contactPerson" placeholder="e.g. Advik" />
                            </div>
                        </div>

                        <div class="form-grid" style="margin-bottom: 12px; row-gap: 12px; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1.8fr) minmax(0, 2.7fr) minmax(0, 2.7fr) minmax(0, 3.0fr);">
                            <div class="field-group" style="margin-top: 4px;">
                                <label class="field-label">Phone Number</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.phoneNumber" placeholder="9876543210" />
                            </div>
                            <div class="field-group" style="margin-top: 4px;">
                                <label class="field-label">Alt Phone</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.alternatePhoneNumber" placeholder="9123456780" />
                            </div>
                            <div class="field-group" style="margin-top: 4px;">
                                <label class="field-label">Email ID</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.emailId" placeholder="abc@gmail.com" />
                            </div>
                            <div class="field-group" style="margin-top: 4px;">
                                <label class="field-label">Website</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.website" placeholder="www.abc.com" />
                            </div>
                            <div class="field-group" style="margin-top: 4px;">
                                <label class="field-label">DL No</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.druglicenseno" placeholder="TN-ERD-20B-123456" />
                            </div>
                        </div>

                        <div class="form-grid" style="margin-bottom: 12px; row-gap: 12px;">
                            <div class="field-group col-2" style="margin-top: 4px;">
                                <label class="field-label">Registration No</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.registrationNumber" placeholder="REG001" />
                            </div>
                            <div class="field-group col-2" style="margin-top: 4px;">
                                <label class="field-label">GST No</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.gstNumber" placeholder="29ABCDE1234F1Z5" />
                            </div>
                            <div class="field-group col-2" style="margin-top: 4px;">
                                <label class="field-label">PAN No</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.panNumber" placeholder="ABCDE1234F" />
                            </div>
                            <div class="field-group col-2" style="margin-top: 4px;">
                                <label class="field-label">Tax ID</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.taxId" placeholder="VAT123456" />
                            </div>
                            <div class="field-group col-2" style="margin-top: 4px;">
                                <label class="field-label">FSSAI No</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.fssaino" placeholder="12345678901234" />
                            </div>
                            <div class="field-group col-2" style="margin-top: 4px;">
                                <label class="field-label">Vendor Rating</label>
                                <InputNumber class="form-control premium-input" @bind-Value="CurrentVendor.vendorrating" placeholder="0.0" min="0" max="5" step="0.1" />
                            </div>
                        </div>

                        <!-- Section 2: Address Details -->
                        <div class="form-section-header" style="margin-bottom: 8px; margin-top: 14px; padding-bottom: 2px; border-bottom: 1px solid #f1f5f9;">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Address Details</div>
                        </div>

                        <div class="form-grid" style="margin-bottom: 12px; row-gap: 12px;">
                            <div class="field-group col-6">
                                <label class="field-label">Address Line 1</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.addressLine1" placeholder="MG Road" />
                            </div>
                            <div class="field-group col-6">
                                <label class="field-label">Address Line 2</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.addressLine2" placeholder="Near Metro" />
                            </div>

                            <div class="field-group col-3" style="margin-top: 4px;">
                                <label class="field-label">City</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.city" placeholder="Bangalore" />
                            </div>
                            <div class="field-group col-3" style="margin-top: 4px;">
                                <label class="field-label">District</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.district" placeholder="Bangalore Urban" />
                            </div>
                            <div class="field-group col-3" style="margin-top: 4px;">
                                <label class="field-label">State</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.state" placeholder="Karnataka" />
                            </div>
                            <div class="field-group col-3" style="margin-top: 4px;">
                                <label class="field-label">Postal Code</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.postalCode" placeholder="560001" />
                            </div>

                            <div class="field-group col-4" style="margin-top: 4px;">
                                <label class="field-label">Landmark</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.landmark" placeholder="Metro Station" />
                            </div>
                            <div class="field-group col-4" style="margin-top: 4px;">
                                <label class="field-label">Country</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.countryName" placeholder="India" />
                            </div>
                            <div class="field-group col-4" style="margin-top: 4px;">
                                <label class="field-label">Country Code</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.countryCode" placeholder="IN" />
                            </div>
                        </div>

                        <!-- Section 3: Banking & Accounts -->
                        <div class="form-section-header" style="margin-bottom: 8px; margin-top: 14px; padding-bottom: 2px; border-bottom: 1px solid #f1f5f9;">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Banking & Accounts</div>
                        </div>

                        <div class="form-grid" style="margin-bottom: 12px; row-gap: 12px;">
                            <div class="field-group col-3">
                                <label class="field-label">Bank Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.bankName" placeholder="SBI" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Account Number</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.accountNumber" placeholder="123456789" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">IFSC Code</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.ifscCode" placeholder="SBIN0001234" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Swift Code</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.swiftCode" placeholder="SBININBB" />
                            </div>

                            <div class="field-group col-2" style="margin-top: 4px;">
                                <label class="field-label">IBAN Number</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.ibanNumber" placeholder="IN123456789" />
                            </div>
                            <div class="field-group col-3" style="margin-top: 4px;">
                                <label class="field-label">Payment Terms</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.paymentTerms" placeholder="30 Days" />
                            </div>
                            <div class="field-group col-2" style="margin-top: 4px;">
                                <label class="field-label">Credit Period</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.creditPeriod" placeholder="30" />
                            </div>
                            <div class="field-group col-2" style="margin-top: 4px;">
                                <label class="field-label">Currency</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.currencyCode" placeholder="INR" />
                            </div>
                            <div class="field-group col-3" style="margin-top: 4px;">
                                <label class="field-label">Branch Code</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentVendor.branchCode" placeholder="BLR001" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-actions" style="display: flex; justify-content: flex-end; align-items: center; padding: 10px 24px; border-top: 1px solid #f1f5f9; background: #fff;">
                        <div class="footer-right" style="display: flex; gap: 0.75rem; align-items: center;">
                            <button type="button" class="btn-cancel-modal" @onclick="CloseVendorModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.5rem 1.5rem; border-radius: 12px; font-weight: 700; min-width: 100px; transition: all 0.2s;">
                                Cancel
                            </button>
                            <button type="submit" class="btn-save-premium" disabled="@IsModalSaving" style="background: #1c9f5f; color: white; border: none; padding: 0.5rem 1.75rem; border-radius: 12px; font-weight: 700; display: flex; align-items: center; gap: 8px; min-width: 140px; box-shadow: 0 4px 12px rgba(28, 159, 95, 0.2); transition: all 0.2s;">
                                @if (IsModalSaving)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle" style="font-size: 1.2rem;"></i>
                                }
                                <span>@(IsModalEdit ? "Update Vendor" : "Save Vendor")</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirmPopup)
{
    <div class="action-popup-overlay" @onclick="CancelDeletePrompt">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Vendor</div>
            <div class="action-popup-body">Are you sure you want to delete this vendor?</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="CancelDeletePrompt">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" disabled="@IsDeleteProcessing" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<vendor_master> VendorsList = new();
    private string SearchQuery = string.Empty;
    private bool IsLoading;
    private bool IsCardView;
    private string DefaultTenantCode = "";

    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 12;

    // Modal state
    private bool ShowVendorModal = false;
    private bool IsModalEdit = false;
    private bool IsModalSaving = false;
    private bool ShowDeleteConfirmPopup = false;
    private bool IsDeleteProcessing = false;
    private vendor_master? PendingDeleteVendor;
    private vendor_master CurrentVendor = new() { tenantCode = "", isActive = true };

    private IEnumerable<vendor_master> FilteredVendors =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? VendorsList
            : VendorsList.Where(v =>
                (v.vendorName?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                v.vendorCode.ToString().Contains(SearchQuery, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<vendor_master> PagedVendors =>
        FilteredVendors.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    private int TotalPages => (int)Math.Ceiling((double)FilteredVendors.Count() / ItemsPerPage);

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        CurrentPage = 1;
    }

    private bool hasViewRight = true;
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
            
            try
            {
                bool isAdmin = false;
                try
                {
                    var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userResult.Success && userResult.Value != null)
                    {
                        isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                  userResult.Value.UserCode == 0 ||
                                  userResult.Value.UserCode == 1;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking user details: {ex.Message}");
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                    hasEditRight = true;
                    hasDeleteRight = true;
                }
                else
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var pageRight = rightsResult.Value.FirstOrDefault(r => 
                            r.ModuleName != null && 
                            r.ModuleName.Trim().Equals("Vendor_Master", StringComparison.OrdinalIgnoreCase));
                        
                        if (pageRight != null)
                        {
                            hasViewRight = pageRight.ToView;
                            hasCreateRight = pageRight.ToAdd;
                            hasEditRight = pageRight.ToEdit;
                            hasDeleteRight = pageRight.ToDelete;
                        }
                        else
                        {
                            hasViewRight = false;
                            hasCreateRight = false;
                            hasEditRight = false;
                            hasDeleteRight = false;
                        }
                    }
                    else
                    {
                        hasViewRight = false;
                        hasCreateRight = false;
                        hasEditRight = false;
                        hasDeleteRight = false;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking Vendor_Master rights: {ex.Message}");
                hasViewRight = false;
                hasCreateRight = false;
                hasEditRight = false;
                hasDeleteRight = false;
            }

            if (!hasViewRight)
            {
                ToastService.ShowError("You do not have permission to access Vendor Master.");
                Nav.NavigateTo("/home");
                return;
            }
            
            await LoadVendors();
            StateHasChanged();
        }
    }

    private HttpClient CreateTenantClient()
    {
        var client = ClientFactory.CreateClient("InventoryApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenantCode);
        return client;
    }

    private void SetView(bool cardView)
    {
        IsCardView = cardView;
        CurrentPage = 1;
    }

    private async Task LoadVendors()
    {
        IsLoading = true;
        try
        {
            var client = CreateTenantClient();
            var responseString = await client.GetStringAsync("ItemMaster/getallvendors");

            try
            {
                var direct = System.Text.Json.JsonSerializer.Deserialize<List<vendor_master>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                VendorsList = (direct ?? new List<vendor_master>()).Where(x => !x.deleted).ToList();
            }
            catch
            {
                var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<vendor_master>>>(responseString, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                VendorsList = (wrapped?.data ?? new List<vendor_master>()).Where(x => !x.deleted).ToList();
            }
        }
        catch (Exception ex)
        {
            VendorsList = new List<vendor_master>();
            NotificationService.ShowNotification($"Failed to load vendors: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void AddNewVendor()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add vendors.");
            return;
        }
        OpenAddModal();
    }

    private async Task EditVendor(vendor_master vendor)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit vendors.");
            return;
        }
        await OpenEditModal(vendor);
    }

    private void OpenAddModal()
    {
        CurrentVendor = new vendor_master { tenantCode = DefaultTenantCode, isActive = true };
        IsModalEdit = false;
        ShowVendorModal = true;
    }

    private async Task OpenEditModal(vendor_master vendor)
    {
        IsModalEdit = true;
        ShowVendorModal = true;
        try
        {
            var client = CreateTenantClient();
            var response = await client.GetStringAsync($"ItemMaster/getvendorbycode?vendorcode={vendor.vendorCode}");
            var loaded = ParseVendorResponse(response);
            if (loaded is not null)
            {
                loaded.tenantCode = DefaultTenantCode;
                CurrentVendor = loaded;
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error loading vendor: {ex.Message}", NotificationType.Error);
        }
    }

    private void CloseVendorModal()
    {
        ShowVendorModal = false;
        IsModalSaving = false;
        CurrentVendor = new vendor_master { tenantCode = DefaultTenantCode, isActive = true };
    }

    private async Task SaveVendorFromModal()
    {
        if (IsModalEdit && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit vendors.");
            return;
        }
        if (!IsModalEdit && !hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add vendors.");
            return;
        }
        IsModalSaving = true;
        try
        {
            var client = CreateTenantClient();
            CurrentVendor.tenantCode = DefaultTenantCode;
            
            // Sanitize all string fields to pass empty string if null
            CurrentVendor.vendorName ??= "";
            CurrentVendor.contactPerson ??= "";
            CurrentVendor.phoneNumber ??= "";
            CurrentVendor.gstNumber ??= "";
            CurrentVendor.panNumber ??= "";
            CurrentVendor.taxId ??= "";
            CurrentVendor.registrationNumber ??= "";
            CurrentVendor.bankName ??= "";
            CurrentVendor.accountNumber ??= "";
            CurrentVendor.ifscCode ??= "";
            CurrentVendor.swiftCode ??= "";
            CurrentVendor.ibanNumber ??= "";
            CurrentVendor.shortName ??= "";
            CurrentVendor.vendorType ??= "";
            CurrentVendor.alternatePhoneNumber ??= "";
            CurrentVendor.emailId ??= "";
            CurrentVendor.website ??= "";
            CurrentVendor.addressLine1 ??= "";
            CurrentVendor.addressLine2 ??= "";
            CurrentVendor.landmark ??= "";
            CurrentVendor.city ??= "";
            CurrentVendor.district ??= "";
            CurrentVendor.state ??= "";
            CurrentVendor.postalCode ??= "";
            CurrentVendor.countryCode ??= "";
            CurrentVendor.countryName ??= "";
            CurrentVendor.currencyCode ??= "";
            CurrentVendor.paymentTerms ??= "";
            CurrentVendor.creditPeriod ??= "";
            CurrentVendor.branchCode ??= "";
            CurrentVendor.druglicenseno ??= "";
            CurrentVendor.fssaino ??= "";
            
            var isUpdate = CurrentVendor.vendorCode > 0;

            // Serialize and display payload in the console/terminal
            var serializeOptions = new System.Text.Json.JsonSerializerOptions {
                WriteIndented = true,
                PropertyNamingPolicy = null
            };
            var json = System.Text.Json.JsonSerializer.Serialize(CurrentVendor, serializeOptions);
            Console.WriteLine("--- VENDOR JSON PAYLOAD ---");
            Console.WriteLine(json);
            Console.WriteLine("----------------------------");
            await JS.InvokeVoidAsync("console.log", "Sending Vendor JSON Payload:", json);

            HttpResponseMessage response;
            if (isUpdate)
            {
                response = await client.PostAsJsonAsync("ItemMaster/updatevendor", CurrentVendor);
            }
            else
            {
                response = await client.PostAsJsonAsync("ItemMaster/upsertvendor", CurrentVendor);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification(isUpdate ? "Vendor updated successfully" : "Vendor added successfully", NotificationType.Success);
                CloseVendorModal();
                await LoadVendors();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.ShowNotification($"Save failed: {error}", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsModalSaving = false;
        }
    }

    private void ConfirmDelete(vendor_master vendor)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete vendors.");
            return;
        }
        PendingDeleteVendor = vendor;
        ShowDeleteConfirmPopup = true;
    }

    private void CancelDeletePrompt()
    {
        ShowDeleteConfirmPopup = false;
        IsDeleteProcessing = false;
        PendingDeleteVendor = null;
    }

    private async Task DeleteConfirmed()
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete vendors.");
            return;
        }
        var vendor = PendingDeleteVendor;
        if (vendor is null)
        {
            CancelDeletePrompt();
            return;
        }

        IsDeleteProcessing = true;
        try
        {
            var client = CreateTenantClient();
            var response = await client.GetAsync($"ItemMaster/deletevendor?vendorcode={vendor.vendorCode}");
            
            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification("Vendor deleted successfully", NotificationType.Success);
                await LoadVendors();
                CancelDeletePrompt();
            }
            else
            {
                NotificationService.ShowNotification("Delete failed.", NotificationType.Error);
                CancelDeletePrompt();
            }
        }
        catch (Exception ex)
        {
            CancelDeletePrompt();
            NotificationService.ShowNotification($"Error deleting vendor: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsDeleteProcessing = false;
        }
    }

    private vendor_master? ParseVendorResponse(string json)
    {
        var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };

        try
        {
            var direct = System.Text.Json.JsonSerializer.Deserialize<vendor_master>(json, options);
            if (direct is not null && direct.vendorCode > 0)
            {
                return direct;
            }
        }
        catch { }

        try
        {
            var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<vendor_master>>(json, options);
            if (wrapped?.data is not null && wrapped.data.vendorCode > 0)
            {
                return wrapped.data;
            }
        }
        catch { }

        return null;
    }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            StateHasChanged();
        }
    }
}



