@page "/result-search"
@using Booking.Models
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject Booking.Services.LabResultService ResultService
@inject NavigationManager Navigation
@inject Booking.Services.ToastService Toast

<PageTitle>Result Search - Laboratory Management</PageTitle>

<div class="re-container" style="padding: 16px 20px 80px; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: #f8fafc; min-height: 100vh;">

    <!-- Header Section -->
    <div style="background: linear-gradient(135deg, #1e293b, #334155); border-radius: 16px; padding: 20px 24px; color: white; display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);">
        <div>
            <h2 style="margin: 0; font-size: 1.25rem; font-weight: 800; letter-spacing: -0.02em;">Laboratory Result Search</h2>
            <p style="margin: 4px 0 0; font-size: 0.8rem; color: #94a3b8; font-weight: 500;">Search patient lab test requests, view results, and authorize reports.</p>
        </div>
        <div>
            <button class="btn-primary-custom" style="background: linear-gradient(135deg, #4f46e5, #4338ca); color: white; border: none; padding: 8px 18px; border-radius: 10px; font-weight: 700; font-size: 0.85rem; cursor: pointer;" @onclick="PerformSearch">
                <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">refresh</span> Refresh Data
            </button>
        </div>
    </div>

    <!-- Search Controls Card -->
    <div style="background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; padding: 16px 20px; margin-bottom: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);">
        <div style="display: grid; grid-template-columns: repeat(4, 1fr) 120px; gap: 12px; align-items: flex-end;">
            <div>
                <label style="font-size: 0.7rem; font-weight: 700; color: #64748b; text-transform: uppercase; display: block; margin-bottom: 4px;">From Date</label>
                <input type="date" class="form-control-custom" @bind="fromDate" style="width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.85rem;" />
            </div>
            <div>
                <label style="font-size: 0.7rem; font-weight: 700; color: #64748b; text-transform: uppercase; display: block; margin-bottom: 4px;">To Date</label>
                <input type="date" class="form-control-custom" @bind="toDate" style="width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.85rem;" />
            </div>
            <div style="grid-column: span 2;">
                <label style="font-size: 0.7rem; font-weight: 700; color: #64748b; text-transform: uppercase; display: block; margin-bottom: 4px;">Quick Search (Name / Doctor / Mobile / Bill)</label>
                <input type="text" placeholder="Filter search results..." class="form-control-custom" @bind="searchTerm" @bind:event="oninput" style="width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.85rem;" />
            </div>
            <div>
                <button style="width: 100%; height: 38px; background: #2563eb; color: white; border: none; border-radius: 8px; font-weight: 700; font-size: 0.85rem; cursor: pointer;" @onclick="PerformSearch">
                    Search
                </button>
            </div>
        </div>
    </div>

    <!-- Status Tabs -->
    <div style="display: flex; gap: 8px; margin-bottom: 16px;">
        <button class="status-tab @(selectedFilter == "ALL" ? "active" : "")" @onclick='() => selectedFilter = "ALL"'>
            All Requests (@searchResults.Count)
        </button>
        <button class="status-tab @(selectedFilter == "PENDING" ? "active" : "")" @onclick='() => selectedFilter = "PENDING"'>
            Pending (@searchResults.Count(r => r.resultstatus != true))
        </button>
        <button class="status-tab @(selectedFilter == "COMPLETED" ? "active" : "")" @onclick='() => selectedFilter = "COMPLETED"'>
            Completed (@searchResults.Count(r => r.resultstatus == true))
        </button>
        <button class="status-tab @(selectedFilter == "AUTHORIZED" ? "active" : "")" @onclick='() => selectedFilter = "AUTHORIZED"'>
            Authorized (@searchResults.Count(r => r.isauthorized1 == true))
        </button>
    </div>

    <!-- Results Data Table Card -->
    <div style="background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);">
        @if (isLoading)
        {
            <div style="padding: 40px; text-align: center; color: #64748b; font-weight: 600;">Loading search records...</div>
        }
        else if (!FilteredResults.Any())
        {
            <div style="padding: 40px; text-align: center; color: #94a3b8; font-weight: 600;">No test requests found for the selected date range.</div>
        }
        else
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.825rem; text-align: left;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; text-transform: uppercase; font-size: 0.7rem; font-weight: 800;">
                            <th style="padding: 12px 16px;">S.No / Bill</th>
                            <th style="padding: 12px 16px;">Date & Time</th>
                            <th style="padding: 12px 16px;">Patient Name</th>
                            <th style="padding: 12px 16px;">Doctor</th>
                            <th style="padding: 12px 16px;">Test / Group</th>
                            <th style="padding: 12px 16px;">Amount</th>
                            <th style="padding: 12px 16px;">Result Status</th>
                            <th style="padding: 12px 16px;">Approval</th>
                            <th style="padding: 12px 16px; text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredResults)
                        {
                            <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.15s ease;" class="table-row-hover">
                                <td style="padding: 12px 16px; font-weight: 700; color: #0f172a;">
                                    #@item.requestsno
                                    @if (!string.IsNullOrEmpty(item.billnoprint))
                                    {
                                        <div style="font-size: 0.725rem; color: #64748b;">Bill: @item.billnoprint</div>
                                    }
                                </td>
                                <td style="padding: 12px 16px; color: #475569;">
                                    @item.requestdatetime.ToString("dd-MMM-yyyy")
                                    <div style="font-size: 0.725rem; color: #94a3b8;">@item.requestdatetime.ToString("hh:mm tt")</div>
                                </td>
                                <td style="padding: 12px 16px; font-weight: 700; color: #1e293b;">
                                    @item.name
                                    @if (!string.IsNullOrEmpty(item.mobile))
                                    {
                                        <div style="font-size: 0.725rem; color: #64748b; font-weight: 500;">📱 @item.mobile</div>
                                    }
                                </td>
                                <td style="padding: 12px 16px; color: #334155; font-weight: 600;">
                                    @(string.IsNullOrEmpty(item.doctorfullname) ? (string.IsNullOrEmpty(item.doctor) ? "Self" : item.doctor) : item.doctorfullname)
                                </td>
                                <td style="padding: 12px 16px; color: #0f172a; font-weight: 600;">
                                    @if (!string.IsNullOrEmpty(item.testname))
                                    {
                                        <div>@item.testname</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.groupname))
                                    {
                                        <div style="font-size: 0.725rem; color: #6366f1;">Group: @item.groupname</div>
                                    }
                                </td>
                                <td style="padding: 12px 16px; font-weight: 700; color: #059669;">
                                    ₹@item.totalamount.ToString("F2")
                                    @if (item.balance > 0)
                                    {
                                        <div style="font-size: 0.725rem; color: #dc2626;">Due: ₹@item.balance.ToString("F2")</div>
                                    }
                                </td>
                                <td style="padding: 12px 16px;">
                                    @if (item.resultstatus == true)
                                    {
                                        <span class="badge-status badge-success">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-warning">Pending</span>
                                    }
                                </td>
                                <td style="padding: 12px 16px;">
                                    @if (item.isauthorized1 == true)
                                    {
                                        <span class="badge-status badge-info">Authorized</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-secondary">Unapproved</span>
                                    }
                                </td>
                                <td style="padding: 12px 16px; text-align: right;">
                                    <button class="btn-action" style="background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; padding: 5px 12px; border-radius: 6px; font-weight: 700; font-size: 0.75rem; cursor: pointer; margin-left: 4px;" @onclick="() => NavigateToEntry(item.requestguid)">
                                        Entry
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .status-tab {
        padding: 8px 16px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 700;
        color: #475569;
        cursor: pointer;
    }
    .status-tab.active {
        background: #2563eb;
        color: #ffffff;
        border-color: #2563eb;
    }
    .badge-status {
        padding: 3px 8px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 700;
        display: inline-block;
    }
    .badge-success { background: #d1fae5; color: #047857; }
    .badge-warning { background: #fef3c7; color: #b45309; }
    .badge-info { background: #e0f2fe; color: #0369a1; }
    .badge-secondary { background: #f1f5f9; color: #64748b; }
    .table-row-hover:hover { background: #f8fafc; }
</style>

@code {
    private DateTime fromDate = DateTime.Today.AddDays(-7);
    private DateTime toDate = DateTime.Today;
    private string searchTerm = string.Empty;
    private string selectedFilter = "ALL";
    private bool isLoading = false;

    private List<medico_backend.Model.ViewResultSearch> searchResults = new();

    private IEnumerable<medico_backend.Model.ViewResultSearch> FilteredResults
    {
        get
        {
            var query = searchResults.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLower();
                query = query.Where(r =>
                    (r.name != null && r.name.ToLower().Contains(term)) ||
                    (r.doctor != null && r.doctor.ToLower().Contains(term)) ||
                    (r.mobile != null && r.mobile.Contains(term)) ||
                    (r.billnoprint != null && r.billnoprint.ToLower().Contains(term)) ||
                    (r.testname != null && r.testname.ToLower().Contains(term))
                );
            }

            if (selectedFilter == "PENDING")
            {
                query = query.Where(r => r.resultstatus != true);
            }
            else if (selectedFilter == "COMPLETED")
            {
                query = query.Where(r => r.resultstatus == true);
            }
            else if (selectedFilter == "AUTHORIZED")
            {
                query = query.Where(r => r.isauthorized1 == true);
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await PerformSearch();
    }

    private async Task PerformSearch()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var fromStr = fromDate.ToString("yyyy-MM-dd");
            var toStr = toDate.ToString("yyyy-MM-dd");
            searchResults = await ResultService.ViewResultSearchAsync(fromStr, toStr);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error loading search records: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void NavigateToEntry(string requestGuid)
    {
        if (!string.IsNullOrEmpty(requestGuid))
        {
            Navigation.NavigateTo($"/result-entry/{requestGuid}");
        }
    }
}
