@page "/beds"
@page "/bed-master"
@rendermode InteractiveServer

@using Medico_Backend.Model
@using Booking.Services
@using Newtonsoft.Json
@using Booking.Models
@inject BedMasterService BedService
@inject RoomTypeMasterService RoomTypeService
@inject WardMasterService WardService
@inject FloorMasterService FloorService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IHttpClientFactory ClientFactory
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">single_bed</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Bed Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Bed Classification Inventory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search beds..." @bind="SearchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewBed">+ Add New</button>
            </div>
        </div>
    </div>

    @* --- directory list --- *@
    <div class="directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">ORDER NO</th>
                        <th style="width: 120px;">SHORT NAME</th>
                        <th>BED NAME</th>
                        <th>ROOM TYPE</th>
                        <th>WARD</th>
                        <th>FLOOR</th>
                        <th>BRANCH</th>
                        <th>LAUNDRY</th>
                        <th class="text-center" style="width: 120px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (beds != null && beds.Any())
                    {
                        @foreach (var b in FilteredBedsBySearch)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"{b.orderno:00}")</span></td>
                                <td class="lc-color-slate-500 lc-font-mono lc-font-700 lc-font-13">@b.shortname</td>
                                <td class="font-bold text-slate-800">@b.bedname</td>
                                <td><span class="lc-color-slate-600 font-bold">@(roomTypes.FirstOrDefault(r => r.rmtcode == b.rmtcode)?.name ?? b.rmtcode?.ToString() ?? "-")</span></td>
                                <td><span class="lc-color-slate-600 font-bold">@(wards.FirstOrDefault(w => w.wrdcode == b.wrdcode)?.name ?? b.wrdcode?.ToString() ?? "-")</span></td>
                                <td><span class="lc-color-slate-600 font-bold">@(floorsList.FirstOrDefault(f => f.flrcode == b.flrcode)?.name ?? b.flrcode.ToString())</span></td>
                                <td><span class="lc-color-slate-600 font-bold">@(branches.FirstOrDefault(br => br.bh_code == b.branchcode)?.name ?? b.branchcode?.ToString() ?? "-")</span></td>
                                <td><span class="font-bold @(b.islaundry == true ? "text-success" : "text-slate-400")">@(b.islaundry == true ? "Yes" : "No")</span></td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px;">
                                        <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => EditBed(b)" title="Edit">
                                            <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                        </button>
                                        <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => PromptDelete(b.bedcode)" title="Delete">
                                            <span class="material-symbols-outlined font-18 text-slate-400">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center p-48 text-slate-400 italic">No bed records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- FORM SECTION (Modal) --- *@
@if (showForm)
{
    <div class="modal-overlay">
        <div class="modal-form-card">
            <div class="modal-header-bar">
                <h3>@(isEditMode ? "Edit Bed" : "Bed Entry")</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-0 form-section">
                    <div class="mt-0">
                        @* Line 1: Bed Name, Short Name *@
                        <div style="display: grid; grid-template-columns: 3.5fr 1fr; gap: 1.25rem;">
                            <div class="form-group position-relative">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label style="margin-bottom: 0;">Bed Name *</label>
                                    @if (isSubmitted && string.IsNullOrEmpty(current.bedname))
                                    {
                                        <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                    }
                                </div>
                                <input type="text" class="lab-input" @bind="current.bedname" placeholder="e.g. Bed-101" required />
                            </div>
                            <div class="form-group">
                                <label>Short Name</label>
                                <input type="text" class="lab-input" @bind="current.shortname" placeholder="e.g. B101" />
                            </div>
                        </div>

                        @* Line 2: Order no, Room Type, Ward *@
                        <div class="um-grid-cols-3">
                            <div class="form-group">
                                <label>Order no</label>
                                <input type="number" class="lab-input" @bind="current.orderno" />
                            </div>
                            <div class="form-group">
                                <label>Room Type</label>
                                <select class="lab-input" @bind="current.rmtcode">
                                    <option value="">-- Select Room Type --</option>
                                    @foreach (var r in roomTypes)
                                    {
                                        <option value="@r.rmtcode">@r.name</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Ward</label>
                                <select class="lab-input" @bind="current.wrdcode">
                                    <option value="">-- Select Ward --</option>
                                    @foreach (var w in wards)
                                    {
                                        <option value="@w.wrdcode">@w.name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        @* Line 3: Floor, Branch, Description *@
                        <div class="um-grid-cols-3">
                            <div class="form-group">
                                <label>Floor</label>
                                <select class="lab-input" @bind="current.flrcode">
                                    <option value="0">-- Select Floor --</option>
                                    @foreach (var f in floorsList)
                                    {
                                        <option value="@f.flrcode">@f.name</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Branch</label>
                                <select class="lab-input" @bind="current.branchcode">
                                    <option value="">-- Select Branch --</option>
                                    @foreach (var b in branches)
                                    {
                                        <option value="@b.bh_code">@b.name</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Description</label>
                                <input type="text" class="lab-input" @bind="current.description" placeholder="e.g. Near window" />
                            </div>
                        </div>

                        @* Line 4: Is Laundry *@
                        <div class="um-grid-row">
                            <div class="form-group" style="flex-direction: row; align-items: center; gap: 8px; margin-top: 8px;">
                                <input type="checkbox" id="islaundry" @bind="current.islaundry" style="width: 16px; height: 16px; cursor: pointer;" />
                                <label for="islaundry" style="margin-bottom: 0; cursor: pointer; text-transform: none; font-size: 13px; color: #475569; font-weight: 600;">Is Laundry Required</label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            
            <div class="modal-footer-bar">
                <button type="button"
                        class="btn-delete"
                        @onclick="() => PromptDelete(current.bedcode)"
                        disabled="@(current.bedcode == 0)">
                    Delete
                </button>
                <button type="button" class="btn-save" @onclick="SaveBed">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                    </svg>
                    Save Bed
                </button>
            </div>
        </div>
    </div>
}

@* --- DELETE CONFIRMATION MODAL --- *@
@if (showDeleteConfirm)
{
    <div class="modal-overlay">
        <div class="modal-form-card delete-confirm-card" style="max-width: 400px; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: white; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
            <div style="text-align: center; margin-bottom: 20px;">
                <p style="margin: 0; font-size: 15px; font-weight: 600; color: #1e293b;">Are you sure you want to delete the bed?</p>
            </div>
            <div style="display: flex; justify-content: center; gap: 12px; width: 100%;">
                <button type="button" class="btn-secondary-outline" @onclick="CancelDelete" style="flex: 1; max-width: 120px; border-radius: 6px;">Cancel</button>
                <button type="button" class="btn-danger-filled" @onclick="ExecuteDelete" style="flex: 1; max-width: 120px; border-radius: 6px;">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<BedMasterModel> beds = new();
    private List<RoomTypeMasterModel> roomTypes = new();
    private List<WardMasterModel> wards = new();
    private List<FloorMasterModel> floorsList = new();
    private BedMasterModel current = new();
    private bool isEditMode = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";
    private bool showDeleteConfirm = false;
    private int deleteBedCode = 0;

    private IEnumerable<BedMasterModel> FilteredBeds =>
        beds.Where(b => b.deleted != true);

    private IEnumerable<BedMasterModel> FilteredBedsBySearch =>
        FilteredBeds.Where(b => 
            string.IsNullOrWhiteSpace(SearchQuery) || 
            (b.bedname != null && b.bedname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (b.shortname != null && b.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (b.description != null && b.description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadBeds();
        await LoadDropdowns();
    }

    private async Task LoadBeds()
    {
        try
        {
            beds = await BedService.GetBedMastersAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading beds: {ex.Message}");
        }
    }

    private async Task LoadDropdowns()
    {
        try
        {
            roomTypes = await RoomTypeService.GetRoomTypeMastersAsync();
            wards = await WardService.GetWardMastersAsync();
            floorsList = await FloorService.GetFloorMastersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dropdown metadata: {ex.Message}");
        }
    }

    private void NewBed()
    {
        current = new BedMasterModel { 
            deleted = false,
            computercode = 1,
            usercode = 1,
            entereddate = DateTime.Now,
            ibsdate = DateTime.Now,
            orderno = beds.Count + 1,
            tenant_code = "TEN007",
            branchcode = null,
            rmtcode = null,
            wrdcode = null,
            flrcode = 0,
            islaundry = false
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private void EditBed(BedMasterModel b)
    {
        if (b == null) return;
        current = new BedMasterModel
        {
            bedcode = b.bedcode,
            tenant_code = b.tenant_code,
            orderno = b.orderno,
            shortname = b.shortname,
            bedname = b.bedname,
            description = b.description,
            deleted = b.deleted,
            usercode = b.usercode,
            computercode = b.computercode,
            entereddate = b.entereddate,
            ibsdate = b.ibsdate,
            branchcode = b.branchcode,
            rmtcode = b.rmtcode,
            wrdcode = b.wrdcode,
            flrcode = b.flrcode,
            hdcode = b.hdcode,
            islaundry = b.islaundry
        };
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveBed()
    {
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(current.bedname))
        {
            ToastService.ShowError("Bed Name is required.");
            StateHasChanged();
            return;
        }

        try
        {
            current.tenant_code = "TEN007";
            current.computercode = 1;
            current.usercode = 1;
            current.ibsdate = DateTime.Now;

            bool success;
            if (isEditMode)
            {
                success = await BedService.UpdateBedMasterAsync(current);
            }
            else
            {
                current.entereddate = DateTime.Now;
                success = await BedService.InsertBedMasterAsync(current);
            }

            if (success)
            {
                await LoadBeds();
                ToastService.ShowSuccess(isEditMode ? "Bed updated successfully!" : "Bed added successfully!");
                if (isEditMode)
                {
                    showForm = false;
                }
                else
                {
                    NewBed();
                }
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Save failed on backend.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving bed: {ex.Message}");
            StateHasChanged();
        }
    }

    private void PromptDelete(int bedcode)
    {
        if (bedcode == 0) return;
        deleteBedCode = bedcode;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        deleteBedCode = 0;
        showDeleteConfirm = false;
    }

    private async Task ExecuteDelete()
    {
        if (deleteBedCode == 0) return;
        try
        {
            bool success = await BedService.DeleteBedMasterAsync(deleteBedCode);
            if (success)
            {
                await LoadBeds();
                ToastService.ShowSuccess("Bed deleted successfully!");
                if (current != null && current.bedcode == deleteBedCode)
                {
                    showForm = false;
                }
                showDeleteConfirm = false;
                deleteBedCode = 0;
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Delete failed on backend.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting: {ex.Message}");
            StateHasChanged();
        }
    }

    private void CloseForm()
    {
        current = new BedMasterModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }

    private List<Booking.Models.BranchModel> branches = new();
    private string TenantCode = "";
    private string AuthToken = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                await LoadBranchesAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error loading session details: {ex.Message}");
            }
        }
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
            }
            if (!string.IsNullOrEmpty(AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
            }

            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                branches = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branches = branches.Where(b => !b.deleted).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }
}
