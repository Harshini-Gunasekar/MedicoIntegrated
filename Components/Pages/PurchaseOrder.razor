    // ─── ROW CALCULATIONS & MANAGEMENT ─────────────────────────────────────────

    private void AddDetailRow()
    {
        var newRow = new purchase_order_detail
        {
            tenantcode = DefaultTenant,
            packing = 1,
            quantity = 1,
            discountpercentage = 0
        };
        CurrentRequest.details.Add(newRow);
    }

    private void RemoveDetailRow(purchase_order_detail detail)
    {
        CurrentRequest.details.Remove(detail);
        if (!CurrentRequest.details.Any())
        {
            AddDetailRow();
        }
        CalculateTotals();
    }

    private void CalculateRow(purchase_order_detail detail)
    {
        var lineGross = detail.quantity * detail.orderrate;
        detail.discountamount = Math.Round((lineGross * detail.discountpercentage) / 100, 2);
        detail.amount = Math.Max(0, lineGross - detail.discountamount);
        CalculateTotals();
    }

    private void CalculateTotals()
    {
        decimal gross = 0;
        foreach (var d in CurrentRequest.details.Where(x => x.itemcode > 0))
        {
            var lineGross = d.quantity * d.orderrate;
            d.discountamount = Math.Round((lineGross * d.discountpercentage) / 100, 2);
            d.amount = Math.Max(0, lineGross - d.discountamount);
            gross += d.amount;
        }

        CurrentRequest.master.grossamount = Math.Round(gross, 2);

        decimal taxable = Math.Max(0, CurrentRequest.master.grossamount - CurrentRequest.master.discountamount);

        if (CurrentRequest.master.overalltax && CurrentRequest.master.taxpercentage > 0)
        {
            CurrentRequest.master.taxamount = Math.Round((taxable * CurrentRequest.master.taxpercentage) / 100, 2);
        }
        else
        {
            CurrentRequest.master.taxamount = 0;
        }

        decimal net = taxable + CurrentRequest.master.taxamount + CurrentRequest.master.roundoff;
        CurrentRequest.master.grandtotal = Math.Round(net, 2);
    }

    private void FilterItems(ChangeEventArgs e, purchase_order_detail detail, int searchKey)
    {
        var text = e.Value?.ToString() ?? "";
        ItemSearchTexts[searchKey] = text;

        var matched = ItemList.FirstOrDefault(i => string.Equals(i.itemname, text, StringComparison.OrdinalIgnoreCase));
        if (matched != null)
        {
            detail.itemcode = matched.itemcode;
            detail.orderrate = matched.purchaserate;
            detail.mrp = matched.mrp;
            detail.packing = matched.packsize > 0 ? matched.packsize : 1;
            detail.itemgroupcode = matched.categorycode;
            CalculateRow(detail);
        }
        else
        {
            detail.itemcode = 0;
        }
    }

