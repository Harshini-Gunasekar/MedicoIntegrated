    private void ConfirmDelete(purchase_order_master order)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete purchase orders.");
            return;
        }

        DeleteTargetOrder = order;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteConfirmed()
    {
        if (DeleteTargetOrder == null) return;

        IsDeleting = true;
        try
        {
            var client = CreateClient();
            var code = DeleteTargetOrder.ordercode;
            var deleteUrls = new[] {
                $"api/ItemMaster/deletepurchaseorder?ordercode={code}&tenantcode={DefaultTenant}",
                $"api/ItemMaster/deletepurchaseorder?ordercode={code}",
                $"ItemMaster/deletepurchaseorder?ordercode={code}"
            };

            bool success = false;
            foreach (var url in deleteUrls)
            {
                try
                {
                    var res = await client.DeleteAsync(url);
                    if (res.IsSuccessStatusCode) { success = true; break; }
                }
                catch { }

                try
                {
                    var res = await client.PostAsync(url, null);
                    if (res.IsSuccessStatusCode) { success = true; break; }
                }
                catch { }
            }

            if (success)
            {
                ToastService.ShowSuccess("Purchase order deleted successfully.");
                ShowDeleteConfirm = false;
                DeleteTargetOrder = null;
                await LoadPurchaseOrders();
            }
            else
            {
                ToastService.ShowError("Failed to delete purchase order from server.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Delete error: {ex.Message}");
        }
        finally
        {
            IsDeleting = false;
        }
    }

