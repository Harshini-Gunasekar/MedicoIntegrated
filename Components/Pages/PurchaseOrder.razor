    private async Task EditPurchaseOrder(purchase_order_master master)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit purchase orders.");
            return;
        }

        IsEdit = true;
        ItemSearchTexts.Clear();
        ShowVendorDropdown = false;

        try
        {
            var client = CreateClient();
            var urls = new[] {
                $"api/ItemMaster/getpurchaseorderbycode?ordercode={master.ordercode}&tenantcode={DefaultTenant}",
                $"api/ItemMaster/getpurchaseorderbycode?ordercode={master.ordercode}",
                $"ItemMaster/getpurchaseorderbycode?ordercode={master.ordercode}"
            };

            purchase_order_request? loadedReq = null;
            foreach (var url in urls)
            {
                try
                {
                    var json = await client.GetStringAsync(url);
                    if (!string.IsNullOrWhiteSpace(json))
                    {
                        var options = new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true,
                            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
                        };

                        try
                        {
                            loadedReq = JsonSerializer.Deserialize<purchase_order_request>(json, options);
                            if (loadedReq?.master != null && loadedReq.master.ordercode > 0) break;
                        }
                        catch { }

                        try
                        {
                            var wrapped = JsonSerializer.Deserialize<ServiceResponse<purchase_order_request>>(json, options);
                            if (wrapped?.data != null && wrapped.data.master != null)
                            {
                                loadedReq = wrapped.data;
                                break;
                            }
                        }
                        catch { }
                    }
                }
                catch { }
            }

            if (loadedReq != null && loadedReq.master != null)
            {
                CurrentRequest = loadedReq;
            }
            else
            {
                // Fallback from cache or local copy
                var cached = FullPurchaseOrders.FirstOrDefault(f => f.master?.ordercode == master.ordercode);
                CurrentRequest = new purchase_order_request
                {
                    master = new purchase_order_master
                    {
                        ordercode = master.ordercode,
                        orderno = master.orderno,
                        orderdate = master.orderdate,
                        llrcode = master.llrcode ?? "",
                        vendorcode = master.vendorcode,
                        overalltax = master.overalltax,
                        taxpercentage = master.taxpercentage,
                        grossamount = master.grossamount,
                        discountamount = master.discountamount,
                        taxamount = master.taxamount,
                        roundoff = master.roundoff,
                        grandtotal = master.grandtotal,
                        status = master.status,
                        remarks = master.remarks,
                        isactive = master.isactive,
                        deleted = master.deleted,
                        usercode = master.usercode ?? GetEffectiveUserCode(),
                        branchcode = master.branchcode ?? CurrentBranchCode,
                        companycode = master.companycode ?? CurrentCompanyCode,
                        tenantcode = master.tenantcode ?? DefaultTenant
                    },
                    details = cached?.details != null ? cached.details.Select(d => new purchase_order_detail
                    {
                        orderdetailcode = d.orderdetailcode,
                        ordercode = d.ordercode,
                        itemcode = d.itemcode,
                        itemgroupcode = d.itemgroupcode,
                        quantity = d.quantity,
                        packing = d.packing,
                        freeqty = d.freeqty,
                        mrp = d.mrp,
                        orderrate = d.orderrate,
                        discountpercentage = d.discountpercentage,
                        discountamount = d.discountamount,
                        amount = d.amount,
                        tenantcode = d.tenantcode ?? DefaultTenant
                    }).ToList() : new List<purchase_order_detail>(),
                    terms = cached?.terms != null ? cached.terms.Select(t => new purchase_order_terms
                    {
                        termcode = t.termcode,
                        ordercode = t.ordercode,
                        slno = t.slno,
                        termcondition = t.termcondition,
                        value = t.value,
                        tenantcode = t.tenantcode ?? DefaultTenant
                    }).ToList() : new List<purchase_order_terms>()
                };
            }

            CurrentRequest.details ??= new();
            CurrentRequest.terms ??= new();

            // Populate Vendor Search Text
            VendorSearchText = GetVendorName(CurrentRequest.master.vendorcode);
            if (VendorSearchText == "N/A" || VendorSearchText.StartsWith("Vendor #0")) VendorSearchText = "";

            // Populate item search texts
            foreach (var d in CurrentRequest.details)
            {
                var key = d.GetHashCode();
                var item = ItemList.FirstOrDefault(i => i.itemcode == d.itemcode);
                if (item != null)
                {
                    ItemSearchTexts[key] = item.itemname ?? "";
                }
            }

            if (!CurrentRequest.details.Any())
            {
                AddDetailRow();
            }

            CalculateTotals();
            ShowModal = true;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load order for edit: {ex.Message}");
        }
    }

