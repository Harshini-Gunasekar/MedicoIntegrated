@code {
    private List<purchase_order_master> PurchaseOrdersList = new();
    private List<purchase_order_request> FullPurchaseOrders = new();
    private List<vendor_master> VendorList = new();
    private List<inventory_item_master> ItemList = new();

    private string DefaultTenant = "HOSP001";
    private long CurrentUserCode = 1;
    private string CurrentBranchCode = "MAIN";
    private string CurrentCompanyCode = "RAGHAV";

    private long GetEffectiveUserCode()
    {
        if (CurrentUserCode > 0 && CurrentUserCode != 1) return CurrentUserCode;
        if (TenantState?.UserCode > 0) return TenantState.UserCode;
        if (TenantState?.UserData?.UserCode.HasValue == true && TenantState.UserData.UserCode.Value > 0)
            return TenantState.UserData.UserCode.Value;
        return CurrentUserCode > 0 ? CurrentUserCode : 1;
    }

    private bool IsLoading = true;
    private bool IsSaving = false;
    private bool IsDeleting = false;
    private bool IsCardView = false;
    private bool ShowModal = false;
    private bool IsEdit = false;
    private bool ShowDeleteConfirm = false;
    private bool ShowVoucherModal = false;

    private string SearchQuery = "";
    private string SelectedStatusFilter = "ALL";
    private int CurrentPage = 1;
    private int ItemsPerPage = 10;

    private bool hasViewRight = true;
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    private purchase_order_request CurrentRequest = new();
    private purchase_order_master? DeleteTargetOrder;
    private purchase_order_request? CurrentVoucherOrder;

    // Vendor Search State
    private string VendorSearchText = "";
    private bool ShowVendorDropdown = false;

    // Item Search State
    private Dictionary<int, string> ItemSearchTexts = new();
    private int ActiveItemSearchRow = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tc1 = await _sessionStorage.GetAsync<string>("tenant_code");
                var tc2 = await _sessionStorage.GetAsync<string>("TenantCode");
                var tc3 = await _sessionStorage.GetAsync<string>("tenantcode");

                if (tc1.Success && !string.IsNullOrWhiteSpace(tc1.Value)) DefaultTenant = tc1.Value;
                else if (tc2.Success && !string.IsNullOrWhiteSpace(tc2.Value)) DefaultTenant = tc2.Value;
                else if (tc3.Success && !string.IsNullOrWhiteSpace(tc3.Value)) DefaultTenant = tc3.Value;

                var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null)
                {
                    if (userResult.Value.UserCode.HasValue && userResult.Value.UserCode.Value > 0)
                    {
                        CurrentUserCode = userResult.Value.UserCode.Value;
                    }
                    else if (TenantState?.UserCode > 0)
                    {
                        CurrentUserCode = TenantState.UserCode;
                    }
                    if (userResult.Value.BranchCode.HasValue && userResult.Value.BranchCode.Value > 0)
                    {
                        CurrentBranchCode = userResult.Value.BranchCode.Value.ToString();
                    }
                }
                else if (TenantState?.UserCode > 0)
                {
                    CurrentUserCode = TenantState.UserCode;
                }

                // Check rights
                bool isAdmin = false;
                if (userResult.Success && userResult.Value != null)
                {
                    isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                              userResult.Value.UserCode == 0 ||
                              userResult.Value.UserCode == 1;
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                    hasEditRight = true;
                    hasDeleteRight = true;
                }
                else
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var pageRight = rightsResult.Value.FirstOrDefault(r =>
                            r.ModuleName != null &&
                            (r.ModuleName.Trim().Equals("Purchase_Order", StringComparison.OrdinalIgnoreCase) ||
                             r.ModuleName.Trim().Equals("Purchase_Purchase", StringComparison.OrdinalIgnoreCase)));

                        if (pageRight != null)
                        {
                            hasViewRight = pageRight.ToView;
                            hasCreateRight = pageRight.ToAdd;
                            hasEditRight = pageRight.ToEdit;
                            hasDeleteRight = pageRight.ToDelete;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking user details / rights: {ex.Message}");
            }

            if (!hasViewRight)
            {
                ToastService.ShowError("You do not have permission to access Purchase Order.");
                Nav.NavigateTo("/home");
                return;
            }

            await Task.WhenAll(
                LoadPurchaseOrders(),
                LoadVendors(),
                LoadItems()
            );

            StateHasChanged();
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
        return client;
    }

    // ─── LOAD DATA ─────────────────────────────────────────────────────────────

    private async Task LoadPurchaseOrders()
    {
        IsLoading = true;
        try
        {
            var client = CreateClient();
            var urls = new[] {
                $"api/ItemMaster/getallpurchaseorders?tenantcode={DefaultTenant}",
                "api/ItemMaster/getallpurchaseorders",
                "ItemMaster/getallpurchaseorders"
            };

            string? response = null;
            foreach (var url in urls)
            {
                try
                {
                    response = await client.GetStringAsync(url);
                    if (!string.IsNullOrWhiteSpace(response)) break;
                }
                catch { }
            }

            if (!string.IsNullOrWhiteSpace(response))
            {
                var fullList = ParseFullOrderList(response);
                if (fullList != null && fullList.Any())
                {
                    FullPurchaseOrders = fullList;
                    PurchaseOrdersList = fullList.Select(f => f.master).Where(m => m != null).OrderByDescending(m => m.orderdate).ToList();
                }
                else
                {
                    var masterList = ParseMasterList(response);
                    PurchaseOrdersList = masterList.OrderByDescending(m => m.orderdate).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Load Orders Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<purchase_order_request>? ParseFullOrderList(string json)
    {
        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try
        {
            var direct = JsonSerializer.Deserialize<List<purchase_order_request>>(json, options);
            if (direct != null && direct.Any() && direct[0].master != null) return direct;
        }
        catch { }

        try
        {
            var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<purchase_order_request>>>(json, options);
            if (wrapped?.data != null && wrapped.data.Any()) return wrapped.data;
        }
        catch { }

        return null;
    }

    private List<purchase_order_master> ParseMasterList(string json)
    {
        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var d)) root = d;

            if (root.ValueKind == JsonValueKind.Array)
            {
                var list = new List<purchase_order_master>();
                foreach (var el in root.EnumerateArray())
                {
                    var m = MapFuzzyMaster(el, options);
                    if (m != null) list.Add(m);
                }
                return list;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("ParseMasterList error: " + ex.Message);
        }

        return new();
    }

    private purchase_order_master? MapFuzzyMaster(JsonElement el, JsonSerializerOptions options)
    {
        var target = el;
        if (TryGetPropertyIgnoreCase(el, "master", out var mProp)) target = mProp;

        try
        {
            var m = JsonSerializer.Deserialize<purchase_order_master>(target.GetRawText(), options);
            if (m != null)
            {
                if (string.IsNullOrEmpty(m.orderno) && m.ordercode > 0)
                {
                    m.orderno = m.ordercode.ToString();
                }
                return m;
            }
        }
        catch { }

        return null;
    }

    private static bool TryGetPropertyIgnoreCase(JsonElement el, string name, out JsonElement prop)
    {
        prop = default;
        if (el.ValueKind != JsonValueKind.Object) return false;
        foreach (var p in el.EnumerateObject())
        {
            if (string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase))
            {
                prop = p.Value;
                return true;
            }
        }
        return false;
    }

    private async Task LoadVendors()
    {
        try
        {
            var client = CreateClient();
            var urls = new[] {
                $"ItemMaster/getallvendors?tenantcode={DefaultTenant}",
                "ItemMaster/getallvendors",
                "api/ItemMaster/getallvendors",
                "Vendor/getallvendors"
            };

            string? response = null;
            foreach (var url in urls)
            {
                try
                {
                    response = await client.GetStringAsync(url);
                    if (!string.IsNullOrWhiteSpace(response)) break;
                }
                catch { }
            }

            if (!string.IsNullOrWhiteSpace(response))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                try
                {
                    var direct = JsonSerializer.Deserialize<List<vendor_master>>(response, options);
                    VendorList = direct ?? new();
                }
