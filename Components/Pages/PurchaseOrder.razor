    private void AddPresetTerm(string condition, string value)
    {
        CurrentRequest.terms ??= new();
        if (CurrentRequest.terms.Any(t => string.Equals(t.termcondition, condition, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }
        int nextSlNo = CurrentRequest.terms.Count + 1;
        CurrentRequest.terms.Add(new purchase_order_terms
        {
            slno = nextSlNo,
            termcondition = condition,
            value = value,
            tenantcode = DefaultTenant
        });
    }

    private void RemoveTermRow(purchase_order_terms term)
    {
        CurrentRequest.terms?.Remove(term);
        // Re-index slno
        if (CurrentRequest.terms != null)
        {
            for (int i = 0; i < CurrentRequest.terms.Count; i++)
            {
                CurrentRequest.terms[i].slno = i + 1;
            }
        }
    }

    // ─── SAVE PURCHASE ORDER ───────────────────────────────────────────────────

    private async Task SavePurchaseOrder()
    {
        if (CurrentRequest.master.vendorcode == null || CurrentRequest.master.vendorcode <= 0)
        {
            ToastService.ShowWarning("Please select a vendor from the dropdown.");
            return;
        }

        var validDetails = CurrentRequest.details.Where(d => d.itemcode > 0 && d.quantity > 0).ToList();
        if (!validDetails.Any())
        {
            ToastService.ShowWarning("Please select at least one item and enter quantity > 0.");
            return;
        }

        CalculateTotals();

        IsSaving = true;
        try
        {
            var client = CreateClient();

            // Set tenant and branch codes
            CurrentRequest.master.tenantcode = DefaultTenant;
            CurrentRequest.master.branchcode = string.IsNullOrWhiteSpace(CurrentRequest.master.branchcode) ? CurrentBranchCode : CurrentRequest.master.branchcode;
            CurrentRequest.master.companycode = string.IsNullOrWhiteSpace(CurrentRequest.master.companycode) ? CurrentCompanyCode : CurrentRequest.master.companycode;
            CurrentRequest.master.llrcode = "";
            CurrentRequest.master.usercode = GetEffectiveUserCode();
            CurrentRequest.master.isactive = true;
            CurrentRequest.master.deleted = false;

            foreach (var d in validDetails)
            {
                d.tenantcode = DefaultTenant;
            }

            if (CurrentRequest.terms != null)
            {
                foreach (var t in CurrentRequest.terms)
                {
                    t.tenantcode = DefaultTenant;
                }
            }

            var payload = new purchase_order_request
            {
                master = CurrentRequest.master,
                details = validDetails,
                terms = CurrentRequest.terms?.Where(t => !string.IsNullOrWhiteSpace(t.termcondition) || !string.IsNullOrWhiteSpace(t.value)).ToList() ?? new()
            };

            HttpResponseMessage? response = null;

            if (IsEdit && CurrentRequest.master.ordercode > 0)
            {
                var updateUrls = new[] { "api/ItemMaster/updatepurchaseorder", "ItemMaster/updatepurchaseorder" };
                foreach (var url in updateUrls)
                {
                    try
                    {
                        response = await client.PostAsJsonAsync(url, payload);
                        if (response.IsSuccessStatusCode) break;
                    }
                    catch { }
                }
            }
            else
            {
                var insertUrls = new[] { "api/ItemMaster/insertpurchaseorder", "ItemMaster/insertpurchaseorder" };
                foreach (var url in insertUrls)
                {
                    try
                    {
                        response = await client.PostAsJsonAsync(url, payload);
                        if (response.IsSuccessStatusCode) break;
                    }
                    catch { }
                }
            }

            if (response != null && response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(IsEdit ? "Purchase order updated successfully." : "Purchase order created successfully.");
                CloseModal();
                await LoadPurchaseOrders();
            }
            else
            {
                var errorText = response != null ? await response.Content.ReadAsStringAsync() : "Could not connect to API server";
                ToastService.ShowError($"Save failed: {errorText}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving purchase order: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
        }
    }

