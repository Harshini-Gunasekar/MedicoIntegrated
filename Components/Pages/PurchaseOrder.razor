                                            var term = termRow.term;
                                            var index = termRow.index;
                                            <tr>
                                                <td style="text-align: center; font-weight: 700; color: #64748b;">@(index + 1)</td>
                                                <td>
                                                    <input type="text" class="po-table-input fw-semibold" @bind="term.termcondition" placeholder="e.g. Delivery, Payment Terms..." />
                                                </td>
                                                <td>
                                                    <input type="text" class="po-table-input" @bind="term.value" placeholder="e.g. Within 7 days, Net 30..." />
                                                </td>
                                                <td style="text-align: center;">
                                                    <button type="button" class="btn btn-outline-danger btn-sm" style="padding: 2px 6px; border: none;" @onclick="() => RemoveTermRow(term)" title="Remove Term">
                                                        <i class="bi bi-trash"></i>
