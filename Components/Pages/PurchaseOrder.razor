@page "/purchaseorder"
@page "/purchase-order"
@page "/po"
@using Booking.Models
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage _sessionStorage
@inject Booking.Services.LabSettingService LabSettingService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<style>
    .custom-typeahead-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        max-height: 220px;
        overflow-y: auto;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        margin-top: 4px;
    }
    .custom-typeahead-item {
        padding: 8px 12px;
        cursor: pointer;
        font-size: 0.78rem;
        text-align: left;
        color: #1e293b;
        transition: background-color 0.15s ease;
        border-bottom: 1px solid #f1f5f9;
    }
    .custom-typeahead-item:last-child {
        border-bottom: none;
    }
    .custom-typeahead-item:hover {
        background-color: #f1f5f9;
        color: #4f46e5;
    }
</style>

<PageTitle>Purchase Order</PageTitle>

<div class="items-page purchase-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <!-- Header Card -->
            <div class="premium-header-card mb-4">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                            <polyline points="10 9 9 9 8 9" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Purchase Order</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total Orders : @PurchaseOrdersList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <!-- Status Filter -->
                    <select class="status-filter-select" value="@SelectedStatusFilter" @onchange="OnStatusFilterChanged">
                        <option value="ALL">All Statuses</option>
                        <option value="PENDING">Pending</option>
                        <option value="APPROVED">Approved</option>
                        <option value="CLOSED">Closed</option>
                        <option value="CANCELLED">Cancelled</option>
                        <option value="CONVERTED">Converted</option>
                    </select>

                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by PO #, vendor, or remarks..." @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    @if (hasCreateRight)
                    {
                        <button class="add-item-btn" @onclick="AddNewPurchaseOrder">
                            <i class="bi bi-plus-lg"></i>
                            <span class="ms-1">New Purchase Order</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Main Table / Grid Container -->
            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredOrders.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-file-earmark-text fs-1 d-block mb-3 text-secondary"></i>
                        No purchase orders found.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 60px; text-align: center;">S.NO</th>
                                    <th style="width: 140px; text-align: center;">ORDER NO</th>
                                    <th style="width: 120px; text-align: center;">DATE</th>
                                    <th style="width: 32%; text-align: center;">VENDOR</th>
                                    <th style="width: 14%; text-align: center;">GROSS (₹)</th>
                                    <th style="width: 12%; text-align: center;">TAX (₹)</th>
                                    <th style="width: 16%; text-align: center;">GRAND TOTAL (₹)</th>
                                    <th style="width: 120px; text-align: center;">STATUS</th>
                                    <th style="width: 120px; text-align: center;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedOrders.Select((value, index) => new { value, index }))
                                {
                                    var order = row.value;
                                    <tr>
                                        <td style="text-align: center; font-weight: 700; color: #3b82f6;">@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td style="text-align: center; font-weight: 700; color: #4f46e5;">
                                            #@(string.IsNullOrEmpty(order.orderno) ? (order.ordercode > 0 ? order.ordercode.ToString() : "N/A") : order.orderno)
                                        </td>
                                        <td style="font-weight: 500; text-align: center;">@(order.orderdate.ToString("yyyy-MM-dd"))</td>
                                        <td style="font-weight: 600; text-align: center;">@(GetVendorName(order.vendorcode))</td>
                                        <td style="font-weight: 600; text-align: center;">₹@order.grossamount.ToString("N2")</td>
                                        <td style="font-weight: 500; text-align: center;">₹@order.taxamount.ToString("N2")</td>
                                        <td style="font-weight: 800; text-align: center; color: #0f766e;">₹@order.grandtotal.ToString("N2")</td>
                                        <td style="text-align: center;">
                                            <span class="badge-status @GetStatusBadgeClass(order.status)">
                                                @(string.IsNullOrWhiteSpace(order.status) ? "PENDING" : order.status)
                                            </span>
                                        </td>
                                        <td style="text-align: center;">
                                            <button class="action-btn btn-view me-1" @onclick="async () => await ViewVoucher(order)" title="Print / View Voucher">
                                                <i class="bi bi-printer"></i>
                                            </button>
                                            @if (hasEditRight)
                                            {
                                                <button class="action-btn btn-edit me-1" @onclick="async () => await EditPurchaseOrder(order)" title="Edit">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            }
                                            @if (hasDeleteRight)
                                            {
                                                <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(order)" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var order in PagedOrders)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span class="card-item-code">#@(string.IsNullOrEmpty(order.orderno) ? order.ordercode.ToString() : order.orderno)</span>
                                    <div>
                                        <button class="action-btn btn-view me-1" @onclick="async () => await ViewVoucher(order)" title="Print / View Voucher"><i class="bi bi-printer"></i></button>
                                        @if (hasEditRight)
                                        {
                                            <button class="action-btn btn-edit me-1" @onclick="async () => await EditPurchaseOrder(order)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(order)" title="Delete"><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Date</span><strong>@(order.orderdate.ToString("yyyy-MM-dd"))</strong></div>
                                    <div class="detail-row"><span>Vendor</span><strong>@GetVendorName(order.vendorcode)</strong></div>
                                    <div class="detail-row"><span>Gross Amount</span><strong>₹@order.grossamount.ToString("N2")</strong></div>
                                    <div class="detail-row"><span>Tax Amount</span><strong>₹@order.taxamount.ToString("N2")</strong></div>
                                    <div class="detail-row"><span>Grand Total</span><strong style="color: #0f766e; font-size: 0.95rem;">₹@order.grandtotal.ToString("N2")</strong></div>
                                    <div class="detail-row"><span>Status</span>
                                        <span class="badge-status @GetStatusBadgeClass(order.status)">
                                            @(string.IsNullOrWhiteSpace(order.status) ? "PENDING" : order.status)
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Pagination Footer -->
                <div class="display-controls px-4 py-3 border-top" style="display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 10px;">
                        @if (FilteredOrders.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredOrders.Count()))</strong> of <strong>@FilteredOrders.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1" style="align-items: center;">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @foreach (var pageNum in GetVisiblePageNumbers())
                            {
                                var p = pageNum;
                                <button class="page-btn @(CurrentPage == p ? "active" : "")" @onclick="() => ChangePage(p)">
                                    @p
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- ADD / EDIT PURCHASE ORDER MODAL -->
<!-- ========================================================================= -->
@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 1350px; width: 95%; max-height: 90vh; height: 90vh; display: flex; flex-direction: column; overflow: hidden;">
            <div class="modal-header-bar" style="padding: 16px 32px !important; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;">
                <div class="modal-header-left">
                    <h3 class="modal-title" style="font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">
                        @(IsEdit ? $"Edit Purchase Order #{CurrentRequest.master.orderno ?? CurrentRequest.master.ordercode.ToString()}" : "New Purchase Order")
                    </h3>
                </div>
                <div>
                    <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <div class="modal-inner" style="display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden;">
                <EditForm Model="CurrentRequest" OnValidSubmit="SavePurchaseOrder" autocomplete="off" onkeydown="if(event.key==='Enter' && event.target.tagName==='INPUT' && event.target.type!=='submit'){event.preventDefault();}" style="display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden;">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="modal-scroll-area" style="flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 1.25rem 2rem;">
                        <!-- 1. Order Master Information Section -->
                        <div class="form-section-header" style="margin-top: 0;">
                            <div class="form-section-title"><i class="bi bi-card-checklist"></i> Order Information</div>
                        </div>

                        <div class="form-grid" style="grid-template-columns: repeat(12, 1fr); gap: 12px; margin-bottom: 8px;">
                            <!-- Vendor Typeahead Search -->
                            <div class="field-group col-6" style="position: relative;">
                                <label class="field-label required">Vendor</label>
                                <input type="text"
                                       class="form-control premium-input"
                                       placeholder="Type vendor name or code..."
                                       autocomplete="off"
                                       value="@VendorSearchText"
                                       @oninput="OnVendorSearchInput"
                                       @onfocus="() => ShowVendorDropdown = true"
                                       @onblur="OnVendorBlur" />

                                @if (ShowVendorDropdown)
                                {
                                    var filteredVendors = VendorList
                                        .Where(v => string.IsNullOrEmpty(VendorSearchText) ||
                                                    (v.vendorName != null && v.vendorName.Contains(VendorSearchText, StringComparison.OrdinalIgnoreCase)) ||
                                                    v.vendorCode.ToString().Contains(VendorSearchText))
                                        .ToList();

                                    if (filteredVendors.Any())
                                    {
                                        <div class="custom-typeahead-dropdown">
                                            @foreach (var v in filteredVendors)
                                            {
                                                <div class="custom-typeahead-item" @onmousedown="() => SelectVendor(v)">
                                                    <strong>@v.vendorName</strong>
                                                    <span style="color: #64748b; font-size: 0.72rem; margin-left: 6px;">(#@v.vendorCode @(!string.IsNullOrWhiteSpace(v.phoneNumber) ? $"• {v.phoneNumber}" : ""))</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="custom-typeahead-dropdown">
                                            <div class="custom-typeahead-item text-muted">No vendors matching "@VendorSearchText"</div>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Order Date -->
                            <div class="field-group col-3">
                                <label class="field-label required">Order Date</label>
                                <InputDate class="form-control premium-input" @bind-Value="CurrentRequest.master.orderdate" />
                            </div>

                            <!-- Status Selection -->
                            <div class="field-group col-3">
                                <label class="field-label required">Status</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentRequest.master.status">
                                    <option value="PENDING">Pending</option>
                                    <option value="APPROVED">Approved</option>
                                    <option value="CLOSED">Closed</option>
                                    <option value="CANCELLED">Cancelled</option>
                                    <option value="CONVERTED">Converted</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div class="form-grid" style="grid-template-columns: repeat(12, 1fr); gap: 12px; margin-bottom: 14px;">
                            <!-- Remarks -->
                            <div class="field-group col-9">
                                <label class="field-label">Order Remarks / Instructions</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.remarks" placeholder="e.g. Urgent restock, deliver to pharmacy warehouse..." />
                            </div>

                            <!-- Branch -->
                            <div class="field-group col-3">
                                <label class="field-label">Branch</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentRequest.master.branchcode" placeholder="MAIN" />
                            </div>
                        </div>

                        <!-- 2. Order Details (Item Lines) Section -->
                        <div class="form-section-header">
                            <div class="form-section-title"><i class="bi bi-box-seam"></i> Order Items</div>
                        </div>

                        <div class="po-items-table-wrapper" style="overflow: visible;">
                            <table class="table align-middle po-items-table">
                                <thead>
                                    <tr>
                                        <th style="width: 40px; text-align: center;">S.NO</th>
                                        <th style="min-width: 240px;">ITEM NAME</th>
                                        <th style="width: 100px; text-align: center;">HSN / GROUP</th>
                                        <th style="width: 80px; text-align: center;">PACKING</th>
                                        <th style="width: 80px; text-align: center;">QTY</th>
                                        <th style="width: 80px; text-align: center;">FREE QTY</th>
                                        <th style="width: 90px; text-align: center;">RATE (₹)</th>
                                        <th style="width: 90px; text-align: center;">MRP (₹)</th>
                                        <th style="width: 80px; text-align: center;">DISC %</th>
                                        <th style="width: 90px; text-align: center;">DISC AMT (₹)</th>
                                        <th style="width: 110px; text-align: center;">AMOUNT (₹)</th>
                                        <th style="width: 50px; text-align: center;">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in CurrentRequest.details.Select((detail, index) => new { detail, index }))
                                    {
                                        var detail = row.detail;
                                        var index = row.index;
                                        var searchKey = detail.GetHashCode();

                                        <tr>
                                            <td style="text-align: center; font-weight: 700; color: #64748b;">@(index + 1)</td>
                                            <td style="position: relative; min-width: 240px;">
                                                <input id="po-item-@index"
                                                       type="text"
                                                       class="po-table-input"
                                                       placeholder="Type item name or code..."
                                                       autocomplete="off"
                                                       value="@(ItemSearchTexts.GetValueOrDefault(searchKey, ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.itemname ?? ""))"
                                                       @oninput="@(e => FilterItems(e, detail, searchKey))"
                                                       @onfocus="@(() => ActiveItemSearchRow = index)"
                                                       @onblur="OnSearchBlur" />

                                                @if (ActiveItemSearchRow == index)
                                                {
                                                    var searchText = ItemSearchTexts.GetValueOrDefault(searchKey, "");
                                                    var filtered = ItemList
                                                        .Where(i => string.IsNullOrEmpty(searchText) ||
                                                                    (i.itemname != null && i.itemname.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                                                                    i.itemcode.ToString().Contains(searchText))
                                                        .Take(60)
                                                        .ToList();

                                                    if (filtered.Any())
                                                    {
                                                        <div class="custom-typeahead-dropdown">
                                                            @foreach (var item in filtered)
                                                            {
                                                                <div class="custom-typeahead-item" @onmousedown="@(() => SelectItemFromDropdown(detail, item, searchKey))">
                                                                    <strong>@item.itemname</strong> 
                                                                    <span style="color: #64748b; font-size: 0.72rem; margin-left: 6px;">(Rate: ₹@item.purchaserate | MRP: ₹@item.mrp | Pack: @item.packsize)</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="custom-typeahead-dropdown">
                                                            <div class="custom-typeahead-item text-muted">No items matching "@searchText"</div>
                                                        </div>
                                                    }
                                                }
                                            </td>
                                            <td style="text-align: center;">
                                                <span class="text-muted small">
                                                    @(ItemList.FirstOrDefault(i => i.itemcode == detail.itemcode)?.hsnCode.ToString() ?? "-")
                                                </span>
                                            </td>
                                            <td>
                                                <input type="number" step="any" class="po-table-input text-center" @bind="detail.packing" @bind:event="oninput" placeholder="1" />
                                            </td>
                                            <td>
                                                <input type="number" step="any" min="0" class="po-table-input text-center fw-bold" @bind="detail.quantity" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)" placeholder="0" />
                                            </td>
                                            <td>
                                                <input type="number" step="any" min="0" class="po-table-input text-center" @bind="detail.freeqty" @bind:event="oninput" placeholder="0" />
                                            </td>
                                            <td>
                                                <input type="number" step="any" min="0" class="po-table-input text-end" @bind="detail.orderrate" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)" placeholder="0.00" />
                                            </td>
                                            <td>
                                                <input type="number" step="any" min="0" class="po-table-input text-end" @bind="detail.mrp" @bind:event="oninput" placeholder="0.00" />
                                            </td>
                                            <td>
                                                <input type="number" step="any" min="0" max="100" class="po-table-input text-center" @bind="detail.discountpercentage" @bind:event="oninput" @onkeyup="() => CalculateRow(detail)" placeholder="0" />
                                            </td>
                                            <td>
                                                <input type="number" step="any" class="po-table-input text-end text-muted" value="@detail.discountamount" readonly style="background: #f8fafc;" />
                                            </td>
                                            <td>
                                                <input type="text" class="po-table-input text-end fw-bold" value="₹@detail.amount.ToString("N2")" readonly style="background: #f0fdf4; color: #166534;" />
                                            </td>
                                            <td style="text-align: center;">
                                                <button type="button" class="btn btn-outline-danger btn-sm" style="padding: 2px 6px; border: none;" @onclick="() => RemoveDetailRow(detail)" title="Remove Item">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Add Item Row Action & Items Count -->
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 4px 14px; width: 100%;">
                            <div style="color: #475569; font-weight: 600; font-size: 0.84rem; display: flex; align-items: center; gap: 6px;">
                                <span>Total Item Lines:</span>
                                <span style="background: #e0f2fe; color: #0284c7; font-weight: 800; font-size: 0.85rem; padding: 2px 10px; border-radius: 6px; border: 1px solid #bae6fd;">
                                    @(CurrentRequest.details?.Count(d => d.itemcode > 0) ?? 0)
                                </span>
                            </div>
                            
                            <div>
                                <button type="button" class="btn-dotted-add" @onclick="AddDetailRow">
                                    <i class="bi bi-plus-circle-fill"></i> Add Item Line
                                </button>
                            </div>
                        </div>

                        <!-- 3. Overall Taxation & Summary Card -->
                        <div style="background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%); border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 18px; margin-bottom: 14px; box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);">
                            <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; align-items: end;">
                                <!-- Gross Amount -->
                                <div class="field-group">
                                    <label class="field-label">Gross Amount (₹)</label>
                                    <input type="text" class="form-control premium-input fw-bold" value="₹@CurrentRequest.master.grossamount.ToString("N2")" readonly style="background: #f8fafc; color: #0f678f;" />
                                </div>

                                <!-- Overall Discount -->
                                <div class="field-group">
                                    <label class="field-label">Overall Discount (₹)</label>
                                    <input type="number" step="any" min="0" class="form-control premium-input" @bind="CurrentRequest.master.discountamount" @bind:event="oninput" @onkeyup="CalculateTotals" placeholder="0.00" />
                                </div>

                                <!-- Overall Tax Checkbox -->
                                <div class="field-group">
                                    <label class="field-label">Tax Option</label>
                                    <div class="form-check form-switch pt-1">
                                        <input class="form-check-input" type="checkbox" id="poOverallTax" @bind="CurrentRequest.master.overalltax" @bind:after="CalculateTotals" style="cursor: pointer;" />
                                        <label class="form-check-label small fw-bold" for="poOverallTax" style="cursor: pointer;">
                                            @(CurrentRequest.master.overalltax ? "Overall Tax ON" : "No Tax")
