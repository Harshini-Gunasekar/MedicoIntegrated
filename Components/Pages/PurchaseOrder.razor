    private string GetStatusBadgeClass(string? status)
    {
        return (status?.ToUpperInvariant()) switch
        {
            "APPROVED" => "badge-approved",
            "CLOSED" => "badge-closed",
            "CANCELLED" => "badge-cancelled",
            "CONVERTED" => "badge-converted",
