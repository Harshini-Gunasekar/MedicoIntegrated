    // ─── FILTER & PAGINATION ───────────────────────────────────────────────────

    private IEnumerable<purchase_order_master> FilteredOrders
    {
        get
        {
            var query = PurchaseOrdersList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SelectedStatusFilter) && SelectedStatusFilter != "ALL")
            {
                query = query.Where(o => string.Equals(o.status, SelectedStatusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                var q = SearchQuery.Trim().ToLowerInvariant();
                query = query.Where(o =>
                    (o.orderno != null && o.orderno.ToLowerInvariant().Contains(q)) ||
                    (o.remarks != null && o.remarks.ToLowerInvariant().Contains(q)) ||
                    (o.ordercode.ToString().Contains(q)) ||
                    (GetVendorName(o.vendorcode).ToLowerInvariant().Contains(q))
                );
            }

            return query;
        }
    }

    private IEnumerable<purchase_order_master> PagedOrders
    {
        get
        {
            return FilteredOrders
                .Skip((CurrentPage - 1) * ItemsPerPage)
                .Take(ItemsPerPage);
        }
    }

    private int TotalPages => (int)Math.Ceiling((double)FilteredOrders.Count() / ItemsPerPage);

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private IEnumerable<int> GetVisiblePageNumbers()
    {
        int total = TotalPages;
        int current = CurrentPage;
        int start = Math.Max(1, current - 2);
        int end = Math.Min(total, current + 2);
        return Enumerable.Range(start, end - start + 1);
    }

