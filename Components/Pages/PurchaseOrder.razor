                        <div style="display: flex; justify-content: flex-end; padding-top: 4px;">
                            <button type="button" class="btn-dotted-add" @onclick="AddTermRow">
                                <i class="bi bi-plus-circle-fill"></i> Add Term Line
                            </button>
                        </div>
                    </div>

                    <!-- Modal Action Footer -->
                    <div class="modal-footer-actions">
                        <button type="button" class="btn-cancel-modal" @onclick="CloseModal">Cancel</button>
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-muted small">Total: <strong>₹@CurrentRequest.master.grandtotal.ToString("N2")</strong></span>
                            <button type="submit" class="btn-save-premium" disabled="@IsSaving">
                                @if (IsSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle me-1" style="font-size: 1.1rem;"></i>
                                }
                                <span>@(IsEdit ? "Update Purchase Order" : "Save Purchase Order")</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

