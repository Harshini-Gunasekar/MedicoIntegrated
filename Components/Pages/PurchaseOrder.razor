                                    </div>
                                </div>

                                <!-- Tax % -->
                                <div class="field-group">
                                    <label class="field-label">Tax %</label>
                                    <input type="number" step="any" min="0" max="100" class="form-control premium-input" @bind="CurrentRequest.master.taxpercentage" @bind:event="oninput" @onkeyup="CalculateTotals" disabled="@(!CurrentRequest.master.overalltax)" placeholder="0" />
                                </div>

                                <!-- Tax Amount -->
                                <div class="field-group">
                                    <label class="field-label">Tax Amount (₹)</label>
                                    <input type="text" class="form-control premium-input" value="₹@CurrentRequest.master.taxamount.ToString("N2")" readonly style="background: #f8fafc;" />
                                </div>

                                <!-- Grand Total -->
                                <div class="field-group">
                                    <label class="field-label" style="color: #0f766e; font-weight: 800;">Grand Total (₹)</label>
                                    <input type="text" class="form-control premium-input text-end fw-bold" value="₹@CurrentRequest.master.grandtotal.ToString("N2")" readonly style="background: #ecfdf5; border: 1.5px solid #6ee7b7; color: #047857; font-size: 1rem;" />
                                </div>
                            </div>
                        </div>

                        <!-- 4. Terms and Conditions Section -->
                        <div class="form-section-header">
                            <div class="form-section-title"><i class="bi bi-file-earmark-ruled"></i> Terms &amp; Conditions</div>
                            <div class="d-flex gap-2">
                                <span class="quick-term-pill" @onclick='() => AddPresetTerm("Delivery", "Within 7 days")'>+ Delivery: 7 days</span>
                                <span class="quick-term-pill" @onclick='() => AddPresetTerm("Payment Terms", "Net 30")'>+ Payment: Net 30</span>
                                <span class="quick-term-pill" @onclick='() => AddPresetTerm("Validity", "30 Days from PO Date")'>+ Validity: 30 Days</span>
                                <span class="quick-term-pill" @onclick='() => AddPresetTerm("Warranty", "Standard Manufacturer Warranty")'>+ Warranty</span>
                            </div>
                        </div>

                        <div class="terms-table-wrapper">
                            <table class="table align-middle po-items-table">
                                <thead>
                                    <tr>
                                        <th style="width: 40px; text-align: center;">SL</th>
                                        <th style="width: 250px;">TERM / CONDITION TITLE</th>
                                        <th>VALUE / DESCRIPTION</th>
                                        <th style="width: 50px; text-align: center;">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (CurrentRequest.terms != null && CurrentRequest.terms.Any())
