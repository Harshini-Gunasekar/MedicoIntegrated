@page "/admin-login"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Http.Json
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject Booking.Services.ToastService Toast
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<div class="login-page-container">
    <div class="login-card">
        <div class="login-header">
            <h2 class="brand-title">Medico <span class="brand-highlight">Portal</span></h2>
            <h3 class="page-title">Admin Login</h3>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success" role="alert">
                <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <div class="alert-content">
                    <strong>@successMessage</strong><br/>
                    Tenant Name: @tenantName<br/>
                    Tenant Code: @tenantCode
                </div>
            </div>
        }

        <div class="form-group">
            <label class="form-label">Email Address</label>
            <input type="email" class="form-control custom-input" @bind="loginModel.Email" placeholder="Email address" />
        </div>

        <div class="form-group password-group">
            <div class="d-flex justify-content-between">
                <label class="form-label">Password</label>
            </div>
            <div class="password-input-wrapper">
                <input type="@passwordInputType" class="form-control custom-input" @bind="loginModel.Password" placeholder="Password" />
                <button type="button" class="btn-eye" @onclick="TogglePasswordVisibility">
                    @if (showPassword)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye-off"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                    }
                </button>
            </div>
        </div>

        <div class="form-check stay-signed-in">
            <input class="form-check-input custom-checkbox" type="checkbox" id="staySignedIn" checked>
            <label class="form-check-label" for="staySignedIn">
                Stay signed in
            </label>
        </div>

        <button class="btn btn-continue" @onclick="HandleLogin" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            Continue
        </button>

        <div class="login-footer-links">
            <a href="/user-login" class="staff-login-link">Use Staff Login instead</a>
            <p class="register-text">New laboratory? <a href="/register" class="register-link">Register Facility</a></p>
        </div>
    </div>
    
    <div class="page-footer">
        <span>© LabCare</span>
        <a href="#">Contact</a>
        <a href="#">Privacy & terms</a>
    </div>
    <Booking.Components.Shared.ToastContainer />
</div>

@code {
    private LoginModel loginModel = new LoginModel();
    private string? errorMessage;
    private string? successMessage;
    private string? tenantName;
    private string? tenantCode;
    private bool isLoading;
    private bool showPassword = false;
    private string passwordInputType => showPassword ? "text" : "password";

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("LabCareUrl");
            
            var payload = new 
            {
                email = loginModel.Email,
                password = loginModel.Password
            };

            var response = await client.PostAsJsonAsync("api/Tenant/login", payload);

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[AdminLogin] Raw Response: {responseContent}");
                
                var json = JObject.Parse(responseContent);
                string? token = json["token"]?.ToString() ?? json["Token"]?.ToString() ?? json["token_key"]?.ToString();
                
                string? tenantCodeVal = json["tenant_Code"]?.ToString() 
                    ?? json["tenant_code"]?.ToString() 
                    ?? json["Tenant_Code"]?.ToString()
                    ?? json["tenantCode"]?.ToString()
                    ?? json["TenantCode"]?.ToString()
                    ?? json["tenantcode"]?.ToString()
                    ?? json["tenant_id"]?.ToString()
                    ?? json["Tenant_Id"]?.ToString();
                    
                string? tenantNameVal = json["tenant_Name"]?.ToString() 
                    ?? json["tenant_name"]?.ToString() 
                    ?? json["Tenant_Name"]?.ToString()
                    ?? json["tenantName"]?.ToString()
                    ?? json["TenantName"]?.ToString();

                if (!string.IsNullOrEmpty(tenantCodeVal))
                {
                    successMessage = "Login successful!";
                    tenantName = tenantNameVal ?? "Tenant Admin";
                    tenantCode = tenantCodeVal;
                    string safeToken = token ?? "";
                    
                    var userDetails = new SharedComponents.Rcl.Models.UserDetailsModel
                    {
                        UserName = tenantName,
                        Role = "Administrator",
                        TenantCode = tenantCode,
                        TenantName = tenantName,
                        AuthToken = safeToken,
                        UserCode = 0,
                        BranchCode = null,
                        CounterCode = null,
                        Claim = null
                    };

                    await _sessionStorage.SetAsync("authToken", safeToken);
                    await _sessionStorage.SetAsync("tenant_code", tenantCode);
                    await _sessionStorage.SetAsync("tenant_name", tenantName);
                    await _sessionStorage.SetAsync("IsTenantAdmin", true);
                    await _sessionStorage.DeleteAsync("bhcode");
                    await _sessionStorage.SetAsync("UserDetails", userDetails);
                    await _sessionStorage.SetAsync("UserRights", new List<SharedComponents.Rcl.Models.User_Rights>());
                    
                    TenantState.SetSession(tenantCode, safeToken, tenantName, 0, null, null, userDetails, new List<SharedComponents.Rcl.Models.User_Rights>());
                    
                    Toast.ShowSuccess($"Admin login successful! Tenant: {tenantCode}");
                    await Task.Delay(1000);
                    NavigationManager.NavigateTo("/home");
                }
                else
                {
                    errorMessage = "Login succeeded but tenant code was empty.";
                }
            }
            else
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[AdminLogin] Error Response: {responseContent}");
                string detailedError = ExtractErrorMessage(responseContent);

                if (!string.IsNullOrEmpty(detailedError))
                {
                    errorMessage = detailedError;
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    errorMessage = "Login failed: Invalid email or password.";
                }
                else
                {
                    errorMessage = $"Login failed. Status Code: {response.StatusCode}";
                }
                Toast.ShowError(errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while attempting to log in: {ex.Message}";
            Toast.ShowError(errorMessage);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string ExtractErrorMessage(string responseContent)
    {
        if (string.IsNullOrWhiteSpace(responseContent)) return string.Empty;
        try
        {
            var json = JObject.Parse(responseContent);
            string? msg = json["message"]?.ToString() 
                ?? json["Message"]?.ToString() 
                ?? json["error"]?.ToString() 
                ?? json["Error"]?.ToString() 
                ?? json["detail"]?.ToString() 
                ?? json["title"]?.ToString();
                
            if (!string.IsNullOrEmpty(msg)) return msg;
        }
        catch
        {
            if (responseContent.Length < 200 && !responseContent.StartsWith("<"))
            {
                return responseContent.Trim();
            }
        }
        return string.Empty;
    }

    public class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public class LoginResponse
    {
        public string Message { get; set; } = "";
        public string Token { get; set; } = "";
        public string Tenant_Id { get; set; } = "";
        public string Tenant_Code { get; set; } = "";
        public string Tenant_Name { get; set; } = "";
    }
}
