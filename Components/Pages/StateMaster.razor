@page "/state-master"
@rendermode InteractiveServer
@using Medico_Backend.Model
@using Booking.Services
@inject StateMasterService StateService
@inject ToastService ToastService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@implements IDisposable

<div class="cm-page">
    <!-- Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <h1 class="cm-title">State Master</h1>
            <span class="cm-subtitle">Location Configuration</span>
        </div>
        <div class="cm-header-right">
            <div class="cm-search-box">
                <i class="bi bi-search cm-search-icon"></i>
                <input type="text" class="cm-search-input" placeholder="Quick find..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            @if (TenantState.HasActionRight("Configuration", "General", "Create")) { <button class="cm-btn-new" @onclick="OpenNewStateModal">
                + New State Entry
            </button> }
        </div>
    </div>

    <!-- Table -->
    <div class="cm-table-card">
        <table class="cm-table">
            <thead>
                <tr>
                    <th>ORDER NO</th>
                    <th>SHORT NAME</th>
                    <th>STATE NAME</th>
                    <th>DESCRIPTION</th>
                    <th>ENTERED DATE</th>
                    <th>MODIFIED DATE</th>
                    <th>ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredStates.Any())
                {
                    @foreach (var (item, index) in PaginatedStates.Select((s, i) => (s, i)))
                    {
                        <tr>
                            <td class="col-orderno">@(((currentPage - 1) * pageSize) + index + 1)</td>
                            <td class="col-shortname">@item.shortname</td>
                            <td class="col-name">
                                <span class="counter-name-text">@item.statename</span>
                            </td>
                            <td class="col-narration">@item.description</td>
                            <td class="col-date-entered">
                                <span class="date-line">@item.entereddate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.entereddate.ToString("tt") == "AM" ? "am" : "pm")">@item.entereddate.ToString("tt")</span>
                            </td>
                            <td class="col-date-modified">
                                <span class="date-line">@item.ibsdate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.ibsdate.ToString("tt") == "AM" ? "am" : "pm")">@item.ibsdate.ToString("tt")</span>
                            </td>
                            <td class="col-action">
                                @if (TenantState.HasActionRight("Configuration", "General", "Edit")) {
                                <button class="cm-action-btn edit" title="Edit" @onclick="() => EditState(item)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                }
                                @if (TenantState.HasActionRight("Configuration", "General", "Delete")) {
                                <button class="cm-action-btn delete" title="Delete" @onclick="() => DeleteState(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="cm-empty-row">
                            <i class="bi bi-display"></i>
                            <div>No states found</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (FilteredStates.Any())
        {
            <div class="cm-table-footer">
                <div class="cm-pagination-info">
                    Showing <strong>@(((currentPage - 1) * pageSize) + 1)</strong> to <strong>@(Math.Min(currentPage * pageSize, FilteredStates.Count()))</strong> of <strong>@FilteredStates.Count()</strong> entries
                </div>
                @if (TotalPages > 1)
                {
                    <div class="cm-pagination-controls">
                        <button type="button" class="cm-pg-btn" disabled="@(currentPage <= 1)" @onclick="() => ChangePage(currentPage - 1)">
                            &lsaquo; Previous
                        </button>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNum = i;
                            <button type="button" class="cm-pg-btn @(currentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                @pageNum
                            </button>
                        }
                        <button type="button" class="cm-pg-btn" disabled="@(currentPage >= TotalPages)" @onclick="() => ChangePage(currentPage + 1)">
                            Next &rsaquo;
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (showModal)
{
    <div class="cm-backdrop">
        <div class="cm-modal">
            <div class="cm-modal-header">
                <h2 class="cm-modal-title">@(isEditMode ? "Edit State Entry" : "New State Entry")</h2>
                <button class="cm-close-btn" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body">
                <!-- Row 1: State Name, Short Name -->
                <div class="cm-form-row two-cols">
                    <div class="cm-field-group" style="position: relative;">
                        <label class="cm-label">State Name <span style="color: #ef4444;">*</span></label>
                        <input @ref="stateNameInput"
                               type="text" 
                               class="cm-input" 
                               placeholder="Ex: Tamil Nadu" 
                               value="@currentState.statename" 
                               @oninput="OnStateNameInput"
                               @onfocus="() => showStateDropdown = true"
                               @onblur="OnStateNameBlur"
                               @onkeydown="OnStateNameKeyDown" />

                        @if (showStateDropdown && StateSuggestions.Any())
                        {
                            <div class="cm-autocomplete-dropdown">
                                @foreach (var item in StateSuggestions)
                                {
                                    <div class="cm-dropdown-item" @onmousedown="() => SelectState(item)">
                                        <span class="cm-dropdown-title">@item.statename</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Short Name</label>
                        <input @ref="shortNameInput"
                               type="text" 
                               class="cm-input" 
                               placeholder="Ex: TN" 
                               @bind="currentState.shortname" 
                               @bind:event="oninput"
                               @onkeydown="OnShortNameKeyDown" />
                    </div>
                </div>

                <!-- Row 2: Description -->
                <div class="cm-form-row full-width">
                    <div class="cm-field-group">
                        <label class="cm-label">State Description</label>
                        <input @ref="descInput"
                               type="text" 
                               class="cm-input" 
                               placeholder="Specify any specific instructions..." 
                               @bind="currentState.description" 
                               @bind:event="oninput"
                               @onkeydown="OnDescKeyDown" />
                    </div>
                </div>
            </div>

            <div class="cm-modal-footer">
                @if (isEditMode)
                {
                    <button class="cm-btn-delete" @onclick="() => DeleteState(currentState)">Delete</button>
                }
                else
                {
                    <span></span>
                }
                <div class="cm-footer-right-buttons" style="display: flex; gap: 0.75rem; align-items: center;">
                    <button class="cm-btn-cancel" @onclick="CloseModal">Cancel</button>
                    <button class="cm-btn-save" @onclick="SaveState">
                        <i class="bi bi-check2"></i> Save State
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<StateMasterModel> states = new();
    private int currentPage = 1;
    private int pageSize = 10;

    private int TotalPages => (int)Math.Ceiling((double)FilteredStates.Count() / pageSize);

    private IEnumerable<StateMasterModel> PaginatedStates =>
        FilteredStates.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= Math.Max(1, TotalPages))
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private string _searchQuery = "";
    private string searchQuery
    {
        get => _searchQuery;
        set
        {
            if (_searchQuery != value)
            {
                _searchQuery = value;
                currentPage = 1;
            }
        }
    }

    private IEnumerable<StateMasterModel> FilteredStates =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? states
            : states.Where(s => 
                (s.statename?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (s.shortname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
    private bool showModal = false;
    private bool isEditMode = false;
    private StateMasterModel currentState = new();
    private bool showStateDropdown = false;

    private IEnumerable<StateMasterModel> StateSuggestions =>
        string.IsNullOrWhiteSpace(currentState.statename)
            ? Enumerable.Empty<StateMasterModel>()
            : states.Where(s => s.statename != null && s.statename.Contains(currentState.statename, StringComparison.OrdinalIgnoreCase)).Take(8);

    private void OnStateNameInput(ChangeEventArgs e)
    {
        string typed = e.Value?.ToString() ?? "";
        currentState.statename = typed;
        showStateDropdown = true;

        if (string.IsNullOrWhiteSpace(typed))
        {
            isEditMode = false;
            currentState.statecode = 0;
            return;
        }

        var match = states.FirstOrDefault(s => string.Equals(s.statename, typed, StringComparison.OrdinalIgnoreCase));
        if (match != null)
        {
            EditState(match);
        }
    }

    private void SelectState(StateMasterModel item)
    {
        EditState(item);
        showStateDropdown = false;
    }

    private async Task OnStateNameBlur()
    {
        await Task.Delay(250);
        showStateDropdown = false;
    }

    protected override async Task OnInitializedAsync()
    {
        TenantState.OnSessionChanged += HandleSessionChanged;
        await LoadStates();
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadStates();
            StateHasChanged();
        });
    }

    private async Task LoadStates()
    {
        try
        {
            var res = await StateService.GetStatesAsync();
            if (res != null)
            {
                var tenant = TenantState.TenantCode;
                var list = res.Where(s => string.IsNullOrEmpty(tenant) || string.IsNullOrEmpty(s.tenant_code) || string.Equals(s.tenant_code, tenant, StringComparison.OrdinalIgnoreCase)).ToList();

                // Order by entered date (in the order they are entered), fallback to statecode
                states = list.OrderBy(s => s.entereddate == default ? DateTime.MinValue : s.entereddate).ThenBy(s => s.statecode).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load states: {ex.Message}");
        }
    }

    private ElementReference stateNameInput;
    private ElementReference shortNameInput;
    private ElementReference descInput;
    private bool shouldFocusFirstInput = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusFirstInput)
        {
            shouldFocusFirstInput = false;
            try
            {
                await Task.Delay(50);
                await stateNameInput.FocusAsync();
            }
            catch { }
        }
    }

    private async Task OnStateNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            showStateDropdown = false;
            await shortNameInput.FocusAsync();
        }
    }

    private async Task OnShortNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await descInput.FocusAsync();
        }
    }

    private async Task OnDescKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveState();
        }
    }

    private void OpenNewStateModal()
    {
        int nextOrderNo = states.Count + 1;

        currentState = new StateMasterModel 
        { 
            orderno = nextOrderNo,
            tenant_code = !string.IsNullOrEmpty(TenantState.TenantCode) ? TenantState.TenantCode : ""
        };
        isEditMode = false;
        showModal = true;
        shouldFocusFirstInput = true;
    }

    private void EditState(StateMasterModel state)
    {
        currentState = new StateMasterModel
        {
            statecode = state.statecode,
            tenant_code = state.tenant_code,
            orderno = state.orderno,
            shortname = state.shortname,
            statename = state.statename,
            description = state.description,
            entereddate = state.entereddate,
            ibsdate = state.ibsdate
        };
        isEditMode = true;
        showModal = true;
        shouldFocusFirstInput = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveState()
    {
        if (string.IsNullOrWhiteSpace(currentState.statename))
        {
            ToastService.ShowWarning("Please enter a valid State Name.");
            return;
        }

        try
        {
            bool success;
            if (isEditMode)
            {
                currentState.ibsdate = DateTime.Now;
                success = await StateService.UpdateStateAsync(currentState);
            }
            else
            {
                currentState.entereddate = DateTime.Now;
                currentState.ibsdate = DateTime.Now;
                currentState.tenant_code = !string.IsNullOrEmpty(TenantState.TenantCode) ? TenantState.TenantCode : (currentState.tenant_code ?? "");
                
                // Auto-generate order no based on total count of records in this tenant (+1)
                currentState.orderno = states.Count + 1;

                success = await StateService.InsertStateAsync(currentState);
            }

            if (success)
            {
                ToastService.ShowSuccess("State saved successfully.");
                showModal = false;
                await LoadStates();
            }
            else
            {
                ToastService.ShowError("Failed to save state.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task DeleteState(StateMasterModel state)
    {
        try
        {
            bool success = await StateService.DeleteStateAsync(state.statecode);
            if (success)
            {
                ToastService.ShowSuccess("State deleted successfully.");
                if (showModal) showModal = false;
                await LoadStates();
            }
            else
            {
                ToastService.ShowError("Failed to delete state.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    public void Dispose()
    {
        TenantState.OnSessionChanged -= HandleSessionChanged;
    }
}
