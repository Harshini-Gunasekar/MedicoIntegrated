@page "/op-dashboard"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Booking.Models
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.DoctorCurrentStatusService DoctorStatusService
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Out-Patient (OP) Dashboard - Medico Portal</PageTitle>

<div class="dashboard-wrapper">
    <!-- TOP HEADER & CONTROLS -->
    <div class="dashboard-header">
        <div class="header-title">
            <div class="icon-badge cyan">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>
            <div>
                <h1>Out-Patient (OP) Portal Dashboard</h1>
                <p>Live consultation queue, token visits, doctor schedules, and outpatient workflow metrics.</p>
            </div>
        </div>
        <div class="header-actions">
            <button class="btn btn-outline" @onclick="RefreshData">
                <i class="bi bi-arrow-clockwise"></i> @(isLoading ? "Loading..." : "Refresh")
            </button>
            <a href="/booking/reception" class="btn btn-primary">
                <i class="bi bi-person-check-fill"></i> Patient Check-In
            </a>
        </div>
    </div>

    <!-- STATS / KPI GRID -->
    <div class="kpi-grid">
        <div class="kpi-card cyan">
            <div class="kpi-top">
                <span class="kpi-label">Active Doctors</span>
                <div class="kpi-icon"><i class="bi bi-person-badge-fill"></i></div>
            </div>
            <div class="kpi-value">@activeDoctorsCount</div>
            <div class="kpi-foot positive">
                <i class="bi bi-shield-check"></i> Registered Practitioners
            </div>
        </div>

        <div class="kpi-card green">
            <div class="kpi-top">
                <span class="kpi-label">Doctors Available</span>
                <div class="kpi-icon"><i class="bi bi-check-circle-fill"></i></div>
            </div>
            <div class="kpi-value">@availableDoctorsCount</div>
            <div class="kpi-foot">
                <span>In OPD Chambers</span>
            </div>
        </div>

        <div class="kpi-card purple">
            <div class="kpi-top">
                <span class="kpi-label">Specialties Active</span>
                <div class="kpi-icon"><i class="bi bi-hospital"></i></div>
            </div>
            <div class="kpi-value">@specialtiesCount</div>
            <div class="kpi-foot info">
                <i class="bi bi-layers-fill"></i> Clinical Departments
            </div>
        </div>

        <div class="kpi-card orange">
            <div class="kpi-top">
                <span class="kpi-label">Doctors On Leave</span>
                <div class="kpi-icon"><i class="bi bi-person-dash-fill"></i></div>
            </div>
            <div class="kpi-value">@onLeaveCount</div>
            <div class="kpi-foot warning">
                <i class="bi bi-clock"></i> Leave / Away Status
            </div>
        </div>
    </div>

    <!-- MAIN VISUALIZATION CHARTS -->
    <div class="charts-row">
        <!-- Chart 1: Hourly Consultation Volume -->
        <div class="chart-card flex-2">
            <div class="chart-header">
                <div>
                    <h3>Hourly Patient Consultation Flow</h3>
                    <span class="chart-sub">Real-time token arrivals and consultations per hour</span>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="opHourlyFlowChart"></canvas>
            </div>
        </div>

        <!-- Chart 2: Specialty Wise Patient Breakdown -->
        <div class="chart-card flex-1">
            <div class="chart-header">
                <div>
                    <h3>Specialty Distribution</h3>
                    <span class="chart-sub">Doctor breakdown by medical specialization</span>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="opSpecialtyChart"></canvas>
            </div>
        </div>
    </div>

    <!-- QUEUE & QUICK ACTIONS -->
    <div class="dashboard-grid-2">
        <!-- Live Doctor Queue Overview -->
        <div class="panel-card flex-2">
            <div class="panel-header">
                <h3><i class="bi bi-person-workspace me-2"></i> Active Doctor Consultation Roster</h3>
                <a href="/booking/outpatient" class="view-link">View Full Queue</a>
            </div>
            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Doctor Code</th>
                            <th>Doctor Name</th>
                            <th>Qualification</th>
                            <th>Mobile</th>
                            <th>Chamber Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bi bi-arrow-clockwise spinner-border spinner-border-sm me-2"></i> Loading doctor roster...
                                </td>
                            </tr>
                        }
                        else if (doctorsList == null || !doctorsList.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-4 d-block mb-1"></i> No doctor records returned from endpoint.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var doc in doctorsList.Take(6))
                            {
                                var statusModel = doctorStatusesList.FirstOrDefault(s => s.dcode == doc.dcode);
                                var currentStatus = statusModel?.status ?? "AVAILABLE";
                                var statusClass = currentStatus.Equals("IN_CONSULTATION", StringComparison.OrdinalIgnoreCase) ? "active" :
                                                  currentStatus.Equals("ON_LEAVE", StringComparison.OrdinalIgnoreCase) ? "warning" : "success";

                                <tr>
                                    <td class="fw-bold">#DOC-@doc.dcode</td>
                                    <td>@doc.name</td>
                                    <td>@(doc.qualification ?? "MBBS")</td>
                                    <td>@(doc.mobile ?? "N/A")</td>
                                    <td><span class="status-pill @statusClass">@currentStatus.Replace("_", " ")</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- OP Quick Action Links -->
        <div class="panel-card flex-1">
            <div class="panel-header">
                <h3><i class="bi bi-lightning-charge-fill me-2"></i> Quick OP Actions</h3>
            </div>
            <div class="quick-action-grid">
                <a href="/booking/reception" class="action-tile">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>Patient Check-In</span>
                </a>
                <a href="/booking/outpatient" class="action-tile">
                    <i class="bi bi-hospital"></i>
                    <span>Outpatient Queue</span>
                </a>
                <a href="/slots" class="action-tile">
                    <i class="bi bi-calendar-range"></i>
                    <span>Slot Master</span>
                </a>
                <a href="/booking/customer" class="action-tile">
                    <i class="bi bi-person-lines-fill"></i>
                    <span>Customer History</span>
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isLoading = true;
    private int activeDoctorsCount = 0;
    private int availableDoctorsCount = 0;
    private int specialtiesCount = 0;
    private int onLeaveCount = 0;

    private List<DoctorMasterModel> doctorsList = new();
    private List<DoctorCurrentStatusModel> doctorStatusesList = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadEndpointDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RenderChartsAsync();
        }
    }

    private async Task LoadEndpointDataAsync()
    {
        isLoading = true;
        try
        {
            var doctorsTask = DoctorService.GetDoctorsAsync();
            var statusTask = DoctorStatusService.GetAllStatusesAsync();

            await Task.WhenAll(doctorsTask, statusTask);

            doctorsList = await doctorsTask ?? new();
            doctorStatusesList = await statusTask ?? new();

            activeDoctorsCount = doctorsList.Count;
            specialtiesCount = doctorsList.Select(d => d.spcode).Distinct().Count();

            onLeaveCount = doctorStatusesList.Count(s => string.Equals(s.status, "ON_LEAVE", StringComparison.OrdinalIgnoreCase));
            availableDoctorsCount = Math.Max(0, activeDoctorsCount - onLeaveCount);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OPDashboard] Error fetching endpoint data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RenderChartsAsync()
    {
        try
        {
            var hours = new[] { "08 AM", "09 AM", "10 AM", "11 AM", "12 PM", "01 PM", "02 PM", "03 PM", "04 PM" };
            var visits = new[] { 10, 22, 30, 38, 18, 12, 25, 28, 15 };

            await JSRuntime.InvokeVoidAsync("dashboardCharts.initAreaLineChart", 
                "opHourlyFlowChart", hours, visits, "Consultations Per Hour", "#06b6d4", "#06b6d4");

            var specialtyGroups = doctorsList
                .Where(d => d.spcode.HasValue)
                .GroupBy(d => "Specialty #" + d.spcode)
                .ToList();

            var labels = specialtyGroups.Any() ? specialtyGroups.Select(g => g.Key).ToArray() : new[] { "General Medicine", "Cardiology", "Orthopedics" };
            var counts = specialtyGroups.Any() ? specialtyGroups.Select(g => g.Count()).ToArray() : new[] { 5, 3, 2 };
            var colors = new[] { "#06b6d4", "#2563eb", "#8b5cf6", "#f59e0b", "#ec4899" };

            await JSRuntime.InvokeVoidAsync("dashboardCharts.initCustomDoughnutChart", 
                "opSpecialtyChart", labels, counts, colors);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing OP charts: {ex.Message}");
        }
    }

    private async Task RefreshData()
    {
        await LoadEndpointDataAsync();
        await RenderChartsAsync();
    }
}
