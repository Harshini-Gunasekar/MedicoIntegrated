@page "/nishant/new-patient-registration"
@using SharedComponents.Rcl.Models
@using Booking.Models
@using Medico_Backend.Model
@using Newtonsoft.Json
@inject NavigationManager NavigationManager
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.ToastService Toast
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.AreaMasterService AreaMasterService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@if (IsVisible || isStandalonePage)
{
    <div class="modal-backdrop-custom">
        <div class="modal-dialog-custom">
            <!-- Modal Header matching Reference Image 2 -->
            <div class="modal-header-bar">
                <h3 class="modal-title-text">@(current != null && current.custid > 0 ? "Edit Patient Entry" : "New Patient Entry")</h3>
                <button type="button" class="btn-close-modal" @onclick="CloseModal" title="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                    </svg>
                </button>
            </div>

            <!-- Modal Content matching Reference Image 2 -->
            <div class="modal-body-content">
                <div class="form-grid-layout">
                    <!-- LEFT COLUMN: Primary & Personal Information -->
                    <div class="form-column">
                        <h4 class="form-section-title">
                            <span class="material-symbols-outlined">person</span> Primary & Contact Information
                        </h4>
                        <div class="cm-container">
                            <!-- 1. Name -->
                            <div class="cm-field cm-col-12">
                                <label class="cm-label-top">Name <span class="required-star">*</span></label>
                                <input type="text" class="cm-input" @bind="current.name" placeholder="e.g. Sara" />
                            </div>

                            <!-- 2. D.O.B & 3. Age -->
                            <div class="cm-field cm-col-6">
                                <label class="cm-label-top">D.O.B</label>
                                <input type="date" class="cm-input" @bind="current.dateofbirth" @bind:after="CalculateAge" />
                            </div>
                            <div class="cm-field cm-col-6">
                                <label class="cm-label-top">Age</label>
                                <div class="cm-field-inline">
                                     <input type="number" min="0" max="80" class="cm-input cm-w-age" @bind="ageYearsInput" placeholder="YY" />
                                     <input type="number" min="0" max="11" class="cm-input cm-w-age" @bind="ageMonthsInput" placeholder="MM" />
                                     <input type="number" min="0" max="31" class="cm-input cm-w-age" @bind="ageDaysInput" placeholder="DD" />
                                </div>
                            </div>

                            <!-- 4. Gender & 5. Care Of (Relationship) -->
                            <div class="cm-field cm-col-6">
                                <label class="cm-label-top">Gender</label>
                                <select class="cm-input" @bind="current.gender">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="cm-field cm-col-6">
                                <label class="cm-label-top">Care Of (Relationship)</label>
                                <select class="cm-input" @bind="current.careoftitile">
                                    <option value="">Select Relation</option>
                                    <option value="S/O">S/O (Son of)</option>
                                    <option value="D/O">D/O (Daughter of)</option>
                                    <option value="W/O">W/O (Wife of)</option>
                                    <option value="H/O">H/O (Husband of)</option>
                                    <option value="C/O">C/O (Care of)</option>
                                    <option value="F/O">F/O (Father of)</option>
                                    <option value="M/O">M/O (Mother of)</option>
                                    <option value="Guardian">Guardian</option>
                                </select>
                            </div>

                            <!-- 6. Care Of Name -->
                            <div class="cm-field cm-col-12">
                                <label class="cm-label-top">Care Of Name</label>
                                <input type="text" class="cm-input" @bind="current.careof" placeholder="Father / Husband / Guardian Name" />
                            </div>
                        </div>
                    </div>

                    <!-- Vertical Column Divider -->
                    <div class="form-column-divider"></div>

                    <!-- RIGHT COLUMN: Contact, Doctor & Address -->
                    <div class="form-column">
                        <h4 class="form-section-title">
                            <span class="material-symbols-outlined">map</span> Contact, Doctor & Address
                        </h4>
                        <div class="cm-container">
                            <!-- 7. Phone No & 8. Area -->
                            <div class="cm-field cm-col-6">
                                <label class="cm-label-top">Phone No <span class="required-star">*</span></label>
                                <input type="text" class="cm-input" @bind="current.mobile" placeholder="Mobile / Phone number" />
                            </div>
                            <div class="cm-field cm-col-6">
                                <label class="cm-label-top">Area</label>
                                <div style="display: flex; gap: 0.35rem; align-items: center;">
                                    <input type="text" class="cm-input" @bind="current.area" @bind:after="OnAreaChanged" list="reg-area-list" placeholder="Enter or select area" style="flex: 1;" />
                                    <button type="button" class="btn-add-area-icon" @onclick="OpenAddAreaModal" title="Add New Area" style="height: 36px; width: 36px; min-width: 36px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #4f46e5, #4338ca); color: white; border: none; border-radius: 6px; cursor: pointer;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                                        </svg>
                                    </button>
                                </div>
                                <datalist id="reg-area-list">
                                    @if (areaOptions != null && areaOptions.Any())
                                    {
                                        @foreach (var a in areaOptions)
                                        {
                                            <option value="@a.areaname">@a.areaname @(string.IsNullOrEmpty(a.areapincode) ? "" : $"({a.areapincode})")</option>
                                        }
                                    }
                                </datalist>
                            </div>

                            <!-- 9. Pincode & 10. Preferred Doctor -->
                            <div class="cm-field cm-col-6">
                                <label class="cm-label-top">Pincode</label>
                                <input type="text" class="cm-input" @bind="current.zipcode" placeholder="6-digit pincode" />
                            </div>
                            <div class="cm-field cm-col-6">
                                <label class="cm-label-top">Preferred Doctor</label>
                                <select class="cm-input" @bind="current.dcode">
                                    <option value="0">Select Preferred Doctor</option>
                                    @if (doctors != null && doctors.Any())
                                    {
                                        @foreach (var doctor in doctors)
                                        {
                                            <option value="@doctor.dcode">@doctor.name</option>
                                        }
                                    }
                                </select>
                            </div>

                            <!-- 11. Address -->
                            <div class="cm-field cm-col-12">
                                <label class="cm-label-top">Address</label>
                                <textarea class="cm-input cm-address-input" @bind="current.street" placeholder="17/19, kuppipalayam road"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Bar matching Reference Image 2 -->
            <div class="modal-footer-bar">
                <button type="button" class="btn-cancel" @onclick="CloseModal">Cancel</button>
                <button type="button" class="btn-save" @onclick="SaveCustomer" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Saving Entry...</span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="btn-icon-save">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z" />
                        </svg>
                        <span>@(current.custid > 0 ? "Update Patient" : "Save Patient")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (showAddAreaModal)
{
    <div class="modal-backdrop-custom" style="z-index: 10050; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog-custom" style="max-width: 400px; z-index: 10051; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2); background: #ffffff;">
            <div class="modal-header-bar" style="padding: 1rem 1.25rem; background: #f8fafc; border-bottom: 1px solid #e2e8f0; border-top-left-radius: 12px; border-top-right-radius: 12px; display: flex; align-items: center; justify-content: space-between;">
                <h3 class="modal-title-text" style="font-size: 1rem; font-weight: 700; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#4f46e5" viewBox="0 0 16 16">
                        <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                    </svg>
                    <span>Add New Area Entry</span>
                </h3>
                <button type="button" class="btn-close-modal" @onclick="CloseAddAreaModal" title="Close" style="border: none; background: transparent; font-size: 1.3rem; cursor: pointer; color: #64748b; padding: 0;">×</button>
            </div>
            <div class="modal-body-content" style="padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem;">
                <div class="cm-field">
                    <label class="cm-label-top" style="font-size: 0.8rem; font-weight: 600; color: #475569; margin-bottom: 0.35rem; display: block;">Area Name <span style="color: #ef4444;">*</span></label>
                    <input type="text" class="cm-input" @bind="newAreaName" placeholder="e.g. Gandhipuram, RS Puram" style="width: 100%; height: 38px;" />
                </div>
                <div class="cm-field">
                    <label class="cm-label-top" style="font-size: 0.8rem; font-weight: 600; color: #475569; margin-bottom: 0.35rem; display: block;">Pincode (Optional)</label>
                    <input type="text" class="cm-input" @bind="newAreaPincode" placeholder="6-digit pincode" style="width: 100%; height: 38px;" />
                </div>
            </div>
            <div class="modal-footer-bar" style="padding: 0.75rem 1.25rem; background: #f8fafc; border-top: 1px solid #e2e8f0; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; display: flex; justify-content: flex-end; gap: 0.5rem;">
                <button type="button" class="btn-cancel" @onclick="CloseAddAreaModal" style="padding: 0.45rem 1rem; border-radius: 6px; font-size: 0.85rem;">Cancel</button>
                <button type="button" class="btn-save" @onclick="SaveNewAreaAsync" disabled="@isSavingArea" style="padding: 0.45rem 1.25rem; border-radius: 6px; font-size: 0.85rem; background: linear-gradient(135deg, #4f46e5, #4338ca); color: white; border: none; font-weight: 600;">
                    @if (isSavingArea)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Area</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; } = false;
    [Parameter] public CustomerModel? EditPatient { get; set; }
    [Parameter] public long? EditCustId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<CustomerModel> OnPatientSaved { get; set; }

    public class DoctorModel
    {
        public int dcode { get; set; }
        public string name { get; set; } = "";
    }

    private CustomerModel current = new();
    private bool isSaving = false;
    private string TenantCode = "";
    private string AuthToken = "";
    private List<DoctorModel> doctors = new();
    private List<Medico_Backend.Model.AreaMasterModel> areaOptions = new();
    private bool isStandalonePage = false;
    private long lastLoadedCustId = -1;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.Uri;
        if (uri.Contains("/nishant/new-patient-registration"))
        {
            isStandalonePage = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (EditPatient != null && EditPatient.custid > 0 && EditPatient.custid != lastLoadedCustId)
        {
            lastLoadedCustId = EditPatient.custid;
            await LoadPatientDataForEdit(EditPatient.custid, EditPatient);
        }
        else if (EditCustId.HasValue && EditCustId.Value > 0 && EditCustId.Value != lastLoadedCustId)
        {
            lastLoadedCustId = EditCustId.Value;
            await LoadPatientDataForEdit(EditCustId.Value, null);
        }
        else if (EditPatient == null && !EditCustId.HasValue && lastLoadedCustId != 0 && !isStandalonePage)
        {
            current = new CustomerModel();
            lastLoadedCustId = 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : TenantState.TenantCode ?? "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : TenantState.AuthToken ?? "";

                await LoadDoctors();
                await LoadAreas();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[NewPatientRegistration] Init error: {ex.Message}");
            }
        }
    }

    private async Task LoadPatientDataForEdit(long custid, CustomerModel? fallback)
    {
        try
        {
            if (fallback != null)
            {
                current = JsonConvert.DeserializeObject<CustomerModel>(JsonConvert.SerializeObject(fallback)) ?? new CustomerModel();
            }

            using var client = CreateClient();
            var url = $"api/Customer/get?custid={custid}";
            var response = await client.GetAsync(url);
            if (!response.IsSuccessStatusCode)
            {
                response = await client.GetAsync($"Customer/get?custid={custid}");
            }

            if (response.IsSuccessStatusCode)
            {
                var responseStr = await response.Content.ReadAsStringAsync();
                if (!string.IsNullOrEmpty(responseStr))
                {
                    if (responseStr.TrimStart().StartsWith("["))
                    {
                        var list = JsonConvert.DeserializeObject<List<CustomerModel>>(responseStr);
                        var matched = list?.FirstOrDefault(x => x.custid == custid);
                        if (matched != null) current = matched;
                    }
                    else
                    {
                        var single = JsonConvert.DeserializeObject<CustomerModel>(responseStr);
                        if (single != null && single.custid > 0) current = single;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[NewPatientRegistration] Error fetching patient data for edit: {ex.Message}");
        }
        StateHasChanged();
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareUrl");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private bool isAgeYearsTyped = false;
    private bool isAgeMonthsTyped = false;
    private bool isAgeDaysTyped = false;

    private string ageYearsInput
    {
        get => (current.ageyears == 0 && !current.dateofbirth.HasValue && !isAgeYearsTyped) ? "" : current.ageyears.ToString();
        set
        {
            if (int.TryParse(value, out int y))
            {
                current.ageyears = y;
                isAgeYearsTyped = true;
            }
            else if (string.IsNullOrWhiteSpace(value))
            {
                current.ageyears = 0;
                isAgeYearsTyped = false;
            }
        }
    }

    private string ageMonthsInput
    {
        get => (current.agemonths == 0 && !current.dateofbirth.HasValue && !isAgeMonthsTyped) ? "" : current.agemonths.ToString();
        set
        {
            if (int.TryParse(value, out int m))
            {
                current.agemonths = m;
                isAgeMonthsTyped = true;
            }
            else if (string.IsNullOrWhiteSpace(value))
            {
                current.agemonths = 0;
                isAgeMonthsTyped = false;
            }
        }
    }

    private string ageDaysInput
    {
        get => (current.agedays == 0 && !current.dateofbirth.HasValue && !isAgeDaysTyped) ? "" : current.agedays.ToString();
        set
        {
            if (int.TryParse(value, out int d))
            {
                current.agedays = d;
                isAgeDaysTyped = true;
            }
            else if (string.IsNullOrWhiteSpace(value))
            {
                current.agedays = 0;
                isAgeDaysTyped = false;
            }
        }
    }

    private void CalculateAge()
    {
        if (!current.dateofbirth.HasValue)
        {
            current.ageyears = 0;
            current.agemonths = 0;
            current.agedays = 0;
            isAgeYearsTyped = false;
            isAgeMonthsTyped = false;
            isAgeDaysTyped = false;
            return;
        }

        DateTime dob = current.dateofbirth.Value;
        DateTime today = DateTime.Now;

        int years = today.Year - dob.Year;
        int months = today.Month - dob.Month;
        int days = today.Day - dob.Day;

        if (months < 0)
        {
            years--;
            months += 12;
        }

        if (days < 0)
        {
            months--;
            if (months < 0)
            {
                years--;
                months += 12;
            }
            DateTime lastMonth = today.AddMonths(-1);
            days += DateTime.DaysInMonth(lastMonth.Year, lastMonth.Month);
        }

        current.ageyears = years;
        current.agemonths = months;
        current.agedays = days;
        isAgeYearsTyped = true;
        isAgeMonthsTyped = true;
        isAgeDaysTyped = true;
        StateHasChanged();
    }

    private async Task LoadDoctors()
    {
        try
        {
            var res = await DoctorService.GetDoctorsAsync();
            if (res != null)
            {
                doctors = res.Select(d => new DoctorModel { dcode = d.dcode, name = d.name ?? d.doctorfullname ?? "" }).ToList();
            }
        }
        catch { }
    }

    private async Task LoadAreas()
    {
        try
        {
            var res = await AreaMasterService.GetAreasAsync();
            if (res != null)
            {
                areaOptions = res.Where(a => !a.deleted).ToList();
            }
        }
        catch { }
    }

    private void OnAreaChanged()
    {
        if (!string.IsNullOrWhiteSpace(current.area) && string.IsNullOrWhiteSpace(current.zipcode) && areaOptions != null)
        {
            var match = areaOptions.FirstOrDefault(a => string.Equals(a.areaname, current.area, StringComparison.OrdinalIgnoreCase));
            if (match != null && !string.IsNullOrWhiteSpace(match.areapincode))
            {
                current.zipcode = match.areapincode;
            }
        }
    }

    private bool showAddAreaModal = false;
    private string newAreaName = string.Empty;
    private string newAreaPincode = string.Empty;
    private bool isSavingArea = false;

    private void OpenAddAreaModal()
    {
        newAreaName = string.Empty;
        newAreaPincode = string.Empty;
        showAddAreaModal = true;
    }

    private void CloseAddAreaModal()
    {
        showAddAreaModal = false;
    }

    private async Task SaveNewAreaAsync()
    {
        if (string.IsNullOrWhiteSpace(newAreaName))
        {
            Toast.ShowError("Please enter Area Name.");
            return;
        }

        try
        {
            isSavingArea = true;
            var areaModel = new Medico_Backend.Model.AreaMasterModel
            {
                areaname = newAreaName.Trim(),
                areapincode = string.IsNullOrWhiteSpace(newAreaPincode) ? null : newAreaPincode.Trim(),
                tenant_code = !string.IsNullOrEmpty(TenantCode) ? TenantCode : TenantState.TenantCode,
                entereddate = DateTime.Now,
                ibsdate = DateTime.Now,
                deleted = false
            };

            bool success = await AreaMasterService.InsertAreaAsync(areaModel);
            current.area = newAreaName.Trim();
            if (!string.IsNullOrWhiteSpace(newAreaPincode))
            {
                current.zipcode = newAreaPincode.Trim();
            }

            if (!areaOptions.Any(a => string.Equals(a.areaname, newAreaName.Trim(), StringComparison.OrdinalIgnoreCase)))
            {
                areaOptions.Add(areaModel);
            }

            Toast.ShowSuccess($"New Area '{newAreaName}' added successfully!");
            await LoadAreas();
            CloseAddAreaModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving area: {ex.Message}");
            current.area = newAreaName.Trim();
            CloseAddAreaModal();
        }
        finally
        {
            isSavingArea = false;
        }
    }

    private async Task CloseModal()
    {
        current = new CustomerModel();
        lastLoadedCustId = -1;
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
        if (isStandalonePage)
        {
            NavigationManager.NavigateTo("/nishant/reception-portal");
        }
    }

    private async Task SaveCustomer()
    {
        if (string.IsNullOrWhiteSpace(current.name))
        {
            Toast.ShowError("Name is required.");
            return;
        }

        try
        {
            isSaving = true;
            bool isEditMode = current.custid > 0;

            if (!string.IsNullOrWhiteSpace(current.name))
            {
                current.name = current.name.Trim();
            }

            current.namewithinitials = current.name?.Trim();
            current.phone = current.mobile?.Trim();
            current.consultantdcode = current.dcode > 0 ? current.dcode : null;
            current.tenant_code = !string.IsNullOrEmpty(TenantCode) ? TenantCode : TenantState.TenantCode;
            current.bhcode = TenantState.UserData?.BranchCode > 0 ? TenantState.UserData.BranchCode.Value : 1;
            current.usercode = TenantState.UserCode > 0 ? TenantState.UserCode : 1;
            current.computercode = 1;
            if (!isEditMode)
            {
                current.entereddate = DateTime.Now;
                current.ibsdate = DateTime.Now;
            }
            current.deleted = false;

            using var client = CreateClient();
            using var content = new MultipartFormDataContent();

            foreach (var prop in current.GetType().GetProperties())
            {
                var value = prop.GetValue(current);
                if (value != null)
                {
                    string stringValue;
                    if (value is DateTime dt)
                    {
                        var utcDt = dt.Kind == DateTimeKind.Utc ? dt : dt.ToUniversalTime();
                        stringValue = utcDt.ToString("yyyy-MM-ddTHH:mm:ss.fffZ");
                    }
                    else
                    {
                        stringValue = value.ToString() ?? "";
                    }

                    content.Add(new StringContent(stringValue), prop.Name);
                    content.Add(new StringContent(stringValue), $"CustomerModel.{prop.Name}");
                    content.Add(new StringContent(stringValue), $"Customer.{prop.Name}");
                }
            }

            string primaryEndpoint = isEditMode ? "api/Customer/update" : "api/Customer/insert";
            string fallbackEndpoint = isEditMode ? "Customer/update" : "Customer/insert";

            var response = await client.PostAsync(primaryEndpoint, content);
            if (!response.IsSuccessStatusCode)
            {
                response = await client.PostAsync(fallbackEndpoint, content);
            }

            var responseString = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"[NewPatientRegistration Save] Endpoint Response: {responseString}");

            if (response.IsSuccessStatusCode)
            {
                if (!string.IsNullOrWhiteSpace(responseString))
                {
                    try
                    {
                        var trimmed = responseString.Trim();
                        if (trimmed.StartsWith("{"))
                        {
                            var jObj = Newtonsoft.Json.Linq.JObject.Parse(trimmed);
                            long parsedId = 0;
                            if (jObj["custid"] != null && long.TryParse(jObj["custid"]?.ToString(), out long c1)) parsedId = c1;
                            else if (jObj["id"] != null && long.TryParse(jObj["id"]?.ToString(), out long c2)) parsedId = c2;
                            else if (jObj["CustId"] != null && long.TryParse(jObj["CustId"]?.ToString(), out long c3)) parsedId = c3;

                            if (parsedId > 0) current.custid = parsedId;

                            if (jObj["custcode"] != null && !string.IsNullOrWhiteSpace(jObj["custcode"]?.ToString()))
                            {
                                current.custcode = jObj["custcode"]?.ToString();
                            }

                            var returnedCust = JsonConvert.DeserializeObject<CustomerModel>(trimmed);
                            if (returnedCust != null)
                            {
                                if (returnedCust.custid > 0) current.custid = returnedCust.custid;
                                if (!string.IsNullOrWhiteSpace(returnedCust.custcode)) current.custcode = returnedCust.custcode;
                                if (!string.IsNullOrWhiteSpace(returnedCust.name)) current.name = returnedCust.name;
                            }
                        }
                        else if (long.TryParse(trimmed, out long newCustId) && newCustId > 0)
                        {
                            current.custid = newCustId;
                        }
                    }
                    catch { }
                }

                if (current.custid <= 0 && !string.IsNullOrWhiteSpace(current.mobile))
                {
                    try
                    {
                        var searchRes = await client.GetAsync($"api/Customer/search?key={Uri.EscapeDataString(current.mobile)}");
                        if (searchRes.IsSuccessStatusCode)
                        {
                            var searchJson = await searchRes.Content.ReadAsStringAsync();
                            var list = JsonConvert.DeserializeObject<List<CustomerModel>>(searchJson);
                            var match = list?.FirstOrDefault(x => x.mobile == current.mobile || x.name == current.name);
                            if (match != null && match.custid > 0)
                            {
                                current.custid = match.custid;
                                if (!string.IsNullOrWhiteSpace(match.custcode)) current.custcode = match.custcode;
                            }
                        }
                    }
                    catch { }
                }

                if (string.IsNullOrWhiteSpace(current.namewithinitials))
                {
                    current.namewithinitials = current.name;
                }

                if (isEditMode)
                {
                    Toast.ShowSuccess("Patient updated successfully!");
                }
                else if (isStandalonePage)
                {
                    Toast.ShowSuccess("Patient registered successfully!");
                }
                if (OnPatientSaved.HasDelegate)
                {
                    await OnPatientSaved.InvokeAsync(current);
                }
                await CloseModal();
            }
            else
            {
                Toast.ShowError($"Failed to save patient: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error saving patient: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
