@page "/customercustcodemaster"
@using Newtonsoft.Json
@using SharedComponents.Rcl.Models
@using SharedComponents.Rcl.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Booking.Components.Layout
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject Booking.Services.ToastService Toast
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject ProtectedSessionStorage _sessionStorage
@inject TenantSessionState TenantState
@inject NavigationManager NavigationManager

<div class="referral-page lc-fadeInUp">
    <DnaLoader IsLoading="@isLoading" Message="Loading CustCode configurations..." />

    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">qr_code_2</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">CustCode Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    
                    <span class="status-text">Patient ID Prefix &amp; Sequence Settings</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="search-controls">
                @if (configs == null || !configs.Any())
                {
                    <button class="btn-new-entry" @onclick="NewConfig">+ Set Config</button>
                }
            </div>
        </div>
    </div>

    @if (showForm)
    {
        <div class="modal-overlay">
            <div class="modal-form-card">
                <div class="modal-header-bar">
                    <h3>@(isEditMode ? "Edit CustCode Settings" : "Configure CustCode Settings")</h3>
                    <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                        </svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-0 form-section">
                        <div class="mt-0">
                            <div class="form-group mb-16">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label style="margin-bottom: 0; font-weight: 600;">CustCode Prefix *</label>
                                    @if (isSubmitted && string.IsNullOrWhiteSpace(custCodePrefix))
                                    {
                                        <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                    }
                                </div>
                                <input type="text" class="lab-input" @bind="custCodePrefix" placeholder="e.g. PAT-, BHS-" required />
                            </div>
                            <div class="form-group mb-16">
                                <label style="margin-bottom: 4px; font-weight: 600;">Current Sequence *</label>
                                <input type="number" class="lab-input" @bind="custCodeSequence" placeholder="0" required />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer-bar">
                    <button type="button" class="btn-cancel" @onclick="CloseForm">Cancel</button>
                    <button type="button" class="btn-save" @onclick="SaveConfig">
                         <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                        </svg>
                        Save Settings
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="directory-section custcode-directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="width: 200px;">CUSTCODE PREFIX</th>
                        <th style="width: 200px;">CURRENT SEQUENCE</th>
                        <th style="width: 250px;">CREATED DATE</th>
                        <th style="width: 250px;">UPDATED DATE</th>
                        <th class="text-center" style="width: 120px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (configs != null && configs.Any())
                    {
                        @foreach (var config in configs)
                        {
                            <tr class="lc-table-row">
                                <td class="lc-color-slate-500 lc-font-mono lc-font-700 lc-font-13">@config.custcodeprefix</td>
                                <td class="font-bold text-slate-800">@config.sequence</td>
                                <td class="text-slate-400 font-12">@FormatDateTime(config.createddate)</td>
                                <td class="text-slate-400 font-12">@FormatDateTime(config.updateddate)</td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px;">
                                        <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => EditConfig(config)" title="Edit">
                                            <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center p-48 text-slate-400 italic">No CustCode configuration found. Click '+ Set Config' to configure.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<CustomerCustCodeMasterModel> configs = new();
    private string custCodePrefix = "";
    private long custCodeSequence = 0;
    private long editingId = 0;
    private bool isLoading = true;
    private bool showForm = false;
    private bool isEditMode = false;
    private bool isSubmitted = false;

    private string BaseUrl => "api/";

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";

    protected override void OnInitialized()
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    TenantState.SetSession(TenantCode, AuthToken, TenantName);
                    await LoadConfig();
                }
                else
                {
                    Toast.ShowError("Access denied: Missing valid session. Please log in again.");
                }
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Session Load Error: {ex.Message}");
            }
        }
    }

    private HttpClient CreateClient() 
    {
        var client = ClientFactory.CreateClient("LabCareUrl");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private async Task LoadConfig()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            using var client = CreateClient();
            var url = $"{BaseUrl}customer/custcode-master/get";
            var responseString = await client.GetStringAsync(url);
            
            configs = new List<CustomerCustCodeMasterModel>();
            if (!string.IsNullOrEmpty(responseString))
            {
                var trimmed = responseString.Trim();
                if (trimmed.StartsWith("["))
                {
                    configs = JsonConvert.DeserializeObject<List<CustomerCustCodeMasterModel>>(responseString) ?? new();
                }
                else if (trimmed.StartsWith("{"))
                {
                    var single = JsonConvert.DeserializeObject<CustomerCustCodeMasterModel>(responseString);
                    if (single != null)
                    {
                        configs.Add(single);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error loading configurations: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void NewConfig()
    {
        editingId = 0;
        custCodePrefix = "";
        custCodeSequence = 0;
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private void EditConfig(CustomerCustCodeMasterModel config)
    {
        editingId = config.id;
        custCodePrefix = config.custcodeprefix ?? "";
        custCodeSequence = config.sequence;
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveConfig()
    {
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(custCodePrefix))
        {
            Toast.ShowError("CustCode Prefix is required.");
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();
            using var client = CreateClient();

            if (isEditMode)
            {
                var req = new
                {
                    id = editingId,
                    tenant_code = TenantCode,
                    custcodeprefix = custCodePrefix,
                    sequence = custCodeSequence
                };
                var response = await client.PostAsJsonAsync($"{BaseUrl}customer/custcode-master/update", req);
                response.EnsureSuccessStatusCode();
                Toast.ShowSuccess("CustCode settings updated successfully.");
            }
            else
            {
                var req = new
                {
                    custcodeprefix = custCodePrefix,
                    sequence = custCodeSequence
                };
                var response = await client.PostAsJsonAsync($"{BaseUrl}customer/custcode-master/insert", req);
                response.EnsureSuccessStatusCode();
                Toast.ShowSuccess("CustCode settings configured successfully.");
            }

            showForm = false;
            await LoadConfig();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error saving settings: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseForm()
    {
        showForm = false;
        isSubmitted = false;
    }

    private string FormatDateTime(DateTime? dt)
    {
        if (!dt.HasValue) return "-";
        var utc = dt.Value.Kind == DateTimeKind.Utc ? dt.Value : DateTime.SpecifyKind(dt.Value, DateTimeKind.Utc);
        return utc.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/patientmaster");
    }
}
