@page "/ot-fee-category"
@page "/ot-fee-categories"
@page "/fee-category-master"
@rendermode InteractiveServer

@using medico_backend.Model
@using Booking.Services
@using Booking.Helpers
@inject OtService OtService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<PageTitle>Fee Category Master — Medico</PageTitle>

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card">
        <div class="header-left-group">
            <div class="header-icon-box">
                <i class="bi bi-tags-fill"></i>
            </div>
            <div class="header-text-group">
                <div class="title-row">
                    <h2 class="lab-title-text m-0">Fee Category Master</h2>
                    <span class="count-badge">@categoriesList.Count @(categoriesList.Count == 1 ? "Category" : "Categories")</span>
                </div>
                <div class="header-subtitle-row">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Doctor &amp; OT Staff Fee Allocation Categories Master</span>
                </div>
            </div>
        </div>

        <div class="header-right-group">
            <div class="search-input-wrapper">
                <i class="bi bi-search search-icon"></i>
                <input type="text" 
                       placeholder="Search fee categories..." 
                       @bind="SearchQuery" 
                       @bind:event="oninput" 
                       class="lc-search-input" />
                @if (!string.IsNullOrWhiteSpace(SearchQuery))
                {
                    <button type="button" class="search-clear-btn" @onclick="() => SearchQuery = string.Empty" title="Clear search">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>
            
            <button class="btn-new-entry" @onclick="OpenAddModal">
                <i class="bi bi-plus-lg"></i>
                <span>Add Fee Category</span>
            </button>
        </div>
    </div>

    @* --- STATS MINI BAR --- *@
    <div class="stats-mini-bar">
        <div class="stat-mini-card @(statusFilter == "ALL" ? "active-filter" : "")" @onclick='() => statusFilter = "ALL"' role="button" title="View all categories">
            <div class="stat-mini-icon stat-icon-primary">
                <i class="bi bi-collection-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-mini-value">@categoriesList.Count</div>
                <div class="stat-mini-label">Total Categories</div>
            </div>
            @if (statusFilter == "ALL")
            {
                <span class="filter-indicator-dot"></span>
            }
        </div>

        <div class="stat-mini-card @(statusFilter == "ACTIVE" ? "active-filter" : "")" @onclick='() => statusFilter = "ACTIVE"' role="button" title="Filter active categories">
            <div class="stat-mini-icon stat-icon-success">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-mini-value">@categoriesList.Count(c => c.is_active)</div>
                <div class="stat-mini-label">Active Categories</div>
            </div>
            @if (statusFilter == "ACTIVE")
            {
                <span class="filter-indicator-dot"></span>
            }
        </div>

        <div class="stat-mini-card @(statusFilter == "INACTIVE" ? "active-filter" : "")" @onclick='() => statusFilter = "INACTIVE"' role="button" title="Filter inactive categories">
            <div class="stat-mini-icon stat-icon-danger">
                <i class="bi bi-dash-circle-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-mini-value">@categoriesList.Count(c => !c.is_active)</div>
                <div class="stat-mini-label">Inactive Categories</div>
            </div>
            @if (statusFilter == "INACTIVE")
            {
                <span class="filter-indicator-dot"></span>
            }
        </div>
    </div>

    @* --- DIRECTORY TABLE --- *@
    <div class="directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th class="col-category">CATEGORY LABEL</th>
                        <th class="col-status">STATUS</th>
                        <th class="col-created">CREATED AT (IST)</th>
                        <th class="col-actions">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="4" class="text-center p-48 text-slate-400">
                                <div class="spinner-border spinner-border-sm text-indigo-600 mb-2"></div>
                                <div>Loading fee categories...</div>
                            </td>
                        </tr>
                    }
                    else if (FilteredCategories.Any())
                    {
                        @for (int i = 0; i < FilteredCategories.Count; i++)
                        {
                            var item = FilteredCategories[i];
                            var istCreated = item.created_at.ToIndianTime();
                            <tr class="lc-table-row">
                                <td class="col-category">
                                    <div class="category-name-cell">
                                        <div class="category-avatar-box">
                                            <i class="bi bi-tag-fill"></i>
                                        </div>
                                        <div>
                                            <span class="category-title-text font-bold text-slate-800">@item.fee_type_label</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="col-status">
                                    @if (item.is_active)
                                    {
                                        <span class="status-pill status-pill-active">
                                            <span class="status-pill-dot"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-pill-inactive">
                                            <span class="status-pill-dot"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td class="col-created">
                                    <div class="date-time-cell">
                                        <span class="date-text">@istCreated.ToString("dd-MM-yyyy")</span>
                                        <span class="time-text"><i class="bi bi-clock"></i>@istCreated.ToString("hh:mm tt") IST</span>
                                    </div>
                                </td>
                                <td class="col-actions">
                                    <div class="d-flex justify-content-center gap-2">
                                        <button type="button" class="lc-circle-btn-32 edit-btn" @onclick="() => OpenEditModal(item)" title="Edit Category">
                                            <span class="material-symbols-outlined font-18">edit</span>
                                        </button>
                                        <button type="button" class="lc-circle-btn-32 delete-btn" @onclick="() => PromptDelete(item)" title="Delete Category">
                                            <span class="material-symbols-outlined font-18">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center p-48 text-slate-400">
                                <div class="empty-state-box">
                                    <div class="empty-state-icon">
                                        <i class="bi bi-tags"></i>
                                    </div>
                                    <div class="empty-state-title">No Fee Categories Found</div>
                                    <div class="empty-state-desc">@(string.IsNullOrWhiteSpace(SearchQuery) ? "Click '+ Add Fee Category' to create your first fee category." : "No categories match your search query.")</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   CREATE / EDIT MODAL POPUP
   ═══════════════════════════════════════════════════════════════════ *@
@if (showFormModal)
{
    <div class="modal-overlay">
        <div class="modal-form-card" style="max-width: 480px;" @onclick:stopPropagation>
            <div class="modal-header-bar">
                <div class="modal-header-title-box">
                    <div class="modal-icon-badge">
                        <i class="bi bi-tag-fill"></i>
                    </div>
                    <div class="modal-title-wrap">
                        <h3 class="modal-title-text">@(isEditMode ? "Edit Fee Category" : "New Fee Category")</h3>
                        <p class="modal-subtitle-text">Doctor &amp; OT staff fee allocation category</p>
                    </div>
                </div>
                <button type="button" class="modal-close-btn" @onclick="() => showFormModal = false" disabled="@isSaving" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body">
                <!-- Field 1: Category Name -->
                <div class="form-group mb-0">
                    <label class="form-label-styled">Category Name / Label <span class="text-danger">*</span></label>
                    <div class="input-with-icon-wrapper">
                        <i class="bi bi-tag input-field-icon"></i>
                        <input type="text" 
                               class="lab-input lab-input-with-icon font-bold @(isSubmitted && string.IsNullOrWhiteSpace(formLabel) ? "is-invalid" : "")" 
                               placeholder="e.g. Surgeon Fee, Anesthetist Fee, OT Nursing Fee" 
                               @bind="formLabel" 
                               autofocus />
                    </div>
                    @if (isSubmitted && string.IsNullOrWhiteSpace(formLabel))
                    {
                        <div class="validation-error-msg">
                            <i class="bi bi-exclamation-circle-fill me-1"></i> Category name is required
                        </div>
                    }
                </div>

                <!-- Field 2: Active Toggle Button (Clean & Minimal) -->
                <div class="active-toggle-container">
                    <label class="toggle-switch-wrap">
                        <input type="checkbox" id="catActiveSwitch" @bind="formIsActive" />
                        <span class="toggle-slider"></span>
                    </label>
                    <label class="toggle-label-text @(formIsActive ? "text-active" : "text-inactive")" for="catActiveSwitch">
                        @(formIsActive ? "Active" : "Inactive")
                    </label>
                </div>
            </div>

            <div class="modal-footer-bar">
                <button type="button" class="btn-secondary-outline" @onclick="() => showFormModal = false" disabled="@isSaving">Cancel</button>
                <button type="button" class="btn-save" @onclick="SaveCategoryAsync" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle"></i>
                        <span>@(isEditMode ? "Update Category" : "Save Category")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════════════
   DELETE CONFIRMATION MODAL
   ═══════════════════════════════════════════════════════════════════ *@
@if (showDeleteConfirm && deleteTarget != null)
{
    <div class="modal-overlay">
        <div class="modal-form-card" style="max-width: 420px;" @onclick:stopPropagation>
            <div class="delete-modal-body">
                <div class="delete-icon-wrapper">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h4 class="delete-modal-title">Delete Fee Category?</h4>
                <p class="delete-modal-desc">
                    Are you sure you want to delete <strong class="text-slate-800">@deleteTarget.fee_type_label</strong>? This action cannot be undone.
                </p>
                <div class="delete-modal-actions">
                    <button type="button" class="btn-secondary-outline w-100" @onclick="() => showDeleteConfirm = false">Cancel</button>
                    <button type="button" class="btn-danger-filled w-100" @onclick="ExecuteDeleteAsync">
                        <i class="bi bi-trash3-fill me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
