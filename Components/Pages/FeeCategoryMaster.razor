@code {
    private List<OtFeeSplitMasterModel> categoriesList = new();
    private bool isLoading = true;
    private string SearchQuery = "";
    private string statusFilter = "ALL";

    // Form Modal State
    private bool showFormModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private bool isSubmitted = false;

    private Guid formFeeTypeId = Guid.Empty;
    private string formLabel = "";
    private bool formIsActive = true;

    // Delete State
    private bool showDeleteConfirm = false;
    private OtFeeSplitMasterModel? deleteTarget = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private void ToggleActiveStatus()
    {
        formIsActive = !formIsActive;
    }

    private async Task LoadCategoriesAsync()
    {
        isLoading = true;
        try
        {
            categoriesList = await OtService.GetFeeSplitMastersAsync(activeOnly: false);
            // Auto seed if empty
            if (!categoriesList.Any())
            {
                var defaultCategories = new[] { "Surgeon Fee", "Assistant Surgeon Fee", "Anesthetist Fee", "OT Nursing Fee", "Scrub Nurse Fee", "OT Technician Fee" };
                foreach (var cat in defaultCategories)
                {
                    try { await OtService.AddFeeSplitMasterAsync(new AddOtFeeSplitMasterRequest { fee_type_label = cat, is_active = true }); } catch { }
                }
                categoriesList = await OtService.GetFeeSplitMastersAsync(activeOnly: false);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading categories: {ex.Message}");
            categoriesList = new();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private List<OtFeeSplitMasterModel> FilteredCategories
    {
        get
        {
            var list = categoriesList.AsEnumerable();
            if (statusFilter == "ACTIVE") list = list.Where(c => c.is_active);
            else if (statusFilter == "INACTIVE") list = list.Where(c => !c.is_active);

            if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                var q = SearchQuery.Trim().ToLowerInvariant();
                list = list.Where(c => c.fee_type_label.ToLowerInvariant().Contains(q));
            }

            return list.OrderBy(c => c.fee_type_label).ToList();
        }
    }

    private void OpenAddModal()
    {
        isEditMode = false;
        isSubmitted = false;
        formFeeTypeId = Guid.Empty;
        formLabel = "";
        formIsActive = true;
        showFormModal = true;
    }

    private void OpenEditModal(OtFeeSplitMasterModel item)
    {
        isEditMode = true;
        isSubmitted = false;
        formFeeTypeId = item.fee_type_id;
        formLabel = item.fee_type_label;
        formIsActive = item.is_active;
        showFormModal = true;
    }

    private async Task SaveCategoryAsync()
    {
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(formLabel))
        {
            ToastService.ShowWarning("Please enter a category name.");
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            OtApiResponse res;
            if (isEditMode)
            {
                res = await OtService.UpdateFeeSplitMasterAsync(new UpdateOtFeeSplitMasterRequest
                {
                    fee_type_id = formFeeTypeId,
                    fee_type_label = formLabel.Trim(),
                    is_active = formIsActive
                });
            }
            else
            {
                res = await OtService.AddFeeSplitMasterAsync(new AddOtFeeSplitMasterRequest
                {
                    fee_type_label = formLabel.Trim(),
                    is_active = formIsActive
                });
            }

            if (res.IsSuccess)
            {
                ToastService.ShowSuccess(isEditMode ? "Fee category updated!" : "Fee category created!");
                showFormModal = false;
                await LoadCategoriesAsync();
            }
            else
            {
                ToastService.ShowError(res.message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving category: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void PromptDelete(OtFeeSplitMasterModel item)
    {
        deleteTarget = item;
        showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (deleteTarget == null) return;
        try
        {
            var res = await OtService.DeleteFeeSplitMasterAsync(deleteTarget.fee_type_id);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess("Fee category deleted.");
                showDeleteConfirm = false;
                deleteTarget = null;
                await LoadCategoriesAsync();
            }
            else
            {
                ToastService.ShowError(res.message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }
}
