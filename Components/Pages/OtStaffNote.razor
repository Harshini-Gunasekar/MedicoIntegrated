@page "/ot-staff-note"
@page "/ot-staff-notes"
@page "/ot-staff-note/{RequestId:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Booking.Models
@using Booking.Services
@using Booking.Helpers
@using medico_backend.Model
@using Medico_Backend.Model
@using System.Text.Json
@inject OtService OtService
@inject DoctorService DoctorService
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.UomMasterService UomService
@inject Booking.Services.CaseSheetService CaseSheetService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<PageTitle>OT Staff Notes — Medico</PageTitle>

<div class="referral-page ot-staff-page lc-fadeInUp">
    <!-- ========================================================================= -->
    <!-- 1. TOP HEADER CONSOLE WITH LIVE CASE SEARCH                                -->
    <!-- ========================================================================= -->
    <div class="staff-page-header">
        <div class="header-title-left">
            <div class="header-icon-box">
                <i class="bi bi-journal-medical"></i>
            </div>
            <div class="header-title-text">
                <div class="header-title-row">
                    <h1 class="page-main-title">OT Staff Notes</h1>
                    @if (selectedRequest != null && staffNotesList.Any())
                    {
                        <span class="total-items-pill">@staffNotesList.Count @(staffNotesList.Count == 1 ? "Item" : "Items") Logged</span>
                    }
                </div>
                <div class="header-subtitle-row">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Intraoperative Medicines, Consumables &amp; Reusable Tools Log</span>
                </div>
            </div>
        </div>

        <div class="header-controls-right">
            <!-- Surgery Case Live Search Autocomplete Dropdown -->
            <div class="case-search-dropdown-wrap">
                @if (isCaseDropdownOpen)
                {
                    <div class="case-dropdown-backdrop" @onclick="() => isCaseDropdownOpen = false"></div>
                }

                <div class="case-search-box-inner @(isCaseDropdownOpen ? "focused" : "")">
                    <i class="bi bi-search case-search-icon"></i>
                    <input type="text"
                           class="case-search-input"
                           placeholder="Search patient name, surgery, ID..."
                           value="@caseSearchQuery"
                           @oninput="OnCaseSearchInput"
                           @onfocus="OpenCaseDropdown"
                           @onkeydown="HandleCaseSearchKeyDown" />
                    @if (!string.IsNullOrWhiteSpace(caseSearchQuery))
                    {
                        <button type="button" class="case-search-clear-btn" @onclick="ClearCaseSearch" title="Clear Search">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="case-search-toggle-btn @(isCaseDropdownOpen ? "open" : "")" @onclick="ToggleCaseDropdown" title="Toggle Cases List">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    }
                </div>

                @if (isCaseDropdownOpen)
                {
                    <div class="case-dropdown-popover">
                        <div class="popover-header">
                            <span class="popover-title">SURGERY CASES</span>
                            <span class="popover-badge">@FilteredSurgeryCases.Count matching</span>
                        </div>

                        <div class="popover-list-body">
                            @if (!FilteredSurgeryCases.Any())
                            {
                                <div class="popover-empty">
                                    <i class="bi bi-search text-slate-300 fs-3 d-block mb-1"></i>
                                    <div class="text-slate-600 font-bold font-13">No matching surgery cases</div>
                                    <div class="text-slate-400 font-11">Try searching by patient name, surgery, or surgeon</div>
                                </div>
                            }
                            else
                            {
                                @for (int idx = 0; idx < FilteredSurgeryCases.Count; idx++)
                                {
                                    var req = FilteredSurgeryCases[idx];
                                    var isHighlighted = idx == highlightedCaseIndex;
                                    var isSelected = selectedRequest?.request_id == req.request_id;
                                    var patName = !string.IsNullOrWhiteSpace(req.patient_name) ? req.patient_name : $"Patient {FormatCustId(req.custid)}";
                                    var docName = GetDoctorName(req.dcode);
                                    var localIdx = idx;

                                    <div class="case-dropdown-item @(isHighlighted ? "is-highlighted" : "") @(isSelected ? "is-selected" : "")"
                                         @onmousedown="() => SelectCase(req)"
                                         @onmousedown:preventDefault
                                         @onclick="() => SelectCase(req)"
                                         @onmouseenter="() => highlightedCaseIndex = localIdx">
                                        <div class="item-main-info">
                                            <div class="item-pat-row">
                                                <span class="item-patient-name font-bold">@patName</span>
                                                @if (!string.IsNullOrWhiteSpace(FormatCustId(req.custid)))
                                                {
                                                    <span class="item-custid-tag">ID: @FormatCustId(req.custid)</span>
                                                }
                                                @if (req.isvip == true)
                                                {
                                                    <span class="item-vip-badge"><i class="bi bi-star-fill me-0.5"></i>VIP</span>
                                                }
                                            </div>
                                            <div class="item-sub-row">
                                                <span class="item-procedure-name font-semibold text-slate-700">@req.procedure_name</span>
                                                @if (!string.IsNullOrWhiteSpace(req.diagnosis))
                                                {
                                                    <span class="item-diag-text text-slate-400">(@req.diagnosis)</span>
                                                }
                                                <span class="item-doc-name text-slate-500">• Dr. @docName</span>
                                            </div>
                                        </div>
                                        <div class="item-status-pill-wrap">
                                            <span class="badge @GetStatusBadgeClass(req.status) font-bold">
                                                @req.status.Replace("_", " ")
                                            </span>
                                            @if (isSelected)
                                            {
                                                <i class="bi bi-check-circle-fill text-indigo-600 font-14 ms-1" title="Currently Selected"></i>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Action Button -->
            <button type="button" class="btn-primary-action" @onclick="OpenAddStaffNoteModal" disabled="@(selectedRequest == null)" title="@(selectedRequest == null ? "Select a surgery case first" : "Log intraoperative item")">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Log Staff Item</span>
            </button>
        </div>
    </div>

    @if (isLoadingRequests)
    {
        <div class="p-5 text-center bg-white rounded-3 border my-3">
            <div class="spinner-border text-indigo-600 mb-2" style="width: 2rem; height: 2rem;" role="status"></div>
            <div class="text-slate-600 font-bold font-13">Loading surgery cases &amp; staff records...</div>
        </div>
    }
    else
    {
        <!-- ========================================================================= -->
        <!-- 2. ACTIVE SELECTED SURGERY CASE BANNER (Enhanced Clinical Card UI)         -->
        <!-- ========================================================================= -->
        @if (selectedRequest != null)
        {
            <div class="active-case-meta-banner">
                <div class="case-meta-patient-group">
                    <div class="patient-info-wrap">
                        <div class="patient-title-group">
                            <span class="patient-name">
                                @(!string.IsNullOrWhiteSpace(selectedRequest.patient_name) ? selectedRequest.patient_name : $"Patient {FormatCustId(selectedRequest.custid)}")
                            </span>
                            @if (!string.IsNullOrWhiteSpace(FormatCustId(selectedRequest.custid)))
                            {
                                <span class="patient-custid-badge">ID: @FormatCustId(selectedRequest.custid)</span>
                            }
                            @if (selectedRequest.isvip == true)
                            {
                                <span class="vip-badge">VIP</span>
                            }
                        </div>
                        <div class="patient-sub-meta">
                            @if (!string.IsNullOrWhiteSpace(selectedRequest.gender) || selectedRequest.ageyears.HasValue)
                            {
                                <span class="patient-demographics-pill">
                                    @selectedRequest.gender @(selectedRequest.ageyears.HasValue ? $"• {selectedRequest.ageyears} yrs" : "")
                                </span>
                            }
                            else
                            {
                                <span class="patient-demographics-pill">
                                    Registered Surgical Patient
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="case-meta-divider"></div>

                <div class="case-meta-columns">
                    <div class="meta-item">
                        <span class="meta-label">PROCEDURE &amp; INDICATION</span>
                        <div class="meta-proc-row">
                            <span class="meta-value font-bold text-slate-900" title="@selectedRequest.procedure_name">
                                @selectedRequest.procedure_name
                            </span>
                            @if (!string.IsNullOrWhiteSpace(selectedRequest.diagnosis))
                            {
                                <span class="meta-diagnosis-tag" title="@selectedRequest.diagnosis">
                                    @selectedRequest.diagnosis
                                </span>
                            }
                        </div>
                    </div>

                    <div class="meta-item">
                        <span class="meta-label">OPERATING SURGEON</span>
                        <span class="meta-value text-slate-800 font-semibold surgeon-name-box">
                            Dr. @GetDoctorName(selectedRequest.dcode)
                        </span>
                    </div>

                    <div class="meta-item">
                        <span class="meta-label">CLINICAL STATUS</span>
                        <span class="meta-value">
                            <span class="badge @GetStatusBadgeClass(selectedRequest.status) font-bold status-banner-badge">
                                @selectedRequest.status.Replace("_", " ")
                            </span>
                        </span>
                    </div>

                    <div class="meta-item meta-fee-item">
                        <span class="meta-label">PROCEDURE FEE</span>
                        <span class="meta-fee-value">
                            ₹@(selectedRequest.procedure_fee?.ToString("N2") ?? "0.00")
                        </span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Empty State Prompt when no case is selected -->
            <div class="empty-case-showcase">
                <div class="empty-case-icon-box">
                    <i class="bi bi-hospital"></i>
                </div>
                <h3 class="empty-case-title">Select a Surgery Case to Begin</h3>
                <p class="empty-case-subtitle">Type a patient name, surgery, or surgeon in the search bar above to view intraoperative notes and log medicines or tools.</p>
                
                @if (allRequests.Any())
                {
                    <div class="recent-cases-tray">
                        <span class="recent-tray-label">Quick Select Surgery Case:</span>
                        <div class="recent-chips-list">
                            @foreach (var r in allRequests.Take(6))
                            {
                                var pat = !string.IsNullOrWhiteSpace(r.patient_name) ? r.patient_name : $"Patient {FormatCustId(r.custid)}";
                                var doc = GetDoctorName(r.dcode);
                                <button type="button" class="recent-case-chip" @onmousedown="() => SelectCase(r)" @onmousedown:preventDefault @onclick="() => SelectCase(r)">
                                    <span class="recent-chip-patient font-bold">@pat</span>
                                    <span class="recent-chip-proc text-slate-600">• @r.procedure_name</span>
                                    <span class="recent-chip-doc text-slate-400">(Dr. @doc)</span>
                                    <span class="badge @GetStatusBadgeClass(r.status) ms-1">@r.status</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (selectedRequest != null)
        {
            <!-- ========================================================================= -->
            <!-- 3. KPI STATISTICS TILES                                                   -->
            <!-- ========================================================================= -->
            <div class="kpi-grid mb-3">
                <div class="kpi-card">
                    <div class="kpi-icon-box kpi-icon-indigo">
                        <i class="bi bi-list-check"></i>
                    </div>
                    <div class="kpi-details">
                        <span class="kpi-value">@staffNotesList.Count</span>
                        <span class="kpi-label">Total Items Logged</span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon-box kpi-icon-emerald">
                        <i class="bi bi-capsule"></i>
                    </div>
                    <div class="kpi-details">
                        <span class="kpi-value">@staffNotesList.Count(n => n.item_type == "MEDICINE")</span>
                        <span class="kpi-label">Medicines Administered</span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon-box kpi-icon-blue">
                        <i class="bi bi-tools"></i>
                    </div>
                    <div class="kpi-details">
                        <span class="kpi-value">@staffNotesList.Count(n => n.item_type == "TOOL")</span>
                        <span class="kpi-label">Tools &amp; Sets Logged</span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon-box kpi-icon-purple">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div class="kpi-details">
                        <span class="kpi-value font-mono text-emerald-700">₹@TotalNotesChargeableAmount.ToString("N2")</span>
                        <span class="kpi-label">Total Charges</span>
                    </div>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- 4. CONTENT TABLE CARD                                                     -->
            <!-- ========================================================================= -->
            <div class="content-table-card">
                <div class="table-top-bar">
                    <div class="table-title-wrap">
                        <h3 class="table-heading-text m-0">Medicines &amp; Tools Used in Surgery</h3>
                        <span class="badge-count">@FilteredNotes.Count() items</span>
                    </div>

                    <div class="table-actions-wrap">
                        <!-- Item Type Filter (Removed Reusable / Note-only) -->
                        <div class="filter-pill-group">
                            <button type="button" class="filter-pill-btn @(notesTypeFilter == "ALL" ? "active" : "")" @onclick='() => notesTypeFilter = "ALL"'>All</button>
                            <button type="button" class="filter-pill-btn @(notesTypeFilter == "MEDICINE" ? "active" : "")" @onclick='() => notesTypeFilter = "MEDICINE"'>Medicines</button>
                            <button type="button" class="filter-pill-btn @(notesTypeFilter == "TOOL" ? "active" : "")" @onclick='() => notesTypeFilter = "TOOL"'>Tools</button>
                            <button type="button" class="filter-pill-btn @(notesTypeFilter == "CHARGEABLE" ? "active" : "")" @onclick='() => notesTypeFilter = "CHARGEABLE"'>Chargeable</button>
                        </div>

                        <!-- Search Box -->
                        <div class="tbl-search-box">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" placeholder="Search item, staff, remarks..." class="form-control form-control-sm tbl-search-input" @bind="notesSearchQuery" @bind:event="oninput" />
                            @if (!string.IsNullOrWhiteSpace(notesSearchQuery))
                            {
                                <button type="button" class="btn-clear-search-sm" @onclick="() => notesSearchQuery = string.Empty"><i class="bi bi-x-lg"></i></button>
                            }
                        </div>
                    </div>
                </div>

                @if (isLoadingNotes)
                {
                    <div class="table-loading-box">
                        <span class="spinner-border text-indigo-600 spinner-border-sm me-2"></span>
                        <span class="text-slate-600 font-bold font-13">Loading staff notes...</span>
                    </div>
                }
                else if (!FilteredNotes.Any())
                {
                    <div class="table-empty-state-box">
                        <div class="empty-state-icon-circle">
                            <i class="bi bi-clipboard2-plus"></i>
                        </div>
                        <h4 class="empty-state-title">No medicines or tools logged for this surgery yet.</h4>
                        <p class="empty-state-subtitle">Start recording intraoperative consumables, medicines, or reusable tools used during surgery.</p>
                        <button type="button" class="btn-log-first-item" @onclick="OpenAddStaffNoteModal">
                            <i class="bi bi-plus-lg"></i>
                            <span>Log First Item</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="table-scroll-wrap">
                        <table class="table custom-medico-table align-middle m-0">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 70px;">S.No</th>
                                    <th style="width: 125px;">Item Type</th>
                                    <th style="min-width: 220px;">Item Name</th>
                                    <th class="text-center" style="width: 120px;">Qty &amp; Unit</th>
                                    <th class="text-end" style="width: 110px;">Rate</th>
                                    <th class="text-end" style="width: 135px;">Total Amount</th>
                                    <th style="width: 140px;">Logged By</th>
                                    <th class="text-center" style="width: 120px;">Billing Status</th>
                                    <th class="text-center" style="width: 70px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < FilteredNotes.Count; i++)
                                {
                                    var note = FilteredNotes[i];
                                    var isChargeable = (note.amount ?? 0) > 0;
                                    <tr>
                                        <td class="text-center text-slate-500 font-mono font-12 font-bold">@(i + 1)</td>
                                        <td>
                                            @if (note.item_type == "MEDICINE")
                                            {
                                                <span class="type-pill pill-medicine">Medicine</span>
                                            }
                                            else if (note.item_type == "TOOL")
                                            {
                                                <span class="type-pill pill-tool">Tool / Set</span>
                                            }
                                            else
                                            {
                                                <span class="type-pill pill-other">Consumable</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="item-name-text">@note.item_name</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="qty-badge font-mono">@note.quantity @(!string.IsNullOrWhiteSpace(note.unit) ? note.unit : "")</span>
                                        </td>
                                        <td class="text-end">
                                            @if (note.rate.HasValue && note.rate.Value > 0)
                                            {
                                                <span class="font-mono text-slate-700 font-semibold">₹@note.rate.Value.ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span class="text-slate-400 font-11">-</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (isChargeable)
                                            {
                                                <span class="font-mono font-bold text-emerald-700">₹@(note.amount?.ToString("N2") ?? "0.00")</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-slate-100 text-slate-600 font-normal font-11">No Charge (Reusable)</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="staff-tag">
                                                <i class="bi bi-person-fill me-1 text-slate-400"></i>
                                                @(!string.IsNullOrWhiteSpace(note.used_by) ? note.used_by : "OT Staff")
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (isChargeable)
                                            {
                                                @if (note.is_billed)
                                                {
                                                    <span class="status-pill-sub pill-billed">Billed</span>
                                                }
                                                else
                                                {
                                                    <span class="status-pill-sub pill-unbilled">Unbilled</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="status-pill-sub pill-note">Note-Only</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn-action-delete" @onclick="() => PromptDeleteStaffNote(note)" title="Delete Item">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }

    <!-- ========================================================================= -->
    <!-- 5. LOG STAFF ITEM MODAL POPUP                                             -->
    <!-- ========================================================================= -->
    @if (showAddStaffNoteModal && selectedRequest != null)
    {
        <div class="modal-overlay">
            <div class="modal-form-card" @onclick:stopPropagation>
                <div class="modal-header-bar">
                    <div class="modal-header-left">
                        <div class="modal-header-icon-box">
                            <i class="bi bi-capsule-pill"></i>
                        </div>
                        <div class="modal-header-text">
                            <h3 class="modal-title-text">Log Medicine / Tool Used</h3>
                            <span class="modal-subtitle-text">@selectedRequest.procedure_name - @selectedRequest.patient_name</span>
                        </div>
                    </div>
                    <button type="button" class="modal-close-btn" @onclick="() => showAddStaffNoteModal = false" title="Close">&times;</button>
                </div>

                <div class="modal-body-content">
                    <!-- Item Type Selector (Dropdown) -->
                    <div class="modal-form-group mb-3">
                        <label class="modal-field-label">Item Type <span class="text-danger">*</span></label>
                        <select class="form-select modal-select-control" value="@newNoteItemType" @onchange="OnItemTypeSelectChanged">
                            <option value="MEDICINE">Medicine</option>
                            <option value="TOOL">Tool / Set</option>
                            <option value="OTHER">Consumable / Other</option>
                        </select>
                    </div>

                    <!-- Item Name (Autocomplete for Medicine, Free text for others) -->
                    @if (newNoteItemType == "MEDICINE")
                    {
                        <div class="modal-form-group mb-3" style="position: relative !important;">
                            <label class="modal-field-label">ITEM NAME <span class="text-danger">*</span></label>
                            <input type="text" 
                                   class="form-control modal-input-control" 
                                   @bind="newNoteItemName" 
                                   @bind:event="oninput" 
                                   @onfocus="OnMedicineFocus" 
                                   @onblur="OnMedicineSearchBlur" 
                                   placeholder="Type to search item name..." 
                                   autocomplete="off" 
                                   required />
                            @if (isItemDropdownOpen)
                            {
                                var term = newNoteItemName?.Trim() ?? "";
                                var filteredItems = inventoryItems
                                    .Where(i => string.IsNullOrEmpty(term) 
                                        || (!string.IsNullOrEmpty(i.itemname) && i.itemname.Contains(term, StringComparison.OrdinalIgnoreCase))
                                        || (!string.IsNullOrEmpty(i.shortname) && i.shortname.Contains(term, StringComparison.OrdinalIgnoreCase))
                                        || (!string.IsNullOrEmpty(i.drugname) && i.drugname.Contains(term, StringComparison.OrdinalIgnoreCase))
                                        || i.itemcode.ToString().Contains(term))
                                    .Take(25)
                                    .ToList();

                                if (filteredItems.Any())
                                {
                                    <div class="ot-typeahead-dropdown">
                                        @foreach (var item in filteredItems)
                                        {
                                            var unitMrp = GetItemUnitMrp(item);
                                            var stockInfo = GetItemStockAndBatchInfo(item);
                                            var hasStock = stockInfo.AvailableQty > 0;

                                            <div class="ot-typeahead-item" @onmousedown="() => SelectMedicineItem(item)">
                                                <div class="ot-typeahead-item-title font-bold text-slate-900">
                                                    @item.itemname
                                                </div>
                                                <div class="ot-typeahead-item-sub">
                                                    <div class="ot-typeahead-price-col">
                                                        <span class="ot-typeahead-rate-val font-mono font-bold text-indigo-600">₹@(unitMrp.ToString("N2"))</span>
                                                    </div>
                                                    <div class="ot-typeahead-stock-col">
                                                        @if (stockInfo.BatchNo != "-")
                                                        {
                                                            <span class="ot-batch-badge font-mono" title="Batch No">
                                                                Batch: @stockInfo.BatchNo
                                                            </span>
                                                        }
                                                        <span class="ot-stock-pill @(hasStock ? "stk-available" : "stk-zero") font-mono" title="Available Stock in Tenant">
                                                            Stock: @stockInfo.AvailableQty.ToString("N0")
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(term))
                                {
                                    <div class="ot-typeahead-dropdown" style="padding: 10px; text-align: center; color: #64748b; font-size: 0.78rem;">
                                        No matching items found
                                    </div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="modal-form-group mb-3">
                            <label class="modal-field-label">@(newNoteItemType == "TOOL" ? "Tool / Set Name" : "Consumable Item Name") <span class="text-danger">*</span></label>
                            <input type="text" 
                                   class="form-control modal-input-control" 
                                   placeholder="@(newNoteItemType == "TOOL" ? "e.g. Laparoscope Set B / Harmonic Scalpel" : "e.g. Trocar 10mm / Vicryl 2-0 Suture / Surgical Gloves")" 
                                   @bind="newNoteItemName" 
                                   autocomplete="off" />
                        </div>
                    }

                    <!-- Quantity & Unit -->
                    <div class="modal-form-row mb-3">
                        <div class="modal-form-col">
                            <label class="modal-field-label">Quantity <span class="text-danger">*</span></label>
                            <input type="number" step="1" min="1" class="form-control modal-input-control" @bind="newNoteQuantity" @bind:after="RecalculateNoteAmount" />
                        </div>
                        <div class="modal-form-col">
                            <label class="modal-field-label">Unit</label>
                            <select class="form-select modal-select-control" @bind="newNoteUnit">
                                <option value="AMP">AMP (Ampoule)</option>
                                <option value="VIAL">VIAL</option>
                                <option value="PCS">PCS (Pieces)</option>
                                <option value="SET">SET</option>
                                <option value="PACK">PACK</option>
                                <option value="BOX">BOX</option>
                                <option value="BTL">BTL (Bottle)</option>
                                <option value="TUBE">TUBE</option>
                                <option value="STRIP">STRIP</option>
                                <option value="MG">MG</option>
                                <option value="ML">ML</option>
                            </select>
                        </div>
                    </div>

                    <!-- Rate & Total Amount -->
                    <div class="modal-form-row mb-3">
                        <div class="modal-form-col">
                            <label class="modal-field-label">Rate (₹) <span class="text-slate-400 font-normal">@(newNoteItemType == "MEDICINE" ? "(Auto Unit MRP)" : "(0 or blank if Reusable)")</span></label>
                            <input type="number" step="0.01" min="0" placeholder="0.00" class="form-control modal-input-control" @bind="newNoteRate" @bind:after="RecalculateNoteAmount" />
                        </div>
                        <div class="modal-form-col">
                            <label class="modal-field-label">Total Amount (₹)</label>
                            <input type="number" step="0.01" min="0" placeholder="0.00" class="form-control modal-input-control font-bold text-emerald-700 bg-slate-50" value="@newNoteAmount" readonly />
                        </div>
                    </div>

                    <!-- Used By (Staff Name) -->
                    <div class="modal-form-group mb-3">
                        <label class="modal-field-label">Staff Name / Used By</label>
                        <input type="text" class="form-control modal-input-control" placeholder="e.g. Nurse Priya / OT Tech Ravi" @bind="newNoteUsedBy" />
                    </div>

                    <!-- Remarks -->
                    <div class="modal-form-group mb-1">
                        <label class="modal-field-label">Remarks / Clinical Notes</label>
                        <textarea class="form-control modal-textarea-control" rows="2" placeholder="e.g. Used during induction / Sterilized set" @bind="newNoteRemarks"></textarea>
                    </div>
                </div>

                <div class="modal-footer-bar">
                    <button type="button" class="btn-modal-cancel" @onclick="() => showAddStaffNoteModal = false">Cancel</button>
                    <button type="button" class="btn-modal-save" @onclick="SaveStaffNoteAsync" disabled="@isSaving">
