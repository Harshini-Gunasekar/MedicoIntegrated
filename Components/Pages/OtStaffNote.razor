    private void SelectMedicineItem(item_master item)
    {
        if (item == null) return;
        newNoteItemName = item.itemname ?? "";

        // Rate
        newNoteRate = GetItemUnitMrp(item);

        // Unit
        var uom = uomList.FirstOrDefault(u => u.ucode == item.uomcode);
        string matchedUnit = uom?.shortname ?? uom?.name ?? item.packaging ?? "";
        newNoteUnit = MapToStandardUnit(matchedUnit);

        isItemDropdownOpen = false;
        RecalculateNoteAmount();
        StateHasChanged();
    }

    private decimal GetItemUnitMrp(item_master? item)
    {
        if (item == null) return 0;
        decimal packSize = item.packsize > 0 ? item.packsize : 1;
        if (item.mrp > 0)
        {
            return Math.Round(item.mrp / packSize, 2);
        }
        if (item.salesrate > 0)
        {
            return Math.Round(item.salesrate / packSize, 2);
        }
        return 0;
    }

    private string MapToStandardUnit(string? uomName)
    {
        if (string.IsNullOrWhiteSpace(uomName)) return "PCS";
        var u = uomName.Trim().ToUpperInvariant();
        if (u.Contains("AMP")) return "AMP";
        if (u.Contains("VIAL")) return "VIAL";
        if (u.Contains("BTL") || u.Contains("BOTTLE")) return "BTL";
        if (u.Contains("TAB") || u.Contains("CAP") || u.Contains("STRIP")) return "STRIP";
        if (u.Contains("TUBE")) return "TUBE";
        if (u.Contains("BOX")) return "BOX";
        if (u.Contains("SET")) return "SET";
        if (u.Contains("PACK")) return "PACK";
        if (u.Contains("ML")) return "ML";
        if (u.Contains("MG")) return "MG";
        return "PCS";
    }

    private void ClearMedicineSelection()
    {
        newNoteItemName = "";
        newNoteRate = null;
        newNoteAmount = null;
        isItemDropdownOpen = true;
    }

    private void RecalculateNoteAmount()
    {
        if (newNoteRate.HasValue && newNoteRate.Value > 0 && newNoteQuantity > 0)
        {
            newNoteAmount = newNoteQuantity * newNoteRate.Value;
        }
        else
        {
            newNoteAmount = null;
        }
    }

    private async Task SaveStaffNoteAsync()
    {
        if (selectedRequest == null) return;
        if (string.IsNullOrWhiteSpace(newNoteItemName))
        {
            ToastService.ShowWarning("Please enter an item name or description.");
            return;
        }

        isSaving = true;
        StateHasChanged();
        try
        {
            var req = new AddOtStaffNoteRequest
            {
                request_id = selectedRequest.request_id,
                item_type = newNoteItemType,
                item_name = newNoteItemName.Trim(),
                quantity = newNoteQuantity,
                unit = newNoteUnit,
                rate = newNoteRate,
                amount = newNoteAmount,
                used_by = newNoteUsedBy?.Trim(),
                remarks = newNoteRemarks?.Trim()
            };

            var res = await OtService.AddStaffNoteAsync(req);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess("Staff note logged successfully!");
                showAddStaffNoteModal = false;
                await LoadStaffNotesAsync();
            }
            else
            {
                ToastService.ShowError(res.message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving note: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task PromptDeleteStaffNote(OtStaffNoteModel note)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{note.item_name}'?");
        if (!confirmed) return;

        try
        {
            var res = await OtService.DeleteStaffNoteAsync(note.note_id);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess("Staff note item removed.");
                await LoadStaffNotesAsync();
            }
            else
            {
                ToastService.ShowError(res.message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting item: {ex.Message}");
        }
    }

