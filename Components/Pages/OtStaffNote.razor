        selectedRequest = null;
        staffNotesList.Clear();
        isCaseDropdownOpen = true;
        highlightedCaseIndex = 0;
    }

    private List<OtSurgeryRequestListModel> FilteredSurgeryCases
    {
        get
        {
            var list = allRequests.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(caseSearchQuery))
            {
                var activeDisplay = selectedRequest != null ? GetCaseDisplayName(selectedRequest) : "";
                // If the search input text matches current active case, show all available surgery cases in dropdown
                if (!string.IsNullOrWhiteSpace(activeDisplay) && string.Equals(caseSearchQuery.Trim(), activeDisplay.Trim(), StringComparison.OrdinalIgnoreCase))
                {
                    return list.ToList();
                }

                var q = caseSearchQuery.Trim().ToLowerInvariant();
                list = list.Where(r => 
                    (r.patient_name?.ToLowerInvariant().Contains(q) ?? false) ||
                    FormatCustId(r.custid).Contains(q) ||
                    r.custid.ToString().Contains(q) ||
                    (r.procedure_name?.ToLowerInvariant().Contains(q) ?? false) ||
                    (r.diagnosis?.ToLowerInvariant().Contains(q) ?? false) ||
                    (GetDoctorName(r.dcode).ToLowerInvariant().Contains(q)) ||
                    (r.status?.ToLowerInvariant().Contains(q) ?? false));
            }
            return list.ToList();
        }
    }

    private async Task LoadStaffNotesAsync()
