    private void OnCaseSearchInput(ChangeEventArgs e)
    {
        caseSearchQuery = e.Value?.ToString() ?? "";
        isCaseDropdownOpen = true;
        highlightedCaseIndex = 0;
    }

    private void OpenCaseDropdown()
    {
        isCaseDropdownOpen = true;
        highlightedCaseIndex = 0;
    }

    private void ToggleCaseDropdown()
    {
        isCaseDropdownOpen = !isCaseDropdownOpen;
        highlightedCaseIndex = 0;
    }

    private async Task HandleCaseSearchKeyDown(KeyboardEventArgs e)
    {
        if (!isCaseDropdownOpen)
        {
            if (e.Key == "ArrowDown" || e.Key == "Enter")
            {
                isCaseDropdownOpen = true;
                highlightedCaseIndex = 0;
            }
            return;
        }

        var cases = FilteredSurgeryCases;
        if (e.Key == "ArrowDown")
        {
            if (cases.Count > 0)
            {
                highlightedCaseIndex = (highlightedCaseIndex + 1) % cases.Count;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            if (cases.Count > 0)
            {
                highlightedCaseIndex = (highlightedCaseIndex - 1 + cases.Count) % cases.Count;
            }
        }
        else if (e.Key == "Enter")
        {
            if (cases.Count > 0)
            {
                var targetIdx = (highlightedCaseIndex >= 0 && highlightedCaseIndex < cases.Count) ? highlightedCaseIndex : 0;
                await SelectCase(cases[targetIdx]);
            }
        }
        else if (e.Key == "Escape")
        {
            isCaseDropdownOpen = false;
        }
    }

    private string GetCaseDisplayName(OtSurgeryRequestListModel req)
    {
        if (req == null) return "";
        var pat = !string.IsNullOrWhiteSpace(req.patient_name) ? req.patient_name : $"Patient {FormatCustId(req.custid)}";
        var cust = FormatCustId(req.custid);
        return !string.IsNullOrWhiteSpace(cust) 
            ? $"{pat} ({cust}) - {req.procedure_name}" 
            : $"{pat} - {req.procedure_name}";
    }

    private async Task SelectCase(OtSurgeryRequestListModel req)
    {
        if (req == null) return;
        selectedRequest = req;
        caseSearchQuery = GetCaseDisplayName(req);
        isCaseDropdownOpen = false;
        highlightedCaseIndex = 0;
        await LoadStaffNotesAsync();
        StateHasChanged();
    }

    private void ClearCaseSearch()
    {
