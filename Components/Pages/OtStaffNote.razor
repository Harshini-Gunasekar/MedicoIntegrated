    private string GetDoctorName(int dcode)
    {
        if (dcode <= 0) return "Clinician";
        var doc = doctorsList.FirstOrDefault(d => d.dcode == dcode);
        return doc != null ? (string.IsNullOrWhiteSpace(doc.name) ? (doc.doctorfullname ?? "Clinician") : doc.name) : "Clinician";
    }

    private string GetStatusBadgeClass(string? status)
    {
        return (status?.ToUpperInvariant()) switch
        {
            "IN_PROGRESS" or "IN_OP" or "SURGERY" => "bg-purple-100 text-purple-800 border border-purple-200",
            "COMPLETED" => "bg-emerald-100 text-emerald-800 border border-emerald-200",
            "IN_RECOVERY" or "RECOVERY" or "RECOVERED" => "bg-sky-100 text-sky-800 border border-sky-200",
            "TRANSFERRED" or "DISCHARGED" => "bg-teal-100 text-teal-800 border border-teal-200",
            "CANCELLED" => "bg-rose-100 text-rose-800 border border-rose-200",
            "REQUESTED" => "bg-amber-100 text-amber-800 border border-amber-200",
            _ => "bg-indigo-100 text-indigo-800 border border-indigo-200"
        };
    }

