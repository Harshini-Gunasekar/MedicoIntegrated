    private decimal TotalNotesChargeableAmount => staffNotesList.Where(n => (n.amount ?? 0) > 0).Sum(n => n.amount ?? 0);

    private List<OtStaffNoteModel> FilteredNotes
    {
        get
        {
            var list = staffNotesList.AsEnumerable();
            if (notesTypeFilter == "MEDICINE") list = list.Where(n => n.item_type == "MEDICINE");
            else if (notesTypeFilter == "TOOL") list = list.Where(n => n.item_type == "TOOL");
            else if (notesTypeFilter == "CHARGEABLE") list = list.Where(n => (n.amount ?? 0) > 0);
            else if (notesTypeFilter == "REUSABLE") list = list.Where(n => (n.amount ?? 0) == 0);

            if (!string.IsNullOrWhiteSpace(notesSearchQuery))
            {
                var q = notesSearchQuery.Trim().ToLowerInvariant();
                list = list.Where(n => (n.item_name?.ToLowerInvariant().Contains(q) ?? false) ||
                                       (n.used_by?.ToLowerInvariant().Contains(q) ?? false) ||
                                       (n.remarks?.ToLowerInvariant().Contains(q) ?? false));
            }
            return list.OrderByDescending(n => n.created_at).ToList();
        }
    }

