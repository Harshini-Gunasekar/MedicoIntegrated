    private (string BatchNo, decimal AvailableQty) GetItemStockAndBatchInfo(item_master item)
    {
        if (item == null) return ("-", 0);

        var matching = allStocks.Where(s => s.itemcode == item.itemcode && !s.deleted).ToList();
        if (matching.Any())
        {
            // Pick the primary active batch with positive stock (prioritize nearest valid expiry date)
            var positiveStock = matching
                .Where(s => s.closingstock > 0 && !string.IsNullOrWhiteSpace(s.batchno))
                .OrderBy(s => s.expirydate.HasValue ? s.expirydate.Value : DateTime.MaxValue)
                .ThenByDescending(s => s.closingstock)
                .FirstOrDefault();

            if (positiveStock != null)
            {
                return (positiveStock.batchno!.Trim(), positiveStock.closingstock);
            }

            // If no stock with batch name, check any positive stock entry
            var anyPositive = matching.FirstOrDefault(s => s.closingstock > 0);
            if (anyPositive != null)
            {
                var bName = !string.IsNullOrWhiteSpace(anyPositive.batchno) ? anyPositive.batchno.Trim() : "-";
                return (bName, anyPositive.closingstock);
            }

            // Fallback to latest batch entry
            var lastEntry = matching.LastOrDefault(s => !string.IsNullOrWhiteSpace(s.batchno));
            if (lastEntry != null)
            {
                return (lastEntry.batchno!.Trim(), lastEntry.closingstock);
            }
        }

        return ("-", item.currentstock);
    }

