@page "/counter-master"
@rendermode InteractiveServer
@using Medico_Backend.Model
@using Booking.Services
@inject CounterMasterService CounterService
@inject ToastService ToastService

<div class="cm-page">
    <!-- Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <h1 class="cm-title">Counter Master</h1>
            <span class="cm-subtitle">POS Configuration</span>
        </div>
        <div class="cm-header-right">
            <div class="cm-search-box">
                <i class="bi bi-search cm-search-icon"></i>
                <input type="text" class="cm-search-input" placeholder="Quick find..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            <button class="cm-btn-new" @onclick="OpenNewCounterModal">
                + New Counter Entry
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="cm-table-card">
        <table class="cm-table">
            <thead>
                <tr>
                    <th>ORDER NO</th>
                    <th>SHORT NAME</th>
                    <th>COUNTER NAME</th>
                    <th>BRANCH NAME</th>
                    <th>NARRATION</th>
                    <th>ENTERED DATE</th>
                    <th>MODIFIED DATE</th>
                    <th>ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredCounters.Any())
                {
                    @foreach (var item in FilteredCounters)
                    {
                        <tr>
                            <td class="col-orderno">@item.orderno</td>
                            <td class="col-shortname">@item.shortname</td>
                            <td class="col-name">
                                <div class="col-name-container">
                                    <span class="status-dot" style="background-color: @GetCounterColor(item.description);"></span>
                                    <span class="counter-name-text">@item.name</span>
                                </div>
                            </td>
                            <td class="col-branch">@item.bhcode</td>
                            <td class="col-narration">@GetPureDescription(item.description)</td>
                            <td class="col-date-entered">
                                <span class="date-line">@item.entereddate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.entereddate.ToString("tt") == "AM" ? "am" : "pm")">@item.entereddate.ToString("tt")</span>
                            </td>
                            <td class="col-date-modified">
                                <span class="date-line">@item.ibsdate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.ibsdate.ToString("tt") == "AM" ? "am" : "pm")">@item.ibsdate.ToString("tt")</span>
                            </td>
                            <td class="col-action">
                                <button class="cm-action-btn edit" title="Edit" @onclick="() => EditCounter(item)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="cm-action-btn delete" title="Delete" @onclick="() => DeleteCounter(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="cm-empty-row">
                            <i class="bi bi-display"></i>
                            <div>No counters found</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showModal)
{
    <div class="cm-backdrop">
        <div class="cm-modal">
            <div class="cm-modal-header">
                <h2 class="cm-modal-title">@(isEditMode ? "Edit Counter Entry" : "New Counter Entry")</h2>
                <button class="cm-close-btn" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body">
                <!-- Counter Name - full width -->
                <div class="cm-field-group">
                    <label class="cm-label">Counter Name</label>
                    <input type="text" class="cm-input" placeholder="Ex: Reception A" @bind="currentCounter.name" />
                </div>

                <!-- Row: Display Order, Short Name, Associated Branch -->
                <div class="cm-form-row three-cols">
                    <div class="cm-field-group">
                        <label class="cm-label">Display Order</label>
                        <input type="text" class="cm-input" placeholder="20" @bind="displayOrderString" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Short Name</label>
                        <input type="text" class="cm-input" placeholder="Ex: PH-01" @bind="currentCounter.shortname" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Associated Branch</label>
                        <select class="cm-input cm-select" @bind="currentCounter.bhcode">
                            <option value="">Select Branch</option>
                            <option value="1">Branch 1</option>
                            <option value="55">Branch 55</option>
                            <option value="56">Branch 56</option>
                            <option value="57">Branch 57</option>
                        </select>
                    </div>
                </div>

                <!-- Row: Expense Code, Cash Ledger, Bill Ledger -->
                <div class="cm-form-row three-cols">
                    <div class="cm-field-group">
                        <label class="cm-label">Expense Code</label>
                        <input type="text" class="cm-input" placeholder="EXP-001" @bind="currentCounter.expenselcode" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Cash Ledger</label>
                        <input type="text" class="cm-input" placeholder="CASH-01" @bind="currentCounter.cashlcode" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Bill Ledger</label>
                        <input type="number" class="cm-input" placeholder="101" @bind="currentCounter.patientbilllcode" />
                    </div>
                </div>

                <!-- Row: Counter Description + Counter Color -->
                <div class="cm-form-row desc-color-row">
                    <div class="cm-field-group desc-field">
                        <label class="cm-label">Counter Description</label>
                        <input type="text" class="cm-input" placeholder="Specify any specific instructions..." @bind="currentCounter.description" />
                    </div>
                    <div class="cm-field-group color-field">
                        <label class="cm-label">Counter Color</label>
                        <div class="color-preview-row">
                            <div class="color-swatch-wrapper" style="position: relative; width: 44px; height: 36px; cursor: pointer;">
                                <input type="color" @bind="fakeColor" style="position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; border: none; padding: 0;" />
                                <div class="color-swatch" style="background-color: @fakeColor; width: 100%; height: 100%; border-radius: 6px; border: 1.5px solid #e5e7eb; margin: 0;"></div>
                            </div>
                            <span class="color-hex">@fakeColor</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cm-modal-footer">
                @if (isEditMode)
                {
                    <button class="cm-btn-delete" @onclick="() => DeleteCounter(currentCounter)">Delete</button>
                }
                else
                {
                    <span></span>
                }
                <div class="cm-footer-right-buttons" style="display: flex; gap: 0.75rem; align-items: center;">
                    <button class="cm-btn-cancel" @onclick="CloseModal">Cancel</button>
                    <button class="cm-btn-save" @onclick="SaveCounter">
                        <i class="bi bi-check2"></i> Save Counter
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CounterMasterModel> counters = new();
    private string searchQuery = "";
    private bool showModal = false;
    private bool isEditMode = false;
    private CounterMasterModel currentCounter = new();
    // Fake fields for UI matching
    private string fakeColor = "#4169E1";

    private string displayOrderString
    {
        get => currentCounter.orderno == 0 ? "" : currentCounter.orderno.ToString();
        set => currentCounter.orderno = int.TryParse(value, out var v) ? v : 0;
    }

    private IEnumerable<CounterMasterModel> FilteredCounters =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? counters
            : counters.Where(c => 
                (c.name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.shortname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadCounters();
    }

    private async Task LoadCounters()
    {
        try
        {
            var res = await CounterService.GetCountersAsync();
            if (res != null)
            {
                counters = res.OrderBy(c => c.orderno).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load counters: {ex.Message}");
        }
    }

    private void OpenNewCounterModal()
    {
        currentCounter = new CounterMasterModel { orderno = 0, bhcode = 55 };
        isEditMode = false;
        showModal = true;
    }

    private void EditCounter(CounterMasterModel counter)
    {
        currentCounter = new CounterMasterModel
        {
            cntcode = counter.cntcode,
            name = counter.name,
            shortname = counter.shortname,
            orderno = counter.orderno,
            bhcode = counter.bhcode,
            description = GetPureDescription(counter.description),
            expenselcode = counter.expenselcode,
            cashlcode = counter.cashlcode,
            patientbilllcode = counter.patientbilllcode
        };
        fakeColor = GetCounterColor(counter.description);
        isEditMode = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveCounter()
    {
        try
        {
            bool success;
            currentCounter.description = $"{GetPureDescription(currentCounter.description)}|{fakeColor}";
            if (isEditMode)
            {
                success = await CounterService.UpdateCounterAsync(currentCounter);
            }
            else
            {
                currentCounter.entereddate = DateTime.Now;
                currentCounter.ibsdate = DateTime.Now;
                success = await CounterService.InsertCounterAsync(currentCounter);
            }

            if (success)
            {
                ToastService.ShowSuccess("Counter saved successfully.");
                showModal = false;
                await LoadCounters();
            }
            else
            {
                ToastService.ShowError("Failed to save counter.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task DeleteCounter(CounterMasterModel counter)
    {
        try
        {
            bool success = await CounterService.DeleteCounterAsync(counter.cntcode);
            if (success)
            {
                ToastService.ShowSuccess("Counter deleted successfully.");
                if (showModal) showModal = false;
                await LoadCounters();
            }
            else
            {
                ToastService.ShowError("Failed to delete counter.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private string GetPureDescription(string? rawDesc)
    {
        if (string.IsNullOrEmpty(rawDesc)) return "";
        int idx = rawDesc.LastIndexOf("|#");
        if (idx >= 0)
        {
            return rawDesc.Substring(0, idx);
        }
        return rawDesc;
    }

    private string GetCounterColor(string? rawDesc)
    {
        if (string.IsNullOrEmpty(rawDesc)) return "#4169E1"; // Default blue
        int idx = rawDesc.LastIndexOf("|#");
        if (idx >= 0 && idx + 2 < rawDesc.Length)
        {
            return rawDesc.Substring(idx + 1);
        }
        return "#4169E1";
    }
}
