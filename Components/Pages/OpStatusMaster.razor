











@page "/op-status-master"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using medico_backend.Model
@using Booking.Services
@using Booking.Helpers
@using Booking.Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject OpStatusMasterService StatusService
@inject ToastService ToastService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Booking.Services.RoleMasterService RoleService
@inject ProtectedLocalStorage _sessionStorage
@implements IDisposable

<PageTitle>OP Status Master - Medico Portal</PageTitle>

<div class="cm-page">
@if (!hasViewRight)
{
    <!-- Access Denied Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <div class="cm-header-brand" style="display: flex; align-items: center; gap: 0.75rem;">
                <div class="cm-header-icon-box" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                    <i class="bi bi-shield-x"></i>
                </div>
                <div class="cm-header-text">
                    <h1 class="cm-title">OP Status Master</h1>
                    <span class="cm-subtitle" style="color: #ef4444; font-weight: 600;"><span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #ef4444; margin-right: 4px;"></span> ACCESS RESTRICTED</span>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-danger d-flex align-items-center mt-3 p-4 shadow-sm" style="border-radius: 8px; background: #fef2f2; border: 1px solid #fecaca; color: #991b1b;">
        <i class="bi bi-shield-lock-fill me-3 fs-1 text-danger" style="font-size: 2rem; margin-right: 1rem;"></i>
        <div>
            <h5 class="alert-heading mb-1 font-bold" style="font-weight: 700; margin-bottom: 0.25rem;">Permission Denied</h5>
            <p class="mb-0 text-muted" style="color: #64748b; margin: 0;">You do not have permission to view OP Status Master. Please contact your system administrator to assign Role 950 (OP Portal &gt; OP Status Master &gt; View).</p>
        </div>
    </div>
}
else
{
    <!-- Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <h1 class="cm-title">
                <i class="bi bi-check2-circle text-primary"></i>
                OP Status Master
            </h1>
            <span class="cm-subtitle">Manage outpatient queue statuses and visit flow stages</span>
        </div>
        <div class="cm-header-right">
            <div class="cm-search-box">
                <i class="bi bi-search cm-search-icon"></i>
                <input type="text" class="cm-search-input" placeholder="Search status name..." @bind="searchQuery" @bind:event="oninput" />
            </div>

            <button type="button" class="cm-filter-toggle @(activeOnly ? "active" : "")" @onclick="ToggleActiveFilter">
                <i class="bi @(activeOnly ? "bi-check-circle-fill text-success" : "bi-circle")"></i>
                <span>Active Only</span>
            </button>

            @if (hasCreateRight)
            {
                <button type="button" class="cm-btn-new" @onclick="OpenNewModal">
                    <i class="bi bi-plus-lg"></i>
                    <span>+ New OP Status</span>
                </button>
            }
        </div>
    </div>

    <!-- Table Card -->
    <div class="cm-table-card">
        <div class="table-responsive-container">
            <table class="cm-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">S.NO</th>
                        <th>STATUS NAME</th>
                        <th style="width: 140px; text-align: center;">STATUS</th>
                        <th style="width: 120px;">USER CODE</th>
                        <th style="width: 180px;">CREATED AT</th>
                        <th style="width: 180px;">UPDATED AT</th>
                        <th style="width: 110px; text-align: center;">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="7" class="cm-empty-row">
                                <div class="spinner-border text-primary mb-2" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <div>Loading OP statuses...</div>
                            </td>
                        </tr>
                    }
                    else if (FilteredStatuses.Any())
                    {
                        @foreach (var (item, index) in PaginatedStatuses.Select((s, i) => (s, i)))
                        {
                            <tr>
                                <td class="col-orderno">@(((currentPage - 1) * pageSize) + index + 1)</td>
                                <td class="col-name">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-tag-fill text-primary opacity-75"></i>
                                        <span class="status-name-text">@item.status_name</span>
                                    </div>
                                </td>
                                <td style="text-align: center;">
                                    <button type="button" class="status-badge-btn @(item.is_active ? "badge-active" : "badge-inactive")"
                                            title="Click to toggle Active/Inactive"
                                            @onclick="() => ToggleItemStatus(item)">
                                        <i class="bi @(item.is_active ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>
                                        @(item.is_active ? "Active" : "Inactive")
                                    </button>
                                </td>
                                <td class="col-usercode">
                                    <span class="usercode-badge">@(item.usercode?.ToString() ?? "—")</span>
                                </td>
                                <td class="col-date">
                                    @(item.created_at == default ? "—" : FormatToIst(item.created_at))
                                </td>
                                <td class="col-date">
                                    @(item.updated_at == default ? "—" : FormatToIst(item.updated_at))
                                </td>
                                <td class="col-action" style="text-align: center;">
                                    @if (hasEditRight)
                                    {
                                        <button type="button" class="cm-action-btn edit" title="Edit Status" @onclick="() => OpenEditModal(item)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    }
                                    @if (hasDeleteRight)
                                    {
                                        <button type="button" class="cm-action-btn delete" title="Delete Status" @onclick="() => ConfirmDelete(item)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="cm-empty-row">
                                <i class="bi bi-folder-x"></i>
                                <div>No OP statuses found</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!isLoading && FilteredStatuses.Any())
        {
            <div class="cm-table-footer">
                <div class="cm-pagination-info">
                    Showing <strong>@(((currentPage - 1) * pageSize) + 1)</strong> to <strong>@(Math.Min(currentPage * pageSize, FilteredStatuses.Count()))</strong> of <strong>@FilteredStatuses.Count()</strong> entries
                </div>
                @if (TotalPages > 1)
                {
                    <div class="cm-pagination-controls">
                        <button type="button" class="cm-pg-btn" disabled="@(currentPage <= 1)" @onclick="() => ChangePage(currentPage - 1)">
                            &lsaquo; Previous
                        </button>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNum = i;
                            <button type="button" class="cm-pg-btn @(currentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                @pageNum
                            </button>
                        }
                        <button type="button" class="cm-pg-btn" disabled="@(currentPage >= TotalPages)" @onclick="() => ChangePage(currentPage + 1)">
                            Next &rsaquo;
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}
</div>

<!-- Modal Dialog (Create / Edit) -->
@if (showModal)
{
    <div class="cm-backdrop">
        <div class="cm-modal" style="max-width: 500px;">
            <div class="cm-modal-header">
                <h2 class="cm-modal-title">
                    <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle-fill") me-1 text-primary"></i>
                    @(isEditMode ? "Edit OP Status" : "New OP Status")
                </h2>
                <button type="button" class="cm-close-btn" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body">
                <!-- Status Name -->
                <div class="cm-field-group">
                    <label class="cm-label">Status Name <span style="color: #ef4444;">*</span></label>
                    <input type="text" 
                           class="cm-input" 
                           placeholder="e.g. Waiting, In Consultation, Completed, Cancelled" 
                           @bind="currentStatus.status_name" />
                    @if (showValidation && string.IsNullOrWhiteSpace(currentStatus.status_name))
                    {
                        <span class="text-danger" style="font-size: 0.75rem;">Status Name is required.</span>
                    }
                </div>

                <!-- Active Toggle -->
                <div class="cm-field-group">
                    <label class="cm-label">Active State</label>
                    <div class="form-check form-switch mt-1">
                        <input class="form-check-input" type="checkbox" id="statusActiveSwitch" @bind="currentStatus.is_active" />
                        <label class="form-check-label ms-2" for="statusActiveSwitch" style="font-size: 0.85rem; font-weight: 500; color: #374151;">
                            @(currentStatus.is_active ? "Active in queue dropdowns" : "Inactive (hidden from queue dropdowns)")
                        </label>
                    </div>
                </div>
            </div>

            <div class="cm-modal-footer">
                <button type="button" class="cm-btn-cancel" @onclick="CloseModal" disabled="@isSaving">Cancel</button>
                @if ((isEditMode && hasEditRight) || (!isEditMode && hasCreateRight))
                {
                    <button type="button" class="cm-btn-save" @onclick="SaveStatusAsync" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg"></i>
                            <span>@(isEditMode ? "Update Status" : "Save Status")</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteConfirm && itemToDelete != null)
{
    <div class="cm-backdrop">
        <div class="cm-modal" style="max-width: 440px;">
            <div class="cm-modal-header" style="background: #fef2f2; border-bottom-color: #fee2e2;">
                <h2 class="cm-modal-title" style="color: #991b1b;">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>
                    Confirm Delete
                </h2>
                <button type="button" class="cm-close-btn" @onclick="CloseDeleteConfirm">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body text-center py-4">
                <p class="mb-2" style="font-size: 0.95rem; color: #334155;">
                    Are you sure you want to delete OP status <strong>@itemToDelete.status_name</strong>?
                </p>
                <p class="text-muted mb-0" style="font-size: 0.8rem;">
                    This will remove the status from active outpatient queue options.
                </p>
            </div>

            <div class="cm-modal-footer">
                <button type="button" class="cm-btn-cancel" @onclick="CloseDeleteConfirm" disabled="@isSaving">Cancel</button>
                @if (hasDeleteRight)
                {
                    <button type="button" class="cm-btn-save cm-btn-danger" @onclick="DeleteStatusConfirmedAsync" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <i class="bi bi-trash"></i>
                            <span>Delete</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<OpStatusMasterModel> statusList = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool activeOnly = false;
    private string searchQuery = "";
    private int currentPage = 1;
    private int pageSize = 10;

    private bool showModal = false;
    private bool isEditMode = false;
    private bool showValidation = false;
    private OpStatusMasterModel currentStatus = new();

    private bool showDeleteConfirm = false;
    private OpStatusMasterModel? itemToDelete;

    private bool hasViewRight = true;
    private bool hasCreateRight = false;
    private bool hasEditRight = false;
    private bool hasDeleteRight = false;

    private string FormatToIst(DateTime dt)
    {
        if (dt == default || dt == DateTime.MinValue) return "—";
        return dt.ToIndianTime().ToString("dd-MM-yyyy hh:mm tt");
    }

    private int GetEffectiveUserCode()
    {
        if (TenantState?.UserCode > 0) return TenantState.UserCode;
        if (TenantState?.UserData?.UserCode.HasValue == true && TenantState.UserData.UserCode.Value > 0)
            return TenantState.UserData.UserCode.Value;
        return 5;
    }

    private IEnumerable<OpStatusMasterModel> FilteredStatuses =>
        statusList
            .Where(s => !activeOnly || s.is_active)
            .Where(s => string.IsNullOrWhiteSpace(searchQuery) || 
                        (s.status_name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredStatuses.Count() / pageSize));

    private IEnumerable<OpStatusMasterModel> PaginatedStatuses =>
        FilteredStatuses.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void ToggleActiveFilter()
    {
        activeOnly = !activeOnly;
        currentPage = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        TenantState.OnSessionChanged += HandleSessionChanged;
        RoleService.OnPermissionsChanged += HandlePermissionsChanged;
        EvaluateRights();
        if (hasViewRight)
        {
            await LoadStatusesAsync();
        }
        else
        {
            isLoading = false;
        }
    }

    private void EvaluateRights()
    {
        bool isAdmin = Booking.Helpers.UserPermissionHelper.IsAdmin(null, TenantState);
        if (isAdmin)
        {
            hasViewRight = true;
            hasCreateRight = true;
            hasEditRight = true;
            hasDeleteRight = true;
            return;
        }

        hasViewRight = RoleService.HasPermission(950) ||
                       RoleService.HasRight("OP Portal", "OP Status Master") ||
                       TenantState.HasActionRight("OP Portal", "OP Status Master", "View") ||
                       TenantState.HasActionRight("OP", "OP Status Master", "View");

        hasCreateRight = RoleService.HasPermission(951) ||
                         RoleService.HasAction("OP Portal", "OP Status Master", "Create") ||
                         TenantState.HasActionRight("OP Portal", "OP Status Master", "Create") ||
                         TenantState.HasActionRight("OP", "OP Status Master", "Create");

        hasEditRight = RoleService.HasPermission(952) ||
                       RoleService.HasAction("OP Portal", "OP Status Master", "Edit") ||
                       TenantState.HasActionRight("OP Portal", "OP Status Master", "Edit") ||
                       TenantState.HasActionRight("OP", "OP Status Master", "Edit");

        hasDeleteRight = RoleService.HasPermission(953) ||
                         RoleService.HasAction("OP Portal", "OP Status Master", "Delete") ||
                         TenantState.HasActionRight("OP Portal", "OP Status Master", "Delete") ||
                         TenantState.HasActionRight("OP", "OP Status Master", "Delete");
    }

    private async Task LoadStatusesAsync()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            statusList = await StatusService.GetAllStatusesAsync(activeOnly: false);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading OP statuses: {ex.Message}");
            statusList = new();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenNewModal()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("Permission Denied: Role 951 (Create OP Status) required.");
            return;
        }

        currentStatus = new OpStatusMasterModel
        {
            is_active = true,
            usercode = GetEffectiveUserCode()
        };
        isEditMode = false;
        showValidation = false;
        showModal = true;
    }

    private void OpenEditModal(OpStatusMasterModel item)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("Permission Denied: Role 952 (Edit OP Status) required.");
            return;
        }

        currentStatus = new OpStatusMasterModel
        {
            op_status_id = item.op_status_id,
            status_name = item.status_name,
            is_active = item.is_active,
            tenant_code = item.tenant_code,
            usercode = item.usercode ?? GetEffectiveUserCode(),
            created_at = item.created_at,
            updated_at = item.updated_at
        };
        isEditMode = true;
        showValidation = false;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        showValidation = false;
    }

    private async Task SaveStatusAsync()
    {
        if (string.IsNullOrWhiteSpace(currentStatus.status_name))
        {
            showValidation = true;
            ToastService.ShowWarning("Please enter a valid Status Name.");
            return;
        }

        isSaving = true;
        try
        {
            bool ok;
            if (isEditMode)
            {
                ok = await StatusService.UpdateStatusAsync(currentStatus.op_status_id, currentStatus.status_name.Trim(), currentStatus.is_active, GetEffectiveUserCode());
            }
            else
            {
                ok = await StatusService.CreateStatusAsync(currentStatus.status_name.Trim(), currentStatus.is_active, GetEffectiveUserCode());
            }

            if (ok)
            {
                ToastService.ShowSuccess(isEditMode ? "OP status updated successfully." : "OP status created successfully.");
                showModal = false;
                await LoadStatusesAsync();
            }
            else
            {
                ToastService.ShowError("Failed to save OP status.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleItemStatus(OpStatusMasterModel item)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("Permission Denied: Role 952 (Edit OP Status) required.");
            return;
        }

        bool newStatus = !item.is_active;
        bool ok = await StatusService.UpdateStatusAsync(item.op_status_id, item.status_name, newStatus, GetEffectiveUserCode());
        if (ok)
        {
            item.is_active = newStatus;
            item.updated_at = DateTime.UtcNow;
            ToastService.ShowSuccess($"Status '{item.status_name}' marked as {(newStatus ? "Active" : "Inactive")}.");
            StateHasChanged();
        }
        else
        {
            ToastService.ShowError("Failed to update status state.");
        }
    }

    private void ConfirmDelete(OpStatusMasterModel item)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("Permission Denied: Role 953 (Delete OP Status) required.");
            return;
        }

        itemToDelete = item;
        showDeleteConfirm = true;
    }

    private void CloseDeleteConfirm()
    {
        showDeleteConfirm = false;
        itemToDelete = null;
    }

    private async Task DeleteStatusConfirmedAsync()
    {
        if (itemToDelete == null) return;
        if (!hasDeleteRight)
        {
            ToastService.ShowError("Permission Denied: Role 953 (Delete OP Status) required.");
            return;
        }

        isSaving = true;
        try
        {
            bool ok = await StatusService.DeleteStatusAsync(itemToDelete.op_status_id);
            if (ok)
            {
                ToastService.ShowSuccess("OP status deleted successfully.");
                CloseDeleteConfirm();
                await LoadStatusesAsync();
            }
            else
            {
                ToastService.ShowError("Failed to delete OP status.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void HandleSessionChanged()
    {
        InvokeAsync(async () =>
        {
            EvaluateRights();
            if (hasViewRight)
            {
                await LoadStatusesAsync();
            }
            StateHasChanged();
        });
    }

    private void HandlePermissionsChanged()
    {
        InvokeAsync(async () =>
        {
            bool prevCanView = hasViewRight;
            EvaluateRights();
            if (prevCanView != hasViewRight && hasViewRight)
            {
                await LoadStatusesAsync();
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TenantState.OnSessionChanged -= HandleSessionChanged;
        RoleService.OnPermissionsChanged -= HandlePermissionsChanged;
    }
}
