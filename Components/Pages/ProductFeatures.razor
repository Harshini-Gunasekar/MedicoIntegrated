@page "/ProductFeatures"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject Booking.Services.RoleMasterService RoleService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage _sessionStorage
@inject Booking.Services.ToastService ToastService
@inject NavigationManager NavigationManager

<PageTitle>Product & Feature Registry - Medico</PageTitle>

@if (hasViewRight)
{
    <div class="product-features-page-wrapper">
        <div class="animated-background">
            <div class="floating-blob blob-1"></div>
            <div class="floating-blob blob-2"></div>
        </div>

        <SharedComponents.Rcl.Components.Pages.ProductFeatureManagement />
    </div>
}

@code {
    private bool hasViewRight = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (await Booking.Helpers.UserPermissionHelper.IsAdminAsync(null, TenantState, _sessionStorage))
            {
                hasViewRight = true;
                StateHasChanged();
                return;
            }

            hasViewRight = RoleService.HasRoleId(715) ||
                           RoleService.HasAction("Admin Portal", "Product & Feature Registry", "View") ||
                           RoleService.HasRight("Admin Portal", "Product & Feature Registry") ||
                           TenantState.HasActionRight("Admin Portal", "Product & Feature Registry", "View");

            if (!hasViewRight && !(await Booking.Helpers.UserPermissionHelper.IsAdminAsync(null, TenantState, _sessionStorage)))
            {
                ToastService.ShowError("You do not have permission to view Product & Feature Registry.");
                NavigationManager.NavigateTo("/home");
                return;
            }
            StateHasChanged();
        }
    }
}
