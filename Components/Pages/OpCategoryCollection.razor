@page "/op-category-collection"
@page "/billing/op-category-collection"
@page "/billing/categorization"
@rendermode InteractiveServer

@using System.Text.Json
@using Booking.Models
@using Booking.Services
@using SharedComponents.Rcl.Services
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components

@inject HmsBillingService BillingService
@inject DoctorService DoctorService
@inject CounterMasterService CounterMasterService
@inject Booking.Services.AppointmentBookingService AppointmentBookingService
@inject Booking.Services.IpRegistrationService IpService
@inject IHttpClientFactory ClientFactory
@inject TenantSessionState TenantState
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage SessionStorage
@inject ToastService ToastService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject Booking.Services.RoleMasterService RoleService
@inject Booking.Services.PatientUhidService UhidService
@inject Booking.Services.LabResultService LabResultService
@implements IDisposable

<PageTitle>Billing Categorization Report | Medico</PageTitle>

<div class="cash-counter-wrapper">
    @if (!hasViewRight)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="card p-5 text-center shadow-sm" style="max-width: 520px; border-radius: 16px; border: 1px solid #fee2e2; background: #fff5f5;">
                <i class="bi bi-shield-lock-fill text-danger mb-3" style="font-size: 3rem;"></i>
                <h3 class="fw-bold text-danger">Access Denied</h3>
                <p class="text-muted mt-2">You do not have permission to view the Billing Categorization module. Please contact your system administrator to assign the required user rights.</p>
                <div class="mt-3">
                    <a href="/" class="btn btn-primary px-4" style="border-radius: 8px;">Back to Home</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ======================================================== -->
        <!-- 1. PAGE HEADER (Title on Left, Summary Cards on Right)   -->
        <!-- ======================================================== -->
    <div class="page-header">
        <div class="header-left-group">
            <div class="header-title-container">
                <div class="header-title-icon">
                    <i class="bi bi-pie-chart-fill"></i>
                </div>
                <div>
                    <h1 class="header-title">Billing Categorization</h1>
                    <div class="header-subtitle">Departmental Category Breakdown &amp; Financial Ledger</div>
                </div>
            </div>
        </div>

        <!-- Header Summary Cards (Right Aligned, Generous Space) -->
        <div class="header-summary-cards">
            <div class="summary-card bill-card" title="Total OP Visits for Selected Period">
                <div class="summary-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="summary-content">
                    <div class="summary-label">TOTAL OP VISITS</div>
                    <div class="summary-value">@(reportData?.total_visits ?? 0)</div>
                </div>
            </div>

            <div class="summary-card net-card" title="Total Net Billed Amount (Gross minus Discounts)">
                <div class="summary-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <div class="summary-content">
                    <div class="summary-label">TOTAL NET BILLED</div>
                    <div class="summary-value">&#8377;@((reportData?.total_net ?? 0).ToString("N2"))</div>
                </div>
            </div>

            <div class="summary-card paid-card" title="Total Amount Collected (@EfficiencyPercent.ToString("0.0")% Collection Efficiency)">
                <div class="summary-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="summary-content">
                    <div class="summary-label">TOTAL COLLECTED</div>
                    <div class="summary-value">&#8377;@((reportData?.total_collected ?? 0).ToString("N2"))</div>
                </div>
            </div>

            <div class="summary-card due-card" title="Total Outstanding Due Amount">
                <div class="summary-icon">
                    <i class="bi bi-exclamation-circle"></i>
                </div>
                <div class="summary-content">
                    <div class="summary-label">OUTSTANDING DUE</div>
                    <div class="summary-value">&#8377;@((reportData?.total_due ?? 0).ToString("N2"))</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- 2. FILTER SECTION (Matched to Cash Counter Design)       -->
    <!-- ======================================================== -->
    <div class="filter-card">
        <div class="filter-top-bar">
            <div class="filter-bar-title">
                <i class="bi bi-funnel-fill text-primary"></i>
                <span>FILTERS &amp; PARAMETERS</span>
            </div>
            <!-- Quick Date Chips -->
            <div class="quick-date-chips">
                <button type="button" class="date-chip @(IsActivePreset("today") ? "active" : "")" @onclick='() => SetDatePreset("today")'>Today</button>
                <button type="button" class="date-chip @(IsActivePreset("yesterday") ? "active" : "")" @onclick='() => SetDatePreset("yesterday")'>Yesterday</button>
                <button type="button" class="date-chip @(IsActivePreset("this_week") ? "active" : "")" @onclick='() => SetDatePreset("this_week")'>This Week</button>
                <button type="button" class="date-chip @(IsActivePreset("this_month") ? "active" : "")" @onclick='() => SetDatePreset("this_month")'>This Month</button>
                <button type="button" class="date-chip @(IsActivePreset("last_30_days") ? "active" : "")" @onclick='() => SetDatePreset("last_30_days")'>Last 30 Days</button>
            </div>
        </div>

        <div class="filter-grid">
            <div class="filter-item">
                <label>BRANCH</label>
                <select class="form-select" @bind="selectedBhCode">
                    <option value="0">All Branches</option>
                    @foreach (var b in branches)
                    {
                        <option value="@b.bh_code">@b.name</option>
                    }
                </select>
            </div>

            <div class="filter-item">
                <label>CASH COUNTER</label>
                <select class="form-select" @bind="selectedCntCode">
                    <option value="0">All Counters</option>
                    @foreach (var c in FilteredCounters)
                    {
                        <option value="@((int)c.cntcode)">@(string.IsNullOrWhiteSpace(c.name) ? $"Counter {c.cntcode}" : c.name)</option>
                    }
                </select>
            </div>

            <div class="filter-item">
                <label>DOCTOR / CONSULTANT</label>
                <select class="form-select" @bind="selectedDCode">
                    <option value="0">All Doctors</option>
                    @foreach (var d in doctors)
                    {
                        <option value="@d.dcode">@d.name</option>
                    }
                </select>
            </div>

            <div class="filter-item">
                <label>FROM DATE</label>
                <input type="date" class="form-control" @bind="fromDate" />
            </div>

            <div class="filter-item">
                <label>TO DATE</label>
                <input type="date" class="form-control" @bind="toDate" />
            </div>

            <div class="filter-item search-item">
                <label>SEARCH IN TABLE</label>
                <div class="search-input-wrapper">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" class="form-control"
                           @bind="searchQuery"
                           @bind:event="oninput"
                           placeholder="Search category, service, OP, patient, tokens..." />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <i class="bi bi-x-circle search-clear-icon" @onclick='() => searchQuery = ""'></i>
                    }
                </div>
            </div>

            <div class="filter-item action-item">
                <div class="filter-actions-inline">
                    <button class="btn-primary" @onclick="ApplyFiltersAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Searching...</span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                            <span>Search</span>
                        }
                    </button>
                    <button class="btn-secondary" @onclick="ResetFiltersAsync" disabled="@isLoading" title="Reset Filters">
                        <i class="bi bi-arrow-clockwise"></i>
                        <span>Reset</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- 3. TABLE CARD (Toggle beside Table Header, No CSV/Print) -->
    <!-- ======================================================== -->
    <div class="table-card">
        <div class="table-header">
            <div class="table-header-left">
                <h2 class="table-title">
                    @if (activeTab == "categories")
                    {
                        <span>OP Billing Breakdown</span>
                    }
                    else if (activeTab == "services")
                    {
                        <span>Service &amp; Procedure Billing Details</span>
                    }
                    else
                    {
                        <span>Patient OP Visits Ledger</span>
                    }
                </h2>

                <!-- Mode Toggle Pills moved right near table header title -->
                <div class="counter-mode-pills table-mode-pills">
                    <button type="button" class="mode-pill @(activeTab == "categories" ? "active" : "")" @onclick='() => activeTab = "categories"' title="Category Breakdown">
                        <i class="bi bi-grid-fill"></i>
                        <span>Category Breakdown</span>
                        <span class="badge-count">@(reportData?.categories?.Count ?? 0)</span>
                    </button>
                    <button type="button" class="mode-pill @(activeTab == "services" ? "active" : "")" @onclick='() => activeTab = "services"' title="Service Items">
                        <i class="bi bi-list-check"></i>
                        <span>Service Items</span>
                        <span class="badge-count">@(reportData?.services?.Count ?? 0)</span>
                    </button>
                    <button type="button" class="mode-pill @(activeTab == "visits" ? "active" : "")" @onclick='() => activeTab = "visits"' title="OP Patient Visits">
                        <i class="bi bi-person-lines-fill"></i>
                        <span>OP Patient Visits</span>
                        <span class="badge-count">@(reportData?.visits?.Count ?? 0)</span>
                    </button>
                </div>
            </div>

            <!-- Table Actions: Refresh, CSV Export, Print / Report Generation, and Record count badge -->
            <div class="table-actions">
                <button class="table-btn-action" @onclick="RefreshReportAsync" disabled="@isLoading" title="Refresh all data">
                    <i class="bi bi-arrow-clockwise @(isLoading ? "spin-icon" : "")"></i>
                    <span>Refresh</span>
                </button>

                <button class="table-btn-action btn-export-csv" @onclick="ExportCsvAsync" disabled="@(isLoading || isGeneratingReport || reportData == null)" title="Export data to CSV spreadsheet">
                    <i class="bi bi-file-earmark-excel"></i>
                    <span>Export CSV</span>
                </button>

                <div class="report-btn-group">
                    <button class="table-btn-action btn-print-report" @onclick='() => GenerateReportAsync("summary")' disabled="@(isLoading || isGeneratingReport || reportData == null)" title="Generate & preview summary PDF report">
                        @if (isGeneratingReport && reportGeneratingMode == "summary")
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Generating...</span>
                        }
                        else
                        {
                            <i class="bi bi-printer-fill"></i>
                            <span>Print Report</span>
                        }
                    </button>

                    <button class="table-btn-action btn-full-report" @onclick='() => GenerateReportAsync("full")' disabled="@(isLoading || isGeneratingReport || reportData == null)" title="Generate complete comprehensive PDF ledger report">
                        @if (isGeneratingReport && reportGeneratingMode == "full")
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Full...</span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-pdf-fill"></i>
                            <span>Full Ledger</span>
                        }
                    </button>
                </div>

                <span class="record-count">Total: @CurrentActiveCount records</span>
            </div>
        </div>

        <div class="table-responsive">
            @if (isLoading)
            {
                <div class="table-loading-container">
                    <div class="spinner-border text-primary" role="status"></div>
                    <span class="loading-text">Loading Billing Categorization data...</span>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="table-empty-container text-danger">
                    <i class="bi bi-exclamation-triangle-fill fs-3 mb-2"></i>
                    <span class="fw-bold">@errorMessage</span>
                    <button class="btn btn-outline-primary btn-sm mt-3 px-3" @onclick="RefreshReportAsync">Try Again</button>
                </div>
            }
            else if (reportData == null || (reportData.categories.Count == 0 && reportData.services.Count == 0 && reportData.visits.Count == 0))
            {
                <div class="table-empty-container">
                    <i class="bi bi-inbox fs-3 text-muted mb-2"></i>
                    <span class="fw-bold text-dark">No Records Found</span>
                    <span class="text-muted small">No outpatient billing transactions found for the selected date range and criteria.</span>
                    <button class="btn btn-secondary btn-sm mt-3" @onclick="ResetFiltersAsync">Clear Filters</button>
                </div>
            }
            else
            {
                @if (activeTab == "categories")
                {
                    <!-- CATEGORIES TABLE -->
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;" class="text-center">S.NO</th>
                                <th>CATEGORY</th>
                                <th class="text-center">VISITS</th>
                                <th class="text-center">BILLS</th>
                                <th class="text-center">ITEMS / QTY</th>
                                <th class="text-end">GROSS</th>
                                <th class="text-end">DISCOUNT</th>
                                <th class="text-end">NET AMOUNT</th>
                                <th class="text-end">COLLECTED</th>
                                <th class="text-end">CASH</th>
                                <th class="text-end">UPI</th>
                                <th class="text-end">DUE AMOUNT</th>
                                <th class="text-center" style="width: 100px;">STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int catIdx = 1; }
                            @foreach (var c in FilteredCategories)
                            {
                                <tr class="category-interactive-row"
                                    @ondblclick="async () => await OpenCategoryPatientsModal(c.category)"
                                    title="Double-click to view @c.category patient details">
                                    <td class="text-center text-muted font-numeric">@(catIdx++)</td>
                                    <td>
                                        <div class="category-name-cell">
                                            <span class="cat-badge-dot @GetCategoryColorClass(c.category)"></span>
                                            <span class="category-name-text">@c.category</span>
                                            <span class="view-hint-badge" title="Double click to view patients"><i class="bi bi-box-arrow-up-right"></i></span>
                                        </div>
                                    </td>
                                    <td class="text-center font-numeric">
                                        <span class="badge-count-pill">@c.visit_count</span>
                                    </td>
                                    <td class="text-center font-numeric">@c.bill_count</td>
                                    <td class="text-center font-numeric">@c.item_count</td>
                                    <td class="text-end font-numeric text-muted">&#8377;@c.gross_amount.ToString("N2")</td>
                                    <td class="text-end font-numeric @(Math.Abs(c.discount_amount) > 0 ? "text-danger" : "text-muted")">
                                        &#8377;@Math.Abs(c.discount_amount).ToString("N2")
                                    </td>
                                    <td class="text-end font-numeric font-bold">&#8377;@c.net_amount.ToString("N2")</td>
                                    <td class="text-end font-numeric text-success font-bold">&#8377;@c.collected_amount.ToString("N2")</td>
                                    <td class="text-end font-numeric @(c.CashAmount > 0 ? "text-success font-bold" : "text-muted")">&#8377;@c.CashAmount.ToString("N2")</td>
                                    <td class="text-end font-numeric @(c.UpiAmount > 0 ? "text-primary font-bold" : "text-muted")">&#8377;@c.UpiAmount.ToString("N2")</td>
                                    <td class="text-end font-numeric @(c.due_amount > 0 ? "text-danger font-bold" : "text-muted")">
                                        &#8377;@c.due_amount.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        @if (c.due_amount <= 0 && c.net_amount > 0)
                                        {
                                            <span class="status-badge settled">Settled</span>
                                        }
                                        else if (c.collected_amount > 0 && c.due_amount > 0)
                                        {
                                            <span class="status-badge pending">Partial</span>
                                        }
                                        else if (c.due_amount > 0)
                                        {
                                            <span class="status-badge due">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge neutral">Zero Net</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-total-row">
                                <td colspan="2" class="font-bold">TOTAL SUMMARY (@FilteredCategories.Count Categories)</td>
                                <td class="text-center font-bold">@FilteredCategories.Sum(x => x.visit_count)</td>
                                <td class="text-center font-bold">@FilteredCategories.Sum(x => x.bill_count)</td>
                                <td class="text-center font-bold">@FilteredCategories.Sum(x => x.item_count)</td>
                                <td class="text-end font-numeric font-bold">&#8377;@FilteredCategories.Sum(x => x.gross_amount).ToString("N2")</td>
                                <td class="text-end font-numeric font-bold">&#8377;@FilteredCategories.Sum(x => Math.Abs(x.discount_amount)).ToString("N2")</td>
                                <td class="text-end font-numeric font-bold text-primary">&#8377;@FilteredCategories.Sum(x => x.net_amount).ToString("N2")</td>
                                <td class="text-end font-numeric font-bold text-success">&#8377;@FilteredCategories.Sum(x => x.collected_amount).ToString("N2")</td>
                                <td class="text-end font-numeric font-bold text-success">&#8377;@FilteredCategories.Sum(x => x.CashAmount).ToString("N2")</td>
                                <td class="text-end font-numeric font-bold text-primary">&#8377;@FilteredCategories.Sum(x => x.UpiAmount).ToString("N2")</td>
                                <td class="text-end font-numeric font-bold text-danger">&#8377;@FilteredCategories.Sum(x => x.due_amount).ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                }
                else if (activeTab == "services")
                {
                    <!-- SERVICES TABLE -->
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;" class="text-center">S.NO</th>
                                <th style="width: 100px;">SERVICE ID</th>
                                <th>SERVICE NAME</th>
                                <th class="text-center">VISITS</th>
                                <th class="text-center">ITEMS / QTY</th>
                                <th>TOKENS</th>
                                <th class="text-end">NET AMOUNT</th>
                                <th class="text-end">COLLECTED</th>
                                <th class="text-end">DUE AMOUNT</th>
                                <th class="text-center">RECOVERY</th>
                                <th class="text-center" style="width: 100px;">STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int sIdx = 1; }
                            @foreach (var s in FilteredServices)
                            {
                                var eff = s.net_amount > 0 ? (s.collected_amount / s.net_amount) * 100 : 0;
                                <tr>
                                    <td class="text-center text-muted font-numeric">@(sIdx++)</td>
                                    <td>
                                        <span class="service-id-badge">#@(s.service_id?.ToString() ?? "-")</span>
                                    </td>
                                    <td>
                                        <span class="service-name-text">@s.service_name</span>
                                    </td>
                                    <td class="text-center font-numeric">
                                        <span class="badge-count-pill">@s.visit_count</span>
                                    </td>
                                    <td class="text-center font-numeric">@s.item_count</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(s.tokens))
                                        {
                                            <div class="tokens-list">
                                                @foreach (var tok in s.tokens.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(5))
                                                {
                                                    <span class="token-pill">#@tok</span>
                                                }
                                                @if (s.tokens.Split(',').Length > 5)
                                                {
                                                    <span class="token-pill more">+@(s.tokens.Split(',').Length - 5)</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-end font-numeric font-bold">&#8377;@s.net_amount.ToString("N2")</td>
                                    <td class="text-end font-numeric text-success font-bold">&#8377;@s.collected_amount.ToString("N2")</td>
                                    <td class="text-end font-numeric @(s.due_amount > 0 ? "text-danger font-bold" : "text-muted")">
                                        &#8377;@s.due_amount.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        <span class="efficiency-badge @(eff >= 100 ? "eff-complete" : eff > 0 ? "eff-partial" : "eff-zero")">
                                            @eff.ToString("0.0")%
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (s.due_amount <= 0 && s.net_amount > 0)
                                        {
                                            <span class="status-badge settled">Settled</span>
                                        }
                                        else if (s.collected_amount > 0 && s.due_amount > 0)
                                        {
                                            <span class="status-badge pending">Partial</span>
                                        }
                                        else if (s.due_amount > 0)
                                        {
                                            <span class="status-badge due">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge neutral">Zero Net</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-total-row">
                                <td colspan="3" class="font-bold">TOTAL SUMMARY (@FilteredServices.Count Services)</td>
                                <td class="text-center font-bold">@FilteredServices.Sum(x => x.visit_count)</td>
                                <td class="text-center font-bold">@FilteredServices.Sum(x => x.item_count)</td>
                                <td></td>
                                <td class="text-end font-numeric font-bold text-primary">&#8377;@FilteredServices.Sum(x => x.net_amount).ToString("N2")</td>
                                <td class="text-end font-numeric font-bold text-success">&#8377;@FilteredServices.Sum(x => x.collected_amount).ToString("N2")</td>
                                <td class="text-end font-numeric font-bold text-danger">&#8377;@FilteredServices.Sum(x => x.due_amount).ToString("N2")</td>
                                <td class="text-center font-bold">
                                    @{
                                        var tNetS = FilteredServices.Sum(x => x.net_amount);
                                        var tColS = FilteredServices.Sum(x => x.collected_amount);
                                        var tEffS = tNetS > 0 ? (tColS / tNetS) * 100 : 0;
                                    }
                                    <span class="efficiency-badge eff-complete">@tEffS.ToString("0.0")%</span>
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                }
                else if (activeTab == "visits")
                {
                    <!-- VISITS TABLE (Action Column Removed, Clean Non-Zero Category Badges) -->
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;" class="text-center">S.NO</th>
                                <th style="width: 130px;">OP NUMBER</th>
                                <th style="width: 75px;" class="text-center">TOKEN</th>
                                <th style="width: 140px;">DATE &amp; TIME</th>
                                <th>PATIENT NAME</th>
                                <th style="width: 85px;" class="text-center">UHID</th>
                                <th>BILL NUMBERS</th>
                                <th>CATEGORY BREAKDOWN</th>
                                <th class="text-end">NET AMOUNT</th>
                                <th class="text-end">COLLECTED</th>
                                <th class="text-end">DUE AMOUNT</th>
                                <th class="text-center" style="width: 100px;">STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int vIdx = 1; }
                            @foreach (var v in FilteredVisits)
                            {
                                var nonZeroCategories = v.net_by_category?
                                    .Where(kvp => kvp.Value > 0)
                                    .ToList() ?? new List<KeyValuePair<string, double>>();

                                <tr>
                                    <td class="text-center text-muted font-numeric">@(vIdx++)</td>
                                    <td>
                                        <span class="bill-no">@(string.IsNullOrWhiteSpace(v.op_no) ? "OP Visit" : v.op_no)</span>
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrWhiteSpace(v.token_no))
                                        {
                                            <span class="token-pill">#@v.token_no</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="font-numeric text-muted">
                                        @(ResolveRealVisitDateTime(v)?.ToString("dd-MM-yyyy hh:mm tt") ?? v.visit_date?.ToString("dd-MM-yyyy hh:mm tt") ?? "-")
                                    </td>
                                    <td>
                                        <span class="patient-name">@(string.IsNullOrWhiteSpace(v.patient_name) ? "Walk-in Patient" : v.patient_name)</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="custid-pill">@GetDisplayUhid(v.custid, v.op_no, v.custcode)</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(v.bill_nos))
                                        {
                                            <div class="bills-list">
                                                @foreach (var bNo in v.bill_nos.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                                {
                                                    <span class="bill-badge">@bNo</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Not generated</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="category-chips-list">
                                            @if (nonZeroCategories.Any())
                                            {
                                                @foreach (var kvp in nonZeroCategories)
                                                {
                                                    <span class="category-chip @GetCategoryColorClass(kvp.Key)">
                                                        @kvp.Key: &#8377;@kvp.Value.ToString("0.##")
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end font-numeric font-bold">&#8377;@v.net_amount.ToString("N2")</td>
                                    <td class="text-end font-numeric text-success font-bold">&#8377;@v.collected_amount.ToString("N2")</td>
                                    <td class="text-end font-numeric @(v.due_amount > 0 ? "text-danger font-bold" : "text-muted")">
                                        &#8377;@v.due_amount.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        @if (v.due_amount <= 0 && v.net_amount > 0)
                                        {
                                            <span class="status-badge settled">Settled</span>
                                        }
                                        else if (v.collected_amount > 0 && v.due_amount > 0)
                                        {
                                            <span class="status-badge pending">Partial</span>
                                        }
                                        else if (v.due_amount > 0)
                                        {
                                            <span class="status-badge due">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge neutral">Zero Net</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-total-row">
                                <td colspan="8" class="font-bold">TOTAL SUMMARY (@FilteredVisits.Count Visits)</td>
                                <td class="text-end font-numeric font-bold text-primary">&#8377;@FilteredVisits.Sum(x => x.net_amount).ToString("N2")</td>
                                <td class="text-end font-numeric font-bold text-success">&#8377;@FilteredVisits.Sum(x => x.collected_amount).ToString("N2")</td>
                                <td class="text-end font-numeric font-bold text-danger">&#8377;@FilteredVisits.Sum(x => x.due_amount).ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                }
            }
        </div>
    </div>
    }

    <!-- ======================================================== -->
    <!-- 4. CATEGORY PATIENT DETAILS MODAL (Double Click)         -->
    <!-- ======================================================== -->
    @if (showCategoryPatientsModal)
    {
        var catPatients = GetFilteredCategoryPatients();
        var catTotalNet = catPatients.Sum(x => x.CategoryNet);
        var catTotalCol = catPatients.Sum(x => x.CategoryCollected);
        var catTotalDue = catPatients.Sum(x => x.CategoryDue);

        <div class="modal-backdrop-custom" @onclick="CloseCategoryPatientsModal">
            <div class="category-modal-card" @onclick:stopPropagation="true">
                <!-- Modal Header -->
                <div class="modal-header-custom">
                    <div style="display: flex; align-items: center; gap: 0.85rem;">
                        <div class="modal-icon-badge">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <h3 class="modal-header-title">
                                <span>@selectedCategoryForPatients</span>
                                <span class="badge rounded-pill bg-primary fs-6 px-3 py-1">@catPatients.Count Patients / Visits</span>
                            </h3>
                            <div class="modal-header-sub">
                                Outpatient visits &amp; transactions billed under <strong>@selectedCategoryForPatients</strong> from @fromDate.ToString("dd-MMM-yyyy") to @toDate.ToString("dd-MMM-yyyy")
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close-modal" @onclick="CloseCategoryPatientsModal" title="Close Modal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body-custom">
                    <!-- KPI Summary Strip & Filter -->
                    <div class="modal-stats-strip">
                        <div class="modal-stat-pill pill-blue">
                            <span class="stat-label">Category Billed</span>
                            <span class="stat-value">&#8377;@catTotalNet.ToString("N2")</span>
                        </div>
                        <div class="modal-stat-pill pill-green">
                            <span class="stat-label">Category Collected</span>
                            <span class="stat-value">&#8377;@catTotalCol.ToString("N2")</span>
                        </div>
                        <div class="modal-stat-pill pill-red">
                            <span class="stat-label">Category Due</span>
                            <span class="stat-value">&#8377;@catTotalDue.ToString("N2")</span>
                        </div>
                        <div class="modal-stat-pill" style="flex: 1; min-width: 220px; justify-content: center;">
                            <div class="modal-search-bar">
                                <i class="bi bi-search text-muted"></i>
                                <input type="text"
                                       @bind="categoryPatientsSearch"
                                       @bind:event="oninput"
                                       placeholder="Filter patient name, OP No, bill no, cust id..." />
                                @if (!string.IsNullOrWhiteSpace(categoryPatientsSearch))
                                {
                                    <i class="bi bi-x-circle text-muted" style="cursor: pointer;" @onclick='() => categoryPatientsSearch = ""'></i>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Patients Table -->
                    <div class="table-responsive" style="max-height: 52vh; border: 1px solid #e2e8f0; border-radius: 8px;">
                        @if (isLoadingCategoryPatients)
                        {
                            <div class="table-empty-container py-5">
                                <div class="spinner-border text-primary mb-3" role="status"></div>
                                <span class="fw-bold text-dark">Loading Patient Records...</span>
                                <span class="text-muted small">Fetching transaction and patient details for @selectedCategoryForPatients...</span>
                            </div>
                        }
                        else if (catPatients.Count == 0)
                        {
                            <div class="table-empty-container py-4">
                                <i class="bi bi-inbox fs-2 text-muted mb-2"></i>
                                <span class="fw-bold text-dark">No Patients Found</span>
                                <span class="text-muted small">No patient transactions found for category '@selectedCategoryForPatients' in this date range.</span>
                            </div>
                        }
                        else
                        {
                            <table class="custom-table mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 45px;" class="text-center">S.NO</th>
                                        <th style="width: 130px;">@(selectedCategoryForPatients == "IP" ? "IP NUMBER" : (selectedCategoryForPatients.Contains("PHARM") ? "TYPE / SOURCE" : "OP NUMBER"))</th>
                                        <th style="width: 70px;" class="text-center">TOKEN</th>
                                        <th style="width: 145px;">DATE &amp; TIME</th>
                                        <th>PATIENT NAME</th>
                                        <th style="width: 80px;" class="text-center">UHID</th>
                                        <th>BILL NUMBERS</th>
                                        <th class="text-end" style="color: #2563eb;">@selectedCategoryForPatients NET</th>
                                        <th class="text-end" style="color: #16a34a;">COLLECTED</th>
                                        <th class="text-end" style="color: #dc2626;">DUE</th>
                                        <th>PAY MODE</th>
                                        <th class="text-center" style="width: 90px;">STATUS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int pIdx = 1; }
                                    @foreach (var p in catPatients)
                                    {
                                        <tr>
                                            <td class="text-center text-muted font-numeric">@(pIdx++)</td>
                                            <td>
                                                @if (FormatOpNo(p.OpNo) == "-")
                                                {
                                                    <span class="text-muted fw-bold">-</span>
                                                }
                                                else
                                                {
                                                    <span class="bill-no">@p.OpNo</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (!string.IsNullOrWhiteSpace(p.TokenNo))
                                                {
                                                    <span class="token-pill">#@p.TokenNo</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="font-numeric text-muted">
                                                @(p.VisitDate?.ToString("dd-MM-yyyy hh:mm tt") ?? "-")
                                            </td>
                                            <td>
                                                @if (string.Equals(selectedCategoryForPatients, "LAB", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <button type="button" class="btn btn-link p-0 text-decoration-none patient-lab-btn"
                                                            @onclick="async () => await OpenLabDetailsModal(p)"
                                                            title="Click to view lab test details and amounts">
                                                        <span class="patient-name clickable-lab-patient">@(string.IsNullOrWhiteSpace(p.PatientName) ? "Walk-in Patient" : p.PatientName)</span>
                                                        <i class="bi bi-box-arrow-up-right ms-1 text-primary" style="font-size: 0.72rem;"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="patient-name">@(string.IsNullOrWhiteSpace(p.PatientName) ? "Walk-in Patient" : p.PatientName)</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <span class="custid-pill">@GetDisplayUhid(p.CustId, p.OpNo, p.CustCode)</span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(p.BillNos))
                                                {
                                                    <div class="bills-list">
                                                        @foreach (var bNo in p.BillNos.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                                        {
                                                            <span class="bill-badge">@bNo</span>
                                                        }
                                                    </div>
                                                    @if (p.TotalNet > p.CategoryNet)
                                                    {
                                                        <div class="mt-1" title="Full bill total is ₹@p.TotalNet.ToString("N2") across all categories (This category: ₹@p.CategoryNet.ToString("N2"))">
                                                            <span class="badge bg-light text-muted border font-numeric" style="font-size: 0.68rem; font-weight: normal;">
                                                                Bill Total: &#8377;@p.TotalNet.ToString("N2")
                                                            </span>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">-</span>
                                                }
                                            </td>
                                            <td class="text-end font-numeric font-bold text-primary">&#8377;@p.CategoryNet.ToString("N2")</td>
                                            <td class="text-end font-numeric font-bold text-success">&#8377;@p.CategoryCollected.ToString("N2")</td>
                                            <td class="text-end font-numeric @(p.CategoryDue > 0 ? "text-danger font-bold" : "text-muted")">&#8377;@p.CategoryDue.ToString("N2")</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(p.PaymodeBreakdown))
                                                {
                                                    <span class="badge bg-light text-dark border">@p.PaymodeBreakdown</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (p.CategoryDue <= 0 && p.CategoryNet > 0)
                                                {
                                                    <span class="status-badge settled">Settled</span>
                                                }
                                                else if (p.CategoryCollected > 0 && p.CategoryDue > 0)
                                                {
                                                    <span class="status-badge pending">Partial</span>
                                                }
                                                else if (p.CategoryDue > 0)
                                                {
                                                    <span class="status-badge due">Pending</span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge neutral">Zero Net</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-total-row">
                                        <td colspan="7" class="font-bold">TOTAL (@catPatients.Count Patients)</td>
                                        <td class="text-end font-numeric font-bold text-primary">&#8377;@catTotalNet.ToString("N2")</td>
                                        <td class="text-end font-numeric font-bold text-success">&#8377;@catTotalCol.ToString("N2")</td>
                                        <td class="text-end font-numeric font-bold text-danger">&#8377;@catTotalDue.ToString("N2")</td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        }
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer-custom">
                    <span class="text-muted small">Showing @catPatients.Count patient record(s)</span>
                </div>
            </div>
        </div>
    }

    <!-- ======================================================== -->
    <!-- 5. LAB TEST DETAILS & RESULTS MODAL                     -->
    <!-- ======================================================== -->
    <!-- 5. LAB TEST DETAILS & RESULTS MODAL                     -->
    <!-- ======================================================== -->
    @if (showLabDetailsModal)
    {
        <div class="modal-backdrop-custom lab-details-backdrop" style="z-index: 20000;" @onclick="CloseLabDetailsModal">
            <div class="category-modal-card lab-details-card" style="max-width: 920px; z-index: 20001; border-radius: 14px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.45); border: 1px solid #bae6fd;" @onclick:stopPropagation="true">
                <!-- Modal Header -->
                <div class="modal-header-custom" style="background: linear-gradient(135deg, #f0fdf4 0%, #e0f2fe 100%); border-bottom: 1px solid #bae6fd; padding: 1.15rem 1.5rem;">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <div class="modal-icon-badge" style="background: #0284c7; color: white; width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);">
                            <i class="bi bi-flask-fill"></i>
                        </div>
                        <div>
                            <h3 class="modal-header-title d-flex align-items-center flex-wrap gap-2 mb-1" style="font-size: 1.2rem; font-weight: 700; color: #0f172a;">
                                <span>Lab Test Details &amp; Charges</span>
                                @{
                                    var displayPatName = !string.IsNullOrWhiteSpace(selectedLabBill?.patient_name)
                                        ? selectedLabBill.patient_name
                                        : (!string.IsNullOrWhiteSpace(selectedLabPatient?.PatientName) ? selectedLabPatient.PatientName : "PATIENT");
                                }
                                <span class="badge rounded-pill bg-primary fs-6 px-3 py-1 font-uppercase" style="letter-spacing: 0.3px; box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);">
                                    Patient Name : @displayPatName
                                </span>
                                @if (selectedLabPatient?.CustId.HasValue == true && selectedLabPatient.CustId.Value > 0)
                                {
                                    <span class="badge rounded-pill bg-light text-dark border fs-6 px-3 py-1 ms-2 font-mono" style="box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);">
                                        UHID: @GetDisplayUhid(selectedLabPatient.CustId, selectedLabPatient.OpNo, selectedLabPatient.CustCode)
                                    </span>
                                }
                            </h3>
                            <div class="modal-header-sub text-muted small">
                                @(selectedLabPatient != null ? $"UHID: {GetDisplayUhid(selectedLabPatient.CustId, selectedLabPatient.OpNo, selectedLabPatient.CustCode)}" : "")
                                @(!string.IsNullOrWhiteSpace(selectedLabPatient?.BillNos) ? $" | Bill No: {selectedLabPatient.BillNos}" : "")
                                @(selectedLabPatient?.VisitDate.HasValue == true ? $" | Date: {selectedLabPatient.VisitDate.Value:dd-MMM-yyyy hh:mm tt}" : "")
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close-modal" @onclick="CloseLabDetailsModal" title="Close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body-custom" style="padding: 1.25rem 1.5rem;">
                    @if (isLoadingLabDetails)
                    {
                        <div class="table-empty-container py-5 text-center">
                            <div class="spinner-border text-primary mb-3" role="status"></div>
                            <span class="fw-bold text-dark d-block">Loading Lab Details...</span>
                            <span class="text-muted small">Fetching test items and results from billing request GUID...</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(labDetailsError))
                    {
                        <div class="alert alert-warning d-flex align-items-center gap-2 m-3">
                            <i class="bi bi-exclamation-triangle-fill fs-4 text-warning"></i>
                            <div>@labDetailsError</div>
                        </div>
                    }
                    else
                    {
                        <!-- Patient / Bill Meta Strip -->
                        @if (selectedLabBill != null)
                        {
                            var patName = !string.IsNullOrWhiteSpace(selectedLabBill.patient_name) 
                                ? selectedLabBill.patient_name 
                                : selectedLabPatient?.PatientName;

                            <div class="lab-meta-card mb-3">
                                <div class="lab-meta-item">
                                    <span class="lab-meta-label">Patient Name :</span>
                                    <strong class="lab-meta-value text-primary font-uppercase">@patName</strong>
                                </div>
                                <div class="lab-meta-item">
                                    <span class="lab-meta-label">Bill Number :</span>
                                    <span class="badge bg-light text-dark border font-numeric" style="font-size: 0.85rem; font-weight: 700;">@selectedLabBill.bill_no</span>
                                </div>
                                <div class="lab-meta-item">
                                    <span class="lab-meta-label">Bill Date &amp; Time :</span>
                                    <span class="lab-meta-value font-numeric">@(selectedLabBill.bill_date.HasValue ? selectedLabBill.bill_date.Value.ToString("dd-MMM-yyyy hh:mm tt") : "-")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(selectedLabBill.doctor_name))
                                {
                                    <div class="lab-meta-item">
                                        <span class="lab-meta-label">Doctor :</span>
                                        <span class="lab-meta-value">@selectedLabBill.doctor_name</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(selectedLabBill.mobileno))
                                {
                                    <div class="lab-meta-item">
                                        <span class="lab-meta-label">Mobile :</span>
                                        <span class="lab-meta-value font-numeric">@selectedLabBill.mobileno</span>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Tests Table -->
                        <div class="table-responsive lab-tests-table-wrapper" style="max-height: 48vh; border: 1px solid #e2e8f0; border-radius: 10px; overflow-x: hidden;">
                            <table class="custom-table lab-tests-table mb-0">
                                <thead>
                                    <tr style="background: #f1f5f9;">
                                        <th style="width: 45px;" class="text-center">S.NO</th>
                                        <th style="width: 34%;">TEST / SERVICE NAME</th>
                                        <th style="width: 26%;">LAB RESULT</th>
                                        <th class="text-center" style="width: 50px;">QTY</th>
                                        <th class="text-end" style="width: 85px;">RATE</th>
                                        <th class="text-end" style="width: 80px;">DISCOUNT</th>
                                        <th class="text-end" style="width: 95px; color: #2563eb;">AMOUNT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int tIdx = 1;
                                        var billItems = selectedLabBill?.items ?? new List<HmsBillLineResponse>();
                                        var resultItems = selectedLabResults?.results ?? new List<medico_backend.Model.LabResultEntry>();
                                    }

                                    @if (billItems.Count > 0)
                                    {
                                        @foreach (var itm in billItems)
                                        {
                                            var labRes = resultItems.FirstOrDefault(r => string.Equals(r.testname?.Trim(), itm.item_name?.Trim(), StringComparison.OrdinalIgnoreCase));
                                            bool isService = IsServiceItem(itm.item_name, itm.charge_type);
                                            <tr>
                                                <td class="text-center text-muted font-numeric">@(tIdx++)</td>
                                                <td>
                                                    <div class="d-flex align-items-center flex-wrap gap-1">
                                                        <span class="fw-bold text-dark">@FormatTestName(itm.item_name)</span>
                                                        @if (isService)
                                                        {
                                                            <span class="service-pill-tag @GetServiceCssClass(itm.item_name)">
                                                                <i class="bi bi-gear-fill me-1" style="font-size: 0.62rem;"></i>@GetServiceBadgeLabel(itm.item_name)
                                                            </span>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(itm.charge_type) && itm.charge_type != "INVESTIGATION" && !isService)
                                                    {
                                                        <small class="text-muted">@itm.charge_type</small>
                                                    }
                                                </td>
                                                <td>
                                                    @if (labRes != null && !string.IsNullOrWhiteSpace(labRes.enteredresult))
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                            @labRes.enteredresult @labRes.unitname
                                                        </span>
                                                        @if (!string.IsNullOrWhiteSpace(labRes.normalvalue))
                                                        {
                                                            <div class="text-muted small mt-1">Ref: @labRes.normalvalue</div>
                                                        }
                                                    }
                                                    else if (labRes != null && labRes.status)
                                                    {
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Completed</span>
                                                    }
                                                    else if (labRes != null)
                                                    {
                                                        <span class="badge bg-light text-muted border">Result Pending</span>
                                                    }
                                                    else if (isService)
                                                    {
                                                        <span class="badge bg-light text-secondary border">Diagnostic Service</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">-</span>
                                                    }
                                                </td>
                                                <td class="text-center font-numeric">@(itm.qty ?? 1)</td>
                                                <td class="text-end font-numeric">&#8377;@((itm.unit_rate ?? 0).ToString("N2"))</td>
                                                <td class="text-end font-numeric text-danger">@((itm.discount ?? 0) > 0 ? $"- â‚¹{(itm.discount ?? 0):N2}" : "â‚¹0.00")</td>
                                                <td class="text-end font-numeric fw-bold text-primary">&#8377;@((itm.final_amount ?? itm.amount ?? 0).ToString("N2"))</td>
                                            </tr>
                                        }
                                    }
                                    else if (resultItems.Count > 0)
                                    {
                                        @foreach (var res in resultItems)
                                        {
                                            <tr>
                                                <td class="text-center text-muted font-numeric">@(tIdx++)</td>
                                                <td>
                                                    <div class="fw-bold text-dark">@res.testname</div>
                                                    @if (!string.IsNullOrWhiteSpace(res.groupname))
                                                    {
                                                        <small class="text-muted">@res.groupname</small>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(res.enteredresult))
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                            @res.enteredresult @res.unitname
                                                        </span>
                                                        @if (!string.IsNullOrWhiteSpace(res.normalvalue))
                                                        {
                                                            <div class="text-muted small mt-1">Ref: @res.normalvalue</div>
                                                        }
                                                    }
                                                    else if (res.status)
                                                    {
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Completed</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-muted border">Result Pending</span>
                                                    }
