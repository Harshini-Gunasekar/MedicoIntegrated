@code {
    private string DefaultTenant = "0010";
    private string FormatOpNo(string? opNo)
    {
        if (string.IsNullOrWhiteSpace(opNo)) return "-";
        var trimmed = opNo.Trim();
        if (trimmed.Equals("NO VISIT", StringComparison.OrdinalIgnoreCase) ||
            trimmed.Equals("NOVISIT", StringComparison.OrdinalIgnoreCase) ||
            trimmed.Equals("NO_VISIT", StringComparison.OrdinalIgnoreCase) ||
            trimmed.Equals("OP Visit", StringComparison.OrdinalIgnoreCase) ||
            trimmed.Equals("NULL", StringComparison.OrdinalIgnoreCase) ||
            trimmed.Equals("N/A", StringComparison.OrdinalIgnoreCase))
        {
            return "-";
        }
        return trimmed;
    }

    private string FormatTestName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        var trimmed = name.Trim();
        if (trimmed.Equals("ECGECG Category", StringComparison.OrdinalIgnoreCase) ||
            trimmed.Equals("ECG ECG Category", StringComparison.OrdinalIgnoreCase))
        {
            return "ECG";
        }
        return trimmed;
    }

    private bool IsServiceItem(string? itemName, string? chargeType)
    {
        if (!string.IsNullOrWhiteSpace(chargeType) &&
            (chargeType.Contains("SERVICE", StringComparison.OrdinalIgnoreCase) ||
             chargeType.Contains("PROCEDURE", StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }

        if (string.IsNullOrWhiteSpace(itemName)) return false;
        var upper = itemName.ToUpperInvariant();
        return upper.Contains("ECG") ||
               upper.Contains("XRAY") ||
               upper.Contains("X-RAY") ||
               upper.Contains("ECHO") ||
               upper.Contains("USG") ||
               upper.Contains("SCAN") ||
               upper.Contains("ULTRASOUND") ||
               upper.Contains("DRESSING") ||
               upper.Contains("INJECTION") ||
               upper.Contains("PHYSIO") ||
               upper.Contains("NEBULIZATION");
    }

    private string GetServiceBadgeLabel(string? itemName)
    {
        if (string.IsNullOrWhiteSpace(itemName)) return "SERVICE";
        var upper = itemName.ToUpperInvariant();
        if (upper.Contains("ECG")) return "ECG SERVICE";
        if (upper.Contains("XRAY") || upper.Contains("X-RAY")) return "X-RAY SERVICE";
        if (upper.Contains("ECHO")) return "ECHO SERVICE";
        if (upper.Contains("USG") || upper.Contains("ULTRASOUND")) return "USG SERVICE";
