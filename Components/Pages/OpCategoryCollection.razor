    private async Task EnsureLookupsLoadedAsync()
    {
        if (lookupsLoaded) return;
        try
        {
            var opTask = AppointmentBookingService.GetAllOpRegistrationsAsync();
            var billTask = BillingService.ListBillsAsync(new HmsBillFilterRequest
            {
                fromdate = fromDate.Date,
                todate = toDate.Date.AddDays(1).AddSeconds(-1),
                pagesize = 1000
            });

            await Task.WhenAll(opTask, billTask);

            var opList = await opTask;
            if (opList != null)
            {
                foreach (var r in opList.Where(x => !x.isdeleted && !string.IsNullOrWhiteSpace(x.op_no)))
                {
                    opLookupByNo[r.op_no.Trim()] = r;
                }
            }

            var billResp = await billTask;
            if (billResp?.data != null)
            {
                foreach (var b in billResp.data.Where(x => !string.IsNullOrWhiteSpace(x.bill_no)))
                {
                    var bTrim = b.bill_no!.Trim();
                    if (b.bill_date.HasValue)
                    {
                        billDateLookup[bTrim] = b.bill_date.Value;
                    }
                    if (!string.IsNullOrWhiteSpace(b.requestguid))
                    {
                        billGuidLookup[bTrim] = b.requestguid.Trim();
                    }
                }
            }

            lookupsLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OpCategoryCollection] Error loading timestamp lookups: {ex.Message}");
        }
    }

    private DateTime? ResolveRealVisitDateTime(HmsOpVisitCategoryRow? v)
    {
        if (v == null) return null;

        // 1. If visit_date has actual time (not midnight 00:00:00)
        if (v.visit_date.HasValue && (v.visit_date.Value.TimeOfDay != TimeSpan.Zero || v.visit_date.Value.Millisecond > 0))
        {
            return v.visit_date.Value;
        }

        // 2. Look up bill date by bill_nos
        if (!string.IsNullOrWhiteSpace(v.bill_nos))
        {
            foreach (var bNo in v.bill_nos.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                if (billDateLookup.TryGetValue(bNo.Trim(), out var bDate) && bDate != default)
                {
                    return bDate;
                }
            }
        }

        // 3. Look up OP registration by op_no
        if (!string.IsNullOrWhiteSpace(v.op_no) && opLookupByNo.TryGetValue(v.op_no.Trim(), out var opReg))
        {
            if (!string.IsNullOrWhiteSpace(opReg.walkin_time) && DateTime.TryParse(opReg.walkin_time, out var wt))
            {
                var baseD = v.visit_date ?? (opReg.visit_date != default ? opReg.visit_date.ToDateTime(TimeOnly.MinValue) : opReg.created_at);
                return baseD.Date + wt.TimeOfDay;
            }
            if (opReg.created_at != default)
            {
                return opReg.created_at;
            }
        }

        return v.visit_date;
    }

    private async Task LoadPharmacyPatientsAsync()
    {
        cachedPharmacyPatientRows.Clear();
        try
        {
            var client = ClientFactory.CreateClient("DoctorApi");
            var tCode = !string.IsNullOrEmpty(DefaultTenant) ? DefaultTenant : (TenantState?.TenantCode ?? "0010");
            client.DefaultRequestHeaders.Remove("tenantcode");
            client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Remove("tenant-code");
            client.DefaultRequestHeaders.Add("tenantcode", tCode);
            client.DefaultRequestHeaders.Add("tenant_code", tCode);
            client.DefaultRequestHeaders.Add("tenant-code", tCode);

            var response = await client.GetStringAsync("api/ItemMaster/getsales");
            if (!string.IsNullOrWhiteSpace(response))
            {
                using var jsonDoc = JsonDocument.Parse(response);
                JsonElement arrayElement;
                if (jsonDoc.RootElement.ValueKind == JsonValueKind.Array)
                {
                    arrayElement = jsonDoc.RootElement;
                }
                else if (jsonDoc.RootElement.TryGetProperty("data", out var dProp) && dProp.ValueKind == JsonValueKind.Array)
                {
                    arrayElement = dProp;
                }
                else
                {
                    return;
                }

                foreach (var el in arrayElement.EnumerateArray())
                {
                    var target = el;
                    if (el.TryGetProperty("master", out var mProp)) target = mProp;

                    string billNo = target.TryGetProperty("billno", out var bn) ? bn.GetString() ?? "" : "";
                    string patientName = target.TryGetProperty("patientname", out var pn) ? pn.GetString() ?? "" : "";
                    string salesType = target.TryGetProperty("salestype", out var st) ? st.GetString() ?? "" : "Pharmacy Sale";
                    string payMode = target.TryGetProperty("paymentmode", out var pm) ? pm.GetString() ?? "Cash" : "Cash";
                    string payStatus = target.TryGetProperty("paymentstatus", out var ps) ? ps.GetString() ?? "" : "";

                    decimal? custId = null;
                    if (target.TryGetProperty("patientid", out var pid) && decimal.TryParse(pid.GetString(), out var pidDec))
                        custId = pidDec;
                    else if (target.TryGetProperty("customercode", out var cc) && cc.ValueKind == JsonValueKind.Number && cc.TryGetDecimal(out var ccDec))
                        custId = ccDec;

                    DateTime billDate = default;
                    if (target.TryGetProperty("createddate", out var cd) && cd.ValueKind == JsonValueKind.String && DateTime.TryParse(cd.GetString(), out var cdVal))
                        billDate = cdVal;
                    else if (target.TryGetProperty("billdate", out var bd) && bd.ValueKind == JsonValueKind.String && DateTime.TryParse(bd.GetString(), out var bdVal))
                        billDate = bdVal;

                    double netAmt = 0;
                    if (target.TryGetProperty("netamount", out var na) && na.ValueKind == JsonValueKind.Number)
                        netAmt = na.GetDouble();

                    double paidAmt = 0;
                    bool isPaid = string.Equals(payStatus, "Paid", StringComparison.OrdinalIgnoreCase) || string.Equals(payStatus, "Settled", StringComparison.OrdinalIgnoreCase);
                    if (isPaid)
                    {
                        paidAmt = netAmt;
                    }
                    else if (target.TryGetProperty("paidamount", out var pa) && pa.ValueKind == JsonValueKind.Number)
                    {
                        paidAmt = pa.GetDouble();
                    }

                    // Filter by date range
                    if (billDate != default)
                    {
                        if (billDate.Date < fromDate.Date || billDate.Date > toDate.Date)
                            continue;
                    }

                    // Filter by branch if selected
                    if (selectedBhCode > 0 && target.TryGetProperty("bh_code", out var bhc) && bhc.ValueKind == JsonValueKind.Number)
                    {
                        if (bhc.GetInt32() != selectedBhCode) continue;
                    }

                    double dueAmt = Math.Max(0, netAmt - paidAmt);
                    string paySummary = !string.IsNullOrWhiteSpace(payMode) ? $"{payMode.ToUpperInvariant()}: ₹{paidAmt:N2}" : "CASH";

                    cachedPharmacyPatientRows.Add(new CategoryPatientDetailRow
                    {
                        OpNo = !string.IsNullOrWhiteSpace(salesType) ? salesType : "Pharmacy Sale",
                        TokenNo = custId.HasValue ? $"#{custId}" : "-",
                        VisitDate = billDate != default ? billDate : (DateTime?)null,
                        PatientName = !string.IsNullOrWhiteSpace(patientName) ? patientName : "Pharmacy Customer",
                        CustId = custId,
                        BillNos = billNo,
                        CategoryNet = netAmt,
                        CategoryCollected = paidAmt,
                        CategoryDue = dueAmt,
                        TotalNet = netAmt,
                        TotalCollected = paidAmt,
                        TotalDue = dueAmt,
                        PaymodeBreakdown = paySummary
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OpCategoryCollection] Error loading pharmacy patients: {ex.Message}");
        }
    }

    private async Task LoadIpPatientsAsync()
    {
        cachedIpPatientRows.Clear();
        try
        {
            var ipList = await IpService.GetIpRegistrationsAsync();
            if (ipList == null || !ipList.Any()) return;

            var tCode = !string.IsNullOrEmpty(DefaultTenant) ? DefaultTenant : (TenantState?.TenantCode ?? "0010");
            var client = ClientFactory.CreateClient("DoctorApi");
            client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Add("tenant_code", tCode);

            foreach (var ip in ipList)
            {
                if (string.IsNullOrWhiteSpace(ip.ip_no) || ip.custid <= 0) continue;

                DateTime ipDate = ip.admitdate != default ? ip.admitdate : ip.created_at;

                try
                {
                    string summaryUrl = $"api/BillingSummary/ip?ip_no={Uri.EscapeDataString(ip.ip_no)}&custid={ip.custid}";
                    var resp = await client.GetAsync(summaryUrl);
                    if (resp.IsSuccessStatusCode)
                    {
                        var json = await resp.Content.ReadAsStringAsync();
                        using var doc = JsonDocument.Parse(json);
                        var root = doc.RootElement;

                        double billedTot = root.TryGetProperty("billed_total", out var bt) && bt.ValueKind == JsonValueKind.Number ? bt.GetDouble() : 0;
                        double unbilledTot = root.TryGetProperty("unbilled_total", out var ut) && ut.ValueKind == JsonValueKind.Number ? ut.GetDouble() : 0;
                        double totalNet = billedTot + unbilledTot;

                        var billNumbers = new List<string>();
                        DateTime? latestBillDate = null;
                        double billedAmountSum = 0;

                        if (root.TryGetProperty("billed_items", out var bItems) && bItems.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var bi in bItems.EnumerateArray())
                            {
                                if (bi.TryGetProperty("billno", out var bnoProp) && !string.IsNullOrWhiteSpace(bnoProp.GetString()))
                                {
                                    var bno = bnoProp.GetString()!;
                                    if (!billNumbers.Contains(bno)) billNumbers.Add(bno);
                                }
                                if (bi.TryGetProperty("billeddate", out var bdProp) && bdProp.ValueKind == JsonValueKind.String && DateTime.TryParse(bdProp.GetString(), out var bdVal))
                                {
                                    if (!latestBillDate.HasValue || bdVal > latestBillDate.Value) latestBillDate = bdVal;
                                }
                                if (bi.TryGetProperty("billedamount", out var baProp) && baProp.ValueKind == JsonValueKind.Number)
                                {
                                    billedAmountSum += baProp.GetDouble();
                                }
                            }
                        }

                        DateTime effDate = latestBillDate ?? (ipDate != default ? ipDate : DateTime.Now);

                        if (totalNet <= 0 && billedAmountSum <= 0 && (ipDate == default || ipDate.Date < fromDate.Date || ipDate.Date > toDate.Date))
                            continue;

                        double colAmt = billedTot > 0 ? billedTot : billedAmountSum;
                        double dueAmt = Math.Max(0, totalNet - colAmt);
                        string patName = !string.IsNullOrWhiteSpace(ip.patient_name) ? ip.patient_name : (!string.IsNullOrWhiteSpace(ip.name) ? ip.name : (!string.IsNullOrWhiteSpace(ip.custname) ? ip.custname : "Inpatient"));

                        cachedIpPatientRows.Add(new CategoryPatientDetailRow
                        {
                            OpNo = ip.ip_no,
                            TokenNo = ip.bedcode.HasValue ? $"Bed #{ip.bedcode.Value}" : "-",
                            VisitDate = effDate,
                            PatientName = patName,
                            CustId = ip.custid,
                            CustCode = ip.custcode,
                            BillNos = billNumbers.Any() ? string.Join(", ", billNumbers) : ip.ip_no,
                            CategoryNet = totalNet > 0 ? totalNet : colAmt,
                            CategoryCollected = colAmt,
                            CategoryDue = dueAmt,
                            TotalNet = totalNet > 0 ? totalNet : colAmt,
                            TotalCollected = colAmt,
                            TotalDue = dueAmt,
                            PaymodeBreakdown = colAmt > 0 ? $"CASH: ₹{colAmt:N2}" : "-"
                        });
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[OpCategoryCollection] Error fetching IP summary for {ip.ip_no}: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OpCategoryCollection] Error loading IP patients: {ex.Message}");
        }
    }

    private List<CategoryPatientDetailRow> GetFilteredCategoryPatients()
    {
        if (string.IsNullOrWhiteSpace(selectedCategoryForPatients))
            return new List<CategoryPatientDetailRow>();

        var cat = selectedCategoryForPatients.Trim().ToUpperInvariant();
        List<CategoryPatientDetailRow> list;

        if (cat.Contains("PHARM"))
        {
            list = cachedPharmacyPatientRows.ToList();
        }
        else if (cat == "IP" || cat.Contains("INPATIENT"))
        {
            list = cachedIpPatientRows.ToList();
        }
        else
        {
            list = new List<CategoryPatientDetailRow>();
            if (reportData?.visits != null)
            {
                foreach (var v in reportData.visits)
                {
                    double catNet = 0;
                    double catCol = 0;

                    if (v.net_by_category != null)
                    {
                        var kv = v.net_by_category.FirstOrDefault(k => string.Equals(k.Key, selectedCategoryForPatients, StringComparison.OrdinalIgnoreCase));
                        catNet = kv.Value;
                    }

                    if (v.collected_by_category != null)
                    {
                        var kv = v.collected_by_category.FirstOrDefault(k => string.Equals(k.Key, selectedCategoryForPatients, StringComparison.OrdinalIgnoreCase));
                        catCol = kv.Value;
                    }

                    if (catNet > 0 || catCol > 0)
                    {
                        double catDue = Math.Max(0, catNet - catCol);

                        string pmSummary = "";
                        if (v.collected_by_paymode != null && v.collected_by_paymode.Count > 0)
                        {
                            double totalVisitCol = v.collected_by_paymode.Values.Sum();
                            if (totalVisitCol > 0 && catCol > 0 && Math.Abs(totalVisitCol - catCol) > 0.01)
                            {
                                double ratio = catCol / totalVisitCol;
                                pmSummary = string.Join(", ", v.collected_by_paymode.Where(kv => kv.Value > 0).Select(kv => $"{kv.Key}: ₹{(kv.Value * ratio):N2}"));
                            }
                            else
                            {
                                pmSummary = string.Join(", ", v.collected_by_paymode.Where(kv => kv.Value > 0).Select(kv => $"{kv.Key}: ₹{kv.Value:N2}"));
                            }
                        }
                        else if (catCol > 0)
                        {
                            pmSummary = $"CASH: ₹{catCol:N2}";
                        }

                        DateTime? realDate = ResolveRealVisitDateTime(v);

                        string? reqGuid = null;
                        if (!string.IsNullOrWhiteSpace(v.op_id) && v.op_id.StartsWith("BILL-", StringComparison.OrdinalIgnoreCase))
                        {
                            reqGuid = v.op_id.Substring(5).Trim();
                        }
                        else if (!string.IsNullOrWhiteSpace(v.bill_nos))
                        {
                            foreach (var bNo in v.bill_nos.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                if (billGuidLookup.TryGetValue(bNo.Trim(), out var bg) && !string.IsNullOrWhiteSpace(bg))
                                {
                                    reqGuid = bg;
                                    break;
                                }
                            }
                        }

                        list.Add(new CategoryPatientDetailRow
                        {
                            OpNo = v.op_no,
                            TokenNo = v.token_no,
                            VisitDate = realDate,
                            PatientName = v.patient_name,
                            CustId = v.custid,
                            CustCode = !string.IsNullOrWhiteSpace(v.custcode) ? v.custcode : (opLookupByNo.TryGetValue(v.op_no ?? "", out var rgc) ? rgc.custcode : null),
                            BillNos = v.bill_nos,
                            RequestGuid = reqGuid,
                            CategoryNet = catNet,
                            CategoryCollected = catCol,
                            CategoryDue = catDue,
                            TotalNet = v.net_amount,
                            TotalCollected = v.collected_amount,
                            TotalDue = v.due_amount,
                            PaymodeBreakdown = pmSummary
                        });
                    }
                }
            }
        }

        if (!string.IsNullOrWhiteSpace(categoryPatientsSearch))
        {
            var q = categoryPatientsSearch.Trim().ToLowerInvariant();
            list = list.Where(p =>
                (p.PatientName?.ToLowerInvariant().Contains(q) ?? false) ||
                (p.OpNo?.ToLowerInvariant().Contains(q) ?? false) ||
                (p.BillNos?.ToLowerInvariant().Contains(q) ?? false) ||
                (p.CustId?.ToString().Contains(q) ?? false) ||
                (p.TokenNo?.ToLowerInvariant().Contains(q) ?? false)
            ).ToList();
        }

        return list;
    }

    private async Task ExportCategoryPatientsCsvAsync()
    {
        try
        {
            var list = GetFilteredCategoryPatients();
            if (!list.Any())
            {
                ToastService.ShowWarning($"No patient records to export for {selectedCategoryForPatients}.");
                return;
            }

            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"Patient List for Category: {selectedCategoryForPatients} ({fromDate:dd-MMM-yyyy} to {toDate:dd-MMM-yyyy})");
            sb.AppendLine("S.No,OP No,Token,Date & Time,Patient Name,UHID,Bill Nos,Category Net (INR),Category Collected (INR),Category Due (INR),Pay Modes,Status");

            int idx = 1;
            foreach (var p in list)
            {
                string status = p.CategoryDue <= 0 && p.CategoryNet > 0 ? "Settled" : (p.CategoryCollected > 0 && p.CategoryDue > 0 ? "Partial" : (p.CategoryDue > 0 ? "Pending" : "Zero Net"));
                sb.AppendLine($"{idx++},{EscapeCsv(p.OpNo)},{EscapeCsv(p.TokenNo)},{p.VisitDate:yyyy-MM-dd HH:mm},{EscapeCsv(p.PatientName)},{p.CustId},{EscapeCsv(p.BillNos)},{p.CategoryNet:F2},{p.CategoryCollected:F2},{p.CategoryDue:F2},{EscapeCsv(p.PaymodeBreakdown)},{status}");
            }
            sb.AppendLine($"TOTAL ({list.Count} Patients),,,,,,,{list.Sum(p => p.CategoryNet):F2},{list.Sum(p => p.CategoryCollected):F2},{list.Sum(p => p.CategoryDue):F2},,");

            string filename = $"Category_Patients_{selectedCategoryForPatients}_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await JS.InvokeVoidAsync("downloadCsvFile", sb.ToString(), filename);
            ToastService.ShowSuccess($"Exported {list.Count} patient records for {selectedCategoryForPatients}.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to export CSV: {ex.Message}");
        }
    }

    private async Task ExportCsvAsync()
    {
        try
        {
            if (reportData == null)
            {
                ToastService.ShowWarning("No records to export.");
                return;
            }

            var sb = new System.Text.StringBuilder();

            if (activeTab == "categories")
            {
                sb.AppendLine("Departmental Category,OP Visits,Bills Count,Items Count,Gross Amount (INR),Discount Amount (INR),Net Amount (INR),Collected Amount (INR),Cash Amount (INR),UPI Amount (INR),Due Amount (INR)");
                var list = FilteredCategories;
                foreach (var c in list)
                {
                    sb.AppendLine($"{EscapeCsv(c.category)},{c.visit_count},{c.bill_count},{c.item_count},{c.gross_amount:F2},{Math.Abs(c.discount_amount):F2},{c.net_amount:F2},{c.collected_amount:F2},{c.CashAmount:F2},{c.UpiAmount:F2},{c.due_amount:F2}");
                }
                double totalNet = list.Sum(c => c.net_amount);
                double totalCol = list.Sum(c => c.collected_amount);
                double totalCash = list.Sum(c => c.CashAmount);
                double totalUpi = list.Sum(c => c.UpiAmount);
                sb.AppendLine($"TOTAL,{list.Sum(c => c.visit_count)},{list.Sum(c => c.bill_count)},{list.Sum(c => c.item_count)},{list.Sum(c => c.gross_amount):F2},{list.Sum(c => Math.Abs(c.discount_amount)):F2},{totalNet:F2},{totalCol:F2},{totalCash:F2},{totalUpi:F2},{list.Sum(c => c.due_amount):F2}");
            }
            else if (activeTab == "services")
            {
                sb.AppendLine("Service ID,Service Name,OP Visits,Items Count,Token References,Net Amount (INR),Collected Amount (INR),Due Amount (INR)");
                var list = FilteredServices;
                foreach (var s in list)
                {
                    sb.AppendLine($"\"{s.service_id}\",{EscapeCsv(s.service_name)},{s.visit_count},{s.item_count},{EscapeCsv(s.tokens)},{s.net_amount:F2},{s.collected_amount:F2},{s.due_amount:F2}");
                }
                sb.AppendLine($"TOTAL,,{list.Sum(s => s.visit_count)},{list.Sum(s => s.item_count)},,{list.Sum(s => s.net_amount):F2},{list.Sum(s => s.collected_amount):F2},{list.Sum(s => s.due_amount):F2}");
            }
            else
            {
                sb.AppendLine("Visit Date,OP No,Token No,Patient Name,UHID,Bill Nos,Net Amount (INR),Collected Amount (INR),Due Amount (INR),Status");
                var list = FilteredVisits;
                foreach (var v in list)
                {
                    string status = v.due_amount <= 0 && v.net_amount > 0 ? "Settled" : (v.collected_amount > 0 && v.due_amount > 0 ? "Partial" : (v.due_amount > 0 ? "Pending" : "Zero Net"));
                    sb.AppendLine($"{v.visit_date:yyyy-MM-dd HH:mm},{EscapeCsv(v.op_no)},{EscapeCsv(v.token_no)},{EscapeCsv(v.patient_name)},{v.custid},{EscapeCsv(v.bill_nos)},{v.net_amount:F2},{v.collected_amount:F2},{v.due_amount:F2},{status}");
                }
                sb.AppendLine($"TOTAL ({list.Count} Visits),,,,,,{list.Sum(v => v.net_amount):F2},{list.Sum(v => v.collected_amount):F2},{list.Sum(v => v.due_amount):F2},");
            }

            string filename = $"Billing_Categorization_{activeTab}_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await JS.InvokeVoidAsync("downloadCsvFile", sb.ToString(), filename);
            ToastService.ShowSuccess($"Exported {CurrentActiveCount} records to CSV successfully.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OpCategoryCollection] Export CSV error: {ex.Message}");
            ToastService.ShowError($"Failed to export CSV: {ex.Message}");
        }
    }

    private static string EscapeCsv(string? val)
    {
        if (string.IsNullOrEmpty(val)) return "\"\"";
        if (val.Contains(",") || val.Contains("\"") || val.Contains("\n") || val.Contains("\r"))
        {
            return $"\"{val.Replace("\"", "\"\"")}\"";
        }
        return val;
    }

