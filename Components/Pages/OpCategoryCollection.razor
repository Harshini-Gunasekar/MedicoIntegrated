        double totalNet = reportData?.total_net ?? 0;
        double totalCol = reportData?.total_collected ?? 0;
        double totalDue = reportData?.total_due ?? 0;
        double recoveryPct = totalNet > 0 ? Math.Round((totalCol / totalNet) * 100, 1) : 0;

        // Categories Table Rows
        var catRows = new System.Text.StringBuilder();
        var catList = FilteredCategories;
        if (catList.Any())
        {
            int idx = 1;
            foreach (var c in catList)
