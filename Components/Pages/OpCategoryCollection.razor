    private async Task OpenLabDetailsModal(CategoryPatientDetailRow p)
    {
        selectedLabPatient = p;
        selectedLabBill = null;
        selectedLabResults = null;
        labDetailsError = null;
        showLabDetailsModal = true;
        isLoadingLabDetails = true;
        StateHasChanged();

        try
        {
            string? guid = p.RequestGuid;

            if (string.IsNullOrWhiteSpace(guid) && !string.IsNullOrWhiteSpace(p.BillNos))
            {
                foreach (var bNo in p.BillNos.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    if (billGuidLookup.TryGetValue(bNo.Trim(), out var bg) && !string.IsNullOrWhiteSpace(bg))
                    {
                        guid = bg;
                        break;
                    }
                }
            }

            // Fallback: If not yet in lookup, search bill by bill number
            if (string.IsNullOrWhiteSpace(guid) && !string.IsNullOrWhiteSpace(p.BillNos))
            {
                var firstBillNo = p.BillNos.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)[0].Trim();
                var searchRes = await BillingService.ListBillsAsync(new HmsBillFilterRequest { search = firstBillNo, pagesize = 5 });
                var match = searchRes?.data?.FirstOrDefault(x => string.Equals(x.bill_no?.Trim(), firstBillNo, StringComparison.OrdinalIgnoreCase))
                            ?? searchRes?.data?.FirstOrDefault();
                if (match != null && !string.IsNullOrWhiteSpace(match.requestguid))
                {
                    guid = match.requestguid.Trim();
                    billGuidLookup[firstBillNo] = guid;
                }
            }

            if (string.IsNullOrWhiteSpace(guid))
            {
                labDetailsError = "Billing request GUID could not be located for this patient's lab bill.";
                return;
            }

            // 1. Fetch bill details from requestguid (contains the tests and amount for each!)
            selectedLabBill = await BillingService.GetBillByGuidAsync(guid);

            // 2. Fetch lab test result entry if available
            try
            {
                selectedLabResults = await LabResultService.LoadTestResultEntryAsync(guid);
            }
            catch (Exception rex)
            {
                Console.WriteLine($"[OpCategoryCollection] Notice loading lab results for {guid}: {rex.Message}");
            }

            if (selectedLabBill == null && (selectedLabResults == null || selectedLabResults.results == null || !selectedLabResults.results.Any()))
            {
                labDetailsError = $"No lab test details found for request GUID: {guid}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OpCategoryCollection] Error loading lab details: {ex.Message}");
            labDetailsError = $"Failed to load lab details: {ex.Message}";
        }
        finally
        {
            isLoadingLabDetails = false;
            StateHasChanged();
        }
    }

    private void CloseLabDetailsModal()
    {
        showLabDetailsModal = false;
        selectedLabPatient = null;
        selectedLabBill = null;
        selectedLabResults = null;
        labDetailsError = null;
    }

    private string GetDisplayUhid(decimal? custid, string? opNo, string? directCustCode = null)
    {
        if (!string.IsNullOrWhiteSpace(directCustCode))
            return directCustCode;
        if (!string.IsNullOrWhiteSpace(opNo) && opLookupByNo.TryGetValue(opNo.Trim(), out var reg) && !string.IsNullOrWhiteSpace(reg.custcode))
            return reg.custcode;
        if (custid.HasValue && custid.Value > 0)
        {
            var uhid = UhidService.GetUhid(custid.Value, null, TenantState?.TenantCode);
            if (!string.IsNullOrWhiteSpace(uhid) && uhid != custid.Value.ToString()) return uhid;
            return custid.Value.ToString();
        }
        return "-";
    }
