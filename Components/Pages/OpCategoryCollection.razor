                        <td style=""text-align: right;"">{c.bill_count}</td>
                        <td style=""text-align: right;"">{c.item_count}</td>
                        <td style=""text-align: right;"">&#8377;{c.gross_amount:N2}</td>
                        <td style=""text-align: right; color: #dc2626;"">&#8377;{c.discount_amount:N2}</td>
                        <td style=""text-align: right; font-weight: 700; color: #2563eb;"">&#8377;{c.net_amount:N2}</td>
                        <td style=""text-align: right; font-weight: 700; color: #16a34a;"">&#8377;{c.collected_amount:N2}</td>
                        <td style=""text-align: right; font-weight: 700; color: {(c.due_amount > 0 ? "#dc2626" : "#64748b")};"">&#8377;{c.due_amount:N2}</td>
                        <td style=""text-align: right; font-weight: 700;"">{rowRecovery:F1}%</td>
                    </tr>");
            }
        }
        else
        {
            catRows.Append(@"<tr><td colspan=""11"" style=""text-align: center; color: #64748b; padding: 18px;"">No departmental category data available.</td></tr>");
        }

        // Secondary Services Table Rows (if mode == "full" or activeTab == "services")
        string servicesSectionHtml = "";
        if (mode == "full" || activeTab == "services")
        {
            var sRows = new System.Text.StringBuilder();
            var sList = FilteredServices;
