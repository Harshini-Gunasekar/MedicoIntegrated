                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Speech Speed</label>
                            <select class="form-select form-select-sm" @bind="SpeechRate">
                                <option value="0.7">Very Slow (0.7)</option>
                                <option value="0.8">Polite/Slow (0.8)</option>
                                <option value="0.9">Clear/Medium (0.9)</option>
                                <option value="1.0">Standard Speed (1.0)</option>
                            </select>
                        </div>
                        <div class="col-12 mt-2">
                            <button class="btn btn-sm btn-outline-secondary w-100" @onclick="TestVoiceChime">
                                <i class="bi bi-play-fill"></i> Test Announcement Chime Sound
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mb-3 border-top border-secondary pt-3">
                    <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-palette"></i> Screen Presentation Customization</h6>
                    
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" role="switch" id="autoThemeSwitch" @bind="_autoThemeSwitch" />
                        <label class="form-check-label fw-bold text-white small" for="autoThemeSwitch">Auto Theme (Dark Mode 6 PM - 6 AM)</label>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="themeSwitch" @bind="_isDarkMode" disabled="@_autoThemeSwitch" />
                        <label class="form-check-label fw-bold text-white small" for="themeSwitch">Manual Tech Sapphire Dark Mode</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Queue Layout Theme</label>
                        <select class="form-select form-select-sm" @bind="LayoutTheme">
                            <option value="grid">Grid Card Layout (Default)</option>
                            <option value="table">Table List Flow</option>
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold">Running Ticker Notification Bar Text</label>
                        <textarea class="form-control form-control-sm" rows="3" @bind="TickerMessage"></textarea>
                    </div>
                </div>
            }
        </div>

        <div class="admin-drawer-footer">
            <button class="btn btn-sm btn-primary w-100" @onclick="ToggleAdminDrawer">
                <i class="bi bi-check2-circle"></i> Save Settings &amp; Return
            </button>
        </div>
    </div> *@

</div>

@code {
