@page "/token-display"
@rendermode InteractiveServer
@using Medico_Backend.Model
@layout SharedComponents.Rcl.Components.Layout.EmptyLayout
@implements IDisposable
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavManager

<PageTitle>Hospital Token Display Signage</PageTitle>

<div>

    @if (!_hasSelectedDoctor && !_isAdminOpen)
    {
        <!-- DOCTOR SELECTION SCREEN -->
        <div class="kiosk-display justify-content-center align-items-center">
            <div class="live-bg-container">
                <div class="live-bg-blob live-bg-blob-1"></div>
                <div class="live-bg-blob live-bg-blob-2"></div>
                <div class="live-bg-blob live-bg-blob-3"></div>
            </div>
            <div class="doc-select-screen">
                <div class="doc-select-header">
                    <h1 class="doc-select-title">
                        <i class="bi bi-display"></i> Select Display Doctor
                    </h1>
                    <p class="doc-select-subtitle">Tap a doctor below to load their specific token queue.</p>
                </div>

                <!-- SEARCH NAME FILTER -->
                <div class="d-flex justify-content-center mb-4">
                    <div class="doc-search-wrapper">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" class="form-control doc-search-input" 
                               placeholder="Filter doctor by name..." 
                               @bind-value="_doctorSearchQuery" 
                               @bind-value:event="oninput" />
                        @if (!string.IsNullOrEmpty(_doctorSearchQuery))
                        {
                            <button class="doc-search-clear" type="button" @onclick="ClearDoctorSearch" aria-label="Clear Search">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>
                </div>
                
                @{
                    var units = GetAvailableDoctorUnits();
                    if (!string.IsNullOrWhiteSpace(_doctorSearchQuery))
                    {
                        units = units.Where(u => u.DisplayName.Contains(_doctorSearchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
                    }
                }
                @if (units.Any())
                {
                    <div class="doc-select-grid">
                        @foreach (var unit in units)
                        {
                            <div class="doc-select-card" @onclick='() => SelectUnitToDisplay(unit)'>
                                @if (unit.Doctors.Count > 1)
                                {
                                    <div class="doc-avatar-group" style="display: flex; align-items: center; justify-content: center; padding-left: 14px; min-height: 56px; margin-bottom: 12px;">
                                        @for (int i = 0; i < unit.Doctors.Count; i++)
                                        {
                                            var doc = unit.Doctors[i];
                                            var marginLeft = i > 0 ? "-14px" : "0px";
                                            var zIndex = unit.Doctors.Count - i;
                                            <div class="doc-avatar-item" style="width: 52px; height: 52px; border-radius: 50%; overflow: hidden; border: 3px solid #ffffff; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15); margin-left: @marginLeft; z-index: @zIndex; background: linear-gradient(135deg, #e0f2fe, #bae6fd); display: flex; align-items: center; justify-content: center; flex-shrink: 0;" title="@doc.DoctorName">
                                                @if (!string.IsNullOrEmpty(doc.DoctorImageUrl))
                                                {
                                                    <img src="@doc.DoctorImageUrl" alt="@doc.DoctorName" style="width: 100%; height: 100%; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-person-fill" style="font-size: 24px; color: #0284c7;"></i>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="doc-avatar-wrapper" style="width: 54px; height: 54px; border-radius: 50%; overflow: hidden; border: 3px solid #ffffff; box-shadow: 0 6px 16px rgba(0,0,0,0.12); display: flex; align-items: center; justify-content: center; margin-bottom: 12px; background: linear-gradient(135deg, #e0f2fe, #bae6fd);">
                                        @if (!string.IsNullOrEmpty(unit.DisplayImageUrl))
                                        {
                                            <img src="@unit.DisplayImageUrl" alt="@unit.DisplayName" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-fill" style="font-size: 24px; color: #0284c7;"></i>
                                        }
                                    </div>
                                }

                                <h2 class="doc-select-name" style="font-size: 18px; font-weight: 800; color: #0f172a; margin-bottom: 6px; line-height: 1.25; text-transform: capitalize;">@unit.DisplayName</h2>

                                @if (unit.GroupId.HasValue)
                                {
                                    <div class="doc-select-code" style="color: #7c3aed; font-weight: 800; background: rgba(124, 58, 237, 0.08); padding: 4px 12px; border-radius: 20px; border: 1px solid rgba(124, 58, 237, 0.2); font-size: 12px; margin-bottom: 12px; display: inline-block;">Group: @unit.GroupName</div>
                                }
                                else if (unit.Dcode != null)
                                {
                                    <div class="doc-select-code" style="color: #0284c7; font-weight: 800; background: rgba(2, 132, 199, 0.08); padding: 4px 12px; border-radius: 20px; border: 1px solid rgba(2, 132, 199, 0.2); font-size: 12px; margin-bottom: 12px; display: inline-block;">Code: @unit.Dcode</div>
                                }

                                <div class="doc-patient-badge">
                                    <span class="pulse-dot"></span>
                                    <span>@unit.TokenCount Patients Waiting</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-center">
                        <div class="no-docs-card">
                            @if (!string.IsNullOrWhiteSpace(_doctorSearchQuery))
                            {
                                <i class="bi bi-search fs-2 mb-3 d-block"></i>
                                <h3 class="fw-bold mb-2">No Matching Doctors</h3>
                                <p class="mb-4 fs-6">We couldn't find any doctor matching "@_doctorSearchQuery".</p>
                                <button class="btn btn-outline-info px-4 py-2" @onclick="ClearDoctorSearch">
                                    Clear Filter
                                </button>
                            }
                            else
                            {
                                <i class="bi bi-inbox"></i>
                                <h3 class="fw-bold mb-2">No Active Doctors Found</h3>
                                <p class="mb-4 fs-6">There are currently no patients waiting in the system.<br/>Wait for tokens to be generated or open settings.</p>
                                <div class="d-flex justify-content-center gap-2 mt-3">
                                    <button class="btn btn-outline-info px-4 py-2" @onclick="ToggleAdminDrawer">
                                        <i class="bi bi-sliders"></i> Open Settings
                                    </button>
                                    <button class="btn btn-link text-muted" @onclick='SelectAllDoctors'>
                                        Show Empty Display
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
    <!-- FULLSCREEN KIOSK DISPLAY COVERING THE PAGE -->
    <div class="kiosk-display">
        <div class="live-bg-container">
            <div class="live-bg-blob live-bg-blob-1"></div>
            <div class="live-bg-blob live-bg-blob-2"></div>
            <div class="live-bg-blob live-bg-blob-3"></div>
        </div>
        <div class="glass-panel">
            
            <!-- HEADER SECTION -->
            <header class="signage-header image-style-header">
                <!-- Inner curved glass shapes -->
                <div class="header-glass-bg">
                    <div class="glass-layer-1"></div>
                    <div class="glass-layer-2"></div>
                </div>

                <div class="logo-section" @ondblclick="ToggleAdminDrawer" title="Double click to configure">
                    <div style="overflow: hidden; width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; margin-right: -6px; flex-shrink: 0;">
                        <img src="images/output-smallpngtools.png" alt="Hospital Logo" style="height: 90px; width: 90px; object-fit: cover; transform: scale(1.4); flex-shrink: 0;" />
                    </div>
                    <div class="hospital-name">
                        @HospitalName
                        <span>Patient Care Signage</span>
                    </div>
                </div>

                <div class="doctor-plate" @ondblclick="ClearDoctorSelection" style="cursor: pointer; width: 100%; padding: 0 40px;" title="Double click to change doctor">
                    <div class="doc-info-list" style="display: flex; flex-direction: row; justify-content: space-around; align-items: center; gap: 20px; width: 100%;">
                        @{
                            var selectedUnit = GetSelectedDoctorUnit();
                        }
                        @if (selectedUnit != null)
                        {
                            @for (int dIdx = 0; dIdx < selectedUnit.Doctors.Count; dIdx++)
                            {
                                var doc = selectedUnit.Doctors[dIdx];
                                var isExiting = _isShowcaseExiting;
                                var headerAnimClass = _isShowcaseVisible ? (isExiting ? "header-doc-animating-up" : "header-doc-animating-down") : "";
                                var docDelay = _isShowcaseVisible ? (isExiting ? (dIdx * 0.25 + 0.1).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) + "s" : (dIdx * 0.65 + 0.4).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) + "s") : "0s";

                                <div class="doc-block @headerAnimClass" style="display: flex; flex-direction: row; align-items: center; gap: 12px; animation-delay: @docDelay;">
                                    @if (!string.IsNullOrEmpty(doc.DoctorImageUrl))
                                    {
                                        <div style="width: 44px; height: 44px; border-radius: 50%; overflow: hidden; border: 2.5px solid #08552f; box-shadow: 0 2px 8px rgba(8, 85, 47, 0.25); flex-shrink: 0;">
                                            <img src="@doc.DoctorImageUrl" alt="@doc.DoctorName" style="width: 100%; height: 100%; object-fit: cover;" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="width: 44px; height: 44px; border-radius: 50%; overflow: hidden; border: 2.5px solid #08552f; box-shadow: 0 2px 8px rgba(8, 85, 47, 0.25); flex-shrink: 0; background: #08552f; display: flex; align-items: center; justify-content: center;">
                                            <span style="color: white; font-weight: 800; font-size: 20px;">@(string.IsNullOrWhiteSpace(doc.DoctorName) ? "" : doc.DoctorName.Substring(0, 1).ToUpper())</span>
                                        </div>
                                    }
                                    <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 2px; text-align: left;">
                                        <div class="doc-line" style="display: flex; align-items: center; gap: 8px; justify-content: flex-start;">
                                            <span class="status-dot solid-green" style="width: 8px; height: 8px; box-shadow: 0 0 5px rgba(15, 139, 70, 0.5); flex-shrink: 0; border-radius: 50%; background: #0f8b46;"></span>
                                            <h2 class="doctor-name" style="font-size: 19px; font-weight: 800; color: #08552f; margin: 0; line-height: 1.1; white-space: nowrap;">@(doc.DoctorName?.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) == true ? "" : "Dr. ")@doc.DoctorName</h2>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(doc.DoctorQualification))
                                        {
                                            <span class="doctor-credentials" style="font-size: 12px; color: #6b7280; font-weight: 600; line-height: 1.1; white-space: nowrap;">@doc.DoctorQualification</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(doc.DoctorSpecialization))
                                        {
                                            <span class="doctor-specialty" style="font-size: 9.5px; color: #3b4588; font-weight: 800; text-transform: uppercase; line-height: 1; letter-spacing: 0.5px; background: rgba(59, 69, 136, 0.08); padding: 3px 6px; border-radius: 5px; border: 1px solid rgba(59, 69, 136, 0.15); margin-top: 1px;">@doc.DoctorSpecialization</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            var headerAnimClass = _isShowcaseVisible ? (_isShowcaseExiting ? "header-doc-animating-up" : "header-doc-animating-down") : "";
                            <div class="doc-block @headerAnimClass" style="display: flex; flex-direction: row; align-items: center; gap: 12px; animation-delay: 0.4s;">
                                <div style="width: 44px; height: 44px; border-radius: 50%; overflow: hidden; border: 2.5px solid #08552f; box-shadow: 0 2px 8px rgba(8, 85, 47, 0.25); flex-shrink: 0; background: #08552f; display: flex; align-items: center; justify-content: center;">
                                    <span style="color: white; font-weight: 800; font-size: 20px;">@(string.IsNullOrWhiteSpace(GetDoctorName()) ? "" : GetDoctorName().Substring(0, 1).ToUpper())</span>
                                </div>
                                <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 2px; text-align: left;">
                                    <div class="doc-line" style="display: flex; align-items: center; gap: 8px; justify-content: flex-start;">
                                        <span class="status-dot solid-green" style="width: 8px; height: 8px; box-shadow: 0 0 5px rgba(15, 139, 70, 0.5); flex-shrink: 0; border-radius: 50%; background: #0f8b46;"></span>
                                        <h2 class="doctor-name" style="font-size: 19px; font-weight: 800; color: #08552f; margin: 0; line-height: 1.1; white-space: nowrap;">@(GetDoctorName().StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? "" : "Dr. ")@GetDoctorName()</h2>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(GetDoctorCredentials()))
                                    {
                                        <span class="doctor-credentials" style="font-size: 12px; color: #6b7280; font-weight: 600; line-height: 1.1; white-space: nowrap;">@GetDoctorCredentials()</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(GetDoctorSpecialty()))
                                    {
                                        <span class="doctor-specialty" style="font-size: 9.5px; color: #3b4588; font-weight: 800; text-transform: uppercase; line-height: 1; letter-spacing: 0.5px; background: rgba(59, 69, 136, 0.08); padding: 3px 6px; border-radius: 5px; border: 1px solid rgba(59, 69, 136, 0.15); margin-top: 1px;">@GetDoctorSpecialty()</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="time-date-section" @ondblclick="ToggleAdminDrawer" title="Double click to configure">
                    <div class="date-widget" style="margin-right: 15px; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; line-height: 1.1;">
                        <div class="date-day" style="font-size: 14px; font-weight: 800; color: #172046;">@_now.ToString("dddd")</div>
                        <div class="date-full" style="font-size: 11px; font-weight: 700; color: #3b4588; text-transform: uppercase;">@_now.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="date-divider" style="width: 1px; height: 38px; background: rgba(0,0,0,0.15); margin-right: 15px;"></div>
                    <div class="time-widget">
                        <div class="time-display">
                            @_now.ToString("hh:mm")<span class="seconds">:@_now.ToString("ss")</span><span class="ampm">@_now.ToString("tt")</span>
                        </div>
                    </div>
                    <div class="clock-face-decor">
                        @{
                            double hourAngle = ((_now.Hour % 12) * 30.0) + (_now.Minute * 0.5);
                            double minuteAngle = (_now.Minute * 6.0) + (_now.Second * 0.1);
                            double secondAngle = _now.Second * 6.0;
                            string hRot = hourAngle.ToString(System.Globalization.CultureInfo.InvariantCulture);
                            string mRot = minuteAngle.ToString(System.Globalization.CultureInfo.InvariantCulture);
                            string sRot = secondAngle.ToString(System.Globalization.CultureInfo.InvariantCulture);
                        }
                        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: 100%;">
                            <!-- Outer Circle -->
                            <circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-width="2" opacity="0.2" />
                            
                            <!-- Major Ticks (12, 3, 6, 9) -->
                            <line x1="50" y1="8" x2="50" y2="16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.3" />
                            <line x1="92" y1="50" x2="84" y2="50" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.3" />
                            <line x1="50" y1="92" x2="50" y2="84" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.3" />
                            <line x1="8" y1="50" x2="16" y2="50" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.3" />

                            <!-- Sub Ticks -->
                            <line x1="50" y1="8" x2="50" y2="13" stroke="currentColor" stroke-width="1.5" opacity="0.15" transform="rotate(30 50 50)" />
                            <line x1="50" y1="8" x2="50" y2="13" stroke="currentColor" stroke-width="1.5" opacity="0.15" transform="rotate(60 50 50)" />
                            <line x1="50" y1="8" x2="50" y2="13" stroke="currentColor" stroke-width="1.5" opacity="0.15" transform="rotate(120 50 50)" />
                            <line x1="50" y1="8" x2="50" y2="13" stroke="currentColor" stroke-width="1.5" opacity="0.15" transform="rotate(150 50 50)" />
                            <line x1="50" y1="8" x2="50" y2="13" stroke="currentColor" stroke-width="1.5" opacity="0.15" transform="rotate(210 50 50)" />
                            <line x1="50" y1="8" x2="50" y2="13" stroke="currentColor" stroke-width="1.5" opacity="0.15" transform="rotate(240 50 50)" />
                            <line x1="50" y1="8" x2="50" y2="13" stroke="currentColor" stroke-width="1.5" opacity="0.15" transform="rotate(300 50 50)" />
                            <line x1="50" y1="8" x2="50" y2="13" stroke="currentColor" stroke-width="1.5" opacity="0.15" transform="rotate(330 50 50)" />

                            <!-- Hour Hand -->
                            <line x1="50" y1="50" x2="50" y2="28" stroke="#172046" stroke-width="3.5" stroke-linecap="round" opacity="0.6"
                                  transform="rotate(@hRot 50 50)" 
                                  style="transition: transform 0.4s ease;" />

                            <!-- Minute Hand -->
                            <line x1="50" y1="50" x2="50" y2="18" stroke="#172046" stroke-width="2.5" stroke-linecap="round" opacity="0.6"
                                  transform="rotate(@mRot 50 50)" 
                                  style="transition: transform 0.4s ease;" />

                            <!-- Second Hand -->
                            <line x1="50" y1="58" x2="50" y2="12" stroke="#0284c7" stroke-width="1.8" stroke-linecap="round" opacity="0.8"
                                  transform="rotate(@sRot 50 50)" 
                                  style="transition: transform 0.2s cubic-bezier(0.4, 2.08, 0.55, 0.44);" />

                            <!-- Center Pin -->
                            <circle cx="50" cy="50" r="3.5" fill="#172046" opacity="0.6" />
                            <circle cx="50" cy="50" r="1.5" fill="#0284c7" opacity="0.9" />
                        </svg>
                    </div>
                </div>
            </header>

            <!-- MAIN 2-COLUMN QUEUE LAYOUT -->
            <main class="main-layout">

                @{
                    var allQueue     = GetDisplayQueue();
                    var consultItems = allQueue.Where(i => i.ColorTheme == "green").ToList();
                    var queueItems   = allQueue.Where(i => i.ColorTheme == "orange" || i.ColorTheme == "blue" || i.ColorTheme == "purple").ToList();
                }

                <!-- LEFT: NOW CONSULTING HERO PANEL -->
                <section class="consultation-panel">
                    <div class="panel-title-bar green-bar" style="display: inline-flex; align-items: center; background: rgba(5, 150, 105, 0.1); border: 1.5px solid rgba(5, 150, 105, 0.3); color: #059669; border-radius: 20px; padding: 6px 16px; margin-bottom: 12px; font-size: 13px;">
                        <i class="bi bi-distribute-vertical me-2" style="font-size: 14px;"></i>
                        CONSULTATION
                    </div>

                    @if (consultItems.Any())
                    {
                        @foreach (var item in consultItems)
                        {
                            <div @key="@($"consult-{item.Patient.ogentryid}-{item.Patient.status}")" class="consult-card consult-entrance-premium @(item.Patient.ogentryid.HasValue && _callingOgEntryIds.Contains(item.Patient.ogentryid.Value) ? "calling-pulse-green" : "")">
                                <div class="consult-shimmer-sweep"></div>
                                <div class="consult-live-pill">
                                    <span class="pulse-beacon"></span>
                                    <span>NOW CONSULTING</span>
                                </div>
                                <div class="consult-token-box consult-token-bounce">
                                    <span class="consult-token-lbl">Token</span>
                                    <span class="consult-token-val">@item.Patient.og_token_no</span>
                                </div>
                                <div class="consult-info">
                                    <div class="consult-patient-name consult-name-fade">@item.Patient.DisplayName</div>
                                    <div class="consult-status-row consult-badge-bounce">
                                        @if (!string.IsNullOrEmpty(item.Patient.room_no))
                                        {
                                            <span class="consult-room-badge">
                                                <i class="bi bi-door-open-fill"></i>
                                                Room @item.Patient.room_no
                                            </span>
                                        }
                                        <span class="consult-time">
                                            <i class="bi bi-clock"></i>
                                            @item.Patient.DisplayTime
                                        </span>
                                    </div>
                                    <div class="consult-tag">
                                        @if (item.StatusText.Contains("|"))
                                        {
                                            var parts = item.StatusText.Split('|');
                                            <div class="status-marquee-container" style="color: var(--green);">
                                                <div class="status-marquee-track-ta">@parts[1].Trim()</div>
                                                <div class="status-marquee-track-en">@parts[0].Trim()</div>
                                            </div>
                                        }
                                        else
                                        {
                                            @item.StatusText
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="consult-empty">
                            <i class="bi bi-person-check-fill d-block mb-3"></i>
                            <span>No active consultation</span>
                        </div>
                    }
                </section>

                <!-- RIGHT: QUEUE PANEL (Unified Grid for Up Next + Waiting) -->
                <section class="queue-panel" style="display: flex; flex-direction: column; height: 100%;">
                    <div class="d-flex align-items-center mb-3" style="width: 100%; position: relative; padding-right: 15px;">
                        <div class="panel-title-bar amber-bar" style="display: inline-flex; align-items: center; background: rgba(245, 158, 11, 0.1); border: 1.5px solid rgba(245, 158, 11, 0.3); color: #d97706; border-radius: 20px; padding: 4px 12px; margin: 0; font-size: 10px; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase;">
                            <i class="bi bi-hash me-1" style="font-size: 12px;"></i> PATIENT QUEUE
                        </div>
                        <button class="btn btn-sm d-flex align-items-center gap-2 px-3 py-1.5" 
                                style="position: absolute; right: 15px; border-radius: 20px; background: #ffffff; border: 1px solid rgba(0,0,0,0.08); color: #2563eb; font-weight: 700; font-size: 11px; transition: all 0.2s ease; box-shadow: 0 2px 6px rgba(0,0,0,0.04); letter-spacing: 0.3px;"
                                @onclick="ToggleLayoutTheme" title="Switch View Mode (Grid / List)">
                            <i class="bi @(LayoutTheme == "grid" ? "bi-table" : "bi-grid-fill")" style="font-size: 13px;"></i>
                            <span>@(LayoutTheme == "grid" ? "List View" : "Grid View")</span>
                        </button>
                    </div>

                    @if (queueItems.Any())
                    {
                        @if (LayoutTheme == "table")
                        {
                            <div class="d-flex flex-column gap-3 w-100 flex-grow-1" style="overflow-y: auto; padding: 0.5rem 1.5rem;">
                                @foreach (var item in queueItems.Take(8))
                                {
                                    var isCalling = item.Patient.ogentryid.HasValue && _callingOgEntryIds.Contains(item.Patient.ogentryid.Value) && (item.ColorTheme == "orange" || item.ColorTheme == "purple");

                                    var rowClass = item.ColorTheme switch { "purple" => "purple-row", "orange" => "amber-row", _ => "blue-row" };

                                    var tokenClass = item.ColorTheme switch { "purple" => "purple-token", "orange" => "amber-token", _ => "blue-token" };

                                    var badgeClass = item.ColorTheme switch { "purple" => "badge-purple", "orange" => "badge-amber", _ => "badge-blue" };

                                    <div class="queue-row @rowClass fade-in-entry @(isCalling ? "calling-pulse-amber" : "")">
                                        <div class="row-token-box @tokenClass">
                                            <span class="row-token-val">@item.Patient.og_token_no</span>
                                        </div>
                                        <div class="row-name">
                                            @item.Patient.DisplayName
                                        </div>
