@code {
    // Theme and control configurations
    private bool _autoThemeSwitch = false;
    private bool _isDarkMode = false;
    private string LayoutTheme { get; set; } = "grid";
    private bool _isAdminOpen = false;
    private string _activeTab = "queue";
    private DateTime _now = DateTime.Now;
    private CancellationTokenSource _cts = new();
    private int _apiPollCounter = 0;

    private void ToggleLayoutTheme()
    {
        LayoutTheme = LayoutTheme == "grid" ? "table" : "grid";
    }

    private void ToggleColorTheme()
    {
        _autoThemeSwitch = false; 
        _isDarkMode = false;
    }

    // Signage details (Initialized to match the user uploaded image)
    public string HospitalName { get; set; } = "Nishanth Hospital";
    public string DoctorName { get; set; } = "Dr. Abhishant Padmanaban";
    public string DoctorCredentials { get; set; } = "";
    public string DoctorSpecialty { get; set; } = "";
    public string TickerMessage { get; set; } = "Kindly wait for your token number and follow directions. | Thank you! | டோக்கன் எண்ணுக்குக் காத்திருந்து அறிவுறுத்தல்களைப் பின்பற்றவும். நன்றி! | Thank you for choosing Nishanth Hospital.";

    private int? _selectedGroupId = null;

    private DoctorDisplayUnit? GetSelectedDoctorUnit()
    {
        if (_selectedGroupId.HasValue)
        {
            return GetAvailableDoctorUnits().FirstOrDefault(u => u.GroupId == _selectedGroupId.Value);
        }
        else if (_selectedDcode.HasValue)
        {
            return GetAvailableDoctorUnits().FirstOrDefault(u => u.Dcode == _selectedDcode.Value);
        }
        return null;
    }

    private string GetDoctorName()
    {
        var unit = GetSelectedDoctorUnit();
        if (unit != null) return unit.DisplayName;
        return DoctorName;
    }

    private string? GetDoctorCredentials()
    {
        var unit = GetSelectedDoctorUnit();
        if (unit != null) return unit.DisplayQualification;
        return !string.IsNullOrEmpty(DoctorCredentials) ? DoctorCredentials : null;
    }

    private string? GetDoctorSpecialty()
    {
        var unit = GetSelectedDoctorUnit();
        if (unit != null) return unit.DisplaySpecialization;
        return !string.IsNullOrEmpty(DoctorSpecialty) ? DoctorSpecialty : null;
    }

    private string GetSelectedDoctorRoomNo()
    {
        var unit = GetSelectedDoctorUnit();
        if (unit != null && unit.Doctors.Any())
        {
            var firstDoc = unit.Doctors.First();
            if (!string.IsNullOrEmpty(firstDoc.RoomNo)) return firstDoc.RoomNo;
        }

        if (_selectedDcode.HasValue)
        {
            var patient = _allPatients.FirstOrDefault(p => p.dcode == _selectedDcode.Value && !string.IsNullOrEmpty(p.room_no));
            if (patient != null && !string.IsNullOrEmpty(patient.room_no)) return patient.room_no;
            return _selectedDcode.Value.ToString();
        }

        return "1";
    }


    // Speech synthesis configuration parameters
    public string SelectedLanguage { get; set; } = "en-IN";
    public double SpeechRate { get; set; } = 0.9;
    public double SpeechPitch { get; set; } = 1.0;

    // Patient queues lists using OgQueueModel directly
    private List<OgQueueModel> _allPatients = new();
    private HashSet<int> _callingOgEntryIds = new();
    private string? _apiError;

    // Background cache for patient names fetched dynamically
    private Dictionary<string, string> _patientNamesCache = new(StringComparer.OrdinalIgnoreCase);
    // Guard: Prevents multiple concurrent mass-syncs to Labcare
    private bool _isHydratingNames = false;
    private async Task FetchPatientNameAsync()
    {
        // Stub to unbreak build
        await Task.CompletedTask;
    }

    // Computed lists from API queue
    private OgQueueModel? _ongoingPatient => _allPatients.FirstOrDefault(p => "in_consultation".Equals(p.status, StringComparison.OrdinalIgnoreCase) && !p.deleted);
    private IEnumerable<OgQueueModel> _reportPatients => _allPatients.Where(p => "waiting".Equals(p.status, StringComparison.OrdinalIgnoreCase) && ("report_received".Equals(p.vitals_status, StringComparison.OrdinalIgnoreCase) || "lab_scan".Equals(p.list_type, StringComparison.OrdinalIgnoreCase)) && !p.deleted);
    private IEnumerable<OgQueueModel> _waitingPatients => _allPatients.Where(p => "waiting".Equals(p.status, StringComparison.OrdinalIgnoreCase) && !"report_received".Equals(p.vitals_status, StringComparison.OrdinalIgnoreCase) && !"lab_scan".Equals(p.list_type, StringComparison.OrdinalIgnoreCase) && !p.deleted);

    // Call Overlay Patient State
    private OgQueueModel? _callingToken;
    private bool _showCallOverlay = false;
    private string _callingColorTheme = "green";

    // Doctor Selection variables
    public int? QueryDocCode { get; set; }

    private bool _hasSelectedDoctor = false;
    private int? _selectedDcode = null;
    private string _doctorSearchQuery = "";

    private void ClearDoctorSearch()
    {
        _doctorSearchQuery = "";
    }

    private class ConstituentDoctor
    {
        public int Dcode { get; set; }
        public string DoctorName { get; set; } = "";
        public string? DoctorQualification { get; set; }
        public string? DoctorSpecialization { get; set; }
        public string? RoomNo { get; set; }
        public string? DoctorImageUrl { get; set; }
    }

    private class DoctorDisplayUnit
    {
        public int? GroupId { get; set; }
        public string? GroupName { get; set; }
        public int? Dcode { get; set; } // Null if GroupId is present
        
        public string DisplayName { get; set; } = "";
        public string? DisplayQualification { get; set; }
        public string? DisplaySpecialization { get; set; }
        public string? DisplayImageUrl { get; set; }
        public int TokenCount { get; set; }
        
        public List<ConstituentDoctor> Doctors { get; set; } = new();
    }

    private class TempDoctorInfo
    {
        public int Dcode { get; set; }
        public string DoctorName { get; set; } = "";
        public string? DoctorQualification { get; set; }
        public string? DoctorSpecialization { get; set; }
        public int? GroupId { get; set; }
        public string? GroupName { get; set; }
        public string? RoomNo { get; set; }
        public string? DoctorImageUrl { get; set; }
        public List<OgQueueModel> Tokens { get; set; } = new();
    }

    private List<DoctorDisplayUnit> GetAvailableDoctorUnits()
    {
        var activePatients = _allPatients
            .Where(p => !p.deleted && 
                        !"completed".Equals(p.status, StringComparison.OrdinalIgnoreCase))
            .ToList();

        var doctors = activePatients
            .GroupBy(p => p.dcode ?? 0)
            .Select(g => {
                int dcodeKey = g.Key;
                _doctorMasterDict.TryGetValue(dcodeKey, out var masterDoc);

                var firstWithDocName = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.doctor_name));
                var firstWithQual = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.doctor_qualification));
                var firstWithSpec = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.doctor_specialization));
                var firstWithGroupId = g.FirstOrDefault(x => x.group_id.HasValue);
                var firstWithGroupName = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.group_name));
                var firstWithRoom = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.room_no));

                string docName = masterDoc?.GetFormattedName() 
                    ?? firstWithDocName?.doctor_name 
                    ?? $"Doctor {dcodeKey}";

                string? qual = !string.IsNullOrWhiteSpace(masterDoc?.qualification) 
                    ? masterDoc.qualification 
                    : firstWithQual?.doctor_qualification;

                string? room = masterDoc?.room_no != null 
                    ? masterDoc.room_no.Value.ToString() 
                    : firstWithRoom?.room_no;

                int? groupId = (int?)masterDoc?.group_id ?? firstWithGroupId?.group_id;

                string? imageUrl = masterDoc != null ? (masterDoc.DoctorImageBase64 ?? GetDoctorImageUrl(masterDoc.doctorimage)) : null;

                return new TempDoctorInfo
                {
                    Dcode = dcodeKey,
                    DoctorName = docName,
                    DoctorQualification = qual,
                    DoctorSpecialization = firstWithSpec?.doctor_specialization,
                    GroupId = groupId,
                    GroupName = firstWithGroupName?.group_name,
                    RoomNo = room,
                    DoctorImageUrl = imageUrl,
                    Tokens = g.ToList()
                };
            })
            .ToList();

        var units = new List<DoctorDisplayUnit>();

        // 1. Grouped by GroupId
        var groups = doctors.Where(d => d.GroupId.HasValue).GroupBy(d => d.GroupId!.Value);
        foreach (var gp in groups)
        {
            var list = gp.ToList();
            var groupName = list.FirstOrDefault(d => !string.IsNullOrEmpty(d.GroupName))?.GroupName ?? $"Group {gp.Key}";
            
            var combinedName = string.Join(" & ", list.Select(d => d.DoctorName));
            var combinedQual = string.Join(", ", list.Where(d => !string.IsNullOrEmpty(d.DoctorQualification)).Select(d => d.DoctorQualification).Distinct());
            var combinedSpec = string.Join(", ", list.Where(d => !string.IsNullOrEmpty(d.DoctorSpecialization)).Select(d => d.DoctorSpecialization).Distinct());
            var displayImg = list.FirstOrDefault(d => !string.IsNullOrEmpty(d.DoctorImageUrl))?.DoctorImageUrl;

            units.Add(new DoctorDisplayUnit
            {
                GroupId = gp.Key,
                GroupName = groupName,
                DisplayName = combinedName,
                DisplayQualification = combinedQual,
                DisplaySpecialization = combinedSpec,
                DisplayImageUrl = displayImg,
                TokenCount = list.Sum(d => d.Tokens.Count),
                Doctors = list.Select(d => new ConstituentDoctor
                {
                    Dcode = d.Dcode,
                    DoctorName = d.DoctorName,
                    DoctorQualification = d.DoctorQualification,
                    DoctorSpecialization = d.DoctorSpecialization,
                    RoomNo = d.RoomNo,
                    DoctorImageUrl = d.DoctorImageUrl
                }).ToList()
            });
        }

        // 2. Individual doctors with null GroupId
        var individualDocs = doctors.Where(d => !d.GroupId.HasValue);
        foreach (var d in individualDocs)
        {
            units.Add(new DoctorDisplayUnit
            {
                GroupId = null,
                GroupName = null,
                Dcode = d.Dcode,
                DisplayName = d.DoctorName,
                DisplayQualification = d.DoctorQualification,
                DisplaySpecialization = d.DoctorSpecialization,
                DisplayImageUrl = d.DoctorImageUrl,
                TokenCount = d.Tokens.Count,
                Doctors = new List<ConstituentDoctor>
                {
                    new ConstituentDoctor
                    {
                        Dcode = d.Dcode,
                        DoctorName = d.DoctorName,
                        DoctorQualification = d.DoctorQualification,
                        DoctorSpecialization = d.DoctorSpecialization,
                        RoomNo = d.RoomNo,
                        DoctorImageUrl = d.DoctorImageUrl
                    }
                }
            });
        }

        return units.OrderByDescending(u => u.TokenCount).ToList();
    }

    private void SelectUnitToDisplay(DoctorDisplayUnit unit)
    {
        if (unit.GroupId.HasValue)
        {
            _selectedGroupId = unit.GroupId;
            _selectedDcode = null;
        }
        else
        {
