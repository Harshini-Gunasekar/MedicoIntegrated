                        <label class="form-label small fw-bold">Credentials</label>
                        <input type="text" class="form-control form-control-sm" @bind="DoctorCredentials" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Designation/Specialty</label>
                        <input type="text" class="form-control form-control-sm" @bind="DoctorSpecialty" />
                    </div>
                </div>

                <div class="mb-4 border-top border-secondary pt-3">
                    <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-soundwave"></i> Voice Announcement Parameters</h6>
                    
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Voice Accent/Language</label>
                            <select class="form-select form-select-sm" @bind="SelectedLanguage">
                                <option value="en-IN">Indian English (en-IN)</option>
                                <option value="en-US">US English (en-US)</option>
                                <option value="ta-IN">Tamil (ta-IN)</option>
