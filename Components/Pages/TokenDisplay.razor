    // Computed lists from API queue
    private OgQueueModel? _ongoingPatient => _allPatients.FirstOrDefault(p => "in_consultation".Equals(p.status, StringComparison.OrdinalIgnoreCase) && !p.deleted);
    private IEnumerable<OgQueueModel> _reportPatients => _allPatients.Where(p => "waiting".Equals(p.status, StringComparison.OrdinalIgnoreCase) && ("report_received".Equals(p.vitals_status, StringComparison.OrdinalIgnoreCase) || "lab_scan".Equals(p.list_type, StringComparison.OrdinalIgnoreCase)) && !p.deleted);
    private IEnumerable<OgQueueModel> _waitingPatients => _allPatients.Where(p => "waiting".Equals(p.status, StringComparison.OrdinalIgnoreCase) && !"report_received".Equals(p.vitals_status, StringComparison.OrdinalIgnoreCase) && !"lab_scan".Equals(p.list_type, StringComparison.OrdinalIgnoreCase) && !p.deleted);

    // Call Overlay Patient State
    private OgQueueModel? _callingToken;
    private bool _showCallOverlay = false;
    private string _callingColorTheme = "green";

    // Doctor Selection variables
    public int? QueryDocCode { get; set; }

    // Tenant Code
    public string TenantCode { get; set; } = "0010";

