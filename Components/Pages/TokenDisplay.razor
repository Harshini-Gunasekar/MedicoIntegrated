                                    </div>

                                    <div class="d-flex gap-1">
                                        <!-- CALL AND AUDIO ANNOUNCEMENT -->
                                        <button class="btn btn-sm btn-success" @onclick="() => CallToken(p)" title="Call Out Voice Announcement">
                                            <i class="bi bi-volume-up-fill"></i> Call
                                        </button>

                                        <!-- CHANGE STATUS SELECT DYNAMICALLY -->
                                        <select class="form-select form-select-sm py-0 px-2" style="width: 100px; font-size: 12px; height: 31px;"
                                                value="@(p.status == "in_consultation" ? "OngoingConsultation" : (p.entry_type == "test_completed" ? "ReadyForReview" : (p.entry_type == "vitals" ? "VitalsCheck" : "Waiting")))"
                                                @onchange="@((ChangeEventArgs e) => UpdatePatientStatus(p, e.Value?.ToString() ?? string.Empty))">
                                            <option value="Waiting">Waiting</option>
                                            <option value="VitalsCheck">Vitals</option>
                                            <option value="OngoingConsultation">Ongoing</option>
                                            <option value="ReadyForReview">Review</option>
