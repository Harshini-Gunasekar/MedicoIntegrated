    private List<PatientQueueDisplayItem> GetDisplayQueue()
    {
        var displayList = new List<PatientQueueDisplayItem>();

        // ── RULE: Exclude 'completed' and 'deleted' patients entirely ──────────
        // ── ALSO: Filter by Selected Doctor if one is chosen ──────────
        var activePatients = _allPatients
            .Where(p => !p.deleted &&
                        !"completed".Equals(p.status, StringComparison.OrdinalIgnoreCase) &&
                        (_selectedGroupId.HasValue ? p.group_id == _selectedGroupId.Value : (_selectedDcode == null || p.dcode == _selectedDcode)) &&
                        ("waiting".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                         "in_consultation".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                         "up-next".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                         "up_next".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                         "upnext".Equals(p.status, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(p => p.token_sort ?? 999)
            .ToList();

        // ── 1. GREEN: In Consultation ──────────────────────────────────────────
        var consulting = activePatients
            .Where(p => "in_consultation".Equals(p.status, StringComparison.OrdinalIgnoreCase))
            .ToList();

        foreach (var p in consulting)
        {
            bool isReport = "lab_scan".Equals(p.list_type, StringComparison.OrdinalIgnoreCase) ||
                            "report_received".Equals(p.vitals_status, StringComparison.OrdinalIgnoreCase) ||
                            p.entry_type == "test_completed";

            displayList.Add(new PatientQueueDisplayItem
            {
                Patient       = p,
                ColorTheme    = "green",
                StatusText    = isReport ? "REPORT REVIEW|அறிக்கை பரிசோதனையில்" : "IN CONSULTATION|மருத்துவர் பரிசோதனையில்",
                StatusSubtext = isReport ? "Reviewing Lab Reports" : (!string.IsNullOrEmpty(p.room_no) ? $"Room {p.room_no}" : "Consultation")
            });
        }

        // ── 2. ORANGE (Up Next) + BLUE (Waiting) ──────────────────────────────
        // Explicit 'up_next' from API come first, then waiting ordered by token_sort
        var upNextFromApi = activePatients
            .Where(p => "up-next".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                        "up_next".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                        "upnext".Equals(p.status, StringComparison.OrdinalIgnoreCase))
            .ToList();

        var waitingOnly = activePatients
            .Where(p => "waiting".Equals(p.status, StringComparison.OrdinalIgnoreCase))
            .ToList();

        // Merge: explicit up-next first, then waiting ordered by token_sort
        var orderedQueue = upNextFromApi.Concat(waitingOnly).ToList();

        for (int i = 0; i < orderedQueue.Count; i++)
        {
            var p = orderedQueue[i];
            bool isLabScan = "lab_scan".Equals(p.list_type, StringComparison.OrdinalIgnoreCase);
            bool isReport = isLabScan ||
                            "report_received".Equals(p.vitals_status, StringComparison.OrdinalIgnoreCase) ||
                            p.entry_type == "test_completed";

            bool isUpNext = "up-next".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                            "up_next".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                            "upnext".Equals(p.status, StringComparison.OrdinalIgnoreCase);

            if (isLabScan)
            {
                // ── PURPLE: Lab Scan ──
                displayList.Add(new PatientQueueDisplayItem
                {
                    Patient       = p,
                    ColorTheme    = "purple",
                    StatusText    = "LAB SCAN REPORT|ஆய்வக அறிக்கை தயார்",
                    StatusSubtext = "Lab scan report ready for review"
                });
            }
            else if (isUpNext)
            {
                // ── ORANGE: Up Next ──
                displayList.Add(new PatientQueueDisplayItem
                {
                    Patient       = p,
                    ColorTheme    = "orange",
                    StatusText    = isReport          ? "WAITING FOR REPORT|ஆய்வக அறிக்கைக்காக காத்திருக்கவும்"
                                  : p.entry_type == "vitals" ? "VITALS CHECK|உடல்நிலை பரிசோதனை"
                                  : "NEXT IN LINE|அடுத்து நீங்கள் செல்லவும்",
                    StatusSubtext = isReport          ? "Report ready for review"
                                  : p.entry_type == "vitals" ? "Vitals check next"
                                  : "Please prepare to enter"
                });
            }
            else
            {
                // ── BLUE: Waiting ──
                displayList.Add(new PatientQueueDisplayItem
                {
                    Patient       = p,
                    ColorTheme    = "blue",
                    StatusText    = isReport          ? "WAITING FOR REPORT|ஆய்வக அறிக்கைக்காக காத்திருக்கவும்"
                                  : p.entry_type == "vitals" ? "VITALS CHECK|உடல்நிலை பரிசோதனை"
                                  : "WAITING|காத்திருக்கவும்",
                    StatusSubtext = isReport          ? "Report pending review"
                                  : p.entry_type == "vitals" ? "Vitals check pending"
                                  : "Waiting in lounge"
                });
            }
        }

        return displayList;
    }

    public class PatientQueueDisplayItem
    {
        public OgQueueModel Patient { get; set; } = null!;
        public string ColorTheme { get; set; } = "blue"; // green | orange | blue
        public string StatusText { get; set; } = "";
        public string StatusSubtext { get; set; } = "";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
