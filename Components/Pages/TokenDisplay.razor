                    </div>
                </div>

                <!-- CURRENT QUEUE LIST WITH QUICK CONTROL ACTIONS -->
                <div>
                    <h6 class="fw-bold mb-3 text-white"><i class="bi bi-bezier2"></i> Active Queue Actions</h6>
                    @if (_apiError != null)
                    {
                        <div class="alert alert-warning py-1 px-2 small mb-2">
                            <i class="bi bi-wifi-off"></i> API Connection Offline. Showing local data.
                        </div>
                    }
                    
                    @if (_allPatients.Any())
                    {
                        <div class="list-group list-group-flush border border-secondary rounded overflow-hidden">
                            @foreach (var p in _allPatients)
                            {
                                <div class="list-group-item p-3 d-flex align-items-center justify-content-between bg-dark border-bottom border-secondary text-white">
                                    <div>
                                        <span class="badge bg-secondary me-2">#@p.og_token_no</span>
                                        <strong>@p.DisplayName</strong>
                                        
                                        <div class="small text-muted mt-1">
                                            Status: @p.status | Entry: @p.entry_type 
                                            @(p.dcode != null ? $" | Doc Code: {p.dcode}" : "")
