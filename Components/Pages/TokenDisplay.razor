    // Background cache for patient names fetched dynamically
    private Dictionary<string, string> _patientNamesCache = new(StringComparer.OrdinalIgnoreCase);
    // Guard: Prevents multiple concurrent mass-syncs to Labcare
    private bool _isHydratingNames = false;
    private async Task FetchPatientNameAsync()
    {
