@page "/token-display"
@rendermode InteractiveServer
@using Hospital_display.Models
@layout SharedComponents.Rcl.Components.Layout.EmptyLayout
@implements IDisposable
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavManager

<PageTitle>Hospital Token Display Signage</PageTitle>

<div>

    @if (!_hasSelectedDoctor && !_isAdminOpen)
    {
        <!-- DOCTOR SELECTION SCREEN -->
        <div class="kiosk-display justify-content-center align-items-center">
            <div class="doc-select-screen">
                <div class="doc-select-header">
                    <h1 class="doc-select-title">
                        <i class="bi bi-display"></i> Select Display Doctor
                    </h1>
                    <p class="doc-select-subtitle">Tap a doctor below to load their specific token queue.</p>
                </div>

                <!-- SEARCH NAME FILTER -->
                <div class="d-flex justify-content-center mb-4">
                    <div class="doc-search-wrapper">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" class="form-control doc-search-input" 
                               placeholder="Filter doctor by name..." 
                               @bind-value="_doctorSearchQuery" 
                               @bind-value:event="oninput" />
                        @if (!string.IsNullOrEmpty(_doctorSearchQuery))
                        {
                            <button class="doc-search-clear" type="button" @onclick="ClearDoctorSearch" aria-label="Clear Search">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>
                </div>
                
                @{
                    var docs = GetAvailableDoctors();
                    if (!string.IsNullOrWhiteSpace(_doctorSearchQuery))
                    {
                        docs = docs.Where(d => d.DoctorName.Contains(_doctorSearchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
                    }
                }
                @if (docs.Any())
                {
                    <div class="doc-select-grid">
                        @foreach (var doc in docs)
                        {
                            <div class="doc-select-card" @onclick='() => SelectDoctorToDisplay(doc.Dcode, doc.DoctorName)'>
                                <div class="doc-avatar-wrapper">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <h2 class="doc-select-name">@doc.DoctorName</h2>
                                @if(doc.Dcode != null)
                                {
                                    <div class="doc-select-code">Code: @doc.Dcode</div>
                                }
                                <div class="doc-patient-badge">
                                    <span class="pulse-dot"></span>
                                    <span>@doc.TokenCount Patients Waiting</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-center">
                        <div class="no-docs-card">
                            @if (!string.IsNullOrWhiteSpace(_doctorSearchQuery))
                            {
                                <i class="bi bi-search fs-2 mb-3 d-block"></i>
                                <h3 class="fw-bold mb-2">No Matching Doctors</h3>
                                <p class="mb-4 fs-6">We couldn't find any doctor matching "@_doctorSearchQuery".</p>
                                <button class="btn btn-outline-info px-4 py-2" @onclick="ClearDoctorSearch">
                                    Clear Filter
                                </button>
                            }
                            else
                            {
                                <i class="bi bi-inbox"></i>
                                <h3 class="fw-bold mb-2">No Active Doctors Found</h3>
                                <p class="mb-4 fs-6">There are currently no patients waiting in the system.<br/>Wait for tokens to be generated or open settings.</p>
                                <div class="d-flex justify-content-center gap-2 mt-3">
                                    <button class="btn btn-outline-info px-4 py-2" @onclick="ToggleAdminDrawer">
                                        <i class="bi bi-sliders"></i> Open Settings
                                    </button>
                                    <button class="btn btn-link text-muted" @onclick='() => SelectDoctorToDisplay(null, "All Doctors")'>
                                        Show Empty Display
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
    <!-- FULLSCREEN KIOSK DISPLAY COVERING THE PAGE -->
    <div class="kiosk-display">
        <div class="glass-panel">
            
            <!-- HEADER SECTION -->
            <header class="signage-header image-style-header">
                <!-- Inner curved glass shapes -->
                <div class="header-glass-bg">
                    <div class="glass-layer-1"></div>
                    <div class="glass-layer-2"></div>
                </div>

                <div class="logo-section" @ondblclick="ToggleAdminDrawer" title="Double click to configure">
                    <div style="overflow: hidden; width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; margin-right: -6px; flex-shrink: 0;">
                        <img src="images/output-smallpngtools.png" alt="Hospital Logo" style="height: 90px; width: 90px; object-fit: cover; transform: scale(1.4); flex-shrink: 0;" />
                    </div>
                    <div class="hospital-name">
                        @HospitalName
                        <span>Patient Care Signage</span>
                    </div>
                </div>

                <div class="doctor-plate" @ondblclick="ClearDoctorSelection" style="cursor: pointer;" title="Double click to change doctor">
                    <div class="doc-info-list">
                        <div class="doc-line">
                            <span class="status-dot solid-green"></span>
                            <h2 class="doctor-name">@GetDoctorName()</h2>
                            @if (!string.IsNullOrWhiteSpace(GetDoctorCredentials()))
                            {
                                <span class="doctor-credentials ms-2">@GetDoctorCredentials()</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(GetDoctorSpecialty()))
                        {
                            <div class="doc-line">
                                <span class="status-dot ring-gold"></span>
                                <span class="doctor-specialty">@GetDoctorSpecialty()</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="time-date-section" @ondblclick="ToggleAdminDrawer" title="Double click to configure">
                    <div class="date-widget" style="margin-right: 15px; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; line-height: 1.1;">
                        <div class="date-day" style="font-size: 14px; font-weight: 800; color: #172046;">@_now.ToString("dddd")</div>
                        <div class="date-full" style="font-size: 11px; font-weight: 700; color: #3b4588; text-transform: uppercase;">@_now.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="date-divider" style="width: 1px; height: 38px; background: rgba(0,0,0,0.15); margin-right: 15px;"></div>
                    <div class="time-widget">
                        <div class="time-display">
                            @_now.ToString("hh:mm")<span class="seconds">:@_now.ToString("ss")</span><span class="ampm">@_now.ToString("tt")</span>
                        </div>
                    </div>
                    <div class="clock-face-decor">
                        <img src="data:image/svg+xml;utf8,<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'><circle cx='50' cy='50' r='46' fill='none' stroke='black' stroke-width='2' opacity='0.3'/><line x1='50' y1='10' x2='50' y2='20' stroke='black' stroke-width='2' opacity='0.3'/><line x1='90' y1='50' x2='80' y2='50' stroke='black' stroke-width='2' opacity='0.3'/><line x1='50' y1='90' x2='50' y2='80' stroke='black' stroke-width='2' opacity='0.3'/><line x1='10' y1='50' x2='20' y2='50' stroke='black' stroke-width='2' opacity='0.3'/><path d='M50 50 L65 35' stroke='black' stroke-width='2' opacity='0.3'/><path d='M50 50 L55 70' stroke='black' stroke-width='2' opacity='0.3'/><circle cx='50' cy='50' r='4' fill='black' opacity='0.3'/></svg>" alt="clock" />
                    </div>
                    <!-- Quick UI Theme Toggles -->
                    <div class="ui-theme-controls d-flex align-items-center gap-2 ms-4 z-3" @ondblclick:stopPropagation="true">
                        <button class="btn btn-sm shadow-sm p-0" style="width: 42px; height: 42px; border-radius: 50%; background: @(_isDarkMode ? "rgba(255,255,255,0.1)" : "rgba(0,0,0,0.04)"); border: 1px solid @(_isDarkMode ? "rgba(255,255,255,0.2)" : "rgba(0,0,0,0.1)"); color: @(_isDarkMode ? "rgba(255,255,255,0.9)" : "rgba(0,0,0,0.7)"); display: flex; align-items: center; justify-content: center; transition: all 0.2s ease;" 
                                @onclick="ToggleLayoutTheme" title="Switch Queue Style">
                            <i class="bi @(LayoutTheme == "grid" ? "bi-table" : "bi-grid-fill") fs-5"></i>
                        </button>
                    </div>
                </div>
            </header>

            <!-- MAIN 2-COLUMN QUEUE LAYOUT -->
            <main class="main-layout">

                @{
                    var allQueue     = GetDisplayQueue();
                    var consultItems = allQueue.Where(i => i.ColorTheme == "green").ToList();
                    var queueItems   = allQueue.Where(i => i.ColorTheme == "orange" || i.ColorTheme == "blue" || i.ColorTheme == "purple").ToList();
                }

                <!-- LEFT: NOW CONSULTING HERO PANEL -->
                <section class="consultation-panel">
                    <div class="panel-title-bar green-bar">
                        <span class="sound-wave-active me-2">
                            <span></span><span></span><span></span>
                        </span>
                        CONSULTATION
                    </div>

                    @if (consultItems.Any())
                    {
                        @foreach (var item in consultItems)
                        {
                            <div class="consult-card @(item.Patient.ogentryid.HasValue && _callingOgEntryIds.Contains(item.Patient.ogentryid.Value) ? "calling-pulse-green" : "")">
                                <div class="consult-token-box">
                                    <span class="consult-token-lbl">Token</span>
                                    <span class="consult-token-val">@item.Patient.og_token_no</span>
                                </div>
                                <div class="consult-info">
                                    @* @if (!string.IsNullOrEmpty(item.Patient.custcode) && item.Patient.custcode != item.Patient.DisplayName)
                                    {
                                        <div class="consult-patient-id">ID: @item.Patient.custcode</div>
                                    } *@
                                    <div class="consult-patient-name">@item.Patient.DisplayName</div>
                                    <div class="consult-status-row">
                                        <span class="consult-room-badge">
                                            <i class="bi bi-door-open-fill"></i>
                                            Room @(item.Patient.dcode ?? 1)
                                        </span>
                                        <span class="consult-time">
                                            <i class="bi bi-clock"></i>
                                            @item.Patient.DisplayTime
                                        </span>
                                    </div>
                                    <div class="consult-tag">
                                        @if (item.StatusText.Contains("|"))
                                        {
                                            var parts = item.StatusText.Split('|');
                                            <div class="status-marquee-container" style="color: var(--green);">
                                                <div class="status-marquee-track-ta">@parts[1].Trim()</div>
                                                <div class="status-marquee-track-en">@parts[0].Trim()</div>
                                            </div>
                                        }
                                        else
                                        {
                                            @item.StatusText
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="consult-empty">
                            <i class="bi bi-person-check-fill d-block mb-3"></i>
                            <span>No active consultation</span>
                        </div>
                    }
                </section>

                <!-- RIGHT: QUEUE PANEL (Unified Grid for Up Next + Waiting) -->
                <section class="queue-panel">

                    @if (queueItems.Any())
                    {
                        @if (LayoutTheme == "table")
                        {
                            <div class="d-flex flex-column gap-3 w-100 flex-grow-1" style="overflow-y: auto; padding: 0.5rem 1.5rem;">
                                @foreach (var item in queueItems.Take(8))
                                {
                                    var isCalling = item.Patient.ogentryid.HasValue && _callingOgEntryIds.Contains(item.Patient.ogentryid.Value) && (item.ColorTheme == "orange" || item.ColorTheme == "purple");

                                    var rowClass = item.ColorTheme switch { "purple" => "purple-row", "orange" => "amber-row", _ => "blue-row" };

                                    var tokenClass = item.ColorTheme switch { "purple" => "purple-token", "orange" => "amber-token", _ => "blue-token" };

                                    var badgeClass = item.ColorTheme switch { "purple" => "badge-purple", "orange" => "badge-amber", _ => "badge-blue" };

                                    <div class="queue-row @rowClass fade-in-entry @(isCalling ? "calling-pulse-amber" : "")">
                                        <div class="row-token-box @tokenClass">
                                            <span class="row-token-val">@item.Patient.og_token_no</span>
                                        </div>
                                        <div class="row-name">
                                            @item.Patient.DisplayName
                                        </div>
                                        <div class="row-time">
                                            <i class="bi bi-clock"></i> @item.Patient.DisplayTime
                                        </div>
                                        <div class="row-status">
                                            <span class="row-badge @badgeClass">
                                                @if (item.StatusText.Contains("|"))
                                                {
                                                    var parts = item.StatusText.Split('|');
                                                    <div class="status-marquee-container">
                                                        <div class="status-marquee-track-ta">@parts[1].Trim()</div>
                                                        <div class="status-marquee-track-en">@parts[0].Trim()</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @item.StatusText
                                                }
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="queue-grid" style="margin-bottom: 0.5rem;">
                                @foreach (var item in queueItems.Take(8))
                                {
                                    if (item.ColorTheme == "orange")
                                    {
                                        <div class="queue-card amber-card fade-in-entry @(item.Patient.ogentryid.HasValue && _callingOgEntryIds.Contains(item.Patient.ogentryid.Value) ? "calling-pulse-amber" : "")">
                                            <div class="card-token-box">
                                                <span class="card-token-lbl">Token</span>
                                                <span class="card-token-val">@item.Patient.og_token_no</span>
                                            </div>
                                            <div class="card-info d-flex flex-column align-items-center gap-1">
                                                <span class="card-name w-100 text-truncate text-center">@item.Patient.DisplayName</span>
                                                @* @if (!string.IsNullOrEmpty(item.Patient.custcode) && item.Patient.custcode != item.Patient.DisplayName)
                                                {
                                                    <span class="card-patient-id text-truncate" style="max-width: 140px;">@item.Patient.custcode</span>
                                                } *@
                                                <span class="card-time"><i class="bi bi-clock"></i> @item.Patient.DisplayTime</span>
                                            </div>
                                            <div class="card-status-badge">
                                                @if (item.StatusText.Contains("|"))
                                                {
                                                    var parts = item.StatusText.Split('|');
                                                    <div class="status-marquee-container">
                                                        <div class="status-marquee-track-ta">@parts[1].Trim()</div>
                                                        <div class="status-marquee-track-en">@parts[0].Trim()</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @item.StatusText
                                                }
                                            </div>
                                        </div>
                                    }
                                    else if (item.ColorTheme == "purple")
                                    {
                                        <div class="queue-card purple-card fade-in-entry @(item.Patient.ogentryid.HasValue && _callingOgEntryIds.Contains(item.Patient.ogentryid.Value) ? "calling-pulse-purple" : "")">
                                            <div class="card-token-box">
                                                <span class="card-token-lbl">Token</span>
                                                <span class="card-token-val">@item.Patient.og_token_no</span>
                                            </div>
                                            <div class="card-info d-flex flex-column align-items-center gap-1">
                                                <span class="card-name w-100 text-truncate text-center">@item.Patient.DisplayName</span>
                                                <span class="card-time"><i class="bi bi-clock"></i> @item.Patient.DisplayTime</span>
                                            </div>
                                            <div class="card-status-badge">
                                                @if (item.StatusText.Contains("|"))
                                                {
                                                    var parts = item.StatusText.Split('|');
                                                    <div class="status-marquee-container">
                                                        <div class="status-marquee-track-ta">@parts[1].Trim()</div>
                                                        <div class="status-marquee-track-en">@parts[0].Trim()</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @item.StatusText
                                                }
                                            </div>
                                        </div>
                                    }
                                    else if (item.ColorTheme == "blue")
                                    {
                                        <div class="queue-card blue-card fade-in-entry">
                                            <div class="card-token-box">
                                                <span class="card-token-lbl">Token</span>
                                                <span class="card-token-val">@item.Patient.og_token_no</span>
                                            </div>
                                            <div class="card-info d-flex flex-column align-items-center gap-1">
                                                <span class="card-name w-100 text-truncate text-center">@item.Patient.DisplayName</span>
                                                @* @if (!string.IsNullOrEmpty(item.Patient.custcode) && item.Patient.custcode != item.Patient.DisplayName)
                                                {
                                                    <span class="card-patient-id text-truncate" style="max-width: 140px;">@item.Patient.custcode</span>
                                                } *@
                                                <span class="card-time"><i class="bi bi-clock"></i> @item.Patient.DisplayTime</span>
                                            </div>
                                            <div class="card-status-badge">
                                                @if (item.StatusText.Contains("|"))
                                                {
                                                    var parts = item.StatusText.Split('|');
                                                    <div class="status-marquee-container">
                                                        <div class="status-marquee-track-ta">@parts[1].Trim()</div>
                                                        <div class="status-marquee-track-en">@parts[0].Trim()</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @item.StatusText
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="queue-empty">
                            <i class="bi bi-people fs-2 mb-2 d-block opacity-25"></i>
                            <span>Queue is empty</span>
                        </div>
                    }

                    <!-- Status Legend Guide (Moved to right panel) -->
                    <div class="status-legend mt-auto align-self-end">
                        <div class="legend-item legend-green">
                            <span class="legend-color-box"></span>
                            <div class="legend-text">
                                <span class="lang-ta">மருத்துவர் பரிசோதனையில்</span>
                                <span class="lang-en">Consulting</span>
                            </div>
                        </div>
                        <div class="legend-item legend-amber">
                            <span class="legend-color-box"></span>
                            <div class="legend-text">
                                <span class="lang-ta">அடுத்து நீங்கள் செல்லவும்</span>
                                <span class="lang-en">Up Next</span>
                            </div>
                        </div>
                        <div class="legend-item legend-purple">
                            <span class="legend-color-box"></span>
                            <div class="legend-text">
                                <span class="lang-ta">ஆய்வக அறிக்கை தயார்</span>
                                <span class="lang-en">Lab / Scan Ready</span>
                            </div>
                        </div>
                        <div class="legend-item legend-blue">
                            <span class="legend-color-box"></span>
                            <div class="legend-text">
                                <span class="lang-ta">காத்திருக்கவும்</span>
                                <span class="lang-en">Waiting</span>
                            </div>
                        </div>
                    </div>

                </section>
            </main>

            <!-- FOOTER NEWS TICKER AND NOTICES -->
            <footer class="signage-footer">
                <div class="patience-notice">
                    <i class="bi bi-megaphone-fill text-warning fs-5"></i>
                    <span>Thank you for your patience</span>
                </div>

                <div class="ticker-wrap ms-auto">
                    <div class="ticker-marquee">
                        @TickerMessage
                    </div>
                </div>
            </footer>
        </div>
    </div>
    }

    <!-- SPEAK VOICE / CALL OVERLAY POPUP FOR ANNOUNCEMENTS -->
    <div class="overlay-notification @(_showCallOverlay ? "show-call" : "") overlay-@_callingColorTheme">
        @if (_callingToken != null)
        {
            <div class="overlay-token-header">
                <i class="bi bi-volume-up-fill me-2 anim-pulse"></i> Now Calling
            </div>
            <div class="overlay-token-number">
                @_callingToken.og_token_no
            </div>
            <div class="overlay-patient-name">
                @_callingToken.DisplayName
            </div>
            <div class="overlay-room">
                @if (_callingToken.status == "in_consultation")
                {
                    <i class="bi bi-box-arrow-in-right me-2"></i><span>Proceed to Room @(_callingToken.dcode ?? 1)</span>
                }
                else if (_callingToken.entry_type == "vitals")
                {
                    <i class="bi bi-heart-pulse-fill me-2"></i><span>Proceed to Vitals Check</span>
                }
                else if (_callingToken.entry_type == "test_completed" || "lab_scan".Equals(_callingToken.list_type, StringComparison.OrdinalIgnoreCase) || "report_received".Equals(_callingToken.vitals_status, StringComparison.OrdinalIgnoreCase))
                {
                    <i class="bi bi-clipboard2-pulse me-2"></i><span>Report Review</span>
                }
            </div>
        }
    </div>


    @* <!-- ADMIN CONSOLE SLIDE OUT PANEL -->
    <div class="admin-drawer @(_isAdminOpen ? "" : "slide-closed")">
        <div class="admin-drawer-header">
            <h5 class="m-0 fw-bold"><i class="bi bi-sliders"></i> Clinic Control Board</h5>
            <button class="btn-close btn-close-white" @onclick="ToggleAdminDrawer" aria-label="Close"></button>
        </div>

        <div class="admin-drawer-body">
            
            <!-- Quick System Operations -->
            <div class="d-flex gap-2 mb-4">
                <button class="btn btn-sm btn-outline-primary flex-grow-1" @onclick="FetchQueueFromApiAsync">
                    <i class="bi bi-arrow-clockwise"></i> Refresh Queue (API)
                </button>
                <button class="btn btn-sm btn-outline-danger flex-grow-1" @onclick="ClearQueue">
                    <i class="bi bi-trash"></i> Empty Queue
                </button>
            </div>

            <!-- TABS FOR CONFIGURATION -->
            <ul class="nav nav-pills nav-pills-custom mb-3 gap-1 bg-dark p-1 rounded" role="tablist">
                <li class="nav-item flex-fill" role="presentation">
                    <button class="nav-link w-100 @(_activeTab == "queue" ? "active" : "")" @onclick="@(() => SetActiveTab("queue"))">
                        <i class="bi bi-list-ol"></i> Queue Management
                    </button>
                </li>
                <li class="nav-item flex-fill" role="presentation">
                    <button class="nav-link w-100 @(_activeTab == "config" ? "active" : "")" @onclick="@(() => SetActiveTab("config"))">
                        <i class="bi bi-gear-wide-connected"></i> Signage Info
                    </button>
                </li>
            </ul>

            @if (_activeTab == "queue")
            {
                <!-- INSERT NEW PATIENT FORM -->
                <div class="bg-dark p-3 rounded mb-4 border border-secondary">
                    <h6 class="fw-bold mb-3 text-white"><i class="bi bi-person-plus"></i> Add Patient Token</h6>
                    
                    <div class="row g-2">
                        <div class="col-4">
                            <label class="form-label small fw-bold">Cust Code</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" @bind-value="newPatient.custcode" @bind-value:event="oninput" placeholder="001" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="FetchPatientNameAsync" title="Fetch Name"><i class="bi bi-search"></i></button>
                            </div>
                        </div>
                        <div class="col-3">
                            <label class="form-label small fw-bold">Token ID</label>
                            <input type="text" class="form-control form-control-sm" @bind="newPatient.og_token_no" placeholder="145" />
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-bold">Patient Name</label>
                            <input type="text" class="form-control form-control-sm" @bind="newPatient.custname" placeholder="M. Chen" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Status Type</label>
                            <select class="form-select form-select-sm" @bind="newPatient.status">
                                <option value="waiting">Waiting/Queue</option>
                                <option value="in_consultation">Ongoing Consultation</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Entry Type</label>
                            <select class="form-select form-select-sm" @bind="newPatient.entry_type">
                                <option value="direct">Direct Queue</option>
                                <option value="vitals">Vitals Check</option>
                                <option value="test_completed">Test Completed</option>
