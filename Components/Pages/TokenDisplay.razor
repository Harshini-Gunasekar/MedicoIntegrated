    // Master Doctor cache from /api/DoctorMaster/get
    private List<DoctorMasterModel> _doctorMasterList = new();
    private Dictionary<int, DoctorMasterModel> _doctorMasterDict = new();
    private System.Collections.Concurrent.ConcurrentDictionary<string, string> _doctorImageBase64Cache = new();

    private async Task<string?> FetchDoctorImageBase64Async(string? doctorImageKey)
    {
        if (string.IsNullOrWhiteSpace(doctorImageKey)) return null;

        if (doctorImageKey.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
            return doctorImageKey;

        if (_doctorImageBase64Cache.TryGetValue(doctorImageKey, out var cachedUri))
            return cachedUri;

        try
        {
            string baseUrl = Configuration["ApiSettings:MedicoApiUrl"] ?? "https://medicoapi.iscansoft.com/";
            string cleanKey = doctorImageKey;
            if (cleanKey.StartsWith("/api/files/download?key=", StringComparison.OrdinalIgnoreCase))
            {
                cleanKey = cleanKey.Substring("/api/files/download?key=".Length);
            }
            cleanKey = Uri.UnescapeDataString(cleanKey);

            string url = $"{baseUrl.TrimEnd('/')}/api/files/download?key={Uri.EscapeDataString(cleanKey)}";

            using var http = HttpClientFactory.CreateClient();
            using var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Add("tenant_code", "0010");

            using var response = await http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var fileRes = await response.Content.ReadFromJsonAsync<FileDownloadResponse>(_jsonOptions);
                if (fileRes != null && !string.IsNullOrWhiteSpace(fileRes.base64))
                {
                    string rawB64 = fileRes.base64.Trim();
                    if (rawB64.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
                    {
                        _doctorImageBase64Cache[doctorImageKey] = rawB64;
                        return rawB64;
                    }

                    string mimeType = !string.IsNullOrWhiteSpace(fileRes.contentType)
                        ? fileRes.contentType
                        : (fileRes.fileName?.EndsWith(".png", StringComparison.OrdinalIgnoreCase) == true ? "image/png" : "image/jpeg");

                    string formattedDataUri = $"data:{mimeType};base64,{rawB64}";
                    _doctorImageBase64Cache[doctorImageKey] = formattedDataUri;
                    return formattedDataUri;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Image Fetch Error] {ex.Message}");
        }

        return null;
    }

    private string? GetDoctorImageUrl(string? doctorImageKey)
    {
        if (string.IsNullOrWhiteSpace(doctorImageKey)) return null;

        if (doctorImageKey.StartsWith("data:image", StringComparison.OrdinalIgnoreCase) ||
            doctorImageKey.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            doctorImageKey.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return doctorImageKey;
        }

        if (_doctorImageBase64Cache.TryGetValue(doctorImageKey, out var cached))
        {
            return cached;
        }

        string baseUrl = Configuration["ApiSettings:MedicoApiUrl"] ?? "https://medicoapi.iscansoft.com/";
        string cleanBase = baseUrl.TrimEnd('/');

        if (doctorImageKey.StartsWith("/api/files/download", StringComparison.OrdinalIgnoreCase))
        {
            return $"{cleanBase}{doctorImageKey}";
        }

        return $"{cleanBase}/api/files/download?key={Uri.EscapeDataString(doctorImageKey)}";
    }

    private async Task FetchDoctorMasterFromApiAsync()
    {
        try
        {
            string baseUrl = Configuration["ApiSettings:MedicoApiUrl"] ?? "https://medicoapi.iscansoft.com/";
            string url = $"{baseUrl.TrimEnd('/')}/api/DoctorMaster/get?_t={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";

            using var http = HttpClientFactory.CreateClient();
            using var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Add("tenant_code", "0010");
            request.Headers.CacheControl = new System.Net.Http.Headers.CacheControlHeaderValue
            {
                NoCache = true,
                NoStore = true
            };

            using var response = await http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var docs = await response.Content.ReadFromJsonAsync<List<DoctorMasterModel>>(_jsonOptions);
                if (docs != null)
                {
                    _doctorMasterList = docs;
                    foreach (var doc in _doctorMasterList.Where(d => !string.IsNullOrWhiteSpace(d.doctorimage)))
                    {
                        doc.DoctorImageBase64 = await FetchDoctorImageBase64Async(doc.doctorimage);
                    }
                    _doctorMasterDict = docs.Where(d => !d.deleted && d.dcode > 0).ToDictionary(d => d.dcode, d => d);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DoctorMaster Fetch Error] {ex.Message}");
        }
    }

    private async Task FetchQueueFromApiAsync()
    {
        try
        {
            // Fetch Doctor Master first to match dcode and enrich doctor profile details
            await FetchDoctorMasterFromApiAsync();
            string baseUrl = Configuration["ApiSettings:MedicoApiUrl"] ?? "https://medicoapi.iscansoft.com/";
            // Add timestamp cache-buster so the response is NEVER cached
            string url = $"{baseUrl.TrimEnd('/')}/api/OgQueue/merged-list?_t={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";

            // Use IHttpClientFactory — correct pattern for Blazor Server
            using var http = HttpClientFactory.CreateClient();
            using var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Add("tenant_code", "0010");
            request.Headers.CacheControl = new System.Net.Http.Headers.CacheControlHeaderValue
            {
                NoCache = true,
                NoStore = true
            };

            using var response = await http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var list = await response.Content.ReadFromJsonAsync<List<OgQueueModel>>(_jsonOptions);
                if (list != null)
                {
                    // Disable Labcare bulk customer fetch to prevent endpoint issues
                    // The names should come directly from Medico API.
                    _apiError = null;

                    if (_isFirstLoad)
                    {
                        // First load: build snapshot, no announcements
                        _allPatients = list;
                        var firstDisplayQueue = GetDisplayQueue();
                        var firstUpNext = firstDisplayQueue.FirstOrDefault(i => i.ColorTheme == "orange")?.Patient;
                        if (firstUpNext != null && !string.IsNullOrEmpty(firstUpNext.og_token_no))
                        {
                            _lastAnnouncedNextToken = firstUpNext.og_token_no;
                        }

                        _lastPatientStateSnapshot.Clear();
                        foreach (var p in list.Where(p => p.ogentryid.HasValue && !p.deleted))
                            _lastPatientStateSnapshot[p.ogentryid!.Value] = GetPatientStateKey(p);
                        _isFirstLoad = false;
                        return;
                    }

                    // ── Detect changed patients since last poll ──────────────────
                    var changedPatients = new List<OgQueueModel>();
                    foreach (var p in list.Where(p => p.ogentryid.HasValue && !p.deleted))
                    {
                        int id = p.ogentryid!.Value;
                        string newKey = GetPatientStateKey(p);
                        if (_lastPatientStateSnapshot.TryGetValue(id, out var oldKey) && oldKey != newKey)
                            changedPatients.Add(p);
                        _lastPatientStateSnapshot[id] = newKey;
                    }

                    // Clean up departed patients from snapshot
                    var activeIds = list.Where(p => p.ogentryid.HasValue && !p.deleted)
                                        .Select(p => p.ogentryid!.Value).ToHashSet();
                    foreach (var k in _lastPatientStateSnapshot.Keys.Where(k => !activeIds.Contains(k)).ToList())
                        _lastPatientStateSnapshot.Remove(k);

                    // Update list and repaint UI
                    _allPatients = list;
                    StateHasChanged();

                    // --- AUTO ANNOUNCEMENTS (PER-DOCTOR DISPLAY SPECIFIC) ---
                    if (_hasSelectedDoctor)
                    {
                        var displayList = GetDisplayQueue();
                        var consultItems = displayList.Where(i => i.ColorTheme == "green").ToList();
                        
                        // ONLY announce IF CONSULTATION is empty AND an explicit Up-Next patient exists ('orange')
                        if (!consultItems.Any())
                        {
                            var currentNextPatient = displayList.FirstOrDefault(i => i.ColorTheme == "orange")?.Patient;

                            if (currentNextPatient != null && !string.IsNullOrEmpty(currentNextPatient.og_token_no))
                            {
                                if (currentNextPatient.og_token_no != _lastAnnouncedNextToken)
                                {
                                    _lastAnnouncedNextToken = currentNextPatient.og_token_no;
                                    var nextRoom = !string.IsNullOrWhiteSpace(currentNextPatient.room_no) 
                                        ? currentNextPatient.room_no 
                                        : null;

                                    await JS.InvokeVoidAsync("hospitalAudio.playBilingualNextPatientAnnouncement", currentNextPatient.og_token_no, nextRoom);
                                    await Task.Delay(2000); // Small breath before standard status announcements
                                }
                            }
                        }

                        // ── Auto-announce status-changed patients FOR THIS DOCTOR ONLY ──
                        var relevantChangedPatients = changedPatients.Where(p =>
                            _selectedGroupId.HasValue 
                                ? p.group_id == _selectedGroupId.Value 
                                : (_selectedDcode.HasValue ? p.dcode == _selectedDcode.Value : true)
                        ).ToList();

                        var toAnnounce = relevantChangedPatients
                            .OrderByDescending(p => "in_consultation".Equals(p.status, StringComparison.OrdinalIgnoreCase))
                            .ToList();

                        foreach (var changed in toAnnounce)
                        {
                            await CallToken(changed);
                            if (toAnnounce.Count > 1)
                                await Task.Delay(500);
                        }
                    }
                }
            }
            else
            {
                _apiError = $"API error: {response.StatusCode}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _apiError = ex.Message;
            StateHasChanged();
        }
    }

