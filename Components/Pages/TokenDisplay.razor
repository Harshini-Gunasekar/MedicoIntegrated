    private class DoctorItem
    {
        public int? Dcode { get; set; }
        public string DoctorName { get; set; } = "";
        public string? DoctorQualification { get; set; }
        public string? DoctorSpecialization { get; set; }
        public int TokenCount { get; set; }
    }

    private List<DoctorItem> GetAvailableDoctors()
    {
        return _allPatients
            .Where(p => !p.deleted && 
                        !"completed".Equals(p.status, StringComparison.OrdinalIgnoreCase))
            .GroupBy(p => p.dcode)
            .Select(g => {
                var firstWithDocName = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.doctor_name));
                var firstWithQual = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.doctor_qualification));
                var firstWithSpec = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.doctor_specialization));
                return new DoctorItem 
                { 
                    Dcode = g.Key, 
                    DoctorName = firstWithDocName?.doctor_name ?? $"Doctor {g.Key ?? 1}",
                    DoctorQualification = firstWithQual?.doctor_qualification,
                    DoctorSpecialization = firstWithSpec?.doctor_specialization,
                    TokenCount = g.Count()
                };
            })
            .OrderByDescending(d => d.TokenCount)
            .ToList();
    }

    private void SelectDoctorToDisplay(int? dcode, string name)
    {
        _selectedDcode = dcode;
        _hasSelectedDoctor = true;
        if (!string.IsNullOrEmpty(name) && name != "All Doctors")
        {
            DoctorName = name; // Update UI title
        }
    }

    private void ClearDoctorSelection()
    {
        _hasSelectedDoctor = false;
        _selectedDcode = null;
    }

    // Form binding model for new patient
    private OgQueueModel newPatient = new() { og_token_no = "", custname = "", status = "waiting", entry_type = "direct", arrival_time_str = DateTime.Now.ToString("HH:mm:ss") };

    // Track last known state for each patient to detect any status change
    private Dictionary<int, string> _lastPatientStateSnapshot = new();
    private bool _isFirstLoad = true;
    private string _lastAnnouncedNextToken = "";

    protected override void OnInitialized()
    {
        // Parse Query String manually using NavigationManager to ensure it always works in InteractiveServer mode
        var uri = new Uri(NavManager.Uri);
        var queryStr = uri.Query;
        if (!string.IsNullOrEmpty(queryStr))
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(queryStr);
            if (query.TryGetValue("doccode", out var doccodeValues) && int.TryParse(doccodeValues.First(), out int dcode))
            {
                QueryDocCode = dcode;
                _selectedDcode = dcode;
                _hasSelectedDoctor = true;
            }
            if (query.TryGetValue("tenant_code", out var tenantValues))
            {
                TenantCode = tenantValues.First() ?? "0010";
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // First load: build snapshot, populate UI, no announcements
        await FetchQueueFromApiAsync();
        
        // If doccode was provided in URL, update the DoctorName
        if (QueryDocCode.HasValue)
        {
            var doc = GetAvailableDoctors().FirstOrDefault(d => d.Dcode == QueryDocCode.Value);
            if (doc != null && !string.IsNullOrEmpty(doc.DoctorName) && doc.DoctorName != $"Doctor {doc.Dcode}")
            {
                DoctorName = doc.DoctorName;
            }
        }

        await InvokeAsync(StateHasChanged);

        // Start background polling AFTER first load — no race condition
        _ = StartPollingLoopAsync(_cts.Token);
    }



    /// <summary>
    /// Sequential polling loop.
    /// IMPORTANT: For Blazor Server, ALL UI work must run inside
    /// InvokeAsync so it executes on the SignalR circuit context.
    /// </summary>
    private async Task StartPollingLoopAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(1000, ct);

                // Run everything on the Blazor circuit thread
                await InvokeAsync(async () =>
                {
                    _now = DateTime.Now;
                    _apiPollCounter++;

                    // Only poll the backend API every 5 seconds (5 ticks) to avoid overloading the server,
                    // while updating the clock seconds every 1 second.
                    if (_apiPollCounter >= 5 || _isFirstLoad)
                    {
                        _apiPollCounter = 0;
                        await FetchQueueFromApiAsync();
                    }
                    
                    StateHasChanged();
                });
            }
        }
        catch (TaskCanceledException) { /* Normal on page dispose */ }
        catch (Exception ex)
        {
            Console.WriteLine($"[Polling Error] {ex.Message}");
        }
    }

    /// <summary>
    /// Returns a unique state key for a patient to detect any status change.
    /// Covers: status, entry_type, vitals_status, list_type
    /// </summary>
    private string GetPatientStateKey(OgQueueModel p) =>
        $"{p.status}|{p.entry_type}|{p.vitals_status}|{p.list_type}";

    private async Task FetchQueueFromApiAsync()
    {
        try
        {
            string baseUrl = Configuration["ApiBaseUrl"] ?? "http://medicoapi.iscansoft.com/";
            // Add timestamp cache-buster so the response is NEVER cached
            string url = $"{baseUrl.TrimEnd('/')}/api/OgQueue/merged-list?_t={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";

            // Use IHttpClientFactory — correct pattern for Blazor Server
            using var http = HttpClientFactory.CreateClient();
            using var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Add("tenant_code", TenantCode);
            request.Headers.CacheControl = new System.Net.Http.Headers.CacheControlHeaderValue
            {
                NoCache = true,
                NoStore = true
            };

            using var response = await http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var list = await response.Content.ReadFromJsonAsync<List<OgQueueModel>>();
                if (list != null)
                {
                    // Disable Labcare bulk customer fetch to prevent endpoint issues
                    // The names should come directly from Medico API.
                    _apiError = null;

                    if (_isFirstLoad)
                    {
                        // First load: build snapshot, no announcements
                        _allPatients = list;
                        var firstDisplayQueue = GetDisplayQueue();
                        var firstUpNext = firstDisplayQueue.FirstOrDefault(i => i.ColorTheme == "orange")?.Patient;
                        if (firstUpNext != null && !string.IsNullOrEmpty(firstUpNext.og_token_no))
                        {
                            _lastAnnouncedNextToken = firstUpNext.og_token_no;
                        }

                        _lastPatientStateSnapshot.Clear();
                        foreach (var p in list.Where(p => p.ogentryid.HasValue && !p.deleted))
                            _lastPatientStateSnapshot[p.ogentryid!.Value] = GetPatientStateKey(p);
                        _isFirstLoad = false;
                        return;
                    }

                    // ── Detect changed patients since last poll ──────────────────
                    var changedPatients = new List<OgQueueModel>();
                    foreach (var p in list.Where(p => p.ogentryid.HasValue && !p.deleted))
                    {
                        int id = p.ogentryid!.Value;
                        string newKey = GetPatientStateKey(p);
                        if (_lastPatientStateSnapshot.TryGetValue(id, out var oldKey) && oldKey != newKey)
                            changedPatients.Add(p);
                        _lastPatientStateSnapshot[id] = newKey;
                    }

                    // Clean up departed patients from snapshot
                    var activeIds = list.Where(p => p.ogentryid.HasValue && !p.deleted)
                                        .Select(p => p.ogentryid!.Value).ToHashSet();
                    foreach (var k in _lastPatientStateSnapshot.Keys.Where(k => !activeIds.Contains(k)).ToList())
                        _lastPatientStateSnapshot.Remove(k);

                    // Update list and repaint UI
                    _allPatients = list;
                    StateHasChanged();

                    // --- AUTO ANNOUNCEMENT FOR NEXT PATIENT ---
                    var displayList = GetDisplayQueue();
                    var currentNextPatient = displayList.FirstOrDefault(i => i.ColorTheme == "orange")?.Patient;
                    if (currentNextPatient != null && !string.IsNullOrEmpty(currentNextPatient.og_token_no))
                    {
                        if (currentNextPatient.og_token_no != _lastAnnouncedNextToken)
                        {
                            // It's a new Next Patient, announce them natively.
                            _lastAnnouncedNextToken = currentNextPatient.og_token_no;
                            await JS.InvokeVoidAsync("hospitalAudio.playBilingualNextPatientAnnouncement", currentNextPatient.og_token_no);
                            await Task.Delay(2000); // Small breath before standard status announcements
                        }
                    }

                    // ── Auto-announce status-changed patients ────────────────────
                    var toAnnounce = changedPatients
                        .OrderByDescending(p => "in_consultation".Equals(p.status, StringComparison.OrdinalIgnoreCase))
                        .ToList();

                    foreach (var changed in toAnnounce)
                    {
                        await CallToken(changed);
                        if (toAnnounce.Count > 1)
                            await Task.Delay(500);
                    }
                }
            }
            else
            {
                _apiError = $"API error: {response.StatusCode}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _apiError = ex.Message;
            StateHasChanged();
        }
    }

