                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemovePatient(p)" title="Close Token">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted bg-dark border border-secondary rounded">
                            Queue is currently empty. Add a patient token above.
                        </div>
                    }
                </div>
            }
            else if (_activeTab == "config")
            {
                <!-- SIGNAGE AND SPEECH GENERAL SETTINGS -->
                <div class="mb-4">
                    <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-buildings"></i> Signage Identity Plate</h6>
                    
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Clinic / Hospital Name</label>
