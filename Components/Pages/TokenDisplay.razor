    private async Task RemovePatient(OgQueueModel patient)
    {
        try
        {
            string baseUrl = Configuration["ApiBaseUrl"] ?? "http://medicoapi.iscansoft.com/";
            string url = $"{baseUrl.TrimEnd('/')}/api/OgQueue/update-out-time";

            var requestData = new UpdateOgOutTimeRequest
            {
                ogentryid = patient.ogentryid ?? 0,
                out_time = TimeOnly.FromDateTime(DateTime.Now),
                status = "completed",
                notes = patient.notes,
                usercode = 1,
                computercode = 1
            };

            using var http = HttpClientFactory.CreateClient();
            using var request = new HttpRequestMessage(HttpMethod.Post, url);
            request.Headers.Add("tenant_code", TenantCode);
            request.Content = JsonContent.Create(requestData);
            await http.SendAsync(request);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing patient: {ex.Message}");
        }

        patient.deleted = true;
        _allPatients.Remove(patient);
        await FetchQueueFromApiAsync();
    }

    private async Task UpdatePatientStatus(OgQueueModel patient, string statusStr)
    {
        string apiStatus = "waiting";
        string entryType = patient.entry_type;

        if (statusStr == "OngoingConsultation")
        {
            apiStatus = "in_consultation";
            entryType = "direct";
            
            // Revert existing ongoing patient to waiting
            var currentOngoing = _ongoingPatient;
            if (currentOngoing != null && currentOngoing != patient)
            {
                currentOngoing.status = "waiting";
            }
        }
        else if (statusStr == "ReadyForReview")
        {
            apiStatus = "waiting";
            entryType = "test_completed";
        }
        else if (statusStr == "VitalsCheck")
        {
            apiStatus = "waiting";
            entryType = "vitals";
        }
        else if (statusStr == "Waiting")
        {
            apiStatus = "waiting";
            entryType = "direct";
        }

        patient.status = apiStatus;
        patient.entry_type = entryType;

        try
        {
            string baseUrl = Configuration["ApiBaseUrl"] ?? "http://medicoapi.iscansoft.com/";
            string url = $"{baseUrl.TrimEnd('/')}/api/OgQueue/update-status";

            var requestData = new UpdateOgStatusRequest
            {
                ogentryid = patient.ogentryid ?? 0,
                status = apiStatus,
                usercode = 1,
                computercode = 1
            };

            using var http = HttpClientFactory.CreateClient();
            using var request = new HttpRequestMessage(HttpMethod.Post, url);
            request.Headers.Add("tenant_code", TenantCode);
            request.Content = JsonContent.Create(requestData);
            await http.SendAsync(request);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating status: {ex.Message}");
        }

        await FetchQueueFromApiAsync();
    }

    private async Task CallToken(OgQueueModel token)
    {
        var displayQueue = GetDisplayQueue();
        var match = displayQueue.FirstOrDefault(item => item.Patient.ogentryid == token.ogentryid);
        _callingColorTheme = match?.ColorTheme ?? "green";

        if (token.ogentryid.HasValue)
        {
            _callingOgEntryIds.Add(token.ogentryid.Value);
        }
        _callingToken = token;
        _showCallOverlay = true;
        StateHasChanged();
        
        string announcementText = "";
        
        if (SelectedLanguage == "ta-IN")
        {
            if (token.status == "in_consultation")
            {
                var loc = token.dcode == null ? "மருத்துவரைச் சந்திக்க" : $"அறை எண் {token.dcode}";
                announcementText = $"அன்பான வேண்டுகோள். டோக்கன் எண் {token.og_token_no}, தயவுசெய்து {loc} -ற்கு வரவும்.";
            }
            else if (token.entry_type == "vitals")
            {
                announcementText = $"அன்பான வேண்டுகோள். டோக்கன் எண் {token.og_token_no}, உடல்நிலை பரிசோதனைக்காக வரவும்.";
            }
            else
            {
                announcementText = $"அன்பான வேண்டுகோள். டோக்கன் எண் {token.og_token_no}, உங்கள் பரிசோதனை அறிக்கையை சரிபார்க்க வரவும்.";
            }
        }
        else
        {
            if (token.status == "in_consultation")
            {
                var loc = token.dcode == null ? "" : $", Room {token.dcode}";
                announcementText = $"Next token number {token.og_token_no}{loc}.";
            }
            else if (token.entry_type == "vitals")
            {
                announcementText = $"Next token number {token.og_token_no}, Vitals check.";
            }
            else
            {
                announcementText = $"Next token number {token.og_token_no}, Report review.";
            }
        }

        await JS.InvokeVoidAsync("hospitalAudio.playChimeAndSpeak", announcementText, SelectedLanguage, SpeechRate, SpeechPitch);
        
        _ = Task.Delay(4200).ContinueWith(_ =>
        {
            if (token.ogentryid.HasValue)
            {
                _callingOgEntryIds.Remove(token.ogentryid.Value);
            }
            _showCallOverlay = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task TestVoiceChime()
    {
        string testStr = SelectedLanguage == "ta-IN" ? "அறிவிப்பு சோதனை" : "Voice chime test successful.";
        await JS.InvokeVoidAsync("hospitalAudio.playChimeAndSpeak", testStr, SelectedLanguage, SpeechRate, SpeechPitch);
    }

    private List<PatientQueueDisplayItem> GetDisplayQueue()
    {
        var displayList = new List<PatientQueueDisplayItem>();

        // ── RULE: Exclude 'completed' and 'deleted' patients entirely ──────────
        // ── ALSO: Filter by Selected Doctor if one is chosen ──────────
        var activePatients = _allPatients
            .Where(p => !p.deleted &&
                        !"completed".Equals(p.status, StringComparison.OrdinalIgnoreCase) &&
                        (_selectedDcode == null || p.dcode == _selectedDcode) &&
                        ("waiting".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                         "in_consultation".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                         "up-next".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                         "up_next".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                         "upnext".Equals(p.status, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(p => p.token_sort ?? 999)
            .ToList();

        // ── 1. GREEN: In Consultation ──────────────────────────────────────────
        var consulting = activePatients
            .Where(p => "in_consultation".Equals(p.status, StringComparison.OrdinalIgnoreCase))
            .ToList();

        foreach (var p in consulting)
        {
            bool isReport = "lab_scan".Equals(p.list_type, StringComparison.OrdinalIgnoreCase) ||
                            "report_received".Equals(p.vitals_status, StringComparison.OrdinalIgnoreCase) ||
                            p.entry_type == "test_completed";

            displayList.Add(new PatientQueueDisplayItem
            {
                Patient       = p,
                ColorTheme    = "green",
                StatusText    = isReport ? "REPORT REVIEW|அறிக்கை பரிசோதனையில்" : "IN CONSULTATION|மருத்துவர் பரிசோதனையில்",
                StatusSubtext = isReport ? "Reviewing Lab Reports" : $"Consulting Room {p.dcode ?? 1}"
            });
        }

        // ── 2. ORANGE (Up Next) + BLUE (Waiting) ──────────────────────────────
        // Explicit 'up_next' from API come first, then waiting ordered by token_sort
        var upNextFromApi = activePatients
            .Where(p => "up-next".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                        "up_next".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                        "upnext".Equals(p.status, StringComparison.OrdinalIgnoreCase))
            .ToList();

        var waitingOnly = activePatients
            .Where(p => "waiting".Equals(p.status, StringComparison.OrdinalIgnoreCase))
            .ToList();

        // Merge: explicit up-next first, then waiting ordered by token_sort
        var orderedQueue = upNextFromApi.Concat(waitingOnly).ToList();

        for (int i = 0; i < orderedQueue.Count; i++)
        {
            var p = orderedQueue[i];
            bool isLabScan = "lab_scan".Equals(p.list_type, StringComparison.OrdinalIgnoreCase);
            bool isReport = isLabScan ||
                            "report_received".Equals(p.vitals_status, StringComparison.OrdinalIgnoreCase) ||
                            p.entry_type == "test_completed";

            bool isUpNext = "up-next".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                            "up_next".Equals(p.status, StringComparison.OrdinalIgnoreCase) ||
                            "upnext".Equals(p.status, StringComparison.OrdinalIgnoreCase);

            if (isLabScan)
            {
                // ── PURPLE: Lab Scan ──
                displayList.Add(new PatientQueueDisplayItem
                {
                    Patient       = p,
                    ColorTheme    = "purple",
                    StatusText    = "LAB SCAN REPORT|ஆய்வக அறிக்கை தயார்",
                    StatusSubtext = "Lab scan report ready for review"
                });
            }
            else if (isUpNext)
            {
                // ── ORANGE: Up Next ──
                displayList.Add(new PatientQueueDisplayItem
                {
                    Patient       = p,
                    ColorTheme    = "orange",
                    StatusText    = isReport          ? "WAITING FOR REPORT|ஆய்வக அறிக்கைக்காக காத்திருக்கவும்"
                                  : p.entry_type == "vitals" ? "VITALS CHECK|உடல்நிலை பரிசோதனை"
                                  : "NEXT IN LINE|அடுத்து நீங்கள் செல்லவும்",
                    StatusSubtext = isReport          ? "Report ready for review"
                                  : p.entry_type == "vitals" ? "Vitals check next"
                                  : "Please prepare to enter"
                });
            }
            else
            {
                // ── BLUE: Waiting ──
                displayList.Add(new PatientQueueDisplayItem
                {
                    Patient       = p,
                    ColorTheme    = "blue",
                    StatusText    = isReport          ? "WAITING FOR REPORT|ஆய்வக அறிக்கைக்காக காத்திருக்கவும்"
                                  : p.entry_type == "vitals" ? "VITALS CHECK|உடல்நிலை பரிசோதனை"
                                  : "WAITING|காத்திருக்கவும்",
                    StatusSubtext = isReport          ? "Report pending review"
                                  : p.entry_type == "vitals" ? "Vitals check pending"
                                  : "Waiting in lounge"
                });
            }
        }

        return displayList;
    }

    public class PatientQueueDisplayItem
    {
        public OgQueueModel Patient { get; set; } = null!;
        public string ColorTheme { get; set; } = "blue"; // green | orange | blue
        public string StatusText { get; set; } = "";
        public string StatusSubtext { get; set; } = "";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
