    private async Task AddNewPatient()
    {
        if (string.IsNullOrWhiteSpace(newPatient.og_token_no) || string.IsNullOrWhiteSpace(newPatient.custname))
            return;

        newPatient.arrival_time_str = DateTime.Now.ToString("HH:mm:ss");
        newPatient.ogentryid = _allPatients.Any(p => p.ogentryid.HasValue) ? (_allPatients.Where(p => p.ogentryid.HasValue).Max(p => p.ogentryid) ?? 0) + 1 : 1;
        newPatient.created_at = DateTime.Now;
        newPatient.updated_at = DateTime.Now;

        // Add to local list
        _allPatients.Add(newPatient);

        // Reset inputs
        newPatient = new OgQueueModel { og_token_no = "", custcode = "", custname = "", status = "waiting", entry_type = "direct", arrival_time_str = DateTime.Now.ToString("HH:mm:ss") };
        await InvokeAsync(StateHasChanged);
    }

