    private async Task UpdatePatientStatus(OgQueueModel patient, string statusStr)
    {
        string apiStatus = "waiting";
        string entryType = patient.entry_type;

        if (statusStr == "OngoingConsultation")
        {
            apiStatus = "in_consultation";
            entryType = "direct";
            
            // Revert existing ongoing patient to waiting
            var currentOngoing = _ongoingPatient;
            if (currentOngoing != null && currentOngoing != patient)
            {
                currentOngoing.status = "waiting";
            }
        }
        else if (statusStr == "ReadyForReview")
        {
            apiStatus = "waiting";
            entryType = "test_completed";
        }
        else if (statusStr == "VitalsCheck")
        {
            apiStatus = "waiting";
            entryType = "vitals";
        }
        else if (statusStr == "Waiting")
        {
            apiStatus = "waiting";
            entryType = "direct";
        }

        patient.status = apiStatus;
        patient.entry_type = entryType;

        try
        {
            string baseUrl = Configuration["ApiSettings:MedicoApiUrl"] ?? "https://medicoapi.iscansoft.com/";
            string url = $"{baseUrl.TrimEnd('/')}/api/OgQueue/update-status";

            var requestData = new UpdateOgStatusRequest
            {
                ogentryid = patient.ogentryid ?? 0,
                status = apiStatus,
                usercode = 1,
                computercode = 1
            };

            using var http = HttpClientFactory.CreateClient();
            using var request = new HttpRequestMessage(HttpMethod.Post, url);
            request.Headers.Add("tenant_code", "0010");
            request.Content = JsonContent.Create(requestData);
            await http.SendAsync(request);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating status: {ex.Message}");
        }

        await FetchQueueFromApiAsync();
    }

