@page "/samples"
@page "/sample-master"
@rendermode InteractiveServer

@using Booking.Models
@using Booking.Services
@inject SampleMasterService SampleService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<div class="referral-page lc-fadeInUp">
    @* --- HEADER CONSOLE --- *@
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">list_alt</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Sample Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Classification Inventory</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search samples..." @bind="SearchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" />
            </div>
            @if (TenantState.HasActionRight("Configuration", "General", "Create"))
            {
                <div class="search-controls">
                    <button class="btn-new-entry" @onclick="NewSample">+ Add New</button>
                </div>
            }
        </div>
    </div>

    @* --- directory list --- *@
    <div class="directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">ORDER NO</th>
                        <th style="width: 150px;">SHORT NAME</th>
                        <th>SAMPLE NAME</th>
                        <th>DESCRIPTION</th>
                        <th style="width: 180px;">ENTERED DATE</th>
                        <th style="width: 180px;">MODIFIED DATE</th>
                        <th class="text-center" style="width: 120px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (samples != null && samples.Any())
                    {
                        @foreach (var s in FilteredSamplesBySearch)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@($"{s.orderno:00}")</span></td>
                                <td class="lc-color-slate-500 lc-font-mono lc-font-700 lc-font-13">@s.shortname</td>
                                <td class="font-bold text-slate-800">@s.name</td>
                                <td class="text-slate-500">@s.description</td>
                                <td class="text-slate-400 font-12">@(s.entereddate != default ? s.entereddate.ToString("dd-MM-yyyy hh:mm tt") : "")</td>
                                <td class="text-slate-400 font-12">@(s.ibsdate != default ? s.ibsdate.ToString("dd-MM-yyyy hh:mm tt") : "")</td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px;">
                                        @if (TenantState.HasActionRight("Configuration", "General", "Edit"))
                                        {
                                            <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => EditSample(s)" title="Edit">
                                                <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                            </button>
                                        }
                                        @if (TenantState.HasActionRight("Configuration", "General", "Delete"))
                                        {
                                            <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => DeleteSample(s.scode)" title="Delete">
                                                <span class="material-symbols-outlined font-18 text-slate-400">delete</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center p-48 text-slate-400 italic">No sample records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- FORM SECTION (Modal) --- *@
@if (showForm)
{
    <div class="modal-overlay">
        <div class="modal-form-card">
            <div class="modal-header-bar">
                <h3>@(isEditMode ? "Edit Sample" : "New Sample Entry")</h3>
                <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-0 form-section">
                    <div class="mt-0">
                        @* Line 1: Sample Name *@
                        <div class="um-grid-row">
                            <div class="form-group position-relative">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label style="margin-bottom: 0;">Sample name *</label>
                                    @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                    {
                                        <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                    }
                                </div>
                                <input type="text" class="lab-input" @bind="current.name" placeholder="e.g. Blood" required />
                            </div>
                        </div>

                        @* Line 2: Order no, Short Name *@
                        <div class="um-grid-cols-2">
                            <div class="form-group">
                                <label>Order no</label>
                                <input type="number" class="lab-input" @bind="current.orderno" />
                            </div>
                            <div class="form-group">
                                <label>Short Name</label>
                                <input type="text" class="lab-input" @bind="current.shortname" placeholder="e.g. BLD" />
                            </div>
                        </div>

                        @* Line 3: Description *@
                        <div class="um-grid-row">
                            <div class="form-group">
                                <label>Description</label>
                                <input type="text" class="lab-input" @bind="current.description" placeholder="e.g. Whole blood sample" />
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            
            <div class="modal-footer-bar">
                <button type="button"
                        class="btn-delete"
                        @onclick="() => DeleteSample(current.scode)"
                        disabled="@(current.scode == 0)">
                    Delete
                </button>
                <button type="button" class="btn-save" @onclick="SaveSample">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                    </svg>
                    Save Sample
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Booking.Models.SampleMasterModel> samples = new();
    private Booking.Models.SampleMasterModel current = new();
    private bool isEditMode = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";

    private IEnumerable<Booking.Models.SampleMasterModel> FilteredSamples =>
        samples.Where(s => !s.deleted);

    private IEnumerable<Booking.Models.SampleMasterModel> FilteredSamplesBySearch =>
        FilteredSamples.Where(s => 
            string.IsNullOrWhiteSpace(SearchQuery) || 
            (s.name != null && s.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (s.shortname != null && s.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (s.description != null && s.description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await LoadSamples();
    }

    private async Task LoadSamples()
    {
        try
        {
            samples = await SampleService.GetSampleMastersAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading samples: {ex.Message}");
        }
    }

    private void NewSample()
    {
        current = new Booking.Models.SampleMasterModel { 
            deleted = false,
            computercode = 1,
            usercode = 1,
            entereddate = DateTime.Now,
            ibsdate = DateTime.Now,
            orderno = samples.Count + 1,
            tenant_code = "TEN007"
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private void EditSample(Booking.Models.SampleMasterModel s)
    {
        if (s == null) return;
        current = new Booking.Models.SampleMasterModel
        {
            scode = s.scode,
            tenant_code = s.tenant_code,
            orderno = s.orderno,
            shortname = s.shortname,
            name = s.name,
            description = s.description,
            deleted = s.deleted,
            usercode = s.usercode,
            computercode = s.computercode,
            entereddate = s.entereddate,
            ibsdate = s.ibsdate
        };
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveSample()
    {
        isSubmitted = true;
        if (string.IsNullOrWhiteSpace(current.name))
        {
            ToastService.ShowError("Sample Name is required.");
            StateHasChanged();
            return;
        }

        try
        {
            current.tenant_code = "TEN007";
            current.computercode = 1;
            current.usercode = 1;
            current.ibsdate = DateTime.Now;

            bool success;
            if (isEditMode)
            {
                success = await SampleService.UpdateSampleMasterAsync(current);
            }
            else
            {
                current.entereddate = DateTime.Now;
                success = await SampleService.InsertSampleMasterAsync(current);
            }

            if (success)
            {
                await LoadSamples();
                ToastService.ShowSuccess(isEditMode ? "Sample updated successfully!" : "Sample added successfully!");
                showForm = false;
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Save failed on backend.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving sample: {ex.Message}");
            StateHasChanged();
        }
    }

    private async Task DeleteSample(decimal scode)
    {
        if (scode == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this sample?"))
        {
            try
            {
                bool success = await SampleService.DeleteSampleMasterAsync(scode);
                if (success)
                {
                    await LoadSamples();
                    ToastService.ShowSuccess("Sample deleted successfully!");
                    if (current != null && current.scode == scode)
                    {
                        showForm = false;
                    }
                    StateHasChanged();
                }
                else
                {
                    ToastService.ShowError("Delete failed on backend.");
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error deleting: {ex.Message}");
                StateHasChanged();
            }
        }
    }

    private void CloseForm()
    {
        current = new Booking.Models.SampleMasterModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }
}
