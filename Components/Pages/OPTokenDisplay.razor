        public string DisplayName => !string.IsNullOrWhiteSpace(patient_name) ? patient_name : (custid > 0 ? $"Patient #{custid}" : "Patient");
        public string DisplayToken => !string.IsNullOrWhiteSpace(token_no) && token_no != "0" ? token_no : (!string.IsNullOrWhiteSpace(op_no) ? op_no : "1");
        public string DisplayDoctorName => !string.IsNullOrWhiteSpace(doctor_name) ? (doctor_name.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? doctor_name : $"Dr. {doctor_name}") : $"Doctor #{dcode}";
        public string RoomNo => !string.IsNullOrWhiteSpace(room_no) ? room_no : (dcode > 0 ? dcode.ToString() : "");
        
        // ── 3 REGISTRATION CATEGORIES DIFFERENTIATION ──
        public string RegistrationCategory
        {
            get
            {
                // 1. Dressing
                if (is_dressing || 
                    (!string.IsNullOrEmpty(reg_type) && reg_type.Equals("DRESSING", StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(notes) && notes.Contains("Dressing", StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(service_name) && service_name.Contains("Dressing", StringComparison.OrdinalIgnoreCase)))
                {
                    return "DRESSING";
                }

                // 2. Others / Other Services
                if ((!string.IsNullOrEmpty(service_name) && 
                     !service_name.Contains("Consultation", StringComparison.OrdinalIgnoreCase) && 
                     !service_name.Equals("OP", StringComparison.OrdinalIgnoreCase) &&
                     !service_name.Equals("Walk-in OP", StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(notes) && (notes.Contains("[OTHERS]", StringComparison.OrdinalIgnoreCase) || notes.Contains("[SERVICE_WALKIN]", StringComparison.OrdinalIgnoreCase))) ||
                    (!string.IsNullOrEmpty(reg_type) && reg_type.Equals("OTHERS", StringComparison.OrdinalIgnoreCase)))
                {
                    return "OTHERS";
                }

                // 3. OP Consultation (Default)
                return "OP";
            }
        }

        public string CategoryLabel
        {
            get
            {
                if (RegistrationCategory == "DRESSING")
                {
                    return !string.IsNullOrWhiteSpace(service_name) ? service_name : "Dressing";
                }
                if (RegistrationCategory == "OTHERS")
                {
                    return !string.IsNullOrWhiteSpace(service_name) ? service_name : "Other Service";
                }
                if (reg_type == "WALKIN") return "Walk-in OP";
                if (reg_type == "ONLINE") return "Appointment Check-in";
                return "OP Consultation";
