    private string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "D";
        var cleaned = name.Trim();
        if (cleaned.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase)) cleaned = cleaned.Substring(3).Trim();
        else if (cleaned.StartsWith("Dr ", StringComparison.OrdinalIgnoreCase)) cleaned = cleaned.Substring(3).Trim();
        cleaned = cleaned.TrimStart('.', ' ');
        if (!string.IsNullOrEmpty(cleaned)) return cleaned[0].ToString().ToUpper();
        return name.Trim()[0].ToString().ToUpper();
    }

    private string GetDynamicTickerMessage()
    {
