@page "/op-token-display"
@page "/optoken-display"
@rendermode InteractiveServer
@using Medico.Components.Pages
@using Booking.Models
@using Booking.Services
@using Booking.Helpers
@using medico_backend.Model
@using SharedComponents.Rcl.Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@layout SharedComponents.Rcl.Components.Layout.EmptyLayout
<link href="tokendisplay.css" rel="stylesheet" />
@implements IDisposable
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavManager
@inject AppointmentBookingService BookingService
@inject DoctorService DoctorService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject ProtectedSessionStorage _sessionStorage

<PageTitle>OP Token Display Signage - Outpatient Visiting</PageTitle>

<div class="op-signage-root">

    @if (!_hasSelectedDoctor && !_isAdminOpen)
    {
        <!-- ══════════════ DOCTOR SELECTION SCREEN ══════════════ -->
        <div class="kiosk-display justify-content-center align-items-center">
            <div class="live-bg-container">
                <div class="live-bg-blob live-bg-blob-1"></div>
                <div class="live-bg-blob live-bg-blob-2"></div>
                <div class="live-bg-blob live-bg-blob-3"></div>
            </div>
            <div class="doc-select-screen">
                <div class="doc-select-header">
                    <div class="d-flex justify-content-center mb-2">
                        <span class="op-badge-pill">
                            <i class="bi bi-hospital"></i> OUTPATIENT VISITING QUEUE
                        </span>
                    </div>
                    <h1 class="doc-select-title">
                        <i class="bi bi-display"></i> Select OP Display Doctor
                    </h1>
                    <p class="doc-select-subtitle">Tap a doctor below to load their specific Outpatient token queue or choose All Doctors.</p>
                </div>

                <!-- SEARCH DOCTOR FILTER & QUICK ACTIONS -->
                <div class="d-flex justify-content-center align-items-center gap-3 mb-4 flex-wrap">
                    <div class="doc-search-wrapper">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" class="form-control doc-search-input" 
                               placeholder="Filter doctor by name or specialty..." 
                               @bind-value="_doctorSearchQuery" 
                               @bind-value:event="oninput" />
                        @if (!string.IsNullOrEmpty(_doctorSearchQuery))
                        {
                            <button class="doc-search-clear" type="button" @onclick="ClearDoctorSearch" aria-label="Clear Search">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>

                    <button class="btn btn-primary px-4 py-2 shadow-sm d-inline-flex align-items-center gap-2" 
                            style="border-radius: 24px; font-weight: 700; height: 46px; background: linear-gradient(135deg, #0284c7, #0369a1); border: none;"
                            @onclick="SelectAllDoctors">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                        <span>Show All OP Doctors (@_allOpRegistrations.Count Patients)</span>
                    </button>
                </div>
                
                @{
                    var units = GetAvailableDoctorUnits();
                    if (!string.IsNullOrWhiteSpace(_doctorSearchQuery))
                    {
                        units = units.Where(u => u.DisplayName.Contains(_doctorSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                                 (u.DisplaySpecialization != null && u.DisplaySpecialization.Contains(_doctorSearchQuery, StringComparison.OrdinalIgnoreCase))).ToList();
                    }
                }

                @if (_isLoading)
                {
                    <div class="d-flex justify-content-center align-items-center" style="padding: 60px 20px;">
                        <div class="doc-loading-state">
                            <div class="doc-loading-spinner">
                                <div class="spinner-ring"></div>
                                <div class="spinner-ring spinner-ring-2"></div>
                                <div class="spinner-ring spinner-ring-3"></div>
                            </div>
                            <p class="doc-loading-text">Loading Outpatient Queue...</p>
                            <p class="doc-loading-subtext">Fetching live registrations & doctor statuses</p>
                        </div>
                    </div>
                }
                else if (units.Any())
                {
                    <div class="doc-select-grid">
                        @foreach (var unit in units)
                        {
                            <div class="doc-select-card" @onclick='() => SelectUnitToDisplay(unit)'>
                                @if (unit.Doctors.Count > 1)
                                {
                                    <div class="doc-avatar-group" style="display: flex; align-items: center; justify-content: center; padding-left: 14px; min-height: 56px; margin-bottom: 12px;">
                                        @for (int i = 0; i < unit.Doctors.Count; i++)
                                        {
                                            var doc = unit.Doctors[i];
                                            var marginLeft = i > 0 ? "-14px" : "0px";
                                            var zIndex = unit.Doctors.Count - i;
                                            if (!string.IsNullOrEmpty(doc.DoctorImageUrl))
                                            {
                                                <img src="@doc.DoctorImageUrl" style="width: 52px; height: 52px; border-radius: 50%; object-fit: cover; border: 3px solid #ffffff; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15); margin-left: @marginLeft; z-index: @zIndex; flex-shrink: 0;" title="@doc.DoctorName" />
                                            }
                                            else
                                            {
                                                <div class="doc-avatar-item" style="width: 52px; height: 52px; border-radius: 50%; overflow: hidden; border: 3px solid #ffffff; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15); margin-left: @marginLeft; z-index: @zIndex; background: linear-gradient(135deg, #0284c7, #0369a1); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #ffffff; font-weight: 800; font-size: 22px;" title="@doc.DoctorName">
                                                    <span style="font-size: 22px; font-weight: 800; color: #ffffff; text-transform: uppercase;">@GetInitial(doc.DoctorName)</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    if (!string.IsNullOrEmpty(unit.DisplayImageUrl))
                                    {
                                        <img src="@unit.DisplayImageUrl" style="width: 54px; height: 54px; border-radius: 50%; object-fit: cover; border: 3px solid #ffffff; box-shadow: 0 6px 16px rgba(0,0,0,0.12); margin-bottom: 12px;" />
                                    }
                                    else
                                    {
                                        <div class="doc-avatar-wrapper" style="width: 54px; height: 54px; border-radius: 50%; overflow: hidden; border: 3px solid #ffffff; box-shadow: 0 6px 16px rgba(0,0,0,0.12); display: flex; align-items: center; justify-content: center; margin-bottom: 12px; background: linear-gradient(135deg, #0284c7, #0369a1); color: #ffffff; font-weight: 800; font-size: 24px;">
                                            <span style="font-size: 24px; font-weight: 800; color: #ffffff; text-transform: uppercase;">@GetInitial(unit.DisplayName)</span>
                                        </div>
                                    }
                                }

                                <h2 class="doc-select-name" style="font-size: 18px; font-weight: 800; color: #0f172a; margin-bottom: 6px; line-height: 1.25; text-transform: capitalize;">@unit.DisplayName</h2>

                                @if (!string.IsNullOrEmpty(unit.DisplaySpecialization))
                                {
                                    <div style="font-size: 11.5px; color: #0369a1; font-weight: 700; margin-bottom: 8px;">@unit.DisplaySpecialization</div>
                                }

                                @if (unit.GroupId.HasValue)
                                {
                                    <div class="doc-select-code" style="color: #7c3aed; font-weight: 800; background: rgba(124, 58, 237, 0.08); padding: 4px 12px; border-radius: 20px; border: 1px solid rgba(124, 58, 237, 0.2); font-size: 12px; margin-bottom: 12px; display: inline-block;">Group: @unit.GroupName</div>
                                }
                                else if (unit.Dcode != null)
                                {
                                    <div class="doc-select-code" style="color: #0284c7; font-weight: 800; background: rgba(2, 132, 199, 0.08); padding: 4px 12px; border-radius: 20px; border: 1px solid rgba(2, 132, 199, 0.2); font-size: 12px; margin-bottom: 12px; display: inline-block;">Code: @unit.Dcode</div>
                                }

                                <div class="doc-patient-badge">
                                    <span class="pulse-dot"></span>
                                    <span>@unit.TokenCount OP Patients Waiting</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-center">
                        <div class="no-docs-card">
                            @if (!string.IsNullOrWhiteSpace(_doctorSearchQuery))
                            {
                                <i class="bi bi-search fs-2 mb-3 d-block"></i>
                                <h3 class="fw-bold mb-2">No Matching Doctors</h3>
                                <p class="mb-4 fs-6">We couldn't find any doctor matching "@_doctorSearchQuery".</p>
                                <button class="btn btn-outline-info px-4 py-2" @onclick="ClearDoctorSearch">
                                    Clear Filter
                                </button>
                            }
                            else
                            {
                                <i class="bi bi-hospital fs-1 text-primary mb-3 d-block"></i>
                                <h3 class="fw-bold mb-2">No Active Outpatient Visits Today</h3>
                                <p class="mb-4 fs-6">There are currently no patients waiting in today's Outpatient Visiting queue.<br/>Add direct walk-ins or check in patients in Outpatient Visiting to view live tokens.</p>
                                <div class="d-flex justify-content-center gap-2 mt-3">
                                    <button class="btn btn-outline-info px-4 py-2" @onclick="ToggleAdminDrawer">
                                        <i class="bi bi-sliders"></i> Open Settings
                                    </button>
                                    <button class="btn btn-primary px-4 py-2" @onclick='SelectAllDoctors'>
                                        Show Live Screen
                                    </button>
                                    <a href="/booking/outpatient" class="btn btn-outline-secondary px-4 py-2">
                                        <i class="bi bi-box-arrow-up-right"></i> Outpatient Dashboard
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- ══════════════ FULLSCREEN KIOSK DISPLAY ══════════════ -->
        <div class="kiosk-display">
            <div class="live-bg-container">
                <div class="live-bg-blob live-bg-blob-1"></div>
                <div class="live-bg-blob live-bg-blob-2"></div>
                <div class="live-bg-blob live-bg-blob-3"></div>
            </div>
            <div class="glass-panel">
                
                <!-- Top Floating Action Bar (Discreet Settings & Doctor Selection) -->
                <div class="top-floating-actions" style="position: absolute; top: 12px; right: 18px; z-index: 1000; display: flex; align-items: center; gap: 8px;">
                    <button type="button" class="btn btn-sm shadow-sm" 
                            style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(8px); border: 1px solid rgba(2, 132, 199, 0.25); color: #0284c7; border-radius: 20px; font-weight: 700; font-size: 12px; padding: 4px 12px; display: inline-flex; align-items: center; gap: 6px;"
                            @onclick="ClearDoctorSelection" title="Change Selected Doctor">
                        <i class="bi bi-person-badge"></i>
                        <span>@(GetSelectedDoctorUnit()?.DisplayName ?? "All Doctors")</span>
                    </button>
                    <button type="button" class="btn btn-sm shadow-sm" 
                            style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(8px); border: 1px solid rgba(2, 132, 199, 0.25); color: #0284c7; border-radius: 50%; width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;"
                            @onclick="ToggleAdminDrawer" title="Settings">
                        <i class="bi bi-gear-fill"></i>
                    </button>
                </div>

                <!-- MAIN 2-COLUMN QUEUE LAYOUT -->
                <main class="main-layout">

                    @{
                        var allQueue = GetDisplayQueue();
                        var consultItems = allQueue.Where(i => i.ColorTheme == "green").ToList();
                        var queueItems = allQueue.Where(i => i.ColorTheme == "orange" || i.ColorTheme == "blue" || i.ColorTheme == "purple").ToList();
                    }

                    <!-- ══════════════ LEFT: NOW CONSULTING HERO PANEL ══════════════ -->
                    <section class="consultation-panel d-flex flex-column h-100" style="overflow: hidden; padding: 0.75rem 1.25rem;">
                        <div class="panel-title-bar green-bar d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="sound-wave-active me-2">
                                    <span></span><span></span><span></span>
                                </span>
                                NOW IN OP CONSULTATION
                            </div>
                            @if (consultItems.Count > 1)
                            {
                                var activeIndex = (_consultRotationIndex % consultItems.Count) + 1;
                                <span style="font-size: 11px; font-weight: 800; opacity: 0.95; background: rgba(8, 85, 47, 0.15); padding: 3px 12px; border-radius: 12px; color: #08552f; border: 1px solid rgba(8, 85, 47, 0.25);">
                                    @activeIndex / @consultItems.Count
                                </span>
                            }
                        </div>

                        @if (consultItems.Any())
                        {
                            var safeIndex = _consultRotationIndex % consultItems.Count;
                            var item = consultItems[safeIndex];
                            var consultKey = $"op-consult-{item.Patient.op_id}-{safeIndex}";

                            <div @key="consultKey" class="consult-card consult-hero-full consult-entrance-premium @(_callingOpIds.Contains(item.Patient.op_id) ? "calling-pulse-green" : "")">
                                @if (consultItems.Count > 1)
                                {
                                    <div class="consult-rotation-progress-bar"></div>
                                }

                                <div class="consult-shimmer-sweep"></div>
                                
                                <div class="consult-live-pill">
                                    @if (_doctorStatuses.TryGetValue(item.Patient.dcode, out var curStatus) && curStatus.Equals("BUSY", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="pulse-beacon" style="background-color: #ef4444; box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);"></span>
                                        <span class="highlight-status" style="color: #ef4444; font-weight: 900; text-shadow: 0 0 10px rgba(239, 68, 68, 0.6); letter-spacing: 1px; text-transform: uppercase;">EMERGENCY</span>
                                    }
                                    else
                                    {
                                        <span class="pulse-beacon"></span>
                                        <span>NOW CONSULTING</span>
                                    }
                                </div>

                                <div class="consult-token-box consult-token-bounce hero-token-box">
                                    <span class="consult-token-lbl" style="font-size: 12px; letter-spacing: 0.15em; font-weight: 800; color: #047857;">TOKEN NUMBER</span>
                                    <span class="consult-token-val hero-token-val">@item.Patient.DisplayToken</span>
                                </div>

                                <div class="consult-info hero-consult-info d-flex flex-column flex-grow-1 justify-content-end" style="padding-bottom: 1.5rem;">
                                    <div class="consult-patient-name consult-name-fade hero-patient-name">@item.Patient.DisplayName</div>

                                    @if (!string.IsNullOrWhiteSpace(item.Patient.DisplayDoctorName))
                                    {
                                        <div class="consult-doctor-badge hero-doctor-badge">
                                            <i class="bi bi-person-badge-fill"></i>
                                            <span>@item.Patient.DisplayDoctorName</span>
                                        </div>
                                    }

                                    <div class="consult-status-row consult-badge-bounce mt-3 gap-3 justify-content-center w-100">
                                        <span class="consult-time hero-time-badge">
                                            <i class="bi bi-clock-fill"></i>
                                            @item.Patient.DisplayTime
                                        </span>
                                        <span class="consult-category-badge" style="background: rgba(2, 132, 199, 0.1); color: #0284c7; font-weight: 800; font-size: 12px; padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(2, 132, 199, 0.2);">
                                            <i class="bi bi-tag-fill"></i> @item.Patient.CategoryText
                                        </span>
                                    </div>

                                    <div class="consult-tag hero-consult-tag mt-auto w-100 mb-4">
                                        @if (item.StatusText.Contains("|"))
                                        {
                                            var parts = item.StatusText.Split('|');
                                            <div class="status-marquee-container" style="color: var(--green); display: block;">
                                                <marquee scrollamount="3" style="width: 100%; height: 100%; display: flex; align-items: center;">
                                                    <span style="font-size: 12.5px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; line-height: 22px;">
                                                        @parts[1].Trim() &nbsp; • &nbsp; @parts[0].Trim()
                                                    </span>
                                                </marquee>
                                            </div>
                                        }
                                        else
                                        {
                                            @item.StatusText
                                        }
                                    </div>
                                </div>

                                @if (consultItems.Count > 1)
                                {
                                    <div class="consult-mini-all-strip">
                                        <span class="consult-mini-label">
                                            <i class="bi bi-people-fill me-1"></i>ALL CONSULTING
                                        </span>
                                        <div class="consult-mini-chips">
                                            @for (int ci = 0; ci < consultItems.Count; ci++)
                                            {
                                                var cItem = consultItems[ci];
                                                var isActive = ci == safeIndex;
                                                <div class="consult-mini-chip @(isActive ? "consult-mini-chip-active" : "")">
                                                    <span class="consult-mini-chip-token">@cItem.Patient.DisplayToken</span>
                                                    <span class="consult-mini-chip-name">@cItem.Patient.DisplayName</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="consult-empty h-100 d-flex flex-column align-items-center justify-content-center pb-5">
                                <i class="bi bi-person-check-fill d-block mb-3" style="font-size: 54px; opacity: 0.3; color: #0284c7;"></i>
                                <span style="font-size: 18px; font-weight: 700; color: #64748b;">No Active Outpatient Consultation</span>
                                <p style="font-size: 13px; color: #94a3b8; margin-top: 4px;">Patients waiting will be called automatically</p>
                            </div>
                        }
                    </section>

                    <!-- ══════════════ RIGHT: OP QUEUE PANEL (GRID / LIST) ══════════════ -->
                    <section class="queue-panel h-100">
                        <div style="position: relative; width: 100%; margin-bottom: 1.5rem; padding: 0.5rem 1rem; border-bottom: 1px solid rgba(0,0,0,0.05); min-height: 54px;">
                            <div class="panel-title-bar amber-bar" style="margin: 0; padding: 6px 16px; border-radius: 20px; font-weight: 800; display: inline-flex; align-items: center; gap: 8px; position: absolute; left: 1rem; top: 0.5rem; z-index: 10;">
                                <i class="bi bi-people-fill"></i> OP WAITING QUEUE (@queueItems.Count)
                            </div>
                            <div style="position: absolute; right: 1rem; top: 0.5rem; display: flex; gap: 8px; z-index: 10;">
                                <button class="btn btn-sm shadow-sm" 
                                        style="border-radius: 20px !important; background: #ffffff !important; border: 1.5px solid #0284c7 !important; color: #0284c7 !important; font-weight: 800 !important; font-size: 13px !important; padding: 6px 16px !important; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.15) !important; display: inline-flex !important; align-items: center !important; gap: 6px !important; cursor: pointer !important;"
                                        @onclick="ToggleLayoutTheme" title="Switch View Mode (Grid / List)">
                                    <i class="bi @(LayoutTheme == "grid" ? "bi-table" : "bi-grid-fill")" style="font-size: 15px;"></i>
                                    <span>@(LayoutTheme == "grid" ? "List View" : "Grid View")</span>
                                </button>
                                <button class="btn btn-sm shadow-sm" 
                                        style="border-radius: 20px !important; background: #f0fdf4 !important; border: 1.5px solid #16a34a !important; color: #16a34a !important; font-weight: 800 !important; font-size: 13px !important; padding: 6px 14px !important;"
                                        @onclick="RefreshQueueManualAsync" title="Refresh Live Queue">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                        </div>

                        @if (queueItems.Any())
                        {
                            @if (LayoutTheme == "table")
                            {
                                <div class="queue-list-grid w-100 flex-grow-1">
                                    @foreach (var item in queueItems.Take(12))
                                    {
                                        var isCalling = _callingOpIds.Contains(item.Patient.op_id) && (item.ColorTheme == "orange" || item.ColorTheme == "purple");
                                        var rowClass = item.ColorTheme switch { "purple" => "purple-row", "orange" => "amber-row", _ => "blue-row" };
                                        var tokenClass = item.ColorTheme switch { "purple" => "purple-token", "orange" => "amber-token", _ => "blue-token" };
                                        var badgeClass = item.ColorTheme switch { "purple" => "badge-purple", "orange" => "badge-amber", _ => "badge-blue" };

                                        <div class="queue-row @rowClass fade-in-entry @(isCalling ? "calling-pulse-amber" : "")" style="align-items: center; padding-bottom: 0.5rem;">
                                            <div class="row-token-box @tokenClass">
                                                <span class="row-token-val">@item.Patient.DisplayToken</span>
                                            </div>
                                            <div class="d-flex flex-column flex-grow-1 min-w-0" style="overflow: hidden; padding-left: 1rem;">
                                                <div class="row-name d-flex align-items-center gap-2">
                                                    <span>@item.Patient.DisplayName</span>
                                                    @if (item.Patient.isvip == true || item.Patient.is_vip == true)
                                                    {
                                                        <span class="badge bg-warning text-dark" style="font-size: 10px; font-weight: 800; border-radius: 4px;">VIP</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(item.Patient.DisplayDoctorName))
                                                {
                                                    <div style="font-size: 11px; font-weight: 700; color: #0284c7; display: inline-flex; align-items: center; gap: 4px; margin-top: 2px; opacity: 0.9;">
                                                        <i class="bi bi-person-badge-fill" style="font-size: 10px;"></i>
                                                        @item.Patient.DisplayDoctorName
                                                    </div>
                                                }
                                                <div class="d-flex align-items-center gap-2 mt-1">
                                                    <span class="row-time" style="min-width: auto;"><i class="bi bi-clock"></i> @item.Patient.DisplayTime</span>
                                                    <span class="badge bg-light text-secondary border" style="font-size: 10px; font-weight: 700;">
                                                        @item.Patient.CategoryText
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="row-status" style="width: 220px; flex-shrink: 0; margin-left: auto; margin-right: 0;">
                                                <span class="row-badge @badgeClass" style="width: 100%; justify-content: center; padding: 6px 12px; border-radius: 8px;">
                                                    @if (item.StatusText.Contains("|"))
                                                    {
                                                        var parts = item.StatusText.Split('|');
                                                        <div class="status-marquee-container" style="display: block;">
                                                            <marquee scrollamount="3" style="width: 100%; height: 100%; display: flex; align-items: center;">
                                                                <span style="font-size: 12.5px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; line-height: 22px;">
                                                                    @parts[1].Trim() &nbsp; • &nbsp; @parts[0].Trim()
                                                                </span>
                                                            </marquee>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @item.StatusText
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="queue-grid flex-grow-1" style="margin-bottom: 0.5rem;">
                                    @foreach (var item in queueItems.Take(8))
                                    {
                                        if (item.ColorTheme == "orange")
                                        {
                                            <div class="queue-card amber-card fade-in-entry @(_callingOpIds.Contains(item.Patient.op_id) ? "calling-pulse-amber" : "")">
                                                <div class="card-token-box">
                                                    <span class="card-token-lbl">Token</span>
                                                    <span class="card-token-val">@item.Patient.DisplayToken</span>
                                                </div>
                                                <div class="card-info d-flex flex-column align-items-center gap-1">
                                                    <span class="card-name w-100 text-truncate text-center">@item.Patient.DisplayName</span>
                                                    @if (item.Patient.isvip == true || item.Patient.is_vip == true)
                                                    {
                                                        <span class="badge bg-warning text-dark" style="font-size: 10px; font-weight: 800;">VIP Patient</span>
                                                    }
                                                    <span class="card-time"><i class="bi bi-clock"></i> @item.Patient.DisplayTime</span>
                                                </div>
                                                <div class="card-status-badge">
                                                    @if (item.StatusText.Contains("|"))
                                                    {
                                                        var parts = item.StatusText.Split('|');
                                                        <div class="status-marquee-container" style="display: block;">
                                                            <marquee scrollamount="3" style="width: 100%; height: 100%; display: flex; align-items: center;">
