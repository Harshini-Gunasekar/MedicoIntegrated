    private void OnDoctorFilterSelect(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrEmpty(val))
        {
            _selectedDcode = null;
            _selectedGroupId = null;
            _hasSelectedDoctor = false;
        }
        else if (val.StartsWith("g_") && int.TryParse(val.Substring(2), out int gid))
        {
            _selectedGroupId = gid;
            _selectedDcode = null;
            _hasSelectedDoctor = true;
            var unit = GetAvailableDoctorUnits().FirstOrDefault(u => u.GroupId == gid);
            if (unit != null) DoctorName = unit.DisplayName;
        }
        else if (val.StartsWith("d_") && int.TryParse(val.Substring(2), out int dcode))
        {
            _selectedDcode = dcode;
            _selectedGroupId = null;
            _hasSelectedDoctor = true;
            var unit = GetAvailableDoctorUnits().FirstOrDefault(u => u.Dcode == dcode);
            if (unit != null) DoctorName = unit.DisplayName;
            else if (_doctorMasterDict.TryGetValue(dcode, out var md)) DoctorName = md.GetFormattedName();
        }
        StateHasChanged();
    }

