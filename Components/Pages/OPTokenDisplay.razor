    // ══════════════ INITIALIZATION & LIFECYCLE ══════════════
    protected override void OnInitialized()
    {
        var uri = new Uri(NavManager.Uri);
        var queryStr = uri.Query;
        if (!string.IsNullOrEmpty(queryStr))
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(queryStr);
            if (query.TryGetValue("doccode", out var doccodeValues) && int.TryParse(doccodeValues.First(), out int dcode))
            {
                QueryDocCode = dcode;
            }
            if (query.TryGetValue("tenant_code", out var tenantValues))
            {
                TenantCode = tenantValues.First() ?? "";
            }
        }

        if (string.IsNullOrEmpty(TenantCode) && !string.IsNullOrEmpty(TenantState?.TenantCode))
        {
            TenantCode = TenantState.TenantCode;
        }

        if (!string.IsNullOrWhiteSpace(TenantState?.TenantName))
        {
            HospitalName = TenantState.TenantName;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                if (tenantNameResult.Success && !string.IsNullOrWhiteSpace(tenantNameResult.Value))
                {
                    HospitalName = tenantNameResult.Value;
                }
                else if (!string.IsNullOrWhiteSpace(TenantState?.TenantName))
                {
                    HospitalName = TenantState.TenantName;
                }

                if (!string.IsNullOrEmpty(TenantCode))
                {
                    await _sessionStorage.SetAsync("tenant_code", TenantCode);
                }
                else
                {
                    var tenantResult = await _sessionStorage.GetAsync<string>("tenant_code");
                    if (_isDisposed) return;
                    if (tenantResult.Success && !string.IsNullOrEmpty(tenantResult.Value))
                    {
                        TenantCode = tenantResult.Value;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error reading tenant session in OPTokenDisplay: {ex.Message}");
            }

            if (!string.IsNullOrEmpty(TenantState?.TenantCode) && string.IsNullOrEmpty(TenantCode))
            {
                TenantCode = TenantState.TenantCode;
            }

            _isLoading = true;
            await FetchOpQueueFromApiAsync();
            _isLoading = false;

            if (QueryDocCode.HasValue)
            {
                var targetUnit = GetAvailableDoctorUnits().FirstOrDefault(u => u.Doctors.Any(d => d.Dcode == QueryDocCode.Value));
                if (targetUnit != null)
                {
                    SelectUnitToDisplay(targetUnit);
                }
                else
                {
                    _selectedDcode = QueryDocCode.Value;
                    _selectedGroupId = null;
                    _hasSelectedDoctor = true;
                }
            }
            
            StateHasChanged();

            // Start polling loop
            try
            {
                _ = StartPollingLoopAsync(_cts.Token);
            }
            catch (ObjectDisposedException) { }
        }
    }

    private async Task StartPollingLoopAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(1000, ct);

                await InvokeAsync(async () =>
                {
                    _now = DateTime.Now;
                    _apiPollCounter++;
                    _showcaseTickCounter++;
                    _consultRotationCounter++;

                    if (_consultRotationCounter >= 4)
                    {
                        _consultRotationCounter = 0;
                        _consultRotationIndex++;
                    }

                    if (_showcaseTickCounter <= 12)
                    {
                        _isShowcaseVisible = true;
                        _isShowcaseExiting = (_showcaseTickCounter >= 11);
                    }
                    else if (_showcaseTickCounter > 12 && _showcaseTickCounter < 72)
                    {
                        _isShowcaseVisible = false;
                        _isShowcaseExiting = false;
                    }
                    else if (_showcaseTickCounter >= 72)
                    {
                        _showcaseTickCounter = 0;
                        _isShowcaseVisible = true;
                        _isShowcaseExiting = false;
                        var availableUnits = GetAvailableDoctorUnits();
                        if (availableUnits.Count > 0)
                        {
                            _rotatingUnitIndex = (_rotatingUnitIndex + 1) % availableUnits.Count;
                        }
                    }

                    // Poll every 3 seconds for immediate detection of patients registered in Outpatient Visiting
                    if (_apiPollCounter >= 3 || _isFirstLoad)
                    {
                        _apiPollCounter = 0;
                        await FetchOpQueueFromApiAsync();
                    }
                    
                    StateHasChanged();
                });
            }
        }
        catch (TaskCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"[OP Polling Error] {ex.Message}");
        }
    }

    private string GetPatientStateKey(OpUnifiedTokenModel p) =>
        $"{p.op_id}|{p.visit_status}|{p.token_no}|{p.dcode}";

    // ══════════════ DATA FETCHING & SYNC ══════════════
    private async Task FetchOpQueueFromApiAsync()
    {
        try
        {
            await FetchDoctorMasterFromApiAsync();
            await FetchDoctorStatusesFromApiAsync();

            var today = DateTime.UtcNow.ToIndianTime().Date;
            var todayOnly = DateOnly.FromDateTime(today);

            // 1. Fetch All OP Registrations from Outpatient Visiting service
            var regs = await BookingService.GetAllOpRegistrationsAsync();

            _allOpRegistrations = regs ?? new List<OPRegistrationModel.OpRegistrationModel>();

            // 2. Filter strictly for today & active visits only (exclude completed, visited, served, confirmed, cancelled)
            var todayVisits = _allOpRegistrations
                .Where(r => !r.isdeleted && 
                            ((r.visit_date != default(DateOnly) && r.visit_date == todayOnly) || 
                             (r.visit_date == default(DateOnly) && r.created_at != DateTime.MinValue && r.created_at.ToIndianTime().Date == today)) &&
                            !string.Equals(r.visit_status, "COMPLETED", StringComparison.OrdinalIgnoreCase) &&
                            !string.Equals(r.visit_status, "VISITED", StringComparison.OrdinalIgnoreCase) &&
                            !string.Equals(r.visit_status, "CONFIRMED", StringComparison.OrdinalIgnoreCase) &&
                            !string.Equals(r.visit_status, "SERVED", StringComparison.OrdinalIgnoreCase) &&
                            !string.Equals(r.visit_status, "CANCELLED", StringComparison.OrdinalIgnoreCase))
                .DistinctBy(r => r.op_id)
                .ToList();

            // 3. Convert to Unified Display Model & Enrich with Doctor details
            var unifiedList = new List<OpUnifiedTokenModel>();

            foreach (var r in todayVisits)
            {
                var doc = _doctorMasterDict.TryGetValue(r.dcode, out var dm) ? dm : null;

                string docName = (doc != null && !string.Equals(doc.name, "SELF", StringComparison.OrdinalIgnoreCase) && !string.Equals(doc.doctorfullname, "SELF", StringComparison.OrdinalIgnoreCase))
                    ? doc.GetFormattedName()
                    : (!string.IsNullOrWhiteSpace(r.doctor_name) && !r.doctor_name.Trim().Equals("SELF", StringComparison.OrdinalIgnoreCase)
                        ? r.doctor_name
                        : (doc != null ? doc.GetFormattedName() : (r.dcode > 0 ? $"Doctor #{r.dcode}" : "OP Consultant")));

                string? qual = doc?.qualification;
                string? room = doc?.room_no;
                int? groupId = doc?.group_id;

                string? spec = null;
                if (doc?.spcode.HasValue == true && doc.spcode.Value > 0 && _specialtyDict.TryGetValue(doc.spcode.Value, out var spName))
                {
                    spec = spName;
                }
                else if (!string.IsNullOrWhiteSpace(doc?.doctorfullname) && 
                         !doc.doctorfullname.Trim().Equals("SELF", StringComparison.OrdinalIgnoreCase) && 
                         !doc.doctorfullname.Trim().Equals(doc.name, StringComparison.OrdinalIgnoreCase))
                {
                    spec = doc.doctorfullname;
                }

                unifiedList.Add(new OpUnifiedTokenModel
                {
                    op_id = r.op_id,
                    op_no = r.op_no,
                    token_no = !string.IsNullOrWhiteSpace(r.token_no) ? r.token_no : (r.queue_no.HasValue ? r.queue_no.Value.ToString() : "1"),
                    custid = r.custid,
                    patient_name = r.patient_name,
                    dcode = r.dcode,
                    doctor_name = docName,
                    doctor_qualification = qual,
                    doctor_specialization = spec,
                    room_no = room,
                    group_id = groupId,
                    visit_status = string.IsNullOrWhiteSpace(r.visit_status) ? "WAITING" : r.visit_status.ToUpper(),
                    reg_type = string.IsNullOrWhiteSpace(r.reg_type) ? "OP" : r.reg_type,
                    is_dressing = r.is_dressing,
                    isvip = r.isvip,
                    is_vip = r.is_vip,
                    viprole = r.viprole,
                    visit_date = r.visit_date,
                    slot_start_time = r.slot_start_time,
                    slot_end_time = r.slot_end_time,
                    created_at = r.created_at,
                    notes = r.notes,
                    service_name = r.service_name
                });
            }

            // 4. Detect status changes & new arrivals
            if (_isFirstLoad)
            {
                _allPatients = unifiedList;
                var firstQueue = GetDisplayQueue();
                var firstUpNext = firstQueue.FirstOrDefault(i => i.ColorTheme == "orange")?.Patient;
                if (firstUpNext != null && !string.IsNullOrEmpty(firstUpNext.DisplayToken))
                {
                    _lastAnnouncedNextToken = firstUpNext.DisplayToken;
                }

                _lastPatientStateSnapshot.Clear();
                foreach (var p in unifiedList)
                {
                    _lastPatientStateSnapshot[p.op_id] = GetPatientStateKey(p);
                }
                _isFirstLoad = false;
                return;
            }

            var changedPatients = new List<OpUnifiedTokenModel>();
            foreach (var p in unifiedList)
            {
                string newKey = GetPatientStateKey(p);
                if (_lastPatientStateSnapshot.TryGetValue(p.op_id, out var oldKey))
                {
                    if (oldKey != newKey)
                    {
                        changedPatients.Add(p);
                    }
                }
                else
                {
                    // Brand new patient added in Outpatient Visiting!
                    changedPatients.Add(p);
                }
                _lastPatientStateSnapshot[p.op_id] = newKey;
            }

            _allPatients = unifiedList;
            StateHasChanged();

            // 5. Automatic Audio Announcements
            if (changedPatients.Any())
            {
                var relevantChanged = changedPatients.Where(p =>
                    _selectedGroupId.HasValue 
                        ? p.group_id == _selectedGroupId.Value 
                        : (_selectedDcode.HasValue ? p.dcode == _selectedDcode.Value : true)
                ).ToList();

                var toAnnounce = relevantChanged
                    .OrderByDescending(p => p.visit_status.Contains("CONSULT"))
                    .ToList();

                foreach (var changed in toAnnounce)
                {
                    await CallToken(changed);
                    if (toAnnounce.Count > 1)
                    {
                        await Task.Delay(500);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OP Fetch Error] {ex.Message}");
        }
    }

