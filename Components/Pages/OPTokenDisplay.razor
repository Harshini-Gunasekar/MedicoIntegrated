@page "/op-token-display"
@page "/optoken-display"
@rendermode InteractiveServer
@using Medico.Components.Pages
@using Booking.Models
@using Booking.Services
@using Booking.Helpers
@using medico_backend.Model
@using SharedComponents.Rcl.Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@layout SharedComponents.Rcl.Components.Layout.EmptyLayout
<link href="tokendisplay.css" rel="stylesheet" />
@implements IDisposable
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavManager
@inject AppointmentBookingService BookingService
@inject DoctorService DoctorService
@inject DoctorSpecialtyMasterService DoctorSpecialtyMasterService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject ProtectedSessionStorage _sessionStorage

<PageTitle>OP Token Display Signage - Outpatient Visiting</PageTitle>

<div class="op-signage-root">

    @if (!HasAnyActiveTokens && !_isAdminOpen)
    {
        <!-- ══════════════ 1. CLEAN IDLE / STANDBY DISPLAY (NO TOKENS) ══════════════ -->
        <div class="kiosk-display idle-standby-display justify-content-center align-items-center">
            <div class="live-bg-container">
                <div class="live-bg-blob live-bg-blob-1"></div>
                <div class="live-bg-blob live-bg-blob-2"></div>
                <div class="live-bg-blob live-bg-blob-3"></div>
            </div>

            <!-- Top Floating Action Bar (Discreet Settings) -->
            <div class="top-floating-actions" style="position: absolute; top: 16px; right: 20px; z-index: 1000; display: flex; align-items: center; gap: 8px;">
                <button type="button" class="btn btn-sm idle-settings-btn shadow-sm" 
                        @onclick="ToggleAdminDrawer" title="Settings">
                    <i class="bi bi-gear-fill"></i>
                </button>
            </div>

            <div class="idle-standby-content text-center">
                @if (_isLoading)
                {
                    <div class="doc-loading-state">
                        <div class="doc-loading-spinner">
                            <div class="spinner-ring"></div>
                            <div class="spinner-ring spinner-ring-2"></div>
                            <div class="spinner-ring spinner-ring-3"></div>
                        </div>
                        <p class="doc-loading-text">Connecting to Live Outpatient Queue...</p>
                    </div>
                }
                else
                {
                    <!-- Hospital Branding Badge -->
                    <div class="idle-header-brand">
                        <span class="idle-hospital-pill">
                            <i class="bi bi-hospital"></i>
                            <span>@(string.IsNullOrWhiteSpace(HospitalName) ? "MEDICO HOSPITAL" : HospitalName.ToUpper())</span>
                        </span>
                    </div>

                    <!-- OPD Department Title & Subtitle -->
                    <div class="idle-title-group">
                        <h1 class="idle-dept-title">
                            Outpatient Department
                        </h1>
                        <p class="idle-dept-subtitle">
                            மருத்துவர் புறநோயாளி பிரிவு
                        </p>
                    </div>

                    <!-- Modern Digital Clock Card -->
                    <div class="idle-clock-card">
                        <div class="idle-clock-time">
                            @_now.ToString("hh:mm")<span class="idle-clock-sec">:@_now.ToString("ss")</span> <span class="idle-clock-ampm">@_now.ToString("tt")</span>
                        </div>
                        <div class="idle-clock-divider"></div>
                        <div class="idle-clock-date">
                            <i class="bi bi-calendar3 me-2"></i>@_now.ToString("dddd, dd MMMM yyyy")
                        </div>
                    </div>

                    <!-- Clean Live Standby Status -->
                    <div class="idle-footer-status">
                        <div class="idle-status-indicator">
                            <span class="idle-pulse-dot"></span>
                            <span>Live Queue Standby • Tokens will appear automatically</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- ══════════════ 2. FULLSCREEN KIOSK DISPLAY (ALL OP TOKENS LIVE) ══════════════ -->
        <div class="kiosk-display">
            <div class="live-bg-container">
                <div class="live-bg-blob live-bg-blob-1"></div>
                <div class="live-bg-blob live-bg-blob-2"></div>
                <div class="live-bg-blob live-bg-blob-3"></div>
            </div>
            <div class="glass-panel">
                
                @{
                    var selectedUnit = GetSelectedDoctorUnit();
                    var availableUnits = GetAvailableDoctorUnits();
                    var allQueue = GetDisplayQueue();
                    var consultItems = allQueue.Where(i => i.ColorTheme == "green").ToList();
                    var queueItems = allQueue.Where(i => i.ColorTheme == "orange" || i.ColorTheme == "blue" || i.ColorTheme == "purple").ToList();
                }

                <!-- TOP HEADER BAR: BRAND, CENTER DOCTOR NAME, DOCTOR QUICK SELECT & SETTINGS -->
                <header class="signage-top-header">
                    <div class="header-left">
                        <div class="brand-badge">
                            <i class="bi bi-hospital"></i>
                            <span>@(string.IsNullOrWhiteSpace(HospitalName) ? "MEDICO HOSPITAL" : HospitalName.ToUpper())</span>
                        </div>
                    </div>

                    <div class="header-center">
                        @if (selectedUnit != null)
                        {
                            <div class="top-doctor-banner">
                                @if (!string.IsNullOrWhiteSpace(selectedUnit.DisplayImageUrl))
                                {
                                    <img src="@selectedUnit.DisplayImageUrl" alt="@selectedUnit.DisplayName" class="top-doctor-avatar-img" />
                                }
                                else
                                {
                                    <div class="top-doctor-avatar-initial">@GetInitial(selectedUnit.DisplayName)</div>
                                }
                                <div class="top-doctor-text-wrap">
                                    <div class="top-doctor-title">
                                        <span>@selectedUnit.DisplayName</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(selectedUnit.DisplaySpecialization) || !string.IsNullOrWhiteSpace(selectedUnit.DisplayQualification))
                                    {
                                        <div class="top-doctor-subtitle">
                                            @if (!string.IsNullOrWhiteSpace(selectedUnit.DisplaySpecialization) && !selectedUnit.DisplaySpecialization.Trim().Equals("SELF", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span>@selectedUnit.DisplaySpecialization</span>
                                                @if (!string.IsNullOrWhiteSpace(selectedUnit.DisplayQualification))
                                                {
                                                    <span>• @selectedUnit.DisplayQualification</span>
                                                }
                                            }
                                            else if (!string.IsNullOrWhiteSpace(selectedUnit.DisplayQualification))
                                            {
                                                <span>@selectedUnit.DisplayQualification</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="top-doctor-banner">
                                <div class="top-doctor-avatar-initial top-doctor-avatar-opd">
                                    <i class="bi bi-hospital"></i>
                                </div>
                                <div class="top-doctor-text-wrap">
                                    <div class="top-doctor-title">
                                        <span>Outpatient Department (OPD)</span>
                                    </div>
                                    <div class="top-doctor-subtitle">
                                        <span>All Specialists Live Queue</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="header-right">
                        <!-- Quick Doctor Selector (Doctors with Bookings) -->
                        <div class="doctor-quick-select-wrap">
                            <i class="bi bi-person-lines-fill doctor-select-icon"></i>
                            <select class="doctor-quick-select" @onchange="OnDoctorFilterSelect">
                                <option value="" selected="@(!_hasSelectedDoctor || (_selectedDcode == null && _selectedGroupId == null))">All Doctors / Specialists</option>
                                @foreach (var unit in availableUnits)
                                {
                                    var unitVal = unit.GroupId.HasValue ? $"g_{unit.GroupId}" : $"d_{unit.Dcode}";
                                    var isSelected = _hasSelectedDoctor && ((_selectedGroupId.HasValue && unit.GroupId == _selectedGroupId.Value) || (_selectedDcode.HasValue && unit.Dcode == _selectedDcode.Value));
                                    <option value="@unitVal" selected="@isSelected">@unit.DisplayName (@unit.TokenCount Tokens)</option>
                                }
                            </select>
                        </div>

                        <button type="button" class="top-settings-btn" @onclick="ToggleAdminDrawer" title="Settings">
                            <i class="bi bi-gear-fill"></i>
                        </button>
                    </div>
                </header>

                <!-- MAIN 2-COLUMN QUEUE LAYOUT -->
                <main class="main-layout">

                    <!-- ══════════════ LEFT: NOW CONSULTING HERO PANEL ══════════════ -->
                    <section class="consultation-panel d-flex flex-column h-100" style="overflow: hidden; padding: 0.75rem 1.25rem;">
                        <div class="panel-title-bar green-bar d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="sound-wave-active me-2">
                                    <span></span><span></span><span></span>
                                </span>
                                NOW IN OP CONSULTATION
                            </div>
                            @if (consultItems.Count > 1)
                            {
                                var activeIndex = (_consultRotationIndex % consultItems.Count) + 1;
                                <span style="font-size: 11px; font-weight: 800; opacity: 0.95; background: rgba(8, 85, 47, 0.15); padding: 3px 12px; border-radius: 12px; color: #08552f; border: 1px solid rgba(8, 85, 47, 0.25);">
                                    @activeIndex / @consultItems.Count
                                </span>
                            }
                        </div>

                        @if (consultItems.Any())
                        {
                            var safeIndex = _consultRotationIndex % consultItems.Count;
                            var item = consultItems[safeIndex];
                            var consultKey = $"op-consult-{item.Patient.op_id}-{safeIndex}";

                            <div @key="consultKey" class="consult-card consult-hero-full consult-entrance-premium @(_callingOpIds.Contains(item.Patient.op_id) ? "calling-pulse-green" : "")">
                                @if (consultItems.Count > 1)
                                {
                                    <div class="consult-rotation-progress-bar"></div>
                                }

                                <div class="consult-shimmer-sweep"></div>
                                
                                <div class="consult-live-pill">
                                    @if (_doctorStatuses.TryGetValue(item.Patient.dcode, out var curStatus) && curStatus.Equals("BUSY", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="pulse-beacon" style="background-color: #ef4444; box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);"></span>
                                        <span class="highlight-status" style="color: #ef4444; font-weight: 900; text-shadow: 0 0 10px rgba(239, 68, 68, 0.6); letter-spacing: 1px; text-transform: uppercase;">EMERGENCY</span>
                                    }
                                    else
                                    {
                                        <span class="pulse-beacon"></span>
                                        <span>NOW CONSULTING</span>
                                    }
                                </div>

                                <div class="consult-token-box consult-token-bounce hero-token-box">
                                    <span class="consult-token-lbl" style="font-size: 12px; letter-spacing: 0.15em; font-weight: 800; color: #047857;">TOKEN NUMBER</span>
                                    <span class="consult-token-val hero-token-val">@item.Patient.DisplayToken</span>
                                </div>

                                <div class="consult-info hero-consult-info d-flex flex-column flex-grow-1 justify-content-end" style="padding-bottom: 1.5rem;">
                                    <div class="consult-patient-name consult-name-fade hero-patient-name">@item.Patient.DisplayName</div>

                                    <div class="consult-status-row consult-badge-bounce mt-3 gap-3 justify-content-center w-100">
                                        <span class="consult-time hero-time-badge">
                                            <i class="bi bi-clock-fill"></i>
                                            @item.Patient.DisplayTime
                                        </span>
                                    </div>

                                    <div class="consult-tag hero-consult-tag mt-auto w-100 mb-4">
                                        @if (item.StatusText.Contains("|"))
                                        {
                                            var parts = item.StatusText.Split('|');
                                            <div class="status-marquee-container" style="color: var(--green); display: block;">
                                                <marquee scrollamount="3" style="width: 100%; height: 100%; display: flex; align-items: center;">
                                                    <span style="font-size: 12.5px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; line-height: 22px;">
                                                        @parts[1].Trim() &nbsp; • &nbsp; @parts[0].Trim()
                                                    </span>
                                                </marquee>
                                            </div>
                                        }
                                        else
                                        {
                                            @item.StatusText
                                        }
                                    </div>
                                </div>

                                @if (consultItems.Count > 1)
                                {
                                    <div class="consult-mini-all-strip">
                                        <span class="consult-mini-label">
                                            <i class="bi bi-people-fill me-1"></i>ALL CONSULTING
                                        </span>
                                        <div class="consult-mini-chips">
                                            @for (int ci = 0; ci < consultItems.Count; ci++)
                                            {
                                                var cItem = consultItems[ci];
                                                var isActive = ci == safeIndex;
                                                <div class="consult-mini-chip @(isActive ? "consult-mini-chip-active" : "")">
                                                    <span class="consult-mini-chip-token">@cItem.Patient.DisplayToken</span>
                                                    <span class="consult-mini-chip-name">@cItem.Patient.DisplayName</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="consult-empty h-100 d-flex flex-column align-items-center justify-content-center pb-5">
                                <i class="bi bi-person-check-fill d-block mb-3" style="font-size: 54px; opacity: 0.3; color: #0284c7;"></i>
                                <span style="font-size: 18px; font-weight: 700; color: #64748b;">No Active Outpatient Consultation</span>
                                <p style="font-size: 13px; color: #94a3b8; margin-top: 4px;">Patients waiting will be called automatically</p>
                            </div>
                        }
                    </section>

                    <!-- ══════════════ RIGHT: OP QUEUE PANEL (GRID / LIST) ══════════════ -->
                    <section class="queue-panel h-100">
                        <div style="position: relative; width: 100%; margin-bottom: 1rem; padding: 0.5rem 1rem; border-bottom: 1px solid rgba(0,0,0,0.05); min-height: 54px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                            <div class="panel-title-bar amber-bar" style="margin: 0; padding: 6px 16px; border-radius: 20px; font-weight: 800; display: inline-flex; align-items: center; gap: 8px;">
                                <i class="bi bi-people-fill"></i> OP QUEUE (@queueItems.Count)
                            </div>

                            <div style="display: flex; gap: 8px;">
                                <button class="btn btn-sm shadow-sm" 
                                        style="border-radius: 20px !important; background: #ffffff !important; border: 1.5px solid #0284c7 !important; color: #0284c7 !important; font-weight: 800 !important; font-size: 13px !important; padding: 6px 16px !important; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.15) !important; display: inline-flex !important; align-items: center !important; gap: 6px !important; cursor: pointer !important;"
                                        @onclick="ToggleLayoutTheme" title="Switch View Mode (Grid / List)">
                                    <i class="bi @(LayoutTheme == "grid" ? "bi-table" : "bi-grid-fill")" style="font-size: 15px;"></i>
                                    <span>@(LayoutTheme == "grid" ? "List View" : "Grid View")</span>
                                </button>
                                <button class="btn btn-sm shadow-sm" 
                                        style="border-radius: 20px !important; background: #f0fdf4 !important; border: 1.5px solid #16a34a !important; color: #16a34a !important; font-weight: 800 !important; font-size: 13px !important; padding: 6px 14px !important;"
                                        @onclick="RefreshQueueManualAsync" title="Refresh Live Queue">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                        </div>

                        @if (queueItems.Any())
                        {
                            @if (LayoutTheme == "table")
                            {
                                <div class="queue-list-grid w-100 flex-grow-1">
                                    @foreach (var item in queueItems.Take(12))
                                    {
                                        var isCalling = _callingOpIds.Contains(item.Patient.op_id) && (item.ColorTheme == "orange" || item.ColorTheme == "purple");
                                        var rowClass = item.ColorTheme switch { "purple" => "purple-row", "orange" => "amber-row", _ => "blue-row" };
                                        var tokenClass = item.ColorTheme switch { "purple" => "purple-token", "orange" => "amber-token", _ => "blue-token" };
                                        var badgeClass = item.ColorTheme switch { "purple" => "badge-purple", "orange" => "badge-amber", _ => "badge-blue" };

                                        <div class="queue-row @rowClass fade-in-entry @(isCalling ? "calling-pulse-amber" : "")" style="align-items: center; padding-bottom: 0.5rem;">
                                            <div class="row-token-box @tokenClass">
                                                <span class="row-token-val">@item.Patient.DisplayToken</span>
                                            </div>
                                            <div class="d-flex flex-column flex-grow-1 min-w-0" style="overflow: hidden; padding-left: 1rem; text-align: left; align-items: flex-start;">
                                                <div class="row-name d-flex align-items-center gap-2 text-start">
                                                    <span>@item.Patient.DisplayName</span>
                                                    @if (item.Patient.isvip == true || item.Patient.is_vip == true)
                                                    {
                                                        <span class="badge bg-warning text-dark" style="font-size: 10px; font-weight: 800; border-radius: 4px;">VIP</span>
                                                    }
                                                </div>
                                                <div class="d-flex align-items-center gap-2 mt-1 text-start" style="justify-content: flex-start;">
                                                    <span class="row-time text-start" style="min-width: auto;"><i class="bi bi-clock"></i> @item.Patient.DisplayTime</span>
                                                </div>
                                            </div>
                                            <div class="row-status" style="width: 220px; flex-shrink: 0; margin-left: auto; margin-right: 0;">
                                                <span class="row-badge @badgeClass" style="width: 100%; justify-content: center; padding: 6px 12px; border-radius: 8px;">
                                                    @if (item.StatusText.Contains("|"))
                                                    {
                                                        var parts = item.StatusText.Split('|');
                                                        <div class="status-marquee-container" style="display: block;">
                                                            <marquee scrollamount="3" style="width: 100%; height: 100%; display: flex; align-items: center;">
                                                                <span style="font-size: 12.5px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; line-height: 22px;">
                                                                    @parts[1].Trim() &nbsp; • &nbsp; @parts[0].Trim()
                                                                </span>
                                                            </marquee>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @item.StatusText
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="queue-grid flex-grow-1" style="margin-bottom: 0.5rem;">
                                    @foreach (var item in queueItems.Take(8))
                                    {
                                        if (item.ColorTheme == "orange")
                                        {
                                            <div class="queue-card amber-card fade-in-entry @(_callingOpIds.Contains(item.Patient.op_id) ? "calling-pulse-amber" : "")">
                                                <div class="card-token-box">
                                                    <span class="card-token-lbl">TOKEN</span>
                                                    <span class="card-token-val">@item.Patient.DisplayToken</span>
                                                </div>
                                                <div class="card-info d-flex flex-column align-items-center justify-content-center gap-1">
                                                    <span class="card-name w-100 text-truncate text-center">@item.Patient.DisplayName</span>
                                                    @if (item.Patient.isvip == true || item.Patient.is_vip == true)
                                                    {
                                                        <span class="badge bg-warning text-dark" style="font-size: 10px; font-weight: 800;">VIP Patient</span>
                                                    }
                                                    <span class="card-time text-center"><i class="bi bi-clock"></i> @item.Patient.DisplayTime</span>
                                                </div>
                                                <div class="card-status-badge">
                                                    @if (item.StatusText.Contains("|"))
                                                    {
                                                        var parts = item.StatusText.Split('|');
                                                        <div class="status-marquee-container" style="display: block;">
                                                            <marquee scrollamount="3" style="width: 100%; height: 100%; display: flex; align-items: center;">
                                                                <span style="font-size: 12.5px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; line-height: 22px;">
                                                                    @parts[1].Trim() &nbsp; • &nbsp; @parts[0].Trim()
                                                                </span>
                                                            </marquee>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @item.StatusText
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else if (item.ColorTheme == "purple")
                                        {
                                            <div class="queue-card purple-card fade-in-entry @(_callingOpIds.Contains(item.Patient.op_id) ? "calling-pulse-purple" : "")">
                                                <div class="card-token-box">
                                                    <span class="card-token-lbl">TOKEN</span>
                                                    <span class="card-token-val">@item.Patient.DisplayToken</span>
                                                </div>
                                                <div class="card-info d-flex flex-column align-items-center justify-content-center gap-1">
                                                    <span class="card-name w-100 text-truncate text-center">@item.Patient.DisplayName</span>
                                                    @if (item.Patient.isvip == true || item.Patient.is_vip == true)
                                                    {
                                                        <span class="badge bg-warning text-dark" style="font-size: 10px; font-weight: 800;">VIP Patient</span>
                                                    }
                                                    <span class="card-time text-center"><i class="bi bi-clock"></i> @item.Patient.DisplayTime</span>
                                                </div>
                                                <div class="card-status-badge">
                                                    @if (item.StatusText.Contains("|"))
                                                    {
                                                        var parts = item.StatusText.Split('|');
                                                        <div class="status-marquee-container" style="display: block;">
                                                            <marquee scrollamount="3" style="width: 100%; height: 100%; display: flex; align-items: center;">
                                                                <span style="font-size: 12.5px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; line-height: 22px;">
                                                                    @parts[1].Trim() &nbsp; • &nbsp; @parts[0].Trim()
                                                                </span>
                                                            </marquee>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @item.StatusText
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else if (item.ColorTheme == "blue")
                                        {
                                            <div class="queue-card blue-card fade-in-entry">
                                                <div class="card-token-box">
                                                    <span class="card-token-lbl">TOKEN</span>
                                                    <span class="card-token-val">@item.Patient.DisplayToken</span>
                                                </div>
                                                <div class="card-info d-flex flex-column align-items-center justify-content-center gap-1">
                                                    <span class="card-name w-100 text-truncate text-center">@item.Patient.DisplayName</span>
                                                    @if (item.Patient.isvip == true || item.Patient.is_vip == true)
                                                    {
                                                        <span class="badge bg-warning text-dark" style="font-size: 10px; font-weight: 800;">VIP Patient</span>
                                                    }
                                                    <span class="card-time text-center"><i class="bi bi-clock"></i> @item.Patient.DisplayTime</span>
                                                </div>
                                                <div class="card-status-badge">
                                                    @if (item.StatusText.Contains("|"))
                                                    {
                                                        var parts = item.StatusText.Split('|');
                                                        <div class="status-marquee-container" style="display: block;">
                                                            <marquee scrollamount="3" style="width: 100%; height: 100%; display: flex; align-items: center;">
                                                                <span style="font-size: 12.5px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; line-height: 22px;">
                                                                    @parts[1].Trim() &nbsp; • &nbsp; @parts[0].Trim()
                                                                </span>
                                                            </marquee>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @item.StatusText
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="queue-empty flex-grow-1 d-flex flex-column align-items-center justify-content-center">
                                <i class="bi bi-people fs-2 mb-2 d-block opacity-25"></i>
                                <span style="font-weight: 700; color: #64748b;">No OP Patients Waiting in Queue</span>
                                <span style="font-size: 12px; color: #94a3b8; margin-top: 4px;">New walk-ins and checked-in patients appear here in real time</span>
                            </div>
                        }

                        <!-- Status Legend Guide -->
                        <div class="status-legend" style="position: fixed; bottom: 65px; right: 30px; z-index: 1000;">
                            <div class="legend-item legend-green">
                                <span class="legend-color-box"></span>
                                <div class="legend-text">
