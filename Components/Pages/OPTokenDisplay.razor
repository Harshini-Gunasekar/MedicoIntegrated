    private async Task FetchDoctorMasterFromApiAsync()
    {
        try
        {
            string baseUrl = Configuration["ApiSettings:MedicoApiUrl"] ?? "https://medicoapi.iscansoft.com/";
            string url = $"{baseUrl.TrimEnd('/')}/api/DoctorMaster/get?_t={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";

            using var http = HttpClientFactory.CreateClient();
            using var request = new HttpRequestMessage(HttpMethod.Get, url);
            string tenant = !string.IsNullOrEmpty(TenantCode) ? TenantCode : (!string.IsNullOrEmpty(TenantState.TenantCode) ? TenantState.TenantCode : "0004");
            request.Headers.Add("tenant_code", tenant);
            request.Headers.CacheControl = new System.Net.Http.Headers.CacheControlHeaderValue { NoCache = true, NoStore = true };

            using var response = await http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var docs = await response.Content.ReadFromJsonAsync<List<TokenDoctorMasterModel>>(_jsonOptions);
                if (docs != null)
                {
                    _doctorMasterList = docs;
                    foreach (var doc in _doctorMasterList.Where(d => !string.IsNullOrWhiteSpace(d.doctorimage)))
                    {
                        doc.DoctorImageBase64 = await FetchDoctorImageBase64Async(doc.doctorimage);
                    }
                    _doctorMasterDict = docs.Where(d => !d.deleted && d.dcode > 0).ToDictionary(d => d.dcode!.Value, d => d);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OP DoctorMaster Error] {ex.Message}");
        }
    }

    private async Task<string?> FetchDoctorImageBase64Async(string? doctorImageKey)
    {
        if (string.IsNullOrWhiteSpace(doctorImageKey)) return null;
        if (doctorImageKey.StartsWith("data:image", StringComparison.OrdinalIgnoreCase)) return doctorImageKey;
        if (_doctorImageBase64Cache.TryGetValue(doctorImageKey, out var cachedUri)) return cachedUri;

        try
        {
            string baseUrl = Configuration["ApiSettings:MedicoApiUrl"] ?? "https://medicoapi.iscansoft.com/";
            string cleanKey = doctorImageKey;
            if (cleanKey.StartsWith("/api/files/download?key=", StringComparison.OrdinalIgnoreCase))
            {
                cleanKey = cleanKey.Substring("/api/files/download?key=".Length);
            }
            cleanKey = Uri.UnescapeDataString(cleanKey);

            string url = $"{baseUrl.TrimEnd('/')}/api/files/download?key={Uri.EscapeDataString(cleanKey)}";

            using var http = HttpClientFactory.CreateClient();
            using var request = new HttpRequestMessage(HttpMethod.Get, url);
            string tenant = !string.IsNullOrEmpty(TenantCode) ? TenantCode : (!string.IsNullOrEmpty(TenantState.TenantCode) ? TenantState.TenantCode : "0004");
            request.Headers.Add("tenant_code", tenant);

            using var response = await http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var fileRes = await response.Content.ReadFromJsonAsync<Booking.Models.FileDownloadResponse>(_jsonOptions);
                if (fileRes != null && !string.IsNullOrWhiteSpace(fileRes.base64))
                {
                    string rawB64 = fileRes.base64.Trim();
                    if (rawB64.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
                    {
                        _doctorImageBase64Cache[doctorImageKey] = rawB64;
                        return rawB64;
                    }

                    string mimeType = !string.IsNullOrWhiteSpace(fileRes.contentType)
                        ? fileRes.contentType
                        : (fileRes.fileName?.EndsWith(".png", StringComparison.OrdinalIgnoreCase) == true ? "image/png" : "image/jpeg");

                    string formattedDataUri = $"data:{mimeType};base64,{rawB64}";
                    _doctorImageBase64Cache[doctorImageKey] = formattedDataUri;
                    return formattedDataUri;
                }
            }
        }
        catch { }

        return null;
    }

    private string? GetDoctorImageUrl(string? doctorImageKey)
    {
        if (string.IsNullOrWhiteSpace(doctorImageKey)) return null;
        if (doctorImageKey.StartsWith("data:image", StringComparison.OrdinalIgnoreCase) ||
            doctorImageKey.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            doctorImageKey.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return doctorImageKey;
        }

        if (_doctorImageBase64Cache.TryGetValue(doctorImageKey, out var cached))
        {
            return cached;
        }

        string baseUrl = Configuration["ApiSettings:MedicoApiUrl"] ?? "https://medicoapi.iscansoft.com/";
        return $"{baseUrl.TrimEnd('/')}/api/files/download?key={Uri.EscapeDataString(doctorImageKey)}";
    }

    private async Task FetchDoctorStatusesFromApiAsync()
    {
        try
        {
            string baseUrl = Configuration["ApiSettings:MedicoApiUrl"] ?? "https://medicoapi.iscansoft.com/";
            string url = $"{baseUrl.TrimEnd('/')}/api/DoctorCurrentStatus/get?_t={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";

            using var http = HttpClientFactory.CreateClient();
            using var request = new HttpRequestMessage(HttpMethod.Get, url);
            string tenant = !string.IsNullOrEmpty(TenantCode) ? TenantCode : (!string.IsNullOrEmpty(TenantState.TenantCode) ? TenantState.TenantCode : "0004");
            request.Headers.Add("tenant_code", tenant);
            request.Headers.CacheControl = new System.Net.Http.Headers.CacheControlHeaderValue { NoCache = true, NoStore = true };

            using var response = await http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var docStatuses = await response.Content.ReadFromJsonAsync<List<Booking.Models.DoctorCurrentStatusModel>>(_jsonOptions);
                if (docStatuses != null)
                {
                    foreach (var ds in docStatuses)
                    {
                        if (!string.IsNullOrEmpty(ds.status))
                        {
                            string newStatus = ds.status;
                            _doctorStatuses[(int)ds.dcode] = newStatus;
