    private DoctorDisplayUnit? GetCurrentRotatingOrSelectedUnit()
    {
        var selectedUnit = GetSelectedDoctorUnit();
        if (selectedUnit != null) return selectedUnit;

        var availableUnits = GetAvailableDoctorUnits();
        if (availableUnits.Count > 0)
        {
            int safeIndex = _rotatingUnitIndex % availableUnits.Count;
            return availableUnits[safeIndex];
        }

        return null;
    }

    private DoctorDisplayUnit? GetSelectedDoctorUnit()
    {
        if (_selectedGroupId.HasValue)
        {
            return GetAvailableDoctorUnits().FirstOrDefault(u => u.GroupId == _selectedGroupId.Value);
        }
        else if (_selectedDcode.HasValue)
        {
            return GetAvailableDoctorUnits().FirstOrDefault(u => u.Dcode == _selectedDcode.Value);
        }
        return null;
    }

