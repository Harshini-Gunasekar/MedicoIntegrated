    private DoctorDisplayUnit? GetCurrentRotatingOrSelectedUnit()
    {
        var selectedUnit = GetSelectedDoctorUnit();
        if (selectedUnit != null) return selectedUnit;

        var availableUnits = GetAvailableDoctorUnits();
        if (availableUnits.Count > 0)
        {
            int safeIndex = _rotatingUnitIndex % availableUnits.Count;
            return availableUnits[safeIndex];
        }

        return null;
    }

    private DoctorDisplayUnit? GetSelectedDoctorUnit()
    {
        if (_selectedGroupId.HasValue)
        {
            var unit = GetAvailableDoctorUnits().FirstOrDefault(u => u.GroupId == _selectedGroupId.Value);
            if (unit != null) return unit;
            return null;
        }
        else if (_selectedDcode.HasValue)
        {
            var unit = GetAvailableDoctorUnits().FirstOrDefault(u => u.Dcode == _selectedDcode.Value);
            if (unit != null) return unit;

            if (_doctorMasterDict.TryGetValue(_selectedDcode.Value, out var masterDoc))
            {
                string? spec = null;
                if (masterDoc.spcode.HasValue && masterDoc.spcode.Value > 0 && _specialtyDict.TryGetValue(masterDoc.spcode.Value, out var spName))
                {
                    spec = spName;
                }

                return new DoctorDisplayUnit
                {
                    Dcode = _selectedDcode.Value,
                    DisplayName = masterDoc.GetFormattedName(),
                    DisplayQualification = masterDoc.qualification,
                    DisplaySpecialization = spec,
                    TokenCount = 0
                };
            }
        }
        return null;
    }

    private string GetDoctorName()
    {
        var unit = GetSelectedDoctorUnit();
        if (unit != null) return unit.DisplayName;
        return DoctorName;
    }

    private string? GetDoctorCredentials()
    {
        var unit = GetSelectedDoctorUnit();
        if (unit != null) return unit.DisplayQualification;
        return !string.IsNullOrEmpty(DoctorCredentials) ? DoctorCredentials : null;
    }

    private string? GetDoctorSpecialty()
    {
        var unit = GetSelectedDoctorUnit();
        if (unit != null) return unit.DisplaySpecialization;
        return !string.IsNullOrEmpty(DoctorSpecialty) ? DoctorSpecialty : null;
    }

    private string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "D";
        var cleaned = name.Trim();
        if (cleaned.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase)) cleaned = cleaned.Substring(3).Trim();
        else if (cleaned.StartsWith("Dr ", StringComparison.OrdinalIgnoreCase)) cleaned = cleaned.Substring(3).Trim();
        cleaned = cleaned.TrimStart('.', ' ');
        if (!string.IsNullOrEmpty(cleaned)) return cleaned[0].ToString().ToUpper();
        return name.Trim()[0].ToString().ToUpper();
    }

    private string GetDynamicTickerMessage()
    {
        bool hasEmergency = false;
        if (_selectedDcode.HasValue && _doctorStatuses.TryGetValue(_selectedDcode.Value, out var st) && st.Equals("BUSY", StringComparison.OrdinalIgnoreCase))
        {
            hasEmergency = true;
        }
        if (hasEmergency)
        {
            return "Doctor is in emergency. Please wait for some time. | மருத்துவர் அவசர சிகிச்சையில் உள்ளார், சிறிது நேரம் காத்திருக்கவும். | " + TickerMessage;
        }
        return TickerMessage;
    }

