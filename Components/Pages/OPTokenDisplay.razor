                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OP Doctor Status Error] {ex.Message}");
        }
    }

    // ══════════════ QUEUE BUILDING & MAPPING ══════════════
    private List<OpPatientQueueDisplayItem> GetDisplayQueue()
    {
        var displayList = new List<OpPatientQueueDisplayItem>();

        var activePatients = _allPatients
            .Where(p => !string.Equals(p.visit_status, "COMPLETED", StringComparison.OrdinalIgnoreCase) &&
                        !string.Equals(p.visit_status, "SERVED", StringComparison.OrdinalIgnoreCase) &&
                        !string.Equals(p.visit_status, "CANCELLED", StringComparison.OrdinalIgnoreCase) &&
                        (_selectedGroupId.HasValue ? p.group_id == _selectedGroupId.Value : (_selectedDcode == null || p.dcode == _selectedDcode)))
            .OrderBy(p => int.TryParse(p.token_no, out int tn) ? tn : 9999)
            .ThenBy(p => p.created_at)
            .ToList();

        // 1. GREEN: In Consultation
        var consulting = activePatients
            .Where(p => p.visit_status.Contains("CONSULT"))
            .ToList();

        foreach (var p in consulting)
        {
            displayList.Add(new OpPatientQueueDisplayItem
            {
                Patient = p,
                ColorTheme = "green",
                StatusText = "NOW IN CONSULTATION|மருத்துவர் பரிசோதனையில்",
                StatusSubtext = "OP Consultation"
            });
        }

        // 2. ORANGE (Up Next) + BLUE (Waiting) + PURPLE (Dressing / Others)
        var waitingPatients = activePatients
            .Where(p => !p.visit_status.Contains("CONSULT"))
            .ToList();

        for (int i = 0; i < waitingPatients.Count; i++)
        {
            var p = waitingPatients[i];
            bool isDressing = p.is_dressing || p.reg_type.Equals("DRESSING", StringComparison.OrdinalIgnoreCase);

            if (isDressing)
            {
                displayList.Add(new OpPatientQueueDisplayItem
                {
                    Patient = p,
                    ColorTheme = "purple",
                    StatusText = "DRESSING PROCEDURE|டிரெஸ்ஸிங் பரிசோதனை",
                    StatusSubtext = "Proceed to dressing room"
                });
            }
            else if (i == 0 && !consulting.Any())
            {
                // Next in line
                displayList.Add(new OpPatientQueueDisplayItem
                {
                    Patient = p,
                    ColorTheme = "orange",
                    StatusText = "NEXT IN LINE|அடுத்து நீங்கள் செல்லவும்",
                    StatusSubtext = "Please prepare to enter"
                });
            }
            else if (i == 0 && consulting.Any())
            {
                // Up next while someone is consulting
                displayList.Add(new OpPatientQueueDisplayItem
                {
                    Patient = p,
                    ColorTheme = "orange",
                    StatusText = "UP NEXT|அடுத்து நீங்கள் செல்லவும்",
                    StatusSubtext = "Please be ready"
                });
            }
            else
            {
                displayList.Add(new OpPatientQueueDisplayItem
                {
                    Patient = p,
                    ColorTheme = "blue",
                    StatusText = "WAITING|காத்திருக்கவும்",
                    StatusSubtext = "Waiting in OP lounge"
                });
            }
        }

        return displayList;
    }

    private List<DoctorDisplayUnit> GetAvailableDoctorUnits()
    {
        var activePatients = _allPatients
            .Where(p => !string.Equals(p.visit_status, "COMPLETED", StringComparison.OrdinalIgnoreCase) &&
                        !string.Equals(p.visit_status, "CANCELLED", StringComparison.OrdinalIgnoreCase))
            .ToList();

        var doctors = activePatients
            .GroupBy(p => p.dcode)
            .Select(g => {
                int dcodeKey = g.Key;
                _doctorMasterDict.TryGetValue(dcodeKey, out var masterDoc);

                var firstWithDocName = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.doctor_name));
                var firstWithQual = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.doctor_qualification));
                var firstWithSpec = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.doctor_specialization));
                var firstWithGroupId = g.FirstOrDefault(x => x.group_id.HasValue);
                var firstWithGroupName = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.group_name));
                var firstWithRoom = g.FirstOrDefault(x => !string.IsNullOrEmpty(x.room_no));

                string docName = masterDoc?.GetFormattedName() 
                    ?? firstWithDocName?.doctor_name 
                    ?? $"Doctor {dcodeKey}";

                string? qual = !string.IsNullOrWhiteSpace(masterDoc?.qualification) 
                    ? masterDoc.qualification 
                    : firstWithQual?.doctor_qualification;

                string? room = masterDoc?.room_no != null 
                    ? masterDoc.room_no.ToString() 
                    : firstWithRoom?.room_no;

                int? groupId = (int?)masterDoc?.group_id ?? firstWithGroupId?.group_id;
                string? imageUrl = masterDoc != null ? (masterDoc.DoctorImageBase64 ?? GetDoctorImageUrl(masterDoc.doctorimage)) : null;

                return new TempDoctorInfo
                {
                    Dcode = dcodeKey,
                    DoctorName = docName,
                    DoctorQualification = qual,
                    DoctorSpecialization = firstWithSpec?.doctor_specialization,
                    GroupId = groupId,
                    GroupName = firstWithGroupName?.group_name,
                    RoomNo = room,
                    DoctorImageUrl = imageUrl,
                    Tokens = g.ToList()
                };
            })
            .ToList();

        var units = new List<DoctorDisplayUnit>();

        // 1. Grouped by GroupId
        var groups = doctors.Where(d => d.GroupId.HasValue).GroupBy(d => d.GroupId!.Value);
        foreach (var gp in groups)
        {
            var list = gp.ToList();
            var groupName = list.FirstOrDefault(d => !string.IsNullOrEmpty(d.GroupName))?.GroupName ?? $"Group {gp.Key}";
            var combinedName = string.Join(" & ", list.Select(d => d.DoctorName));
            var combinedQual = string.Join(", ", list.Where(d => !string.IsNullOrEmpty(d.DoctorQualification)).Select(d => d.DoctorQualification).Distinct());
            var combinedSpec = string.Join(", ", list.Where(d => !string.IsNullOrEmpty(d.DoctorSpecialization)).Select(d => d.DoctorSpecialization).Distinct());
            var displayImg = list.FirstOrDefault(d => !string.IsNullOrEmpty(d.DoctorImageUrl))?.DoctorImageUrl;

            units.Add(new DoctorDisplayUnit
            {
                GroupId = gp.Key,
                GroupName = groupName,
                DisplayName = combinedName,
                DisplayQualification = combinedQual,
                DisplaySpecialization = combinedSpec,
                DisplayImageUrl = displayImg,
                TokenCount = list.Sum(d => d.Tokens.Count),
                Doctors = list.Select(d => new ConstituentDoctor
                {
                    Dcode = d.Dcode,
                    DoctorName = d.DoctorName,
                    DoctorQualification = d.DoctorQualification,
                    DoctorSpecialization = d.DoctorSpecialization,
                    RoomNo = d.RoomNo,
                    DoctorImageUrl = d.DoctorImageUrl
                }).ToList()
            });
        }

        // 2. Individual doctors without group
        var individualDocs = doctors.Where(d => !d.GroupId.HasValue);
        foreach (var d in individualDocs)
        {
            units.Add(new DoctorDisplayUnit
            {
                GroupId = null,
                GroupName = null,
                Dcode = d.Dcode,
                DisplayName = d.DoctorName,
                DisplayQualification = d.DoctorQualification,
                DisplaySpecialization = d.DoctorSpecialization,
                DisplayImageUrl = d.DoctorImageUrl,
                TokenCount = d.Tokens.Count,
                Doctors = new List<ConstituentDoctor>
                {
                    new ConstituentDoctor
                    {
                        Dcode = d.Dcode,
                        DoctorName = d.DoctorName,
                        DoctorQualification = d.DoctorQualification,
                        DoctorSpecialization = d.DoctorSpecialization,
                        RoomNo = d.RoomNo,
                        DoctorImageUrl = d.DoctorImageUrl
                    }
                }
            });
        }

        return units.OrderByDescending(u => u.TokenCount).ToList();
    }

