    // ══════════════ AUDIO ANNOUNCEMENTS ══════════════
    private async Task CallToken(OpUnifiedTokenModel token)
    {
        var displayQueue = GetDisplayQueue();
        var match = displayQueue.FirstOrDefault(item => item.Patient.op_id == token.op_id);
        _callingColorTheme = match?.ColorTheme ?? "green";

        _callingOpIds.Add(token.op_id);
        _callingOpPatient = token;
        _showCallOverlay = true;
        StateHasChanged();
        
        string announcementText = "";
        var pName = !string.IsNullOrWhiteSpace(token.patient_name) ? token.patient_name : "";

        if (SelectedLanguage == "ta-IN")
        {
            if (token.RegistrationCategory == "DRESSING")
            {
                announcementText = $"அன்பான வேண்டுகோள். டோக்கன் எண் {token.DisplayToken}, {pName}, தயவுசெய்து டிரெஸ்ஸிங் அறைக்கு வரவும்.";
            }
            else if (token.RegistrationCategory == "OTHERS")
            {
                announcementText = $"அன்பான வேண்டுகோள். டோக்கன் எண் {token.DisplayToken}, {pName}, தயவுசெய்து சிறப்பு சிகிச்சைக்கு வரவும்.";
            }
            else if (token.visit_status.Contains("CONSULT"))
            {
                announcementText = $"அன்பான வேண்டுகோள். அவுட்பேஷியன்ட் டோக்கன் எண் {token.DisplayToken}, {pName}, தயவுசெய்து மருத்துவர் ஆலோசனைக்கு வரவும்.";
            }
            else
            {
                announcementText = $"அன்பான வேண்டுகோள். அடுத்த டோக்கன் எண் {token.DisplayToken}, {pName}, தயவுசெய்து தயாராக இருக்கவும்.";
            }
        }
        else
        {
            if (token.RegistrationCategory == "DRESSING")
            {
                announcementText = $"Token number {token.DisplayToken}, {pName}, please proceed to dressing procedure.";
            }
            else if (token.RegistrationCategory == "OTHERS")
            {
                announcementText = $"Token number {token.DisplayToken}, {pName}, please proceed for {token.CategoryLabel}.";
            }
            else if (token.visit_status.Contains("CONSULT"))
            {
                announcementText = $"Outpatient token number {token.DisplayToken}, {pName}, please proceed to doctor consultation.";
            }
            else
            {
                announcementText = $"Next token number {token.DisplayToken}, {pName}, please be ready.";
            }
        }

        try
        {
            await JS.InvokeVoidAsync("hospitalAudio.playChimeAndSpeak", announcementText, SelectedLanguage, SpeechRate, SpeechPitch);
        }
        catch { }
        
        _ = Task.Delay(4500).ContinueWith(_ =>
        {
            _callingOpIds.Remove(token.op_id);
            _showCallOverlay = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task TestVoiceChime()
    {
        string testStr = SelectedLanguage == "ta-IN" ? "அவுட்பேஷியன்ட் டோக்கன் அறிவிப்பு சோதனை" : "Outpatient token display voice chime test successful.";
        await JS.InvokeVoidAsync("hospitalAudio.playChimeAndSpeak", testStr, SelectedLanguage, SpeechRate, SpeechPitch);
    }

    public void Dispose()
    {
        _isDisposed = true;
        try
        {
            _cts.Cancel();
            _cts.Dispose();
        }
        catch (ObjectDisposedException) { }
    }
