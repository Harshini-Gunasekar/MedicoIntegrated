@page "/doctor-group-master"
@page "/doctorgroupmaster"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Booking.Services
@using Medico_Backend.Model
@inject DoctorGroupMasterService DoctorGroupService
@inject ToastService Toast
@inject NavigationManager NavigationManager
@inject Booking.Services.RoleMasterService RoleService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage _sessionStorage

<PageTitle>Doctor Group Master</PageTitle>

<style>
    html:has(.dgm-page),
    body:has(.dgm-page) {
        overflow: hidden !important;
        height: 100vh !important;
        max-height: 100vh !important;
        margin: 0 !important;
    }

    .app-container:has(.dgm-page),
    .app-main-wrapper:has(.dgm-page) {
        height: 100vh !important;
        max-height: 100vh !important;
        overflow: hidden !important;
    }

    .main-content:has(.dgm-page) {
        height: calc(100vh - 35px) !important;
        max-height: calc(100vh - 35px) !important;
        flex: 1 1 0 !important;
        min-height: 0 !important;
        overflow: hidden !important;
        padding: 0.35rem 0.75rem 0.45rem 0.75rem !important;
        display: flex !important;
        flex-direction: column !important;
        box-sizing: border-box !important;
        background: #f1f5fb !important;
    }

    .dgm-page {
        height: 100% !important;
        max-height: 100% !important;
        flex: 1 1 0 !important;
        min-height: 0 !important;
        overflow: hidden !important;
        display: flex !important;
        flex-direction: column !important;
        gap: 0.35rem !important;
        padding: 0 !important;
        box-sizing: border-box !important;
    }

    .dgm-page .lab-header-card {
        flex: 0 0 auto !important;
        margin: 0 !important;
        padding: 0.4rem 0.85rem !important;
    }

    .dgm-page .directory-section {
        background: #ffffff !important;
        border-radius: 8px !important;
        border: 1px solid #cbd5e1 !important;
        overflow: hidden !important;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.04) !important;
        display: flex !important;
        flex-direction: column !important;
        flex: 1 1 auto !important;
        min-height: 0 !important;
        margin: 0 !important;
    }

    .dgm-page .lc-table-container {
        flex: 1 1 auto !important;
        min-height: 0 !important;
        max-height: calc(100vh - 170px) !important;
        overflow-y: auto !important;
        overflow-x: auto !important;
        width: 100% !important;
        border-top-left-radius: 8px !important;
        border-top-right-radius: 8px !important;
    }

    .dgm-page .lc-table-container::-webkit-scrollbar {
        width: 7px !important;
        height: 7px !important;
        display: block !important;
    }
    .dgm-page .lc-table-container::-webkit-scrollbar-track {
        background: #f1f5f9 !important;
        border-radius: 4px !important;
    }
    .dgm-page .lc-table-container::-webkit-scrollbar-thumb {
        background: #94a3b8 !important;
        border-radius: 4px !important;
    }
    .dgm-page .lc-table-container::-webkit-scrollbar-thumb:hover {
        background: #64748b !important;
    }

    .dgm-page .lc-table {
        width: 100% !important;
        border-collapse: collapse !important;
        text-align: left !important;
    }

    .dgm-page .lc-table thead,
    .dgm-page .lc-table thead tr {
        background: #0876ad !important;
        background: linear-gradient(90deg, #076a9f 0%, #087db8 100%) !important;
        border-bottom: 1px solid #07547c !important;
        height: 32px !important;
    }

    .dgm-page .lc-table thead th,
    .dgm-page .lc-table th {
        position: sticky !important;
        top: 0 !important;
        z-index: 10 !important;
        height: 32px !important;
        box-sizing: border-box !important;
        padding: 5px 8px !important;
        color: #ffffff !important;
        background: #0876ad !important;
        background: linear-gradient(90deg, #076a9f 0%, #087db8 100%) !important;
        border-bottom: 1px solid #07547c !important;
        border-right: 1px solid rgba(255, 255, 255, 0.18) !important;
        font-size: 11px !important;
        font-weight: 700 !important;
        letter-spacing: 0.4px !important;
        text-transform: uppercase !important;
        white-space: nowrap !important;
        vertical-align: middle !important;
    }

    .dgm-page .lc-table thead th:last-child,
    .dgm-page .lc-table th:last-child {
        border-right: none !important;
    }

    .dgm-page .lc-table td {
        padding: 4px 8px !important;
        border-bottom: 1px solid #edf2f7 !important;
        border-right: 1px solid #f8fafc !important;
        font-size: 11.5px !important;
        line-height: 1.2 !important;
        vertical-align: middle !important;
        white-space: nowrap !important;
        color: #334155 !important;
        height: 34px !important;
    }

    .dgm-page .lc-table tbody tr {
        height: 34px !important;
        min-height: 34px !important;
        transition: background 0.1s ease !important;
    }

    .dgm-page .lc-table tbody tr:nth-child(even) {
        background: #fcfdfe !important;
    }

    .dgm-page .lc-table tbody tr:nth-child(odd) {
