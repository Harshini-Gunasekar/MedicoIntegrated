@page "/doctor-group-master"
@page "/doctorgroupmaster"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Booking.Services
@using Medico_Backend.Model
@inject DoctorGroupMasterService DoctorGroupService
@inject ToastService Toast
@inject NavigationManager NavigationManager

<PageTitle>Doctor Group Master</PageTitle>

<div class="referral-page lc-fadeInUp">
    <DnaLoader IsLoading="@isLoading" Message="Loading Doctor Groups..." />

    <!-- TOP HEADER CARD (Matching Lab Test Entry design) -->
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">folder_shared</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Doctor Group Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">DOCTOR GROUP & TOKEN CONFIGURATION</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search Group Name, Code, Description..." 
                       @bind="searchQuery" 
                       @bind:event="oninput" 
                       class="lc-rounded-pill-input lc-w-280" />
            </div>
            <div>
                <button type="button" class="btn-new-entry" @onclick="CreateNew">
                    + Add New Group
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN DATA TABLE CARD -->
    <div class="directory-section">
        <div class="lc-table-container">
            <table class="lc-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">S.NO</th>
                        <th>GROUP NAME</th>
                        <th style="width: 110px;">SHORT NAME</th>
                        <th style="width: 120px;">TOKEN PREFIX</th>
                        <th style="width: 170px;">TOKEN TYPE</th>
                        <th>DESCRIPTION</th>
                        <th style="width: 90px;">ORDER</th>
                        <th style="width: 100px;">STATUS</th>
                        <th class="text-center" style="width: 100px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredGroupList.Any())
                    {
                        int sno = 1;
                        @foreach (var group in FilteredGroupList)
                        {
                            <tr class="lc-table-row">
                                <td><span class="font-bold text-indigo-600">@(sno++)</span></td>
                                <td class="font-bold text-slate-800">@(group.group_name ?? "-")</td>
                                <td class="lc-font-mono font-bold text-slate-600">@(string.IsNullOrWhiteSpace(group.short_name) ? "-" : group.short_name)</td>
                                <td class="lc-font-mono font-bold text-indigo-600">@(string.IsNullOrWhiteSpace(group.token_prefix) ? "-" : group.token_prefix)</td>
                                <td>
                                    @if (group.token_type?.ToUpper() == "GROUP")
                                    {
                                        <span class="badge-status badge-token-group" title="Shared token across all doctors in the group">Shared (Group)</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-token-doctor" title="Each doctor gets their own independent token sequence">Independent (Doctor)</span>
                                    }
                                </td>
                                <td class="text-slate-600">@(string.IsNullOrWhiteSpace(group.description) ? "-" : group.description)</td>
                                <td class="text-slate-600 font-bold">@group.display_order</td>
                                <td>
                                    @if (group.is_active)
                                    {
                                        <span class="badge-status badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-inactive">Inactive</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="flex justify-center gap-8" style="display: flex; justify-content: center; gap: 8px;">
                                        <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => EditGroup(group)" title="Edit Group">
                                            <span class="material-symbols-outlined font-18 text-slate-400">edit</span>
                                        </button>
                                        <button type="button" class="lc-btn lc-circle-btn-32 text-red-500" @onclick="() => PromptDelete(group)" title="Delete Group">
                                            <span class="material-symbols-outlined font-18 text-red-500">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center p-48">
                                <div class="empty-state-subtle" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: #94a3b8;">
                                    <span class="material-symbols-outlined" style="font-size: 36px;">folder_off</span>
                                    No doctor groups found matching your search.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ADD / EDIT MODAL FORM -->
    @if (showForm)
    {
        <div class="modal-overlay" @onclick="CancelEdit">
            <div class="modal-form-card" @onclick:stopPropagation>
                <div class="modal-header-bar">
                    <h3>@(isEditing ? "Edit Doctor Group" : "New Doctor Group Entry")</h3>
                    <button type="button" class="modal-close-btn" @onclick="CancelEdit" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                        </svg>
                    </button>
                </div>

                <div class="modal-body">
                    <div class="cm-container">
                        <div class="cm-field cm-col-6">
                            <label class="cm-label-top">GROUP NAME <span style="color: #ef4444;">*</span></label>
                            <input type="text" @bind="currentGroup.group_name" class="cm-input" placeholder="e.g. General OP, Pediatrics..." />
                        </div>

                        <div class="cm-field cm-col-6">
                            <label class="cm-label-top">SHORT NAME</label>
                            <input type="text" @bind="currentGroup.short_name" class="cm-input" placeholder="e.g. GENOP" />
                        </div>

                        <div class="cm-field cm-col-6">
                            <label class="cm-label-top">TOKEN PREFIX</label>
                            <input type="text" @bind="currentGroup.token_prefix" class="cm-input" placeholder="e.g. A, B, GOP" />
                        </div>

                        <div class="cm-field cm-col-6">
                            <label class="cm-label-top">TOKEN TYPE <span style="color: #ef4444;">*</span></label>
                            <select @bind="currentGroup.token_type" class="cm-input">
                                <option value="GROUP">Shared Token (Group)</option>
                                <option value="DOCTOR">Independent Token (Doctor)</option>
                            </select>
                        </div>

                        <div class="cm-field cm-col-6">
                            <label class="cm-label-top">DISPLAY ORDER</label>
                            <input type="number" @bind="currentGroup.display_order" class="cm-input" min="1" />
                        </div>

                        <div class="cm-field cm-col-12">
                            <label class="cm-label-top">DESCRIPTION</label>
                            <input type="text" @bind="currentGroup.description" class="cm-input" placeholder="Optional description for this group..." />
                        </div>

                        <div class="cm-field cm-col-12" style="flex-direction: row; align-items: center; gap: 8px; margin-top: 6px;">
                            <input type="checkbox" id="chkActive" @bind="currentGroup.is_active" style="width: 16px; height: 16px; accent-color: #4f46e5; cursor: pointer;" />
                            <label for="chkActive" style="font-size: 13.5px; font-weight: 600; color: #1e293b; cursor: pointer;">Is Active</label>
                        </div>
                    </div>
                </div>

                <div class="modal-footer-bar">
                    <button type="button" class="btn-action-outline" @onclick="CancelEdit">Cancel</button>
                    <button type="button" class="btn-new-entry" style="border-radius: 8px; padding: 8px 24px;" @onclick="SaveGroup">
                        <span>@(isEditing ? "Save Changes" : "+ Add Group")</span>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool showForm = false;
    private bool isEditing = false;
    private string searchQuery = "";

    private List<DoctorGroupMasterModel> groupList = new();
    private DoctorGroupMasterModel currentGroup = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadGroupsAsync();
    }

    private async Task LoadGroupsAsync()
    {
        try
        {
            isLoading = true;
            groupList = await DoctorGroupService.GetDoctorGroupsAsync() ?? new();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading doctor groups: {ex.Message}");
            Toast.ShowError("Failed to load doctor groups.");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private IEnumerable<DoctorGroupMasterModel> FilteredGroupList =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? groupList.Where(g => !g.is_deleted)
            : groupList.Where(g => !g.is_deleted && (
                (g.group_name != null && g.group_name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (g.short_name != null && g.short_name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (g.token_prefix != null && g.token_prefix.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (g.description != null && g.description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (g.token_type != null && g.token_type.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            ));

    private void CreateNew()
    {
        isEditing = false;
        currentGroup = new DoctorGroupMasterModel
        {
            token_type = "GROUP",
            display_order = groupList.Count + 1,
            is_active = true,
            usercode = 1,
            computercode = 1
        };
        showForm = true;
    }

    private void EditGroup(DoctorGroupMasterModel item)
    {
        isEditing = true;
        currentGroup = new DoctorGroupMasterModel
        {
            group_id = item.group_id,
            group_name = item.group_name,
            short_name = item.short_name,
            description = item.description,
            token_type = item.token_type,
            display_order = item.display_order,
            is_active = item.is_active,
            is_deleted = item.is_deleted,
            tenant_code = item.tenant_code,
            usercode = item.usercode,
            computercode = item.computercode,
            entereddate = item.entereddate,
            ibsdate = item.ibsdate
        };
        showForm = true;
    }

    private async Task SaveGroup()
    {
        if (string.IsNullOrWhiteSpace(currentGroup.group_name))
        {
            Toast.ShowWarning("Please enter Group Name.");
            return;
        }

        isLoading = true;
        bool success = false;

        if (isEditing)
        {
            currentGroup.ibsdate = DateTime.Now;
            success = await DoctorGroupService.UpdateDoctorGroupAsync(currentGroup);
            if (success)
            {
                Toast.ShowSuccess("Doctor Group updated successfully.");
            }
            else
            {
                Toast.ShowError("Failed to update Doctor Group.");
            }
        }
        else
        {
            currentGroup.entereddate = DateTime.Now;
            currentGroup.ibsdate = DateTime.Now;
            success = await DoctorGroupService.InsertDoctorGroupAsync(currentGroup);
            if (success)
            {
                Toast.ShowSuccess("New Doctor Group created successfully.");
            }
            else
            {
                Toast.ShowError("Failed to create Doctor Group.");
            }
        }

        if (success)
        {
            showForm = false;
            await LoadGroupsAsync();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task PromptDelete(DoctorGroupMasterModel item)
    {
        isLoading = true;
        bool success = await DoctorGroupService.DeleteDoctorGroupAsync(item.group_id);
        if (success)
        {
            Toast.ShowSuccess($"Doctor Group '{item.group_name}' deleted.");
            await LoadGroupsAsync();
        }
        else
        {
            Toast.ShowError($"Failed to delete Doctor Group #{item.group_id}.");
            isLoading = false;
        }
    }

    private void CancelEdit()
    {
        showForm = false;
    }
}
