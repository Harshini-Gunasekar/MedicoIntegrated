    private decimal TotalSplitAllocated => formFeeSplits.Sum(s => s.amount);
    private decimal UnallocatedBalance => Math.Max(0, (formProcedureFee ?? 0) - TotalSplitAllocated);

    private string GetFeeCategoryLabel(Guid feeTypeId)
    {
        var cat = feeSplitMastersList.FirstOrDefault(m => m.fee_type_id == feeTypeId);
        return cat?.fee_type_label ?? "Fee Share";
    }

    private void OnSearchFocus()
    {
        showSearchDropdown = true;
        highlightedIndex = -1;
    }

    private async Task OnSearchBlur()
    {
        await Task.Delay(200);
        showSearchDropdown = false;
        highlightedIndex = -1;
        StateHasChanged();
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (!showSearchDropdown)
        {
            showSearchDropdown = true;
        }

        var list = FilteredCategories;
        if (!list.Any()) return;

        if (e.Key == "ArrowDown")
        {
            highlightedIndex = (highlightedIndex + 1) % list.Count;
        }
        else if (e.Key == "ArrowUp")
        {
            highlightedIndex = (highlightedIndex - 1 + list.Count) % list.Count;
        }
        else if (e.Key == "Enter")
        {
            if (highlightedIndex >= 0 && highlightedIndex < list.Count)
            {
                SelectCategory(list[highlightedIndex]);
            }
            else if (list.Count > 0)
            {
                SelectCategory(list[0]);
            }
        }
        else if (e.Key == "Escape")
        {
            showSearchDropdown = false;
            highlightedIndex = -1;
        }
    }

    private void SelectCategory(OtFeeSplitMasterModel cat)
    {
        newSplitFeeTypeId = cat.fee_type_id;
        _chargeHeadSearchText = cat.fee_type_label;
        showSearchDropdown = false;
        highlightedIndex = -1;
    }

    private void AddFeeSplitLineItem()
    {
        if (newSplitFeeTypeId == Guid.Empty)
        {
            var matched = feeSplitMastersList.FirstOrDefault(m => m.is_active && m.fee_type_label.Equals(chargeHeadSearchText.Trim(), StringComparison.OrdinalIgnoreCase));
            if (matched != null)
            {
                newSplitFeeTypeId = matched.fee_type_id;
            }
            else
            {
                ToastService.ShowError("Please select a Breakup Charge Head.");
                return;
            }
        }

        if (newSplitAmount <= 0)
        {
            ToastService.ShowError("Please enter a valid amount.");
            return;
        }

        if (formFeeSplits.Any(s => s.fee_type_id == newSplitFeeTypeId))
        {
            ToastService.ShowError("This charge head is already added.");
            return;
        }

        var catLabel = GetFeeCategoryLabel(newSplitFeeTypeId);
        
        string defaultStaffName = catLabel;
        int? defaultDcode = null;
        if (catLabel.Contains("Surgeon", StringComparison.OrdinalIgnoreCase) && !catLabel.Contains("Assistant", StringComparison.OrdinalIgnoreCase) && formDoctorCode > 0)
        {
            defaultDcode = formDoctorCode;
            defaultStaffName = GetDoctorDisplayName(formDoctorCode);
        }

        var item = new OtFeeSplitItemModel
        {
            item_id = Guid.NewGuid(),
            request_id = formRequestId,
            fee_type_id = newSplitFeeTypeId,
            fee_type_label = catLabel,
            dcode = defaultDcode,
            staff_name = defaultStaffName,
            amount = newSplitAmount,
            remarks = null,
            created_at = DateTime.UtcNow
        };

        formFeeSplits.Add(item);

        // Reset input fields
        newSplitFeeTypeId = Guid.Empty;
        _chargeHeadSearchText = "";
        newSplitAmount = 0;
        selectedSplitRow = null;
        StateHasChanged();
    }

    private void RemoveSelectedBreakupRate()
    {
        if (selectedSplitRow == null)
        {
            ToastService.ShowError("Please select a row from the list to remove.");
            return;
        }

        formFeeSplits.Remove(selectedSplitRow);
        if (isEditMode && selectedSplitRow.item_id != Guid.Empty && !deletedFeeSplitItemIds.Contains(selectedSplitRow.item_id))
        {
            deletedFeeSplitItemIds.Add(selectedSplitRow.item_id);
        }
        selectedSplitRow = null;
        StateHasChanged();
    }

    private async Task SaveSurgeryRequestAsync()
    {
        isSubmitted = true;
        if (formCustId <= 0)
        {
            ToastService.ShowWarning("Please select a valid patient.");
            activeModalTab = "PATIENT";
            return;
        }

        if (formDoctorCode <= 0)
        {
            ToastService.ShowWarning("Please select an operating surgeon.");
            activeModalTab = "PATIENT";
            return;
        }

        if (string.IsNullOrWhiteSpace(formProcedureName))
        {
            activeModalTab = "PATIENT";
            ToastService.ShowError("Please enter procedure name.");
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            OtApiResponse res;
            if (isEditMode)
            {
                res = await OtService.UpdateSurgeryRequestAsync(new UpdateSurgeryRequestRequest
                {
                    request_id = formRequestId,
                    procedure_name = formProcedureName.Trim(),
                    procedure_code = string.IsNullOrWhiteSpace(formProcedureCode) ? null : formProcedureCode.Trim(),
                    diagnosis = string.IsNullOrWhiteSpace(formDiagnosis) ? null : formDiagnosis.Trim(),
                    surgery_type = formSurgeryType,
                    priority = formPriority,
                    expected_duration_minutes = formDuration,
                    anesthesia_type = formAnesthesia,
                    notes = string.IsNullOrWhiteSpace(formNotes) ? null : formNotes.Trim()
                });
            }
            else
            {
                Guid? parsedIpId = null;
                if (!string.IsNullOrWhiteSpace(formIpIdStr) && Guid.TryParse(formIpIdStr.Trim(), out var g))
                {
                    parsedIpId = g;
                }

                res = await OtService.AddSurgeryRequestAsync(new AddSurgeryRequestRequest
                {
                    custid = formCustId,
                    dcode = formDoctorCode,
                    op_id = string.IsNullOrWhiteSpace(formOpId) ? null : formOpId.Trim(),
                    ip_id = parsedIpId,
                    procedure_name = formProcedureName.Trim(),
                    procedure_code = string.IsNullOrWhiteSpace(formProcedureCode) ? null : formProcedureCode.Trim(),
                    diagnosis = string.IsNullOrWhiteSpace(formDiagnosis) ? null : formDiagnosis.Trim(),
                    surgery_type = formSurgeryType,
                    priority = formPriority,
                    expected_duration_minutes = formDuration,
                    anesthesia_type = formAnesthesia,
                    procedure_fee = formProcedureFee.HasValue && formProcedureFee.Value > 0 ? formProcedureFee.Value : null,
                    notes = string.IsNullOrWhiteSpace(formNotes) ? null : formNotes.Trim()
                });
            }

            if (res.IsSuccess)
            {
                Guid targetRequestId = formRequestId;
                if (!isEditMode)
                {
                    if (!string.IsNullOrWhiteSpace(res.GeneratedId) && Guid.TryParse(res.GeneratedId, out var parsedId))
                    {
                        targetRequestId = parsedId;
                    }
                }

                // Delete removed fee splits in edit mode
                if (deletedFeeSplitItemIds.Any())
                {
                    foreach (var delId in deletedFeeSplitItemIds)
                    {
                        try { await OtService.DeleteFeeSplitItemAsync(delId); } catch { }
                    }
                }

                // Save pending fee splits
                if (targetRequestId != Guid.Empty && formFeeSplits.Any())
                {
                    foreach (var split in formFeeSplits)
                    {
                        if (!isEditMode || !existingSplitIds.Contains(split.item_id))
                        {
                            try
                            {
                                await OtService.AddFeeSplitItemAsync(new AddOtFeeSplitItemRequest
                                {
                                    request_id = targetRequestId,
                                    fee_type_id = split.fee_type_id,
                                    staff_name = split.staff_name,
                                    dcode = split.dcode,
                                    amount = split.amount,
                                    remarks = split.remarks
                                });
                            }
                            catch (Exception ex)
                            {
                                Console.WriteLine($"[SaveSurgeryRequestAsync] Error adding split: {ex.Message}");
                            }
                        }
                    }
                }

                ToastService.ShowSuccess(isEditMode ? "Surgery request updated successfully!" : "Surgery request created successfully!");
                showFormModal = false;
                await LoadRequestsAsync();
            }
            else
            {
                ToastService.ShowError(res.message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void PromptCancel(OtSurgeryRequestListModel item)
    {
        cancelTarget = item;
        showCancelConfirm = true;
    }

    private void DismissCancelConfirm()
    {
        showCancelConfirm = false;
        cancelTarget = null;
    }

    private async Task ExecuteCancelAsync()
    {
        if (cancelTarget == null) return;
        try
        {
            var res = await OtService.CancelSurgeryRequestAsync(cancelTarget.request_id);
            if (res.IsSuccess)
            {
                ToastService.ShowSuccess("Surgery request cancelled.");
                showCancelConfirm = false;
                cancelTarget = null;
                await LoadRequestsAsync();
            }
            else
            {
                ToastService.ShowError(res.message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private string GetPriorityBadgeClass(string? p) => (p?.ToUpperInvariant()) switch
    {
        "EMERGENCY" => "bg-danger text-white",
        "URGENT" => "bg-warning text-dark",
        _ => "bg-primary-subtle text-primary"
    };

    private string GetStatusBadgeClass(string? status) => (status?.ToUpperInvariant()) switch
    {
        "REQUESTED" => "bg-warning-subtle text-warning border border-warning",
        "SCHEDULED" => "bg-info-subtle text-info border border-info",
        "IN_PROGRESS" => "bg-purple-subtle text-purple border border-purple",
        "COMPLETED" => "bg-success-subtle text-success border border-success",
        "CANCELLED" => "bg-danger-subtle text-danger border border-danger",
        _ => "bg-secondary-subtle text-secondary"
    };
}
