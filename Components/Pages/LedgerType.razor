@page "/ledgertype"
@page "/ledgertypes"
@using Booking.Models
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.NotificationService NotificationService

<div class="items-page pt-4 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-5">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Ledger Type Master</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total ledgers : @LedgerList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by name, shortname..." @oninput="OnSearchInput" />
                    </div>

                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>

                    <button class="add-item-btn" @onclick="AddNewLedger">
                        <i class="bi bi-plus-lg"></i>
                        <span class="ms-1">Add Ledger</span>
                    </button>
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredLedgers.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        No ledgers found. Create a new ledger mapping.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 60px; text-align: center;">S.NO</th>
                                    <th style="width: 90px; text-align: center;">ORDER NO</th>
                                    <th style="width: 12%; text-align: center;">SHORT NAME</th>
                                    <th style="width: 18%; text-align: center;">NAME</th>
                                    <th style="width: 14%; text-align: center;">NATURE TYPE</th>
                                    <th style="width: 70px; text-align: center;">VAT</th>
                                    <th style="width: 70px; text-align: center;">GST</th>
                                    <th style="width: 90px; text-align: center;">SGST %</th>
                                    <th style="width: 90px; text-align: center;">CGST %</th>
                                    <th style="width: 90px; text-align: center;">IGST %</th>
                                    <th style="width: 100px; text-align: center;">STATUS</th>
                                    <th style="width: 100px; text-align: center;">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedLedgers.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td style="text-align: center; font-weight: 700; color: #3b82f6;">@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td style="text-align: center; font-weight: 700; color: #4f46e5;">#@row.value.ledgertypecode</td>
                                        <td style="font-weight: 700; color: #0f172a; text-align: center;">@(string.IsNullOrWhiteSpace(row.value.shortname) ? "N/A" : row.value.shortname)</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@row.value.ledgertypename</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@GetNatureTypeName(row.value.naturetype)</td>
                                        <td style="text-align: center;">
                                            @if (row.value.isvatapplicable) {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            } else {
                                                <i class="bi bi-x-circle text-muted"></i>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            @if (row.value.isgstapplicable) {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            } else {
                                                <i class="bi bi-x-circle text-muted"></i>
                                            }
                                        </td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@row.value.sgstpercentage.ToString("N2")%</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@row.value.cgstpercentage.ToString("N2")%</td>
                                        <td style="color: #475569; font-weight: 500; text-align: center;">@row.value.igstpercentage.ToString("N2")%</td>
                                        <td style="text-align: center;">
                                            @if (row.value.isactive) {
                                                <span style="color: #059669; font-weight: 700; font-size: 0.78rem; text-transform: uppercase;">Active</span>
                                            } else {
                                                <span style="color: #64748b; font-weight: 700; font-size: 0.78rem; text-transform: uppercase;">Inactive</span>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            <button class="action-btn btn-edit" @onclick="() => EditLedger(row.value)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                            <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(row.value)" title="Delete"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var ledger in PagedLedgers)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span>#@ledger.ledgertypecode - @ledger.ledgertypename</span>
                                    <div>
                                        <button class="action-btn btn-edit" @onclick="() => EditLedger(ledger)" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(ledger)" title="Delete"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Short Name</span><strong>@ledger.shortname</strong></div>
                                    <div class="detail-row"><span>Nature Type</span><strong>@GetNatureTypeName(ledger.naturetype)</strong></div>
                                    <div class="detail-row"><span>VAT</span><strong>@(ledger.isvatapplicable ? "Yes" : "No")</strong></div>
                                    <div class="detail-row"><span>GST</span><strong>@(ledger.isgstapplicable ? "Yes" : "No")</strong></div>
                                    <div class="detail-row"><span>GST Rates</span><strong class="text-success">S:@ledger.sgstpercentage.ToString("N1")% C:@ledger.cgstpercentage.ToString("N1")% I:@ledger.igstpercentage.ToString("N1")%</strong></div>
                                    <div class="detail-row"><span>Status</span><strong>@(ledger.isactive ? "Active" : "Inactive")</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="display-controls px-4 py-3 border-top" style="background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredLedgers.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredLedgers.Count()))</strong> of <strong>@FilteredLedgers.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar d-flex gap-1">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <button class="page-btn @(CurrentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 800px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #000000 !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Ledger Type" : "Add Ledger Type")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentItem" OnValidSubmit="Save" autocomplete="off">
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 8px 16px 8px 0px;">
                        <!-- Section 1: General Details -->
                        <div class="form-section-header" style="margin-bottom: 10px; margin-top: 4px; padding-bottom: 4px; border-bottom: 1px solid #f1f5f9;">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">General Details</div>
                        </div>

                        <div class="form-grid">
                            <div class="field-group col-2">
                                <label class="field-label required">Order No.</label>
                                <InputNumber class="form-control premium-input" @bind-Value="CurrentItem.ledgertypecode" placeholder="E.g. 6" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label required">Short Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.shortname" placeholder="E.g. GST" />
                            </div>
                            <div class="field-group col-4">
                                <label class="field-label required">Name</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentItem.ledgertypename" placeholder="E.g. 5% GST" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Nature Type</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentItem.naturetype">
                                    <option value="0">- Select Nature Type -</option>
                                    <option value="1">Asset</option>
                                    <option value="2">Liability</option>
                                    <option value="3">Expense</option>
                                    <option value="4">Income</option>
                                </InputSelect>
                            </div>
                        </div>

                        <!-- Section 2: Taxation Details -->
                        <div class="form-section-header" style="margin-bottom: 8px; margin-top: 14px; padding-bottom: 2px; border-bottom: 1px solid #f1f5f9;">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Taxation Details</div>
                        </div>

                        <div class="form-grid" style="display: flex; align-items: flex-start; gap: 16px;">
                            <div class="field-group col-2" style="margin-top: 14px;">
                                <div class="form-check form-switch" style="display: flex; align-items: center; height: 38px; margin-bottom: 0; margin-left: 12px;">
                                    <InputCheckbox class="form-check-input" @bind-Value="CurrentItem.isvatapplicable" id="vatSwitch" style="transform: scale(1.2); margin-right: 8px; cursor: pointer; margin-left: 0;" />
                                    <label class="form-check-label fw-bold" for="vatSwitch" style="font-size: 0.85rem; color: #1e293b; cursor: pointer;">VAT</label>
                                </div>
                            </div>
                            <div class="field-group col-2" style="margin-top: 14px;">
                                <div class="form-check form-switch" style="display: flex; align-items: center; height: 38px; margin-bottom: 0; margin-left: 12px;">
                                    <InputCheckbox class="form-check-input" @bind-Value="CurrentItem.isgstapplicable" id="gstSwitch" style="transform: scale(1.2); margin-right: 8px; cursor: pointer; margin-left: 0;" />
                                    <label class="form-check-label fw-bold" for="gstSwitch" style="font-size: 0.85rem; color: #1e293b; cursor: pointer;">GST</label>
                                </div>
                            </div>

                            @if (CurrentItem.isgstapplicable)
                            {
                                <div class="field-group" style="width: 110px;">
                                    <label class="field-label">SGST %</label>
                                    <InputNumber class="form-control premium-input" @bind-Value="SgstPercentageInput" placeholder="0.00" />
                                </div>
                                <div class="field-group" style="width: 110px;">
                                    <label class="field-label">CGST %</label>
                                    <InputNumber class="form-control premium-input" @bind-Value="CgstPercentageInput" placeholder="0.00" />
                                </div>
                                <div class="field-group" style="width: 110px;">
                                    <label class="field-label">IGST %</label>
                                    <InputNumber class="form-control premium-input" @bind-Value="IgstPercentageInput" placeholder="0.00" />
                                </div>
                            }
                        </div>
                        
                        <div class="form-grid mt-3">
                            <div class="field-group col-12">
                                <label class="field-label">Is Active?</label>
                                <div class="premium-segmented-control-joined" style="max-width: 130px; height: 32px; border-radius: 6px;">
                                    <button type="button" class="segment-btn-joined btn-false @(CurrentItem.isactive ? "" : "active")" @onclick="() => CurrentItem.isactive = false" style="font-size: 0.8rem;">
                                        False
                                    </button>
                                    <button type="button" class="segment-btn-joined btn-true @(CurrentItem.isactive ? "active" : "")" @onclick="() => CurrentItem.isactive = true" style="font-size: 0.8rem;">
                                        True
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer-actions" style="display: flex; justify-content: flex-end; align-items: center; padding: 1.5rem 2rem; border-top: 1px solid #f1f5f9; background: #fff;">
                        <div class="footer-right" style="display: flex; gap: 1rem; align-items: center;">
                            <button type="button" class="btn-cancel-modal" @onclick="CloseModal" style="background: #f1f5f9; color: #0f172a; border: none; padding: 0.75rem 2rem; border-radius: 12px; font-weight: 700; min-width: 120px; transition: all 0.2s;">
                                Cancel
                            </button>
                            <button type="submit" class="btn-save-premium" disabled="@IsSaving" style="background: #1c9f5f; color: white; border: none; padding: 0.75rem 2.5rem; border-radius: 12px; font-weight: 700; display: flex; align-items: center; gap: 8px; min-width: 160px; box-shadow: 0 4px 12px rgba(28, 159, 95, 0.2); transition: all 0.2s;">
                                @if (IsSaving)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle" style="font-size: 1.2rem;"></i>
                                }
                                <span>@(IsEdit ? "Update Ledger" : "Save Ledger")</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation -->
@if (ShowDeletePopup)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeletePopup = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Ledger Type</div>
            <div class="action-popup-body">Are you sure you want to delete this ledger type?</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowDeletePopup = false">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" disabled="@IsDeleteProcessing" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<ledger_type_master> LedgerList = new();
    private string SearchQuery = string.Empty;
    private bool IsLoading;
    private bool IsSaving;
    private bool ShowModal;
    private bool IsEdit;
    private bool ShowDeletePopup;
    private bool IsDeleteProcessing;
    private bool IsCardView = false;
    private ledger_type_master CurrentItem = new();
    private ledger_type_master? PendingDelete;

    private const string DefaultTenantCode = "TEN1011";

    private decimal? SgstPercentageInput
    {
        get => !IsEdit && CurrentItem.sgstpercentage == 0 ? null : CurrentItem.sgstpercentage;
        set => CurrentItem.sgstpercentage = value ?? 0;
    }

    private decimal? CgstPercentageInput
    {
        get => !IsEdit && CurrentItem.cgstpercentage == 0 ? null : CurrentItem.cgstpercentage;
        set => CurrentItem.cgstpercentage = value ?? 0;
    }

    private decimal? IgstPercentageInput
    {
        get => !IsEdit && CurrentItem.igstpercentage == 0 ? null : CurrentItem.igstpercentage;
        set => CurrentItem.igstpercentage = value ?? 0;
    }

    private void SetView(bool cardView)
    {
        IsCardView = cardView;
        CurrentPage = 1;
    }

    private string GetNatureTypeName(int natureType)
    {
        return natureType switch
        {
            1 => "Asset",
            2 => "Liability",
            3 => "Expense",
            4 => "Income",
            5 => "Duties & Taxes",
            _ => "Unknown"
        };
    }

    private IEnumerable<ledger_type_master> FilteredLedgers =>
        string.IsNullOrWhiteSpace(SearchQuery)
            ? LedgerList
            : LedgerList.Where(l => 
                (l.ledgertypename?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.shortname?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.ledgertypecode.ToString().Contains(SearchQuery)));

    // Pagination
    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 12;
    private int TotalPages => (int)Math.Ceiling((double)FilteredLedgers.Count() / ItemsPerPage);
    private IEnumerable<ledger_type_master> PagedLedgers => FilteredLedgers.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    protected override async Task OnInitializedAsync()
    {
        await LoadLedgers();
    }

    private async Task LoadLedgers()
    {
        IsLoading = true;
        try
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("ItemMaster/getledgertype");
            
            try
            {
                var direct = System.Text.Json.JsonSerializer.Deserialize<List<ledger_type_master>>(response, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                LedgerList = (direct ?? new List<ledger_type_master>()).Where(x => !x.deleted).ToList();
            }
            catch
            {
                var wrapped = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<List<ledger_type_master>>>(response, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                LedgerList = (wrapped?.data ?? new List<ledger_type_master>()).Where(x => !x.deleted).ToList();
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error loading ledgers: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("InventoryApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Add("tenantcode", DefaultTenantCode);
        return client;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        CurrentPage = 1;
    }

    private void AddNewLedger()
    {
        CurrentItem = new ledger_type_master 
        { 
            tenantcode = DefaultTenantCode, 
            deleted = false, 
            isactive = true,
            createddate = DateTime.Now
        };
        IsEdit = false;
        ShowModal = true;
    }

    private void EditLedger(ledger_type_master ledger)
    {
        CurrentItem = new ledger_type_master 
        { 
            ledgertypecode = ledger.ledgertypecode,
            ledgertypename = ledger.ledgertypename,
            shortname = ledger.shortname,
            description = ledger.description,
            naturetype = ledger.naturetype,
            isgstapplicable = ledger.isgstapplicable,
            isvatapplicable = ledger.isvatapplicable,
            sgstpercentage = ledger.sgstpercentage,
            cgstpercentage = ledger.cgstpercentage,
            igstpercentage = ledger.igstpercentage,
            isactive = ledger.isactive,
            tenantcode = ledger.tenantcode ?? DefaultTenantCode,
            deleted = ledger.deleted,
            createddate = ledger.createddate
        };
        IsEdit = true;
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
        IsSaving = false;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(CurrentItem.ledgertypename))
        {
            NotificationService.ShowNotification("Name is required", NotificationType.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(CurrentItem.shortname))
        {
            NotificationService.ShowNotification("Short Name is required", NotificationType.Warning);
            return;
        }
        if (CurrentItem.naturetype <= 0)
        {
            NotificationService.ShowNotification("Nature Type is required", NotificationType.Warning);
            return;
        }

        IsSaving = true;
        try
        {
            var client = CreateClient();
            CurrentItem.tenantcode = DefaultTenantCode;
            CurrentItem.description ??= "";

            var payloadJson = System.Text.Json.JsonSerializer.Serialize(CurrentItem, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            Console.WriteLine(IsEdit ? "--- UPDATE LEDGERTYPE PAYLOAD ---" : "--- INSERT LEDGERTYPE PAYLOAD ---");
            Console.WriteLine(payloadJson);
            Console.WriteLine("---------------------------------");

            HttpResponseMessage response;
            if (IsEdit)
            {
                response = await client.PostAsJsonAsync("ItemMaster/updateledgertype", CurrentItem);
            }
            else
            {
                response = await client.PostAsJsonAsync("ItemMaster/insertledgertype", CurrentItem);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowNotification(IsEdit ? "Ledger updated successfully" : "Ledger added successfully", NotificationType.Success);
                ShowModal = false;
                await LoadLedgers();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                NotificationService.ShowNotification($"Save failed: {err}", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error saving ledger: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(ledger_type_master ledger)
    {
        PendingDelete = ledger;
        ShowDeletePopup = true;
    }

    private async Task DeleteConfirmed()
    {
        if (PendingDelete == null) return;

        IsDeleteProcessing = true;
        try
        {
            var client = CreateClient();
            var ledgerCode = PendingDelete.ledgertypecode;

            // Try multiple delete approaches for maximum backend compatibility
            var attempts = new Func<Task<HttpResponseMessage>>[]
            {
                () => client.GetAsync($"ItemMaster/deleteledgertype?ledgertypecode={ledgerCode}"),
                () => client.GetAsync($"ItemMaster/deleteledgertype?ledgercode={ledgerCode}"),
                () => client.DeleteAsync($"ItemMaster/deleteledgertype?ledgertypecode={ledgerCode}"),
                () => client.DeleteAsync($"ItemMaster/deleteledgertype?ledgercode={ledgerCode}")
            };

            bool success = false;
            foreach (var attempt in attempts)
            {
                try {
                    var response = await attempt();
                    if (response.IsSuccessStatusCode) {
                        success = true;
                        break;
                    }
                } catch {}
            }

            if (success)
            {
                NotificationService.ShowNotification("Ledger deleted successfully", NotificationType.Success);
                ShowDeletePopup = false;
                await LoadLedgers();
            }
            else
            {
                NotificationService.ShowNotification("Delete failed", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification($"Error: {ex.Message}", NotificationType.Error);
        }
        finally
        {
            IsDeleteProcessing = false;
            PendingDelete = null;
        }
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    public class ServiceResponse<T>
    {
        public T? data { get; set; }
    }
