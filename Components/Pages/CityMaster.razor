@page "/city-master"
@rendermode InteractiveServer
@using Medico_Backend.Model
@using Booking.Services
@using Booking.Helpers
@using Booking.Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject CityMasterService CityService
@inject ToastService ToastService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Booking.Services.RoleMasterService RoleService
@inject ProtectedLocalStorage _sessionStorage
@implements IDisposable

<div class="cm-page">
@if (!hasViewRight)
{
    <!-- Access Denied Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <div class="cm-header-brand" style="display: flex; align-items: center; gap: 0.75rem;">
                <div class="cm-header-icon-box" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                    <i class="bi bi-shield-x"></i>
                </div>
                <div class="cm-header-text">
                    <h1 class="cm-title">City Master</h1>
                    <span class="cm-subtitle" style="color: #ef4444; font-weight: 600;"><span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #ef4444; margin-right: 4px;"></span> ACCESS RESTRICTED</span>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-danger d-flex align-items-center mt-3 p-4 shadow-sm" style="border-radius: 8px; background: #fef2f2; border: 1px solid #fecaca; color: #991b1b;">
        <i class="bi bi-shield-lock-fill me-3 fs-1 text-danger" style="font-size: 2rem; margin-right: 1rem;"></i>
        <div>
            <h5 class="alert-heading mb-1 font-bold" style="font-weight: 700; margin-bottom: 0.25rem;">Permission Denied</h5>
            <p class="mb-0 text-muted" style="color: #64748b; margin: 0;">You do not have permission to view City Master. Please contact your system administrator to assign Role 399 (OP Portal &gt; City Master &gt; View).</p>
        </div>
    </div>
}
else
{
    <!-- Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <h1 class="cm-title">City Master</h1>
            <span class="cm-subtitle">Location Configuration</span>
        </div>
        <div class="cm-header-right">
            <div class="cm-search-box">
                <i class="bi bi-search cm-search-icon"></i>
                <input type="text" class="cm-search-input" placeholder="Quick find..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            @if (hasCreateRight) { 
                <button class="cm-btn-new" @onclick="OpenNewCityModal">
                    + New City Entry
                </button> 
            }
        </div>
    </div>

    <!-- Table -->
    <div class="cm-table-card">
        <table class="cm-table">
            <thead>
                <tr>
                    <th>ORDER NO</th>
                    <th>SHORT NAME</th>
                    <th>CITY NAME</th>
                    <th>DESCRIPTION</th>
                    <th>ENTERED DATE</th>
                    <th>MODIFIED DATE</th>
                    <th>ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredCities.Any())
                {
                    @foreach (var (item, index) in PaginatedCities.Select((c, i) => (c, i)))
                    {
                        <tr>
                            <td class="col-orderno">@(((currentPage - 1) * pageSize) + index + 1)</td>
                            <td class="col-shortname">@item.shortname</td>
                            <td class="col-name">
                                <span class="counter-name-text">@item.cityname</span>
                            </td>
                            <td class="col-narration">@item.description</td>
                            <td class="col-date-entered">
                                <span class="date-line">@(FormatToIst(item.entereddate))</span>
                            </td>
                            <td class="col-date-modified">
                                <span class="date-line">@(FormatToIst(item.ibsdate))</span>
                            </td>
                            <td class="col-action">
                                @if (hasEditRight) {
                                <button class="cm-action-btn edit" title="Edit" @onclick="() => EditCity(item)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                }
                                @if (hasDeleteRight) {
                                <button class="cm-action-btn delete" title="Delete" @onclick="() => DeleteCity(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="cm-empty-row">
                            <i class="bi bi-display"></i>
                            <div>No cities found</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (FilteredCities.Any())
        {
            <div class="cm-table-footer">
                <div class="cm-pagination-info">
                    Showing <strong>@(((currentPage - 1) * pageSize) + 1)</strong> to <strong>@(Math.Min(currentPage * pageSize, FilteredCities.Count()))</strong> of <strong>@FilteredCities.Count()</strong> entries
                </div>
                @if (TotalPages > 1)
                {
                    <div class="cm-pagination-controls">
                        <button type="button" class="cm-pg-btn" disabled="@(currentPage <= 1)" @onclick="() => ChangePage(currentPage - 1)">
                            &lsaquo; Previous
                        </button>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNum = i;
                            <button type="button" class="cm-pg-btn @(currentPage == pageNum ? "active" : "")" @onclick="() => ChangePage(pageNum)">
                                @pageNum
                            </button>
                        }
                        <button type="button" class="cm-pg-btn" disabled="@(currentPage >= TotalPages)" @onclick="() => ChangePage(currentPage + 1)">
                            Next &rsaquo;
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}
</div>

@if (showModal)
{
    <div class="cm-backdrop">
        <div class="cm-modal">
            <div class="cm-modal-header">
                <h2 class="cm-modal-title">@(isEditMode ? "Edit City Entry" : "New City Entry")</h2>
                <button class="cm-close-btn" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body">
                <!-- Row 1: City Name, Short Name -->
                <div class="cm-form-row two-cols">
                    <div class="cm-field-group" style="position: relative;">
                        <label class="cm-label">City Name <span style="color: #ef4444;">*</span></label>
                        <input @ref="cityNameInput"
                               type="text" 
                               class="cm-input" 
                               placeholder="Ex: Chennai" 
                               value="@currentCity.cityname" 
                               @oninput="OnCityNameInput"
                               @onfocus="() => showCityDropdown = true"
                               @onblur="OnCityNameBlur"
                               @onkeydown="OnCityNameKeyDown" />

                        @if (showCityDropdown && CitySuggestions.Any())
                        {
                            <div class="cm-autocomplete-dropdown">
                                @foreach (var item in CitySuggestions)
                                {
                                    <div class="cm-dropdown-item" @onmousedown="() => SelectCity(item)">
                                        <span class="cm-dropdown-title">@item.cityname</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Short Name</label>
                        <input @ref="shortNameInput"
                               type="text" 
                               class="cm-input" 
                               placeholder="Ex: CHN" 
                               @bind="currentCity.shortname" 
                               @bind:event="oninput"
                               @onkeydown="OnShortNameKeyDown" />
                    </div>
                </div>

                <!-- Row 2: Description -->
                <div class="cm-form-row full-width">
                    <div class="cm-field-group">
                        <label class="cm-label">City Description</label>
                        <input @ref="descInput"
                               type="text" 
                               class="cm-input" 
                               placeholder="Specify any specific instructions..." 
                               @bind="currentCity.description" 
                               @bind:event="oninput"
                               @onkeydown="OnDescKeyDown" />
                    </div>
                </div>
            </div>

            <div class="cm-modal-footer">
                @if (isEditMode && hasDeleteRight)
                {
                    <button class="cm-btn-delete" @onclick="() => DeleteCity(currentCity)">Delete</button>
                }
                else
                {
                    <span></span>
                }
                <div class="cm-footer-right-buttons" style="display: flex; gap: 0.75rem; align-items: center;">
                    <button class="cm-btn-cancel" @onclick="CloseModal">Cancel</button>
                    @if ((isEditMode && hasEditRight) || (!isEditMode && hasCreateRight))
                    {
                        <button class="cm-btn-save" @onclick="SaveCity">
                            <i class="bi bi-check2"></i> Save City
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string FormatToIst(DateTime? dt)
    {
        if (dt == null || dt == DateTime.MinValue) return "-";
        return dt.ToIndianTime()?.ToString("dd-MM-yyyy hh:mm tt") ?? "-";
    }

    private List<CityMasterModel> cities = new();
    private int currentPage = 1;
    private int pageSize = 10;

    private int TotalPages => (int)Math.Ceiling((double)FilteredCities.Count() / pageSize);

    private IEnumerable<CityMasterModel> PaginatedCities =>
        FilteredCities.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= Math.Max(1, TotalPages))
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private string _searchQuery = "";
    private string searchQuery
    {
        get => _searchQuery;
        set
        {
            if (_searchQuery != value)
            {
                _searchQuery = value;
                currentPage = 1;
            }
        }
    }

    private IEnumerable<CityMasterModel> FilteredCities =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? cities
            : cities.Where(c => 
                (c.cityname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.shortname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
    private bool showModal = false;
    private bool isEditMode = false;
    private CityMasterModel currentCity = new();
    private bool showCityDropdown = false;

    private IEnumerable<CityMasterModel> CitySuggestions =>
        string.IsNullOrWhiteSpace(currentCity.cityname)
            ? Enumerable.Empty<CityMasterModel>()
            : cities.Where(c => c.cityname != null && c.cityname.Contains(currentCity.cityname, StringComparison.OrdinalIgnoreCase)).Take(8);

    private void OnCityNameInput(ChangeEventArgs e)
    {
        string typed = e.Value?.ToString() ?? "";
        currentCity.cityname = typed;
        showCityDropdown = true;

        if (string.IsNullOrWhiteSpace(typed))
        {
            isEditMode = false;
            currentCity.citycode = 0;
            return;
        }

        var match = cities.FirstOrDefault(c => string.Equals(c.cityname, typed, StringComparison.OrdinalIgnoreCase));
        if (match != null)
        {
            EditCity(match);
        }
    }

    private void SelectCity(CityMasterModel item)
    {
        EditCity(item);
        showCityDropdown = false;
    }

    private async Task OnCityNameBlur()
    {
        await Task.Delay(250);
        showCityDropdown = false;
    }

    private bool hasViewRight = true;
    private bool hasCreateRight = false;
    private bool hasEditRight = false;
    private bool hasDeleteRight = false;

    private void EvaluateRights()
    {
        bool isAdmin = Booking.Helpers.UserPermissionHelper.IsAdmin(null, TenantState);
        if (isAdmin)
        {
            hasViewRight = true;
            hasCreateRight = true;
            hasEditRight = true;
            hasDeleteRight = true;
            return;
        }

        hasViewRight = RoleService.HasPermission(399) ||
                       RoleService.HasRight("OP Portal", "City Master") ||
                       TenantState.HasActionRight("OP Portal", "City Master", "View") ||
                       TenantState.HasActionRight("OP", "City Master", "View");

        hasCreateRight = RoleService.HasPermission(400) ||
                         RoleService.HasAction("OP Portal", "City Master", "Create") ||
                         TenantState.HasActionRight("OP Portal", "City Master", "Create") ||
                         TenantState.HasActionRight("OP", "City Master", "Create");

        hasEditRight = RoleService.HasPermission(401) ||
                       RoleService.HasAction("OP Portal", "City Master", "Edit") ||
                       TenantState.HasActionRight("OP Portal", "City Master", "Edit") ||
                       TenantState.HasActionRight("OP", "City Master", "Edit");

        hasDeleteRight = RoleService.HasPermission(402) ||
                         RoleService.HasAction("OP Portal", "City Master", "Delete") ||
                         TenantState.HasActionRight("OP Portal", "City Master", "Delete") ||
                         TenantState.HasActionRight("OP", "City Master", "Delete");
    }

    protected override void OnInitialized()
    {
        TenantState.OnSessionChanged += HandleSessionChanged;
        RoleService.OnPermissionsChanged += HandlePermissionsChanged;
        EvaluateRights();
    }

    private void HandlePermissionsChanged()
    {
        InvokeAsync(async () =>
        {
            bool prevCanView = hasViewRight;
            EvaluateRights();
            if (prevCanView != hasViewRight && hasViewRight)
            {
                await LoadCities();
            }
            StateHasChanged();
        });
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            EvaluateRights();
            if (hasViewRight)
            {
                await LoadCities();
            }
            StateHasChanged();
        });
    }

    private async Task LoadCities()
    {
        if (!hasViewRight) return;
        try
        {
            var res = await CityService.GetCitiesAsync();
            if (res != null)
            {
                var tenant = TenantState.TenantCode;
                var list = res.Where(c => string.IsNullOrEmpty(tenant) || string.IsNullOrEmpty(c.tenant_code) || string.Equals(c.tenant_code, tenant, StringComparison.OrdinalIgnoreCase)).ToList();

                // Order by entered date (in the order they are entered), fallback to citycode
                cities = list.OrderBy(c => c.entereddate == default ? DateTime.MinValue : c.entereddate).ThenBy(c => c.citycode).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load cities: {ex.Message}");
        }
    }

    private ElementReference cityNameInput;
    private ElementReference shortNameInput;
    private ElementReference descInput;
    private bool shouldFocusFirstInput = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!RoleService.IsPermissionsLoaded && !Booking.Helpers.UserPermissionHelper.IsAdmin(null, TenantState))
            {
                try
                {
                    var sessionPerms = await _sessionStorage.GetAsync<List<RolePermissionItem>>("UserRolePermissions");
                    if (sessionPerms.Success && sessionPerms.Value != null && sessionPerms.Value.Any())
                    {
                        RoleService.SetUserPermissions(sessionPerms.Value);
                    }
                    else if (TenantState.UserCode > 0)
                    {
                        await RoleService.LoadUserPermissionsAsync(TenantState.UserCode, TenantState.TenantCode);
                    }
                }
                catch
                {
                    if (TenantState.UserCode > 0)
                    {
                        await RoleService.LoadUserPermissionsAsync(TenantState.UserCode, TenantState.TenantCode);
                    }
                }
            }
            EvaluateRights();
            if (hasViewRight)
            {
                await LoadCities();
            }
            StateHasChanged();
        }

        if (shouldFocusFirstInput)
        {
            shouldFocusFirstInput = false;
            try
            {
                await Task.Delay(50);
                await cityNameInput.FocusAsync();
            }
            catch { }
        }
    }

    private async Task OnCityNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            showCityDropdown = false;
            await shortNameInput.FocusAsync();
        }
    }

    private async Task OnShortNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await descInput.FocusAsync();
        }
    }

    private async Task OnDescKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveCity();
        }
    }

    private int GetEffectiveUserCode()
    {
        if (TenantState?.UserCode > 0) return TenantState.UserCode;
        if (TenantState?.UserData?.UserCode.HasValue == true && TenantState.UserData.UserCode.Value > 0)
            return TenantState.UserData.UserCode.Value;
        return 1;
    }

    private void OpenNewCityModal()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("Permission Denied: Role 400 (Create City) required.");
            return;
        }

        int nextOrderNo = cities.Count + 1;

        currentCity = new CityMasterModel 
        { 
            orderno = nextOrderNo,
            tenant_code = !string.IsNullOrEmpty(TenantState.TenantCode) ? TenantState.TenantCode : "",
            usercode = GetEffectiveUserCode(),
            computercode = GetEffectiveUserCode()
        };
        isEditMode = false;
        showModal = true;
        shouldFocusFirstInput = true;
    }

    private void EditCity(CityMasterModel city)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("Permission Denied: Role 401 (Edit City) required.");
            return;
        }

        currentCity = new CityMasterModel
        {
            citycode = city.citycode,
            tenant_code = city.tenant_code,
            orderno = city.orderno,
            shortname = city.shortname,
            cityname = city.cityname,
            description = city.description,
            usercode = city.usercode > 0 ? city.usercode : GetEffectiveUserCode(),
            computercode = city.computercode > 0 ? city.computercode : GetEffectiveUserCode(),
            entereddate = city.entereddate,
            ibsdate = city.ibsdate
        };
        isEditMode = true;
        showModal = true;
        shouldFocusFirstInput = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveCity()
    {
        if (isEditMode && !hasEditRight)
        {
            ToastService.ShowError("Permission Denied: Role 401 (Edit City) required.");
            return;
        }
        if (!isEditMode && !hasCreateRight)
        {
            ToastService.ShowError("Permission Denied: Role 400 (Create City) required.");
            return;
        }

        if (string.IsNullOrWhiteSpace(currentCity.cityname))
        {
            ToastService.ShowWarning("Please enter a valid City Name.");
            return;
        }

        try
        {
            bool success;
            if (isEditMode)
            {
                currentCity.ibsdate = DateTime.Now;
                currentCity.usercode = GetEffectiveUserCode();
                currentCity.computercode = GetEffectiveUserCode();
                success = await CityService.UpdateCityAsync(currentCity);
            }
            else
            {
                currentCity.entereddate = DateTime.Now;
                currentCity.ibsdate = DateTime.Now;
                currentCity.tenant_code = !string.IsNullOrEmpty(TenantState.TenantCode) ? TenantState.TenantCode : (currentCity.tenant_code ?? "");
                currentCity.usercode = GetEffectiveUserCode();
                currentCity.computercode = GetEffectiveUserCode();
                
                // Auto-generate order no based on total count of records in this tenant (+1)
                currentCity.orderno = cities.Count + 1;

                success = await CityService.InsertCityAsync(currentCity);
            }

            if (success)
            {
                ToastService.ShowSuccess("City saved successfully.");
                showModal = false;
                await LoadCities();
            }
            else
            {
                ToastService.ShowError("Failed to save city.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task DeleteCity(CityMasterModel city)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("Permission Denied: Role 402 (Delete City) required.");
            return;
        }

        try
        {
            bool success = await CityService.DeleteCityAsync(city.citycode);
            if (success)
            {
                ToastService.ShowSuccess("City deleted successfully.");
                if (showModal) showModal = false;
                await LoadCities();
            }
            else
            {
                ToastService.ShowError("Failed to delete city.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    public void Dispose()
    {
        TenantState.OnSessionChanged -= HandleSessionChanged;
        RoleService.OnPermissionsChanged -= HandlePermissionsChanged;
    }
}
