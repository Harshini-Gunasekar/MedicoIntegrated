@page "/city-master"
@rendermode InteractiveServer
@using Medico_Backend.Model
@using Booking.Services
@inject CityMasterService CityService
@inject ToastService ToastService
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<div class="cm-page">
    <!-- Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <h1 class="cm-title">City Master</h1>
            <span class="cm-subtitle">Location Configuration</span>
        </div>
        <div class="cm-header-right">
            <div class="cm-search-box">
                <i class="bi bi-search cm-search-icon"></i>
                <input type="text" class="cm-search-input" placeholder="Quick find..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            @if (TenantState.HasActionRight("Configuration", "General", "Create")) { <button class="cm-btn-new" @onclick="OpenNewCityModal">
                + New City Entry
            </button> }
        </div>
    </div>

    <!-- Table -->
    <div class="cm-table-card">
        <table class="cm-table">
            <thead>
                <tr>
                    <th>ORDER NO</th>
                    <th>SHORT NAME</th>
                    <th>CITY NAME</th>
                    <th>DESCRIPTION</th>
                    <th>ENTERED DATE</th>
                    <th>MODIFIED DATE</th>
                    <th>ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredCities.Any())
                {
                    @foreach (var item in FilteredCities)
                    {
                        <tr>
                            <td class="col-orderno">@item.orderno</td>
                            <td class="col-shortname">@item.shortname</td>
                            <td class="col-name">
                                <span class="counter-name-text">@item.cityname</span>
                            </td>
                            <td class="col-narration">@item.description</td>
                            <td class="col-date-entered">
                                <span class="date-line">@item.entereddate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.entereddate.ToString("tt") == "AM" ? "am" : "pm")">@item.entereddate.ToString("tt")</span>
                            </td>
                            <td class="col-date-modified">
                                <span class="date-line">@item.ibsdate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.ibsdate.ToString("tt") == "AM" ? "am" : "pm")">@item.ibsdate.ToString("tt")</span>
                            </td>
                            <td class="col-action">
                                @if (TenantState.HasActionRight("Configuration", "General", "Edit")) {
                                <button class="cm-action-btn edit" title="Edit" @onclick="() => EditCity(item)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                }
                                @if (TenantState.HasActionRight("Configuration", "General", "Delete")) {
                                <button class="cm-action-btn delete" title="Delete" @onclick="() => DeleteCity(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="cm-empty-row">
                            <i class="bi bi-display"></i>
                            <div>No cities found</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showModal)
{
    <div class="cm-backdrop">
        <div class="cm-modal">
            <div class="cm-modal-header">
                <h2 class="cm-modal-title">@(isEditMode ? "Edit City Entry" : "New City Entry")</h2>
                <button class="cm-close-btn" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body">
                <!-- Row 1: City Name, Display Order -->
                <div class="cm-form-row two-cols-wide-narrow">
                    <div class="cm-field-group" style="position: relative;">
                        <label class="cm-label">City Name</label>
                        <input type="text" 
                               class="cm-input" 
                               placeholder="Ex: Chennai" 
                               value="@currentCity.cityname" 
                               @oninput="OnCityNameInput"
                               @onfocus="() => showCityDropdown = true"
                               @onblur="OnCityNameBlur" />

                        @if (showCityDropdown && CitySuggestions.Any())
                        {
                            <div class="cm-autocomplete-dropdown">
                                @foreach (var item in CitySuggestions)
                                {
                                    <div class="cm-dropdown-item" @onmousedown="() => SelectCity(item)">
                                        <span class="cm-dropdown-title">@item.cityname</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Display Order</label>
                        <input type="text" class="cm-input" placeholder="20" @bind="displayOrderString" />
                    </div>
                </div>

                <!-- Row 2: Short Name, Description -->
                <div class="cm-form-row two-cols-narrow-wide">
                    <div class="cm-field-group">
                        <label class="cm-label">Short Name</label>
                        <input type="text" class="cm-input" placeholder="Ex: CHN" @bind="currentCity.shortname" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">City Description</label>
                        <input type="text" class="cm-input" placeholder="Specify any specific instructions..." @bind="currentCity.description" />
                    </div>
                </div>
            </div>

            <div class="cm-modal-footer">
                @if (isEditMode)
                {
                    <button class="cm-btn-delete" @onclick="() => DeleteCity(currentCity)">Delete</button>
                }
                else
                {
                    <span></span>
                }
                <div class="cm-footer-right-buttons" style="display: flex; gap: 0.75rem; align-items: center;">
                    <button class="cm-btn-cancel" @onclick="CloseModal">Cancel</button>
                    <button class="cm-btn-save" @onclick="SaveCity">
                        <i class="bi bi-check2"></i> Save City
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CityMasterModel> cities = new();
    private string searchQuery = "";
    private bool showModal = false;
    private bool isEditMode = false;
    private CityMasterModel currentCity = new();
    private bool showCityDropdown = false;

    private IEnumerable<CityMasterModel> CitySuggestions =>
        string.IsNullOrWhiteSpace(currentCity.cityname)
            ? Enumerable.Empty<CityMasterModel>()
            : cities.Where(c => c.cityname != null && c.cityname.Contains(currentCity.cityname, StringComparison.OrdinalIgnoreCase)).Take(8);

    private void OnCityNameInput(ChangeEventArgs e)
    {
        string typed = e.Value?.ToString() ?? "";
        currentCity.cityname = typed;
        showCityDropdown = true;

        if (string.IsNullOrWhiteSpace(typed))
        {
            isEditMode = false;
            currentCity.citycode = 0;
            return;
        }

        var match = cities.FirstOrDefault(c => string.Equals(c.cityname, typed, StringComparison.OrdinalIgnoreCase));
        if (match != null)
        {
            EditCity(match);
        }
    }

    private void SelectCity(CityMasterModel item)
    {
        EditCity(item);
        showCityDropdown = false;
    }

    private async Task OnCityNameBlur()
    {
        await Task.Delay(250);
        showCityDropdown = false;
    }

    private string displayOrderString
    {
        get => currentCity.orderno == 0 ? "" : currentCity.orderno.ToString();
        set => currentCity.orderno = int.TryParse(value, out var v) ? v : 0;
    }

    private IEnumerable<CityMasterModel> FilteredCities =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? cities
            : cities.Where(c => 
                (c.cityname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.shortname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadCities();
    }

    private async Task LoadCities()
    {
        try
        {
            var res = await CityService.GetCitiesAsync();
            if (res != null)
            {
                cities = res.Where(c => !string.IsNullOrEmpty(c.tenant_code)).OrderBy(c => c.orderno).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load cities: {ex.Message}");
        }
    }

    private void OpenNewCityModal()
    {
        currentCity = new CityMasterModel { orderno = 0 };
        isEditMode = false;
        showModal = true;
    }

    private void EditCity(CityMasterModel city)
    {
        currentCity = new CityMasterModel
        {
            citycode = city.citycode,
            tenant_code = city.tenant_code,
            orderno = city.orderno,
            shortname = city.shortname,
            cityname = city.cityname,
            description = city.description
        };
        isEditMode = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveCity()
    {
        try
        {
            bool success;
            if (isEditMode)
            {
                success = await CityService.UpdateCityAsync(currentCity);
            }
            else
            {
                currentCity.entereddate = DateTime.Now;
                currentCity.ibsdate = DateTime.Now;
                currentCity.tenant_code = "TEN1011";
                success = await CityService.InsertCityAsync(currentCity);
            }

            if (success)
            {
                ToastService.ShowSuccess("City saved successfully.");
                if (isEditMode)
                {
                    showModal = false;
                }
                else
                {
                    currentCity = new CityMasterModel { orderno = 0 };
                }
                await LoadCities();
            }
            else
            {
                ToastService.ShowError("Failed to save city.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task DeleteCity(CityMasterModel city)
    {
        try
        {
            bool success = await CityService.DeleteCityAsync(city.citycode);
            if (success)
            {
                ToastService.ShowSuccess("City deleted successfully.");
                if (showModal) showModal = false;
                await LoadCities();
            }
            else
            {
                ToastService.ShowError("Failed to delete city.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }
}
