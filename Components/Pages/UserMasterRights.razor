@page "/user-rights-template"
@page "/user-master-rights"
@using Booking.Models
@using Booking.Services
@using SharedComponents.Rcl.Services
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject RoleMasterService RoleService
@inject TenantSessionState TenantState
@inject ToastService Toast
@inject IJSRuntime JSRuntime

<div class="user-rights-page">
    <!-- ── Top Header Bar ── -->
    <div class="page-header">
        <div class="header-left">
            <div class="header-icon-box">
                <i class="bi bi-shield-shaded"></i>
            </div>
            <div>
                <div class="header-breadcrumb">
                    <span>Admin Portal</span>
                    <i class="bi bi-chevron-right"></i>
                    <span class="active">User Rights Template</span>
                </div>
                <h1 class="header-title">User Rights Template</h1>
                <p class="header-subtitle">Configure reusable role security templates and granular permission matrices across all 11 hospital domains</p>
            </div>
        </div>

        <div class="header-actions">
            @if (!isEditingMode)
            {
                <button class="btn btn-create-template" @onclick="CreateNewRoleTemplate">
                    <i class="bi bi-plus-lg"></i>
                    <span>Create Role Template</span>
                </button>
            }
            else
            {
                <button class="btn btn-back-directory" @onclick="CancelEditing">
                    <i class="bi bi-arrow-left"></i>
                    <span>Back to Directory</span>
                </button>
                <button class="btn btn-save-template" @onclick="SaveRoleTemplate" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle"></i>
                        <span>Save Template</span>
                    }
                </button>
            }
        </div>
    </div>

    @if (!isEditingMode)
    {
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- VIEW 1: ROLES DIRECTORY VIEW                                       -->
        <!-- ══════════════════════════════════════════════════════════════════ -->

        <!-- KPI Summary Cards -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-icon-wrapper bg-indigo">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
                <div class="kpi-content">
                    <span class="kpi-label">Created Templates</span>
                    <h3 class="kpi-value">@rolesList.Count</h3>
                    <span class="kpi-hint">Tenant custom templates</span>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon-wrapper bg-emerald">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
                <div class="kpi-content">
                    <span class="kpi-label">System Domains</span>
                    <h3 class="kpi-value">11</h3>
                    <span class="kpi-hint">Clinical &amp; Administrative</span>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon-wrapper bg-amber">
                    <i class="bi bi-key-fill"></i>
                </div>
                <div class="kpi-content">
                    <span class="kpi-label">Granular Rights</span>
                    <h3 class="kpi-value">364</h3>
                    <span class="kpi-hint">MEDICO_APP Security Matrix</span>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon-wrapper bg-rose">
                    <i class="bi bi-hospital-fill"></i>
                </div>
                <div class="kpi-content">
                    <span class="kpi-label">Active Tenant</span>
                    <h3 class="kpi-value tenant-code-badge">@(string.IsNullOrWhiteSpace(TenantState.TenantCode) ? "Default" : TenantState.TenantCode)</h3>
                    <span class="kpi-hint">Facility ID</span>
                </div>
            </div>
        </div>

        <!-- Directory Toolbar -->
        <div class="directory-toolbar">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" 
                       class="form-control" 
                       placeholder="Search templates by role name or domain..." 
                       @bind="roleSearchQuery" 
                       @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(roleSearchQuery))
                {
                    <button class="clear-search-btn" @onclick="@(() => roleSearchQuery = string.Empty)">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>

            <div class="directory-counts">
                <span>Showing <strong>@FilteredRoles.Count</strong> of <strong>@rolesList.Count</strong> templates</span>
            </div>
        </div>

        <!-- Role Templates Grid -->
        @if (isLoadingRoles)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary" role="status"></div>
                <p>Loading role templates...</p>
            </div>
        }
        else if (!FilteredRoles.Any())
        {
            <div class="empty-state">
                <div class="empty-icon-circle">
                    <i class="bi bi-shield-slash"></i>
                </div>
                <h3>No Role Templates Found</h3>
                <p>
                    @if (string.IsNullOrWhiteSpace(roleSearchQuery))
                    {
                        <span>No role templates have been defined for this facility yet. Get started by creating your first template.</span>
                    }
                    else
                    {
                        <span>No role templates match the search query "<strong>@roleSearchQuery</strong>".</span>
                    }
                </p>
                @if (string.IsNullOrWhiteSpace(roleSearchQuery))
                {
                    <button class="btn btn-create-template" @onclick="CreateNewRoleTemplate">
                        <i class="bi bi-plus-lg"></i>
                        <span>Create Role Template</span>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="roles-grid">
                @foreach (var role in FilteredRoles)
                {
                    var percent = Math.Round((double)role.TotalPermissionsAssigned / 364.0 * 100, 1);
                    <div class="role-card">
                        <div class="role-card-header">
                            <div class="role-avatar">
                                <i class="bi bi-person-fill-gear"></i>
                            </div>
                            <div class="role-title-group">
                                <h4 class="role-name" title="@role.Role_Name">@role.Role_Name</h4>
                                <span class="role-assigned-badge">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    @role.TotalPermissionsAssigned / 364 Rights
                                </span>
                            </div>
                        </div>

                        <div class="role-card-body">
                            <!-- Progress Bar -->
                            <div class="progress-container">
                                <div class="progress-info">
                                    <span>Coverage</span>
                                    <span class="progress-percent">@percent%</span>
                                </div>
                                <div class="progress-track">
                                    <div class="progress-fill" style="width: @percent%"></div>
                                </div>
                            </div>

                            <!-- Covered Domains -->
                            <div class="domains-container">
                                <span class="domains-label">Covered Domains:</span>
                                <div class="domains-chips">
                                    @if (role.MainModulesCovered.Any())
                                    {
                                        @foreach (var mod in role.MainModulesCovered.Take(4))
                                        {
                                            <span class="domain-chip">
                                                <i class="bi @RoleService.GetModuleIcon(mod)"></i>
                                                @mod
                                            </span>
                                        }
                                        @if (role.MainModulesCovered.Count > 4)
                                        {
                                            <span class="domain-chip more-chip">+@(role.MainModulesCovered.Count - 4) more</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No permissions selected</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="role-card-footer">
                            <button class="btn-action btn-edit" @onclick="() => EditRoleTemplate(role)" title="Edit Template">
                                <i class="bi bi-pencil-fill"></i>
                                <span>Edit</span>
                            </button>
                            <button class="btn-action btn-clone" @onclick="() => CloneRoleTemplate(role)" title="Duplicate / Clone Template">
                                <i class="bi bi-copy"></i>
                                <span>Clone</span>
                            </button>
                            <button class="btn-action btn-delete" @onclick="() => PromptDeleteRole(role)" title="Delete Template">
                                <i class="bi bi-trash3-fill"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- VIEW 2: ROLE EDITOR WORKSPACE                                      -->
        <!-- ══════════════════════════════════════════════════════════════════ -->

        <!-- Sticky Editor Control Bar -->
        <div class="editor-sticky-bar">
            <div class="editor-input-group">
                <label for="roleNameInput" class="form-label mb-1">
                    Role Template Name <span class="text-danger">*</span>
                </label>
                <div class="input-with-icon">
                    <i class="bi bi-person-badge"></i>
                    <input id="roleNameInput" 
                           type="text" 
                           class="form-control role-name-input @(hasNameValidationError ? "is-invalid" : "")" 
                           placeholder="e.g. Staff Nurse (IP), OP Billing Cashier, Duty Medical Officer..." 
                           @bind="currentRoleName" 
                           @bind:event="oninput" 
                           @onchange="ClearValidation" />
                </div>
                @if (hasNameValidationError)
                {
                    <div class="text-danger small mt-1">Please enter a valid role template name.</div>
                }
            </div>

            <div class="editor-counter-badge">
                <span class="counter-number">@SelectedCount</span>
                <span class="counter-divider">/</span>
                <span class="counter-total">364</span>
                <span class="counter-label">Rights Granted (@SelectedPercent%)</span>
            </div>

            <div class="editor-batch-actions">
                <button type="button" class="btn btn-batch btn-select-all" @onclick="SelectAllPermissions" title="Grant all 364 permissions">
                    <i class="bi bi-check-all"></i>
                    <span>Select All</span>
                </button>
                <button type="button" class="btn btn-batch btn-clear-all" @onclick="DeselectAllPermissions" title="Clear all selections">
                    <i class="bi bi-dash-circle"></i>
                    <span>Clear All</span>
                </button>
                <button type="button" class="btn btn-batch btn-expand-all" @onclick="ExpandAllModules" title="Expand all sections">
                    <i class="bi bi-arrows-expand"></i>
                    <span>Expand All</span>
                </button>
                <button type="button" class="btn btn-batch btn-collapse-all" @onclick="CollapseAllModules" title="Collapse all sections">
                    <i class="bi bi-arrows-collapse"></i>
                    <span>Collapse All</span>
                </button>
            </div>
        </div>

        <!-- Editor Tree Search Filter -->
        <div class="editor-search-bar">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" 
                       class="form-control" 
                       placeholder="Filter 364 permissions by module, sub-module, or action name (e.g. 'walkin', 'billing', 'discharge', 'indent')..." 
                       @bind="permissionSearchQuery" 
                       @bind:event="oninput" 
                       @onkeyup="OnSearchPermissionChanged" />
                @if (!string.IsNullOrWhiteSpace(permissionSearchQuery))
                {
                    <button class="clear-search-btn" @onclick="ClearPermissionSearch">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(permissionSearchQuery))
            {
                <span class="search-feedback-badge">
                    Filtering matches for "<strong>@permissionSearchQuery</strong>"
                </span>
            }
        </div>

        <!-- 3-Level Permission Accordion Tree -->
        <div class="hierarchy-tree-container">
            @foreach (var modNode in hierarchyTree)
            {
                if (!modNode.IsVisible) continue;

                <div class="module-card @(modNode.IsAllSelected ? "module-all-selected" : modNode.SelectedCount > 0 ? "module-partially-selected" : "")">
                    <!-- Level 1: Main Module Header -->
                    <div class="module-header" @onclick="() => ToggleModuleExpanded(modNode)">
                        <div class="module-header-left">
                            <span class="module-icon-box">
                                <i class="bi @modNode.Icon"></i>
                            </span>
                            <span class="module-title">@modNode.ModuleName</span>
                            <span class="module-count-badge">
                                @modNode.SelectedCount / @modNode.TotalCount Rights
                            </span>
                        </div>

                        <div class="module-header-right" @onclick:stopPropagation="true">
                            <label class="custom-checkbox-wrapper select-all-module-label">
                                <input type="checkbox" 
                                       checked="@modNode.IsAllSelected" 
                                       @onchange="(e) => ToggleModuleSelectAll(modNode, e)" />
                                <span class="checkmark"></span>
                                <span class="checkbox-text">Select All Module</span>
                            </label>

                            <button type="button" class="btn-chevron" @onclick="() => ToggleModuleExpanded(modNode)">
                                <i class="bi bi-chevron-down @(modNode.IsExpanded ? "rotate-open" : "")"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Level 2 & 3: Sub-Modules and Actions -->
                    @if (modNode.IsExpanded)
                    {
                        <div class="module-body">
                            @foreach (var subNode in modNode.SubModules)
                            {
                                if (!subNode.IsVisible) continue;

                                <div class="submodule-card">
                                    <div class="submodule-header">
                                        <div class="submodule-header-left" @onclick="() => ToggleSubModuleExpanded(subNode)">
                                            <i class="bi bi-chevron-right submodule-chevron @(subNode.IsExpanded ? "rotate-open" : "")"></i>
                                            <span class="submodule-title">@subNode.SubModuleName</span>
                                            <span class="submodule-count-badge">
                                                @subNode.SelectedCount / @subNode.TotalCount
                                            </span>
                                        </div>

                                        <div class="submodule-header-right">
                                            <label class="custom-checkbox-wrapper select-all-submodule-label">
                                                <input type="checkbox" 
                                                       checked="@subNode.IsAllSelected" 
                                                       @onchange="(e) => ToggleSubModuleSelectAll(subNode, e)" />
                                                <span class="checkmark"></span>
                                                <span class="checkbox-text">Select Sub-Module</span>
                                            </label>
                                        </div>
                                    </div>

                                    @if (subNode.IsExpanded)
                                    {
                                        <!-- Level 3: Granular Action Chips Grid -->
                                        <div class="actions-grid">
                                            @foreach (var act in subNode.Actions)
                                            {
                                                if (!act.IsVisible) continue;

                                                <div class="action-chip @(act.IsSelected ? "action-chip-selected" : "")" 
                                                     @onclick="() => ToggleActionSelection(act)">
                                                    <label class="custom-checkbox-wrapper action-checkbox" @onclick:stopPropagation="true">
                                                        <input type="checkbox" 
                                                               checked="@act.IsSelected" 
                                                               @onchange="() => ToggleActionSelection(act)" />
                                                        <span class="checkmark"></span>
                                                    </label>
                                                    <span class="action-name">@act.ActionName</span>
                                                    <span class="action-id-tag">#@act.Role_id</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- ── Delete Confirmation Modal ── -->
@if (roleToDelete != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-dialog-custom">
            <div class="modal-content-custom">
                <div class="modal-header-custom">
                    <div class="modal-icon-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div>
                        <h4 class="modal-title-custom">Delete Role Template</h4>
                        <p class="modal-subtitle-custom">This action will permanently delete this role template for your facility.</p>
                    </div>
                </div>

                <div class="modal-body-custom">
                    <p>Are you sure you want to delete the role template <strong>"@roleToDelete.Role_Name"</strong>?</p>
                    <p class="text-muted small mb-0">Total permissions assigned: <strong>@roleToDelete.TotalPermissionsAssigned</strong></p>
                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteRole" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <i class="bi bi-trash3-fill me-1"></i>
                            <span>Confirm Delete</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isEditingMode = false;
    private bool isLoadingRoles = true;
    private bool isSaving = false;
    private bool isDeleting = false;
    private bool hasNameValidationError = false;

    private string currentRoleName = string.Empty;
    private Guid? currentRoleGuid = null;

    private string roleSearchQuery = string.Empty;
    private string permissionSearchQuery = string.Empty;

    private List<RolePermissionItem> masterCatalog = new();
    private List<RoleSummaryDto> rolesList = new();
    private List<ModuleTreeNode> hierarchyTree = new();
    private RoleSummaryDto? roleToDelete = null;

    private List<RoleSummaryDto> FilteredRoles
    {
        get
        {
            if (string.IsNullOrWhiteSpace(roleSearchQuery)) return rolesList;
            var q = roleSearchQuery.Trim().ToLowerInvariant();
            return rolesList.Where(r => 
                r.Role_Name.ToLowerInvariant().Contains(q) ||
                r.MainModulesCovered.Any(m => m.ToLowerInvariant().Contains(q))
            ).ToList();
        }
    }

    private int SelectedCount => hierarchyTree.Sum(m => m.SelectedCount);
    private double SelectedPercent => Math.Round((double)SelectedCount / 364.0 * 100, 1);

    protected override async Task OnInitializedAsync()
    {
        // 1. Instantaneous 0-ms catalog initialization from pre-compiled static defaults
        masterCatalog = RoleCatalogDefaults.GetDefaultPermissions();
        hierarchyTree = RoleService.BuildHierarchy(masterCatalog, new HashSet<long>());

        // 2. Load tenant roles & live master permissions in background
        await LoadRolesAndCatalogAsync();
    }

    private async Task LoadRolesAndCatalogAsync()
    {
        isLoadingRoles = true;
        try
        {
            var liveCatalogTask = RoleService.GetMasterCatalogAsync();
            var rolesTask = RoleService.GetRolesAsync();

            await Task.WhenAll(liveCatalogTask, rolesTask);

            if (liveCatalogTask.Result != null && liveCatalogTask.Result.Any())
            {
                masterCatalog = liveCatalogTask.Result;
            }

            rolesList = rolesTask.Result ?? new List<RoleSummaryDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[UserMasterRights] Error loading initial data: {ex.Message}");
            Toast.Error("Failed to load roles from server. Please refresh.");
        }
        finally
        {
            isLoadingRoles = false;
            StateHasChanged();
        }
    }

    private void CreateNewRoleTemplate()
    {
        currentRoleGuid = null;
        currentRoleName = string.Empty;
        hasNameValidationError = false;
        permissionSearchQuery = string.Empty;

        // Reset tree with 0 selections
        hierarchyTree = RoleService.BuildHierarchy(masterCatalog, new HashSet<long>());
        isEditingMode = true;
    }

    private async Task EditRoleTemplate(RoleSummaryDto role)
    {
        currentRoleGuid = role.RoleNameGUID;
        currentRoleName = role.Role_Name;
        hasNameValidationError = false;
        permissionSearchQuery = string.Empty;

        // Fetch latest role details from API to ensure fresh permission list
        var fullRole = await RoleService.GetRoleAsync(role.RoleNameGUID);
        var assigned = new HashSet<long>(fullRole?.AssignedRoleIds ?? role.AssignedRoleIds);

        hierarchyTree = RoleService.BuildHierarchy(masterCatalog, assigned);
        isEditingMode = true;
    }

    private void CloneRoleTemplate(RoleSummaryDto role)
    {
        currentRoleGuid = null; // New GUID upon save
        currentRoleName = $"{role.Role_Name} (Copy)";
        hasNameValidationError = false;
        permissionSearchQuery = string.Empty;

        var assigned = new HashSet<long>(role.AssignedRoleIds);
        hierarchyTree = RoleService.BuildHierarchy(masterCatalog, assigned);
        isEditingMode = true;

        Toast.Info($"Duplicated template '{role.Role_Name}'. Modify and save when ready.");
    }

    private void CancelEditing()
    {
        isEditingMode = false;
        currentRoleGuid = null;
        currentRoleName = string.Empty;
        hasNameValidationError = false;
        permissionSearchQuery = string.Empty;
    }

    private void ClearValidation()
    {
        if (!string.IsNullOrWhiteSpace(currentRoleName))
        {
            hasNameValidationError = false;
        }
    }

    private async Task SaveRoleTemplate()
    {
        if (string.IsNullOrWhiteSpace(currentRoleName))
        {
            hasNameValidationError = true;
            Toast.Warning("Please enter a name for the role template.");
            return;
        }

        // Collect all selected Role_ids
        var selectedRoleIds = hierarchyTree
            .SelectMany(m => m.SubModules)
            .SelectMany(s => s.Actions)
            .Where(a => a.IsSelected)
            .Select(a => a.Role_id)
            .Distinct()
            .ToList();

        if (!selectedRoleIds.Any())
        {
            Toast.Warning("Please select at least one permission right for this template.");
            return;
        }

        isSaving = true;
        try
        {
            var req = new RoleSaveRequest
            {
                RoleNameGUID = currentRoleGuid,
                Role_Name = currentRoleName.Trim(),
                Role_ids = selectedRoleIds
            };

            var (success, newGuid, message) = await RoleService.SaveRoleAsync(req);
            if (success)
            {
                Toast.Success("Role template saved successfully.");
                isEditingMode = false;
                await LoadRolesAndCatalogAsync();
            }
            else
            {
                Toast.Error(message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to save: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void PromptDeleteRole(RoleSummaryDto role)
    {
        roleToDelete = role;
    }

    private void CancelDelete()
    {
        roleToDelete = null;
    }

    private async Task ConfirmDeleteRole()
    {
        if (roleToDelete == null) return;

        isDeleting = true;
        try
        {
            var (success, message) = await RoleService.DeleteRoleAsync(roleToDelete.RoleNameGUID);
            if (success)
            {
                Toast.Success($"Role template '{roleToDelete.Role_Name}' deleted.");
                roleToDelete = null;
                await LoadRolesAndCatalogAsync();
            }
            else
            {
                Toast.Error(message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error deleting: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
        }
    }

    // ── Hierarchy Tree Interaction Handlers ──

    private void ToggleActionSelection(ActionPermissionNode act)
    {
        act.IsSelected = !act.IsSelected;
    }

    private void ToggleModuleExpanded(ModuleTreeNode mod)
    {
        mod.IsExpanded = !mod.IsExpanded;
    }

    private void ToggleSubModuleExpanded(SubModuleTreeNode sub)
    {
        sub.IsExpanded = !sub.IsExpanded;
    }

    private void ToggleModuleSelectAll(ModuleTreeNode mod, ChangeEventArgs e)
    {
        var select = (bool)(e.Value ?? false);
        foreach (var sub in mod.SubModules)
        {
            foreach (var act in sub.Actions)
            {
                act.IsSelected = select;
            }
        }
    }

    private void ToggleSubModuleSelectAll(SubModuleTreeNode sub, ChangeEventArgs e)
    {
        var select = (bool)(e.Value ?? false);
        foreach (var act in sub.Actions)
        {
            act.IsSelected = select;
        }
    }

    private void SelectAllPermissions()
    {
        foreach (var mod in hierarchyTree)
        {
            foreach (var sub in mod.SubModules)
            {
                foreach (var act in sub.Actions)
                {
                    act.IsSelected = true;
                }
            }
        }
        Toast.Info("All 364 permissions selected.");
    }

    private void DeselectAllPermissions()
    {
        foreach (var mod in hierarchyTree)
        {
            foreach (var sub in mod.SubModules)
            {
                foreach (var act in sub.Actions)
                {
                    act.IsSelected = false;
                }
            }
        }
        Toast.Info("All selections cleared.");
    }

    private void ExpandAllModules()
    {
        foreach (var mod in hierarchyTree)
        {
            mod.IsExpanded = true;
            foreach (var sub in mod.SubModules)
            {
                sub.IsExpanded = true;
            }
        }
    }

    private void CollapseAllModules()
    {
        foreach (var mod in hierarchyTree)
        {
            mod.IsExpanded = false;
            foreach (var sub in mod.SubModules)
            {
                sub.IsExpanded = false;
            }
        }
    }

    private void OnSearchPermissionChanged()
    {
        if (string.IsNullOrWhiteSpace(permissionSearchQuery))
        {
            ClearPermissionSearch();
            return;
        }

        var q = permissionSearchQuery.Trim().ToLowerInvariant();

        foreach (var mod in hierarchyTree)
        {
            var modMatches = mod.ModuleName.ToLowerInvariant().Contains(q);
            var anySubMatches = false;

            foreach (var sub in mod.SubModules)
            {
                var subMatches = sub.SubModuleName.ToLowerInvariant().Contains(q);
                var anyActMatches = false;

                foreach (var act in sub.Actions)
                {
                    var actMatches = modMatches || subMatches || act.ActionName.ToLowerInvariant().Contains(q) || act.Role_id.ToString().Contains(q);
                    act.IsVisible = actMatches;
                    if (actMatches) anyActMatches = true;
                }

                sub.IsVisible = subMatches || anyActMatches;
                if (sub.IsVisible)
                {
                    anySubMatches = true;
                    sub.IsExpanded = true; // Auto-expand matching submodules
                }
            }

            mod.IsVisible = modMatches || anySubMatches;
            if (mod.IsVisible)
            {
                mod.IsExpanded = true; // Auto-expand matching modules
            }
        }
    }

    private void ClearPermissionSearch()
    {
        permissionSearchQuery = string.Empty;
        foreach (var mod in hierarchyTree)
        {
            mod.IsVisible = true;
            foreach (var sub in mod.SubModules)
            {
                sub.IsVisible = true;
                foreach (var act in sub.Actions)
                {
                    act.IsVisible = true;
                }
            }
        }
    }
}
