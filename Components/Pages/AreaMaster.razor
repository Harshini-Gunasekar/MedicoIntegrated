@page "/area-master"
@rendermode InteractiveServer
@using Medico_Backend.Model
@using Booking.Services
@inject AreaMasterService AreaService
@inject CityMasterService CityService
@inject StateMasterService StateService
@inject CountryMasterService CountryService
@inject ToastService ToastService

<div class="cm-page">
    <!-- Header Card -->
    <div class="cm-header-card">
        <div class="cm-header-left">
            <h1 class="cm-title">Area Master</h1>
            <span class="cm-subtitle">Location Configuration</span>
        </div>
        <div class="cm-header-right">
            <div class="cm-search-box">
                <i class="bi bi-search cm-search-icon"></i>
                <input type="text" class="cm-search-input" placeholder="Quick find..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            <button class="cm-btn-new" @onclick="OpenNewAreaModal">
                + New Area Entry
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="cm-table-card">
        <table class="cm-table">
            <thead>
                <tr>
                    <th>ORDER NO</th>
                    <th>SHORT NAME</th>
                    <th>AREA NAME</th>
                    <th>PINCODE</th>
                    <th>DESCRIPTION</th>
                    <th>ENTERED DATE</th>
                    <th>MODIFIED DATE</th>
                    <th>ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredAreas.Any())
                {
                    @foreach (var item in FilteredAreas)
                    {
                        <tr>
                            <td class="col-orderno">@item.orderno</td>
                            <td class="col-shortname">@item.shortname</td>
                            <td class="col-name">
                                <span class="counter-name-text">@item.areaname</span>
                            </td>
                            <td class="col-pincode">@item.areapincode</td>
                            <td class="col-narration">@item.description</td>
                            <td class="col-date-entered">
                                <span class="date-line">@item.entereddate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.entereddate.ToString("tt") == "AM" ? "am" : "pm")">@item.entereddate.ToString("tt")</span>
                            </td>
                            <td class="col-date-modified">
                                <span class="date-line">@item.ibsdate.ToString("MM-dd-yyyy hh:mm")</span>
                                <span class="ampm-line @(item.ibsdate.ToString("tt") == "AM" ? "am" : "pm")">@item.ibsdate.ToString("tt")</span>
                            </td>
                            <td class="col-action">
                                <button class="cm-action-btn edit" title="Edit" @onclick="() => EditArea(item)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="cm-action-btn delete" title="Delete" @onclick="() => DeleteArea(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="cm-empty-row">
                            <i class="bi bi-display"></i>
                            <div>No areas found</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showModal)
{
    <div class="cm-backdrop">
        <div class="cm-modal">
            <div class="cm-modal-header">
                <h2 class="cm-modal-title">@(isEditMode ? "Edit Area Entry" : "New Area Entry")</h2>
                <button class="cm-close-btn" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cm-modal-body">
                <!-- Area Name - full width -->
                <div class="cm-field-group">
                    <label class="cm-label">Area Name</label>
                    <input type="text" class="cm-input" placeholder="Ex: Anna Nagar" @bind="currentArea.areaname" />
                </div>

                <!-- Row 1: Display Order, Short Name, Pincode -->
                <div class="cm-form-row three-cols">
                    <div class="cm-field-group">
                        <label class="cm-label">Display Order</label>
                        <input type="text" class="cm-input" placeholder="20" @bind="displayOrderString" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Short Name</label>
                        <input type="text" class="cm-input" placeholder="Ex: ANNA" @bind="currentArea.shortname" />
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Area Pincode</label>
                        <input type="text" class="cm-input" placeholder="Ex: 600040" @bind="currentArea.areapincode" />
                    </div>
                </div>

                <!-- Row 2: City, State, Country -->
                <div class="cm-form-row three-cols">
                    <div class="cm-field-group">
                        <label class="cm-label">City</label>
                        <select class="cm-input cm-select" @bind="currentArea.citycode">
                            <option value="">Select City</option>
                            @foreach (var city in cities)
                            {
                                <option value="@city.citycode">@city.cityname</option>
                            }
                        </select>
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">State</label>
                        <select class="cm-input cm-select" @bind="currentArea.statecode">
                            <option value="">Select State</option>
                            @foreach (var state in states)
                            {
                                <option value="@state.statecode">@state.statename</option>
                            }
                        </select>
                    </div>
                    <div class="cm-field-group">
                        <label class="cm-label">Country</label>
                        <select class="cm-input cm-select" @bind="currentArea.countrycode">
                            <option value="">Select Country</option>
                            @foreach (var country in countries)
                            {
                                <option value="@country.countrycode">@country.countryname</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Row 3: Description -->
                <div class="cm-form-row">
                    <div class="cm-field-group desc-field">
                        <label class="cm-label">Area Description</label>
                        <input type="text" class="cm-input" placeholder="Specify any specific instructions..." @bind="currentArea.description" />
                    </div>
                </div>
            </div>

            <div class="cm-modal-footer">
                @if (isEditMode)
                {
                    <button class="cm-btn-delete" @onclick="() => DeleteArea(currentArea)">Delete</button>
                }
                else
                {
                    <span></span>
                }
                <div class="cm-footer-right-buttons" style="display: flex; gap: 0.75rem; align-items: center;">
                    <button class="cm-btn-cancel" @onclick="CloseModal">Cancel</button>
                    <button class="cm-btn-save" @onclick="SaveArea">
                        <i class="bi bi-check2"></i> Save Area
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AreaMasterModel> areas = new();
    private string searchQuery = "";
    private bool showModal = false;
    private bool isEditMode = false;
    private AreaMasterModel currentArea = new();

    private string displayOrderString
    {
        get => currentArea.orderno == 0 ? "" : currentArea.orderno.ToString();
        set => currentArea.orderno = int.TryParse(value, out var v) ? v : 0;
    }

    private IEnumerable<AreaMasterModel> FilteredAreas =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? areas
            : areas.Where(a => 
                (a.areaname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.shortname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.areapincode?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    private List<CityMasterModel> cities = new();
    private List<StateMasterModel> states = new();
    private List<CountryMasterModel> countries = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLocations();
        await LoadAreas();
    }

    private async Task LoadLocations()
    {
        try
        {
            var cits = await CityService.GetCitiesAsync();
            cities = cits.Where(c => !string.IsNullOrEmpty(c.tenant_code)).OrderBy(c => c.cityname).ToList();

            var sts = await StateService.GetStatesAsync();
            states = sts.Where(s => !string.IsNullOrEmpty(s.tenant_code)).OrderBy(s => s.statename).ToList();

            var ctrs = await CountryService.GetCountriesAsync();
            countries = ctrs.Where(c => !string.IsNullOrEmpty(c.tenant_code)).OrderBy(c => c.countryname).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading location drop-downs: {ex.Message}");
        }
    }

    private async Task LoadAreas()
    {
        try
        {
            var res = await AreaService.GetAreasAsync();
            if (res != null)
            {
                areas = res.Where(a => !string.IsNullOrEmpty(a.tenant_code)).OrderBy(a => a.orderno).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load areas: {ex.Message}");
        }
    }

    private void OpenNewAreaModal()
    {
        currentArea = new AreaMasterModel { orderno = 0, citycode = null, statecode = null, countrycode = null };
        isEditMode = false;
        showModal = true;
    }

    private void EditArea(AreaMasterModel area)
    {
        currentArea = new AreaMasterModel
        {
            areacode = area.areacode,
            tenant_code = area.tenant_code,
            orderno = area.orderno,
            shortname = area.shortname,
            areaname = area.areaname,
            citycode = area.citycode,
            areapincode = area.areapincode,
            statecode = area.statecode,
            countrycode = area.countrycode,
            description = area.description
        };
        isEditMode = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveArea()
    {
        try
        {
            bool success;
            if (isEditMode)
            {
                success = await AreaService.UpdateAreaAsync(currentArea);
            }
            else
            {
                currentArea.entereddate = DateTime.Now;
                currentArea.ibsdate = DateTime.Now;
                currentArea.tenant_code = "TEN1011";
                success = await AreaService.InsertAreaAsync(currentArea);
            }

            if (success)
            {
                ToastService.ShowSuccess("Area saved successfully.");
                showModal = false;
                await LoadAreas();
            }
            else
            {
                ToastService.ShowError("Failed to save area.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task DeleteArea(AreaMasterModel area)
    {
        try
        {
            bool success = await AreaService.DeleteAreaAsync(area.areacode);
            if (success)
            {
                ToastService.ShowSuccess("Area deleted successfully.");
                if (showModal) showModal = false;
                await LoadAreas();
            }
            else
            {
                ToastService.ShowError("Failed to delete area.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }
}
