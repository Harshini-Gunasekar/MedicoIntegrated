    private void SetView(bool card)
    {
        IsCardView = card;
        CurrentPage = 1;
    }
    private void OnSearchInput(ChangeEventArgs e) { SearchQuery = e.Value?.ToString() ?? ""; CurrentPage = 1; }
    private void ChangePage(int p) { if (p >= 1 && p <= TotalPages) CurrentPage = p; }

    private string GetStockVolumeBadge(stock_master stock)
    {
        if (stock.closingstock <= 0) return "badge-stock-empty";
        var item = ItemList.FirstOrDefault(i => i.itemcode == stock.itemcode);
        decimal minStock = item?.minstock ?? 0;
        if (minStock > 0 && stock.closingstock <= minStock) return "badge-stock-low";
        return "badge-stock-high";
    }

    private string GetStockVolumeLabel(stock_master stock)
    {
        if (stock.closingstock <= 0) return "OUT OF STOCK";
        var item = ItemList.FirstOrDefault(i => i.itemcode == stock.itemcode);
        decimal minStock = item?.minstock ?? 0;
        if (minStock > 0 && stock.closingstock <= minStock) return "LOW STOCK";
        return "IN STOCK";
    }

