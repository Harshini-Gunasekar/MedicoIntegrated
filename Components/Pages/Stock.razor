    private string GetStockVolumeBadge(stock_master stock)
    {
        if (stock.closingstock <= 0) return "badge-stock-empty";
        var item = ItemList.FirstOrDefault(i => i.itemcode == stock.itemcode);
        decimal minStock = item?.minstock ?? 0;
        if (minStock > 0 && stock.closingstock <= minStock) return "badge-stock-low";
        return "badge-stock-high";
    }

    private string GetStockVolumeLabel(stock_master stock)
    {
        if (stock.closingstock <= 0) return "OUT OF STOCK";
        var item = ItemList.FirstOrDefault(i => i.itemcode == stock.itemcode);
        decimal minStock = item?.minstock ?? 0;
        if (minStock > 0 && stock.closingstock <= minStock) return "LOW STOCK";
        return "IN STOCK";
    }

    private bool isPrinting = false;
    private bool isPrintingPdf = false;
    private long selectedReportWarehouseCode = 0;
    private DateTime selectedReportDate = DateTime.Now;

    private async Task<string> FetchStockReportBase64(long? warehouseCode = null)
    {
        if (string.IsNullOrWhiteSpace(DefaultTenant))
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success ? tenantCodeResult.Value ?? "0010" : "0010";
        }

        if (string.IsNullOrWhiteSpace(AuthToken))
        {
            try
            {
                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                if (!tokenResult.Success || string.IsNullOrEmpty(tokenResult.Value))
                {
                    tokenResult = await _sessionStorage.GetAsync<string>("auth_token");
                }
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : (TenantState?.AuthToken ?? "");
            }
            catch {}
        }

        long code = warehouseCode ?? selectedReportWarehouseCode;
        string dateStr = selectedReportDate.ToString("yyyy-MM-dd");

        string reportUrl = $"https://medicoapi.iscansoft.com/api/report/stock-report?warehousecode={code}&date={dateStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}";

        var client = CreateClient();
        var req = new HttpRequestMessage(HttpMethod.Get, reportUrl);
        var effectiveToken = !string.IsNullOrEmpty(AuthToken) ? AuthToken : TenantState?.AuthToken;
        if (!string.IsNullOrEmpty(effectiveToken))
        {
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
        }
        req.Headers.Add("tenantcode", DefaultTenant);
        req.Headers.Add("tenant_code", DefaultTenant);
        req.Headers.Add("tenant-code", DefaultTenant);

        var response = await client.SendAsync(req);

        if (!response.IsSuccessStatusCode)
        {
            // Fallback to relative HTTP if HTTPS fails
            string relativeUrl = $"api/report/stock-report?warehousecode={code}&date={dateStr}&tenantcode={DefaultTenant}&tenant_code={DefaultTenant}";
            response = await client.GetAsync(relativeUrl);
        }

        if (response.IsSuccessStatusCode)
        {
            var contentStr = await response.Content.ReadAsStringAsync();
            contentStr = contentStr.Trim('"').Trim();

            string base64Data = contentStr;
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(contentStr);
                var root = doc.RootElement;
                if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    if (root.TryGetProperty("data", out var dProp)) base64Data = dProp.GetString() ?? contentStr;
                    else if (root.TryGetProperty("base64", out var bProp)) base64Data = bProp.GetString() ?? contentStr;
                    else if (root.TryGetProperty("file", out var fProp)) base64Data = fProp.GetString() ?? contentStr;
                }
                else if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    base64Data = root.GetString() ?? contentStr;
                }
            }
            catch { }

            return base64Data;
        }
        else
        {
            var errContent = await response.Content.ReadAsStringAsync();
            throw new Exception($"HTTP {(int)response.StatusCode} ({response.ReasonPhrase}): {errContent}");
        }
    }

    private async Task PrintStockReport()
    {
        await PreviewStockReport(null);
    }

    private async Task PrintStockReportForWarehouse(long? warehouseCode)
    {
        await PreviewStockReport(warehouseCode);
    }

    private async Task PreviewStockReport(long? warehouseCode)
    {
        try
        {
            isPrinting = true;
            StateHasChanged();

            string base64Data = await FetchStockReportBase64(warehouseCode);

            if (!string.IsNullOrWhiteSpace(base64Data) && (base64Data.StartsWith("data:application/pdf") || base64Data.Length > 100))
            {
                await JS.InvokeVoidAsync("openPdfPreviewModal", base64Data, "Stock Inventory Report");
            }
            else
            {
                ToastService.ShowError("Unable to load PDF preview: Invalid report data returned.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading stock report: {ex.Message}");
        }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

    private async Task PrintStockReportDirect(long? warehouseCode)
    {
        try
        {
            isPrintingPdf = true;
            StateHasChanged();

            string base64Data = await FetchStockReportBase64(warehouseCode);

            if (!string.IsNullOrWhiteSpace(base64Data))
            {
                await JS.InvokeVoidAsync("openBase64Pdf", base64Data);
                ToastService.ShowSuccess("Stock report sent to printer.");
            }
            else
            {
                ToastService.ShowError("Unable to print: Invalid report data returned.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error printing stock report: {ex.Message}");
        }
        finally
        {
            isPrintingPdf = false;
            StateHasChanged();
        }
    }

