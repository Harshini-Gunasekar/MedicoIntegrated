@page "/stock"
@using Booking.Models
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS
@inject Booking.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject NavigationManager NavigationManager
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState



<div class="items-page stock-page pt-0 pb-3" style="@(IsCardView ? "" : "min-height: auto !important;")">
    <div class="items-shell px-3">
        <div class="items-content">
            <div class="premium-header-card mb-3">
                <div class="header-card-left">
                    <div class="header-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                            <line x1="12" y1="22.08" x2="12" y2="12"></line>
                        </svg>
                    </div>
                    <div class="header-card-text">
                        <h2 class="header-card-heading">Stock Inventory</h2>
                        <div class="header-card-subheading">
                            <span class="status-dot"></span> Total registries : @StockList.Count
                        </div>
                    </div>
                </div>

                <div class="header-card-right">
                    <!-- Search Input -->
                    <div class="items-search-wrap">
                        <i class="bi bi-search items-search-icon"></i>
                        <input type="text" class="form-control items-search" placeholder="Search by Item, Batch or Warehouse" @oninput="OnSearchInput" />
                    </div>

                    <!-- View Toggle -->
                    <div class="view-toggle" title="Switch view">
                        <button type="button" class="@(IsCardView ? string.Empty : "active")" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                        <button type="button" class="@(IsCardView ? "active" : string.Empty)" @onclick="() => SetView(true)"><i class="bi bi-grid-3x3-gap"></i></button>
                    </div>
                </div>
            </div>

            <!-- Filters & Report Actions Row (Left Aligned Filters & Right Aligned Compact Action Buttons) -->
            <div class="d-flex justify-content-between align-items-center mb-4 gap-2 flex-wrap w-100" style="display: flex !important; justify-content: space-between !important; align-items: center !important; width: 100% !important;">
                <!-- Left Aligned Filters -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <!-- Warehouse Filter -->
                    <div class="filter-group">
                        <span class="filter-label">
                            <i class="bi bi-building"></i> Warehouse:
                        </span>
                        <select class="filter-select" @bind="selectedReportWarehouseCode">
                            <option value="0">--Select Warehouse--</option>
                            @foreach (var wh in WarehouseList)
                            {
                                <option value="@wh.warehousecode">@wh.warehousename</option>
                            }
                        </select>
                    </div>

                    <!-- Date Filter -->
                    <div class="filter-group">
                        <span class="filter-label">
                            <i class="bi bi-calendar3"></i> Date:
                        </span>
                        <input type="date" class="filter-input-date" @bind="selectedReportDate" />
                    </div>
                </div>

                <!-- Right Aligned Compact Action Buttons -->
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <button class="btn-report-preview" @onclick="() => PreviewStockReport(selectedReportWarehouseCode)" disabled="@isPrinting" title="Preview Stock Report">
                        @if (isPrinting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Loading...</span>
                        }
                        else
                        {
                            <i class="bi bi-printer me-1"></i> <span>Stock Report</span>
                        }
                    </button>

                    <button class="btn-report-download" @onclick="() => PrintStockReportDirect(selectedReportWarehouseCode)" disabled="@isPrintingPdf" title="Print Stock Report">
                        @if (isPrintingPdf)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Printing...</span>
                        }
                        else
                        {
                            <i class="bi bi-printer me-1"></i> <span>Print Report</span>
                        }
                    </button>
                </div>
            </div>

            <div class="card items-main-card">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!FilteredStocks.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-boxes fs-1 d-block mb-3"></i>
                        No stock records found.
                    </div>
                }
                else if (!IsCardView)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 items-table w-100">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">S.NO</th>
                                    <th style="width: 130px;">STOCK CODE</th>
                                    <th>ITEM NAME</th>
                                    <th>WAREHOUSE</th>
                                    <th>BATCH NO</th>
                                    <th>CLOSING STOCK</th>
                                    <th>UNIT COST</th>
                                    <th>STOCK VALUE</th>
                                    <th style="width: 140px;">STATUS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedStocks.Select((value, index) => new { value, index }))
                                {
                                    <tr>
                                        <td>@(((CurrentPage - 1) * ItemsPerPage) + row.index + 1)</td>
                                        <td class="fw-bold text-primary">#@row.value.stockcode</td>
                                        <td>@(ItemList.FirstOrDefault(i => i.itemcode == row.value.itemcode)?.itemname ?? $"Item {row.value.itemcode}")</td>
                                        <td>@(WarehouseList.FirstOrDefault(w => w.warehousecode == row.value.warehousecode)?.warehousename ?? row.value.warehousecode?.ToString() ?? "N/A")</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.value.batchno) ? "N/A" : row.value.batchno)</td>
                                        <td>@row.value.closingstock.ToString("N1")</td>
                                        <td>₹@row.value.unitcost.ToString("N2")</td>
                                        <td class="fw-bold">₹@row.value.stockvalue.ToString("N2")</td>
                                        <td>
                                            <span class="badge @(GetStockVolumeLabel(row.value) == "IN STOCK" ? "bg-success" : (GetStockVolumeLabel(row.value) == "LOW STOCK" ? "bg-warning text-dark" : "bg-danger"))">
                                                @GetStockVolumeLabel(row.value)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-card-grid">
                        @foreach (var stock in PagedStocks)
                        {
                            <div class="item-card">
                                <div class="item-card-head">
                                    <span class="card-item-code">#@stock.stockcode</span>
                                </div>
                                <div class="item-card-body">
                                    <div class="detail-row"><span>Item</span><strong>@(ItemList.FirstOrDefault(i => i.itemcode == stock.itemcode)?.itemname ?? $"Item {stock.itemcode}")</strong></div>
                                    <div class="detail-row"><span>Batch No</span><strong>@(string.IsNullOrWhiteSpace(stock.batchno) ? "N/A" : stock.batchno)</strong></div>
                                    <div class="detail-row"><span>Closing Stock</span><strong>@stock.closingstock.ToString("N1")</strong></div>
                                    <div class="detail-row"><span>Stock Value</span><strong class="text-success">₹@stock.stockvalue.ToString("N2")</strong></div>
                                    <div class="detail-row"><span>Warehouse</span><strong>@(WarehouseList.FirstOrDefault(w => w.warehousecode == stock.warehousecode)?.warehousename ?? stock.warehousecode?.ToString() ?? "N/A")</strong></div>
                                    <div class="detail-row"><span>Status</span><strong class="@GetStockVolumeBadge(stock)">@GetStockVolumeLabel(stock)</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                
                <div class="display-controls px-4 py-3 border-top" style="display: flex; justify-content: space-between; align-items: center; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <div class="total-count-text text-muted" style="font-size: 0.82rem; font-weight: 500; text-align: left; margin-left: 20px;">
                        @if (FilteredStocks.Any())
                        {
                            <span>Showing <strong>@(((CurrentPage - 1) * ItemsPerPage) + 1)</strong> to <strong>@(Math.Min(CurrentPage * ItemsPerPage, FilteredStocks.Count()))</strong> of <strong>@FilteredStocks.Count()</strong> items</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> to <strong>0</strong> of <strong>0</strong> items</span>
                        }
                    </div>
                    <div class="pagination-bar" style="display: flex; align-items: center; gap: 4px;">
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage <= 1)" title="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @if (TotalPages > 0)
                        {
                            @foreach (var pageNum in GetVisiblePageNumbers())
                            {
                                var p = pageNum;
                                <button class="page-btn @(CurrentPage == p ? "active" : "")" @onclick="() => ChangePage(p)">
                                    @p
                                </button>
                            }
                        }
                        else
                        {
                            <button class="page-btn active">1</button>
                        }
                        <button class="page-btn" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)" title="Next">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 1100px; width: 95%;">
            <div class="modal-header-bar" style="padding: 14px 32px !important;">
                <div class="modal-header-left">
                    <div>
                        <h3 class="modal-title" style="color: #1e293b !important; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.2px;">@(IsEdit ? "Edit Stock" : "Add Stock")</h3>
                    </div>
                </div>
                <button class="btn-close-modal" title="Close" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-inner">
                <EditForm Model="CurrentStock" OnValidSubmit="SaveStock" autocomplete="off">
                    <DataAnnotationsValidator />
                    <div class="modal-scroll-area" style="overflow-x: hidden; padding: 0 10px 20px 0;">
                        
                        <!-- Section 1: Item & Placements -->
                        <div class="form-section-header">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Item Details</div>
                        </div>

                        <div class="form-grid" style="display: flex; align-items: flex-start; gap: 20px;">
                            <div class="field-group" style="flex: 2;">
                                <label class="field-label">Item</label>
                                <InputSelect class="form-control premium-input" ValueExpression="() => CurrentStock.itemcode" Value="CurrentStock.itemcode" ValueChanged="@((long val) => { CurrentStock.itemcode = val; CalculateTotals(); })">
                                    <option value="0">-- Select Item --</option>
                                    @foreach (var item in ItemList)
                                    {
                                        <option value="@item.itemcode">@item.itemname</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="field-group" style="flex: 2;">
                                <label class="field-label">Store / Warehouse</label>
                                <InputSelect class="form-control premium-input" @bind-Value="CurrentStock.warehousecode">
                                    <option value="">-- Select Store --</option>
                                    @foreach (var warehouse in WarehouseList)
                                    {
                                        <option value="@((long?)warehouse.warehousecode)">@warehouse.warehousename</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="field-group" style="flex: 1;">
                                <label class="field-label" style="opacity: 0;">&nbsp;</label>
                                <div class="form-check form-switch mb-0" style="display: flex; align-items: center; height: 42px;">
                                    <InputCheckbox class="form-check-input" @bind-Value="CurrentStock.isactive" id="stockActiveSwitch" style="transform: scale(1.2); margin-right: 8px; cursor: pointer;" />
                                    <label class="form-check-label fw-bold" for="stockActiveSwitch" style="font-size: 0.85rem; color: #1e293b; cursor: pointer; white-space: nowrap;">Is Stock Active</label>
                                </div>
                            </div>
                        </div>

                        <!-- Section 2: Quantities & Costing -->
                        <div class="form-section-header mt-4">
                            <div class="form-section-title" style="font-size: 0.85rem; font-weight: 800; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.5px;">Quantities & Costing</div>
                        </div>

                        <div class="form-grid">
                            <div class="field-group col-2">
                                <label class="field-label">Opening Stock</label>
                                <input type="number" class="form-control premium-input text-end" @bind="CurrentStock.openingstock" @bind:event="oninput" @onkeyup="CalculateTotals" />
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Purchased Qty</label>
                                <input type="number" class="form-control premium-input text-end" @bind="CurrentStock.purchasedqty" @bind:event="oninput" @onkeyup="CalculateTotals" />
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Sold Quantity</label>
                                <input type="number" class="form-control premium-input text-end" @bind="CurrentStock.soldqty" @bind:event="oninput" @onkeyup="CalculateTotals" />
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Damaged Quantity</label>
                                <input type="number" class="form-control premium-input text-end" @bind="CurrentStock.damagedqty" @bind:event="oninput" @onkeyup="CalculateTotals" />
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Returned Qty</label>
                                <input type="number" class="form-control premium-input text-end" @bind="CurrentStock.returnqty" @bind:event="oninput" @onkeyup="CalculateTotals" />
                            </div>
                            <div class="field-group col-2">
                                <label class="field-label">Closing Stock (Auto)</label>
                                <input type="text" class="form-control premium-input text-end fw-bold text-success" value="@CurrentStock.closingstock.ToString("N1")" readonly style="background: #f0fdf4;" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Unit Cost (₹)</label>
                                <input type="number" step="0.01" class="form-control premium-input text-end" @bind="CurrentStock.unitcost" @bind:event="oninput" @onkeyup="CalculateTotals" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Total Stock Value (Auto)</label>
                                <input type="text" class="form-control premium-input text-end fw-bold text-primary" value="₹ @CurrentStock.stockvalue.ToString("N2")" readonly style="background: #eef2ff;" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Batch Number</label>
                                <InputText class="form-control premium-input" @bind-Value="CurrentStock.batchno" placeholder="Batch details" />
                            </div>
                            <div class="field-group col-3">
                                <label class="field-label">Expiry Date</label>
                                <InputDate class="form-control premium-input" @bind-Value="CurrentStock.expirydate" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-actions" style="display: flex; justify-content: flex-end; gap: 16px; padding: 24px 32px; border-top: 1px solid #f0f0f0;">
                        <button type="button" class="btn-cancel-modal" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn-save-premium" disabled="@IsSaving" style="min-width: 150px; height: 48px; background: #1c9f5f; color: white;">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-2" style="font-size: 1.1rem;"></i>
                            }
                            <span>@(IsEdit ? "Update Stock" : "Save Stock")</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm)
{
    <div class="action-popup-overlay" @onclick="() => ShowDeleteConfirm = false">
        <div class="action-popup-card" @onclick:stopPropagation="true">
            <div class="action-popup-header">Delete Stock Entry</div>
            <div class="action-popup-body">Are you sure you want to delete this stock entry? This action cannot be undone.</div>
            <div class="action-popup-actions">
                <button type="button" class="popup-btn popup-btn-cancel" @onclick="() => ShowDeleteConfirm = false">Cancel</button>
                <button type="button" class="popup-btn popup-btn-delete" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<stock_master> StockList = new();
    private List<inventory_item_master> ItemList = new();
    private List<warehouse_master> WarehouseList = new();
    private stock_master CurrentStock = new();
    
    private string SearchQuery = "";
    private bool IsLoading = true;
    private bool IsSaving = false;
    private bool ShowModal = false;
    private bool IsEdit = false;
    private bool IsCardView = false;
    private bool ShowDeleteConfirm = false;
    private stock_master? PendingDelete;
    
    private string DefaultTenant = "";
    private int CurrentPage = 1;
    private int ItemsPerPage => IsCardView ? 6 : 12;

    private IEnumerable<stock_master> FilteredStocks
    {
        get
        {
            var query = StockList.AsEnumerable();

            if (selectedReportWarehouseCode > 0)
            {
                query = query.Where(s => s.warehousecode == selectedReportWarehouseCode);
            }

            if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                query = query.Where(s => 
                    (s.batchno?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (WarehouseList.FirstOrDefault(w => w.warehousecode == s.warehousecode)?.warehousename?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (s.stockcode.ToString().Contains(SearchQuery)) ||
                    (ItemList.FirstOrDefault(i => i.itemcode == s.itemcode)?.itemname?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return query;
        }
    }

    private void OnFilterChanged()
    {
        CurrentPage = 1;
    }

    private IEnumerable<stock_master> PagedStocks => 
        FilteredStocks.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage);

    private int TotalPages => (int)Math.Ceiling((double)FilteredStocks.Count() / ItemsPerPage);

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= Math.Max(1, TotalPages))
        {
            CurrentPage = page;
            StateHasChanged();
        }
    }

    private IEnumerable<int> GetVisiblePageNumbers()
    {
        int total = TotalPages;
        int current = CurrentPage;

        if (total <= 3)
        {
            return Enumerable.Range(1, Math.Max(1, total));
        }

        int start = current - 1;
        if (current <= 1)
        {
            start = 1;
        }
        else if (current >= total)
        {
            start = total - 2;
        }

        start = Math.Max(1, Math.Min(start, total - 2));
        return Enumerable.Range(start, 3);
    }

    private bool hasViewRight = true;
    private bool hasCreateRight = true;
    private bool hasEditRight = true;
    private bool hasDeleteRight = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
            DefaultTenant = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
            
            try
            {
                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                if (!tokenResult.Success || string.IsNullOrEmpty(tokenResult.Value))
                {
                    tokenResult = await _sessionStorage.GetAsync<string>("auth_token");
                }
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : (TenantState?.AuthToken ?? "");
            }
            catch {}
            
            try
            {
                bool isAdmin = false;
                try
                {
                    var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userResult.Success && userResult.Value != null)
                    {
                        isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                                  userResult.Value.UserCode == 0 ||
                                  userResult.Value.UserCode == 1;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking user details: {ex.Message}");
                }

                if (isAdmin)
                {
                    hasViewRight = true;
                    hasCreateRight = true;
                    hasEditRight = true;
                    hasDeleteRight = true;
                }
                else
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null)
                    {
                        var pageRight = rightsResult.Value.FirstOrDefault(r => 
                            r.ModuleName != null && 
                            r.ModuleName.Trim().Equals("Stock_Stock", StringComparison.OrdinalIgnoreCase));
                        
                        if (pageRight != null)
                        {
                            hasViewRight = pageRight.ToView;
                            hasCreateRight = pageRight.ToAdd;
                            hasEditRight = pageRight.ToEdit;
                            hasDeleteRight = pageRight.ToDelete;
                        }
                        else
                        {
                            hasViewRight = false;
                            hasCreateRight = false;
                            hasEditRight = false;
                            hasDeleteRight = false;
                        }
                    }
                    else
                    {
                        hasViewRight = false;
                        hasCreateRight = false;
                        hasEditRight = false;
                        hasDeleteRight = false;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking Stock_Stock rights: {ex.Message}");
                hasViewRight = false;
                hasCreateRight = false;
                hasEditRight = false;
                hasDeleteRight = false;
            }

            if (!hasViewRight)
            {
                ToastService.ShowError("You do not have permission to access Stock.");
                NavigationManager.NavigateTo("/home");
                return;
            }

            await Task.WhenAll(LoadStocks(), LoadItems(), LoadWarehouses());
            StateHasChanged();
        }
    }

    private string AuthToken = "";

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Remove("tenant-code");
        if (!string.IsNullOrEmpty(DefaultTenant))
        {
            client.DefaultRequestHeaders.Add("tenantcode", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant_code", DefaultTenant);
            client.DefaultRequestHeaders.Add("tenant-code", DefaultTenant);
        }
        var effectiveToken = !string.IsNullOrEmpty(AuthToken) ? AuthToken : TenantState?.AuthToken;
        if (!string.IsNullOrEmpty(effectiveToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
        }
        return client;
    }

    private async Task LoadStocks()
    {
        IsLoading = true;
        try 
        {
            var client = CreateClient();
            var response = await client.GetStringAsync("api/ItemMaster/getallstocks");
            
            if (!string.IsNullOrWhiteSpace(response)) 
            {
                var directList = ParseStocksList(response);
                StockList = directList ?? new();
            }
        } 
        catch (Exception ex) 
        {
            ToastService.ShowError($"Load Error: {ex.Message}");
        } 
        finally 
        {
            IsLoading = false;
        }
    }

    private List<stock_master>? ParseStocksList(string json)
    {
        var options = new JsonSerializerOptions 
        { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try 
        {
            var direct = JsonSerializer.Deserialize<List<stock_master>>(json, options);
            if (direct != null && direct.Any()) return direct.Where(x => !x.deleted).ToList();
        } 
        catch { }

        try 
        {
            var wrapped = JsonSerializer.Deserialize<ServiceResponse<List<stock_master>>>(json, options);
            if (wrapped?.data != null) return wrapped.data.Where(x => !x.deleted).ToList();
        } 
        catch { }

        return null;
    }

