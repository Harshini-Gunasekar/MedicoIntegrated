    private async Task EditStock(stock_master master)
    {
        if (!hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit stock.");
            return;
        }
        IsEdit = true;
        IsLoading = true;
        try 
        {
            var client = CreateClient();
            var url = $"api/ItemMaster/getstockbycode?stockcode={master.stockcode}";
            var responseString = await client.GetStringAsync(url);
            
            var loaded = ParseStockResponse(responseString);
            if (loaded != null) 
            {
                CurrentStock = loaded;
                CurrentStock.tenantcode = DefaultTenant;
            }
            else 
            {
                CurrentStock = master;
                ToastService.ShowWarning("Detailed stock record not found. Showing baseline fields.");
            }
            ShowModal = true;
        } 
        catch (Exception ex) 
        {
            ToastService.ShowError($"Edit Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private stock_master? ParseStockResponse(string json)
    {
        var options = new JsonSerializerOptions 
        { 
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try 
        {
            var direct = JsonSerializer.Deserialize<stock_master>(json, options);
            if (direct != null && direct.stockcode > 0) return direct;
        } 
        catch { }

        try 
        {
            var wrapped = JsonSerializer.Deserialize<ServiceResponse<stock_master>>(json, options);
            if (wrapped?.data != null && wrapped.data.stockcode > 0) return wrapped.data;
        } 
        catch { }

        return null;
    }

    private void CalculateTotals()
    {
        CurrentStock.closingstock = CurrentStock.openingstock + CurrentStock.purchasedqty - CurrentStock.soldqty - CurrentStock.damagedqty + CurrentStock.returnqty;
        CurrentStock.stockvalue = CurrentStock.closingstock * CurrentStock.unitcost;
    }

    private async Task SaveStock()
    {
        if (IsEdit && !hasEditRight)
        {
            ToastService.ShowError("You do not have permission to edit stock.");
            return;
        }
        if (!IsEdit && !hasCreateRight)
        {
            ToastService.ShowError("You do not have permission to add stock.");
            return;
        }
        if (CurrentStock.itemcode <= 0)
        {
            ToastService.ShowWarning("Please select an item");
            return;
        }

        CalculateTotals();
        IsSaving = true;
        try 
        {
            var client = CreateClient();
            
            CurrentStock.tenantcode = DefaultTenant;
            CurrentStock.branchcode ??= "BLR001";
            CurrentStock.companycode ??= "CMP001";
            CurrentStock.isactive = true;
            CurrentStock.deleted = false;

            var url = IsEdit ? "api/ItemMaster/updatestock" : "api/ItemMaster/insertstock";
            
            var options = new JsonSerializerOptions 
            {
                PropertyNamingPolicy = null 
            };
            
            var response = await client.PostAsJsonAsync(url, CurrentStock, options);

            if (response.IsSuccessStatusCode) 
            {
                ToastService.ShowSuccess(IsEdit ? "Stock registry updated successfully" : "Stock entry registered successfully");
                ShowModal = false;
                await LoadStocks();
            } 
            else 
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Save Failed: {errorBody}");
            }
        } 
        catch (Exception ex) 
        {
            ToastService.ShowError($"Save Error: {ex.Message}");
        } 
        finally 
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(stock_master master)
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete stock.");
            return;
        }
        PendingDelete = master;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteConfirmed()
    {
        if (!hasDeleteRight)
        {
            ToastService.ShowError("You do not have permission to delete stock.");
            return;
        }
        if (PendingDelete == null) return;
        IsLoading = true;
        try 
        {
            var client = CreateClient();
            var url = $"api/ItemMaster/deletestock?stockcode={PendingDelete.stockcode}";
            var response = await client.GetAsync(url);
            
            if (!response.IsSuccessStatusCode)
            {
                response = await client.DeleteAsync(url);
            }
            
            if (response.IsSuccessStatusCode) 
            {
                ToastService.ShowSuccess("Stock entry deleted successfully");
                await LoadStocks();
            } 
            else 
            {
                var softDeleteSuccess = await SoftDeleteViaUpdate(PendingDelete);
                if (softDeleteSuccess)
                {
                    ToastService.ShowSuccess("Stock entry soft-deleted");
                    await LoadStocks();
                }
                else
                {
                    ToastService.ShowError("Delete failed. Verify API endpoint status.");
                }
            }
        } 
        catch (Exception ex) 
        {
            ToastService.ShowError($"Delete Error: {ex.Message}");
        } 
        finally 
        {
            ShowDeleteConfirm = false;
            PendingDelete = null;
            IsLoading = false;
        }
    }

    private async Task<bool> SoftDeleteViaUpdate(stock_master entry)
    {
        try
        {
            var client = CreateClient();
            var detailUrl = $"api/ItemMaster/getstockbycode?stockcode={entry.stockcode}";
            var detailsResponse = await client.GetStringAsync(detailUrl);
            var req = ParseStockResponse(detailsResponse);
            
            if (req != null)
            {
                req.deleted = true;
                req.isactive = false;
                req.tenantcode = DefaultTenant;
                
                var updateResponse = await client.PostAsJsonAsync("api/ItemMaster/updatestock", req);
                return updateResponse.IsSuccessStatusCode;
            }
        }
        catch {}
        return false;
    }

