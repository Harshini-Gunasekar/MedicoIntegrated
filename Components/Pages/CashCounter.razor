@page "/cash-counter"
@rendermode InteractiveServer
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.CounterMasterService CounterMasterService
@inject Booking.Services.PaymodeMasterService PaymodeMasterService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Booking.Services.ToastService ToastService
@inject Booking.Services.HmsDueCollectionService DueCollectionService
@inject Booking.Services.AppointmentBookingService AppointmentBookingService
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.IpRegistrationService IpService
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.RoleMasterService RoleService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage _sessionStorage
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject HttpClient Http
@implements IDisposable
@using Booking.Models
@using Newtonsoft.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using Booking.Helpers
@using Medico_Backend.Model
@using medico_backend.Model

<div class="cash-counter-wrapper">
    @if (!hasViewRight)
    {
        <!-- Access Denied Header Card -->
        <div class="page-header">
            <div class="header-left-group">
                <div class="header-icon-container" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; width: 42px; height: 42px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                    <i class="bi bi-shield-x"></i>
                </div>
                <div class="header-title-container">
                    <h1 class="header-title">Cash Counter Portal</h1>
                    <p style="margin: 0; font-size: 0.75rem; color: #ef4444; font-weight: 600;"><span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #ef4444; margin-right: 4px;"></span> ACCESS RESTRICTED</p>
                </div>
            </div>
        </div>

        <div class="alert alert-danger d-flex align-items-center mt-3 p-4 shadow-sm" style="border-radius: 8px;">
            <i class="bi bi-shield-lock-fill me-3 fs-1 text-danger"></i>
            <div>
                <h5 class="alert-heading mb-1 font-bold">Permission Denied</h5>
                <p class="mb-0 text-muted">You do not have permission to view Cash Counter Portal. Please contact your system administrator to assign Role 507 (Billing Portal &gt; Cash Counter &gt; View).</p>
            </div>
        </div>
    }
    else
    {
    <!-- Header (Matching Patient Advance Reference) -->
    <div class="page-header @(isPayModeSelected ? "header-scrollable" : "")">
        <div class="header-left-group">
            <div class="header-title-container">
                <h1 class="header-title">Cash Counter Portal</h1>
            </div>

            <!-- Mode Toggle Pills (Hospital, Pharmacy and Paymode buttons) -->
            <div class="counter-mode-pills">
                <button type="button" class="mode-pill @(billingSource == "HOSPITAL" ? "active" : "")" @onclick='() => SetBillingSourceAsync("HOSPITAL")' title="Hospital Bills">
                    <i class="bi bi-hospital"></i>
                    <span>Hospital</span>
                    <span class="badge-count">@(billsList?.total ?? 0)</span>
                </button>
                <button type="button" class="mode-pill @(billingSource == "PHARMACY" ? "active" : "")" @onclick='() => SetBillingSourceAsync("PHARMACY")' title="Pharmacy Bills">
                    <i class="bi bi-capsule"></i>
                    <span>Pharmacy</span>
                    <span class="badge-count">@FilteredPharmacySales.Count</span>
                </button>
                <button type="button" class="mode-pill @(billingSource == "ADVANCE" ? "active" : "")" @onclick='() => SetBillingSourceAsync("ADVANCE")' title="Patient Advance, Requests Queue & Refund">
                    <i class="bi bi-wallet2"></i>
                    <span>Patient Advance</span>
                    @if (advanceRequestsSummary.pending_count > 0)
                    {
                        <span class="badge-count" style="background: #ef4444; color: white;">@advanceRequestsSummary.pending_count</span>
                    }
                    else if (advanceDepositsList.Count > 0)
                    {
                        <span class="badge-count">@advanceDepositsList.Count</span>
                    }
                </button>
            </div>
        </div>

        <!-- Top Header Summary Cards (When advance is selected, display advance KPIs; otherwise keep existing cards) -->
        <div class="header-summary-cards">
            @if (billingSource == "ADVANCE")
            {
                <div class="summary-card bill-card" title="Total Patient Advance Deposited">
                    <div class="summary-icon" style="background: rgba(14, 165, 233, 0.15); color: #0284c7;">
                        <i class="bi bi-box-arrow-in-down"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-label">TOTAL DEPOSITED</div>
                        <div class="summary-value">&#8377;@advanceDepositsSummary.total_deposited_sum.ToString("N2")</div>
                    </div>
                </div>
                <div class="summary-card due-card" title="Total Advance Utilized in Bills">
                    <div class="summary-icon" style="background: rgba(99, 102, 241, 0.15); color: #4f46e5;">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-label">TOTAL UTILIZED</div>
                        <div class="summary-value">&#8377;@advanceDepositsSummary.total_used_sum.ToString("N2")</div>
                    </div>
                </div>
                <div class="summary-card pharmacy-card" title="Total Advance Refunded">
                    <div class="summary-icon" style="background: rgba(245, 158, 11, 0.15); color: #d97706;">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-label">TOTAL REFUNDED</div>
                        <div class="summary-value">&#8377;@advanceDepositsSummary.total_refunded_sum.ToString("N2")</div>
                    </div>
                </div>
                <div class="summary-card net-card" title="Net Available Patient Advance Balance">
                    <div class="summary-icon" style="background: rgba(16, 185, 129, 0.15); color: #059669;">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-label">AVAILABLE BALANCE</div>
                        <div class="summary-value" style="color: #059669;">&#8377;@advanceDepositsSummary.total_available_sum.ToString("N2")</div>
                    </div>
                </div>
            }
            else if (isPayModeSelected)
            {
                @if (isLoadingPaymode)
                {
                    <div class="summary-card bill-card">
                        <div class="summary-icon">
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                        </div>
                        <div class="summary-content">
                            <div class="summary-label">PAYMODE</div>
                            <div class="summary-value" style="font-size: 0.85rem;">Loading...</div>
                        </div>
                    </div>
                }
                else
                {
                    var paymodeCards = GetPaymodeDisplayCards();
                    foreach (var card in paymodeCards)
                    {
                        <div class="summary-card @card.CardClass" title="@card.Tooltip">
                            <div class="summary-icon">
                                <i class="@card.IconClass"></i>
                            </div>
                            <div class="summary-content">
                                <div class="summary-label">@card.Label</div>
                                <div class="summary-value">&#8377;@card.Amount.ToString("N2")</div>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <div class="summary-card bill-card" title="Total Amount Paid in Hospital Bills for Selected Date">
                    <div class="summary-icon">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-label">HOSPITAL BILLS</div>
                        <div class="summary-value">&#8377;@TotalHospitalPaid.ToString("N2")</div>
                    </div>
                </div>
                <div class="summary-card due-card" title="Total Due Amount Collected in Due Collection for Selected Date">
                    <div class="summary-icon">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-label">DUE AMOUNT COLL</div>
                        <div class="summary-value">&#8377;@TotalDueAmount.ToString("N2")</div>
                    </div>
                </div>
                <div class="summary-card pharmacy-card" title="Total Amount Paid in Pharmacy Bills for Selected Date">
                    <div class="summary-icon">
                        <i class="bi bi-capsule"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-label">PHARMACY BILLS</div>
                        <div class="summary-value">&#8377;@TotalPharmacyPaid.ToString("N2")</div>
                    </div>
                </div>
                <div class="summary-card net-card" title="Total Net Amount = Hospital Bills + Due Amount Coll + Pharmacy Bills">
                    <div class="summary-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-label">TOTAL NET AMOUNT</div>
                        <div class="summary-value">&#8377;@TotalNet.ToString("N2")</div>
                    </div>
                </div>
            }
        </div>
    </div>



    @if (billingSource != "ADVANCE")
    {
    <!-- Filters Section -->
    <div class="filter-card">
        <div class="filter-grid">
            <div class="filter-item">
                <label>BRANCH</label>
                <select class="form-select" value="@(filter.bhcode?.ToString() ?? "")" @onchange="OnBranchFilterChanged">
                    <option value="">All Branches</option>
                    @foreach (var b in branches)
                    {
                        <option value="@b.bh_code">@b.name</option>
                    }
                </select>
            </div>

            <div class="filter-item">
                <label>COUNTER</label>
                <select class="form-select" value="@(filter.cntcode?.ToString() ?? "")" @onchange="OnCounterFilterChanged">
                    @foreach (var c in GetFilteredCounters())
                    {
                        <option value="@((int)c.cntcode)">@c.name</option>
                    }
                </select>
            </div>

            <div class="filter-item">
                <label>FROM DATE</label>
                <input type="date" class="form-control" @bind="filter.fromdate" />
            </div>

            <div class="filter-item">
                <label>TO DATE</label>
                <input type="date" class="form-control" @bind="filter.todate" />
            </div>

            <div class="filter-item">
                <label>PAYMENT STATUS</label>
                <select class="form-select" @bind="statusFilter">
                    <option value="ALL">All Bills</option>
                    <option value="PENDING">Pending Only</option>
                    <option value="SETTLED">Settled Only</option>
                </select>
            </div>

            <div class="filter-item search-item">
                <label>PATIENT SEARCH</label>
                <div class="search-input-wrapper">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" class="form-control" @bind="filter.search" placeholder="Name, ID or Mobile..." @onkeyup="HandleSearchKeyUp" />
                </div>
            </div>
            <div class="filter-item action-item">
                <div class="filter-actions-inline">
                    <button class="btn-primary" @onclick="LoadBillsAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Searching...</span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                            <span>Search</span>
                        }
                    </button>
                    <button class="btn-secondary" @onclick="ResetFiltersAsync" disabled="@isLoading">
                        <i class="bi bi-arrow-clockwise"></i>
                        <span>Reset</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bills Table Card -->
    <div class="table-card">
        <div class="table-header">
            <h2 class="table-title">@(billingSource == "PHARMACY" ? "Pharmacy Bills List" : "Bills List")</h2>
            <div class="table-actions">
                <span class="record-count">Total: @TotalActiveCount bills</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">S.NO</th>
                        <th>BILL NO</th>
                        <th>DATE</th>
                        <th>PATIENT NAME</th>
                        <th>UHID</th>
                        @if (billingSource != "PHARMACY")
                        {
                            <th>Reference No.</th>
                        }
                        <th>@(billingSource == "PHARMACY" ? "LOCATION" : "MOBILE")</th>
                        <th>REF. DOCTOR</th>
                        <th class="text-end">GROSS</th>
                        <th class="text-end">DISC</th>
                        <th class="text-end">NET</th>
                        <th class="text-end">PAID</th>
                        <th class="text-end">BALANCE</th>
                        <th class="text-center" style="width: 100px;">STATUS</th>
                        <th class="text-center" style="width: 130px;">ACTION</th>
                        <th class="text-center" style="width: 60px;">PRINT</th>
                        <th class="text-center" style="width: 60px;">DETAILS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="@(billingSource == "PHARMACY" ? 16 : 17)" class="text-center py-5">
                                <div class="spinner-container">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <p class="mt-2">Loading bills list...</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (billingSource == "PHARMACY")
                    {
                        @if (!PagedPharmacySales.Any())
                        {
                            <tr>
                                <td colspan="16" class="text-center py-5 text-muted">
                                    <i class="bi bi-capsule" style="font-size: 2.5rem; color: #94a3b8; display: block; margin-bottom: 0.5rem;"></i>
                                    No pharmacy bills found matching the selected criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int sno = (pharmacyPage - 1) * filter.pagesize + 1;
                            @foreach (var s in PagedPharmacySales)
                            {
                                var isSettled = string.Equals(s.paymentstatus, "Paid", StringComparison.OrdinalIgnoreCase) || string.Equals(s.paymentstatus, "Settled", StringComparison.OrdinalIgnoreCase);
                                var balance = isSettled ? 0 : s.netamount;
                                var paid = isSettled ? s.netamount : 0;
                                var pharmacyBillNoKey = string.IsNullOrWhiteSpace(s.billno) ? s.salescode.ToString() : s.billno;
                                <tr>
                                    <td>@(sno++)</td>
                                    <td class="bill-no">@(string.IsNullOrWhiteSpace(s.billno) ? $"#SALES-{s.salescode}" : s.billno)</td>
                                    <td>@(s.billdate != default ? s.billdate.ToString("dd-MMM-yyyy") : "-")</td>
                                    <td class="patient-name">@(string.IsNullOrWhiteSpace(s.patientname) ? (!string.IsNullOrWhiteSpace(s.patientid) ? s.patientid : "Counter Patient") : s.patientname)</td>
                                    <td><span class="badge bg-light text-dark border">@GetDisplayPharmacyUhid(s)</span></td>
                                    <td class="patient-phone">@(string.IsNullOrWhiteSpace(s.address) ? "-" : s.address)</td>
                                    <td>@GetDoctorName(null, s.consultant, null, (decimal?)s.customercode, s.billdate)</td>
                                    <td class="text-end font-numeric">@s.grossamount.ToString("0.00")</td>
                                    <td class="text-end font-numeric">@s.discountamount.ToString("0.00")</td>
                                    <td class="text-end font-numeric font-bold">@s.netamount.ToString("0.00")</td>
                                    <td class="text-end font-numeric text-success">@paid.ToString("0.00")</td>
                                    <td class="text-end font-numeric text-danger font-bold">@balance.ToString("0.00")</td>
                                    <td class="text-center">
                                        <span class="status-badge @(isSettled ? "settled" : "pending")">
                                            @(isSettled ? "Settled" : "Pending")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (!isSettled)
                                        {
                                            @if (!hasCreateRight)
                                            {
                                                <button type="button" class="cash-pay-btn btn-frozen" disabled title="Permission denied: Role 508 (Billing Portal > Cash Counter > Create) is required to receive payments.">
                                                    <i class="bi bi-shield-lock-fill"></i>
                                                    <span>Receive</span>
                                                </button>
                                            }
                                            else
                                            {
                                                var isToday = IsTodayPharmacyBill(s);
                                                @if (isToday)
                                                {
                                                    <button type="button" class="cash-pay-btn" @onclick="() => OpenPharmacyPaymentModal(s)" title="Receive Payment">
                                                        <i class="bi bi-wallet2"></i>
                                                        <span>Receive</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="cash-pay-btn btn-frozen" disabled title="Receive payment is frozen for previous date bills. Money can only be received on today's bills.">
                                                        <i class="bi bi-lock-fill"></i>
                                                        <span>Receive</span>
                                                    </button>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-success-bold" style="font-size: 0.75rem;"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn-table-print" @onclick="() => PrintPharmacyBillAsync(s)" disabled="@(printingBillKey == pharmacyBillNoKey)" title="Preview & Print Pharmacy Bill">
                                            @if (printingBillKey == pharmacyBillNoKey)
                                            {
                                                <span class="spinner-border spinner-border-sm text-primary" role="status" style="width: 12px; height: 12px; border-width: 2px;"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-printer-fill text-primary"></i>
                                            }
                                        </button>
                                    </td>
                                     <td class="text-center">
                                         <button type="button" class="btn-dots-action" @onclick="() => OpenPharmacyBillDetailsCardAsync(s)" title="View Details">
                                             <i class="bi bi-three-dots-vertical"></i>
                                         </button>
                                     </td>
                                </tr>
                            }
                        }
                    }
                    else
                    {
                        @if (billsList == null || !billsList.data.Any())
                        {
                            <tr>
                                <td colspan="17" class="text-center py-5 text-muted">
                                    <i class="bi bi-receipt-cutoff" style="font-size: 2.5rem; color: #94a3b8; display: block; margin-bottom: 0.5rem;"></i>
                                    No bills found matching the selected criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int sno = (filter.page - 1) * filter.pagesize + 1;
                            @foreach (var bill in billsList.data)
                            {
                                var balance = bill.balance_amount ?? 0;
                                var isSettled = bill.is_settled || balance <= 0;
                                <tr>
                                    <td>@(sno++)</td>
                                    <td class="bill-no">@bill.bill_no</td>
                                    <td>@(DateTimeHelper.ConvertUtcToIst(bill.bill_date)?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</td>
                                    <td class="patient-name">@bill.patient_name</td>
                                    <td><span class="badge bg-light text-dark border">@GetDisplayBillUhid(bill)</span></td>
                                    <td class="patient-id-no">@GetPatientIdentifyingNumber(bill)</td>
                                    <td class="patient-phone">@bill.mobileno</td>
                                    <td>@GetDoctorName(bill.dcode, bill.doctor_name, bill.opvisitid, bill.custid, bill.bill_date)</td>
                                    <td class="text-end font-numeric">@(bill.gross_amount?.ToString("0.00") ?? "0.00")</td>
                                    <td class="text-end font-numeric">@(bill.discount_amount?.ToString("0.00") ?? "0.00")</td>
                                    <td class="text-end font-numeric font-bold">@(bill.net_amount?.ToString("0.00") ?? "0.00")</td>
                                    <td class="text-end font-numeric text-success">@(bill.paid_amount?.ToString("0.00") ?? "0.00")</td>
                                    <td class="text-end font-numeric text-danger font-bold">@(balance.ToString("0.00"))</td>
                                    <td class="text-center">
                                        <span class="status-badge @(isSettled ? "settled" : "pending")">
                                            @(isSettled ? "Settled" : "Pending")
                                        </span>
                                    </td>
                                     <td class="text-center">
                                        @if (!isSettled)
                                        {
                                            @if (!hasCreateRight)
                                            {
                                                <button type="button" class="cash-pay-btn btn-frozen" disabled title="Permission denied: Role 508 (Billing Portal > Cash Counter > Create) is required to receive payments.">
                                                    <i class="bi bi-shield-lock-fill"></i>
                                                    <span>Receive</span>
                                                </button>
                                            }
                                            else
                                            {
                                                var isToday = IsTodayBill(bill.bill_date);
                                                @if (isToday)
                                                {
                                                    <button type="button" class="cash-pay-btn" @onclick="() => OpenPaymentModal(bill)" title="Receive Payment">
                                                        <i class="bi bi-wallet2"></i>
                                                        <span>Receive</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="cash-pay-btn btn-frozen" disabled title="Receive payment is frozen for previous date bills. Money can only be received on today's bills.">
                                                        <i class="bi bi-lock-fill"></i>
                                                        <span>Receive</span>
                                                    </button>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-success-bold" style="font-size: 0.75rem;"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                        }
                                     </td>
                                     <td class="text-center">
                                         <button type="button" class="btn-table-print" @onclick="() => PrintHospitalBillAsync(bill.requestguid, bill.bill_no)" disabled="@(printingBillKey == bill.requestguid)" title="Preview & Print Bill Receipt">
                                             @if (printingBillKey == bill.requestguid)
                                             {
                                                 <span class="spinner-border spinner-border-sm text-primary" role="status" style="width: 12px; height: 12px; border-width: 2px;"></span>
                                             }
                                             else
                                             {
                                                 <i class="bi bi-printer-fill text-primary"></i>
                                             }
                                         </button>
                                     </td>
                                     <td class="text-center">
                                         <button type="button" class="btn-dots-action" @onclick="() => OpenBillDetailsCardAsync(bill)" title="View Details">
                                             <i class="bi bi-three-dots-vertical"></i>
                                         </button>
                                     </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Executive Pagination Bar -->
        <div class="executive-pagination-bar">
            <div class="pagination-text">
                @if (TotalActiveCount > 0)
                {
                    int startRecord = ((CurrentActivePage - 1) * filter.pagesize) + 1;
                    int endRecord = Math.Min(CurrentActivePage * filter.pagesize, TotalActiveCount);
                    <span>Showing <strong>@startRecord</strong> to <strong>@endRecord</strong> of <strong>@TotalActiveCount</strong> bills</span>
                }
                else
                {
                    <span>No bills to display</span>
                }
            </div>

            <div class="pagination-right">
                <div class="rows-per-page">
                    <span>Rows per page:</span>
                    <select class="page-size-select" value="@filter.pagesize" @onchange="ChangePageSizeAsync">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>

                @if (TotalActivePages > 1)
                {
                    <div class="pagination-buttons">
                        <button type="button" class="page-num-btn" @onclick="() => GoToPageAsync(1)" disabled="@(CurrentActivePage <= 1)" title="First Page">
                            <i class="bi bi-chevron-double-left"></i>
                        </button>
                        <button type="button" class="page-num-btn" @onclick="PrevPageAsync" disabled="@(CurrentActivePage <= 1)" title="Previous Page">
                            <i class="bi bi-chevron-left"></i>
                        </button>

                        @for (int i = Math.Max(1, CurrentActivePage - 2); i <= Math.Min(TotalActivePages, CurrentActivePage + 2); i++)
                        {
                            int p = i;
                            <button type="button" class="page-num-btn @(p == CurrentActivePage ? "active" : "")" @onclick="() => GoToPageAsync(p)">
                                @p
                            </button>
                        }

                        <button type="button" class="page-num-btn" @onclick="NextPageAsync" disabled="@(CurrentActivePage >= TotalActivePages)" title="Next Page">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                        <button type="button" class="page-num-btn" @onclick="() => GoToPageAsync(TotalActivePages)" disabled="@(CurrentActivePage >= TotalActivePages)" title="Last Page">
                            <i class="bi bi-chevron-double-right"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
