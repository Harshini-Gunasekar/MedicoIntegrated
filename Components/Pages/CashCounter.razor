                                            <td class="text-center">
                                                <div class="d-flex gap-2 justify-content-center align-items-center">
                                                    <button type="button" class="btn-advance-ledger" @onclick="() => OpenPatientLedger(p.custid, p.patient_name, p.custcode)" title="View comprehensive ledger drawer">
                                                        <i class="bi bi-journal-text"></i> Ledger
                                                    </button>
