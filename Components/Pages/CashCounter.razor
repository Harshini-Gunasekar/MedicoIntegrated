    private void ClosePaymentModal()
    {
        showPaymentModal = false;
        selectedBill = null;
    }

    private async Task SubmitPaymentAsync()
    {
        if (selectedBill == null) return;
        paymentSaving = true;
        StateHasChanged();

        try
        {
            var success = await HmsBillingService.AddPaymentAsync(paymentRequest);
            if (success)
            {
                ToastService.ShowSuccess("Payment received successfully!");
                ClosePaymentModal();
                await LoadBillsAsync();
            }
            else
            {
                ToastService.ShowError("Payment submission failed.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error processing payment: {ex.Message}");
        }
        finally
        {
            paymentSaving = false;
            StateHasChanged();
        }
    }

    // Data Load Helpers
    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }

            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                branches = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branches = branches.Where(b => !b.deleted).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }

    private async Task LoadCountersAsync()
    {
        counters = await CounterMasterService.GetCountersAsync();
    }

    private async Task LoadPaymodesAsync()
    {
        paymodes = await PaymodeMasterService.GetPaymodeMastersAsync();
        // Fallback: If paymodes is empty, default values
        if (paymodes == null || !paymodes.Any())
        {
            paymodes = new List<PaymodeMasterModel>
            {
                new() { shortname = "CASH", name = "Cash" },
                new() { shortname = "CARD", name = "Card" },
                new() { shortname = "UPI", name = "UPI / GPay" }
            };
        }
    }
