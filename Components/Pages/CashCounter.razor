            (!string.IsNullOrWhiteSpace(p.mobile) && p.mobile.Contains(q))
        ).Take(10).ToList();

        if (!results.Any())
        {
            var opMatch = (cachedOpRegistrations ?? new List<OPRegistrationModel.OpRegistrationModel>())
                .Where(b => (!string.IsNullOrEmpty(b.patient_name) && b.patient_name.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                            (!string.IsNullOrEmpty(b.custcode) && b.custcode.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                            (!string.IsNullOrEmpty(b.mobile) && b.mobile.Contains(q)) ||
                            b.custid.ToString().Contains(q))
                .GroupBy(b => b.custid)
                .Select(g => g.First())
                .Take(10)
                .Select(b => new HmsAdvancePatientItem
                {
                    custid = b.custid,
                    custcode = b.custcode ?? "",
                    patient_name = b.patient_name ?? "",
                    mobile = b.mobile ?? ""
                })
                .ToList();

            results = opMatch;
