    private async Task SubmitPaymentAsync()
    {
        if (!hasCreateRight)
        {
            ToastService.ShowError("Permission denied: Role 508 (Billing Portal > Cash Counter > Create) is required to receive payments.");
            return;
        }

        if (selectedBill == null) return;
        bool isTodayBillAllowed = selectedPharmacySale != null
            ? IsTodayPharmacyBill(selectedPharmacySale)
            : IsTodayBill(selectedBill.bill_date);

        if (!isTodayBillAllowed)
        {
            ToastService.ShowWarning("Payment can only be received for today's bills. Previous date bills are frozen.");
            return;
        }
        if (paymentRequest.pmc1 == null && paymentRequest.pmc2 == null && paymentRequest.pmc3 == null)
        {
            ToastService.ShowError("Please select a payment mode.");
            return;
        }

        paymentSaving = true;
        StateHasChanged();

        double? origPmc1 = paymentRequest.pmc1_amount;
        double? origPmc2 = paymentRequest.pmc2_amount;
        double? origPmc3 = paymentRequest.pmc3_amount;
        double origAmount = paymentRequest.amount;

        var dueAmt = selectedBill.balance_amount ?? 0;

        if (paymentRequest.amount > dueAmt)
        {
            double targetPaid = dueAmt;
            double remaining = targetPaid;

            if (paymentRequest.pmc1_amount.HasValue && paymentRequest.pmc1_amount.Value > 0)
            {
                double val = Math.Min(paymentRequest.pmc1_amount.Value, remaining);
                paymentRequest.pmc1_amount = val;
                remaining -= val;
            }
            if (paymentRequest.pmc2_amount.HasValue && paymentRequest.pmc2_amount.Value > 0)
            {
                double val = Math.Min(paymentRequest.pmc2_amount.Value, remaining);
                paymentRequest.pmc2_amount = val;
                remaining -= val;
            }
            if (paymentRequest.pmc3_amount.HasValue && paymentRequest.pmc3_amount.Value > 0)
            {
                double val = Math.Min(paymentRequest.pmc3_amount.Value, remaining);
                paymentRequest.pmc3_amount = val;
                remaining -= val;
            }

            paymentRequest.amount = dueAmt;
        }

        try
        {
            // Detect if Advance paymode was used
            double advanceUsed = 0;
            var advancePaymodeCodes = paymodes
                .Where(p => string.Equals(p.name, "ADVANCE", StringComparison.OrdinalIgnoreCase) || 
                            string.Equals(p.shortname, "ADVANCE", StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(p.shortname, "ADV", StringComparison.OrdinalIgnoreCase))
                .Select(p => p.pmcode)
                .ToList();
            
            if (!advancePaymodeCodes.Contains(99)) advancePaymodeCodes.Add(99);

            if (paymentRequest.pmc1.HasValue && advancePaymodeCodes.Contains(paymentRequest.pmc1.Value) && (paymentRequest.pmc1_amount ?? 0) > 0)
                advanceUsed += paymentRequest.pmc1_amount.Value;
            if (paymentRequest.pmc2.HasValue && advancePaymodeCodes.Contains(paymentRequest.pmc2.Value) && (paymentRequest.pmc2_amount ?? 0) > 0)
                advanceUsed += paymentRequest.pmc2_amount.Value;
            if (paymentRequest.pmc3.HasValue && advancePaymodeCodes.Contains(paymentRequest.pmc3.Value) && (paymentRequest.pmc3_amount ?? 0) > 0)
                advanceUsed += paymentRequest.pmc3_amount.Value;

            if (advanceUsed == 0 && string.Equals(paymentRequest.collection_type, "ADVANCE", StringComparison.OrdinalIgnoreCase) && paymentRequest.amount > 0)
            {
                advanceUsed = paymentRequest.amount;
            }

            bool advanceProcessedSuccessfully = false;

            // STEP 1: Process Advance deduction FIRST while the bill is still outstanding
            if (advanceUsed > 0 && selectedBill != null && !string.IsNullOrEmpty(selectedBill.requestguid))
            {
                try
                {
                    var bulkItem = new HmsBulkDueCollectionItem
                    {
                        requestguid     = selectedBill.requestguid,
                        cash_collected  = 0,
                        advance_to_use  = advanceUsed,
                        collection_type = "ADVANCE",
                        isbill          = true,
                        ispatient       = true
                    };

                    var bulkReq = new HmsBulkDueCollectionRequest
                    {
                        items           = new List<HmsBulkDueCollectionItem> { bulkItem },
                        collection_type = "ADVANCE",
                        cntcode         = paymentRequest.cntcode > 0 ? paymentRequest.cntcode : 1,
                        usercode        = paymentRequest.usercode > 0 ? paymentRequest.usercode : 10,
                        enteredbhcode   = paymentRequest.enteredbhcode > 0 ? paymentRequest.enteredbhcode : 1,
                        isbill          = true,
                        ispatient       = true
                    };

                    var dueRes = await DueCollectionService.CollectBulkDueAsync(bulkReq);
                    if (dueRes != null)
                    {
                        advanceProcessedSuccessfully = true;
                        Console.WriteLine($"[CashCounter] Advance collection posted successfully for bill {selectedBill.requestguid}: receipt {dueRes.receipt_no}");
                    }
                    else
                    {
                        var useReq = new HmsAdvanceUseRequest
                        {
                            custid          = selectedBill.custid ?? 0,
                            amount_to_use   = advanceUsed,
                            enteredbhcode   = paymentRequest.enteredbhcode,
                            cntcode         = paymentRequest.cntcode,
                            usercode        = paymentRequest.usercode > 0 ? paymentRequest.usercode : 10,
                            computercode    = paymentRequest.computercode,
                            remarks         = $"Cash counter payment using advance for bill {selectedBill.bill_no}"
                        };

                        var useRes = await DueCollectionService.UseAdvanceAsync(useReq);
                        if (useRes != null)
                        {
                            advanceProcessedSuccessfully = true;
                            Console.WriteLine($"[CashCounter] Advance use endpoint posted successfully for patient {selectedBill.custid}: amount {advanceUsed}, receipt: {useRes.receipt_no}");
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"[CashCounter] Error deducting patient advance: {ex.Message}");
                }
            }

            // If this is a PHARMACY bill payment:
            if (selectedPharmacySale != null)
            {
                var saleReq = await FetchPharmacySaleRequestAsync(selectedPharmacySale);
                if (saleReq != null && saleReq.master != null && (saleReq.details?.Any() == true || (selectedPharmacySale.grossamount == 0 && selectedPharmacySale.netamount == 0)))
                {
                    saleReq.master.paymentstatus = "Paid";
                    saleReq.master.paymentmode = paymentRequest.collection_type ?? "CASH";
                    saleReq.master.modifieddate = DateTime.Now;
                    if (paymentRequest.usercode > 0) saleReq.master.usercode = paymentRequest.usercode;

                    bool saved = await SavePharmacySaleUpdateAsync(saleReq);
                    if (!saved)
                    {
                        ToastService.ShowError("Failed to update pharmacy bill payment status on server.");
                        return;
                    }
                }
                else
                {
                    ToastService.ShowError("Unable to retrieve pharmacy bill details. Payment was not recorded to prevent loss of bill items.");
                    return;
                }

                // Also record the cash counter collection transaction
                try
                {
                    await HmsBillingService.AddPaymentAsync(paymentRequest);
                }
                catch { }

                var paidSale = selectedPharmacySale;
                ToastService.ShowSuccess("Pharmacy bill payment received successfully!");
                ClosePaymentModal();
                await LoadPharmacySalesAsync();
                if (paidSale != null)
                {
                    _ = PrintPharmacyBillAsync(paidSale);
                }
                return;
            }

            // STEP 2: Process remaining cash/card/UPI payment for HMS Bills
            double nonAdvanceAmount = paymentRequest.amount - advanceUsed;
            bool nonAdvanceSuccess = true;

            if (nonAdvanceAmount > 0)
            {
                var nonAdvanceReq = new HmsPaymentRequest
                {
                    requestguid     = paymentRequest.requestguid,
                    cntcode         = paymentRequest.cntcode,
                    enteredbhcode   = paymentRequest.enteredbhcode,
                    usercode        = paymentRequest.usercode,
                    computercode    = paymentRequest.computercode,
                    reference_no    = paymentRequest.reference_no,
                    bank_name       = paymentRequest.bank_name,
                    amount          = nonAdvanceAmount
                };

                var nonAdvModes = new List<(decimal mode, double amt)>();
                if (paymentRequest.pmc1.HasValue && !advancePaymodeCodes.Contains(paymentRequest.pmc1.Value) && (paymentRequest.pmc1_amount ?? 0) > 0)
                    nonAdvModes.Add((paymentRequest.pmc1.Value, paymentRequest.pmc1_amount.Value));
                if (paymentRequest.pmc2.HasValue && !advancePaymodeCodes.Contains(paymentRequest.pmc2.Value) && (paymentRequest.pmc2_amount ?? 0) > 0)
                    nonAdvModes.Add((paymentRequest.pmc2.Value, paymentRequest.pmc2_amount.Value));
                if (paymentRequest.pmc3.HasValue && !advancePaymodeCodes.Contains(paymentRequest.pmc3.Value) && (paymentRequest.pmc3_amount ?? 0) > 0)
                    nonAdvModes.Add((paymentRequest.pmc3.Value, paymentRequest.pmc3_amount.Value));

                if (nonAdvModes.Count > 0)
                {
                    nonAdvanceReq.pmc1 = nonAdvModes[0].mode;
                    nonAdvanceReq.pmc1_amount = nonAdvModes[0].amt;
                }
                if (nonAdvModes.Count > 1)
                {
                    nonAdvanceReq.pmc2 = nonAdvModes[1].mode;
                    nonAdvanceReq.pmc2_amount = nonAdvModes[1].amt;
                }
                if (nonAdvModes.Count > 2)
                {
                    nonAdvanceReq.pmc3 = nonAdvModes[2].mode;
                    nonAdvanceReq.pmc3_amount = nonAdvModes[2].amt;
                }

                if (nonAdvModes.Count > 1)
                {
                    nonAdvanceReq.collection_type = "MIXED";
                }
                else if (nonAdvModes.Count == 1)
                {
                    var pm = paymodes.FirstOrDefault(p => p.pmcode == nonAdvModes[0].mode);
                    nonAdvanceReq.collection_type = pm?.shortname ?? "CASH";
                }
                else
                {
                    nonAdvanceReq.collection_type = "CASH";
                    nonAdvanceReq.pmc1_amount = nonAdvanceAmount;
                }

                nonAdvanceSuccess = await HmsBillingService.AddPaymentAsync(nonAdvanceReq);
            }

            if ((advanceUsed > 0 ? advanceProcessedSuccessfully : true) && nonAdvanceSuccess)
            {
                var paidGuid = paymentRequest.requestguid;
                var paidBillNo = selectedBill?.bill_no;
                ToastService.ShowSuccess("Payment received successfully!");
                ClosePaymentModal();
                await LoadBillsAsync();
                if (!string.IsNullOrEmpty(paidGuid))
                {
                    _ = PrintHospitalBillAsync(paidGuid, paidBillNo);
                }
            }
            else
            {
                ToastService.ShowError("Payment submission failed.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error processing payment: {ex.Message}");
        }
        finally
        {
            paymentRequest.pmc1_amount = origPmc1;
            paymentRequest.pmc2_amount = origPmc2;
            paymentRequest.pmc3_amount = origPmc3;
            paymentRequest.amount = origAmount;

            paymentSaving = false;
            StateHasChanged();
        }
    }

    // Pharmacy Data Loaders & Endpoints
    private HttpClient CreateDoctorApiClient()
    {
        var client = ClientFactory.CreateClient("DoctorApi");
        client.DefaultRequestHeaders.Remove("tenantcode");
        client.DefaultRequestHeaders.Remove("tenant_code");
        client.DefaultRequestHeaders.Remove("tenant-code");

        string tCode = !string.IsNullOrEmpty(DefaultTenant) 
            ? DefaultTenant 
            : (!string.IsNullOrEmpty(TenantState?.TenantCode) ? TenantState.TenantCode : "0004");

        client.DefaultRequestHeaders.Add("tenantcode", tCode);
        client.DefaultRequestHeaders.Add("tenant_code", tCode);
        client.DefaultRequestHeaders.Add("tenant-code", tCode);

        var effectiveToken = !string.IsNullOrEmpty(AuthToken) 
            ? AuthToken 
            : (!string.IsNullOrEmpty(TenantState?.AuthToken) ? TenantState.AuthToken : "");

        if (!string.IsNullOrEmpty(effectiveToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
        }
        return client;
    }

    private async Task LoadPharmacySalesAsync()
    {
        if (billingSource == "PHARMACY")
        {
            isLoading = true;
            StateHasChanged();
        }

        try
        {
            var client = CreateDoctorApiClient();
            var response = await client.GetStringAsync("api/ItemMaster/getsales");
            if (!string.IsNullOrWhiteSpace(response))
            {
                PharmacySalesList = ParsePharmacySalesListResponse(response);
            }
            else
            {
                PharmacySalesList = new();
            }
            await Task.WhenAll(LoadHospitalTotalsAsync(), LoadDueTotalsAsync());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CashCounter] Error loading pharmacy bills: {ex.Message}");
            if (billingSource == "PHARMACY")
            {
                ToastService.ShowError($"Error loading pharmacy bills: {ex.Message}");
            }
            PharmacySalesList = new();
        }
        finally
        {
            if (billingSource == "PHARMACY")
            {
                isLoading = false;
            }
            StateHasChanged();
        }
    }

    private async Task<sales_request?> FetchPharmacySaleRequestAsync(sales_master sale)
    {
        if (sale == null) return null;

        long salesCode = sale.salescode;
        if (salesCode <= 0 && !string.IsNullOrWhiteSpace(sale.billno))
        {
            var numStr = System.Text.RegularExpressions.Regex.Match(sale.billno, @"\d+").Value;
            long.TryParse(numStr, out salesCode);
        }

        if (salesCode <= 0)
        {
            Console.WriteLine("[CashCounter] Cannot fetch pharmacy sale: salescode is 0");
            return null;
        }

        string tenantCode = !string.IsNullOrEmpty(sale.tenantcode)
            ? sale.tenantcode
            : (!string.IsNullOrEmpty(DefaultTenant) ? DefaultTenant : (TenantState?.TenantCode ?? ""));

        try
        {
            var client = CreateDoctorApiClient();
            if (!string.IsNullOrEmpty(tenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenantcode");
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Remove("tenant-code");
                client.DefaultRequestHeaders.Add("tenantcode", tenantCode);
                client.DefaultRequestHeaders.Add("tenant_code", tenantCode);
                client.DefaultRequestHeaders.Add("tenant-code", tenantCode);
            }

            // Using the requested endpoint: api/ItemMaster/getsalesbycode?salescode
            var urls = new List<string>
            {
                $"api/ItemMaster/getsalesbycode?salescode={salesCode}" + (!string.IsNullOrEmpty(tenantCode) ? $"&tenantcode={tenantCode}" : ""),
                $"api/ItemMaster/getsalesbycode?salescode={salesCode}"
            };

            foreach (var url in urls.Distinct())
            {
                try
                {
                    var response = await client.GetAsync(url);
                    if (response.IsSuccessStatusCode)
                    {
                        var json = await response.Content.ReadAsStringAsync();
                        var loaded = ParsePharmacyRequestResponse(json, salesCode);
                        if (loaded != null && loaded.master != null && loaded.master.salescode > 0)
                        {
                            Console.WriteLine($"[CashCounter] Successfully fetched sale #{salesCode} with {loaded.details?.Count ?? 0} items via {url}");
                            return loaded;
                        }
                    }
                    else
                    {
                        Console.WriteLine($"[CashCounter] Endpoint '{url}' returned status {response.StatusCode}");
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[CashCounter] Error trying '{url}': {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CashCounter] Error fetching pharmacy sale #{salesCode} via getsalesbycode: {ex.Message}");
        }

        return null;
    }

    private async Task<bool> SavePharmacySaleUpdateAsync(sales_request req)
    {
        if (req == null || req.master == null) return false;

        if ((req.details == null || !req.details.Any()) && (req.master.grossamount > 0 || req.master.netamount > 0))
        {
            Console.WriteLine("[CashCounter] ABORT SavePharmacySaleUpdate: details list is empty for a bill with amount > 0. Preventing data loss.");
            return false;
        }

        try
        {
            string tCode = !string.IsNullOrEmpty(req.master.tenantcode) 
                ? req.master.tenantcode 
                : (!string.IsNullOrEmpty(DefaultTenant) ? DefaultTenant : (TenantState?.TenantCode ?? ""));

            foreach (var detail in req.details ?? Enumerable.Empty<sales_detail>())
            {
                if (string.IsNullOrEmpty(detail.tenantcode)) detail.tenantcode = tCode;
                detail.salescode = req.master.salescode;
                if (detail.soldqty == 0 && detail.quantity > 0) detail.soldqty = detail.quantity;
                detail.uomcode ??= 0;
            }

            var client = CreateDoctorApiClient();
            if (!string.IsNullOrEmpty(tCode))
            {
                client.DefaultRequestHeaders.Remove("tenantcode");
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Remove("tenant-code");
                client.DefaultRequestHeaders.Add("tenantcode", tCode);
                client.DefaultRequestHeaders.Add("tenant_code", tCode);
                client.DefaultRequestHeaders.Add("tenant-code", tCode);
            }

            var updateEndpoints = new[]
            {
                "api/ItemMaster/updatesales",
                "api/ItemMaster/insertsales"
            };

            foreach (var ep in updateEndpoints)
            {
                try
                {
                    var res = await client.PostAsJsonAsync(ep, req);
                    var body = await res.Content.ReadAsStringAsync();
                    Console.WriteLine($"[CashCounter] Save endpoint '{ep}' response: {res.StatusCode} - {body}");
                    if (res.IsSuccessStatusCode && !body.Contains("\"success\":false") && !body.Contains("\"status\":\"Failed\"") && !body.Contains("\"error\":"))
                    {
                        return true;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[CashCounter] Exception calling '{ep}': {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CashCounter] Error saving pharmacy sale update: {ex.Message}");
        }
        return false;
    }

    private List<sales_master> ParsePharmacySalesListResponse(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        var options = new System.Text.Json.JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            JsonElement arrayElement;
            if (root.ValueKind == JsonValueKind.Array)
            {
                arrayElement = root;
            }
            else if (root.ValueKind == JsonValueKind.Object)
            {
                if (root.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == JsonValueKind.Array)
                {
                    arrayElement = dataProp;
                }
                else
                {
                    bool found = false;
                    arrayElement = default;
                    foreach (var prop in root.EnumerateObject())
                    {
                        if (prop.Value.ValueKind == JsonValueKind.Array)
                        {
                            arrayElement = prop.Value;
                            found = true;
                            break;
                        }
                    }
                    if (!found) return new();
                }
            }
            else return new();

            var result = new List<sales_master>();
            foreach (var item in arrayElement.EnumerateArray())
            {
                try
                {
                    var m = ParsePharmacyMaster(item, options);
                    if (m != null) result.Add(m);
                }
                catch (Exception pEx)
                {
                    Console.WriteLine("[CashCounter] Error parsing single pharmacy sale: " + pEx.Message);
                }
            }
            return result.OrderByDescending(x => x.salescode > 0 ? x.salescode : x.billdate.Ticks).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine("[CashCounter] Parse Pharmacy Sales Error: " + ex.Message);
        }

        return new();
    }

    private static string? GetJsonStringSafe(JsonElement p)
    {
        if (p.ValueKind == JsonValueKind.String) return p.GetString();
        if (p.ValueKind == JsonValueKind.Number) return p.GetRawText();
        if (p.ValueKind == JsonValueKind.True) return "true";
        if (p.ValueKind == JsonValueKind.False) return "false";
        if (p.ValueKind == JsonValueKind.Null || p.ValueKind == JsonValueKind.Undefined) return null;
        return p.GetRawText();
    }

    private static DateTime? TryParseJsonDate(JsonElement p)
    {
        try
        {
            if (p.ValueKind == JsonValueKind.String)
            {
                var s = p.GetString();
                if (!string.IsNullOrWhiteSpace(s) && DateTime.TryParse(s, out var dt))
                {
                    return dt;
                }
            }
            else if (p.ValueKind == JsonValueKind.Number && p.TryGetInt64(out var val))
            {
                if (val > 1000000000000L) return DateTimeOffset.FromUnixTimeMilliseconds(val).LocalDateTime;
                if (val > 1000000000L) return DateTimeOffset.FromUnixTimeSeconds(val).LocalDateTime;
            }
        }
        catch { }
        return null;
    }

    private sales_master? ParsePharmacyMaster(JsonElement el, System.Text.Json.JsonSerializerOptions options)
    {
        var target = el;
        if (el.TryGetProperty("master", out var mProp)) target = mProp;

        sales_master? m = null;
        try
        {
            m = System.Text.Json.JsonSerializer.Deserialize<sales_master>(target.GetRawText(), options);
        }
        catch { }

        m ??= new sales_master();

        if (m.salescode == 0)
        {
            foreach (var key in new[] { "salescode", "sales_code", "code", "id" })
            {
                if (TryGetPropertyIgnoreCase(target, key, out var p))
                {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetInt64(out var valNum)) { m.salescode = valNum; break; }
                    else if (p.ValueKind == JsonValueKind.String && long.TryParse(p.GetString(), out var val)) { m.salescode = val; break; }
                }
            }
        }
        if (string.IsNullOrEmpty(m.billno))
        {
            foreach (var key in new[] { "billno", "bill_no", "invoiceno", "invoice_no" })
            {
                if (TryGetPropertyIgnoreCase(target, key, out var p))
                {
                    m.billno = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.billno)) break;
                }
            }
        }
        if (m.billdate == default)
        {
            foreach (var key in new[] { "billdate", "bill_date", "createddate", "created_date" })
            {
                if (TryGetPropertyIgnoreCase(target, key, out var p))
                {
                    var dt = TryParseJsonDate(p);
                    if (dt.HasValue && dt.Value != default)
                    {
                        m.billdate = dt.Value;
                        break;
                    }
                }
            }
        }
        if (m.createddate == default)
        {
            foreach (var src in new[] { target, el })
            {
                foreach (var key in new[] { "createddate", "created_date", "createdon", "created_on", "inserteddate", "inserted_date", "entrydate", "entry_date", "created_at", "createdat", "bill_entered_date", "date_entered" })
                {
                    if (TryGetPropertyIgnoreCase(src, key, out var p))
                    {
                        var dt = TryParseJsonDate(p);
                        if (dt.HasValue && dt.Value != default)
                        {
                            m.createddate = dt.Value;
                            break;
                        }
                    }
                }
                if (m.createddate != default) break;
            }
        }
        if (!m.modifieddate.HasValue || m.modifieddate.Value == default)
        {
            foreach (var src in new[] { target, el })
            {
                foreach (var key in new[] { "modifieddate", "modified_date", "updateddate", "updated_date", "modifiedon", "modified_on", "updatedon", "updated_on", "updated_at", "updatedat" })
                {
                    if (TryGetPropertyIgnoreCase(src, key, out var p))
                    {
                        var dt = TryParseJsonDate(p);
                        if (dt.HasValue && dt.Value != default)
                        {
                            m.modifieddate = dt.Value;
                            break;
                        }
                    }
                }
                if (m.modifieddate.HasValue && m.modifieddate.Value != default) break;
            }
        }
        if (!m.invoicedate.HasValue || m.invoicedate.Value == default)
        {
            foreach (var src in new[] { target, el })
            {
                foreach (var key in new[] { "invoicedate", "invoice_date" })
                {
                    if (TryGetPropertyIgnoreCase(src, key, out var p))
                    {
                        var dt = TryParseJsonDate(p);
                        if (dt.HasValue && dt.Value != default)
                        {
                            m.invoicedate = dt.Value;
                            break;
                        }
                    }
                }
                if (m.invoicedate.HasValue && m.invoicedate.Value != default) break;
            }
        }
        if (string.IsNullOrEmpty(m.patientname))
        {
            foreach (var key in new[] { "patientname", "patient_name", "customername", "name" })
            {
                if (TryGetPropertyIgnoreCase(target, key, out var p))
                {
                    m.patientname = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.patientname)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.mobileno))
        {
            foreach (var key in new[] { "mobileno", "mobile_no", "mobile", "phone", "phoneno", "contactno" })
            {
                if (TryGetPropertyIgnoreCase(target, key, out var p))
                {
                    m.mobileno = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.mobileno)) break;
                }
            }
        }
        if (string.IsNullOrEmpty(m.patientid))
        {
            foreach (var key in new[] { "patientid", "patient_id", "customercode", "customer_code" })
            {
                if (TryGetPropertyIgnoreCase(target, key, out var p))
                {
                    var pid = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(pid) && pid != "0")
                    {
                        m.patientid = pid;
                        break;
                    }
                }
            }
        }
        if (!m.customercode.HasValue || m.customercode.Value == 0)
        {
            foreach (var key in new[] { "customercode", "customer_code", "custid", "cust_id" })
            {
                if (TryGetPropertyIgnoreCase(target, key, out var p))
                {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetInt64(out var cVal)) { m.customercode = cVal; break; }
                    else if (p.ValueKind == JsonValueKind.String && long.TryParse(p.GetString(), out var cStrVal)) { m.customercode = cStrVal; break; }
                }
            }
        }
        if (m.netamount == 0)
        {
            foreach (var key in new[] { "netamount", "net_amount", "totalamount", "total" })
            {
                if (TryGetPropertyIgnoreCase(target, key, out var p))
                {
                    if (p.ValueKind == JsonValueKind.Number && p.TryGetDecimal(out var dVal)) { m.netamount = dVal; break; }
                    else if (p.ValueKind == JsonValueKind.String && decimal.TryParse(p.GetString(), out var val)) { m.netamount = val; break; }
                }
            }
        }
        if (string.IsNullOrEmpty(m.tenantcode))
        {
            foreach (var key in new[] { "tenantcode", "tenant_code", "tenantCode", "tenant" })
            {
                if (TryGetPropertyIgnoreCase(target, key, out var p))
                {
                    m.tenantcode = GetJsonStringSafe(p);
                    if (!string.IsNullOrEmpty(m.tenantcode)) break;
                }
            }
        }
        return m;
    }

