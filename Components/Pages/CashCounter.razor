    private bool MatchesPharmacySearch(sales_master s, string? query)
    {
        if (string.IsNullOrWhiteSpace(query)) return true;
        var q = query.Trim();

        if (s.billno != null && s.billno.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (s.salescode.ToString().Contains(q)) return true;
        if (s.patientname != null && s.patientname.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (s.patientid != null && s.patientid.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (s.mobileno != null && s.mobileno.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (s.address != null && s.address.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (s.consultant != null && s.consultant.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (s.invoiceno != null && s.invoiceno.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;
        if (s.remarks != null && s.remarks.Contains(q, StringComparison.OrdinalIgnoreCase)) return true;

        var cleanQ = new string(q.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
        if (!string.IsNullOrEmpty(cleanQ))
        {
            var cleanBill = new string((s.billno ?? "").Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
            if (cleanBill.Contains(cleanQ)) return true;

            var digitsQ = new string(q.Where(char.IsDigit).ToArray());
            if (!string.IsNullOrEmpty(digitsQ) && long.TryParse(digitsQ, out var numQ) && numQ > 0)
            {
                if (s.salescode == numQ) return true;
                var billDigits = new string((s.billno ?? "").Where(char.IsDigit).ToArray());
                if (billDigits.Contains(digitsQ)) return true;
            }
        }

        return false;
    }

    private List<sales_master> FilteredPharmacySales => PharmacySalesList
        .Where(s =>
            (string.IsNullOrEmpty(DefaultTenant) || string.IsNullOrEmpty(s.tenantcode) || string.Equals(s.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase)) &&
            (!filter.fromdate.HasValue || s.billdate.Date >= filter.fromdate.Value.Date || (s.createddate != default && s.createddate.Date >= filter.fromdate.Value.Date)) &&
            (!filter.todate.HasValue || s.billdate.Date <= filter.todate.Value.Date || (s.createddate != default && s.createddate.Date <= filter.todate.Value.Date)) &&
            (statusFilter == "ALL" ||
             (statusFilter == "PENDING" && !string.Equals(s.paymentstatus, "Paid", StringComparison.OrdinalIgnoreCase) && !string.Equals(s.paymentstatus, "Settled", StringComparison.OrdinalIgnoreCase)) ||
             (statusFilter == "SETTLED" && (string.Equals(s.paymentstatus, "Paid", StringComparison.OrdinalIgnoreCase) || string.Equals(s.paymentstatus, "Settled", StringComparison.OrdinalIgnoreCase)))) &&
            MatchesPharmacySearch(s, filter.search)
        )
        .OrderByDescending(s => s.salescode > 0 ? s.salescode : s.billdate.Ticks)
        .ToList();

    private List<sales_master> PagedPharmacySales
    {
        get
        {
            var list = FilteredPharmacySales;
            int maxP = Math.Max(1, (int)Math.Ceiling(list.Count / (double)filter.pagesize));
            if (pharmacyPage > maxP) pharmacyPage = 1;
            return list.Skip((pharmacyPage - 1) * filter.pagesize).Take(filter.pagesize).ToList();
        }
    }

