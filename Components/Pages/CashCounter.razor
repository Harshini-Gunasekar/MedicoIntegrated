        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading pharmacy bill report: {ex.Message}");
        }
        finally
        {
            printingBillKey = null;
            isPrintingAnyBill = false;
            StateHasChanged();
        }
    }

