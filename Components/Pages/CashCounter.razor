    private List<PaymodeCardDisplayDto> GetPaymodeDisplayCards()
    {
        var cards = new List<PaymodeCardDisplayDto>();

        // Dictionary of paymode amounts keyed by uppercase name
        var paymodeAmounts = new Dictionary<string, (double Amount, int Receipts, double Percentage)>(StringComparer.OrdinalIgnoreCase);

        if (payModeCollectionData?.by_paymode != null && payModeCollectionData.by_paymode.Any())
        {
            foreach (var item in payModeCollectionData.by_paymode)
            {
                string name = (!string.IsNullOrWhiteSpace(item.paymode) ? item.paymode.Trim() : "CASH").ToUpper();
                int rc = payModeCollectionData.details?.Where(d => string.Equals(d.paymode, item.paymode, StringComparison.OrdinalIgnoreCase)).Sum(d => d.receipt_count) ?? 0;
                if (paymodeAmounts.ContainsKey(name))
                {
                    var existing = paymodeAmounts[name];
                    paymodeAmounts[name] = (existing.Amount + item.total, existing.Receipts + rc, 0);
                }
                else
                {
                    paymodeAmounts[name] = (item.total, rc, 0);
                }
            }
        }
        else if (payModeCollectionData?.items != null && payModeCollectionData.items.Any())
        {
            foreach (var item in payModeCollectionData.items)
            {
                string name = (!string.IsNullOrWhiteSpace(item.paymode_name) ? item.paymode_name.Trim() : "CASH").ToUpper();
                if (paymodeAmounts.ContainsKey(name))
                {
                    var existing = paymodeAmounts[name];
                    paymodeAmounts[name] = (existing.Amount + item.total_collected, existing.Receipts + item.receipt_count, existing.Percentage + item.percentage);
                }
                else
                {
                    paymodeAmounts[name] = (item.total_collected, item.receipt_count, item.percentage);
                }
            }
        }
        else
        {
            // Fallback: If API returns empty items list, compute from loaded hospital settled bills & pharmacy sales
            double cashAmt = 0;
            double cardAmt = 0;
            double upiAmt = 0;
            var otherModes = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);

            if (billsList?.data != null)
            {
                foreach (var b in billsList.data)
                {
                    double paid = b.paid_amount ?? 0;
                    if (paid > 0)
                    {
                        cashAmt += paid;
                    }
                }
            }

            if (PharmacySalesList != null)
            {
                var filteredPharma = PharmacySalesList.Where(s =>
                    (string.IsNullOrEmpty(DefaultTenant) || string.IsNullOrEmpty(s.tenantcode) || string.Equals(s.tenantcode, DefaultTenant, StringComparison.OrdinalIgnoreCase)) &&
                    (!filter.fromdate.HasValue || s.billdate.Date >= filter.fromdate.Value.Date) &&
                    (!filter.todate.HasValue || s.billdate.Date <= filter.todate.Value.Date) &&
                    (string.Equals(s.paymentstatus, "Paid", StringComparison.OrdinalIgnoreCase) || string.Equals(s.paymentstatus, "Settled", StringComparison.OrdinalIgnoreCase))
                );

                foreach (var s in filteredPharma)
                {
                    double amt = (double)s.netamount;
                    if (amt <= 0) continue;
                    string mode = (s.paymentmode ?? "").Trim().ToUpper();
                    if (mode.Contains("CARD")) cardAmt += amt;
                    else if (mode.Contains("UPI") || mode.Contains("GPAY") || mode.Contains("ONLINE")) upiAmt += amt;
                    else if (mode.Contains("CASH") || string.IsNullOrEmpty(mode)) cashAmt += amt;
                    else otherModes[mode] = otherModes.GetValueOrDefault(mode) + amt;
                }
            }

            paymodeAmounts["CASH"] = (cashAmt, 0, 0);
            paymodeAmounts["CARD"] = (cardAmt, 0, 0);
            paymodeAmounts["UPI"] = (upiAmt, 0, 0);
            foreach (var kvp in otherModes)
            {
                paymodeAmounts[kvp.Key] = (kvp.Value, 0, 0);
            }
        }

        // Always ensure standard primary modes (CASH, CARD, UPI) are available for the 4-card layout
        if (!paymodeAmounts.ContainsKey("CASH")) paymodeAmounts["CASH"] = (0, 0, 0);
        if (!paymodeAmounts.ContainsKey("CARD")) paymodeAmounts["CARD"] = (0, 0, 0);
        if (!paymodeAmounts.ContainsKey("UPI")) paymodeAmounts["UPI"] = (0, 0, 0);

        // Render Cards: CASH, CARD, UPI, then any other paymodes, then TOTAL NET AMOUNT
        // 1. CASH
        var cashData = paymodeAmounts["CASH"];
        cards.Add(new PaymodeCardDisplayDto
        {
            Label = "CASH",
            Amount = cashData.Amount,
            CardClass = "bill-card",
            IconClass = "bi bi-cash-stack",
            Tooltip = $"Cash Collections: ₹{cashData.Amount:N2}"
        });

        // 2. CARD
        var cardData = paymodeAmounts["CARD"];
        cards.Add(new PaymodeCardDisplayDto
        {
            Label = "CARD",
            Amount = cardData.Amount,
            CardClass = "due-card",
            IconClass = "bi bi-credit-card",
            Tooltip = $"Card Collections: ₹{cardData.Amount:N2}"
        });

        // 3. UPI
        var upiData = paymodeAmounts["UPI"];
        cards.Add(new PaymodeCardDisplayDto
        {
            Label = "UPI / ONLINE",
            Amount = upiData.Amount,
            CardClass = "pharmacy-card",
            IconClass = "bi bi-qr-code-scan",
            Tooltip = $"UPI / Online Collections: ₹{upiData.Amount:N2}"
        });

        // 4. Any other modes present with amount > 0 or in API response
        foreach (var kvp in paymodeAmounts)
        {
            if (kvp.Key == "CASH" || kvp.Key == "CARD" || kvp.Key == "UPI") continue;
            if (kvp.Value.Amount > 0 || (payModeCollectionData?.items?.Any(i => string.Equals(i.paymode_name, kvp.Key, StringComparison.OrdinalIgnoreCase)) ?? false))
            {
                cards.Add(new PaymodeCardDisplayDto
                {
                    Label = kvp.Key,
                    Amount = kvp.Value.Amount,
                    CardClass = "paid-card",
                    IconClass = "bi bi-wallet-fill",
                    Tooltip = $"{kvp.Key} Collections: ₹{kvp.Value.Amount:N2}"
                });
            }
        }

        // 5. Grand Total / TOTAL NET AMOUNT
        double grandTotal = payModeCollectionData != null && (payModeCollectionData.net_total > 0 || payModeCollectionData.grand_total > 0)
            ? (payModeCollectionData.net_total > 0 ? payModeCollectionData.net_total : payModeCollectionData.grand_total)
            : cards.Sum(c => c.Amount);

        if (grandTotal <= 0 && TotalNet > 0)
        {
            grandTotal = (double)TotalNet;
            if (cards.All(c => c.Amount <= 0) && TotalHospitalPaid > 0)
            {
                var cCard = cards.FirstOrDefault(c => c.Label == "CASH");
                if (cCard != null) cCard.Amount = (double)TotalHospitalPaid;
            }
        }

        cards.Add(new PaymodeCardDisplayDto
        {
            Label = "TOTAL NET AMOUNT",
            Amount = grandTotal,
            CardClass = "net-card",
            IconClass = "bi bi-wallet2",
            Tooltip = $"Total Collections across all Pay Modes: ₹{grandTotal:N2}"
        });

        return cards;
    }

