                                                    <i class="bi bi-arrow-return-left me-1"></i>Refunded
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn-dots-action" @onclick="() => PrintRefundReceiptAsync(refHistoryKey)" disabled="@(printingBillKey == refHistoryKey)" title="Preview & Print Refund Receipt" style="color: #dc2626; border-color: #fecaca; background: #fef2f2;">
