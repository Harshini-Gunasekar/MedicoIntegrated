                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => tabDirectRefundModel.refund_amount = directRefundPatientSummary.available_balance">
                                            Full
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-bold small text-secondary">PAYMENT MODE</label>
                                    <select class="form-select" @bind="tabDirectRefundPaymode">
                                        <option value="CASH">Cash</option>
                                        <option value="UPI">UPI</option>
                                        <option value="BANK_TRANSFER">Bank Transfer / NEFT</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bold small text-secondary">REF / TXN ID</label>
                                    <input type="text" class="form-control" @bind="tabDirectRefundRefNo" placeholder="e.g. UTR / Memo" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-secondary">REFUND REASON <span class="text-danger">*</span></label>
                                <select class="form-select mb-2" @bind="tabDirectRefundReason">
                                    <option value="Patient Discharged - unused advance refunded">Patient Discharged - unused advance refunded</option>
                                    <option value="Treatment Cancelled">Treatment Cancelled</option>
                                    <option value="Excess Advance Deposited">Excess Advance Deposited</option>
                                    <option value="Other">Other (enter in remarks)</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-secondary">REMARKS</label>
                                <input type="text" class="form-control" @bind="tabDirectRefundModel.remarks" placeholder="Optional notes" />
                            </div>

                            <button type="button" class="btn btn-danger w-100 py-2 fw-bold" style="border-radius: 8px; font-size: 0.95rem;" @onclick="SubmitTabDirectRefundAsync" disabled="@isSubmittingTabDirectRefund">
                                @if (isSubmittingTabDirectRefund)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Processing Refund...</span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-return-left me-1"></i>
                                    <span>Disburse Refund</span>
                                }
                            </button>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="table-card">
                            <div class="table-header">
                                <h2 class="table-title">Patients with Refundable Advance Balance</h2>
                                <span class="record-count">Total: @advanceDepositsList.Count(p => p.available_balance > 0)</span>
                            </div>
                            <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                                <table class="custom-table">
                                    <thead>
                                        <tr>
                                            <th>PATIENT</th>
                                            <th>UHID</th>
                                            <th class="text-end">AVAILABLE BALANCE</th>
                                            <th class="text-center">ACTION</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in advanceDepositsList.Where(p => p.available_balance > 0))
                                        {
                                            <tr>
                                                <td>
                                                    <span class="fw-bold text-dark">@p.patient_name</span>
                                                    <br /><small class="text-muted">@p.mobile</small>
                                                </td>
                                                <td><span class="badge bg-light text-dark border font-monospace">@GetPatientUhidFromId(p.custid, p.custcode)</span></td>
                                                <td class="text-end fw-bold text-danger fs-6">&#8377;@p.available_balance.ToString("N2")</td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-outline-danger btn-sm py-1 px-3 fw-bold" @onclick="() => SelectTabDirectRefundPatient(p)">
                                                        <i class="bi bi-arrow-return-left me-1"></i>Refund
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (advanceActiveSubTab == "LEDGER" || advanceActiveSubTab == "DEPOSITS")
            {
                <!-- Tab 5: Patient Advance Balances & Ledger Screen -->
                <!-- Summary KPI Cards -->
                <div class="advance-kpi-grid">
                    <div class="advance-kpi-card card-deposited">
                        <div class="kpi-icon"><i class="bi bi-box-arrow-in-down"></i></div>
                        <div class="kpi-content">
                            <span class="kpi-label">TOTAL ADVANCE DEPOSITED</span>
                            <span class="kpi-val">&#8377;@advanceDepositsSummary.total_deposited_sum.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="advance-kpi-card card-utilized">
                        <div class="kpi-icon"><i class="bi bi-receipt-cutoff"></i></div>
                        <div class="kpi-content">
                            <span class="kpi-label">TOTAL UTILIZED IN BILLS</span>
                            <span class="kpi-val">&#8377;@advanceDepositsSummary.total_used_sum.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="advance-kpi-card card-refunded">
                        <div class="kpi-icon"><i class="bi bi-arrow-counterclockwise"></i></div>
                        <div class="kpi-content">
                            <span class="kpi-label">TOTAL ADVANCE REFUNDED</span>
                            <span class="kpi-val">&#8377;@advanceDepositsSummary.total_refunded_sum.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="advance-kpi-card card-balance">
                        <div class="kpi-icon"><i class="bi bi-wallet2"></i></div>
                        <div class="kpi-content">
                            <span class="kpi-label">NET AVAILABLE ADVANCE</span>
                            <span class="kpi-val">&#8377;@advanceDepositsSummary.total_available_sum.ToString("N2")</span>
                        </div>
                    </div>
                </div>

                <!-- Deposits Filter / Search Bar -->
                <div class="filter-card advance-filter-card">
                    <div class="advance-filter-row">
                        <div class="status-toggle-group">
                            <button type="button" class="filter-pill-btn @(advanceBalanceStatusFilter == "HAS_BALANCE" ? "active" : "")" @onclick='() => SetAdvanceBalanceStatusFilter("HAS_BALANCE")'>Has Balance</button>
                            <button type="button" class="filter-pill-btn @(advanceBalanceStatusFilter == "ALL" ? "active" : "")" @onclick='() => SetAdvanceBalanceStatusFilter("ALL")'>All Patients</button>
                        </div>
                        <div class="search-input-wrapper advance-search-box">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" class="form-control" @bind="advancePatientSearchQuery" @onkeyup="HandleAdvancePatientSearchKeyUp" placeholder="Search by Patient Name, UHID or Mobile & Enter..." />
                        </div>
                        <button type="button" class="btn-advance-search" @onclick="LoadPatientDepositsAsync" title="Search">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <button type="button" class="btn-advance-reset" @onclick="ResetAdvanceDepositsFilterAsync" title="Reset Filters">
                            <i class="bi bi-arrow-clockwise"></i> Reset
                        </button>
                    </div>
                </div>

                <!-- Deposits Table Card -->
                <div class="table-card">
                    <div class="table-header">
                        <h2 class="table-title">Patient Advance Balances &amp; Ledger</h2>
                        <span class="record-count">Total: @FilteredAdvanceDeposits.Count patients</span>
                    </div>
                    <div class="table-responsive">
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">S.NO</th>
                                    <th>PATIENT</th>
                                    <th>UHID</th>
                                    <th>MOBILE</th>
                                    <th class="text-end">TOTAL DEPOSITED</th>
                                    <th class="text-end">TOTAL USED</th>
                                    <th class="text-end">TOTAL REFUNDED</th>
                                    <th class="text-end">AVAILABLE BALANCE</th>
                                    <th>LAST DEPOSIT DATE</th>
                                    <th class="text-center" style="width: 180px;">ACTIONS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (FilteredAdvanceDeposits.Count == 0)
                                {
                                    <tr>
                                        <td colspan="10" class="text-center py-5 text-muted">
                                            <i class="bi bi-wallet2" style="font-size: 2.2rem; color: #cbd5e1; display: block; margin-bottom: 0.5rem;"></i>
                                            No advance balance records found.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int didx = 1;
                                    @foreach (var p in FilteredAdvanceDeposits)
                                    {
                                        <tr>
                                            <td>@didx</td>
                                            <td>
                                                <span class="fw-bold text-dark">@p.patient_name</span>
                                                @if (!string.IsNullOrWhiteSpace(p.city))
                                                {
                                                    <small class="text-muted d-block">@p.city</small>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border font-monospace">@GetPatientUhidFromId(p.custid, p.custcode)</span>
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(p.mobile) ? "-" : p.mobile)</td>
                                            <td class="text-end fw-semibold text-secondary">&#8377;@p.total_deposited.ToString("N2")</td>
                                            <td class="text-end fw-semibold text-secondary">&#8377;@p.total_used.ToString("N2")</td>
                                            <td class="text-end fw-semibold text-warning">&#8377;@p.total_refunded.ToString("N2")</td>
                                            <td class="text-end fw-bold text-success fs-6">
                                                &#8377;@p.available_balance.ToString("N2")
