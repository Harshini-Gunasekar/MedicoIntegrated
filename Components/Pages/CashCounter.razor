                                                        @if (printingBillKey == $"ALL_{p.custid}")
                                                        {
                                                            <span class="spinner-border spinner-border-sm" role="status" style="width: 10px; height: 10px; border-width: 1.5px;"></span>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-printer-fill"></i>
                                                        }
                                                        <span>Print</span>
                                                    </button>
                                                    @if (p.available_balance > 0)
                                                    {
                                                        <button type="button" class="btn-advance-refund" @onclick="() => OpenIssueRefundModal(p)" title="Issue advance refund">
                                                            <i class="bi bi-arrow-return-left"></i> Refund
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                        didx++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (advanceActiveSubTab == "REFUND_HISTORY")
            {
                <!-- Tab 6: Refund History Tab -->
