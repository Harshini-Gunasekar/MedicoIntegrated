    private async Task SearchRequestAdvancePatientsAsync()
    {
        if (string.IsNullOrWhiteSpace(requestAdvanceSearchQuery))
        {
            requestAdvanceSearchResults.Clear();
            showRequestAdvanceDropdown = false;
            return;
        }

        string q = requestAdvanceSearchQuery.Trim();
