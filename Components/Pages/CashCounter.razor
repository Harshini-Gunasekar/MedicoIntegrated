    private async Task SubmitProcessRefundAsync()
    {
        if (selectedRefundRequestToProcess == null) return;
        if ((processRefundModel.amount ?? 0) <= 0)
        {
            ToastService.ShowWarning("Refund amount must be greater than 0.");
            return;
        }

        isProcessingRefund = true;
        try
        {
            var res = await DueCollectionService.ProcessRefundRequestAsync(processRefundModel);
            if (res.success && res.receipt != null)
            {
                var newReceiptKey = !string.IsNullOrWhiteSpace(res.receipt.receipt_guid) ? res.receipt.receipt_guid : res.receipt.receipt_no;
                ToastService.ShowSuccess($"Advance refund of ₹{(processRefundModel.amount ?? 0):N2} disbursed successfully! Receipt: {res.receipt.receipt_no}");
                showProcessRefundModal = false;
                await LoadRefundRequestsAsync();
                await LoadPatientDepositsAsync();
                await LoadRefundHistoryAsync();
                if (!string.IsNullOrEmpty(newReceiptKey))
                {
                    _ = PrintRefundReceiptAsync(newReceiptKey);
                }
            }
            else
            {
                ToastService.ShowError(res.message ?? "Failed to process refund request.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error processing refund: {ex.Message}");
        }
        finally
        {
            isProcessingRefund = false;
            StateHasChanged();
        }
    }

