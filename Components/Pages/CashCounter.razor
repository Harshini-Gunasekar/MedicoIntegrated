    private async Task LoadOpRegistrationsLookupAsync()
    {
        try
        {
            cachedOpRegistrations = await AppointmentBookingService.GetAllOpRegistrationsAsync() ?? new();

            opByGuidMap.Clear();
            opByNoMap.Clear();
            opByCustDateMap.Clear();
            opByCustIdMap.Clear();

            foreach (var r in cachedOpRegistrations.Where(x => !x.isdeleted))
            {
                var opIdStr = r.op_id.ToString();
                opByGuidMap[opIdStr] = r;

                if (r.booking_id.HasValue)
                {
                    opByGuidMap[r.booking_id.Value.ToString()] = r;
                }

                if (!string.IsNullOrWhiteSpace(r.op_no))
                {
                    opByNoMap[r.op_no.Trim()] = r;
                }

                if (r.custid > 0)
                {
                    var key = $"{r.custid}_{r.visit_date:yyyyMMdd}";
                    if (!opByCustDateMap.ContainsKey(key))
                    {
                        opByCustDateMap[key] = r;
                    }

                    if (!opByCustIdMap.ContainsKey(r.custid))
                    {
                        opByCustIdMap[r.custid] = r;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading OP registrations in CashCounter: {ex.Message}");
        }
    }

    private async Task LoadIpRegistrationsLookupAsync()
    {
        try
        {
            var admittedTask = IpService.GetIpRegistrationsAsync("ADMITTED");
            var dischargedTask = IpService.GetIpRegistrationsAsync("DISCHARGED");
            var activeAdmissionsTask = IpService.GetActiveAdmissionsAsync();

            await Task.WhenAll(admittedTask, dischargedTask, activeAdmissionsTask);

            var admitted = (await admittedTask) ?? new();
            var discharged = (await dischargedTask) ?? new();
            var active = (await activeAdmissionsTask) ?? new();

            cachedIpRegistrations = admitted
                .Concat(discharged)
                .Concat(active)
                .GroupBy(x => x.ip_id)
                .Select(g => g.First())
                .ToList();

            ipByGuidMap.Clear();
            ipByGuidStringMap.Clear();
            ipByNoMap.Clear();
            ipByCustIdMap.Clear();
            ipByNameMap.Clear();
            ipByMobileMap.Clear();

            foreach (var r in cachedIpRegistrations.Where(x => !x.isdeleted && !string.IsNullOrWhiteSpace(x.ip_no)))
            {
                var cleanIpNo = r.ip_no.Trim();

                if (r.ip_id != Guid.Empty)
                {
                    ipByGuidMap[r.ip_id] = r;
                    ipByGuidStringMap[r.ip_id.ToString()] = r;
                }

                ipByNoMap[cleanIpNo] = r;

                if (r.custid > 0 && !ipByCustIdMap.ContainsKey(r.custid))
                {
                    ipByCustIdMap[r.custid] = r;
                }

                var pName = r.GetPatientName();
                if (!string.IsNullOrWhiteSpace(pName))
                {
                    var nameKey = pName.Trim().ToLowerInvariant();
                    if (!ipByNameMap.ContainsKey(nameKey))
                    {
                        ipByNameMap[nameKey] = r;
                    }
                }

                if (!string.IsNullOrWhiteSpace(r.mobile))
                {
                    var mobKey = r.mobile.Trim();
                    if (!ipByMobileMap.ContainsKey(mobKey))
                    {
                        ipByMobileMap[mobKey] = r;
                    }
                }
            }
            Console.WriteLine($"[CashCounter] Successfully loaded {cachedIpRegistrations.Count} IP registrations for lookup");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading IP registrations in CashCounter: {ex.Message}");
        }
    }

    private OPRegistrationModel.OpRegistrationModel? FindMatchedOpRegistration(string? opvisitid, decimal? custid, DateTime? billDate)
    {
        if (!string.IsNullOrWhiteSpace(opvisitid))
        {
            var cleanId = opvisitid.Trim();
            if (opByGuidMap.TryGetValue(cleanId, out var reg1))
            {
                return reg1;
            }
            if (opByNoMap.TryGetValue(cleanId, out var reg2))
            {
                return reg2;
            }
        }

        if (custid.HasValue && custid.Value > 0 && billDate.HasValue)
        {
            var custDateKey = $"{custid.Value}_{billDate.Value:yyyyMMdd}";
            if (opByCustDateMap.TryGetValue(custDateKey, out var reg3))
            {
                return reg3;
            }
        }

        if (custid.HasValue && custid.Value > 0)
        {
            if (opByCustIdMap.TryGetValue(custid.Value, out var reg4))
            {
                return reg4;
            }
        }

        return null;
    }

    private string GetPatientIdentifyingNumber(HmsBillSummary bill)
    {
        // 1. If explicit ip_no / ipno from backend bill model
        if (!string.IsNullOrWhiteSpace(bill.ip_no))
        {
            return bill.ip_no.Trim();
        }
        if (!string.IsNullOrWhiteSpace(bill.ipno))
        {
            return bill.ipno.Trim();
        }

        // 2. If explicit op_no / opno from backend bill model
        if (!string.IsNullOrWhiteSpace(bill.op_no))
        {
            return bill.op_no.Trim();
        }
        if (!string.IsNullOrWhiteSpace(bill.opno))
        {
            return bill.opno.Trim();
        }

        // 3. If bill is linked to an IP admission via ip_id or ipid
        if (bill.ip_id.HasValue && bill.ip_id.Value != Guid.Empty)
        {
            if (ipByGuidMap.TryGetValue(bill.ip_id.Value, out var ipReg) && !string.IsNullOrWhiteSpace(ipReg.ip_no))
            {
                return ipReg.ip_no.Trim();
            }
        }
        if (!string.IsNullOrWhiteSpace(bill.ipid))
        {
            var cleanIpId = bill.ipid.Trim();
            if (Guid.TryParse(cleanIpId, out var parsedIpGuid) && ipByGuidMap.TryGetValue(parsedIpGuid, out var ipRegG))
            {
                return ipRegG.ip_no.Trim();
            }
            if (ipByGuidStringMap.TryGetValue(cleanIpId, out var ipRegS))
            {
                return ipRegS.ip_no.Trim();
            }
            if (ipByNoMap.TryGetValue(cleanIpId, out var ipRegN))
            {
                return ipRegN.ip_no.Trim();
            }
            if (cleanIpId.StartsWith("IP", StringComparison.OrdinalIgnoreCase))
            {
                return cleanIpId;
            }
        }

        // 4. Try matching OP registration via opvisitid or custid + bill_date or custid
        var matchedOp = FindMatchedOpRegistration(bill.opvisitid, bill.custid, bill.bill_date);
        if (matchedOp != null && !string.IsNullOrWhiteSpace(matchedOp.op_no))
        {
            return matchedOp.op_no.Trim();
        }

        // 5. If opvisitid itself looks like an IP or OP number
        if (!string.IsNullOrWhiteSpace(bill.opvisitid))
        {
            var cleanOpId = bill.opvisitid.Trim();
            if (cleanOpId.StartsWith("IP", StringComparison.OrdinalIgnoreCase))
            {
                return cleanOpId;
            }
            if (cleanOpId.Contains('/') || cleanOpId.StartsWith("OP", StringComparison.OrdinalIgnoreCase))
            {
                return cleanOpId;
            }
            if (Guid.TryParse(cleanOpId, out var opAsIpGuid) && ipByGuidMap.TryGetValue(opAsIpGuid, out var ipRegOp))
            {
                return ipRegOp.ip_no.Trim();
            }
        }

        // 6. Try matching IP registration via custid
        if (bill.custid.HasValue && bill.custid.Value > 0)
        {
            if (ipByCustIdMap.TryGetValue(bill.custid.Value, out var ipRegByCust) && !string.IsNullOrWhiteSpace(ipRegByCust.ip_no))
            {
                return ipRegByCust.ip_no.Trim();
            }
        }

        // 7. Try matching IP registration via mobileno
        if (!string.IsNullOrWhiteSpace(bill.mobileno))
        {
            var cleanMob = bill.mobileno.Trim();
            if (cleanMob.StartsWith("+91")) cleanMob = cleanMob.Substring(3).Trim();
            if (cleanMob.StartsWith("0") && cleanMob.Length > 10) cleanMob = cleanMob.Substring(1).Trim();
            if (ipByMobileMap.TryGetValue(cleanMob, out var ipRegByMob) && !string.IsNullOrWhiteSpace(ipRegByMob.ip_no))
            {
                return ipRegByMob.ip_no.Trim();
            }
            if (ipByMobileMap.TryGetValue(bill.mobileno.Trim(), out var ipRegByOrigMob) && !string.IsNullOrWhiteSpace(ipRegByOrigMob.ip_no))
            {
                return ipRegByOrigMob.ip_no.Trim();
            }
        }

        // 8. Try matching IP registration via patient_name
        if (!string.IsNullOrWhiteSpace(bill.patient_name))
        {
            var cleanName = bill.patient_name.Trim().ToLowerInvariant();
            if (ipByNameMap.TryGetValue(cleanName, out var ipRegByName) && !string.IsNullOrWhiteSpace(ipRegByName.ip_no))
            {
                return ipRegByName.ip_no.Trim();
            }
        }

        // 9. Fallback to custcode or custid
        if (!string.IsNullOrWhiteSpace(bill.custcode))
        {
            return bill.custcode.Trim();
        }

        if (bill.custid.HasValue && bill.custid.Value > 0)
        {
            return bill.custid.Value.ToString();
        }

        return "-";
    }

    private string GetPharmacyPatientIdentifyingNumber(sales_master s)
    {
        // 1. If patientid is provided and non-empty
        if (!string.IsNullOrWhiteSpace(s.patientid))
        {
            return s.patientid.Trim();
        }

        // 2. If customercode is available, try matching OP/IP registration
        if (s.customercode.HasValue && s.customercode.Value > 0)
        {
            decimal custid = (decimal)s.customercode.Value;
            if (opByCustIdMap.TryGetValue(custid, out var opReg) && !string.IsNullOrWhiteSpace(opReg.op_no))
            {
                return opReg.op_no.Trim();
            }
            if (ipByCustIdMap.TryGetValue(custid, out var ipReg) && !string.IsNullOrWhiteSpace(ipReg.ip_no))
            {
                return ipReg.ip_no.Trim();
            }
            return custid.ToString();
        }

        return "-";
    }

    private string GetDoctorName(int? dcode, string? fallbackName, string? opvisitid = null, decimal? custid = null, DateTime? billDate = null)
    {
        // 1. If explicit dcode > 0, match in doctorsList
        if (dcode.HasValue && dcode.Value > 0)
        {
            var doc = doctorsList.FirstOrDefault(d => d.dcode == dcode.Value);
            if (doc != null && !string.IsNullOrWhiteSpace(doc.name) && !doc.name.Trim().Equals("Self", StringComparison.OrdinalIgnoreCase))
            {
                var docName = doc.name.Trim();
                return docName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? docName : $"Dr. {docName}";
            }
        }

        // 2. If fallbackName is provided and is NOT "Self" or empty
        if (!string.IsNullOrWhiteSpace(fallbackName) && !fallbackName.Trim().Equals("Self", StringComparison.OrdinalIgnoreCase))
        {
            var fName = fallbackName.Trim();
            return fName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? fName : $"Dr. {fName}";
        }

        // 3. Attempt to resolve from linked OP Registration
        var matchedReg = FindMatchedOpRegistration(opvisitid, custid, billDate);
        if (matchedReg != null)
        {
            if (matchedReg.dcode > 0)
            {
                var doc = doctorsList.FirstOrDefault(d => d.dcode == matchedReg.dcode);
                if (doc != null && !string.IsNullOrWhiteSpace(doc.name) && !doc.name.Trim().Equals("Self", StringComparison.OrdinalIgnoreCase))
                {
                    var docName = doc.name.Trim();
                    return docName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? docName : $"Dr. {docName}";
                }
            }
            if (!string.IsNullOrWhiteSpace(matchedReg.doctor_name) && !matchedReg.doctor_name.Trim().Equals("Self", StringComparison.OrdinalIgnoreCase))
            {
                var docName = matchedReg.doctor_name.Trim();
                return docName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? docName : $"Dr. {docName}";
            }
        }

        // 4. If doctorsList has an active doctor, fallback to first active doctor instead of "Self"
        var defaultDoctor = doctorsList.FirstOrDefault(d => !d.deleted && !string.IsNullOrWhiteSpace(d.name) && !d.name.Trim().Equals("Self", StringComparison.OrdinalIgnoreCase))
                            ?? doctorsList.FirstOrDefault(d => !string.IsNullOrWhiteSpace(d.name) && !d.name.Trim().Equals("Self", StringComparison.OrdinalIgnoreCase));
        if (defaultDoctor != null && !string.IsNullOrWhiteSpace(defaultDoctor.name))
        {
            var docName = defaultDoctor.name.Trim();
            return docName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? docName : $"Dr. {docName}";
        }

        return !string.IsNullOrWhiteSpace(fallbackName) && !fallbackName.Trim().Equals("Self", StringComparison.OrdinalIgnoreCase)
            ? (fallbackName.Trim().StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ? fallbackName.Trim() : $"Dr. {fallbackName.Trim()}")
            : "Dr. Divakar Gnanasekaran";
    }

    private bool IsTodayBill(DateTime? billDate)
    {
        if (!billDate.HasValue || billDate.Value == default) return false;
        var istDate = DateTimeHelper.ConvertUtcToIst(billDate);
        var todayIst = DateTimeHelper.ConvertUtcToIst(DateTime.UtcNow)?.Date ?? DateTime.Today;
        if (istDate.HasValue && istDate.Value.Date == todayIst) return true;
        if (billDate.Value.Date == todayIst) return true;
        if (billDate.Value.Date == DateTime.Today) return true;
        return false;
    }

    private bool IsTodayPharmacyBill(sales_master? sale)
    {
        if (sale == null) return false;

        // Use the original entry date only. Later updates must not reopen collection.
        var entryDate = sale.createddate != default ? sale.createddate : sale.billdate;
        return IsTodayBill(entryDate);
    }

    private async Task ResetFiltersAsync()
    {
        filter = new HmsBillFilterRequest
        {
            page = 1,
            pagesize = 50,
            fromdate = null,
            todate = DateTime.Today
        };
        if (TenantState.BranchCode > 0) filter.bhcode = TenantState.BranchCode;
        statusFilter = "PENDING";
        pharmacyPage = 1;
        await SetDefaultCounterAsync();
        if (billingSource == "PHARMACY")
        {
            await LoadPharmacySalesAsync();
        }
        else
        {
            await LoadBillsAsync();
        }
    }

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (billingSource == "PHARMACY")
            {
                pharmacyPage = 1;
                StateHasChanged();
            }
            else
            {
                filter.page = 1;
                _ = LoadBillsAsync();
            }
        }
    }

    private async Task PrevPageAsync()
    {
        if (billingSource == "PHARMACY")
        {
            if (pharmacyPage > 1)
            {
                pharmacyPage--;
                StateHasChanged();
            }
        }
        else
        {
            if (filter.page > 1)
            {
                filter.page--;
                await LoadBillsAsync();
            }
        }
    }

    private async Task NextPageAsync()
    {
        if (billingSource == "PHARMACY")
        {
            if (pharmacyPage < TotalPharmacyPages)
            {
                pharmacyPage++;
                StateHasChanged();
            }
        }
        else
        {
            if (filter.page < TotalPages)
            {
                filter.page++;
                await LoadBillsAsync();
            }
        }
    }

    private async Task ChangePageSizeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            filter.pagesize = newSize;
            if (billingSource == "PHARMACY")
            {
                pharmacyPage = 1;
                StateHasChanged();
            }
            else
            {
                filter.page = 1;
                await LoadBillsAsync();
            }
        }
    }

    private async Task GoToPageAsync(int targetPage)
    {
        if (billingSource == "PHARMACY")
        {
            if (targetPage >= 1 && targetPage <= TotalPharmacyPages && targetPage != pharmacyPage)
            {
                pharmacyPage = targetPage;
                StateHasChanged();
            }
        }
        else
        {
            if (targetPage >= 1 && targetPage <= TotalPages && targetPage != filter.page)
            {
                filter.page = targetPage;
                await LoadBillsAsync();
            }
        }
    }

