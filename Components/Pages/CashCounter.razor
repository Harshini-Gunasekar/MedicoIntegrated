    private async Task LoadAdvanceDataAsync()
    {
        isLoadingAdvance = true;
        StateHasChanged();
        try
        {
            string tenantCode = TenantState?.TenantCode ?? "";
            var reqTask = DueCollectionService.GetAdvanceRequestsAsync(advanceRequestStatusFilter, advanceRequestFromDate, advanceRequestToDate);
            var sumTask = DueCollectionService.GetAdvanceRequestsSummaryAsync(advanceRequestFromDate, advanceRequestToDate);
            var refReqTask = DueCollectionService.GetRefundRequestsAsync(refundRequestStatusFilter);
            var refSumTask = DueCollectionService.GetRefundRequestsSummaryAsync();
            var depTask = DueCollectionService.GetPatientDepositsAsync(advanceBalanceStatusFilter, advancePatientSearchQuery, tenantCode);
            var refTask = DueCollectionService.GetRefundHistoryAsync(refundFromDate, refundToDate, refundSearchQuery, tenantCode);

            await Task.WhenAll(reqTask, sumTask, refReqTask, refSumTask, depTask, refTask);

            advanceRequestsList = await reqTask;
            advanceRequestsSummary = await sumTask;
            refundRequestsList = await refReqTask;
            refundRequestsSummary = await refSumTask;
            if (refundRequestsSummary.refunded_count == 0 && refundRequestsList.Any(r => r.status == "REFUNDED" || r.status == "COLLECTED"))
            {
                refundRequestsSummary.refunded_count = refundRequestsList.Count(r => r.status == "REFUNDED" || r.status == "COLLECTED");
                refundRequestsSummary.refunded_amount = refundRequestsList.Where(r => r.status == "REFUNDED" || r.status == "COLLECTED").Sum(r => r.amount);
            }

            var depResult = await depTask;
            advanceDepositsList = depResult.data;
            advanceDepositsSummary = depResult.summary;

            refundHistoryList = await refTask;

            var advCustids = advanceRequestsList.Where(r => r.custid > 0).Select(r => r.custid)
                .Concat(refundRequestsList.Where(r => r.custid > 0).Select(r => r.custid))
                .Concat(advanceDepositsList.Where(d => d.custid > 0).Select(d => (decimal)d.custid))
                .Concat(refundHistoryList.Where(h => h.custid > 0).Select(h => (decimal)h.custid))
                .Distinct().ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CashCounter] Error loading advance data: {ex.Message}");
        }
        finally
        {
            isLoadingAdvance = false;
            StateHasChanged();
        }
    }

