    private decimal TotalPharmacyBalance => FilteredPharmacySales.Where(s => !string.Equals(s.paymentstatus, "Paid", StringComparison.OrdinalIgnoreCase) && !string.Equals(s.paymentstatus, "Settled", StringComparison.OrdinalIgnoreCase)).Sum(s => s.netamount);

    private decimal TotalHospitalNet => totalHospitalNet > 0 ? totalHospitalNet : (billsList?.data?.Sum(b => (decimal)(b.net_amount ?? 0)) ?? 0);
    private decimal TotalHospitalBalance => (totalHospitalBalance > 0 || totalHospitalNet > 0) ? totalHospitalBalance : (billsList?.data?.Sum(b => (decimal)(b.balance_amount ?? Math.Max(0, (b.net_amount ?? 0) - (b.paid_amount ?? 0)))) ?? 0);

