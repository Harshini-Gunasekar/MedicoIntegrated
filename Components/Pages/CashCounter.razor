            return;
        }

        try
        {
            patientAdvanceSummary = await DueCollectionService.GetPatientAdvanceSummaryAsync(custId);
            if (patientAdvanceSummary != null)
            {
                double calculatedBal = patientAdvanceSummary.total_advance_deposited - patientAdvanceSummary.total_advance_used - patientAdvanceSummary.total_advance_refunded;
                patientAdvanceAvailable = patientAdvanceSummary.available_balance > 0 
                    ? patientAdvanceSummary.available_balance 
                    : Math.Max(0, calculatedBal);
            }
            else
            {
                patientAdvanceAvailable = 0;
            }
            
            AutoApplyAdvanceIfAvailable();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking patient advance in CashCounter: {ex.Message}");
            patientAdvanceAvailable = 0;
            patientAdvanceSummary = null;
        }
    }

    private void AutoApplyAdvanceIfAvailable()
    {
        if (selectedBill == null) return;
        double dueAmt = selectedBill.balance_amount ?? 0;

        if (patientAdvanceAvailable > 0 && dueAmt > 0)
        {
            var advancePm = paymodes.FirstOrDefault(p => 
                string.Equals(p.name, "ADVANCE", StringComparison.OrdinalIgnoreCase) || 
                string.Equals(p.shortname, "ADVANCE", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(p.shortname, "ADV", StringComparison.OrdinalIgnoreCase)
            );

            if (advancePm == null)
            {
                advancePm = new PaymodeMasterModel { pmcode = 99, shortname = "ADVANCE", name = "Advance" };
                if (!paymodes.Any(p => p.pmcode == 99))
                {
                    paymodes.Add(advancePm);
                }
            }

            paymentRequest.pmc1 = advancePm.pmcode;
            paymentRequest.pmc1_amount = Math.Min(dueAmt, patientAdvanceAvailable);
            paymentRequest.amount = paymentRequest.pmc1_amount.Value;
            RecalculatePaymentTotals();
        }
    }

    private int TotalPages => billsList != null ? (int)Math.Ceiling((double)billsList.total / filter.pagesize) : 0;

    private bool hasCreateRight = false;
    private bool hasEditRight = false;
    private bool hasDeleteRight = false;
    private bool hasViewRight = true;
    private System.Threading.Timer? receiveCutoffTimer;

    protected override async Task OnInitializedAsync()
    {
        RoleService.OnPermissionsChanged += HandlePermissionsChanged;
        EvaluateRights();

        filter.fromdate = null;
        filter.todate = DateTime.Today;

        if (hasViewRight)
        {
            receiveCutoffTimer = new System.Threading.Timer(
                _ => _ = InvokeAsync(StateHasChanged),
                null,
                TimeSpan.FromSeconds(30),
                TimeSpan.FromSeconds(30));

            await Task.WhenAll(
                LoadBranchesAsync(),
                LoadCountersAsync(),
                LoadPaymodesAsync(),
                LoadPharmacySalesAsync(),
                LoadDoctorsAsync(),
                LoadOpRegistrationsLookupAsync(),
                LoadIpRegistrationsLookupAsync(),
                LoadDueTotalsAsync(),
                LoadAdvanceDataAsync()
            );

            if (TenantState.BranchCode > 0) filter.bhcode = TenantState.BranchCode;

            await SetDefaultCounterAsync();

            await LoadBillsAsync();
        }
    }

    private void EvaluateRights()
    {
        bool isAdmin = Booking.Helpers.UserPermissionHelper.IsAdmin(null, TenantState);
        if (isAdmin)
        {
            hasViewRight = true;
            hasCreateRight = true;
            hasEditRight = true;
            hasDeleteRight = true;
            return;
        }

        hasViewRight = RoleService.HasPermission(507) ||
                       RoleService.HasRight("Billing Portal", "Cash Counter") ||
                       TenantState.HasActionRight("Billing Portal", "Cash Counter", "View") ||
                       TenantState.HasActionRight("Billing", "Cash Counter", "View");

        hasCreateRight = RoleService.HasPermission(508) ||
                         RoleService.HasAction("Billing Portal", "Cash Counter", "Create") ||
                         TenantState.HasActionRight("Billing Portal", "Cash Counter", "Create") ||
                         TenantState.HasActionRight("Billing", "Cash Counter", "Create");

        hasEditRight = hasCreateRight;
        hasDeleteRight = RoleService.HasAction("Billing Portal", "Cash Counter", "Delete") ||
                         TenantState.HasActionRight("Billing Portal", "Cash Counter", "Delete") ||
                         TenantState.HasActionRight("Billing", "Cash Counter", "Delete");
    }

    private void HandlePermissionsChanged()
    {
        InvokeAsync(async () =>
        {
            bool prevCanView = hasViewRight;
            EvaluateRights();
            if (prevCanView != hasViewRight && hasViewRight)
            {
                await Task.WhenAll(
                    LoadBranchesAsync(),
                    LoadCountersAsync(),
                    LoadPaymodesAsync(),
                    LoadPharmacySalesAsync(),
                    LoadDoctorsAsync(),
                    LoadOpRegistrationsLookupAsync(),
                    LoadIpRegistrationsLookupAsync(),
                    LoadDueTotalsAsync(),
                LoadAdvanceDataAsync()
                );
                await SetDefaultCounterAsync();
                await LoadBillsAsync();
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        RoleService.OnPermissionsChanged -= HandlePermissionsChanged;
        receiveCutoffTimer?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!RoleService.IsPermissionsLoaded && !Booking.Helpers.UserPermissionHelper.IsAdmin(null, TenantState))
            {
                try
                {
                    var sessionPerms = await _sessionStorage.GetAsync<List<RolePermissionItem>>("UserRolePermissions");
                    if (sessionPerms.Success && sessionPerms.Value != null && sessionPerms.Value.Any())
                    {
                        RoleService.SetUserPermissions(sessionPerms.Value);
                    }
                    else if (TenantState.UserCode > 0)
                    {
                        await RoleService.LoadUserPermissionsAsync(TenantState.UserCode, TenantState.TenantCode);
                    }
                }
                catch
                {
                    if (TenantState.UserCode > 0)
                    {
                        await RoleService.LoadUserPermissionsAsync(TenantState.UserCode, TenantState.TenantCode);
                    }
                }
            }

            EvaluateRights();

            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                DefaultTenant = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";
                if (string.IsNullOrWhiteSpace(DefaultTenant) && !string.IsNullOrWhiteSpace(TenantState?.TenantCode))
                {
                    DefaultTenant = TenantState.TenantCode;
                }

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                if (!tokenResult.Success || string.IsNullOrEmpty(tokenResult.Value))
                {
                    tokenResult = await _sessionStorage.GetAsync<string>("auth_token");
                }
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : (TenantState?.AuthToken ?? "");

                if (hasViewRight)
                {
                    await LoadPharmacySalesAsync();
                }
                StateHasChanged();
            }
            catch { }
        }
    }

    private IEnumerable<CounterMasterModel> GetFilteredCounters()
    {
        if (counters == null || !counters.Any()) return Enumerable.Empty<CounterMasterModel>();

        var filtered = counters.Where(x => filter.bhcode == null || filter.bhcode == 0 || x.bhcode == filter.bhcode || x.bhcode == 0 || x.bhcode == null).ToList();
        if (!filtered.Any())
        {
            filtered = counters.ToList();
        }
        return filtered;
    }

    private async Task SetDefaultCounterAsync()
    {
        var available = GetFilteredCounters().ToList();
        if (!available.Any()) return;

        // 1. Try saved counter code from Session Storage
        try
        {
            var cntResult = await _sessionStorage.GetAsync<string>("cntcode");
            if (cntResult.Success && !string.IsNullOrEmpty(cntResult.Value) && int.TryParse(cntResult.Value, out int savedCnt) && savedCnt > 0)
            {
                if (available.Any(c => c.cntcode == savedCnt))
                {
                    filter.cntcode = savedCnt;
                    return;
                }
            }
        }
        catch { }

        // 2. Try TenantState.CounterCode
        if (TenantState.CounterCode.HasValue && TenantState.CounterCode.Value > 0)
        {
            int tenantCnt = TenantState.CounterCode.Value;
            if (available.Any(c => c.cntcode == tenantCnt))
            {
                filter.cntcode = tenantCnt;
                return;
            }
        }

        // 3. Fallback to first available counter
        filter.cntcode = (int)available.First().cntcode;
    }

    private async Task OnBranchFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int bhCode) && bhCode > 0)
        {
            filter.bhcode = bhCode;
        }
        else
        {
            filter.bhcode = null;
        }

        var available = GetFilteredCounters().ToList();
        if (!available.Any(c => c.cntcode == filter.cntcode))
        {
            await SetDefaultCounterAsync();
        }

        filter.page = 1;
        await LoadBillsAsync();
    }

    private async Task OnCounterFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int cntCode) && cntCode > 0)
        {
            filter.cntcode = cntCode;
            try
            {
                await _sessionStorage.SetAsync("cntcode", cntCode.ToString());
            }
            catch { }
        }
        else
        {
            await SetDefaultCounterAsync();
        }
        filter.page = 1;
        await LoadBillsAsync();
    }

    private async Task LoadBillsAsync()
    {
        if (billingSource == "PHARMACY")
        {
            pharmacyPage = 1;
            await LoadPharmacySalesAsync();
            return;
        }

        isLoading = true;
        StateHasChanged();

        if (!cachedOpRegistrations.Any())
        {
            await LoadOpRegistrationsLookupAsync();
        }
        if (!cachedIpRegistrations.Any())
        {
            await LoadIpRegistrationsLookupAsync();
        }
        if (!doctorsList.Any())
        {
            await LoadDoctorsAsync();
        }

        try
        {
            // Apply report type toggles to the filter request model
            if (statusFilter == "PENDING")
            {
                filter.pendingonly = true;
                filter.iscashbill = null;
                filter.iscreditbill = null;
            }
            else if (statusFilter == "SETTLED")
            {
                filter.pendingonly = false;
                filter.iscashbill = true;
                filter.iscreditbill = null;
            }
            else
            {
                filter.pendingonly = null;
                filter.iscashbill = null;
                filter.iscreditbill = null;
            }

            billsList = await HmsBillingService.ListBillsAsync(filter);
            await Task.WhenAll(LoadHospitalTotalsAsync(), LoadDueTotalsAsync());
            if (isPayModeSelected)
            {
                await LoadPayModeCollectionAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading bills: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadDueTotalsAsync()
    {
        try
        {
            var req = new HmsPaidHistoryFilterRequest
            {
                bhcode = filter.bhcode > 0 ? filter.bhcode : null,
                cntcode = filter.cntcode > 0 ? filter.cntcode : null,
                fromdate = filter.fromdate,
                todate = filter.todate,
                receipt_type = "DUE", // strictly DUE alone (from Due Collection history page)
                page = 1,
                pagesize = 10000
            };

            var res = await DueCollectionService.GetPaidHistoryAsync(req);
            if (res != null && res.success)
            {
                if (res.summary != null && (res.summary.total_due_collected > 0 || res.summary.net_collected > 0))
                {
                    totalDueAmount = res.summary.total_due_collected > 0
                        ? (decimal)res.summary.total_due_collected
                        : (decimal)res.summary.net_collected;
                }
                else if (res.data != null && res.data.Any())
                {
                    totalDueAmount = (decimal)res.data.Sum(r => r.amount ?? 0);
                }
                else
                {
                    totalDueAmount = 0;
                }
            }
            else
            {
                totalDueAmount = 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CashCounter] Error calculating due collected totals: {ex.Message}");
            totalDueAmount = 0;
        }
    }

    private async Task LoadHospitalTotalsAsync()
    {
        try
        {
            var totalsFilter = new HmsBillFilterRequest
            {
                bhcode = filter.bhcode.HasValue && filter.bhcode.Value > 0 ? filter.bhcode.Value : null,
                cntcode = filter.cntcode.HasValue && filter.cntcode.Value > 0 ? filter.cntcode.Value : null,
                fromdate = filter.fromdate,
                todate = filter.todate,
                pendingonly = null, // Fetch all bills for the selected date range to compute total amount paid in hospital bills
                iscashbill = null,
                iscreditbill = null,
                search = null,
                page = 1,
                pagesize = 10000
            };

            var allBills = await HmsBillingService.ListBillsAsync(totalsFilter);
            if (allBills?.data != null && allBills.data.Any())
            {
                totalHospitalNet = (decimal)allBills.data.Sum(b => (b.net_amount ?? 0));
                totalHospitalPaid = (decimal)allBills.data.Sum(b => (b.paid_amount ?? 0));
                totalHospitalBalance = (decimal)allBills.data.Sum(b => (b.balance_amount ?? Math.Max(0, (b.net_amount ?? 0) - (b.paid_amount ?? 0))));
            }
            else
            {
                totalHospitalNet = 0;
                totalHospitalPaid = 0;
                totalHospitalBalance = 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating hospital totals: {ex.Message}");
            totalHospitalPaid = 0;
            totalHospitalNet = 0;
            totalHospitalBalance = 0;
        }
    }

