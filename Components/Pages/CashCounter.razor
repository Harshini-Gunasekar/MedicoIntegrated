@page "/cash-counter"
@rendermode InteractiveServer
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.CounterMasterService CounterMasterService
@inject Booking.Services.PaymodeMasterService PaymodeMasterService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Booking.Services.ToastService ToastService
@inject IHttpClientFactory ClientFactory
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@using Booking.Models
@using Newtonsoft.Json
@using Booking.Helpers
@using Medico_Backend.Model

<div class="cash-counter-wrapper">
    <!-- Header -->
    <div class="page-header">
        <div class="header-title-container">
            <div class="header-icon">
                <i class="bi bi-cash-coin"></i>
            </div>
            <div>
                <h1 class="header-title">Cash Counter Portal</h1>
                <p class="header-subtitle">Manage counter-wise collections, list bills, and process payments</p>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="filter-card">
        <div class="filter-grid">
            <div class="filter-item">
                <label>BRANCH</label>
                <select class="form-select" @bind="filter.bhcode">
                    <option value="">All Branches</option>
                    @foreach (var b in branches)
                    {
                        <option value="@b.bh_code">@b.name</option>
                    }
                </select>
            </div>

            <div class="filter-item">
                <label>COUNTER</label>
                <select class="form-select" @bind="filter.cntcode">
                    <option value="">All Counters</option>
                    @foreach (var c in counters)
                    {
                        <option value="@((int)c.cntcode)">@c.name</option>
                    }
                </select>
            </div>

            <div class="filter-item">
                <label>FROM DATE</label>
                <input type="date" class="form-control" @bind="filter.fromdate" />
            </div>

            <div class="filter-item">
                <label>TO DATE</label>
                <input type="date" class="form-control" @bind="filter.todate" />
            </div>

            <div class="filter-item">
                <label>PAYMENT STATUS</label>
                <select class="form-select" @bind="statusFilter">
                    <option value="ALL">All Bills</option>
                    <option value="PENDING">Pending Only</option>
                    <option value="SETTLED">Settled Only</option>
                </select>
            </div>

            <div class="filter-item search-item">
                <label>PATIENT SEARCH</label>
                <div class="search-input-wrapper">
                    <input type="text" class="form-control" @bind="filter.search" placeholder="Name, ID or Mobile..." @onkeyup="HandleSearchKeyUp" />
                    <i class="bi bi-search search-icon"></i>
                </div>
            </div>
            <div class="filter-item action-item">
                <div class="filter-actions-inline">
                    <button class="btn-primary" @onclick="LoadBillsAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Searching...</span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                            <span>Search</span>
                        }
                    </button>
                    <button class="btn-secondary" @onclick="ResetFiltersAsync" disabled="@isLoading">
                        <i class="bi bi-arrow-clockwise"></i>
                        <span>Reset</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bills Table Card -->
    <div class="table-card">
        <div class="table-header">
            <h2 class="table-title">Bills List</h2>
            <div class="table-actions">
                <span class="record-count">Total: @(billsList?.total ?? 0) bills</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">S.NO</th>
                        <th>BILL NO</th>
                        <th>DATE</th>
                        <th>PATIENT NAME</th>
                        <th>MOBILE</th>
                        <th>REF. DOCTOR</th>
                        <th class="text-end">GROSS</th>
                        <th class="text-end">DISC</th>
                        <th class="text-end">NET</th>
                        <th class="text-end">PAID</th>
                        <th class="text-end">BALANCE</th>
                        <th class="text-center" style="width: 100px;">STATUS</th>
                        <th class="text-center" style="width: 130px;">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="13" class="text-center py-5">
                                <div class="spinner-container">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <p class="mt-2">Loading bills list...</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (billsList == null || !billsList.data.Any())
                    {
                        <tr>
                            <td colspan="13" class="text-center py-5 text-muted">
                                <i class="bi bi-receipt-cutoff" style="font-size: 2.5rem; color: #94a3b8; display: block; margin-bottom: 0.5rem;"></i>
                                No bills found matching the selected criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int sno = (filter.page - 1) * filter.pagesize + 1;
                        @foreach (var bill in billsList.data)
                        {
                            var balance = bill.balance_amount ?? 0;
                            var isSettled = bill.is_settled || balance <= 0;
                            <tr>
                                <td>@(sno++)</td>
                                <td class="bill-no">@bill.bill_no</td>
                                <td>@(DateTimeHelper.ConvertUtcToIst(bill.bill_date)?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</td>
                                <td class="patient-name">@bill.patient_name</td>
                                <td class="patient-phone">@bill.mobileno</td>
                                <td>Dr. @(string.IsNullOrWhiteSpace(bill.doctor_name) ? "Self" : bill.doctor_name)</td>
                                <td class="text-end font-numeric">@(bill.gross_amount?.ToString("0.00") ?? "0.00")</td>
                                <td class="text-end font-numeric">@(bill.discount_amount?.ToString("0.00") ?? "0.00")</td>
                                <td class="text-end font-numeric font-bold">@(bill.net_amount?.ToString("0.00") ?? "0.00")</td>
                                <td class="text-end font-numeric text-success">@(bill.paid_amount?.ToString("0.00") ?? "0.00")</td>
                                <td class="text-end font-numeric text-danger font-bold">@(balance.ToString("0.00"))</td>
                                <td class="text-center">
                                    <span class="status-badge @(isSettled ? "settled" : "pending")">
                                        @(isSettled ? "Settled" : "Pending")
                                    </span>
                                </td>
                                 <td class="text-center">
                                    @if (!isSettled && hasEditRight)
                                    {
                                        <button class="btn-action pay" @onclick="() => OpenPaymentModal(bill)" title="Receive Payment">
                                            <i class="bi bi-wallet2"></i> Receive
                                        </button>
                                    }
                                    else if (!isSettled)
                                    {
                                        <span class="text-slate-400"><i class="bi bi-lock-fill"></i> No Access</span>
                                    }
                                    else
                                    {
                                        <span class="text-success-bold"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                    }
                                 </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (billsList != null && billsList.total > filter.pagesize)
        {
            <div class="pagination-container">
                <button class="pagination-btn" @onclick="PrevPageAsync" disabled="@(filter.page <= 1)">
                    <i class="bi bi-chevron-left"></i> Prev
                </button>
                <span class="pagination-info">Page @filter.page of @TotalPages</span>
                <button class="pagination-btn" @onclick="NextPageAsync" disabled="@(filter.page >= TotalPages)">
                    Next <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        }
    </div>
</div>

<!-- Add Payment Modal -->
@if (showPaymentModal && selectedBill != null)
{
    var dueAmt = selectedBill.balance_amount ?? 0;
    var netAmt = selectedBill.net_amount ?? 0;
    var paidAmt = selectedBill.paid_amount ?? 0;

    <div class="modal-backdrop" @onclick="ClosePaymentModal"></div>
    <div class="payment-modal animated-modal">
        <div class="modal-header-gradient">
            <div class="modal-header-left">
                <div class="modal-header-icon">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <h3 class="modal-title-text">Cash Counter Payment</h3>
                    <p class="modal-subtitle-text">Process bill settlement and paymode allocations</p>
                </div>
            </div>
            <button class="modal-close-icon-btn" @onclick="ClosePaymentModal" title="Close Modal">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="modal-body-custom">
            <!-- Hero Summary Header Card -->
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 1.25rem 1.75rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; width: 100%;">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; letter-spacing: 0.05em; text-transform: uppercase;">BILL NO:</span>
                    <span style="font-size: 0.85rem; font-weight: 700; color: #4f46e5; background: #e0e7ff; padding: 0.25rem 0.75rem; border-radius: 8px; font-family: monospace; border: 1px solid #c7d2fe;">@selectedBill.bill_no</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; letter-spacing: 0.05em; text-transform: uppercase;">PATIENT NAME:</span>
                    <span style="font-size: 1.05rem; font-weight: 800; color: #0f172a;">@selectedBill.patient_name</span>
                </div>
            </div>

            <EditForm Model="@paymentRequest" OnValidSubmit="SubmitPaymentAsync" class="payment-form">
                <!-- Form Fields 2-Column Grid -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 1.5rem; margin-bottom: 1.5rem;">
                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.75rem; font-weight: 700; color: #475569; letter-spacing: 0.03em; display: flex; align-items: center; gap: 0.25rem;">
                            <i class="bi bi-pc-display text-slate-500"></i> COUNTER CODE<span style="color: #ef4444;">*</span>
                        </label>
                        <select class="form-select" style="height: 42px; border-radius: 12px; border: 1px solid #cbd5e1; font-weight: 700; color: #0f172a; text-align: center; text-align-last: center; padding: 0.375rem 0.75rem;" @bind="paymentRequest.cntcode" required>
                            <option value="">Select Counter</option>
                            @foreach (var c in counters)
                            {
                                <option value="@((int)c.cntcode)">@c.name</option>
                            }
                        </select>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.75rem; font-weight: 700; color: #475569; letter-spacing: 0.03em; display: flex; align-items: center; gap: 0.25rem;">
                            <i class="bi bi-building text-slate-500"></i> COUNTER BRANCH<span style="color: #ef4444;">*</span>
                        </label>
                        <select class="form-select" style="height: 42px; border-radius: 12px; border: 1px solid #cbd5e1; font-weight: 700; color: #0f172a; text-align: center; text-align-last: center; padding: 0.375rem 0.75rem;" @bind="paymentRequest.enteredbhcode" required>
                            <option value="">Select Branch</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.bh_code">@b.name</option>
                            }
                        </select>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.75rem; font-weight: 700; color: #475569; letter-spacing: 0.03em; display: flex; align-items: center; gap: 0.25rem;">
                            <i class="bi bi-hash text-slate-500"></i> REFERENCE NO / TXN ID
                        </label>
                        <input type="text" class="form-control" style="height: 42px; border-radius: 12px; border: 1px solid #cbd5e1; font-weight: 700; color: #0f172a; text-align: center; padding: 0.375rem 0.75rem;" @bind="paymentRequest.reference_no" placeholder="e.g. APRV-88421" />
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <label style="font-size: 0.75rem; font-weight: 700; color: #475569; letter-spacing: 0.03em; display: flex; align-items: center; gap: 0.25rem;">
                            <i class="bi bi-bank text-slate-500"></i> BANK NAME
                        </label>
                        <input type="text" class="form-control" style="height: 42px; border-radius: 12px; border: 1px solid #cbd5e1; font-weight: 700; color: #0f172a; text-align: center; padding: 0.375rem 0.75rem;" @bind="paymentRequest.bank_name" placeholder="e.g. HDFC Bank" />
                    </div>
                </div>

                <!-- Net Payable Row -->
                <div style="padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; margin-top: 0.5rem;">
                    <span style="font-weight: 700; color: #1e293b; font-size: 0.95rem; text-transform: uppercase;">NET PAYABLE</span>
                    <span style="font-weight: 800; color: #6366f1; font-size: 1.25rem;">₹ @dueAmt.ToString("F2")</span>
                </div>

                <!-- Payment Box (Dynamic Paymodes Dropdowns) -->
                <div style="margin: 1rem 0; background: #f8faff; border-radius: 12px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
                    <!-- Paymode Option 1 -->
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                        <select class="form-select" style="flex: 1; height: 34px; font-size: 0.8rem; font-weight: 600; padding: 2px 8px; border: 1px solid #cbd5e1; border-radius: 8px;" @bind="paymentRequest.pmc1" @bind:after="RecalculatePaymentTotals">
                            <option value="">Select Paymode 1</option>
                            @foreach (var pm in paymodes)
                            {
                                <option value="@pm.pmcode">@pm.name</option>
                            }
                        </select>
                        <input type="number" style="width: 100px; text-align: right; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.3rem 0.5rem; height: 34px; font-weight: 700; color: #0f172a; box-shadow: 0 1px 2px rgba(0,0,0,0.05);" @bind="paymentRequest.pmc1_amount" @bind:after="RecalculatePaymentTotals" placeholder="0" />
                        <button type="button" style="border: none; background: #fef2f2; color: #ef4444; border-radius: 50%; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.85rem;" @onclick="ClearPaymode1" title="Clear Paymode 1">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                    <!-- Paymode Option 2 -->
                    @if (showPaymode2)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                            <select class="form-select" style="flex: 1; height: 34px; font-size: 0.8rem; font-weight: 600; padding: 2px 8px; border: 1px solid #cbd5e1; border-radius: 8px;" @bind="paymentRequest.pmc2" @bind:after="RecalculatePaymentTotals">
                                <option value="">Select Paymode 2</option>
                                @foreach (var pm in paymodes)
                                {
                                    <option value="@pm.pmcode">@pm.name</option>
                                }
                            </select>
                            <input type="number" style="width: 100px; text-align: right; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.3rem 0.5rem; height: 34px; font-weight: 700; color: #0f172a; box-shadow: 0 1px 2px rgba(0,0,0,0.05);" @bind="paymentRequest.pmc2_amount" @bind:after="RecalculatePaymentTotals" placeholder="0" />
                            <button type="button" style="border: none; background: #fef2f2; color: #ef4444; border-radius: 50%; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.85rem;" @onclick="ClearPaymode2" title="Clear Paymode 2">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    }

                    <!-- Paymode Option 3 -->
                    @if (showPaymode3)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                            <select class="form-select" style="flex: 1; height: 34px; font-size: 0.8rem; font-weight: 600; padding: 2px 8px; border: 1px solid #cbd5e1; border-radius: 8px;" @bind="paymentRequest.pmc3" @bind:after="RecalculatePaymentTotals">
                                <option value="">Select Paymode 3</option>
                                @foreach (var pm in paymodes)
                                {
                                    <option value="@pm.pmcode">@pm.name</option>
                                }
                            </select>
                            <input type="number" style="width: 100px; text-align: right; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.3rem 0.5rem; height: 34px; font-weight: 700; color: #0f172a; box-shadow: 0 1px 2px rgba(0,0,0,0.05);" @bind="paymentRequest.pmc3_amount" @bind:after="RecalculatePaymentTotals" placeholder="0" />
                            <button type="button" style="border: none; background: #fef2f2; color: #ef4444; border-radius: 50%; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.85rem;" @onclick="ClearPaymode3" title="Clear Paymode 3">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    }

                    @if (!showPaymode2 || !showPaymode3)
                    {
                        <div style="display: flex; justify-content: center; width: 100%;">
                            <button type="button" style="background: #e0e7ff; color: #4f46e5; border: none; border-radius: 8px; padding: 0.35rem 0.75rem; font-size: 0.75rem; font-weight: 700; display: flex; align-items: center; gap: 0.25rem; cursor: pointer; margin-top: 0.25rem;" @onclick="AddPaymode">
                                <i class="bi bi-plus-lg"></i> Add Paymode
                            </button>
                        </div>
                    }
                </div>

                <!-- Balance Due Row -->
                <div style="padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e2e8f0;">
                    @if (paymentRequest.amount > dueAmt)
                    {
                        <span style="font-weight: 700; color: #ef4444; font-size: 0.85rem; text-transform: uppercase;">RETURN BALANCE</span>
                        <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.15rem;">
                            <span style="font-weight: 800; color: #ef4444; font-size: 1.15rem;">₹ @((paymentRequest.amount - dueAmt).ToString("F2"))</span>
                            <span style="font-size: 0.6rem; font-weight: 700; color: #ef4444; background: #fee2e2; padding: 0.1rem 0.3rem; border-radius: 4px; text-transform: uppercase;">Change Owed</span>
                        </div>
                    }
                    else
                    {
                        <span style="font-weight: 700; color: #475569; font-size: 0.85rem; text-transform: uppercase;">BALANCE DUE</span>
                        @if (dueAmt - paymentRequest.amount <= 0)
                        {
                            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.15rem;">
                                <span style="font-weight: 800; color: #10b981; font-size: 1.15rem;">₹ 0.00</span>
                                <span style="font-size: 0.6rem; font-weight: 700; color: #10b981; background: #e6f4ea; padding: 0.1rem 0.3rem; border-radius: 4px; text-transform: uppercase;">Fully Settled</span>
                            </div>
                        }
                        else
                        {
                            <span style="font-weight: 800; color: #f97316; font-size: 1.15rem;">₹ @((dueAmt - paymentRequest.amount).ToString("F2"))</span>
                        }
                    }
                </div>

                <!-- Total Amount Paid Box -->
                <div style="background: #4f46e5; padding: 0.75rem 1rem; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <span style="font-weight: 700; color: #ffffff; font-size: 0.9rem; text-transform: uppercase;">TOTAL AMOUNT PAID</span>
                    <span style="font-weight: 800; color: #ffffff; font-size: 1.25rem;">₹ @paymentRequest.amount.ToString("F2")</span>
                </div>



                <!-- Actions -->
                <div class="modal-footer-actions">
                    <button type="button" class="btn-modal-cancel" @onclick="ClosePaymentModal" disabled="@paymentSaving">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </button>
                    <button type="submit" class="btn-modal-submit" disabled="@(paymentSaving || paymentRequest.amount <= 0)">
                        @if (paymentSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span> Processing...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle-fill me-1"></i>
                            <span>Confirm & Add Payment</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private HmsBillFilterRequest filter = new() { page = 1, pagesize = 50 };
    private HmsBillListResponse? billsList;
    private List<Booking.Models.BranchModel> branches = new();
    private List<CounterMasterModel> counters = new();
    private List<PaymodeMasterModel> paymodes = new();
    private bool isLoading = false;
    private string statusFilter = "ALL"; // Default to all bills

    // Add Payment Modal State
    private bool showPaymentModal = false;
    private HmsBillSummary? selectedBill;
    private HmsPaymentRequest paymentRequest = new();
    private bool paymentSaving = false;
    private bool showPaymode2 = false;
    private bool showPaymode3 = false;

    private int TotalPages => billsList != null ? (int)Math.Ceiling((double)billsList.total / filter.pagesize) : 0;

    private bool hasCreateRight = false;
    private bool hasEditRight = false;
    private bool hasDeleteRight = false;
    private bool hasViewRight = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            bool isAdmin = false;
            try
            {
                var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null)
                    isAdmin = string.Equals(userResult.Value.Role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
                              userResult.Value.UserCode == 0 || userResult.Value.UserCode == 1;
            }
            catch { }

            if (isAdmin)
            {
                hasViewRight = true;
                hasCreateRight = true;
                hasEditRight = true;
                hasDeleteRight = true;
            }
            else
            {
                var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                if (rightsResult.Success && rightsResult.Value != null)
                {
                    var pageRight = rightsResult.Value.FirstOrDefault(r =>
                        r.ModuleName != null && r.ModuleName.Trim().Equals("Cash_Counter", StringComparison.OrdinalIgnoreCase));
                    if (pageRight != null)
                    {
                        hasViewRight = pageRight.ToView;
                        hasCreateRight = pageRight.ToAdd;
                        hasEditRight = pageRight.ToEdit;
                        hasDeleteRight = pageRight.ToDelete;
                    }
                    else { hasViewRight = false; hasCreateRight = false; hasEditRight = false; hasDeleteRight = false; }
                }
                else { hasViewRight = false; hasCreateRight = false; hasEditRight = false; hasDeleteRight = false; }

                if (!hasViewRight)
                {
                    ToastService.ShowError("You do not have permission to access Cash Counter.");
                    Navigation.NavigateTo("/home");
                    return;
                }
            }
        }
        catch { }

        filter.fromdate = null;
        filter.todate = null;

        await Task.WhenAll(
            LoadBranchesAsync(),
            LoadCountersAsync(),
            LoadPaymodesAsync()
        );

        // Prepopulate filter counter from tenant state if available
        if (TenantState.BranchCode > 0) filter.bhcode = TenantState.BranchCode;

        await LoadBillsAsync();
    }

    private async Task LoadBillsAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Apply report type toggles to the filter request model
            if (statusFilter == "PENDING")
            {
                filter.pendingonly = true;
                filter.iscashbill = null;
                filter.iscreditbill = null;
            }
            else if (statusFilter == "SETTLED")
            {
                filter.pendingonly = false;
                filter.iscashbill = true;
                filter.iscreditbill = null;
            }
            else
            {
                filter.pendingonly = null;
                filter.iscashbill = null;
                filter.iscreditbill = null;
            }

            billsList = await HmsBillingService.ListBillsAsync(filter);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading bills: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

