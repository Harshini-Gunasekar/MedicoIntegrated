                                <label class="form-label fw-bold small text-secondary">REFUND AMOUNT (&#8377;) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">&#8377;</span>
                                    <input type="number" step="0.01" min="0.01" max="@(directRefundPatientSummary?.available_balance ?? 999999)" class="form-control fs-5 fw-bold text-danger" @bind="tabDirectRefundModel.refund_amount" required />
