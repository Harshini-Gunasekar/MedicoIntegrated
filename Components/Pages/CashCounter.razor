                <div>
                    <h3 class="modal-title-text" style="color: #ffffff; margin: 0; font-size: 1.15rem; font-weight: 800;">Patient Advance Ledger</h3>
                    <p class="modal-subtitle-text" style="color: #e0f2fe; margin: 0; font-size: 0.78rem;">UHID: @(!string.IsNullOrWhiteSpace(ledgerCustCode) ? ledgerCustCode : ledgerCustId.ToString()) &bull; Patient: @ledgerPatientName</p>
                </div>
            </div>
            <div style="display: flex; align-items: center; gap: 0.65rem;">
                <button type="button" class="btn btn-sm btn-light fw-bold" style="border-radius: 8px; font-size: 0.8rem; display: flex; align-items: center; gap: 5px; color: #0284c7; background: #ffffff; border: 1px solid #bae6fd; padding: 0.35rem 0.75rem;" @onclick="() => PrintAllPatientAdvanceReceiptsAsync(ledgerCustId, ledgerPatientName)" disabled="@(printingBillKey == $"ALL_{ledgerCustId}")" title="Preview & Print Full Statement">
                    @if (printingBillKey == $"ALL_{ledgerCustId}")
                    {
                        <span class="spinner-border spinner-border-sm" role="status" style="width: 11px; height: 11px; border-width: 1.5px;"></span>
                    }
                    else
                    {
                        <i class="bi bi-printer-fill"></i>
                    }
                    <span>Print Statement</span>
                </button>
                <button class="modal-close-icon-btn" @onclick="CloseLedgerDrawer" title="Close" style="color: #ffffff; background: rgba(255, 255, 255, 0.15); border: none; border-radius: 8px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer;">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <div class="modal-body-custom" style="padding: 1.25rem; overflow-y: auto; max-height: calc(85vh - 130px);">
            @if (isLoadingLedger)
            {
                <div class="text-center py-5">
                    <span class="spinner-border text-primary" role="status"></span>
                    <p class="text-muted mt-2">Loading ledger records...</p>
                </div>
            }
            else if (patientLedgerData != null)
            {
                <!-- Summary bar -->
                <div class="drawer-summary-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.65rem; margin-bottom: 1.25rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 0.85rem;">
                    <div class="d-kpi">
                        <span class="d-label small text-muted d-block fw-semibold">Total Deposited</span>
                        <span class="d-val text-primary fw-bold fs-6">&#8377;@patientLedgerData.total_advance_deposited.ToString("N2")</span>
                    </div>
                    <div class="d-kpi">
                        <span class="d-label small text-muted d-block fw-semibold">Total Used</span>
                        <span class="d-val text-secondary fw-bold fs-6">&#8377;@patientLedgerData.total_advance_used.ToString("N2")</span>
                    </div>
                    <div class="d-kpi">
                        <span class="d-label small text-muted d-block fw-semibold">Total Refunded</span>
                        <span class="d-val text-warning fw-bold fs-6">&#8377;@patientLedgerData.total_advance_refunded.ToString("N2")</span>
                    </div>
                    <div class="d-kpi">
                        <span class="d-label small text-muted d-block fw-semibold">Net Available</span>
                        <span class="d-val text-success fw-bold fs-5">&#8377;@patientLedgerData.available_balance.ToString("N2")</span>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mt-2 mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-primary"></i> Transaction History
                </h6>
                <div class="table-responsive" style="border-radius: 8px; border: 1px solid #e2e8f0; max-height: 320px; overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead style="background: #f1f5f9; color: #475569; position: sticky; top: 0; z-index: 1;">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Receipt / Bill</th>
                                <th class="text-end">Amount</th>
                                <th class="text-center" style="width: 60px;">Print</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (patientLedgerData.ledger == null || patientLedgerData.ledger.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No transactions found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in patientLedgerData.ledger)
                                {
                                    var rKey = !string.IsNullOrWhiteSpace(row.receiptguid) ? row.receiptguid : (!string.IsNullOrWhiteSpace(row.receiptsnoprint) ? row.receiptsnoprint : row.requestguid);
                                    <tr>
                                        <td class="small">@(row.receiptdate?.ToLocalTime().ToString("dd-MMM-yyyy") ?? "-")</td>
                                        <td>
                                            @if (row.transaction_type == "ADVANCE_REFUND" || row.receiptamount < 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border">Refund</span>
                                            }
                                            else if (row.transaction_type == "ADVANCE_USED")
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis border">Bill Utilized</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border">Deposit</span>
                                            }
                                        </td>
                                        <td class="font-monospace small">@(string.IsNullOrWhiteSpace(row.receiptsnoprint) ? (row.requestguid ?? "-") : row.receiptsnoprint)</td>
                                        <td class="text-end fw-bold @(row.receiptamount < 0 ? "text-danger" : "text-dark")">&#8377;@Math.Abs(row.receiptamount).ToString("N2")</td>
                                        <td class="text-center">
                                            @if (row.transaction_type == "ADVANCE_REFUND" || row.receiptamount < 0)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => PrintRefundReceiptAsync(rKey)" disabled="@(printingBillKey == rKey)" title="Preview & Print Refund Receipt" style="border-radius: 6px; font-size: 0.75rem;">
                                                    @if (printingBillKey == rKey)
                                                    {
                                                        <span class="spinner-border spinner-border-sm" role="status" style="width: 10px; height: 10px; border-width: 1.5px;"></span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-printer-fill"></i>
                                                    }
                                                </button>
                                            }
                                            else if (row.transaction_type == "ADVANCE_USED" && !string.IsNullOrWhiteSpace(row.requestguid))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-info py-0 px-2" @onclick="() => PrintHospitalBillAsync(row.requestguid, row.bill_no)" disabled="@(printingBillKey == row.requestguid)" title="Preview & Print Bill Receipt" style="border-radius: 6px; font-size: 0.75rem;">
                                                    @if (printingBillKey == row.requestguid)
                                                    {
                                                        <span class="spinner-border spinner-border-sm" role="status" style="width: 10px; height: 10px; border-width: 1.5px;"></span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-printer-fill"></i>
                                                    }
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" @onclick="() => PrintAdvanceReceiptAsync(rKey)" disabled="@(printingBillKey == rKey)" title="Preview & Print Advance Receipt" style="border-radius: 6px; font-size: 0.75rem;">
                                                    @if (printingBillKey == rKey)
                                                    {
                                                        <span class="spinner-border spinner-border-sm" role="status" style="width: 10px; height: 10px; border-width: 1.5px;"></span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-printer-fill"></i>
                                                    }
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="modal-footer-custom" style="padding: 0.85rem 1.25rem; display: flex; justify-content: flex-end; background: #f8fafc; border-top: 1px solid #e2e8f0; border-radius: 0 0 16px 16px;">
            <button type="button" class="btn btn-secondary px-4 py-2 rounded-3 fw-semibold" @onclick="CloseLedgerDrawer">Close</button>
        </div>
    </div>
}



<!-- Process Advance Refund Modal -->
@if (showProcessRefundModal && selectedRefundRequestToProcess != null)
{
    <div class="modal-backdrop" @onclick="CloseProcessRefundModal"></div>
    <div class="payment-modal animated-modal modal-md">
        <div class="modal-header-gradient" style="background: linear-gradient(135deg, #b91c1c 0%, #991b1b 100%);">
            <div class="modal-header-left">
                <div class="modal-header-icon" style="background: rgba(255, 255, 255, 0.2); color: #ffffff;">
                    <i class="bi bi-arrow-return-left"></i>
                </div>
                <div>
                    <h3 class="modal-title-text" style="color: #ffffff;">Disburse Advance Refund</h3>
                    <p class="modal-subtitle-text" style="color: #fecaca;">Process refund for patient request</p>
                </div>
            </div>
            <button class="modal-close-icon-btn" @onclick="CloseProcessRefundModal" title="Close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="modal-body-custom">
            <!-- Request info card -->
            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1rem;">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold font-monospace text-danger">@selectedRefundRequestToProcess.request_no</span>
                    <span class="badge bg-danger">Refund Request</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-bold text-dark">@selectedRefundRequestToProcess.patient_name</div>
                        <small class="text-muted">UHID: @(string.IsNullOrWhiteSpace(selectedRefundRequestToProcess.custcode) ? selectedRefundRequestToProcess.custid.ToString() : selectedRefundRequestToProcess.custcode) | Ph: @selectedRefundRequestToProcess.mobile</small>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted text-uppercase fw-bold">Requested Amount</div>
                        <div class="fs-4 fw-bold text-danger">&#8377;@selectedRefundRequestToProcess.amount.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label fw-bold small text-secondary">PAYMENT MODE <span class="text-danger">*</span></label>
                    <select class="form-select" @bind="processRefundModel.payment_mode" required>
                        <option value="CASH">Cash</option>
                        <option value="UPI">UPI</option>
                        <option value="BANK_TRANSFER">Bank Transfer / NEFT</option>
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold small text-secondary">REF / TXN ID</label>
                    <input type="text" class="form-control" @bind="processRefundModel.reference_no" placeholder="e.g. UTR / Memo" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold small text-secondary">CONFIRM REFUND AMOUNT (&#8377;) <span class="text-danger">*</span></label>
                <input type="number" step="0.01" class="form-control fw-bold fs-5 text-danger" @bind="processRefundModel.amount" max="@selectedRefundRequestToProcess.amount" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold small text-secondary">REMARKS</label>
                <input type="text" class="form-control" @bind="processRefundModel.remarks" placeholder="Optional notes" />
            </div>
        </div>

        <div class="modal-footer-custom" style="padding: 1rem 1.25rem; display: flex; justify-content: flex-end; gap: 0.5rem; background: #f8fafc; border-top: 1px solid #e2e8f0; border-radius: 0 0 16px 16px;">
            <button type="button" class="btn-advance-cancel px-3 py-2" @onclick="CloseProcessRefundModal" disabled="@isProcessingRefund">Cancel</button>
            <button type="button" class="btn btn-danger px-4 py-2 fw-bold" @onclick="SubmitProcessRefundAsync" disabled="@isProcessingRefund">
                @if (isProcessingRefund)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Processing...</span>
                }
                else
                {
                    <i class="bi bi-arrow-return-left me-1"></i>
                    <span>Disburse Refund &amp; Issue Receipt</span>
                }
            </button>
        </div>
    </div>
}

<!-- Request Advance Refund Modal -->
@if (showRequestRefundModal)
{
    <div class="modal-backdrop" @onclick="CloseRequestRefundModal"></div>
    <div class="payment-modal animated-modal modal-md">
        <div class="modal-header-gradient" style="background: linear-gradient(135deg, #c2410c 0%, #9a3412 100%);">
            <div class="modal-header-left">
                <div class="modal-header-icon" style="background: rgba(255, 255, 255, 0.2); color: #ffffff;">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </div>
                <div>
                    <h3 class="modal-title-text" style="color: #ffffff;">Request Advance Refund</h3>
                    <p class="modal-subtitle-text" style="color: #fed7aa;">Send refund request to Cash Counter</p>
                </div>
            </div>
            <button class="modal-close-icon-btn" @onclick="CloseRequestRefundModal" title="Close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="modal-body-custom">
            <!-- Patient Search -->
            <div class="mb-3">
                <label class="form-label fw-bold small text-secondary">SELECT PATIENT <span class="text-danger">*</span></label>
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Search by name, UHID or mobile..."
                           @bind="requestRefundSearchQuery"
                           @bind:event="oninput"
                           @onkeyup="OnRequestRefundSearchKeyUp" />
                    <button class="btn btn-outline-secondary" type="button" @onclick="SearchRequestRefundPatientsAsync">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
                @if (requestRefundSearchResults.Any())
                {
                    <div class="border rounded-2 mt-1 bg-white shadow-sm p-1" style="max-height: 160px; overflow-y: auto;">
                        @foreach (var pat in requestRefundSearchResults)
                        {
                            <div class="p-1 px-2 border-bottom hover-bg-light cursor-pointer text-truncate"
                                 style="font-size: 0.85rem; cursor: pointer;"
                                 @onclick="() => SelectRequestRefundPatient(pat)">
                                <strong class="text-primary">@pat.patient_name</strong>
                                <span class="badge bg-light text-dark border ms-1 font-monospace">@GetPatientUhidFromId(pat.custid, pat.custcode)</span>
                                <span class="badge bg-success-subtle text-success ms-2">Avail: &#8377;@pat.available_balance.ToString("N2")</span>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (newRefundRequestModel.custid > 0)
            {
                <div style="background: #fff7ed; border: 1px solid #ffedd5; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1rem;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-dark fs-6">@newRefundRequestModel.patient_name</div>
                            <small class="text-muted">CustID: <span class="badge bg-light text-dark border font-monospace">@newRefundRequestModel.custid</span></small>
                        </div>
                        <div class="text-end">
                            <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Live Available Balance</div>
                            <div class="fs-5 fw-bold text-success">
                                @if (isLoadingRefundSummary)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                }
                                else
                                {
                                    <span>&#8377;@((requestRefundPatientSummary?.available_balance ?? 0).ToString("N2"))</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="mb-3">
                <label class="form-label fw-bold small text-secondary">REFUND AMOUNT (&#8377;) <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text">&#8377;</span>
                    <input type="number" step="0.01" min="0.01" max="@(requestRefundPatientSummary?.available_balance ?? 999999)" class="form-control fs-5 fw-bold text-danger" @bind="newRefundRequestModel.refund_amount" required />
                    @if (requestRefundPatientSummary != null && requestRefundPatientSummary.available_balance > 0)
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => newRefundRequestModel.refund_amount = requestRefundPatientSummary.available_balance">
                            Full
                        </button>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold small text-secondary">REASON <span class="text-danger">*</span></label>
                <select class="form-select" @bind="newRefundRequestModel.reason">
                    <option value="Patient Discharged">Patient Discharged</option>
                    <option value="Treatment Cancelled">Treatment Cancelled</option>
                    <option value="Excess Advance Deposited">Excess Advance Deposited</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold small text-secondary">REMARKS / NOTES</label>
                <textarea class="form-control" rows="2" @bind="newRefundRequestModel.remarks" placeholder="Optional details for Cash Counter staff"></textarea>
            </div>
        </div>

        <div class="modal-footer-custom" style="padding: 1rem 1.25rem; display: flex; justify-content: flex-end; gap: 0.5rem; background: #f8fafc; border-top: 1px solid #e2e8f0; border-radius: 0 0 16px 16px;">
            <button type="button" class="btn-advance-cancel px-3 py-2" @onclick="CloseRequestRefundModal" disabled="@isSubmittingRefundRequest">Cancel</button>
            <button type="button" class="btn btn-warning px-4 py-2 fw-bold" style="background: #ea580c !important; color: #fff !important; border: none;" @onclick="SubmitCreateRefundRequestAsync" disabled="@isSubmittingRefundRequest">
                @if (isSubmittingRefundRequest)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Submitting...</span>
                }
                else
                {
                    <i class="bi bi-send-fill me-1"></i>
                    <span>Submit Refund Request</span>
                }
            </button>
        </div>
    </div>
}

<!-- Cancel Advance / Refund Request Modal -->
@if (showCancelAdvanceModal && selectedRequestToCancel != null)
{
    <div class="modal-backdrop" @onclick="CloseCancelAdvanceModal"></div>
    <div class="payment-modal animated-modal modal-sm" style="max-width: 440px;">
        <div class="modal-header-gradient" style="background: linear-gradient(135deg, #475569 0%, #334155 100%);">
            <div class="modal-header-left">
                <div class="modal-header-icon" style="background: rgba(255, 255, 255, 0.2); color: #ffffff;">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div>
                    <h3 class="modal-title-text" style="color: #ffffff; font-size: 1.1rem;">Cancel Request</h3>
                    <p class="modal-subtitle-text" style="color: #cbd5e1;">Request #@selectedRequestToCancel.request_no</p>
                </div>
            </div>
            <button class="modal-close-icon-btn" @onclick="CloseCancelAdvanceModal" title="Close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="modal-body-custom">
            <p class="small text-secondary mb-2">Are you sure you want to cancel request <strong>#@selectedRequestToCancel.request_no</strong> for <strong>@selectedRequestToCancel.patient_name</strong> (&#8377;@selectedRequestToCancel.amount.ToString("N2"))?</p>
            <div class="mb-3">
                <label class="form-label fw-bold small text-secondary">CANCELLATION REASON</label>
                <input type="text" class="form-control" @bind="cancelAdvanceReason" placeholder="e.g. Treatment changed / Patient requested cancel" />
            </div>
        </div>

        <div class="modal-footer-custom" style="padding: 0.85rem 1.25rem; display: flex; justify-content: flex-end; gap: 0.5rem; background: #f8fafc; border-top: 1px solid #e2e8f0; border-radius: 0 0 16px 16px;">
            <button type="button" class="btn-advance-cancel px-3 py-2" @onclick="CloseCancelAdvanceModal" disabled="@isCancellingAdvanceRequest">Back</button>
            <button type="button" class="btn btn-danger px-3 py-2 fw-bold" @onclick="SubmitCancelAdvanceRequestAsync" disabled="@isCancellingAdvanceRequest">
                @if (isCancellingAdvanceRequest)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Cancelling...</span>
                }
                else
                {
                    <i class="bi bi-trash3 me-1"></i>
                    <span>Confirm Cancel</span>
                }
            </button>
        </div>
    </div>
}


<!-- Add Payment Modal -->
@if (showPaymentModal && selectedBill != null && hasCreateRight)
{
    var dueAmt = selectedBill.balance_amount ?? 0;
    var netAmt = selectedBill.net_amount ?? 0;
    var paidAmt = selectedBill.paid_amount ?? 0;

    <div class="modal-backdrop" @onclick="ClosePaymentModal"></div>
    <div class="payment-modal animated-modal">
