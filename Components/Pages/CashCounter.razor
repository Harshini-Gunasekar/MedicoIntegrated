    // Modal Control
    private void OpenPaymentModal(HmsBillSummary bill)
    {
        selectedBill = bill;
        var dueAmt = bill.balance_amount ?? 0;

        decimal? defaultPmc1 = null;
        decimal? defaultPmc2 = null;
        decimal? defaultPmc3 = null;

        if (paymodes != null && paymodes.Count > 0)
        {
            var cashPm = paymodes.FirstOrDefault(p => string.Equals(p.shortname, "CASH", StringComparison.OrdinalIgnoreCase));
            defaultPmc1 = cashPm != null ? cashPm.pmcode : paymodes[0].pmcode;

            var cardPm = paymodes.FirstOrDefault(p => string.Equals(p.shortname, "CARD", StringComparison.OrdinalIgnoreCase));
            if (cardPm != null) defaultPmc2 = cardPm.pmcode;

            var upiPm = paymodes.FirstOrDefault(p => string.Equals(p.shortname, "UPI", StringComparison.OrdinalIgnoreCase) || string.Equals(p.shortname, "GPAY", StringComparison.OrdinalIgnoreCase));
            if (upiPm != null) defaultPmc3 = upiPm.pmcode;
        }

        paymentRequest = new HmsPaymentRequest
        {
            requestguid = bill.requestguid,
            amount = 0,
            collection_type = "CASH",
            cntcode = bill.cntcode ?? 1,
            enteredbhcode = bill.enteredbhcode ?? 1,
            usercode = TenantState.UserCode > 0 ? TenantState.UserCode : 101,
            computercode = 1,
            reference_no = "",
            bank_name = "",
            pmc1 = defaultPmc1,
            pmc1_amount = 0,
            pmc2 = defaultPmc2,
            pmc2_amount = 0,
            pmc3 = defaultPmc3,
            pmc3_amount = 0
        };

        if (TenantState.BranchCode > 0) paymentRequest.enteredbhcode = TenantState.BranchCode.Value;

        showPaymode2 = false;
        showPaymode3 = false;
        showPaymentModal = true;
    }

    private void SetQuickAmount(double amt)
    {
        paymentRequest.amount = Math.Round(amt, 2);
        double a2 = paymentRequest.pmc2_amount ?? 0;
        double a3 = paymentRequest.pmc3_amount ?? 0;
        if (a2 == 0 && a3 == 0)
        {
            paymentRequest.pmc1_amount = paymentRequest.amount;
        }
        RecalculatePaymentTotals();
    }

    private void RecalculatePaymentTotals()
    {
        double a1 = paymentRequest.pmc1_amount ?? 0;
        double a2 = paymentRequest.pmc2_amount ?? 0;
        double a3 = paymentRequest.pmc3_amount ?? 0;

        int activeCount = 0;
        string singleMode = "CASH";

        if (a1 > 0 && paymentRequest.pmc1.HasValue)
        {
            activeCount++;
            var pm1 = paymodes.FirstOrDefault(p => p.pmcode == paymentRequest.pmc1.Value);
            if (pm1 != null && !string.IsNullOrEmpty(pm1.shortname)) singleMode = pm1.shortname;
        }
        if (a2 > 0 && paymentRequest.pmc2.HasValue)
        {
            activeCount++;
            var pm2 = paymodes.FirstOrDefault(p => p.pmcode == paymentRequest.pmc2.Value);
            if (pm2 != null && !string.IsNullOrEmpty(pm2.shortname)) singleMode = pm2.shortname;
        }
        if (a3 > 0 && paymentRequest.pmc3.HasValue)
        {
            activeCount++;
            var pm3 = paymodes.FirstOrDefault(p => p.pmcode == paymentRequest.pmc3.Value);
            if (pm3 != null && !string.IsNullOrEmpty(pm3.shortname)) singleMode = pm3.shortname;
        }

        if (activeCount > 1)
        {
            paymentRequest.collection_type = "MIXED";
            paymentRequest.amount = Math.Round(a1 + a2 + a3, 2);
        }
        else if (activeCount == 1)
        {
            paymentRequest.collection_type = singleMode;
            paymentRequest.amount = Math.Round(a1 + a2 + a3, 2);
        }
        else
        {
            paymentRequest.collection_type = "CASH";
        }
    }

