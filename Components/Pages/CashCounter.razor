                                            <td class="text-end fw-bold text-danger fs-6">&#8377;@r.refund_amount.ToString("N2")</td>
                                            <td>@(string.IsNullOrWhiteSpace(r.processed_by) ? "Staff" : r.processed_by)</td>
                                            <td>@(string.IsNullOrWhiteSpace(r.counter_name) ? "Counter" : r.counter_name)</td>
