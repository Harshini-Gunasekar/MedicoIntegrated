    private sales_request? ParsePharmacyRequestResponse(string json, long? targetSalesCode = null)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        var options = new System.Text.Json.JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString
        };

        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.ValueKind == JsonValueKind.Object && TryGetPropertyIgnoreCase(root, "data", out var dataProp))
            {
                root = dataProp;
            }

            if (root.ValueKind == JsonValueKind.Array)
            {
                JsonElement? matchedElement = null;
                foreach (var item in root.EnumerateArray())
                {
                    if (item.ValueKind == JsonValueKind.Object)
                    {
                        var m = ParsePharmacyMaster(item, options);
                        if (m != null && targetSalesCode.HasValue && targetSalesCode.Value > 0 && m.salescode == targetSalesCode.Value)
                        {
                            matchedElement = item;
                            break;
                        }
                    }
                }

                if (matchedElement.HasValue)
                {
                    root = matchedElement.Value;
                }
                else if (root.GetArrayLength() > 0)
                {
                    root = root[0];
                }
                else return null;
            }

            if (root.ValueKind == JsonValueKind.Object)
            {
                var req = new sales_request();

                // 1. Parse Master
                if (TryGetPropertyIgnoreCase(root, "master", out var masterProp))
                {
                    req.master = ParsePharmacyMaster(masterProp, options) ?? new sales_master();
                }
                else
                {
                    var m = ParsePharmacyMaster(root, options);
                    if (m != null && m.salescode > 0) req.master = m;
                }

                // 2. Parse Details
                JsonElement detailsProp = default;
                bool hasDetails = false;
                foreach (var detailKey in new[] { "details", "detail", "salesdetail", "salesdetails", "sales_detail", "sales_details", "items", "itemlist" })
                {
                    if (TryGetPropertyIgnoreCase(root, detailKey, out detailsProp) && detailsProp.ValueKind == JsonValueKind.Array)
                    {
                        hasDetails = true;
                        break;
                    }
                }

                if (!hasDetails && TryGetPropertyIgnoreCase(root, "master", out var mObj) && mObj.ValueKind == JsonValueKind.Object)
                {
                    foreach (var detailKey in new[] { "details", "detail", "salesdetail", "salesdetails", "sales_detail", "sales_details", "items", "itemlist" })
                    {
                        if (TryGetPropertyIgnoreCase(mObj, detailKey, out detailsProp) && detailsProp.ValueKind == JsonValueKind.Array)
                        {
                            hasDetails = true;
                            break;
                        }
                    }
                }

                if (hasDetails && detailsProp.ValueKind == JsonValueKind.Array)
                {
                    req.details = new List<sales_detail>();
                    foreach (var itemEl in detailsProp.EnumerateArray())
                    {
                        var d = ParsePharmacyDetail(itemEl, options);
                        if (d != null) req.details.Add(d);
                    }
                }
                else
                {
                    req.details = new List<sales_detail>();
                }

                if (req.master != null && req.master.salescode > 0)
                {
                    return req;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("[CashCounter] Parse Pharmacy Request Error: " + ex.Message);
        }

        try
        {
            var direct = System.Text.Json.JsonSerializer.Deserialize<sales_request>(json, options);
            if (direct != null && direct.master != null) return direct;
        }
        catch { }

        return null;
    }

    private static bool TryGetPropertyIgnoreCase(JsonElement el, string name, out JsonElement prop)
    {
        prop = default;
        if (el.ValueKind != JsonValueKind.Object) return false;
        foreach (var p in el.EnumerateObject())
        {
            if (string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase))
            {
                prop = p.Value;
                return true;
            }
        }
        return false;
    }

    // Data Load Helpers
    private async Task LoadBranchesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }

            var response = await client.GetAsync("api/Branch/get");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                branches = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                branches = branches.Where(b => !b.deleted).ToList();

                if (!IsAdminUser())
                {
                    var allowed = GetAuthorizedBranchCodes();
                    if (allowed.Any())
                    {
                        branches = branches.Where(b => allowed.Contains(b.bh_code)).ToList();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }

    private bool IsAdminUser()
    {
        var role = TenantState.UserData?.Role;
        return TenantState.UserCode == 1 ||
               string.Equals(role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(role, "Owner", StringComparison.OrdinalIgnoreCase);
    }

    private List<int> GetAuthorizedBranchCodes()
    {
        if (TenantState.UserData?.Branches != null && TenantState.UserData.Branches.Any())
        {
            return TenantState.UserData.Branches
                .Select(b => b.bh_code != 0 ? b.bh_code : (b.bhcode ?? 0))
                .Where(c => c > 0 && c != 21)
                .Distinct()
                .ToList();
        }
        return new List<int>();
    }

