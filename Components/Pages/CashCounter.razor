                                <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1rem;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold text-dark fs-6">@directDepositModel.patient_name</div>
                                            <small class="text-muted">UHID: <span class="badge bg-light text-dark border font-monospace">@(directDepositPatientSummary?.custcode ?? directDepositModel.custid.ToString())</span></small>
                                        </div>
                                        <div class="text-end">
                                            <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Available Balance</div>
                                            <div class="fs-5 fw-bold text-success">
                                                @if (isLoadingDirectDepositSummary)
                                                {
                                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                                }
                                                else
                                                {
                                                    <span>&#8377;@((directDepositPatientSummary?.available_balance ?? 0).ToString("N2"))</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-secondary">DEPOSIT AMOUNT (&#8377;) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">&#8377;</span>
                                    <input type="number" step="0.01" min="1" class="form-control fs-5 fw-bold text-success" @bind="directDepositModel.amount" placeholder="0.00" required />
                                </div>
                            </div>

