                                <table class="custom-table">
                                    <thead>
                                        <tr>
                                            <th>PATIENT</th>
                                            <th>UHID</th>
                                            <th class="text-end">DEPOSITED</th>
                                            <th class="text-end">AVAILABLE</th>
                                            <th class="text-center">ACTION</th>
                                        </tr>
                                    </thead>
