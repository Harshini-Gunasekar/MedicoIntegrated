    private static string? CleanUhid(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return null;
        var clean = code.Trim();
        if (clean.StartsWith("CUST-", StringComparison.OrdinalIgnoreCase) ||
            clean.StartsWith("CUST", StringComparison.OrdinalIgnoreCase) ||
            clean.Equals("N/A", StringComparison.OrdinalIgnoreCase) ||
            decimal.TryParse(clean, out _))
        {
            return null;
        }
        return clean;
    }

    private string GetDisplayBillUhid(HmsBillSummary? bill)
    {
        if (bill == null) return "-";
        var clean = CleanUhid(bill.custcode);
        if (!string.IsNullOrWhiteSpace(clean)) return clean;
        if (bill.custid.HasValue && bill.custid.Value > 0)
        {
            return GetPatientUhidFromId(bill.custid.Value, bill.custcode);
        }
        return "-";
    }

    private string GetDisplayPharmacyUhid(sales_master? s)
    {
        if (s == null) return "-";
        if (s.customercode.HasValue && s.customercode.Value > 0)
        {
            return GetPatientUhidFromId((decimal)s.customercode.Value);
        }
        if (!string.IsNullOrWhiteSpace(s.patientid))
        {
            var pid = s.patientid.Trim();
            if (decimal.TryParse(pid, out var numPid) && numPid > 0)
            {
                return GetPatientUhidFromId(numPid);
            }
            if (opByNoMap.TryGetValue(pid, out var op))
            {
                var clean = CleanUhid(op.custcode);
                if (!string.IsNullOrWhiteSpace(clean)) return clean;
                if (op.custid > 0) return GetPatientUhidFromId(op.custid);
            }
            if (ipByNoMap.TryGetValue(pid, out var ip))
            {
                var clean = CleanUhid(ip.custcode);
                if (!string.IsNullOrWhiteSpace(clean)) return clean;
                if (ip.custid > 0) return GetPatientUhidFromId(ip.custid);
            }
        }
        return "-";
    }

    private string GetPatientUhidFromId(decimal custid, string? directCustCode = null)
    {
        var cleanDirect = CleanUhid(directCustCode);
        if (!string.IsNullOrWhiteSpace(cleanDirect)) return cleanDirect;

        if (custid > 0)
        {
            if (opByCustIdMap.TryGetValue(custid, out var op))
            {
                var cleanOp = CleanUhid(op.custcode);
                if (!string.IsNullOrWhiteSpace(cleanOp)) return cleanOp;
            }
            if (ipByCustIdMap.TryGetValue(custid, out var ip))
            {
                var cleanIp = CleanUhid(ip.custcode);
                if (!string.IsNullOrWhiteSpace(cleanIp)) return cleanIp;
            }
            return custid.ToString();
        }
        return "-";
    }

    private async Task OpenBillDetailsCardAsync(HmsBillSummary bill)
    {
        selectedDetailsBill = bill;
        selectedDetailsSalesMaster = null;
        detailsAdvanceUsage = null;
        revertCounterPaymodeCode = 0;
        revertCounterAmount = 0;
        revertCounterReference = "";
        revertCounterReason = "Advance used reversal";
        showBillDetailsCardModal = true;
        isLoadingBillDetails = true;
        detailsCardPharmacyItems = null;
        detailsCardHospitalItems = null;

        detailsCardBillNo = bill.bill_no ?? "-";
        detailsCardPatientName = bill.patient_name ?? "-";
        detailsCardCustId = bill.custid;
        detailsCardCustCode = GetDisplayBillUhid(bill);
        detailsCardDoctorName = GetDoctorName(bill.dcode, bill.doctor_name, bill.opvisitid, bill.custid, bill.bill_date);
        detailsCardBillDate = bill.bill_date;
        detailsCardGross = bill.gross_amount ?? 0;
        detailsCardDiscount = bill.discount_amount ?? 0;
        detailsCardNet = bill.net_amount ?? 0;
        detailsCardPaid = bill.paid_amount ?? 0;
        detailsCardBalance = bill.balance_amount ?? 0;

        // Determine Reference No
        var refNo = GetPatientIdentifyingNumber(bill);
        detailsCardRefNo = refNo;

        // Match OP registration
        var matchedOp = FindMatchedOpRegistration(bill.opvisitid, bill.custid, bill.bill_date);
        if (matchedOp == null && !string.IsNullOrWhiteSpace(bill.op_no))
        {
            matchedOp = FindMatchedOpRegistration(bill.op_no, bill.custid, bill.bill_date);
        }

        // Determine Patient Type
        if (refNo.StartsWith("IP", StringComparison.OrdinalIgnoreCase) || (bill.ip_id.HasValue && bill.ip_id.Value != Guid.Empty) || !string.IsNullOrWhiteSpace(bill.ip_no))
        {
            detailsCardPatientType = "IP Patient";
            detailsCardTokenNo = "";
        }
        else if (refNo.StartsWith("OP", StringComparison.OrdinalIgnoreCase) || matchedOp != null || !string.IsNullOrWhiteSpace(bill.op_no) || !string.IsNullOrWhiteSpace(bill.opvisitid))
        {
            detailsCardPatientType = "OP Patient";
            detailsCardTokenNo = !string.IsNullOrWhiteSpace(matchedOp?.token_no)
                ? matchedOp.token_no.Trim()
                : (matchedOp?.queue_no.HasValue == true ? matchedOp.queue_no.Value.ToString() : "");
        }
        else
        {
            detailsCardPatientType = "Counter Sales Patient";
            detailsCardTokenNo = "";
        }

        StateHasChanged();

        // Fetch bill breakdown from get-bill endpoint
        try
        {
            if (!string.IsNullOrEmpty(bill.requestguid))
            {
                var usage = await DueCollectionService.GetAdvanceUsageAsync(bill.requestguid);
                detailsAdvanceUsage = usage.data;
                if (detailsAdvanceUsage?.can_revert == true)
                {
                    revertCounterAmount = detailsAdvanceUsage.total_advance_used;
                }

                var fullBill = await HmsBillingService.GetBillByGuidAsync(bill.requestguid);
                if (fullBill != null)
                {
                    if (fullBill.items != null && fullBill.items.Any())
                    {
                        detailsCardHospitalItems = fullBill.items;
                    }
                    if (fullBill.gross_amount.HasValue) detailsCardGross = fullBill.gross_amount.Value;
                    if (fullBill.discount_amount.HasValue) detailsCardDiscount = fullBill.discount_amount.Value;
                    if (fullBill.net_amount.HasValue) detailsCardNet = fullBill.net_amount.Value;
                    if (fullBill.paid_amount.HasValue) detailsCardPaid = fullBill.paid_amount.Value;
                    if (fullBill.balance_amount.HasValue) detailsCardBalance = fullBill.balance_amount.Value;

                    if (detailsCardPatientType == "OP Patient" && string.IsNullOrWhiteSpace(detailsCardTokenNo))
                    {
                        var opFromFull = FindMatchedOpRegistration(fullBill.opvisitid ?? fullBill.op_id, fullBill.custid, fullBill.bill_date);
                        if (opFromFull != null)
                        {
                            detailsCardTokenNo = !string.IsNullOrWhiteSpace(opFromFull.token_no)
                                ? opFromFull.token_no.Trim()
                                : (opFromFull.queue_no.HasValue ? opFromFull.queue_no.Value.ToString() : "");
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CashCounter] Error loading bill breakdown: {ex.Message}");
        }
        finally
        {
            isLoadingBillDetails = false;
            StateHasChanged();
        }
    }

    private IEnumerable<PaymodeMasterModel> GetCashCounterRevertPaymodes() => paymodes.Where(p =>
        !string.Equals(p.name, "ADVANCE", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(p.shortname, "ADVANCE", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(p.shortname, "ADV", StringComparison.OrdinalIgnoreCase));

    private async Task RevertSelectedBillAdvanceAsync()
    {
        if (selectedDetailsBill == null || detailsAdvanceUsage?.can_revert != true) return;
        if (revertCounterPaymodeCode <= 0)
        {
            ToastService.ShowError("Select a paymode for advance reversal.");
            return;
        }
        if (revertCounterAmount <= 0 || revertCounterAmount > detailsAdvanceUsage.total_advance_used)
        {
            ToastService.ShowError("Enter a valid advance reversal amount.");
            return;
        }

        revertCounterRunning = true;
        try
        {
            var result = await DueCollectionService.RevertUsedAdvanceAsync(new HmsAdvanceRevertRequest
            {
                requestguid = selectedDetailsBill.requestguid!,
                revert_amount = revertCounterAmount,
                pmcode = revertCounterPaymodeCode,
                reference_no = revertCounterReference,
                enteredbhcode = filter.bhcode.HasValue && filter.bhcode.Value > 0 ? (int)filter.bhcode.Value : 1,
                cntcode = filter.cntcode.HasValue && filter.cntcode.Value > 0 ? (int)filter.cntcode.Value : 1,
                usercode = TenantState.UserCode > 0 ? TenantState.UserCode : 101,
                computercode = 1,
                reason = revertCounterReason
            });

            if (result.data != null)
            {
                ToastService.ShowSuccess($"Advance reverted. Receipt: {result.data.receipt_no ?? "-"}. Balance: ₹{result.data.advance_balance_after:N2}");
                detailsAdvanceUsage = null;
                await OpenBillDetailsCardAsync(selectedDetailsBill);
            }
            else
            {
                ToastService.ShowError(result.message ?? "Unable to revert advance.");
            }
        }
        finally
        {
            revertCounterRunning = false;
            StateHasChanged();
        }
    }

