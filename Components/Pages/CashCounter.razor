    private async Task<string> FetchBillReportBase64(string guid)
    {
        string tenant = !string.IsNullOrWhiteSpace(DefaultTenant) ? DefaultTenant : (!string.IsNullOrWhiteSpace(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");
        string token = !string.IsNullOrWhiteSpace(AuthToken) ? AuthToken : (!string.IsNullOrWhiteSpace(TenantState?.AuthToken) ? TenantState.AuthToken : "");

        if (string.IsNullOrWhiteSpace(token))
        {
            try
            {
                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                if (!tokenResult.Success || string.IsNullOrEmpty(tokenResult.Value))
                {
                    tokenResult = await _sessionStorage.GetAsync<string>("auth_token");
                }
                if (tokenResult.Success && !string.IsNullOrEmpty(tokenResult.Value))
                {
                    token = tokenResult.Value;
                }
            }
            catch { }
        }

        if (string.IsNullOrWhiteSpace(tenant) || tenant == "0010")
        {
            try
            {
                var tenantResult = await _sessionStorage.GetAsync<string>("tenant_code");
                if (!tenantResult.Success || string.IsNullOrEmpty(tenantResult.Value))
                {
                    tenantResult = await _sessionStorage.GetAsync<string>("tenantcode");
                }
                if (tenantResult.Success && !string.IsNullOrEmpty(tenantResult.Value))
                {
                    tenant = tenantResult.Value;
                }
            }
            catch { }
        }

        var baseApi = Configuration["ApiBaseUrl"]?.TrimEnd('/') ?? "";
        var candidateUrls = new List<string>
        {
            $"api/Report/getbill?requestguid={guid}&isletterhead=true",
            $"api/report/getbill?requestguid={guid}&isletterhead=true",
            $"api/Report/getbill?requestguid={guid}&isletterhead=true&tenantcode={tenant}&tenant_code={tenant}",
            $"api/report/getbill?requestguid={guid}&isletterhead=true&tenantcode={tenant}&tenant_code={tenant}"
        };
        if (!string.IsNullOrEmpty(baseApi))
        {
            candidateUrls.Add($"{baseApi}/api/report/getbill?requestguid={guid}&isletterhead=true");
        }

        var client = ClientFactory.CreateClient("Medico");
        string lastError = "";

        foreach (var url in candidateUrls)
        {
            try
            {
                var req = new HttpRequestMessage(HttpMethod.Get, url);
                if (!string.IsNullOrEmpty(token))
                {
                    req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                }
                if (!req.Headers.Contains("tenantcode")) req.Headers.Add("tenantcode", tenant);
                if (!req.Headers.Contains("tenant_code")) req.Headers.Add("tenant_code", tenant);
                if (!req.Headers.Contains("tenant-code")) req.Headers.Add("tenant-code", tenant);

                var response = await client.SendAsync(req);

                if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
                {
                    var contentStr = await response.Content.ReadAsStringAsync();
                    contentStr = contentStr.Trim('"').Trim();

                    string base64Data = contentStr;
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(contentStr);
                        var root = doc.RootElement;
                        if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {
                            if (root.TryGetProperty("data", out var dProp)) base64Data = dProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("base64", out var bProp)) base64Data = bProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("file", out var fProp)) base64Data = fProp.GetString() ?? contentStr;
                        }
                        else if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                        {
                            base64Data = root.GetString() ?? contentStr;
                        }
                    }
                    catch { }

                    if (!string.IsNullOrWhiteSpace(base64Data) && base64Data.Length >= 50)
                    {
                        return base64Data;
                    }
                }
                else
                {
                    var errContent = await response.Content.ReadAsStringAsync();
                    lastError = $"HTTP {(int)response.StatusCode} ({response.ReasonPhrase}): {errContent}";
                }
            }
            catch (Exception ex)
            {
                lastError = ex.Message;
            }
        }

        // Fallback with default Http
        try
        {
            var fallbackResp = await Http.GetAsync($"api/Report/getbill?requestguid={guid}&isletterhead=true");
            if (fallbackResp.IsSuccessStatusCode && fallbackResp.StatusCode != System.Net.HttpStatusCode.NoContent)
            {
                var contentStr = await fallbackResp.Content.ReadAsStringAsync();
                contentStr = contentStr.Trim('"').Trim();
                if (!string.IsNullOrWhiteSpace(contentStr) && contentStr.Length >= 50)
                {
                    return contentStr;
                }
            }
        }
        catch { }

        throw new Exception(string.IsNullOrEmpty(lastError) ? "Backend report endpoint returned empty data." : lastError);
    }

    public async Task PrintHospitalBillAsync(string? guid, string? billNo = null)
    {
        if (string.IsNullOrEmpty(guid))
        {
            ToastService.ShowWarning("No bill reference found to print.");
            return;
        }

        try
        {
            printingBillKey = guid;
            isPrintingAnyBill = true;
            StateHasChanged();

            string base64 = await FetchBillReportBase64(guid);

            if (!string.IsNullOrWhiteSpace(base64) && (base64.StartsWith("data:application/pdf") || base64.Length > 100))
            {
                string title = !string.IsNullOrWhiteSpace(billNo) 
                    ? $"Bill Receipt - {billNo}" 
                    : "Bill Receipt";
                await JS.InvokeVoidAsync("openPdfPreviewModal", base64, title);
            }
            else
            {
                ToastService.ShowWarning("Bill report not available or empty.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading bill report: {ex.Message}");
        }
        finally
        {
            printingBillKey = null;
            isPrintingAnyBill = false;
            StateHasChanged();
        }
    }

    private async Task<string> FetchPharmacyBillReportBase64(string rawBillNo)
    {
        string tenant = !string.IsNullOrWhiteSpace(DefaultTenant) ? DefaultTenant : (!string.IsNullOrWhiteSpace(TenantState?.TenantCode) ? TenantState.TenantCode : "0010");
        string token = !string.IsNullOrWhiteSpace(AuthToken) ? AuthToken : (!string.IsNullOrWhiteSpace(TenantState?.AuthToken) ? TenantState.AuthToken : "");

        if (string.IsNullOrWhiteSpace(token))
        {
            try
            {
                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                if (!tokenResult.Success || string.IsNullOrEmpty(tokenResult.Value))
                {
                    tokenResult = await _sessionStorage.GetAsync<string>("auth_token");
                }
                if (tokenResult.Success && !string.IsNullOrEmpty(tokenResult.Value))
                {
                    token = tokenResult.Value;
                }
            }
            catch { }
        }

        if (string.IsNullOrWhiteSpace(tenant) || tenant == "0010")
        {
            try
            {
                var tenantResult = await _sessionStorage.GetAsync<string>("tenant_code");
                if (!tenantResult.Success || string.IsNullOrEmpty(tenantResult.Value))
                {
                    tenantResult = await _sessionStorage.GetAsync<string>("tenantcode");
                }
                if (tenantResult.Success && !string.IsNullOrEmpty(tenantResult.Value))
                {
                    tenant = tenantResult.Value;
                }
            }
            catch { }
        }

        string billNo = rawBillNo.TrimStart('#').Trim();
        string? apiBase = Configuration["ApiBaseUrl"]?.TrimEnd('/');

        var candidateUrls = new List<string>
        {
            $"api/report/getpharmacybill?billNo={billNo}&orientation=landscape&tenantcode={tenant}&tenant_code={tenant}",
            $"api/Report/GetPharmacyBill?billNo={billNo}&orientation=landscape&tenantcode={tenant}&tenant_code={tenant}"
        };
        if (!string.IsNullOrEmpty(apiBase))
        {
            candidateUrls.Add($"{apiBase}/api/report/getpharmacybill?billNo={billNo}&orientation=landscape&tenantcode={tenant}&tenant_code={tenant}");
        }

        var client = ClientFactory.CreateClient("Medico");
        string lastError = "";

        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(25));
        var cancellationToken = cts.Token;

        foreach (var url in candidateUrls)
        {
            if (cancellationToken.IsCancellationRequested) break;
            try
            {
                var req = new HttpRequestMessage(HttpMethod.Get, url);
                if (!string.IsNullOrEmpty(token))
                {
                    req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                }
                req.Headers.Add("tenantcode", tenant);
                req.Headers.Add("tenant_code", tenant);
                req.Headers.Add("tenant-code", tenant);

                var response = await client.SendAsync(req, cancellationToken);

                if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
                {
                    var contentStr = await response.Content.ReadAsStringAsync(cancellationToken);
                    contentStr = contentStr.Trim('"').Trim();

                    string base64Data = contentStr;
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(contentStr);
                        var root = doc.RootElement;
                        if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {
                            if (root.TryGetProperty("data", out var dProp)) base64Data = dProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("base64", out var bProp)) base64Data = bProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("file", out var fProp)) base64Data = fProp.GetString() ?? contentStr;
                            else if (root.TryGetProperty("report", out var rProp)) base64Data = rProp.GetString() ?? contentStr;
                        }
                        else if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                        {
                            base64Data = root.GetString() ?? contentStr;
                        }
                    }
                    catch { }

                    if (!string.IsNullOrWhiteSpace(base64Data) && base64Data.Length >= 50)
                    {
                        return base64Data;
                    }
                }
                else
                {
                    var errContent = await response.Content.ReadAsStringAsync(cancellationToken);
                    lastError = $"HTTP {(int)response.StatusCode} ({response.ReasonPhrase}): {errContent}";
                }
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch (Exception ex)
            {
                lastError = ex.Message;
            }
        }

        throw new Exception(string.IsNullOrEmpty(lastError) ? "Backend pharmacy bill report endpoint returned empty data." : lastError);
    }

