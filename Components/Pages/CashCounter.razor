    private async Task SearchDirectDepositPatientsAsync()
    {
        if (string.IsNullOrWhiteSpace(directDepositSearchQuery))
        {
            directDepositSearchResults.Clear();
            return;
        }

        var q = directDepositSearchQuery.Trim().ToLowerInvariant();
        directDepositSearchResults = advanceDepositsList
            .Where(p => (!string.IsNullOrEmpty(p.patient_name) && p.patient_name.ToLowerInvariant().Contains(q)) ||
                        (!string.IsNullOrEmpty(p.custcode) && p.custcode.ToLowerInvariant().Contains(q)) ||
                        (!string.IsNullOrEmpty(p.mobile) && p.mobile.Contains(q)) ||
                        p.custid.ToString().Contains(q))
            .Take(10)
            .ToList();

        if (!directDepositSearchResults.Any())
        {
            var opMatch = (cachedOpRegistrations ?? new List<OPRegistrationModel.OpRegistrationModel>())
                .Where(b => (!string.IsNullOrEmpty(b.patient_name) && b.patient_name.ToLowerInvariant().Contains(q)) ||
                            (!string.IsNullOrEmpty(b.custcode) && b.custcode.ToLowerInvariant().Contains(q)) ||
                            (!string.IsNullOrEmpty(b.mobile) && b.mobile.Contains(q)) ||
                            b.custid.ToString().Contains(q))
                .GroupBy(b => b.custid)
                .Select(g => g.First())
                .Select(b => new HmsAdvancePatientItem
                {
                    custid = b.custid,
                    custcode = b.custcode,
                    patient_name = b.patient_name,
                    mobile = b.mobile,
                    available_balance = 0
                })
                .Take(5)
                .ToList();

            if (opMatch.Any())
            {
                directDepositSearchResults = opMatch;
            }
        }
