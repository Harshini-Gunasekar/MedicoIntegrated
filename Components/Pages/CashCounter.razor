                                <div class="col-6">
                                    <label class="form-label fw-bold small text-secondary">COUNTER</label>
                                    <select class="form-select" @bind="directDepositModel.cntcode">
                                        @foreach (var c in counters)
                                        {
                                            <option value="@((int)c.cntcode)">@c.name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bold small text-secondary">COLLECTION TYPE</label>
                                    <select class="form-select" @bind="directDepositModel.collection_type">
                                        <option value="CASH">Cash</option>
                                        <option value="CARD">Credit/Debit Card</option>
                                        <option value="UPI">UPI / GPay / PhonePe</option>
                                        <option value="CHEQUE">Cheque</option>
                                        <option value="BANK">Bank Transfer / NEFT</option>
                                    </select>
