                                <tr>
                                    <th style="width: 50px;">S.NO</th>
                                    <th>RECEIPT NO</th>
                                    <th>DATE &amp; TIME</th>
                                    <th>PATIENT</th>
                                    <th>UHID</th>
                                    <th class="text-end">REFUND AMOUNT</th>
                                    <th>PROCESSED BY</th>
                                    <th>COUNTER</th>
                                    <th>REMARKS</th>
                                    <th class="text-center" style="width: 100px;">STATUS</th>
                                    <th class="text-center" style="width: 60px;">PRINT</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (FilteredRefundHistory.Count == 0)
                                {
                                    <tr>
                                        <td colspan="11" class="text-center py-5 text-muted">
                                            <i class="bi bi-clock-history" style="font-size: 2.2rem; color: #cbd5e1; display: block; margin-bottom: 0.5rem;"></i>
                                            No refund records found for the selected period.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int ridx = 1;
                                    @foreach (var r in FilteredRefundHistory)
                                    {
                                        var refHistoryKey = !string.IsNullOrWhiteSpace(r.receiptguid) ? r.receiptguid : r.receiptsnoprint;
                                        <tr>
                                            <td>@ridx</td>
                                            <td>
                                                <span class="fw-bold font-monospace text-primary">@r.receiptsnoprint</span>
                                            </td>
                                            <td>@(r.receiptdate?.ToLocalTime().ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</td>
                                            <td>
                                                <span class="fw-bold text-dark">@r.patient_name</span>
                                                @if (!string.IsNullOrWhiteSpace(r.mobile))
                                                {
                                                    <br /><small class="text-muted">@r.mobile</small>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border font-monospace">@GetPatientUhidFromId(r.custid, r.custcode)</span>
