                            <div class="search-input-wrapper">
                                <i class="bi bi-search search-icon"></i>
                                <input type="text" class="form-control" @bind="refundSearchQuery" placeholder="Receipt No, Patient Name or Mobile..." />
                            </div>
                        </div>
                        <div class="filter-item action-item" style="display: flex; align-items: flex-end; gap: 8px;">
                            <button type="button" class="btn-advance-search" @onclick="LoadRefundHistoryAsync">
                                <i class="bi bi-search"></i> Filter
                            </button>
                            <button type="button" class="btn-advance-reset" @onclick="ResetRefundHistoryFilterAsync">
                                <i class="bi bi-arrow-clockwise"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Refund History Table Card -->
                <div class="table-card">
