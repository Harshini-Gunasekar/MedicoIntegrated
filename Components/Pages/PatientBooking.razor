@page "/booking/patient"
@rendermode InteractiveServer
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.AppointmentBookingService BookingService
@inject Booking.Services.ToastService ToastService
@inject NavigationManager Navigation
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState

<div class="animated-background">
    <div class="floating-blob blob-1"></div>
    <div class="floating-blob blob-2"></div>
    <div class="floating-blob blob-3"></div>
    <div class="pattern-overlay"></div>
</div>

<div class="booking-container">
    <div class="booking-header">
        <h1>Book Your Appointment</h1>
        <p>Follow the simple steps below to schedule a consultation with our medical specialists.</p>
    </div>

    <!-- Stepper Progress Tracker -->
    <div class="stepper-wrapper">
        <div class="step-item @(currentStep >= 1 ? "active" : "") @(currentStep > 1 ? "completed" : "")">
            <div class="step-number">@(currentStep > 1 ? "✓" : "1")</div>
            <div class="step-label">Select Specialist</div>
        </div>
        <div class="step-line @(currentStep >= 2 ? "active" : "") @(currentStep > 2 ? "completed" : "")"></div>
        <div class="step-item @(currentStep >= 2 ? "active" : "") @(currentStep > 2 ? "completed" : "")">
            <div class="step-number">@(currentStep > 2 ? "✓" : "2")</div>
            <div class="step-label">Choose Date & Slot</div>
        </div>
        <div class="step-line @(currentStep >= 3 ? "active" : "")"></div>
        <div class="step-item @(currentStep >= 3 ? "active" : "")">
            <div class="step-number">3</div>
            <div class="step-label">Patient Details</div>
        </div>
    </div>

    <!-- STEP 1: SELECT DOCTOR -->
    @if (currentStep == 1)
    {
        <div class="glass-card">
            <div class="search-wrapper" style="position: relative; max-width: 500px; margin: 0 auto 2rem auto;">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search doctor by name..." @bind="searchQuery" @bind:event="oninput" />
            </div>

            @if (loading)
            {
                <div style="text-align: center; padding: 3rem; color: #026aa7;">
                    <div class="spinner-border" role="status" style="width: 3rem; height: 3rem; margin-bottom: 1rem;"></div>
                    <p style="font-weight: 600;">Retrieving doctors directory...</p>
                </div>
            }
            else
            {
                var filteredDoctors = GetFilteredDoctors();
                @if (filteredDoctors.Any())
                {
                    <div class="doctors-grid">
                        @foreach (var doc in filteredDoctors)
                        {
                            <div class="doctor-card has-photo @(selectedDoctor?.dcode == doc.dcode ? "selected" : "")" @onclick="() => SelectDoctor(doc)">
                                <div class="doc-avatar-container left-corner">
                                    @(string.IsNullOrEmpty(doc.name) ? "Dr" : doc.name.Trim().Substring(0, Math.Min(2, doc.name.Trim().Length)).ToUpper())
                                </div>
                                <div class="doc-details-wrapper">
                                    <div class="doc-name">Dr. @(string.IsNullOrWhiteSpace(doc.name) ? doc.doctorfullname : doc.name)</div>
                                    <div class="doc-spec">@(doc.reference ?? "Medical Consultant")</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; padding: 3rem; color: #64748b;">
                        <i class="bi bi-emoji-frown" style="font-size: 3rem; display: block; margin-bottom: 1rem; color: #94a3b8;"></i>
                        <p style="font-size: 1.1rem; font-weight: 600;">No specialist matching your search was found.</p>
                    </div>
                }
            }

            <div class="step-actions">
                <div></div>
                <button type="button" class="btn-next" @onclick="GoToStep2" disabled="@(selectedDoctor == null)">
                    Next Step <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </div>
    }

    <!-- STEP 2: CHOOSE DATE & SLOT -->
    @if (currentStep == 2)
    {
        <div class="glass-card">
            <div class="date-selector-title">
                <i class="bi bi-calendar-event"></i>
                <span>Choose Appointment Date</span>
            </div>

            <!-- Date strip horizontal selector -->
            <div class="date-strip-wrapper">
                <div class="date-strip">
                    @foreach (var date in upcomingDates)
                    {
                        var isSelected = date.Date == selectedDate.Date;
                        <div class="date-strip-item @(isSelected ? "selected" : "")" @onclick="() => SelectDate(date)">
                            <span class="date-day-name">@date.ToString("ddd")</span>
                            <span class="date-day-num">@date.Day</span>
                            <span class="date-month-name">@date.ToString("MMM")</span>
                        </div>
                    }
                </div>
            </div>

            <div class="slots-container-header">
                <div class="date-selector-title">
                    <i class="bi bi-clock"></i>
                    <span>Available Slots on @selectedDate.ToString("MMMM dd, yyyy")</span>
                </div>
                <div style="font-size: 0.85rem; color: #64748b; font-weight: 600;">
                    Consultant: <span style="color: #026aa7;">Dr. @(selectedDoctor?.name ?? selectedDoctor?.doctorfullname)</span>
                </div>
            </div>

            @if (loadingSlots)
            {
                <div style="text-align: center; padding: 2rem; color: #026aa7;">
                    <div class="spinner-border spinner-border-sm" role="status" style="margin-right: 8px;"></div>
                    <span style="font-weight: 600;">Finding available consultation slots...</span>
                </div>
            }
            else
            {
                @if (availableSlots.Any())
                {
                    <div class="slots-grid">
                        @foreach (var slot in availableSlots)
                        {
                            var isSlotSelected = selectedSlot?.slot_detail_id == slot.slot_detail_id;
                            var onlineLeft = slot.remaining_online > 0 ? slot.remaining_online : (slot.max_online > 0 ? Math.Max(0, slot.max_online - slot.online_count) : Math.Max(0, slot.remaining_seats));
                            var isOnlineFull = onlineLeft <= 0;
                            <div class="slot-time-card @(isSlotSelected ? "selected" : "") @(isOnlineFull ? "disabled" : "")" 
                                 @onclick="() => { if (!isOnlineFull) SelectSlot(slot); }">
                                <div class="slot-card-header">
                                    <i class="bi bi-clock slot-time-icon"></i>
                                    <span class="slot-time-text">@FormatTime(slot.slot_start_time) - @FormatTime(slot.slot_end_time)</span>
                                </div>
                                <div class="slot-card-footer">
                                    @if (isOnlineFull)
                                    {
                                        <span class="slot-status-badge status-full">
                                            <i class="bi bi-x-circle-fill"></i> Full
                                        </span>
                                    }
                                    else
                                    {
                                        var isLow = onlineLeft <= 2;
                                        <span class="slot-status-badge @(isLow ? "status-low" : "status-available")">
                                            <i class="bi @(isLow ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")"></i>
                                            @onlineLeft @(onlineLeft == 1 ? "seat" : "seats") left
                                        </span>
                                    }
                                    <span class="slot-token-info">
                                        Token #@(slot.booked_count + 1)
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-slots-alert">
                        <i class="bi bi-calendar-x" style="font-size: 2.5rem; display: block; margin-bottom: 0.75rem; opacity: 0.8;"></i>
                        <span>No slots found for this doctor on this day. Please pick a different date.</span>
                    </div>
                }
            }

            <div class="step-actions">
                <button type="button" class="btn-prev" @onclick="PrevStep">
                    <i class="bi bi-arrow-left"></i> Previous Step
                </button>
                <button type="button" class="btn-next" @onclick="GoToStep3" disabled="@(selectedSlot == null)">
                    Next Step <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </div>
    }

    <!-- STEP 3: DETAILS & CONFIRMATION -->
    @if (currentStep == 3)
    {
        <div class="glass-card">
            <div class="date-selector-title">
                <i class="bi bi-card-list"></i>
                <span>Review & Patient Information</span>
            </div>

            <!-- Booking Summary -->
            <div class="summary-panel">
                <div class="summary-title">Booking Summary</div>
                <div class="summary-grid">
                    <div class="summary-item">
                        <span class="summary-label">Specialist</span>
                        <span class="summary-value">Dr. @(selectedDoctor?.name ?? selectedDoctor?.doctorfullname)</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Specialty</span>
                        <span class="summary-value">@(selectedDoctor?.reference ?? "General Consultant")</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Appointment Date</span>
                        <span class="summary-value">@selectedDate.ToString("dddd, MMMM dd, yyyy")</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Time Slot</span>
                        <span class="summary-value">
                            @FormatTime(selectedSlot!.slot_start_time) - @FormatTime(selectedSlot.slot_end_time)
                        </span>
                    </div>
                </div>
            </div>

            <!-- Inputs -->
            <div class="form-group">
                <label for="patientId">Customer / Patient ID</label>
                <input type="number" id="patientId" class="form-input" @bind="bookingModel.custid" />
                <span style="font-size: 0.75rem; color: #64748b; font-weight: 600; margin-top: 0.25rem; display: block;">
                    Enter your Medico customer account code (e.g. 1001)
                </span>
            </div>

            <div class="form-group">
                <label for="notes">Notes / Symptoms / Reason for Visit</label>
                <textarea id="notes" class="form-input form-textarea" placeholder="Describe symptoms or reason for consulting the doctor..." @bind="bookingModel.notes"></textarea>
            </div>

            <div class="step-actions">
                <button type="button" class="btn-prev" @onclick="PrevStep">
                    <i class="bi bi-arrow-left"></i> Previous Step
                </button>
                <button type="button" class="btn-next" @onclick="SubmitBookingAsync" disabled="@bookingInProgress">
                    @if (bookingInProgress)
                    {
                        <div class="spinner-border spinner-border-sm" role="status" style="margin-right: 6px;"></div>
                        <span>Processing Booking...</span>
                    }
                    else
                    {
                        <span>Confirm Booking <i class="bi bi-check-circle"></i></span>
                    }
                </button>
            </div>
        </div>
    }
</div>

<!-- SUCCESS POPUP MODAL -->
@if (showSuccessPopup)
{
    <div class="success-overlay">
        <div class="success-card">
            <div class="success-icon-wrapper">
                <svg class="checkmark-svg" viewBox="0 0 52 52">
                    <circle class="checkmark-circle" cx="26" cy="26" r="25" />
                    <path class="checkmark-check" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
                </svg>
            </div>
            <h2>Booking Confirmed!</h2>
            <p>Your appointment has been successfully scheduled.</p>

            <div class="success-details">
                <div class="success-detail-row">
                    <span>Consultant:</span>
                    <span>Dr. @(selectedDoctor?.name ?? selectedDoctor?.doctorfullname)</span>
                </div>
                <div class="success-detail-row">
                    <span>Date:</span>
                    <span>@selectedDate.ToString("dd MMM yyyy")</span>
                </div>
                <div class="success-detail-row">
                    <span>Time Slot:</span>
                    <span>@FormatTime(selectedSlot!.slot_start_time) - @FormatTime(selectedSlot.slot_end_time)</span>
                </div>
                <div class="success-detail-row" style="border-top: 1px dashed #cbd5e1; margin-top: 0.5rem; padding-top: 0.5rem;">
                    <span>Booking ID:</span>
                    <span style="font-size: 0.7rem; color: #475569;">@successBookingId</span>
                </div>
            </div>

            <button type="button" class="btn-success-close" @onclick="CloseSuccess">
                Back to Home
            </button>
        </div>
    </div>
}

@code {
    private int currentStep = 1;
    private bool loading = true;
    private bool loadingSlots = false;
    private bool bookingInProgress = false;
    private string searchQuery = string.Empty;

    private List<DoctorMasterModel> doctors = new();
    private DoctorMasterModel? selectedDoctor;

    private List<DateTime> upcomingDates = new();
    private DateTime selectedDate = DateTime.Today;

    private List<AvailableSlotModel> availableSlots = new();
    private AvailableSlotModel? selectedSlot;

    private AppointmentBookingModel bookingModel = new() { custid = 1001 };

    // Success popup state
    private bool showSuccessPopup = false;
    private int successToken = 0;
    private Guid successBookingId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctorsAsync();
        GenerateUpcomingDates();
    }

    private async Task LoadDoctorsAsync()
    {
        loading = true;
        try
        {
            var rawDoctors = await DoctorService.GetDoctorsAsync();
            doctors = rawDoctors
                .Where(d => !d.deleted)
                .OrderBy(d => string.IsNullOrWhiteSpace(d.name) ? d.doctorfullname : d.name)
                .ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load doctors: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void GenerateUpcomingDates()
    {
        upcomingDates.Clear();
        for (int i = 0; i < 14; i++)
        {
            upcomingDates.Add(DateTime.Today.AddDays(i));
        }
        selectedDate = DateTime.Today;
    }

    private List<DoctorMasterModel> GetFilteredDoctors()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            return doctors;
        }
        return doctors
            .Where(d => (d.name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (d.doctorfullname?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (d.reference?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();
    }

    private async Task SelectDoctor(DoctorMasterModel doc)
    {
        selectedDoctor = doc;
        selectedSlot = null;
        availableSlots.Clear();
        StateHasChanged();
        await GoToStep2();
    }

    private async Task GoToStep2()
    {
        if (selectedDoctor == null)
        {
            ToastService.ShowError("Please choose a medical specialist.");
            return;
        }
        currentStep = 2;
        await LoadAvailableSlotsAsync();
    }

    private async Task SelectDate(DateTime date)
    {
        selectedDate = date;
        selectedSlot = null;
        await LoadAvailableSlotsAsync();
    }

    private async Task LoadAvailableSlotsAsync()
    {
        if (selectedDoctor == null) return;
        loadingSlots = true;
        availableSlots.Clear();
        try
        {
            var allSlots = await BookingService.GetAvailableSlotsAsync(selectedDoctor.dcode, DateOnly.FromDateTime(selectedDate));
            var today = DateOnly.FromDateTime(DateTime.Today);
            var nowTime = TimeOnly.FromDateTime(DateTime.Now);
            availableSlots = allSlots.Where(s => s.appointment_date > today || (s.appointment_date == today && s.slot_end_time > nowTime)).ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to retrieve available slots: {ex.Message}");
        }
        finally
        {
            loadingSlots = false;
        }
    }

    private void SelectSlot(AvailableSlotModel slot)
    {
        selectedSlot = slot;
    }

    private void GoToStep3()
    {
        if (selectedSlot == null)
        {
            ToastService.ShowError("Please choose a time slot.");
            return;
        }
        currentStep = 3;
    }

    private void PrevStep()
    {
        if (currentStep > 1)
        {
            currentStep--;
        }
    }

    private async Task SubmitBookingAsync()
    {
        if (bookingModel.custid <= 0)
        {
            ToastService.ShowError("Please enter a valid Patient/Customer ID.");
            return;
        }

        if (selectedDoctor == null || selectedSlot == null)
        {
            ToastService.ShowError("Invalid booking state. Please restart.");
            return;
        }

        bookingInProgress = true;
        try
        {
            bookingModel.booking_id = Guid.NewGuid();
            bookingModel.dcode = selectedDoctor.dcode;
            bookingModel.slot_detail_id = selectedSlot.slot_detail_id;
            bookingModel.slot_master_id = selectedSlot.slot_master_id;
            bookingModel.appointment_date = selectedSlot.appointment_date;
            bookingModel.slot_start_time = selectedSlot.slot_start_time;
            bookingModel.slot_end_time = selectedSlot.slot_end_time;
            bookingModel.booking_type = "ONLINE";
            bookingModel.booking_status = "BOOKED";
            bookingModel.isdeleted = false;
            bookingModel.created_at = DateTime.SpecifyKind(DateTime.UtcNow, DateTimeKind.Utc);
            bookingModel.updated_at = DateTime.SpecifyKind(DateTime.UtcNow, DateTimeKind.Utc);

            bookingModel.tenant_code = TenantState?.TenantCode;

            int? deptCode = selectedDoctor.spcode > 0 ? selectedDoctor.spcode : 3;

            var (result, opResult, tokenNo, bookingId) = await BookingService.BookAppointmentWithOpRegistrationAsync(bookingModel, deptCode);

            // Parsing output: "Success|Token:1|BookingId:4698bdca-faad-4662-a344-ae2a3997a346"
            if (result.StartsWith("Success", StringComparison.OrdinalIgnoreCase))
            {
                successToken = tokenNo;
                successBookingId = bookingId;

                showSuccessPopup = true;
                ToastService.ShowSuccess("Appointment booked successfully with OP Registration!");
            }
            else
            {
                ToastService.ShowError($"Booking failed: {result}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Booking failed: {ex.Message}");
        }
        finally
        {
            bookingInProgress = false;
        }
    }

    private void CloseSuccess()
    {
        showSuccessPopup = false;
        selectedDoctor = null;
        selectedSlot = null;
        bookingModel = new AppointmentBookingModel { custid = 1001 };
        searchQuery = string.Empty;
        currentStep = 1;
        Navigation.NavigateTo("/booking/patient");
    }

    private string FormatTime(TimeOnly time)
    {
        return time.ToString("hh:mm tt");
    }
}
