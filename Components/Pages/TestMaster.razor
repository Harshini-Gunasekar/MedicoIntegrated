    private CancellationTokenSource _cts = new();
    private bool _isDisposed = false;

    private readonly Dictionary<long, string> _inlineSaveStatus = new();
    private readonly Dictionary<long, System.Threading.CancellationTokenSource> _pendingTestSaves = new();

    private void HandleInlineEdit(test_master test, string fieldName, object? value)
    {
        if (_isDisposed) return;
        switch (fieldName)
        {
            case "orderno":
                if (int.TryParse(value?.ToString(), out int orderVal))
                    test.orderno = orderVal;
                break;
            case "shortname":
                test.shortname = value?.ToString() ?? "";
                break;
            case "name":
                test.name = value?.ToString() ?? "";
                break;
            case "amount":
                if (double.TryParse(value?.ToString(), out double amtVal))
                    test.amount = amtVal;
                break;
        }
        QueueAutoSave(test);
    }

    private void QueueAutoSave(test_master test)
    {
        if (_isDisposed) return;
        var tcode = test.tcode;
        if (_pendingTestSaves.TryGetValue(tcode, out var existingCts))
        {
            try { existingCts.Cancel(); } catch { }
            existingCts.Dispose();
        }

        var cts = new System.Threading.CancellationTokenSource();
        _pendingTestSaves[tcode] = cts;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(1000, cts.Token);
                await SaveTestInlineAsync(test, cts.Token);
            }
            catch (TaskCanceledException)
            {
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[InlineAutoSave] Error saving test {tcode}: {ex.Message}");
            }
        });
    }

    private async Task SaveTestInlineAsync(test_master test, System.Threading.CancellationToken token)
    {
        if (_isDisposed || token.IsCancellationRequested) return;
        var tcode = test.tcode;
        _inlineSaveStatus[tcode] = "saving";
        await InvokeAsync(StateHasChanged);

        var fullDto = await TestSvc.GetTestResultAsync(tcode);
        if (fullDto == null)
        {
            fullDto = new TestInsertDto
            {
                TestMaster = test,
                ResultRows = new()
            };
        }
        else
        {
            if (string.IsNullOrEmpty(fullDto.TestMaster.name))      fullDto.TestMaster.name      = test.name;
            if (string.IsNullOrEmpty(fullDto.TestMaster.shortname)) fullDto.TestMaster.shortname = test.shortname;
            if (string.IsNullOrEmpty(fullDto.TestMaster.qty))       fullDto.TestMaster.qty       = test.qty;
            if (string.IsNullOrEmpty(fullDto.TestMaster.icd_code))  fullDto.TestMaster.icd_code  = test.icd_code;
            if (fullDto.TestMaster.gcode   == 0) fullDto.TestMaster.gcode   = test.gcode;
            if (fullDto.TestMaster.scode   == 0) fullDto.TestMaster.scode   = test.scode;
            if (fullDto.TestMaster.rtmcode == 0) fullDto.TestMaster.rtmcode = test.rtmcode;
            if (fullDto.TestMaster.ucode   == 0) fullDto.TestMaster.ucode   = test.ucode;
            if (fullDto.TestMaster.rtcode  == 0) fullDto.TestMaster.rtcode  = test.rtcode;
            if (fullDto.TestMaster.ttid    == 0) fullDto.TestMaster.ttid    = test.ttid;

            fullDto.TestMaster.orderno = test.orderno;
            fullDto.TestMaster.shortname = test.shortname;
            fullDto.TestMaster.name = test.name;
            fullDto.TestMaster.amount = test.amount;
        }

        fullDto.TestMaster.tenant_code ??= TenantState.TenantCode;
        if (fullDto.TestMaster.usercode == null || fullDto.TestMaster.usercode == 0)
        {
            fullDto.TestMaster.usercode = 1;
        }
        fullDto.TestMaster.computercode ??= 1;
        fullDto.TestMaster.entereddate ??= test.entereddate ?? DateTime.Now;
        fullDto.TestMaster.ibsdate = DateTime.Now;

        if (token.IsCancellationRequested || _isDisposed) return;

        var ok = await TestSvc.UpdateTestAsync(fullDto);
        if (!_isDisposed)
        {
            if (ok)
            {
                _inlineSaveStatus[tcode] = "saved";
                _ = Task.Run(async () =>
                {
                    await Task.Delay(2000);
                    if (!_isDisposed && _inlineSaveStatus.TryGetValue(tcode, out var current) && current == "saved")
                    {
                        _inlineSaveStatus.Remove(tcode);
                        await InvokeAsync(StateHasChanged);
                    }
                });
            }
            else
            {
                _inlineSaveStatus[tcode] = "error";
                Toast.Error($"Failed to auto-save changes for {test.name}");
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _isDisposed = true;
        try { _cts.Cancel(); } catch { }
        _cts.Dispose();

        foreach (var cts in _pendingTestSaves.Values)
        {
            try { cts.Cancel(); } catch { }
            cts.Dispose();
        }
        _pendingTestSaves.Clear();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (_isDisposed) return;
                
                var tenantCodeResult = await SessionStorage.GetAsync<string>("tenant_code");
                if (_isDisposed) return;
                string tCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await SessionStorage.GetAsync<string>("tenant_name");
                if (_isDisposed) return;
                string tName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await SessionStorage.GetAsync<string>("authToken");
                if (_isDisposed) return;
                string authTok = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(authTok))
                {
                    TenantState.SetSession(tCode, authTok, tName);
                    await LoadTests();
                    if (_isDisposed) return;
                    await LoadSpecimens();
                    if (_isDisposed) return;
                    await LoadMachines();
                    if (_isDisposed) return;
                    await LoadMethods();
                    if (_isDisposed) return;
                    await LoadUnits();
                    if (_isDisposed) return;
                    await LoadGroups();
                    if (_isDisposed) return;
                    await LoadTestTypes();
                    if (_isDisposed) return;
                    await LoadReportings();
                    if (_isDisposed) return;
                    await LoadUsers();
                    if (_isDisposed) return;
                    
                    if (testData.ResultRows == null || !testData.ResultRows.Any()) AddTestRow();
                    StateHasChanged();
                }
                else
                {
                    Toast.Error("Access denied: Missing valid session. Please log in again.");
                }
            }
            catch (Exception ex)
            {
                /* Console.WriteLine($"Error loading session data: {ex.Message}") */;
            }
        }
    }

