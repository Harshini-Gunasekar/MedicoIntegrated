    private async Task UpdateTest()
    {
        IsLoading = true;
        try {
            if (!string.IsNullOrWhiteSpace(reportingSearchText))
            {
                var existing = reportings.FirstOrDefault(r => r.name != null && r.name.Equals(reportingSearchText, StringComparison.OrdinalIgnoreCase));
                if (existing != null)
                {
                    testData.TestMaster.rtcode = existing.recode;
                }
                else
                {
                    var newReporting = new ReportingModel
                    {
                        name = reportingSearchText,
                        tenant_code = TenantState.TenantCode
                    };
                    try
                    {
                        var newRecode = await TestSvc.InsertReportingAsync(newReporting);
                        if (newRecode > 0)
                        {
                            testData.TestMaster.rtcode = newRecode;
                            newReporting.recode = newRecode;
                            reportings.Add(newReporting);
                        }
                    }
                    catch (Exception)
                    {
                        Toast.Warning("Could not create new reporting template. Saving test with no reporting format.");
                        testData.TestMaster.rtcode = 0;
                    }
                }
            }
            else
            {
                testData.TestMaster.rtcode = 0;
            }

            if (testData.TestMaster.tcode == 0 && !string.IsNullOrWhiteSpace(testData.TestMaster.name))
            {
                var existing = allTests.FirstOrDefault(t => t.name.Equals(testData.TestMaster.name, StringComparison.OrdinalIgnoreCase));
                if (existing != null)
                {
                    Toast.Error($"Test name '{existing.name}' already exists. Please load it to edit.");
                    IsLoading = false;
                    return;
                }
            }

            if (testData.TestMaster.ttid == 0)
            {
                Toast.Error("Please select a valid TEST TYPE before saving.");
                IsLoading = false;
                return;
            }

            testData.TestMaster.tenant_code = TenantState.TenantCode;
            if (testData.TestMaster.usercode == null || testData.TestMaster.usercode == 0)
            {
                testData.TestMaster.usercode = 1;
            }
            testData.TestMaster.computercode = 1;
            testData.TestMaster.entereddate ??= DateTime.Now;
            testData.TestMaster.ibsdate      = DateTime.Now;

            void PopulateRowDefaults()
            {
                if (testData.ResultRows == null) return;
                for (int i = 0; i < testData.ResultRows.Count; i++)
                {
                    var row = testData.ResultRows[i];
                    row.ResultMaster.slno = i + 1;
                    row.ResultMaster.tcode        = testData.TestMaster.tcode;
                    row.ResultMaster.tenant_code  = TenantState.TenantCode;
                    row.ResultMaster.usercode     = 1;
                    row.ResultMaster.computercode = 1;
                    row.ResultMaster.entereddate  ??= DateTime.Now;
                    row.ResultMaster.ibsdate       = DateTime.Now;

                    if (row.ResultProperties != null)
                    {
                        row.ResultProperties.tenant_code      = TenantState.TenantCode;
                        row.ResultProperties.testresultid     = row.ResultMaster.testresultid;
                        row.ResultProperties.entereddate      ??= DateTime.Now;
                        row.ResultProperties.rtmcode          ??= 0;
                        row.ResultProperties.mccode           ??= 0;
                        row.ResultProperties.scode            ??= 0;
                        row.ResultProperties.defaultunitscode ??= 0;
                        row.ResultProperties.decimalvalue     ??= 0;
                        row.ResultProperties.fromnormalvalue  ??= 0;
                        row.ResultProperties.tonormalvalue    ??= 0;
                    }

                    if (row.CalculatedFormulas != null)
                        foreach (var f in row.CalculatedFormulas)
                        { f.tenant_code = TenantState.TenantCode; f.testresultid = row.ResultMaster.testresultid; f.entereddate ??= DateTime.Now; }

                    if (row.DetailedNormalValues != null)
                        foreach (var d in row.DetailedNormalValues)
                        { d.tenant_code = TenantState.TenantCode; d.testresultid = row.ResultMaster.testresultid; d.entereddate ??= DateTime.Now; }

                    if (row.TextNormalValues != null)
                        foreach (var t in row.TextNormalValues)
                        { t.tenant_code = TenantState.TenantCode; t.testresultid = row.ResultMaster.testresultid; t.entereddate ??= DateTime.Now; }
                }
            }

            bool ok;

            if (testData.TestMaster.tcode == 0)
            {
                PopulateRowDefaults();   
                var insertDto = new TestInsertDto
                {
                    TestMaster = testData.TestMaster,
                    ResultRows = testData.ResultRows ?? new()
                };
                ok = await TestSvc.InsertTestAsync(insertDto);
                if (!ok) throw new Exception("Insert failed");

                long assignedTcode = insertDto.TestMaster.tcode;
                testData.TestMaster.tcode = assignedTcode;
            }
            else
            {
                PopulateRowDefaults();
                ok = await TestSvc.UpdateTestAsync(testData);
            }

            if (ok)
            {
                Toast.Success("Test Saved");

                await LoadTests();

                long tcodeToLoad = testData.TestMaster.tcode;
                test_master? savedMaster = allTests.FirstOrDefault(t => t.tcode == tcodeToLoad);

                if (savedMaster == null && !string.IsNullOrWhiteSpace(testData.TestMaster.name))
                    savedMaster = allTests.FirstOrDefault(t => t.name.Equals(testData.TestMaster.name, StringComparison.OrdinalIgnoreCase));

                if (savedMaster != null)
                    await SelectTest(savedMaster);
            }
            else
            {
                Toast.Error("Failed to save");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally { IsLoading = false; StateHasChanged(); }
    }

