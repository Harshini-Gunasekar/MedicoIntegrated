@page "/test-masters"
@page "/test-master"
@rendermode InteractiveServer

@using Booking.Models
@using Booking.Services
@inject TestMasterService TestMasterSvc
@inject GroupMasterService GroupSvc
@inject SampleMasterService SampleSvc
@inject UomMasterService UomSvc
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div class="tm-elite-container lc-fadeInUp">
    @if (isListView)
    {
        @* --- HEADER CONSOLE --- *@
        <div class="lab-header-card flex-between" style="margin: 24px 24px 0 24px;">
            <div class="display-flex align-center gap-16">
                <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container" style="background-color: #eef2ff; border-radius: 8px; padding: 8px;">
                    <span class="material-symbols-outlined text-indigo-600 icon-lg" style="font-size: 24px; color: #4f46e5;">list_alt</span>
                </div>
                <div>
                    <h2 class="lab-title-text m-0" style="color: #312e81; font-size: 1.25rem; font-weight: 800; margin: 0;">Test Master</h2>
                    <div class="flex-start gap-8 mt-2px" style="display: flex; align-items: center; gap: 8px; margin-top: 2px;">
                        <span class="status-pulse-dot" style="width: 8px; height: 8px; background: #10b981; border-radius: 50%; display: inline-block;"></span>
                        <span class="status-text" style="font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase;">Available Tests: @allTests.Count</span>
                    </div>
                </div>
            </div>
            <div class="display-flex align-center gap-12" style="display: flex; align-items: center; gap: 12px;">
                <div class="relative-positioned" style="position: relative;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); z-index: 2;">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                    </svg>
                    <input type="text" placeholder="Search tests..." @bind="searchQuery" @bind:event="oninput" class="lc-rounded-pill-input lc-w-220" style="border-radius: 9999px; border: 1px solid #e2e8f0; padding: 8px 16px 8px 36px; font-size: 13px; outline: none; width: 220px; color: #334155;" />
                </div>
                <div>
                    <button class="btn-new-entry" @onclick="GoToEditor" style="background: linear-gradient(135deg, #5c5cfc 0%, #4f46e5 100%); color: white; border: none; font-weight: 700; font-size: 14px; cursor: pointer; padding: 8px 20px; border-radius: 9999px; box-shadow: 0 4px 10px rgba(92, 92, 252, 0.25);">+ Add New</button>
                </div>
            </div>
        </div>

        @* --- DIRECTORY LIST --- *@
        <div class="directory-section" style="margin: 16px 24px 24px 24px; background: white; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;">
            <div class="lc-table-container" style="width: 100%; overflow-x: auto;">
                <table class="lc-table" style="width: 100%; border-collapse: collapse; text-align: left;">
                    <thead>
                        <tr style="background: #fafbfc; border-bottom: 2px solid #e2e8f0;">
                            <th style="padding: 1rem 1.5rem; font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; width: 80px;">ORDER NO</th>
                            <th style="padding: 1rem 1.5rem; font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; width: 120px;">SHORT NAME</th>
                            <th style="padding: 1rem 1.5rem; font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase;">TEST NAME</th>
                            <th style="padding: 1rem 1.5rem; font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; width: 180px;">GROUP NAME</th>
                            <th style="padding: 1rem 1.5rem; font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; width: 120px; text-align: right;">AMOUNT</th>
                            <th style="padding: 1rem 1.5rem; font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; width: 120px; text-align: center;">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (allTests != null && allTests.Any())
                        {
                            @foreach (var test in FilteredTests)
                            {
                                <tr class="lc-table-row" style="border-bottom: 1px solid #f1f5f9; transition: background 0.2s;">
                                    <td style="padding: 1.25rem 1.5rem; font-size: 14px;">
                                        <input type="number" class="tm-inline-input" style="color: #4f46e5; font-weight: 700;" value="@test.orderno" @onchange="@(e => UpdateInline(test, "orderno", e.Value))" />
                                    </td>
                                    <td style="padding: 1.25rem 1.5rem; font-size: 13px; font-family: monospace; font-weight: 700; color: #64748b;">
                                        <input type="text" class="tm-inline-input" value="@test.shortname" @onchange="@(e => UpdateInline(test, "shortname", e.Value))" />
                                    </td>
                                    <td style="padding: 1.25rem 1.5rem; font-size: 14px; font-weight: 700; color: #1e293b;">
                                        <div class="display-flex align-center gap-12" style="display: flex; align-items: center; gap: 12px; width: 100%;">
                                            @if (test.scode > 0 && specimens.Any(s => s.scode == test.scode))
                                            {
                                                <div style="background: #fff1f2; color: #e11d48; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 800; flex-shrink: 0;">
                                                    @specimens.First(s => s.scode == test.scode).name?.ToUpper()
                                                </div>
                                            }
                                            <input type="text" class="tm-inline-input flex-1" value="@test.name" @onchange="@(e => UpdateInline(test, "name", e.Value))" style="font-weight: 700; color: #1e293b;" />
                                        </div>
                                    </td>
                                    <td style="padding: 1.25rem 1.5rem; font-size: 14px; color: #64748b;">
                                        @(groups.FirstOrDefault(g => g.gcode == test.gcode)?.name ?? "-")
                                    </td>
                                    <td style="padding: 1.25rem 1.5rem; font-size: 14px; text-align: right; font-weight: 700; color: #1e293b;">
                                        <input type="number" step="0.01" class="tm-inline-input text-right" value="@test.amount" @onchange="@(e => UpdateInline(test, "amount", e.Value))" style="text-align: right;" />
                                    </td>
                                    <td style="padding: 1.25rem 1.5rem; text-align: center; vertical-align: middle;">
                                        <div style="display: flex; justify-content: center; align-items: center; gap: 8px;">
                                            @if (inlineSavingState.TryGetValue(test.tcode, out var saveStatus))
                                            {
                                                @if (saveStatus == "saving")
                                                {
                                                    <span class="material-symbols-outlined tm-spin-animate" style="font-size: 16px; color: #6366f1;" title="Saving changes...">sync</span>
                                                }
                                                else if (saveStatus == "saved")
                                                {
                                                    <span class="material-symbols-outlined" style="font-size: 16px; color: #10b981;" title="Changes saved">check_circle</span>
                                                }
                                                else if (saveStatus == "error")
                                                {
                                                    <span class="material-symbols-outlined" style="font-size: 16px; color: #ef4444;" title="Save failed">error</span>
                                                }
                                            }
                                            <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => EditTest(test)" title="Edit" style="width: 32px; height: 32px; border-radius: 50%; border: 1px solid #e2e8f0; background: white; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;">
                                                <span class="material-symbols-outlined font-18" style="font-size: 18px; color: #94a3b8;">edit</span>
                                            </button>
                                            <button type="button" class="lc-btn lc-circle-btn-32" @onclick="() => DeleteTest(test.tcode)" title="Delete" style="width: 32px; height: 32px; border-radius: 50%; border: 1px solid #e2e8f0; background: white; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;">
                                                <span class="material-symbols-outlined font-18" style="font-size: 18px; color: #94a3b8;">delete</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center p-48 text-slate-400 italic" style="text-align: center; padding: 48px; color: #94a3b8; font-style: italic;">No test records found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        @* --- EDITOR VIEW --- *@
        <div class="tm-elite-header">
            <div class="display-flex align-center gap-12">
                <button type="button" class="tm-btn-outline" style="padding: 4px 8px; display: flex; align-items: center; justify-content: center;" @onclick="GoToList">
                    <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
                </button>
                <h1 style="font-size: 18px; font-weight: 900; color: #1e293b; margin: 0; text-transform: uppercase;">
                    @(isEditMode ? "EDIT TEST: " + current.name : "TEST CONSTRUCTION")
                </h1>
            </div>
        </div>

        <div class="tm-elite-content">
            <EditForm Model="current" OnValidSubmit="SaveTest">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger" />

                <div class="tm-elite-grid-top" style="grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));">
                    
                    @* --- TEST DETAILS CARD --- *@
                    <div class="tm-elite-card">
                        <div class="tm-elite-card-title">
                            <div style="background: #f5f3ff; padding: 6px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                <span class="material-symbols-outlined font-18" style="color: #4f46e5;">medical_services</span>
                            </div>
                            TEST DETAILS
                        </div>
                        
                        <div class="tm-elite-form-group">
                            <label class="tm-elite-label">TEST NAME *</label>
                            <InputText class="tm-elite-input" @bind-Value="current.name" placeholder="e.g. Complete Blood Count" />
                        </div>
                        
                        <div class="display-flex gap-12 mb-16" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                            <div>
                                <label class="tm-elite-label">SHORT NAME</label>
                                <InputText class="tm-elite-input" @bind-Value="current.shortname" placeholder="e.g. CBC" />
                            </div>
                            <div>
                                <label class="tm-elite-label">AMOUNT</label>
                                <InputNumber class="tm-elite-input" @bind-Value="current.amount" />
                            </div>
                        </div>

                        <div class="display-flex gap-12 mb-16" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                            <div>
                                <label class="tm-elite-label">SAMPLE TYPE</label>
                                <InputSelect class="tm-elite-input" @bind-Value="current.scode">
                                    <option value="0">Select Specimen</option>
                                    @foreach (var s in specimens)
                                    {
                                        <option value="@s.scode">@s.name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div>
                                <label class="tm-elite-label">GROUP</label>
                                <InputSelect class="tm-elite-input" @bind-Value="current.gcode">
                                    <option value="0">Select Group</option>
                                    @foreach (var g in groups)
                                    {
                                        <option value="@g.gcode">@g.name</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="display-flex gap-12 mb-16" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                            <div>
                                <label class="tm-elite-label">ORDER NO</label>
                                <InputNumber class="tm-elite-input" @bind-Value="current.orderno" />
                            </div>
                            <div>
                                <label class="tm-elite-label">UNIT / UOM</label>
                                <InputSelect class="tm-elite-input" @bind-Value="current.ucode">
                                    <option value="0">Select Unit</option>
                                    @foreach (var u in units)
                                    {
                                        <option value="@u.ucode">@u.name</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    </div>

                    @* --- CLASSIFICATION & DETAILS CARD --- *@
                    <div class="tm-elite-card">
                        <div class="tm-elite-card-title">
                            <div style="background: #f5f3ff; padding: 6px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                <span class="material-symbols-outlined font-18" style="color: #4f46e5;">clinical_notes</span>
                            </div>
                            CLASSIFICATION / TYPE
                        </div>

                        <div class="tm-elite-form-group">
                            <label class="tm-elite-label">REPORT FORMAT / METHOD</label>
                            <InputSelect class="tm-elite-input" @bind-Value="current.rtmcode">
                                <option value="0">Select Method</option>
                                @foreach (var m in methods)
                                {
                                    <option value="@m.rtmcode">@m.name</option>
                                }
                            </InputSelect>
                        </div>

                        <div style="margin-top: 16px;">
                            <label class="tm-elite-label">TEST CLASSIFICATION FLAGS</label>
                            <div class="tm-elite-checkbox-group">
                                <div class="tm-elite-checkbox-item @(current.Routine == true ? "active" : "")" @onclick="() => current.Routine = !(current.Routine ?? false)">
                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                                    <span class="tm-elite-checkbox-label">Routine</span>
                                </div>
                                <div class="tm-elite-checkbox-item @(current.outlab == true ? "active" : "")" @onclick="() => current.outlab = !(current.outlab ?? false)">
                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                                    <span class="tm-elite-checkbox-label">Outlab</span>
                                </div>
                                <div class="tm-elite-checkbox-item @(current.textcontent ? "active" : "")" @onclick="() => current.textcontent = !current.textcontent">
                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                                    <span class="tm-elite-checkbox-label">Text Content</span>
                                </div>
                                <div class="tm-elite-checkbox-item @(current.culturereport == true ? "active" : "")" @onclick="() => current.culturereport = !(current.culturereport ?? false)">
                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                                    <span class="tm-elite-checkbox-label">Culture Report</span>
                                </div>
                                <div class="tm-elite-checkbox-item @(current.istest == true ? "active" : "")" @onclick="() => current.istest = !(current.istest ?? false)">
                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                                    <span class="tm-elite-checkbox-label">Is Test</span>
                                </div>
                                <div class="tm-elite-checkbox-item @(current.ispackage == true ? "active" : "")" @onclick="TogglePackage">
                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                                    <span class="tm-elite-checkbox-label">Is Package</span>
                                </div>
                            </div>
                        </div>

                        @if (current.ispackage == true)
                        {
                            <div class="tm-elite-form-group mt-16" style="margin-top: 16px;">
                                <label class="tm-elite-label">PACKAGE CODE</label>
                                <InputNumber class="tm-elite-input" @bind-Value="current.packcode" />
                            </div>
                        }
                    </div>

                    @* --- GST DETAILS CARD --- *@
                    <div class="tm-elite-card">
                        <div class="tm-elite-card-title">
                            <div style="background: #f5f3ff; padding: 6px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                <span class="material-symbols-outlined font-18" style="color: #4f46e5;">percent</span>
                            </div>
                            GST DETAILS
                        </div>

                        <div class="display-flex gap-12 mb-16" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                            <div>
                                <label class="tm-elite-label">GST LEDGER CODE</label>
                                <InputNumber class="tm-elite-input" @bind-Value="current.gstlcode" />
                            </div>
                            <div>
                                <label class="tm-elite-label">GST PERCENTAGE (%)</label>
                                <InputNumber class="tm-elite-input" @bind-Value="current.gstper" @oninput="CalculateGstAmount" />
                            </div>
                        </div>

                        <div class="tm-elite-form-group">
                            <label class="tm-elite-label">GST AMOUNT</label>
                            <InputNumber class="tm-elite-input" @bind-Value="current.gstamount" />
                        </div>

                        <div class="display-flex gap-12 mb-16" style="display: grid; grid-template-columns: 1fr 1.5fr; gap: 12px; margin-bottom: 16px;">
                            <div>
                                <label class="tm-elite-label">HSN CODE</label>
                                <InputText class="tm-elite-input" @bind-Value="current.hsn" />
                            </div>
                            <div>
                                <label class="tm-elite-label">HSN DESCRIPTION</label>
                                <InputText class="tm-elite-input" @bind-Value="current.hsndescription" />
                            </div>
                        </div>
                    </div>

                    @* --- COMMISSIONS & DISCOUNTS CARD --- *@
                    <div class="tm-elite-card" style="grid-column: span 2;">
                        <div class="tm-elite-card-title">
                            <div style="background: #f5f3ff; padding: 6px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                <span class="material-symbols-outlined font-18" style="color: #4f46e5;">payments</span>
                            </div>
                            COMMISSIONS, CO-PAY & DISCOUNTS
                        </div>

                        <div class="tm-elite-checkbox-item @(current.isnodiscount ? "active" : "")" style="margin-bottom: 20px;" @onclick="() => current.isnodiscount = !current.isnodiscount">
                            <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                            <span class="tm-elite-checkbox-label">No discount allowed on this test</span>
                        </div>

                        <div class="display-flex gap-16" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
                            <div style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
                                <div class="commission-header">CC Details</div>
                                <div class="commission-body">
                                    <div class="tm-elite-form-group">
                                        <label class="tm-elite-label">CC Formula (CCF)</label>
                                        <InputText class="tm-elite-input" @bind-Value="current.ccf" />
                                    </div>
                                    <div class="tm-elite-form-group">
                                        <label class="tm-elite-label">CC Value (CCV)</label>
                                        <InputNumber class="tm-elite-input" @bind-Value="current.ccv" />
                                    </div>
                                    <div class="tm-elite-checkbox-item @(current.isccv == true ? "active" : "")" @onclick="() => current.isccv = !(current.isccv ?? false)">
                                        <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                                        <span class="tm-elite-checkbox-label">Is CCV active</span>
                                    </div>
                                </div>
                            </div>

                            <div style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
                                <div class="commission-header">CS Details</div>
                                <div class="commission-body">
                                    <div class="tm-elite-form-group">
                                        <label class="tm-elite-label">CS Formula (CSF)</label>
                                        <InputText class="tm-elite-input" @bind-Value="current.csf" />
                                    </div>
                                    <div class="tm-elite-form-group">
                                        <label class="tm-elite-label">CS Value (CSV)</label>
                                        <InputNumber class="tm-elite-input" @bind-Value="current.CSV" />
                                    </div>
                                    <div class="tm-elite-checkbox-item @(current.iscsv == true ? "active" : "")" @onclick="() => current.iscsv = !(current.iscsv ?? false)">
                                        <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                                        <span class="tm-elite-checkbox-label">Is CSV active</span>
                                    </div>
                                </div>
                            </div>

                            <div style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
                                <div class="commission-header">NC Details</div>
                                <div class="commission-body">
                                    <div class="tm-elite-form-group">
                                        <label class="tm-elite-label">NC Formula (NCF)</label>
                                        <InputText class="tm-elite-input" @bind-Value="current.ncf" />
                                    </div>
                                    <div class="tm-elite-form-group">
                                        <label class="tm-elite-label">NC Value (NCV)</label>
                                        <InputNumber class="tm-elite-input" @bind-Value="current.ncv" />
                                    </div>
                                    <div class="tm-elite-checkbox-item @(current.isncv == true ? "active" : "")" @onclick="() => current.isncv = !(current.isncv ?? false)">
                                        <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                                        <span class="tm-elite-checkbox-label">Is NCV active</span>
                                    </div>
                                </div>
                            </div>

                            <div style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
                                <div class="commission-header">HS / TC Details</div>
                                <div class="commission-body">
                                    <div class="tm-elite-form-group">
                                        <label class="tm-elite-label">HS Formula (HSF)</label>
                                        <InputText class="tm-elite-input" @bind-Value="current.hsf" />
                                    </div>
                                    <div class="tm-elite-form-group">
                                        <label class="tm-elite-label">HS Value (HSV)</label>
                                        <InputNumber class="tm-elite-input" @bind-Value="current.hsv" />
                                    </div>
                                    <div class="tm-elite-form-group">
                                        <label class="tm-elite-label">TC Formula (TCF)</label>
                                        <InputText class="tm-elite-input" @bind-Value="current.tcf" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* --- OPTIONS & EXTRA CARD --- *@
                    <div class="tm-elite-card">
                        <div class="tm-elite-card-title">
                            <div style="background: #f5f3ff; padding: 6px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                <span class="material-symbols-outlined font-18" style="color: #4f46e5;">settings</span>
                            </div>
                            LOCKING & OPTIONS
                        </div>

                        <div class="tm-elite-checkbox-group" style="flex-direction: column; gap: 12px;">
                            <div class="tm-elite-checkbox-item @(current.lockresult ? "active" : "")" @onclick="() => current.lockresult = !current.lockresult">
                                <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                                <span class="tm-elite-checkbox-label">Lock Result entry by default</span>
                            </div>
                            <div class="tm-elite-checkbox-item @(current.locksms == true ? "active" : "")" @onclick="() => current.locksms = !(current.locksms ?? false)">
                                <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                                <span class="tm-elite-checkbox-label">Lock SMS dispatch by default</span>
                            </div>
                            <div class="tm-elite-checkbox-item @(current.printinseparatepage == true ? "active" : "")" @onclick="() => current.printinseparatepage = !(current.printinseparatepage ?? false)">
                                <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                                <span class="tm-elite-checkbox-label">Print in separate page in reports</span>
                            </div>
                            <div class="tm-elite-checkbox-item @(current.printgraphinreport == true ? "active" : "")" @onclick="() => current.printgraphinreport = !(current.printgraphinreport ?? false)">
                                <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined" style="font-size: 14px; font-weight: bold;">check</i></div>
                                <span class="tm-elite-checkbox-label">Print graph in report</span>
                            </div>
                        </div>

                        <div class="tm-elite-form-group mt-16" style="margin-top: 16px;">
                            <label class="tm-elite-label">GRAPH TYPE</label>
                            <InputSelect class="tm-elite-input" @bind-Value="current.graphtype">
                                <option value="">Select Graph Type</option>
                                <option value="Bar">Bar Graph</option>
                                <option value="Line">Line Graph</option>
                                <option value="Trend">Trend Analysis</option>
                            </InputSelect>
                        </div>
                    </div>

                    @* --- DESCRIPTION CARD --- *@
                    <div class="tm-elite-card">
                        <div class="tm-elite-card-title">
                            <div style="background: #f5f3ff; padding: 6px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                <span class="material-symbols-outlined font-18" style="color: #4f46e5;">info</span>
                            </div>
                            ADDITIONAL NOTES & FOOTER
                        </div>

                        <div class="tm-elite-form-group">
                            <label class="tm-elite-label">QUANTITY / VOLUME (QTY)</label>
                            <InputText class="tm-elite-input" @bind-Value="current.qty" placeholder="e.g. 1 ml, 5 ml" />
                        </div>

                        <div class="tm-elite-form-group">
                            <label class="tm-elite-label">DESCRIPTION</label>
                            <textarea class="tm-elite-input" @bind="current.description" placeholder="Blood test details..." style="height: 60px; resize: vertical;"></textarea>
                        </div>

                        <div class="tm-elite-form-group">
                            <label class="tm-elite-label">TEST FOOTER MESSAGE</label>
                            <textarea class="tm-elite-input" @bind="current.footer" placeholder="Clinical notes or report guidelines..." style="height: 80px; resize: vertical;"></textarea>
                        </div>
                    </div>

                </div>

                @* --- ACTION FOOTER BAR --- *@
                <div class="tm-footer" style="margin-left: -24px; margin-right: -24px; margin-bottom: -100px;">
                    <div class="tm-footer-left">
                        <div class="tm-footer-item">
                            <span style="font-weight: 700; font-size: 11px; color: #64748b; margin-right: 8px;">RECORD STATUS:</span>
                            <span style="font-weight: 800; font-size: 13px; color: #4f46e5;">@(isEditMode ? "EXISTING TEST" : "NEW RECORD")</span>
                        </div>
                    </div>
                    <div class="tm-footer-right">
                        @if (isEditMode)
                        {
                            <button type="button" class="tm-btn-danger" @onclick="() => DeleteTest(current.tcode)">
                                <span class="material-symbols-outlined" style="font-size: 14px; margin-right: 4px; vertical-align: middle;">delete</span> DELETE
                            </button>
                        }
                        <button type="button" class="tm-btn-outline" @onclick="ResetForm">
                            <span class="material-symbols-outlined" style="font-size: 14px; margin-right: 4px; vertical-align: middle;">restart_alt</span> CLEAR
                        </button>
                        <button type="button" class="tm-btn-outline" @onclick="GoToList">
                            <span class="material-symbols-outlined" style="font-size: 14px; margin-right: 4px; vertical-align: middle;">close</span> CLOSE
                        </button>
                        <button type="submit" class="tm-btn-primary">
                            <span class="material-symbols-outlined" style="font-size: 14px; margin-right: 4px; vertical-align: middle;">save</span> SAVE TEST
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    private List<TestMasterModel> allTests = new();
    private TestMasterModel current = new();
    private List<GroupMasterModel> groups = new();
    private List<SampleMasterModel> specimens = new();
    private List<UomMasterModel> units = new();
    private List<Booking.Models.ReportMethodModel> methods = new();

    private bool isListView = true;
    private bool isEditMode = false;
    private string searchQuery = "";

    private Dictionary<decimal, string> inlineSavingState = new();

    private IEnumerable<TestMasterModel> FilteredTests =>
        allTests.Where(t => !t.deleted && (
            string.IsNullOrWhiteSpace(searchQuery) ||
            (t.name != null && t.name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (t.shortname != null && t.shortname.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (t.description != null && t.description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        ));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            allTests = await TestMasterSvc.GetTestMastersAsync();
            groups = await GroupSvc.GetGroupMastersAsync();
            specimens = await SampleSvc.GetSampleMastersAsync();
            units = await UomSvc.GetUomMastersAsync();
            methods = await ReportSvc_GetMethods();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading master data: {ex.Message}");
        }
    }

    // Helper to safely load methods if the service is available
    @inject ReportMethodService ReportMethodSvc
    private async Task<List<Booking.Models.ReportMethodModel>> ReportSvc_GetMethods()
    {
        try
        {
            return await ReportMethodSvc.GetReportMethodsAsync();
        }
        catch
        {
            return new List<Booking.Models.ReportMethodModel>();
        }
    }

    private void GoToEditor()
    {
        current = new TestMasterModel
        {
            deleted = false,
            computercode = 1,
            usercode = 1,
            entereddate = DateTime.Now,
            ibsdate = DateTime.Now,
            orderno = allTests.Count + 1,
            tenant_code = "TEN007",
            Routine = true,
            istest = true,
            ispackage = false
        };
        isEditMode = false;
        isListView = false;
    }

    private void GoToList()
    {
        isListView = true;
    }

    private void EditTest(TestMasterModel test)
    {
        current = new TestMasterModel
        {
            tcode = test.tcode,
            gcode = test.gcode,
            scode = test.scode,
            rtcode = test.rtcode,
            ucode = test.ucode,
            rtmcode = test.rtmcode,
            orderno = test.orderno,
            name = test.name,
            shortname = test.shortname,
            qty = test.qty,
            amount = test.amount,
            lockresult = test.lockresult,
            locksms = test.locksms,
            textcontent = test.textcontent,
            culturereport = test.culturereport,
            Routine = test.Routine,
            outlab = test.outlab,
            description = test.description,
            footer = test.footer,
            deleted = test.deleted,
            usercode = test.usercode,
            computercode = test.computercode,
            entereddate = test.entereddate,
            ibsdate = test.ibsdate,
            printinseparatepage = test.printinseparatepage,
            printgraphinreport = test.printgraphinreport,
            graphtype = test.graphtype,
            istest = test.istest,
            ispackage = test.ispackage,
            packcode = test.packcode,
            gstlcode = test.gstlcode,
            gstper = test.gstper,
            gstamount = test.gstamount,
            hsn = test.hsn,
            hsndescription = test.hsndescription,
            isnodiscount = test.isnodiscount,
            ccf = test.ccf,
            ccv = test.ccv,
            csf = test.csf,
            CSV = test.CSV,
            hsf = test.hsf,
            hsv = test.hsv,
            isccv = test.isccv,
            iscsv = test.iscsv,
            isncv = test.isncv,
            ncf = test.ncf,
            ncv = test.ncv,
            tcf = test.tcf,
            tenant_code = test.tenant_code
        };
        isEditMode = true;
        isListView = false;
    }

    private async Task SaveTest()
    {
        if (string.IsNullOrWhiteSpace(current.name))
        {
            ToastService.ShowError("Test Name is required.");
            return;
        }

        try
        {
            current.tenant_code = "TEN007";
            current.computercode = 1;
            current.usercode = 1;
            current.ibsdate = DateTime.Now;

            bool success;
            if (isEditMode)
            {
                success = await TestMasterSvc.UpdateTestMasterAsync(current);
            }
            else
            {
                current.entereddate = DateTime.Now;
                success = await TestMasterSvc.InsertTestMasterAsync(current);
            }

            if (success)
            {
                await LoadData();
                ToastService.ShowSuccess(isEditMode ? "Test updated successfully!" : "Test created successfully!");
                isListView = true;
            }
            else
            {
                ToastService.ShowError("Failed to save test details.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task DeleteTest(decimal tcode)
    {
        if (tcode == 0) return;

        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this test record?");
        if (confirm)
        {
            try
            {
                bool success = await TestMasterSvc.DeleteTestMasterAsync(tcode);
                if (success)
                {
                    await LoadData();
                    ToastService.ShowSuccess("Test record deleted successfully.");
                    isListView = true;
                }
                else
                {
                    ToastService.ShowError("Failed to delete test record.");
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error deleting: {ex.Message}");
            }
        }
    }

    private void ResetForm()
    {
        if (isEditMode)
        {
            var orig = allTests.FirstOrDefault(t => t.tcode == current.tcode);
            if (orig != null) EditTest(orig);
        }
        else
        {
            GoToEditor();
        }
    }

    private async Task UpdateInline(TestMasterModel test, string fieldName, object? val)
    {
        if (test == null) return;
        inlineSavingState[test.tcode] = "saving";
        StateHasChanged();

        try
        {
            switch (fieldName)
            {
                case "orderno":
                    if (decimal.TryParse(val?.ToString(), out decimal ord)) test.orderno = ord;
                    break;
                case "shortname":
                    test.shortname = val?.ToString();
                    break;
                case "name":
                    test.name = val?.ToString();
                    break;
                case "amount":
                    if (double.TryParse(val?.ToString(), out double amt)) test.amount = amt;
                    break;
            }

            test.ibsdate = DateTime.Now;
            bool success = await TestMasterSvc.UpdateTestMasterAsync(test);
            
            if (success)
            {
                inlineSavingState[test.tcode] = "saved";
                ToastService.ShowSuccess($"Updated {fieldName} successfully.");
            }
            else
            {
                inlineSavingState[test.tcode] = "error";
                ToastService.ShowError($"Failed to update {fieldName}.");
            }
        }
        catch
        {
            inlineSavingState[test.tcode] = "error";
        }
        
        StateHasChanged();
        await Task.Delay(2000);
        inlineSavingState.Remove(test.tcode);
        StateHasChanged();
    }

    private void CalculateGstAmount()
    {
        if (current.amount > 0 && current.gstper.HasValue)
        {
            current.gstamount = current.amount * (current.gstper.Value / 100.0);
        }
        else
        {
            current.gstamount = 0;
        }
    }

    private void TogglePackage()
    {
        current.ispackage = !(current.ispackage ?? false);
        if (current.ispackage == false)
        {
            current.packcode = 0;
        }
    }
}
