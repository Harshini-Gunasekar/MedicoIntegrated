@page "/test-masters"
@page "/test-master"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Net.Http.Json
@using Newtonsoft.Json
@using LIMS_Backend.Model
@using LabCare.Models
@using SharedComponents.Rcl.Models
@using Microsoft.JSInterop
@using Medico_Backend.Model

@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage
@inject Booking.Services.ToastService Toast
@inject LabCare.Services.TestService TestSvc
@inject LabCare.Services.GroupService GroupSvc
@inject Booking.Services.SampleMasterService BookingSampleSvc
@inject Booking.Services.GroupMasterService BookingGroupSvc
@inject Booking.Services.UomMasterService BookingUomSvc
@inject Booking.Services.ReportMethodService BookingMethodSvc
@inject Booking.Services.TestTypeMasterService BookingTestTypeSvc
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="tm-elite-container">
    <EditForm Model="@testData" OnValidSubmit="UpdateTest" OnInvalidSubmit="HandleInvalidSubmit" @key="testData.TestMaster" FormName="TestMasterForm" style="display: flex; flex-direction: column; flex: 1;">
        <DataAnnotationsValidator />

        @if (isListView)
        {
            <div class="referral-page">
                <div class="lab-header-card flex-between">
                    <div class="display-flex align-center gap-16">
                        <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                            <span class="material-symbols-outlined text-indigo-600 icon-lg">list_alt</span>
                        </div>
                        <div>
                            <h2 class="lab-title-text m-0">Test Master</h2>
                            <div class="flex-start gap-8 mt-2px">
                                <span class="status-pulse-dot"></span>
                                <span class="status-text">Available Tests: @allTests.Count</span>
                            </div>
                        </div>
                    </div>
                    <div class="display-flex align-center gap-12">
                        <div class="relative-positioned">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%);">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                            </svg>
                            <input type="text" placeholder="Search tests..." @bind="searchQuery" @bind:event="oninput" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 8px 16px 8px 36px; font-size: 13px; color: #1e293b; outline: none; width: 200px;" />
                        </div>
                        <div class="search-controls">
                            <button type="button" class="btn-new-entry" @onclick="GoToEditor">+ Add New</button>
                        </div>
                    </div>
                </div>

                <div class="directory-section" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-top: -4px;">
                    <div class="table-wrapper" style="overflow-x: auto; padding: 0;">
                        <table class="directory-table" style="table-layout: fixed; width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr>
                                    <th style="width: 64px;">SR.NO.</th>
                                    <th style="width: 100px;">TEST CODE</th>
                                    <th style="width: 100px;">ORDER NO</th>
                                    <th style="width: 120px;">SHORT NAME</th>
                                    <th>TEST NAME</th>
                                    <th style="width: 140px;">DEPARTMENT</th>
                                    <th style="width: 160px;">GROUP NAME</th>
                                    <th style="text-align: right; width: 110px;">AMOUNT</th>
                                    <th class="text-center" style="width: 128px;">ACTIONS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (test, index) in allTests.Where(t => string.IsNullOrEmpty(searchQuery) || (t.name != null && t.name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))).Select((t, i) => (t, i)))
                                {
                                    <tr>
                                        <td><span class="td-order-no">@((index + 1).ToString("D2"))</span></td>
                                        <td style="color: #4f46e5; font-weight: 800;">T-@test.tcode</td>
                                        <td>
                                            <input type="number" class="tm-inline-input" style="color: #4f46e5; font-weight: 700;" value="@test.orderno" @oninput="@(e => HandleInlineEdit(test, "orderno", e.Value))" />
                                        </td>
                                        <td>
                                            <input type="text" class="tm-inline-input" style="color: #64748b; font-family: monospace;" value="@test.shortname" @oninput="@(e => HandleInlineEdit(test, "shortname", e.Value))" />
                                        </td>
                                        <td>
                                            <div class="display-flex align-center gap-12" style="width: 100%;">
                                                @{
                                                    var spec = specimens.FirstOrDefault(s => s.scode == test.scode);
                                                    if (spec != null) {
                                                        <div style="background: #fff1f2; color: #e11d48; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 800; flex-shrink: 0;">@spec.name?.ToUpper()</div>
                                                    }
                                                }
                                                <input type="text" class="tm-inline-input flex-1" value="@test.name" @oninput="@(e => HandleInlineEdit(test, "name", e.Value))" style="font-weight: 700; color: #1e293b; min-width: 0;" />
                                            </div>
                                        </td>
                                        <td>@test.test_type_name</td>
                                        <td>@groups.FirstOrDefault(g => g.gcode == test.gcode)?.name</td>
                                        <td>
                                            <input type="number" step="0.01" class="tm-inline-input text-right" style="font-weight: 700; color: #1e293b;" value="@test.amount" @oninput="@(e => HandleInlineEdit(test, "amount", e.Value))" />
                                        </td>
                                        <td class="text-center" style="white-space: nowrap; vertical-align: middle;">
                                            <div style="display: flex; justify-content: center; align-items: center; gap: 8px;">
                                                @if (_inlineSaveStatus.TryGetValue(test.tcode, out var status))
                                                {
                                                    @if (status == "saving")
                                                    {
                                                        <i class="material-symbols-outlined tm-spin-animate" style="font-size: 16px; color: #6366f1;" title="Saving changes...">sync</i>
                                                    }
                                                    else if (status == "saved")
                                                    {
                                                        <i class="material-symbols-outlined" style="font-size: 16px; color: #10b981;" title="Changes saved">check_circle</i>
                                                    }
                                                    else if (status == "error")
                                                    {
                                                        <i class="material-symbols-outlined" style="font-size: 16px; color: #ef4444;" title="Save failed">error</i>
                                                    }
                                                }
                                                <button type="button" class="btn-action btn-edit" @onclick="() => SelectTest(test)" title="Edit">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg>
                                                </button>
                                                <button type="button" class="btn-action btn-delete-action" @onclick="() => DeleteTestFromList(test)" title="Delete">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                                    </svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="tm-elite-header">
                <div class="display-flex align-center gap-12">
                    <button type="button" class="tm-btn-outline" style="padding: 4px 8px;" @onclick="GoToList">
                        <i class="material-symbols-outlined">arrow_back</i>
                    </button>
                    <h1 style="font-size: 18px; font-weight: 900; color: #1e293b; margin: 0;">TEST CONSTRUCTION</h1>
                </div>
            </div>

            <div class="tm-elite-content">
                <div class="tm-elite-grid-top" style="grid-template-columns: 1.2fr 1fr; gap: 12px;">
                    <div class="tm-elite-card" style="padding: 16px;">
                        <div class="tm-elite-card-title">
                            <div style="background: #f5f3ff; padding: 6px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                <i class="material-symbols-outlined font-18">medical_services</i>
                            </div>
                            TEST DETAILS
                        </div>
                        <div class="display-flex gap-12 mb-12">
                            <div style="flex: 2;">
                                <label class="tm-elite-label">TEST NAME</label>
                                <InputText class="tm-elite-input" @bind-Value="testData.TestMaster.name" />
                            </div>
                            <div class="flex-1">
                                <label class="tm-elite-label">AMOUNT</label>
                                <InputNumber class="tm-elite-input" @bind-Value="testData.TestMaster.amount" />
                            </div>
                        </div>
                        <div class="display-flex gap-12 mb-12">
                            <div class="flex-1">
                                <label class="tm-elite-label">SAMPLE TYPE</label>
                                <div style="display: flex; gap: 8px;">
                                    <select class="tm-elite-input" @onchange="OnTopSpecimenChange" value="@testData.TestMaster.scode" style="flex: 1;">
                                        <option value="0">Select Specimen</option>
                                        @foreach (var s in specimens) { <option value="@s.scode">@s.name</option> }
                                    </select>
                                    <button type="button" class="tm-btn-primary" style="padding: 0 12px; height: 2.5rem; display: flex; align-items: center; border-radius: 8px;" @onclick="ShowSpecimenModal" title="View Specimens">
                                        <i class="material-symbols-outlined" style="font-size: 16px;">list</i>
                                    </button>
                                </div>
                            </div>
                            <div class="flex-1">
                                <label class="tm-elite-label">GROUP</label>
                                <div style="display: flex; gap: 8px;">
                                    <InputSelect @bind-Value="testData.TestMaster.gcode" class="tm-elite-input" style="flex: 1;">
                                        <option value="0">Select Group</option>
                                        @foreach (var g in groups) { <option value="@g.gcode">@g.name</option> }
                                    </InputSelect>
                                    <button type="button" class="tm-btn-primary" style="padding: 0 12px; height: 2.5rem; display: flex; align-items: center; border-radius: 8px;" @onclick="ShowGroupModal" title="View Groups">
                                        <i class="material-symbols-outlined" style="font-size: 16px;">list</i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="display-flex gap-12 mb-12">
                            <div class="flex-1">
                                <label class="tm-elite-label">ORDER NO</label>
                                <InputNumber class="tm-elite-input" @bind-Value="testData.TestMaster.orderno" />
                            </div>
                            <div class="flex-1">
                                <label class="tm-elite-label">SHORT NAME</label>
                                <InputText class="tm-elite-input" @bind-Value="testData.TestMaster.shortname" />
                            </div>
                        </div>
                        <div class="tm-elite-form-group">
                            <label class="tm-elite-label">REPORTING TIME</label>
                            <div style="display: flex; flex-direction: column; gap: 8px; width: 100%;">
                                <div class="bl-age-group" style="width: 100%; display: flex; gap: 8px;">
                                    <div class="bl-age-box" style="height: 2.5rem; flex: 1; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; padding: 2px 4px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                        <input type="text" class="bl-age-input" @bind="reportingDays" @bind:after="UpdateReportingTextFromTime" placeholder="0" style="width: 100%; text-align: center; border: none; background: transparent; font-size: 14px; font-weight: 700; color: #1e293b; outline: none;" />
                                        <span class="bl-age-lbl" style="font-size: 8px; font-weight: 800; color: #94a3b8; text-transform: uppercase; margin-top: -2px;">DD</span>
                                    </div>
                                    <div class="bl-age-box" style="height: 2.5rem; flex: 1; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; padding: 2px 4px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                        <input type="text" class="bl-age-input" @bind="reportingHours" @bind:after="UpdateReportingTextFromTime" placeholder="0" style="width: 100%; text-align: center; border: none; background: transparent; font-size: 14px; font-weight: 700; color: #1e293b; outline: none;" />
                                        <span class="bl-age-lbl" style="font-size: 8px; font-weight: 800; color: #94a3b8; text-transform: uppercase; margin-top: -2px;">HH</span>
                                    </div>
                                    <div class="bl-age-box" style="height: 2.5rem; flex: 1; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; padding: 2px 4px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                        <input type="text" class="bl-age-input" @bind="reportingMins" @bind:after="UpdateReportingTextFromTime" placeholder="0" style="width: 100%; text-align: center; border: none; background: transparent; font-size: 14px; font-weight: 700; color: #1e293b; outline: none;" />
                                        <span class="bl-age-lbl" style="font-size: 8px; font-weight: 800; color: #94a3b8; text-transform: uppercase; margin-top: -2px;">MM</span>
                                    </div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 6px; padding-left: 2px;">
                                    <span class="material-symbols-outlined" style="font-size: 14px; color: #6366f1;">schedule</span>
                                    <span style="font-size: 12px; font-weight: 600; color: #4f46e5;">@GetReportingDisplayText()</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ADDITIONAL DETAILS -->
                    <div class="tm-elite-card" style="padding: 16px;">
                        <div class="tm-elite-card-title">
                            <div style="background: #f5f3ff; padding: 6px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                <i class="material-symbols-outlined font-18">clinical_notes</i>
                            </div>
                            ADDITIONAL
                        </div>
                        <div class="tm-elite-form-group mb-12">
                            <label class="tm-elite-label">TEST TYPE</label>
                            <div style="display: flex; gap: 8px;">
                                <InputSelect @bind-Value="testData.TestMaster.ttid" class="tm-elite-input" style="flex: 1;">
                                    <option value="0">Select Type</option>
                                    @foreach (var t in testTypes) { <option value="@t.ttid">@t.name</option> }
                                </InputSelect>
                                <button type="button" class="tm-btn-primary" style="padding: 0 12px; height: 2.5rem; display: flex; align-items: center; border-radius: 8px;" @onclick="ShowTestTypeModal" title="View Test Types">
                                    <i class="material-symbols-outlined" style="font-size: 16px;">list</i>
                                </button>
                            </div>
                        </div>
                        <div class="tm-elite-form-group mb-12">
                            <label class="tm-elite-label">REPORT METHOD</label>
                            <div style="display: flex; gap: 8px;">
                                <select class="tm-elite-input" value="@testData.TestMaster.rtmcode" @onchange="@(e => { if (long.TryParse(e.Value?.ToString(), out var val)) testData.TestMaster.rtmcode = val; })" style="flex: 1;">
                                    <option value="0">Select Method</option>
                                    @foreach (var m in methods)
                                    {
                                        <option value="@m.rtmcode">@m.name</option>
                                    }
                                </select>
                                <button type="button" class="tm-btn-primary" style="padding: 0 12px; height: 2.5rem; display: flex; align-items: center; border-radius: 8px;" @onclick="ShowMethodModal" title="View Methods">
                                    <i class="material-symbols-outlined" style="font-size: 16px;">list</i>
                                </button>
                            </div>
                        </div>
                        <div class="tm-elite-form-group mb-12">
                            <label class="tm-elite-label">ICD CODE</label>
                            <InputText class="tm-elite-input" @bind-Value="testData.TestMaster.icd_code" />
                        </div>
                        @if (testData.ResultRows?.Any(r => r.ResultMaster?.is_escalation == true) ?? false)
                        {
                            <div class="tm-elite-form-group mb-12">
                                <label class="tm-elite-label">ASSIGNED PATHOLOGIST</label>
                                <select class="tm-elite-input" value="@(testData.TestMaster.usercode ?? 1)" @onchange="@(e => { if (int.TryParse(e.Value?.ToString(), out int val)) testData.TestMaster.usercode = val; })">
                                    <option value="1">Admin / Default</option>
                                    @if (usermaster != null)
                                    {
                                        @foreach (var u in usermaster.Where(x => x.UserID > 0).GroupBy(x => x.UserID).Select(g => g.First()))
                                        {
                                            @if (u.UserID != 1)
                                            {
                                                <option value="@u.UserID">@u.Name (@(u.IsPowerUser ? "Power User" : "User"))</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        }
                        <div class="tm-elite-form-group">
                            <label class="tm-elite-label">OPTIONS</label>
                            <div class="tm-elite-checkbox-group" style="gap: 8px;">
                                <div class="tm-elite-checkbox-item @(testData.TestMaster.locksms ? "active" : "")" @onclick="() => testData.TestMaster.locksms = !testData.TestMaster.locksms">
                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                    <span class="tm-elite-checkbox-label" style="font-size: 10px;">SMS</span>
                                </div>
                                <div class="tm-elite-checkbox-item @(testData.TestMaster.isdc == true ? "active" : "")" @onclick="() => testData.TestMaster.isdc = !(testData.TestMaster.isdc ?? false)">
                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                    <span class="tm-elite-checkbox-label" style="font-size: 10px;">DC</span>
                                </div>
                                <div class="tm-elite-checkbox-item @(testData.TestMaster.iscontrast == true ? "active" : "")" @onclick="() => testData.TestMaster.iscontrast = !(testData.TestMaster.iscontrast ?? false)">
                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                    <span class="tm-elite-checkbox-label" style="font-size: 10px;">Contrast</span>
                                </div>
                                <div class="tm-elite-checkbox-item @(testData.TestMaster.isnoic == true ? "active" : "")" @onclick="() => testData.TestMaster.isnoic = !(testData.TestMaster.isnoic ?? false)">
                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                    <span class="tm-elite-checkbox-label" style="font-size: 10px;">NoIC</span>
                                </div>
                                <div class="tm-elite-checkbox-item @(testData.TestMaster.lockresult ? "active" : "")" @onclick="() => testData.TestMaster.lockresult = !testData.TestMaster.lockresult">
                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                    <span class="tm-elite-checkbox-label" style="font-size: 10px;">Lock</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="display-flex gap-24 align-stretch" style="flex: 1; min-height: calc(100vh - 280px);">
                    <!-- LEFT COLUMN: SUB TESTS -->
                    <div style="width: 256px; flex-shrink: 0; display: flex; flex-direction: column;">
                        <div class="tm-elite-card" style="padding: 0; overflow: hidden; border-radius: 16px; flex: 1; display: flex; flex-direction: column;">
                            <div style="background: #475569; padding: 10px 14px; display: flex; justify-content: space-between; align-items: center; height: 40px; box-sizing: border-box;">
                                <div style="font-size: 12px; font-weight: 900; color: white; text-transform: uppercase; letter-spacing: 0.06em; display: flex; align-items: center; gap: 6px;">
                                    <i class="material-symbols-outlined" style="font-size: 16px;">format_list_bulleted</i>
                                    SUB TESTS
                                </div>
                            </div>
                            <div style="padding: 8px 12px; border-bottom: 1px solid #e2e8f0; background: #f8fafc; display: flex; flex-direction: column; gap: 8px;">
                                <div style="position: relative;">
                                    <i class="material-symbols-outlined" style="position: absolute; left: 8px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 16px; pointer-events: none;">search</i>
                                    <input type="text" placeholder="Add The Profile test"
                                           value="@searchToLoad"
                                           @oninput="OnTestSearchInput"
                                           @onfocus="() => showTestDropdown = filteredTests.Any()"
                                           @onblur="OnTestBlur"
                                           style="width: 100%; height: 30px; padding: 0 10px 0 28px; border: 1.5px solid #e2e8f0; border-radius: 6px; font-size: 11px; background: white; box-sizing: border-box;" />
                                </div>
                                @if (showTestDropdown && filteredTests.Any())
                                {
                                    <div style="margin-top: 6px; display: flex; flex-wrap: wrap; gap: 4px; max-height: 120px; overflow-y: auto; padding: 2px 0;">
                                        @foreach (var t in filteredTests)
                                        {
                                            <div @onclick="() => AddTestAsParameter(t)"
                                                 style="display: inline-flex; align-items: center; gap: 4px; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 4px 8px; cursor: pointer; font-size: 11px; font-weight: 600; color: #475569; transition: all 0.15s;">
                                                <i class="material-symbols-outlined" style="font-size: 12px; color: #4f46e5;">add_circle</i>
                                                @t.name
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="lc-overflow-auto no-scrollbar" style="flex: 1; overflow-y: auto; background: white;">
                                @if (testData.ResultRows != null)
                                {
                                    <table class="tm-param-table">
                                        <thead>
                                            <tr>
                                                <th style="width: 34px;">S.No</th>
                                                <th>Parameter Name</th>
                                                <th style="width: 32px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < testData.ResultRows.Count; i++)
                                            {
                                                var index = i;
                                                var row = testData.ResultRows[i];
                                                row.ResultMaster.slno = index + 1;
                                                <tr @key="row" 
                                                    class="tm-param-row @(selectedRow == row ? "active" : "")" 
