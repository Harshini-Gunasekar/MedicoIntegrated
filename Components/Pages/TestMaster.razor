    private void OnDrop(int targetIndex)
    {
        if (draggedIndex.HasValue && draggedIndex.Value != targetIndex)
        {
            var rowToMove = testData.ResultRows[draggedIndex.Value];
            testData.ResultRows.RemoveAt(draggedIndex.Value);
            testData.ResultRows.Insert(targetIndex, rowToMove);

            for (int i = 0; i < testData.ResultRows.Count; i++)
