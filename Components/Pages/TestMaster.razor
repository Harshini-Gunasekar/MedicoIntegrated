    private void ParseReportingTime(string text)
    {
        reportingDays = null;
        reportingHours = null;
        reportingMins = null;
        
        if (string.IsNullOrWhiteSpace(text)) return;
        
        if (text.Contains(":"))
        {
            var parts = text.Split(':');
            if (parts.Length == 3)
            {
                if (int.TryParse(parts[0], out int d)) reportingDays = d > 0 ? d : null;
                if (int.TryParse(parts[1], out int h)) reportingHours = h > 0 ? h : null;
                if (int.TryParse(parts[2], out int m)) reportingMins = m > 0 ? m : null;
                return;
            }
        }
        
        var tokens = text.Split(new[] { ' ', ',', ';' }, StringSplitOptions.RemoveEmptyEntries);
        for (int i = 0; i < tokens.Length - 1; i++)
        {
            if (int.TryParse(tokens[i], out int val))
            {
                var unit = tokens[i + 1].ToLower();
                if (unit.StartsWith("day"))
                {
                    reportingDays = val > 0 ? val : null;
                }
                else if (unit.StartsWith("hour") || unit.StartsWith("hr"))
                {
                    reportingHours = val > 0 ? val : null;
                }
                else if (unit.StartsWith("min"))
                {
                    reportingMins = val > 0 ? val : null;
                }
            }
        }
    }

    private void UpdateReportingTextFromTime()
    {
        if (reportingDays == null && reportingHours == null && reportingMins == null)
        {
            reportingSearchText = "";
            return;
        }

        int d = reportingDays ?? 0;
        int h = reportingHours ?? 0;
        int m = reportingMins ?? 0;
        
        reportingSearchText = $"{d:D2}:{h:D2}:{m:D2}";
    }

    private string GetReportingDisplayText()
    {
        var parts = new List<string>();
        if (reportingDays.HasValue && reportingDays.Value > 0)
        {
            parts.Add($"{reportingDays.Value} {(reportingDays.Value == 1 ? "Day" : "Days")}");
        }
        if (reportingHours.HasValue && reportingHours.Value > 0)
        {
            parts.Add($"{reportingHours.Value} {(reportingHours.Value == 1 ? "Hour" : "Hours")}");
        }
        if (reportingMins.HasValue && reportingMins.Value > 0)
        {
            parts.Add($"{reportingMins.Value} {(reportingMins.Value == 1 ? "Min" : "Mins")}");
        }
        
        return parts.Any() ? string.Join(" ", parts) : "0 Min";
    }
    
