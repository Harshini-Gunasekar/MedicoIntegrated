                testData.ResultRows[i].ResultMaster.slno = i + 1;
            }

            draggedIndex = null;
            StateHasChanged();
        }
    }

    private async Task SelectTest(test_master test)
    {
        if (test == null) return;
        IsLoading = true;
        searchMasterToLoad = ""; 
        showMasterDropdown = false;
        isListView = false;
        StateHasChanged();

        try {
            var fullData = await TestSvc.GetTestResultAsync(test.tcode);
            if (_isDisposed) return;

            if (fullData != null) {
                if (fullData.TestMaster != null)
                {
                    var fetched = fullData.TestMaster;
                    if (string.IsNullOrEmpty(fetched.name))      fetched.name      = test.name;
                    if (string.IsNullOrEmpty(fetched.shortname)) fetched.shortname = test.shortname;
                    if (string.IsNullOrEmpty(fetched.qty))       fetched.qty       = test.qty;
                    if (string.IsNullOrEmpty(fetched.icd_code))  fetched.icd_code  = test.icd_code;
                    if (fetched.gcode   == 0) fetched.gcode   = test.gcode;
                    if (fetched.scode   == 0) fetched.scode   = test.scode;
                    if (fetched.rtmcode == 0) fetched.rtmcode = test.rtmcode;
                    if (fetched.ucode   == 0) fetched.ucode   = test.ucode;
                    if (fetched.rtcode  == 0) fetched.rtcode  = test.rtcode;
                    if (fetched.ttid    == 0) fetched.ttid    = test.ttid;
                    if (fetched.amount  == 0) fetched.amount  = test.amount;
                    if (fetched.orderno == 0) fetched.orderno = test.orderno;
                    if (!fetched.lockresult)          fetched.lockresult          = test.lockresult;
                    if (!fetched.locksms)             fetched.locksms             = test.locksms;
                    if (!fetched.printinseparatepage) fetched.printinseparatepage = test.printinseparatepage;
                    if (!fetched.printgraphinreport)  fetched.printgraphinreport  = test.printgraphinreport;
                    
                    fetched.istest    ??= test.istest;
                    fetched.ispackage ??= test.ispackage;
                    fetched.iscontrast??= test.iscontrast;
                    fetched.isnoic    ??= test.isnoic;
                    fetched.isdc      ??= test.isdc;
                    if (string.IsNullOrEmpty(fetched.tenant_code)) fetched.tenant_code = test.tenant_code;

                    testData.TestMaster = fetched;
                    testData.TestMaster.tcode = test.tcode;   
                }
                else
                {
                    testData.TestMaster = test;
                }
                
                testData.ResultRows = fullData.ResultRows ?? new();
                foreach (var row in testData.ResultRows)
                {
                    if (string.IsNullOrEmpty(row.ResultMaster.cellcontent) || row.ResultMaster.cellcontent == "Lipid Profile")
                    {
                        row.ResultMaster.cellcontent = row.ResultMaster.col2;
                    }

                    if (row.ResultProperties == null) row.ResultProperties = new test_result_properties { 
                        trpid = Guid.NewGuid(),
                        testresultid = row.ResultMaster.testresultid,
                        resultvaluetype = "Numeric"
                    };
                    else
                    {
                        if (row.ResultProperties.resultvaluetype == "TN") row.ResultProperties.resultvaluetype = "Text & Number";
                        if (row.ResultProperties.resultvaluetype == "Number") row.ResultProperties.resultvaluetype = "Numeric";
                    }

                    if (row.CalculatedFormulas == null) row.CalculatedFormulas = new();
                    if (row.DetailedNormalValues == null) row.DetailedNormalValues = new();
                    if (row.TextNormalValues == null) row.TextNormalValues = new();
                }

                if (!testData.ResultRows.Any()) AddTestRow();
                selectedRow = testData.ResultRows.FirstOrDefault();
                Toast.Success($"Loaded: {testData.TestMaster.name} ({testData.ResultRows.Count} params)");
            } else {
                testData.TestMaster = test;
                testData.ResultRows = new();
                AddTestRow();
                Toast.Info($"Loaded: {test.name} (no parameters saved yet)");
            }
            var matchedReport = reportings.FirstOrDefault(r => r.recode == testData.TestMaster.rtcode);
            reportingSearchText = matchedReport?.name ?? "";
            ParseReportingTime(reportingSearchText);
            quillInitialized = false;
        } catch (Exception ex) {
            Toast.Error(ex.Message);
        } finally { 
            if (!_isDisposed) {
                IsLoading = false; 
                StateHasChanged(); 
            }
        }
    }

